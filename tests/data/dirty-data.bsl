// «Грязные» данные базы гейта (scripts/dirty-data.sh): состояния, которых нет в демо-наборе, но которые есть в
// базах клиентов, - непроведённые и помеченные на удаление документы каждого вида, элементы справочников с
// длинным названием и спецсимволами, помеченные на удаление элементы. Смок и тесты интерфейса после этого
// открывают списки и формы на таких данных. Повторный запуск ничего не добавляет: созданное помечено меткой
// в комментарии документа и в наименовании элемента. Запускается под администратором только на базе гейта.
&НаСервереБезКонтекста
Процедура Главная(Части, Лог)
	Метка = "#грязные данные#"; // без квадратных скобок: в ПОДОБНО они задают набор символов
	Создано = 0;
	Отказов = 0;
	Для Каждого МетаДокумент Из Метаданные.Документы Цикл
		Если МетаДокумент.Реквизиты.Найти("Комментарий") = Неопределено Тогда
			Лог.ЗаписатьСтроку("ПРОПУСК;" + МетаДокумент.Имя + ";нет реквизита Комментарий для метки");
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Документ.%1 КАК Т
			|ГДЕ Т.Комментарий ПОДОБНО &Метка", МетаДокумент.Имя));
		Запрос.УстановитьПараметр("Метка", "%" + Метка + "%");
		Если Не Запрос.Выполнить().Пустой() Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Документ.%1 КАК Т
			|ГДЕ НЕ Т.ПометкаУдаления УПОРЯДОЧИТЬ ПО Т.Дата УБЫВ", МетаДокумент.Имя));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Лог.ЗаписатьСтроку("ПРОПУСК;" + МетаДокумент.Имя + ";в базе нет документа-образца");
			Продолжить;
		КонецЕсли;
		// Две копии последнего документа: непроведённая и помеченная на удаление. Движений нет - остатки не меняются.
		Для Номер = 1 По 2 Цикл
			Попытка
				Копия = Выборка.Ссылка.Скопировать();
				Копия.Дата = ТекущаяДатаСеанса();
				Копия.Комментарий = Метка + ?(Номер = 1, " не проведён", " помечен на удаление");
				Копия.Записать(РежимЗаписиДокумента.Запись);
				Если Номер = 2 Тогда
					Копия.УстановитьПометкуУдаления(Истина);
				КонецЕсли;
				Создано = Создано + 1;
			Исключение
				Отказов = Отказов + 1;
				Лог.ЗаписатьСтроку("ОТКАЗ;" + МетаДокумент.Имя + ";"
					+ СтрЗаменить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, " "));
				Прервать;
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Длинное = Метка + " Очень длинное название с «кавычками», апострофом d'Été, амперсандом & и знаками <>/\ - "
		+ "чтобы колонки списков и поля печатных форм показали, как они обрезают и переносят текст";
	Для Каждого ИмяСправочника Из СтрРазделить("Номенклатура,Контрагенты,МестаХранения", ",") Цикл
		МетаСправочник = Метаданные.Справочники.Найти(ИмяСправочника);
		Если МетаСправочник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Справочник.%1 КАК Т
			|ГДЕ Т.Наименование ПОДОБНО &Метка", ИмяСправочника));
		Запрос.УстановитьПараметр("Метка", "%" + Метка + "%");
		Если Не Запрос.Выполнить().Пустой() Тогда
			Продолжить;
		КонецЕсли;
		УсловиеГруппы = ?(МетаСправочник.Иерархический
			И МетаСправочник.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов,
			"НЕ Т.ЭтоГруппа И ", "");
		Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Справочник.%1 КАК Т
			|ГДЕ %2НЕ Т.ПометкаУдаления", ИмяСправочника, УсловиеГруппы));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Продолжить;
		КонецЕсли;
		Для Номер = 1 По 2 Цикл
			Попытка
				Копия = Выборка.Ссылка.Скопировать();
				Копия.Наименование = Лев(Длинное, МетаСправочник.ДлинаНаименования);
				Копия.Записать();
				Если Номер = 2 Тогда
					Копия.УстановитьПометкуУдаления(Истина);
				КонецЕсли;
				Создано = Создано + 1;
			Исключение
				Отказов = Отказов + 1;
				Лог.ЗаписатьСтроку("ОТКАЗ;" + ИмяСправочника + ";"
					+ СтрЗаменить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, " "));
				Прервать;
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	Лог.ЗаписатьСтроку("ГРЯЗНЫЕДАННЫЕ;Создано=" + Формат(Создано, "ЧН=0; ЧГ=") + ";Отказов=" + Формат(Отказов, "ЧН=0; ЧГ="));
КонецПроцедуры
