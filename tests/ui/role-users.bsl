// Пользователи ролей для тестов интерфейса (scripts/uitest.sh): по одному пользователю ИБ с карточкой на роль.
// Запускается под администратором на базе гейта. Части: 0 - отчёт, 1 - пароль, 2 - роли через запятую.
// Защита от опасных действий снята сразу: иначе 1С спрашивает подтверждение у человека за экраном.
&НаСервереБезКонтекста
Процедура Главная(Части, Лог)
	Пароль = Части[1];
	Для Каждого ИмяРоли Из СтрРазделить(Части[2], ",", Ложь) Цикл
		Роль = Метаданные.Роли.Найти(ИмяРоли);
		Если Роль = Неопределено Тогда
			ВызватьИсключение "нет роли " + ИмяРоли;
		КонецЕсли;
		Имя = "Тест " + ИмяРоли;
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Имя);
		Если ПользовательИБ = Неопределено Тогда
			ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
		КонецЕсли;
		ПользовательИБ.Имя = Имя;
		ПользовательИБ.ПолноеИмя = Имя;
		ПользовательИБ.АутентификацияСтандартная = Истина;
		ПользовательИБ.ПоказыватьВСпискеВыбора = Ложь;
		ПользовательИБ.Пароль = Пароль;
		ПользовательИБ.Роли.Очистить();
		ПользовательИБ.Роли.Добавить(Роль);
		Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
		Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
		ПользовательИБ.ЗащитаОтОпасныхДействий = Защита;
		ПользовательИБ.Записать();

		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Справочник.Пользователи КАК Т ГДЕ Т.Наименование = &Имя");
		Запрос.УстановитьПараметр("Имя", Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Карточка = Выборка.Ссылка.ПолучитьОбъект();
		Иначе
			Карточка = Справочники.Пользователи.СоздатьЭлемент();
		КонецЕсли;
		Карточка.Наименование = Имя;
		Карточка.ПолноеИмя = Имя;
		Карточка.ИдентификаторПользователяИБ = ПользовательИБ.УникальныйИдентификатор;
		Карточка.ВходВПрограммуРазрешен = Истина;
		Карточка.Роли = Справочники.Пользователи.СформироватьСписокРолей(ПользовательИБ);
		Карточка.ОбменДанными.Загрузка = Истина;
		Карточка.Записать();
		Лог.ЗаписатьСтроку("ПОЛЬЗОВАТЕЛЬ;" + Имя);
	КонецЦикла;
КонецПроцедуры
