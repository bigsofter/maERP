// Ядро тестов интерфейса maERP: модуль формы внешней обработки, выполняется в сеансе тест-менеджера
// (администратор) и управляет тест-клиентом, запущенным под проверяемым пользователем.
// Сборка и запуск - scripts/uitest.sh; план и факты пробы - docs/plans/ui-tests.md.
//
// Параметр запуска: отчёт|порт|метка роли|файл списка форм (строки «ссылка;часть имени формы»).
// Обход формы: открыть на клиенте, активизировать каждую страницу, встать на первую строку каждой видимой
// таблицы, нажать видимые доступные команды сортировки и обновления. Провал - ошибка времени выполнения
// на клиенте (ПолучитьТекущуюИнформациюОбОшибке), неоткрывшаяся форма, потерянное соединение.
// Команды, меняющие данные, здесь не нажимаются: они - дело сценариев.

&НаКлиенте
Перем Строки, Приложение, ГлавноеОкно, Роль, Нажатые, Тронутые, ОшибокВсего, НажатоВсего, ФормОбойдено, ПоследняяОшибкаКлиента;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("Прогон", 1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура Прогон()
	Части = СтрРазделить(ПараметрЗапуска, "|");
	Строки = Новый Массив;
	Строки.Добавить("СТАРТ;");
	Роль = Части[2];
	ОшибокВсего = 0;
	НажатоВсего = 0;
	ФормОбойдено = 0;
	Попытка
		Подключиться(Число(Части[1]));
		Список = Новый ТекстовыйДокумент;
		Список.Прочитать(Части[3], КодировкаТекста.UTF8);
		Для Номер = 1 По Список.КоличествоСтрок() Цикл
			Описание = СтрРазделить(Список.ПолучитьСтроку(Номер), ";");
			Если Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "снимок=") Тогда
				ПоказатьДляСнимка(Описание[0], Описание[1], Сред(Описание[2], 8), Части[0] + ".ready");
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "единица=") Тогда
				СценарийЕдиницаПослеВыбораТовара(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 9), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "видно=") Тогда
				СценарийВидимостьПолей(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 7), ":"));
			ИначеЕсли Описание.Количество() >= 2 И ЗначениеЗаполнено(Описание[0]) Тогда
				ОбойтиФорму(Описание[0], Описание[1]);
			КонецЕсли;
		КонецЦикла;
		Попытка
			ГлавноеОкно.Закрыть();
			Приложение.РазорватьСоединение();
		Исключение
			Строки.Добавить("ЗАМЕЧАНИЕ;" + Роль + ";клиент не закрылся штатно");
		КонецПопытки;
	Исключение
		ОшибокВсего = ОшибокВсего + 1;
		Строки.Добавить("ОШИБКА;" + Роль + ";прогон;" + ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Строки.Добавить(СтрШаблон("ИТОГ;Роль=%1;ФормОбойдено=%2;КомандНажато=%3;Ошибок=%4",
		Роль, Формат(ФормОбойдено, "ЧН=0; ЧГ="), Формат(НажатоВсего, "ЧН=0; ЧГ="), Формат(ОшибокВсего, "ЧН=0; ЧГ=")));
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(СтрСоединить(Строки, Символы.ПС));
	Документ.Записать(Части[0], КодировкаТекста.UTF8);
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Подключиться(Порт)
	Приложение = Новый ТестируемоеПриложение("localhost", Порт);
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + 180000;
	Подключено = Ложь;
	Пока Не Подключено И ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
		Попытка
			Приложение.УстановитьСоединение();
			Подключено = Истина;
		Исключение
			Подключено = Ложь;
		КонецПопытки;
	КонецЦикла;
	Если Не Подключено Тогда
		ВызватьИсключение "нет соединения с тест-клиентом на порту " + Формат(Порт, "ЧГ=");
	КонецЕсли;
	ГлавноеОкно = Приложение.НайтиОбъект(Тип("ТестируемоеОкноКлиентскогоПриложения"), , , 120);
	Если ГлавноеОкно = Неопределено Тогда
		ВызватьИсключение "главное окно тест-клиента не появилось";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбойтиФорму(Ссылка, ЧастьИмени)
	Нажатые = Новый Соответствие;
	Тронутые = Новый Соответствие;
	НажатоДо = НажатоВсего;
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
	Исключение
		ЗаписатьОшибку(ЧастьИмени, "открытие", ОднойСтрокой(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;
	Если ОшибкаКлиента(ЧастьИмени, "открытие") Тогда
		Возврат;
	КонецЕсли;
	ТестФорма = НайтиФорму(ЧастьИмени);
	Если ТестФорма = Неопределено Тогда
		Если Не ОшибкаКлиента(ЧастьИмени, "открытие") Тогда
			ЗаписатьОшибку(ЧастьИмени, "открытие", "форма не открылась за 30 секунд; " + СостояниеКлиента());
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Страниц = 0;
	Попытка
		ОбработатьВидимое(ТестФорма, ЧастьИмени);
		ОбойтиСтраницы(ТестФорма, ЧастьИмени, Страниц);
	Исключение
		ЗаписатьОшибку(ЧастьИмени, "обход", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	// Обработчики ожидания формы (панель сведений по текущей строке) отрабатывают с задержкой: их ошибка
	// должна лечь на эту форму, а не на следующий шаг.
	Подождать(1500);
	ОшибкаКлиента(ЧастьИмени, "после обхода");
	ФормОбойдено = ФормОбойдено + 1;
	Строки.Добавить(СтрШаблон("ФОРМА;%1;%2;Страниц=%3;Таблиц=%4;Нажато=%5;Ошибок=%6", Роль, ТестФорма.ИмяФормы,
		Формат(Страниц, "ЧН=0; ЧГ="), Формат(Тронутые.Количество(), "ЧН=0; ЧГ="),
		Формат(НажатоВсего - НажатоДо, "ЧН=0; ЧГ="), Формат(ОшибокВсего - ОшибокДо, "ЧН=0; ЧГ=")));
	// Окно формы не закрывается: закрытие через тест-команду роняло клиент 8.5.1.1423 на macOS при открытии
	// следующей формы (SIGSEGV в SetWindowPos, проба 2026-11-21). Окна закрываются вместе с клиентом.
КонецПроцедуры

// Снимок окна (UITEST_SHOT): форма открывается, активизируется названная страница (пусто - как открылась),
// создаётся файл-сигнал, и клиент 25 секунд стоит - за это время scripts/uitest.sh снимает его окно.
&НаКлиенте
Процедура ПоказатьДляСнимка(Ссылка, ЧастьИмени, ИмяСтраницы, ФайлСигнала)
	ГлавноеОкно.ВыполнитьКоманду(Ссылка);
	ТестФорма = НайтиФорму(ЧастьИмени);
	Если ТестФорма = Неопределено Тогда
		Если Не ОшибкаКлиента(ЧастьИмени, "открытие") Тогда
			ЗаписатьОшибку(ЧастьИмени, "открытие", "форма не открылась за 30 секунд; " + СостояниеКлиента());
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(ИмяСтраницы, ",", Ложь) Цикл
		Если СтрНачинаетсяС(Имя, "@") Тогда
			// «@Таблица#N» - встать на N-ю строку таблицы-владельца.
			ВстатьНаСтрокуВладельца(ТестФорма, Сред(Имя, 2));
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Имя, "+") Тогда
			// «+Таблица» - добавить строку в таблицу перед снимком (как выглядит начало ввода).
			Попытка
				ТаблицаВвода = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Сред(Имя, 2), 5);
				ТаблицаВвода.Активизировать();
				ТаблицаВвода.ДобавитьСтроку();
				Подождать(1500);
			Исключение
				ЗаписатьОшибку(ЧастьИмени, "снимок", ОднойСтрокой(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
			ОшибкаКлиента(ЧастьИмени, "добавление строки " + Имя);
			Продолжить;
		КонецЕсли;
		Страница = ТестФорма.НайтиОбъект(Тип("ТестируемаяГруппаФормы"), , Имя, 5);
		Если Страница = Неопределено Тогда
			ЗаписатьОшибку(ЧастьИмени, "снимок", "нет страницы " + Имя);
			Возврат;
		КонецЕсли;
		Страница.Активизировать();
	КонецЦикла;
	ОшибкаКлиента(ЧастьИмени, "снимок");
	Строки.Добавить("СОСТОЯНИЕ;" + Роль + ";" + ЧастьИмени + ";" + СостояниеКлиента());
	Сигнал = Новый ТекстовыйДокумент;
	Сигнал.УстановитьТекст(ТестФорма.ИмяФормы);
	Сигнал.Записать(ФайлСигнала, КодировкаТекста.UTF8);
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + 25000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
		Приложение.НайтиОбъекты(Тип("ТестируемаяФорма"));
	КонецЦикла;
	ФормОбойдено = ФормОбойдено + 1;
	Строки.Добавить("СНИМОК;" + Роль + ";" + ТестФорма.ИмяФормы + ";" + ИмяСтраницы);
КонецПроцедуры

// Сценарий «единица после выбора товара» (строка списка: «...;единица=страницы:таблица:поле товара:поле единицы»):
// в таблице добавляется строка, в поле товара вводится название товара с заполненной единицей, читается ячейка
// единицы, ввод строки отменяется - данные базы не меняются. Провал - пустая ячейка единицы или ошибка клиента.
&НаКлиенте
Процедура СценарийЕдиницаПослеВыбораТовара(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + Шаги[1];
	Если Шаги.Количество() < 4 Тогда
		ЗаписатьОшибку(Метка, "сценарий", "нужно «страницы:таблица:поле товара:поле единицы»");
		Возврат;
	КонецЕсли;
	Товар = ТоварСЕдиницей();
	Если Товар = Неопределено Тогда
		ЗаписатьОшибку(Метка, "сценарий", "в базе нет товара с заполненной единицей");
		Возврат;
	КонецЕсли;
	ОшибокДо = ОшибокВсего;
	Таблица = Неопределено;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Если Шаги.Количество() > 4 Тогда
			ВстатьНаСтрокуВладельца(ТестФорма, Шаги[4]);
		КонецЕсли;
		Таблица = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[1], 5);
		Таблица.Активизировать();
		Таблица.ДобавитьСтроку();
		// Рабочие места вставляют строку сами и начинают её ввод обработчиком ожидания - ждём его.
		Подождать(1500);
		Если Не ОшибкаКлиента(Метка, "добавление строки") Тогда
			ВвестиВЯчейку(Таблица, Шаги[2], Товар.Наименование);
			Если Не ОшибкаКлиента(Метка, "выбор товара") Тогда
				// Выбор товара форма обрабатывает при уходе из поля.
				Таблица.ПерейтиКСледующемуЭлементу();
				ОшибкаКлиента(Метка, "уход из поля товара");
				ВЯчейкеТовара = Таблица.ПолучитьТекстЯчейки(Шаги[2]);
				Единица = Таблица.ПолучитьТекстЯчейки(Шаги[3]);
				Если ПустаяСтрока(ВЯчейкеТовара) Тогда
					ЗаписатьОшибку(Метка, "выбор товара", "товар «" + Товар.Наименование + "» в строку не попал");
				ИначеЕсли ПустаяСтрока(Единица) Тогда
					ЗаписатьОшибку(Метка, "единица", "после выбора товара «" + ВЯчейкеТовара + "» единица пуста");
				Иначе
					Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;единица «%3» после выбора товара «%4»", Роль, Метка, Единица,
						Товар.Наименование));
				КонецЕсли;
			КонецЕсли;
			Таблица.ЗакончитьРедактированиеСтроки(Истина);
			ОшибкаКлиента(Метка, "отмена ввода строки");
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		// Начатая строка не должна остаться в форме: следующий сценарий работает с той же формой.
		Попытка
			Если Таблица <> Неопределено Тогда
				Таблица.ЗакончитьРедактированиеСтроки(Истина);
			КонецЕсли;
		Исключение
			Строки.Добавить("ЗАМЕЧАНИЕ;" + Роль + ";" + Метка + ";ввод строки после сбоя не отменён");
		КонецПопытки;
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
	КонецЕсли;
КонецПроцедуры

// Шаги сценария через запятую: имя страницы - активизировать; «@Таблица#N» - встать на N-ю строку;
// «!Кнопка» - нажать; «=Поле=Вариант» - выбрать вариант переключателя.
&НаКлиенте
Процедура ВыполнитьШаги(ТестФорма, ОписаниеШагов)
	Для Каждого Имя Из СтрРазделить(ОписаниеШагов, ",", Ложь) Цикл
		Если СтрНачинаетсяС(Имя, "=") Тогда
			// «=Поле=Вариант» - выбрать вариант переключателя (режим таблицы).
			Выбор = СтрРазделить(Сред(Имя, 2), "=");
			ТестФорма.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , Выбор[0], 5).ВыбратьВариант(Выбор[1]);
			Подождать(1500);
		ИначеЕсли СтрНачинаетсяС(Имя, "@") Тогда
			ВстатьНаСтрокуВладельца(ТестФорма, Сред(Имя, 2));
		ИначеЕсли СтрНачинаетсяС(Имя, "!") Тогда
			// «!Кнопка» - нажать кнопку (например, открыть панель фильтров).
			// Кнопка-переключатель (панель фильтров) после первого нажатия пропадает - это не ошибка шага.
			Попытка
				ТестФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , Сред(Имя, 2), 5).Нажать();
			Исключение
				Строки.Добавить("ПОДРОБНО;" + Роль + ";кнопка " + Сред(Имя, 2) + " не нажата (уже нажата или скрыта)");
			КонецПопытки;
			Подождать(700);
		Иначе
			ТестФорма.НайтиОбъект(Тип("ТестируемаяГруппаФормы"), , Имя, 5).Активизировать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Сценарий «видимость полей» (строка списка: «...;видно=шаги:видимые поля:скрытые поля»): после шагов названные
// поля должны быть видны пользователю, а скрытые - нет. Так проверяется, что фильтр стоит в панели своей закладки.
&НаКлиенте
Процедура СценарийВидимостьПолей(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + "видимость после " + Шаги[0];
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Подождать(700);
		Если Не ОшибкаКлиента(Метка, "шаги") Тогда
			Для Номер = 1 По 2 Цикл
				Если Шаги.Количество() <= Номер Тогда
					Прервать;
				КонецЕсли;
				Для Каждого Имя Из СтрРазделить(Шаги[Номер], ",", Ложь) Цикл
					Поле = ТестФорма.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , Имя, 2);
					Видимо = Поле <> Неопределено И Поле.ТекущаяВидимость();
					Если Видимо <> (Номер = 1) Тогда
						ЗаписатьОшибку(Метка, "видимость", "поле " + Имя + ?(Номер = 1, " не видно", " видно, а не должно"));
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
		Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;видны: %3; скрыты: %4", Роль, Метка, Шаги[1],
			?(Шаги.Количество() > 2, Шаги[2], "")));
	КонецЕсли;
КонецПроцедуры

// Ввод текста в ячейку текущей строки. Сначала напрямую в поле колонки; если строка не в режиме ввода или
// курсор стоит на другой колонке (рабочие места вставляют строку сами) - начать изменение строки и дойти до
// колонки переходами, как пользователь клавишей Tab.
&НаКлиенте
Процедура ВвестиВЯчейку(Таблица, ИмяПоля, Текст)
	Попытка
		Поле = Таблица.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , ИмяПоля, 5);
		Поле.Активизировать();
		Поле.ВвестиТекст(Текст);
		Возврат;
	Исключение
		Строки.Добавить("ПОДРОБНО;" + Роль + ";" + ИмяПоля + ";прямой ввод не прошёл, иду переходами");
	КонецПопытки;
	Пройдено = Новый Массив;
	Для Заход = 1 По 4 Цикл
		// Режим ввода строки включается не с первого раза, если форма ещё исполняет свой обработчик ожидания.
		Попытка
			Таблица.ИзменитьСтроку();
		Исключение
			Пройдено.Добавить("(строка уже в режиме ввода)");
		КонецПопытки;
		Подождать(700);
		Прежнее = "";
		Для Счетчик = 1 По 30 Цикл
			Текущее = Таблица.ПолучитьТекущийЭлемент();
			ИмяТекущего = ?(Текущее = Неопределено, "", Текущее.Имя);
			Если ИмяТекущего = ИмяПоля Тогда
				Текущее.ВвестиТекст(Текст);
				Возврат;
			КонецЕсли;
			Если Счетчик > 1 И ИмяТекущего = Прежнее Тогда
				// Курсор не двигается: строка не в режиме ввода - новый заход.
				Прервать;
			КонецЕсли;
			Пройдено.Добавить(ИмяТекущего);
			Прежнее = ИмяТекущего;
			Таблица.ПерейтиКСледующемуЭлементу();
		КонецЦикла;
	КонецЦикла;
	ВызватьИсключение "до колонки " + ИмяПоля + " не дошёл; пройдено: " + СтрСоединить(Пройдено, ",");
КонецПроцедуры

// Нижние таблицы рабочих мест живут от текущей строки верхней: «Таблица#N» - встать на N-ю строку таблицы
// и дождаться, пока форма перечитает подчинённые таблицы (обработчик ожидания формы - доли секунды).
&НаКлиенте
Процедура ВстатьНаСтрокуВладельца(ТестФорма, Описание)
	Части = СтрРазделить(Описание, "#");
	Владелец = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Части[0], 5);
	Владелец.Активизировать();
	Владелец.ПерейтиКПервойСтроке();
	Если Части.Количество() > 1 Тогда
		Для Номер = 2 По Число(Части[1]) Цикл
			Владелец.ПерейтиКСледующейСтроке();
		КонецЦикла;
	КонецЕсли;
	Подождать(2000);
КонецПроцедуры

// Пауза с опросом тест-клиента: клиент за это время исполняет свои обработчики ожидания.
&НаКлиенте
Процедура Подождать(Миллисекунд)
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + Миллисекунд;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
		Приложение.НайтиОбъекты(Тип("ТестируемаяФорма"));
	КонецЦикла;
КонецПроцедуры

// Возвращаемое значение:
//  Структура, Неопределено - наименование товара с заполненной единицей; наименование уникально среди всех
//  элементов (включая помеченные на удаление) и без спецзнаков «грязных» данных: его вводит тест-клиент текстом.
&НаСервереБезКонтекста
Функция ТоварСЕдиницей()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Т
		|ГДЕ
		|	НЕ Т.ЭтоГруппа
		|	И Т.Единица <> ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|	И НЕ Т.Наименование ПОДОБНО ""%#%""
		|СГРУППИРОВАТЬ ПО
		|	Т.Наименование
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(*) = 1
		|	И МАКСИМУМ(Т.ПометкаУдаления) = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Наименование", Выборка.Наименование);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция НайтиФорму(ЧастьИмени)
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
		Для Каждого Кандидат Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
			Если СтрНайти(Кандидат.ИмяФормы, ЧастьИмени) = 1 Тогда
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Страницы обходятся проходами: каждый проход активизирует первую ещё не посещённую видимую страницу и ищет
// заново - активизация страницы показывает другие группы страниц (нижние закладки рабочих мест видны только на
// своей верхней закладке и при выбранной строке). Отчёт называет каждую страницу; отказ активизации не молчит.
&НаКлиенте
Процедура ОбойтиСтраницы(ТестФорма, ЧастьИмени, Страниц)
	Посещенные = Новый Соответствие;
	// Страницы, показавшиеся после активизации предыдущей (нижние закладки под выбранной строкой), идут первыми:
	// иначе обход уходит на следующую верхнюю закладку, и нижние снова скрываются.
	Очередь = Новый Массив;
	Пока Истина Цикл
		ВидимыеДо = ВидимыеНепосещенныеСтраницы(ТестФорма, Посещенные);
		Если ВидимыеДо.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Группа = Неопределено;
		Пока Очередь.Количество() > 0 И Группа = Неопределено Цикл
			Группа = ВидимыеДо.Получить(Очередь[0]);
			Очередь.Удалить(0);
		КонецЦикла;
		Если Группа = Неопределено Тогда
			Для Каждого КлючИЗначение Из ВидимыеДо Цикл
				Если КлючИЗначение.Значение.Первая Тогда
					Группа = КлючИЗначение.Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Посещенные.Вставить(Группа.Имя, Истина);
		Попытка
			Группа.Объект.Активизировать();
		Исключение
			Строки.Добавить("ПОДРОБНО;" + Роль + ";" + ЧастьИмени + ";страница " + Группа.Имя + " не активизирована: "
				+ ОднойСтрокой(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Продолжить;
		КонецПопытки;
		Страниц = Страниц + 1;
		Строки.Добавить("СТРАНИЦА;" + Роль + ";" + ЧастьИмени + ";" + Группа.Имя);
		Если ОшибкаКлиента(ЧастьИмени, "страница " + Группа.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ОбработатьВидимое(ТестФорма, ЧастьИмени);
		Для Каждого КлючИЗначение Из ВидимыеНепосещенныеСтраницы(ТестФорма, Посещенные) Цикл
			Если ВидимыеДо.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
				Очередь.Добавить(КлючИЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	// Страницы, до которых обход не дошёл, называются в отчёте: «Ошибок=0» не должно значить «не открывалось».
	Пропущены = Новый Массив;
	Для Каждого Группа Из ТестФорма.НайтиОбъекты(Тип("ТестируемаяГруппаФормы")) Цикл
		Если Группа.Вид = ВидГруппыФормы.Страница И Посещенные.Получить(Группа.Имя) = Неопределено Тогда
			Пропущены.Добавить(Группа.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Пропущены.Количество() > 0 Тогда
		Строки.Добавить("НЕПОСЕЩЕНО;" + Роль + ";" + ЧастьИмени + ";" + СтрСоединить(Пропущены, ","));
	КонецЕсли;
КонецПроцедуры

// Возвращаемое значение:
//  Соответствие - имя страницы -> Структура (Имя, Объект, Первая): видимые сейчас страницы, ещё не посещённые.
&НаКлиенте
Функция ВидимыеНепосещенныеСтраницы(ТестФорма, Посещенные)
	Результат = Новый Соответствие;
	Для Каждого Группа Из ТестФорма.НайтиОбъекты(Тип("ТестируемаяГруппаФормы")) Цикл
		Если Группа.Вид <> ВидГруппыФормы.Страница Или Посещенные.Получить(Группа.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Видима = Группа.ТекущаяВидимость();
		Исключение
			Видима = Ложь;
		КонецПопытки;
		Если Видима Тогда
			Результат.Вставить(Группа.Имя, Новый Структура("Имя, Объект, Первая", Группа.Имя, Группа, Результат.Количество() = 0));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ОбработатьВидимое(ТестФорма, ЧастьИмени)
	Для Каждого Таблица Из ТестФорма.НайтиОбъекты(Тип("ТестируемаяТаблицаФормы")) Цикл
		Если Тронутые.Получить(Таблица.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Если Не Таблица.ТекущаяВидимость() Тогда
				Продолжить;
			КонецЕсли;
			Таблица.Активизировать();
			Тронутые.Вставить(Таблица.Имя, Истина);
			Таблица.ПерейтиКПервойСтроке();
			Подождать(600);
		Исключение
			// Пустая таблица или таблица на неактивной странице: менеджер отказывает, клиент цел.
			Строки.Добавить("ПОДРОБНО;" + Роль + ";" + ЧастьИмени + ";таблица " + Таблица.Имя + " без перехода к строке");
		КонецПопытки;
		ОшибкаКлиента(ЧастьИмени, "активизация строки таблицы " + Таблица.Имя);
	КонецЦикла;
	Для Каждого Кнопка Из ТестФорма.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
		Имя = Кнопка.Имя;
		Если Нажатые.Получить(Имя) <> Неопределено Или Не КомандаБезопасна(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Если Не Кнопка.ТекущаяВидимость() Или Не Кнопка.ТекущаяДоступность() Тогда
				Продолжить;
			КонецЕсли;
			Кнопка.Нажать();
		Исключение
			Продолжить;
		КонецПопытки;
		Нажатые.Вставить(Имя, Истина);
		НажатоВсего = НажатоВсего + 1;
		Строки.Добавить("НАЖАТО;" + Роль + ";" + ЧастьИмени + ";" + Имя);
		ОшибкаКлиента(ЧастьИмени, "команда " + Имя);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция КомандаБезопасна(Имя)
	Возврат СтрНайти(Имя, "Сортировать") > 0 Или СтрЗаканчиваетсяНа(Имя, "Обновить");
КонецФункции

&НаКлиенте
Функция ОшибкаКлиента(ЧастьИмени, Действие)
	Информация = Приложение.ПолучитьТекущуюИнформациюОбОшибке();
	Если Информация = Неопределено Тогда
		// Ошибка получения данных (например, динамического списка) приходит не исключением, а окном платформы
		// «ErrorWindow»: без этой проверки обход считал форму с таким окном исправной (проба 2026-11-21).
		Возврат ОкноОшибкиПлатформы(ЧастьИмени, Действие);
	КонецЕсли;
	Текст = ОднойСтрокой(ПодробноеПредставлениеОшибки(Информация));
	Если Текст = ПоследняяОшибкаКлиента Тогда
		// Та же ошибка, что уже записана: клиент отдаёт её, пока окно не закрыто. Второй раз не считаем.
		ЗакрытьОкнаОшибок(ЧастьИмени);
		Возврат Ложь;
	КонецЕсли;
	ПоследняяОшибкаКлиента = Текст;
	ЗаписатьОшибку(ЧастьИмени, Действие, Текст);
	ЗакрытьОкнаОшибок(ЧастьИмени);
	Возврат Истина;
КонецФункции

// Что видит пользователь, когда ожидаемой формы нет: активное окно, его сообщения, открытые формы и тексты
// безымянных форм (окно предупреждения платформы, например «Недостаточно прав»).
&НаКлиенте
Функция СостояниеКлиента()
	Части = Новый Массив;
	Попытка
		Активное = Приложение.ПолучитьАктивноеОкно();
		Части.Добавить("активное окно: " + Активное.Заголовок);
		Для Каждого Текст Из Активное.ПолучитьТекстыСообщенийПользователю() Цикл
			Части.Добавить("сообщение: " + Текст);
		КонецЦикла;
	Исключение
		Части.Добавить("активное окно не получено");
	КонецПопытки;
	Попытка
		Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
			Части.Добавить("окно: «" + ОкноКлиента.Заголовок + "» основное=" + ОкноКлиента.Основное);
		КонецЦикла;
	Исключение
		Части.Добавить("список окон не получен");
	КонецПопытки;
	Попытка
		Для Каждого Открытая Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
			Части.Добавить("форма: " + Открытая.ИмяФормы + " «" + Открытая.ТекстЗаголовка + "»");
			Если ЗначениеЗаполнено(Открытая.ИмяФормы) Тогда
				Продолжить;
			КонецЕсли;
			Части.Добавить("окно без имени формы: " + Открытая.ТекстЗаголовка);
			Для Каждого Подчиненный Из Открытая.ПолучитьПодчиненныеОбъекты() Цикл
				Попытка
					Части.Добавить("текст: " + Подчиненный.ТекстЗаголовка);
				Исключение
					Продолжить;
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	Исключение
		Части.Добавить("список форм не получен");
	КонецПопытки;
	Возврат ОднойСтрокой(СтрСоединить(Части, " | "));
КонецФункции

// Окно ошибки времени выполнения закрывается кнопкой: закрытие активного окна его не убирало, и одна ошибка
// записывалась на каждый следующий шаг (прогон гейта 2026-11-21).
&НаКлиенте
Процедура ЗакрытьОкнаОшибок(ЧастьИмени)
	Попытка
		Для Каждого Открытая Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
			Если ЗначениеЗаполнено(Открытая.ИмяФормы) И Открытая.ИмяФормы <> "ErrorWindow" Тогда
				Продолжить;
			КонецЕсли;
			Кнопка = Открытая.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"));
			Если Кнопка <> Неопределено Тогда
				Кнопка.Нажать();
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("ЗАМЕЧАНИЕ;" + Роль + ";" + ЧастьИмени + ";окно ошибки не закрылось");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ОкноОшибкиПлатформы(ЧастьИмени, Действие)
	Найдено = Ложь;
	Для Каждого Открытая Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
		Если Открытая.ИмяФормы <> "ErrorWindow" Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Истина;
		Тексты = Новый Массив;
		Для Каждого Подчиненный Из Открытая.НайтиОбъекты() Цикл
			ТипЭлемента = ТипЗнч(Подчиненный);
			Текст = "";
			Попытка
				Если ТипЭлемента = Тип("ТестируемоеПолеФормы") Тогда
					Текст = Подчиненный.ПолучитьПредставлениеДанных();
				ИначеЕсли ТипЭлемента = Тип("ТестируемаяДекорацияФормы") Тогда
					Текст = Подчиненный.ТекстЗаголовка;
				Иначе
					Продолжить;
				КонецЕсли;
			Исключение
				Текст = "";
			КонецПопытки;
			Если ЗначениеЗаполнено(Текст) И Тексты.Найти(Текст) = Неопределено Тогда
				Тексты.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
		ЗаписатьОшибку(ЧастьИмени, Действие, "окно ошибки платформы: " + ОднойСтрокой(СтрСоединить(Тексты, " | ")));
		Попытка
			Открытая.НайтиОбъект(Тип("ТестируемаяКнопкаФормы")).Нажать();
		Исключение
			Попытка
				Приложение.ПолучитьАктивноеОкно().Закрыть();
			Исключение
				Строки.Добавить("ЗАМЕЧАНИЕ;" + Роль + ";" + ЧастьИмени + ";окно ошибки платформы не закрылось");
			КонецПопытки;
		КонецПопытки;
	КонецЦикла;
	Возврат Найдено;
КонецФункции

&НаКлиенте
Процедура ЗаписатьОшибку(ЧастьИмени, Действие, Текст)
	ОшибокВсего = ОшибокВсего + 1;
	Строки.Добавить("ОШИБКА;" + Роль + ";" + ЧастьИмени + ";" + Действие + ";" + Текст);
КонецПроцедуры

&НаКлиенте
Функция ОднойСтрокой(Текст)
	Возврат СтрЗаменить(СтрЗаменить(Текст, Символы.ПС, " | "), Символы.ВК, "");
КонецФункции
