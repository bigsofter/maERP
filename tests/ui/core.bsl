// Ядро тестов интерфейса maERP: модуль формы внешней обработки, выполняется в сеансе тест-менеджера
// (администратор) и управляет тест-клиентом, запущенным под проверяемым пользователем.
// Сборка и запуск - scripts/uitest.sh; план и факты пробы - docs/plans/ui-tests.md.
//
// Параметр запуска: отчёт|порт|метка роли|файл списка форм (строки «ссылка;часть имени формы»).
// Обход формы: открыть на клиенте, активизировать каждую страницу, встать на первую строку каждой видимой
// таблицы, нажать видимые доступные команды сортировки и обновления. Провал - ошибка времени выполнения
// на клиенте (ПолучитьТекущуюИнформациюОбОшибке), неоткрывшаяся форма, потерянное соединение.
// Команды, меняющие данные, здесь не нажимаются: они - дело сценариев.

&НаКлиенте
Перем Строки, Приложение, ГлавноеОкно, Роль, Нажатые, Тронутые, ОшибокВсего, НажатоВсего, ФормОбойдено, ПоследняяОшибкаКлиента;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("Прогон", 1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура Прогон()
	Части = СтрРазделить(ПараметрЗапуска, "|");
	Строки = Новый Массив;
	Строки.Добавить("СТАРТ;");
	Роль = Части[2];
	ОшибокВсего = 0;
	НажатоВсего = 0;
	ФормОбойдено = 0;
	Попытка
		Подключиться(Число(Части[1]));
		Список = Новый ТекстовыйДокумент;
		Список.Прочитать(Части[3], КодировкаТекста.UTF8);
		Для Номер = 1 По Список.КоличествоСтрок() Цикл
			Описание = СтрРазделить(Список.ПолучитьСтроку(Номер), ";");
			Если Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "снимок=") Тогда
				ПоказатьДляСнимка(Описание[0], Описание[1], Сред(Описание[2], 8), Части[0] + ".ready");
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "единица=") Тогда
				СценарийЕдиницаПослеВыбораТовара(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 9), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "запись=") Тогда
				СценарийЗаписьСтроки(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 8), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "ордер=") Тогда
				СценарийЗаписьОрдером(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 7), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "сортировка=") Тогда
				СценарийСортировкаТаблицы(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 12), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "безввода=") Тогда
				СценарийБезВвода(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 10), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "ордерзаказа=") Тогда
				СценарийОрдерПоЗаказуБезПрава(Описание[0], Описание[1]);
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "основание=") Тогда
				СценарийПоступлениеПоЗаказуБезПрава(Описание[0], Описание[1], Сред(Описание[2], 11));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "печатьпоступления=") Тогда
				СценарийПечатьПоступленияПоЗаказу(СтрРазделить(Сред(Описание[2], 19), ","));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "отказ=") Тогда
				СценарийОтказОткрытия(Описание[0], Описание[1], Сред(Описание[2], 7));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "найти=") Тогда
				СценарийНайтиСтроку(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 7), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "видно=") Тогда
				СценарийВидимостьПолей(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 7), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "удаление=") Тогда
				СценарийУдалениеСтроки(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 10), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "стабильно=") Тогда
				СценарийВыделениеСтабильно(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 11), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "повтор=") Тогда
				СценарийПовторноеОткрытие(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 8), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНачинаетсяС(Описание[2], "строки=") Тогда
				СценарийПроходПоСтрокам(Описание[0], Описание[1], СтрРазделить(Сред(Описание[2], 8), ":"));
			ИначеЕсли Описание.Количество() >= 3 И СтрНайти(Описание[2], "=") > 0 Тогда
				// Опечатка в слове сценария не должна превращать его в обычный обход формы.
				ОшибокВсего = ОшибокВсего + 1;
				Строки.Добавить("ОШИБКА;" + Роль + ";" + Описание[1] + ";неизвестный сценарий «" + Описание[2] + "»");
			ИначеЕсли Описание.Количество() >= 2 И ЗначениеЗаполнено(Описание[0]) Тогда
				ОбойтиФорму(Описание[0], Описание[1]);
			КонецЕсли;
		КонецЦикла;
		Попытка
			ГлавноеОкно.Закрыть();
			Приложение.РазорватьСоединение();
		Исключение
			Строки.Добавить("ЗАМЕЧАНИЕ;" + Роль + ";клиент не закрылся штатно");
		КонецПопытки;
	Исключение
		ОшибокВсего = ОшибокВсего + 1;
		Строки.Добавить("ОШИБКА;" + Роль + ";прогон;" + ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Строки.Добавить(СтрШаблон("ИТОГ;Роль=%1;ФормОбойдено=%2;КомандНажато=%3;Ошибок=%4",
		Роль, Формат(ФормОбойдено, "ЧН=0; ЧГ="), Формат(НажатоВсего, "ЧН=0; ЧГ="), Формат(ОшибокВсего, "ЧН=0; ЧГ=")));
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(СтрСоединить(Строки, Символы.ПС));
	Документ.Записать(Части[0], КодировкаТекста.UTF8);
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Подключиться(Порт)
	Приложение = Новый ТестируемоеПриложение("localhost", Порт);
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + 180000;
	Подключено = Ложь;
	Пока Не Подключено И ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
		Попытка
			Приложение.УстановитьСоединение();
			Подключено = Истина;
		Исключение
			Подключено = Ложь;
		КонецПопытки;
	КонецЦикла;
	Если Не Подключено Тогда
		ВызватьИсключение "нет соединения с тест-клиентом на порту " + Формат(Порт, "ЧГ=");
	КонецЕсли;
	ГлавноеОкно = Приложение.НайтиОбъект(Тип("ТестируемоеОкноКлиентскогоПриложения"), , , 120);
	Если ГлавноеОкно = Неопределено Тогда
		ВызватьИсключение "главное окно тест-клиента не появилось";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбойтиФорму(Ссылка, ЧастьИмени)
	Нажатые = Новый Соответствие;
	Тронутые = Новый Соответствие;
	НажатоДо = НажатоВсего;
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
	Исключение
		ЗаписатьОшибку(ЧастьИмени, "открытие", ОднойСтрокой(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;
	Если ОшибкаКлиента(ЧастьИмени, "открытие") Тогда
		Возврат;
	КонецЕсли;
	ТестФорма = НайтиФорму(ЧастьИмени);
	Если ТестФорма = Неопределено Тогда
		Если Не ОшибкаКлиента(ЧастьИмени, "открытие") Тогда
			ЗаписатьОшибку(ЧастьИмени, "открытие", "форма не открылась за 30 секунд; " + СостояниеКлиента());
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Страниц = 0;
	Попытка
		ОбработатьВидимое(ТестФорма, ЧастьИмени);
		ОбойтиСтраницы(ТестФорма, ЧастьИмени, Страниц);
	Исключение
		ЗаписатьОшибку(ЧастьИмени, "обход", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	// Обработчики ожидания формы (панель сведений по текущей строке) отрабатывают с задержкой: их ошибка
	// должна лечь на эту форму, а не на следующий шаг.
	Подождать(1500);
	ОшибкаКлиента(ЧастьИмени, "после обхода");
	ФормОбойдено = ФормОбойдено + 1;
	Строки.Добавить(СтрШаблон("ФОРМА;%1;%2;Страниц=%3;Таблиц=%4;Нажато=%5;Ошибок=%6", Роль, ТестФорма.ИмяФормы,
		Формат(Страниц, "ЧН=0; ЧГ="), Формат(Тронутые.Количество(), "ЧН=0; ЧГ="),
		Формат(НажатоВсего - НажатоДо, "ЧН=0; ЧГ="), Формат(ОшибокВсего - ОшибокДо, "ЧН=0; ЧГ=")));
	// Окно формы не закрывается: закрытие через тест-команду роняло клиент 8.5.1.1423 на macOS при открытии
	// следующей формы (SIGSEGV в SetWindowPos, проба 2026-11-21). Окна закрываются вместе с клиентом.
КонецПроцедуры

// Снимок окна (UITEST_SHOT): форма открывается, активизируется названная страница (пусто - как открылась),
// создаётся файл-сигнал, и клиент 25 секунд стоит - за это время scripts/uitest.sh снимает его окно.
&НаКлиенте
Процедура ПоказатьДляСнимка(Ссылка, ЧастьИмени, ИмяСтраницы, ФайлСигнала)
	ГлавноеОкно.ВыполнитьКоманду(Ссылка);
	ТестФорма = НайтиФорму(ЧастьИмени);
	Если ТестФорма = Неопределено Тогда
		Если Не ОшибкаКлиента(ЧастьИмени, "открытие") Тогда
			ЗаписатьОшибку(ЧастьИмени, "открытие", "форма не открылась за 30 секунд; " + СостояниеКлиента());
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(ИмяСтраницы, ",", Ложь) Цикл
		Если СтрНачинаетсяС(Имя, "@") Тогда
			// «@Таблица#N» - встать на N-ю строку таблицы-владельца.
			ВстатьНаСтрокуВладельца(ТестФорма, Сред(Имя, 2));
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Имя, "!~") Тогда
			// «!~Часть» - нажать первую кнопку, в имени которой есть эта часть (кнопка «Сформировать» автоформы отчёта:
			// имя элемента даёт платформа), и дождаться результата.
			Нажата = Ложь;
			ИменаКнопок = Новый Массив;
			Для Каждого Кнопка Из ТестФорма.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
				ИменаКнопок.Добавить(Кнопка.Имя);
				Если Не Нажата И СтрНайти(Кнопка.Имя, Сред(Имя, 3)) > 0 Тогда
					Кнопка.Нажать();
					Нажата = Истина;
				КонецЕсли;
			КонецЦикла;
			Если Нажата Тогда
				Подождать(8000);
				Строки.Добавить("НАЖАТО;" + Роль + ";" + ЧастьИмени + ";" + Имя);
			Иначе
				ЗаписатьОшибку(ЧастьИмени, "снимок", "нет кнопки с «" + Сред(Имя, 3) + "» в имени; кнопки: "
					+ СтрСоединить(ИменаКнопок, ", "));
			КонецЕсли;
			ОшибкаКлиента(ЧастьИмени, "кнопка " + Имя);
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Имя, "+") Тогда
			// «+Таблица» - добавить строку в таблицу перед снимком (как выглядит начало ввода).
			Попытка
				ТаблицаВвода = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Сред(Имя, 2), 5);
				ТаблицаВвода.Активизировать();
				ТаблицаВвода.ДобавитьСтроку();
				Подождать(1500);
			Исключение
				ЗаписатьОшибку(ЧастьИмени, "снимок", ОднойСтрокой(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
			ОшибкаКлиента(ЧастьИмени, "добавление строки " + Имя);
			Продолжить;
		КонецЕсли;
		Страница = ТестФорма.НайтиОбъект(Тип("ТестируемаяГруппаФормы"), , Имя, 5);
		Если Страница = Неопределено Тогда
			ЗаписатьОшибку(ЧастьИмени, "снимок", "нет страницы " + Имя);
			Возврат;
		КонецЕсли;
		Страница.Активизировать();
	КонецЦикла;
	ОшибкаКлиента(ЧастьИмени, "снимок");
	Строки.Добавить("СОСТОЯНИЕ;" + Роль + ";" + ЧастьИмени + ";" + СостояниеКлиента());
	Сигнал = Новый ТекстовыйДокумент;
	Сигнал.УстановитьТекст(ТестФорма.ИмяФормы);
	Сигнал.Записать(ФайлСигнала, КодировкаТекста.UTF8);
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + 25000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
		Приложение.НайтиОбъекты(Тип("ТестируемаяФорма"));
	КонецЦикла;
	ФормОбойдено = ФормОбойдено + 1;
	Строки.Добавить("СНИМОК;" + Роль + ";" + ТестФорма.ИмяФормы + ";" + ИмяСтраницы);
КонецПроцедуры

// Сценарий «единица после выбора товара» (строка списка: «...;единица=страницы:таблица:поле товара:поле единицы»):
// в таблице добавляется строка, в поле товара вводится название товара с заполненной единицей, читается ячейка
// единицы, ввод строки отменяется - данные базы не меняются. Провал - пустая ячейка единицы или ошибка клиента.
&НаКлиенте
Процедура СценарийЕдиницаПослеВыбораТовара(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + Шаги[1];
	Если Шаги.Количество() < 4 Тогда
		ЗаписатьОшибку(Метка, "сценарий", "нужно «страницы:таблица:поле товара:поле единицы»");
		Возврат;
	КонецЕсли;
	Товар = ТоварСЕдиницей();
	Если Товар = Неопределено Тогда
		ЗаписатьОшибку(Метка, "сценарий", "в базе нет товара с заполненной единицей");
		Возврат;
	КонецЕсли;
	ОшибокДо = ОшибокВсего;
	Таблица = Неопределено;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Если Шаги.Количество() > 4 Тогда
			ВстатьНаСтрокуВладельца(ТестФорма, Шаги[4]);
		КонецЕсли;
		Таблица = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[1], 5);
		Таблица.Активизировать();
		Таблица.ДобавитьСтроку();
		// Рабочие места вставляют строку сами и начинают её ввод обработчиком ожидания - ждём его.
		Подождать(1500);
		Если Не ОшибкаКлиента(Метка, "добавление строки") Тогда
			ВвестиВЯчейку(Таблица, Шаги[2], Товар.Наименование);
			Если Не ОшибкаКлиента(Метка, "выбор товара") Тогда
				// Выбор товара форма обрабатывает при уходе из поля.
				Таблица.ПерейтиКСледующемуЭлементу();
				ОшибкаКлиента(Метка, "уход из поля товара");
				ВЯчейкеТовара = Таблица.ПолучитьТекстЯчейки(Шаги[2]);
				Единица = Таблица.ПолучитьТекстЯчейки(Шаги[3]);
				Если ПустаяСтрока(ВЯчейкеТовара) Тогда
					ЗаписатьОшибку(Метка, "выбор товара", "товар «" + Товар.Наименование + "» в строку не попал");
				ИначеЕсли ПустаяСтрока(Единица) Тогда
					ЗаписатьОшибку(Метка, "единица", "после выбора товара «" + ВЯчейкеТовара + "» единица пуста");
				Иначе
					Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;единица «%3» после выбора товара «%4»", Роль, Метка, Единица,
						Товар.Наименование));
				КонецЕсли;
			КонецЕсли;
			Таблица.ЗакончитьРедактированиеСтроки(Истина);
			ОшибкаКлиента(Метка, "отмена ввода строки");
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		// Начатая строка не должна остаться в форме: следующий сценарий работает с той же формой.
		Попытка
			Если Таблица <> Неопределено Тогда
				Таблица.ЗакончитьРедактированиеСтроки(Истина);
			КонецЕсли;
		Исключение
			Строки.Добавить("ЗАМЕЧАНИЕ;" + Роль + ";" + Метка + ";ввод строки после сбоя не отменён");
		КонецПопытки;
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
	КонецЕсли;
КонецПроцедуры

// Шаги сценария через запятую: имя страницы - активизировать; «@Таблица#N» - встать на N-ю строку;
// «!Кнопка» - нажать; «=Поле=Вариант» - выбрать вариант переключателя.
&НаКлиенте
Процедура ВыполнитьШаги(ТестФорма, ОписаниеШагов)
	Для Каждого Имя Из СтрРазделить(ОписаниеШагов, ",", Ложь) Цикл
		Если СтрНачинаетсяС(Имя, "=") Тогда
			// «=Поле=Вариант» - выбрать вариант переключателя (режим таблицы).
			Выбор = СтрРазделить(Сред(Имя, 2), "=");
			ТестФорма.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , Выбор[0], 5).ВыбратьВариант(Выбор[1]);
			Подождать(1500);
		ИначеЕсли СтрНачинаетсяС(Имя, "@") Тогда
			ВстатьНаСтрокуВладельца(ТестФорма, Сред(Имя, 2));
		ИначеЕсли СтрНачинаетсяС(Имя, "!") Тогда
			// «!Кнопка» - нажать кнопку (например, открыть панель фильтров).
			// Кнопка-переключатель (панель фильтров) после первого нажатия пропадает - это не ошибка шага.
			Кнопка = ТестФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , Сред(Имя, 2), 5);
			Если Кнопка = Неопределено Тогда
				// Имена кнопок формы - в текст ошибки: имя кнопки команды, размещённой платформой, заранее неизвестно.
				ИменаКнопок = Новый Массив;
				Для Каждого КнопкаФормы Из ТестФорма.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
					ИменаКнопок.Добавить(КнопкаФормы.Имя);
				КонецЦикла;
				ВызватьИсключение "кнопки " + Сред(Имя, 2) + " в форме нет; есть: " + СтрСоединить(ИменаКнопок, ",");
			КонецЕсли;
			Попытка
				Кнопка.Нажать();
			Исключение
				Строки.Добавить("ПОДРОБНО;" + Роль + ";кнопка " + Сред(Имя, 2) + " не нажата (уже нажата или скрыта)");
			КонецПопытки;
			Подождать(700);
		Иначе
			ТестФорма.НайтиОбъект(Тип("ТестируемаяГруппаФормы"), , Имя, 5).Активизировать();
			// Смена закладки перечитывает её данные на сервере: без паузы таблица закладки ещё недоступна.
			Подождать(700);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Сценарий «видимость полей» (строка списка: «...;видно=шаги:видимые поля:скрытые поля»): после шагов названные
// поля должны быть видны пользователю, а скрытые - нет. Так проверяется, что фильтр стоит в панели своей закладки.
&НаКлиенте
Процедура СценарийВидимостьПолей(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + "видимость после " + Шаги[0];
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Подождать(700);
		Если Не ОшибкаКлиента(Метка, "шаги") Тогда
			Для Номер = 1 По 2 Цикл
				Если Шаги.Количество() <= Номер Тогда
					Прервать;
				КонецЕсли;
				Для Каждого Имя Из СтрРазделить(Шаги[Номер], ",", Ложь) Цикл
					Поле = ТестФорма.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , Имя, 2);
					Если Поле = Неопределено Тогда
						// Кнопка формы или командной панели таблицы - тем же списком.
						Поле = ТестФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , Имя, 2);
					КонецЕсли;
					Если Поле = Неопределено Тогда
						// Переименованное поле не «скрыто»: без этой ветки сценарий проходил вхолостую.
						ЗаписатьОшибку(Метка, "видимость", "поля " + Имя + " в форме нет");
						Продолжить;
					КонецЕсли;
					Видимо = Поле.ТекущаяВидимость();
					Если Видимо <> (Номер = 1) Тогда
						ЗаписатьОшибку(Метка, "видимость", "поле " + Имя + ?(Номер = 1, " не видно", " видно, а не должно"));
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
		Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;видны: %3; скрыты: %4", Роль, Метка, Шаги[1],
			?(Шаги.Количество() > 2, Шаги[2], "")));
	КонецЕсли;
КонецПроцедуры

// Сценарий «повторное открытие» (строка списка: «...;повтор=шаги:таблица»): выполнить шаги (перейти на закладку),
// закрыть форму, открыть заново - таблица закладки должна быть видна без шагов: форма открывается на закладке, на
// которой её закрыли.
&НаКлиенте
Процедура СценарийПовторноеОткрытие(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + "повторное открытие после " + Шаги[0];
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Подождать(700);
		ПередЗакрытием = "";
		Если Шаги.Количество() > 2 Тогда
			ГруппаДо = ТестФорма.НайтиОбъект(Тип("ТестируемаяГруппаФормы"), , Шаги[2], 5);
			ПередЗакрытием = ГруппаДо.ПолучитьТекущуюСтраницу().Имя;
		КонецЕсли;
		// У тестируемой формы метода закрытия нет: закрывается её окно.
		ТестФорма.Активизировать();
		Приложение.ПолучитьАктивноеОкно().Закрыть();
		Подождать(1500);
		Для Каждого Кандидат Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
			Если СтрНайти(Кандидат.ИмяФормы, ЧастьИмени) = 1 Тогда
				ВызватьИсключение "форма не закрылась";
			КонецЕсли;
		КонецЦикла;
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась повторно за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		Подождать(1500);
		Если Не ОшибкаКлиента(Метка, "повторное открытие") Тогда
			Таблица = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[1], 5);
			Если Таблица = Неопределено Тогда
				ЗаписатьОшибку(Метка, "повторное открытие", "таблицы " + Шаги[1] + " в форме нет");
			ИначеЕсли Не Таблица.ТекущаяВидимость() Тогда
				ЗаписатьОшибку(Метка, "повторное открытие", "таблица " + Шаги[1] + " не видна: открыта другая закладка");
			КонецЕсли;
			// Таблицу на неоткрытой закладке тест-клиент тоже считает видимой: открытая закладка сверяется по группе
			// страниц (третий шаг - имя группы, первый - имя закладки).
			Если Шаги.Количество() > 2 Тогда
				Группа = ТестФорма.НайтиОбъект(Тип("ТестируемаяГруппаФормы"), , Шаги[2], 5);
				Открыта = Группа.ПолучитьТекущуюСтраницу().Имя;
				Если Открыта <> Шаги[0] Тогда
					ЗаписатьОшибку(Метка, "повторное открытие", "открыта закладка " + Открыта + ", закрывали на " + Шаги[0]
						+ " (перед закрытием тест-клиент видел " + ПередЗакрытием + "); " + СостояниеКлиента());
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
		Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;после закрытия и открытия видна таблица %3", Роль, Метка, Шаги[1]));
	КонецЕсли;
КонецПроцедуры

// Сценарий «проход по строкам» (строка списка: «...;строки=шаги:таблица:число строк[:выделить]»): встать по
// очереди на каждую из первых строк таблицы - панели сведений и нижние таблицы перечитываются под каждую строку,
// в том числе под документ без контрагента из «грязных» данных. «выделить» - в конце выделить все строки таблицы
// (обработчики активизации получают несколько выделенных строк).
&НаКлиенте
Процедура СценарийПроходПоСтрокам(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + "строки " + Шаги[1] + ?(ЗначениеЗаполнено(Шаги[0]), " после " + Шаги[0], "");
	ОшибокДо = ОшибокВсего;
	Пройдено = 0;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Таблица = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[1], 5);
		Таблица.Активизировать();
		Таблица.ПерейтиКПервойСтроке();
		Для Номер = 1 По Число(Шаги[2]) Цикл
			Подождать(900);
			Пройдено = Пройдено + 1;
			Если ОшибкаКлиента(Метка, "строка " + Номер) Тогда
				Прервать;
			КонецЕсли;
			Попытка
				Таблица.ПерейтиКСледующейСтроке();
			Исключение
				// Строки кончились.
				Прервать;
			КонецПопытки;
		КонецЦикла;
		Если ОшибокВсего = ОшибокДо И Шаги.Количество() > 3 И Шаги[3] = "выделить" Тогда
			Таблица.ВыделитьВсеСтроки();
			Подождать(2000);
			ОшибкаКлиента(Метка, "выделение всех строк");
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
		Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;строк пройдено: %3", Роль, Метка, Формат(Пройдено, "ЧН=0; ЧГ=")));
	КонецЕсли;
КонецПроцедуры

// Сценарий «запись строки» (строка списка: «...;запись=шаги:таблица:поле клиента:поле товара:поле количества:поле
// статуса»): добавить строку, ввести клиента, товар и количество, закончить ввод - строка записывается в базу (в
// рабочем месте производства - в заказ клиента), окна ошибки нет, в ячейке статуса не «не записано». Данные базы
// меняются: сценарий - для прогонов под ролью (tests/ui/role-scenarios.txt), в гейт под администратором не входит.
&НаКлиенте
Процедура СценарийЗаписьСтроки(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + "запись строки " + ?(Шаги.Количество() > 1, Шаги[1], "");
	Если Шаги.Количество() < 6 Тогда
		ЗаписатьОшибку(Метка, "сценарий", "нужно «шаги:таблица:поле клиента:поле товара:поле количества:поле статуса»");
		Возврат;
	КонецЕсли;
	Товар = ТоварСЕдиницей();
	Клиент = КлиентДляВвода();
	Если Товар = Неопределено Или Клиент = Неопределено Тогда
		ЗаписатьОшибку(Метка, "сценарий", "в базе нет товара с единицей или клиента с уникальным названием");
		Возврат;
	КонецЕсли;
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Если СтрНайти(Шаги[0], "@Заказы#") > 0 Тогда
			// На каком заказе стоит курсор: номера строк списка зависят от заказов, записанных прежними сценариями.
			Попытка
				Владелец = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Заказы", 5);
				Строки.Добавить(СтрШаблон("ПОДРОБНО;%1;%2;заказ под курсором: «%3» от %4, статус «%5»", Роль, Метка,
					Владелец.ПолучитьТекстЯчейки("ЗаказыКонтрагент"), Владелец.ПолучитьТекстЯчейки("ЗаказыДата"),
					Владелец.ПолучитьТекстЯчейки("ЗаказыСтатус")));
			Исключение
				Строки.Добавить("ПОДРОБНО;" + Роль + ";" + Метка + ";заказ под курсором не прочитан");
			КонецПопытки;
		КонецЕсли;
		Таблица = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[1], 5);
		Таблица.Активизировать();
		Таблица.ДобавитьСтроку();
		Подождать(1500);
		Если Не ОшибкаКлиента(Метка, "добавление строки") Тогда
			Если Не ПустаяСтрока(Шаги[2]) Тогда
				ВвестиВЯчейку(Таблица, Шаги[2], Клиент);
				ОшибкаКлиента(Метка, "выбор клиента");
			КонецЕсли;
			Если СтрНачинаетсяС(Шаги[3], "~") Тогда
				// «~Колонка» - товар в новой строке подставляет программа (выпуск по строке заказа): вводится только
				// количество, а ячейка товара после записи сверяется как обычно.
				Шаги[3] = Сред(Шаги[3], 2);
			Иначе
				ВвестиВЯчейку(Таблица, Шаги[3], Товар.Наименование);
				ОшибкаКлиента(Метка, "выбор товара");
			КонецЕсли;
			ВвестиВЯчейку(Таблица, Шаги[4], "1");
			ОшибкаКлиента(Метка, "ввод количества");
			Таблица.ЗакончитьРедактированиеСтроки(Ложь);
			// Запись строки и перечитывание текущего заказа - серверные вызовы после окончания ввода.
			Подождать(4000);
			Если Не ОшибкаКлиента(Метка, "запись строки") Тогда
				Статус = Таблица.ПолучитьТекстЯчейки(Шаги[5]);
				ВЯчейкеТовара = Таблица.ПолучитьТекстЯчейки(Шаги[3]);
				Если ПустаяСтрока(ВЯчейкеТовара) Тогда
					ЗаписатьОшибку(Метка, "запись", "после окончания ввода в текущей строке нет товара");
				ИначеЕсли Шаги.Количество() > 7 И Шаги[6] = "отказ" Тогда
					// Ожидаемый отказ программы с объяснением: строка не записана, в статусе - названная причина.
					// Причина отказа - в ячейке статуса или в сообщении пользователю (рабочее место закупок).
					Если СтрНайти(НРег(Статус), НРег(Шаги[7])) > 0 Тогда
						Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;строка не записана, программа отказала с объяснением: «%3»",
							Роль, Метка, Статус));
					ИначеЕсли ПустаяСтрока(Статус) И СтрНайти(НРег(СостояниеКлиента()), НРег("сообщение: " + Шаги[7])) > 0 Тогда
						Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;строка не записана, программа отказала сообщением: «%3»",
							Роль, Метка, Шаги[7]));
					Иначе
						ЗаписатьОшибку(Метка, "отказ", "ожидался отказ «" + Шаги[7] + "», статус «" + Статус + "»");
					КонецЕсли;
				ИначеЕсли СтрНайти(НРег(Статус), "не запис") > 0 Или ПустаяСтрока(Статус) Или СтрЗаканчиваетсяНа(Статус, ".") Тогда
					// Статус записанной строки - слово («Черновик», «Проведён»); предложение с точкой - текст отказа.
					ЗаписатьОшибку(Метка, "запись", "строка не записана, статус «" + Статус + "»; " + СостояниеКлиента());
				Иначе
					Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;строка записана: клиент «%3», товар «%4», статус «%5»", Роль,
						Метка, ?(ПустаяСтрока(Шаги[2]), "", Клиент), ВЯчейкеТовара, Статус));
					Если Шаги.Количество() > 7 И Шаги[6] <> "отказ" Тогда
						НажатьИДождатьсяФормы(ТестФорма, Метка, Шаги[6], Шаги[7]);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
	КонецЕсли;
КонецПроцедуры

// Нажать в форме документа команды печати, в имени кнопки которых есть часть: окна ошибки нет, форма печати открылась и
// закрыта (печать документа, введённого по заказу поставщику, у пользователя без права на заказы поставщику).
&НаКлиенте
Процедура ПечататьИзФормы(ТестФорма, Метка, ЧастьИмениКоманды)
	Нажато = 0;
	ИменаКнопок = Новый Массив;
	Для Каждого Кнопка Из ТестФорма.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
		ИменаКнопок.Добавить(Кнопка.Имя);
		Если СтрНайти(Кнопка.Имя, ЧастьИмениКоманды) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Кнопка.Нажать();
		Подождать(4000);
		Нажато = Нажато + 1;
		ТекстОкна = ТекстИЗакрытиеОкнаОтказа();
		Если Не ПустаяСтрока(ТекстОкна) Тогда
			ЗаписатьОшибку(Метка, "печать " + Кнопка.Имя, "окно ошибки: " + ТекстОкна);
		ИначеЕсли Не ОшибкаКлиента(Метка, "печать " + Кнопка.Имя) Тогда
			Открыта = Ложь;
			Для Каждого Кандидат Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
				Если Кандидат.ИмяФормы = "ОбщаяФорма.ПечатьДокументов" Тогда
					// У тестируемой формы нет «Закрыть»: закрывается активное окно (так же в сценарии «повтор=»).
					Открыта = Истина;
					Кандидат.Активизировать();
					Приложение.ПолучитьАктивноеОкно().Закрыть();
				КонецЕсли;
			КонецЦикла;
			Если Открыта Тогда
				Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;печать %3: печатная форма открылась без ошибки", Роль, Метка,
					Кнопка.Имя));
			Иначе
				ЗаписатьОшибку(Метка, "печать " + Кнопка.Имя, "печатная форма не открылась; " + СостояниеКлиента());
			КонецЕсли;
			Подождать(1000);
		КонецЕсли;
		ТестФорма.Активизировать();
	КонецЦикла;
	Если Нажато = 0 Тогда
		ЗаписатьОшибку(Метка, "печать", "кнопки с «" + ЧастьИмениКоманды + "» в имени нет; кнопки: " + СтрСоединить(ИменаКнопок, ","));
	КонецЕсли;
КонецПроцедуры

// Сценарий «ордер по заказу поставщику без права» (строка списка: «ссылка списка приходных ордеров;часть имени формы
// списка;ордерзаказа=»): сеанс тест-менеджера (администратор) включает ордерные склады и принимает заказ поставщику
// приходным ордером; пользователь без права на заказы поставщику печатает этот ордер из его формы (печатная форма
// открывается без окна ошибки) и отменяет его проведение командой списка - без окна ошибки платформы (отмена читает
// заказ клиента основания).
&НаКлиенте
Процедура СценарийОрдерПоЗаказуБезПрава(Ссылка, ЧастьИмени)
	Метка = "Документ.ПриходныйОрдер.по заказу поставщику без права";
	ОшибокДо = ОшибокВсего;
	Попытка
		ВключитьОрдерныеСкладыИПосчитатьОрдера();
		Данные = ПриходныйОрдерПоЗаказуПоставщику();
		Если Данные = Неопределено Тогда
			ВызватьИсключение "проведённый приходный ордер по заказу поставщику создать не удалось";
		КонецЕсли;
		// Печать ордера: основание - заказ поставщику, его номер и дата попадают в печатную форму (найдено приёмкой
		// 2026-11-25: печать читала их без права пользователя).
		ГлавноеОкно.ВыполнитьКоманду(Данные.НавигационнаяСсылка);
		ФормаОрдера = НайтиФорму("Документ.ПриходныйОрдер.Форма.ФормаДокумента");
		Если ФормаОрдера = Неопределено Тогда
			ВызватьИсключение "форма приходного ордера не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		Если Не ОшибкаКлиента(Метка, "открытие ордера") Тогда
			ПечататьИзФормы(ФормаОрдера, Метка, "ПечатьПриходныйОрдер");
		КонецЕсли;
		ФормаОрдера.Активизировать();
		Приложение.ПолучитьАктивноеОкно().Закрыть();
		Подождать(1500);
		ТекстИЗакрытиеОкнаОтказа();
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ФормаСписка = НайтиФорму(ЧастьИмени);
		Если ФормаСписка = Неопределено Тогда
			ВызватьИсключение "список приходных ордеров не открылся за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		// «Оформить» читает выделенные строки списка, а тест-клиент строку не выделяет (ни переходами, ни ПерейтиКСтроке -
		// 2026-11-25): отказ заполнения по ордеру без права закрыт тестом документов (РолиЗаказаПоставщику).
		Таблица = ФормаСписка.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Список", 5);
		ФормаСписка.Активизировать();
		ВстатьНаДокументСписка(Таблица, Данные.Номер);
		Кнопка = Неопределено;
		Для Каждого Кандидат Из ФормаСписка.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
			Если Кнопка = Неопределено И СтрЗаканчиваетсяНа(Кандидат.Имя, "ОтменаПроведения") Тогда
				Кнопка = Кандидат;
			КонецЕсли;
		КонецЦикла;
		Если Кнопка = Неопределено Тогда
			ВызватьИсключение "команды отмены проведения в списке ордеров нет";
		КонецЕсли;
		Кнопка.Нажать();
		Подождать(4000);
		ТекстОкна = ТекстИЗакрытиеОкнаОтказа();
		Проведен = ДокументПроведен(Данные.Ссылка);
		Если СтрНайти(ТекстОкна, "Violación") > 0 Или СтрНайти(ТекстОкна, "Нарушение прав") > 0
			Или СтрНайти(ТекстОкна, "imprevisto") > 0 Или СтрНайти(ТекстОкна, "непредвиденная") > 0 Тогда
			ЗаписатьОшибку(Метка, "отмена проведения", "окно ошибки платформы: " + ТекстОкна);
		ИначеЕсли Проведен И ПустаяСтрока(ТекстОкна) Тогда
			ЗаписатьОшибку(Метка, "отмена проведения", "ордер остался проведённым без объяснения; " + СостояниеКлиента());
		Иначе
			Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;отмена проведения ордера № %3 без ошибки прав: %4", Роль, Метка,
				Данные.Номер, ?(Проведен, "отказ «" + ТекстОкна + "»", "проведение отменено")));
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
	КонецЕсли;
КонецПроцедуры

// Встать в списке документов на строку с номером (поиск снизу: новые документы в конце списка).
&НаКлиенте
Процедура ВстатьНаДокументСписка(Таблица, Номер)
	Таблица.Активизировать();
	Таблица.ПерейтиКПоследнейСтроке();
	Для Шаг = 1 По 60 Цикл
		ТекстНомера = СокрЛП(Таблица.ПолучитьТекстЯчейки("Номер"));
		Если Не ПустаяСтрока(ТекстНомера) И СтрЗаканчиваетсяНа(Номер, ТекстНомера) Тогда
			// Переход по строкам двигает курсор, но не выделение: команда, читающая выделенные строки («Оформить»),
			// видит пустое выделение. Переход к строке по значению колонки выделяет её.
			Попытка
				ОписаниеСтроки = Новый Соответствие;
				ОписаниеСтроки.Вставить("Номер", ТекстНомера);
				Таблица.ПерейтиКСтроке(ОписаниеСтроки);
			Исключение
				Строки.Добавить("ПОДРОБНО;" + Роль + ";строка № " + Номер + " не выделена: "
					+ ОднойСтрокой(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
			Подождать(500);
			Возврат;
		КонецЕсли;
		Таблица.ПерейтиКПредыдущейСтроке();
	КонецЦикла;
	ВызватьИсключение "документ № " + Номер + " в последних 60 строках списка не найден";
КонецПроцедуры

// Возвращаемое значение:
//  Структура, Неопределено - Ссылка (ссылка на документ), Номер - проведённый приходный ордер, принятый по последнему
//  подходящему заказу поставщику механизмом рабочего места закупок (склад заказа должен быть ордерным).
&НаСервереБезКонтекста
Функция ПриходныйОрдерПоЗаказуПоставщику()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 20
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПоставщику КАК Т
		|ГДЕ
		|	Т.Проведен
		|УПОРЯДОЧИТЬ ПО
		|	Т.Дата УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Заказы = Новый Массив;
		Заказы.Добавить(Выборка.Ссылка);
		Попытка
			Итоги = Обработки.АРМЗакупки.ПринятьЗаказы(Заказы, Истина);
		Исключение
			Продолжить;
		КонецПопытки;
		Если Итоги.Количество() > 0 И Итоги[0].Успех И ТипЗнч(Итоги[0].Документ) = Тип("ДокументСсылка.ПриходныйОрдер")
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Итоги[0].Документ, "Проведен") Тогда
			Возврат Новый Структура("Ссылка, Номер, НавигационнаяСсылка", Итоги[0].Документ,
				СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Итоги[0].Документ, "Номер")),
				ПолучитьНавигационнуюСсылку(Итоги[0].Документ));
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервереБезКонтекста
Функция ДокументПроведен(Ссылка)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен") = Истина;
КонецФункции

// Сценарий «сортировка» (строка списка: «...;сортировка=шаги:таблица:колонка:кнопка по возрастанию:кнопка по убыванию»):
// встать в колонку таблицы, нажать сортировку по возрастанию и по убыванию - окна ошибки нет, а порядок текстов колонки
// после двух сортировок разный (строки действительно переставлены; тикет 2606363 - ошибка была в перестановке строк).
// В колонке должно быть хотя бы два разных значения, иначе сценарий - ошибка данных, а не «проверено».
&НаКлиенте
Процедура СценарийСортировкаТаблицы(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + "сортировка " + ?(Шаги.Количество() > 1, Шаги[1], "");
	Если Шаги.Количество() < 5 Тогда
		ЗаписатьОшибку(Метка, "сценарий", "нужно «шаги:таблица:колонка:кнопка по возрастанию:кнопка по убыванию»");
		Возврат;
	КонецЕсли;
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Таблица = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[1], 5);
		Порядки = Новый Массив;
		Для Номер = 3 По 4 Цикл
			Таблица.Активизировать();
			Таблица.ПерейтиКПервойСтроке();
			// Текущая колонка - та, по которой сортирует команда.
			ТестФорма.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , Шаги[2], 5).Активизировать();
			ТестФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , Шаги[Номер], 5).Нажать();
			Подождать(2500);
			Если ОшибкаКлиента(Метка, "команда " + Шаги[Номер]) Тогда
				Прервать;
			КонецЕсли;
			Порядки.Добавить(ТекстыКолонкиПоПорядку(Таблица, Шаги[2]));
		КонецЦикла;
		Если ОшибокВсего = ОшибокДо Тогда
			Разных = Новый Соответствие;
			Для Каждого Текст Из Порядки[0] Цикл
				Разных.Вставить(Текст, Истина);
			КонецЦикла;
			ПоВозрастанию = СтрСоединить(Порядки[0], " | ");
			ПоУбыванию = СтрСоединить(Порядки[1], " | ");
			Если Разных.Количество() < 2 Тогда
				ЗаписатьОшибку(Метка, "данные", "в колонке " + Шаги[2] + " меньше двух разных значений: " + ПоВозрастанию);
			ИначеЕсли ПоВозрастанию = ПоУбыванию Тогда
				ЗаписатьОшибку(Метка, "порядок", "порядок после двух сортировок одинаковый: " + ПоВозрастанию);
			ИначеЕсли Порядки[0].Количество() <> Порядки[1].Количество() Тогда
				ЗаписатьОшибку(Метка, "порядок", СтрШаблон("строк по возрастанию %1, по убыванию %2", Порядки[0].Количество(),
					Порядки[1].Количество()));
			Иначе
				Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;строки переставлены, колонка %3: по возрастанию «%4», по убыванию «%5»",
					Роль, Метка, Шаги[2], ПоВозрастанию, ПоУбыванию));
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
	КонецЕсли;
КонецПроцедуры

// Тексты колонки таблицы сверху вниз, не больше сорока строк.
&НаКлиенте
Функция ТекстыКолонкиПоПорядку(Таблица, ИмяКолонки)
	Тексты = Новый Массив;
	Таблица.Активизировать();
	Таблица.ПерейтиКПервойСтроке();
	Для Счетчик = 1 По 40 Цикл
		Тексты.Добавить(СокрЛП(Таблица.ПолучитьТекстЯчейки(ИмяКолонки)));
		Попытка
			Таблица.ПерейтиКСледующейСтроке();
		Исключение
			Прервать;
		КонецПопытки;
		Подождать(100);
	КонецЦикла;
	Возврат Тексты;
КонецФункции

// Сценарий «запись ордером» (строка списка: «...;ордер=» с теми же шестью частями, что у «запись=»): администратор
// теста включает ордерные склады (константа и признак у всех складов), пользователь под ролью вводит строку - в базе
// появляется проведённый приходный ордер. Данные базы меняются, склады остаются ордерными: сценарий идёт отдельным
// прогоном на своей свежей копии базы (tests/ui/role-scenarios-orders.txt, UITEST_ROLE_SCENARIOS).
&НаКлиенте
Процедура СценарийЗаписьОрдером(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + "запись ордером " + ?(Шаги.Количество() > 1, Шаги[1], "");
	ОрдеровДо = ВключитьОрдерныеСкладыИПосчитатьОрдера();
	ОрдераДо = ИдентификаторыПроведенныхПриходныхОрдеров();
	ОшибокДо = ОшибокВсего;
	СценарийЗаписьСтроки(Ссылка, ЧастьИмени, Шаги);
	Если ОшибокВсего <> ОшибокДо Тогда
		Возврат;
	КонецЕсли;
	ОрдеровПосле = ПроведенныхПриходныхОрдеров();
	Если ОрдеровПосле = ОрдеровДо + 1 Тогда
		Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;строка создала проведённый приходный ордер (было %3, стало %4)", Роль, Метка,
			Формат(ОрдеровДо, "ЧН=0; ЧГ="), Формат(ОрдеровПосле, "ЧН=0; ЧГ=")));
		ПроверитьСозданныйОрдер(Ссылка, ЧастьИмени, Шаги, Метка, ОрдераДо);
	Иначе
		ЗаписатьОшибку(Метка, "ордер", СтрШаблон("проведённых приходных ордеров было %1, стало %2 - ожидался один новый",
			Формат(ОрдеровДо, "ЧН=0; ЧГ="), Формат(ОрдеровПосле, "ЧН=0; ЧГ=")));
	КонецЕсли;
КонецПроцедуры

// Содержимое созданного ордера и строка после повторного открытия формы (повторная проверка ревью, P2): в ордере одна
// строка введённого товара с одной упаковкой; после закрытия и открытия рабочего места строка этого товара на месте.
&НаКлиенте
Процедура ПроверитьСозданныйОрдер(Ссылка, ЧастьИмени, Шаги, Метка, ОрдераДо)
	Товар = ТоварСЕдиницей();
	// Именно ордер, созданный сценарием: проведённый ордер, которого не было до ввода строки.
	Ордер = НовыйПроведенныйПриходныйОрдер(ОрдераДо);
	Если Ордер = Неопределено Или Ордер.Строк <> 1 Или Ордер.Товар <> Товар.Наименование Или Ордер.КоличествоУпаковок <> 1
		Или Ордер.Количество <= 0 Тогда
		ЗаписатьОшибку(Метка, "ордер", "в созданном ордере ожидалась одна строка товара «" + Товар.Наименование
			+ "» с одной упаковкой; получено: " + ?(Ордер = Неопределено, "ордера нет", СтрШаблон("строк %1, товар «%2», упаковок %3, "
			+ "количество %4", Ордер.Строк, Ордер.Товар, Ордер.КоличествоУпаковок, Ордер.Количество)));
		Возврат;
	КонецЕсли;
	Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;в ордере %3 одна строка: товар «%4», упаковок 1, количество %5", Роль, Метка,
		Ордер.Номер, Ордер.Товар, Ордер.Количество));
	Попытка
		Приложение.ПолучитьАктивноеОкно().Закрыть();
		Подождать(1500);
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма повторно не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Таблица = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[1], 5);
		Таблица.Активизировать();
		Таблица.ПерейтиКПервойСтроке();
		Найдена = Ложь;
		Просмотрено = 0;
		ВидныеДокументы = Новый Массив;
		Для Счетчик = 1 По 300 Цикл
			Просмотрено = Просмотрено + 1;
			// Строка созданного ордера, а не любая строка того же товара: сверяется и ячейка документа (седьмая часть
			// строки сценария - имя колонки документа).
			Если СокрЛП(Таблица.ПолучитьТекстЯчейки(Шаги[3])) = Товар.Наименование
				И СтрНачинаетсяС(СокрЛП(Таблица.ПолучитьТекстЯчейки(Шаги[4])), "1") Тогда
				ТекстДокумента = ?(Шаги.Количество() > 6, СокрЛП(Таблица.ПолучитьТекстЯчейки(Шаги[6])), Ордер.Представление);
				ВидныеДокументы.Добавить("«" + ТекстДокумента + "»");
				// Ячейка документа рабочего места: «№ <номер> от <дата> <поставщик> на <количество>».
				Если ТекстДокумента = Ордер.Представление Или СтрНачинаетсяС(ТекстДокумента, "№ " + Ордер.Номер + " ") Тогда
					Найдена = Истина;
					Прервать;
				КонецЕсли;
			КонецЕсли;
			Попытка
				Таблица.ПерейтиКСледующейСтроке();
			Исключение
				Прервать;
			КонецПопытки;
			Подождать(100);
		КонецЦикла;
		Если ОшибкаКлиента(Метка, "повторное открытие") Тогда
			Возврат;
		КонецЕсли;
		Если Найдена Тогда
			Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;после повторного открытия строка ордера «%4»: товар «%3», количество 1",
				Роль, Метка, Товар.Наименование, Ордер.Представление));
		Иначе
			ЗаписатьОшибку(Метка, "повторное открытие", СтрШаблон("строки ордера «%3» с товаром «%1» и количеством 1 нет, "
				+ "просмотрено строк: %2, документы строк этого товара: %4", Товар.Наименование, Просмотрено, Ордер.Представление,
				СтрСоединить(ВидныеДокументы, ", ")));
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "повторное открытие", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИдентификаторыПроведенныхПриходныхОрдеров()
	Запрос = Новый Запрос("ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриходныйОрдер КАК Т
		|ГДЕ
		|	Т.Проведен");
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Параметры:
//  ОрдераДо - Массив из Строка - идентификаторы ордеров, проведённых до сценария.
//
// Возвращаемое значение:
//  Структура, Неопределено - единственный проведённый ордер, которого не было в списке; иначе Неопределено.
&НаСервереБезКонтекста
Функция НовыйПроведенныйПриходныйОрдер(ОрдераДо)
	Запрос = Новый Запрос("ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Номер КАК Номер
		|ИЗ
		|	Документ.ПриходныйОрдер КАК Т
		|ГДЕ
		|	Т.Проведен");
	Новые = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ОрдераДо.Найти(Строка(Выборка.Ссылка.УникальныйИдентификатор())) = Неопределено Тогда
			Новые.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Если Новые.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Товары = Новые[0].ТЧТовары;
	Результат = Новый Структура("Номер, Представление, Строк, Товар, КоличествоУпаковок, Количество",
		СокрЛП(Новые[0].Номер), Строка(Новые[0]), Товары.Количество(), "", 0, 0);
	Если Товары.Количество() > 0 Тогда
		Результат.Товар = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Товары[0].Номенклатура, "Наименование");
		Результат.КоличествоУпаковок = Товары[0].КоличествоУпаковок;
		Результат.Количество = Товары[0].Количество;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ВключитьОрдерныеСкладыИПосчитатьОрдера()
	Константы.ИспользоватьОрдерныеСклады.Установить(Истина);
	Выборка = Справочники.МестаХранения.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ОрдерныйСклад И Не ЗначениеЗаполнено(Выборка.ДатаНачалаОрдернойСхемы) Тогда
			Продолжить;
		КонецЕсли;
		// Обычной записью, с проверками программы: склад станка, подчинённый склад и склад с проведёнными сегодня
		// документами ордерным не становится - такой пропускается (сценарий идёт на свежей копии базы).
		Попытка
			Склад = Выборка.ПолучитьОбъект();
			Склад.ОрдерныйСклад = Истина;
			Склад.ДатаНачалаОрдернойСхемы = НачалоДня(ТекущаяДата());
			Склад.Записать();
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	// Организация нового документа берётся из карточки пользователя: у пользователей прогона, созданных без неё,
	// ставится организация администратора теста или первая по коду (иначе строка честно отказывает «Организация не заполнена»).
	Организация = ПараметрыСеанса.Пользователь.Организация;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Организации КАК Т
			|ГДЕ
			|	НЕ Т.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Т.Код");
		ВыборкаОрганизаций = Запрос.Выполнить().Выбрать();
		Если ВыборкаОрганизаций.Следующий() Тогда
			Организация = ВыборкаОрганизаций.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Организация) Тогда
		Выборка = Справочники.Пользователи.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Организация) Тогда
				Пользователь = Выборка.ПолучитьОбъект();
				Пользователь.Организация = Организация;
				Пользователь.ОбменДанными.Загрузка = Истина;
				Пользователь.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ОбновитьПовторноИспользуемыеЗначения();
	Возврат ПроведенныхПриходныхОрдеров();
КонецФункции

&НаСервереБезКонтекста
Функция ПроведенныхПриходныхОрдеров()
	Запрос = Новый Запрос("ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Число
		|ИЗ
		|	Документ.ПриходныйОрдер КАК Т
		|ГДЕ
		|	Т.Проведен");
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Число, 0);
КонецФункции

// Нажать кнопку формы и дождаться формы, которую она открывает (ввод документа на основании строки): форма
// открыта без окна ошибки и закрывается без записи.
&НаКлиенте
Процедура НажатьИДождатьсяФормы(ТестФорма, Метка, ИмяКнопки, ЧастьИмениФормы)
	Кнопка = ТестФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , ИмяКнопки, 5);
	Если Кнопка = Неопределено Или Не Кнопка.ТекущаяВидимость() Тогда
		ЗаписатьОшибку(Метка, "кнопка", "кнопки " + ИмяКнопки + " нет или она скрыта");
		Возврат;
	КонецЕсли;
	Кнопка.Нажать();
	Открытая = НайтиФорму(ЧастьИмениФормы);
	Если ОшибкаКлиента(Метка, "кнопка " + ИмяКнопки) Тогда
		Возврат;
	КонецЕсли;
	Если Открытая = Неопределено Тогда
		ЗаписатьОшибку(Метка, "кнопка", "после кнопки " + ИмяКнопки + " форма " + ЧастьИмениФормы + " не открылась; "
			+ СостояниеКлиента());
		Возврат;
	КонецЕсли;
	Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;кнопка %3 открыла форму %4", Роль, Метка, ИмяКнопки, Открытая.ИмяФормы));
	Попытка
		Открытая.Активизировать();
		Приложение.ПолучитьАктивноеОкно().Закрыть();
	Исключение
		Строки.Добавить("ЗАМЕЧАНИЕ;" + Роль + ";" + Метка + ";форма после кнопки не закрыта");
	КонецПопытки;
	Подождать(700);
КонецПроцедуры

// Сценарий «без ввода» (строка списка: «...;безввода=шаги:таблица»): таблица только для просмотра - добавление
// строки тест-клиенту недоступно, как и пользователю.
&НаКлиенте
Процедура СценарийБезВвода(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + "без ввода " + ?(Шаги.Количество() > 1, Шаги[1], "");
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Таблица = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[1], 5);
		Если Не Таблица.ТекущаяВидимость() Тогда
			ВызватьИсключение "таблица " + Шаги[1] + " не видна";
		КонецЕсли;
		Таблица.Активизировать();
		Отказано = Ложь;
		Попытка
			Таблица.ДобавитьСтроку();
		Исключение
			Отказано = Истина;
			Строки.Добавить("ПОДРОБНО;" + Роль + ";" + Метка + ";добавление недоступно: "
				+ ОднойСтрокой(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
		Подождать(1500);
		Если Не Отказано Тогда
			// Таблица только для просмотра добавление молча не исполняет: строки в режиме ввода нет, и отмена ввода
			// отвечает исключением. Отмена прошла - строка была добавлена.
			Добавлена = Истина;
			Попытка
				Таблица.ЗакончитьРедактированиеСтроки(Истина);
			Исключение
				Добавлена = Ложь;
				Строки.Добавить("ПОДРОБНО;" + Роль + ";" + Метка + ";строка в режим ввода не вошла: "
					+ ОднойСтрокой(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
			Если Добавлена Тогда
				ЗаписатьОшибку(Метка, "ввод", "строка добавилась, а таблица должна быть только для просмотра");
			КонецЕсли;
		КонецЕсли;
		ОшибкаКлиента(Метка, "добавление строки");
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
		Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;таблица видна, добавление строки недоступно", Роль, Метка));
	КонецЕсли;
КонецПроцедуры

// Сценарий «отказ открытия» (строка списка: «...;отказ=часть текста сообщения»): форма пользователю не открывается,
// окна ошибки платформы нет, в сообщениях - названная причина. Под ролью такая форма из обхода исключается
// (scripts/uitest.sh): отказ - её ожидаемое поведение.
&НаКлиенте
Процедура СценарийОтказОткрытия(Ссылка, ЧастьИмени, ЧастьТекста)
	Метка = ЧастьИмени + "отказ открытия";
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		// Причина отказа - в окне отказа (форма отказывает исключением с текстом) или в сообщениях пользователю.
		// Окно отказа появляется не сразу: ждём его до 15 секунд.
		ТекстОкна = "";
		Для НомерОжидания = 1 По 5 Цикл
			Подождать(3000);
			ТекстОкна = ТекстИЗакрытиеОкнаОтказа();
			Если Не ПустаяСтрока(ТекстОкна) Или СтрНайти(СостояниеКлиента(), ЧастьТекста) > 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрНайти(ТекстОкна, ЧастьТекста) > 0 Тогда
			Строки.Добавить("ПОДРОБНО;" + Роль + ";" + Метка + ";окно отказа: " + ТекстОкна);
		ИначеЕсли Не ПустаяСтрока(ТекстОкна) Тогда
			ЗаписатьОшибку(Метка, "открытие", "окно отказа без причины «" + ЧастьТекста + "»: " + ТекстОкна);
		ИначеЕсли Не ОшибкаКлиента(Метка, "открытие") Тогда
			Открылась = Ложь;
			Для Каждого Кандидат Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
				Если СтрНайти(Кандидат.ИмяФормы, ЧастьИмени) = 1 Тогда
					Открылась = Истина;
				КонецЕсли;
			КонецЦикла;
			Состояние = СостояниеКлиента();
			Если Открылась Тогда
				ЗаписатьОшибку(Метка, "открытие", "форма открылась, а должна отказать");
			ИначеЕсли СтрНайти(Состояние, ЧастьТекста) = 0 Тогда
				ЗаписатьОшибку(Метка, "сообщение", "нет сообщения «" + ЧастьТекста + "»; " + Состояние);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
		Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;форма не открылась, сообщение «%3»", Роль, Метка, ЧастьТекста));
	КонецЕсли;
КонецПроцедуры

// Сценарий «печать поступления по заказу поставщику» (строка списка: «ссылка;часть имени;печатьпоступления=Часть1,Часть2»):
// пользователь без права на заказы поставщику открывает проведённое поступление, введённое по заказу поставщику, и
// печатает из формы каждую названную форму - окна ошибки нет, форма печати открылась. Поступление готовит сеанс
// тест-менеджера (администратор) на сервере.
&НаКлиенте
Процедура СценарийПечатьПоступленияПоЗаказу(ЧастиИменКоманд)
	Метка = "Документ.ПоступлениеТоваровУслуг.печать по заказу поставщику без права";
	ИмяФормыДокумента = "Документ.ПоступлениеТоваровУслуг.";
	ОшибокДо = ОшибокВсего;
	Попытка
		Данные = ПоступлениеПоЗаказуПоставщику();
		Если Данные = Неопределено Тогда
			ВызватьИсключение "в базе нет проведённого поступления по заказу поставщику и создать его не удалось";
		КонецЕсли;
		ГлавноеОкно.ВыполнитьКоманду(Данные.Ссылка);
		ТестФорма = Неопределено;
		Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30000;
		Пока ТестФорма = Неопределено И ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
			Для Каждого Кандидат Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
				Если СтрНайти(Кандидат.ИмяФормы, ИмяФормыДокумента) = 1 И СтрНайти(Кандидат.ИмяФормы, "ФормаСписка") = 0 Тогда
					ТестФорма = Кандидат;
				КонецЕсли;
			КонецЦикла;
			Подождать(500);
		КонецЦикла;
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма поступления не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		Если Не ОшибкаКлиента(Метка, "открытие документа") Тогда
			Для Каждого ЧастьИмени Из ЧастиИменКоманд Цикл
				ПечататьИзФормы(ТестФорма, Метка, СокрЛП(ЧастьИмени));
			КонецЦикла;
		КонецЕсли;
		ТестФорма.Активизировать();
		Приложение.ПолучитьАктивноеОкно().Закрыть();
		Подождать(1500);
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
	КонецЕсли;
КонецПроцедуры

// Сценарий «поступление по заказу поставщику без права» (строка списка: «ссылка списка поступлений;часть имени формы
// списка;основание=часть текста отказа»): пользователь без права на заказы поставщику открывает проведённое поступление,
// введённое по заказу поставщику, - форма только для просмотра; отмена проведения из списка отказывает с названной
// причиной, документ остаётся проведённым. Поступление готовит сеанс тест-менеджера (администратор) на сервере.
&НаКлиенте
Процедура СценарийПоступлениеПоЗаказуБезПрава(Ссылка, ЧастьИмени, ЧастьТекста)
	Метка = "Документ.ПоступлениеТоваровУслуг.по заказу поставщику без права";
	ИмяФормыДокумента = "Документ.ПоступлениеТоваровУслуг.";
	ОшибокДо = ОшибокВсего;
	Попытка
		Данные = ПоступлениеПоЗаказуПоставщику();
		Если Данные = Неопределено Тогда
			ВызватьИсключение "в базе нет проведённого поступления по заказу поставщику и создать его не удалось";
		КонецЕсли;
		ГлавноеОкно.ВыполнитьКоманду(Данные.Ссылка);
		ТестФорма = Неопределено;
		Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30000;
		Пока ТестФорма = Неопределено И ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
			Для Каждого Кандидат Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
				Если СтрНайти(Кандидат.ИмяФормы, ИмяФормыДокумента) = 1 И СтрНайти(Кандидат.ИмяФормы, "ФормаСписка") = 0 Тогда
					ТестФорма = Кандидат;
				КонецЕсли;
			КонецЦикла;
			Подождать(500);
		КонецЦикла;
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма поступления не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		Если Не ОшибкаКлиента(Метка, "открытие документа") Тогда
			Поле = ТестФорма.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Комментарий", 5);
			Если Поле = Неопределено Тогда
				ЗаписатьОшибку(Метка, "форма", "поля Комментарий в форме нет");
			ИначеЕсли ВводВПолеПроходит(Поле) Тогда
				ЗаписатьОшибку(Метка, "форма", "в поле Комментарий введён текст: форма не только для просмотра");
			Иначе
				Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;форма поступления № %3 открыта только для просмотра", Роль, Метка,
					Данные.Номер));
			КонецЕсли;
			ПечататьИзФормы(ТестФорма, Метка, "АктОбОказанииУслуг");
		КонецЕсли;
		ТестФорма.Активизировать();
		Приложение.ПолучитьАктивноеОкно().Закрыть();
		Подождать(1500);
		// Запись в обход формы: отмена проведения командой списка.
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ФормаСписка = НайтиФорму(ЧастьИмени);
		Если ФормаСписка = Неопределено Тогда
			ВызватьИсключение "список поступлений не открылся за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		Таблица = ФормаСписка.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Список", 5);
		Таблица.Активизировать();
		Таблица.ПерейтиКПоследнейСтроке();
		Найдена = Ложь;
		Для Шаг = 1 По 60 Цикл
			ТекстНомера = СокрЛП(Таблица.ПолучитьТекстЯчейки("Номер"));
			Если Не ПустаяСтрока(ТекстНомера) И СтрЗаканчиваетсяНа(Данные.Номер, ТекстНомера) Тогда
				Найдена = Истина;
				Прервать;
			КонецЕсли;
			Таблица.ПерейтиКПредыдущейСтроке();
		КонецЦикла;
		Если Не Найдена Тогда
			ВызватьИсключение "поступление № " + Данные.Номер + " в последних 60 строках списка не найдено";
		КонецЕсли;
		Кнопка = Неопределено;
		ИменаКнопок = Новый Массив;
		Для Каждого Кандидат Из ФормаСписка.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
			ИменаКнопок.Добавить(Кандидат.Имя);
			Если Кнопка = Неопределено И СтрЗаканчиваетсяНа(Кандидат.Имя, "ОтменаПроведения") Тогда
				Кнопка = Кандидат;
			КонецЕсли;
		КонецЦикла;
		Если Кнопка = Неопределено Тогда
			ВызватьИсключение "команды отмены проведения в списке нет; кнопки: " + СтрСоединить(ИменаКнопок, ",");
		КонецЕсли;
		Кнопка.Нажать();
		Подождать(3000);
		// Отказ записи из списка платформа показывает своим окном: его текст - вместе с сообщениями пользователю.
		Состояние = ТекстИЗакрытиеОкнаОтказа() + " | " + СостояниеКлиента();
		Если Не ПоступлениеПроведено(Данные.Ссылка) Тогда
			ЗаписатьОшибку(Метка, "отмена проведения", "проведение отменено, а должно было отказать; " + Состояние);
		ИначеЕсли СтрНайти(Состояние, ЧастьТекста) = 0 Тогда
			ЗаписатьОшибку(Метка, "отмена проведения", "нет сообщения «" + ЧастьТекста + "»; " + Состояние);
		Иначе
			Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;отмена проведения поступления № %3 из списка отказала: «%4»", Роль,
				Метка, Данные.Номер, ЧастьТекста));
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
	КонецЕсли;
КонецПроцедуры

// Возвращаемое значение:
//  Строка - тексты открытого окна платформы с отказом действия (ErrorWindow); окно закрывается его кнопкой.
&НаКлиенте
Функция ТекстИЗакрытиеОкнаОтказа()
	Тексты = Новый Массив;
	Для Каждого Открытая Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
		Если Открытая.ИмяФормы <> "ErrorWindow" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Подчиненный Из Открытая.НайтиОбъекты() Цикл
			Текст = "";
			Попытка
				Если ТипЗнч(Подчиненный) = Тип("ТестируемоеПолеФормы") Тогда
					Текст = Подчиненный.ПолучитьПредставлениеДанных();
				ИначеЕсли ТипЗнч(Подчиненный) = Тип("ТестируемаяДекорацияФормы") Тогда
					Текст = Подчиненный.ТекстЗаголовка;
				КонецЕсли;
			Исключение
				Текст = "";
			КонецПопытки;
			Если ЗначениеЗаполнено(Текст) Тогда
				Тексты.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
		Попытка
			Открытая.НайтиОбъект(Тип("ТестируемаяКнопкаФормы")).Нажать();
		Исключение
			Тексты.Добавить("(окно отказа не закрылось)");
		КонецПопытки;
	КонецЦикла;
	Возврат ОднойСтрокой(СтрСоединить(Тексты, " | "));
КонецФункции

// Параметры:
//  Поле - ТестируемоеПолеФормы - поле формы.
//
// Возвращаемое значение:
//  Булево - в поле удалось ввести текст; в форме только для просмотра тест-клиент ввод не выполняет (исключение).
&НаКлиенте
Функция ВводВПолеПроходит(Поле)
	Попытка
		Поле.Активизировать();
		Поле.ВвестиТекст("проба");
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

// Возвращаемое значение:
//  Структура, Неопределено - Ссылка (навигационная ссылка), Номер - проведённое поступление по заказу поставщику; если
//  такого нет, оно создаётся по последнему проведённому заказу поставщику механизмом рабочего места закупок.
&НаСервереБезКонтекста
Функция ПоступлениеПоЗаказуПоставщику()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК Т
		|ГДЕ
		|	Т.Основание ССЫЛКА Документ.ЗаказПоставщику
		|	И Т.Проведен
		|	И НЕ Т.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Т.Дата УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Документ = ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	Если Документ = Неопределено Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 10
			|	Т.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ЗаказПоставщику КАК Т
			|ГДЕ
			|	Т.Проведен
			|УПОРЯДОЧИТЬ ПО
			|	Т.Дата УБЫВ");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Документ = Неопределено И Выборка.Следующий() Цикл
			Заказы = Новый Массив;
			Заказы.Добавить(Выборка.Ссылка);
			Итоги = Обработки.АРМЗакупки.ПринятьЗаказы(Заказы);
			Принят = Итоги.Количество() > 0 И Итоги[0].Успех
				И ТипЗнч(Итоги[0].Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг");
			Если Принят И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Итоги[0].Документ, "Проведен") Тогда
				Документ = Итоги[0].Документ;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Документ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Ссылка, Номер", ПолучитьНавигационнуюСсылку(Документ),
		СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Номер")));
КонецФункции

// Параметры:
//  НавигационнаяСсылка - Строка - ссылка документа из ПоступлениеПоЗаказуПоставщику.
//
// Возвращаемое значение:
//  Булево - документ проведён.
&НаСервереБезКонтекста
Функция ПоступлениеПроведено(НавигационнаяСсылка)
	Запрос = Новый Запрос("ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК Т
		|ГДЕ
		|	Т.Проведен");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПолучитьНавигационнуюСсылку(Выборка.Ссылка) = НавигационнаяСсылка Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Сценарий «найти строку» (строка списка: «...;найти=шаги:таблица:колонка:текст[|текст]»): в таблице формы есть
// строка с каждым из названных текстов в колонке - так проверяется, что форма показывает пользователю нужные строки.
&НаКлиенте
Процедура СценарийНайтиСтроку(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + "строки " + ?(Шаги.Количество() > 1, Шаги[1], "");
	Если Шаги.Количество() < 4 Тогда
		ЗаписатьОшибку(Метка, "сценарий", "нужно «шаги:таблица:колонка:текст|текст»");
		Возврат;
	КонецЕсли;
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Таблица = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[1], 5);
		Таблица.Активизировать();
		// Тексты колонки собираются проходом по строкам: поиск строки по описанию требует заголовков колонок, а они
		// зависят от языка интерфейса.
		Тексты = Новый Соответствие;
		Таблица.ПерейтиКПервойСтроке();
		Прежний = Неопределено;
		Для Счетчик = 1 По 300 Цикл
			ТекстЯчейки = СокрЛП(Таблица.ПолучитьТекстЯчейки(Шаги[2]));
			Если ТекстЯчейки = Прежний Тогда
				// Тот же текст два раза подряд: курсор не сдвинулся - строки кончились (сценарий - для колонок без
				// одинаковых соседних значений).
				Прервать;
			КонецЕсли;
			Прежний = ТекстЯчейки;
			Тексты.Вставить(ТекстЯчейки, Истина);
			Попытка
				Таблица.ПерейтиКСледующейСтроке();
			Исключение
				Прервать;
			КонецПопытки;
			Подождать(100);
		КонецЦикла;
		Для Каждого Текст Из СтрРазделить(Шаги[3], "|", Ложь) Цикл
			Если Тексты.Получить(Текст) = Истина Тогда
				Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;есть строка «%3» (строк в таблице: %4)", Роль, Метка, Текст,
					Тексты.Количество()));
			Иначе
				Образцы = Новый Массив;
				Для Каждого КлючИЗначение Из Тексты Цикл
					Если Образцы.Количество() < 5 Тогда
						Образцы.Добавить("«" + КлючИЗначение.Ключ + "»");
					КонецЕсли;
				КонецЦикла;
				ЗаписатьОшибку(Метка, "строка", "строки «" + Текст + "» в колонке " + Шаги[2] + " нет; разных текстов: "
					+ Тексты.Количество() + ", например " + СтрСоединить(Образцы, ", "));
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
	КонецЕсли;
КонецПроцедуры

// Возвращаемое значение:
//  Строка, Неопределено - наименование контрагента, уникальное среди всех и без спецзнаков: его вводит тест-клиент.
&НаСервереБезКонтекста
Функция КлиентДляВвода()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Контрагенты КАК Т
		|ГДЕ
		|	НЕ Т.Наименование ПОДОБНО ""%#%""
		|СГРУППИРОВАТЬ ПО
		|	Т.Наименование
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(*) = 1
		|	И МАКСИМУМ(Т.ПометкаУдаления) = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Наименование, Неопределено);
КонецФункции

// Сценарий «удаление строки» (строка списка: «...;удаление=шаги:таблица:поле товара:кнопка удаления»): добавить
// строку с товаром, завершить её ввод, нажать кнопку удаления - строка исчезает, кнопка снова скрыта. Строка живёт
// только в форме, в базу ничего не записывается.
&НаКлиенте
Процедура СценарийУдалениеСтроки(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + "удаление строки " + Шаги[1];
	Товар = ТоварСЕдиницей();
	Если Товар = Неопределено Тогда
		ЗаписатьОшибку(Метка, "сценарий", "в базе нет товара с заполненной единицей");
		Возврат;
	КонецЕсли;
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Таблица = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[1], 5);
		Таблица.Активизировать();
		Таблица.ДобавитьСтроку();
		Подождать(1500);
		Если Не ОшибкаКлиента(Метка, "добавление строки") Тогда
			ВвестиВЯчейку(Таблица, Шаги[2], Товар.Наименование);
			ОшибкаКлиента(Метка, "выбор товара");
			Таблица.ЗакончитьРедактированиеСтроки(Ложь);
			Подождать(1000);
			ОшибкаКлиента(Метка, "завершение ввода строки");
			Если ПустаяСтрока(Таблица.ПолучитьТекстЯчейки(Шаги[2])) Тогда
				ЗаписатьОшибку(Метка, "ввод", "товар «" + Товар.Наименование + "» в строку не попал");
			КонецЕсли;
			Кнопка = ТестФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , Шаги[3], 5);
			Если Кнопка = Неопределено Или Не Кнопка.ТекущаяВидимость() Тогда
				ЗаписатьОшибку(Метка, "кнопка", "кнопка " + Шаги[3] + " не видна при выбранной строке");
			Иначе
				Кнопка.Нажать();
				Подождать(1000);
				ОшибкаКлиента(Метка, "команда " + Шаги[3]);
				ТекстПосле = "";
				Попытка
					ТекстПосле = Таблица.ПолучитьТекстЯчейки(Шаги[2]);
				Исключение
					// Строк не осталось - текущей ячейки нет.
					ТекстПосле = "";
				КонецПопытки;
				Если ТекстПосле = Товар.Наименование Тогда
					ЗаписатьОшибку(Метка, "удаление", "строка с товаром «" + ТекстПосле + "» осталась в таблице");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
		Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;строка с товаром «%3» добавлена и удалена кнопкой %4", Роль, Метка,
			Товар.Наименование, Шаги[3]));
	КонецЕсли;
КонецПроцедуры

// Сценарий «выделение стабильно» (строка списка: «...;стабильно=шаги:таблица:поле:нижняя таблица:поле нижней»):
// выделить все строки таблицы и несколько секунд читать ячейку текущей строки и первую ячейку нижней таблицы.
// Значения не должны меняться сами: форма, которая под несколькими выделенными строками по кругу перечитывает
// нижние таблицы, «моргает» и не даёт работать (замечание владельца 2026-11-22, «Потребность» закупок).
&НаКлиенте
Процедура СценарийВыделениеСтабильно(Ссылка, ЧастьИмени, Шаги)
	Метка = ЧастьИмени + "выделение стабильно " + Шаги[1];
	ОшибокДо = ОшибокВсего;
	Попытка
		ГлавноеОкно.ВыполнитьКоманду(Ссылка);
		ТестФорма = НайтиФорму(ЧастьИмени);
		Если ТестФорма = Неопределено Тогда
			ВызватьИсключение "форма не открылась за 30 секунд; " + СостояниеКлиента();
		КонецЕсли;
		ВыполнитьШаги(ТестФорма, Шаги[0]);
		Таблица = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[1], 5);
		Нижняя = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Шаги[3], 5);
		Таблица.Активизировать();
		Таблица.ПерейтиКПервойСтроке();
		Подождать(1500);
		Таблица.ВыделитьВсеСтроки();
		Подождать(2500);
		Снимки = Новый Соответствие;
		Порядок = Новый Массив;
		Для Номер = 1 По 12 Цикл
			// Ячейка проверяемой таблицы обязана читаться: ошибка чтения - провал сценария, а не «значение не менялось».
			// Нижняя таблица под выделением нескольких строк может не читаться - это допустимо.
			Снимок = Таблица.ПолучитьТекстЯчейки(Шаги[2]);
			Попытка
				Снимок = Снимок + " / " + Нижняя.ПолучитьТекстЯчейки(Шаги[4]);
			Исключение
				Снимок = Снимок + " / <" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ">";
			КонецПопытки;
			Если Снимки.Получить(Снимок) = Неопределено Тогда
				Снимки.Вставить(Снимок, Истина);
			КонецЕсли;
			Порядок.Добавить(Снимок);
			Подождать(400);
		КонецЦикла;
		Смен = 0;
		Для Номер = 1 По Порядок.ВГраница() Цикл
			Смен = Смен + ?(Порядок[Номер] <> Порядок[Номер - 1], 1, 0);
		КонецЦикла;
		Строки.Добавить("ПОДРОБНО;" + Роль + ";" + Метка + ";" + ОднойСтрокой(СтрСоединить(Порядок, " | ")));
		Если Смен > 0 Тогда
			ЗаписатьОшибку(Метка, "выделение", СтрШаблон("под выделенными строками форма перечитывается сама: %1 смен за 5 секунд (%2)",
				Смен, СтрСоединить(Порядок, " | ")));
		КонецЕсли;
		ОшибкаКлиента(Метка, "выделение всех строк");
	Исключение
		ЗаписатьОшибку(Метка, "сценарий", ОднойСтрокой(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ОшибокВсего = ОшибокДо Тогда
		ФормОбойдено = ФормОбойдено + 1;
		Строки.Добавить(СтрШаблон("ПРОВЕРЕНО;%1;%2;значения под выделением не менялись", Роль, Метка));
	КонецЕсли;
КонецПроцедуры

// Ввод текста в ячейку текущей строки. Сначала напрямую в поле колонки; если строка не в режиме ввода или
// курсор стоит на другой колонке (рабочие места вставляют строку сами) - начать изменение строки и дойти до
// колонки переходами, как пользователь клавишей Tab.
&НаКлиенте
Процедура ВвестиВЯчейку(Таблица, ИмяПоля, Текст)
	Попытка
		Поле = Таблица.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , ИмяПоля, 5);
		Поле.Активизировать();
		Поле.ВвестиТекст(Текст);
		Возврат;
	Исключение
		Строки.Добавить("ПОДРОБНО;" + Роль + ";" + ИмяПоля + ";прямой ввод не прошёл, иду переходами");
	КонецПопытки;
	Пройдено = Новый Массив;
	Для Заход = 1 По 4 Цикл
		// Режим ввода строки включается не с первого раза, если форма ещё исполняет свой обработчик ожидания.
		Попытка
			Таблица.ИзменитьСтроку();
		Исключение
			Пройдено.Добавить("(строка уже в режиме ввода)");
		КонецПопытки;
		Подождать(700);
		Прежнее = "";
		Для Счетчик = 1 По 30 Цикл
			Текущее = Таблица.ПолучитьТекущийЭлемент();
			ИмяТекущего = ?(Текущее = Неопределено, "", Текущее.Имя);
			Если ИмяТекущего = ИмяПоля Тогда
				Текущее.ВвестиТекст(Текст);
				Возврат;
			КонецЕсли;
			Если Счетчик > 1 И ИмяТекущего = Прежнее Тогда
				// Курсор не двигается: строка не в режиме ввода - новый заход.
				Прервать;
			КонецЕсли;
			Пройдено.Добавить(ИмяТекущего);
			Прежнее = ИмяТекущего;
			Таблица.ПерейтиКСледующемуЭлементу();
		КонецЦикла;
	КонецЦикла;
	ВызватьИсключение "до колонки " + ИмяПоля + " не дошёл; пройдено: " + СтрСоединить(Пройдено, ",");
КонецПроцедуры

// Нижние таблицы рабочих мест живут от текущей строки верхней: «Таблица#N» - встать на N-ю строку таблицы
// и дождаться, пока форма перечитает подчинённые таблицы (обработчик ожидания формы - доли секунды).
&НаКлиенте
Процедура ВстатьНаСтрокуВладельца(ТестФорма, Описание)
	Если СтрНайти(Описание, "?") > 0 Тогда
		// «Таблица?Колонка=Текст» - строка, в ячейке которой есть текст (двоеточия ячейки читаются как дефисы: время
		// «19:39:59» пишется «19-39-59»). Номер строки зависит от заказов, записанных прежними сценариями, и от того,
		// успел ли список перечитаться; текст - нет.
		Поиск = СтрРазделить(Сред(Описание, СтрНайти(Описание, "?") + 1), "=");
		Владелец = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Лев(Описание, СтрНайти(Описание, "?") - 1), 5);
		Владелец.Активизировать();
		Владелец.ПерейтиКПервойСтроке();
		Для Счетчик = 1 По 60 Цикл
			Если СтрНайти(СтрЗаменить(Владелец.ПолучитьТекстЯчейки(Поиск[0]), ":", "-"), Поиск[1]) > 0 Тогда
				Подождать(2000);
				Возврат;
			КонецЕсли;
			Попытка
				Владелец.ПерейтиКСледующейСтроке();
			Исключение
				Прервать;
			КонецПопытки;
		КонецЦикла;
		ВызватьИсключение "в таблице " + Описание + " строки с таким текстом нет";
	КонецЕсли;
	Части = СтрРазделить(Описание, "#");
	Владелец = ТестФорма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , Части[0], 5);
	Владелец.Активизировать();
	Владелец.ПерейтиКПервойСтроке();
	Если Части.Количество() > 1 Тогда
		Для Номер = 2 По Число(Части[1]) Цикл
			Владелец.ПерейтиКСледующейСтроке();
		КонецЦикла;
	КонецЕсли;
	Подождать(2000);
КонецПроцедуры

// Пауза с опросом тест-клиента: клиент за это время исполняет свои обработчики ожидания.
&НаКлиенте
Процедура Подождать(Миллисекунд)
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + Миллисекунд;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
		Приложение.НайтиОбъекты(Тип("ТестируемаяФорма"));
	КонецЦикла;
КонецПроцедуры

// Возвращаемое значение:
//  Структура, Неопределено - наименование товара с заполненной единицей; наименование уникально среди всех
//  элементов (включая помеченные на удаление) и без спецзнаков «грязных» данных: его вводит тест-клиент текстом.
&НаСервереБезКонтекста
Функция ТоварСЕдиницей()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Т
		|ГДЕ
		|	НЕ Т.ЭтоГруппа
		|	И Т.Единица <> ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|	И НЕ Т.Наименование ПОДОБНО ""%#%""
		|СГРУППИРОВАТЬ ПО
		|	Т.Наименование
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(*) = 1
		|	И МАКСИМУМ(Т.ПометкаУдаления) = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Наименование", Выборка.Наименование);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция НайтиФорму(ЧастьИмени)
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
		Для Каждого Кандидат Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
			Если СтрНайти(Кандидат.ИмяФормы, ЧастьИмени) = 1 Тогда
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Страницы обходятся проходами: каждый проход активизирует первую ещё не посещённую видимую страницу и ищет
// заново - активизация страницы показывает другие группы страниц (нижние закладки рабочих мест видны только на
// своей верхней закладке и при выбранной строке). Отчёт называет каждую страницу; отказ активизации не молчит.
&НаКлиенте
Процедура ОбойтиСтраницы(ТестФорма, ЧастьИмени, Страниц)
	Посещенные = Новый Соответствие;
	// Страницы, показавшиеся после активизации предыдущей (нижние закладки под выбранной строкой), идут первыми:
	// иначе обход уходит на следующую верхнюю закладку, и нижние снова скрываются.
	Очередь = Новый Массив;
	Пока Истина Цикл
		ВидимыеДо = ВидимыеНепосещенныеСтраницы(ТестФорма, Посещенные);
		Если ВидимыеДо.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Группа = Неопределено;
		Пока Очередь.Количество() > 0 И Группа = Неопределено Цикл
			Группа = ВидимыеДо.Получить(Очередь[0]);
			Очередь.Удалить(0);
		КонецЦикла;
		Если Группа = Неопределено Тогда
			Для Каждого КлючИЗначение Из ВидимыеДо Цикл
				Если КлючИЗначение.Значение.Первая Тогда
					Группа = КлючИЗначение.Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Посещенные.Вставить(Группа.Имя, Истина);
		Попытка
			Группа.Объект.Активизировать();
		Исключение
			Строки.Добавить("ПОДРОБНО;" + Роль + ";" + ЧастьИмени + ";страница " + Группа.Имя + " не активизирована: "
				+ ОднойСтрокой(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Продолжить;
		КонецПопытки;
		Страниц = Страниц + 1;
		Строки.Добавить("СТРАНИЦА;" + Роль + ";" + ЧастьИмени + ";" + Группа.Имя);
		Если ОшибкаКлиента(ЧастьИмени, "страница " + Группа.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ОбработатьВидимое(ТестФорма, ЧастьИмени);
		Для Каждого КлючИЗначение Из ВидимыеНепосещенныеСтраницы(ТестФорма, Посещенные) Цикл
			Если ВидимыеДо.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
				Очередь.Добавить(КлючИЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	// Страницы, до которых обход не дошёл, называются в отчёте: «Ошибок=0» не должно значить «не открывалось».
	Пропущены = Новый Массив;
	Для Каждого Группа Из ТестФорма.НайтиОбъекты(Тип("ТестируемаяГруппаФормы")) Цикл
		Если Группа.Вид = ВидГруппыФормы.Страница И Посещенные.Получить(Группа.Имя) = Неопределено Тогда
			Пропущены.Добавить(Группа.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Пропущены.Количество() > 0 Тогда
		Строки.Добавить("НЕПОСЕЩЕНО;" + Роль + ";" + ЧастьИмени + ";" + СтрСоединить(Пропущены, ","));
	КонецЕсли;
КонецПроцедуры

// Возвращаемое значение:
//  Соответствие - имя страницы -> Структура (Имя, Объект, Первая): видимые сейчас страницы, ещё не посещённые.
&НаКлиенте
Функция ВидимыеНепосещенныеСтраницы(ТестФорма, Посещенные)
	Результат = Новый Соответствие;
	Для Каждого Группа Из ТестФорма.НайтиОбъекты(Тип("ТестируемаяГруппаФормы")) Цикл
		Если Группа.Вид <> ВидГруппыФормы.Страница Или Посещенные.Получить(Группа.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Видима = Группа.ТекущаяВидимость();
		Исключение
			Видима = Ложь;
		КонецПопытки;
		Если Видима Тогда
			Результат.Вставить(Группа.Имя, Новый Структура("Имя, Объект, Первая", Группа.Имя, Группа, Результат.Количество() = 0));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ОбработатьВидимое(ТестФорма, ЧастьИмени)
	Для Каждого Таблица Из ТестФорма.НайтиОбъекты(Тип("ТестируемаяТаблицаФормы")) Цикл
		Если Тронутые.Получить(Таблица.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Если Не Таблица.ТекущаяВидимость() Тогда
				Продолжить;
			КонецЕсли;
			Таблица.Активизировать();
			Тронутые.Вставить(Таблица.Имя, Истина);
			Таблица.ПерейтиКПервойСтроке();
			Подождать(600);
		Исключение
			// Пустая таблица или таблица на неактивной странице: менеджер отказывает, клиент цел.
			Строки.Добавить("ПОДРОБНО;" + Роль + ";" + ЧастьИмени + ";таблица " + Таблица.Имя + " без перехода к строке");
		КонецПопытки;
		ОшибкаКлиента(ЧастьИмени, "активизация строки таблицы " + Таблица.Имя);
	КонецЦикла;
	Для Каждого Кнопка Из ТестФорма.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
		Имя = Кнопка.Имя;
		Если Нажатые.Получить(Имя) <> Неопределено Или Не КомандаБезопасна(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Если Не Кнопка.ТекущаяВидимость() Или Не Кнопка.ТекущаяДоступность() Тогда
				Продолжить;
			КонецЕсли;
			Кнопка.Нажать();
		Исключение
			Продолжить;
		КонецПопытки;
		Нажатые.Вставить(Имя, Истина);
		НажатоВсего = НажатоВсего + 1;
		Строки.Добавить("НАЖАТО;" + Роль + ";" + ЧастьИмени + ";" + Имя);
		ОшибкаКлиента(ЧастьИмени, "команда " + Имя);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция КомандаБезопасна(Имя)
	Возврат СтрНайти(Имя, "Сортировать") > 0 Или СтрЗаканчиваетсяНа(Имя, "Обновить");
КонецФункции

&НаКлиенте
Функция ОшибкаКлиента(ЧастьИмени, Действие)
	Информация = Приложение.ПолучитьТекущуюИнформациюОбОшибке();
	Если Информация = Неопределено Тогда
		// Ошибка получения данных (например, динамического списка) приходит не исключением, а окном платформы
		// «ErrorWindow»: без этой проверки обход считал форму с таким окном исправной (проба 2026-11-21).
		Возврат ОкноОшибкиПлатформы(ЧастьИмени, Действие);
	КонецЕсли;
	Текст = ОднойСтрокой(ПодробноеПредставлениеОшибки(Информация));
	Если Текст = ПоследняяОшибкаКлиента Тогда
		// Та же ошибка, что уже записана: клиент отдаёт её, пока окно не закрыто. Второй раз не считаем.
		ЗакрытьОкнаОшибок(ЧастьИмени);
		Возврат Ложь;
	КонецЕсли;
	ПоследняяОшибкаКлиента = Текст;
	ЗаписатьОшибку(ЧастьИмени, Действие, Текст);
	ЗакрытьОкнаОшибок(ЧастьИмени);
	Возврат Истина;
КонецФункции

// Что видит пользователь, когда ожидаемой формы нет: активное окно, его сообщения, открытые формы и тексты
// безымянных форм (окно предупреждения платформы, например «Недостаточно прав»).
&НаКлиенте
Функция СостояниеКлиента()
	Части = Новый Массив;
	Попытка
		Активное = Приложение.ПолучитьАктивноеОкно();
		Части.Добавить("активное окно: " + Активное.Заголовок);
		Для Каждого Текст Из Активное.ПолучитьТекстыСообщенийПользователю() Цикл
			Части.Добавить("сообщение: " + Текст);
		КонецЦикла;
	Исключение
		Части.Добавить("активное окно не получено");
	КонецПопытки;
	Попытка
		Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
			Части.Добавить("окно: «" + ОкноКлиента.Заголовок + "» основное=" + ОкноКлиента.Основное);
		КонецЦикла;
	Исключение
		Части.Добавить("список окон не получен");
	КонецПопытки;
	Попытка
		Для Каждого Открытая Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
			Части.Добавить("форма: " + Открытая.ИмяФормы + " «" + Открытая.ТекстЗаголовка + "»");
			Если ЗначениеЗаполнено(Открытая.ИмяФормы) Тогда
				Продолжить;
			КонецЕсли;
			Части.Добавить("окно без имени формы: " + Открытая.ТекстЗаголовка);
			Для Каждого Подчиненный Из Открытая.ПолучитьПодчиненныеОбъекты() Цикл
				Попытка
					Части.Добавить("текст: " + Подчиненный.ТекстЗаголовка);
				Исключение
					Продолжить;
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	Исключение
		Части.Добавить("список форм не получен");
	КонецПопытки;
	Возврат ОднойСтрокой(СтрСоединить(Части, " | "));
КонецФункции

// Окно ошибки времени выполнения закрывается кнопкой: закрытие активного окна его не убирало, и одна ошибка
// записывалась на каждый следующий шаг (прогон гейта 2026-11-21).
&НаКлиенте
Процедура ЗакрытьОкнаОшибок(ЧастьИмени)
	Попытка
		Для Каждого Открытая Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
			Если ЗначениеЗаполнено(Открытая.ИмяФормы) И Открытая.ИмяФормы <> "ErrorWindow" Тогда
				Продолжить;
			КонецЕсли;
			Кнопка = Открытая.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"));
			Если Кнопка <> Неопределено Тогда
				Кнопка.Нажать();
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("ЗАМЕЧАНИЕ;" + Роль + ";" + ЧастьИмени + ";окно ошибки не закрылось");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ОкноОшибкиПлатформы(ЧастьИмени, Действие)
	Найдено = Ложь;
	Для Каждого Открытая Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
		Если Открытая.ИмяФормы <> "ErrorWindow" Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Истина;
		Тексты = Новый Массив;
		// «Непредвиденная ошибка» прячет текст за ссылкой подробностей: раскрываем её до чтения полей.
		Для Каждого Подчиненный Из Открытая.НайтиОбъекты() Цикл
			Попытка
				Если Подчиненный.Имя = "AdditionalInfo" Тогда
					Подчиненный.Нажать();
					Подождать(1500);
				КонецЕсли;
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЦикла;
		Для Каждого Подчиненный Из Открытая.НайтиОбъекты() Цикл
			ТипЭлемента = ТипЗнч(Подчиненный);
			Текст = "";
			Попытка
				Если ТипЭлемента = Тип("ТестируемоеПолеФормы") Тогда
					Текст = Подчиненный.ПолучитьПредставлениеДанных();
				ИначеЕсли ТипЭлемента = Тип("ТестируемаяДекорацияФормы") Тогда
					Текст = Подчиненный.ТекстЗаголовка;
				Иначе
					Продолжить;
				КонецЕсли;
			Исключение
				Текст = "";
			КонецПопытки;
			Если ЗначениеЗаполнено(Текст) И Тексты.Найти(Текст) = Неопределено Тогда
				Тексты.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
		ЗаписатьОшибку(ЧастьИмени, Действие, "окно ошибки платформы: " + ОднойСтрокой(СтрСоединить(Тексты, " | ")));
		Попытка
			Открытая.НайтиОбъект(Тип("ТестируемаяКнопкаФормы")).Нажать();
		Исключение
			Попытка
				Приложение.ПолучитьАктивноеОкно().Закрыть();
			Исключение
				Строки.Добавить("ЗАМЕЧАНИЕ;" + Роль + ";" + ЧастьИмени + ";окно ошибки платформы не закрылось");
			КонецПопытки;
		КонецПопытки;
	КонецЦикла;
	Возврат Найдено;
КонецФункции

&НаКлиенте
Процедура ЗаписатьОшибку(ЧастьИмени, Действие, Текст)
	ОшибокВсего = ОшибокВсего + 1;
	Строки.Добавить("ОШИБКА;" + Роль + ";" + ЧастьИмени + ";" + Действие + ";" + Текст);
КонецПроцедуры

&НаКлиенте
Функция ОднойСтрокой(Текст)
	Возврат СтрЗаменить(СтрЗаменить(Текст, Символы.ПС, " | "), Символы.ВК, "");
КонецФункции
