#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Или ЭтотУзел Или ДополнительныеСвойства.Свойство("ЗаписьОбменом") Тогда
		Возврат;
	КонецЕсли;
	// Смена пользователя сервиса - блокировка всех узлов до блокировки своей строки (единственность назначения).
	ПрежнийПользователь = ?(ЭтоНовый(), "", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ИдПользователяСервиса"));
	ПользовательСервисаИзменен = Не ПустаяСтрока(ИдПользователяСервиса) И ПрежнийПользователь <> ИдПользователяСервиса;
	// Смена адреса партнёра стирает сохранённые логин и пароль: иначе их можно отправить на другой сервер.
	ПрежнийАдрес = ?(ЭтоНовый(), АдресСервиса, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "АдресСервиса"));
	ДополнительныеСвойства.Вставить("АдресСервисаИзменен", ПрежнийАдрес <> АдресСервиса);
	Если ПользовательСервисаИзменен Тогда
		ЗаблокироватьВсеУзлы();
	КонецЕсли;
	// Узел и проверки использованных соответствий - под исключительной блокировкой настроек узла (загрузчик держит
	// разделяемую от чтения соответствия до фиксации документа).
	Если Не ЭтоНовый() Тогда
		ОбменМеждуБазами.ЗаблокироватьНастройкиУзла(Ссылка, РежимБлокировкиДанных.Исключительный);
	КонецЕсли;
	Тексты = Новый Массив;
	ПроверитьНастройки(Тексты);
	ПроверитьНастройкиHTTP(Тексты);
	Если ПользовательСервисаИзменен Или ПрежнийПользователь <> ИдПользователяСервиса Тогда
		ПроверитьПравоНазначенияПользователяСервиса(Тексты);
	КонецЕсли;
	Если ПользовательСервисаИзменен Тогда
		ПроверитьПользователяСервиса(Тексты);
	КонецЕсли;
	Если Не ЭтоНовый() Тогда
		Прежний = Ссылка.ПолучитьОбъект();
		ПроверитьНазначение(Прежний, Тексты);
		ПроверитьВидыЦенПриема(Прежний, Тексты);
		Если ФильтрыИзменены(Прежний) Тогда
			ПоколениеФильтров = ПоколениеФильтров + 1;
		КонецЕсли;
	Иначе
		ПроверитьНазначение(Неопределено, Тексты);
		ПоколениеФильтров = 1;
	КонецЕсли;
	Для Каждого Текст Из Тексты Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
	КонецЦикла;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Или ЭтотУзел Тогда
		Возврат;
	КонецЕсли;
	// Диспетчер работает, пока есть хотя бы один включённый узел (в том числе после остановки узла обменом).
	ОбменМеждуБазами.ОбновитьИспользованиеДиспетчера();
	Если ДополнительныеСвойства.Свойство("АдресСервисаИзменен") И ДополнительныеСвойства.АдресСервисаИзменен Тогда
		// BSLLS:PrivilegedModuleMethodCall-off - стирание учётных данных, без раскрытия.
		ОбменМеждуБазамиПолныеПрава.ОчиститьУчетныеДанные(Ссылка);
		// BSLLS:PrivilegedModuleMethodCall-on
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаблокироватьВсеУзлы()
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("ПланОбмена.ОбменМеждуБазами");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьНастройкиHTTP(Тексты)
	Если ВидТранспорта <> Перечисления.ВидыТранспортаОбменаМеждуБазами.HTTP Тогда
		Возврат;
	КонецЕсли;
	Если Не ПустаяСтрока(АдресСервиса) И Не ОбменМеждуБазами.АдресЗащищенный(АдресСервиса) Тогда
		Тексты.Добавить(НСтр("ru = 'Адрес сервиса партнёра - только https://'; fr = 'Adresse du service du partenaire : https:// uniquement';
			|en = 'Partner service address: https:// only'; es = 'Dirección del servicio del socio: solo https://'"));
	КонецЕсли;
	Если Не ОбменВключен Тогда
		Возврат;
	КонецЕсли;
	// BSLLS:PrivilegedModuleMethodCall-off - только признак наличия ключа, без раскрытия.
	НетКлюча = ЭтоНовый() Или Не ОбменМеждуБазамиПолныеПрава.ЕстьКлючПодписи(Ссылка);
	// BSLLS:PrivilegedModuleMethodCall-on
	НеготовИнициатор = ИнициаторHTTP И ПустаяСтрока(АдресСервиса);
	НеготовОтвечающий = Не ИнициаторHTTP И ПустаяСтрока(ИдПользователяСервиса);
	Если НетКлюча Или НеготовИнициатор Или НеготовОтвечающий Тогда
		Тексты.Добавить(НСтр("ru = 'Узел HTTP включается с ключом подписи и адресом партнёра (инициатор) или пользователем сервиса этой базы';
			|fr = 'Un nœud HTTP s''active avec la clé de signature et l''adresse du partenaire (initiateur) ou l''utilisateur du service de cette base';
			|en = 'An HTTP node is enabled with the signing key and the partner address (initiator) or the service user of this base';
			|es = 'Un nodo HTTP se activa con la clave de firma y la dirección del socio (iniciador) o el usuario del servicio de esta base'"));
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПравоНазначенияПользователяСервиса(Тексты)
	// Пользователь сервиса получает доступ к обмену узла от имени партнёра - назначает только администратор.
	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		Тексты.Добавить(НСтр("ru = 'Пользователя сервиса назначает администратор';
			|fr = 'L''utilisateur du service est affecté par l''administrateur';
			|en = 'The service user is assigned by the administrator'; es = 'El usuario del servicio lo asigna el administrador'"));
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПользователяСервиса(Тексты)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Узлы.Наименование КАК Наименование
	|ИЗ
	|	ПланОбмена.ОбменМеждуБазами КАК Узлы
	|ГДЕ
	|	Узлы.ИдПользователяСервиса = &Ид
	|	И Узлы.Ссылка <> &Ссылка
	|	И НЕ Узлы.ПометкаУдаления");
	Запрос.УстановитьПараметр("Ид", ИдПользователяСервиса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Шаблон = НСтр("ru = 'Пользователь сервиса уже назначен узлу «%1»: у каждого узла свой пользователь';
			|fr = 'L''utilisateur du service est déjà affecté au nœud « %1 » : chaque nœud a le sien';
			|en = 'The service user is already assigned to node ""%1"": each node has its own user';
			|es = 'El usuario del servicio ya está asignado al nodo «%1»: cada nodo tiene el suyo'");
		Тексты.Добавить(СтрШаблон(Шаблон, Выборка.Наименование));
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьНастройки(Тексты)
	Если Не ЗначениеЗаполнено(ДатаНачалаОбмена) Тогда
		Тексты.Добавить(НСтр("ru = 'Укажите дату начала обмена: документы раньше неё не отправляются';
			|fr = 'Indiquez la date de début : les documents antérieurs ne sont pas envoyés';
			|en = 'Specify the exchange start date: earlier documents are not sent';
			|es = 'Indique la fecha de inicio: los documentos anteriores no se envían'"));
	КонецЕсли;
	НужныСтороны = ВыгружатьРеализации Или ПриниматьРеализации;
	Если НужныСтороны И (Не ЗначениеЗаполнено(Контрагент) Или Не ЗначениеЗаполнено(Организация)) Тогда
		Тексты.Добавить(НСтр("ru = 'Укажите контрагента и организацию узла'; fr = 'Indiquez le tiers et la société du nœud';
			|en = 'Specify the node counterparty and company'; es = 'Indique la contraparte y la empresa del nodo'"));
	КонецЕсли;
	Если ПриниматьРеализации И Не ЗначениеЗаполнено(МестоХранения) Тогда
		Тексты.Добавить(НСтр("ru = 'Укажите склад приёма поступлений'; fr = 'Indiquez l''entrepôt de réception';
			|en = 'Specify the receiving warehouse'; es = 'Indique el almacén de recepción'"));
	КонецЕсли;
	Если ПриниматьЦены И ВидыЦенПриема.Количество() = 0 Тогда
		Тексты.Добавить(НСтр("ru = 'Для приёма цен заполните соответствия видов цен';
			|fr = 'Pour recevoir les prix, renseignez les correspondances des types de prix';
			|en = 'To receive prices, fill in the price type mappings';
			|es = 'Para recibir precios, complete las correspondencias de tipos de precio'"));
	КонецЕсли;
	ЧерезКаталог = ВидТранспорта = Перечисления.ВидыТранспортаОбменаМеждуБазами.Каталог;
	// BSLLS:PrivilegedModuleMethodCall-off - только признак наличия ключа, без раскрытия.
	НетКлюча = ЭтоНовый() Или Не ОбменМеждуБазамиПолныеПрава.ЕстьКлючПодписи(Ссылка);
	// BSLLS:PrivilegedModuleMethodCall-on
	НеготовКаталог = ПустаяСтрока(КаталогОбмена) Или НетКлюча;
	Если ОбменВключен И ЧерезКаталог И НеготовКаталог Тогда
		Тексты.Добавить(НСтр("ru = 'Узел с обменом через каталог включается только с каталогом и ключом подписи';
			|fr = 'Un nœud par dossier ne s''active qu''avec un dossier et une clé de signature';
			|en = 'A folder exchange node is enabled only with a folder and a signing key';
			|es = 'Un nodo por carpeta solo se activa con carpeta y clave de firma'"));
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьНазначение(Прежний, Тексты)
	// Кладовщик приёмки в узле - тем же полномочием, что в поступлении (2.0.17.16).
	ПрежнийОтветственный = ?(Прежний = Неопределено, Справочники.Пользователи.ПустаяСсылка(),
		Прежний.ОтветственныйЗаПриемку);
	Если ОтветственныйЗаПриемку = ПрежнийОтветственный Тогда
		Возврат;
	КонецЕсли;
	Если Не Обработки.МобильнаяПриемка.ПравоНазначенияКладовщика(ПравоДоступа("Администрирование", Метаданные),
		ПравоДоступа("Добавление", Метаданные.Документы.ПриходныйОрдер)) Тогда
		Тексты.Добавить(НСтр("ru = 'Назначает кладовщика приёмки менеджер без права на приходные ордера или администратор';
			|fr = 'Le magasinier de réception est affecté par un responsable sans droit sur les bons d''entrée ou par l''administrateur';
			|en = 'The receiving clerk is assigned by a manager without receipt order rights or by an administrator';
			|es = 'Asigna el almacenero de recepción un responsable sin derecho a órdenes de entrada o el administrador'"));
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьВидыЦенПриема(Прежний, Тексты)
	// Строку соответствия видов цен, по которой уже загружены установки цен, изменить или удалить нельзя.
	Для Каждого ПрежняяСтрока Из Прежний.ВидыЦенПриема Цикл
		ТекущаяСтрока = ВидыЦенПриема.Найти(ПрежняяСтрока.ИдВидаЦеныПартнера, "ИдВидаЦеныПартнера");
		Если ТекущаяСтрока <> Неопределено И ТекущаяСтрока.ВидЦены = ПрежняяСтрока.ВидЦены Тогда
			Продолжить;
		КонецЕсли;
		Если ОбменМеждуБазами.ВидЦеныПартнераИспользован(Ссылка, ПрежняяСтрока.ИдВидаЦеныПартнера) Тогда
			Текст = СтрШаблон(НСтр("ru = 'По виду цены партнёра «%1» уже загружены установки цен - соответствие не меняется';
				|fr = 'Des prix ont déjà été reçus pour le type « %1 » du partenaire - la correspondance ne change pas';
				|en = 'Price settings were already received for partner price type ""%1"" - the mapping cannot change';
				|es = 'Ya se recibieron precios para el tipo «%1» del socio: la correspondencia no cambia'"),
				ПрежняяСтрока.НаименованиеУПартнера);
			Тексты.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ФильтрыИзменены(Прежний)
	Для Каждого Поле Из СтрРазделить("Контрагент,Организация,ВыгружатьРеализации,ВыгружатьЦены,ДатаНачалаОбмена", ",") Цикл
		Если ЭтотОбъект[Поле] <> Прежний[Поле] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Прежние = Прежний.ВидыЦенВыгрузки.ВыгрузитьКолонку("ВидЦены");
	Текущие = ВидыЦенВыгрузки.ВыгрузитьКолонку("ВидЦены");
	Если Прежние.Количество() <> Текущие.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого ВидЦены Из Текущие Цикл
		Если Прежние.Найти(ВидЦены) = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

#КонецОбласти
