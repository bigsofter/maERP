#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.Ссылка = ПланыОбмена.ОбменМеждуБазами.ЭтотУзел() Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;
	КодЭтойБазы = ОбменМеждуБазамиВызовСервера.КодЭтойБазы();
	ОбновитьСостояниеКлюча();
	ПользовательСервиса = ОбменМеждуБазамиВызовСервера.ИмяПользователяСервиса(Объект.ИдПользователяСервиса);
	Если Не Объект.Ссылка.Пустая() Тогда
		ЛогинПартнера = ОбменМеждуБазамиВызовСервера.ПользовательПартнера(Объект.Ссылка);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбмен(Команда)
	Если Не ПроверитьЗаписанность() Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение( , ВыполнитьОбменНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКлючПодписи(Команда)
	Если Не ПроверитьЗаписанность() Тогда
		Возврат;
	КонецЕсли;
	Ключ = СоздатьКлючНаСервере();
	ПоказатьВводСтроки( , Ключ, НСтр("ru = 'Ключ подписи: скопируйте и передайте партнёру (показывается один раз)';
		|fr = 'Clé de signature : copiez-la et transmettez-la au partenaire (affichée une seule fois)';
		|en = 'Signing key: copy it and send it to the partner (shown once)';
		|es = 'Clave de firma: cópiela y envíela al socio (se muestra una vez)'"));
КонецПроцедуры

&НаКлиенте
Процедура ВвестиКлючПодписи(Команда)
	Если Не ПроверитьЗаписанность() Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВводаКлюча", ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение, "", НСтр("ru = 'Ключ подписи от партнёра'; fr = 'Clé de signature du partenaire';
		|en = 'Signing key from the partner'; es = 'Clave de firma del socio'"));
КонецПроцедуры

&НаКлиенте
Процедура ПовторитьОтложенные(Команда)
	Если Не ПроверитьЗаписанность() Тогда
		Возврат;
	КонецЕсли;
	Применено = ПовторитьНаСервере();
	Текст = СтрШаблон(НСтр("ru = 'Применено объектов: %1'; fr = 'Objets appliqués : %1';
		|en = 'Objects applied: %1'; es = 'Objetos aplicados: %1'"), Применено);
	ПоказатьПредупреждение( , Текст);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	Если Не ПроверитьЗаписанность() Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение( , ПроверитьПодключениеНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПользователяСервиса(Команда)
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПользователяСервиса", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оповещение, ПользователиСервиса());
КонецПроцедуры

&НаКлиенте
Процедура СохранитьУчетныеДанные(Команда)
	Если Не ПроверитьЗаписанность() Тогда
		Возврат;
	КонецЕсли;
	СохранитьУчетныеДанныеНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Логин и пароль партнёра сохранены';
		|fr = 'Identifiant et mot de passe du partenaire enregistrés';
		|en = 'Partner login and password saved'; es = 'Usuario y contraseña del socio guardados'"));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеВыбораПользователяСервиса(Выбранный, ДополнительныеПараметры) Экспорт
	Если Выбранный = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.ИдПользователяСервиса = Выбранный.Значение;
	ПользовательСервиса = Выбранный.Представление;
	Модифицированность = Истина;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПользователиСервиса()
	Возврат ОбменМеждуБазамиВызовСервера.ПользователиСервиса();
КонецФункции

&НаСервере
Функция ПроверитьПодключениеНаСервере()
	Возврат ОбменМеждуБазамиВызовСервера.ПроверитьПодключение(Объект.Ссылка);
КонецФункции

&НаСервере
Процедура СохранитьУчетныеДанныеНаСервере()
	// Пароль на форме не остаётся: после сохранения поле очищается.
	ОбменМеждуБазамиВызовСервера.УстановитьУчетныеДанные(Объект.Ссылка, ЛогинПартнера, ПарольПартнера);
	ПарольПартнера = "";
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКлюча(Ключ, ДополнительныеПараметры) Экспорт
	Если Ключ = Неопределено Или ПустаяСтрока(Ключ) Тогда
		Возврат;
	КонецЕсли;
	УстановитьКлючНаСервере(Ключ);
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаписанность()
	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Сначала запишите узел'; fr = 'Enregistrez d''abord le nœud';
			|en = 'Save the node first'; es = 'Primero guarde el nodo'"));
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаСервере
Функция ВыполнитьОбменНаСервере()
	Возврат ОбменМеждуБазамиВызовСервера.ВыполнитьОбменУзла(Объект.Ссылка);
КонецФункции

&НаСервере
Функция СоздатьКлючНаСервере()
	Ключ = ОбменМеждуБазамиВызовСервера.СоздатьКлючПодписи(Объект.Ссылка);
	ОбновитьСостояниеКлюча();
	Возврат Ключ;
КонецФункции

&НаСервере
Процедура УстановитьКлючНаСервере(Знач Ключ)
	ОбменМеждуБазамиВызовСервера.УстановитьКлючПодписи(Объект.Ссылка, Ключ);
	ОбновитьСостояниеКлюча();
КонецПроцедуры

&НаСервере
Функция ПовторитьНаСервере()
	Возврат ОбменМеждуБазамиВызовСервера.ПовторитьОтложенные(Объект.Ссылка);
КонецФункции

&НаСервере
Процедура ОбновитьСостояниеКлюча()
	Если Объект.Ссылка.Пустая() Тогда
		СостояниеКлюча = НСтр("ru = 'запишите узел'; fr = 'enregistrez le nœud'; en = 'save the node'; es = 'guarde el nodo'");
	ИначеЕсли ОбменМеждуБазамиВызовСервера.ЕстьКлючПодписи(Объект.Ссылка) Тогда
		СостояниеКлюча = НСтр("ru = 'задан'; fr = 'défini'; en = 'set'; es = 'definida'");
	Иначе
		СостояниеКлюча = НСтр("ru = 'не задан'; fr = 'non défini'; en = 'not set'; es = 'no definida'");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
