    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Журнал.Ссылка КАК Ссылка,
	Журнал.Дата КАК Дата,
	Журнал.ПометкаУдаления КАК ПометкаУдаления,
	Журнал.Номер КАК Номер,
	Журнал.Проведен КАК Проведен,
	Журнал.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	Журнал.ДатаПроведенияБанком КАК ДатаПроведенияБанком,
	Журнал.Контрагент КАК Контрагент,
	Журнал.НазначениеПлатежа КАК НазначениеПлатежа,
	Журнал.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	Журнал.Организация КАК Организация,
	Журнал.Поступление КАК Поступление,
	Журнал.БанковскийСчёт КАК БанковскийСчёт,
	Журнал.Списание КАК Списание,
	Журнал.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	Журнал.ПроведеноБанком КАК ПроведеноБанком
ИЗ
	ЖурналДокументов.БезналичныеПлатежи КАК Журнал
ГДЕ
	ВЫБОР
			КОГДА &amp;Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
				ТОГДА ИСТИНА
			ИНАЧЕ Журнал.Организация = &amp;Организация
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;БанковскийСчёт = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
				ТОГДА ИСТИНА
			ИНАЧЕ Журнал.БанковскийСчёт = &amp;БанковскийСчёт
		КОНЕЦ</queryText>
      <mainTable>DocumentJournal.БезналичныеПлатежи</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
