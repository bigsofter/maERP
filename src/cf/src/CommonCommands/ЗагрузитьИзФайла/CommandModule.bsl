#Область ОбработчикиСобытий

// Загрузка строк из файла в записанный документ (docs/plans/excel-import-universal.md, раздел 4). Из формы объекта
// с несохранёнными изменениями загрузка не начинается: после неё форма загрузки перечитывает форму-владельца из базы.
// Форма загрузки блокирует окно владельца (свойство формы «Режим открытия окна»).
//
// Параметры:
//  ПараметрКоманды            - ДокументСсылка, Массив - документ (из списка - первый выделенный).
//  ПараметрыВыполненияКоманды - ПараметрыВыполненияКоманды - Источник - форма, из которой вызвана команда.
//
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	Документ = ?(ТипЗнч(ПараметрКоманды) = Тип("Массив"), ПараметрКоманды[0], ПараметрКоманды);
	Источник = ПараметрыВыполненияКоманды.Источник;
	Если Не ЗначениеЗаполнено(Документ) Или ЕстьНесохраненныеИзменения(Источник) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Запишите документ перед загрузкой из файла';
			|fr = 'Enregistrez le document avant le chargement depuis un fichier';
			|en = 'Save the document before importing from a file';
			|es = 'Guarde el documento antes de cargar desde un archivo'"));
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Обработка.ЗагрузкаИзФайла.Форма.Форма", Новый Структура("Документ", Документ), Источник);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Форма объекта с несохранёнными изменениями (у формы списка их нет).
//
// Параметры:
//  Источник - ФормаКлиентскогоПриложения, Неопределено - форма, из которой вызвана команда.
//
// Возвращаемое значение:
//  Булево - Истина: есть несохранённые изменения.
//
&НаКлиенте
Функция ЕстьНесохраненныеИзменения(Источник)
	Если Источник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Источник.Модифицированность;
КонецФункции

#КонецОбласти
