#Область ОбработчикиСобытий

// Присоединённые файлы документа (docs/plans/document-files.md): список регистра ПрисоединённыеФайлы с отбором по
// документу - добавить, открыть, сохранить на диск, удалить. Файлы прикрепляются к записанному документу.
//
// Параметры:
//  ПараметрКоманды            - ДокументСсылка, Массив - документ (из списка - первый выделенный).
//  ПараметрыВыполненияКоманды - ПараметрыВыполненияКоманды - Источник - форма, из которой вызвана команда.
//
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	Документ = ?(ТипЗнч(ПараметрКоманды) = Тип("Массив"), ПараметрКоманды[0], ПараметрКоманды);
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Запишите документ, чтобы присоединить файлы';
			|fr = 'Enregistrez le document pour joindre des fichiers';
			|en = 'Save the document to attach files';
			|es = 'Guarde el documento para adjuntar archivos'"));
		Возврат;
	КонецЕсли;
	// BSLLS:YoLetterUsage-off - имя общего модуля в метаданных.
	// BSLLS:PrivilegedModuleMethodCall-off - проверка права по ролям пользователя, без чтения данных.
	ДоступенПросмотр = ПрисоединённыеФайлыВызовСервера.ДоступенПросмотрФайлов();
	// BSLLS:PrivilegedModuleMethodCall-on
	// BSLLS:YoLetterUsage-on
	Если Не ДоступенПросмотр Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Недостаточно прав для просмотра присоединённых файлов';
			|fr = 'Droits insuffisants pour consulter les fichiers joints';
			|en = 'Insufficient rights to view attached files';
			|es = 'Derechos insuficientes para ver los archivos adjuntos'"));
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура("Объект", Документ);
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	ОткрытьФорму("РегистрСведений.ПрисоединённыеФайлы.ФормаСписка", ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник, Документ);
КонецПроцедуры

#КонецОбласти
