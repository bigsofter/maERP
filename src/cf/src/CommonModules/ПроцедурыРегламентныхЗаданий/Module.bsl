#Область Внутренние 
 
// Регламентное задание «Перепроведение документов» - диспетчер пересчета последовательности Основная: запускает
// рабочий метод ПересчитатьПоследовательность фоновым заданием с тем же ключом, что и обработка «Перепроведение
// документов», - второй одновременный пересчет платформа не запустит (план warehouse-orders-cost, Ф1.3 п. 6). Выход
// сразу, если граница не раньше последнего документа и отметок замороженной стоимости нет.
//
Процедура ПерепроведениеДокументов() Экспорт
	Если ОбновлениеНеЗавершено() Тогда
		Возврат;
	КонецЕсли;
	Если РаботаСДокументами.АктуальностьСебестоимости().Актуальна Тогда
		Возврат;
	КонецЕсли;
	ЗапуститьПересчетПоследовательности();
КонецПроцедуры

// Запускает пересчет последовательности фоновым заданием с общим ключом.
//
// Параметры:
//  НачалоПериода - Дата, Неопределено - пересчитать и документы с этой даты, если она раньше дня границы
//  КонецПериода  - Дата, Неопределено - последний день пересчета; Неопределено - до последнего документа
//
// Возвращаемое значение:
//  ФоновоеЗадание, Неопределено - запущенное задание; Неопределено - пересчет уже выполняется
//
Функция ЗапуститьПересчетПоследовательности(НачалоПериода = Неопределено, КонецПериода = Неопределено) Экспорт
	Ключ = КлючПересчетаПоследовательности();
	Отбор = Новый Структура("Ключ, Состояние", Ключ, СостояниеФоновогоЗадания.Активно);
	Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(НачалоПериода);
	Параметры.Добавить(КонецПериода);
	Наименование = НСтр("ru = 'Пересчет последовательности'; fr = 'Recalcul de la séquence'; en = 'Sequence recalculation';
		|es = 'Recálculo de la secuencia'");
	Попытка
		Возврат ФоновыеЗадания.Выполнить("ПроцедурыРегламентныхЗаданий.ПересчитатьПоследовательность", Параметры, Ключ,
			Наименование);
	Исключение
		// Задание с тем же ключом запущено между проверкой и запуском - второй пересчет не нужен.
		ЗаписьЖурналаРегистрации(ИмяСобытияПересчета(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Ключ фонового задания пересчета последовательности: общий у регламентного запуска и обработки.
//
// Возвращаемое значение:
//  Строка - ключ
//
Функция КлючПересчетаПоследовательности() Экспорт
	Возврат "ПересчетПоследовательностиОсновная";
КонецФункции

// Пересчет последовательности Основная от ее границы - рабочий метод фонового задания. Шаг: выбор следующего
// проведенного документа строго после границы, перепроведение в режиме пересчета стоимости и сдвиг границы на него
// в одной транзакции; остановка на первой ошибке (план warehouse-orders-cost, Ф1.3). Сообщения «всего;пройдено;дата»
// читает форма обработки «Перепроведение документов».
//
// Параметры:
//  НачалоПериода - Дата, Неопределено - пересчитать и документы с этой даты, если она раньше дня границы
//  КонецПериода  - Дата, Неопределено - последний день пересчета; Неопределено - до последнего документа
//
Процедура ПересчитатьПоследовательность(Знач НачалоПериода = Неопределено, Знач КонецПериода = Неопределено) Экспорт
	Если ОбновлениеНеЗавершено() Тогда
		Возврат;
	КонецЕсли;
	РегистрыСведений.НепроведенныеДокументы.ОчиститьОшибки();
	ПроверитьОтметкиЗаморозки();
	ДеньГраницы = НачалоДня(Последовательности.Основная.ПолучитьГраницу().Дата);
	Если ЗначениеЗаполнено(НачалоПериода) И НачалоДня(НачалоПериода) < ДеньГраницы Тогда
		НоваяГраница = РаботаСДокументами.МоментДоДаты(НачалоДня(НачалоПериода));
		РаботаСДокументами.СдвинутьГраницуПоследовательностиНазад(НоваяГраница);
	КонецЕсли;
	Окончание = ?(ЗначениеЗаполнено(КонецПериода), КонецДня(КонецПериода), КонецДня(Дата(3999, 12, 31)));
	Позиция = Последовательности.Основная.ПолучитьГраницу();
	Всего = ДокументовПослеПозиции(Позиция, Окончание);
	Пройдено = 0;
	Пока Истина Цикл
		Шаг = ВыполнитьШагПересчета(Позиция, Окончание);
		Если Шаг.Вид <> "Готово" Тогда
			Если Шаг.Вид <> "Конец" Тогда
				ЗаписатьОстановкуПересчета(Шаг);
			КонецЕсли;
			Прервать;
		КонецЕсли;
		Позиция = Шаг.Момент;
		Пройдено = Пройдено + 1;
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = Формат(Макс(Всего, Пройдено), "ЧГ=0") + ";" + Формат(Пройдено, "ЧГ=0") + ";"
			+ Строка(Шаг.Момент.Дата);
		Сообщение.Сообщить();
	КонецЦикла;
КонецПроцедуры

// Один шаг пересчета с повтором выбора: документ, исчезнувший, распроведенный или измененный другим сеансом между
// выбором и записью, не ошибка - выбирается следующий (не больше трех попыток подряд).
//
// Параметры:
//  Позиция   - МоментВремени - граница, поставленная прошлым шагом
//  Окончание - Дата - конец интервала
//
// Возвращаемое значение:
//  Структура - см. РезультатШага
//
Функция ВыполнитьШагПересчета(Позиция, Окончание)
	НомерПопытки = 0;
	// BSLLS:MagicNumber-off - три выбора подряд: дальше параллельные правки - повод остановиться до следующего запуска
	Пока НомерПопытки < 3 Цикл
	// BSLLS:MagicNumber-on
		НомерПопытки = НомерПопытки + 1;
		Кандидат = СледующийДокументПоследовательности(Позиция, Окончание);
		Если Кандидат = Неопределено Тогда
			Возврат РезультатШага("Конец");
		КонецЕсли;
		Шаг = ПересчитатьДокументПоследовательности(Кандидат, Позиция);
		Если Шаг.Вид <> ВидПовтора() Тогда
			Возврат Шаг;
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатШага("Остановка", , ,
		НСтр("ru = 'Пересчет остановлен: документы последовательности меняются параллельно, повтор - при следующем запуске.';
		|fr = 'Recalcul arrêté : les documents de la séquence changent en parallèle, nouvelle tentative au prochain lancement.';
		|en = 'Recalculation stopped: sequence documents are changing concurrently, it will retry on the next run.';
		|es = 'Recálculo detenido: los documentos de la secuencia cambian en paralelo, se reintentará en el próximo inicio.'"));
КонецФункции

// Перепроведение документа и сдвиг границы на него - одна транзакция (Ф1.3 п. 4). Шаг, который не фиксируется
// (повтор, остановка), откатывается исключением - откат в одном месте, первым в блоке исключения. Ошибка версии
// документа (его изменил другой сеанс после чтения) - повтор выбора, иначе - ошибка документа.
//
// Параметры:
//  Кандидат - Структура - Ссылка, Момент: см. СледующийДокументПоследовательности
//  Позиция  - МоментВремени - граница, поставленная прошлым шагом
//
// Возвращаемое значение:
//  Структура - см. РезультатШага
//
Функция ПересчитатьДокументПоследовательности(Кандидат, Позиция)
	Состояние = Новый Структура("Документ, Версия, Результат");
	Заморожено = НалоговыеДокументыНаОснованиях.ОснованиеЗаморожено(Кандидат.Ссылка);
	ПолучитьСообщенияПользователю(Истина);
	НачатьТранзакцию();
	Попытка
		Состояние.Результат = ШагПересчетаВТранзакции(Кандидат, Позиция, Заморожено, Состояние);
		Если Состояние.Результат.Вид <> "Готово" Тогда
			ВызватьИсключение Состояние.Результат.Вид;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Информация = ИнформацияОбОшибке();
		// Готовый шаг, не сумевший зафиксироваться, - ошибка документа, а не успех (ревью данных, P2).
		Если Состояние.Результат <> Неопределено И Состояние.Результат.Вид <> "Готово" Тогда
			Возврат Состояние.Результат;
		КонецЕсли;
		Если Состояние.Версия <> Неопределено И ВерсияИзменена(Кандидат.Ссылка, Состояние.Версия) Тогда
			Возврат РезультатШага(ВидПовтора());
		КонецЕсли;
		Возврат РезультатШага("Ошибка", Кандидат.Ссылка, , ТекстОшибкиДокумента(Состояние.Документ, Информация));
	КонецПопытки;
	Возврат Состояние.Результат;
КонецФункции

// Тело шага в транзакции. Блокировка таблицы последовательности берется последней, после складских блокировок
// проведения, - как у обычного проведения и рабочих мест. Под ней: граница раньше позиции - ее сдвинули назад,
// остановка; первый документ после позиции уже другой - повтор выбора. Граница на позиции или на самом документе -
// норма: при «Перемещать» платформа сама переносит ее на проводимый документ, идущий сразу за ней. Замороженное
// основание не перепроводится - отметка и сдвиг границы через него.
//
// Параметры:
//  Кандидат   - Структура - Ссылка, Момент
//  Позиция    - МоментВремени - граница прошлого шага
//  Заморожено - Булево - основание заморожено налоговым документом
//  Состояние  - Структура - Документ и Версия загруженного объекта (заполняются)
//
// Возвращаемое значение:
//  Структура - см. РезультатШага
//
Функция ШагПересчетаВТранзакции(Кандидат, Позиция, Заморожено, Состояние)
	Если Не Заморожено Тогда
		Док = Кандидат.Ссылка.ПолучитьОбъект();
		Если Не ДокументМожноПересчитать(Док, Позиция) Тогда
			Возврат РезультатШага(ВидПовтора());
		КонецЕсли;
		Состояние.Документ = Док;
		Состояние.Версия = Док.ВерсияДанных;
		Док.ДополнительныеСвойства.Вставить(РаботаСДокументами.СвойствоВыполняетсяФоновоеПерепроведение(), Истина);
		Док.ДополнительныеСвойства.Вставить(РаботаСДокументами.СвойствоПересчетСтоимости(), Истина);
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Последовательность.Основная");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
	Блокировка.Заблокировать();
	Граница = Последовательности.Основная.ПолучитьГраницу();
	Если Граница.Сравнить(Позиция) < 0 Тогда
		Возврат РезультатШага("Остановка", , ,
			НСтр("ru = 'Пересчет остановлен: документ проведен задним числом, граница сдвинута назад - продолжит следующий запуск.';
			|fr = 'Recalcul arrêté : document validé à une date antérieure, la limite a reculé - suite au prochain lancement.';
			|en = 'Recalculation stopped: a backdated document moved the boundary back - the next run continues.';
			|es = 'Recálculo detenido: un documento con fecha anterior retrasó el límite - seguirá en el próximo inicio.'"));
	КонецЕсли;
	Следующий = СледующийДокументПоследовательности(Позиция, КонецДня(Дата(3999, 12, 31)));
	Если Следующий = Неопределено Или Следующий.Ссылка <> Кандидат.Ссылка Тогда
		Возврат РезультатШага(ВидПовтора());
	КонецЕсли;
	Если Граница.Сравнить(Следующий.Момент) <> 0 Тогда
		Последовательности.Основная.УстановитьГраницу(Следующий.Момент);
	КонецЕсли;
	Если Заморожено Тогда
		РегистрыСведений.НепроведенныеДокументы.ЗаписатьЗаморозку(Кандидат.Ссылка, ТекстЗаморозки());
	Иначе
		РегистрыСведений.НепроведенныеДокументы.УдалитьЗапись(Кандидат.Ссылка);
	КонецЕсли;
	Возврат РезультатШага("Готово", Кандидат.Ссылка, Следующий.Момент);
КонецФункции

// Загруженный документ все еще проведен, не помечен и стоит после позиции - иначе его изменили после выбора.
//
// Параметры:
//  Док     - ДокументОбъект, Неопределено - загруженный документ
//  Позиция - МоментВремени - граница прошлого шага
//
// Возвращаемое значение:
//  Булево - документ можно перепровести
//
Функция ДокументМожноПересчитать(Док, Позиция)
	Если Док = Неопределено Или Не Док.Проведен Или Док.ПометкаУдаления Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Док.МоментВремени().Сравнить(Позиция) > 0;
КонецФункции

// Первый проведенный документ последовательности строго после позиции. Запись последовательности отмена проведения
// не удаляет (проверено 2026-10-30 на копии) - отбор по признаку проведения обязателен, а регистратор составной.
//
// Параметры:
//  Позиция   - МоментВремени - граница
//  Окончание - Дата - документы не позже этой даты
//
// Возвращаемое значение:
//  Структура, Неопределено - Ссылка (ДокументСсылка), Момент (МоментВремени); Неопределено - документов нет
//
Функция СледующийДокументПоследовательности(Позиция, Окончание)
	// BSLLS:QueryNestedFieldsByDot-off - признак проведения составного регистратора
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Основная.Регистратор КАК Ссылка,
		|	Основная.МоментВремени КАК Момент
		|ИЗ
		|	Последовательность.Основная КАК Основная
		|ГДЕ
		|	Основная.МоментВремени > &Позиция
		|	И Основная.Регистратор.Проведен
		|	И Основная.Период <= &Окончание
		|
		|УПОРЯДОЧИТЬ ПО
		|	Основная.МоментВремени");
	// BSLLS:QueryNestedFieldsByDot-on
	Запрос.УстановитьПараметр("Позиция", Позиция);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Ссылка, Момент", Выборка.Ссылка, Выборка.Момент);
КонецФункции

// Число проведенных документов последовательности после позиции - для индикатора формы обработки.
//
// Параметры:
//  Позиция   - МоментВремени - граница
//  Окончание - Дата - конец интервала
//
// Возвращаемое значение:
//  Число - документов
//
Функция ДокументовПослеПозиции(Позиция, Окончание)
	// BSLLS:QueryNestedFieldsByDot-off - признак проведения составного регистратора
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Основная.Регистратор) КАК Количество
		|ИЗ
		|	Последовательность.Основная КАК Основная
		|ГДЕ
		|	Основная.МоментВремени > &Позиция
		|	И Основная.Регистратор.Проведен
		|	И Основная.Период <= &Окончание");
	// BSLLS:QueryNestedFieldsByDot-on
	Запрос.УстановитьПараметр("Позиция", Позиция);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);
КонецФункции

// Отметки замороженной стоимости перед обходом: основание, с которого сняли зависимые возвраты, возвращается в
// пересчет (граница раньше него, отметку снимет его успешное перепроведение); распроведенный или удаленный документ
// отметку теряет, граница - раньше его даты (Ф1.3 п. 3).
//
Процедура ПроверитьОтметкиЗаморозки()
	Для Каждого Документ Из РегистрыСведений.НепроведенныеДокументы.ЗамороженныеДокументы() Цикл
		ДокОбъект = Документ.ПолучитьОбъект();
		Если ДокОбъект = Неопределено Тогда
			РегистрыСведений.НепроведенныеДокументы.УдалитьЗапись(Документ);
			Продолжить;
		КонецЕсли;
		Если Не ДокОбъект.Проведен Тогда
			РегистрыСведений.НепроведенныеДокументы.УдалитьЗапись(Документ);
		КонецЕсли;
		Если Не ДокОбъект.Проведен Или Не НалоговыеДокументыНаОснованиях.ОснованиеЗаморожено(Документ) Тогда
			РаботаСДокументами.СдвинутьГраницуПоследовательностиНазад(РаботаСДокументами.МоментДоДаты(ДокОбъект.Дата));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьОстановкуПересчета(Шаг)
	Если ЗначениеЗаполнено(Шаг.Документ) Тогда
		РегистрыСведений.НепроведенныеДокументы.ЗаписатьОшибку(Шаг.Документ, Шаг.Текст);
	КонецЕсли;
	ЗаписьЖурналаРегистрации(ИмяСобытияПересчета(), УровеньЖурналаРегистрации.Предупреждение, , Шаг.Документ, Шаг.Текст);
КонецПроцедуры

Функция ВерсияИзменена(Ссылка, Версия)
	ДокОбъект = Ссылка.ПолучитьОбъект();
	Возврат ДокОбъект = Неопределено Или ДокОбъект.ВерсияДанных <> Версия;
КонецФункции

Функция ТекстОшибкиДокумента(Док, Информация)
	Если Док <> Неопределено И Док.ДополнительныеСвойства.Свойство("ТекстОшибки") Тогда
		Возврат Док.ДополнительныеСвойства.ТекстОшибки;
	КонецЕсли;
	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Тексты.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация));
	Возврат СтрСоединить(Тексты, Символы.ПС);
КонецФункции

Функция ТекстЗаморозки()
	Возврат НСтр("ru = 'Стоимость заморожена: по налоговому документу на основании есть возвраты или корректировки.';
		|fr = 'Coût gelé : le document fiscal sur base a des retours ou corrections.';
		|en = 'Cost frozen: the tax document based on it has returns or adjustments.';
		|es = 'Coste congelado: el documento fiscal sobre base tiene devoluciones o ajustes.'");
КонецФункции

Функция ВидПовтора()
	Возврат "Повтор";
КонецФункции

Функция РезультатШага(Вид, Документ = Неопределено, Момент = Неопределено, Текст = "")
	Результат = Новый Структура;
	Результат.Вставить("Вид", Вид);
	Результат.Вставить("Документ", Документ);
	Результат.Вставить("Момент", Момент);
	Результат.Вставить("Текст", Текст);
	Возврат Результат;
КонецФункции

Функция ИмяСобытияПересчета()
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Возврат НСтр("ru = 'Пересчет последовательности'; fr = 'Recalcul de la séquence'; en = 'Sequence recalculation';
		|es = 'Recálculo de la secuencia'", КодЯзыка);
КонецФункции

Процедура ОбновлениеРозничныхЦен() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПравилаЦенообразованияСрезПоследних.Параметр КАК ТоварнаяГруппа
	                      |ИЗ
	                      |	РегистрСведений.ПравилаЦенообразования.СрезПоследних(
	                      |			&ДатаСреза,
	                      |			Параметр ССЫЛКА Справочник.ТоварныеГруппы) КАК ПравилаЦенообразованияСрезПоследних
	                      |ГДЕ
	                      |	ПравилаЦенообразованияСрезПоследних.Параметр ССЫЛКА Справочник.ТоварныеГруппы");
	Запрос.УстановитьПараметр("ДатаСреза", ТекущаяДатаСеанса());
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Док = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		Док.Дата = ТекущаяДатаСеанса();
		Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.УстановкаЦенНоменклатуры;
		Док.ВидЦены = Справочники.ВидыЦен.Розничная;
        Док.ТоварнаяГруппа = Выб.ТоварнаяГруппа;	
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ВЫРАЗИТЬ(ТЗБазовыеЦены.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		                      |	ВЫРАЗИТЬ(ТЗБазовыеЦены.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
		                      |	ВЫРАЗИТЬ(ТЗБазовыеЦены.Цена КАК ЧИСЛО) КАК Цена
		                      |ПОМЕСТИТЬ ВТБазовыеЦены
		                      |ИЗ
		                      |	&ТЗБазовыеЦены КАК ТЗБазовыеЦены
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ
		                      |	ВТБазовыеЦены.Номенклатура КАК Номенклатура,
		                      |	ВТБазовыеЦены.Характеристика КАК Характеристика,
		                      |	ВТБазовыеЦены.Цена КАК Цена
		                      |ИЗ
		                      |	ВТБазовыеЦены КАК ВТБазовыеЦены
		                      |ГДЕ
		                      |	ВТБазовыеЦены.Номенклатура.ТоварнаяГруппа = &ТоварнаяГруппа");
		ЦенаВключаетНДС = ОбщегоНазначенияВызовСервера.ЦенаВключаетНДСПоВидуЦен(Док.ВидЦены);
		ТЗБазовыеЦены = РегистрыСведений.ПравилаЦенообразования.СформироватьБазовыеЦены(Док.Дата, ЦенаВключаетНДС);
		Запрос.УстановитьПараметр("ТЗБазовыеЦены", ТЗБазовыеЦены);
		Запрос.УстановитьПараметр("ТоварнаяГруппа", Выб.ТоварнаяГруппа);
		Док.ТЧЦены.Загрузить(Запрос.Выполнить().Выгрузить());
		Док.Комментарий = "Сформирован автоматически по данным правил ценообразования";
		Если Док.ТЧЦены.Количество() = 0 Тогда Продолжить КонецЕсли;
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;	
КонецПроцедуры

Процедура ПроверкаМинимальногоОстатка(МассивТоваров = Неопределено, Склад = Неопределено) Экспорт
	Если МассивТоваров = Неопределено И ОбновлениеНеЗавершено() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиПользователей.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.НастройкиПользователей КАК НастройкиПользователей
	|ГДЕ
	|	НастройкиПользователей.Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыНастроекПользователей.ОповещатьОМинимальномОстатке)
	|	И НастройкиПользователей.Значение = ИСТИНА";
	
	Мас = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пользователь");
	Если Мас.Количество() = 0 Тогда 
		возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если МассивТоваров = Неопределено Тогда
		// Регламентное задание: все позиции ниже минимума по физическому регистру.
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.КоличествоОстаток КАК КоличествоОстаток,
		|	Остатки.МестоХранения КАК МестоХранения
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			,
		|			(МестоХранения = &Склад
		|				ИЛИ &Склад = НЕОПРЕДЕЛЕНО)
		|				И МестоХранения.ОповещатьОМинимальномОстатке) КАК Остатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальныйОстатокПоСкладам КАК МинимальныйОстатокПоСкладам
		|		ПО Остатки.МестоХранения = МинимальныйОстатокПоСкладам.МестоХранения
		|			И Остатки.Номенклатура = МинимальныйОстатокПоСкладам.Номенклатура
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ЕСТЬNULL(МинимальныйОстатокПоСкладам.МинимальноеКоличествоХранения, 0) = 0
		|				ТОГДА Остатки.Номенклатура.МинимальноеКоличествоХранения
		|			ИНАЧЕ ЕСТЬNULL(МинимальныйОстатокПоСкладам.МинимальноеКоличествоХранения, 0)
		|		КОНЕЦ > Остатки.КоличествоОстаток";
	Иначе
		// Запись движений склада: затронутые позиции склада, в том числе с остатком, ушедшим ровно в ноль, - строки
		// виртуальной таблицы остатков для них нет, поэтому позиции берутся из справочника, остаток - соединением.
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	Номенклатура.МинимальноеКоличествоХранения КАК МинимумТовара,
		|	Склады.Ссылка КАК МестоХранения
		|ПОМЕСТИТЬ ВТПозиции
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура,
		|	Справочник.МестаХранения КАК Склады
		|ГДЕ
		|	Номенклатура.Ссылка В (&МассивТоваров)
		|	И Склады.Ссылка = &Склад
		|	И Склады.ОповещатьОМинимальномОстатке
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.МестоХранения КАК МестоХранения,
		|	СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВТОстатки
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			,
		|			(Номенклатура, МестоХранения) В
		|				(ВЫБРАТЬ
		|					ВТПозиции.Номенклатура КАК Номенклатура,
		|					ВТПозиции.МестоХранения КАК МестоХранения
		|				ИЗ
		|					ВТПозиции КАК ВТПозиции)) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Номенклатура,
		|	Остатки.МестоХранения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТПозиции.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ВТОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	ВТПозиции.МестоХранения КАК МестоХранения
		|ИЗ
		|	ВТПозиции КАК ВТПозиции
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
		|		ПО ВТПозиции.Номенклатура = ВТОстатки.Номенклатура
		|			И ВТПозиции.МестоХранения = ВТОстатки.МестоХранения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальныйОстатокПоСкладам КАК МинимальныйОстатокПоСкладам
		|		ПО ВТПозиции.МестоХранения = МинимальныйОстатокПоСкладам.МестоХранения
		|			И ВТПозиции.Номенклатура = МинимальныйОстатокПоСкладам.Номенклатура
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ЕСТЬNULL(МинимальныйОстатокПоСкладам.МинимальноеКоличествоХранения, 0) = 0
		|				ТОГДА ВТПозиции.МинимумТовара
		|			ИНАЧЕ ЕСТЬNULL(МинимальныйОстатокПоСкладам.МинимальноеКоличествоХранения, 0)
		|		КОНЕЦ > ЕСТЬNULL(ВТОстатки.КоличествоОстаток, 0)";
	КонецЕсли;
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("МассивТоваров", МассивТоваров);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстОповещения = "" + Выборка.МестоХранения + ": ";
		ТекстОповещения = ТекстОповещения + НСтр("fr = 'Solde du produit inférieur au minimum:'; ru = 'Остаток по товару ниже минимального'; en = 'The product balance is below the minimum'; es = 'Saldo del producto por debajo del mínimo'") + Выборка.Номенклатура;
		Для Каждого Эл из Мас Цикл 
			РегистрыСведений.СистемныеОповещения.Сформировать(Эл,ТекстОповещения,ПолучитьНавигационнуюСсылку(Выборка.Номенклатура));
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Рассылает менеджерам системные оповещения о запрете отгрузок покупателям с включенным
// контролем кредита: «запрещено отгружать» при наступившем запрете или долге сверх кредита
// и «будет запрещено» за число дней из константы ОповещатьЗаКолДнейДоЗапретаОтгрузок.
Процедура ЗапретОтгрузок() Экспорт
	ДнейДоЗапрета = Константы.ОповещатьЗаКолДнейДоЗапретаОтгрузок.Получить();
	ТЗДолг = РегистрыНакопления.ВзаиморасчётыСПокупателями.ПолучитьПросроченнуюЗадолженность(, 0, Истина);
	Если ТЗДолг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПользователиПоМенеджерам = ПользователиМенеджеров(ТЗДолг.ВыгрузитьКолонку("Менеджер"));
	ТекущийДень = НачалоДня(ТекущаяДатаСеанса());
	ТЗОповещения = Новый ТаблицаЗначений;
	ТЗОповещения.Колонки.Добавить("Пользователь");
	ТЗОповещения.Колонки.Добавить("Описание");
	ТЗОповещения.Колонки.Добавить("НавигационнаяСсылка");
	Для Каждого Стр Из ТЗДолг Цикл
		Если Не Стр.КонтрольКредита Тогда
			Продолжить;
		КонецЕсли;
		Пользователь = ПользователиПоМенеджерам.Получить(Стр.Менеджер);
		Если Пользователь = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗапретНаступил = Стр.ДолгСверхКредита > 0
			Или ЗначениеЗаполнено(Стр.ДатаЗапрета) И НачалоДня(Стр.ДатаЗапрета) <= ТекущийДень;
		Если ЗапретНаступил Тогда
			Шаблон = НСтр("fr = 'Il est interdit d''expédier au client %1 : dette %2, date d''interdiction %3';
				|ru = 'Клиенту %1 запрещено отгружать: долг %2, дата запрета %3';
				|en = 'Shipping to customer %1 is prohibited: debt %2, ban date %3';
				|es = 'Está prohibido enviar al cliente %1: deuda %2, fecha de prohibición %3'");
		ИначеЕсли ЗначениеЗаполнено(Стр.ДатаЗапрета) И ДнейДоЗапрета > 0
			И ВычисленияКлиентСервер.РазностьДатВДнях(Стр.ДатаЗапрета, ТекущийДень) <= ДнейДоЗапрета Тогда
			Шаблон = НСтр("fr = 'Les expéditions au client %1 seront interdites : dette %2, date d''interdiction %3';
				|ru = 'Клиенту %1 будет запрещено отгружать: долг %2, дата запрета %3';
				|en = 'Shipping to customer %1 will be prohibited: debt %2, ban date %3';
				|es = 'Los envíos al cliente %1 serán prohibidos: deuda %2, fecha de prohibición %3'");
		Иначе
			Продолжить;
		КонецЕсли;
		ТекстОповещения = СтрШаблон(Шаблон, Стр.Контрагент, Стр.Долг, Формат(Стр.ДатаЗапрета, "ДЛФ=Д"));
		НоваяСтрока = ТЗОповещения.Добавить();
		НоваяСтрока.Пользователь = Пользователь;
		НоваяСтрока.Описание = ТекстОповещения;
		НоваяСтрока.НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(Стр.Контрагент);
	КонецЦикла;
	СформироватьОповещенияБезПовторов(ТЗОповещения);
КонецПроцедуры

Процедура СформироватьОповещенияБезПовторов(ТЗОповещения)
	// Пока состояние по контрагенту не изменилось, текст оповещения совпадает с прежним:
	// не дублируем оповещение, которое пользователь пока не видел (Отображено = Ложь).
	Если ТЗОповещения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СистемныеОповещения.Сотрудник КАК Пользователь,
	|	СистемныеОповещения.Описание КАК Описание
	|ИЗ
	|	РегистрСведений.СистемныеОповещения КАК СистемныеОповещения
	|ГДЕ
	|	СистемныеОповещения.Сотрудник В (&Пользователи)
	|	И НЕ СистемныеОповещения.Отображено";
	Запрос.УстановитьПараметр("Пользователи", ТЗОповещения.ВыгрузитьКолонку("Пользователь"));
	ТЗНепоказанные = Запрос.Выполнить().Выгрузить();
	ТЗНепоказанные.Индексы.Добавить("Пользователь, Описание");
	Для Каждого Стр Из ТЗОповещения Цикл
		Отбор = Новый Структура("Пользователь, Описание", Стр.Пользователь, Стр.Описание);
		Если ТЗНепоказанные.НайтиСтроки(Отбор).Количество() = 0 Тогда
			РегистрыСведений.СистемныеОповещения.Сформировать(Стр.Пользователь, Стр.Описание, Стр.НавигационнаяСсылка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПользователиМенеджеров(МасМенеджеры)
	// Соответствие «физлицо-менеджер → пользователь» одним запросом.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пользователи.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Пользователи.Ссылка КАК Пользователь
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ФизическоеЛицо В (&МасМенеджеры)
	|	И НЕ Пользователи.ПометкаУдаления";
	Запрос.УстановитьПараметр("МасМенеджеры", МасМенеджеры);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ФизическоеЛицо, Выборка.Пользователь);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура УстановитьДатуЗапретаРедактирования() Экспорт
	АвтозакрытиеПериода = Константы.АвтозакрытиеПериода.Получить();
	Если ЗначениеЗаполнено(АвтозакрытиеПериода) Тогда
		МЗ = РегистрыСведений.ДатыЗапретаРедактирования.СоздатьМенеджерЗаписи();
		МЗ.ВидЗапрета = ПланыВидовХарактеристик.ВидыЗапретаРедактирования.Общая;
		МЗ.ЗначениеЗапрета = "";
		МЗ.ДатаЗапрета = ТекущаяДата() - 86400*АвтозакрытиеПериода;
		МЗ.Записать(Истина);
	Иначе
		НЗ = РегистрыСведений.ДатыЗапретаРедактирования.СоздатьНаборЗаписей();
		НЗ.Отбор.ВидЗапрета.Установить(ПланыВидовХарактеристик.ВидыЗапретаРедактирования.Общая);
		НЗ.Отбор.ЗначениеЗапрета.Установить("");
		НЗ.Записать();
	КонецЕсли;
КонецПроцедуры

Процедура АвтозакрытиеСмены() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КассоваяСмена.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КассоваяСмена КАК КассоваяСмена
	|ГДЕ
	|	КассоваяСмена.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
	|	И КассоваяСмена.Касса.АвтозакрытиеСмены
	|	И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ТекДата, ДЕНЬ), &ТекДата, СЕКУНДА) > РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(КассоваяСмена.Касса.ВремяЗакрытияСмены, ДЕНЬ), КассоваяСмена.Касса.ВремяЗакрытияСмены, СЕКУНДА)";
	Запрос.УстановитьПараметр("ТекДата",ТекущаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		ДокКассоваяСмена = Выборка.Ссылка.ПолучитьОбъект();
		ДокКассоваяСмена.Статус = Перечисления.СтатусыКассовойСмены.Закрыта;
		ДокКассоваяСмена.СуммаЗакрытия = РаботаСДокументами.ПолучитьОстатокВКассе(ДокКассоваяСмена.Касса);
		ДокКассоваяСмена.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ЗакрытиеСеансов() Экспорт
	Если Найти(СтрокаСоединенияИнформационнойБазы(), "Srvr") > 0 Тогда
		
		Поиск1 = Найти(СтрокаСоединенияИнформационнойБазы(), "Srvr=");
		ПодстрокаПоиска = Сред(СтрокаСоединенияИнформационнойБазы(), Поиск1 + 6);
		ИмяСервера = Лев(ПодстрокаПоиска, Найти(ПодстрокаПоиска, """") - 1);
		
		Поиск1 = Найти(СтрокаСоединенияИнформационнойБазы(), "Ref=");
		ПодстрокаПоиска = Сред(СтрокаСоединенияИнформационнойБазы(), Поиск1 + 5);
		ИмяБазы = Лев(ПодстрокаПоиска, Найти(ПодстрокаПоиска, """") - 1);
	Иначе
		ИмяСервера = "";
		
	КонецЕсли;
	
	
	Попытка	
		
	Если ИмяСервера = "" тогда иначе
		
		Коннектор = Новый COMОбъект("v83.COMConnector");
		Агент = Коннектор.ConnectAgent(ИмяСервера);
		Кластеры = Агент.GetClusters();
		Для каждого Кластер из Кластеры Цикл
			АдминистраторКластера = Константы.АдминистраторКластера.Получить();
			ПарольКластера = Константы.ПарольКластера.Получить();
			Агент.Authenticate(Кластер, АдминистраторКластера, ПарольКластера);
			// Сеансы снимаются через агента кластера: аутентификации администратора базы у рабочего
			// процесса нет - зашитые учётные данные убраны (2026-09-06, docs/TECHDEBT.md), поэтому
			// соединения (Disconnect) не разрываются, хватает АдминистраторКластера/ПарольКластера.
			ИнформационнаяБаза = "";
			
			Базы = Агент.GetInfoBases(Кластер);
			Для каждого База из Базы Цикл
				Если База.Name = ИмяБазы Тогда
					ИнформационнаяБаза = База;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ИнформационнаяБаза = "" Тогда
				// база не найдена
			КонецЕсли;
			
			Сеансы = Агент.GetInfoBaseSessions(Кластер, ИнформационнаяБаза);
			Для каждого Сеанс из Сеансы Цикл
				Если нРег(Сеанс.AppID) = "backgroundjob" ИЛИ нРег(Сеанс.AppID) = "designer" Тогда
					Продолжить;
				КонецЕсли;
				Если Сеанс.UserName = ИмяПользователя() Тогда
					Продолжить;
				КонецЕсли;
				Агент.TerminateSession(Кластер, Сеанс);
			КонецЦикла;
		КонецЦикла;	
	КонецЕсли;
	
Исключение
КонецПопытки;
КонецПроцедуры

// Фоновое заполнение демо-набора по кнопке «Заполнить демо-данными» (Настройка → Параметры → Компания и учёт).
// Право администратора проверяется и здесь: задание можно запустить и в обход формы. Запуск кнопки никогда не
// объявляет базу тестовой - проверка демо-базы идёт полностью.
//
// Параметры:
//  Параметры       - Структура - см. Обработки.ТестовыеДанные.НовыеПараметрыДемоНабора
//  АдресРезультата - Строка - адрес временного хранилища формы для итога, см. Обработки.ТестовыеДанные.СоздатьДемоНабор
//
Процедура ЗаполнитьДемоДанные(Параметры, АдресРезультата) Экспорт

	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Заполнить демо-данными может только администратор.';
			|fr = 'Seul l''administrateur peut remplir avec des données de démonstration.';
			|en = 'Only the administrator can fill with demo data.';
			|es = 'Solo el administrador puede llenar con datos de demostración.'");
	КонецЕсли;
	Параметры.ТестоваяБаза = Ложь;
	Итог = Обработки.ТестовыеДанные.СоздатьДемоНабор(Параметры);
	ПоместитьВоВременноеХранилище(Итог, АдресРезультата);

КонецПроцедуры

// Регламентные задания, читающие физический регистр или проводящие документы, не работают, пока обновление базы не
// завершено: обработчик 2.0.16.76 мог упасть на сверке, и ТоварыНаСкладах ещё неполон (ревью плана warehouse-orders).
//
// Возвращаемое значение:
//  Булево - Истина, если версия базы ниже версии конфигурации; в журнал пишется предупреждение.
//
Функция ОбновлениеНеЗавершено()
	Если Не ОбновлениеПрограммы.ТребуетсяОбновление() Тогда
		Возврат Ложь;
	КонецЕсли;
	Текст = НСтр("ru = 'Регламентное задание пропущено: обновление информационной базы не завершено.';
		|fr = 'Tâche planifiée ignorée : la mise à jour de la base d''informations n''est pas terminée.';
		|en = 'Scheduled job skipped: the infobase update is not completed.';
		|es = 'Tarea programada omitida: la actualización de la base de información no ha finalizado.'");
	ИмяСобытия = ОбновлениеПрограммы.ИмяСобытияЖурнала();
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , Текст);
	Возврат Истина;
КонецФункции

#КонецОбласти





