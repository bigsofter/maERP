////////////////////////////////////////////////////////////////////////////////
// Документы в валюте: курсы из регистра КурсыВалют, валюта и курс документа или объекта
// расчётов, пересчёт цен видов цен в валюту документа.
//
// Курс - сколько единиц основной валюты (константа ВалютаРегламентированногоУчета) стоит
// одна единица валюты. Суммы регистров взаиморасчётов, товаров и продаж - в основной валюте.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Основная валюта учёта.
//
// Возвращаемое значение:
//  СправочникСсылка.Валюты - значение константы ВалютаРегламентированногоУчета.
//
Функция ОсновнаяВалюта() Экспорт
	Возврат Константы.ВалютаРегламентированногоУчета.Получить();
КонецФункции

// Курс валюты на дату из регистра КурсыВалют.
//
// Параметры:
//  Валюта - СправочникСсылка.Валюты - валюта; пустая - основная.
//  Дата - Дата - дата курса.
//
// Возвращаемое значение:
//  Число - курс; для основной валюты 1; курс не задан - 0.
//
Функция КурсВалюты(Валюта, Дата) Экспорт
	Если Не ЗначениеЗаполнено(Валюта) Или Валюта = ОсновнаяВалюта() Тогда
		Возврат 1;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Курс КАК Курс
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта) КАК КурсыВалютСрезПоследних";
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Дата), КонецДня(Дата), ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Курс, 0);
КонецФункции

// Валюта и курс документа. Документ в валюте - только с установленным флажком ВВалюте (у документов
// без флажка, например возврата поставщику, - с валютой, отличной от основной). Пустая валюта или
// нулевой курс читаются как основная валюта и курс 1.
//
// Параметры:
//  ДокОбъект - ДокументОбъект, ДанныеФормыСтруктура, Структура - документ с реквизитами Валюта,
//              КурсВалюты и, возможно, ВВалюте; без реквизита Валюта документ считается в основной.
//
// Возвращаемое значение:
//  Структура - Валюта (СправочникСсылка.Валюты), Курс (Число), ВВалюте (Булево).
//
Функция ВалютаИКурсДокумента(ДокОбъект) Экспорт
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеДополнительныхРасходов") Тогда
		Возврат ВалютаИКурсПоРеквизитам(Неопределено, 1, Неопределено); // см. ВалютаИКурсОбъекта
	КонецЕсли;
	ЕстьВалюта = РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект, "Валюта");
	ЕстьФлажок = РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект, "ВВалюте");
	Возврат ВалютаИКурсПоРеквизитам(
		?(ЕстьВалюта, ДокОбъект.Валюта, Неопределено),
		?(ЕстьВалюта, ДокОбъект.КурсВалюты, 1),
		?(ЕстьФлажок, ДокОбъект.ВВалюте, Неопределено));
КонецФункции

// Валюта и курс объекта расчётов (документа-ссылки) - по тем же правилам, что ВалютаИКурсДокумента.
// Вызывается из проведения (привилегированный режим документа) и из форм и печати документа, к которому
// у пользователя есть доступ.
//
// Параметры:
//  Объект - ЛюбаяСсылка, Неопределено - объект расчётов движения взаиморасчётов или документ-основание.
//
// Возвращаемое значение:
//  Структура - Валюта, Курс, ВВалюте (см. ВалютаИКурсДокумента).
//
Функция ВалютаИКурсОбъекта(Объект) Экспорт
	Если Не ЗначениеЗаполнено(Объект) Или Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект)) Тогда
		Возврат ВалютаИКурсПоРеквизитам(Неопределено, 1, Неопределено);
	КонецЕсли;
	МетаданныеОбъекта = Объект.Метаданные();
	Реквизиты = МетаданныеОбъекта.Реквизиты;
	// Поступление доп. расходов валюту и курс хранит, но проводится в основной валюте: валютным не считается.
	Если Реквизиты.Найти("Валюта") = Неопределено Или Реквизиты.Найти("КурсВалюты") = Неопределено
		Или МетаданныеОбъекта = Метаданные.Документы.ПоступлениеДополнительныхРасходов Тогда
		Возврат ВалютаИКурсПоРеквизитам(Неопределено, 1, Неопределено);
	КонецЕсли;
	ЕстьФлажок = Реквизиты.Найти("ВВалюте") <> Неопределено;
	ИменаРеквизитов = "Валюта, КурсВалюты" + ?(ЕстьФлажок, ", ВВалюте", "");
	Значения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, ИменаРеквизитов);
	Возврат ВалютаИКурсПоРеквизитам(Значения.Валюта, Значения.КурсВалюты,
		?(ЕстьФлажок, Значения.ВВалюте, Неопределено));
КонецФункции

// Валюта и курс объекта расчётов для регистров взаиморасчётов: заказ покупателя - объект авансов - всегда в
// основной валюте (аванс по заказу зачитывается реализацией в основной валюте), остальные документы - как
// ВалютаИКурсОбъекта (docs/plans/multicurrency-orders.md).
//
// Параметры:
//  Объект - ЛюбаяСсылка, Неопределено - объект расчётов.
//
// Возвращаемое значение:
//  Структура - Валюта, Курс, ВВалюте (см. ВалютаИКурсДокумента).
//
Функция ВалютаОбъектаРасчетов(Объект) Экспорт
	Если ТипЗнч(Объект) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат ВалютаИКурсПоРеквизитам(Неопределено, 1, Неопределено);
	КонецЕсли;
	Возврат ВалютаИКурсОбъекта(Объект);
КонецФункции

// Цена вида цен в валюте документа: Цена × Курс(валюты цены) / Курс документа.
//
// Параметры:
//  Цена - Число - цена в валюте цены.
//  ВалютаЦены - СправочникСсылка.Валюты - валюта цены; пустая - основная.
//  ВалютаДокумента - СправочникСсылка.Валюты - валюта документа; пустая - основная.
//  КурсДокумента - Число - курс валюты документа (для основной - 1).
//  Дата - Дата - дата курса валюты цены.
//  КурсНайден - Булево - возврат: Ложь, если курс валюты цены на дату не задан и цена не пересчитана.
//
// Возвращаемое значение:
//  Число - цена в валюте документа.
//
Функция ПересчитатьЦену(Цена, ВалютаЦены, ВалютаДокумента, КурсДокумента, Дата, КурсНайден = Истина) Экспорт
	КурсНайден = Истина;
	Основная = ОсновнаяВалюта();
	ИзВалюты = ?(ЗначениеЗаполнено(ВалютаЦены), ВалютаЦены, Основная);
	ВВалюту = ?(ЗначениеЗаполнено(ВалютаДокумента), ВалютаДокумента, Основная);
	Если Цена = 0 Или ИзВалюты = ВВалюту Тогда
		Возврат Цена;
	КонецЕсли;
	КурсЦены = КурсВалюты(ИзВалюты, Дата);
	Если КурсЦены = 0 Тогда
		КурсНайден = Ложь;
		Возврат Цена;
	КонецЕсли;
	Курс = ?(ВВалюту = Основная Или КурсДокумента <= 0, 1, КурсДокумента);
	Возврат Цена * КурсЦены / Курс;
КонецФункции

// Приводит валюту документа к флажку ВВалюте перед записью: флажок снят или валюта основная - основная
// валюта и курс 1; флажок установлен без курса - курс на дату документа из регистра, а нет его - отказ:
// документ по курсу 1 провёл бы суммы в валюте как основные.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ с реквизитами ВВалюте, Валюта, КурсВалюты, Дата.
//  Отказ - Булево - устанавливается, если курс документа в валюте не задан.
//
Процедура ПроверитьВалютуДокумента(ДокОбъект, Отказ = Ложь) Экспорт
	Основная = ОсновнаяВалюта();
	Если ДокОбъект.ВВалюте И ЗначениеЗаполнено(ДокОбъект.Валюта) И ДокОбъект.Валюта <> Основная Тогда
		Если ДокОбъект.КурсВалюты <= 0 Тогда
			ДокОбъект.КурсВалюты = КурсВалюты(ДокОбъект.Валюта, ДокОбъект.Дата);
		КонецЕсли;
		Если ДокОбъект.КурсВалюты <= 0 Тогда
			Шаблон = НСтр("ru = 'Не указан курс валюты %1.'; fr = 'Le taux de change de %1 n''est pas indiqué.';
				|en = 'The %1 exchange rate is not specified.'; es = 'No se indica el tipo de cambio de %1.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, ДокОбъект.Валюта), ДокОбъект,
				"КурсВалюты", , Отказ);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ДокОбъект.ВВалюте = Ложь;
	ДокОбъект.Валюта = Основная;
	ДокОбъект.КурсВалюты = 1;
КонецПроцедуры

// Переносит валюту с документа-основания в документ, вводимый на основании, курс - на дату нового документа
// или курс самого основания.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - заполняемый документ с реквизитами ВВалюте, Валюта, КурсВалюты.
//  Основание - ДокументСсылка - основание; без валюты документ остаётся в основной валюте.
//  КурсОснования - Булево - Истина: курс основания (возврат, налоговая накладная оформляют совершённую
//                  продажу и гасят её долг без курсовой разницы); Ложь - курс на дату документа.
//
Процедура ЗаполнитьВалютуПоОснованию(ДокОбъект, Основание, КурсОснования = Ложь) Экспорт
	ВалютаОснования = ВалютаИКурсОбъекта(Основание);
	ДокОбъект.ВВалюте = ВалютаОснования.ВВалюте;
	ДокОбъект.Валюта = ВалютаОснования.Валюта;
	// Курс - на дату нового документа; курса на дату нет - курс основания.
	Курс = ?(ВалютаОснования.ВВалюте И Не КурсОснования, КурсВалюты(ВалютаОснования.Валюта, ДокОбъект.Дата), 0);
	ДокОбъект.КурсВалюты = ?(Курс > 0, Курс, ВалютаОснования.Курс);
КонецПроцедуры

// Сумма документа-основания в основной валюте - для оплаты, вводимой на его основании.
//
// Параметры:
//  Основание - ДокументСсылка - документ с валютой или без неё.
//  Сумма - Число - сумма основания в его валюте.
//
// Возвращаемое значение:
//  Число - сумма в основной валюте.
//
Функция СуммаОбъектаВОсновнойВалюте(Основание, Сумма) Экспорт
	Возврат РаботаСВалютамиКлиентСервер.СуммаРегл(Сумма, ВалютаИКурсОбъекта(Основание).Курс);
КонецФункции

// Пересчитывает колонки сумм таблицы из валюты документа в основную валюту (с округлением до копеек).
//
// Параметры:
//  Таблица - ТаблицаЗначений - строки документа.
//  Курс - Число - курс валюты документа; 1 - без пересчёта.
//  ИменаКолонок - Строка - имена колонок через запятую; отсутствующие в таблице пропускаются.
//
Процедура ПересчитатьКолонкиВОсновнуюВалюту(Таблица, Курс, ИменаКолонок) Экспорт
	Если Курс = 1 Тогда
		Возврат;
	КонецЕсли;
	Колонки = Новый Массив;
	Для Каждого ИмяКолонки Из СтрРазделить(ИменаКолонок, ", ", Ложь) Цикл
		Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			Колонки.Добавить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Таблица Цикл
		Для Каждого ИмяКолонки Из Колонки Цикл
			Стр[ИмяКолонки] = РаботаСВалютамиКлиентСервер.СуммаРегл(Стр[ИмяКолонки], Курс);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Переводит суммы строк из валюты документа в основную валюту так, что их итог равен итогу в основной валюте:
// остаток округления - на последнюю ненулевую строку (иначе раскладка шапки по строкам расходилась бы с долгом
// на копейки).
//
// Параметры:
//  Суммы - Массив из Число - суммы строк в валюте документа.
//  Курс - Число - курс документа; 1 - без пересчёта.
//
// Возвращаемое значение:
//  Массив из Число - суммы строк в основной валюте, по тому же порядку.
//
Функция СуммыСтрокВОсновнойВалюте(Суммы, Курс) Экспорт
	Результат = Новый Массив;
	Итог = 0;
	ИтогРегл = 0;
	Последняя = -1;
	Для Индекс = 0 По Суммы.ВГраница() Цикл
		СуммаРегл = РаботаСВалютамиКлиентСервер.СуммаРегл(Суммы[Индекс], Курс);
		Результат.Добавить(СуммаРегл);
		Итог = Итог + Суммы[Индекс];
		ИтогРегл = ИтогРегл + СуммаРегл;
		Если Суммы[Индекс] <> 0 Тогда
			Последняя = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если Последняя >= 0 Тогда
		Результат[Последняя] = Результат[Последняя] + РаботаСВалютамиКлиентСервер.СуммаРегл(Итог, Курс) - ИтогРегл;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Валюта и курс возврата - всегда основания (реализации, налоговой накладной, прочих расходов) и по его курсу:
// возврат сторнирует основание без курсовой разницы. Без основания возврат ведётся в основной валюте.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - возврат с реквизитами Основание, ВВалюте, Валюта, КурсВалюты.
//  Отказ - Булево - см. ПроверитьВалютуДокумента.
//
Процедура ЗаполнитьВалютуВозврата(ДокОбъект, Отказ = Ложь) Экспорт
	Если ЗначениеЗаполнено(ДокОбъект.Основание) Тогда
		ЗаполнитьВалютуПоОснованию(ДокОбъект, ДокОбъект.Основание, Истина);
	Иначе
		ДокОбъект.ВВалюте = Ложь;
	КонецЕсли;
	ПроверитьВалютуДокумента(ДокОбъект, Отказ);
КонецПроцедуры

// Валюта и курс налоговой накладной по её отгрузкам: валюта - первой отгрузки, курс - средний по покрытым
// суммам (Σ в основной валюте / Σ в валюте, каждая отгрузка по своему курсу), чтобы сумма накладной в основной
// валюте совпала с перенесённым долгом. Отгрузки в другой валюте - отказ. Вызывается после итогов документа:
// пересчитывает суммы в основной валюте, шапку - точной суммой отгрузок (каждая по своему курсу).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладная - накладная с реквизитами ВВалюте, Валюта, КурсВалюты.
//  Отгрузки - ТаблицаЗначений - покрытые отгрузки, колонки Основание и Сумма (в валюте отгрузки).
//  Отказ - Булево - устанавливается при отгрузках в разных валютах.
//
Процедура ЗаполнитьВалютуПоОтгрузкам(ДокОбъект, Отгрузки, Отказ) Экспорт
	ВалютаНакладной = Неопределено;
	СуммаВВалюте = 0;
	СуммаРегл = 0;
	Для Каждого Стр Из Отгрузки Цикл
		Если Не ЗначениеЗаполнено(Стр.Основание) Тогда
			Продолжить;
		КонецЕсли;
		ВалютаОтгрузки = ВалютаИКурсОбъекта(Стр.Основание);
		Если ВалютаНакладной = Неопределено Тогда
			ВалютаНакладной = ВалютаОтгрузки;
		КонецЕсли;
		Если ВалютаОтгрузки.Валюта <> ВалютаНакладной.Валюта Тогда
			Шаблон = НСтр("ru = 'Отгрузка «%1» в валюте %2, а накладная - в %3: в одну накладную входят отгрузки одной валюты.';
				|fr = 'L''expédition « %1 » est en %2 et la facture en %3 : une facture ne regroupe que des expéditions d''une même devise.';
				|en = 'Shipment ""%1"" is in %2 and the invoice in %3: an invoice groups shipments in one currency only.';
				|es = 'El envío «%1» está en %2 y la factura en %3: una factura agrupa solo envíos de una misma moneda.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(Шаблон, Стр.Основание, ВалютаОтгрузки.Валюта, ВалютаНакладной.Валюта), , , , Отказ);
			Продолжить;
		КонецЕсли;
		СуммаВВалюте = СуммаВВалюте + Стр.Сумма;
		СуммаРегл = СуммаРегл + РаботаСВалютамиКлиентСервер.СуммаРегл(Стр.Сумма, ВалютаОтгрузки.Курс);
	КонецЦикла;
	// Без отгрузок (накладная по заказу) - валюта, заданная при заполнении.
	Если ВалютаНакладной <> Неопределено Тогда
		ДокОбъект.ВВалюте = ВалютаНакладной.ВВалюте;
		ДокОбъект.Валюта = ВалютаНакладной.Валюта;
		ТочностьКурса = 4;
		ДокОбъект.КурсВалюты = ?(СуммаВВалюте = 0, ВалютаНакладной.Курс, Окр(СуммаРегл / СуммаВВалюте, ТочностьКурса));
	КонецЕсли;
	// Основная валюта - курс 1; валюта без курса - отказ.
	ПроверитьВалютуДокумента(ДокОбъект, Отказ);
	// Шапка - сумма отгрузок по их курсам (плюс строки без отгрузки по курсу накладной): средний курс округлён до
	// 4 знаков, и налоговый регистр иначе разошёлся бы с долгом, перенесённым в обычный регистр.
	РаботаСВалютамиКлиентСервер.ПересчитатьСуммыРегл(ДокОбъект);
	Если ДокОбъект.ВВалюте И ВалютаНакладной <> Неопределено Тогда
		ДокОбъект.СуммаРегл = СуммаРегл
			+ РаботаСВалютамиКлиентСервер.СуммаРегл(ДокОбъект.Сумма - СуммаВВалюте, ДокОбъект.КурсВалюты);
	КонецЕсли;
КонецПроцедуры

// Текст сообщения о незаданном курсе валюты.
//
// Параметры:
//  Валюта - СправочникСсылка.Валюты - валюта без курса.
//  Дата - Дата - дата, на которую курс искали.
//
// Возвращаемое значение:
//  Строка - текст для пользователя.
//
Функция ТекстКурсНеЗадан(Валюта, Дата) Экспорт
	Шаблон = НСтр("ru = 'Курс валюты %1 на %2 не задан (Казначейство - Курсы валют): цена не пересчитана.';
		|fr = 'Le taux de change de %1 au %2 n''est pas défini (Trésorerie - Taux de change) : prix non converti.';
		|en = 'The %1 exchange rate on %2 is not set (Treasury - Exchange rates): the price was not converted.';
		|es = 'El tipo de cambio de %1 al %2 no está definido (Tesorería - Tipos de cambio): precio no convertido.'");
	Возврат СтрШаблон(Шаблон, Валюта, Формат(Дата, "ДЛФ=D"));
КонецФункции

// Оплаты в валюте (docs/plans/multicurrency-payments.md, 2.0.16.23): ПКО, РКО, поступление и списание
// безналичных ведутся в валюте кассы или банковского счёта; Сумма и строки оснований - в этой валюте.

// Валюта кассы или банковского счёта; пустая - основная.
//
// Параметры:
//  МестоХранения - СправочникСсылка.Кассы, СправочникСсылка.БанковскиеСчета, Неопределено - касса или счёт.
//
// Возвращаемое значение:
//  СправочникСсылка.Валюты - валюта денег.
//
Функция ВалютаМестаХранения(МестоХранения) Экспорт
	Основная = ОсновнаяВалюта();
	Если Не ЗначениеЗаполнено(МестоХранения) Тогда
		Возврат Основная;
	КонецЕсли;
	Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МестоХранения, "Валюта");
	Возврат ?(ЗначениеЗаполнено(Валюта), Валюта, Основная);
КонецФункции

// Касса или банковский счёт платёжного документа, по которым определяется его валюта.
//
// Параметры:
//  ДокОбъект - ДокументОбъект, ДанныеФормыСтруктура - ПКО, РКО, поступление или списание безналичных.
//
// Возвращаемое значение:
//  СправочникСсылка.Кассы, СправочникСсылка.БанковскиеСчета - место хранения денег.
//
Функция МестоХраненияПлатежа(ДокОбъект) Экспорт
	// BSLLS:YoLetterUsage-off - имя реквизита метаданных
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект, "БанковскийСчёт") Тогда
		Возврат ДокОбъект.БанковскийСчёт;
	КонецЕсли;
	// BSLLS:YoLetterUsage-on
	Возврат ДокОбъект.Касса;
КонецФункции

// Валюта платёжного документа - валюта его кассы или счёта, курс - на дату документа (прежний курс той же
// валюты сохраняется: его могли поправить вручную).
//
// Параметры:
//  ДокОбъект - ДокументОбъект, ДанныеФормыСтруктура - платёжный документ с реквизитами Валюта, КурсВалюты.
//  ОбновитьКурс - Булево - Истина: курс берётся из регистра заново (смена даты в форме).
//
Процедура ЗаполнитьВалютуПлатежа(ДокОбъект, ОбновитьКурс = Ложь) Экспорт
	Валюта = ВалютаМестаХранения(МестоХраненияПлатежа(ДокОбъект));
	Если Валюта = ОсновнаяВалюта() Тогда
		ДокОбъект.Валюта = Валюта;
		ДокОбъект.КурсВалюты = 1;
		Возврат;
	КонецЕсли;
	Если ОбновитьКурс Или ДокОбъект.Валюта <> Валюта Или ДокОбъект.КурсВалюты <= 0 Тогда
		ДокОбъект.КурсВалюты = КурсВалюты(Валюта, ДокОбъект.Дата);
	КонецЕсли;
	ДокОбъект.Валюта = Валюта;
КонецПроцедуры

// Валюта платёжного документа перед записью и проверки при проведении. Валюта заполняется у документа без неё:
// у нового - валюта кассы или счёта, у записанного раньше (до оплат в валюте) - основная: его суммы проводились в
// основной валюте, и перезапись их не переводит. Дальше валюту меняет только смена кассы или счёта в форме.
// При проведении нового документа или документа в валюте: валюта совпадает с валютой кассы или счёта и второй
// стороны перемещения; курс задан; в валюте - только оплаты клиентам и поставщикам (без чеков, сертификатов и
// списания задолженности) и перемещения денег; кассовая смена (РМК) - только с кассой в основной валюте.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёжный документ.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  Отказ - Булево - устанавливается при ошибке.
//
Процедура ПроверитьВалютуПлатежа(ДокОбъект, РежимЗаписи, Отказ) Экспорт
	ЭтоНовый = ДокОбъект.ЭтоНовый();
	// Признак правки - до присваиваний ниже: они сами делают объект изменённым.
	Изменен = ДокОбъект.Модифицированность();
	// Новый документ (и копия - курс у неё сброшен): валюта кассы или счёта, курс на дату.
	Если ЭтоНовый И (Не ЗначениеЗаполнено(ДокОбъект.Валюта) Или ДокОбъект.КурсВалюты <= 0) Тогда
		ЗаполнитьВалютуПлатежа(ДокОбъект);
	КонецЕсли;
	// Записанный документ без валюты проводился в основной; с валютой - её меняет только смена кассы или счёта в форме.
	Если Не ЭтоНовый И Не ЗначениеЗаполнено(ДокОбъект.Валюта) Тогда
		ДокОбъект.Валюта = ОсновнаяВалюта();
		ДокОбъект.КурсВалюты = 1;
	КонецЕсли;
	ВалютаДокумента = ВалютаИКурсДокумента(ДокОбъект);
	СуммаРегл = РаботаСВалютамиКлиентСервер.СуммаРегл(ДокОбъект.Сумма, ВалютаДокумента.Курс);
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект, "СуммаРегл") Тогда
		ДокОбъект.СуммаРегл = СуммаРегл;
	Иначе
		ДокОбъект.СуммаВВалютеРеглУчета = СуммаРегл; // списание безналичных
	КонецЕсли;
	// Проверяется новый, валютный или изменённый документ; старый, перепроводимый без правки, - нет: его суммы
	// проводились в основной валюте и по кассе, которой валюту могли поставить позже.
	Проверять = ЭтоНовый Или ВалютаДокумента.ВВалюте Или Изменен;
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Или Не Проверять Тогда
		Возврат;
	КонецЕсли;
	Ошибки = ОшибкиВалютыПлатежа(ДокОбъект, ВалютаДокумента);
	Для Каждого ТекстОшибки Из Ошибки Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокОбъект, , , Отказ);
	КонецЦикла;
КонецПроцедуры

// Платёжный документ в валюте кассы или счёта: ПКО, РКО, поступление или списание безналичных.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//
// Возвращаемое значение:
//  Булево - Истина для платёжного документа.
//
Функция ЭтоПлатежныйДокумент(ДокОбъект) Экспорт
	Тип = ТипЗнч(ДокОбъект);
	Возврат Тип = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Или Тип = Тип("ДокументОбъект.РасходныйКассовыйОрдер")
		Или Тип = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств")
		Или Тип = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств");
КонецФункции

// Строка оплаты платёжного документа в регистр взаиморасчётов: долг закрывается по курсу объекта расчётов,
// курсовая разница копится в ДополнительныеСвойства.КурсовыеРазницы документа (пишет её регистр Убытки).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёжный документ.
//  СуммаСтроки - Число - сумма строки в валюте платежа.
//  Объект - ДокументСсылка - объект расчётов строки.
//  ИмяРегистра - Строка - ВзаиморасчётыСПокупателями или ВзаиморасчётыСПоставщиками.
//  Сторно - Булево - возврат оплаты: суммы со знаком минус, остаток объекта не подгоняется.
//
// Возвращаемое значение:
//  Структура - Сумма (основная валюта, со знаком), СуммаВВалюте (со знаком; Неопределено - объект в основной валюте).
//
Функция СтрокаОплатыВРасчеты(ДокОбъект, СуммаСтроки, Объект, ИмяРегистра, Сторно) Экспорт
	Расчет = РасчетСтрокиОплаты(СуммаСтроки, ДокОбъект, Объект, ИмяРегистра, Не Сторно);
	Знак = ?(Сторно, -1, 1);
	Если ДокОбъект.ДополнительныеСвойства.Свойство("КурсовыеРазницы") Тогда
		ДокОбъект.ДополнительныеСвойства.КурсовыеРазницы = ДокОбъект.ДополнительныеСвойства.КурсовыеРазницы
			+ Расчет.КурсоваяРазница;
	КонецЕсли;
	Возврат Новый Структура("Сумма, СуммаВВалюте", Знак * Расчет.СуммаРасчетов,
		?(Расчет.СуммаВВалюте = Неопределено, Неопределено, Знак * Расчет.СуммаВВалюте));
КонецФункции

// Аванс платёжного документа (сумма сверх строк оснований) в основной валюте: сумма документа в основной
// валюте минус строки, каждая по курсу документа, - копейки округления остаются в авансе, а деньги сходятся
// с суммой документа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёжный документ с табличной частью ТЧОснования.
//
// Возвращаемое значение:
//  Число - аванс в основной валюте.
//
Функция АвансПлатежаВОсновнойВалюте(ДокОбъект) Экспорт
	Курс = ВалютаИКурсДокумента(ДокОбъект).Курс;
	Аванс = РаботаСВалютамиКлиентСервер.СуммаРегл(ДокОбъект.Сумма, Курс);
	Для Каждого Стр Из ДокОбъект.ТЧОснования Цикл
		Аванс = Аванс - РаботаСВалютамиКлиентСервер.СуммаРегл(Стр.Сумма, Курс);
	КонецЦикла;
	Возврат Аванс;
КонецФункции

// Строка оплаты по объекту расчётов: сколько денег в основной валюте, на сколько закрывается долг в основной
// валюте и в валюте объекта и курсовая разница между ними (docs/plans/multicurrency-payments.md, «Модель»).
// Строка, закрывающая остаток объекта в его валюте (расхождение до копейки), закрывает его ровно.
//
// Параметры:
//  СуммаСтроки - Число - сумма строки в валюте платежа, неотрицательная.
//  ДокОбъект - ДокументОбъект - платёжный документ.
//  Объект - ДокументСсылка - объект расчётов строки.
//  ИмяРегистра - Строка - ВзаиморасчётыСПокупателями или ВзаиморасчётыСПоставщиками.
//  ЗакрыватьОстаток - Булево - Ложь для сторно (возврат оплаты): остаток не подгоняется.
//
// Возвращаемое значение:
//  Структура - СуммаРегл, СуммаРасчетов (основная валюта), СуммаВВалюте (Неопределено у объекта в основной
//              валюте), КурсоваяРазница (СуммаРегл - СуммаРасчетов).
//
Функция РасчетСтрокиОплаты(СуммаСтроки, ДокОбъект, Объект, ИмяРегистра, ЗакрыватьОстаток) Экспорт
	ВалютаПлатежа = ВалютаИКурсДокумента(ДокОбъект);
	СуммаРегл = РаботаСВалютамиКлиентСервер.СуммаРегл(СуммаСтроки, ВалютаПлатежа.Курс);
	Результат = Новый Структура("СуммаРегл, СуммаРасчетов, СуммаВВалюте, КурсоваяРазница");
	Результат.СуммаРегл = СуммаРегл;
	Результат.СуммаРасчетов = СуммаРегл;
	Результат.КурсоваяРазница = 0;
	ВалютаОбъекта = ВалютаОбъектаРасчетов(Объект);
	Если Не ВалютаОбъекта.ВВалюте Тогда
		Возврат Результат;
	КонецЕсли;
	Если ВалютаОбъекта.Валюта = ВалютаПлатежа.Валюта Тогда
		СуммаВВалюте = СуммаСтроки;
	Иначе
		СуммаВВалюте = РаботаСВалютамиКлиентСервер.СуммаВВалюте(СуммаРегл,
			КурсОбъектаНаДату(ВалютаОбъекта, ДокОбъект.Дата));
	КонецЕсли;
	СуммаРасчетов = РаботаСВалютамиКлиентСервер.СуммаРегл(СуммаВВалюте, ВалютаОбъекта.Курс);
	Если ЗакрыватьОстаток Тогда
		// Долг - остаток до документа за вычетом строк этого же документа по тому же объекту.
		Долг = ДолгОбъектаРасчетов(ИмяРегистра, Объект, ДокОбъект);
		ДопустимоеРасхождение = 0.01;
		Если Долг.СуммаВВалюте > 0 И Макс(Долг.СуммаВВалюте - СуммаВВалюте, СуммаВВалюте - Долг.СуммаВВалюте)
			<= ДопустимоеРасхождение Тогда
			СуммаВВалюте = Долг.СуммаВВалюте;
			СуммаРасчетов = Долг.Сумма;
		КонецЕсли;
		ЗакрытоСтроками = ДокОбъект.ДополнительныеСвойства.ЗакрытоСтрокамиОплаты;
		Закрыто = ЗакрытоСтроками.Получить(Объект);
		Если Закрыто = Неопределено Тогда
			Закрыто = Новый Структура("Сумма, СуммаВВалюте", 0, 0);
			ЗакрытоСтроками.Вставить(Объект, Закрыто);
		КонецЕсли;
		Закрыто.Сумма = Закрыто.Сумма + СуммаРасчетов;
		Закрыто.СуммаВВалюте = Закрыто.СуммаВВалюте + СуммаВВалюте;
	КонецЕсли;
	Результат.СуммаВВалюте = СуммаВВалюте;
	Результат.СуммаРасчетов = СуммаРасчетов;
	Результат.КурсоваяРазница = СуммаРегл - СуммаРасчетов;
	Возврат Результат;
КонецФункции

// Множитель суммы основания: в валюту платежа (та же валюта - 1, иначе через основную валюту по курсам
// основания и платежа) или, без валюты платежа, в основную валюту.
//
// Параметры:
//  Основание - ДокументСсылка, Неопределено - документ, по которому платят.
//  ВалютаПлатежа - Структура, Неопределено - Валюта и Курс платёжного документа.
//
// Возвращаемое значение:
//  Число - множитель суммы основания.
//
Функция КоэффициентСуммыОснования(Основание, ВалютаПлатежа) Экспорт
	ВалютаОснования = ВалютаИКурсОбъекта(Основание);
	Если ВалютаПлатежа = Неопределено Тогда
		Возврат ВалютаОснования.Курс;
	КонецЕсли;
	Основная = ОсновнаяВалюта();
	Валюта = ?(ЗначениеЗаполнено(ВалютаПлатежа.Валюта), ВалютаПлатежа.Валюта, Основная);
	Если ВалютаОснования.Валюта = Валюта Тогда
		Возврат 1;
	КонецЕсли;
	// Основание в валюте платят в другой валюте по курсу на дату платежа: долг в его валюте закрывается полностью.
	// Заказ покупателя - объект расчётов в основной валюте: его оплата - по курсу самого заказа (без курсовой
	// разницы), иначе оплаченный заказ сравнивался бы с СуммаРегл по другому курсу. Прочие расходы и их возврат
	// ведут расчёты без валюты (в основной по своему курсу) - так же.
	КурсОснования = ВалютаОснования.Курс;
	ПоКурсуНаДату = ВалютаОснования.ВВалюте И ВалютаПлатежа.Свойство("Дата")
		И ТипЗнч(Основание) <> Тип("ДокументСсылка.ЗаказПокупателя")
		И ТипЗнч(Основание) <> Тип("ДокументСсылка.ПрочиеРасходы")
		И ТипЗнч(Основание) <> Тип("ДокументСсылка.ПрочиеРасходыВозврат");
	Если ПоКурсуНаДату Тогда
		КурсОснования = КурсОбъектаНаДату(ВалютаОснования, ВалютаПлатежа.Дата);
	КонецЕсли;
	Если Валюта = Основная Или ВалютаПлатежа.Курс <= 0 Тогда
		Возврат КурсОснования;
	КонецЕсли;
	Возврат КурсОснования / ВалютаПлатежа.Курс;
КонецФункции

// Долг по объекту расчётов в валюте платежа: в валюте объекта - остаток в валюте как есть; объект в другой
// валюте - остаток в его валюте по курсу на дату платежа; объект в основной валюте - остаток в основной валюте.
//
// Параметры:
//  Объект - ДокументСсылка - объект расчётов.
//  СуммаРегл - Число - остаток в основной валюте, по модулю.
//  СуммаВВалюте - Число - остаток в валюте объекта, по модулю.
//  ВалютаПлатежа - Структура - Валюта, Курс и, возможно, Дата платёжного документа.
//
// Возвращаемое значение:
//  Число - долг в валюте платежа.
//
Функция ДолгВВалютеПлатежа(Объект, СуммаРегл, СуммаВВалюте, ВалютаПлатежа) Экспорт
	ВалютаОбъекта = ВалютаОбъектаРасчетов(Объект);
	Если ВалютаОбъекта.ВВалюте И ВалютаОбъекта.Валюта = ВалютаПлатежа.Валюта Тогда
		Возврат СуммаВВалюте;
	КонецЕсли;
	Долг = СуммаРегл;
	Если ВалютаОбъекта.ВВалюте И ВалютаПлатежа.Свойство("Дата") Тогда
		Долг = РаботаСВалютамиКлиентСервер.СуммаРегл(СуммаВВалюте, КурсОбъектаНаДату(ВалютаОбъекта, ВалютаПлатежа.Дата));
	КонецЕсли;
	Возврат РаботаСВалютамиКлиентСервер.СуммаВВалюте(Долг, ВалютаПлатежа.Курс);
КонецФункции

// Сумма основания в валюте платежа (см. КоэффициентСуммыОснования): в той же валюте - как есть, основание в
// другой валюте - по курсу на дату платежа, чтобы долг в его валюте закрылся полностью.
//
// Параметры:
//  Основание - ДокументСсылка - документ, по которому платят.
//  Сумма - Число - сумма в валюте основания.
//  ДокОбъект - ДокументОбъект - платёжный документ с реквизитами Валюта, КурсВалюты, Дата.
//
// Возвращаемое значение:
//  Число - сумма в валюте платежа.
//
Функция СуммаВВалютеПлатежа(Основание, Сумма, ДокОбъект) Экспорт
	ВалютаПлатежа = РаботаСВалютамиКлиентСервер.ВалютаПлатежа(ДокОбъект);
	Возврат РаботаСВалютамиКлиентСервер.СуммаРегл(Сумма, КоэффициентСуммыОснования(Основание, ВалютаПлатежа));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Курс валюты объекта расчётов на дату платежа; курса на дату нет - курс самого объекта (без курсовой разницы).
//
// Параметры:
//  ВалютаОбъекта - Структура - см. ВалютаИКурсОбъекта.
//  Дата - Дата - дата платежа.
//
// Возвращаемое значение:
//  Число - курс.
//
Функция КурсОбъектаНаДату(ВалютаОбъекта, Дата)
	Курс = КурсВалюты(ВалютаОбъекта.Валюта, Дата);
	Возврат ?(Курс > 0, Курс, ВалютаОбъекта.Курс);
КонецФункции

// Долг по объекту расчётов, который закрывает платёжный документ: остаток до документа со знаком долга (у
// покупателей - плюс, у поставщиков - минус) за вычетом строк того же документа по этому объекту. Переплата -
// отрицательный долг.
//
// Параметры:
//  ИмяРегистра - Строка - ВзаиморасчётыСПокупателями или ВзаиморасчётыСПоставщиками.
//  Объект - ДокументСсылка - объект расчётов.
//  ДокОбъект - ДокументОбъект - платёжный документ (граница остатков, ДополнительныеСвойства.ЗакрытоСтрокамиОплаты).
//
// Возвращаемое значение:
//  Структура - Сумма (основная валюта), СуммаВВалюте.
//
Функция ДолгОбъектаРасчетов(ИмяРегистра, Объект, ДокОбъект)
	Если Не ДокОбъект.ДополнительныеСвойства.Свойство("ЗакрытоСтрокамиОплаты") Тогда
		ДокОбъект.ДополнительныеСвойства.Вставить("ЗакрытоСтрокамиОплаты", Новый Соответствие);
	КонецЕсли;
	Остаток = ОстатокОбъектаРасчетов(ИмяРегистра, Объект, ДокОбъект);
	Знак = ?(СтрНайти(ИмяРегистра, "СПокупател") > 0, 1, -1);
	Долг = Новый Структура("Сумма, СуммаВВалюте", Знак * Остаток.Сумма, Знак * Остаток.СуммаВВалюте);
	Закрыто = ДокОбъект.ДополнительныеСвойства.ЗакрытоСтрокамиОплаты.Получить(Объект);
	Если Закрыто <> Неопределено Тогда
		Долг.Сумма = Долг.Сумма - Закрыто.Сумма;
		Долг.СуммаВВалюте = Долг.СуммаВВалюте - Закрыто.СуммаВВалюте;
	КонецЕсли;
	Возврат Долг;
КонецФункции

// Остаток объекта расчётов до платёжного документа, со знаком регистра.
//
// Параметры:
//  ИмяРегистра - Строка - ВзаиморасчётыСПокупателями или ВзаиморасчётыСПоставщиками.
//  Объект - ДокументСсылка - объект расчётов.
//  ДокОбъект - ДокументОбъект - платёжный документ (граница остатков).
//
// Возвращаемое значение:
//  Структура - Сумма (основная валюта), СуммаВВалюте.
//
Функция ОстатокОбъектаРасчетов(ИмяРегистра, Объект, ДокОбъект)
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Сумма,
	|	ЕСТЬNULL(СУММА(Остатки.СуммаВВалютеОстаток), 0) КАК СуммаВВалюте
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(&Граница, ОбъектРасчётов = &Объект) КАК Остатки";
	Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "ВзаиморасчётыСПокупателями", ИмяРегистра));
	Запрос.УстановитьПараметр("Граница", РаботаСДокументамиВызовСервера.ПолучитьГраницуДокумента(ДокОбъект));
	Запрос.УстановитьПараметр("Объект", Объект);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Новый Структура("Сумма, СуммаВВалюте", Выборка.Сумма, Выборка.СуммаВВалюте);
КонецФункции

// Ошибки валюты проводимого платёжного документа (см. ПроверитьВалютуПлатежа).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёжный документ.
//  ВалютаДокумента - Структура - см. ВалютаИКурсДокумента.
//
// Возвращаемое значение:
//  Массив из Строка - тексты ошибок.
//
Функция ОшибкиВалютыПлатежа(ДокОбъект, ВалютаДокумента)
	Ошибки = Новый Массив;
	ВалютаМеста = ВалютаМестаХранения(МестоХраненияПлатежа(ДокОбъект));
	Если ВалютаМеста <> ВалютаДокумента.Валюта Тогда
		Шаблон = НСтр("ru = 'Валюта документа %1 не совпадает с валютой кассы или счёта %2: выберите кассу или счёт заново.';
			|fr = 'La devise du document %1 ne correspond pas à celle de la caisse ou du compte %2 : choisissez à nouveau la caisse ou le compte.';
			|en = 'Document currency %1 does not match cash desk or account currency %2: select the cash desk or account again.';
			|es = 'La moneda del documento %1 no coincide con la de la caja o cuenta %2: vuelva a elegir la caja o la cuenta.'");
		Ошибки.Добавить(СтрШаблон(Шаблон, ВалютаДокумента.Валюта, ВалютаМеста));
	КонецЕсли;
	Операция = ДокОбъект.ХозяйственнаяОперация;
	Внутренняя = ВнутреннееПеремещениеДенег(Операция);
	Если Внутренняя И ВалютаМестаХранения(ВтороеМестоХранения(ДокОбъект)) <> ВалютаМеста Тогда
		Ошибки.Добавить(НСтр("ru = 'Касса и банковский счёт перемещения должны быть в одной валюте: обмен валюты не поддерживается.';
			|fr = 'La caisse et le compte bancaire du transfert doivent être dans la même devise : le change n''est pas pris en charge.';
			|en = 'The cash desk and bank account of a transfer must be in the same currency: currency exchange is not supported.';
			|es = 'La caja y la cuenta bancaria del traspaso deben estar en la misma moneda: el cambio de divisas no se admite.'"));
	КонецЕсли;
	Если Не ВалютаДокумента.ВВалюте Тогда
		Возврат Ошибки;
	КонецЕсли;
	Если ДокОбъект.КурсВалюты <= 0 Тогда
		Шаблон = НСтр("ru = 'Не указан курс валюты %1.'; fr = 'Le taux de change de %1 n''est pas indiqué.';
			|en = 'The %1 exchange rate is not specified.'; es = 'No se indica el tipo de cambio de %1.'");
		Ошибки.Добавить(СтрШаблон(Шаблон, ДокОбъект.Валюта));
	КонецЕсли;
	Если Не Внутренняя И Не ОперацияОплатыВВалюте(ДокОбъект) Тогда
		Ошибки.Добавить(НСтр("ru = 'В валюте проводятся только оплаты клиентам и поставщикам (не чеком) и перемещения денег.';
			|fr = 'En devise, seuls les paiements clients et fournisseurs (hors chèque) et les transferts de fonds sont validés.';
			|en = 'Only customer and supplier payments (not by cheque) and cash transfers can be posted in a foreign currency.';
			|es = 'En moneda solo se contabilizan pagos de clientes y proveedores (sin cheque) y traspasos de fondos.'"));
	КонецЕсли;
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект, "КассоваяСмена") И ЗначениеЗаполнено(ДокОбъект.КассоваяСмена) Тогда
		Ошибки.Добавить(НСтр("ru = 'Кассовая смена ведётся только по кассе в основной валюте.';
			|fr = 'La session de caisse ne fonctionne qu''avec une caisse en devise principale.';
			|en = 'A cash session works only with a cash desk in the base currency.';
			|es = 'El turno de caja solo funciona con una caja en la moneda principal.'"));
	КонецЕсли;
	Возврат Ошибки;
КонецФункции

// Операция платёжного документа, допустимая в валюте: расчёты с клиентами или поставщиками, кроме сертификата
// и списания задолженности (обе в списках и клиентов, и поставщиков) и оплаты чеком (регистр чеков - в основной).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёжный документ.
//
// Возвращаемое значение:
//  Булево - Истина для допустимой операции.
//
Функция ОперацияОплатыВВалюте(ДокОбъект)
	Операция = ДокОбъект.ХозяйственнаяОперация;
	Если Операция = Перечисления.ХозяйственныеОперации.Сертификат
		Или Операция = Перечисления.ХозяйственныеОперации.СписаниеЗадолженности
		Или ДокОбъект.ТипОплаты = Справочники.TypesDePayment.Cheque Тогда
		Возврат Ложь;
	КонецЕсли;
	// BSLLS:YoLetterUsage-off - имена существующих функций
	Возврат ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПокупателями(Операция)
		Или ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПоставщиками(Операция);
	// BSLLS:YoLetterUsage-on
КонецФункции

// Перемещение денег между кассами и счетами организации: инкассация, обналичивание чека, приход из кассы.
//
// Параметры:
//  Операция - ПеречислениеСсылка.ХозяйственныеОперации - операция документа.
//
// Возвращаемое значение:
//  Булево - Истина для перемещения.
//
Функция ВнутреннееПеремещениеДенег(Операция)
	Возврат Операция = Перечисления.ХозяйственныеОперации.Инкассация
		Или Операция = Перечисления.ХозяйственныеОперации.ОбналичиваниеЧека
		Или Операция = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствИзКассы;
КонецФункции

// Вторая сторона перемещения: касса инкассации и обналичивания, касса-источник ПКО «из кассы»,
// у списания безналичных - сам счёт.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёжный документ перемещения.
//
// Возвращаемое значение:
//  СправочникСсылка.Кассы, СправочникСсылка.БанковскиеСчета - вторая сторона.
//
Функция ВтороеМестоХранения(ДокОбъект)
	Если ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствИзКассы Тогда
		Возврат ДокОбъект.КассаИз;
	КонецЕсли;
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект, "Касса") Тогда
		Возврат ДокОбъект.Касса;
	КонецЕсли;
	// Списание: чек при обналичивании приходуется на тот же счёт.
	Возврат МестоХраненияПлатежа(ДокОбъект);
КонецФункции

Функция ВалютаИКурсПоРеквизитам(Валюта, Курс, ВВалюте)
	Основная = ОсновнаяВалюта();
	Результат = Новый Структура("Валюта, Курс, ВВалюте", Основная, 1, Ложь);
	Если ВВалюте = Ложь Или Не ЗначениеЗаполнено(Валюта) Или Валюта = Основная Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Валюта = Валюта;
	Результат.Курс = ?(Курс > 0, Курс, 1);
	Результат.ВВалюте = Истина;
	Возврат Результат;
КонецФункции

#КонецОбласти
