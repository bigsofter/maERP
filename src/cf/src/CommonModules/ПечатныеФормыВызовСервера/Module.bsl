////////////////////////////////////////////////////////////////////////////////
// Серверные вызовы подсистемы печатных форм: тонкие обёртки над ядром
// (ПечатныеФормы) для клиентского кода.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Формирует печатные формы для печати без предварительного просмотра.
//
// Параметры:
//  ИмяМенеджераПечати - Строка    - полное имя объекта, чей модуль менеджера печатает
//  ИменаМакетов       - Строка    - имена макетов через запятую
//  МассивОбъектов     - Массив    - ссылки на печатаемые объекты
//  ПараметрыПечати    - Структура - произвольные параметры для модуля менеджера
//
// Возвращаемое значение:
//  Массив из ТабличныйДокумент - сформированные печатные формы
//
Функция ТабличныеДокументы(ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати = Неопределено) Экспорт

	Результат = ПечатныеФормы.СформироватьПечатныеФормы(ИмяМенеджераПечати, ИменаМакетов,
		МассивОбъектов, ПараметрыПечати);

	ТабличныеДокументы = Новый Массив;
	Для Каждого ПечатнаяФорма Из Результат.КоллекцияПечатныхФорм Цикл
		Если ТипЗнч(ПечатнаяФорма.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
			ТабличныеДокументы.Добавить(ПечатнаяФорма.ТабличныйДокумент);
		КонецЕсли;
	КонецЦикла;

	Возврат ТабличныеДокументы;

КонецФункции

#КонецОбласти
