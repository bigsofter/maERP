КонецФункции

// Заполняет в форме документа показатели финансового результата по оборотам регистра Продажи:
// Себестоимость (включая издержки), Выручка без НДС, Прибыль и Наценка (%). Для налоговой накладной
// обороты берутся по основанию-реализации и отгрузкам из табличной части.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма РеализацияТоваровУслуг или НалоговаяНакладная
//          с реквизитами Себестоимость, Выручка, Прибыль, Наценка.
//
Процедура ЗаполнитьФинРезультат(Форма) Экспорт
	Объект = Форма.Объект;
	МасДокументы = ДокументыПродажиДляФинРезультата(Объект);
	Себестоимость = 0;
	Выручка = 0;
	Если МасДокументы.Количество() > 0 Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ЕСТЬNULL(СУММА(ПродажиОбороты.СебестоимостьОборот), 0) КАК Себестоимость,
		                      |	ЕСТЬNULL(СУММА(ПродажиОбороты.ДополнительныеРасходыОборот), 0) КАК ДополнительныеРасходы,
		                      |	ЕСТЬNULL(СУММА(ПродажиОбороты.ВыручкаОборот), 0) КАК Выручка,
		                      |	ЕСТЬNULL(СУММА(ПродажиОбороты.НДСОборот), 0) КАК НДС
		                      |ИЗ
		                      |	РегистрНакопления.Продажи.Обороты(, , , ДокументПродажи В (&ДокументПродажи)) КАК ПродажиОбороты");
		Запрос.УстановитьПараметр("ДокументПродажи", МасДокументы);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Себестоимость = Выборка.Себестоимость + Выборка.ДополнительныеРасходы;
			Выручка = Выборка.Выручка - Выборка.НДС;
		КонецЕсли;
	КонецЕсли;
	Форма.Себестоимость = Себестоимость;
	Форма.Выручка = Выручка;
	Форма.Прибыль = Выручка - Себестоимость;
	Форма.Наценка = ?(Себестоимость = 0, 0,
		(Выручка - Себестоимость) / Себестоимость * РаботаСДокументамиКлиентСервер.СтоПроцентов());
КонецПроцедуры

Функция ДокументыПродажиДляФинРезультата(Объект)
	// Документы продажи, обороты которых образуют финансовый результат формы.
	МасДокументы = Новый Массив;
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		МасДокументы.Добавить(Объект.Ссылка);
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.НалоговаяНакладная") Тогда
		Если ЗначениеЗаполнено(Объект.Основание) Тогда
			МасДокументы.Добавить(Объект.Основание);
		КонецЕсли;
		Для Каждого Стр Из Объект.ТЧТовары Цикл
			Если ЗначениеЗаполнено(Стр.ОтгрузкаТовара) И МасДокументы.Найти(Стр.ОтгрузкаТовара) = Неопределено Тогда
				МасДокументы.Добавить(Стр.ОтгрузкаТовара);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Возврат МасДокументы;
	КонецЕсли;
	Возврат МасДокументы;
КонецФункции

#КонецОбласти 

