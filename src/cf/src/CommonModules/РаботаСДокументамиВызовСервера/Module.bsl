Функция ПолучитьГраницуДокумента(Знач ДокОбъект) Экспорт
	Ссылка = ДокОбъект.Ссылка;
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Если ДокОбъект.Дата = Ссылка.Дата Тогда		
			Возврат Новый Граница(Ссылка.МоментВремени(), ВидГраницы.Исключая);
		Иначе
			Возврат Новый Граница(ДокОбъект.Дата, ВидГраницы.Исключая);	
		КонецЕсли;	
	Иначе
		Возврат ТекущаяДатаСеанса();	
	КонецЕсли;			
КонецФункции	

