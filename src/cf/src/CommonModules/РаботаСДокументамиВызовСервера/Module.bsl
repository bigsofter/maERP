Функция КоличествоЕдиницыТолькоЦелое(Номенклатура, Упаковка) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Единица КАК Единица
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВЫБОР
	                      |			КОГДА &Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	                      |				ТОГДА ВЫРАЗИТЬ(&Номенклатура КАК Справочник.Номенклатура).Единица
	                      |			ИНАЧЕ ВЫРАЗИТЬ(&Упаковка КАК Справочник.УпаковкиЕдиницыИзмерения).Единица
	                      |		КОНЕЦ КАК Единица) КАК ВЗ
	                      |ГДЕ
	                      |	ВЗ.Единица.ТипИзмеряемойВеличины В (ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук), ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Упаковка))");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Упаковка", Упаковка);
	Рез = Запрос.Выполнить();
	Возврат Не Рез.Пустой();			
КонецФункции	

#КонецОбласти  

