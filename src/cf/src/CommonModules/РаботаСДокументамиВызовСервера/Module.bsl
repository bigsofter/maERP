Функция ПолучитьНепоказанныеСистемныеОповещения() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Результат = Новый Массив;	
	ТЗ = РегистрыСведений.СистемныеОповещения.ПолучитьНеотображённые(ПараметрыСеанса.Пользователь);
	Для Каждого Стр Из ТЗ Цикл
		Результат.Добавить(Новый Структура("Описание, НавигационнаяСсылка", Стр.Описание, Стр.НавигационнаяСсылка));
		РегистрыСведений.СистемныеОповещения.ОтметитьКакОтображённое(Стр.Сотрудник, Стр.ID);
	КонецЦикла;	
	Возврат Результат; 
КонецФункции

Функция ПолучитьСуммуОснованияДляПлатёжногоДокумента(Документ) Экспорт
	Если ТипЗнч(Документ) = Тип("СправочникСсылка.Контрагенты") Тогда
		СуммаДокумента = 0;
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.КорректировкаДолга") Тогда
		СуммаДокумента = 0;	
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ПлатёжнаяВедомостьНаАванс") 
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.ВыплатаЗарплаты") Тогда
		СуммаДокумента = Документ.Сумма-ДенежныеСредства.ПолучитьОстатокВыплатыЗПОснованию(Документ,Истина);
	Иначе	
		СуммаДокумента = Документ.Сумма;
	КонецЕсли;	
	Результат = Новый Структура("Сумма, СтавкаНДС, СуммаНДС, НесколькоСтавокНДС, РасшифровкаНДС", СуммаДокумента,, 0, Ложь, ""); 
	МасРасшифровкаНДС = Новый Массив;
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Или
		ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг")  Тогда
		ТЗ = Документ.ТЧТовары.Выгрузить(, "СтавкаНДС, СуммаНДС, СуммаСНДС");
		ТЗ.Свернуть("СтавкаНДС", "СуммаНДС, СуммаСНДС");
		Если ТЗ.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(Результат, ТЗ[0], "СтавкаНДС, СуммаНДС");
		ИначеЕсли ТЗ.Количество() > 1 Тогда	
			Результат.СуммаНДС = ТЗ.Итог("СуммаНДС");
			Результат.НесколькоСтавокНДС = Истина;
			МасРасшифровкаНДС = РаботаСДокументами.КонвертироватьНДСПлатёжногоДокументаВМассив(ТЗ);	
		КонецЕсли;
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") Или 
		ТипЗнч(Документ) = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") Или
		ТипЗнч(Документ) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Или
		ТипЗнч(Документ) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		Результат.Сумма = Документ.Сумма;	
	КонецЕсли;
	Результат.РасшифровкаНДС = ОбщегоНазначенияКлиентСервер.КонвертироватьВJSON(МасРасшифровкаНДС);
	Возврат Результат;	
КонецФункции	

