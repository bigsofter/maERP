////////////////////////////////////////////////////////////////////////////////
// Точка входа механизма обновления при начале работы системы.
//
// Клиентский код (ОбновлениеПрограммыКлиент) обращается сюда одним вызовом:
// сервер сам решает, требуется ли обновление, кто его выполняет и нужно ли
// показывать описание изменений.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет и при необходимости выполняет обновление данных информационной базы.
// Обновление выполняет первый вошедший пользователь с правом администрирования;
// остальным до завершения обновления вход в программу запрещается.
//
// Возвращаемое значение:
//  Структура - что делать клиенту:
//   * ПродолжитьРаботу         - Булево - Ложь, если работу нужно завершить
//   * Сообщение                - Строка - текст для пользователя; пустая строка - сообщать нечего
//   * ПоказатьОписаниеИзменений - Булево - открыть окно "Что нового"
//   * ВерсияОписанияИзменений  - Строка - версия, начиная с которой показывать описание изменений
//
Функция ОбработатьНачалоРаботы() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ПродолжитьРаботу", Истина);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("ПоказатьОписаниеИзменений", Ложь);
	Результат.Вставить("ВерсияОписанияИзменений", "");

	Если ОбновлениеПрограммы.ТребуетсяОбновление() Тогда

		Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
			Результат.ПродолжитьРаботу = Ложь;
			Результат.Сообщение = НСтр("ru = 'Выполняется обновление программы. Вход в программу будет возможен после его завершения.';
				|fr = 'La mise à jour du programme est en cours. La connexion sera possible après son achèvement.';
				|en = 'The application is being updated. You will be able to sign in after the update is completed.';
				|es = 'Se está actualizando el programa. El inicio de sesión será posible después de su finalización.'");
			Возврат Результат;
		КонецЕсли;

		Обновление = ОбновлениеПрограммы.ВыполнитьОбновление();
		Если Не Обновление.Выполнено Тогда
			Результат.ПродолжитьРаботу = Ложь;
			ШаблонСообщения = НСтр("ru = 'Не удалось обновить данные программы.
				|%1
				|Подробности - в журнале регистрации, событие ""Обновление программы"".';
				|fr = 'Impossible de mettre à jour les données du programme.
				|%1
				|Détails - dans le journal d''enregistrement, événement « Mise à jour du programme ».';
				|en = 'Cannot update the application data.
				|%1
				|See details in the event log, the ""Application update"" event.';
				|es = 'No se pudo actualizar los datos del programa.
				|%1
				|Los detalles están en el registro de eventos, evento ""Actualización del programa"".'");
			Результат.Сообщение = СтрШаблон(ШаблонСообщения, Обновление.ОписаниеОшибки);
			Возврат Результат;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Обновление.ВерсияДо) Тогда
			// Новая база: показывать в ней историю изменений не за чем, описание считается просмотренным.
			ОбновлениеПрограммы.ЗапомнитьПоказанноеОписаниеИзменений();
			Возврат Результат;
		КонецЕсли;

	КонецЕсли;

	ОписаниеИзменений = ОбновлениеПрограммы.ПоказыватьОписаниеИзменений();
	Результат.ПоказатьОписаниеИзменений = ОписаниеИзменений.Показать;
	Результат.ВерсияОписанияИзменений = ОписаниеИзменений.ВерсияОт;
	Если ОписаниеИзменений.Показать Тогда
		// Отметка ставится здесь, а не в форме: открытие формы данные не меняет,
		// поэтому смок-тест безопасен и на рабочей базе.
		ОбновлениеПрограммы.ЗапомнитьПоказанноеОписаниеИзменений();
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
