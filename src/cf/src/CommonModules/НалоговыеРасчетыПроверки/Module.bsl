// Проверки налоговых накладных и платежей по ним (docs/plans/commerce-two-orgs.md): запрет накладной по основанию с
// проведёнными возвратами и сертификатами, неизменность накладной с зависимыми регистраторами (Ф1), обязательные
// проверки проведения платежей и накладной (Ф2, Ф3). Функции «Текст…» возвращают текст отказа без записи: ими же
// пользуются тесты - отказ записи в транзакции прогона ломает её.

#Область ПрограммныйИнтерфейс

#Область НакладнаяПоОснованиям

// Контрагенты оснований накладной - реализаций или поступлений - одним запросом: под ними накладная сторнирует долг
// оснований, и расчёты блокируются по ним до записи (Ф1).
//
// Параметры:
//  Основания - Массив из ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.ПоступлениеТоваровУслуг - основания.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты
//
Функция КонтрагентыОснований(Основания) Экспорт
	Если Основания.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - аналитики оснований читаются при записи накладной и платежа
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Реализация.Контрагент КАК Контрагент
	                      |ИЗ
	                      |	Документ.РеализацияТоваровУслуг КАК Реализация
	                      |ГДЕ
	                      |	Реализация.Ссылка В (&Основания)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Поступление.Контрагент
	                      |ИЗ
	                      |	Документ.ПоступлениеТоваровУслуг КАК Поступление
	                      |ГДЕ
	                      |	Поступление.Ссылка В (&Основания)");
	Запрос.УстановитьПараметр("Основания", Основания);
	Результат = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент"),
		Истина);
	Возврат Результат;
КонецФункции

// Контрагенты расчётов накладной для блокировки проведения: свой и контрагенты текущих и прежних оснований. Кладутся
// в ДополнительныеСвойства в ПередЗаписью, блокируются в ОбработкаПроведения (Ф1, Ф3.2 «Порядок блокировок»).
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//
Процедура ЗапомнитьКонтрагентовБлокировки(ДокОбъект, ИмяРеквизита) Экспорт
	Основания = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект, ИмяРеквизита).ВыгрузитьКолонку(ИмяКолонкиОснования());
	Если Не ДокОбъект.ЭтоНовый() Тогда
		Прежние = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект.Ссылка.ПолучитьОбъект(), ИмяРеквизита);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Основания, Прежние.ВыгрузитьКолонку(ИмяКолонкиОснования()), Истина);
	КонецЕсли;
	Контрагенты = КонтрагентыОснований(Основания);
	Контрагенты.Добавить(ДокОбъект.Контрагент);
	ДокОбъект.ДополнительныеСвойства.Вставить(ИмяСвойстваКонтрагентовБлокировки(), Контрагенты);
КонецПроцедуры

// Контрагенты блокировки расчётов документа, собранные до записи (см. ЗапомнитьКонтрагентовБлокировки и
// НалоговыеДокументыНаОснованиях.ПередЗаписьюПлатежа); без набора - один контрагент документа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ с реквизитом Контрагент.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты
//
Функция КонтрагентыБлокировки(ДокОбъект) Экспорт
	Контрагенты = Неопределено;
	Если ДокОбъект.ДополнительныеСвойства.Свойство(ИмяСвойстваКонтрагентовБлокировки(), Контрагенты) Тогда
		Результат = Новый Массив;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Контрагенты, Истина);
		Если Результат.Найти(ДокОбъект.Контрагент) = Неопределено Тогда
			Результат.Добавить(ДокОбъект.Контрагент);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокОбъект.Контрагент);
КонецФункции

// Имя свойства с набором контрагентов блокировки расчётов в ДополнительныеСвойства документа.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСвойстваКонтрагентовБлокировки() Экспорт
	Возврат "КонтрагентыБлокировкиРасчетов";
КонецФункции

// Отказ проведения накладной по основанию с проведёнными возвратами или сертификатами (Ф1, «Возвраты и сертификаты до
// накладной»): проверяется каждое новое основание (прежних движений переноса нет) и основание, чья покрытая сумма
// выросла. Вызывается в ПередЗаписью при проведении, после блокировки оснований - прежние движения ещё в базе.
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//  Отказ        - Булево - выставляется при запрете.
//
Процедура ПроверитьВозвратыДоНакладной(ДокОбъект, ИмяРеквизита, Отказ) Экспорт
	Текст = ТекстВозвратовДоНакладной(ДокОбъект, ИмяРеквизита);
	Если ЗначениеЗаполнено(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , , , Отказ);
	КонецЕсли;
КонецПроцедуры

// Текст отказа накладной по основаниям с проведёнными возвратами или сертификатами (см. ПроверитьВозвратыДоНакладной).
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//
// Возвращаемое значение:
//  Строка - пустая, если запрета нет.
//
Функция ТекстВозвратовДоНакладной(ДокОбъект, ИмяРеквизита) Экспорт
	// Накладная, которая по дате начала учёта взаиморасчётов расчёты не переносит, запрету не подлежит (Ф1, Ф5).
	Если Не ОтсечкаВзаиморасчетов.РасчетыПереносятсяОбъекта(ДокОбъект, ИмяРеквизита) Тогда
		Возврат "";
	КонецЕсли;
	Проверяемые = НовыеИлиВыросшиеОснования(ДокОбъект, ИмяРеквизита);
	Если Проверяемые.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - чужие возвраты и сертификаты читаются при записи накладной
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос;
	Если ИмяРеквизита = "ОтгрузкаТовара" Тогда
		// BSLLS:YoLetterUsage-off
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов КАК Основание,
		               |	Т.Регистратор КАК Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов В (&Основания)
		               |	И Т.Регистратор ССЫЛКА Документ.ВозвратОтПокупателя
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов,
		               |	Т.Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов В (&Основания)
		               |	И Т.Регистратор ССЫЛКА Документ.СертификатНаОплату";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов КАК Основание,
		               |	Т.Регистратор КАК Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов В (&Основания)
		               |	И Т.Регистратор ССЫЛКА Документ.ВозвратПоставщику
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов,
		               |	Т.Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов В (&Основания)
		               |	И Т.Регистратор ССЫЛКА Документ.СертификатНаОплату";
		// BSLLS:YoLetterUsage-on
	КонецЕсли;
	Запрос.УстановитьПараметр("Основания", Проверяемые);
	Выборка = Запрос.Выполнить().Выбрать();
	Строки = Новый Массив;
	Шаблон = НСтр("ru = 'По основанию %1 проведён документ %2 - налоговая накладная на него не проводится:
		|сначала накладная, потом возврат или сертификат.';
		|fr = 'Le document %2 est validé sur la base %1 - la facture fiscale ne se valide pas :
		|d''abord la facture, puis le retour ou le certificat.';
		|en = 'Document %2 is posted on basis %1 - the tax invoice cannot be posted:
		|first the invoice, then the return or certificate.';
		|es = 'El documento %2 está contabilizado sobre la base %1 - la factura fiscal no se contabiliza:
		|primero la factura, luego la devolución o el certificado.'");
	Пока Выборка.Следующий() Цикл
		Строки.Добавить(СтрШаблон(Шаблон, Выборка.Основание, Выборка.Регистратор));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Отказ изменения накладной, на которую записали расчёты другие документы (Ф1, «Неизменность накладной с зависимыми
// регистраторами»): их записи несут аналитики долга на момент проведения, перепроведение накладной их не обновляет.
// Запрещены смена контрагента, организации и договора, состава и сумм оснований, отмена проведения и пометка удаления.
// Перепроведение без изменений разрешено.
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//  РежимЗаписи  - РежимЗаписиДокумента - режим записи.
//  Отказ        - Булево - выставляется при запрете.
//
Процедура ПроверитьЗависимыеРегистраторы(ДокОбъект, ИмяРеквизита, РежимЗаписи, Отказ) Экспорт
	Текст = ТекстЗапретаПриЗависимыхРегистраторах(ДокОбъект, ИмяРеквизита, РежимЗаписи);
	Если ЗначениеЗаполнено(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , , , Отказ);
	КонецЕсли;
КонецПроцедуры

// Текст отказа записи накладной с зависимыми регистраторами (см. ПроверитьЗависимыеРегистраторы).
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//  РежимЗаписи  - РежимЗаписиДокумента, Неопределено - режим записи; Неопределено - удаление.
//
// Возвращаемое значение:
//  Строка - пустая, если запрета нет.
//
Функция ТекстЗапретаПриЗависимыхРегистраторах(ДокОбъект, ИмяРеквизита, РежимЗаписи) Экспорт
	Если ДокОбъект.ЭтоНовый() Тогда
		Возврат "";
	КонецЕсли;
	Изменение = ИзменениеНакладной(ДокОбъект, ИмяРеквизита, РежимЗаписи);
	Если Не ЗначениеЗаполнено(Изменение) Тогда
		Возврат "";
	КонецЕсли;
	ЗаблокироватьНакладную(ДокОбъект.Ссылка);
	Зависимые = ЗависимыеРегистраторыНакладной(ДокОбъект.Ссылка);
	Если Зависимые.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Представления = Новый Массив;
	Для Каждого Регистратор Из Зависимые Цикл
		Представления.Добавить(Строка(Регистратор));
	КонецЦикла;
	Шаблон = НСтр("ru = 'Накладная %1: %2 запрещено - на неё записали расчёты документы: %3. Сначала отмените их проведение.';
		|fr = 'Facture %1 : %2 est interdit - des documents y ont inscrit des règlements : %3. Annulez d''abord leur validation.';
		|en = 'Invoice %1: %2 is not allowed - settlements on it were recorded by: %3. Unpost them first.';
		|es = 'Factura %1: %2 está prohibido - registraron liquidaciones en ella: %3. Anule primero su contabilización.'");
	Возврат СтрШаблон(Шаблон, ДокОбъект.Ссылка, Изменение, СтрСоединить(Представления, "; "));
КонецФункции

// Зависимые регистраторы налоговой накладной: документы, кроме самой накладной и её документа удержания НДС, с
// записями в обычном или налоговом регистре расчётов на объект «накладная» - перенаправленные возвраты и сертификаты,
// прямые оплаты.
//
// Параметры:
//  Накладная - ДокументСсылка.НалоговаяНакладная, ДокументСсылка.НалоговаяНакладнаяПокупка - накладная.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция ЗависимыеРегистраторыНакладной(Накладная) Экспорт
	// BSLLS:SetPrivilegedMode-off - чужие движения читаются при записи накладной
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос;
	// BSLLS:YoLetterUsage-off
	Если ТипЗнч(Накладная) = Тип("ДокументСсылка.НалоговаяНакладная") Тогда
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.Регистратор КАК Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов = &Накладная
		               |	И НЕ Т.Регистратор В (&Исключая)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов = &Накладная
		               |	И НЕ Т.Регистратор В (&Исключая)";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.Регистратор КАК Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов = &Накладная
		               |	И НЕ Т.Регистратор В (&Исключая)";
	КонецЕсли;
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Накладная", Накладная);
	Запрос.УстановитьПараметр("Исключая", СобственныеРегистраторыНакладной(Накладная));
	Результат = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор"),
		Истина);
	// Прямая оплата накладной, целиком ушедшая в аванс платежа, движений на объект «накладная» не пишет: зависимость -
	// по движениям кассы платежей (ревью 2.0.17.24, круги 5 и 8).
	Платежи = ПроведенныеПлатежиПоНакладной(Накладная, СобственныеРегистраторыНакладной(Накладная));
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Платежи, Истина);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область УдержаниеНДС

// Обязательные проверки удержания НДС налоговой накладной (Ф2): ставка - только 75 или 100 %, у валютной накладной
// удержания нет. Вызывается из проверки заполнения (сообщение в форме) и из проведения после блокировок.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладная - накладная.
//  Отказ     - Булево - выставляется при ошибке.
//
Процедура ПроверитьУдержаниеНДСНакладной(ДокОбъект, Отказ) Экспорт
	Для Каждого Текст Из ОшибкиУдержанияНДС(ДокОбъект) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , , , Отказ);
	КонецЦикла;
КонецПроцедуры

// Ошибки удержания НДС налоговой накладной (см. ПроверитьУдержаниеНДСНакладной).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладная - накладная.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ОшибкиУдержанияНДС(ДокОбъект) Экспорт
	Ошибки = Новый Массив;
	// Историческая накладная пишется как есть: процент клиента сохраняется (Ф4).
	Если Не ДокОбъект.УдержаниеНДС Или ЭтоИсторическаяНакладная(ДокОбъект) Тогда
		Возврат Ошибки;
	КонецЕсли;
	Если Справочники.Контрагенты.ДопустимыеПроцентыУдержанияНДС().Найти(ДокОбъект.ПроцентУдержанияНДС) = Неопределено Тогда
		Ошибки.Добавить(НСтр("ru = 'Процент удержания НДС - только 75 или 100.';
			|fr = 'Le taux de retenue de TVA est de 75 ou 100 seulement.';
			|en = 'The VAT withholding rate is 75 or 100 only.';
			|es = 'El porcentaje de retención del IVA es solo 75 o 100.'"));
	КонецЕсли;
	Если ДокОбъект.ВВалюте Тогда
		Ошибки.Добавить(НСтр("ru = 'Удержание НДС у источника у налоговой накладной в валюте не поддерживается.';
			|fr = 'La retenue de TVA à la source n''est pas prise en charge pour une facture fiscale en devise.';
			|en = 'VAT withholding at source is not supported for a tax invoice in foreign currency.';
			|es = 'La retención del IVA en la fuente no se admite en una factura fiscal en divisa.'"));
	КонецЕсли;
	Возврат Ошибки;
КонецФункции

#КонецОбласти

#Область Платежи

// Контрагенты налоговых накладных (продажи и покупки) одним запросом - для набора блокировки расчётов платежа (Ф3.2).
//
// Параметры:
//  Накладные - Массив из ДокументСсылка.НалоговаяНакладная, ДокументСсылка.НалоговаяНакладнаяПокупка - накладные.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты
//
Функция КонтрагентыНакладных(Накладные) Экспорт
	Если Накладные.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - аналитики накладных читаются при записи платежа
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Н.Контрагент КАК Контрагент
	                      |ИЗ
	                      |	Документ.НалоговаяНакладная КАК Н
	                      |ГДЕ
	                      |	Н.Ссылка В (&Накладные)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Н.Контрагент
	                      |ИЗ
	                      |	Документ.НалоговаяНакладнаяПокупка КАК Н
	                      |ГДЕ
	                      |	Н.Ссылка В (&Накладные)");
	Запрос.УстановитьПараметр("Накладные", Накладные);
	Результат = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент"),
		Истина);
	Возврат Результат;
КонецФункции

// Обязательные проверки платежа по налоговым накладным (Ф3 «Где проверки»): вызываются в проведении после блокировок
// и в проверке заполнения - для сообщения в форме. Поступление от покупателя: сумма строк на накладную - не больше её
// налогового долга, реализация и её накладная - не в одном платеже. Возврат покупателю: основание-накладная запрещено
// (возврат переплаты - на основании исходного платежа), строки на исходный платёж - не больше его налогового аванса.
//
// Параметры:
//  Платеж - ДокументОбъект - ПКО, РКО, безналичные поступление или списание.
//  Отказ  - Булево - выставляется при ошибке.
//
Процедура ПроверитьПлатеж(Платеж, Отказ) Экспорт
	Для Каждого Текст Из ОшибкиПлатежа(Платеж) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , , , Отказ);
	КонецЦикла;
КонецПроцедуры

// Ошибки платежа по налоговым накладным (см. ПроверитьПлатеж).
//
// Параметры:
//  Платеж - ДокументОбъект - ПКО, РКО, безналичные поступление или списание.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ОшибкиПлатежа(Платеж) Экспорт
	Ошибки = Новый Массив;
	Входящий = ТипЗнч(Платеж) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер")
		Или ТипЗнч(Платеж) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств");
	// BSLLS:YoLetterUsage-off
	СПокупателями = ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПокупателями(Платеж.ХозяйственнаяОперация);
	СПоставщиками = ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПоставщиками(Платеж.ХозяйственнаяОперация);
	// BSLLS:YoLetterUsage-on
	Если СПоставщиками И Не Входящий Тогда
		// Зеркало у поставщиков: оплата накладной покупки разносится по долгу её поступлений.
		ДобавитьОшибкиОснованияИНакладной(Платеж, Ошибки, Истина);
	КонецЕсли;
	Если Не СПокупателями Тогда
		Возврат Ошибки;
	КонецЕсли;
	Если Входящий Тогда
		ДобавитьОшибкиНалоговогоЛимита(Платеж, Ошибки);
		ДобавитьОшибкиОснованияИНакладной(Платеж, Ошибки, Ложь);
	Иначе
		ДобавитьОшибкиВозвратаПоНакладной(Платеж, Ошибки);
		ДобавитьОшибкиВозвратаАванса(Платеж, Ошибки);
	КонецЕсли;
	Возврат Ошибки;
КонецФункции

// Исходные платежи покупателя, которые ведут налоговый аванс: организация с основным учётом и операция расчётов с
// покупателями - только такие пишут налоговые записи (ВзаиморасчётыСПокупателямиНалоговый.СформироватьДвижения).
// Возврат на основании такого платежа ограничен его авансом и уменьшает его; на основании прочих - не ограничен.
//
// Параметры:
//  Источники - Массив из ДокументСсылка.ПриходныйКассовыйОрдер, ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств -
//              исходные платежи строк возврата.
//
// Возвращаемое значение:
//  Соответствие - исходный платёж -> Структура (Организация, Контрагент): аналитики его налогового аванса.
//
Функция ИсточникиСНалоговымАвансом(Источники) Экспорт
	Результат = Новый Соответствие;
	Если Источники.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - реквизиты исходных платежей читаются при проведении возврата
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	П.Ссылка КАК Ссылка,
	                      |	П.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	                      |	П.Организация КАК Организация,
	                      |	П.Контрагент КАК Контрагент
	                      |ИЗ
	                      |	Документ.ПриходныйКассовыйОрдер КАК П
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Орг
	                      |		ПО П.Организация = Орг.Ссылка
	                      |ГДЕ
	                      |	П.Ссылка В (&Источники)
	                      |	И Орг.ОсновнойУчет
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	П.Ссылка,
	                      |	П.ХозяйственнаяОперация,
	                      |	П.Организация,
	                      |	П.Контрагент
	                      |ИЗ
	                      |	Документ.ПоступлениеБезналичныхДенежныхСредств КАК П
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Орг
	                      |		ПО П.Организация = Орг.Ссылка
	                      |ГДЕ
	                      |	П.Ссылка В (&Источники)
	                      |	И Орг.ОсновнойУчет");
	Запрос.УстановитьПараметр("Источники", Источники);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// BSLLS:YoLetterUsage-off
		Если ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПокупателями(Выборка.ХозяйственнаяОперация) Тогда
			Аналитики = Новый Структура("Организация, Контрагент", Выборка.Организация, Выборка.Контрагент);
			Результат.Вставить(Выборка.Ссылка, Аналитики);
		КонецЕсли;
		// BSLLS:YoLetterUsage-on
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Запоминает накладные из обычных движений проведённой версии платежа до их удаления перепроведением (вызывается
// подпиской перед записью): проверка возврата по накладной в проведении сравнивает с ними основания (ревью 2.0.17.24).
//
// Параметры:
//  Платеж - ДокументОбъект - ПКО, РКО, безналичные поступление или списание.
//
Процедура ЗапомнитьНакладныеВДвиженияхПлатежа(Платеж) Экспорт
	Платеж.ДополнительныеСвойства.Вставить(ИмяСвойстваНакладныхВДвижениях(), НакладныеВДвиженияхПлатежа(Платеж));
КонецПроцедуры

#КонецОбласти

#Область ИсторическаяНакладная

// Имя признака исторической (замороженной) накладной в ДополнительныеСвойства: ставится в ПередЗаписью, читается
// проведением (Ф4).
//
// Возвращаемое значение:
//  Строка
//
Функция СвойствоИсторическаяНакладная() Экспорт
	Возврат "ИсторическаяНакладная";
КонецФункции

// Историческая ли записываемая накладная (признак из ПередЗаписью).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - накладная.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоИсторическаяНакладная(ДокОбъект) Экспорт
	Признак = Неопределено;
	ДокОбъект.ДополнительныеСвойства.Свойство(СвойствоИсторическаяНакладная(), Признак);
	Возврат Признак = Истина;
КонецФункции

// Обход проверки закрытого периода только для неизменного документа (Ф4 «Закрытый период»): историческая накладная -
// отпечаток равен сохранённому при защите; обычная, перепроводимая подпиской оплат, - равен отпечатку версии в базе.
// Права пользователя не расширяются: изменить документ закрытого периода по-прежнему нельзя.
//
// Параметры:
//  ДокОбъект   - ДокументОбъект - накладная.
//  Историческая - Булево - накладная под защитой «ИсторическийНалоговыйДокумент».
//
// Возвращаемое значение:
//  Булево - Истина: данные не меняются, проверку закрытого периода можно не вызывать.
//
Функция ДанныеНеизменныПриПерепроведении(ДокОбъект, Историческая) Экспорт
	Если ДокОбъект.ЭтоНовый() Тогда
		Возврат Ложь;
	КонецЕсли;
	Отпечаток = ПеренесенныеДокументы.ОтпечатокДанных(ДокОбъект);
	Если Историческая Тогда
		Защита = ПеренесенныеДокументы.ЗаписьЗащиты(ДокОбъект.Ссылка);
		Возврат Защита <> Неопределено И Защита.ОтпечатокДанных = Отпечаток;
	КонецЕсли;
	Если Не ДокОбъект.ДополнительныеСвойства.Свойство(РаботаСДокументами.СвойствоТехническоеПерепроведение()) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПеренесенныеДокументы.ОтпечатокДанных(ДокОбъект.Ссылка.ПолучитьОбъект()) = Отпечаток;
КонецФункции

// Прежние движения исторической накладной - до удаления платформой (AutoDelete): проведение загружает их как есть
// (товар, обычные расчёты, деньги клиента), заново строятся только налоговый регистр и деньги организации.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект - историческая накладная.
//  ИменаРегистров - Строка - имена регистров накопления через запятую.
//
Процедура ЗапомнитьПрежниеДвижения(ДокОбъект, ИменаРегистров) Экспорт
	// BSLLS:SetPrivilegedMode-off - движения накладной читаются при её записи
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Прежние = Новый Соответствие;
	Для Каждого ИмяРегистра Из СтрРазделить(ИменаРегистров, ",", Ложь) Цикл
		Набор = РегистрыНакопления[СокрЛП(ИмяРегистра)].СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(ДокОбъект.Ссылка);
		Набор.Прочитать();
		Прежние.Вставить(СокрЛП(ИмяРегистра), Набор.Выгрузить());
	КонецЦикла;
	ДокОбъект.ДополнительныеСвойства.Вставить("ПрежниеДвижения", Прежние);
КонецПроцедуры

// Загружает в движения исторической накладной её прежние наборы (см. ЗапомнитьПрежниеДвижения).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - историческая накладная.
//
Процедура ВосстановитьПрежниеДвижения(ДокОбъект) Экспорт
	Прежние = Неопределено;
	Если Не ДокОбъект.ДополнительныеСвойства.Свойство("ПрежниеДвижения", Прежние) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Прежние Цикл
		Набор = ДокОбъект.Движения[КлючИЗначение.Ключ];
		Набор.Загрузить(КлючИЗначение.Значение);
		Набор.Записывать = Истина;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сумма строк платежа по основаниям заданного вида в основной валюте, свёрнутая по основанию.
//
// Параметры:
//  Платеж  - ДокументОбъект - платёж.
//  Типы    - Массив из Тип - типы оснований.
//
// Возвращаемое значение:
//  Соответствие - основание -> сумма.
//
Функция СуммыСтрокПоОснованиям(Платеж, Типы)
	Курс = РаботаСВалютами.ВалютаИКурсДокумента(Платеж).Курс;
	Результат = Новый Соответствие;
	Для Каждого Строка Из Платеж.ТЧОснования Цикл
		Если Типы.Найти(ТипЗнч(Строка.Основание)) = Неопределено Или Не ЗначениеЗаполнено(Строка.Основание) Тогда
			Продолжить;
		КонецЕсли;
		Прежняя = Результат.Получить(Строка.Основание);
		Сумма = РаботаСВалютамиКлиентСервер.СуммаРегл(Строка.Сумма, Курс);
		Результат.Вставить(Строка.Основание, ?(Прежняя = Неопределено, 0, Прежняя) + Сумма);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Ф3.1, «Налоговый контур»: сумма строк платежа на каждую накладную - не больше остатка её налогового долга без учёта
// самого платежа: долг накладной минус записи её снимка оплат и документа удержания, кроме записей этого платежа.
//
// Параметры:
//  Платеж - ДокументОбъект - поступление от покупателя.
//  Ошибки - Массив из Строка - дополняется.
//
Процедура ДобавитьОшибкиНалоговогоЛимита(Платеж, Ошибки)
	Суммы = СуммыСтрокПоОснованиям(Платеж, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Тип("ДокументСсылка.НалоговаяНакладная")));
	Если Суммы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Накладные = Новый Массив;
	Для Каждого КлючИЗначение Из Суммы Цикл
		Накладные.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	// BSLLS:SetPrivilegedMode-off - налоговый долг чужих накладных читается при проведении платежа
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	// BSLLS:YoLetterUsage-off
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Т.Регистратор КАК Накладная,
	                      |	ВЫБОР
	                      |		КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	                      |			ТОГДА Т.Сумма
	                      |		ИНАЧЕ -Т.Сумма
	                      |	КОНЕЦ КАК Долг
	                      |ПОМЕСТИТЬ ВТЗаписи
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	                      |ГДЕ
	                      |	Т.Регистратор В (&Накладные)
	                      |	И Т.ДокументДвижения <> &Платеж
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Удержание.Основание,
	                      |	-Т.Сумма
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УдержаниеНДСПокупателем КАК Удержание
	                      |		ПО Т.Регистратор = Удержание.Ссылка
	                      |ГДЕ
	                      |	Удержание.Основание В (&Накладные)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТЗаписи.Накладная КАК Накладная,
	                      |	СУММА(ВТЗаписи.Долг) КАК Долг
	                      |ИЗ
	                      |	ВТЗаписи КАК ВТЗаписи
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТЗаписи.Накладная
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Т.Регистратор КАК Накладная,
	                      |	СУММА(ВЫБОР
	                      |			КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                      |				ТОГДА Т.Сумма
	                      |			ИНАЧЕ -Т.Сумма
	                      |		КОНЕЦ) КАК Оплата
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	                      |ГДЕ
	                      |	Т.Регистратор В (&Накладные)
	                      |	И Т.ДокументДвижения = &Платеж
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Т.Регистратор");
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Накладные", Накладные);
	Запрос.УстановитьПараметр("Платеж", Платеж.Ссылка);
	Пакет = Запрос.ВыполнитьПакет();
	Долги = Пакет[1].Выгрузить();
	// Прежняя проведённая оплата платежом каждой накладной (снимок оплат накладной): предел проверяется только на
	// прирост - неизменный платёж перепроводится всегда, переплата после удержания - обычный аванс (ревью 2.0.17.24,
	// круг 7).
	ПрежниеОплаты = Пакет[2].Выгрузить();
	Шаблон = НСтр("ru = 'Оплата накладной %1 (%2) больше её налогового долга %3: уменьшите строку до долга накладной,
		|излишек оставьте нераспределённым в сумме документа.';
		|fr = 'Le paiement de la facture %1 (%2) dépasse sa dette fiscale %3 : réduisez la ligne à la dette de la facture,
		|laissez l''excédent non réparti dans le montant du document.';
		|en = 'Payment of invoice %1 (%2) exceeds its tax debt %3: reduce the line to the invoice debt,
		|leave the excess unallocated in the document amount.';
		|es = 'El pago de la factura %1 (%2) supera su deuda fiscal %3: reduzca la línea a la deuda de la factura,
		|deje el exceso sin repartir en el importe del documento.'");
	Допуск = 0.005;
	Для Каждого КлючИЗначение Из Суммы Цикл
		СтрокаДолга = Долги.Найти(КлючИЗначение.Ключ, "Накладная");
		Долг = ?(СтрокаДолга = Неопределено, 0, СтрокаДолга.Долг);
		СтрокаПрежней = ПрежниеОплаты.Найти(КлючИЗначение.Ключ, "Накладная");
		Прежняя = ?(СтрокаПрежней = Неопределено, 0, СтрокаПрежней.Оплата);
		Если КлючИЗначение.Значение > Долг + Допуск И КлючИЗначение.Значение > Прежняя + Допуск Тогда
			Текст = СтрШаблон(Шаблон, КлючИЗначение.Ключ, Формат(КлючИЗначение.Значение, "ЧДЦ=2"), Формат(Долг, "ЧДЦ=2; ЧН=0"));
			Ошибки.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Ф3.1, «Ограничения»: основание и его налоговая накладная в одном платеже гасили бы один долг дважды - реализация и
// накладная в поступлении от покупателя, поступление товаров и накладная покупки в оплате поставщику.
//
// Параметры:
//  Платеж  - ДокументОбъект - платёж.
//  Ошибки  - Массив из Строка - дополняется.
//  Покупка - Булево - накладные покупки и поступления (оплата поставщику); Ложь - продажи.
//
Процедура ДобавитьОшибкиОснованияИНакладной(Платеж, Ошибки, Покупка)
	Основания = Платеж.ТЧОснования.Выгрузить().ВыгрузитьКолонку("Основание");
	Накладные = РаботаСДокументами.ПроведенныеНалоговыеНакладные(Основания);
	Если Накладные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - состав накладных читается при проведении платежа
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Т.Ссылка КАК Накладная,
	                      |	Т.ОтгрузкаТовара КАК Основание
	                      |ИЗ
	                      |	Документ.НалоговаяНакладная.ТЧТовары КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка В (&Накладные)
	                      |	И Т.ОтгрузкаТовара В (&Основания)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Т.Ссылка,
	                      |	Т.ОтгрузкаТовара
	                      |ИЗ
	                      |	Документ.НалоговаяНакладная.ТЧУслуги КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка В (&Накладные)
	                      |	И Т.ОтгрузкаТовара В (&Основания)");
	Шаблон = НСтр("ru = 'Реализация %1 и её налоговая накладная %2 в одном платеже: оплатите одну из них.';
		|fr = 'La vente %1 et sa facture fiscale %2 sont dans un même paiement : payez l''une d''elles.';
		|en = 'Sale %1 and its tax invoice %2 are in one payment: pay one of them.';
		|es = 'La venta %1 y su factura fiscal %2 están en un mismo pago: pague una de ellas.'");
	Если Покупка Тогда
		Запрос.Текст = СтрЗаменить(СтрЗаменить(Запрос.Текст, "Документ.НалоговаяНакладная.", "Документ.НалоговаяНакладнаяПокупка."),
			"ОтгрузкаТовара", "ПоступлениеТовара");
		Шаблон = НСтр("ru = 'Поступление %1 и его налоговая накладная %2 в одном платеже: оплатите одно из них.';
			|fr = 'La réception %1 et sa facture fiscale %2 sont dans un même paiement : payez l''une d''elles.';
			|en = 'Receipt %1 and its tax invoice %2 are in one payment: pay one of them.';
			|es = 'La recepción %1 y su factura fiscal %2 están en un mismo pago: pague una de ellas.'");
	КонецЕсли;
	Запрос.УстановитьПараметр("Накладные", Накладные);
	Запрос.УстановитьПараметр("Основания", Основания);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ошибки.Добавить(СтрШаблон(Шаблон, Выборка.Основание, Выборка.Накладная));
	КонецЦикла;
КонецПроцедуры

// Ф3.1, «Возврат денег покупателю»: РКО и списание безналичных с новым основанием-накладной запрещены - переплата
// лежит авансом на исходном платеже, возврат оформляется на его основании.
//
// Параметры:
//  Платеж - ДокументОбъект - РКО или списание безналичных.
//  Ошибки - Массив из Строка - дополняется.
//
Процедура ДобавитьОшибкиВозвратаПоНакладной(Платеж, Ошибки)
	// Прежние - только основания проведённой версии (её движения на накладной): запись без проведения основание не
	// узаконивает. В проведении движения уже удалены (AutoDelete) - берётся снимок из ПередЗаписью.
	Прежние = НакладныеВДвиженияхПлатежа(Платеж);
	Снимок = Неопределено;
	Если Платеж.ДополнительныеСвойства.Свойство(ИмяСвойстваНакладныхВДвижениях(), Снимок) И ТипЗнч(Снимок) = Тип("Массив") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Прежние, Снимок, Истина);
	КонецЕсли;
	Шаблон = НСтр("ru = 'Возврат по налоговой накладной %1 не оформляется: возврат переплаты оформляется на основании
		|исходного платежа.';
		|fr = 'Le remboursement sur la facture fiscale %1 n''est pas possible : le remboursement du trop-perçu se fait
		|sur la base du paiement d''origine.';
		|en = 'A refund on tax invoice %1 is not allowed: an overpayment refund is entered on the basis of the original
		|payment.';
		|es = 'No se registra la devolución sobre la factura fiscal %1: la devolución del pago en exceso se registra
		|sobre la base del pago original.'");
	Для Каждого Строка Из Платеж.ТЧОснования Цикл
		Если ТипЗнч(Строка.Основание) = Тип("ДокументСсылка.НалоговаяНакладная") И ЗначениеЗаполнено(Строка.Основание)
			И Прежние.Найти(Строка.Основание) = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(Шаблон, Строка.Основание));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Ф3.1, «Возврат переплаты»: строки возврата на исходный платёж покупателя, свёрнутые по платежу, - не больше его
// налогового аванса без записей этого возврата (приход на объект «исходный платёж», ВзаиморасчётыСПокупателямиНалоговый).
//
// Параметры:
//  Платеж - ДокументОбъект - РКО или списание безналичных.
//  Ошибки - Массив из Строка - дополняется.
//
Процедура ДобавитьОшибкиВозвратаАванса(Платеж, Ошибки)
	Если Не Платеж.Организация.ОсновнойУчет Тогда
		Возврат;
	КонецЕсли;
	Типы = Новый Массив;
	Типы.Добавить(Тип("ДокументСсылка.ПриходныйКассовыйОрдер"));
	Типы.Добавить(Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств"));
	Суммы = СуммыСтрокПоОснованиям(Платеж, Типы);
	Если Суммы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Источники = Новый Массив;
	Для Каждого КлючИЗначение Из Суммы Цикл
		Источники.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Авансы = НалоговыеАвансыПлатежей(Источники, Платеж.Ссылка);
	Переплаты = НалоговыеПереплатыНакладных(Источники);
	СНалоговымАвансом = ИсточникиСНалоговымАвансом(Источники);
	Шаблон = НСтр("ru = 'Возврат по платежу %1 (%2) больше его налогового аванса %3.';
		|fr = 'Le remboursement sur le paiement %1 (%2) dépasse son avance fiscale %3.';
		|en = 'The refund on payment %1 (%2) exceeds its tax advance %3.';
		|es = 'La devolución sobre el pago %1 (%2) supera su anticipo fiscal %3.'");
	Допуск = 0.005;
	Для Каждого КлючИЗначение Из Суммы Цикл
		Если СНалоговымАвансом.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			// Платёж организации без основного учёта налоговых записей не пишет - ограничивать нечего.
			Продолжить;
		КонецЕсли;
		// Нет записей у платежа с налоговым учётом - аванса нет (весь платёж разнесён по накладным).
		Аванс = Авансы.Получить(КлючИЗначение.Ключ);
		Переплата = Переплаты.Получить(КлючИЗначение.Ключ);
		// Фактическая переплата накладных, оплаченных этим платежом, - тоже его аванс.
		Аванс = ?(Аванс = Неопределено, 0, Аванс) + ?(Переплата = Неопределено, 0, Переплата);
		Если КлючИЗначение.Значение > Аванс + Допуск Тогда
			Текст = СтрШаблон(Шаблон, КлючИЗначение.Ключ, Формат(КлючИЗначение.Значение, "ЧДЦ=2"), Формат(Аванс, "ЧДЦ=2; ЧН=0"));
			Ошибки.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ИмяСвойстваНакладныхВДвижениях()
	Возврат "НакладныеВДвиженияхПлатежа";
КонецФункции

// Налоговые накладные, на которые проведённая версия платежа записала обычные расчёты (возврат по накладной).
//
// Параметры:
//  Платеж - ДокументОбъект - РКО или списание безналичных.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.НалоговаяНакладная
//
Функция НакладныеВДвиженияхПлатежа(Платеж)
	Если Платеж.ЭтоНовый() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - движения платежа читаются при его проведении
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	// BSLLS:YoLetterUsage-off
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Т.ОбъектРасчётов КАК Накладная
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
	                      |ГДЕ
	                      |	Т.Регистратор = &Ссылка
	                      |	И Т.ОбъектРасчётов ССЫЛКА Документ.НалоговаяНакладная");
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Ссылка", Платеж.Ссылка);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Накладная");
КонецФункции

// Налоговые переплаты накладных, приходящиеся на исходные платежи: у накладной, оплаченной сверх налогового долга
// (снимок оплат и удержание больше долга), переплата относится к её платежам - сначала к прямым оплатам накладной,
// затем к прочим, от поздних к ранним, - не больше оплаты каждого (ревью 2.0.17.24, круг 8). Обычный аванс такого
// платежа - та же переплата, поэтому её можно вернуть по исходному платежу.
//
// Параметры:
//  Источники - Массив из ДокументСсылка - исходные платежи.
//
// Возвращаемое значение:
//  Соответствие - платёж -> переплата (Число).
//
Функция НалоговыеПереплатыНакладных(Источники)
	// BSLLS:SetPrivilegedMode-off - снимки оплат чужих накладных читаются при проведении возврата
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	// BSLLS:YoLetterUsage-off
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Т.Регистратор КАК Накладная
	                      |ПОМЕСТИТЬ ВТНакладные
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	                      |ГДЕ
	                      |	Т.ОбъектРасчётов В (&Источники)
	                      |	И Т.Регистратор ССЫЛКА Документ.НалоговаяНакладная
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Т.Регистратор КАК Накладная,
	                      |	Т.ДокументДвижения КАК Платеж,
	                      |	МАКСИМУМ(Т.Период) КАК Период,
	                      |	СУММА(ВЫБОР
	                      |			КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                      |				ТОГДА Т.Сумма
	                      |			ИНАЧЕ -Т.Сумма
	                      |		КОНЕЦ) КАК Оплата
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	                      |ГДЕ
	                      |	Т.Регистратор В
	                      |			(ВЫБРАТЬ
	                      |				ВТНакладные.Накладная КАК Накладная
	                      |			ИЗ
	                      |				ВТНакладные КАК ВТНакладные)
	                      |	И Т.ДокументДвижения <> Т.Регистратор
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Т.Регистратор,
	                      |	Т.ДокументДвижения
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТЗаписи.Накладная КАК Накладная,
	                      |	СУММА(ВТЗаписи.Долг) КАК Долг
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		Т.Регистратор КАК Накладная,
	                      |		ВЫБОР
	                      |			КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	                      |				ТОГДА Т.Сумма
	                      |			ИНАЧЕ -Т.Сумма
	                      |		КОНЕЦ КАК Долг
	                      |	ИЗ
	                      |		РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	                      |	ГДЕ
	                      |		Т.Регистратор В
	                      |				(ВЫБРАТЬ
	                      |					ВТНакладные.Накладная КАК Накладная
	                      |				ИЗ
	                      |					ВТНакладные КАК ВТНакладные)
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		Удержание.Основание,
	                      |		-Т.Сумма
	                      |	ИЗ
	                      |		РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	                      |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УдержаниеНДСПокупателем КАК Удержание
	                      |			ПО Т.Регистратор = Удержание.Ссылка
	                      |	ГДЕ
	                      |		Удержание.Основание В
	                      |				(ВЫБРАТЬ
	                      |					ВТНакладные.Накладная КАК Накладная
	                      |				ИЗ
	                      |					ВТНакладные КАК ВТНакладные)) КАК ВТЗаписи
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТЗаписи.Накладная
	                      |
	                      |ИМЕЮЩИЕ
	                      |	СУММА(ВТЗаписи.Долг) < 0
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Т.ДокументПродажи КАК Накладная,
	                      |	Т.Регистратор КАК Платеж
	                      |ИЗ
	                      |	РегистрНакопления.ДвиженияПоКассе КАК Т
	                      |ГДЕ
	                      |	Т.ДокументПродажи В
	                      |			(ВЫБРАТЬ
	                      |				ВТНакладные.Накладная КАК Накладная
	                      |			ИЗ
	                      |				ВТНакладные КАК ВТНакладные)");
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Источники", Источники);
	Пакет = Запрос.ВыполнитьПакет();
	Оплаты = Пакет[1].Выгрузить();
	Переплаченные = Пакет[2].Выгрузить();
	Прямые = Пакет[3].Выгрузить();
	Оплаты.Колонки.Добавить("Прямая", Новый ОписаниеТипов("Число"));
	Для Каждого СтрокаОплаты Из Оплаты Цикл
		Отбор = Новый Структура("Накладная, Платеж", СтрокаОплаты.Накладная, СтрокаОплаты.Платеж);
		СтрокаОплаты.Прямая = ?(Прямые.НайтиСтроки(Отбор).Количество() > 0, 1, 0);
	КонецЦикла;
	Результат = Новый Соответствие;
	Для Каждого СтрокаНакладной Из Переплаченные Цикл
		ОплатыНакладной = Оплаты.Скопировать(Новый Структура("Накладная", СтрокаНакладной.Накладная));
		ОплатыНакладной.Сортировать("Прямая Убыв, Период Убыв");
		Остаток = -СтрокаНакладной.Долг;
		Для Каждого СтрокаОплаты Из ОплатыНакладной Цикл
			Если Остаток <= 0 Тогда
				Прервать;
			КонецЕсли;
			Часть = Мин(Остаток, Макс(СтрокаОплаты.Оплата, 0));
			Прежняя = Результат.Получить(СтрокаОплаты.Платеж);
			Результат.Вставить(СтрокаОплаты.Платеж, ?(Прежняя = Неопределено, 0, Прежняя) + Часть);
			Остаток = Остаток - Часть;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Налоговый аванс платежей покупателя: минус записи самого платежа и возвратов по объекту «платёж», без исключаемого
// возврата. Записи снимка оплат налоговых накладных (тот же объект - регистратор оплаты) в аванс не входят.
//
// Параметры:
//  Источники - Массив из ДокументСсылка - исходные платежи.
//  Исключая  - ДокументСсылка - проводимый возврат.
//
// Возвращаемое значение:
//  Соответствие - платёж -> аванс (только платежи с налоговыми записями).
//
Функция НалоговыеАвансыПлатежей(Источники, Исключая)
	// BSLLS:SetPrivilegedMode-off - налоговые записи исходных платежей читаются при проведении возврата
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	// BSLLS:YoLetterUsage-off
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Т.ОбъектРасчётов КАК Платеж,
	                      |	СУММА(ВЫБОР
	                      |			КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	                      |				ТОГДА -Т.Сумма
	                      |			ИНАЧЕ Т.Сумма
	                      |		КОНЕЦ) КАК Аванс
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	                      |ГДЕ
	                      |	Т.ОбъектРасчётов В (&Источники)
	                      |	И Т.Регистратор <> &Исключая
	                      |	И НЕ Т.Регистратор ССЫЛКА Документ.НалоговаяНакладная
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Т.ОбъектРасчётов");
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Источники", Источники);
	Запрос.УстановитьПараметр("Исключая", Исключая);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Платеж, Выборка.Аванс);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОснованияРазличаются(Текущие, Прежние)
	Различаются = Текущие.Количество() <> Прежние.Количество();
	Для Каждого СтрокаОснования Из Текущие Цикл
		Прежняя = Прежние.Найти(СтрокаОснования.Основание, ИмяКолонкиОснования());
		Различаются = Различаются Или Прежняя = Неопределено Или Прежняя.Сумма <> СтрокаОснования.Сумма;
	КонецЦикла;
	Возврат Различаются;
КонецФункции

// Основания накладной, которые она переносит впервые или в большей сумме, чем прежде: у нового основания нет прежних
// движений переноса (регистратор - накладная, объект - основание), у выросшего покрытая сумма больше прежней.
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция НовыеИлиВыросшиеОснования(ДокОбъект, ИмяРеквизита)
	Текущие = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект, ИмяРеквизита);
	Результат = Новый Массив;
	Если Текущие.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если ДокОбъект.ЭтоНовый() Тогда
		Возврат Текущие.ВыгрузитьКолонку(ИмяКолонкиОснования());
	КонецЕсли;
	Прежние = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект.Ссылка.ПолучитьОбъект(), ИмяРеквизита);
	Перенесенные = ОснованияСДвижениямиПереноса(ДокОбъект.Ссылка, Текущие.ВыгрузитьКолонку(ИмяКолонкиОснования()), ИмяРеквизита);
	Для Каждого Строка Из Текущие Цикл
		Прежняя = Прежние.Найти(Строка.Основание, ИмяКолонкиОснования());
		Если Перенесенные.Найти(Строка.Основание) = Неопределено Или Прежняя = Неопределено
			Или Строка.Сумма > Прежняя.Сумма Тогда
			Результат.Добавить(Строка.Основание);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОснованияСДвижениямиПереноса(Накладная, Основания, ИмяРеквизита)
	// BSLLS:SetPrivilegedMode-off - движения накладной читаются при её записи
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос;
	// BSLLS:YoLetterUsage-off
	Если ИмяРеквизита = "ОтгрузкаТовара" Тогда
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов КАК Основание
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
		               |ГДЕ
		               |	Т.Регистратор = &Накладная
		               |	И Т.ОбъектРасчётов В (&Основания)";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов КАК Основание
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т
		               |ГДЕ
		               |	Т.Регистратор = &Накладная
		               |	И Т.ОбъектРасчётов В (&Основания)";
	КонецЕсли;
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Накладная", Накладная);
	Запрос.УстановитьПараметр("Основания", Основания);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(ИмяКолонкиОснования());
КонецФункции

// Итог строк накладной с НДС - товары и услуги, в том числе строки без основания.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//
// Возвращаемое значение:
//  Число
//
Функция ИтогСтрокНакладной(ДокОбъект)
	Возврат ДокОбъект.ТЧТовары.Итог("СуммаСНДС") + ДокОбъект.ТЧУслуги.Итог("СуммаСНДС");
КонецФункции

// Что меняет запись накладной по сравнению с версией в базе - из перечня, запрещённого при зависимых регистраторах.
//
// Параметры:
//  ДокОбъект    - ДокументОбъект - накладная.
//  ИмяРеквизита - Строка - имя колонки основания.
//  РежимЗаписи  - РежимЗаписиДокумента, Неопределено - Неопределено - удаление.
//
// Возвращаемое значение:
//  Строка - представление изменения; пустая - запрещённых изменений нет.
//
Функция ИзменениеНакладной(ДокОбъект, ИмяРеквизита, РежимЗаписи)
	Если РежимЗаписи = Неопределено Тогда
		Возврат НСтр("ru = 'удаление'; fr = 'la suppression'; en = 'deletion'; es = 'la eliminación'");
	КонецЕсли;
	Прежний = ДокОбъект.Ссылка.ПолучитьОбъект();
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения И Прежний.Проведен Тогда
		Возврат НСтр("ru = 'отмена проведения'; fr = 'l''annulation de la validation'; en = 'unposting';
			|es = 'la anulación de la contabilización'");
	КонецЕсли;
	Если ДокОбъект.ПометкаУдаления И Не Прежний.ПометкаУдаления Тогда
		Возврат НСтр("ru = 'пометка удаления'; fr = 'la marque de suppression'; en = 'deletion mark';
			|es = 'la marca de eliminación'");
	КонецЕсли;
	// Смена даты через дату начала учёта взаиморасчётов: перенос был - переноса не будет, и обратно (Ф5).
	Если ОтсечкаВзаиморасчетов.РасчетыПереносятсяОбъекта(ДокОбъект, ИмяРеквизита)
		<> ОтсечкаВзаиморасчетов.РасчетыПереносятсяОбъекта(Прежний, ИмяРеквизита) Тогда
		Возврат НСтр("ru = 'перенос даты через дату начала учёта взаиморасчётов';
			|fr = 'le déplacement de la date au-delà de la date de début des règlements';
			|en = 'moving the date across the settlements start date';
			|es = 'el traslado de la fecha a través de la fecha de inicio de liquidaciones'");
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("Контрагент,Организация,Договор", ",") Цикл
		Если ДокОбъект[Имя] <> Прежний[Имя] Тогда
			Шаблон = НСтр("ru = 'смена реквизита «%1»'; fr = 'le changement de « %1 »'; en = 'changing ""%1""';
				|es = 'el cambio de «%1»'");
			Возврат СтрШаблон(Шаблон, ДокОбъект.Метаданные().Реквизиты[Имя].Представление());
		КонецЕсли;
	КонецЦикла;
	Текущие = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект, ИмяРеквизита);
	Прежние = РаботаСДокументами.ОснованияНалоговойНакладной(Прежний, ИмяРеквизита);
	// Строки без основания в таблицу оснований не входят - итог накладной сравнивается отдельно (ревью 2.0.17.24, круг 7).
	Если ОснованияРазличаются(Текущие, Прежние) Или ИтогСтрокНакладной(ДокОбъект) <> ИтогСтрокНакладной(Прежний) Тогда
		Возврат НСтр("ru = 'изменение оснований и их сумм'; fr = 'la modification des bases et de leurs montants';
			|en = 'changing bases and their amounts'; es = 'el cambio de las bases y sus importes'");
	КонецЕсли;
	Возврат "";
КонецФункции

// Регистраторы, которые пишут на объект «накладная» сами по себе: накладная и её документ удержания НДС.
//
// Параметры:
//  Накладная - ДокументСсылка - накладная.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция СобственныеРегистраторыНакладной(Накладная)
	Результат = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Накладная);
	Если ТипЗнч(Накладная) = Тип("ДокументСсылка.НалоговаяНакладная") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат,
			Документы.УдержаниеНДСПокупателем.ДокументыНакладной(Накладная));
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Проведённые документы с движениями кассы на накладную (документ продажи) - прямые оплаты, в том числе целиком
// ушедшие в аванс. По движениям, а не по табличной части: запись без проведения оплату не скрывает (ревью 2.0.17.24,
// круг 8).
//
// Параметры:
//  Накладная - ДокументСсылка.НалоговаяНакладная, ДокументСсылка.НалоговаяНакладнаяПокупка - накладная.
//  Исключая  - Массив из ДокументСсылка - собственные регистраторы накладной.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция ПроведенныеПлатежиПоНакладной(Накладная, Исключая)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Т.Регистратор КАК Платеж
	                      |ИЗ
	                      |	РегистрНакопления.ДвиженияПоКассе КАК Т
	                      |ГДЕ
	                      |	Т.ДокументПродажи = &Накладная
	                      |	И НЕ Т.Регистратор В (&Исключая)");
	Запрос.УстановитьПараметр("Накладная", Накладная);
	Запрос.УстановитьПараметр("Исключая", Исключая);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Платеж");
КонецФункции

// Колонка основания в таблице ОснованияНалоговойНакладной.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяКолонкиОснования()
	Возврат "Основание";
КонецФункции

Процедура ЗаблокироватьНакладную(Накладная)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Накладная.Метаданные().ПолноеИмя());
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Накладная);
	Блокировка.Заблокировать();
КонецПроцедуры

#КонецОбласти
