// Проверки налоговых накладных и платежей по ним (docs/plans/commerce-two-orgs.md): запрет накладной по основанию с
// проведёнными возвратами и сертификатами, неизменность накладной с зависимыми регистраторами (Ф1), обязательные
// проверки проведения платежей и накладной (Ф2, Ф3). Функции «Текст…» возвращают текст отказа без записи: ими же
// пользуются тесты - отказ записи в транзакции прогона ломает её.

#Область ПрограммныйИнтерфейс

#Область НакладнаяПоОснованиям

// Контрагенты оснований накладной - реализаций или поступлений - одним запросом: под ними накладная сторнирует долг
// оснований, и расчёты блокируются по ним до записи (Ф1).
//
// Параметры:
//  Основания - Массив из ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.ПоступлениеТоваровУслуг - основания.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты
//
Функция КонтрагентыОснований(Основания) Экспорт
	Если Основания.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - аналитики оснований читаются при записи накладной и платежа
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Реализация.Контрагент КАК Контрагент
	                      |ИЗ
	                      |	Документ.РеализацияТоваровУслуг КАК Реализация
	                      |ГДЕ
	                      |	Реализация.Ссылка В (&Основания)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Поступление.Контрагент
	                      |ИЗ
	                      |	Документ.ПоступлениеТоваровУслуг КАК Поступление
	                      |ГДЕ
	                      |	Поступление.Ссылка В (&Основания)");
	Запрос.УстановитьПараметр("Основания", Основания);
	Результат = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент"),
		Истина);
	Возврат Результат;
КонецФункции

// Контрагенты расчётов накладной для блокировки проведения: свой и контрагенты текущих и прежних оснований. Кладутся
// в ДополнительныеСвойства в ПередЗаписью, блокируются в ОбработкаПроведения (Ф1, Ф3.2 «Порядок блокировок»).
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//
Процедура ЗапомнитьКонтрагентовБлокировки(ДокОбъект, ИмяРеквизита) Экспорт
	Основания = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект, ИмяРеквизита).ВыгрузитьКолонку(ИмяКолонкиОснования());
	Если Не ДокОбъект.ЭтоНовый() Тогда
		Прежние = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект.Ссылка.ПолучитьОбъект(), ИмяРеквизита);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Основания, Прежние.ВыгрузитьКолонку(ИмяКолонкиОснования()), Истина);
	КонецЕсли;
	Контрагенты = КонтрагентыОснований(Основания);
	Контрагенты.Добавить(ДокОбъект.Контрагент);
	ДокОбъект.ДополнительныеСвойства.Вставить(ИмяСвойстваКонтрагентовБлокировки(), Контрагенты);
КонецПроцедуры

// Контрагенты блокировки расчётов документа, собранные до записи (см. ЗапомнитьКонтрагентовБлокировки и
// НалоговыеДокументыНаОснованиях.ПередЗаписьюПлатежа); без набора - один контрагент документа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ с реквизитом Контрагент.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты
//
Функция КонтрагентыБлокировки(ДокОбъект) Экспорт
	Контрагенты = Неопределено;
	Если ДокОбъект.ДополнительныеСвойства.Свойство(ИмяСвойстваКонтрагентовБлокировки(), Контрагенты) Тогда
		Результат = Новый Массив;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Контрагенты, Истина);
		Если Результат.Найти(ДокОбъект.Контрагент) = Неопределено Тогда
			Результат.Добавить(ДокОбъект.Контрагент);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокОбъект.Контрагент);
КонецФункции

// Имя свойства с набором контрагентов блокировки расчётов в ДополнительныеСвойства документа.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСвойстваКонтрагентовБлокировки() Экспорт
	Возврат "КонтрагентыБлокировкиРасчетов";
КонецФункции

// Отказ проведения накладной по основанию с проведёнными возвратами или сертификатами (Ф1, «Возвраты и сертификаты до
// накладной»): проверяется каждое новое основание (прежних движений переноса нет) и основание, чья покрытая сумма
// выросла. Вызывается в ПередЗаписью при проведении, после блокировки оснований - прежние движения ещё в базе.
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//  Отказ        - Булево - выставляется при запрете.
//
Процедура ПроверитьВозвратыДоНакладной(ДокОбъект, ИмяРеквизита, Отказ) Экспорт
	Текст = ТекстВозвратовДоНакладной(ДокОбъект, ИмяРеквизита);
	Если ЗначениеЗаполнено(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , , , Отказ);
	КонецЕсли;
КонецПроцедуры

// Текст отказа накладной по основаниям с проведёнными возвратами или сертификатами (см. ПроверитьВозвратыДоНакладной).
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//
// Возвращаемое значение:
//  Строка - пустая, если запрета нет.
//
Функция ТекстВозвратовДоНакладной(ДокОбъект, ИмяРеквизита) Экспорт
	Проверяемые = НовыеИлиВыросшиеОснования(ДокОбъект, ИмяРеквизита);
	Если Проверяемые.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - чужие возвраты и сертификаты читаются при записи накладной
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос;
	Если ИмяРеквизита = "ОтгрузкаТовара" Тогда
		// BSLLS:YoLetterUsage-off
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов КАК Основание,
		               |	Т.Регистратор КАК Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов В (&Основания)
		               |	И Т.Регистратор ССЫЛКА Документ.ВозвратОтПокупателя
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов,
		               |	Т.Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов В (&Основания)
		               |	И Т.Регистратор ССЫЛКА Документ.СертификатНаОплату";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов КАК Основание,
		               |	Т.Регистратор КАК Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов В (&Основания)
		               |	И Т.Регистратор ССЫЛКА Документ.ВозвратПоставщику
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов,
		               |	Т.Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов В (&Основания)
		               |	И Т.Регистратор ССЫЛКА Документ.СертификатНаОплату";
		// BSLLS:YoLetterUsage-on
	КонецЕсли;
	Запрос.УстановитьПараметр("Основания", Проверяемые);
	Выборка = Запрос.Выполнить().Выбрать();
	Строки = Новый Массив;
	Шаблон = НСтр("ru = 'По основанию %1 проведён документ %2 - налоговая накладная на него не проводится:
		|сначала накладная, потом возврат или сертификат.';
		|fr = 'Le document %2 est validé sur la base %1 - la facture fiscale ne se valide pas :
		|d''abord la facture, puis le retour ou le certificat.';
		|en = 'Document %2 is posted on basis %1 - the tax invoice cannot be posted:
		|first the invoice, then the return or certificate.';
		|es = 'El documento %2 está contabilizado sobre la base %1 - la factura fiscal no se contabiliza:
		|primero la factura, luego la devolución o el certificado.'");
	Пока Выборка.Следующий() Цикл
		Строки.Добавить(СтрШаблон(Шаблон, Выборка.Основание, Выборка.Регистратор));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Отказ изменения накладной, на которую записали расчёты другие документы (Ф1, «Неизменность накладной с зависимыми
// регистраторами»): их записи несут аналитики долга на момент проведения, перепроведение накладной их не обновляет.
// Запрещены смена контрагента, организации и договора, состава и сумм оснований, отмена проведения и пометка удаления.
// Перепроведение без изменений разрешено.
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//  РежимЗаписи  - РежимЗаписиДокумента - режим записи.
//  Отказ        - Булево - выставляется при запрете.
//
Процедура ПроверитьЗависимыеРегистраторы(ДокОбъект, ИмяРеквизита, РежимЗаписи, Отказ) Экспорт
	Текст = ТекстЗапретаПриЗависимыхРегистраторах(ДокОбъект, ИмяРеквизита, РежимЗаписи);
	Если ЗначениеЗаполнено(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , , , Отказ);
	КонецЕсли;
КонецПроцедуры

// Текст отказа записи накладной с зависимыми регистраторами (см. ПроверитьЗависимыеРегистраторы).
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//  РежимЗаписи  - РежимЗаписиДокумента, Неопределено - режим записи; Неопределено - удаление.
//
// Возвращаемое значение:
//  Строка - пустая, если запрета нет.
//
Функция ТекстЗапретаПриЗависимыхРегистраторах(ДокОбъект, ИмяРеквизита, РежимЗаписи) Экспорт
	Если ДокОбъект.ЭтоНовый() Тогда
		Возврат "";
	КонецЕсли;
	Изменение = ИзменениеНакладной(ДокОбъект, ИмяРеквизита, РежимЗаписи);
	Если Не ЗначениеЗаполнено(Изменение) Тогда
		Возврат "";
	КонецЕсли;
	ЗаблокироватьНакладную(ДокОбъект.Ссылка);
	Зависимые = ЗависимыеРегистраторыНакладной(ДокОбъект.Ссылка);
	Если Зависимые.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Представления = Новый Массив;
	Для Каждого Регистратор Из Зависимые Цикл
		Представления.Добавить(Строка(Регистратор));
	КонецЦикла;
	Шаблон = НСтр("ru = 'Накладная %1: %2 запрещено - на неё записали расчёты документы: %3. Сначала отмените их проведение.';
		|fr = 'Facture %1 : %2 est interdit - des documents y ont inscrit des règlements : %3. Annulez d''abord leur validation.';
		|en = 'Invoice %1: %2 is not allowed - settlements on it were recorded by: %3. Unpost them first.';
		|es = 'Factura %1: %2 está prohibido - registraron liquidaciones en ella: %3. Anule primero su contabilización.'");
	Возврат СтрШаблон(Шаблон, ДокОбъект.Ссылка, Изменение, СтрСоединить(Представления, "; "));
КонецФункции

// Зависимые регистраторы налоговой накладной: документы, кроме самой накладной и её документа удержания НДС, с
// записями в обычном или налоговом регистре расчётов на объект «накладная» - перенаправленные возвраты и сертификаты,
// прямые оплаты.
//
// Параметры:
//  Накладная - ДокументСсылка.НалоговаяНакладная, ДокументСсылка.НалоговаяНакладнаяПокупка - накладная.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция ЗависимыеРегистраторыНакладной(Накладная) Экспорт
	// BSLLS:SetPrivilegedMode-off - чужие движения читаются при записи накладной
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос;
	// BSLLS:YoLetterUsage-off
	Если ТипЗнч(Накладная) = Тип("ДокументСсылка.НалоговаяНакладная") Тогда
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.Регистратор КАК Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов = &Накладная
		               |	И НЕ Т.Регистратор В (&Исключая)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов = &Накладная
		               |	И НЕ Т.Регистратор В (&Исключая)";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.Регистратор КАК Регистратор
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т
		               |ГДЕ
		               |	Т.ОбъектРасчётов = &Накладная
		               |	И НЕ Т.Регистратор В (&Исключая)";
	КонецЕсли;
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Накладная", Накладная);
	Запрос.УстановитьПараметр("Исключая", СобственныеРегистраторыНакладной(Накладная));
	Результат = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор"),
		Истина);
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основания накладной, которые она переносит впервые или в большей сумме, чем прежде: у нового основания нет прежних
// движений переноса (регистратор - накладная, объект - основание), у выросшего покрытая сумма больше прежней.
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция НовыеИлиВыросшиеОснования(ДокОбъект, ИмяРеквизита)
	Текущие = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект, ИмяРеквизита);
	Результат = Новый Массив;
	Если Текущие.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если ДокОбъект.ЭтоНовый() Тогда
		Возврат Текущие.ВыгрузитьКолонку(ИмяКолонкиОснования());
	КонецЕсли;
	Прежние = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект.Ссылка.ПолучитьОбъект(), ИмяРеквизита);
	Перенесенные = ОснованияСДвижениямиПереноса(ДокОбъект.Ссылка, Текущие.ВыгрузитьКолонку(ИмяКолонкиОснования()), ИмяРеквизита);
	Для Каждого Строка Из Текущие Цикл
		Прежняя = Прежние.Найти(Строка.Основание, ИмяКолонкиОснования());
		Если Перенесенные.Найти(Строка.Основание) = Неопределено Или Прежняя = Неопределено
			Или Строка.Сумма > Прежняя.Сумма Тогда
			Результат.Добавить(Строка.Основание);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОснованияСДвижениямиПереноса(Накладная, Основания, ИмяРеквизита)
	// BSLLS:SetPrivilegedMode-off - движения накладной читаются при её записи
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос;
	// BSLLS:YoLetterUsage-off
	Если ИмяРеквизита = "ОтгрузкаТовара" Тогда
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов КАК Основание
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
		               |ГДЕ
		               |	Т.Регистратор = &Накладная
		               |	И Т.ОбъектРасчётов В (&Основания)";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Т.ОбъектРасчётов КАК Основание
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т
		               |ГДЕ
		               |	Т.Регистратор = &Накладная
		               |	И Т.ОбъектРасчётов В (&Основания)";
	КонецЕсли;
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Накладная", Накладная);
	Запрос.УстановитьПараметр("Основания", Основания);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(ИмяКолонкиОснования());
КонецФункции

// Что меняет запись накладной по сравнению с версией в базе - из перечня, запрещённого при зависимых регистраторах.
//
// Параметры:
//  ДокОбъект    - ДокументОбъект - накладная.
//  ИмяРеквизита - Строка - имя колонки основания.
//  РежимЗаписи  - РежимЗаписиДокумента, Неопределено - Неопределено - удаление.
//
// Возвращаемое значение:
//  Строка - представление изменения; пустая - запрещённых изменений нет.
//
Функция ИзменениеНакладной(ДокОбъект, ИмяРеквизита, РежимЗаписи)
	Если РежимЗаписи = Неопределено Тогда
		Возврат НСтр("ru = 'удаление'; fr = 'la suppression'; en = 'deletion'; es = 'la eliminación'");
	КонецЕсли;
	Прежний = ДокОбъект.Ссылка.ПолучитьОбъект();
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения И Прежний.Проведен Тогда
		Возврат НСтр("ru = 'отмена проведения'; fr = 'l''annulation de la validation'; en = 'unposting';
			|es = 'la anulación de la contabilización'");
	КонецЕсли;
	Если ДокОбъект.ПометкаУдаления И Не Прежний.ПометкаУдаления Тогда
		Возврат НСтр("ru = 'пометка удаления'; fr = 'la marque de suppression'; en = 'deletion mark';
			|es = 'la marca de eliminación'");
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("Контрагент,Организация,Договор", ",") Цикл
		Если ДокОбъект[Имя] <> Прежний[Имя] Тогда
			Шаблон = НСтр("ru = 'смена реквизита «%1»'; fr = 'le changement de « %1 »'; en = 'changing ""%1""';
				|es = 'el cambio de «%1»'");
			Возврат СтрШаблон(Шаблон, ДокОбъект.Метаданные().Реквизиты[Имя].Представление());
		КонецЕсли;
	КонецЦикла;
	Текущие = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект, ИмяРеквизита);
	Прежние = РаботаСДокументами.ОснованияНалоговойНакладной(Прежний, ИмяРеквизита);
	ОснованияИзменены = Текущие.Количество() <> Прежние.Количество();
	Для Каждого Строка Из Текущие Цикл
		Прежняя = Прежние.Найти(Строка.Основание, ИмяКолонкиОснования());
		ОснованияИзменены = ОснованияИзменены Или Прежняя = Неопределено Или Прежняя.Сумма <> Строка.Сумма;
	КонецЦикла;
	Если ОснованияИзменены Тогда
		Возврат НСтр("ru = 'изменение оснований и их сумм'; fr = 'la modification des bases et de leurs montants';
			|en = 'changing bases and their amounts'; es = 'el cambio de las bases y sus importes'");
	КонецЕсли;
	Возврат "";
КонецФункции

// Регистраторы, которые пишут на объект «накладная» сами по себе: накладная и её документ удержания НДС.
//
// Параметры:
//  Накладная - ДокументСсылка - накладная.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция СобственныеРегистраторыНакладной(Накладная)
	Результат = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Накладная);
	Возврат Результат;
КонецФункции

// Колонка основания в таблице ОснованияНалоговойНакладной.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяКолонкиОснования()
	Возврат "Основание";
КонецФункции

Процедура ЗаблокироватьНакладную(Накладная)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Накладная.Метаданные().ПолноеИмя());
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Накладная);
	Блокировка.Заблокировать();
КонецПроцедуры

#КонецОбласти
