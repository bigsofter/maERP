////////////////////////////////////////////////////////////////////////////////
// Программные отборы динамических списков и настроек компоновки в именованных группах.
//
// Отбор списка собирают независимые источники - навигатор иерархии слева и фильтры панели «Сведения». Каждый
// источник держит свои элементы в своей группе «И» внутри общего отбора и перестраивает только её: дерево и панель
// по одному полю не затирают друг друга (образец форм документов ищет элемент по имени поля и переписывает первый
// найденный). «Не заполнено» и «в списке» задаются явно, снятие отбора - отдельным вызовом: пустое значение не
// означает «снять». Отбор - ОтборКомпоновкиДанных динамического списка (Список.Отбор) или настроек схемы
// компоновки: тип один, поэтому сценарии тестов проверяют те же группы, что ставит форма.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Имя группы отбора навигатора иерархии (дерево слева от списка).
//
// Возвращаемое значение:
//  Строка - имя группы
//
Функция ГруппаИерархия() Экспорт

	Возврат "Иерархия";

КонецФункции

// Имя группы отбора фильтров панели «Сведения».
//
// Возвращаемое значение:
//  Строка - имя группы
//
Функция ГруппаПанель() Экспорт

	Возврат "Панель";

КонецФункции

// Ставит отбор по полю в группе: элемент поля в группе один, повторный вызов меняет его. Значение берётся как
// есть, пустое значение - это отбор «равно пустому», а не снятие (снятие - СнятьОтбор).
//
// Параметры:
//  Отбор        - ОтборКомпоновкиДанных - отбор списка или настроек компоновки
//  ИмяГруппы    - Строка - группа отбора, см. ГруппаИерархия, ГруппаПанель
//  Поле         - Строка - путь к полю
//  Значение     - Произвольный, СписокЗначений - значение; список значений - вид сравнения «в списке»
//  ВидСравнения - ВидСравненияКомпоновкиДанных, Неопределено - вид сравнения; по умолчанию «равно» или «в списке»
//
Процедура УстановитьОтбор(Отбор, ИмяГруппы, Поле, Значение, ВидСравнения = Неопределено) Экспорт

	Элемент = ЭлементПоля(Отбор, ИмяГруппы, Поле, Истина);
	Если ВидСравнения <> Неопределено Тогда
		Элемент.ВидСравнения = ВидСравнения;
	ИначеЕсли ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Иначе
		Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	КонецЕсли;
	Элемент.ПравоеЗначение = Значение;
	Элемент.Использование = Истина;

КонецПроцедуры

// Ставит отбор «не заполнено» по полю в группе: пустая ссылка, пустая строка, ноль или NULL соединения.
//
// Параметры:
//  Отбор     - ОтборКомпоновкиДанных - отбор списка или настроек компоновки
//  ИмяГруппы - Строка - группа отбора
//  Поле      - Строка - путь к полю
//
Процедура УстановитьОтборНеЗаполнено(Отбор, ИмяГруппы, Поле) Экспорт

	Элемент = ЭлементПоля(Отбор, ИмяГруппы, Поле, Истина);
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Элемент.ПравоеЗначение = Неопределено;
	Элемент.Использование = Истина;

КонецПроцедуры

// Ставит отбор по заполненному значению или снимает его по пустому - для полей панели, где пусто значит «все»
// (ноль числового фильтра - тоже «все»).
//
// Параметры:
//  Отбор        - ОтборКомпоновкиДанных - отбор списка или настроек компоновки
//  ИмяГруппы    - Строка - группа отбора
//  Поле         - Строка - путь к полю
//  Значение     - Произвольный, СписокЗначений - значение; пустое - снять отбор
//  ВидСравнения - ВидСравненияКомпоновкиДанных, Неопределено - см. УстановитьОтбор
//
Процедура УстановитьОтборЕслиЗаполнено(Отбор, ИмяГруппы, Поле, Значение, ВидСравнения = Неопределено) Экспорт

	Если ЗначениеЗаполнено(Значение) Тогда
		УстановитьОтбор(Отбор, ИмяГруппы, Поле, Значение, ВидСравнения);
	Иначе
		СнятьОтбор(Отбор, ИмяГруппы, Поле);
	КонецЕсли;

КонецПроцедуры

// Снимает отбор по полю в группе; элементы других групп не трогаются.
//
// Параметры:
//  Отбор     - ОтборКомпоновкиДанных - отбор списка или настроек компоновки
//  ИмяГруппы - Строка - группа отбора
//  Поле      - Строка - путь к полю
//
Процедура СнятьОтбор(Отбор, ИмяГруппы, Поле) Экспорт

	Группа = ГруппаОтбора(Отбор, ИмяГруппы, Ложь);
	Если Группа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Элемент = ЭлементПоля(Отбор, ИмяГруппы, Поле, Ложь);
	Если Элемент <> Неопределено Тогда
		Группа.Элементы.Удалить(Элемент);
	КонецЕсли;

КонецПроцедуры

// Снимает все отборы группы; сама группа остаётся пустой (пустая группа «И» ничего не отбирает).
//
// Параметры:
//  Отбор     - ОтборКомпоновкиДанных - отбор списка или настроек компоновки
//  ИмяГруппы - Строка - группа отбора
//
Процедура ОчиститьГруппу(Отбор, ИмяГруппы) Экспорт

	Группа = ГруппаОтбора(Отбор, ИмяГруппы, Ложь);
	Если Группа <> Неопределено Тогда
		Группа.Элементы.Очистить();
	КонецЕсли;

КонецПроцедуры

// Элемент отбора поля в группе - для проверок и чтения текущего состояния.
//
// Параметры:
//  Отбор     - ОтборКомпоновкиДанных - отбор списка или настроек компоновки
//  ИмяГруппы - Строка - группа отбора
//  Поле      - Строка - путь к полю
//
// Возвращаемое значение:
//  ЭлементОтбораКомпоновкиДанных, Неопределено - элемент; Неопределено - отбора по полю в группе нет
//
Функция НайтиОтбор(Отбор, ИмяГруппы, Поле) Экспорт

	Возврат ЭлементПоля(Отбор, ИмяГруппы, Поле, Ложь);

КонецФункции

// Фильтр панели «Товар» списка документов: остаются документы, у которых товар указан в шапке или хотя бы в одной
// строке табличной части. Условия по всем товарным полям документа (см. ПоляТовара) - подгруппа «ИЛИ» в группе панели;
// отбор по полю табличной части платформа применяет как «есть строка с таким значением», поэтому список не дублирует
// документы и сразу видит новые и изменённые документы. В произвольном запросе списка табличные части с товарными
// полями должны быть выбраны вложенными таблицами - это сверяет scripts/listcheck.py.
//
// Параметры:
//  Список - ДинамическийСписок - список формы; документ определяется по основной таблице списка
//  Товар  - СправочникСсылка.Номенклатура - отбираемый товар; пустой - фильтр снимается
//
Процедура УстановитьОтборПоТовару(Список, Товар) Экспорт

	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(Список.ОсновнаяТаблица);
	Если МетаданныеДокумента = Неопределено Или Не Метаданные.Документы.Содержит(МетаданныеДокумента) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Фильтр по товару: основная таблица списка «%1» - не документ.';
			|fr = 'Filtre par article : la table principale de la liste « %1 » n’est pas un document.';
			|en = 'Product filter: the list main table «%1» is not a document.';
			|es = 'Filtro por artículo: la tabla principal de la lista «%1» no es un documento.'"), Список.ОсновнаяТаблица);
	КонецЕсли;
	УстановитьОтборТовара(Список.Отбор, МетаданныеДокумента, Товар);

КонецПроцедуры

// Подгруппа «ИЛИ» фильтра «Товар» в группе панели: по условию «равно товару» на каждое товарное поле документа.
// Повторный вызов заменяет подгруппу, пустой товар её удаляет.
//
// Параметры:
//  Отбор               - ОтборКомпоновкиДанных - отбор списка или настроек компоновки
//  МетаданныеДокумента - ОбъектМетаданных - документ списка
//  Товар               - СправочникСсылка.Номенклатура - отбираемый товар; пустой - фильтр снимается
//
Процедура УстановитьОтборТовара(Отбор, МетаданныеДокумента, Товар) Экспорт

	Группа = ГруппаОтбора(Отбор, ГруппаПанель(), ЗначениеЗаполнено(Товар));
	Если Группа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Подгруппа = ПодгруппаТовара(Группа);
	Если Подгруппа <> Неопределено Тогда
		Группа.Элементы.Удалить(Подгруппа);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Товар) Тогда
		Возврат;
	КонецЕсли;

	Подгруппа = Группа.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	Подгруппа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	Подгруппа.Представление = ИмяПодгруппыТовара();
	Подгруппа.Использование = Истина;
	Для Каждого Поле Из ПоляТовара(МетаданныеДокумента) Цикл
		Элемент = Подгруппа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Поле);
		Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Элемент.ПравоеЗначение = Товар;
		Элемент.Использование = Истина;
	КонецЦикла;

КонецПроцедуры

// Подгруппа фильтра «Товар» в группе панели - для проверок и чтения текущего состояния.
//
// Параметры:
//  Отбор - ОтборКомпоновкиДанных - отбор списка или настроек компоновки
//
// Возвращаемое значение:
//  ГруппаЭлементовОтбораКомпоновкиДанных, Неопределено - подгруппа; Неопределено - фильтр не установлен
//
Функция НайтиОтборТовара(Отбор) Экспорт

	Группа = ГруппаОтбора(Отбор, ГруппаПанель(), Ложь);
	Если Группа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПодгруппаТовара(Группа);

КонецФункции

// Товарные поля документа: реквизиты шапки и табличных частей с типом «Номенклатура» - товар, который документ
// продаёт, покупает, перемещает, приходует или производит (например, «НоменклатураОприходование» пересортицы,
// «Продукция» переработки, «Номенклатура» шапки выпуска).
//
// Параметры:
//  МетаданныеДокумента - ОбъектМетаданных - документ
//
// Возвращаемое значение:
//  Массив из Строка - пути полей: «Реквизит» или «ТабличнаяЧасть.Реквизит»
//
Функция ПоляТовара(МетаданныеДокумента) Экспорт

	ТипТовара = Тип("СправочникСсылка.Номенклатура");
	Поля = Новый Массив;
	Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
		Если Реквизит.Тип.СодержитТип(ТипТовара) Тогда
			Поля.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			Если Реквизит.Тип.СодержитТип(ТипТовара) Тогда
				Поля.Добавить(ТабличнаяЧасть.Имя + "." + Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Поля;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Группа «И» с представлением ИмяГруппы на верхнем уровне отбора. У коллекции элементов отбора нет метода
// «Найти» (tiny1C bsl-013) - обход циклом.
//
// Параметры:
//  Отбор     - ОтборКомпоновкиДанных - отбор
//  ИмяГруппы - Строка - представление группы
//  Создавать - Булево - создать группу, если её нет
//
// Возвращаемое значение:
//  ГруппаЭлементовОтбораКомпоновкиДанных, Неопределено - группа; Неопределено - нет и не создавалась
//
Функция ГруппаОтбора(Отбор, ИмяГруппы, Создавать)

	Для Каждого Элемент Из Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")
			И Элемент.Представление = ИмяГруппы Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	Если Не Создавать Тогда
		Возврат Неопределено;
	КонецЕсли;
	Группа = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	Группа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	Группа.Представление = ИмяГруппы;
	Группа.Использование = Истина;
	Возврат Группа;

КонецФункции

Функция ИмяПодгруппыТовара()

	Возврат "Товар";

КонецФункции

Функция ПодгруппаТовара(Группа)

	Имя = ИмяПодгруппыТовара();
	Для Каждого Элемент Из Группа.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") И Элемент.Представление = Имя Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ЭлементПоля(Отбор, ИмяГруппы, Поле, Создавать)

	Группа = ГруппаОтбора(Отбор, ИмяГруппы, Создавать);
	Если Группа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПолеКомпоновки = Новый ПолеКомпоновкиДанных(Поле);
	Для Каждого Элемент Из Группа.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") И Элемент.ЛевоеЗначение = ПолеКомпоновки Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	Если Не Создавать Тогда
		Возврат Неопределено;
	КонецЕсли;
	Элемент = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = ПолеКомпоновки;
	Возврат Элемент;

КонецФункции

#КонецОбласти
