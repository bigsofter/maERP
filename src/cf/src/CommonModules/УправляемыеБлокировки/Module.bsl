Процедура ТоварыВНаличии(Блокировка, ИсточникДанных, МестоХранения = Неопределено) Экспорт
	Эл = Блокировка.Добавить("РегистрНакопления.ТоварыВНаличии");
	Эл.Режим = РежимБлокировкиДанных.Исключительный;
	Эл.ИсточникДанных = ИсточникДанных;
	Если ЗначениеЗаполнено(МестоХранения) Тогда
		Эл.УстановитьЗначение("МестоХранения", МестоХранения);
	КонецЕсли;
	Эл.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	// Дополнительные расходы
	ДополнительныеРасходы(Блокировка, ИсточникДанных, МестоХранения);
КонецПроцедуры

