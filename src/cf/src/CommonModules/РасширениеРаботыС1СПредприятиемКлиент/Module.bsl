// Работа с компьютером пользователя из веб-клиента: принтер, файлы на диске,
// запуск внешних приложений. Всё это доступно браузеру только через расширение
// для работы с 1С:Предприятием, поэтому такие участки кода начинаются с вызова
// Подключить(): расширение либо уже подключено, либо пользователю предлагается
// его установить. В тонком, толстом и мобильном клиентах расширение не нужно.

#Область ПрограммныйИнтерфейс

// Подключает расширение для работы с 1С:Предприятием, при необходимости предложив
// пользователю его установить, и продолжает работу через оповещение. Вызывается в начале
// участка кода, работающего с компьютером пользователя: печать на принтер, диалоги выбора
// файла, запуск приложений. Вне веб-клиента расширение подключено всегда, поэтому обработчик
// оповещения вызывается сразу.
//
// Пользователь, отказавшийся от установки, больше не спрашивается на этом компьютере -
// признак хранится в общих настройках по идентификатору клиента.
//
// Параметры:
//  ОписаниеОповещенияОЗакрытии - ОписаниеОповещения - вызывается после закрытия вопроса
//      с параметрами:
//        * РасширениеПодключено - Булево - Истина, если расширение подключено или не требуется.
//        * ДополнительныеПараметры - Произвольный - заданные в ОписаниеОповещенияОЗакрытии.
//      Неопределено - продолжение не требуется, вопрос показывается ради самой установки.
//  ТекстПредложения - Строка - что именно не получится сделать без расширения. Если не задан,
//      показывается общий текст.
//  ВозможноПродолжениеБезУстановки - Булево - Истина: действие имеет смысл и без расширения,
//      в вопросе показывается кнопка «Продолжить без установки». Ложь: показывается «Отмена».
//
// Пример:
//  Оповещение = Новый ОписаниеОповещения("НапечататьЗавершение", ЭтотОбъект, ТабличныйДокумент);
//  РасширениеРаботыС1СПредприятиемКлиент.Подключить(Оповещение,
//  	НСтр("ru = 'Для печати документа установите расширение для работы с 1С:Предприятием.'"));
//
Процедура Подключить(ОписаниеОповещенияОЗакрытии, ТекстПредложения = "",
	ВозможноПродолжениеБезУстановки = Истина) Экспорт

#Если Не ВебКлиент Тогда
	// В тонком, толстом и мобильном клиентах расширение подключено всегда.
	ОповеститьОЗавершении(ОписаниеОповещенияОЗакрытии, Истина);
#Иначе
	Контекст = Новый Структура;
	Контекст.Вставить("ОписаниеОповещенияОЗакрытии", ОписаниеОповещенияОЗакрытии);
	Контекст.Вставить("ТекстПредложения", ТекстПредложения);
	Контекст.Вставить("ВозможноПродолжениеБезУстановки", ВозможноПродолжениеБезУстановки);

	Оповещение = Новый ОписаниеОповещения("ПослеПроверкиПодключения",
		РасширениеРаботыС1СПредприятиемКлиент, Контекст);
	НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
#КонецЕсли

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Продолжение процедуры Подключить: расширение уже подключено либо надо предложить установку.
//
// Параметры:
//  Подключено - Булево - результат НачатьПодключениеРасширенияРаботыСФайлами.
//  Контекст - Структура - параметры вызова Подключить.
//
Процедура ПослеПроверкиПодключения(Подключено, Контекст) Экспорт

	Если Подключено Тогда
		ОповеститьОЗавершении(Контекст.ОписаниеОповещенияОЗакрытии, Истина);
		Возврат;
	КонецЕсли;

	Если Не РасширениеДоступноВБраузере() Тогда
		// Предлагать установку нечего: в этом браузере расширения нет.
		ОповеститьОЗавершении(Контекст.ОписаниеОповещенияОЗакрытии, Ложь);
		Возврат;
	КонецЕсли;

	Если Контекст.ВозможноПродолжениеБезУстановки
		И Не ОбщегоНазначенияВызовСервера.ПредлагатьУстановкуРасширения(ИдентификаторКлиента()) Тогда
		// Пользователь уже отказался от установки на этом компьютере - молча продолжаем.
		ОповеститьОЗавершении(Контекст.ОписаниеОповещенияОЗакрытии, Ложь);
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстПредложения", Контекст.ТекстПредложения);
	ПараметрыФормы.Вставить("ВозможноПродолжениеБезУстановки", Контекст.ВозможноПродолжениеБезУстановки);

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", РасширениеРаботыС1СПредприятиемКлиент, Контекст);
	ОткрытьФорму("ОбщаяФорма.ВопросОбУстановкеРасширения", ПараметрыФормы, , , , , Оповещение);

КонецПроцедуры

// Продолжение процедуры Подключить: пользователь ответил на вопрос об установке.
//
// Параметры:
//  Действие - Строка, Неопределено - как закрыт вопрос: «РасширениеПодключено»,
//      «БольшеНеПредлагать», «Отмена» или Неопределено при закрытии крестиком.
//  Контекст - Структура - параметры вызова Подключить.
//
Процедура ПослеЗакрытияВопроса(Действие, Контекст) Экспорт

	РасширениеПодключено = (Действие = "РасширениеПодключено");

	Если РасширениеПодключено Или Действие = "БольшеНеПредлагать" Тогда
		// Расширение установлено либо пользователь отказался: спрашивать больше не о чем.
		ОбщегоНазначенияВызовСервера.ОтключитьПредложениеУстановкиРасширения(ИдентификаторКлиента());
	КонецЕсли;

	ОповеститьОЗавершении(Контекст.ОписаниеОповещенияОЗакрытии, РасширениеПодключено);

КонецПроцедуры

// Вызывает обработчик оповещения, если он задан.
//
// Параметры:
//  ОписаниеОповещения - ОписаниеОповещения, Неопределено - обработчик продолжения.
//  РасширениеПодключено - Булево - что передать обработчику.
//
Процедура ОповеститьОЗавершении(ОписаниеОповещения, РасширениеПодключено)

	Если ОписаниеОповещения <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, РасширениеПодключено);
	КонецЕсли;

КонецПроцедуры

// В macOS расширение работает только в Chrome, в остальных браузерах предлагать установку бесполезно.
//
// Возвращаемое значение:
//  Булево - Истина, если расширение в этом браузере доступно.
//
Функция РасширениеДоступноВБраузере()

	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоMacOS = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.MacOS_x86
		Или СистемнаяИнформация.ТипПлатформы = ТипПлатформы.MacOS_x86_64;

	Возврат Не ЭтоMacOS Или СтрНайти(СистемнаяИнформация.ИнформацияПрограммыПросмотра, "Chrome") > 0;

КонецФункции

// Идентификатор компьютера: настройка «больше не предлагать» своя на каждом рабочем месте.
//
// Возвращаемое значение:
//  Строка - идентификатор клиента.
//
Функция ИдентификаторКлиента()

	СистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат СистемнаяИнформация.ИдентификаторКлиента;

КонецФункции

#КонецОбласти
