////////////////////////////////////////////////////////////////////////////////
// Групповое изменение строк товаров документа продажи: скидка процентом и суммой, итог документа, снятие скидок,
// изменение и округление цен (docs/plans/commerce-clients-typical.md, Ф3). Каждая строка пересчитывается
// РаботаСДокументамиКлиентСервер.РассчитатьСтроку тем режимом, которым пользуется ручная правка колонки: своей
// арифметики НДС модуль не делает. Денежная скидка раскладывается в базе РассчитатьСтроку - сумме строки с НДС.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Может ли текущий пользователь менять цены и скидки строк: та же настройка «Заверение цен», по которой формы
// документов закрывают колонки цен и скидок.
//
// Возвращаемое значение:
//  Булево - Истина, если колонки цен и скидок пользователю редактируемы.
//
Функция ПравоИзменятьЦены() Экспорт

	Возврат РегистрыСведений.НастройкиПользователей.ЗаверениеЦен() = Истина;

КонецФункции

// Серверная часть команды подменю «Изменить» формы документа: проверка права и режима формы, строки по
// идентификаторам, расчёт и суммы в основной валюте. Вызывается из серверной процедуры формы - один вызов сервера.
//
// Параметры:
//  Форма          - ФормаКлиентскогоПриложения - форма документа с реквизитом Объект (ТЧТовары, ЦенаВключаетНДС).
//  Действие       - Строка - см. Применить.
//  Значение       - Число - см. Применить.
//  Идентификаторы - Массив из Число - идентификаторы строк Объект.ТЧТовары.
//
// Возвращаемое значение:
//  Структура - см. Применить.
//
Функция ПрименитьВФорме(Форма, Действие, Значение, Идентификаторы) Экспорт

	Если Форма.ТолькоПросмотр Или Не ПравоИзменятьЦены() Тогда
		Возврат Новый Структура("Выполнено, Текст", Ложь, НСтр("ru = 'Нет права менять цены и скидки в этом документе.';
			|fr = 'Vous n''avez pas le droit de modifier les prix et les remises de ce document.';
			|en = 'You are not allowed to change prices and discounts in this document.';
			|es = 'No tiene derecho a modificar precios y descuentos en este documento.'"));
	КонецЕсли;
	Объект = Форма.Объект;
	Строки = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Стр = Объект.ТЧТовары.НайтиПоИдентификатору(Идентификатор);
		Если Стр <> Неопределено Тогда
			Строки.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Результат = Применить(Строки, Объект.ЦенаВключаетНДС, Действие, Значение);
	Если Результат.Выполнено Тогда
		РаботаСВалютамиКлиентСервер.ПересчитатьСуммыРегл(Объект);
		Форма.Модифицированность = Истина;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Применяет групповое действие к строкам товаров. Значение вне допустимых границ - отказ, строки не меняются.
//
// Параметры:
//  Строки          - Массив из СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекции - изменяемые строки с колонками Цена,
//                    Сумма, СтавкаНДС, СуммаНДС, СуммаСНДС, ПроцентСкидки, СуммаСкидки и, возможно, СкидкаНаЦену.
//  ЦенаВключаетНДС - Булево - режим НДС документа.
//  Действие        - Строка - "СкидкаПроцент", "СкидкаСуммой", "ИтогДокумента", "УбратьСкидки", "ЦеныНаПроцент",
//                    "ОкруглитьЦены".
//  Значение        - Число - процент скидки; сумма скидки; целевой итог с НДС; процент изменения цен (±);
//                    точность округления цен (1, 0.1 или 0.01); для «УбратьСкидки» не используется.
//
// Возвращаемое значение:
//  Структура - результат:
//   * Выполнено - Булево - строки изменены.
//   * Текст     - Строка - причина отказа или замечание к результату (итог с округлением НДС); пустая - без замечаний.
//
Функция Применить(Строки, ЦенаВключаетНДС, Действие, Значение) Экспорт

	Результат = Новый Структура("Выполнено, Текст", Ложь, "");
	Если Строки.Количество() = 0 Тогда
		Результат.Текст = НСтр("ru = 'Нет строк для изменения.'; fr = 'Aucune ligne à modifier.';
			|en = 'No lines to change.'; es = 'No hay líneas para modificar.'");
		Возврат Результат;
	КонецЕсли;

	Если Действие = "СкидкаПроцент" Тогда
		ПрименитьПроцентСкидки(Строки, ЦенаВключаетНДС, Значение, Результат);
	ИначеЕсли Действие = "СкидкаСуммой" Тогда
		ПрименитьСуммуСкидки(Строки, ЦенаВключаетНДС, Значение, Результат);
	ИначеЕсли Действие = "ИтогДокумента" Тогда
		ПрименитьИтог(Строки, ЦенаВключаетНДС, Значение, Результат);
	ИначеЕсли Действие = "УбратьСкидки" Тогда
		УбратьСкидки(Строки, ЦенаВключаетНДС);
		Результат.Выполнено = Истина;
	ИначеЕсли Действие = "ЦеныНаПроцент" Тогда
		ИзменитьЦены(Строки, ЦенаВключаетНДС, Значение, Результат);
	ИначеЕсли Действие = "ОкруглитьЦены" Тогда
		ОкруглитьЦены(Строки, ЦенаВключаетНДС, Значение, Результат);
	Иначе
		ВызватьИсключение "ГрупповоеИзменениеСтрок.Применить: неизвестное действие " + Действие;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Раскладывает сумму по базам строк пропорционально: суммы долей - до 0,01, остаток округления - в строки по
// убыванию базы, каждой не больше её запаса (доля не больше базы и не меньше нуля).
//
// Параметры:
//  Базы  - Массив из Число - неотрицательные базы строк.
//  Сумма - Число - раскладываемая сумма, от 0 до суммы баз.
//
// Возвращаемое значение:
//  Массив из Число - доли строк в порядке баз; их сумма равна Сумма.
//
Функция РаспределитьСумму(Базы, Сумма) Экспорт

	Доли = Новый Массив;
	ИтогБаз = 0;
	Для Каждого База Из Базы Цикл
		ИтогБаз = ИтогБаз + База;
	КонецЦикла;
	Распределено = 0;
	Для Каждого База Из Базы Цикл
		Доля = ?(ИтогБаз = 0, 0, Мин(База, Окр(Сумма * База / ИтогБаз, РазрядностьСумм())));
		Доли.Добавить(Доля);
		Распределено = Распределено + Доля;
	КонецЦикла;

	Остаток = Сумма - Распределено;
	Для Каждого Индекс Из ИндексыПоУбываниюБазы(Базы) Цикл
		Если Остаток = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Остаток > 0 Тогда
			Добавка = Мин(Остаток, Базы[Индекс] - Доли[Индекс]);
		Иначе
			Добавка = Макс(Остаток, -Доли[Индекс]);
		КонецЕсли;
		Доли[Индекс] = Доли[Индекс] + Добавка;
		Остаток = Остаток - Добавка;
	КонецЦикла;
	Возврат Доли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьПроцентСкидки(Строки, ЦенаВключаетНДС, Процент, Результат)

	Если Процент < 0 Или Процент > РаботаСДокументамиКлиентСервер.СтоПроцентов() Тогда
		Результат.Текст = НСтр("ru = 'Скидка должна быть от 0 до 100 %.'; fr = 'La remise doit être comprise entre 0 et 100 %.';
			|en = 'The discount must be between 0 and 100%.'; es = 'El descuento debe estar entre 0 y 100 %.'");
		Возврат;
	КонецЕсли;
	Для Каждого Стр Из Строки Цикл
		Стр.ПроцентСкидки = Процент;
		// Как ручная правка колонки «Скидка, %»: пересчёт от процента.
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, ЦенаВключаетНДС);
	КонецЦикла;
	Результат.Выполнено = Истина;

КонецПроцедуры

Процедура ПрименитьСуммуСкидки(Строки, ЦенаВключаетНДС, Сумма, Результат)

	Базы = БазыСтрок(Строки, ЦенаВключаетНДС);
	ИтогДоСкидки = СуммаМассива(Базы);
	Если Сумма < 0 Или Сумма > ИтогДоСкидки Тогда
		Шаблон = НСтр("ru = 'Скидка должна быть от 0 до %1 (итог выбранных строк до скидки).';
			|fr = 'La remise doit être comprise entre 0 et %1 (total des lignes sélectionnées avant remise).';
			|en = 'The discount must be between 0 and %1 (total of the selected lines before discount).';
			|es = 'El descuento debe estar entre 0 y %1 (total de las líneas seleccionadas antes del descuento).'");
		Результат.Текст = СтрШаблон(Шаблон, ПредставлениеСуммы(ИтогДоСкидки));
		Возврат;
	КонецЕсли;
	УстановитьСкидки(Строки, ЦенаВключаетНДС, РаспределитьСумму(Базы, Сумма));
	Результат.Выполнено = Истина;

КонецПроцедуры

// Итог выбранных строк с НДС становится введённым: полная скидка = итог до скидки - итог, прежние скидки заменяются.
// После раскладки фактический итог сверяется с целевым: разницу округления НДС получает строка с наибольшей базой,
// у которой есть запас. Проход один, без повторов (точный итог при цене без НДС достижим не всегда).
//
// Параметры:
//  Строки          - Массив - изменяемые строки, см. Применить.
//  ЦенаВключаетНДС - Булево - режим НДС документа.
//  Итог            - Число - целевой итог строк с НДС.
//  Результат       - Структура - см. Применить; заполняется.
//
Процедура ПрименитьИтог(Строки, ЦенаВключаетНДС, Итог, Результат)

	Базы = БазыСтрок(Строки, ЦенаВключаетНДС);
	ИтогДоСкидки = СуммаМассива(Базы);
	Если Итог < 0 Или Итог > ИтогДоСкидки Тогда
		Шаблон = НСтр("ru = 'Итог должен быть от 0 до %1 (итог выбранных строк до скидки).';
			|fr = 'Le total doit être compris entre 0 et %1 (total des lignes sélectionnées avant remise).';
			|en = 'The total must be between 0 and %1 (total of the selected lines before discount).';
			|es = 'El total debe estar entre 0 y %1 (total de las líneas seleccionadas antes del descuento).'");
		Результат.Текст = СтрШаблон(Шаблон, ПредставлениеСуммы(ИтогДоСкидки));
		Возврат;
	КонецЕсли;
	Скидки = РаспределитьСумму(Базы, ИтогДоСкидки - Итог);
	УстановитьСкидки(Строки, ЦенаВключаетНДС, Скидки);
	Результат.Выполнено = Истина;

	Разница = ИтогСтрок(Строки) - Итог;
	Если Разница = 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Индекс Из ИндексыПоУбываниюБазы(Базы) Цикл
		НоваяСкидка = Скидки[Индекс] + Разница;
		Если НоваяСкидка >= 0 И НоваяСкидка <= Базы[Индекс] Тогда
			Стр = Строки[Индекс];
			Стр.СуммаСкидки = НоваяСкидка;
			РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, ЦенаВключаетНДС, "Сумма");
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Получено = ИтогСтрок(Строки);
	Если Получено <> Итог Тогда
		Шаблон = НСтр("ru = 'Итог %1 (округление НДС).'; fr = 'Total %1 (arrondi de la TVA).';
			|en = 'Total %1 (VAT rounding).'; es = 'Total %1 (redondeo del IVA).'");
		Результат.Текст = СтрШаблон(Шаблон, ПредставлениеСуммы(Получено));
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьСкидки(Строки, ЦенаВключаетНДС, Скидки)

	Для Индекс = 0 По Строки.ВГраница() Цикл
		Стр = Строки[Индекс];
		Стр.СуммаСкидки = Скидки[Индекс];
		// Как ручная правка колонки «Сумма скидки»: процент и скидка на цену считаются от суммы скидки.
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, ЦенаВключаетНДС, "Сумма");
	КонецЦикла;

КонецПроцедуры

Процедура УбратьСкидки(Строки, ЦенаВключаетНДС)

	Для Каждого Стр Из Строки Цикл
		Стр.ПроцентСкидки = 0;
		Стр.СуммаСкидки = 0;
		Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Стр, "СкидкаНаЦену") Тогда
			Стр.СкидкаНаЦену = 0;
		КонецЕсли;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, ЦенаВключаетНДС);
	КонецЦикла;

КонецПроцедуры

Процедура ИзменитьЦены(Строки, ЦенаВключаетНДС, Процент, Результат)

	Множитель = 1 + Процент / РаботаСДокументамиКлиентСервер.СтоПроцентов();
	Если Множитель <= 0 Тогда
		Результат.Текст = НСтр("ru = 'Цены должны остаться больше нуля: снижение - меньше 100 %.';
			|fr = 'Les prix doivent rester supérieurs à zéro : la baisse doit être inférieure à 100 %.';
			|en = 'Prices must stay above zero: the decrease must be less than 100%.';
			|es = 'Los precios deben seguir siendo mayores que cero: la reducción debe ser inferior al 100 %.'");
		Возврат;
	КонецЕсли;
	Для Каждого Стр Из Строки Цикл
		Стр.Цена = Окр(Стр.Цена * Множитель, РазрядностьСумм());
		// Как ручная правка колонки «Цена».
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, ЦенаВключаетНДС, "Цена");
	КонецЦикла;
	Результат.Выполнено = Истина;

КонецПроцедуры

Процедура ОкруглитьЦены(Строки, ЦенаВключаетНДС, Точность, Результат)

	Разрядность = РазрядностьТочности(Точность);
	Если Разрядность = Неопределено Тогда
		Результат.Текст = НСтр("ru = 'Точность округления цен - 1, 0,1 или 0,01.';
			|fr = 'La précision d''arrondi des prix est 1, 0,1 ou 0,01.';
			|en = 'Price rounding precision is 1, 0.1 or 0.01.';
			|es = 'La precisión de redondeo de precios es 1, 0,1 o 0,01.'");
		Возврат;
	КонецЕсли;
	Для Каждого Стр Из Строки Цикл
		Стр.Цена = Окр(Стр.Цена, Разрядность);
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, ЦенаВключаетНДС, "Цена");
	КонецЦикла;
	Результат.Выполнено = Истина;

КонецПроцедуры

Функция РазрядностьТочности(Точность)

	// BSLLS:MagicNumber-off
	Если Точность = 1 Тогда
		Возврат 0;
	ИначеЕсли Точность = 0.1 Тогда
		Возврат 1;
	ИначеЕсли Точность = 0.01 Тогда
		Возврат 2;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецФункции

Функция БазыСтрок(Строки, ЦенаВключаетНДС)

	Базы = Новый Массив;
	Для Каждого Стр Из Строки Цикл
		Базы.Добавить(Макс(0, РаботаСДокументамиКлиентСервер.СуммаБазоваяСкидки(Стр, ЦенаВключаетНДС)));
	КонецЦикла;
	Возврат Базы;

КонецФункции

Функция ИтогСтрок(Строки)

	Итог = 0;
	Для Каждого Стр Из Строки Цикл
		Итог = Итог + Стр.СуммаСНДС;
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция СуммаМассива(Числа)

	Итог = 0;
	Для Каждого Число Из Числа Цикл
		Итог = Итог + Число;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Индексы баз по убыванию; при равных базах - в порядке строк.
//
// Параметры:
//  Базы - Массив из Число - базы строк.
//
// Возвращаемое значение:
//  Массив из Число - индексы баз.
//
Функция ИндексыПоУбываниюБазы(Базы)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Индекс", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("База", Новый ОписаниеТипов("Число"));
	Для Индекс = 0 По Базы.ВГраница() Цикл
		Строка = Таблица.Добавить();
		Строка.Индекс = Индекс;
		Строка.База = Базы[Индекс];
	КонецЦикла;
	Таблица.Сортировать("База Убыв, Индекс");
	Возврат Таблица.ВыгрузитьКолонку("Индекс");

КонецФункции

Функция РазрядностьСумм()
	// BSLLS:MagicNumber-off - копейки сумм и цен.
	Возврат 2;
	// BSLLS:MagicNumber-on
КонецФункции

Функция ПредставлениеСуммы(Сумма)
	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=0");
КонецФункции

#КонецОбласти
