#Область ПрограммныйИнтерфейс

// Действие с потребностью из команды формы (план docs/plans/retail-store-needs.md): смена статуса записью с
// проведением (возврат в черновик - отменой проведения). Права и переход проверяет ПередЗаписью документа.
//
// Параметры:
//  Потребность - ДокументСсылка.ПотребностьТорговойТочки - документ.
//  Действие    - Строка - «Отправить», «Принять», «Отклонить», «Закрыть», «ВернутьВЧерновик».
//
Процедура ВыполнитьДействие(Знач Потребность, Знач Действие) Экспорт
	Статусы = Перечисления.СтатусыПотребностейТорговыхТочек;
	ДокОбъект = Потребность.ПолучитьОбъект();
	Режим = РежимЗаписиДокумента.Проведение;
	Если Действие = "Отправить" Тогда
		ДокОбъект.Статус = Статусы.Отправлена;
	ИначеЕсли Действие = "Принять" Тогда
		ДокОбъект.Статус = Статусы.Принята;
		ЗаполнитьПринятоПоУмолчанию(ДокОбъект);
	ИначеЕсли Действие = "Отклонить" Тогда
		ДокОбъект.Статус = Статусы.Отклонена;
	ИначеЕсли Действие = "Закрыть" Тогда
		ДокОбъект.Статус = Статусы.Закрыта;
	ИначеЕсли Действие = "ВернутьВЧерновик" Тогда
		ДокОбъект.Статус = Статусы.Черновик;
		Режим = РежимЗаписиДокумента.ОтменаПроведения;
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестное действие: %1'; fr = 'Action inconnue : %1';
			|en = 'Unknown action: %1'; es = 'Acción desconocida: %1'"), Действие);
	КонецЕсли;
	ДокОбъект.Записать(Режим);
КонецПроцедуры

// Получение отгрузки точкой: первое проведённое списание по потребности, ещё не оприходованное (без проведённого
// оприходования: частичное повторное получение оформляет склад).
//
// Параметры:
//  Потребность - ДокументСсылка.ПотребностьТорговойТочки - потребность своей точки.
//
// Возвращаемое значение:
//  ДокументСсылка.ПеремещениеТоваров - проведённое оприходование.
//
Функция ПолучитьОтгрузку(Знач Потребность) Экспорт
	// Право точки - до поиска отгрузки: ответ «нет отгрузки» по чужой потребности не раскрывается.
	// BSLLS:SetPrivilegedMode-off - чтение точки потребности для проверки права
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Точка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Потребность, "МестоХранения");
	УстановитьПривилегированныйРежим(Ложь);
	Если Не ПотребностиТорговыхТочек.СвояТочка(Точка) Тогда
		ВызватьИсключение НСтр("ru = 'Получить отгрузку может только своя точка или склад.';
			|fr = 'Seul le point de vente concerné ou l''entrepôt peut réceptionner l''expédition.';
			|en = 'Only the own store or the warehouse can receive the shipment.';
			|es = 'Solo el propio punto de venta o el almacén puede recibir el envío.'");
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Остатки.Отгрузка КАК Отгрузка
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек.Остатки(, Потребность = &Потребность) КАК Остатки
	|ГДЕ
	|	Остатки.Отгрузка <> ЗНАЧЕНИЕ(Документ.ПеремещениеТоваров.ПустаяСсылка)
	|	И Остатки.ОтгруженоОстаток > Остатки.ПолученоОстаток
	|	И НЕ Остатки.Отгрузка В
	|				(ВЫБРАТЬ
	|					Оприходования.Основание КАК Основание
	|				ИЗ
	|					Документ.ПеремещениеТоваров КАК Оприходования
	|				ГДЕ
	|					Оприходования.Проведен
	|					И Оприходования.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПеремещениеОприходование))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Отгрузка";
	// BSLLS:SetPrivilegedMode-off - поиск отгрузки своей точки; право точки проверяет ПолучитьОтгрузку модуля
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос.УстановитьПараметр("Потребность", Потребность);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение НСтр("ru = 'По потребности нет отгрузки, ожидающей получения.';
			|fr = 'Aucune expédition du besoin n''attend de réception.';
			|en = 'The need has no shipment waiting to be received.';
			|es = 'La necesidad no tiene envíos pendientes de recepción.'");
	КонецЕсли;
	Возврат ПотребностиТорговыхТочек.ПолучитьОтгрузку(Потребность, Выборка.Отгрузка);
КонецФункции

// Заполнение черновика потребности рекомендациями (команда «Заполнить по анализу»).
//
// Параметры:
//  Потребность - ДокументСсылка.ПотребностьТорговойТочки - черновик своей точки.
//
// Возвращаемое значение:
//  Строка - сообщение о товарах, которые нужно добавить вручную, или пустая строка.
//
Функция ЗаполнитьПоАнализу(Знач Потребность) Экспорт
	Возврат ПотребностиТорговыхТочек.ЗаполнитьПоАнализу(Потребность);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Принятие без правки склада: все строки с нулевым принятым принимаются полностью, если склад не ввёл ни одного
// принятого количества (иначе введённое - как есть, нули - отклонённые строки).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПотребностьТорговойТочки - принимаемая потребность.
//
Процедура ЗаполнитьПринятоПоУмолчанию(ДокОбъект)
	Если ДокОбъект.ТЧТовары.Итог("КоличествоПринято") <> 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Строка.КоличествоПринято = Строка.Количество;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
