// Серийный учёт (IMEI) номенклатуры с флагом УчетПоСерийнымНомерам (docs/plans/industry-phones.md).
//
// Инварианты: один IMEI - один экземпляр (остаток серии по складу и в сети - 0 или 1 по всей хронологии), приход без
// IMEI - только перемещением, возвратом по основанию и историческим регистратором в пределах разрешения, минус без
// IMEI запрещён. Проверки - в модуле набора ТоварыВНаличии (ПередЗаписьюНабора / ПриЗаписиНабора) и в подписках
// документов.
//
// Протокол блокировок (единый порядок): номенклатура (разделяемо) -> IMEI (исключительно, регистр СерийныеНомера по
// номеру, отсортированными) -> склады-справочник -> основания -> остатки. Новые входы записи движений подключаются через
// ЗаблокироватьСерииДокумента / ЗаблокироватьСерииДокументов до своих блокировок оснований и остатков; вход, не
// подключённый к протоколу, при встречном порядке получает от платформы ошибку взаимоблокировки (откат одной операции).
//
// Привилегированный режим - осознанно: инварианты экземпляра проверяются по всем движениям, номерам и складам
// независимо от прав роли пользователя, записывающего документ. BSLLS:SetPrivilegedMode-off

#Область ПрограммныйИнтерфейс

// Обработчик подписки ПередЗаписью документов-регистраторов ТоварыВНаличии: протокол блокировок, контекст
// промежуточной очистки, запрет записи без проведения, склады, разложение по сериям, комплекты, возврат.
//
// Параметры:
//  Источник        - ДокументОбъект - записываемый документ.
//  Отказ           - Булево - отказ записи.
//  РежимЗаписи     - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Источник.ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	НаборДвижений = Источник.Движения.ТоварыВНаличии;
	НаборДвижений.ДополнительныеСвойства.Удалить(ИмяЭтапа());
	НаборДвижений.ДополнительныеСвойства.Удалить(ИмяСнимка());
	Захват = ЗаблокироватьСерииДокумента(Источник);
	ЕстьСерийные = Захват.Серийные.Количество() > 0;
	ПоПродаже = ПравилоВозвратаПоПродаже(Источник);
	Если Не ЕстьСерийные И Не ПоПродаже Тогда
		Возврат;
	КонецЕсли;
	Тексты = Новый Массив;
	ПроведенВБазе = Не Источник.ЭтоНовый() И ДокументПроведен(Источник.Ссылка);
	Если РежимЗаписи = РежимЗаписиДокумента.Запись И ПроведенВБазе Тогда
		ПроверитьЗаписьПроведенного(Источник, ЕстьСерийные, ПоПродаже, Тексты);
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ПроверитьСерийныеСтроки(Источник, Захват, Тексты);
		ПроверитьВозврат(Источник, Захват, Тексты);
		Если ПроведенВБазе Тогда
			ПроверитьЗаморозкуПродажи(Источник, ПоПродаже, Тексты);
		КонецЕсли;
		Если ЕстьСерийные И ПроведенВБазе И УдаляетДвиженияАвтоматически(Источник) Тогда
			НаборДвижений.ДополнительныеСвойства.Вставить(ИмяЭтапа(), ЭтапОчистка());
		КонецЕсли;
	Иначе
		// Отмена проведения: серийные проверки - в наборе движений; продажа с возвратами при правиле - отказ.
		ПроверитьОтменуПродажи(Источник, ПоПродаже, Тексты);
	КонецЕсли;
	СообщитьТексты(Тексты, Отказ);
КонецПроцедуры

// Обработчик подписки ПередУдалением документов-регистраторов ТоварыВНаличии: документ с движениями серийной
// номенклатуры (проведённый или нет) не удаляется - сначала отмена проведения, проходящая проверки набора.
//
// Параметры:
//  Источник - ДокументОбъект - удаляемый документ.
//  Отказ    - Булево - отказ удаления.
//
Процедура ПередУдалениемДокумента(Источник, Отказ) Экспорт
	Если Источник.ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Записи.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	|		ПО Записи.Номенклатура = Товары.Ссылка
	|ГДЕ
	|	Записи.Регистратор = &Регистратор
	|	И Товары.УчетПоСерийнымНомерам");
	Запрос.УстановитьПараметр("Регистратор", Источник.Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		// Продажа с проведёнными возвратами при правиле «возврат только по продаже» не удаляется.
		Тексты = Новый Массив;
		ПроверитьОтменуПродажи(Источник, ПравилоВозвратаПоПродаже(Источник), Тексты);
		СообщитьТексты(Тексты, Отказ);
		Возврат;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
		"ru = 'Документ с движениями серийного товара не удаляется: сначала отмените проведение';
		|fr = 'Un document avec des mouvements d''articles à numéro de série ne se supprime pas : annulez d''abord la validation';
		|en = 'A document with serial item movements cannot be deleted: unpost it first';
		|es = 'Un documento con movimientos de artículos seriados no se elimina: anule primero la contabilización'"), , , ,
		Отказ);
КонецПроцедуры

// Барьер протокола блокировок для документа: разделяемая блокировка номенклатуры (строки, прежние движения,
// составляющие комплектов, каскад покрывающих налоговых документов), затем исключительная блокировка IMEI серийной
// номенклатуры. Вызывается первой строкой ПередЗаписью документов с собственными блокировками оснований и в начале
// ЗаполнитьБлокировкуПроведения; вне транзакции блокировки не берёт.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//
// Возвращаемое значение:
//  Структура - Серийные (Соответствие номенклатура -> Истина), Номера (Массив из Строка - захваченные IMEI),
//              НомераСерий (Соответствие серия -> номер).
//
Функция ЗаблокироватьСерииДокумента(ДокОбъект) Экспорт
	Ключи = НовыеКлючи();
	ДобавитьКлючиДанныхДокумента(Ключи, ДокОбъект);
	Ссылки = Новый Массив;
	Если Не ДокОбъект.ЭтоНовый() Тогда
		Ссылки.Добавить(ДокОбъект.Ссылка);
		ДобавитьКаскадНалоговыхДокументов(Ссылки, ДокОбъект.Ссылка);
	КонецЕсли;
	ДобавитьКлючиДвижений(Ключи, Ссылки);
	Возврат ЗахватитьКлючи(Ключи);
КонецФункции

// Барьер протокола блокировок для записанных документов (пакет рабочего места, основания платежа, получение отгрузки):
// номенклатура и IMEI по их движениям ТоварыВНаличии и строкам, одним упорядоченным захватом.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка - документы.
//
//  ДокОбъект - ДокументОбъект, Неопределено - записываемый документ: его номенклатура и серии - в тот же захват.
//
// Возвращаемое значение:
//  Массив из Строка - захваченные номера IMEI.
//
Функция ЗаблокироватьСерииДокументов(Ссылки, ДокОбъект = Неопределено) Экспорт
	Ключи = НовыеКлючи();
	СписокДокументов = Новый Массив;
	Если ДокОбъект <> Неопределено Тогда
		// Новые строки объекта и (у записанного) его прежние движения и строки в базе.
		ДобавитьКлючиДанныхДокумента(Ключи, ДокОбъект);
		Если Не ДокОбъект.ЭтоНовый() Тогда
			СписокДокументов.Добавить(ДокОбъект.Ссылка);
		КонецЕсли;
	КонецЕсли;
	Для Каждого Ссылка Из Ссылки Цикл
		Если ЗначениеЗаполнено(Ссылка) И СписокДокументов.Найти(Ссылка) = Неопределено Тогда
			СписокДокументов.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	ДобавитьКлючиДвижений(Ключи, СписокДокументов);
	ДобавитьКлючиСтрокДокументов(Ключи, СписокДокументов);
	Возврат ЗахватитьКлючи(Ключи).Номера;
КонецФункции

// Проверка после захвата блокировок оснований: номера IMEI документов не вышли за захваченные раньше (другой сеанс
// успел заменить серию) - иначе исключение «документы изменены, повторите» без добора блокировок.
//
// Параметры:
//  Ссылки    - Массив из ДокументСсылка - документы каскада после блокировки.
//  Захвачено - Массив из Строка - номера, захваченные до блокировки оснований.
//
Процедура ПроверитьНеизменностьСерий(Ссылки, Захвачено) Экспорт
	Ключи = НовыеКлючи();
	ДобавитьКлючиДвижений(Ключи, Ссылки);
	ДобавитьКлючиСтрокДокументов(Ключи, Ссылки);
	Серийные = СерийнаяНоменклатура(Ключи.Номенклатура);
	Для Каждого Номер Из НомераСерий(Ключи.Серии, Серийные) Цикл
		Если Захвачено.Найти(Номер.Значение) = Неопределено Тогда
			ВызватьИсключение ТекстДокументыИзменены();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Модуль набора ТоварыВНаличии, ПередЗаписью: барьер номенклатуры и IMEI набора, блокировка реализации-регистратора,
// снимок прежних записей серийной номенклатуры (накапливается в ДополнительныеСвойства набора до окончательной записи).
//
// Параметры:
//  Набор     - РегистрНакопленияНаборЗаписей.ТоварыВНаличии - записываемый набор.
//  Замещение - Булево - замещение прежних записей регистратора.
//
Процедура ПередЗаписьюНабора(Набор, Замещение) Экспорт
	Если Набор.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Набор.ДополнительныеСвойства.Удалить(ИмяДозаписи());
	Регистратор = Набор.Отбор.Регистратор.Значение;
	// Прежние записи регистратора читаются в обоих режимах: при дозаписи они остаются и входят в итог регистратора.
	Прежние = ПрежниеЗаписи(Регистратор);
	Ключи = НовыеКлючи();
	ДобавитьКлючиЗаписей(Ключи, Набор);
	ДобавитьКлючиЗаписей(Ключи, Прежние);
	// Перепроведение с автоудалением: прежние записи стёрты промежуточной очисткой, они - в снимке.
	Если Набор.ДополнительныеСвойства.Свойство(ИмяСнимка()) Тогда
		ДобавитьКлючиЗаписей(Ключи, Набор.ДополнительныеСвойства[ИмяСнимка()]);
	КонецЕсли;
	Захват = ЗахватитьКлючи(Ключи);
	Набор.ДополнительныеСвойства.Вставить(ИмяСерийнойНоменклатуры(), Захват.Серийные);
	Набор.ДополнительныеСвойства.Вставить(ИмяНомеровСерий(), Захват.НомераСерий);
	Если Захват.Серийные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ЗаблокироватьДокумент(Регистратор);
	КонецЕсли;
	Снимок = СнимокНабора(Набор);
	Остающиеся = Снимок.СкопироватьКолонки();
	Для Каждого Запись Из Прежние Цикл
		Если Захват.Серийные[Запись.Номенклатура] <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Снимок.Добавить(), Запись);
			ЗаполнитьЗначенияСвойств(Остающиеся.Добавить(), Запись);
		КонецЕсли;
	КонецЦикла;
	Если Не Замещение Тогда
		Набор.ДополнительныеСвойства.Вставить(ИмяДозаписи(), Остающиеся);
	КонецЕсли;
КонецПроцедуры

// Модуль набора ТоварыВНаличии, ПриЗаписи: проверки инвариантов серийного учёта по объединению снимка прежних
// записей и нового набора; промежуточная очистка документного перепроведения пропускается.
//
// Параметры:
//  Набор     - РегистрНакопленияНаборЗаписей.ТоварыВНаличии - записанный набор.
//  Отказ     - Булево - отказ записи.
//  Замещение - Булево - замещение прежних записей.
//
Процедура ПриЗаписиНабора(Набор, Отказ, Замещение) Экспорт
	Если Набор.ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	Свойства = Набор.ДополнительныеСвойства;
	Если Набор.Количество() = 0 И Свойства.Свойство(ИмяЭтапа()) И Свойства[ИмяЭтапа()] = ЭтапОчистка() Тогда
		Свойства.Вставить(ИмяЭтапа(), ЭтапЗапись());
		Возврат;
	КонецЕсли;
	Серийные = Неопределено;
	Если Не Свойства.Свойство(ИмяСерийнойНоменклатуры(), Серийные) Или Серийные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Контекст = КонтекстНабора(Набор, Серийные);
	Тексты = Новый Массив;
	ПроверитьЗаписиНабора(Контекст, Тексты);
	Если Тексты.Количество() = 0 Тогда
		ПроверитьПриходы(Контекст, Тексты);
	КонецЕсли;
	Если Тексты.Количество() = 0 Тогда
		ПроверитьХронологию(Контекст.КлючиСерий, Тексты);
		ПроверитьОстаткиБезСерии(Контекст.КлючиБезСерии, Тексты);
		ПроверитьВозвратыПродажи(Контекст, Тексты);
	КонецЕсли;
	Свойства.Удалить(ИмяСнимка());
	Свойства.Удалить(ИмяЭтапа());
	Свойства.Удалить(ИмяДозаписи());
	СообщитьТексты(Тексты, Отказ);
КонецПроцедуры

// Номенклатура, ПередЗаписью: флаг необратим, только у товара вне техкарт без характеристик; включение - под
// исключительной блокировкой номенклатуры с проверкой всей истории движений.
//
// Параметры:
//  Объект - СправочникОбъект.Номенклатура - записываемая номенклатура.
//  Отказ  - Булево - отказ записи.
//
Процедура ПередЗаписьюНоменклатуры(Объект, Отказ) Экспорт
	Если Объект.ОбменДанными.Загрузка Или Объект.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	Объект.ДополнительныеСвойства.Удалить(ИмяВключения());
	Было = Ложь;
	Если Не Объект.ЭтоНовый() Тогда
		Было = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, ИмяФлага()) = Истина;
	КонецЕсли;
	Тексты = Новый Массив;
	Если Было И Не Объект.УчетПоСерийнымНомерам Тогда
		Тексты.Добавить(НСтр("ru = 'Учёт по серийным номерам после включения не снимается';
			|fr = 'Le suivi par numéros de série ne se désactive pas après activation';
			|en = 'Serial number tracking cannot be turned off once enabled';
			|es = 'El control por números de serie no se desactiva una vez activado'"));
	ИначеЕсли Объект.УчетПоСерийнымНомерам И Объект.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Товар Тогда
		Тексты.Добавить(НСтр("ru = 'Учёт по серийным номерам - только для номенклатуры типа «Товар»';
			|fr = 'Le suivi par numéros de série est réservé aux articles de type « Marchandise »';
			|en = 'Serial number tracking is only for items of type ""Goods""';
			|es = 'El control por números de serie es solo para artículos de tipo «Mercancía»'"));
	ИначеЕсли Объект.УчетПоСерийнымНомерам И Не Было Тогда
		ПроверитьВключение(Объект, Тексты);
		Объект.ДополнительныеСвойства.Вставить(ИмяВключения(), Истина);
	Иначе
		// Флаг не меняется: проверять нечего.
		Возврат;
	КонецЕсли;
	СообщитьТексты(Тексты, Отказ);
КонецПроцедуры

// Номенклатура, ПриЗаписи: при включении - регистрация номеров серий и разрешений исторических приходов без серии.
//
// Параметры:
//  Объект - СправочникОбъект.Номенклатура - записанная номенклатура.
//  Отказ  - Булево - отказ записи.
//
Процедура ПриЗаписиНоменклатуры(Объект, Отказ) Экспорт
	Если Объект.ОбменДанными.Загрузка Или Отказ Или Не Объект.ДополнительныеСвойства.Свойство(ИмяВключения()) Тогда
		Возврат;
	КонецЕсли;
	Объект.ДополнительныеСвойства.Удалить(ИмяВключения());
	УстановитьПривилегированныйРежим(Истина);
	ЗарегистрироватьСерииНоменклатуры(Объект.Ссылка);
	ЗаписатьПереходныеРазрешения(Объект.Ссылка);
КонецПроцедуры

// Серия, ПередЗаписью: нормализация номера, блокировки владельцев и номеров, неизменность серии с движениями,
// уникальность номера серийной номенклатуры.
//
// Параметры:
//  Объект - СправочникОбъект.СерииНоменклатуры - записываемая серия.
//  Отказ  - Булево - отказ записи.
//
Процедура ПередЗаписьюСерии(Объект, Отказ) Экспорт
	Объект.ДополнительныеСвойства.Удалить(ИмяОсвобождаемогоНомера());
	Объект.ДополнительныеСвойства.Удалить(ИмяПрежнегоВладельца());
	Если Объект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Объект.Наименование = СокрЛП(Объект.Наименование);
	Прежняя = ПрежняяСерия(Объект);
	Владельцы = Новый Массив;
	Владельцы.Добавить(Объект.Владелец);
	Если ЗначениеЗаполнено(Прежняя.Владелец) И Прежняя.Владелец <> Объект.Владелец Тогда
		Владельцы.Добавить(Прежняя.Владелец);
		// Штрихкоды серии (IMEI и EAN) переходят к новому владельцу - поиск возвращает номенклатуру записи штрихкода.
		Объект.ДополнительныеСвойства.Вставить(ИмяПрежнегоВладельца(), Прежняя.Владелец);
	КонецЕсли;
	ЗаблокироватьНоменклатуру(Владельцы);
	Серийные = СерийнаяНоменклатура(Владельцы);
	Если Серийные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Номера = Новый Массив;
	Номера.Добавить(Объект.Наименование);
	Если ЗначениеЗаполнено(Прежняя.Номер) И Прежняя.Номер <> Объект.Наименование Тогда
		Номера.Добавить(Прежняя.Номер);
	КонецЕсли;
	ЗаблокироватьНомера(Номера);
	Прежняя = ПрежняяСерия(Объект);
	Тексты = Новый Массив;
	Изменена = Не Объект.ЭтоНовый() И (Прежняя.Владелец <> Объект.Владелец Или Прежняя.Номер <> Объект.Наименование);
	// Исправление IMEI (СерийныйУчет.ИсправитьНомерСерии) меняет только номер серии с движениями.
	Исправление = Объект.ДополнительныеСвойства.Свойство(ИмяИсправленияНомера()) И Прежняя.Владелец = Объект.Владелец;
	Если Изменена И Не Исправление И ЕстьДвиженияСерии(Объект.Ссылка) Тогда
		Тексты.Добавить(НСтр("ru = 'У серии есть движения: номер и владельца не изменить';
			|fr = 'La série a des mouvements : son numéro et son propriétaire ne se modifient pas';
			|en = 'The series has movements: its number and owner cannot be changed';
			|es = 'La serie tiene movimientos: su número y propietario no se cambian'"));
	ИначеЕсли Серийные[Объект.Владелец] <> Неопределено Тогда
		ПроверитьСвободуНомера(Объект.Наименование, Объект.Ссылка, Тексты);
		ПроверитьШтрихкодНомера(Объект.Наименование, Объект.Ссылка, Тексты);
	Иначе
		// Серия несерийного товара: номер не регистрируется, проверять нечего.
		Тексты.Очистить();
	КонецЕсли;
	// Смена номера или владельца: прежняя регистрация снимается, ПриЗаписиСерии регистрирует номер заново, если новый
	// владелец - серийный товар.
	Если Изменена И ЗначениеЗаполнено(Прежняя.Номер) Тогда
		Объект.ДополнительныеСвойства.Вставить(ИмяОсвобождаемогоНомера(), Прежняя.Номер);
	КонецЕсли;
	СообщитьТексты(Тексты, Отказ);
КонецПроцедуры

// Серия, ПриЗаписи: регистрация номера серийной номенклатуры и освобождение прежнего номера серии без движений.
//
// Параметры:
//  Объект - СправочникОбъект.СерииНоменклатуры - записанная серия.
//  Отказ  - Булево - отказ записи.
//
Процедура ПриЗаписиСерии(Объект, Отказ) Экспорт
	Если Объект.ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Освобождаемый = "";
	Если Объект.ДополнительныеСвойства.Свойство(ИмяОсвобождаемогоНомера(), Освобождаемый) Тогда
		УдалитьНомер(Освобождаемый, Объект.Ссылка);
	КонецЕсли;
	ПрежнийВладелец = Неопределено;
	Если Объект.ДополнительныеСвойства.Свойство(ИмяПрежнегоВладельца(), ПрежнийВладелец) Тогда
		ПеренестиШтрихкодыСерии(Объект.Ссылка, Объект.Владелец);
	КонецЕсли;
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Владелец, ИмяФлага()) = Истина Тогда
		ЗаписатьНомер(Объект.Наименование, Объект.Ссылка, Объект.Владелец);
	КонецЕсли;
КонецПроцедуры

// Серия, ПередУдалением: серия с движениями не удаляется (номер проданного экземпляра не освобождается); у серии без
// движений номер освобождается.
//
// Параметры:
//  Объект - СправочникОбъект.СерииНоменклатуры - удаляемая серия.
//  Отказ  - Булево - отказ удаления.
//
Процедура ПередУдалениемСерии(Объект, Отказ) Экспорт
	Если Объект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ЗаблокироватьНоменклатуру(ЗначениеВМассиве(Объект.Владелец));
	ЗаблокироватьНомера(ЗначениеВМассиве(СокрЛП(Объект.Наименование)));
	Если ЕстьДвиженияСерии(Объект.Ссылка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'У серии есть движения: удалить её нельзя';
			|fr = 'La série a des mouvements : elle ne peut pas être supprimée';
			|en = 'The series has movements: it cannot be deleted';
			|es = 'La serie tiene movimientos: no se puede eliminar'"), , , , Отказ);
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	УдалитьНомер(СокрЛП(Объект.Наименование), Объект.Ссылка);
КонецПроцедуры

// Характеристика, ПередЗаписью: серийной номенклатуре характеристики не заводятся (характеристика вне ключа контроля
// экземпляра); владельцы блокируются до чтения флага.
//
// Параметры:
//  Объект - СправочникОбъект.ХарактеристикиНоменклатуры - записываемая характеристика.
//  Отказ  - Булево - отказ записи.
//
Процедура ПередЗаписьюХарактеристики(Объект, Отказ) Экспорт
	Если Объект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Владельцы = ЗначениеВМассиве(Объект.Владелец);
	Если Не Объект.ЭтоНовый() Тогда
		Прежний = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "Владелец");
		Если ЗначениеЗаполнено(Прежний) И Прежний <> Объект.Владелец Тогда
			Владельцы.Добавить(Прежний);
		КонецЕсли;
	КонецЕсли;
	ЗаблокироватьНоменклатуру(Владельцы);
	Если СерийнаяНоменклатура(ЗначениеВМассиве(Объект.Владелец)).Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'Товару с учётом по серийным номерам характеристики не заводятся';
			|fr = 'Les articles suivis par numéro de série n''ont pas de caractéristiques';
			|en = 'Items with serial number tracking have no characteristics';
			|es = 'Los artículos con control por número de serie no tienen características'"), , , , Отказ);
	КонецЕсли;
КонецПроцедуры

// Техкарта, ПередЗаписью: серийная номенклатура не участвует в производстве; продукция и материалы блокируются до
// чтения флагов (включение флага и добавление в техкарту сериализуются).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ТехнологическаяКарта - записываемая техкарта.
//  Отказ     - Булево - отказ записи.
//
Процедура ПередЗаписьюТехкарты(ДокОбъект, Отказ) Экспорт
	Если ДокОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Товары = ДокОбъект.ТЧМатериалы.ВыгрузитьКолонку(ИмяНоменклатура());
	Товары.Добавить(ДокОбъект.Номенклатура);
	ЗаблокироватьНоменклатуру(Товары);
	Если СерийнаяНоменклатура(Товары).Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'Товар с учётом по серийным номерам не участвует в производстве (техкарте)';
			|fr = 'Un article suivi par numéro de série n''entre pas en production (fiche technique)';
			|en = 'An item with serial number tracking cannot be used in production (BOM)';
			|es = 'Un artículo con control por número de serie no participa en la producción (ficha técnica)'"), , , ,
			Отказ);
	КонецЕсли;
КонецПроцедуры

// Склад, ПередЗаписью: новая связь с подчинённым складом или ордерная схема у склада с серийными движениями (своими
// или подчинённого) - отказ; остатки складов блокируются исключительно до проверки истории.
//
// Параметры:
//  СкладОбъект - СправочникОбъект.МестаХранения - записываемый склад.
//  Прежние     - Структура - ОрдерныйСклад, ПодчиненныйСклад до записи.
//  Тексты      - Массив из Строка - тексты отказа (дополняется).
//
Процедура ПроверитьСклад(СкладОбъект, Прежние, Тексты) Экспорт
	СменаСвязи = СкладОбъект.ПодчиненныйСклад <> Прежние.ПодчиненныйСклад И ЗначениеЗаполнено(СкладОбъект.ПодчиненныйСклад);
	СтановитсяОрдерным = СкладОбъект.ОрдерныйСклад И Не Прежние.ОрдерныйСклад;
	Если Не (СменаСвязи Или СтановитсяОрдерным) Тогда
		Возврат;
	КонецЕсли;
	// У нового склада своих движений нет, но выбранный подчинённый склад мог двигать серийный товар.
	Склады = Новый Массив;
	Если Не СкладОбъект.ЭтоНовый() Тогда
		Склады.Добавить(СкладОбъект.Ссылка);
	КонецЕсли;
	Если ЗначениеЗаполнено(СкладОбъект.ПодчиненныйСклад) Тогда
		Склады.Добавить(СкладОбъект.ПодчиненныйСклад);
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Склад Из Склады Цикл
		Элемент = Блокировка.Добавить(ИмяТаблицыОстатков());
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("МестоХранения", Склад);
	КонецЦикла;
	Блокировка.Заблокировать();
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Записи.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	|		ПО Записи.Номенклатура = Товары.Ссылка
	|ГДЕ
	|	Записи.МестоХранения В (&Склады)
	|	И Товары.УчетПоСерийнымНомерам");
	Запрос.УстановитьПараметр("Склады", Склады);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Тексты.Добавить(НСтр("ru = 'На складе есть движения серийного товара: подчинённый склад и ордерная схема недоступны';
			|fr = 'L''entrepôt a des mouvements d''articles à numéro de série : entrepôt subordonné et schéma par ordres indisponibles';
			|en = 'The warehouse has serial item movements: subordinate warehouse and order scheme are not available';
			|es = 'El almacén tiene movimientos de artículos seriados: almacén subordinado y esquema de órdenes no disponibles'"));
	КонецЕсли;
КонецПроцедуры

// Проверка заполнения документа прихода (раннее сообщение; инвариант - в наборе): строка серийного товара - серии
// на всё количество, по 1 на каждую непустую серию. Исторические документы с разрешением не проверяются.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.ОприходованиеТоваров - документ.
//  Отказ     - Булево - отказ проверки.
//
Процедура ПроверитьЗаполнениеПрихода(ДокОбъект, Отказ) Экспорт
	Товары = ДокОбъект.ТЧТовары.ВыгрузитьКолонку(ИмяНоменклатура());
	Серийные = СерийнаяНоменклатура(Товары);
	Если Серийные.Количество() = 0 Или ЕстьРазрешение(ДокОбъект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Строка %1: укажите серийные номера (IMEI) на всё количество, по одному на единицу';
		|fr = 'Ligne %1 : indiquez les numéros de série (IMEI) pour toute la quantité, un par unité';
		|en = 'Row %1: enter serial numbers (IMEI) for the whole quantity, one per unit';
		|es = 'Fila %1: indique los números de serie (IMEI) para toda la cantidad, uno por unidad'");
	ЕстьТЧСерии = РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект, "ТЧСерии");
	Для Каждого СтрокаТаблицы Из ДокОбъект.ТЧТовары Цикл
		Если Серийные[СтрокаТаблицы.Номенклатура] <> Неопределено И Не СерииНаВсеКоличество(ДокОбъект, СтрокаТаблицы, ЕстьТЧСерии) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, СтрокаТаблицы.НомерСтроки), ДокОбъект, , , Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Правило «возврат от покупателя только по документу продажи» (константа, чтение - привилегированно: рабочим ролям
// права на константу не нужны).
//
// Возвращаемое значение:
//  Булево - Истина: правило включено.
//
Функция ВозвратТолькоПоПродаже() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ВозвратТолькоПоПродаже.Получить() = Истина;
КонецФункции

// Проверка основания возврата от покупателя до построчной проверки возвратов (она на пустом основании падает): при
// правиле «только по продаже» - для всех строк, без него - при серийных строках. Только при проведении.
//
// Параметры:
//  ДокОбъект   - ДокументОбъект.ВозвратОтПокупателя - возврат.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  Отказ       - Булево - отказ записи.
//
Процедура ПроверитьОснованиеВозврата(ДокОбъект, РежимЗаписи, Отказ) Экспорт
	Если ДокОбъект.ОбменДанными.Загрузка Или РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	Если Не ВозвратТолькоПоПродаже() Тогда
		Товары = ДокОбъект.ТЧТовары.ВыгрузитьКолонку(ИмяНоменклатура());
		Если СерийнаяНоменклатура(Товары).Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Ошибка = ОшибкаОснованияВозврата(ДокОбъект.Основание);
	Если Не ПустаяСтрока(Ошибка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Ошибка, ДокОбъект, "Основание", , Отказ);
	КонецЕсли;
КонецПроцедуры

// Товар и серия по номеру IMEI - привилегированное чтение регистра СерийныеНомера (рабочим ролям права на регистр не
// выдаются): только точное совпадение одного номера, возвращаются ссылки - то же, что даёт скан штрихкода серии.
//
// Параметры:
//  Номер - Строка - введённое или отсканированное значение.
//
// Возвращаемое значение:
//  Структура, Неопределено - Номенклатура, Серия; Неопределено - номер не зарегистрирован.
//
Функция ТоварПоНомеру(Номер) Экспорт
	Значение = СокрЛП(Номер);
	// Номер раскрывает товар и серию - только пользователю с правом их чтения (роль «Клиент» его не имеет).
	ЕстьПраво = ПравоДоступа("Чтение", Метаданные.Справочники.СерииНоменклатуры)
		И ПравоДоступа("Чтение", Метаданные.Справочники.Номенклатура);
	Если ПустаяСтрока(Значение) Или Не ЕстьПраво Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Номера.Номенклатура КАК Номенклатура,
	|	Номера.Серия КАК Серия
	|ИЗ
	|	РегистрСведений.СерийныеНомера КАК Номера
	|ГДЕ
	|	Номера.СерийныйНомер = &Номер");
	Запрос.УстановитьПараметр("Номер", Значение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Номенклатура, Серия", Выборка.Номенклатура, Выборка.Серия);
КонецФункции

// Признак серии серийного товара (правило повторного скана IMEI).
//
// Параметры:
//  Серия - СправочникСсылка.СерииНоменклатуры - серия.
//
// Возвращаемое значение:
//  Булево - Истина: владелец серии - серийный товар.
//
Функция ЭтоСерияСерийногоТовара(Серия) Экспорт
	// Признак владельца - только пользователю с правом чтения серий (метод вызывается с клиента).
	Если Не ЗначениеЗаполнено(Серия) Или Не ПравоДоступа("Чтение", Метаданные.Справочники.СерииНоменклатуры) Тогда
		Возврат Ложь;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Владелец = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Серия, "Владелец");
	Возврат ЗначениеЗаполнено(Владелец) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Владелец, ИмяФлага()) = Истина;
КонецФункции

// Гарантия товаров в месяцах - дополнительный реквизит «ГарантияМесяцев» (отрасль «Телефоны и аксессуары»).
//
// Параметры:
//  Товары - Массив из СправочникСсылка.Номенклатура - товары.
//
// Возвращаемое значение:
//  Соответствие - товар -> число месяцев (только заполненные).
//
Функция ГарантияМесяцев(Товары) Экспорт
	Результат = Новый Соответствие;
	УстановитьПривилегированныйРежим(Истина);
	Свойство = УправлениеСвойствами.НайтиСвойство("Справочник.Номенклатура", ИмяГарантии());
	Если Не ЗначениеЗаполнено(Свойство) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Ссылка,
	|	Реквизиты.Значение КАК Значение
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка В (&Товары)
	|	И Реквизиты.Свойство = &Свойство");
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.Значение) = Тип("Число") И Выборка.Значение > 0 Тогда
			Результат.Вставить(Выборка.Ссылка, Выборка.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Номера IMEI строк товаров документов для печати: строка без признака нескольких серий - её серия, с признаком -
// серии ТЧСерии по коду строки. Только серийная номенклатура.
//
// Параметры:
//  ИмяДокумента - Строка - имя документа (с табличными частями ТЧТовары и, если есть, ТЧСерии).
//  Ссылки       - Массив из ДокументСсылка - документы.
//
// Возвращаемое значение:
//  Соответствие - «уникальный идентификатор документа|номер строки ТЧТовары» -> Массив из Строка (номера).
//
Функция СерииСтрокДокументов(ИмяДокумента, Ссылки) Экспорт
	Результат = Новый Соответствие;
	// IMEI - наименование серии: печатается только пользователю с правом чтения серий.
	Если Не ПравоДоступа("Чтение", Метаданные.Справочники.СерииНоменклатуры) Тогда
		Возврат Результат;
	КонецЕсли;
	МД = Метаданные.Документы.Найти(ИмяДокумента);
	Если МД = Неопределено Или МД.ТабличныеЧасти.Найти("ТЧТовары") = Неопределено
		Или МД.ТабличныеЧасти.ТЧТовары.Реквизиты.Найти("Серия") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ЕстьТЧСерии = МД.ТабличныеЧасти.Найти("ТЧСерии") <> Неопределено;
	Для Каждого Ссылка Из Ссылки Цикл
		ДобавитьСерииСтрокДокумента(Результат, Ссылка, ЕстьТЧСерии);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Исправление ошибочно введённого IMEI: та же серия (движения не меняются) получает новый номер, номер и штрихкод
// перерегистрируются, событие пишется в журнал регистрации. Только руководителю или администратору с правом изменения
// серий.
//
// Параметры:
//  Серия      - СправочникСсылка.СерииНоменклатуры - серия серийного товара.
//  НовыйНомер - Строка - правильный номер.
//
Процедура ИсправитьНомерСерии(Серия, НовыйНомер) Экспорт
	ПроверитьПравоИсправленияНомера();
	Номер = СокрЛП(НовыйНомер);
	Если ПустаяСтрока(Номер) Или Не ЗначениеЗаполнено(Серия) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите новый номер IMEI'; fr = 'Indiquez le nouveau numéro IMEI';
			|en = 'Enter the new IMEI number'; es = 'Indique el nuevo número IMEI'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		ИсправитьНомерВТранзакции(Серия, Номер);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Обработчик обновления 2.0.17.11: правило «возврат только по продаже» в базах отрасли «Телефоны и аксессуары»,
// предупреждение о строках серийных товаров с неоднозначным кодом строки.
//
Процедура ПерейтиНаВозвратПоПродаже() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если Константы.Отрасль.Получить() = Перечисления.Отрасли.ТелефоныИАксессуары
		И Не Константы.ВозвратТолькоПоПродаже.Получить() Тогда
		Константы.ВозвратТолькоПоПродаже.Установить(Истина);
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Товары
	|ГДЕ
	|	Товары.УчетПоСерийнымНомерам");
	Товары = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	ИмяСобытия = НСтр("ru = 'Серийный учёт'", КодЯзыка);
	Шаблон = НСтр("ru = 'Строка товара %1 с несколькими сериями: нет уникального кода строки (%2) - удалите строку и
		|добавьте её заново'", КодЯзыка);
	Для Каждого СтрокаТаблицы Из СтрокиСНеоднозначнымКодом(Товары) Цикл
		Комментарий = СтрШаблон(Шаблон, СтрокаТаблицы.Номенклатура, СтрокаТаблицы.КодСтроки);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение,
			СтрокаТаблицы.Ссылка.Метаданные(), СтрокаТаблицы.Ссылка, Комментарий);
	КонецЦикла;
КонецПроцедуры

// Может ли пользователь исправлять IMEI (видимость команды формы серии; проверка - на сервере при исправлении).
//
// Возвращаемое значение:
//  Булево - Истина: право изменения серий и роль «Руководитель» или «Администратор».
//
Функция ЕстьПравоИсправленияНомера() Экспорт
	// BSLLS:IsInRoleMethod-off - исправление номера - решение руководителя, у кладовщика право изменения серий тоже есть
	Возврат ПравоДоступа("Изменение", Метаданные.Справочники.СерииНоменклатуры)
		И (РольДоступна("Руководитель") Или РольДоступна("Администратор"));
	// BSLLS:IsInRoleMethod-on
КонецФункции

// Есть ли среди товаров товар с учётом по серийным номерам (печать решает, читать ли серии строк).
//
// Параметры:
//  Товары - Массив - товары (ссылки других типов пропускаются).
//
// Возвращаемое значение:
//  Булево - Истина: есть.
//
Функция ЕстьСерийнаяНоменклатура(Товары) Экспорт
	Номенклатура = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Если ТипЗнч(Товар) = Тип("СправочникСсылка.Номенклатура") И ЗначениеЗаполнено(Товар) Тогда
			Номенклатура.Добавить(Товар);
		КонецЕсли;
	КонецЦикла;
	Возврат СерийнаяНоменклатура(Номенклатура).Количество() > 0;
КонецФункции

// Включена ли отрасль серийного учёта для номенклатуры (для форм и тестов).
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар.
//
// Возвращаемое значение:
//  Булево - Истина: учёт по серийным номерам.
//
Функция ЭтоСерийнаяНоменклатура(Номенклатура) Экспорт
	Возврат СерийнаяНоменклатура(ЗначениеВМассиве(Номенклатура))[Номенклатура] <> Неопределено;
КонецФункции

