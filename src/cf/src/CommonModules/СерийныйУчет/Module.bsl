// Представление документа в сообщении проверки: проверки идут привилегированно по всем движениям, а документ может
// быть закрыт пользователю ролью или ограничением доступа к записям. Полное представление - администратору, остальным
// - без номера и даты; документ пишется в журнал регистрации (событие «Серийный учёт»).
//
// Параметры:
//  Ссылка - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  Строка - представление.
//
Функция ПредставлениеРегистратора(Ссылка)
	Если ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат Строка(Ссылка);
	КонецЕсли;
	ИмяСобытия = НСтр("ru = 'Серийный учёт'", ОбщегоНазначения.КодОсновногоЯзыка());
	Комментарий = НСтр("ru = 'Документ в сообщении проверки серийного учёта скрыт от пользователя'",
		ОбщегоНазначения.КодОсновногоЯзыка());
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, Ссылка.Метаданные(), Ссылка,
		Комментарий);
	Возврат НСтр("ru = '(документ - в журнале регистрации, событие «Серийный учёт»)';
		|fr = '(document dans le journal d''enregistrement, événement « Suivi des numéros de série »)';
		|en = '(document in the event log, event ""Serial number tracking"")';
		|es = '(documento en el registro de eventos, evento «Control de números de serie»)'");
КонецФункции

Функция ТекстНомерЗанят()
	Возврат НСтр("ru = 'IMEI %1 уже зарегистрирован у товара %2'; fr = 'L''IMEI %1 est déjà enregistré pour l''article %2';
		|en = 'IMEI %1 is already registered for item %2'; es = 'El IMEI %1 ya está registrado para el artículo %2'");
КонецФункции

Функция ТекстДокументыИзменены()
