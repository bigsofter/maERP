		|fr = 'Les documents ont été modifiés par un autre utilisateur pendant l''enregistrement - répétez l''opération';
		|en = 'The documents were changed by another user during the write - repeat the operation';
		|es = 'Los documentos fueron modificados por otro usuario durante la grabación - repita la operación'");
КонецФункции

#КонецОбласти

#Область СборКлючей

// Номенклатура и серии из реквизитов шапки и табличных частей документа (типы СправочникСсылка.Номенклатура и
// СправочникСсылка.СерииНоменклатуры, в т. ч. стороны оприходования пересортицы).
//
// Параметры:
//  Ключи     - Структура - см. НовыеКлючи; дополняется.
//  ДокОбъект - ДокументОбъект - документ.
//
Процедура ДобавитьКлючиДанныхДокумента(Ключи, ДокОбъект)
	МД = ДокОбъект.Метаданные();
	ТипНоменклатуры = Тип("СправочникСсылка.Номенклатура");
	ТипСерии = Тип("СправочникСсылка.СерииНоменклатуры");
	Для Каждого Реквизит Из МД.Реквизиты Цикл
		ДобавитьЗначениеКлюча(Ключи, ДокОбъект[Реквизит.Имя], ТипНоменклатуры, ТипСерии);
	КонецЦикла;
	Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
		Колонки = Новый Массив;
		Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
			Если Реквизит.Тип.СодержитТип(ТипНоменклатуры) Или Реквизит.Тип.СодержитТип(ТипСерии) Тогда
				Колонки.Добавить(Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаТаблицы Из ДокОбъект[ТЧ.Имя] Цикл
			Для Каждого Колонка Из Колонки Цикл
				ДобавитьЗначениеКлюча(Ключи, СтрокаТаблицы[Колонка], ТипНоменклатуры, ТипСерии);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьЗначениеКлюча(Ключи, Значение, ТипНоменклатуры, ТипСерии)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) = ТипНоменклатуры Тогда
		Ключи.Номенклатура.Добавить(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) = ТипСерии Тогда
		Ключи.Серии.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

// Номенклатура и серии прежних движений ТоварыВНаличии документов.
//
// Параметры:
//  Ключи  - Структура - см. НовыеКлючи; дополняется.
//  Ссылки - Массив из ДокументСсылка - регистраторы.
//
Процедура ДобавитьКлючиДвижений(Ключи, Ссылки)
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Записи.Номенклатура КАК Номенклатура,
	|	Записи.Серия КАК Серия
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Регистратор В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключи.Номенклатура.Добавить(Выборка.Номенклатура);
		Если ЗначениеЗаполнено(Выборка.Серия) Тогда
			Ключи.Серии.Добавить(Выборка.Серия);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Номенклатура и серии строк записанных документов (по базе).
//
// Параметры:
//  Ключи  - Структура - см. НовыеКлючи; дополняется.
//  Ссылки - Массив из ДокументСсылка - документы.
//
Процедура ДобавитьКлючиСтрокДокументов(Ключи, Ссылки)
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Ссылка Из Ссылки Цикл
		ДобавитьКлючиДанныхДокумента(Ключи, Ссылка.ПолучитьОбъект());
	КонецЦикла;
КонецПроцедуры

// Номенклатура и серии записей набора или таблицы записей.
//
// Параметры:
//  Ключи  - Структура - см. НовыеКлючи; дополняется.
//  Записи - РегистрНакопленияНаборЗаписей, ТаблицаЗначений - записи.
//
Процедура ДобавитьКлючиЗаписей(Ключи, Записи)
	Для Каждого Запись Из Записи Цикл
		Ключи.Номенклатура.Добавить(Запись.Номенклатура);
		Если ЗначениеЗаполнено(Запись.Серия) Тогда
			Ключи.Серии.Добавить(Запись.Серия);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Покрывающие налоговые документы ссылки и остальные их основания (каскад перепроведения).
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка - дополняется.
//  Ссылка - ДокументСсылка - документ.
//
Процедура ДобавитьКаскадНалоговыхДокументов(Ссылки, Ссылка)
	Если Не (ТипЗнч(Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг")) Тогда
		Возврат;
	КонецЕсли;
	Если НалоговыеДокументыНаОснованиях.ЭтоРегистраторНаОснованиях(Ссылка) Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Ссылки, ОснованияДокументов(ЗначениеВМассиве(Ссылка)), Истина);
		Возврат;
	КонецЕсли;
	СписокДокументов = НалоговыеДокументыНаОснованиях.ПокрывающиеДокументы(ЗначениеВМассиве(Ссылка)).ВыгрузитьКолонку("Ссылка");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Ссылки, СписокДокументов, Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Ссылки, ОснованияДокументов(СписокДокументов), Истина);
КонецПроцедуры

// Основания налоговых документов на основаниях.
//
// Параметры:
//  СписокДокументов - Массив из ДокументСсылка - налоговые документы.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка - основания.
//
Функция ОснованияДокументов(СписокДокументов)
	УстановитьПривилегированныйРежим(Истина);
	Результат = Новый Массив;
	Для Каждого Документ Из СписокДокументов Цикл
		Для Каждого СтрокаТаблицы Из Документ.Основания Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы.Основание) И Результат.Найти(СтрокаТаблицы.Основание) = Неопределено Тогда
				Результат.Добавить(СтрокаТаблицы.Основание);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Номенклатура вместе с составляющими комплектов.
//
// Параметры:
//  Номенклатура - Массив - товары.
//
// Возвращаемое значение:
//  Массив - товары без повторов.
//
Функция НоменклатураСоСоставляющими(Номенклатура)
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить(ИмяНоменклатура(), Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Для Каждого Товар Из Номенклатура Цикл
		Если ЗначениеЗаполнено(Товар) Тогда
			Таблица.Добавить().Номенклатура = Товар;
		КонецЕсли;
	КонецЦикла;
	Если Таблица.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Возврат РегистрыНакопления.ТоварыВНаличии.НоменклатураССоставляющими(Таблица).ВыгрузитьКолонку(ИмяНоменклатура());
КонецФункции

// Серийная номенклатура из списка (флаг читается привилегированно).
//
// Параметры:
//  Номенклатура - Массив - товары.
//
// Возвращаемое значение:
//  Соответствие - серийный товар -> Истина.
//
Функция СерийнаяНоменклатура(Номенклатура)
	Результат = Новый Соответствие;
	Если Номенклатура.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Товары
	|ГДЕ
	|	Товары.Ссылка В (&Номенклатура)
	|	И Товары.УчетПоСерийнымНомерам");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Нормализованные номера серий серийной номенклатуры.
//
// Параметры:
//  Серии    - Массив из СправочникСсылка.СерииНоменклатуры - серии.
//  Серийные - Соответствие - см. СерийнаяНоменклатура.
//
// Возвращаемое значение:
//  Соответствие - серия -> номер (наименование без пробелов по краям).
//
Функция НомераСерий(Серии, Серийные)
	Результат = Новый Соответствие;
	Если Серии.Количество() = 0 Или Серийные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Серии.Ссылка КАК Ссылка,
	|	Серии.Наименование КАК Наименование,
	|	Серии.Владелец КАК Владелец
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК Серии
	|ГДЕ
	|	Серии.Ссылка В (&Серии)");
	Запрос.УстановитьПараметр("Серии", Серии);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Серийные[Выборка.Владелец] <> Неопределено Тогда
			Результат.Вставить(Выборка.Ссылка, СокрЛП(Выборка.Наименование));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПроверкиДокумента

// Склады документа под разделяемой блокировкой справочника: для серийного товара не ордерные на дату документа, без
// подчинённого и не подчинённые.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//  Захват    - Структура - см. ЗаблокироватьСерииДокумента.
//  Тексты    - Массив из Строка - дополняется.
//
Процедура ПроверитьСкладыДокумента(ДокОбъект, Захват, Тексты)
	Склады = СкладыДокумента(ДокОбъект);
	Если Склады.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Склад Из УпорядоченныеСсылки(Склады) Цикл
		Элемент = Блокировка.Добавить("Справочник.МестаХранения");
		Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
		Элемент.УстановитьЗначение("Ссылка", Склад);
	КонецЦикла;
	Блокировка.Заблокировать();
	Для Каждого Склад Из НедопустимыеСклады(Склады, ДокОбъект.Дата) Цикл
		Шаблон = НСтр("ru = 'Серийный товар не учитывается на складе %1 (ордерный, с подчинённым или подчинённый склад)';
			|fr = 'Les articles à numéro de série ne sont pas suivis dans l''entrepôt %1 (par ordres, avec subordonné ou subordonné)';
			|en = 'Serial items are not tracked in warehouse %1 (order-based, with a subordinate or subordinate)';
			|es = 'Los artículos seriados no se controlan en el almacén %1 (por órdenes, con subordinado o subordinado)'");
		Тексты.Добавить(СтрШаблон(Шаблон, Склад));
	КонецЦикла;
КонецПроцедуры

// Склады документа: реквизиты типа МестаХранения шапки и табличных частей.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.МестаХранения - склады.
//
Функция СкладыДокумента(ДокОбъект)
	Склады = Новый Массив;
	ТипСклада = Тип("СправочникСсылка.МестаХранения");
	МД = ДокОбъект.Метаданные();
	Для Каждого Реквизит Из МД.Реквизиты Цикл
		Значение = ДокОбъект[Реквизит.Имя];
		Если ТипЗнч(Значение) = ТипСклада И ЗначениеЗаполнено(Значение) Тогда
			Склады.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
		Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
			Если Реквизит.Тип.СодержитТип(ТипСклада) Тогда
				ДобавитьСкладыКолонки(Склады, ДокОбъект[ТЧ.Имя], Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Склады;
КонецФункции

Процедура ДобавитьСкладыКолонки(Склады, Таблица, Колонка)
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы[Колонка]) Тогда
			Склады.Добавить(СтрокаТаблицы[Колонка]);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Склады, на которых серийный товар не учитывается: ордерный на дату, с подчинённым, подчинённый другого склада.
//
// Параметры:
//  Склады - Массив - склады.
//  Дата   - Дата - дата движения.
//
// Возвращаемое значение:
//  Массив - недопустимые склады.
//
Функция НедопустимыеСклады(Склады, Дата)
	Данные = ДанныеСкладов(Склады);
	Результат = Новый Массив;
	Для Каждого Склад Из Склады Цикл
		Если СкладНедопустим(Данные, Склад, Дата) И Результат.Найти(Склад) = Неопределено Тогда
			Результат.Добавить(Склад);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Режимы складов одним запросом: ордерность с датой начала схемы, связь с подчинённым складом.
//
// Параметры:
//  Склады - Массив - склады.
//
// Возвращаемое значение:
//  Соответствие - склад -> Структура (ОрдерныйСклад, ДатаНачала, СвязьПодчинения).
//
Функция ДанныеСкладов(Склады)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка,
	|	Склады.ОрдерныйСклад КАК ОрдерныйСклад,
	|	Склады.ДатаНачалаОрдернойСхемы КАК ДатаНачалаОрдернойСхемы,
	|	Склады.ПодчиненныйСклад КАК ПодчиненныйСклад,
	|	ВЫБОР
	|		КОГДА Главные.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Подчиненный
	|ИЗ
	|	Справочник.МестаХранения КАК Склады
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.МестаХранения КАК Главные
	|		ПО (Главные.ПодчиненныйСклад = Склады.Ссылка)
	|ГДЕ
	|	Склады.Ссылка В (&Склады)");
	Запрос.УстановитьПараметр("Склады", Склады);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Связь = ЗначениеЗаполнено(Выборка.ПодчиненныйСклад) Или Выборка.Подчиненный;
		Прежние = Результат[Выборка.Ссылка];
		Связь = Связь Или Прежние <> Неопределено И Прежние.СвязьПодчинения;
		Режим = Новый Структура("ОрдерныйСклад, ДатаНачала, СвязьПодчинения",
			Выборка.ОрдерныйСклад, Выборка.ДатаНачалаОрдернойСхемы, Связь);
		Результат.Вставить(Выборка.Ссылка, Режим);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Склад недопустим для серийного товара на дату: ордерный на дату, с подчинённым или подчинённый.
//
// Параметры:
//  Данные - Соответствие - см. ДанныеСкладов.
//  Склад  - СправочникСсылка.МестаХранения - склад.
//  Дата   - Дата - дата движения.
//
// Возвращаемое значение:
//  Булево - Истина: недопустим.
//
Функция СкладНедопустим(Данные, Склад, Дата)
	РежимСклада = Данные[Склад];
	Если РежимСклада = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат РежимСклада.СвязьПодчинения
		Или Справочники.МестаХранения.ОрдерныйНаДату(РежимСклада.ОрдерныйСклад, РежимСклада.ДатаНачала, Дата);
КонецФункции

// Полнота разложения по сериям: строка серийного товара с признаком нескольких серий - сумма серий равна количеству
// строки, каждая непустая серия - 1; без признака - непустая серия при количестве 1.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//  Захват    - Структура - см. ЗаблокироватьСерииДокумента.
//  Тексты    - Массив из Строка - дополняется.
//
Процедура ПроверитьРазложениеПоСериям(ДокОбъект, Захват, Тексты)
	Если Не РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект, "ТЧТовары") Тогда
		Возврат;
	КонецЕсли;
	ЕстьТЧСерии = РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект, "ТЧСерии");
	Шаблон = НСтр("ru = 'Строка %1: серии серийного товара не совпадают с количеством (по одной единице на номер)';
		|fr = 'Ligne %1 : les séries de l''article ne correspondent pas à la quantité (une unité par numéro)';
		|en = 'Row %1: the serial item series do not match the quantity (one unit per number)';
		|es = 'Fila %1: las series del artículo no coinciden con la cantidad (una unidad por número)'");
	Для Каждого СтрокаТаблицы Из ДокОбъект.ТЧТовары Цикл
		Если Захват.Серийные[СтрокаТаблицы.Номенклатура] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не РазложениеСтрокиВерно(ДокОбъект, СтрокаТаблицы, ЕстьТЧСерии) Тогда
			Тексты.Добавить(СтрШаблон(Шаблон, СтрокаТаблицы.НомерСтроки));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Разложение строки по сериям: сумма серий равна количеству, каждая непустая серия - 1.
//
// Параметры:
//  ДокОбъект   - ДокументОбъект - документ.
//  СтрокаТаблицы - СтрокаТабличнойЧасти - строка товара.
//  ЕстьТЧСерии - Булево - у документа есть ТЧСерии.
//
// Возвращаемое значение:
//  Булево - Истина: разложение верно.
//
Функция РазложениеСтрокиВерно(ДокОбъект, СтрокаТаблицы, ЕстьТЧСерии)
	Несколько = РаботаСДокументамиКлиентСервер.ЕстьРеквизит(СтрокаТаблицы, "УказаноНесколькоСерий") И СтрокаТаблицы.УказаноНесколькоСерий;
	Если Несколько И ЕстьТЧСерии Тогда
		Сумма = 0;
		Для Каждого СтрокаСерии Из ДокОбъект.ТЧСерии.НайтиСтроки(Новый Структура("КодСтроки", СтрокаТаблицы.КодСтроки)) Цикл
			Если ЗначениеЗаполнено(СтрокаСерии.Серия) И СтрокаСерии.Количество <> 1 Тогда
				Возврат Ложь;
			КонецЕсли;
			Сумма = Сумма + СтрокаСерии.Количество;
		КонецЦикла;
		Возврат Сумма = СтрокаТаблицы.Количество;
	КонецЕсли;
	Если Не РаботаСДокументамиКлиентСервер.ЕстьРеквизит(СтрокаТаблицы, "Серия") Или Не ЗначениеЗаполнено(СтрокаТаблицы.Серия) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат СтрокаТаблицы.Количество = 1;
КонецФункции

// Серии строки документа прихода на всё количество, непустые, по 1.
//
// Параметры:
//  ДокОбъект   - ДокументОбъект - документ.
//  СтрокаТаблицы - СтрокаТабличнойЧасти - строка товара.
//  ЕстьТЧСерии - Булево - у документа есть ТЧСерии.
//
// Возвращаемое значение:
//  Булево - Истина: серии указаны.
//
Функция СерииНаВсеКоличество(ДокОбъект, СтрокаТаблицы, ЕстьТЧСерии)
	Несколько = РаботаСДокументамиКлиентСервер.ЕстьРеквизит(СтрокаТаблицы, "УказаноНесколькоСерий") И СтрокаТаблицы.УказаноНесколькоСерий;
	Если Несколько И ЕстьТЧСерии Тогда
		Сумма = 0;
		Для Каждого СтрокаСерии Из ДокОбъект.ТЧСерии.НайтиСтроки(Новый Структура("КодСтроки", СтрокаТаблицы.КодСтроки)) Цикл
			Если Не ЗначениеЗаполнено(СтрокаСерии.Серия) Или СтрокаСерии.Количество <> 1 Тогда
				Возврат Ложь;
			КонецЕсли;
			Сумма = Сумма + 1;
		КонецЦикла;
		Возврат Сумма = СтрокаТаблицы.Количество;
	КонецЕсли;
	Возврат РаботаСДокументамиКлиентСервер.ЕстьРеквизит(СтрокаТаблицы, "Серия") И ЗначениеЗаполнено(СтрокаТаблицы.Серия)
		И СтрокаТаблицы.Количество = 1;
КонецФункции

// Комплект с серийными составляющими не проводится: серия составляющей при разложении комплекта не назначается.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//  Тексты    - Массив из Строка - дополняется.
//
Процедура ПроверитьКомплекты(ДокОбъект, Тексты)
	Если Не РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект, "ТЧТовары") Тогда
		Возврат;
	КонецЕсли;
	Товары = ДокОбъект.ТЧТовары.ВыгрузитьКолонку(ИмяНоменклатура());
	Составляющие = НоменклатураСоСоставляющими(Товары);
	Для Каждого Товар Из Товары Цикл
		Индекс = Составляющие.Найти(Товар);
		Если Индекс <> Неопределено Тогда
			Составляющие.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	Если СерийнаяНоменклатура(Составляющие).Количество() > 0 Тогда
		Тексты.Добавить(НСтр("ru = 'Комплект с серийными составляющими не проводится: серии составляющим не назначаются';
			|fr = 'Un kit avec des composants à numéro de série ne se valide pas : les séries ne sont pas affectées';
			|en = 'A kit with serial components cannot be posted: series are not assigned to components';
			|es = 'Un kit con componentes seriados no se contabiliza: no se asignan series a los componentes'"));
	КонецЕсли;
КонецПроцедуры

// Возврат от покупателя серийного товара: основание - физическая продажа (не налоговый документ на основаниях), под
// её блокировкой количество по ключу «номенклатура + характеристика + серия» не больше проданного по движениям
// продажи за вычетом других проведённых возвратов.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//  Захват    - Структура - см. ЗаблокироватьСерииДокумента.
//  Тексты    - Массив из Строка - дополняется.
//
Процедура ПроверитьВозврат(ДокОбъект, Захват, Тексты)
	Если ТипЗнч(ДокОбъект) <> Тип("ДокументОбъект.ВозвратОтПокупателя") Тогда
		Возврат;
	КонецЕсли;
	Строки = СерииИРазмещение.ОбъединитьТоварыССериями(ДокОбъект);
	Серийные = Строки.СкопироватьКолонки();
	Для Каждого СтрокаТаблицы Из Строки Цикл
		Если Захват.Серийные[СтрокаТаблицы.Номенклатура] <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Серийные.Добавить(), СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	Если Серийные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Основание = ДокОбъект.Основание;
	ЭтоПродажа = ТипЗнч(Основание) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И ЗначениеЗаполнено(Основание)
		И Не НалоговыеДокументыНаОснованиях.ЭтоРегистраторНаОснованиях(Основание);
	Если Не ЭтоПродажа Тогда
		Тексты.Добавить(ТекстВозвратТолькоПоПродаже());
		Возврат;
	КонецЕсли;
	ЗаблокироватьДокумент(Основание);
	Серийные.Свернуть(ПоляКлючаВозврата(), "Количество");
	Доступно = ДоступноКВозврату(Основание, ДокОбъект.Ссылка);
	Шаблон = ТекстВозвратБольшеПроданного();
	Для Каждого СтрокаТаблицы Из Серийные Цикл
		Отбор = Новый Структура(ПоляКлючаВозврата());
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаТаблицы);
		Найдено = Доступно.НайтиСтроки(Отбор);
		Остаток = ?(Найдено.Количество() = 0, 0, Найдено[0].Количество);
		Если СтрокаТаблицы.Количество > Остаток Тогда
			Представление = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(СтрокаТаблицы.Номенклатура, СтрокаТаблицы.Характеристика,
				СтрокаТаблицы.Серия);
			Тексты.Добавить(СтрШаблон(Шаблон, Представление));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Доступно к возврату по продаже: физический расход продажи минус физический приход других проведённых возвратов по
// ней, по ключу «номенклатура + характеристика + серия».
//
// Параметры:
//  Продажа   - ДокументСсылка.РеализацияТоваровУслуг - продажа.
//  Исключить - ДокументСсылка.ВозвратОтПокупателя - текущий возврат.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Серия, Количество.
//
Функция ДоступноКВозврату(Продажа, Исключить)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Записи.Номенклатура КАК Номенклатура,
	|	Записи.Характеристика КАК Характеристика,
	|	Записи.Серия КАК Серия,
	|	СУММА(ВЫБОР
	|			КОГДА Записи.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|				ТОГДА Записи.Количество
	|			ИНАЧЕ -Записи.Количество
	|		КОНЕЦ) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Регистратор = &Продажа
	|
	|СГРУППИРОВАТЬ ПО
	|	Записи.Номенклатура,
	|	Записи.Характеристика,
	|	Записи.Серия
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Записи.Номенклатура,
	|	Записи.Характеристика,
	|	Записи.Серия,
	|	СУММА(ВЫБОР
	|			КОГДА Записи.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА -Записи.Количество
	|			ИНАЧЕ Записи.Количество
	|		КОНЕЦ)
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратОтПокупателя КАК Возвраты
	|		ПО Записи.Регистратор = Возвраты.Ссылка
	|ГДЕ
	|	Возвраты.Основание = &Продажа
	|	И Возвраты.Ссылка <> &Исключить
	|	И Возвраты.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	Записи.Номенклатура,
	|	Записи.Характеристика,
	|	Записи.Серия");
	Запрос.УстановитьПараметр("Продажа", Продажа);
	Запрос.УстановитьПараметр("Исключить", Исключить);
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Свернуть(ПоляКлючаВозврата(), "Количество");
	Возврат Результат;
КонецФункции

Функция ДокументПроведен(Ссылка)
	УстановитьПривилегированныйРежим(Истина);
	МД = Ссылка.Метаданные();
	Если МД.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен") = Истина;
КонецФункции

Функция УдаляетДвиженияАвтоматически(ДокОбъект)
	Возврат ДокОбъект.Метаданные().УдалениеДвижений = Метаданные.СвойстваОбъектов.УдалениеДвижений.УдалятьАвтоматически;
КонецФункции

Процедура СообщитьТексты(Тексты, Отказ)
	Для Каждого Текст Из Тексты Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , , , Отказ);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ПроверкиНабора

// Прежние записи регистратора.
//
// Параметры:
//  Регистратор - ДокументСсылка - регистратор.
//
// Возвращаемое значение:
//  ТаблицаЗначений - записи (Период, ВидДвижения, МестоХранения, Номенклатура, Характеристика, Серия, Количество).
//
Функция ПрежниеЗаписи(Регистратор)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Записи.Период КАК Период,
	|	Записи.ВидДвижения КАК ВидДвижения,
	|	Записи.МестоХранения КАК МестоХранения,
	|	Записи.Номенклатура КАК Номенклатура,
	|	Записи.Характеристика КАК Характеристика,
	|	Записи.Серия КАК Серия,
	|	Записи.Количество КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Регистратор = &Регистратор");
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Снимок прежних записей серийной номенклатуры в ДополнительныеСвойства набора (создаётся при первом обращении).
//
// Параметры:
//  Набор - РегистрНакопленияНаборЗаписей.ТоварыВНаличии - набор.
//
// Возвращаемое значение:
//  ТаблицаЗначений - снимок.
//
Функция СнимокНабора(Набор)
	Снимок = Неопределено;
	Если Набор.ДополнительныеСвойства.Свойство(ИмяСнимка(), Снимок) Тогда
		Возврат Снимок;
	КонецЕсли;
	Снимок = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Период,ВидДвижения,МестоХранения,Номенклатура,Характеристика,Серия,Количество", ",") Цикл
		Снимок.Колонки.Добавить(Имя);
	КонецЦикла;
	Набор.ДополнительныеСвойства.Вставить(ИмяСнимка(), Снимок);
	Возврат Снимок;
КонецФункции

// Контекст проверок набора: новые и прежние записи серийной номенклатуры, физические количества, затронутые ключи.
//
// Параметры:
//  Набор    - РегистрНакопленияНаборЗаписей.ТоварыВНаличии - записанный набор.
//  Серийные - Соответствие - серийная номенклатура набора.
//
// Возвращаемое значение:
//  Структура - контекст.
//
Функция КонтекстНабора(Набор, Серийные)
	Регистратор = Набор.Отбор.Регистратор.Значение;
	Новые = СнимокНабора(Набор).СкопироватьКолонки();
	Для Каждого Запись Из Набор Цикл
		Если Серийные[Запись.Номенклатура] <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Новые.Добавить(), Запись);
		КонецЕсли;
	КонецЦикла;
	// Дозапись: итог регистратора - прежние записи и добавленные.
	Остающиеся = Неопределено;
	Если Набор.ДополнительныеСвойства.Свойство(ИмяДозаписи(), Остающиеся) Тогда
		Для Каждого Запись Из Остающиеся Цикл
			ЗаполнитьЗначенияСвойств(Новые.Добавить(), Запись);
		КонецЦикла;
	КонецЕсли;
	Контекст = Новый Структура("Регистратор, Новые, Прежние", Регистратор, Новые, СнимокНабора(Набор));
	Контекст.Вставить("НомераСерий", Набор.ДополнительныеСвойства[ИмяНомеровСерий()]);
	Контекст.Вставить("Перемещение", ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПеремещениеТоваров"));
	Контекст.Вставить("Возврат", ТипЗнч(Регистратор) = Тип("ДокументСсылка.ВозвратОтПокупателя"));
	Контекст.Вставить("НаОснованиях", НалоговыеДокументыНаОснованиях.ЭтоРегистраторНаОснованиях(Регистратор));
	Контекст.Вставить("КлючиСерий", Новый Массив);
	Контекст.Вставить("КлючиБезСерии", Новый Массив);
	ЗаполнитьЗатронутыеКлючи(Контекст);
	Возврат Контекст;
КонецФункции

// Затронутые ключи: серии (номенклатура + серия) и склады пустой серии (номенклатура + склад) новых и прежних записей.
//
// Параметры:
//  Контекст - Структура - см. КонтекстНабора; заполняются КлючиСерий, КлючиБезСерии.
//
Процедура ЗаполнитьЗатронутыеКлючи(Контекст)
	Серии = Новый Соответствие;
	БезСерии = Новый Соответствие;
	ДобавитьЗатронутые(Контекст.Новые, Серии, БезСерии);
	ДобавитьЗатронутые(Контекст.Прежние, Серии, БезСерии);
	Для Каждого КлючИЗначение Из Серии Цикл
		Контекст.КлючиСерий.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	Для Каждого КлючИЗначение Из БезСерии Цикл
		Контекст.КлючиБезСерии.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьЗатронутые(Таблица, Серии, БезСерии)
	Для Каждого Запись Из Таблица Цикл
		Если ЗначениеЗаполнено(Запись.Серия) Тогда
			Серии.Вставить(Запись.Серия, Новый Структура("Номенклатура, Серия", Запись.Номенклатура, Запись.Серия));
		Иначе
			Ключ = Строка(Запись.Номенклатура.УникальныйИдентификатор()) + Строка(Запись.МестоХранения.УникальныйИдентификатор());
			БезСерии.Вставить(Ключ, Новый Структура("Номенклатура, МестоХранения", Запись.Номенклатура, Запись.МестоХранения));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Физическое количество записи: приход - положительное, расход - отрицательное (с учётом знака количества).
//
// Параметры:
//  Запись - Произвольный - запись с ВидДвижения и Количество.
//
// Возвращаемое значение:
//  Число - физическое количество.
//
Функция ФизическоеКоличество(Запись)
	Возврат ?(Запись.ВидДвижения = ВидДвиженияНакопления.Приход, Запись.Количество, -Запись.Количество);
КонецФункции

// Проверки новых записей: без характеристики, владелец и номер серии, склады.
//
// Параметры:
//  Контекст - Структура - см. КонтекстНабора.
//  Тексты   - Массив из Строка - дополняется.
//
Процедура ПроверитьЗаписиНабора(Контекст, Тексты)
	Склады = Новый Массив;
	Даты = Новый Соответствие;
	Для Каждого Запись Из Контекст.Новые Цикл
		Если ЗначениеЗаполнено(Запись.Характеристика) Тогда
			Тексты.Добавить(НСтр("ru = 'Серийный товар учитывается без характеристик';
				|fr = 'Les articles à numéro de série sont suivis sans caractéristiques';
				|en = 'Serial items are tracked without characteristics';
				|es = 'Los artículos seriados se controlan sin características'"));
			Возврат;
		КонецЕсли;
		Если Склады.Найти(Запись.МестоХранения) = Неопределено Тогда
			Склады.Добавить(Запись.МестоХранения);
			Даты.Вставить(Запись.МестоХранения, Запись.Период);
		КонецЕсли;
	КонецЦикла;
	ПроверитьСерииЗаписей(Контекст, Тексты);
	Данные = ДанныеСкладов(Склады);
	Для Каждого Склад Из Склады Цикл
		Если СкладНедопустим(Данные, Склад, Даты[Склад]) Тогда
			Шаблон = НСтр("ru = 'Серийный товар не учитывается на складе %1'; fr = 'Article à numéro de série non suivi dans l''entrepôt %1';
				|en = 'Serial items are not tracked in warehouse %1'; es = 'Artículo seriado no controlado en el almacén %1'");
			Тексты.Добавить(СтрШаблон(Шаблон, Склад));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Серии новых записей: принадлежат номенклатуре записи, зарегистрированы в СерийныеНомера за этой серией под
// захваченным номером (номер не изменён другим сеансом).
//
// Параметры:
//  Контекст - Структура - см. КонтекстНабора.
//  Тексты   - Массив из Строка - дополняется.
//
Процедура ПроверитьСерииЗаписей(Контекст, Тексты)
	Серии = Новый Массив;
	Для Каждого Запись Из Контекст.Новые Цикл
		Если ЗначениеЗаполнено(Запись.Серия) И Серии.Найти(Запись.Серия) = Неопределено Тогда
			Серии.Добавить(Запись.Серия);
		КонецЕсли;
	КонецЦикла;
	Если Серии.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Серии.Ссылка КАК Серия,
	|	Серии.Владелец КАК Владелец,
	|	Серии.Наименование КАК Наименование,
	|	ЕСТЬNULL(Номера.СерийныйНомер, """") КАК СерийныйНомер
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК Серии
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СерийныеНомера КАК Номера
	|		ПО Серии.Ссылка = Номера.Серия
	|ГДЕ
	|	Серии.Ссылка В (&Серии)");
	Запрос.УстановитьПараметр("Серии", Серии);
	Данные = Запрос.Выполнить().Выгрузить();
	Для Каждого Запись Из Контекст.Новые Цикл
		Если Не ЗначениеЗаполнено(Запись.Серия) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = Данные.Найти(Запись.Серия, "Серия");
		Захваченный = Контекст.НомераСерий[Запись.Серия];
		// Наименования исторических серий не нормализованы - номер сверяется без пробелов по краям.
		Зарегистрирована = СтрокаТаблицы <> Неопределено И СтрокаТаблицы.СерийныйНомер = СокрЛП(СтрокаТаблицы.Наименование);
		Если Не Зарегистрирована Или СтрокаТаблицы.Владелец <> Запись.Номенклатура Тогда
			Шаблон = НСтр("ru = 'Серия %1 принадлежит другому товару или не зарегистрирована';
				|fr = 'La série %1 appartient à un autre article ou n''est pas enregistrée';
				|en = 'Series %1 belongs to another item or is not registered';
				|es = 'La serie %1 pertenece a otro artículo o no está registrada'");
			Тексты.Добавить(СтрШаблон(Шаблон, Запись.Серия));
			Возврат;
		ИначеЕсли Захваченный <> СокрЛП(СтрокаТаблицы.Наименование) Тогда
			Тексты.Добавить(ТекстДокументыИзменены());
			Возврат;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Правила физического прихода регистратора: серия - не больше 1, новый приход уже поступавшего IMEI и отмена
// первичного прихода при зависимой истории запрещены; пустая серия - только перемещением, возвратом и в пределах
// разрешения исторического регистратора. Пары налоговой переклассификации с нулевым итогом не проверяются.
//
// Параметры:
//  Контекст - Структура - см. КонтекстНабора.
//  Тексты   - Массив из Строка - дополняется.
//
Процедура ПроверитьПриходы(Контекст, Тексты)
	Новые = СводкаФизических(Контекст.Новые);
	Прежние = СводкаФизических(Контекст.Прежние);
	Если Контекст.НаОснованиях И ИтогиНулевые(Контекст.Новые) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Ключ Из Контекст.КлючиСерий Цикл
		ПроверитьПриходСерии(Контекст, Ключ, Новые, Прежние, Тексты);
	КонецЦикла;
	Если Контекст.Возврат Тогда
		ПроверитьНаборВозврата(Контекст, Тексты);
	Иначе
		ПроверитьПриходБезСерии(Контекст, Новые, Тексты);
	КонецЕсли;
КонецПроцедуры

// Набор возврата от покупателя (и прямая запись набора мимо документа): основание - физическая продажа, под её
// блокировкой приход по ключу «номенклатура + характеристика + серия», в т. ч. пустой серии, не больше проданного
// по движениям продажи за вычетом других проведённых возвратов.
//
// Параметры:
//  Контекст - Структура - см. КонтекстНабора.
//  Тексты   - Массив из Строка - дополняется.
//
Процедура ПроверитьНаборВозврата(Контекст, Тексты)
	Приходы = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Номенклатура,Характеристика,Серия,Количество", ",") Цикл
		Приходы.Колонки.Добавить(Имя);
	КонецЦикла;
	Для Каждого Запись Из Контекст.Новые Цикл
		ПриходКлюча = Приходы.Добавить();
		ЗаполнитьЗначенияСвойств(ПриходКлюча, Запись, ПоляКлючаВозврата());
		ПриходКлюча.Количество = ФизическоеКоличество(Запись);
	КонецЦикла;
	Приходы.Свернуть(ПоляКлючаВозврата(), "Количество");
	Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контекст.Регистратор, "Основание");
	ЭтоПродажа = ТипЗнч(Основание) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И ЗначениеЗаполнено(Основание)
		И Не НалоговыеДокументыНаОснованиях.ЭтоРегистраторНаОснованиях(Основание);
	Если Не ЭтоПродажа Тогда
		Если Приходы.Количество() > 0 Тогда
			Тексты.Добавить(ТекстВозвратТолькоПоПродаже());
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ЗаблокироватьДокумент(Основание);
	Доступно = ДоступноКВозврату(Основание, Контекст.Регистратор);
	Для Каждого СтрокаТаблицы Из Приходы Цикл
		Отбор = Новый Структура(ПоляКлючаВозврата());
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаТаблицы);
		Найдено = Доступно.НайтиСтроки(Отбор);
		Остаток = ?(Найдено.Количество() = 0, 0, Найдено[0].Количество);
		Если СтрокаТаблицы.Количество > Остаток Тогда
			Тексты.Добавить(СтрШаблон(ТекстВозвратБольшеПроданного(), СтрокаТаблицы.Номенклатура));
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Сводка физических количеств: по ключу «номенклатура|серия» и «номенклатура|склад» (пустая серия) - приход и расход.
//
// Параметры:
//  Записи - ТаблицаЗначений - записи.
//
// Возвращаемое значение:
//  Соответствие - ключ -> Структура (Приход, Расход).
//
Функция СводкаФизических(Записи)
	Сводка = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Количество = ФизическоеКоличество(Запись);
		Ключи = Новый Массив;
		Ключи.Добавить(КлючСерии(Запись.Номенклатура, Запись.Серия));
		Если Не ЗначениеЗаполнено(Запись.Серия) Тогда
			Ключи.Добавить(КлючСклада(Запись.Номенклатура, Запись.МестоХранения));
		КонецЕсли;
		Ключи.Добавить(КлючВсего(Запись.Номенклатура, Запись.МестоХранения));
		Для Каждого Ключ Из Ключи Цикл
			СтрокаТаблицы = Сводка[Ключ];
			Если СтрокаТаблицы = Неопределено Тогда
				СтрокаТаблицы = Новый Структура("Приход, Расход", 0, 0);
				Сводка.Вставить(Ключ, СтрокаТаблицы);
			КонецЕсли;
			Если Количество > 0 Тогда
				СтрокаТаблицы.Приход = СтрокаТаблицы.Приход + Количество;
			Иначе
				СтрокаТаблицы.Расход = СтрокаТаблицы.Расход - Количество;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Сводка;
КонецФункции

Функция КлючСерии(Номенклатура, Серия)
	Возврат "С|" + Строка(Номенклатура.УникальныйИдентификатор()) + "|" + ?(ЗначениеЗаполнено(Серия),
		Строка(Серия.УникальныйИдентификатор()), "");
КонецФункции

Функция КлючСклада(Номенклатура, Склад)
	Возврат "Б|" + Строка(Номенклатура.УникальныйИдентификатор()) + "|" + Строка(Склад.УникальныйИдентификатор());
КонецФункции

Функция КлючВсего(Номенклатура, Склад)
	Возврат "В|" + Строка(Номенклатура.УникальныйИдентификатор()) + "|" + Строка(Склад.УникальныйИдентификатор());
КонецФункции

Функция Сумма(Сводка, Ключ, Поле)
	СтрокаТаблицы = Сводка[Ключ];
	Возврат ?(СтрокаТаблицы = Неопределено, 0, СтрокаТаблицы[Поле]);
КонецФункции

// Итог записей по полному ключу «склад, номенклатура, серия» нулевой (пара налоговой переклассификации).
//
// Параметры:
//  Записи - ТаблицаЗначений - записи.
//
// Возвращаемое значение:
//  Булево - Истина: все итоги нулевые.
//
Функция ИтогиНулевые(Записи)
	Итоги = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Ключ = КлючСерии(Запись.Номенклатура, Запись.Серия) + "|" + Строка(Запись.МестоХранения.УникальныйИдентификатор());
		Итоги.Вставить(Ключ, ?(Итоги[Ключ] = Неопределено, 0, Итоги[Ключ]) + ФизическоеКоличество(Запись));
	КонецЦикла;
	Для Каждого КлючИЗначение Из Итоги Цикл
		Если КлючИЗначение.Значение <> 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Приход серии регистратором: не больше 1; допустим как перепроведение (не больше прежнего), первый приход,
// перемещение или возврат. Уменьшение первичного прихода при движениях других регистраторов - отказ.
//
// Параметры:
//  Контекст - Структура - см. КонтекстНабора.
//  Ключ     - Структура - Номенклатура, Серия.
//  Новые    - Соответствие - см. СводкаФизических.
//  Прежние  - Соответствие - см. СводкаФизических.
//  Тексты   - Массив из Строка - дополняется.
//
Процедура ПроверитьПриходСерии(Контекст, Ключ, Новые, Прежние, Тексты)
	К = КлючСерии(Ключ.Номенклатура, Ключ.Серия);
	Приход = Сумма(Новые, К, "Приход");
	Расход = Сумма(Новые, К, "Расход");
	БылПриход = Сумма(Прежние, К, "Приход");
	БылРасход = Сумма(Прежние, К, "Расход");
	Шаблон = НСтр("ru = 'IMEI %1 уже поступал: новый приход - только возвратом от покупателя или перемещением';
		|fr = 'L''IMEI %1 est déjà entré : nouvelle entrée uniquement par retour client ou transfert';
		|en = 'IMEI %1 has already been received: a new receipt is only possible by customer return or transfer';
		|es = 'El IMEI %1 ya entró: nueva entrada solo por devolución de cliente o traslado'");
	Если Приход > 1 Тогда
		Тексты.Добавить(СтрШаблон(Шаблон, Ключ.Серия));
		Возврат;
	КонецЕсли;
	Перемещает = Контекст.Перемещение И Расход >= Приход;
	НовыйПриход = Приход > 0 И Приход > БылПриход И Не Перемещает И Не Контекст.Возврат;
	Если НовыйПриход И ЕстьДругиеДвижения(Ключ, Контекст.Регистратор) Тогда
		Тексты.Добавить(СтрШаблон(Шаблон, Ключ.Серия));
		Возврат;
	КонецЕсли;
	Первичный = Не Контекст.Перемещение И Не Контекст.Возврат И БылРасход = 0;
	ОтменаПрихода = Первичный И БылПриход > 0 И Приход < БылПриход;
	Если ОтменаПрихода И ЕстьДругиеДвижения(Ключ, Контекст.Регистратор) Тогда
		ШаблонОтмены = НСтр("ru = 'IMEI %1 уже двигался после прихода: приход не отменить';
			|fr = 'L''IMEI %1 a bougé après l''entrée : l''entrée ne peut pas être annulée';
			|en = 'IMEI %1 has moved after receipt: the receipt cannot be cancelled';
			|es = 'El IMEI %1 se movió tras la entrada: la entrada no se puede anular'");
		Тексты.Добавить(СтрШаблон(ШаблонОтмены, Ключ.Серия));
	КонецЕсли;
КонецПроцедуры

// Приход пустой серии: перемещение (тот же набор списывает пустую серию), возврат (основание проверено подпиской),
// разрешение исторического регистратора (без серии и всего по складу); иначе - отказ.
//
// Параметры:
//  Контекст - Структура - см. КонтекстНабора.
//  Новые    - Соответствие - см. СводкаФизических.
//  Тексты   - Массив из Строка - дополняется.
//
Процедура ПроверитьПриходБезСерии(Контекст, Новые, Тексты)
	Если Контекст.Возврат Тогда
		Возврат;
	КонецЕсли;
	Разрешения = РазрешенияРегистратора(Контекст.Регистратор);
	Шаблон = НСтр("ru = 'Приход товара %1 без IMEI запрещён: укажите серийные номера';
		|fr = 'Entrée de l''article %1 sans IMEI interdite : indiquez les numéros de série';
		|en = 'Receipt of item %1 without IMEI is not allowed: enter the serial numbers';
		|es = 'La entrada del artículo %1 sin IMEI está prohibida: indique los números de serie'");
	// Расход без серии перемещения - один лимит на все склады прихода регистратора.
	Покрыто = Новый Соответствие;
	Для Каждого Ключ Из Контекст.КлючиБезСерии Цикл
		Приход = Сумма(Новые, КлючСклада(Ключ.Номенклатура, Ключ.МестоХранения), "Приход");
		Если Приход = 0 Тогда
			Продолжить;
		КонецЕсли;
		РасходБезСерии = Сумма(Новые, КлючСерии(Ключ.Номенклатура, Неопределено), "Расход");
		Использовано = ?(Покрыто[Ключ.Номенклатура] = Неопределено, 0, Покрыто[Ключ.Номенклатура]);
		Если Контекст.Перемещение И РасходБезСерии >= Использовано + Приход Тогда
			Покрыто.Вставить(Ключ.Номенклатура, Использовано + Приход);
			Продолжить;
		КонецЕсли;
		ОтборРазрешения = Новый Структура("Номенклатура, МестоХранения", Ключ.Номенклатура, Ключ.МестоХранения);
		Найдено = Разрешения.НайтиСтроки(ОтборРазрешения);
		Всего = Сумма(Новые, КлючВсего(Ключ.Номенклатура, Ключ.МестоХранения), "Приход");
		Разрешено = Найдено.Количество() > 0 И Приход <= Найдено[0].КоличествоБезСерии
			И Всего <= Найдено[0].КоличествоВсего;
		Если Не Разрешено Тогда
			Тексты.Добавить(СтрШаблон(Шаблон, Ключ.Номенклатура));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция РазрешенияРегистратора(Регистратор)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Разрешения.Номенклатура КАК Номенклатура,
	|	Разрешения.МестоХранения КАК МестоХранения,
	|	Разрешения.КоличествоБезСерии КАК КоличествоБезСерии,
	|	Разрешения.КоличествоВсего КАК КоличествоВсего
	|ИЗ
	|	РегистрСведений.ПереходныеПриходыБезСерии КАК Разрешения
	|ГДЕ
	|	Разрешения.ДокументПрихода = &Регистратор");
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ЕстьРазрешение(Регистратор)
	УстановитьПривилегированныйРежим(Истина);
	Возврат РазрешенияРегистратора(Регистратор).Количество() > 0;
КонецФункции

// Есть ли движения серии у других регистраторов.
//
// Параметры:
//  Ключ        - Структура - Номенклатура, Серия.
//  Регистратор - ДокументСсылка - текущий регистратор.
//
// Возвращаемое значение:
//  Булево - Истина: есть.
//
Функция ЕстьДругиеДвижения(Ключ, Регистратор)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Записи.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Номенклатура = &Номенклатура
	|	И Записи.Серия = &Серия
	|	И Записи.Регистратор <> &Регистратор");
	Запрос.УстановитьПараметр("Номенклатура", Ключ.Номенклатура);
	Запрос.УстановитьПараметр("Серия", Ключ.Серия);
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Функция ЕстьДвиженияСерии(Серия)
	Если Не ЗначениеЗаполнено(Серия) Тогда
		Возврат Ложь;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Записи.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Серия = &Серия");
	Запрос.УстановитьПараметр("Серия", Серия);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Хронология серий: по всем движениям серии в порядке момента времени остаток каждого склада и сети - 0 или 1 после
// каждого регистратора.
//
// Параметры:
//  Ключи  - Массив из Структура - Номенклатура, Серия.
//  Тексты - Массив из Строка - дополняется.
//
Процедура ПроверитьХронологию(Ключи, Тексты)
	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Серии = Новый Массив;
	Для Каждого Ключ Из Ключи Цикл
		Серии.Добавить(Ключ.Серия);
	КонецЦикла;
	Нарушение = НарушениеХронологии(Серии);
	Если Нарушение <> Неопределено Тогда
		Шаблон = НСтр("ru = 'IMEI %1: один экземпляр не может числиться дважды или уходить в минус (документ %2)';
			|fr = 'IMEI %1 : un exemplaire ne peut figurer deux fois ni passer en négatif (document %2)';
			|en = 'IMEI %1: one unit cannot be counted twice or go negative (document %2)';
			|es = 'IMEI %1: una unidad no puede figurar dos veces ni quedar en negativo (documento %2)'");
		Тексты.Добавить(СтрШаблон(Шаблон, Нарушение.Серия, ПредставлениеРегистратора(Нарушение.Регистратор)));
	КонецЕсли;
КонецПроцедуры

// Первое нарушение хронологии серий: остаток склада или сети вне 0/1 после движений регистратора.
//
// Параметры:
//  Серии - Массив из СправочникСсылка.СерииНоменклатуры - серии.
//
// Возвращаемое значение:
//  Структура, Неопределено - Серия, Регистратор; Неопределено - нарушений нет.
//
Функция НарушениеХронологии(Серии)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Записи.Серия КАК Серия,
	|	Записи.Регистратор КАК Регистратор,
	|	Записи.МоментВремени КАК МоментВремени,
	|	Записи.МестоХранения КАК МестоХранения,
	|	ВЫБОР
	|		КОГДА Записи.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА Записи.Количество
	|		ИНАЧЕ -Записи.Количество
	|	КОНЕЦ КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Серия В (&Серии)
	|	И Записи.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	Серия,
	|	МоментВремени");
	Запрос.УстановитьПараметр("Серии", Серии);
	Движения = Запрос.Выполнить().Выгрузить();
	Индекс = 0;
	Пока Индекс < Движения.Количество() Цикл
		Серия = Движения[Индекс].Серия;
		Остатки = Новый Соответствие;
		Пока Индекс < Движения.Количество() И Движения[Индекс].Серия = Серия Цикл
			Регистратор = Движения[Индекс].Регистратор;
			Пока Индекс < Движения.Количество() И Движения[Индекс].Серия = Серия И Движения[Индекс].Регистратор = Регистратор Цикл
				Движение = Движения[Индекс];
				Остатки.Вставить(Движение.МестоХранения, ?(Остатки[Движение.МестоХранения] = Неопределено, 0,
					Остатки[Движение.МестоХранения]) + Движение.Количество);
				Индекс = Индекс + 1;
			КонецЦикла;
			Если Не ОстаткиЭкземпляра(Остатки) Тогда
				Возврат Новый Структура("Серия, Регистратор", Серия, Регистратор);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Остатки экземпляра допустимы: по каждому складу 0 или 1, по сети 0 или 1.
//
// Параметры:
//  Остатки - Соответствие - склад -> остаток.
//
// Возвращаемое значение:
//  Булево - Истина: допустимы.
//
Функция ОстаткиЭкземпляра(Остатки)
	Сеть = 0;
	Для Каждого КлючИЗначение Из Остатки Цикл
		Если КлючИЗначение.Значение <> 0 И КлючИЗначение.Значение <> 1 Тогда
			Возврат Ложь;
		КонецЕсли;
		Сеть = Сеть + КлючИЗначение.Значение;
	КонецЦикла;
	Возврат Сеть = 0 Или Сеть = 1;
КонецФункции

// Остаток пустой серии по затронутым складам не отрицательный.
//
// Параметры:
//  Ключи  - Массив из Структура - Номенклатура, МестоХранения.
//  Тексты - Массив из Строка - дополняется.
//
Процедура ПроверитьОстаткиБезСерии(Ключи, Тексты)
	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить(ИмяНоменклатура(), Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("МестоХранения", Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
	Для Каждого Ключ Из Ключи Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Ключ);
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Ключи.Номенклатура КАК Номенклатура,
	|	Ключи.МестоХранения КАК МестоХранения
	|ПОМЕСТИТЬ ВТКлючи
	|ИЗ
	|	&Ключи КАК Ключи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.МестоХранения КАК МестоХранения,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			,
	|			(Номенклатура, МестоХранения) В
	|					(ВЫБРАТЬ
	|						ВТКлючи.Номенклатура КАК Номенклатура,
	|						ВТКлючи.МестоХранения КАК МестоХранения
	|					ИЗ
	|						ВТКлючи КАК ВТКлючи)
	|				И Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура,
	|	Остатки.МестоХранения
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.КоличествоОстаток) < 0");
	Запрос.УстановитьПараметр("Ключи", Таблица);
	Шаблон = НСтр("ru = 'Нет остатка товара %1 без IMEI на складе %2';
		|fr = 'Pas de stock de l''article %1 sans IMEI dans l''entrepôt %2';
		|en = 'No stock of item %1 without IMEI in warehouse %2';
		|es = 'No hay existencias del artículo %1 sin IMEI en el almacén %2'");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Тексты.Добавить(СтрШаблон(Шаблон, Выборка.Номенклатура, Выборка.МестоХранения));
	КонецЦикла;
КонецПроцедуры

// Продажа с проведёнными возвратами: по движениям продажи в базе (уже новым) физический расход по ключу «номенклатура
// + характеристика + серия» не меньше вернувшегося по ней (продажа заблокирована в ПередЗаписьюНабора).
//
// Параметры:
//  Контекст - Структура - см. КонтекстНабора.
//  Тексты   - Массив из Строка - дополняется.
//
Процедура ПроверитьВозвратыПродажи(Контекст, Тексты)
	Если ТипЗнч(Контекст.Регистратор) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат;
	КонецЕсли;
	Серийные = Новый Соответствие;
	Для Каждого Запись Из Контекст.Новые Цикл
		Серийные.Вставить(Запись.Номенклатура, Истина);
	КонецЦикла;
	Для Каждого Запись Из Контекст.Прежние Цикл
		Серийные.Вставить(Запись.Номенклатура, Истина);
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из ДоступноКВозврату(Контекст.Регистратор, Документы.ВозвратОтПокупателя.ПустаяСсылка()) Цикл
		Если Серийные[СтрокаТаблицы.Номенклатура] <> Неопределено И СтрокаТаблицы.Количество < 0 Тогда
			Тексты.Добавить(НСтр("ru = 'По продаже есть возвраты серийного товара: сначала отмените возвраты';
				|fr = 'La vente a des retours d''articles à numéro de série : annulez d''abord les retours';
				|en = 'The sale has serial item returns: cancel the returns first';
				|es = 'La venta tiene devoluciones de artículos seriados: anule primero las devoluciones'"));
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ВключениеУчета

// Проверки включения флага: товар вне техкарт и без характеристик (до и после исключительной блокировки), история
// движений: склады, владельцы и номера серий, хронология, исторические приходы серий, остатки без серии.
//
// Параметры:
//  Объект - СправочникОбъект.Номенклатура - номенклатура.
//  Тексты - Массив из Строка - дополняется.
//
Процедура ПроверитьВключение(Объект, Тексты)
	ПроверитьТехкартыИХарактеристики(Объект, Тексты);
	Если Тексты.Количество() > 0 Или Объект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник.Номенклатура");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Объект.Ссылка);
	Элемент = Блокировка.Добавить(ИмяТаблицыОстатков());
	Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Элемент.УстановитьЗначение(ИмяНоменклатура(), Объект.Ссылка);
	Блокировка.Заблокировать();
	ПроверитьТехкартыИХарактеристики(Объект, Тексты);
	Если Тексты.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ПроверитьИсториюВключения(Объект.Ссылка, Тексты);
КонецПроцедуры

Процедура ПроверитьТехкартыИХарактеристики(Объект, Тексты)
	Если Объект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Найдено
	|ИЗ
	|	РегистрСведений.СоставТехКарты КАК Состав
	|ГДЕ
	|	Состав.Продукция = &Товар
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	РегистрСведений.СоставТехКарты КАК Состав
	|ГДЕ
	|	Состав.Материал = &Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Найдено
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК Характеристики
	|ГДЕ
	|	Характеристики.Владелец = &Товар
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Номенклатура = &Товар
	|	И Записи.Характеристика <> ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)");
	Запрос.УстановитьПараметр("Товар", Объект.Ссылка);
	Результаты = Запрос.ВыполнитьПакет();
	Если Не Результаты[0].Пустой() Тогда
		Тексты.Добавить(НСтр("ru = 'Товар участвует в техкартах: учёт по серийным номерам недоступен';
			|fr = 'L''article figure dans des fiches techniques : suivi par numéros de série indisponible';
			|en = 'The item is used in BOMs: serial number tracking is not available';
			|es = 'El artículo figura en fichas técnicas: control por números de serie no disponible'"));
	КонецЕсли;
	Если Не Результаты[1].Пустой() Тогда
		Тексты.Добавить(НСтр("ru = 'У товара есть характеристики: учёт по серийным номерам недоступен';
			|fr = 'L''article a des caractéristiques : suivi par numéros de série indisponible';
			|en = 'The item has characteristics: serial number tracking is not available';
			|es = 'El artículo tiene características: control por números de serie no disponible'"));
	КонецЕсли;
КонецПроцедуры

// История движений товара до включения: склады, серии (владелец, номер, дубли), хронология, исторические приходы
// серий не больше 1 на регистратор (без нулевых пар переклассификации), остатки без серии.
//
// Параметры:
//  Товар  - СправочникСсылка.Номенклатура - товар.
//  Тексты - Массив из Строка - дополняется.
//
Процедура ПроверитьИсториюВключения(Товар, Тексты)
	Движения = ДвиженияТовара(Товар);
	ПроверитьСкладыИстории(Движения, Тексты);
	ПроверитьСерииИстории(Товар, Движения, Тексты);
	Серии = Новый Массив;
	Ключи = Новый Массив;
	Для Каждого Запись Из Движения Цикл
		Если Не ЗначениеЗаполнено(Запись.Серия) Тогда
			Ключ = Новый Структура("Номенклатура, МестоХранения", Товар, Запись.МестоХранения);
			Ключи.Добавить(Ключ);
		ИначеЕсли Серии.Найти(Запись.Серия) = Неопределено Тогда
			Серии.Добавить(Запись.Серия);
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Если Серии.Количество() > 0 Тогда
		Нарушение = НарушениеХронологии(Серии);
		Если Нарушение <> Неопределено Тогда
			Шаблон = НСтр("ru = 'Серия %1 числится больше одного раза (документ %2): исправьте историю до включения учёта';
				|fr = 'La série %1 figure plus d''une fois (document %2) : corrigez l''historique avant l''activation';
				|en = 'Series %1 is counted more than once (document %2): fix the history before enabling tracking';
				|es = 'La serie %1 figura más de una vez (documento %2): corrija el historial antes de activar el control'");
			Тексты.Добавить(СтрШаблон(Шаблон, Нарушение.Серия, ПредставлениеРегистратора(Нарушение.Регистратор)));
		КонецЕсли;
	КонецЕсли;
	ПроверитьИсторическиеПриходы(Движения, Тексты);
	ПроверитьОстаткиБезСерии(Ключи, Тексты);
КонецПроцедуры

Функция ДвиженияТовара(Товар)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Записи.Период КАК Период,
	|	Записи.Регистратор КАК Регистратор,
	|	Записи.ВидДвижения КАК ВидДвижения,
	|	Записи.МестоХранения КАК МестоХранения,
	|	Записи.Номенклатура КАК Номенклатура,
	|	Записи.Характеристика КАК Характеристика,
	|	Записи.Серия КАК Серия,
	|	Записи.Количество КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Номенклатура = &Товар
	|	И Записи.Активность");
	Запрос.УстановитьПараметр("Товар", Товар);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ПроверитьСкладыИстории(Движения, Тексты)
	// Ордерность склада с даты начала схемы не снимается назад, подчинённость от даты не зависит: по складу достаточно
	// последнего движения - один запрос на склад.
	Последние = Движения.Скопировать(, "МестоХранения, Период, Регистратор");
	Последние.Сортировать("Период Убыв");
	Данные = ДанныеСкладов(Последние.ВыгрузитьКолонку("МестоХранения"));
	Проверенные = Новый Соответствие;
	Для Каждого Запись Из Последние Цикл
		Если Проверенные[Запись.МестоХранения] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Проверенные.Вставить(Запись.МестоХранения, Истина);
		Если СкладНедопустим(Данные, Запись.МестоХранения, Запись.Период) Тогда
			Шаблон = НСтр("ru = 'Товар двигался на складе %1 (ордерный или с подчинённым), документ %2: учёт по серийным номерам недоступен';
				|fr = 'L''article a bougé dans l''entrepôt %1 (par ordres ou avec subordonné), document %2 : suivi indisponible';
				|en = 'The item moved in warehouse %1 (order-based or with subordinate), document %2: tracking is not available';
				|es = 'El artículo se movió en el almacén %1 (por órdenes o con subordinado), documento %2: control no disponible'");
			Тексты.Добавить(СтрШаблон(Шаблон, Запись.МестоХранения, ПредставлениеРегистратора(Запись.Регистратор)));
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Серии истории: принадлежат товару, номера без дублей среди серий товара и свободны в регистре номеров.
//
// Параметры:
//  Товар    - СправочникСсылка.Номенклатура - товар.
//  Движения - ТаблицаЗначений - движения товара.
//  Тексты   - Массив из Строка - дополняется.
//
Процедура ПроверитьСерииИстории(Товар, Движения, Тексты)
	Для Каждого Запись Из Движения Цикл
		Если ЗначениеЗаполнено(Запись.Серия) И Запись.Серия.Владелец <> Товар Тогда
			Шаблон = НСтр("ru = 'В истории товара серия другого товара (документ %1): исправьте до включения учёта';
				|fr = 'L''historique contient une série d''un autre article (document %1) : corrigez avant l''activation';
				|en = 'The item history has another item''s series (document %1): fix it before enabling tracking';
				|es = 'El historial tiene una serie de otro artículo (documento %1): corrija antes de activar'");
			Тексты.Добавить(СтрШаблон(Шаблон, ПредставлениеРегистратора(Запись.Регистратор)));
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Серии.Ссылка КАК Ссылка,
	|	Серии.Наименование КАК Наименование
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК Серии
	|ГДЕ
	|	Серии.Владелец = &Товар");
	Запрос.УстановитьПараметр("Товар", Товар);
	Номера = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Номер = СокрЛП(Выборка.Наименование);
		Если Номера[Номер] <> Неопределено Тогда
			Шаблон = НСтр("ru = 'Номер %1 у двух серий товара'; fr = 'Numéro %1 sur deux séries';
				|en = 'Number %1 on two series of the item'; es = 'Número %1 en dos series del artículo'");
			Тексты.Добавить(СтрШаблон(Шаблон, Номер));
		Иначе
			Номера.Вставить(Номер, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	ПроверитьСвободуНомеров(Номера, Тексты);
КонецПроцедуры

// Исторические приходы серий: физический приход серии одним регистратором не больше 1 (нулевые пары налоговой
// переклассификации не считаются).
//
// Параметры:
//  Движения - ТаблицаЗначений - движения товара.
//  Тексты   - Массив из Строка - дополняется.
//
Процедура ПроверитьИсторическиеПриходы(Движения, Тексты)
	ПолеРегистратора = "Регистратор";
	Регистраторы = Движения.Скопировать(, ПолеРегистратора);
	Регистраторы.Свернуть(ПолеРегистратора);
	Для Каждого СтрокаТаблицы Из Регистраторы Цикл
		Записи = Движения.Скопировать(Новый Структура(ПолеРегистратора, СтрокаТаблицы.Регистратор));
		Если НалоговыеДокументыНаОснованиях.ЭтоРегистраторНаОснованиях(СтрокаТаблицы.Регистратор) И ИтогиНулевые(Записи) Тогда
			Продолжить;
		КонецЕсли;
		Сводка = СводкаФизических(Записи);
		Для Каждого Запись Из Записи Цикл
			Если ЗначениеЗаполнено(Запись.Серия) И Сумма(Сводка, КлючСерии(Запись.Номенклатура, Запись.Серия), "Приход") > 1 Тогда
				Шаблон = НСтр("ru = 'Документ %1 приходует серию %2 больше одного раза: разделите приход на серии в документе';
					|fr = 'Le document %1 fait entrer la série %2 plus d''une fois : répartissez l''entrée par séries';
					|en = 'Document %1 receives series %2 more than once: split the receipt into series in the document';
					|es = 'El documento %1 recibe la serie %2 más de una vez: divida la entrada en series en el documento'");
				Тексты.Добавить(СтрШаблон(Шаблон, ПредставлениеРегистратора(СтрокаТаблицы.Регистратор), Запись.Серия));
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Номер не занят другой серией в регистре СерийныеНомера.
//
// Параметры:
//  Номер  - Строка - номер.
//  Серия  - СправочникСсылка.СерииНоменклатуры - своя серия.
//  Тексты - Массив из Строка - дополняется.
//
Процедура ПроверитьСвободуНомера(Номер, Серия, Тексты)
	Номера = Новый Соответствие;
	Номера.Вставить(Номер, Серия);
	ПроверитьСвободуНомеров(Номера, Тексты);
КонецПроцедуры

// Номера не заняты другими сериями в регистре СерийныеНомера - одним запросом.
//
// Параметры:
//  Номера - Соответствие - номер -> своя серия.
//  Тексты - Массив из Строка - дополняется.
//
Процедура ПроверитьСвободуНомеров(Номера, Тексты)
	Если Номера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Список = Новый Массив;
	Для Каждого КлючИЗначение Из Номера Цикл
		Список.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Номера.СерийныйНомер КАК СерийныйНомер,
	|	Номера.Серия КАК Серия,
	|	Номера.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.СерийныеНомера КАК Номера
	|ГДЕ
	|	Номера.СерийныйНомер В (&Номера)");
	Запрос.УстановитьПараметр("Номера", Список);
	Шаблон = ТекстНомерЗанят();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Серия <> Номера[Выборка.СерийныйНомер] Тогда
			Тексты.Добавить(СтрШаблон(Шаблон, Выборка.СерийныйНомер, Выборка.Номенклатура));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Регистрация номеров всех серий товара при включении учёта.
//
// Параметры:
//  Товар - СправочникСсылка.Номенклатура - товар.
//
Процедура ЗарегистрироватьСерииНоменклатуры(Товар)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Серии.Ссылка КАК Ссылка,
	|	Серии.Наименование КАК Наименование
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК Серии
	|ГДЕ
	|	Серии.Владелец = &Товар");
	Запрос.УстановитьПараметр("Товар", Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	Номера = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Номера.Добавить(СокрЛП(Выборка.Наименование));
	КонецЦикла;
	ЗаблокироватьНомера(Номера);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписатьНомер(СокрЛП(Выборка.Наименование), Выборка.Ссылка, Товар);
	КонецЦикла;
КонецПроцедуры

// Разрешения исторических приходов без серии: регистраторы с физическим приходом пустой серии товара на момент
// включения - без серии и всего по складу.
//
// Параметры:
//  Товар - СправочникСсылка.Номенклатура - товар.
//
Процедура ЗаписатьПереходныеРазрешения(Товар)
	Движения = ДвиженияТовара(Товар);
	Поля = "Регистратор, МестоХранения";
	Регистраторы = Движения.Скопировать(, Поля);
	Регистраторы.Свернуть(Поля);
	Для Каждого СтрокаТаблицы Из Регистраторы Цикл
		Записи = Движения.Скопировать(Новый Структура(Поля, СтрокаТаблицы.Регистратор, СтрокаТаблицы.МестоХранения));
		Сводка = СводкаФизических(Записи);
		БезСерии = Сумма(Сводка, КлючСклада(Товар, СтрокаТаблицы.МестоХранения), "Приход");
		Если БезСерии = 0 Тогда
			Продолжить;
		КонецЕсли;
		МенеджерЗаписи = РегистрыСведений.ПереходныеПриходыБезСерии.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ДокументПрихода = СтрокаТаблицы.Регистратор;
		МенеджерЗаписи.Номенклатура = Товар;
		МенеджерЗаписи.МестоХранения = СтрокаТаблицы.МестоХранения;
		МенеджерЗаписи.КоличествоБезСерии = БезСерии;
		МенеджерЗаписи.КоличествоВсего = Сумма(Сводка, КлючВсего(Товар, СтрокаТаблицы.МестоХранения), "Приход");
		МенеджерЗаписи.Записать();
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область Номера

// Прежние владелец и номер записанной серии.
//
// Параметры:
//  Объект - СправочникОбъект.СерииНоменклатуры - серия.
//
// Возвращаемое значение:
//  Структура - Владелец, Номер.
//
Функция ПрежняяСерия(Объект)
	Результат = Новый Структура("Владелец, Номер", Справочники.Номенклатура.ПустаяСсылка(), "");
	Если Объект.ЭтоНовый() Тогда
		Возврат Результат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, "Владелец, Наименование");
	Результат.Владелец = Данные.Владелец;
	Результат.Номер = СокрЛП(Данные.Наименование);
	Возврат Результат;
КонецФункции

// Регистрация номера под исключительной блокировкой номера (её берёт вызывающий): номер, занятый другой серией, не
// перезаписывается - исключение отменяет запись целиком (гонка включения учёта у товаров с одинаковыми номерами).
//
// Параметры:
//  Номер - Строка - номер.
//  Серия - СправочникСсылка.СерииНоменклатуры - серия.
//  Товар - СправочникСсылка.Номенклатура - владелец.
//
Процедура ЗаписатьНомер(Номер, Серия, Товар)
	МенеджерЗаписи = РегистрыСведений.СерийныеНомера.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.СерийныйНомер = Номер;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() И МенеджерЗаписи.Серия <> Серия Тогда
		ВызватьИсключение СтрШаблон(ТекстНомерЗанят(), Номер, МенеджерЗаписи.Номенклатура);
	КонецЕсли;
	МенеджерЗаписи.СерийныйНомер = Номер;
	МенеджерЗаписи.Серия = Серия;
	МенеджерЗаписи.Номенклатура = Товар;
	МенеджерЗаписи.Записать(Истина);
КонецПроцедуры

Процедура УдалитьНомер(Номер, Серия)
	МенеджерЗаписи = РегистрыСведений.СерийныеНомера.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.СерийныйНомер = Номер;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() И МенеджерЗаписи.Серия = Серия Тогда
		МенеджерЗаписи.Удалить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти
