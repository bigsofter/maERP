#Область Блокировки

// Ключи захвата: номенклатура и серии.
//
// Возвращаемое значение:
//  Структура - Номенклатура (Массив), Серии (Массив).
//
Функция НовыеКлючи()
	Возврат Новый Структура("Номенклатура, Серии", Новый Массив, Новый Массив);
КонецФункции

// Захват по протоколу: разделяемая блокировка номенклатуры (вместе с составляющими комплектов), чтение флагов,
// исключительная блокировка номеров IMEI серий серийной номенклатуры.
//
// Параметры:
//  Ключи - Структура - см. НовыеКлючи.
//
// Возвращаемое значение:
//  Структура - см. ЗаблокироватьСерииДокумента.
//
Функция ЗахватитьКлючи(Ключи)
	Номенклатура = НоменклатураСоСоставляющими(Ключи.Номенклатура);
	ЗаблокироватьНоменклатуру(Номенклатура);
	Серийные = СерийнаяНоменклатура(Номенклатура);
	НомераСерий = НомераСерий(Ключи.Серии, Серийные);
	Номера = Новый Массив;
	Для Каждого КлючИЗначение Из НомераСерий Цикл
		Если Номера.Найти(КлючИЗначение.Значение) = Неопределено Тогда
			Номера.Добавить(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	ЗаблокироватьНомера(Номера);
	Возврат Новый Структура("Серийные, Номера, НомераСерий", Серийные, Номера, НомераСерий);
КонецФункции

// Разделяемая блокировка номенклатуры (барьер протокола); вне транзакции не берётся.
//
// Параметры:
//  Номенклатура - Массив - товары.
//
Процедура ЗаблокироватьНоменклатуру(Номенклатура)
	Если Не ТранзакцияАктивна() Или Номенклатура.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Товар Из УпорядоченныеСсылки(Номенклатура) Цикл
		Элемент = Блокировка.Добавить("Справочник.Номенклатура");
		Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
		Элемент.УстановитьЗначение("Ссылка", Товар);
	КонецЦикла;
	Блокировка.Заблокировать();
КонецПроцедуры

// Исключительная блокировка номеров IMEI в регистре СерийныеНомера, упорядоченно по номеру; вне транзакции не берётся.
//
// Параметры:
//  Номера - Массив из Строка - номера.
//
Процедура ЗаблокироватьНомера(Номера)
	Если Не ТранзакцияАктивна() Или Номера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Номера);
	Список.СортироватьПоЗначению();
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Элемент Из Список Цикл
		Если ПустаяСтрока(Элемент.Значение) Тогда
			Продолжить;
		КонецЕсли;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СерийныеНомера");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("СерийныйНомер", Элемент.Значение);
	КонецЦикла;
	Блокировка.Заблокировать();
КонецПроцедуры

// Исключительная блокировка документа по ссылке; вне транзакции не берётся.
//
// Параметры:
//  Ссылка - ДокументСсылка - документ.
//
Процедура ЗаблокироватьДокумент(Ссылка)
	Если Не ТранзакцияАктивна() Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Блокировка.Заблокировать();
КонецПроцедуры

// Ссылки без повторов, упорядоченные по уникальному идентификатору (единый порядок захвата у всех сеансов).
//
// Параметры:
//  Ссылки - Массив - ссылки.
//
// Возвращаемое значение:
//  Массив - ссылки.
//
Функция УпорядоченныеСсылки(Ссылки)
	Список = Новый СписокЗначений;
	Для Каждого Ссылка Из Ссылки Цикл
		Если ЗначениеЗаполнено(Ссылка) И Список.НайтиПоЗначению(Ссылка) = Неопределено Тогда
			Список.Добавить(Ссылка, Строка(Ссылка.УникальныйИдентификатор()));
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат Список.ВыгрузитьЗначения();
КонецФункции

Функция ЗначениеВМассиве(Значение)
	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;
КонецФункции

