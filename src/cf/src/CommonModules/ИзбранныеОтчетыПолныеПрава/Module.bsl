// Хранение избранных отчётов консоли в «Главном» (регистр ИзбранныеОтчеты).
//
// Модуль привилегированный и только серверный (без вызова с клиента): роли прав на регистр
// не имеют. Каждый метод сам определяет текущего пользователя ИБ по его уникальному
// идентификатору (параметр сеанса Пользователь у части ролей доступен на установку, поэтому
// не используется) и работает только с его записями. Отчёты здесь не формируются - это
// делает непривилегированный ПанельОтчетов с правами пользователя.
// План - docs/plans/reports-console.md.

// BSLLS:PrivilegedModuleMethodCall-off - вызовы собственных служебных методов модуля, а не точка входа.

#Область ПрограммныйИнтерфейс

// Избранное текущего пользователя для панели плиток. Снимок отдаётся, только если отчёт
// пользователю по-прежнему доступен и отпечаток прав совпадает; иначе снимок стирается.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Идентификатор - Строка - идентификатор избранного.
//   * ПолноеИмяОтчета - Строка - Отчет.Имя.
//   * Наименование - Строка - заголовок плитки.
//   * Ярлык - Булево - отчёт со своей формой: образа нет.
//   * Доступен - Булево - отчёт доступен пользователю.
//   * Снимок - Строка - HTML снимка или пусто.
//   * ДатаСнимка - Дата - дата формирования снимка.
//   * ОшибкаСнимка - Строка - ошибка последнего формирования.
//   * НужноОбновить - Булево - снимка нет, он устарел или построен с другими правами.
//
Функция СписокИзбранного() Экспорт

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Отпечаток = ПанельОтчетов.ОтпечатокПрав();
	Граница = ТекущаяУниверсальнаяДатаВМиллисекундах() - СрокАктуальностиСнимка();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Избранные.Идентификатор КАК Идентификатор,
	|	Избранные.ПолноеИмяОтчета КАК ПолноеИмяОтчета,
	|	Избранные.Наименование КАК Наименование,
	|	Избранные.Снимок КАК Снимок,
	|	Избранные.ДатаСнимка КАК ДатаСнимка,
	|	Избранные.МоментСнимка КАК МоментСнимка,
	|	Избранные.ОтпечатокПрав КАК ОтпечатокПрав,
	|	Избранные.ОшибкаСнимка КАК ОшибкаСнимка
	|ИЗ
	|	РегистрСведений.ИзбранныеОтчеты КАК Избранные
	|ГДЕ
	|	Избранные.ПользовательИБ = &ПользовательИБ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Избранные.Порядок,
	|	Избранные.Наименование";
	Запрос.УстановитьПараметр("ПользовательИБ", ПользовательИБ.УникальныйИдентификатор);
	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл

		Элемент = Новый Структура("Идентификатор, ПолноеИмяОтчета, Наименование, ДатаСнимка, ОшибкаСнимка");
		ЗаполнитьЗначенияСвойств(Элемент, Выборка);
		Элемент.Вставить("Ярлык", Не ПанельОтчетов.ОтчетНаОбщейФорме(Выборка.ПолноеИмяОтчета));
		Элемент.Вставить("Доступен", ПанельОтчетов.ОтчетДоступен(Выборка.ПолноеИмяОтчета, ПользовательИБ));
		Элемент.Вставить("Снимок", "");
		Элемент.Вставить("НужноОбновить", Ложь);

		СнимокЕсть = Не ПустаяСтрока(Выборка.Снимок) Или Не ПустаяСтрока(Выборка.ОшибкаСнимка);
		Если Не Элемент.Доступен Или Элемент.Ярлык Тогда
			Если СнимокЕсть Тогда
				ОчиститьСнимок(ПользовательИБ.УникальныйИдентификатор, Выборка.Идентификатор);
			КонецЕсли;
			Элемент.ОшибкаСнимка = "";
		ИначеЕсли СнимокЕсть И Выборка.ОтпечатокПрав <> Отпечаток Тогда
			ОчиститьСнимок(ПользовательИБ.УникальныйИдентификатор, Выборка.Идентификатор);
			Элемент.ОшибкаСнимка = "";
			Элемент.НужноОбновить = Истина;
		Иначе
			Элемент.Снимок = Выборка.Снимок;
			Элемент.НужноОбновить = Не СнимокЕсть Или Выборка.МоментСнимка < Граница;
		КонецЕсли;

		Результат.Добавить(Элемент);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Данные избранного текущего пользователя для открытия отчёта и формирования снимка.
//
// Параметры:
//  Идентификатор - Строка - идентификатор избранного.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если записи нет у текущего пользователя:
//   * ПолноеИмяОтчета - Строка - Отчет.Имя.
//   * КлючВарианта - Строка - ключ варианта, пусто у ярлыка.
//   * Наименование - Строка - заголовок плитки.
//   * Настройки - НастройкиКомпоновкиДанных, Неопределено - полные настройки.
//   * ПользовательскиеНастройки - ПользовательскиеНастройкиКомпоновкиДанных, Неопределено - настройки пользователя.
//   * Ярлык - Булево - отчёт со своей формой.
//
Функция ДанныеИзбранного(Идентификатор) Экспорт

	Запись = РегистрыСведений.ИзбранныеОтчеты.СоздатьМенеджерЗаписи();
	Запись.ПользовательИБ = ТекущийПользовательИБ();
	Запись.Идентификатор = Идентификатор;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("ПолноеИмяОтчета, КлючВарианта, Наименование");
	ЗаполнитьЗначенияСвойств(Результат, Запись);
	Результат.Вставить("Настройки", Запись.Настройки.Получить());
	Результат.Вставить("ПользовательскиеНастройки", Запись.ПользовательскиеНастройки.Получить());
	Результат.Вставить("Ярлык", Не ПанельОтчетов.ОтчетНаОбщейФорме(Запись.ПолноеИмяОтчета));
	Возврат Результат;

КонецФункции

// Добавляет отчёт или его вариант в избранное текущего пользователя последней плиткой.
// У отчёта со своей формой вариант и настройки не сохраняются - добавляется ярлык.
//
// Параметры:
//  ПолноеИмяОтчета - Строка - Отчет.Имя.
//  КлючВарианта - Строка - ключ варианта; пусто - вариант по умолчанию.
//  Наименование - Строка - заголовок плитки.
//  Настройки - НастройкиКомпоновкиДанных, Неопределено - полные настройки отчёта.
//  ПользовательскиеНастройки - ПользовательскиеНастройкиКомпоновкиДанных, Неопределено - настройки пользователя.
//
// Возвращаемое значение:
//  Строка - идентификатор нового избранного.
//
Функция Добавить(ПолноеИмяОтчета, КлючВарианта, Наименование, Настройки = Неопределено,
	ПользовательскиеНастройки = Неопределено) Экспорт

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Не ПанельОтчетов.ОтчетДоступен(ПолноеИмяОтчета, ПользовательИБ) Тогда
		ВызватьИсключение НСтр("ru = 'Нет доступа к отчёту'; fr = 'Pas d''accès au rapport'; en = 'No access to the report';
			|es = 'Sin acceso al informe'");
	КонецЕсли;
	Ярлык = Не ПанельОтчетов.ОтчетНаОбщейФорме(ПолноеИмяОтчета);
	Идентификатор = Строка(Новый УникальныйИдентификатор);

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНабор(ПользовательИБ.УникальныйИдентификатор);

		Запись = РегистрыСведений.ИзбранныеОтчеты.СоздатьМенеджерЗаписи();
		Запись.ПользовательИБ = ПользовательИБ.УникальныйИдентификатор;
		Запись.Идентификатор = Идентификатор;
		Запись.ПолноеИмяОтчета = ПолноеИмяОтчета;
		Запись.Наименование = Лев(СокрЛП(Наименование), ДлинаНаименования());
		Запись.Порядок = СледующийПорядок(ПользовательИБ.УникальныйИдентификатор);
		Если Не Ярлык Тогда
			Запись.КлючВарианта = КлючВарианта;
			Если ТипЗнч(Настройки) = Тип("НастройкиКомпоновкиДанных") Тогда
				Запись.Настройки = Новый ХранилищеЗначения(Настройки);
			КонецЕсли;
			Если ТипЗнч(ПользовательскиеНастройки) = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
				Запись.ПользовательскиеНастройки = Новый ХранилищеЗначения(ПользовательскиеНастройки);
			КонецЕсли;
		КонецЕсли;
		Запись.Записать();

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Идентификатор;

КонецФункции

// Переименовывает плитку избранного текущего пользователя.
//
// Параметры:
//  Идентификатор - Строка - идентификатор избранного.
//  Наименование - Строка - новый заголовок.
//
Процедура Переименовать(Идентификатор, Наименование) Экспорт

	ПользовательИБ = ТекущийПользовательИБ();
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьЗапись(ПользовательИБ, Идентификатор);
		Запись = ПрочитаннаяЗапись(ПользовательИБ, Идентификатор);
		Если Запись <> Неопределено Тогда
			Запись.Наименование = Лев(СокрЛП(Наименование), ДлинаНаименования());
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Меняет плитку местами с соседней.
//
// Параметры:
//  Идентификатор - Строка - идентификатор избранного.
//  Направление - Число - -1 выше, 1 ниже.
//
Процедура Сдвинуть(Идентификатор, Направление) Экспорт

	ПользовательИБ = ТекущийПользовательИБ();
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНабор(ПользовательИБ);

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Избранные.Идентификатор КАК Идентификатор,
		|	Избранные.Порядок КАК Порядок
		|ИЗ
		|	РегистрСведений.ИзбранныеОтчеты КАК Избранные
		|ГДЕ
		|	Избранные.ПользовательИБ = &ПользовательИБ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Избранные.Порядок,
		|	Избранные.Наименование";
		Запрос.УстановитьПараметр("ПользовательИБ", ПользовательИБ);
		Набор = Запрос.Выполнить().Выгрузить();
		Порядок = Набор.ВыгрузитьКолонку("Идентификатор");

		Индекс = Порядок.Найти(Идентификатор);
		Сосед = ?(Индекс = Неопределено, -1, Индекс + Направление);
		Если Сосед >= 0 И Сосед < Порядок.Количество() Тогда
			Порядок[Индекс] = Порядок[Сосед];
			Порядок[Сосед] = Идентификатор;
			// Перенумерация набора без дублей и пропусков; читаются и пишутся только записи, чей порядок меняется.
			Для Номер = 0 По Порядок.ВГраница() Цикл
				Строка = Набор.Найти(Порядок[Номер], "Идентификатор");
				Если Строка.Порядок = Номер + 1 Тогда
					Продолжить;
				КонецЕсли;
				Запись = ПрочитаннаяЗапись(ПользовательИБ, Порядок[Номер]);
				Запись.Порядок = Номер + 1;
				Запись.Записать();
			КонецЦикла;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Удаляет плитку из избранного текущего пользователя.
//
// Параметры:
//  Идентификатор - Строка - идентификатор избранного.
//
Процедура Удалить(Идентификатор) Экспорт

	ПользовательИБ = ТекущийПользовательИБ();
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьЗапись(ПользовательИБ, Идентификатор);
		Запись = РегистрыСведений.ИзбранныеОтчеты.СоздатьМенеджерЗаписи();
		Запись.ПользовательИБ = ПользовательИБ;
		Запись.Идентификатор = Идентификатор;
		Запись.Удалить();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Записывает результат формирования снимка. Запись не воскрешается, если её удалили, и не
// перезаписывается результатом более раннего формирования.
//
// Параметры:
//  Идентификатор - Строка - идентификатор избранного.
//  Снимок - Строка - HTML снимка.
//  ОшибкаСнимка - Строка - ошибка формирования.
//  МоментНачала - Число - ТекущаяУниверсальнаяДатаВМиллисекундах() начала формирования.
//
// Возвращаемое значение:
//  Булево - снимок записан.
//
Функция ЗаписатьСнимок(Идентификатор, Снимок, ОшибкаСнимка, МоментНачала) Экспорт

	ПользовательИБ = ТекущийПользовательИБ();
	Записан = Ложь;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьЗапись(ПользовательИБ, Идентификатор);
		Запись = ПрочитаннаяЗапись(ПользовательИБ, Идентификатор);
		Если Запись <> Неопределено И Запись.МоментСнимка < МоментНачала Тогда
			Запись.Снимок = Снимок;
			Запись.ОшибкаСнимка = ОшибкаСнимка;
			Запись.ДатаСнимка = ТекущаяДатаСеанса();
			Запись.МоментСнимка = МоментНачала;
			Запись.ОтпечатокПрав = ПанельОтчетов.ОтпечатокПрав();
			Запись.Записать();
			Записан = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Записан;

КонецФункции

// Ключи вариантов в избранном текущего пользователя - для пометки в «Все отчёты».
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - ПолноеИмяОтчета + "|" + КлючВарианта.
//   * Значение - Булево - Истина.
//
Функция ВариантыВИзбранном() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Избранные.ПолноеИмяОтчета КАК ПолноеИмяОтчета,
	|	Избранные.КлючВарианта КАК КлючВарианта
	|ИЗ
	|	РегистрСведений.ИзбранныеОтчеты КАК Избранные
	|ГДЕ
	|	Избранные.ПользовательИБ = &ПользовательИБ";
	Запрос.УстановитьПараметр("ПользовательИБ", ТекущийПользовательИБ());
	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ПолноеИмяОтчета + "|" + Выборка.КлючВарианта, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекущийПользовательИБ()

	Возврат ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;

КонецФункции

Процедура ЗаблокироватьНабор(ПользовательИБ)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ИзбранныеОтчеты");
	ЭлементБлокировки.УстановитьЗначение("ПользовательИБ", ПользовательИБ);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ЗаблокироватьЗапись(ПользовательИБ, Идентификатор)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ИзбранныеОтчеты");
	ЭлементБлокировки.УстановитьЗначение("ПользовательИБ", ПользовательИБ);
	ЭлементБлокировки.УстановитьЗначение("Идентификатор", Идентификатор);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

Функция ПрочитаннаяЗапись(ПользовательИБ, Идентификатор)

	Запись = РегистрыСведений.ИзбранныеОтчеты.СоздатьМенеджерЗаписи();
	Запись.ПользовательИБ = ПользовательИБ;
	Запись.Идентификатор = Идентификатор;
	Запись.Прочитать();
	Возврат ?(Запись.Выбран(), Запись, Неопределено);

КонецФункции

Процедура ОчиститьСнимок(ПользовательИБ, Идентификатор)

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьЗапись(ПользовательИБ, Идентификатор);
		Запись = ПрочитаннаяЗапись(ПользовательИБ, Идентификатор);
		Если Запись <> Неопределено Тогда
			Запись.Снимок = "";
			Запись.ОшибкаСнимка = "";
			Запись.ОтпечатокПрав = "";
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция СледующийПорядок(ПользовательИБ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(Избранные.Порядок), 0) + 1 КАК Порядок
	|ИЗ
	|	РегистрСведений.ИзбранныеОтчеты КАК Избранные
	|ГДЕ
	|	Избранные.ПользовательИБ = &ПользовательИБ";
	Запрос.УстановитьПараметр("ПользовательИБ", ПользовательИБ);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Порядок;

КонецФункции

Функция ДлинаНаименования()

	// BSLLS:MagicNumber-off - длина реквизита Наименование регистра.
	Возврат 150;
	// BSLLS:MagicNumber-on

КонецФункции

Функция СрокАктуальностиСнимка()

	// BSLLS:MagicNumber-off - час в миллисекундах: снимок старше обновляется фоном при открытии панели.
	Возврат 3600000;
	// BSLLS:MagicNumber-on

