Функция ДанныеТребованияВБазе(Ссылка)

	Если Ссылка.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Требования.Статус КАК Статус,
	|	Требования.Проведен КАК Проведен,
	|	Требования.Дата КАК Дата,
	|	Требования.Станок КАК Станок,
	|	Требования.МестоХранения КАК МестоХранения
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.Характеристика КАК Характеристика,
	|	Материалы.Количество КАК Количество,
	|	Материалы.СоСкладаСтанка КАК СоСкладаСтанка
	|ИЗ
	|	Документ.ТребованиеНакладная.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Материалы.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результаты = Запрос.ВыполнитьПакет();
	Шапка = Результаты[0].Выбрать();
	Если Не Шапка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = Новый Структура("Статус, Проведен, Дата, Станок, МестоХранения");
	ЗаполнитьЗначенияСвойств(Данные, Шапка);
	Данные.Вставить("Материалы", Результаты[1].Выгрузить());
	Данные.Вставить("ЕстьПеремещение", ЕстьПеремещение(Ссылка));
	Возврат Данные;

КонецФункции

Функция ЕстьПеремещение(Требование)

	Если Не ЗначениеЗаполнено(Требование) Тогда
		Возврат Ложь;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Записи.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Регистратор = &Требование";
	Запрос.УстановитьПараметр("Требование", Требование);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ПеремещенноеИзменено(Объект, ВБазе)

	ШапкаИзменена = Объект.Дата <> ВБазе.Дата Или Объект.МестоХранения <> ВБазе.МестоХранения
		Или Объект.Станок <> ВБазе.Станок;
	Если ШапкаИзменена Тогда
		Возврат Истина;
	КонецЕсли;
	Если Объект.Материалы.Количество() <> ВБазе.Материалы.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	Для Индекс = 0 По Объект.Материалы.Количество() - 1 Цикл
		Строка = Объект.Материалы[Индекс];
		Прежняя = ВБазе.Материалы[Индекс];
		Для Каждого Имя Из СтрРазделить("Номенклатура,Характеристика,Количество,СоСкладаСтанка", ",") Цикл
			Если Строка[Имя] <> Прежняя[Имя] Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ТекстПерехода(Было, Стало)

	Шаблон = НСтр("ru = 'Требование-накладную нельзя перевести из статуса «%1» в «%2»';
		|fr = 'Le bon de consommation ne peut pas passer du statut « %1 » à « %2 »';
		|en = 'The requisition cannot change status from ""%1"" to ""%2""';
		|es = 'El vale no puede pasar del estado «%1» a «%2»'");
	Возврат СтрШаблон(Шаблон, Было, Стало);

КонецФункции

// Закрепление свободного остатка станка: по каждой позиции материалов берётся не больше свободного остатка станка
// (текущий остаток склада станка минус закреплённое за другими требованиями). Только для статусов с закреплением,
// пока перемещения не было; иначе - ноль.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
Процедура РассчитатьСоСкладаСтанка(Объект)

	Для Каждого Строка Из Объект.Материалы Цикл
		Строка.СоСкладаСтанка = 0;
	КонецЦикла;
	Если Не ЗакреплениеНужно(Объект) Тогда
		Возврат;
	КонецЕсли;
	Свободно = СвободныйОстатокСтанка(Объект.Станок, Объект.Материалы, Объект.Ссылка);
	Для Каждого Строка Из Объект.Материалы Цикл
		Ключ = КлючПозиции(Строка.Номенклатура, Строка.Характеристика);
		Есть = Свободно.Получить(Ключ);
		Если Есть = Неопределено Или Есть <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка.СоСкладаСтанка = Мин(Есть, Строка.Количество);
		Свободно.Вставить(Ключ, Есть - Строка.СоСкладаСтанка);
	КонецЦикла;

КонецПроцедуры

// Закрепление нужно статусу: запланировано со списанием при размещении, запущено, завершено и отменено с материалами,
// оставленными на станке.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Булево - Истина, если статус закрепляет материалы
//
Функция ЗакреплениеНужно(Объект)

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Возврат Объект.Статус = Статусы.Запущено Или Объект.Статус = Статусы.Завершено
		Или Объект.Статус = Статусы.Запланировано И Объект.СписыватьПриРазмещении
		Или Объект.Статус = Статусы.Отменено И Объект.МатериалыОставлены;

КонецФункции

// Перемещение на склад станка нужно тем же статусам, что и закрепление: отмена с возвратом его удаляет.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Булево - Истина, если перемещение должно быть
//
Функция ПеремещениеНужно(Объект)

	Возврат ЗакреплениеНужно(Объект);

КонецФункции

// Тексты отказа проведения требования под блокировками: склад станка, заказ, переработка, лимит заказа (N2), вес и
// длительность, статусные условия и пересечения загрузки станка.
//
// Параметры:
//  Объект          - ДокументОбъект.ТребованиеНакладная - проводимое требование
//  ЕстьПеремещение - Булево - перемещение на склад станка уже записано
//
// Возвращаемое значение:
//  Массив из Строка - тексты отказа; пустой - провести можно
//
Функция ТекстыОшибокПроведения(Объект, ЕстьПеремещение)

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Тексты = Новый Массив;
	ДобавитьТекст(Тексты, ТекстСкладаСтанка(Объект));
	ДобавитьТекст(Тексты, ТекстЗаказа(Объект));
	Если Объект.Статус = Статусы.Отменено Тогда
		Если ЕстьПеремещение И Не Объект.МатериалыОставлены И Не ПеремещениеМожноУдалить(Объект.Ссылка) Тогда
			Тексты.Добавить(НСтр("ru = 'Пока отмену готовили, партии на станке израсходовала соседняя загрузка: повторите «Отменить»';
				|fr = 'Les lots de la machine ont été consommés entre-temps par une autre charge : relancez « Annuler »';
				|en = 'Machine batches were consumed by another load meanwhile: repeat ""Cancel""';
				|es = 'Otra carga consumió entretanto los lotes de la máquina: repita «Cancelar»'"));
		КонецЕсли;
		Возврат Тексты;
	КонецЕсли;
	ДобавитьТекст(Тексты, ТекстПродукцииВПереработке(Объект));
	Количество = ?(Объект.Статус = Статусы.Завершено, Объект.КоличествоФакт, Объект.Количество);
	ДобавитьТекст(Тексты, ТекстПревышенияЗаказа(Объект, Количество));
	ДобавитьТексты(Тексты, ТекстыВесаИСтатуса(Объект));
	Если Тексты.Количество() = 0 Тогда
		ДобавитьТексты(Тексты, ТекстыПересечений(Объект));
	КонецЕсли;
	Возврат Тексты;

КонецФункции

// Склад станка заполнен и не совпадает со складом-источником требования.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Строка - текст отказа; пустая строка - склад в порядке
//
Функция ТекстСкладаСтанка(Объект)

	Склад = СкладСтанка(Объект.Станок);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Шаблон = НСтр("ru = 'У станка «%1» не задан склад станка';
			|fr = 'L''entrepôt de la machine « %1 » n''est pas renseigné';
			|en = 'Machine ""%1"" has no machine warehouse';
			|es = 'La máquina «%1» no tiene almacén de máquina'");
		Возврат СтрШаблон(Шаблон, Объект.Станок);
	КонецЕсли;
	Если Склад = Объект.МестоХранения Или СкладыСтанков().Найти(Объект.МестоХранения) <> Неопределено Тогда
		Возврат НСтр("ru = 'Склад требования-накладной - склад станка: укажите обычный склад, откуда материалы идут на станок';
			|fr = 'L''entrepôt du bon est celui d''une machine : indiquez l''entrepôt ordinaire d''où partent les matières';
			|en = 'The requisition warehouse is a machine warehouse: specify the regular warehouse the materials come from';
			|es = 'El almacén del vale es el de una máquina: indique el almacén normal de donde salen los materiales'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Вес материалов, длительность загрузки и условия статуса: план начала, факт начала и один запуск на станок, факт
// завершения.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Массив из Строка - тексты отказа
//
Функция ТекстыВесаИСтатуса(Объект)

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Тексты = Новый Массив;
	Вес = ЗагрузкаСтанков.ВесНоменклатурыКг(Объект.Материалы);
	Если Вес.БезВеса.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'У материалов не задан вес, время загрузки не посчитать: %1';
			|fr = 'Le poids des matières n''est pas renseigné, la durée de charge ne peut pas être calculée : %1';
			|en = 'The materials have no weight, the load time cannot be calculated: %1';
			|es = 'Los materiales no tienen peso, no se puede calcular el tiempo de carga: %1'");
		Тексты.Добавить(СтрШаблон(Шаблон, СтрСоединить(Вес.БезВеса, ", ")));
	Иначе
		ДобавитьТекст(Тексты, ЗагрузкаСтанков.ДлительностьЗагрузки(Объект.Станок, Вес.Вес).ТекстОшибки);
	КонецЕсли;
	Если Объект.Статус = Статусы.Запланировано И Не ЗначениеЗаполнено(Объект.ПланНачало) Тогда
		Тексты.Добавить(НСтр("ru = 'Укажите план начала загрузки';
			|fr = 'Indiquez le début prévu de la charge';
			|en = 'Specify the planned load start';
			|es = 'Indique el inicio previsto de la carga'"));
	КонецЕсли;
	Если Объект.Статус = Статусы.Запущено Тогда
		Если Не ЗначениеЗаполнено(Объект.ФактНачало) Тогда
			Тексты.Добавить(НСтр("ru = 'Укажите факт начала загрузки';
				|fr = 'Indiquez le début réel de la charge';
				|en = 'Specify the actual load start';
				|es = 'Indique el inicio real de la carga'"));
		КонецЕсли;
		ДобавитьТекст(Тексты, ТекстЗапретаВторогоЗапуска(Объект));
	КонецЕсли;
	Если Объект.Статус = Статусы.Завершено Тогда
		ДобавитьТексты(Тексты, ТекстыЗавершения(Объект));
	КонецЕсли;
	Возврат Тексты;

КонецФункции

// Пересечения записи «Загрузки станков» требования с занятым временем станка (правило сборки 1).
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Массив из Строка - тексты отказа
//
Функция ТекстыПересечений(Объект)

	Тексты = Новый Массив;
	Интервал = ИнтервалЗагрузки(Объект);
	Если Интервал = Неопределено Тогда
		Возврат Тексты;
	КонецЕсли;
	Пересечения = ЗагрузкаСтанков.ПересеченияЗагрузки(Объект.Станок, Интервал.Начало, Интервал.Окончание,
		Перечисления.ВидыЗагрузкиСтанков.Работа, Интервал.План, Объект.Ссылка);
	Для Каждого Пересечение Из Пересечения Цикл
		Тексты.Добавить(ЗагрузкаСтанков.ТекстПересеченияЗагрузки(Пересечение));
	КонецЦикла;
	Возврат Тексты;

КонецФункции

// Почему требование нельзя провести по заказу: заказ не на производство или не проведён, продукция не совпадает со
// строкой заказа.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Строка - текст отказа; пустая строка - заказ в порядке
//
Функция ТекстЗаказа(Объект)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Заказ, "Проведен, ВидОперации");
	Если Реквизиты.Проведен <> Истина
		Или Реквизиты.ВидОперации <> Перечисления.ВидыОперацийЗаказаПокупателя.Производство Тогда
		Возврат НСтр("ru = 'Требование-накладная вводится по проведённому заказу на производство';
			|fr = 'Le bon de consommation se saisit pour une commande de production validée';
			|en = 'A requisition is entered for a posted production order';
			|es = 'El vale se introduce para un pedido de producción contabilizado'");
	КонецЕсли;
	Если Объект.КодСтрокиПродукции = 0 Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Товары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|	И Товары.КодСтроки = &КодСтроки
	|	И Товары.Номенклатура = &Номенклатура
	|	И Товары.Характеристика = &Характеристика";
	Запрос.УстановитьПараметр("Заказ", Объект.Заказ);
	Запрос.УстановитьПараметр("КодСтроки", Объект.КодСтрокиПродукции);
	Запрос.УстановитьПараметр("Номенклатура", Объект.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Объект.Характеристика);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат НСтр("ru = 'Продукция требования-накладной не совпадает со строкой заказа: заполните требование по строке заново';
			|fr = 'Le produit du bon ne correspond pas à la ligne de commande : remplissez à nouveau le bon par la ligne';
			|en = 'The requisition product does not match the order line: refill the requisition from the line';
			|es = 'El producto del vale no coincide con la línea del pedido: rellene el vale de nuevo por la línea'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Условия «Завершить»: факт окончания позже начала и даты документа, выпущено больше нуля.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Массив из Строка - тексты отказа
//
Функция ТекстыЗавершения(Объект)

	Тексты = Новый Массив;
	Если Не ЗначениеЗаполнено(Объект.ФактОкончание) Или Объект.ФактОкончание <= Объект.ФактНачало
		Или Объект.ФактОкончание <= Объект.Дата Тогда
		Тексты.Добавить(НСтр("ru = 'Факт окончания загрузки должен быть позже её начала и даты требования-накладной';
			|fr = 'La fin réelle de la charge doit être postérieure à son début et à la date du bon';
			|en = 'The actual load end must be later than its start and the requisition date';
			|es = 'El fin real de la carga debe ser posterior a su inicio y a la fecha del vale'"));
	КонецЕсли;
	Если Объект.КоличествоФакт <= 0 Тогда
		Тексты.Добавить(НСтр("ru = 'Укажите, сколько продукции выпущено';
			|fr = 'Indiquez la quantité produite';
			|en = 'Specify the produced quantity';
			|es = 'Indique la cantidad producida'"));
	КонецЕсли;
	Возврат Тексты;

КонецФункции

// Интервал записи «Загрузки станков» по статусу: план - плановые даты, запуск - от факта начала на длительность по
// режиму станка, завершение - фактические даты.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Структура, Неопределено - Начало, Окончание, План; Неопределено - записи нет (отменено) или посчитать нельзя
//
Функция ИнтервалЗагрузки(Объект)

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Если Объект.Статус = Статусы.Запланировано Тогда
		Если Не ЗначениеЗаполнено(Объект.ПланНачало) Или Объект.ПланОкончание <= Объект.ПланНачало Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат НовыйИнтервал(Объект.ПланНачало, Объект.ПланОкончание, Истина);
	ИначеЕсли Объект.Статус = Статусы.Запущено Тогда
		Если Не ЗначениеЗаполнено(Объект.ФактНачало) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Окончание = ЗагрузкаСтанков.ОкончаниеПоРежиму(Объект.Станок, Объект.ФактНачало, Объект.Длительность);
		Если Окончание = Неопределено Или Окончание <= Объект.ФактНачало Тогда
			Окончание = Объект.ФактНачало + Макс(Окр(Объект.Длительность * СекундВЧасе(), 0), 1);
		КонецЕсли;
		Возврат НовыйИнтервал(Объект.ФактНачало, Окончание, Ложь);
	ИначеЕсли Объект.Статус = Статусы.Завершено Тогда
		Возврат НовыйИнтервал(Объект.ФактНачало, Объект.ФактОкончание, Ложь);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция НовыйИнтервал(Начало, Окончание, План)

	Интервал = Новый Структура;
	Интервал.Вставить("Начало", Начало);
	Интервал.Вставить("Окончание", Окончание);
	Интервал.Вставить("План", План);
	Возврат Интервал;

КонецФункции

// Запись «Загрузки станков» требования: «Работа», ресурсы Заказ и Вес.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
Процедура ЗаписатьЗагрузку(Объект)

	Интервал = ИнтервалЗагрузки(Объект);
	Если Интервал = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запись = Объект.Движения.ЗагрузкаСтанков.Добавить();
	Запись.Станок = Объект.Станок;
	Запись.Начало = Интервал.Начало;
	Запись.Окончание = Интервал.Окончание;
	Запись.Часы = ЗагрузкаСтанков.ЧасыМеждуДатами(Интервал.Начало, Интервал.Окончание);
	Запись.ВидЗаписи = Перечисления.ВидыЗагрузкиСтанков.Работа;
	Запись.План = Интервал.План;
	Запись.Заказ = Объект.Заказ;
	Запись.Вес = Объект.Вес;

КонецПроцедуры

// Закрепление материалов за требованием: приход на дату документа; при завершении и отмене с оставленными на станке
// материалами - расход на дату закрытия (история закрепления сохраняется для остатков на прошлую дату).
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
Процедура ЗаписатьЗакрепление(Объект)

	Если Не ЗакреплениеНужно(Объект) Тогда
		Возврат;
	КонецЕсли;
	Позиции = Объект.Материалы.Выгрузить(, "Номенклатура, Характеристика, Количество");
	Позиции.Свернуть(КолонкиПозиции(), "Количество");
	ДатаСнятия = ДатаСнятияЗакрепления(Объект);
	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьЗакрепление(Объект, Позиция, ВидДвиженияНакопления.Приход, Объект.Дата);
		Если ДатаСнятия <> Неопределено Тогда
			ДобавитьЗакрепление(Объект, Позиция, ВидДвиженияНакопления.Расход, ДатаСнятия);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Дата снятия закрепления: факт окончания у завершённого, дата отмены у отменённого.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Дата, Неопределено - дата расхода закрепления; Неопределено - закрепление открыто
//
Функция ДатаСнятияЗакрепления(Объект)

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Если Объект.Статус = Статусы.Завершено Тогда
		Возврат Объект.ФактОкончание;
	ИначеЕсли Объект.Статус = Статусы.Отменено Тогда
		Возврат Макс(Объект.ДатаОтмены, Объект.Дата);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Запись закрепления позиции материалов.
//
// Параметры:
//  Объект      - ДокументОбъект.ТребованиеНакладная - требование
//  Позиция     - СтрокаТаблицыЗначений - Номенклатура, Характеристика, Количество
//  ВидДвижения - ВидДвиженияНакопления - приход или расход
//  Период      - Дата - период записи
//
Процедура ДобавитьЗакрепление(Объект, Позиция, ВидДвижения, Период)

	Запись = Объект.Движения.МатериалыНаСтанках.Добавить();
	Запись.ВидДвижения = ВидДвижения;
	Запись.Период = Период;
	Запись.Станок = Объект.Станок;
	Запись.Требование = Объект.Ссылка;
	Запись.Номенклатура = Позиция.Номенклатура;
	Запись.Характеристика = Позиция.Характеристика;
	Запись.Количество = Позиция.Количество;
	Запись.Заказ = Объект.Заказ;
	Запись.КодСтрокиПродукции = Объект.КодСтрокиПродукции;

КонецПроцедуры

// Строки перемещения на склад станка для диспетчера `ТоварыВНаличии.СформироватьДвижения`: загруженное минус
// закреплённое из свободного остатка станка, разложенное по партиям склада-источника.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - проводимое требование
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. РазложитьПоПартиям
//
Функция ТаблицаПеремещения(Объект)

	Строки = НоваяТаблица("Номенклатура, Характеристика, Количество");
	Для Каждого Строка Из Объект.Материалы Цикл
		Переместить = Строка.Количество - Строка.СоСкладаСтанка;
		Если Переместить > 0 Тогда
			Новая = Строки.Добавить();
			ЗаполнитьЗначенияСвойств(Новая, Строка, КолонкиПозиции());
			Новая.Количество = Переместить;
		КонецЕсли;
	КонецЦикла;
	Строки.Свернуть(КолонкиПозиции(), "Количество");
	Возврат РазложитьПоПартиям(Строки, Объект.МестоХранения, Новый Граница(Объект.МоментВремени(), ВидГраницы.Исключая));

КонецФункции

// Выпуск продукции по завершённому требованию: дата - факт окончания, материалы - израсходованное, разложенное по
// партиям склада станка (FIFO по складу, решение владельца 1), продукция - на склад требования (N9). Ошибка
// проведения выпуска - отказ проведения требования и откат всей транзакции.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - проводимое требование
//  Отказ  - Булево - устанавливается при ошибке выпуска
//
Процедура СоздатьВыпуск(Объект, Отказ)

	Выпуск = Документы.ВыпускПродукции.СоздатьДокумент();
	Выпуск.Дата = Объект.ФактОкончание;
	Выпуск.Организация = Объект.Организация;
	Выпуск.Основание = Объект.Заказ;
	Выпуск.Требование = Объект.Ссылка;
	Выпуск.МестоХранения = СкладСтанка(Объект.Станок);
	Выпуск.МестоХраненияОприходование = Объект.МестоХранения;
	Выпуск.Оборудование = Объект.Станок;
	Выпуск.Оператор = Объект.Оператор;
	Выпуск.Ответственный = Объект.Ответственный;
	Выпуск.Номенклатура = Объект.Номенклатура;
	Выпуск.Характеристика = Объект.Характеристика;
	Выпуск.Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Номенклатура, "Единица");
	Выпуск.КоличествоУпаковок = Объект.КоличествоФакт;
	Выпуск.Количество = Объект.КоличествоФакт;
	Выпуск.ДополнительныеСвойства.Вставить(ИмяСвойстваЗаписиТребования(), Объект.Ссылка);
	Выпуск.Записать(РежимЗаписиДокумента.Запись);

	Строки = НоваяТаблица("Номенклатура, Характеристика, Количество");
	Для Каждого Строка Из Объект.Материалы Цикл
		Если Строка.Израсходовано > 0 Тогда
			Новая = Строки.Добавить();
			ЗаполнитьЗначенияСвойств(Новая, Строка, КолонкиПозиции());
			Новая.Количество = Строка.Израсходовано;
		КонецЕсли;
	КонецЦикла;
	Строки.Свернуть(КолонкиПозиции(), "Количество");
	Граница = Новый Граница(Выпуск.МоментВремени(), ВидГраницы.Исключая);
	Партии = РазложитьПоПартиям(Строки, Выпуск.МестоХранения, Граница);
	Единицы = ЕдиницыНоменклатуры(Партии.ВыгрузитьКолонку("Номенклатура"));
	Для Каждого Партия Из Партии Цикл
		СтрокаТЧ = Выпуск.ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, Партия, "Номенклатура, Характеристика, Серия, Партия, Количество");
		СтрокаТЧ.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Выпуск.ТЧТовары);
		СтрокаТЧ.Упаковка = Единицы.Получить(Партия.Номенклатура);
		СтрокаТЧ.КоличествоУпаковок = Партия.Количество;
	КонецЦикла;
	Попытка
		Выпуск.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект, , , Отказ);
	КонецПопытки;

КонецПроцедуры

Функция ЕдиницыНоменклатуры(Номенклатура)

	Единицы = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Позиции.Ссылка КАК Ссылка,
	|	Позиции.Единица КАК Единица
	|ИЗ
	|	Справочник.Номенклатура КАК Позиции
	|ГДЕ
	|	Позиции.Ссылка В (&Номенклатура)";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Единицы.Вставить(Выборка.Ссылка, Выборка.Единица);
	КонецЦикла;
	Возврат Единицы;

КонецФункции

// Ключи инварианта требования: склад станка и позиции материалов.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  ТаблицаЗначений - МестоХранения, Номенклатура, Характеристика
//
Функция КлючиТребования(Объект)

	Ключи = НоваяТаблица(КолонкиКлючаСклада());
	Склад = СкладСтанка(Объект.Станок);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Ключи;
	КонецЕсли;
	Для Каждого Строка Из Объект.Материалы Цикл
		Ключ = Ключи.Добавить();
		ЗаполнитьЗначенияСвойств(Ключ, Строка, КолонкиПозиции());
		Ключ.МестоХранения = Склад;
	КонецЦикла;
	Ключи.Свернуть(КолонкиКлючаСклада());
	Возврат Ключи;

КонецФункции

// Текст нарушения инварианта по ключам «склад станка, номенклатура, характеристика»: текущий остаток склада станка
// меньше закреплённого за требованиями этого станка.
//
// Параметры:
//  Ключи - ТаблицаЗначений - МестоХранения, Номенклатура, Характеристика
//
// Возвращаемое значение:
//  Строка - текст нарушения; пустая строка - инвариант соблюдён
//
Функция ТекстНарушенияЗакрепления(Ключи)

	Если Ключи.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ключи.МестоХранения КАК МестоХранения,
	|	Ключи.Номенклатура КАК Номенклатура,
	|	Ключи.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТКлючи
	|ИЗ
	|	&Ключи КАК Ключи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТКлючи.МестоХранения КАК МестоХранения,
	|	ВТКлючи.Номенклатура КАК Номенклатура,
	|	ВТКлючи.Характеристика КАК Характеристика,
	|	Станки.Ссылка КАК Станок
	|ПОМЕСТИТЬ ВТСтанки
	|ИЗ
	|	ВТКлючи КАК ВТКлючи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПроизводственноеОборудование КАК Станки
	|		ПО ВТКлючи.МестоХранения = Станки.СкладСтанка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Станок КАК Станок,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТЗакреплено
	|ИЗ
	|	РегистрНакопления.МатериалыНаСтанках.Остатки(
	|			,
	|			(Станок, Номенклатура, Характеристика) В
	|				(ВЫБРАТЬ
	|					ВТСтанки.Станок КАК Станок,
	|					ВТСтанки.Номенклатура КАК Номенклатура,
	|					ВТСтанки.Характеристика КАК Характеристика
	|				ИЗ
	|					ВТСтанки КАК ВТСтанки)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Станок,
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.МестоХранения КАК МестоХранения,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТСклад
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			,
	|			(МестоХранения, Номенклатура, Характеристика) В
	|				(ВЫБРАТЬ
	|					ВТКлючи.МестоХранения КАК МестоХранения,
	|					ВТКлючи.Номенклатура КАК Номенклатура,
	|					ВТКлючи.Характеристика КАК Характеристика
	|				ИЗ
	|					ВТКлючи КАК ВТКлючи)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.МестоХранения,
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСтанки.Станок КАК Станок,
	|	ВТСтанки.Номенклатура КАК Номенклатура,
	|	ВТСтанки.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(ВТСклад.Количество, 0) КАК Остаток,
	|	ВТЗакреплено.Количество КАК Закреплено
	|ИЗ
	|	ВТСтанки КАК ВТСтанки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗакреплено КАК ВТЗакреплено
	|		ПО ВТСтанки.Станок = ВТЗакреплено.Станок
	|			И ВТСтанки.Номенклатура = ВТЗакреплено.Номенклатура
	|			И ВТСтанки.Характеристика = ВТЗакреплено.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСклад КАК ВТСклад
	|		ПО ВТСтанки.МестоХранения = ВТСклад.МестоХранения
	|			И ВТСтанки.Номенклатура = ВТСклад.Номенклатура
	|			И ВТСтанки.Характеристика = ВТСклад.Характеристика
	|ГДЕ
	|	ЕСТЬNULL(ВТСклад.Количество, 0) < ВТЗакреплено.Количество";
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Выборка = Запрос.Выполнить().Выбрать();
	Тексты = Новый Массив;
	Шаблон = НСтр("ru = 'На складе станка «%1» «%2» закреплено за требованиями-накладными %3, а остаток %4';
		|fr = 'Sur l''entrepôt de la machine « %1 », %3 de « %2 » sont réservés aux bons de consommation, le stock est %4';
		|en = 'On the warehouse of machine ""%1"", %3 of ""%2"" is reserved for requisitions, but the stock is %4';
		|es = 'En el almacén de la máquina «%1», %3 de «%2» están reservados para vales, pero el stock es %4'");
	Пока Выборка.Следующий() Цикл
		Позиция = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика);
		Тексты.Добавить(СтрШаблон(Шаблон, Выборка.Станок, Позиция, Выборка.Закреплено, Выборка.Остаток));
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

// Склады станков - для быстрого выхода проверки инварианта у документов без складов станков.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.МестаХранения - склады станков
//
Функция СкладыСтанков()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Станки.СкладСтанка КАК СкладСтанка
	|ИЗ
	|	Справочник.ПроизводственноеОборудование КАК Станки
	|ГДЕ
	|	Станки.СкладСтанка <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СкладСтанка");

КонецФункции

Функция ТекстОткрытыхТребованийСтанка(Станок)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Требования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Станок = &Станок
	|	И Требования.Проведен
	|	И Требования.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запланировано),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Остатки.Требование
	|ИЗ
	|	РегистрНакопления.МатериалыНаСтанках.Остатки(, Станок = &Станок) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток <> 0";
	Запрос.УстановитьПараметр("Станок", Станок);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'У станка есть открытое требование-накладная или закреплённые материалы (%1): склад станка менять нельзя';
		|fr = 'La machine a un bon ouvert ou des matières réservées (%1) : son entrepôt ne peut pas changer';
		|en = 'The machine has an open requisition or reserved materials (%1): its warehouse cannot change';
		|es = 'La máquina tiene un vale abierto o materiales reservados (%1): su almacén no puede cambiar'");
	Возврат СтрШаблон(Шаблон, Выборка.Ссылка);

КонецФункции

Функция СкладПодчиненный(Склад)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.МестаХранения КАК Склады
	|ГДЕ
	|	Склады.ПодчиненныйСклад = &Склад";
	Запрос.УстановитьПараметр("Склад", Склад);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

