// Требования-накладные учёта станков (сборка 2): загрузка станка по строке заказа на производство, перемещение
// материалов на склад станка, закрепление их за требованием («Материалы на станках»), выпуск продукции со склада
// станка при «Завершить», запреты двойного производства и инвариант «остаток склада станка не меньше закреплённого».
// Правила и порядок блокировок - docs/plans/machines.md, «Сборка 2 - детально».
//
// Модуль механизма: проверки читают регистры, документы и справочники служебно - их вызывают проведение чужих
// документов и запись наборов «Товаров в наличии» под ролями без прав на требования и станки (PDV, кладовщик).
// Правило модуля: экспортные методы не принимают от клиента текст запроса или имена объектов и не вызываются из модулей
// «вызов сервера» с произвольными параметрами - иначе привилегированное чтение отдало бы чужие данные.
// BSLLS:SetPrivilegedMode-off
#Область ПрограммныйИнтерфейс

#Область ЗаписьИПроведение

// Проверки и расчётные поля требования перед записью: переходы статуса, неизменность перемещённого, вес,
// длительность, план окончания и закрепление свободного остатка станка. Вызывается из ПередЗаписью документа.
//
// Параметры:
//  Объект      - ДокументОбъект.ТребованиеНакладная - записываемое требование
//  Отказ       - Булево - устанавливается при запрете записи
//  РежимЗаписи - РежимЗаписиДокумента - режим записи
//
Процедура ПередЗаписьюТребования(Объект, Отказ, РежимЗаписи) Экспорт

	ВБазе = ДанныеТребованияВБазе(Объект.Ссылка);
	ТекстЗапрета = ТекстЗапретаЗаписи(Объект, РежимЗаписи, ВБазе);
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, Объект, , , Отказ);
		Возврат;
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ЗаполнитьРасчетныеПоля(Объект, ВБазе <> Неопределено И ВБазе.ЕстьПеремещение);
	КонецЕсли;

КонецПроцедуры

// Проведение требования: блокировки, проверки, «Загрузка станков», закрепление, перемещение на склад станка,
// проверка инварианта склада станка и при «Завершить» - выпуск продукции в той же транзакции.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - проводимое требование
//  Отказ  - Булево - устанавливается при отказе проведения
//
Процедура ОбработкаПроведенияТребования(Объект, Отказ) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Объект, Блокировка);
	Блокировка.Заблокировать();

	ЕстьПеремещение = ЕстьПеремещение(Объект.Ссылка);
	Для Каждого ТекстОшибки Из ТекстыОшибокПроведения(Объект, ЕстьПеремещение) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект, , , Отказ);
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения = Объект.Движения;
	Движения.ЗагрузкаСтанков.Очистить();
	Движения.ЗагрузкаСтанков.Записывать = Истина;
	Движения.МатериалыНаСтанках.Очистить();
	Движения.МатериалыНаСтанках.Записывать = Истина;
	ЗаписатьЗагрузку(Объект);
	ЗаписатьЗакрепление(Объект);

	Если ПеремещениеНужно(Объект) И ЕстьПеремещение Тогда
		// Перемещение неизменно: перепроведение его не пересобирает (ревью плана, P0 второго круга).
		Движения.ТоварыВНаличии.Записывать = Ложь;
		Движения.ДополнительныеРасходы.Записывать = Ложь;
	Иначе
		Движения.ТоварыВНаличии.Очистить();
		Движения.ТоварыВНаличии.Записывать = Истина;
		Движения.ДополнительныеРасходы.Очистить();
		Движения.ДополнительныеРасходы.Записывать = Истина;
		Если ПеремещениеНужно(Объект) Тогда
			Объект.ДополнительныеСвойства.Вставить("ТЗТоварыССериями", ТаблицаПеремещения(Объект));
			Если Не РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(Объект) Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Движения.Записать();

	ТекстНарушения = ТекстНарушенияЗакрепления(КлючиТребования(Объект));
	Если ЗначениеЗаполнено(ТекстНарушения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстНарушения, Объект, , , Отказ);
		Возврат;
	КонецЕсли;

	Если Объект.Статус = Перечисления.СтатусыТребованийНакладных.Завершено Тогда
		СоздатьВыпуск(Объект, Отказ);
	КонецЕсли;

КонецПроцедуры

// Блокировки проведения требования - один набор в одном порядке: загрузка станка, закрепления станка, остатки
// материалов и продукции на всех складах (тот же широкий элемент, что берёт вложенный выпуск, - он ничего не
// расширяет), потребности заказа (общий лимит производства заказа, N2). История статусов заказа - последней, внутри
// проведения выпуска (урок E8).
//
// Параметры:
//  Объект     - ДокументОбъект.ТребованиеНакладная - требование
//  Блокировка - БлокировкаДанных - заполняемая блокировка
//
Процедура ЗаполнитьБлокировкуПроведения(Объект, Блокировка) Экспорт

	УправляемыеБлокировки.ЗагрузкаСтанков(Блокировка, Объект.Станок);
	Эл = Блокировка.Добавить("РегистрНакопления.МатериалыНаСтанках");
	Эл.Режим = РежимБлокировкиДанных.Исключительный;
	Эл.УстановитьЗначение("Станок", Объект.Станок);
	Позиции = Объект.Материалы.Выгрузить(, "Номенклатура");
	Позиции.Добавить().Номенклатура = Объект.Номенклатура;
	Позиции.Свернуть("Номенклатура");
	УправляемыеБлокировки.ТоварыВНаличии(Блокировка, Позиции);
	Если ЗначениеЗаполнено(Объект.Заказ) Тогда
		УправляемыеБлокировки.ПотребностиПроизводства(Блокировка, Объект.Заказ);
	КонецЕсли;

КонецПроцедуры

// Почему требование нельзя удалить: по нему есть выпуск или перемещённые материалы.
//
// Параметры:
//  Требование - ДокументСсылка.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - удалить можно
//
Функция ТекстЗапретаУдаления(Требование) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Если ЗначениеЗаполнено(ВыпускПоТребованию(Требование)) Или ЕстьПеремещение(Требование) Тогда
		Возврат НСтр("ru = 'По требованию-накладной есть выпуск или перемещённые на станок материалы: удалить его нельзя';
			|fr = 'Le bon de consommation a une production ou des matières transférées sur la machine : il ne peut pas être supprimé';
			|en = 'The requisition has an output or materials moved to the machine: it cannot be deleted';
			|es = 'El vale tiene una producción o materiales trasladados a la máquina: no se puede eliminar'");
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

#Область Действия

// Действие формы и рабочего места над требованием: ставит статус и даты и проводит требование.
//
// Параметры:
//  Объект   - ДокументОбъект.ТребованиеНакладная - требование
//  Действие - Строка - «Разместить», «Запустить», «Завершить», «Отменить»
//
Процедура ВыполнитьДействие(Объект, Действие) Экспорт

	Перемещено = Не Объект.ЭтоНовый() И ЕстьПеремещение(Объект.Ссылка);
	Если Действие = "Разместить" Тогда
		ПодготовитьРазмещение(Объект);
	ИначеЕсли Действие = "Запустить" Тогда
		ПодготовитьЗапуск(Объект, Перемещено);
	ИначеЕсли Действие = "Завершить" Тогда
		ПодготовитьЗавершение(Объект);
	ИначеЕсли Действие = "Отменить" Тогда
		Объект.Статус = Перечисления.СтатусыТребованийНакладных.Отменено;
		Объект.ДатаОтмены = ТекущаяДатаСеанса();
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестное действие требования-накладной: %1", Действие);
	КонецЕсли;
	Объект.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

// «Вернуть в работу»: исправление ошибочного завершения. Выпуск по требованию распроводится и помечается на удаление
// механизмом, требование возвращается в «Запущено» с закреплением. Только руководителю и администратору; отказ, если
// продукция выпуска уже тронута, недорасход забрала следующая загрузка или на станке запущено другое требование.
//
// Параметры:
//  Требование - ДокументСсылка.ТребованиеНакладная - завершённое требование
//
Процедура ВернутьВРаботу(Требование) Экспорт

	Если Не МожноВозвращатьВРаботу() Тогда
		ВызватьИсключение НСтр("ru = 'Вернуть требование-накладную в работу может руководитель или администратор';
			|fr = 'Seul un responsable ou un administrateur peut remettre le bon de consommation en cours';
			|en = 'Only a manager or an administrator can return the requisition to work';
			|es = 'Solo un responsable o un administrador puede devolver el vale a producción'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		Объект = Требование.ПолучитьОбъект();
		// Все блокировки требования - до распроведения выпуска: тот берёт историю статусов заказа, и после неё
		// ничего нового захватываться не должно (урок E8).
		Блокировка = Новый БлокировкаДанных;
		ЗаполнитьБлокировкуПроведения(Объект, Блокировка);
		Блокировка.Заблокировать();
		ТекстЗапрета = ТекстЗапретаВозвратаВРаботу(Объект);
		Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
			ВызватьИсключение ТекстЗапрета;
		КонецЕсли;
		Выпуск = ВыпускПоТребованию(Требование).ПолучитьОбъект();
		Выпуск.ДополнительныеСвойства.Вставить(ИмяСвойстваЗаписиТребования(), Требование);
		Выпуск.ПометкаУдаления = Истина;
		Выпуск.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Объект.Статус = Перечисления.СтатусыТребованийНакладных.Запущено;
		Объект.ФактОкончание = Дата(1, 1, 1);
		Объект.КоличествоФакт = 0;
		Объект.ДополнительныеСвойства.Вставить(ИмяСвойстваВозвратаВРаботу(), Истина);
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Доступна ли текущему пользователю команда «Вернуть в работу».
//
// Возвращаемое значение:
//  Булево - Истина у руководителя и администратора
//
Функция МожноВозвращатьВРаботу() Экспорт

	Возврат РольДоступна("Руководитель") Или РольДоступна("Администратор");

КонецФункции

#КонецОбласти

#Область ЗапретыИПроверки

// Почему требование нельзя записать в этом режиме: переходы статуса, завершённое и отменённое требование,
// неизменность перемещённого. Запись механизмом «Вернуть в работу» проверяется только по статусу в базе.
//
// Параметры:
//  Объект      - ДокументОбъект.ТребованиеНакладная - записываемое требование
//  РежимЗаписи - РежимЗаписиДокумента - режим записи
//  ВБазе       - Структура, Неопределено - см. ДанныеТребованияВБазе; Неопределено - новое требование
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - записать можно
//
Функция ТекстЗапретаЗаписи(Объект, РежимЗаписи, ВБазе) Экспорт

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Если ВБазе = Неопределено Тогда
		Возврат ТекстЗапретаНовому(Объект.Статус, РежимЗаписи);
	КонецЕсли;
	Если ВБазе.Статус = Статусы.Завершено Или ВБазе.Статус = Статусы.Отменено Тогда
		Возврат ТекстЗапретаЗакрытому(Объект, РежимЗаписи, ВБазе.Статус);
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Или Объект.ПометкаУдаления Тогда
		Возврат ТекстЗапретаОтменыПроведения(ВБазе);
	КонецЕсли;
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат ТекстЗапретаЗаписиБезПроведения(Объект, ВБазе);
	КонецЕсли;
	Если Не ПереходДопустим(ВБазе.Статус, Объект.Статус) Тогда
		Возврат ТекстПерехода(ВБазе.Статус, Объект.Статус);
	КонецЕсли;
	Если ВБазе.ЕстьПеремещение И ПеремещенноеИзменено(Объект, ВБазе) Тогда
		Возврат НСтр("ru = 'Материалы уже перемещены на склад станка: склад, дата, станок и строки материалов не меняются.
			|Догрузка - новым требованием-накладной';
			|fr = 'Les matières sont déjà transférées vers la machine : entrepôt, date, machine et lignes ne changent plus.
			|Complément - par un nouveau bon';
			|en = 'The materials are already moved to the machine stock: warehouse, date, machine and material lines cannot change.
			|Add more with a new requisition';
			|es = 'Los materiales ya están en el almacén de la máquina: almacén, fecha, máquina y líneas no cambian.
			|Para cargar más, use un vale nuevo'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Почему нельзя выпустить продукцию заказа без требования-накладной: по заказу и продукции есть открытое
// (запланированное или запущенное) требование. Для автовыпуска, ручного выпуска с основанием-заказом и передачи в
// переработку; вызывать под блокировкой потребностей заказа.
//
// Параметры:
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  Продукция - ТаблицаЗначений, ТабличнаяЧасть - строки с колонками Номенклатура и Характеристика
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - выпускать можно
//
Функция ТекстЗапретаВыпускаБезТребования(Заказ, Продукция) Экспорт

	Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказПокупателя") Или Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат "";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ключи.Номенклатура КАК Номенклатура,
	|	Ключи.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТКлючи
	|ИЗ
	|	&Ключи КАК Ключи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Требования.Ссылка КАК Ссылка,
	|	Требования.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Заказ = &Заказ
	|	И Требования.Проведен
	|	И Требования.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запланировано),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено))
	|	И (Требования.Номенклатура, Требования.Характеристика) В
	|		(ВЫБРАТЬ
	|			ВТКлючи.Номенклатура КАК Номенклатура,
	|			ВТКлючи.Характеристика КАК Характеристика
	|		ИЗ
	|			ВТКлючи КАК ВТКлючи)";
	Запрос.УстановитьПараметр("Ключи", ТипизированныеКлючиПродукции(Продукция));
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'Продукция «%1» заказа на станке: завершите или отмените требование-накладную %2';
		|fr = 'Le produit « %1 » de la commande est sur la machine : terminez ou annulez le bon de consommation %2';
		|en = 'Product ""%1"" of the order is on a machine: complete or cancel requisition %2';
		|es = 'El producto «%1» del pedido está en una máquina: termine o cancele el vale %2'");
	Возврат СтрШаблон(Шаблон, Выборка.Номенклатура, Выборка.Ссылка);

КонецФункции

// Превышение лимита производства заказа (N2): количество требования вместе с другими открытыми требованиями по заказу
// и продукции больше, чем осталось выпустить по заказу. Вызывать под блокировкой потребностей заказа.
//
// Параметры:
//  Объект     - ДокументОбъект.ТребованиеНакладная - требование
//  Количество - Число - проверяемое количество продукции (план или выпущено при «Завершить»)
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - в пределах заказа
//
Функция ТекстПревышенияЗаказа(Объект, Количество) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Осталось = 0;
	Для Каждого Выполнение Из ПроизводственныеЗаказы.ВыполнениеПоПродукции(Объект.Заказ) Цикл
		Если Выполнение.Номенклатура = Объект.Номенклатура И Выполнение.Характеристика = Объект.Характеристика Тогда
			Осталось = Осталось + Выполнение.КВыпуску - Выполнение.Выпущено;
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Требования.Количество), 0) КАК Количество
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Заказ = &Заказ
	|	И Требования.Проведен
	|	И Требования.Ссылка <> &Ссылка
	|	И Требования.Номенклатура = &Номенклатура
	|	И Требования.Характеристика = &Характеристика
	|	И Требования.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запланировано),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено))";
	Запрос.УстановитьПараметр("Заказ", Объект.Заказ);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Номенклатура", Объект.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Объект.Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Доступно = Осталось - Выборка.Количество;
	Если Количество <= Доступно Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'По заказу %1 осталось произвести «%2» %3 с учётом других требований-накладных, а в требовании %4';
		|fr = 'Il reste à produire %3 de « %2 » pour la commande %1 compte tenu des autres bons, le bon en contient %4';
		|en = 'Order %1 has %3 of ""%2"" left to produce including other requisitions, the requisition has %4';
		|es = 'Al pedido %1 le quedan %3 de «%2» por producir contando otros vales, el vale tiene %4'");
	Возврат СтрШаблон(Шаблон, Объект.Заказ, Объект.Номенклатура, Макс(Доступно, 0), Количество);

КонецФункции

// Продукция требования передана в переработку по тому же заказу: требование на неё не вводится (P1-1).
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - продукция в переработку не передавалась
//
Функция ТекстПродукцииВПереработке(Объект) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Продукция.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПередачаВПереработку.ТЧГотоваяПродукция КАК Продукция
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаВПереработку КАК Передачи
	|		ПО Продукция.Ссылка = Передачи.Ссылка
	|ГДЕ
	|	Передачи.Основание = &Заказ
	|	И Передачи.Проведен
	|	И Продукция.Номенклатура = &Номенклатура
	|	И Продукция.Характеристика = &Характеристика";
	Запрос.УстановитьПараметр("Заказ", Объект.Заказ);
	Запрос.УстановитьПараметр("Номенклатура", Объект.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Объект.Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'Продукция «%1» заказа передана в переработку (%2): требование-накладная на неё не вводится';
		|fr = 'Le produit « %1 » de la commande est confié à un sous-traitant (%2) : pas de bon de consommation';
		|en = 'Product ""%1"" of the order is sent for subcontracting (%2): no requisition can be entered for it';
		|es = 'El producto «%1» del pedido está en subcontratación (%2): no se introduce un vale para él'");
	Возврат СтрШаблон(Шаблон, Объект.Номенклатура, Выборка.Ссылка);

КонецФункции

// Один запуск на станок (решение владельца 2026-10-08): требование не запускается, пока на станке есть другое
// запущенное. Вызывать под блокировкой загрузки станка.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - запускаемое требование
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - станок свободен
//
Функция ТекстЗапретаВторогоЗапуска(Объект) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Требования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Станок = &Станок
	|	И Требования.Проведен
	|	И Требования.Ссылка <> &Ссылка
	|	И Требования.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено)";
	Запрос.УстановитьПараметр("Станок", Объект.Станок);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'На станке «%1» уже запущено требование-накладная %2: сначала завершите или отмените его';
		|fr = 'Le bon %2 est déjà lancé sur la machine « %1 » : terminez-le ou annulez-le d''abord';
		|en = 'Requisition %2 is already started on machine ""%1"": complete or cancel it first';
		|es = 'El vale %2 ya está iniciado en la máquina «%1»: primero termínelo o cancélelo'");
	Возврат СтрШаблон(Шаблон, Объект.Станок, Выборка.Ссылка);

КонецФункции

// Почему завершённое требование нельзя вернуть в работу.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - вернуть можно
//
Функция ТекстЗапретаВозвратаВРаботу(Объект) Экспорт

	Если Объект.Статус <> Перечисления.СтатусыТребованийНакладных.Завершено Тогда
		Возврат НСтр("ru = 'Вернуть в работу можно только завершённую требование-накладную';
			|fr = 'Seul un bon de consommation terminé peut être remis en cours';
			|en = 'Only a completed requisition can be returned to work';
			|es = 'Solo un vale terminado se puede devolver a producción'");
	КонецЕсли;
	Выпуск = ВыпускПоТребованию(Объект.Ссылка);
	Если ЗначениеЗаполнено(Выпуск) Тогда
		Склад = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выпуск, "МестоХраненияОприходование");
		Если Не ПриходыНетронуты(Выпуск, Склад) Тогда
			Шаблон = НСтр("ru = 'Продукцию выпуска %1 уже отгрузили или списали: вернуть требование в работу нельзя';
				|fr = 'Les produits de la production %1 sont déjà expédiés ou sortis : le bon ne peut pas être remis en cours';
				|en = 'The products of output %1 are already shipped or written off: the requisition cannot be returned to work';
				|es = 'Los productos de la producción %1 ya se enviaron o dieron de baja: el vale no puede volver a producción'");
			Возврат СтрШаблон(Шаблон, Выпуск);
		КонецЕсли;
	КонецЕсли;
	Текст = ТекстЗапретаВторогоЗапуска(Объект);
	Если ПустаяСтрока(Текст) Тогда
		Текст = ТекстРаботыПослеТребования(Объект);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Запрет ручной правки выпуска по требованию-накладной (N3): запись, проведение, отмена проведения, пометка и удаление -
// только механизмом требования.
//
// Параметры:
//  Выпуск - ДокументОбъект.ВыпускПродукции - выпуск
//  Отказ  - Булево - устанавливается при запрете
//
Процедура ПроверитьПравкуВыпускаПоТребованию(Выпуск, Отказ) Экспорт

	Требование = Выпуск.Требование;
	Если Не ЗначениеЗаполнено(Требование) И Не Выпуск.ЭтоНовый() Тогда
		УстановитьПривилегированныйРежим(Истина);
		Требование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выпуск.Ссылка, "Требование");
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	Если ЗначениеЗаполнено(Требование) И Не ЭтоЗаписьТребования(Выпуск, Требование) Тогда
		Шаблон = НСтр("ru = 'Выпуск создан требованием-накладной %1 и меняется только через неё';
			|fr = 'La production est créée par le bon de consommation %1 et ne change que par lui';
			|en = 'The output is created by requisition %1 and is changed only through it';
			|es = 'La producción la creó el vale %1 y solo se modifica a través de él'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Требование), , , , Отказ);
	КонецЕсли;

КонецПроцедуры

// Выпуск записывается механизмом требования-накладной: то же требование в реквизите и в ДополнительныеСвойства.
//
// Параметры:
//  Выпуск     - ДокументОбъект.ВыпускПродукции - выпуск
//  Требование - ДокументСсылка.ТребованиеНакладная, Неопределено - требование; Неопределено - из реквизита выпуска
//
// Возвращаемое значение:
//  Булево - Истина при записи механизмом
//
Функция ЭтоЗаписьТребования(Выпуск, Требование = Неопределено) Экспорт

	Записывающее = Неопределено;
	Если Требование = Неопределено Тогда
		Требование = Выпуск.Требование;
	КонецЕсли;
	Возврат Выпуск.ДополнительныеСвойства.Свойство(ИмяСвойстваЗаписиТребования(), Записывающее)
		И ЗначениеЗаполнено(Требование) И Записывающее = Требование;

КонецФункции

#КонецОбласти

#Область ОстаткиСтанка

// Запоминает прежние записи «Товаров в наличии» регистратора на складах станков - для сверки инварианта в
// ПриЗаписи. Модуль набора записей; набор требования пропускается - его сверяет само требование.
//
// Параметры:
//  Набор - РегистрНакопленияНаборЗаписей.ТоварыВНаличии - записываемый набор
//
Процедура ПередЗаписьюТоваровВНаличии(Набор) Экспорт

	Регистратор = Набор.Отбор.Регистратор.Значение;
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ТребованиеНакладная") Или Не УчетСтанковВключен() Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Склады = СкладыСтанков();
	Набор.ДополнительныеСвойства.Вставить(ИмяСвойстваСкладовСтанков(), Склады);
	Если Склады.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Записи.МестоХранения КАК МестоХранения,
	|	Записи.Номенклатура КАК Номенклатура,
	|	Записи.Характеристика КАК Характеристика,
	|	СУММА(ВЫБОР
	|			КОГДА Записи.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Записи.Количество
	|			ИНАЧЕ -Записи.Количество
	|		КОНЕЦ) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Регистратор = &Регистратор
	|	И Записи.МестоХранения В (&Склады)
	|
	|СГРУППИРОВАТЬ ПО
	|	Записи.МестоХранения,
	|	Записи.Номенклатура,
	|	Записи.Характеристика";
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Склады", Склады);
	Прежние = Запрос.Выполнить().Выгрузить();
	Набор.ДополнительныеСвойства.Вставить(ИмяСвойстваПрежнихЗаписей(), Прежние);
	// Блокировка остатков складов станков набора - до записи: после записи СУБД уже держит строку итогов, и поздний
	// управляемый захват дал бы взаимоблокировку с проведением требования (ревью данных сборки 2, P2-1).
	Ключи = НоваяТаблица(КолонкиКлючаСклада());
	Для Каждого Запись Из Набор Цикл
		Если Склады.Найти(Запись.МестоХранения) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Ключи.Добавить(), Запись);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Прежняя Из Прежние Цикл
		ЗаполнитьЗначенияСвойств(Ключи.Добавить(), Прежняя);
	КонецЦикла;
	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Эл = Блокировка.Добавить("РегистрНакопления.ТоварыВНаличии");
	Эл.Режим = РежимБлокировкиДанных.Исключительный;
	Эл.ИсточникДанных = Ключи;
	Для Каждого Поле Из СтрРазделить(ПоляБлокировкиОстатков(), ",") Цикл
		Эл.ИспользоватьИзИсточникаДанных(Поле, Поле);
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

// Инвариант склада станка после записи набора «Товаров в наличии» любого регистратора, кроме требования: по ключам
// «склад станка, номенклатура, характеристика», где набор уменьшил остаток против прежних записей, текущий остаток
// склада станка не меньше закреплённого за требованиями. Ловит реализацию, списание, перемещение и его отмену
// проведения, пересортицу, передачу в переработку, выпуск и ручную корректировку регистров.
//
// Параметры:
//  Набор     - РегистрНакопленияНаборЗаписей.ТоварыВНаличии - записанный набор
//  Отказ     - Булево - устанавливается при нарушении
//  Замещение - Булево - набор заменил прежние записи регистратора; Ложь - добавил к ним, прежние не вычитаются
//
Процедура ПриЗаписиТоваровВНаличии(Набор, Отказ, Замещение) Экспорт

	Склады = Неопределено;
	Если Не Набор.ДополнительныеСвойства.Свойство(ИмяСвойстваСкладовСтанков(), Склады) Или Склады.Количество() = 0 Тогда
		// Набор требования, учёт станков выключен или складов станков нет - см. ПередЗаписьюТоваровВНаличии.
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	// Остатки складов станков набора уже под блокировкой, взятой до записи.
	Ключи = КлючиУменьшенияОстатка(Набор, Склады, Замещение);
	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ТекстНарушения = ТекстНарушенияЗакрепления(Ключи);
	Если ЗначениеЗаполнено(ТекстНарушения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстНарушения, , , , Отказ);
	КонецЕсли;

КонецПроцедуры

// Свободный остаток станка по материалам: текущий остаток склада станка минус закреплённое за другими требованиями.
//
// Параметры:
//  Станок     - СправочникСсылка.ПроизводственноеОборудование - станок
//  Материалы  - ТаблицаЗначений, ТабличнаяЧасть - строки с колонками Номенклатура и Характеристика
//  Исключить  - ДокументСсылка.ТребованиеНакладная, Неопределено - требование, чьё закрепление не вычитается
//
// Возвращаемое значение:
//  Соответствие - ключ: строка «номенклатура|характеристика» (см. КлючПозиции); значение: Число, не меньше нуля
//
Функция СвободныйОстатокСтанка(Станок, Материалы, Исключить = Неопределено) Экспорт

	Свободно = Новый Соответствие;
	Склад = СкладСтанка(Станок);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Свободно;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ключи.Номенклатура КАК Номенклатура,
	|	Ключи.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТКлючи
	|ИЗ
	|	&Ключи КАК Ключи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	СУММА(Остатки.Количество) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		Склад.Номенклатура КАК Номенклатура,
	|		Склад.Характеристика КАК Характеристика,
	|		Склад.КоличествоОстаток КАК Количество
	|	ИЗ
	|		РегистрНакопления.ТоварыВНаличии.Остатки(
	|				,
	|				МестоХранения = &Склад
	|					И (Номенклатура, Характеристика) В
	|						(ВЫБРАТЬ
	|							ВТКлючи.Номенклатура КАК Номенклатура,
	|							ВТКлючи.Характеристика КАК Характеристика
	|						ИЗ
	|							ВТКлючи КАК ВТКлючи)) КАК Склад
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Закреплено.Номенклатура,
	|		Закреплено.Характеристика,
	|		-Закреплено.КоличествоОстаток
	|	ИЗ
	|		РегистрНакопления.МатериалыНаСтанках.Остатки(
	|				,
	|				Станок = &Станок
	|					И Требование <> &Исключить
	|					И (Номенклатура, Характеристика) В
	|						(ВЫБРАТЬ
	|							ВТКлючи.Номенклатура КАК Номенклатура,
	|							ВТКлючи.Характеристика КАК Характеристика
	|						ИЗ
	|							ВТКлючи КАК ВТКлючи)) КАК Закреплено) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика";
	Запрос.УстановитьПараметр("Ключи", ТипизированныеКлючиПродукции(Материалы));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Станок", Станок);
	Запрос.УстановитьПараметр("Исключить", Исключить);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Свободно.Вставить(КлючПозиции(Выборка.Номенклатура, Выборка.Характеристика), Макс(Выборка.Количество, 0));
	КонецЦикла;
	Возврат Свободно;

КонецФункции

// Раскладывает количества по партиям остатка склада одной очередью по дате партии во всех сериях - тот же FIFO, что
// у списания (`ТоварыВНаличии.СписатьНоменклатуру`): строки получают серию и партию, и списание берёт ровно их.
// Нехватка - строкой без партии: списание откажет обычным текстом недостачи. Вызывать под складской блокировкой.
//
// Параметры:
//  Строки  - ТаблицаЗначений - Номенклатура, Характеристика, Количество
//  Склад   - СправочникСсылка.МестаХранения - склад
//  Граница - Граница - момент остатков (обычно момент документа, исключая)
//
// Возвращаемое значение:
//  ТаблицаЗначений - МестоХранения, Номенклатура, Характеристика, Серия, Партия, Количество
//
Функция РазложитьПоПартиям(Строки, Склад, Граница) Экспорт

	Результат = НоваяТаблица(КолонкиКлючаСклада() + ", Серия, Партия, Количество");
	Если Строки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ключи.Номенклатура КАК Номенклатура,
	|	Ключи.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТКлючи
	|ИЗ
	|	&Ключи КАК Ключи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	Остатки.Партия КАК Партия,
	|	Остатки.ДатаПартии КАК ДатаПартии,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			&Граница,
	|			МестоХранения = &Склад
	|				И (Номенклатура, Характеристика) В
	|					(ВЫБРАТЬ
	|						ВТКлючи.Номенклатура КАК Номенклатура,
	|						ВТКлючи.Характеристика КАК Характеристика
	|					ИЗ
	|						ВТКлючи КАК ВТКлючи)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПартии,
	|	Серия,
	|	Партия";
	Запрос.УстановитьПараметр("Ключи", ТипизированныеКлючиПродукции(Строки));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Граница", Граница);
	Партии = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Строки Цикл
		Нужно = Строка.Количество;
		Отбор = Новый Структура(КолонкиПозиции(), Строка.Номенклатура, Строка.Характеристика);
		Для Каждого Партия Из Партии.НайтиСтроки(Отбор) Цикл
			Если Нужно <= 0 Тогда
				Прервать;
			КонецЕсли;
			Взять = Мин(Нужно, Партия.Количество);
			Если Взять <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Новая = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(Новая, Партия, "Номенклатура, Характеристика, Серия, Партия");
			Новая.МестоХранения = Склад;
			Новая.Количество = Взять;
			Партия.Количество = Партия.Количество - Взять;
			Нужно = Нужно - Взять;
		КонецЦикла;
		Если Нужно > 0 Тогда
			Новая = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(Новая, Строка, КолонкиПозиции());
			Новая.МестоХранения = Склад;
			Новая.Количество = Нужно;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Можно ли при отмене удалить перемещение требования (вернуть материалы на склад-источник на дату документа): каждая
// перемещённая партия на складе станка с момента документа ни в один момент не опускалась ниже перемещённого -
// значит, её не взяла по FIFO соседняя загрузка (ревью плана Codex, P0).
//
// Параметры:
//  Требование - ДокументСсылка.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Булево - Истина, если перемещение можно удалить
//
Функция ПеремещениеМожноУдалить(Требование) Экспорт

	Если Не ЗначениеЗаполнено(Требование) Тогда
		Возврат Истина;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Станок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Требование, "Станок");
	Возврат ПриходыНетронуты(Требование, СкладСтанка(Станок));

КонецФункции

// Выпуск продукции по требованию-накладной (не помеченный на удаление).
//
// Параметры:
//  Требование - ДокументСсылка.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  ДокументСсылка.ВыпускПродукции - выпуск; пустая ссылка - выпуска нет
//
Функция ВыпускПоТребованию(Требование) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Выпуски.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|ГДЕ
	|	Выпуски.Требование = &Требование
	|	И НЕ Выпуски.ПометкаУдаления
	|	И &Требование <> ЗНАЧЕНИЕ(Документ.ТребованиеНакладная.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Требование", Требование);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Документы.ВыпускПродукции.ПустаяСсылка());

КонецФункции

// Строки продукции заказа на производство, по которым есть материалы, - для выбора строки в требовании.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ
//
// Возвращаемое значение:
//  СписокЗначений - значение: КодСтроки; представление: «N. продукция, количество»
//
Функция СтрокиПродукцииЗаказа(Заказ) Экспорт

	Список = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Список;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|	И Товары.КодСтроки В
	|			(ВЫБРАТЬ
	|				Материалы.КодСтрокиПродукции КАК КодСтрокиПродукции
	|			ИЗ
	|				Документ.ЗаказПокупателя.ТЧМатериалы КАК Материалы
	|			ГДЕ
	|				Материалы.Ссылка = &Заказ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Представление = СтрШаблон("%1. %2, %3", Выборка.НомерСтроки,
			ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика),
			Выборка.Количество);
		Список.Добавить(Выборка.КодСтроки, Представление);
	КонецЦикла;
	Возврат Список;

КонецФункции

// Склад станка из карточки.
//
// Параметры:
//  Станок - СправочникСсылка.ПроизводственноеОборудование - станок
//
// Возвращаемое значение:
//  СправочникСсылка.МестаХранения - склад станка; пустая ссылка - не задан
//
Функция СкладСтанка(Станок) Экспорт

	Если Не ЗначениеЗаполнено(Станок) Тогда
		Возврат Справочники.МестаХранения.ПустаяСсылка();
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Склад = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Станок, "СкладСтанка");
	Возврат ?(ЗначениеЗаполнено(Склад), Склад, Справочники.МестаХранения.ПустаяСсылка());

КонецФункции

// Почему нельзя записать станок: склад станка занят другим станком, на складе включено оповещение о минимальном
// остатке (пополнение посчитало бы материалы на станке свободным запасом) или склад меняется при открытых
// требованиях и закреплённых материалах.
//
// Параметры:
//  Станок - СправочникОбъект.ПроизводственноеОборудование - записываемый станок
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - записать можно
//
Функция ТекстЗапретаСкладаСтанка(Станок) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Если Не Станок.ЭтоНовый() Тогда
		Прежний = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Станок.Ссылка, "СкладСтанка");
		Если ЗначениеЗаполнено(Прежний) И Прежний <> Станок.СкладСтанка Тогда
			ТекстОткрытых = ТекстОткрытыхТребованийСтанка(Станок.Ссылка);
			Если ЗначениеЗаполнено(ТекстОткрытых) Тогда
				Возврат ТекстОткрытых;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Станок.СкладСтанка) Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Станки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПроизводственноеОборудование КАК Станки
	|ГДЕ
	|	Станки.СкладСтанка = &Склад
	|	И Станки.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Склад", Станок.СкладСтанка);
	Запрос.УстановитьПараметр("Ссылка", Станок.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Шаблон = НСтр("ru = 'Склад «%1» уже назначен станку «%2»: у каждого станка свой склад';
			|fr = 'L''entrepôt « %1 » est déjà affecté à la machine « %2 » : chaque machine a son propre entrepôt';
			|en = 'Warehouse ""%1"" is already assigned to machine ""%2"": each machine has its own warehouse';
			|es = 'El almacén «%1» ya está asignado a la máquina «%2»: cada máquina tiene su propio almacén'");
		Возврат СтрШаблон(Шаблон, Станок.СкладСтанка, Выборка.Ссылка);
	КонецЕсли;
	Если СкладПодчиненный(Станок.СкладСтанка) Тогда
		Шаблон = НСтр("ru = 'Склад «%1» указан подчинённым складом другого склада:
			|поступления дублируют на него движения, складом станка он быть не может';
			|fr = 'L''entrepôt « %1 » est l''entrepôt subordonné d''un autre :
			|les réceptions y dupliquent leurs mouvements, il ne peut pas être celui d''une machine';
			|en = 'Warehouse ""%1"" is a subordinate warehouse of another one:
			|receipts duplicate movements there, it cannot be a machine warehouse';
			|es = 'El almacén «%1» es subordinado de otro:
			|las entradas duplican allí sus movimientos, no puede ser almacén de máquina'");
		Возврат СтрШаблон(Шаблон, Станок.СкладСтанка);
	КонецЕсли;
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Станок.СкладСтанка, "ОповещатьОМинимальномОстатке") = Истина Тогда
		Шаблон = НСтр("ru = 'У склада станка «%1» включено оповещение о минимальном остатке:
			|пополнение считало бы материалы на станке свободным запасом. Выключите его в карточке склада';
			|fr = 'L''alerte de stock minimum est active pour l''entrepôt de la machine « %1 » :
			|le réapprovisionnement compterait les matières de la machine comme stock libre. Désactivez-la dans la fiche';
			|en = 'Minimum stock notification is on for machine warehouse ""%1"":
			|replenishment would count machine materials as free stock. Turn it off in the warehouse card';
			|es = 'El aviso de stock mínimo está activo en el almacén de la máquina «%1»:
			|la reposición contaría los materiales de la máquina como stock libre. Desactívelo en la ficha'");
		Возврат СтрШаблон(Шаблон, Станок.СкладСтанка);
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возврат в работу продлил бы факт требования до завершения поверх фактической работы, начатой на станке после него:
// работа учлась бы дважды, а повторное «Завершить» отказало бы по пересечению (ревью плана сборки 4, P1-1).
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - возвращаемое требование
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - после требования на станке фактической работы не было
//
Функция ТекстРаботыПослеТребования(Объект)

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Загрузка.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|ГДЕ
	|	Загрузка.Станок = &Станок
	|	И НЕ Загрузка.План
	|	И Загрузка.ВидЗаписи = ЗНАЧЕНИЕ(Перечисление.ВидыЗагрузкиСтанков.Работа)
	|	И Загрузка.Регистратор <> &Ссылка
	|	И Загрузка.Начало >= &ФактНачало";
	Запрос.УстановитьПараметр("Станок", Объект.Станок);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("ФактНачало", Объект.ФактНачало);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'После этого требования на станке «%1» уже работало требование %2: вернуть в работу нельзя';
		|fr = 'Le bon %2 a déjà fonctionné sur la machine « %1 » après celui-ci : remise en cours impossible';
		|en = 'Requisition %2 has already run on machine ""%1"" after this one: it cannot be returned to work';
		|es = 'El vale %2 ya trabajó en la máquina «%1» después de este: no se puede devolver a producción'");
	Возврат СтрШаблон(Шаблон, Объект.Станок, Выборка.Регистратор);

КонецФункции

// Приходы регистратора на складе ни в один момент после него не тронуты: остаток каждой партии прихода с момента
// регистратора (включая его) не опускался ниже пришедшего. Строка оборотов самого регистратора не сверяется: её
// начальный остаток - до его прихода. Удаление таких приходов не уводит партии в минус ни в
// одном прошлом моменте - ни сейчас, ни между продажей и возвратом.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ, чьи приходы проверяются
//  Склад       - СправочникСсылка.МестаХранения - склад приходов
//
// Возвращаемое значение:
//  Булево - Истина, если приходы не тронуты
//
Функция ПриходыНетронуты(Регистратор, Склад)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Записи.Номенклатура КАК Номенклатура,
	|	Записи.Характеристика КАК Характеристика,
	|	Записи.Серия КАК Серия,
	|	Записи.Партия КАК Партия,
	|	СУММА(Записи.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТПришло
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Регистратор = &Регистратор
	|	И Записи.МестоХранения = &Склад
	|	И Записи.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|
	|СГРУППИРОВАТЬ ПО
	|	Записи.Номенклатура,
	|	Записи.Характеристика,
	|	Записи.Серия,
	|	Записи.Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	Остатки.Партия КАК Партия,
	|	ВЫБОР
	|		КОГДА Остатки.КоличествоНачальныйОстаток < Остатки.КоличествоКонечныйОстаток
	|			ТОГДА Остатки.КоличествоНачальныйОстаток
	|		ИНАЧЕ Остатки.КоличествоКонечныйОстаток
	|	КОНЕЦ КАК Минимум
	|ПОМЕСТИТЬ ВТДвижения
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.ОстаткиИОбороты(
	|			&ГраницаВключая,
	|			,
	|			Регистратор,
	|			,
	|			МестоХранения = &Склад
	|				И (Номенклатура, Характеристика, Серия, Партия) В
	|					(ВЫБРАТЬ
	|						ВТПришло.Номенклатура КАК Номенклатура,
	|						ВТПришло.Характеристика КАК Характеристика,
	|						ВТПришло.Серия КАК Серия,
	|						ВТПришло.Партия КАК Партия
	|					ИЗ
	|						ВТПришло КАК ВТПришло)) КАК Остатки
	|ГДЕ
	|	Остатки.Регистратор <> &Регистратор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика,
	|	Остатки.Серия,
	|	Остатки.Партия,
	|	Остатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			&ГраницаВключая,
	|			МестоХранения = &Склад
	|				И (Номенклатура, Характеристика, Серия, Партия) В
	|					(ВЫБРАТЬ
	|						ВТПришло.Номенклатура КАК Номенклатура,
	|						ВТПришло.Характеристика КАК Характеристика,
	|						ВТПришло.Серия КАК Серия,
	|						ВТПришло.Партия КАК Партия
	|					ИЗ
	|						ВТПришло КАК ВТПришло)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТПришло.Партия КАК Партия
	|ИЗ
	|	ВТПришло КАК ВТПришло
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДвижения КАК ВТДвижения
	|		ПО ВТПришло.Номенклатура = ВТДвижения.Номенклатура
	|			И ВТПришло.Характеристика = ВТДвижения.Характеристика
	|			И ВТПришло.Серия = ВТДвижения.Серия
	|			И ВТПришло.Партия = ВТДвижения.Партия
	|ГДЕ
	|	ЕСТЬNULL(ВТДвижения.Минимум, -1) < ВТПришло.Количество";
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ГраницаВключая", Новый Граница(Регистратор.МоментВремени(), ВидГраницы.Включая));
	Возврат Запрос.Выполнить().Пустой();

КонецФункции

// Расчётные поля проводимого требования: израсходовано по умолчанию, флажок решения 1 и закрепление свободного
// остатка (пока перемещения не было), признак оставленных материалов при отмене, вес, длительность и план окончания.
//
// Параметры:
//  Объект     - ДокументОбъект.ТребованиеНакладная - требование
//  Перемещено - Булево - материалы уже перемещены на склад станка
//
Процедура ЗаполнитьРасчетныеПоля(Объект, Перемещено)

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Для Каждого Строка Из Объект.Материалы Цикл
		Если Строка.КодСтроки = 0 Тогда
			Строка.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Объект.Материалы);
		КонецЕсли;
		Если Объект.Статус <> Статусы.Завершено Тогда
			Строка.Израсходовано = Строка.Количество;
		КонецЕсли;
	КонецЦикла;
	Если Не Перемещено Тогда
		Если Объект.Статус = Статусы.Запланировано Тогда
			Объект.СписыватьПриРазмещении = Константы.СписыватьМатериалыНаСтанокПриРазмещении.Получить();
		КонецЕсли;
		РассчитатьСоСкладаСтанка(Объект);
	КонецЕсли;
	Если Объект.Статус = Статусы.Отменено Тогда
		Объект.МатериалыОставлены = Перемещено И Не ПеремещениеМожноУдалить(Объект.Ссылка);
	КонецЕсли;
	Вес = ЗагрузкаСтанков.ВесНоменклатурыКг(Объект.Материалы);
	Объект.Вес = Вес.Вес;
	Объект.Длительность = ЗагрузкаСтанков.ДлительностьЗагрузки(Объект.Станок, Вес.Вес).Часы;
	Если ЗначениеЗаполнено(Объект.ПланНачало) И Объект.Длительность > 0 Тогда
		Окончание = ЗагрузкаСтанков.ОкончаниеПоРежиму(Объект.Станок, Объект.ПланНачало, Объект.Длительность);
		Если Окончание <> Неопределено Тогда
			Объект.ПланОкончание = Окончание;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// «Разместить»: статус «Запланировано». При списании на станок при размещении (решение 1) дата документа - момент
// перемещения: та, что в документе (по умолчанию - момент его ввода).
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
Процедура ПодготовитьРазмещение(Объект)

	Объект.Статус = Перечисления.СтатусыТребованийНакладных.Запланировано;

КонецПроцедуры

// «Запустить»: статус «Запущено», факт начала - сейчас, если не задан; без перемещения дата документа - факт начала.
//
// Параметры:
//  Объект     - ДокументОбъект.ТребованиеНакладная - требование
//  Перемещено - Булево - материалы уже перемещены
//
Процедура ПодготовитьЗапуск(Объект, Перемещено)

	Объект.Статус = Перечисления.СтатусыТребованийНакладных.Запущено;
	Если Не ЗначениеЗаполнено(Объект.ФактНачало) Тогда
		Объект.ФактНачало = ТекущаяДатаСеанса();
	КонецЕсли;
	Если Не Перемещено Тогда
		Объект.Дата = Объект.ФактНачало;
	КонецЕсли;

КонецПроцедуры

// «Завершить»: статус «Завершено», факт окончания - сейчас, если не задан; выпущено по умолчанию - количество.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
Процедура ПодготовитьЗавершение(Объект)

	Объект.Статус = Перечисления.СтатусыТребованийНакладных.Завершено;
	Если Не ЗначениеЗаполнено(Объект.ФактОкончание) Тогда
		Объект.ФактОкончание = ТекущаяДатаСеанса();
	КонецЕсли;
	Если Объект.КоличествоФакт = 0 Тогда
		Объект.КоличествоФакт = Объект.Количество;
	КонецЕсли;

КонецПроцедуры

// Новое требование проводится только запланированным или запущенным.
//
// Параметры:
//  Статус      - ПеречислениеСсылка.СтатусыТребованийНакладных - статус
//  РежимЗаписи - РежимЗаписиДокумента - режим записи
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - можно
//
Функция ТекстЗапретаНовому(Статус, РежимЗаписи)

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Статус <> Статусы.Запланировано И Статус <> Статусы.Запущено Тогда
		Возврат ТекстПерехода(Статусы.ПустаяСсылка(), Статус);
	КонецЕсли;
	Возврат "";

КонецФункции

// Завершённое требование меняет только «Вернуть в работу», отменённое - только запись без проведения (пометка).
//
// Параметры:
//  Объект        - ДокументОбъект.ТребованиеНакладная - требование
//  РежимЗаписи   - РежимЗаписиДокумента - режим записи
//  СтатусВБазе   - ПеречислениеСсылка.СтатусыТребованийНакладных - Завершено или Отменено
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - можно
//
Функция ТекстЗапретаЗакрытому(Объект, РежимЗаписи, СтатусВБазе)

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Если СтатусВБазе = Статусы.Завершено Тогда
		Если Объект.ДополнительныеСвойства.Свойство(ИмяСвойстваВозвратаВРаботу()) И Объект.Статус = Статусы.Запущено Тогда
			Возврат "";
		КонецЕсли;
		Возврат НСтр("ru = 'Требование-накладная завершена и по ней создан выпуск: менять её нельзя.
			|Исправить ошибочное завершение - командой «Вернуть в работу»';
			|fr = 'Le bon de consommation est terminé et sa production est créée : il ne peut pas être modifié.
			|Corrigez une fin erronée avec « Remettre en cours »';
			|en = 'The requisition is completed and its output is created: it cannot be changed.
			|Fix a wrong completion with ""Return to work""';
			|es = 'El vale está terminado y su producción creada: no se puede modificar.
			|Corrija un fin erróneo con «Devolver a producción»'");
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Запись И Объект.Статус = Статусы.Отменено Тогда
		Возврат "";
	КонецЕсли;
	Возврат НСтр("ru = 'Требование-накладная отменена: возобновить её нельзя, введите новое требование';
		|fr = 'Le bon de consommation est annulé : il ne peut pas être repris, saisissez un nouveau bon';
		|en = 'The requisition is cancelled: it cannot be resumed, enter a new requisition';
		|es = 'El vale está cancelado: no se puede reanudar, introduzca un vale nuevo'");

КонецФункции

// Распровести и пометить можно только запланированное требование без перемещения: у перемещённых материалов выход -
// «Отменить».
//
// Параметры:
//  ВБазе - Структура - см. ДанныеТребованияВБазе
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - можно
//
Функция ТекстЗапретаОтменыПроведения(ВБазе)

	Если ВБазе.ЕстьПеремещение Или ВБазе.Статус = Перечисления.СтатусыТребованийНакладных.Запущено Тогда
		Возврат НСтр("ru = 'Материалы требования-накладной уже на станке: распровести или пометить её нельзя, используйте «Отменить»';
			|fr = 'Les matières du bon sont déjà sur la machine : utilisez « Annuler » au lieu d''annuler la validation';
			|en = 'The requisition materials are already on the machine: use ""Cancel"" instead of unposting or marking it';
			|es = 'Los materiales del vale ya están en la máquina: use «Cancelar» en lugar de anular o marcar el vale'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Запись проведённого требования без проведения не меняет статус и перемещённое: движения при ней не пересобираются.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//  ВБазе  - Структура - см. ДанныеТребованияВБазе
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - можно
//
Функция ТекстЗапретаЗаписиБезПроведения(Объект, ВБазе)

	Если Не ВБазе.Проведен Тогда
		Возврат "";
	КонецЕсли;
	Если Объект.Статус <> ВБазе.Статус Тогда
		Возврат ТекстПерехода(ВБазе.Статус, Объект.Статус);
	КонецЕсли;
	Если ВБазе.ЕстьПеремещение И ПеремещенноеИзменено(Объект, ВБазе) Тогда
		Возврат НСтр("ru = 'Материалы уже перемещены на склад станка: склад, дата, станок и строки материалов не меняются';
			|fr = 'Les matières sont déjà transférées vers la machine : entrepôt, date, machine et lignes ne changent plus';
			|en = 'The materials are already moved to the machine stock: warehouse, date, machine and material lines cannot change';
			|es = 'Los materiales ya están en el almacén de la máquina: almacén, fecha, máquina y líneas no cambian'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Допустимые переходы статуса проведением: запланировано - в запланировано, запущено, отменено; запущено - в запущено,
// завершено, отменено.
//
// Параметры:
//  Было  - ПеречислениеСсылка.СтатусыТребованийНакладных - статус в базе
//  Стало - ПеречислениеСсылка.СтатусыТребованийНакладных - новый статус
//
// Возвращаемое значение:
//  Булево - Истина, если переход допустим
//
Функция ПереходДопустим(Было, Стало)

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Если Стало = Статусы.Отменено Или Стало = Статусы.Запущено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Было = Статусы.Запланировано Тогда
		Возврат Стало = Статусы.Запланировано;
	КонецЕсли;
	Возврат Стало = Статусы.Завершено;

КонецФункции

// Ключи «склад станка, номенклатура, характеристика», где записанный набор уменьшил остаток против прежних записей
// регистратора (при замещении; без замещения набор только добавляет записи).
//
// Параметры:
//  Набор     - РегистрНакопленияНаборЗаписей.ТоварыВНаличии - записанный набор
//  Склады    - Массив из СправочникСсылка.МестаХранения - склады станков
//  Замещение - Булево - набор заменил прежние записи регистратора
//
// Возвращаемое значение:
//  ТаблицаЗначений - МестоХранения, Номенклатура, Характеристика
//
Функция КлючиУменьшенияОстатка(Набор, Склады, Замещение)

	Изменения = НоваяТаблица(КолонкиКлючаСклада() + ", Количество");
	Для Каждого Запись Из Набор Цикл
		Если Склады.Найти(Запись.МестоХранения) <> Неопределено Тогда
			Строка = Изменения.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, Запись, КолонкиКлючаСклада());
			Строка.Количество = ?(Запись.ВидДвижения = ВидДвиженияНакопления.Приход, Запись.Количество, -Запись.Количество);
		КонецЕсли;
	КонецЦикла;
	Прежние = Неопределено;
	Если Замещение И Набор.ДополнительныеСвойства.Свойство(ИмяСвойстваПрежнихЗаписей(), Прежние) Тогда
		Для Каждого Прежняя Из Прежние Цикл
			Строка = Изменения.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, Прежняя);
			Строка.Количество = -Прежняя.Количество;
		КонецЦикла;
	КонецЕсли;
	Изменения.Свернуть(КолонкиКлючаСклада(), "Количество");
	Ключи = НоваяТаблица(КолонкиКлючаСклада());
	Для Каждого Изменение Из Изменения Цикл
		Если Изменение.Количество < 0 Тогда
			ЗаполнитьЗначенияСвойств(Ключи.Добавить(), Изменение);
		КонецЕсли;
	КонецЦикла;
	Возврат Ключи;

КонецФункции

// Таблица значений с типизированными колонками из набора, общего для ключей модуля.
//
// Параметры:
//  ИменаКолонок - Строка - имена через запятую из: МестоХранения, Номенклатура, Характеристика, Серия, Партия,
//                 Количество
//
// Возвращаемое значение:
//  ТаблицаЗначений - пустая таблица с колонками
//
Функция НоваяТаблица(ИменаКолонок)

	Типы = Новый Структура;
	Типы.Вставить("МестоХранения", Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
	Типы.Вставить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Типы.Вставить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Типы.Вставить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	Типы.Вставить("Партия", Метаданные.ОпределяемыеТипы.ПриходныйДокументПартии.Тип);
	Типы.Вставить("Количество", Новый ОписаниеТипов("Число"));
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить(ИменаКолонок, ", ", Ложь) Цикл
		Таблица.Колонки.Добавить(Имя, Типы[Имя]);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

