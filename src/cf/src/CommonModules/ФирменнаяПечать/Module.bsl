// Фирменные печатные формы: один общий макет ФирменныйДокумент и один алгоритм вывода для любого документа,
// у которого есть адаптер данных (docs/plans/branded-print.md). Модуль знает макет; документ знает свои данные.
//
// Адаптер - экспортная функция модуля менеджера документа:
//   ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) -> Соответствие ссылка -> Структура
//   (Данные - см. ПривестиДанные, Плашка - Строка, ИмяФайла - Строка).

#Область ПрограммныйИнтерфейс

// Имена видов фирменных форм.
//
// Возвращаемое значение:
//  Массив из Строка - имена видов, см. ОписаниеВида.
//
Функция ВидыФорм() Экспорт
	Виды = Новый Массив;
	Виды.Добавить(ВидКоммерческоеПредложение());
	Возврат Виды;
КонецФункции

// Описание вида фирменной формы на языке печати.
//
// Параметры:
//  ВидФормы - Строка - имя вида, см. ВидыФорм.
//  КодЯзыка - Строка - язык текстов; пусто - язык сеанса.
//
// Возвращаемое значение:
//  Структура - описание вида:
//   * Представление   - Строка - название печатной формы в списке команд и в окне печати.
//   * Заголовок       - Строка - заголовок документа на форме.
//   * ПодписьСтороны  - Строка - подпись блока второй стороны (клиент, поставщик).
//   * ПодписьКонтакта - Строка - подпись блока нашего контакта.
//   * Таблица         - Строка - вариант таблицы: пусто - все колонки, «БезСкидки», «БезЦен».
//
Функция ОписаниеВида(ВидФормы, КодЯзыка = "") Экспорт
	Если ВидФормы <> ВидКоммерческоеПредложение() Тогда
		ШаблонОшибки = НСтр("ru = 'Неизвестный вид фирменной печатной формы: %1';
			|fr = 'Type de formulaire imprimable à en-tête inconnu : %1';
			|en = 'Unknown branded print form type: %1';
			|es = 'Tipo de formulario de impresión corporativo desconocido: %1'");
		ВызватьИсключение СтрШаблон(ШаблонОшибки, ВидФормы);
	КонецЕсли;
	Описание = Новый Структура;
	Описание.Вставить("Представление", НСтр("ru = 'Коммерческое предложение'; fr = 'Devis'; en = 'Quotation';
		|es = 'Presupuesto'", КодЯзыка));
	Описание.Вставить("Заголовок", НСтр("ru = 'КОММЕРЧЕСКОЕ ПРЕДЛОЖЕНИЕ'; fr = 'DEVIS'; en = 'QUOTATION';
		|es = 'PRESUPUESTO'", КодЯзыка));
	Описание.Вставить("ПодписьСтороны", НСтр("ru = 'КЛИЕНТ'; fr = 'CLIENT'; en = 'CUSTOMER'; es = 'CLIENTE'", КодЯзыка));
	Описание.Вставить("ПодписьКонтакта", НСтр("ru = 'ВАШ МЕНЕДЖЕР'; fr = 'VOTRE CONTACT'; en = 'YOUR CONTACT';
		|es = 'SU CONTACTO'", КодЯзыка));
	Описание.Вставить("Таблица", "");
	Возврат Описание;
КонецФункции

// Добавляет команду фирменной печатной формы в коллекцию команд печати документа.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - см. ПечатныеФормы.НоваяКоллекцияКомандПечати.
//  ИмяМакета     - Строка - идентификатор команды (имя, под которым форму знает окно печати и настройки принтера).
//  ВидФормы      - Строка - вид фирменной формы, см. ВидыФорм.
//
Процедура ДобавитьКоманду(КомандыПечати, ИмяМакета, ВидФормы) Экспорт
	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = ИмяМакета;
	Команда.Представление = ОписаниеВида(ВидФормы).Представление;
КонецПроцедуры

// Формирует фирменную печатную форму для документов любого типа, у которого есть адаптер данных
// (ДанныеФирменнойПечати в модуле менеджера). Вызывается из процедуры Печать модуля менеджера.
//
// Параметры:
//  ИмяМакета             - Строка - идентификатор команды печати.
//  ВидФормы              - Строка - вид фирменной формы, см. ВидыФорм.
//  МассивОбъектов        - Массив - ссылки на печатаемые документы.
//  ПараметрыПечати       - Структура - параметры команды печати; передаются адаптеру как есть, БезЦен = Истина
//                          печатает таблицу без цен и итогов.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - см. ПечатныеФормы.НоваяКоллекцияПечатныхФорм.
//  ОбъектыПечати         - СписокЗначений - соответствие документов областям печати.
//
Процедура Напечатать(ИмяМакета, ВидФормы, МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм,
	ОбъектыПечати) Экспорт

	Если Не ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета) Тогда
		Возврат;
	КонецЕсли;
	Параметры = ?(ТипЗнч(ПараметрыПечати) = Тип("Структура"), ПараметрыПечати, Новый Структура);

	// Тексты, которые модуль собирает сам, - на языке, выбранном в окне печати, а не на языке сеанса.
	КодЯзыка = ПечатныеФормы.ЯзыкПечати();
	Вид = ОписаниеВидаДляПечати(ВидФормы, КодЯзыка, Параметры);
	Макет = МакетВида(Вид, КодЯзыка);
	Источники = ИсточникиПечати(МассивОбъектов, ВидФормы, КодЯзыка, Параметры);

	ТабличныйДокумент = НовыйТабличныйДокумент();
	ИмяФайла = "";
	Для Каждого Документ Из МассивОбъектов Цикл
		Источник = Источники[Документ];
		Если Источник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		НачальнаяСтрока = ТабличныйДокумент.ВысотаТаблицы + 1;
		Вывести(ТабличныйДокумент, Макет, Источник, Вид, КодЯзыка);
		ПечатныеФормы.ЗадатьОбластьПечати(ТабличныйДокумент, НачальнаяСтрока, ОбъектыПечати, Документ);
		ИмяФайла = Источник.ИмяФайла;
	КонецЦикла;
	Если МассивОбъектов.Количество() = 1 И ЗначениеЗаполнено(ИмяФайла) Тогда
		ТабличныйДокумент.ИспользуемоеИмяФайла = ИмяФайла;
	КонецЕсли;

	ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, ИмяМакета, Вид.Представление, ТабличныйДокумент,
		ПутьМакета());

КонецПроцедуры

// Фирменная форма по готовым данным печати - без документа и адаптера: перепечатка сохранённых данных и проверка
// совместимости форматов (сценарий ТестыДокументов «ФирменнаяПечать»).
//
// Параметры:
//  Данные          - Структура - данные печати, см. ПривестиДанные.
//  ВидФормы        - Строка - вид фирменной формы, см. ВидыФорм.
//  КодЯзыка        - Строка - язык печати; пусто - язык сеанса.
//  Плашка          - Строка - текст плашки в строке номера; пусто - без плашки.
//  ПараметрыПечати - Структура, Неопределено - параметры команды печати (БезЦен).
//
// Возвращаемое значение:
//  ТабличныйДокумент - сформированная форма.
//
Функция ТабличныйДокументПоДанным(Данные, ВидФормы, КодЯзыка = "", Плашка = "", ПараметрыПечати = Неопределено) Экспорт
	// Язык макета задаётся через контекст формирования, как в ПечатныеФормы.СформироватьПечатныеФормы.
	Контекст = ПечатныеФормыПовтИсп.КонтекстФормирования();
	ПрежнийКодЯзыка = Контекст.КодЯзыка;
	Контекст.КодЯзыка = КодЯзыка;
	Попытка
		КодЯзыкаПечати = ПечатныеФормы.ЯзыкПечати();
		Вид = ОписаниеВидаДляПечати(ВидФормы, КодЯзыкаПечати, ПараметрыПечати);
		Макет = МакетВида(Вид, КодЯзыкаПечати);
		ТабличныйДокумент = НовыйТабличныйДокумент();
		Вывести(ТабличныйДокумент, Макет, Новый Структура("Данные, Плашка", Данные, Плашка), Вид, КодЯзыкаПечати);
	Исключение
		Контекст.КодЯзыка = ПрежнийКодЯзыка;
		ВызватьИсключение;
	КонецПопытки;
	Контекст.КодЯзыка = ПрежнийКодЯзыка;
	Возврат ТабличныйДокумент;
КонецФункции

// Приводит данные печати к текущему формату. Данные снимков редакций КП хранятся в той версии формата, в которой
// записаны (раздел 3.2 плана): 1 - 2.0.16.50, без ключа ВерсияФормата, сумма прописью только на языке записи;
// 2 - 2.0.16.51 и далее, СуммаПрописьюПоЯзыкам. Существующие ключи переносятся как есть, справочники не читаются.
//
// Параметры:
//  Данные - Структура - данные печати: Организация, Клиент, Шапка, Товары, Итоги, КодВалюты, Логотип,
//           ПечатьОрганизации (см. Документы.КоммерческоеПредложение.ДанныеДляПечати).
//
// Возвращаемое значение:
//  Структура - те же данные; отсутствующие необязательные ключи добавлены пустыми значениями.
//
Функция ПривестиДанные(Данные) Экспорт
	ДобавитьКлюч(Данные, "ВерсияФормата", 1);
	ДобавитьКлюч(Данные, "КодВалюты", "");
	ДобавитьКлюч(Данные, "Логотип", Неопределено);
	ДобавитьКлюч(Данные, "ПечатьОрганизации", Неопределено);
	ДобавитьКлюч(Данные.Клиент, "КлиентДоговор", "");
	ДобавитьКлюч(Данные.Шапка, "Комментарий", "");
	ДобавитьКлюч(Данные.Шапка, "ДатаОтгрузки", Дата(1, 1, 1));
	ДобавитьКлюч(Данные.Итоги, "СуммаПрописьюПоЯзыкам", Новый Соответствие);
	Возврат Данные;
КонецФункции

// Блок организации данных печати: наименование, адрес, контакты, коды и подвал реквизитов.
//
// Параметры:
//  Организация - СправочникСсылка.Организации - организация документа.
//  Дата        - Дата - дата, на которую берутся реквизиты.
//
// Возвращаемое значение:
//  Структура - ОрганизацияНаименование, ОрганизацияАдрес, ОрганизацияКонтакты, ОрганизацияКоды, ПодвалРеквизитов.
//
Функция ДанныеОрганизации(Организация, Дата) Экспорт
	Карточка = Справочники.Контрагенты.ПолучитьКарточку(Организация, Дата);
	Результат = Новый Структура;
	Результат.Вставить("ОрганизацияНаименование", НаименованиеИзКарточки(Карточка));
	Результат.Вставить("ОрганизацияАдрес", СокрЛП(Карточка.АдресЮридический));
	Контакты = СокрЛП(Карточка.Телефоны);
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Контакты, РеквизитКарточки(Карточка, "EMail"), " · ");
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Контакты, РеквизитКарточки(Карточка, "Web"), " · ");
	Результат.Вставить("ОрганизацияКонтакты", Контакты);
	Коды = "";
	ДобавитьКод(Коды, КодICE(), РеквизитКарточки(Карточка, КодICE()));
	ДобавитьКод(Коды, "RC", РеквизитКарточки(Карточка, "RC"));
	ДобавитьКод(Коды, "IF", РеквизитКарточки(Карточка, "NIF"));
	Результат.Вставить("ОрганизацияКоды", Коды);
	Результат.Вставить("ПодвалРеквизитов", ПечатныеФормы.РеквизитыОрганизацииДляПодвала(Организация, Дата, Карточка));
	Возврат Результат;
КонецФункции

// Блок второй стороны данных печати (ключ Клиент): наименование, адрес с телефонами и ICE, договор.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - вторая сторона документа.
//  Договор    - СправочникСсылка.ДоговорыКонтрагентов - договор; пустой - без строки договора.
//  Дата       - Дата - дата, на которую берутся реквизиты.
//
// Возвращаемое значение:
//  Структура - КлиентНаименование, КлиентРеквизиты, КлиентДоговор (подпись «Договор:» добавляет вывод на языке
//              печати).
//
Функция ДанныеКонтрагента(Контрагент, Договор, Дата) Экспорт
	Карточка = Справочники.Контрагенты.ПолучитьКарточку(Контрагент, Дата);
	Результат = Новый Структура;
	Результат.Вставить("КлиентНаименование", НаименованиеИзКарточки(Карточка));
	Реквизиты = СокрЛП(Карточка.АдресЮридический);
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты, СокрЛП(Карточка.Телефоны), Символы.ПС);
	Коды = "";
	ДобавитьКод(Коды, КодICE(), РеквизитКарточки(Карточка, КодICE()));
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты, Коды, Символы.ПС);
	Результат.Вставить("КлиентРеквизиты", Реквизиты);
	Результат.Вставить("КлиентДоговор", ?(ЗначениеЗаполнено(Договор), СокрЛП(Договор), ""));
	Возврат Результат;
КонецФункции

// Блок итогов данных печати с суммой прописью на всех языках конфигурации: данные печатаются на любом языке
// без обращения к справочнику валют.
//
// Параметры:
//  Сумма       - Число - сумма документа.
//  СуммаНДС    - Число - сумма НДС.
//  СуммаБезНДС - Число - сумма без НДС.
//  Валюта      - СправочникСсылка.Валюты - валюта документа.
//
// Возвращаемое значение:
//  Структура - Сумма, СуммаНДС, СуммаБезНДС, СуммаПрописью (язык сеанса), СуммаПрописьюПоЯзыкам (Соответствие).
//
Функция ДанныеИтогов(Сумма, СуммаНДС, СуммаБезНДС, Валюта) Экспорт
	Итоги = Новый Структура;
	Итоги.Вставить("Сумма", Сумма);
	Итоги.Вставить("СуммаНДС", СуммаНДС);
	Итоги.Вставить("СуммаБезНДС", СуммаБезНДС);
	Итоги.Вставить("СуммаПрописью", ПечатныеФормы.СуммаПрописью(Сумма, Валюта));
	ПоЯзыкам = Новый Соответствие;
	Для Каждого Язык Из Метаданные.Языки Цикл
		ПоЯзыкам.Вставить(Язык.КодЯзыка, ПечатныеФормы.СуммаПрописью(Сумма, Валюта, Язык.КодЯзыка));
	КонецЦикла;
	Итоги.Вставить("СуммаПрописьюПоЯзыкам", ПоЯзыкам);
	Возврат Итоги;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВидКоммерческоеПредложение()
	Возврат "КоммерческоеПредложение";
КонецФункции

Функция ВариантБезЦен()
	Возврат "БезЦен";
КонецФункции

Функция ОписаниеВидаДляПечати(ВидФормы, КодЯзыка, ПараметрыПечати)
	// Одна команда печатает разные варианты таблицы (раздел 3.1 плана): БезЦен = Истина у накладной A5 рабочего
	// места кассира.
	Вид = ОписаниеВида(ВидФормы, КодЯзыка);
	БезЦен = Ложь;
	Если ТипЗнч(ПараметрыПечати) = Тип("Структура") Тогда
		ПараметрыПечати.Свойство("БезЦен", БезЦен);
	КонецЕсли;
	Если ТипЗнч(БезЦен) = Тип("Булево") И БезЦен Тогда
		Вид.Таблица = ВариантБезЦен();
	КонецЕсли;
	Возврат Вид;
КонецФункции

Функция ПутьМакета()
	Возврат "ОбщийМакет.ФирменныйДокумент";
КонецФункции

Функция НовыйТабличныйДокумент()
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.РазмерСтраницы = "A4";
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ПолеСлева = ПолеСбоку();
	ТабличныйДокумент.ПолеСправа = ПолеСбоку();
	ТабличныйДокумент.ПолеСверху = ПолеСверхуСнизу();
	ТабличныйДокумент.ПолеСнизу = ПолеСверхуСнизу();
	Возврат ТабличныйДокумент;
КонецФункции

Функция ПолеСбоку()
	Возврат 12;
КонецФункции

Функция ПолеСверхуСнизу()
	Возврат 10;
КонецФункции

Функция МакетВида(Вид, КодЯзыка)
	// Пользовательская правка общего макета - если в ней есть все области вида, иначе поставляемый (раздел 3.4а
	// плана): правка, сохранённая до сборки, добавившей области, не должна ломать печать.
	Макет = ПечатныеФормы.МакетПечатнойФормы(ПутьМакета());
	Недостающие = НедостающиеОбласти(Макет, Вид);
	Если Недостающие.Количество() = 0 Тогда
		Возврат Макет;
	КонецЕсли;
	ШаблонПредупреждения = НСтр("ru = 'Изменённый макет %1 не содержит областей %2 - печать поставляемым макетом.
		|Перенесите правки в новую версию макета.'; fr = 'Le modèle modifié %1 ne contient pas les zones %2 -
		|impression avec le modèle fourni. Reportez les modifications dans la nouvelle version du modèle.';
		|en = 'The modified template %1 lacks areas %2 - printing with the supplied template.
		|Move the changes to the new template version.'; es = 'La plantilla modificada %1 no contiene las áreas %2 -
		|impresión con la plantilla suministrada. Traslade los cambios a la nueva versión de la plantilla.'");
	КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	ИмяСобытия = НСтр("ru = 'Печать.Фирменный макет'; fr = 'Impression.Modèle à en-tête';
		|en = 'Printing.Branded template'; es = 'Impresión.Plantilla corporativa'", КодОсновногоЯзыка);
	Комментарий = СтрШаблон(ШаблонПредупреждения, ПутьМакета(), СтрСоединить(Недостающие, ", "));
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , Комментарий);
	Макет = ПечатныеФормы.ПоставляемыйМакет(ПутьМакета());
	Если ЗначениеЗаполнено(КодЯзыка) Тогда
		Макет.КодЯзыка = КодЯзыка;
	КонецЕсли;
	Возврат Макет;
КонецФункции

Функция НедостающиеОбласти(Макет, Вид)
	Имена = СтрРазделить("Шапка,Заголовок,Стороны,ОписаниеСтроки,РазделительСтрок,Итоги,Условия,Подпись,"
		+ "ПодвалРеквизитов,ПустаяСтрока", ",");
	Имена.Добавить("ШапкаТаблицы" + Вид.Таблица);
	Имена.Добавить("Строка" + Вид.Таблица);
	Недостающие = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Если Макет.Области.Найти(Имя) = Неопределено Тогда
			Недостающие.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Недостающие;
КонецФункции

Функция ИсточникиПечати(МассивОбъектов, ВидФормы, КодЯзыка, ПараметрыПечати)
	// Адаптер - у менеджера типа документа; ссылки разных типов печатаются каждый своим адаптером.
	ПоТипам = Новый Соответствие;
	Для Каждого Ссылка Из МассивОбъектов Цикл
		ИмяТипа = Ссылка.Метаданные().Имя;
		Ссылки = ПоТипам[ИмяТипа];
		Если Ссылки = Неопределено Тогда
			Ссылки = Новый Массив;
			ПоТипам.Вставить(ИмяТипа, Ссылки);
		КонецЕсли;
		Ссылки.Добавить(Ссылка);
	КонецЦикла;
	Источники = Новый Соответствие;
	Для Каждого КлючИЗначение Из ПоТипам Цикл
		Данные = Документы[КлючИЗначение.Ключ].ДанныеФирменнойПечати(КлючИЗначение.Значение, ВидФормы, КодЯзыка,
			ПараметрыПечати);
		Для Каждого Источник Из Данные Цикл
			Источники.Вставить(Источник.Ключ, Источник.Значение);
		КонецЦикла;
	КонецЦикла;
	Возврат Источники;
КонецФункции

Процедура Вывести(ТабличныйДокумент, Макет, Источник, Вид, КодЯзыка)
	Данные = ПривестиДанные(Источник.Данные);
	Плашка = Источник.Плашка;
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтороны = Макет.ПолучитьОбласть("Стороны");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы" + Вид.Таблица);
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка" + Вид.Таблица);
	ОбластьОписание = Макет.ПолучитьОбласть("ОписаниеСтроки");
	ОбластьРазделитель = Макет.ПолучитьОбласть("РазделительСтрок");
	ОбластьИтоги = Макет.ПолучитьОбласть("Итоги");
	ОбластьУсловия = Макет.ПолучитьОбласть("Условия");
	ОбластьПодпись = Макет.ПолучитьОбласть("Подпись");
	ОбластьПодвал = Макет.ПолучитьОбласть("ПодвалРеквизитов");
	ОбластьПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");

	Шапка = Данные.Шапка;
	Картинки = Новый Соответствие;
	Картинки.Вставить("ЛоготипДокумента", Данные.Логотип);
	Картинки.Вставить("ПечатьДокумента", Данные.ПечатьОрганизации);

	ОбластьШапка.Параметры.Заполнить(Данные.Организация);
	ПечатныеФормы.ЗаполнитьРисункиКартинками(ОбластьШапка, Картинки);
	ОбластьПодвал.Параметры.ПодвалРеквизитов = Данные.Организация.ПодвалРеквизитов;
	ОбластьЗаголовок.Параметры.Заголовок = Вид.Заголовок;
	ОбластьЗаголовок.Параметры.Номер = Шапка.Номер;
	ОбластьЗаголовок.Параметры.Дата = ФорматДаты(Шапка.Дата, КодЯзыка);
	ОбластьЗаголовок.Параметры.Плашка = Плашка;
	Если ПустаяСтрока(Плашка) Тогда
		// Документ без плашки печатается без неё: пустая ячейка с заливкой выходила цветным прямоугольником.
		ОбластьЗаголовок.Область("R3C5:R3C7").ЦветФона = WebЦвета.Белый;
	КонецЕсли;
	ОбластьСтороны.Параметры.ПодписьСтороны = Вид.ПодписьСтороны;
	ОбластьСтороны.Параметры.ПодписьКонтакта = Вид.ПодписьКонтакта;
	ОбластьСтороны.Параметры.Заполнить(Данные.Клиент);
	ОбластьСтороны.Параметры.КлиентРеквизиты = РеквизитыКлиентаДляПечати(Данные.Клиент, КодЯзыка);
	ОбластьСтороны.Параметры.Менеджер = Шапка.Менеджер;
	ОбластьСтороны.Параметры.УсловияКратко = УсловияКратко(Шапка, КодЯзыка);

	ТабличныйДокумент.Вывести(ОбластьШапка);
	ТабличныйДокумент.Вывести(ОбластьЗаголовок);
	ТабличныйДокумент.Вывести(ОбластьСтороны);
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);

	ВнизуСтраницы = Новый Массив;
	ВнизуСтраницы.Добавить(ОбластьПодвал);
	Для Каждого Товар Из Данные.Товары Цикл
		// Параметры.Заполнить пропускает колонки, которых нет в варианте таблицы (без цен - без цены и суммы).
		ОбластьСтрока.Параметры.Заполнить(ЗначенияСтроки(Товар, КодЯзыка));
		ОбластиСтроки = Новый Массив;
		ОбластиСтроки.Добавить(ОбластьСтрока);
		ЕстьОписание = ЗначениеЗаполнено(Товар.Описание);
		Если ЕстьОписание Тогда
			ОбластьОписание.Параметры.Описание = Товар.Описание;
			ОбластиСтроки.Добавить(ОбластьОписание);
		КонецЕсли;
		ОбластиСтроки.Добавить(ОбластьРазделитель);
		ОбластиСтроки.Добавить(ОбластьПодвал);
		Если Не ТабличныйДокумент.ПроверитьВывод(ОбластиСтроки) Тогда
			НоваяСтраница(ТабличныйДокумент, ОбластьПустаяСтрока, ОбластьПодвал);
			ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		Если ЕстьОписание Тогда
			ТабличныйДокумент.Вывести(ОбластьОписание);
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьРазделитель);
	КонецЦикла;

	Если Вид.Таблица <> ВариантБезЦен() Тогда
		Итоги = Данные.Итоги;
		КодВалюты = Данные.КодВалюты;
		ОбластьИтоги.Параметры.СуммаБезНДС = ФорматДенег(Итоги.СуммаБезНДС, КодЯзыка) + " " + КодВалюты;
		ОбластьИтоги.Параметры.СуммаНДС = ФорматДенег(Итоги.СуммаНДС, КодЯзыка) + " " + КодВалюты;
		ОбластьИтоги.Параметры.Итого = ФорматДенег(Итоги.Сумма, КодЯзыка) + " " + КодВалюты;
		ОбластьИтоги.Параметры.СуммаПрописью = СуммаПрописьюНаЯзыке(Итоги, КодЯзыка);
		ВывестиБлок(ТабличныйДокумент, ОбластьИтоги, ОбластьПустаяСтрока, ОбластьПодвал);
	КонецЕсли;

	Если ЗначениеЗаполнено(Шапка.Комментарий) Тогда
		ОбластьУсловия.Параметры.Условия = Шапка.Комментарий;
		ВывестиБлок(ТабличныйДокумент, ОбластьУсловия, ОбластьПустаяСтрока, ОбластьПодвал);
	КонецЕсли;

	ОбластьПодпись.Параметры.ПодписьМенеджер = Шапка.Менеджер;
	ОбластьПодпись.Параметры.ПодписьОрганизация = Данные.Организация.ОрганизацияНаименование;
	ПечатныеФормы.ЗаполнитьРисункиКартинками(ОбластьПодпись, Картинки);
	ВывестиБлок(ТабличныйДокумент, ОбластьПодпись, ОбластьПустаяСтрока, ОбластьПодвал);

	ПечатныеФормы.ДобитьСтраницуПустымиСтроками(ТабличныйДокумент, ОбластьПустаяСтрока, ВнизуСтраницы);
	ТабличныйДокумент.Вывести(ОбластьПодвал);
КонецПроцедуры

Функция ЗначенияСтроки(Товар, КодЯзыка)
	Значения = Новый Структура;
	Значения.Вставить("НомерСтроки", Товар.НомерСтроки);
	Значения.Вставить("Наименование", Товар.Наименование);
	Значения.Вставить("Количество", ФорматКоличества(Товар.Количество, КодЯзыка));
	Значения.Вставить("Единица", Товар.Единица);
	Значения.Вставить("Цена", ФорматДенег(Товар.Цена, КодЯзыка));
	ФорматСкидки = "ЧДЦ=2; " + ПечатныеФормы.ЛокализацияФормата(КодЯзыка);
	Значения.Вставить("Скидка", ?(Товар.ПроцентСкидки = 0, "", Формат(Товар.ПроцентСкидки, ФорматСкидки) + " %"));
	Значения.Вставить("Сумма", ФорматДенег(Товар.Сумма, КодЯзыка));
	Возврат Значения;
КонецФункции

Процедура ВывестиБлок(ТабличныйДокумент, Область, ОбластьПустаяСтрока, ОбластьПодвал)
	Проверка = Новый Массив;
	Проверка.Добавить(Область);
	Проверка.Добавить(ОбластьПодвал);
	Если Не ТабличныйДокумент.ПроверитьВывод(Проверка) Тогда
		НоваяСтраница(ТабличныйДокумент, ОбластьПустаяСтрока, ОбластьПодвал);
	КонецЕсли;
	ТабличныйДокумент.Вывести(Область);
КонецПроцедуры

Процедура НоваяСтраница(ТабличныйДокумент, ОбластьПустаяСтрока, ОбластьПодвал)
	ВнизуСтраницы = Новый Массив;
	ВнизуСтраницы.Добавить(ОбластьПодвал);
	ПечатныеФормы.ДобитьСтраницуПустымиСтроками(ТабличныйДокумент, ОбластьПустаяСтрока, ВнизуСтраницы);
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
КонецПроцедуры

Функция УсловияКратко(Шапка, КодЯзыка)
	Текст = "";
	Если ЗначениеЗаполнено(Шапка.ДатаОтгрузки) Тогда
		Текст = НСтр("ru = 'Срок поставки: '; fr = 'Date de livraison : '; en = 'Delivery date: '; es = 'Fecha de entrega: '",
			КодЯзыка) + ФорматДаты(Шапка.ДатаОтгрузки, КодЯзыка);
	КонецЕсли;
	ВидЦен = ?(Шапка.ЦенаВключаетНДС, НСтр("ru = 'Цены указаны с НДС'; fr = 'Prix TTC'; en = 'Prices include VAT';
		|es = 'Precios con IVA'", КодЯзыка), НСтр("ru = 'Цены указаны без НДС'; fr = 'Prix HT'; en = 'Prices exclude VAT';
		|es = 'Precios sin IVA'", КодЯзыка));
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Текст, ВидЦен, Символы.ПС);
	Возврат Текст;
КонецФункции

Функция РеквизитыКлиентаДляПечати(Клиент, КодЯзыка)
	// Договор подписывается на языке печати. В снимках формата 1 договор уже вписан в реквизиты на языке записи -
	// они печатаются как есть.
	Реквизиты = Клиент.КлиентРеквизиты;
	Договор = Клиент.КлиентДоговор;
	Если ЗначениеЗаполнено(Договор) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты,
			НСтр("ru = 'Договор: '; fr = 'Contrat : '; en = 'Contract: '; es = 'Contrato: '", КодЯзыка) + Договор,
			Символы.ПС);
	КонецЕсли;
	Возврат Реквизиты;
КонецФункции

Функция СуммаПрописьюНаЯзыке(Итоги, КодЯзыка)
	// Снимки формата 1 хранят сумму прописью только на языке записи.
	Текст = Итоги.СуммаПрописьюПоЯзыкам.Получить(КодЯзыка);
	Возврат ?(Текст = Неопределено, Итоги.СуммаПрописью, Текст);
КонецФункции

Функция ФорматДаты(Дата, КодЯзыка)
	Возврат Формат(Дата, "ДЛФ=D; " + ПечатныеФормы.ЛокализацияФормата(КодЯзыка));
КонецФункции

Функция ФорматДенег(Сумма, КодЯзыка)
	Локализация = ПечатныеФормы.ЛокализацияФормата(КодЯзыка);
	// Ноль - с десятичным разделителем языка печати: «0,00» или «0.00».
	Ноль = СтрЗаменить(Формат(1, "ЧДЦ=2; " + Локализация), "1", "0");
	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=" + Ноль + "; " + Локализация);
КонецФункции

Функция ФорматКоличества(Количество, КодЯзыка)
	ФорматнаяСтрока = ?(Количество = Цел(Количество), "ЧДЦ=0; ЧН=0", "ЧДЦ=3; ЧН=0");
	Возврат Формат(Количество, ФорматнаяСтрока + "; " + ПечатныеФормы.ЛокализацияФормата(КодЯзыка));
КонецФункции

Процедура ДобавитьКлюч(Структура, Ключ, Значение)
	Если Не Структура.Свойство(Ключ) Тогда
		Структура.Вставить(Ключ, Значение);
	КонецЕсли;
КонецПроцедуры

Функция НаименованиеИзКарточки(Карточка)
	Возврат СокрЛП(?(ПустаяСтрока(Карточка.НаименованиеПолное), Карточка.Наименование, Карточка.НаименованиеПолное));
КонецФункции

Функция РеквизитКарточки(Карточка, Имя)
	Значение = Неопределено;
	Карточка.Реквизиты.Свойство(Имя, Значение);
	Возврат СокрЛП(Значение);
КонецФункции

Функция КодICE()
	Возврат "ICE";
КонецФункции

Процедура ДобавитьКод(Строка, Подпись, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Строка, Подпись + " " + Значение, " · ");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
