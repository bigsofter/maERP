// Фирменные печатные формы: один общий макет ФирменныйДокумент и один алгоритм вывода для любого документа,
// у которого есть адаптер данных (docs/plans/branded-print.md). Модуль знает макет; документ знает свои данные.
//
// Адаптер - экспортная функция модуля менеджера документа:
//   ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) -> Соответствие ссылка -> Структура
//   (Данные - см. ПривестиДанные, Плашка - Строка, ИмяФайла - Строка) или Массив таких структур - несколько форм
//   одного документа подряд (счета реализаций заказа).

#Область ПрограммныйИнтерфейс

// Имена видов фирменных форм.
//
// Возвращаемое значение:
//  Массив из Строка - имена видов, см. ОписаниеВида.
//
Функция ВидыФорм() Экспорт
	Виды = Новый Массив;
	Виды.Добавить(ВидКоммерческоеПредложение());
	Виды.Добавить(ВидФактура());
	Виды.Добавить(ВидПроформа());
	Возврат Виды;
КонецФункции

// Описание вида фирменной формы на языке печати.
//
// Параметры:
//  ВидФормы - Строка - имя вида, см. ВидыФорм.
//  КодЯзыка - Строка - язык текстов; пусто - язык сеанса.
//
// Возвращаемое значение:
//  Структура - описание вида:
//   * Представление        - Строка - название печатной формы в списке команд и в окне печати.
//   * Заголовок            - Строка - заголовок документа на форме.
//   * ЗаголовокПокупки     - Строка - заголовок, когда организация - покупатель (счёт-фактура поставщика).
//   * ПодписьСтороны       - Строка - подпись блока второй стороны (клиент, поставщик) компоновки КП.
//   * ПодписьКонтакта      - Строка - подпись блока нашего контакта компоновки КП.
//   * ПодписьПродавца      - Строка - подпись колонки продавца компоновки «Фактура».
//   * ПодписьПокупателя    - Строка - подпись колонки покупателя компоновки «Фактура».
//   * ПодписьСуммыПрописью - Строка - текст перед суммой прописью; пусто - сумма прописью без подписи.
//   * ТекстУсловий         - Строка - постоянный текст условий вида; пусто - нет.
//   * Компоновка           - Строка - набор областей: «КП» или «Фактура».
//   * Таблица              - Строка - вариант таблицы: пусто - все колонки КП, «БезСкидки», «БезЦен», «Фактура».
//   * ЦеныБезНДС           - Булево - цены и суммы строк без НДС (параметр команды БезНДС).
//
Функция ОписаниеВида(ВидФормы, КодЯзыка = "") Экспорт
	Описание = Новый Структура;
	Для Каждого Поле Из СтрРазделить("Представление,Заголовок,ЗаголовокПокупки,ПодписьСтороны,ПодписьКонтакта,"
		+ "ПодписьПродавца,ПодписьПокупателя,ПодписьСуммыПрописью,ТекстУсловий,Таблица", ",") Цикл
		Описание.Вставить(Поле, "");
	КонецЦикла;
	Описание.Вставить("Компоновка", КомпоновкаКП());
	Описание.Вставить("ЦеныБезНДС", Ложь);
	Если ВидФормы = ВидКоммерческоеПредложение() Тогда
		ЗаполнитьОписаниеКП(Описание, КодЯзыка);
	ИначеЕсли ВидФормы = ВидФактура() Тогда
		ЗаполнитьОписаниеФактуры(Описание, КодЯзыка);
	ИначеЕсли ВидФормы = ВидПроформа() Тогда
		ЗаполнитьОписаниеПроформы(Описание, КодЯзыка);
	Иначе
		ШаблонОшибки = НСтр("ru = 'Неизвестный вид фирменной печатной формы: %1';
			|fr = 'Type de formulaire imprimable à en-tête inconnu : %1';
			|en = 'Unknown branded print form type: %1';
			|es = 'Tipo de formulario de impresión corporativo desconocido: %1'");
		ВызватьИсключение СтрШаблон(ШаблонОшибки, ВидФормы);
	КонецЕсли;
	Возврат Описание;
КонецФункции

// Добавляет команду фирменной печатной формы в коллекцию команд печати документа.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - см. ПечатныеФормы.НоваяКоллекцияКомандПечати.
//  ИмяМакета     - Строка - идентификатор команды (имя, под которым форму знает окно печати и настройки принтера).
//  ВидФормы      - Строка - вид фирменной формы, см. ВидыФорм.
//  Представление - Строка - название команды; пусто - название вида. Заменённая команда сохраняет прежнее название.
//
Процедура ДобавитьКоманду(КомандыПечати, ИмяМакета, ВидФормы, Представление = "") Экспорт
	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = ИмяМакета;
	Команда.Представление = ?(ПустаяСтрока(Представление), ОписаниеВида(ВидФормы).Представление, Представление);
КонецПроцедуры

// Формирует фирменную печатную форму для документов любого типа, у которого есть адаптер данных
// (ДанныеФирменнойПечати в модуле менеджера). Вызывается из процедуры Печать модуля менеджера.
//
// Параметры:
//  ИмяМакета             - Строка - идентификатор команды печати.
//  ВидФормы              - Строка - вид фирменной формы, см. ВидыФорм.
//  МассивОбъектов        - Массив - ссылки на печатаемые документы.
//  ПараметрыПечати       - Структура - параметры команды печати; передаются адаптеру как есть. БезЦен = Истина
//                          печатает таблицу без цен и итогов, БезНДС = Истина - цены и суммы строк без НДС.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - см. ПечатныеФормы.НоваяКоллекцияПечатныхФорм.
//  ОбъектыПечати         - СписокЗначений - соответствие документов областям печати.
//  Представление         - Строка - название формы в окне печати; пусто - название вида.
//
Процедура Напечатать(ИмяМакета, ВидФормы, МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм,
	ОбъектыПечати, Представление = "") Экспорт

	Если Не ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета) Тогда
		Возврат;
	КонецЕсли;
	Параметры = ?(ТипЗнч(ПараметрыПечати) = Тип("Структура"), ПараметрыПечати, Новый Структура);

	// Тексты, которые модуль собирает сам, - на языке, выбранном в окне печати, а не на языке сеанса.
	КодЯзыка = ПечатныеФормы.ЯзыкПечати();
	Вид = ОписаниеВидаДляПечати(ВидФормы, КодЯзыка, Параметры);
	Макет = МакетВида(Вид, КодЯзыка);
	Источники = ИсточникиПечати(МассивОбъектов, ВидФормы, КодЯзыка, Параметры);

	ТабличныйДокумент = НовыйТабличныйДокумент();
	ИмяФайла = "";
	Для Каждого Документ Из МассивОбъектов Цикл
		ИсточникиДокумента = Источники[Документ];
		Если ИсточникиДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ИсточникиДокумента) <> Тип("Массив") Тогда
			ИсточникиДокумента = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИсточникиДокумента);
		КонецЕсли;
		НачальнаяСтрока = ТабличныйДокумент.ВысотаТаблицы + 1;
		Для Каждого Источник Из ИсточникиДокумента Цикл
			Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			Вывести(ТабличныйДокумент, Макет, Источник, Вид, КодЯзыка);
			ИмяФайла = Источник.ИмяФайла;
		КонецЦикла;
		ПечатныеФормы.ЗадатьОбластьПечати(ТабличныйДокумент, НачальнаяСтрока, ОбъектыПечати, Документ);
	КонецЦикла;
	Если МассивОбъектов.Количество() = 1 И ЗначениеЗаполнено(ИмяФайла) Тогда
		ТабличныйДокумент.ИспользуемоеИмяФайла = ИмяФайла;
	КонецЕсли;

	Синоним = ?(ПустаяСтрока(Представление), Вид.Представление, Представление);
	ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, ИмяМакета, Синоним, ТабличныйДокумент, ПутьМакета());

КонецПроцедуры

// Фирменная форма по готовым данным печати - без документа и адаптера: перепечатка сохранённых данных и проверка
// совместимости форматов (сценарий ТестыДокументов «ФирменнаяПечать»).
//
// Параметры:
//  Данные          - Структура - данные печати, см. ПривестиДанные.
//  ВидФормы        - Строка - вид фирменной формы, см. ВидыФорм.
//  КодЯзыка        - Строка - язык печати; пусто - язык сеанса.
//  Плашка          - Строка - текст плашки в строке номера; пусто - без плашки.
//  ПараметрыПечати - Структура, Неопределено - параметры команды печати (БезЦен, БезНДС).
//
// Возвращаемое значение:
//  ТабличныйДокумент - сформированная форма.
//
Функция ТабличныйДокументПоДанным(Данные, ВидФормы, КодЯзыка = "", Плашка = "", ПараметрыПечати = Неопределено) Экспорт
	// Язык макета задаётся через контекст формирования, как в ПечатныеФормы.СформироватьПечатныеФормы.
	Контекст = ПечатныеФормыПовтИсп.КонтекстФормирования();
	ПрежнийКодЯзыка = Контекст.КодЯзыка;
	Контекст.КодЯзыка = КодЯзыка;
	Попытка
		КодЯзыкаПечати = ПечатныеФормы.ЯзыкПечати();
		Вид = ОписаниеВидаДляПечати(ВидФормы, КодЯзыкаПечати, ПараметрыПечати);
		Макет = МакетВида(Вид, КодЯзыкаПечати);
		ТабличныйДокумент = НовыйТабличныйДокумент();
		Вывести(ТабличныйДокумент, Макет, Новый Структура("Данные, Плашка", Данные, Плашка), Вид, КодЯзыкаПечати);
	Исключение
		Контекст.КодЯзыка = ПрежнийКодЯзыка;
		ВызватьИсключение;
	КонецПопытки;
	Контекст.КодЯзыка = ПрежнийКодЯзыка;
	Возврат ТабличныйДокумент;
КонецФункции

// Версия формата данных печати, которую пишут адаптеры этой сборки (раздел 3.2 плана).
//
// Возвращаемое значение:
//  Число - 3: коды и банк сторон, условия оплаты, основание, реквизиты строк для счёта-фактуры.
//
Функция ВерсияФормата() Экспорт
	Возврат 3;
КонецФункции

// Приводит данные печати к текущему формату. Данные снимков редакций КП хранятся в той версии формата, в которой
// записаны (раздел 3.2 плана): 1 - 2.0.16.50, без ключа ВерсияФормата, сумма прописью только на языке записи;
// 2 - 2.0.16.51 и далее, СуммаПрописьюПоЯзыкам; 3 - 2.0.16.70 и далее, ключи счёта-фактуры (раздел 10.2 плана).
// Существующие ключи переносятся как есть, отсутствующие добавляются пустыми, справочники не читаются.
//
// Параметры:
//  Данные - Структура - данные печати: Организация, Клиент, Шапка, Товары, Итоги, КодВалюты, Логотип,
//           ПечатьОрганизации (см. ДанныеТоварногоДокумента, Документы.КоммерческоеПредложение.ДанныеДляПечати).
//
// Возвращаемое значение:
//  Структура - те же данные; отсутствующие необязательные ключи добавлены пустыми значениями.
//
Функция ПривестиДанные(Данные) Экспорт
	ДобавитьКлюч(Данные, "ВерсияФормата", 1);
	ДобавитьКлюч(Данные, "КодВалюты", "");
	ДобавитьКлюч(Данные, "Логотип", Неопределено);
	ДобавитьКлюч(Данные, "ПечатьОрганизации", Неопределено);
	ДобавитьКлюч(Данные.Организация, "Коды", ПустыеКоды());
	ДобавитьКлюч(Данные.Организация, "Банк", Новый Структура("Банк, НомерСчета, БИК", "", "", ""));
	ДобавитьКлюч(Данные.Клиент, "КлиентДоговор", "");
	ДобавитьКлюч(Данные.Клиент, "КлиентКоды", ПустыеКоды());
	ДобавитьКлюч(Данные.Клиент, "КлиентАдрес", "");
	ДобавитьКлюч(Данные.Клиент, "КлиентТелефоны", "");
	ДобавитьКлюч(Данные.Клиент, "КлиентКод", "");
	ДобавитьКлюч(Данные.Шапка, "Комментарий", "");
	ДобавитьКлюч(Данные.Шапка, "ДатаОтгрузки", Дата(1, 1, 1));
	ДобавитьКлюч(Данные.Шапка, "Основание", "");
	ДобавитьКлюч(Данные.Шапка, "УсловияОплаты", "");
	ДобавитьКлюч(Данные.Шапка, "ОрганизацияПокупатель", Ложь);
	ДобавитьКлюч(Данные.Шапка, "ЦеныБезНДС", Ложь);
	ДобавитьКлюч(Данные.Итоги, "СуммаПрописьюПоЯзыкам", Новый Соответствие);
	ДобавитьКлюч(Данные.Итоги, "СуммаСкидки", 0);
	Для Каждого Товар Из Данные.Товары Цикл
		ДобавитьКлюч(Товар, "Артикул", "");
		ДобавитьКлюч(Товар, "СтавкаНДС", "");
		ДобавитьКлюч(Товар, "Группа", "");
		ДобавитьКлюч(Товар, "СуммаНДС", 0);
		ДобавитьКлюч(Товар, "ЦенаБезНДС", Товар.Цена);
		ДобавитьКлюч(Товар, "СуммаБезНДС", Товар.Сумма);
	КонецЦикла;
	Возврат Данные;
КонецФункции

// Блок организации данных печати: наименование, адрес, контакты, коды и подвал реквизитов.
//
// Параметры:
//  Организация - СправочникСсылка.Организации - организация документа.
//  Дата        - Дата - дата, на которую берутся реквизиты.
//  Кэш         - Соответствие, Неопределено - карточки, уже прочитанные в этом вызове печати (см. НовыйКэш).
//
// Возвращаемое значение:
//  Структура - ОрганизацияНаименование, ОрганизацияАдрес, ОрганизацияКонтакты, ОрганизацияКоды (ICE, RC, IF одной
//              строкой - шапка КП), ПодвалРеквизитов, Коды (см. ПустыеКоды), Банк (Банк, НомерСчета, БИК).
//
Функция ДанныеОрганизации(Организация, Дата, Кэш = Неопределено) Экспорт
	Карточка = КарточкаСтороны(Организация, Дата, Кэш);
	Результат = Новый Структура;
	Результат.Вставить("ОрганизацияНаименование", НаименованиеИзКарточки(Карточка));
	Результат.Вставить("ОрганизацияАдрес", СокрЛП(Карточка.АдресЮридический));
	Контакты = СокрЛП(Карточка.Телефоны);
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Контакты, РеквизитКарточки(Карточка, "EMail"), " · ");
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Контакты, РеквизитКарточки(Карточка, "Web"), " · ");
	Результат.Вставить("ОрганизацияКонтакты", Контакты);
	Коды = "";
	ДобавитьКод(Коды, "ICE", РеквизитКарточки(Карточка, "ICE"));
	ДобавитьКод(Коды, "RC", РеквизитКарточки(Карточка, "RC"));
	ДобавитьКод(Коды, "IF", РеквизитКарточки(Карточка, "NIF"));
	Результат.Вставить("ОрганизацияКоды", Коды);
	Результат.Вставить("ПодвалРеквизитов", ПечатныеФормы.РеквизитыОрганизацииДляПодвала(Организация, Дата, Карточка));
	Результат.Вставить("Коды", Карточка.КодыДляПечати);
	Результат.Вставить("Банк", БанкИзКарточки(Карточка));
	Возврат Результат;
КонецФункции

// Блок второй стороны данных печати (ключ Клиент): наименование, адрес с телефонами и ICE, договор, коды.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - вторая сторона документа.
//  Договор    - СправочникСсылка.ДоговорыКонтрагентов - договор; пустой - без строки договора.
//  Дата       - Дата - дата, на которую берутся реквизиты.
//  Кэш        - Соответствие, Неопределено - карточки, уже прочитанные в этом вызове печати (см. НовыйКэш).
//
// Возвращаемое значение:
//  Структура - КлиентНаименование, КлиентРеквизиты, КлиентДоговор (подпись «Договор:» добавляет вывод на языке
//              печати), КлиентКоды (см. ПустыеКоды), КлиентАдрес (фактический, иначе юридический), КлиентТелефоны,
//              КлиентКод (заполняет адаптер).
//
Функция ДанныеКонтрагента(Контрагент, Договор, Дата, Кэш = Неопределено) Экспорт
	Карточка = КарточкаСтороны(Контрагент, Дата, Кэш);
	Результат = Новый Структура;
	Результат.Вставить("КлиентНаименование", НаименованиеИзКарточки(Карточка));
	Реквизиты = СокрЛП(Карточка.АдресЮридический);
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты, СокрЛП(Карточка.Телефоны), Символы.ПС);
	Коды = "";
	ДобавитьКод(Коды, "ICE", РеквизитКарточки(Карточка, "ICE"));
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты, Коды, Символы.ПС);
	Результат.Вставить("КлиентРеквизиты", Реквизиты);
	Результат.Вставить("КлиентДоговор", ?(ЗначениеЗаполнено(Договор), СокрЛП(Договор), ""));
	Результат.Вставить("КлиентКоды", Карточка.КодыДляПечати);
	Адрес = СокрЛП(Карточка.АдресФактический);
	Результат.Вставить("КлиентАдрес", ?(ПустаяСтрока(Адрес), СокрЛП(Карточка.АдресЮридический), Адрес));
	Результат.Вставить("КлиентТелефоны", СокрЛП(Карточка.Телефоны));
	Результат.Вставить("КлиентКод", "");
	Возврат Результат;
КонецФункции

// Блок итогов данных печати с суммой прописью на всех языках конфигурации: данные печатаются на любом языке
// без обращения к справочнику валют.
//
// Параметры:
//  Сумма       - Число - сумма документа.
//  СуммаНДС    - Число - сумма НДС.
//  СуммаБезНДС - Число - сумма без НДС.
//  Валюта      - СправочникСсылка.Валюты - валюта документа.
//  СуммаСкидки - Число - сумма скидок строк (печатается строкой «в том числе скидка»).
//
// Возвращаемое значение:
//  Структура - Сумма, СуммаНДС, СуммаБезНДС, СуммаПрописью (язык сеанса), СуммаПрописьюПоЯзыкам (Соответствие),
//              СуммаСкидки.
//
Функция ДанныеИтогов(Сумма, СуммаНДС, СуммаБезНДС, Валюта, СуммаСкидки = 0) Экспорт
	Итоги = Новый Структура;
	Итоги.Вставить("Сумма", Сумма);
	Итоги.Вставить("СуммаНДС", СуммаНДС);
	Итоги.Вставить("СуммаБезНДС", СуммаБезНДС);
	Итоги.Вставить("СуммаПрописью", ПечатныеФормы.СуммаПрописью(Сумма, Валюта));
	ПоЯзыкам = Новый Соответствие;
	Для Каждого Язык Из Метаданные.Языки Цикл
		ПоЯзыкам.Вставить(Язык.КодЯзыка, ПечатныеФормы.СуммаПрописью(Сумма, Валюта, Язык.КодЯзыка));
	КонецЦикла;
	Итоги.Вставить("СуммаПрописьюПоЯзыкам", ПоЯзыкам);
	Итоги.Вставить("СуммаСкидки", СуммаСкидки);
	Возврат Итоги;
КонецФункции

// Кэш карточек сторон на один вызов печати: печать списком читает карточку каждой организации и контрагента один раз.
//
// Возвращаемое значение:
//  Соответствие - ключ «владелец и день» -> карточка (см. Справочники.Контрагенты.ПолучитьКарточку).
//
Функция НовыйКэш() Экспорт
	Возврат Новый Соответствие;
КонецФункции

// Строки товарных табличных частей документов для печати - одним пакетным запросом на массив ссылок (раздел 10.6
// плана). Колонки, которых у табличной части нет (скидка, характеристика, упаковка, содержание услуги, документ
// отгрузки), подставляются константой по метаданным; ОБЪЕДИНИТЬ ВСЕ - только между табличными частями одного документа.
//
// Параметры:
//  ИмяДокумента     - Строка - имя документа в метаданных, например «РеализацияТоваровУслуг».
//  Ссылки           - Массив из ДокументСсылка - печатаемые документы этого вида.
//  ИменаТЧ          - Строка - товарные табличные части через запятую в порядке печати: «ТЧТовары, ТЧУслуги».
//  ИмяКолонкиГруппы - Строка - колонка документа отгрузки строки («ОтгрузкаТовара»), «Ссылка» - сам документ,
//                     пусто - без групп.
//
// Возвращаемое значение:
//  Соответствие - ссылка -> Массив из Структура (строка печати: НомерСтроки, Наименование, Описание, Артикул,
//                 Количество, Единица, Цена, ПроцентСкидки, Сумма, СтавкаНДС, СуммаНДС, ЦенаБезНДС, СуммаБезНДС,
//                 СуммаСкидки, Группа).
//
Функция ДанныеСтрокДокументов(ИмяДокумента, Ссылки, ИменаТЧ, ИмяКолонкиГруппы = "") Экспорт
	МетаданныеДокумента = Метаданные.Документы[ИмяДокумента];
	Тексты = Новый Массив;
	Порядок = 0;
	Для Каждого ИмяТЧ Из СтрРазделить(ИменаТЧ, ", ", Ложь) Цикл
		Первая = Тексты.Количество() = 0;
		Текст = ТекстСтрокТабличнойЧасти(МетаданныеДокумента, ИмяТЧ, Порядок, ИмяКолонкиГруппы, Первая);
		Тексты.Добавить(Текст);
		Порядок = Порядок + 1;
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(Тексты, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС) + "
	|;
	|ВЫБРАТЬ
	|	Строки.СсылкаДокумента КАК СсылкаДокумента,
	|	Строки.НоменклатураСтрока КАК НоменклатураСтрока,
	|	Строки.Характеристика КАК Характеристика,
	|	Строки.Содержание КАК Содержание,
	|	Строки.Упаковка КАК Упаковка,
	|	Строки.Количество КАК Количество,
	|	Строки.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Строки.Цена КАК Цена,
	|	Строки.ПроцентСкидки КАК ПроцентСкидки,
	|	Строки.СуммаСкидки КАК СуммаСкидки,
	|	Строки.Сумма КАК Сумма,
	|	Строки.СуммаСНДС КАК СуммаСНДС,
	|	Строки.СуммаНДС КАК СуммаНДС,
	|	Строки.СтавкаНДС КАК СтавкаНДС,
	|	ЕСТЬNULL(Товары.Наименование, """") КАК НаименованиеНоменклатуры,
	|	ЕСТЬNULL(Товары.Артикул, """") КАК Артикул,
	|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(Товары.Единица), """") КАК ЕдиницаНоменклатуры,
	|	ЕСТЬNULL(Товары.ВыводитьНаПечатьОписание, ЛОЖЬ) КАК ВыводитьОписание,
	|	ЕСТЬNULL(Товары.Описание, """") КАК ОписаниеНоменклатуры,
	|	Строки.ДокументГруппы КАК ДокументГруппы
	|ИЗ
	|	ВТСтроки КАК Строки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	|		ПО Строки.Номенклатура = Товары.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строки.ПорядокТЧ,
	|	Строки.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Таблица = Запрос.ВыполнитьПакет()[1].Выгрузить();
	Группы = ПредставленияГрупп(Таблица.ВыгрузитьКолонку("ДокументГруппы"));
	Результат = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		Результат.Вставить(Ссылка, Новый Массив);
	КонецЦикла;
	Для Каждого Выборка Из Таблица Цикл
		Строки = Результат[Выборка.СсылкаДокумента];
		Строки.Добавить(СтрокаПечати(Выборка, 0, Группы));
	КонецЦикла;
	Для Каждого Ссылка Из Ссылки Цикл
		Результат.Вставить(Ссылка, СтрокиПоГруппам(Результат[Ссылка]));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Данные печати товарного документа (Facture, Proforma) в формате 3 из нормализованной шапки и строк.
//
// Параметры:
//  Шапка  - Структура - шапка документа:
//   * Организация           - СправочникСсылка.Организации - организация.
//   * Контрагент            - СправочникСсылка.Контрагенты - вторая сторона.
//   * Договор               - СправочникСсылка.ДоговорыСКонтрагентами - договор.
//   * КодКонтрагента        - Строка - код контрагента («Compte» старой Facture).
//   * Номер                 - Строка - номер так, как его печатает форма.
//   * Дата                  - Дата - дата документа на форме.
//   * Валюта                - СправочникСсылка.Валюты - валюта документа (пустая - основная).
//   * ВВалюте               - Булево, Неопределено - документ в валюте; Неопределено - по заполненности валюты.
//   * ЦенаВключаетНДС       - Булево - цены строк с НДС.
//   * Сумма, СуммаНДС       - Число - итоги документа.
//   * Менеджер              - Строка - менеджер документа.
//   * Комментарий           - Строка - комментарий.
//   * Основание             - Строка - основание на языке печати.
//   * УсловияОплаты         - Строка - способ оплаты.
//   * ОрганизацияПокупатель - Булево - организация - покупатель (счёт-фактура поставщика).
//   * ЦеныБезНДС            - Булево - печатать цены строк без НДС (признак контрагента).
//  Строки - Массив из Структура - строки печати, см. ДанныеСтрокДокументов.
//  Кэш    - Соответствие - кэш карточек вызова печати, см. НовыйКэш.
//
// Возвращаемое значение:
//  Структура - данные печати формата 3, см. ПривестиДанные.
//
Функция ДанныеТоварногоДокумента(Шапка, Строки, Кэш) Экспорт
	Валюта = ВалютаПечати(Шапка.Валюта, Шапка.ВВалюте);
	Данные = Новый Структура;
	Данные.Вставить("ВерсияФормата", ВерсияФормата());
	Данные.Вставить("КодВалюты", СокрЛП(Валюта));
	Данные.Вставить("Организация", ДанныеОрганизации(Шапка.Организация, Шапка.Дата, Кэш));
	Клиент = ДанныеКонтрагента(Шапка.Контрагент, Шапка.Договор, Шапка.Дата, Кэш);
	Клиент.КлиентКод = СокрЛП(Шапка.КодКонтрагента);
	Данные.Вставить("Клиент", Клиент);

	ШапкаПечати = Новый Структура;
	ШапкаПечати.Вставить("Номер", Шапка.Номер);
	ШапкаПечати.Вставить("Дата", Шапка.Дата);
	ШапкаПечати.Вставить("ДатаОтгрузки", Дата(1, 1, 1));
	ШапкаПечати.Вставить("ЦенаВключаетНДС", Шапка.ЦенаВключаетНДС);
	ШапкаПечати.Вставить("Менеджер", Шапка.Менеджер);
	ШапкаПечати.Вставить("Комментарий", СокрЛП(Шапка.Комментарий));
	ШапкаПечати.Вставить("Основание", Шапка.Основание);
	ШапкаПечати.Вставить("УсловияОплаты", СокрЛП(Шапка.УсловияОплаты));
	ШапкаПечати.Вставить("ОрганизацияПокупатель", Шапка.ОрганизацияПокупатель);
	ШапкаПечати.Вставить("ЦеныБезНДС", Шапка.ЦеныБезНДС);
	Данные.Вставить("Шапка", ШапкаПечати);

	Данные.Вставить("Товары", Строки);
	СуммаСкидки = 0;
	Для Каждого Строка Из Строки Цикл
		СуммаСкидки = СуммаСкидки + Строка.СуммаСкидки;
	КонецЦикла;
	СуммаБезНДС = Шапка.Сумма - Шапка.СуммаНДС;
	Итоги = ДанныеИтогов(Шапка.Сумма, Шапка.СуммаНДС, СуммаБезНДС, Валюта, СуммаСкидки);
	Данные.Вставить("Итоги", Итоги);

	Картинки = ПечатныеФормы.КартинкиОрганизации(Шапка.Организация);
	Данные.Вставить("Логотип", Картинки.Логотип);
	Данные.Вставить("ПечатьОрганизации", Картинки.ПечатьОрганизации);
	Возврат Данные;
КонецФункции

// Новая нормализованная шапка товарного документа, см. ДанныеТоварногоДокумента.
//
// Возвращаемое значение:
//  Структура - шапка с пустыми значениями.
//
Функция НоваяШапкаДокумента() Экспорт
	Шапка = Новый Структура("Организация, Контрагент, Договор, КодКонтрагента, Номер, Дата, Валюта, ВВалюте,
		|ЦенаВключаетНДС, Сумма, СуммаНДС, Менеджер, Комментарий, Основание, УсловияОплаты, ОрганизацияПокупатель,
		|ЦеныБезНДС");
	Шапка.КодКонтрагента = "";
	Шапка.Номер = "";
	Шапка.ЦенаВключаетНДС = Истина;
	Шапка.Сумма = 0;
	Шапка.СуммаНДС = 0;
	Шапка.Менеджер = "";
	Шапка.Комментарий = "";
	Шапка.Основание = "";
	Шапка.УсловияОплаты = "";
	Шапка.ОрганизацияПокупатель = Ложь;
	Шапка.ЦеныБезНДС = Ложь;
	Возврат Шапка;
КонецФункции

// Источник печати товарного документа для адаптера (см. Напечатать): данные формата 3 без плашки.
//
// Параметры:
//  Шапка    - Структура - см. НоваяШапкаДокумента.
//  Строки   - Массив из Структура - см. ДанныеСтрокДокументов; Неопределено - строк нет.
//  Кэш      - Соответствие - см. НовыйКэш.
//  ИмяФайла - Строка - имя файла при сохранении формы.
//
// Возвращаемое значение:
//  Структура - Данные, Плашка, ИмяФайла.
//
Функция ИсточникТоварногоДокумента(Шапка, Строки, Кэш, ИмяФайла) Экспорт
	СтрокиПечати = ?(Строки = Неопределено, Новый Массив, Строки);
	Возврат Новый Структура("Данные, Плашка, ИмяФайла", ДанныеТоварногоДокумента(Шапка, СтрокиПечати, Кэш), "", ИмяФайла);
КонецФункции

// Имя файла печатной формы, как у прежних форм: «Facture № 13 11 octobre 2026».
//
// Параметры:
//  Наименование - Строка - название формы.
//  Номер        - Строка - номер документа.
//  Дата         - Дата - дата документа.
//
// Возвращаемое значение:
//  Строка - имя файла.
//
Функция ИмяФайлаДокумента(Наименование, Номер, Дата) Экспорт
	Возврат Наименование + " № " + РаботаСДокументами.СформироватьЦифровойНомер(Номер) + " " + Формат(Дата, "ДЛФ=DD");
КонецФункции

// Способ оплаты документа для блока «Mode de règlement», как у прежней Facture: оплаты по документу, а без них - тип
// оплаты контрагента. Оплаты собирает РаботаСДокументами.ПолучитьСпособОплаты - запросом на документ (ручная
// корректировка и основания налоговых накладных; ревью плана фазы 3, P2 - принято частично).
//
// Параметры:
//  Ссылка    - ДокументСсылка - печатаемый документ.
//  ТипОплаты - Строка - представление типа оплаты контрагента.
//
// Возвращаемое значение:
//  Строка - способ оплаты.
//
Функция УсловияОплатыДокумента(Ссылка, ТипОплаты) Экспорт
	СпособОплаты = РаботаСДокументами.ПолучитьСпособОплаты(Ссылка);
	Возврат ?(ЗначениеЗаполнено(СпособОплаты), СпособОплаты, СокрЛП(ТипОплаты));
КонецФункции

// Номер документа так, как его печатала прежняя Facture: номер, косая черта и две цифры года.
//
// Параметры:
//  Номер - Строка - номер документа (фиксированной длины, с пробелами - tiny1C bsl-026).
//  Дата  - Дата - дата документа.
//
// Возвращаемое значение:
//  Строка - например «00000013/26».
//
Функция НомерСчетаФактуры(Номер, Дата) Экспорт
	Возврат СокрЛП(Номер) + "/" + Формат(Дата, "ДФ=yy");
КонецФункции

// Основание документа на языке печати: «Заказ № 12 от 01.10.2026».
//
// Параметры:
//  Подпись  - Строка - название документа основания на языке печати.
//  Номер    - Строка - номер основания так, как его печатать (внутренний номер адаптер сокращает сам, входящий номер
//             поставщика печатается как есть).
//  Дата     - Дата - дата основания.
//  КодЯзыка - Строка - язык печати.
//
// Возвращаемое значение:
//  Строка - представление; пустой номер - пустая строка.
//
Функция ПредставлениеОснования(Подпись, Номер, Дата, КодЯзыка) Экспорт
	Если ПустаяСтрока(Номер) Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = '%1 № %2 от %3'; fr = '%1 n° %2 du %3'; en = '%1 No. %2 dated %3'; es = '%1 n.º %2 del %3'",
		КодЯзыка);
	Возврат СтрШаблон(Шаблон, Подпись, СокрЛП(Номер), ФорматДаты(Дата, КодЯзыка));
