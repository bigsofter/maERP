Функция МакетВида(Вид, КодЯзыка)
	// Пользовательская правка общего макета - если в ней есть все области вида, иначе поставляемый (раздел 3.4а
	// плана): правка, сохранённая до сборки, добавившей области, не должна ломать печать.
	Макет = ПечатныеФормы.МакетПечатнойФормы(ПутьМакета());
	Недостающие = НедостающиеОбласти(Макет, Вид);
	Если Недостающие.Количество() = 0 Тогда
		Возврат Макет;
	КонецЕсли;
	ШаблонПредупреждения = НСтр("ru = 'Изменённый макет %1 не содержит областей %2 - печать поставляемым макетом.
		|Перенесите правки в новую версию макета.'; fr = 'Le modèle modifié %1 ne contient pas les zones %2 -
		|impression avec le modèle fourni. Reportez les modifications dans la nouvelle version du modèle.';
		|en = 'The modified template %1 lacks areas %2 - printing with the supplied template.
		|Move the changes to the new template version.'; es = 'La plantilla modificada %1 no contiene las áreas %2 -
		|impresión con la plantilla suministrada. Traslade los cambios a la nueva versión de la plantilla.'");
	КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	ИмяСобытия = НСтр("ru = 'Печать.Фирменный макет'; fr = 'Impression.Modèle à en-tête';
		|en = 'Printing.Branded template'; es = 'Impresión.Plantilla corporativa'", КодОсновногоЯзыка);
	Комментарий = СтрШаблон(ШаблонПредупреждения, ПутьМакета(), СтрСоединить(Недостающие, ", "));
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , Комментарий);
	Макет = ПечатныеФормы.ПоставляемыйМакет(ПутьМакета());
	Если ЗначениеЗаполнено(КодЯзыка) Тогда
		Макет.КодЯзыка = КодЯзыка;
	КонецЕсли;
	Возврат Макет;
КонецФункции

Функция НедостающиеОбласти(Макет, Вид)
	Если Вид.Компоновка = КомпоновкаСверка() Тогда
		Имена = СтрРазделить("Шапка,Заголовок,СтороныФактуры,СведенияДокумента,ГруппаСтрок,СверкаТекст,"
			+ "ШапкаТаблицыСверка,СтрокаСверка,СверкаИтог,ШапкаТаблицыСверкаБезНДС,СтрокаСверкаБезНДС,СверкаИтогБезНДС,"
			+ "ПодписиСторон,ПодвалРеквизитов,ПустаяСтрока", ",");
		Возврат ОтсутствующиеОбласти(Макет, Имена);
	ИначеЕсли Вид.Компоновка = КомпоновкаКвитанция() Тогда
		Имена = СтрРазделить("Шапка,Заголовок,СтороныФактуры,СведенияДокумента,КвитанцияСумма,КвитанцияСтрока,"
			+ "СведенияПечати,ПодписиСторон,ПодвалРеквизитов,ПустаяСтрока", ",");
		Возврат ОтсутствующиеОбласти(Макет, Имена);
	ИначеЕсли Вид.Компоновка = КомпоновкаКП() Тогда
		Имена = СтрРазделить("Шапка,Заголовок,Стороны,ОписаниеСтроки,РазделительСтрок,Итоги,Условия,Подпись,"
			+ "ПодвалРеквизитов,ПустаяСтрока", ",");
	Иначе
		Имена = СтрРазделить("Шапка,Заголовок,СтороныФактуры,СведенияДокумента,ГруппаСтрок,"
			+ "РазделительСтрок,ИтогСкидки,Итоги,БлокТекста,Условия,ПодвалРеквизитов,ПустаяСтрока", ",");
		Имена.Добавить(ИмяОбластиОписания(Вид));
		Имена.Добавить(?(Вид.Подписи = ПодписиСторон(), "ПодписиСторон", "ПодписьФактуры"));
		Если Вид.Оплаты Тогда
			Имена.Добавить("ОплатыДокумента");
		КонецЕсли;
		Если Вид.СведенияПечати Тогда
			Имена.Добавить("СведенияПечати");
		КонецЕсли;
	КонецЕсли;
	Имена.Добавить("ШапкаТаблицы" + Вид.Таблица);
	Имена.Добавить("Строка" + Вид.Таблица);
	Возврат ОтсутствующиеОбласти(Макет, Имена);
КонецФункции

Функция ОтсутствующиеОбласти(Макет, Имена)
	Недостающие = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Если Макет.Области.Найти(Имя) = Неопределено Тогда
			Недостающие.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Недостающие;
КонецФункции

#КонецОбласти

#Область Данные

Функция ИсточникиПечати(МассивОбъектов, ВидФормы, КодЯзыка, ПараметрыПечати)
	// Адаптер - у менеджера типа документа; ссылки разных типов печатаются каждый своим адаптером.
	ПоТипам = Новый Соответствие;
	Для Каждого Ссылка Из МассивОбъектов Цикл
		ИмяТипа = Ссылка.Метаданные().Имя;
		Ссылки = ПоТипам[ИмяТипа];
		Если Ссылки = Неопределено Тогда
			Ссылки = Новый Массив;
			ПоТипам.Вставить(ИмяТипа, Ссылки);
		КонецЕсли;
		Ссылки.Добавить(Ссылка);
	КонецЦикла;
	Источники = Новый Соответствие;
	Для Каждого КлючИЗначение Из ПоТипам Цикл
		Данные = Документы[КлючИЗначение.Ключ].ДанныеФирменнойПечати(КлючИЗначение.Значение, ВидФормы, КодЯзыка,
			ПараметрыПечати);
		Для Каждого Источник Из Данные Цикл
			Источники.Вставить(Источник.Ключ, Источник.Значение);
		КонецЦикла;
	КонецЦикла;
	Возврат Источники;
КонецФункции

Функция ТекстСтрокТабличнойЧасти(МетаданныеДокумента, ИмяТЧ, Порядок, ИмяКолонкиГруппы, Первая)
	Реквизиты = МетаданныеДокумента.ТабличныеЧасти[ИмяТЧ].Реквизиты;
	ПустаяСтрокаЗапроса = """""";
	// Поле -> выражение у табличной части, где колонка есть, и константа, где её нет.
	Колонки = Новый Массив;
	ДобавитьКолонкуСтрок(Колонки, "НоменклатураСтрока", "Т.НоменклатураСтрока", ПустаяСтрокаЗапроса);
	ДобавитьКолонкуСтрок(Колонки, "Характеристика", "ПРЕДСТАВЛЕНИЕ(Т.Характеристика)", ПустаяСтрокаЗапроса);
	ДобавитьКолонкуСтрок(Колонки, "Содержание", "Т.Содержание", ПустаяСтрокаЗапроса);
	ДобавитьКолонкуСтрок(Колонки, "Упаковка", "ПРЕДСТАВЛЕНИЕ(Т.Упаковка)", ПустаяСтрокаЗапроса);
	ДобавитьКолонкуСтрок(Колонки, "КоличествоУпаковок", "Т.КоличествоУпаковок", "Т.Количество");
	ДобавитьКолонкуСтрок(Колонки, "ПроцентСкидки", "Т.ПроцентСкидки", "0");
	ДобавитьКолонкуСтрок(Колонки, "СуммаСкидки", "Т.СуммаСкидки", "0");

	Поля = Новый Массив;
	Поля.Добавить("Т.Ссылка КАК СсылкаДокумента");
	Поля.Добавить(Формат(Порядок, "ЧН=0; ЧГ=0") + " КАК ПорядокТЧ");
	Поля.Добавить("Т.НомерСтроки КАК НомерСтроки");
	Поля.Добавить("Т.Номенклатура КАК Номенклатура");
	Для Каждого Колонка Из Колонки Цикл
		Выражение = ?(Реквизиты.Найти(Колонка.Поле) = Неопределено, Колонка.Константа, Колонка.Выражение);
		Поля.Добавить(Выражение + " КАК " + Колонка.Поле);
	КонецЦикла;
	Поля.Добавить("Т.Количество КАК Количество");
	Поля.Добавить("Т.Цена КАК Цена");
	Поля.Добавить("Т.Сумма КАК Сумма");
	Поля.Добавить("Т.СуммаСНДС КАК СуммаСНДС");
	Поля.Добавить("Т.СуммаНДС КАК СуммаНДС");
	Поля.Добавить("ПРЕДСТАВЛЕНИЕ(Т.СтавкаНДС) КАК СтавкаНДС");
	Если ИмяКолонкиГруппы = "Ссылка" Тогда
		Группа = "Т.Ссылка";
	ИначеЕсли ЗначениеЗаполнено(ИмяКолонкиГруппы) И Реквизиты.Найти(ИмяКолонкиГруппы) <> Неопределено Тогда
		Группа = "Т." + ИмяКолонкиГруппы;
	Иначе
		Группа = "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	Поля.Добавить(Группа + " КАК ДокументГруппы");
	Текст = "ВЫБРАТЬ" + Символы.ПС + Символы.Таб + СтрСоединить(Поля, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ ?(Первая, "ПОМЕСТИТЬ ВТСтроки" + Символы.ПС, "")
		+ "ИЗ" + Символы.ПС + Символы.Таб + "Документ." + МетаданныеДокумента.Имя + "." + ИмяТЧ + " КАК Т" + Символы.ПС
		+ "ГДЕ" + Символы.ПС + Символы.Таб + "Т.Ссылка В (&Ссылки)";
	Возврат Текст;
КонецФункции

Функция СтрокаПечати(Выборка, НомерСтроки, Группы)
	// Наименование - как у прежней Facture: строка номенклатуры или наименование, артикул, характеристика.
	Наименование = СокрЛП(Выборка.НоменклатураСтрока);
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = СокрЛП(Выборка.НаименованиеНоменклатуры);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Наименование, СокрЛП(Выборка.Артикул), ", ");
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Наименование, СокрЛП(Выборка.Характеристика), ", ");
	// Описание услуги - содержание и описание карточки для печати, как в КП из реализации (раздел 9.6 плана).
	Описание = СокрЛП(Выборка.Содержание);
	Если Выборка.ВыводитьОписание = Истина Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Описание, СокрЛП(Выборка.ОписаниеНоменклатуры), Символы.ПС);
	КонецЕсли;
	// Количество и единица - в упаковках строки, если упаковка задана: сумма строки = цена × количество упаковок.
	ЕстьУпаковка = Не ПустаяСтрока(Выборка.Упаковка);
	Количество = ?(ЕстьУпаковка, Выборка.КоличествоУпаковок, Выборка.Количество);
	СуммаБезНДС = Выборка.СуммаСНДС - Выборка.СуммаНДС;

	Строка = Новый Структура;
	Строка.Вставить("НомерСтроки", НомерСтроки);
	Строка.Вставить("Наименование", Наименование);
	Строка.Вставить("Описание", Описание);
	Строка.Вставить("Артикул", СокрЛП(Выборка.Артикул));
	Строка.Вставить("Количество", Количество);
	Строка.Вставить("Единица", ?(ЕстьУпаковка, СокрЛП(Выборка.Упаковка), СокрЛП(Выборка.ЕдиницаНоменклатуры)));
	Строка.Вставить("Цена", Выборка.Цена);
	Строка.Вставить("ПроцентСкидки", Выборка.ПроцентСкидки);
	Строка.Вставить("Сумма", Выборка.Сумма);
	Строка.Вставить("СтавкаНДС", СокрЛП(Выборка.СтавкаНДС));
	Строка.Вставить("СуммаНДС", Выборка.СуммаНДС);
	ЦенаБезНДС = ?(Количество = 0, 0, Окр(СуммаБезНДС / Количество, РазрядностьЦены()));
	Строка.Вставить("ЦенаБезНДС", ЦенаБезНДС);
	Строка.Вставить("СуммаБезНДС", СуммаБезНДС);
	Строка.Вставить("СуммаСкидки", Выборка.СуммаСкидки);
	Группа = Группы[Выборка.ДокументГруппы];
	Строка.Вставить("Группа", ?(Группа = Неопределено, "", Группа));
	Возврат Строка;
КонецФункции

Процедура ДобавитьКолонкуСтрок(Колонки, Поле, Выражение, Константа)
	Колонка = Новый Структура;
	Колонка.Вставить("Поле", Поле);
	Колонка.Вставить("Выражение", Выражение);
	Колонка.Вставить("Константа", Константа);
	Колонки.Добавить(Колонка);
КонецПроцедуры

Функция РазрядностьЦены()
	Возврат 2;
КонецФункции

Функция СтрокиПоГруппам(Строки)
	// Строки без документа отгрузки - первыми, затем группы подряд в порядке первого появления (как сортировка по BL
	// прежней Facture): заголовок группы печатается при смене группы, и строка без отгрузки не должна оказаться под
	// чужим BL (ревью кода фазы 3, P2). Внутри группы - порядок табличных частей и строк.
	Группы = Новый Массив;
	ПоГруппам = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		СтрокиГруппы = ПоГруппам[Строка.Группа];
		Если СтрокиГруппы = Неопределено Тогда
			СтрокиГруппы = Новый Массив;
			ПоГруппам.Вставить(Строка.Группа, СтрокиГруппы);
			Если ПустаяСтрока(Строка.Группа) Тогда
				Группы.Вставить(0, Строка.Группа);
			Иначе
				Группы.Добавить(Строка.Группа);
			КонецЕсли;
		КонецЕсли;
		СтрокиГруппы.Добавить(Строка);
	КонецЦикла;
	Результат = Новый Массив;
	Для Каждого Группа Из Группы Цикл
		Для Каждого Строка Из ПоГруппам[Группа] Цикл
			Результат.Добавить(Строка);
			Строка.НомерСтроки = Результат.Количество();
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПредставленияГрупп(ДокументыГрупп)
	// Номер и дата документов отгрузки - запросом на каждый вид документа, без разыменования составного поля.
	ПоВидам = Новый Соответствие;
	Для Каждого Документ Из ДокументыГрупп Цикл
		Если Не ЗначениеЗаполнено(Документ) Тогда
			Продолжить;
		КонецЕсли;
		ИмяВида = Документ.Метаданные().ПолноеИмя();
		СсылкиВида = ПоВидам[ИмяВида];
		Если СсылкиВида = Неопределено Тогда
			СсылкиВида = Новый Массив;
			ПоВидам.Вставить(ИмяВида, СсылкиВида);
		КонецЕсли;
		Если СсылкиВида.Найти(Документ) = Неопределено Тогда
			СсылкиВида.Добавить(Документ);
		КонецЕсли;
	КонецЦикла;
	Представления = Новый Соответствие;
	Для Каждого Вид Из ПоВидам Цикл
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Вид.Значение, "Номер, Дата");
		Для Каждого Документ Из Реквизиты Цикл
			Представления.Вставить(Документ.Ключ, ПредставлениеГруппы(Документ.Значение.Номер, Документ.Значение.Дата));
		КонецЦикла;
	КонецЦикла;
	Возврат Представления;
КонецФункции

Функция ПредставлениеГруппы(Номер, Дата)
	// Как строка «BL:» прежней Facture.
	Возврат "BL: " + РаботаСДокументами.СформироватьЦифровойНомер(Номер) + "/" + Формат(Дата, "ДФ=yy") + " "
		+ Формат(Дата, "ДФ=dd/MM/yyyy");
КонецФункции

Функция КарточкаСтороны(Владелец, Дата, Кэш)
	Ключ = Строка(Владелец.УникальныйИдентификатор()) + Формат(Дата, "ДФ=yyyyMMdd");
	Карточка = ?(Кэш = Неопределено, Неопределено, Кэш[Ключ]);
	Если Карточка = Неопределено Тогда
		Карточка = Справочники.Контрагенты.ПолучитьКарточку(Владелец, Дата);
		Карточка.Вставить("КодыДляПечати", КодыИзКарточки(Владелец, Карточка));
		Если Кэш <> Неопределено Тогда
			Кэш.Вставить(Ключ, Карточка);
		КонецЕсли;
	КонецЕсли;
	Возврат Карточка;
КонецФункции

Функция КодыИзКарточки(Владелец, Карточка)
	// IF и RC прежний «Счёт» печатал из реквизитов справочника, остальные формы - из карточки: пустое значение
	// карточки берётся из справочника.
	Коды = ПустыеКоды();
	Для Каждого Код Из ПечатныеФормы.МеткиКодов() Цикл
		Коды[Код.Имя] = РеквизитКарточки(Карточка, Код.Имя);
	КонецЦикла;
	Если ЗначениеЗаполнено(Владелец) И (ПустаяСтрока(Коды.NIF) Или ПустаяСтрока(Коды.RC)) Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Владелец, "NIF, RC");
		Если ПустаяСтрока(Коды.NIF) Тогда
			Коды.NIF = СокрЛП(Реквизиты.NIF);
		КонецЕсли;
		Если ПустаяСтрока(Коды.RC) Тогда
			Коды.RC = СокрЛП(Реквизиты.RC);
		КонецЕсли;
	КонецЕсли;
	Возврат Коды;
КонецФункции

Функция ПустыеКоды()
	Коды = Новый Структура;
	Для Каждого Код Из ПечатныеФормы.МеткиКодов() Цикл
		Коды.Вставить(Код.Имя, "");
	КонецЦикла;
	Возврат Коды;
КонецФункции

Функция БанкИзКарточки(Карточка)
	Банк = Новый Структура("Банк, НомерСчета, БИК", "", "", "");
	// Имена полей банковских счетов задаёт Справочники.Контрагенты.ПолучитьКарточку.
	// BSLLS:YoLetterUsage-off
	Для Каждого Счет Из Карточка.БанковскиеСчета Цикл
		Если Счет.БанковскийСчёт = Карточка.БанковскийСчётОсновной Тогда
			Банк.Банк = СокрЛП(Счет.Банк);
			Банк.НомерСчета = СокрЛП(Счет.НомерСчёта);
			Банк.БИК = СокрЛП(Счет.БИК);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// BSLLS:YoLetterUsage-on
	Возврат Банк;
КонецФункции

Функция ВалютаПечати(Валюта, ВВалюте)
	// Валюта документа: в валюте - её код, иначе основная (как РаботаСВалютами.ВалютаИКурсОбъекта).
	Если ВВалюте = Ложь Или Не ЗначениеЗаполнено(Валюта) Тогда
		Возврат РаботаСВалютами.ОсновнаяВалюта();
	КонецЕсли;
	Возврат Валюта;
КонецФункции

Функция ЧислоИлиНоль(Значение)
	// Итоги пустых выборок приходят как Неопределено или NULL.
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);
КонецФункции

Процедура ДобавитьКлюч(Структура, Ключ, Значение)
	Если Не Структура.Свойство(Ключ) Тогда
		Структура.Вставить(Ключ, Значение);
	КонецЕсли;
КонецПроцедуры

Функция НаименованиеИзКарточки(Карточка)
	Возврат СокрЛП(?(ПустаяСтрока(Карточка.НаименованиеПолное), Карточка.Наименование, Карточка.НаименованиеПолное));
КонецФункции

Функция РеквизитКарточки(Карточка, Имя)
	Значение = Неопределено;
	Карточка.Реквизиты.Свойство(Имя, Значение);
	Возврат СокрЛП(Значение);
КонецФункции

Функция ЕстьКарточкаСтороны(Сторона)
	// Карточку (реквизиты, коды, руководители) ведут контрагенты и организации; у физического лица её нет.
	Возврат ТипЗнч(Сторона) = Тип("СправочникСсылка.Контрагенты") Или ТипЗнч(Сторона) = Тип("СправочникСсылка.Организации");
КонецФункции

Функция ДанныеСтороныБезКарточки(Наименование, Договор)
	Результат = Новый Структура;
	Результат.Вставить("КлиентНаименование", СокрЛП(Наименование));
	Результат.Вставить("КлиентРеквизиты", "");
	Результат.Вставить("КлиентДоговор", ?(ЗначениеЗаполнено(Договор), СокрЛП(Договор), ""));
	Результат.Вставить("КлиентКоды", ПустыеКоды());
	Результат.Вставить("КлиентАдрес", "");
	Результат.Вставить("КлиентТелефоны", "");
	Результат.Вставить("КлиентКод", "");
	Результат.Вставить("КлиентАдресДоставки", "");
	Возврат Результат;
КонецФункции

Функция КарточкаПодписанта(Организация, Дата, Кэш)
	// Ответственные - только по уставу, как прежний акт сверки: своя карточка, а не общая карточка стороны.
	Ключ = "Устав" + Строка(Организация.УникальныйИдентификатор()) + Формат(Дата, "ДФ=yyyyMMdd");
	Карточка = Кэш[Ключ];
	Если Карточка = Неопределено Тогда
		Карточка = Справочники.Контрагенты.ПолучитьКарточку(Организация, Дата, Истина);
		Кэш.Вставить(Ключ, Карточка);
	КонецЕсли;
	Возврат Карточка;
КонецФункции

Функция ПредставлениеЗначения(Значение)
	Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(Строка(Значение)), "");
КонецФункции

Функция ДвоичныеДанныеКартинки(Хранилище)
	Значение = ?(ТипЗнч(Хранилище) = Тип("ХранилищеЗначения"), Хранилище.Получить(), Неопределено);
	Если ТипЗнч(Значение) = Тип("Картинка") Тогда
		Значение = Значение.ПолучитьДвоичныеДанные();
	КонецЕсли;
	Возврат ?(ТипЗнч(Значение) = Тип("ДвоичныеДанные"), Значение, Неопределено);
КонецФункции

Функция СтрокиСверкиДляПечати(Строки)
	// В данных печати - только то, что печатается: регистратор - ключ сопоставления, не данные формы.
	Результат = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		СтрокаПечати = Новый Структура("Дата, Документ, Дебет, Кредит, НДС");
		ЗаполнитьЗначенияСвойств(СтрокаПечати, Строка);
		Результат.Добавить(СтрокаПечати);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОборотыСверки(Строки)
	Обороты = Новый Структура("Дебет, Кредит", 0, 0);
	Для Каждого Строка Из Строки Цикл
		Обороты.Дебет = Обороты.Дебет + Строка.Дебет;
		Обороты.Кредит = Обороты.Кредит + Строка.Кредит;
	КонецЦикла;
	Возврат Обороты;
КонецФункции

Функция НДСПоСтавкам(Строки)
	ИмяСтавки = "Ставка";
	Ставки = Новый ТаблицаЗначений;
	Ставки.Колонки.Добавить(ИмяСтавки, Новый ОписаниеТипов("Строка"));
	Ставки.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Строки Цикл
		Для Каждого НДС Из Строка.НДС Цикл
			ЗаполнитьЗначенияСвойств(Ставки.Добавить(), НДС);
		КонецЦикла;
	КонецЦикла;
	Ставки.Свернуть(ИмяСтавки, "Сумма");
	Ставки.Сортировать(ИмяСтавки);
	Результат = Новый Массив;
	Для Каждого Ставка Из Ставки Цикл
		НДС = Новый Структура("Ставка, Сумма");
		ЗаполнитьЗначенияСвойств(НДС, Ставка);
		Результат.Добавить(НДС);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция РасхожденияСверки(Сверка)
	// Построчно по документу-регистратору (раздел 12.2 плана): нетто-оборотами взаимно компенсирующиеся расхождения не
	// видны. Строка без регистратора не сопоставляется ни с чем и всегда попадает в расхождения: ни пустая ссылка, ни
	// представление (у возвратов одного дня оно совпадает) не должны склеивать разные документы.
	ПоДокументам = Новый Соответствие;
	Порядок = Новый Массив;
	ДобавитьСтрокиРасхождений(ПоДокументам, Порядок, Сверка.Строки, Ложь);
	ДобавитьСтрокиРасхождений(ПоДокументам, Порядок, Сверка.СтрокиКонтрагента, Истина);
	Результат = Новый Массив;
	Для Каждого Ключ Из Порядок Цикл
		Запись = ПоДокументам[Ключ];
		// Данные контрагента зеркальные: его дебет - наш кредит.
		Совпало = Запись.Дебет = Запись.КредитКонтрагента И Запись.Кредит = Запись.ДебетКонтрагента;
		Если Запись.БезДокумента Или Не Совпало Тогда
			Запись.Удалить("БезДокумента");
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ДобавитьСтрокиРасхождений(ПоДокументам, Порядок, Строки, Контрагента)
	Для Каждого Строка Из Строки Цикл
		БезДокумента = Не ЗначениеЗаполнено(Строка.Регистратор);
		Ключ = ?(БезДокумента, Новый УникальныйИдентификатор, Строка.Регистратор);
		Запись = ПоДокументам[Ключ];
		Если Запись = Неопределено Тогда
			Запись = Новый Структура("Дебет, Кредит, ДебетКонтрагента, КредитКонтрагента");
			Для Каждого Сумма Из Запись Цикл
				Запись[Сумма.Ключ] = 0;
			КонецЦикла;
			Запись.Вставить("Дата", Строка.Дата);
			Запись.Вставить("Документ", Строка.Документ);
			Запись.Вставить("БезДокумента", БезДокумента);
			ПоДокументам.Вставить(Ключ, Запись);
			Порядок.Добавить(Ключ);
		КонецЕсли;
		Если ПустаяСтрока(Запись.Документ) Тогда
			Запись.Документ = Строка.Документ;
		КонецЕсли;
		Если Контрагента Тогда
			Запись.ДебетКонтрагента = Запись.ДебетКонтрагента + Строка.Дебет;
			Запись.КредитКонтрагента = Запись.КредитКонтрагента + Строка.Кредит;
		Иначе
			Запись.Дебет = Запись.Дебет + Строка.Дебет;
			Запись.Кредит = Запись.Кредит + Строка.Кредит;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьКод(Строка, Подпись, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Строка, Подпись + " " + Значение, " · ");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Вывод

Процедура Вывести(ТабличныйДокумент, Макет, Источник, Вид, КодЯзыка)
	Данные = ПривестиДанные(Источник.Данные);
	Если Вид.Компоновка = КомпоновкаКП() Тогда
		ВывестиКП(ТабличныйДокумент, Макет, Данные, Источник.Плашка, Вид, КодЯзыка);
	ИначеЕсли Вид.Компоновка = КомпоновкаСверка() Тогда
		ВывестиСверку(ТабличныйДокумент, Макет, Данные, Вид, КодЯзыка);
	ИначеЕсли Вид.Компоновка = КомпоновкаКвитанция() Тогда
		ВывестиКвитанцию(ТабличныйДокумент, Макет, Данные, Вид, КодЯзыка);
	Иначе
		ВывестиФактуру(ТабличныйДокумент, Макет, Данные, Вид, КодЯзыка);
	КонецЕсли;
КонецПроцедуры

Процедура ВывестиКП(ТабличныйДокумент, Макет, Данные, Плашка, Вид, КодЯзыка)
	Области = ОбщиеОбласти(Макет, Вид);
	ОбластьСтороны = Макет.ПолучитьОбласть("Стороны");
	ОбластьУсловия = Макет.ПолучитьОбласть("Условия");
	ОбластьПодпись = Макет.ПолучитьОбласть("Подпись");

	Шапка = Данные.Шапка;
	Картинки = КартинкиДанных(Данные);
	ЗаполнитьШапкуИЗаголовок(Области, Данные, Вид.Заголовок, Плашка, Картинки, КодЯзыка);
	ОбластьСтороны.Параметры.ПодписьСтороны = Вид.ПодписьСтороны;
	ОбластьСтороны.Параметры.ПодписьКонтакта = Вид.ПодписьКонтакта;
	ОбластьСтороны.Параметры.Заполнить(Данные.Клиент);
	ОбластьСтороны.Параметры.КлиентРеквизиты = РеквизитыКлиентаДляПечати(Данные.Клиент, КодЯзыка);
	ОбластьСтороны.Параметры.Менеджер = Шапка.Менеджер;
	ОбластьСтороны.Параметры.УсловияКратко = УсловияКратко(Шапка, КодЯзыка);

	ТабличныйДокумент.Вывести(Области.Шапка);
	ТабличныйДокумент.Вывести(Области.Заголовок);
	ТабличныйДокумент.Вывести(ОбластьСтороны);
	ВывестиСтроки(ТабличныйДокумент, Данные, Области, Вид, КодЯзыка);

	Если Вид.Таблица <> ВариантБезЦен() Тогда
		ВывестиИтоги(ТабличныйДокумент, Данные, Области, Вид, КодЯзыка);
	КонецЕсли;

	Если ЗначениеЗаполнено(Шапка.Комментарий) Тогда
		ОбластьУсловия.Параметры.Условия = Шапка.Комментарий;
		ВывестиБлок(ТабличныйДокумент, ОбластьУсловия, Области);
	КонецЕсли;

	ОбластьПодпись.Параметры.ПодписьМенеджер = Шапка.Менеджер;
	ОбластьПодпись.Параметры.ПодписьОрганизация = Данные.Организация.ОрганизацияНаименование;
	ПечатныеФормы.ЗаполнитьРисункиКартинками(ОбластьПодпись, Картинки);
	ВывестиБлок(ТабличныйДокумент, ОбластьПодпись, Области);

	ЗавершитьФорму(ТабличныйДокумент, Области);
КонецПроцедуры

Процедура ВывестиФактуру(ТабличныйДокумент, Макет, Данные, Вид, КодЯзыка)
	// Товарные формы: Facture, Proforma, BL, Avoir, акт. Отличия задаёт описание вида (ОписаниеВида).
	Области = ОбщиеОбласти(Макет, Вид);
	ОбластьСтороны = Макет.ПолучитьОбласть("СтороныФактуры");
	ОбластьСведения = Макет.ПолучитьОбласть("СведенияДокумента");
	ОбластьБлок = Макет.ПолучитьОбласть("БлокТекста");
	ОбластьУсловия = Макет.ПолучитьОбласть("Условия");

	Шапка = Данные.Шапка;
	Покупка = Шапка.ОрганизацияПокупатель;
	Картинки = КартинкиДанных(Данные);
	Заголовок = ?(Покупка, Вид.ЗаголовокПокупки, Вид.Заголовок);
	ЗаполнитьШапкуИЗаголовок(Области, Данные, Заголовок, "", Картинки, КодЯзыка);

	// Продавец слева, покупатель справа; у счёта-фактуры поставщика и акта поставщика продавец - поставщик (разделы
	// 10.3 и 11.3 плана).
	СторонаОрганизация = СторонаОрганизации(Данные.Организация, КодЯзыка);
	СторонаКлиент = СторонаКлиента(Данные.Клиент, КодЯзыка, Вид.АдресДоставки);
	Сторона1 = ?(Покупка, СторонаКлиент, СторонаОрганизация);
	Сторона2 = ?(Покупка, СторонаОрганизация, СторонаКлиент);
	ОбластьСтороны.Параметры.ПодписьСтороны1 = Вид.ПодписьПродавца;
	ОбластьСтороны.Параметры.ПодписьСтороны2 = Вид.ПодписьПокупателя;
	ЗаполнитьСторону(ОбластьСтороны, "Сторона1", Сторона1);
	ЗаполнитьСторону(ОбластьСтороны, "Сторона2", Сторона2);

	ТабличныйДокумент.Вывести(Области.Шапка);
	ТабличныйДокумент.Вывести(Области.Заголовок);
	ТабличныйДокумент.Вывести(ОбластьСтороны);
	Сведения = СведенияДокумента(Данные, КодЯзыка);
	Если ЗначениеЗаполнено(Сведения) Тогда
		ОбластьСведения.Параметры.Сведения = Сведения;
		ТабличныйДокумент.Вывести(ОбластьСведения);
	КонецЕсли;
	ВывестиСтроки(ТабличныйДокумент, Данные, Области, Вид, КодЯзыка);
	Если Не Вид.БезЦен Тогда
		ВывестиИтоги(ТабличныйДокумент, Данные, Области, Вид, КодЯзыка);
	КонецЕсли;
	Если Вид.Оплаты И Данные.Оплаты <> Неопределено Тогда
		ВывестиОплаты(ТабличныйДокумент, Макет, Данные, Области, КодЯзыка);
	КонецЕсли;

	Если ЗначениеЗаполнено(Шапка.УсловияОплаты) Тогда
		ОбластьБлок.Параметры.ПодписьБлока = НСтр("ru = 'СПОСОБ ОПЛАТЫ'; fr = 'MODE DE RÈGLEMENT';
			|en = 'PAYMENT METHOD'; es = 'FORMA DE PAGO'", КодЯзыка);
		ОбластьБлок.Параметры.ТекстБлока = Шапка.УсловияОплаты;
		ВывестиБлок(ТабличныйДокумент, ОбластьБлок, Области);
	КонецЕсли;
	Банк = Данные.Организация.Банк;
	Если Вид.БанковскиеРеквизиты И Не Покупка И ЗначениеЗаполнено(Банк.НомерСчета) Тогда
		ОбластьБлок.Параметры.ПодписьБлока = НСтр("ru = 'БАНКОВСКИЕ РЕКВИЗИТЫ'; fr = 'COORDONNÉES BANCAIRES';
			|en = 'BANK DETAILS'; es = 'DATOS BANCARIOS'", КодЯзыка);
		ОбластьБлок.Параметры.ТекстБлока = БанковскиеРеквизиты(Банк, КодЯзыка);
		ВывестиБлок(ТабличныйДокумент, ОбластьБлок, Области);
	КонецЕсли;
	Если ЗначениеЗаполнено(Вид.ТекстУсловий) Тогда
		ОбластьУсловия.Параметры.Условия = ТекстОднойСтрокой(Вид.ТекстУсловий);
		ВывестиБлок(ТабличныйДокумент, ОбластьУсловия, Области);
	КонецЕсли;

	Если Вид.СведенияПечати Тогда
		ОбластьПечати = Макет.ПолучитьОбласть("СведенияПечати");
		ОбластьПечати.Параметры.СведенияПечати = СведенияПечати(Шапка.Автор, КодЯзыка);
		ВывестиБлок(ТабличныйДокумент, ОбластьПечати, Области);
	КонецЕсли;
	Если Вид.Подписи = ПодписиСторон() Тогда
		Стороны = СтороныПодписей(Сторона1, Сторона2, Вид.ПодписьЛевая, Вид.ПодписьПравая);
		ВывестиПодписиСторон(ТабличныйДокумент, Макет, Данные, Области, Вид, Стороны);
	Иначе
		ВывестиПодписьФактуры(ТабличныйДокумент, Макет, Данные, Области, КодЯзыка);
	КонецЕсли;

	ЗавершитьФорму(ТабличныйДокумент, Области);
КонецПроцедуры

Процедура ВывестиПодписьФактуры(ТабличныйДокумент, Макет, Данные, Области, КодЯзыка)
	// Печать организации ставится только на её собственный документ, не на счёт поставщика.
	Если Данные.Шапка.ОрганизацияПокупатель Тогда
		Возврат;
	КонецЕсли;
	ОбластьПодпись = Макет.ПолучитьОбласть("ПодписьФактуры");
	ОбластьПодпись.Параметры.ПодписьПечати = НСтр("ru = 'Печать и подпись'; fr = 'Cachet et signature';
		|en = 'Stamp and signature'; es = 'Sello y firma'", КодЯзыка);
	ОбластьПодпись.Параметры.ПодписьОрганизация = Данные.Организация.ОрганизацияНаименование;
	КартинкиПодписи = Новый Соответствие;
	КартинкиПодписи.Вставить("ПечатьФактуры", Данные.ПечатьОрганизации);
	ПечатныеФормы.ЗаполнитьРисункиКартинками(ОбластьПодпись, КартинкиПодписи);
	ВывестиБлок(ТабличныйДокумент, ОбластьПодпись, Области);
КонецПроцедуры

Процедура ВывестиОплаты(ТабличныйДокумент, Макет, Данные, Области, КодЯзыка)
	// Как подвал прежних BL и Avoir: «вид оплаты: сумма» по четырём видам и долг клиента до документа.
	Оплаты = Данные.Оплаты;
	// Суммы оплат - в основной валюте (регистр расчётов), не в валюте документа.
	КодВалюты = ?(Оплаты.Свойство("КодВалюты"), Оплаты.КодВалюты, Данные.КодВалюты);
	ПодписьПрочие = НСтр("ru = 'Прочее'; fr = 'Autres'; en = 'Other'; es = 'Otros'", КодЯзыка);
	Область = Макет.ПолучитьОбласть("ОплатыДокумента");
	Область.Параметры.ОплатаНаличные = СтрокаОплаты(Оплаты.ПодписьНаличные, Оплаты.Наличные, КодВалюты, КодЯзыка);
	Область.Параметры.ОплатаЧеком = СтрокаОплаты(Оплаты.ПодписьЧеком, Оплаты.Чеком, КодВалюты, КодЯзыка);
	Область.Параметры.ОплатаПрочие = СтрокаОплаты(ПодписьПрочие, Оплаты.Прочие, КодВалюты, КодЯзыка);
	Область.Параметры.ОплатаКредит = СтрокаОплаты(Оплаты.ПодписьКредит, Оплаты.Кредит, КодВалюты, КодЯзыка);
	Область.Параметры.ДолгКлиента = ФорматСуммы(Оплаты.Долг, КодВалюты, КодЯзыка);
	ВывестиБлок(ТабличныйДокумент, Область, Области);
КонецПроцедуры

Функция ТекстОднойСтрокой(Текст)
	// Постоянный текст вида записан многострочным литералом НСтр: переносы литерала - не абзацы, ячейка переносит сама.
	Возврат СтрЗаменить(Текст, Символы.ПС, " ");
КонецФункции

Функция СтрокаОплаты(Подпись, Сумма, КодВалюты, КодЯзыка)
	Возврат Подпись + ": " + ФорматСуммы(Сумма, КодВалюты, КодЯзыка);
КонецФункции

Функция СведенияПечати(Автор, КодЯзыка)
	// Как подвал прежних BL и Avoir: дата и время печати и кто выписал документ.
	МоментПечати = ТекущаяДатаСеанса();
	Локализация = ПечатныеФормы.ЛокализацияФормата(КодЯзыка);
	Шаблон = НСтр("ru = 'Напечатано %1 в %2'; fr = 'Imprimé le %1 à %2'; en = 'Printed on %1 at %2';
		|es = 'Impreso el %1 a las %2'", КодЯзыка);
	Текст = СтрШаблон(Шаблон, ФорматДаты(МоментПечати, КодЯзыка), Формат(МоментПечати, "ДЛФ=T; " + Локализация));
	Если ЗначениеЗаполнено(Автор) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Текст, НСтр("ru = 'Выписал: '; fr = 'Établi par : ';
			|en = 'Issued by: '; es = 'Emitido por: '", КодЯзыка) + Автор, " · ");
	КонецЕсли;
	Возврат Текст;
КонецФункции

Процедура ВывестиПодписиСторон(ТабличныйДокумент, Макет, Данные, Области, Вид, Стороны)
	// Подписи сторон: у BL, Avoir и бланка заказа - транспорт и клиент без наименований, у акта - исполнитель и заказчик
	// с наименованиями, у акта сверки - стороны с подписантами, у квитанции - кассир и плательщик. Печать организации -
	// по виду и только на её собственном документе (не у акта поставщика); факсимиле - у акта сверки с печатью.
	Область = Макет.ПолучитьОбласть("ПодписиСторон");
	Область.Параметры.ТекстПодписей = ТекстОднойСтрокой(Вид.ТекстПодписей);
	Область.Параметры.ПодписьЛевая = Стороны.ПодписьЛевая;
	Область.Параметры.ПодписьПравая = Стороны.ПодписьПравая;
	Если Вид.НаименованияВПодписях Тогда
		Область.Параметры.НаименованиеЛевое = НаименованиеВПодписи(Стороны.Сторона1);
		Область.Параметры.НаименованиеПравое = НаименованиеВПодписи(Стороны.Сторона2);
	КонецЕсли;
	КартинкиПодписи = Новый Соответствие;
	Если Вид.ПечатьВПодписях И Не Данные.Шапка.ОрганизацияПокупатель Тогда
		КартинкиПодписи.Вставить("ПечатьПодписей", Данные.ПечатьОрганизации);
	КонецЕсли;
	Если Вид.ПодписьВПодписях Тогда
		КартинкиПодписи.Вставить("ПодписьПодписей", Данные.ПодписьРуководителя);
	КонецЕсли;
	ПечатныеФормы.ЗаполнитьРисункиКартинками(Область, КартинкиПодписи);
	ВывестиБлок(ТабличныйДокумент, Область, Области);
КонецПроцедуры

Функция СтороныПодписей(Сторона1, Сторона2, ПодписьЛевая, ПодписьПравая)
	Стороны = Новый Структура("Сторона1, Сторона2", Сторона1, Сторона2);
	Стороны.Вставить("ПодписьЛевая", ПодписьЛевая);
	Стороны.Вставить("ПодписьПравая", ПодписьПравая);
	Возврат Стороны;
КонецФункции

Функция НаименованиеВПодписи(Сторона)
	Наименование = Сторона.Наименование;
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Наименование, Сторона.Подписант, Символы.ПС);
	Возврат Наименование;
КонецФункции

Функция БазовыеОбласти(Макет)
	// Области, которые нужны любой компоновке: шапка, заголовок, подвал реквизитов и пустая строка добивки страницы.
	Области = Новый Структура;
	Области.Вставить("Шапка", Макет.ПолучитьОбласть("Шапка"));
	Области.Вставить("Заголовок", Макет.ПолучитьОбласть("Заголовок"));
	Области.Вставить("Подвал", Макет.ПолучитьОбласть("ПодвалРеквизитов"));
	Области.Вставить("ПустаяСтрока", Макет.ПолучитьОбласть("ПустаяСтрока"));
	Возврат Области;
КонецФункции

Функция БлокДанных(Данные, Имя, Вид)
	// Блок акта сверки или квитанции пишут только их адаптеры: данные другого документа печатать этим видом нельзя.
	Блок = Данные[Имя];
	Если Блок = Неопределено Тогда
		ШаблонОшибки = НСтр("ru = 'В данных печати нет блока %1 - форму «%2» печатает только её документ.';
			|fr = 'Les données d''impression ne contiennent pas le bloc %1 - le formulaire « %2 » s''imprime uniquement
			|depuis son document.'; en = 'The print data lack the %1 block - the «%2» form is printed only from its
			|document.'; es = 'Los datos de impresión no contienen el bloque %1 - el formulario «%2» solo se imprime desde
			|su documento.'");
		ВызватьИсключение СтрШаблон(ТекстОднойСтрокой(ШаблонОшибки), Имя, Вид.Представление);
	КонецЕсли;
	Возврат Блок;
КонецФункции

Процедура ВывестиСтороны(ТабличныйДокумент, Макет, Подпись1, Подпись2, Сторона1, Сторона2)
	ОбластьСтороны = Макет.ПолучитьОбласть("СтороныФактуры");
	ОбластьСтороны.Параметры.ПодписьСтороны1 = Подпись1;
	ОбластьСтороны.Параметры.ПодписьСтороны2 = Подпись2;
	ЗаполнитьСторону(ОбластьСтороны, "Сторона1", Сторона1);
	ЗаполнитьСторону(ОбластьСтороны, "Сторона2", Сторона2);
	ТабличныйДокумент.Вывести(ОбластьСтороны);
КонецПроцедуры

Процедура ВывестиСведения(ТабличныйДокумент, Макет, Данные, КодЯзыка)
	Сведения = СведенияДокумента(Данные, КодЯзыка);
	Если ЗначениеЗаполнено(Сведения) Тогда
		ОбластьСведения = Макет.ПолучитьОбласть("СведенияДокумента");
		ОбластьСведения.Параметры.Сведения = Сведения;
		ТабличныйДокумент.Вывести(ОбластьСведения);
	КонецЕсли;
КонецПроцедуры

Процедура ВывестиСверку(ТабличныйДокумент, Макет, Данные, Вид, КодЯзыка)
	// Акт сверки (раздел 12.3 плана): стороны, вступление с периодом, таблица по нашим данным с сальдо и оборотами,
	// таблица по данным контрагента, внесённым в документ, НДС по ставкам, долг и результат сверки, подписи сторон.
	Сверка = БлокДанных(Данные, "Сверка", Вид);
	Области = БазовыеОбласти(Макет);
	ЗаполнитьШапкуИЗаголовок(Области, Данные, Вид.Заголовок, "", КартинкиДанных(Данные), КодЯзыка);
	Сторона1 = СторонаОрганизации(Данные.Организация, КодЯзыка);
	Сторона1.Подписант = ПодписантАкта(Сверка.ОрганизацияДолжность, Сверка.ОрганизацияРуководитель, КодЯзыка);
	Сторона2 = СторонаКлиента(Данные.Клиент, КодЯзыка);
	Сторона2.Подписант = ПодписантАкта(Сверка.КонтрагентДолжность, Сверка.КонтрагентРуководитель, КодЯзыка);

	ТабличныйДокумент.Вывести(Области.Шапка);
	ТабличныйДокумент.Вывести(Области.Заголовок);
	ВывестиСтороны(ТабличныйДокумент, Макет, Вид.ПодписьПродавца, Вид.ПодписьПокупателя, Сторона1, Сторона2);
	ВывестиСведения(ТабличныйДокумент, Макет, Данные, КодЯзыка);
	Вступление = ВступлениеАктаСверки(Данные, Сверка, Сторона1, Сторона2, КодЯзыка);
	ВывестиТекстСверки(ТабличныйДокумент, Макет, Области, Вступление);

	ОбластьГруппа = Макет.ПолучитьОбласть("ГруппаСтрок");
	Если Сверка.ЕстьДанныеКонтрагента Тогда
		ОбластьГруппа.Параметры.Группа = СтрШаблон(НСтр("ru = 'ПО ДАННЫМ %1'; fr = 'SELON LES DONNÉES DE %1';
			|en = 'ACCORDING TO %1'; es = 'SEGÚN LOS DATOS DE %1'", КодЯзыка), Сторона1.Наименование);
		ВывестиБлок(ТабличныйДокумент, ОбластьГруппа, Области);
	КонецЕсли;
	ВывестиТаблицуСверки(ТабличныйДокумент, Макет, Области, Вид.Таблица, Сверка.Строки, Сверка, КодЯзыка);
	Если Сверка.ЕстьДанныеКонтрагента Тогда
		// Данные контрагента внесены в документ (штатно - зеркалом наших данных), а не подтверждены им: так и подписано.
		ОбластьГруппа.Параметры.Группа = СтрШаблон(НСтр("ru = 'ПО ДАННЫМ %1 (ВНЕСЕНО В ДОКУМЕНТ)';
			|fr = 'SELON LES DONNÉES DE %1 (SAISIES DANS LE DOCUMENT)'; en = 'ACCORDING TO %1 (ENTERED IN THE DOCUMENT)';
			|es = 'SEGÚN LOS DATOS DE %1 (INTRODUCIDOS EN EL DOCUMENTO)'", КодЯзыка), Сторона2.Наименование);
		ВывестиБлок(ТабличныйДокумент, ОбластьГруппа, Области);
		ВывестиТаблицуСверки(ТабличныйДокумент, Макет, Области, ТаблицаСверкиБезНДС(), Сверка.СтрокиКонтрагента,
			Неопределено, КодЯзыка);
	КонецЕсли;

	КодВалюты = Данные.КодВалюты;
	Если Вид.Таблица = ТаблицаСверки() И Сверка.НДСПоСтавкам.Количество() > 0 Тогда
		Ставки = Новый Массив;
		Для Каждого Ставка Из Сверка.НДСПоСтавкам Цикл
			Ставки.Добавить(Ставка.Ставка + ": " + ФорматДенег(Ставка.Сумма, КодЯзыка));
		КонецЦикла;
		Шаблон = НСтр("ru = 'НДС за период по ставкам (%1): %2'; fr = 'TVA de la période par taux (%1) : %2';
			|en = 'VAT for the period by rate (%1): %2'; es = 'IVA del período por tipo (%1): %2'", КодЯзыка);
		ТекстНДС = СтрШаблон(Шаблон, КодВалюты, СтрСоединить(Ставки, "; "));
		ВывестиТекстСверки(ТабличныйДокумент, Макет, Области, ТекстНДС);
	КонецЕсли;
	ВывестиТекстСверки(ТабличныйДокумент, Макет, Области, ДолгПоАктуСверки(Данные, Сверка, Сторона1, Сторона2, КодЯзыка));
	// Пункт 3 - абзацами: длинный список расхождений переносится на новые страницы с подвалом (ревью кода фазы 5, P2).
	Для Каждого Абзац Из РезультатСверки(Сверка, Сторона1, Сторона2, КодЯзыка) Цикл
		ВывестиТекстСверки(ТабличныйДокумент, Макет, Области, Абзац);
	КонецЦикла;

	Стороны = СтороныПодписей(Сторона1, Сторона2, Вид.ПодписьЛевая, Вид.ПодписьПравая);
	ВывестиПодписиСторон(ТабличныйДокумент, Макет, Данные, Области, Вид, Стороны);
	ЗавершитьФорму(ТабличныйДокумент, Области);
КонецПроцедуры

Процедура ВывестиТаблицуСверки(ТабличныйДокумент, Макет, Области, Таблица, Строки, Сальдо, КодЯзыка)
	// Сальдо - Неопределено у таблицы по данным контрагента: начальный остаток документ хранит только по нашим данным.
	// Обороты - по выведенным строкам (те же, что Сверка.Обороты и ОборотыКонтрагента данных печати).
	Суффикс = Сред(Таблица, СтрДлина(ТаблицаСверки()) + 1);
	ОбластьШапки = Макет.ПолучитьОбласть("ШапкаТаблицы" + Таблица);
	ОбластьСтроки = Макет.ПолучитьОбласть("Строка" + Таблица);
	ОбластьИтога = Макет.ПолучитьОбласть("СверкаИтог" + Суффикс);
	ВывестиБлок(ТабличныйДокумент, ОбластьШапки, Области);
	Если Сальдо <> Неопределено Тогда
		ВывестиСальдоСверки(ТабличныйДокумент, ОбластьИтога, Области, Сальдо.НачалоПериода, Сальдо.СальдоНачальное,
			КодЯзыка);
	КонецЕсли;
	СуммаНДС = 0;
	Обороты = Новый Структура("Дебет, Кредит", 0, 0);
	Для Каждого Строка Из Строки Цикл
		Обороты.Дебет = Обороты.Дебет + Строка.Дебет;
		Обороты.Кредит = Обороты.Кредит + Строка.Кредит;
		Значения = Новый Структура;
		Значения.Вставить("Дата", Формат(Строка.Дата, "ДЛФ=D; " + ПечатныеФормы.ЛокализацияФормата(КодЯзыка)));
		Значения.Вставить("Документ", Строка.Документ);
		Значения.Вставить("Дебет", СуммаИлиПусто(Строка.Дебет, КодЯзыка));
		Значения.Вставить("Кредит", СуммаИлиПусто(Строка.Кредит, КодЯзыка));
		НДС = Новый Массив;
		Для Каждого Ставка Из Строка.НДС Цикл
			НДС.Добавить(Ставка.Ставка + ": " + ФорматДенег(Ставка.Сумма, КодЯзыка));
			СуммаНДС = СуммаНДС + Ставка.Сумма;
		КонецЦикла;
		Значения.Вставить("НДС", СтрСоединить(НДС, Символы.ПС));
		// Параметры.Заполнить пропускает колонку НДС, которой нет в таблице без НДС.
		ОбластьСтроки.Параметры.Заполнить(Значения);
		Проверка = Новый Массив;
		Проверка.Добавить(ОбластьСтроки);
		Проверка.Добавить(Области.Подвал);
		Если Не ТабличныйДокумент.ПроверитьВывод(Проверка) Тогда
			НоваяСтраница(ТабличныйДокумент, Области);
			ТабличныйДокумент.Вывести(ОбластьШапки);
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьСтроки);
	КонецЦикла;
	Подпись = НСтр("ru = 'Обороты за период'; fr = 'Mouvements de la période'; en = 'Turnover for the period';
		|es = 'Movimientos del período'", КодЯзыка);
	Дебет = ФорматДенег(Обороты.Дебет, КодЯзыка);
	Кредит = ФорматДенег(Обороты.Кредит, КодЯзыка);
	ВывестиИтогСверки(ТабличныйДокумент, ОбластьИтога, Области, Подпись, Дебет, Кредит, ФорматДенег(СуммаНДС, КодЯзыка));
	Если Сальдо <> Неопределено Тогда
		ВывестиСальдоСверки(ТабличныйДокумент, ОбластьИтога, Области, Сальдо.КонецПериода, Сальдо.СальдоКонечное,
			КодЯзыка);
	КонецЕсли;
КонецПроцедуры

Процедура ВывестиСальдоСверки(ТабличныйДокумент, ОбластьИтога, Области, Дата, Сальдо, КодЯзыка)
	// Сальдо больше нуля - долг контрагента (дебет), меньше - долг организации (кредит), как в прежнем акте.
	Шаблон = НСтр("ru = 'Сальдо на %1'; fr = 'Solde au %1'; en = 'Balance as of %1'; es = 'Saldo al %1'", КодЯзыка);
	Подпись = СтрШаблон(Шаблон, ФорматДаты(Дата, КодЯзыка));
	Дебет = ?(Сальдо >= 0, ФорматДенег(Сальдо, КодЯзыка), "");
	Кредит = ?(Сальдо < 0, ФорматДенег(-Сальдо, КодЯзыка), "");
	ВывестиИтогСверки(ТабличныйДокумент, ОбластьИтога, Области, Подпись, Дебет, Кредит, "");
КонецПроцедуры

Процедура ВывестиИтогСверки(ТабличныйДокумент, ОбластьИтога, Области, Подпись, Дебет, Кредит, НДС)
	Значения = Новый Структура("ИтогДебет, ИтогКредит, ИтогНДС", Дебет, Кредит, НДС);
	Значения.Вставить("ПодписьИтога", Подпись);
	// Параметры.Заполнить пропускает ИтогНДС, которого нет в итоге таблицы без НДС.
	ОбластьИтога.Параметры.Заполнить(Значения);
	ВывестиБлок(ТабличныйДокумент, ОбластьИтога, Области);
КонецПроцедуры

Процедура ВывестиТекстСверки(ТабличныйДокумент, Макет, Области, Текст)
	Область = Макет.ПолучитьОбласть("СверкаТекст");
	Область.Параметры.ТекстСверки = Текст;
	ВывестиБлок(ТабличныйДокумент, Область, Области);
КонецПроцедуры

Функция ПодписантАкта(Должность, Руководитель, КодЯзыка)
	Подписант = Должность;
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Подписант, Руководитель, " ");
	// Место печати - как в прежнем акте.
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Подписант, НСтр("ru = 'М.П.'; fr = 'Cachet'; en = 'Seal'; es = 'Sello'",
		КодЯзыка), Символы.ПС);
	Возврат Подписант;
КонецФункции

Функция СторонаАкта(Должность, Наименование, Руководитель)
	// «Должность Наименование ФИО» - как вступление прежнего акта; пустые части пропускаются.
	Текст = Должность;
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Текст, Наименование, " ");
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Текст, Руководитель, " ");
	Возврат Текст;
КонецФункции

Функция ВступлениеАктаСверки(Данные, Сверка, Сторона1, Сторона2, КодЯзыка)
	Вступление = НСтр("ru = 'Мы, нижеподписавшиеся, %1, с одной стороны, и %2, с другой стороны, составили настоящий акт
		|сверки в том, что:'; fr = 'Nous, soussignés, %1, d''une part, et %2, d''autre part, avons établi le présent acte
		|de rapprochement attestant que :'; en = 'We, the undersigned, %1, on the one hand, and %2, on the other hand,
		|have drawn up this reconciliation statement to certify that:'; es = 'Nosotros, los abajo firmantes, %1, por una
		|parte, y %2, por otra parte, hemos elaborado la presente acta de conciliación que hace constar que:'", КодЯзыка);
	Период = НСтр("ru = '1. В период с %1 по %2 были осуществлены следующие расчёты (суммы в %3):';
		|fr = '1. Entre le %1 et le %2, les opérations suivantes ont été effectuées (montants en %3) :';
		|en = '1. Between %1 and %2 the following settlements were made (amounts in %3):';
		|es = '1. Entre el %1 y el %2 se realizaron las siguientes operaciones (importes en %3):'", КодЯзыка);
	Сторона1Акта = СторонаАкта(Сверка.ОрганизацияДолжность, Сторона1.Наименование, Сверка.ОрганизацияРуководитель);
	Сторона2Акта = СторонаАкта(Сверка.КонтрагентДолжность, Сторона2.Наименование, Сверка.КонтрагентРуководитель);
	Возврат СтрШаблон(ТекстОднойСтрокой(Вступление), Сторона1Акта, Сторона2Акта) + Символы.ПС
		+ СтрШаблон(ТекстОднойСтрокой(Период), ФорматДаты(Сверка.НачалоПериода, КодЯзыка),
		ФорматДаты(Сверка.КонецПериода, КодЯзыка), Данные.КодВалюты);
КонецФункции

Функция ДолгПоАктуСверки(Данные, Сверка, Сторона1, Сторона2, КодЯзыка)
	// Пункт 2 прежнего акта: чей долг на конец периода, суммой и прописью на языке печати.
	Сальдо = Сверка.СальдоКонечное;
	Дата = ФорматДаты(Сверка.КонецПериода, КодЯзыка);
	Если Сальдо = 0 Тогда
		Возврат СтрШаблон(НСтр("ru = '2. На %1 задолженность отсутствует.';
			|fr = '2. Au %1, il n''existe aucune dette entre les parties.'; en = '2. As of %1, there is no outstanding balance.';
			|es = '2. Al %1 no existe deuda entre las partes.'", КодЯзыка), Дата);
	КонецЕсли;
	Должник = ?(Сальдо > 0, Сторона2.Наименование, Сторона1.Наименование);
	Кредитор = ?(Сальдо > 0, Сторона1.Наименование, Сторона2.Наименование);
	Шаблон = НСтр("ru = '2. Задолженность %1 перед %2 на %3 составляет %4 (%5).';
		|fr = '2. Au %3, la dette de %1 envers %2 s''élève à %4 (%5).'; en = '2. As of %3, %1 owes %2 %4 (%5).';
		|es = '2. Al %3, la deuda de %1 con %2 asciende a %4 (%5).'", КодЯзыка);
	Возврат СтрШаблон(Шаблон, Должник, Кредитор, Дата, ФорматСуммы(Данные.Итоги.Сумма, Данные.КодВалюты, КодЯзыка),
		СуммаПрописьюНаЯзыке(Данные.Итоги, КодЯзыка));
КонецФункции

Функция РезультатСверки(Сверка, Сторона1, Сторона2, КодЯзыка)
	// Пункт 3 никогда не утверждает «расхождений не выявлено» сам (раздел 12.3 плана): табличная часть контрагента
	// штатно заполняется зеркалом наших данных и не доказывает его согласия - согласие подтверждает подпись.
	// Возвращает абзацы: заголовок пункта и по абзацу на расхождение.
	Абзацы = Новый Массив;
	Если Сверка.Расхождения.Количество() = 0 Тогда
		Шаблон = НСтр("ru = '3. Данные приведены по учёту %1; подписание акта %2 подтверждает отсутствие расхождений.';
			|fr = '3. Les données sont établies selon la comptabilité de %1 ; la signature du présent acte par %2 confirme
			|l''absence de divergences.'; en = '3. The data are based on the records of %1; signature of this statement by
			|%2 confirms that there are no discrepancies.'; es = '3. Los datos proceden de la contabilidad de %1; la firma
			|de la presente acta por %2 confirma la ausencia de discrepancias.'", КодЯзыка);
		Абзацы.Добавить(СтрШаблон(ТекстОднойСтрокой(Шаблон), Сторона1.Наименование, Сторона2.Наименование));
		Возврат Абзацы;
	КонецЕсли;
	Абзацы.Добавить(НСтр("ru = '3. Выявлены расхождения:'; fr = '3. Divergences constatées :'; en = '3. Discrepancies found:';
		|es = '3. Discrepancias detectadas:'", КодЯзыка));
	Шаблон = НСтр("ru = '- %1: по данным %2 - дебет %3, кредит %4; по данным %5 - дебет %6, кредит %7';
		|fr = '- %1 : selon %2 - débit %3, crédit %4 ; selon %5 - débit %6, crédit %7';
		|en = '- %1: per %2 - debit %3, credit %4; per %5 - debit %6, credit %7';
		|es = '- %1: según %2 - debe %3, haber %4; según %5 - debe %6, haber %7'", КодЯзыка);
	Для Каждого Расхождение Из Сверка.Расхождения Цикл
		Документ = ФорматДаты(Расхождение.Дата, КодЯзыка);
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Документ, Расхождение.Документ, " ");
		Строка = СтрШаблон(Шаблон, Документ, Сторона1.Наименование, ФорматДенег(Расхождение.Дебет, КодЯзыка),
			ФорматДенег(Расхождение.Кредит, КодЯзыка), Сторона2.Наименование,
			ФорматДенег(Расхождение.ДебетКонтрагента, КодЯзыка), ФорматДенег(Расхождение.КредитКонтрагента, КодЯзыка));
		Абзацы.Добавить(Строка);
	КонецЦикла;
	Возврат Абзацы;
КонецФункции

Функция СуммаИлиПусто(Сумма, КодЯзыка)
	Возврат ?(Сумма = 0, "", ФорматДенег(Сумма, КодЯзыка));
КонецФункции

Процедура ВывестиКвитанцию(ТабличныйДокумент, Макет, Данные, Вид, КодЯзыка)
	// Квитанция (Reçu) приходного и расходного кассового ордера (раздел 12.3 плана): сумма крупно и прописью, реквизиты
	// ордера строками «подпись: значение», подписи кассира и плательщика (получателя), печать организации.
	Квитанция = БлокДанных(Данные, "Квитанция", Вид);
	Расход = Квитанция.Расход;
	Области = БазовыеОбласти(Макет);
	Заголовок = ?(Расход, Вид.ЗаголовокРасхода, Вид.Заголовок);
	ЗаполнитьШапкуИЗаголовок(Области, Данные, Заголовок, "", КартинкиДанных(Данные), КодЯзыка);
	ПодписьОрганизации = ?(Расход, Вид.ПодписьПокупателя, Вид.ПодписьПродавца);
	ПодписьКонтрагента = ?(Расход, Вид.ПодписьПродавца, Вид.ПодписьПокупателя);
	Сторона1 = СторонаОрганизации(Данные.Организация, КодЯзыка);
	Сторона2 = СторонаКлиента(Данные.Клиент, КодЯзыка);

	ТабличныйДокумент.Вывести(Области.Шапка);
	ТабличныйДокумент.Вывести(Области.Заголовок);
	ВывестиСтороны(ТабличныйДокумент, Макет, ПодписьОрганизации, ПодписьКонтрагента, Сторона1, Сторона2);
	ВывестиСведения(ТабличныйДокумент, Макет, Данные, КодЯзыка);

	ОбластьСумма = Макет.ПолучитьОбласть("КвитанцияСумма");
	ОбластьСумма.Параметры.СуммаКвитанции = ФорматСуммы(Данные.Итоги.Сумма, Данные.КодВалюты, КодЯзыка);
	ОбластьСумма.Параметры.СуммаПрописью = СуммаПрописьюНаЯзыке(Данные.Итоги, КодЯзыка);
	ВывестиБлок(ТабличныйДокумент, ОбластьСумма, Области);
	ОбластьСтрока = Макет.ПолучитьОбласть("КвитанцияСтрока");
	Для Каждого Реквизит Из РеквизитыКвитанции(Квитанция, КодЯзыка) Цикл
		ОбластьСтрока.Параметры.ПодписьСтроки = Реквизит.Подпись;
		ОбластьСтрока.Параметры.ЗначениеСтроки = Реквизит.Значение;
		ВывестиБлок(ТабличныйДокумент, ОбластьСтрока, Области);
	КонецЦикла;

	Если Вид.СведенияПечати Тогда
		ОбластьПечати = Макет.ПолучитьОбласть("СведенияПечати");
		ОбластьПечати.Параметры.СведенияПечати = СведенияПечати(Данные.Шапка.Автор, КодЯзыка);
		ВывестиБлок(ТабличныйДокумент, ОбластьПечати, Области);
	КонецЕсли;
	Кассир = Новый Структура("Наименование, Подписант", Квитанция.Кассир, "");
	Плательщик = Новый Структура("Наименование, Подписант", Квитанция.Плательщик, "");
	Стороны = СтороныПодписей(Кассир, Плательщик, Вид.ПодписьЛевая, ПодписьКонтрагента);
	ВывестиПодписиСторон(ТабличныйДокумент, Макет, Данные, Области, Вид, Стороны);
	ЗавершитьФорму(ТабличныйДокумент, Области);
КонецПроцедуры

Функция РеквизитыКвитанции(Квитанция, КодЯзыка)
	// Заполненные реквизиты ордера в порядке печати: основание, НДС, приложение, документ получателя, касса, статья.
	Реквизиты = Новый Массив;
	ДобавитьРеквизитКвитанции(Реквизиты, НСтр("ru = 'Основание'; fr = 'Motif'; en = 'Purpose'; es = 'Concepto'", КодЯзыка),
		Квитанция.Основание);
	ДобавитьРеквизитКвитанции(Реквизиты, НСтр("ru = 'В том числе НДС'; fr = 'Dont TVA'; en = 'Including VAT';
		|es = 'IVA incluido'", КодЯзыка), Квитанция.ВТомЧислеНДС);
	ДобавитьРеквизитКвитанции(Реквизиты, НСтр("ru = 'Приложение'; fr = 'Pièces jointes'; en = 'Attachments';
		|es = 'Anexos'", КодЯзыка), Квитанция.Приложение);
	ДобавитьРеквизитКвитанции(Реквизиты, НСтр("ru = 'По документу'; fr = 'Pièce d''identité'; en = 'ID document';
		|es = 'Documento de identidad'", КодЯзыка), Квитанция.ПоДокументу);
	ДобавитьРеквизитКвитанции(Реквизиты, НСтр("ru = 'Касса'; fr = 'Caisse'; en = 'Cash desk'; es = 'Caja'", КодЯзыка),
		Квитанция.Касса);
	ДобавитьРеквизитКвитанции(Реквизиты, НСтр("ru = 'Статья движения денег'; fr = 'Rubrique de trésorerie';
		|en = 'Cash flow item'; es = 'Partida de tesorería'", КодЯзыка), Квитанция.СтатьяДДС);
	Возврат Реквизиты;
КонецФункции

Процедура ДобавитьРеквизитКвитанции(Реквизиты, Подпись, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Реквизиты.Добавить(Новый Структура("Подпись, Значение", Подпись, Значение));
	КонецЕсли;
КонецПроцедуры

Функция ОбщиеОбласти(Макет, Вид)
	Области = Новый Структура;
	Области.Вставить("Шапка", Макет.ПолучитьОбласть("Шапка"));
	Области.Вставить("Заголовок", Макет.ПолучитьОбласть("Заголовок"));
	Области.Вставить("ШапкаТаблицы", Макет.ПолучитьОбласть("ШапкаТаблицы" + Вид.Таблица));
	Области.Вставить("Строка", Макет.ПолучитьОбласть("Строка" + Вид.Таблица));
	ЭтоКП = Вид.Компоновка = КомпоновкаКП();
	Области.Вставить("Описание", Макет.ПолучитьОбласть(ИмяОбластиОписания(Вид)));
	Области.Вставить("Группа", ?(ЭтоКП, Неопределено, Макет.ПолучитьОбласть("ГруппаСтрок")));
	Области.Вставить("Скидка", ?(ЭтоКП, Неопределено, Макет.ПолучитьОбласть("ИтогСкидки")));
	Области.Вставить("Разделитель", Макет.ПолучитьОбласть("РазделительСтрок"));
	Области.Вставить("Итоги", Макет.ПолучитьОбласть("Итоги"));
	Области.Вставить("Подвал", Макет.ПолучитьОбласть("ПодвалРеквизитов"));
	Области.Вставить("ПустаяСтрока", Макет.ПолучитьОбласть("ПустаяСтрока"));
	Возврат Области;
КонецФункции

Функция ИмяОбластиОписания(Вид)
	// Описание строки - под колонкой наименования своей таблицы.
	Если Вид.Компоновка = КомпоновкаКП() Тогда
		Имя = "ОписаниеСтроки";
	ИначеЕсли СтрНачинаетсяС(Вид.Таблица, ТаблицаНакладной()) Тогда
		Имя = "ОписаниеСтрокиНакладная";
	Иначе
		Имя = "ОписаниеСтрокиФактура";
	КонецЕсли;
	Возврат Имя;
КонецФункции

Функция КартинкиДанных(Данные)
	Картинки = Новый Соответствие;
	Картинки.Вставить("ЛоготипДокумента", Данные.Логотип);
	Картинки.Вставить("ПечатьДокумента", Данные.ПечатьОрганизации);
	Возврат Картинки;
КонецФункции

Процедура ЗаполнитьШапкуИЗаголовок(Области, Данные, Заголовок, Плашка, Картинки, КодЯзыка)
	Области.Шапка.Параметры.Заполнить(Данные.Организация);
	ПечатныеФормы.ЗаполнитьРисункиКартинками(Области.Шапка, Картинки);
	Области.Подвал.Параметры.ПодвалРеквизитов = Данные.Организация.ПодвалРеквизитов;
	Области.Заголовок.Параметры.Заголовок = Заголовок;
	Области.Заголовок.Параметры.Номер = Данные.Шапка.Номер;
	Области.Заголовок.Параметры.Дата = ФорматДаты(Данные.Шапка.Дата, КодЯзыка);
	Области.Заголовок.Параметры.Плашка = Плашка;
	Если ПустаяСтрока(Плашка) Тогда
		// Документ без плашки печатается без неё: пустая ячейка с заливкой выходила цветным прямоугольником.
		СнятьЗаливкуПлашки(Области.Заголовок);
	КонецЕсли;
КонецПроцедуры

Процедура СнятьЗаливкуПлашки(ОбластьЗаголовок)
	// Ячейка плашки ищется по параметру, а не по координатам: сетка колонок поставляемого макета менялась
	// (2.0.16.70), а пользовательская правка может быть сохранена на прежней сетке.
	Для НомерСтроки = 1 По ОбластьЗаголовок.ВысотаТаблицы Цикл
		Для НомерКолонки = 1 По ОбластьЗаголовок.ШиринаТаблицы Цикл
			Ячейка = ОбластьЗаголовок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
			Если Ячейка.Параметр = "Плашка" Тогда
				ОбластьЗаголовок.Область(НомерСтроки, НомерКолонки, НомерСтроки,
					ОбластьЗаголовок.ШиринаТаблицы).ЦветФона = WebЦвета.Белый;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ВывестиСтроки(ТабличныйДокумент, Данные, Области, Вид, КодЯзыка)
	ТабличныйДокумент.Вывести(Области.ШапкаТаблицы);
	ЦеныБезНДС = Вид.ЦеныБезНДС Или Данные.Шапка.ЦеныБезНДС;
	Группа = "";
	Для Каждого Товар Из Данные.Товары Цикл
		ОбластиСтроки = Новый Массив;
		ЕстьГруппа = Области.Группа <> Неопределено И Товар.Группа <> Группа И ЗначениеЗаполнено(Товар.Группа);
		Если ЕстьГруппа Тогда
			Группа = Товар.Группа;
			Области.Группа.Параметры.Группа = Группа;
			ОбластиСтроки.Добавить(Области.Группа);
		КонецЕсли;
		// Параметры.Заполнить пропускает колонки, которых нет в варианте таблицы (без цен - без цены и суммы).
		Области.Строка.Параметры.Заполнить(ЗначенияСтроки(Товар, ЦеныБезНДС, КодЯзыка));
		ОбластиСтроки.Добавить(Области.Строка);
		ЕстьОписание = ЗначениеЗаполнено(Товар.Описание);
		Если ЕстьОписание Тогда
			Области.Описание.Параметры.Описание = Товар.Описание;
			ОбластиСтроки.Добавить(Области.Описание);
		КонецЕсли;
		ОбластиСтроки.Добавить(Области.Разделитель);
		Проверка = Новый Массив;
		Для Каждого Область Из ОбластиСтроки Цикл
			Проверка.Добавить(Область);
		КонецЦикла;
		Проверка.Добавить(Области.Подвал);
		Если Не ТабличныйДокумент.ПроверитьВывод(Проверка) Тогда
			НоваяСтраница(ТабличныйДокумент, Области);
			ТабличныйДокумент.Вывести(Области.ШапкаТаблицы);
		КонецЕсли;
		Для Каждого Область Из ОбластиСтроки Цикл
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ВывестиИтоги(ТабличныйДокумент, Данные, Области, Вид, КодЯзыка)
	Итоги = Данные.Итоги;
	КодВалюты = Данные.КодВалюты;
	Если Области.Скидка <> Неопределено И Итоги.СуммаСкидки <> 0 Тогда
		Области.Скидка.Параметры.СуммаСкидки = ФорматСуммы(Итоги.СуммаСкидки, КодВалюты, КодЯзыка);
		ВывестиБлок(ТабличныйДокумент, Области.Скидка, Области);
	КонецЕсли;
	ОбластьИтоги = Области.Итоги;
	ОбластьИтоги.Параметры.СуммаБезНДС = ФорматСуммы(Итоги.СуммаБезНДС, КодВалюты, КодЯзыка);
	ОбластьИтоги.Параметры.СуммаНДС = ФорматСуммы(Итоги.СуммаНДС, КодВалюты, КодЯзыка);
	ОбластьИтоги.Параметры.Итого = ФорматСуммы(Итоги.Сумма, КодВалюты, КодЯзыка);
	Прописью = СуммаПрописьюНаЯзыке(Итоги, КодЯзыка);
	Если ЗначениеЗаполнено(Вид.ПодписьСуммыПрописью) Тогда
		// Юридическая строка счёта-фактуры, как в прежней форме: «Arrêtée… : *** СУММА ПРОПИСЬЮ ***».
		Прописью = Вид.ПодписьСуммыПрописью + Символы.ПС + "*** " + ВРег(Прописью) + " ***";
	КонецЕсли;
	ОбластьИтоги.Параметры.СуммаПрописью = Прописью;
	ВывестиБлок(ТабличныйДокумент, ОбластьИтоги, Области);
КонецПроцедуры

Процедура ЗавершитьФорму(ТабличныйДокумент, Области)
	ВнизуСтраницы = Новый Массив;
	ВнизуСтраницы.Добавить(Области.Подвал);
	ПечатныеФормы.ДобитьСтраницуПустымиСтроками(ТабличныйДокумент, Области.ПустаяСтрока, ВнизуСтраницы);
	ТабличныйДокумент.Вывести(Области.Подвал);
КонецПроцедуры

Функция ЗначенияСтроки(Товар, ЦеныБезНДС, КодЯзыка)
	Значения = Новый Структура;
	Значения.Вставить("НомерСтроки", Товар.НомерСтроки);
	Значения.Вставить("Наименование", Товар.Наименование);
	Значения.Вставить("Артикул", Товар.Артикул);
	Значения.Вставить("Количество", ФорматКоличества(Товар.Количество, КодЯзыка));
	Значения.Вставить("Единица", Товар.Единица);
	Значения.Вставить("Цена", ФорматДенег(?(ЦеныБезНДС, Товар.ЦенаБезНДС, Товар.Цена), КодЯзыка));
	ФорматСкидки = "ЧДЦ=2; " + ПечатныеФормы.ЛокализацияФормата(КодЯзыка);
	Значения.Вставить("Скидка", ?(Товар.ПроцентСкидки = 0, "", Формат(Товар.ПроцентСкидки, ФорматСкидки) + " %"));
	Значения.Вставить("Сумма", ФорматДенег(?(ЦеныБезНДС, Товар.СуммаБезНДС, Товар.Сумма), КодЯзыка));
	Значения.Вставить("СтавкаНДС", Товар.СтавкаНДС);
	Значения.Вставить("СуммаНДС", ФорматДенег(Товар.СуммаНДС, КодЯзыка));
	Возврат Значения;
КонецФункции

Функция СторонаОрганизации(Организация, КодЯзыка)
	Реквизиты = Организация.ОрганизацияАдрес;
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты, Организация.ОрганизацияКонтакты, Символы.ПС);
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты, КодыДляПечати(Организация.Коды), Символы.ПС);
	Возврат Новый Структура("Наименование, Реквизиты, Подписант", Организация.ОрганизацияНаименование, Реквизиты, "");
КонецФункции

Функция СторонаКлиента(Клиент, КодЯзыка, АдресДоставки = Ложь)
	Коды = КодыДляПечати(Клиент.КлиентКоды);
	Если ПустаяСтрока(Клиент.КлиентАдрес) И ПустаяСтрока(Коды) Тогда
		// Данные прежних форматов: адрес, телефоны и ICE уже собраны в КлиентРеквизиты.
		Реквизиты = Клиент.КлиентРеквизиты;
	Иначе
		Реквизиты = Клиент.КлиентАдрес;
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты, Клиент.КлиентТелефоны, Символы.ПС);
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты, Коды, Символы.ПС);
	КонецЕсли;
	// Адрес доставки (BL) - если отличается от адреса клиента: пустой в карточке подменяется фактическим адресом.
	Доставка = Клиент.КлиентАдресДоставки;
	Если АдресДоставки И ЗначениеЗаполнено(Доставка) И Доставка <> Клиент.КлиентАдрес Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты, НСтр("ru = 'Адрес доставки: ';
			|fr = 'Adresse de livraison : '; en = 'Delivery address: '; es = 'Dirección de entrega: '", КодЯзыка)
			+ Доставка, Символы.ПС);
	КонецЕсли;
	Если ЗначениеЗаполнено(Клиент.КлиентКод) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты, НСтр("ru = 'Код клиента: '; fr = 'Code client : ';
			|en = 'Customer code: '; es = 'Código de cliente: '", КодЯзыка) + Клиент.КлиентКод, Символы.ПС);
	КонецЕсли;
	Возврат Новый Структура("Наименование, Реквизиты, Подписант", Клиент.КлиентНаименование, Реквизиты, "");
КонецФункции

Процедура ЗаполнитьСторону(Область, Префикс, Сторона)
	Значения = Новый Структура;
	Значения.Вставить(Префикс + "Наименование", Сторона.Наименование);
	Значения.Вставить(Префикс + "Реквизиты", Сторона.Реквизиты);
	Область.Параметры.Заполнить(Значения);
КонецПроцедуры

Функция КодыДляПечати(Коды)
	Строка = "";
	Для Каждого Код Из ПечатныеФормы.МеткиКодов() Цикл
		Значение = "";
		Коды.Свойство(Код.Имя, Значение);
		ДобавитьКод(Строка, Код.Метка, Значение);
	КонецЦикла;
	Возврат Строка;
КонецФункции

Функция СведенияДокумента(Данные, КодЯзыка)
	Сведения = Данные.Шапка.Основание;
	Договор = Данные.Клиент.КлиентДоговор;
	Если ЗначениеЗаполнено(Договор) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Сведения,
			НСтр("ru = 'Договор: '; fr = 'Contrat : '; en = 'Contract: '; es = 'Contrato: '", КодЯзыка) + Договор, " · ");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Сведения, Данные.Шапка.Комментарий, Символы.ПС);
	Возврат Сведения;
КонецФункции

Функция БанковскиеРеквизиты(Банк, КодЯзыка)
	Текст = Банк.Банк;
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Текст,
		НСтр("ru = 'Счёт № '; fr = 'Compte n° '; en = 'Account No. '; es = 'Cuenta n.º '", КодЯзыка) + Банк.НомерСчета, " · ");
	Если ЗначениеЗаполнено(Банк.БИК) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Текст, "SWIFT " + Банк.БИК, " · ");
	КонецЕсли;
	Возврат Текст;
КонецФункции

Процедура ВывестиБлок(ТабличныйДокумент, Область, Области)
	Проверка = Новый Массив;
	Проверка.Добавить(Область);
	Проверка.Добавить(Области.Подвал);
	Если Не ТабличныйДокумент.ПроверитьВывод(Проверка) Тогда
		НоваяСтраница(ТабличныйДокумент, Области);
	КонецЕсли;
	ТабличныйДокумент.Вывести(Область);
КонецПроцедуры

Процедура НоваяСтраница(ТабличныйДокумент, Области)
	ЗавершитьФорму(ТабличныйДокумент, Области);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
КонецПроцедуры

Функция УсловияКратко(Шапка, КодЯзыка)
	Текст = "";
	Если ЗначениеЗаполнено(Шапка.ДатаОтгрузки) Тогда
		Текст = НСтр("ru = 'Срок поставки: '; fr = 'Date de livraison : '; en = 'Delivery date: '; es = 'Fecha de entrega: '",
			КодЯзыка) + ФорматДаты(Шапка.ДатаОтгрузки, КодЯзыка);
	КонецЕсли;
	ВидЦен = ?(Шапка.ЦенаВключаетНДС, НСтр("ru = 'Цены указаны с НДС'; fr = 'Prix TTC'; en = 'Prices include VAT';
		|es = 'Precios con IVA'", КодЯзыка), НСтр("ru = 'Цены указаны без НДС'; fr = 'Prix HT'; en = 'Prices exclude VAT';
		|es = 'Precios sin IVA'", КодЯзыка));
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Текст, ВидЦен, Символы.ПС);
	Возврат Текст;
КонецФункции

Функция РеквизитыКлиентаДляПечати(Клиент, КодЯзыка)
	// Договор подписывается на языке печати. В снимках формата 1 договор уже вписан в реквизиты на языке записи -
	// они печатаются как есть.
	Реквизиты = Клиент.КлиентРеквизиты;
	Договор = Клиент.КлиентДоговор;
	Если ЗначениеЗаполнено(Договор) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Реквизиты,
			НСтр("ru = 'Договор: '; fr = 'Contrat : '; en = 'Contract: '; es = 'Contrato: '", КодЯзыка) + Договор,
			Символы.ПС);
	КонецЕсли;
	Возврат Реквизиты;
КонецФункции

Функция СуммаПрописьюНаЯзыке(Итоги, КодЯзыка)
	// Снимки формата 1 хранят сумму прописью только на языке записи.
	Текст = Итоги.СуммаПрописьюПоЯзыкам.Получить(КодЯзыка);
	Возврат ?(Текст = Неопределено, Итоги.СуммаПрописью, Текст);
КонецФункции

Функция ФорматДаты(Дата, КодЯзыка)
	Возврат Формат(Дата, "ДЛФ=D; " + ПечатныеФормы.ЛокализацияФормата(КодЯзыка));
КонецФункции

Функция ФорматДенег(Сумма, КодЯзыка)
	Локализация = ПечатныеФормы.ЛокализацияФормата(КодЯзыка);
	// Ноль - с десятичным разделителем языка печати: «0,00» или «0.00».
	Ноль = СтрЗаменить(Формат(1, "ЧДЦ=2; " + Локализация), "1", "0");
	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=" + Ноль + "; " + Локализация);
КонецФункции

Функция ФорматСуммы(Сумма, КодВалюты, КодЯзыка)
	Возврат ФорматДенег(Сумма, КодЯзыка) + " " + КодВалюты;
КонецФункции

Функция ФорматКоличества(Количество, КодЯзыка)
	ФорматнаяСтрока = ?(Количество = Цел(Количество), "ЧДЦ=0; ЧН=0", "ЧДЦ=3; ЧН=0");
	Возврат Формат(Количество, ФорматнаяСтрока + "; " + ПечатныеФормы.ЛокализацияФормата(КодЯзыка));
КонецФункции

