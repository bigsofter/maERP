Функция ОписаниеВидаДляПечати(ВидФормы, КодЯзыка, ПараметрыПечати)
	// Одна команда печатает разные варианты (раздел 3.1 плана): БезЦен = Истина у накладной рабочего места кассира
	// и BL «без цен», БезНДС = Истина у проформы заказа и BL «без НДС» (прежние формы печатали цены без НДС).
	Вид = ОписаниеВида(ВидФормы, КодЯзыка);
	// Акт сверки: «без НДС» - таблица без колонки НДС, «с печатью» - печать организации и факсимиле руководителя
	// (команды АктСверкиБезНДС и АктСверкиСПечатью, раздел 12.3 плана). Цен у акта и квитанции нет.
	Если Вид.Компоновка = КомпоновкаСверка() Тогда
		Если ПараметрПечати(ПараметрыПечати, "БезНДС") Тогда
			Вид.Таблица = ТаблицаСверкиБезНДС();
		КонецЕсли;
		Вид.ПечатьВПодписях = ПараметрПечати(ПараметрыПечати, "СПечатью");
		Вид.ПодписьВПодписях = Вид.ПечатьВПодписях;
		Возврат Вид;
	КонецЕсли;
	Если Вид.Компоновка = КомпоновкаКвитанция() Тогда
		Возврат Вид;
	КонецЕсли;
	Если ПараметрПечати(ПараметрыПечати, "БезЦен") Тогда
		// У КП - свой вариант таблицы без цен; товарная форма без такого варианта (Facture) печатается с ценами.
		ТаблицаБезЦен = ?(Вид.Компоновка = КомпоновкаКП(), ВариантБезЦен(), Вид.ТаблицаБезЦен);
		Если ЗначениеЗаполнено(ТаблицаБезЦен) Тогда
			Вид.Таблица = ТаблицаБезЦен;
			Вид.БезЦен = Истина;
			Вид.Оплаты = Ложь;
		КонецЕсли;
	КонецЕсли;
	Вид.ЦеныБезНДС = ПараметрПечати(ПараметрыПечати, "БезНДС");
	Если Вид.ЦеныБезНДС Тогда
		Вид.Оплаты = Ложь;
	КонецЕсли;
	Возврат Вид;
КонецФункции

Функция КопияПараметров(ПараметрыПечати)
	// Напечатать дополняет параметры (скрытые цены) - структура вызывающего не меняется.
	Копия = Новый Структура;
	Если ТипЗнч(ПараметрыПечати) = Тип("Структура") Тогда
		Для Каждого Параметр Из ПараметрыПечати Цикл
			Копия.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Копия;
КонецФункции

Процедура ПрименитьСкрытиеЦен(ВидФормы, Параметры, КодЯзыка)
	// ЦеныСкрыты в параметрах только ужесточает печать (сценарий тестов проверяет так ветку роли, которую раннер не
	// воспроизводит); снять ограничение роли параметром нельзя.
	Если Не ЦеныСкрыты() И Не ПараметрПечати(Параметры, "ЦеныСкрыты") Тогда
		Возврат;
	КонецЕсли;
	Вид = ОписаниеВида(ВидФормы, КодЯзыка);
	Если Вид.Компоновка = КомпоновкаКП() Или ПустаяСтрока(Вид.ТаблицаБезЦен) Тогда
		ШаблонОтказа = НСтр("ru = 'Печатная форма «%1» содержит цены и суммы и недоступна вашей роли.';
			|fr = 'Le formulaire « %1 » contient des prix et des montants et n''est pas disponible pour votre rôle.';
			|en = 'The «%1» print form contains prices and amounts and is not available to your role.';
			|es = 'El formulario «%1» contiene precios e importes y no está disponible para su rol.'", КодЯзыка);
		ВызватьИсключение СтрШаблон(ШаблонОтказа, Вид.Представление);
	КонецЕсли;
	Параметры.Вставить("БезЦен", Истина);
КонецПроцедуры

Функция ПараметрПечати(ПараметрыПечати, Имя)
	Значение = Ложь;
	Если ТипЗнч(ПараметрыПечати) = Тип("Структура") И ПараметрыПечати.Свойство(Имя) Тогда
		Значение = ПараметрыПечати[Имя];
	КонецЕсли;
	Возврат ТипЗнч(Значение) = Тип("Булево") И Значение;
КонецФункции

