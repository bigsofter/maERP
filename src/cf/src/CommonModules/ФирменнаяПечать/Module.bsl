Функция МакетВида(Вид, КодЯзыка)
	// Пользовательская правка общего макета - если в ней есть все области вида, иначе поставляемый (раздел 3.4а
	// плана): правка, сохранённая до сборки, добавившей области, не должна ломать печать.
	Макет = ПечатныеФормы.МакетПечатнойФормы(ПутьМакета());
	Недостающие = НедостающиеОбласти(Макет, Вид);
	Если Недостающие.Количество() = 0 Тогда
		Возврат Макет;
	КонецЕсли;
	ШаблонПредупреждения = НСтр("ru = 'Изменённый макет %1 не содержит областей %2 - печать поставляемым макетом.
		|Перенесите правки в новую версию макета.'; fr = 'Le modèle modifié %1 ne contient pas les zones %2 -
		|impression avec le modèle fourni. Reportez les modifications dans la nouvelle version du modèle.';
		|en = 'The modified template %1 lacks areas %2 - printing with the supplied template.
		|Move the changes to the new template version.'; es = 'La plantilla modificada %1 no contiene las áreas %2 -
		|impresión con la plantilla suministrada. Traslade los cambios a la nueva versión de la plantilla.'");
	КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	ИмяСобытия = НСтр("ru = 'Печать.Фирменный макет'; fr = 'Impression.Modèle à en-tête';
		|en = 'Printing.Branded template'; es = 'Impresión.Plantilla corporativa'", КодОсновногоЯзыка);
	Комментарий = СтрШаблон(ШаблонПредупреждения, ПутьМакета(), СтрСоединить(Недостающие, ", "));
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , Комментарий);
	Макет = ПечатныеФормы.ПоставляемыйМакет(ПутьМакета());
	Если ЗначениеЗаполнено(КодЯзыка) Тогда
		Макет.КодЯзыка = КодЯзыка;
	КонецЕсли;
	Возврат Макет;
КонецФункции

Функция НедостающиеОбласти(Макет, Вид)
	Если Вид.Компоновка = КомпоновкаКП() Тогда
		Имена = СтрРазделить("Шапка,Заголовок,Стороны,ОписаниеСтроки,РазделительСтрок,Итоги,Условия,Подпись,"
			+ "ПодвалРеквизитов,ПустаяСтрока", ",");
	Иначе
		Имена = СтрРазделить("Шапка,Заголовок,СтороныФактуры,СведенияДокумента,ОписаниеСтрокиФактура,ГруппаСтрок,"
			+ "РазделительСтрок,ИтогСкидки,Итоги,БлокТекста,Условия,ПодписьФактуры,ПодвалРеквизитов,ПустаяСтрока", ",");
	КонецЕсли;
	Имена.Добавить("ШапкаТаблицы" + Вид.Таблица);
	Имена.Добавить("Строка" + Вид.Таблица);
	Недостающие = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Если Макет.Области.Найти(Имя) = Неопределено Тогда
			Недостающие.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Недостающие;
КонецФункции

