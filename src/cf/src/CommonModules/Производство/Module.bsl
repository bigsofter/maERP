#Область ПрограммныйИнтерфейс

// Контекст автовыпуска документа-основания для блокировок проведения и отмены проведения: найденные автовыпуски,
// номенклатура и заказы, которые возьмёт автовыпуск. Вызывается ДО Блокировка.Заблокировать().
//
// Складские остатки при этом не читаются (режим ПолныйСостав): состав обязан быть полным, иначе блокировка
// окажется у́же фактического расчёта под ней. Регистр потребностей у канала передачи прочитан быть может -
// расхождение с расчётом под блокировкой ловит ВПределахБлокировки.
//
// Состав номенклатуры считается по ПОЛНОМУ составу, БЕЗ вычета свободного складского остатка продукции
// (параметр ПолныйСостав расчёта) - в обоих каналах (S9). Иначе у основания, покрытого остатком на момент вызова,
// расчёт вернул бы пустую продукцию, блокировка оказалась бы уже фактического расчёта под ней, и после
// Заблокировать() - когда другой сеанс успел забрать продукцию со склада - ВПределахБлокировки отдал бы
// пользователю отказ «Заказ клиента изменён» вместо проведения.
//
// Параметры:
//  Основание - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - проводимый документ.
//  ДляОтмены - Булево - Истина: отмена проведения или удаление - только найденные автовыпуски, без нового расчёта.
//
// Возвращаемое значение:
//  Структура:
//   * Управляется  - Булево - механизм включён и может менять автовыпуск (опция, константа, не загрузка, не фон).
//   * Автовыпуски  - Массив из ДокументСсылка.ВыпускПродукции - автовыпуски основания.
//   * Номенклатура - Массив из СправочникСсылка.Номенклатура - продукция и материалы для блокировки остатков.
//   * Заказы       - Массив из ДокументСсылка.ЗаказПокупателя - заказы для блокировки потребностей.
//
Функция КонтекстАвтовыпуска(Основание, ДляОтмены = Ложь) Экспорт

	ПроверитьОснование(Основание);
	// Автовыпуск и его движения читают роли без права на выпуск и потребности (PDV, Казначей): служебное чтение.
	УстановитьПривилегированныйРежим(Истина);
	Контекст = Новый Структура;
	Контекст.Вставить("Управляется", Не ДляОтмены И МеханизмУправляетАвтовыпуском(Основание));
	Контекст.Вставить("Автовыпуски", АвтовыпускиОснования(Основание.Ссылка));
	Контекст.Вставить("Номенклатура", НоменклатураАвтовыпусков(Контекст.Автовыпуски));
	Контекст.Вставить("Заказы", ЗаказыДвиженийАвтовыпусков(Контекст.Автовыпуски));
	Если Контекст.Управляется Тогда
		Данные = РассчитатьАвтовыпуск(Основание, Контекст.Автовыпуски, Ложь, Неопределено, Истина);
		ДобавитьЗначения(Контекст.Номенклатура, Данные.Номенклатура);
		Если Данные.Активен Тогда
			ДобавитьЗначения(Контекст.Заказы, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Заказ));
		КонецЕсли;
	КонецЕсли;
	Возврат Контекст;

КонецФункции

// Блокировка остатков проведения основания с автовыпуском: одним элементом по номенклатуре строк документа и
// автовыпуска на всех складах, с дополнительными расходами - так же широко, как блокирует проведение выпуска.
// Вызывается вместо блокировки строк документа и до взаиморасчётов - порядок один для проведения и отмены.
//
// Параметры:
//  Блокировка - БлокировкаДанных - блокировка проведения документа-основания.
//  Контекст   - Структура - см. КонтекстАвтовыпуска.
//  Позиции    - ТабличнаяЧасть, ТаблицаЗначений - строки документа-основания с колонкой «Номенклатура».
//
Процедура ЗаполнитьБлокировкуОстатковАвтовыпуска(Блокировка, Контекст, Позиции) Экспорт

	Номенклатура = Новый Массив;
	ДобавитьЗначения(Номенклатура, Позиции.ВыгрузитьКолонку("Номенклатура"));
	ДобавитьЗначения(Номенклатура, Контекст.Номенклатура);
	Источник = Новый ТаблицаЗначений;
	Источник.Колонки.Добавить("Номенклатура", ОписаниеТипаНоменклатуры());
	Для Каждого Позиция Из Номенклатура Цикл
		Источник.Добавить().Номенклатура = Позиция;
	КонецЦикла;
	УправляемыеБлокировки.ТоварыВНаличии(Блокировка, Источник);

КонецПроцедуры

// Добавляет в блокировку проведения основания потребности производства заказов автовыпуска - последним регистром
// документа, после взаиморасчётов.
//
// Параметры:
//  Блокировка - БлокировкаДанных - блокировка проведения документа-основания.
//  Контекст   - Структура - см. КонтекстАвтовыпуска.
//
Процедура ЗаполнитьБлокировкуПотребностейАвтовыпуска(Блокировка, Контекст) Экспорт

	Для Каждого Заказ Из Контекст.Заказы Цикл
		УправляемыеБлокировки.ПотребностиПроизводства(Блокировка, Заказ);
	КонецЦикла;

КонецПроцедуры

// Полный набор блокировок передачи в переработку в проектном порядке (урок E8): остатки склада, товары у
// переработчика, потребности заказов автовыпуска последними.
//
// Место ОДНО на двух вызывающих - саму передачу и рабочее место производства, которое блокирует её перед
// правкой строк. Разойдись они, рабочее место взяло бы узкий элемент «склад + строки», а проведение следом,
// в той же транзакции, дозахватило бы широкий (номенклатура автовыпуска, все склады) уже ПОСЛЕ
// ТоварыВПереработке - то есть ровно ту эскалацию, ради устранения которой разворачивали порядок в
// поступлении из переработки.
//
// Параметры:
//  Блокировка - БлокировкаДанных - заполняемая блокировка.
//  Контекст   - Структура - см. КонтекстАвтовыпуска.
//  Позиции    - ТабличнаяЧасть, ТаблицаЗначений - строки передачи с колонкой «Номенклатура»; рабочее место
//               добавляет сюда номенклатуру записываемой строки, которой в строках ещё нет.
//  Склад      - СправочникСсылка.МестаХранения - место хранения передачи; участвует, только когда автовыпуска
//               нет и элемент остаётся узким.
//  Контрагент - СправочникСсылка.Контрагенты - переработчик.
//
Процедура ЗаполнитьБлокировкуПередачи(Блокировка, Контекст, Позиции, Склад, Контрагент) Экспорт

	Если Контекст.Номенклатура.Количество() = 0 Тогда
		УправляемыеБлокировки.ТоварыВНаличии(Блокировка, Позиции, Склад);
	Иначе
		ЗаполнитьБлокировкуОстатковАвтовыпуска(Блокировка, Контекст, Позиции);
	КонецЕсли;
	УправляемыеБлокировки.ТоварыВПереработке(Блокировка, Позиции, Контрагент);
	ЗаполнитьБлокировкуПотребностейАвтовыпуска(Блокировка, Контекст);

КонецПроцедуры

// Создаёт, перезаполняет или распроводит автовыпуск проводимого документа-основания. Вызывается в его
// ОбработкаПроведения после Блокировка.Заблокировать() и до его собственных движений. Все проверки - до проведения
// автовыпуска: закрытый период основания проверила платформа, заполнение и списание материалов - проба на том же
// объекте выпуска, поэтому запись автовыпуска исключением не падает, а отказ возвращается основанию читаемым
// (урок E6). Отказ после предварительной записи или очистки движений откатывает их вместе с транзакцией основания.
//
// Параметры:
//  Основание - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - проводимый документ.
//  Контекст  - Структура - см. КонтекстАвтовыпуска.
//  Отказ     - Булево - устанавливается при отказе с сообщениями пользователю.
//
Процедура ОбеспечитьАвтовыпуск(Основание, Контекст, Отказ) Экспорт

	ПроверитьЗаписьОснования(Основание);
	Если Не Контекст.Управляется Тогда
		// Опция или константа выключены, загрузка, фоновое перепроведение: автовыпуск не трогается.
		Возврат;
	КонецЕсли;
	// Роли, проводящие основание (PDV, Казначей, Оператор, Кладовщик), не имеют прав на выпуск и потребности
	// (решение владельца 5): право на проведение основания платформа уже проверила, автовыпуск пишет механизм,
	// а не пользователь.
	УстановитьПривилегированныйРежим(Истина);
	Автовыпуски = АвтовыпускиОснования(Основание.Ссылка);
	// Момент границы складских остатков вычисляется ОДИН раз на оба прохода расчёта (см. МоментГраницыОстатков):
	// на первом проходе ссылки нового автовыпуска ещё нет, на втором она уже есть, и граница, посчитанная
	// проходом, разошлась бы сама с собой.
	Момент = МоментГраницыОстатков(ДатаАвтовыпуска(Основание), Автовыпуски);
	Данные = РассчитатьАвтовыпуск(Основание, Автовыпуски, Ложь, Момент);
	Если Не ВПределахБлокировки(Данные, Контекст) Тогда
		СообщитьОтказ(ТекстЗаказИзменен(), Отказ);
		Возврат;
	КонецЕсли;
	// Продукция заказа на станке (открытое требование-накладная): автовыпуск дал бы двойное производство (P1-1, N2).
	// Потребности заказа автовыпуска уже под блокировкой основания.
	Если ПродукцияНаСтанке(Данные, Отказ) Тогда
		Возврат;
	КонецЕсли;
	Основной = ?(Автовыпуски.Количество() > 0, Автовыпуски[0], Неопределено);
	Если Не РаспровестиЛишниеАвтовыпуски(Автовыпуски, Основание.Ссылка) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Не Данные.Активен Или Данные.Продукция.Количество() = 0 Тогда
		Если Основной <> Неопределено И Не ОтменитьПроведениеАвтовыпуска(Основной, Основание.Ссылка, Истина) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		ВывестиСообщения(Данные.Сообщения);
		Возврат;
	КонецЕсли;
	Объект = ПодготовленныйОбъектАвтовыпуска(Основной, Основание);
	Если Объект = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	// Партии под заказ - на момент записанного объекта, после очистки его прежних движений.
	Данные = РассчитатьАвтовыпуск(Основание, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка), Истина, Момент);
	Если Данные.Продукция.Количество() = 0 Или Не ВПределахБлокировки(Данные, Контекст) Тогда
		// Пересчёт на тех же данных под блокировкой расходиться не должен; расхождение - отказ, а не пустой выпуск.
		СообщитьОтказ(ТекстЗаказИзменен(), Отказ);
		Возврат;
	КонецЕсли;
	ВывестиСообщения(Данные.Сообщения);
	ЗаполнитьАвтовыпуск(Объект, Основание, Данные);
	// Закрытый период - и по новой дате автовыпуска: проверка записи выпуска внутри проведения отказом не прерывается.
	Если Не МожноИзменитьАвтовыпуск(Объект) Или Не ПробаАвтовыпуска(Объект, Данные) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Объект.ДополнительныеСвойства.Вставить(ИмяСвойстваЗаписи(), Основание.Ссылка);
	Объект.ДополнительныеСвойства.Вставить(ИмяСвойстваИзОстатка(), ИзОстаткаДляЗаписи(Данные));
	Объект.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

// Распроводит автовыпуски основания при отмене его проведения или удалении; пометка удаления - как у основания или
// принудительная. Вызывается после блокировки отмены проведения основания (см. КонтекстАвтовыпуска с ДляОтмены).
//
// Параметры:
//  Основание - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - документ-основание.
//  Отказ     - Булево - устанавливается, если автовыпуск лежит в закрытом периоде (сообщение пользователю).
//  Пометить  - Булево - Истина: пометить автовыпуски на удаление независимо от пометки основания (удаление).
//
Процедура ОтменитьАвтовыпуск(Основание, Отказ, Пометить = Ложь) Экспорт

	ПроверитьЗаписьОснования(Основание);
	// Распроведение выпуска - запись механизма, а не пользователя (см. ОбеспечитьАвтовыпуск); закрытый период
	// проверяется по дате самого автовыпуска.
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Автовыпуск Из АвтовыпускиОснования(Основание.Ссылка) Цикл
		Если Не ОтменитьПроведениеАвтовыпуска(Автовыпуск, Основание.Ссылка, Пометить Или Основание.ПометкаУдаления) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Переносит пометку удаления основания на его непроведённые автовыпуски. Вызывается в ПриЗаписи основания до записи
// статусов заказа.
//
// Параметры:
//  Основание - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - записываемый документ.
//  Отказ     - Булево - устанавливается, если автовыпуск лежит в закрытом периоде.
//
Процедура ПометитьАвтовыпуск(Основание, Отказ) Экспорт

	ПроверитьЗаписьОснования(Основание);
	Если Основание.ОбменДанными.Загрузка Или Основание.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	// Пометку выпуска ставит механизм, а не пользователь (см. ОбеспечитьАвтовыпуск).
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Выпуски.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|ГДЕ
	|	Выпуски.Основание = &Основание
	|	И НЕ Выпуски.Проведен
	|	И Выпуски.ПометкаУдаления <> &Пометка");
	Запрос.УстановитьПараметр("Основание", Основание.Ссылка);
	Запрос.УстановитьПараметр("Пометка", Основание.ПометкаУдаления);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если Не МожноИзменитьАвтовыпуск(Объект) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		Объект.ПометкаУдаления = Основание.ПометкаУдаления;
		Объект.ДополнительныеСвойства.Вставить(ИмяСвойстваЗаписи(), Основание.Ссылка);
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;

КонецПроцедуры

// Расчёт автовыпуска документа-основания без записи - для проверок и сценариев. Остатки партий материалов читаются
// на момент автовыпуска; движения существующего автовыпуска с прежней датой не очищаются, поэтому после смены даты
// основания результат может отличаться от проведения (очистку делает только ОбеспечитьАвтовыпуск).
//
// Параметры:
//  Основание - ДокументОбъект.РеализацияТоваровУслуг, ДокументСсылка.РеализацияТоваровУслуг,
//              ДокументОбъект.ПередачаВПереработку, ДокументСсылка.ПередачаВПереработку - документ-основание.
//
// Возвращаемое значение:
//  Структура:
//   * Управляется  - Булево - механизм включён (см. КонтекстАвтовыпуска).
//   * Активен      - Булево - основание по заказу на производство при включённом механизме.
//   * Заказ        - ДокументСсылка.ЗаказПокупателя, Неопределено - заказ основания.
//   * Дата         - Дата - дата автовыпуска.
//   * Момент       - МоментВремени - момент границы складских остатков (см. МоментГраницыОстатков).
//   * Склад        - СправочникСсылка.МестаХранения - место хранения основания.
//   * Продукция    - ТаблицаЗначений - Номенклатура, Характеристика, Серия, Количество.
//   * Материалы    - ТаблицаЗначений - Номенклатура, Характеристика, Серия, Партия, Количество, КоличествоЗаЕдиницу.
//   * ИзОстатка    - ТаблицаЗначений - Продукция, Материал, Характеристика, Количество.
//   * Номенклатура - Массив из СправочникСсылка.Номенклатура - продукция и материалы.
//   * Сообщения    - Массив из Строка - предупреждения без отказа.
//
Функция ДанныеАвтовыпуска(Основание) Экспорт

	ТипОснования = ТипЗнч(Основание);
	Если ТипОснования = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		Или ТипОснования = Тип("ДокументСсылка.ПередачаВПереработку") Тогда
		Объект = Основание.ПолучитьОбъект();
	Иначе
		Объект = Основание;
	КонецЕсли;
	ПроверитьОснование(Объект);
	// Расчёт читает выпуски, потребности и остатки - служебно, как при проведении.
	УстановитьПривилегированныйРежим(Истина);
	Возврат РассчитатьАвтовыпуск(Объект, АвтовыпускиОснования(Объект.Ссылка), Истина);

КонецФункции

// Выпуск создан механизмом автовыпуска, а не пользователем.
//
// Ответ даёт реквизит СозданАвтоматически, а не тип основания: тип основания перестаёт быть признаком
// автовыпуска, как только оснований становится больше одного. Реквизит ставит единственное место -
// ЗаполнитьШапкуАвтовыпуска; историческим выпускам его проставил обработчик обновления 2.0.15.42.
// ОТБОР существующих автовыпусков по нему не идёт (см. АвтовыпускиОснования): база, где обработчик
// обновления не отработал, иначе не нашла бы свои выпуски и завела бы дубли.
//
// Параметры:
//  Выпуск - ДокументОбъект.ВыпускПродукции, ДокументСсылка.ВыпускПродукции - выпуск.
//
// Возвращаемое значение:
//  Булево - Истина у автовыпуска.
//
Функция ЭтоАвтовыпуск(Выпуск) Экспорт

	Если ТипЗнч(Выпуск) = Тип("ДокументСсылка.ВыпускПродукции") Тогда
		Возврат ЭтоИстина(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выпуск, "СозданАвтоматически"));
	КонецЕсли;
	Возврат Выпуск.СозданАвтоматически;

КонецФункции

// Запрет ручной правки автовыпуска: запись, проведение, отмена проведения и пометка удаления - только механизмом при
// проведении документа-основания. Отказ и у выпуска, которому основанием вручную выбрали реализацию или передачу в
// переработку. Вызывается в ПередЗаписью и ПередУдалением выпуска.
//
// Параметры:
//  Выпуск - ДокументОбъект.ВыпускПродукции - записываемый или удаляемый выпуск.
//  Отказ  - Булево - устанавливается при ручной правке.
//
Процедура ПроверитьПравкуАвтовыпуска(Выпуск, Отказ) Экспорт

	// Проверка НЕ сводится к признаку СозданАвтоматически: выпуск, которому основанием вручную выбрали
	// реализацию или передачу, признака не получает - а править его всё равно нельзя, иначе пользователь
	// заведёт документ, который механизм при проведении основания молча перезапишет. Поэтому запрет
	// срабатывает и по признаку, и по основанию механизма (оба непустых типа, находка P1-3).
	// Отсутствие basedOn и ограничение типа на форме - интерфейс, а не объектный инвариант, а поиск
	// автовыпусков идёт только по основанию, поэтому проверяются и новые значения объекта, и сохранённые.
	// Исключение - выпуски, заведённые до 2.0.15.42: их пометил признаком обработчик обновления, потому что
	// отбирал ровно по основанию-реализации. Поведение у них прежнее - автовыпусками их считал и старый код.
	Автовыпуск = Выпуск.СозданАвтоматически;
	ОснованиеМеханизма = ОснованиеМеханизмаАвтовыпуска(Выпуск.Основание);
	Если ОснованиеМеханизма = Неопределено И Не Выпуск.ЭтоНовый() Тогда
		// Реквизиты в базе читаются служебно: у роли может не быть права на основание.
		УстановитьПривилегированныйРежим(Истина);
		ВБазе = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выпуск.Ссылка, "Основание,СозданАвтоматически");
		УстановитьПривилегированныйРежим(Ложь);
		Автовыпуск = Автовыпуск Или ЭтоИстина(ВБазе.СозданАвтоматически);
		ОснованиеМеханизма = ОснованиеМеханизмаАвтовыпуска(ВБазе.Основание);
	КонецЕсли;
	Если ОснованиеМеханизма = Неопределено И Не Автовыпуск Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоЗаписьАвтовыпуска(Выпуск) Тогда
		// Пишет сам механизм: то же основание в реквизите и в ДополнительныеСвойства.
		Возврат;
	КонецЕсли;
	// Признак без распознанного основания - испорченные данные: править всё равно не даём, а в сообщении
	// называем то основание, которое есть.
	Названное = ?(ОснованиеМеханизма = Неопределено, Выпуск.Основание, ОснованиеМеханизма);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстРучнаяПравка(), Названное), Неопределено, "", "", Отказ);

КонецПроцедуры

// Выпуск записывается механизмом автовыпуска: вложенная запись внутри проведения документа-основания не
// пересчитывает стадии (см. ПроизводственныеЗаказы.ПересчётНеВыполняется).
//
// Обобщение на оба типа основания обязательно не только ради опознания записи: через эту функцию
// ПроизводственныеЗаказы.ПересчётНеВыполняется глушит вложенный пересчёт стадий самого автовыпуска. Без
// обобщения вложенная запись выпуска взяла бы блокировку истории статусов в середине транзакции передачи,
// до её ТоварыВПереработке, - прямое нарушение урока E8.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - записываемый документ.
//
// Возвращаемое значение:
//  Булево - Истина при записи из этого модуля.
//
Функция ЭтоЗаписьАвтовыпуска(ДокОбъект) Экспорт

	Если ТипЗнч(ДокОбъект) <> Тип("ДокументОбъект.ВыпускПродукции") Тогда
		Возврат Ложь;
	КонецЕсли;
	ЗаписьМеханизма = Неопределено;
	Возврат ДокОбъект.ДополнительныеСвойства.Свойство(ИмяСвойстваЗаписи(), ЗаписьМеханизма)
		И ОснованиеМеханизмаАвтовыпуска(ЗаписьМеханизма) <> Неопределено
		И ЗаписьМеханизма = ДокОбъект.Основание;

КонецФункции

// Строки «ИзОстатка», переданные автовыпуску механизмом, - для движений потребностей производства выпуска.
//
// Параметры:
//  Выпуск - ДокументОбъект.ВыпускПродукции - проводимый выпуск.
//
// Возвращаемое значение:
//  Неопределено - выпуск проводится не механизмом, движения потребностей не переписываются;
//  Структура:
//   * Заказ  - ДокументСсылка.ЗаказПокупателя, Неопределено - заказ; Неопределено - заказ потребность не формирует.
//   * Строки - ТаблицаЗначений - Продукция, Материал, Характеристика, Количество.
//
Функция ИзОстаткаАвтовыпуска(Выпуск) Экспорт

	Значение = Неопределено;
	Если Не ЭтоЗаписьАвтовыпуска(Выпуск)
		Или Не Выпуск.ДополнительныеСвойства.Свойство(ИмяСвойстваИзОстатка(), Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Заказ клиента автовыпуска - основание его документа-основания: у реализации это её основание, у передачи в
// переработку - её основание, типизированное сразу заказом.
//
// Параметры:
//  Основание - ДокументСсылка - основание выпуска.
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПокупателя, Неопределено - заказ основания;
//  Неопределено - основание не реализация и не передача.
//
Функция ЗаказОснования(Основание) Экспорт

	Если ОснованиеМеханизмаАвтовыпуска(Основание) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Заказ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "Основание");
	Возврат ?(ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказПокупателя"), Заказ, Неопределено);

КонецФункции

// Продукция без материалов в заказе производится по техкарте (решение владельца 4): тип «Продукция» или «Полуфабрикат»
// либо способ пополнения «Производство», но не «Оба» и не «Закупка». Наличие карты проверяет ДобавитьНормыПоТехкартам.
// Экспортная и в программном интерфейсе, потому что то же правило служит правилом остановки разворачивания техкарты в
// глубину (ТехнологическиеКарты.РазвернутыйСостав): своя копия правила там разошлась бы с этой при первой же правке.
//
// Параметры:
//  СтрокаЗаказа - СтрокаТаблицыЗначений, Структура - строка товаров заказа либо любой набор полей с
//                 ТипНоменклатуры и СпособПополнения.
//
// Возвращаемое значение:
//  Булево - Истина, если продукция может выпускаться по техкарте.
//
Функция ПроизводитсяПоТехкарте(СтрокаЗаказа) Экспорт

	Способы = Перечисления.СпособыПополненияЗапасов;
	Если СтрокаЗаказа.СпособПополнения = Способы.Оба Или СтрокаЗаказа.СпособПополнения = Способы.Закупка Тогда
		Возврат Ложь;
	КонецЕсли;
	Типы = Перечисления.ТипыНоменклатуры;
	Возврат СтрокаЗаказа.СпособПополнения = Способы.Производство
		Или СтрокаЗаказа.ТипНоменклатуры = Типы.Продукция
		Или СтрокаЗаказа.ТипНоменклатуры = Типы.Полуфабрикат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разрядность дробной части количества - из определяемого типа, не литералом: литерал разошёлся бы
// с типом при смене разрядности, и материал с мелкой нормой молча отбрасывался бы проверкой
// «Количество <= 0» ниже по коду.
//
// Возвращаемое значение:
//  Число - знаков после запятой.
//
Функция РазрядностьКоличества()
	Возврат Метаданные.ОпределяемыеТипы.Количество.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти;
КонецФункции

#Область Запись

// Отказ автовыпуска, если продукция расчёта заказа загружена на станок открытым требованием-накладной.
//
// Параметры:
//  Данные - Структура - см. РассчитатьАвтовыпуск
//  Отказ  - Булево - устанавливается при отказе с сообщением пользователю
//
// Возвращаемое значение:
//  Булево - Истина, если автовыпуск отклонён
//
Функция ПродукцияНаСтанке(Данные, Отказ)

	Если Не Данные.Активен Или Данные.Продукция.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстЗапрета = ТребованияНакладные.ТекстЗапретаВыпускаБезТребования(Данные.Заказ, Данные.Продукция);
	Если Не ЗначениеЗаполнено(ТекстЗапрета) Тогда
		Возврат Ложь;
	КонецЕсли;
	СообщитьОтказ(ТекстЗапрета, Отказ);
	Возврат Истина;

КонецФункции

Функция ИмяСвойстваЗаписи()

	// Имя служебного маркера, а не реквизита: после обобщения на два типа основания «Реализации» в нём врало бы.
	Возврат "ЗаписьАвтовыпускаОснования";

КонецФункции

Функция ИмяСвойстваИзОстатка()

	Возврат "ИзОстаткаАвтовыпуска";

КонецФункции

// Запись автовыпуска - только внутри транзакции записи основания: отказ откатывает предварительную запись и очистку.
//
// Параметры:
//  Основание - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - документ-основание.
//
Процедура ПроверитьЗаписьОснования(Основание)

	ПроверитьОснование(Основание);
	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение НСтр("ru = 'Автовыпуск изменяется только внутри записи документа-основания';
			|fr = 'La fabrication automatique ne change que pendant l''enregistrement du document de base';
			|en = 'The automatic production output changes only while the basis document is being written';
			|es = 'La fabricación automática solo cambia durante la grabación del documento base'");
	КонецЕсли;

КонецПроцедуры

// Обобщение идёт явной проверкой двух типов, а не наличием реквизита: неявное обобщение здесь уже однажды
// обернулось исключением с текстом про реализацию.
//
// Параметры:
//  Основание - ДокументОбъект - проверяемый объект.
//
Процедура ПроверитьОснование(Основание)

	ТипОснования = ТипЗнч(Основание);
	Если ТипОснования <> Тип("ДокументОбъект.РеализацияТоваровУслуг")
		И ТипОснования <> Тип("ДокументОбъект.ПередачаВПереработку") Тогда
		ВызватьИсключение НСтр("ru = 'Автовыпуск обслуживается только для реализации товаров и услуг и передачи в переработку';
			|fr = 'La fabrication automatique ne concerne que la vente de biens et services et le transfert en sous-traitance';
			|en = 'Automatic production output is handled only for a sale of goods and services and a subcontracting transfer';
			|es = 'La fabricación automática solo se gestiona para la venta de bienes y servicios y la transferencia a subcontratación'");
	КонецЕсли;

КонецПроцедуры

// Тело не зависит от типа основания: ОбменДанными.Загрузка, фоновое перепроведение, функциональная опция
// «Производство» и константа ИспользоватьАвтовыпускПриОтгрузке есть у обоих документов. До S8 константа
// называлась ИспользоватьВыпускПродукцииПриПродаже: под отгрузкой понимаются и реализация, и передача.
//
// Параметры:
//  Основание - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - документ-основание.
//
// Возвращаемое значение:
//  Булево - Истина, если механизм может менять автовыпуск этого документа.
//
Функция МеханизмУправляетАвтовыпуском(Основание)

	Возврат Не Основание.ОбменДанными.Загрузка
		И Не Основание.ДополнительныеСвойства.Свойство(РаботаСДокументами.СвойствоВыполняетсяФоновоеПерепроведение())
		И ПолучитьФункциональнуюОпцию("Производство")
		И Константы.ИспользоватьАвтовыпускПриОтгрузке.Получить();

КонецФункции

// Автовыпуск записан: новый - без проведения (у проводимого объекта появляется ссылка и момент времени, по которым
// считаются остатки пробы и проведения); существующий проведённый - с очищенными движениями, чтобы его прежние
// списания с другой датой не исказили остатки на новой границе.
//
// Параметры:
//  Автовыпуск - ДокументСсылка.ВыпускПродукции, Неопределено - существующий автовыпуск.
//  Основание  - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - документ-основание.
//
// Возвращаемое значение:
//  ДокументОбъект.ВыпускПродукции - записанный объект;
//  Неопределено - существующий автовыпуск в закрытом периоде (сообщение пользователю), ничего не изменено.
//
Функция ПодготовленныйОбъектАвтовыпуска(Автовыпуск, Основание)

	Если Автовыпуск = Неопределено Тогда
		Объект = Документы.ВыпускПродукции.СоздатьДокумент();
		ЗаполнитьШапкуАвтовыпуска(Объект, Основание);
		Объект.ДополнительныеСвойства.Вставить(ИмяСвойстваЗаписи(), Основание.Ссылка);
		Объект.Записать(РежимЗаписиДокумента.Запись);
		Объект.ДополнительныеСвойства.Удалить(ИмяСвойстваЗаписи());
		Возврат Объект;
	КонецЕсли;
	Объект = Автовыпуск.ПолучитьОбъект();
	Если Не МожноИзменитьАвтовыпуск(Объект) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Объект.Проведен Тогда
		Для Каждого НаборЗаписей Из Объект.Движения Цикл
			НаборЗаписей.Очистить();
			НаборЗаписей.Записывать = Истина;
		КонецЦикла;
		Объект.Движения.Записать();
	КонецЕсли;
	Возврат Объект;

КонецФункции

// Единственное место, где ставится признак СозданАвтоматически: по нему весь остальной код отличает
// автовыпуск от выпуска, заведённого пользователем (см. ЭтоАвтовыпуск). Вызывается и при создании, и при
// перезаполнении существующего автовыпуска, поэтому признак заодно самовосстанавливается на базе, где
// обработчик обновления 2.0.15.42 не отработал.
//
// Параметры:
//  Объект    - ДокументОбъект.ВыпускПродукции - автовыпуск.
//  Основание - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - документ-основание.
//
Процедура ЗаполнитьШапкуАвтовыпуска(Объект, Основание)

	Объект.Дата = ДатаАвтовыпуска(Основание);
	Объект.Организация = Основание.Организация;
	Объект.Ответственный = Основание.Ответственный;
	Объект.МестоХранения = Основание.МестоХранения;
	// Место оприходования - то же место: выпущенный полуфабрикат обязан лечь туда, откуда его через секунду
	// спишет передача (или отгрузит реализация).
	Объект.МестоХраненияОприходование = Основание.МестоХранения;
	Объект.Основание = Основание.Ссылка;
	Объект.ПометкаУдаления = Ложь;
	Объект.СозданАвтоматически = Истина;
	Если ЭтоПередачаОбъект(Основание) Тогда
		Объект.Комментарий = НСтр("ru = 'Автоматический выпуск при передаче в переработку';
			|fr = 'Production automatique lors du transfert en sous-traitance';
			|en = 'Automatic production output on transfer to subcontracting';
			|es = 'Producción automática en la transferencia a subcontratación'");
	Иначе
		Объект.Комментарий = НСтр("ru = 'Автоматический выпуск при отгрузке';
			|fr = 'Production automatique à l''expédition';
			|en = 'Automatic production output on shipment';
			|es = 'Producción automática en el envío'");
	КонецЕсли;

КонецПроцедуры

// Заполняет объект автовыпуска расчётом: шапка, готовая продукция и материалы. Шапка продукции повторяет первую строку:
// при одной строке синхронизация модуля объекта перестраивает строку из шапки.
//
// Параметры:
//  Объект    - ДокументОбъект.ВыпускПродукции - автовыпуск.
//  Основание - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - документ-основание.
//  Данные    - Структура - см. ДанныеАвтовыпуска.
//
Процедура ЗаполнитьАвтовыпуск(Объект, Основание, Данные)

	ЗаполнитьШапкуАвтовыпуска(Объект, Основание);
	Объект.ТЧГотоваяПродукция.Очистить();
	Для Каждого СтрокаПродукции Из Данные.Продукция Цикл
		Строка = Объект.ТЧГотоваяПродукция.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, СтрокаПродукции, "Номенклатура, Характеристика, Серия, Количество");
		Строка.КоличествоУпаковок = СтрокаПродукции.Количество;
		Строка.КодСтроки = Объект.ТЧГотоваяПродукция.Количество();
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(Объект, Объект.ТЧГотоваяПродукция[0],
		"Номенклатура, Характеристика, Серия, Упаковка, КоличествоУпаковок, Количество");
	Объект.ТЧТовары.Очистить();
	Объект.ТЧСерии.Очистить();
	Для Каждого СтрокаМатериала Из Данные.Материалы Цикл
		Строка = Объект.ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, СтрокаМатериала,
			"Номенклатура, Характеристика, Серия, Партия, Количество, КоличествоЗаЕдиницу");
		Строка.КоличествоУпаковок = СтрокаМатериала.Количество;
		Строка.КодСтроки = Объект.ТЧТовары.Количество();
	КонецЦикла;

КонецПроцедуры

// Проба проведения автовыпуска на самом объекте: проверка заполнения и списание материалов тем же механизмом, что при
// проведении, на тех же данных и том же моменте времени. Движения пробы в базу не пишутся.
//
// Параметры:
//  Объект - ДокументОбъект.ВыпускПродукции - заполненный записанный автовыпуск.
//  Данные - Структура - см. ДанныеАвтовыпуска.
//
// Возвращаемое значение:
//  Булево - Истина, если автовыпуск проведётся.
//
Функция ПробаАвтовыпуска(Объект, Данные)

	Если Не Объект.ПроверитьЗаполнение() Тогда
		СообщитьОтказ(ТекстНеЗаполнен(), Неопределено);
		Возврат Ложь;
	КонецЕсли;
	// «Интерфейс продавца» - существующий способ получить текст ошибки списания свойством, а не сообщением.
	ИмяПризнака = "ЭтоИнтерфейсПродавца";
	ИмяТекста = "ТекстОшибки";
	Объект.ДополнительныеСвойства.Вставить(ИмяПризнака, Истина);
	Списано = РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(Объект);
	ТекстОшибки = "";
	Объект.ДополнительныеСвойства.Свойство(ИмяТекста, ТекстОшибки);
	Объект.ДополнительныеСвойства.Удалить(ИмяПризнака);
	Если Объект.ДополнительныеСвойства.Свойство(ИмяТекста) Тогда
		Объект.ДополнительныеСвойства.Удалить(ИмяТекста);
	КонецЕсли;
	Для Каждого НаборЗаписей Из Объект.Движения Цикл
		НаборЗаписей.Очистить();
	КонецЦикла;
	Если Списано Тогда
		Возврат Истина;
	КонецЕсли;
	Текст = СтрШаблон(ТекстНехваткаМатериалов(), ТекстОшибки);
	Подсказка = ПодсказкаСекунды(Объект, Данные);
	Если ЗначениеЗаполнено(Подсказка) Тогда
		Текст = Текст + Символы.ПС + Подсказка;
	КонецЕсли;
	СообщитьОтказ(Текст, Неопределено);
	Возврат Ложь;

КонецФункции

// Подсказка к отказу списания: в секунду автовыпуска движения тех же материалов пишут другие документы - порядок
// внутри секунды не определён (отклонение от брифа: не отказ, а пояснение).
//
// Параметры:
//  Объект - ДокументОбъект.ВыпускПродукции - автовыпуск.
//  Данные - Структура - см. ДанныеАвтовыпуска.
//
// Возвращаемое значение:
//  Строка - подсказка или пустая строка.
//
Функция ПодсказкаСекунды(Объект, Данные)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 3
	|	Движения.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Движения
	|ГДЕ
	|	Движения.Период = &Период
	|	И Движения.МестоХранения = &Склад
	|	И Движения.Номенклатура В (&Номенклатура)
	|	И Движения.Регистратор <> &Автовыпуск
	|	И Движения.Регистратор <> &Основание
	|
	|УПОРЯДОЧИТЬ ПО
	|	Регистратор");
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("Склад", Объект.МестоХранения);
	Запрос.УстановитьПараметр("Номенклатура", Данные.Материалы.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("Автовыпуск", Объект.Ссылка);
	Запрос.УстановитьПараметр("Основание", Объект.Основание);
	Регистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	Если Регистраторы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Представления = Новый Массив;
	Для Каждого Регистратор Из Регистраторы Цикл
		Представления.Добавить(Строка(Регистратор));
	КонецЦикла;
	Возврат СтрШаблон(ТекстСовпадениеСекунды(), СтрСоединить(Представления, "; "));

КонецФункции

// Распроводит автовыпуск и при необходимости помечает его на удаление; непроведённому только ставит пометку.
//
// Параметры:
//  Автовыпуск - ДокументСсылка.ВыпускПродукции - автовыпуск.
//  Основание  - ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.ПередачаВПереработку - основание.
//  Пометить   - Булево - пометка удаления автовыпуска.
//
// Возвращаемое значение:
//  Булево - Ложь, если автовыпуск лежит в закрытом периоде: он не изменён, пользователю выведено сообщение.
//
Функция ОтменитьПроведениеАвтовыпуска(Автовыпуск, Основание, Пометить)

	Объект = Автовыпуск.ПолучитьОбъект();
	Если Не Объект.Проведен И Объект.ПометкаУдаления = Пометить Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не МожноИзменитьАвтовыпуск(Объект) Тогда
		Возврат Ложь;
	КонецЕсли;
	Объект.ПометкаУдаления = Пометить;
	Объект.ДополнительныеСвойства.Вставить(ИмяСвойстваЗаписи(), Основание);
	Если Объект.Проведен Тогда
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Закрытый период автовыпуска по его текущей дате и организации - та же проверка, что выполнит ПередЗаписью выпуска;
// до записи, чтобы вложенная запись отказом (исключением) не прерывалась.
//
// Параметры:
//  Объект - ДокументОбъект.ВыпускПродукции - автовыпуск.
//
// Возвращаемое значение:
//  Булево - Истина, если автовыпуск можно изменить; Ложь - сообщение пользователю выведено.
//
Функция МожноИзменитьАвтовыпуск(Объект)

	Запрещено = Ложь;
	РаботаСДокументами.МожноРедактироватьДокумент(Объект, Запрещено);
	Возврат Не Запрещено;

КонецФункции

// Автовыпуски сверх первого (старые данные) распроводятся и помечаются до всех проверок.
//
// Параметры:
//  Автовыпуски - Массив из ДокументСсылка.ВыпускПродукции - автовыпуски основания; первый - основной.
//  Основание   - ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.ПередачаВПереработку - основание.
//
// Возвращаемое значение:
//  Булево - Ложь, если лишний автовыпуск лежит в закрытом периоде.
//
Функция РаспровестиЛишниеАвтовыпуски(Автовыпуски, Основание)

	Для Индекс = 1 По Автовыпуски.ВГраница() Цикл
		Если Не ОтменитьПроведениеАвтовыпуска(Автовыпуски[Индекс], Основание, Истина) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ИзОстаткаДляЗаписи(Данные)

	Результат = Новый Структура;
	Если Данные.Заказ <> Неопределено И РегистрыНакопления.ПотребностиПроизводства.ЗаказФормируетПотребность(Данные.Заказ) Тогда
		Результат.Вставить("Заказ", Данные.Заказ);
	Иначе
		Результат.Вставить("Заказ", Неопределено);
	КонецЕсли;
	Результат.Вставить("Строки", Данные.ИзОстатка);
	Возврат Результат;

КонецФункции

Функция ВПределахБлокировки(Данные, Контекст)

	Для Каждого Номенклатура Из Данные.Номенклатура Цикл
		Если Контекст.Номенклатура.Найти(Номенклатура) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Не Данные.Активен Или Контекст.Заказы.Найти(Данные.Заказ) <> Неопределено;

КонецФункции

Процедура ВывестиСообщения(Сообщения)

	Для Каждого Текст Из Сообщения Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЦикла;

КонецПроцедуры

Процедура СообщитьОтказ(Текст, Отказ)

	Если Отказ = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Неопределено, "", "", Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Расчет

// Расчёт автовыпуска документа-основания (план E9, раздел 3; план S4, раздел B.3).
//
// Два канала отличаются источником продукции и норм:
//  - отгрузка: продукция и нормы - из заказа (ПродукцияЗаказа);
//  - передача в переработку: продукция - строки самой передачи, нормы - листья её техкарты (ПродукцияПередачи).
// Покрытие у них одно (S9): сначала свободный складской остаток на складе основания (СвободныйОстатокПродукции),
// потом производство. Потолок Потребность - Выпущено - общий, считается один раз в ДобавитьСтрокиПродукции.
// «ИзОстатка» на ключи потребностей заказа переносится только у передачи: у отгрузки ключ продукции норм - уже
// строка товаров заказа (НормыПоМатериаламЗаказа), то есть ключ потребности.
//
// Параметры:
//  Основание     - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - документ-основание.
//  Автовыпуски   - Массив из ДокументСсылка.ВыпускПродукции - найденные автовыпуски; первый - основной.
//  СПартиями     - Булево - распределять материалы по партиям под заказ (читает остатки); Ложь - только состав.
//  Момент        - МоментВремени, Неопределено - момент границы складских остатков, посчитанный вызывающим один
//                  раз на оба прохода; Неопределено - посчитать по Автовыпуски.
//  ПолныйСостав  - Булево - Истина: складской остаток из количества продукции НЕ вычитается - состав для
//                  блокировки (см. КонтекстАвтовыпуска), в обоих каналах.
//
// Возвращаемое значение:
//  Структура - см. ДанныеАвтовыпуска.
//
Функция РассчитатьАвтовыпуск(Основание, Автовыпуски, СПартиями, Момент = Неопределено, ПолныйСостав = Ложь)

	Данные = НовыеДанныеАвтовыпуска(Основание);
	Если Не Данные.Управляется Или Не ПроизводственныеЗаказы.ЭтоЗаказНаПроизводство(Основание.Основание) Тогда
		Возврат Данные;
	КонецЕсли;
	Данные.Активен = Истина;
	Данные.Заказ = Основание.Основание;
	Данные.Момент = ?(Момент = Неопределено, МоментГраницыОстатков(Данные.Дата, Автовыпуски), Момент);
	ЭтоКаналПередачи = ЭтоПередачаОбъект(Основание);
	Если ЭтоКаналПередачи Тогда
		Состав = ПродукцияПередачи(Данные, Основание);
	Иначе
		Состав = ПродукцияЗаказа(Данные.Заказ, Данные.Дата);
	КонецЕсли;
	Если Состав.Продукция.Количество() = 0 Тогда
		Возврат Данные;
	КонецЕсли;
	Прошлое = ВыпущеноОтгруженоИПереданоРанее(Основание, Данные.Заказ);
	СтрокиСписания = СерииИРазмещение.ОбъединитьТоварыССериями(Основание);
	Если ПолныйСостав Тогда
		Остатки = НоваяТаблицаОстатковПродукции();
	Иначе
		Остатки = СвободныйОстатокПродукции(Данные, ПродукцияСтрокСписания(Состав.Продукция, СтрокиСписания), Основание,
			Автовыпуски);
	КонецЕсли;
	Потребности = НабратьПродукциюИПотребности(Данные, Состав, СтрокиСписания, Прошлое, Остатки);
	Если Данные.Продукция.Количество() = 0 Тогда
		Возврат Данные;
	КонецЕсли;
	РаспределитьМатериалы(Данные, Потребности, Автовыпуски, СПартиями);
	Если ЭтоКаналПередачи Тогда
		ПеренестиИзОстаткаНаПотребности(Данные, Автовыпуски);
	КонецЕсли;
	ДобавитьЗначения(Данные.Номенклатура, Данные.Продукция.ВыгрузитьКолонку("Номенклатура"));
	ДобавитьЗначения(Данные.Номенклатура, Данные.Материалы.ВыгрузитьКолонку("Номенклатура"));
	Возврат Данные;

КонецФункции

// Строки продукции к выпуску и потребности её материалов - по всем позициям состава. Продукция, у которой к
// выпуску вышел ноль, в выпуск не идёт; продукция, на количество которой не приходится ни одного материала, -
// с сообщением, но без отказа.
//
// Параметры:
//  Данные         - Структура - см. ДанныеАвтовыпуска; заполняются Продукция и Сообщения.
//  Состав         - Структура - см. ПродукцияЗаказа, ПродукцияПередачи.
//  СтрокиСписания - ТаблицаЗначений - строки основания с развёрнутыми сериями.
//  Прошлое        - ТаблицаЗначений - см. ВыпущеноОтгруженоИПереданоРанее.
//  Остатки        - ТаблицаЗначений - см. ДобавитьСтрокиПродукции.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаМатериалов, в порядке продукции состава.
//
Функция НабратьПродукциюИПотребности(Данные, Состав, СтрокиСписания, Прошлое, Остатки)

	Потребности = НоваяТаблицаМатериалов();
	Для Каждого Продукция Из Состав.Продукция Цикл
		СтрокиКВыпуску = Данные.Продукция.СкопироватьКолонки();
		КВыпуску = ДобавитьСтрокиПродукции(СтрокиКВыпуску, СтрокиСписания, Продукция, Прошлое, Остатки);
		Если КВыпуску <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Нормы = Состав.Нормы.НайтиСтроки(Новый Структура("Продукция", Продукция.Номенклатура));
		Если Не ДобавитьПотребностиПродукции(Потребности, Продукция, КВыпуску, Нормы) Тогда
			Данные.Сообщения.Добавить(СтрШаблон(ТекстНетМатериалов(), Продукция.Номенклатура));
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаКВыпуску Из СтрокиКВыпуску Цикл
			ЗаполнитьЗначенияСвойств(Данные.Продукция.Добавить(), СтрокаКВыпуску);
		КонецЦикла;
	КонецЦикла;
	Возврат Потребности;

КонецФункции

// Граница складских остатков автовыпуска: момент существующего автовыпуска, а при его отсутствии - момент даты.
// Считается ОДИН раз на оба прохода расчёта (см. ОбеспечитьАвтовыпуск): посчитанная проходом, она на первом
// проходе вырождалась бы в момент даты (ссылки нового автовыпуска ещё нет), а на втором брала бы ссылку - и
// приход, прошедший в ту же секунду, попадал бы в остаток только на втором проходе.
//
// Параметры:
//  ДатаАвтовыпуска - Дата - дата автовыпуска.
//  Автовыпуски     - Массив из ДокументСсылка.ВыпускПродукции - найденные автовыпуски; первый - основной.
//
// Возвращаемое значение:
//  МоментВремени - момент для границы «исключая».
//
Функция МоментГраницыОстатков(ДатаАвтовыпуска, Автовыпуски)

	Если Автовыпуски.Количество() = 0 Тогда
		Возврат Новый МоментВремени(ДатаАвтовыпуска);
	КонецЕсли;
	// Дата берётся МЕНЬШАЯ из двух: движения существующего автовыпуска лежат на ЕГО дате, а не на новой.
	// Пользователь сдвинул дату проведённой передачи вперёд - граница по новой дате его собственный приход
	// уже не отсекает, остаток выходит покрытым, «к выпуску» - нулём, автовыпуск распроводится и помечается
	// на удаление, полуфабрикат со склада исчезает, и передача отказывает по нехватке навсегда.
	ДатаВБазе = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуски[0], "Дата");
	Если ТипЗнч(ДатаВБазе) = Тип("Дата") И ДатаВБазе < ДатаАвтовыпуска Тогда
		Возврат Новый МоментВремени(ДатаВБазе, Автовыпуски[0]);
	КонецЕсли;
	Возврат Новый МоментВремени(ДатаАвтовыпуска, Автовыпуски[0]);

КонецФункции

Функция НовыеДанныеАвтовыпуска(Основание)

	Данные = Новый Структура;
	Данные.Вставить("Управляется", МеханизмУправляетАвтовыпуском(Основание));
	Данные.Вставить("Активен", Ложь);
	Данные.Вставить("Заказ", Неопределено);
	Данные.Вставить("Дата", ДатаАвтовыпуска(Основание));
	Данные.Вставить("Момент", Неопределено);
	Данные.Вставить("Склад", Основание.МестоХранения);
	Продукция = Новый ТаблицаЗначений;
	Продукция.Колонки.Добавить("Номенклатура", ОписаниеТипаНоменклатуры());
	Продукция.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Продукция.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	Продукция.Колонки.Добавить("Количество", ТипКоличества());
	Данные.Вставить("Продукция", Продукция);
	Материалы = Продукция.СкопироватьКолонки();
	Материалы.Колонки.Добавить("Партия", Метаданные.ОпределяемыеТипы.ПриходныйДокументПартии.Тип);
	Материалы.Колонки.Добавить("КоличествоЗаЕдиницу", Новый ОписаниеТипов("Число"));
	Данные.Вставить("Материалы", Материалы);
	ИзОстатка = Новый ТаблицаЗначений;
	ИзОстатка.Колонки.Добавить("Продукция", ОписаниеТипаНоменклатуры());
	ИзОстатка.Колонки.Добавить("Материал", ОписаниеТипаНоменклатуры());
	ИзОстатка.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ИзОстатка.Колонки.Добавить("Количество", ТипКоличества());
	Данные.Вставить("ИзОстатка", ИзОстатка);
	Данные.Вставить("Номенклатура", Новый Массив);
	Данные.Вставить("Сообщения", Новый Массив);
	Возврат Данные;

