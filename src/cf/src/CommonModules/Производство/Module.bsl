КонецФункции

// Производимая продукция заказа и нормы материалов на базовую единицу (план E9, п. 3.2). Одна продукция в заказе
// производится по одному составу (E5), поэтому нормы - по номенклатуре продукции.
//
// Параметры:
//  Заказ          - ДокументСсылка.ЗаказПокупателя - заказ на производство.
//  ДатаАвтовыпуска - Дата - дата техкарт продукции без материалов.
//
// Возвращаемое значение:
//  Структура:
//   * Продукция - ТаблицаЗначений - Номенклатура, Характеристика, Потребность - в порядке строк заказа.
//   * Нормы     - ТаблицаЗначений - Продукция, Номенклатура, Характеристика, Норма, ПоЗаказу.
//
Функция ПродукцияЗаказа(Заказ, ДатаАвтовыпуска)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество,
	|	СправочникНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	СправочникНоменклатура.СпособПополнения КАК СпособПополнения
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Товары.Номенклатура = СправочникНоменклатура.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.КодСтроки КАК КодСтроки,
	|	Материалы.КодСтрокиРодителя КАК КодСтрокиРодителя,
	|	Материалы.КодСтрокиПродукции КАК КодСтрокиПродукции,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.Характеристика КАК Характеристика,
	|	Материалы.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧМатериалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Результаты = Запрос.ВыполнитьПакет();
	Строки = Результаты[0].Выгрузить();
	МатериалыЗаказа = Результаты[1].Выгрузить();

	НормыЗаказа = НормыПоМатериаламЗаказа(Строки, МатериалыЗаказа);
	Результат = Новый Структура;
	Результат.Вставить("Нормы", НормыЗаказа.Нормы);
	Продукция = НоваяТаблицаПродукции();
	Результат.Вставить("Продукция", Продукция);

	БезМатериалов = Новый Массив;
	Для Каждого СтрокаЗаказа Из Строки Цикл
		ПоЗаказу = НормыЗаказа.ПродукцияСМатериалами.Найти(СтрокаЗаказа.Номенклатура) <> Неопределено;
		Если Не ПоЗаказу И Не ПроизводитсяПоТехкарте(СтрокаЗаказа) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПоЗаказу И БезМатериалов.Найти(СтрокаЗаказа.Номенклатура) = Неопределено Тогда
			БезМатериалов.Добавить(СтрокаЗаказа.Номенклатура);
		КонецЕсли;
		Отбор = Новый Структура("Номенклатура, Характеристика", СтрокаЗаказа.Номенклатура, СтрокаЗаказа.Характеристика);
		Найденные = Продукция.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			СтрокаПродукции = Продукция.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПродукции, Отбор);
		Иначе
			СтрокаПродукции = Найденные[0];
		КонецЕсли;
		СтрокаПродукции.Потребность = СтрокаПродукции.Потребность + СтрокаЗаказа.Количество;
	КонецЦикла;
	ДобавитьПотребностьИзМатериалов(Продукция, МатериалыЗаказа);
	ДобавитьНормыПоТехкартам(Результат, БезМатериалов, ДатаАвтовыпуска);
	Возврат Результат;

КонецФункции

// Таблица продукции автовыпуска с потолком потребности - одна на оба канала.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Потребность.
//
Функция НоваяТаблицаПродукции()

	Продукция = Новый ТаблицаЗначений;
	Продукция.Колонки.Добавить("Номенклатура", ОписаниеТипаНоменклатуры());
	Продукция.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Продукция.Колонки.Добавить("Потребность", Новый ОписаниеТипов("Число"));
	Возврат Продукция;

КонецФункции

// Потребность заказа в позиции - это и строки товаров, и строки материалов: одна и та же номенклатура бывает
// одновременно продукцией заказа и материалом другой его строки, а у канала передачи потребность в полуфабрикате
// лежит ТОЛЬКО в материалах. Известное огрубление (риск 6 плана S4): номенклатура, входящая и узлом, и листом под
// разные продукции, потолок завысит; потолок только ограничивает, поэтому завышение безопасно.
//
// Параметры:
//  Продукция       - ТаблицаЗначений - см. НоваяТаблицаПродукции; пополняется потребность существующих строк.
//  МатериалыЗаказа - ТаблицаЗначений - строки материалов заказа, включая строки с пустой номенклатурой.
//
Процедура ДобавитьПотребностьИзМатериалов(Продукция, МатериалыЗаказа)

	Для Каждого Материал Из МатериалыЗаказа Цикл
		Если Не ЗначениеЗаполнено(Материал.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("Номенклатура, Характеристика", Материал.Номенклатура, Материал.Характеристика);
		Найденные = Продукция.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			// Строки продукции набирает вызывающий: материалы только поднимают потолок уже набранных позиций.
			Продолжить;
		КонецЕсли;
		Найденные[0].Потребность = Найденные[0].Потребность + Материал.Количество;
	КонецЦикла;

КонецПроцедуры

// Нормы материалов заказа на базовую единицу продукции: сумма материалов строк продукции с материалами, делённая на
// сумму количеств этих строк.
// Материалы заказа - дерево (продукция -> полуфабрикат -> материалы), и списываются только ЛИСТЬЯ: разворачиваемый
// полуфабрикат на складе не лежит, его делают из его же материалов. Списывай автовыпуск и узел, и его сырьё - при
// отгрузке получилась бы либо недостача полуфабриката, либо двойной расход. Автовыпуск полуфабрикатов отдельным
// выпуском - это S4; до него продукция делается из листьев дерева в один шаг.
// У плоского заказа листья - все строки, поведение прежнее.
//
// Параметры:
//  Строки          - ТаблицаЗначений - строки товаров заказа.
//  МатериалыЗаказа - ТаблицаЗначений - строки материалов заказа, включая строки с пустой номенклатурой: правило
//                    листа считается по всем строкам, как в ПотребностиПроизводства.ПотребностьЗаказаКлиента.
//
// Возвращаемое значение:
//  Структура - Нормы (ТаблицаЗначений), ПродукцияСМатериалами (Массив).
//
Функция НормыПоМатериаламЗаказа(Строки, МатериалыЗаказа)

	Нормы = НоваяТаблицаМатериалов();
	ПродукцияКодов = Новый Соответствие;
	КоличествоПродукции = Новый Соответствие;
	СобратьПродукциюСМатериалами(Строки, МатериалыЗаказа, ПродукцияКодов, КоличествоПродукции);
	СПотомками = Документы.ЗаказПокупателя.КодыСтрокСПотомками(МатериалыЗаказа);
	ПродукцияСМатериалами = Новый Массив;
	Для Каждого Материал Из МатериалыЗаказа Цикл
		Продукция = ПродукцияКодов[Материал.КодСтрокиПродукции];
		Ключ = Документы.ЗаказПокупателя.КлючРодителяМатериала(Материал.КодСтрокиПродукции, Материал.КодСтроки);
		Если Продукция = Неопределено Или Не ЗначениеЗаполнено(Материал.Номенклатура)
			Или СПотомками[Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ПродукцияСМатериалами.Найти(Продукция) = Неопределено Тогда
			ПродукцияСМатериалами.Добавить(Продукция);
		КонецЕсли;
		Строка = Нормы.Добавить();
		Строка.Продукция = Продукция;
		Строка.Номенклатура = Материал.Номенклатура;
		Строка.Характеристика = Материал.Характеристика;
		Строка.Количество = Материал.Количество;
		Строка.ПоЗаказу = Истина;
	КонецЦикла;
	Нормы.Свернуть("Продукция, Номенклатура, Характеристика, ПоЗаказу", "Количество");
	Нормы.Колонки.Добавить("Норма", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Нормы Цикл
		Всего = КоличествоПродукции[Строка.Продукция];
		Строка.Норма = ?(Всего = Неопределено Или Всего = 0, 0, Строка.Количество / Всего);
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("Нормы", Нормы);
	Результат.Вставить("ПродукцияСМатериалами", ПродукцияСМатериалами);
	Возврат Результат;

КонецФункции

// Продукция строк заказа с материалами: номенклатура по коду строки и суммарное количество таких строк.
//
// Параметры:
//  Строки              - ТаблицаЗначений - строки товаров заказа.
//  МатериалыЗаказа     - ТаблицаЗначений - строки материалов заказа.
//  ПродукцияКодов      - Соответствие - ключ код строки, значение номенклатура; заполняется.
//  КоличествоПродукции - Соответствие - ключ номенклатура, значение количество строк с материалами; заполняется.
//
Процедура СобратьПродукциюСМатериалами(Строки, МатериалыЗаказа, ПродукцияКодов, КоличествоПродукции)

	КодыСМатериалами = Новый Соответствие;
	Для Каждого Материал Из МатериалыЗаказа Цикл
		// Строка с пустым материалом «материалами» продукцию не делает: раньше её отсекал запрос, а он
		// теперь отдаёт все строки - правило листа обязано считаться по полному набору.
		Если ЗначениеЗаполнено(Материал.Номенклатура) Тогда
			КодыСМатериалами.Вставить(Материал.КодСтрокиПродукции, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаЗаказа Из Строки Цикл
		Если КодыСМатериалами[СтрокаЗаказа.КодСтроки] = Неопределено
			Или ПродукцияКодов[СтрокаЗаказа.КодСтроки] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПродукцияКодов.Вставить(СтрокаЗаказа.КодСтроки, СтрокаЗаказа.Номенклатура);
		Итог = КоличествоПродукции[СтрокаЗаказа.Номенклатура];
		КоличествоПродукции.Вставить(СтрокаЗаказа.Номенклатура, ?(Итог = Неопределено, 0, Итог) + СтрокаЗаказа.Количество);
	КонецЦикла;

КонецПроцедуры

// Нормы продукции без материалов по техкартам на дату автовыпуска; продукция без карты из производимой убирается.
//
// Параметры:
//  Результат       - Структура - см. ПродукцияЗаказа.
//  БезМатериалов   - Массив из СправочникСсылка.Номенклатура - продукция без материалов в заказе.
//  ДатаАвтовыпуска - Дата - дата среза карт.
//
Процедура ДобавитьНормыПоТехкартам(Результат, БезМатериалов, ДатаАвтовыпуска)

	Если БезМатериалов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Коэффициенты = Новый Соответствие;
	СКартой = Новый Массив;
	Для Каждого СтрокаКарты Из ТехнологическиеКарты.СоставТехкарт(БезМатериалов, ДатаАвтовыпуска) Цикл
		Коэффициент = 1;
		Если ЗначениеЗаполнено(СтрокаКарты.Упаковка) Тогда
			Коэффициент = Коэффициенты[СтрокаКарты.Упаковка];
			Если Коэффициент = Неопределено Тогда
				Коэффициент = ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы(СтрокаКарты.Упаковка);
				Коэффициенты.Вставить(СтрокаКарты.Упаковка, Коэффициент);
			КонецЕсли;
		КонецЕсли;
		Строка = Результат.Нормы.Добавить();
		Строка.Продукция = СтрокаКарты.Продукция;
		Строка.Номенклатура = СтрокаКарты.Номенклатура;
		Строка.Характеристика = СтрокаКарты.Характеристика;
		Строка.Норма = СтрокаКарты.Количество * Коэффициент;
		Если СКартой.Найти(СтрокаКарты.Продукция) = Неопределено Тогда
			СКартой.Добавить(СтрокаКарты.Продукция);
		КонецЕсли;
	КонецЦикла;
	Индекс = Результат.Продукция.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Номенклатура = Результат.Продукция[Индекс].Номенклатура;
		Если БезМатериалов.Найти(Номенклатура) <> Неопределено И СКартой.Найти(Номенклатура) = Неопределено Тогда
			Результат.Продукция.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Продукция автовыпуска при передаче в переработку и нормы её материалов (план S4, B.3). Симметрична
// ПродукцияЗаказа, но берёт продукцию из строк САМОЙ ПЕРЕДАЧИ, а нормы - из развёрнутой техкарты, а не из
// поддерева материалов заказа: полуфабрикат в строках товаров заказа не лежит, он узел ТЧМатериалы, и нормы его
// строк заданы на единицу продукции ВЕРХНЕГО уровня - чтобы получить норму на единицу полуфабриката, пришлось бы
// делить норму листа на норму узла, то есть вернуть потерю точности туда, откуда её только что убрали. Поддерево
// заказа построено из тех же карт, поэтому обращение к карте даёт тот же состав без деления.
//
// Сырьё и покупные позиции проходят мимо: строка идёт в выпуск только по правилу ПроизводитсяПоТехкарте - тому
// же, которым волна останавливает разворачивание карты. Своей копии правила здесь нет намеренно.
//
// Параметры:
//  Данные   - Структура - см. ДанныеАвтовыпуска; пополняются Сообщения.
//  Передача - ДокументОбъект.ПередачаВПереработку - проводимая передача.
//
// Возвращаемое значение:
//  Структура:
//   * Продукция - ТаблицаЗначений - см. НоваяТаблицаПродукции.
//   * Нормы     - ТаблицаЗначений - см. НоваяТаблицаМатериалов.
//
Функция ПродукцияПередачи(Данные, Передача)

	Результат = Новый Структура;
	Результат.Вставить("Нормы", НоваяТаблицаМатериалов());
	Результат.Вставить("Продукция", НоваяТаблицаПродукции());
	Позиции = Новый Массив;
	ДобавитьЗначения(Позиции, Передача.ТЧТовары.ВыгрузитьКолонку("Номенклатура"));
	Если Позиции.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Свойства = СвойстваНоменклатуры(Позиции);
	Производимые = Новый Массив;
	Для Каждого СтрокаТоваров Из Передача.ТЧТовары Цикл
		СтрокаСвойств = Свойства[СтрокаТоваров.Номенклатура];
		Если СтрокаСвойств = Неопределено Или Не ПроизводитсяПоТехкарте(СтрокаСвойств) Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("Номенклатура, Характеристика", СтрокаТоваров.Номенклатура, СтрокаТоваров.Характеристика);
		Если Результат.Продукция.НайтиСтроки(Отбор).Количество() = 0 Тогда
			ЗаполнитьЗначенияСвойств(Результат.Продукция.Добавить(), Отбор);
		КонецЕсли;
		ДобавитьЗначения(Производимые, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаТоваров.Номенклатура));
	КонецЦикла;
	Если Результат.Продукция.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	ЗаполнитьПотребностьПередачи(Результат.Продукция, Данные, Производимые);
	ДобавитьНормыРазвернутогоСостава(Результат, Данные, Производимые);
	Возврат Результат;

КонецФункции

// Тип номенклатуры и способ пополнения позиций - одним запросом: их читает ПроизводитсяПоТехкарте.
//
// Параметры:
//  Позиции - Массив из СправочникСсылка.Номенклатура - позиции.
//
// Возвращаемое значение:
//  Соответствие - ключ номенклатура, значение Структура с ТипНоменклатуры и СпособПополнения.
//
Функция СвойстваНоменклатуры(Позиции)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	Номенклатура.СпособПополнения КАК СпособПополнения
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Позиции)");
	Запрос.УстановитьПараметр("Позиции", Позиции);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Свойства = Новый Структура("ТипНоменклатуры, СпособПополнения", Выборка.ТипНоменклатуры, Выборка.СпособПополнения);
		Результат.Вставить(Выборка.Ссылка, Свойства);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Потолок потребности передаваемых позиций по заказу: строки товаров плюс строки материалов этой номенклатуры.
// Нулевая потребность у позиции, производимой по техкарте, - сообщение, а не молчаливый ноль: заказ, в котором
// полуфабриката нет ни в товарах, ни в материалах, автовыпуска не получит, и пользователь должен знать почему.
//
// Параметры:
//  Продукция - ТаблицаЗначений - см. НоваяТаблицаПродукции; заполняется потребность.
//  Данные    - Структура - см. ДанныеАвтовыпуска; пополняются Сообщения.
//  Позиции   - Массив из СправочникСсылка.Номенклатура - производимые позиции передачи.
//
Процедура ЗаполнитьПотребностьПередачи(Продукция, Данные, Позиции)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Потребность.Номенклатура КАК Номенклатура,
	|	Потребность.Характеристика КАК Характеристика,
	|	СУММА(Потребность.Количество) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		Товары.Номенклатура КАК Номенклатура,
	|		Товары.Характеристика КАК Характеристика,
	|		Товары.Количество КАК Количество
	|	ИЗ
	|		Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|	ГДЕ
	|		Товары.Ссылка = &Заказ
	|		И Товары.Номенклатура В (&Позиции)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Материалы.Номенклатура,
	|		Материалы.Характеристика,
	|		Материалы.Количество
	|	ИЗ
	|		Документ.ЗаказПокупателя.ТЧМатериалы КАК Материалы
	|	ГДЕ
	|		Материалы.Ссылка = &Заказ
	|		И Материалы.Номенклатура В (&Позиции)) КАК Потребность
	|
	|СГРУППИРОВАТЬ ПО
	|	Потребность.Номенклатура,
	|	Потребность.Характеристика");
	Запрос.УстановитьПараметр("Заказ", Данные.Заказ);
	Запрос.УстановитьПараметр("Позиции", Позиции);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика", Выборка.Номенклатура, Выборка.Характеристика);
		Найденные = Продукция.НайтиСтроки(Отбор);
		Если Найденные.Количество() > 0 Тогда
			Найденные[0].Потребность = Найденные[0].Потребность + Выборка.Количество;
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаПродукции Из Продукция Цикл
		Если СтрокаПродукции.Потребность = 0 Тогда
			Данные.Сообщения.Добавить(СтрШаблон(ТекстНетПотребности(), СтрокаПродукции.Номенклатура));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Нормы по листьям развёрнутой техкарты передаваемых позиций. Количество листа уже посчитано на единицу
// продукции по цепочке уровней с разрядностью нормы расхода, поэтому берётся как есть, без деления.
// Узлы (ЕстьПотомки) пропускаются: списываются только листья, иначе полуфабрикат ушёл бы в расход дважды.
// Позиция без действующей карты убирается из выпускаемой продукции с сообщением - так же, как это делает
// ДобавитьНормыПоТехкартам у канала отгрузки, но с сообщением: у передачи это единственный признак того,
// что карты нет.
//
// Параметры:
//  Результат - Структура - см. ПродукцияПередачи; заполняются Нормы, чистится Продукция.
//  Данные    - Структура - см. ДанныеАвтовыпуска; пополняются Сообщения.
//  Позиции   - Массив из СправочникСсылка.Номенклатура - производимые позиции передачи.
//
Процедура ДобавитьНормыРазвернутогоСостава(Результат, Данные, Позиции)

	Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Позиции, Данные.Дата);
	Для Каждого Ошибка Из Развернутый.Ошибки Цикл
		Данные.Сообщения.Добавить(Ошибка.Текст);
	КонецЦикла;
	СКартой = Новый Массив;
	Для Каждого СтрокаСостава Из Развернутый.Строки Цикл
		Если СтрокаСостава.ЕстьПотомки Тогда
			Продолжить;
		КонецЕсли;
		Норма = Результат.Нормы.Добавить();
		Норма.Продукция = СтрокаСостава.Продукция;
		Норма.Номенклатура = СтрокаСостава.Номенклатура;
		Норма.Характеристика = СтрокаСостава.Характеристика;
		Норма.Норма = СтрокаСостава.КоличествоБазовое;
		// Листья карты полуфабриката - те же позиции, что лежат листьями его поддерева в заказе, то есть
		// потребности заказа они несут. Ключ продукции у них другой (сам полуфабрикат, а не верхнеуровневая
		// позиция заказа), поэтому движения «ИзОстатка» переносятся на ключи заказа отдельным шагом -
		// ПеренестиИзОстаткаНаПотребности. Без этого ДефицитЗаказа поехал бы.
		Норма.ПоЗаказу = Истина;
		ДобавитьЗначения(СКартой, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаСостава.Продукция));
	КонецЦикла;
	Индекс = Результат.Продукция.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Номенклатура = Результат.Продукция[Индекс].Номенклатура;
		Если СКартой.Найти(Номенклатура) = Неопределено Тогда
			Данные.Сообщения.Добавить(СтрШаблон(ТекстНетМатериалов(), Номенклатура));
			Результат.Продукция.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Свободный складской остаток продукции на складе основания - база покрытия автовыпуска в обоих каналах (S9): что
// свободно лежит на складе, то не выпускается. Сначала склад, потом производство - правило одно для отгрузки и
// передачи в переработку, разделения на остаток «по этому заказу» и чужой нет (решение владельца S9).
//
// Свободный - это не остаток на границе, а МИНИМУМ нарастающего остатка от границы до конца: документ, проведённый
// задним числом, не должен забирать то, что уже израсходовали более поздние документы, иначе они молча уходят в
// минус (контроль остатков смотрит момент проводимого документа, а не последующие). Так же и внутри одной секунды:
// две реализации одного заказа в одну секунду не зачитывают друг другу приход своих автовыпусков.
//
// Граница - НАЧАЛО секунды момента границы, и все движения этой секунды считаются последующими; внутри секунды
// сначала вычитаются расходы, потом прибавляются приходы. Порядок документов внутри секунды запросом надёжно не
// воспроизводится, поэтому правило намеренно консервативно: результат никогда не больше точного.
//
// Собственные движения исключаются явно: основание - для расчёта по уже проведённому документу (при проведении их
// удалило AutoDelete), автовыпуски основания - на первом проходе их движения ещё в базе, а при сдвиге даты вперёд
// граница стоит на их прежней дате (см. МоментГраницыОстатков).
//
// Документное «свободно» (выпущено минус отгружено и передано) не вычитается ни в одном канале: ручной выпуск, уже
// израсходованный как материал, дал бы «к выпуску = 0» и отказ по нехватке продукции, которой физически нет.
//
// Параметры:
//  Данные       - Структура - см. ДанныеАвтовыпуска.
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - продукция из строк списания основания.
//  Основание    - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - документ-основание.
//  Автовыпуски  - Массив из ДокументСсылка.ВыпускПродукции - автовыпуски основания.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаОстатковПродукции; только строки с положительным свободным остатком.
//
Функция СвободныйОстатокПродукции(Данные, Номенклатура, Основание, Автовыпуски)

	Результат = НоваяТаблицаОстатковПродукции();
	Если Номенклатура.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	НачалоСекунды = Данные.Момент.Дата;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			&Граница,
	|			МестоХранения = &Склад
	|				И Номенклатура В (&Номенклатура)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика,
	|	Остатки.Серия
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.КоличествоОстаток) > 0");
	Запрос.УстановитьПараметр("Граница", Новый Граница(НачалоСекунды, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Склад", Данные.Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	НаГранице = Запрос.Выполнить().Выгрузить();
	// Ключ без положительного остатка на границе свободного не даёт: минимум не больше начального значения.
	Если НаГранице.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Последующие = ПоследующиеДвиженияПродукции(Данные.Склад, НачалоСекунды, Номенклатура, Основание, Автовыпуски);
	Для Каждого Остаток Из НаГранице Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика, Серия", Остаток.Номенклатура, Остаток.Характеристика,
			Остаток.Серия);
		Текущий = Остаток.Количество;
		Минимум = Текущий;
		// НайтиСтроки без индекса сохраняет порядок таблицы, а она упорядочена по секундам. Индекс не ставить: у
		// индексированной таблицы порядок одинаковых ключей не гарантирован, и минимум посчитался бы неверно.
		Для Каждого Секунда Из Последующие.НайтиСтроки(Отбор) Цикл
			Текущий = Текущий - Секунда.Расход;
			Минимум = Мин(Минимум, Текущий);
			Текущий = Текущий + Секунда.Приход;
		КонецЦикла;
		Если Минимум > 0 Тогда
			Строка = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, Отбор);
			Строка.Количество = Минимум;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Движения продукции на складе с начала секунды границы и позже, кроме движений основания и его автовыпусков, -
// расход и приход по секундам.
//
// Параметры:
//  Склад         - СправочникСсылка.МестаХранения - склад основания.
//  НачалоСекунды - Дата - секунда границы; её движения входят.
//  Номенклатура  - Массив из СправочникСсылка.Номенклатура - продукция.
//  Основание     - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - документ-основание.
//  Автовыпуски   - Массив из ДокументСсылка.ВыпускПродукции - автовыпуски основания.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Серия, Период, Расход, Приход; по возрастанию периода.
//
Функция ПоследующиеДвиженияПродукции(Склад, НачалоСекунды, Номенклатура, Основание, Автовыпуски)

	Исключаемые = Новый Массив;
	ДобавитьЗначения(Исключаемые, Автовыпуски);
	Исключаемые.Добавить(Основание.Ссылка);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Движения.Номенклатура КАК Номенклатура,
	|	Движения.Характеристика КАК Характеристика,
	|	Движения.Серия КАК Серия,
	|	Движения.Период КАК Период,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Расход,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Приход
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Движения
	|ГДЕ
	|	Движения.Период >= &НачалоСекунды
	|	И Движения.МестоХранения = &Склад
	|	И Движения.Номенклатура В (&Номенклатура)
	|	И Движения.Активность
	|	И НЕ Движения.Регистратор В (&Исключаемые)
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.Номенклатура,
	|	Движения.Характеристика,
	|	Движения.Серия,
	|	Движения.Период
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период");
	Запрос.УстановитьПараметр("НачалоСекунды", НачалоСекунды);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Исключаемые", Исключаемые);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Пустая таблица остатков продукции - для расчёта полного состава под блокировку (см. КонтекстАвтовыпуска):
// покрытия нет, вычитать нечего, номенклатура набирается по всем передаваемым позициям и листьям их карт.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. СвободныйОстатокПродукции.
//
Функция НоваяТаблицаОстатковПродукции()

	Остатки = Новый ТаблицаЗначений;
	Остатки.Колонки.Добавить("Номенклатура", ОписаниеТипаНоменклатуры());
	Остатки.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Остатки.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	Остатки.Колонки.Добавить("Количество", ТипКоличества());
	Возврат Остатки;

КонецФункции

// Продукция состава, которая есть в строках списания основания: только её свободный остаток нужен расчёту. У
// отгрузки состав - вся продукция заказа, а не строки реализации, и читать остальное незачем.
//
// Параметры:
//  Продукция      - ТаблицаЗначений - см. НоваяТаблицаПродукции.
//  СтрокиСписания - ТаблицаЗначений - строки основания с развёрнутыми сериями.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - без повторов.
//
Функция ПродукцияСтрокСписания(Продукция, СтрокиСписания)

	Результат = Новый Массив;
	Для Каждого СтрокаПродукции Из Продукция Цикл
		Если СтрокиСписания.Найти(СтрокаПродукции.Номенклатура, "Номенклатура") <> Неопределено
			И Результат.Найти(СтрокаПродукции.Номенклатура) = Неопределено Тогда
			Результат.Добавить(СтрокаПродукции.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Переносит «ИзОстатка» автовыпуска полуфабриката на ключи потребностей заказа. ПотребностьЗаказаКлиента пишет
// листья под продукцию из ТЧТовары заказа, а нормы автовыпуска полуфабриката такой связи не содержат: их ключ
// продукции - сам полуфабрикат. Без переноса движения легли бы не под те ключи и ДефицитЗаказа поехал бы.
// Распределение ограничивается непокрытым количеством потребности (ДефицитЗаказа без движений самого
// автовыпуска); излишек движения не даёт - иначе дефицит ушёл бы в минус.
//
// Параметры:
//  Данные      - Структура - см. ДанныеАвтовыпуска; ИзОстатка переписывается.
//  Автовыпуски - Массив из ДокументСсылка.ВыпускПродукции - найденные автовыпуски; первый - основной.
//
Процедура ПеренестиИзОстаткаНаПотребности(Данные, Автовыпуски)

	Если Данные.ИзОстатка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Исключаемый = ?(Автовыпуски.Количество() > 0, Автовыпуски[0], Неопределено);
	Дефицит = РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа(Данные.Заказ, Исключаемый);
	Результат = Данные.ИзОстатка.СкопироватьКолонки();
	Для Каждого Строка Из Данные.ИзОстатка Цикл
		Осталось = Строка.Количество;
		Отбор = Новый Структура("Материал, Характеристика", Строка.Материал, Строка.Характеристика);
		Для Каждого СтрокаДефицита Из Дефицит.НайтиСтроки(Отбор) Цикл
			Если Осталось <= 0 Тогда
				Прервать;
			КонецЕсли;
			Часть = Мин(Осталось, СтрокаДефицита.Количество);
			Если Часть <= 0 Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Продукция = СтрокаДефицита.Продукция;
			НоваяСтрока.Материал = Строка.Материал;
			НоваяСтрока.Характеристика = Строка.Характеристика;
			НоваяСтрока.Количество = Часть;
			СтрокаДефицита.Количество = СтрокаДефицита.Количество - Часть;
			Осталось = Осталось - Часть;
		КонецЦикла;
	КонецЦикла;
	Результат.Свернуть("Продукция, Материал, Характеристика", "Количество");
	Данные.ИзОстатка = Результат;

КонецПроцедуры

// Выпущено, отгружено и передано по заказу документами, предшествующими основанию по моменту времени (план E9,
// п. 3.1; план S4, B.3 п. 4). Один свод на оба канала, параметризованный основанием и текущим комплектом
// документов: реализация исключает себя из отгрузок, передача - себя из выпусков и передач. Отдельной копии
// подзапроса выпусков с разворачиванием серий у канала передачи нет намеренно - разойдясь, они завели бы дубли.
//
// В «Выпущено» входят: выпуски по заказу, выпуски по предшествующим реализациям заказа, выпуски по передачам
// заказа (КРОМЕ &Передача - инвариант ниже) и продукция поступлений из переработки по заказу и по его передачам
// (E12.3b).
//
// ИНВАРИАНТ, а не деталь: собственный автовыпуск текущей передачи в «Выпущено» не входит. У канала отгрузки его
// исключают два барьера сразу (основание автовыпуска - реализация, а не заказ; сама реализация исключена). У
// передачи оба исчезают: основанием автовыпуска стоит ЭТА передача, а его дата - Передача.Дата - 1, то есть
// «МоментВремени < &Момент» выполняется всегда. Без исключения перепроведение даёт «к выпуску = 0», автовыпуск
// распроводится и помечается на удаление, полуфабрикат со склада исчезает и передача отказывает по нехватке -
// со стопроцентной вероятностью.
//
// Аналога ВозвратОтПокупателя у передачи нет: распроведённая передача просто выпадает из отбора «Проведен».
//
// Параметры:
//  Основание - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПередачаВПереработку - документ-основание.
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Серия, Выпущено, Отгружено, Передано.
//
// BSLLS:MethodSize-off - длину метода делает один текст запроса: разрезанный на куски, свод перестал бы
// открываться конструктором запросов EDT целиком, а это самый тонкий запрос механизма.
Функция ВыпущеноОтгруженоИПереданоРанее(Основание, Заказ)

	// Приведение количества в тексте запроса берётся из определяемого типа: литерал резал
	// разнесение количества по сериям до трёх знаков - молча и до типизации реквизита.
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Реализации.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПредшествующие
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации
	|ГДЕ
	|	Реализации.Основание = &Заказ
	|	И Реализации.Проведен
	|	И Реализации.Ссылка <> &Реализация
	|	И Реализации.МоментВремени < &Момент
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Передачи.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПередачиЗаказа
	|ИЗ
	|	Документ.ПередачаВПереработку КАК Передачи
	|ГДЕ
	|	Передачи.Основание = &Заказ
	|	И Передачи.Проведен
	|	И Передачи.Ссылка <> &Передача
	|	И Передачи.МоментВремени < &Момент
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Движение.Номенклатура КАК Номенклатура,
	|	Движение.Характеристика КАК Характеристика,
	|	Движение.Серия КАК Серия,
	|	СУММА(Движение.Выпущено) КАК Выпущено,
	|	СУММА(Движение.Отгружено) КАК Отгружено,
	|	СУММА(Движение.Передано) КАК Передано
	|ИЗ
	|	(ВЫБРАТЬ
	|		ГотоваяПродукция.Номенклатура КАК Номенклатура,
	|		ГотоваяПродукция.Характеристика КАК Характеристика,
	|		ГотоваяПродукция.Серия КАК Серия,
	|		ГотоваяПродукция.Количество КАК Выпущено,
	|		0 КАК Отгружено,
	|		0 КАК Передано
	|	ИЗ
	|		Документ.ВыпускПродукции КАК Выпуски
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ГотоваяПродукция
	|			ПО Выпуски.Ссылка = ГотоваяПродукция.Ссылка
	|	ГДЕ
	|		Выпуски.Основание = &Заказ
	|		И Выпуски.Проведен
	|		И Выпуски.МоментВремени < &Момент
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ГотоваяПродукция.Номенклатура,
	|		ГотоваяПродукция.Характеристика,
	|		ГотоваяПродукция.Серия,
	|		ГотоваяПродукция.Количество,
	|		0,
	|		0
	|	ИЗ
	|		Документ.ВыпускПродукции КАК Выпуски
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ГотоваяПродукция
	|			ПО Выпуски.Ссылка = ГотоваяПродукция.Ссылка
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПредшествующие КАК ВТПредшествующие
	|			ПО Выпуски.Основание = ВТПредшествующие.Ссылка
	|	ГДЕ
	|		Выпуски.Проведен
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ГотоваяПродукция.Номенклатура,
	|		ГотоваяПродукция.Характеристика,
	|		ГотоваяПродукция.Серия,
	|		ГотоваяПродукция.Количество,
	|		0,
	|		0
	|	ИЗ
	|		Документ.ВыпускПродукции КАК Выпуски
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ГотоваяПродукция
	|			ПО Выпуски.Ссылка = ГотоваяПродукция.Ссылка
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаВПереработку КАК ПередачиОснования
	|			ПО Выпуски.Основание = ПередачиОснования.Ссылка
	|	ГДЕ
	|		ПередачиОснования.Основание = &Заказ
	|		И ПередачиОснования.Проведен
	|		И Выпуски.Основание <> &Передача
	|		И Выпуски.Проведен
	|		И Выпуски.МоментВремени < &Момент
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ПродукцияПереработки.Номенклатура,
	|		ПродукцияПереработки.Характеристика,
	|		ПродукцияПереработки.Серия,
	|		ПродукцияПереработки.Количество,
	|		0,
	|		0
	|	ИЗ
	|		Документ.ПоступлениеИзПереработки КАК ПоступленияПереработки
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеИзПереработки.ТЧГотоваяПродукция КАК ПродукцияПереработки
	|			ПО ПоступленияПереработки.Ссылка = ПродукцияПереработки.Ссылка
	|	ГДЕ
	|		ПоступленияПереработки.Основание = &Заказ
	|		И ПоступленияПереработки.Проведен
	|		И ПоступленияПереработки.МоментВремени < &Момент
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ПродукцияПереработки.Номенклатура,
	|		ПродукцияПереработки.Характеристика,
	|		ПродукцияПереработки.Серия,
	|		ПродукцияПереработки.Количество,
	|		0,
	|		0
	|	ИЗ
	|		Документ.ПоступлениеИзПереработки КАК ПоступленияПереработки
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеИзПереработки.ТЧГотоваяПродукция КАК ПродукцияПереработки
	|			ПО ПоступленияПереработки.Ссылка = ПродукцияПереработки.Ссылка
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаВПереработку КАК ПередачиЗаказа
	|			ПО ПоступленияПереработки.Основание = ПередачиЗаказа.Ссылка
	|	ГДЕ
	|		ПередачиЗаказа.Основание = &Заказ
	|		И ПоступленияПереработки.Проведен
	|		И ПоступленияПереработки.МоментВремени < &Момент
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ТоварыРеализаций.Номенклатура,
	|		ТоварыРеализаций.Характеристика,
	|		ТоварыРеализаций.Серия,
	|		0,
	|		ТоварыРеализаций.Количество,
	|		0
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг.ТЧТовары КАК ТоварыРеализаций
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПредшествующие КАК ВТПредшествующие
	|			ПО ТоварыРеализаций.Ссылка = ВТПредшествующие.Ссылка
	|	ГДЕ
	|		НЕ ТоварыРеализаций.УказаноНесколькоСерий
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ТоварыРеализаций.Номенклатура,
	|		ТоварыРеализаций.Характеристика,
	|		СерииРеализаций.Серия,
	|		0,
	|		ВЫБОР
	|			КОГДА ТоварыРеализаций.КоличествоУпаковок = 0
	|				ТОГДА 0
	|			ИНАЧЕ ВЫРАЗИТЬ(ТоварыРеализаций.Количество / ТоварыРеализаций.КоличествоУпаковок * СерииРеализаций.Количество
	|					КАК ЧИСЛО(15, 3))
	|		КОНЕЦ,
	|		0
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг.ТЧТовары КАК ТоварыРеализаций
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПредшествующие КАК ВТПредшествующие
	|			ПО ТоварыРеализаций.Ссылка = ВТПредшествующие.Ссылка
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ТЧСерии КАК СерииРеализаций
	|			ПО ТоварыРеализаций.Ссылка = СерииРеализаций.Ссылка
	|				И ТоварыРеализаций.КодСтроки = СерииРеализаций.КодСтроки
	|	ГДЕ
	|		ТоварыРеализаций.УказаноНесколькоСерий
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ТоварыВозвратов.Номенклатура,
	|		ТоварыВозвратов.Характеристика,
	|		ЕСТЬNULL(СерииВозвратов.Серия, ТоварыВозвратов.Серия),
	|		0,
	|		ВЫБОР
	|			КОГДА СерииВозвратов.Серия ЕСТЬ NULL
	|				ТОГДА -ТоварыВозвратов.Количество
	|			КОГДА ТоварыВозвратов.КоличествоУпаковок = 0
	|				ТОГДА 0
	|			ИНАЧЕ -ВЫРАЗИТЬ(ТоварыВозвратов.Количество / ТоварыВозвратов.КоличествоУпаковок * СерииВозвратов.Количество
	|					КАК ЧИСЛО(15, 3))
	|		КОНЕЦ,
	|		0
	|	ИЗ
	|		Документ.ВозвратОтПокупателя КАК Возвраты
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратОтПокупателя.ТЧТовары КАК ТоварыВозвратов
	|			ПО Возвраты.Ссылка = ТоварыВозвратов.Ссылка
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацииЗаказа
	|			ПО Возвраты.Основание = РеализацииЗаказа.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратОтПокупателя.ТЧСерии КАК СерииВозвратов
	|			ПО ТоварыВозвратов.Ссылка = СерииВозвратов.Ссылка
	|				И ТоварыВозвратов.КодСтроки = СерииВозвратов.КодСтроки
	|				И ТоварыВозвратов.УказаноНесколькоСерий
	|	ГДЕ
	|		РеализацииЗаказа.Основание = &Заказ
	|		И Возвраты.Проведен
	|		И Возвраты.МоментВремени < &Момент
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ТоварыПередач.Номенклатура,
	|		ТоварыПередач.Характеристика,
	|		ТоварыПередач.Серия,
	|		0,
	|		0,
	|		ТоварыПередач.Количество
	|	ИЗ
	|		Документ.ПередачаВПереработку.ТЧТовары КАК ТоварыПередач
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПередачиЗаказа КАК ВТПередачиЗаказа
	|			ПО ТоварыПередач.Ссылка = ВТПередачиЗаказа.Ссылка) КАК Движение
	|
	|СГРУППИРОВАТЬ ПО
	|	Движение.Номенклатура,
	|	Движение.Характеристика,
	|	Движение.Серия";
	ТекстЗапроса = ТехнологическиеКарты.ТекстСПриведениемКоличества(ТекстЗапроса, "ЧИСЛО(15, 3)");
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Заказ", Заказ);
	// Комплект документов, который свод исключает: документ исключает сам себя из своего же канала, а у чужого
	// канала параметром стоит пустая ссылка - она не совпадает ни с одним основанием.
	ИсключаемаяРеализация = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	ИсключаемаяПередача = Документы.ПередачаВПереработку.ПустаяСсылка();
	Если ЭтоРеализация(Основание.Ссылка) Тогда
		ИсключаемаяРеализация = Основание.Ссылка;
	КонецЕсли;
	Если ЭтоПередача(Основание.Ссылка) Тогда
		ИсключаемаяПередача = Основание.Ссылка;
	КонецЕсли;
	Запрос.УстановитьПараметр("Реализация", ИсключаемаяРеализация);
	Запрос.УстановитьПараметр("Передача", ИсключаемаяПередача);
	Запрос.УстановитьПараметр("Момент", Основание.МоментВремени());
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Строки готовой продукции к выпуску по сериям строк списания основания (план E9, п. 3.1; план S4, B.3).
// По каждой серии: к выпуску = списывается минус покрытие, всего по продукции - не больше «потребность минус
// выпущено». Серия сохраняется: списание основания соединяет остатки по точной серии.
//
// Покрытие вычитается ОДИН раз и одной базой в обоих каналах (S9): свободный складской остаток на складе
// основания (см. СвободныйОстатокПродукции). Сначала склад, потом производство - продукция, лежащая на складе, в
// том числе под другой заказ, заново не выпускается.
//
// Потолок «потребность минус выпущено» общий и действует на оба канала. Граничный случай, когда потребность
// исчерпана, а склад пуст (полуфабрикат выпустили вне канала передачи и израсходовали), даёт «к выпуску = 0» и
// отказ передачи по нехватке - это ПРАВИЛЬНОЕ поведение, а не дефект: потолок защищает от расхода сырья на
// двойную норму против заказа.
//
// Параметры:
//  ТаблицаПродукции - ТаблицаЗначений - см. ДанныеАвтовыпуска, Продукция; пополняется.
//  СтрокиСписания   - ТаблицаЗначений - строки основания с развёрнутыми сериями (СерииИРазмещение).
//  Продукция        - СтрокаТаблицыЗначений - производимая продукция, см. НоваяТаблицаПродукции.
//  Прошлое          - ТаблицаЗначений - см. ВыпущеноОтгруженоИПереданоРанее.
//  Остатки          - ТаблицаЗначений - см. СвободныйОстатокПродукции; расходуются по мере распределения.
//
// Возвращаемое значение:
//  Число - всего к выпуску по продукции.
//
Функция ДобавитьСтрокиПродукции(ТаблицаПродукции, СтрокиСписания, Продукция, Прошлое, Остатки)

	Отбор = Новый Структура("Номенклатура, Характеристика", Продукция.Номенклатура, Продукция.Характеристика);
	ВыпущеноВсего = 0;
	Для Каждого СтрокаПрошлого Из Прошлое.НайтиСтроки(Отбор) Цикл
		ВыпущеноВсего = ВыпущеноВсего + СтрокаПрошлого.Выпущено;
	КонецЦикла;
	Можно = Макс(0, Продукция.Потребность - ВыпущеноВсего);
	Всего = 0;
	Для Каждого СтрокаСерии Из ОтгрузкаПоСериям(СтрокиСписания, Отбор) Цикл
		Отбор.Вставить("Серия", СтрокаСерии.Серия);
		Покрытие = СписатьОстатокПродукции(Остатки, Отбор);
		Отбор.Удалить("Серия");
		Количество = Мин(Макс(0, СтрокаСерии.Количество - Покрытие), Можно);
		Если Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = ТаблицаПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Отбор);
		Строка.Серия = СтрокаСерии.Серия;
		Строка.Количество = Количество;
		Можно = Можно - Количество;
		Всего = Всего + Количество;
	КонецЦикла;
	Возврат Всего;

КонецФункции

// Складской остаток серии; взятое из таблицы списывается, чтобы две строки одной серии не зачли его дважды.
//
// Параметры:
//  Остатки - ТаблицаЗначений - см. СвободныйОстатокПродукции; уменьшается.
//  Отбор   - Структура - Номенклатура, Характеристика, Серия.
//
// Возвращаемое значение:
//  Число - покрытие, не меньше нуля.
//
Функция СписатьОстатокПродукции(Остатки, Отбор)

	Покрытие = 0;
	Для Каждого Остаток Из Остатки.НайтиСтроки(Отбор) Цикл
		Покрытие = Покрытие + Макс(0, Остаток.Количество);
		Остаток.Количество = 0;
	КонецЦикла;
	Возврат Покрытие;

КонецФункции

// Отгружаемое реализацией количество продукции по сериям в порядке строк: одинаковые позиции сводятся, как при списании.
//
// Параметры:
//  СтрокиСписания - ТаблицаЗначений - строки реализации с развёрнутыми сериями.
//  Отбор          - Структура - Номенклатура, Характеристика.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Серия, Количество.
//
Функция ОтгрузкаПоСериям(СтрокиСписания, Отбор)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Для Каждого СтрокаСписания Из СтрокиСписания.НайтиСтроки(Отбор) Цикл
		Найденные = Результат.НайтиСтроки(Новый Структура("Серия", СтрокаСписания.Серия));
		Если Найденные.Количество() = 0 Тогда
			СтрокаСерии = Результат.Добавить();
			СтрокаСерии.Серия = СтрокаСписания.Серия;
		Иначе
			СтрокаСерии = Найденные[0];
		КонецЕсли;
		СтрокаСерии.Количество = СтрокаСерии.Количество + СтрокаСписания.Количество;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Потребности материалов одной продукции на количество к выпуску.
//
// Параметры:
//  Потребности - ТаблицаЗначений - см. НоваяТаблицаМатериалов.
//  Продукция   - СтрокаТаблицыЗначений - производимая продукция.
//  КВыпуску    - Число - количество к выпуску.
//  Нормы       - Массив из СтрокаТаблицыЗначений - нормы продукции.
//
// Возвращаемое значение:
//  Булево - Истина, если после округления есть хотя бы один материал.
//
Функция ДобавитьПотребностиПродукции(Потребности, Продукция, КВыпуску, Нормы)

	Добавлены = Новый Массив;
	Для Каждого Норма Из Нормы Цикл
		Количество = Окр(КВыпуску * Норма.Норма, РазрядностьКоличества());
		Если Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = Потребности.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Норма, "Продукция, Номенклатура, Характеристика, Норма, ПоЗаказу");
		Строка.Количество = Количество;
		Добавлены.Добавить(Строка);
	КонецЦикла;
	Возврат Добавлены.Количество() > 0;

КонецФункции

// Материалы автовыпуска (план E9, п. 3.3): сначала партии поступлений под заказ, затем общий остаток склада по
// сериям в порядке даты партии (строка с серией без партии - списание по ФИФО внутри серии), недостающее - строкой без
// серии (проба откажет). Взятое не из партий под заказ - «ИзОстатка» у продукции с материалами заказа.
//
// Параметры:
//  Данные      - Структура - см. ДанныеАвтовыпуска.
//  Потребности - ТаблицаЗначений - см. НоваяТаблицаМатериалов, в порядке продукции заказа.
//  Автовыпуски - Массив из ДокументСсылка.ВыпускПродукции - найденные автовыпуски.
//  СОстатками  - Булево - читать остатки; Ложь - только состав (расчёт номенклатуры для блокировки).
//
Процедура РаспределитьМатериалы(Данные, Потребности, Автовыпуски, СОстатками)

	Материалы = Потребности.ВыгрузитьКолонку("Номенклатура");
	Услуги = УслугиСреди(Материалы);
	Остатки = Неопределено;
	Если СОстатками Тогда
		Остатки = ОстаткиМатериалов(Данные, Материалы, Автовыпуски);
	КонецЕсли;
	Распределение = Новый Структура;
	Распределение.Вставить("СтрокиПоКлючам", Новый Соответствие);
	Распределение.Вставить("ОднаПродукция", Данные.Продукция.Количество() = 1);
	Для Каждого Потребность Из Потребности Цикл
		Если Остатки = Неопределено Или Услуги.Найти(Потребность.Номенклатура) <> Неопределено Тогда
			ДобавитьМатериал(Данные.Материалы, Распределение, Потребность, Неопределено, Потребность.Количество);
			Продолжить;
		КонецЕсли;
		Осталось = Потребность.Количество;
		Осталось = СписатьИзОстатков(Данные, Распределение, Потребность, Остатки, Осталось, Истина);
		ИзОстатка = Осталось;
		Осталось = СписатьИзОстатков(Данные, Распределение, Потребность, Остатки, Осталось, Ложь);
		Если Осталось > 0 Тогда
			ДобавитьМатериал(Данные.Материалы, Распределение, Потребность, Неопределено, Осталось);
		КонецЕсли;
		Если Потребность.ПоЗаказу И ИзОстатка > 0 Тогда
			СтрокаИзОстатка = Данные.ИзОстатка.Добавить();
			СтрокаИзОстатка.Продукция = Потребность.Продукция;
			СтрокаИзОстатка.Материал = Потребность.Номенклатура;
			СтрокаИзОстатка.Характеристика = Потребность.Характеристика;
			СтрокаИзОстатка.Количество = ИзОстатка;
		КонецЕсли;
	КонецЦикла;
	Данные.ИзОстатка.Свернуть("Продукция, Материал, Характеристика", "Количество");

КонецПроцедуры

// Покрывает потребность продукции в материале остатками склада одного вида: партиями под заказ или общим остатком.
//
// Параметры:
//  Данные        - Структура - см. ДанныеАвтовыпуска.
//  Распределение - Структура - СтрокиПоКлючам, ОднаПродукция (см. ДобавитьМатериал).
//  Потребность   - СтрокаТаблицыЗначений - потребность продукции в материале.
//  Остатки       - ТаблицаЗначений - см. ОстаткиМатериалов; остатки уменьшаются.
//  Осталось      - Число - непокрытое количество.
//  ПодЗаказ      - Булево - Истина: партии под заказ (строка с партией); Ложь: общий остаток (строка с серией).
//
// Возвращаемое значение:
//  Число - непокрытый остаток потребности.
//
Функция СписатьИзОстатков(Данные, Распределение, Потребность, Остатки, Знач Осталось, ПодЗаказ)

	Отбор = Новый Структура("Номенклатура, Характеристика, ПодЗаказ", Потребность.Номенклатура,
		Потребность.Характеристика, ПодЗаказ);
	Для Каждого Остаток Из Остатки.НайтиСтроки(Отбор) Цикл
		Часть = Мин(Осталось, Остаток.Количество);
		Если Часть <= 0 Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьМатериал(Данные.Материалы, Распределение, Потребность, Остаток, Часть);
		Остаток.Количество = Остаток.Количество - Часть;
		Осталось = Осталось - Часть;
	КонецЦикла;
	Возврат Осталось;

КонецФункции

// Добавляет строку материала автовыпуска или увеличивает строку с тем же материалом, серией и партией. Остаток под
// заказ даёт строку с партией и серией, общий остаток - строку с серией без партии, без остатка - строку без серии.
//
// Параметры:
//  Материалы     - ТаблицаЗначений - см. ДанныеАвтовыпуска, Материалы.
//  Распределение - Структура - СтрокиПоКлючам (Соответствие строк по ключу; пополняется), ОднаПродукция (Булево -
//                  в автовыпуске одна строка продукции: норма заполняет «Количество за единицу»).
//  Потребность   - СтрокаТаблицыЗначений - потребность продукции в материале.
//  Остаток       - СтрокаТаблицыЗначений, Неопределено - строка остатков (см. ОстаткиМатериалов) или Неопределено.
//  Количество    - Число - количество.
//
Процедура ДобавитьМатериал(Материалы, Распределение, Потребность, Остаток, Количество)

	Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
	Партия = Неопределено;
	КлючПартии = "";
	Если Остаток <> Неопределено Тогда
		Серия = Остаток.Серия;
		Если Остаток.ПодЗаказ Тогда
			Партия = Остаток.Партия;
			КлючПартии = XMLТипЗнч(Партия).ИмяТипа + "|" + XMLСтрока(Партия);
		КонецЕсли;
	КонецЕсли;
	Ключ = СтрШаблон("%1|%2|%3|%4", XMLСтрока(Потребность.Номенклатура), XMLСтрока(Потребность.Характеристика),
		XMLСтрока(Серия), КлючПартии);
	Строка = Распределение.СтрокиПоКлючам[Ключ];
	Если Строка = Неопределено Тогда
		Строка = Материалы.Добавить();
		Строка.Номенклатура = Потребность.Номенклатура;
		Строка.Характеристика = Потребность.Характеристика;
		Строка.Серия = Серия;
		Если Партия <> Неопределено Тогда
			Строка.Партия = Партия;
		КонецЕсли;
		Строка.КоличествоЗаЕдиницу = ?(Распределение.ОднаПродукция, Потребность.Норма, 0);
		Распределение.СтрокиПоКлючам.Вставить(Ключ, Строка);
	КонецЕсли;
	Строка.Количество = Строка.Количество + Количество;

КонецПроцедуры

Функция УслугиСреди(Номенклатура)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Номенклатура)
	|	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Остатки материалов на складе основания на момент автовыпуска (исключая сам момент) по сериям и партиям: сначала
// партии поступлений под заказ (признак ПодЗаказ), затем прочие; внутри - по дате партии.
//
// Момент здесь считается по переданным Автовыпуски, а не берётся из Данные.Момент: у этого чтения роль другая -
// оно выбирает партии списания, а не количество продукции, и на втором проходе обязано видеть ссылку уже
// записанного объекта (его прежние движения к этому моменту очищены).
//
// Параметры:
//  Данные      - Структура - см. ДанныеАвтовыпуска.
//  Материалы   - Массив из СправочникСсылка.Номенклатура - материалы.
//  Автовыпуски - Массив из ДокументСсылка.ВыпускПродукции - найденные автовыпуски; момент - по основному.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Серия, Партия, ПодЗаказ, Количество.
//
Функция ОстаткиМатериалов(Данные, Материалы, Автовыпуски)

	Если Автовыпуски.Количество() > 0 Тогда
		Момент = Новый МоментВремени(Данные.Дата, Автовыпуски[0]);
	Иначе
		Момент = Новый МоментВремени(Данные.Дата);
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Потребности.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТПоступления
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства КАК Потребности
	|ГДЕ
	|	Потребности.Заказ = &Заказ
	|	И Потребности.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	Остатки.Партия КАК Партия,
	|	Остатки.ДатаПартии КАК ДатаПартии,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			&Граница,
	|			МестоХранения = &Склад
	|				И Номенклатура В (&Материалы)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстатки.Номенклатура КАК Номенклатура,
	|	ВТОстатки.Характеристика КАК Характеристика,
	|	ВТОстатки.Серия КАК Серия,
	|	ВТОстатки.Партия КАК Партия,
	|	ВТОстатки.ДатаПартии КАК ДатаПартии,
	|	НЕ ВТПоступления.Регистратор ЕСТЬ NULL КАК ПодЗаказ,
	|	ВТОстатки.Количество КАК Количество
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПоступления КАК ВТПоступления
	|		ПО ВТОстатки.Партия = ВТПоступления.Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПодЗаказ УБЫВ,
	|	ДатаПартии,
	|	Партия");
	Запрос.УстановитьПараметр("Заказ", Данные.Заказ);
	Запрос.УстановитьПараметр("Граница", Новый Граница(Момент, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Склад", Данные.Склад);
	Запрос.УстановитьПараметр("Материалы", Материалы);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область Поиск

// Автовыпуски документа-основания по индексу основания; первый по дате и номеру - основной.
//
// Отбор идёт по реквизиту «Основание», а не по признаку СозданАвтоматически (решение A.3): база, где обработчик
// обновления не отработал, иначе не нашла бы свои выпуски и завела бы дубли.
//
// Параметры:
//  Основание - ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.ПередачаВПереработку - документ-основание;
//              пустой - автовыпусков нет.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ВыпускПродукции - автовыпуски.
//
Функция АвтовыпускиОснования(Основание)

	Если Не ЗначениеЗаполнено(Основание) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Выпуски.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|ГДЕ
	|	Выпуски.Основание = &Основание
	|
	|УПОРЯДОЧИТЬ ПО
	|	Выпуски.Дата,
	|	Выпуски.Номер");
	Запрос.УстановитьПараметр("Основание", Основание);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Функция НоменклатураАвтовыпусков(Автовыпуски)

	Если Автовыпуски.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ВыпускПродукции.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В (&Автовыпуски)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ГотоваяПродукция.Номенклатура
	|ИЗ
	|	Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ГотоваяПродукция
	|ГДЕ
	|	ГотоваяПродукция.Ссылка В (&Автовыпуски)");
	Запрос.УстановитьПараметр("Автовыпуски", Автовыпуски);
	Номенклатура = Новый Массив;
	ДобавитьЗначения(Номенклатура, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура"));
	Возврат Номенклатура;

КонецФункции

Функция ЗаказыДвиженийАвтовыпусков(Автовыпуски)

	Заказы = Новый Массив;
	Для Каждого Автовыпуск Из Автовыпуски Цикл
		ДобавитьЗначения(Заказы, РегистрыНакопления.ПотребностиПроизводства.ЗаказыДвиженийДокумента(Автовыпуск));
	КонецЦикла;
	Возврат Заказы;

КонецФункции

// Булево, прочитанное запросом: у несуществующей или пустой ссылки реквизит приходит как Неопределено.
//
// ЗначениеЗаполнено здесь НЕПРИМЕНИМА: для Булева она возвращает Истину и на Ложь, то есть признак
// «создан автоматически» оказался бы поднят у любого записанного выпуска. Поймано прогоном уровня 3
// 2026-09-20: четыре сценария разом (docs/TECHDEBT.md, правило в tiny1C).
//
// Параметры:
//  Значение - Булево, Неопределено - прочитанный реквизит.
//
// Возвращаемое значение:
//  Булево - Истина, только если значение действительно Истина.
//
Функция ЭтоИстина(Значение)

	Возврат ТипЗнч(Значение) = Тип("Булево") И Значение;

КонецФункции

Функция ЭтоРеализация(Значение)

	Возврат ТипЗнч(Значение) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И ЗначениеЗаполнено(Значение);

КонецФункции

// Значение - непустая ссылка на передачу в переработку.
//
// Отдельная функция рядом с ЭтоРеализация, а не одна с перечислением типов: у каждой свой вызывающий, и
// слияние заставило бы его гадать, какой тип пришёл.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина у непустой ссылки на передачу в переработку.
//
Функция ЭтоПередача(Значение)

	Возврат ТипЗнч(Значение) = Тип("ДокументСсылка.ПередачаВПереработку") И ЗначениеЗаполнено(Значение);

КонецФункции

// Проводимый объект - передача в переработку (а не реализация).
//
// Параметры:
//  Основание - ДокументОбъект - проводимый документ.
//
// Возвращаемое значение:
//  Булево - Истина у объекта передачи в переработку.
//
Функция ЭтоПередачаОбъект(Основание)

	Возврат ТипЗнч(Основание) = Тип("ДокументОбъект.ПередачаВПереработку");

КонецФункции

// Основание, которым распоряжается механизм автовыпуска, - реализация или передача в переработку; заказ и
// пустая ссылка механизму не принадлежат.
//
// Параметры:
//  Значение - Произвольный - значение реквизита «Основание» выпуска.
//
// Возвращаемое значение:
//  ДокументСсылка, Неопределено - основание механизма; Неопределено - основание не его.
//
Функция ОснованиеМеханизмаАвтовыпуска(Значение)

	Возврат ?(ЭтоРеализация(Значение) Или ЭтоПередача(Значение), Значение, Неопределено);

КонецФункции

Процедура ДобавитьЗначения(Приемник, Значения)

	Для Каждого Значение Из Значения Цикл
		Если ЗначениеЗаполнено(Значение) И Приемник.Найти(Значение) = Неопределено Тогда
			Приемник.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

