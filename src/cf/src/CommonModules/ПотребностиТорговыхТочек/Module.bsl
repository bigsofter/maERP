#Область ПрограммныйИнтерфейс

// Потребности торговых точек (план docs/plans/retail-store-needs.md): права точки и склада, переходы статусов,
// движения регистра ПотребностиТорговыхТочек, баланс строк, маршрут и соответствие перемещений, получение отгрузки.

// Доверенный пользователь: пишет потребности любых точек и выполняет переходы склада - роль Кладовщик или те, кто
// меняет настройки доступа (НастройкиПользователей.ЭтоАдминистраторНастроек: Администратор, Руководитель) - тому
// граница по точке ничего не даёт.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь доверенный.
//
Функция ДоверенныйПользователь() Экспорт
	Если РегистрыСведений.НастройкиПользователей.ЭтоАдминистраторНастроек() Тогда
		Возврат Истина;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - роли текущего пользователя ИБ, решение от режима не зависит
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Результат = Не ПустаяСтрока(Пользователь.Имя) И Пользователь.Роли.Содержит(Метаданные.Роли.Кладовщик);
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

// Точка пользователя для потребностей - настройка доступа «Точка потребностей» (меняет только администратор).
//
// Возвращаемое значение:
//  СправочникСсылка.МестаХранения - точка; пустая ссылка - не задана.
//
Функция ТочкаПользователя() Экспорт
	Возврат РегистрыСведений.НастройкиПользователей.ТочкаПотребностей();
КонецФункции

// Может ли текущий пользователь работать с потребностью точки: доверенный - с любой, иначе - только своей точки.
//
// Параметры:
//  Точка - СправочникСсылка.МестаХранения - точка потребности.
//
// Возвращаемое значение:
//  Булево - Истина, если может.
//
Функция СвояТочка(Точка) Экспорт
	Если ДоверенныйПользователь() Тогда
		Возврат Истина;
	КонецЕсли;
	СвояТочка = ТочкаПользователя();
	Возврат ЗначениеЗаполнено(СвояТочка) И СвояТочка = Точка;
КонецФункции

// Текст ошибки перехода статуса потребности или пустая строка, если переход разрешён (план, «Права»). Состояния
// исполнения (частично отгружена, отгружена, получена) статусом не присваиваются.
//
// Параметры:
//  ПрежнийСтатус - ПеречислениеСсылка.СтатусыПотребностейТорговыхТочек, Неопределено - статус в базе (новый документ -
//               Неопределено).
//  НовыйСтатус   - ПеречислениеСсылка.СтатусыПотребностейТорговыхТочек - записываемый статус.
//  Доверенный    - Булево - см. ДоверенныйПользователь.
//
// Возвращаемое значение:
//  Строка - текст ошибки.
//
Функция ТекстОшибкиПерехода(ПрежнийСтатус, НовыйСтатус, Доверенный) Экспорт
	Статусы = Перечисления.СтатусыПотребностейТорговыхТочек;
	СтатусИсполнения = НовыйСтатус = Статусы.ЧастичноОтгружена Или НовыйСтатус = Статусы.Отгружена
		Или НовыйСтатус = Статусы.Получена;
	Если СтатусИсполнения Или Не ЗначениеЗаполнено(НовыйСтатус) Тогда
		Возврат НСтр("ru = 'Статус исполнения потребности вычисляется по отгрузкам и вручную не ставится.';
			|fr = 'Le statut d''exécution du besoin est calculé d''après les expéditions et ne se pose pas à la main.';
			|en = 'The need fulfilment status is calculated from shipments and is not set manually.';
			|es = 'El estado de ejecución de la necesidad se calcula por los envíos y no se pone a mano.'");
	КонецЕсли;
	Разрешены = РазрешенныеПереходы(Доверенный)[?(ПрежнийСтатус = Неопределено, "Новый", ПрежнийСтатус)];
	Если Разрешены <> Неопределено И Разрешены.Найти(НовыйСтатус) <> Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'Переход потребности «%1» → «%2» не разрешён.';
		|fr = 'Le passage du besoin « %1 » → « %2 » n''est pas autorisé.';
		|en = 'The need transition «%1» → «%2» is not allowed.';
		|es = 'La transición de la necesidad «%1» → «%2» no está permitida.'");
	Прежний = ?(ПрежнийСтатус = Неопределено, НСтр("ru = 'новая'; fr = 'nouveau'; en = 'new'; es = 'nueva'"),
		ПрежнийСтатус);
	Возврат СтрШаблон(Шаблон, Прежний, НовыйСтатус);
КонецФункции

// Состояние исполнения потребностей по регистру: принята и ничего не отгружено - «Принята», отгружено меньше
// принятого - «Частично отгружена», всё отгружено - «Отгружена», всё получено - «Получена». Для статусов, кроме
// «Принята» и «Закрыта», - сам статус.
//
// Параметры:
//  Потребности - Массив из ДокументСсылка.ПотребностьТорговойТочки - документы.
//
// Возвращаемое значение:
//  Соответствие - ключ: потребность, значение: ПеречислениеСсылка.СтатусыПотребностейТорговыхТочек.
//
Функция СостояниеИсполнения(Потребности) Экспорт
	Статусы = Перечисления.СтатусыПотребностейТорговыхТочек;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Потребность КАК Потребность,
	|	СУММА(Остатки.ПринятоОстаток) КАК Принято,
	|	СУММА(Остатки.ОтгруженоОстаток) КАК Отгружено,
	|	СУММА(Остатки.ПолученоОстаток) КАК Получено
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек.Остатки(, Потребность В (&Потребности)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Потребность
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Потребность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Документы.Ссылка КАК Потребность,
	|	Документы.Статус КАК Статус,
	|	ЕСТЬNULL(Остатки.Принято, 0) КАК Принято,
	|	ЕСТЬNULL(Остатки.Отгружено, 0) КАК Отгружено,
	|	ЕСТЬNULL(Остатки.Получено, 0) КАК Получено
	|ИЗ
	|	Документ.ПотребностьТорговойТочки КАК Документы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК Остатки
	|		ПО (Остатки.Потребность = Документы.Ссылка)
	|ГДЕ
	|	Документы.Ссылка В (&Потребности)";
	Запрос.УстановитьПараметр("Потребности", Потребности);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Состояние = Выборка.Статус;
		Если Выборка.Статус = Статусы.Принята Или Выборка.Статус = Статусы.Закрыта Тогда
			Состояние = СостояниеПоКоличествам(Выборка.Статус, Выборка.Принято, Выборка.Отгружено, Выборка.Получено);
		КонецЕсли;
		Результат.Вставить(Выборка.Потребность, Состояние);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Записывает историю статусов потребности (привилегированно: у роли точки на историю только чтение).
//
// Параметры:
//  Потребность - ДокументСсылка.ПотребностьТорговойТочки - документ.
//  Статус      - ПеречислениеСсылка.СтатусыПотребностейТорговыхТочек - новый статус.
//
Процедура ЗаписатьИсториюСтатуса(Потребность, Статус) Экспорт
	// BSLLS:SetPrivilegedMode-off - история пишется проведением документа, у роли точки на регистр только чтение
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запись = РегистрыСведений.ИсторияСтатусовПотребностей.СоздатьМенеджерЗаписи();
	Запись.Период = ПериодЗаписиИстории(Потребность);
	Запись.Потребность = Потребность;
	Запись.Статус = Статус;
	Запись.Пользователь = ПараметрыСеанса.Пользователь;
	Запись.Записать();
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

// Исключительная блокировка регистра потребностей по документам потребностей - перед чтением и записью исполнения.
//
// Параметры:
//  Потребности - Массив из ДокументСсылка.ПотребностьТорговойТочки - потребности.
//
Процедура ЗаблокироватьПотребности(Потребности) Экспорт
	Если Потребности.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.ПотребностиТорговыхТочек");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Поле = "Потребность";
	Источник = Новый ТаблицаЗначений;
	Источник.Колонки.Добавить(Поле);
	Для Каждого Потребность Из Потребности Цикл
		Источник.Добавить()[Поле] = Потребность;
	КонецЦикла;
	Элемент.ИсточникДанных = Источник;
	Элемент.ИспользоватьИзИсточникаДанных(Поле, Поле);
	Блокировка.Заблокировать();
КонецПроцедуры

// Потребности, по которым у регистратора уже есть движения регистра (прежние движения перепроводимого документа).
//
// Параметры:
//  Регистратор - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ПотребностьТорговойТочки - потребности.
//
Функция ПотребностиДвиженийДокумента(Регистратор) Экспорт
	Если Регистратор.Пустая() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.Потребность КАК Потребность
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Потребность");
КонецФункции

// Движения потребности по статусу (план, «Регистр»): «Отправлена» - запрошено, «Принята» - ещё принято, «Закрыта» -
// принято не больше отгруженного по строке (остаток к отгрузке снимается), прочие - без движений.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПотребностьТорговойТочки - проводимый документ.
//
Процедура СформироватьДвиженияПотребности(ДокОбъект) Экспорт
	Движения = ДокОбъект.Движения.ПотребностиТорговыхТочек;
	Движения.Очистить();
	Статусы = Перечисления.СтатусыПотребностейТорговыхТочек;
	Статус = ДокОбъект.Статус;
	Если Статус <> Статусы.Отправлена И Статус <> Статусы.Принята И Статус <> Статусы.Закрыта Тогда
		Возврат;
	КонецЕсли;
	Отгружено = Новый Соответствие;
	Если Статус = Статусы.Закрыта Тогда
		Отгружено = ОтгруженоПоСтрокам(ДокОбъект.Ссылка);
	КонецЕсли;
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Движение = Движения.ДобавитьПриход();
		Движение.Период = ДокОбъект.Дата;
		Движение.Точка = ДокОбъект.МестоХранения;
		Движение.СкладСнабжения = ДокОбъект.СкладСнабжения;
		Движение.Потребность = ДокОбъект.Ссылка;
		ЗаполнитьЗначенияСвойств(Движение, Строка, "КодСтроки, Номенклатура, Характеристика, Серия");
		Движение.Запрошено = Строка.Количество;
		Если Статус = Статусы.Принята Тогда
			Движение.Принято = Строка.КоличествоПринято;
		ИначеЕсли Статус = Статусы.Закрыта Тогда
			ОтгруженоСтроки = Отгружено[Строка.КодСтроки];
			Движение.Принято = Мин(Строка.КоличествоПринято, ?(ОтгруженоСтроки = Неопределено, 0, ОтгруженоСтроки));
		Иначе
			Движение.Принято = 0;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Движения перемещения по строкам с потребностью: списание - отгружено (отгрузка - само списание), оприходование -
// получено (отгрузка - его основание). Строки без потребности регистр не учитывает.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПеремещениеТоваров - проводимое перемещение.
//
Процедура СформироватьДвиженияПеремещения(ДокОбъект) Экспорт
	Движения = ДокОбъект.Движения.ПотребностиТорговыхТочек;
	Движения.Очистить();
	Списание = ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание;
	Отгрузка = ?(Списание, ДокОбъект.Ссылка, ДокОбъект.Основание);
	Шапки = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДокОбъект.ТЧТовары.ВыгрузитьКолонку("Потребность"),
		"МестоХранения, СкладСнабжения");
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Если Не ЗначениеЗаполнено(Строка.Потребность) Тогда
			Продолжить;
		КонецЕсли;
		Шапка = Шапки[Строка.Потребность];
		Движение = Движения.ДобавитьПриход();
		Движение.Период = ДокОбъект.Дата;
		Движение.Точка = Шапка.МестоХранения;
		Движение.СкладСнабжения = Шапка.СкладСнабжения;
		Движение.Потребность = Строка.Потребность;
		Движение.КодСтроки = Строка.КодСтрокиПотребности;
		Движение.Отгрузка = Отгрузка;
		Движение.КодСтрокиОтгрузки = Строка.КодСтроки;
		ЗаполнитьЗначенияСвойств(Движение, Строка, "Номенклатура, Характеристика, Серия");
		Если Списание Тогда
			Движение.Отгружено = Строка.Количество;
		Иначе
			Движение.Получено = Строка.Количество;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Нарушения баланса строк потребностей по остаткам регистра (после записи движений): отгружено больше принятого по
// строке потребности; получено больше отгруженного по строке отгрузки и серии.
//
// Параметры:
//  Потребности - Массив из ДокументСсылка.ПотребностьТорговойТочки - проверяемые потребности.
//
// Возвращаемое значение:
//  Массив из Строка - тексты нарушений.
//
Функция НарушенияБаланса(Потребности) Экспорт
	Нарушения = Новый Массив;
	Если Потребности.Количество() = 0 Тогда
		Возврат Нарушения;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Потребность КАК Потребность,
	|	Остатки.КодСтроки КАК КодСтроки,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.ПринятоОстаток) КАК Принято,
	|	СУММА(Остатки.ОтгруженоОстаток) КАК Отгружено
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек.Остатки(, Потребность В (&Потребности)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Потребность,
	|	Остатки.КодСтроки,
	|	Остатки.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.ОтгруженоОстаток) > СУММА(Остатки.ПринятоОстаток)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Потребность КАК Потребность,
	|	Остатки.КодСтроки КАК КодСтроки,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Отгрузка КАК Отгрузка,
	|	СУММА(Остатки.ОтгруженоОстаток) КАК Отгружено,
	|	СУММА(Остатки.ПолученоОстаток) КАК Получено
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек.Остатки(, Потребность В (&Потребности)) КАК Остатки
	|ГДЕ
	|	Остатки.Отгрузка <> ЗНАЧЕНИЕ(Документ.ПеремещениеТоваров.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Потребность,
	|	Остатки.КодСтроки,
	|	Остатки.Номенклатура,
	|	Остатки.Отгрузка,
	|	Остатки.КодСтрокиОтгрузки,
	|	Остатки.Серия
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.ПолученоОстаток) > СУММА(Остатки.ОтгруженоОстаток)";
	Запрос.УстановитьПараметр("Потребности", Потребности);
	Пакет = Запрос.ВыполнитьПакет();
	Шаблон = НСтр("ru = '%1, строка %2 «%3»: отгружено %4 больше принятого %5.';
		|fr = '%1, ligne %2 « %3 » : expédié %4 de plus que l''accepté %5.';
		|en = '%1, line %2 «%3»: shipped %4 is more than accepted %5.';
		|es = '%1, línea %2 «%3»: enviado %4 es más que lo aceptado %5.'");
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Текст = СтрШаблон(Шаблон, Выборка.Потребность, Выборка.КодСтроки, Выборка.Номенклатура,
			Выборка.Отгружено, Выборка.Принято);
		Нарушения.Добавить(Текст);
	КонецЦикла;
	Шаблон = НСтр("ru = '%1, строка %2 «%3»: получено %4 больше отгруженного %5 по «%6».';
		|fr = '%1, ligne %2 « %3 » : reçu %4 de plus que l''expédié %5 par « %6 ».';
		|en = '%1, line %2 «%3»: received %4 is more than shipped %5 by «%6».';
		|es = '%1, línea %2 «%3»: recibido %4 es más que lo enviado %5 por «%6».'");
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Текст = СтрШаблон(Шаблон, Выборка.Потребность, Выборка.КодСтроки, Выборка.Номенклатура,
			Выборка.Получено, Выборка.Отгружено, Выборка.Отгрузка);
		Нарушения.Добавить(Текст);
	КонецЦикла;
	Возврат Нарушения;
КонецФункции

// Нарушения маршрута и соответствия строк перемещения с потребностью (до записи движений): склады перемещения - склады
// потребности, товар строки - товар строки потребности; оприходование - на основании проведённого списания, каждая
// его строка - строка основания по коду с тем же товаром и связью (план, «ПеремещениеТоваров»).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПеремещениеТоваров - перемещение.
//
// Возвращаемое значение:
//  Массив из Строка - тексты нарушений.
//
Функция НарушенияМаршрута(ДокОбъект) Экспорт
	Нарушения = Новый Массив;
	Оприходование = ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеОприходование;
	Основание = Неопределено;
	Если Оприходование И ТипЗнч(ДокОбъект.Основание) = Тип("ДокументСсылка.ПеремещениеТоваров")
		И ЗначениеЗаполнено(ДокОбъект.Основание) Тогда
		Основание = ДокОбъект.Основание;
	КонецЕсли;
	СтрокиОснования = ?(Основание = Неопределено, Неопределено, СтрокиСписания(Основание));
	ЕстьПотребностиОснования = СтрокиОснования <> Неопределено
		И СтрокиОснования.Найти(Истина, "СПотребностью") <> Неопределено;
	СтрокиПотребностей = СтрокиПотребностей(ДокОбъект.ТЧТовары.ВыгрузитьКолонку("Потребность"));
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Если ЕстьПотребностиОснования Тогда
			ПроверитьСоответствиеОснованию(Строка, СтрокиОснования, Нарушения);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.Потребность) Тогда
			Продолжить;
		КонецЕсли;
		Если Оприходование И Основание = Неопределено Тогда
			Причина = НСтр("ru = 'оприходование - только на основании списания';
				|fr = 'la réception - seulement sur la base d''une sortie';
				|en = 'a receipt - only based on a write-off';
				|es = 'la recepción - solo con base en una salida'");
			ДобавитьНарушениеСтроки(Нарушения, Строка, Причина);
			Продолжить;
		КонецЕсли;
		ПроверитьСтрокуПотребности(ДокОбъект, Строка, СтрокиПотребностей, Нарушения);
	КонецЦикла;
	Возврат Нарушения;
КонецФункции

// Прежние движения документа в регистре потребностей - читаются до записи (в ПередЗаписью): при перепроведении
// платформа удаляет прежние движения до ОбработкаПроведения (tiny1C bsl-029).
//
// Параметры:
//  Регистратор - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Потребность, КодСтроки, Отгружено (сумма по строке потребности).
//
Функция ПрежниеДвиженияДокумента(Регистратор) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Потребность КАК Потребность,
	|	Движения.КодСтроки КАК КодСтроки,
	|	СУММА(Движения.Отгружено) КАК Отгружено
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Регистратор
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.Потребность,
	|	Движения.КодСтроки";
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	// BSLLS:SetPrivilegedMode-off - проверка исполнения потребностей при записи перемещения пользователем без прав на регистр
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Результат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

// Нарушения заморозки: перемещение меняет отгрузку по потребности в статусе «Закрыта» или «Отклонена».
//
// Параметры:
//  ПрежниеДвижения - ТаблицаЗначений, Неопределено - см. ПрежниеДвиженияДокумента (новый документ - Неопределено).
//  НовыеДвижения   - РегистрНакопленияНаборЗаписей.ПотребностиТорговыхТочек, Неопределено - новые движения (отмена
//                    проведения - Неопределено, то есть пусто).
//
// Возвращаемое значение:
//  Массив из Строка - тексты нарушений.
//
Функция НарушенияЗаморозки(ПрежниеДвижения, НовыеДвижения) Экспорт
	Нарушения = Новый Массив;
	Изменения = Новый Соответствие;
	Если ПрежниеДвижения <> Неопределено Тогда
		Для Каждого Движение Из ПрежниеДвижения Цикл
			ДобавитьИзменение(Изменения, Движение.Потребность, Движение.КодСтроки, -Движение.Отгружено);
		КонецЦикла;
	КонецЕсли;
	Если НовыеДвижения <> Неопределено Тогда
		Для Каждого Движение Из НовыеДвижения Цикл
			ДобавитьИзменение(Изменения, Движение.Потребность, Движение.КодСтроки, Движение.Отгружено);
		КонецЦикла;
	КонецЕсли;
	Потребности = Новый Массив;
	Для Каждого КлючИЗначение Из Изменения Цикл
		Если КлючИЗначение.Значение <> 0 Тогда
			Потребности.Добавить(КлючИЗначение.Ключ.Потребность);
		КонецЕсли;
	КонецЦикла;
	Если Потребности.Количество() = 0 Тогда
		Возврат Нарушения;
	КонецЕсли;
	Статусы = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Потребности, "Статус");
	Шаблон = НСтр("ru = '%1: потребность закрыта или отклонена, отгрузку по ней менять нельзя.';
		|fr = '%1 : le besoin est clôturé ou refusé, son expédition ne se modifie pas.';
		|en = '%1: the need is closed or rejected, its shipment cannot be changed.';
		|es = '%1: la necesidad está cerrada o rechazada, su envío no se puede cambiar.'");
	Для Каждого КлючИЗначение Из Статусы Цикл
		Статус = КлючИЗначение.Значение.Статус;
		Если Статус = Перечисления.СтатусыПотребностейТорговыхТочек.Закрыта
			Или Статус = Перечисления.СтатусыПотребностейТорговыхТочек.Отклонена Тогда
			Текст = СтрШаблон(Шаблон, КлючИЗначение.Ключ);
			Нарушения.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Нарушения;
КонецФункции

// Есть ли у документа связи с регистром потребностей: свои движения или ссылки чужих движений на него (отгрузка -
// это списание, потребность - эта потребность). Такой документ не удаляется без отмены проведения.
//
// Параметры:
//  Ссылка - ДокументСсылка.ПеремещениеТоваров, ДокументСсылка.ПотребностьТорговойТочки - документ.
//
// Возвращаемое значение:
//  Булево - Истина, если связи есть.
//
Функция ЕстьСвязиВРегистре(Ссылка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Найдено
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	1
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек КАК Движения
	|ГДЕ
	|	Движения.Отгрузка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	1
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек КАК Движения
	|ГДЕ
	|	Движения.Потребность = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	// BSLLS:SetPrivilegedMode-off - проверка перед удалением документа пользователем без прав на регистр
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Результат = Не Запрос.Выполнить().Пустой();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

// Заполняет списание по потребности: склады - потребности, строки - остаток к отгрузке (принято - отгружено).
//
// Параметры:
//  ДокОбъект   - ДокументОбъект.ПеремещениеТоваров - заполняемое перемещение.
//  Потребность - ДокументСсылка.ПотребностьТорговойТочки - принятая потребность.
//
Процедура ЗаполнитьСписаниеПоПотребности(ДокОбъект, Потребность) Экспорт
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Потребность, "Статус, МестоХранения, СкладСнабжения, Организация");
	Если Реквизиты.Статус <> Перечисления.СтатусыПотребностейТорговыхТочек.Принята Тогда
		ВызватьИсключение НСтр("ru = 'Перемещение вводится по принятой потребности.';
			|fr = 'Le transfert se saisit sur un besoin accepté.';
			|en = 'A transfer is entered from an accepted need.';
			|es = 'El traslado se introduce sobre una necesidad aceptada.'");
	КонецЕсли;
	ДокОбъект.Дата = ТекущаяДатаСеанса();
	ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание;
	ДокОбъект.МестоХранения = Реквизиты.СкладСнабжения;
	ДокОбъект.МестоХраненияОприходование = Реквизиты.МестоХранения;
	ДокОбъект.Организация = Реквизиты.Организация;
	ДокОбъект.ТЧТовары.Очистить();
	Для Каждого Остаток Из ОстаткиКОтгрузке(Потребность) Цикл
		Строка = ДокОбъект.ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Остаток, "Номенклатура, Характеристика, Серия, Упаковка");
		Строка.Потребность = Потребность;
		Строка.КодСтрокиПотребности = Остаток.КодСтроки;
		Строка.Количество = Остаток.Количество;
		Строка.КоличествоУпаковок = Остаток.Количество;
		Строка.КодСтроки = ДокОбъект.ТЧТовары.Количество();
	КонецЦикла;
КонецПроцедуры

// Остаток к отгрузке строк потребности: принято - отгружено, только положительный.
//
// Параметры:
//  Потребность - ДокументСсылка.ПотребностьТорговойТочки - потребность.
//
// Возвращаемое значение:
//  ТаблицаЗначений - КодСтроки, Номенклатура, Характеристика, Серия, Упаковка, Количество.
//
Функция ОстаткиКОтгрузке(Потребность) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	О.КодСтроки КАК КодСтроки,
	|	СУММА(О.ПринятоОстаток) КАК Принято,
	|	СУММА(О.ОтгруженоОстаток) КАК Отгружено
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек.Остатки(, Потребность = &Потребность) КАК О
	|
	|СГРУППИРОВАТЬ ПО
	|	О.КодСтроки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КодСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Серия КАК Серия,
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
	|	ЕСТЬNULL(Остатки.Принято, 0) - ЕСТЬNULL(Остатки.Отгружено, 0) КАК Количество
	|ИЗ
	|	Документ.ПотребностьТорговойТочки.ТЧТовары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК Остатки
	|		ПО (Остатки.КодСтроки = Товары.КодСтроки)
	|ГДЕ
	|	Товары.Ссылка = &Потребность
	|	И ЕСТЬNULL(Остатки.Принято, 0) - ЕСТЬNULL(Остатки.Отгружено, 0) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки";
	Запрос.УстановитьПараметр("Потребность", Потребность);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Получение отгрузки точкой (план, «Получение точкой»): проводит оприходование на основании проведённого списания
// потребности - существующий черновик оприходования (форма списания записывает его после проведения) или новый.
// Строки строятся заново из списания: с потребностью - неполученный остаток, без потребности - как в списании.
// Привилегированно: общего права проводить перемещения у точки нет.
//
// Параметры:
//  Потребность - ДокументСсылка.ПотребностьТорговойТочки - потребность своей точки.
//  Списание    - ДокументСсылка.ПеремещениеТоваров - проведённое списание по ней.
//
// Возвращаемое значение:
//  ДокументСсылка.ПеремещениеТоваров - проведённое оприходование.
//
Функция ПолучитьОтгрузку(Потребность, Списание) Экспорт
	Точка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Потребность, "МестоХранения");
	Если Не СвояТочка(Точка) Тогда
		ВызватьИсключение НСтр("ru = 'Получить отгрузку может только своя точка или склад.';
			|fr = 'Seul le point de vente concerné ou l''entrepôt peut réceptionner l''expédition.';
			|en = 'Only the own store or the warehouse can receive the shipment.';
			|es = 'Solo el propio punto de venta o el almacén puede recibir el envío.'");
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - точка проводит только оприходование своей отгрузки, проверки - выше и ниже
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Черновик = ЧерновикОприходования(Списание);
	НачатьТранзакцию();
	Попытка
		Если ЗначениеЗаполнено(Черновик) Тогда
			ЗаблокироватьДокумент("Документ.ПеремещениеТоваров", Черновик);
		КонецЕсли;
		ЗаблокироватьДокумент("Документ.ПеремещениеТоваров", Списание);
		ПроверитьСписаниеДляПолучения(Потребность, Списание, Точка);
		ДокОбъект = ОбъектОприходования(Черновик, Списание);
		ЗаполнитьОприходованиеИзСписания(ДокОбъект, Списание);
		ДокОбъект.ДополнительныеСвойства.Вставить(СвойствоПолучениеОтгрузки(), Истина);
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ДокОбъект.Ссылка;
КонецФункции

// Может ли пользователь записать перемещение, связанное с потребностями: доверенный (склад) или получение отгрузки
// своей точкой командой (ПолучитьОтгрузку ставит служебный признак в ДополнительныеСвойства - только серверный код).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПеремещениеТоваров - записываемое перемещение.
//
// Возвращаемое значение:
//  Булево - Истина, если разрешено.
//
Функция ЗаписьПеремещенияРазрешена(ДокОбъект) Экспорт
	Если ДоверенныйПользователь() Тогда
		Возврат Истина;
	КонецЕсли;
	Признак = Неопределено;
	Возврат ДокОбъект.ДополнительныеСвойства.Свойство(СвойствоПолучениеОтгрузки(), Признак) И Признак = Истина;
КонецФункции

// Имя служебного признака получения отгрузки точкой.
//
// Возвращаемое значение:
//  Строка - имя свойства.
//
Функция СвойствоПолучениеОтгрузки() Экспорт
	Возврат "ПолучениеОтгрузкиТочкой";
КонецФункции

// Рекомендации пополнения точки (план docs/plans/retail-store-needs-2.md, §2): по строкам «товар + характеристика» -
// продажи в день × дней запаса - остаток - в пути - открыто; нормативы склада (минимум, максимум) - на товар целиком.
// Чтение продаж, остатков и нормативов - привилегированно после проверки своей точки.
//
// Параметры:
//  Точка                - СправочникСсылка.МестаХранения - торговая точка.
//  ИсключитьПотребность - ДокументСсылка.ПотребностьТорговойТочки - заполняемый документ (не считается открытым).
//
// Возвращаемое значение:
//  Структура - рекомендации:
//   * Строки      - ТаблицаЗначений - Номенклатура, Характеристика, Количество, ПродажиВДень.
//   * Пропущенные - Массив из СправочникСсылка.Номенклатура - товары с характеристиками без продаж ниже минимума.
//
Функция РекомендацииТочки(Точка, ИсключитьПотребность) Экспорт
	Если Не СвояТочка(Точка) Тогда
		ВызватьИсключение ТекстЧужаяТочка();
	КонецЕсли;
	Настройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Точка, "ДнейЗапаса, ДнейАнализаПродаж");
	ДнейЗапаса = ?(Настройки.ДнейЗапаса = 0, ДнейЗапасаПоУмолчанию(), Настройки.ДнейЗапаса);
	ДнейАнализа = ?(Настройки.ДнейАнализаПродаж = 0, ДнейАнализаПоУмолчанию(), Настройки.ДнейАнализаПродаж);
	СекундВДне = 86400;
	Конец = ТекущаяДатаСеанса();
	// BSLLS:SetPrivilegedMode-off - только чтение продаж, остатков и нормативов своей точки (проверено выше)
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос(ТекстЗапросаРекомендаций());
	Запрос.УстановитьПараметр("Точка", Точка);
	Запрос.УстановитьПараметр("Начало", Конец - ДнейАнализа * СекундВДне);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Исключить", ИсключитьПотребность);
	Пакет = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	Строки = Новый ТаблицаЗначений;
	Для Каждого Колонка Из СтрРазделить("Номенклатура,Характеристика,Количество,ПродажиВДень", ",") Цикл
		Строки.Колонки.Добавить(Колонка);
	КонецЦикла;
	// Пакет: продажи, потребности, покрытие строк, покрытие (временные), строки рекомендаций, покрытие товаров,
	// товары с характеристиками (временные), нормативы - выборки на позициях 4 и последней.
	ИндексСтрок = 4;
	Выборка = Пакет[ИндексСтрок].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Строки.Добавить();
		Строка.Номенклатура = Выборка.Номенклатура;
		Строка.Характеристика = Выборка.Характеристика;
		Строка.ПродажиВДень = Выборка.Продано / ДнейАнализа;
		Строка.Количество = ОкруглитьВверх(Макс(0, Строка.ПродажиВДень * ДнейЗапаса - Выборка.Покрытие));
	КонецЦикла;
	Пропущенные = Новый Массив;
	Нормативы = Пакет[Пакет.ВГраница()].Выбрать();
	Пока Нормативы.Следующий() Цикл
		ПрименитьНорматив(Строки, Нормативы, Пропущенные);
	КонецЦикла;
	Нулевые = Строки.НайтиСтроки(Новый Структура("Количество", 0));
	Для Каждого Строка Из Нулевые Цикл
		Строки.Удалить(Строка);
	КонецЦикла;
	Возврат Новый Структура("Строки, Пропущенные", Строки, Пропущенные);
КонецФункции

// Заполняет черновик потребности рекомендациями (команда «Заполнить по анализу»): строки заменяются, документ
// записывается без проведения.
//
// Параметры:
//  Потребность - ДокументСсылка.ПотребностьТорговойТочки - черновик своей точки.
//
// Возвращаемое значение:
//  Строка - сообщение о товарах, которые нужно добавить вручную (с характеристиками без продаж), или пустая строка.
//
Функция ЗаполнитьПоАнализу(Потребность) Экспорт
	ДокОбъект = Потребность.ПолучитьОбъект();
	Если ДокОбъект.Статус <> Перечисления.СтатусыПотребностейТорговыхТочек.Черновик Тогда
		ВызватьИсключение НСтр("ru = 'Заполнить по анализу можно только черновик.';
			|fr = 'Seul un brouillon peut être rempli par analyse.';
			|en = 'Only a draft can be filled by analysis.';
			|es = 'Solo un borrador se puede rellenar por análisis.'");
	КонецЕсли;
	Рекомендации = РекомендацииТочки(ДокОбъект.МестоХранения, Потребность);
	ДокОбъект.ТЧТовары.Очистить();
	Для Каждого Рекомендация Из Рекомендации.Строки Цикл
		Строка = ДокОбъект.ТЧТовары.Добавить();
		Строка.Номенклатура = Рекомендация.Номенклатура;
		Строка.Характеристика = Рекомендация.Характеристика;
		Строка.Количество = Рекомендация.Количество;
		Строка.КоличествоУпаковок = Рекомендация.Количество;
	КонецЦикла;
	ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Если Рекомендации.Пропущенные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'Ниже минимума, но без продаж по характеристикам - укажите характеристику вручную: %1';
		|fr = 'Sous le minimum, sans ventes par caractéristique - indiquez la caractéristique à la main : %1';
		|en = 'Below minimum with no sales by characteristic - specify the characteristic manually: %1';
		|es = 'Por debajo del mínimo sin ventas por característica - indique la característica a mano: %1'");
	Товары = Новый Массив;
	Для Каждого Товар Из Рекомендации.Пропущенные Цикл
		Товары.Добавить(Строка(Товар));
	КонецЦикла;
	Возврат СтрШаблон(Шаблон, СтрСоединить(Товары, ", "));
КонецФункции

// Исключительная управляемая блокировка документа по ссылке (до чтения и записи).
//
// Параметры:
//  Таблица - Строка - имя таблицы, например «Документ.ПеремещениеТоваров».
//  Ссылка  - ДокументСсылка - документ.
//
Процедура ЗаблокироватьДокумент(Таблица, Ссылка) Экспорт
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Таблица);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Блокировка.Заблокировать();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЧужаяТочка()
	Возврат НСтр("ru = 'Потребность другой торговой точки: работать с ней может только эта точка или склад.';
		|fr = 'Besoin d''un autre point de vente : seuls ce point ou l''entrepôt peuvent le traiter.';
		|en = 'A need of another store: only that store or the warehouse can work with it.';
		|es = 'Necesidad de otro punto de venta: solo ese punto o el almacén pueden trabajar con ella.'");
КонецФункции

Функция ДнейЗапасаПоУмолчанию()
	Возврат 14;
КонецФункции

Функция ДнейАнализаПоУмолчанию()
	Возврат 30;
КонецФункции

Функция ОкруглитьВверх(Число)
	Целое = Цел(Число);
	Возврат ?(Число > Целое, Целое + 1, Целое);
КонецФункции

// Норматив товара (минимум, максимум; 0 - не задан) - к сумме по товару: недостача - к строке с наибольшими
// продажами (нет строк - строкой с пустой характеристикой, если у товара нет характеристик), превышение (вверх до
// целого: покрытие не больше максимума) - со строк с наименьшими продажами.
//
// Параметры:
//  Строки      - ТаблицаЗначений - см. РекомендацииТочки.
//  Норматив    - ВыборкаИзРезультатаЗапроса - Номенклатура, Минимум, Максимум, Покрытие, ЕстьХарактеристики.
//  Пропущенные - Массив из СправочникСсылка.Номенклатура - пополняется.
//
Процедура ПрименитьНорматив(Строки, Норматив, Пропущенные)
	СтрокиТовара = Строки.НайтиСтроки(Новый Структура("Номенклатура", Норматив.Номенклатура));
	Покрытие = Норматив.Покрытие;
	Для Каждого Строка Из СтрокиТовара Цикл
		Покрытие = Покрытие + Строка.Количество;
	КонецЦикла;
	Если Норматив.Минимум > 0 И Покрытие < Норматив.Минимум Тогда
		Недостача = ОкруглитьВверх(Норматив.Минимум - Покрытие);
		Если СтрокиТовара.Количество() > 0 Тогда
			Лучшая = СтрокаПродаж(СтрокиТовара, Истина);
			Лучшая.Количество = Лучшая.Количество + Недостача;
			Покрытие = Покрытие + Недостача;
		ИначеЕсли Не Норматив.ЕстьХарактеристики Тогда
			Строка = Строки.Добавить();
			Строка.Номенклатура = Норматив.Номенклатура;
			Строка.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			Строка.Количество = Недостача;
			Строка.ПродажиВДень = 0;
			Покрытие = Покрытие + Недостача;
		Иначе
			Пропущенные.Добавить(Норматив.Номенклатура);
		КонецЕсли;
	КонецЕсли;
	Если Норматив.Максимум > 0 И Покрытие > Норматив.Максимум Тогда
		СнятьПревышение(СтрокиТовара, ОкруглитьВверх(Покрытие - Норматив.Максимум));
	КонецЕсли;
КонецПроцедуры

// Строка товара с наибольшими (Истина) или наименьшими (Ложь) продажами среди строк с количеством.
//
// Параметры:
//  СтрокиТовара - Массив из СтрокаТаблицыЗначений - строки товара.
//  Наибольшие   - Булево - искать наибольшие продажи.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - строка.
//
Функция СтрокаПродаж(СтрокиТовара, Наибольшие)
	Найдена = Неопределено;
	Для Каждого Строка Из СтрокиТовара Цикл
		Если Не Наибольшие И Строка.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Лучше = Найдена = Неопределено Или Наибольшие И Строка.ПродажиВДень > Найдена.ПродажиВДень
			Или Не Наибольшие И Строка.ПродажиВДень < Найдена.ПродажиВДень;
		Если Лучше Тогда
			Найдена = Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Найдена;
КонецФункции

Процедура СнятьПревышение(СтрокиТовара, Превышение)
	Осталось = Превышение;
	Строка = СтрокаПродаж(СтрокиТовара, Ложь);
	Пока Осталось > 0 И Строка <> Неопределено Цикл
		Снять = Мин(Осталось, Строка.Количество);
		Строка.Количество = Строка.Количество - Снять;
		Осталось = Осталось - Снять;
		Строка = СтрокаПродаж(СтрокиТовара, Ложь);
	КонецЦикла;
КонецПроцедуры

Функция ТекстЗапросаРекомендаций()
	Возврат
	"ВЫБРАТЬ
	|	Обороты.Номенклатура КАК Номенклатура,
	|	Обороты.Характеристика КАК Характеристика,
	|	СУММА(Обороты.КоличествоОборот) КАК Продано
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&Начало, &Конец, , МестоХранения = &Точка) КАК Обороты
	|
	|СГРУППИРОВАТЬ ПО
	|	Обороты.Номенклатура,
	|	Обороты.Характеристика
	|
	|ИМЕЮЩИЕ
	|	СУММА(Обороты.КоличествоОборот) > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Потребность КАК Потребность,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.ЗапрошеноОстаток КАК Запрошено,
	|	Остатки.ПринятоОстаток КАК Принято,
	|	Остатки.ОтгруженоОстаток КАК Отгружено,
	|	Остатки.ПолученоОстаток КАК Получено
	|ПОМЕСТИТЬ ВТПотребности
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек.Остатки(, Точка = &Точка) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТПокрытиеСтрок
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(, МестоХранения = &Точка) КАК Остатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	П.Номенклатура,
	|	П.Характеристика,
	|	П.Отгружено - П.Получено
	|ИЗ
	|	ВТПотребности КАК П
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	П.Номенклатура,
	|	П.Характеристика,
	|	ВЫБОР
	|		КОГДА Д.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПотребностейТорговыхТочек.Отправлена)
	|			ТОГДА П.Запрошено
	|		КОГДА Д.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПотребностейТорговыхТочек.Принята)
	|			ТОГДА П.Принято - П.Отгружено
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	ВТПотребности КАК П
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПотребностьТорговойТочки КАК Д
	|		ПО П.Потребность = Д.Ссылка
	|ГДЕ
	|	П.Потребность <> &Исключить
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Покрытие.Номенклатура КАК Номенклатура,
	|	Покрытие.Характеристика КАК Характеристика,
	|	СУММА(Покрытие.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТПокрытие
	|ИЗ
	|	ВТПокрытиеСтрок КАК Покрытие
	|
	|СГРУППИРОВАТЬ ПО
	|	Покрытие.Номенклатура,
	|	Покрытие.Характеристика
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Продажи.Номенклатура КАК Номенклатура,
	|	Продажи.Характеристика КАК Характеристика,
	|	Продажи.Продано КАК Продано,
	|	ЕСТЬNULL(Покрытие.Количество, 0) КАК Покрытие
	|ИЗ
	|	ВТПродажи КАК Продажи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	|		ПО Продажи.Номенклатура = Товары.Ссылка
	|			И (Товары.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПокрытие КАК Покрытие
	|		ПО Продажи.Номенклатура = Покрытие.Номенклатура
	|			И Продажи.Характеристика = Покрытие.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Покрытие.Номенклатура КАК Номенклатура,
	|	СУММА(Покрытие.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТПокрытиеТоваров
	|ИЗ
	|	ВТПокрытие КАК Покрытие
	|
	|СГРУППИРОВАТЬ ПО
	|	Покрытие.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Характеристики.Владелец КАК Номенклатура
	|ПОМЕСТИТЬ ВТСХарактеристиками
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК Характеристики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.МинимальныйОстатокПоСкладам КАК Нормативы
	|		ПО Характеристики.Владелец = Нормативы.Номенклатура
	|			И (Нормативы.МестоХранения = &Точка)
	|ГДЕ
	|	НЕ Характеристики.ПометкаУдаления
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Нормативы.Номенклатура КАК Номенклатура,
	|	Нормативы.МинимальноеКоличествоХранения КАК Минимум,
	|	Нормативы.МаксимальноеКоличествоХранения КАК Максимум,
	|	ЕСТЬNULL(Покрытие.Количество, 0) КАК Покрытие,
	|	НЕ СХарактеристиками.Номенклатура ЕСТЬ NULL КАК ЕстьХарактеристики
	|ИЗ
	|	РегистрСведений.МинимальныйОстатокПоСкладам КАК Нормативы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	|		ПО Нормативы.Номенклатура = Товары.Ссылка
	|			И (Товары.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПокрытиеТоваров КАК Покрытие
	|		ПО Нормативы.Номенклатура = Покрытие.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСХарактеристиками КАК СХарактеристиками
	|		ПО Нормативы.Номенклатура = СХарактеристиками.Номенклатура
	|ГДЕ
	|	Нормативы.МестоХранения = &Точка
	|	И Нормативы.МинимальноеКоличествоХранения + Нормативы.МаксимальноеКоличествоХранения > 0";
КонецФункции

Функция РазрешенныеПереходы(Доверенный)
	Статусы = Перечисления.СтатусыПотребностейТорговыхТочек;
	Переходы = Новый Соответствие;
	Переходы.Вставить("Новый", МассивСтатусов(Статусы.Черновик, Статусы.Отправлена));
	Переходы.Вставить(Статусы.Черновик, МассивСтатусов(Статусы.Черновик, Статусы.Отправлена));
	Если Доверенный Тогда
		ИзОтправленной = МассивСтатусов(Статусы.Отправлена, Статусы.Черновик, Статусы.Принята, Статусы.Отклонена);
		Переходы.Вставить(Статусы.Отправлена, ИзОтправленной);
		Переходы.Вставить(Статусы.Принята, МассивСтатусов(Статусы.Принята, Статусы.Закрыта));
		Переходы.Вставить(Статусы.Отклонена, МассивСтатусов(Статусы.Отклонена, Статусы.Черновик));
		Переходы.Вставить(Статусы.Закрыта, МассивСтатусов(Статусы.Закрыта));
	Иначе
		Переходы.Вставить(Статусы.Отправлена, МассивСтатусов(Статусы.Черновик));
	КонецЕсли;
	Возврат Переходы;
КонецФункции

Функция МассивСтатусов(Статус1, Статус2 = Неопределено, Статус3 = Неопределено, Статус4 = Неопределено)
	Результат = ДополнительныеСтатусы(Статус2, Статус3, Статус4);
	Результат.Вставить(0, Статус1);
	Возврат Результат;
КонецФункции

Функция ДополнительныеСтатусы(Статус2, Статус3, Статус4)
	Результат = Новый Массив;
	Если Статус2 <> Неопределено Тогда
		Результат.Добавить(Статус2);
	КонецЕсли;
	Если Статус3 <> Неопределено Тогда
		Результат.Добавить(Статус3);
	КонецЕсли;
	Если Статус4 <> Неопределено Тогда
		Результат.Добавить(Статус4);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция СостояниеПоКоличествам(Статус, Принято, Отгружено, Получено)
	Статусы = Перечисления.СтатусыПотребностейТорговыхТочек;
	Если Отгружено = 0 Тогда
		Возврат Статус;
	ИначеЕсли Получено >= Отгружено И Отгружено >= Принято Тогда
		Возврат Статусы.Получена;
	ИначеЕсли Отгружено >= Принято Тогда
		Возврат Статусы.Отгружена;
	Иначе
		Возврат Статусы.ЧастичноОтгружена;
	КонецЕсли;
КонецФункции

Функция ПериодЗаписиИстории(Потребность)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(История.Период) КАК Период
	|ИЗ
	|	РегистрСведений.ИсторияСтатусовПотребностей КАК История
	|ГДЕ
	|	История.Потребность = &Потребность";
	Запрос.УстановитьПараметр("Потребность", Потребность);
	Выборка = Запрос.Выполнить().Выбрать();
	Период = ТекущаяДатаСеанса();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Период) И Выборка.Период >= Период Тогда
		Период = Выборка.Период + 1;
	КонецЕсли;
	Возврат Период;
КонецФункции

Функция ОтгруженоПоСтрокам(Потребность)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.КодСтроки КАК КодСтроки,
	|	СУММА(Остатки.ОтгруженоОстаток) КАК Отгружено
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек.Остатки(, Потребность = &Потребность) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.КодСтроки";
	Запрос.УстановитьПараметр("Потребность", Потребность);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.КодСтроки, Выборка.Отгружено);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СтрокиСписания(Списание)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Серия КАК Серия,
	|	Товары.Потребность КАК Потребность,
	|	Товары.КодСтрокиПотребности КАК КодСтрокиПотребности,
	|	Товары.Количество КАК Количество,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.Потребность <> ЗНАЧЕНИЕ(Документ.ПотребностьТорговойТочки.ПустаяСсылка) КАК СПотребностью
	|ИЗ
	|	Документ.ПеремещениеТоваров.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Списание
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки";
	Запрос.УстановитьПараметр("Списание", Списание);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция СтрокиПотребностей(Потребности)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Потребность,
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Серия КАК Серия,
	|	Шапки.МестоХранения КАК Точка,
	|	Шапки.СкладСнабжения КАК СкладСнабжения
	|ИЗ
	|	Документ.ПотребностьТорговойТочки.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПотребностьТорговойТочки КАК Шапки
	|		ПО Товары.Ссылка = Шапки.Ссылка
	|ГДЕ
	|	Товары.Ссылка В (&Потребности)";
	Запрос.УстановитьПараметр("Потребности", Потребности);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ПроверитьСтрокуПотребности(ДокОбъект, Строка, СтрокиПотребностей, Нарушения)
	Отбор = Новый Структура("Потребность, КодСтроки", Строка.Потребность, Строка.КодСтрокиПотребности);
	Найденные = СтрокиПотребностей.НайтиСтроки(Отбор);
	Если Найденные.Количество() = 0 Тогда
		Причина = НСтр("ru = 'нет такой строки потребности';
			|fr = 'pas de telle ligne de besoin'; en = 'no such need line'; es = 'no existe esa línea de necesidad'");
		ДобавитьНарушениеСтроки(Нарушения, Строка, Причина);
		Возврат;
	КонецЕсли;
	СтрокаПотребности = Найденные[0];
	Списание = ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание;
	ДругойСклад = Списание И ДокОбъект.МестоХранения <> СтрокаПотребности.СкладСнабжения
		Или ДокОбъект.МестоХраненияОприходование <> СтрокаПотребности.Точка;
	Если ДругойСклад Тогда
		Причина = НСтр("ru = 'склады перемещения не совпадают с потребностью';
			|fr = 'les entrepôts du transfert ne correspondent pas au besoin';
			|en = 'the transfer warehouses do not match the need';
			|es = 'los almacenes del traslado no coinciden con la necesidad'");
		ДобавитьНарушениеСтроки(Нарушения, Строка, Причина);
	КонецЕсли;
	ДругойТовар = Строка.Номенклатура <> СтрокаПотребности.Номенклатура
		Или Строка.Характеристика <> СтрокаПотребности.Характеристика
		Или ЗначениеЗаполнено(СтрокаПотребности.Серия) И Строка.Серия <> СтрокаПотребности.Серия;
	Если ДругойТовар Тогда
		Причина = НСтр("ru = 'товар не совпадает со строкой потребности';
			|fr = 'l''article ne correspond pas à la ligne du besoin';
			|en = 'the item does not match the need line';
			|es = 'el artículo no coincide con la línea de la necesidad'");
		ДобавитьНарушениеСтроки(Нарушения, Строка, Причина);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСоответствиеОснованию(Строка, СтрокиОснования, Нарушения)
	СтрокаОснования = СтрокиОснования.Найти(Строка.КодСтроки, "КодСтроки");
	Если Не СтрокаСовпадаетСОснованием(Строка, СтрокаОснования) Тогда
		Причина = НСтр("ru = 'строка не совпадает со строкой списания-основания';
			|fr = 'la ligne ne correspond pas à la ligne de la sortie de base';
			|en = 'the line does not match the base write-off line';
			|es = 'la línea no coincide con la línea de la salida de base'");
		ДобавитьНарушениеСтроки(Нарушения, Строка, Причина);
	КонецЕсли;
КонецПроцедуры

Функция СтрокаСовпадаетСОснованием(Строка, СтрокаОснования)
	Если СтрокаОснования = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Поле Из СтрРазделить("Номенклатура,Характеристика,Серия,Потребность,КодСтрокиПотребности", ",") Цикл
		Если СтрокаОснования[Поле] <> Строка[Поле] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура ДобавитьНарушениеСтроки(Нарушения, Строка, Причина)
	Шаблон = НСтр("ru = 'Строка %1 «%2»: %3.'; fr = 'Ligne %1 « %2 » : %3.'; en = 'Line %1 «%2»: %3.';
		|es = 'Línea %1 «%2»: %3.'");
	Текст = СтрШаблон(Шаблон, Строка.НомерСтроки, Строка.Номенклатура, Причина);
	Нарушения.Добавить(Текст);
КонецПроцедуры

Процедура ДобавитьИзменение(Изменения, Потребность, КодСтроки, Количество)
	Найден = Неопределено;
	Для Каждого КлючИЗначение Из Изменения Цикл
		Если КлючИЗначение.Ключ.Потребность = Потребность И КлючИЗначение.Ключ.КодСтроки = КодСтроки Тогда
			Найден = КлючИЗначение.Ключ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Найден = Неопределено Тогда
		Найден = Новый Структура("Потребность, КодСтроки", Потребность, КодСтроки);
		Изменения.Вставить(Найден, 0);
	КонецЕсли;
	Изменения.Вставить(Найден, Изменения[Найден] + Количество);
КонецПроцедуры

Функция ЧерновикОприходования(Списание)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Документы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК Документы
	|ГДЕ
	|	Документы.Основание = &Списание
	|	И Документы.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПеремещениеОприходование)
	|	И НЕ Документы.Проведен
	|	И НЕ Документы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Списание", Списание);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Документы.ПеремещениеТоваров.ПустаяСсылка());
КонецФункции

Процедура ПроверитьСписаниеДляПолучения(Потребность, Списание, Точка)
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Списание,
		"Проведен, ХозяйственнаяОперация, МестоХраненияОприходование");
	СтрокиСписания = СтрокиСписания(Списание);
	СписаниеПотребности = Реквизиты.Проведен
		И Реквизиты.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание
		И Реквизиты.МестоХраненияОприходование = Точка
		И СтрокиСписания.Найти(Потребность, "Потребность") <> Неопределено;
	Если Не СписаниеПотребности Тогда
		ВызватьИсключение НСтр("ru = 'Это не проведённое списание по этой потребности.';
			|fr = 'Ce n''est pas une sortie validée de ce besoin.';
			|en = 'This is not a posted write-off of this need.';
			|es = 'No es una salida contabilizada de esta necesidad.'");
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Найдено
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК Документы
	|ГДЕ
	|	Документы.Основание = &Списание
	|	И Документы.Проведен";
	Запрос.УстановитьПараметр("Списание", Списание);
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение НСтр("ru = 'Списание уже оприходовано; повторное получение оформляет склад.';
			|fr = 'La sortie est déjà réceptionnée ; une nouvelle réception est faite par l''entrepôt.';
			|en = 'The write-off has already been received; a repeat receipt is made by the warehouse.';
			|es = 'La salida ya se recibió; la nueva recepción la hace el almacén.'");
	КонецЕсли;
КонецПроцедуры

Функция ОбъектОприходования(Черновик, Списание)
	Если ЗначениеЗаполнено(Черновик) Тогда
		ДокОбъект = Черновик.ПолучитьОбъект();
		Годен = ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеОприходование
			И ДокОбъект.Основание = Списание И Не ДокОбъект.Проведен И Не ДокОбъект.ПометкаУдаления;
		Если Годен Тогда
			Возврат ДокОбъект;
		КонецЕсли;
	КонецЕсли;
	Возврат Документы.ПеремещениеТоваров.СоздатьДокумент();
КонецФункции

Процедура ЗаполнитьОприходованиеИзСписания(ДокОбъект, Списание)
	Шапка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Списание,
		"Организация, МестоХранения, МестоХраненияОприходование, Перевозчик");
	ЗаполнитьЗначенияСвойств(ДокОбъект, Шапка);
	ДокОбъект.Основание = Списание;
	ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеОприходование;
	ДокОбъект.Дата = ТекущаяДатаСеанса();
	ДокОбъект.Ответственный = ПараметрыСеанса.Пользователь;
	Неполучено = НеполученоПоСтрокамСписания(Списание);
	ДокОбъект.ТЧТовары.Очистить();
	Для Каждого СтрокаСписания Из СтрокиСписания(Списание) Цикл
		Количество = СтрокаСписания.Количество;
		Если СтрокаСписания.СПотребностью Тогда
			Остаток = Неполучено[СтрокаСписания.КодСтроки];
			Количество = ?(Остаток = Неопределено, 0, Остаток);
		КонецЕсли;
		Если Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = ДокОбъект.ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, СтрокаСписания);
		Строка.Количество = Количество;
		Если СтрокаСписания.Количество <> Количество И СтрокаСписания.Количество <> 0 Тогда
			Строка.КоличествоУпаковок = СтрокаСписания.КоличествоУпаковок * Количество / СтрокаСписания.Количество;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция НеполученоПоСтрокамСписания(Списание)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.КодСтрокиОтгрузки КАК КодСтроки,
	|	СУММА(Остатки.ОтгруженоОстаток - Остатки.ПолученоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек.Остатки(, Отгрузка = &Списание) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.КодСтрокиОтгрузки";
	Запрос.УстановитьПараметр("Списание", Списание);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.КодСтроки, Выборка.Количество);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
