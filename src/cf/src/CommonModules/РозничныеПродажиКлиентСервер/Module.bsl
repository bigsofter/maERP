#Область ПрограммныйИнтерфейс

// Суммы строки чека кассы из цены, количества и процента скидки (план docs/plans/retail-cash-amounts.md, §1). Цена -
// цена упаковки строки с НДС, количество - в упаковках строки; суммы считаются только из этих полей, повторный вызов
// даёт тот же результат.
//
// Параметры:
//  Строка - ДанныеФормыЭлементКоллекции, СтрокаТаблицыЗначений, Структура - строка чека с полями Цена, Количество,
//           ПроцентСкидки, СтавкаНДС, Сумма, СуммаСкидки, СуммаСНДС, СуммаНДС.
//
Процедура РассчитатьСтрокуЧека(Строка) Экспорт
	Строка.Сумма = Окр(Строка.Цена * Строка.Количество, ТочностьСумм());
	Строка.СуммаСкидки = Окр(Строка.Сумма * Строка.ПроцентСкидки / РаботаСДокументамиКлиентСервер.СтоПроцентов(), ТочностьСумм());
	Строка.СуммаСНДС = Строка.Сумма - Строка.СуммаСкидки;
	Строка.СуммаНДС = РаботаСДокументамиКлиентСервер.РассчитатьСуммуНДС(Строка.СтавкаНДС, Строка.СуммаСНДС, Истина);
КонецПроцедуры

// Пересчитывает строки чека и возвращает его итоги.
//
// Параметры:
//  Строки              - ДанныеФормыКоллекция, ТаблицаЗначений - строки чека (см. РассчитатьСтрокуЧека).
//  ПроцентСкидкиЧека   - Число - скидка чека, процент.
//  ПрименитьСкидкуЧека - Булево - Истина: строкам ставится процент чека; Ложь: процент строк не меняется (возврат,
//                        погашение долга, документ с разными процентами строк).
//  ТолькоОтмеченные    - Булево - в итоги идут только строки с Отметка = Истина (возврат).
//  ПересчитыватьСтроки - Булево - Истина: суммы строк считаются РассчитатьСтрокуЧека (новый и отложенный чек); Ложь:
//                        суммы строк проведённой реализации - как в документе (цены могут быть без НДС).
//
// Возвращаемое значение:
//  Структура - итоги:
//   * СуммаБезСкидок - Число - сумма строк до скидки с НДС: сумма после скидки плюс скидка (скидка строки считается
//                      от суммы с НДС и при ценах без НДС).
//   * СуммаСкидки    - Число - сумма скидок строк.
//   * СуммаСоСкидкой - Число - сумма строк после скидки.
//
Функция ПересчитатьЧек(Строки, ПроцентСкидкиЧека, ПрименитьСкидкуЧека, ТолькоОтмеченные = Ложь,
	ПересчитыватьСтроки = Истина) Экспорт
	Итоги = Новый Структура("СуммаБезСкидок, СуммаСкидки, СуммаСоСкидкой", 0, 0, 0);
	Для Каждого Строка Из Строки Цикл
		Если ПрименитьСкидкуЧека Тогда
			Строка.ПроцентСкидки = ПроцентСкидкиЧека;
		КонецЕсли;
		Если ПересчитыватьСтроки Тогда
			РассчитатьСтрокуЧека(Строка);
		КонецЕсли;
		Если ТолькоОтмеченные И Не Строка.Отметка Тогда
			Продолжить;
		КонецЕсли;
		Итоги.СуммаБезСкидок = Итоги.СуммаБезСкидок + Строка.СуммаСНДС + Строка.СуммаСкидки;
		Итоги.СуммаСкидки = Итоги.СуммаСкидки + Строка.СуммаСкидки;
		Итоги.СуммаСоСкидкой = Итоги.СуммаСоСкидкой + Строка.СуммаСНДС;
	КонецЦикла;
	Возврат Итоги;
КонецФункции

// Скидка чека по строкам документа: отложенный чек и реализация, открытая на кассе, восстанавливают процент чека.
//
// Параметры:
//  Строки - ДанныеФормыКоллекция, ТаблицаЗначений, ТабличнаяЧасть - строки с полем ПроцентСкидки.
//
// Возвращаемое значение:
//  Структура - скидка:
//   * Процент - Число - процент, одинаковый у всех строк; при разных процентах - 0.
//   * Единая  - Булево - Истина, если у всех строк один процент (или строк нет).
//
Функция СкидкаЧекаПоСтрокам(Строки) Экспорт
	Скидка = Новый Структура("Процент, Единая", 0, Истина);
	Если Строки.Количество() = 0 Тогда
		Возврат Скидка;
	КонецЕсли;
	Скидка.Процент = Строки[0].ПроцентСкидки;
	Для Каждого Строка Из Строки Цикл
		Если Строка.ПроцентСкидки <> Скидка.Процент Тогда
			Скидка.Процент = 0;
			Скидка.Единая = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Скидка;
КонецФункции

// Строка реализации по строке чека: количество в упаковках строки, процент скидки, суммы - из строки чека (то, что
// оплачено), без повторного расчёта.
//
// Параметры:
//  СтрокаДокумента - СтрокаТабличнойЧасти - строка ТЧТовары реализации.
//  СтрокаЧека      - ДанныеФормыЭлементКоллекции, СтрокаТаблицыЗначений - строка чека, рассчитанная
//                    РассчитатьСтрокуЧека.
//
Процедура ЗаполнитьСтрокуРеализации(СтрокаДокумента, СтрокаЧека) Экспорт
	ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаЧека);
	СтрокаДокумента.КоличествоУпаковок = СтрокаЧека.Количество;
	РаботаСДокументамиКлиентСервер.РассчитатьКоличество(СтрокаДокумента);
	СтрокаДокумента.ПроцентСкидки = СтрокаЧека.ПроцентСкидки;
	СтрокаДокумента.СкидкаНаЦену = СтрокаЧека.Цена * СтрокаЧека.ПроцентСкидки
		/ РаботаСДокументамиКлиентСервер.СтоПроцентов();
	// Цена единицы хранения: по ней штатный пересчёт реализации восстанавливает цену упаковки.
	СтрокаДокумента.ЦенаSKU = ?(СтрокаДокумента.Количество = 0, СтрокаЧека.Цена,
		СтрокаЧека.Цена * СтрокаДокумента.КоличествоУпаковок / СтрокаДокумента.Количество);
	ЗаполнитьСуммыСтроки(СтрокаДокумента, СтрокаЧека);
	СтрокаДокумента.СуммаСкидки = СтрокаЧека.СуммаСкидки;
КонецПроцедуры

// Строка возврата по строке проведённой реализации, открытой на кассе. У возврата нет скидки: сумма с НДС и НДС -
// суммы строки после скидки; сумма и цена - в режиме НДС возврата (он берётся у основания), цена - справочно.
//
// Параметры:
//  СтрокаДокумента - СтрокаТабличнойЧасти - строка ТЧТовары возврата от покупателя.
//  СтрокаЧека      - ДанныеФормыЭлементКоллекции, СтрокаТаблицыЗначений - строка чека с суммами строки реализации
//                    (для части количества - см. ДоляСтрокиДокумента).
//  ЦенаВключаетНДС - Булево - режим НДС возврата.
//
Процедура ЗаполнитьСтрокуВозврата(СтрокаДокумента, СтрокаЧека, ЦенаВключаетНДС) Экспорт
	ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаЧека);
	СтрокаДокумента.КоличествоУпаковок = СтрокаЧека.Количество;
	РаботаСДокументамиКлиентСервер.РассчитатьКоличество(СтрокаДокумента);
	ЗаполнитьСуммыСтроки(СтрокаДокумента, СтрокаЧека);
	СтрокаДокумента.Сумма = ?(ЦенаВключаетНДС, СтрокаЧека.СуммаСНДС, СтрокаЧека.СуммаСНДС - СтрокаЧека.СуммаНДС);
	СтрокаДокумента.Цена = ?(СтрокаЧека.Количество = 0, 0, Окр(СтрокаДокумента.Сумма / СтрокаЧека.Количество, ТочностьСумм()));
КонецПроцедуры

// Часть строки проведённой реализации для возврата: количество - не больше количества строки, суммы - доля исходных
// сумм строки (всё количество - суммы строки без изменений); цена и процент скидки не меняются.
//
// Параметры:
//  СтрокаДокумента - СтрокаТабличнойЧасти, ВыборкаИзРезультатаЗапроса, Структура - строка реализации с полями
//                    КоличествоУпаковок, Сумма, СуммаСкидки, СуммаСНДС, СуммаНДС.
//  Количество      - Число - запрошенное количество в упаковках строки.
//
// Возвращаемое значение:
//  Структура - Количество, Сумма, СуммаСкидки, СуммаСНДС, СуммаНДС для строки чека.
//
Функция ДоляСтрокиДокумента(СтрокаДокумента, Количество) Экспорт
	Доля = Новый Структура("Количество, Сумма, СуммаСкидки, СуммаСНДС, СуммаНДС");
	ЗаполнитьЗначенияСвойств(Доля, СтрокаДокумента);
	Доля.Количество = Мин(Макс(Количество, 0), СтрокаДокумента.КоличествоУпаковок);
	Если Доля.Количество = СтрокаДокумента.КоличествоУпаковок Тогда
		Возврат Доля;
	КонецЕсли;
	Коэффициент = Доля.Количество / СтрокаДокумента.КоличествоУпаковок;
	Доля.Сумма = Окр(СтрокаДокумента.Сумма * Коэффициент, ТочностьСумм());
	Доля.СуммаСкидки = Окр(СтрокаДокумента.СуммаСкидки * Коэффициент, ТочностьСумм());
	Доля.СуммаСНДС = Окр(СтрокаДокумента.СуммаСНДС * Коэффициент, ТочностьСумм());
	Доля.СуммаНДС = Окр(СтрокаДокумента.СуммаНДС * Коэффициент, ТочностьСумм());
	Возврат Доля;
КонецФункции

// Сумма строки ниже порога минимальной цены - правило контроля при проведении (КонтрольЦенПродажи) и в редакторе
// строки кассы: сумма в базе порога меньше Окр(порог × количество, 2) с допуском в копейку.
//
// Параметры:
//  Сумма      - Число - сумма строки в базе порога (с НДС или без НДС), в основной валюте.
//  Порог      - Число - порог цены единицы хранения.
//  Количество - Число - количество в единицах хранения.
//
// Возвращаемое значение:
//  Булево - Истина, если сумма ниже порога.
//
Функция НижеПорога(Сумма, Порог, Количество) Экспорт
	Копейка = 0.01;
	Возврат Сумма < Окр(Порог * Количество, ТочностьСумм()) - Копейка;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Точность сумм строк чека - копейки.
//
// Возвращаемое значение:
//  Число - знаков после запятой.
//
Функция ТочностьСумм()
	Возврат 2;
КонецФункции

Процедура ЗаполнитьСуммыСтроки(СтрокаДокумента, СтрокаЧека)
	СтрокаДокумента.Сумма = СтрокаЧека.Сумма;
	СтрокаДокумента.СуммаСНДС = СтрокаЧека.СуммаСНДС;
	СтрокаДокумента.СуммаНДС = СтрокаЧека.СуммаНДС;
КонецПроцедуры

#КонецОбласти
