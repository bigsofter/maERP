// Дата начала учёта взаиморасчётов (docs/plans/commerce-two-orgs.md, Ф5): документы раньше даты константы не пишут
// обычные взаиморасчёты (с покупателями, поставщиками, прочие), документ переноса расчётов (налоговая накладная,
// документ «на основаниях») с основанием раньше даты их не переносит. Налоговые регистры не отсекаются. Пустая
// константа - поведение как прежде. Остатки на дату вводятся корректировкой; смена константы применяется при
// перепроведении.

#Область ПрограммныйИнтерфейс

// Подписка ПередЗаписью наборов записей регистров обычных взаиморасчётов: правила 0-3 плана.
//
// Параметры:
//  Источник  - РегистрНакопленияНаборЗаписей - набор ВзаиморасчётыСПокупателями, СПоставщиками или СКонтрагентамиПрочие.
//  Отказ     - Булево - не используется.
//  Замещение - Булево - режим замещения.
//
Процедура ПередЗаписьюНабора(Источник, Отказ, Замещение) Экспорт
	ПрименитьОтсечку(Источник);
КонецПроцедуры

// Очищает набор регистратора, который по дате начала учёта взаиморасчётов расчётов не пишет (правила 1-2).
//
// Параметры:
//  Набор - РегистрНакопленияНаборЗаписей - набор обычных взаиморасчётов.
//
Процедура ПрименитьОтсечку(Набор) Экспорт
	Если Набор.Количество() = 0 Или Набор.ОбменДанными.Загрузка Или Не Набор.Отбор.Регистратор.Использование Тогда
		Возврат;
	КонецЕсли;
	ДатаНачала = ДатаНачалаУчета();
	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		Возврат;
	КонецЕсли;
	Регистратор = Набор.Отбор.Регистратор.Значение;
	Если Не ЗначениеЗаполнено(Регистратор) Или РегистраторБезОтсечки(Регистратор) Тогда
		Возврат;
	КонецЕсли;
	// Дата - из базы: при проведении объект уже записан, ссылка даёт новую дату.
	ДатаРегистратора = ДатаДокумента(Регистратор);
	Если ДатаРегистратора < ДатаНачала Тогда
		Набор.Очистить();
		Возврат;
	КонецЕсли;
	Если ЭтоДокументПереноса(Регистратор) И Не РасчетыПереносятся(Регистратор) Тогда
		Набор.Очистить();
		СообщитьОбОтсечкеПереноса(Регистратор);
	КонецЕсли;
КонецПроцедуры

// Переносит ли документ переноса расчётов (налоговая накладная, документ «на основаниях») расчёты оснований: дата
// начала не задана или все его основания - не раньше неё (правило 2). Прочие документы - Истина.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  Булево
//
Функция РасчетыПереносятся(Регистратор) Экспорт
	ДатаНачала = ДатаНачалаУчета();
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЭтоДокументПереноса(Регистратор) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат РасчетыПереносятсяПоДатам(ДатаДокумента(Регистратор), ОснованияДокументаПереноса(Регистратор), ДатаНачала);
КонецФункции

// Налоговые накладные (продажи и покупки) из списка, которые по дате начала учёта взаиморасчётов расчёты не переносят:
// сама накладная или одно из её оснований раньше даты (правило 2) - одним запросом по всем (ревью 2.0.17.29, круг 8).
//
// Параметры:
//  Накладные - Массив из ДокументСсылка.НалоговаяНакладная, ДокументСсылка.НалоговаяНакладнаяПокупка - накладные.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка - пустой, если дата начала не задана.
//
Функция НакладныеБезПереноса(Накладные) Экспорт
	ДатаНачала = ДатаНачалаУчета();
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Накладные.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - даты накладных и оснований читаются при записи движений
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Т.Ссылка КАК Накладная,
	                      |	Т.ОтгрузкаТовара КАК Основание
	                      |ПОМЕСТИТЬ ВТОснования
	                      |ИЗ
	                      |	Документ.НалоговаяНакладная.ТЧТовары КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка В (&Накладные)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Т.Ссылка,
	                      |	Т.ОтгрузкаТовара
	                      |ИЗ
	                      |	Документ.НалоговаяНакладная.ТЧУслуги КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка В (&Накладные)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Т.Ссылка,
	                      |	Т.ПоступлениеТовара
	                      |ИЗ
	                      |	Документ.НалоговаяНакладнаяПокупка.ТЧТовары КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка В (&Накладные)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Т.Ссылка,
	                      |	Т.ПоступлениеТовара
	                      |ИЗ
	                      |	Документ.НалоговаяНакладнаяПокупка.ТЧУслуги КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка В (&Накладные)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Н.Ссылка КАК Накладная
	                      |ИЗ
	                      |	Документ.НалоговаяНакладная КАК Н
	                      |ГДЕ
	                      |	Н.Ссылка В (&Накладные)
	                      |	И Н.Дата < &ДатаНачала
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Н.Ссылка
	                      |ИЗ
	                      |	Документ.НалоговаяНакладнаяПокупка КАК Н
	                      |ГДЕ
	                      |	Н.Ссылка В (&Накладные)
	                      |	И Н.Дата < &ДатаНачала
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ВТОснования.Накладная
	                      |ИЗ
	                      |	ВТОснования КАК ВТОснования
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Р
	                      |		ПО ВТОснования.Основание = Р.Ссылка
	                      |ГДЕ
	                      |	Р.Дата < &ДатаНачала
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ВТОснования.Накладная
	                      |ИЗ
	                      |	ВТОснования КАК ВТОснования
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК П
	                      |		ПО ВТОснования.Основание = П.Ссылка
	                      |ГДЕ
	                      |	П.Дата < &ДатаНачала");
	Запрос.УстановитьПараметр("Накладные", Накладные);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Накладная");
КонецФункции

// То же по данным объекта, ещё не записанного в базу: сравнение старой и новой версии накладной при смене даты (Ф1,
// «Неизменность накладной с зависимыми регистраторами») и проверка возвратов до накладной.
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  ИмяРеквизита - Строка - "ОтгрузкаТовара" или "ПоступлениеТовара".
//
// Возвращаемое значение:
//  Булево
//
Функция РасчетыПереносятсяОбъекта(ДокОбъект, ИмяРеквизита) Экспорт
	ДатаНачала = ДатаНачалаУчета();
	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		Возврат Истина;
	КонецЕсли;
	Основания = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект, ИмяРеквизита).ВыгрузитьКолонку("Основание");
	Возврат РасчетыПереносятсяПоДатам(ДокОбъект.Дата, Основания, ДатаНачала);
КонецФункции

// Основания документа переноса расчётов по данным в базе: строки налоговой накладной продажи или покупки, табличная
// часть «Основания» документа «на основаниях».
//
// Параметры:
//  Регистратор - ДокументСсылка - документ переноса.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция ОснованияДокументаПереноса(Регистратор) Экспорт
	// BSLLS:SetPrivilegedMode-off - состав оснований читается при записи движений
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Т.ОтгрузкаТовара КАК Основание
	                      |ИЗ
	                      |	Документ.НалоговаяНакладная.ТЧТовары КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка = &Регистратор
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Т.ОтгрузкаТовара
	                      |ИЗ
	                      |	Документ.НалоговаяНакладная.ТЧУслуги КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка = &Регистратор
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Т.ПоступлениеТовара
	                      |ИЗ
	                      |	Документ.НалоговаяНакладнаяПокупка.ТЧТовары КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка = &Регистратор
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Т.ПоступлениеТовара
	                      |ИЗ
	                      |	Документ.НалоговаяНакладнаяПокупка.ТЧУслуги КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка = &Регистратор
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Т.Основание
	                      |ИЗ
	                      |	Документ.РеализацияТоваровУслуг.Основания КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка = &Регистратор
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Т.Основание
	                      |ИЗ
	                      |	Документ.ПоступлениеТоваровУслуг.Основания КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка = &Регистратор");
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Результат = Новый Массив;
	Для Каждого Основание Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Основание") Цикл
		Если ЗначениеЗаполнено(Основание) И Результат.Найти(Основание) = Неопределено Тогда
			Результат.Добавить(Основание);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Дата начала учёта взаиморасчётов. Константа читается привилегированно: проверка отсечки - при записи движений
// любым пользователем, право на константу ролям не выдаётся.
//
// Возвращаемое значение:
//  Дата - пустая: отсечки нет.
//
Функция ДатаНачалаУчета() Экспорт
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Возврат Константы.ДатаНачалаУчетаВзаиморасчетов.Получить();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Правило 0: корректировки (ввод остатков на дату начала) и защищённые переносом документы - без изменений.
//
// Параметры:
//  Регистратор - ДокументСсылка - регистратор набора.
//
// Возвращаемое значение:
//  Булево
//
Функция РегистраторБезОтсечки(Регистратор)
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.КорректировкаРегистров")
		Или ТипЗнч(Регистратор) = Тип("ДокументСсылка.КорректировкаДолга") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ПеренесенныеДокументы.Защищен(Регистратор);
КонецФункции

Функция ЭтоДокументПереноса(Регистратор)
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.НалоговаяНакладная")
		Или ТипЗнч(Регистратор) = Тип("ДокументСсылка.НалоговаяНакладнаяПокупка") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат НалоговыеДокументыНаОснованиях.ЭтоРегистраторНаОснованиях(Регистратор);
КонецФункции

Функция ДатаДокумента(Регистратор)
	// BSLLS:SetPrivilegedMode-off - дата регистратора читается при записи его движений
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Регистратор, "Дата");
КонецФункции

// Документ переноса переносит расчёты, если он сам и все его основания - не раньше даты начала.
//
// Параметры:
//  ДатаДокумента - Дата - дата документа переноса.
//  Основания     - Массив из ДокументСсылка - основания.
//  ДатаНачала    - Дата - дата начала учёта взаиморасчётов.
//
// Возвращаемое значение:
//  Булево
//
Функция РасчетыПереносятсяПоДатам(ДатаДокумента, Основания, ДатаНачала)
	Если ДатаДокумента < ДатаНачала Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Основания.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - даты оснований читаются при записи движений
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Р.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.РеализацияТоваровУслуг КАК Р
	                      |ГДЕ
	                      |	Р.Ссылка В (&Основания)
	                      |	И Р.Дата < &ДатаНачала
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	П.Ссылка
	                      |ИЗ
	                      |	Документ.ПоступлениеТоваровУслуг КАК П
	                      |ГДЕ
	                      |	П.Ссылка В (&Основания)
	                      |	И П.Дата < &ДатаНачала");
	Запрос.УстановитьПараметр("Основания", Основания);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Возврат Запрос.Выполнить().Пустой();
КонецФункции

Процедура СообщитьОбОтсечкеПереноса(Регистратор)
	Шаблон = НСтр("ru = 'Документ %1: основания раньше даты начала учёта взаиморасчётов - расчёты не переносятся.';
		|fr = 'Document %1 : des bases sont antérieures à la date de début des règlements - les règlements ne sont pas reportés.';
		|en = 'Document %1: bases are earlier than the settlements start date - settlements are not carried over.';
		|es = 'Documento %1: hay bases anteriores a la fecha de inicio de liquidaciones - las liquidaciones no se trasladan.'");
	Текст = СтрШаблон(Шаблон, Регистратор);
	Событие = НСтр("ru = 'Дата начала учёта взаиморасчётов'; fr = 'Date de début des règlements';
		|en = 'Settlements start date'; es = 'Fecha de inicio de liquidaciones'");
	МетаданныеРегистратора = Регистратор.Метаданные();
	ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, МетаданныеРегистратора, Регистратор, Текст);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
КонецПроцедуры

#КонецОбласти
