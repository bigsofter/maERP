
#Область Изображения

Процедура РассчитатьРазмерИРасположениеКартинки(Картинка, Знач Ширина, Знач Высота, Знач Верх, Знач Лево, Знач МасштабПечати = Неопределено, МасштабКартинки = 100) Экспорт
	// Рассчитываем размеры относительно масштаба картинки
	Ширина = Ширина / 100 * МасштабКартинки;
	Высота = Высота / 100 * МасштабКартинки;
	// Рассчитаем размеры относительно масштаба печати
	Если МасштабПечати <> Неопределено Тогда 
		Ширина = Ширина * 100 / МасштабПечати;
		Высота = Высота * 100 / МасштабПечати;
		Верх = Верх * 100 / МасштабПечати;		
		Лево = Лево * 100 / МасштабПечати;		
	КонецЕсли;
	// Рассчитаем положение относительно низа картинки
	Верх = Верх - Высота;
	// Устанавливаем значения
	Картинка.Верх = Верх;
	Картинка.Лево = Лево;
	Картинка.Ширина = Ширина;
	Картинка.Высота = Высота;	
КонецПроцедуры

// Подставляет логотип организации в рисунок области макета: в рисунок с именем «Логотип»,
// а если его нет - в первый рисунок области.
//
// Параметры:
//  Область - ТабличныйДокумент - область макета с рисунком под логотип.
//  Логотип - ХранилищеЗначения, ДвоичныеДанные, Неопределено - логотип организации
//            (реквизит Организации.Логотип); при пустом значении рисунок не меняется.
//
Процедура УстановитьЛоготип(Область, Логотип) Экспорт
	Рисунок = Область.Рисунки.Найти("Логотип");
	Если Рисунок = Неопределено И Область.Рисунки.Количество() > 0 Тогда
		Рисунок = Область.Рисунки[0];
	КонецЕсли;
	Если Рисунок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Данные = ?(ТипЗнч(Логотип) = Тип("ХранилищеЗначения"), Логотип.Получить(), Логотип);
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		Рисунок.Картинка = Новый Картинка(Данные);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

