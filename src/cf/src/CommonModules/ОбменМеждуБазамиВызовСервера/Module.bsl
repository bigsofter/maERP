КонецФункции

// Проверяет подключение к HTTP-сервису партнёра (инициатор).
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Строка - итог для пользователя.
//
Функция ПроверитьПодключение(Узел) Экспорт
	ПроверитьПравоНастройки();
	Возврат ОбменМеждуБазами.ПроверитьПодключение(Узел);
КонецФункции

// Сохраняет логин и пароль технического пользователя партнёра; пароль на клиент не возвращается.
//
// Параметры:
//  Узел         - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  Пользователь - Строка - логин.
//  Пароль       - Строка - пароль.
//
Процедура УстановитьУчетныеДанные(Узел, Пользователь, Пароль) Экспорт
	ПроверитьПравоНастройки();
	ОбменМеждуБазамиПолныеПрава.УстановитьУчетныеДанные(Узел, Пользователь, Пароль);
КонецПроцедуры

// Логин партнёра, сохранённый в узле (без пароля).
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Строка - логин; пустая - не задан.
//
Функция ПользовательПартнера(Узел) Экспорт
	ПроверитьПравоНастройки();
	Возврат ОбменМеждуБазамиПолныеПрава.ПользовательПартнера(Узел);
КонецФункции

// Пользователи ИБ с ролью сервиса обмена - для выбора пользователя сервиса узла (только администратору).
//
// Возвращаемое значение:
//  СписокЗначений из Строка - значение - уникальный идентификатор пользователя ИБ, представление - имя.
//
Функция ПользователиСервиса() Экспорт
	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Пользователя сервиса назначает администратор';
			|fr = 'L''utilisateur du service est affecté par l''administrateur';
			|en = 'The service user is assigned by the administrator'; es = 'El usuario del servicio lo asigna el administrador'");
	КонецЕсли;
	Результат = Новый СписокЗначений;
	Роль = Метаданные.Роли.ОбменМеждуБазамиСервис;
	Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если ПользовательИБ.Роли.Содержит(Роль) Тогда
			Результат.Добавить(Строка(ПользовательИБ.УникальныйИдентификатор), ПользовательИБ.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Имя пользователя ИБ по уникальному идентификатору (для формы узла).
//
// Параметры:
//  Ид - Строка - уникальный идентификатор пользователя ИБ.
//
// Возвращаемое значение:
//  Строка - имя; пустая - не найден.
//
Функция ИмяПользователяСервиса(Ид) Экспорт
	ПроверитьПравоНастройки();
	Возврат ОбменМеждуБазамиПолныеПрава.ИмяПользователяИБ(Ид);
КонецФункции

// Код этой базы для передачи партнёру; не задан - создаётся.
//
// Возвращаемое значение:
//  Строка - код узла этой базы.
//
Функция КодЭтойБазы() Экспорт
	ПроверитьПравоНастройки();
	Возврат ОбменМеждуБазами.КодЭтойБазы();
КонецФункции

// Данные монитора обмена: узлы с состоянием, отложенные и несопоставленные объекты текущего узла.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - текущий узел; пустой - только узлы.
//
// Возвращаемое значение:
//  Структура - Узлы, Отложенные (ТаблицаЗначений), Несопоставленные (см. ОбменМеждуБазами.НесопоставленныеОбъекты).
//
Функция ДанныеМонитора(Узел) Экспорт
	ПроверитьПравоНастройки();
	Результат = Новый Структура("Узлы, Отложенные", ОбменМеждуБазами.УзлыМонитора(), Неопределено);
	Результат.Вставить("Несопоставленные", Неопределено);
	ПеревестиКоды(Результат.Узлы, "Результат");
	Если ЗначениеЗаполнено(Узел) Тогда
		Результат.Отложенные = ОбменМеждуБазами.ОтложенныеМонитора(Узел);
		ПеревестиКоды(Результат.Отложенные, "ТипОбъекта, Статус");
		Результат.Несопоставленные = ОбменМеждуБазами.НесопоставленныеОбъекты(Узел);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПеревестиКоды(Таблица, Колонки)
	// Регистры хранят служебные коды; монитору - представление на языке пользователя.
	Представления = Новый Соответствие;
	Представления.Вставить("Успешно", НСтр("ru = 'Успешно'; fr = 'Réussi'; en = 'Success'; es = 'Correcto'"));
	Представления.Вставить("Ошибка", НСтр("ru = 'Ошибка'; fr = 'Erreur'; en = 'Error'; es = 'Error'"));
	Представления.Вставить("Отложен", НСтр("ru = 'Отложен'; fr = 'En attente'; en = 'Deferred'; es = 'Pendiente'"));
	Представления.Вставить(ОбменМеждуБазами.ТипРеализация(),
		НСтр("ru = 'Реализация'; fr = 'Vente'; en = 'Sale'; es = 'Venta'"));
	Представления.Вставить(ОбменМеждуБазами.ТипУстановкаЦен(),
		НСтр("ru = 'Установка цен'; fr = 'Fixation des prix'; en = 'Price setting'; es = 'Fijación de precios'"));
	ИменаКолонок = СтрРазделить(Колонки, ", ", Ложь);
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Для Каждого ИмяКолонки Из ИменаКолонок Цикл
			Представление = Представления[СтрокаТаблицы[ИмяКолонки]];
			Если Представление <> Неопределено Тогда
				СтрокаТаблицы[ИмяКолонки] = Представление;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьПравоНастройки()
	Если Не ПравоДоступа("Изменение", Метаданные.ПланыОбмена.ОбменМеждуБазами) Тогда
		ВызватьИсключение НСтр("ru = 'Нет права на настройку обмена'; fr = 'Pas de droit de paramétrer l''échange';
			|en = 'No right to configure the exchange'; es = 'Sin derecho a configurar el intercambio'");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
