// Команды обмена между базами (docs/plans/exchange-maerp.md) для форм: право пользователя проверяется здесь, до
// вызова привилегированного кода модуля ОбменМеждуБазами.
// BSLLS:PrivilegedModuleMethodCall-off - ключи подписи: право настройки обмена проверяется здесь до вызова
// привилегированного модуля, ключ на клиент возвращается только при создании.

#Область ПрограммныйИнтерфейс

// Выполняет обмен узла.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Строка - итог для пользователя.
//
Функция ВыполнитьОбменУзла(Узел) Экспорт
	ПроверитьПравоНастройки();
	Итог = ОбменМеждуБазами.ВыполнитьОбмен(Узел);
	Возврат СтрШаблон(НСтр("ru = 'Отправлено: %1, принято: %2, отложено: %3'; fr = 'Envoyés : %1, reçus : %2, en attente : %3';
		|en = 'Sent: %1, received: %2, deferred: %3'; es = 'Enviados: %1, recibidos: %2, pendientes: %3'"),
		Итог.Отправлено, Итог.Принято, Итог.Отложено);
КонецФункции

// Повторяет применение отложенных объектов узла.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Число - применено объектов.
//
Функция ПовторитьОтложенные(Узел) Экспорт
	ПроверитьПравоНастройки();
	Возврат ОбменМеждуБазами.ПовторитьОтложенные(Узел);
КонецФункции

// Ручное сопоставление номенклатуры или характеристики партнёра своей.
//
// Параметры:
//  Узел       - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  ТипОбъекта - Строка - «Номенклатура», «Характеристика», «Упаковка».
//  ВнешнийИд  - Строка - идентификатор у партнёра.
//  Объект     - СправочникСсылка.Номенклатура, СправочникСсылка.ХарактеристикиНоменклатуры,
//               СправочникСсылка.УпаковкиЕдиницыИзмерения - свой объект.
//  ЭтоТовар   - Булево - для номенклатуры: строка товаров (Истина) или услуг (Ложь).
//
Процедура СопоставитьОбъект(Узел, ТипОбъекта, ВнешнийИд, Объект, ЭтоТовар = Истина) Экспорт
	ПроверитьПравоНастройки();
	ОбменМеждуБазами.СопоставитьОбъект(Узел, ТипОбъекта, ВнешнийИд, Объект, ЭтоТовар);
КонецПроцедуры

// Сопоставление единицы партнёра со своей единицей и коэффициентом.
//
// Параметры:
//  Узел               - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  ИдЕдиницыИсточника - Строка - идентификатор единицы у партнёра.
//  ЕдиницаПриемника   - СправочникСсылка.УпаковкиЕдиницыИзмерения - своя единица.
//  Коэффициент        - Число - сколько своих единиц в единице партнёра.
//  Номенклатура       - СправочникСсылка.Номенклатура, Неопределено - товар, для которого коэффициент свой; пусто -
//                       для всех товаров.
//
Процедура СопоставитьЕдиницу(Узел, ИдЕдиницыИсточника, ЕдиницаПриемника, Коэффициент, Номенклатура = Неопределено) Экспорт
	ПроверитьПравоНастройки();
	ОбменМеждуБазами.СопоставитьЕдиницу(Узел, ИдЕдиницыИсточника, ЕдиницаПриемника, Коэффициент, Номенклатура);
КонецПроцедуры

// Регистрирует реализацию на её узлы (вычисляет сервер) - команда документа «Отправить по обмену».
//
// Параметры:
//  Документ - ДокументСсылка.РеализацияТоваровУслуг - реализация.
//
// Возвращаемое значение:
//  Число - узлов.
//
Функция ОтправитьДокумент(Документ) Экспорт
	Если Не ПравоДоступа("Изменение", Документ.Метаданные()) Тогда
		ВызватьИсключение НСтр("ru = 'Нет права на документ'; fr = 'Pas de droit sur le document';
			|en = 'No right to the document'; es = 'Sin derecho al documento'");
	КонецЕсли;
	Возврат ОбменМеждуБазами.ОтправитьДокумент(Документ);
КонецФункции

// Создаёт ключ подписи пары и возвращает его один раз.
