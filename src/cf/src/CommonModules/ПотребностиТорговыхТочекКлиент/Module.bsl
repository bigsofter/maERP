#Область ПрограммныйИнтерфейс

// Действие с потребностью из команды (план docs/plans/retail-store-needs.md): несохранённая форма документа -
// сначала записать; после действия форма документа перечитывается, списки оповещаются.
//
// Параметры:
//  Потребность - ДокументСсылка.ПотребностьТорговойТочки - документ.
//  Действие    - Строка - см. ПотребностиТорговыхТочекВызовСервера.ВыполнитьДействие.
//  Источник    - ФормаКлиентскогоПриложения - форма, из которой вызвана команда.
//
Процедура ВыполнитьДействие(Потребность, Действие, Источник) Экспорт
	Если ФормаНеЗаписана(Источник) Тогда
		Возврат;
	КонецЕсли;
	ПотребностиТорговыхТочекВызовСервера.ВыполнитьДействие(Потребность, Действие);
	ОбновитьПослеДействия(Потребность, Источник);
КонецПроцедуры

// Получение отгрузки точкой: проводит оприходование и открывает его.
//
// Параметры:
//  Потребность - ДокументСсылка.ПотребностьТорговойТочки - документ.
//  Источник    - ФормаКлиентскогоПриложения - форма, из которой вызвана команда.
//
Процедура ПолучитьОтгрузку(Потребность, Источник) Экспорт
	Если ФормаНеЗаписана(Источник) Тогда
		Возврат;
	КонецЕсли;
	Оприходование = ПотребностиТорговыхТочекВызовСервера.ПолучитьОтгрузку(Потребность);
	ОбновитьПослеДействия(Потребность, Источник);
	ПоказатьЗначение(, Оприходование);
КонецПроцедуры

// Заполнение черновика по анализу продаж и остатков точки.
//
// Параметры:
//  Потребность - ДокументСсылка.ПотребностьТорговойТочки - черновик.
//  Источник    - ФормаКлиентскогоПриложения - форма, из которой вызвана команда.
//
Процедура ЗаполнитьПоАнализу(Потребность, Источник) Экспорт
	Если ФормаНеЗаписана(Источник) Тогда
		Возврат;
	КонецЕсли;
	Сообщение = ПотребностиТорговыхТочекВызовСервера.ЗаполнитьПоАнализу(Потребность);
	ОбновитьПослеДействия(Потребность, Источник);
	Если ЗначениеЗаполнено(Сообщение) Тогда
		ПоказатьПредупреждение(, Сообщение);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ФормаНеЗаписана(Источник)
	Если ТипЗнч(Источник) = Тип("ФормаКлиентскогоПриложения") И Источник.Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите документ.'; fr = 'Enregistrez d''abord le document.';
			|en = 'Save the document first.'; es = 'Guarde primero el documento.'"));
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Процедура ОбновитьПослеДействия(Потребность, Источник)
	ОповеститьОбИзменении(Потребность);
	Если ТипЗнч(Источник) = Тип("ФормаКлиентскогоПриложения") И Источник.Параметры.Свойство("Ключ") Тогда
		Источник.Прочитать();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
