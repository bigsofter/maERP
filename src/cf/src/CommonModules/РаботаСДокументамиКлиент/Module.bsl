Процедура ПроверитьСуммуОснованийПлатёжногоДокумента(Объект, Отказ) Экспорт
	Если Объект.ТЧОснования.Итог("Сумма") > Объект.Сумма Тогда
		ПоказатьПредупреждение(, Нстр("fr = 'La somme des documents de base est supérieure à la somme du document'; ru = 'Сумма оснований больше суммы документа'; en = 'The amount of grounds is greater than the amount of the document'; es = 'La suma de los motivos es mayor que la suma del documento'"),, "Внимание");
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

Процедура ПроверитьСуммуАвансовТоварногоДокумента(Объект, Отказ) Экспорт
	Если Объект.ТЧЗачётАвансов.Итог("Сумма") > Объект.Сумма Тогда
		ПоказатьПредупреждение(, Нстр("fr = 'Le montant des avances est supérieur au montant du document'; ru = 'Сумма авансов больше суммы документа'; en = 'The amount of the advances is more than the amount of the document'; es = 'El monto de los anticipos es mayor que el monto del documento'"),, "Внимание");
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

Процедура ПоказатьВопросОПроверкеДокумента(ОписаниеОповещения, ТекстВопроса) Экспорт
	СЗКнопки = Новый СписокЗначений;
	СЗКнопки.Добавить(КодВозвратаДиалога.ОК, "Подтвердить");
	СЗКнопки.Добавить(КодВозвратаДиалога.Отмена, "Проверить");
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СЗКнопки,,, "Внимание");	
КонецПроцедуры	

Функция КлиентуЗапрещеноОтгружать(ДокОбъект) Экспорт
	Если ТипЗнч(ДокОбъект.Ссылка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда 
		ДатаОтгрузки = ДокОбъект.ДатаОтгрузки;
	ИначеЕсли ТипЗнч(ДокОбъект.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ДатаОтгрузки = ДокОбъект.Дата;
	иначе
		Возврат Ложь;
	КонецЕсли;
	ЗапрещеноОтгружать = РаботаСДокументамиВызовСервера.КлиентуЗапрещеноОтгружать(ДокОбъект.Контрагент, ДатаОтгрузки);
	Если ЗапрещеноОтгружать Тогда 
		ПоказатьПредупреждение(,Нстр("fr = ""Il est interdit d'expédier vers ce point de vente !"
"Raison : Il y a des expéditions impayées dépassant le report et le crédit établis en vertu du contrat.""; ru = 'Запрещено отгружать данной торговой точке!"
"Причина: Есть неоплаченные отгрузки превышающие установленную отсрочку и кредит по договору.'; en = 'It is forbidden to ship to this outlet!"
"Reason: There are unpaid shipments exceeding the established deferral and credit under the agreement.'; es = '¡Está Prohibido enviar a este punto de venta!"
"Razón: Hay envíos impagados que exceden el aplazamiento establecido y el crédito del contrato.'"),10);
	КонецЕсли;
	Возврат ЗапрещеноОтгружать;
КонецФункции

