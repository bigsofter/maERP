// Защита документов, чьи движения восстановлены переносом из старой учётной системы (docs/plans/retail-client-update.md,
// раздел 2): проведение, отмена проведения, запись, пометка и удаление запрещены всем; загрузка (ОбменДанными.Загрузка)
// проходит. Мягкая защита (основание «УбыткиСписания» - списание, чей убыток перенесён в корректировку регистров):
// проведение разрешено (пересчёт себестоимости), отмена проведения, пометка и удаление - нет. Историческая налоговая
// накладная (docs/plans/commerce-two-orgs.md, Ф4): проведение разрешено только без изменения данных - по отпечатку,
// сохранённому при защите; изменить данные может только шаг переноса (ДополнительныеСвойства.ШагПереноса,
// администратор), он же пересохраняет отпечаток. Снятие защиты - удаление записи регистра ПеренесенныеДокументы
// администратором.

#Область ПрограммныйИнтерфейс

// Подписка ПередЗаписью перенесённых документов.
//
// Параметры:
//  Источник        - ДокументОбъект - документ.
//  Отказ           - Булево - отказ записи.
//  РежимЗаписи     - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписьюПеренесенного(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Источник.ОбменДанными.Загрузка Или Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Защита = ЗаписьЗащиты(Источник.Ссылка);
	Если Защита = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Шаг переноса меняет данные защищённого документа и в той же транзакции пересохраняет отпечаток.
	Если ЭтоШагПереноса(Источник) Тогда
		Защитить(Источник.Ссылка, Защита.Основание, Источник);
		Возврат;
	КонецЕсли;
	Текст = ТекстЗапретаЗаписи(Источник, РежимЗаписи, Защита);
	Если ЗначениеЗаполнено(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , , , Отказ);
	КонецЕсли;
КонецПроцедуры

// Текст отказа записи защищённого документа по таблице «основание -> что разрешено» (см. ПередЗаписьюПеренесенного).
//
// Параметры:
//  Источник    - ДокументОбъект - документ.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  Защита      - Структура, Неопределено - см. ЗаписьЗащиты; Неопределено - прочитать.
//
// Возвращаемое значение:
//  Строка - пустая, если запись разрешена.
//
Функция ТекстЗапретаЗаписи(Источник, РежимЗаписи, Защита = Неопределено) Экспорт
	Если Защита = Неопределено Тогда
		Защита = ЗаписьЗащиты(Источник.Ссылка);
	КонецЕсли;
	Если Защита = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Проведение = ПравилоПроведения(Защита.Основание);
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Или Источник.ПометкаУдаления
		Или Проведение = ПравилоЗапрещено() Тогда
		Возврат ТекстЗащиты(Источник.Ссылка);
	КонецЕсли;
	// Записи 2.0.17.20 без отпечатка - как прежде, без сравнения.
	Если Проведение = ПравилоПоОтпечатку() И ЗначениеЗаполнено(Защита.ОтпечатокДанных)
		И ОтпечатокДанных(Источник) <> Защита.ОтпечатокДанных Тогда
		Шаблон = НСтр("ru = 'Защищённый документ %1 изменён: проводится только без изменения данных.';
			|fr = 'Le document protégé %1 a été modifié : il ne se valide que sans modification des données.';
			|en = 'Protected document %1 was changed: it can be posted only without data changes.';
			|es = 'El documento protegido %1 ha cambiado: solo se contabiliza sin cambios de datos.'");
		Возврат СтрШаблон(Шаблон, Источник.Ссылка);
	КонецЕсли;
	Возврат "";
КонецФункции

// Подписка ПередУдалением перенесённых документов.
//
// Параметры:
//  Источник - ДокументОбъект - документ.
//  Отказ    - Булево - отказ удаления.
//
Процедура ПередУдалениемПеренесенного(Источник, Отказ) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Защищен(Источник.Ссылка) Тогда
		СообщитьОЗащите(Источник.Ссылка, Отказ);
	КонецЕсли;
КонецПроцедуры

// Подписка ПередЗаписью набора записей Убытки: набор защищённого регистратора записывается только загрузкой
// (запись набора в обход объекта документа).
//
// Параметры:
//  Источник   - РегистрНакопленияНаборЗаписей.Убытки - набор.
//  Отказ      - Булево - отказ записи.
//  Замещение  - Булево - режим замещения.
//
Процедура ПередЗаписьюНабораУбытков(Источник, Отказ, Замещение) Экспорт
	Если Источник.ОбменДанными.Загрузка Или Не Источник.Отбор.Регистратор.Использование Тогда
		Возврат;
	КонецЕсли;
	Регистратор = Источник.Отбор.Регистратор.Значение;
	Основание = ?(ЗначениеЗаполнено(Регистратор), ОснованиеЗащиты(Регистратор), Неопределено);
	// Мягко защищённое списание перепроводится: платформа очищает его набор Убытки (убыток живёт в корректировке) -
	// разрешена только очистка.
	Мягкая = Основание <> Неопределено И ПравилоПроведения(Основание) <> ПравилоЗапрещено();
	Если Основание <> Неопределено И (Не Мягкая Или Источник.Количество() > 0) Тогда
		СообщитьОЗащите(Регистратор, Отказ);
	КонецЕсли;
КонецПроцедуры

// Можно ли перепровести документ из подписки оплат: жёстко защищённый перенесённый документ не проводится вовсе,
// и отказ его записи внутри транзакции платежа уронил бы платёж (docs/plans/commerce-two-orgs.md, Ф3.2).
//
// Параметры:
//  Ссылка - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  Булево
//
Функция МожноПерепровестиПоОплате(Ссылка) Экспорт
	Основание = ОснованиеЗащиты(Ссылка);
	Возврат Основание = Неопределено Или ПроведениеРазрешено(Основание);
КонецФункции

// Документ защищён как перенесённый.
//
// Параметры:
//  Ссылка - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  Булево
//
Функция Защищен(Ссылка) Экспорт
	Возврат ОснованиеЗащиты(Ссылка) <> Неопределено;
КонецФункции

// Основание защиты документа.
//
// Параметры:
//  Ссылка - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  Строка, Неопределено - основание («Убытки», «УбыткиСписания»); Неопределено - не защищён.
//
Функция ОснованиеЗащиты(Ссылка) Экспорт
	Защита = ЗаписьЗащиты(Ссылка);
	Возврат ?(Защита = Неопределено, Неопределено, Защита.Основание);
КонецФункции

// Запись защиты документа: основание и отпечаток данных.
//
// Параметры:
//  Ссылка - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  Структура, Неопределено - Основание (Строка), ОтпечатокДанных (Строка); Неопределено - не защищён.
//
Функция ЗаписьЗащиты(Ссылка) Экспорт
	// Регистр ролям недоступен: проверка защиты - для любого пользователя, пишущего документ.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запись = РегистрыСведений.ПеренесенныеДокументы.СоздатьМенеджерЗаписи();
	Запись.ПеренесенныйДокумент = Ссылка;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Основание, ОтпечатокДанных", Запись.Основание, Запись.ОтпечатокДанных);
КонецФункции

// Историческая (замороженная) налоговая накладная - мягкая защита по отпечатку данных (Ф4).
//
// Параметры:
//  Ссылка - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоИсторическийНалоговыйДокумент(Ссылка) Экспорт
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОснованиеЗащиты(Ссылка) = ОснованиеИсторическийНалоговыйДокумент();
КонецФункции

// Защищённые документы среди ссылок - одним запросом.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка - документы.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка - защищённые (любое основание).
//
Функция ЗащищенныеИз(Ссылки) Экспорт
	Если Ссылки.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - регистр ролям недоступен
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	П.ПеренесенныйДокумент КАК Документ
	                      |ИЗ
	                      |	РегистрСведений.ПеренесенныеДокументы КАК П
	                      |ГДЕ
	                      |	П.ПеренесенныйДокумент В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Документ");
КонецФункции

// Отпечаток данных документа: SHA-256 значений фиксированного перечня учётных полей (ревью 2.0.17.29, круг 14б) - шапка
// (дата, номер, организация, контрагент, договор, валюта и курс, суммы, признаки НДС и удержания) и строки товаров,
// услуг и ручной разбивки оплат (основание, номенклатура, количество, цена, суммы, ставка). Считается по значениям, а
// не по составу метаданных: новый реквизит или колонка в следующей сборке отпечаток не меняют. Версия схемы - в
// отпечатке и в ресурсе ВерсияОтпечатка. Незаполненное и отсутствующее поле пишется одинаково - пустым.
//
// Параметры:
//  ДокОбъект - ДокументОбъект, Структура - документ или его данные с теми же именами полей и табличных частей.
//
// Возвращаемое значение:
//  Строка - 64 шестнадцатеричных символа.
//
Функция ОтпечатокДанных(ДокОбъект) Экспорт
	Части = Новый Массив;
	Части.Добавить(ВерсияОтпечатка());
	Шапка = Новый Структура(ПоляОтпечаткаШапки());
	ЗаполнитьЗначенияСвойств(Шапка, ДокОбъект);
	НормализоватьЗначенияОтпечатка(Шапка);
	ДобавитьЗначенияОтпечатка(Части, Шапка, ПоляОтпечаткаШапки());
	ТабличныеЧасти = Новый Структура("ТЧТовары, ТЧУслуги, ТЧСпособыОплаты");
	ЗаполнитьЗначенияСвойств(ТабличныеЧасти, ДокОбъект);
	Для Каждого КлючИЗначение Из ТабличныеЧасти Цикл
		Части.Добавить(КлючИЗначение.Ключ);
		Если КлючИЗначение.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаЧасти Из КлючИЗначение.Значение Цикл
			ЗначенияСтроки = Новый Структура(ПоляОтпечаткаСтроки());
			ЗаполнитьЗначенияСвойств(ЗначенияСтроки, СтрокаЧасти);
			ДобавитьЗначенияОтпечатка(Части, ЗначенияСтроки, ПоляОтпечаткаСтроки());
		КонецЦикла;
	КонецЦикла;
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(СтрСоединить(Части, Символы.ПС));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

// Основание мягкой защиты исторической налоговой накладной (продажи или покупки), Ф4.
//
// Возвращаемое значение:
//  Строка
//
Функция ОснованиеИсторическийНалоговыйДокумент() Экспорт
	Возврат "ИсторическийНалоговыйДокумент";
КонецФункции

// Основание мягкой защиты списания, чей убыток перенесён в корректировку регистров.
//
// Возвращаемое значение:
//  Строка
//
Функция ОснованиеУбыткиСписания() Экспорт
	Возврат "УбыткиСписания";
КонецФункции

// Основание защиты корректировки регистров, созданной переносом для убытков списаний.
//
// Возвращаемое значение:
//  Строка
//
Функция ОснованиеКорректировкаПереноса() Экспорт
	Возврат "КорректировкаПереноса";
КонецФункции

// Ставит документ под защиту (обработка загрузки переноса). Для оснований «только без изменения данных» сохраняет
// отпечаток данных записанного документа или переданного объекта (шаг переноса).
//
// Параметры:
//  Ссылка    - ДокументСсылка - документ.
//  Основание - Строка - причина защиты («Убытки»).
//  ДокОбъект - ДокументОбъект, Неопределено - объект, чей отпечаток сохранить; Неопределено - документ из базы.
//
Процедура Защитить(Ссылка, Основание, ДокОбъект = Неопределено) Экспорт
	// Ставит защиту только обработка загрузки переноса (проверяет право администрирования до вызова).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запись = РегистрыСведений.ПеренесенныеДокументы.СоздатьМенеджерЗаписи();
	Запись.ПеренесенныйДокумент = Ссылка;
	Запись.ДатаПереноса = ТекущаяДатаСеанса();
	Запись.Основание = Основание;
	Если ПравилоПроведения(Основание) = ПравилоПоОтпечатку() Тогда
		Запись.ОтпечатокДанных = ОтпечатокДанных(?(ДокОбъект = Неопределено, Ссылка.ПолучитьОбъект(), ДокОбъект));
		// Версия схемы отпечатка - для пересчёта обработчиком при её будущей смене.
		Запись.ВерсияОтпечатка = ВерсияОтпечатка();
	КонецЕсли;
	Запись.Записать();
КонецПроцедуры

// Замораживает налоговые накладные (продажи и покупки) как исторические: основание ИсторическийНалоговыйДокумент,
// отпечаток данных текущей схемы (набор переноса после первого входа в базу, перешедшую со старой ветки; 2.0.17.29).
// Уже защищённые документы и документы других типов не трогаются. Только администратор.
//
// Параметры:
//  Накладные - Массив из ДокументСсылка.НалоговаяНакладная, ДокументСсылка.НалоговаяНакладнаяПокупка
//
// Возвращаемое значение:
//  Число - заморожено накладных.
//
Функция ЗаморозитьИсторическиеНакладные(Накладные) Экспорт
	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Заморозить исторические накладные может только администратор';
			|fr = 'Seul un administrateur peut figer les factures historiques';
			|en = 'Only an administrator can freeze historical invoices';
			|es = 'Solo un administrador puede congelar las facturas históricas'");
	КонецЕсли;
	Защищенные = Новый Соответствие;
	Для Каждого Ссылка Из ЗащищенныеИз(Накладные) Цикл
		Защищенные.Вставить(Ссылка, Истина);
	КонецЦикла;
	Заморожено = 0;
	Для Каждого Ссылка Из Накладные Цикл
		ЭтоНакладная = ТипЗнч(Ссылка) = Тип("ДокументСсылка.НалоговаяНакладная")
			Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.НалоговаяНакладнаяПокупка");
		Если ЭтоНакладная И Защищенные.Получить(Ссылка) = Неопределено Тогда
			Защитить(Ссылка, ОснованиеИсторическийНалоговыйДокумент());
			Защищенные.Вставить(Ссылка, Истина);
			Заморожено = Заморожено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Заморожено;
КонецФункции

// Дата инвойса налоговой накладной: незаполненная - день даты документа (реквизит хранит только дату). Одно правило
// для ПередЗаписью накладной и для отпечатка данных.
//
// Параметры:
//  ДатаИнвойса - Дата - дата инвойса документа.
//  Дата        - Дата - дата документа.
//
// Возвращаемое значение:
//  Дата
//
Функция ЗначениеДатыИнвойса(ДатаИнвойса, Дата) Экспорт
	Возврат НачалоДня(?(ЗначениеЗаполнено(ДатаИнвойса), ДатаИнвойса, Дата));
КонецФункции

// Имя признака шага переноса в ДополнительныеСвойства: обработка загрузки переноса меняет данные защищённого
// документа и пересохраняет отпечаток (только администратор).
//
// Возвращаемое значение:
//  Строка
//
Функция СвойствоШагПереноса() Экспорт
	Возврат "ШагПереноса";
КонецФункции

// Версия схемы отпечатка данных (перечень полей и правило значений). Смена перечня - новая версия и обработчик,
// пересчитывающий отпечатки неизменённых документов в том же обновлении.
//
// Возвращаемое значение:
//  Строка
//
Функция ВерсияОтпечатка() Экспорт
	Возврат "2";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разрешено ли проведение защищённого документа: «мягкие» основания (docs/plans/commerce-two-orgs.md, Ф4, таблица
// «основание - что разрешено»).
//
// Параметры:
//  Основание - Строка - основание защиты.
//
// Возвращаемое значение:
//  Булево
//
Функция ПроведениеРазрешено(Основание)
	Возврат ПравилоПроведения(Основание) <> ПравилоЗапрещено();
КонецФункции

// Что разрешено защищённому документу при проведении - таблица «основание -> правило» (Ф4). Отмена проведения, запись
// без проведения, пометка и удаление запрещены при любом основании.
//
// Параметры:
//  Основание - Строка - основание защиты.
//
// Возвращаемое значение:
//  Строка - см. ПравилоЗапрещено, ПравилоРазрешено, ПравилоПоОтпечатку.
//
Функция ПравилоПроведения(Основание)
	Правила = Новый Соответствие;
	Правила.Вставить(ОснованиеУбыткиСписания(), ПравилоРазрешено());
	Правила.Вставить(ОснованиеИсторическийНалоговыйДокумент(), ПравилоПоОтпечатку());
	Правило = Правила.Получить(Основание);
	Возврат ?(Правило = Неопределено, ПравилоЗапрещено(), Правило);
КонецФункции

Функция ПравилоЗапрещено()
	Возврат "Запрещено";
КонецФункции

Функция ПравилоРазрешено()
	Возврат "Разрешено";
КонецФункции

Функция ПравилоПоОтпечатку()
	Возврат "ПоОтпечатку";
КонецФункции

// Значения шапки после тех же нормализаций, что делает ПередЗаписью накладной (см. ЗначениеДатыИнвойса): отпечаток
// документа из базы и отпечаток объекта при проведении совпадают (ревью 2.0.17.29, круг 16).
//
// Параметры:
//  Шапка - Структура - значения полей шапки (см. ПоляОтпечаткаШапки), меняются на месте.
//
Процедура НормализоватьЗначенияОтпечатка(Шапка)
	Если ТипЗнч(Шапка.ДатаИнвойса) = Тип("Дата") И ТипЗнч(Шапка.Дата) = Тип("Дата") Тогда
		Шапка.ДатаИнвойса = ЗначениеДатыИнвойса(Шапка.ДатаИнвойса, Шапка.Дата);
	КонецЕсли;
КонецПроцедуры

Функция ПоляОтпечаткаШапки()
	Возврат "Дата, Номер, Организация, Контрагент, Договор, Валюта, ВВалюте, КурсВалюты, Сумма, СуммаНДС, СуммаРегл, "
		+ "ЦенаВключаетНДС, УдержаниеНДС, ПроцентУдержанияНДС, СуммаУдержанияНДС, РучнаяКорректировка, "
		+ "НомерВходящегоДокумента, ДатаВходящегоДокумента, ДатаИнвойса";
КонецФункции

Функция ПоляОтпечаткаСтроки()
	Возврат "ОтгрузкаТовара, ПоступлениеТовара, Номенклатура, Характеристика, Количество, КоличествоУпаковок, Цена, Сумма, "
		+ "СтавкаНДС, СуммаНДС, СуммаСНДС, ТипДенежныхСредств, Чек, Период";
КонецФункции

// Значения полей отпечатка - внутренним представлением каждого значения, по порядку полей; незаполненное значение
// (и отсутствующее у документа поле) - пустым «Имя=»: поле, добавленное позже со значением по умолчанию, отпечаток не
// меняет.
//
// Параметры:
//  Части    - Массив из Строка - дополняется.
//  Значения - Структура - значения полей.
//  Поля     - Строка - имена полей через запятую.
//
Процедура ДобавитьЗначенияОтпечатка(Части, Значения, Поля)
	Для Каждого Имя Из СтрРазделить(Поля, ",", Ложь) Цикл
		Имя = СокрЛП(Имя);
		Если ЗначениеЗаполнено(Имя) Тогда
			Значение = Значения[Имя];
			Части.Добавить(Имя + "=" + ?(ЗначениеЗаполнено(Значение), ЗначениеВСтрокуВнутр(Значение), ""));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЭтоШагПереноса(Источник)
	Если Не Источник.ДополнительныеСвойства.Свойство(СвойствоШагПереноса()) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПравоДоступа("Администрирование", Метаданные);
КонецФункции

Процедура СообщитьОЗащите(Ссылка, Отказ)
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗащиты(Ссылка), , , , Отказ);
КонецПроцедуры

Функция ТекстЗащиты(Ссылка)
	Шаблон = НСтр("ru = 'Документ %1 перенесён из прежней учётной системы вместе с движениями и защищён от изменения';
		|fr = 'Le document %1 a été transféré de l''ancien système avec ses mouvements et est protégé contre les modifications';
		|en = 'Document %1 was transferred from the previous system with its movements and is protected from changes';
		|es = 'El documento %1 se trasladó del sistema anterior con sus movimientos y está protegido contra cambios'");
	Возврат СтрШаблон(Шаблон, Ссылка);
КонецФункции

#КонецОбласти
