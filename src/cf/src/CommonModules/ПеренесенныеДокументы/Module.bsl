// Защита документов, чьи движения восстановлены переносом из старой учётной системы (docs/plans/retail-client-update.md,
// раздел 2): проведение, отмена проведения, запись, пометка и удаление запрещены всем; загрузка (ОбменДанными.Загрузка)
// проходит. Мягкая защита (основание «УбыткиСписания» - списание, чей убыток перенесён в корректировку регистров):
// проведение разрешено (пересчёт себестоимости), отмена проведения, пометка и удаление - нет. Снятие защиты - удаление
// записи регистра ПеренесенныеДокументы администратором.

#Область ПрограммныйИнтерфейс

// Подписка ПередЗаписью перенесённых документов.
//
// Параметры:
//  Источник        - ДокументОбъект - документ.
//  Отказ           - Булево - отказ записи.
//  РежимЗаписи     - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписьюПеренесенного(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Источник.ОбменДанными.Загрузка Или Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Основание = ОснованиеЗащиты(Источник.Ссылка);
	Если Основание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Мягкая = Основание = ОснованиеУбыткиСписания();
	Если Не Мягкая Или РежимЗаписи <> РежимЗаписиДокумента.Проведение Или Источник.ПометкаУдаления Тогда
		СообщитьОЗащите(Источник.Ссылка, Отказ);
	КонецЕсли;
КонецПроцедуры

// Подписка ПередУдалением перенесённых документов.
//
// Параметры:
//  Источник - ДокументОбъект - документ.
//  Отказ    - Булево - отказ удаления.
//
Процедура ПередУдалениемПеренесенного(Источник, Отказ) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Защищен(Источник.Ссылка) Тогда
		СообщитьОЗащите(Источник.Ссылка, Отказ);
	КонецЕсли;
КонецПроцедуры

// Подписка ПередЗаписью набора записей Убытки: набор защищённого регистратора записывается только загрузкой
// (запись набора в обход объекта документа).
//
// Параметры:
//  Источник   - РегистрНакопленияНаборЗаписей.Убытки - набор.
//  Отказ      - Булево - отказ записи.
//  Замещение  - Булево - режим замещения.
//
Процедура ПередЗаписьюНабораУбытков(Источник, Отказ, Замещение) Экспорт
	Если Источник.ОбменДанными.Загрузка Или Не Источник.Отбор.Регистратор.Использование Тогда
		Возврат;
	КонецЕсли;
	Регистратор = Источник.Отбор.Регистратор.Значение;
	Основание = ?(ЗначениеЗаполнено(Регистратор), ОснованиеЗащиты(Регистратор), Неопределено);
	// Мягко защищённое списание перепроводится: платформа очищает его набор Убытки (убыток живёт в корректировке) -
	// разрешена только очистка.
	Мягкая = Основание = ОснованиеУбыткиСписания();
	Если Основание <> Неопределено И (Не Мягкая Или Источник.Количество() > 0) Тогда
		СообщитьОЗащите(Регистратор, Отказ);
	КонецЕсли;
КонецПроцедуры

// Документ защищён как перенесённый.
//
// Параметры:
//  Ссылка - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  Булево
//
Функция Защищен(Ссылка) Экспорт
	Возврат ОснованиеЗащиты(Ссылка) <> Неопределено;
КонецФункции

// Основание защиты документа.
//
// Параметры:
//  Ссылка - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  Строка, Неопределено - основание («Убытки», «УбыткиСписания»); Неопределено - не защищён.
//
Функция ОснованиеЗащиты(Ссылка) Экспорт
	// Регистр ролям недоступен: проверка защиты - для любого пользователя, пишущего документ.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запись = РегистрыСведений.ПеренесенныеДокументы.СоздатьМенеджерЗаписи();
	Запись.ПеренесенныйДокумент = Ссылка;
	Запись.Прочитать();
	Возврат ?(Запись.Выбран(), Запись.Основание, Неопределено);
КонецФункции

// Основание мягкой защиты списания, чей убыток перенесён в корректировку регистров.
//
// Возвращаемое значение:
//  Строка
//
Функция ОснованиеУбыткиСписания() Экспорт
	Возврат "УбыткиСписания";
КонецФункции

// Основание защиты корректировки регистров, созданной переносом для убытков списаний.
//
// Возвращаемое значение:
//  Строка
//
Функция ОснованиеКорректировкаПереноса() Экспорт
	Возврат "КорректировкаПереноса";
КонецФункции

// Ставит документ под защиту (обработка загрузки переноса).
//
// Параметры:
//  Ссылка    - ДокументСсылка - документ.
//  Основание - Строка - причина защиты («Убытки»).
//
Процедура Защитить(Ссылка, Основание) Экспорт
	// Ставит защиту только обработка загрузки переноса (проверяет право администрирования до вызова).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запись = РегистрыСведений.ПеренесенныеДокументы.СоздатьМенеджерЗаписи();
	Запись.ПеренесенныйДокумент = Ссылка;
	Запись.ДатаПереноса = ТекущаяДатаСеанса();
	Запись.Основание = Основание;
	Запись.Записать();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СообщитьОЗащите(Ссылка, Отказ)
	Шаблон = НСтр("ru = 'Документ %1 перенесён из прежней учётной системы вместе с движениями и защищён от изменения';
		|fr = 'Le document %1 a été transféré de l''ancien système avec ses mouvements et est protégé contre les modifications';
		|en = 'Document %1 was transferred from the previous system with its movements and is protected from changes';
		|es = 'El documento %1 se trasladó del sistema anterior con sus movimientos y está protegido contra cambios'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Ссылка), , , , Отказ);
КонецПроцедуры

#КонецОбласти
