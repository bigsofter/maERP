////////////////////////////////////////////////////////////////////////////////
// Вход с клиента в механизм рабочих мест при запуске (docs/plans/startup-forms-warehouse-role.md). Модуль без
// привилегий: запись и чтение настроек текущего пользователя ИБ делает ФормыПриЗапускеПолныеПрава, он же проверяет
// белый список и право на рабочее место.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// BSLLS:PrivilegedModuleMethodCall-off - единственный вход в привилегированный модуль; пользователь, белый список и
// право на рабочее место проверяются там, параметры клиента сюда не попадают иначе как именем обработки и отметкой.

// Отмечено ли рабочее место к открытию при запуске у текущего пользователя.
//
// Параметры:
//  ИмяОбработки - Строка - имя обработки рабочего места.
//
// Возвращаемое значение:
//  Булево - Истина, если отмечено.
//
Функция ОткрыватьПриЗапуске(Знач ИмяОбработки) Экспорт
	Возврат ФормыПриЗапускеПолныеПрава.ОткрыватьПриЗапуске(ИмяОбработки);
КонецФункции

// Ставит или снимает отметку «Открывать при запуске» рабочего места текущему пользователю.
//
// Параметры:
//  ИмяОбработки - Строка - имя обработки рабочего места.
//  Открывать    - Булево - отметка.
//
Процедура УстановитьОткрытиеПриЗапуске(Знач ИмяОбработки, Знач Открывать) Экспорт
	ФормыПриЗапускеПолныеПрава.УстановитьОткрытиеПриЗапуске(ИмяОбработки, Открывать);
КонецПроцедуры

// Формы, которые клиент открывает при запуске программы.
//
// Возвращаемое значение:
//  Массив из Строка - полные имена форм.
//
Функция ФормыДляОткрытия() Экспорт
	Возврат ФормыПриЗапускеПолныеПрава.ФормыДляОткрытия();
КонецФункции

// BSLLS:PrivilegedModuleMethodCall-on

#КонецОбласти
