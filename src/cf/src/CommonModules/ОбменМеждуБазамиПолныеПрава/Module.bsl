// Учётные данные и ключи подписи обмена между базами (docs/plans/exchange-maerp.md): регистр УчетныеДанныеОбмена
// ролям недоступен, читается и пишется только здесь. Право изменения узла проверяется до действий с регистром;
// ключ и пароль на клиент не возвращаются (кроме однократного показа созданного ключа для передачи партнёру).
// BSLLS:PrivilegedModuleMethodCall-off - вызовы собственных служебных методов модуля, а не точка входа.

#Область ПрограммныйИнтерфейс

// Создаёт ключ подписи пары (32 случайных байта) и возвращает его один раз для передачи партнёру.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Строка - ключ в hex.
//
Функция СоздатьКлючПодписи(Узел) Экспорт
	ПроверитьПравоНастройки();
	Генератор = Новый ГенераторСлучайныхЧисел;
	Буфер = Новый БуферДвоичныхДанных(ДлинаКлюча());
	Для Индекс = 0 По ДлинаКлюча() - 1 Цикл
		Буфер.Установить(Индекс, Генератор.СлучайноеЧисло(0, МаксимальныйБайт()));
	КонецЦикла;
	Ключ = НРег(ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Буфер));
	ЗаписатьКлюч(Узел, Ключ);
	Возврат Ключ;
КонецФункции

// Сохраняет ключ подписи, введённый на второй стороне.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  Ключ - Строка - ключ в hex (64 символа).
//
Процедура УстановитьКлючПодписи(Узел, Ключ) Экспорт
	ПроверитьПравоНастройки();
	Значение = НРег(СокрЛП(Ключ));
	Если СтрДлина(Значение) <> ДлинаКлючаHex() Тогда
		ВызватьИсключение НСтр("ru = 'Ключ подписи - 64 шестнадцатеричных символа';
			|fr = 'La clé de signature compte 64 caractères hexadécimaux';
			|en = 'The signing key is 64 hexadecimal characters'; es = 'La clave de firma tiene 64 caracteres hexadecimales'");
	КонецЕсли;
	ПолучитьБуферДвоичныхДанныхИзHexСтроки(Значение);
	ЗаписатьКлюч(Узел, Значение);
КонецПроцедуры

// Ключ подписи узла - только для серверного кода транспорта.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Строка - ключ в hex; пустая - не задан.
//
Функция КлючПодписи(Узел) Экспорт
	Запись = РегистрыСведений.УчетныеДанныеОбмена.СоздатьМенеджерЗаписи();
	Запись.Узел = Узел;
	Запись.Прочитать();
	Возврат ?(Запись.Выбран(), Запись.КлючПодписи, "");
КонецФункции

// Задан ли ключ подписи (для формы узла - без раскрытия ключа).
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьКлючПодписи(Узел) Экспорт
	Возврат Не ПустаяСтрока(КлючПодписи(Узел));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПравоНастройки()
	Если Не ПравоДоступа("Изменение", Метаданные.ПланыОбмена.ОбменМеждуБазами) Тогда
		ВызватьИсключение НСтр("ru = 'Нет права на настройку обмена'; fr = 'Pas de droit de paramétrer l''échange';
			|en = 'No right to configure the exchange'; es = 'Sin derecho a configurar el intercambio'");
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьКлюч(Узел, Ключ)
	Запись = РегистрыСведений.УчетныеДанныеОбмена.СоздатьМенеджерЗаписи();
	Запись.Узел = Узел;
	Запись.Прочитать();
	Запись.Узел = Узел;
	Запись.КлючПодписи = Ключ;
	Запись.Записать();
КонецПроцедуры

Функция ДлинаКлюча()
	Возврат 32;
КонецФункции

Функция ДлинаКлючаHex()
	// Ключ в hex: два символа на байт.
	// BSLLS:MagicNumber-off
	Возврат 64;
	// BSLLS:MagicNumber-on
КонецФункции

Функция МаксимальныйБайт()
	Возврат 255;
КонецФункции

#КонецОбласти
