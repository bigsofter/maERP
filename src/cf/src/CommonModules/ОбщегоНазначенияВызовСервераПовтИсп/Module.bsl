Функция ПолучитьСоответствиеПревращенийХозяйственныхОпераций(ХозяйственнаяОперация) Экспорт
	ХО = Перечисления.ХозяйственныеОперации;
	Соответствие = Новый Соответствие;
	// Клиенты
	Соответствие.Вставить(ХО.ПоступлениеОплатыОтКлиента, ХО.ВозвратОплатыКлиенту);
	Соответствие.Вставить(ХО.ВозвратОплатыКлиенту, ХО.ПоступлениеОплатыОтКлиента);
	// Поставщики
	Соответствие.Вставить(ХО.ОплатаПоставщику, ХО.ВозвратДенежныхСредствОтПоставщика);
	Соответствие.Вставить(ХО.ВозвратДенежныхСредствОтПоставщика, ХО.ОплатаПоставщику);
	// Банковские счета
	Соответствие.Вставить(ХО.ПеречислениеДенежныхСредствНаБанковскийСчет, ХО.ПоступлениеДенежныхСредствСБанковскогоСчета);
	Соответствие.Вставить(ХО.ПоступлениеДенежныхСредствСБанковскогоСчета, ХО.ПеречислениеДенежныхСредствНаБанковскийСчет);
	// Кассы
	Соответствие.Вставить(ХО.ВыдачаДенежныхСредствВКассу, ХО.ПоступлениеДенежныхСредствИзКассы);
	Соответствие.Вставить(ХО.ПоступлениеДенежныхСредствИзКассы, ХО.ВыдачаДенежныхСредствВКассу);
	//
	НайденнаяХозяйственнаяОперация = Соответствие.Получить(ХозяйственнаяОперация);
	Возврат ?(НайденнаяХозяйственнаяОперация = Неопределено, ХозяйственнаяОперация, НайденнаяХозяйственнаяОперация);
КонецФункции

