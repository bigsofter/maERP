
#Область Разное
	
Функция ПроцентСтавкиНДС(СтавкаНДС) Экспорт
	Если ЗначениеЗаполнено(СтавкаНДС) Тогда 
		Возврат СтавкаНДС.Ставка;
	Иначе
		Возврат 0;
	КонецЕсли;	
КонецФункции	

// Реквизиты вида цен для подстановки цены (кэшируются на время сеанса).
//
// Параметры:
//  ВидЦены - СправочникСсылка.ВидыЦен
//
// Возвращаемое значение:
//  Структура - ДинамическийРасчет, ОсноваРасчёта, ВидНаценки, Показатель, Точность, ЦенаВключаетНДС;
//              для пустого вида цен ДинамическийРасчет = Ложь, ЦенаВключаетНДС = Истина.
//
Функция ДанныеВидаЦены(ВидЦены) Экспорт
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидЦены,
		"ДинамическийРасчет, ОсноваРасчёта, ВидНаценки, Показатель, Точность, ЦенаВключаетНДС");
	Данные.ДинамическийРасчет = (Данные.ДинамическийРасчет = Истина);
	Данные.ЦенаВключаетНДС = (Данные.ЦенаВключаетНДС = Истина Или Не ЗначениеЗаполнено(ВидЦены));
	Возврат Данные;
КонецФункции

#КонецОбласти

