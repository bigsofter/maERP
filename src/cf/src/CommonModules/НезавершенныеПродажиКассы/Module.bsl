		|fr = 'La session de caisse n''est pas ouverte ou est déjà fermée : ouvrez la session';
		|en = 'The cash session is not open or already closed: open the session';
		|es = 'El turno de caja no está abierto o ya está cerrado: abra el turno'");
КонецФункции

