// Незавершённые продажи кассы (docs/plans/retail-cash-unfinished.md): операции оплаты кассы (повтор после
// потерянного ответа - точно один раз), кассовая смена (открытие, закрытие, неизменность закрытой), отмена оплаченной
// кассовой продажи и платёж по отменённой.
//
// Порядок блокировок: операции пользователя -> смена -> номенклатура и IMEI -> документы -> взаиморасчёты -> деньги.
//
// Привилегированный режим - осознанно: регистр операций кассы закрыт для ролей, проверки смены и платежей идут по
// документам смены независимо от прав роли пользователя. BSLLS:SetPrivilegedMode-off

#Область ПрограммныйИнтерфейс

#Область ОперацииКассы

// Начало операции оплаты кассы (первый шаг транзакции оплаты): исключительная блокировка операций пользователя,
// отказ при неподтверждённой операции с другим идентификатором, поиск этой же операции.
//
// Параметры:
//  Идентификатор - Строка - идентификатор попытки оплаты формы.
//  Отпечаток     - Строка - отпечаток запроса (см. Отпечаток).
//
// Возвращаемое значение:
//  Структура, Неопределено - выполненная операция (см. ДанныеОперации); Неопределено - операции нет, оплата
//                            выполняется.
//
Функция НачатьОперацию(Идентификатор, Отпечаток) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ЗахватитьОперацииПользователя();
	Для Каждого Операция Из НеподтвержденныеОперации() Цикл
		Если Операция.Идентификатор <> Идентификатор Тогда
			Шаблон = НСтр("ru = 'Есть незавершённый чек %1: напечатайте и подтвердите его, затем повторите оплату';
				|fr = 'Un ticket %1 est inachevé : imprimez-le et confirmez-le, puis répétez le paiement';
				|en = 'Receipt %1 is unfinished: print and confirm it, then repeat the payment';
				|es = 'Hay un ticket %1 sin finalizar: imprímalo y confírmelo, luego repita el pago'");
			ВызватьИсключение СтрШаблон(Шаблон, Операция.Документ);
		КонецЕсли;
	КонецЦикла;
	Операция = ВыполненнаяОперация(Идентификатор);
	Если Операция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Операция.Отпечаток <> Отпечаток Тогда
		Шаблон = НСтр("ru = 'Чек изменён после неполученного ответа: уже записан %1';
			|fr = 'Le ticket a été modifié après une réponse perdue : %1 est déjà enregistré';
			|en = 'The receipt was changed after a lost response: %1 is already recorded';
			|es = 'El ticket cambió tras una respuesta perdida: %1 ya está registrado'");
		ВызватьИсключение СтрШаблон(Шаблон, Операция.Документ);
	КонецЕсли;
	Если Не ПустаяСтрока(Операция.Проблема) Тогда
		ВызватьИсключение Операция.Проблема;
	КонецЕсли;
	Возврат Операция;
КонецФункции

// Исключительная блокировка операций кассы текущего пользователя: оплаты одного кассира выполняются по очереди,
// открытие формы дожидается идущей оплаты.
//
Процедура ЗахватитьОперацииПользователя() Экспорт
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(ИмяРегистра());
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Пользователь", ПараметрыСеанса.Пользователь);
	Блокировка.Заблокировать();
КонецПроцедуры

// Регистрация выполненной операции в транзакции оплаты (после записи документов).
//
// Параметры:
//  Идентификатор - Строка - идентификатор попытки.
//  Данные        - Структура - Отпечаток, Документ, Документы (Массив документов операции), КассоваяСмена,
//                  ВнесеноНаличными, Сдача, СуммаОплаты.
//
Процедура ЗарегистрироватьОперацию(Идентификатор, Данные) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Версии = Новый Соответствие;
	Для Каждого Документ Из Данные.Документы Цикл
		Если ЗначениеЗаполнено(Документ) Тогда
			Версии.Вставить(Документ, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ВерсияДанных"));
		КонецЕсли;
	КонецЦикла;
	МенеджерЗаписи = РегистрыСведений.ОперацииКассы.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Пользователь = ПараметрыСеанса.Пользователь;
	МенеджерЗаписи.Идентификатор = Идентификатор;
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Данные, "Отпечаток, КассоваяСмена, ВнесеноНаличными, Сдача, СуммаОплаты");
	МенеджерЗаписи.ДокументЧека = Данные.Документ;
	МенеджерЗаписи.Дата = ТекущаяДатаСеанса();
	МенеджерЗаписи.ДокументыОперации = Новый ХранилищеЗначения(Версии);
	МенеджерЗаписи.Подтверждена = Ложь;
	МенеджерЗаписи.Записать();
КонецПроцедуры

// Новая структура данных операции для ЗарегистрироватьОперацию.
//
// Возвращаемое значение:
//  Структура - Отпечаток, Документ, Документы, КассоваяСмена, ВнесеноНаличными, Сдача, СуммаОплаты.
//
Функция НовыеДанныеОперации() Экспорт
	Данные = Новый Структура("Отпечаток, Документ, КассоваяСмена", "", Неопределено, Неопределено);
	Данные.Вставить("Документы", Новый Массив);
	Данные.Вставить("ВнесеноНаличными", 0);
	Данные.Вставить("Сдача", 0);
	Данные.Вставить("СуммаОплаты", 0);
	Возврат Данные;
КонецФункции

// Выполненная операция текущего пользователя с проверкой сохранности её документов.
//
// Параметры:
//  Идентификатор - Строка - идентификатор попытки.
//
// Возвращаемое значение:
//  Структура, Неопределено - см. ДанныеОперации; Неопределено - операции нет.
//
Функция ВыполненнаяОперация(Идентификатор) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	МенеджерЗаписи = РегистрыСведений.ОперацииКассы.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Пользователь = ПараметрыСеанса.Пользователь;
	МенеджерЗаписи.Идентификатор = Идентификатор;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДанныеОперации(МенеджерЗаписи);
КонецФункции

// Неподтверждённые операции текущего пользователя (список «Незавершённые чеки» и отказ новой оплаты) с проверкой
// сохранности.
//
// Возвращаемое значение:
//  Массив из Структура - см. ДанныеОперации.
//
Функция НеподтвержденныеОперации() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Операции.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ОперацииКассы КАК Операции
	|ГДЕ
	|	Операции.Пользователь = &Пользователь
	|	И НЕ Операции.Подтверждена
	|
	|УПОРЯДОЧИТЬ ПО
	|	Операции.Дата");
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.Пользователь);
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(ВыполненнаяОперация(Выборка.Идентификатор));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Незавершённые чеки при открытии формы кассы: ждёт идущую оплату пользователя (та же блокировка) и возвращает его
// неподтверждённые операции. Ничего не очищает - подтверждает только клиент после показа.
//
// Возвращаемое значение:
//  Массив из Структура - см. ДанныеОперации.
//
Функция НезавершенныеЧеки() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		ЗахватитьОперацииПользователя();
		Результат = НеподтвержденныеОперации();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Подтверждение операции клиентом: результат показан кассиру, чек отправлен на печать (или печать не нужна).
// Запись не удаляется - повтор идентификатора по-прежнему возвращает документ.
//
// Параметры:
//  Идентификатор - Строка - идентификатор попытки.
//
Процедура ПодтвердитьОперацию(Идентификатор) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		ЗахватитьОперацииПользователя();
		МенеджерЗаписи = РегистрыСведений.ОперацииКассы.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Пользователь = ПараметрыСеанса.Пользователь;
		МенеджерЗаписи.Идентификатор = Идентификатор;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Подтверждена = Истина;
			МенеджерЗаписи.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Отпечаток запроса оплаты: хеш SHA-256 сериализованных данных запроса (шапка, строки чека, основание, оплата).
//
// Параметры:
//  Данные - Произвольный - сериализуемое значение (структура таблиц и значений).
//
// Возвращаемое значение:
//  Строка - отпечаток.
//
Функция Отпечаток(Данные) Экспорт
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ЗначениеВСтрокуВнутр(Данные));
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);
КонецФункции

#КонецОбласти

#Область Смена

// Транзакция оплаты кассы и записи продажи кассой: разделяемая блокировка смены и проверка статуса «Открыта».
//
// Параметры:
//  Смена - ДокументСсылка.КассоваяСмена - смена кассы.
//
Процедура ЗаблокироватьОткрытуюСмену(Смена) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если Не ЗначениеЗаполнено(Смена) Тогда
		ВызватьИсключение ТекстСменаНеОткрыта();
	КонецЕсли;
	ЗаблокироватьСмены(ЗначениеВМассиве(Смена), РежимБлокировкиДанных.Разделяемый);
	Если Не СменаОткрыта(Смена) Тогда
		ВызватьИсключение ТекстСменаНеОткрыта();
	КонецЕсли;
КонецПроцедуры

// Документ смены (первая строка ПередЗаписью и ПередУдалением): закрытая смена неизменна, смена проведённого
// документа не меняется (заполнение пустой - только при проведении).
//
// Параметры:
//  ДокОбъект   - ДокументОбъект - документ с реквизитом КассоваяСмена.
//  РежимЗаписи - РежимЗаписиДокумента, Неопределено - режим записи; Неопределено - удаление.
//  Отказ       - Булево - отказ записи.
//
Процедура ПроверитьСменуДокумента(ДокОбъект, РежимЗаписи, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если ДокОбъект.ОбменДанными.Загрузка Или ДокОбъект.ДополнительныеСвойства.Свойство(
		РаботаСДокументами.СвойствоВыполняетсяФоновоеПерепроведение()) Тогда
		Возврат;
	КонецЕсли;
	Новая = ДокОбъект.КассоваяСмена;
	Прежняя = Документы.КассоваяСмена.ПустаяСсылка();
	ПроведенВБазе = Ложь;
	Если Не ДокОбъект.ЭтоНовый() Тогда
		Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОбъект.Ссылка, "КассоваяСмена, Проведен");
		Прежняя = Данные.КассоваяСмена;
		ПроведенВБазе = Данные.Проведен = Истина;
	КонецЕсли;
	Смены = ЗаполненныеСмены(Новая, Прежняя);
	Если Смены.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ЗаблокироватьСмены(Смены, РежимБлокировкиДанных.Разделяемый);
	Тексты = Новый Массив;
	Проведение = РежимЗаписи = РежимЗаписиДокумента.Проведение;
	СменаИзменена = ЗначениеЗаполнено(Прежняя) И Новая <> Прежняя;
	ЗаполнениеБезПроведения = Не ЗначениеЗаполнено(Прежняя) И ЗначениеЗаполнено(Новая) И Не Проведение;
	Если ПроведенВБазе И СменаИзменена Тогда
		Тексты.Добавить(НСтр("ru = 'Кассовая смена проведённого документа не меняется';
			|fr = 'La session de caisse d''un document validé ne se modifie pas';
			|en = 'The cash session of a posted document cannot be changed';
			|es = 'El turno de caja de un documento contabilizado no se cambia'"));
	ИначеЕсли ПроведенВБазе И ЗаполнениеБезПроведения Тогда
		Тексты.Добавить(НСтр("ru = 'Кассовая смена проведённого документа заполняется только при проведении';
			|fr = 'La session de caisse d''un document validé se renseigne uniquement à la validation';
			|en = 'The cash session of a posted document is filled only when posting';
			|es = 'El turno de caja de un documento contabilizado solo se rellena al contabilizar'"));
	Иначе
		// Непроведённый в базе документ (отложенный чек) проводится в новой смене: прежняя закрытая смена - только в
		// наборе блокировок, открытой должна быть новая.
		Проверяемые = ?(ПроведенВБазе, Смены, ЗаполненныеСмены(Новая, Неопределено));
		ПроверитьЗакрытыеСмены(Проверяемые, ПроведенВБазе Или Проведение, Тексты);
	КонецЕсли;
	Для Каждого Текст Из Тексты Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ДокОбъект, "КассоваяСмена", , Отказ);
	КонецЦикла;
КонецПроцедуры

// Кассовая смена, ПередЗаписью: неизменность кассы и даты, одна открытая смена на кассу с монотонной хронологией,
// переоткрытие только последней, закрытие под блокировками с пересчётом сумм, неизменность закрытой.
//
// Параметры:
//  СменаОбъект - ДокументОбъект.КассоваяСмена - смена.
//  Отказ       - Булево - отказ записи.
//
Процедура ПередЗаписьюСмены(СменаОбъект, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если СменаОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Открыта = Перечисления.СтатусыКассовойСмены.Открыта;
	Закрыта = Перечисления.СтатусыКассовойСмены.Закрыта;
	Прежние = Новый Структура("Касса, Дата, Статус");
	Прежние.Вставить("СуммаОткрытия", 0);
	Если Не СменаОбъект.ЭтоНовый() Тогда
		ЗаблокироватьСмены(ЗначениеВМассиве(СменаОбъект.Ссылка), РежимБлокировкиДанных.Исключительный);
		Прежние = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СменаОбъект.Ссылка, "Касса, Дата, Статус, СуммаОткрытия");
	КонецЕсли;
	Тексты = Новый Массив;
	Если Не СменаОбъект.ЭтоНовый() И ШапкаСменыИзменена(СменаОбъект, Прежние) Тогда
		Тексты.Добавить(НСтр("ru = 'Касса, дата и сумма открытия записанной смены не меняются';
			|fr = 'La caisse, la date et le montant d''ouverture d''une session enregistrée ne se modifient pas';
			|en = 'The cash desk, date and opening amount of a saved session cannot be changed';
			|es = 'La caja, la fecha y el importe de apertura de un turno guardado no se cambian'"));
	ИначеЕсли Прежние.Статус = Закрыта И СменаОбъект.Статус = Закрыта Тогда
		Тексты.Добавить(НСтр("ru = 'Закрытая смена не изменяется: откройте её, исправьте документы и закройте снова';
			|fr = 'Une session fermée ne se modifie pas : rouvrez-la, corrigez les documents et refermez-la';
			|en = 'A closed session cannot be changed: reopen it, fix the documents and close it again';
			|es = 'Un turno cerrado no se modifica: vuelva a abrirlo, corrija los documentos y ciérrelo de nuevo'"));
	ИначеЕсли СменаОбъект.Статус = Открыта И Прежние.Статус <> Открыта Тогда
		ПроверитьОткрытиеСмены(СменаОбъект, Тексты);
	ИначеЕсли СменаОбъект.Статус = Закрыта И Прежние.Статус <> Закрыта Тогда
		ЗакрытьСменуПодБлокировками(СменаОбъект);
	Иначе
		Возврат;
	КонецЕсли;
	Для Каждого Текст Из Тексты Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, СменаОбъект, , , Отказ);
	КонецЦикла;
КонецПроцедуры

// Предупреждение перед закрытием смены: проведённые продажи смены с долгом и черновики «в ожидании».
//
// Параметры:
//  Смена - ДокументСсылка.КассоваяСмена - смена.
//
// Возвращаемое значение:
//  Строка - текст предупреждения; пустая - предупреждать не о чем.
//
Функция ПредупреждениеЗакрытияСмены(Смена) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Долги.ОбъектРасчётов) КАК Количество
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(
	|			,
	|			ОбъектРасчётов В
	|				(ВЫБРАТЬ
	|					Продажи.Ссылка КАК Ссылка
	|				ИЗ
	|					Документ.РеализацияТоваровУслуг КАК Продажи
	|				ГДЕ
	|					Продажи.КассоваяСмена = &Смена
	|					И Продажи.Проведен)) КАК Долги
	|ГДЕ
	|	Долги.СуммаОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Черновики.Ссылка) КАК Количество
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Черновики
	|ГДЕ
	|	Черновики.КассоваяСмена = &Смена
	|	И НЕ Черновики.Проведен
	|	И НЕ Черновики.ПометкаУдаления");
	Запрос.УстановитьПараметр("Смена", Смена);
	Результаты = Запрос.ВыполнитьПакет();
	Долги = Результаты[0].Выгрузить()[0].Количество;
	Черновики = Результаты[1].Выгрузить()[0].Количество;
	Если Долги = 0 И Черновики = 0 Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'В смене продаж с долгом: %1, отложенных чеков: %2. Закрыть смену?';
		|fr = 'Dans la session : ventes avec dette %1, tickets en attente %2. Fermer la session ?';
		|en = 'In the session: sales with debt %1, pending receipts %2. Close the session?';
		|es = 'En el turno: ventas con deuda %1, tickets pendientes %2. ¿Cerrar el turno?'");
	Возврат СтрШаблон(Шаблон, Долги, Черновики);
КонецФункции

// Сумма наличных в кассе: все строки остатков денежных средств кассы с типом «наличные».
//
// Параметры:
//  Касса - СправочникСсылка.Кассы - касса.
//
// Возвращаемое значение:
//  Число - сумма.
//
Функция СуммаВКассе(Касса) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваОрганизаций.Остатки(
	|			,
	|			МестоХранения = &Касса
	|				И ТипДенежныхСредств = ЗНАЧЕНИЕ(Справочник.TypesDePayment.Cash)) КАК Остатки");
	Запрос.УстановитьПараметр("Касса", Касса);
	Возврат Запрос.Выполнить().Выгрузить()[0].Сумма;
КонецФункции

#КонецОбласти

#Область ОтменаИПлатежи

// Реализация, ПередЗаписью (отмена проведения) и ПередУдалением: кассовая продажа с принятыми платежами не
// отменяется - под исключительной блокировкой взаиморасчётов контрагента (пространство проведения документов оплаты).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - продажа.
//  Отказ     - Булево - отказ записи.
//
Процедура ПроверитьОтменуКассовойПродажи(ДокОбъект, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если ДокОбъект.ОбменДанными.Загрузка Или ДокОбъект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОбъект.Ссылка, "КассоваяСмена, Контрагент, Проведен");
	Кассовая = ЗначениеЗаполнено(Данные.КассоваяСмена) Или ЗначениеЗаполнено(ДокОбъект.КассоваяСмена);
	Если Не Кассовая Или Данные.Проведен <> Истина Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.ВзаиморасчётыСПокупателями");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Контрагент", Данные.Контрагент);
	Блокировка.Заблокировать();
	Платеж = ПринятыйПлатеж(ДокОбъект.Ссылка);
	Если Платеж <> Неопределено Тогда
		// Платёж найден в привилегированном режиме: его представление пользователю не показывается (права на
		// документы оплаты у роли может не быть).
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'По продаже принят платёж: оформите возврат вместо отмены продажи';
			|fr = 'Un paiement a été reçu pour la vente : établissez un retour au lieu d''annuler la vente';
			|en = 'A payment was received for the sale: issue a return instead of cancelling the sale';
			|es = 'Se recibió un pago por la venta: emita una devolución en lugar de anular la venta'"), ДокОбъект, , , Отказ);
	КонецЕсли;
КонецПроцедуры

// Платёж по кассовой продаже (после блокировки оснований платежа): отменённая кассовая продажа не оплачивается.
//
// Параметры:
//  Основания - Массив из ДокументСсылка - основания платежа (уже заблокированы).
//
Процедура ПроверитьКассовыеОснованияПлатежа(Основания) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Продажи = Новый Массив;
	Для Каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И ЗначениеЗаполнено(Основание) Тогда
			Продажи.Добавить(Основание);
		КонецЕсли;
	КонецЦикла;
	Если Продажи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Продажи.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Продажи
	|ГДЕ
	|	Продажи.Ссылка В (&Продажи)
	|	И Продажи.КассоваяСмена <> ЗНАЧЕНИЕ(Документ.КассоваяСмена.ПустаяСсылка)
	|	И НЕ Продажи.Проведен");
	Запрос.УстановитьПараметр("Продажи", Продажи);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Шаблон = НСтр("ru = 'Продажа %1 отменена: оплата по ней не принимается';
			|fr = 'La vente %1 est annulée : aucun paiement n''est accepté';
			|en = 'Sale %1 is cancelled: no payment is accepted for it';
			|es = 'La venta %1 está anulada: no se acepta su pago'");
		ВызватьИсключение СтрШаблон(Шаблон, Выборка.Ссылка);
	КонецЕсли;
КонецПроцедуры

// Полнота оплаты новой кассовой продажи: остаток долга по продаже (все строки остатков) не больше суммы в кредит.
//
// Параметры:
//  Продажа      - ДокументСсылка.РеализацияТоваровУслуг - продажа.
//  СуммаКредита - Число - сумма строк оплаты «в кредит».
//
// Возвращаемое значение:
//  Булево - Истина, если продажа оплачена полностью (с учётом кредита).
//
Функция ОплатаПолная(Продажа, СуммаКредита) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Долг
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, ОбъектРасчётов = &Продажа) КАК Остатки");
	Запрос.УстановитьПараметр("Продажа", Продажа);
	Возврат Запрос.Выполнить().Выгрузить()[0].Долг <= СуммаКредита;
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяРегистра()
	Возврат "РегистрСведений.ОперацииКассы";
КонецФункции

Функция ЗначениеВМассиве(Значение)
	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;
КонецФункции

Функция ЗаполненныеСмены(Новая, Прежняя)
	Смены = Новый Массив;
	Если ЗначениеЗаполнено(Новая) Тогда
		Смены.Добавить(Новая);
	КонецЕсли;
	Если ЗначениеЗаполнено(Прежняя) И Прежняя <> Новая Тогда
		Смены.Добавить(Прежняя);
	КонецЕсли;
	Возврат Смены;
КонецФункции

// Данные записи операции с проверкой сохранности: каждый документ операции проведён и его версия не изменилась.
//
// Параметры:
//  Запись - РегистрСведенийМенеджерЗаписи.ОперацииКассы - запись.
//
// Возвращаемое значение:
//  Структура - Идентификатор, Документ, Отпечаток, Дата, ВнесеноНаличными, Сдача, СуммаОплаты, Проблема (пустая -
//              операция сохранна).
//
Функция ДанныеОперации(Запись)
	Результат = Новый Структура("Идентификатор, Документ, Отпечаток, Дата");
	ЗаполнитьЗначенияСвойств(Результат, Запись);
	Результат.Документ = Запись.ДокументЧека;
	Результат.Вставить("ВнесеноНаличными", Запись.ВнесеноНаличными);
	Результат.Вставить("Сдача", Запись.Сдача);
	Результат.Вставить("СуммаОплаты", Запись.СуммаОплаты);
	Результат.Вставить("Проблема", ПроблемаСохранности(Запись.ДокументыОперации.Получить()));
	Возврат Результат;
КонецФункции

Функция ПроблемаСохранности(Версии)
	Если ТипЗнч(Версии) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'Документы операции изменены после записи: %1 - проверьте';
		|fr = 'Les documents de l''opération ont été modifiés après l''enregistrement : %1 - vérifiez';
		|en = 'The operation documents were changed after recording: %1 - check them';
		|es = 'Los documentos de la operación cambiaron tras el registro: %1 - revíselos'");
	Для Каждого КлючИЗначение Из Версии Цикл
		Документ = КлючИЗначение.Ключ;
		Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "ВерсияДанных, Проведен");
		Если Данные.ВерсияДанных <> КлючИЗначение.Значение Или Данные.Проведен <> Истина Тогда
			Возврат СтрШаблон(Шаблон, Документ);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Процедура ЗаблокироватьСмены(Смены, Режим)
	Список = Новый СписокЗначений;
	Для Каждого Смена Из Смены Цикл
		Список.Добавить(Смена, Строка(Смена.УникальныйИдентификатор()));
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Элемент Из Список Цикл
		ЭлементБлокировки = Блокировка.Добавить("Документ.КассоваяСмена");
		ЭлементБлокировки.Режим = Режим;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Элемент.Значение);
	КонецЦикла;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ШапкаСменыИзменена(СменаОбъект, Прежние)
	Возврат Прежние.Касса <> СменаОбъект.Касса Или Прежние.Дата <> СменаОбъект.Дата
		Или Прежние.СуммаОткрытия <> СменаОбъект.СуммаОткрытия;
КонецФункции

Функция СменаОткрыта(Смена)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Смена, "Статус") = Перечисления.СтатусыКассовойСмены.Открыта;
КонецФункции

Процедура ПроверитьЗакрытыеСмены(Смены, Проверять, Тексты)
	Если Не Проверять Тогда
		// Непроведённый черновик из закрытой смены переносится в текущую открытую смену.
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Кассовая смена %1 закрыта: документ не изменяется';
		|fr = 'La session de caisse %1 est fermée : le document ne se modifie pas';
		|en = 'Cash session %1 is closed: the document cannot be changed';
		|es = 'El turno de caja %1 está cerrado: el documento no se modifica'");
	Для Каждого Смена Из Смены Цикл
		Если Не СменаОткрыта(Смена) Тогда
			Тексты.Добавить(СтрШаблон(Шаблон, Смена));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Открытие или переоткрытие смены: под исключительной блокировкой кассы - нет другой открытой смены, новая смена -
// позже последней (по моменту времени), переоткрывается только последняя; сумма открытия - только у новой.
//
// Параметры:
//  СменаОбъект - ДокументОбъект.КассоваяСмена - смена.
//  Тексты      - Массив из Строка - дополняется.
//
Процедура ПроверитьОткрытиеСмены(СменаОбъект, Тексты)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник.Кассы");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", СменаОбъект.Касса);
	Блокировка.Заблокировать();
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Смены.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КассоваяСмена КАК Смены
	|ГДЕ
	|	Смены.Касса = &Касса
	|	И Смены.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
	|	И Смены.Ссылка <> &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Смены.Ссылка КАК Ссылка,
	|	Смены.Дата КАК Дата
	|ИЗ
	|	Документ.КассоваяСмена КАК Смены
	|ГДЕ
	|	Смены.Касса = &Касса
	|	И Смены.Ссылка <> &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Смены.МоментВремени УБЫВ");
	Запрос.УстановитьПараметр("Касса", СменаОбъект.Касса);
	Запрос.УстановитьПараметр("Ссылка", СменаОбъект.Ссылка);
	Результаты = Запрос.ВыполнитьПакет();
	Если Не Результаты[0].Пустой() Тогда
		Тексты.Добавить(НСтр("ru = 'У кассы уже есть открытая смена';
			|fr = 'La caisse a déjà une session ouverte';
			|en = 'The cash desk already has an open session';
			|es = 'La caja ya tiene un turno abierto'"));
		Возврат;
	КонецЕсли;
	Последняя = Результаты[1].Выгрузить();
	Если СменаОбъект.ЭтоНовый() Тогда
		Если Последняя.Количество() > 0 И СменаОбъект.Дата <= Последняя[0].Дата Тогда
			СменаОбъект.Дата = Последняя[0].Дата + 1;
		КонецЕсли;
		// Сумма открытия - под разделяемой блокировкой денег кассы (порядок: касса -> деньги, как при закрытии).
		БлокировкаДенег = Новый БлокировкаДанных;
		ЭлементДенег = БлокировкаДенег.Добавить("РегистрНакопления.ДенежныеСредстваОрганизаций");
		ЭлементДенег.Режим = РежимБлокировкиДанных.Разделяемый;
		ЭлементДенег.УстановитьЗначение("МестоХранения", СменаОбъект.Касса);
		БлокировкаДенег.Заблокировать();
		СменаОбъект.СуммаОткрытия = СуммаВКассе(СменаОбъект.Касса);
	ИначеЕсли Последняя.Количество() > 0 И Последняя[0].Дата >= СменаОбъект.Дата Тогда
		Тексты.Добавить(НСтр("ru = 'Переоткрыть можно только последнюю смену кассы';
			|fr = 'Seule la dernière session de la caisse peut être rouverte';
			|en = 'Only the last session of the cash desk can be reopened';
			|es = 'Solo se puede reabrir el último turno de la caja'"));
	Иначе
		// Переоткрытие последней: исторический начальный остаток не меняется.
		Возврат;
	КонецЕсли;
КонецПроцедуры

// Закрытие смены: смена уже заблокирована исключительно; затем взаиморасчёты продаж смены и деньги кассы
// (разделяемо, порядок проведения ПКО), под ними - сумма закрытия.
//
// Параметры:
//  СменаОбъект - ДокументОбъект.КассоваяСмена - смена.
//
Процедура ЗакрытьСменуПодБлокировками(СменаОбъект)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Продажи.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Продажи
	|ГДЕ
	|	Продажи.КассоваяСмена = &Смена");
	Запрос.УстановитьПараметр("Смена", СменаОбъект.Ссылка);
	Продажи = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Блокировка = Новый БлокировкаДанных;
	Если Продажи.Количество() > 0 Тогда
		Элемент = Блокировка.Добавить("РегистрНакопления.ВзаиморасчётыСПокупателями");
		Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
		Элемент.ИсточникДанных = ТаблицаПродаж(Продажи);
		Элемент.ИспользоватьИзИсточникаДанных("ОбъектРасчётов", "ОбъектРасчётов");
	КонецЕсли;
	Элемент = Блокировка.Добавить("РегистрНакопления.ДенежныеСредстваОрганизаций");
	Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Элемент.УстановитьЗначение("МестоХранения", СменаОбъект.Касса);
	Блокировка.Заблокировать();
	СменаОбъект.СуммаЗакрытия = СуммаВКассе(СменаОбъект.Касса);
КонецПроцедуры

Функция ТаблицаПродаж(Продажи)
	Таблица = Новый ТаблицаЗначений;
	// BSLLS:YoLetterUsage-off - имя измерения регистра в метаданных пишется через «ё».
	Таблица.Колонки.Добавить("ОбъектРасчётов");
	Для Каждого Продажа Из Продажи Цикл
		Таблица.Добавить().ОбъектРасчётов = Продажа;
	КонецЦикла;
	// BSLLS:YoLetterUsage-on
	Возврат Таблица;
КонецФункции

// Принятый платёж по продаже - по движениям взаиморасчётов от документов оплаты и по табличным основаниям проведённых
// документов оплаты.
//
// Параметры:
//  Продажа - ДокументСсылка.РеализацияТоваровУслуг - продажа.
//
// Возвращаемое значение:
//  ДокументСсылка, Неопределено - платёж; Неопределено - платежей нет.
//
Функция ПринятыйПлатеж(Продажа)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Движения.Регистратор КАК Платеж
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Движения
	|ГДЕ
	|	Движения.ОбъектРасчётов = &Продажа
	|	И Движения.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Движения.Регистратор
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Движения
	|ГДЕ
	|	Движения.ОбъектРасчётов = &Продажа
	|	И Движения.Регистратор ССЫЛКА Документ.ПоступлениеБезналичныхДенежныхСредств
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Движения.Регистратор
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Движения
	|ГДЕ
	|	Движения.ОбъектРасчётов = &Продажа
	|	И Движения.Регистратор ССЫЛКА Документ.СертификатНаОплату
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Платежи.Ссылка
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер.ТЧОснования КАК Основания
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходныйКассовыйОрдер КАК Платежи
	|		ПО Основания.Ссылка = Платежи.Ссылка
	|ГДЕ
	|	Основания.Основание = &Продажа
	|	И Платежи.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Платежи.Ссылка
	|ИЗ
	|	Документ.ПоступлениеБезналичныхДенежныхСредств.ТЧОснования КАК Основания
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеБезналичныхДенежныхСредств КАК Платежи
	|		ПО Основания.Ссылка = Платежи.Ссылка
	|ГДЕ
	|	Основания.Основание = &Продажа
	|	И Платежи.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сертификаты.Ссылка
	|ИЗ
	|	Документ.СертификатНаОплату КАК Сертификаты
	|ГДЕ
	|	Сертификаты.Реализация = &Продажа
	|	И Сертификаты.Проведен");
	Запрос.УстановитьПараметр("Продажа", Продажа);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Платеж, Неопределено);
КонецФункции

