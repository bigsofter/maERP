
#Область Нумерация

Процедура ПередЗаписьюДокументаСНумерациейПоОрганизацииПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если Источник.ДополнительныеСвойства.Свойство(РаботаСДокументами.СвойствоЗаписьИзФормы()) и Источник.ДополнительныеСвойства[РаботаСДокументами.СвойствоЗаписьИзФормы()] Тогда
		Префикс = СформироватьПрефикс(Источник);
		Если ВРег(Лев(Источник.Номер, СтрДлина(Префикс))) = ВРег(Префикс) Тогда Возврат КонецЕсли;
		Источник.Номер = "";
	КонецЕсли;
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(Источник, СтандартнаяОбработка, Префикс) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Префикс = СформироватьПрефикс(Источник);
КонецПроцедуры

Функция СформироватьПрефикс(ДокОбъект)
	Результат = ДокОбъект.Организация.Префикс;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ПрефиксКонтрагента = ДокОбъект.Контрагент.Префикс;
		Если Не ПустаяСтрока(ПрефиксКонтрагента) Тогда
			Результат = СокрЛП(ПрефиксКонтрагента);	
			Если ДокОбъект.Контрагент.ДобавлятьКПрефиксуМесяцОтгрузки Тогда
				Результат = Результат + Формат(ДокОбъект.Дата, "ДФ=ММ");	
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.НалоговаяНакладнаяПокупка") Тогда
		Результат = "AC";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Результат) Тогда 
		Результат = "0";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ПослеПроведенияДокументаОплаты(Источник, Отказ, РежимПроведения) Экспорт
	// Запись в режиме загрузки переносит данные (обработчики обновления, групповое изменение
	// реквизитов) и не перепроводит связанные налоговые накладные: иначе исторические накладные
	// молча переехали бы на новую модель расчетов.
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Налоговые документы на основаниях - по текущим и прежним основаниям, в транзакции платежа, без перехвата ошибки и
	// при фоновом перепроведении тоже: оно не обновляет зависимые документы (docs/plans/accounting-morocco-f1-s2.md).
	НалоговыеДокументыНаОснованиях.ПерепровестиПоПлатежу(Источник);
	Если Источник.ДополнительныеСвойства.Свойство(РаботаСДокументами.СвойствоВыполняетсяФоновоеПерепроведение()) Тогда 
		Возврат;
	КонецЕсли;
	ПерепровестиНалоговыеНакладныеПоОплате(Источник);
КонецПроцедуры

Процедура ПослеОтменыПроведенияДокументаОплаты(Источник, Отказ) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Движения отменяемого платежа в момент подписки ещё в базе - документ на основаниях их исключает; при фоновом
	// перепроведении тоже (docs/plans/accounting-morocco-f1-s2.md).
	НалоговыеДокументыНаОснованиях.ПерепровестиПоПлатежу(Источник, Истина);
	Если Источник.ДополнительныеСвойства.Свойство(РаботаСДокументами.СвойствоВыполняетсяФоновоеПерепроведение()) Тогда 
		Возврат;
	КонецЕсли;
	Если Источник.Проведен Тогда Возврат; КонецЕсли;
	ПерепровестиНалоговыеНакладныеПоОплате(Источник);
КонецПроцедуры

// Перед удалением платежа: проведённый платёж, чьи оплаты перенёс налоговый документ на основаниях, удаляется только
// после отмены проведения - прямое удаление снимает движения без перепроведения документа
// (docs/plans/accounting-morocco-f1-s2.md).
//
// Параметры:
//  Источник - ДокументОбъект - ПКО, РКО, безналичные поступление или списание.
//  Отказ    - Булево - признак отказа от удаления.
//
Процедура ПлатежПередУдалением(Источник, Отказ) Экспорт
	Если Отказ Или Источник.ОбменДанными.Загрузка Или Не Источник.Проведен Тогда
		Возврат;
	КонецЕсли;
	НалоговыеДокументыНаОснованиях.ПроверитьУдалениеПлатежа(Источник, Отказ);
КонецПроцедуры

// Перед записью платежа: прежние основания ТЧОснования и блокировка полного набора оснований налоговых документов на
// основаниях - до блокировки взаиморасчётов платежом (docs/plans/accounting-morocco-f1-s2.md, «Порядок блокировок»).
//
// Параметры:
//  Источник        - ДокументОбъект - ПКО, РКО, безналичные поступление или списание.
//  Отказ           - Булево - признак отказа от записи.
//  РежимЗаписи     - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПрежниеОснованияОплатыПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	НалоговыеДокументыНаОснованиях.ПередЗаписьюПлатежа(Источник);
	// Отменённая кассовая продажа не оплачивается (docs/plans/retail-cash-unfinished.md, п. 4): основания уже
	// заблокированы выше.
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		НезавершенныеПродажиКассы.ПроверитьКассовыеОснованияПлатежа(Источник.ТЧОснования.ВыгрузитьКолонку("Основание"));
	КонецЕсли;
КонецПроцедуры

// Перепроводит налоговые накладные, покрывающие основания платежного документа: их движения
// строятся по снимку оплат на момент проведения, поэтому новая или отмененная оплата обязана
// этот снимок обновить.
//
// Накладные ищутся по строкам табличных частей, а не по реквизиту Основание: накладная может
// собирать несколько отгрузок, и оплаченная - не обязательно та, что указана в ее шапке.
//
// Параметры:
//  Источник - ДокументОбъект - платежный документ, по основаниям которого ищутся накладные.
//
Процедура ПерепровестиНалоговыеНакладныеПоОплате(Источник)
	МассивОснований = Новый Массив;
	Для Каждого Стр Из Источник.ТЧОснования Цикл
		Если ЗначениеЗаполнено(Стр.Основание) Тогда
			МассивОснований.Добавить(Стр.Основание);
		КонецЕсли;
	КонецЦикла;
	Если МассивОснований.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Накладные = РаботаСДокументами.НалоговыеНакладныеПоОснованиям(МассивОснований);
	Для Каждого Накладная Из Накладные Цикл
		НакладнаяОбъект = Накладная.ПолучитьОбъект();
		Попытка
			НакладнаяОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			// Тихий отказ здесь означает неверный долг: накладная осталась со старым снимком оплат.
			ТекстОшибки = НСтр("ru = 'Налоговая накладная.Перепроведение по оплате'; fr = 'Facture fiscale.Revalidation au paiement';
				|en = 'Tax invoice.Reposting on payment'; es = 'Factura fiscal.Revalidación por el pago'");
			ЗаписьЖурналаРегистрации(ТекстОшибки,
				УровеньЖурналаРегистрации.Ошибка, Накладная.Метаданные(), Накладная,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

//++ Аботуров Е.В. 05.11.2025 1C-1601
Процедура ПользователиПередЗаписью(Источник, Отказ) Экспорт
	
	Если Отказ Или Источник.ОбменДанными.Загрузка Или Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	СтароеНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "Наименование");
	НовоеНаименование = Источник.Наименование;
	
	Если СтароеНаименование <> НовоеНаименование Тогда
		Пользователи.ПеренестиНастройкиПользователя(СтароеНаименование, НовоеНаименование);
	КонецЕсли;
	
КонецПроцедуры //-- Аботуров Е.В. 05.11.2025

// Гасит использованное разрешение на редактирование документа в закрытом периоде
// (см. РаботаСДокументами.МожноРедактироватьДокумент - признак ставится там).
//
// Параметры:
//  Источник - ДокументОбъект - записываемый документ.
//  Отказ - Булево - признак отказа от записи.
//
Процедура ПослеЗаписиСнятиеРазрешенияНаРедактирование(Источник, Отказ) Экспорт
	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Не Источник.ДополнительныеСвойства.Свойство("ИспользованоРазрешениеНаРедактирование") Тогда
		Возврат;
	КонецЕсли;
	РегистрыСведений.РазрешениеНаРедактированиеДокументов.ПогаситьРазрешение(Источник.Ссылка);
КонецПроцедуры

// Прежние позиции склада документа с автоудалением движений - до записи, пока движения в базе (см.
// РегистрыНакопления.ТоварыВНаличии.ЗапомнитьПозицииПередПерепроведением).
//
// Параметры:
//  Источник        - ДокументОбъект - записываемый документ.
//  Отказ           - Булево - признак отказа от записи.
//  РежимЗаписи     - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПрежниеПозицииСкладаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	РегистрыНакопления.ТоварыВНаличии.ЗапомнитьПозицииПередПерепроведением(Источник, РежимЗаписи);
КонецПроцедуры

#КонецОбласти

