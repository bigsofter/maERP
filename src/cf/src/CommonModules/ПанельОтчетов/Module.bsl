// Консоль отчётов в «Главном»: каталог отчётов и вариантов, доступность отчёта пользователю,
// формирование снимков-образов для панели избранного. План - docs/plans/reports-console.md.
//
// Модуль не привилегированный: отчёты формируются с правами пользователя. Хранение избранного -
// в привилегированном ИзбранныеОтчетыПолныеПрава.

#Область ПрограммныйИнтерфейс

// Проверяет, что отчёт есть в конфигурации, пользователю дано право «Просмотр» на него и отчёт
// не скрыт функциональными опциями.
//
// Параметры:
//  ПолноеИмяОтчета - Строка - полное имя объекта метаданных: Отчет.Имя.
//  ПользовательИБ - ПользовательИнформационнойБазы, Неопределено - чьи права проверять; в
//    привилегированном режиме передаётся явно, иначе проверяется текущий пользователь.
//
// Возвращаемое значение:
//  Булево - отчёт доступен.
//
Функция ОтчетДоступен(ПолноеИмяОтчета, ПользовательИБ = Неопределено) Экспорт

	МетаОтчета = МетаданныеОтчета(ПолноеИмяОтчета);
	Если МетаОтчета = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ПользовательИБ = Неопределено Тогда
		ЕстьПраво = ПравоДоступа("Просмотр", МетаОтчета);
	Иначе
		ЕстьПраво = ПравоДоступа("Просмотр", МетаОтчета, ПользовательИБ);
	КонецЕсли;

	Возврат ЕстьПраво И ДоступенПоФункциональнымОпциям(МетаОтчета, ВключенныеОбъектыОпций());

КонецФункции

// Признак отчёта, чей результат собирает общая форма ФормаОтчёта: только у таких строится
// образ и сохраняются варианты в избранном. Отчёты со своими формами - ярлык отчёта целиком.
//
// Параметры:
//  ПолноеИмяОтчета - Строка - Отчет.Имя.
//
// Возвращаемое значение:
//  Булево - отчёт открывается общей формой отчёта.
//
Функция ОтчетНаОбщейФорме(ПолноеИмяОтчета) Экспорт

	МетаОтчета = МетаданныеОтчета(ПолноеИмяОтчета);
	// BSLLS:YoLetterUsage-off - имя общей формы в метаданных пишется через «ё».
	ОбщаяФорма = Метаданные.ОбщиеФормы.ФормаОтчёта;
	// BSLLS:YoLetterUsage-on
	Возврат МетаОтчета <> Неопределено
		И МетаОтчета.ОсновнаяФорма = ОбщаяФорма
		И МетаОтчета.ОсновнаяСхемаКомпоновкиДанных <> Неопределено;

КонецФункции

// Отпечаток прав текущего пользователя: хеш SHA-256 отсортированных имён его ролей и версии
// конфигурации. Права на данные в maERP задаются только ролями, поэтому совпадение отпечатка
// значит, что снимок построен с теми же правами.
//
// Возвращаемое значение:
//  Строка - 64 шестнадцатеричных символа.
//
Функция ОтпечатокПрав() Экспорт

	Роли = Новый Массив;
	Для Каждого Роль Из ПользователиИнформационнойБазы.ТекущийПользователь().Роли Цикл
		Роли.Добавить(Роль.Имя);
	КонецЦикла;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Роли);
	Список.СортироватьПоЗначению();

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(СтрСоединить(Список.ВыгрузитьЗначения(), ",") + "|" + Метаданные.Версия);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

// Каталог доступных пользователю отчётов и их вариантов для формы «Все отчёты».
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * Раздел - Строка - представление раздела (подсистемы верхнего уровня).
//   * ПорядокРаздела - Число - порядок раздела в командном интерфейсе.
//   * ПолноеИмяОтчета - Строка - Отчет.Имя.
//   * ПредставлениеОтчета - Строка - синоним отчёта.
//   * Описание - Строка - пояснение отчёта.
//   * КлючВарианта - Строка - пусто у строки самого отчёта.
//   * ПредставлениеВарианта - Строка - представление варианта.
//   * Свой - Булево - пользовательский вариант текущего пользователя.
//   * Ярлык - Булево - отчёт со своей формой: варианты не показываются.
//
Функция КаталогОтчетов() Экспорт

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	Каталог = Новый ТаблицаЗначений;
	Каталог.Колонки.Добавить("Раздел", ТипСтрока);
	Каталог.Колонки.Добавить("ПорядокРаздела", Новый ОписаниеТипов("Число"));
	Каталог.Колонки.Добавить("ПолноеИмяОтчета", ТипСтрока);
	Каталог.Колонки.Добавить("ПредставлениеОтчета", ТипСтрока);
	Каталог.Колонки.Добавить("Описание", ТипСтрока);
	Каталог.Колонки.Добавить("КлючВарианта", ТипСтрока);
	Каталог.Колонки.Добавить("ПредставлениеВарианта", ТипСтрока);
	Каталог.Колонки.Добавить("Свой", ТипБулево);
	Каталог.Колонки.Добавить("Ярлык", ТипБулево);

	ВключенныеОбъекты = ВключенныеОбъектыОпций();
	Разделы = РазделыКомандногоИнтерфейса(ВключенныеОбъекты);

	Для Каждого МетаОтчета Из Метаданные.Отчеты Цикл
		Если ПравоДоступа("Просмотр", МетаОтчета) И ДоступенПоФункциональнымОпциям(МетаОтчета, ВключенныеОбъекты) Тогда
			ДобавитьОтчетВКаталог(Каталог, МетаОтчета, Разделы);
		КонецЕсли;
	КонецЦикла;

	Каталог.Сортировать("ПорядокРаздела, Раздел, ПредставлениеОтчета, Свой, ПредставлениеВарианта");
	Возврат Каталог;

КонецФункции

// Процедура фонового задания: формирует снимки-образы избранных отчётов текущего пользователя.
// Сигнатура - по контракту ДлительныеОперации.ВыполнитьВФоне.
//
// Параметры:
//  Параметры - Структура:
//   * Идентификаторы - Массив из Строка - идентификаторы избранного.
//  АдресРезультата - Строка - адрес временного хранилища; туда помещается массив
//    идентификаторов, по которым записан снимок.
//
Процедура СформироватьСнимки(Параметры, АдресРезультата) Экспорт

	Обновленные = Новый Массив;
	Для Каждого Идентификатор Из Параметры.Идентификаторы Цикл
		Если СформироватьСнимок(Идентификатор) Тогда
			Обновленные.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	ПоместитьВоВременноеХранилище(Обновленные, АдресРезультата);

КонецПроцедуры

// Формирует и записывает снимок одного избранного отчёта текущего пользователя.
//
// Параметры:
//  Идентификатор - Строка - идентификатор избранного.
//
// Возвращаемое значение:
//  Булево - снимок записан (запись найдена и не обогнана более поздним формированием).
//
Функция СформироватьСнимок(Идентификатор) Экспорт

	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	// BSLLS:PrivilegedModuleMethodCall-off - хранение избранного только своего пользователя ИБ.
	Данные = ИзбранныеОтчетыПолныеПрава.ДанныеИзбранного(Идентификатор);
	// BSLLS:PrivilegedModuleMethodCall-on
	Если Данные = Неопределено Или Данные.Ярлык Тогда
		Возврат Ложь;
	КонецЕсли;

	Снимок = "";
	Ошибка = "";
	Если Не ОтчетДоступен(Данные.ПолноеИмяОтчета) Тогда
		Ошибка = НСтр("ru = 'Нет доступа к отчёту'; fr = 'Pas d''accès au rapport'; en = 'No access to the report';
			|es = 'Sin acceso al informe'");
	Иначе
		Попытка
			Снимок = ПостроитьСнимок(Данные);
		Исключение
			Информация = ИнформацияОбОшибке();
			Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация);
			ИмяСобытия = НСтр("ru = 'Консоль отчётов.Снимок'", ОбщегоНазначения.КодОсновногоЯзыка());
			Подробно = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Данные.ПолноеИмяОтчета, Подробно);
		КонецПопытки;
	КонецЕсли;

	// BSLLS:PrivilegedModuleMethodCall-off - запись снимка своей записи избранного.
	Возврат ИзбранныеОтчетыПолныеПрава.ЗаписатьСнимок(Идентификатор, Снимок, Ошибка, МоментНачала);
	// BSLLS:PrivilegedModuleMethodCall-on

КонецФункции

// Оборачивает HTML снимка для показа на плитке: уменьшение, без полос прокрутки, курсор-рука.
//
// Параметры:
//  Снимок - Строка - HTML снимка; пусто - показывается Сообщение.
//  Сообщение - Строка - текст вместо образа.
//
// Возвращаемое значение:
//  Строка - HTML для поля HTML-документа.
//
Функция HTMLПлитки(Снимок, Сообщение = "") Экспорт

	Стиль = "<style>html{zoom:0.6}body{overflow:hidden;cursor:pointer;margin:4px}"
		+ "a{pointer-events:none}.msg{font:14px sans-serif;color:#777;padding:12px}</style>";

	ТекстHTML = ?(ПустаяСтрока(Снимок), HTMLСообщения(Сообщение), Снимок);
	Позиция = СтрНайти(НРег(ТекстHTML), "</head>");
	Если Позиция = 0 Тогда
		Возврат Стиль + ТекстHTML;
	КонецЕсли;
	Возврат Лев(ТекстHTML, Позиция - 1) + Стиль + Сред(ТекстHTML, Позиция);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьОтчетВКаталог(Каталог, МетаОтчета, Разделы)

	ПолноеИмя = МетаОтчета.ПолноеИмя();
	Ярлык = Не ОтчетНаОбщейФорме(ПолноеИмя);
	Варианты = ?(Ярлык, Новый Массив, ВариантыОтчета(МетаОтчета));

	Для Каждого Раздел Из РазделыОтчета(МетаОтчета, Разделы) Цикл
		Строка = Каталог.Добавить();
		Строка.Раздел = Раздел.Представление;
		Строка.ПорядокРаздела = Раздел.Порядок;
		Строка.ПолноеИмяОтчета = ПолноеИмя;
		Строка.ПредставлениеОтчета = МетаОтчета.Представление();
		Строка.Описание = МетаОтчета.Пояснение;
		Строка.Ярлык = Ярлык;
		Для Каждого Вариант Из Варианты Цикл
			СтрокаВарианта = Каталог.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВарианта, Строка);
			ЗаполнитьЗначенияСвойств(СтрокаВарианта, Вариант);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция РазделыОтчета(МетаОтчета, Разделы)

	Результат = Новый Массив;
	Для Каждого Раздел Из Разделы Цикл
		Если ВходитВПодсистему(МетаОтчета, Раздел.Подсистема) Тогда
			Результат.Добавить(Раздел);
		КонецЕсли;
	КонецЦикла;
	Если Результат.Количество() = 0 Тогда
		Прочие = Новый Структура("Представление, Порядок");
		Прочие.Представление = НСтр("ru = 'Прочие'; fr = 'Autres'; en = 'Other'; es = 'Otros'");
		Прочие.Порядок = Разделы.Количество() + 1;
		Результат.Добавить(Прочие);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция МетаданныеОтчета(ПолноеИмяОтчета)

	Если ПустаяСтрока(ПолноеИмяОтчета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	МетаОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОтчета);
	Если МетаОбъекта = Неопределено Или Не Метаданные.Отчеты.Содержит(МетаОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат МетаОбъекта;

КонецФункции

// Объекты метаданных, входящие в функциональные опции, и признак «хотя бы одна опция
// объекта включена». Объекта нет в соответствии - опциями он не управляется.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ОбъектМетаданных - объект из состава опций.
//   * Значение - Булево - хотя бы одна опция объекта включена.
//
Функция ВключенныеОбъектыОпций()

	Результат = Новый Соответствие;
	Для Каждого Опция Из Метаданные.ФункциональныеОпции Цикл
		Попытка
			Включена = ПолучитьФункциональнуюОпцию(Опция.Имя) = Истина;
		Исключение
			// Опция с параметрами без установленных параметров сеанса - объект не скрываем.
			Включена = Истина;
		КонецПопытки;
		Для Каждого ЭлементСостава Из Опция.Состав Цикл
			Если ЭлементСостава.Объект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Результат.Вставить(ЭлементСостава.Объект, Результат.Получить(ЭлементСостава.Объект) = Истина Или Включена);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДоступенПоФункциональнымОпциям(МетаОбъекта, ВключенныеОбъекты)

	Признак = ВключенныеОбъекты.Получить(МетаОбъекта);
	Возврат Признак = Неопределено Или Признак;

КонецФункции

Функция РазделыКомандногоИнтерфейса(ВключенныеОбъекты)

	Разделы = Новый Массив;
	Порядок = 0;
	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
		Порядок = Порядок + 1;
		Если Не Подсистема.ВключатьВКомандныйИнтерфейс
			Или Не ПравоДоступа("Просмотр", Подсистема)
			Или Не ДоступенПоФункциональнымОпциям(Подсистема, ВключенныеОбъекты) Тогда
			Продолжить;
		КонецЕсли;
		Раздел = Новый Структура("Подсистема, Представление, Порядок", Подсистема, "", Порядок);
		Раздел.Представление = Подсистема.Представление();
		Разделы.Добавить(Раздел);
	КонецЦикла;
	Возврат Разделы;

КонецФункции

Функция ВходитВПодсистему(МетаОбъекта, Подсистема)

	Если Подсистема.Состав.Содержит(МетаОбъекта) Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Вложенная Из Подсистема.Подсистемы Цикл
		Если ВходитВПодсистему(МетаОбъекта, Вложенная) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Предопределённые варианты из основной схемы и пользовательские варианты текущего
// пользователя из стандартного хранилища вариантов.
//
// Параметры:
//  МетаОтчета - ОбъектМетаданныхОтчет - отчёт на общей форме.
//
// Возвращаемое значение:
//  Массив из Структура - КлючВарианта, ПредставлениеВарианта, Свой.
//
Функция ВариантыОтчета(МетаОтчета)

	Варианты = Новый Массив;
	ПолноеИмя = МетаОтчета.ПолноеИмя();

	Схема = Отчеты[МетаОтчета.Имя].ПолучитьМакет(МетаОтчета.ОсновнаяСхемаКомпоновкиДанных.Имя);
	Для Каждого Вариант Из Схема.ВариантыНастроек Цикл
		Представление = ?(ПустаяСтрока(Вариант.Представление), Вариант.Имя, Вариант.Представление);
		Варианты.Добавить(Новый Структура("КлючВарианта, ПредставлениеВарианта, Свой", Вариант.Имя, Представление, Ложь));
	КонецЦикла;

	Для Каждого ЭлементСписка Из ХранилищеВариантовОтчетов.ПолучитьСписок(ПолноеИмя) Цикл
		Представление = ?(ПустаяСтрока(ЭлементСписка.Представление), ЭлементСписка.Значение, ЭлементСписка.Представление);
		Варианты.Добавить(Новый Структура("КлючВарианта, ПредставлениеВарианта, Свой", ЭлементСписка.Значение, Представление, Истина));
	КонецЦикла;

	Возврат Варианты;

КонецФункции

Функция ПостроитьСнимок(Данные)

	МетаОтчета = МетаданныеОтчета(Данные.ПолноеИмяОтчета);
	Отчет = Отчеты[МетаОтчета.Имя].Создать();
	Схема = Отчет.ПолучитьМакет(МетаОтчета.ОсновнаяСхемаКомпоновкиДанных.Имя);
	Источник = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема);
	Отчет.КомпоновщикНастроек.Инициализировать(Источник);
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиДляФормирования(Данные, Схема));
	Если ТипЗнч(Данные.ПользовательскиеНастройки) = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
		Отчет.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(Данные.ПользовательскиеНастройки);
	КонецЕсли;

	Результат = Новый ТабличныйДокумент;
	Отчет.СкомпоноватьРезультат(Результат);
	Если Результат.ВысотаТаблицы = 0 Тогда
		Возврат HTMLСообщения(НСтр("ru = 'Нет данных'; fr = 'Aucune donnée'; en = 'No data'; es = 'Sin datos'"));
	КонецЕсли;

	// Верх результата - удалением строк ниже образа: числовой ПолучитьОбласть на результате компоновки отдаёт документ без
	// содержимого (проверено сценарием КонсольОтчетов, 2.0.16.126).
	Если Результат.ВысотаТаблицы > СтрокСнимка() Тогда
		АдресЛишнего = "R" + Формат(СтрокСнимка() + 1, "ЧГ=0") + ":R" + Формат(Результат.ВысотаТаблицы, "ЧГ=0");
		Лишнее = Результат.Область(АдресЛишнего);
		Результат.УдалитьОбласть(Лишнее, ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	Каталог = ПолучитьИмяВременногоФайла("snap");
	СоздатьКаталог(Каталог);
	Попытка
		ИмяФайла = Каталог + ПолучитьРазделительПути() + "snap.html";
		Результат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML5);
		Текст = Новый ТекстовыйДокумент;
		Текст.Прочитать(ИмяФайла, КодировкаТекста.UTF8);
		Снимок = Текст.ПолучитьТекст();
	Исключение
		УдалитьФайлы(Каталог);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(Каталог);

	Если СтрДлина(Снимок) > ПредельныйРазмерСнимка() Тогда
		Возврат HTMLСообщения(НСтр("ru = 'Образ слишком большой - откройте отчёт';
			|fr = 'Aperçu trop volumineux - ouvrez le rapport'; en = 'Snapshot too large - open the report';
			|es = 'Instantánea demasiado grande - abra el informe'"));
	КонецЕсли;
	Возврат Снимок;

КонецФункции

Функция НастройкиДляФормирования(Данные, Схема)

	Если ТипЗнч(Данные.Настройки) = Тип("НастройкиКомпоновкиДанных") Тогда
		Возврат Данные.Настройки;
	КонецЕсли;

	Если Не ПустаяСтрока(Данные.КлючВарианта) Тогда
		Для Каждого Вариант Из Схема.ВариантыНастроек Цикл
			Если Вариант.Имя = Данные.КлючВарианта Тогда
				Возврат Вариант.Настройки;
			КонецЕсли;
		КонецЦикла;
		Настройки = ХранилищеВариантовОтчетов.Загрузить(Данные.ПолноеИмяОтчета, Данные.КлючВарианта);
		Если ТипЗнч(Настройки) = Тип("НастройкиКомпоновкиДанных") Тогда
			Возврат Настройки;
		КонецЕсли;
		ВызватьИсключение НСтр("ru = 'Вариант отчёта удалён'; fr = 'La variante du rapport a été supprimée';
			|en = 'The report variant was deleted'; es = 'La variante del informe fue eliminada'");
	КонецЕсли;

	Возврат Схема.НастройкиПоУмолчанию;

КонецФункции

Функция HTMLСообщения(Сообщение)

	Возврат "<html><head><meta charset=""utf-8""></head><body><div class=""msg"">"
		+ ЭкранироватьHTML(Сообщение) + "</div></body></html>";

КонецФункции

Функция ЭкранироватьHTML(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Возврат СтрЗаменить(Результат, ">", "&gt;");

КонецФункции

Функция СтрокСнимка()

	// BSLLS:MagicNumber-off - строк результата в образе плитки.
	Возврат 40;
	// BSLLS:MagicNumber-on

КонецФункции

Функция ПредельныйРазмерСнимка()

	// BSLLS:MagicNumber-off - символов HTML снимка; больше - образ не храним.
	Возврат 300000;
	// BSLLS:MagicNumber-on

КонецФункции

#КонецОбласти
