////////////////////////////////////////////////////////////////////////////////
// Клиентская часть механизма обновления: вызывается при начале работы системы.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обновляет данные информационной базы при начале работы системы и открывает
// окно "Что нового", если после последнего показа появились новые версии.
//
// Возвращаемое значение:
//  Булево - Ложь, если работу нужно прекратить: обновление не выполнено
//           или выполняется другим пользователем
//
Функция ОбработатьНачалоРаботы() Экспорт

	Результат = ОбновлениеПрограммыВызовСервера.ОбработатьНачалоРаботы();

	Если Не Результат.ПродолжитьРаботу Тогда
		Оповещение = Новый ОписаниеОповещения("ЗавершитьРаботуПослеПредупреждения", ОбновлениеПрограммыКлиент);
		ПоказатьПредупреждение(Оповещение, Результат.Сообщение);
		Возврат Ложь;
	КонецЕсли;

	Если Результат.ПоказатьОписаниеИзменений Тогда
		Попытка
			ОткрытьФорму("ОбщаяФорма.ЧтоНового");
		Исключение
			// Окно с описанием изменений информационное: его сбой не должен мешать начать работу.
			// Форма открывается вручную из раздела Сервис, ошибка видна там.
			Возврат Истина;
		КонецПопытки;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Обрабатывает технологический запуск headless-первого запуска: открывает форму обработки
// НачальноеЗаполнение и сообщает вызывающему, что обычную инициализацию клиента выполнять
// не нужно. Вызывается после ОбработатьНачалоРаботы(): база к этому моменту обновлена.
//
// Запуск: 1cv8c ENTERPRISE /C "НачальноеЗаполнение;<payload.json>;<result.json>"
// (scripts/initial-fill.sh, контракт - docs/DEPLOY.md).
//
// Возвращаемое значение:
//  Булево - Истина, если это технологический запуск и работа передана обработке
//
Функция ОбработатьЗапускНачальногоЗаполнения() Экспорт

	Если СтрНачинаетсяС(ПараметрЗапуска, "НачальноеЗаполнение;") Тогда
		ОткрытьФорму("Обработка.НачальноеЗаполнение.Форма");
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Обработчик оповещения предупреждения о невозможности работы до обновления.
//
// Параметры:
//  ДополнительныеПараметры - Произвольный - не используется
//
Процедура ЗавершитьРаботуПослеПредупреждения(ДополнительныеПараметры) Экспорт

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

#КонецОбласти
