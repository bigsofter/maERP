////////////////////////////////////////////////////////////////////////////////
// Рабочие места, которые открываются при запуске программы (docs/plans/startup-forms-warehouse-role.md).
//
// Модуль привилегированный и только серверный (с клиента - через ФормыПриЗапускеВызовСервера): флажок «Открывать при запуске» ставит сам
// пользователь, а записи в регистр НастройкиПользователей у ролей нет. Поэтому каждый метод работает только с настройками текущего
// пользователя ИБ: пользователь справочника ищется по идентификатору пользователя ИБ, а не берётся из параметра сеанса Пользователь - его
// часть ролей вправе установить (как в ИзбранныеОтчетыПолныеПрава). Виды настроек и формы - только из белого списка
// РегистрыСведений.НастройкиПользователей.ФормыПриЗапуске.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// BSLLS:PrivilegedModuleMethodCall-off - вызовы собственных служебных методов модуля, а не точка входа.

// Отмечено ли рабочее место к открытию при запуске у текущего пользователя.
//
// Параметры:
//  ИмяОбработки - Строка - имя обработки рабочего места из белого списка.
//
// Возвращаемое значение:
//  Булево - Истина, если отмечено; Ложь - не отмечено, рабочее место вне списка или у сеанса нет карточки пользователя.
//
Функция ОткрыватьПриЗапуске(ИмяОбработки) Экспорт

	Форма = ФормаИзСписка(ИмяОбработки);
	Пользователь = ТекущийПользовательСправочника();
	Если Форма = Неопределено Или Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОтмеченныеНастройки(Пользователь).Найти(Форма.Настройка) <> Неопределено;

КонецФункции

// Ставит или снимает отметку «Открывать при запуске» рабочего места текущему пользователю.
//
// Параметры:
//  ИмяОбработки - Строка - имя обработки рабочего места из белого списка.
//  Открывать    - Булево - отметка.
//
Процедура УстановитьОткрытиеПриЗапуске(ИмяОбработки, Открывать) Экспорт

	Форма = ФормаИзСписка(ИмяОбработки);
	Если Форма = Неопределено Или ТипЗнч(Открывать) <> Тип("Булево") Тогда
		ВызватьИсключение НСтр("ru = 'Это рабочее место нельзя открывать при запуске.';
			|fr = 'Ce poste de travail ne peut pas être ouvert au démarrage.';
			|en = 'This workplace cannot be opened at startup.';
			|es = 'Este puesto de trabajo no se puede abrir al iniciar.'");
	КонецЕсли;
	Пользователь = ТекущийПользовательСправочника();
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		ВызватьИсключение НСтр("ru = 'У текущего пользователя нет карточки - настройку некуда записать.';
			|fr = 'L''utilisateur actuel n''a pas de fiche : le paramètre ne peut pas être enregistré.';
			|en = 'The current user has no user card: the setting cannot be saved.';
			|es = 'El usuario actual no tiene ficha: la configuración no se puede guardar.'");
	КонецЕсли;
	Если Открывать И Не ЕстьПравоНаФорму(Форма) Тогда
		ВызватьИсключение НСтр("ru = 'Нет права открывать это рабочее место.';
			|fr = 'Pas de droit d''ouvrir ce poste de travail.';
			|en = 'No right to open this workplace.';
			|es = 'Sin derecho a abrir este puesto de trabajo.'");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		РегистрыСведений.НастройкиПользователей.ЗаписатьОтметкуФормы(Пользователь, Форма.Настройка, Открывать);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Формы, которые клиент открывает при запуске программы: отмеченные текущим пользователем рабочие места, на которые
// у него есть право (роль отобрали - форма не открывается и ошибки при запуске нет).
//
// Возвращаемое значение:
//  Массив из Строка - полные имена форм в порядке белого списка; пустой - у сеанса нет карточки пользователя.
//
Функция ФормыДляОткрытия() Экспорт

	Результат = Новый Массив;
	Пользователь = ТекущийПользовательСправочника();
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Результат;
	КонецЕсли;
	Отмеченные = ОтмеченныеНастройки(Пользователь);
	Для Каждого Форма Из РегистрыСведений.НастройкиПользователей.ФормыПриЗапуске() Цикл
		Если Отмеченные.Найти(Форма.Настройка) <> Неопределено И ЕстьПравоНаФорму(Форма) Тогда
			Результат.Добавить(Форма.ИмяФормы);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// BSLLS:PrivilegedModuleMethodCall-on

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ФормаИзСписка(ИмяОбработки)

	Если ТипЗнч(ИмяОбработки) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат РегистрыСведений.НастройкиПользователей.ФормыПриЗапуске().Найти(ИмяОбработки, "ИмяОбработки");

КонецФункции

// Карточка пользователя текущего сеанса по идентификатору пользователя ИБ.
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи - пустая ссылка, если карточки нет (вход без пользователей, первый запуск).
//
Функция ТекущийПользовательСправочника()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ИдентификаторПользователяИБ = &Идентификатор
	|	И НЕ Пользователи.ПометкаУдаления");
	Запрос.УстановитьПараметр("Идентификатор", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.Пользователи.ПустаяСсылка());

КонецФункции

Функция ОтмеченныеНастройки(Пользователь)

	Возврат РегистрыСведений.НастройкиПользователей.ФормыПриЗапускеПользователя(Пользователь).ВыгрузитьКолонку("Настройка");

КонецФункции

// Право текущего пользователя ИБ на обработку рабочего места. Пользователь передаётся явно: модуль привилегированный, и
// проверка без пользователя не должна зависеть от привилегированного режима.
//
// Параметры:
//  Форма - СтрокаТаблицыЗначений - см. РегистрыСведений.НастройкиПользователей.ФормыПриЗапуске.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователю доступна обработка.
//
Функция ЕстьПравоНаФорму(Форма)

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Обработка = Метаданные.Обработки[Форма.ИмяОбработки];
	Если ПустаяСтрока(ПользовательИБ.Имя) Тогда
		// Вход без пользователей ИБ - полные права.
		Возврат ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() = 0;
	КонецЕсли;
	Возврат ПравоДоступа("Использование", Обработка, ПользовательИБ);

КонецФункции

#КонецОбласти
