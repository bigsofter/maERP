
#Область Интерфейс

Процедура ЗаполнитьСерииПоОстаткам(Док, Клиент = Неопределено, ВсеСерии = Ложь) Экспорт
	ТЧ = Док.ТЧТовары;		
	Док.ТЧСерии.Очистить();
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	                      |	ТоварыВНаличииОстатки.Характеристика КАК Характеристика,
	                      |	ТоварыВНаличииОстатки.Серия КАК Серия,
	                      |	ТоварыВНаличииОстатки.КоличествоОстаток КАК Количество,
	                      |	ТоварыВНаличииОстатки.Серия.ДатаПоступления КАК ДатаПоступления,
	                      |	ТоварыВНаличииОстатки.Серия.ГоденДо КАК СрокГодности,
	                      |	ТоварыВНаличииОстатки.Серия.Адресная КАК АдреснаяСерия
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВНаличии.Остатки(
	                      |			&ДатаОст,
	                      |			МестоХранения = &МестоХранения
	                      |				И Номенклатура В (&Номенклатура)
	                      |				И Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	                      |				И ВЫБОР
	                      |					КОГДА &ВсеСерии
	                      |						ТОГДА ИСТИНА
	                      |					ИНАЧЕ Серия В
	                      |							(ВЫБРАТЬ
	                      |								СерияПокупатели.Ссылка КАК Серия
	                      |							ИЗ
	                      |								Справочник.СерииНоменклатуры.ТЧПокупатели КАК СерияПокупатели
	                      |							ГДЕ
	                      |								СерияПокупатели.Покупатель = &Клиент
	                      |			
	                      |							ОБЪЕДИНИТЬ ВСЕ
	                      |			
	                      |							ВЫБРАТЬ
	                      |								Серии.Ссылка КАК Серия
	                      |							ИЗ
	                      |								Справочник.СерииНоменклатуры КАК Серии
	                      |							ГДЕ
	                      |								НЕ Серии.Адресная)
	                      |				КОНЕЦ) КАК ТоварыВНаличииОстатки
	                      |ГДЕ
	                      |	ТоварыВНаличииОстатки.КоличествоОстаток > 0
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	АдреснаяСерия УБЫВ,
	                      |	СрокГодности,
	                      |	ДатаПоступления");
	Запрос.УстановитьПараметр("ДатаОст", РаботаСДокументамиВызовСервера.ПолучитьГраницуДокумента(Док));
	Запрос.УстановитьПараметр("МестоХранения", Док.МестоХранения);
	Запрос.УстановитьПараметр("Номенклатура", ТЧ.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("Клиент", ?(Клиент = Неопределено,Справочники.Контрагенты.ПустаяСсылка(),Клиент));
	Запрос.УстановитьПараметр("ВсеСерии", ВсеСерии);
	ТЗОстатки = Запрос.Выполнить().Выгрузить();
	Для Каждого Стр Из ТЧ Цикл
		Если Стр.КоличествоУпаковок = 0 Или Стр.Количество = 0 Тогда Продолжить КонецЕсли;
		Стр.УказаноНесколькоСерий = Ложь;
		Стр.Серия = Неопределено;
		КоличествоВсего = Стр.Количество;
		КоэффициентУпаковки = Стр.Количество / Стр.КоличествоУпаковок;
		Мас = ТЗОстатки.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Стр.Номенклатура, Стр.Характеристика));
		Если Мас.Количество() = 0 Тогда Продолжить КонецЕсли;	
		МасСерии = Новый Массив;
		// Получаем массив серий
		Для Каждого МасСтр Из Мас Цикл
			Если КоличествоВсего = 0 Тогда Прервать КонецЕсли;
			Количество = ?(КоличествоВсего > МасСтр.Количество, МасСтр.Количество, КоличествоВсего);
			КоличествоУпаковок = Количество / КоэффициентУпаковки; // Работа с сериями идёт по реквизиту "КоличествоУпаковок", но в этом регистре они хранятся в базовых единицах
			МасСерии.Добавить(Новый Структура("Серия, Количество", МасСтр.Серия, КоличествоУпаковок));
			МасСтр.Количество = МасСтр.Количество - Количество;
			КоличествоВсего = КоличествоВсего - Количество;
		КонецЦикла;
		Если КоличествоВсего > 0 и МасСерии.Количество() > 0 Тогда // Если есть серии и не хватило, дополняем пустой серией
			КоличествоУпаковок = КоличествоВсего / КоэффициентУпаковки;
			МасСерии.Добавить(Новый Структура("Серия, Количество", Справочники.СерииНоменклатуры.ПустаяСсылка(), КоличествоУпаковок));	
		КонецЕсли;		
		// Заполняем серии
		Если МасСерии.Количество() = 1 Тогда
			Стр.Серия = МасСерии[0].Серия;	
		Иначе
			Стр.УказаноНесколькоСерий = Истина;
			Для Каждого МасСтр Из МасСерии Цикл			
				НС = Док.ТЧСерии.Добавить();
				НС.КодСтроки = Стр.КодСтроки;
				НС.Серия = МасСтр.Серия;
				НС.Количество = МасСтр.Количество;
			КонецЦикла;	
		КонецЕсли;	
		// Удалим строки с остатком 0
		Мас = ТЗОстатки.НайтиСтроки(Новый Структура("Количество", 0));
		Для А = 1 - Мас.Количество() По 0 Цикл
			ТЗОстатки.Удалить(Мас[-А]);	
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры

Функция ОбъединитьТоварыССериями(ДокОбъект, ТЧТоварыИмя = "ТЧТовары") Экспорт
	РеквизитКоличество = "Количество"; 
	РеквизитКоличествоУпаковок = "КоличествоУпаковок";	
	ТЗТовары = ДокОбъект[ТЧТоварыИмя].Выгрузить();
	Курс = 1;
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект,"Валюта") Тогда
		Если Не ДокОбъект.Валюта.Пустая() и Не ДокОбъект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить() Тогда 
			Курс = ДокОбъект.КурсВалюты;
			Для Каждого Стр из ТЗТовары Цикл
				Стр.Сумма = Стр.Сумма * Курс;
				Стр.СуммаНДС = Стр.СуммаНДС * Курс;
				Стр.СуммаСНДС = Стр.СуммаСНДС * Курс;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если ТЗТовары.Колонки.Найти("УказаноНесколькоСерий") <> Неопределено 
		и ТЗТовары.НайтиСтроки(Новый Структура("УказаноНесколькоСерий", Истина)).Количество() > 0 Тогда
		ТЗТовары.Очистить();
		Для Каждого Стр Из ДокОбъект[ТЧТоварыИмя] Цикл
			Если Стр.УказаноНесколькоСерий Тогда
				МасСерии = ДокОбъект.ТЧСерии.НайтиСтроки(Новый Структура("КодСтроки", Стр.КодСтроки));
				// Данные расчёта
				КоличествоСерий = МасСерии.Количество();
				КоличествоОстаток = Стр[РеквизитКоличество];
				СуммаОстаток = Стр.Сумма;
				СуммаНДСОстаток = Стр.СуммаНДС;
				СуммаСНДСОстаток = Стр.СуммаСНДС;
				//
				Для А = 1 По КоличествоСерий Цикл
					МасСтр = МасСерии[А - 1];
					НС = ТЗТовары.Добавить();
					ЗаполнитьЗначенияСвойств(НС, Стр,, "Серия, " + РеквизитКоличествоУпаковок + ", " + РеквизитКоличество + ", Сумма, СуммаНДС, СуммаСНДС");
					НС.Серия = МасСтр.Серия;
					НС.КоличествоУпаковок = МасСтр.Количество;
					Если А = КоличествоСерий Тогда
						НС.Количество = КоличествоОстаток;
						НС.Сумма = СуммаОстаток;
						НС.СуммаНДС = СуммаНДСОстаток;
						НС.СуммаСНДС = СуммаСНДСОстаток;
					Иначе
						НС.Количество = Стр[РеквизитКоличество] / Стр[РеквизитКоличествоУпаковок] * МасСтр.Количество;
						КоличествоОстаток = КоличествоОстаток - НС.Количество;
						НС.Сумма = Окр(Стр.Сумма / Стр[РеквизитКоличествоУпаковок] * МасСтр.Количество, 2);
						СуммаОстаток = СуммаОстаток - НС.Сумма;
						НС.СуммаНДС = Окр(Стр.СуммаНДС / Стр[РеквизитКоличествоУпаковок] * МасСтр.Количество, 2);
						СуммаНДСОстаток = СуммаНДСОстаток - НС.СуммаНДС;				
						НС.СуммаСНДС = Окр(Стр.СуммаСНДС / Стр[РеквизитКоличествоУпаковок] * МасСтр.Количество, 2);
						СуммаСНДСОстаток = СуммаСНДСОстаток - НС.СуммаСНДС;	
					КонецЕсли;			
				КонецЦикла;	
			Иначе
				НС = ТЗТовары.Добавить();
				ЗаполнитьЗначенияСвойств(НС, Стр);
				НС.Количество = Стр[РеквизитКоличество];
				НС.КоличествоУпаковок = Стр[РеквизитКоличествоУпаковок];
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	ТЗТовары.Колонки.Добавить("МестоХранения", Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект,"МестоХранения") Тогда 
		ТЗТовары.ЗаполнитьЗначения(ДокОбъект.МестоХранения, "МестоХранения");
	КонецЕсли;
	ДополнитьКолонкамиПартии(ТЗТовары);
	//
	Возврат ТЗТовары;
КонецФункции

// Добавляет в таблицу товаров колонки Партия и ЕстьПартия для списания по указанной партии.
//
// Параметры:
//  ТЗТовары - ТаблицаЗначений - товары документа; колонка Партия добавляется, если её нет,
//             ЕстьПартия заполняется по заполненности партии.
//
Процедура ДополнитьКолонкамиПартии(ТЗТовары) Экспорт
	Если ТЗТовары.Колонки.Найти("Партия") = Неопределено Тогда
		ТЗТовары.Колонки.Добавить("Партия", Метаданные.ОпределяемыеТипы.ПриходныйДокументПартии.Тип);
	КонецЕсли;
	Если ТЗТовары.Колонки.Найти("ЕстьПартия") = Неопределено Тогда
		ТЗТовары.Колонки.Добавить("ЕстьПартия", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	Для Каждого Стр Из ТЗТовары Цикл
		Стр.ЕстьПартия = ЗначениеЗаполнено(Стр.Партия);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти


	