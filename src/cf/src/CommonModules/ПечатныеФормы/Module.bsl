////////////////////////////////////////////////////////////////////////////////
// Ядро подсистемы печатных форм.
//
// Конвенция печатаемого объекта: в его модуле менеджера есть две экспортные
// процедуры - ДобавитьКомандыПечати (перечисляет печатные формы объекта) и
// Печать (формирует запрошенные печатные формы). Сам объект перечисляется в
// ОбъектыСКомандамиПечати: другого способа узнать, что у менеджера есть эти
// процедуры, во встроенном языке нет.
//
// Макет печатной формы берётся только через МакетПечатнойФормы: функция
// подставляет изменённый пользователем макет из регистра
// ПользовательскиеМакетыПечати, если его использование включено.
//
// Регистр читается и пишется под любым пользователем, у которого есть печать.
// BSLLS:SetPrivilegedMode-off
//
// Имена колонок содержат букву "ё" (Изменён), как принято в метаданных maERP.
// BSLLS:YoLetterUsage-off
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область Макеты

// Макет печатной формы: изменённый пользователем, если его использование включено,
// иначе поставляемый с конфигурацией.
//
// Параметры:
//  ПутьКМакету - Строка - "Документ.РеализацияТоваровУслуг.Счёт" или "ОбщийМакет.АктОбОказанииУслуг"
//
// Возвращаемое значение:
//  ТабличныйДокумент - макет печатной формы
//
Функция МакетПечатнойФормы(ПутьКМакету) Экспорт

	Владелец = ВладелецМакета(ПутьКМакету);

	УстановитьПривилегированныйРежим(Истина);
	Отбор = Новый Структура("Объект, ИмяМакета", Владелец.Объект, Владелец.ИмяМакета);
	Ресурсы = РегистрыСведений.ПользовательскиеМакетыПечати.Получить(Отбор);
	Если Ресурсы.Использование И ТипЗнч(Ресурсы.Макет) = Тип("ХранилищеЗначения") Тогда
		Макет = Ресурсы.Макет.Получить();
		Если ТипЗнч(Макет) = Тип("ТабличныйДокумент") Тогда
			Возврат Макет;
		КонецЕсли;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат ПоставляемыйМакет(ПутьКМакету);

КонецФункции

// Макет, поставляемый с конфигурацией, без учёта пользовательских изменений.
//
// Параметры:
//  ПутьКМакету - Строка - см. МакетПечатнойФормы
//
// Возвращаемое значение:
//  ТабличныйДокумент - макет печатной формы
//
Функция ПоставляемыйМакет(ПутьКМакету) Экспорт

	Владелец = ВладелецМакета(ПутьКМакету);
	Если Владелец.Объект = ИмяВладельцаОбщихМакетов() Тогда
		Возврат ПолучитьОбщийМакет(Владелец.ИмяМакета);
	КонецЕсли;

	Возврат МенеджерОбъекта(Владелец.Объект).ПолучитьМакет(Владелец.ИмяМакета);

КонецФункции

// Печатается ли форма по изменённому пользователем макету.
//
// Параметры:
//  ПутьКМакету - Строка - см. МакетПечатнойФормы
//
// Возвращаемое значение:
//  Булево - Истина, если используется пользовательский макет
//
Функция ИспользуетсяПользовательскийМакет(ПутьКМакету) Экспорт

	Владелец = ВладелецМакета(ПутьКМакету);

	УстановитьПривилегированныйРежим(Истина);
	Отбор = Новый Структура("Объект, ИмяМакета", Владелец.Объект, Владелец.ИмяМакета);
	Возврат РегистрыСведений.ПользовательскиеМакетыПечати.Получить(Отбор).Использование;

КонецФункции

// Сохраняет изменённый пользователем макет и включает его использование.
//
// Параметры:
//  ПутьКМакету - Строка            - см. МакетПечатнойФормы
//  Макет       - ТабличныйДокумент - изменённый макет
//
Процедура ЗаписатьПользовательскийМакет(ПутьКМакету, Макет) Экспорт

	Владелец = ВладелецМакета(ПутьКМакету);

	УстановитьПривилегированныйРежим(Истина);
	МенеджерЗаписи = РегистрыСведений.ПользовательскиеМакетыПечати.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Владелец.Объект;
	МенеджерЗаписи.ИмяМакета = Владелец.ИмяМакета;
	МенеджерЗаписи.Макет = Новый ХранилищеЗначения(Макет, Новый СжатиеДанных());
	МенеджерЗаписи.Использование = Истина;
	МенеджерЗаписи.ВерсияКонфигурации = Метаданные.Версия;
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Переключает печать между изменённым и поставляемым макетом, не удаляя изменённый.
//
// Параметры:
//  ПутьКМакету  - Строка - см. МакетПечатнойФормы
//  Использование - Булево - Истина - печатать по изменённому макету
//
Процедура УстановитьИспользованиеМакета(ПутьКМакету, Использование) Экспорт

	Владелец = ВладелецМакета(ПутьКМакету);

	УстановитьПривилегированныйРежим(Истина);
	МенеджерЗаписи = РегистрыСведений.ПользовательскиеМакетыПечати.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Владелец.Объект;
	МенеджерЗаписи.ИмяМакета = Владелец.ИмяМакета;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;
	МенеджерЗаписи.Использование = Использование;
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Удаляет изменённый макет: печать возвращается к поставляемому безвозвратно.
//
// Параметры:
//  ПутьКМакету - Строка - см. МакетПечатнойФормы
//
Процедура УдалитьПользовательскийМакет(ПутьКМакету) Экспорт

	Владелец = ВладелецМакета(ПутьКМакету);

	УстановитьПривилегированныйРежим(Истина);
	МенеджерЗаписи = РегистрыСведений.ПользовательскиеМакетыПечати.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Владелец.Объект;
	МенеджерЗаписи.ИмяМакета = Владелец.ИмяМакета;
	МенеджерЗаписи.Удалить();

КонецПроцедуры

// Все макеты печатных форм конфигурации с состоянием пользовательской правки.
// Источник данных формы МакетыПечатныхФорм.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * ПутьКМакету        - Строка - "Документ.X.Счёт"
//   * Объект             - Строка - полное имя владельца макета
//   * ПредставлениеОбъекта - Строка - синоним владельца
//   * ИмяМакета          - Строка - имя макета в метаданных
//   * ПредставлениеМакета - Строка - синоним макета
//   * Изменён            - Булево - есть запись пользовательского макета
//   * Используется       - Булево - печать идёт по изменённому макету
//   * ВерсияКонфигурации - Строка - версия конфигурации на момент правки
//   * ТребуетВнимания    - Булево - макет правился в более старой версии конфигурации
//
Функция МакетыПечатныхФорм() Экспорт

	Макеты = НоваяТаблицаМакетов();

	ДобавитьМакетыКоллекции(Макеты, Метаданные.ОбщиеМакеты, ИмяВладельцаОбщихМакетов());
	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.Документы);
	Коллекции.Добавить(Метаданные.Справочники);
	Коллекции.Добавить(Метаданные.Обработки);
	Коллекции.Добавить(Метаданные.Отчеты);
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого ОбъектМетаданных Из Коллекция Цикл
			ДобавитьМакетыКоллекции(Макеты, ОбъектМетаданных.Макеты, ОбъектМетаданных.ПолноеИмя(), ОбъектМетаданных.Синоним);
		КонецЦикла;
	КонецЦикла;

	ДополнитьСостояниемПравки(Макеты);
	Макеты.Сортировать("ПредставлениеОбъекта Возр, ПредставлениеМакета Возр");
	Возврат Макеты;

КонецФункции

#КонецОбласти

#Область КомандыПечати

// Пустая коллекция команд печати; заполняется в ДобавитьКомандыПечати модуля менеджера.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * ИмяМакета       - Строка - имя макета объекта, оно же идентификатор команды
//   * Представление   - Строка - название печатной формы для пользователя
//   * Порядок         - Число  - порядок в списке печатных форм
//   * СразуНаПринтер  - Булево - печатать без окна предварительного просмотра
//   * ИмяПринтера     - Строка - принтер для печати без просмотра; пусто - принтер по умолчанию
//
Функция НоваяКоллекцияКомандПечати() Экспорт

	ТипСтрока = Новый ОписаниеТипов("Строка");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("ИмяМакета", ТипСтрока);
	Команды.Колонки.Добавить("Представление", ТипСтрока);
	Команды.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Команды.Колонки.Добавить("СразуНаПринтер", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("ИмяПринтера", ТипСтрока);
	Возврат Команды;

КонецФункции

// Печатные формы объекта в порядке, заданном его модулем менеджера.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - "Документ.РеализацияТоваровУслуг"
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяКоллекцияКомандПечати; пустая, если у объекта нет печати
//
Функция КомандыПечатиОбъекта(ПолноеИмяОбъекта) Экспорт

	Команды = НоваяКоллекцияКомандПечати();
	Если ОбъектыСКомандамиПечати().Найти(ПолноеИмяОбъекта) = Неопределено Тогда
		Возврат Команды;
	КонецЕсли;

	МенеджерОбъекта(ПолноеИмяОбъекта).ДобавитьКомандыПечати(Команды);
	Команды.Сортировать("Порядок Возр, Представление Возр");
	Возврат Команды;

КонецФункции

// Объекты, у которых модуль менеджера поддерживает конвенцию печати
// (ДобавитьКомандыПечати и Печать). Пополняется при переводе объекта на подсистему.
//
// Возвращаемое значение:
//  Массив из Строка - полные имена объектов метаданных
//
Функция ОбъектыСКомандамиПечати() Экспорт

	Объекты = Новый Массив;
	Объекты.Добавить("Документ.ВыплатаЗарплаты");
	Объекты.Добавить("Документ.ЗаказПоставщику");
	Объекты.Добавить("Документ.КорректировкаДолга");
	Объекты.Добавить("Документ.НалоговаяНакладнаяПокупка");
	Объекты.Добавить("Документ.ОприходованиеТоваров");
	Объекты.Добавить("Документ.ПередачаВПереработку");
	Объекты.Добавить("Документ.ПеремещениеТоваров");
	Объекты.Добавить("Документ.ПлатёжнаяВедомостьНаАванс");
	Объекты.Добавить("Документ.ПоступлениеИзПереработки");
	Объекты.Добавить("Документ.ПоступлениеТоваровУслуг");
	Объекты.Добавить("Документ.СписаниеТоваров");
	Возврат Объекты;

КонецФункции

#КонецОбласти

#Область ФормированиеПечатныхФорм

// Формирует печатные формы объектов по именам макетов.
//
// Параметры:
//  ИмяМенеджераПечати - Строка          - полное имя объекта, чей модуль менеджера печатает
//  ИменаМакетов       - Строка          - имена макетов через запятую
//  МассивОбъектов     - Массив          - ссылки на печатаемые объекты
//  ПараметрыПечати    - Структура       - произвольные параметры для модуля менеджера
//
// Возвращаемое значение:
//  Структура - результат формирования:
//   * КоллекцияПечатныхФорм - ТаблицаЗначений  - см. НоваяКоллекцияПечатныхФорм
//   * ОбъектыПечати         - СписокЗначений   - ссылка объекта - имя области табличного документа
//   * ПараметрыВывода       - Структура        - ЗаголовокФормы
//
Функция СформироватьПечатныеФормы(ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати = Неопределено) Экспорт

	Параметры = ?(ПараметрыПечати = Неопределено, Новый Структура, ПараметрыПечати);

	КоллекцияПечатныхФорм = НоваяКоллекцияПечатныхФорм(ИменаМакетов);
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыВывода = Новый Структура("ЗаголовокФормы", "");

	МенеджерОбъекта(ИмяМенеджераПечати).Печать(МассивОбъектов, Параметры, КоллекцияПечатныхФорм,
		ОбъектыПечати, ПараметрыВывода);

	Организация = ОрганизацияОбъектов(МассивОбъектов);
	Для Каждого ПечатнаяФорма Из КоллекцияПечатныхФорм Цикл
		Если ТипЗнч(ПечатнаяФорма.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
			ЗаполнитьКартинкиОрганизации(ПечатнаяФорма.ТабличныйДокумент, Организация);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("КоллекцияПечатныхФорм", КоллекцияПечатныхФорм);
	Результат.Вставить("ОбъектыПечати", ОбъектыПечати);
	Результат.Вставить("ПараметрыВывода", ПараметрыВывода);
	Возврат Результат;

КонецФункции

// Пустая коллекция печатных форм с заготовками строк по именам макетов.
//
// Параметры:
//  ИменаМакетов - Строка - имена макетов через запятую
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * ИмяМакета         - Строка            - имя макета объекта
//   * СинонимМакета     - Строка            - название печатной формы
//   * ТабличныйДокумент - ТабличныйДокумент  - результат формирования
//   * ПутьКМакету       - Строка            - полный путь макета для команды «Изменить макет»
//   * ИмяФайла          - Строка            - имя файла при сохранении
//
Функция НоваяКоллекцияПечатныхФорм(ИменаМакетов) Экспорт

	ТипСтрока = Новый ОписаниеТипов("Строка");

	Коллекция = Новый ТаблицаЗначений;
	Коллекция.Колонки.Добавить("ИмяМакета", ТипСтрока);
	Коллекция.Колонки.Добавить("СинонимМакета", ТипСтрока);
	Коллекция.Колонки.Добавить("ТабличныйДокумент", Новый ОписаниеТипов("ТабличныйДокумент"));
	Коллекция.Колонки.Добавить("ПутьКМакету", ТипСтрока);
	Коллекция.Колонки.Добавить("ИмяФайла", ТипСтрока);

	Для Каждого ИмяМакета Из СтрРазделить(ИменаМакетов, ",", Ложь) Цикл
		Строка = Коллекция.Добавить();
		Строка.ИмяМакета = СокрЛП(ИмяМакета);
	КонецЦикла;

	Возврат Коллекция;

КонецФункции

// Запрошена ли печать этого макета.
//
// Параметры:
//  КоллекцияПечатныхФорм - ТаблицаЗначений - см. НоваяКоллекцияПечатныхФорм
//  ИмяМакета             - Строка          - имя проверяемого макета
//
// Возвращаемое значение:
//  Булево - Истина, если макет нужно сформировать
//
Функция НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета) Экспорт

	Возврат КоллекцияПечатныхФорм.Найти(ИмяМакета, "ИмяМакета") <> Неопределено;

КонецФункции

// Помещает сформированный табличный документ в коллекцию печатных форм.
//
// Параметры:
//  КоллекцияПечатныхФорм - ТаблицаЗначений    - см. НоваяКоллекцияПечатныхФорм
//  ИмяМакета             - Строка             - имя макета
//  СинонимМакета         - Строка             - название печатной формы для пользователя
//  ТабличныйДокумент     - ТабличныйДокумент  - результат формирования
//  ПутьКМакету           - Строка             - путь макета; пусто - «Документ.X.ИмяМакета» не определяется
//
Процедура ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ТабличныйДокумент,
	ПутьКМакету = "") Экспорт

	Строка = КоллекцияПечатныхФорм.Найти(ИмяМакета, "ИмяМакета");
	Если Строка = Неопределено Тогда
		Строка = КоллекцияПечатныхФорм.Добавить();
		Строка.ИмяМакета = ИмяМакета;
	КонецЕсли;

	Строка.СинонимМакета = СинонимМакета;
	Строка.ТабличныйДокумент = ТабличныйДокумент;
	Строка.ПутьКМакету = ПутьКМакету;
	Если Не ЗначениеЗаполнено(Строка.ИмяФайла) Тогда
		Строка.ИмяФайла = СинонимМакета;
	КонецЕсли;

КонецПроцедуры

// Именует область табличного документа, относящуюся к одному объекту,
// чтобы окно печати умело переходить от печатной формы к документу.
//
// Параметры:
//  ТабличныйДокумент   - ТабличныйДокумент - формируемый документ
//  НомерСтрокиНачало   - Число             - первая строка области
//  ОбъектыПечати       - СписокЗначений    - соответствие ссылок именам областей
//  Ссылка              - ЛюбаяСсылка       - печатаемый объект
//
Процедура ЗадатьОбластьПечати(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Ссылка) Экспорт

	ИмяОбласти = "Документ_" + Формат(ОбъектыПечати.Количество() + 1, "ЧГ=0");
	Область = ТабличныйДокумент.Область(НомерСтрокиНачало, , ТабличныйДокумент.ВысотаТаблицы);
	Область.Имя = ИмяОбласти;
	ОбъектыПечати.Добавить(Ссылка, ИмяОбласти);

КонецПроцедуры

#КонецОбласти

#Область КартинкиОрганизации

// Подставляет в готовую печатную форму картинки организации: рисунки макета с именами
// «Логотип», «ПечатьОрганизации» и «Подпись» заполняются из карточки организации.
// Рисунков с такими именами в макете может не быть - тогда процедура ничего не делает.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - готовая печатная форма
//  Организация       - СправочникСсылка.Организации - организация документа; пустая ссылка - выход
//
Процедура ЗаполнитьКартинкиОрганизации(ТабличныйДокумент, Организация) Экспорт

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "Логотип, ПечатьОрганизации");
	УстановитьПривилегированныйРежим(Ложь);

	Картинки = Новый Соответствие;
	Картинки.Вставить("Логотип", КартинкаИзХранилища(Реквизиты.Логотип));
	Картинки.Вставить("ПечатьОрганизации", КартинкаИзХранилища(Реквизиты.ПечатьОрганизации));

	Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл
		Если Рисунок.ТипРисунка <> ТипРисункаТабличногоДокумента.Картинка Тогда
			Продолжить;
		КонецЕсли;
		Картинка = Картинки[Рисунок.Имя];
		Если Картинка <> Неопределено Тогда
			Рисунок.Картинка = Картинка;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает путь к макету на владельца и имя макета.
//
// Параметры:
//  ПутьКМакету - Строка - "Документ.X.ИмяМакета" или "ОбщийМакет.ИмяМакета"
//
// Возвращаемое значение:
//  Структура - Объект (Строка), ИмяМакета (Строка)
//
Функция ВладелецМакета(ПутьКМакету)

	ПозицияТочки = СтрНайти(ПутьКМакету, ".", НаправлениеПоиска.СКонца);
	Если ПозицияТочки > 1 Тогда
		Владелец = Лев(ПутьКМакету, ПозицияТочки - 1);
		ИмяМакета = Сред(ПутьКМакету, ПозицияТочки + 1);
		Если ЗначениеЗаполнено(ИмяМакета)
			И (Владелец = ИмяВладельцаОбщихМакетов() Или СтрНайти(Владелец, ".") > 0) Тогда
			Возврат Новый Структура("Объект, ИмяМакета", Владелец, ИмяМакета);
		КонецЕсли;
	КонецЕсли;

	ШаблонОшибки = НСтр("ru = 'Неверный путь к макету печатной формы: %1';
		|fr = 'Chemin incorrect vers le modèle du formulaire imprimable : %1';
		|en = 'Invalid path to the print form template: %1';
		|es = 'Ruta incorrecta a la plantilla del formulario de impresión: %1'");
	ВызватьИсключение СтрШаблон(ШаблонОшибки, ПутьКМакету);

КонецФункции

// Имя владельца общих макетов в путях и в регистре.
//
// Возвращаемое значение:
//  Строка - "ОбщийМакет"
//
Функция ИмяВладельцаОбщихМакетов()

	Возврат "ОбщийМакет";

КонецФункции

// Менеджер объекта метаданных по его полному имени.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - "Документ.РеализацияТоваровУслуг"
//
// Возвращаемое значение:
//  ДокументМенеджер, СправочникМенеджер, ОбработкаМенеджер, ОтчетМенеджер, РегистрСведенийМенеджер - менеджер
//
Функция МенеджерОбъекта(ПолноеИмяОбъекта)

	КоллекцииМенеджеров = Новый Соответствие;
	КоллекцииМенеджеров.Вставить("Документ", Документы);
	КоллекцииМенеджеров.Вставить("Справочник", Справочники);
	КоллекцииМенеджеров.Вставить("Обработка", Обработки);
	КоллекцииМенеджеров.Вставить("Отчет", Отчеты);
	КоллекцииМенеджеров.Вставить("РегистрСведений", РегистрыСведений);
	КоллекцииМенеджеров.Вставить("ЖурналДокументов", ЖурналыДокументов);

	ПозицияТочки = СтрНайти(ПолноеИмяОбъекта, ".");
	Если ПозицияТочки > 1 Тогда
		Коллекция = КоллекцииМенеджеров[Лев(ПолноеИмяОбъекта, ПозицияТочки - 1)];
		Если Коллекция <> Неопределено Тогда
			Возврат Коллекция[Сред(ПолноеИмяОбъекта, ПозицияТочки + 1)];
		КонецЕсли;
	КонецЕсли;

	ШаблонОшибки = НСтр("ru = 'Печать не поддерживается для объекта: %1';
		|fr = 'L''impression n''est pas prise en charge pour l''objet : %1';
		|en = 'Printing is not supported for the object: %1';
		|es = 'La impresión no es compatible con el objeto: %1'");
	ВызватьИсключение СтрШаблон(ШаблонОшибки, ПолноеИмяОбъекта);

КонецФункции

// Организация печатаемых объектов: берётся у первого объекта, у которого есть такой реквизит.
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на печатаемые объекты
//
// Возвращаемое значение:
//  СправочникСсылка.Организации, Неопределено - организация или Неопределено
//
Функция ОрганизацияОбъектов(МассивОбъектов)

	Для Каждого Объект Из МассивОбъектов Цикл
		Если Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект)) Тогда
			Продолжить;
		КонецЕсли;
		МетаданныеОбъекта = Объект.Метаданные();
		Если МетаданныеОбъекта.Реквизиты.Найти("Организация") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, "Организация");
		Если ЗначениеЗаполнено(Организация) Тогда
			Возврат Организация;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Картинка из реквизита-хранилища значения.
//
// Параметры:
//  Хранилище - ХранилищеЗначения, Произвольный - реквизит организации
//
// Возвращаемое значение:
//  Картинка, Неопределено - картинка или Неопределено, если хранилище пустое
//
Функция КартинкаИзХранилища(Хранилище)

	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Хранилище.Получить();
	Если ТипЗнч(Данные) = Тип("Картинка") Тогда
		Возврат Данные;
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		Возврат Новый Картинка(Данные);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Пустая таблица макетов печатных форм.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. МакетыПечатныхФорм
//
Функция НоваяТаблицаМакетов()

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");

	Макеты = Новый ТаблицаЗначений;
	Макеты.Колонки.Добавить("ПутьКМакету", ТипСтрока);
	Макеты.Колонки.Добавить("Объект", ТипСтрока);
	Макеты.Колонки.Добавить("ПредставлениеОбъекта", ТипСтрока);
	Макеты.Колонки.Добавить("ИмяМакета", ТипСтрока);
	Макеты.Колонки.Добавить("ПредставлениеМакета", ТипСтрока);
	Макеты.Колонки.Добавить("Изменён", ТипБулево);
	Макеты.Колонки.Добавить("Используется", ТипБулево);
	Макеты.Колонки.Добавить("ВерсияКонфигурации", ТипСтрока);
	Макеты.Колонки.Добавить("ТребуетВнимания", ТипБулево);
	Возврат Макеты;

КонецФункции

// Добавляет в таблицу табличные макеты одной коллекции метаданных.
//
// Параметры:
//  Макеты            - ТаблицаЗначений    - пополняемая таблица
//  МакетыМетаданных  - Коллекция          - коллекция макетов объекта или общих макетов
//  ИмяВладельца      - Строка             - полное имя владельца
//  СинонимВладельца  - Строка             - представление владельца; пусто - берётся имя
//
Процедура ДобавитьМакетыКоллекции(Макеты, МакетыМетаданных, ИмяВладельца, СинонимВладельца = "")

	Для Каждого МакетМетаданных Из МакетыМетаданных Цикл
		Если МакетМетаданных.ТипМакета <> ТипМакета.ТабличныйДокумент Тогда
			Продолжить;
		КонецЕсли;
		Строка = Макеты.Добавить();
		Строка.Объект = ИмяВладельца;
		Строка.ПредставлениеОбъекта = ?(ЗначениеЗаполнено(СинонимВладельца), СинонимВладельца, ИмяВладельца);
		Строка.ИмяМакета = МакетМетаданных.Имя;
		Строка.ПредставлениеМакета = ?(ЗначениеЗаполнено(МакетМетаданных.Синоним),
			МакетМетаданных.Синоним, МакетМетаданных.Имя);
		Строка.ПутьКМакету = ИмяВладельца + "." + МакетМетаданных.Имя;
	КонецЦикла;

КонецПроцедуры

// Проставляет в таблице макетов состояние пользовательской правки.
//
// Параметры:
//  Макеты - ТаблицаЗначений - таблица макетов по метаданным
//
Процедура ДополнитьСостояниемПравки(Макеты)

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Макеты.Объект КАК Объект,
	|	Макеты.ИмяМакета КАК ИмяМакета,
	|	Макеты.Использование КАК Использование,
	|	Макеты.ВерсияКонфигурации КАК ВерсияКонфигурации
	|ИЗ
	|	РегистрСведений.ПользовательскиеМакетыПечати КАК Макеты";

	ВерсияПрограммы = Метаданные.Версия;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Отбор = Новый Структура("Объект, ИмяМакета", Выборка.Объект, Выборка.ИмяМакета);
		НайденныеСтроки = Макеты.НайтиСтроки(Отбор);
		Для Каждого Строка Из НайденныеСтроки Цикл
			Строка.Изменён = Истина;
			Строка.Используется = Выборка.Использование;
			Строка.ВерсияКонфигурации = Выборка.ВерсияКонфигурации;
			Строка.ТребуетВнимания = Выборка.Использование
				И ОбновлениеПрограммы.СравнитьВерсии(Выборка.ВерсияКонфигурации, ВерсияПрограммы) < 0;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
