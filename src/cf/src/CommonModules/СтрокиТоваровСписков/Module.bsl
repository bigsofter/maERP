// Закладка «Товары» списков документов продаж (план docs/plans/orders-kp-goods-tab.md, тикет 2605528): строки товаров
// документов вводятся прямо в таблице формы списка, документ создаётся и записывается при записи строки. Здесь - общая
// механика пакета строк одного документа; специфика документа - экспортные функции его модуля менеджера с
// фиксированными именами (контракт):
//  ТекстЗапретаПравкиСтрокТоваров(ДокОбъект)              - правила правки по объекту под блокировкой; пусто - можно;
//  ЗаполнитьНовыйДокументСтрокТоваров(ДокОбъект, Строка)  - шапка нового документа; отказ - текст;
//  РежимЗаписиСтрокТоваров(ДокОбъект, НовыйДокумент)      - РежимЗаписиДокумента;
//  МожноВводитьСтрокиТоваров()                            - права на ввод;
//  ВидЦеныНовойСтрокиТоваров(ДокОбъект)                   - вид цен новой строки;
//  ТекстЗапретаСтрокиТоваров(СтрокаТоваров)               - запрет правки и удаления строки; пусто - можно;
//  ДополнитьНовуюСтрокуТоваров(ДокОбъект, СтрокаТоваров)  - документные поля новой строки;
//  ПоляПравкиЗаписаннойСтроки()                           - поля записанной строки, которые правятся на закладке.
// Модуль читает только общие реквизиты документов белого списка (ИменаДокументов): шапка - ЦенаВключаетНДС, валюта,
// ТЧТовары, ВерсияДанных, ПометкаУдаления; строка - КодСтроки, Номенклатура, Характеристика, Упаковка,
// КоличествоУпаковок, Количество, ВидЦены, ЦенаSKU, Цена, ПроцентСкидки, СкидкаНаЦену и поля РассчитатьСтроку.

#Область СлужебныйПрограммныйИнтерфейс

// Документы, строки которых вводятся на закладке «Товары» через этот модуль. Имя документа приходит из формы и
// проверяется по этому списку.
//
// Возвращаемое значение:
//  Массив из Строка - имена документов.
//
Функция ИменаДокументов() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("ЗаказПокупателя");
	Возврат Имена;

КонецФункции

// Параметры:
//  ИмяДокумента - Произвольный - имя документа от формы.
//
// Возвращаемое значение:
//  Булево - Истина, если документ из белого списка ИменаДокументов.
//
Функция ДокументПоддерживается(ИмяДокумента) Экспорт

	Возврат ТипЗнч(ИмяДокумента) = Тип("Строка") И ИменаДокументов().Найти(ИмяДокумента) <> Неопределено;

КонецФункции

// Внешние роли (кабинет клиента, интернет-магазин, мобильные клиенты) закладку не получают: у них нет обязательного
// отбора своего клиента в списках (план, «Права»).
//
// Возвращаемое значение:
//  Булево - Истина, если у пользователя есть хоть одна внешняя роль.
//
Функция ЕстьВнешняяРоль() Экспорт

	Для Каждого ИмяРоли Из СтрРазделить("Клиент,ЛичныйКабинет,ECommerce,ОбменМобильнаяДоставка,MobileClient", ",") Цикл
		// BSLLS:IsInRoleMethod-off - закладка закрыта ролям внешних пользователей целиком.
		Если РольДоступна(ИмяРоли) Тогда
		// BSLLS:IsInRoleMethod-on
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Параметры:
//  ИмяДокумента - Строка - имя документа.
//
// Возвращаемое значение:
//  Булево - Истина, если закладка «Товары» доступна: документ поддерживается, роль не внешняя, есть право чтения.
//
Функция ЗакладкаДоступна(ИмяДокумента) Экспорт

	Возврат ДокументПоддерживается(ИмяДокумента) И Не ЕстьВнешняяРоль()
		И ПравоДоступа("Чтение", Метаданные.Документы[ИмяДокумента]);

КонецФункции

// Возвращаемое значение:
//  Число - предел документов, строки которых читает закладка (как предел заказов рабочего места производства).
//
Функция ПределДокументов() Экспорт

	// BSLLS:MagicNumber-off - предел объявлен этой функцией.
	Возврат 200;
	// BSLLS:MagicNumber-on

КонецФункции

// Пустая строка закладки «Товары»: колонки таблицы формы.
//
// Возвращаемое значение:
//  Структура - Документ, ДокументПредставление, Картинка, ВерсияДанных, НомерСтроки, Клиент, Организация, Номенклатура,
//              Характеристика, Упаковка, КоличествоУпаковок, Цена, Сумма, Валюта, ТолькоПросмотр.
//
Функция НоваяСтрокаТоваровСписка() Экспорт

	Возврат Новый Структура("Документ, ДокументПредставление, Картинка, ВерсияДанных, НомерСтроки, Клиент, Организация,
		|Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Цена, Сумма, Валюта, ТолькоПросмотр");

КонецФункции

// Параметры:
//  Номер - Строка - номер документа.
//  Дата  - Дата - дата документа.
//
// Возвращаемое значение:
//  Строка - представление документа в колонке «Документ».
//
Функция ПредставлениеДокументаСтроки(Номер, Дата) Экспорт

	Возврат СтрШаблон(НСтр("ru = '№ %1 от %2'; fr = 'N° %1 du %2'; en = 'No. %1 of %2'; es = 'N.º %1 del %2'"),
		СокрЛП(Номер), Формат(Дата, "ДЛФ=D"));

КонецФункции

// Индекс картинки строки в общей картинке СостоянияОбъекта (как в списке документов).
//
// Параметры:
//  Проведен        - Булево - документ проведён.
//  ПометкаУдаления - Булево - документ помечен на удаление.
//
// Возвращаемое значение:
//  Число - 0 - проведён, 1 - помечен на удаление, 2 - записан.
//
Функция КартинкаСостояния(Проведен, ПометкаУдаления) Экспорт

	Если ПометкаУдаления Тогда
		Возврат 1;
	ИначеЕсли Проведен Тогда
		Возврат 0;
	Иначе
		Возврат 2;
	КонецЕсли;

КонецФункции

// Параметры:
//  Позиция - Число - 0 - больше, 1 - меньше, 2 - равно (тумблер панели).
//
// Возвращаемое значение:
//  Строка - знак сравнения языка запросов.
//
Функция ЗнакСравнения(Позиция) Экспорт

	// BSLLS:MagicNumber-off - значения объявлены списком выбора тумблера знака на форме.
	Если Позиция = 1 Тогда
		Возврат "<";
	ИначеЕсли Позиция = 2 Тогда
		Возврат "=";
	Иначе
		Возврат ">";
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецФункции

// Контрагент документа клиента: головной у обособленного подразделения (ПолучитьДанныеКонтрагента, как форма).
//
// Параметры:
//  Клиент      - СправочникСсылка.Контрагенты - клиент строки.
//  Организация - СправочникСсылка.Организации - организация.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты - контрагент документа.
//
Функция КонтрагентДокумента(Клиент, Организация) Экспорт

	Данные = ОбщегоНазначенияВызовСервера.ПолучитьДанныеКонтрагента(Клиент, Организация,
		Перечисления.ВидыДоговоров.СПокупателем, ТекущаяДатаСеанса());
	Возврат ?(ЗначениеЗаполнено(Данные.Контрагент), Данные.Контрагент, Клиент);

КонецФункции

// Валюта договора клиента с организацией: не основная - валюта нового документа (как ЗаполнитьВалютуПоДоговору форм).
//
// Параметры:
//  Клиент      - СправочникСсылка.Контрагенты - клиент.
//  Организация - СправочникСсылка.Организации - организация.
//
// Возвращаемое значение:
//  СправочникСсылка.Валюты - валюта договора или основная.
//
Функция ВалютаДоговораКлиента(Клиент, Организация) Экспорт

	Основная = РаботаСВалютами.ОсновнаяВалюта();
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат Основная;
	КонецЕсли;
	Данные = ОбщегоНазначенияВызовСервера.ПолучитьДанныеКонтрагента(Клиент, Организация,
		Перечисления.ВидыДоговоров.СПокупателем, ТекущаяДатаСеанса());
	Если Не ЗначениеЗаполнено(Данные.Договор) Тогда
		Возврат Основная;
	КонецЕсли;
	ВалютаДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Договор, "ВалютаВзаиморасчётов");
	Возврат ?(ЗначениеЗаполнено(ВалютаДоговора), ВалютаДоговора, Основная);

КонецФункции

// Валюта и курс нового документа по договору клиента (как ЗаполнитьВалютуПоДоговору форм): не основная валюта
// договора - документ в валюте с курсом на дату документа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - новый документ с реквизитами ВВалюте, Валюта, КурсВалюты, Дата, Организация.
//  Клиент    - СправочникСсылка.Контрагенты - клиент строки.
//
// Возвращаемое значение:
//  Строка - текст отказа (курс не задан); пустая строка - валюта заполнена.
//
Функция ЗаполнитьВалютуПоДоговору(ДокОбъект, Клиент) Экспорт

	ДокОбъект.ВВалюте = Ложь;
	ДокОбъект.Валюта = РаботаСВалютами.ОсновнаяВалюта();
	ДокОбъект.КурсВалюты = 1;
	ВалютаДоговора = ВалютаДоговораКлиента(Клиент, ДокОбъект.Организация);
	Если ВалютаДоговора = ДокОбъект.Валюта Тогда
		Возврат "";
	КонецЕсли;
	Курс = РаботаСВалютами.КурсВалюты(ВалютаДоговора, ДокОбъект.Дата);
	Если Курс = 0 Тогда
		Возврат РаботаСВалютами.ТекстКурсНеЗадан(ВалютаДоговора, ДокОбъект.Дата);
	КонецЕсли;
	ДокОбъект.ВВалюте = Истина;
	ДокОбъект.Валюта = ВалютаДоговора;
	ДокОбъект.КурсВалюты = Курс;
	Возврат "";

КонецФункции

// Записывает строки закладки одного документа одним пакетом: одна блокировка, одна проверка версии данных, одна
// запись. Новая строка без документа - новый документ, по одной строке на вызов.
//
// Параметры:
//  ИмяДокумента - Строка - имя документа из ИменаДокументов.
//  Строки       - Массив из Структура - строки одного документа:
//   * Документ           - ДокументСсылка, Неопределено - документ; Неопределено - новый.
//   * НомерСтроки        - Число - номер строки товаров документа; 0 - новая строка.
//   * ВерсияДанных       - Строка - версия документа, прочитанная вместе со строкой.
//   * Клиент             - СправочникСсылка.Контрагенты - клиент нового документа.
//   * Организация        - СправочникСсылка.Организации - организация нового документа; пустая - по умолчанию.
//   * Номенклатура       - СправочникСсылка.Номенклатура - товар.
//   * Характеристика     - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика.
//   * Упаковка           - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка; пустая - единица товара.
//   * КоличествоУпаковок - Число - количество упаковок, больше нуля.
//   * Цена               - Число - цена в валюте документа, если ЦенаИзменена.
//   * ЦенаИзменена       - Булево - цену ввёл пользователь (применяется при праве заверения цен).
//   * Валюта             - СправочникСсылка.Валюты - валюта, в которой введена цена.
//
// Возвращаемое значение:
//  Структура:
//   * Успех       - Булево - документ записан.
//   * Текст       - Строка - отказ или сообщения записи.
//   * Документ    - ДокументСсылка, Неопределено - записанный документ.
//   * НомерСтроки - Число - номер последней записанной строки пакета.
//   * Конфликт    - Булево - документ изменил другой пользователь: строки надо перечитать.
//
Функция ЗаписатьСтроки(ИмяДокумента, Строки) Экспорт

	Результат = НовыйРезультат();
	Результат.Текст = ТекстЗапретаДанныхСтрок(ИмяДокумента, Строки);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Менеджер = Документы[ИмяДокумента];
	Документ = Строки[0].Документ;
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ЗаписатьНовыйДокумент(Менеджер, Строки[0], Результат);
		Возврат Результат;
	КонецЕсли;
	ДокОбъект = ЗаблокированныйДокумент(Менеджер, Документ, ВерсияПакета(Строки), Результат);
	Если ДокОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Изменений = 0;
		Для Каждого Строка Из Строки Цикл
			Результат.НомерСтроки = Строка.НомерСтроки;
			Если СтрокаБезИзменений(ДокОбъект, Строка) Тогда
				// Вошли в строку и вышли без правки: документ не перезаписывается.
				Продолжить;
			КонецЕсли;
			СтрокаТоваров = ПрименитьСтроку(Менеджер, ДокОбъект, Строка, Результат);
			Если СтрокаТоваров = Неопределено Тогда
				ДокОбъект.Разблокировать();
				Возврат Результат;
			КонецЕсли;
			Результат.НомерСтроки = СтрокаТоваров.НомерСтроки;
			Изменений = Изменений + 1;
		КонецЦикла;
		Если Изменений = 0 Тогда
			Результат.Успех = Истина;
			Результат.Документ = Документ;
		Иначе
			ЗаписатьДокумент(Менеджер, ДокОбъект, Ложь, Результат);
		КонецЕсли;
	Исключение
		Результат.Успех = Ложь;
		Результат.Текст = ТекстНеЗаписано(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ДокОбъект.Разблокировать();
	Возврат Результат;

КонецФункции

// Удаляет строки закладки; документ без строк помечается на удаление (как в рабочем месте производства).
//
// Параметры:
//  ИмяДокумента - Строка - имя документа из ИменаДокументов.
//  Строки       - Массив из Структура - Документ, НомерСтроки, ВерсияДанных.
//
// Возвращаемое значение:
//  Структура - Успех (Булево - все документы обработаны), Текст (Строка - отказы и сообщения по документам).
//
Функция УдалитьСтроки(ИмяДокумента, Строки) Экспорт

	Итог = Новый Структура("Успех, Текст", Ложь, "");
	Итог.Текст = ТекстЗапретаВвода(ИмяДокумента);
	Если Не ПустаяСтрока(Итог.Текст) Тогда
		Возврат Итог;
	КонецЕсли;
	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Итог.Текст = ТекстНеверныеДанные();
		Возврат Итог;
	КонецЕсли;
	Итог.Успех = Истина;
	Менеджер = Документы[ИмяДокумента];
	ПоДокументам = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Если Не ЗаписанныйДокументСтроки(ИмяДокумента, Строка) Тогда
			Итог.Успех = Ложь;
			Итог.Текст = ТекстНеверныеДанные();
			Возврат Итог;
		КонецЕсли;
		Номера = ПоДокументам[Строка.Документ];
		Если Номера = Неопределено Тогда
			Номера = Новый Структура("ВерсияДанных, Номера", Строка.ВерсияДанных, Новый Массив);
			ПоДокументам.Вставить(Строка.Документ, Номера);
		КонецЕсли;
		Номера.Номера.Добавить(Строка.НомерСтроки);
	КонецЦикла;
	Для Каждого КлючИЗначение Из ПоДокументам Цикл
		Результат = НовыйРезультат();
		УдалитьСтрокиДокумента(Менеджер, КлючИЗначение.Ключ, КлючИЗначение.Значение, Результат);
		Если Не Результат.Успех Тогда
			Итог.Успех = Ложь;
		КонецЕсли;
		Если Не ПустаяСтрока(Результат.Текст) Тогда
			Итог.Текст = СоединитьТексты(Итог.Текст, СтрШаблон("%1: %2", КлючИЗначение.Ключ, Результат.Текст));
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Тексты сообщений пользователю, накопленные в вызове; сообщения забираются.
//
// Возвращаемое значение:
//  Строка - тексты через перенос строки.
//
Функция ТекстСообщений() Экспорт

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

// Параметры:
//  Первый - Строка - текст.
//  Второй - Строка - текст.
//
// Возвращаемое значение:
//  Строка - тексты через перенос строки; пустой не добавляется.
//
Функция СоединитьТексты(Первый, Второй) Экспорт

	Если ПустаяСтрока(Первый) Или ПустаяСтрока(Второй) Тогда
		Возврат Первый + Второй;
	КонецЕсли;
	Возврат Первый + Символы.ПС + Второй;

КонецФункции

// Возвращаемое значение:
//  Строка - отказ строки, данные которой не прошли проверку типов или изменились.
//
Функция ТекстНеверныеДанные() Экспорт

	Возврат НСтр("ru = 'Неверные данные строки: обновите таблицу.'; fr = 'Données de ligne incorrectes : actualisez le tableau.';
		|en = 'Invalid line data: refresh the table.'; es = 'Datos de línea incorrectos: actualice la tabla.'");

КонецФункции

// Возвращаемое значение:
//  Строка - отказ внешней роли и пользователю без права ввода документов.
//
Функция ТекстНетПраваВвода() Экспорт

	Возврат НСтр("ru = 'Нет права вводить строки этих документов.'; fr = 'Aucun droit de saisir les lignes de ces documents.';
		|en = 'No right to enter lines of these documents.'; es = 'Sin derecho a introducir líneas de estos documentos.'");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("Документ", Неопределено);
	Результат.Вставить("НомерСтроки", 0);
	Результат.Вставить("Конфликт", Ложь);
	Возврат Результат;

КонецФункции

// Параметры:
//  ИмяДокумента - Произвольный - имя документа от формы.
//
// Возвращаемое значение:
//  Строка - отказ: документ не из белого списка, внешняя роль или нет права ввода; пусто - можно.
//
Функция ТекстЗапретаВвода(ИмяДокумента)

	Если Не ДокументПоддерживается(ИмяДокумента) Тогда
		Возврат ТекстНеверныеДанные();
	ИначеЕсли ЕстьВнешняяРоль() Или Не Документы[ИмяДокумента].МожноВводитьСтрокиТоваров() Тогда
		Возврат ТекстНетПраваВвода();
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Проверка пакета строк до блокировок: документ, права, типы, один документ на пакет, новая строка - по одной,
// обязательные значения.
//
// Параметры:
//  ИмяДокумента - Строка - имя документа.
//  Строки       - Массив из Структура - см. ЗаписатьСтроки.
//
// Возвращаемое значение:
//  Строка - текст отказа; пустая строка - пакет можно записывать.
//
Функция ТекстЗапретаДанныхСтрок(ИмяДокумента, Строки)

	Текст = ТекстЗапретаВвода(ИмяДокумента);
	Если Не ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Если ТипЗнч(Строки) <> Тип("Массив") Или Строки.Количество() = 0 Тогда
		Возврат ТекстНеверныеДанные();
	КонецЕсли;
	Если Не ТипыСтрокиВерны(ИмяДокумента, Строки[0]) Тогда
		Возврат ТекстНеверныеДанные();
	КонецЕсли;
	Документ = Строки[0].Документ;
	Для Каждого Строка Из Строки Цикл
		// Пакет - строки одного записанного документа; новый документ - одна строка.
		ЧужаяСтрока = Не ТипыСтрокиВерны(ИмяДокумента, Строка) Или Строка.Документ <> Документ
			Или Не ЗначениеЗаполнено(Документ) И Строки.Количество() > 1;
		Если ЧужаяСтрока Тогда
			Возврат ТекстНеверныеДанные();
		КонецЕсли;
		Текст = ТекстЗапретаЗначенийСтроки(Строка);
		Если Не ПустаяСтрока(Текст) Тогда
			Возврат Текст;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Документ) И Не ЗначениеЗаполнено(Строки[0].Клиент) Тогда
		Возврат НСтр("ru = 'Выберите клиента.'; fr = 'Choisissez le client.'; en = 'Select the customer.'; es = 'Elija el cliente.'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Параметры:
//  ИмяДокумента - Строка - имя документа.
//  Строка       - Произвольный - строка удаления от клиента.
//
// Возвращаемое значение:
//  Булево - Истина, если это структура с записанным документом этого вида.
//
Функция ЗаписанныйДокументСтроки(ИмяДокумента, Строка)

	Документ = Неопределено;
	Если ТипЗнч(Строка) <> Тип("Структура") Или Не Строка.Свойство("Документ", Документ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не Строка.Свойство("НомерСтроки") Или Не Строка.Свойство("ВерсияДанных") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ТипЗнч(Документ) = Тип("ДокументСсылка." + ИмяДокумента) И ЗначениеЗаполнено(Документ);

КонецФункции

Функция ТипыСтрокиВерны(ИмяДокумента, Строка)

	Если ТипЗнч(Строка) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Типы = Новый Структура;
	ТипЧисло = Новый ОписаниеТипов("Число");
	Типы.Вставить("НомерСтроки", ТипЧисло);
	Типы.Вставить("ВерсияДанных", Новый ОписаниеТипов("Строка"));
	Типы.Вставить("Клиент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Типы.Вставить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Типы.Вставить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Типы.Вставить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Типы.Вставить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Типы.Вставить("КоличествоУпаковок", ТипЧисло);
	Типы.Вставить("Цена", ТипЧисло);
	Типы.Вставить("ЦенаИзменена", Новый ОписаниеТипов("Булево"));
	Типы.Вставить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Документ = Неопределено;
	Если Не Строка.Свойство("Документ", Документ)
		Или Документ <> Неопределено И ТипЗнч(Документ) <> Тип("ДокументСсылка." + ИмяДокумента) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Типы Цикл
		Значение = Неопределено;
		Если Не Строка.Свойство(КлючИЗначение.Ключ, Значение) Или Не КлючИЗначение.Значение.СодержитТип(ТипЗнч(Значение)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Строка.НомерСтроки >= 0 И Строка.Цена >= 0 И Цел(Строка.НомерСтроки) = Строка.НомерСтроки;

КонецФункции

Функция ТекстЗапретаЗначенийСтроки(Строка)

	Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
		Возврат НСтр("ru = 'Выберите товар.'; fr = 'Choisissez l''article.'; en = 'Select the item.'; es = 'Elija el artículo.'");
	ИначеЕсли Строка.КоличествоУпаковок <= 0 Тогда
		Возврат НСтр("ru = 'Количество должно быть больше нуля.'; fr = 'La quantité doit être supérieure à zéro.';
			|en = 'The quantity must be greater than zero.'; es = 'La cantidad debe ser mayor que cero.'");
	ИначеЕсли ЗначениеЗаполнено(Строка.Характеристика)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Характеристика, "Владелец") <> Строка.Номенклатура Тогда
		Возврат НСтр("ru = 'Характеристика не относится к товару.'; fr = 'La caractéristique n''appartient pas à l''article.';
			|en = 'The characteristic does not belong to the item.'; es = 'La característica no pertenece al artículo.'");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Новый документ по строке: шапка - функцией менеджера, строка, запись. Отказ записи - документ не создаётся (строка
// остаётся для правки).
//
// Параметры:
//  Менеджер  - ДокументМенеджер - менеджер документа.
//  Строка    - Структура - см. ЗаписатьСтроки.
//  Результат - Структура - см. НовыйРезультат.
//
Процедура ЗаписатьНовыйДокумент(Менеджер, Строка, Результат)

	ДокОбъект = Менеджер.СоздатьДокумент();
	Результат.Текст = Менеджер.ЗаполнитьНовыйДокументСтрокТоваров(ДокОбъект, Строка);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		Возврат;
	КонецЕсли;
	СтрокаТоваров = ПрименитьСтроку(Менеджер, ДокОбъект, Строка, Результат);
	Если СтрокаТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат.НомерСтроки = СтрокаТоваров.НомерСтроки;
	ЗаписатьДокумент(Менеджер, ДокОбъект, Истина, Результат);

КонецПроцедуры

// Версия документа, с которой прочитаны записанные строки пакета: у новых строк в записанный документ версии нет -
// пакет из одних новых строк версию не сверяет.
//
// Параметры:
//  Строки - Массив из Структура - см. ЗаписатьСтроки.
//
// Возвращаемое значение:
//  Строка, Неопределено - общая версия записанных строк; Неопределено - записанных строк нет. Строки разных версий
//  (форма сохранила старую правку и загрузила свежую строку того же документа) - версия, которая не совпадёт ни с
//  одной: весь пакет уходит в конфликт (ревью кода 2.0.17.40, P1).
//
Функция ВерсияПакета(Строки)

	Версия = Неопределено;
	Для Каждого Строка Из Строки Цикл
		Если Строка.НомерСтроки = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Версия = Неопределено Тогда
			Версия = Строка.ВерсияДанных;
		ИначеЕсли Версия <> Строка.ВерсияДанных Тогда
			Возврат "#" + Версия + "#" + Строка.ВерсияДанных;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Возврат Версия;

КонецФункции

// Блокирует документ пакета и сверяет версию данных и правила правки (функция менеджера).
//
// Параметры:
//  Менеджер     - ДокументМенеджер - менеджер документа.
//  Документ     - ДокументСсылка - документ.
//  ВерсияДанных - Строка, Неопределено - версия, прочитанная вместе со строками; Неопределено - только новые строки.
//  Результат    - Структура - см. НовыйРезультат, получает отказ.
//
// Возвращаемое значение:
//  ДокументОбъект, Неопределено - заблокированный объект; отказ - Неопределено.
//
Функция ЗаблокированныйДокумент(Менеджер, Документ, ВерсияДанных, Результат)

	ДокОбъект = Документ.ПолучитьОбъект();
	Если ДокОбъект = Неопределено Тогда
		Результат.Конфликт = Истина;
		Результат.Текст = ТекстДокументИзменен();
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ДокОбъект.Заблокировать();
	Исключение
		Результат.Текст = ТекстНеЗаписано(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	Если ВерсияДанных <> Неопределено И ДокОбъект.ВерсияДанных <> ВерсияДанных Тогда
		ДокОбъект.Разблокировать();
		Результат.Конфликт = Истина;
		Результат.Текст = ТекстДокументИзменен();
		Возврат Неопределено;
	КонецЕсли;
	Результат.Текст = Менеджер.ТекстЗапретаПравкиСтрокТоваров(ДокОбъект);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		ДокОбъект.Разблокировать();
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДокОбъект;

КонецФункции

// Переносит строку закладки в документ: новая строка - товар с ценой и ставкой НДС как в форме документа; записанная -
// поля ПоляПравкиЗаписаннойСтроки менеджера, смена упаковки или характеристики - цена заново. Ручная цена - при праве
// заверения цен.
//
// Параметры:
//  Менеджер  - ДокументМенеджер - менеджер документа.
//  ДокОбъект - ДокументОбъект - документ.
//  Строка    - Структура - см. ЗаписатьСтроки.
//  Результат - Структура - см. НовыйРезультат, получает отказ.
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти, Неопределено - строка товаров документа; отказ - Неопределено.
//
Функция ПрименитьСтроку(Менеджер, ДокОбъект, Строка, Результат)

	Упаковка = Строка.Упаковка;
	Если Не ЗначениеЗаполнено(Упаковка) Тогда
		Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Номенклатура, "Единица");
	КонецЕсли;
	НоваяСтрока = Строка.НомерСтроки = 0;
	Если НоваяСтрока Тогда
		СтрокаТоваров = ДокОбъект.ТЧТовары.Добавить();
		СтрокаТоваров.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ДокОбъект.ТЧТовары);
		СтрокаТоваров.Номенклатура = Строка.Номенклатура;
		СтрокаТоваров.ВидЦены = Менеджер.ВидЦеныНовойСтрокиТоваров(ДокОбъект);
		НужнаЦена = Истина;
	Иначе
		СтрокаТоваров = ЗаписаннаяСтрокаТоваров(Менеджер, ДокОбъект, Строка, Упаковка, Результат);
		Если СтрокаТоваров = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		НужнаЦена = СтрокаТоваров.Упаковка <> Упаковка Или СтрокаТоваров.Характеристика <> Строка.Характеристика;
	КонецЕсли;
	Накопленные = ТекстСообщений();
	СтрокаТоваров.Характеристика = Строка.Характеристика;
	СообщенияЦены = ЗаполнитьЦенуСтроки(ДокОбъект, СтрокаТоваров, Строка, Упаковка, НужнаЦена);
	Если Не ПустаяСтрока(СообщенияЦены) Тогда
		Шаблон = НСтр("ru = 'Цена не подставлена: %1'; fr = 'Prix non renseigné : %1'; en = 'Price not set: %1';
			|es = 'Precio no asignado: %1'");
		Результат.Текст = СоединитьТексты(Накопленные, СтрШаблон(Шаблон, СообщенияЦены));
		Возврат Неопределено;
	КонецЕсли;
	Если Не ПустаяСтрока(Накопленные) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Накопленные);
	КонецЕсли;
	Если НоваяСтрока Тогда
		Менеджер.ДополнитьНовуюСтрокуТоваров(ДокОбъект, СтрокаТоваров);
	КонецЕсли;
	Если Не ПрименитьРучнуюЦену(ДокОбъект, СтрокаТоваров, Строка, Результат) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СтрокаТоваров;

КонецФункции

// Данные номенклатуры, упаковка, количество и цена строки. Сообщения подстановки цены - отказ: без курса валюты прайса
// цена остаётся непересчитанной.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект - документ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка товаров.
//  Строка        - Структура - см. ЗаписатьСтроки.
//  Упаковка      - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка строки.
//  НужнаЦена     - Булево - цена подставляется заново.
//
// Возвращаемое значение:
//  Строка - сообщения подстановки цены; пустая строка - цена подставлена.
//
Функция ЗаполнитьЦенуСтроки(ДокОбъект, СтрокаТоваров, Строка, Упаковка, НужнаЦена)

	Если Строка.НомерСтроки = 0 Тогда
		// Та же функция, что у формы документа при выборе товара: ставка НДС и данные номенклатуры. Упаковкой она ставит
		// единицу товара - выбранная упаковка восстанавливается ниже.
		РаботаСДокументамиКлиентСервер.УстановитьПараметрыНоменклатуры(СтрокаТоваров, ДокОбъект);
	КонецЕсли;
	СтрокаТоваров.Упаковка = Упаковка;
	СтрокаТоваров.КоличествоУпаковок = Строка.КоличествоУпаковок;
	Если НужнаЦена Тогда
		// Как форма при смене упаковки: цена прайса за упаковку и количество в базовых единицах.
		РаботаСДокументамиКлиентСервер.УстановитьЦенуНоменклатуры(СтрокаТоваров, ДокОбъект);
	ИначеЕсли СтрокаТоваров.ЦенаSKU = 0 И СтрокаТоваров.Цена <> 0 Тогда
		// Только количество: цена упаковки прежняя. Историческая строка без цены базовой единицы - от цены, иначе расчёт
		// пересчитал бы цену из нулевой ЦенаSKU (как рабочее место производства).
		РассчитатьОтЦеныСоСкидкой(СтрокаТоваров, ДокОбъект.ЦенаВключаетНДС);
	Иначе
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ДокОбъект.ЦенаВключаетНДС);
	КонецЕсли;
	Возврат ТекстСообщений();

КонецФункции

// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//  Строка    - Структура - см. ЗаписатьСтроки.
//
// Возвращаемое значение:
//  Булево - записанная строка с теми же товаром, характеристикой, упаковкой и количеством, цена не вводилась.
//
Функция СтрокаБезИзменений(ДокОбъект, Строка)

	Если Строка.НомерСтроки = 0 Или Строка.НомерСтроки > ДокОбъект.ТЧТовары.Количество() Или Строка.ЦенаИзменена Тогда
		Возврат Ложь;
	КонецЕсли;
	СтрокаТоваров = ДокОбъект.ТЧТовары[Строка.НомерСтроки - 1];
	Возврат СтрокаТоваров.Номенклатура = Строка.Номенклатура И СтрокаТоваров.Характеристика = Строка.Характеристика
		И СтрокаТоваров.Упаковка = Строка.Упаковка И СтрокаТоваров.КоличествоУпаковок = Строка.КоличествоУпаковок;

КонецФункции

// Расчёт строки от цены упаковки с сохранением процента скидки, как ПрименитьДанныеСтрокиОтгрузки рабочего места
// производства: процент запоминается, скидка на цену считается от него, расчёт от цены, процент восстанавливается.
//
// Параметры:
//  СтрокаТоваров   - СтрокаТабличнойЧасти - строка товаров с ценой упаковки.
//  ЦенаВключаетНДС - Булево - режим НДС документа.
//
Процедура РассчитатьОтЦеныСоСкидкой(СтрокаТоваров, ЦенаВключаетНДС)

	ПроцентСкидки = СтрокаТоваров.ПроцентСкидки;
	СтрокаТоваров.СкидкаНаЦену = СтрокаТоваров.Цена / РаботаСДокументамиКлиентСервер.СтоПроцентов() * ПроцентСкидки;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ЦенаВключаетНДС, "Цена");
	СтрокаТоваров.ПроцентСкидки = ПроцентСкидки;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ЦенаВключаетНДС);

КонецПроцедуры

// Ручная цена строки - при праве заверения цен и в валюте, которую видел пользователь.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект - документ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка товаров.
//  Строка        - Структура - см. ЗаписатьСтроки.
//  Результат     - Структура - см. НовыйРезультат, получает отказ.
//
// Возвращаемое значение:
//  Булево - Ложь, если валюта цены не совпала с валютой документа.
//
Функция ПрименитьРучнуюЦену(ДокОбъект, СтрокаТоваров, Строка, Результат)

	Если Не Строка.ЦенаИзменена Или Не РегистрыСведений.НастройкиПользователей.ЗаверениеЦен() Тогда
		Возврат Истина;
	КонецЕсли;
	ВалютаДокумента = РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Валюта;
	Если Строка.Валюта <> ВалютаДокумента Тогда
		Шаблон = НСтр("ru = 'Валюта документа - %1: введите цену заново.'; fr = 'Devise du document : %1 : saisissez à nouveau le prix.';
			|en = 'The document currency is %1: enter the price again.'; es = 'La moneda del documento es %1: introduzca el precio de nuevo.'");
		Результат.Текст = СтрШаблон(Шаблон, ВалютаДокумента);
		Возврат Ложь;
	КонецЕсли;
	СтрокаТоваров.Цена = Строка.Цена;
	РассчитатьОтЦеныСоСкидкой(СтрокаТоваров, ДокОбъект.ЦенаВключаетНДС);
	Возврат Истина;

КонецФункции

// Записанная строка товаров документа по номеру: товар тот же, строка не запрещена менеджером, меняются только поля
// ПоляПравкиЗаписаннойСтроки.
//
// Параметры:
//  Менеджер  - ДокументМенеджер - менеджер документа.
//  ДокОбъект - ДокументОбъект - документ.
//  Строка    - Структура - см. ЗаписатьСтроки.
//  Упаковка  - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка строки закладки.
//  Результат - Структура - см. НовыйРезультат, получает отказ.
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти, Неопределено - строка; отказ - Неопределено.
//
Функция ЗаписаннаяСтрокаТоваров(Менеджер, ДокОбъект, Строка, Упаковка, Результат)

	СтрокаТоваров = Неопределено;
	Если Строка.НомерСтроки <= ДокОбъект.ТЧТовары.Количество() Тогда
		СтрокаТоваров = ДокОбъект.ТЧТовары[Строка.НомерСтроки - 1];
	КонецЕсли;
	Если СтрокаТоваров = Неопределено Или СтрокаТоваров.Номенклатура <> Строка.Номенклатура Тогда
		Результат.Конфликт = Истина;
		Результат.Текст = ТекстДокументИзменен();
		Возврат Неопределено;
	КонецЕсли;
	Результат.Текст = Менеджер.ТекстЗапретаСтрокиТоваров(СтрокаТоваров);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Поля = СтрРазделить(СтрЗаменить(Менеджер.ПоляПравкиЗаписаннойСтроки(), " ", ""), ",");
	НельзяМенять = Поля.Найти("Характеристика") = Неопределено И СтрокаТоваров.Характеристика <> Строка.Характеристика
		Или Поля.Найти("Упаковка") = Неопределено И СтрокаТоваров.Упаковка <> Упаковка
		Или Поля.Найти("Цена") = Неопределено И Строка.ЦенаИзменена;
	Если НельзяМенять Тогда
		Результат.Текст = НСтр("ru = 'У записанной строки меняется только количество: другую упаковку или характеристику введите
			|новой строкой.'; fr = 'Seule la quantité d''une ligne enregistrée se modifie : saisissez un autre conditionnement
			|ou une autre caractéristique sur une nouvelle ligne.'; en = 'Only the quantity of a saved line changes: enter another
			|package or characteristic as a new line.'; es = 'De una línea guardada solo cambia la cantidad: introduzca otro
			|embalaje u otra característica en una línea nueva.'");
		Возврат Неопределено;
	КонецЕсли;
	Возврат СтрокаТоваров;

КонецФункции

// Записывает документ в режиме функции менеджера. Отказ - исключение не выходит наружу, текст - в результате.
//
// Параметры:
//  Менеджер      - ДокументМенеджер - менеджер документа.
//  ДокОбъект     - ДокументОбъект - документ.
//  НовыйДокумент - Булево - документ создаётся этой записью.
//  Результат     - Структура - см. НовыйРезультат.
//
Процедура ЗаписатьДокумент(Менеджер, ДокОбъект, НовыйДокумент, Результат)

	Накопленные = ТекстСообщений();
	Если Не ДокОбъект.ПроверитьЗаполнение() Тогда
		Результат.Текст = ТекстНеЗаписано(СоединитьТексты(Накопленные, ТекстСообщений()));
		Возврат;
	КонецЕсли;
	Попытка
		ДокОбъект.Записать(Менеджер.РежимЗаписиСтрокТоваров(ДокОбъект, НовыйДокумент));
	Исключение
		Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщения = СоединитьТексты(ТекстСообщений(), Ошибка);
		Результат.Текст = ТекстНеЗаписано(СоединитьТексты(Накопленные, Сообщения));
		Возврат;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Документ = ДокОбъект.Ссылка;
	Результат.Текст = СоединитьТексты(Накопленные, ТекстСообщений());

КонецПроцедуры

// Удаляет строки одного документа под блокировкой; документ без строк помечается на удаление.
//
// Параметры:
//  Менеджер  - ДокументМенеджер - менеджер документа.
//  Документ  - ДокументСсылка - документ.
//  Данные    - Структура - ВерсияДанных (Строка), Номера (Массив из Число - номера строк товаров).
//  Результат - Структура - см. НовыйРезультат.
//
Процедура УдалитьСтрокиДокумента(Менеджер, Документ, Данные, Результат)

	ДокОбъект = ЗаблокированныйДокумент(Менеджер, Документ, Данные.ВерсияДанных, Результат);
	Если ДокОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Номера = НомераУдаляемыхСтрок(Менеджер, ДокОбъект, Данные.Номера, Результат);
	Если Номера = Неопределено Тогда
		ДокОбъект.Разблокировать();
		Возврат;
	КонецЕсли;
	Попытка
		Если Номера.Количество() = ДокОбъект.ТЧТовары.Количество() Тогда
			ПометитьДокумент(ДокОбъект, Результат);
		Иначе
			УпорядоченныеНомера = Новый СписокЗначений;
			УпорядоченныеНомера.ЗагрузитьЗначения(Номера);
			УпорядоченныеНомера.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
			Для Каждого Элемент Из УпорядоченныеНомера Цикл
				ДокОбъект.ТЧТовары.Удалить(Элемент.Значение - 1);
			КонецЦикла;
			ЗаписатьДокумент(Менеджер, ДокОбъект, Ложь, Результат);
		КонецЕсли;
	Исключение
		Результат.Успех = Ложь;
		Результат.Текст = ТекстНеЗаписано(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ДокОбъект.Разблокировать();

КонецПроцедуры

// Номера удаляемых строк без повторов; строка, запрещённая менеджером, удаляется только в форме документа.
//
// Параметры:
//  Менеджер  - ДокументМенеджер - менеджер документа.
//  ДокОбъект - ДокументОбъект - заблокированный документ.
//  Номера_   - Массив из Число - номера строк товаров от клиента.
//  Результат - Структура - см. НовыйРезультат, получает отказ.
//
// Возвращаемое значение:
//  Массив из Число, Неопределено - номера; отказ - Неопределено.
//
Функция НомераУдаляемыхСтрок(Менеджер, ДокОбъект, Номера_, Результат)

	Номера = Новый Массив;
	Если ТипЗнч(Номера_) <> Тип("Массив") Тогда
		Результат.Текст = ТекстНеверныеДанные();
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Номер Из Номера_ Цикл
		Если ТипЗнч(Номер) <> Тип("Число") Или Номер < 1 Или Номер > ДокОбъект.ТЧТовары.Количество() Тогда
			Результат.Конфликт = Истина;
			Результат.Текст = ТекстДокументИзменен();
			Возврат Неопределено;
		КонецЕсли;
		Результат.Текст = Менеджер.ТекстЗапретаСтрокиТоваров(ДокОбъект.ТЧТовары[Номер - 1]);
		Если Не ПустаяСтрока(Результат.Текст) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Номера.Найти(Номер) = Неопределено Тогда
			Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;
	Возврат Номера;

КонецФункции

// Пометка документа, у которого удаляются все строки: право интерактивной пометки, как у формы списка; строки остаются
// в помеченном документе. Объект не изменён - его платформа пометить даёт.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - заблокированный неизменённый документ.
//  Результат - Структура - см. НовыйРезультат.
//
Процедура ПометитьДокумент(ДокОбъект, Результат)

	Если Не ПравоДоступа("ИнтерактивнаяПометкаУдаления", ДокОбъект.Метаданные()) Тогда
		Результат.Текст = НСтр("ru = 'Нет права помечать документ на удаление: удалите строки в форме документа.';
			|fr = 'Aucun droit de marquer le document pour suppression : supprimez les lignes dans le document.';
			|en = 'No right to mark the document for deletion: delete the lines in the document form.';
			|es = 'Sin derecho a marcar el documento para eliminar: elimine las líneas en el documento.'");
		Возврат;
	КонецЕсли;
	Накопленные = ТекстСообщений();
	Попытка
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	Исключение
		Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщения = СоединитьТексты(ТекстСообщений(), Ошибка);
		Результат.Текст = ТекстНеЗаписано(СоединитьТексты(Накопленные, Сообщения));
		Возврат;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Документ = ДокОбъект.Ссылка;
	Результат.Текст = СоединитьТексты(Накопленные, ТекстСообщений());

КонецПроцедуры

Функция ТекстНеЗаписано(Причина)

	Возврат СтрШаблон(НСтр("ru = 'Не записано: %1'; fr = 'Non enregistré : %1'; en = 'Not saved: %1'; es = 'No guardado: %1'"),
		Причина);

КонецФункции

Функция ТекстДокументИзменен()

	Возврат НСтр("ru = 'Документ изменён другим пользователем: строки перечитаны, повторите правку.';
		|fr = 'Le document a été modifié par un autre utilisateur : lignes relues, recommencez la modification.';
		|en = 'The document was changed by another user: lines reloaded, repeat the change.';
		|es = 'Otro usuario modificó el documento: líneas releídas, repita el cambio.'");

КонецФункции

#КонецОбласти
