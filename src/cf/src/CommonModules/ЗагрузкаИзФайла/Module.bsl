// Универсальная загрузка табличных частей документов из файла (docs/plans/excel-import-universal.md).
//
// Порядок: ПрочитатьФайл -> ЗаголовкиКолонок / АвтоСопоставление -> ПреобразоватьСтроки (поиск ссылок пакетом,
// ошибки строк) -> ЗаполнитьТЧ (единственное заполнение для формы документа и записанного документа) или
// ЗагрузитьВДокумент (запись объекта под правами пользователя).

#Область ПрограммныйИнтерфейс

// Читает файл в табличный документ: xlsx, xls, ods - средствами платформы, csv и txt - разбором текста UTF-8.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла.
//  Расширение     - Строка - расширение файла (с точкой или без).
//
// Возвращаемое значение:
//  ТабличныйДокумент - содержимое; ошибка чтения - исключение с текстом причины.
//
Функция ПрочитатьФайл(ДвоичныеДанные, Знач Расширение) Экспорт
	МаксимумМегабайт = 20;
	БайтВМегабайте = 1048576;
	Если ДвоичныеДанные.Размер() > МаксимумМегабайт * БайтВМегабайте Тогда
		Шаблон = НСтр("ru = 'Файл больше %1 МБ: разделите его на части'; fr = 'Le fichier dépasse %1 Mo : divisez-le';
			|en = 'The file is larger than %1 MB: split it'; es = 'El archivo supera %1 MB: divídalo'");
		ВызватьИсключение СтрШаблон(Шаблон, МаксимумМегабайт);
	КонецЕсли;
	Расширение = НРег(СокрЛП(СтрЗаменить(Расширение, ".", "")));
	Если Расширение = "csv" Или Расширение = "txt" Тогда
		Текст = ТекстИзДвоичныхДанных(ДвоичныеДанные);
		Возврат ТабличныйДокументИзТекста(Текст);
	КонецЕсли;
	Если Расширение <> "xlsx" И Расширение <> "xls" И Расширение <> "ods" Тогда
		Шаблон = НСтр("ru = 'Формат файла «%1» не поддерживается: xlsx, xls, ods, csv, txt';
			|fr = 'Format de fichier « %1 » non pris en charge : xlsx, xls, ods, csv, txt';
			|en = 'File format ""%1"" is not supported: xlsx, xls, ods, csv, txt';
			|es = 'Formato de archivo «%1» no admitido: xlsx, xls, ods, csv, txt'");
		ВызватьИсключение СтрШаблон(Шаблон, Расширение);
	КонецЕсли;
	ИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ИмяФайла);
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Исключение
		Описание = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		УдалитьФайлы(ИмяФайла);
		Шаблон = НСтр("ru = 'Не удалось прочитать файл: %1'; fr = 'Lecture du fichier impossible : %1';
			|en = 'Cannot read the file: %1'; es = 'No se pudo leer el archivo: %1'");
		ВызватьИсключение СтрШаблон(Шаблон, Описание);
	КонецПопытки;
	УдалитьФайлы(ИмяФайла);
	Возврат ТабДок;
КонецФункции

// Заголовки колонок файла.
//
// Параметры:
//  ТабДок          - ТабличныйДокумент - содержимое файла.
//  СтрокаЗаголовка - Число - номер строки заголовка; 0 - заголовков нет (колонки называются номерами).
//
// Возвращаемое значение:
//  Массив из Структура - Номер (Число), Заголовок (Строка).
//
Функция ЗаголовкиКолонок(ТабДок, СтрокаЗаголовка) Экспорт
	Результат = Новый Массив;
	Шаблон = НСтр("ru = 'Колонка %1'; fr = 'Colonne %1'; en = 'Column %1'; es = 'Columna %1'");
	Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл
		Заголовок = "";
		Если СтрокаЗаголовка > 0 Тогда
			Заголовок = СокрЛП(ТабДок.Область(СтрокаЗаголовка, НомерКолонки).Текст);
		КонецЕсли;
		Если ПустаяСтрока(Заголовок) Тогда
			Заголовок = СтрШаблон(Шаблон, НомерКолонки);
		КонецЕсли;
		Результат.Добавить(Новый Структура("Номер, Заголовок", НомерКолонки, Заголовок));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Табличные части документа, в которые допускается загрузка.
//
// Параметры:
//  ИмяДокумента - Строка - имя документа в метаданных.
//
// Возвращаемое значение:
//  Массив из Строка - имена табличных частей.
//
Функция ПриемникиДокумента(ИмяДокумента) Экспорт
	Результат = Новый Массив;
	МД = Метаданные.Документы.Найти(ИмяДокумента);
	Если МД = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
		Если ОписаниеПриемника(ИмяДокумента, ТЧ.Имя).Допустим Тогда
			Результат.Добавить(ТЧ.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Описание приёмника загрузки: допустимость табличной части, класс расчёта строки и колонки для сопоставления.
//
// Параметры:
//  ИмяДокумента - Строка - имя документа.
//  ИмяТЧ        - Строка - имя табличной части.
//
// Возвращаемое значение:
//  Структура - Допустим (Булево), Причина (Строка), Класс ("Количество" или "Сумма"), ЕстьЦена (Булево: в строке
//              есть Цена и СтавкаНДС), Колонки (Массив из Структура: Имя, Представление, Тип - ОписаниеТипов),
//              ИменаКолонок (Соответствие имя -> Истина), Реквизиты (Соответствие всех реквизитов строки),
//              Постфиксы (Массив из Строка - постфиксы пар Количество<П> / КоличествоУпаковок<П>).
//
Функция ОписаниеПриемника(ИмяДокумента, ИмяТЧ) Экспорт
	Результат = НовоеОписаниеПриемника();
	МДТЧ = МетаданныеТЧ(ИмяДокумента, ИмяТЧ);
	Если МДТЧ = Неопределено Тогда
		Результат.Причина = НСтр("ru = 'Табличная часть не найдена'; fr = 'Partie tabulaire introuvable';
			|en = 'Tabular section not found'; es = 'Sección tabular no encontrada'");
		Возврат Результат;
	КонецЕсли;
	Результат.Причина = ПричинаИсключения(ИмяДокумента, ИмяТЧ);
	Если Не ПустаяСтрока(Результат.Причина) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Реквизит Из МДТЧ.Реквизиты Цикл
		Результат.Реквизиты.Вставить(Реквизит.Имя, Реквизит);
	КонецЦикла;
	Результат.Класс = КлассПриемника(Результат.Реквизиты);
	Результат.Причина = ПричинаПоРеквизитам(МДТЧ, Результат);
	Если Не ПустаяСтрока(Результат.Причина) Тогда
		Возврат Результат;
	КонецЕсли;
	Реквизиты = Результат.Реквизиты;
	Результат.ЕстьЦена = Реквизиты[ИмяЦена()] <> Неопределено И Реквизиты[ИмяСтавкаНДС()] <> Неопределено;
	ЗаполнитьКолонкиПриемника(МДТЧ, Результат);
	Результат.Допустим = Истина;
	Возврат Результат;
КонецФункции

// Сопоставление колонок файла реквизитам приёмника по заголовкам: имя, синоним или слово словаря заголовков на любом
// языке конфигурации, без учёта регистра, пробелов и знаков препинания.
//
// Параметры:
//  Колонки   - Массив из Структура - см. ОписаниеПриемника, Колонки (нужны Имя и Представление).
//  Заголовки - Массив из Структура - см. ЗаголовкиКолонок.
//
// Возвращаемое значение:
//  Соответствие - имя реквизита -> номер колонки файла.
//
Функция АвтоСопоставление(Колонки, Заголовки) Экспорт
	Результат = Новый Соответствие;
	Занятые = Новый Соответствие;
	Словарь = СловарьЗаголовков();
	Для Каждого Колонка Из Колонки Цикл
		Варианты = ВариантыЗаголовка(Колонка, Словарь);
		Для Каждого Заголовок Из Заголовки Цикл
			Ключ = КлючЗаголовка(Заголовок.Заголовок);
			Если Занятые[Заголовок.Номер] = Неопределено И Варианты[Ключ] <> Неопределено Тогда
				Результат.Вставить(Колонка.Имя, Заголовок.Номер);
				Занятые.Вставить(Заголовок.Номер, Истина);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Новые параметры преобразования строк файла.
//
// Возвращаемое значение:
//  Структура - ИмяДокумента, ИмяТЧ, ПерваяСтрока (Число), Колонки (Соответствие имя реквизита -> номер колонки),
//              ПорядокПоиска (Массив из Строка: Штрихкод, Артикул, КодПоставщика, Код, Наименование),
//              СоздаватьТовары (Булево), ПоляСоздания (Соответствие поле -> номер колонки: Наименование, Артикул,
//              Штрихкод, КодПоставщика, Группа, Бренд), ГруппаНовыхТоваров, Создавать (Булево: Ложь - только
//              проверка, товары не создаются).
//
Функция НовыеПараметрыПреобразования() Экспорт
	ПерваяСтрока = 2;
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяДокумента", "");
	Параметры.Вставить("ИмяТЧ", "");
	Параметры.Вставить("ПерваяСтрока", ПерваяСтрока);
	Параметры.Вставить("Колонки", Новый Соответствие);
	Параметры.Вставить("ПорядокПоиска", ПорядокПоискаПоУмолчанию());
	Параметры.Вставить("СоздаватьТовары", Ложь);
	Параметры.Вставить("ПоляСоздания", Новый Соответствие);
	Параметры.Вставить("ГруппаНовыхТоваров", Справочники.Номенклатура.ПустаяСсылка());
	Параметры.Вставить("Создавать", Ложь);
	Возврат Параметры;
КонецФункции

// Правила поиска номенклатуры по умолчанию, в порядке применения.
//
// Возвращаемое значение:
//  Массив из Строка - Штрихкод, Артикул, КодПоставщика, Код, Наименование.
//
Функция ПорядокПоискаПоУмолчанию() Экспорт
	Возврат СтрРазделить("Штрихкод,Артикул,КодПоставщика,Код,Наименование", ",");
КонецФункции

// Преобразует строки файла в значения реквизитов приёмника: числа, даты, булевы, перечисления и ссылки (пакетом
// запросов по колонке). Строка с ошибкой в загрузку не идёт и попадает в Ошибки.
//
// Параметры:
//  ТабДок    - ТабличныйДокумент - содержимое файла.
//  Параметры - Структура - см. НовыеПараметрыПреобразования.
//
// Возвращаемое значение:
//  Структура - Строки (Массив из Структура - значения сопоставленных и полученных из штрихкода реквизитов),
//              НомераСтрок (Массив из Число - номер строки файла для каждой из Строки), Сопоставлено (Массив из
//              Строка), Ошибки (Массив из Структура: НомерСтроки, Текст), Создается (Массив из Число - строки, для
//              которых будет создан товар), ВсегоСтрок (Число).
//
Функция ПреобразоватьСтроки(ТабДок, Параметры) Экспорт
	Описание = ОписаниеПриемника(Параметры.ИмяДокумента, Параметры.ИмяТЧ);
	ПроверитьПараметрыПреобразования(Описание, Параметры);
	Сырые = СырыеСтроки(ТабДок, Параметры);
	Если Сырые.Количество() > МаксимумСтрок() Тогда
		Шаблон = НСтр("ru = 'В файле больше %1 строк: разделите его на части';
			|fr = 'Le fichier contient plus de %1 lignes : divisez-le';
			|en = 'The file has more than %1 rows: split it';
			|es = 'El archivo tiene más de %1 filas: divídalo'");
		ВызватьИсключение СтрШаблон(Шаблон, МаксимумСтрок());
	КонецЕсли;
	Разбор = НовыйРазбор(Сырые, Описание);
	НайтиНоменклатуруСтрок(Разбор, Параметры);
	Для Каждого КлючИЗначение Из Параметры.Колонки Цикл
		Имя = КлючИЗначение.Ключ;
		Если Имя = ИмяНоменклатура() Тогда
			Продолжить;
		КонецЕсли;
		Разбор.Сопоставлено.Вставить(Имя, Истина);
		Если Имя = ИмяХарактеристика() Или Имя = ИмяСерия() Тогда
			РазрешитьПодчиненные(Разбор, Имя);
		Иначе
			РазрешитьКолонку(Разбор, Имя);
		КонецЕсли;
	КонецЦикла;
	Если Параметры.Создавать Тогда
		СоздатьТоварыСтрок(Разбор, Параметры);
	КонецЕсли;
	Возврат РезультатРазбора(Разбор);
КонецФункции

// Заполняет табличную часть документа загруженными строками - единственное заполнение для формы документа
// (данные формы в серверном вызове) и для записанного документа (объект). Расчёт идёт в копии табличной части;
// табличная часть меняется только если все строки рассчитаны без ошибок.
//
// Параметры:
//  Объект       - ДокументОбъект, ДанныеФормыСтруктура - документ.
//  ИмяДокумента - Строка - имя документа (у данных формы нет метода Метаданные).
//  ИмяТЧ        - Строка - имя табличной части.
//  Загрузка     - Структура - Строки (Массив из Структура), Сопоставлено (Массив из Строка), Заменить (Булево),
//                 необязательно ВидЦены (вид цены формы документа для строк без колонки вида цены).
//
// Возвращаемое значение:
//  Строка - текст ошибок; пусто - табличная часть заполнена.
//
Функция ЗаполнитьТЧ(Объект, ИмяДокумента, ИмяТЧ, Загрузка) Экспорт
	Описание = ОписаниеПриемника(ИмяДокумента, ИмяТЧ);
	Если Не Описание.Допустим Тогда
		Возврат Описание.Причина;
	КонецЕсли;
	ТекстОшибки = ОшибкаПроведения(Объект, ИмяДокумента);
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = ОшибкаСопоставления(Описание, Загрузка);
	КонецЕсли;
	Если ПустаяСтрока(ТекстОшибки) И Загрузка.Заменить Тогда
		ТекстОшибки = ОшибкаПодчиненныхСтрок(Объект, ИмяДокумента, ИмяТЧ);
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	Таблица = Объект[ИмяТЧ].Выгрузить();
	СледующийКод = СледующийКодСтроки(Таблица, Описание);
	Если Загрузка.Заменить Тогда
		Таблица.Очистить();
	КонецЕсли;
	Контекст = КонтекстЗаполнения(Объект, ИмяДокумента, Описание, Загрузка);
	Ошибки = Новый Массив;
	Шаблон = НСтр("ru = 'Строка %1: %2'; fr = 'Ligne %1 : %2'; en = 'Row %1: %2'; es = 'Fila %1: %2'");
	ЕстьКодСтроки = Описание.Реквизиты["КодСтроки"] <> Неопределено;
	НомерСтроки = 0;
	Для Каждого Данные Из Загрузка.Строки Цикл
		НомерСтроки = НомерСтроки + 1;
		Стр = Таблица.Добавить();
		ТекстОшибки = ЗаполнитьСтроку(Стр, Данные, Контекст);
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			Ошибки.Добавить(СтрШаблон(Шаблон, НомерСтроки, ТекстОшибки));
		ИначеЕсли ЕстьКодСтроки Тогда
			Стр.КодСтроки = СледующийКод;
			СледующийКод = СледующийКод + 1;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		Возврат СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	Объект[ИмяТЧ].Загрузить(Таблица);
	Возврат "";
КонецФункции

// Загружает строки в записанный документ: расчёт - до транзакции на прочитанном объекте, в транзакции - блокировка,
// сверка версии, перенос рассчитанной табличной части, проверка заполнения и обычная запись под правами пользователя.
//
// Параметры:
//  Ссылка   - ДокументСсылка - документ.
//  ИмяТЧ    - Строка - табличная часть.
//  Загрузка - Структура - см. ЗаполнитьТЧ.
//
// Возвращаемое значение:
//  Строка - текст ошибки; пусто - загружено.
//
Функция ЗагрузитьВДокумент(Ссылка, ИмяТЧ, Загрузка) Экспорт
	МД = Ссылка.Метаданные();
	ТекстОшибки = ОшибкаЗагрузкиВДокумент(Ссылка);
	Объект = Ссылка.ПолучитьОбъект();
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = ЗаполнитьТЧ(Объект, МД.Имя, ИмяТЧ, Загрузка);
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	Таблица = Объект[ИмяТЧ].Выгрузить();
	Версия = Объект.ВерсияДанных;
	НачатьТранзакцию();
	Попытка
		ЗаписатьЗагрузку(Ссылка, ИмяТЧ, Таблица, Версия);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";
КонецФункции

// Можно ли загружать в записанный документ: право изменения, не проведён, не помечен на удаление, редактирование
// не запрещено, при замене - нет связанных строк. Вызывается до разбора файла, чтобы не создавать товары для
// загрузки, которая будет отклонена.
//
// Параметры:
//  Ссылка   - ДокументСсылка - документ.
//  ИмяТЧ    - Строка - табличная часть (для проверки связанных строк при замене).
//  Заменить - Булево - строки заменяются.
//
// Возвращаемое значение:
//  Строка - ошибка; пусто - загружать можно.
//
Функция ОшибкаЗагрузкиВДокумент(Ссылка, ИмяТЧ = "", Заменить = Ложь) Экспорт
	МД = Ссылка.Метаданные();
	Если Не ПравоДоступа("Изменение", МД) Тогда
		Возврат НСтр("ru = 'Нет права на изменение документа'; fr = 'Pas de droit de modifier le document';
			|en = 'No right to change the document'; es = 'Sin derecho a modificar el documento'");
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	ТекстОшибки = ОшибкаСостоянияДокумента(Объект, МД);
	Если ПустаяСтрока(ТекстОшибки) И Заменить Тогда
		ТекстОшибки = ОшибкаПодчиненныхСтрок(Объект, МД.Имя, ИмяТЧ);
	КонецЕсли;
	Возврат ТекстОшибки;
КонецФункции

// Подчинённые табличные части: строки ссылаются на строки другой табличной части того же документа. Ключ -
// «Документ.ТЧ» или «*.ТЧ» (любой документ), значение - имя главной табличной части.
//
// Возвращаемое значение:
//  Соответствие - ключ -> имя главной ТЧ.
//
Функция ПодчиненныеТЧ() Экспорт
	Результат = Новый Соответствие;
	Результат.Вставить("*.ТЧСерии", "ТЧТовары");
	Результат.Вставить("ЗаказПокупателя.ТЧМатериалы", "ТЧТовары");
	Возврат Результат;
КонецФункции

// Связи строк с внешними документами и строками главной ТЧ (реквизиты КодСтроки<Суффикс>): из файла не загружаются,
// решение по каждой связи принято (тест сверяет, что новых связей без решения нет).
//
// Возвращаемое значение:
//  Соответствие - имя реквизита -> Истина.
//
Функция ВнешниеСвязиСтрок() Экспорт
	Результат = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("КодСтрокиПотребности,КодСтрокиЗаказа,КодСтрокиПродукции,КодСтрокиРодителя", ",") Цикл
		Результат.Вставить(Имя, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Служебные колонки строк, которые не загружаются из файла.
//
// Возвращаемое значение:
//  Соответствие - имя реквизита -> Истина.
//
Функция СлужебныеКолонки() Экспорт
	Результат = Новый Соответствие;
	Имена = "УказаноНесколькоСерий,СуммаНДС,СуммаСНДС,ПроцентСкидки,СуммаСкидки,СкидкаНаЦену,"
		+ "ДоляСтоимости,ЦенаЗакупкиПоследняя,ПроцентНаценкиНаЦену";
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Результат.Вставить(Имя, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Направление подбора цены по умолчанию.
//
// Параметры:
//  ИмяДокумента - Строка - имя документа.
//
// Возвращаемое значение:
//  Структура - Закупка (Булево), РеквизитПоставщика (Строка; пусто у закупки без поставщика).
//
Функция НаправлениеЦены(ИмяДокумента) Экспорт
	Закупки = Новый Соответствие;
	Имена = "ПоступлениеТоваровУслуг,НалоговаяНакладнаяПокупка,ЗаказПоставщику,ВозвратПоставщику,ВозвратПоставщикуНалоговый";
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Закупки.Вставить(Имя, "Контрагент");
	КонецЦикла;
	Закупки.Вставить("ПредложениеПоставщика", ИмяПоставщик());
	Закупки.Вставить("ОприходованиеТоваров", "");
	Реквизит = Закупки[ИмяДокумента];
	Результат = Новый Структура("Закупка, РеквизитПоставщика", Реквизит <> Неопределено, "");
	Если Реквизит <> Неопределено Тогда
		Результат.РеквизитПоставщика = Реквизит;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Поиск номенклатуры по текстам: по каждому правилу - один запрос по ещё не найденным значениям. Одно совпадение -
// найдено; несколько - ошибка «неоднозначно», следующие правила для значения не применяются.
//
// Параметры:
//  Тексты        - Массив из Строка - искомые значения.
//  ПорядокПоиска - Массив из Строка - правила (см. ПорядокПоискаПоУмолчанию).
//
// Возвращаемое значение:
//  Соответствие - текст -> Структура (см. НоваяНайденная); не найденных нет в соответствии.
//
Функция НайтиНоменклатуру(Тексты, ПорядокПоиска) Экспорт
	Результат = Новый Соответствие;
	Осталось = Новый Массив;
	Для Каждого Текст Из Тексты Цикл
		Осталось.Добавить(Текст);
	КонецЦикла;
	Для Каждого Правило Из ПорядокПоиска Цикл
		Если Осталось.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Совпадения = СовпаденияНоменклатуры(Правило, Осталось);
		Если Совпадения <> Неопределено Тогда
			Осталось = РазобратьСовпадения(Совпадения, Осталось, Правило, Результат);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Число, дата, булево или строка из текста ячейки.
//
// Параметры:
//  Текст        - Строка - текст ячейки.
//  Тип          - Тип - тип реквизита.
//  ОписаниеТипа - ОписаниеТипов - квалификаторы.
//  Ошибка       - Строка - текст ошибки (выходной).
//
// Возвращаемое значение:
//  Произвольный - значение.
//
Функция ПримитивноеЗначение(Текст, Тип, ОписаниеТипа, Ошибка) Экспорт
	Если Тип = Тип("Число") Тогда
		Значение = ЧислоИзТекста(Текст, Ошибка);
	ИначеЕсли Тип = Тип("Дата") Тогда
		Значение = ДатаИзТекста(Текст, Ошибка);
	ИначеЕсли Тип = Тип("Булево") Тогда
		Значение = БулевоИзТекста(Текст, Ошибка);
	Иначе
		Значение = Текст;
		Длина = ОписаниеТипа.КвалификаторыСтроки.Длина;
		Если Длина > 0 И СтрДлина(Текст) > Длина Тогда
			Шаблон = НСтр("ru = 'длиннее %1 символов'; fr = 'plus de %1 caractères'; en = 'longer than %1 characters';
				|es = 'más de %1 caracteres'");
			Ошибка = СтрШаблон(Шаблон, Длина);
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(Ошибка) Тогда
		Возврат Значение;
	КонецЕсли;
	Приведенное = ОписаниеТипа.ПривестиЗначение(Значение);
	Если Тип = Тип("Число") И Приведенное <> Значение Тогда
		Шаблон = НСтр("ru = 'число %1 не помещается в реквизит'; fr = 'le nombre %1 ne tient pas dans l''attribut';
			|en = 'number %1 does not fit the attribute'; es = 'el número %1 no cabe en el atributo'");
		Ошибка = СтрШаблон(Шаблон, Текст);
	КонецЕсли;
	Возврат Приведенное;
КонецФункции

