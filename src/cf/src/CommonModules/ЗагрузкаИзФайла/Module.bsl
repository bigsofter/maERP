Функция МаксимумСтрок()
	Максимум = 10000;
	Возврат Максимум;
КонецФункции

// Текст файла в UTF-8 без метки порядка байтов.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла.
//
// Возвращаемое значение:
//  Строка - текст.
//
Функция ТекстИзДвоичныхДанных(ДвоичныеДанные)
	КодМетки = 65279;
	Метка = Символ(КодМетки);
	Текст = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	Если СтрНачинаетсяС(Текст, Метка) Тогда
		Текст = Сред(Текст, СтрДлина(Метка) + 1);
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Табличный документ из текста с разделителями: разделитель - самый частый из «;», табуляции и «,» в первой строке
// (вне кавычек); кавычки - по RFC 4180.
//
// Параметры:
//  Текст - Строка - текст файла.
//
// Возвращаемое значение:
//  ТабличныйДокумент - ячейки с текстами значений.
//
Функция ТабличныйДокументИзТекста(Текст)
	Разбор = Новый Структура("ТабДок, Строка, Колонка", Новый ТабличныйДокумент, 1, 1);
	Разбор.Вставить("Значение", "");
	Разбор.Вставить("ВКавычках", Ложь);
	Разделитель = РазделительТекста(Текст);
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Знак = Сред(Текст, Позиция, 1);
		Следующий = Сред(Текст, Позиция + 1, 1);
		Если Разбор.ВКавычках Тогда
			Позиция = Позиция + ЗнакВКавычках(Разбор, Знак, Следующий);
		Иначе
			Позиция = Позиция + ЗнакВнеКавычек(Разбор, Знак, Следующий, Разделитель);
		КонецЕсли;
		ПроверитьПределыТекста(Разбор);
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Разбор.Колонка > 1 Или Не ПустаяСтрока(Разбор.Значение) Тогда
		Разбор.ТабДок.Область(Разбор.Строка, Разбор.Колонка).Текст = Разбор.Значение;
	КонецЕсли;
	Возврат Разбор.ТабДок;
КонецФункции

// Пределы разбора текста: длина значения, число строк и колонок; превышение - исключение сразу, без разбора остатка.
//
// Параметры:
//  Разбор - Структура - состояние разбора (см. ТабличныйДокументИзТекста).
//
Процедура ПроверитьПределыТекста(Разбор)
	МаксимумДлины = 10000;
	МаксимумКолонок = 500;
	Если СтрДлина(Разбор.Значение) > МаксимумДлины Или Разбор.Колонка > МаксимумКолонок
		Или Разбор.Строка > МаксимумСтрок() + 1 Тогда
		ВызватьИсключение НСтр("ru = 'Файл превышает пределы загрузки (строк, колонок или длины значения)';
			|fr = 'Le fichier dépasse les limites d''import (lignes, colonnes ou longueur de valeur)';
			|en = 'The file exceeds import limits (rows, columns or value length)';
			|es = 'El archivo supera los límites de carga (filas, columnas o longitud del valor)'");
	КонецЕсли;
КонецПроцедуры

// Знак внутри кавычек: удвоенная кавычка - сама кавычка, одиночная - конец кавычек.
//
// Параметры:
//  Разбор    - Структура - состояние разбора (см. ТабличныйДокументИзТекста).
//  Знак      - Строка - текущий знак.
//  Следующий - Строка - следующий знак.
//
// Возвращаемое значение:
//  Число - сколько знаков пропустить дополнительно.
//
Функция ЗнакВКавычках(Разбор, Знак, Следующий)
	Если Знак <> """" Тогда
		Разбор.Значение = Разбор.Значение + Знак;
		Возврат 0;
	КонецЕсли;
	Если Следующий = """" Тогда
		Разбор.Значение = Разбор.Значение + """";
		Возврат 1;
	КонецЕсли;
	Разбор.ВКавычках = Ложь;
	Возврат 0;
КонецФункции

// Знак вне кавычек: кавычка открывает значение, разделитель закрывает ячейку, перевод строки - строку.
//
// Параметры:
//  Разбор      - Структура - состояние разбора (см. ТабличныйДокументИзТекста).
//  Знак        - Строка - текущий знак.
//  Следующий   - Строка - следующий знак.
//  Разделитель - Строка - разделитель значений.
//
// Возвращаемое значение:
//  Число - сколько знаков пропустить дополнительно.
//
Функция ЗнакВнеКавычек(Разбор, Знак, Следующий, Разделитель)
	Пропустить = 0;
	Если Знак = """" Тогда
		Разбор.ВКавычках = Истина;
	ИначеЕсли Знак = Разделитель Тогда
		Разбор.ТабДок.Область(Разбор.Строка, Разбор.Колонка).Текст = Разбор.Значение;
		Разбор.Колонка = Разбор.Колонка + 1;
		Разбор.Значение = "";
	ИначеЕсли Знак = Символы.ПС Или Знак = Символы.ВК Тогда
		Если Знак = Символы.ВК И Следующий = Символы.ПС Тогда
			Пропустить = 1;
		КонецЕсли;
		Разбор.ТабДок.Область(Разбор.Строка, Разбор.Колонка).Текст = Разбор.Значение;
		Разбор.Строка = Разбор.Строка + 1;
		Разбор.Колонка = 1;
		Разбор.Значение = "";
	Иначе
		Разбор.Значение = Разбор.Значение + Знак;
	КонецЕсли;
	Возврат Пропустить;
КонецФункции

// Разделитель значений: самый частый в первой строке вне кавычек; по умолчанию «;».
//
// Параметры:
//  Текст - Строка - текст файла.
//
// Возвращаемое значение:
//  Строка - разделитель.
//
Функция РазделительТекста(Текст)
	Конец = СтрНайти(Текст, Символы.ПС);
	ПерваяСтрока = ?(Конец = 0, Текст, Лев(Текст, Конец - 1));
	Счетчики = Новый Соответствие;
	Кандидаты = СтрРазделить(";|" + Символы.Таб + "|,", "|");
	Для Каждого Кандидат Из Кандидаты Цикл
		Счетчики.Вставить(Кандидат, 0);
	КонецЦикла;
	ВКавычках = Ложь;
	Для Позиция = 1 По СтрДлина(ПерваяСтрока) Цикл
		Знак = Сред(ПерваяСтрока, Позиция, 1);
		Если Знак = """" Тогда
			ВКавычках = Не ВКавычках;
		ИначеЕсли Не ВКавычках И Счетчики[Знак] <> Неопределено Тогда
			Счетчики.Вставить(Знак, Счетчики[Знак] + 1);
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Результат = ";";
	Лучший = 0;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Счетчики[Кандидат] > Лучший Тогда
			Лучший = Счетчики[Кандидат];
			Результат = Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Строки файла с данными: пустые строки (все сопоставленные колонки пусты) пропускаются.
//
// Параметры:
//  ТабДок    - ТабличныйДокумент - содержимое файла.
//  Параметры - Структура - см. НовыеПараметрыПреобразования.
//
// Возвращаемое значение:
//  ТаблицаЗначений - НомерСтроки и тексты сопоставленных колонок (поля создания - с префиксом «Создание_»).
//
Функция СырыеСтроки(ТабДок, Параметры)
	Сырые = Новый ТаблицаЗначений;
	Сырые.Колонки.Добавить("НомерСтроки");
	Колонки = Новый Соответствие;
	Для Каждого КлючИЗначение Из Параметры.Колонки Цикл
		Колонки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Для Каждого КлючИЗначение Из Параметры.ПоляСоздания Цикл
		Колонки.Вставить("Создание_" + КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Для Каждого КлючИЗначение Из Колонки Цикл
		Сырые.Колонки.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Для НомерСтроки = Макс(Параметры.ПерваяСтрока, 1) По ТабДок.ВысотаТаблицы Цикл
		Строка = Сырые.Добавить();
		Строка.НомерСтроки = НомерСтроки;
		Пустая = Истина;
		Для Каждого КлючИЗначение Из Колонки Цикл
			Текст = ТабДок.Область(НомерСтроки, КлючИЗначение.Значение).Текст;
			Текст = СокрЛП(СтрЗаменить(Текст, Символы.НПП, " "));
			Строка[КлючИЗначение.Ключ] = Текст;
			Пустая = Пустая И ПустаяСтрока(Текст);
		КонецЦикла;
		Если Пустая Тогда
			Сырые.Удалить(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат Сырые;
КонецФункции

#КонецОбласти

#Область ОписаниеПриемника

Функция НовоеОписаниеПриемника()
	Результат = Новый Структура("Допустим, Причина, Класс", Ложь, "", "");
	Результат.Вставить("ЕстьЦена", Ложь);
	Результат.Вставить("Колонки", Новый Массив);
	Результат.Вставить("ИменаКолонок", Новый Соответствие);
	Результат.Вставить("Реквизиты", Новый Соответствие);
	Результат.Вставить("Постфиксы", Новый Массив);
	Возврат Результат;
КонецФункции

// Метаданные табличной части документа.
//
// Параметры:
//  ИмяДокумента - Строка - имя документа.
//  ИмяТЧ        - Строка - имя табличной части.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - табличная часть; Неопределено - нет такой.
//
Функция МетаданныеТЧ(ИмяДокумента, ИмяТЧ)
	МД = Метаданные.Документы.Найти(ИмяДокумента);
	Если МД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат МД.ТабличныеЧасти.Найти(ИмяТЧ);
КонецФункции

// Причина исключения приёмника по перечню и карте подчинённых табличных частей.
//
// Параметры:
//  ИмяДокумента - Строка - имя документа.
//  ИмяТЧ        - Строка - имя табличной части.
//
// Возвращаемое значение:
//  Строка - причина; пусто - не исключён.
//
Функция ПричинаИсключения(ИмяДокумента, ИмяТЧ)
	Исключенные = ИсключенныеПриемники();
	Причина = Исключенные[ИмяДокумента];
	Если Причина = Неопределено Тогда
		Причина = Исключенные[ИмяДокумента + "." + ИмяТЧ];
	КонецЕсли;
	Если Причина = Неопределено И ЭтоПодчиненнаяТЧ(ИмяДокумента, ИмяТЧ) Тогда
		Причина = НСтр("ru = 'Строки связаны со строками другой табличной части документа';
			|fr = 'Les lignes sont liées aux lignes d''une autre partie tabulaire du document';
			|en = 'Rows are linked to rows of another tabular section of the document';
			|es = 'Las filas están vinculadas a filas de otra sección tabular del documento'");
	КонецЕсли;
	Возврат ?(Причина = Неопределено, "", Причина);
КонецФункции

// Класс расчёта строки: количественный (есть Количество) или суммовой (Сумма и СтавкаНДС без количества).
//
// Параметры:
//  Реквизиты - Соответствие - реквизиты строки.
//
// Возвращаемое значение:
//  Строка - "Количество", "Сумма" или пусто.
//
Функция КлассПриемника(Реквизиты)
	Если Реквизиты[ИмяКоличество()] <> Неопределено Тогда
		Возврат ИмяКоличество();
	ИначеЕсли Реквизиты[ИмяСумма()] <> Неопределено И Реквизиты[ИмяСтавкаНДС()] <> Неопределено Тогда
		Возврат ИмяСумма();
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

// Причина недопустимости по реквизитам строки: нет номенклатуры, нет класса расчёта, реквизит подчинён номенклатуре.
//
// Параметры:
//  МДТЧ     - ОбъектМетаданных - табличная часть.
//  Описание - Структура - см. ОписаниеПриемника.
//
// Возвращаемое значение:
//  Строка - причина; пусто - допустима.
//
Функция ПричинаПоРеквизитам(МДТЧ, Описание)
	Если Описание.Реквизиты[ИмяНоменклатура()] = Неопределено Тогда
		Возврат НСтр("ru = 'В строках нет номенклатуры'; fr = 'Pas d''article dans les lignes';
			|en = 'Rows have no item'; es = 'Las filas no tienen artículo'");
	КонецЕсли;
	Если ПустаяСтрока(Описание.Класс) Тогда
		Возврат НСтр("ru = 'В строках нет количества или суммы со ставкой НДС';
			|fr = 'Les lignes n''ont ni quantité ni montant avec taux de TVA';
			|en = 'Rows have neither quantity nor amount with VAT rate';
			|es = 'Las filas no tienen cantidad ni importe con tipo de IVA'");
	КонецЕсли;
	Возврат ПричинаПодчиненныхНоменклатуре(МДТЧ);
КонецФункции

// Колонки для сопоставления и постфиксы пар количеств.
//
// Параметры:
//  МДТЧ     - ОбъектМетаданных - табличная часть.
//  Описание - Структура - см. ОписаниеПриемника; заполняются Колонки, ИменаКолонок, Постфиксы.
//
Процедура ЗаполнитьКолонкиПриемника(МДТЧ, Описание)
	ИмяУпаковок = ИмяКоличествоУпаковок();
	Для Каждого Реквизит Из МДТЧ.Реквизиты Цикл
		Если КолонкаЗагружается(Реквизит) Тогда
			Колонка = Новый Структура("Имя, Представление, Тип", Реквизит.Имя, Реквизит.Представление(), Реквизит.Тип);
			Описание.Колонки.Добавить(Колонка);
			Описание.ИменаКолонок.Вставить(Реквизит.Имя, Истина);
		КонецЕсли;
		Если СтрНачинаетсяС(Реквизит.Имя, ИмяУпаковок) Тогда
			Постфикс = Сред(Реквизит.Имя, СтрДлина(ИмяУпаковок) + 1);
			Если Описание.Реквизиты[ИмяКоличество() + Постфикс] <> Неопределено Тогда
				Описание.Постфиксы.Добавить(Постфикс);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Документы и табличные части, не принимающие загрузку, с причиной.
//
// Возвращаемое значение:
//  Соответствие - «Документ» или «Документ.ТЧ» -> причина.
//
Функция ИсключенныеПриемники()
	Результат = Новый Соответствие;
	Ордера = НСтр("ru = 'Строки ордера привязаны к строкам заказа и вводятся на основании';
		|fr = 'Les lignes de l''ordre sont liées aux lignes de la commande et se créent sur la base';
		|en = 'Order rows are linked to source order rows and are created by basis';
		|es = 'Las filas de la orden están vinculadas a las del pedido y se crean por base'");
	Результат.Вставить("ПриходныйОрдер", Ордера);
	Результат.Вставить("РасходныйОрдер", Ордера);
	Результат.Вставить("ПересортицаТоваров", НСтр("ru = 'В строке две номенклатуры - загрузка не поддерживается';
		|fr = 'Deux articles par ligne - chargement non pris en charge';
		|en = 'Two items per row - import is not supported';
		|es = 'Dos artículos por fila - carga no admitida'"));
	Результат.Вставить("ПересчётТоваров", НСтр("ru = 'Факт пересчёта загружается в существующие строки - не поддерживается';
		|fr = 'Le réel de l''inventaire se charge dans les lignes existantes - non pris en charge';
		|en = 'Count results go to existing rows - not supported';
		|es = 'El recuento real va a las filas existentes - no admitido'"));
	Результат.Вставить("АктРазбора.ТЧТовары", НСтр("ru = 'Доли себестоимости рассчитывает только форма документа';
		|fr = 'Les parts du coût sont calculées seulement par le formulaire';
		|en = 'Cost shares are calculated only by the document form';
		|es = 'Las cuotas de coste solo las calcula el formulario'"));
	Результат.Вставить("ВыпускПродукции.ТЧГотоваяПродукция", НСтр("ru = 'Строки продукции строятся из шапки документа';
		|fr = 'Les lignes de produits sont construites depuis l''en-tête';
		|en = 'Product rows are built from the document header';
		|es = 'Las filas de producto se construyen desde la cabecera'"));
	Результат.Вставить("ПоступлениеДополнительныхРасходов.ТЧТовары", НСтр("ru = 'Строкам нужен документ партии';
		|fr = 'Les lignes exigent un document de lot'; en = 'Rows need a batch document';
		|es = 'Las filas necesitan un documento de lote'"));
	Возврат Результат;
КонецФункции

// Табличная часть подчинена другой (см. ПодчиненныеТЧ).
//
// Параметры:
//  ИмяДокумента - Строка - имя документа.
//  ИмяТЧ        - Строка - имя табличной части.
//
// Возвращаемое значение:
//  Булево - Истина: подчинена.
//
Функция ЭтоПодчиненнаяТЧ(ИмяДокумента, ИмяТЧ)
	Карта = ПодчиненныеТЧ();
	Возврат Карта[ИмяДокумента + "." + ИмяТЧ] <> Неопределено Или Карта["*." + ИмяТЧ] <> Неопределено;
КонецФункции

// Подчинённые табличные части документа, чьи строки ссылаются на строки данной.
//
// Параметры:
//  ИмяДокумента - Строка - имя документа.
//  ИмяТЧ        - Строка - главная табличная часть.
//
// Возвращаемое значение:
//  Массив из Строка - имена подчинённых табличных частей.
//
Функция ПодчиненныеТЧДокумента(ИмяДокумента, ИмяТЧ)
	Результат = Новый Массив;
	МД = Метаданные.Документы.Найти(ИмяДокумента);
	Карта = ПодчиненныеТЧ();
	Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
		Главная = Карта[ИмяДокумента + "." + ТЧ.Имя];
		Если Главная = Неопределено Тогда
			Главная = Карта["*." + ТЧ.Имя];
		КонецЕсли;
		Если Главная = ИмяТЧ Тогда
			Результат.Добавить(ТЧ.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Причина недопустимости ТЧ по реквизитам, подчинённым номенклатуре: справочник, подчинённый номенклатуре, кроме
// Характеристика и Серия (его владелец в строке неоднозначен - например, характеристика второй номенклатуры).
//
// Параметры:
//  МДТЧ - ОбъектМетаданных - табличная часть.
//
// Возвращаемое значение:
//  Строка - причина; пусто - таких реквизитов нет.
//
Функция ПричинаПодчиненныхНоменклатуре(МДТЧ)
	МДНоменклатуры = Метаданные.Справочники.Номенклатура;
	Для Каждого Реквизит Из МДТЧ.Реквизиты Цикл
		Типы = Реквизит.Тип.Типы();
		Если Реквизит.Имя = ИмяХарактеристика() Или Реквизит.Имя = ИмяСерия() Или Типы.Количество() <> 1 Тогда
			Продолжить;
		КонецЕсли;
		МДТипа = Метаданные.НайтиПоТипу(Типы[0]);
		ЭтоСправочник = МДТипа <> Неопределено И Метаданные.Справочники.Содержит(МДТипа);
		Если ЭтоСправочник И МДТипа.Владельцы.Содержит(МДНоменклатуры) Тогда
			Шаблон = НСтр("ru = 'Реквизит «%1» подчинён номенклатуре и не является характеристикой или серией строки';
				|fr = 'L''attribut « %1 » dépend d''un article sans être la caractéristique ou la série de la ligne';
				|en = 'Attribute ""%1"" depends on an item but is not the row characteristic or series';
				|es = 'El atributo «%1» depende de un artículo y no es la característica ni la serie de la fila'");
			Возврат СтрШаблон(Шаблон, Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Реквизит строки загружается из файла: не служебный, тип одиночный - примитивный, справочник или перечисление.
//
// Параметры:
//  Реквизит - ОбъектМетаданных - реквизит табличной части.
//
// Возвращаемое значение:
//  Булево - Истина: загружается.
//
Функция КолонкаЗагружается(Реквизит)
	Имя = Реквизит.Имя;
	Для Каждого Префикс Из СтрРазделить("КодСтроки,Идентификатор,Ключ,СуммаРегл", ",") Цикл
		Если СтрНачинаетсяС(Имя, Префикс) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Типы = Реквизит.Тип.Типы();
	Если СлужебныеКолонки()[Имя] <> Неопределено Или Типы.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	Тип = Типы[0];
	Примитивы = Новый ОписаниеТипов("Число, Строка, Дата, Булево");
	Если Примитивы.СодержитТип(Тип) Тогда
		Возврат Истина;
	КонецЕсли;
	МДТипа = Метаданные.НайтиПоТипу(Тип);
	Если МДТипа = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Метаданные.Справочники.Содержит(МДТипа) Или Метаданные.Перечисления.Содержит(МДТипа);
КонецФункции

#КонецОбласти

#Область Сопоставление

// Ключ сравнения заголовка: нижний регистр без пробелов и знаков препинания, «ё» как «е».
//
// Параметры:
//  Текст - Строка - заголовок или имя.
//
// Возвращаемое значение:
//  Строка - ключ.
//
Функция КлючЗаголовка(Текст)
	Результат = НРег(Текст);
	Для Каждого Знак Из СтрРазделить(" |.|-|_|/|(|)|:|№|#|%|'|,", "|") Цикл
		Результат = СтрЗаменить(Результат, Знак, "");
	КонецЦикла;
	Результат = СтрЗаменить(Результат, Символы.НПП, "");
	Возврат СтрЗаменить(Результат, "ё", "е");
КонецФункции

// Варианты заголовка колонки: имя, представление и слова словаря.
//
// Параметры:
//  Колонка - Структура - Имя, Представление.
//  Словарь - Соответствие - см. СловарьЗаголовков.
//
// Возвращаемое значение:
//  Соответствие - ключ заголовка -> Истина.
//
Функция ВариантыЗаголовка(Колонка, Словарь)
	Варианты = Новый Соответствие;
	Варианты.Вставить(КлючЗаголовка(Колонка.Имя), Истина);
	Варианты.Вставить(КлючЗаголовка(Колонка.Представление), Истина);
	Слова = Словарь[Колонка.Имя];
	Если Слова <> Неопределено Тогда
		Для Каждого Слово Из Слова Цикл
			Варианты.Вставить(КлючЗаголовка(Слово), Истина);
		КонецЦикла;
	КонецЕсли;
	Возврат Варианты;
КонецФункции

// Слова заголовков колонок на языках конфигурации для частых реквизитов строк.
//
// Возвращаемое значение:
//  Соответствие - имя реквизита -> Массив из Строка.
//
Функция СловарьЗаголовков()
	Словарь = Новый Соответствие;
	Товар = "Товар,Наименование,Артикул,Штрихкод,Код,Продукт,Article,Produit,Désignation,Référence,Code-barres,EAN,Item,"
		+ "Product,SKU,Barcode,Name,Artículo,Producto,Código,Código de barras,Descripción";
	Словарь.Вставить(ИмяНоменклатура(), СтрРазделить(Товар, ","));
	Словарь.Вставить(ИмяКоличество(), СтрРазделить("Кол-во,Кол,Qté,Quantité,Qty,Quantity,Cantidad,Cant", ","));
	Словарь.Вставить(ИмяКоличествоУпаковок(), СтрРазделить("Количество упаковок,Упаковок,Colis,Packages,Bultos", ","));
	Словарь.Вставить(ИмяЦена(), СтрРазделить("Prix,Prix unitaire,PU,Price,Unit price,Precio,Precio unitario", ","));
	Словарь.Вставить(ИмяСумма(), СтрРазделить("Montant,Total,Amount,Importe", ","));
	Словарь.Вставить(ИмяСтавкаНДС(), СтрРазделить("НДС,Ставка НДС,TVA,Taux TVA,VAT,VAT rate,IVA,Tipo IVA", ","));
	Словарь.Вставить(ИмяХарактеристика(), СтрРазделить("Variante,Variant,Caractéristique", ","));
	Словарь.Вставить(ИмяСерия(), СтрРазделить("Партия,IMEI,Série,Lot,Serial,Batch,Serie,Lote", ","));
	Словарь.Вставить(ИмяУпаковка(), СтрРазделить("Единица,Ед,Unité,Unit,UoM,Unidad", ","));
	Возврат Словарь;
КонецФункции

#КонецОбласти

#Область РазборСтрок

// Проверка параметров преобразования: приёмник допустим, номенклатура сопоставлена, колонки допустимы.
//
// Параметры:
//  Описание  - Структура - см. ОписаниеПриемника.
//  Параметры - Структура - см. НовыеПараметрыПреобразования.
//
Процедура ПроверитьПараметрыПреобразования(Описание, Параметры)
	Если Не Описание.Допустим Тогда
		ВызватьИсключение Описание.Причина;
	КонецЕсли;
	Если Параметры.Колонки[ИмяНоменклатура()] = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не сопоставлена колонка номенклатуры'; fr = 'Colonne d''article non associée';
			|en = 'Item column is not mapped'; es = 'Columna de artículo no asignada'");
	КонецЕсли;
	Шаблон = НСтр("ru = 'Колонка «%1» не загружается'; fr = 'La colonne « %1 » n''est pas chargée';
		|en = 'Column ""%1"" cannot be loaded'; es = 'La columna «%1» no se carga'");
	Для Каждого КлючИЗначение Из Параметры.Колонки Цикл
		Если Описание.ИменаКолонок[КлючИЗначение.Ключ] = Неопределено Тогда
			ВызватьИсключение СтрШаблон(Шаблон, КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Состояние разбора строк файла.
//
// Параметры:
//  Сырые    - ТаблицаЗначений - см. СырыеСтроки.
//  Описание - Структура - см. ОписаниеПриемника.
//
// Возвращаемое значение:
//  Структура - Сырые, Описание, Значения и Ошибки (Соответствие индекс строки -> Структура / Массив из Строка),
//              Сопоставлено (Соответствие), Создается (Массив из Число).
//
Функция НовыйРазбор(Сырые, Описание)
	Разбор = Новый Структура("Сырые, Описание", Сырые, Описание);
	Разбор.Вставить("Значения", Новый Соответствие);
	Разбор.Вставить("Ошибки", Новый Соответствие);
	Разбор.Вставить("Сопоставлено", Новый Соответствие);
	Разбор.Вставить("Создается", Новый Массив);
	Разбор.Вставить("СоздаваемыеИндексы", Новый Массив);
	Для Индекс = 0 По Сырые.Количество() - 1 Цикл
		Разбор.Ошибки.Вставить(Индекс, Новый Массив);
		Разбор.Значения.Вставить(Индекс, Новый Структура);
	КонецЦикла;
	Разбор.Сопоставлено.Вставить(ИмяНоменклатура(), Истина);
	Возврат Разбор;
КонецФункции

// Результат преобразования по состоянию разбора: строки без ошибок и перечень ошибок.
//
// Параметры:
//  Разбор - Структура - см. НовыйРазбор.
//
// Возвращаемое значение:
//  Структура - см. ПреобразоватьСтроки.
//
Функция РезультатРазбора(Разбор)
	Результат = Новый Структура("Строки, НомераСтрок, Сопоставлено", Новый Массив, Новый Массив, Новый Массив);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("Создается", Разбор.Создается);
	Результат.Вставить("ВсегоСтрок", Разбор.Сырые.Количество());
	Для Каждого КлючИЗначение Из Разбор.Сопоставлено Цикл
		Результат.Сопоставлено.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Для Индекс = 0 По Разбор.Сырые.Количество() - 1 Цикл
		НомерСтроки = Разбор.Сырые[Индекс].НомерСтроки;
		ТекстыОшибок = Разбор.Ошибки[Индекс];
		Если ТекстыОшибок.Количество() > 0 Тогда
			Ошибка = Новый Структура("НомерСтроки, Текст", НомерСтроки, СтрСоединить(ТекстыОшибок, "; "));
			Результат.Ошибки.Добавить(Ошибка);
		Иначе
			Результат.Строки.Добавить(Разбор.Значения[Индекс]);
			Результат.НомераСтрок.Добавить(НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Номенклатура строк по правилам поиска в заданном порядке (пакетом по правилу); из штрихкода - также
// характеристика и серия. Не найдено: создание товара (Параметры.СоздаватьТовары) или ошибка строки.
//
// Параметры:
//  Разбор    - Структура - см. НовыйРазбор.
//  Параметры - Структура - см. НовыеПараметрыПреобразования.
//
Процедура НайтиНоменклатуруСтрок(Разбор, Параметры)
	Тексты = Новый Массив;
	Для Каждого Строка Из Разбор.Сырые Цикл
		Если Не ПустаяСтрока(Строка.Номенклатура) И Тексты.Найти(Строка.Номенклатура) = Неопределено Тогда
			Тексты.Добавить(Строка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Найденные = НайтиНоменклатуру(Тексты, Параметры.ПорядокПоиска);
	МожноСоздавать = Параметры.СоздаватьТовары И ПравоДоступа("Добавление", Метаданные.Справочники.Номенклатура);
	Для Индекс = 0 По Разбор.Сырые.Количество() - 1 Цикл
		Строка = Разбор.Сырые[Индекс];
		Найдено = Найденные[Строка.Номенклатура];
		Если Найдено = Неопределено И МожноСоздавать И Не ПустаяСтрока(Строка.Номенклатура) Тогда
			Найдено = ОтметитьСоздаваемую(Разбор, Индекс);
		КонецЕсли;
		ТекстОшибки = ОшибкаНайденной(Строка.Номенклатура, Найдено);
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ЗаписатьНайденную(Разбор, Индекс, Найдено);
		Иначе
			Разбор.Ошибки[Индекс].Добавить(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Строка без найденной номенклатуры при разрешённом создании: пока пустая ссылка, строка отмечается как создаваемая;
// товар создаётся после разбора всех колонок и только для строки без ошибок (см. СоздатьТоварыСтрок).
//
// Параметры:
//  Разбор - Структура - см. НовыйРазбор.
//  Индекс - Число - индекс строки.
//
// Возвращаемое значение:
//  Структура - см. НоваяНайденная.
//
Функция ОтметитьСоздаваемую(Разбор, Индекс)
	Разбор.Создается.Добавить(Разбор.Сырые[Индекс].НомерСтроки);
	Разбор.СоздаваемыеИндексы.Добавить(Индекс);
	Возврат НоваяНайденная(Справочники.Номенклатура.ПустаяСсылка());
КонецФункции

// Создаёт товары строк, отмеченных как создаваемые и прошедших разбор без ошибок; один товар на одно значение колонки
// номенклатуры. Ошибка создания - ошибка строки.
//
// Параметры:
//  Разбор    - Структура - см. НовыйРазбор.
//  Параметры - Структура - см. НовыеПараметрыПреобразования.
//
Процедура СоздатьТоварыСтрок(Разбор, Параметры)
	Созданные = Новый Соответствие;
	Для Каждого Индекс Из Разбор.СоздаваемыеИндексы Цикл
		ДобавитьОшибкуПодчиненныхНовогоТовара(Разбор, Индекс);
		Если Разбор.Ошибки[Индекс].Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = Разбор.Сырые[Индекс];
		Товар = Созданные[Строка.Номенклатура];
		Если Товар = Неопределено Тогда
			Попытка
				Товар = СоздатьНоменклатуру(Строка, Параметры);
			Исключение
				Разбор.Ошибки[Индекс].Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			Созданные.Вставить(Строка.Номенклатура, Товар);
		КонецЕсли;
		Разбор.Значения[Индекс].Вставить(ИмяНоменклатура(), Товар);
	КонецЦикла;
КонецПроцедуры

// У нового товара ещё нет характеристик и серий: непустая колонка характеристики или серии в его строке - ошибка
// строки (товар не создаётся).
//
// Параметры:
//  Разбор - Структура - см. НовыйРазбор.
//  Индекс - Число - индекс строки.
//
Процедура ДобавитьОшибкуПодчиненныхНовогоТовара(Разбор, Индекс)
	Шаблон = НСтр("ru = 'у нового товара нет значения «%1» (%2)'; fr = 'le nouvel article n''a pas la valeur « %1 » (%2)';
		|en = 'the new item has no value ""%1"" (%2)'; es = 'el artículo nuevo no tiene el valor «%1» (%2)'");
	Строка = Разбор.Сырые[Индекс];
	Для Каждого Имя Из СтрРазделить("Характеристика,Серия", ",") Цикл
		Если Строка.Владелец().Колонки.Найти(Имя) <> Неопределено И Не ПустаяСтрока(Строка[Имя]) Тогда
			Разбор.Ошибки[Индекс].Добавить(СтрШаблон(Шаблон, Строка[Имя], Имя));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Текст ошибки поиска товара строки.
//
// Параметры:
//  Текст   - Строка - значение колонки номенклатуры.
//  Найдено - Структура, Неопределено - см. НоваяНайденная.
//
// Возвращаемое значение:
//  Строка - ошибка; пусто - найдено.
//
Функция ОшибкаНайденной(Текст, Найдено)
	Если ПустаяСтрока(Текст) Тогда
		Возврат НСтр("ru = 'не указан товар'; fr = 'article non indiqué'; en = 'item not specified'; es = 'artículo no indicado'");
	ИначеЕсли Найдено = Неопределено Тогда
		Шаблон = НСтр("ru = 'товар «%1» не найден'; fr = 'article « %1 » introuvable'; en = 'item ""%1"" not found';
			|es = 'artículo «%1» no encontrado'");
		Возврат СтрШаблон(Шаблон, Текст);
	Иначе
		Возврат Найдено.Ошибка;
	КонецЕсли;
КонецФункции

// Записывает найденный товар строки; характеристика и серия из штрихкода - если в строке есть такие реквизиты.
//
// Параметры:
//  Разбор  - Структура - см. НовыйРазбор.
//  Индекс  - Число - индекс строки.
//  Найдено - Структура - см. НоваяНайденная.
//
Процедура ЗаписатьНайденную(Разбор, Индекс, Найдено)
	Значения = Разбор.Значения[Индекс];
	Значения.Вставить(ИмяНоменклатура(), Найдено.Номенклатура);
	Для Каждого Имя Из СтрРазделить("Характеристика,Серия", ",") Цикл
		Значение = Найдено[Имя];
		Если Разбор.Описание.Реквизиты[Имя] <> Неопределено И ЗначениеЗаполнено(Значение) Тогда
			Значения.Вставить(Имя, Значение);
			Разбор.Сопоставлено.Вставить(Имя, Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Результат поиска товара по тексту.
//
// Параметры:
//  Номенклатура   - СправочникСсылка.Номенклатура, Неопределено - найденный товар.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры, Неопределено - из штрихкода.
//  Серия          - СправочникСсылка.СерииНоменклатуры, Неопределено - из штрихкода.
//  Ошибка         - Строка - ошибка поиска.
//
// Возвращаемое значение:
//  Структура - Номенклатура, Характеристика, Серия, Ошибка.
//
Функция НоваяНайденная(Номенклатура, Характеристика = Неопределено, Серия = Неопределено, Ошибка = "")
	Результат = Новый Структура("Номенклатура, Характеристика, Серия", Номенклатура, Характеристика, Серия);
	Результат.Вставить("Ошибка", Ошибка);
	Возврат Результат;
КонецФункции

// Разбор совпадений правила: одно - найдено, несколько - ошибка неоднозначности.
//
// Параметры:
//  Совпадения - ТаблицаЗначений - Значение (в верхнем регистре), Номенклатура, Характеристика, Серия.
//  Осталось   - Массив из Строка - тексты, ещё не найденные.
//  Правило    - Строка - правило поиска.
//  Результат  - Соответствие - см. НайтиНоменклатуру; дополняется.
//
// Возвращаемое значение:
//  Массив из Строка - тексты без совпадений по правилу.
//
Функция РазобратьСовпадения(Совпадения, Осталось, Правило, Результат)
	НовыеОсталось = Новый Массив;
	Шаблон = НСтр("ru = 'товар «%1» неоднозначен (%2)'; fr = 'article « %1 » ambigu (%2)';
		|en = 'item ""%1"" is ambiguous (%2)'; es = 'artículo «%1» ambiguo (%2)'");
	Для Каждого Текст Из Осталось Цикл
		Строки = Совпадения.НайтиСтроки(Новый Структура("Значение", ВРег(Текст)));
		Если Строки.Количество() = 1 Тогда
			Найдено = Строки[0];
			Результат.Вставить(Текст, НоваяНайденная(Найдено.Номенклатура, Найдено.Характеристика, Найдено.Серия));
		ИначеЕсли Строки.Количество() > 1 Тогда
			Результат.Вставить(Текст, НоваяНайденная(Неопределено, , , СтрШаблон(Шаблон, Текст, Правило)));
		Иначе
			НовыеОсталось.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат НовыеОсталось;
КонецФункции

// Совпадения номенклатуры по правилу поиска.
//
// Параметры:
//  Правило - Строка - Штрихкод, Артикул, КодПоставщика, Код или Наименование.
//  Тексты  - Массив из Строка - искомые значения.
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - Значение (в верхнем регистре), Номенклатура, Характеристика, Серия;
//                                 Неопределено - правило неизвестно.
//
Функция СовпаденияНоменклатуры(Правило, Тексты)
	Запрос = Новый Запрос;
	Если Правило = "Штрихкод" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	Штрихкоды.Штрихкод КАК Значение,
		|	Штрихкоды.Номенклатура КАК Номенклатура,
		|	Штрихкоды.Характеристика КАК Характеристика,
		|	Штрихкоды.Серия КАК Серия
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
		|		ПО Штрихкоды.Номенклатура = Товары.Ссылка
		|ГДЕ
		|	Штрихкоды.Штрихкод В (&Тексты)
		|	И НЕ Товары.ПометкаУдаления";
	ИначеЕсли СтрРазделить("Артикул,КодПоставщика,Код,Наименование", ",").Найти(Правило) <> Неопределено Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	Номенклатура.Артикул КАК Значение,
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	НЕОПРЕДЕЛЕНО КАК Характеристика,
		|	НЕОПРЕДЕЛЕНО КАК Серия
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул В (&Тексты)
		|	И НЕ Номенклатура.ЭтоГруппа
		|	И НЕ Номенклатура.ПометкаУдаления";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура.Артикул", "Номенклатура." + Правило);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Запрос.УстановитьПараметр("Тексты", Тексты);
	Совпадения = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Совпадения Цикл
		Строка.Значение = ВРег(СокрЛП(Строка.Значение));
	КонецЦикла;
	Возврат Совпадения;
КонецФункции

// Характеристика или серия строки - только среди элементов, подчинённых найденному товару строки (пакетом по парам
// «товар + значение»); по коду, затем по наименованию. Значение из штрихкода сверяется с колонкой файла.
//
// Параметры:
//  Разбор - Структура - см. НовыйРазбор.
//  Имя    - Строка - Характеристика или Серия.
//
Процедура РазрешитьПодчиненные(Разбор, Имя)
	Реквизит = Разбор.Описание.Реквизиты[Имя];
	МДСправочника = Метаданные.НайтиПоТипу(Реквизит.Тип.Типы()[0]);
	Пары = ПарыТоварЗначение(Разбор, Имя);
	Найденные = ЭлементыТоваров(МДСправочника, Пары.Товары, Пары.Тексты);
	Для Каждого Пара Из Пары.Строки Цикл
		Индекс = Пара.Индекс;
		Отбор = Новый Структура("Владелец, Код", Пара.Номенклатура, ВРег(Пара.Текст));
		Строки = Найденные.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда
			Отбор = Новый Структура("Владелец, Наименование", Пара.Номенклатура, ВРег(Пара.Текст));
			Строки = Найденные.НайтиСтроки(Отбор);
		КонецЕсли;
		ТекстОшибки = ОшибкаПодчиненного(Строки, Разбор.Значения[Индекс], Имя, Реквизит.Представление(), Пара.Текст);
		Если ПустаяСтрока(ТекстОшибки) Тогда
			Разбор.Значения[Индекс].Вставить(Имя, Строки[0].Ссылка);
		Иначе
			Разбор.Ошибки[Индекс].Добавить(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Пары «товар строки + текст колонки» для пакетного поиска подчинённых элементов.
//
// Параметры:
//  Разбор - Структура - см. НовыйРазбор.
//  Имя    - Строка - колонка.
//
// Возвращаемое значение:
//  Структура - Товары, Тексты (Массив - для запроса), Строки (Массив из Структура: Индекс, Номенклатура, Текст).
//
Функция ПарыТоварЗначение(Разбор, Имя)
	Пары = Новый Структура("Товары, Тексты, Строки", Новый Массив, Новый Массив, Новый Массив);
	Для Индекс = 0 По Разбор.Сырые.Количество() - 1 Цикл
		Текст = Разбор.Сырые[Индекс][Имя];
		Номенклатура = Неопределено;
		Если Не ПустаяСтрока(Текст) И Разбор.Значения[Индекс].Свойство(ИмяНоменклатура(), Номенклатура)
			И ЗначениеЗаполнено(Номенклатура) Тогда
			Пары.Товары.Добавить(Номенклатура);
			Пары.Тексты.Добавить(Текст);
			Пары.Строки.Добавить(Новый Структура("Индекс, Номенклатура, Текст", Индекс, Номенклатура, Текст));
		КонецЕсли;
	КонецЦикла;
	Возврат Пары;
КонецФункции

// Элементы справочника, подчинённого номенклатуре, у заданных товаров по коду или наименованию.
//
// Параметры:
//  МДСправочника - ОбъектМетаданных - справочник (владелец - номенклатура).
//  Товары        - Массив - товары.
//  Тексты        - Массив из Строка - коды или наименования.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ссылка, Владелец, Наименование и Код (в верхнем регистре; у справочника без кода - пусто).
//
Функция ЭлементыТоваров(МДСправочника, Товары, Тексты)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Владелец КАК Владелец,
	|	Спр.Наименование КАК Наименование,
	|	Спр.Код КАК Код
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК Спр
	|ГДЕ
	|	Спр.Владелец В (&Товары)
	|	И Спр.Наименование В (&Тексты)
	|	И НЕ Спр.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Спр.Ссылка,
	|	Спр.Владелец,
	|	Спр.Наименование,
	|	Спр.Код
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК Спр
	|ГДЕ
	|	Спр.Владелец В (&Товары)
	|	И Спр.Код В (&Тексты)
	|	И НЕ Спр.ПометкаУдаления");
	Если МДСправочника.ДлинаКода = 0 Тогда
		// у справочника без кода - только первая часть объединения
		Запрос.Текст = Лев(Запрос.Текст, СтрНайти(Запрос.Текст, "ОБЪЕДИНИТЬ ВСЕ") - 1);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Спр.Код КАК Код", """"" КАК Код");
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.СерииНоменклатуры", "Справочник." + МДСправочника.Имя);
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Тексты", Тексты);
	Найденные = Запрос.Выполнить().Выгрузить();
	Найденные.Свернуть("Ссылка, Владелец, Наименование, Код"); // элемент с кодом, равным наименованию, - один раз
	Для Каждого Строка Из Найденные Цикл
		Строка.Наименование = ВРег(СокрЛП(Строка.Наименование));
		Строка.Код = ВРег(СокрЛП(Строка.Код));
	КонецЦикла;
	Возврат Найденные;
КонецФункции

// Ошибка подчинённого значения: не найдено, неоднозначно или противоречит штрихкоду.
//
// Параметры:
//  Строки        - Массив - найденные строки.
//  Значения      - Структура - значения строки.
//  Имя           - Строка - колонка.
//  Представление - Строка - представление колонки.
//  Текст         - Строка - текст файла.
//
// Возвращаемое значение:
//  Строка - ошибка; пусто - значение однозначно.
//
Функция ОшибкаПодчиненного(Строки, Значения, Имя, Представление, Текст)
	Если Строки.Количество() = 0 Тогда
		Шаблон = НСтр("ru = '%1 «%2» не найдена у товара'; fr = '%1 « %2 » introuvable pour l''article';
			|en = '%1 ""%2"" not found for the item'; es = '%1 «%2» no encontrada para el artículo'");
		Возврат СтрШаблон(Шаблон, Представление, Текст);
	ИначеЕсли Строки.Количество() > 1 Тогда
		Шаблон = НСтр("ru = '%1 «%2» неоднозначна'; fr = '%1 « %2 » ambiguë'; en = '%1 ""%2"" is ambiguous';
			|es = '%1 «%2» ambigua'");
		Возврат СтрШаблон(Шаблон, Представление, Текст);
	Иначе
		ИзШтрихкода = Неопределено;
		Если Значения.Свойство(Имя, ИзШтрихкода) И ИзШтрихкода <> Строки[0].Ссылка Тогда
			Шаблон = НСтр("ru = '%1 из файла противоречит штрихкоду'; fr = '%1 du fichier contredit le code-barres';
				|en = '%1 from the file contradicts the barcode'; es = '%1 del archivo contradice el código de barras'");
			Возврат СтрШаблон(Шаблон, Представление);
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

// Значения колонки по типу реквизита; ссылки - пакетом по уникальным текстам.
//
// Параметры:
//  Разбор - Структура - см. НовыйРазбор.
//  Имя    - Строка - колонка.
//
Процедура РазрешитьКолонку(Разбор, Имя)
	ОписаниеТипа = Разбор.Описание.Реквизиты[Имя].Тип;
	Тип = ОписаниеТипа.Типы()[0];
	Ссылки = СсылкиКолонки(Разбор.Сырые, Имя, Тип);
	Для Индекс = 0 По Разбор.Сырые.Количество() - 1 Цикл
		Текст = Разбор.Сырые[Индекс][Имя];
		Ошибка = "";
		Если Ссылки = Неопределено Тогда
			Значение = ПримитивноеЗначение(Текст, Тип, ОписаниеТипа, Ошибка);
		Иначе
			Значение = ЗначениеСсылки(Текст, Ссылки, ОписаниеТипа, Ошибка);
		КонецЕсли;
		Если ПустаяСтрока(Ошибка) Тогда
			Разбор.Значения[Индекс].Вставить(Имя, Значение);
		Иначе
			Разбор.Ошибки[Индекс].Добавить(СтрШаблон("%1: %2", Имя, Ошибка));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Ссылки колонки ссылочного типа по уникальным текстам.
//
// Параметры:
//  Сырые - ТаблицаЗначений - строки файла.
//  Имя   - Строка - колонка.
//  Тип   - Тип - тип реквизита.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - текст в верхнем регистре -> ссылка (Null - неоднозначно); Неопределено - тип
//                               не ссылочный.
//
Функция СсылкиКолонки(Сырые, Имя, Тип)
	МДТипа = Метаданные.НайтиПоТипу(Тип);
	Если МДТипа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Метаданные.Перечисления.Содержит(МДТипа) Тогда
		Возврат ЗначенияПеречисления(МДТипа);
	КонецЕсли;
	Тексты = Новый Массив;
	Для Каждого Строка Из Сырые Цикл
		Если Не ПустаяСтрока(Строка[Имя]) И Тексты.Найти(Строка[Имя]) = Неопределено Тогда
			Тексты.Добавить(Строка[Имя]);
		КонецЕсли;
	КонецЦикла;
	Возврат НайтиЭлементыСправочника(МДТипа, Тексты);
КонецФункции

// Ссылка по тексту ячейки.
//
// Параметры:
//  Текст        - Строка - текст ячейки.
//  Ссылки       - Соответствие - см. СсылкиКолонки.
//  ОписаниеТипа - ОписаниеТипов - тип реквизита (для пустой ссылки).
//  Ошибка       - Строка - текст ошибки (выходной).
//
// Возвращаемое значение:
//  ЛюбаяСсылка - найденная или пустая ссылка.
//
Функция ЗначениеСсылки(Текст, Ссылки, ОписаниеТипа, Ошибка)
	Значение = ОписаниеТипа.ПривестиЗначение(Неопределено);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Значение;
	КонецЕсли;
	Найдено = Ссылки[ВРег(Текст)];
	Если Найдено = Неопределено Тогда
		Шаблон = НСтр("ru = '«%1» не найдено'; fr = '« %1 » introuvable'; en = '""%1"" not found'; es = '«%1» no encontrado'");
		Ошибка = СтрШаблон(Шаблон, Текст);
	ИначеЕсли Найдено = Null Тогда
		Шаблон = НСтр("ru = '«%1» неоднозначно'; fr = '« %1 » ambigu'; en = '""%1"" is ambiguous'; es = '«%1» ambiguo'");
		Ошибка = СтрШаблон(Шаблон, Текст);
	Иначе
		Значение = Найдено;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Значения перечисления по имени и синониму, в верхнем регистре.
//
// Параметры:
//  МДПеречисления - ОбъектМетаданных - перечисление.
//
// Возвращаемое значение:
//  Соответствие - имя или синоним -> значение.
//
Функция ЗначенияПеречисления(МДПеречисления)
	Результат = Новый Соответствие;
	Менеджер = Перечисления[МДПеречисления.Имя];
	Для Каждого Значение Из МДПеречисления.ЗначенияПеречисления Цикл
		Ссылка = Менеджер[Значение.Имя];
		Результат.Вставить(ВРег(Значение.Имя), Ссылка);
		Результат.Вставить(ВРег(Значение.Представление()), Ссылка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Элементы справочника по коду, затем по наименованию (не группы, не помеченные на удаление). Несколько
// совпадений - Null.
//
// Параметры:
//  МДСправочника - ОбъектМетаданных - справочник.
//  Тексты        - Массив из Строка - коды или наименования.
//
// Возвращаемое значение:
//  Соответствие - текст в верхнем регистре -> ссылка или Null.
//
Функция НайтиЭлементыСправочника(МДСправочника, Тексты)
	Результат = Новый Соответствие;
	Найденные = ЭлементыСправочника(МДСправочника, Тексты);
	Если Найденные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Текст Из Тексты Цикл
		Ключ = ВРег(Текст);
		Строки = Найденные.НайтиСтроки(Новый Структура("Код", Ключ));
		Если Строки.Количество() = 0 Тогда
			Строки = Найденные.НайтиСтроки(Новый Структура("Наименование", Ключ));
		КонецЕсли;
		Если Строки.Количество() = 1 Тогда
			Результат.Вставить(Ключ, Строки[0].Ссылка);
		ИначеЕсли Строки.Количество() > 1 Тогда
			Результат.Вставить(Ключ, Null);
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Элементы справочника с кодом или наименованием из списка.
//
// Параметры:
//  МДСправочника - ОбъектМетаданных - справочник.
//  Тексты        - Массив из Строка - коды или наименования.
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - Ссылка, Код и Наименование в верхнем регистре; Неопределено - искать не по чему.
//
Функция ЭлементыСправочника(МДСправочника, Тексты)
	ЕстьКод = МДСправочника.ДлинаКода > 0
		И МДСправочника.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Строка;
	ЕстьНаименование = МДСправочника.ДлинаНаименования > 0;
	Если Тексты.Количество() = 0 Или Не ЕстьКод И Не ЕстьНаименование Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПоКоду = "ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Код КАК Код,
	|	Спр.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Спр
	|ГДЕ
	|	Спр.Код В (&Тексты)
	|	И НЕ Спр.ПометкаУдаления
	|	И НЕ Спр.ЭтоГруппа";
	ПоНаименованию = СтрЗаменить(ПоКоду, "Спр.Код В (&Тексты)", "Спр.Наименование В (&Тексты)");
	Если Не ЕстьКод Тогда
		ПоНаименованию = СтрЗаменить(ПоНаименованию, "Спр.Код КАК Код", """"" КАК Код");
	КонецЕсли;
	Если Не ЕстьНаименование Тогда
		ПоКоду = СтрЗаменить(ПоКоду, "Спр.Наименование КАК Наименование", """"" КАК Наименование");
	КонецЕсли;
	Части = Новый Массив;
	Если ЕстьКод Тогда
		Части.Добавить(ПоКоду);
	КонецЕсли;
	Если ЕстьНаименование Тогда
		Части.Добавить(ПоНаименованию);
	КонецЕсли;
	Запрос = Новый Запрос(СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС));
	Если Не ЕстьГруппыЭлементов(МДСправочника) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НЕ Спр.ЭтоГруппа", "");
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Номенклатура", "Справочник." + МДСправочника.Имя);
	Запрос.УстановитьПараметр("Тексты", Тексты);
	Найденные = Запрос.Выполнить().Выгрузить();
	Найденные.Свернуть("Ссылка, Код, Наименование"); // элемент с кодом, равным наименованию, - один раз
	Для Каждого Строка Из Найденные Цикл
		Строка.Код = ВРег(СокрЛП(Строка.Код));
		Строка.Наименование = ВРег(СокрЛП(Строка.Наименование));
	КонецЦикла;
	Возврат Найденные;
КонецФункции

// У справочника есть группы (иерархия групп и элементов).
//
// Параметры:
//  МДСправочника - ОбъектМетаданных - справочник.
//
// Возвращаемое значение:
//  Булево - Истина: есть группы.
//
Функция ЕстьГруппыЭлементов(МДСправочника)
	Возврат МДСправочника.Иерархический
		И МДСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
КонецФункции

// Число из текста: пробелы и неразрывные пробелы - разряды; дробная часть - после последней точки или запятой.
//
// Параметры:
//  Текст  - Строка - текст ячейки.
//  Ошибка - Строка - текст ошибки (выходной).
//
// Возвращаемое значение:
//  Число - значение; ошибка - 0.
//
Функция ЧислоИзТекста(Знач Текст, Ошибка)
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символы.НПП, "");
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Запятая = СтрНайти(Текст, ",", НаправлениеПоиска.СКонца);
	Точка = СтрНайти(Текст, ".", НаправлениеПоиска.СКонца);
	Если Запятая > Точка Тогда
		// дробная часть - после запятой, точки - разряды
		Текст = СтрЗаменить(Текст, ".", "");
		Текст = СтрЗаменить(Текст, ",", ".");
	Иначе
		Текст = СтрЗаменить(Текст, ",", "");
	КонецЕсли;
	Если Не ЭтоЗаписьЧисла(Текст) Тогда
		Шаблон = НСтр("ru = '«%1» не число'; fr = '« %1 » n''est pas un nombre'; en = '""%1"" is not a number';
			|es = '«%1» no es un número'");
		Ошибка = СтрШаблон(Шаблон, Текст);
		Возврат 0;
	КонецЕсли;
	Возврат ЧислоИзЗаписи(Текст);
КонецФункции

// Число из записи с точкой как разделителем дробной части: разбор по цифрам, без зависимости от региональных
// настроек (Число() понимает разделитель сеанса).
//
// Параметры:
//  Текст - Строка - запись числа (см. ЭтоЗаписьЧисла).
//
// Возвращаемое значение:
//  Число - значение.
//
Функция ЧислоИзЗаписи(Текст)
	Основание = 10;
	Знак = 1;
	Запись = Текст;
	Если СтрНачинаетсяС(Запись, "-") Тогда
		Знак = -1;
		Запись = Сред(Запись, СтрДлина("-") + 1);
	КонецЕсли;
	Результат = 0;
	Делитель = 0;
	Для Позиция = 1 По СтрДлина(Запись) Цикл
		Цифра = Сред(Запись, Позиция, 1);
		Если Цифра = "." Тогда
			Делитель = 1;
			Продолжить;
		КонецЕсли;
		Результат = Результат * Основание + СтрНайти("0123456789", Цифра) - 1;
		Делитель = Делитель * Основание;
	КонецЦикла;
	Возврат Знак * ?(Делитель = 0, Результат, Результат / Делитель);
КонецФункции

// Запись числа: необязательный минус, цифры, не больше одной точки, хотя бы одна цифра.
//
// Параметры:
//  Текст - Строка - текст без пробелов.
//
// Возвращаемое значение:
//  Булево - Истина: запись числа.
//
Функция ЭтоЗаписьЧисла(Текст)
	Цифр = 0;
	Точек = 0;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Знак) > 0 Тогда
			Цифр = Цифр + 1;
		ИначеЕсли Знак = "." Тогда
			Точек = Точек + 1;
		ИначеЕсли Знак = "-" И Позиция = 1 Тогда
			Продолжить;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Цифр > 0 И Точек <= 1;
КонецФункции

// Дата из текста «ДД.ММ.ГГГГ» (или «ДД/ММ/ГГ») либо «ГГГГ-ММ-ДД».
//
// Параметры:
//  Текст  - Строка - текст ячейки.
//  Ошибка - Строка - текст ошибки (выходной).
//
// Возвращаемое значение:
//  Дата - значение; ошибка - пустая дата.
//
Функция ДатаИзТекста(Знач Текст, Ошибка)
	Пустая = Дата(1, 1, 1);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Пустая;
	КонецЕсли;
	ДлинаДаты = 10;
	ЦифрГода = 4;
	Части = СтрРазделить(Лев(Текст, ДлинаДаты), "./-", Ложь);
	Шаблон = НСтр("ru = '«%1» не дата'; fr = '« %1 » n''est pas une date'; en = '""%1"" is not a date'; es = '«%1» no es una fecha'");
	Если Не ЭтоЧастиДаты(Части) Тогда
		Ошибка = СтрШаблон(Шаблон, Текст);
		Возврат Пустая;
	КонецЕсли;
	Если СтрДлина(Части[0]) = ЦифрГода Тогда
		Результат = ДатаИзЧастей(Число(Части[0]), Число(Части[1]), Число(Части[2]));
	Иначе
		Год = ПолныйГод(Число(Части[2]));
		Результат = ДатаИзЧастей(Год, Число(Части[1]), Число(Части[0]));
	КонецЕсли;
	Если Результат = Пустая Тогда
		Ошибка = СтрШаблон(Шаблон, Текст);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Три части даты, каждая - запись целого числа.
//
// Параметры:
//  Части - Массив из Строка - части текста даты.
//
// Возвращаемое значение:
//  Булево - Истина: части даты.
//
Функция ЭтоЧастиДаты(Части)
	ЧастейДаты = 3;
	Если Части.Количество() <> ЧастейДаты Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Часть Из Части Цикл
		Если Не ЭтоЗаписьЧисла(Часть) Или СтрНайти(Часть, ".") > 0 Или СтрНайти(Часть, "-") > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Четырёхзначный год из двузначного (00-99 - 2000-2099).
//
// Параметры:
//  Год - Число - год.
//
// Возвращаемое значение:
//  Число - год.
//
Функция ПолныйГод(Год)
	Век = 2000;
	ДвузначныйПредел = 100;
	Возврат ?(Год < ДвузначныйПредел, Век + Год, Год);
КонецФункции

// Дата из частей без исключений: несуществующая дата (31 февраля) - пустая дата.
//
// Параметры:
//  Год   - Число - год.
//  Месяц - Число - месяц.
//  День  - Число - день.
//
// Возвращаемое значение:
//  Дата - дата или пустая дата.
//
Функция ДатаИзЧастей(Год, Месяц, День)
	Пустая = Дата(1, 1, 1);
	МаксимумМесяцев = 12;
	МаксимумДней = 31;
	МаксимальныйГод = 3999;
	СекундВДне = 86400;
	ГодДопустим = Год >= 1 И Год <= МаксимальныйГод;
	МесяцДопустим = Месяц >= 1 И Месяц <= МаксимумМесяцев;
	ДеньДопустим = День >= 1 И День <= МаксимумДней;
	Если Не (ГодДопустим И МесяцДопустим И ДеньДопустим) Тогда
		Возврат Пустая;
	КонецЕсли;
	НачалоМесяца = Дата(Год, Месяц, 1);
	Результат = НачалоМесяца + (День - 1) * СекундВДне;
	Возврат ?(Месяц(Результат) = Месяц, Результат, Пустая);
КонецФункции

// Булево из текста: да/нет, 1/0, истина/ложь на языках конфигурации.
//
// Параметры:
//  Текст  - Строка - текст ячейки.
//  Ошибка - Строка - текст ошибки (выходной).
//
// Возвращаемое значение:
//  Булево - значение.
//
Функция БулевоИзТекста(Текст, Ошибка)
	Ключ = НРег(СокрЛП(Текст));
	Если ПустаяСтрока(Ключ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрРазделить("да,1,истина,true,yes,oui,vrai,sí,si,x", ",").Найти(Ключ) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрРазделить("нет,0,ложь,false,no,non,faux", ",").Найти(Ключ) = Неопределено Тогда
		Шаблон = НСтр("ru = '«%1» не да/нет'; fr = '« %1 » n''est pas oui/non'; en = '""%1"" is not yes/no';
			|es = '«%1» no es sí/no'");
		Ошибка = СтрШаблон(Шаблон, Текст);
	КонецЕсли;
	Возврат Ложь;
КонецФункции

#КонецОбласти

#Область СозданиеТоваров

// Создаёт товар: транзакция с блокировкой таблицы номенклатуры и штрихкода, повторный поиск (найден после ожидания -
// используется), запись товара и бренда, занятие штрихкода; отказ занятия откатывает созданное.
//
// Параметры:
//  Строка    - СтрокаТаблицыЗначений - строка файла (см. СырыеСтроки).
//  Параметры - Структура - см. НовыеПараметрыПреобразования.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - найденный или созданный товар.
//
Функция СоздатьНоменклатуру(Строка, Параметры)
	Поля = ПоляНовогоТовара(Строка, Параметры);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСозданиеТовара(Поля.Штрихкод);
		Товар = ТоварПослеОжидания(Строка.Номенклатура, Параметры.ПорядокПоиска);
		Если Товар = Неопределено Тогда
			Товар = ЗаписатьНовыйТовар(Поля, Параметры.ГруппаНовыхТоваров);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Товар;
КонецФункции

// Поля нового товара из колонок создания; без наименования - текст колонки номенклатуры.
//
// Параметры:
//  Строка    - СтрокаТаблицыЗначений - строка файла.
//  Параметры - Структура - см. НовыеПараметрыПреобразования.
//
// Возвращаемое значение:
//  Структура - Наименование, Артикул, Штрихкод, КодПоставщика, Группа, Бренд.
//
Функция ПоляНовогоТовара(Строка, Параметры)
	Поля = Новый Структура("Наименование, Артикул, Штрихкод", "", "", "");
	Поля.Вставить("КодПоставщика", "");
	Поля.Вставить("Группа", "");
	Поля.Вставить("Бренд", "");
	Для Каждого КлючИЗначение Из Параметры.ПоляСоздания Цикл
		Поля.Вставить(КлючИЗначение.Ключ, Строка["Создание_" + КлючИЗначение.Ключ]);
	КонецЦикла;
	Если ПустаяСтрока(Поля.Наименование) Тогда
		Поля.Наименование = Строка.Номенклатура;
	КонецЕсли;
	Возврат Поля;
КонецФункции

// Исключительная блокировка создания товара: таблица номенклатуры и штрихкод.
//
// Параметры:
//  Штрихкод - Строка - штрихкод нового товара; пусто - без блокировки штрихкода.
//
Процедура ЗаблокироватьСозданиеТовара(Штрихкод)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник.Номенклатура");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Если Не ПустаяСтрока(Штрихкод) Тогда
		Элемент = Блокировка.Добавить("РегистрСведений.ШтрихкодыНоменклатуры");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Штрихкод", Штрихкод);
	КонецЕсли;
	Блокировка.Заблокировать();
КонецПроцедуры

// Повторный поиск товара под блокировкой: другой пользователь мог создать его, пока мы ждали.
//
// Параметры:
//  Текст         - Строка - значение колонки номенклатуры.
//  ПорядокПоиска - Массив из Строка - правила поиска.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура, Неопределено - найденный товар.
//
Функция ТоварПослеОжидания(Текст, ПорядокПоиска)
	Тексты = Новый Массив;
	Тексты.Добавить(Текст);
	Найдено = НайтиНоменклатуру(Тексты, ПорядокПоиска)[Текст];
	Если Найдено = Неопределено Или Не ПустаяСтрока(Найдено.Ошибка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Найдено.Номенклатура;
КонецФункции

// Записывает новый товар и занимает его штрихкод; отказ занятия - исключение.
//
// Параметры:
//  Поля              - Структура - см. ПоляНовогоТовара.
//  ГруппаПоУмолчанию - СправочникСсылка.Номенклатура - группа без колонки группы.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - созданный товар.
//
Функция ЗаписатьНовыйТовар(Поля, ГруппаПоУмолчанию)
	Товар = Справочники.Номенклатура.СоздатьЭлемент();
	Товар.Наименование = Поля.Наименование;
	Товар.НаименованиеПолное = Поля.Наименование;
	Товар.Артикул = Поля.Артикул;
	Товар.КодПоставщика = Поля.КодПоставщика;
	Товар.Родитель = ГруппаНовогоТовара(Поля.Группа, ГруппаПоУмолчанию);
	Товар.Единица = Константы.ЕдиницаПоУмолчанию.Получить();
	Товар.СтавкаНДС = Константы.СтавкаНДСПоУмолчанию.Получить();
	Товар.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
	Товар.Бренд = БрендНовогоТовара(Поля.Бренд);
	Товар.Записать();
	Если Не ПустаяСтрока(Поля.Штрихкод) Тогда
		ТекстОтказа = РегистрыСведений.ШтрихкодыНоменклатуры.ЗанятьШтрихкод(Поля.Штрихкод, Товар.Ссылка);
		Если Не ПустаяСтрока(ТекстОтказа) Тогда
			ВызватьИсключение ТекстОтказа;
		КонецЕсли;
	КонецЕсли;
	Возврат Товар.Ссылка;
КонецФункции

// Группа нового товара по наименованию; не найдена - группа по умолчанию.
//
// Параметры:
//  Наименование      - Строка - наименование группы из файла.
//  ГруппаПоУмолчанию - СправочникСсылка.Номенклатура - группа по умолчанию.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - группа.
//
Функция ГруппаНовогоТовара(Наименование, ГруппаПоУмолчанию)
	Если ПустаяСтрока(Наименование) Тогда
		Возврат ГруппаПоУмолчанию;
	КонецЕсли;
	Группа = Справочники.Номенклатура.НайтиПоНаименованию(Наименование, Истина);
	Если Группа.Пустая() Или Не Группа.ЭтоГруппа Тогда
		Возврат ГруппаПоУмолчанию;
	КонецЕсли;
	Возврат Группа;
КонецФункции

// Бренд нового товара по наименованию; нет - создаётся.
//
// Параметры:
//  Наименование - Строка - наименование бренда из файла.
//
// Возвращаемое значение:
//  СправочникСсылка.Бренды - бренд или пустая ссылка.
//
Функция БрендНовогоТовара(Наименование)
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Справочники.Бренды.ПустаяСсылка();
	КонецЕсли;
	Бренд = Справочники.Бренды.НайтиПоНаименованию(Наименование, Истина);
	Если Бренд.Пустая() Тогда
		НовыйБренд = Справочники.Бренды.СоздатьЭлемент();
		НовыйБренд.Наименование = Наименование;
		НовыйБренд.Записать();
		Бренд = НовыйБренд.Ссылка;
	КонецЕсли;
	Возврат Бренд;
КонецФункции

#КонецОбласти

#Область ЗаполнениеТЧ

// Сверка структуры загрузки с приёмником: номенклатура сопоставлена, только допустимые колонки (структура приходит
// и с клиента), не больше одной ценовой колонки, есть строки и их не больше максимума.
//
// Параметры:
//  Описание - Структура - см. ОписаниеПриемника.
//  Загрузка - Структура - см. ЗаполнитьТЧ.
//
// Возвращаемое значение:
//  Строка - ошибка; пусто - загрузка корректна.
//
Функция ОшибкаСопоставления(Описание, Загрузка)
	Если Загрузка.Сопоставлено.Найти(ИмяНоменклатура()) = Неопределено Тогда
		Возврат НСтр("ru = 'Не сопоставлена колонка номенклатуры'; fr = 'Colonne d''article non associée';
			|en = 'Item column is not mapped'; es = 'Columna de artículo no asignada'");
	КонецЕсли;
	ЦеновыхКолонок = 0;
	Шаблон = НСтр("ru = 'Колонка «%1» не загружается'; fr = 'La colonne « %1 » n''est pas chargée';
		|en = 'Column ""%1"" cannot be loaded'; es = 'La columna «%1» no se carga'");
	Для Каждого Имя Из Загрузка.Сопоставлено Цикл
		Если Описание.ИменаКолонок[Имя] = Неопределено Тогда
			Возврат СтрШаблон(Шаблон, Имя);
		КонецЕсли;
		Если Имя = ИмяЦена() Или Имя = ИмяЦенаSKU() Или Имя = ИмяСумма() Тогда
			ЦеновыхКолонок = ЦеновыхКолонок + 1;
		КонецЕсли;
	КонецЦикла;
	Если ЦеновыхКолонок > 1 Тогда
		Возврат НСтр("ru = 'Из колонок цены, цены единицы и суммы загружается только одна';
			|fr = 'Une seule colonne parmi prix, prix unitaire de base et montant';
			|en = 'Only one of price, base unit price and amount columns can be loaded';
			|es = 'Solo una de las columnas precio, precio de unidad base e importe'");
	КонецЕсли;
	Возврат ОшибкаКоличестваСтрок(Загрузка.Строки.Количество());
КонецФункции

// Ошибка количества строк загрузки: нет строк или больше максимума.
//
// Параметры:
//  Количество - Число - строк к загрузке.
//
// Возвращаемое значение:
//  Строка - ошибка; пусто - допустимо.
//
Функция ОшибкаКоличестваСтрок(Количество)
	Если Количество = 0 Тогда
		Возврат НСтр("ru = 'Нечего загружать: в файле нет пригодных строк'; fr = 'Rien à charger : aucune ligne valide';
			|en = 'Nothing to import: no valid rows'; es = 'Nada que cargar: no hay filas válidas'");
	ИначеЕсли Количество > МаксимумСтрок() Тогда
		Шаблон = НСтр("ru = 'Больше %1 строк за одну загрузку'; fr = 'Plus de %1 lignes par chargement';
			|en = 'More than %1 rows per import'; es = 'Más de %1 filas por carga'");
		Возврат СтрШаблон(Шаблон, МаксимумСтрок());
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

// Замена строк при непустой подчинённой табличной части запрещена: связанные строки ссылались бы на другие товары.
//
// Параметры:
//  Объект       - ДокументОбъект, ДанныеФормыСтруктура - документ.
//  ИмяДокумента - Строка - имя документа.
//  ИмяТЧ        - Строка - главная табличная часть.
//
// Возвращаемое значение:
//  Строка - ошибка; пусто - замена допустима.
//
Функция ОшибкаПодчиненныхСтрок(Объект, ИмяДокумента, ИмяТЧ)
	Для Каждого ИмяПодчиненной Из ПодчиненныеТЧДокумента(ИмяДокумента, ИмяТЧ) Цикл
		Если Объект[ИмяПодчиненной].Количество() > 0 Тогда
			Возврат НСтр("ru = 'В документе есть связанные строки (серии, материалы) - загрузите добавлением или очистите их';
				|fr = 'Le document a des lignes liées (séries, matières) - chargez en ajout ou videz-les';
				|en = 'The document has linked rows (series, materials) - load by appending or clear them';
				|es = 'El documento tiene filas vinculadas (series, materiales) - cargue añadiendo o bórrelas'");
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Ошибка состояния документа для загрузки: проведён, помечен на удаление, редактирование запрещено.
//
// Параметры:
//  Объект - ДокументОбъект - документ.
//  МД     - ОбъектМетаданных - метаданные документа.
//
// Возвращаемое значение:
//  Строка - ошибка; пусто - загружать можно.
//
Функция ОшибкаСостоянияДокумента(Объект, МД)
	ТекстОшибки = ОшибкаПроведения(Объект, МД.Имя);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	Если Объект.ПометкаУдаления Тогда
		Возврат НСтр("ru = 'Документ помечен на удаление'; fr = 'Le document est marqué pour suppression';
			|en = 'The document is marked for deletion'; es = 'El documento está marcado para eliminar'");
	КонецЕсли;
	Запрещено = Ложь;
	РаботаСДокументами.МожноРедактироватьДокумент(Объект, Запрещено);
	Если Запрещено Тогда
		Возврат НСтр("ru = 'Документ запрещено редактировать'; fr = 'Le document ne peut pas être modifié';
			|en = 'The document cannot be edited'; es = 'El documento no se puede editar'");
	КонецЕсли;
	Возврат "";
КонецФункции

// Загрузка в проведённый документ запрещена - и записанный документ, и данные формы документа: перепроведение после
// массовой замены строк меняет движения без проверки человеком.
//
// Параметры:
//  Объект       - ДокументОбъект, ДанныеФормыСтруктура - документ.
//  ИмяДокумента - Строка - имя документа.
//
// Возвращаемое значение:
//  Строка - ошибка; пусто - документ не проведён.
//
Функция ОшибкаПроведения(Объект, ИмяДокумента)
	МД = Метаданные.Документы[ИмяДокумента];
	Если МД.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить И Объект.Проведен Тогда
		Возврат НСтр("ru = 'Документ проведён: отмените проведение - загрузка в проведённый документ запрещена';
			|fr = 'Le document est validé : annulez la validation - chargement interdit dans un document validé';
			|en = 'The document is posted: unpost it - importing into a posted document is not allowed';
			|es = 'El documento está contabilizado: anule la contabilización - no se carga en documentos contabilizados'");
	КонецЕсли;
	Возврат "";
КонецФункции

// Запись рассчитанной табличной части в транзакции вызывающего: блокировка, сверка версии, проверка заполнения,
// запись. Нарушение - исключение с текстом причины.
//
// Параметры:
//  Ссылка  - ДокументСсылка - документ.
//  ИмяТЧ   - Строка - табличная часть.
//  Таблица - ТаблицаЗначений - рассчитанные строки.
//  Версия  - Строка - версия данных прочитанного объекта.
//
Процедура ЗаписатьЗагрузку(Ссылка, ИмяТЧ, Таблица, Версия)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Блокировка.Заблокировать();
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект.ВерсияДанных <> Версия Тогда
		ВызватьИсключение НСтр("ru = 'Документ изменён другим пользователем - повторите загрузку';
			|fr = 'Le document a été modifié par un autre utilisateur - recommencez le chargement';
			|en = 'The document was changed by another user - repeat the import';
			|es = 'El documento fue modificado por otro usuario - repita la carga'");
	КонецЕсли;
	Объект[ИмяТЧ].Загрузить(Таблица);
	Если Не Объект.ПроверитьЗаполнение() Тогда
		ВызватьИсключение НСтр("ru = 'Документ не прошёл проверку заполнения - загрузка отменена';
			|fr = 'Le document n''a pas passé le contrôle de saisie - chargement annulé';
			|en = 'The document failed the fill check - import cancelled';
			|es = 'El documento no pasó la comprobación de relleno - carga cancelada'");
	КонецЕсли;
	Объект.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

// Код строки для первой новой строки: максимум существующих + 1.
//
// Параметры:
//  Таблица  - ТаблицаЗначений - прежние строки.
//  Описание - Структура - см. ОписаниеПриемника.
//
// Возвращаемое значение:
//  Число - код; 0 - в строках нет кода.
//
Функция СледующийКодСтроки(Таблица, Описание)
	Если Описание.Реквизиты["КодСтроки"] = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Максимум = 0;
	Для Каждого Строка Из Таблица Цикл
		Максимум = Макс(Максимум, Строка.КодСтроки);
	КонецЦикла;
	Возврат Максимум + 1;
КонецФункции

// Контекст заполнения строк: данные номенклатуры, вид цены по умолчанию, пакет цен.
//
// Параметры:
//  Объект       - ДокументОбъект, ДанныеФормыСтруктура - документ.
//  ИмяДокумента - Строка - имя документа.
//  Описание     - Структура - см. ОписаниеПриемника.
//  Загрузка     - Структура - см. ЗаполнитьТЧ.
//
// Возвращаемое значение:
//  Структура - контекст для ЗаполнитьСтроку.
//
Функция КонтекстЗаполнения(Объект, ИмяДокумента, Описание, Загрузка)
	Сопоставлено = Новый Соответствие;
	Для Каждого Имя Из Загрузка.Сопоставлено Цикл
		Сопоставлено.Вставить(Имя, Истина);
	КонецЦикла;
	ЦенаЗагружена = Сопоставлено[ИмяЦена()] <> Неопределено Или Сопоставлено[ИмяЦенаSKU()] <> Неопределено
		Или Сопоставлено[ИмяСумма()] <> Неопределено;
	Контекст = Новый Структура("Объект, Описание, Сопоставлено", Объект, Описание, Сопоставлено);
	Контекст.Вставить("ЦенаВключаетНДС", РаботаСДокументамиКлиентСервер.ЦенаВключаетНДСДокумента(Объект));
	Контекст.Вставить("ПодбиратьЦену", Описание.ЕстьЦена И Не ЦенаЗагружена И Описание.Класс = ИмяКоличество());
	Контекст.Вставить("Направление", НаправлениеЦены(ИмяДокумента));
	Товары = Новый Массив;
	Для Каждого Данные Из Загрузка.Строки Цикл
		Если Данные.Свойство(ИмяНоменклатура()) И Товары.Найти(Данные.Номенклатура) = Неопределено Тогда
			Товары.Добавить(Данные.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Контекст.Вставить("ДанныеТоваров", ДанныеТоваров(Товары));
	Контекст.Вставить("ВидЦены", ВидЦеныЗагрузки(Объект, Описание, Загрузка, Сопоставлено));
	Контекст.Вставить("КешЦен", Новый Соответствие);
	ДатаЦен = ТекущаяДатаСеанса();
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Объект, "Дата") Тогда
		ДатаЦен = КонецДня(Объект.Дата);
	КонецЕсли;
	Контекст.Вставить("ДатаЦен", ДатаЦен);
	Контекст.Вставить("ПрайсПродажи", Неопределено);
	Контекст.Вставить("ДанныеЦен", Новый Соответствие);
	Если Контекст.ПодбиратьЦену Тогда
		ПодготовитьЦены(Контекст, Загрузка, Товары);
	КонецЕсли;
	Возврат Контекст;
КонецФункции

// Вид цены строк без колонки вида цены: переданный формой документа или по правилу формы документа.
//
// Параметры:
//  Объект       - ДокументОбъект, ДанныеФормыСтруктура - документ.
//  Описание     - Структура - см. ОписаниеПриемника.
//  Загрузка     - Структура - см. ЗаполнитьТЧ.
//  Сопоставлено - Соответствие - сопоставленные колонки.
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыЦен, Неопределено - вид цены; Неопределено - в строках нет вида цены или он из файла.
//
Функция ВидЦеныЗагрузки(Объект, Описание, Загрузка, Сопоставлено)
	Если Описание.Реквизиты[ИмяВидЦены()] = Неопределено Или Сопоставлено[ИмяВидЦены()] <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Загрузка.Свойство(ИмяВидЦены()) И Загрузка.ВидЦены <> Неопределено Тогда
		Возврат Загрузка.ВидЦены;
	КонецЕсли;
	Возврат ВидЦеныДокумента(Объект);
КонецФункции

// Ставка НДС и единица номенклатуры одним запросом.
//
// Параметры:
//  Товары - Массив - номенклатура.
//
// Возвращаемое значение:
//  Соответствие - товар -> Структура (СтавкаНДС, Единица).
//
Функция ДанныеТоваров(Товары)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.СтавкаНДС КАК СтавкаНДС,
	|	Номенклатура.Единица КАК Единица
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Товары)");
	Запрос.УстановитьПараметр("Товары", Товары);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Новый Структура("СтавкаНДС, Единица", Выборка.СтавкаНДС, Выборка.Единица));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Вид цены строки по правилу формы документа: вид цен шапки, пустой - вид цены продажи по умолчанию.
//
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормыСтруктура - документ.
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыЦен - вид цены.
//
Функция ВидЦеныДокумента(Объект)
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Объект, "ВидЦен") И ЗначениеЗаполнено(Объект.ВидЦен) Тогда
		Возврат Объект.ВидЦен;
	КонецЕсли;
	Контрагент = Неопределено;
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Объект, "Контрагент") Тогда
		Контрагент = Объект.Контрагент;
	КонецЕсли;
	Склад = Неопределено;
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Объект, "МестоХранения") Тогда
		Склад = Объект.МестоХранения;
	КонецЕсли;
	Возврат ОбщегоНазначенияВызовСервера.ВидЦеныПродажиПоУмолчанию(Контрагент, Склад);
КонецФункции

// Пакет данных цен: для продажи - срез прайса по всем видам цен загрузки и розничному, данные цен по каждому виду; для
// закупки с поставщиком - прайс поставщика одним запросом.
//
// Параметры:
//  Контекст - Структура - см. КонтекстЗаполнения; заполняются ПрайсПродажи и ДанныеЦен.
//  Загрузка - Структура - см. ЗаполнитьТЧ.
//  Товары   - Массив - номенклатура загрузки.
//
Процедура ПодготовитьЦены(Контекст, Загрузка, Товары)
	Объект = Контекст.Объект;
	Характеристики = Новый Массив;
	ВидыЦен = Новый Массив;
	ВидыЦен.Добавить(Справочники.ВидыЦен.Розничная);
	Для Каждого Данные Из Загрузка.Строки Цикл
		Если Данные.Свойство(ИмяХарактеристика()) Тогда
			Характеристики.Добавить(Данные.Характеристика);
		КонецЕсли;
		ВидЦены = ?(Данные.Свойство(ИмяВидЦены()), Данные.ВидЦены, Контекст.ВидЦены);
		Если ЗначениеЗаполнено(ВидЦены) И ВидыЦен.Найти(ВидЦены) = Неопределено Тогда
			ВидыЦен.Добавить(ВидЦены);
		КонецЕсли;
	КонецЦикла;
	Если Контекст.Направление.Закупка Тогда
		Если Не ПустаяСтрока(Контекст.Направление.РеквизитПоставщика) Тогда
			Поставщик = Объект[Контекст.Направление.РеквизитПоставщика];
			ДанныеЗакупки = ОбщегоНазначенияВызовСервера.ДанныеЦенДляСписка(Поставщик, Истина, Товары, Характеристики,
				Неопределено, Контекст.ДатаЦен);
			Контекст.ДанныеЦен.Вставить("Закупка", ДанныеЗакупки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Контекст.ПрайсПродажи = РегистрыСведений.ЦеныНоменклатуры.ПоследнийПрайс(Контекст.ДатаЦен, ВидыЦен, Товары);
	Контрагент = Неопределено;
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Объект, "Контрагент") Тогда
		Контрагент = Объект.Контрагент;
	КонецЕсли;
	Для Каждого ВидЦены Из ВидыЦен Цикл
		ДанныеВида = ОбщегоНазначенияВызовСервера.ДанныеЦенДляСписка(Контрагент, Ложь, Товары, Характеристики, ВидЦены,
			Контекст.ДатаЦен);
		Контекст.ДанныеЦен.Вставить(ВидЦены, ДанныеВида);
	КонецЦикла;
КонецПроцедуры

// Заполняет строку копии ТЧ: сопоставленные значения, затем умолчания для несопоставленных (упаковка, ставка НДС,
// вид цены, цена), количества, сумма.
//
// Параметры:
//  Стр      - СтрокаТаблицыЗначений - новая строка копии ТЧ.
//  Данные   - Структура - значения строки файла.
//  Контекст - Структура - см. КонтекстЗаполнения.
//
// Возвращаемое значение:
//  Строка - текст ошибки строки; пусто - заполнена.
//
Функция ЗаполнитьСтроку(Стр, Данные, Контекст)
	Описание = Контекст.Описание;
	Для Каждого КлючИЗначение Из Данные Цикл
		Если Контекст.Сопоставлено[КлючИЗначение.Ключ] <> Неопределено Тогда
			Стр[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Стр.Номенклатура) Тогда
		Возврат НСтр("ru = 'не указан товар'; fr = 'article non indiqué'; en = 'item not specified'; es = 'artículo no indicado'");
	КонецЕсли;
	ЗаполнитьУмолчанияСтроки(Стр, Контекст);
	ТекстОшибки = СогласоватьКоличества(Стр, Описание, Контекст.Сопоставлено);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	Если Описание.Класс = ИмяСумма() Тогда
		РассчитатьСуммовуюСтроку(Стр, Описание.Реквизиты, Контекст.ЦенаВключаетНДС);
		Возврат "";
	КонецЕсли;
	Если Контекст.ПодбиратьЦену Тогда
		ПодобратьЦену(Стр, Контекст);
	КонецЕсли;
	Основа = "";
	Если Контекст.Сопоставлено[ИмяСумма()] <> Неопределено Тогда
		Основа = ИмяСумма();
	ИначеЕсли Контекст.Сопоставлено[ИмяЦена()] <> Неопределено Или Контекст.ПодбиратьЦену Тогда
		Основа = ИмяЦена();
	Иначе
		Основа = ""; // цена единицы или без цены: цена считается от ЦенаSKU, сумма - от количества
	КонецЕсли;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, Контекст.ЦенаВключаетНДС, Основа);
	Возврат "";
КонецФункции

// Умолчания для несопоставленных реквизитов строки: упаковка и ставка НДС из карточки товара, вид цены; признак
// нескольких серий - Ложь.
//
// Параметры:
//  Стр      - СтрокаТаблицыЗначений - строка копии ТЧ.
//  Контекст - Структура - см. КонтекстЗаполнения.
//
Процедура ЗаполнитьУмолчанияСтроки(Стр, Контекст)
	Реквизиты = Контекст.Описание.Реквизиты;
	Сопоставлено = Контекст.Сопоставлено;
	Если Реквизиты["УказаноНесколькоСерий"] <> Неопределено Тогда
		Стр.УказаноНесколькоСерий = Ложь;
	КонецЕсли;
	ДанныеТовара = Контекст.ДанныеТоваров[Стр.Номенклатура];
	ЗаполнитьУмолчание = ДанныеТовара <> Неопределено;
	Если ЗаполнитьУмолчание И Реквизиты[ИмяУпаковка()] <> Неопределено И Сопоставлено[ИмяУпаковка()] = Неопределено Тогда
		Стр.Упаковка = ДанныеТовара.Единица;
	КонецЕсли;
	Если ЗаполнитьУмолчание И Реквизиты[ИмяСтавкаНДС()] <> Неопределено И Сопоставлено[ИмяСтавкаНДС()] = Неопределено Тогда
		Стр.СтавкаНДС = ДанныеТовара.СтавкаНДС;
	КонецЕсли;
	Если Реквизиты[ИмяВидЦены()] <> Неопределено И Сопоставлено[ИмяВидЦены()] = Неопределено Тогда
		Стр.ВидЦены = Контекст.ВидЦены;
	КонецЕсли;
КонецПроцедуры

// Пары количеств: сопоставлено одно - второе по коэффициенту упаковки, оба - проверка согласованности.
//
// Параметры:
//  Стр          - СтрокаТаблицыЗначений - строка копии ТЧ.
//  Описание     - Структура - см. ОписаниеПриемника.
//  Сопоставлено - Соответствие - сопоставленные колонки.
//
// Возвращаемое значение:
//  Строка - ошибка; пусто - количества согласованы.
//
Функция СогласоватьКоличества(Стр, Описание, Сопоставлено)
	Коэффициент = 1;
	Если Описание.Реквизиты[ИмяУпаковка()] <> Неопределено И ЗначениеЗаполнено(Стр.Упаковка) Тогда
		Коэффициент = ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы(Стр.Упаковка);
	КонецЕсли;
	Для Каждого Постфикс Из Описание.Постфиксы Цикл
		ИмяКоличества = ИмяКоличество() + Постфикс;
		ИмяУпаковок = ИмяКоличествоУпаковок() + Постфикс;
		ЕстьКоличество = Сопоставлено[ИмяКоличества] <> Неопределено;
		ЕстьУпаковки = Сопоставлено[ИмяУпаковок] <> Неопределено;
		Если ЕстьКоличество И Не ЕстьУпаковки Тогда
			Стр[ИмяУпаковок] = ?(Коэффициент = 0, Стр[ИмяКоличества], Стр[ИмяКоличества] / Коэффициент);
		ИначеЕсли ЕстьУпаковки И Не ЕстьКоличество Тогда
			Стр[ИмяКоличества] = Стр[ИмяУпаковок] * Коэффициент;
		ИначеЕсли ЕстьУпаковки И Стр[ИмяКоличества] <> Стр[ИмяУпаковок] * Коэффициент Тогда
			Возврат НСтр("ru = 'количество не согласовано с количеством упаковок';
				|fr = 'la quantité ne correspond pas au nombre de colis';
				|en = 'quantity does not match the number of packages';
				|es = 'la cantidad no coincide con el número de bultos'");
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Суммовая строка: сумма из файла, НДС по ставке строки и сумма с НДС.
//
// Параметры:
//  Стр             - СтрокаТаблицыЗначений - строка копии ТЧ.
//  Реквизиты       - Соответствие - реквизиты строки.
//  ЦенаВключаетНДС - Булево - режим цен документа.
//
Процедура РассчитатьСуммовуюСтроку(Стр, Реквизиты, ЦенаВключаетНДС)
	Если Реквизиты["СуммаНДС"] = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Стр.СуммаНДС = РаботаСДокументамиКлиентСервер.РассчитатьСуммуНДС(Стр.СтавкаНДС, Стр.Сумма, ЦенаВключаетНДС);
	Если Реквизиты["СуммаСНДС"] <> Неопределено Тогда
		Стр.СуммаСНДС = Стр.Сумма + ?(ЦенаВключаетНДС, 0, Стр.СуммаНДС);
	КонецЕсли;
КонецПроцедуры

// Цена строки тем же путём, что форма документа: структура строки штатным преобразователем с контекстом документа,
// направление подбора, пакет цен; результат кешируется по «товар + характеристика + упаковка + вид цены + ставка».
//
// Параметры:
//  Стр      - СтрокаТаблицыЗначений - строка копии ТЧ.
//  Контекст - Структура - см. КонтекстЗаполнения.
//
Процедура ПодобратьЦену(Стр, Контекст)
	Ключ = КлючЦены(Стр, Контекст.Описание.Реквизиты);
	Цены = Контекст.КешЦен[Ключ];
	Если Цены = Неопределено Тогда
		Цены = ЦеныСтроки(Стр, Контекст);
		Контекст.КешЦен.Вставить(Ключ, Цены);
	КонецЕсли;
	Для Каждого КлючИЗначение Из Цены Цикл
		Стр[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
	КонецЦикла;
КонецПроцедуры

// Ключ кеша цены строки.
//
// Параметры:
//  Стр       - СтрокаТаблицыЗначений - строка копии ТЧ.
//  Реквизиты - Соответствие - реквизиты строки.
//
// Возвращаемое значение:
//  Строка - ключ «товар|характеристика|упаковка|вид цены|ставка».
//
Функция КлючЦены(Стр, Реквизиты)
	Части = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Номенклатура,Характеристика,Упаковка,ВидЦены,СтавкаНДС", ",") Цикл
		Значение = "";
		Если Реквизиты[Имя] <> Неопределено Тогда
			Значение = XMLСтрока(Стр[Имя]);
		КонецЕсли;
		Части.Добавить(Значение);
	КонецЦикла;
	Возврат СтрСоединить(Части, "|");
КонецФункции

// Цены строки по контексту документа (без кеша).
//
// Параметры:
//  Стр      - СтрокаТаблицыЗначений - строка копии ТЧ.
//  Контекст - Структура - см. КонтекстЗаполнения.
//
// Возвращаемое значение:
//  Структура - несопоставленные реквизиты строки «Цена…» с подобранными значениями.
//
Функция ЦеныСтроки(Стр, Контекст)
	Временная = Новый Структура("Номенклатура, Характеристика, Упаковка");
	Для Каждого Колонка Из Стр.Владелец().Колонки Цикл
		Временная.Вставить(Колонка.Имя, Стр[Колонка.Имя]);
	КонецЦикла;
	СтрЦены = РаботаСДокументамиКлиентСервер.ПреобразоватьСтрокуТаблицыВСтруктуру(Временная, Контекст.Объект);
	СтрЦены.Вставить("ДатаЦены", Контекст.ДатаЦен);
	ДанныеЦен = Неопределено;
	ТЗПрайс = Неопределено;
	Если Контекст.Направление.Закупка Тогда
		СтрЦены.Вставить(ИмяПоставщик(), ПоставщикДокумента(Контекст));
		ДанныеЦен = Контекст.ДанныеЦен["Закупка"];
	Иначе
		Если СтрЦены.Свойство(ИмяПоставщик()) Тогда
			СтрЦены.Удалить(ИмяПоставщик());
		КонецЕсли;
		ТЗПрайс = Контекст.ПрайсПродажи;
		ВидЦены = ?(СтрЦены.Свойство(ИмяВидЦены()), СтрЦены.ВидЦены, Справочники.ВидыЦен.Розничная);
		ДанныеЦен = Контекст.ДанныеЦен[ВидЦены];
	КонецЕсли;
	ОбщегоНазначенияВызовСервера.ПолучитьЦенуНоменклатуры(СтрЦены, ТЗПрайс, Контекст.ЦенаВключаетНДС, ДанныеЦен);
	Цены = Новый Структура;
	Для Каждого КлючИЗначение Из СтрЦены Цикл
		Имя = КлючИЗначение.Ключ;
		Если СтрНачинаетсяС(Имя, ИмяЦена()) И Контекст.Описание.Реквизиты[Имя] <> Неопределено
			И Контекст.Сопоставлено[Имя] = Неопределено Тогда
			Цены.Вставить(Имя, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Цены;
КонецФункции

// Поставщик для закупочного подбора цены; у закупки без поставщика - Неопределено.
//
// Параметры:
//  Контекст - Структура - см. КонтекстЗаполнения.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты, Неопределено - поставщик.
//
Функция ПоставщикДокумента(Контекст)
	Реквизит = Контекст.Направление.РеквизитПоставщика;
	Если ПустаяСтрока(Реквизит) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Контекст.Объект[Реквизит];
КонецФункции

#КонецОбласти

#КонецОбласти
