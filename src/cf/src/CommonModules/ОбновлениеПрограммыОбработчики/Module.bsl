	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказаПокупателя.ПустаяСсылка)";

	// Объектная запись каждого заказа в монопольном режиме: число заказов пишется в журнал
	// до цикла, чтобы по журналу было видно, чего ждать на большой базе.
	Результат = Запрос.Выполнить();
	ШаблонНачала = НСтр("ru = 'Вид операции заказов клиентов: к заполнению заказов: %1';
		|fr = 'Type d’opération des commandes clients : commandes à renseigner : %1';
		|en = 'Customer order operation type: orders to populate: %1';
		|es = 'Tipo de operación de pedidos de clientes: pedidos por completar: %1'");
	Выборка = Результат.Выбрать();
	ЗаписатьВЖурнал(СтрШаблон(ШаблонНачала, Выборка.Количество()));

	КоличествоЗаполнено = 0;
	Пока Выборка.Следующий() Цикл
		ОбъектЗаказа = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектЗаказа.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
		ОбъектЗаказа.ОбменДанными.Загрузка = Истина;
		ОбъектЗаказа.Записать();
		КоличествоЗаполнено = КоличествоЗаполнено + 1;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Вид операции заказов клиентов: заполнено заказов: %1';
		|fr = 'Type d’opération des commandes clients : commandes renseignées : %1';
		|en = 'Customer order operation type: orders populated: %1';
		|es = 'Tipo de operación de pedidos de clientes: pedidos completados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоЗаполнено));

КонецПроцедуры

// BSLLS:DeprecatedMethodCall-off - перенос читает устаревший общий реквизит УдалитьАвторОбщий по назначению.
// Переносит автора (общий реквизит УдалитьАвторОбщий) в реквизит Ответственный (2.0.15.28): решение владельца
// 2026-09-14 оставить один из дублирующих реквизитов. Переносится только в пустой Ответственный типа «Пользователь»;
// запись в режиме загрузки не запускает ПередЗаписью и ПриЗаписи, не перепроводит документ и не трогает связанные.
// Авторы, которые не перенесены (Ответственный заполнен другим пользователем, другого типа или его нет), пишутся
// в журнал регистрации парами «объект - автор»: по ним принимается решение перед удалением общего реквизита.
// Повторный запуск выбирает только записи с пустым ответственным.
//
Процедура ПеренестиАвтораВОтветственного() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Реквизит = Метаданные.ОбщиеРеквизиты.УдалитьАвторОбщий;
	ТипПользователя = Тип("СправочникСсылка.Пользователи");
	Перенесено = 0;
	НеПеренесено = 0;
	Для Каждого ЭлементСостава Из Реквизит.Состав Цикл
		ОбъектМетаданных = ЭлементСостава.Метаданные;
		Если Не ОбщийРеквизитИспользуется(Реквизит, ЭлементСостава) Или Не ОбъектСРеквизитами(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		РеквизитОтветственный = ОбъектМетаданных.Реквизиты.Найти("Ответственный");
		Если РеквизитОтветственный <> Неопределено И РеквизитОтветственный.Тип.СодержитТип(ТипПользователя) Тогда
			Перенесено = Перенесено + ПеренестиАвтораОбъекта(ОбъектМетаданных, РеквизитОтветственный);
			НеПеренесено = НеПеренесено + ЗаписатьНеперенесенныхАвторов(ОбъектМетаданных, Истина);
		Иначе
			НеПеренесено = НеПеренесено + ЗаписатьНеперенесенныхАвторов(ОбъектМетаданных, Ложь);
		КонецЕсли;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Автор в ответственного: перенесено записей: %1, не перенесено: %2';
		|fr = 'Auteur vers responsable : enregistrements transférés : %1, non transférés : %2';
		|en = 'Author to person responsible: records transferred: %1, not transferred: %2';
		|es = 'Autor a responsable: registros trasladados: %1, no trasladados: %2'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, Перенесено, НеПеренесено));

КонецПроцедуры
// BSLLS:DeprecatedMethodCall-on

// Заполняет пустой способ пополнения у существующих элементов номенклатуры (E2).
// Группы и явно выбранные значения, включая "Оба", не изменяются. Запись в режиме
// загрузки сохраняет прежнюю ветку ПередЗаписью; значение задаётся здесь явно.
// Повторный запуск не выбирает уже обработанные элементы.
//
Процедура ЗаполнитьСпособыПополненияЗапасов() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И Номенклатура.СпособПополнения = ЗНАЧЕНИЕ(Перечисление.СпособыПополненияЗапасов.ПустаяСсылка)";

	КоличествоЗаполнено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектНоменклатуры = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектНоменклатуры.СпособПополнения = Справочники.Номенклатура.СпособПополненияПоУмолчанию(
			Выборка.ТипНоменклатуры);
		ОбъектНоменклатуры.ОбменДанными.Загрузка = Истина;
		ОбъектНоменклатуры.Записать();
		КоличествоЗаполнено = КоличествоЗаполнено + 1;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Способы пополнения запасов: заполнено элементов: %1';
		|fr = 'Modes de réapprovisionnement des stocks : articles renseignés : %1';
		|en = 'Inventory replenishment methods: items populated: %1';
		|es = 'Métodos de reposición de existencias: artículos completados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоЗаполнено));

КонецПроцедуры

// Переносит прежнюю табличную часть номенклатуры в документы технологических карт (E1).
// Выполняется монопольно механизмом обновления. Каждая запись документа и его движений
// атомарна; повтор после сбоя пропускает уже перенесённую продукцию. Любая запись регистра,
// включая будущую версию и маркер отмены, запрещает перенос. Записанные вручную документы
// без движений тоже сохраняются. Исходная табличная часть остаётся для совместимости.
//
Процедура ПеренестиТехнологическиеКарты() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтарыйСостав.Ссылка КАК Продукция,
	|	СпрНоменклатура.ДатаСоздания КАК ДатаСоздания,
	|	СтарыйСостав.НомерСтроки КАК НомерСтроки,
	|	СтарыйСостав.Номенклатура КАК Номенклатура,
	|	СтарыйСостав.ЕИ КАК Упаковка,
	|	СтарыйСостав.Количество КАК Количество
	|ИЗ
	|	Справочник.Номенклатура.ТехнологическаяКарта КАК СтарыйСостав
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО СтарыйСостав.Ссылка = СпрНоменклатура.Ссылка
	|ГДЕ
	|	НЕ СтарыйСостав.Ссылка В
	|		(ВЫБРАТЬ Состав.Продукция КАК Продукция ИЗ РегистрСведений.СоставТехКарты КАК Состав)
	|	И НЕ СтарыйСостав.Ссылка В
	|		(ВЫБРАТЬ Карта.Номенклатура КАК Продукция ИЗ Документ.ТехнологическаяКарта КАК Карта)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Продукция,
	|	НомерСтроки
	|ИТОГИ
	|	МАКСИМУМ(ДатаСоздания)
	|ПО
	|	Продукция";

	КоличествоПеренесено = 0;
	Продукция = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Продукция.Следующий() Цикл
		Карта = Документы.ТехнологическаяКарта.СоздатьДокумент();
		Карта.Заполнить(Неопределено);
		Карта.Номенклатура = Продукция.Продукция;
		Карта.Дата = ?(ЗначениеЗаполнено(Продукция.ДатаСоздания), Продукция.ДатаСоздания, Дата(2000, 1, 1));
		СтрокиСостава = Продукция.Выбрать();
		Пока СтрокиСостава.Следующий() Цикл
			// В прежней карте характеристики нет; в новой строке остаётся пустая ссылка.
			ЗаполнитьЗначенияСвойств(Карта.ТЧМатериалы.Добавить(), СтрокиСостава,
				"Номенклатура, Упаковка, Количество");
		КонецЦикла;
		Карта.Записать(РежимЗаписиДокумента.Проведение);
		КоличествоПеренесено = КоличествоПеренесено + 1;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Перенос технологических карт: создано документов: %1';
		|fr = 'Transfert des gammes de fabrication : documents créés : %1';
		|en = 'Production routing migration: documents created: %1';
		|es = 'Traslado de rutas de fabricación: documentos creados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоПеренесено));

КонецПроцедуры

// Проставляет способ изготовления "Наше производство" в технологических картах, заведённых до его
// появления (S1 волны переработки). Процент потерь не трогается: ноль и так ноль.
//
// Правится и документ, и движения, и по отдельности этого мало. Только регистр - первое же
// перепроведение старой карты перезапишет движения из ТЧМатериалы документа пустым значением.
// Только документ - действующие версии в регистре останутся пустыми до перепроведения, и состав
// карты вернёт пустой способ и в карточку номенклатуры, и в перенос значений при проведении заказа.
//
// Документы записываются без проведения: перепроведение всех карт базы подняло бы блокировки и
// сдвинуло движения, а признак проведения и движения запись в режиме загрузки не трогает.
// Маркерная запись отмены карты (пустой материал) остаётся с пустым способом - её отсекают все
// чтения состава. Идемпотентность держится на отборах "способ не заполнен": повтор после сбоя
// не выбирает уже обработанное.
//
Процедура ЗаполнитьСпособыИзготовленияТехкарт() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Материалы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТехнологическаяКарта.ТЧМатериалы КАК Материалы
	|ГДЕ
	|	Материалы.СпособИзготовления = ЗНАЧЕНИЕ(Перечисление.СпособыИзготовления.ПустаяСсылка)
	|	И Материалы.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";

	КартПравлено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карта = Выборка.Ссылка.ПолучитьОбъект();
		// Умолчание по номенклатуре (2.0.16.103): закупаемый материал - «Закупка».
		Умолчания = ТехнологическиеКарты.СпособыИзготовленияПоУмолчанию(Карта.ТЧМатериалы.ВыгрузитьКолонку("Номенклатура"));
		Для Каждого Стр Из Карта.ТЧМатериалы Цикл
			// Строка без материала способа не получает - так же, как маркерная запись отмены карты
			// в движениях: обе описывают «материала нет», а не способ его изготовления.
			Если ЗначениеЗаполнено(Стр.Номенклатура) И Не ЗначениеЗаполнено(Стр.СпособИзготовления) Тогда
				Стр.СпособИзготовления = Умолчания[Стр.Номенклатура];
			КонецЕсли;
		КонецЦикла;
		Карта.ОбменДанными.Загрузка = Истина;
		Карта.Записать();
		КартПравлено = КартПравлено + 1;
	КонецЦикла;

	ЗапросДвижений = Новый Запрос;
	ЗапросДвижений.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Состав.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.СоставТехКарты КАК Состав
	|ГДЕ
	|	Состав.СпособИзготовления = ЗНАЧЕНИЕ(Перечисление.СпособыИзготовления.ПустаяСсылка)
	|	И Состав.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";

	НаборовПравлено = 0;
	ВыборкаДвижений = ЗапросДвижений.Выполнить().Выбрать();
	Пока ВыборкаДвижений.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.СоставТехКарты.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДвижений.Регистратор);
		НаборЗаписей.Прочитать();
		Умолчания = ТехнологическиеКарты.СпособыИзготовленияПоУмолчанию(НаборЗаписей.ВыгрузитьКолонку("Материал"));
		Для Каждого Запись Из НаборЗаписей Цикл
			Если ЗначениеЗаполнено(Запись.Материал) И Не ЗначениеЗаполнено(Запись.СпособИзготовления) Тогда
				Запись.СпособИзготовления = Умолчания[Запись.Материал];
			КонецЕсли;
		КонецЦикла;
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать();
		НаборовПравлено = НаборовПравлено + 1;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Способы изготовления техкарт: документов: %1, наборов движений: %2';
		|fr = 'Modes de fabrication des gammes : documents : %1, jeux de mouvements : %2';
		|en = 'Routing manufacturing methods: documents: %1, movement sets: %2';
		|es = 'Métodos de fabricación de rutas: documentos: %1, conjuntos de movimientos: %2'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КартПравлено, НаборовПравлено));

КонецПроцедуры

// Способ «Закупка» у закупаемых материалов технологических карт (2.0.16.103, решение владельца 2026-10-27): строки
// документов карт и записи СоставТехКарты со способом «Наше производство» (или пустым) у номенклатуры, которая не
// производится по карте, получают «Закупка». Поведение не меняется - закупаемый материал и раньше был листом
// разворачивания (Производство.ПроизводитсяПоТехкарте); меняется показ и умолчание. Документы записываются в режиме
// загрузки, без перепроведения и без новой версии карты; движения - наборами по регистратору в том же режиме. Карта и
// её движения правятся одинаково, поэтому сверка способа при проведении заказа (СвойстваИзготовленияОтличаются)
// расхождения не видит. Повтор ничего не выбирает: «Закупка» не попадает в отбор.
//
Процедура УстановитьСпособЗакупкаМатериаловТехкарт() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Способы = Перечисления.СпособыИзготовления;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Материалы.Ссылка КАК Ссылка,
	|	Материалы.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ТехнологическаяКарта.ТЧМатериалы КАК Материалы
	|ГДЕ
	|	Материалы.СпособИзготовления В (&Способы)
	|	И Материалы.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Состав.Регистратор КАК Ссылка,
	|	Состав.Материал КАК Номенклатура
	|ИЗ
	|	РегистрСведений.СоставТехКарты КАК Состав
	|ГДЕ
	|	Состав.СпособИзготовления В (&Способы)
	|	И Состав.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	Заменяемые = Новый Массив;
	Заменяемые.Добавить(Способы.НашеПроизводство);
	Заменяемые.Добавить(Способы.ПустаяСсылка());
	Запрос.УстановитьПараметр("Способы", Заменяемые);
	Результаты = Запрос.ВыполнитьПакет();
	СтрокиКарт = Результаты[0].Выгрузить();
	СтрокиДвижений = Результаты[1].Выгрузить();
	// Номенклатура строк карт и движений - без повторов, один массив на запрос реквизитов.
	ИмяКолонки = "Номенклатура";
	ВсеПозиции = СтрокиКарт.Скопировать(, ИмяКолонки);
	Для Каждого Строка Из СтрокиДвижений Цикл
		ВсеПозиции.Добавить().Номенклатура = Строка.Номенклатура;
	КонецЦикла;
	ВсеПозиции.Свернуть(ИмяКолонки);
	Умолчания = ТехнологическиеКарты.СпособыИзготовленияПоУмолчанию(ВсеПозиции.ВыгрузитьКолонку(ИмяКолонки));

	КартПравлено = 0;
	Для Каждого Ссылка Из СсылкиСЗакупаемыми(СтрокиКарт, Умолчания) Цикл
		Карта = Ссылка.ПолучитьОбъект();
		Для Каждого Стр Из Карта.ТЧМатериалы Цикл
			Если Заменяемые.Найти(Стр.СпособИзготовления) <> Неопределено
				И Умолчания[Стр.Номенклатура] = Способы.Закупка Тогда
				Стр.СпособИзготовления = Способы.Закупка;
			КонецЕсли;
		КонецЦикла;
		Карта.ОбменДанными.Загрузка = Истина;
		Карта.Записать();
		КартПравлено = КартПравлено + 1;
	КонецЦикла;

	НаборовПравлено = 0;
	Для Каждого Регистратор Из СсылкиСЗакупаемыми(СтрокиДвижений, Умолчания) Цикл
		НаборЗаписей = РегистрыСведений.СоставТехКарты.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
		НаборЗаписей.Прочитать();
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Заменяемые.Найти(Запись.СпособИзготовления) <> Неопределено
				И Умолчания[Запись.Материал] = Способы.Закупка Тогда
				Запись.СпособИзготовления = Способы.Закупка;
			КонецЕсли;
		КонецЦикла;
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать();
		НаборовПравлено = НаборовПравлено + 1;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Способ «Закупка» у закупаемых материалов техкарт: документов: %1, наборов движений: %2';
		|fr = 'Mode « Achat » des matières achetées des gammes : documents : %1, jeux de mouvements : %2';
		|en = 'Purchase method for purchased routing materials: documents: %1, movement sets: %2';
		|es = 'Método «Compra» de los materiales comprados de las rutas: documentos: %1, conjuntos de movimientos: %2'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КартПравлено, НаборовПравлено));

КонецПроцедуры

// Проставляет признак ЦенаВключаетНДС в документах, введённых до его появления (волна 9).
// История продаж велась в ценах с НДС; признак проставляется прямой записью реквизита,
// без перепроведения (wave9-check.md, п. 2).
//
Процедура ЗаполнитьПризнакЦенаВключаетНДС() Экспорт

	МоментОбновления = ТекущаяДатаСеанса();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.НалоговаяНакладная КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.ВозвратОтПокупателя КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.ВозвратОтПокупателяНалоговый КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.ОприходованиеТоваров КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления";
	Запрос.УстановитьПараметр("МоментОбновления", МоментОбновления);

	КоличествоОбновлено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.ЦенаВключаетНДС = Истина;
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();
		КоличествоОбновлено = КоличествоОбновлено + 1;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Заполнение ЦенаВключаетНДС: обновлено документов: %1';
		|fr = 'Remplissage de PrixTTC : documents mis à jour : %1';
		|en = 'Filling of PriceIncludesVAT: documents updated: %1';
		|es = 'Relleno de PrecioIncluyeIVA: documentos actualizados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоОбновлено));

КонецПроцедуры

// Заполняет измерение ОбъектРасчётов налоговых регистров взаиморасчётов (волна 10)
// значением реквизита ДокументДвижения, без перепроведения (wave10-check.md, п. 3.3).
//
Процедура ЗаполнитьОбъектРасчётовНалоговыхРегистров() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	|ГДЕ
	|	Т.ОбъектРасчётов = НЕОПРЕДЕЛЕНО
	|	И Т.ДокументДвижения <> НЕОПРЕДЕЛЕНО";
	ЗаполнитьОбъектРасчётовРегистра("ВзаиморасчётыСПокупателямиНалоговый", Запрос);

	// Во втором регистре латинская "c" в имени - как в метаданных.
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "СПокупателями", "СПоcтавщиками");
	ЗаполнитьОбъектРасчётовРегистра("ВзаиморасчётыСПоcтавщикамиНалоговый", Запрос);

КонецПроцедуры

// Пересчитывает производственные статусы заказов покупателей (волна 12) по проведённым
// производственным документам: статус берётся по последнему связанному документу, запись
// в историю добавляется, только если статус отличается.
//
Процедура ЗаполнитьПроизводственныеСтатусыЗаказов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Основание КАК Основание
	|ИЗ
	|	Документ.ПередачаВПереработку КАК Т
	|ГДЕ
	|	Т.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Основание
	|ИЗ
	|	Документ.ПоступлениеИзПереработки КАК Т
	|ГДЕ
	|	Т.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Основание
	|ИЗ
	|	Документ.ВыпускПродукции КАК Т
	|ГДЕ
	|	Т.Проведен";

	КоличествоЗаказов = 0;
	ОбработанныеЗаказы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Заказ = РаботаСДокументами.ПолучитьДокументРодительПоТипу(
			Тип("ДокументСсылка.ЗаказПокупателя"), Выборка.Основание);
		Если ЗначениеЗаполнено(Заказ) И ОбработанныеЗаказы[Заказ] = Неопределено Тогда
			ОбработанныеЗаказы.Вставить(Заказ, Истина);
			РаботаСДокументами.ОбновитьСтатусЗаказаПоСвязанным(Заказ);
			КоличествоЗаказов = КоличествоЗаказов + 1;
		КонецЕсли;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Заполнение производственных статусов: пересчитано заказов: %1';
		|fr = 'Remplissage des statuts de production : commandes recalculées : %1';
		|en = 'Filling of production statuses: orders recalculated: %1';
		|es = 'Relleno de los estados de producción: pedidos recalculados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоЗаказов));

КонецПроцедуры

// Размечает «ПришлоБезЗаказа» существующих движений закупок регистра ПотребностиПроизводства у заказов клиентов с
// прямыми закупками - без заказа поставщику (план arm-purchasing-receipts-s2, Р1.5): прямое поступление и ордер - всё
// их «Пришло», по заказу - ноль; возврат - на том же ключе сначала со своего кармана, затем с другого (перелив Р1.3),
// по полным ёмкостям приходов ключа. Ключи и «Пришло» не меняются, документы не перепроводятся; ключ с отрицательным
// карманом (испорченные исторические данные) - предупреждение в журнал. Стадии этих заказов и заказов со взятым со
// склада пересчитываются. Повтор вычисляет те же значения и ничего не пишет.
//
Процедура ЗаполнитьПришлоБезЗаказа() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Заказ КАК Заказ
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства КАК Движения
	|ГДЕ
	|	Движения.Активность
	|	И Движения.Пришло <> 0
	|	И Движения.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|	И НЕ ВЫРАЗИТЬ(Движения.Регистратор КАК Документ.ПоступлениеТоваровУслуг).Основание ССЫЛКА Документ.ЗаказПоставщику
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Движения.Заказ
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства КАК Движения
	|ГДЕ
	|	Движения.Активность
	|	И Движения.Пришло <> 0
	|	И Движения.Регистратор ССЫЛКА Документ.ПриходныйОрдер
	|	И НЕ ВЫРАЗИТЬ(Движения.Регистратор КАК Документ.ПриходныйОрдер).Основание ССЫЛКА Документ.ЗаказПоставщику
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Движения.Заказ
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства КАК Движения
	|ГДЕ
	|	Движения.Активность
	|	И Движения.Пришло <> 0
	|	И Движения.Регистратор ССЫЛКА Документ.ВозвратПоставщику
	|	И НЕ ВЫРАЗИТЬ(ВЫРАЗИТЬ(Движения.Регистратор КАК Документ.ВозвратПоставщику).Основание
	|			КАК Документ.ПоступлениеТоваровУслуг).Основание ССЫЛКА Документ.ЗаказПоставщику";
	ТаблицаЗаказов = Запрос.Выполнить().Выгрузить();
	ТаблицаЗаказов.Свернуть("Заказ");
	Заказы = ТаблицаЗаказов.ВыгрузитьКолонку("Заказ");
	Для Каждого Заказ Из Заказы Цикл
		РазметитьПришлоБезЗаказаЗаказа(Заказ);
		ЗаписатьОтрицательноеПришлоЗаказа(Заказ);
	КонецЦикла;
	// Стадии - и у заказов со взятым со склада: «ИзОстатка» больше не перекрывается «Заказано» (ревью данных, P2).
	Для Каждого Заказ Из ЗаказыДляПересчетаСтадий(Заказы) Цикл
		ПроизводственныеЗаказы.ЗаписатьСтадиюЗаказа(Заказ);
	КонецЦикла;
	ШаблонСообщения = НСтр("ru = 'Потребности производства: размечено заказов с поступлениями без заказа поставщику: %1';
		|fr = 'Besoins de production : commandes marquées avec réceptions sans commande fournisseur : %1';
		|en = 'Production needs: orders with receipts without a supplier order marked: %1';
		|es = 'Necesidades de producción: pedidos marcados con recepciones sin pedido a proveedor: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, Заказы.Количество()));

КонецПроцедуры

// Заполняет измерение ЗаказПокупателя регистра ТоварыВПереработке (волна 12) по цепочке
// оснований регистратора, наборами записей, без перепроведения.
//
Процедура ЗаполнитьЗаказВДвиженияхПереработки() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыВПереработке КАК Т
	|ГДЕ
	|	Т.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)";

	КоличествоРегистраторов = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Заказ = РаботаСДокументами.ПолучитьДокументРодительПоТипу(
			Тип("ДокументСсылка.ЗаказПокупателя"), Выборка.Регистратор.Основание);
		Если Не ЗначениеЗаполнено(Заказ) Тогда
			Продолжить;
		КонецЕсли;
		НаборЗаписей = РегистрыНакопления.ТоварыВПереработке.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		ЕстьИзменения = Ложь;
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Не ЗначениеЗаполнено(Запись.ЗаказПокупателя) Тогда
				Запись.ЗаказПокупателя = Заказ;
				ЕстьИзменения = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьИзменения Тогда
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
			НаборЗаписей.Записать();
			КоличествоРегистраторов = КоличествоРегистраторов + 1;
		КонецЕсли;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Заполнение заказа в движениях переработки: обновлено документов: %1';
		|fr = 'Remplissage de la commande dans les mouvements de sous-traitance : documents mis à jour : %1';
		|en = 'Filling of the order in processing movements: documents updated: %1';
		|es = 'Relleno del pedido en los movimientos de procesamiento: documentos actualizados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоРегистраторов));

КонецПроцедуры

// Создаёт строку ТЧГотоваяПродукция документа ВыпускПродукции (волна 12) из шапки
// исторических документов, прямой записью, без перепроведения.
//
Процедура ЗаполнитьГотовуюПродукциюВыпусков() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК Т
	|ГДЕ
	|	Т.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И НЕ Т.Ссылка В
	|			(ВЫБРАТЬ
	|				ТЧ.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ТЧ)";

	КоличествоОбновлено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		НоваяСтрока = ДокОбъект.ТЧГотоваяПродукция.Добавить();
		НоваяСтрока.КодСтроки = 1;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДокОбъект,
			"Номенклатура, Характеристика, Серия, Упаковка, КоличествоУпаковок, Количество");
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();
		КоличествоОбновлено = КоличествоОбновлено + 1;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Заполнение готовой продукции выпусков: обновлено документов: %1';
		|fr = 'Remplissage des produits finis des sorties de production : documents mis à jour : %1';
		|en = 'Filling of finished products of production issues: documents updated: %1';
		|es = 'Relleno de productos terminados de las emisiones: documentos actualizados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоОбновлено));

КонецПроцедуры

// Ставит признак «Создан автоматически» выпускам, созданным механизмом автовыпуска до появления реквизита
// (сборка 2.0.15.42). До неё автовыпуск опознавался по основанию-реализации, и условие здесь - ровно то же:
// поведение существующих документов не меняется, меняется только способ их опознать.
//
// Пустая ссылка-основание не годится: Производство.ЭтоРеализация требует и тип, и заполненность, а выпуск,
// которому выбрали тип основания без документа, получил бы признак и стал неправимым навсегда - механизм
// его не перезаполнит, он ищет свои выпуски по заполненному основанию.
//
// Запись в режиме загрузки: движения, стадии заказов и проведение не трогаются, признак в их формировании
// не участвует. Помеченные на удаление заполняются тоже. Повторный запуск уже обработанные не выбирает.
//
Процедура ЗаполнитьПризнакАвтовыпусков() Экспорт

	// Режим ставится явно, а не наследуется от ВыполнитьОбновление: обработчик вызывается ещё и напрямую
	// из сценария ТестыДокументов, без этой обёртки.
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК Т
	|ГДЕ
	|	НЕ Т.СозданАвтоматически
	|	И Т.Основание ССЫЛКА Документ.РеализацияТоваровУслуг
	|	И Т.Основание <> ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)";

	// Объектная запись каждого выпуска в монопольном режиме: число выпусков пишется в журнал до цикла,
	// чтобы по журналу было видно, чего ждать на большой базе.
	Выборка = Запрос.Выполнить().Выбрать();
	ШаблонНачала = НСтр("ru = 'Признак автосоздания выпусков: к заполнению документов: %1';
		|fr = 'Indicateur de création automatique des productions : documents à renseigner : %1';
		|en = 'Automatic creation flag of production outputs: documents to populate: %1';
		|es = 'Indicador de creación automática de las producciones: documentos por completar: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонНачала, Выборка.Количество()));

	КоличествоОбновлено = 0;
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.СозданАвтоматически = Истина;
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();
		КоличествоОбновлено = КоличествоОбновлено + 1;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Признак автосоздания выпусков: обновлено документов: %1';
		|fr = 'Indicateur de création automatique des productions : documents mis à jour : %1';
		|en = 'Automatic creation flag of production outputs: documents updated: %1';
		|es = 'Indicador de creación automática de las producciones: documentos actualizados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоОбновлено));

КонецПроцедуры

// Поступления из переработки до сборки 2.0.15.48: стоимость услуг переработчика раскладывается по строкам продукции,
// признак ручной правки сырья ставится там, где сырьё документа расходится с расчётом по его продукции (S6).
//
// Услуги - по весам технологических карт на дату документа, тем же правилом, что проведение делило их до S6: при
// ручном перепроведении себестоимость строки совпадёт с прежней до копеек округления. Шапка документа - стоимость
// услуг и НДС - не меняется (ревью плана S6, P1-1): иначе шапка разошлась бы с движениями взаиморасчётов, которые
// запись в режиме загрузки не трогает.
//
// Признак ручного сырья: откуда сырьё старого документа (весь остаток передачи до S5-B или правка руками), не знает
// никто, поэтому решает сверка с расчётом (Документы.ПоступлениеИзПереработки.СырьеСовпадаетСРасчетом). Совпало -
// рабочее место производства может его править; расходится - только форма документа (ревью плана S6, P2-1).
//
// Запись в режиме загрузки: проведение, движения и стадии заказов не трогаются. Повтор ничего не пишет: у документа с
// разнесёнными услугами и взведённым признаком менять нечего, а совпадающее с расчётом сырьё признака не получает.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.ПоступлениеИзПереработки, Неопределено - обрабатываемые документы; не задан -
//           все. Сценарий ТестыДокументов передаёт свои документы, чтобы не менять документы общей базы прогона.
//
Процедура ЗаполнитьУслугиИПризнакПоступленийИзПереработки(Ссылки = Неопределено) Экспорт

	// Режим ставится явно: обработчик вызывается ещё и напрямую из сценария, без обёртки ВыполнитьОбновление.
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеИзПереработки КАК Т
	|ГДЕ
	|	&УсловиеОтбора
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Дата,
	|	Т.Ссылка";
	Если Ссылки = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", "ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", "Т.Ссылка В (&Документы)");
		Запрос.УстановитьПараметр("Документы", Ссылки);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	ШаблонНачала = НСтр("ru = 'Услуги и признак сырья поступлений из переработки: к проверке документов: %1';
		|fr = 'Services et indicateur de matières des réceptions de sous-traitance : documents à vérifier : %1';
		|en = 'Services and materials flag of subcontracting receipts: documents to check: %1';
		|es = 'Servicios e indicador de materias de las recepciones de subcontratación: documentos por revisar: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонНачала, Выборка.Количество()));

	МенеджерДокумента = Документы.ПоступлениеИзПереработки;
	КоличествоОбновлено = 0;
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Изменен = Ложь;
		Строки = ДокОбъект.ТЧГотоваяПродукция;
		Если ДокОбъект.СтоимостьУслуг <> 0 И Строки.Количество() > 0 И Строки.Итог("СтоимостьУслуг") = 0 Тогда
			// Шапка сохраняется как есть: процедура распределения пишет в неё ту же сумму.
			МенеджерДокумента.РаспределитьСтоимостьУслуг(ДокОбъект, ДокОбъект.СтоимостьУслуг);
			Изменен = Истина;
		КонецЕсли;
		Если Не ДокОбъект.СырьеИзмененоВручную И ДокОбъект.ТЧТовары.Количество() > 0
			И Не СырьеПоступленияПоРасчету(ДокОбъект) Тогда
			ДокОбъект.СырьеИзмененоВручную = Истина;
			Изменен = Истина;
		КонецЕсли;
		Если Изменен Тогда
			ДокОбъект.ОбменДанными.Загрузка = Истина;
			ДокОбъект.Записать();
			КоличествоОбновлено = КоличествоОбновлено + 1;
		КонецЕсли;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Услуги и признак сырья поступлений из переработки: обновлено документов: %1';
		|fr = 'Services et indicateur de matières des réceptions de sous-traitance : documents mis à jour : %1';
		|en = 'Services and materials flag of subcontracting receipts: documents updated: %1';
		|es = 'Servicios e indicador de materias de las recepciones de subcontratación: documentos actualizados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоОбновлено));

КонецПроцедуры

// Включает функциональные опции перестройки меню (2.0.16.5), зарегистрирован дважды - для существующих баз
// и для новых: у клиента не должно пропасть ничего, что было в меню. Регламентированный учёт повторяет
// опцию «Бухгалтерия»: план счетов и регистр проводок до этой версии прятала она - так скрытое остаётся
// скрытым и в старой базе, и в новой (там бухгалтерия выключена, пока её не включат в мастере или в
// «Параметрах»). Пишет только выключенные константы, поэтому повтор после сбоя обновления включит лишь то,
// что не успело включиться; опцию, выключенную между проходами, он включит снова.
//
Процедура ВключитьНовыеФункциональныеОпции() Экспорт

	ВключитьОпции(Константы.Бухгалтерия.Получить());

КонецПроцедуры

// Имена констант функциональных опций перестройки меню, которые включает обновление 2.0.16.5. Список
// не пополнять: обработчик уже выполнен в базах на 2.0.16.5 и выше, новая опция требует своего обработчика
// новой версии.
//
// Возвращаемое значение:
//  Массив из Строка - имена констант без «ИспользоватьРегламентированныйУчет»: её значение задаётся отдельно
//
Функция КонстантыНовыхФункциональныхОпций() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("ИспользоватьИмпорт");
	Имена.Добавить("ИспользоватьЗаказыПокупателей");
	Имена.Добавить("ИспользоватьКоммерческиеПредложения");
	Имена.Добавить("ИспользоватьЗадачиЗаказов");
	Имена.Добавить("ИспользоватьЗаявкиНаПоискТовара");
	Имена.Добавить("ИспользоватьРозничныеПродажи");
	Имена.Добавить("ИспользоватьПравилаЦенообразования");
	Имена.Добавить("ИспользоватьЯчейки");
	Имена.Добавить("ИспользоватьПересчеты");
	Имена.Добавить("ИспользоватьКомплектацию");
	Имена.Добавить("ИспользоватьПереработку");
	Имена.Добавить("ИспользоватьАльтернативныеОплаты");
	Имена.Добавить("ИспользоватьЛиды");
	Имена.Добавить("ИспользоватьЛичныйКабинет");
	Возврат Имена;

КонецФункции

// Переводит в основную валюту суммы документов, оформленных в валюте до 2.0.16.22 (без перепроведения),
// в одной транзакции; повторный запуск ничего не меняет:
// 1) поступления с валютой, отличной от основной, получают флажок ВВалюте и суммы в основной валюте;
// 2) движения ВзаиморасчётыСПоставщиками и ЗаказыПоставщикам проведённых документов в валюте (поступления,
//    возвраты поставщику, налоговые документы закупки) пересобираются текущим кодом проведения: в этих
//    наборах вперемешку суммы в валюте (долг) и в основной валюте (зачёт авансов, оплаты на накладной),
//    поэтому записи не умножаются на курс, а строятся заново из документа;
// 3) записи других регистраторов (оплаты, корректировки, сертификаты) по объектам расчётов в валюте уже
//    в основной валюте: им проставляются валюта объекта и сумма в ней.
//
Процедура ПеревестиВалютныеВзаиморасчётыВОсновнуюВалюту() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		Итоги = ПеревестиВалютныеДокументыВОсновнуюВалюту();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ШаблонСообщения = НСтр("ru = 'Документы в валюте: поступлений отмечено %1, документов пересобрано %2, записей оплат по ним %3';
		|fr = 'Documents en devise : réceptions marquées %1, documents reconstruits %2, enregistrements de paiements %3';
		|en = 'Foreign-currency documents: receipts flagged %1, documents rebuilt %2, payment records %3';
		|es = 'Documentos en moneda: recepciones marcadas %1, documentos reconstruidos %2, registros de pagos %3'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, Итоги.Поступлений, Итоги.Документов, Итоги.ЗаписейОплат));

КонецПроцедуры

// Оплаты в валюте (2.0.16.23): реквизиты предопределённой статьи «Курсовые разницы» и порядок строки
// «Écarts de change» финансового результата; списания безналичных без курса (оформленные раньше, валюта
// туда копировалась из основания, а проводились они в основной валюте) - основная валюта и курс 1, чтобы
// не стать валютными объектами расчётов. Повторный запуск ничего не меняет.
//
Процедура ЗаполнитьДанныеОплатВВалюте() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Статья = Справочники.СтатьиДвиженияДенежныхСредств.КурсовыеРазницы.ПолучитьОбъект();
	Если Не Статья.ДоходыИУбытки Или Статья.ВидУбытков <> Перечисления.ВидыУбытков.Прочее Тогда
		Статья.ДоходыИУбытки = Истина;
		Статья.ВидУбытков = Перечисления.ВидыУбытков.Прочее;
		Статья.Записать();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(Т.Порядок), 0) КАК Порядок
	|ИЗ
	|	Справочник.СтатьиФинансовогоРезультата КАК Т
	|ГДЕ
	|	Т.Ссылка <> ЗНАЧЕНИЕ(Справочник.СтатьиФинансовогоРезультата.EcartsDeChange)";
	МаксимальныйПорядок = Запрос.Выполнить().Выгрузить()[0].Порядок;
	Строка = Справочники.СтатьиФинансовогоРезультата.EcartsDeChange.ПолучитьОбъект();
	Если Строка.Порядок = 0 Тогда
		Строка.Порядок = МаксимальныйПорядок + 1;
		Строка.Записать();
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств КАК Т
	|ГДЕ
	|	Т.КурсВалюты = 0";
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.Валюта = РаботаСВалютами.ОсновнаяВалюта();
		ДокОбъект.КурсВалюты = 1;
		ДокОбъект.СуммаВВалютеРеглУчета = ДокОбъект.Сумма;
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();
		Количество = Количество + 1;
	КонецЦикла;
	Шаблон = НСтр("ru = 'Оплаты в валюте: списаний безналичных переведено в основную валюту %1';
		|fr = 'Paiements en devise : virements passés en devise principale %1';
		|en = 'Foreign-currency payments: bank payments moved to base currency %1';
		|es = 'Pagos en moneda: transferencias pasadas a la moneda principal %1'");
	ЗаписатьВЖурнал(СтрШаблон(Шаблон, Количество));

КонецПроцедуры

// Валютные налоговые документы покупки, проведённые до 2.0.16.41 (начисление закупочного налогового регистра - в валюте
// документа), - в журнал регистрации предупреждением: их перепроводит пользователь. Движения обработчик не переписывает
// (ревью кода Codex, 2×P0 ai-database: по движениям не доказать, что текущие валюта и курс документа - те же, что при
// проведении; ревью техдолга Codex 2026-10-09, T22).
//
Процедура НайтиНалоговыеДокументыПокупкиКПерепроведению() Экспорт

	КПерепроведению = НалоговыеДокументыПокупкиКПерепроведению();
	Если КПерепроведению.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Строки = Новый Массив;
	Для Каждого Документ Из КПерепроведению Цикл
		Строки.Добавить(Строка(Документ));
	КонецЦикла;
	Шаблон = НСтр("ru = 'Перепроведите валютные налоговые документы покупки (начисление - в основной валюте): %1';
		|fr = 'Revalidez les documents fiscaux d''achat en devise (montant en devise principale) : %1';
		|en = 'Repost the foreign-currency purchase tax documents (accrual in the base currency): %1';
		|es = 'Vuelva a contabilizar los documentos fiscales de compra en moneda (cargo en moneda principal): %1'");
	ЗаписьЖурналаРегистрации(ОбновлениеПрограммы.ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
		СтрШаблон(Шаблон, СтрСоединить(Строки, "; ")));

КонецПроцедуры

// Проведённые налоговые накладные покупки и возвраты поставщику в неосновной валюте, у которых своё начисление
// закупочного налогового регистра равно сумме документа в валюте (не пересчитано в основную).
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.НалоговаяНакладнаяПокупка, ДокументСсылка.ВозвратПоставщикуНалоговый - документы.
//
Функция НалоговыеДокументыПокупкиКПерепроведению() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Накладные.Ссылка КАК Ссылка,
	|	Накладные.Сумма КАК Сумма,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНалоговые.Накладная) КАК ВидОперации
	|ПОМЕСТИТЬ ВТДокументы
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка КАК Накладные
	|ГДЕ
	|	Накладные.Проведен
	|	И Накладные.Валюта <> &Основная
	|	И Накладные.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|	И Накладные.КурсВалюты > 0
	|	И Накладные.КурсВалюты <> 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Возвраты.Ссылка,
	|	Возвраты.Сумма,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНалоговые.Возврат)
	|ИЗ
	|	Документ.ВозвратПоставщикуНалоговый КАК Возвраты
	|ГДЕ
	|	Возвраты.Проведен
	|	И Возвраты.Валюта <> &Основная
	|	И Возвраты.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|	И Возвраты.КурсВалюты > 0
	|	И Возвраты.КурсВалюты <> 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Документы.Ссылка КАК Ссылка
	|ИЗ
	|	ВТДокументы КАК Документы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчётыСПоcтавщикамиНалоговый КАК Начисления
	|		ПО Документы.Ссылка = Начисления.Регистратор
	|			И Документы.Ссылка = Начисления.ДокументДвижения
	|			И Документы.ВидОперации = Начисления.ВидОперации
	|			И Документы.Сумма = Начисления.Сумма
	|			И (Документы.Сумма <> 0)";
	Запрос.УстановитьПараметр("Основная", РаботаСВалютами.ОсновнаяВалюта());
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

