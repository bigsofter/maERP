////////////////////////////////////////////////////////////////////////////////
// Обработчики обновления информационной базы.
//
// Единственная точка регистрации: ПриДобавленииОбработчиковОбновления. Сами
// обработчики - экспортные процедуры без параметров, выполняются ядром
// (ОбновлениеПрограммы) по возрастанию версий и только один раз на базе.
// Каждый обработчик обязан быть идемпотентным: при падении следующего входа
// он может быть выполнен повторно.
//
// Состояние базы обработчики читают под любым пользователем, поэтому работают
// в привилегированном режиме.
// BSLLS:SetPrivilegedMode-off
//
// Имена метаданных (ОбъектРасчётов, ВзаиморасчётыСПоставщиками и другие) содержат "ё".
// BSLLS:YoLetterUsage-off
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Регистрирует обработчики обновления.
//
// Параметры:
//  Обработчики - ТаблицаЗначений - см. ОбновлениеПрограммы.НоваяТаблицаОбработчиков
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	// Версии 1.0.11.2 - 1.0.11.6: одноразовые заполнения данных волн 9-12, до версии 1.0.12.1
	// выполнявшиеся механизмом ОбновлениеДанныхВызовСервера по номеру шага в константе
	// НомерВыполненногоЗаполненияДанных (см. СтартоваяВерсияИнформационнойБазы). Порядок версий
	// повторяет прежний порядок шагов, поэтому базы клиентов не выполняют их повторно.

	РежимМонопольно = "Монопольно";

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "1.0.11.2";
	Обработчик.РежимВыполнения = РежимМонопольно;
	Обработчик.Процедура = "ОбновлениеПрограммыОбработчики.ЗаполнитьПризнакЦенаВключаетНДС";
	Обработчик.Комментарий = НСтр("ru = 'Признак ""Цена включает НДС"" в исторических документах.';
		|fr = 'Attribut « Prix TTC » dans les documents historiques.';
		|en = 'The ""Price includes VAT"" attribute in historical documents.';
		|es = 'El atributo ""El precio incluye IVA"" en los documentos históricos.'");

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "1.0.11.3";
	Обработчик.РежимВыполнения = РежимМонопольно;
	Обработчик.Процедура = "ОбновлениеПрограммыОбработчики.ЗаполнитьОбъектРасчётовНалоговыхРегистров";
	Обработчик.Комментарий = НСтр("ru = 'Объект расчётов в налоговых регистрах взаиморасчётов.';
		|fr = 'Objet de règlement dans les registres fiscaux des règlements mutuels.';
		|en = 'Settlement object in tax registers of mutual settlements.';
		|es = 'Objeto de liquidación en los registros fiscales de liquidaciones mutuas.'");

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "1.0.11.4";
	Обработчик.РежимВыполнения = РежимМонопольно;
	Обработчик.Процедура = "ОбновлениеПрограммыОбработчики.ЗаполнитьПроизводственныеСтатусыЗаказов";
	Обработчик.Комментарий = НСтр("ru = 'Производственные статусы заказов покупателей.';
		|fr = 'Statuts de production des commandes clients.';
		|en = 'Production statuses of sales orders.';
		|es = 'Estados de producción de los pedidos de clientes.'");

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "1.0.11.5";
	Обработчик.РежимВыполнения = РежимМонопольно;
	Обработчик.Процедура = "ОбновлениеПрограммыОбработчики.ЗаполнитьЗаказВДвиженияхПереработки";
	Обработчик.Комментарий = НСтр("ru = 'Заказ покупателя в движениях товаров в переработке.';
		|fr = 'Commande client dans les mouvements des marchandises en sous-traitance.';
		|en = 'Sales order in movements of goods in processing.';
		|es = 'Pedido de cliente en los movimientos de mercancías en procesamiento.'");

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "1.0.11.6";
	Обработчик.РежимВыполнения = РежимМонопольно;
	Обработчик.Процедура = "ОбновлениеПрограммыОбработчики.ЗаполнитьГотовуюПродукциюВыпусков";
	Обработчик.Комментарий = НСтр("ru = 'Табличная часть готовой продукции в выпусках.';
		|fr = 'Partie tabulaire des produits finis dans les sorties de production.';
		|en = 'Tabular section of finished products in production issues.';
		|es = 'Sección tabular de productos terminados en las emisiones.'");

КонецПроцедуры

// Версия данных базы, с которой начинается обновление, когда записи в регистре
// ВерсииПодсистем ещё нет.
//
// Возвращаемое значение:
//  Строка - версия; пустая строка для новой (пустой) базы
//
Функция СтартоваяВерсияИнформационнойБазы() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ЭтоПустаяИнформационнаяБаза() Тогда
		Возврат "";
	КонецЕсли;

	// Конвертация механизма волны 11.1: номер последнего выполненного шага заполнения данных
	// соответствует версии одноимённого обработчика (шаг N - версия 1.0.11.(N+1)), поэтому уже
	// выполненные на базе клиента шаги не выполняются повторно, а невыполненные - выполняются.
	НомерШага = Константы.НомерВыполненногоЗаполненияДанных.Получить();
	Возврат "1.0.11." + Формат(НомерШага + 1, "ЧГ=0");

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Проставляет признак ЦенаВключаетНДС в документах, введённых до его появления (волна 9).
// История продаж велась в ценах с НДС; признак проставляется прямой записью реквизита,
// без перепроведения (wave9-check.md, п. 2).
//
Процедура ЗаполнитьПризнакЦенаВключаетНДС() Экспорт

	МоментОбновления = ТекущаяДатаСеанса();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.НалоговаяНакладная КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.ВозвратОтПокупателя КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.ВозвратОтПокупателяНалоговый КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.ОприходованиеТоваров КАК Т
	|ГДЕ
	|	НЕ Т.ЦенаВключаетНДС
	|	И Т.Дата < &МоментОбновления";
	Запрос.УстановитьПараметр("МоментОбновления", МоментОбновления);

	КоличествоОбновлено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.ЦенаВключаетНДС = Истина;
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();
		КоличествоОбновлено = КоличествоОбновлено + 1;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Заполнение ЦенаВключаетНДС: обновлено документов: %1';
		|fr = 'Remplissage de PrixTTC : documents mis à jour : %1';
		|en = 'Filling of PriceIncludesVAT: documents updated: %1';
		|es = 'Relleno de PrecioIncluyeIVA: documentos actualizados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоОбновлено));

КонецПроцедуры

// Заполняет измерение ОбъектРасчётов налоговых регистров взаиморасчётов (волна 10)
// значением реквизита ДокументДвижения, без перепроведения (wave10-check.md, п. 3.3).
//
Процедура ЗаполнитьОбъектРасчётовНалоговыхРегистров() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	|ГДЕ
	|	Т.ОбъектРасчётов = НЕОПРЕДЕЛЕНО
	|	И Т.ДокументДвижения <> НЕОПРЕДЕЛЕНО";
	ЗаполнитьОбъектРасчётовРегистра("ВзаиморасчётыСПокупателямиНалоговый", Запрос);

	// Во втором регистре латинская "c" в имени - как в метаданных.
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "СПокупателями", "СПоcтавщиками");
	ЗаполнитьОбъектРасчётовРегистра("ВзаиморасчётыСПоcтавщикамиНалоговый", Запрос);

КонецПроцедуры

// Пересчитывает производственные статусы заказов покупателей (волна 12) по проведённым
// производственным документам: статус берётся по последнему связанному документу, запись
// в историю добавляется, только если статус отличается.
//
Процедура ЗаполнитьПроизводственныеСтатусыЗаказов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Основание КАК Основание
	|ИЗ
	|	Документ.ПередачаВПереработку КАК Т
	|ГДЕ
	|	Т.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Основание
	|ИЗ
	|	Документ.ПоступлениеИзПереработки КАК Т
	|ГДЕ
	|	Т.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Основание
	|ИЗ
	|	Документ.ВыпускПродукции КАК Т
	|ГДЕ
	|	Т.Проведен";

	КоличествоЗаказов = 0;
	ОбработанныеЗаказы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Заказ = РаботаСДокументами.ПолучитьДокументРодительПоТипу(
			Тип("ДокументСсылка.ЗаказПокупателя"), Выборка.Основание);
		Если ЗначениеЗаполнено(Заказ) И ОбработанныеЗаказы[Заказ] = Неопределено Тогда
			ОбработанныеЗаказы.Вставить(Заказ, Истина);
			РаботаСДокументами.ОбновитьСтатусЗаказаПоСвязанным(Заказ);
			КоличествоЗаказов = КоличествоЗаказов + 1;
		КонецЕсли;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Заполнение производственных статусов: пересчитано заказов: %1';
		|fr = 'Remplissage des statuts de production : commandes recalculées : %1';
		|en = 'Filling of production statuses: orders recalculated: %1';
		|es = 'Relleno de los estados de producción: pedidos recalculados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоЗаказов));

КонецПроцедуры

// Заполняет измерение ЗаказПокупателя регистра ТоварыВПереработке (волна 12) по цепочке
// оснований регистратора, наборами записей, без перепроведения.
//
Процедура ЗаполнитьЗаказВДвиженияхПереработки() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыВПереработке КАК Т
	|ГДЕ
	|	Т.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)";

	КоличествоРегистраторов = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Заказ = РаботаСДокументами.ПолучитьДокументРодительПоТипу(
			Тип("ДокументСсылка.ЗаказПокупателя"), Выборка.Регистратор.Основание);
		Если Не ЗначениеЗаполнено(Заказ) Тогда
			Продолжить;
		КонецЕсли;
		НаборЗаписей = РегистрыНакопления.ТоварыВПереработке.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		ЕстьИзменения = Ложь;
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Не ЗначениеЗаполнено(Запись.ЗаказПокупателя) Тогда
				Запись.ЗаказПокупателя = Заказ;
				ЕстьИзменения = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьИзменения Тогда
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
			НаборЗаписей.Записать();
			КоличествоРегистраторов = КоличествоРегистраторов + 1;
		КонецЕсли;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Заполнение заказа в движениях переработки: обновлено документов: %1';
		|fr = 'Remplissage de la commande dans les mouvements de sous-traitance : documents mis à jour : %1';
		|en = 'Filling of the order in processing movements: documents updated: %1';
		|es = 'Relleno del pedido en los movimientos de procesamiento: documentos actualizados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоРегистраторов));

КонецПроцедуры

// Создаёт строку ТЧГотоваяПродукция документа ВыпускПродукции (волна 12) из шапки
// исторических документов, прямой записью, без перепроведения.
//
Процедура ЗаполнитьГотовуюПродукциюВыпусков() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК Т
	|ГДЕ
	|	Т.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И НЕ Т.Ссылка В
	|			(ВЫБРАТЬ
	|				ТЧ.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ТЧ)";

	КоличествоОбновлено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		НоваяСтрока = ДокОбъект.ТЧГотоваяПродукция.Добавить();
		НоваяСтрока.КодСтроки = 1;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДокОбъект,
			"Номенклатура, Характеристика, Серия, Упаковка, КоличествоУпаковок, Количество");
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();
		КоличествоОбновлено = КоличествоОбновлено + 1;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Заполнение готовой продукции выпусков: обновлено документов: %1';
		|fr = 'Remplissage des produits finis des sorties de production : documents mis à jour : %1';
		|en = 'Filling of finished products of production issues: documents updated: %1';
		|es = 'Relleno de productos terminados de las emisiones: documentos actualizados: %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, КоличествоОбновлено));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Признак новой базы: данных учёта в ней ещё нет, конвертировать нечего.
//
// Возвращаемое значение:
//  Булево - Истина, если в базе нет ни одного элемента справочника Номенклатура
//
Функция ЭтоПустаяИнформационнаяБаза()

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";
	Возврат Запрос.Выполнить().Пустой();

КонецФункции

// Заполняет ОбъектРасчётов в одном налоговом регистре взаиморасчётов.
//
// Параметры:
//  ИмяРегистра - Строка - имя регистра накопления
//  Запрос      - Запрос - готовый запрос регистраторов с пустым ОбъектРасчётов
//
Процедура ЗаполнитьОбъектРасчётовРегистра(ИмяРегистра, Запрос)

	КоличествоЗаписей = 0;
	КоличествоРегистраторов = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		ЕстьИзменения = Ложь;
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Запись.ОбъектРасчётов = Неопределено И Запись.ДокументДвижения <> Неопределено Тогда
				Запись.ОбъектРасчётов = Запись.ДокументДвижения;
				ЕстьИзменения = Истина;
				КоличествоЗаписей = КоличествоЗаписей + 1;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьИзменения Тогда
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
			НаборЗаписей.Записать();
			КоличествоРегистраторов = КоличествоРегистраторов + 1;
		КонецЕсли;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Заполнение ОбъектРасчётов регистра %1: обновлено записей: %2 (документов: %3)';
		|fr = 'Remplissage de ObjetDeRèglement du registre %1 : enregistrements mis à jour : %2 (documents : %3)';
		|en = 'Filling of SettlementObject of register %1: records updated: %2 (documents: %3)';
		|es = 'Relleno de ObjetoDeLiquidación del registro %1: registros actualizados: %2 (documentos: %3)'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, ИмяРегистра, КоличествоЗаписей, КоличествоРегистраторов));

КонецПроцедуры

// Записывает итог обработчика в журнал регистрации.
//
// Параметры:
//  Сообщение - Строка - текст сообщения
//
Процедура ЗаписатьВЖурнал(Сообщение)

	ЗаписьЖурналаРегистрации(ОбновлениеПрограммы.ИмяСобытияЖурнала(),
		УровеньЖурналаРегистрации.Информация, , , Сообщение);

КонецПроцедуры

#КонецОбласти
