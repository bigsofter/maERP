	// НомерВыполненногоЗаполненияДанных (см. СтартоваяВерсияИнформационнойБазы). Порядок версий
	// повторяет прежний порядок шагов, поэтому базы клиентов не выполняют их повторно.

	РежимМонопольно = "Монопольно";

