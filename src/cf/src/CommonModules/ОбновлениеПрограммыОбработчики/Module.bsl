// Переносит коды рабочих мест (идентификаторы клиентов 1С) в регистр ИдентификаторыРабочихМест (2.0.16.95,
// docs/plans/equipment-lite-f1.md). Пишутся только однозначные коды; места с одинаковым кодом (дубли в базах
// клиентов) не сливаются и не привязываются - они в журнале регистрации, объединяет их администратор. Повторный
// запуск ничего не меняет.
//
Процедура ПеренестиИдентификаторыРабочихМест() Экспорт

	Итог = Справочники.РабочиеМеста.ПеренестиКодыВРегистр();
	ШаблонСообщения = НСтр("ru = 'Идентификаторы рабочих мест: перенесено %1, уже были %2, неоднозначных кодов %3.';
		|fr = 'Identifiants des postes de travail : transférés %1, déjà présents %2, codes ambigus %3.';
		|en = 'Workplace identifiers: moved %1, already present %2, ambiguous codes %3.';
		|es = 'Identificadores de lugares de trabajo: trasladados %1, ya existentes %2, códigos ambiguos %3.'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, Итог.Перенесено, Итог.УжеБыло, Итог.Неоднозначных));

КонецПроцедуры

// Заполняет пустой вид операции у существующих заказов клиентов значением «Продажа» (E4).
// Запись в режиме загрузки не запускает ПередЗаписью и ПриЗаписи документа: не меняются итоги,
// история статусов и статус коммерческого предложения; помеченные на удаление заказы тоже
// заполняются. Повторный запуск не выбирает уже обработанные заказы.
