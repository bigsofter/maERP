	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "2.0.15.42";
	Обработчик.РежимВыполнения = РежимМонопольно;
	Обработчик.Процедура = "ОбновлениеПрограммыОбработчики.ЗаполнитьПризнакАвтовыпусков";
	Обработчик.Комментарий = НСтр("ru = 'Признак ""Создан автоматически"" у выпусков, созданных механизмом автовыпуска.';
