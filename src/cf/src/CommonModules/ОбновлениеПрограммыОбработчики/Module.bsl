// регистрации о каждой такой правке - и о правках макетов, удалённых раньше (КП, фазы 1-2); записи не удаляются.
//
Процедура ПредупредитьОбУдаленныхМакетах() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Макеты.Объект КАК Объект,
	|	Макеты.ИмяМакета КАК ИмяМакета
	|ИЗ
	|	РегистрСведений.ПользовательскиеМакетыПечати КАК Макеты");
	Выборка = Запрос.Выполнить().Выбрать();
	// Журнал обновления ведётся по-русски, как ЗаписатьВЖурнал.
	ШаблонПредупреждения = "Макет печатной формы %1 удалён из конфигурации. Изменённый макет сохранён: он открывается "
		+ "из списка макетов печатных форм (строка «удалён из конфигурации») - перенесите нужное в фирменный макет "
		+ "ОбщийМакет.ФирменныйДокумент или удалите правку.";
	ИмяСобытия = ОбновлениеПрограммы.ИмяСобытияЖурнала();
	Пока Выборка.Следующий() Цикл
		Путь = Выборка.Объект + "." + Выборка.ИмяМакета;
		Попытка
			МакетЕсть = ПечатныеФормы.МакетЕстьВКонфигурации(Путь);
		Исключение
			// Путь записи не разбирается - запись не наша, обработчик её не трогает.
			Продолжить;
		КонецПопытки;
		Если Не МакетЕсть Тогда
			Сообщение = СтрШаблон(ШаблонПредупреждения, Путь);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , Сообщение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Перенос старых свойств номенклатуры (ТЧ СвойстваНоменклатуры, справочники ВидыСвойствНоменклатуры и
// ЗначенияСвойствНоменклатуры из базы клиента) в дополнительные реквизиты (docs/plans/old-item-properties.md, сборка A).
// Старая ТЧ и справочники не трогаются - они источник повторного запуска и сверки; удаление - отдельная сборка B.
// Ошибка записи товара не останавливает перебор, но в конце обработчик вызывает исключение: версия базы не поднимется,
// и следующий запуск обновления дописывает недописанное.
//
Процедура ПеренестиСтарыеСвойстваНоменклатуры() Экспорт

	Свойства = СвойстваСтарыхВидов();
	Итог = ПеренестиСтарыеСвойстваТоваров(Неопределено, Свойства);
	ЗаписатьВЖурнал(ОтчетПереносаСтарыхСвойств(Свойства.Количество(), Итог));
	Если Итог.Ошибки.Количество() > 0 Тогда
		ВызватьИсключение ТекстОшибокПереносаСвойств(Итог.Ошибки);
	КонецЕсли;

КонецПроцедуры

// Свойство-доп. реквизит на каждый старый вид свойства, включая неиспользуемые и помеченные на удаление. Имя -
// «СтароеСвойство_» + идентификатор вида: повторный вызов находит то же свойство (ДобавитьСвойство идемпотентна). Тип -
// объединение объявленного типа вида и фактических типов его значений: тип вида меняется в форме без конвертации
// значений (ревью плана Codex, P1).
//
// Возвращаемое значение:
//  Соответствие - СправочникСсылка.ВидыСвойствНоменклатуры -> ПланВидовХарактеристикСсылка.ДополнительныеРеквизиты
//
Функция СвойстваСтарыхВидов() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Виды.Ссылка КАК Вид,
	|	Виды.Наименование КАК Наименование,
	|	Виды.ТипЗначенияСвойства КАК ТипЗначения
	|ИЗ
	|	Справочник.ВидыСвойствНоменклатуры КАК Виды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Значения.Владелец КАК Вид,
	|	Значения.ЗначениеСвойства КАК Значение
	|ИЗ
	|	Справочник.ЗначенияСвойствНоменклатуры КАК Значения");
	Результаты = Запрос.ВыполнитьПакет();
	ТипыВидов = Новый Соответствие;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьИмяТипа(ТипыВидов, Выборка.Вид, ИмяТипаЗначения(Выборка.Значение));
	КонецЦикла;

	Свойства = Новый Соответствие;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьИмяТипа(ТипыВидов, Выборка.Вид, ИмяТипаВида(Выборка.ТипЗначения));
		Параметры = УправлениеСвойствами.ПараметрыДобавленияСвойства();
		Параметры.ИмяОбъекта = "Справочник.Номенклатура";
		Параметры.Имя = ИмяСтарогоСвойства(Выборка.Вид);
		Параметры.Наименование = Выборка.Наименование;
		Параметры.ТипЗначения = ТипСтарогоСвойства(ТипыВидов.Получить(Выборка.Вид));
		Свойства.Вставить(Выборка.Вид, УправлениеСвойствами.ДобавитьСвойство(Параметры));
	КонецЦикла;
	Возврат Свойства;

КонецФункции

// Переносит строки старой ТЧ товаров в дополнительные реквизиты: на вид - значение последней строки вида; уже заданное
// значение нового свойства не перезаписывается; пустое значение (явный ноль, пустая строка и дата неотличимы в новом
// механизме от «не задано») не переносится, а попадает в отчёт. Каждый товар - своей транзакцией под блокировкой.
//
// Параметры:
//  Товары   - Массив из СправочникСсылка.Номенклатура, Неопределено - какие товары; Неопределено - все со строками ТЧ
//  Свойства - Соответствие - см. СвойстваСтарыхВидов
//
// Возвращаемое значение:
//  Структура:
//   * Товаров   - Число - записано товаров
//   * Строк     - Число - перенесено значений
//   * УжеЗадано - Число - значений, уже заданных в новом свойстве
//   * Пустые    - Массив из Строка - «товар; вид» пустых значений
//   * Ошибки    - Массив из Строка - «товар: текст ошибки»
//
Функция ПеренестиСтарыеСвойстваТоваров(Товары, Свойства) Экспорт

	Итог = Новый Структура;
	Итог.Вставить("Товаров", 0);
	Итог.Вставить("Строк", 0);
	Итог.Вставить("УжеЗадано", 0);
	Итог.Вставить("Пустые", Новый Массив);
	Итог.Вставить("Ошибки", Новый Массив);
	ПолеТовара = "Товар";
	Если Товары = Неопределено Тогда
		Товары = ТоварыСоСтарымиСвойствами();
	КонецЕсли;
	// Строки читаются порциями товаров: весь объём старой ТЧ в памяти не держится (ревью Codex 2.0.16.66, P2).
	// BSLLS:MagicNumber-off - размер порции.
	РазмерПорции = 500;
	// BSLLS:MagicNumber-on
	Порция = Новый Массив;
	Для Индекс = 0 По Товары.ВГраница() Цикл
		Порция.Добавить(Товары[Индекс]);
		Если Порция.Количество() < РазмерПорции И Индекс < Товары.ВГраница() Тогда
			Продолжить;
		КонецЕсли;
		Строки = СтрокиСтарыхСвойств(Порция);
		Строки.Индексы.Добавить(ПолеТовара);
		Для Каждого Товар Из Порция Цикл
			СтрокиТовара = Строки.НайтиСтроки(Новый Структура(ПолеТовара, Товар));
			ПеренестиСтарыеСвойстваТовара(Товар, СтрокиТовара, Свойства, Итог);
		КонецЦикла;
		Порция.Очистить();
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Текст исключения обработчика: перечень товаров, которые не удалось записать.
//
// Параметры:
//  Ошибки - Массив из Строка - см. ПеренестиСтарыеСвойстваТоваров
//
// Возвращаемое значение:
//  Строка - текст
//
Функция ТекстОшибокПереносаСвойств(Ошибки) Экспорт

	Перечень = СтрСоединить(Ошибки, Символы.ПС);
	Количество = Ошибки.Количество();
	Шаблон = НСтр("ru = 'Перенос старых свойств номенклатуры: не записано товаров - %1. Повторите обновление.
		|%2'; fr = 'Transfert des anciennes propriétés des articles : articles non enregistrés - %1. Relancez la mise à jour.
		|%2'; en = 'Transfer of old item properties: items not saved - %1. Run the update again.
		|%2'; es = 'Traslado de las propiedades antiguas de los artículos: artículos no guardados - %1. Repita la actualización.
		|%2'");
	Возврат СтрШаблон(Шаблон, Количество, Перечень);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ссылки (документы карт или регистраторы движений), у которых есть строка с закупаемым материалом.
//
// Параметры:
//  Строки    - ТаблицаЗначений - колонки Ссылка, Номенклатура.
//  Умолчания - Соответствие - см. ТехнологическиеКарты.СпособыИзготовленияПоУмолчанию.
//
// Возвращаемое значение:
//  Массив - ссылки без повторов.
//
Функция СсылкиСЗакупаемыми(Строки, Умолчания)

	ИмяКолонки = "Ссылка";
	Ссылки = Строки.СкопироватьКолонки(ИмяКолонки);
	Для Каждого Стр Из Строки Цикл
		Если Умолчания[Стр.Номенклатура] = Перечисления.СпособыИзготовления.Закупка Тогда
			Ссылки.Добавить().Ссылка = Стр.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Ссылки.Свернуть(ИмяКолонки);
	Возврат Ссылки.ВыгрузитьКолонку(ИмяКолонки);

КонецФункции

// Заказы клиентов, стадию которых пересчитывает ЗаполнитьПришлоБезЗаказа: с прямыми закупками и со взятым со склада.
//
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказПокупателя - заказы с прямыми закупками.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПокупателя - без повторов.
//
Функция ЗаказыДляПересчетаСтадий(Заказы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Заказ КАК Заказ
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства КАК Движения
	|ГДЕ
	|	Движения.Активность
	|	И Движения.ИзОстатка <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Заказы.Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказы
	|ГДЕ
	|	Заказы.Ссылка В (&Заказы)";
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Свернуть("Заказ");
	Возврат Таблица.ВыгрузитьКолонку("Заказ");

КонецФункции

// Разметка «ПришлоБезЗаказа» закупок одного заказа клиента, см. ЗаполнитьПришлоБезЗаказа. Два прохода по ключу записи:
// приходы задают полные ёмкости двух карманов - все, в том числе более поздние по моменту времени (старый возврат
// раскладывался по итоговым остаткам заказа без временной границы - ревью плана, раунд 7, P1); затем возвраты по моменту
// времени списываются с этих ёмкостей.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//
Процедура РазметитьПришлоБезЗаказаЗаказа(Заказ)

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		УправляемыеБлокировки.ПотребностиПроизводства(Блокировка, Заказ);
		Блокировка.Заблокировать();
		Наборы = НаборыЗакупокЗаказа(Заказ);
		Карманы = Новый Соответствие;
		РазметитьНаборы(Наборы, Карманы, Ложь);
		РазметитьНаборы(Наборы, Карманы, Истина);
		Для Каждого Элемент Из Наборы Цикл
			Если Элемент.Изменен Тогда
				Элемент.Набор.ОбменДанными.Загрузка = Истина;
				Элемент.Набор.Записать();
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//
// Возвращаемое значение:
//  Массив из Структура - Закупка (см. ЗакупкиПотребностейЗаказа), Набор (прочитанный набор записей регистратора),
//                        Изменен (Булево) - по моменту времени.
//
Функция НаборыЗакупокЗаказа(Заказ)

	Наборы = Новый Массив;
	Для Каждого Закупка Из ЗакупкиПотребностейЗаказа(Заказ) Цикл
		Набор = РегистрыНакопления.ПотребностиПроизводства.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Закупка.Ссылка);
		Набор.Прочитать();
		Наборы.Добавить(Новый Структура("Закупка, Набор, Изменен", Закупка, Набор, Ложь));
	КонецЦикла;
	Возврат Наборы;

КонецФункции

// Один проход разметки по активным записям: приходы (записи поступлений и ордеров, неотрицательные записи возвратов)
// копят ёмкости карманов, возвраты списывают с них.
//
// Параметры:
//  Наборы   - Массив из Структура - см. НаборыЗакупокЗаказа.
//  Карманы  - Соответствие - см. КарманыКлюча.
//  Возвраты - Булево - проход возвратов; Ложь - проход приходов.
//
Процедура РазметитьНаборы(Наборы, Карманы, Возвраты)

	Для Каждого Элемент Из Наборы Цикл
		Для Каждого Запись Из Элемент.Набор Цикл
			ЭтоСписание = Элемент.Закупка.ЭтоВозврат И Запись.Пришло < 0;
			// Неактивные записи в остатках не участвуют: не дают ёмкости и не размечаются (ревью кода, P1).
			Если Не Запись.Активность Или ЭтоСписание <> Возвраты Тогда
				Продолжить;
			ИначеЕсли Возвраты Тогда
				БезЗаказа = ПришлоБезЗаказаВозврата(Запись, Элемент.Закупка, Карманы);
			Иначе
				БезЗаказа = ПришлоБезЗаказаПрихода(Запись, Элемент.Закупка, Карманы);
			КонецЕсли;
			Если Запись.ПришлоБезЗаказа <> БезЗаказа Тогда
				Запись.ПришлоБезЗаказа = БезЗаказа;
				Элемент.Изменен = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Запись  - РегистрНакопленияЗапись.ПотребностиПроизводства - запись закупки.
//  Карманы - Соответствие - ключ записи -> Структура (Прямой, ПоЗаказу); пополняется.
//
// Возвращаемое значение:
//  Структура - Прямой, ПоЗаказу: остатки карманов ключа записи.
//
Функция КарманыКлюча(Запись, Карманы)

	Ключ = СтрШаблон("%1|%2|%3", XMLСтрока(Запись.Продукция), XMLСтрока(Запись.Материал),
		XMLСтрока(Запись.Характеристика));
	Карман = Карманы[Ключ];
	Если Карман = Неопределено Тогда
		Карман = Новый Структура("Прямой, ПоЗаказу", 0, 0);
		Карманы.Вставить(Ключ, Карман);
	КонецЕсли;
	Возврат Карман;

КонецФункции

// «ПришлоБезЗаказа» записи прихода: у прямой закупки - всё «Пришло», по заказу - ноль; ёмкость карманов ключа растёт.
//
// Параметры:
//  Запись  - РегистрНакопленияЗапись.ПотребностиПроизводства - запись поступления, ордера или положительная возврата.
//  Закупка - СтрокаТаблицыЗначений - Ссылка, Прямая, ЭтоВозврат, см. ЗакупкиПотребностейЗаказа.
//  Карманы - Соответствие - см. КарманыКлюча.
//
// Возвращаемое значение:
//  Число - «ПришлоБезЗаказа» записи.
//
Функция ПришлоБезЗаказаПрихода(Запись, Закупка, Карманы)

	Карман = КарманыКлюча(Запись, Карманы);
	БезЗаказа = ?(Закупка.Прямая И Не Закупка.ЭтоВозврат, Запись.Пришло, 0);
	Карман.Прямой = Карман.Прямой + БезЗаказа;
	Карман.ПоЗаказу = Карман.ПоЗаказу + Запись.Пришло - БезЗаказа;
	Возврат БезЗаказа;

КонецФункции

// «ПришлоБезЗаказа» записи возврата: на том же ключе сначала со своего кармана, остаток - с другого (перелив, план
// arm-purchasing-receipts-s2, Р1.3); остатки карманов уменьшаются.
//
// Параметры:
//  Запись  - РегистрНакопленияЗапись.ПотребностиПроизводства - запись возврата с «Пришло» меньше нуля.
//  Закупка - СтрокаТаблицыЗначений - см. ЗакупкиПотребностейЗаказа.
//  Карманы - Соответствие - см. КарманыКлюча.
//
// Возвращаемое значение:
//  Число - «ПришлоБезЗаказа» записи (не больше нуля).
//
Функция ПришлоБезЗаказаВозврата(Запись, Закупка, Карманы)

	Карман = КарманыКлюча(Запись, Карманы);
	Количество = -Запись.Пришло;
	СвойОстаток = ?(Закупка.Прямая, Карман.Прямой, Карман.ПоЗаказу);
	СоСвоего = Мин(Количество, Макс(0, СвойОстаток));
	СПрямого = ?(Закупка.Прямая, СоСвоего, Количество - СоСвоего);
	Карман.Прямой = Карман.Прямой - СПрямого;
	Карман.ПоЗаказу = Карман.ПоЗаказу - (Количество - СПрямого);
	Возврат -СПрямого;

КонецФункции

// Закупки с движениями потребностей заказа по моменту времени.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ссылка (поступление, приходный ордер, возврат поставщику), Прямая (без заказа поставщику, см.
//                    ПотребностиПроизводства.ПрямаяЗакупка), ЭтоВозврат.
//
Функция ЗакупкиПотребностейЗаказа(Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТРегистраторы
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства КАК Движения
	|ГДЕ
	|	Движения.Заказ = &Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.МоментВремени КАК МоментВремени,
	|	НЕ(Документы.Основание ССЫЛКА Документ.ЗаказПоставщику
	|		И Документы.Основание <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)) КАК Прямая,
	|	ЛОЖЬ КАК ЭтоВозврат
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Документы
	|ГДЕ
	|	Документы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТРегистраторы.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТРегистраторы КАК ВТРегистраторы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документы.Ссылка,
	|	Документы.МоментВремени,
	|	НЕ(Документы.Основание ССЫЛКА Документ.ЗаказПоставщику
	|		И Документы.Основание <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)),
	|	ЛОЖЬ
	|ИЗ
	|	Документ.ПриходныйОрдер КАК Документы
	|ГДЕ
	|	Документы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТРегистраторы.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТРегистраторы КАК ВТРегистраторы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документы.Ссылка,
	|	Документы.МоментВремени,
	|	НЕ(ВЫРАЗИТЬ(Документы.Основание КАК Документ.ПоступлениеТоваровУслуг).Основание ССЫЛКА Документ.ЗаказПоставщику
	|		И ВЫРАЗИТЬ(Документы.Основание КАК Документ.ПоступлениеТоваровУслуг).Основание
	|			<> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)),
	|	ИСТИНА
	|ИЗ
	|	Документ.ВозвратПоставщику КАК Документы
	|ГДЕ
	|	Документы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТРегистраторы.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТРегистраторы КАК ВТРегистраторы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментВремени";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Ключи пересчитанного заказа, где часть «Пришло» (без заказа поставщику или по заказам) меньше нуля - возможно только
// при отрицательном общем «Пришло» ключа, то есть в уже испорченных исторических данных: предупреждение в журнал.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//
Процедура ЗаписатьОтрицательноеПришлоЗаказа(Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Продукция КАК Продукция,
	|	Остатки.Материал КАК Материал,
	|	Остатки.ПришлоБезЗаказаОстаток КАК БезЗаказа,
	|	Остатки.ПришлоОстаток - Остатки.ПришлоБезЗаказаОстаток КАК ПоЗаказам
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства.Остатки(, Заказ = &Заказ) КАК Остатки";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Шаблон = НСтр("ru = 'Заказ %1, продукция %2, материал %3: возвращено поставщику больше, чем пришло. Проверьте
		|возвраты поставщику по заказу.';
		|fr = 'Commande %1, produit %2, matière %3 : plus retourné au fournisseur que reçu. Vérifiez les retours fournisseur
		|de la commande.';
		|en = 'Order %1, product %2, material %3: more returned to the supplier than received. Check the supplier returns of
		|the order.';
		|es = 'Pedido %1, producto %2, material %3: más devuelto al proveedor que recibido. Revise las devoluciones al
		|proveedor del pedido.'");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.БезЗаказа >= 0 И Выборка.ПоЗаказам >= 0 Тогда
			Продолжить;
		КонецЕсли;
		ЗаписьЖурналаРегистрации(ОбновлениеПрограммы.ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.РегистрыНакопления.ПотребностиПроизводства, Заказ,
			СтрШаблон(Шаблон, Заказ, Выборка.Продукция, Выборка.Материал));
	КонецЦикла;

КонецПроцедуры

// Обработчики ордерных складов (docs/plans/warehouse-orders.md): физический регистр ТоварыНаСкладах.
//
