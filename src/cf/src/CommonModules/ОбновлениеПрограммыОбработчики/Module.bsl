// Пишет в журнал регистрации предупреждение о каждой включённой пользовательской правке макета, который заменён
// фирменным: правка больше не действует, но не удаляется (docs/plans/branded-print.md, раздел 3.4а).
//
// Параметры:
//  Макеты - Массив из Строка - пути заменённых макетов «Документ.X.ИмяМакета».
//  ШаблонПредупреждения - Строка - текст предупреждения с %1 - путём макета; пусто - «заменён и не используется».
//
Процедура ПредупредитьОЗамененныхМакетах(Макеты, Знач ШаблонПредупреждения = "")

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Макеты.Объект КАК Объект,
	|	Макеты.ИмяМакета КАК ИмяМакета
	|ИЗ
	|	РегистрСведений.ПользовательскиеМакетыПечати КАК Макеты
	|ГДЕ
	|	Макеты.Использование");
	Выборка = Запрос.Выполнить().Выбрать();
	// Журнал обновления ведётся по-русски, как ЗаписатьВЖурнал.
	Если ПустаяСтрока(ШаблонПредупреждения) Тогда
		ШаблонПредупреждения = "Изменённый макет печатной формы %1 заменён фирменным макетом "
			+ "ОбщийМакет.ФирменныйДокумент и больше не используется. Правка сохранена в списке макетов печатных форм.";
	КонецЕсли;
	ИмяСобытия = ОбновлениеПрограммы.ИмяСобытияЖурнала();
	Пока Выборка.Следующий() Цикл
		Путь = Выборка.Объект + "." + Выборка.ИмяМакета;
		Если Макеты.Найти(Путь) <> Неопределено Тогда
			Сообщение = СтрШаблон(ШаблонПредупреждения, Путь);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , Сообщение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Шаги обработчика ПеревестиВалютныеВзаиморасчётыВОсновнуюВалюту внутри его транзакции.
//
// Возвращаемое значение:
//  Структура - Поступлений, Документов, ЗаписейОплат - счётчики для журнала.
//
Функция ПеревестиВалютныеДокументыВОсновнуюВалюту()

	Итоги = Новый Структура("Поступлений, Документов, ЗаписейОплат", 0, 0, 0);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Основная", РаботаСВалютами.ОсновнаяВалюта());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Т
	|ГДЕ
	|	Т.Валюта <> &Основная
	|	И Т.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|	И НЕ Т.ВВалюте";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.ВВалюте = Истина;
		Если ДокОбъект.КурсВалюты <= 0 Тогда
			// Так документ и проводился: суммы в валюте без пересчёта. Отмечается в журнале для сверки.
			ДокОбъект.КурсВалюты = 1;
			Шаблон = НСтр("ru = 'Документ в валюте без курса, принят курс 1: %1';
				|fr = 'Document en devise sans taux, taux 1 retenu : %1';
				|en = 'Foreign-currency document without a rate, rate 1 used: %1';
				|es = 'Documento en moneda sin tipo de cambio, se toma 1: %1'");
			ЗаписатьВЖурнал(СтрШаблон(Шаблон, ДокОбъект.Ссылка));
		КонецЕсли;
		РаботаСВалютамиКлиентСервер.ПересчитатьСуммыРегл(ДокОбъект);
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();
		Итоги.Поступлений = Итоги.Поступлений + 1;
	КонецЦикла;

	// Документы в валюте без флажка: валютность - по реквизиту Валюта (РаботаСВалютами.ВалютаИКурсДокумента).
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Т
	|ГДЕ
	|	Т.ВВалюте
	|	И Т.Валюта <> &Основная
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.ВозвратПоставщику КАК Т
	|ГДЕ
	|	Т.Валюта <> &Основная
	|	И Т.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.ВозвратПоставщикуНалоговый КАК Т
	|ГДЕ
	|	Т.Валюта <> &Основная
	|	И Т.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка КАК Т
	|ГДЕ
	|	Т.Валюта <> &Основная
	|	И Т.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)";
	ВалютныеДокументы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если ВалютныеДокументы.Количество() = 0 Тогда
		Возврат Итоги;
	КонецЕсли;

	Для Каждого Ссылка Из ВалютныеДокументы Цикл
		ДокОбъект = Ссылка.ПолучитьОбъект();
		Если Не ДокОбъект.Проведен Тогда
			Продолжить;
		КонецЕсли;
		ПересобратьНаборДокумента(ДокОбъект, "ВзаиморасчётыСПоставщиками");
		Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг")
			Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику") Тогда
			ПересобратьНаборДокумента(ДокОбъект, "ЗаказыПоставщикам");
		КонецЕсли;
		Итоги.Документов = Итоги.Документов + 1;
	КонецЦикла;

	ПеревестиРасчётыДругихРегистраторов(ВалютныеДокументы, Итоги);
	Возврат Итоги;

КонецФункции

// Записи ВзаиморасчётыСПоставщиками других регистраторов по валютным объектам расчётов
// (см. ПеревестиВалютныеВзаиморасчётыВОсновнуюВалюту, шаг 3).
//
// Параметры:
//  ВалютныеДокументы - Массив - документы в валюте.
//  Итоги - Структура - счётчики обработчика, дополняются.
//
Процедура ПеревестиРасчётыДругихРегистраторов(ВалютныеДокументы, Итоги)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВалютныеДокументы", ВалютныеДокументы);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т
	|ГДЕ
	|	Т.ОбъектРасчётов В (&ВалютныеДокументы)
	|	И НЕ Т.Регистратор В (&ВалютныеДокументы)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Налоговые документы закупки и возвраты в основной валюте переносили долг валютного поступления
		// его суммами в валюте - их наборы тоже строятся заново; остальные регистраторы писали основную валюту.
		Если ДокументПереносаДолгаПоступления(Выборка.Регистратор) Тогда
			ДокОбъект = Выборка.Регистратор.ПолучитьОбъект();
			Если ДокОбъект.Проведен Тогда
				ПересобратьНаборДокумента(ДокОбъект, "ВзаиморасчётыСПоставщиками");
				Итоги.Документов = Итоги.Документов + 1;
			КонецЕсли;
		Иначе
			Итоги.ЗаписейОплат = Итоги.ЗаписейОплат + ПроставитьВалютуОбъектовРасчётов(Выборка.Регистратор);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Регистратор, переносящий долг поступления суммами самого поступления (налоговая накладная покупки, возвраты).
//
// Параметры:
//  Регистратор - ДокументСсылка - регистратор записи взаиморасчётов.
//
// Возвращаемое значение:
//  Булево - Истина для документов, чьи движения строятся из сумм поступления.
//
Функция ДокументПереносаДолгаПоступления(Регистратор)
	Тип = ТипЗнч(Регистратор);
	Возврат Тип = Тип("ДокументСсылка.НалоговаяНакладнаяПокупка")
		Или Тип = Тип("ДокументСсылка.ВозвратПоставщику")
		Или Тип = Тип("ДокументСсылка.ВозвратПоставщикуНалоговый");
КонецФункции

// Пересобирает набор записей регистра накопления проведённого документа текущим кодом проведения
// (РегистрыНакопления.<Имя>.СформироватьДвижения), если у документа были записи в этом регистре.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - проведённый документ.
//  ИмяРегистра - Строка - имя регистра накопления.
//
Процедура ПересобратьНаборДокумента(ДокОбъект, ИмяРегистра)

	НаборЗаписей = ДокОбъект.Движения[ИмяРегистра];
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	НаборЗаписей.Очистить();
	РегистрыНакопления[ИмяРегистра].СформироватьДвижения(ДокОбъект);
	НаборЗаписей.ОбменДанными.Загрузка = Истина;
	НаборЗаписей.Записать();

КонецПроцедуры

// Записи ВзаиморасчётыСПоставщиками регистратора в основной валюте (оплата, корректировка, сертификат)
// по объектам расчётов в валюте получают валюту объекта и сумму в ней по курсу объекта.
//
// Параметры:
//  Регистратор - ДокументСсылка - регистратор набора.
//
// Возвращаемое значение:
//  Число - количество изменённых записей.
//
Функция ПроставитьВалютуОбъектовРасчётов(Регистратор)

	Изменено = 0;
	НаборЗаписей = РегистрыНакопления.ВзаиморасчётыСПоставщиками.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	НаборЗаписей.Прочитать();
	Для Каждого Запись Из НаборЗаписей Цикл
		ВалютаОбъекта = РаботаСВалютами.ВалютаИКурсОбъекта(Запись.ОбъектРасчётов);
		Если Не ВалютаОбъекта.ВВалюте Тогда
			Продолжить;
		КонецЕсли;
		Запись.Валюта = ВалютаОбъекта.Валюта;
		Запись.СуммаВВалюте = РаботаСВалютамиКлиентСервер.СуммаВВалюте(Запись.Сумма, ВалютаОбъекта.Курс);
		Изменено = Изменено + 1;
	КонецЦикла;
	Если Изменено > 0 Тогда
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать();
	КонецЕсли;
	Возврат Изменено;

КонецФункции

Процедура ВключитьОпции(РегламентированныйУчет)

	Включено = 0;
	Для Каждого Имя Из КонстантыНовыхФункциональныхОпций() Цикл
		Если Не Константы[Имя].Получить() Тогда
			Константы[Имя].Установить(Истина);
			Включено = Включено + 1;
		КонецЕсли;
	КонецЦикла;
	Если РегламентированныйУчет И Не Константы.ИспользоватьРегламентированныйУчет.Получить() Тогда
		Константы.ИспользоватьРегламентированныйУчет.Установить(Истина);
		Включено = Включено + 1;
	КонецЕсли;
	ОбновитьПовторноИспользуемыеЗначения();

	ШаблонСообщения = НСтр("ru = 'Функциональные опции перестройки меню: включено %1';
		|fr = 'Options fonctionnelles de la refonte du menu : activées %1';
		|en = 'Menu restructuring functional options: enabled %1';
		|es = 'Opciones funcionales de la reestructuración del menú: activadas %1'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, Включено));

КонецПроцедуры

// Сверка сырья поступления с расчётом для обработчика 2.0.15.48: ошибка расчёта на нестандартном документе клиента
// (битое основание, удалённая номенклатура) не останавливает монопольное обновление - документ считается правленным
// вручную, что безопасно, и ошибка пишется в журнал (ревью S6).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеИзПереработки - документ.
//
// Возвращаемое значение:
//  Булево - сырьё совпадает с расчётом; при ошибке расчёта - Ложь.
//
Функция СырьеПоступленияПоРасчету(ДокОбъект)

	Попытка
		Возврат Документы.ПоступлениеИзПереработки.СырьеСовпадаетСРасчетом(ДокОбъект);
	Исключение
		Шаблон = НСтр("ru = 'Сырьё поступления %1 не сверено с расчётом, признак ручной правки поставлен: %2';
			|fr = 'Les matières de la réception %1 n''ont pas été comparées au calcul, l''indicateur manuel est posé : %2';
			|en = 'Materials of receipt %1 were not compared with the calculation, the manual flag is set: %2';
			|es = 'Las materias de la recepción %1 no se compararon con el cálculo, se marcó el indicador manual: %2'");
		Подробности = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщение = СтрШаблон(Шаблон, ДокОбъект.Ссылка, Подробности);
		ЗаписатьВЖурнал(Сообщение);
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Признак новой базы: данных учёта в ней ещё нет, конвертировать нечего.
//
// Возвращаемое значение:
//  Булево - Истина, если в базе нет ни одного элемента справочника Номенклатура
//
Функция ЭтоПустаяИнформационнаяБаза()

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";
	Возврат Запрос.Выполнить().Пустой();

КонецФункции

// Заполняет ОбъектРасчётов в одном налоговом регистре взаиморасчётов.
//
// Параметры:
//  ИмяРегистра - Строка - имя регистра накопления
//  Запрос      - Запрос - готовый запрос регистраторов с пустым ОбъектРасчётов
//
Процедура ЗаполнитьОбъектРасчётовРегистра(ИмяРегистра, Запрос)

	КоличествоЗаписей = 0;
	КоличествоРегистраторов = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		ЕстьИзменения = Ложь;
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Запись.ОбъектРасчётов = Неопределено И Запись.ДокументДвижения <> Неопределено Тогда
				Запись.ОбъектРасчётов = Запись.ДокументДвижения;
				ЕстьИзменения = Истина;
				КоличествоЗаписей = КоличествоЗаписей + 1;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьИзменения Тогда
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
			НаборЗаписей.Записать();
			КоличествоРегистраторов = КоличествоРегистраторов + 1;
		КонецЕсли;
	КонецЦикла;

	ШаблонСообщения = НСтр("ru = 'Заполнение ОбъектРасчётов регистра %1: обновлено записей: %2 (документов: %3)';
		|fr = 'Remplissage de ObjetDeRèglement du registre %1 : enregistrements mis à jour : %2 (documents : %3)';
		|en = 'Filling of SettlementObject of register %1: records updated: %2 (documents: %3)';
		|es = 'Relleno de ObjetoDeLiquidación del registro %1: registros actualizados: %2 (documentos: %3)'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, ИмяРегистра, КоличествоЗаписей, КоличествоРегистраторов));

КонецПроцедуры

// Общий реквизит есть у объекта: явно или по автоиспользованию.
//
// Параметры:
//  Реквизит       - ОбъектМетаданных - общий реквизит.
//  ЭлементСостава - ЭлементСоставаОбщегоРеквизита - объект из состава.
//
// Возвращаемое значение:
//  Булево - Истина, если реквизит у объекта используется.
//
Функция ОбщийРеквизитИспользуется(Реквизит, ЭлементСостава)

	Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита;
	Если ЭлементСостава.Использование = Использование.Использовать Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЭлементСостава.Использование = Использование.Авто
		И Реквизит.АвтоИспользование = Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать;

КонецФункции

// Документ, справочник или план видов характеристик: у журналов и последовательностей реквизитов нет.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект из состава общего реквизита.
//
// Возвращаемое значение:
//  Булево - Истина для объектов с реквизитами и ссылкой.
//
Функция ОбъектСРеквизитами(ОбъектМетаданных)

	Возврат Метаданные.Документы.Содержит(ОбъектМетаданных)
		Или Метаданные.Справочники.Содержит(ОбъектМетаданных)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных);

КонецФункции

// Условие на группы справочника: у групп нет реквизита, используемого только для элементов.
//
// Параметры:
//  ОбъектМетаданных      - ОбъектМетаданных - объект из состава общего реквизита.
//  РеквизитОтветственный - ОбъектМетаданных, Неопределено - реквизит Ответственный.
//
// Возвращаемое значение:
//  Строка - условие запроса, начинающееся с «И», или пустая строка.
//
Функция УсловиеБезГрупп(ОбъектМетаданных, РеквизитОтветственный)

	Если РеквизитОтветственный = Неопределено Или Метаданные.Документы.Содержит(ОбъектМетаданных)
		Или Не ОбъектМетаданных.Иерархический Тогда
		Возврат "";
	КонецЕсли;
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных)
		И ОбъектМетаданных.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияЭлементов Тогда
		Возврат "";
	КонецЕсли;
	Если РеквизитОтветственный.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента Тогда
		Возврат "
		|	И НЕ Т.ЭтоГруппа";
	КонецЕсли;
	Возврат "";

КонецФункции

// Переносит автора в пустой ответственный у записей одного объекта метаданных.
//
// Параметры:
//  ОбъектМетаданных      - ОбъектМетаданных - документ, справочник или план видов характеристик.
//  РеквизитОтветственный - ОбъектМетаданных - реквизит Ответственный типа «Пользователь».
//
// Возвращаемое значение:
//  Число - сколько записей получили ответственного.
//
// BSLLS:QueryParseError-off - имя таблицы подставляется из метаданных.
// BSLLS:DeprecatedMethodCall-off
Функция ПеренестиАвтораОбъекта(ОбъектМетаданных, РеквизитОтветственный)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	" + ОбъектМетаданных.ПолноеИмя() + " КАК Т
	|ГДЕ
	|	Т.УдалитьАвторОбщий <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|	И Т.УдалитьАвторОбщий ССЫЛКА Справочник.Пользователи
	|	И (Т.Ответственный = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|		ИЛИ Т.Ответственный = НЕОПРЕДЕЛЕНО
	|		ИЛИ Т.Ответственный ЕСТЬ NULL)" + УсловиеБезГрупп(ОбъектМетаданных, РеквизитОтветственный);
	Перенесено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписьОбъекта = Выборка.Ссылка.ПолучитьОбъект();
		ЗаписьОбъекта.Ответственный = ЗаписьОбъекта.УдалитьАвторОбщий;
		ЗаписьОбъекта.ОбменДанными.Загрузка = Истина;
		ЗаписьОбъекта.Записать();
		Перенесено = Перенесено + 1;
	КонецЦикла;
	Возврат Перенесено;

КонецФункции

// Пишет в журнал авторов, которые остаются только в общем реквизите УдалитьАвторОбщий.
//
// Параметры:
//  ОбъектМетаданных    - ОбъектМетаданных - документ, справочник или план видов характеристик.
//  ЕстьОтветственный   - Булево - у объекта есть Ответственный типа «Пользователь»: в журнал попадают записи,
//                        где он заполнен другим пользователем; иначе - все записи с автором.
//
// Возвращаемое значение:
//  Число - сколько записей с неперенесённым автором.
//
Функция ЗаписатьНеперенесенныхАвторов(ОбъектМетаданных, ЕстьОтветственный)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.УдалитьАвторОбщий КАК Автор
	|ИЗ
	|	" + ОбъектМетаданных.ПолноеИмя() + " КАК Т
	|ГДЕ
	|	Т.УдалитьАвторОбщий <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|	И Т.УдалитьАвторОбщий ССЫЛКА Справочник.Пользователи";
	Если ЕстьОтветственный Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Т.Ответственный <> Т.УдалитьАвторОбщий
		|	И Т.Ответственный <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|	И Т.Ответственный <> НЕОПРЕДЕЛЕНО
		|	И НЕ Т.Ответственный ЕСТЬ NULL";
	КонецЕсли;
	ШаблонСообщения = НСтр("ru = 'Автор не перенесён: %1 %2 (%3), автор %4 (%5)';
		|fr = 'Auteur non transféré : %1 %2 (%3), auteur %4 (%5)';
		|en = 'Author not transferred: %1 %2 (%3), author %4 (%5)';
		|es = 'Autor no trasladado: %1 %2 (%3), autor %4 (%5)'");
	Количество = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдентификаторЗаписи = Выборка.Ссылка.УникальныйИдентификатор();
		ИдентификаторАвтора = Выборка.Автор.УникальныйИдентификатор();
		Сообщение = СтрШаблон(ШаблонСообщения, ОбъектМетаданных.ПолноеИмя(), Выборка.Ссылка, ИдентификаторЗаписи,
			Выборка.Автор, ИдентификаторАвтора);
		ЗаписатьВЖурнал(Сообщение);
		Количество = Количество + 1;
	КонецЦикла;
	Возврат Количество;

КонецФункции
// BSLLS:DeprecatedMethodCall-on
// BSLLS:QueryParseError-on

// Опция «Ордерные склады» (2.0.16.107, план warehouse-orders-option): включается, если ордерная схема в базе уже
// используется - есть склад с признаком ордерности или хотя бы один ордер, включая черновики. Иначе опция остаётся
// выключенной: признак склада и ордера скрыты, как в новой базе. Повтор ничего не меняет.
//
Процедура ВключитьОпциюОрдерныхСкладов() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Если Справочники.МестаХранения.ОрдерныеСкладыВключены()
		Или Не Справочники.МестаХранения.ОрдерныеСкладыИспользуются() Тогда
		Возврат;
	КонецЕсли;
	Константы.ИспользоватьОрдерныеСклады.Установить(Истина);
	ЗаписатьВЖурнал(НСтр("ru = 'Включена опция «Ордерные склады»: в базе есть ордерные склады или ордера.';
		|fr = 'Option « Entrepôts à bons » activée : la base contient des entrepôts à bons ou des bons.';
		|en = 'The «Order-based warehouses» option is on: the database has order-based warehouses or orders.';
		|es = 'Opción «Almacenes con órdenes» activada: la base tiene almacenes por órdenes u órdenes.'"));

КонецПроцедуры

// Заполняет физический регистр ТоварыНаСкладах копией истории ТоварыВНаличии (ордерные склады, фаза 1) и сверяет
// регистры по записям. Расхождение - журнал и исключение: версия базы не поднимается, следующий запуск выполнит
// обработчик снова (он идемпотентен), а физический регистр без полной истории читать некому.
//
Процедура ЗаполнитьТоварыНаСкладах() Экспорт

	Физика = РегистрыНакопления.ТоварыНаСкладах;
	Итог = Физика.ЗаполнитьПоТоварамВНаличии();
	Расхождения = Физика.РасхожденияСТоварамиВНаличии();
	Если Расхождения.Количество() > 0 Тогда
		ТекстОшибки = Физика.ТекстРасхождений(Расхождения);
		ЗаписьЖурналаРегистрации(ОбновлениеПрограммы.ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	ШаблонСообщения = НСтр("ru = 'Физическое количество по складам: документов %1, очищено наборов %2, расхождений нет';
		|fr = 'Quantités physiques par entrepôt : documents %1, ensembles effacés %2, aucun écart';
		|en = 'Physical quantities by warehouse: documents %1, record sets cleared %2, no differences';
		|es = 'Cantidades físicas por almacén: documentos %1, conjuntos borrados %2, sin diferencias'");
	ЗаписатьВЖурнал(СтрШаблон(ШаблонСообщения, Итог.Регистраторов, Итог.Очищено));

КонецПроцедуры

// Записывает итог обработчика в журнал регистрации.
//
// Параметры:
//  Сообщение - Строка - текст сообщения
//
Процедура ЗаписатьВЖурнал(Сообщение)

	ЗаписьЖурналаРегистрации(ОбновлениеПрограммы.ИмяСобытияЖурнала(),
		УровеньЖурналаРегистрации.Информация, , , Сообщение);

КонецПроцедуры

// Товары, у которых есть строки старой ТЧ.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура
//
Функция ТоварыСоСтарымиСвойствами()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Строки.Ссылка КАК Товар
	|ИЗ
	|	Справочник.Номенклатура.СвойстваНоменклатуры КАК Строки");
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Товар");

КонецФункции

// Строки старой ТЧ с данными значения в порядке строк.
//
// Параметры:
//  Товары - Массив из СправочникСсылка.Номенклатура - порция товаров
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Товар, Вид, Значение (реквизит ЗначениеСвойства старого значения; NULL - значения нет)
//
Функция СтрокиСтарыхСвойств(Товары)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Строки.Ссылка КАК Товар,
	|	Строки.НомерСтроки КАК НомерСтроки,
	|	Строки.СвойствоНоменклатуры КАК Вид,
	|	Значения.ЗначениеСвойства КАК Значение
	|ИЗ
	|	Справочник.Номенклатура.СвойстваНоменклатуры КАК Строки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗначенияСвойствНоменклатуры КАК Значения
	|		ПО Строки.ЗначениеСвойства = Значения.Ссылка
	|ГДЕ
	|	Строки.Ссылка В (&Товары)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товар,
	|	НомерСтроки");
	Запрос.УстановитьПараметр("Товары", Товары);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Параметры:
//  Товар    - СправочникСсылка.Номенклатура - товар
//  Строки   - Массив из СтрокаТаблицыЗначений - его строки старой ТЧ в порядке строк, см. СтрокиСтарыхСвойств
//  Свойства - Соответствие - см. СвойстваСтарыхВидов
//  Итог     - Структура - см. ПеренестиСтарыеСвойстваТоваров, дополняется
//
Процедура ПеренестиСтарыеСвойстваТовара(Товар, Строки, Свойства, Итог)

	// Последняя строка вида побеждает - та же семантика, что у значения свойства в новом механизме.
	Последние = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Последние.Вставить(Строка.Вид, Строка.Значение);
	КонецЦикла;

	Если Товар.ПолучитьОбъект() = Неопределено Тогда
		Шаблон = НСтр("ru = '%1: товар не найден'; fr = '%1 : article introuvable'; en = '%1: item not found';
			|es = '%1: artículo no encontrado'");
		Итог.Ошибки.Добавить(СтрШаблон(Шаблон, Товар));
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.Номенклатура");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Товар);
	// Счётчики товара попадают в итог только после фиксации (ревью Codex 2.0.16.66, P2).
	Перенесено = 0;
	УжеЗадано = 0;
	Пустые = Новый Массив;
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		Объект = Товар.ПолучитьОбъект();
		Для Каждого Пара Из Последние Цикл
			Свойство = Свойства.Получить(Пара.Ключ);
			Если Свойство = Неопределено Или Не ЗначениеЗаполнено(Пара.Значение) Тогда
				Пустые.Добавить(СтрШаблон("%1; %2", Товар, Пара.Ключ));
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗадано(Объект, Свойство) Тогда
				УжеЗадано = УжеЗадано + 1;
				Продолжить;
			КонецЕсли;
			УправлениеСвойствами.УстановитьЗначениеСвойстваВОбъекте(Объект, Свойство, Пара.Значение);
			Перенесено = Перенесено + 1;
		КонецЦикла;
		Если Перенесено > 0 Тогда
			// Перенос не меняет бизнес-данных товара: без проверок и подписок записи.
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		// Обработчик собирает ошибки всех товаров и падает в конце (см. ПеренестиСтарыеСвойстваНоменклатуры).
		// BSLLS:DeprecatedMethodCall-off
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		// BSLLS:DeprecatedMethodCall-on
		Итог.Ошибки.Добавить(СтрШаблон("%1: %2", Товар, Текст));
		Возврат;
	КонецПопытки;
	Итог.Строк = Итог.Строк + Перенесено;
	Итог.Товаров = Итог.Товаров + ?(Перенесено > 0, 1, 0);
	Итог.УжеЗадано = Итог.УжеЗадано + УжеЗадано;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Итог.Пустые, Пустые);

КонецПроцедуры

// Параметры:
//  Объект   - СправочникОбъект.Номенклатура - товар
//  Свойство - ПланВидовХарактеристикСсылка.ДополнительныеРеквизиты - свойство
//
// Возвращаемое значение:
//  Булево - у товара уже есть заполненное значение свойства
//
Функция ЗначениеЗадано(Объект, Свойство)

	Для Каждого Строка Из Объект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", Свойство)) Цикл
		Если ЗначениеЗаполнено(Строка.Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Параметры:
//  Вид - СправочникСсылка.ВидыСвойствНоменклатуры - старый вид
//
// Возвращаемое значение:
//  Строка - имя нового свойства для программного доступа
//
Функция ИмяСтарогоСвойства(Вид)

	Возврат "СтароеСвойство_" + СтрЗаменить(Строка(Вид.УникальныйИдентификатор()), "-", "");

КонецФункции

Процедура ДобавитьИмяТипа(ТипыВидов, Вид, ИмяТипа)

	Если ИмяТипа = "" Тогда
		Возврат;
	КонецЕсли;
	Имена = ТипыВидов.Получить(Вид);
	Если Имена = Неопределено Тогда
		Имена = Новый Массив;
		ТипыВидов.Вставить(Вид, Имена);
	КонецЕсли;
	Если Имена.Найти(ИмяТипа) = Неопределено Тогда
		Имена.Добавить(ИмяТипа);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Число, Дата, Null - реквизит ЗначениеСвойства старого значения
//
// Возвращаемое значение:
//  Строка - «Строка», «Число», «Дата» или пустая
//
Функция ИмяТипаЗначения(Значение)

	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Строка") Или Тип = Тип("Число") Или Тип = Тип("Дата") Тогда
		Возврат Строка(Тип);
	КонецЕсли;
	Возврат "";

КонецФункции

// Параметры:
//  ТипВида - ПеречислениеСсылка.ТипыЗначенийСвойствНоменклатуры - объявленный тип вида
//
// Возвращаемое значение:
//  Строка - «Строка», «Число», «Дата» или пустая
//
Функция ИмяТипаВида(ТипВида)

	Типы = Новый Соответствие;
	Типы.Вставить(Перечисления.ТипыЗначенийСвойствНоменклатуры.Число, Тип("Число"));
	Типы.Вставить(Перечисления.ТипыЗначенийСвойствНоменклатуры.Дата, Тип("Дата"));
	Типы.Вставить(Перечисления.ТипыЗначенийСвойствНоменклатуры.Строка, Тип("Строка"));
	Тип = Типы.Получить(ТипВида);
	Возврат ?(Тип = Неопределено, "", Строка(Тип));

КонецФункции

// Тип нового свойства с квалификаторами плана видов характеристик (Строка(200), Число(15,3), Дата) - подмножество его
// типа (tiny1C bsl-007), шире старых Строка(10) и Число(10): обрезки нет. Без типов - Строка.
//
// Параметры:
//  ИменаТипов - Массив из Строка, Неопределено - см. ИмяТипаЗначения
//
// Возвращаемое значение:
//  ОписаниеТипов - тип значения свойства
//
Функция ТипСтарогоСвойства(ИменаТипов)

	ТипСтрока = Тип("Строка");
	Имена = ИменаТипов;
	Если Имена = Неопределено Или Имена.Количество() = 0 Тогда
		Имена = Новый Массив;
		Имена.Добавить(Строка(ТипСтрока));
	КонецЕсли;
	Типы = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Если Имя = Строка(ТипСтрока) Тогда
			Типы.Добавить(ТипСтрока);
		ИначеЕсли Имя = Строка(Тип("Число")) Тогда
			Типы.Добавить(Тип("Число"));
		Иначе
			Типы.Добавить(Тип("Дата"));
		КонецЕсли;
	КонецЦикла;
	// BSLLS:MagicNumber-off - квалификаторы типа плана видов характеристик ДополнительныеРеквизиты.
	Возврат Новый ОписаниеТипов(Типы, Новый КвалификаторыЧисла(15, 3), Новый КвалификаторыСтроки(200),
		Новый КвалификаторыДаты(ЧастиДаты.Дата));
	// BSLLS:MagicNumber-on

КонецФункции

// Параметры:
//  Видов - Число - видов свойств перенесено
//  Итог  - Структура - см. ПеренестиСтарыеСвойстваТоваров
//
// Возвращаемое значение:
//  Строка - запись журнала регистрации
//
Функция ОтчетПереносаСтарыхСвойств(Видов, Итог)

	Пустых = Итог.Пустые.Количество();
	Ошибок = Итог.Ошибки.Количество();
	Шаблон = НСтр("ru = 'Перенос старых свойств номенклатуры: видов %1, товаров записано %2, значений перенесено %3,
		|уже заданных %4, пустых %5, ошибок %6.'; fr = 'Transfert des anciennes propriétés des articles : types %1, articles
		|enregistrés %2, valeurs transférées %3, déjà renseignées %4, vides %5, erreurs %6.'; en = 'Transfer of old item
		|properties: types %1, items saved %2, values moved %3, already set %4, empty %5, errors %6.'; es = 'Traslado de las
		|propiedades antiguas de los artículos: tipos %1, artículos guardados %2, valores trasladados %3, ya definidos %4,
		|vacíos %5, errores %6.'");
	Текст = СтрШаблон(Шаблон, Видов, Итог.Товаров, Итог.Строк, Итог.УжеЗадано, Пустых, Ошибок);
	Если Итог.Пустые.Количество() > 0 Тогда
		Заголовок = НСтр("ru = 'Пустые значения (товар; вид):'; fr = 'Valeurs vides (article ; type) :';
			|en = 'Empty values (item; type):'; es = 'Valores vacíos (artículo; tipo):'");
		Текст = Текст + Символы.ПС + Заголовок + Символы.ПС + СтрСоединить(Итог.Пустые, Символы.ПС);
	КонецЕсли;
	Возврат Текст;

КонецФункции

#КонецОбласти
