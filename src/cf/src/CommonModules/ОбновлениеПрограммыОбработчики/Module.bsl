	Обработчик.Версия = "2.0.15.48";
	Обработчик.РежимВыполнения = РежимМонопольно;
	Обработчик.Процедура = "ОбновлениеПрограммыОбработчики.ЗаполнитьУслугиИПризнакПоступленийИзПереработки";
	Обработчик.Комментарий = НСтр("ru = 'Услуги переработчика по строкам продукции и признак ручной правки сырья
