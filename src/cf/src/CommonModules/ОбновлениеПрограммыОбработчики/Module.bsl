	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "2.0.16.5";
	Обработчик.РежимВыполнения = "Оперативно";
	Обработчик.НачальноеЗаполнение = Истина;
	Обработчик.Процедура = "ОбновлениеПрограммыОбработчики.ВключитьНовыеФункциональныеОпции";
	Обработчик.Комментарий = НСтр("ru = 'Функциональные опции новой базы включены; выбор - в мастере первого запуска.';
