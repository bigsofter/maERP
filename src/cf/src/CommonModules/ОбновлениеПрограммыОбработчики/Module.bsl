////////////////////////////////////////////////////////////////////////////////
// Обработчики обновления информационной базы.
//
// Единственная точка регистрации: ПриДобавленииОбработчиковОбновления. Сами
// обработчики - экспортные процедуры без параметров, выполняются ядром
// (ОбновлениеПрограммы) по возрастанию версий и только один раз на базе.
// Каждый обработчик обязан быть идемпотентным: при падении следующего входа
// он может быть выполнен повторно.
//
// Состояние базы обработчики читают под любым пользователем, поэтому работают
// в привилегированном режиме.
// BSLLS:SetPrivilegedMode-off
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Регистрирует обработчики обновления.
//
// Параметры:
//  Обработчики - ТаблицаЗначений - см. ОбновлениеПрограммы.НоваяТаблицаОбработчиков
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Возврат;

КонецПроцедуры

// Версия данных базы, с которой начинается обновление, когда записи в регистре
// ВерсииПодсистем ещё нет.
//
// Возвращаемое значение:
//  Строка - версия; пустая строка для новой (пустой) базы
//
Функция СтартоваяВерсияИнформационнойБазы() Экспорт

	Если ЭтоПустаяИнформационнаяБаза() Тогда
		Возврат "";
	КонецЕсли;

	Возврат ОбновлениеПрограммы.ВерсияКонфигурации();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Признак новой базы: данных учёта в ней ещё нет, конвертировать нечего.
//
// Возвращаемое значение:
//  Булево - Истина, если в базе нет ни одного элемента справочника Номенклатура
//
Функция ЭтоПустаяИнформационнаяБаза()

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";
	Возврат Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти
