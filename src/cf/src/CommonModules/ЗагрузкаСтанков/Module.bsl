// Выборка записей «Загрузки станков» станков, начатых до конца периода, с данными документа; условие на окончание
// дописывает вызывающий.
//
// Возвращаемое значение:
//  Строка - текст запроса без условия на окончание
//
Функция ТекстВыборкиЗанятости()

	Возврат
	"ВЫБРАТЬ
	|	Загрузка.Станок КАК Станок,
	|	Загрузка.Начало КАК Начало,
	|	Загрузка.Окончание КАК Окончание,
	|	Загрузка.Регистратор КАК Регистратор,
	|	Загрузка.ВидЗаписи КАК ВидЗаписи,
	|	Загрузка.План КАК План,
	|	Загрузка.Заказ КАК Заказ,
	|	Загрузка.Вес КАК Вес,
	|	ЕСТЬNULL(Требования.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.ПустаяСсылка)) КАК Статус,
	|	Требования.Номенклатура КАК Продукция,
	|	ЕСТЬNULL(Заказы.Номер, """") КАК НомерЗаказа,
	|	ЕСТЬNULL(Требования.Длительность, 0) КАК Длительность,
	|	ЕСТЬNULL(Требования.Количество, 0) КАК Количество,
	|	Обслуживание.ВидОбслуживания КАК ВидОбслуживания,
	|	ЕСТЬNULL(Обслуживание.Причина, """") КАК Причина
	|ИЗ
	|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТребованиеНакладная КАК Требования
	|		ПО Загрузка.Регистратор = Требования.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
	|		ПО Загрузка.Заказ = Заказы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОбслуживаниеСтанка КАК Обслуживание
	|		ПО Загрузка.Регистратор = Обслуживание.Ссылка
	|ГДЕ
	|	Загрузка.Станок В(&Станки)
	|	И Загрузка.Начало < &Окончание";

