КонецФункции

// Конец очереди станков: позднейшее окончание записей «Загрузки станков» после момента, без горизонта. Затянувшаяся
// работа кончилась по расчёту до момента и в выборку не входит: её окончание неизвестно.
//
// Параметры:
//  Станки - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Момент - Дата - момент
//
// Возвращаемое значение:
//  Соответствие - ключ: станок; значение: Дата
//
Функция КонцыОчередиСтанков(Станки, Момент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Загрузка.Станок КАК Станок,
	|	МАКСИМУМ(Загрузка.Окончание) КАК Окончание
	|ИЗ
	|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|ГДЕ
	|	Загрузка.Станок В(&Станки)
	|	И Загрузка.Окончание > &Момент
	|
	|СГРУППИРОВАТЬ ПО
	|	Загрузка.Станок";
	Запрос.УстановитьПараметр("Станки", Станки);
	Запрос.УстановитьПараметр("Момент", Момент);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Станок, Выборка.Окончание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Что на станке в момент и когда освободится: записи, накрывающие момент, - все для «Занят», «Освободится» и
// «Затянулась» (факт работы и обслуживания могут пересекаться), одна по приоритету состояния - для текста и документа.
//
// Параметры:
//  Строка          - СтрокаТаблицыЗначений - строка НоваяТаблицаОсвобождения
//  Записи          - Массив из СтрокаТаблицыЗначений - занятость станка с момента, см. ЗанятостьСтанков
//  ИнтервалыСтанка - Массив из СтрокаТаблицыЗначений - рабочие интервалы станка с момента
//  Момент          - Дата - момент
//
Процедура ЗаполнитьОсвобождениеСейчас(Строка, Записи, ИнтервалыСтанка, Момент)

	Сейчас = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если Запись.Начало > Момент Или Запись.Окончание <= Момент Тогда
			Продолжить;
		КонецЕсли;
		Сейчас.Добавить(Запись);
		Строка.Освободится = Макс(Строка.Освободится, Запись.Окончание);
		Если Запись.Затянулась Тогда
			Строка.Затянулась = Истина;
			Строка.РасчетноеОкончание = Запись.РасчетноеОкончание;
		КонецЕсли;
	КонецЦикла;
	Строка.Занят = Сейчас.Количество() > 0;
	Если Строка.Затянулась Тогда
		Строка.Освободится = Дата(1, 1, 1);
	КонецЕсли;
	Строка.Занятость = ?(Строка.Занят,
		НСтр("ru = 'Загружен'; fr = 'Occupée'; en = 'Busy'; es = 'Ocupada'"),
		НСтр("ru = 'Свободен'; fr = 'Libre'; en = 'Free'; es = 'Libre'"));
	Выбранная = ЗаполнитьСостояниеСейчас(Строка, Сейчас, НачалоРаботы(ИнтервалыСтанка, Момент) = Момент);
	Если Выбранная <> Неопределено Тогда
		Строка.Документ = Выбранная.Регистратор;
		Строка.Заказ = Выбранная.Заказ;
		Строка.Продукция = Выбранная.Продукция;
	КонецЕсли;

КонецПроцедуры

// Часы работы станка в рабочем времени периода: объединение записей «Работа» (план и факт не складываются дважды).
//
// Параметры:
//  Записи          - Массив из СтрокаТаблицыЗначений - занятость одного станка, см. ЗанятостьСтанков
//  ИнтервалыСтанка - Массив из СтрокаТаблицыЗначений - рабочие интервалы станка за период
//  Начало          - Дата - начало периода
//  Окончание       - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  Число - часы
//
Функция ЧасыРаботыВРабочееВремя(Записи, ИнтервалыСтанка, Начало, Окончание)

	Работа = НоваяТаблицаИнтервалов();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ВидЗаписи = Перечисления.ВидыЗагрузкиСтанков.Работа Тогда
			Интервал = Работа.Добавить();
			Интервал.Станок = Запись.Станок;
			Интервал.Начало = Макс(Запись.Начало, Начало);
			Интервал.Окончание = Мин(Запись.Окончание, Окончание);
		КонецЕсли;
	КонецЦикла;
	Слитые = НоваяТаблицаИнтервалов();
	ДобавитьСлитыеИнтервалы(Слитые, Работа);
	Часы = 0;
	Для Каждого Интервал Из Слитые Цикл
		Часы = Часы + ЧасыВРабочееВремя(ИнтервалыСтанка, Интервал.Начало, Интервал.Окончание);
	КонецЦикла;
	Возврат Часы;

КонецФункции

// Начало ближайшего планового обслуживания станков не раньше момента.
//
// Параметры:
//  Станки - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Момент - Дата - момент
//
// Возвращаемое значение:
//  Соответствие - ключ: станок; значение: Дата
//
Функция БлижайшееОбслуживание(Станки, Момент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Загрузка.Станок КАК Станок,
	|	МИНИМУМ(Загрузка.Начало) КАК Начало
	|ИЗ
	|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|ГДЕ
	|	Загрузка.Станок В(&Станки)
	|	И Загрузка.Начало >= &Момент
	|	И Загрузка.План
	|	И Загрузка.ВидЗаписи = ЗНАЧЕНИЕ(Перечисление.ВидыЗагрузкиСтанков.Обслуживание)
	|
	|СГРУППИРОВАТЬ ПО
	|	Загрузка.Станок";
	Запрос.УстановитьПараметр("Станки", Станки);
	Запрос.УстановитьПараметр("Момент", Момент);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Станок, Выборка.Начало);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Что на станке сейчас: фактическое обслуживание, работа (в том числе затянувшаяся), обслуживание по плану,
// нерабочее время, ожидание запуска по плану или свободен.
//
// Параметры:
//  Строка  - СтрокаТаблицыЗначений - строка НоваяТаблицаОсвобождения
//  Записи  - Массив из СтрокаТаблицыЗначений - занятость станка, накрывающая момент
//  Рабочее - Булево - момент в рабочем времени станка
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - запись, по которой выбрано состояние; Неопределено - станок свободен или
//                                        нерабочее время без записей
//
Функция ЗаполнитьСостояниеСейчас(Строка, Записи, Рабочее)

	Виды = Перечисления.ВидыЗагрузкиСтанков;
	Найденные = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Ключ = ?(Запись.План, "План", "Факт") + ?(Запись.ВидЗаписи = Виды.Работа, "Работа", "Обслуживание");
		Найденные.Вставить(Ключ, Запись);
	КонецЦикла;
	Запись = Найденные.Получить("ФактОбслуживание");
	Если Запись <> Неопределено Тогда
		Шаблон = НСтр("ru = 'Обслуживание: %1'; fr = 'Maintenance : %1'; en = 'Maintenance: %1'; es = 'Mantenimiento: %1'");
		Строка.Состояние = СтрШаблон(Шаблон, Строка(Запись.ВидОбслуживания));
		Возврат Запись;
	КонецЕсли;
	Запись = Найденные.Получить("ФактРабота");
	Если Запись <> Неопределено Тогда
		Строка.Требование = Запись.Регистратор;
		Шаблон = НСтр("ru = 'Работает: заказ %1'; fr = 'En marche : commande %1'; en = 'Running: order %1';
			|es = 'En marcha: pedido %1'");
		Строка.Состояние = СтрШаблон(Шаблон, СокрЛП(Запись.НомерЗаказа));
		Если Запись.Затянулась Тогда
			Строка.Состояние = Строка.Состояние + НСтр("ru = ' - идёт дольше расчёта'; fr = ' - dure plus que prévu';
				|en = ' - running longer than planned'; es = ' - dura más de lo previsto'");
		КонецЕсли;
		Возврат Запись;
	КонецЕсли;
	Запись = Найденные.Получить("ПланОбслуживание");
	Если Запись <> Неопределено Тогда
		Шаблон = НСтр("ru = 'Обслуживание по плану: %1'; fr = 'Maintenance planifiée : %1';
			|en = 'Planned maintenance: %1'; es = 'Mantenimiento planificado: %1'");
		Строка.Состояние = СтрШаблон(Шаблон, Строка(Запись.ВидОбслуживания));
		Возврат Запись;
	КонецЕсли;
	Если Не Рабочее Тогда
		Строка.Состояние = НСтр("ru = 'Нерабочее время'; fr = 'Hors service'; en = 'Off hours'; es = 'Fuera de horario'");
		Возврат Неопределено;
	КонецЕсли;
	Запись = Найденные.Получить("ПланРабота");
	Если Запись <> Неопределено Тогда
		Строка.Требование = Запись.Регистратор;
		Шаблон = НСтр("ru = 'Ждёт запуска: заказ %1'; fr = 'À lancer : commande %1';
			|en = 'Waiting to start: order %1'; es = 'Pendiente de inicio: pedido %1'");
		Строка.Состояние = СтрШаблон(Шаблон, СокрЛП(Запись.НомерЗаказа));
		Возврат Запись;
	КонецЕсли;
	Строка.Состояние = НСтр("ru = 'Свободен'; fr = 'Libre'; en = 'Idle'; es = 'Libre'");
	Возврат Неопределено;

КонецФункции

Функция НоваяТаблицаАвтоплана()

	ТипЧисло = Новый ОписаниеТипов("Число");
	ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	Таблица = Новый ТаблицаЗначений;
