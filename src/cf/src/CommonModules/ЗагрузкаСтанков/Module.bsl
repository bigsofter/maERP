// Начало следующей фактической работы станка после записи: запущенное требование идёт до момента расчёта, но не
// поверх работы, начатой после него (защита от возврата в работу задним числом, ревью плана сборки 4, P1-1).
//
// Параметры:
//  Записи - Массив из СтрокаТаблицыЗначений - фактические записи станка, см. ФактическиеЗаписиПериода
//  Запись - СтрокаТаблицыЗначений - запись работы
//
// Возвращаемое значение:
//  Дата - начало следующей работы; нет её - окончание записи
//
Функция НачалоСледующейРаботы(Записи, Запись)

	Результат = Запись.Окончание;
	Для Каждого Другая Из Записи Цикл
		Если Другая.ВидЗаписи = Запись.ВидЗаписи И Другая.Документ <> Запись.Документ И Другая.Начало > Запись.Начало Тогда
			Результат = Мин(Результат, Другая.Начало);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИнтервалыВсегоПериода(Станки, Начало, Окончание)

	Интервалы = НоваяТаблицаИнтервалов();
	Для Каждого Станок Из Станки Цикл
		Интервал = Интервалы.Добавить();
		Интервал.Станок = Станок;
		Интервал.Начало = Начало;
		Интервал.Окончание = Окончание;
	КонецЦикла;
	Возврат Интервалы;

КонецФункции

Функция СтрокаКатегорииДокумента(Категории, Строки, Станок, Документ)

	Строка = Строки.Получить(Документ);
	Если Строка = Неопределено Тогда
		Строка = Категории.Добавить();
		Строка.Станок = Станок;
		Строка.Документ = Документ;
		Строки.Вставить(Документ, Строка);
	КонецЕсли;
	Возврат Строка;

КонецФункции

