// Строки одного заказа в «Готовых к запуску». Остаток к производству по ключу продукции = КВыпуску - Выпущено -
// открытые требования; у строки - её количество за вычетом открытых требований этой строки, не больше остатка ключа
// (разносится по строкам по порядку). Строки без материалов, без остатка и с продукцией в переработке пропускаются;
// у заказа ранней стадии - и строки, материалов которых на складе размещения не хватает.
//
// Параметры:
//  Готовые     - ТаблицаЗначений - см. НоваяТаблицаГотовых
//  СтрокаЗаказа - СтрокаТаблицыЗначений - заказ и его стадия
//  Данные      - Структура - Строки, Материалы, ВТребованиях, НаСкладе - таблицы пакета ДанныеГотовыхКЗапуску
//
Процедура ДобавитьГотовыеЗаказа(Готовые, СтрокаЗаказа, Данные)

	Заказ = СтрокаЗаказа.Заказ;
	ИзСклада = СтрокаЗаказа.Стадия <> Перечисления.СтатусыЗаказовПокупателя.ВПроизводстве;
	Отбор = Новый Структура("Заказ", Заказ);
	ВТребованияхЗаказа = Данные.ВТребованиях.Скопировать(Отбор);
	Остатки = ОстаткиКПроизводству(Заказ, ВТребованияхЗаказа);
	МатериалыЗаказа = Данные.Материалы.Скопировать(Отбор);
	СПотомками = Документы.ЗаказПокупателя.КодыСтрокСПотомками(МатериалыЗаказа);
	Для Каждого СтрокаПродукции Из Данные.Строки.НайтиСтроки(Отбор) Цикл
		Листья = ЛистьяМатериаловСтроки(МатериалыЗаказа, СПотомками, СтрокаПродукции.КодСтроки);
		Если Листья.Количество() = 0 Или СтрокаПродукции.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Количество = ОстатокСтрокиЗаказа(СтрокаПродукции, Остатки, ВТребованияхЗаказа);
		Если Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		КлючПродукции = Новый Структура("Заказ, Номенклатура", Заказ, СтрокаПродукции.Номенклатура);
		КлючПродукции.Вставить("Характеристика", СтрокаПродукции.Характеристика);
		Если ЗначениеЗаполнено(ТребованияНакладные.ТекстПродукцииВПереработке(КлючПродукции)) Тогда
			Продолжить;
		КонецЕсли;
		Доля = Количество / СтрокаПродукции.Количество;
		Для Каждого Лист Из Листья Цикл
			Лист.Количество = Лист.Количество * Доля;
		КонецЦикла;
		Если ИзСклада И Не МатериаловХватает(Листья, Данные.НаСкладе) Тогда
			Продолжить;
		КонецЕсли;
		Готовая = Готовые.Добавить();
		ЗаполнитьЗначенияСвойств(Готовая, СтрокаПродукции);
		Готовая.НомерЗаказа = СокрЛП(СтрокаПродукции.НомерЗаказа);
		Готовая.БезДатыОтгрузки = Не ЗначениеЗаполнено(СтрокаПродукции.ДатаОтгрузки);
		Готовая.Остаток = Количество;
		Готовая.ИзСклада = ИзСклада;
		Вес = ВесНоменклатурыКг(Листья);
		Готовая.Вес = Вес.Вес;
		Если Вес.БезВеса.Количество() > 0 Тогда
			Шаблон = НСтр("ru = 'Не задан вес: %1'; fr = 'Poids non renseigné : %1'; en = 'No weight: %1';
				|es = 'Sin peso: %1'");
			Готовая.ТекстОшибки = СтрШаблон(Шаблон, СтрСоединить(Вес.БезВеса, ", "));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Остаток к производству заказа по ключу продукции: КВыпуску - Выпущено - открытые требования.
//
// Параметры:
//  Заказ              - ДокументСсылка.ЗаказПокупателя - заказ
//  ВТребованияхЗаказа - ТаблицаЗначений - открытые требования заказа по строкам и продукции
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура, Характеристика, Осталось
//
Функция ОстаткиКПроизводству(Заказ, ВТребованияхЗаказа)

	Остатки = ПроизводственныеЗаказы.ВыполнениеПоПродукции(Заказ).Скопировать(,
		"Номенклатура, Характеристика, КВыпуску, Выпущено");
	Остатки.Колонки.Добавить("Осталось", Новый ОписаниеТипов("Число"));
	Для Каждого Остаток Из Остатки Цикл
		Остаток.Осталось = Остаток.КВыпуску - Остаток.Выпущено;
	КонецЦикла;
	Остатки.Свернуть("Номенклатура, Характеристика", "Осталось");
	Для Каждого Открытое Из ВТребованияхЗаказа Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика", Открытое.Номенклатура, Открытое.Характеристика);
		Для Каждого Остаток Из Остатки.НайтиСтроки(Отбор) Цикл
			Остаток.Осталось = Остаток.Осталось - Открытое.Количество;
		КонецЦикла;
	КонецЦикла;
	Возврат Остатки;

КонецФункции

// Остаток строки заказа к размещению: её количество за вычетом открытых требований этой строки, не больше остатка ключа
// продукции; забранное строкой вычитается из остатка ключа (разнесение по строкам по порядку).
//
// Параметры:
//  СтрокаПродукции    - СтрокаТаблицыЗначений - строка продукции заказа
//  Остатки            - ТаблицаЗначений - см. ОстаткиКПроизводству
//  ВТребованияхЗаказа - ТаблицаЗначений - открытые требования заказа по строкам и продукции
//
// Возвращаемое значение:
//  Число - остаток строки; 0 и меньше - строку не показывать
//
Функция ОстатокСтрокиЗаказа(СтрокаПродукции, Остатки, ВТребованияхЗаказа)

	КлючПродукции = Новый Структура("Номенклатура, Характеристика", СтрокаПродукции.Номенклатура,
		СтрокаПродукции.Характеристика);
	НайденныеОстатки = Остатки.НайтиСтроки(КлючПродукции);
	Если НайденныеОстатки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	ОстатокПродукции = НайденныеОстатки[0];
	КлючПродукции.Вставить("КодСтроки", СтрокаПродукции.КодСтроки);
	Количество = Мин(СтрокаПродукции.Количество - СуммаКолонки(ВТребованияхЗаказа.НайтиСтроки(КлючПродукции)),
		ОстатокПродукции.Осталось);
	Если Количество > 0 Тогда
		ОстатокПродукции.Осталось = ОстатокПродукции.Осталось - Количество;
	КонецЕсли;
	Возврат Количество;

КонецФункции

Функция СуммаКолонки(Строки)

	Сумма = 0;
	Для Каждого Строка Из Строки Цикл
		Сумма = Сумма + Строка.Количество;
	КонецЦикла;
	Возврат Сумма;

КонецФункции

// Хватает ли материалов строки на складе размещения (каждого материала - не меньше нужного; без резерва).
//
// Параметры:
//  Листья   - ТаблицаЗначений - материалы на остаток строки: Номенклатура, Характеристика, Количество
//  НаСкладе - ТаблицаЗначений - остатки склада: Номенклатура, Характеристика, Количество
//
// Возвращаемое значение:
//  Булево - Истина, если хватает всех
//
Функция МатериаловХватает(Листья, НаСкладе)

	Нужно = Листья.Скопировать();
	Нужно.Свернуть("Номенклатура, Характеристика", "Количество");
	Для Каждого Материал Из Нужно Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика", Материал.Номенклатура, Материал.Характеристика);
		Если СуммаКолонки(НаСкладе.НайтиСтроки(Отбор)) < Материал.Количество Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Листья дерева материалов строки продукции заказа - то, что загружается на станок (как ЗаполнитьПоСтрокеЗаказа).
//
// Параметры:
//  МатериалыЗаказа - ТаблицаЗначений - материалы одного заказа
//  СПотомками      - Соответствие - см. Документы.ЗаказПокупателя.КодыСтрокСПотомками
//  КодСтроки       - Число - КодСтроки строки продукции
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура, Характеристика, Количество (на всю строку заказа)
//
Функция ЛистьяМатериаловСтроки(МатериалыЗаказа, СПотомками, КодСтроки)

	Листья = МатериалыЗаказа.СкопироватьКолонки("Номенклатура, Характеристика, Количество");
	Для Каждого Материал Из МатериалыЗаказа Цикл
		Если Материал.КодСтрокиПродукции <> КодСтроки Или Не ЗначениеЗаполнено(Материал.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Если СПотомками[Документы.ЗаказПокупателя.КлючРодителяМатериала(КодСтроки, Материал.КодСтроки)] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Листья.Добавить(), Материал);
	КонецЦикла;
	Возврат Листья;

КонецФункции

// Время «Готовых к запуску» на выбранном станке и просрочка: окончание ближайшего окна позже дня отгрузки.
//
// Параметры:
//  Готовые - ТаблицаЗначений - см. НоваяТаблицаГотовых
//  Станок  - СправочникСсылка.ПроизводственноеОборудование - станок; пустой - время не считается
//  Момент  - Дата - момент расчёта
//
Процедура РассчитатьВремяГотовых(Готовые, Станок, Момент)

	Если Не ЗначениеЗаполнено(Станок) Или Готовые.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Контекст = КонтекстОкна(Станок, Момент, Момент);
	Для Каждого Готовая Из Готовые Цикл
		Если ЗначениеЗаполнено(Готовая.ТекстОшибки) Тогда
			Продолжить;
		КонецЕсли;
		Длительность = ДлительностьЗагрузки(Станок, Готовая.Вес);
		Если ЗначениеЗаполнено(Длительность.ТекстОшибки) Тогда
			Готовая.ТекстОшибки = Длительность.ТекстОшибки;
			Продолжить;
		КонецЕсли;
		Готовая.Часы = Длительность.Часы;
		Если Не Готовая.БезДатыОтгрузки Тогда
			Окно = ОкноВКонтексте(Контекст, Готовая.Часы, Момент, Неопределено);
			Готовая.Просрочен = Окно.Окончание = Неопределено Или Окно.Окончание > КонецДня(Готовая.ДатаОтгрузки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция НоваяТаблицаСостояния()

	ТипЧисло = Новый ОписаниеТипов("Число");
	Состояние = Новый ТаблицаЗначений;
	Состояние.Колонки.Добавить("Станок", Новый ОписаниеТипов("СправочникСсылка.ПроизводственноеОборудование"));
	Состояние.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Состояние.Колонки.Добавить("Требование");
	Состояние.Колонки.Добавить("Фонд", ТипЧисло);
	Состояние.Колонки.Добавить("Работа", ТипЧисло);
	Состояние.Колонки.Добавить("Загрузка", ТипЧисло);
	Состояние.Колонки.Добавить("БлижайшееОбслуживание", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Возврат Состояние;

КонецФункции

// Часы работы станка в рабочем времени периода: объединение записей «Работа» (план и факт не складываются дважды).
//
// Параметры:
//  Записи          - Массив из СтрокаТаблицыЗначений - занятость одного станка, см. ЗанятостьСтанков
//  ИнтервалыСтанка - Массив из СтрокаТаблицыЗначений - рабочие интервалы станка за период
//  Начало          - Дата - начало периода
//  Окончание       - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  Число - часы
//
Функция ЧасыРаботыВРабочееВремя(Записи, ИнтервалыСтанка, Начало, Окончание)

	Работа = НоваяТаблицаИнтервалов();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ВидЗаписи = Перечисления.ВидыЗагрузкиСтанков.Работа Тогда
			Интервал = Работа.Добавить();
			Интервал.Станок = Запись.Станок;
			Интервал.Начало = Макс(Запись.Начало, Начало);
			Интервал.Окончание = Мин(Запись.Окончание, Окончание);
		КонецЕсли;
	КонецЦикла;
	Слитые = НоваяТаблицаИнтервалов();
	ДобавитьСлитыеИнтервалы(Слитые, Работа);
	Часы = 0;
	Для Каждого Интервал Из Слитые Цикл
		Часы = Часы + ЧасыВРабочееВремя(ИнтервалыСтанка, Интервал.Начало, Интервал.Окончание);
	КонецЦикла;
	Возврат Часы;

КонецФункции

// Начало ближайшего планового обслуживания станков не раньше момента.
//
// Параметры:
//  Станки - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Момент - Дата - момент
//
// Возвращаемое значение:
//  Соответствие - ключ: станок; значение: Дата
//
Функция БлижайшееОбслуживание(Станки, Момент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Загрузка.Станок КАК Станок,
	|	МИНИМУМ(Загрузка.Начало) КАК Начало
	|ИЗ
	|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|ГДЕ
	|	Загрузка.Станок В(&Станки)
	|	И Загрузка.Начало >= &Момент
	|	И Загрузка.План
	|	И Загрузка.ВидЗаписи = ЗНАЧЕНИЕ(Перечисление.ВидыЗагрузкиСтанков.Обслуживание)
	|
	|СГРУППИРОВАТЬ ПО
	|	Загрузка.Станок";
	Запрос.УстановитьПараметр("Станки", Станки);
	Запрос.УстановитьПараметр("Момент", Момент);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Станок, Выборка.Начало);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Что на станке сейчас: фактическое обслуживание, работа (в том числе затянувшаяся), обслуживание по плану,
// нерабочее время, ожидание запуска по плану или свободен.
//
// Параметры:
//  Строка  - СтрокаТаблицыЗначений - строка НоваяТаблицаСостояния
//  Записи  - Массив из СтрокаТаблицыЗначений - занятость станка в момент
//  Рабочее - Булево - момент в рабочем времени станка
//
Процедура ЗаполнитьСостояниеСейчас(Строка, Записи, Рабочее)

	Виды = Перечисления.ВидыЗагрузкиСтанков;
	Найденные = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Ключ = ?(Запись.План, "План", "Факт") + ?(Запись.ВидЗаписи = Виды.Работа, "Работа", "Обслуживание");
		Найденные.Вставить(Ключ, Запись);
	КонецЦикла;
	Запись = Найденные.Получить("ФактОбслуживание");
	Если Запись <> Неопределено Тогда
		Шаблон = НСтр("ru = 'Обслуживание: %1'; fr = 'Maintenance : %1'; en = 'Maintenance: %1'; es = 'Mantenimiento: %1'");
		Строка.Состояние = СтрШаблон(Шаблон, Строка(Запись.ВидОбслуживания));
		Возврат;
	КонецЕсли;
	Запись = Найденные.Получить("ФактРабота");
	Если Запись <> Неопределено Тогда
		Строка.Требование = Запись.Регистратор;
		Шаблон = НСтр("ru = 'Работает: заказ %1'; fr = 'En marche : commande %1'; en = 'Running: order %1';
			|es = 'En marcha: pedido %1'");
		Строка.Состояние = СтрШаблон(Шаблон, СокрЛП(Запись.НомерЗаказа));
		Возврат;
	КонецЕсли;
	Запись = Найденные.Получить("ПланОбслуживание");
	Если Запись <> Неопределено Тогда
		Шаблон = НСтр("ru = 'Обслуживание по плану: %1'; fr = 'Maintenance planifiée : %1';
			|en = 'Planned maintenance: %1'; es = 'Mantenimiento planificado: %1'");
		Строка.Состояние = СтрШаблон(Шаблон, Строка(Запись.ВидОбслуживания));
		Возврат;
	КонецЕсли;
	Если Не Рабочее Тогда
		Строка.Состояние = НСтр("ru = 'Нерабочее время'; fr = 'Hors service'; en = 'Off hours'; es = 'Fuera de horario'");
		Возврат;
	КонецЕсли;
	Запись = Найденные.Получить("ПланРабота");
	Если Запись <> Неопределено Тогда
		Строка.Требование = Запись.Регистратор;
		Шаблон = НСтр("ru = 'Ждёт запуска: заказ %1'; fr = 'À lancer : commande %1';
			|en = 'Waiting to start: order %1'; es = 'Pendiente de inicio: pedido %1'");
		Строка.Состояние = СтрШаблон(Шаблон, СокрЛП(Запись.НомерЗаказа));
		Возврат;
	КонецЕсли;
	Строка.Состояние = НСтр("ru = 'Свободен'; fr = 'Libre'; en = 'Idle'; es = 'Libre'");

КонецПроцедуры

#КонецОбласти

#КонецОбласти
