	Таблица.Колонки.Добавить("КодСтроки", ТипЧисло);
	Таблица.Колонки.Добавить("НомерЗаказа", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Клиент");
	Таблица.Колонки.Добавить("ДатаОтгрузки", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Характеристика");
	Таблица.Колонки.Добавить("Количество", ТипЧисло);
	Таблица.Колонки.Добавить("Вес", ТипЧисло);
	Таблица.Колонки.Добавить("Станок", Новый ОписаниеТипов("СправочникСсылка.ПроизводственноеОборудование"));
	Таблица.Колонки.Добавить("Начало", ТипДата);
	Таблица.Колонки.Добавить("Окончание", ТипДата);
	Таблица.Колонки.Добавить("Часы", ТипЧисло);
	Таблица.Колонки.Добавить("Просрочен", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ТекстОшибки", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Момент", ТипДата);
