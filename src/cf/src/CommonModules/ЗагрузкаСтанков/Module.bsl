// Учёт станков: рабочее время по режиму станка и производственному календарю, загрузка станков и проверка
// пересечения интервалов. Интервалы везде полуоткрытые: [Начало, Окончание).
//
#Область ПрограммныйИнтерфейс

// Рабочие интервалы станков за период по режиму работы. День производственного календаря у станка без флажка
// «Работает без производственного календаря» нерабочий: смены, начатые в этот день, в интервалы не входят. Смена
// относится к дню своего начала, смена через полночь заканчивается на следующий день. Пересекающиеся смены
// одного станка (например, ночная смена понедельника и утренняя вторника) сливаются.
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Начало, Окончание (Дата), упорядочена по станку и началу
//
Функция ИнтервалыРаботыСтанков(Станки, Начало, Окончание) Экспорт

	Интервалы = НоваяТаблицаИнтервалов();
	Если Окончание <= Начало Или Станки.Количество() = 0 Тогда
		Возврат Интервалы;
	КонецЕсли;

	// Смена вчерашнего дня через полночь заходит в период, поэтому обход начинается на день раньше.
	ПервыйДень = НачалоДня(Начало) - СекундВСутках();
	Выходные = РегистрыСведений.ПроизводственныйКалендарь.ПолучитьВыходные(ПервыйДень, Окончание);
	РежимыСтанков = РежимыРаботы(Станки);

	Для Каждого Станок Из Станки Цикл
		Режим = РежимыСтанков.Получить(Станок);
		Если Режим = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СменыСтанка = НоваяТаблицаИнтервалов();
		День = ПервыйДень;
		Пока День < Окончание Цикл
			Смены = Режим.Смены.Получить(ДеньНедели(День));
			Если Смены <> Неопределено И Не (Режим.УчитыватьКалендарь И Выходные.Найти(День) <> Неопределено) Тогда
				ДобавитьСменыДня(СменыСтанка, Станок, День, Смены, Начало, Окончание);
			КонецЕсли;
			День = День + СекундВСутках();
		КонецЦикла;
		ДобавитьСлитыеИнтервалы(Интервалы, СменыСтанка);
	КонецЦикла;

	Возврат Интервалы;

КонецФункции

// Рабочие интервалы одного станка за период, см. ИнтервалыРаботыСтанков.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Начало, Окончание
//
Функция ИнтервалыРаботыСтанка(Станок, Начало, Окончание) Экспорт

	Станки = Новый Массив;
	Станки.Добавить(Станок);
	Возврат ИнтервалыРаботыСтанков(Станки, Начало, Окончание);

КонецФункции

// Фонд рабочего времени станка за период: сумма рабочих интервалов по режиму и календарю.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  Число - часы
//
Функция ФондВремениСтанка(Станок, Начало, Окончание) Экспорт

	Возврат ЧасыИнтервалов(ИнтервалыРаботыСтанка(Станок, Начало, Окончание));

КонецФункции

// Сумма часов интервалов таблицы.
//
// Параметры:
//  Интервалы - ТаблицаЗначений, Массив из СтрокаТаблицыЗначений - строки с колонками Начало и Окончание
//
// Возвращаемое значение:
//  Число - часы
//
Функция ЧасыИнтервалов(Интервалы) Экспорт

	Секунд = 0;
	Для Каждого Интервал Из Интервалы Цикл
		Секунд = Секунд + (Интервал.Окончание - Интервал.Начало);
	КонецЦикла;
	Возврат Секунд / СекундВЧасе();

КонецФункции

// Длительность интервала в часах, округлённая до сотых, - так её хранит регистр «Загрузка станков».
//
// Параметры:
//  Начало    - Дата - начало интервала
//  Окончание - Дата - конец интервала, не включается
//
// Возвращаемое значение:
//  Число - часы
//
Функция ЧасыМеждуДатами(Начало, Окончание) Экспорт

	Возврат ОкруглитьЧасы((Окончание - Начало) / СекундВЧасе());

КонецФункции

// Часы, округлённые до сотых, как в регистре «Загрузка станков» и в отчётах.
//
// Параметры:
//  Часы - Число - часы
//
// Возвращаемое значение:
//  Число - округлённые часы
//
Функция ОкруглитьЧасы(Часы) Экспорт

	Возврат Окр(Часы, ЗнаковЧасов());

КонецФункции

// Секунд в сутках - шаг дней планировщика и режима работы.
//
// Возвращаемое значение:
//  Число - 86400
//
Функция СекундВСутках() Экспорт

	Возврат 86400;

КонецФункции

// Сколько часов интервала [Начало, Окончание) приходится на рабочие интервалы станка.
//
// Параметры:
//  Интервалы - ТаблицаЗначений, Массив из СтрокаТаблицыЗначений - рабочие интервалы одного станка
//  Начало    - Дата - начало интервала
//  Окончание - Дата - конец интервала, не включается
//
// Возвращаемое значение:
//  Число - часы
//
Функция ЧасыВРабочееВремя(Интервалы, Начало, Окончание) Экспорт

	Секунд = 0;
	Для Каждого Интервал Из Интервалы Цикл
		ИнтервалС = Макс(Интервал.Начало, Начало);
		ИнтервалПо = Мин(Интервал.Окончание, Окончание);
		Если ИнтервалПо > ИнтервалС Тогда
			Секунд = Секунд + (ИнтервалПо - ИнтервалС);
		КонецЕсли;
	КонецЦикла;
	Возврат Секунд / СекундВЧасе();

КонецФункции

// Записи загрузки станка, с которыми конфликтует новый интервал. Конфликт - пересечение во времени с записью
// другого регистратора того же станка, если обе записи плановые (любого вида) или обе фактические одного вида
// («Работа» с «Работой», «Обслуживание» с «Обслуживанием»). Фактическое обслуживание поверх фактической работы
// допустимо: авария случается посреди загрузки. План с фактом не сверяется: план потом переносится.
// Вызывать под блокировкой загрузки станка (УправляемыеБлокировки.ЗагрузкаСтанков).
//
// Параметры:
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало      - Дата - начало интервала
//  Окончание   - Дата - конец интервала, не включается
//  ВидЗаписи   - ПеречислениеСсылка.ВидыЗагрузкиСтанков - вид новой записи
//  План        - Булево - новая запись плановая
//  Регистратор - ДокументСсылка - регистратор новой записи: его прежние записи не конфликтуют
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Регистратор, Начало, Окончание, ВидЗаписи, План
//
Функция ПересеченияЗагрузки(Станок, Начало, Окончание, ВидЗаписи, План, Регистратор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Загрузка.Регистратор КАК Регистратор,
	|	Загрузка.Начало КАК Начало,
	|	Загрузка.Окончание КАК Окончание,
	|	Загрузка.ВидЗаписи КАК ВидЗаписи,
	|	Загрузка.План КАК План
	|ИЗ
	|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|ГДЕ
	|	Загрузка.Станок = &Станок
	|	И Загрузка.Регистратор <> &Регистратор
	|	И Загрузка.Начало < &Окончание
	|	И Загрузка.Окончание > &Начало
	|	И Загрузка.План = &План
	|	И &УсловиеВида
	|
	|УПОРЯДОЧИТЬ ПО
	|	Начало";
	// Плановые записи конфликтуют при любом виде, фактические - только одного вида.
	Если Не План Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВида", "Загрузка.ВидЗаписи = &ВидЗаписи");
	КонецЕсли;
	Запрос.УстановитьПараметр("УсловиеВида", Истина);
	Запрос.УстановитьПараметр("Станок", Станок);
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Запрос.УстановитьПараметр("План", План);
	Запрос.УстановитьПараметр("ВидЗаписи", ВидЗаписи);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Текст отказа по пересечению загрузки станка для сообщения пользователю.
//
// Параметры:
//  Пересечение - СтрокаТаблицыЗначений - строка результата ПересеченияЗагрузки
//
// Возвращаемое значение:
//  Строка - текст
//
Функция ТекстПересеченияЗагрузки(Пересечение) Экспорт

	Шаблон = НСтр("ru = 'Станок занят: %1, %2 - %3';
		|fr = 'La machine est occupée : %1, %2 - %3';
		|en = 'The machine is busy: %1, %2 - %3';
		|es = 'La máquina está ocupada: %1, %2 - %3'");
	Возврат СтрШаблон(Шаблон, Пересечение.Регистратор, Формат(Пересечение.Начало, "ДФ='dd.MM.yyyy HH:mm'"),
		Формат(Пересечение.Окончание, "ДФ='dd.MM.yyyy HH:mm'"));

КонецФункции

// Предупреждение о незаполненном производственном календаре: у станка без флажка «Работает без производственного
// календаря» фонд за год без единой записи календаря молча считается без праздников и выходных. Календарь ведётся
// в «Производство → Нормативы» и в «Зарплата и кадры».
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода
//  Окончание - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  Строка - текст предупреждения; пустая строка - календарь заполнен или не нужен
//
Функция ТекстПустогоКалендаря(Станки, Начало, Окончание) Экспорт

	Если Окончание <= Начало Или Станки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Станки.Ссылка КАК Станок
	|ИЗ
	|	Справочник.ПроизводственноеОборудование КАК Станки
	|ГДЕ
	|	Станки.Ссылка В(&Станки)
	|	И НЕ Станки.РаботаетБезКалендаря";
	Запрос.УстановитьПараметр("Станки", Станки);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат "";
	КонецЕсли;

	Выходные = РегистрыСведений.ПроизводственныйКалендарь.ПолучитьВыходные(НачалоГода(Начало), КонецГода(Окончание - 1));
	ПустыеГоды = Новый Массив;
	Для НомерГода = Год(Начало) По Год(Окончание - 1) Цикл
		ГодЗаполнен = Ложь;
		Для Каждого День Из Выходные Цикл
			Если Год(День) = НомерГода Тогда
				ГодЗаполнен = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ГодЗаполнен Тогда
			ПустыеГоды.Добавить(Формат(НомерГода, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;
	Если ПустыеГоды.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'Производственный календарь на %1 не заполнен: фонд времени станков посчитан без праздников и выходных';
		|fr = 'Le calendrier de %1 n''est pas rempli : le temps disponible des machines est calculé sans jours fériés ni week-ends';
		|en = 'The working calendar for %1 is empty: machine available time is calculated without holidays and weekends';
		|es = 'El calendario laboral de %1 está vacío: el tiempo disponible se calcula sin festivos ni fines de semana'");
	Возврат СтрШаблон(Шаблон, СтрСоединить(ПустыеГоды, ", "));

КонецФункции

// Смена строки режима в секундах от начала дня. Окончание не позже начала - смена через полночь; равные
// начало и окончание (например, обе пустые - 00:00) без флажка «Круглосуточно» запрещает проверка заполнения
// станка, здесь они дают сутки, чтобы строка не пропала молча из старых данных. Одно правило для фонда и для
// проверки пересечения смен в карточке станка.
//
// Параметры:
//  НачалоСмены    - Дата - время начала
//  ОкончаниеСмены - Дата - время окончания
//  Круглосуточно  - Булево - смена на все сутки
//
// Возвращаемое значение:
//  Структура - НачалоСекунд, ОкончаниеСекунд
//
Функция СменаВСекундах(НачалоСмены, ОкончаниеСмены, Круглосуточно) Экспорт

	Если Круглосуточно Тогда
		Возврат Новый Структура("НачалоСекунд, ОкончаниеСекунд", 0, СекундВСутках());
	КонецЕсли;
	НачалоСекунд = НачалоСмены - НачалоДня(НачалоСмены);
	ОкончаниеСекунд = ОкончаниеСмены - НачалоДня(ОкончаниеСмены);
	Если ОкончаниеСекунд <= НачалоСекунд Тогда
		ОкончаниеСекунд = ОкончаниеСекунд + СекундВСутках();
	КонецЕсли;
	Возврат Новый Структура("НачалоСекунд, ОкончаниеСекунд", НачалоСекунд, ОкончаниеСекунд);

КонецФункции

// Почему нельзя выключить учёт станков или производство: путь выпуска выбирается по данным, и открытые
// требования-накладные или материалы, закреплённые на станках, остались бы без закрытия.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - выключить можно
//
Функция ТекстЗапретаВыключенияУчета() Экспорт

	// BSLLS:SetPrivilegedMode-off - запрет проверяется у любого, кто пишет константу (мастер, настройки), по всем требованиям.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Требования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Проведен
	|	И Требования.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запланировано),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Остатки.Требование
	|ИЗ
	|	РегистрНакопления.МатериалыНаСтанках.Остатки(
	|			,
	|			Станок <> ЗНАЧЕНИЕ(Справочник.ПроизводственноеОборудование.ПустаяСсылка)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток <> 0";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'На станках есть открытые требования-накладные или закреплённые материалы (%1): завершите или отмените их';
		|fr = 'Des bons de consommation machine sont ouverts ou des matières sont réservées sur les machines (%1) : terminez-les ou annulez-les';
		|en = 'There are open machine material requisitions or materials reserved on machines (%1): complete or cancel them';
		|es = 'Hay vales de consumo de máquina abiertos o materiales reservados en las máquinas (%1): termínelos o cancélelos'");
	Возврат СтрШаблон(Шаблон, Выборка.Ссылка);

КонецФункции

// Вес номенклатуры в килограммах - одно правило для всей конфигурации. Единица номенклатуры весовая - количество
// умножается на её коэффициент к килограмму (числитель / знаменатель; нулевые - 1). Иначе - на вес единицы
// «ВесЗнаменатель» в весовой единице «ВесЕдиница» (её коэффициент к килограмму; пустая - килограмм). Позиции без
// веса в итог не входят и возвращаются списком.
//
// Параметры:
//  Таблица - ТаблицаЗначений, ТабличнаяЧасть - строки с колонками Номенклатура и Количество (в единице номенклатуры)
//
// Возвращаемое значение:
//  Структура:
//   * Вес    - Число - вес, кг
//   * БезВеса - Массив из СправочникСсылка.Номенклатура - позиции, у которых вес не задан
//
Функция ВесНоменклатурыКг(Таблица) Экспорт

	Результат = Новый Структура("Вес, БезВеса", 0, Новый Массив);
	Количества = Новый Соответствие;
	Позиции = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Или Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Количество = Количества.Получить(Строка.Номенклатура);
		Если Количество = Неопределено Тогда
			Позиции.Добавить(Строка.Номенклатура);
			Количество = 0;
		КонецЕсли;
		Количества.Вставить(Строка.Номенклатура, Количество + Строка.Количество);
	КонецЦикла;
	Если Позиции.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Коэффициенты = КгНаЕдиницу(Позиции);
	Для Каждого Позиция Из Позиции Цикл
		Коэффициент = Коэффициенты.Получить(Позиция);
		Если Не ЗначениеЗаполнено(Коэффициент) Тогда
			Результат.БезВеса.Добавить(Позиция);
		Иначе
			Результат.Вес = Результат.Вес + Количества.Получить(Позиция) * Коэффициент;
		КонецЕсли;
	КонецЦикла;
	Результат.Вес = Окр(Результат.Вес, ЗнаковВеса());
	Возврат Результат;

КонецФункции

// Длительность загрузки станка: вес материалов, кг / выработка станка, кг/ч, плюс время на смену заказа - оно
// входит в начало каждой загрузки (переналадка под заказ), поэтому соседние загрузки всегда разделены им.
//
// Параметры:
//  Станок - СправочникСсылка.ПроизводственноеОборудование - станок
//  Вес    - Число - вес материалов загрузки, кг
//  Реквизиты - Структура, СтрокаТаблицыЗначений, Неопределено - Выработка и ВремяНаСменуЗаказа станка, уже прочитанные
//              (автоплан); Неопределено - читаются из станка
//
// Возвращаемое значение:
//  Структура:
//   * Часы        - Число - длительность, ч, округлённая до сотых; 0 - посчитать нельзя
//   * ТекстОшибки - Строка - почему нельзя посчитать; пустая - посчитано
//
Функция ДлительностьЗагрузки(Станок, Вес, Реквизиты = Неопределено) Экспорт

	Результат = Новый Структура("Часы, ТекстОшибки", 0, "");
	Если Реквизиты = Неопределено Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Станок, "Выработка, ВремяНаСменуЗаказа");
	КонецЕсли;
	Если Реквизиты.Выработка = Null Или Реквизиты.Выработка <= 0 Тогда
		Шаблон = НСтр("ru = 'У станка «%1» не задана выработка, кг/ч: время загрузки не посчитать';
			|fr = 'La cadence (kg/h) de la machine « %1 » n''est pas renseignée : la durée de charge ne peut pas être calculée';
			|en = 'Machine ""%1"" has no output rate, kg/h: the load time cannot be calculated';
			|es = 'La máquina «%1» no tiene rendimiento, kg/h: no se puede calcular el tiempo de carga'");
		Результат.ТекстОшибки = СтрШаблон(Шаблон, Станок);
		Возврат Результат;
	КонецЕсли;
	Если Вес <= 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Вес материалов загрузки нулевой: время загрузки не посчитать';
			|fr = 'Le poids des matières de la charge est nul : la durée de charge ne peut pas être calculée';
			|en = 'The weight of the load materials is zero: the load time cannot be calculated';
			|es = 'El peso de los materiales de la carga es cero: no se puede calcular el tiempo de carga'");
		Возврат Результат;
	КонецЕсли;
	Результат.Часы = ОкруглитьЧасы(Вес / Реквизиты.Выработка + Реквизиты.ВремяНаСменуЗаказа / МинутВЧасе());
	Возврат Результат;

КонецФункции

// Момент, когда станок отработает заданные часы, начиная с момента начала: часы раскладываются по рабочим интервалам
// режима станка и производственного календаря (смены через полночь, выходные). Начало вне смены - отсчёт с начала
// ближайшей смены. Интервалы читаются окнами по 31 дню на горизонте 366 дней.
//
// Параметры:
//  Станок - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало - Дата - момент начала
//  Часы   - Число - рабочие часы
//
// Возвращаемое значение:
//  Дата, Неопределено - момент окончания; Неопределено - часы не уложились в горизонт (нет режима или смен)
//
Функция ОкончаниеПоРежиму(Станок, Начало, Часы) Экспорт

	Осталось = Окр(Часы * СекундВЧасе(), 0);
	Если Осталось <= 0 Тогда
		Возврат Начало;
	КонецЕсли;
	Горизонт = Начало + ДнейГоризонтаОкончания() * СекундВСутках();
	Окно = Начало;
	Пока Окно < Горизонт Цикл
		КонецОкна = Мин(Окно + ДнейОкнаОкончания() * СекундВСутках(), Горизонт);
		Для Каждого Интервал Из ИнтервалыРаботыСтанка(Станок, Окно, КонецОкна) Цикл
			Длина = Интервал.Окончание - Интервал.Начало;
			Если Длина >= Осталось Тогда
				Возврат Интервал.Начало + Осталось;
			КонецЕсли;
			Осталось = Осталось - Длина;
		КонецЦикла;
		Окно = КонецОкна;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#Область ЗакладкаСтанков

// Шаг планирования загрузки станков (решение владельца 2026-10-08): начало загрузки при поиске окна и при
// перетаскивании на планировщике округляется до него вверх.
//
// Возвращаемое значение:
//  Число - минуты
//
Функция ШагПланированияМинут() Экспорт

	Возврат 15;

КонецФункции

// Момент, округлённый вверх до шага планирования.
//
// Параметры:
//  Момент - Дата - момент
//
// Возвращаемое значение:
//  Дата - момент, кратный шагу планирования; кратный остаётся как есть
//
Функция ОкруглитьДоШага(Момент) Экспорт

	Шаг = ШагСекунд();
	Остаток = (Момент - Дата(1, 1, 1)) % Шаг;
	Возврат ?(Остаток = 0, Момент, Момент + (Шаг - Остаток));

КонецФункции

// Часы в виде «ч:мм» для подписей закладки «Станки».
//
// Параметры:
//  Часы - Число - часы
//
// Возвращаемое значение:
//  Строка - например «6:15»
//
Функция ПредставлениеЧасов(Часы) Экспорт

	Минут = Окр(Часы * МинутВЧасе(), 0);
	Возврат Формат(Цел(Минут / МинутВЧасе()), "ЧН=0; ЧГ=0") + ":" + Формат(Минут % МинутВЧасе(), "ЧЦ=2; ЧН=00; ЧВН=");

КонецФункции

// Занятость станков за период: записи «Загрузки станков» обоих слоев (план и факт, работа и обслуживание) с данными
// документа. Затянувшаяся загрузка - факт требования в статусе «Запущено», расчётное окончание которого уже прошло, -
// продлевается до момента расчёта плюс шаг: станок занят, пока загрузку не завершат.
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//  Момент    - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Начало, Окончание, Регистратор, ВидЗаписи, План, Заказ, Вес, Статус (статус
//                    требования), Продукция, Количество, Текст (подпись элемента планировщика), Затянулась (Булево),
//                    РасчетноеОкончание (окончание до продления; у незатянувшихся - равно Окончание);
//                    упорядочена по станку и началу
//
Функция ЗанятостьСтанков(Станки, Начало, Окончание, Момент = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	// Затянувшаяся загрузка закончилась по расчёту до периода, но идёт - вторая часть объединения.
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстВыборкиЗанятости() + "
	|	И Загрузка.Окончание > &Начало
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|" + ТекстВыборкиЗанятости() + "
	|	И Загрузка.Окончание <= &Начало
	|	И НЕ Загрузка.План
	|	И Требования.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Станок,
	|	Начало";
	Запрос.УстановитьПараметр("Станки", Станки);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("Текст", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Затянулась", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("РасчетноеОкончание", ОписаниеТиповДатаВремя());

	Продление = ОкруглитьДоШага(Момент + ШагСекунд());
	Запущено = Перечисления.СтатусыТребованийНакладных.Запущено;
	Удалить = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Строка.РасчетноеОкончание = Строка.Окончание;
		Если Строка.Статус = Запущено И Не Строка.План И Строка.Окончание <= Момент Тогда
			Строка.Окончание = Продление;
			Строка.Затянулась = Истина;
		КонецЕсли;
		Если Строка.Окончание <= Начало Тогда
			Удалить.Добавить(Строка);
			Продолжить;
		КонецЕсли;
		Строка.Текст = ТекстЗанятости(Строка);
	КонецЦикла;
	Для Каждого Строка Из Удалить Цикл
		Таблица.Удалить(Строка);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Ближайшее свободное окно станка для загрузки заданной длительности: начало не раньше заданного момента, округлённое
// вверх до шага и сдвинутое на начало ближайшей смены; часы раскладываются по рабочему времени тем же правилом, что
// ОкончаниеПоРежиму в проведении требования. Занятым считается всё - оба слоя, работа и обслуживание, затянувшаяся
// загрузка - по продлённому окончанию (правило сборки 1). Вызывать под блокировкой загрузки станка, если окно сразу
// занимается.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Часы      - Число - длительность загрузки, ч (см. ДлительностьЗагрузки)
//  НеРаньше  - Дата - самое раннее начало
//  Исключить - ДокументСсылка, Неопределено - регистратор, чьи записи не считаются занятостью (переносимый документ)
//  Момент    - Дата, Неопределено - момент расчёта: окно не начинается раньше него; Неопределено - текущая дата
//
// Возвращаемое значение:
//  Структура:
//   * Начало      - Дата, Неопределено - начало окна
//   * Окончание   - Дата, Неопределено - окончание окна
//   * Сдвинуто    - Булево - окно позже начала ближайшей смены от НеРаньше: то время занято
//   * ТекстОшибки - Строка - почему окна нет; пустая - найдено
//
Функция БлижайшееОкно(Станок, Часы, НеРаньше, Исключить = Неопределено, Момент = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Возврат ОкноВКонтексте(КонтекстОкна(Станок, НеРаньше, Момент), Часы, НеРаньше, Исключить);

КонецФункции

// Строки «Готовы к запуску» (решения владельца 2026-10-08): строки продукции заказов на производство в стадии
// «В производстве» и заказов ранних стадий («Заказ поставщику», «Восполнение потребности»), у которых материалов строки
// хватает на складе размещения (без резерва: кто первым запустит). Остаток строки - КВыпуску - Выпущено по ключу
// продукции за вычетом открытых требований: требования вычитаются из своей строки, остаток ключа разносится по строкам
// заказа по порядку. Продукция, переданная в переработку, не показывается. Вес - листья материалов строки на остаток,
// время - на выбранном станке.
//
// Параметры:
//  Станок - СправочникСсылка.ПроизводственноеОборудование - станок для расчёта времени; пустой - время не считается
//  Момент - Дата, Неопределено - момент расчёта ближайшего окна для признака просрочки; Неопределено - текущая дата
//  Склад  - СправочникСсылка.МестаХранения, Неопределено - склад размещения; Неопределено - склад пользователя
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Заказ, КодСтроки, НомерЗаказа, Клиент, ДатаОтгрузки, Номенклатура, Характеристика,
//                    Количество (строки заказа), Остаток, Вес (кг), Часы, ТекстОшибки, Просрочен, ИзСклада (материалы
//                    со свободного склада, а не под заказ); упорядочена по дате отгрузки (пустая - в конце), заказу и
//                    строке
//
Функция ГотовыеКЗапуску(Станок, Момент = Неопределено, Склад = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Готовые = СтрокиГотовых(Неопределено, Склад);
	РассчитатьВремяГотовых(Готовые, Станок, Момент);
	Готовые.Сортировать("БезДатыОтгрузки, ДатаОтгрузки, НомерЗаказа, КодСтроки");
	Возврат Готовые;

КонецФункции

// Состояние станков для списка закладки: что на станке сейчас и когда освободится (см. ОсвобождениеСтанков), фонд и
// загрузка периода, ближайшее плановое обслуживание. Загрузка - объединение интервалов «Работа» плана и факта
// (с затянувшимися) в рабочем времени, делённое на фонд.
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//  Момент    - Дата, Неопределено - «сейчас»; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Состояние (Строка), Требование, Фонд (ч), Работа (ч), Загрузка (%),
//                    БлижайшееОбслуживание (Дата; пустая - нет), Освободится, СвободенС, ЗагруженДо (Дата, см.
//                    ОсвобождениеСтанков)
//
Функция СостояниеСтанков(Станки, Начало, Окончание, Момент = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Состояние = НоваяТаблицаСостояния();
	Интервалы = ИнтервалыРаботыСтанков(Станки, Начало, Окончание);
	Занятость = ЗанятостьСтанков(Станки, Начало, Окончание, Момент);
	Освобождение = ОсвобождениеСтанков(Станки, Момент);
	Обслуживание = БлижайшееОбслуживание(Станки, Момент);
	Процентов = 100;
	Для Каждого Станок Из Станки Цикл
		Отбор = Новый Структура("Станок", Станок);
		ИнтервалыСтанка = Интервалы.НайтиСтроки(Отбор);
		Строка = Состояние.Добавить();
		Строка.Станок = Станок;
		Строка.Фонд = ОкруглитьЧасы(ЧасыИнтервалов(ИнтервалыСтанка));
		Строка.Работа = ОкруглитьЧасы(ЧасыРаботыВРабочееВремя(Занятость.НайтиСтроки(Отбор), ИнтервалыСтанка, Начало, Окончание));
		Строка.Загрузка = ?(Строка.Фонд = 0, 0, Окр(Строка.Работа / Строка.Фонд * Процентов, 0));
		Строка.БлижайшееОбслуживание = Обслуживание.Получить(Станок);
		ЗаполнитьЗначенияСвойств(Строка, Освобождение.Найти(Станок, "Станок"),
			"Состояние, Требование, Освободится, СвободенС, ЗагруженДо");
	КонецЦикла;
	Возврат Состояние;

КонецФункции

// Занятость станков на момент и когда они освободятся - отчёт «Занятость станков» и колонки закладки «Станки».
// Рабочие интервалы и занятость читаются один раз на горизонт поиска окна (год), «Загружен до» - отдельным запросом
// без горизонта.
//
// Параметры:
//  Станки - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Момент - Дата, Неопределено - «сейчас»; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  ТаблицаЗначений - по строке на станок в порядке массива, колонки:
//   * Станок             - СправочникСсылка.ПроизводственноеОборудование
//   * Занят              - Булево - момент накрыт записью занятости (любой слой и вид), то же правило, что у окна
//   * Занятость          - Строка - «Загружен» или «Свободен» для группировки отчёта
//   * Состояние          - Строка - что на станке сейчас, как на закладке
//   * Требование         - ДокументСсылка.ТребованиеНакладная, Неопределено - требование состояния (работа)
//   * Документ           - ДокументСсылка - регистратор записи состояния: требование или обслуживание
//   * Заказ              - ДокументСсылка.ЗаказПокупателя - заказ записи состояния
//   * Продукция          - СправочникСсылка.Номенклатура - продукция требования состояния
//   * Освободится        - Дата - позднейшее окончание записей, накрывающих момент; пустая - свободен или среди них
//                          затянувшаяся работа (окончание неизвестно до «Завершить»)
//   * Затянулась         - Булево - среди записей, накрывающих момент, есть затянувшаяся работа
//   * РасчетноеОкончание - Дата - расчётное окончание затянувшейся работы
//   * СвободенС          - Дата - начало первого свободного окна длиной в шаг планирования (правило «Разместить»),
//                          может быть разрывом внутри очереди; пустая - затянулась или окна нет за год
//   * ЗагруженДо         - Дата - конец всей очереди: позднейшее окончание записей после момента; пустая - впереди
//                          ничего нет
//   * ЧасовРаботыВпереди - Число - часы «Работы» (план и факт без двойного счёта) от момента в рабочем времени, год
//
Функция ОсвобождениеСтанков(Станки, Момент = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Освобождение = НоваяТаблицаОсвобождения();
	Горизонт = ОкруглитьДоШага(Момент) + ДнейГоризонтаОкончания() * СекундВСутках();
	Интервалы = ИнтервалыРаботыСтанков(Станки, Момент, Горизонт);
	Занятость = ЗанятостьСтанков(Станки, Момент, Горизонт, Момент);
	КонцыОчереди = КонцыОчередиСтанков(Станки, Момент);
	ЧасовШага = ШагПланированияМинут() / МинутВЧасе();
	Для Каждого Станок Из Станки Цикл
		Отбор = Новый Структура("Станок", Станок);
		ИнтервалыСтанка = Интервалы.НайтиСтроки(Отбор);
		ЗаписиСтанка = Занятость.НайтиСтроки(Отбор);
		Строка = Освобождение.Добавить();
		Строка.Станок = Станок;
		Строка.ЗагруженДо = КонцыОчереди.Получить(Станок);
		Строка.ЧасовРаботыВпереди = ОкруглитьЧасы(ЧасыРаботыВРабочееВремя(ЗаписиСтанка, ИнтервалыСтанка, Момент, Горизонт));
		ЗаполнитьОсвобождениеСейчас(Строка, ЗаписиСтанка, ИнтервалыСтанка, Момент);
		Если Строка.Затянулась Тогда
			Продолжить;
		КонецЕсли;
		Контекст = Новый Структура("Станок, Момент, Горизонт", Станок, Момент, Горизонт);
		Контекст.Вставить("Интервалы", ИнтервалыСтанка);
		Контекст.Вставить("Занятость", ЗаписиСтанка);
		Окно = ОкноВКонтексте(Контекст, ЧасовШага, Момент, Неопределено);
		Если Окно.Начало <> Неопределено Тогда
			Строка.СвободенС = Окно.Начало;
		КонецЕсли;
	КонецЦикла;
	Возврат Освобождение;

КонецФункции

// Станки отчёта «Занятость станков»: действующие (не выведенные, без пометки удаления) и станки с занятостью после
// момента - записью «Загрузки станков», кончающейся позже, или запущенным требованием (затянувшаяся работа), - без
// горизонта.
//
// Параметры:
//  Момент - Дата - момент отчёта
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ПроизводственноеОборудование - станки по наименованию
//
Функция СтанкиЗанятости(Момент) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Станки.Ссылка КАК Станок
	|ПОМЕСТИТЬ ВтСтанки
	|ИЗ
	|	Справочник.ПроизводственноеОборудование КАК Станки
	|ГДЕ
	|	НЕ Станки.ПометкаУдаления
	|	И НЕ Станки.Выведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Загрузка.Станок
	|ИЗ
	|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|ГДЕ
	|	Загрузка.Окончание > &Момент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Требования.Станок
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Проведен
	|	И Требования.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено)
	|	И Требования.ФактНачало <= &Момент
	|	И Требования.Станок <> ЗНАЧЕНИЕ(Справочник.ПроизводственноеОборудование.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтСтанки.Станок КАК Станок
	|ИЗ
	|	ВтСтанки КАК ВтСтанки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПроизводственноеОборудование КАК Станки
	|		ПО ВтСтанки.Станок = Станки.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтСтанки.Станок,
	|	Станки.Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	Станки.Наименование";
	Запрос.УстановитьПараметр("Момент", Момент);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Станок");

КонецФункции

// «Разместить» с закладки «Станки»: новое требование-накладная по строке заказа на станок в ближайшее свободное окно
// или во время перетаскивания. Под блокировками проведения требования строка перепроверяется по «Готовым к запуску»
// (стадия, материалы, остаток строки) и ищется окно. Разбиение - количество меньше
// остатка строки: остаток размещается следующим вызовом.
//
// Параметры:
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  КодСтроки  - Число - КодСтроки строки продукции заказа
//  Количество - Число - количество продукции
//  Станок     - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало     - Дата, Неопределено - время перетаскивания; Неопределено - ближайшее окно
//  Момент     - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//  Склад      - СправочникСсылка.МестаХранения, Неопределено - склад-источник материалов; Неопределено - склад
//               пользователя
//
// Возвращаемое значение:
//  Структура:
//   * Требование  - ДокументСсылка.ТребованиеНакладная, Неопределено - размещённое требование
//   * ТекстОшибки - Строка - почему не размещено; пустая - размещено
//
Функция РазместитьСтроку(Заказ, КодСтроки, Количество, Станок, Начало = Неопределено, Момент = Неопределено,
	Склад = Неопределено) Экспорт

	Результат = Новый Структура("Требование, ТекстОшибки", Неопределено, "");
	Момент = МоментРасчета(Момент);
	Склад = ?(Склад = Неопределено, СкладРазмещения(), Склад);
	Результат.ТекстОшибки = ТекстЗапретаРазмещения(Количество, Начало, Момент);
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		Возврат Результат;
	КонецЕсли;
	Объект = Документы.ТребованиеНакладная.СоздатьДокумент();
	ДанныеЗаполнения = Новый Структура("Станок, Заказ", Станок, Заказ);
	ДанныеЗаполнения.Вставить("КодСтрокиПродукции", КодСтроки);
	ДанныеЗаполнения.Вставить("Количество", Количество);
	Объект.Заполнить(ДанныеЗаполнения);
	Объект.МестоХранения = Склад;
	Длительность = ДлительностьМатериалов(Станок, Объект.Материалы);
	Если ЗначениеЗаполнено(Длительность.ТекстОшибки) Тогда
		Результат.ТекстОшибки = Длительность.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	ПолучитьСообщенияПользователю(Истина);
	ТекстОшибки = "";
	НачатьТранзакцию();
	Попытка
		// Блокировки проведения требования в его порядке (загрузка станка - первой, потребности заказа - после
		// складских): остаток строки и окно перечитываются уже под ними, два размещения одной строки сериализуются.
		Блокировка = Новый БлокировкаДанных;
		ТребованияНакладные.ЗаполнитьБлокировкуПроведения(Объект, Блокировка);
		Блокировка.Заблокировать();
		ТекстОшибки = ТекстОстаткаСтроки(Заказ, КодСтроки, Количество, Склад);
		Если ПустаяСтрока(ТекстОшибки) Тогда
			Окно = БлижайшееОкно(Станок, Длительность.Часы, ?(Начало = Неопределено, Момент, Начало), , Момент);
			ТекстОшибки = ТекстОкна(Окно, Начало <> Неопределено);
		КонецЕсли;
		Если ПустаяСтрока(ТекстОшибки) Тогда
			Объект.ПланНачало = Окно.Начало;
			ТребованияНакладные.ВыполнитьДействие(Объект, "Разместить");
		КонецЕсли;
		// Без записи фиксируется пустая транзакция: откат вложенной сломал бы внешнюю (тест в транзакции).
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.ТекстОшибки = ТекстОшибкиЗаписи(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Результат.ТекстОшибки = ТекстОшибки;
	Иначе
		Результат.Требование = Объект.Ссылка;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Перенос загрузки перетаскиванием на планировщике: запланированное требование получает новый станок и начало
// (сдвинутое на начало смены и округлённое до шага) и перепроводится; документ обслуживания - новое время той же
// длительности. Под блокировкой загрузки станка план сверяется с фактической работой и обслуживанием станка: проведение
// план с фактом не сверяет (правило сборки 1), а ручной перенос на занятое время - ошибка. Пересечение плана с планом
// отклоняет само проведение.
//
// Параметры:
//  Регистратор - ДокументСсылка.ТребованиеНакладная, ДокументСсылка.ОбслуживаниеСтанка - документ элемента
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок строки, куда перетащили; пустой - прежний
//  Начало      - Дата - новое начало
//  Момент      - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//  Часы        - Число, Неопределено - новая длительность (растяжение): требованию - ручная длительность, ч;
//                Неопределено - длительность прежняя (перенос)
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - перенесено
//
Функция ПеренестиЗагрузку(Регистратор, Станок, Начало, Момент = Неопределено, Часы = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОбслуживаниеСтанка") Тогда
		Возврат ПеренестиОбслуживание(Регистратор, Станок, Начало, Момент, Часы);
	КонецЕсли;
	Если ТипЗнч(Регистратор) <> Тип("ДокументСсылка.ТребованиеНакладная") Тогда
		Возврат НСтр("ru = 'Этот элемент не переносится'; fr = 'Cet élément ne se déplace pas';
			|en = 'This item cannot be moved'; es = 'Este elemento no se puede mover'");
	КонецЕсли;
	Объект = Регистратор.ПолучитьОбъект();
	Если Объект.Статус <> Перечисления.СтатусыТребованийНакладных.Запланировано Тогда
		Возврат НСтр("ru = 'Переносится только запланированная загрузка: запущенную и завершённую правят в документе';
			|fr = 'Seule une charge planifiée se déplace : une charge lancée ou terminée se corrige dans le document';
			|en = 'Only a planned load can be moved: a started or completed load is edited in the document';
			|es = 'Solo se mueve una carga planificada: la iniciada o terminada se corrige en el documento'");
	КонецЕсли;
	ТекстОшибки = ТекстЗапретаПрошлого(Начало, Момент);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	СменаСтанка = ЗначениеЗаполнено(Станок) И Станок <> Объект.Станок;
	Если Часы <> Неопределено Тогда
		Объект.ДлительностьВручную = Часы;
	Иначе
		// На другом станке другие выработка и переналадка: ручная длительность сбрасывается (ревью плана P3-15).
		Объект.ДлительностьВручную = ?(СменаСтанка, 0, Объект.ДлительностьВручную);
	КонецЕсли;
	Если ЗначениеЗаполнено(Станок) Тогда
		Объект.Станок = Станок;
	КонецЕсли;
	Длительность = ДлительностьТребования(Объект);
	Если ЗначениеЗаполнено(Длительность.ТекстОшибки) Тогда
		Возврат Длительность.ТекстОшибки;
	КонецЕсли;

	ПолучитьСообщенияПользователю(Истина);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		УправляемыеБлокировки.ЗагрузкаСтанков(Блокировка, Объект.Станок);
		Блокировка.Заблокировать();
		ТекстОшибки = ТекстЗанятостиПереноса(Объект, Начало, Длительность.Часы, Момент);
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТребованияНакладные.ВыполнитьДействие(Объект, "Разместить");
		КонецЕсли;
		// Без записи фиксируется пустая транзакция: откат вложенной сломал бы внешнюю (тест в транзакции).
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ТекстОшибкиЗаписи(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат ТекстОшибки;

КонецФункции

// Перетаскивание или растяжение элемента планировщика (волна 5): длина элемента не изменилась - перенос
// (ПеренестиЗагрузку), изменилась - растяжение. Растяжение меняет только время (ответ владельца 7): требованию -
// ручная длительность = рабочие часы станка между новым началом и окончанием (оба - вверх до шага), обслуживанию -
// новая длительность. Дальше - тот же путь, что перенос: смена, шаг, сверка с фактом под блокировкой, проведение.
//
// Параметры:
//  Регистратор - ДокументСсылка.ТребованиеНакладная, ДокументСсылка.ОбслуживаниеСтанка - документ элемента
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок строки планировщика; пустой - прежний
//  Начало      - Дата - новое начало элемента
//  Окончание   - Дата - новое окончание элемента
//  Момент      - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - записано
//
Функция ИзменитьЗагрузку(Регистратор, Станок, Начало, Окончание, Момент = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Длина = ДлинаЭлементаЗагрузки(Регистратор);
	Если Длина = Неопределено Или Окончание - Начало = Длина Тогда
		Возврат ПеренестиЗагрузку(Регистратор, Станок, Начало, Момент);
	КонецЕсли;
	СтанокЭлемента = ?(ЗначениеЗаполнено(Станок), Станок, Регистратор.Станок);
	НовоеНачало = ОкруглитьДоШага(Макс(Начало, Момент));
	НовоеОкончание = ОкруглитьДоШага(Окончание);
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОбслуживаниеСтанка") Тогда
		Часы = (НовоеОкончание - НовоеНачало) / СекундВЧасе();
	Иначе
		Интервалы = ИнтервалыРаботыСтанка(СтанокЭлемента, НовоеНачало, НовоеОкончание);
		Часы = ОкруглитьЧасы(ЧасыВРабочееВремя(Интервалы, НовоеНачало, НовоеОкончание));
	КонецЕсли;
	Если Часы <= 0 Тогда
		Возврат НСтр("ru = 'В выбранном отрезке нет рабочего времени станка: загрузку нельзя сжать до нуля';
			|fr = 'Aucun temps de travail de la machine sur ce créneau : la charge ne peut pas être réduite à zéro';
			|en = 'There is no machine working time in this span: the load cannot be shrunk to zero';
			|es = 'No hay tiempo de trabajo de la máquina en ese tramo: la carga no se puede reducir a cero'");
	КонецЕсли;
	Возврат ПеренестиЗагрузку(Регистратор, Станок, НовоеНачало, Момент, Часы);

КонецФункции

// «Запустить», «Завершить» или «Отменить» требование с закладки «Станки». «Завершить» выпускает заданное количество
// (больше нуля), материалы расходуются как загружены (правка расхода - в форме требования).
//
// Параметры:
//  Требование     - ДокументСсылка.ТребованиеНакладная - требование
//  Действие       - Строка - «Запустить», «Завершить» или «Отменить»
//  КоличествоФакт - Число - выпущено при «Завершить»; для прочих действий не читается
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - выполнено
//
Функция ВыполнитьДействиеТребования(Требование, Действие, КоличествоФакт = 0) Экспорт

	Если Действие <> "Запустить" И Действие <> "Завершить" И Действие <> "Отменить" Тогда
		ВызватьИсключение СтрШаблон("Неизвестное действие закладки «Станки»: %1", Действие);
	КонецЕсли;
	Объект = Требование.ПолучитьОбъект();
	Если Действие = "Завершить" Тогда
		// Ноль ПодготовитьЗавершение заменил бы полным количеством требования: выпуск задаётся явно.
		Если КоличествоФакт <= 0 Тогда
			Возврат НСтр("ru = 'Укажите выпущенное количество больше нуля';
				|fr = 'Indiquez une quantité produite supérieure à zéro';
				|en = 'Specify a produced quantity greater than zero';
				|es = 'Indique una cantidad producida mayor que cero'");
		КонецЕсли;
		Объект.КоличествоФакт = КоличествоФакт;
	КонецЕсли;
	Возврат ЗаписатьДействие(Объект, Действие);

КонецФункции

// Черновик автоплана (волна 5, ответы владельца 2026-10-08): строки «Готовых к запуску» по дате отгрузки (пустая - в
// конце), каждая целиком на станок, который закончит её раньше всех. Станки строки - список допустимых станков
// продукции среди действующих; пустой список - любой действующий станок. Уже запланированное не трогается: окна ищутся
// мимо всей занятости станков и мимо предложенных раньше строк черновика. В базу ничего не пишется.
//
// Параметры:
//  Момент - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//  Склад  - СправочникСсылка.МестаХранения, Неопределено - склад размещения; Неопределено - склад пользователя
//  Заказы - Массив из ДокументСсылка.ЗаказПокупателя, Неопределено - только строки этих заказов; Неопределено - все
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Заказ, КодСтроки, НомерЗаказа, Клиент, ДатаОтгрузки, Номенклатура, Характеристика,
//                    Количество, Вес (кг), Станок, Начало, Окончание, Часы, Просрочен, ТекстОшибки (пустая - строка
//                    размещается), Момент (момент расчёта черновика); порядок - очередь размещения
//
Функция ПредложениеАвтоплана(Момент = Неопределено, Склад = Неопределено, Заказы = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Склад = ?(Склад = Неопределено, СкладРазмещения(), Склад);
	Предложение = НоваяТаблицаАвтоплана();
	Готовые = СтрокиГотовых(Неопределено, Склад);
	Если Заказы <> Неопределено Тогда
		Чужие = Новый Массив;
		Для Каждого Готовая Из Готовые Цикл
			Если Заказы.Найти(Готовая.Заказ) = Неопределено Тогда
				Чужие.Добавить(Готовая);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Готовая Из Чужие Цикл
			Готовые.Удалить(Готовая);
		КонецЦикла;
	КонецЕсли;
	Готовые.Сортировать("БезДатыОтгрузки, ДатаОтгрузки, НомерЗаказа, КодСтроки");
	Если Готовые.Количество() = 0 Тогда
		Возврат Предложение;
	КонецЕсли;
	Данные = Новый Структура;
	Данные.Вставить("Станки", СтанкиАвтоплана());
	Данные.Вставить("Допустимые", ДопустимыеСтанкиПродукции(Готовые.ВыгрузитьКолонку("Номенклатура")));
	Данные.Вставить("Контексты", Новый Соответствие);
	Данные.Вставить("Момент", Момент);
	Для Каждого Готовая Из Готовые Цикл
		Строка = Предложение.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Готовая, "Заказ, КодСтроки, НомерЗаказа, Клиент, ДатаОтгрузки, Номенклатура,
			|Характеристика");
		Строка.Количество = Готовая.Остаток;
		Строка.Момент = Момент;
		ПредложитьСтроку(Строка, Данные);
	КонецЦикла;
	Возврат Предложение;

КонецФункции

// «Принять автоплан»: строки черновика без ошибки размещаются по очереди на свой станок в своё начало - каждая
// своей транзакцией под блокировками ручного размещения (РазместитьСтроку: остаток строки и окно перепроверяются).
// Отказ строки не отменяет остальные. Черновик старше шага планирования не принимается: время могли занять (ревью
// плана P2-6) - его нужно пересчитать.
//
// Параметры:
//  Строки - ТаблицаЗначений, Массив из Структура - строки черновика, см. ПредложениеАвтоплана
//  Момент - Дата, Неопределено - текущий момент; Неопределено - текущая дата сеанса
//  Склад  - СправочникСсылка.МестаХранения, Неопределено - склад-источник материалов; Неопределено - склад пользователя
//
// Возвращаемое значение:
//  Структура:
//   * Размещено - Число - сколько требований создано
//   * Ошибки    - Массив из Строка - «<заказ> / <продукция>: <причина>» по неразмещённым строкам
//
Функция ПринятьАвтоплан(Строки, Момент = Неопределено, Склад = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Результат = Новый Структура("Размещено, Ошибки", 0, Новый Массив);
	Для Каждого Строка Из Строки Цикл
		Если ЗначениеЗаполнено(Строка.ТекстОшибки) Тогда
			Продолжить;
		КонецЕсли;
		// Устарел - если шаг планирования сменился или начало строки уже прошло: окно от нового момента ляжет позже
		// черновика и сдвинет строки станка (ревью кода волны 5, P1-1).
		Если ОкруглитьДоШага(Момент) > ОкруглитьДоШага(Строка.Момент) Или Строка.Начало < Момент Тогда
			ТекстОшибки = НСтр("ru = 'Черновик автоплана устарел: рассчитайте его заново';
				|fr = 'Le brouillon de planification automatique est périmé : recalculez-le';
				|en = 'The auto-plan draft is out of date: recalculate it';
				|es = 'El borrador de planificación automática está desactualizado: vuelva a calcularlo'");
			Результат.Ошибки.Добавить(ТекстОшибки);
			Возврат Результат;
		КонецЕсли;
		Размещение = РазместитьСтроку(Строка.Заказ, Строка.КодСтроки, Строка.Количество, Строка.Станок, Строка.Начало,
			Момент, Склад);
		Если ЗначениеЗаполнено(Размещение.ТекстОшибки) Тогда
			ТекстОшибки = СтрШаблон("%1 / %2: %3", Строка.НомерЗаказа, Строка.Номенклатура, Размещение.ТекстОшибки);
			Результат.Ошибки.Добавить(ТекстОшибки);
		Иначе
			Результат.Размещено = Результат.Размещено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Склад станка (место хранения материалов, загруженных на станок).
//
// Параметры:
//  Станок - СправочникСсылка.ПроизводственноеОборудование - станок
//
// Возвращаемое значение:
//  СправочникСсылка.МестаХранения - склад станка; пустая ссылка - не задан
//
Функция СкладСтанка(Станок) Экспорт

	Склад = ?(ЗначениеЗаполнено(Станок), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Станок, "СкладСтанка"), Неопределено);
	Возврат ?(ЗначениеЗаполнено(Склад), Склад, Справочники.МестаХранения.ПустаяСсылка());

КонецФункции

// Складской документ «По станку» (пересчёт, списание, оприходование; волна 5): место хранения - склад станка; станок
// обязателен и должен иметь склад. У документа «По складу» (и у старых, с пустым видом операции) станок очищается.
// Вызывается из ПередЗаписью документа.
//
// Параметры:
//  Объект - ДокументОбъект.ПересчётТоваров, ДокументОбъект.СписаниеТоваров, ДокументОбъект.ОприходованиеТоваров -
//           документ
//  Отказ  - Булево - отказ записи
//
Процедура ЗаполнитьСкладСтанкаДокумента(Объект, Отказ) Экспорт

	// Учёт станков выключен - документ не трогается: поля станка скрыты, исправить их пользователю нечем (ревью данных
	// волны 5, P2-2).
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтанков") Тогда
		Возврат;
	КонецЕсли;
	Если Объект.ВидОперации <> Перечисления.ВидыСкладскихОпераций.Станок Тогда
		Объект.Станок = Справочники.ПроизводственноеОборудование.ПустаяСсылка();
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Станок) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Укажите станок'; fr = 'Indiquez la machine';
			|en = 'Specify the machine'; es = 'Indique la máquina'"), Объект, "Станок", , Отказ);
		Возврат;
	КонецЕсли;
	// Записанный документ сохраняет свой склад, пока не сменили станок или вид: смена склада в карточке станка не
	// переносит задним числом движения уже проведённых документов (ревью данных волны 5, P2-1).
	Если Не Объект.ЭтоНовый() И ЗначениеЗаполнено(Объект.МестоХранения) Тогда
		Сохраненные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, "ВидОперации, Станок");
		Если Сохраненные.ВидОперации = Объект.ВидОперации И Сохраненные.Станок = Объект.Станок Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Склад = СкладСтанка(Объект.Станок);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Шаблон = НСтр("ru = 'У станка «%1» не задан склад станка: заполните его в карточке станка';
			|fr = 'La machine « %1 » n''a pas de stock machine : renseignez-le dans sa fiche';
			|en = 'Machine ""%1"" has no machine stock: fill it in on the machine card';
			|es = 'La máquina «%1» no tiene almacén de máquina: rellénelo en su ficha'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Объект.Станок), Объект, "Станок", , Отказ);
		Возврат;
	КонецЕсли;
	Объект.МестоХранения = Склад;

КонецПроцедуры

// Проверка заполнения складского документа «По станку»: вместо места хранения проверяется станок (место хранения
// заполнит ПередЗаписью складом станка).
//
// Параметры:
//  Объект               - ДокументОбъект - пересчёт, списание или оприходование
//  ПроверяемыеРеквизиты - Массив из Строка - реквизиты проверки заполнения
//
Процедура ПроверяемыеРеквизитыСкладаСтанка(Объект, ПроверяемыеРеквизиты) Экспорт

	Если Объект.ВидОперации <> Перечисления.ВидыСкладскихОпераций.Станок
		Или Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтанков") Тогда
		Возврат;
	КонецЕсли;
	Индекс = ПроверяемыеРеквизиты.Найти("МестоХранения");
	Если Индекс <> Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(Индекс);
	КонецЕсли;
	ПроверяемыеРеквизиты.Добавить("Станок");

КонецПроцедуры

#КонецОбласти

#Область Отчеты

// Категории времени станков за период - одна функция для отчётов учёта станков (правила сборки 4, ревью Codex общего
// плана). Категории не пересекаются: работа - факт требований в рабочем времени за вычетом объединения фактических
// обслуживаний; обслуживание - фактическое в рабочем времени; «нет заказа» - остаток фонда. Плановые остановки
// (доступность OEE, волна 5) - плановое время обслуживания в рабочем времени до момента расчёта без часов, когда
// станок работал: отдельный слой строки фонда, в сумму категорий не входит. Факт завершённого
// требования - запись «Загрузки станков», запущенного - от начала факта до момента расчёта (запись регистра до
// «Завершить» расчётная) и не дальше начала следующей фактической работы станка. Факт (фонд, работа, обслуживание,
// «нет заказа») считается только до момента расчёта: будущая часть периода не простой. План - плановые даты
// проведённых неотменённых требований в рабочем времени за весь период, отдельный слой: в сумму категорий не входит.
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//  Момент    - Дата, Неопределено - момент расчёта для запущенных требований; Неопределено - текущая дата сеанса
//  ПоРежиму  - Булево - Истина: рабочее время - смены режима станка (отчёт загрузки); Ложь - всё время периода (часы
//              денег и выработки - решение владельца 2026-10-08: сверхурочная работа тоже стоит денег)
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Документ (требование, обслуживание; Неопределено - строка фонда станка),
//                    ВидОбслуживания, Фонд, Работа, Обслуживание, НетЗаказа, План, ПлановыеОстановки (часы, округлены
//                    до сотых); на станок одна строка фонда (Фонд, НетЗаказа, ПлановыеОстановки), на документ - одна
//                    строка
//
Функция КатегорииВремени(Станки, Начало, Окончание, Момент = Неопределено, ПоРежиму = Истина) Экспорт

	Момент = МоментРасчета(Момент);
	Категории = НоваяТаблицаКатегорий();
	Если Окончание <= Начало Или Станки.Количество() = 0 Тогда
		Возврат Категории;
	КонецЕсли;
	Если ПоРежиму Тогда
		Интервалы = ИнтервалыРаботыСтанков(Станки, Начало, Окончание);
	Иначе
		Интервалы = ИнтервалыВсегоПериода(Станки, Начало, Окончание);
	КонецЕсли;
	Записи = ФактическиеЗаписиПериода(Станки, Начало, Окончание, Момент);
	Планы = ПланыТребованийПериода(Станки, Начало, Окончание);
	Факт = Новый Структура("Начало, Окончание", Начало, Мин(Окончание, Момент));
	Остановки = ПлановыеОстановкиПериода(Станки, Факт.Начало, Факт.Окончание);
	Для Каждого Станок Из Станки Цикл
		Отбор = Новый Структура("Станок", Станок);
		ДанныеСтанка = Новый Структура("Записи, Планы, Остановки", Записи.НайтиСтроки(Отбор), Планы.НайтиСтроки(Отбор),
			Остановки.НайтиСтроки(Отбор));
		ДобавитьКатегорииСтанка(Категории, Станок, Интервалы.НайтиСтроки(Отбор), ДанныеСтанка,
			Новый Структура("Начало, Окончание", Начало, Окончание), Факт);
	КонецЦикла;
	Возврат Категории;

КонецФункции

// Часы работы требований по правилу КатегорииВремени за весь их факт, без ограничения сменами режима - для денег и
// выработки по завершённым требованиям: период отчёта факт не режет.
//
// Параметры:
//  Требования - ТаблицаЗначений - колонки Требование, Станок, ФактНачало, ФактОкончание
//  Момент     - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  Соответствие - ключ: ДокументСсылка.ТребованиеНакладная; значение: Число - часы работы
//
Функция ЧасыРаботыТребований(Требования, Момент = Неопределено) Экспорт

	Результат = Новый Соответствие;
	Если Требования.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Начало = Неопределено;
	Окончание = Неопределено;
	Станки = Новый Массив;
	Для Каждого Строка Из Требования Цикл
		Начало = ?(Начало = Неопределено, Строка.ФактНачало, Мин(Начало, Строка.ФактНачало));
		Окончание = ?(Окончание = Неопределено, Строка.ФактОкончание, Макс(Окончание, Строка.ФактОкончание));
		Если Станки.Найти(Строка.Станок) = Неопределено Тогда
			Станки.Добавить(Строка.Станок);
		КонецЕсли;
	КонецЦикла;
	Категории = КатегорииВремени(Станки, Начало, Окончание, Момент, Ложь);
	Для Каждого Строка Из Категории Цикл
		Если ТипЗнч(Строка.Документ) = Тип("ДокументСсылка.ТребованиеНакладная") Тогда
			Результат.Вставить(Строка.Документ, Строка.Работа);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Станки отчётов учёта станков: действующие и выведенные или помеченные, у которых в периоде есть записи «Загрузки
// станков», план требований или плановые даты обслуживания, или затянувшаяся запущенная загрузка (ревью Codex сборки 4).
//
// Параметры:
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ПроизводственноеОборудование - действующие по наименованию, затем прочие с записями
//
Функция СтанкиОтчетов(Начало, Окончание) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Станки.Ссылка КАК Станок
	|ИЗ
	|	Справочник.ПроизводственноеОборудование КАК Станки
	|ГДЕ
	|	НЕ Станки.ПометкаУдаления
	|	И НЕ Станки.Выведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Станки.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Загрузка.Станок КАК Станок
	|ИЗ
	|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|ГДЕ
	|	Загрузка.Начало < &Окончание
	|	И Загрузка.Окончание > &Начало
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Требования.Станок
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Проведен
	|	И Требования.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено)
	|	И Требования.ФактНачало < &Окончание
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Требования.Станок
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Проведен
	|	И Требования.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Отменено)
	|	И Требования.ПланНачало < &Окончание
	|	И Требования.ПланОкончание > &Начало
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Обслуживание.Станок
	|ИЗ
	|	Документ.ОбслуживаниеСтанка КАК Обслуживание
	|ГДЕ
	|	Обслуживание.Проведен
	|	И Обслуживание.ПланНачало < &Окончание
	|	И Обслуживание.ПланОкончание > &Начало";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Пакет = Запрос.ВыполнитьПакет();
	Станки = Пакет[0].Выгрузить().ВыгрузитьКолонку("Станок");
	Для Каждого Станок Из Пакет[1].Выгрузить().ВыгрузитьКолонку("Станок") Цикл
		Если Станки.Найти(Станок) = Неопределено Тогда
			Станки.Добавить(Станок);
		КонецЕсли;
	КонецЦикла;
	Возврат Станки;

КонецФункции

// Границы периода отчёта учёта станков: пустое окончание - конец месяца начала (или текущего), пустое начало - начало
// месяца окончания, чтобы фонд не обходил дни с 0001 года. Окончание - полуоткрытое: последняя секунда периода входит.
//
// Параметры:
//  Период - СтандартныйПериод - период отчёта
//
// Возвращаемое значение:
//  Структура:
//   * Начало    - Дата - начало, включается
//   * Окончание - Дата - конец, не включается
//
Функция ГраницыПериодаОтчета(Период) Экспорт

	Начало = Период.ДатаНачала;
	Окончание = Период.ДатаОкончания;
	Если Не ЗначениеЗаполнено(Окончание) Тогда
		Окончание = КонецМесяца(?(ЗначениеЗаполнено(Начало), Начало, ТекущаяДатаСеанса()));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Начало) Тогда
		Начало = НачалоМесяца(Окончание);
	КонецЕсли;
	Возврат Новый Структура("Начало, Окончание", Начало, Окончание + 1);

КонецФункции

// Значение параметра данных настроек отчёта учёта станков.
//
// Параметры:
//  Настройки   - НастройкиКомпоновкиДанных - настройки отчёта
//  Имя         - Строка - имя параметра
//  ПоУмолчанию - Произвольный - значение, если параметр не задан, не используется или пуст
//
// Возвращаемое значение:
//  Произвольный - значение параметра
//
Функция ЗначениеПараметраОтчета(Настройки, Имя, ПоУмолчанию) Экспорт

	Значение = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(Имя));
	Если Значение = Неопределено Или Не Значение.Использование Или Не ЗначениеЗаполнено(Значение.Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Значение.Значение;

КонецФункции

// Вывод отчёта учёта станков с внешним набором данных в табличный документ (ПриКомпоновкеРезультата).
//
// Параметры:
//  ДокументРезультат - ТабличныйДокумент - результат отчёта
//  Схема             - СхемаКомпоновкиДанных - схема отчёта
//  Настройки         - НастройкиКомпоновкиДанных - настройки отчёта
//  ВнешниеНаборы     - Структура - ключ: имя набора схемы; значение: ТаблицаЗначений
//  Предупреждение    - Строка - сообщение пользователю под отчётом; пустая - без сообщения
//
Процедура ВывестиОтчет(ДокументРезультат, Схема, Настройки, ВнешниеНаборы, Предупреждение = "") Экспорт

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	// Без расшифровки: повторная компоновка формы отчёта не получила бы внешний набор.
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки);
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы);
	ДокументРезультат.Очистить();
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	Если ЗначениеЗаполнено(Предупреждение) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Предупреждение);
	КонецЕсли;

КонецПроцедуры

// Требования, завершённые в периоде (факт окончания в периоде), - строки отчётов «Деньги по станкам» и «Выработка
// станков». Выручка - выпущено × цена строки заказа без НДС после скидки × курс заказа (решения владельца 5 и
// 2026-10-08); себестоимость материалов - приход продукции выпуска по требованию без НДС; кг - израсходованные
// материалы; часы - работа по правилу КатегорииВремени за весь факт требования.
//
// Параметры:
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//  Момент    - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  Структура:
//   * Требования     - ТаблицаЗначений - колонки Требование, Станок, Заказ, Продукция, Характеристика, Оператор
//                      (требования, пустой - станка), Выпущено, Выручка, Материалы, Часы, СтоимостьЧасов, Кг, НормаЧасов,
//                      ЕстьМатериалыБезВеса (кг посчитаны не по всем материалам)
//   * Предупреждение     - Строка - позиции без веса и требования без строки заказа; пустая - всё посчитано
//   * ПредупреждениеВеса - Строка - только позиции без веса (отчёт без выручки)
//
Функция ЗавершенныеТребования(Начало, Окончание, Момент = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Требования.Ссылка КАК Требование,
	|	Требования.Станок КАК Станок,
	|	Требования.Заказ КАК Заказ,
	|	Требования.КодСтрокиПродукции КАК КодСтрокиПродукции,
	|	Требования.Номенклатура КАК Продукция,
	|	Требования.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА Требования.Оператор = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|			ТОГДА Станки.Оператор
	|		ИНАЧЕ Требования.Оператор
	|	КОНЕЦ КАК Оператор,
	|	Требования.КоличествоФакт КАК Выпущено,
	|	Требования.ФактНачало КАК ФактНачало,
	|	Требования.ФактОкончание КАК ФактОкончание,
	|	Станки.Выработка КАК ВыработкаСтанка,
	|	Станки.ВремяНаСменуЗаказа КАК ВремяНаСменуЗаказа,
	|	Станки.СтоимостьЧаса КАК СтоимостьЧаса
	|ПОМЕСТИТЬ ВТТребования
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПроизводственноеОборудование КАК Станки
	|		ПО Требования.Станок = Станки.Ссылка
	|ГДЕ
	|	Требования.Проведен
	|	И Требования.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Завершено)
	|	И Требования.ФактОкончание >= &Начало
	|	И Требования.ФактОкончание < &Окончание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Выпуски.Требование КАК Требование,
	|	СУММА(Движения.Сумма - Движения.СуммаНДС) КАК Материалы
	|ПОМЕСТИТЬ ВТСебестоимость
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТребования КАК ВТТребования
	|		ПО Выпуски.Требование = ВТТребования.Требование
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВНаличии КАК Движения
	|		ПО (Движения.Регистратор = Выпуски.Ссылка)
	|			И (Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
	|ГДЕ
	|	Выпуски.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	Выпуски.Требование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТребования.Требование КАК Требование,
	|	ВТТребования.Станок КАК Станок,
	|	ВТТребования.Заказ КАК Заказ,
	|	ВТТребования.КодСтрокиПродукции КАК КодСтрокиПродукции,
	|	ВТТребования.Продукция КАК Продукция,
	|	ВТТребования.Характеристика КАК Характеристика,
	|	ВТТребования.Оператор КАК Оператор,
	|	ВТТребования.Выпущено КАК Выпущено,
	|	ВТТребования.ФактНачало КАК ФактНачало,
	|	ВТТребования.ФактОкончание КАК ФактОкончание,
	|	ВТТребования.ВыработкаСтанка КАК ВыработкаСтанка,
	|	ВТТребования.ВремяНаСменуЗаказа КАК ВремяНаСменуЗаказа,
	|	ВТТребования.СтоимостьЧаса КАК СтоимостьЧаса,
	|	ЕСТЬNULL(ВТСебестоимость.Материалы, 0) КАК Материалы
	|ИЗ
	|	ВТТребования КАК ВТТребования
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСебестоимость КАК ВТСебестоимость
	|		ПО ВТТребования.Требование = ВТСебестоимость.Требование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.Ссылка КАК Требование,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	СУММА(Материалы.Израсходовано) КАК Количество
	|ИЗ
	|	Документ.ТребованиеНакладная.Материалы КАК Материалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТребования КАК ВТТребования
	|		ПО Материалы.Ссылка = ВТТребования.Требование
	|
	|СГРУППИРОВАТЬ ПО
	|	Материалы.Ссылка,
	|	Материалы.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Ссылка КАК Заказ,
	|	Строки.КодСтроки КАК КодСтроки,
	|	Строки.Номенклатура КАК Продукция,
	|	Строки.Характеристика КАК Характеристика,
	|	Строки.Количество КАК Количество,
	|	Строки.СуммаСНДС - Строки.СуммаНДС КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА Заказы.ВВалюте
	|				И Заказы.КурсВалюты > 0
	|			ТОГДА Заказы.КурсВалюты
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Курс
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Строки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
	|		ПО Строки.Ссылка = Заказы.Ссылка
	|ГДЕ
	|	Строки.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ВТТребования.Заказ КАК Заказ
	|			ИЗ
	|				ВТТребования КАК ВТТребования)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строки.НомерСтроки";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Пакет = Запрос.ВыполнитьПакет();
	Требования = Пакет[ИндексЗавершенныхТребований()].Выгрузить();
	Материалы = Пакет[ИндексМатериаловЗавершенных()].Выгрузить();
	СтрокиЗаказов = Пакет[ИндексСтрокЗаказовЗавершенных()].Выгрузить();

	ТипЧисла = Новый ОписаниеТипов("Число");
	Для Каждого Имя Из СтрРазделить("Выручка,Часы,СтоимостьЧасов,Кг,НормаЧасов", ",") Цикл
		Требования.Колонки.Добавить(Имя, ТипЧисла);
	КонецЦикла;
	Требования.Колонки.Добавить("ЕстьМатериалыБезВеса", Новый ОписаниеТипов("Булево"));
	Коэффициенты = КгНаЕдиницу(Материалы.ВыгрузитьКолонку("Номенклатура"));
	БезВеса = Новый Массив;
	БезСтроки = Новый Массив;
	Часы = ЧасыРаботыТребований(Требования, Момент);
	Для Каждого Строка Из Требования Цикл
		Строка.Выручка = ВыручкаТребования(Строка, СтрокиЗаказов, БезСтроки);
		Строка.Часы = ?(Часы.Получить(Строка.Требование) = Неопределено, 0, Часы.Получить(Строка.Требование));
		Строка.СтоимостьЧасов = Окр(Строка.Часы * Строка.СтоимостьЧаса, ЗнаковСуммы());
		Отбор = Новый Структура("Требование", Строка.Требование);
		Строка.Кг = КгИзрасходованного(Материалы.НайтиСтроки(Отбор), Коэффициенты, БезВеса, Строка);
		Если Строка.ВыработкаСтанка > 0 Тогда
			Строка.НормаЧасов = ОкруглитьЧасы(Строка.Кг / Строка.ВыработкаСтанка + Строка.ВремяНаСменуЗаказа / МинутВЧасе());
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Структура("Требования, Предупреждение, ПредупреждениеВеса", Требования,
		ТекстПредупрежденияОтчета(БезВеса, БезСтроки), ТекстПредупрежденияОтчета(БезВеса, Новый Массив));
	Возврат Результат;

КонецФункции

// Вес единицы номенклатуры в килограммах по правилу ВесНоменклатурыКг.
//
// Параметры:
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - позиции
//
// Возвращаемое значение:
//  Соответствие - ключ: СправочникСсылка.Номенклатура; значение: Число - кг на единицу номенклатуры, 0 - вес не задан
//
Функция КгНаЕдиницу(Номенклатура) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Позиции.Ссылка КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Единицы.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Вес)
	|			ТОГДА ВЫБОР
	|					КОГДА Единицы.Числитель > 0
	|							И Единицы.Знаменатель > 0
	|						ТОГДА Единицы.Числитель / Единицы.Знаменатель
	|					ИНАЧЕ 1
	|				КОНЕЦ
	|		КОГДА Позиции.ВесЗнаменатель > 0
	|			ТОГДА Позиции.ВесЗнаменатель * ВЫБОР
	|					КОГДА ВесовыеЕдиницы.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Вес)
	|							И ВесовыеЕдиницы.Числитель > 0
	|							И ВесовыеЕдиницы.Знаменатель > 0
	|						ТОГДА ВесовыеЕдиницы.Числитель / ВесовыеЕдиницы.Знаменатель
	|					ИНАЧЕ 1
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КгНаЕдиницу
	|ИЗ
	|	Справочник.Номенклатура КАК Позиции
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК Единицы
	|		ПО (Позиции.Единица = Единицы.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК ВесовыеЕдиницы
	|		ПО (Позиции.ВесЕдиница = ВесовыеЕдиницы.Ссылка)
	|ГДЕ
	|	Позиции.Ссылка В(&Номенклатура)";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.КгНаЕдиницу);
	КонецЦикла;
	Возврат Результат;

КонецФункции

