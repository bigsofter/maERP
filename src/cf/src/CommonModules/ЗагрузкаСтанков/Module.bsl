КонецФункции

// Строка черновика: вес по материалам, заполненным как в требовании (тот же путь, что РазместитьСтроку - ревью плана
// P2-7), и станок с самым ранним окончанием окна.
//
// Параметры:
//  Строка - СтрокаТаблицыЗначений - см. НоваяТаблицаАвтоплана
//  Данные - Структура - Станки, Допустимые, Контексты, Момент
//
Процедура ПредложитьСтроку(Строка, Данные)

	Требование = Документы.ТребованиеНакладная.СоздатьДокумент();
	Документы.ТребованиеНакладная.ЗаполнитьПоСтрокеЗаказа(Требование, Строка.Заказ, Строка.КодСтроки, Строка.Количество);
	Вес = ВесМатериаловЗагрузки(Требование.Материалы);
	Если ЗначениеЗаполнено(Вес.ТекстОшибки) Тогда
		Строка.ТекстОшибки = Вес.ТекстОшибки;
		Возврат;
	КонецЕсли;
	Строка.Вес = Вес.Вес;
	Станки = СтанкиСтроки(Строка.Номенклатура, Данные);
	Если Станки.Количество() = 0 Тогда
		Строка.ТекстОшибки = НСтр("ru = 'Нет действующего станка для этой продукции: проверьте список станков в карточке';
			|fr = 'Aucune machine active pour ce produit : vérifiez la liste des machines de la fiche';
			|en = 'No active machine for this product: check the machine list on its card';
			|es = 'No hay máquina activa para este producto: revise la lista de máquinas de la ficha'");
		Возврат;
	КонецЕсли;
	Лучшее = Неопределено;
	Ошибка = "";
	Для Каждого Станок Из Станки Цикл
		Часы = ДлительностьЗагрузки(Станок.Станок, Строка.Вес, Станок);
		Если ЗначениеЗаполнено(Часы.ТекстОшибки) Тогда
			Ошибка = Часы.ТекстОшибки;
			Продолжить;
		КонецЕсли;
		Контекст = КонтекстАвтоплана(Данные, Станок.Станок);
		Окно = ОкноВКонтексте(Контекст, Часы.Часы, Данные.Момент, Неопределено);
		Если ЗначениеЗаполнено(Окно.ТекстОшибки) Тогда
			Ошибка = Окно.ТекстОшибки;
			Продолжить;
		КонецЕсли;
		Если Лучшее = Неопределено Или Окно.Окончание < Лучшее.Окончание Тогда
			Лучшее = Новый Структура("Станок, Начало, Окончание", Станок.Станок, Окно.Начало, Окно.Окончание);
			Лучшее.Вставить("Часы", Часы.Часы);
			Лучшее.Вставить("Контекст", Контекст);
		КонецЕсли;
	КонецЦикла;
	Если Лучшее = Неопределено Тогда
		Строка.ТекстОшибки = Ошибка;
		Возврат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Строка, Лучшее, "Станок, Начало, Окончание, Часы");
	Строка.Просрочен = ЗначениеЗаполнено(Строка.ДатаОтгрузки) И Строка.Окончание > КонецДня(Строка.ДатаОтгрузки);
	// Предложенное место занято для следующих строк: регистратор - маркер черновика, а не Неопределено (ОкончаниеПомехи
	// пропускает записи, равные Исключить); занятость - по началу (обход прерывается по началу) - ревью плана P1-1, P1-2.
	Занято = Лучшее.Контекст.Занятость.Добавить();
	Занято.Начало = Лучшее.Начало;
	Занято.Окончание = Лучшее.Окончание;
	Занято.Регистратор = МаркерЧерновикаАвтоплана();
	Лучшее.Контекст.Занятость.Сортировать("Начало");

КонецПроцедуры

// Действующие станки автоплана с реквизитами длительности - читаются один раз (ревью плана P3-12).
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Выработка, ВремяНаСменуЗаказа; по наименованию
//
Функция СтанкиАвтоплана()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Станки.Ссылка КАК Станок,
	|	Станки.Выработка КАК Выработка,
	|	Станки.ВремяНаСменуЗаказа КАК ВремяНаСменуЗаказа
	|ИЗ
	|	Справочник.ПроизводственноеОборудование КАК Станки
	|ГДЕ
	|	НЕ Станки.ПометкаУдаления
	|	И НЕ Станки.Выведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Станки.Наименование";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Списки допустимых станков продукции (ТЧ «Станки» номенклатуры).
//
// Параметры:
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - продукция
//
// Возвращаемое значение:
//  Соответствие - ключ: СправочникСсылка.Номенклатура; значение: Массив из СправочникСсылка.ПроизводственноеОборудование;
//                 продукции без списка в соответствии нет
//
Функция ДопустимыеСтанкиПродукции(Номенклатура)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Станки.Ссылка КАК Номенклатура,
	|	Станки.Станок КАК Станок
	|ИЗ
	|	Справочник.Номенклатура.Станки КАК Станки
	|ГДЕ
	|	Станки.Ссылка В(&Номенклатура)";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = Результат.Получить(Выборка.Номенклатура);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(Выборка.Номенклатура, Список);
		КонецЕсли;
		Список.Добавить(Выборка.Станок);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Станки строки черновика: допустимые продукции среди действующих; без списка - все действующие. Список, где все станки
// выведены, - пустой результат, а не «любой» (ревью плана P3-11).
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - продукция
//  Данные       - Структура - Станки, Допустимые
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений - строки СтанкиАвтоплана
//
Функция СтанкиСтроки(Номенклатура, Данные)

	Допустимые = Данные.Допустимые.Получить(Номенклатура);
	Результат = Новый Массив;
	Для Каждого Станок Из Данные.Станки Цикл
		Если Допустимые = Неопределено Или Допустимые.Найти(Станок.Станок) <> Неопределено Тогда
			Результат.Добавить(Станок);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КонтекстАвтоплана(Данные, Станок)

	Контекст = Данные.Контексты.Получить(Станок);
	Если Контекст = Неопределено Тогда
		Контекст = КонтекстОкна(Станок, Данные.Момент, Данные.Момент);
		Данные.Контексты.Вставить(Станок, Контекст);
	КонецЕсли;
	Возврат Контекст;

КонецФункции

// Регистратор занятости, предложенной черновиком автоплана: пустая ссылка требования, а не Неопределено, - иначе
// ОкончаниеПомехи с Исключить = Неопределено её пропустит; строка в колонку ссылок не записалась бы.
//
// Возвращаемое значение:
//  ДокументСсылка.ТребованиеНакладная - маркер
//
Функция МаркерЧерновикаАвтоплана()

	Возврат Документы.ТребованиеНакладная.ПустаяСсылка();

КонецФункции

// Длительность запланированного требования на его станке: ручная (растяжение), иначе - по весу материалов.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Структура - Вес, Часы, ТекстОшибки (пустая - посчитано)
//
Функция ДлительностьТребования(Объект)

	Если Объект.ДлительностьВручную > 0 Тогда
		Возврат Новый Структура("Вес, Часы, ТекстОшибки", Объект.Вес, Объект.ДлительностьВручную, "");
	КонецЕсли;
	Возврат ДлительностьМатериалов(Объект.Станок, Объект.Материалы);

КонецФункции

// Длина элемента планировщика документа - по записанному плану: у требования - плановые даты, у обслуживания -
// начало и окончание. По ней перетаскивание отличается от растяжения.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ элемента
//
// Возвращаемое значение:
//  Число, Неопределено - секунды; Неопределено - документ не переносится
//
Функция ДлинаЭлементаЗагрузки(Регистратор)

	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ТребованиеНакладная") Тогда
		Даты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Регистратор, "ПланНачало, ПланОкончание");
		Возврат Даты.ПланОкончание - Даты.ПланНачало;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОбслуживаниеСтанка") Тогда
		Даты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Регистратор, "Начало, Окончание");
		Возврат Даты.Окончание - Даты.Начало;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область ОтчетыСлужебные

Функция НоваяТаблицаКатегорий()

	ТипЧасов = Новый ОписаниеТипов("Число");
	Категории = Новый ТаблицаЗначений;
	Категории.Колонки.Добавить("Станок", Новый ОписаниеТипов("СправочникСсылка.ПроизводственноеОборудование"));
	Категории.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка.ТребованиеНакладная, ДокументСсылка.ОбслуживаниеСтанка"));
	Категории.Колонки.Добавить("ВидОбслуживания", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОбслуживанияСтанков"));
	Для Каждого Имя Из СтрРазделить("Фонд,Работа,Обслуживание,НетЗаказа,План,ПлановыеОстановки", ",") Цикл
		Категории.Колонки.Добавить(Имя, ТипЧасов);
	КонецЦикла;
	Возврат Категории;

КонецФункции

// Фактические записи «Загрузки станков», пересекающие период: обслуживание и работа требований. Запущенное требование
// идёт до момента расчёта, даже если расчётное окончание записи раньше периода (затянувшаяся загрузка).
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода
//  Окончание - Дата - конец периода, не включается
//  Момент    - Дата - момент расчёта
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Документ, ВидЗаписи, ВидОбслуживания, Начало, Окончание (фактические, не
//                    обрезаны периодом)
//
Функция ФактическиеЗаписиПериода(Станки, Начало, Окончание, Момент)

	Запрос = Новый Запрос;
	// Затянувшаяся загрузка закончилась по расчёту до периода, но идёт - вторая часть объединения (как ЗанятостьСтанков).
	Запрос.Текст = ТекстФактическихЗаписей() + "
	|	И Загрузка.Окончание > &Начало
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|" + ТекстФактическихЗаписей() + "
	|	И Загрузка.Окончание <= &Начало
	|	И Требования.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено)";
	Запрос.УстановитьПараметр("Станки", Станки);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Запрос.УстановитьПараметр("Момент", Момент);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ТекстФактическихЗаписей()

	Возврат
	"ВЫБРАТЬ
	|	Загрузка.Станок КАК Станок,
	|	Загрузка.Регистратор КАК Документ,
	|	Загрузка.ВидЗаписи КАК ВидЗаписи,
	|	Обслуживание.ВидОбслуживания КАК ВидОбслуживания,
	|	Загрузка.Начало КАК Начало,
	|	ВЫБОР
	|		КОГДА Требования.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено)
	|			ТОГДА &Момент
	|		ИНАЧЕ Загрузка.Окончание
	|	КОНЕЦ КАК Окончание
	|ИЗ
	|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТребованиеНакладная КАК Требования
	|		ПО Загрузка.Регистратор = Требования.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОбслуживаниеСтанка КАК Обслуживание
	|		ПО Загрузка.Регистратор = Обслуживание.Ссылка
	|ГДЕ
	|	Загрузка.Станок В(&Станки)
	|	И НЕ Загрузка.План
	|	И Загрузка.Начало < &Окончание";

КонецФункции

// Плановые даты проведённых неотменённых требований станков, пересекающие период. Даты берутся из документа: плановая
// запись регистра заменяется фактической при запуске, а план и факт сравниваются.
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода
//  Окончание - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Документ, Начало, Окончание
//
Функция ПланыТребованийПериода(Станки, Начало, Окончание)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Требования.Станок КАК Станок,
	|	Требования.Ссылка КАК Документ,
	|	Требования.ПланНачало КАК Начало,
	|	Требования.ПланОкончание КАК Окончание
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Проведен
	|	И Требования.Станок В(&Станки)
	|	И Требования.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Отменено)
	|	И Требования.ПланНачало < &Окончание
	|	И Требования.ПланОкончание > &Начало
	|	И Требования.ПланОкончание > Требования.ПланНачало";
	Запрос.УстановитьПараметр("Станки", Станки);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Категории одного станка: строки документов и строка фонда.
//
// Параметры:
//  Категории - ТаблицаЗначений - см. НоваяТаблицаКатегорий
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Рабочие   - Массив из СтрокаТаблицыЗначений - рабочие интервалы станка за период, слитые
//  ДанныеСтанка - Структура - строки станка:
//   * Записи    - Массив из СтрокаТаблицыЗначений - см. ФактическиеЗаписиПериода
//   * Планы     - Массив из СтрокаТаблицыЗначений - см. ПланыТребованийПериода
//   * Остановки - Массив из СтрокаТаблицыЗначений - см. ПлановыеОстановкиПериода
//  Период    - Структура - Начало, Окончание: период, конец не включается
//  Факт      - Структура - Начало, Окончание: часть периода до момента расчёта, где считается факт
//
Процедура ДобавитьКатегорииСтанка(Категории, Станок, Рабочие, ДанныеСтанка, Период, Факт)

	Записи = ДанныеСтанка.Записи;
	Работы = НоваяТаблицаИнтервалов();
	Обслуживание = Перечисления.ВидыЗагрузкиСтанков.Обслуживание;
	Строки = Новый Соответствие;
	Простои = НоваяТаблицаИнтервалов();
	ЗанятоЧасов = 0;
	Для Каждого Запись Из Записи Цикл
		Если Запись.ВидЗаписи <> Обслуживание Тогда
			Продолжить;
		КонецЕсли;
		ИнтервалС = Макс(Запись.Начало, Факт.Начало);
		ИнтервалПо = Мин(Запись.Окончание, Факт.Окончание);
		Если ИнтервалПо <= ИнтервалС Тогда
			Продолжить;
		КонецЕсли;
		Простой = Простои.Добавить();
		Простой.Станок = Станок;
		Простой.Начало = ИнтервалС;
		Простой.Окончание = ИнтервалПо;
		Строка = СтрокаКатегорииДокумента(Категории, Строки, Станок, Запись.Документ);
		Строка.ВидОбслуживания = Запись.ВидОбслуживания;
		// Округляется только показ строки; «нет заказа» считается по неокруглённым часам (ревью Codex сборки 4).
		Часы = ЧасыВРабочееВремя(Рабочие, ИнтервалС, ИнтервалПо);
		Строка.Обслуживание = Строка.Обслуживание + ОкруглитьЧасы(Часы);
		ЗанятоЧасов = ЗанятоЧасов + Часы;
	КонецЦикла;
	ПростоиСлитые = НоваяТаблицаИнтервалов();
	ДобавитьСлитыеИнтервалы(ПростоиСлитые, Простои);

	Для Каждого Запись Из Записи Цикл
		Если Запись.ВидЗаписи = Обслуживание Тогда
			Продолжить;
		КонецЕсли;
		ИнтервалС = Макс(Запись.Начало, Факт.Начало);
		ИнтервалПо = Мин(Запись.Окончание, Факт.Окончание, НачалоСледующейРаботы(Записи, Запись));
		Если ИнтервалПо <= ИнтервалС Тогда
			Продолжить;
		КонецЕсли;
		Часы = ЧасыВРабочееВремя(Рабочие, ИнтервалС, ИнтервалПо);
		Для Каждого Простой Из ПростоиСлитые Цикл
			Часы = Часы - ЧасыВРабочееВремя(Рабочие, Макс(ИнтервалС, Простой.Начало), Мин(ИнтервалПо, Простой.Окончание));
		КонецЦикла;
		Интервал = Работы.Добавить();
		Интервал.Начало = ИнтервалС;
		Интервал.Окончание = ИнтервалПо;
		Строка = СтрокаКатегорииДокумента(Категории, Строки, Станок, Запись.Документ);
		Строка.Работа = Строка.Работа + ОкруглитьЧасы(Часы);
		ЗанятоЧасов = ЗанятоЧасов + Часы;
	КонецЦикла;

	Для Каждого План Из ДанныеСтанка.Планы Цикл
		Строка = СтрокаКатегорииДокумента(Категории, Строки, Станок, План.Документ);
		ПланС = Макс(План.Начало, Период.Начало);
		ПланПо = Мин(План.Окончание, Период.Окончание);
		Строка.План = ОкруглитьЧасы(ЧасыВРабочееВремя(Рабочие, ПланС, ПланПо));
	КонецЦикла;

	Строка = Категории.Добавить();
	Строка.Станок = Станок;
	Фонд = ЧасыВРабочееВремя(Рабочие, Факт.Начало, Факт.Окончание);
	Строка.Фонд = ОкруглитьЧасы(Фонд);
	// Категории не пересекаются (проведение запрещает факт с фактом одного вида и второй запуск): остаток не меньше
	// нуля; защита - от данных, записанных в обход проведения.
	Строка.НетЗаказа = ОкруглитьЧасы(Макс(0, Фонд - ЗанятоЧасов));
	Занятость = Новый Структура("Работы, Простои", Работы, ПростоиСлитые);
	Остановки = ЧасыПлановыхОстановок(Рабочие, ДанныеСтанка.Остановки, Занятость, Факт);
	Строка.ПлановыеОстановки = ОкруглитьЧасы(Остановки);

КонецПроцедуры

// Часы плановых остановок станка: объединение плановых интервалов обслуживания в части периода до момента расчёта,
// в рабочем времени, без часов фактической работы станка (ТО запланировали, а станок работал - остановки не было).
//
// Параметры:
//  Рабочие   - Массив из СтрокаТаблицыЗначений - рабочие интервалы станка
//  Остановки - Массив из СтрокаТаблицыЗначений - см. ПлановыеОстановкиПериода
//  Занятость - Структура - Работы (интервалы фактической работы, не пересекаются) и Простои (слитые фактические
//              обслуживания): «чистая» работа - работа без простоев, как в категории «Работа» (ревью кода волны 5, P2-2)
//  Факт      - Структура - Начало, Окончание: часть периода до момента расчёта
//
// Возвращаемое значение:
//  Число - часы, не округлены
//
Функция ЧасыПлановыхОстановок(Рабочие, Остановки, Занятость, Факт)

	Обрезанные = НоваяТаблицаИнтервалов();
	Для Каждого Остановка Из Остановки Цикл
		Интервал = Обрезанные.Добавить();
		Интервал.Начало = Макс(Остановка.Начало, Факт.Начало);
		Интервал.Окончание = Мин(Остановка.Окончание, Факт.Окончание);
		Если Интервал.Окончание <= Интервал.Начало Тогда
			Обрезанные.Удалить(Интервал);
		КонецЕсли;
	КонецЦикла;
	Слитые = НоваяТаблицаИнтервалов();
	ДобавитьСлитыеИнтервалы(Слитые, Обрезанные);
	Часы = 0;
	Для Каждого Остановка Из Слитые Цикл
		Часы = Часы + ЧасыВРабочееВремя(Рабочие, Остановка.Начало, Остановка.Окончание);
		Для Каждого Работа Из Занятость.Работы Цикл
			РаботаС = Макс(Остановка.Начало, Работа.Начало);
			РаботаПо = Мин(Остановка.Окончание, Работа.Окончание);
			Если РаботаПо <= РаботаС Тогда
				Продолжить;
			КонецЕсли;
			Часы = Часы - ЧасыВРабочееВремя(Рабочие, РаботаС, РаботаПо);
			Для Каждого Простой Из Занятость.Простои Цикл
				Часы = Часы + ЧасыВРабочееВремя(Рабочие, Макс(РаботаС, Простой.Начало), Мин(РаботаПо, Простой.Окончание));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Макс(0, Часы);

КонецФункции

// Плановые интервалы обслуживания станков, пересекающие период (доступность OEE): плановые даты документа, если
// заполнены; у планового документа без них (записан до волны 5) - начало и окончание; у фактического «Планового ТО»
// без плановых дат (введено сразу фактом) - тоже начало и окончание. Фактический ремонт, переналадка и прочее без
// плановых дат не плановые.
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода
//  Окончание - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Начало, Окончание
//
Функция ПлановыеОстановкиПериода(Станки, Начало, Окончание)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обслуживание.Станок КАК Станок,
	|	Обслуживание.ПланНачало КАК Начало,
	|	Обслуживание.ПланОкончание КАК Окончание
	|ИЗ
	|	Документ.ОбслуживаниеСтанка КАК Обслуживание
	|ГДЕ
	|	Обслуживание.Проведен
	|	И Обслуживание.Станок В(&Станки)
	|	И Обслуживание.ПланОкончание > Обслуживание.ПланНачало
	|	И Обслуживание.ПланНачало < &Окончание
	|	И Обслуживание.ПланОкончание > &Начало
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Обслуживание.Станок,
	|	Обслуживание.Начало,
	|	Обслуживание.Окончание
	|ИЗ
	|	Документ.ОбслуживаниеСтанка КАК Обслуживание
	|ГДЕ
	|	Обслуживание.Проведен
	|	И Обслуживание.Станок В(&Станки)
	|	И НЕ Обслуживание.ПланОкончание > Обслуживание.ПланНачало
	|	И Обслуживание.Плановое
	|	И Обслуживание.Начало < &Окончание
	|	И Обслуживание.Окончание > &Начало
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Обслуживание.Станок,
	|	Обслуживание.Начало,
	|	Обслуживание.Окончание
	|ИЗ
	|	Документ.ОбслуживаниеСтанка КАК Обслуживание
	|ГДЕ
	|	Обслуживание.Проведен
	|	И Обслуживание.Станок В(&Станки)
	|	И НЕ Обслуживание.ПланОкончание > Обслуживание.ПланНачало
	|	И НЕ Обслуживание.Плановое
	|	И Обслуживание.ВидОбслуживания = ЗНАЧЕНИЕ(Перечисление.ВидыОбслуживанияСтанков.ПлановоеТО)
	|	И Обслуживание.Начало < &Окончание
	|	И Обслуживание.Окончание > &Начало";
	Запрос.УстановитьПараметр("Станки", Станки);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Выручка требования без НДС в основной валюте: строка заказа по коду строки продукции, не нашлась - первая строка
// той же продукции; нет и её - 0 и требование в список без строки.
//
// Параметры:
//  Строка        - СтрокаТаблицыЗначений - строка ЗавершенныеТребования
//  СтрокиЗаказов - ТаблицаЗначений - строки продукции заказов с суммой без НДС и курсом
//  БезСтроки     - Массив из ДокументСсылка.ТребованиеНакладная - пополняется
//
// Возвращаемое значение:
//  Число - выручка
//
Функция ВыручкаТребования(Строка, СтрокиЗаказов, БезСтроки)

	Отбор = Новый Структура("Заказ, КодСтроки", Строка.Заказ, Строка.КодСтрокиПродукции);
	Найденные = СтрокиЗаказов.НайтиСтроки(Отбор);
	Если Найденные.Количество() = 0 Тогда
		Отбор = Новый Структура("Заказ, Продукция, Характеристика", Строка.Заказ, Строка.Продукция, Строка.Характеристика);
		Найденные = СтрокиЗаказов.НайтиСтроки(Отбор);
	КонецЕсли;
	Если Найденные.Количество() = 0 Или Найденные[0].Количество = 0 Тогда
		БезСтроки.Добавить(Строка.Требование);
		Возврат 0;
	КонецЕсли;
	СтрокаЗаказа = Найденные[0];
	Возврат Окр(Строка.Выпущено * СтрокаЗаказа.СуммаБезНДС / СтрокаЗаказа.Количество * СтрокаЗаказа.Курс, ЗнаковСуммы());

КонецФункции

Функция КгИзрасходованного(Материалы, Коэффициенты, БезВеса, СтрокаТребования)

	Кг = 0;
	Для Каждого Материал Из Материалы Цикл
		Коэффициент = Коэффициенты.Получить(Материал.Номенклатура);
		Если Не ЗначениеЗаполнено(Коэффициент) Тогда
			СтрокаТребования.ЕстьМатериалыБезВеса = Истина;
			Если БезВеса.Найти(Материал.Номенклатура) = Неопределено Тогда
				БезВеса.Добавить(Материал.Номенклатура);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Кг = Кг + Материал.Количество * Коэффициент;
	КонецЦикла;
	Возврат Окр(Кг, ЗнаковВеса());

КонецФункции

// Предупреждение под отчётом учёта станков: позиции без веса (их кг не посчитаны) и требования без строки заказа
// (их выручка 0).
//
// Параметры:
//  БезВеса   - Массив из СправочникСсылка.Номенклатура - позиции без веса
//  БезСтроки - Массив из ДокументСсылка.ТребованиеНакладная - требования без строки заказа
//
// Возвращаемое значение:
//  Строка - текст; пустая - предупреждать не о чем
//
Функция ТекстПредупрежденияОтчета(БезВеса, БезСтроки)

	Части = Новый Массив;
	Если БезВеса.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Не задан вес, кг не посчитаны: %1'; fr = 'Poids non renseigné, kg non calculés : %1';
			|en = 'Weight not set, kg not calculated: %1'; es = 'Peso no indicado, kg no calculados: %1'");
		Части.Добавить(СтрШаблон(Шаблон, СписокПредставлений(БезВеса)));
	КонецЕсли;
	Если БезСтроки.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Нет строки продукции в заказе, выручка 0: %1';
			|fr = 'Ligne de produit absente de la commande, chiffre d''affaires 0 : %1';
			|en = 'No product line in the order, revenue 0: %1'; es = 'No hay línea de producto en el pedido, ingresos 0: %1'");
		Части.Добавить(СтрШаблон(Шаблон, СписокПредставлений(БезСтроки)));
	КонецЕсли;
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Функция ИндексЗавершенныхТребований()

	Возврат 2;

КонецФункции

Функция ИндексМатериаловЗавершенных()

	Возврат 3;

