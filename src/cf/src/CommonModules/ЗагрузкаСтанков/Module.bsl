// Подпись элемента планировщика: заказ, продукция, вес и длительность требования или вид и причина обслуживания.
//
// Параметры:
//  Строка - СтрокаТаблицыЗначений - строка ЗанятостьСтанков
//
// Возвращаемое значение:
//  Строка - подпись
//
Функция ТекстЗанятости(Строка)

	Если ТипЗнч(Строка.Регистратор) = Тип("ДокументСсылка.ТребованиеНакладная") Тогда
		Шаблон = НСтр("ru = 'Заказ %1 / %2 (%3 кг, %4)'; fr = 'Commande %1 / %2 (%3 kg, %4)';
			|en = 'Order %1 / %2 (%3 kg, %4)'; es = 'Pedido %1 / %2 (%3 kg, %4)'");
		Текст = СтрШаблон(Шаблон, СокрЛП(Строка.НомерЗаказа), Строка.Продукция, Формат(Строка.Вес, "ЧДЦ=1; ЧН=0"),
			ПредставлениеЧасов(Строка.Длительность));
		Если Строка.Затянулась Тогда
			Текст = Текст + НСтр("ru = ' - идёт дольше расчёта'; fr = ' - dure plus que prévu';
				|en = ' - running longer than planned'; es = ' - dura más de lo previsto'");
		КонецЕсли;
		Возврат Текст;
	КонецЕсли;
	Возврат Строка(Строка.ВидОбслуживания) + ?(ПустаяСтрока(Строка.Причина), "", ": " + Строка.Причина);

КонецФункции

// Первый рабочий момент не раньше заданного.
//
// Параметры:
//  Интервалы - ТаблицаЗначений - рабочие интервалы одного станка по возрастанию начала
//  Момент    - Дата - момент
//
// Возвращаемое значение:
//  Дата, Неопределено - момент внутри рабочего интервала; Неопределено - рабочего времени дальше нет
//
Функция НачалоРаботы(Интервалы, Момент)

	Для Каждого Интервал Из Интервалы Цикл
		Если Интервал.Окончание > Момент Тогда
			Возврат Макс(Интервал.Начало, Момент);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Начало загрузки от момента: сдвиг на начало ближайшей смены, затем округление вверх до шага планирования; если
// округление вывело за смену - начало следующей смены (смена не на отметке шага сохраняет своё начало).
//
// Параметры:
//  Интервалы - ТаблицаЗначений - рабочие интервалы одного станка по возрастанию начала
//  Момент    - Дата - момент
//
// Возвращаемое значение:
//  Дата, Неопределено - начало; Неопределено - рабочего времени дальше нет
//
Функция НачалоСменыСоШагом(Интервалы, Момент)

	Начало = НачалоРаботы(Интервалы, Момент);
	Если Начало = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Округлено = ОкруглитьДоШага(Начало);
	Возврат ?(Округлено = Начало, Начало, НачалоРаботы(Интервалы, Округлено));

КонецФункции

// Раскладка секунд работы по рабочим интервалам от момента начала - то же правило, что ОкончаниеПоРежиму, по уже
// прочитанным интервалам.
//
// Параметры:
//  Интервалы - ТаблицаЗначений - рабочие интервалы одного станка по возрастанию начала
//  Начало    - Дата - момент начала
//  Секунд    - Число - секунды работы
//
// Возвращаемое значение:
//  Дата, Неопределено - окончание; Неопределено - не уложилось в интервалы
//
Функция РазложитьЧасы(Интервалы, Начало, Секунд)

	Осталось = Секунд;
	Для Каждого Интервал Из Интервалы Цикл
		Если Интервал.Окончание <= Начало Тогда
			Продолжить;
		КонецЕсли;
		ИнтервалС = Макс(Интервал.Начало, Начало);
		Длина = Интервал.Окончание - ИнтервалС;
		Если Длина >= Осталось Тогда
			Возврат ИнтервалС + Осталось;
		КонецЕсли;
		Осталось = Осталось - Длина;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Позднейшее окончание записей занятости, пересекающих отрезок.
//
// Параметры:
//  Занятость - ТаблицаЗначений - см. ЗанятостьСтанков
//  Начало    - Дата - начало отрезка
//  Окончание - Дата - конец отрезка, не включается
//  Исключить - ДокументСсылка, Неопределено - регистратор, чьи записи не мешают
//
// Возвращаемое значение:
//  Дата, Неопределено - окончание помехи; Неопределено - отрезок свободен
//
Функция ОкончаниеПомехи(Занятость, Начало, Окончание, Исключить)

	Помеха = Неопределено;
	Для Каждого Запись Из Занятость Цикл
		Если Запись.Начало >= Окончание Тогда
			Прервать;
		КонецЕсли;
		Если Запись.Окончание > Начало И Запись.Регистратор <> Исключить Тогда
			Помеха = ?(Помеха = Неопределено, Запись.Окончание, Макс(Помеха, Запись.Окончание));
		КонецЕсли;
	КонецЦикла;
	Возврат Помеха;

КонецФункции

// Рабочие интервалы и занятость станка на горизонт поиска окна - читаются один раз для нескольких окон.
//
// Параметры:
//  Станок   - СправочникСсылка.ПроизводственноеОборудование - станок
//  НеРаньше - Дата - начало горизонта
//  Момент   - Дата - момент расчёта
//
// Возвращаемое значение:
//  Структура - Станок, Момент, Горизонт, Интервалы, Занятость
//
Функция КонтекстОкна(Станок, НеРаньше, Момент)

	Контекст = Новый Структура("Станок, Момент", Станок, Момент);
	Начало = ОкруглитьДоШага(Макс(НеРаньше, Момент));
	Контекст.Вставить("Горизонт", Начало + ДнейГоризонтаОкончания() * СекундВСутках());
	Станки = Новый Массив;
	Станки.Добавить(Станок);
	Контекст.Вставить("Интервалы", ИнтервалыРаботыСтанков(Станки, Начало, Контекст.Горизонт));
	Контекст.Вставить("Занятость", ЗанятостьСтанков(Станки, Начало, Контекст.Горизонт, Момент));
	Возврат Контекст;

КонецФункции

// Поиск окна по прочитанному контексту, см. БлижайшееОкно.
//
// Параметры:
//  Контекст  - Структура - см. КонтекстОкна
//  Часы      - Число - длительность загрузки, ч
//  НеРаньше  - Дата - самое раннее начало
//  Исключить - ДокументСсылка, Неопределено - регистратор, чьи записи не мешают
//
// Возвращаемое значение:
//  Структура - см. БлижайшееОкно
//
Функция ОкноВКонтексте(Контекст, Часы, НеРаньше, Исключить)

	Результат = Новый Структура("Начало, Окончание", Неопределено, Неопределено);
	Результат.Вставить("Сдвинуто", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Секунд = Окр(Часы * СекундВЧасе(), 0);
	Кандидат = Макс(НеРаньше, Контекст.Момент);
	Первое = Неопределено;
	Пока Секунд > 0 И Кандидат < Контекст.Горизонт Цикл
		НачалоОкна = НачалоСменыСоШагом(Контекст.Интервалы, Кандидат);
		ОкончаниеОкна = ?(НачалоОкна = Неопределено, Неопределено, РазложитьЧасы(Контекст.Интервалы, НачалоОкна, Секунд));
		Если ОкончаниеОкна = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если Первое = Неопределено Тогда
			Первое = НачалоОкна;
		КонецЕсли;
		Помеха = ОкончаниеПомехи(Контекст.Занятость, НачалоОкна, ОкончаниеОкна, Исключить);
		Если Помеха = Неопределено Тогда
			Результат.Начало = НачалоОкна;
			Результат.Окончание = ОкончаниеОкна;
			Результат.Сдвинуто = НачалоОкна > Первое;
			Возврат Результат;
		КонецЕсли;
		Кандидат = Помеха;
	КонецЦикла;
	Шаблон = НСтр("ru = 'У станка «%1» нет свободного окна на %2 ч в ближайший год: проверьте режим работы и выработку';
		|fr = 'La machine « %1 » n''a pas de créneau libre de %2 h dans l''année : vérifiez le régime et la cadence';
		|en = 'Machine ""%1"" has no free slot of %2 h within a year: check the work schedule and output rate';
		|es = 'La máquina «%1» no tiene hueco libre de %2 h en el próximo año: revise el régimen y el rendimiento'");
	Результат.ТекстОшибки = СтрШаблон(Шаблон, Контекст.Станок, Часы);
	Возврат Результат;

КонецФункции

// Почему окно не годится для размещения: окна нет или заданное время занято.
//
// Параметры:
//  Окно          - Структура - см. БлижайшееОкно
//  ВремяЗадано   - Булево - размещение перетаскиванием в конкретное время
//
// Возвращаемое значение:
//  Строка - текст; пустая строка - окно годится
//
Функция ТекстОкна(Окно, ВремяЗадано)

	Если ЗначениеЗаполнено(Окно.ТекстОшибки) Или Не ВремяЗадано Или Не Окно.Сдвинуто Тогда
		Возврат Окно.ТекстОшибки;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Это время станка занято: ближайшее свободное окно - %1';
		|fr = 'Ce créneau de la machine est occupé : prochain créneau libre - %1';
		|en = 'This machine time is busy: the nearest free slot is %1';
		|es = 'Ese tiempo de la máquina está ocupado: el hueco libre más próximo es %1'");
	Возврат СтрШаблон(Шаблон, Формат(Окно.Начало, "ДФ='dd.MM.yyyy HH:mm'"));

КонецФункции

// Размещать и переносить в прошлое нельзя; запас - шаг планирования (перетаскивание в текущий час).
//
// Параметры:
//  Начало - Дата, Неопределено - заданное время; Неопределено - ближайшее окно
//  Момент - Дата - момент расчёта
//
// Возвращаемое значение:
//  Строка - текст; пустая строка - время годится
//
Функция ТекстЗапретаПрошлого(Начало, Момент)

	Если Начало = Неопределено Или Начало >= Момент - ШагСекунд() Тогда
		Возврат "";
	КонецЕсли;
	Возврат НСтр("ru = 'Загрузку нельзя запланировать в прошлом: выберите время позже текущего';
		|fr = 'Une charge ne peut pas être planifiée dans le passé : choisissez un moment ultérieur';
		|en = 'A load cannot be planned in the past: choose a later time';
		|es = 'No se puede planificar una carga en el pasado: elija un momento posterior'");

КонецФункции

// Почему строку заказа нельзя разместить ещё до чтения данных: количество не больше нуля или время в прошлом.
//
// Параметры:
//  Количество - Число - размещаемое количество
//  Начало     - Дата, Неопределено - время перетаскивания
//  Момент     - Дата - момент расчёта
//
// Возвращаемое значение:
//  Строка - текст; пустая строка - размещать можно
//
Функция ТекстЗапретаРазмещения(Количество, Начало, Момент)

	Если Количество <= 0 Тогда
		Возврат НСтр("ru = 'Укажите количество продукции больше нуля';
			|fr = 'Indiquez une quantité de produit supérieure à zéro';
			|en = 'Specify a product quantity greater than zero';
			|es = 'Indique una cantidad de producto mayor que cero'");
	КонецЕсли;
	Возврат ТекстЗапретаПрошлого(Начало, Момент);

КонецФункции

// Почему строку заказа нельзя разместить по данным: строки нет в «Готовых к запуску» (стадия сменилась, материалов не
// хватает, остаток покрыт) или количество больше её остатка. Вызывать под блокировками проведения требования:
// проведение (ТекстПревышенияЗаказа) сверяет только ключ продукции, остаток строки - здесь.
//
// Параметры:
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ
//  КодСтроки  - Число - КодСтроки строки продукции
//  Количество - Число - размещаемое количество
//  Склад      - СправочникСсылка.МестаХранения - склад размещения
//
// Возвращаемое значение:
//  Строка - текст; пустая строка - размещать можно
//
Функция ТекстОстаткаСтроки(Заказ, КодСтроки, Количество, Склад)

	Строки = СтрокиГотовых(Заказ, Склад).НайтиСтроки(Новый Структура("КодСтроки", КодСтроки));
	Если Строки.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Строка заказа больше не готова к запуску: обновите закладку «Станки»';
			|fr = 'La ligne de commande n''est plus prête à lancer : actualisez l''onglet « Machines »';
			|en = 'The order line is no longer ready to start: refresh the ""Machines"" tab';
			|es = 'La línea del pedido ya no está lista para iniciar: actualice la pestaña «Máquinas»'");
	КонецЕсли;
	Если Количество > Строки[0].Остаток Тогда
		Шаблон = НСтр("ru = 'По строке заказа осталось разместить %1, а указано %2';
			|fr = 'Il reste %1 à planifier sur la ligne de commande, %2 indiqué';
			|en = 'The order line has %1 left to place, %2 specified';
			|es = 'A la línea del pedido le quedan %1 por planificar, se indicó %2'");
		Возврат СтрШаблон(Шаблон, Строки[0].Остаток, Количество);
	КонецЕсли;
	Возврат "";

КонецФункции

// Вес материалов загрузки и длительность на станке, с текстом, если посчитать нельзя.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Материалы - ТабличнаяЧасть, ТаблицаЗначений - строки с колонками Номенклатура и Количество
//
// Возвращаемое значение:
//  Структура - Вес (кг), Часы, ТекстОшибки (пустая - посчитано)
//
Функция ДлительностьМатериалов(Станок, Материалы)

	Результат = Новый Структура("Вес, Часы, ТекстОшибки", 0, 0, "");
	Вес = ВесМатериаловЗагрузки(Материалы);
	Если ЗначениеЗаполнено(Вес.ТекстОшибки) Тогда
		Результат.ТекстОшибки = Вес.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	Длительность = ДлительностьЗагрузки(Станок, Вес.Вес);
	Результат.Вес = Вес.Вес;
	Результат.Часы = Длительность.Часы;
	Результат.ТекстОшибки = Длительность.ТекстОшибки;
	Возврат Результат;

КонецФункции

// Вес материалов загрузки в кг, с текстом, если посчитать нельзя (материалов нет или у них не задан вес).
//
// Параметры:
//  Материалы - ТабличнаяЧасть, ТаблицаЗначений - строки с колонками Номенклатура и Количество
//
// Возвращаемое значение:
//  Структура - Вес (кг), ТекстОшибки (пустая - посчитан)
//
Функция ВесМатериаловЗагрузки(Материалы)

	Результат = Новый Структура("Вес, ТекстОшибки", 0, "");
	Если Материалы.Количество() = 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'У строки заказа нет материалов: загрузку станка не посчитать';
			|fr = 'La ligne de commande n''a pas de matières : la charge machine ne peut pas être calculée';
			|en = 'The order line has no materials: the machine load cannot be calculated';
			|es = 'La línea del pedido no tiene materiales: no se puede calcular la carga de la máquina'");
		Возврат Результат;
	КонецЕсли;
	Вес = ВесНоменклатурыКг(Материалы);
	Если Вес.БезВеса.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'У материалов не задан вес, время загрузки не посчитать: %1';
			|fr = 'Le poids des matières n''est pas renseigné, la durée de charge ne peut pas être calculée : %1';
			|en = 'The materials have no weight, the load time cannot be calculated: %1';
			|es = 'Los materiales no tienen peso, no se puede calcular el tiempo de carga: %1'");
		Результат.ТекстОшибки = СтрШаблон(Шаблон, СтрСоединить(Вес.БезВеса, ", "));
		Возврат Результат;
	КонецЕсли;
	Результат.Вес = Вес.Вес;
	Возврат Результат;

КонецФункции

// Действие требования с текстом отказа вместо исключения.
//
// Параметры:
//  Объект   - ДокументОбъект.ТребованиеНакладная - требование
//  Действие - Строка - см. ТребованияНакладные.ВыполнитьДействие
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - выполнено
//
Функция ЗаписатьДействие(Объект, Действие)

	ПолучитьСообщенияПользователю(Истина);
	Попытка
		ТребованияНакладные.ВыполнитьДействие(Объект, Действие);
	Исключение
		Возврат ТекстОшибкиЗаписи(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";

КонецФункции

// Текст отказа записи: сообщения проведения, а если их нет - краткое представление ошибки.
//
// Параметры:
//  Информация - ИнформацияОбОшибке - ошибка записи
//
// Возвращаемое значение:
//  Строка - текст
//
Функция ТекстОшибкиЗаписи(Информация)

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Если Тексты.Найти(Сообщение.Текст) = Неопределено Тогда
			Тексты.Добавить(Сообщение.Текст);
		КонецЕсли;
	КонецЦикла;
	Если Тексты.Количество() = 0 Тогда
		Тексты.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация));
	КонецЕсли;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

// Перенос документа обслуживания: только плановое (факт правят в документе); новое начало - округлённое до шага, та же
// длительность, станок строки планировщика. Под блокировкой загрузки станка сверка с фактом станка, как у требования:
// проведение план с фактом не сверяет.
//
// Параметры:
//  Регистратор - ДокументСсылка.ОбслуживаниеСтанка - документ
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - новый станок; пустой - прежний
//  Начало      - Дата - новое начало
//  Момент      - Дата - момент расчёта
//  Часы        - Число, Неопределено - новая длительность (растяжение); Неопределено - прежняя
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - перенесено
//
Функция ПеренестиОбслуживание(Регистратор, Станок, Начало, Момент, Часы)

	Объект = Регистратор.ПолучитьОбъект();
	Если Не Объект.Плановое Тогда
		Возврат НСтр("ru = 'Переносится только плановое обслуживание: фактическое правят в документе';
			|fr = 'Seule une maintenance planifiée se déplace : la réelle se corrige dans le document';
			|en = 'Only planned maintenance can be moved: actual maintenance is edited in the document';
			|es = 'Solo se mueve un mantenimiento planificado: el real se corrige en el documento'");
	КонецЕсли;
	ТекстОшибки = ТекстЗапретаПрошлого(Начало, Момент);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	Длина = ?(Часы = Неопределено, Объект.Окончание - Объект.Начало, Окр(Часы * СекундВЧасе(), 0));
	Объект.Начало = ОкруглитьДоШага(Макс(Начало, Момент));
	Объект.Окончание = Объект.Начало + Длина;
	Если ЗначениеЗаполнено(Станок) Тогда
		Объект.Станок = Станок;
	КонецЕсли;
	ПолучитьСообщенияПользователю(Истина);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		УправляемыеБлокировки.ЗагрузкаСтанков(Блокировка, Объект.Станок);
		Блокировка.Заблокировать();
		Факт = ФактНаВремени(Объект.Станок, Объект.Начало, Объект.Окончание, Объект.Ссылка, Момент);
		Если Факт = Неопределено Тогда
			Объект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ТекстОшибки = ТекстПересеченияЗагрузки(Факт);
		КонецЕсли;
		// Без записи фиксируется пустая транзакция: откат вложенной сломал бы внешнюю (тест в транзакции).
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ТекстОшибкиЗаписи(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат ТекстОшибки;

КонецФункции

// Фактическая запись станка (работа или обслуживание, затянувшаяся - по продлённому окончанию), на которую ложится
// отрезок; записи переносимого документа не мешают.
//
// Параметры:
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало      - Дата - начало отрезка
//  Окончание   - Дата - конец отрезка, не включается
//  Регистратор - ДокументСсылка - переносимый документ
//  Момент      - Дата - момент расчёта
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - запись факта; Неопределено - факта на этом отрезке нет
//
Функция ФактНаВремени(Станок, Начало, Окончание, Регистратор, Момент)

	Станки = Новый Массив;
	Станки.Добавить(Станок);
	Для Каждого Запись Из ЗанятостьСтанков(Станки, Начало, Окончание, Момент) Цикл
		Если Не Запись.План И Запись.Регистратор <> Регистратор Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Почему перенос требования на новое время нельзя: нет рабочего времени или новое время ложится на фактическую работу
// или обслуживание станка (проведение план с фактом не сверяет). Заполняет станку план начала. Вызывать под
// блокировкой загрузки станка.
//
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная - переносимое требование с новым станком
//  Начало - Дата - время перетаскивания
//  Часы   - Число - длительность загрузки на станке
//  Момент - Дата - момент расчёта (продление затянувшейся загрузки)
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - перенос возможен, ПланНачало заполнен
//
Функция ТекстЗанятостиПереноса(Объект, Начало, Часы, Момент)

	Контекст = КонтекстОкна(Объект.Станок, Начало, Момент);
	НовоеНачало = НачалоСменыСоШагом(Контекст.Интервалы, Макс(Начало, Момент));
	НовоеОкончание = ?(НовоеНачало = Неопределено, Неопределено,
		РазложитьЧасы(Контекст.Интервалы, НовоеНачало, Окр(Часы * СекундВЧасе(), 0)));
	Если НовоеОкончание = Неопределено Тогда
		Шаблон = НСтр("ru = 'У станка «%1» нет рабочего времени на %2 ч от выбранного момента: проверьте режим работы';
			|fr = 'La machine « %1 » n''a pas %2 h de temps de travail à partir de ce moment : vérifiez le régime';
			|en = 'Machine ""%1"" has no %2 h of working time from the chosen moment: check the work schedule';
			|es = 'La máquina «%1» no tiene %2 h de tiempo de trabajo desde ese momento: revise el régimen'");
		Возврат СтрШаблон(Шаблон, Объект.Станок, Часы);
	КонецЕсли;
	Для Каждого Запись Из Контекст.Занятость Цикл
		Если Запись.Начало >= НовоеОкончание Тогда
			Прервать;
		КонецЕсли;
		Если Не Запись.План И Запись.Окончание > НовоеНачало И Запись.Регистратор <> Объект.Ссылка Тогда
			Возврат ТекстПересеченияЗагрузки(Запись);
		КонецЕсли;
	КонецЦикла;
	Объект.ПланНачало = НовоеНачало;
	Возврат "";

КонецФункции

Функция НоваяТаблицаГотовых()

	ТипЧисло = Новый ОписаниеТипов("Число");
	ТипБулево = Новый ОписаниеТипов("Булево");
	Готовые = Новый ТаблицаЗначений;
	Готовые.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
	Готовые.Колонки.Добавить("КодСтроки", ТипЧисло);
	Готовые.Колонки.Добавить("НомерЗаказа", Новый ОписаниеТипов("Строка"));
	Готовые.Колонки.Добавить("Клиент");
	Готовые.Колонки.Добавить("ДатаОтгрузки", Новый ОписаниеТипов("Дата"));
	Готовые.Колонки.Добавить("БезДатыОтгрузки", ТипБулево);
	Готовые.Колонки.Добавить("Номенклатура");
	Готовые.Колонки.Добавить("Характеристика");
	Готовые.Колонки.Добавить("Количество", ТипЧисло);
	Готовые.Колонки.Добавить("Остаток", ТипЧисло);
	Готовые.Колонки.Добавить("Вес", ТипЧисло);
	Готовые.Колонки.Добавить("Часы", ТипЧисло);
	Готовые.Колонки.Добавить("ТекстОшибки", Новый ОписаниеТипов("Строка"));
	Готовые.Колонки.Добавить("Просрочен", ТипБулево);
	Готовые.Колонки.Добавить("ИзСклада", ТипБулево);
	Возврат Готовые;

КонецФункции

// Строки «Готовых к запуску» без времени на станке, см. ГотовыеКЗапуску.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя, Неопределено - один заказ; Неопределено - все
//  Склад - СправочникСсылка.МестаХранения, Неопределено - склад размещения; Неопределено - склад пользователя
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаГотовых
//
Функция СтрокиГотовых(Заказ, Склад)

	Готовые = НоваяТаблицаГотовых();
	Пакет = ДанныеГотовыхКЗапуску(Заказ, ?(Склад = Неопределено, СкладРазмещения(), Склад));
	Строки = Пакет[ИндексСтрокГотовых()].Выгрузить();
	Если Строки.Количество() = 0 Тогда
		Возврат Готовые;
	КонецЕсли;
	Данные = Новый Структура;
	Данные.Вставить("Строки", Строки);
	Данные.Вставить("Материалы", Пакет[ИндексМатериаловГотовых()].Выгрузить());
	Данные.Вставить("ВТребованиях", Пакет[ИндексТребованийГотовых()].Выгрузить());
	Данные.Вставить("НаСкладе", Пакет[ИндексОстатковГотовых()].Выгрузить());
	Заказы = Строки.Скопировать(, "Заказ, Стадия");
	Заказы.Свернуть("Заказ, Стадия");
	Для Каждого СтрокаЗаказа Из Заказы Цикл
		ДобавитьГотовыеЗаказа(Готовые, СтрокаЗаказа, Данные);
	КонецЦикла;
	Возврат Готовые;

КонецФункции

// Склад, с которого размещаемое требование возьмёт материалы, - склад пользователя по умолчанию, как при вводе
// требования (ЗаполнитьРеквизитыПоУмолчанию).
//
// Возвращаемое значение:
//  СправочникСсылка.МестаХранения - склад
//
Функция СкладРазмещения()

	Объект = Документы.ТребованиеНакладная.СоздатьДокумент();
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(Объект);
	Возврат Объект.МестоХранения;

КонецФункции

// Пакет данных «Готовых к запуску»: заказы на производство в стадиях «Заказ поставщику», «Восполнение потребности» и
// «В производстве», их строки продукции, материалы, открытые требования по строкам и остатки материалов склада.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя, Неопределено - один заказ; Неопределено - все
//  Склад - СправочникСсылка.МестаХранения - склад размещения
//
// Возвращаемое значение:
//  Массив из РезультатЗапроса - см. ИндексСтрокГотовых, ИндексМатериаловГотовых, ИндексТребованийГотовых,
//                               ИндексОстатковГотовых
//
Функция ДанныеГотовыхКЗапуску(Заказ, Склад)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	История.ЗаказПокупателя КАК Заказ,
	|	История.СтатусЗаказаПокупателя КАК Стадия
	|ПОМЕСТИТЬ ВТСтадии
	|ИЗ
	|	РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних(
	|			,
	|			ЗаказПокупателя В
	|				(ВЫБРАТЬ
	|					ЗаказыОтбора.Ссылка КАК Ссылка
	|				ИЗ
	|					Документ.ЗаказПокупателя КАК ЗаказыОтбора
	|				ГДЕ
	|					ЗаказыОтбора.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказаПокупателя.Производство)
	|					И ЗаказыОтбора.Проведен
	|					И НЕ ЗаказыОтбора.ПометкаУдаления
	|					И &ОтборЗаказа)) КАК История
	|ГДЕ
	|	История.СтатусЗаказаПокупателя В (ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.ВПроизводстве),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.ЗаказПоставщику),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.ВосполнениеПотребности))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Заказы.Ссылка КАК Заказ,
	|	ВТСтадии.Стадия КАК Стадия,
	|	Заказы.Номер КАК НомерЗаказа,
	|	Заказы.Контрагент КАК Клиент,
	|	Заказы.ДатаОтгрузки КАК ДатаОтгрузки
	|ПОМЕСТИТЬ ВТЗаказы
	|ИЗ
	|	ВТСтадии КАК ВТСтадии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
	|		ПО ВТСтадии.Заказ = Заказы.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТЗаказы.Заказ КАК Заказ,
	|	ВТЗаказы.Стадия КАК Стадия,
	|	ВТЗаказы.НомерЗаказа КАК НомерЗаказа,
	|	ВТЗаказы.Клиент КАК Клиент,
	|	ВТЗаказы.ДатаОтгрузки КАК ДатаОтгрузки,
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗаказы КАК ВТЗаказы
	|		ПО Товары.Ссылка = ВТЗаказы.Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказ,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Материалы.Ссылка КАК Заказ,
	|	Материалы.КодСтроки КАК КодСтроки,
	|	Материалы.КодСтрокиРодителя КАК КодСтрокиРодителя,
	|	Материалы.КодСтрокиПродукции КАК КодСтрокиПродукции,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.Характеристика КАК Характеристика,
	|	Материалы.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧМатериалы КАК Материалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗаказы КАК ВТЗаказы
	|		ПО Материалы.Ссылка = ВТЗаказы.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Требования.Заказ КАК Заказ,
	|	Требования.КодСтрокиПродукции КАК КодСтроки,
	|	Требования.Номенклатура КАК Номенклатура,
	|	Требования.Характеристика КАК Характеристика,
	|	СУММА(Требования.Количество) КАК Количество
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗаказы КАК ВТЗаказы
	|		ПО Требования.Заказ = ВТЗаказы.Заказ
	|ГДЕ
	|	Требования.Проведен
	|	И Требования.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запланировано),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено))
	|
	|СГРУППИРОВАТЬ ПО
	|	Требования.Заказ,
	|	Требования.КодСтрокиПродукции,
	|	Требования.Номенклатура,
	|	Требования.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			,
	|			МестоХранения = &Склад
	|				И Номенклатура В
	|					(ВЫБРАТЬ
	|						Материалы.Номенклатура КАК Номенклатура
	|					ИЗ
	|						Документ.ЗаказПокупателя.ТЧМатериалы КАК Материалы
	|							ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗаказы КАК ВТЗаказы
	|							ПО Материалы.Ссылка = ВТЗаказы.Заказ)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика";
	// Отбор одного заказа (перепроверка строки при размещении) или всех заказов на производство.
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборЗаказа", ?(Заказ = Неопределено, "ИСТИНА", "ЗаказыОтбора.Ссылка = &Заказ"));
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Склад", Склад);
	Возврат Запрос.ВыполнитьПакет();

КонецФункции

