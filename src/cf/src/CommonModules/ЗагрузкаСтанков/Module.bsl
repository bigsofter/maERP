// Учёт станков: рабочее время по режиму станка и производственному календарю, загрузка станков и проверка
// пересечения интервалов. Интервалы везде полуоткрытые: [Начало, Окончание).
//
#Область ПрограммныйИнтерфейс

// Рабочие интервалы станков за период по режиму работы. День производственного календаря у станка без флажка
// «Работает без производственного календаря» нерабочий: смены, начатые в этот день, в интервалы не входят. Смена
// относится к дню своего начала, смена через полночь заканчивается на следующий день. Пересекающиеся смены
// одного станка (например, ночная смена понедельника и утренняя вторника) сливаются.
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Начало, Окончание (Дата), упорядочена по станку и началу
//
Функция ИнтервалыРаботыСтанков(Станки, Начало, Окончание) Экспорт

	Интервалы = НоваяТаблицаИнтервалов();
	Если Окончание <= Начало Или Станки.Количество() = 0 Тогда
		Возврат Интервалы;
	КонецЕсли;

	// Смена вчерашнего дня через полночь заходит в период, поэтому обход начинается на день раньше.
	ПервыйДень = НачалоДня(Начало) - СекундВСутках();
	Выходные = РегистрыСведений.ПроизводственныйКалендарь.ПолучитьВыходные(ПервыйДень, Окончание);
	РежимыСтанков = РежимыРаботы(Станки);

	Для Каждого Станок Из Станки Цикл
		Режим = РежимыСтанков.Получить(Станок);
		Если Режим = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СменыСтанка = НоваяТаблицаИнтервалов();
		День = ПервыйДень;
		Пока День < Окончание Цикл
			Смены = Режим.Смены.Получить(ДеньНедели(День));
			Если Смены <> Неопределено И Не (Режим.УчитыватьКалендарь И Выходные.Найти(День) <> Неопределено) Тогда
				ДобавитьСменыДня(СменыСтанка, Станок, День, Смены, Начало, Окончание);
			КонецЕсли;
			День = День + СекундВСутках();
		КонецЦикла;
		ДобавитьСлитыеИнтервалы(Интервалы, СменыСтанка);
	КонецЦикла;

	Возврат Интервалы;

КонецФункции

// Рабочие интервалы одного станка за период, см. ИнтервалыРаботыСтанков.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Начало, Окончание
//
Функция ИнтервалыРаботыСтанка(Станок, Начало, Окончание) Экспорт

	Станки = Новый Массив;
	Станки.Добавить(Станок);
	Возврат ИнтервалыРаботыСтанков(Станки, Начало, Окончание);

КонецФункции

// Фонд рабочего времени станка за период: сумма рабочих интервалов по режиму и календарю.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  Число - часы
//
Функция ФондВремениСтанка(Станок, Начало, Окончание) Экспорт

	Возврат ЧасыИнтервалов(ИнтервалыРаботыСтанка(Станок, Начало, Окончание));

КонецФункции

// Сумма часов интервалов таблицы.
//
// Параметры:
//  Интервалы - ТаблицаЗначений, Массив из СтрокаТаблицыЗначений - строки с колонками Начало и Окончание
//
// Возвращаемое значение:
//  Число - часы
//
Функция ЧасыИнтервалов(Интервалы) Экспорт

	Секунд = 0;
	Для Каждого Интервал Из Интервалы Цикл
		Секунд = Секунд + (Интервал.Окончание - Интервал.Начало);
	КонецЦикла;
	Возврат Секунд / СекундВЧасе();

КонецФункции

// Длительность интервала в часах, округлённая до сотых, - так её хранит регистр «Загрузка станков».
//
// Параметры:
//  Начало    - Дата - начало интервала
//  Окончание - Дата - конец интервала, не включается
//
// Возвращаемое значение:
//  Число - часы
//
Функция ЧасыМеждуДатами(Начало, Окончание) Экспорт

	Возврат ОкруглитьЧасы((Окончание - Начало) / СекундВЧасе());

КонецФункции

// Часы, округлённые до сотых, как в регистре «Загрузка станков» и в отчётах.
//
// Параметры:
//  Часы - Число - часы
//
// Возвращаемое значение:
//  Число - округлённые часы
//
Функция ОкруглитьЧасы(Часы) Экспорт

	Возврат Окр(Часы, ЗнаковЧасов());

КонецФункции

// Секунд в сутках - шаг дней планировщика и режима работы.
//
// Возвращаемое значение:
//  Число - 86400
//
Функция СекундВСутках() Экспорт

	Возврат 86400;

КонецФункции

// Сколько часов интервала [Начало, Окончание) приходится на рабочие интервалы станка.
//
// Параметры:
//  Интервалы - ТаблицаЗначений, Массив из СтрокаТаблицыЗначений - рабочие интервалы одного станка
//  Начало    - Дата - начало интервала
//  Окончание - Дата - конец интервала, не включается
//
// Возвращаемое значение:
//  Число - часы
//
Функция ЧасыВРабочееВремя(Интервалы, Начало, Окончание) Экспорт

	Секунд = 0;
	Для Каждого Интервал Из Интервалы Цикл
		ИнтервалС = Макс(Интервал.Начало, Начало);
		ИнтервалПо = Мин(Интервал.Окончание, Окончание);
		Если ИнтервалПо > ИнтервалС Тогда
			Секунд = Секунд + (ИнтервалПо - ИнтервалС);
		КонецЕсли;
	КонецЦикла;
	Возврат Секунд / СекундВЧасе();

КонецФункции

// Записи загрузки станка, с которыми конфликтует новый интервал. Конфликт - пересечение во времени с записью
// другого регистратора того же станка, если обе записи плановые (любого вида) или обе фактические одного вида
// («Работа» с «Работой», «Обслуживание» с «Обслуживанием»). Фактическое обслуживание поверх фактической работы
// допустимо: авария случается посреди загрузки. План с фактом не сверяется: план потом переносится.
// Вызывать под блокировкой загрузки станка (УправляемыеБлокировки.ЗагрузкаСтанков).
//
// Параметры:
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало      - Дата - начало интервала
//  Окончание   - Дата - конец интервала, не включается
//  ВидЗаписи   - ПеречислениеСсылка.ВидыЗагрузкиСтанков - вид новой записи
//  План        - Булево - новая запись плановая
//  Регистратор - ДокументСсылка - регистратор новой записи: его прежние записи не конфликтуют
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Регистратор, Начало, Окончание, ВидЗаписи, План
//
Функция ПересеченияЗагрузки(Станок, Начало, Окончание, ВидЗаписи, План, Регистратор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Загрузка.Регистратор КАК Регистратор,
	|	Загрузка.Начало КАК Начало,
	|	Загрузка.Окончание КАК Окончание,
	|	Загрузка.ВидЗаписи КАК ВидЗаписи,
	|	Загрузка.План КАК План
	|ИЗ
	|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|ГДЕ
	|	Загрузка.Станок = &Станок
	|	И Загрузка.Регистратор <> &Регистратор
	|	И Загрузка.Начало < &Окончание
	|	И Загрузка.Окончание > &Начало
	|	И Загрузка.План = &План
	|	И &УсловиеВида
	|
	|УПОРЯДОЧИТЬ ПО
	|	Начало";
	// Плановые записи конфликтуют при любом виде, фактические - только одного вида.
	Если Не План Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВида", "Загрузка.ВидЗаписи = &ВидЗаписи");
	КонецЕсли;
	Запрос.УстановитьПараметр("УсловиеВида", Истина);
	Запрос.УстановитьПараметр("Станок", Станок);
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Запрос.УстановитьПараметр("План", План);
	Запрос.УстановитьПараметр("ВидЗаписи", ВидЗаписи);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Текст отказа по пересечению загрузки станка для сообщения пользователю.
//
// Параметры:
//  Пересечение - СтрокаТаблицыЗначений - строка результата ПересеченияЗагрузки
//
// Возвращаемое значение:
//  Строка - текст
//
Функция ТекстПересеченияЗагрузки(Пересечение) Экспорт

	Шаблон = НСтр("ru = 'Станок занят: %1, %2 - %3';
		|fr = 'La machine est occupée : %1, %2 - %3';
		|en = 'The machine is busy: %1, %2 - %3';
		|es = 'La máquina está ocupada: %1, %2 - %3'");
	Возврат СтрШаблон(Шаблон, Пересечение.Регистратор, Формат(Пересечение.Начало, "ДФ='dd.MM.yyyy HH:mm'"),
		Формат(Пересечение.Окончание, "ДФ='dd.MM.yyyy HH:mm'"));

КонецФункции

// Предупреждение о незаполненном производственном календаре: у станка без флажка «Работает без производственного
// календаря» фонд за год без единой записи календаря молча считается без праздников и выходных. Календарь ведётся
// в «Производство → Нормативы» и в «Зарплата и кадры».
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода
//  Окончание - Дата - конец периода, не включается
//
// Возвращаемое значение:
//  Строка - текст предупреждения; пустая строка - календарь заполнен или не нужен
//
Функция ТекстПустогоКалендаря(Станки, Начало, Окончание) Экспорт

	Если Окончание <= Начало Или Станки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Станки.Ссылка КАК Станок
	|ИЗ
	|	Справочник.ПроизводственноеОборудование КАК Станки
	|ГДЕ
	|	Станки.Ссылка В(&Станки)
	|	И НЕ Станки.РаботаетБезКалендаря";
	Запрос.УстановитьПараметр("Станки", Станки);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат "";
	КонецЕсли;

	Выходные = РегистрыСведений.ПроизводственныйКалендарь.ПолучитьВыходные(НачалоГода(Начало), КонецГода(Окончание - 1));
	ПустыеГоды = Новый Массив;
	Для НомерГода = Год(Начало) По Год(Окончание - 1) Цикл
		ГодЗаполнен = Ложь;
		Для Каждого День Из Выходные Цикл
			Если Год(День) = НомерГода Тогда
				ГодЗаполнен = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ГодЗаполнен Тогда
			ПустыеГоды.Добавить(Формат(НомерГода, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;
	Если ПустыеГоды.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'Производственный календарь на %1 не заполнен: фонд времени станков посчитан без праздников и выходных';
		|fr = 'Le calendrier de %1 n''est pas rempli : le temps disponible des machines est calculé sans jours fériés ni week-ends';
		|en = 'The working calendar for %1 is empty: machine available time is calculated without holidays and weekends';
		|es = 'El calendario laboral de %1 está vacío: el tiempo disponible se calcula sin festivos ni fines de semana'");
	Возврат СтрШаблон(Шаблон, СтрСоединить(ПустыеГоды, ", "));

КонецФункции

// Смена строки режима в секундах от начала дня. Окончание не позже начала - смена через полночь; равные
// начало и окончание (например, обе пустые - 00:00) без флажка «Круглосуточно» запрещает проверка заполнения
// станка, здесь они дают сутки, чтобы строка не пропала молча из старых данных. Одно правило для фонда и для
// проверки пересечения смен в карточке станка.
//
// Параметры:
//  НачалоСмены    - Дата - время начала
//  ОкончаниеСмены - Дата - время окончания
//  Круглосуточно  - Булево - смена на все сутки
//
// Возвращаемое значение:
//  Структура - НачалоСекунд, ОкончаниеСекунд
//
Функция СменаВСекундах(НачалоСмены, ОкончаниеСмены, Круглосуточно) Экспорт

	Если Круглосуточно Тогда
		Возврат Новый Структура("НачалоСекунд, ОкончаниеСекунд", 0, СекундВСутках());
	КонецЕсли;
	НачалоСекунд = НачалоСмены - НачалоДня(НачалоСмены);
	ОкончаниеСекунд = ОкончаниеСмены - НачалоДня(ОкончаниеСмены);
	Если ОкончаниеСекунд <= НачалоСекунд Тогда
		ОкончаниеСекунд = ОкончаниеСекунд + СекундВСутках();
	КонецЕсли;
	Возврат Новый Структура("НачалоСекунд, ОкончаниеСекунд", НачалоСекунд, ОкончаниеСекунд);

КонецФункции

// Почему нельзя выключить учёт станков или производство: путь выпуска выбирается по данным, и открытые
// требования-накладные или материалы, закреплённые на станках, остались бы без закрытия.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - выключить можно
//
Функция ТекстЗапретаВыключенияУчета() Экспорт

	// BSLLS:SetPrivilegedMode-off - запрет проверяется у любого, кто пишет константу (мастер, настройки), по всем требованиям.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Требования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Проведен
	|	И Требования.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запланировано),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Остатки.Требование
	|ИЗ
	|	РегистрНакопления.МатериалыНаСтанках.Остатки(
	|			,
	|			Станок <> ЗНАЧЕНИЕ(Справочник.ПроизводственноеОборудование.ПустаяСсылка)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток <> 0";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'На станках есть открытые требования-накладные или закреплённые материалы (%1): завершите или отмените их';
		|fr = 'Des bons de consommation machine sont ouverts ou des matières sont réservées sur les machines (%1) : terminez-les ou annulez-les';
		|en = 'There are open machine material requisitions or materials reserved on machines (%1): complete or cancel them';
		|es = 'Hay vales de consumo de máquina abiertos o materiales reservados en las máquinas (%1): termínelos o cancélelos'");
	Возврат СтрШаблон(Шаблон, Выборка.Ссылка);

КонецФункции

// Вес номенклатуры в килограммах - одно правило для всей конфигурации. Единица номенклатуры весовая - количество
// умножается на её коэффициент к килограмму (числитель / знаменатель; нулевые - 1). Иначе - на вес единицы
// «ВесЗнаменатель» в весовой единице «ВесЕдиница» (её коэффициент к килограмму; пустая - килограмм). Позиции без
// веса в итог не входят и возвращаются списком.
//
// Параметры:
//  Таблица - ТаблицаЗначений, ТабличнаяЧасть - строки с колонками Номенклатура и Количество (в единице номенклатуры)
//
// Возвращаемое значение:
//  Структура:
//   * Вес    - Число - вес, кг
//   * БезВеса - Массив из СправочникСсылка.Номенклатура - позиции, у которых вес не задан
//
Функция ВесНоменклатурыКг(Таблица) Экспорт

	Результат = Новый Структура("Вес, БезВеса", 0, Новый Массив);
	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Строки.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Таблица Цикл
		Если ЗначениеЗаполнено(Строка.Номенклатура) И Строка.Количество <> 0 Тогда
			ЗаполнитьЗначенияСвойств(Строки.Добавить(), Строка, "Номенклатура, Количество");
		КонецЕсли;
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Строки.Номенклатура КАК Номенклатура,
	|	Строки.Количество КАК Количество
	|ПОМЕСТИТЬ ВТСтроки
	|ИЗ
	|	&Строки КАК Строки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСтроки.Номенклатура КАК Номенклатура,
	|	СУММА(ВТСтроки.Количество) КАК Количество,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Единицы.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Вес)
	|				ТОГДА ВЫБОР
	|						КОГДА Единицы.Числитель > 0
	|								И Единицы.Знаменатель > 0
	|							ТОГДА Единицы.Числитель / Единицы.Знаменатель
	|						ИНАЧЕ 1
	|					КОНЕЦ
	|			КОГДА Позиции.ВесЗнаменатель > 0
	|				ТОГДА Позиции.ВесЗнаменатель * ВЫБОР
	|						КОГДА ВесовыеЕдиницы.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Вес)
	|								И ВесовыеЕдиницы.Числитель > 0
	|								И ВесовыеЕдиницы.Знаменатель > 0
	|							ТОГДА ВесовыеЕдиницы.Числитель / ВесовыеЕдиницы.Знаменатель
	|						ИНАЧЕ 1
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КгНаЕдиницу
	|ИЗ
	|	ВТСтроки КАК ВТСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Позиции
	|		ПО ВТСтроки.Номенклатура = Позиции.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК Единицы
	|		ПО (Позиции.Единица = Единицы.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК ВесовыеЕдиницы
	|		ПО (Позиции.ВесЕдиница = ВесовыеЕдиницы.Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСтроки.Номенклатура";
	Запрос.УстановитьПараметр("Строки", Строки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.КгНаЕдиницу = 0 Тогда
			Результат.БезВеса.Добавить(Выборка.Номенклатура);
		Иначе
			Результат.Вес = Результат.Вес + Выборка.Количество * Выборка.КгНаЕдиницу;
		КонецЕсли;
	КонецЦикла;
	Результат.Вес = Окр(Результат.Вес, ЗнаковВеса());
	Возврат Результат;

КонецФункции

// Длительность загрузки станка: вес материалов, кг / выработка станка, кг/ч, плюс время на смену заказа - оно
// входит в начало каждой загрузки (переналадка под заказ), поэтому соседние загрузки всегда разделены им.
//
// Параметры:
//  Станок - СправочникСсылка.ПроизводственноеОборудование - станок
//  Вес    - Число - вес материалов загрузки, кг
//
// Возвращаемое значение:
//  Структура:
//   * Часы        - Число - длительность, ч, округлённая до сотых; 0 - посчитать нельзя
//   * ТекстОшибки - Строка - почему нельзя посчитать; пустая - посчитано
//
Функция ДлительностьЗагрузки(Станок, Вес) Экспорт

	Результат = Новый Структура("Часы, ТекстОшибки", 0, "");
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Станок, "Выработка, ВремяНаСменуЗаказа");
	Если Реквизиты.Выработка = Null Или Реквизиты.Выработка <= 0 Тогда
		Шаблон = НСтр("ru = 'У станка «%1» не задана выработка, кг/ч: время загрузки не посчитать';
			|fr = 'La cadence (kg/h) de la machine « %1 » n''est pas renseignée : la durée de charge ne peut pas être calculée';
			|en = 'Machine ""%1"" has no output rate, kg/h: the load time cannot be calculated';
			|es = 'La máquina «%1» no tiene rendimiento, kg/h: no se puede calcular el tiempo de carga'");
		Результат.ТекстОшибки = СтрШаблон(Шаблон, Станок);
		Возврат Результат;
	КонецЕсли;
	Если Вес <= 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Вес материалов загрузки нулевой: время загрузки не посчитать';
			|fr = 'Le poids des matières de la charge est nul : la durée de charge ne peut pas être calculée';
			|en = 'The weight of the load materials is zero: the load time cannot be calculated';
			|es = 'El peso de los materiales de la carga es cero: no se puede calcular el tiempo de carga'");
		Возврат Результат;
	КонецЕсли;
	Результат.Часы = ОкруглитьЧасы(Вес / Реквизиты.Выработка + Реквизиты.ВремяНаСменуЗаказа / МинутВЧасе());
	Возврат Результат;

КонецФункции

// Момент, когда станок отработает заданные часы, начиная с момента начала: часы раскладываются по рабочим интервалам
// режима станка и производственного календаря (смены через полночь, выходные). Начало вне смены - отсчёт с начала
// ближайшей смены. Интервалы читаются окнами по 31 дню на горизонте 366 дней.
//
// Параметры:
//  Станок - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало - Дата - момент начала
//  Часы   - Число - рабочие часы
//
// Возвращаемое значение:
//  Дата, Неопределено - момент окончания; Неопределено - часы не уложились в горизонт (нет режима или смен)
//
Функция ОкончаниеПоРежиму(Станок, Начало, Часы) Экспорт

	Осталось = Окр(Часы * СекундВЧасе(), 0);
	Если Осталось <= 0 Тогда
		Возврат Начало;
	КонецЕсли;
	Горизонт = Начало + ДнейГоризонтаОкончания() * СекундВСутках();
	Окно = Начало;
	Пока Окно < Горизонт Цикл
		КонецОкна = Мин(Окно + ДнейОкнаОкончания() * СекундВСутках(), Горизонт);
		Для Каждого Интервал Из ИнтервалыРаботыСтанка(Станок, Окно, КонецОкна) Цикл
			Длина = Интервал.Окончание - Интервал.Начало;
			Если Длина >= Осталось Тогда
				Возврат Интервал.Начало + Осталось;
			КонецЕсли;
			Осталось = Осталось - Длина;
		КонецЦикла;
		Окно = КонецОкна;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#Область ЗакладкаСтанков

// Шаг планирования загрузки станков (решение владельца 2026-10-08): начало загрузки при поиске окна и при
// перетаскивании на планировщике округляется до него вверх.
//
// Возвращаемое значение:
//  Число - минуты
//
Функция ШагПланированияМинут() Экспорт

	Возврат 15;

КонецФункции

// Момент, округлённый вверх до шага планирования.
//
// Параметры:
//  Момент - Дата - момент
//
// Возвращаемое значение:
//  Дата - момент, кратный шагу планирования; кратный остаётся как есть
//
Функция ОкруглитьДоШага(Момент) Экспорт

	Шаг = ШагСекунд();
	Остаток = (Момент - Дата(1, 1, 1)) % Шаг;
	Возврат ?(Остаток = 0, Момент, Момент + (Шаг - Остаток));

КонецФункции

// Часы в виде «ч:мм» для подписей закладки «Станки».
//
// Параметры:
//  Часы - Число - часы
//
// Возвращаемое значение:
//  Строка - например «6:15»
//
Функция ПредставлениеЧасов(Часы) Экспорт

	Минут = Окр(Часы * МинутВЧасе(), 0);
	Возврат Формат(Цел(Минут / МинутВЧасе()), "ЧН=0; ЧГ=0") + ":" + Формат(Минут % МинутВЧасе(), "ЧЦ=2; ЧН=00; ЧВН=");

КонецФункции

// Занятость станков за период: записи «Загрузки станков» обоих слоев (план и факт, работа и обслуживание) с данными
// документа. Затянувшаяся загрузка - факт требования в статусе «Запущено», расчётное окончание которого уже прошло, -
// продлевается до момента расчёта плюс шаг: станок занят, пока загрузку не завершат.
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//  Момент    - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Начало, Окончание, Регистратор, ВидЗаписи, План, Заказ, Вес, Статус (статус
//                    требования), Продукция, Количество, Текст (подпись элемента планировщика), Затянулась (Булево);
//                    упорядочена по станку и началу
//
Функция ЗанятостьСтанков(Станки, Начало, Окончание, Момент = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	// Затянувшаяся загрузка закончилась по расчёту до периода, но идёт - вторая часть объединения.
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстВыборкиЗанятости() + "
	|	И Загрузка.Окончание > &Начало
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|" + ТекстВыборкиЗанятости() + "
	|	И Загрузка.Окончание <= &Начало
	|	И НЕ Загрузка.План
	|	И Требования.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Станок,
	|	Начало";
	Запрос.УстановитьПараметр("Станки", Станки);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("Текст", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Затянулась", Новый ОписаниеТипов("Булево"));

	Продление = ОкруглитьДоШага(Момент + ШагСекунд());
	Запущено = Перечисления.СтатусыТребованийНакладных.Запущено;
	Удалить = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Если Строка.Статус = Запущено И Не Строка.План И Строка.Окончание <= Момент Тогда
			Строка.Окончание = Продление;
			Строка.Затянулась = Истина;
		КонецЕсли;
		Если Строка.Окончание <= Начало Тогда
			Удалить.Добавить(Строка);
			Продолжить;
		КонецЕсли;
		Строка.Текст = ТекстЗанятости(Строка);
	КонецЦикла;
	Для Каждого Строка Из Удалить Цикл
		Таблица.Удалить(Строка);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Ближайшее свободное окно станка для загрузки заданной длительности: начало не раньше заданного момента, округлённое
// вверх до шага и сдвинутое на начало ближайшей смены; часы раскладываются по рабочему времени тем же правилом, что
// ОкончаниеПоРежиму в проведении требования. Занятым считается всё - оба слоя, работа и обслуживание, затянувшаяся
// загрузка - по продлённому окончанию (правило сборки 1). Вызывать под блокировкой загрузки станка, если окно сразу
// занимается.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Часы      - Число - длительность загрузки, ч (см. ДлительностьЗагрузки)
//  НеРаньше  - Дата - самое раннее начало
//  Исключить - ДокументСсылка, Неопределено - регистратор, чьи записи не считаются занятостью (переносимый документ)
//  Момент    - Дата, Неопределено - момент расчёта: окно не начинается раньше него; Неопределено - текущая дата
//
// Возвращаемое значение:
//  Структура:
//   * Начало      - Дата, Неопределено - начало окна
//   * Окончание   - Дата, Неопределено - окончание окна
//   * Сдвинуто    - Булево - окно позже начала ближайшей смены от НеРаньше: то время занято
//   * ТекстОшибки - Строка - почему окна нет; пустая - найдено
//
Функция БлижайшееОкно(Станок, Часы, НеРаньше, Исключить = Неопределено, Момент = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Возврат ОкноВКонтексте(КонтекстОкна(Станок, НеРаньше, Момент), Часы, НеРаньше, Исключить);

КонецФункции

// Строки «Готовы к запуску» (решения владельца 2026-10-08): строки продукции заказов на производство в стадии
// «В производстве» и заказов ранних стадий («Заказ поставщику», «Восполнение потребности»), у которых материалов строки
// хватает на складе размещения (без резерва: кто первым запустит). Остаток строки - КВыпуску - Выпущено по ключу
// продукции за вычетом открытых требований: требования вычитаются из своей строки, остаток ключа разносится по строкам
// заказа по порядку. Продукция, переданная в переработку, не показывается. Вес - листья материалов строки на остаток,
// время - на выбранном станке.
//
// Параметры:
//  Станок - СправочникСсылка.ПроизводственноеОборудование - станок для расчёта времени; пустой - время не считается
//  Момент - Дата, Неопределено - момент расчёта ближайшего окна для признака просрочки; Неопределено - текущая дата
//  Склад  - СправочникСсылка.МестаХранения, Неопределено - склад размещения; Неопределено - склад пользователя
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Заказ, КодСтроки, НомерЗаказа, Клиент, ДатаОтгрузки, Номенклатура, Характеристика,
//                    Количество (строки заказа), Остаток, Вес (кг), Часы, ТекстОшибки, Просрочен, ИзСклада (материалы
//                    со свободного склада, а не под заказ); упорядочена по дате отгрузки (пустая - в конце), заказу и
//                    строке
//
Функция ГотовыеКЗапуску(Станок, Момент = Неопределено, Склад = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Готовые = СтрокиГотовых(Неопределено, Склад);
	РассчитатьВремяГотовых(Готовые, Станок, Момент);
	Готовые.Сортировать("БезДатыОтгрузки, ДатаОтгрузки, НомерЗаказа, КодСтроки");
	Возврат Готовые;

КонецФункции

// Состояние станков для списка закладки: что на станке сейчас, фонд и загрузка периода, ближайшее плановое
// обслуживание. Загрузка - объединение интервалов «Работа» плана и факта (с затянувшимися) в рабочем времени,
// делённое на фонд.
//
// Параметры:
//  Станки    - Массив из СправочникСсылка.ПроизводственноеОборудование - станки
//  Начало    - Дата - начало периода, включается
//  Окончание - Дата - конец периода, не включается
//  Момент    - Дата, Неопределено - «сейчас»; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Состояние (Строка), Требование, Фонд (ч), Работа (ч), Загрузка (%),
//                    БлижайшееОбслуживание (Дата; пустая - нет)
//
Функция СостояниеСтанков(Станки, Начало, Окончание, Момент = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Состояние = НоваяТаблицаСостояния();
	Интервалы = ИнтервалыРаботыСтанков(Станки, Начало, Окончание);
	Занятость = ЗанятостьСтанков(Станки, Начало, Окончание, Момент);
	Сейчас = ЗанятостьСтанков(Станки, Момент, Момент + 1, Момент);
	ИнтервалыСейчас = ИнтервалыРаботыСтанков(Станки, Момент, Момент + 1);
	Обслуживание = БлижайшееОбслуживание(Станки, Момент);
	Процентов = 100;
	Для Каждого Станок Из Станки Цикл
		Отбор = Новый Структура("Станок", Станок);
		ИнтервалыСтанка = Интервалы.НайтиСтроки(Отбор);
		Строка = Состояние.Добавить();
		Строка.Станок = Станок;
		Строка.Фонд = ОкруглитьЧасы(ЧасыИнтервалов(ИнтервалыСтанка));
		Строка.Работа = ОкруглитьЧасы(ЧасыРаботыВРабочееВремя(Занятость.НайтиСтроки(Отбор), ИнтервалыСтанка, Начало, Окончание));
		Строка.Загрузка = ?(Строка.Фонд = 0, 0, Окр(Строка.Работа / Строка.Фонд * Процентов, 0));
		Строка.БлижайшееОбслуживание = Обслуживание.Получить(Станок);
		ЗаполнитьСостояниеСейчас(Строка, Сейчас.НайтиСтроки(Отбор), ИнтервалыСейчас.НайтиСтроки(Отбор).Количество() > 0);
	КонецЦикла;
	Возврат Состояние;

КонецФункции

// «Разместить» с закладки «Станки»: новое требование-накладная по строке заказа на станок в ближайшее свободное окно
// или во время перетаскивания. Под блокировками проведения требования строка перепроверяется по «Готовым к запуску»
// (стадия, материалы, остаток строки) и ищется окно. Разбиение - количество меньше
// остатка строки: остаток размещается следующим вызовом.
//
// Параметры:
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  КодСтроки  - Число - КодСтроки строки продукции заказа
//  Количество - Число - количество продукции
//  Станок     - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало     - Дата, Неопределено - время перетаскивания; Неопределено - ближайшее окно
//  Момент     - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//  Склад      - СправочникСсылка.МестаХранения, Неопределено - склад-источник материалов; Неопределено - склад
//               пользователя
//
// Возвращаемое значение:
//  Структура:
//   * Требование  - ДокументСсылка.ТребованиеНакладная, Неопределено - размещённое требование
//   * ТекстОшибки - Строка - почему не размещено; пустая - размещено
//
Функция РазместитьСтроку(Заказ, КодСтроки, Количество, Станок, Начало = Неопределено, Момент = Неопределено,
	Склад = Неопределено) Экспорт

	Результат = Новый Структура("Требование, ТекстОшибки", Неопределено, "");
	Момент = МоментРасчета(Момент);
	Склад = ?(Склад = Неопределено, СкладРазмещения(), Склад);
	Результат.ТекстОшибки = ТекстЗапретаРазмещения(Количество, Начало, Момент);
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		Возврат Результат;
	КонецЕсли;
	Объект = Документы.ТребованиеНакладная.СоздатьДокумент();
	ДанныеЗаполнения = Новый Структура("Станок, Заказ", Станок, Заказ);
	ДанныеЗаполнения.Вставить("КодСтрокиПродукции", КодСтроки);
	ДанныеЗаполнения.Вставить("Количество", Количество);
	Объект.Заполнить(ДанныеЗаполнения);
	Объект.МестоХранения = Склад;
	Длительность = ДлительностьМатериалов(Станок, Объект.Материалы);
	Если ЗначениеЗаполнено(Длительность.ТекстОшибки) Тогда
		Результат.ТекстОшибки = Длительность.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	ПолучитьСообщенияПользователю(Истина);
	ТекстОшибки = "";
	НачатьТранзакцию();
	Попытка
		// Блокировки проведения требования в его порядке (загрузка станка - первой, потребности заказа - после
		// складских): остаток строки и окно перечитываются уже под ними, два размещения одной строки сериализуются.
		Блокировка = Новый БлокировкаДанных;
		ТребованияНакладные.ЗаполнитьБлокировкуПроведения(Объект, Блокировка);
		Блокировка.Заблокировать();
		ТекстОшибки = ТекстОстаткаСтроки(Заказ, КодСтроки, Количество, Склад);
		Если ПустаяСтрока(ТекстОшибки) Тогда
			Окно = БлижайшееОкно(Станок, Длительность.Часы, ?(Начало = Неопределено, Момент, Начало), , Момент);
			ТекстОшибки = ТекстОкна(Окно, Начало <> Неопределено);
		КонецЕсли;
		Если ПустаяСтрока(ТекстОшибки) Тогда
			Объект.ПланНачало = Окно.Начало;
			ТребованияНакладные.ВыполнитьДействие(Объект, "Разместить");
		КонецЕсли;
		// Без записи фиксируется пустая транзакция: откат вложенной сломал бы внешнюю (тест в транзакции).
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.ТекстОшибки = ТекстОшибкиЗаписи(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Результат.ТекстОшибки = ТекстОшибки;
	Иначе
		Результат.Требование = Объект.Ссылка;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Перенос загрузки перетаскиванием на планировщике: запланированное требование получает новый станок и начало
// (сдвинутое на начало смены и округлённое до шага) и перепроводится; документ обслуживания - новое время той же
// длительности. Под блокировкой загрузки станка план сверяется с фактической работой и обслуживанием станка: проведение
// план с фактом не сверяет (правило сборки 1), а ручной перенос на занятое время - ошибка. Пересечение плана с планом
// отклоняет само проведение.
//
// Параметры:
//  Регистратор - ДокументСсылка.ТребованиеНакладная, ДокументСсылка.ОбслуживаниеСтанка - документ элемента
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок строки, куда перетащили; пустой - прежний
//  Начало      - Дата - новое начало
//  Момент      - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - перенесено
//
Функция ПеренестиЗагрузку(Регистратор, Станок, Начало, Момент = Неопределено) Экспорт

	Момент = МоментРасчета(Момент);
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОбслуживаниеСтанка") Тогда
		Возврат ПеренестиОбслуживание(Регистратор, Станок, Начало, Момент);
	КонецЕсли;
	Если ТипЗнч(Регистратор) <> Тип("ДокументСсылка.ТребованиеНакладная") Тогда
		Возврат НСтр("ru = 'Этот элемент не переносится'; fr = 'Cet élément ne se déplace pas';
			|en = 'This item cannot be moved'; es = 'Este elemento no se puede mover'");
	КонецЕсли;
	Объект = Регистратор.ПолучитьОбъект();
	Если Объект.Статус <> Перечисления.СтатусыТребованийНакладных.Запланировано Тогда
		Возврат НСтр("ru = 'Переносится только запланированная загрузка: запущенную и завершённую правят в документе';
			|fr = 'Seule une charge planifiée se déplace : une charge lancée ou terminée se corrige dans le document';
			|en = 'Only a planned load can be moved: a started or completed load is edited in the document';
			|es = 'Solo se mueve una carga planificada: la iniciada o terminada se corrige en el documento'");
	КонецЕсли;
	ТекстОшибки = ТекстЗапретаПрошлого(Начало, Момент);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	Если ЗначениеЗаполнено(Станок) Тогда
		Объект.Станок = Станок;
	КонецЕсли;
	Длительность = ДлительностьМатериалов(Объект.Станок, Объект.Материалы);
	Если ЗначениеЗаполнено(Длительность.ТекстОшибки) Тогда
		Возврат Длительность.ТекстОшибки;
	КонецЕсли;

	ПолучитьСообщенияПользователю(Истина);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		УправляемыеБлокировки.ЗагрузкаСтанков(Блокировка, Объект.Станок);
		Блокировка.Заблокировать();
		ТекстОшибки = ТекстЗанятостиПереноса(Объект, Начало, Длительность.Часы, Момент);
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТребованияНакладные.ВыполнитьДействие(Объект, "Разместить");
		КонецЕсли;
		// Без записи фиксируется пустая транзакция: откат вложенной сломал бы внешнюю (тест в транзакции).
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ТекстОшибкиЗаписи(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат ТекстОшибки;

КонецФункции

// «Запустить», «Завершить» или «Отменить» требование с закладки «Станки». «Завершить» выпускает заданное количество
// (больше нуля), материалы расходуются как загружены (правка расхода - в форме требования).
//
// Параметры:
//  Требование     - ДокументСсылка.ТребованиеНакладная - требование
//  Действие       - Строка - «Запустить», «Завершить» или «Отменить»
//  КоличествоФакт - Число - выпущено при «Завершить»; для прочих действий не читается
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - выполнено
//
Функция ВыполнитьДействиеТребования(Требование, Действие, КоличествоФакт = 0) Экспорт

	Если Действие <> "Запустить" И Действие <> "Завершить" И Действие <> "Отменить" Тогда
		ВызватьИсключение СтрШаблон("Неизвестное действие закладки «Станки»: %1", Действие);
	КонецЕсли;
	Объект = Требование.ПолучитьОбъект();
	Если Действие = "Завершить" Тогда
		// Ноль ПодготовитьЗавершение заменил бы полным количеством требования: выпуск задаётся явно.
		Если КоличествоФакт <= 0 Тогда
			Возврат НСтр("ru = 'Укажите выпущенное количество больше нуля';
				|fr = 'Indiquez une quantité produite supérieure à zéro';
				|en = 'Specify a produced quantity greater than zero';
				|es = 'Indique una cantidad producida mayor que cero'");
		КонецЕсли;
		Объект.КоличествоФакт = КоличествоФакт;
	КонецЕсли;
	Возврат ЗаписатьДействие(Объект, Действие);

КонецФункции

