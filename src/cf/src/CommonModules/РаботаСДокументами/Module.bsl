#Область Платёжные_документы

Функция РазвернутьНДСПлатёжногоДокумента(ТЗОснования) Экспорт
	ТЗРезультат = Новый ТаблицаЗначений;
	ТЗРезультат.Колонки.Добавить("КодСтроки", Метаданные.ОпределяемыеТипы.КодСтроки.Тип);
	ТЗРезультат.Колонки.Добавить("Основание");
	ТЗРезультат.Колонки.Добавить("НазначениеПлатежа", Метаданные.ОпределяемыеТипы.Комментарий.Тип);
	ТЗРезультат.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	ТЗРезультат.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	ТЗРезультат.Колонки.Добавить("СуммаНДС", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	Для Каждого Стр Из ТЗОснования Цикл
		Если Стр.НесколькоСтавокНДС Тогда
			МасРасшифровкаНДС = ОбщегоНазначенияКлиентСервер.КонвертироватьИзJSON(Стр.РасшифровкаНДС, Ложь);
			Для Каждого МасСтр Из МасРасшифровкаНДС Цикл
				НС = ТЗРезультат.Добавить();
				ЗаполнитьЗначенияСвойств(НС, Стр,, "Сумма, СтавкаНДС, СуммаНДС");
                НС.Сумма = МасСтр.СуммаСНДС;
				НС.СтавкаНДС = XMLЗначение(Тип("СправочникСсылка.СтавкиНДС"), МасСтр.СтавкаНДС);
				НС.СуммаНДС = МасСтр.СуммаНДС;
				НС.НазначениеПлатежа = СокрЛП(НС.НазначениеПлатежа);
			КонецЦикла;	
		Иначе
			НС = ТЗРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Стр);
			НС.НазначениеПлатежа = СокрЛП(НС.НазначениеПлатежа);
		КонецЕсли;	
	КонецЦикла;
	ТЗРезультат.Свернуть("КодСтроки, Основание, СтавкаНДС, НазначениеПлатежа", "Сумма, СуммаНДС");
	Возврат ТЗРезультат;
КонецФункции

Функция КонвертироватьНДСПлатёжногоДокументаВМассив(ТЗ) Экспорт
	Мас = Новый Массив;
	Для Каждого Стр Из ТЗ Цикл
		Структура = Новый Структура;
		Структура.Вставить("СтавкаНДС", XMLСтрока(Стр.СтавкаНДС));
		Структура.Вставить("СуммаНДС", Стр.СуммаНДС);
		Структура.Вставить("СуммаСНДС", ?(РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Стр, "СуммаСНДС"), Стр.СуммаСНДС, Стр.Сумма));
		Мас.Добавить(Структура);		
	КонецЦикла;
	Возврат Мас;
КонецФункции

Процедура УстановитьВидимостьРеквизитовДенежногоДокумента(Форма) Экспорт
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	Элементы.МестоХранения.Видимость = Ложь;
	Если ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСФизическимиЛицами(Объект.ХозяйственнаяОперация) Тогда
		Элементы.Контрагент.Видимость = Истина;
		//Элементы.Договор.Видимость = Ложь;
		Элементы.Контрагент.Заголовок = Нстр("fr = 'Particulier'; ru = 'Физ. лицо'; en = 'Individual'; es = 'Persona física'");
		РаботаСДокументамиКлиентСервер.УстановитьТипЗначенияПоля(Элементы.Контрагент, Объект.Контрагент, Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ИначеЕсли ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыССобственнымиОрганизациями(Объект.ХозяйственнаяОперация) Тогда
		Элементы.Контрагент.Видимость = Ложь;
		//Элементы.Договор.Видимость = Истина;
		Элементы.Контрагент.Заголовок = Нстр("fr = 'Contreparties'; ru = 'Контрагент'; en = 'Counterparty'; es = 'Contraparte'");
		РаботаСДокументамиКлиентСервер.УстановитьТипЗначенияПоля(Элементы.Контрагент, Объект.Контрагент, Новый ОписаниеТипов("СправочникСсылка.Организации"));	
	Иначе
		Элементы.Контрагент.Видимость = Истина;
		//Элементы.Договор.Видимость = Истина;
		Элементы.Контрагент.Заголовок = Нстр("fr = 'Contreparties'; ru = 'Контрагент'; en = 'Counterparty'; es = 'Contraparte'");
		РаботаСДокументамиКлиентСервер.УстановитьТипЗначенияПоля(Элементы.Контрагент, Объект.Контрагент, Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти  

#Область Касса

Функция НайтиОткрытуюСмену(Касса = Неопределено) Экспорт
	Касса = ?(Касса = Неопределено, РегистрыСведений.НастройкиПользователей.КассаПользователя(),Касса);
	Смена = Документы.КассоваяСмена.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КассоваяСмена.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КассоваяСмена КАК КассоваяСмена
	|ГДЕ
	|	КассоваяСмена.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
	|	И КассоваяСмена.Касса = &Касса
	|
	|УПОРЯДОЧИТЬ ПО
	|	КассоваяСмена.Дата УБЫВ";
	Запрос.УстановитьПараметр("Касса",Касса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Смена = Выборка.Ссылка;
	КонецЕсли;
	ВОзврат Смена;
КонецФункции

Функция ПолучитьОстатокВКассе(Касса) Экспорт
	ОстатокВКассе = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДенежныеСредстваОрганизацийОстатки.СуммаОстаток КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваОрганизаций.Остатки(
	|			&ВыбДата,
	|			МестоХранения = &МестоХранения
	|				И ТипДенежныхСредств = ЗНАЧЕНИЕ(Справочник.TypesDePayment.Cash)) КАК ДенежныеСредстваОрганизацийОстатки";
	Запрос.УстановитьПараметр("МестоХранения",Касса);
	Запрос.УстановитьПараметр("ВыбДата",ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ОстатокВКассе = Выборка.СуммаОстаток;
	КонецЕсли;
	Возврат ОстатокВКассе;
КонецФункции

