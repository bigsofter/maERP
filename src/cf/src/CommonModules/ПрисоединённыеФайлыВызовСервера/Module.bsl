#Область Интерфейс

// Может ли пользователь открыть список присоединённых файлов (право просмотра регистра ПрисоединённыеФайлы).
// Общая команда «Файлы» документов сообщает об отказе сама, вместо платформенной ошибки формы списка.
//
// Возвращаемое значение:
//  Булево - Истина, если просмотр доступен.
//
Функция ДоступенПросмотрФайлов() Экспорт
	Возврат ПраваНаФайлы.ПравоПросмотраФайлов();
КонецФункции

Функция ПодготовитьФайлыДляПередачиНаКлиент(МасКлючи, ИдентификаторФормы) Экспорт
	Результат = Новый Массив;
	МасДанные = ПолучитьДанныеПоКлючам(МасКлючи);
	Для Каждого Запись Из МасДанные Цикл
		// Модуль привилегированный: файл отдаётся только тому, кто читает его владельца и видит список файлов
		// (docs/plans/kp-print-terms.md, docs/plans/document-files.md).
		Если Не ПраваНаФайлы.ПравоЧтенияФайловВладельца(Запись.Объект) Тогда
			Продолжить;
		КонецЕсли;
		Если Запись.Внешний Тогда
			Файл = Новый Файл(Запись.ДанныеФайла.ПолноеИмя);
			Если Не Файл.Существует() Тогда Продолжить КонецЕсли;
		КонецЕсли;
		Описание = Новый ОписаниеПередаваемогоФайла;
		Описание.Хранение = ?(Запись.Внешний, ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(Запись.ДанныеФайла.ПолноеИмя), ИдентификаторФормы), Запись.НавигационнаяСсылка);
		Описание.Имя = Запись.ИмяИсходное;
		Результат.Добавить(Описание);
	КонецЦикла;	
	Возврат Результат		
КонецФункции

Процедура ЗаписатьДанныеПрикреплённыхФайлов(Объект, Связь, ДанныеФайлов) Экспорт
	// До файловых операций: запись набора проверит владельца ещё раз, но файл на диске к тому времени уже был бы записан.
	ПраваНаФайлы.ПроверитьПравоИзмененияВладельца(Объект);
	ВнешнийФайл = Константы.ХранитьФайлыНаДиске.Получить();
	Для Каждого Стр Из ДанныеФайлов Цикл
		МЗ = РегистрыСведений.ПрисоединённыеФайлы.СоздатьМенеджерЗаписи();
		МЗ.Объект = Объект;
		Если ЗначениеЗаполнено(Связь) Тогда
			МЗ.Связь = Связь;
		КонецЕсли;
		МЗ.ID = Новый УникальныйИдентификатор;
		МЗ.ИмяФайла = Стр.ИмяФайла;
		МЗ.Внешний = ВнешнийФайл;
		МЗ.Расширение = Стр.Расширение;
		МЗ.Размер = Стр.Размер;
		// ID только что создан: проверка занятости не нужна (без запроса на каждый файл пакета).
		ПоместитьФайлВХранилище(МЗ, Стр.Адрес, Ложь);
		МЗ.Записать(Истина);
		УдалитьДанныеИзВременногоХранилища(Стр.Адрес);
	КонецЦикла;
КонецПроцедуры

// Кладёт файл из временного хранилища в запись регистра: в ресурс Данные или на диск.
//
// Параметры:
//  Менеджер - РегистрСведенийМенеджерЗаписи.ПрисоединённыеФайлы - запись (с клиента не передаётся: структура
//             вместо записи - отказ, иначе подменённый владелец с тем же UUID перезаписал бы чужой файл на диске).
//  Адрес    - Строка - адрес файла во временном хранилище.
//  ПроверятьID - Булево - отказать, если запись с тем же ID есть у другого владельца.
//
Процедура ПоместитьФайлВХранилище(Менеджер, Адрес, ПроверятьID = Истина) Экспорт
	Если Не ЭтоАдресВременногоХранилища(Адрес) Тогда Возврат КонецЕсли; 
	// BSLLS:YoLetterUsage-off - имя регистра в метаданных.
	Если ТипЗнч(Менеджер) <> Тип("РегистрСведенийМенеджерЗаписи.ПрисоединённыеФайлы") Тогда
	// BSLLS:YoLetterUsage-on
		ВызватьИсключение НСтр("ru = 'Файл помещается только в запись регистра файлов';
			|fr = 'Le fichier ne peut être placé que dans un enregistrement du registre des fichiers';
			|en = 'A file can only be placed into a file register record';
			|es = 'El archivo solo se puede colocar en un registro del registro de archivos'");
	КонецЕсли;
	ПраваНаФайлы.ПроверитьПравоИзмененияВладельца(Менеджер.Объект);
	Если ПроверятьID И ВладелецЗаписиДругой(Менеджер.ID, Менеджер.Объект) Тогда
		ВызватьИсключение НСтр("ru = 'Идентификатор файла занят файлом другого объекта';
			|fr = 'L''identifiant du fichier est déjà utilisé par un fichier d''un autre objet';
			|en = 'The file ID is already used by a file of another object';
			|es = 'El identificador del archivo ya lo usa un archivo de otro objeto'");
	КонецЕсли;
	ДД = ПолучитьИзВременногоХранилища(Адрес);
	Если Менеджер.Внешний Тогда
		Структура = СформироватьИмяФайлаНаДиске(Менеджер);
		УдалитьФайлы(Структура.Каталог, Структура.ИмяБезРасширения + ".*");
		ДД.Записать(Структура.ПолноеИмя);	
	Иначе	
		Менеджер.Данные = Новый ХранилищеЗначения(ДД, Новый СжатиеДанных(9));
	КонецЕсли;
КонецПроцедуры 

Процедура УдалитьДанныеИзВременногоХранилища(Адрес) Экспорт
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
        УдалитьИзВременногоХранилища(Адрес);
	КонецЕсли;
	Адрес = "";	
КонецПроцедуры

// Удаляет с диска файлы записей, которых в регистре уже нет (вызывается после удаления записей). Путь вычисляется на
// сервере по владельцу и ID ключа - пути с клиента не принимаются; файл живой записи и файлы владельца, которые
// пользователь не может менять, не трогаются.
//
// Параметры:
//  Ключи - Массив из РегистрСведенийКлючЗаписи.ПрисоединённыеФайлы - ключи удалённых записей.
//
// Возвращаемое значение:
//  Массив из Тип - типы владельцев, файлы которых удалены (для оповещения форм).
//
Функция УдалитьФайлыУдалённыхЗаписей(Знач Ключи) Экспорт
	ТипыВладельцев = Новый Массив;
	КаталогХранения = Константы.КаталогХраненияФайлов.Получить();
	Для Каждого Ключ Из Ключи Цикл
		Если Не ФайлУдалённойЗаписиМожноУдалить(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Если ТипыВладельцев.Найти(ТипЗнч(Ключ.Объект)) = Неопределено Тогда
			ТипыВладельцев.Добавить(ТипЗнч(Ключ.Объект));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(КаталогХранения) Тогда
			Продолжить;
		КонецЕсли;
		Структура = СформироватьИмяФайлаНаДиске(Новый Структура("Объект, ID, Расширение", Ключ.Объект, Ключ.ID, ""), Ложь);
		Каталог = Новый Файл(Структура.Каталог);
		Если Каталог.Существует() Тогда
			УдалитьФайлы(Структура.Каталог, Структура.ИмяБезРасширения + ".*");
		КонецЕсли;
	КонецЦикла;
	Возврат ТипыВладельцев;
КонецФункции

#КонецОбласти

#Область Дополнительно

Функция ПолучитьДанныеПоКлючу(Знач Ключ)
	Если ТипЗнч(Ключ) = Тип("Структура") Тогда
		Ключ = РегистрыСведений.ПрисоединённыеФайлы.СоздатьКлючЗаписи(Ключ);	
	КонецЕсли;	
	МЗ = РегистрыСведений.ПрисоединённыеФайлы.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МЗ, Ключ);
	МЗ.Прочитать();
	Результат = Новый Структура("Объект, ИмяФайла, ID, Внешний, Комментарий, Размер, Расширение");
	ЗаполнитьЗначенияСвойств(Результат, МЗ);
	Результат.Вставить("ИмяИсходное", МЗ.ИмяФайла + "." + МЗ.Расширение);
	Результат.Вставить("ДанныеФайла", ?(МЗ.Внешний, СформироватьИмяФайлаНаДиске(Результат), Неопределено));
	Результат.Вставить("НавигационнаяСсылка", ?(МЗ.Внешний, Неопределено, ПолучитьНавигационнуюСсылку(Ключ, "Данные")));
	Возврат Результат;		
КонецФункции

Функция ФайлУдалённойЗаписиМожноУдалить(Ключ)
	Если ТипЗнч(Ключ) <> Тип("РегистрСведенийКлючЗаписи.ПрисоединённыеФайлы") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Ключ.Объект) Или Не ЗначениеЗаполнено(Ключ.ID) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПраваНаФайлы.ПравоИзмененияВладельца(Ключ.Объект) И Не ЗаписьСуществует(Ключ.ID);
КонецФункции

// Есть ли живая запись с этим ID у другого владельца (каталог на диске - только UUID владельца).
//
// Параметры:
//  ID       - УникальныйИдентификатор - идентификатор файла.
//  Владелец - ОпределяемыйТип.ВладельцыПрисоединенныхФайлов - владелец записываемого файла.
//
// Возвращаемое значение:
//  Булево - Истина, если ID занят файлом другого владельца.
//
Функция ВладелецЗаписиДругой(ID, Владелец)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Найдено
	|ИЗ
	|	РегистрСведений.ПрисоединённыеФайлы КАК Файлы
	|ГДЕ
	|	Файлы.ID = &ID
	|	И Файлы.Объект <> &Владелец");
	Запрос.УстановитьПараметр("ID", ID);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Есть ли в регистре запись с этим ID у любого владельца. Не по владельцу ключа: каталог на диске - только UUID
// владельца, и ссылка другого типа с тем же UUID не должна выдать файл живой записи за удалённый.
//
// Параметры:
//  ID - УникальныйИдентификатор - идентификатор файла.
//
// Возвращаемое значение:
//  Булево - Истина, если запись есть.
//
Функция ЗаписьСуществует(ID)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Найдено
	|ИЗ
	|	РегистрСведений.ПрисоединённыеФайлы КАК Файлы
	|ГДЕ
	|	Файлы.ID = &ID");
	Запрос.УстановитьПараметр("ID", ID);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Функция ПолучитьДанныеПоКлючам(МасКлючи)
	Результат = Новый Массив;
	Для Каждого Ключ Из МасКлючи Цикл		
		Результат.Добавить(ПолучитьДанныеПоКлючу(Ключ));	
	КонецЦикла;	
	Возврат Результат
КонецФункции

Функция СформироватьИмяФайлаНаДиске(Знач Запись, СоздатьКаталог = Истина)
	Результат = Новый Структура;
	Результат.Вставить("Каталог", Константы.КаталогХраненияФайлов.Получить() + "\" + Запись.Объект.УникальныйИдентификатор()); 
	КаталогНаДиске = Новый Файл(Результат.Каталог);
	Если СоздатьКаталог И Не КаталогНаДиске.Существует() Тогда
		СоздатьКаталог(Результат.Каталог);	
	КонецЕсли;
	Результат.Вставить("ИмяБезРасширения", СокрЛП(Запись.ID));
	Результат.Вставить("Расширение", Запись.Расширение);
	Результат.Вставить("Имя", Результат.ИмяБезРасширения + "." + Результат.Расширение);
	Результат.Вставить("ПолноеИмя", Результат.Каталог + "\" + Результат.Имя);
	Возврат Результат;
КонецФункции

#КонецОбласти
