	Мас = Справочники.СтатьиДвиженияДенежныхСредств.ПолучитьПоХозяйственнойОперации(ХозяйственнаяОперация);
	Возврат ?(Мас.Количество() = 0, Неопределено, Мас[0]);	
КонецФункции

Функция ПолучитьНоменклатуруПоШтрихкоду(Штрихкод, ЕстьСерия = Истина) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	                      |	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
	                      |	ШтрихкодыНоменклатуры.Серия КАК Серия
	                      |ИЗ
	                      |	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	                      |ГДЕ
	                      |	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод");
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Рез = Запрос.Выполнить();
	Если Не Рез.Пустой() Тогда
		ТЗ = Рез.Выгрузить();
		Структура = Новый Структура("Номенклатура,Характеристика");
		Если ЕстьСерия Тогда 
			Структура.Вставить("Серия");
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Структура,ТЗ[0]);
		Возврат Структура;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
КонецФункции
	
#КонецОбласти

#Область Отчёты

Функция УстановитьНастройкиОтчёта(ТипОтчета, СтруктураПараметры, СтруктураОтбор) Экспорт
    ОтчетОбъект = Отчеты[ТипОтчета].Создать();    
	КомпоновщикНастроек = ОтчетОбъект.КомпоновщикНастроек;
    Настройки = КомпоновщикНастроек.Настройки;
	ПользовательскиеНастройки = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки;
	// Параметры
	Для Каждого Эл Из СтруктураПараметры Цикл
        Для Каждого ПараметрСКД Из ПользовательскиеНастройки.Элементы Цикл
            Если ТипЗнч(ПараметрСКД) <> Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда Продолжить КонецЕсли;  
            Если Строка(ПараметрСКД.Параметр) <> Эл.Ключ Тогда Продолжить КонецЕсли; 
            ПараметрСКД.Значение = Эл.Значение;
            ПараметрСКД.Использование = Истина;
        КонецЦикла;    
	КонецЦикла;
	// Отбор
	Для Каждого Эл Из СтруктураОтбор Цикл        
       	Отбор = Новый ПолеКомпоновкиДанных(Эл.Ключ);
		Для Каждого ЭлементНастройки Из Настройки.Отбор.Элементы Цикл
			Если ЭлементНастройки.ЛевоеЗначение <> Отбор Тогда Продолжить КонецЕсли; 
			Если ТипЗнч(Эл.Значение) = Тип("Массив") Тогда
				СЗ = Новый СписокЗначений;
				СЗ.ЗагрузитьЗначения(Эл.Значение);
				ЭлементНастройки.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии;
				ЭлементНастройки.ПравоеЗначение = СЗ; 
			Иначе
				ЭлементНастройки.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				ЭлементНастройки.ПравоеЗначение = Эл.Значение;	
			КонецЕсли;			
			ЭлементНастройки.Использование = Истина;
			Если ЗначениеЗаполнено(ЭлементНастройки.ИдентификаторПользовательскойНастройки) Тогда
				ПользовательскийПараметр = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭлементНастройки.ИдентификаторПользовательскойНастройки);
				Если ТипЗнч(ПользовательскийПараметр) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
					ПользовательскийПараметр.ВидСравнения = ЭлементНастройки.ВидСравнения;
					ПользовательскийПараметр.ПравоеЗначение = ЭлементНастройки.ПравоеЗначение;
					ПользовательскийПараметр.Использование = ЭлементНастройки.Использование;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;        
	КонецЦикла;
    Возврат ПользовательскиеНастройки;
КонецФункции

