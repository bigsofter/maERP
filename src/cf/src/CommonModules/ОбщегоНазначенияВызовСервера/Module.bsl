// Сохраняет параметры клиента в параметре сеанса ПараметрыКлиентаНаСервере. Идентификатор рабочего места и имя
// компьютера фиксируются при первом вызове в сеансе: повторный вызов их не меняет, поэтому серверные функции
// рабочих мест (Справочники.РабочиеМеста.ИдентификаторТекущегоКлиента) не принимают чужой идентификатор.
//
// Параметры:
//  Параметры - Структура - параметры клиента (УстановитьПараметрыСеансаКлиента модуля управляемого приложения)
//
Процедура УстановкаПараметровСеансаКлиентаНаСервере(Параметры) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Новые = Новый Структура;
	Для Каждого КлючИЗначение Из Параметры Цикл
		Новые.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Прежние = ПараметрыСеанса.ПараметрыКлиентаНаСервере;
	Для Каждого Имя Из СтрРазделить("ИдентификаторРабочегоМеста,ИмяКомпьютера", ",") Цикл
		Значение = Неопределено;
		Если Прежние.Свойство(Имя, Значение) И ЗначениеЗаполнено(Значение) Тогда
			Новые.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;
	ПараметрыСеанса.ПараметрыКлиентаНаСервере = Новый ФиксированнаяСтруктура(Новые);
КонецПроцедуры	

