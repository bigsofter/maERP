
#Область Справочники

Функция ПолучитьДанныеОрганизации(Организация) Экспорт	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	БанковскиеСчета.Владелец КАК Организация,
	                      |	БанковскиеСчета.Ссылка КАК БанковскийСчёт
	                      |ПОМЕСТИТЬ ВТБанковскиеСчета
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		БанковскиеСчета.Владелец КАК Владелец,
	                      |		МАКСИМУМ(БанковскиеСчета.Основной) КАК Основной
	                      |	ИЗ
	                      |		Справочник.БанковскиеСчета КАК БанковскиеСчета
	                      |	ГДЕ
	                      |		БанковскиеСчета.Владелец = &Организация
	                      |		И НЕ БанковскиеСчета.ПометкаУдаления
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		БанковскиеСчета.Владелец) КАК ВЗ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
	                      |		ПО ВЗ.Владелец = БанковскиеСчета.Владелец
	                      |			И ВЗ.Основной = БанковскиеСчета.Основной
	                      |			И (НЕ БанковскиеСчета.ПометкаУдаления)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Кассы.Владелец КАК Организация,
	                      |	Кассы.Ссылка КАК Касса
	                      |ПОМЕСТИТЬ ВТКассы
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		Кассы.Владелец КАК Владелец,
	                      |		МАКСИМУМ(Кассы.Основная) КАК Основная
	                      |	ИЗ
	                      |		Справочник.Кассы КАК Кассы
	                      |	ГДЕ
	                      |		Кассы.Владелец = &Организация
	                      |		И НЕ Кассы.ПометкаУдаления
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		Кассы.Владелец) КАК ВЗ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Кассы КАК Кассы
	                      |		ПО ВЗ.Владелец = Кассы.Владелец
	                      |			И ВЗ.Основная = Кассы.Основная
	                      |			И (НЕ Кассы.ПометкаУдаления)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Организации.Ссылка КАК Организация,
	                      |	ЕСТЬNULL(ВТБанковскиеСчета.БанковскийСчёт, ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)) КАК БанковскийСчёт,
	                      |	ЕСТЬNULL(ВТКассы.Касса, ЗНАЧЕНИЕ(Справочник.Кассы.ПустаяСсылка)) КАК Касса
	                      |ИЗ
	                      |	Справочник.Организации КАК Организации
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТБанковскиеСчета КАК ВТБанковскиеСчета
	                      |		ПО Организации.Ссылка = ВТБанковскиеСчета.Организация
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТКассы КАК ВТКассы
	                      |		ПО Организации.Ссылка = ВТКассы.Организация
	                      |ГДЕ
	                      |	Организации.Ссылка = &Организация");
	Запрос.УстановитьПараметр("Организация", Организация);
	Результат = Новый Структура("БанковскийСчёт, Касса");
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выб);	
	КонецЕсли;	
	Возврат Результат;
КонецФункции	

Функция ПолучитьДанныеКонтрагента(Контрагент, Организация, ВидДоговора, ДатаСреза) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫБОР
	                      |		КОГДА Контрагенты.Родитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	                      |			ТОГДА Контрагенты.Ссылка
	                      |		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ОбособленноеПодразделение)
	                      |			ТОГДА Контрагенты.Родитель
	                      |		ИНАЧЕ Контрагенты.Ссылка
	                      |	КОНЕЦ КАК Контрагент
	                      |ПОМЕСТИТЬ ВТКонтрагент
	                      |ИЗ
	                      |	Справочник.Контрагенты КАК Контрагенты
	                      |ГДЕ
	                      |	Контрагенты.Ссылка = &Контрагент
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТКонтрагент.Контрагент КАК Контрагент,
	                      |	ЕСТЬNULL(БанковскиеСчета.Ссылка, ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)) КАК БанковскийСчёт,
	                      |	ЕСТЬNULL(БанковскиеСчета.Основной, ЛОЖЬ) КАК Основной
	                      |ПОМЕСТИТЬ ВТБанковскиеСчетаВсе
	                      |ИЗ
	                      |	ВТКонтрагент КАК ВТКонтрагент
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
	                      |		ПО ВТКонтрагент.Контрагент = БанковскиеСчета.Владелец
	                      |			И (НЕ БанковскиеСчета.ПометкаУдаления)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ВТБанковскиеСчетаВсе.Контрагент КАК Контрагент,
	                      |	ВТБанковскиеСчетаВсе.БанковскийСчёт КАК БанковскийСчёт
	                      |ПОМЕСТИТЬ ВТБанковскиеСчета
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТБанковскиеСчетаВсе.Контрагент КАК Контрагент,
	                      |		МАКСИМУМ(ВТБанковскиеСчетаВсе.Основной) КАК Основной
	                      |	ИЗ
	                      |		ВТБанковскиеСчетаВсе КАК ВТБанковскиеСчетаВсе
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		ВТБанковскиеСчетаВсе.Контрагент) КАК ВЗ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТБанковскиеСчетаВсе КАК ВТБанковскиеСчетаВсе
	                      |		ПО ВЗ.Контрагент = ВТБанковскиеСчетаВсе.Контрагент
	                      |			И ВЗ.Основной = ВТБанковскиеСчетаВсе.Основной
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТКонтрагент.Контрагент КАК Контрагент,
	                      |	ЕСТЬNULL(ДоговорыСКонтрагентами.Ссылка, ЗНАЧЕНИЕ(Справочник.ДоговорыСКонтрагентами.ПУстаяСсылка)) КАК Договор,
	                      |	ЕСТЬNULL(ДоговорыСКонтрагентами.Основной, ЛОЖЬ) КАК Основной
	                      |ПОМЕСТИТЬ ВТДоговорыСКонтрагентамиВсе
	                      |ИЗ
	                      |	ВТКонтрагент КАК ВТКонтрагент
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыСКонтрагентами КАК ДоговорыСКонтрагентами
	                      |		ПО ВТКонтрагент.Контрагент = ДоговорыСКонтрагентами.Контрагент
	                      |			И (ДоговорыСКонтрагентами.Организация = &Организация)
	                      |			И (НЕ ДоговорыСКонтрагентами.ПометкаУдаления)
	                      |			И (ДоговорыСКонтрагентами.ВидДоговора = &ВидДоговора)
	                      |			И (ДоговорыСКонтрагентами.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует))
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ВТДоговорыСКонтрагентамиВсе.Контрагент КАК Контрагент,
	                      |	ВТДоговорыСКонтрагентамиВсе.Договор КАК Договор,
	                      |	ЕСТЬNULL(КураторыДоговоровСрезПоследних.Куратор, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК Менеджер
	                      |ПОМЕСТИТЬ ВТДоговорыСКонтрагентами
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТДоговорыСКонтрагентамиВсе.Контрагент КАК Контрагент,
	                      |		МАКСИМУМ(ВТДоговорыСКонтрагентамиВсе.Основной) КАК Основной
	                      |	ИЗ
	                      |		ВТДоговорыСКонтрагентамиВсе КАК ВТДоговорыСКонтрагентамиВсе
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		ВТДоговорыСКонтрагентамиВсе.Контрагент) КАК ВЗ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТДоговорыСКонтрагентамиВсе КАК ВТДоговорыСКонтрагентамиВсе
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КураторыДоговоров.СрезПоследних(
	                      |					&ДатаСреза,
	                      |					Договор В
	                      |						(ВЫБРАТЬ
	                      |							ВТДоговоры.Договор КАК Договор
	                      |						ИЗ
	                      |							ВТДоговорыСКонтрагентамиВсе КАК ВТДоговоры)) КАК КураторыДоговоровСрезПоследних
	                      |			ПО ВТДоговорыСКонтрагентамиВсе.Договор = КураторыДоговоровСрезПоследних.Договор
	                      |		ПО ВЗ.Контрагент = ВТДоговорыСКонтрагентамиВсе.Контрагент
	                      |			И ВЗ.Основной = ВТДоговорыСКонтрагентамиВсе.Основной
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТКонтрагент.Контрагент КАК Контрагент,
	                      |	ВТБанковскиеСчета.БанковскийСчёт КАК БанковскийСчёт,
	                      |	ВТДоговорыСКонтрагентами.Договор КАК Договор,
	                      |	ВЫБОР
	                      |		КОГДА ВТКонтрагент.Контрагент.ТипЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	                      |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЦен.Розничная)
	                      |		ИНАЧЕ ВТКонтрагент.Контрагент.ТипЦены
	                      |	КОНЕЦ КАК ВидЦены,
	                      |	ВТДоговорыСКонтрагентами.Менеджер КАК Менеджер,
	                      |	ВЫБОР
	                      |		КОГДА ВТКонтрагент.Контрагент.ТипЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	                      |			ТОГДА ИСТИНА
	                      |		ИНАЧЕ ВТКонтрагент.Контрагент.ТипЦены.ЦенаВключаетНДС
	                      |	КОНЕЦ КАК ЦенаВключаетНДС
	                      |ИЗ
	                      |	ВТКонтрагент КАК ВТКонтрагент
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТБанковскиеСчета КАК ВТБанковскиеСчета
	                      |		ПО ВТКонтрагент.Контрагент = ВТБанковскиеСчета.Контрагент
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТДоговорыСКонтрагентами КАК ВТДоговорыСКонтрагентами
	                      |		ПО ВТКонтрагент.Контрагент = ВТДоговорыСКонтрагентами.Контрагент");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	Результат = Новый Структура("Контрагент, Договор, БанковскийСчёт, Менеджер, ВидЦены, ЦенаВключаетНДС");
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выб);	
	КонецЕсли;	
	Возврат Результат;
КонецФункции

Функция ПолучитьОсновнойДоговор(Контрагент, Организация, Покупатель) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ДоговорыСКонтрагентами.Ссылка КАК Ссылка,
	                      |	ДоговорыСКонтрагентами.Основной КАК Основной
	                      |ИЗ
	                      |	Справочник.ДоговорыСКонтрагентами КАК ДоговорыСКонтрагентами
	                      |ГДЕ
	                      |	ДоговорыСКонтрагентами.Контрагент = &Контрагент
	                      |	И ДоговорыСКонтрагентами.Организация = &Организация
	                      |	И ВЫБОР
	                      |			КОГДА &Покупатель = ИСТИНА
	                      |				ТОГДА ДоговорыСКонтрагентами.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СПокупателем)
	                      |			ИНАЧЕ ДоговорыСКонтрагентами.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СПоставщиком)
	                      |		КОНЕЦ
	                      |	И НЕ ДоговорыСКонтрагентами.ПометкаУдаления
	                      |	И ДоговорыСКонтрагентами.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Основной УБЫВ");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Покупатель", Покупатель);
	Рез = Запрос.Выполнить();
	Возврат ?(Рез.Пустой(), Справочники.ДоговорыСКонтрагентами.ПустаяСсылка(), Рез.Выгрузить()[0].Ссылка);
КонецФункции

// Заполняет в структуре строки документа реквизиты номенклатуры, цену и остаток.
//
// Параметры:
//  Стр - Структура - строка документа (см. РаботаСДокументамиКлиентСервер.ПреобразоватьСтрокуТаблицыВСтруктуру);
//        заполняются только имеющиеся свойства: СтавкаНДС, ТоварнаяГруппа, Единица, Упаковка, Цена, Остаток.
//  БезЦен - Булево - Истина: цену не получать.
//  ЦенаВключаетНДС - Булево - признак цены с НДС для расчёта цены.
//  ПолучитьОстаток - Булево - Истина: при наличии свойства Остаток заполнить его остатком по складу
//                    из свойства МестоХранения (пустой: склад пользователя).
//
Процедура ПолучитьДанныеНоменклатуры(Стр, БезЦен = Ложь, ЦенаВключаетНДС = Истина, ПолучитьОстаток = Ложь) Экспорт
	// Право на остатки - до привилегированного режима: в нём ПравоДоступа отвечает «да» любой роли.
	ЕстьПравоНаОстатки = ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ТоварыВНаличии);
	УстановитьПривилегированныйРежим(Истина);
	ЕстьСтавкаНДС = Стр.Свойство("СтавкаНДС");
	ЕстьТоварнаяГруппа = Стр.Свойство("ТоварнаяГруппа");
	ЕстьЦена = Стр.Свойство("Цена");
	ЕстьЕдиница = Стр.Свойство("Единица");
	ЕстьУпаковка = Стр.Свойство("Упаковка");
	//
	//Если ЕстьСтавкаНДС Или ЕстьТоварнаяГруппа Тогда	
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	Спр.Ссылка КАК Номенклатура,
		                      |	Спр.СтавкаНДС КАК СтавкаНДС,
		                      |	Спр.ТоварнаяГруппа КАК ТоварнаяГруппа,
		                      |	Спр.Единица КАК Единица
		                      |ИЗ
		                      |	Справочник.Номенклатура КАК Спр
		                      |ГДЕ
		                      |	Спр.Ссылка = &Номенклатура");
		Запрос.УстановитьПараметр("Номенклатура", Стр.Номенклатура);
		Выб = Запрос.Выполнить().Выбрать();
		Если Выб.Следующий() Тогда	
			Если ЕстьСтавкаНДС Тогда
				Стр.СтавкаНДС = Выб.СтавкаНДС;
			КонецЕсли;
			Если ЕстьТоварнаяГруппа Тогда
				Стр.ТоварнаяГруппа = Выб.ТоварнаяГруппа;
			КонецЕсли;
			Если ЕстьЕдиница Тогда
				Стр.Единица = Выб.Единица;
			КонецЕсли;
			Если ЕстьУпаковка Тогда
				Стр.Упаковка = Выб.Единица;
			КонецЕсли;
		КонецЕсли;
	//КонецЕсли;
	СЦеной = ЕстьЦена И Не БезЦен;
	Если СЦеной Тогда
		ПолучитьЦенуНоменклатуры(Стр, ,ЦенаВключаетНДС);
	КонецЕсли;
	// Без цены - только ставка зоны (docs/plans/vat-zones.md, п. 1); с ценой её ставит ПолучитьЦенуНоменклатуры.
	УстановитьСтавкуЗоныБезЦены(Стр, СЦеной Или Не ЕстьСтавкаНДС);
	Если ПолучитьОстаток И Стр.Свойство("Остаток") Тогда
		ЗаполнитьОстатокСтроки(Стр, ЕстьПравоНаОстатки);
	КонецЕсли;
КонецПроцедуры

// Ставка освобождённой зоны покупателя строке, цену которой не получали (docs/plans/vat-zones.md, п. 1).
//
// Параметры:
//  Стр        - Структура - строка документа (см. РаботаСДокументамиКлиентСервер.ПреобразоватьСтрокуТаблицыВСтруктуру).
//  Пропустить - Булево - Истина: ставку не трогать (цену получали или ставки у строки нет).
//
Процедура УстановитьСтавкуЗоныБезЦены(Стр, Пропустить)
	Если Пропустить Тогда
		Возврат;
	КонецЕсли;
	ЗонаНДС = ДанныеЗоныНДССтроки(Стр, Неопределено);
	Если ЗонаНДС <> Неопределено Тогда
		Стр.СтавкаНДС = ЗонаНДС.СтавкаЗоны;
	КонецЕсли;
КонецПроцедуры

// Заполняет свойство Остаток строки остатком по складу строки или, если он не указан, по складу пользователя.
//
// Параметры:
//  Стр - Структура - строка документа со свойствами Номенклатура, Остаток и, возможно,
//        МестоХранения и Характеристика.
//  ЕстьПравоНаОстатки - Булево - право пользователя на чтение физических остатков, проверенное до привилегированного
//                       режима; без него остаток - 0.
//
Процедура ЗаполнитьОстатокСтроки(Стр, ЕстьПравоНаОстатки)
	Если Не ЕстьПравоНаОстатки Тогда
		Стр.Остаток = 0;
		Возврат;
	КонецЕсли;
	МестоХранения = ?(Стр.Свойство("МестоХранения"), Стр.МестоХранения, Неопределено);
	Если Не ЗначениеЗаполнено(МестоХранения) Тогда
		МестоХранения = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	КонецЕсли;
	Характеристика = ?(Стр.Свойство("Характеристика"), Стр.Характеристика, Неопределено);
	Стр.Остаток = РегистрыНакопления.ТоварыВНаличии.ПолучитьОстатокПоТовару(МестоХранения, Стр.Номенклатура, Характеристика);
КонецПроцедуры

Процедура ПолучитьДанныеНоменклатурыКонтрагента(Стр, Знач ТЗЦены = Неопределено) Экспорт
	НоменклатураКонтрагента = Стр.НоменклатураКонтрагента; 
	Стр.Номенклатура = НоменклатураКонтрагента.Номенклатура;
	Стр.Характеристика = НоменклатураКонтрагента.Характеристика;
	Стр.Упаковка = НоменклатураКонтрагента.Упаковка;
КонецПроцедуры

// Подставляет в строку документа цену: фиксированная цена контрагента (регистры ЦеныЗакупки/ЦеныПродажи),
// иначе прайс (для покупателей - по виду цен, с динамическим расчётом от последнего прихода или
// себестоимости; для поставщиков - последний прайс поставщика). Цена приводится к режиму НДС документа
// и к валюте документа: прайс вида цен - из валюты вида цен, остальные цены - из основной валюты.
//
// Параметры:
//  Стр - Структура - строка документа (см. ПреобразоватьСтрокуТаблицыВСтруктуру): Номенклатура, Характеристика,
//        Упаковка, СтавкаНДС, Цена и, возможно, ВидЦены, Поставщик, Контрагент, ДатаЦены, ЦенаSKU,
//        ЦенаРозничная, ЦенаМинимальная, ЦенаПоТипуЦен.
//  ТЗПоследнийПрайс - ТаблицаЗначений, Неопределено - готовый срез цен (см. ЦеныНоменклатуры.ПоследнийПрайс).
//  ЦенаВключаетНДС - Булево - режим цен документа.
//  ДанныеЦен - Структура, Неопределено - заготовленные данные для табличной части (см. ДанныеЦенДляСписка):
//        Фиксированные, ПоследнийПриход, Себестоимость и, возможно, ВалютаДокумента - Структура Валюта, Курс, Дата
//        документа в валюте. Без неё валюта документа - из свойств строки ВалютаДокумента и КурсДокумента
//        (см. ПреобразоватьСтрокуТаблицыВСтруктуру), без них - основная валюта.
//
Процедура ПолучитьЦенуНоменклатуры(Стр, Знач ТЗПоследнийПрайс = Неопределено, ЦенаВключаетНДС = Истина,
	Знач ДанныеЦен = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ЦенаПрайсаСНДС = Истина;
	ВалютаЦены = Неопределено; // основная
	ВалютаДокумента = Неопределено;
	Если ДанныеЦен <> Неопределено Тогда
		ДанныеЦен.Свойство("ВалютаДокумента", ВалютаДокумента);
	КонецЕсли;
	// Продажа покупателю освобождённой зоны (docs/plans/vat-zones.md, п. 1): прайс считается по ставке номенклатуры,
	// ставка зоны ставится в конце - ни одна функция расчёта не видит её ставкой прайса.
	ЗонаНДС = ДанныеЗоныНДССтроки(Стр, ДанныеЦен);
	Если ЗонаНДС <> Неопределено Тогда
		Стр.СтавкаНДС = ЗонаНДС.СтавкаНоменклатуры;
	КонецЕсли;
	// Получаем данные
	Если Стр.Свойство("Поставщик") Тогда // Поставщики	
		МасЦены = ЦеныДляЗакупки(Стр, ДанныеЦен, ЦенаПрайсаСНДС);
	ИначеЕсли Стр.Свойство("ВидЦены") и Не ЗначениеЗаполнено(Стр.ВидЦены) Тогда // Покупатели (Нет вида цен - "Произвольная")
		МасЦены = Новый Массив;	
	Иначе // Покупатели (Есть вид цен)	
		МасЦены = ЦеныДляПродажи(Стр, ТЗПоследнийПрайс, ДанныеЦен, ЦенаПрайсаСНДС, ВалютаЦены);
	КонецЕсли;
	// Устанавливаем данные
	Если МасЦены.Количество() = 0 Тогда
		// Вид цен строки не сбрасывается: пустой вид означает «произвольная цена», и цена, установленная
		// позже, при повторном выборе номенклатуры в этой строке уже не подставилась бы.
		Стр.Цена = 0;
		Если Стр.Свойство("ЦенаSKU") Тогда
			Стр.ЦенаSKU = 0;	
		КонецЕсли;		
	Иначе	
		МасСтр = МасЦены[0];
		Если Стр.Свойство("ЦенаSKU") Тогда
			Если ЗначениеЗаполнено(МасСтр.Упаковка) Тогда // Цену устанавливали за упаковку, пересчитываем в основную единицу
				Стр.ЦенаSKU = МасСтр.Цена * РассчитатьКоэффициентЕдиницы(Стр.Номенклатура.Единица) / РассчитатьКоэффициентЕдиницы(МасСтр.Упаковка);	
			Иначе // Цену устанавливали за основную единицу	
				Стр.ЦенаSKU = МасСтр.Цена;
			КонецЕсли;
			Стр.ЦенаSKU = ПривестиЦенуКРежимуНДС(Стр.ЦенаSKU, Стр.СтавкаНДС, ЦенаПрайсаСНДС, ЦенаВключаетНДС);
		КонецЕсли; 	
		Если МасСтр.Упаковка = Стр.Упаковка Тогда
			Стр.Цена = МасСтр.Цена;
		Иначе	
			Стр.Цена = МасСтр.Цена * РассчитатьКоэффициентЕдиницы(Стр.Упаковка) / РассчитатьКоэффициентЕдиницы(МасСтр.Упаковка);	
		КонецЕсли;
		Стр.Цена = ПривестиЦенуКРежимуНДС(Стр.Цена, Стр.СтавкаНДС, ЦенаПрайсаСНДС, ЦенаВключаетНДС);
		ПересчитатьЦенуВВалютуДокумента(Стр, ВалютаЦены, ВалютаДокумента);
		ЗаполнитьСправочныеЦены(Стр, ДанныеЦен);
	КонецЕсли;
	Если ЗонаНДС <> Неопределено Тогда
		ПрименитьСтавкуЗоныКЦенам(Стр, ЗонаНДС, ЦенаВключаетНДС);
	КонецЕсли;
КонецПроцедуры

// Цена строки (и ЦенаSKU) из валюты цены в валюту документа по курсам на дату цены.
//
// Параметры:
//  Стр - Структура, СтрокаТабличнойЧасти - строка с Цена и, возможно, ЦенаSKU, ДатаЦены, ВалютаДокумента, КурсДокумента.
//  ВалютаЦены - СправочникСсылка.Валюты, Неопределено - валюта найденной цены; пустая - основная.
//  ВалютаДокумента - Структура, Неопределено - Валюта, Курс и, возможно, Дата курса (см. ПолучитьЦенуНоменклатуры).
//
Процедура ПересчитатьЦенуВВалютуДокумента(Стр, ВалютаЦены, Знач ВалютаДокумента)
	Если ВалютаДокумента = Неопределено Тогда
		ВалютаДокумента = Новый Структура("Валюта, Курс",
			?(Стр.Свойство("ВалютаДокумента"), Стр.ВалютаДокумента, Неопределено),
			?(Стр.Свойство("КурсДокумента"), Стр.КурсДокумента, 1));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВалютаЦены) И Не ЗначениеЗаполнено(ВалютаДокумента.Валюта) Тогда
		Возврат;
	КонецЕсли;
	Если ВалютаДокумента.Свойство("Дата") Тогда
		ДатаКурса = ВалютаДокумента.Дата;
	Иначе
		ДатаКурса = ?(Стр.Свойство("ДатаЦены"), Стр.ДатаЦены, ТекущаяДатаСеанса());
	КонецЕсли;
	КурсНайден = Истина;
	Стр.Цена = РаботаСВалютами.ПересчитатьЦену(Стр.Цена, ВалютаЦены, ВалютаДокумента.Валюта, ВалютаДокумента.Курс,
		ДатаКурса, КурсНайден);
	Если Стр.Свойство("ЦенаSKU") Тогда
		Стр.ЦенаSKU = РаботаСВалютами.ПересчитатьЦену(Стр.ЦенаSKU, ВалютаЦены, ВалютаДокумента.Валюта,
			ВалютаДокумента.Курс, ДатаКурса, КурсНайден);
	КонецЕсли;
	Если Не КурсНайден Тогда
		ВалютаБезКурса = ?(ЗначениеЗаполнено(ВалютаЦены), ВалютаЦены, ВалютаДокумента.Валюта);
		ТекстСообщения = РаботаСВалютами.ТекстКурсНеЗадан(ВалютаБезКурса, ДатаКурса);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
КонецПроцедуры

// Данные цен для подстановки в табличную часть одним запросом на список номенклатуры.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент документа (покупатель или поставщик).
//  ЭтоЗакупка - Булево - Истина: цены закупки, Ложь: цены продажи.
//  МасНоменклатура - Массив - номенклатура табличной части.
//  МасХарактеристики - Массив - характеристики табличной части.
//  ВидЦены - СправочникСсылка.ВидыЦен - вид цен документа (для динамического расчёта).
//  ДатаЦен - Дата - дата среза.
//
// Возвращаемое значение:
//  Структура - Фиксированные, ПоследнийПриход, Себестоимость (ТаблицаЗначений или Неопределено).
//
Функция ДанныеЦенДляСписка(Контрагент, ЭтоЗакупка, МасНоменклатура, МасХарактеристики, ВидЦены, ДатаЦен) Экспорт
	Результат = Новый Структура("Фиксированные, ПоследнийПриход, Себестоимость");
	Если ЭтоЗакупка Тогда
		Результат.Фиксированные = РегистрыСведений.ЦеныЗакупки.ПрайсПоставщика(Контрагент, МасНоменклатура);
		Возврат Результат;
	КонецЕсли;
	Результат.Фиксированные = РегистрыСведений.ЦеныПродажи.ПрайсПокупателя(Контрагент, МасНоменклатура);
	// Базы готовятся и для справочных цен строк (розничная, минимальная),
	// если их виды переведены на динамический расчёт.
	МасВиды = Новый Массив;
	МасВиды.Добавить(ВидЦены);
	МасВиды.Добавить(Справочники.ВидыЦен.Розничная);
	МасВиды.Добавить(Справочники.ВидыЦен.МинимальнаяЦенаПродажи);
	НуженПоследнийПриход = Ложь;
	НужнаСебестоимость = Ложь;
	Для Каждого Вид Из МасВиды Цикл
		ДанныеВида = ОбщегоНазначенияВызовСервераПовтИсп.ДанныеВидаЦены(Вид);
		Если Не ДанныеВида.ДинамическийРасчет Тогда
			Продолжить;
		КонецЕсли;
		Если ДанныеВида.ОсноваРасчёта = Перечисления.ОсновыРасчётаНаценок.ПоследнийПриход Тогда
			НуженПоследнийПриход = Истина;
		Иначе
			НужнаСебестоимость = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НуженПоследнийПриход Тогда
		Результат.ПоследнийПриход = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(ДатаЦен, МасНоменклатура);
	КонецЕсли;
	Если НужнаСебестоимость Тогда
		Результат.Себестоимость = РегистрыНакопления.ТоварыВНаличии.ПолучитьСреднююЦенуПоОстаткам(МасНоменклатура,
			МасХарактеристики, ДатаЦен);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Цены для строки документа закупки: фиксированная цена поставщика, иначе последний прайс.
//
// Параметры:
//  Стр - Структура - строка документа (см. ПреобразоватьСтрокуТаблицыВСтруктуру).
//  ДанныеЦен - Структура, Неопределено - заготовленные данные (см. ДанныеЦенДляСписка).
//  ЦенаПрайсаСНДС - Булево - возврат: режим НДС найденной цены.
//
// Возвращаемое значение:
//  Массив, ТаблицаЗначений - строки с ценами (первая используется).
//
Функция ЦеныДляЗакупки(Стр, ДанныеЦен, ЦенаПрайсаСНДС)
	Если ДанныеЦен = Неопределено Тогда
		МасЦены = РегистрыСведений.ЦеныЗакупки.ПрайсПоставщика(Стр.Поставщик, Стр.Номенклатура);
	Иначе
		МасЦены = ДанныеЦен.Фиксированные.НайтиСтроки(Новый Структура("Номенклатура", Стр.Номенклатура));
	КонецЕсли;
	Если МасЦены.Количество() > 0 Тогда
		ЦенаПрайсаСНДС = МасЦены[0].ЦенаВключаетНДС;
		Возврат МасЦены;
	КонецЕсли;
	МасЦены = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(Стр.ДатаЦены, Стр.Номенклатура, Стр.Поставщик);
	Если МасЦены.Количество() = 0 Тогда 
		МасЦены = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(Стр.ДатаЦены, Стр.Номенклатура, Неопределено);
	КонецЕсли;
	Возврат МасЦены;
КонецФункции

// Цены для строки документа продажи: фиксированная цена покупателя, затем вид цен документа
// (динамический расчёт или прайс), затем розничная цена.
//
// Параметры:
//  Стр - Структура - строка документа (см. ПреобразоватьСтрокуТаблицыВСтруктуру).
//  ТЗПоследнийПрайс - ТаблицаЗначений, Неопределено - готовый срез прайса.
//  ДанныеЦен - Структура, Неопределено - заготовленные данные (см. ДанныеЦенДляСписка).
//  ЦенаПрайсаСНДС - Булево - возврат: режим НДС найденной цены.
//  ВалютаЦены - СправочникСсылка.Валюты, Неопределено - возврат: валюта прайса вида цен; фиксированная и
//               динамическая цены - в основной валюте (Неопределено).
//
// Возвращаемое значение:
//  Массив, ТаблицаЗначений - строки с ценами (первая используется).
//
Функция ЦеныДляПродажи(Стр, ТЗПоследнийПрайс, ДанныеЦен, ЦенаПрайсаСНДС, ВалютаЦены)
	ВидЦеныРозничная = Справочники.ВидыЦен.Розничная;
	ВидЦены = ?(Стр.Свойство("ВидЦены"), Стр.ВидЦены, ВидЦеныРозничная);
	// Фиксированная цена покупателя
	Если ДанныеЦен <> Неопределено Тогда
		МасЦены = ДанныеЦен.Фиксированные.НайтиСтроки(Новый Структура("Номенклатура", Стр.Номенклатура));
	ИначеЕсли Стр.Свойство("Контрагент") И ЗначениеЗаполнено(Стр.Контрагент) Тогда
		МасЦены = РегистрыСведений.ЦеныПродажи.ПрайсПокупателя(Стр.Контрагент, Стр.Номенклатура);
	Иначе
		МасЦены = Новый Массив;
	КонецЕсли;
	Если МасЦены.Количество() > 0 Тогда
		ЦенаПрайсаСНДС = МасЦены[0].ЦенаВключаетНДС;
		Возврат МасЦены;
	КонецЕсли;
	// Вид цен документа
	ДанныеВида = ОбщегоНазначенияВызовСервераПовтИсп.ДанныеВидаЦены(ВидЦены);
	Если ДанныеВида.ДинамическийРасчет Тогда
		ЦенаПрайсаСНДС = ДанныеВида.ЦенаВключаетНДС;
		Возврат ДинамическаяЦена(Стр, ДанныеВида, ДанныеЦен);
	КонецЕсли;
	Если ТЗПоследнийПрайс = Неопределено Тогда
		ДатаЦен = ?(Стр.Свойство("ДатаЦены"), Стр.ДатаЦены, ТекущаяДатаСеанса());
		МасВидыЦен = Новый Массив;
		МасВидыЦен.Добавить(ВидЦеныРозничная);
		МасВидыЦен.Добавить(ВидЦены);
		ТЗПоследнийПрайс = РегистрыСведений.ЦеныНоменклатуры.ПоследнийПрайс(ДатаЦен, МасВидыЦен, Стр.Номенклатура);
	КонецЕсли;
	Отбор = Новый Структура("Номенклатура, Характеристика, ВидЦены", Стр.Номенклатура, Стр.Характеристика, ВидЦены);
	МасЦены = ТЗПоследнийПрайс.НайтиСтроки(Отбор);
	Если МасЦены.Количество() = 0 Тогда
		Отбор.ВидЦены = ВидЦеныРозничная;
		МасЦены = ТЗПоследнийПрайс.НайтиСтроки(Отбор);
	КонецЕсли;
	Если МасЦены.Количество() > 0 Тогда
		ЦенаПрайсаСНДС = МасЦены[0].ЦенаВключаетНДС;
		ВалютаЦены = ОбщегоНазначенияВызовСервераПовтИсп.ДанныеВидаЦены(МасЦены[0].ВидЦены).Валюта;
		Если Стр.Свойство("ВидЦены") Тогда
			Стр.ВидЦены = МасЦены[0].ВидЦены;
		КонецЕсли;
	КонецЕсли;
	Возврат МасЦены;
КонецФункции

// Динамическая цена вида цен: база (последний приход или средняя себестоимость, обе с НДС) приводится
// к режиму НДС вида цен, к ней применяется наценка вида и округление по точности.
//
// Параметры:
//  Стр - Структура - строка документа.
//  ДанныеВида - Структура - реквизиты вида цен (см. ОбщегоНазначенияВызовСервераПовтИсп.ДанныеВидаЦены).
//  ДанныеЦен - Структура, Неопределено - заготовленные базы (см. ДанныеЦенДляСписка).
//
// Возвращаемое значение:
//  Массив - пустой или с одной структурой: Цена, Упаковка.
//
Функция ДинамическаяЦена(Стр, ДанныеВида, ДанныеЦен)
	МасЦены = Новый Массив;
	ДатаЦен = ?(Стр.Свойство("ДатаЦены"), Стр.ДатаЦены, ТекущаяДатаСеанса());
	Если ДанныеВида.ОсноваРасчёта = Перечисления.ОсновыРасчётаНаценок.ПоследнийПриход Тогда
		Если ДанныеЦен = Неопределено Или ДанныеЦен.ПоследнийПриход = Неопределено Тогда
			ТЗБаза = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(ДатаЦен, Стр.Номенклатура);
		Иначе
			ТЗБаза = ДанныеЦен.ПоследнийПриход;
		КонецЕсли;
		МасБаза = ТЗБаза.НайтиСтроки(Новый Структура("Номенклатура", Стр.Номенклатура));
	Иначе
		Если ДанныеЦен = Неопределено Или ДанныеЦен.Себестоимость = Неопределено Тогда
			ТЗБаза = РегистрыНакопления.ТоварыВНаличии.ПолучитьСреднююЦенуПоОстаткам(Стр.Номенклатура,
				Стр.Характеристика, ДатаЦен);
		Иначе
			ТЗБаза = ДанныеЦен.Себестоимость;
		КонецЕсли;
		МасБаза = ТЗБаза.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Стр.Номенклатура, Стр.Характеристика));
	КонецЕсли;
	Если МасБаза.Количество() = 0 Или МасБаза[0].Цена = 0 Тогда
		Возврат МасЦены;
	КонецЕсли;
	Цена = ПривестиЦенуКРежимуНДС(МасБаза[0].Цена, Стр.СтавкаНДС, Истина, ДанныеВида.ЦенаВключаетНДС);
	Если ДанныеВида.ВидНаценки = Перечисления.ВидыНаценок.Процент Тогда
		Цена = Цена * (1 + ДанныеВида.Показатель / РаботаСДокументамиКлиентСервер.СтоПроцентов());
	Иначе
		Цена = Цена + ДанныеВида.Показатель;
	КонецЕсли;
	НС = Новый Структура("Цена, Упаковка", Окр(Цена, ДанныеВида.Точность),
		Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	МасЦены.Добавить(НС);
	Возврат МасЦены;
КонецФункции

// Справочные цены строки (розничная, минимальная, по типу цен): из прайса, а для видов цен
// с динамическим расчётом - от базы вида; без учёта режима НДС документа.
//
// Параметры:
//  Стр - Структура - строка документа со свойствами ЦенаРозничная, ЦенаМинимальная, ЦенаПоТипуЦен (любое может отсутствовать).
//  ДанныеЦен - Структура, Неопределено - заготовленные базы динамического расчёта (см. ДанныеЦенДляСписка).
//
Процедура ЗаполнитьСправочныеЦены(Стр, ДанныеЦен = Неопределено)
	Если Не Стр.Свойство("ЦенаРозничная") И Не Стр.Свойство("ЦенаМинимальная") И Не Стр.Свойство("ЦенаПоТипуЦен") Тогда
		Возврат;
	КонецЕсли;
	ВидЦеныРозничная = Справочники.ВидыЦен.Розничная;
	ВидЦеныМинимальная = Справочники.ВидыЦен.МинимальнаяЦенаПродажи;
	МасВидыЦен = Новый Массив;
	МасВидыЦен.Добавить(ВидЦеныРозничная);
	МасВидыЦен.Добавить(ВидЦеныМинимальная);
	Если Стр.Свойство("ТипЦеныПоТипуЦен") Тогда
		МасВидыЦен.Добавить(Стр.ТипЦеныПоТипуЦен);
	КонецЕсли;
	ТЗПоследнийПрайс = РегистрыСведений.ЦеныНоменклатуры.ПоследнийПрайс(Стр.ДатаЦены, МасВидыЦен);
	ЗаполнитьСправочнуюЦену(Стр, "ЦенаРозничная", ТЗПоследнийПрайс, ВидЦеныРозничная, ДанныеЦен);
	ЗаполнитьСправочнуюЦену(Стр, "ЦенаМинимальная", ТЗПоследнийПрайс, ВидЦеныМинимальная, ДанныеЦен);
	Если Стр.Свойство("ТипЦеныПоТипуЦен") Тогда
		ЗаполнитьСправочнуюЦену(Стр, "ЦенаПоТипуЦен", ТЗПоследнийПрайс, Стр.ТипЦеныПоТипуЦен, ДанныеЦен);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьСправочнуюЦену(Стр, ИмяСвойства, ТЗПоследнийПрайс, ВидЦены, ДанныеЦен)
	// Одна справочная цена строки: срез прайса по виду цен, а для динамического вида - расчёт от базы.
	Если Не Стр.Свойство(ИмяСвойства) Тогда
		Возврат;
	КонецЕсли;
	Стр[ИмяСвойства] = 0;
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат;
	КонецЕсли;
	ДанныеВида = ОбщегоНазначенияВызовСервераПовтИсп.ДанныеВидаЦены(ВидЦены);
	Если ДанныеВида.ДинамическийРасчет Тогда
		МасЦены = ДинамическаяЦена(Стр, ДанныеВида, ДанныеЦен);
	Иначе
		Отбор = Новый Структура("Номенклатура, Характеристика, ВидЦены", Стр.Номенклатура, Стр.Характеристика, ВидЦены);
		МасЦены = ТЗПоследнийПрайс.НайтиСтроки(Отбор);
	КонецЕсли;
	Если МасЦены.Количество() > 0 Тогда
		Стр[ИмяСвойства] = МасЦены[0].Цена;
	КонецЕсли;
КонецПроцедуры

// Приводит цену к режиму НДС документа: добавляет НДС сверху или выделяет его из цены.
//
// Параметры:
//  Цена - Число - цена в режиме прайса.
//  СтавкаНДС - СправочникСсылка.СтавкиНДС - ставка НДС номенклатуры.
//  ЦенаСНДС - Булево - цена прайса включает НДС.
//  НужнаЦенаСНДС - Булево - режим НДС документа.
//
// Возвращаемое значение:
//  Число - цена в режиме документа.
//
Функция ПривестиЦенуКРежимуНДС(Цена, СтавкаНДС, ЦенаСНДС, НужнаЦенаСНДС) Экспорт
	Если ЦенаСНДС = НужнаЦенаСНДС Тогда
		Возврат Цена;
	КонецЕсли;
	Если ЦенаСНДС Тогда
		Возврат Цена - РаботаСДокументамиКлиентСервер.РассчитатьСуммуНДС(СтавкаНДС, Цена, Истина);
	КонецЕсли;
	Возврат Цена + РаботаСДокументамиКлиентСервер.РассчитатьСуммуНДС(СтавкаНДС, Цена, Ложь);
КонецФункции

#Область ЗоныНДС

// Ставка НДС освобождённой зоны контрагента (docs/plans/vat-zones.md).
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - покупатель.
//
// Возвращаемое значение:
//  СправочникСсылка.СтавкиНДС - ставка зоны; пустая ссылка, если зона не задана или не освобождена от НДС.
//
Функция СтавкаЗоныКонтрагента(Контрагент) Экспорт
	Результат = Справочники.СтавкиНДС.ПустаяСсылка();
	Если Не ЗначениеЗаполнено(Контрагент) Или ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат Результат;
	КонецЕсли;
	ТекстЗапроса = ТекстЗапросаСтавкиЗоны();
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.СтавкаНДС) Тогда
		Результат = Выборка.СтавкаНДС;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Дополняет данные цен табличной части сведениями зоны НДС для пакетного получения цены (без запроса на строку):
// ПродажаПоЗонеНДС, СтавкаЗоны и, если зона освобождена, СтавкиНоменклатуры.
//
// Параметры:
//  ДанныеЦен        - Структура - данные цен (см. ДанныеЦенДляСписка), дополняется.
//  Контрагент       - СправочникСсылка.Контрагенты - покупатель документа.
//  МасНоменклатура  - Массив из СправочникСсылка.Номенклатура - номенклатура табличной части.
//  ПродажаПоЗонеНДС - Булево - документ продажи, к которому применяется зона (см.
//                     РаботаСДокументамиКлиентСервер.ПродажаПоЗонеНДС).
//
Процедура ДобавитьДанныеЗоныНДС(ДанныеЦен, Контрагент, МасНоменклатура, ПродажаПоЗонеНДС) Экспорт
	ДанныеЦен.Вставить("ПродажаПоЗонеНДС", ПродажаПоЗонеНДС);
	ДанныеЦен.Вставить("СтавкаЗоны", Справочники.СтавкиНДС.ПустаяСсылка());
	ДанныеЦен.Вставить("СтавкиНоменклатуры", Новый Соответствие);
	Если Не ДанныеЦен.ПродажаПоЗонеНДС Тогда
		Возврат;
	КонецЕсли;
	ДанныеЦен.СтавкаЗоны = СтавкаЗоныКонтрагента(Контрагент);
	Если ЗначениеЗаполнено(ДанныеЦен.СтавкаЗоны) Тогда
		ДанныеЦен.СтавкиНоменклатуры = СтавкиНДСНоменклатуры(МасНоменклатура);
	КонецЕсли;
КонецПроцедуры

// Пересчитывает ставки строк продажи по зоне контрагента при смене покупателя (docs/plans/vat-zones.md, п. 2):
// освобождённая зона - всем строкам её ставка; иначе строкам с освобождающей ставкой - ставка номенклатуры; остальные
// строки не меняются. У изменённых строк цена без НДС сохраняется: цены переводятся из прежней ставки и прежнего режима
// НДС в новую ставку и новый режим, затем пересчитываются суммы.
//
// Параметры:
//  Строки           - ДанныеФормыКоллекция, ТабличнаяЧасть, Массив - строки с реквизитами Номенклатура, СтавкаНДС, Цена.
//  Контрагент       - СправочникСсылка.Контрагенты - новый покупатель.
//  ПрежнийРежимСНДС - Булево - признак «Цена включает НДС» документа до смены покупателя.
//  НовыйРежимСНДС   - Булево - признак после смены.
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы одна строка изменена.
//
Функция ПересчитатьСтавкиПоЗоне(Строки, Контрагент, ПрежнийРежимСНДС, НовыйРежимСНДС) Экспорт
	Изменено = Ложь;
	Если Строки.Количество() = 0 Тогда
		Возврат Изменено;
	КонецЕсли;
	Правило = ПравилоСтавокЗоны(Строки, Контрагент);
	Для Каждого Стр Из Строки Цикл
		НоваяСтавка = НоваяСтавкаПоЗоне(Стр, Правило);
		Если НоваяСтавка = Неопределено Или НоваяСтавка = Стр.СтавкаНДС Тогда
			Продолжить;
		КонецЕсли;
		ПеревестиЦеныСтрокиНаСтавку(Стр, НоваяСтавка, ПрежнийРежимСНДС, НовыйРежимСНДС);
		Изменено = Истина;
	КонецЦикла;
	Возврат Изменено;
КонецФункции

// Предупреждает при записи документа продажи, если покупатель в освобождённой зоне, а в строке другая ставка НДС
// (docs/plans/vat-zones.md, п. 3). Запись не запрещает.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ЗаказПокупателя,
//              ДокументОбъект.КоммерческоеПредложение, ДокументОбъект.ВозвратОтПокупателя - записываемый документ.
//
Процедура ПредупредитьОСтавкахЗоны(ДокОбъект) Экспорт
	Если ДокОбъект.ОбменДанными.Загрузка Или Не РаботаСДокументамиКлиентСервер.ПродажаПоЗонеНДС(ДокОбъект) Тогда
		Возврат;
	КонецЕсли;
	СтавкаЗоны = СтавкаЗоныКонтрагента(ДокОбъект.Контрагент);
	Если Не ЗначениеЗаполнено(СтавкаЗоны) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ИмяТЧ Из СтрРазделить("ТЧТовары,ТЧУслуги", ",") Цикл
		Если ДокОбъект.Метаданные().ТабличныеЧасти.Найти(ИмяТЧ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Стр Из ДокОбъект[ИмяТЧ] Цикл
			Если Стр.СтавкаНДС = СтавкаЗоны Тогда
				Продолжить;
			КонецЕсли;
			Текст = СтрШаблон(НСтр("ru = 'Строка %1: покупатель в зоне, освобождённой от НДС, а ставка строки - «%2» вместо «%3».';
				|fr = 'Ligne %1 : le client est dans une zone exonérée de TVA, mais le taux de la ligne est « %2 » au lieu de « %3 ».';
				|en = 'Line %1: the customer is in a VAT-exempt zone, but the line rate is ""%2"" instead of ""%3"".';
				|es = 'Línea %1: el cliente está en una zona exenta de IVA, pero el tipo de la línea es «%2» en lugar de «%3».'"),
				Стр.НомерСтроки, Стр.СтавкаНДС, СтавкаЗоны);
			Поле = СтрШаблон("%1[%2].СтавкаНДС", ИмяТЧ, Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=0"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ДокОбъект, Поле, "Объект");
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Ставка зоны и ставка номенклатуры строки продажи покупателю освобождённой зоны.
//
// Параметры:
//  Стр       - Структура, ДанныеФормыЭлементКоллекции - строка документа.
//  ДанныеЦен - Структура, Неопределено - данные цен табличной части; со свойством ПродажаПоЗонеНДС (см.
//              ДобавитьДанныеЗоныНДС) зона берётся из них, иначе - по свойствам строки ПродажаПоЗонеНДС и Контрагент.
//
// Возвращаемое значение:
//  Структура, Неопределено - СтавкаЗоны, СтавкаНоменклатуры; Неопределено - зона к строке не применяется.
//
Функция ДанныеЗоныНДССтроки(Стр, ДанныеЦен)
	Если Не Стр.Свойство("СтавкаНДС") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ДанныеЦен <> Неопределено И ДанныеЦен.Свойство("ПродажаПоЗонеНДС") Тогда
		Если Не ДанныеЦен.ПродажаПоЗонеНДС Или Не ЗначениеЗаполнено(ДанныеЦен.СтавкаЗоны) Тогда
			Возврат Неопределено;
		КонецЕсли;
		СтавкаНоменклатуры = ДанныеЦен.СтавкиНоменклатуры.Получить(Стр.Номенклатура);
		Возврат Новый Структура("СтавкаЗоны, СтавкаНоменклатуры", ДанныеЦен.СтавкаЗоны,
			?(СтавкаНоменклатуры = Неопределено, Справочники.СтавкиНДС.ПустаяСсылка(), СтавкаНоменклатуры));
	КонецЕсли;
	// Строка может быть элементом коллекции данных формы: свойства проверяются одним параметром, значения - отдельно.
	Если Не Стр.Свойство("ПродажаПоЗонеНДС") Или Не Стр.Свойство("Контрагент") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Стр.ПродажаПоЗонеНДС <> Истина Или Не ЗначениеЗаполнено(Стр.Контрагент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Контрагент = Стр.Контрагент;
	ТекстЗапроса = ТекстЗапросаСтавкиЗоны() + ";
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Н.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	Н.Ссылка = &Номенклатура";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Номенклатура", Стр.Номенклатура);
	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[0].Выбрать();
	Если Не Выборка.Следующий() Или Не ЗначениеЗаполнено(Выборка.СтавкаНДС) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("СтавкаЗоны, СтавкаНоменклатуры", Выборка.СтавкаНДС,
		Справочники.СтавкиНДС.ПустаяСсылка());
	ВыборкаНоменклатуры = Результаты[1].Выбрать();
	Если ВыборкаНоменклатуры.Следующий() Тогда
		Результат.СтавкаНоменклатуры = ВыборкаНоменклатуры.СтавкаНДС;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Цены строки после расчёта по ставке номенклатуры переводятся на ставку зоны с той же ценой без НДС: Цена и ЦенаSKU -
// в режиме НДС документа, справочные цены - в режиме своего вида цены (см. ЗаполнитьСправочныеЦены).
//
// Параметры:
//  Стр             - Структура, ДанныеФормыЭлементКоллекции - строка документа.
//  ЗонаНДС         - Структура - см. ДанныеЗоныНДССтроки.
//  ЦенаВключаетНДС - Булево - режим НДС документа.
//
Процедура ПрименитьСтавкуЗоныКЦенам(Стр, ЗонаНДС, ЦенаВключаетНДС)
	Старая = ЗонаНДС.СтавкаНоменклатуры;
	Новая = ЗонаНДС.СтавкаЗоны;
	Для Каждого Имя Из СтрРазделить("Цена,ЦенаSKU", ",") Цикл
		Если Стр.Свойство(Имя) Тогда
			Стр[Имя] = ЦенаНаДругуюСтавку(Стр[Имя], Старая, ЦенаВключаетНДС, Новая, ЦенаВключаетНДС);
		КонецЕсли;
	КонецЦикла;
	ВидыСправочныхЦен = Новый Структура("ЦенаРозничная, ЦенаМинимальная",
		Справочники.ВидыЦен.Розничная, Справочники.ВидыЦен.МинимальнаяЦенаПродажи);
	Если Стр.Свойство("ЦенаПоТипуЦен") И Стр.Свойство("ТипЦеныПоТипуЦен") Тогда
		ВидыСправочныхЦен.Вставить("ЦенаПоТипуЦен", Стр.ТипЦеныПоТипуЦен);
	КонецЕсли;
	Для Каждого КлючИЗначение Из ВидыСправочныхЦен Цикл
		Если Стр.Свойство(КлючИЗначение.Ключ) Тогда
			РежимВида = ОбщегоНазначенияВызовСервераПовтИсп.ДанныеВидаЦены(КлючИЗначение.Значение).ЦенаВключаетНДС;
			Стр[КлючИЗначение.Ключ] = ЦенаНаДругуюСтавку(Стр[КлючИЗначение.Ключ], Старая, РежимВида, Новая, РежимВида);
		КонецЕсли;
	КонецЦикла;
	Стр.СтавкаНДС = Новая;
КонецПроцедуры

// Данные правила п. 2: ставка зоны покупателя; без неё - ставки номенклатуры строк и освобождающие ставки строк.
//
// Параметры:
//  Строки     - ДанныеФормыКоллекция, ТабличнаяЧасть, Массив - строки документа.
//  Контрагент - СправочникСсылка.Контрагенты - покупатель.
//
// Возвращаемое значение:
//  Структура - СтавкаЗоны, СтавкиНоменклатуры (Соответствие), Освобождающие (Соответствие).
//
Функция ПравилоСтавокЗоны(Строки, Контрагент)
	Правило = Новый Структура("СтавкаЗоны, СтавкиНоменклатуры, Освобождающие", СтавкаЗоныКонтрагента(Контрагент),
		Новый Соответствие, Новый Соответствие);
	Если ЗначениеЗаполнено(Правило.СтавкаЗоны) Тогда
		Возврат Правило;
	КонецЕсли;
	Номенклатура = Новый Массив;
	Ставки = Новый Массив;
	Для Каждого Стр Из Строки Цикл
		Номенклатура.Добавить(Стр.Номенклатура);
		Ставки.Добавить(Стр.СтавкаНДС);
	КонецЦикла;
	Правило.СтавкиНоменклатуры = СтавкиНДСНоменклатуры(Номенклатура);
	Правило.Освобождающие = ОсвобождающиеСтавки(Ставки);
	Возврат Правило;
КонецФункции

Функция НоваяСтавкаПоЗоне(Стр, Правило)
	Если ЗначениеЗаполнено(Правило.СтавкаЗоны) Тогда
		Возврат Правило.СтавкаЗоны;
	КонецЕсли;
	Если Правило.Освобождающие.Получить(Стр.СтавкаНДС) <> Неопределено Тогда
		Возврат Правило.СтавкиНоменклатуры.Получить(Стр.Номенклатура);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Цены строки - с прежней ставки и прежнего режима НДС на новую ставку и новый режим с той же ценой без НДС, затем
// ставка и суммы строки.
//
// Параметры:
//  Стр              - ДанныеФормыЭлементКоллекции, СтрокаТабличнойЧасти - строка документа.
//  НоваяСтавка      - СправочникСсылка.СтавкиНДС - ставка строки после пересчёта.
//  ПрежнийРежимСНДС - Булево - режим НДС цен строки.
//  НовыйРежимСНДС   - Булево - режим НДС документа после смены.
//
Процедура ПеревестиЦеныСтрокиНаСтавку(Стр, НоваяСтавка, ПрежнийРежимСНДС, НовыйРежимСНДС)
	Для Каждого Имя Из СтрРазделить("Цена,ЦенаSKU", ",") Цикл
		Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Стр, Имя) Тогда
			Стр[Имя] = ЦенаНаДругуюСтавку(Стр[Имя], Стр.СтавкаНДС, ПрежнийРежимСНДС, НоваяСтавка, НовыйРежимСНДС);
		КонецЕсли;
	КонецЦикла;
	Стр.СтавкаНДС = НоваяСтавка;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, НовыйРежимСНДС);
КонецПроцедуры

Функция ЦенаНаДругуюСтавку(Цена, СтараяСтавка, СтарыйРежимСНДС, НоваяСтавка, НовыйРежимСНДС)
	ЦенаБезНДС = ПривестиЦенуКРежимуНДС(Цена, СтараяСтавка, СтарыйРежимСНДС, Ложь);
	Возврат ПривестиЦенуКРежимуНДС(ЦенаБезНДС, НоваяСтавка, Ложь, НовыйРежимСНДС);
КонецФункции

Функция ТекстЗапросаСтавкиЗоны()
	Возврат "ВЫБРАТЬ
	|	Зоны.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЗоныКонтрагентов КАК Зоны
	|		ПО К.ЗонаКонтрагента = Зоны.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтавкиНДС КАК Ставки
	|		ПО Зоны.СтавкаНДС = Ставки.Ссылка
	|ГДЕ
	|	К.Ссылка = &Контрагент
	|	И Зоны.ОсвобожденаОтНДС
	|	И Ставки.ОсвобождениеОтНДС";
КонецФункции

Функция СтавкиНДСНоменклатуры(МасНоменклатура)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Н.Ссылка КАК Ссылка,
	|	Н.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	Н.Ссылка В (&Номенклатура)");
	Запрос.УстановитьПараметр("Номенклатура", МасНоменклатура);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.СтавкаНДС);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОсвобождающиеСтавки(Ставки)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	С.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтавкиНДС КАК С
	|ГДЕ
	|	С.Ссылка В (&Ставки)
	|	И С.ОсвобождениеОтНДС");
	Запрос.УстановитьПараметр("Ставки", Ставки);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

// Вид цены продажи документа по умолчанию (план docs/plans/retail-store-price.md, §1): вид цены покупателя, затем вид
// цены продажи склада, затем «Розничная». Склад заменяет только конечный откат: пустой у склада - прежнее правило.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - покупатель.
//  Склад      - СправочникСсылка.МестаХранения - склад документа; пустой - без склада.
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыЦен - вид цены.
//
Функция ВидЦеныПродажиПоУмолчанию(Контрагент, Склад) Экспорт
	ВидЦены = ?(ЗначениеЗаполнено(Контрагент), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ТипЦены"), Неопределено);
	Если ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат ВидЦены;
	КонецЕсли;
	ВидЦены = Справочники.МестаХранения.ВидЦеныПродажи(Склад);
	Возврат ?(ЗначениеЗаполнено(ВидЦены), ВидЦены, Справочники.ВидыЦен.Розничная);
КонецФункции

// Режим НДС вида цен: Истина, если цены вида включают НДС (для пустого вида цен - Истина).
//
// Параметры:
//  ВидЦены - СправочникСсылка.ВидыЦен
//
// Возвращаемое значение:
//  Булево
//
Функция ЦенаВключаетНДСПоВидуЦен(ВидЦены) Экспорт
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦены, "ЦенаВключаетНДС") = Истина;
КонецФункции

Функция ПолучитьСтатьюДДСПоХозяйственнойОперации(ХозяйственнаяОперация) Экспорт
	Мас = Справочники.СтатьиДвиженияДенежныхСредств.ПолучитьПоХозяйственнойОперации(ХозяйственнаяОперация);
	Возврат ?(Мас.Количество() = 0, Неопределено, Мас[0]);	
КонецФункции

Функция ПолучитьНоменклатуруПоШтрихкоду(Штрихкод, ЕстьСерия = Истина) Экспорт
	// Номер IMEI серийного товара (docs/plans/industry-phones-2.md, п. 1) - до привилегированного режима: поиск по
	// номеру проверяет право пользователя читать серии и номенклатуру.
	ПоНомеру = СерийныйУчет.ТоварПоНомеру(Штрихкод);
	// Штрихкод серии - теперь и IMEI: без права чтения серий серия не возвращается, без права на номенклатуру - ничего.
	ПравоСерий = ПравоДоступа("Чтение", Метаданные.Справочники.СерииНоменклатуры);
	Если Не ПравоДоступа("Чтение", Метаданные.Справочники.Номенклатура) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Рез = РезультатПоискаШтрихкода(Штрихкод);
	// IMEI находит свою серию и без штрихкода; штрихкод другого товара с тем же значением - неоднозначность, товар не
	// подставляется.
	Если Рез.Пустой() И ПоНомеру = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Структура = Новый Структура("Номенклатура,Характеристика");
	Если ЕстьСерия Тогда 
		Структура.Вставить("Серия");
	КонецЕсли;
	Если Рез.Пустой() Тогда
		ЗаполнитьЗначенияСвойств(Структура, ПоНомеру);
		Возврат Структура;
	КонецЕсли;
	ТЗ = Рез.Выгрузить();
	Если ПоНомеру <> Неопределено И ТЗ[0].Серия <> ПоНомеру.Серия Тогда
		Шаблон = НСтр("ru = '%1 - штрихкод товара %2 и IMEI товара %3: выберите товар вручную';
			|fr = '%1 est le code-barres de l''article %2 et l''IMEI de l''article %3 : choisissez l''article manuellement';
			|en = '%1 is the barcode of item %2 and the IMEI of item %3: choose the item manually';
			|es = '%1 es el código de barras del artículo %2 y el IMEI del artículo %3: elija el artículo manualmente'");
		ТекстНеоднозначности = СтрШаблон(Шаблон, Штрихкод, ТЗ[0].Номенклатура, ПоНомеру.Номенклатура);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстНеоднозначности);
		Возврат Неопределено;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Структура, ТЗ[0]);
	Если ЕстьСерия И Не ПравоСерий Тогда
		Структура.Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	Возврат Структура;
КонецФункции

// Поиск товара по штрихкоду или IMEI со статусом (прайс-чекер, docs/plans/retail-tools.md, п. 4): различные сочетания
// номенклатуры, характеристики, серии и упаковки среди совпадений; больше одного - «Неоднозначен». Права - как у
// ПолучитьНоменклатуруПоШтрихкоду: без права на номенклатуру - «НеНайден», IMEI и серия - только с правом на серии.
//
// Параметры:
//  Штрихкод - Строка - отсканированное или введённое значение.
//
// Возвращаемое значение:
//  Структура - Статус («Найден», «НеНайден», «Неоднозначен»), Номенклатура, Характеристика, Серия, Упаковка,
//              Совпадения (Массив из Структура: Номенклатура, Характеристика, Серия, Упаковка - все различные сочетания).
//
Функция НайденныйТоварПоШтрихкоду(Штрихкод) Экспорт
	Результат = Новый Структура("Статус, Номенклатура, Характеристика, Серия, Упаковка", "НеНайден");
	Результат.Вставить("Совпадения", Новый Массив);
	ПоНомеру = СерийныйУчет.ТоварПоНомеру(Штрихкод);
	ПравоСерий = ПравоДоступа("Чтение", Метаданные.Справочники.СерииНоменклатуры);
	Если ПустаяСтрока(Штрихкод) Или Не ПравоДоступа("Чтение", Метаданные.Справочники.Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	Совпадения = РезультатПоискаШтрихкода(Штрихкод).Выгрузить();
	Если Не ПравоСерий Тогда
		Совпадения.ЗаполнитьЗначения(Справочники.СерииНоменклатуры.ПустаяСсылка(), "Серия");
	КонецЕсли;
	Если ПоНомеру <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Совпадения.Добавить(), ПоНомеру);
	КонецЕсли;
	Совпадения.Свернуть("Номенклатура, Характеристика, Серия, Упаковка");
	Для Каждого Совпадение Из Совпадения Цикл
		Сочетание = Новый Структура("Номенклатура, Характеристика, Серия, Упаковка");
		ЗаполнитьЗначенияСвойств(Сочетание, Совпадение);
		Результат.Совпадения.Добавить(Сочетание);
	КонецЦикла;
	Если Совпадения.Количество() = 1 Тогда
		Результат.Статус = "Найден";
		ЗаполнитьЗначенияСвойств(Результат, Совпадения[0]);
	ИначеЕсли Совпадения.Количество() > 1 Тогда
		Результат.Статус = "Неоднозначен";
	Иначе
		Результат.Статус = "НеНайден";
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Строки регистра штрихкодов по значению - общая часть поиска по штрихкоду.
//
// Параметры:
//  Штрихкод - Строка - значение штрихкода.
//
// Возвращаемое значение:
//  РезультатЗапроса - Номенклатура, Характеристика, Серия, Упаковка.
//
Функция РезультатПоискаШтрихкода(Штрихкод)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
	|	ШтрихкодыНоменклатуры.Серия КАК Серия,
	|	ШтрихкодыНоменклатуры.Упаковка КАК Упаковка
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод");
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Возврат Запрос.Выполнить();
КонецФункции

#КонецОбласти

#Область Отчёты

Функция УстановитьНастройкиОтчёта(ТипОтчета, СтруктураПараметры, СтруктураОтбор) Экспорт
    ОтчетОбъект = Отчеты[ТипОтчета].Создать();    
	КомпоновщикНастроек = ОтчетОбъект.КомпоновщикНастроек;
    Настройки = КомпоновщикНастроек.Настройки;
	ПользовательскиеНастройки = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки;
	// Параметры
	Для Каждого Эл Из СтруктураПараметры Цикл
        Для Каждого ПараметрСКД Из ПользовательскиеНастройки.Элементы Цикл
            Если ТипЗнч(ПараметрСКД) <> Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда Продолжить КонецЕсли;  
            Если Строка(ПараметрСКД.Параметр) <> Эл.Ключ Тогда Продолжить КонецЕсли; 
            ПараметрСКД.Значение = Эл.Значение;
            ПараметрСКД.Использование = Истина;
        КонецЦикла;    
	КонецЦикла;
	// Отбор
	Для Каждого Эл Из СтруктураОтбор Цикл        
       	Отбор = Новый ПолеКомпоновкиДанных(Эл.Ключ);
		Для Каждого ЭлементНастройки Из Настройки.Отбор.Элементы Цикл
			Если ЭлементНастройки.ЛевоеЗначение <> Отбор Тогда Продолжить КонецЕсли; 
			Если ТипЗнч(Эл.Значение) = Тип("Массив") Тогда
				СЗ = Новый СписокЗначений;
				СЗ.ЗагрузитьЗначения(Эл.Значение);
				ЭлементНастройки.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии;
				ЭлементНастройки.ПравоеЗначение = СЗ; 
			Иначе
				ЭлементНастройки.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				ЭлементНастройки.ПравоеЗначение = Эл.Значение;	
			КонецЕсли;			
			ЭлементНастройки.Использование = Истина;
			Если ЗначениеЗаполнено(ЭлементНастройки.ИдентификаторПользовательскойНастройки) Тогда
				ПользовательскийПараметр = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭлементНастройки.ИдентификаторПользовательскойНастройки);
				Если ТипЗнч(ПользовательскийПараметр) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
					ПользовательскийПараметр.ВидСравнения = ЭлементНастройки.ВидСравнения;
					ПользовательскийПараметр.ПравоеЗначение = ЭлементНастройки.ПравоеЗначение;
					ПользовательскийПараметр.Использование = ЭлементНастройки.Использование;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;        
	КонецЦикла;
    Возврат ПользовательскиеНастройки;
КонецФункции

#КонецОбласти

