	Результат.Вставить("ШрифтПосветки", ШрифтыСтиля.Шрифт_Подвал);
	// Янтарный цвет акцента стиля: зелёный сливался с тёмным фоном выпадающего списка 8.5 (замечание владельца 2026-10-18).
	Результат.Вставить("ЦветПосветки", ЦветаСтиля.ЦветАкцента);
	Результат.Вставить("ЦветПосветкиНеактивнойСтроки", ЦветаСтиля.Цвет_ПоясняющийТекст);
	Возврат Результат;
