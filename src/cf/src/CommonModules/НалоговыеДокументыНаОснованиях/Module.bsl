// Текст запрета изменения налогового документа при зависимых расчётах.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ, чьи расчёты введены по налоговому документу
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстЗависимыхРасчетов(Регистратор)

	Шаблон = НСтр("ru = 'По налоговому документу введены расчёты документа %1 - сначала отмените его проведение.';
		|fr = 'Des règlements du document %1 sont saisis sur le document fiscal - annulez d''abord sa validation.';
		|en = 'Settlements of document %1 are entered on the tax document - unpost it first.';
		|es = 'Hay liquidaciones del documento %1 sobre el documento fiscal - anule primero su contabilización.'");
