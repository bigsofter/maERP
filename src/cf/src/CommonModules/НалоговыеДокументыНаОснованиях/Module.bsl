КонецФункции

#Область ПроверкиДокумента

Процедура ДобавитьОшибку(Ошибки, Шаблон, Параметр1, Параметр2 = Неопределено)

	Текст = СтрШаблон(Шаблон, Параметр1, Параметр2);
	Ошибки.Добавить(Текст);

КонецПроцедуры

Процедура ПроверитьПустыеТабличныеЧасти(ДокОбъект, Ошибки)

	Шаблон = НСтр("ru = 'У документа на основаниях табличная часть «%1» должна быть пустой.';
		|fr = 'Dans un document sur bases, la section « %1 » doit être vide.';
		|en = 'A document on bases must have an empty ""%1"" table.';
		|es = 'En un documento sobre bases, la sección «%1» debe estar vacía.'");
	ТабличныеЧасти = ДокОбъект.Метаданные().ТабличныеЧасти;
	// BSLLS:YoLetterUsage-off - имя табличной части
	Имена = СтрРазделить("ТЧУслуги, ТЧЗачётАвансов, ТЧДополнительныеРасходы", ", ", Ложь);
	// BSLLS:YoLetterUsage-on
	Для Каждого Имя Из Имена Цикл
		Если ТабличныеЧасти.Найти(Имя) <> Неопределено И ДокОбъект[Имя].Количество() > 0 Тогда
			ДобавитьОшибку(Ошибки, Шаблон, ТабличныеЧасти[Имя].Представление());
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьСвязьСтрок(ДокОбъект, Ошибки)

	ШаблонСвязи = НСтр("ru = 'Строка товаров %1 не связана с одной строкой основания.';
		|fr = 'La ligne d''articles %1 n''est pas liée à une seule ligne de base.';
		|en = 'Goods line %1 is not linked to exactly one basis line.';
		|es = 'La línea de mercancías %1 no está vinculada a una sola línea de base.'");
	ШаблонКоличества = НСтр("ru = 'В строке товаров %1 не указано количество.';
		|fr = 'La quantité n''est pas indiquée à la ligne d''articles %1.';
		|en = 'Goods line %1 has no quantity.';
		|es = 'La línea de mercancías %1 no tiene cantidad.'");
	Для Каждого СтрокаТоваров Из ДокОбъект.ТЧТовары Цикл
		Отбор = Новый Структура(ИмяКодаСтроки(), СтрокаТоваров.КодСтроки);
		Связанные = ДокОбъект.Основания.НайтиСтроки(Отбор);
		Если СтрокаТоваров.КодСтроки = 0 Или Связанные.Количество() <> 1 Тогда
			ДобавитьОшибку(Ошибки, ШаблонСвязи, СтрокаТоваров.НомерСтроки);
		КонецЕсли;
		Если СтрокаТоваров.Количество <= 0 Тогда
			ДобавитьОшибку(Ошибки, ШаблонКоличества, СтрокаТоваров.НомерСтроки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОснования(ДокОбъект, Основания, Ошибки)

	Текст =
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка,
	|	Д.Проведен КАК Проведен,
	|	Д.ПометкаУдаления КАК ПометкаУдаления,
	|	Д.УУ КАК УУ,
	|	Д.Организация КАК Организация,
	|	Д.Контрагент КАК Контрагент,
	|	Д.Договор КАК Договор,
	|	Д.Дата КАК Дата
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Д
	|ГДЕ
	|	Д.Ссылка В(&Основания)";
	Если Не ЭтоПродажа(ДокОбъект) Тогда
		Текст = СтрЗаменить(Текст, "Документ.РеализацияТоваровУслуг", "Документ.ПоступлениеТоваровУслуг");
	КонецЕсли;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Основания", Основания);
	Выборка = Запрос.Выполнить().Выбрать();
	ШаблонВида = НСтр("ru = 'Основание %1 должно быть проведённым неналоговым документом.';
		|fr = 'La base %1 doit être un document non fiscal validé.';
		|en = 'Basis %1 must be a posted non-tax document.';
		|es = 'La base %1 debe ser un documento no fiscal contabilizado.'");
	ШаблонСторон = НСтр("ru = 'У основания %1 другие организация, контрагент, договор или валюта.';
		|fr = 'La base %1 a une autre organisation, contrepartie, contrat ou devise.';
		|en = 'Basis %1 has a different company, counterparty, contract or currency.';
		|es = 'La base %1 tiene otra organización, contraparte, contrato o moneda.'");
	ШаблонДаты = НСтр("ru = 'Основание %1 позже налогового документа.';
		|fr = 'La base %1 est postérieure au document fiscal.';
		|en = 'Basis %1 is later than the tax document.';
		|es = 'La base %1 es posterior al documento fiscal.'");
	ШаблонВложения = НСтр("ru = 'Основание %1 само налоговый документ на основаниях.';
		|fr = 'La base %1 est elle-même un document fiscal sur bases.';
		|en = 'Basis %1 is itself a tax document on bases.';
		|es = 'La base %1 es en sí misma un documento fiscal sobre bases.'");
	ВалютаДокумента = РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Валюта;
	ДатыОснований = Новый Соответствие;
	Найдено = 0;
	Пока Выборка.Следующий() Цикл
		Найдено = Найдено + 1;
		Если Не Выборка.Проведен Или Выборка.ПометкаУдаления Или Не Выборка.УУ Тогда
			ДобавитьОшибку(Ошибки, ШаблонВида, Выборка.Ссылка);
		КонецЕсли;
		// Договор - один: прямая оплата налогового документа пишется договором платежа, долги разных договоров на одном
		// объекте не погасились бы ею (ревью плана С2, круг 4).
		ТеЖеСтороны = Выборка.Организация = ДокОбъект.Организация И Выборка.Контрагент = ДокОбъект.Контрагент
			И Выборка.Договор = ДокОбъект.Договор;
		Если Не ТеЖеСтороны Или РаботаСВалютами.ВалютаИКурсОбъекта(Выборка.Ссылка).Валюта <> ВалютаДокумента Тогда
			ДобавитьОшибку(Ошибки, ШаблонСторон, Выборка.Ссылка);
		КонецЕсли;
		Если Выборка.Дата > ДокОбъект.Дата Тогда
			ДобавитьОшибку(Ошибки, ШаблонДаты, Выборка.Ссылка);
		КонецЕсли;
		ДатыОснований.Вставить(Выборка.Ссылка, Выборка.Дата);
		Если ЭтоРегистраторНаОснованиях(Выборка.Ссылка) Тогда
			ДобавитьОшибку(Ошибки, ШаблонВложения, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Если Найдено <> Основания.Количество() Тогда
		Ошибки.Добавить(НСтр("ru = 'Основание - документ другого вида.'; fr = 'La base est un document d''un autre type.';
			|en = 'The basis is a document of another kind.'; es = 'La base es un documento de otro tipo.'"));
	КонецЕсли;
	ПроверитьОдинДень(ДатыОснований, Ошибки);
	Если Не ЭтоПродажа(ДокОбъект) Тогда
		ПроверитьДопРасходыПоставщика(ДокОбъект, Основания, Ошибки);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОдинДень(ДатыОснований, Ошибки)

	// Контроль кредита считает срок по объекту расчётов: основания разных дней на одном объекте смешали бы оплаченный и
	// неоплаченный срок (ревью плана С2, круг 15); объединение разных дней с распределением оплат - С2б.
	Шаблон = НСтр("ru = 'Основание %1 другого дня - объединяются основания одного дня (срок долга считается по объекту расчётов).';
		|fr = 'La base %1 est d''un autre jour - seules les bases du même jour se regroupent (échéance par objet de règlement).';
		|en = 'Basis %1 is of another day - only same-day bases are combined (debt age is per settlement object).';
		|es = 'La base %1 es de otro día - solo se agrupan bases del mismo día (el plazo de la deuda es por objeto).'");
	День = Неопределено;
	Для Каждого Элемент Из ДатыОснований Цикл
		ДеньОснования = НачалоДня(Элемент.Значение);
		Если День = Неопределено Тогда
			День = ДеньОснования;
		КонецЕсли;
		Если ДеньОснования <> День Тогда
			ДобавитьОшибку(Ошибки, Шаблон, Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьДопРасходыПоставщика(ДокОбъект, Основания, Ошибки)

	// Доставка от того же поставщика пишет долг тем же регистратором на тот же объект: товарный долг от неё не
	// отделить (ревью плана С2, круг 4) - такое поступление в С2а не покрывается.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Ссылка КАК Основание
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧДополнительныеРасходы КАК Т
	|ГДЕ
	|	Т.Ссылка В(&Основания)
	|	И Т.Контрагент = &Контрагент");
	Запрос.УстановитьПараметр("Основания", Основания);
	Запрос.УстановитьПараметр("Контрагент", ДокОбъект.Контрагент);
	Шаблон = НСтр("ru = 'В основании %1 дополнительные расходы того же поставщика - налоговый документ на него пока не оформляется.';
		|fr = 'La base %1 contient des frais annexes du même fournisseur - le document fiscal n''est pas encore émis.';
		|en = 'Basis %1 has additional costs from the same supplier - a tax document cannot be issued for it yet.';
		|es = 'La base %1 tiene gastos adicionales del mismo proveedor - aún no se emite el documento fiscal.'");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьОшибку(Ошибки, Шаблон, Выборка.Основание);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПолнотуПокрытия(ДокОбъект, Основания, Ошибки)

	// Покрытие в С2а - только целиком: каждая строка товаров основания одной строкой документа с полным количеством,
	// номенклатура и характеристика совпадают; основание без услуг (частичное покрытие и услуги - С2б).
	Текст =
	"ВЫБРАТЬ
	|	О.Основание КАК Основание,
	|	О.НомерСтрокиОснования КАК НомерСтрокиОснования,
	|	О.КодСтроки КАК КодСтроки,
	|	О.Количество КАК Количество
	|ПОМЕСТИТЬ ВТПокрытие
	|ИЗ
	|	&Покрытие КАК О
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КодСтроки КАК КодСтроки,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&Товары КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиОснований.Ссылка КАК Основание,
	|	СтрокиОснований.НомерСтроки КАК НомерСтроки,
	|	КОЛИЧЕСТВО(ВТПокрытие.КодСтроки) КАК ЧислоПокрытий,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТПокрытие.Количество = СтрокиОснований.Количество
	|					И ВТТовары.Номенклатура = СтрокиОснований.Номенклатура
	|					И ВТТовары.Характеристика = СтрокиОснований.Характеристика
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Совпадает
	|ПОМЕСТИТЬ ВТСтроки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК СтрокиОснований
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПокрытие КАК ВТПокрытие
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТТовары КАК ВТТовары
	|			ПО ВТПокрытие.КодСтроки = ВТТовары.КодСтроки
	|		ПО СтрокиОснований.Ссылка = ВТПокрытие.Основание
	|			И СтрокиОснований.НомерСтроки = ВТПокрытие.НомерСтрокиОснования
	|ГДЕ
	|	СтрокиОснований.Ссылка В(&Основания)
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиОснований.Ссылка,
	|	СтрокиОснований.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСтроки.Основание КАК Основание,
	|	ВТСтроки.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВТСтроки КАК ВТСтроки
	|ГДЕ
	|	ВТСтроки.ЧислоПокрытий * 10 + ВТСтроки.Совпадает <> 11
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПокрытие.Основание КАК Основание,
	|	ВТПокрытие.НомерСтрокиОснования КАК НомерСтроки
	|ИЗ
	|	ВТПокрытие КАК ВТПокрытие
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ТЧТовары КАК СтрокиОснований
	|		ПО ВТПокрытие.Основание = СтрокиОснований.Ссылка
	|			И ВТПокрытие.НомерСтрокиОснования = СтрокиОснований.НомерСтроки
	|ГДЕ
	|	СтрокиОснований.Ссылка ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Услуги.Ссылка КАК Основание
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧУслуги КАК Услуги
	|ГДЕ
	|	Услуги.Ссылка В(&Основания)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Авансы.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧЗачётАвансов КАК Авансы
	|ГДЕ
	|	Авансы.Ссылка В(&Основания)";
	Если Не ЭтоПродажа(ДокОбъект) Тогда
		Текст = СтрЗаменить(Текст, "Документ.РеализацияТоваровУслуг", "Документ.ПоступлениеТоваровУслуг");
	КонецЕсли;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Покрытие", ДокОбъект.Основания.Выгрузить());
	Запрос.УстановитьПараметр("Товары", ДокОбъект.ТЧТовары.Выгрузить(, "КодСтроки, Номенклатура, Характеристика"));
	Запрос.УстановитьПараметр("Основания", Основания);
	Результаты = Запрос.ВыполнитьПакет();
	ШаблонСтроки = НСтр("ru = 'Строка %2 основания %1 должна быть покрыта одной строкой с тем же товаром и полным количеством.';
		|fr = 'La ligne %2 de la base %1 doit être couverte par une seule ligne du même article, quantité entière.';
		|en = 'Line %2 of basis %1 must be covered by one line with the same item and the full quantity.';
		|es = 'La línea %2 de la base %1 debe cubrirse con una sola línea del mismo artículo y la cantidad completa.'");
	ШаблонНетСтроки = НСтр("ru = 'В основании %1 нет строки %2.'; fr = 'La base %1 n''a pas de ligne %2.';
		|en = 'Basis %1 has no line %2.'; es = 'La base %1 no tiene la línea %2.'");
	// Зачёт аванса основания пишет записи и на объект платежа - перенос их не видит (ревью плана С2, круг 11).
	ШаблонУслуг = НСтр("ru = 'Основание %1 с услугами или зачётом аванса пока не покрывается налоговым документом.';
		|fr = 'La base %1 avec services ou imputation d''avance n''est pas encore couverte par un document fiscal.';
		|en = 'Basis %1 with services or an advance offset cannot be covered by a tax document yet.';
		|es = 'La base %1 con servicios o compensación de anticipo aún no se cubre con un documento fiscal.'");
	ИндексСтрок = 3;
	ИндексЛишних = 4;
	ИндексУслуг = 5;
	Выборка = Результаты[ИндексСтрок].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьОшибку(Ошибки, ШаблонСтроки, Выборка.Основание, Выборка.НомерСтроки);
	КонецЦикла;
	Выборка = Результаты[ИндексЛишних].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьОшибку(Ошибки, ШаблонНетСтроки, Выборка.Основание, Выборка.НомерСтроки);
	КонецЦикла;
	Выборка = Результаты[ИндексУслуг].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьОшибку(Ошибки, ШаблонУслуг, Выборка.Основание);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЕдинственностьПокрытия(ДокОбъект, Основания, Ошибки)

	ШаблонПокрытия = НСтр("ru = 'Основание %1 уже покрыто налоговым документом %2.';
		|fr = 'La base %1 est déjà couverte par le document fiscal %2.';
		|en = 'Basis %1 is already covered by tax document %2.';
		|es = 'La base %1 ya está cubierta por el documento fiscal %2.'");
	Для Каждого Строка Из ПокрывающиеДокументы(Основания) Цикл
		Если Строка.Ссылка <> ДокОбъект.Ссылка Тогда
			ДобавитьОшибку(Ошибки, ШаблонПокрытия, Строка.Основание, Строка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	ШаблонНакладной = НСтр("ru = 'Основание уже покрыто налоговой накладной %1.';
		|fr = 'La base est déjà couverte par la facture fiscale %1.';
		|en = 'The basis is already covered by tax invoice %1.';
		|es = 'La base ya está cubierta por la factura fiscal %1.'");
	Для Каждого Накладная Из РаботаСДокументами.НалоговыеНакладныеПоОснованиям(Основания) Цикл
		ДобавитьОшибку(Ошибки, ШаблонНакладной, Накладная);
	КонецЦикла;
	// Сам документ не может быть основанием другого документа на основаниях или старой накладной (ревью плана С2,
	// круг 10: цепочку старой и новой накладной подписка оплат не сопровождает).
	Сам = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокОбъект.Ссылка);
	Покрыт = ДокументПокрывающийОснование(ДокОбъект.Ссылка) <> Неопределено
		Или РаботаСДокументами.НалоговыеНакладныеПоОснованиям(Сам).Количество() > 0;
	Если Не ДокОбъект.ЭтоНовый() И Покрыт Тогда
		Ошибки.Добавить(НСтр("ru = 'Документ сам покрыт налоговым документом и не может быть документом на основаниях.';
			|fr = 'Le document est lui-même couvert par un document fiscal et ne peut pas être un document sur bases.';
			|en = 'The document is itself covered by a tax document and cannot be a document on bases.';
			|es = 'El documento está cubierto por un documento fiscal y no puede ser un documento sobre bases.'"));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРасчетыОснований(ДокОбъект, Основания, Ошибки)

	// Возвраты, корректировки и сертификаты по основанию до покрытия переносить нечем сопровождать: их изменения не
	// перепроводят налоговый документ (план С2, «Возвраты»).
	Шаблон = НСтр("ru = 'По основанию уже есть расчёты документа %1 - налоговый документ оформляется до возвратов и корректировок.';
		|fr = 'La base a déjà des règlements du document %1 - le document fiscal précède retours et corrections.';
		|en = 'The basis already has settlements of document %1 - issue the tax document before returns and adjustments.';
		|es = 'La base ya tiene liquidaciones del documento %1 - el documento fiscal precede devoluciones y ajustes.'");
	Для Каждого Регистратор Из ЗависимыеРегистраторы(Основания, ЭтоПродажа(ДокОбъект), ДокОбъект.Ссылка) Цикл
		ДобавитьОшибку(Ошибки, Шаблон, Регистратор);
	КонецЦикла;

КонецПроцедуры

// Проведённый неналоговый документ при раздельном учёте - возможное основание: обычной записью он не меняет строк и
// реквизитов, от которых зависят движения, иначе налоговый документ скопировал бы строки, которых нет в движениях
// (ревью плана С2, круг 11).
//
// Параметры:
//  ДокОбъект   - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПоступлениеТоваровУслуг - записываемый документ
//  РежимЗаписи - РежимЗаписиДокумента - режим записи
//
// Возвращаемое значение:
//  Строка - текст запрета, пустая - запись разрешена
//
Функция ТекстЗапретаЗаписиНеналоговогоДокумента(ДокОбъект, РежимЗаписи)

	Если РежимЗаписи <> РежимЗаписиДокумента.Запись Или Не НалоговыйУчет.РаздельныйУчетВключен() Тогда
		Возврат "";
	КонецЕсли;
	Прежний = ДокОбъект.Ссылка.ПолучитьОбъект();
	Если Не Прежний.Проведен Или Не Прежний.УУ Тогда
		Возврат "";
	КонецЕсли;
	// BSLLS:YoLetterUsage-off - имя табличной части
	ИменаТабличныхЧастей = "ТЧТовары, ТЧСерии, ТЧУслуги, ТЧЗачётАвансов";
	// BSLLS:YoLetterUsage-on
	Если Не ДанныеДвиженийИзменены(ДокОбъект, Прежний, ИменаТабличныхЧастей,
		"УУ, Организация, Контрагент, Договор, МестоХранения, Дата, Валюта, КурсВалюты, ВВалюте") Тогда
		Возврат "";
	КонецЕсли;
	Возврат НСтр("ru = 'Проведённый неналоговый документ изменён - проведите его: обычная запись разведёт строки и движения.';
		|fr = 'Le document non fiscal validé a été modifié - validez-le : un simple enregistrement séparerait lignes et mouvements.';
		|en = 'The posted non-tax document was changed - post it: a plain write would split lines from records.';
		|es = 'El documento no fiscal contabilizado se modificó - contabilícelo: grabarlo sin más separaría líneas y movimientos.'");

КонецФункции

// Регистраторы взаиморасчётов на объектах, кроме самих объектов, платёжных документов и исключаемого документа.
//
// Параметры:
//  Объекты    - Массив из ДокументСсылка - объекты расчётов
//  ЭтоПродажа - Булево - расчёты с покупателями; Ложь - с поставщиками
//  Исключая   - ДокументСсылка, Неопределено - регистратор, которого не включать
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция ЗависимыеРегистраторы(Объекты, ЭтоПродажа, Исключая = Неопределено)

	// BSLLS:YoLetterUsage-off - имена регистров и измерения
	Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
	|ГДЕ
	|	Т.ОбъектРасчётов В(&Объекты)
	|	И Т.Регистратор <> Т.ОбъектРасчётов
	|	И Т.Регистратор <> &Исключая
	|	И НЕ ТИПЗНАЧЕНИЯ(Т.Регистратор) В (&ТипыПлатежей)";
	Если Не ЭтоПродажа Тогда
		Текст = СтрЗаменить(Текст, "ВзаиморасчётыСПокупателями", "ВзаиморасчётыСПоставщиками");
	КонецЕсли;
	// BSLLS:YoLetterUsage-on
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Объекты", Объекты);
	// Неопределено в параметре сравнения отбросило бы все строки: пустая ссылка не совпадает ни с одним регистратором.
	ПустаяСсылка = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	Запрос.УстановитьПараметр("Исключая", ?(ЗначениеЗаполнено(Исключая), Исключая, ПустаяСсылка));
	Запрос.УстановитьПараметр("ТипыПлатежей", ТипыПлатежей());
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");

КонецФункции

// Платёжные документы: их распределение по основаниям переносит налоговый документ и держит свежим подписка оплат.
//
// Возвращаемое значение:
//  Массив из Тип
//
Функция ТипыПлатежей()

	Результат = Новый Массив;
	Результат.Добавить(Тип("ДокументСсылка.ПриходныйКассовыйОрдер"));
	Результат.Добавить(Тип("ДокументСсылка.РасходныйКассовыйОрдер"));
	Результат.Добавить(Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств"));
	Результат.Добавить(Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств"));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Движения

Функция ДанныеОснований(ДокОбъект)

	// Строки документа с основаниями и суммы строк по основаниям в валюте и в основной валюте по курсу документа.
	Курс = РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс;
	Строки = ДокОбъект.ТЧТовары.Выгрузить(, "КодСтроки, Номенклатура, Характеристика, Количество, СуммаСНДС, СуммаНДС");
	Строки.Колонки.Добавить(ИмяОснования());
	ИмяКода = ИмяКодаСтроки();
	Для Каждого Строка Из Строки Цикл
		Строка.Основание = ДокОбъект.Основания.Найти(Строка.КодСтроки, ИмяКода).Основание;
	КонецЦикла;
	Основания = Строки.Скопировать(, "Основание, СуммаСНДС");
	Основания.Свернуть(ИмяОснования(), "СуммаСНДС");
	ТипСуммы = Метаданные.ОпределяемыеТипы.Сумма.Тип;
	Основания.Колонки.Добавить("СуммаРегл", ТипСуммы);
	Основания.Колонки.Добавить("СуммаОснования", ТипСуммы);
	Основания.Колонки.Добавить("СуммаОснованияРегл", ТипСуммы);
	Суммы = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Основания.ВыгрузитьКолонку(ИмяОснования()), "Сумма");
	Для Каждого Строка Из Основания Цикл
		Строка.СуммаРегл = РаботаСВалютамиКлиентСервер.СуммаРегл(Строка.СуммаСНДС, Курс);
		Строка.СуммаОснования = Суммы[Строка.Основание].Сумма;
		Строка.СуммаОснованияРегл = РаботаСВалютами.СуммаОбъектаВОсновнойВалюте(Строка.Основание, Строка.СуммаОснования);
	КонецЦикла;
	Возврат Новый Структура("Строки, Основания, Курс", Строки, Основания, Курс);

КонецФункции

Процедура ПереклассифицироватьТовары(ДокОбъект, Данные, ЭтоПродажа)

	// Каждая запись основания своего вида движения - пара записей с той же партией: физический итог не меняется,
	// количество переходит из управленческого признака в налоговый (реализация) или наоборот (поступление).
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Серия КАК Серия,
	|	Т.Партия КАК Партия,
	|	Т.ДатаПартии КАК ДатаПартии,
	|	Т.Комплект КАК Комплект,
	|	Т.Количество КАК Количество,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|ГДЕ
	|	Т.Регистратор В(&Основания)
	|	И Т.ВидДвижения = &ВидДвижения
	|	И Т.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.МоментВремени,
	|	Т.НомерСтроки");
	Запрос.УстановитьПараметр("Основания", Данные.Основания.ВыгрузитьКолонку(ИмяОснования()));
	ВидОснования = ?(ЭтоПродажа, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
	Запрос.УстановитьПараметр("ВидДвижения", ВидОснования);
	ВидОбратный = ?(ЭтоПродажа, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
	Набор = ДокОбъект.Движения.ТоварыВНаличии;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Управленческая сторона снимается обратным движением, налоговая записывается тем же видом, что у основания.
		Черная = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Черная, Выборка);
		Черная.Период = ДокОбъект.Дата;
		Черная.ВидДвижения = ВидОбратный;
		Черная.УУ = Истина;
		Белая = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Белая, Выборка);
		Белая.Период = ДокОбъект.Дата;
		Белая.ВидДвижения = ВидОснования;
		Белая.УУ = Ложь;
	КонецЦикла;

КонецПроцедуры

Процедура ПереклассифицироватьПродажи(ДокОбъект, Данные)

	// Белые выручка и НДС - строк налогового документа, распределённые по записям основания того же товара
	// пропорционально их выручке (при нулевой - количеству).
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Т.Организация КАК Организация,
	|	Т.Сотрудник КАК Сотрудник,
	|	Т.Контрагент КАК Контрагент,
	|	Т.ДокументПродажи КАК ДокументПродажи,
	|	Т.Партия КАК Партия,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Ответственный КАК Ответственный,
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.Регистратор КАК Основание,
	|	Т.Количество КАК Количество,
	|	Т.Себестоимость КАК Себестоимость,
	|	Т.ДополнительныеРасходы КАК ДополнительныеРасходы,
	|	Т.Выручка КАК Выручка,
	|	Т.НДС КАК НДС
	|ИЗ
	|	РегистрНакопления.Продажи КАК Т
	|ГДЕ
	|	Т.Регистратор В(&Основания)
	|	И Т.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки");
	Запрос.УстановитьПараметр("Основания", Данные.Основания.ВыгрузитьКолонку(ИмяОснования()));
	Записи = Запрос.Выполнить().Выгрузить();
	ТипСуммы = Метаданные.ОпределяемыеТипы.Сумма.Тип;
	Записи.Колонки.Добавить("ВыручкаНалоговая", ТипСуммы);
	Записи.Колонки.Добавить("НДСНалоговый", ТипСуммы);
	Цели = Данные.Строки.Скопировать(, "Основание, Номенклатура, Характеристика, СуммаСНДС, СуммаНДС");
	Цели.Свернуть("Основание, Номенклатура, Характеристика", "СуммаСНДС, СуммаНДС");
	Для Каждого Цель Из Цели Цикл
		Ключ = Новый Структура("Основание, Номенклатура, Характеристика", Цель.Основание, Цель.Номенклатура,
			Цель.Характеристика);
		ЗаписиКлюча = Записи.НайтиСтроки(Ключ);
		Выручка = РаботаСВалютамиКлиентСервер.СуммаРегл(Цель.СуммаСНДС, Данные.Курс);
		НДС = РаботаСВалютамиКлиентСервер.СуммаРегл(Цель.СуммаНДС, Данные.Курс);
		РаспределитьНалоговуюВыручку(ЗаписиКлюча, Выручка, НДС);
	КонецЦикла;
	// Управленческая сторона - минус каждая запись основания с налоговыми выручкой и НДС; налоговая - те же суммы,
	// свёрнутые в одну запись на товар, характеристику и партию (ключ поиска возврата) со складом документа: возврат по
	// нему находит одну запись на партию, как у обычной реализации (ревью плана С2, круги 6-7).
	Набор = ДокОбъект.Движения.Продажи;
	Для Каждого Запись Из Записи Цикл
		Черная = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Черная, Запись);
		Черная.Период = ДокОбъект.Дата;
		Черная.УУ = Истина;
		ЗаполнитьРесурсыПродаж(Черная, Запись, -1);
	КонецЦикла;
	Белые = Записи.Скопировать(, "Номенклатура, Характеристика, Партия, Количество, Себестоимость, "
		+ "ДополнительныеРасходы, ВыручкаНалоговая, НДСНалоговый");
	Белые.Свернуть("Номенклатура, Характеристика, Партия",
		"Количество, Себестоимость, ДополнительныеРасходы, ВыручкаНалоговая, НДСНалоговый");
	Для Каждого Запись Из Белые Цикл
		Белая = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Белая, Запись);
		Белая.Период = ДокОбъект.Дата;
		Белая.УУ = Ложь;
		Белая.ХозяйственнаяОперация = ДокОбъект.ХозяйственнаяОперация;
		Белая.Организация = ДокОбъект.Организация;
		Белая.Сотрудник = ДокОбъект.Менеджер;
		Белая.Контрагент = ДокОбъект.Контрагент;
		Белая.ДокументПродажи = ДокОбъект.Ссылка;
		Белая.Ответственный = ДокОбъект.Ответственный;
		Белая.МестоХранения = ДокОбъект.МестоХранения;
		ЗаполнитьРесурсыПродаж(Белая, Запись, 1);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьРесурсыПродаж(Движение, Запись, Знак)

	Движение.Количество = Знак * Запись.Количество;
	Движение.Себестоимость = Знак * Запись.Себестоимость;
	Движение.ДополнительныеРасходы = Знак * Запись.ДополнительныеРасходы;
	Движение.Выручка = Знак * Запись.ВыручкаНалоговая;
	Движение.НДС = Знак * Запись.НДСНалоговый;
	Движение.ВаловаяПрибыль = Движение.Выручка - Движение.Себестоимость - Движение.ДополнительныеРасходы;

КонецПроцедуры

Процедура РаспределитьНалоговуюВыручку(ЗаписиКлюча, Выручка, НДС)

	Если ЗаписиКлюча.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ВыручкаОснования = 0;
	КоличествоОснования = 0;
	Для Каждого Запись Из ЗаписиКлюча Цикл
		ВыручкаОснования = ВыручкаОснования + Запись.Выручка;
		КоличествоОснования = КоличествоОснования + Запись.Количество;
	КонецЦикла;
	ТочностьСуммы = 2;
	ОстатокВыручки = Выручка;
	ОстатокНДС = НДС;
	Последняя = ЗаписиКлюча[ЗаписиКлюча.ВГраница()];
	Для Каждого Запись Из ЗаписиКлюча Цикл
		Если Запись = Последняя Тогда
			Запись.ВыручкаНалоговая = ОстатокВыручки;
			Запись.НДСНалоговый = ОстатокНДС;
			Прервать;
		КонецЕсли;
		Если ВыручкаОснования <> 0 Тогда
			Доля = Запись.Выручка / ВыручкаОснования;
		ИначеЕсли КоличествоОснования <> 0 Тогда
			Доля = Запись.Количество / КоличествоОснования;
		Иначе
			Доля = 0;
		КонецЕсли;
		Запись.ВыручкаНалоговая = Окр(Выручка * Доля, ТочностьСуммы);
		Запись.НДСНалоговый = Окр(НДС * Доля, ТочностьСуммы);
		ОстатокВыручки = ОстатокВыручки - Запись.ВыручкаНалоговая;
		ОстатокНДС = ОстатокНДС - Запись.НДСНалоговый;
	КонецЦикла;

КонецПроцедуры

Процедура ПеренестиРасчеты(ДокОбъект, Данные, ЭтоПродажа)

	// Два действия (план С2, «Расчёты»): долг основания и распределённые на него платежи переходят целиком на объект
	// налогового документа в налоговом признаке; разница сумм документа и основания - парой на его объекте.
	// BSLLS:YoLetterUsage-off - имена регистров и измерения
	ИмяРегистра = ?(ЭтоПродажа, "ВзаиморасчётыСПокупателями", "ВзаиморасчётыСПоставщиками");
	Текст =
	"ВЫБРАТЬ
	|	Т.Регистратор КАК Регистратор,
	|	Т.Период КАК Период,
	|	Т.ВидДвижения КАК ВидДвижения,
	|	Т.Организация КАК Организация,
	|	Т.Контрагент КАК Контрагент,
	|	Т.Договор КАК Договор,
	|	Т.ОбъектРасчётов КАК ОбъектРасчётов,
	|	Т.Валюта КАК Валюта,
	|	Т.УУ КАК УУ,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаВВалюте КАК СуммаВВалюте,
	|	ИСТИНА КАК ДолгОснования
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
	|ГДЕ
	|	Т.ОбъектРасчётов В(&Основания)
	|	И Т.Регистратор = Т.ОбъектРасчётов
	|	И Т.Контрагент = &Контрагент
	|	И Т.Активность
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Регистратор,
	|	Т.Период,
	|	Т.ВидДвижения,
	|	Т.Организация,
	|	Т.Контрагент,
	|	Т.Договор,
	|	Т.ОбъектРасчётов,
	|	Т.Валюта,
	|	Т.УУ,
	|	Т.Сумма,
	|	Т.СуммаВВалюте,
	|	ЛОЖЬ
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
	|ГДЕ
	|	Т.ОбъектРасчётов В(&Основания)
	|	И ТИПЗНАЧЕНИЯ(Т.Регистратор) В (&ТипыПлатежей)
	|	И Т.Регистратор <> &Исключая
	|	И Т.Контрагент = &Контрагент
	|	И Т.Активность";
	Если Не ЭтоПродажа Тогда
		Текст = СтрЗаменить(Текст, "ВзаиморасчётыСПокупателями", "ВзаиморасчётыСПоставщиками");
	КонецЕсли;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Основания", Данные.Основания.ВыгрузитьКолонку(ИмяОснования()));
	Запрос.УстановитьПараметр("Контрагент", ДокОбъект.Контрагент);
	Запрос.УстановитьПараметр("ТипыПлатежей", ТипыПлатежей());
	Исключая = Неопределено;
	ДокОбъект.ДополнительныеСвойства.Свойство("ИсключаемыйРегистратор", Исключая);
	Запрос.УстановитьПараметр("Исключая", ?(ЗначениеЗаполнено(Исключая), Исключая, ДокОбъект.Ссылка));
	Набор = ДокОбъект.Движения[ИмяРегистра];
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Перенос - не раньше налогового документа: оплата до него остаётся на основании в истории остатков по объектам
		// (ревью плана С2, круг 12).
		Период = Макс(ДокОбъект.Дата, Выборка.Период);
		Сторно = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Сторно, Выборка);
		Сторно.Период = Период;
		Сторно.Сумма = -Выборка.Сумма;
		Сторно.СуммаВВалюте = -Выборка.СуммаВВалюте;
		Перенос = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Перенос, Выборка);
		Перенос.Период = Период;
		Перенос.ОбъектРасчётов = ДокОбъект.Ссылка;
		Перенос.УУ = Ложь;
	КонецЦикла;
	// BSLLS:YoLetterUsage-on
	ЗаписатьРазницуСумм(ДокОбъект, Данные, Набор, ЭтоПродажа);

КонецПроцедуры

Процедура ЗаписатьРазницуСумм(ДокОбъект, Данные, Набор, ЭтоПродажа)

	// Белый долг - сумма налогового документа в основной валюте по его курсу, фактический - сумма основания по курсу
	// основания: разница по каждому ресурсу - парой белая плюс, чёрная минус на объекте налогового документа.
	ВалютаОбъекта = РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект);
	Вид = ?(ЭтоПродажа, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
	Для Каждого Строка Из Данные.Основания Цикл
		Разница = Строка.СуммаРегл - Строка.СуммаОснованияРегл;
		РазницаВВалюте = ?(ВалютаОбъекта.ВВалюте, Строка.СуммаСНДС - Строка.СуммаОснования, 0);
		Если Разница = 0 И РазницаВВалюте = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого УУ Из ПризнакиПары() Цикл
			Знак = ?(УУ, -1, 1);
			Запись = Набор.Добавить();
			Запись.ВидДвижения = Вид;
			Запись.Период = ДокОбъект.Дата;
			Запись.Организация = ДокОбъект.Организация;
			Запись.Контрагент = ДокОбъект.Контрагент;
			Запись.Договор = ДокОбъект.Договор;
			// BSLLS:YoLetterUsage-off - имя измерения
			Запись.ОбъектРасчётов = ДокОбъект.Ссылка;
			// BSLLS:YoLetterUsage-on
			Запись.Валюта = ?(ВалютаОбъекта.ВВалюте, ВалютаОбъекта.Валюта, Неопределено);
			Запись.УУ = УУ;
			Запись.Сумма = Знак * Разница;
			Запись.СуммаВВалюте = Знак * РазницаВВалюте;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
