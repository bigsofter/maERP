#Область ПрограммныйИнтерфейс

// Налоговый документ на основаниях (docs/plans/accounting-morocco-f1-s2.md): реализация или поступление с непустой
// табличной частью Основания. Он не отгружает и не принимает товар второй раз, а переклассифицирует движения
// неналоговых документов-оснований в налоговый учёт.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПоступлениеТоваровУслуг - документ
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоДокументНаОснованиях(ДокОбъект) Экспорт

	Возврат ДокОбъект.Метаданные().ТабличныеЧасти.Найти("Основания") <> Неопределено
		И ДокОбъект.Основания.Количество() > 0;

КонецФункции

// Записан ли документ в базе как документ на основаниях - для мест, где есть только ссылка (регистратор движений).
//
// Параметры:
//  Ссылка - ДокументСсылка - регистратор или документ любого вида
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоРегистраторНаОснованиях(Ссылка) Экспорт

	Если Не ЭтоВидДокументаНаОснованиях(Ссылка) Или Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - признак вида движений читается при записи регистров, права пользователя не важны
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Найдено
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Основания КАК О
	|ГДЕ
	|	О.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	1
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Основания КАК О
	|ГДЕ
	|	О.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Проведённые документы на основаниях, покрывающие основания (по табличной части Основания в базе).
//
// Параметры:
//  Основания - Массив из ДокументСсылка - реализации и поступления
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Ссылка (документ на основаниях) и Основание, без повторов
//
Функция ПокрывающиеДокументы(Основания) Экспорт

	// BSLLS:SetPrivilegedMode-off - покрытие проверяется при записи чужих документов, права пользователя не важны
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	О.Ссылка КАК Ссылка,
	|	О.Основание КАК Основание
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Основания КАК О
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Д
	|		ПО О.Ссылка = Д.Ссылка
	|			И (Д.Проведен)
	|ГДЕ
	|	О.Основание В(&Основания)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	О.Ссылка,
	|	О.Основание
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Основания КАК О
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК Д
	|		ПО О.Ссылка = Д.Ссылка
	|			И (Д.Проведен)
	|ГДЕ
	|	О.Основание В(&Основания)");
	Запрос.УстановитьПараметр("Основания", Основания);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Проведённый документ на основаниях, покрывающий основание.
//
// Параметры:
//  Основание - ДокументСсылка - реализация или поступление
//
// Возвращаемое значение:
//  ДокументСсылка, Неопределено - покрывающий документ
//
Функция ДокументПокрывающийОснование(Основание) Экспорт

	Если Не ЭтоВидДокументаНаОснованиях(Основание) Или Не ЗначениеЗаполнено(Основание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Покрывающие = ПокрывающиеДокументы(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основание));
	Возврат ?(Покрывающие.Количество() = 0, Неопределено, Покрывающие[0].Ссылка);

КонецФункции

// Исключительная блокировка документов-оснований (реализаций и поступлений) в едином порядке - первым шагом любой
// записи, затрагивающей покрытие, до блокировки собственной записи и взаиморасчётов (план С2, «Порядок блокировок»).
// С ПолнымНабором к основаниям добавляются все основания покрывающих их документов: перепроведение такого документа
// из платежа или основания не захватит основание после взаиморасчётов.
//
// Параметры:
//  Ссылки      - Массив из ДокументСсылка - документы любого вида, берутся реализации и поступления
//  ПолныйНабор - Булево - добавить основания покрывающих документов
//
Процедура ЗаблокироватьОснования(Ссылки, ПолныйНабор = Ложь) Экспорт

	// Ссылка на сам налоговый документ (прямая оплата его) разворачивается в его основания: основания всегда берутся
	// раньше налоговых документов, двумя вызовами (ревью плана С2, круг 9).
	Набор = НаборБлокировки(Ссылки, ПолныйНабор);
	ЗаблокироватьСсылки(Набор.Основания);
	ЗаблокироватьСсылки(Набор.Документы);
	Если Не ПолныйНабор Тогда
		Возврат;
	КонецЕсли;
	// Состав покрытия мог измениться до блокировки. Добирать основания к уже взятым нельзя - это нарушит общий порядок
	// захвата и даст встречное ожидание; операция отменяется и повторяется пользователем с новым составом.
	НовыйНабор = НаборБлокировки(Ссылки, ПолныйНабор);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НовыйНабор.Основания, НовыйНабор.Документы);
	Для Каждого Ссылка Из НовыйНабор.Основания Цикл
		Если Набор.Основания.Найти(Ссылка) = Неопределено И Набор.Документы.Найти(Ссылка) = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Состав налоговых документов на основаниях изменился во время записи - повторите операцию.';
				|fr = 'La composition des documents fiscaux sur bases a changé pendant l''enregistrement - répétez l''opération.';
				|en = 'Tax documents on bases changed during the write - repeat the operation.';
				|es = 'La composición de los documentos fiscales sobre bases cambió durante la grabación - repita la operación.'");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Перепроводит проведённые документы на основаниях, покрывающие основания: их перенос расчётов и переклассификация
// строятся по движениям оснований и платежей. Вызывается в транзакции записи платежа или основания; ошибка
// перепроведения не перехватывается и отменяет всю запись.
//
// Параметры:
//  Основания              - Массив из ДокументСсылка - основания, чьи движения изменились
//  ИсключаемыйРегистратор - ДокументСсылка, Неопределено - платёж, движения которого ещё в базе, но снимаются
//  ИсточникЗаписи         - ДокументОбъект, Неопределено - записываемый документ: сам он не перепроводится
//
Процедура ПерепровестиПокрывающиеДокументы(Основания, ИсключаемыйРегистратор = Неопределено,
	ИсточникЗаписи = Неопределено) Экспорт

	Отобранные = ДокументыВидаНаОснованиях(Основания);
	Если Отобранные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Покрывающие = ПокрывающиеДокументы(Отобранные);
	Покрывающие.Свернуть("Ссылка");
	// Техническое перепроведение: документ перечитан из базы без правок, меняются только его движения переноса и
	// переклассификации. Признак фонового перепроведения снимает прикладные проверки записи - закрытый период, итоги,
	// стадии заказов: оплата октября по основанию закрытого сентября не откатывается (ревью плана С2, круг 9).
	ИмяФона = РаботаСДокументами.СвойствоВыполняетсяФоновоеПерепроведение();
	Для Каждого Строка Из Покрывающие Цикл
		Если ИсточникЗаписи <> Неопределено И Строка.Ссылка = ИсточникЗаписи.Ссылка Тогда
			Продолжить;
		КонецЕсли;
		ДокОбъект = Строка.Ссылка.ПолучитьОбъект();
		Если ЗначениеЗаполнено(ИсключаемыйРегистратор) Тогда
			ДокОбъект.ДополнительныеСвойства.Вставить("ИсключаемыйРегистратор", ИсключаемыйРегистратор);
		КонецЕсли;
		ДокОбъект.ДополнительныеСвойства.Вставить(ИмяФона, Истина);
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;

КонецПроцедуры

#Область ДокументНаОснованиях

// Заполнение документа по данным заполнения Структура("ОснованияНалоговогоДокумента", Массив) - подбор в форме и
// команда списка. Прочие данные заполнения не обрабатываются.
//
// Параметры:
//  ДокОбъект        - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПоступлениеТоваровУслуг - документ
//  ДанныеЗаполнения - Произвольный - данные заполнения ОбработкаЗаполнения
//
Процедура ЗаполнитьПоДаннымЗаполнения(ДокОбъект, ДанныеЗаполнения) Экспорт

	Основания = Неопределено;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("ОснованияНалоговогоДокумента", Основания) Тогда
		ЗаполнитьПоОснованиям(ДокОбъект, Основания);
	КонецЕсли;

КонецПроцедуры

// Заполняет документ на основаниях по неналоговым документам того же вида: шапка - из первого основания, строки
// ТЧТовары и ТЧСерии - копии строк всех оснований с новыми кодами строк, строка Основания на каждую строку товаров.
// Основания, уже покрытые проведённым документом или уже входящие в документ, пропускаются.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПоступлениеТоваровУслуг - заполняемый документ
//  МассивОснований - Массив из ДокументСсылка - основания того же вида
//
Процедура ЗаполнитьПоОснованиям(ДокОбъект, МассивОснований) Экспорт

	Покрытые = ПокрывающиеДокументы(МассивОснований);
	Добавленные = ДокОбъект.Основания.Выгрузить().ВыгрузитьКолонку(ИмяОснования());
	КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ДокОбъект.ТЧТовары);
	ТипДокумента = ТипЗнч(ДокОбъект.Ссылка);
	Для Каждого Основание Из МассивОснований Цикл
		Пропустить = ТипЗнч(Основание) <> ТипДокумента Или Добавленные.Найти(Основание) <> Неопределено
			Или Покрытые.Найти(Основание, ИмяОснования()) <> Неопределено;
		Если Пропустить Тогда
			Продолжить;
		КонецЕсли;
		Добавленные.Добавить(Основание);
		ОснованиеОбъект = Основание.ПолучитьОбъект();
		Если ДокОбъект.Основания.Количество() = 0 Тогда
			ЗаполнитьШапкуПоОснованию(ДокОбъект, ОснованиеОбъект);
		КонецЕсли;
		Для Каждого СтрокаОснования Из ОснованиеОбъект.ТЧТовары Цикл
			ДобавитьСтрокуПоОснованию(ДокОбъект, ОснованиеОбъект, СтрокаОснования, КодСтроки);
			КодСтроки = КодСтроки + 1;
		КонецЦикла;
	КонецЦикла;
	РаботаСДокументами.ЗаполнитьИтогиДокумента(ДокОбъект);

КонецПроцедуры

// Кандидаты в основания для подбора в форме: проведённые неналоговые документы того же вида, контрагента и
// организации без услуг, сами не на основаниях и не покрытые проведённым документом.
//
// Параметры:
//  ДокОбъект - ДокументОбъект, ДанныеФормыСтруктура - документ на основаниях (Ссылка, Контрагент, Организация)
//
// Возвращаемое значение:
//  СписокЗначений из ДокументСсылка - кандидаты с представлением «номер от даты, сумма»
//
Функция КандидатыВОснования(ДокОбъект) Экспорт

	Текст =
	"ВЫБРАТЬ
	|	П.Основание КАК Основание
	|ПОМЕСТИТЬ ВТПокрытые
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Основания КАК П
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Покрывающий
	|		ПО П.Ссылка = Покрывающий.Ссылка
	|			И (Покрывающий.Проведен)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Сумма КАК Сумма
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Д
	|ГДЕ
	|	Д.Проведен
	|	И НЕ Д.ПометкаУдаления
	|	И Д.УУ
	|	И Д.Контрагент = &Контрагент
	|	И Д.Организация = &Организация
	|	И Д.Ссылка <> &Ссылка
	|	И НЕ Д.Ссылка В
	|				(ВЫБРАТЬ
	|					О.Ссылка КАК Ссылка
	|				ИЗ
	|					Документ.РеализацияТоваровУслуг.Основания КАК О)
	|	И НЕ Д.Ссылка В
	|				(ВЫБРАТЬ
	|					ВТПокрытые.Основание КАК Основание
	|				ИЗ
	|					ВТПокрытые КАК ВТПокрытые)
	|	И НЕ Д.Ссылка В
	|				(ВЫБРАТЬ
	|					У.Ссылка КАК Ссылка
	|				ИЗ
	|					Документ.РеализацияТоваровУслуг.ТЧУслуги КАК У)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	Если ТипЗнч(ДокОбъект.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Текст = СтрЗаменить(Текст, "Документ.РеализацияТоваровУслуг", "Документ.ПоступлениеТоваровУслуг");
	КонецЕсли;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Контрагент", ДокОбъект.Контрагент);
	Запрос.УстановитьПараметр("Организация", ДокОбъект.Организация);
	Запрос.УстановитьПараметр("Ссылка", ДокОбъект.Ссылка);
	Шаблон = НСтр("ru = '%1 от %2, %3'; fr = '%1 du %2, %3'; en = '%1 of %2, %3'; es = '%1 del %2, %3'");
	Результат = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Номер = СокрЛП(Выборка.Номер);
		Дата = Формат(Выборка.Дата, "ДЛФ=D");
		Сумма = Формат(Выборка.Сумма, "ЧДЦ=2");
		Результат.Добавить(Выборка.Ссылка, СтрШаблон(Шаблон, Номер, Дата, Сумма));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Перед записью реализации и поступления: у документа на основаниях - блокировка текущих и прежних оснований,
// синхронизация количества покрытия, запреты записи; у обычного документа - защита основания с момента покрытия
// (план С2, «Защита оснований»).
//
// Параметры:
//  ДокОбъект   - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПоступлениеТоваровУслуг - записываемый документ
//  РежимЗаписи - РежимЗаписиДокумента - режим записи
//  Отказ       - Булево - выставляется при запрете
//
Процедура ПередЗаписьюДокумента(ДокОбъект, РежимЗаписи, Отказ) Экспорт

	Прежние = ?(ДокОбъект.ЭтоНовый(), Новый Массив, ОснованияВБазе(ДокОбъект.Ссылка));
	Если ЭтоДокументНаОснованиях(ДокОбъект) Или Прежние.Количество() > 0 Тогда
		Текущие = ДокОбъект.Основания.Выгрузить().ВыгрузитьКолонку(ИмяОснования());
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Текущие, Прежние, Истина);
		ЗаблокироватьОснования(Текущие);
		СинхронизироватьОснования(ДокОбъект);
		СинхронизироватьСерии(ДокОбъект);
		ТекстЗапрета = ТекстЗапретаЗаписиДокумента(ДокОбъект, РежимЗаписи);
	ИначеЕсли Не ДокОбъект.ЭтоНовый() Тогда
		Сам = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокОбъект.Ссылка);
		ЗаблокироватьОснования(Сам, Истина);
		// Перепроведение покрытого основания перепроведёт покрывающий документ: товарные ключи всех его оснований - до
		// взаиморасчётов обычной ветки проведения (ревью плана С2, круг 11).
		Набор = НаборБлокировки(Сам, Истина);
		Если Набор.Документы.Количество() > 0 Тогда
			ЗаблокироватьТоварыОснований(Набор.Основания);
		КонецЕсли;
		ТекстЗапрета = ТекстЗапретаИзмененияОснования(ДокОбъект, РежимЗаписи);
		Если Не ЗначениеЗаполнено(ТекстЗапрета) Тогда
			ТекстЗапрета = ТекстЗапретаЗаписиНеналоговогоДокумента(ДокОбъект, РежимЗаписи);
		КонецЕсли;
	Иначе
		ТекстЗапрета = "";
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, , , , Отказ);
	КонецЕсли;

КонецПроцедуры

// Проведение документа на основаниях: проверки покрытия под блокировкой и движения переклассификации - товары,
// продажи (реализация) и расчёты. Ордера, автовыпуск, списание партий и прочие движения обычного документа не
// формируются. Основания заблокированы в ПередЗаписьюДокумента.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПоступлениеТоваровУслуг - проводимый документ
//  Отказ     - Булево - выставляется при ошибке
//
Процедура ПровестиДокумент(ДокОбъект, Отказ) Экспорт

	РаботаСДокументами.УстановитьЗаписьВсехРегистров(ДокОбъект.Движения);
	// Наборы формируются добавлением пар - тот же экземпляр объекта, проведённый второй раз, удвоил бы их (tiny1C
	// bsl-018): очищаются явно, физическое зеркало ведёт ТоварыВНаличии.
	ФизическийРегистр = Метаданные.РегистрыНакопления.ТоварыНаСкладах;
	Для Каждого НаборДвижений Из ДокОбъект.Движения Цикл
		Если НаборДвижений.Метаданные() <> ФизическийРегистр Тогда
			НаборДвижений.Очистить();
		КонецЕсли;
	КонецЦикла;
	ЭтоПродажа = ЭтоПродажа(ДокОбъект);
	// Товарные ключи оснований - до взаиморасчётов, как у обычной реализации: обработчик набора остатков (склады станков)
	// берёт их при записи движений (ревью плана С2, круг 10).
	Основания = УникальныеЗначения(ДокОбъект.Основания.Выгрузить().ВыгрузитьКолонку(ИмяОснования()));
	ЗаблокироватьТоварыОснований(Основания);
	Блокировка = Новый БлокировкаДанных;
	// BSLLS:YoLetterUsage-off - имена регистров
	Если ЭтоПродажа Тогда
		УправляемыеБлокировки.ВзаиморасчётыСПокупателями(Блокировка, ДокОбъект.Контрагент);
	Иначе
		УправляемыеБлокировки.ВзаиморасчётыСПоставщиками(Блокировка, ДокОбъект.Контрагент);
	КонецЕсли;
	// BSLLS:YoLetterUsage-on
	Блокировка.Заблокировать();
	ТекстОшибок = ТекстОшибокДокумента(ДокОбъект);
	Если ЗначениеЗаполнено(ТекстОшибок) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибок, , , , Отказ);
		Возврат;
	КонецЕсли;
	Данные = ДанныеОснований(ДокОбъект);
	ПереклассифицироватьТовары(ДокОбъект, Данные, ЭтоПродажа);
	Если ЭтоПродажа Тогда
		ПереклассифицироватьПродажи(ДокОбъект, Данные);
	КонецЕсли;
	ПеренестиРасчеты(ДокОбъект, Данные, ЭтоПродажа);
	ДокОбъект.Движения.Записать();

КонецПроцедуры

// Ошибки документа на основаниях, проверяемые при проведении под блокировкой оснований: опция и признак документа,
// связь строк товаров и Основания, полное покрытие каждого основания, его вид, проведённость, признак, контрагент,
// организация, договор, валюта и дата, единственность покрытия, отсутствие возвратов и прочих расчётов основания.
// Вызывается и из тестов без записи (отказ записи в транзакции теста ломает прогон).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПоступлениеТоваровУслуг - документ на основаниях
//
// Возвращаемое значение:
//  Строка - тексты ошибок через перевод строки, пустая - ошибок нет
//
Функция ТекстОшибокДокумента(ДокОбъект) Экспорт

	Ошибки = Новый Массив;
	Если Не НалоговыйУчет.РаздельныйУчетВключен() Тогда
		Ошибки.Добавить(НСтр("ru = 'Налоговый документ на основаниях вводится только при раздельном учёте.';
			|fr = 'Le document fiscal sur bases n''est saisi qu''en comptabilité séparée.';
			|en = 'A tax document on bases is entered only with separate accounting.';
			|es = 'El documento fiscal sobre bases solo se introduce con contabilidad separada.'"));
		Возврат СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	Если ДокОбъект.УУ Тогда
		Ошибки.Добавить(НСтр("ru = 'Документ на основаниях должен быть налоговым (флажок «Налоговый»).';
			|fr = 'Le document sur bases doit être fiscal (case « Fiscal »).';
			|en = 'A document on bases must be a tax document (the ""Tax"" box).';
			|es = 'El documento sobre bases debe ser fiscal (casilla «Fiscal»).'"));
	КонецЕсли;
	ПроверитьПустыеТабличныеЧасти(ДокОбъект, Ошибки);
	ПроверитьСвязьСтрок(ДокОбъект, Ошибки);
	Основания = УникальныеЗначения(ДокОбъект.Основания.Выгрузить().ВыгрузитьКолонку(ИмяОснования()));
	ПроверитьОснования(ДокОбъект, Основания, Ошибки);
	ПроверитьПолнотуПокрытия(ДокОбъект, Основания, Ошибки);
	ПроверитьЕдинственностьПокрытия(ДокОбъект, Основания, Ошибки);
	ПроверитьРасчетыОснований(ДокОбъект, Основания, Ошибки);
	Возврат СтрСоединить(Ошибки, Символы.ПС);

КонецФункции

// Запрет записи документа на основаниях (вызывается и из тестов без записи):
// - вид проведённого документа (обычный или на основаниях) не меняется - сначала отмена проведения;
// - при зависимых расчётах (возвраты, сертификаты, корректировки на его объекте) документ не распроводится, не
//   помечается и не меняет строки, основания и реквизиты расчётов и перепроведением;
// - проведённый документ обычной записью не меняет данных, от которых зависят движения: Основания в базе всегда
//   совпадают с движениями, и защита оснований читает верное покрытие.
//
// Параметры:
//  ДокОбъект   - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПоступлениеТоваровУслуг - записываемый документ
//  РежимЗаписи - РежимЗаписиДокумента - режим записи
//
// Возвращаемое значение:
//  Строка - текст запрета, пустая - запись разрешена
//
Функция ТекстЗапретаЗаписиДокумента(ДокОбъект, РежимЗаписи) Экспорт

	Если ДокОбъект.ЭтоНовый() Тогда
		Возврат "";
	КонецЕсли;
	Прежний = ДокОбъект.Ссылка.ПолучитьОбъект();
	Если Не Прежний.Проведен Тогда
		Возврат "";
	КонецЕсли;
	ПрежнийНаОснованиях = Прежний.Основания.Количество() > 0;
	ЭтоОтмена = РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
	Если Не ЭтоОтмена И ПрежнийНаОснованиях <> ЭтоДокументНаОснованиях(ДокОбъект) Тогда
		Возврат НСтр("ru = 'Проведённый документ не меняет вид (обычный или налоговый на основаниях) - сначала отмените проведение.';
			|fr = 'Un document validé ne change pas de type (ordinaire ou fiscal sur bases) - annulez d''abord la validation.';
			|en = 'A posted document does not change its kind (regular or tax on bases) - unpost it first.';
			|es = 'Un documento contabilizado no cambia de tipo (normal o fiscal sobre bases) - anule primero la contabilización.'");
	КонецЕсли;
	Если ПрежнийНаОснованиях Тогда
		ТекстЗапрета = ТекстЗапретаПриЗависимыхРасчетах(ДокОбъект, Прежний, ЭтоОтмена);
		Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
			Возврат ТекстЗапрета;
		КонецЕсли;
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Запись И ДанныеДвиженийИзменены(ДокОбъект, Прежний,
		ИменаЧастейДокумента(), "Дата, УУ, Организация, Контрагент, Договор, Валюта, КурсВалюты, ВВалюте") Тогда
		Возврат НСтр("ru = 'Проведённый налоговый документ на основаниях изменён - проведите его: обычная запись разведёт покрытие и движения.';
			|fr = 'Le document fiscal validé sur bases a été modifié - validez-le : un simple enregistrement séparerait couverture et mouvements.';
			|en = 'The posted tax document on bases was changed - post it: a plain write would split coverage from records.';
			|es = 'El documento fiscal contabilizado sobre bases se modificó - contabilícelo: grabarlo sin más separaría cobertura y movimientos.'");
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

#Область ЗащитаОснований

// Запрет изменения основания, покрытого проведённым документом на основаниях: отмена проведения, пометка на
// удаление, удаление, изменение реквизитов шапки, от которых зависят движения, и любой строки товаров и серий (покрытие
// полное); перепроведение - только без возвратов и корректировок по покрывающему документу. Вызывается и из тестов
// без записи.
//
// Параметры:
//  ДокОбъект   - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПоступлениеТоваровУслуг - основание
//  РежимЗаписи - РежимЗаписиДокумента, Неопределено - режим записи; Неопределено - удаление
//
// Возвращаемое значение:
//  Строка - текст запрета, пустая - изменение разрешено
//
Функция ТекстЗапретаИзмененияОснования(ДокОбъект, РежимЗаписи) Экспорт

	Если ДокОбъект.ЭтоНовый() Тогда
		Возврат "";
	КонецЕсли;
	Покрывающий = ДокументПокрывающийОснование(ДокОбъект.Ссылка);
	Если Покрывающий = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Причина = ПричинаЗапретаИзмененияОснования(ДокОбъект, РежимЗаписи, Покрывающий);
	Если Не ЗначениеЗаполнено(Причина) Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'Документ покрыт налоговым документом %1: %2 Сначала отмените проведение налогового документа.';
		|fr = 'Le document est couvert par le document fiscal %1 : %2 Annulez d''abord la validation du document fiscal.';
		|en = 'The document is covered by tax document %1: %2 Unpost the tax document first.';
		|es = 'El documento está cubierto por el documento fiscal %1: %2 Anule primero la contabilización del documento fiscal.'");
	Возврат СтрШаблон(Шаблон, Покрывающий, Причина);

КонецФункции

// Отказ отмены проведения и удаления (ОбработкаУдаленияПроведения, ПередУдалением): покрытого основания и документа на
// основаниях с зависимыми расчётами возвратов, сертификатов и корректировок.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПоступлениеТоваровУслуг - документ
//  Отказ     - Булево - выставляется при запрете
//  Удаление  - Булево - Истина из ПередУдалением
//
Процедура ПроверитьСнятиеДокумента(ДокОбъект, Отказ, Удаление = Ложь) Экспорт

	Если ДокОбъект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоРегистраторНаОснованиях(ДокОбъект.Ссылка) Тогда
		Зависимые = ЗависимыеРегистраторы(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокОбъект.Ссылка),
			ЭтоПродажа(ДокОбъект));
		ТекстЗапрета = ?(Зависимые.Количество() = 0, "", ТекстЗависимыхРасчетов(Зависимые[0]));
	Иначе
		ЗаблокироватьОснования(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокОбъект.Ссылка), Истина);
		Режим = ?(Удаление, Неопределено, РежимЗаписиДокумента.ОтменаПроведения);
		ТекстЗапрета = ТекстЗапретаИзмененияОснования(ДокОбъект, Режим);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, , , , Отказ);
	КонецЕсли;

КонецПроцедуры

// Корректировка долга по покрытому основанию запрещена: она пишет на объект основания, долг которого уже на
// налоговом документе, и контроль положительных остатков завысил бы задолженность (ревью плана С2, круг 4).
// Корректировка на самом налоговом документе разрешена - она запрещает его распроведение и изменение.
//
// Параметры:
//  Корректировка - ДокументОбъект.КорректировкаДолга - проводимая корректировка
//  Отказ         - Булево - выставляется при запрете
//
Процедура ПроверитьКорректировкуДолга(Корректировка, Отказ) Экспорт

	Объекты = Корректировка.ТЧДебиторскаяЗадолженность.Выгрузить().ВыгрузитьКолонку("ОбъектРасчётов");
	Кредиторская = Корректировка.ТЧКредиторскаяЗадолженность.Выгрузить().ВыгрузитьКолонку("ОбъектРасчётов");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Объекты, Кредиторская, Истина);
	ЗаблокироватьОснования(Объекты, Истина);
	Шаблон = НСтр("ru = 'Документ %1 покрыт налоговым документом %2 - корректируйте долг по налоговому документу.';
		|fr = 'Le document %1 est couvert par le document fiscal %2 - corrigez la dette sur le document fiscal.';
		|en = 'Document %1 is covered by tax document %2 - adjust the debt on the tax document.';
		|es = 'El documento %1 está cubierto por el documento fiscal %2 - ajuste la deuda en el documento fiscal.'");
	Для Каждого Строка Из ПокрывающиеДокументы(Объекты) Цикл
		Текст = СтрШаблон(Шаблон, Строка.Основание, Строка.Ссылка);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , , , Отказ);
	КонецЦикла;

КонецПроцедуры

// Возврат и сертификат по основанию (план С2, «Возвраты и сертификаты»): по покрытому основанию не оформляются - только
// по налоговому документу; возврат по налоговому документу на основаниях - налоговый. Проверка под блокировкой
// оснований - общей с проведением налогового документа.
//
// Параметры:
//  ДокОбъект   - ДокументОбъект.ВозвратОтПокупателя, ДокументОбъект.ВозвратПоставщику, ДокументОбъект.СертификатНаОплату
//  Основание   - ДокументСсылка - реализация или поступление, по которому оформлен документ
//  РежимЗаписи - РежимЗаписиДокумента - режим записи
//  Отказ       - Булево - выставляется при запрете
//
Процедура ПроверитьДокументПоОснованию(ДокОбъект, Основание, РежимЗаписи, Отказ) Экспорт

	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Или Не ЭтоВидДокументаНаОснованиях(Основание)
		Или Не ЗначениеЗаполнено(Основание) Тогда
		Возврат;
	КонецЕсли;
	ЗаблокироватьОснования(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основание), Истина);
	ТекстЗапрета = ТекстЗапретаДокументаПоОснованию(ДокОбъект, Основание);
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, , , , Отказ);
	КонецЕсли;

КонецПроцедуры

// Текст запрета возврата или сертификата по основанию (см. ПроверитьДокументПоОснованию); тесты зовут без записи.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВозвратОтПокупателя, ДокументОбъект.ВозвратПоставщику, ДокументОбъект.СертификатНаОплату
//  Основание - ДокументСсылка - реализация или поступление
//
// Возвращаемое значение:
//  Строка - пустая, если запрета нет
//
Функция ТекстЗапретаДокументаПоОснованию(ДокОбъект, Основание) Экспорт

	Покрывающий = ДокументПокрывающийОснование(Основание);
	Если Покрывающий <> Неопределено Тогда
		Шаблон = НСтр("ru = 'Документ %1 покрыт налоговым документом %2 - оформите документ по налоговому документу.';
			|fr = 'Le document %1 est couvert par le document fiscal %2 - établissez le document sur le document fiscal.';
			|en = 'Document %1 is covered by tax document %2 - base the document on the tax document.';
			|es = 'El documento %1 está cubierto por el documento fiscal %2 - emita el documento sobre el documento fiscal.'");
		Возврат СтрШаблон(Шаблон, Основание, Покрывающий);
	КонецЕсли;
	// Возврат поставщику по налоговому поступлению разорвал бы связь с заказами и потребностями производства, которые
	// читают Основание поступления (ревью плана С2, круг 8): Avoir поставщика - Ф2, возврат - до налогового документа.
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику") И ЭтоРегистраторНаОснованиях(Основание) Тогда
		Возврат НСтр("ru = 'Возврат поставщику по налоговому поступлению на основаниях пока недоступен - сделайте его до налогового документа.';
			|fr = 'Le retour fournisseur sur une réception fiscale sur bases n''est pas encore possible - faites-le avant le document fiscal.';
			|en = 'A return to supplier on a tax receipt on bases is not available yet - make the return before the tax document.';
			|es = 'La devolución al proveedor sobre una recepción fiscal sobre bases aún no es posible - hágala antes del documento fiscal.'");
	КонецЕсли;
	ЕстьПризнак = ДокОбъект.Метаданные().Реквизиты.Найти("УУ") <> Неопределено;
	Если ЕстьПризнак И ДокОбъект.УУ И ЭтоРегистраторНаОснованиях(Основание) Тогда
		Возврат НСтр("ru = 'Возврат по налоговому документу на основаниях - налоговый (флажок «Налоговый»).';
			|fr = 'Le retour sur un document fiscal sur bases est fiscal (case « Fiscal »).';
			|en = 'A return on a tax document on bases is a tax return (the ""Tax"" box).';
			|es = 'La devolución sobre un documento fiscal sobre bases es fiscal (casilla «Fiscal»).'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Блокировка остатков по складам и номенклатуре движений оснований (склады - разделяемо, затем остатки и физический
// регистр) - ключи, которые документ на основаниях перепишет; берётся до взаиморасчётов.
//
// Параметры:
//  Основания - Массив из ДокументСсылка - основания документа на основаниях
//
Процедура ЗаблокироватьТоварыОснований(Основания) Экспорт

	Если Основания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|ГДЕ
	|	Т.Регистратор В(&Основания)");
	Запрос.УстановитьПараметр("Основания", Основания);
	Ключи = Запрос.Выполнить().Выгрузить();
	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИмяСклада = "МестоХранения";
	Склады = Ключи.Скопировать(, ИмяСклада);
	Склады.Свернуть(ИмяСклада);
	Блокировка = Новый БлокировкаДанных;
	УправляемыеБлокировки.МестаХранения(Блокировка, Склады.ВыгрузитьКолонку(ИмяСклада), Ложь);
	Для Каждого Склад Из Склады Цикл
		Позиции = Ключи.Скопировать(Новый Структура(ИмяСклада, Склад.МестоХранения), "Номенклатура");
		УправляемыеБлокировки.ТоварыВНаличии(Блокировка, Позиции, Склад.МестоХранения);
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

#КонецОбласти

#Область ПодпискаОплат

// Перед записью платежа: прежние основания - в ДополнительныеСвойства.ПрежниеОснованияОплаты (перенос распределения
// на другое основание обновляет документ прежнего основания), блокировка полного набора оснований текущих и прежних
// до блокировки взаиморасчётов платежом.
//
// Параметры:
//  Платеж - ДокументОбъект - ПКО, РКО, безналичные поступление или списание
//
Процедура ПередЗаписьюПлатежа(Платеж) Экспорт

	// Прежние основания - и из таблицы, и из движений: обычная запись могла сменить таблицу без перепроведения
	// (ревью плана С2, круг 6).
	Прежние = ?(Платеж.ЭтоНовый(), Новый Массив, ОснованияПлатежаВБазе(Платеж.Ссылка));
	Платеж.ДополнительныеСвойства.Вставить("ПрежниеОснованияОплаты", Прежние);
	Все = Платеж.ТЧОснования.Выгрузить().ВыгрузитьКолонку(ИмяОснования());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Все, Прежние, Истина);
	ЗаблокироватьОснования(Все, Истина);
	// Перепроведение зависимых документов из подписки запишет их товарные движения - ключи берутся до взаиморасчётов
	// платежа.
	Набор = НаборБлокировки(Все, Истина);
	Если Набор.Документы.Количество() > 0 Тогда
		ЗаблокироватьТоварыОснований(Набор.Основания);
	КонецЕсли;

КонецПроцедуры

// Отказ прямого удаления проведённого платежа, распределённого на покрытые основания: сначала отмена проведения
// (подписка перепроведёт налоговый документ), иначе перенос оплаты останется без платежа.
//
// Параметры:
//  Платеж - ДокументОбъект - ПКО, РКО, безналичные поступление или списание
//  Отказ  - Булево - выставляется при запрете
//
Процедура ПроверитьУдалениеПлатежа(Платеж, Отказ) Экспорт

	Основания = ОснованияПлатежаВБазе(Платеж.Ссылка);
	ЗаблокироватьОснования(Основания, Истина);
	Покрывающие = ПокрывающиеДокументы(ДокументыВидаНаОснованиях(Основания));
	Если Покрывающие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Оплата перенесена на налоговый документ %1 - сначала отмените проведение платежа.';
		|fr = 'Le paiement est reporté sur le document fiscal %1 - annulez d''abord la validation du paiement.';
		|en = 'The payment is carried to tax document %1 - unpost the payment first.';
		|es = 'El pago se trasladó al documento fiscal %1 - anule primero la contabilización del pago.'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Покрывающие[0].Ссылка), , , , Отказ);

КонецПроцедуры

// Перепроводит документы на основаниях по текущим и прежним основаниям платежа - после его проведения или отмены.
//
// Параметры:
//  Платеж - ДокументОбъект - ПКО, РКО, безналичные поступление или списание
//  Отмена - Булево - отмена проведения: движения платежа ещё в базе, чтение их исключает
//
Процедура ПерепровестиПоПлатежу(Платеж, Отмена = Ложь) Экспорт

	Основания = Платеж.ТЧОснования.Выгрузить().ВыгрузитьКолонку(ИмяОснования());
	Прежние = Неопределено;
	Если Платеж.ДополнительныеСвойства.Свойство("ПрежниеОснованияОплаты", Прежние) Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Основания, Прежние, Истина);
	КонецЕсли;
	ИсключаемыйРегистратор = ?(Отмена, Платеж.Ссылка, Неопределено);
	ПерепровестиПокрывающиеДокументы(Основания, ИсключаемыйРегистратор, Платеж);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоВидДокументаНаОснованиях(Ссылка)

	Возврат ТипЗнч(Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг");

КонецФункции

// Признаки пары записей переклассификации: белая (Ложь) и чёрная (Истина).
//
// Возвращаемое значение:
//  Массив из Булево
//
Функция ПризнакиПары()

	Результат = Новый Массив;
	Результат.Добавить(Ложь);
	Результат.Добавить(Истина);
	Возврат Результат;

КонецФункции

Функция УникальныеЗначения(Значения)

	Результат = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Значения, Истина);
	Возврат Результат;

КонецФункции

// Колонка документа-основания в табличной части Основания и таблицах покрытия.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяОснования()

	Возврат "Основание";

КонецФункции

// Колонка связи строки товаров документа со строкой Основания.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяКодаСтроки()

	Возврат "КодСтроки";

КонецФункции

Функция ЭтоПродажа(ДокОбъект)

	Возврат ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг");

КонецФункции

Функция ДокументыВидаНаОснованиях(Ссылки)

	Результат = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		Если ЭтоВидДокументаНаОснованиях(Ссылка) И ЗначениеЗаполнено(Ссылка) Тогда
			Результат.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат УникальныеЗначения(Результат);

КонецФункции

// Набор блокировки: основания (неналоговые документы) и налоговые документы на основаниях - отдельно, чтобы
// основания всегда брались первыми.
//
// Параметры:
//  Ссылки      - Массив из ДокументСсылка - документы любого вида
//  ПолныйНабор - Булево - добавить покрывающие документы оснований и их основания
//
// Возвращаемое значение:
//  Структура - Основания, Документы (Массив из ДокументСсылка)
//
Функция НаборБлокировки(Ссылки, ПолныйНабор)

	Основания = Новый Массив;
	НалоговыеДокументы = Новый Массив;
	Для Каждого Ссылка Из ДокументыВидаНаОснованиях(Ссылки) Цикл
		СвоиОснования = ОснованияВБазе(Ссылка);
		Если СвоиОснования.Количество() = 0 Тогда
			Основания.Добавить(Ссылка);
		Иначе
			НалоговыеДокументы.Добавить(Ссылка);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Основания, СвоиОснования, Истина);
		КонецЕсли;
	КонецЦикла;
	Если ПолныйНабор И Основания.Количество() > 0 Тогда
		Покрывающие = ПокрывающиеДокументы(Основания);
		Покрывающие.Свернуть("Ссылка");
		Для Каждого Строка Из Покрывающие Цикл
			НалоговыеДокументы.Добавить(Строка.Ссылка);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Основания, ОснованияВБазе(Строка.Ссылка), Истина);
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("Основания, Документы", УникальныеЗначения(Основания), УникальныеЗначения(НалоговыеДокументы));

КонецФункции

Процедура ЗаблокироватьСсылки(Ссылки)

	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// Единый порядок захвата - по уникальному идентификатору: два сеанса с пересекающимися наборами не возьмут
	// основания встречно.
	Порядок = Новый СписокЗначений;
	Для Каждого Ссылка Из Ссылки Цикл
		Порядок.Добавить(Ссылка, Строка(Ссылка.УникальныйИдентификатор()));
	КонецЦикла;
	Порядок.СортироватьПоПредставлению();
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Элемент Из Порядок Цикл
		ЭлементБлокировки = Блокировка.Добавить(Элемент.Значение.Метаданные().ПолноеИмя());
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Элемент.Значение);
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

Функция ОснованияВБазе(Ссылка)

	// BSLLS:SetPrivilegedMode-off - состав покрытия читается при записи чужих документов
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	О.Основание КАК Основание
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Основания КАК О
	|ГДЕ
	|	О.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	О.Основание
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Основания КАК О
	|ГДЕ
	|	О.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат УникальныеЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(ИмяОснования()));

КонецФункции

Функция ОснованияПлатежаВБазе(Ссылка)

	// BSLLS:SetPrivilegedMode-off - прежнее распределение платежа читается при его записи
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	// BSLLS:YoLetterUsage-off - имена регистров и измерения
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Основание КАК Основание
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер.ТЧОснования КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Основание
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер.ТЧОснования КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Основание
	|ИЗ
	|	Документ.ПоступлениеБезналичныхДенежныхСредств.ТЧОснования КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Основание
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств.ТЧОснования КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.ОбъектРасчётов
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
	|ГДЕ
	|	Т.Регистратор = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.ОбъектРасчётов
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т
	|ГДЕ
	|	Т.Регистратор = &Ссылка");
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат УникальныеЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(ИмяОснования()));

КонецФункции

Процедура ЗаполнитьШапкуПоОснованию(ДокОбъект, ОснованиеОбъект)

	ДокОбъект.Организация = ОснованиеОбъект.Организация;
	ДокОбъект.Контрагент = ОснованиеОбъект.Контрагент;
	ДокОбъект.Договор = ОснованиеОбъект.Договор;
	ДокОбъект.МестоХранения = ОснованиеОбъект.МестоХранения;
	ДокОбъект.ХозяйственнаяОперация = ОснованиеОбъект.ХозяйственнаяОперация;
	ДокОбъект.ЦенаВключаетНДС = ОснованиеОбъект.ЦенаВключаетНДС;
	ДокОбъект.УУ = Ложь;
	// Валюта и курс - основания: суммы строк сравниваются с долгом основания в его валюте.
	РаботаСВалютами.ЗаполнитьВалютуПоОснованию(ДокОбъект, ОснованиеОбъект.Ссылка, Истина);

КонецПроцедуры

Процедура ДобавитьСтрокуПоОснованию(ДокОбъект, ОснованиеОбъект, СтрокаОснования, КодСтроки)

	// Строка налогового документа ордеров не оформляет: связь со строкой ордера основания не переносится.
	НоваяСтрока = ДокОбъект.ТЧТовары.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОснования, , "КодСтроки, Ордер, КлючСтрокиОрдера");
	НоваяСтрока.КодСтроки = КодСтроки;
	Если СтрокаОснования.КодСтроки <> 0 Тогда
		Отбор = Новый Структура(ИмяКодаСтроки(), СтрокаОснования.КодСтроки);
		Для Каждого СтрокаСерии Из ОснованиеОбъект.ТЧСерии.НайтиСтроки(Отбор) Цикл
			НоваяСерия = ДокОбъект.ТЧСерии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСерия, СтрокаСерии);
			НоваяСерия.КодСтроки = КодСтроки;
		КонецЦикла;
	КонецЕсли;
	СтрокаПокрытия = ДокОбъект.Основания.Добавить();
	СтрокаПокрытия.Основание = ОснованиеОбъект.Ссылка;
	СтрокаПокрытия.НомерСтрокиОснования = СтрокаОснования.НомерСтроки;
	СтрокаПокрытия.КодСтроки = КодСтроки;
	СтрокаПокрытия.Количество = СтрокаОснования.Количество;

КонецПроцедуры

Процедура СинхронизироватьОснования(ДокОбъект)

	// Покрытое количество - количество связанной строки товаров; строка Основания без строки товаров удаляется.
	Индекс = ДокОбъект.Основания.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаПокрытия = ДокОбъект.Основания[Индекс];
		Индекс = Индекс - 1;
		СтрокаТоваров = ДокОбъект.ТЧТовары.Найти(СтрокаПокрытия.КодСтроки, ИмяКодаСтроки());
		Если СтрокаПокрытия.КодСтроки = 0 Или СтрокаТоваров = Неопределено Тогда
			ДокОбъект.Основания.Удалить(СтрокаПокрытия);
		Иначе
			СтрокаПокрытия.Количество = СтрокаТоваров.Количество;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Серии строк документа на основаниях - всегда серии строк оснований: переклассификация пишет партии и серии
// оснований, и возврат по документу должен найти их же (ревью данных С2, круг 1).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ПоступлениеТоваровУслуг - документ на основаниях
//
Процедура СинхронизироватьСерии(ДокОбъект)

	Если Не ЭтоДокументНаОснованиях(ДокОбъект) Тогда
		Возврат;
	КонецЕсли;
	ДокОбъект.ТЧСерии.Очистить();
	Объекты = Новый Соответствие;
	ИмяКода = ИмяКодаСтроки();
	Для Каждого СтрокаПокрытия Из ДокОбъект.Основания Цикл
		ОснованиеОбъект = Объекты[СтрокаПокрытия.Основание];
		Если ОснованиеОбъект = Неопределено Тогда
			ОснованиеОбъект = СтрокаПокрытия.Основание.ПолучитьОбъект();
			Объекты.Вставить(СтрокаПокрытия.Основание, ОснованиеОбъект);
		КонецЕсли;
		НомерСтроки = СтрокаПокрытия.НомерСтрокиОснования;
		СтрокаТоваров = ДокОбъект.ТЧТовары.Найти(СтрокаПокрытия.КодСтроки, ИмяКода);
		СтрокаНайдена = ОснованиеОбъект <> Неопределено И СтрокаТоваров <> Неопределено
			И НомерСтроки >= 1 И НомерСтроки <= ОснованиеОбъект.ТЧТовары.Количество();
		Если Не СтрокаНайдена Тогда
			Продолжить;
		КонецЕсли;
		СтрокаОснования = ОснованиеОбъект.ТЧТовары[НомерСтроки - 1];
		СтрокаТоваров.Серия = СтрокаОснования.Серия;
		СтрокаТоваров.УказаноНесколькоСерий = СтрокаОснования.УказаноНесколькоСерий;
		Если СтрокаОснования.КодСтроки = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура(ИмяКода, СтрокаОснования.КодСтроки);
		Для Каждого СтрокаСерии Из ОснованиеОбъект.ТЧСерии.НайтиСтроки(Отбор) Цикл
			НоваяСерия = ДокОбъект.ТЧСерии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСерия, СтрокаСерии);
			НоваяСерия.КодСтроки = СтрокаПокрытия.КодСтроки;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ДанныеДвиженийИзменены(ДокОбъект, Прежний, ИменаТабличныхЧастей, ИменаРеквизитов)

	Для Каждого Имя Из СтрРазделить(ИменаРеквизитов, ", ", Ложь) Цикл
		Если ДокОбъект[Имя] <> Прежний[Имя] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить(ИменаТабличныхЧастей, ", ", Ложь) Цикл
		Новые = ЗначениеВСтрокуВнутр(ДокОбъект[Имя].Выгрузить());
		Если Новые <> ЗначениеВСтрокуВнутр(Прежний[Имя].Выгрузить()) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ТекстЗапретаПриЗависимыхРасчетах(ДокОбъект, Прежний, ЭтоОтмена)

	// Возвраты, сертификаты и корректировки на объекте документа построены по его строкам, партиям и ценам: документ не
	// распроводится, не помечается и не меняется и перепроведением, пока они есть (ревью плана С2, круги 4-5).
	ЭтоПометка = ДокОбъект.ПометкаУдаления И Не Прежний.ПометкаУдаления;
	Изменен = ДанныеДвиженийИзменены(ДокОбъект, Прежний, ИменаЧастейДокумента(),
		"Дата, УУ, Организация, Контрагент, Договор, Валюта, КурсВалюты, ВВалюте");
	Если Не ЭтоОтмена И Не ЭтоПометка И Не Изменен Тогда
		Возврат "";
	КонецЕсли;
	Зависимые = ЗависимыеРегистраторы(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокОбъект.Ссылка),
		ЭтоПродажа(ДокОбъект));
	Возврат ?(Зависимые.Количество() = 0, "", ТекстЗависимыхРасчетов(Зависимые[0]));

КонецФункции

Функция ПричинаЗапретаИзмененияОснования(ДокОбъект, РежимЗаписи, Покрывающий)

	Прежний = ДокОбъект.Ссылка.ПолучитьОбъект();
	Если РежимЗаписи = Неопределено Тогда
		Причина = НСтр("ru = 'его нельзя удалить.'; fr = 'il ne peut pas être supprimé.'; en = 'it cannot be deleted.';
			|es = 'no se puede eliminar.'");
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Причина = НСтр("ru = 'его нельзя распровести.'; fr = 'sa validation ne peut pas être annulée.';
			|en = 'it cannot be unposted.'; es = 'no se puede anular su contabilización.'");
	ИначеЕсли ДокОбъект.ПометкаУдаления И Не Прежний.ПометкаУдаления Тогда
		Причина = НСтр("ru = 'его нельзя пометить на удаление.'; fr = 'il ne peut pas être marqué pour suppression.';
			|en = 'it cannot be marked for deletion.'; es = 'no se puede marcar para eliminar.'");
	ИначеЕсли ДанныеДвиженийИзменены(ДокОбъект, Прежний, ИменаЗамороженныхЧастей(),
		"УУ, Организация, Контрагент, Договор, МестоХранения, Дата, Валюта, КурсВалюты, ВВалюте") Тогда
		Причина = НСтр("ru = 'его строки и реквизиты, от которых зависят движения, не меняются.';
			|fr = 'ses lignes et attributs dont dépendent les mouvements ne changent pas.';
			|en = 'its lines and the attributes its records depend on cannot change.';
			|es = 'sus líneas y los atributos de los que dependen los movimientos no cambian.'");
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Проведение И ЕстьЗависимыеРасчеты(Покрывающий, ЭтоПродажа(ДокОбъект)) Тогда
		// Перепроведение основания может сменить партии, а возвраты по налоговому документу их уже прочитали.
		Причина = НСтр("ru = 'по налоговому документу есть возвраты или корректировки - перепроведение сменило бы их партии.';
			|fr = 'le document fiscal a des retours ou corrections - une revalidation changerait leurs lots.';
			|en = 'the tax document has returns or adjustments - reposting would change their batches.';
			|es = 'el documento fiscal tiene devoluciones o ajustes - recontabilizar cambiaría sus lotes.'");
	Иначе
		Причина = "";
	КонецЕсли;
	Возврат Причина;

КонецФункции

