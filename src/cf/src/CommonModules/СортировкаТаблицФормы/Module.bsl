// Своя сортировка таблиц формы на значениях (таблица и дерево): у них нет сортировки кликом по шапке, а штатная
// команда «Сортировать» не переживает перезаполнение таблицы кодом. Порядок запоминается в строковом реквизите формы
// «ПорядокТаблиц» и применяется после каждого заполнения таблицы (план docs/plans/arm-sorting.md).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Запоминает порядок таблицы формы по колонке поля и сортирует таблицу.
//
// Параметры:
//  Форма             - ФормаКлиентскогоПриложения - форма со строковым реквизитом «ПорядокТаблиц».
//  ИмяТаблицы        - Строка - имя таблицы формы; совпадает с именем реквизита-коллекции.
//  ИмяПоля           - Строка - имя поля таблицы, по колонке которого сортировать.
//  Убывание          - Булево - по убыванию.
//  ОтборНезаписанных - Структура, Неопределено - см. ПрименитьПорядок.
//
// Возвращаемое значение:
//  Булево - Ложь: у поля нет колонки в данных таблицы (картинка, группа), порядок не изменён.
//
Функция УстановитьПорядок(Форма, ИмяТаблицы, ИмяПоля, Убывание, ОтборНезаписанных = Неопределено) Экспорт

	Колонка = КолонкаПоля(Форма, ИмяТаблицы, ИмяПоля);
	Если Колонка = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Порядки = ПорядкиТаблиц(Форма.ПорядокТаблиц);
	Порядки.Вставить(ИмяТаблицы, Новый Структура("Колонка, Убывание", Колонка, Убывание));
	Форма.ПорядокТаблиц = СтрокаПорядков(Порядки);
	ПрименитьПорядок(Форма, ИмяТаблицы, ОтборНезаписанных);
	Возврат Истина;

КонецФункции

// Сортирует таблицу формы по запомненному порядку; порядка нет - ничего не делает. Вызывается сразу после заполнения
// таблицы кодом и до возврата курсора по ключу строки. Сортировка устойчивая: строки с равным ключом сохраняют прежний
// взаимный порядок; строки таблицы переставляются на месте - их идентификаторы и текущая строка сохраняются.
// Колонка на видимом поле таблицы не нашлась (режим таблицы сменил колонки) - порядок сбрасывается.
//
// Параметры:
//  Форма             - ФормаКлиентскогоПриложения - форма со строковым реквизитом «ПорядокТаблиц».
//  ИмяТаблицы        - Строка - имя таблицы формы.
//  ОтборНезаписанных - Структура, Неопределено - отбор незаписанных строк таблицы (например
//                      Новый Структура("Записана", Ложь)): они остаются в начале в прежнем порядке. У таблицы без
//                      колонок отбора не применяется.
//  Дерево            - ДеревоЗначений, Неопределено - дерево, которое вызывающий загрузит в реквизит-дерево сам:
//                      сортируется оно, реквизит формы не перечитывается. Неопределено - у реквизита-дерева
//                      сортируются данные формы (текущая строка и развёрнутость узлов при этом теряются).
//
Процедура ПрименитьПорядок(Форма, ИмяТаблицы, ОтборНезаписанных = Неопределено, Дерево = Неопределено) Экспорт

	Порядки = ПорядкиТаблиц(Форма.ПорядокТаблиц);
	Порядок = Порядки.Получить(ИмяТаблицы);
	Если Порядок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не КолонкаВидна(Форма, ИмяТаблицы, Порядок.Колонка) Тогда
		Порядки.Удалить(ИмяТаблицы);
		Форма.ПорядокТаблиц = СтрокаПорядков(Порядки);
		ПоказатьПорядокВШапке(Форма, ИмяТаблицы, "", Ложь);
		Возврат;
	КонецЕсли;
	Колонки = Новый Структура;
	Для Каждого Реквизит Из Форма.ПолучитьРеквизиты(ИмяТаблицы) Цикл
		Колонки.Вставить(Реквизит.Имя);
	КонецЦикла;
	КолонкаКлюча = КолонкаКлюча(Колонки, Порядок.Колонка);
	Если Дерево <> Неопределено Тогда
		УпорядочитьУровниДерева(Дерево.Строки, КолонкаКлюча, Порядок.Убывание);
	ИначеЕсли ТипЗнч(Форма[ИмяТаблицы]) = Тип("ДанныеФормыДерево") Тогда
		ТекущиеЗначения = ЗначенияТекущейСтрокиДерева(Форма, ИмяТаблицы, Колонки);
		ДеревоФормы = Форма.РеквизитФормыВЗначение(ИмяТаблицы);
		УпорядочитьУровниДерева(ДеревоФормы.Строки, КолонкаКлюча, Порядок.Убывание);
		Форма.ЗначениеВРеквизитФормы(ДеревоФормы, ИмяТаблицы);
		ВернутьТекущуюСтрокуДерева(Форма, ИмяТаблицы, ТекущиеЗначения);
	Иначе
		Коллекция = Форма[ИмяТаблицы];
		Незаписанные = Новый Массив;
		Если ОтборНезаписанных <> Неопределено И ЕстьКолонки(Колонки, ОтборНезаписанных) Тогда
			Незаписанные = Коллекция.НайтиСтроки(ОтборНезаписанных);
		КонецЕсли;
		УпорядочитьСтроки(Коллекция, КолонкаКлюча, Порядок.Убывание, Незаписанные);
	КонецЕсли;
	ПоказатьПорядокВШапке(Форма, ИмяТаблицы, Порядок.Колонка, Порядок.Убывание);

КонецПроцедуры

// Устойчивая сортировка строк на месте (ядро ПрименитьПорядок, вызывается и тестами): незаписанные - первыми в прежнем
// порядке, остальные - по ключу, при равном ключе - в прежнем порядке.
//
// Параметры:
//  Коллекция    - ДанныеФормыКоллекция, ТаблицаЗначений, КоллекцияСтрокДереваЗначений - строки.
//  КолонкаКлюча - Строка - колонка ключа.
//  Убывание     - Булево - по убыванию.
//  Незаписанные - Массив - строки коллекции, которые остаются первыми.
//
Процедура УпорядочитьСтроки(Коллекция, КолонкаКлюча, Убывание, Незаписанные) Экспорт

	Ключи = Новый ТаблицаЗначений;
	Ключи.Колонки.Добавить("Строка");
	Ключи.Колонки.Добавить("Незаписана", Новый ОписаниеТипов("Число"));
	Ключи.Колонки.Добавить("Ключ");
	Ключи.Колонки.Добавить("Ключ2");
	Ключи.Колонки.Добавить("Позиция", Новый ОписаниеТипов("Число"));
	Позиция = 0;
	Для Каждого СтрокаКоллекции Из Коллекция Цикл
		СтрокаКлюча = Ключи.Добавить();
		СтрокаКлюча.Строка = СтрокаКоллекции;
		СтрокаКлюча.Позиция = Позиция;
		Позиция = Позиция + 1;
		Если Незаписанные.Найти(СтрокаКоллекции) = Неопределено Тогда
			СтрокаКлюча.Ключ = СтрокаКоллекции[КолонкаКлюча];
		Иначе
			СтрокаКлюча.Незаписана = 1;
		КонецЕсли;
	КонецЦикла;
	ЗаменитьДокументыДатами(Ключи);
	ЗаменитьСсылкиПредставлениями(Ключи);
	Направление = ?(Убывание, " Убыв", "");
	// Объект сравнения - для колонки с ключами разных типов; ссылки к этому моменту уже заменены датой или представлением:
	// СравнениеЗначений сравнивает ссылки по идентификатору.
	ПорядокКлючей = СтрШаблон("Незаписана Убыв, Ключ%1, Ключ2%1, Позиция", Направление);
	Ключи.Сортировать(ПорядокКлючей, Новый СравнениеЗначений);
	Для Индекс = 0 По Ключи.Количество() - 1 Цикл
		// Сдвиг - по индексу, а не по строке: ДанныеФормыКоллекция.Сдвинуть строку не принимает («Несоответствие типов»,
		// найдено владельцем 2026-11-21); индекс принимают и таблица значений, и строки дерева.
		ИндексСтроки = Коллекция.Индекс(Ключи[Индекс].Строка);
		Если ИндексСтроки <> Индекс Тогда
			Коллекция.Сдвинуть(ИндексСтроки, Индекс - ИндексСтроки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьКолонки(Колонки, Отбор)

	Для Каждого КлючИЗначение Из Отбор Цикл
		Если Не Колонки.Свойство(КлючИЗначение.Ключ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Значения колонок текущей строки дерева формы - по ним строка находится после перезагрузки дерева.
//
// Параметры:
//  Форма      - ФормаКлиентскогоПриложения - форма.
//  ИмяТаблицы - Строка - таблица-дерево формы.
//  Колонки    - Структура - ключи - имена колонок дерева.
//
// Возвращаемое значение:
//  Структура, Неопределено - значения колонок; Неопределено - текущей строки нет.
//
Функция ЗначенияТекущейСтрокиДерева(Форма, ИмяТаблицы, Колонки)

	Идентификатор = Форма.Элементы[ИмяТаблицы].ТекущаяСтрока;
	Если Идентификатор = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтрокаДерева = Форма[ИмяТаблицы].НайтиПоИдентификатору(Идентификатор);
	Если СтрокаДерева = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значения = Новый Структура;
	Для Каждого КлючИЗначение Из Колонки Цикл
		Значения.Вставить(КлючИЗначение.Ключ, СтрокаДерева[КлючИЗначение.Ключ]);
	КонецЦикла;
	Возврат Значения;

КонецФункции

Процедура ВернутьТекущуюСтрокуДерева(Форма, ИмяТаблицы, Значения)

	Если Значения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаДерева = НайтиСтрокуДерева(Форма[ИмяТаблицы].ПолучитьЭлементы(), Значения);
	Если СтрокаДерева <> Неопределено Тогда
		Форма.Элементы[ИмяТаблицы].ТекущаяСтрока = СтрокаДерева.ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

Функция НайтиСтрокуДерева(СтрокиДерева, Значения)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Совпадает = Истина;
		Для Каждого КлючИЗначение Из Значения Цикл
			Если СтрокаДерева[КлючИЗначение.Ключ] <> КлючИЗначение.Значение Тогда
				Совпадает = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Совпадает Тогда
			Возврат СтрокаДерева;
		КонецЕсли;
		Найденная = НайтиСтрокуДерева(СтрокаДерева.ПолучитьЭлементы(), Значения);
		Если Найденная <> Неопределено Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Колонка данных поля таблицы: последний сегмент пути к данным «Таблица.Колонка».
//
// Параметры:
//  Форма      - ФормаКлиентскогоПриложения - форма.
//  ИмяТаблицы - Строка - таблица формы.
//  ИмяПоля    - Строка - поле таблицы.
//
// Возвращаемое значение:
//  Строка - имя колонки; пустая - поле не из этой таблицы или колонки нет в реквизите.
//
Функция КолонкаПоля(Форма, ИмяТаблицы, ИмяПоля)

	Поле = Форма.Элементы.Найти(ИмяПоля);
	Если ТипЗнч(Поле) <> Тип("ПолеФормы") Тогда
		Возврат "";
	КонецЕсли;
	Префикс = ИмяТаблицы + ".";
	Путь = Поле.ПутьКДанным;
	Если Не СтрНачинаетсяС(Путь, Префикс) Тогда
		Возврат "";
	КонецЕсли;
	Колонка = Сред(Путь, СтрДлина(Префикс) + 1);
	Если СтрНайти(Колонка, ".") > 0 Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Реквизит Из Форма.ПолучитьРеквизиты(ИмяТаблицы) Цикл
		Если Реквизит.Имя = Колонка Тогда
			Возврат Колонка;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Колонка, по значениям которой сортируется показанная колонка: у текстового представления - его значение
// («ДокументПредставление» - «Документ»), у строки основания - заказ поставщику, у строки движения «+N» - число
// («Продукция» - «ПродукцияЧисло»). Остальные - сами по себе (текст - по алфавиту).
//
// Параметры:
//  Колонки - Структура - ключи - имена колонок реквизита.
//  Колонка - Строка - показанная колонка.
//
// Возвращаемое значение:
//  Строка - имя колонки ключа.
//
Функция КолонкаКлюча(Колонки, Колонка)

	// Строка основания «Заказ … строка N» - по заказу (по его дате), если колонка заказа в таблице есть.
	Если Колонка = "СтрокаОснованияПредставление" И Колонки.Свойство("ЗаказПоставщику") Тогда
		Возврат "ЗаказПоставщику";
	КонецЕсли;
	Суффикс = "Представление";
	Если СтрЗаканчиваетсяНа(Колонка, Суффикс) Тогда
		Значение = Лев(Колонка, СтрДлина(Колонка) - СтрДлина(Суффикс));
		Если Колонки.Свойство(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Если Колонки.Свойство(Колонка + "Число") Тогда
		Возврат Колонка + "Число";
	КонецЕсли;
	Возврат Колонка;

КонецФункции

Функция КолонкаВидна(Форма, ИмяТаблицы, Колонка)

	Поля = Новый Массив;
	СобратьПоля(Форма.Элементы[ИмяТаблицы], Поля);
	ПутьКолонки = ИмяТаблицы + "." + Колонка;
	Для Каждого Поле Из Поля Цикл
		Если Поле.ПутьКДанным = ПутьКолонки И ПолеВидно(Поле, Форма.Элементы[ИмяТаблицы]) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Поле видно вместе со всеми группами колонок над ним до таблицы.
//
// Параметры:
//  Поле    - ПолеФормы - поле таблицы.
//  Таблица - ТаблицаФормы - таблица поля.
//
// Возвращаемое значение:
//  Булево - поле и его группы видимы.
//
Функция ПолеВидно(Поле, Таблица)

	Элемент = Поле;
	Пока Элемент <> Таблица Цикл
		Если Не Элемент.Видимость Тогда
			Возврат Ложь;
		КонецЕсли;
		Элемент = Элемент.Родитель;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Процедура УпорядочитьУровниДерева(Строки, КолонкаКлюча, Убывание)

	УпорядочитьСтроки(Строки, КолонкаКлюча, Убывание, Новый Массив);
	Для Каждого СтрокаДерева Из Строки Цикл
		УпорядочитьУровниДерева(СтрокаДерева.Строки, КолонкаКлюча, Убывание);
	КонецЦикла;

КонецПроцедуры

// Ключ-ссылку на документ заменяет датой документа, второй ключ - номером: представление «№ … от …» по алфавиту
// перемешало бы даты. Документы без права чтения остаются ссылками; пустая ссылка («Новый» документ строки) - раньше
// любой даты.
//
// Параметры:
//  Ключи - ТаблицаЗначений - колонки Незаписана, Ключ, Ключ2.
//
Процедура ЗаменитьДокументыДатами(Ключи)

	ТипыДокументов = Документы.ТипВсеСсылки();
	Ссылки = Новый Массив;
	Для Каждого СтрокаКлюча Из Ключи Цикл
		Если ЭтоЧитаемыйДокумент(СтрокаКлюча.Ключ, ТипыДокументов) Тогда
			Ссылки.Добавить(СтрокаКлюча.Ключ);
		КонецЕсли;
	КонецЦикла;
	Даты = ?(Ссылки.Количество() = 0, Новый Соответствие,
		ОбщегоНазначения.ЗначенияРеквизитовОбъектовРазныхТипов(Ссылки, "Дата, Номер"));
	ПустаяДата = Дата(1, 1, 1);
	Для Каждого СтрокаКлюча Из Ключи Цикл
		Если СтрокаКлюча.Незаписана = 1 Или Не ТипыДокументов.СодержитТип(ТипЗнч(СтрокаКлюча.Ключ)) Тогда
			Продолжить;
		КонецЕсли;
		ДатаНомер = Даты.Получить(СтрокаКлюча.Ключ);
		Если ДатаНомер <> Неопределено Тогда
			СтрокаКлюча.Ключ = ДатаНомер.Дата;
			СтрокаКлюча.Ключ2 = ДатаНомер.Номер;
		ИначеЕсли Не ЗначениеЗаполнено(СтрокаКлюча.Ключ) Тогда
			СтрокаКлюча.Ключ = ПустаяДата;
		Иначе
			// Документ без права чтения: заменится представлением (ЗаменитьСсылкиПредставлениями).
			СтрокаКлюча.Ключ2 = "";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Ключ-ссылку на справочник, план видов характеристик или план счетов (и документ без права чтения) заменяет
// представлением: СравнениеЗначений упорядочивает ссылки по идентификатору (сценарий СортировкаТаблицАРМ 2.0.17.32 -
// поставщики встали в обратном порядке наименований). Перечисления - тоже по представлению: порядок их описания при
// сравнении не гарантирован.
//
// Параметры:
//  Ключи - ТаблицаЗначений - колонка Ключ.
//
Процедура ЗаменитьСсылкиПредставлениями(Ключи)

	Типы = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Типы, Справочники.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Типы, ПланыВидовХарактеристик.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Типы, ПланыСчетов.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Типы, Документы.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Типы, Перечисления.ТипВсеСсылки().Типы());
	ТипыСсылок = Новый ОписаниеТипов(Типы);
	Для Каждого СтрокаКлюча Из Ключи Цикл
		Если ТипыСсылок.СодержитТип(ТипЗнч(СтрокаКлюча.Ключ)) Тогда
			СтрокаКлюча.Ключ = Строка(СтрокаКлюча.Ключ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Значение       - Произвольный - ключ строки.
//  ТипыДокументов - ОписаниеТипов - все ссылки на документы.
//
// Возвращаемое значение:
//  Булево - заполненная ссылка на документ, который пользователю можно читать.
//
Функция ЭтоЧитаемыйДокумент(Значение, ТипыДокументов)

	Если Не ТипыДокументов.СодержитТип(ТипЗнч(Значение)) Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПравоДоступа("Чтение", Метаданные.НайтиПоТипу(ТипЗнч(Значение)));

КонецФункции

// Стрелка порядка в шапке: у поля отсортированной колонки - « ▲» или « ▼», у остальных полей таблицы снимается.
//
// Параметры:
//  Форма      - ФормаКлиентскогоПриложения - форма.
//  ИмяТаблицы - Строка - таблица.
//  Колонка    - Строка - отсортированная колонка; пустая - стрелки только снимаются.
//  Убывание   - Булево - по убыванию.
//
Процедура ПоказатьПорядокВШапке(Форма, ИмяТаблицы, Колонка, Убывание)

	ПутьКолонки = ИмяТаблицы + "." + Колонка;
	Заголовки = Новый Соответствие;
	Для Каждого Реквизит Из Форма.ПолучитьРеквизиты(ИмяТаблицы) Цикл
		Заголовки.Вставить(ИмяТаблицы + "." + Реквизит.Имя, Реквизит.Заголовок);
	КонецЦикла;
	Поля = Новый Массив;
	СобратьПоля(Форма.Элементы[ИмяТаблицы], Поля);
	Для Каждого Поле Из Поля Цикл
		Заголовок = БезСтрелки(Поле.Заголовок);
		Если Колонка <> "" И Поле.ПутьКДанным = ПутьКолонки Тогда
			Если Заголовок = "" Тогда
				Заголовок = Строка(Заголовки.Получить(ПутьКолонки));
			КонецЕсли;
			Заголовок = Заголовок + ?(Убывание, " ▼", " ▲");
		КонецЕсли;
		Если Заголовок <> Поле.Заголовок Тогда
			Поле.Заголовок = Заголовок;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СобратьПоля(Группа, Поля)

	Для Каждого Элемент Из Группа.ПодчиненныеЭлементы Цикл
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТипЭлемента = Тип("ПолеФормы") Тогда
			Поля.Добавить(Элемент);
		ИначеЕсли ТипЭлемента = Тип("ГруппаФормы") Тогда
			СобратьПоля(Элемент, Поля);
		Иначе
			// Кнопки и декорации в таблице колонок не дают.
			Продолжить;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция БезСтрелки(Заголовок)

	Для Каждого Стрелка Из СтрРазделить(" ▲, ▼", ",") Цикл
		Если СтрЗаканчиваетсяНа(Заголовок, Стрелка) Тогда
			Возврат Лев(Заголовок, СтрДлина(Заголовок) - СтрДлина(Стрелка));
		КонецЕсли;
	КонецЦикла;
	Возврат Заголовок;

КонецФункции

// Порядки таблиц из реквизита формы: записи «Таблица|Колонка|0 или 1» через «;».
//
// Параметры:
//  Текст - Строка - значение реквизита формы «ПорядокТаблиц».
//
// Возвращаемое значение:
//  Соответствие - ключ - имя таблицы, значение - Структура: Колонка, Убывание.
//
Функция ПорядкиТаблиц(Знач Текст)

	Порядки = Новый Соответствие;
	Для Каждого Запись Из СтрРазделить(Текст, ";", Ложь) Цикл
		Части = СтрРазделить(Запись, "|");
		// Запись - три части: таблица, колонка, признак убывания.
		ЧастейЗаписи = 3;
		Если Части.Количество() = ЧастейЗаписи Тогда
			Порядки.Вставить(Части[0], Новый Структура("Колонка, Убывание", Части[1], Части[2] = "1"));
		КонецЕсли;
	КонецЦикла;
	Возврат Порядки;

КонецФункции

Функция СтрокаПорядков(Порядки)

	Записи = Новый Массив;
	Для Каждого КлючИЗначение Из Порядки Цикл
		Признак = ?(КлючИЗначение.Значение.Убывание, "1", "0");
		Запись = СтрШаблон("%1|%2|%3", КлючИЗначение.Ключ, КлючИЗначение.Значение.Колонка, Признак);
		Записи.Добавить(Запись);
	КонецЦикла;
	Возврат СтрСоединить(Записи, ";");

КонецФункции

#КонецОбласти

#КонецЕсли
