// Описание пользователя из объекта JSON.
//
// Параметры:
//  Описание    - Соответствие      - объект users[i]
//  Путь        - Строка            - путь поля для сообщения об ошибке
//  Отсутствуют - Массив из Строка  - пополняемый список обязательных полей, которых нет
//
// Возвращаемое значение:
//  Структура - см. ОписаниеПользователя()
//
Функция ПользовательИзJSON(Описание, Путь, Отсутствуют)

	Пользователь = ОписаниеПользователя();
	Пользователь.Логин = СокрЛП(ЗначениеПоля(Описание, "login", ""));
	Пользователь.Пароль = ЗначениеПоля(Описание, "password", "");
	Пользователь.ПолноеИмя = СокрЛП(ЗначениеПоля(Описание, "full_name", ""));
	Пользователь.Язык = СокрЛП(ЗначениеПоля(Описание, "language", ""));

	Если ПустаяСтрока(Пользователь.Логин) Тогда
		Отсутствуют.Добавить(Путь + ".login");
	КонецЕсли;
	Если ПустаяСтрока(Пользователь.Пароль) Тогда
		Отсутствуют.Добавить(Путь + ".password");
	КонецЕсли;

	Роли = ЗначениеПоля(Описание, "roles", Новый Массив);
	Если ТипЗнч(Роли) = Тип("Строка") Тогда
		Пользователь.Роли.Добавить(Роли);
	ИначеЕсли ТипЗнч(Роли) = Тип("Массив") Тогда
		Для Каждого Роль Из Роли Цикл
			Пользователь.Роли.Добавить(Строка(Роль));
		КонецЦикла;
	Иначе
		ВызватьИсключение Путь + ".roles должен быть массивом строк";
	КонецЕсли;

	Возврат Пользователь;

КонецФункции

// Значение поля JSON-объекта либо умолчание, если поля нет или оно null.
//
// Параметры:
//  Объект    - Соответствие - объект JSON
//  Ключ      - Строка       - имя поля
//  Умолчание - Произвольный - что вернуть при отсутствии
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеПоля(Объект, Ключ, Умолчание)

	Значение = Объект.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат Умолчание;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Вид контрагента по коду из payload: имя перечисления либо английский код хаба.
// Неизвестное значение - юридическое лицо.
//
// Параметры:
//  Код - Строка
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ВидыКонтрагентов
//
Функция ВидКонтрагентаПоКоду(Код)

	Значение = НРег(СокрЛП(Код));
	Если Значение = "индивидуальныйпредприниматель" Или Значение = "sole_proprietor" Или Значение = "entrepreneur" Тогда
		Вид = Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель;
	ИначеЕсли Значение = "обособленноеподразделение" Или Значение = "branch" Тогда
		Вид = Перечисления.ВидыКонтрагентов.ОбособленноеПодразделение;
	ИначеЕсли Значение = "частноелицо" Или Значение = "individual" Или Значение = "private" Тогда
		Вид = Перечисления.ВидыКонтрагентов.ЧастноеЛицо;
	Иначе
		Вид = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо;
	КонецЕсли;
	Возврат Вид;

КонецФункции

// Результат заполнения в JSON для result-файла. Паролей в результате нет по построению.
//
// Параметры:
//  Результат - Структура - см. ЗаполнитьБазу()
//
// Возвращаемое значение:
//  Строка - JSON
//
Функция РезультатВJSON(Результат)

	СписокПользователей = Новый Массив;
	Для Каждого Пользователь Из Результат.Пользователи Цикл
		СписокПользователей.Добавить(Новый Структура("login, created", Пользователь.Логин, Пользователь.Создан));
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("success", Истина);
	Данные.Вставить("organization_created", Результат.ОрганизацияСоздана);
	Данные.Вставить("organization", Строка(Результат.Организация));
	Данные.Вставить("users", СписокПользователей);
	Данные.Вставить("support_admin_created", Результат.СлужебныйАдминистраторСоздан);
	Данные.Вставить("industry_attributes_created", Результат.СозданоРеквизитовОтрасли);
	Данные.Вставить("organizations_total", Результат.ВсегоОрганизаций);
	Данные.Вставить("users_total", Результат.ВсегоПользователей);
