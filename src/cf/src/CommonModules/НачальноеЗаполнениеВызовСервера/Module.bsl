#КонецОбласти

#Область Проверки

Процедура ПроверитьПараметры(Параметры)

	Ошибки = Новый Массив;

	Если ПустаяСтрока(Параметры.Организация.Наименование) Тогда
		Ошибки.Добавить("не задано наименование организации");
	КонецЕсли;

	Логины = Новый Соответствие;
	Для Каждого Пользователь Из Параметры.Пользователи Цикл
		Логин = СокрЛП(Пользователь.Логин);
		Если ПустаяСтрока(Логин) Тогда
			Ошибки.Добавить("у пользователя не задан логин");
		ИначеЕсли Логины.Получить(НРег(Логин)) <> Неопределено Тогда
			Ошибки.Добавить("логин повторяется: " + Логин);
		Иначе
			Логины.Вставить(НРег(Логин), Истина);
		КонецЕсли;
		Если ПустаяСтрока(Пользователь.Пароль) Тогда
			Ошибки.Добавить("у пользователя " + Логин + " не задан пароль");
		КонецЕсли;
	КонецЦикла;

	Если Параметры.СлужебныйАдминистратор <> Неопределено Тогда
		Если ПустаяСтрока(Параметры.СлужебныйАдминистратор.Пароль) Тогда
			Ошибки.Добавить("у служебного администратора не задан пароль");
		КонецЕсли;
		Логин = СокрЛП(Параметры.СлужебныйАдминистратор.Логин);
		Если Не ПустаяСтрока(Логин) И Логины.Получить(НРег(Логин)) <> Неопределено Тогда
			Ошибки.Добавить("логин служебного администратора совпадает с логином пользователя: " + Логин);
		КонецЕсли;
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Ошибки, "; ");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Организация

Функция НайтиОрганизацию(Наименование)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Наименование = &Наименование
		|	И НЕ Организации.ПометкаУдаления");
	Запрос.УстановитьПараметр("Наименование", СокрЛП(Наименование));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

Функция СоздатьОрганизацию(Описание)

	Организация = Справочники.Организации.СоздатьЭлемент();
	Организация.Наименование = СокрЛП(Описание.Наименование);
	Организация.ВидКонтрагента = Описание.ВидКонтрагента;
	Организация.Префикс = СокрЛП(Описание.Префикс);
	ОбщегоНазначения.ЗаписатьДанныеВХранилищеЗначения(Организация, "Логотип", Описание.Логотип);
	ОбщегоНазначения.ЗаписатьДанныеВХранилищеЗначения(Организация, "ФонПечатныхФорм", Описание.ФонПечатныхФорм);
	Организация.Записать();
	Возврат Организация.Ссылка;

КонецФункции

Функция КоличествоОрганизаций()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Организации.Ссылка) КАК Количество
		|ИЗ
		|	Справочник.Организации КАК Организации");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

// Константы валюты регламентированного учёта и страны календаря: ставятся только
// пустые, значения из payload, которых в базе нет, дают предупреждение, а не ошибку.
//
// Параметры:
//  Параметры      - Структура        - см. ПараметрыЗаполнения(): поля Валюта и Страна
//  Предупреждения - Массив из Строка - пополняется, если значение не подошло
//
Процедура УстановитьВалютуИСтрану(Параметры, Предупреждения)

	Если Не ПустаяСтрока(Параметры.Валюта) И Не ЗначениеЗаполнено(Константы.ВалютаРегламентированногоУчета.Получить()) Тогда
		Валюта = ВалютаПоКодуИлиНаименованию(Параметры.Валюта);
		Если ЗначениеЗаполнено(Валюта) Тогда
			Константы.ВалютаРегламентированногоУчета.Установить(Валюта);
		Иначе
			Предупреждения.Добавить("валюта не найдена в справочнике, константа не установлена: " + Параметры.Валюта);
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(Параметры.Страна) И ПустаяСтрока(Константы.СтранаКалендаря.Получить()) Тогда
		ДлинаКодаАльфа2 = 2;
		Код = ВРег(СокрЛП(Параметры.Страна));
		Если СтрДлина(Код) = ДлинаКодаАльфа2 Тогда
			Константы.СтранаКалендаря.Установить(Код);
		Иначе
			Предупреждения.Добавить("страна календаря ожидается кодом альфа-2, константа не установлена: " + Параметры.Страна);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Валюта по коду (MAD), наименованию либо предопределённому элементу для кодов ISO,
// у которых в справочнике код может быть заполнен иначе.
//
// Параметры:
//  Значение - Строка - код или наименование
//
// Возвращаемое значение:
//  СправочникСсылка.Валюты - пустая ссылка, если не найдена
//
Функция ВалютаПоКодуИлиНаименованию(Значение)

	Псевдонимы = Новый Соответствие;
	Псевдонимы.Вставить("MAD", "MoroccanDirham");
	Псевдонимы.Вставить("EUR", "Евро");
	Псевдонимы.Вставить("USD", "ДолларСША");
	Псевдонимы.Вставить("RUB", "РоссийскийРубль");

	Валюта = НайтиВалюту("Код", СокрЛП(Значение));
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = НайтиВалюту("Наименование", СокрЛП(Значение));
	КонецЕсли;
	Предопределенное = Псевдонимы.Получить(ВРег(СокрЛП(Значение)));
	Если Не ЗначениеЗаполнено(Валюта) И Предопределенное <> Неопределено Тогда
		Валюта = НайтиВалюту("ИмяПредопределенныхДанных", Предопределенное);
	КонецЕсли;
	Возврат Валюта;

КонецФункции

Функция НайтиВалюту(ИмяПоля, Значение)

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Валюты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Валюты КАК Валюты
		|ГДЕ
		|	НЕ Валюты.ПометкаУдаления
		|	И Валюты.&ИмяПоля = &Значение";
	Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "&ИмяПоля", ИмяПоля));
	Запрос.УстановитьПараметр("Значение", Значение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Валюты.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область Пользователи

// Заводит пользователя ИБ с элементом справочника Пользователи и физлицом.
// Существующий пользователь ИБ не меняется - идемпотентность повторного запуска.
//
// Параметры:
//  Описание       - Структура - см. ОписаниеПользователя()
//  Организация    - СправочникСсылка.Организации
//  Язык           - ОбъектМетаданных, Неопределено - язык интерфейса; Неопределено - основной
//  ВСпискеВыбора  - Булево - показывать в списке выбора при входе (служебный администратор - нет)
//  Предупреждения - Массив из Строка - пополняется при неизвестных ролях
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь создан; Ложь - уже был
//
Функция ЗаписатьПользователя(Описание, Организация, Язык, ВСпискеВыбора, Предупреждения)

	Логин = СокрЛП(Описание.Логин);
	Если ПользователиИнформационнойБазы.НайтиПоИмени(Логин) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ПолноеИмя = ?(ПустаяСтрока(Описание.ПолноеИмя), Логин, СокрЛП(Описание.ПолноеИмя));

	ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
	ПользовательИБ.Имя = Логин;
	ПользовательИБ.ПолноеИмя = ПолноеИмя;
	ПользовательИБ.Пароль = Описание.Пароль;
	ПользовательИБ.АутентификацияСтандартная = Истина;
	ПользовательИБ.ЗапрещеноВосстанавливатьПароль = Истина;
	ПользовательИБ.ЗапрещеноИзменятьПароль = Истина;
	ПользовательИБ.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Истина;
	ПользовательИБ.ПоказыватьВСпискеВыбора = ВСпискеВыбора;
	ПользовательИБ.Язык = ?(Язык = Неопределено, Метаданные.ОсновнойЯзык, Язык);

	ПользовательИБ.Роли.Очистить();
	Для Каждого ИмяРоли Из РолиПользователя(Описание, Предупреждения) Цикл
		ПользовательИБ.Роли.Добавить(Метаданные.Роли[ИмяРоли]);
	КонецЦикла;
	ПользовательИБ.Записать();

	Элемент = ЭлементПользователяПоНаименованию(Логин);
	Если Элемент = Неопределено Тогда
		Элемент = Справочники.Пользователи.СоздатьЭлемент();
	КонецЕсли;
	Элемент.Наименование = Логин;
	Элемент.ПолноеИмя = ПолноеИмя;
	Элемент.Внешний = Истина;
	Элемент.ВходВПрограммуРазрешен = Истина;
	Элемент.Организация = Организация;
	Элемент.ИдентификаторПользователяИБ = ПользовательИБ.УникальныйИдентификатор;
	Элемент.Роли = Справочники.Пользователи.СформироватьСписокРолей(ПользовательИБ);
	Если Не ЗначениеЗаполнено(Элемент.ФизическоеЛицо) Тогда
		// Физлицо обязательно для пользователя (продавец в продажах и зарплате).
		Элемент.ФизическоеЛицо = СоздатьФизическоеЛицо(ПолноеИмя);
	КонецЕсли;
	Элемент.Записать();

	Возврат Истина;

КонецФункции

// Имена существующих ролей для пользователя: неизвестные пропускаются с предупреждением,
// роль Клиент (личный кабинет контрагента) сотрудникам не выдаётся, пустой список -
// Администратор.
//
// Параметры:
//  Описание       - Структура - см. ОписаниеПользователя()
//  Предупреждения - Массив из Строка
//
// Возвращаемое значение:
//  Массив из Строка - имена ролей
//
Функция РолиПользователя(Описание, Предупреждения)

	Роли = Новый Массив;
	Для Каждого ИмяРоли Из Описание.Роли Цикл
		Имя = СокрЛП(ИмяРоли);
		Роль = Метаданные.Роли.Найти(Имя);
		Если Роль = Неопределено Тогда
			Предупреждения.Добавить("роль не найдена, пропущена у " + СокрЛП(Описание.Логин) + ": " + Имя);
			Продолжить;
		КонецЕсли;
		Если Роль = Метаданные.Роли.Клиент Тогда
			Продолжить;
		КонецЕсли;
		Если Роли.Найти(Роль.Имя) = Неопределено Тогда
			Роли.Добавить(Роль.Имя);
		КонецЕсли;
	КонецЦикла;

	Если Роли.Количество() = 0 Тогда
		Если Описание.Роли.Количество() > 0 Тогда
			Предупреждения.Добавить("ни одна роль не подошла, выдан Администратор: " + СокрЛП(Описание.Логин));
		КонецЕсли;
		Роли.Добавить("Администратор");
	КонецЕсли;

	Возврат Роли;

КонецФункции

Функция ЭлементПользователяПоНаименованию(Наименование)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Наименование = &Наименование
		|	И НЕ Пользователи.ПометкаУдаления");
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция СоздатьФизическоеЛицо(Наименование)

	ФизическоеЛицо = Справочники.ФизическиеЛица.СоздатьЭлемент();
	ФизическоеЛицо.Наименование = Наименование;
	ФизическоеЛицо.Записать();
	Возврат ФизическоеЛицо.Ссылка;

КонецФункции

// Язык конфигурации по имени (Русский) или коду (ru). Пустое значение - Неопределено
// без предупреждения; неизвестное - Неопределено с предупреждением.
//
// Параметры:
//  Значение       - Строка
//  Предупреждения - Массив из Строка
//  Логин          - Строка - чей язык, для текста предупреждения; пустая строка - умолчание базы
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено
//
Функция ЯзыкПоИмениИлиКоду(Значение, Предупреждения, Логин)

	Искомое = НРег(СокрЛП(Значение));
	Если ПустаяСтрока(Искомое) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Язык Из Метаданные.Языки Цикл
		Если НРег(Язык.Имя) = Искомое Или НРег(Язык.КодЯзыка) = Искомое Тогда
			Возврат Язык;
		КонецЕсли;
	КонецЦикла;

	Текст = "язык не найден, взят основной" + ?(ПустаяСтрока(Логин), "", " у " + Логин) + ": " + СокрЛП(Значение);
	Предупреждения.Добавить(Текст);
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#КонецОбласти
