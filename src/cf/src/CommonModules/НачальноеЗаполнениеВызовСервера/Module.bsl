////////////////////////////////////////////////////////////////////////////////
// Начальное заполнение новой базы: организация, пользователи с физлицами и
// служебный администратор. Единая серверная логика двух точек входа:
//  - визард первого запуска ОбщаяФорма.ФормаПервогоЗапуска собирает параметры
//    с экрана и зовёт ЗаполнитьБазу();
//  - headless-запуск обработкой НачальноеЗаполнение по параметру
//    /C "НачальноеЗаполнение;<payload.json>;<result.json>" читает JSON и зовёт
//    ЗаполнитьБазуИзJSON(). Контракт файлов - docs/DEPLOY.md.
//
// Заполнение идемпотентно: организация ищется по наименованию, пользователи - по
// логину; найденное не пересоздаётся и не меняется (пароли существующих не трогаются).
// Пароли в результат и в отчёт не попадают.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Шаблон параметров заполнения для ЗаполнитьБазу().
//
// Возвращаемое значение:
//  Структура:
//   * Организация - Структура:
//      ** Наименование    - Строка - обязательное
//      ** ВидКонтрагента  - ПеречислениеСсылка.ВидыКонтрагентов
//      ** Префикс         - Строка - префикс номеров документов
//      ** Логотип         - Строка - адрес во временном хранилище или пустая строка
//      ** ФонПечатныхФорм - Строка - адрес во временном хранилище или пустая строка
//   * Пользователи - Массив из Структура - см. ОписаниеПользователя()
//   * СлужебныйАдминистратор - Структура, Неопределено - Логин, Пароль скрытого
//                              администратора; Неопределено - не создавать
//   * Валюта - Строка - код (MAD, EUR) или наименование валюты регламентированного
//              учёта; пустая строка - константу не трогать
//   * Страна - Строка - код альфа-2 страны производственного календаря; пустая - не трогать
//   * Язык   - Строка - имя или код языка по умолчанию для пользователей без языка
//   * Отрасль - ПеречислениеСсылка.Отрасли - отрасль организации; пустая - не применять
//
Функция ПараметрыЗаполнения() Экспорт

	Организация = Новый Структура;
	Организация.Вставить("Наименование", "");
	Организация.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ЮридическоеЛицо);
	Организация.Вставить("Префикс", "");
	Организация.Вставить("Логотип", "");
	Организация.Вставить("ФонПечатныхФорм", "");

	Параметры = Новый Структура;
	Параметры.Вставить("Организация", Организация);
	Параметры.Вставить("Пользователи", Новый Массив);
	Параметры.Вставить("СлужебныйАдминистратор", Неопределено);
	Параметры.Вставить("Валюта", "");
	Параметры.Вставить("Страна", "");
	Параметры.Вставить("Язык", "");
	Параметры.Вставить("Отрасль", Перечисления.Отрасли.ПустаяСсылка());

	Возврат Параметры;

КонецФункции

// Применяет отрасль организации: ставит константу и заводит отраслевые дополнительные
// реквизиты (УправлениеСвойствами). Идемпотентно: существующие реквизиты не дублируются.
//
// Параметры:
//  Отрасль - ПеречислениеСсылка.Отрасли - пустая - ничего не делать
//
// Возвращаемое значение:
//  Число - сколько дополнительных реквизитов создано
//
Функция ПрименитьОтрасль(Отрасль) Экспорт

	Если Не ЗначениеЗаполнено(Отрасль) Тогда
		Возврат 0;
	КонецЕсли;

	Константы.Отрасль.Установить(Отрасль);

	Если Отрасль <> Перечисления.Отрасли.Строительство Тогда
		// Торговля и прочее: типовой состав реквизитов, ничего добавлять не нужно.
		Возврат 0;
	КонецЕсли;

	// Реквизиты объекта недвижимости у номенклатуры - состав из практики застройщика
	// (docs/drissotex-analysis/ahmed-2026-09-07.md), без изменения метаданных.
	Создано = 0;
	Для Каждого Описание Из ОтраслевыеРеквизитыСтроительства() Цикл
		Создано = Создано + ДобавитьОтраслевойРеквизит(Отрасль, Описание);
	КонецЦикла;

	Возврат Создано;

КонецФункции

// Шаблон описания одного пользователя для ПараметрыЗаполнения().Пользователи.
//
// Возвращаемое значение:
//  Структура:
//   * Логин     - Строка - имя пользователя ИБ, обязательное
//   * Пароль    - Строка - пароль, обязательное
//   * ПолноеИмя - Строка - ФИО; пустое - берётся логин
//   * Язык      - Строка - имя или код языка интерфейса; пустое - язык из параметров или основной
//   * Роли      - Массив из Строка - имена ролей; пустой массив - Администратор
//
Функция ОписаниеПользователя() Экспорт

	Пользователь = Новый Структура;
	Пользователь.Вставить("Логин", "");
	Пользователь.Вставить("Пароль", "");
	Пользователь.Вставить("ПолноеИмя", "");
	Пользователь.Вставить("Язык", "");
	Пользователь.Вставить("Роли", Новый Массив);
	Возврат Пользователь;

КонецФункции

// Имя скрытого служебного администратора tinycio-1c: под ним в базу входит поддержка.
//
// Возвращаемое значение:
//  Строка - имя пользователя ИБ
//
Функция ИмяСлужебногоАдминистратора() Экспорт

	Возврат "tinycio-1c";

КонецФункции

// Случайный пароль из букв и цифр без похожих символов (0/O, 1/l/I).
//
// Параметры:
//  Длина - Число - длина пароля
//
// Возвращаемое значение:
//  Строка - пароль
//
Функция СлучайныйПароль(Длина = 16) Экспорт

	Алфавит = "abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789";
	Генератор = Новый ГенераторСлучайныхЧисел;
	Пароль = "";
	Пока СтрДлина(Пароль) < Длина Цикл
		Пароль = Пароль + Сред(Алфавит, Генератор.СлучайноеЧисло(1, СтрДлина(Алфавит)), 1);
	КонецЦикла;
	Возврат Пароль;

КонецФункции

// Заполняет базу по структуре параметров. Ошибка данных - исключение.
//
// Параметры:
//  Параметры - Структура - см. ПараметрыЗаполнения()
//
// Возвращаемое значение:
//  Структура:
//   * Организация              - СправочникСсылка.Организации
//   * ОрганизацияСоздана       - Булево - Ложь, если организация с таким наименованием уже была
//   * Пользователи             - Массив из Структура - Логин, Создан (Булево)
//   * СлужебныйАдминистраторСоздан - Булево
//   * ВсегоОрганизаций         - Число - организаций в базе после заполнения
//   * ВсегоПользователей       - Число - пользователей ИБ после заполнения
//   * Предупреждения           - Массив из Строка - что заменено умолчанием (роль, язык, валюта)
//   * СозданоРеквизитовОтрасли - Число - дополнительных реквизитов заведено по отрасли
//
Функция ЗаполнитьБазу(Параметры) Экспорт

	ПроверитьПараметры(Параметры);

	Результат = Новый Структура;
	Результат.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Результат.Вставить("ОрганизацияСоздана", Ложь);
	Результат.Вставить("Пользователи", Новый Массив);
	Результат.Вставить("СлужебныйАдминистраторСоздан", Ложь);
	Результат.Вставить("ВсегоОрганизаций", 0);
	Результат.Вставить("ВсегоПользователей", 0);
	Результат.Вставить("Предупреждения", Новый Массив);

	Результат.Организация = НайтиОрганизацию(Параметры.Организация.Наименование);
	Если Не ЗначениеЗаполнено(Результат.Организация) Тогда
		Результат.Организация = СоздатьОрганизацию(Параметры.Организация);
		Результат.ОрганизацияСоздана = Истина;
	КонецЕсли;

	УстановитьВалютуИСтрану(Параметры, Результат.Предупреждения);

	ЯзыкПоУмолчанию = ЯзыкПоИмениИлиКоду(Параметры.Язык, Результат.Предупреждения, "");

	Для Каждого Пользователь Из Параметры.Пользователи Цикл
		ЯзыкПользователя = ЯзыкПоИмениИлиКоду(Пользователь.Язык, Результат.Предупреждения, Пользователь.Логин);
		Если ЯзыкПользователя = Неопределено Тогда
			ЯзыкПользователя = ЯзыкПоУмолчанию;
		КонецЕсли;
		Создан = ЗаписатьПользователя(Пользователь, Результат.Организация, ЯзыкПользователя, Истина, Результат.Предупреждения);
		Результат.Пользователи.Добавить(Новый Структура("Логин, Создан", СокрЛП(Пользователь.Логин), Создан));
	КонецЦикла;

	Если Параметры.СлужебныйАдминистратор <> Неопределено Тогда
		Администратор = ОписаниеПользователя();
		ЗаполнитьЗначенияСвойств(Администратор, Параметры.СлужебныйАдминистратор);
		Если ПустаяСтрока(Администратор.Логин) Тогда
			Администратор.Логин = ИмяСлужебногоАдминистратора();
		КонецЕсли;
		Администратор.ПолноеИмя = Администратор.Логин;
		Администратор.Роли.Очистить();
		Администратор.Роли.Добавить("Администратор");
		Результат.СлужебныйАдминистраторСоздан = ЗаписатьПользователя(Администратор, Результат.Организация,
			Неопределено, Ложь, Результат.Предупреждения);
	КонецЕсли;

	Результат.Вставить("СозданоРеквизитовОтрасли", ПрименитьОтрасль(Параметры.Отрасль));

	Результат.ВсегоОрганизаций = КоличествоОрганизаций();
	Результат.ВсегоПользователей = ПользователиИнформационнойБазы.ПолучитьПользователей().Количество();

	Возврат Результат;

КонецФункции

// Заполняет базу по JSON-описанию (payload задания initial_fill хаба tinycio,
// формат - docs/DEPLOY.md). Исключений не бросает: ошибка возвращается в структуре,
// чтобы клиент-запускатель записал её в отчёт и завершил работу штатно.
//
// Параметры:
//  ТекстJSON - Строка - содержимое payload-файла
//
// Возвращаемое значение:
//  Структура:
//   * Успех         - Булево
//   * Ошибка        - Строка - описание ошибки; пустая при успехе
//   * РезультатJSON - Строка - result-файл для вызывающего скрипта, без паролей
//   * Сводка        - Строка - одна строка для маркера ИТОГ отчёта
//
Функция ЗаполнитьБазуИзJSON(ТекстJSON) Экспорт

	Ответ = Новый Структура;
	Ответ.Вставить("Успех", Ложь);
	Ответ.Вставить("Ошибка", "");
	Ответ.Вставить("РезультатJSON", "");
	Ответ.Вставить("Сводка", "");

	Попытка
		Параметры = ПараметрыИзJSON(ТекстJSON);
		Результат = ЗаполнитьБазу(Параметры);
	Исключение
		Информация = ИнформацияОбОшибке();
		// МенеджерОбработкиОшибок в 8.5.1 не существует (docs/TESTING.md) - глобальные методы.
		// BSLLS:DeprecatedMethodCall-off
		Ответ.Ошибка = КраткоеПредставлениеОшибки(Информация);
		Подробно = ПодробноеПредставлениеОшибки(Информация);
		// BSLLS:DeprecatedMethodCall-on
		Ответ.РезультатJSON = РезультатОшибкиВJSON(Ответ.Ошибка);
		Ответ.Сводка = Ответ.Ошибка;
		ЗаписьЖурналаРегистрации("Начальное заполнение", УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		Возврат Ответ;
	КонецПопытки;

	СозданоПользователей = 0;
	Для Каждого Пользователь Из Результат.Пользователи Цикл
		Если Пользователь.Создан Тогда
			СозданоПользователей = СозданоПользователей + 1;
		КонецЕсли;
	КонецЦикла;

	Ответ.Успех = Истина;
	Ответ.РезультатJSON = РезультатВJSON(Результат);
	Ответ.Сводка = "организация " + ?(Результат.ОрганизацияСоздана, "создана", "уже была")
		+ ";пользователей создано " + Формат(СозданоПользователей, ФорматЧисла())
		+ " из " + Формат(Результат.Пользователи.Количество(), ФорматЧисла())
		+ ";служебный администратор " + ?(Результат.СлужебныйАдминистраторСоздан, "создан", "не создавался")
		+ ";предупреждений " + Формат(Результат.Предупреждения.Количество(), ФорматЧисла());

	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РазборJSON

// Разбирает payload и собирает структуру параметров. Лишние поля игнорируются,
// отсутствие обязательных - исключение с перечнем.
//
// Параметры:
//  ТекстJSON - Строка - payload
//
// Возвращаемое значение:
//  Структура - см. ПараметрыЗаполнения()
//
Функция ПараметрыИзJSON(ТекстJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Попытка
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Информация = ИнформацияОбОшибке();
		// BSLLS:DeprecatedMethodCall-off
		ВызватьИсключение "payload не является корректным JSON: " + КраткоеПредставлениеОшибки(Информация);
		// BSLLS:DeprecatedMethodCall-on
	КонецПопытки;
	Чтение.Закрыть();

	Если Не ЭтоОбъектJSON(Данные) Тогда
		ВызватьИсключение "payload должен быть JSON-объектом";
	КонецЕсли;

	Отсутствуют = Новый Массив;
	Параметры = ПараметрыЗаполнения();

	КомпаниюИзJSON(ЗначениеПоля(Данные, "company", Неопределено), Параметры, Отсутствуют);

	// owner (ФИО, e-mail, телефон владельца) принимается, но не используется: у организации
	// и пользователя в конфигурации нет реквизитов для контактов (docs/TECHDEBT.md).

	СписокПользователей = ЗначениеПоля(Данные, "users", Новый Массив);
	Если ТипЗнч(СписокПользователей) <> Тип("Массив") Тогда
		ВызватьИсключение "users должен быть массивом";
	КонецЕсли;
	Для Номер = 0 По СписокПользователей.ВГраница() Цикл
		Путь = "users[" + Формат(Номер, "ЧГ=0") + "]";
		Описание = СписокПользователей[Номер];
		Если Не ЭтоОбъектJSON(Описание) Тогда
			ВызватьИсключение Путь + " должен быть объектом";
		КонецЕсли;
		Параметры.Пользователи.Добавить(ПользовательИзJSON(Описание, Путь, Отсутствуют));
	КонецЦикла;

	АдминистратораИзJSON(ЗначениеПоля(Данные, "support_admin", Неопределено), Параметры, Отсутствуют);

	Если Отсутствуют.Количество() > 0 Тогда
		ВызватьИсключение "в payload нет обязательных полей: " + СтрСоединить(Отсутствуют, ", ");
	КонецЕсли;

	Возврат Параметры;

КонецФункции

// Заполняет организацию и умолчания базы из объекта company.
//
// Параметры:
//  Компания    - Соответствие, Неопределено - объект company
//  Параметры   - Структура        - см. ПараметрыЗаполнения(), заполняется
//  Отсутствуют - Массив из Строка - пополняемый список обязательных полей, которых нет
//
Процедура КомпаниюИзJSON(Компания, Параметры, Отсутствуют)

	Если Не ЭтоОбъектJSON(Компания) Тогда
		Отсутствуют.Добавить("company");
		Возврат;
	КонецЕсли;

	Параметры.Организация.Наименование = СокрЛП(ЗначениеПоля(Компания, "name", ""));
	Если ПустаяСтрока(Параметры.Организация.Наименование) Тогда
		Отсутствуют.Добавить("company.name");
	КонецЕсли;
	Параметры.Организация.ВидКонтрагента = ВидКонтрагентаПоКоду(ЗначениеПоля(Компания, "kind", ""));
	Параметры.Организация.Префикс = СокрЛП(ЗначениеПоля(Компания, "prefix", ""));
	Параметры.Валюта = СокрЛП(ЗначениеПоля(Компания, "currency", ""));
	Параметры.Страна = СокрЛП(ЗначениеПоля(Компания, "country", ""));
	Параметры.Язык = СокрЛП(ЗначениеПоля(Компания, "language", ""));
	Параметры.Отрасль = ОтрасльПоКоду(ЗначениеПоля(Компания, "industry", ""));

КонецПроцедуры

// Отрасль по коду из payload: имя перечисления либо английский код хаба
// (trade, construction, other). Пустое или неизвестное значение - торговля.
//
// Параметры:
//  Код - Строка
//
// Возвращаемое значение:
//  ПеречислениеСсылка.Отрасли
//
Функция ОтрасльПоКоду(Код)

	Значение = НРег(СокрЛП(Код));
	Если Значение = "строительство" Или Значение = "construction" Или Значение = "real_estate" Тогда
		Отрасль = Перечисления.Отрасли.Строительство;
	ИначеЕсли Значение = "прочее" Или Значение = "other" Тогда
		Отрасль = Перечисления.Отрасли.Прочее;
	Иначе
		Отрасль = Перечисления.Отрасли.Торговля;
	КонецЕсли;
	Возврат Отрасль;

КонецФункции

// Описания дополнительных реквизитов номенклатуры для отрасли «Строительство».
//
