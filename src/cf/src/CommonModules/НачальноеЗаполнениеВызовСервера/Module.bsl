// Описание одного отраслевого реквизита.
//
// Параметры:
//  Имя         - Строка - имя реквизита для программного доступа
//  Порядок     - Число - порядок поля в форме
//  ТипЗначения - ОписаниеТипов
//  Ru          - Строка - заголовок по-русски
//  Fr          - Строка - заголовок по-французски
//  En          - Строка - заголовок по-английски
//  Es          - Строка - заголовок по-испански
//
// Возвращаемое значение:
//  Структура - Имя, Порядок, ТипЗначения, Заголовки
//
Функция ОписаниеОтраслевогоРеквизита(Имя, Порядок, ТипЗначения, Ru, Fr, En, Es)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("ru", Ru);
	Заголовки.Вставить("fr", Fr);
	Заголовки.Вставить("en", En);
	Заголовки.Вставить("es", Es);
	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Порядок", Порядок);
	Описание.Вставить("ТипЗначения", ТипЗначения);
	Описание.Вставить("Заголовки", Заголовки);
	Возврат Описание;

КонецФункции

// Заводит один отраслевой дополнительный реквизит номенклатуры, если его ещё нет.
//
// Параметры:
//  Отрасль  - ПеречислениеСсылка.Отрасли
//  Описание - Структура - см. ОписаниеОтраслевогоРеквизита
//
// Возвращаемое значение:
//  Число - 1, если реквизит создан; 0, если уже был
//
Функция ДобавитьОтраслевойРеквизит(Отрасль, Описание)

	ИмяОбъекта = "Справочник.Номенклатура";
	Если ЗначениеЗаполнено(УправлениеСвойствами.НайтиСвойство(ИмяОбъекта, Описание.Имя)) Тогда
		Возврат 0;
	КонецЕсли;

	Параметры = УправлениеСвойствами.ПараметрыДобавленияСвойства();
	Параметры.ИмяОбъекта = ИмяОбъекта;
	Параметры.Имя = Описание.Имя;
	Параметры.Наименование = Описание.Заголовки.Получить("ru");
	Параметры.ТипЗначения = Описание.ТипЗначения;
	Параметры.Порядок = Описание.Порядок;
	Параметры.Отрасль = Отрасль;
	Параметры.Заголовки = Описание.Заголовки;
	УправлениеСвойствами.ДобавитьСвойство(Параметры);
	Возврат 1;

КонецФункции

// Заполняет описание служебного администратора из объекта support_admin.
//
// Параметры:
//  Администратор - Соответствие, Неопределено - объект support_admin; Неопределено - не создавать
//  Параметры     - Структура        - см. ПараметрыЗаполнения(), заполняется
//  Отсутствуют   - Массив из Строка - пополняемый список обязательных полей, которых нет
//
Процедура АдминистратораИзJSON(Администратор, Параметры, Отсутствуют)

	Если Администратор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЭтоОбъектJSON(Администратор) Тогда
		ВызватьИсключение "support_admin должен быть объектом";
	КонецЕсли;

	Логин = СокрЛП(ЗначениеПоля(Администратор, "login", ИмяСлужебногоАдминистратора()));
	Пароль = ЗначениеПоля(Администратор, "password", "");
	Если ПустаяСтрока(Пароль) Тогда
		Отсутствуют.Добавить("support_admin.password");
	КонецЕсли;
	Параметры.СлужебныйАдминистратор = Новый Структура("Логин, Пароль", Логин, Пароль);

КонецПроцедуры

