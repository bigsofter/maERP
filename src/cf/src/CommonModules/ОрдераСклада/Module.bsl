////////////////////////////////////////////////////////////////////////////////
// Общая логика приходного и расходного ордеров склада (план docs/plans/warehouse-orders.md, фаза 2): блокировка
// одним объектом в ПередЗаписью, защита оформленного ордера, проведение, отмена проведения и удаление. С 2.0.16.122
// (docs/plans/warehouse-orders-cost.md, фаза 3) ордер - носитель партии: приходный приходует партию (партия = ордер,
// стоимость - по парам оформления с поступлениями), расходный списывает партии; ближний пересчёт стоимости приходных
// ордеров от поступления.
// Ордера проводятся в привилегированном режиме, физический регистр и неоформленные остатки пишет механизм, а не
// пользователь. BSLLS:SetPrivilegedMode-off
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// ПередЗаписью ордера: коды строк, блокировка всего, что пишет ордер, - один раз и до чтения оформлений (общий план,
// «Блокировки»), правила защиты оформленного ордера, снимок состава расходного ордера.
//
// Параметры:
//  Ордер       - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - записываемый ордер.
//  Отказ       - Булево - выставляется при нарушении правил.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//
Процедура ПередЗаписьюОрдера(Ордер, Отказ, РежимЗаписи) Экспорт
	// Ордер записывается только при включённой опции «Ордерные склады» - и при загрузке: выключенная опция означает,
	// что ордеров в базе нет (план warehouse-orders-option). Разделяемая блокировка опции - до чтения константы.
	Блокировка = Новый БлокировкаДанных;
	УправляемыеБлокировки.ОпцияОрдерныхСкладов(Блокировка, Ложь);
	Блокировка.Заблокировать();
	Если Не Справочники.МестаХранения.ОрдерныеСкладыВключены() Тогда
		Текст = НСтр("ru = 'Ордера можно записывать только при включённой опции «Ордерные склады»
			|(настройки, раздел «Склад»).';
			|fr = 'Les bons ne peuvent être enregistrés que si l''option « Entrepôts à bons » est activée
			|(paramètres, section « Entrepôt »).';
			|en = 'Orders can only be saved when the «Order-based warehouses» option is on (settings, «Warehouse» section).';
			|es = 'Las órdenes solo se pueden guardar con la opción «Almacenes con órdenes» activada
			|(ajustes, sección «Almacén»).'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Ордер, , , Отказ);
		Возврат;
	КонецЕсли;
	Если Ордер.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(Ордер, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Ордер.Ответственный) Тогда
		Ордер.Ответственный = ПараметрыСеанса.Пользователь;
	КонецЕсли;
	ЗаполнитьКодыСтрок(Ордер);
	УстановитьПривилегированныйРежим(Истина);
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировку(Ордер, Блокировка, РежимЗаписи);
	Блокировка.Заблокировать();
	// Ордер до 2.0.16.122 (без партий) - до удаления прежних движений проведением: его документы переводятся (Ф3.15).
	Если Не Ордер.Ссылка.Пустая() Тогда
		Ордер.ДополнительныеСвойства.Вставить(ИмяСвойстваСтаройСхемы(),
			ОрдераБезПартий(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ордер.Ссылка)).Количество() > 0);
	КонецЕсли;
	// Себестоимость реализаций пар расходного ордера - последней (Ф3.8): пары не меняются, пока держится блокировка
	// ТоварыКОформлению по ордеру.
	Если ЭтоРасходный(Ордер) И Не Ордер.Ссылка.Пустая() Тогда
		Менеджер = РегистрыНакопления.СебестоимостьПродаж;
		Менеджер.ЗаблокироватьРеализации(Менеджер.РеализацииПарОрдеров(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ордер.Ссылка)));
	КонецЕсли;
	// Пересчёт стоимости (обход последовательности) пишет те же наборы: защита, снимок состава и стадии заказов не
	// трогаются - документ не изменился (Ф3.7).
	Если РаботаСДокументами.ПересчетСтоимости(Ордер) Тогда
		Возврат;
	КонецЕсли;
	ПроверитьЗащиту(Ордер, РежимЗаписи, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоРасходный(Ордер) И РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ОбновитьФизическийСостав(Ордер);
		ПроверитьСоставВБлокировке(Ордер, Отказ);
	КонецЕсли;
	ПроизводственныеЗаказы.ЗапомнитьЗаказыДокумента(Ордер, РежимЗаписи);
КонецПроцедуры

// Проведение ордера (блокировки взяты в ПередЗаписью): партии (приходный - приход партии-ордера, расходный - списание
// по ФИФО с кодами строк; физику пишет зеркало), неоформленные остатки, у приходного - заказ поставщику и потребности
// производства, у расходного - автовыпуск продукции заказа (раньше своих движений) и пересчёт себестоимости
// реализаций его пар.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - проводимый ордер.
//  Отказ - Булево - выставляется при отказе.
//
Процедура ПровестиОрдер(Ордер, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ПересчетСтоимости = РаботаСДокументами.ПересчетСтоимости(Ордер);
	Если Не Справочники.МестаХранения.ОрдерныйСклад(Ордер.МестоХранения, Ордер.Дата) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Склад не ордерный на дату ордера.';
			|fr = 'L''entrepôt ne fonctionne pas par bons à la date du bon.';
			|en = 'The warehouse is not order-based on the order date.';
			|es = 'El almacén no funciona por órdenes en la fecha de la orden.'"), Ордер, "МестоХранения", , Отказ);
		Возврат;
	КонецЕсли;
	ПроверитьСтрокиЗаказаОрдера(Ордер, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоРасходный(Ордер) Тогда
		// Автовыпуск продукции заказа на производство - на секунду раньше ордера, до его расхода с полки (как у
		// реализации, E9): на ордерном складе физическая отгрузка - ордер.
		Контекст = Неопределено;
		Ордер.ДополнительныеСвойства.Свойство(ИмяСвойстваКонтекста(), Контекст);
		Производство.ОбеспечитьАвтовыпуск(Ордер, Контекст, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// До своих партий: записи старых документов сняты раньше, чем ордер создаёт или списывает партии (Ф3.15).
	ПеревестиСтарыеОформления(Ордер, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	СформироватьСтоимостныеДвижения(Ордер, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	РегистрыНакопления.ТоварыКОформлению.СформироватьДвиженияОрдера(Ордер);
	Если Не ЭтоРасходный(Ордер) Тогда
		СформироватьДвиженияЗакупки(Ордер, ПересчетСтоимости, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Ордер.Движения.Записать();
	ДописатьПозднихСтарыхОрдеров(Ордер, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ЗавершитьПроведениеОрдера(Ордер, ПересчетСтоимости, Отказ);
КонецПроцедуры

// Отмена проведения ордера: распроведение автовыпуска, очистка движений и контроль - по ордеру уже оформлено
// больше, чем останется (общий план, «Целостность связи»): отказ с текстом «сначала отмените оформление».
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - ордер.
//  Отказ - Булево - выставляется при отказе.
//
Процедура ОтменитьПроведениеОрдера(Ордер, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если ЭтоРасходный(Ордер) Тогда
		Производство.ОтменитьАвтовыпуск(Ордер, Отказ);
	Иначе
		РегистрыНакопления.ПотребностиПроизводства.ПроверитьПришло(Ордер, Неопределено, Отказ);
		ПроверитьОтменуСДопрасходами(Ордер, Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Для Каждого НаборЗаписей Из Ордер.Движения Цикл
		НаборЗаписей.Очистить();
		НаборЗаписей.Записывать = Истина;
	КонецЦикла;
	Ордер.Движения.Записать();
	РегистрыНакопления.ТоварыКОформлению.ПроверитьОстатки(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ордер.Ссылка),
		Ордер, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ПроизводственныеЗаказы.ОтменитьПроведениеДокумента(Ордер, Неопределено);
КонецПроцедуры

// Программное удаление ордера (Удалить() не вызывает ОбработкаУдаленияПроведения, tiny1C bsl-024): отказ при
// оформлениях и строках документов со ссылкой на ордер; расходный ордер распроводит свой автовыпуск, приходный не
// уводит «Пришло» потребностей в минус.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - удаляемый ордер.
//  Отказ - Булево - выставляется при отказе.
//
Процедура ПередУдалениемОрдера(Ордер, Отказ) Экспорт
	Если Ордер.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировку(Ордер, Блокировка, РежимЗаписиДокумента.ОтменаПроведения);
	Блокировка.Заблокировать();
	Оформляющие = РегистрыНакопления.ТоварыКОформлению.ДокументыСоСтрокамиОрдера(Ордер.Ссылка);
	Если Оформляющие.Количество() > 0
		Или РегистрыНакопления.ТоварыКОформлению.ОформленияОрдера(Ордер.Ссылка).Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Ордер оформлен документами, удалить его нельзя: %1';
			|fr = 'Le bon est régularisé par des documents, il ne peut pas être supprimé : %1';
			|en = 'The order is documented by documents and cannot be deleted: %1';
			|es = 'La orden está formalizada por documentos y no se puede eliminar: %1'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, СтрСоединить(Оформляющие, "; ")), Ордер, , , Отказ);
		Возврат;
	КонецЕсли;
	Если Не Ордер.Проведен Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоРасходный(Ордер) Тогда
		Производство.ОтменитьАвтовыпуск(Ордер, Отказ, Истина);
	Иначе
		РегистрыНакопления.ПотребностиПроизводства.ПроверитьПришло(Ордер, Неопределено, Отказ);
		ПроверитьОтменуСДопрасходами(Ордер, Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Партии проведённого ордера списаны потребителями: удаление движений - пересчёт с даты ордера (Ф3.7, как
	// КорректировкаРегистров в Ф1.1).
	РаботаСДокументами.СдвинутьГраницуПоследовательностиНазад(РаботаСДокументами.МоментДоДаты(Ордер.Дата));
КонецПроцедуры

// Контекст автовыпуска расходного ордера, рассчитанный при блокировке в ПередЗаписью (см. Производство.
// КонтекстАвтовыпуска) - имя дополнительного свойства.
//
// Возвращаемое значение:
//  Строка - имя свойства.
//
Функция ИмяСвойстваКонтекста() Экспорт
	Возврат "КонтекстАвтовыпускаОрдера";
КонецФункции

// Проверки документа, оформляющего ордера (общий план, «Целостность связи»; фаза 2, §2.5): на ордерном на дату складе
// ордер обязателен в каждой строке товаров, на неордерном - недопустим; ордер проведён, не позже документа, с тем же
// складом, организацией и контрагентом; одно основание у всех ордеров - основание документа; номенклатура,
// характеристика и серия строки - как у строки ордера; несколько серий в строке с ордером - нельзя. Действует при
// программной записи (проверка заполнения) и после блокировки при проведении.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.РеализацияТоваровУслуг - документ.
//  Отказ     - Булево - выставляется при нарушении.
//
Процедура ПроверитьОформление(ДокОбъект, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Ордерный = Справочники.МестаХранения.ОрдерныйСклад(ДокОбъект.МестоХранения, ДокОбъект.Дата);
	Тексты = Новый Массив;
	Ордера = Новый Массив;
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Если ЗначениеЗаполнено(Строка.Ордер) И Ордера.Найти(Строка.Ордер) = Неопределено Тогда
			Ордера.Добавить(Строка.Ордер);
		КонецЕсли;
		Текст = ОшибкаСтрокиОформления(Строка, Ордерный);
		Если ЗначениеЗаполнено(Текст) Тогда
			Тексты.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Если Ордера.Количество() > 0 Тогда
		ДанныеОрдеров = ДанныеОрдеровДокумента(ДокОбъект, Ордера);
		ПроверитьШапкиОрдеров(ДокОбъект, ДанныеОрдеров.Шапки, Тексты);
		ПроверитьСтрокиПоОрдерам(ДокОбъект, ДанныеОрдеров.Строки, Тексты);
	КонецЕсли;
	Для Каждого Текст Из Тексты Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ДокОбъект, , , Отказ);
	КонецЦикла;
КонецПроцедуры

// Движения ТоварыКОформлению оформляющего документа - расход по строке с ордером: запись - пара оформления (см.
// ТоварыКОформлению.РасходОформления); вызывается под блокировкой ТоварыКОформлению по ордерам документа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.РеализацияТоваровУслуг - проводимый документ.
//
Процедура СформироватьДвиженияОформления(ДокОбъект) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Набор = ДокОбъект.Движения.ТоварыКОформлению;
	Набор.Записывать = Истина;
	Набор.Очистить();
	Для Каждого Строка Из РегистрыНакопления.ТоварыКОформлению.РасходОформления(ДокОбъект) Цикл
		Запись = Набор.ДобавитьРасход();
		ЗаполнитьЗначенияСвойств(Запись, Строка);
		Запись.Период = ДокОбъект.Дата;
	КонецЦикла;
КонецПроцедуры

// Снимок ордеров пар поступления до блокировки (Ф3.8): ордера строк и прежних пар, их склады и номенклатура их строк -
// ключи блокировки партий, которые перезапишет ближний пересчёт.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг - поступление.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ордер, МестоХранения, Номенклатура; упорядочена.
//
Функция СнимокОрдеровПоступления(ДокОбъект) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Ордера = РегистрыНакопления.ТоварыКОформлению.ОрдераДокумента(ДокОбъект);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Строки.Ссылка КАК Ордер,
	|	Ордера.МестоХранения КАК МестоХранения,
	|	Строки.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ПриходныйОрдер.ТЧТовары КАК Строки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходныйОрдер КАК Ордера
	|		ПО Строки.Ссылка = Ордера.Ссылка
	|ГДЕ
	|	Строки.Ссылка В (&Ордера)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ордер,
	|	МестоХранения,
	|	Номенклатура");
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Позиции блокировки партий поступления на складе (Ф3.8): на своём складе - номенклатура строк, на любом складе -
// номенклатура строк ордеров пар из снимка.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг - поступление.
//  Снимок    - ТаблицаЗначений - см. СнимокОрдеровПоступления.
//  Склад     - СправочникСсылка.МестаХранения - склад.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура.
//
Функция ПозицииБлокировкиПоступления(ДокОбъект, Снимок, Склад) Экспорт
	Поле = "Номенклатура";
	Позиции = Снимок.Скопировать(Новый Структура("МестоХранения", Склад), Поле);
	Если Склад = ДокОбъект.МестоХранения Тогда
		Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
			Позиции.Добавить()[Поле] = Строка.Номенклатура;
		КонецЦикла;
	КонецЕсли;
	Позиции.Свернуть(Поле);
	Возврат Позиции;
КонецФункции

// Снимок ордеров пар поступления после блокировки не вышел за ключи, захваченные по снимку до блокировки: иначе ордер
// изменили в промежутке - отказ, без расширения блокировок после ТоварыКОформлению (Ф3.8).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг - поступление.
//  Снимок    - ТаблицаЗначений - см. СнимокОрдеровПоступления до блокировки.
//  Отказ     - Булево - выставляется при выходе за ключи.
//
Процедура ПроверитьСнимокОрдеровПоступления(ДокОбъект, Снимок, Отказ) Экспорт
	Текущий = СнимокОрдеровПоступления(ДокОбъект);
	Для Каждого Строка Из Текущий Цикл
		Отбор = Новый Структура("МестоХранения, Номенклатура", Строка.МестоХранения, Строка.Номенклатура);
		Если Снимок.НайтиСтроки(Отбор).Количество() = 0 Тогда
			Текст = НСтр("ru = 'Ордер изменён, пока документ проводился. Проведите документ ещё раз.';
				|fr = 'Le bon a été modifié pendant la validation du document. Validez le document à nouveau.';
				|en = 'The order was changed while the document was being posted. Post the document again.';
				|es = 'La orden cambió mientras se contabilizaba el documento. Contabilice el documento de nuevo.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ДокОбъект, , , Отказ);
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Ближний пересчёт приходных ордеров (план warehouse-orders-cost, Ф3.7): наборы ТоварыВНаличии и
// ДополнительныеРасходы проведённых ордеров рассчитываются по их текущим парам и пишутся, только если изменились;
// изменение сдвигает границу последовательности на момент самого раннего изменённого ордера (обход возьмёт его
// потребителей) и строго раньше самого раннего документа допрасходов на поступление или изменённые ордера.
// Вызывается после записи движений поступления, под его блокировками (Ф3.8).
//
// Параметры:
//  Ордера    - Массив из ДокументСсылка - ордера прежних и новых пар (приходные; прочие пропускаются).
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг - проводимое поступление.
//
Процедура ПересчитатьСтоимостьПриходныхОрдеров(Ордера, ДокОбъект) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Приходные = Новый Массив;
	Для Каждого Ордер Из Ордера Цикл
		Если ТипЗнч(Ордер) = Тип("ДокументСсылка.ПриходныйОрдер") Тогда
			Приходные.Добавить(Ордер);
		КонецЕсли;
	КонецЦикла;
	Если Приходные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ордера.Ссылка КАК Ссылка,
	|	Ордера.Дата КАК Дата,
	|	Ордера.МестоХранения КАК МестоХранения
	|ИЗ
	|	Документ.ПриходныйОрдер КАК Ордера
	|ГДЕ
	|	Ордера.Ссылка В (&Ордера)
	|	И Ордера.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ордера.МоментВремени");
	Запрос.УстановитьПараметр("Ордера", Приходные);
	Выборка = Запрос.Выполнить().Выбрать();
	Изменены = Новый Массив;
	МоментИзменения = Неопределено;
	Пока Выборка.Следующий() Цикл
		Строки = Выборка.Ссылка.ТЧТовары.Выгрузить(, "КодСтроки, Номенклатура, Характеристика, Серия, Количество");
		Записи = СтоимостныеЗаписиПриходногоОрдера(Выборка.Ссылка, Выборка.Дата, Выборка.МестоХранения, Строки);
		Если ЗаписатьНаборОрдераЕслиИзменился(РегистрыНакопления.ТоварыВНаличии, Выборка.Ссылка, Записи.Товары)
			+ ЗаписатьНаборОрдераЕслиИзменился(РегистрыНакопления.ДополнительныеРасходы, Выборка.Ссылка, Записи.Допрасходы) > 0 Тогда
			Изменены.Добавить(Выборка.Ссылка);
			Если МоментИзменения = Неопределено Тогда
				МоментИзменения = Новый МоментВремени(Выборка.Дата, Выборка.Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если МоментИзменения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.СдвинутьГраницуБлижнимПересчетом(МоментИзменения, ДокОбъект);
	Партии = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Партии, Изменены);
	Партии.Добавить(ДокОбъект.Ссылка);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Документы.Дата КАК Дата
	|ИЗ
	|	Документ.ПоступлениеДополнительныхРасходов КАК Документы
	|ГДЕ
	|	Документы.Проведен
	|	И Документы.Ссылка В
	|			(ВЫБРАТЬ
	|				Строки.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.ПоступлениеДополнительныхРасходов.ТЧТовары КАК Строки
	|			ГДЕ
	|				Строки.ДокументПартии В (&Партии))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документы.МоментВремени");
	Запрос.УстановитьПараметр("Партии", Партии);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		РаботаСДокументами.СдвинутьГраницуБлижнимПересчетом(РаботаСДокументами.МоментДоДаты(Выборка.Дата), ДокОбъект);
	КонецЕсли;
КонецПроцедуры

// База распределения допрасходов на поступления ордерного склада (Ф3.9): по паре - партия-ордер, строка ордера,
// количество пары, стоимость строки поступления.
//
// Параметры:
//  Поступления - Массив из ДокументСсылка.ПоступлениеТоваровУслуг - поступления.
//
// Возвращаемое значение:
//  ТаблицаЗначений - МестоХранения, Номенклатура, Характеристика, Серия, Партия, КодСтроки, Количество, Сумма,
//                    ДокументПартии (поступление).
//
Функция БазаПартийОрдеровПоступлений(Поступления) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	База = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("МестоХранения,Номенклатура,Характеристика,Серия,Партия,КодСтроки,ДокументПартии", ",") Цикл
		База.Колонки.Добавить(Имя);
	КонецЦикла;
	База.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.Количество.Тип);
	База.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	Пары = ПарыПоступлений(Поступления);
	Если Пары.Количество() = 0 Тогда
		Возврат База;
	КонецЕсли;
	Стоимость = СтоимостьСтрокПоступлений(Пары.ВыгрузитьКолонку("Регистратор"));
	Поле = "Источник";
	Ордера = Пары.Скопировать(, Поле);
	Ордера.Свернуть(Поле);
	Строки = СтрокиПриходныхОрдеров(Ордера.ВыгрузитьКолонку(Поле));
	Для Каждого Пара Из Пары Цикл
		СтрокаОрдера = Строки.Найти(КлючСтроки(Пара.Источник, Пара.КлючСтрокиИсточника), ИмяКлюча());
		Если СтрокаОрдера = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строка = База.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, СтрокаОрдера, "МестоХранения, Номенклатура, Характеристика, Серия");
		Строка.Партия = Пара.Источник;
		Строка.КодСтроки = Пара.КлючСтрокиИсточника;
		Строка.Количество = Пара.Количество;
		Строка.ДокументПартии = Пара.Регистратор;
		СтоимостьСтроки = Стоимость.Строки.Найти(КлючСтроки(Пара.Регистратор, Пара.КодСтрокиРегистратора), ИмяКлюча());
		Строка.Сумма = ?(СтоимостьСтроки = Неопределено, 0, СтоимостьСтроки.Сумма);
	КонецЦикла;
	Возврат База;
КонецФункции

// Строки расходных ордеров реализации - текущие строки и прежние пары (до автоудаления движений): по ним ближний
// пересчёт себестоимости (warehouse-orders-cost, Ф3.7).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - реализация.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ордер (ДокументСсылка.РасходныйОрдер), КодСтроки.
//
Функция СтрокиОрдеровРеализации(ДокОбъект) Экспорт
	Строки = НоваяТаблицаСтрокОрдеров();
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Если ЭтоРасходныйОрдер(Строка.Ордер) И ЗначениеЗаполнено(Строка.Ордер) Тогда
			Новая = Строки.Добавить();
			Новая.Ордер = Строка.Ордер;
			Новая.КодСтроки = Строка.КлючСтрокиОрдера;
		КонецЕсли;
	КонецЦикла;
	Если Не ДокОбъект.Ссылка.Пустая() Тогда
		Пары = РегистрыНакопления.ТоварыКОформлению.ПарыОформления(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокОбъект.Ссылка));
		Для Каждого Пара Из Пары Цикл
			Если Пара.Регистратор = ДокОбъект.Ссылка И ЭтоРасходныйОрдер(Пара.Источник) Тогда
				Новая = Строки.Добавить();
				Новая.Ордер = Пара.Источник;
				Новая.КодСтроки = Пара.КлючСтрокиИсточника;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Строки.Свернуть("Ордер, КодСтроки");
	Возврат Строки;
КонецФункции

// Полный набор блокировок реализации по ордерам до автоудаления движений (Ф3.8), из её ПередЗаписью: склады, остатки,
// взаиморасчёты, потребности автовыпуска, ТоварыКОформлению по прежним и новым ордерам (ЗаполнитьБлокировкуПроведения
// реализации), затем себестоимость своей и соседних реализаций. Контекст автовыпуска и строки ордеров - в
// дополнительные свойства для проведения. Реализация без ордеров в обеих версиях - ничего.
//
// Параметры:
//  ДокОбъект   - ДокументОбъект.РеализацияТоваровУслуг - записываемая реализация.
//  РежимЗаписи - РежимЗаписиДокумента - проведение или отмена проведения.
//
Процедура ЗаблокироватьРеализациюПоОрдерам(ДокОбъект, РежимЗаписи) Экспорт
	СтрокиОрдеров = СтрокиОрдеровРеализации(ДокОбъект);
	Если СтрокиОрдеров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Отмена = РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
	КонтекстАвтовыпуска = Производство.КонтекстАвтовыпуска(ДокОбъект, Отмена);
	Блокировка = Новый БлокировкаДанных;
	ДокОбъект.ЗаполнитьБлокировкуПроведения(Блокировка, КонтекстАвтовыпуска);
	Блокировка.Заблокировать();
	Менеджер = РегистрыНакопления.СебестоимостьПродаж;
	Реализации = Менеджер.РеализацииПарОрдеров(ДокОбъект.ДополнительныеСвойства.ОрдераДокумента);
	Если Не ДокОбъект.Ссылка.Пустая() И Реализации.Найти(ДокОбъект.Ссылка) = Неопределено Тогда
		Реализации.Добавить(ДокОбъект.Ссылка);
	КонецЕсли;
	Менеджер.ЗаблокироватьРеализации(Реализации);
	ДокОбъект.ДополнительныеСвойства.Вставить("КонтекстАвтовыпускаПередЗаписью", КонтекстАвтовыпуска);
	ДокОбъект.ДополнительныеСвойства.Вставить("СтрокиОрдеровДокумента", СтрокиОрдеров);
КонецПроцедуры

// Номенклатура строк реализации и составляющих комплектов - новой и сохранённой версий (Ф3.8).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - реализация.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура.
//
Функция ПозицииБлокировкиРеализации(ДокОбъект) Экспорт
	Источник = ДокОбъект.ТЧТовары.Выгрузить(, "Номенклатура");
	Если Не ДокОбъект.Ссылка.Пустая() Тогда
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Строки.Номенклатура КАК Номенклатура
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК Строки
		|ГДЕ
		|	Строки.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", ДокОбъект.Ссылка);
		Для Каждого Позиция Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура") Цикл
			Источник.Добавить().Номенклатура = Позиция;
		КонецЦикла;
	КонецЕсли;
	Возврат РегистрыНакопления.ТоварыВНаличии.НоменклатураССоставляющими(Источник);
КонецФункции

// Склады, на которых реализация пишет или удаляет партии: новой версии и сохранённой, если склад неордерный на дату
// версии (на ордерном партии списывает расходный ордер).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - реализация.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.МестаХранения
//
Функция СкладыПартийРеализации(ДокОбъект) Экспорт
	Склады = Новый Массив;
	Если Не Справочники.МестаХранения.ОрдерныйСклад(ДокОбъект.МестоХранения, ДокОбъект.Дата) Тогда
		Склады.Добавить(ДокОбъект.МестоХранения);
	КонецЕсли;
	Если Не ДокОбъект.Ссылка.Пустая() Тогда
		Прежние = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОбъект.Ссылка, "МестоХранения, Дата, Проведен");
		Если Прежние.Проведен И Склады.Найти(Прежние.МестоХранения) = Неопределено
			И Не Справочники.МестаХранения.ОрдерныйСклад(Прежние.МестоХранения, Прежние.Дата) Тогда
			Склады.Добавить(Прежние.МестоХранения);
		КонецЕсли;
	КонецЕсли;
	Возврат Склады;
КонецФункции

// Прямое удаление проведённого поступления или реализации с парами оформления - отказ: удаление не вызывает отмену
// проведения и её ближний пересчёт (Ф3.7).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.РеализацияТоваровУслуг - удаляемый документ.
//  Отказ     - Булево - выставляется.
//
Процедура ПроверитьУдалениеОформляющего(ДокОбъект, Отказ) Экспорт
	Если РегистрыНакопления.ТоварыКОформлению.ПрежниеОрдера(ДокОбъект.Ссылка).Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Текст = НСтр("ru = 'Документ оформляет ордера склада: сначала отмените его проведение, затем удаляйте.';
		|fr = 'Le document régularise des bons d''entrepôt : dévalidez-le d''abord, puis supprimez-le.';
		|en = 'The document documents warehouse orders: unpost it first, then delete it.';
		|es = 'El documento formaliza órdenes de almacén: anule primero su contabilización y después elimínelo.'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ДокОбъект, , , Отказ);
КонецПроцедуры

// Отмена поступления, оформившего приходные ордера, при проведённых допрасходах на это поступление - отказ (Ф3.9): без
// пар их база на партиях ордеров пуста, документ допрасходов не перепровёлся бы, пересчёт встал бы на нём. Блокировка
// оформления по ордерам поступления уже взята; документ допрасходов берёт ту же.
//
// Параметры:
//  Поступление - ДокументОбъект.ПоступлениеТоваровУслуг - отменяемое поступление.
//  Отказ       - Булево - выставляется.
//
Процедура ПроверитьОтменуПоступленияСДопрасходами(Поступление, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Строки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеДополнительныхРасходов.ТЧТовары КАК Строки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеДополнительныхРасходов КАК Шапки
	|		ПО Строки.Ссылка = Шапки.Ссылка
	|ГДЕ
	|	Строки.ДокументПартии = &Поступление
	|	И Шапки.Проведен");
	Запрос.УстановитьПараметр("Поступление", Поступление.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'На поступление распределены допрасходы (%1): сначала отмените проведение этого документа.';
		|fr = 'Des frais sont répartis sur la réception (%1) : dévalidez d''abord ce document.';
		|en = 'Additional costs are allocated to the receipt (%1): unpost that document first.';
		|es = 'Hay gastos repartidos en la recepción (%1): anule primero ese documento.'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Выборка.Ссылка), Поступление, , , Отказ);
КонецПроцедуры

// Ордера, проведённые до 2.0.16.122 (без партий: движения ТоварыКОформлению есть, ТоварыВНаличии - нет), переводит на
// новую схему только пересчёт себестоимости - по порядку моментов, вместе с оформившими их документами (Ф3.15). Вне
// пересчёта запись такого ордера и проведение или отмена документа, оформляющего его, дали бы смешанное состояние
// (двойную партию или двойное списание) - отказ с указанием, что делать.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - записываемый ордер, поступление или реализация.
//  Ордера    - Массив из ДокументСсылка - ордера документа (прежние и новые).
//  Отказ     - Булево - выставляется.
//
Процедура ПроверитьСтаруюСхему(ДокОбъект, Ордера, Отказ) Экспорт
	Если Ордера.Количество() = 0 Или РаботаСДокументами.ПересчетСтоимости(ДокОбъект) Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Шаблон = НСтр("ru = 'Ордер %1 проведён до перехода ордеров на партии: сначала проведите ордер повторно (он переведёт и
		|документы, которые его оформили) или запустите пересчёт себестоимости (Сервис - Перепроведение документов).';
		|fr = 'Le bon %1 a été validé avant le passage des bons aux lots : revalidez d''abord le bon (il convertit aussi ses
		|documents de régularisation) ou lancez le recalcul du coût (Service - Repasser les documents).';
		|en = 'Order %1 was posted before orders moved to batches: first post the order again (it also converts its
		|documenting documents) or run cost recalculation (Service - Document reposting).';
		|es = 'La orden %1 se contabilizó antes del paso de las órdenes a lotes: primero vuelva a contabilizar la orden (también
		|convierte sus documentos de formalización) o ejecute el recálculo del coste (Servicio - Volver a contabilizar
		|documentos).'");
	Для Каждого Ордер Из ОрдераБезПартий(Ордера) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Ордер), ДокОбъект, , , Отказ);
	КонецЦикла;
КонецПроцедуры

// Проведённый документ, оформляющий ордера, нельзя перезаписать с изменениями без перепроведения: контроль остатков к
// оформлению действует только при записи движений (общий план). Правило - в ПередЗаписью, действует и при программной
// записи.
//
// Параметры:
//  ДокОбъект   - ДокументОбъект - поступление или реализация.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  Отказ       - Булево - выставляется при нарушении.
//
Процедура ПроверитьЗаписьБезПроведения(ДокОбъект, РежимЗаписи, Отказ) Экспорт
	Если РежимЗаписи <> РежимЗаписиДокумента.Запись Или ДокОбъект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Сохраненный = ДокОбъект.Ссылка.ПолучитьОбъект();
	Если Не Сохраненный.Проведен Или Не ЕстьСтрокиСОрдером(Сохраненный) И Не ЕстьСтрокиСОрдером(ДокОбъект) Тогда
		Возврат;
	КонецЕсли;
	Если ДокументИзменен(ДокОбъект, Сохраненный) Тогда
		Текст = НСтр("ru = 'Проведённый документ по ордерам с изменениями можно только провести заново или отменить его
			|проведение.';
			|fr = 'Un document validé sur bons et modifié ne peut être que revalidé ou dévalidé.';
			|en = 'A posted document on orders with changes can only be posted again or unposted.';
			|es = 'Un documento contabilizado por órdenes con cambios solo puede volver a contabilizarse o anularse.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ДокОбъект, , , Отказ);
	КонецЕсли;
КонецПроцедуры

// Ордера основания ввода поступления или реализации: один ордер или массив ордеров (команда списка ордеров).
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - данные заполнения документа.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - ордера; пустой - основание не ордера.
//
Функция ОрдераОснования(ДанныеЗаполнения) Экспорт
	Ордера = Новый Массив;
	Значения = ?(ТипЗнч(ДанныеЗаполнения) = Тип("Массив"), ДанныеЗаполнения,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеЗаполнения));
	Для Каждого Значение Из Значения Цикл
		Если ЭтоСсылкаОрдера(Значение) Тогда
			Ордера.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Ордера;
КонецФункции

// Ввод поступления или реализации на основании ордеров (одного или нескольких): шапка - склад, организация,
// контрагент и основание ордеров; строки - неоформленный остаток коммерческих строк ордеров с новыми кодами строк; цены
// - по строке заказа-основания; без заказа цена не заполняется, её вводит пользователь.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.РеализацияТоваровУслуг - заполняемый документ.
//  Ордера    - Массив из ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - ордера одного вида.
//
Процедура ЗаполнитьПоОрдерам(ДокОбъект, Ордера) Экспорт
	Если Ордера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Шапка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ордера[0], "Организация, Контрагент, МестоХранения, Основание");
	ЗаполнитьЗначенияСвойств(ДокОбъект, Шапка, "Организация, Контрагент, МестоХранения");
	ЭтоРеализация = ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг");
	ТипЗаказа = ?(ЭтоРеализация, Тип("ДокументСсылка.ЗаказПокупателя"), Тип("ДокументСсылка.ЗаказПоставщику"));
	ЕстьЗаказ = ТипЗнч(Шапка.Основание) = ТипЗаказа И ЗначениеЗаполнено(Шапка.Основание);
	// Основание ордера переносится, если документ его допускает (поступление - и заказ клиента, и реализацию): проверка
	// шапки сверяет основание документа с основанием ордеров.
	Если ОснованиеПереносится(ДокОбъект, Шапка.Основание) Тогда
		ДокОбъект.Основание = Шапка.Основание;
	КонецЕсли;
	Если ЕстьЗаказ Тогда
		РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Шапка.Основание, "Договор, ЦенаВключаетНДС");
		ЗаполнитьЗначенияСвойств(ДокОбъект, РеквизитыЗаказа);
		РаботаСВалютами.ЗаполнитьВалютуПоОснованию(ДокОбъект, Шапка.Основание);
	ИначеЕсли ЗначениеЗаполнено(ДокОбъект.Контрагент) Тогда
		ДокОбъект.Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(ДокОбъект.Контрагент, ДокОбъект.Организация,
			ЭтоРеализация);
	Иначе
		ДокОбъект.Договор = Неопределено;
	КонецЕсли;
	ЦеныЗаказа = ЦеныСтрокЗаказа(ДокОбъект.Основание, Ордера);
	ДокОбъект.ТЧТовары.Очистить();
	КодСтроки = 0;
	Остатки = РегистрыНакопления.ТоварыКОформлению.НеоформленныеСтроки(Ордера);
	РеквизитыПозиций = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Остатки.ВыгрузитьКолонку("Номенклатура"),
		"Единица, СтавкаНДС");
	Для Каждого Остаток Из Остатки Цикл
		Строка = ДокОбъект.ТЧТовары.Добавить();
		КодСтроки = КодСтроки + 1;
		Строка.КодСтроки = КодСтроки;
		ЗаполнитьЗначенияСвойств(Строка, Остаток, "Ордер, КлючСтрокиОрдера, Номенклатура, Характеристика, Серия, Количество");
		Строка.КоличествоУпаковок = Остаток.Количество;
		РеквизитыНоменклатуры = РеквизитыПозиций[Остаток.Номенклатура];
		Строка.Упаковка = РеквизитыНоменклатуры.Единица;
		Строка.СтавкаНДС = РеквизитыНоменклатуры.СтавкаНДС;
		Цена = ЦеныЗаказа[КлючЦены(Остаток.Ордер, Остаток.КлючСтрокиОрдера)];
		Если Цена <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Строка, Цена);
		КонецЕсли;
		// Расчёт от цены: цена за единицу хранения (ЦенаSKU) выводится из неё, а не затирает её пустой.
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Строка, ДокОбъект.ЦенаВключаетНДС, "Цена");
	КонецЦикла;
КонецПроцедуры

// Сверка ордеров, выделенных в очереди «К оформлению», до открытия формы оформления (план warehouse-orders, фаза 4,
// §4.1): ордера одного вида, проведены, с неоформленным остатком, один склад, организация и контрагент, одно переносимое
// основание - те же правила, что проверяет проведение оформляющего документа (ПроверитьШапкиОрдеров).
//
// Параметры:
//  Ордера - Массив из ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - выделенные ордера.
//
// Возвращаемое значение:
//  Структура - Текст (Строка - причина отказа; пустая - можно оформлять), ИмяФормы (Строка - форма нового поступления
//              или реализации).
//
Функция ПроверкаОформленияОрдеров(Ордера) Экспорт
	Результат = Новый Структура("Текст, ИмяФормы", "", "");
	Если ТипЗнч(Ордера) <> Тип("Массив") Или Ордера.Количество() = 0 Тогда
		Результат.Текст = НСтр("ru = 'Выделите ордера для оформления.'; fr = 'Sélectionnez les bons à régulariser.';
			|en = 'Select the orders to document.'; es = 'Seleccione las órdenes por formalizar.'");
		Возврат Результат;
	КонецЕсли;
	ТипПервого = ТипЗнч(Ордера[0]);
	Для Каждого Ордер Из Ордера Цикл
		Если Не ЭтоСсылкаОрдера(Ордер) Или ТипЗнч(Ордер) <> ТипПервого Тогда
			Результат.Текст = НСтр("ru = 'Оформляются ордера одного вида.'; fr = 'Seuls des bons d''un même type se régularisent ensemble.';
				|en = 'Only orders of one kind are documented together.'; es = 'Solo se formalizan juntas órdenes de un tipo.'");
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Расходные = ТипПервого = Тип("ДокументСсылка.РасходныйОрдер");
	Результат.ИмяФормы = ?(Расходные, "Документ.РеализацияТоваровУслуг.ФормаОбъекта",
		"Документ.ПоступлениеТоваровУслуг.ФормаОбъекта");
	МетаданныеДокумента = ?(Расходные, Метаданные.Документы.РеализацияТоваровУслуг,
		Метаданные.Документы.ПоступлениеТоваровУслуг);
	Если Не ПравоДоступа("Добавление", МетаданныеДокумента) Тогда
		Шаблон = НСтр("ru = 'Нет права вводить документы «%1».'; fr = 'Aucun droit de saisir les documents « %1 ».';
			|en = 'No right to enter ""%1"" documents.'; es = 'Sin derecho a introducir documentos «%1».'");
		Результат.Текст = СтрШаблон(Шаблон, МетаданныеДокумента.Представление());
		Возврат Результат;
	КонецЕсли;
	Результат.Текст = ТекстРасхожденияОрдеров(Ордера, Расходные);
	Возврат Результат;
КонецФункции

// Блокировка проведения ордера заранее - для вызывающего, который проверяет остатки под той же блокировкой до записи
// (пакет поступления рабочего места, план warehouse-orders, фаза 3, §3.3). Те же ключи и порядок, что берёт
// ПередЗаписью ордера; повторная блокировка в той же транзакции не конфликтует.
//
// Параметры:
//  Ордер       - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - ордер.
//  Блокировка  - БлокировкаДанных - заполняемая блокировка.
//  РежимЗаписи - РежимЗаписиДокумента - режим будущей записи.
//
Процедура ЗаполнитьБлокировкуОрдера(Ордер, Блокировка, РежимЗаписи) Экспорт
	ЗаполнитьБлокировку(Ордер, Блокировка, РежимЗаписи);
КонецПроцедуры

// Данные фирменной печати ордеров (см. ФирменнаяПечать.Напечатать): накладная без цен - склад, контрагент и основание
// в шапке, строки - количество (docs/plans/warehouse-orders.md, фаза 2, §2.9). Вид формы и право на команду проверяет
// адаптер менеджера.
//
// Параметры:
//  ИмяДокумента - Строка - ПриходныйОрдер или РасходныйОрдер.
//  Ссылки       - Массив из ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - печатаемые ордера.
//  КодЯзыка     - Строка - язык печати.
//
// Возвращаемое значение:
//  Соответствие - ордер -> источник печати (см. ФирменнаяПечать.ИсточникТоварногоДокумента).
//
Функция ДанныеФирменнойПечати(ИмяДокумента, Ссылки, КодЯзыка) Экспорт
	// Ссылки - одного вида: запрос к обоим документам, лишняя часть пуста.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ордер.Ссылка КАК Ссылка,
	|	Ордер.Номер КАК НомерДокумента,
	|	Ордер.Дата КАК Дата,
	|	Ордер.Организация КАК Организация,
	|	Ордер.Контрагент КАК Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(Ордер.МестоХранения) КАК Склад,
	|	ПРЕДСТАВЛЕНИЕ(Ордер.Основание) КАК Основание,
	|	Ордер.Комментарий КАК Комментарий,
	|	ПРЕДСТАВЛЕНИЕ(Ордер.Ответственный) КАК Автор,
	|	ЕСТЬNULL(Контрагенты.Код, """") КАК КодКонтрагента
	|ИЗ
	|	Документ.ПриходныйОрдер КАК Ордер
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Ордер.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	Ордер.Ссылка В (&Ссылки)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Ордер.Ссылка,
	|	Ордер.Номер,
	|	Ордер.Дата,
	|	Ордер.Организация,
	|	Ордер.Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(Ордер.МестоХранения),
	|	ПРЕДСТАВЛЕНИЕ(Ордер.Основание),
	|	Ордер.Комментарий,
	|	ПРЕДСТАВЛЕНИЕ(Ордер.Ответственный),
	|	ЕСТЬNULL(Контрагенты.Код, """")
	|ИЗ
	|	Документ.РасходныйОрдер КАК Ордер
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Ордер.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	Ордер.Ссылка В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Приходный = ИмяДокумента = Метаданные.Документы.ПриходныйОрдер.Имя;
	Строки = ФирменнаяПечать.ДанныеСтрокДокументов(ИмяДокумента, Ссылки, "ТЧТовары");
	Кэш = ФирменнаяПечать.НовыйКэш();
	ПодписьСклада = НСтр("ru = 'Склад'; fr = 'Entrepôt'; en = 'Warehouse'; es = 'Almacén'", КодЯзыка);
	ПодписьОснования = НСтр("ru = 'Основание'; fr = 'Document de base'; en = 'Basis document';
		|es = 'Documento base'", КодЯзыка);
	Наименование = ?(Приходный, "Bon de reception", "Bon de sortie");
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Шапка = ФирменнаяПечать.НоваяШапкаДокумента();
		ЗаполнитьЗначенияСвойств(Шапка, Выборка, "Дата, Организация, Комментарий, Автор, КодКонтрагента");
		Если ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			Шапка.Контрагент = Выборка.Контрагент;
		Иначе
			// Ордер под заказ на производство или без основания: второй стороны нет - в её блоке склад.
			Шапка.КонтрагентПредставление = Выборка.Склад;
		КонецЕсли;
		Шапка.ОрганизацияПокупатель = Приходный;
		Шапка.Номер = ФирменнаяПечать.НомерНакладной(Выборка.НомерДокумента, Выборка.Дата);
		ЧастиОснования = Новый Массив;
		ЧастиОснования.Добавить(ПодписьСклада + ": " + Выборка.Склад);
		Если ЗначениеЗаполнено(Выборка.Основание) Тогда
			ЧастиОснования.Добавить(ПодписьОснования + ": " + Выборка.Основание);
		КонецЕсли;
		Шапка.Основание = СтрСоединить(ЧастиОснования, "; ");
		ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента(Наименование, Выборка.НомерДокумента, Выборка.Дата);
		Результат.Вставить(Выборка.Ссылка,
			ФирменнаяПечать.ИсточникТоварногоДокумента(Шапка, Строки[Выборка.Ссылка], Кэш, ИмяФайла));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Перевод документов, оформивших ордер до 2.0.16.122, в одной транзакции с ордером (Ф3.15): их записи партий на
// ордерном складе (поступление - приход, реализация - списание) снимаются - партию теперь создаёт или списывает сам
// ордер (после этой процедуры), двойной партии и двойного списания нет ни в какой момент. Документ мог оформить и
// другие ордера старой схемы - они переводятся вместе: связная группа «ордера - документы» целиком, под блокировкой
// позиций каждого ордера; сначала партии приходных ордеров, затем снятие записей документов, затем списание расходных и
// себестоимость их пар. Прочие движения документов не меняются.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - проведённый ордер.
//  Отказ - Булево - выставляется, если ордер группы не переводится (нехватка партий).
//
Процедура ПеревестиСтарыеОформления(Ордер, Отказ)
	СтараяСхема = Ложь;
	Если Не Ордер.ДополнительныеСвойства.Свойство(ИмяСвойстваСтаройСхемы(), СтараяСхема) Или Не СтараяСхема Тогда
		Возврат;
	КонецЕсли;
	Группа = ГруппаСтарыхОформлений(Ордер.Ссылка);
	Если Группа.Документы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Объекты = Новый Массив;
	Для Каждого Ссылка Из Группа.Ордера Цикл
		Объект = Ссылка.ПолучитьОбъект();
		Блокировка = Новый БлокировкаДанных;
		ЗаполнитьБлокировку(Объект, Блокировка, РежимЗаписиДокумента.Проведение);
		Блокировка.Заблокировать();
		Объекты.Добавить(Объект);
	КонецЦикла;
	Для Каждого Объект Из Объекты Цикл
		Если Не ЭтоРасходный(Объект) Тогда
			ЗаписатьСтоимостныеДвижения(Объект, Отказ);
		КонецЕсли;
	КонецЦикла;
	СнятьЗаписиОрдерногоСклада(Группа.Документы);
	ПереназначитьПартииПоступлений(Группа.Документы);
	// Списание расходных ордеров группы - строго по возрастанию момента, вместе с текущим: ФИФО раннего не видит
	// расхода позднего. Позже текущего (и все - при текущем приходном: его партий ещё нет) - после записи его движений
	// (ДописатьПозднихСтарыхОрдеров).
	Поздние = Новый Массив;
	МоментОрдера = Ордер.МоментВремени();
	Для Каждого Объект Из ПоМоменту(Объекты) Цикл
		Если Не ЭтоРасходный(Объект) Или Отказ Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоРасходный(Ордер) Или Объект.МоментВремени().Сравнить(МоментОрдера) > 0 Тогда
			Поздние.Добавить(Объект);
		Иначе
			ЗаписатьСписаниеСтарогоОрдера(Объект, Отказ);
		КонецЕсли;
	КонецЦикла;
	Ордер.ДополнительныеСвойства.Вставить("ПоздниеСтарыеОрдера", Поздние);
КонецПроцедуры

// Списание расходных ордеров группы старой схемы позже текущего - после записи его движений, по возрастанию момента.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - проведённый ордер.
//  Отказ - Булево - выставляется.
//
Процедура ДописатьПозднихСтарыхОрдеров(Ордер, Отказ)
	Поздние = Неопределено;
	Если Не Ордер.ДополнительныеСвойства.Свойство("ПоздниеСтарыеОрдера", Поздние) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Объект Из Поздние Цикл
		ЗаписатьСписаниеСтарогоОрдера(Объект, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьСписаниеСтарогоОрдера(Объект, Отказ)
	ЗаписатьСтоимостныеДвижения(Объект, Отказ);
	Если Не Отказ Тогда
		РегистрыНакопления.СебестоимостьПродаж.ПересчитатьПоПарам(СтрокиРасходногоОрдера(Объект), Объект);
	КонецЕсли;
КонецПроцедуры

// Объекты документов по возрастанию момента времени.
//
// Параметры:
//  Объекты - Массив из ДокументОбъект - документы.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект - те же, упорядоченные.
//
Функция ПоМоменту(Объекты)
	Результат = Новый Массив;
	Для Каждого Объект Из Объекты Цикл
		Индекс = 0;
		Момент = Объект.МоментВремени();
		Пока Индекс < Результат.Количество() И Результат[Индекс].МоментВремени().Сравнить(Момент) <= 0 Цикл
			Индекс = Индекс + 1;
		КонецЦикла;
		Результат.Вставить(Индекс, Объект);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура СнятьЗаписиОрдерногоСклада(Оформившие)
	Для Каждого Регистратор Из Оформившие Цикл
		Для Каждого Менеджер Из СтоимостныеМенеджеры() Цикл
			Набор = Менеджер.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Установить(Регистратор);
			Набор.Прочитать();
			Записи = Набор.Выгрузить();
			Было = Записи.Количество();
			РегистрыНакопления.ТоварыНаСкладах.ИсключитьЗаписиОрдерногоСклада(Записи, Регистратор);
			Если Записи.Количество() <> Было Тогда
				Набор.Загрузить(Записи);
				Набор.Записать(Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Документы, списавшие или переместившие партию-поступление ордерного склада до 2.0.16.122, после перевода ссылаются на
// партию, у которой прихода больше нет: их записи переходят на партию ордера пары поступления (Ф3.15), если ордер по
// номенклатуре строки один. Склады, где поступление сохранило свои записи (подчинённый неордерный), не трогаются.
// Неоднозначные записи остаются; их документы перепроводит пересчёт последовательности (граница - не позже ордера).
//
// Параметры:
//  Оформившие - Массив из ДокументСсылка - документы группы (поступления и реализации).
//
Процедура ПереназначитьПартииПоступлений(Оформившие)
	Для Каждого Поступление Из Оформившие Цикл
		Если ТипЗнч(Поступление) <> Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			Продолжить;
		КонецЕсли;
		Карта = ОрдераПозицийПоступления(Поступление);
		Если Карта.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Блокировка = Новый БлокировкаДанных;
		Для Каждого Имя Из СтрРазделить("ТоварыВНаличии,ДополнительныеРасходы,ТоварыВПереработке,СебестоимостьПродаж", ",") Цикл
			Эл = Блокировка.Добавить("РегистрНакопления." + Имя);
			Эл.Режим = РежимБлокировкиДанных.Исключительный;
			Эл.УстановитьЗначение("Партия", Поступление);
		КонецЦикла;
		Блокировка.Заблокировать();
		Свои = СкладыСвоихЗаписей(Поступление);
		Для Каждого Строка Из РегистраторыПартии(Поступление) Цикл
			ПереназначитьНабор(Строка.Имя, Строка.Регистратор, Поступление, Карта, Свои);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Ордер пары поступления по позиции его строки.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//
// Возвращаемое значение:
//  Соответствие - ключ позиции (см. КлючПозиции) -> Структура (Ордер, Дата); у позиции с несколькими ордерами -
//                 Ложь.
//
Функция ОрдераПозицийПоступления(Поступление)
	Карта = Новый Соответствие;
	Строки = Поступление.ТЧТовары.Выгрузить(, "КодСтроки, Номенклатура, Характеристика, Серия");
	Пары = РегистрыНакопления.ТоварыКОформлению.ПарыОформления(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Поступление));
	Для Каждого Пара Из Пары Цикл
		Строка = Строки.Найти(Пара.КодСтрокиРегистратора, "КодСтроки");
		Если Пара.Регистратор <> Поступление Или Строка = Неопределено Или Не ЭтоСсылкаОрдера(Пара.Источник) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючПозиции(Строка.Номенклатура, Строка.Характеристика, Строка.Серия);
		Прежний = Карта.Получить(Ключ);
		Если Прежний = Неопределено Тогда
			Дата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пара.Источник, "Дата");
			Карта.Вставить(Ключ, Новый Структура("Ордер, Дата", Пара.Источник, Дата));
		Иначе
			Карта.Вставить(Ключ, ?(ТипЗнч(Прежний) = Тип("Структура") И Прежний.Ордер = Пара.Источник, Прежний, Ложь));
		КонецЕсли;
	КонецЦикла;
	Возврат Карта;
КонецФункции

Функция КлючПозиции(Номенклатура, Характеристика, Серия)
	Возврат СтрШаблон("%1|%2|%3", Номенклатура.УникальныйИдентификатор(), Характеристика.УникальныйИдентификатор(),
		Серия.УникальныйИдентификатор());
КонецФункции

Функция СкладыСвоихЗаписей(Поступление)
	Набор = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Поступление);
	Набор.Прочитать();
	Возврат Набор.Выгрузить().ВыгрузитьКолонку("МестоХранения");
КонецФункции

Функция РегистраторыПартии(Поступление)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""ТоварыВНаличии"" КАК Имя,
	|	Т.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|ГДЕ
	|	Т.Партия = &Поступление
	|	И Т.Регистратор <> &Поступление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""ДополнительныеРасходы"",
	|	Т.Регистратор
	|ИЗ
	|	РегистрНакопления.ДополнительныеРасходы КАК Т
	|ГДЕ
	|	Т.Партия = &Поступление
	|	И Т.Регистратор <> &Поступление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""ТоварыВПереработке"",
	|	Т.Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыВПереработке КАК Т
	|ГДЕ
	|	Т.Партия = &Поступление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""СебестоимостьПродаж"",
	|	Т.Регистратор
	|ИЗ
	|	РегистрНакопления.СебестоимостьПродаж КАК Т
	|ГДЕ
	|	Т.Партия = &Поступление");
	Запрос.УстановитьПараметр("Поступление", Поступление);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ПереназначитьНабор(Имя, Регистратор, Поступление, Карта, Свои)
	ЭтоПродажи = Имя = "СебестоимостьПродаж";
	ПолеНоменклатуры = ?(ЭтоПродажи, "НоменклатураПартии", "Номенклатура");
	ПолеСклада = ?(ЭтоПродажи, "СкладОтгрузки", "МестоХранения");
	Если Имя = "ТоварыВПереработке" Тогда
		ПолеСклада = "";
	КонецЕсли;
	ЕстьДата = Имя <> "ДополнительныеРасходы";
	Набор = РегистрыНакопления[Имя].СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	Изменен = Ложь;
	Для Каждого Запись Из Набор Цикл
		СвойСклад = ЗначениеЗаполнено(ПолеСклада) И Свои.Найти(Запись[ПолеСклада]) <> Неопределено;
		Ордер = ?(Запись.Партия = Поступление И Не СвойСклад,
			Карта.Получить(КлючПозиции(Запись[ПолеНоменклатуры], Запись.Характеристика, Запись.Серия)), Неопределено);
		Если ТипЗнч(Ордер) = Тип("Структура") Тогда
			Запись.Партия = Ордер.Ордер;
			Если ЕстьДата Тогда
				Запись.ДатаПартии = Ордер.Дата;
			КонецЕсли;
			Изменен = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Изменен Тогда
		Набор.Записать(Истина);
	КонецЕсли;
КонецПроцедуры

// Связная группа старой схемы от ордера: документы, оформившие ордера группы, и прочие ордера этих документов без
// партий (проведены до 2.0.16.122) - до неподвижной точки.
//
// Параметры:
//  Ордер - ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - переводимый ордер.
//
// Возвращаемое значение:
//  Структура - Документы (Массив - поступления и реализации), Ордера (Массив - другие ордера старой схемы).
//
Функция ГруппаСтарыхОформлений(Ордер)
	Оформившие = Новый Массив;
	Ордера = Новый Массив;
	Все = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ордер);
	Фронт = Все;
	Пока Фронт.Количество() > 0 Цикл
		НовыеДокументы = Новый Массив;
		Для Каждого Пара Из РегистрыНакопления.ТоварыКОформлению.ПарыОформления(Фронт) Цикл
			Если Фронт.Найти(Пара.Источник) <> Неопределено И Оформившие.Найти(Пара.Регистратор) = Неопределено Тогда
				Оформившие.Добавить(Пара.Регистратор);
				НовыеДокументы.Добавить(Пара.Регистратор);
			КонецЕсли;
		КонецЦикла;
		Фронт = ОрдераБезПартий(ДругиеОрдераДокументов(НовыеДокументы, Все));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Все, Фронт);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Ордера, Фронт);
	КонецЦикла;
	Возврат Новый Структура("Документы, Ордера", Оформившие, Ордера);
КонецФункции

Функция ДругиеОрдераДокументов(Оформившие, Известные)
	Ордера = Новый Массив;
	Если Оформившие.Количество() = 0 Тогда
		Возврат Ордера;
	КонецЕсли;
	Для Каждого Пара Из РегистрыНакопления.ТоварыКОформлению.ПарыОформления(Оформившие) Цикл
		Если ЭтоСсылкаОрдера(Пара.Источник) И Известные.Найти(Пара.Источник) = Неопределено
			И Ордера.Найти(Пара.Источник) = Неопределено Тогда
			Ордера.Добавить(Пара.Источник);
		КонецЕсли;
	КонецЦикла;
	Возврат Ордера;
КонецФункции

Функция ИмяСвойстваСтаройСхемы()
	Возврат "СтараяСхемаОрдера";
КонецФункции

Функция ОрдераБезПартий(Ордера)
	Если Ордера.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Оформление.Регистратор КАК Ордер
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению КАК Оформление
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВНаличии КАК Партии
	|		ПО Оформление.Регистратор = Партии.Регистратор
	|ГДЕ
	|	Оформление.Регистратор В (&Ордера)
	|	И Оформление.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Партии.Регистратор ЕСТЬ NULL");
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ордер");
КонецФункции

Процедура ЗаписатьСтоимостныеДвижения(Объект, Отказ)
	СформироватьСтоимостныеДвижения(Объект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Объект.Движения.ТоварыВНаличии.Записать();
	Объект.Движения.ДополнительныеРасходы.Записать();
КонецПроцедуры

Функция СтоимостныеМенеджеры()
	Менеджеры = Новый Массив;
	Менеджеры.Добавить(РегистрыНакопления.ТоварыВНаличии);
	Менеджеры.Добавить(РегистрыНакопления.ДополнительныеРасходы);
	Возврат Менеджеры;
КонецФункции

// Снимок состава расходного ордера, пересчитанный по справочнику после блокировки, не вышел за ключи блокировки
// остатков (Ф3.8): состав комплекта изменили в промежутке - отказ, без расширения блокировки.
//
// Параметры:
//  Ордер - ДокументОбъект.РасходныйОрдер - ордер.
//  Отказ - Булево - выставляется.
//
Процедура ПроверитьСоставВБлокировке(Ордер, Отказ)
	Позиции = Неопределено;
	Если Не Ордер.ДополнительныеСвойства.Свойство("ПозицииБлокировкиОрдера", Позиции) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из Ордер.ТЧФизическийСостав Цикл
		Если Позиции.Найти(Строка.Номенклатура) = Неопределено Тогда
			Текст = НСтр("ru = 'Состав комплекта изменён, пока ордер проводился. Проведите ордер ещё раз.';
				|fr = 'La composition du kit a changé pendant la validation du bon. Validez le bon à nouveau.';
				|en = 'The kit composition changed while the order was being posted. Post the order again.';
				|es = 'La composición del kit cambió mientras se contabilizaba la orden. Contabilice la orden de nuevo.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Ордер, , , Отказ);
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЭтоСсылкаОрдера(Значение)
	ЭтоОрдер = ТипЗнч(Значение) = Тип("ДокументСсылка.ПриходныйОрдер") Или ТипЗнч(Значение) = Тип("ДокументСсылка.РасходныйОрдер");
	Возврат ЭтоОрдер И ЗначениеЗаполнено(Значение);
КонецФункции

Функция ЕстьСтрокиСОрдером(ДокОбъект)
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Если ЗначениеЗаполнено(Строка.Ордер) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Отличается ли документ от сохранённой версии: реквизиты шапки (кроме комментария и ответственного), дата, строки
// товаров.
//
// Параметры:
//  ДокОбъект   - ДокументОбъект - записываемый документ.
//  Сохраненный - ДокументОбъект - версия из базы.
//
// Возвращаемое значение:
//  Булево - Истина, если есть изменения.
//
Функция ДокументИзменен(ДокОбъект, Сохраненный)
	Для Каждого Реквизит Из ДокОбъект.Метаданные().Реквизиты Цикл
		Имя = Реквизит.Имя;
		Сравнивается = Имя <> "Комментарий" И Имя <> "Ответственный";
		Если Сравнивается И ДокОбъект[Имя] <> Сохраненный[Имя] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Если ДокОбъект.Дата <> Сохраненный.Дата Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЗначениеВСтрокуВнутр(ДокОбъект.ТЧТовары.Выгрузить()) <> ЗначениеВСтрокуВнутр(Сохраненный.ТЧТовары.Выгрузить());
КонецФункции

// Ошибка строки товаров оформляющего документа без обращения к ордерам: ордер на неордерном складе, строка без ордера
// на ордерном, несколько серий в строке с ордером.
//
// Параметры:
//  Строка   - СтрокаТабличнойЧасти - строка товаров.
//  Ордерный - Булево - склад документа ордерный на его дату.
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - ошибки нет.
//
Функция ОшибкаСтрокиОформления(Строка, Ордерный)
	ЕстьОрдер = ЗначениеЗаполнено(Строка.Ордер);
	Если ЕстьОрдер И Не Ордерный Тогда
		Пояснение = НСтр("ru = 'склад не ордерный на дату документа - ордер в строке недопустим';
			|fr = 'l''entrepôt ne fonctionne pas par bons à la date du document - pas de bon dans la ligne';
			|en = 'the warehouse is not order-based on the document date - no order allowed in the line';
			|es = 'el almacén no funciona por órdenes en la fecha del documento - no se admite orden en la línea'");
	ИначеЕсли ЕстьОрдер И Строка.УказаноНесколькоСерий Тогда
		Пояснение = НСтр("ru = 'строка по ордеру - одна серия, как в ордере'; fr = 'ligne de bon - une seule série, comme dans le bon';
			|en = 'an order line has one series, as in the order'; es = 'una línea de orden tiene una serie, como en la orden'");
	ИначеЕсли Не ЕстьОрдер И Ордерный И Строка.Количество <> 0 Тогда
		Пояснение = НСтр("ru = 'склад ордерный - строка вводится только по ордеру кладовщика';
			|fr = 'entrepôt à bons - la ligne se saisit uniquement à partir d''un bon du magasinier';
			|en = 'order-based warehouse - the line is entered only from a storekeeper order';
			|es = 'almacén por órdenes - la línea solo se introduce desde una orden del almacenero'");
	Иначе
		Возврат "";
	КонецЕсли;
	Возврат ТекстСтроки(Строка, Пояснение);
КонецФункции

Функция ТекстСтроки(Строка, Текст)
	Шаблон = НСтр("ru = 'Строка %1 (%2): %3.'; fr = 'Ligne %1 (%2) : %3.'; en = 'Line %1 (%2): %3.'; es = 'Línea %1 (%2): %3.'");
	Возврат СтрШаблон(Шаблон, Строка.НомерСтроки, Строка.Номенклатура, Текст);
КонецФункции

// Шапки и строки ордеров документа одним пакетом.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - поступление (приходные ордера) или реализация (расходные).
//  Ордера    - Массив из ДокументСсылка - ордера строк.
//
// Возвращаемое значение:
//  Структура - Шапки (ТаблицаЗначений: Ссылка, Проведен, Дата, МестоХранения, Организация, Контрагент, Основание),
//              Строки (ТаблицаЗначений: Ордер, КодСтроки, Номенклатура, Характеристика, Серия).
//
Функция ДанныеОрдеровДокумента(ДокОбъект, Ордера)
	Запрос = Новый Запрос;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Ордера.Ссылка КАК Ссылка,
		|	Ордера.Проведен КАК Проведен,
		|	Ордера.Дата КАК Дата,
		|	Ордера.МестоХранения КАК МестоХранения,
		|	Ордера.Организация КАК Организация,
		|	Ордера.Контрагент КАК Контрагент,
		|	Ордера.Основание КАК Основание
		|ИЗ
		|	Документ.РасходныйОрдер КАК Ордера
		|ГДЕ
		|	Ордера.Ссылка В (&Ордера)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Строки.Ссылка КАК Ордер,
		|	Строки.КодСтроки КАК КодСтроки,
		|	Строки.Номенклатура КАК Номенклатура,
		|	Строки.Характеристика КАК Характеристика,
		|	Строки.Серия КАК Серия
		|ИЗ
		|	Документ.РасходныйОрдер.ТЧТовары КАК Строки
		|ГДЕ
		|	Строки.Ссылка В (&Ордера)";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Ордера.Ссылка КАК Ссылка,
		|	Ордера.Проведен КАК Проведен,
		|	Ордера.Дата КАК Дата,
		|	Ордера.МестоХранения КАК МестоХранения,
		|	Ордера.Организация КАК Организация,
		|	Ордера.Контрагент КАК Контрагент,
		|	Ордера.Основание КАК Основание
		|ИЗ
		|	Документ.ПриходныйОрдер КАК Ордера
		|ГДЕ
		|	Ордера.Ссылка В (&Ордера)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Строки.Ссылка КАК Ордер,
		|	Строки.КодСтроки КАК КодСтроки,
		|	Строки.Номенклатура КАК Номенклатура,
		|	Строки.Характеристика КАК Характеристика,
		|	Строки.Серия КАК Серия
		|ИЗ
		|	Документ.ПриходныйОрдер.ТЧТовары КАК Строки
		|ГДЕ
		|	Строки.Ссылка В (&Ордера)";
	КонецЕсли;
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Результаты = Запрос.ВыполнитьПакет();
	Возврат Новый Структура("Шапки, Строки", Результаты[0].Выгрузить(), Результаты[1].Выгрузить());
КонецФункции

// Шапки ордеров против документа: проведён, не позже, тот же склад, организация, контрагент; одно основание - основание
// документа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//  Шапки     - ТаблицаЗначений - см. ДанныеОрдеровДокумента.
//  Тексты    - Массив из Строка - тексты отказа; дополняется.
//
Процедура ПроверитьШапкиОрдеров(ДокОбъект, Шапки, Тексты)
	Основания = Новый Массив;
	Для Каждого Шапка Из Шапки Цикл
		// Основание, которого документ нести не может (поступление у расходного ордера к реализации), не сверяется;
		// пустое сверяется: ордер без основания не оформляется вместе с ордером по заказу.
		// Пустое основание - одно значение, какого бы типа ни была пустая ссылка.
		Основание = ?(ЗначениеЗаполнено(Шапка.Основание), Шапка.Основание, Неопределено);
		Сверяется = Основание = Неопределено Или ОснованиеПереносится(ДокОбъект, Основание);
		Если Сверяется И Основания.Найти(Основание) = Неопределено Тогда
			Основания.Добавить(Основание);
		КонецЕсли;
		Ошибки = ОшибкиШапкиОрдера(ДокОбъект, Шапка);
		Если Ошибки.Количество() > 0 Тогда
			Шаблон = НСтр("ru = 'Ордер %1: %2.'; fr = 'Bon %1 : %2.'; en = 'Order %1: %2.'; es = 'Orden %1: %2.'");
			Тексты.Добавить(СтрШаблон(Шаблон, Шапка.Ссылка, СтрСоединить(Ошибки, ", ")));
		КонецЕсли;
	КонецЦикла;
	// И пустое основание ордеров сверяется: ордер без заказа не оформляется документом с заказом (заказ поставщику
	// остался бы неисполненным - поступление ордерного склада его не двигает).
	ОснованиеДокумента = ?(ЗначениеЗаполнено(ДокОбъект.Основание), ДокОбъект.Основание, Неопределено);
	ДругоеОснование = Основания.Количество() = 1 И Основания[0] <> ОснованиеДокумента;
	Если Основания.Количество() > 1 Или ДругоеОснование Тогда
		Тексты.Добавить(НСтр("ru = 'Ордера документа - по одному заказу, он же основание документа.';
			|fr = 'Les bons du document relèvent d''une seule commande, qui est aussi la base du document.';
			|en = 'The document orders must refer to one order, which is also the document basis.';
			|es = 'Las órdenes del documento deben ser de un solo pedido, que es también la base del documento.'"));
	КонецЕсли;
КонецПроцедуры

// Строка ордера с кодом строки заказа - та же номенклатура и характеристика, что у строки заказа-основания: по коду
// ордер исполняет заказ (ЗаказыПоставщикам, отгрузка заказа клиента) - чужая позиция закрыла бы не ту строку.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - проводимый ордер.
//  Отказ - Булево - выставляется при расхождении.
//
Процедура ПроверитьСтрокиЗаказаОрдера(Ордер, Отказ)
	ТипЗаказа = ?(ЭтоРасходный(Ордер), Тип("ДокументСсылка.ЗаказПокупателя"), Тип("ДокументСсылка.ЗаказПоставщику"));
	Если ТипЗнч(Ордер.Основание) <> ТипЗаказа Или Не ЗначениеЗаполнено(Ордер.Основание) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Если ЭтоРасходный(Ордер) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Строки.КодСтроки КАК КодСтроки,
		|	Строки.Номенклатура КАК Номенклатура,
		|	Строки.Характеристика КАК Характеристика
		|ИЗ
		|	Документ.ЗаказПокупателя.ТЧТовары КАК Строки
		|ГДЕ
		|	Строки.Ссылка = &Заказ";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Строки.КодСтроки КАК КодСтроки,
		|	Строки.Номенклатура КАК Номенклатура,
		|	Строки.Характеристика КАК Характеристика
		|ИЗ
		|	Документ.ЗаказПоставщику.ТЧТовары КАК Строки
		|ГДЕ
		|	Строки.Ссылка = &Заказ";
	КонецЕсли;
	Запрос.УстановитьПараметр("Заказ", Ордер.Основание);
	СтрокиЗаказа = Запрос.Выполнить().Выгрузить();
	Шаблон = НСтр("ru = 'Строка %1 (%2): в заказе нет строки с этим товаром - строка ордера не может исполнять заказ.';
		|fr = 'Ligne %1 (%2) : la commande n''a pas de ligne avec cet article - la ligne du bon ne peut pas l''exécuter.';
		|en = 'Line %1 (%2): the order has no line with this item - the order line cannot fulfil it.';
		|es = 'Línea %1 (%2): el pedido no tiene una línea con este artículo - la línea de la orden no puede cumplirlo.'");
	Для Каждого Строка Из Ордер.ТЧТовары Цикл
		Если Строка.КодСтрокиЗаказа = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЗаказа = СтрокиЗаказа.Найти(Строка.КодСтрокиЗаказа, "КодСтроки");
		Если СтрокаЗаказа = Неопределено Или СтрокаЗаказа.Номенклатура <> Строка.Номенклатура
			Или СтрокаЗаказа.Характеристика <> Строка.Характеристика Тогда
			Текст = СтрШаблон(Шаблон, Строка.НомерСтроки, Строка.Номенклатура);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Ордер, , , Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ТекстРасхожденияОрдеров(Ордера, Расходные)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ордера.Ссылка КАК Ссылка,
	|	Ордера.Проведен КАК Проведен,
	|	Ордера.МестоХранения КАК МестоХранения,
	|	Ордера.Организация КАК Организация,
	|	Ордера.Контрагент КАК Контрагент,
	|	Ордера.Основание КАК Основание
	|ИЗ
	|	Документ.ПриходныйОрдер КАК Ордера
	|ГДЕ
	|	Ордера.Ссылка В (&Ордера)");
	Если Расходные Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ПриходныйОрдер", "Документ.РасходныйОрдер");
	КонецЕсли;
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Шапки = Запрос.Выполнить().Выгрузить();
	Образец = ?(Расходные, Документы.РеализацияТоваровУслуг.СоздатьДокумент(),
		Документы.ПоступлениеТоваровУслуг.СоздатьДокумент());
	Непроведенные = Шапки.НайтиСтроки(Новый Структура("Проведен", Ложь));
	Если Непроведенные.Количество() > 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Ордер %1 не проведён.'; fr = 'Le bon %1 n''est pas validé.';
			|en = 'Order %1 is not posted.'; es = 'La orden %1 no está contabilizada.'"), Непроведенные[0].Ссылка);
	КонецЕсли;
	Основания = СверяемыеОснования(Шапки);
	Для Каждого Имя Из СтрРазделить("МестоХранения,Организация,Контрагент", ",") Цикл
		Значения = Шапки.Скопировать(, Имя);
		Значения.Свернуть(Имя);
		Если Значения.Количество() > 1 Тогда
			Шаблон = НСтр("ru = 'У выделенных ордеров разные значения «%1»: оформляйте их отдельно.';
				|fr = 'Les bons sélectionnés ont des « %1 » différents : régularisez-les séparément.';
				|en = 'The selected orders have different ""%1"": document them separately.';
				|es = 'Las órdenes seleccionadas tienen distintos «%1»: formalícelas por separado.'");
			Возврат СтрШаблон(Шаблон, Образец.Метаданные().Реквизиты[Имя].Синоним);
		КонецЕсли;
	КонецЦикла;
	Если Основания.Количество() > 1 Тогда
		Возврат НСтр("ru = 'Выделенные ордера - по разным заказам: оформляйте их отдельно.';
			|fr = 'Les bons sélectionnés relèvent de commandes différentes : régularisez-les séparément.';
			|en = 'The selected orders refer to different orders: document them separately.';
			|es = 'Las órdenes seleccionadas son de pedidos distintos: formalícelas por separado.'");
	КонецЕсли;
	Если РегистрыНакопления.ТоварыКОформлению.НеоформленныеСтроки(Ордера).Количество() = 0 Тогда
		Возврат НСтр("ru = 'По выделенным ордерам оформлять нечего.'; fr = 'Rien à régulariser pour les bons sélectionnés.';
			|en = 'There is nothing to document for the selected orders.'; es = 'No hay nada por formalizar en las órdenes seleccionadas.'");
	КонецЕсли;
	Возврат "";
КонецФункции

Функция СверяемыеОснования(Шапки)
	// Строже ПроверитьШапкиОрдеров: основания всех ордеров совпадают, и непереносимые тоже - ЗаполнитьПоОрдерам берёт
	// основание первого ордера, иначе одобренный здесь документ отказал бы при проведении. Пустое - одно значение.
	Основания = Новый Массив;
	Для Каждого Шапка Из Шапки Цикл
		Основание = ?(ЗначениеЗаполнено(Шапка.Основание), Шапка.Основание, Неопределено);
		Если Основания.Найти(Основание) = Неопределено Тогда
			Основания.Добавить(Основание);
		КонецЕсли;
	КонецЦикла;
	Возврат Основания;
КонецФункции

Функция ОснованиеПереносится(ДокОбъект, Основание)
	Возврат ЗначениеЗаполнено(Основание)
		И ДокОбъект.Метаданные().Реквизиты.Основание.Тип.СодержитТип(ТипЗнч(Основание));
КонецФункции

Функция ОшибкиШапкиОрдера(ДокОбъект, Шапка)
	Ошибки = Новый Массив;
	Если Не Шапка.Проведен Тогда
		Ошибки.Добавить(НСтр("ru = 'не проведён'; fr = 'non validé'; en = 'not posted'; es = 'no contabilizada'"));
	КонецЕсли;
	// Ордер строго раньше документа по моменту времени (Ф3.11): при одной секунде порядок задаёт ссылка. У нового
	// документа без ссылки момент неизвестен - сверяется дата, момент - при проведении. Пересчёт стоимости перепроводит
	// историю как есть - прежнее правило «не позже по дате» (пары до 2.0.16.122 могли стоять в одной секунде).
	Если ДокОбъект.Ссылка.Пустая() Или РаботаСДокументами.ПересчетСтоимости(ДокОбъект) Тогда
		ОрдерПозже = Шапка.Дата > ДокОбъект.Дата;
	Иначе
		ОрдерПозже = МоментДокумента(Шапка.Дата, Шапка.Ссылка).Сравнить(ДокОбъект.МоментВремени()) >= 0;
	КонецЕсли;
	Если ОрдерПозже Тогда
		Ошибки.Добавить(НСтр("ru = 'не раньше документа'; fr = 'pas antérieur au document'; en = 'not earlier than the document';
			|es = 'no anterior al documento'"));
	КонецЕсли;
	Шаблон = НСтр("ru = 'другое значение «%1»'; fr = 'autre valeur « %1 »'; en = 'a different «%1»'; es = 'otro valor «%1»'");
	Для Каждого Имя Из СтрРазделить("МестоХранения,Организация,Контрагент", ",") Цикл
		Если Шапка[Имя] <> ДокОбъект[Имя] Тогда
			Синоним = ДокОбъект.Метаданные().Реквизиты[Имя].Синоним;
			Ошибки.Добавить(СтрШаблон(Шаблон, Синоним));
		КонецЕсли;
	КонецЦикла;
	Возврат Ошибки;
КонецФункции

// Строки документа против строк ордеров: строка есть в ордере, номенклатура, характеристика и серия совпадают.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект - документ.
//  СтрокиОрдеров - ТаблицаЗначений - см. ДанныеОрдеровДокумента.
//  Тексты        - Массив из Строка - тексты отказа; дополняется.
//
Процедура ПроверитьСтрокиПоОрдерам(ДокОбъект, СтрокиОрдеров, Тексты)
	ПоляКлюча = "Ордер, КодСтроки";
	СтрокиОрдеров.Индексы.Добавить(ПоляКлюча);
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Если Не ЗначениеЗаполнено(Строка.Ордер) Тогда
			Продолжить;
		КонецЕсли;
		Найденные = СтрокиОрдеров.НайтиСтроки(Новый Структура(ПоляКлюча, Строка.Ордер, Строка.КлючСтрокиОрдера));
		Если Найденные.Количество() = 0 Тогда
			Пояснение = НСтр("ru = 'в ордере нет такой строки'; fr = 'le bon n''a pas cette ligne';
				|en = 'the order has no such line'; es = 'la orden no tiene esa línea'");
		ИначеЕсли СтрокаОтличаетсяОтОрдера(Строка, Найденные[0]) Тогда
			Пояснение = НСтр("ru = 'номенклатура, характеристика и серия - как в строке ордера';
				|fr = 'article, caractéristique et série - comme dans la ligne du bon';
				|en = 'item, characteristic and series must match the order line';
				|es = 'artículo, característica y serie como en la línea de la orden'");
		Иначе
			Продолжить;
		КонецЕсли;
		Тексты.Добавить(ТекстСтроки(Строка, Пояснение));
	КонецЦикла;
КонецПроцедуры

Функция СтрокаОтличаетсяОтОрдера(Строка, СтрокаОрдера)
	Возврат СтрокаОрдера.Номенклатура <> Строка.Номенклатура Или СтрокаОрдера.Характеристика <> Строка.Характеристика
		Или СтрокаОрдера.Серия <> Строка.Серия;
КонецФункции

// Цены строк заказа-основания по ключам строк ордеров: строка ордера -> КодСтрокиЗаказа -> строка заказа.
//
// Параметры:
//  Заказ  - ДокументСсылка.ЗаказПокупателя, ДокументСсылка.ЗаказПоставщику, Неопределено - основание документа.
//  Ордера - Массив из ДокументСсылка - ордера.
//
// Возвращаемое значение:
//  Соответствие - ключ см. КлючЦены, значение Структура: Цена, СтавкаНДС.
//
Функция ЦеныСтрокЗаказа(Заказ, Ордера)
	Результат = Новый Соответствие;
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Если ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СтрокиОрдеров.Ссылка КАК Ордер,
		|	СтрокиОрдеров.КодСтроки КАК КодСтроки,
		|	СтрокиЗаказа.Цена КАК Цена,
		|	СтрокиЗаказа.КоличествоУпаковок КАК КоличествоУпаковок,
		|	СтрокиЗаказа.Количество КАК Количество,
		|	СтрокиЗаказа.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	Документ.РасходныйОрдер.ТЧТовары КАК СтрокиОрдеров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.ТЧТовары КАК СтрокиЗаказа
		|		ПО (СтрокиЗаказа.Ссылка = &Заказ)
		|			И СтрокиОрдеров.КодСтрокиЗаказа = СтрокиЗаказа.КодСтроки
		|ГДЕ
		|	СтрокиОрдеров.Ссылка В (&Ордера)";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СтрокиОрдеров.Ссылка КАК Ордер,
		|	СтрокиОрдеров.КодСтроки КАК КодСтроки,
		|	СтрокиЗаказа.Цена КАК Цена,
		|	СтрокиЗаказа.КоличествоУпаковок КАК КоличествоУпаковок,
		|	СтрокиЗаказа.Количество КАК Количество,
		|	СтрокиЗаказа.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	Документ.ПриходныйОрдер.ТЧТовары КАК СтрокиОрдеров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.ТЧТовары КАК СтрокиЗаказа
		|		ПО (СтрокиЗаказа.Ссылка = &Заказ)
		|			И СтрокиОрдеров.КодСтрокиЗаказа = СтрокиЗаказа.КодСтроки
		|ГДЕ
		|	СтрокиОрдеров.Ссылка В (&Ордера)";
	КонецЕсли;
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Цена заказа - за его упаковку, строка оформления - в единицах хранения: цена единицы = сумма строки / количество.
		ЦенаЕдиницы = ?(Выборка.Количество = 0, Выборка.Цена, Выборка.Цена * Выборка.КоличествоУпаковок / Выборка.Количество);
		Цена = Новый Структура("Цена, СтавкаНДС", ЦенаЕдиницы, Выборка.СтавкаНДС);
		Результат.Вставить(КлючЦены(Выборка.Ордер, Выборка.КодСтроки), Цена);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КлючЦены(Ордер, КодСтроки)
	Возврат XMLСтрока(Ордер) + "|" + Формат(КодСтроки, "ЧГ=0");
КонецФункции

Функция НоваяТаблицаСтрокОрдеров()
	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Ордер", Новый ОписаниеТипов("ДокументСсылка.РасходныйОрдер"));
	Строки.Колонки.Добавить("КодСтроки", Метаданные.ОпределяемыеТипы.КодСтроки.Тип);
	Возврат Строки;
КонецФункции

Функция ЭтоРасходныйОрдер(Значение)
	Возврат ТипЗнч(Значение) = Тип("ДокументСсылка.РасходныйОрдер");
КонецФункции

// Момент времени документа по дате и ссылке (у платформы нет вызова метода у «Новый» цепочкой).
//
// Параметры:
//  Дата   - Дата - дата документа
//  Ссылка - ДокументСсылка - документ
//
// Возвращаемое значение:
//  МоментВремени
//
Функция МоментДокумента(Дата, Ссылка)
	Возврат Новый МоментВремени(Дата, Ссылка);
КонецФункции

Функция ЭтоРасходный(Ордер)
	Возврат ТипЗнч(Ордер) = Тип("ДокументОбъект.РасходныйОрдер");
КонецФункции

// Коды строк - устойчивый ключ строки ордера (план, фаза 2, §2.1): пустой и повторный код получают новый, больше
// максимального; существующие не перенумеровываются.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - ордер.
//
Процедура ЗаполнитьКодыСтрок(Ордер)
	Максимум = 0;
	Для Каждого Строка Из Ордер.ТЧТовары Цикл
		Максимум = Макс(Максимум, Строка.КодСтроки);
	КонецЦикла;
	Встреченные = Новый Соответствие;
	Для Каждого Строка Из Ордер.ТЧТовары Цикл
		Если Строка.КодСтроки = 0 Или Встреченные[Строка.КодСтроки] <> Неопределено Тогда
			Максимум = Максимум + 1;
			Строка.КодСтроки = Максимум;
		КонецЕсли;
		Встреченные.Вставить(Строка.КодСтроки, Истина);
	КонецЦикла;
КонецПроцедуры

// Объект блокировки ордера - тем же набором и порядком, что документ-образец (общий план, «Блокировки»): склады
// разделяемо, складские регистры по номенклатуре строк и составляющих (прежних и новых), потребности и заказы
// поставщику (приходный) или широкий элемент и потребности автовыпуска (расходный), ТоварыКОформлению по себе - последним.
//
// Параметры:
//  Ордер       - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - ордер.
//  Блокировка  - БлокировкаДанных - заполняемая блокировка.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//
Процедура ЗаполнитьБлокировку(Ордер, Блокировка, РежимЗаписи)
	Прежние = СохраненнаяВерсия(Ордер);
	Склады = Новый Массив;
	Склады.Добавить(Ордер.МестоХранения);
	Если Прежние <> Неопределено Тогда
		Склады.Добавить(Прежние.Шапка.МестоХранения);
	КонецЕсли;
	УправляемыеБлокировки.МестаХранения(Блокировка, Склады, Ложь);
	Поле = "Номенклатура";
	Позиции = Новый ТаблицаЗначений;
	Позиции.Колонки.Добавить(Поле, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Для Каждого Строка Из Ордер.ТЧТовары Цикл
		Позиции.Добавить().Номенклатура = Строка.Номенклатура;
	КонецЦикла;
	Если Прежние <> Неопределено Тогда
		Для Каждого Строка Из Прежние.Товары Цикл
			Позиции.Добавить().Номенклатура = Строка.Номенклатура;
		КонецЦикла;
		Для Каждого Строка Из Прежние.Состав Цикл
			Позиции.Добавить().Номенклатура = Строка.Номенклатура;
		КонецЦикла;
	КонецЕсли;
	Позиции.Свернуть(Поле);
	// Ключи остатков с составляющими комплектов по текущему справочнику - для сверки снимка состава (Ф3.8).
	Ордер.ДополнительныеСвойства.Вставить("ПозицииБлокировкиОрдера",
		РегистрыНакопления.ТоварыВНаличии.НоменклатураССоставляющими(Позиции).ВыгрузитьКолонку(Поле));
	ОдинСклад = Прежние = Неопределено Или Прежние.Шапка.МестоХранения = Ордер.МестоХранения;
	Склад = ?(ОдинСклад, Ордер.МестоХранения, Неопределено);
	Если ЭтоРасходный(Ордер) Тогда
		Контекст = Производство.КонтекстАвтовыпуска(Ордер, РежимЗаписи <> РежимЗаписиДокумента.Проведение);
		Ордер.ДополнительныеСвойства.Вставить(ИмяСвойстваКонтекста(), Контекст);
		Если Контекст.Номенклатура.Количество() = 0 Тогда
			УправляемыеБлокировки.ТоварыВНаличии(Блокировка, Позиции, Склад);
		Иначе
			Производство.ЗаполнитьБлокировкуОстатковАвтовыпуска(Блокировка, Контекст, Позиции);
		КонецЕсли;
		Производство.ЗаполнитьБлокировкуПотребностейАвтовыпуска(Блокировка, Контекст);
	Иначе
		УправляемыеБлокировки.ТоварыВНаличии(Блокировка, Позиции, Склад);
		УправляемыеБлокировки.ПотребностиПроизводстваЗакупки(Блокировка, Ордер);
		УправляемыеБлокировки.ЗаказыПоставщикамДокумента(Блокировка, Ордер);
	КонецЕсли;
	Если Не Ордер.Ссылка.Пустая() Тогда
		УправляемыеБлокировки.ТоварыКОформлению(Блокировка, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ордер.Ссылка));
	КонецЕсли;
КонецПроцедуры

// Сохранённая в базе версия ордера - для сравнения правками и ключей блокировки.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - ордер.
//
// Возвращаемое значение:
//  Структура, Неопределено - Шапка (Структура реквизитов и Проведен), Товары (ТаблицаЗначений), Состав
//                            (ТаблицаЗначений); Неопределено у нового ордера.
//
Функция СохраненнаяВерсия(Ордер)
	Если Ордер.Ссылка.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	МетаданныеОрдера = Ордер.Метаданные();
	Имена = Новый Массив;
	Для Каждого Реквизит Из МетаданныеОрдера.Реквизиты Цикл
		Имена.Добавить(Реквизит.Имя);
	КонецЦикла;
	Имена.Добавить("Проведен");
	Имена.Добавить("Дата");
	Шапка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ордер.Ссылка, СтрСоединить(Имена, ", "));
	Сохраненный = Ордер.Ссылка.ПолучитьОбъект();
	Состав = ?(ЭтоРасходный(Ордер), Сохраненный.ТЧФизическийСостав.Выгрузить(), Новый ТаблицаЗначений);
	Возврат Новый Структура("Шапка, Товары, Состав", Шапка, Сохраненный.ТЧТовары.Выгрузить(), Состав);
КонецФункции

// Правила защиты (общий план, «Целостность связи»): проведённый ордер с изменениями - только «Провести» или «Отмена
// проведения»; у оформленного ордера шапка, кроме даты, ответственного и комментария, заморожена, дата - не позже самой
// ранней даты оформления; строка с оформлениями не удаляется и меняет только количество, строка-комплект с
// оформлениями заморожена целиком. Сравнение - с сохранённой версией, под блокировкой ТоварыКОформлению по ордеру.
//
// Параметры:
//  Ордер       - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - ордер.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  Отказ       - Булево - выставляется при нарушении.
//
Процедура ПроверитьЗащиту(Ордер, РежимЗаписи, Отказ)
	Прежние = СохраненнаяВерсия(Ордер);
	Если Прежние = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИзмененаШапка = ИзмененныеРеквизитыШапки(Ордер, Прежние.Шапка, "").Количество() > 0;
	ИзмененыСтроки = ИзменилисьСтроки(Ордер.ТЧТовары.Выгрузить(), Прежние.Товары);
	Если ЭтоРасходный(Ордер) Тогда
		// Снимок состава - часть проведённого ордера: его правка записью без проведения - то же изменение.
		ИзмененыСтроки = ИзмененыСтроки Или ИзменилсяСостав(Ордер.ТЧФизическийСостав.Выгрузить(), Прежние.Состав);
	КонецЕсли;
	ЗаписьСИзменениями = РежимЗаписи = РежимЗаписиДокумента.Запись И (ИзмененаШапка Или ИзмененыСтроки);
	Если Прежние.Шапка.Проведен И ЗаписьСИзменениями Тогда
		Текст = НСтр("ru = 'Проведённый ордер с изменениями можно только провести заново или отменить его проведение.';
			|fr = 'Un bon validé modifié ne peut être que revalidé ou dévalidé.';
			|en = 'A posted order with changes can only be posted again or unposted.';
			|es = 'Una orden contabilizada con cambios solo puede volver a contabilizarse o anularse.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Ордер, , , Отказ);
		Возврат;
	КонецЕсли;
	// Допрасходы на партии ордера защищают его так же, как оформление (Ф3.9): дата и строки их номенклатуры.
	Тексты = Новый Массив;
	ПроверитьДопрасходыОрдера(Ордер, Прежние.Товары, Тексты);
	Оформления = РегистрыНакопления.ТоварыКОформлению.ОформленияОрдера(Ордер.Ссылка);
	Если Оформления.Количество() = 0 Тогда
		Для Каждого Текст Из Тексты Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Ордер, , , Отказ);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	Для Каждого Имя Из ИзмененныеРеквизитыШапки(Ордер, Прежние.Шапка, "Дата, Ответственный, Комментарий, Проведен") Цикл
		Шаблон = НСтр("ru = 'Ордер оформлен документами: реквизит «%1» менять нельзя.';
			|fr = 'Le bon est régularisé : l''attribut « %1 » ne peut pas être modifié.';
			|en = 'The order is documented: the «%1» attribute cannot be changed.';
			|es = 'La orden está formalizada: el atributo «%1» no se puede cambiar.'");
		Тексты.Добавить(СтрШаблон(Шаблон, Ордер.Метаданные().Реквизиты[Имя].Синоним));
	КонецЦикла;
	МинимальныйМомент = МинимальныйМоментОформлений(Оформления);
	// Строго раньше оформляющего документа по моменту (Ф3.11).
	Если МоментДокумента(Ордер.Дата, Ордер.Ссылка).Сравнить(МинимальныйМомент) >= 0 Тогда
		Шаблон = НСтр("ru = 'Ордер должен быть раньше оформляющего документа (%1).';
			|fr = 'Le bon doit précéder le document de régularisation (%1).';
			|en = 'The order must be earlier than the documenting document (%1).';
			|es = 'La orden debe ser anterior al documento que la formaliza (%1).'");
		Тексты.Добавить(СтрШаблон(Шаблон, Формат(МинимальныйМомент.Дата, "ДЛФ=DT")));
	КонецЕсли;
	Для Каждого Оформление Из Оформления Цикл
		ПроверитьОформленнуюСтроку(Ордер, Прежние.Товары, Оформление.КлючСтрокиОрдера, Тексты);
	КонецЦикла;
	Для Каждого Текст Из Тексты Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Ордер, , , Отказ);
	КонецЦикла;
КонецПроцедуры

Функция МинимальныйМоментОформлений(Оформления)
	МинимальныйМомент = Оформления[0].МинимальныйМомент;
	Для Каждого Оформление Из Оформления Цикл
		Если Оформление.МинимальныйМомент.Сравнить(МинимальныйМомент) < 0 Тогда
			МинимальныйМомент = Оформление.МинимальныйМомент;
		КонецЕсли;
	КонецЦикла;
	Возврат МинимальныйМомент;
КонецФункции

// Строка с оформлениями: не удалена, меняется только количество; у строки-комплекта и количество неизменно.
//
// Параметры:
//  Ордер   - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - ордер.
//  Прежние - ТаблицаЗначений - сохранённые строки товаров.
//  Ключ    - Число - КодСтроки оформленной строки.
//  Тексты  - Массив из Строка - тексты отказа; дополняется.
//
Процедура ПроверитьОформленнуюСтроку(Ордер, Прежние, Ключ, Тексты)
	Прежняя = Прежние.Найти(Ключ, "КодСтроки");
	Если Прежняя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Новая = Ордер.ТЧТовары.Найти(Ключ, "КодСтроки");
	Если Новая = Неопределено Тогда
		Шаблон = НСтр("ru = 'Строка %1 (%2) оформлена документом - удалить её нельзя.';
			|fr = 'La ligne %1 (%2) est régularisée - elle ne peut pas être supprimée.';
			|en = 'Line %1 (%2) is documented and cannot be deleted.';
			|es = 'La línea %1 (%2) está formalizada y no se puede eliminar.'");
		Тексты.Добавить(СтрШаблон(Шаблон, Прежняя.НомерСтроки, Прежняя.Номенклатура));
		Возврат;
	КонецЕсли;
	ЭтоКомплект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Прежняя.Номенклатура, "ТипНоменклатуры")
		= Перечисления.ТипыНоменклатуры.Комплект;
	Неизменные = "Номенклатура, Характеристика, Упаковка, Серия, КодСтрокиЗаказа" + ?(ЭтоКомплект,
		", КоличествоУпаковок, Количество", "");
	Для Каждого Имя Из СтрРазделить(Неизменные, ", ", Ложь) Цикл
		Если Новая[Имя] <> Прежняя[Имя] Тогда
			Шаблон = НСтр("ru = 'Строка %1 (%2) оформлена документом: менять можно только количество%3.';
				|fr = 'La ligne %1 (%2) est régularisée : seule la quantité peut changer%3.';
				|en = 'Line %1 (%2) is documented: only the quantity can change%3.';
				|es = 'La línea %1 (%2) está formalizada: solo puede cambiar la cantidad%3.'");
			Уточнение = ?(ЭтоКомплект, НСтр("ru = ', а у комплекта - ничего'; fr = ', et rien pour un kit';
				|en = ', and nothing for a kit'; es = ', y nada en un kit'"), "");
			Тексты.Добавить(СтрШаблон(Шаблон, Новая.НомерСтроки, Прежняя.Номенклатура, Уточнение));
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Реквизиты шапки, отличающиеся от сохранённой версии.
//
// Параметры:
//  Ордер      - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - ордер.
//  Шапка      - Структура - сохранённые реквизиты.
//  Исключения - Строка - имена через запятую, которые не сравниваются.
//
// Возвращаемое значение:
//  Массив из Строка - имена изменённых реквизитов.
//
Функция ИзмененныеРеквизитыШапки(Ордер, Шапка, Исключения)
	Пропуск = СтрРазделить(Исключения, ", ", Ложь);
	Результат = Новый Массив;
	Для Каждого Реквизит Из Ордер.Метаданные().Реквизиты Цикл
		Если Пропуск.Найти(Реквизит.Имя) = Неопределено И Ордер[Реквизит.Имя] <> Шапка[Реквизит.Имя] Тогда
			Результат.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Пропуск.Найти("Дата") = Неопределено И Ордер.Дата <> Шапка.Дата Тогда
		Результат.Добавить("Дата");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Изменились ли строки товаров против сохранённой версии (состав, порядок не важен - по ключу строки).
//
// Параметры:
//  Новые   - ТаблицаЗначений - строки объекта.
//  Прежние - ТаблицаЗначений - сохранённые строки.
//
// Возвращаемое значение:
//  Булево - Истина, если есть отличия.
//
Функция ИзменилисьСтроки(Новые, Прежние)
	Если Новые.Количество() <> Прежние.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	Колонки = "Номенклатура, Характеристика, Упаковка, Серия, КоличествоУпаковок, Количество, КодСтрокиЗаказа";
	Для Каждого Новая Из Новые Цикл
		Прежняя = Прежние.Найти(Новая.КодСтроки, "КодСтроки");
		Если Прежняя = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		Для Каждого Имя Из СтрРазделить(Колонки, ", ", Ложь) Цикл
			Если Новая[Имя] <> Прежняя[Имя] Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ИзменилсяСостав(СоставОбъекта, СоставСохраненный)
	Если СоставОбъекта.Количество() <> СоставСохраненный.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	Колонки = "КодСтроки, Номенклатура, КоличествоНаЕдиницу";
	Порядок = "КодСтроки, Номенклатура, КоличествоНаЕдиницу";
	Новые = СоставОбъекта.Скопировать(, Колонки);
	Прежние = СоставСохраненный.Скопировать(, Колонки);
	Новые.Сортировать(Порядок);
	Прежние.Сортировать(Порядок);
	Для Индекс = 0 По Новые.Количество() - 1 Цикл
		Для Каждого Имя Из СтрРазделить(Колонки, ", ", Ложь) Цикл
			Если Новые[Индекс][Имя] <> Прежние[Индекс][Имя] Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Снимок состава расходного ордера (общий план, ТЧ «Физический состав»): строки без оформлений и новые строки
// пересчитываются по текущему составу комплекта, строки с оформлениями сохраняют снимок сохранённой версии, строки
// удалённых - уходят.
//
// Параметры:
//  Ордер - ДокументОбъект.РасходныйОрдер - проводимый ордер.
//
Процедура ОбновитьФизическийСостав(Ордер)
	Оформленные = РегистрыНакопления.ТоварыКОформлению.ОформленияОрдера(Ордер.Ссылка).ВыгрузитьКолонку("КлючСтрокиОрдера");
	// Снимок оформленных строк - из сохранённой версии, а не из переданного объекта: программная правка снимка
	// оформленного ордера не принимается (ревью БД фазы 2).
	Прежние = СохраненнаяВерсия(Ордер);
	Ордер.ТЧФизическийСостав.Очистить();
	Если Прежние <> Неопределено Тогда
		Для Каждого Строка Из Прежние.Состав Цикл
			Если Оформленные.Найти(Строка.КодСтроки) <> Неопределено
				И Ордер.ТЧТовары.Найти(Строка.КодСтроки, "КодСтроки") <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Ордер.ТЧФизическийСостав.Добавить(), Строка, "КодСтроки, Номенклатура, КоличествоНаЕдиницу");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Состав = РегистрыНакопления.ТоварыВНаличии.СоставКомплектов(Ордер.ТЧТовары.ВыгрузитьКолонку("Номенклатура"));
	Для Каждого Строка Из Ордер.ТЧТовары Цикл
		Если Оформленные.Найти(Строка.КодСтроки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Составляющая Из Состав.НайтиСтроки(Новый Структура("Комплект", Строка.Номенклатура)) Цикл
			НоваяСтрока = Ордер.ТЧФизическийСостав.Добавить();
			НоваяСтрока.КодСтроки = Строка.КодСтроки;
			НоваяСтрока.Номенклатура = Составляющая.Номенклатура;
			НоваяСтрока.КоличествоНаЕдиницу = Составляющая.Количество;
		КонецЦикла;
	КонецЦикла;
	// Одна составляющая - одна строка ключа: повтор в составе комплекта размножил бы остаток составляющей при
	// соединении снимка с остатками к оформлению (ревью БД фазы 2).
	Свернутый = Ордер.ТЧФизическийСостав.Выгрузить();
	Свернутый.Свернуть("КодСтроки, Номенклатура", "КоличествоНаЕдиницу");
	Ордер.ТЧФизическийСостав.Загрузить(Свернутый);
КонецПроцедуры

// Партии ордера (Ф3.3, Ф3.5): приходный - приход партии-ордера по строкам со стоимостью пар, расходный - списание
// физических строк по ФИФО с кодами строк. Наборы физики не пишутся - их пишет зеркало ТоварыВНаличии.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - проводимый ордер.
//  Отказ - Булево - выставляется при нехватке партий расходного ордера.
//
Процедура СформироватьСтоимостныеДвижения(Ордер, Отказ)
	Ордер.Движения.ТоварыНаСкладах.Записывать = Ложь;
	Ордер.Движения.ТоварыВНаличии.Записывать = Истина;
	Ордер.Движения.ТоварыВНаличии.Очистить();
	Ордер.Движения.ДополнительныеРасходы.Записывать = Истина;
	Ордер.Движения.ДополнительныеРасходы.Очистить();
	Если ЭтоРасходный(Ордер) Тогда
		Строки = РегистрыНакопления.ТоварыКОформлению.ФизическиеСтрокиОрдера(Ордер);
		Нулевые = Строки.НайтиСтроки(Новый Структура("Количество", 0));
		Для Каждого Строка Из Нулевые Цикл
			Строки.Удалить(Строка);
		КонецЦикла;
		Строки.Колонки.Добавить("МестоХранения", Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
		Строки.ЗаполнитьЗначения(Ордер.МестоХранения, "МестоХранения");
		// Нехватка партий - отказ (Р1): существующий контроль партий списания, раньше его давала реализация.
		Если Не РегистрыНакопления.ТоварыВНаличии.СписатьНоменклатуру(Строки, Ордер, Ложь, Истина) Тогда
			Отказ = Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Строки = Ордер.ТЧТовары.Выгрузить(, "КодСтроки, Номенклатура, Характеристика, Серия, Количество");
	Записи = СтоимостныеЗаписиПриходногоОрдера(Ордер.Ссылка, Ордер.Дата, Ордер.МестоХранения, Строки);
	Ордер.Движения.ТоварыВНаличии.Загрузить(Записи.Товары);
	Ордер.Движения.ДополнительныеРасходы.Загрузить(Записи.Допрасходы);
КонецПроцедуры

// Записи партий приходного ордера (Ф3.3): по строке - приход партии-ордера, сумма и НДС - стоимость строк поступлений
// её пар, допрасходы - распределение допрасходов этих поступлений на их строки; неоформленная часть - 0. Одна функция
// для проведения ордера и ближнего пересчёта.
//
// Параметры:
//  Ордер  - ДокументСсылка.ПриходныйОрдер - ордер.
//  Дата   - Дата - дата ордера.
//  Склад  - СправочникСсылка.МестаХранения - склад ордера.
//  Строки - ТаблицаЗначений - КодСтроки, Номенклатура, Характеристика, Серия, Количество.
//
// Возвращаемое значение:
//  Структура - Товары, Допрасходы (ТаблицаЗначений - выгрузки наборов ТоварыВНаличии и ДополнительныеРасходы).
//
Функция СтоимостныеЗаписиПриходногоОрдера(Ордер, Дата, Склад, Строки) Экспорт
	Товары = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей().Выгрузить();
	Допрасходы = РегистрыНакопления.ДополнительныеРасходы.СоздатьНаборЗаписей().Выгрузить();
	Пары = ?(Ордер.Пустая(), Новый Массив, ПарыОрдера(Ордер));
	Стоимость = СтоимостьСтрокПоступлений(ПоступленияПар(Пары));
	Для Каждого Строка Из Строки Цикл
		Если Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Итог = СтоимостьСтрокиОрдера(Строка.КодСтроки, Пары, Стоимость);
		Запись = Товары.Добавить();
		ЗаполнитьКлючПартии(Запись, Ордер, Дата, Склад, Строка);
		Запись.ВидДвижения = ВидДвиженияНакопления.Приход;
		Запись.ДатаПартии = Дата;
		Запись.Количество = Строка.Количество;
		Запись.Сумма = Итог.Сумма;
		Запись.СуммаНДС = Итог.СуммаНДС;
		Для Каждого Элемент Из Итог.Допрасходы Цикл
			Если Элемент.Значение.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;
			Запись = Допрасходы.Добавить();
			ЗаполнитьКлючПартии(Запись, Ордер, Дата, Склад, Строка);
			Запись.ВидДвижения = ВидДвиженияНакопления.Приход;
			Запись.СтатьяДДС = Элемент.Ключ;
			Запись.Сумма = Элемент.Значение.Сумма;
			Запись.СуммаНДС = Элемент.Значение.СуммаНДС;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Товары, Допрасходы", Товары, Допрасходы);
КонецФункции

// Стоимость строки приходного ордера: сумма стоимости строк поступлений её пар и их допрасходы по статьям.
//
// Параметры:
//  КодСтроки - Число - код строки ордера
//  Пары      - Массив - пары ордера
//  Стоимость - Структура - см. СтоимостьСтрокПоступлений
//
// Возвращаемое значение:
//  Структура - Сумма, СуммаНДС, Допрасходы (Соответствие: статья -> Структура Сумма, СуммаНДС)
//
Функция СтоимостьСтрокиОрдера(КодСтроки, Пары, Стоимость)
	Итог = Новый Структура("Сумма, СуммаНДС, Допрасходы", 0, 0, Новый Соответствие);
	Для Каждого Пара Из Пары Цикл
		Если Пара.КлючСтрокиИсточника <> КодСтроки Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючСтроки(Пара.Регистратор, Пара.КодСтрокиРегистратора);
		СтоимостьСтроки = Стоимость.Строки.Найти(Ключ, ИмяКлюча());
		Если СтоимостьСтроки <> Неопределено Тогда
			Итог.Сумма = Итог.Сумма + СтоимостьСтроки.Сумма;
			Итог.СуммаНДС = Итог.СуммаНДС + СтоимостьСтроки.СуммаНДС;
		КонецЕсли;
		Для Каждого Допрасход Из Стоимость.Допрасходы.НайтиСтроки(Новый Структура(ИмяКлюча(), Ключ)) Цикл
			Накоплено = Итог.Допрасходы[Допрасход.СтатьяДДС];
			Если Накоплено = Неопределено Тогда
				Накоплено = Новый Структура("Сумма, СуммаНДС", 0, 0);
				Итог.Допрасходы.Вставить(Допрасход.СтатьяДДС, Накоплено);
			КонецЕсли;
			Накоплено.Сумма = Накоплено.Сумма + Допрасход.Сумма;
			Накоплено.СуммаНДС = Накоплено.СуммаНДС + Допрасход.СуммаНДС;
		КонецЦикла;
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция ИмяКлюча()
	Возврат "Ключ";
КонецФункции

Процедура ЗаполнитьКлючПартии(Запись, Ордер, Дата, Склад, Строка)
	Запись.Период = Дата;
	Запись.Активность = Истина;
	Запись.Регистратор = Ордер;
	Запись.МестоХранения = Склад;
	Запись.Номенклатура = Строка.Номенклатура;
	Запись.Характеристика = Строка.Характеристика;
	Запись.Серия = Строка.Серия;
	Запись.Партия = Ордер;
	Запись.КодСтроки = Строка.КодСтроки;
КонецПроцедуры

// Пары приходного ордера с поступлениями.
//
// Параметры:
//  Ордер - ДокументСсылка.ПриходныйОрдер
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений - см. ТоварыКОформлению.ПарыОформления
//
Функция ПарыОрдера(Ордер)
	Пары = Новый Массив;
	Для Каждого Пара Из РегистрыНакопления.ТоварыКОформлению.ПарыОформления(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ордер)) Цикл
		Если Пара.Источник = Ордер И ТипЗнч(Пара.Регистратор) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			Пары.Добавить(Пара);
		КонецЕсли;
	КонецЦикла;
	Возврат Пары;
КонецФункции

Функция ПарыПоступлений(Поступления)
	Пары = РегистрыНакопления.ТоварыКОформлению.ПарыОформления(Поступления);
	Чужие = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Если Поступления.Найти(Пара.Регистратор) = Неопределено
			Или ТипЗнч(Пара.Источник) <> Тип("ДокументСсылка.ПриходныйОрдер") Тогда
			Чужие.Добавить(Пара);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Пара Из Чужие Цикл
		Пары.Удалить(Пара);
	КонецЦикла;
	Возврат Пары;
КонецФункции

Функция ПоступленияПар(Пары)
	Поступления = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Если Поступления.Найти(Пара.Регистратор) = Неопределено Тогда
			Поступления.Добавить(Пара.Регистратор);
		КонецЕсли;
	КонецЦикла;
	Возврат Поступления;
КонецФункции

// Стоимость строк поступлений - та же таблица и тот же пересчёт в основную валюту, по которым поступление
// неордерного склада пишет свою партию (сумма с НДС, НДС), и допрасходы поступлений, распределённые по их строкам.
//
// Параметры:
//  Поступления - Массив из ДокументСсылка.ПоступлениеТоваровУслуг
//
// Возвращаемое значение:
//  Структура - Строки (ТаблицаЗначений: Ключ, Сумма, СуммаНДС), Допрасходы (ТаблицаЗначений: Ключ, СтатьяДДС, Сумма,
//              СуммаНДС); Ключ - см. КлючСтроки (поступление и код строки).
//
Функция СтоимостьСтрокПоступлений(Поступления) Экспорт
	ТипСуммы = Метаданные.ОпределяемыеТипы.Сумма.Тип;
	Строки = Новый ТаблицаЗначений;
	ТипКлюча = Новый ОписаниеТипов("Строка");
	Строки.Колонки.Добавить(ИмяКлюча(), ТипКлюча);
	Допрасходы = Новый ТаблицаЗначений;
	Допрасходы.Колонки.Добавить(ИмяКлюча(), ТипКлюча);
	Допрасходы.Колонки.Добавить("СтатьяДДС");
	Для Каждого Имя Из СтрРазделить("Сумма,СуммаНДС", ",") Цикл
		Строки.Колонки.Добавить(Имя, ТипСуммы);
		Допрасходы.Колонки.Добавить(Имя, ТипСуммы);
	КонецЦикла;
	Для Каждого Поступление Из Поступления Цикл
		Товары = СерииИРазмещение.ОбъединитьТоварыССериями(Поступление);
		Если Товары.Колонки.Найти("СуммаСНДС") <> Неопределено Тогда
			Товары.Колонки.Удалить("Сумма");
			Товары.Колонки.СуммаСНДС.Имя = "Сумма";
		КонецЕсли;
		Для Каждого Товар Из Товары Цикл
			Строка = Строки.Добавить();
			Строка.Ключ = КлючСтроки(Поступление, Товар.КодСтроки);
			Строка.Сумма = Товар.Сумма;
			Строка.СуммаНДС = Товар.СуммаНДС;
		КонецЦикла;
		ДопрасходыПоступления = РегистрыНакопления.ДополнительныеРасходы.ДопрасходыДокументаВОсновнойВалюте(Поступление);
		Если ДопрасходыПоступления.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Распределение = РегистрыНакопления.ДополнительныеРасходы.РаспределениеПоСтрокам(Товары, ДопрасходыПоступления);
		Для Каждого Часть Из Распределение.Части Цикл
			Строка = Допрасходы.Добавить();
			Строка.Ключ = КлючСтроки(Поступление, Часть.КодСтроки);
			ЗаполнитьЗначенияСвойств(Строка, Часть, "СтатьяДДС, Сумма, СуммаНДС");
		КонецЦикла;
	КонецЦикла;
	Ресурсы = "Сумма, СуммаНДС";
	Строки.Свернуть(ИмяКлюча(), Ресурсы);
	Допрасходы.Свернуть(ИмяКлюча() + ", СтатьяДДС", Ресурсы);
	Строки.Индексы.Добавить(ИмяКлюча());
	Допрасходы.Индексы.Добавить(ИмяКлюча());
	Возврат Новый Структура("Строки, Допрасходы", Строки, Допрасходы);
КонецФункции

Функция КлючСтроки(Документ, КодСтроки)
	Возврат XMLСтрока(Документ) + "|" + Формат(КодСтроки, "ЧГ=0");
КонецФункции

Функция СтрокиПриходныхОрдеров(Ордера)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Строки.Ссылка КАК Ордер,
	|	Строки.КодСтроки КАК КодСтроки,
	|	Ордера.МестоХранения КАК МестоХранения,
	|	Строки.Номенклатура КАК Номенклатура,
	|	Строки.Характеристика КАК Характеристика,
	|	Строки.Серия КАК Серия
	|ИЗ
	|	Документ.ПриходныйОрдер.ТЧТовары КАК Строки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходныйОрдер КАК Ордера
	|		ПО Строки.Ссылка = Ордера.Ссылка
	|ГДЕ
	|	Строки.Ссылка В (&Ордера)");
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Строки = Запрос.Выполнить().Выгрузить();
	Строки.Колонки.Добавить(ИмяКлюча(), Новый ОписаниеТипов("Строка"));
	Для Каждого Строка Из Строки Цикл
		Строка.Ключ = КлючСтроки(Строка.Ордер, Строка.КодСтроки);
	КонецЦикла;
	Строки.Индексы.Добавить(ИмяКлюча());
	Возврат Строки;
КонецФункции

// Пишет набор ордера, если рассчитанные записи отличаются от записанных (Редакция 5: без изменений - не пишет).
//
// Параметры:
//  МенеджерРегистра - РегистрНакопленияМенеджер - ТоварыВНаличии или ДополнительныеРасходы.
//  Ордер            - ДокументСсылка.ПриходныйОрдер - регистратор.
//  Записи           - ТаблицаЗначений - рассчитанные записи.
//
// Возвращаемое значение:
//  Число - 1, если набор записан; 0 - не изменился.
//
Функция ЗаписатьНаборОрдераЕслиИзменился(МенеджерРегистра, Ордер, Записи)
	Набор = МенеджерРегистра.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Ордер);
	Набор.Прочитать();
	Если РегистрыНакопления.СебестоимостьПродаж.НаборыРавны(Набор.Выгрузить(), Записи) Тогда
		Возврат 0;
	КонецЕсли;
	Набор.Загрузить(Записи);
	Набор.Записать(Истина);
	Возврат 1;
КонецФункции

// Строки расходного ордера - затронутые ближним пересчётом себестоимости реализаций: текущие и прежние (по записям
// пар, если строку удалили).
//
// Параметры:
//  Ордер - ДокументОбъект.РасходныйОрдер
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ордер, КодСтроки
//
Функция СтрокиРасходногоОрдера(Ордер)
	Строки = НоваяТаблицаСтрокОрдеров();
	Для Каждого Строка Из Ордер.ТЧТовары Цикл
		Новая = Строки.Добавить();
		Новая.Ордер = Ордер.Ссылка;
		Новая.КодСтроки = Строка.КодСтроки;
	КонецЦикла;
	Для Каждого Пара Из РегистрыНакопления.ТоварыКОформлению.ПарыОформления(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ордер.Ссылка)) Цикл
		Новая = Строки.Добавить();
		Новая.Ордер = Ордер.Ссылка;
		Новая.КодСтроки = Пара.КлючСтрокиИсточника;
	КонецЦикла;
	Строки.Свернуть("Ордер, КодСтроки");
	Возврат Строки;
КонецФункции

// Проведённые документы допрасходов на партии приходного ордера - прямо или через поступления его пар (Ф3.9).
//
// Параметры:
//  Ордер - ДокументСсылка.ПриходныйОрдер
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ссылка, Дата, Прямой (Булево), Номенклатура, Характеристика; упорядочена по моменту документа
//
Функция ДопрасходыОрдера(Ордер)
	Поступления = ПоступленияПар(ПарыОрдера(Ордер));
	Партии = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ордер);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Партии, Поступления);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.Дата КАК Дата,
	|	Строки.ДокументПартии = &Ордер КАК Прямой,
	|	Строки.Номенклатура КАК Номенклатура,
	|	Строки.Характеристика КАК Характеристика
	|ИЗ
	|	Документ.ПоступлениеДополнительныхРасходов.ТЧТовары КАК Строки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеДополнительныхРасходов КАК Документы
	|		ПО Строки.Ссылка = Документы.Ссылка
	|ГДЕ
	|	Документы.Проведен
	|	И Строки.ДокументПартии В (&Партии)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документы.МоментВремени");
	Запрос.УстановитьПараметр("Ордер", Ордер);
	Запрос.УстановитьПараметр("Партии", Партии);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Защита ордера с допрасходами (Ф3.9): ордер раньше самого раннего документа допрасходов; строки номенклатуры прямых
// допрасходов не удаляются, не меняют номенклатуру, характеристику, серию и не обнуляются.
//
// Параметры:
//  Ордер   - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - записываемый ордер.
//  Прежние - ТаблицаЗначений - сохранённые строки.
//  Тексты  - Массив из Строка - тексты отказа; дополняется.
//
Процедура ПроверитьДопрасходыОрдера(Ордер, Прежние, Тексты)
	Если ЭтоРасходный(Ордер) Тогда
		Возврат;
	КонецЕсли;
	Допрасходы = ДопрасходыОрдера(Ордер.Ссылка);
	Если Допрасходы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Ранний = Допрасходы[0];
	Если МоментДокумента(Ордер.Дата, Ордер.Ссылка).Сравнить(МоментДокумента(Ранний.Дата, Ранний.Ссылка)) >= 0 Тогда
		Шаблон = НСтр("ru = 'На партии ордера есть допрасходы (%1): ордер должен быть раньше этого документа.';
			|fr = 'Des frais portent sur les lots du bon (%1) : le bon doit précéder ce document.';
			|en = 'The order batches have additional costs (%1): the order must be earlier than that document.';
			|es = 'Los lotes de la orden tienen gastos (%1): la orden debe ser anterior a ese documento.'");
		Тексты.Добавить(СтрШаблон(Шаблон, Ранний.Ссылка));
	КонецЕсли;
	Шаблон = НСтр("ru = 'Строка %1 (%2): на неё распределены допрасходы - удалить её, сменить товар или обнулить нельзя.';
		|fr = 'Ligne %1 (%2) : des frais y sont répartis - impossible de la supprimer, de changer l''article ou de la mettre à zéro.';
		|en = 'Line %1 (%2): additional costs are allocated to it - it cannot be deleted, zeroed or change the item.';
		|es = 'Línea %1 (%2): tiene gastos repartidos - no se puede eliminar, anular ni cambiar el artículo.'");
	Для Каждого Прежняя Из Прежние Цикл
		Если СтрокаПодДопрасходом(Прежняя, Допрасходы) И СтрокаПотеряла(Прежняя, Ордер.ТЧТовары.Найти(Прежняя.КодСтроки, "КодСтроки")) Тогда
			Тексты.Добавить(СтрШаблон(Шаблон, Прежняя.НомерСтроки, Прежняя.Номенклатура));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СтрокаПодДопрасходом(Строка, Допрасходы)
	Для Каждого Допрасход Из Допрасходы Цикл
		Подходит = Не ЗначениеЗаполнено(Допрасход.Номенклатура)
			Или Допрасход.Номенклатура = Строка.Номенклатура И Допрасход.Характеристика = Строка.Характеристика;
		Если Допрасход.Прямой И Подходит Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СтрокаПотеряла(Прежняя, Новая)
	Если Новая = Неопределено Или Новая.Количество = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Новая.Номенклатура <> Прежняя.Номенклатура Или Новая.Характеристика <> Прежняя.Характеристика
		Или Новая.Серия <> Прежняя.Серия;
КонецФункции

// Отмена проведения и удаление приходного ордера с проведёнными прямыми допрасходами - отказ: их партии не стало бы.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер
//  Отказ - Булево - выставляется
//
Процедура ПроверитьОтменуСДопрасходами(Ордер, Отказ)
	Допрасходы = ДопрасходыОрдера(Ордер.Ссылка).НайтиСтроки(Новый Структура("Прямой", Истина));
	Если Допрасходы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'На партии ордера распределены допрасходы (%1): сначала отмените проведение этого документа.';
		|fr = 'Des frais sont répartis sur les lots du bon (%1) : dévalidez d''abord ce document.';
		|en = 'Additional costs are allocated to the order batches (%1): unpost that document first.';
		|es = 'Hay gastos repartidos en los lotes de la orden (%1): anule primero ese documento.'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Допрасходы[0].Ссылка), Ордер, , , Отказ);
КонецПроцедуры

// Заказы поставщику и потребности производства приходного ордера.
//
// Параметры:
//  Ордер             - ДокументОбъект.ПриходныйОрдер - ордер.
//  ПересчетСтоимости - Булево - режим пересчета стоимости: «Пришло» не проверяется.
//  Отказ             - Булево - выставляется.
//
Процедура СформироватьДвиженияЗакупки(Ордер, ПересчетСтоимости, Отказ)
	// Приход под заказ на производство другой организации - отказ, как у поступления (ревью техдолга T10).
	ТекстЗапрета = РегистрыНакопления.ПотребностиПроизводства.ТекстЗапретаОрганизацииЗакупки(Ордер);
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, Ордер, "Организация", , Отказ);
		Возврат;
	КонецЕсли;
	// Менеджеры регистров закупки добавляют записи к набору: повторное проведение того же объекта их не удваивает.
	Ордер.Движения.ЗаказыПоставщикам.Очистить();
	Ордер.Движения.ПотребностиПроизводства.Очистить();
	РегистрыНакопления.ЗаказыПоставщикам.СформироватьДвижения(Ордер);
	Ордер.Движения.ЗаказыПоставщикам.Записывать = Истина;
	РегистрыНакопления.ПотребностиПроизводства.СформироватьДвижения(Ордер);
	Если Не ПересчетСтоимости Тогда
		РегистрыНакопления.ПотребностиПроизводства.ПроверитьПришло(Ордер, Ордер.Движения.ПотребностиПроизводства, Отказ);
	КонецЕсли;
КонецПроцедуры

// После записи движений ордера: контроль остатков к оформлению и стадии заказов (не в режиме пересчета стоимости),
// у расходного - ближний пересчет себестоимости реализаций его пар (Ф3.7).
//
// Параметры:
//  Ордер             - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - ордер.
//  ПересчетСтоимости - Булево - режим пересчета стоимости.
//  Отказ             - Булево - выставляется.
//
Процедура ЗавершитьПроведениеОрдера(Ордер, ПересчетСтоимости, Отказ)
	Если Не ПересчетСтоимости Тогда
		РегистрыНакопления.ТоварыКОформлению.ПроверитьОстатки(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ордер.Ссылка),
			Ордер, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		ПроизводственныеЗаказы.ОбновитьСтадииПослеПроведения(Ордер);
	КонецЕсли;
	Если ЭтоРасходный(Ордер) Тогда
		РегистрыНакопления.СебестоимостьПродаж.ПересчитатьПоПарам(СтрокиРасходногоОрдера(Ордер), Ордер);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
