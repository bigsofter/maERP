
#Область ПрограммныйИнтерфейс

// Открывает форму выбора партии по остаткам регистра ТоварыВНаличии.
//
// Параметры:
//  ДатаОстатков - Дата, Граница, Неопределено - момент, на который считаются остатки.
//  ДанныеОтбора - Структура - свойства МестоХранения, Номенклатура, Характеристика.
//  Оповещение - ОписаниеОповещения, Неопределено - обработчик закрытия формы; если не задан,
//               выбранная партия записывается в ДанныеСтроки.Партия.
//  ДанныеСтроки - ДанныеФормыЭлементКоллекции, Структура, Неопределено - строка, в которую
//                 записывается выбранная партия при стандартном оповещении.
//
Процедура ВыбратьПартиюПоОстаткам(ДатаОстатков, ДанныеОтбора, Оповещение = Неопределено, ДанныеСтроки = Неопределено) Экспорт
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДатаОстатков", ДатаОстатков);
	ПараметрыФормы.Вставить("МестоХранения", ДанныеОтбора.МестоХранения);
	ПараметрыФормы.Вставить("Номенклатура", ДанныеОтбора.Номенклатура);
	ПараметрыФормы.Вставить("Характеристика", ДанныеОтбора.Характеристика);
	Если Оповещение = Неопределено Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораПартии", ПартииИРазмещениеКлиент, ДанныеСтроки);
	КонецЕсли;
	ОткрытьФорму("РегистрНакопления.ТоварыВНаличии.Форма.ВыборПартииПоОстаткам", ПараметрыФормы, , , , ,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает выбранную партию в строку после закрытия формы выбора.
//
// Параметры:
//  РезультатЗакрытия - Структура, Неопределено - свойства Партия и Количество.
//  ДанныеСтроки - ДанныеФормыЭлементКоллекции, Структура - строка со свойством Партия.
//
Процедура ПослеЗакрытияФормыВыбораПартии(РезультатЗакрытия, ДанныеСтроки) Экспорт
	Если РезультатЗакрытия = Неопределено Или ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДанныеСтроки.Партия = РезультатЗакрытия.Партия;
КонецПроцедуры

#КонецОбласти
