#Область Оповещения

Процедура ПослеВыбораВидаРеквизитаКонтрагента(ВыбранныйЭлемент, Форма) Экспорт
	Если ВыбранныйЭлемент = Неопределено Тогда Возврат КонецЕсли;
	ДанныеРеквизита = ВыбранныйЭлемент.Значение;
	Родитель = Неопределено;
	Для Каждого СтрРодитель Из Форма.ДЗРеквизиты.ПолучитьЭлементы() Цикл
		Если СтрРодитель.Реквизит <> ДанныеРеквизита.Родитель Тогда Продолжить КонецЕсли;
		Родитель = СтрРодитель;
		Прервать;
	КонецЦикла;
	Если Родитель = Неопределено Тогда
		Родитель = Форма.ДЗРеквизиты.ПолучитьЭлементы().Добавить();
		Родитель.Реквизит = ДанныеРеквизита.Родитель;
		Родитель.ИндексКартинки = -1;
	КонецЕсли;
	НС = Родитель.ПолучитьЭлементы().Добавить();
	НС.Реквизит = ДанныеРеквизита.Реквизит;
	НС.ИндексКартинки = ДанныеРеквизита.ИндексКартинки;
	НС.Уровень = 1;
	Форма.Элементы.ДЗРеквизиты.ТекущаяСтрока = НС.ПолучитьИдентификатор();
	Если ЭтоРеквизитАдреса(ДанныеРеквизита.Реквизит) Или ЭтоТелефон(ДанныеРеквизита.Реквизит) Тогда
		НачалоВыбора(Форма.Элементы.ДЗРеквизиты, ДанныеРеквизита.Реквизит, НС.Значение, НС.Представление, Ложь);
	ИначеЕсли ЭтоКонтактноеЛицо(ДанныеРеквизита.Реквизит) Тогда
		Оп = Новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораФизическогоЛица", ЭтотОбъект, Новый Структура("НС, Форма", НС, Форма));
		П = Новый Структура("РежимВыбора", Истина); 
		ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора", П, Форма,,,, Оп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);			
	Иначе
		ОбщегоНазначенияКлиент.РазвернутьДеревоЗначений(Форма.ДЗРеквизиты, Форма.Элементы.ДЗРеквизиты);
	КонецЕсли;	
КонецПроцедуры

Процедура ПослеЗакрытияФормыВводаРеквизитов(РезультатЗакрытия, Форма) Экспорт
	Если РезультатЗакрытия = Неопределено Тогда Возврат КонецЕсли;
	ТекСтр = Форма.Элементы.ДЗРеквизиты.ТекущиеДанные;
	ТекСтр.Комментарий = РезультатЗакрытия.Комментарий;
	ТекСтр.НазначениеРассылки = РезультатЗакрытия.НазначениеРассылки;
КонецПроцедуры	

Процедура ПослеЗакрытияФормыВыбораФизическогоЛица(РезультатЗакрытия, ДополнительныеРеквизиты) Экспорт
	Если РезультатЗакрытия = Неопределено Тогда Возврат КонецЕсли;
	ДополнительныеРеквизиты.НС.Представление = РезультатЗакрытия;
	ОбщегоНазначенияКлиент.РазвернутьДеревоЗначений(ДополнительныеРеквизиты.Форма.ДЗРеквизиты, ДополнительныеРеквизиты.Форма.Элементы.ДЗРеквизиты);
КонецПроцедуры	

#КонецОбласти

#Область Дополнительно

Функция ЭтоРеквизитАдреса(ВидРеквизита)
	Мас = Новый Массив;
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.АдресДоставки"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.АдресПоПрописке"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.АдресПроживания"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.АдресФактический"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.АдресЮридический"));
	Возврат Мас.Найти(ВидРеквизита) <> Неопределено;
КонецФункции

Функция ЭтоКонтактноеЛицо(ВидРеквизита)
	Мас = Новый Массив;
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.ГлавныйБухгалтер"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Руководитель"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Собственник"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Сотрудник"));
	Возврат Мас.Найти(ВидРеквизита) <> Неопределено;
КонецФункции

Функция ДляРеквизитаДоступенКомментарий(ВидРеквизита)
	Мас = Новый Массив;
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.ГлавныйБухгалтер"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Руководитель"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Собственник"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Сотрудник"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.EMail"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Web"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Другое"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Телефон"));
	Мас.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.ТелефонФикс"));
	Возврат Мас.Найти(ВидРеквизита) <> Неопределено;
КонецФункции

Функция ЭтоТелефон(ВидРеквизита)
	Возврат ВидРеквизита = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Телефон")
		Или ВидРеквизита = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.ТелефонФикс");
КонецФункции

Процедура УстановитьВидимостьЭлемента(Элемент, Видимость)
	Если Элемент <> Неопределено Тогда
		Элемент.Видимость = Видимость;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти




