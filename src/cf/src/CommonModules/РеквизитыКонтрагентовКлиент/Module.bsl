
#Область Интерфейс

Процедура СформироватьМенюВыбораВидаРеквизита(Форма) Экспорт
	Оп = Новый ОписаниеОповещения("ПослеВыбораВидаРеквизитаКонтрагента", ЭтотОбъект, Форма);
	МасВыбранныеРеквизиты = Новый Массив;
	Для Каждого СтрГруппа Из Форма.ДЗРеквизиты.ПолучитьЭлементы() Цикл
		Для Каждого Стр Из СтрГруппа.ПолучитьЭлементы() Цикл
			МасВыбранныеРеквизиты.Добавить(Стр.Реквизит);	
		КонецЦикла;	
	КонецЦикла;
	ВидКонтрагента = ?(Форма.Объект.Свойство("ВидКонтрагента"), Форма.Объект.ВидКонтрагента, ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ЧастноеЛицо"));
	СЗВыбор = РеквизитыКонтрагентовВызовСервера.ПолучитьДоступныеВидыРеквизитов(Форма.Объект.Ссылка, ВидКонтрагента, МасВыбранныеРеквизиты); 
	Форма.ПоказатьВыборИзМеню(Оп, СЗВыбор, Форма.Элементы.ДобавитьРеквизит);	
КонецПроцедуры

Процедура ОткрытьФормуВводаДополнительныхДанных(Форма) Экспорт
	ТекСтр = Форма.Элементы.ДЗРеквизиты.ТекущиеДанные;
	Если ТекСтр = Неопределено Тогда Возврат КонецЕсли;
	П = Новый Структура("Комментарий, НазначениеРассылки", ТекСтр.Комментарий, ТекСтр.НазначениеРассылки);
	Оп = Новый ОписаниеОповещения("ПослеЗакрытияФормыВводаРеквизитов", ЭтотОбъект, Форма);
	ОткрытьФорму("РегистрСведений.РеквизитыКонтрагентов.Форма.ВводДополнительныхДанных", П, Форма,,,, Оп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

Процедура Скопировать(Форма, ВидРеквизитаНазначения) Экспорт
	ТекСтр = Форма.Элементы.ДЗРеквизиты.ТекущиеДанные;
	Родитель = ТекСтр.ПолучитьРодителя();
	// Найдём установленный
	СтрНазначение = Неопределено;
	Для Каждого Стр Из Родитель.ПолучитьЭлементы() Цикл
		Если Стр.Реквизит <> ВидРеквизитаНазначения Тогда Продолжить КонецЕсли;
		СтрНазначение = Стр;
		Прервать;
	КонецЦикла;	
	Если СтрНазначение = Неопределено Тогда	
		СтрНазначение = Родитель.ПолучитьЭлементы().Добавить();
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(СтрНазначение, ТекСтр);
	СтрНазначение.Реквизит = ВидРеквизитаНазначения; 
КонецПроцедуры

Процедура ОбработатьРезультатЗаполненияРеквизитовПоИНН(Форма, Результат) Экспорт
	Если Результат.Выполнено Тогда
		ОбщегоНазначенияКлиент.РазвернутьДеревоЗначений(Форма.ДЗРеквизиты, Форма.Элементы.ДЗРеквизиты);	
	Иначе	
		ПоказатьПредупреждение(, Результат.ОписаниеОшибки);	
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти

#Область События_элементов_формы

Процедура ПриАктивацииСтроки(Форма) Экспорт
	// Найдём команды
	КомандаКомментарийРеквизита = Форма.Элементы.Найти("ДЗРеквизитыКонтекстноеМенюКомментарийРеквизита");
	КомандаЗаполнитьПоИНН = Форма.Элементы.Найти("ДЗРеквизитыКонтекстноеМенюЗаполнитьПоИНН");
	КомандаСкопироватьВАдресПоПрописке = Форма.Элементы.Найти("ДЗРеквизитыКонтекстноеМенюСкопироватьВАдресПоПрописке"); 
	КомандаСкопироватьВАдресПроживания = Форма.Элементы.Найти("ДЗРеквизитыКонтекстноеМенюСкопироватьВАдресПроживания");
	КомандаСкопироватьВФактическийАдрес = Форма.Элементы.Найти("ДЗРеквизитыКонтекстноеМенюСкопироватьВФактическийАдрес");
	КомандаСкопироватьВАдресДоставки = Форма.Элементы.Найти("ДЗРеквизитыКонтекстноеМенюСкопироватьВАдресДоставки");
	// Получим данные
	ТекСтр = Форма.Элементы.ДЗРеквизиты.ТекущиеДанные;
	Реквизит = ?(ТекСтр = Неопределено, Неопределено, ТекСтр.Реквизит);
	//
	ЭтоИНН = Реквизит = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.NIF");
	ЭтоАдресПоПрописке = Реквизит = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.АдресПоПрописке");
	ЭтоАдресПроживания = Реквизит = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.АдресПроживания");
	ЭтоЮридическийАдрес = Реквизит = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.АдресЮридический");
	ЭтоФактическийАдрес = Реквизит = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.АдресФактический");
	//
	УстановитьВидимостьЭлемента(КомандаКомментарийРеквизита, ДляРеквизитаДоступенКомментарий(Реквизит));
	УстановитьВидимостьЭлемента(КомандаЗаполнитьПоИНН, ЭтоИНН); 
	УстановитьВидимостьЭлемента(КомандаСкопироватьВАдресПоПрописке, ЭтоАдресПроживания);
	УстановитьВидимостьЭлемента(КомандаСкопироватьВАдресПроживания, ЭтоАдресПоПрописке);
	УстановитьВидимостьЭлемента(КомандаСкопироватьВФактическийАдрес, ЭтоЮридическийАдрес);
	УстановитьВидимостьЭлемента(КомандаСкопироватьВАдресДоставки, ЭтоАдресПроживания Или ЭтоАдресПоПрописке Или ЭтоЮридическийАдрес Или ЭтоФактическийАдрес);
КонецПроцедуры

Процедура ВыборТаблицаФормы(Форма, ВыбраннаяСтрока, СтандартнаяОбработка) Экспорт
	ТекСтр = Форма.ДЗРеквизиты.НайтиПоИдентификатору(ВыбраннаяСтрока);
	НачалоВыбора(Форма.Элементы.ДЗРеквизиты, ТекСтр.Реквизит, ТекСтр.Значение, ТекСтр.Представление, СтандартнаяОбработка);	
КонецПроцедуры

Процедура ОбработкаВыбораТаблицаФормы(Форма, ВыбранноеЗначение, СтандартнаяОбработка) Экспорт
	Идентификатор = Форма.Элементы.ДЗРеквизиты.ТекущаяСтрока;
	ТекСтр = Форма.ДЗРеквизиты.НайтиПоИдентификатору(Идентификатор);
	ОбработкаВыбора(ВыбранноеЗначение, ТекСтр.Значение, ТекСтр.Представление, СтандартнаяОбработка);
	ОбщегоНазначенияКлиент.РазвернутьДеревоЗначений(Форма.ДЗРеквизиты, Форма.Элементы.ДЗРеквизиты);
КонецПроцедуры

