
#Область ПрограммныйИнтерфейс

// Выполняет команду сервиса табличной части, добавленную КомандыТабличныхЧастейВызовСервера.ПодключитьКоманду.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа с табличной частью ТЧТовары.
//  ИмяКоманды - Строка - "КарточкаТовара", "ИсторияТовара" или "ПодборТовара".
//
Процедура ВыполнитьКоманду(Форма, ИмяКоманды) Экспорт
	Если ИмяКоманды = "КарточкаТовара" Тогда
		ОткрытьКарточкуТовара(Форма);
	ИначеЕсли ИмяКоманды = "ИсторияТовара" Тогда
		ОткрытьИсториюТовара(Форма);
	ИначеЕсли ИмяКоманды = "ПодборТовара" Тогда
		П = Новый Структура("ЗакрыватьПриВыборе", Ложь);
		ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаПодбора", П, Форма, Форма, , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОткрытьКарточкуТовара(Форма)
	Товар = ТоварТекущейСтроки(Форма);
	Если ЗначениеЗаполнено(Товар) Тогда
		ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Новый Структура("Ключ", Товар));
	КонецЕсли;
КонецПроцедуры

Процедура ОткрытьИсториюТовара(Форма)
	// Отчет "История товара" за последние 12 месяцев с отбором по товару и контрагенту документа.
	Товар = ТоварТекущейСтроки(Форма);
	Если Не ЗначениеЗаполнено(Товар) Тогда
		Возврат;
	КонецЕсли;
	Контрагент = Неопределено;
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Форма.Объект, "Контрагент") Тогда
		Контрагент = Форма.Объект.Контрагент;
	КонецЕсли;
	ПользовательскиеНастройки = КомандыТабличныхЧастейВызовСервера.НастройкиОтчетаИсторияТовара(Товар, Контрагент);
	П = Новый Структура("ПользовательскиеНастройки, СформироватьПриОткрытии", ПользовательскиеНастройки, Истина);
	ОткрытьФорму("Отчет.ИсторияТовара.ФормаОбъекта", П);
КонецПроцедуры

Функция ТоварТекущейСтроки(Форма)
	ЭлементТЧ = Форма.Элементы.Найти("ТЧТовары");
	Если ЭлементТЧ = Неопределено Или ЭлементТЧ.ТекущиеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЭлементТЧ.ТекущиеДанные.Номенклатура;
КонецФункции

#КонецОбласти
