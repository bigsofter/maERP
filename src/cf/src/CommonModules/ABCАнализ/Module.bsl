#Область ПрограммныйИнтерфейс

// Класс ABC по доле показателя в общей сумме: вызывается из выражения схемы компоновки
// отчёта «ABC-анализ продаж».
//
// Параметры:
//  АКласс - Число - верхняя граница доли класса A, %
//  ВКласс - Число - верхняя граница доли класса B, %
//  СКласс - Число - верхняя граница доли класса C, %
//  Данные - ДанныеГрупповойОбработкиКомпоновкиДанных - значения показателя по группировке
//
// Возвращаемое значение:
//  Строка, Null - класс «A», «B» или «C»; Null, если данных нет
//
Функция ABCКлассификация(АКласс, ВКласс, СКласс, Данные) Экспорт
	Перем ТаблицаЗначений;
	Если Данные = Null Тогда
		Возврат Null;
	КонецЕсли;
	Если ТипЗнч(Данные) <> Тип("ДанныеГрупповойОбработкиКомпоновкиДанных") Тогда
		Сообщить(ТипЗнч(Данные));
		ВызватьИсключение "В функцию ABCКлассификация() можно передавать только объект типа ДанныеГрупповойОбработкиКомпоновкиДанных";	
	КонецЕсли;
	Если Не Данные.ВременныеДанныеОбработки.Свойство("ABCКлассификацияТаблицаЗначений", ТаблицаЗначений) Тогда
		// выполним расчет классификации один раз при первом вызове
		// а потом запомним выполненный расчет и дальше будем этот
		// расчет использовать
		ТаблицаЗначений = Данные.Данные.Скопировать();
		ТаблицаЗначений.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число"));
		Номер = 0;
		ОбщаяСумма = 0;
		Для Каждого СтрокаТаблицыЗначений Из ТаблицаЗначений Цикл
			СтрокаТаблицыЗначений.Номер = Номер;
			Номер = Номер + 1;
			Если СтрокаТаблицыЗначений[0] <> NULL Тогда
				ОбщаяСумма = ОбщаяСумма + СтрокаТаблицыЗначений[0];
			КонецЕсли;
		КонецЦикла;
		ТаблицаЗначений.Сортировать(ТаблицаЗначений.Колонки[0].Имя + " Убыв");
		ТаблицаЗначений.Индексы.Добавить("Номер");
		НакопленнаяСумма = 0;
		ИндексКлассаA = Неопределено;
		ИндексКлассаB = Неопределено;
		Для Каждого СтрокаТаблицыЗначений Из ТаблицаЗначений Цикл
			Если СтрокаТаблицыЗначений[0] <> NULL Тогда
				НакопленнаяСумма = НакопленнаяСумма + СтрокаТаблицыЗначений[0];
			КонецЕсли;
			Если ОбщаяСумма = 0 Тогда
				Процент = 1;
			Иначе
				Процент = НакопленнаяСумма / ОбщаяСумма;
			КонецЕсли;
			Если Процент > (АКласс / 100) Тогда
				Если ИндексКлассаA = Неопределено Тогда
					ИндексКлассаA = ТаблицаЗначений.Индекс(СтрокаТаблицыЗначений);
				ИначеЕсли Процент >= (АКласс+ВКласс) / 100 Тогда
					Если ИндексКлассаB = Неопределено Тогда
						ИндексКлассаB = ТаблицаЗначений.Индекс(СтрокаТаблицыЗначений);
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Данные.ВременныеДанныеОбработки.Вставить("ABCКлассификацияТаблицаЗначений", ТаблицаЗначений);
		Данные.ВременныеДанныеОбработки.Вставить("ABCКлассификацияИндексКлассаA", ИндексКлассаA);
		Данные.ВременныеДанныеОбработки.Вставить("ABCКлассификацияИндексКлассаB", ИндексКлассаB);
	КонецЕсли;
	Если Данные.ТекущийЭлемент = Неопределено Тогда
		// Итог по группировке.
		Возврат Null;
	Иначе
		Строка = ТаблицаЗначений.Найти(Данные.Данные.Индекс(Данные.ТекущийЭлемент), "Номер");
		Если Строка = Неопределено Тогда
			Возврат Null;
		Иначе
			ИндексА = Данные.ВременныеДанныеОбработки.ABCКлассификацияИндексКлассаA;
			ИндексВ = Данные.ВременныеДанныеОбработки.ABCКлассификацияИндексКлассаB;
			////////////////////////////////////////
			Индекс = ТаблицаЗначений.Индекс(Строка);
			Если ИндексА <> Неопределено И Индекс <= ИндексА Тогда
				Возврат "A - класс";
				//Возврат Перечисления.ABCКлассификация.АКласс;
			ИначеЕсли ИндексВ <> Неопределено И Индекс <= ИндексВ Тогда
				Возврат "B - класс";
				//Возврат Перечисления.ABCКлассификация.BКласс;
			Иначе
				Возврат "C - класс";
				//Возврат Перечисления.ABCКлассификация.CКласс;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецФункции

// Класс ABC по трём показателям сразу (выручка, прибыль, количество): вызывается
// из выражения схемы компоновки отчёта «ABC-анализ продаж».
//
// Параметры:
//  АКласс - Число - верхняя граница доли класса A, %
//  ВКласс - Число - верхняя граница доли класса B, %
//  СКласс - Число - верхняя граница доли класса C, %
//  Данные - ДанныеГрупповойОбработкиКомпоновкиДанных - значения показателей по группировке
//
// Возвращаемое значение:
//  Строка, Null - классы по каждому показателю; Null, если данных нет
//
Функция ABCКлассификацияРасш(АКласс, ВКласс, СКласс, Данные) Экспорт
	Перем ТаблицаЗначений;
	Если Данные = Null Тогда
		Возврат Null;
	КонецЕсли;
	Если ТипЗнч(Данные) <> Тип("ДанныеГрупповойОбработкиКомпоновкиДанных") Тогда
		Сообщить(ТипЗнч(Данные));
		ВызватьИсключение "В функцию ABCКлассификация() можно передавать только объект типа ДанныеГрупповойОбработкиКомпоновкиДанных";	
	КонецЕсли;
	Если Не Данные.ВременныеДанныеОбработки.Свойство("ABCКлассификацияТаблицаЗначений", ТаблицаЗначений) Тогда
		// выполним расчет классификации один раз при первом вызове
		// а потом запомним выполненный расчет и дальше будем этот
		// расчет использовать
		ТаблицаЗначений = Данные.Данные.Скопировать();
		ТаблицаЗначений.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число"));
		ТаблицаЗначений.Колонки.Добавить("Номер1", Новый ОписаниеТипов("Число"));
		ТаблицаЗначений.Колонки.Добавить("Номер2", Новый ОписаниеТипов("Число"));
		ТаблицаЗначений.Колонки.Добавить("Номер3", Новый ОписаниеТипов("Число"));
		Номер = 0;
		ОбщаяСумма = 0;
		Для Каждого СтрокаТаблицыЗначений Из ТаблицаЗначений Цикл
			СтрокаТаблицыЗначений.Номер = Номер;
			Номер = Номер + 1;
			//Если СтрокаТаблицыЗначений[0] <> NULL Тогда
			//	ОбщаяСумма = ОбщаяСумма + СтрокаТаблицыЗначений[0];
			//КонецЕсли;
		КонецЦикла;
		Для Н = 1 по 3 Цикл
			ИндексКолонки = Н - 1;
			ОбщаяСумма = ТаблицаЗначений.Итог(ТаблицаЗначений.Колонки[ИндексКолонки].Имя);
			ТаблицаЗначений.Сортировать(ТаблицаЗначений.Колонки[ИндексКолонки].Имя + " Убыв");
			ТаблицаЗначений.Индексы.Добавить("Номер1");
			ТаблицаЗначений.Индексы.Добавить("Номер2");
			ТаблицаЗначений.Индексы.Добавить("Номер3");
			НакопленнаяСумма = 0;
			ИндексКлассаA = Неопределено;
			ИндексКлассаB = Неопределено;
			Данные.ВременныеДанныеОбработки.Вставить("ABCКлассификацияТаблицаЗначений", ТаблицаЗначений);
			Номер = 0;
			процентПосчитан = Ложь;
			Для Каждого СтрокаТаблицыЗначений Из ТаблицаЗначений Цикл
				СтрокаТаблицыЗначений["Номер"+Н] = Номер;
				Номер = Номер + 1;
				Если Не процентПосчитан Тогда 
					Если СтрокаТаблицыЗначений[ИндексКолонки] <> NULL Тогда
						НакопленнаяСумма = НакопленнаяСумма + СтрокаТаблицыЗначений[ИндексКолонки];
					КонецЕсли;
					Если ОбщаяСумма = 0 Тогда
						Процент = 1;
					Иначе
						Процент = НакопленнаяСумма / ОбщаяСумма;
					КонецЕсли;
					Если Процент > (АКласс / 100) Тогда
						Если ИндексКлассаA = Неопределено Тогда
							ИндексКлассаA = СтрокаТаблицыЗначений["Номер"+Н]; //ТаблицаЗначений.Индекс(СтрокаТаблицыЗначений);
						ИначеЕсли Процент >= (АКласс+ВКласс) / 100 Тогда
							Если ИндексКлассаB = Неопределено Тогда
								ИндексКлассаB = СтрокаТаблицыЗначений["Номер"+Н]; //ТаблицаЗначений.Индекс(СтрокаТаблицыЗначений);
							КонецЕсли;
							процентПосчитан = Истина; //Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Данные.ВременныеДанныеОбработки.Вставить("ABCКлассификацияИндексКлассаA"+"_"+ИндексКолонки, ИндексКлассаA);
			Данные.ВременныеДанныеОбработки.Вставить("ABCКлассификацияИндексКлассаB"+"_"+ИндексКолонки, ИндексКлассаB);
		КонецЦикла;
	КонецЕсли;
	Если Данные.ТекущийЭлемент = Неопределено Тогда
		// Итог по группировке.
		Возврат Null;
	Иначе
		Строка = ТаблицаЗначений.Найти(Данные.Данные.Индекс(Данные.ТекущийЭлемент), "Номер");
		//НомерСтроки = Данные.Данные.Индекс(Данные.ТекущийЭлемент);
		Если Строка = Неопределено Тогда
			Возврат Null;
		Иначе
			Класс = "";
			Для Н = 1 по 3 Цикл 
				ИндексКолонки = Н - 1;
				//ТаблицаЗначений.Сортировать(ТаблицаЗначений.Колонки[ИндексКолонки].Имя + " Убыв");
				ИндексА = 0;
				ИндексВ = 0;
				Данные.ВременныеДанныеОбработки.Свойство("ABCКлассификацияИндексКлассаA"+"_"+ИндексКолонки,ИндексА);
				Данные.ВременныеДанныеОбработки.Свойство("ABCКлассификацияИндексКлассаB"+"_"+ИндексКолонки,ИндексВ);
				НомерСтроки = Строка["Номер"+Н];
				////////////////////////////////////////
				//Индекс = ТаблицаЗначений.Индекс(Строка);
				//Если ИндексА <> Неопределено И Индекс <= ИндексА Тогда
				//	Класс = Класс + "A";
				//	//Возврат Перечисления.ABCКлассификация.АКласс;
				//ИначеЕсли ИндексВ <> Неопределено И Индекс <= ИндексВ Тогда
				//	Класс = Класс + "B";
				//	//Возврат Перечисления.ABCКлассификация.BКласс;
				//Иначе
				//	Класс = Класс + "C";
				//	//Возврат Перечисления.ABCКлассификация.CКласс;
				//КонецЕсли;
				Если ИндексА <> Неопределено И НомерСтроки <= ИндексА Тогда
					Класс = Класс + "A";
					//Возврат Перечисления.ABCКлассификация.АКласс;
				ИначеЕсли ИндексВ <> Неопределено И НомерСтроки <= ИндексВ Тогда
					Класс = Класс + "B";
					//Возврат Перечисления.ABCКлассификация.BКласс;
				Иначе
					Класс = Класс + "C";
					//Возврат Перечисления.ABCКлассификация.CКласс;
				КонецЕсли;
			КонецЦикла;
			Возврат Класс + " - класс";
		КонецЕсли;
	КонецЕсли;
КонецФункции

#КонецОбласти
