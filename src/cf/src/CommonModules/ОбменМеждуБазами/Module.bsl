// Обмен между базами maERP (docs/plans/exchange-maerp.md): реализация продавца приходит покупателю поступлением,
// установка цен - установкой цен. Регистрация событий с ревизиями, снимок документа для выгрузки, применение
// входящего объекта, сообщения с подписью, транспорт «Каталог», состояние и захват запуска узла.
//
// BSLLS:SetPrivilegedMode-off - модуль обмена работает со служебными регистрами, права на которые есть только
// у привилегированного кода; права пользователя проверяются в ОбменМеждуБазамиВызовСервера до вызова.
// BSLLS:PrivilegedModuleMethodCall-off - ключ подписи читает только серверный транспорт этого модуля.

#Область ПрограммныйИнтерфейс

#Область Подписки

// Подписка ПередЗаписью реализации и установки цен: проведённый документ, участвующий в обмене, с изменениями
// значимых для обмена данных можно только перепровести или распровести (обмен отправляет состояние проведения);
// установку цен, созданную обменом, меняет только загрузчик.
//
// Параметры:
//  Источник        - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.УстановкаЦенНоменклатуры - документ.
//  Отказ           - Булево - отказ записи.
//  РежимЗаписи     - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписьюДокументаОбмена(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Источник.ОбменДанными.Загрузка Или Источник.ЭтоНовый() Или ЗаписьОбменом(Источник) Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.УстановкаЦенНоменклатуры") И СозданОбменом(Источник.Ссылка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'Установка цен получена по обмену: изменить её может только обмен. Свои цены задайте новой установкой цен';
			|fr = 'Le prix a été reçu par l''échange : seul l''échange peut le modifier. Saisissez vos prix par un nouveau document';
			|en = 'The price setting came from the exchange: only the exchange can change it. Set your prices in a new price setting';
			|es = 'La fijación de precios llegó por el intercambio: solo el intercambio puede cambiarla. Fije sus precios en una nueva'"),
			Источник, , , Отказ);
		Возврат;
	КонецЕсли;
	Если РежимЗаписи <> РежимЗаписиДокумента.Запись Или Не УчаствуетВОбмене(Источник) Тогда
		Возврат;
	КонецЕсли;
	Сохраненный = Источник.Ссылка.ПолучитьОбъект();
	Если Сохраненный.Проведен И ИзмененыДанныеОбмена(Источник, Сохраненный) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'Документ передан по обмену: проведите его заново или отмените проведение';
			|fr = 'Le document a été transmis par l''échange : revalidez-le ou annulez sa validation';
			|en = 'The document was sent by the exchange: post it again or unpost it';
			|es = 'El documento se envió por el intercambio: vuelva a contabilizarlo o anule la contabilización'"),
			Источник, , , Отказ);
	КонецЕсли;
КонецПроцедуры

// Подписка ОбработкаПроведения: событие «Проведен» на узлы документа.
//
// Параметры:
//  Источник        - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.УстановкаЦенНоменклатуры - документ.
//  Отказ           - Булево - отказ проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ОбработкаПроведенияДокументаОбмена(Источник, Отказ, РежимПроведения) Экспорт
	Если Источник.ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	ЗарегистрироватьСобытие(Источник, СостояниеПроведен());
КонецПроцедуры

// Подписка ОбработкаУдаленияПроведения: событие «НеПроведен» узлам, которым документ уже отправлялся.
//
// Параметры:
//  Источник - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.УстановкаЦенНоменклатуры - документ.
//  Отказ    - Булево - отказ.
//
Процедура ОбработкаУдаленияПроведенияДокументаОбмена(Источник, Отказ) Экспорт
	Если Источник.ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	ЗарегистрироватьСобытие(Источник, СостояниеНеПроведен());
КонецПроцедуры

// Подписка ПередУдалением: событие «Удален» узлам, которым документ уже отправлялся.
//
// Параметры:
//  Источник - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.УстановкаЦенНоменклатуры - документ.
//  Отказ    - Булево - отказ.
//
Процедура ПередУдалениемДокументаОбмена(Источник, Отказ) Экспорт
	Если Источник.ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	ЗарегистрироватьСобытие(Источник, СостояниеУдален());
КонецПроцедуры

#КонецОбласти

#Область Регистрация

// Регистрирует событие документа на узлы: текущие по предикату принадлежности и те, которым документ уже
// отправлялся (им - отзыв, если документ узлу больше не принадлежит). Ревизия исходящей записи растёт в той же
// транзакции; растёт и поколение событий узла.
//
// Параметры:
//  Объект    - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.УстановкаЦенНоменклатуры - документ.
//  Состояние - Строка - «Проведен», «НеПроведен», «Удален».
//
Процедура ЗарегистрироватьСобытие(Объект, Состояние) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если ЗаписьОбменом(Объект) Или СозданОбменом(Объект.Ссылка) Тогда
		// Транзита нет: документ, созданный обменом, никуда не отправляется.
		Возврат;
	КонецЕсли;
	ТипОбъекта = ТипОбъектаОбмена(Объект.Ссылка);
	Ид = Строка(Объект.Ссылка.УникальныйИдентификатор());
	Текущие = ?(Состояние = СостояниеУдален(), Новый Массив, УзлыДокумента(Объект));
	Прежние = УзлыОтправки(ТипОбъекта, Ид);
	Для Каждого Узел Из ОбъединениеУзлов(Текущие, Прежние) Цикл
		Принадлежит = Текущие.Найти(Узел) <> Неопределено;
		БылОтправлен = Прежние.Найти(Узел) <> Неопределено;
		Если Не БылОтправлен И (Состояние <> СостояниеПроведен() Или Объект.Дата < ДатаНачалаОбмена(Узел)) Тогда
			// Первое включение - только проведённый документ не раньше границы истории узла.
			Продолжить;
		КонецЕсли;
		СостояниеУзлу = ?(Принадлежит Или Состояние = СостояниеУдален(), Состояние, СостояниеОтозван());
		ЗарегистрироватьНаУзел(Узел, Объект.Ссылка, ТипОбъекта, Ид, СостояниеУзлу);
	КонецЦикла;
КонецПроцедуры

// Узлы, которым документ принадлежит по настройкам: реализация - контрагент и организация узла (кроме налоговых
// документов на основаниях), установка цен - вид цены шапки среди видов цен выгрузки и операция установки цен.
//
// Параметры:
//  Объект - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.УстановкаЦенНоменклатуры,
//           ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.УстановкаЦенНоменклатуры - документ.
//
// Возвращаемое значение:
//  Массив из ПланОбменаСсылка.ОбменМеждуБазами - узлы.
//
Функция УзлыДокумента(Объект) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.ОбменМеждуБазами.ЭтотУзел());
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг")
		Или ТипЗнч(Объект) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		НаОснованиях = ?(ТипЗнч(Объект) = Тип("ДокументСсылка.РеализацияТоваровУслуг"),
			НалоговыеДокументыНаОснованиях.ЭтоРегистраторНаОснованиях(Объект),
			НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(Объект));
		Если НаОснованиях Тогда
			Возврат Новый Массив;
		КонецЕсли;
		Запрос.Текст = "ВЫБРАТЬ
		|	Узлы.Ссылка КАК Узел
		|ИЗ
		|	ПланОбмена.ОбменМеждуБазами КАК Узлы
		|ГДЕ
		|	Узлы.Ссылка <> &ЭтотУзел
		|	И НЕ Узлы.ПометкаУдаления
		|	И Узлы.ВыгружатьРеализации
		|	И Узлы.Контрагент = &Контрагент
		|	И Узлы.Организация = &Организация";
		Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Иначе
		Если Объект.ХозяйственнаяОперация <> Перечисления.ХозяйственныеОперации.УстановкаЦенНоменклатуры Тогда
			Возврат Новый Массив;
		КонецЕсли;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Узлы.Ссылка КАК Узел
		|ИЗ
		|	ПланОбмена.ОбменМеждуБазами.ВидыЦенВыгрузки КАК ВидыЦен
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланОбмена.ОбменМеждуБазами КАК Узлы
		|		ПО ВидыЦен.Ссылка = Узлы.Ссылка
		|ГДЕ
		|	Узлы.Ссылка <> &ЭтотУзел
		|	И НЕ Узлы.ПометкаУдаления
		|	И Узлы.ВыгружатьЦены
		|	И ВидыЦен.ВидЦены = &ВидЦены";
		Запрос.УстановитьПараметр("ВидЦены", Объект.ВидЦены);
	КонецЕсли;
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Узел");
КонецФункции

// Проверка обычной записи: изменились ли данные, которые уходят по обмену (явный набор полей).
//
// Параметры:
//  Объект      - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.УстановкаЦенНоменклатуры - записываемый.
//  Сохраненный - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.УстановкаЦенНоменклатуры - записанный.
//
// Возвращаемое значение:
//  Булево - Истина, если изменилось хотя бы одно поле обмена.
//
Функция ИзмененыДанныеОбмена(Объект, Сохраненный) Экспорт
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		Шапка = "Дата, Организация, Контрагент, Договор, Валюта, ВВалюте, КурсВалюты, ЦенаВключаетНДС";
		Таблицы = Новый Структура;
		Таблицы.Вставить("ТЧТовары", "Номенклатура, Характеристика, Упаковка, Серия, КоличествоУпаковок, Количество,"
			+ " Цена, ПроцентСкидки, СуммаСкидки, СтавкаНДС, Сумма, СуммаНДС, СуммаСНДС");
		Таблицы.Вставить("ТЧУслуги", "Номенклатура, Количество, Цена, СтавкаНДС, Сумма, СуммаНДС, СуммаСНДС");
	Иначе
		Шапка = "Дата, ВидЦены, ХозяйственнаяОперация";
		Таблицы = Новый Структура("ТЧЦены", "Номенклатура, Характеристика, Упаковка, Цена");
	КонецЕсли;
	Для Каждого Поле Из СтрРазделить(Шапка, ", ", Ложь) Цикл
		Если Объект[Поле] <> Сохраненный[Поле] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючИЗначение Из Таблицы Цикл
		Если ТаблицаИзменена(Объект[КлючИЗначение.Ключ], Сохраненный[КлючИЗначение.Ключ], КлючИЗначение.Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

#КонецОбласти

#Область Снимок

// Согласованный снимок документа для выгрузки узлу: содержимое, проведённость, принадлежность узлу и ревизия
// читаются в одной короткой транзакции под разделяемыми блокировками документа и исходящей записи (порядок как у
// регистрации: документ, затем исходящая запись).
//
// Параметры:
//  Узел       - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  ТипОбъекта - Строка - «Реализация», «УстановкаЦен».
//  Ид         - Строка - уникальный идентификатор документа.
//
// Возвращаемое значение:
//  Структура - объект сообщения (Тип, Ид, Ревизия, Состояние и для «Проведен»/«НеПроведен» - данные документа).
//
Функция ДанныеОбъекта(Узел, ТипОбъекта, Ид) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Ссылка = СсылкаДокумента(ТипОбъекта, Ид);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементДокумента = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
		ЭлементДокумента.Режим = РежимБлокировкиДанных.Разделяемый;
		ЭлементДокумента.УстановитьЗначение("Ссылка", Ссылка);
		ЭлементЗаписи = Блокировка.Добавить("РегистрСведений.СоответствияОбъектовОбмена");
		ЭлементЗаписи.Режим = РежимБлокировкиДанных.Разделяемый;
		УстановитьКлючСоответствия(ЭлементЗаписи, Узел, ТипОбъекта, Ид, НаправлениеИсходящий());
		Блокировка.Заблокировать();
		Запись = Соответствие(Узел, ТипОбъекта, Ид, НаправлениеИсходящий());
		Данные = Новый Структура("Тип, Ид", ТипОбъекта, Ид);
		Данные.Вставить("Ревизия", Запись.Ревизия);
		Данные.Вставить("Состояние", СостояниеУдален());
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Если УзлыДокумента(Объект).Найти(Узел) = Неопределено Тогда
				Данные.Состояние = СостояниеОтозван();
			Иначе
				Данные.Состояние = ?(Объект.Проведен, СостояниеПроведен(), СостояниеНеПроведен());
				ЗаполнитьДанныеДокумента(Данные, Объект);
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Данные;
КонецФункции

#КонецОбласти

#Область Применение

// Применяет объект входящего сообщения в одной транзакции: блокировки настроек узла (разделяемая), ключа
// соответствия и документа-приёмника; пара (поколение, ревизия) не новее применённой или отложенной - без изменений;
// тот же отпечаток при существующем документе - только ревизия; иначе - изменение документа, соответствие,
// закрытие отложенной записи. Ошибка - исключение, транзакция откатывается целиком (документа нет, ревизия не
// продвинута); отложить объект - забота вызывающего (в отдельной транзакции).
//
// Параметры:
//  Узел      - ПланОбменаСсылка.ОбменМеждуБазами - узел-отправитель.
//  Данные    - Структура - объект сообщения (см. ДанныеОбъекта).
//  Поколение - Число - поколение обмена сообщения.
//
// Возвращаемое значение:
//  Строка - «Применён», «БезИзменений».
//
Функция ПрименитьОбъект(Узел, Данные, Поколение) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Результат = "БезИзменений";
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНастройкиУзла(Узел, РежимБлокировкиДанных.Разделяемый);
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.СоответствияОбъектовОбмена");
		УстановитьКлючСоответствия(Элемент, Узел, Данные.Тип, Данные.Ид, НаправлениеВходящий());
		Элемент = Блокировка.Добавить("РегистрСведений.ВходящиеОбъектыОбмена");
		Элемент.УстановитьЗначение("Узел", Узел);
		Элемент.УстановитьЗначение("ТипОбъекта", Данные.Тип);
		Элемент.УстановитьЗначение("ВнешнийИд", Данные.Ид);
		Блокировка.Заблокировать();
		Запись = Соответствие(Узел, Данные.Тип, Данные.Ид, НаправлениеВходящий());
		Отложенная = ОтложеннаяЗапись(Узел, Данные.Тип, Данные.Ид);
		Устарел = Не ПараНовее(Поколение, Данные.Ревизия, Запись.ПоколениеОбмена, Запись.Ревизия)
			Или Отложенная.Выбран() И ПараНовее(Отложенная.ПоколениеОбмена, Отложенная.Ревизия, Поколение, Данные.Ревизия);
		Если Не Устарел Тогда
			Результат = ПрименитьНовуюРевизию(Узел, Данные, Поколение, Запись, Отложенная);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Сохраняет объект, который не удалось применить, в отложенные (отдельная транзакция): более новая пара (поколение,
// ревизия) заменяет данные, более старая не трогает отложенное.
//
// Параметры:
//  Узел      - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  Данные    - Структура - объект сообщения.
//  Поколение - Число - поколение обмена.
//  Текст     - Строка - причина.
//
Процедура ОтложитьОбъект(Узел, Данные, Поколение, Текст) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ВходящиеОбъектыОбмена");
		Элемент.УстановитьЗначение("Узел", Узел);
		Элемент.УстановитьЗначение("ТипОбъекта", Данные.Тип);
		Элемент.УстановитьЗначение("ВнешнийИд", Данные.Ид);
		Блокировка.Заблокировать();
		Отложенная = ОтложеннаяЗапись(Узел, Данные.Тип, Данные.Ид);
		ДанныеНовее = Не Отложенная.Выбран()
			Или Не ПараНовее(Отложенная.ПоколениеОбмена, Отложенная.Ревизия, Поколение, Данные.Ревизия);
		Если ДанныеНовее Тогда
			Отложенная.Данные = Новый ХранилищеЗначения(Данные);
			Отложенная.ПоколениеОбмена = Поколение;
			Отложенная.Ревизия = Данные.Ревизия;
			Если Не ЗначениеЗаполнено(Отложенная.ДатаПолучения) Тогда
				Отложенная.ДатаПолучения = ТекущаяДатаСеанса();
			КонецЕсли;
		КонецЕсли;
		Отложенная.Статус = "Отложен";
		Отложенная.ТекстОшибки = Текст;
		Отложенная.ДатаПопытки = ТекущаяДатаСеанса();
		Отложенная.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Общая проверка периода для записи обменом, не зависящая от пользователя сеанса: дата документа (прежняя и
// новая) позже общей даты запрета базы (без персональных разрешений и исключений) и даты запрета обмена узла.
//
// Параметры:
//  Организация - СправочникСсылка.Организации - организация документа.
//  Даты        - Массив из Дата - прежняя и новая даты документа.
//  Узел        - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Булево - Истина, если период открыт.
//
Функция ПериодОткрытДляОбмена(Организация, Даты, Узел) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Граница = Макс(ОбщаяДатаЗапрета(Организация), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ДатаЗапретаОбмена"));
	Для Каждого Дата Из Даты Цикл
		Если ЗначениеЗаполнено(Дата) И ЗначениеЗаполнено(Граница) И КонецДня(Дата) <= КонецДня(Граница) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

#КонецОбласти

#Область Сообщения

// Выполняет обмен узла: захват запуска, транспорт, состояние узла; ошибка - в состоянии узла и исключением.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Структура - Отправлено, Принято, Отложено (Число).
//
Функция ВыполнитьОбмен(Узел) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Настройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Узел, "ОбменВключен, ВидТранспорта");
	Если Не Настройки.ОбменВключен Тогда
		ВызватьИсключение НСтр("ru = 'Обмен с узлом выключен'; fr = 'L''échange avec le nœud est désactivé';
			|en = 'The exchange with the node is disabled'; es = 'El intercambio con el nodo está desactivado'");
	КонецЕсли;
	Если Настройки.ВидТранспорта <> Перечисления.ВидыТранспортаОбменаМеждуБазами.Каталог Тогда
		ВызватьИсключение НСтр("ru = 'Транспорт HTTP появится в следующей сборке';
			|fr = 'Le transport HTTP arrive dans la prochaine version';
			|en = 'HTTP transport comes in the next build'; es = 'El transporte HTTP llega en la próxima versión'");
	КонецЕсли;
	Токен = ЗахватитьУзел(Узел);
	Итог = Новый Структура("Отправлено, Принято, Отложено", 0, 0, 0);
	ПоколениеСобытий = МенеджерСостояния(Узел).ПоколениеСобытий;
	Попытка
		СверитьСостав(Узел);
		ОбменЧерезКаталог(Узел, Токен, Итог);
		ЗаписатьРезультат(Узел, "Успешно", "", Итог, ПоколениеСобытий);
		ОсвободитьУзел(Узел, Токен);
	Исключение
		Текст = ТекстОшибки(ИнформацияОбОшибке());
		ЗаписатьРезультат(Узел, "Ошибка", Текст, Итог, Неопределено);
		ОсвободитьУзел(Узел, Токен);
		ВызватьИсключение;
	КонецПопытки;
	Возврат Итог;
КонецФункции

// Сообщение с данными для узла (stop-and-wait): занятый слот - то же сохранённое сообщение; свободный - новое
// из регистраций (страницы кандидатов, лимиты пакета), слот, журнал отправки и номер - одной транзакцией.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Строка - текст сообщения; пустая - отправлять нечего.
//
Функция ИсходящееСообщение(Узел) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Слот = СлотИсходящего(Узел);
	Если Слот.Выбран() Тогда
		Возврат Слот.Тело.Получить();
	КонецЕсли;
	Объекты = ОбъектыДляОтправки(Узел);
	Если Объекты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		// Порядок как у регистрации при проведении: ключи соответствий, затем состояние узла.
		Блокировка = Новый БлокировкаДанных;
		Для Каждого Данные Из Объекты Цикл
			Элемент = Блокировка.Добавить("РегистрСведений.СоответствияОбъектовОбмена");
			УстановитьКлючСоответствия(Элемент, Узел, Данные.Тип, Данные.Ид, НаправлениеИсходящий());
		КонецЦикла;
		Элемент = Блокировка.Добавить("РегистрСведений.СостояниеОбменаМеждуБазами");
		Элемент.УстановитьЗначение("Узел", Узел);
		Блокировка.Заблокировать();
		Состояние = МенеджерСостояния(Узел);
		Поколение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ПоколениеОбмена");
		Номер = Состояние.ОтправленныйНомер + 1;
		Конверт = НовыйКонверт(Узел, "Сообщение", Поколение, Состояние);
		Конверт.Вставить("Номер", Номер);
		Конверт.Вставить("Объекты", Объекты);
		Текст = ВСтрокуJSON(Конверт);
		ЗаписатьЖурналОтправки(Узел, Поколение, Номер, Объекты);
		Слот.Узел = Узел;
		Слот.ПоколениеОбмена = Поколение;
		Слот.НомерСообщения = Номер;
		Слот.Тело = Новый ХранилищеЗначения(Текст);
		Слот.Хеш = ХешСтроки(Текст);
		Слот.Записать();
		Состояние.ОтправленныйНомер = Номер;
		Состояние.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Текст;
КонецФункции

// Принимает сообщение с данными: проверка адресации и поколения, закрепление идентичности (хеш номера) до
// применения, квитанция, объекты (ошибка - в отложенные; сбой сохранения отложенного - прерывание без продвижения
// принятого номера), принятый номер.
//
// Параметры:
//  Узел  - ПланОбменаСсылка.ОбменМеждуБазами - узел-отправитель.
//  Текст - Строка - текст сообщения (подпись уже проверена транспортом).
//  Итог  - Структура - счётчики (Принято, Отложено).
//
// Возвращаемое значение:
//  Число - номер принятого сообщения (для ACK).
//
Функция ЗагрузитьСообщение(Узел, Текст, Итог) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Конверт = ПроверенныйКонверт(Узел, Текст, "Сообщение");
	Номер = Конверт.Номер;
	Повтор = ЗакрепитьИдентичность(Узел, Номер, ХешСтроки(Текст));
	ОбработатьКвитанцию(Узел, Конверт.Поколение, Конверт.ПринятыйНомер);
	Если Повтор Тогда
		Возврат Номер;
	КонецЕсли;
	Для Каждого Данные Из Конверт.Объекты Цикл
		Попытка
			Если ПрименитьОбъект(Узел, Данные, Конверт.Поколение) = "Применён" Тогда
				Итог.Принято = Итог.Принято + 1;
			КонецЕсли;
		Исключение
			// Ошибка применения - в отложенные; ошибка сохранения отложенного прервёт приём целиком.
			ОтложитьОбъект(Узел, Данные, Конверт.Поколение, ТекстОшибки(ИнформацияОбОшибке()));
			Итог.Отложено = Итог.Отложено + 1;
		КонецПопытки;
	КонецЦикла;
	ЗафиксироватьПринятый(Узел, Номер);
	Возврат Номер;
КонецФункции

// Квитанция партнёра: строки журнала отправки с номером не выше принятого - пообъектно, каждая своей транзакцией
// (исходящий ключ): совпала ревизия - регистрация снимается; слот с подтверждённым номером освобождается. Партнёр
// подтвердил больше, чем отправлено, - признак отката: исключение, обмен останавливается.
//
// Параметры:
//  Узел          - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  Поколение     - Число - поколение обмена квитанции.
//  ПринятыйНомер - Число - номер, принятый партнёром.
//
Процедура ОбработатьКвитанцию(Узел, Поколение, ПринятыйНомер) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если ПринятыйНомер > МенеджерСостояния(Узел).ОтправленныйНомер Тогда
		ОстановитьПриОткате(Узел, НСтр("ru = 'Партнёр подтвердил больше сообщений, чем отправлено';
			|fr = 'Le partenaire a confirmé plus de messages que ceux envoyés';
			|en = 'The partner confirmed more messages than were sent'; es = 'El socio confirmó más mensajes de los enviados'"));
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Журнал.НомерСообщения КАК НомерСообщения,
	|	Журнал.ТипОбъекта КАК ТипОбъекта,
	|	Журнал.ВнешнийИд КАК ВнешнийИд,
	|	Журнал.Ревизия КАК Ревизия,
	|	Журнал.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.ЖурналОтправкиОбмена КАК Журнал
	|ГДЕ
	|	Журнал.Узел = &Узел
	|	И Журнал.ПоколениеОбмена = &Поколение
	|	И Журнал.НомерСообщения <= &ПринятыйНомер");
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("Поколение", Поколение);
	Запрос.УстановитьПараметр("ПринятыйНомер", ПринятыйНомер);
	Для Каждого СтрокаЖурнала Из Запрос.Выполнить().Выгрузить() Цикл
		ПодтвердитьОбъект(Узел, Поколение, СтрокаЖурнала);
	КонецЦикла;
	Слот = СлотИсходящего(Узел);
	Если Слот.Выбран() И Слот.ПоколениеОбмена = Поколение И Слот.НомерСообщения <= ПринятыйНомер Тогда
		Слот.Удалить();
	КонецЕсли;
КонецПроцедуры

// Текст ACK: принятый номер, поколение, адресация; не занимает номер и слот.
//
// Параметры:
//  Узел          - ПланОбменаСсылка.ОбменМеждуБазами - узел-получатель ACK.
//  ПринятыйНомер - Число - принятый номер.
//
// Возвращаемое значение:
//  Строка - текст ACK.
//
Функция ТекстПодтверждения(Узел, ПринятыйНомер) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Конверт = НовыйКонверт(Узел, "ACK", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ПоколениеОбмена"),
		МенеджерСостояния(Узел));
	Конверт.ПринятыйНомер = ПринятыйНомер;
	Возврат ВСтрокуJSON(Конверт);
КонецФункции

// Принимает ACK партнёра.
//
// Параметры:
//  Узел  - ПланОбменаСсылка.ОбменМеждуБазами - узел-отправитель ACK.
//  Текст - Строка - текст ACK (подпись проверена).
//
Процедура ЗагрузитьПодтверждение(Узел, Текст) Экспорт
	Конверт = ПроверенныйКонверт(Узел, Текст, "ACK");
	ОбработатьКвитанцию(Узел, Конверт.Поколение, Конверт.ПринятыйНомер);
КонецПроцедуры

// Подпись HMAC-SHA256 текста ключом пары (hex), результат - hex.
//
// Параметры:
//  КлючHex - Строка - ключ в hex.
//  Текст   - Строка - подписываемый текст (байты UTF-8 без BOM).
//
// Возвращаемое значение:
//  Строка - подпись в hex (нижний регистр).
//
Функция ПодписьСообщения(КлючHex, Текст) Экспорт
	РазмерБлока = РазмерБлокаХеша();
	Ключ = ПолучитьБуферДвоичныхДанныхИзHexСтроки(КлючHex);
	Если Ключ.Размер > РазмерБлока Тогда
		Ключ = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ХешДанных(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Ключ)));
	КонецЕсли;
	Внутренний = БлокКлюча(Ключ, РазмерБлока, ЗаполнительВнутренний());
	Внешний = БлокКлюча(Ключ, РазмерБлока, ЗаполнительВнешний());
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Внутренний));
	Хеширование.Добавить(Данные);
	ВнутреннийХеш = Хеширование.ХешСумма;
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Внешний));
	Хеширование.Добавить(ВнутреннийХеш);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

#КонецОбласти

#Область Захват

// Захват запуска узла с токеном владельца: запись живого сеанса - отказ (без ограничения по возрасту), сеанс
// завершён - захват.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Строка - токен владельца.
//
Функция ЗахватитьУзел(Узел) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.СостояниеОбменаМеждуБазами");
		Элемент.УстановитьЗначение("Узел", Узел);
		Блокировка.Заблокировать();
		Состояние = МенеджерСостояния(Узел);
		Если ЗначениеЗаполнено(Состояние.ТокенВыполнения)
			И СеансЖив(Состояние.СеансВыполнения, Состояние.НачалоСеансаВыполнения) Тогда
			ВызватьИсключение НСтр("ru = 'Обмен с узлом уже выполняется'; fr = 'L''échange avec le nœud est déjà en cours';
				|en = 'The exchange with the node is already running'; es = 'El intercambio con el nodo ya está en curso'");
		КонецЕсли;
		Сеанс = ПолучитьТекущийСеансИнформационнойБазы();
		Токен = Строка(Новый УникальныйИдентификатор);
		Состояние.ТокенВыполнения = Токен;
		Состояние.СеансВыполнения = Сеанс.НомерСеанса;
		Состояние.НачалоСеансаВыполнения = Сеанс.НачалоСеанса;
		Состояние.ВыполняетсяС = ТекущаяДатаСеанса();
		Состояние.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Токен;
КонецФункции

// Снимает захват, только если токен свой.
//
// Параметры:
//  Узел  - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  Токен - Строка - токен владельца.
//
Процедура ОсвободитьУзел(Узел, Токен) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.СостояниеОбменаМеждуБазами");
		Элемент.УстановитьЗначение("Узел", Узел);
		Блокировка.Заблокировать();
		Состояние = МенеджерСостояния(Узел);
		Если Состояние.ТокенВыполнения = Токен Тогда
			Состояние.ТокенВыполнения = "";
			Состояние.СеансВыполнения = 0;
			Состояние.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область Команды

// Повторяет применение отложенных объектов узла (тот же путь ПрименитьОбъект); неудача - текст обновляется.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Число - применено объектов.
//
Функция ПовторитьОтложенные(Узел) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Отложенные.Данные КАК Данные,
	|	Отложенные.ПоколениеОбмена КАК ПоколениеОбмена
	|ИЗ
	|	РегистрСведений.ВходящиеОбъектыОбмена КАК Отложенные
	|ГДЕ
	|	Отложенные.Узел = &Узел
	|	И Отложенные.Статус = ""Отложен""");
	Запрос.УстановитьПараметр("Узел", Узел);
	Применено = 0;
	Для Каждого Отложенный Из Запрос.Выполнить().Выгрузить() Цикл
		Данные = Отложенный.Данные.Получить();
		Попытка
			ПрименитьОбъект(Узел, Данные, Отложенный.ПоколениеОбмена);
			Применено = Применено + 1;
		Исключение
			ОтложитьОбъект(Узел, Данные, Отложенный.ПоколениеОбмена,
				ТекстОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат Применено;
КонецФункции

// Ручное сопоставление номенклатуры, характеристики или упаковки партнёра: тип своего объекта соответствует
// виду, номенклатура - типу строки (товар/услуга); растёт версия правил конвертации узла.
//
// Параметры:
//  Узел       - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  ТипОбъекта - Строка - «Номенклатура», «Характеристика», «Упаковка».
//  ВнешнийИд  - Строка - идентификатор у партнёра.
//  Объект     - СправочникСсылка.Номенклатура, СправочникСсылка.ХарактеристикиНоменклатуры,
//               СправочникСсылка.УпаковкиЕдиницыИзмерения - свой объект.
//  ЭтоТовар   - Булево - для номенклатуры: строка товаров или услуг.
//
Процедура СопоставитьОбъект(Узел, ТипОбъекта, ВнешнийИд, Объект, ЭтоТовар) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Типы = Новый Соответствие;
	Типы.Вставить("Номенклатура", Тип("СправочникСсылка.Номенклатура"));
	Типы.Вставить("Характеристика", Тип("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Типы.Вставить("Упаковка", Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Допустимо = Типы[ТипОбъекта] <> Неопределено И ТипЗнч(Объект) = Типы[ТипОбъекта] И ЗначениеЗаполнено(Объект);
	Допустимо = Допустимо И (ТипОбъекта <> "Номенклатура" Или ПодходящийТип(Объект, ЭтоТовар));
	Если Не Допустимо Тогда
		ВызватьИсключение НСтр("ru = 'Сопоставление недопустимо: проверьте вид и тип объекта';
			|fr = 'Association non autorisée : vérifiez le genre et le type de l''objet';
			|en = 'The mapping is not allowed: check the object kind and type';
			|es = 'Asociación no permitida: verifique la clase y el tipo del objeto'");
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНастройкиУзла(Узел, РежимБлокировкиДанных.Исключительный);
		Запись = Соответствие(Узел, ТипОбъекта, ВнешнийИд, НаправлениеВходящий());
		Запись.ТипОбъектаБазы = Объект.Метаданные().ПолноеИмя();
		Запись.ИдОбъектаБазы = Строка(Объект.УникальныйИдентификатор());
		Запись.Записать();
		УвеличитьВерсиюПравил(Узел);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Сопоставление единицы партнёра (пара с единицей приёмника) и коэффициента; растёт версия правил.
//
// Параметры:
//  Узел               - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  ИдЕдиницыИсточника - Строка - идентификатор единицы у партнёра.
//  ЕдиницаПриемника   - СправочникСсылка.УпаковкиЕдиницыИзмерения - своя единица.
//  Коэффициент        - Число - сколько своих единиц в единице партнёра (больше нуля).
//
Процедура СопоставитьЕдиницу(Узел, ИдЕдиницыИсточника, ЕдиницаПриемника, Коэффициент) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если Коэффициент <= 0 Или Не ЗначениеЗаполнено(ЕдиницаПриемника) Или ПустаяСтрока(ИдЕдиницыИсточника) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите свою единицу и коэффициент больше нуля';
			|fr = 'Indiquez votre unité et un coefficient positif';
			|en = 'Specify your unit and a coefficient greater than zero'; es = 'Indique su unidad y un coeficiente mayor que cero'");
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНастройкиУзла(Узел, РежимБлокировкиДанных.Исключительный);
		Запись = РегистрыСведений.СопоставлениеЕдиницОбмена.СоздатьМенеджерЗаписи();
		Запись.Узел = Узел;
		Запись.ИдЕдиницыИсточника = ИдЕдиницыИсточника;
		Запись.ЕдиницаПриемника = ЕдиницаПриемника;
		Запись.Коэффициент = Коэффициент;
		Запись.Записать();
		УвеличитьВерсиюПравил(Узел);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Регистрирует проведённую реализацию на её узлы заново (новая ревизия) - команда «Отправить по обмену».
//
// Параметры:
//  Документ - ДокументСсылка.РеализацияТоваровУслуг - реализация.
//
// Возвращаемое значение:
//  Число - узлов.
//
Функция ОтправитьДокумент(Документ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Объект = Документ.ПолучитьОбъект();
	Если Не Объект.Проведен Тогда
		ВызватьИсключение НСтр("ru = 'Отправляется только проведённый документ'; fr = 'Seul un document validé est envoyé';
			|en = 'Only a posted document is sent'; es = 'Solo se envía un documento contabilizado'");
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("Документ.РеализацияТоваровУслуг");
		Элемент.УстановитьЗначение("Ссылка", Документ);
		Блокировка.Заблокировать();
		ЗарегистрироватьСобытие(Объект, СостояниеПроведен());
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат УзлыДокумента(Объект).Количество();
КонецФункции

// Код узла этой базы; пустой - создаётся из случайного идентификатора (9 символов).
//
// Возвращаемое значение:
//  Строка - код.
//
Функция КодЭтойБазы() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ЭтотУзел = ПланыОбмена.ОбменМеждуБазами.ЭтотУзел();
	Код = СокрЛП(ЭтотУзел.Код);
	Если ПустаяСтрока(Код) Тогда
		Код = ВРег(Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), ДлинаКода()));
		Объект = ЭтотУзел.ПолучитьОбъект();
		Объект.Код = Код;
		Объект.Наименование = НСтр("ru = 'Эта база'; fr = 'Cette base'; en = 'This base'; es = 'Esta base'");
		Объект.Записать();
	КонецЕсли;
	Возврат Код;
КонецФункции

// Сверка состава после смены фильтров узла: подходящие проведённые документы не раньше границы без актуальной
// исходящей записи - регистрация; отправленные, больше не подходящие, - отзыв. Завершённая сверка запоминает
// поколение фильтров.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
Процедура СверитьСостав(Узел) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Поколение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ПоколениеФильтров");
	Если МенеджерСостояния(Узел).ПоколениеЗавершеннойСверки >= Поколение Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Ссылка Из КандидатыСверки(Узел) Цикл
		СверитьДокумент(Узел, Ссылка);
	КонецЦикла;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.СостояниеОбменаМеждуБазами");
		Элемент.УстановитьЗначение("Узел", Узел);
		Блокировка.Заблокировать();
		Состояние = МенеджерСостояния(Узел);
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ПоколениеФильтров") = Поколение Тогда
			Состояние.ПоколениеЗавершеннойСверки = Поколение;
			Состояние.СтатусСверки = "Завершена";
			Состояние.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область Монитор

// Узлы обмена с состоянием для монитора.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Узел, ОбменВключен, ДатаЗагрузки, Результат, ТекстОшибки, Отправлено, Принято, Отложено.
//
Функция УзлыМонитора() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Узлы.Ссылка КАК Узел,
	|	Узлы.ОбменВключен КАК ОбменВключен,
	|	ЕСТЬNULL(Состояния.ДатаЗагрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗагрузки,
	|	ЕСТЬNULL(Состояния.РезультатЗагрузки, """") КАК Результат,
	|	ЕСТЬNULL(Состояния.ТекстОшибки, """") КАК ТекстОшибки,
	|	ЕСТЬNULL(Состояния.ОтправленоОбъектов, 0) КАК Отправлено,
	|	ЕСТЬNULL(Состояния.ПринятоОбъектов, 0) КАК Принято,
	|	ЕСТЬNULL(Состояния.ОтложеноОбъектов, 0) КАК Отложено
	|ИЗ
	|	ПланОбмена.ОбменМеждуБазами КАК Узлы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеОбменаМеждуБазами КАК Состояния
	|		ПО Узлы.Ссылка = Состояния.Узел
	|ГДЕ
	|	Узлы.Ссылка <> &ЭтотУзел
	|	И НЕ Узлы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Узлы.Наименование");
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.ОбменМеждуБазами.ЭтотУзел());
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Отложенные объекты узла для монитора.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ТипОбъекта, ВнешнийИд, Статус, ТекстОшибки, ДатаПопытки.
//
Функция ОтложенныеМонитора(Узел) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Отложенные.ТипОбъекта КАК ТипОбъекта,
	|	Отложенные.ВнешнийИд КАК ВнешнийИд,
	|	Отложенные.Статус КАК Статус,
	|	Отложенные.ТекстОшибки КАК ТекстОшибки,
	|	Отложенные.ДатаПопытки КАК ДатаПопытки
	|ИЗ
	|	РегистрСведений.ВходящиеОбъектыОбмена КАК Отложенные
	|ГДЕ
	|	Отложенные.Узел = &Узел
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПопытки УБЫВ");
	Запрос.УстановитьПараметр("Узел", Узел);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Несопоставленные единицы и товары партнёра из отложенных объектов узла (для таблиц сопоставления монитора).
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  Структура - Единицы (Массив из Структура: Ид, Наименование, Код, СвояЕдиница), Товары (Массив из Структура:
//              Ид, Наименование, Артикул, ЭтоТовар).
//
Функция НесопоставленныеОбъекты(Узел) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Результат = Новый Структура("Единицы, Товары", Новый Массив, Новый Массив);
	Учтенные = Новый Соответствие;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Отложенные.Данные КАК Данные
	|ИЗ
	|	РегистрСведений.ВходящиеОбъектыОбмена КАК Отложенные
	|ГДЕ
	|	Отложенные.Узел = &Узел");
	Запрос.УстановитьПараметр("Узел", Узел);
	Для Каждого Отложенный Из Запрос.Выполнить().Выгрузить() Цикл
		Данные = Отложенный.Данные.Получить();
		Для Каждого ИмяТаблицы Из СтрРазделить("Строки,Услуги,Цены", ",") Цикл
			Если Не Данные.Свойство(ИмяТаблицы) Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ДанныеСтроки Из Данные[ИмяТаблицы] Цикл
				ДобавитьНесопоставленное(Узел, ДанныеСтроки.Номенклатура, ИмяТаблицы <> "Услуги", Результат, Учтенные);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

