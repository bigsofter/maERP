Процедура ЗарегистрироватьНаУзел(Узел, Ссылка, ТипОбъекта, Ид, Состояние)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.СоответствияОбъектовОбмена");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	УстановитьКлючСоответствия(Элемент, Узел, ТипОбъекта, Ид, НаправлениеИсходящий());
	Блокировка.Заблокировать();
	Менеджер = РегистрыСведений.СоответствияОбъектовОбмена.СоздатьМенеджерЗаписи();
	Менеджер.Узел = Узел;
	Менеджер.ТипОбъекта = ТипОбъекта;
	Менеджер.ВнешнийИд = Ид;
	Менеджер.Направление = НаправлениеИсходящий();
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Тогда
		Менеджер.Узел = Узел;
		Менеджер.ТипОбъекта = ТипОбъекта;
		Менеджер.ВнешнийИд = Ид;
		Менеджер.Направление = НаправлениеИсходящий();
		Менеджер.ТипОбъектаБазы = Ссылка.Метаданные().ПолноеИмя();
		Менеджер.ИдОбъектаБазы = Ид;
	КонецЕсли;
	Менеджер.Ревизия = Менеджер.Ревизия + 1;
	Менеджер.СостояниеИсточника = Состояние;
	Менеджер.СлишкомВелика = Ложь;
	Менеджер.Записать();
	ПланыОбмена.ЗарегистрироватьИзменения(Узел, Ссылка);
	УвеличитьПоколениеСобытий(Узел);
КонецПроцедуры

Процедура УвеличитьПоколениеСобытий(Узел)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.СостояниеОбменаМеждуБазами");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Узел", Узел);
	Блокировка.Заблокировать();
	Менеджер = МенеджерСостояния(Узел);
	Менеджер.ПоколениеСобытий = Менеджер.ПоколениеСобытий + 1;
	Менеджер.Записать();
КонецПроцедуры

Функция УзлыОтправки(ТипОбъекта, Ид)
	// Узлы, которым документ уже отправлялся (есть исходящая запись).
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Соответствия.Узел КАК Узел
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовОбмена КАК Соответствия
	|ГДЕ
	|	Соответствия.ТипОбъекта = &ТипОбъекта
	|	И Соответствия.ВнешнийИд = &Ид
	|	И Соответствия.Направление = &Направление");
	Запрос.УстановитьПараметр("ТипОбъекта", ТипОбъекта);
	Запрос.УстановитьПараметр("Ид", Ид);
	Запрос.УстановитьПараметр("Направление", НаправлениеИсходящий());
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Узел");
КонецФункции

Функция ОбъединениеУзлов(Первые, Вторые)
	Результат = Новый Массив;
	Для Каждого Узел Из Первые Цикл
		Результат.Добавить(Узел);
	КонецЦикла;
	Для Каждого Узел Из Вторые Цикл
		Если Результат.Найти(Узел) = Неопределено Тогда
			Результат.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция УчаствуетВОбмене(Объект)
	Возврат УзлыДокумента(Объект).Количество() > 0
		Или УзлыОтправки(ТипОбъектаОбмена(Объект.Ссылка), Строка(Объект.Ссылка.УникальныйИдентификатор())).Количество() > 0;
КонецФункции

Функция ТаблицаИзменена(Таблица, Сохраненная, Колонки)
	Если Таблица.Количество() <> Сохраненная.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	ИменаКолонок = СтрРазделить(Колонки, ", ", Ложь);
	Для Индекс = 0 По Таблица.Количество() - 1 Цикл
		Для Каждого Колонка Из ИменаКолонок Цикл
			Если Таблица[Индекс][Колонка] <> Сохраненная[Индекс][Колонка] Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ДатаНачалаОбмена(Узел)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ДатаНачалаОбмена");
КонецФункции

#КонецОбласти

#Область Соответствия

Процедура УстановитьКлючСоответствия(Элемент, Узел, ТипОбъекта, Ид, Направление)
	Элемент.УстановитьЗначение("Узел", Узел);
	Элемент.УстановитьЗначение("ТипОбъекта", ТипОбъекта);
	Элемент.УстановитьЗначение("ВнешнийИд", Ид);
	Элемент.УстановитьЗначение("Направление", Направление);
КонецПроцедуры

// Запись соответствия (менеджер записи); не прочитана - пустые ресурсы с ключом.
//
// Параметры:
//  Узел        - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  ТипОбъекта  - Строка - тип объекта обмена.
//  Ид          - Строка - идентификатор (у партнёра или свой).
//  Направление - Строка - «Входящий», «Исходящий».
//
// Возвращаемое значение:
//  РегистрСведенийМенеджерЗаписи.СоответствияОбъектовОбмена - запись.
//
Функция Соответствие(Узел, ТипОбъекта, Ид, Направление) Экспорт
	Менеджер = РегистрыСведений.СоответствияОбъектовОбмена.СоздатьМенеджерЗаписи();
	Менеджер.Узел = Узел;
	Менеджер.ТипОбъекта = ТипОбъекта;
	Менеджер.ВнешнийИд = Ид;
	Менеджер.Направление = Направление;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Тогда
		Менеджер.Узел = Узел;
		Менеджер.ТипОбъекта = ТипОбъекта;
		Менеджер.ВнешнийИд = Ид;
		Менеджер.Направление = Направление;
	КонецЕсли;
	Возврат Менеджер;
КонецФункции

// Документ создан обменом (есть входящее соответствие с признаком).
//
// Параметры:
//  Ссылка - ДокументСсылка - документ.
//
// Возвращаемое значение:
//  Булево
//
Функция СозданОбменом(Ссылка) Экспорт
	Если Ссылка.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьЗапись
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовОбмена КАК Соответствия
	|ГДЕ
	|	Соответствия.ИдОбъектаБазы = &Ид
	|	И Соответствия.Направление = &Направление
	|	И Соответствия.СозданОбменом");
	Запрос.УстановитьПараметр("Ид", Строка(Ссылка.УникальныйИдентификатор()));
	Запрос.УстановитьПараметр("Направление", НаправлениеВходящий());
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// По виду цены партнёра в узле уже загружены установки цен (входящие соответствия с этим видом).
//
// Параметры:
//  Узел                - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  ИдВидаЦеныПартнера  - Строка - идентификатор вида цены у партнёра.
//
// Возвращаемое значение:
//  Булево
//
Функция ВидЦеныПартнераИспользован(Узел, ИдВидаЦеныПартнера) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьЗапись
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовОбмена КАК Соответствия
	|ГДЕ
	|	Соответствия.Узел = &Узел
	|	И Соответствия.ТипОбъекта = &ТипОбъекта
	|	И Соответствия.Направление = &Направление
	|	И Соответствия.ИдВидаЦеныПартнера = &Ид");
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("ТипОбъекта", ТипУстановкаЦен());
	Запрос.УстановитьПараметр("Направление", НаправлениеВходящий());
	Запрос.УстановитьПараметр("Ид", ИдВидаЦеныПартнера);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Краткий текст ошибки для пользователя и отложенных объектов.
//
// Параметры:
//  Информация - ИнформацияОбОшибке - ошибка.
//
// Возвращаемое значение:
//  Строка - краткое представление.
//
Функция ТекстОшибки(Информация) Экспорт
	// BSLLS:DeprecatedMethodCall-off
	Возврат КраткоеПредставлениеОшибки(Информация);
	// BSLLS:DeprecatedMethodCall-on
КонецФункции

Функция ЗаписьОбменом(Объект) Экспорт
	Возврат Объект.ДополнительныеСвойства.Свойство("ЗаписьОбменом");
КонецФункции

Функция ТипОбъектаОбмена(Ссылка) Экспорт
	Возврат ?(ТипЗнч(Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг"), ТипРеализация(), ТипУстановкаЦен());
КонецФункции

Функция СсылкаДокумента(ТипОбъекта, Ид) Экспорт
	Идентификатор = Новый УникальныйИдентификатор(Ид);
	Если ТипОбъекта = ТипРеализация() Тогда
		Возврат Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Идентификатор);
	КонецЕсли;
	Возврат Документы.УстановкаЦенНоменклатуры.ПолучитьСсылку(Идентификатор);
КонецФункции

