// Менеджер записи состояния узла (прочитанный или новый с узлом).
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//
// Возвращаемое значение:
//  РегистрСведенийМенеджерЗаписи.СостояниеОбменаМеждуБазами - запись.
//
Функция МенеджерСостояния(Узел) Экспорт
	Менеджер = РегистрыСведений.СостояниеОбменаМеждуБазами.СоздатьМенеджерЗаписи();
	Менеджер.Узел = Узел;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Тогда
		Менеджер.Узел = Узел;
	КонецЕсли;
	Возврат Менеджер;
КонецФункции

#КонецОбласти

#Область ДанныеДокумента

Процедура ЗаполнитьДанныеДокумента(Данные, Объект)
	Данные.Вставить("Номер", Объект.Номер);
	Данные.Вставить("Дата", Объект.Дата);
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ЗаполнитьДанныеРеализации(Данные, Объект);
	Иначе
		ЗаполнитьДанныеЦен(Данные, Объект);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьДанныеРеализации(Данные, Объект)
	Данные.Вставить("Организация", ДанныеСтороны(Объект.Организация));
	Данные.Вставить("Контрагент", ДанныеСтороны(Объект.Контрагент));
	Валюта = ?(Объект.ВВалюте И ЗначениеЗаполнено(Объект.Валюта), Объект.Валюта, РаботаСВалютами.ОсновнаяВалюта());
	КодВалюты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Валюта, "Код");
	Данные.Вставить("Валюта", КодВалюты);
	Данные.Вставить("ЦенаВключаетНДС", Объект.ЦенаВключаетНДС);
	Номенклатура = Объект.ТЧТовары.ВыгрузитьКолонку("Номенклатура");
	Для Каждого Строка Из Объект.ТЧУслуги Цикл
		Номенклатура.Добавить(Строка.Номенклатура);
	КонецЦикла;
	Штрихкоды = ШтрихкодыНоменклатуры(Номенклатура);
	Строки = Новый Массив;
	СуммаСНДС = 0;
	СуммаНДС = 0;
	Для Каждого СтрокаТоваров Из Объект.ТЧТовары Цикл
		ДанныеСтроки = ДанныеСтрокиТоваров(СтрокаТоваров, Объект.ЦенаВключаетНДС, Штрихкоды);
		Строки.Добавить(ДанныеСтроки);
		СуммаСНДС = СуммаСНДС + СтрокаТоваров.СуммаСНДС;
		СуммаНДС = СуммаНДС + СтрокаТоваров.СуммаНДС;
	КонецЦикла;
	Услуги = Новый Массив;
	Для Каждого СтрокаУслуг Из Объект.ТЧУслуги Цикл
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("Номенклатура", ДанныеНоменклатуры(СтрокаУслуг.Номенклатура, Штрихкоды));
		ДанныеСтроки.Вставить("Количество", СтрокаУслуг.Количество);
		ДанныеСтроки.Вставить("НДС", ДанныеНДС(СтрокаУслуг.СтавкаНДС));
		ДанныеСтроки.Вставить("СуммаИтог", ОкончательнаяСумма(СтрокаУслуг, Объект.ЦенаВключаетНДС));
		ДанныеСтроки.Вставить("СуммаНДС", СтрокаУслуг.СуммаНДС);
		Услуги.Добавить(ДанныеСтроки);
		СуммаСНДС = СуммаСНДС + СтрокаУслуг.СуммаСНДС;
		СуммаНДС = СуммаНДС + СтрокаУслуг.СуммаНДС;
	КонецЦикла;
	Данные.Вставить("Строки", Строки);
	Данные.Вставить("Услуги", Услуги);
	Данные.Вставить("Итоги", Новый Структура("СуммаСНДС, СуммаНДС", СуммаСНДС, СуммаНДС));
КонецПроцедуры

Функция ДанныеСтрокиТоваров(СтрокаТоваров, ЦенаВключаетНДС, Штрихкоды)
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("Номенклатура", ДанныеНоменклатуры(СтрокаТоваров.Номенклатура, Штрихкоды));
	ДанныеСтроки.Вставить("Характеристика", ДанныеСсылки(СтрокаТоваров.Характеристика));
	ДанныеСтроки.Вставить("Упаковка", ДанныеУпаковки(СтрокаТоваров.Упаковка));
	ДанныеСтроки.Вставить("Количество", СтрокаТоваров.Количество);
	ДанныеСтроки.Вставить("КоличествоУпаковок", СтрокаТоваров.КоличествоУпаковок);
	ДанныеСтроки.Вставить("НДС", ДанныеНДС(СтрокаТоваров.СтавкаНДС));
	ДанныеСтроки.Вставить("СуммаИтог", ОкончательнаяСумма(СтрокаТоваров, ЦенаВключаетНДС));
	ДанныеСтроки.Вставить("СуммаНДС", СтрокаТоваров.СуммаНДС);
	Возврат ДанныеСтроки;
КонецФункции

Процедура ЗаполнитьДанныеЦен(Данные, Объект)
	ВидЦены = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ВидЦены, "Наименование, Валюта, ЦенаВключаетНДС");
	ДанныеВида = Новый Структура;
	ДанныеВида.Вставить("Ид", Строка(Объект.ВидЦены.УникальныйИдентификатор()));
	ДанныеВида.Вставить("Наименование", ВидЦены.Наименование);
	ВалютаВида = ?(ЗначениеЗаполнено(ВидЦены.Валюта), ВидЦены.Валюта, РаботаСВалютами.ОсновнаяВалюта());
	КодВалюты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВалютаВида, "Код");
	ДанныеВида.Вставить("Валюта", КодВалюты);
	ДанныеВида.Вставить("ЦенаВключаетНДС", ВидЦены.ЦенаВключаетНДС);
	Данные.Вставить("ВидЦены", ДанныеВида);
	Штрихкоды = ШтрихкодыНоменклатуры(Объект.ТЧЦены.ВыгрузитьКолонку("Номенклатура"));
	Цены = Новый Массив;
	Для Каждого СтрокаЦен Из Объект.ТЧЦены Цикл
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("Номенклатура", ДанныеНоменклатуры(СтрокаЦен.Номенклатура, Штрихкоды));
		ДанныеСтроки.Вставить("Характеристика", ДанныеСсылки(СтрокаЦен.Характеристика));
		ДанныеСтроки.Вставить("Упаковка", ДанныеУпаковки(СтрокаЦен.Упаковка));
		ДанныеСтроки.Вставить("Цена", СтрокаЦен.Цена);
		Цены.Добавить(ДанныеСтроки);
	КонецЦикла;
	Данные.Вставить("Цены", Цены);
КонецПроцедуры

Функция ОкончательнаяСумма(СтрокаДокумента, ЦенаВключаетНДС)
	// Окончательная сумма строки после скидок: с НДС при цене с НДС, иначе без НДС.
	Возврат ?(ЦенаВключаетНДС, СтрокаДокумента.СуммаСНДС, СтрокаДокумента.СуммаСНДС - СтрокаДокумента.СуммаНДС);
КонецФункции

Функция ДанныеСтороны(Сторона)
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сторона, "ICE, NIF, Наименование");
	Результат = Новый Структура("ICE, NIF", Реквизиты.ICE, Реквизиты.NIF);
	Результат.Вставить("Наименование", Реквизиты.Наименование);
	Возврат Результат;
КонецФункции

Функция ДанныеСсылки(Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Ид, Наименование", Строка(Ссылка.УникальныйИдентификатор()), Строка(Ссылка));
КонецФункции

Функция ДанныеУпаковки(Упаковка)
	Результат = ДанныеСсылки(Упаковка);
	Если Результат <> Неопределено Тогда
		Результат.Вставить("Коэффициент", ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы(Упаковка));
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ДанныеЕдиницы(Единица)
	Результат = ДанныеСсылки(Единица);
	Если Результат <> Неопределено Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Единица, "Код, МеждународноеСокращение");
		Результат.Вставить("Код", Реквизиты.Код);
		Результат.Вставить("МеждународноеСокращение", Реквизиты.МеждународноеСокращение);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ДанныеНоменклатуры(Номенклатура, Штрихкоды)
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Артикул, Наименование, Единица");
	Результат = Новый Структура("Ид, Артикул", Строка(Номенклатура.УникальныйИдентификатор()), Реквизиты.Артикул);
	Результат.Вставить("Наименование", Реквизиты.Наименование);
	Результат.Вставить("Единица", ДанныеЕдиницы(Реквизиты.Единица));
	СвоиШтрихкоды = Новый Массив;
	Для Каждого СтрокаШтрихкода Из Штрихкоды.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура)) Цикл
		УпаковкаИд = ?(ЗначениеЗаполнено(СтрокаШтрихкода.Упаковка),
			Строка(СтрокаШтрихкода.Упаковка.УникальныйИдентификатор()), "");
		ДанныеШтрихкода = Новый Структура("Штрихкод, УпаковкаИд", СтрокаШтрихкода.Штрихкод, УпаковкаИд);
		СвоиШтрихкоды.Добавить(ДанныеШтрихкода);
	КонецЦикла;
	Результат.Вставить("Штрихкоды", СвоиШтрихкоды);
	Возврат Результат;
КонецФункции

Функция ДанныеНДС(СтавкаНДС)
	Если СтавкаНДС = Справочники.СтавкиНДС.SansTVA Тогда
		Возврат Новый Структура("Режим, Процент", "БезНДС", 0);
	КонецЕсли;
	Возврат Новый Структура("Режим, Процент", "Ставка", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтавкаНДС, "Ставка"));
КонецФункции

Функция ШтрихкодыНоменклатуры(Номенклатура)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Штрихкоды.Номенклатура КАК Номенклатура,
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.Упаковка КАК Упаковка
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Номенклатура В (&Номенклатура)");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Индексы.Добавить("Номенклатура");
	Возврат Таблица;
КонецФункции

#КонецОбласти

#Область ПрименениеСлужебное

Функция ПрименитьНовуюРевизию(Узел, Данные, Поколение, Запись, Отложенная)
	// Применение ревизии новее применённой и отложенной (внутри транзакции ПрименитьОбъект).
	Результат = "БезИзменений";
	ВерсияПравил = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ВерсияПравилКонвертации");
	Отпечаток = ОтпечатокРезультата(Узел, Данные);
	Если Не ТотЖеОтпечаток(Запись, Данные, Отпечаток) Тогда
		Если Данные.Тип = ТипРеализация() Тогда
			ПрименитьРеализацию(Узел, Данные, Запись);
		Иначе
			ПрименитьУстановкуЦен(Узел, Данные, Запись);
		КонецЕсли;
		Запись.ОтпечатокСодержимого = Отпечаток;
		Запись.ДанныеПрименения = Новый ХранилищеЗначения(Данные);
		Запись.ВерсияПримененныхПравил = ВерсияПравил;
		Результат = "Применён";
	КонецЕсли;
	Запись.Ревизия = Данные.Ревизия;
	Запись.ПоколениеОбмена = Поколение;
	Запись.СостояниеИсточника = Данные.Состояние;
	Запись.Записать();
	Если Отложенная.Выбран() И Не ПараНовее(Отложенная.ПоколениеОбмена, Отложенная.Ревизия, Поколение,
		Данные.Ревизия) Тогда
		Отложенная.Удалить();
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ЗаблокироватьНастройкиУзла(Узел, Режим) Экспорт
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("ПланОбмена.ОбменМеждуБазами");
	Элемент.Режим = Режим;
	Элемент.УстановитьЗначение("Ссылка", Узел);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ОтложеннаяЗапись(Узел, ТипОбъекта, Ид)
	Менеджер = РегистрыСведений.ВходящиеОбъектыОбмена.СоздатьМенеджерЗаписи();
	Менеджер.Узел = Узел;
	Менеджер.ТипОбъекта = ТипОбъекта;
	Менеджер.ВнешнийИд = Ид;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Тогда
		Менеджер.Узел = Узел;
		Менеджер.ТипОбъекта = ТипОбъекта;
		Менеджер.ВнешнийИд = Ид;
	КонецЕсли;
	Возврат Менеджер;
КонецФункции

// Пара (поколение, ревизия) первая новее второй.
//
// Параметры:
//  Поколение          - Число - поколение первой пары.
//  Ревизия            - Число - ревизия первой пары.
//  ПоколениеСравнения - Число - поколение второй пары.
//  РевизияСравнения   - Число - ревизия второй пары.
//
// Возвращаемое значение:
//  Булево
//
Функция ПараНовее(Поколение, Ревизия, ПоколениеСравнения, РевизияСравнения) Экспорт
	Возврат Поколение > ПоколениеСравнения Или Поколение = ПоколениеСравнения И Ревизия > РевизияСравнения;
КонецФункции

// Отпечаток результата конвертации: нормализованные шапка и строки документа-приёмника, полученные текущими
// правилами и справочниками во временном объекте (не записывается); не «Проведен» - отпечаток состояния. Изменение
// локальной зависимости (упаковка, единица, вид цен) меняет отпечаток.
//
// Параметры:
//  Узел   - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  Данные - Структура - объект сообщения.
//
// Возвращаемое значение:
//  Строка - SHA-256 в hex.
//
Функция ОтпечатокРезультата(Узел, Данные) Экспорт
	Если Данные.Состояние <> СостояниеПроведен() Тогда
		Возврат ХешСтроки(Данные.Состояние);
	КонецЕсли;
	Если Данные.Тип = ТипРеализация() Тогда
		Временный = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		ЗаполнитьПоступление(Временный, Данные, Узел, НастройкиПриема(Узел));
		Шапка = "Организация, Контрагент, Договор, МестоХранения, ОтветственныйЗаПриемку, НомерВходящегоДокумента,"
			+ " ДатаВходящегоДокумента, ЦенаВключаетНДС, Валюта, ВВалюте";
		Таблицы = Новый Структура;
		Таблицы.Вставить("ТЧТовары", "Номенклатура, Характеристика, Упаковка, Количество, КоличествоУпаковок, Цена,"
			+ " СтавкаНДС, Сумма, СуммаНДС, СуммаСНДС");
		Таблицы.Вставить("ТЧУслуги", "Номенклатура, Количество, Цена, СтавкаНДС, Сумма, СуммаНДС, СуммаСНДС");
	Иначе
		Временный = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		ЗаполнитьУстановкуЦен(Временный, Данные, Узел, Новый Структура("ИдВидаЦеныПартнера"));
		Шапка = "Дата, ВидЦены, ХозяйственнаяОперация";
		Таблицы = Новый Структура("ТЧЦены", "Номенклатура, Характеристика, Упаковка, Цена");
	КонецЕсли;
	Возврат ХешСтроки(ВСтрокуJSON(НормализованныйДокумент(Временный, Шапка, Таблицы)));
КонецФункции

Функция НормализованныйДокумент(Объект, Шапка, Таблицы)
	Результат = Новый Структура;
	Для Каждого Поле Из СтрРазделить(Шапка, ", ", Ложь) Цикл
		Результат.Вставить(Поле, ПримитивноеЗначение(Объект[Поле]));
	КонецЦикла;
	Для Каждого КлючИЗначение Из Таблицы Цикл
		Строки = Новый Массив;
		Колонки = СтрРазделить(КлючИЗначение.Значение, ", ", Ложь);
		Для Каждого СтрокаДокумента Из Объект[КлючИЗначение.Ключ] Цикл
			ДанныеСтроки = Новый Структура;
			Для Каждого Колонка Из Колонки Цикл
				ДанныеСтроки.Вставить(Колонка, ПримитивноеЗначение(СтрокаДокумента[Колонка]));
			КонецЦикла;
			Строки.Добавить(ДанныеСтроки);
		КонецЦикла;
		Результат.Вставить(КлючИЗначение.Ключ, Строки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПримитивноеЗначение(Значение)
	Примитивные = Новый ОписаниеТипов("Число, Строка, Булево, Дата");
	Если Примитивные.СодержитТип(ТипЗнч(Значение)) Тогда
		Возврат Значение;
	КонецЕсли;
	// Ссылка - уникальный идентификатор, значение перечисления - имя значения.
	Возврат ?(ЗначениеЗаполнено(Значение), XMLСтрока(Значение), "");
КонецФункции

Функция НастройкиПриема(Узел)
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Узел,
		"ПриниматьРеализации, Организация, Контрагент, МестоХранения, ОтветственныйЗаПриемку, ПроводитьПоступление");
КонецФункции

Функция ТотЖеОтпечаток(Запись, Данные, Отпечаток)
	Если Запись.ОтпечатокСодержимого <> Отпечаток Или Запись.СостояниеИсточника <> Данные.Состояние Тогда
		Возврат Ложь;
	КонецЕсли;
	// Документ-приёмник должен существовать: удалённый восстанавливается веткой применения.
	Если Не ЗначениеЗаполнено(Запись.ИдОбъектаБазы) Тогда
		Возврат Данные.Состояние <> СостояниеПроведен();
	КонецЕсли;
	Возврат ДокументПриемника(Запись).ПолучитьОбъект() <> Неопределено;
КонецФункции

Функция ДокументПриемника(Запись)
	Идентификатор = Новый УникальныйИдентификатор(Запись.ИдОбъектаБазы);
	Если Запись.ТипОбъекта = ТипРеализация() Тогда
		Возврат Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Идентификатор);
	КонецЕсли;
	Возврат Документы.УстановкаЦенНоменклатуры.ПолучитьСсылку(Идентификатор);
КонецФункции

Функция ОбщаяДатаЗапрета(Организация)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(Даты.ДатаЗапрета), ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗапрета
	|ИЗ
	|	РегистрСведений.ДатыЗапретаРедактирования КАК Даты
	|ГДЕ
	|	Даты.Организация В (&Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|	И НЕ Даты.ВидЗапрета В (&Пользовательские)");
	Пользовательские = Новый Массив;
	Пользовательские.Добавить(ПланыВидовХарактеристик.ВидыЗапретаРедактирования.ПоПользователю);
	Пользовательские.Добавить(ПланыВидовХарактеристик.ВидыЗапретаРедактирования.ПоРоли);
	Пользовательские.Добавить(ПланыВидовХарактеристик.ВидыЗапретаРедактирования.ПоГруппеПользователей);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Пользовательские", Пользовательские);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.ДатаЗапрета;
КонецФункции

Процедура ПроверитьПериод(Организация, Даты, Узел)
	Если Не ПериодОткрытДляОбмена(Организация, Даты, Узел) Тогда
		ВызватьИсключение НСтр("ru = 'Закрытый период: документ не изменён обменом';
			|fr = 'Période close : document non modifié par l''échange';
			|en = 'Closed period: the document was not changed by the exchange';
			|es = 'Período cerrado: el intercambio no modificó el documento'");
	КонецЕсли;
КонецПроцедуры

#Область Поступление

Процедура ПрименитьРеализацию(Узел, Данные, Запись)
	Настройки = НастройкиПриема(Узел);
	Если Не Настройки.ПриниматьРеализации Тогда
		ВызватьИсключение НСтр("ru = 'Узел не принимает реализации'; fr = 'Le nœud ne reçoit pas les ventes';
			|en = 'The node does not receive sales'; es = 'El nodo no recibe ventas'");
	КонецЕсли;
	Объект = ОбъектПриемника(Запись, Документы.ПоступлениеТоваровУслуг);
	Если Объект = Неопределено И Данные.Состояние <> СостояниеПроведен() Тогда
		// Непроведённого, отозванного или удалённого у покупателя ещё нет - только соответствие.
		Возврат;
	КонецЕсли;
	Если Объект <> Неопределено Тогда
		ЗаблокироватьПоступление(Объект.Ссылка);
		Если Объект.Проведен Тогда
			ВызватьИсключение НСтр(
				"ru = 'Поступление уже принято (проведено) - изменение реализации не применено. Отмените проведение поступления и повторите';
				|fr = 'La réception est déjà acceptée (validée) - la modification n''est pas appliquée. Annulez la validation et réessayez';
				|en = 'The goods receipt is already accepted (posted) - the change was not applied. Unpost the receipt and retry';
				|es = 'La recepción ya está aceptada (contabilizada) - el cambio no se aplicó. Anule la contabilización y reintente'");
		КонецЕсли;
		ПроверитьПериод(Объект.Организация, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Дата), Узел);
	КонецЕсли;
	Если Данные.Состояние <> СостояниеПроведен() Тогда
		Объект.ДополнительныеСвойства.Вставить("ЗаписьОбменом", Узел);
		Объект.УстановитьПометкуУдаления(Истина);
		Возврат;
	КонецЕсли;
	Если Объект = Неопределено Тогда
		Объект = НовыйДокументПриемника(Запись, Документы.ПоступлениеТоваровУслуг);
	КонецЕсли;
	ЗаполнитьПоступление(Объект, Данные, Узел, Настройки);
	ПроверитьПериод(Объект.Организация, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Дата), Узел);
	Объект.ДополнительныеСвойства.Вставить("ЗаписьОбменом", Узел);
	Объект.ПометкаУдаления = Ложь;
	Если ПроводитьСразу(Объект, Настройки) Тогда
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	Запись.ТипОбъектаБазы = Объект.Метаданные().ПолноеИмя();
	Запись.ИдОбъектаБазы = Строка(Объект.Ссылка.УникальныйИдентификатор());
КонецПроцедуры

Функция ПроводитьСразу(Объект, Настройки)
	Возврат Настройки.ПроводитьПоступление И Объект.ТЧУслуги.Количество() = 0
		И Справочники.МестаХранения.ОрдерныйСклад(Объект.МестоХранения, Объект.Дата);
КонецФункции

Процедура ЗаблокироватьПоступление(Ссылка)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Документ.ПоступлениеТоваровУслуг");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ОбъектПриемника(Запись, МенеджерДокументов)
	// Объект документа-приёмника по соответствию; нет соответствия или документ удалён - Неопределено (удалённый,
	// созданный вручную сопоставлением, - исключение).
	Если Не ЗначениеЗаполнено(Запись.ИдОбъектаБазы) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект = МенеджерДокументов.ПолучитьСсылку(Новый УникальныйИдентификатор(Запись.ИдОбъектаБазы)).ПолучитьОбъект();
	Если Объект = Неопределено И Не Запись.СозданОбменом Тогда
		ВызватьИсключение НСтр("ru = 'Сопоставленный документ удалён - сопоставьте заново';
			|fr = 'Le document associé a été supprimé - associez-le à nouveau';
			|en = 'The mapped document was deleted - map it again'; es = 'El documento asociado se eliminó: vuelva a asociarlo'");
	КонецЕсли;
	Возврат Объект;
КонецФункции

Функция НовыйДокументПриемника(Запись, МенеджерДокументов)
	// Новый документ-приёмник: удалённый, созданный обменом, восстанавливается с тем же uuid.
	Объект = МенеджерДокументов.СоздатьДокумент();
	Если ЗначениеЗаполнено(Запись.ИдОбъектаБазы) Тогда
		Идентификатор = Новый УникальныйИдентификатор(Запись.ИдОбъектаБазы);
	Иначе
		Идентификатор = Новый УникальныйИдентификатор;
	КонецЕсли;
	Объект.УстановитьСсылкуНового(МенеджерДокументов.ПолучитьСсылку(Идентификатор));
	Объект.Заполнить(Неопределено);
	Запись.СозданОбменом = Истина;
	Запись.ИдОбъектаБазы = Строка(Идентификатор);
	Возврат Объект;
КонецФункции

Процедура ЗаполнитьПоступление(Объект, Данные, Узел, Настройки)
	ОшибкиСтрок = Новый Массив;
	Объект.Дата = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
	Объект.Организация = Настройки.Организация;
	Объект.Контрагент = Настройки.Контрагент;
	Объект.Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(Объект.Контрагент, Объект.Организация, Ложь);
	Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
		ОшибкиСтрок.Добавить(НСтр("ru = 'Нет действующего договора с поставщиком'; fr = 'Aucun contrat fournisseur en vigueur';
			|en = 'No active supplier contract'; es = 'No hay contrato vigente con el proveedor'"));
	КонецЕсли;
	Объект.МестоХранения = Настройки.МестоХранения;
	Объект.ОтветственныйЗаПриемку = Настройки.ОтветственныйЗаПриемку;
	Объект.Ответственный = ПараметрыСеанса.Пользователь;
	Объект.НомерВходящегоДокумента = Данные.Номер;
	Объект.ДатаВходящегоДокумента = Данные.Дата;
	Объект.ЦенаВключаетНДС = Данные.ЦенаВключаетНДС;
	ЗаполнитьВалюту(Объект, Данные.Валюта, ОшибкиСтрок);
	ПроверитьСтороны(Данные, Настройки, ОшибкиСтрок);
	Объект.ТЧТовары.Очистить();
	Объект.ТЧУслуги.Очистить();
	Для Каждого ДанныеСтроки Из Данные.Строки Цикл
		ДобавитьСтрокуТоваров(Объект, ДанныеСтроки, Узел, ОшибкиСтрок);
	КонецЦикла;
	Для Каждого ДанныеСтроки Из Данные.Услуги Цикл
		ДобавитьСтрокуУслуг(Объект, ДанныеСтроки, Узел, ОшибкиСтрок);
	КонецЦикла;
	Если ОшибкиСтрок.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(ОшибкиСтрок, Символы.ПС);
	КонецЕсли;
	ПроверитьИтоги(Объект, Данные);
КонецПроцедуры

Процедура ЗаполнитьВалюту(Объект, КодВалюты, Ошибки)
	Валюта = Справочники.Валюты.НайтиПоКоду(КодВалюты);
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		ТекстОшибкиСтроки = СтрШаблон(НСтр("ru = 'Нет валюты с кодом %1'; fr = 'Aucune devise de code %1';
			|en = 'No currency with code %1'; es = 'No hay moneda con código %1'"), КодВалюты);
		Ошибки.Добавить(ТекстОшибкиСтроки);
		Возврат;
	КонецЕсли;
	// Валюта и курс - до расчёта строк: иначе ПроверитьВалютуДокумента подменит валюту основной.
	Если Валюта = РаботаСВалютами.ОсновнаяВалюта() Тогда
		Объект.ВВалюте = Ложь;
		Объект.Валюта = Валюта;
		Объект.КурсВалюты = 1;
		Возврат;
	КонецЕсли;
	Курс = РаботаСВалютами.КурсВалюты(Валюта, Объект.Дата);
	Если Курс <= 0 Тогда
		ТекстОшибкиСтроки = СтрШаблон(НСтр("ru = 'Не задан курс валюты %1'; fr = 'Le taux de %1 n''est pas défini';
			|en = 'The %1 exchange rate is not set'; es = 'No se ha fijado el tipo de cambio de %1'"), КодВалюты);
		Ошибки.Добавить(ТекстОшибкиСтроки);
		Возврат;
	КонецЕсли;
	Объект.ВВалюте = Истина;
	Объект.Валюта = Валюта;
	Объект.КурсВалюты = Курс;
КонецПроцедуры

Процедура ПроверитьСтороны(Данные, Настройки, Ошибки)
	// ICE/NIF сторон из сообщения сверяются с узлом, если заполнены с обеих сторон.
	Продавец = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройки.Контрагент, "ICE, NIF");
	Покупатель = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройки.Организация, "ICE, NIF");
	Если КлючиРазличаются(Данные.Организация, Продавец) Или КлючиРазличаются(Данные.Контрагент, Покупатель) Тогда
		Ошибки.Добавить(НСтр("ru = 'Реквизиты сторон (ICE/NIF) не совпадают с узлом обмена';
			|fr = 'Les identifiants des parties (ICE/NIF) ne correspondent pas au nœud';
			|en = 'The parties'' identifiers (ICE/NIF) do not match the exchange node';
			|es = 'Los identificadores de las partes (ICE/NIF) no coinciden con el nodo'"));
	КонецЕсли;
КонецПроцедуры

Функция КлючиРазличаются(Сообщение, Свои)
	Для Каждого Ключ Из СтрРазделить("ICE,NIF", ",") Цикл
		Если ЗначениеЗаполнено(Сообщение[Ключ]) И ЗначениеЗаполнено(Свои[Ключ])
			И СокрЛП(Сообщение[Ключ]) <> СокрЛП(Свои[Ключ]) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ДобавитьСтрокуТоваров(Объект, ДанныеСтроки, Узел, Ошибки)
	Сопоставление = СопоставитьПозицию(Узел, ДанныеСтроки);
	Если ЗначениеЗаполнено(Сопоставление.Ошибка) Тогда
		Ошибки.Добавить(Сопоставление.Ошибка);
		Возврат;
	КонецЕсли;
	СтавкаНДС = СтавкаНДСПоДанным(ДанныеСтроки.НДС, Ошибки);
	СтрокаТоваров = Объект.ТЧТовары.Добавить();
	СтрокаТоваров.КодСтроки = Объект.ТЧТовары.Количество();
	СтрокаТоваров.Номенклатура = Сопоставление.Номенклатура;
	СтрокаТоваров.Характеристика = Сопоставление.Характеристика;
	СтрокаТоваров.Упаковка = Сопоставление.Упаковка;
	СтрокаТоваров.Количество = Сопоставление.Количество;
	СтрокаТоваров.КоличествоУпаковок = Сопоставление.КоличествоУпаковок;
	СтрокаТоваров.СтавкаНДС = СтавкаНДС;
	ЗаполнитьСуммыСтроки(СтрокаТоваров, ДанныеСтроки, Объект.ЦенаВключаетНДС, СтрокаТоваров.КоличествоУпаковок);
КонецПроцедуры

Процедура ДобавитьСтрокуУслуг(Объект, ДанныеСтроки, Узел, Ошибки)
	Номенклатура = СопоставитьНоменклатуру(Узел, ДанныеСтроки.Номенклатура, Ложь);
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Ошибки.Добавить(ТекстНеСопоставлено(ДанныеСтроки.Номенклатура));
		Возврат;
	КонецЕсли;
	Коэффициент = КоэффициентЕдиниц(Узел, ДанныеСтроки.Номенклатура.Единица, Номенклатура);
	Если Коэффициент = 0 Тогда
		Ошибки.Добавить(ТекстНетЕдиницы(ДанныеСтроки.Номенклатура));
		Возврат;
	КонецЕсли;
	СтрокаУслуг = Объект.ТЧУслуги.Добавить();
	СтрокаУслуг.Номенклатура = Номенклатура;
	СтрокаУслуг.Содержание = ДанныеСтроки.Номенклатура.Наименование;
	СтрокаУслуг.Количество = ДанныеСтроки.Количество * Коэффициент;
	СтрокаУслуг.СтавкаНДС = СтавкаНДСПоДанным(ДанныеСтроки.НДС, Ошибки);
	ЗаполнитьСуммыСтроки(СтрокаУслуг, ДанныеСтроки, Объект.ЦенаВключаетНДС, СтрокаУслуг.Количество);
КонецПроцедуры

Процедура ЗаполнитьСуммыСтроки(СтрокаДокумента, ДанныеСтроки, ЦенаВключаетНДС, Количество)
	// Суммы - окончательные суммы реализации (скидки продавца уже в них), цена - эффективная.
	СтрокаДокумента.Сумма = ДанныеСтроки.СуммаИтог;
	СтрокаДокумента.СуммаНДС = ДанныеСтроки.СуммаНДС;
	СтрокаДокумента.СуммаСНДС = ДанныеСтроки.СуммаИтог + ?(ЦенаВключаетНДС, 0, ДанныеСтроки.СуммаНДС);
	СтрокаДокумента.Цена = ?(Количество = 0, 0, Окр(ДанныеСтроки.СуммаИтог / Количество, ТочностьЦены()));
КонецПроцедуры

Функция ТочностьЦены()
	// Знаков после запятой в цене строки.
	Возврат 2;
КонецФункции

Процедура ПроверитьИтоги(Объект, Данные)
	СуммаСНДС = Объект.ТЧТовары.Итог("СуммаСНДС") + Объект.ТЧУслуги.Итог("СуммаСНДС");
	СуммаНДС = Объект.ТЧТовары.Итог("СуммаНДС") + Объект.ТЧУслуги.Итог("СуммаНДС");
	Если СуммаСНДС <> Данные.Итоги.СуммаСНДС Или СуммаНДС <> Данные.Итоги.СуммаНДС Тогда
		ВызватьИсключение НСтр("ru = 'Итоги поступления не совпадают с итогами реализации';
			|fr = 'Les totaux de la réception ne correspondent pas à ceux de la vente';
			|en = 'The goods receipt totals do not match the sale totals';
			|es = 'Los totales de la recepción no coinciden con los de la venta'");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область УстановкаЦен

Процедура ПрименитьУстановкуЦен(Узел, Данные, Запись)
	Если Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ПриниматьЦены") Тогда
		ВызватьИсключение НСтр("ru = 'Узел не принимает цены'; fr = 'Le nœud ne reçoit pas les prix';
			|en = 'The node does not receive prices'; es = 'El nodo no recibe precios'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Запись.ИдОбъектаБазы) Тогда
		// Порядок установок одной даты - как у источника: ссылка с uuid источника.
		Запись.ИдОбъектаБазы = Данные.Ид;
		Ссылка = Документы.УстановкаЦенНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.Ид));
		Если Ссылка.ПолучитьОбъект() <> Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'В базе уже есть установка цен с этим идентификатором';
				|fr = 'Un document de prix avec cet identifiant existe déjà';
				|en = 'A price setting with this identifier already exists';
				|es = 'Ya existe una fijación de precios con este identificador'");
		КонецЕсли;
		Запись.СозданОбменом = Истина;
	КонецЕсли;
	Объект = ОбъектПриемника(Запись, Документы.УстановкаЦенНоменклатуры);
	Если Объект <> Неопределено Тогда
		ПроверитьПериод(Справочники.Организации.ПустаяСсылка(), ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Дата), Узел);
	КонецЕсли;
	Если Данные.Состояние <> СостояниеПроведен() Тогда
		Если Объект <> Неопределено Тогда
			Объект.ДополнительныеСвойства.Вставить("ЗаписьОбменом", Узел);
			Если Объект.Проведен Тогда
				Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Если Данные.Состояние <> СостояниеНеПроведен() Тогда
				Объект.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Объект = Неопределено Тогда
		Объект = НовыйДокументПриемника(Запись, Документы.УстановкаЦенНоменклатуры);
	КонецЕсли;
	ЗаполнитьУстановкуЦен(Объект, Данные, Узел, Запись);
	ПроверитьПериод(Справочники.Организации.ПустаяСсылка(), ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Дата), Узел);
	Объект.ДополнительныеСвойства.Вставить("ЗаписьОбменом", Узел);
	Объект.ПометкаУдаления = Ложь;
	Объект.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура ЗаполнитьУстановкуЦен(Объект, Данные, Узел, Запись)
	Ошибки = Новый Массив;
	ВидЦены = ВидЦеныПриема(Узел, Данные.ВидЦены, Ошибки);
	Объект.Дата = Данные.Дата;
	Объект.ВидЦены = ВидЦены;
	Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.УстановкаЦенНоменклатуры;
	Объект.Ответственный = ПараметрыСеанса.Пользователь;
	Объект.ТЧЦены.Очистить();
	Для Каждого ДанныеСтроки Из Данные.Цены Цикл
		Сопоставление = СопоставитьПозицию(Узел, ДанныеСтроки);
		Если ЗначениеЗаполнено(Сопоставление.Ошибка) Тогда
			Ошибки.Добавить(Сопоставление.Ошибка);
			Продолжить;
		КонецЕсли;
		СтрокаЦен = Объект.ТЧЦены.Добавить();
		СтрокаЦен.Номенклатура = Сопоставление.Номенклатура;
		СтрокаЦен.Характеристика = Сопоставление.Характеристика;
		СтрокаЦен.Упаковка = Сопоставление.Упаковка;
		СтрокаЦен.Цена = ?(ЗначениеЗаполнено(Сопоставление.Упаковка), ДанныеСтроки.Цена,
			Окр(ДанныеСтроки.Цена / Сопоставление.КоэффициентИсточника, ТочностьЦены()));
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	Запись.ИдВидаЦеныПартнера = Данные.ВидЦены.Ид;
КонецПроцедуры

Функция ВидЦеныПриема(Узел, ДанныеВида, Ошибки)
	// Вид цен-приёмник - только из таблицы узла; валюта и режим НДС совпадают с видом источника.
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВидыЦен.ВидЦены КАК ВидЦены,
	|	ЕСТЬNULL(Валюты.Код, """") КАК КодВалюты,
	|	Виды.ЦенаВключаетНДС КАК ЦенаВключаетНДС
	|ИЗ
	|	ПланОбмена.ОбменМеждуБазами.ВидыЦенПриема КАК ВидыЦен
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыЦен КАК Виды
	|		ПО ВидыЦен.ВидЦены = Виды.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО Виды.Валюта = Валюты.Ссылка
	|ГДЕ
	|	ВидыЦен.Ссылка = &Узел
	|	И ВидыЦен.ИдВидаЦеныПартнера = &Ид");
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("Ид", ДанныеВида.Ид);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ТекстОшибкиСтроки = СтрШаблон(НСтр("ru = 'Вид цены партнёра «%1» не сопоставлен в узле';
			|fr = 'Le type de prix « %1 » du partenaire n''est pas associé dans le nœud';
			|en = 'The partner price type ""%1"" is not mapped in the node';
			|es = 'El tipo de precio «%1» del socio no está asociado en el nodo'"),
			ДанныеВида.Наименование);
		Ошибки.Добавить(ТекстОшибкиСтроки);
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	КодВалюты = ?(ЗначениеЗаполнено(Выборка.КодВалюты), Выборка.КодВалюты,
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РаботаСВалютами.ОсновнаяВалюта(), "Код"));
	Если КодВалюты <> ДанныеВида.Валюта Или Выборка.ЦенаВключаетНДС <> ДанныеВида.ЦенаВключаетНДС Тогда
		Ошибки.Добавить(НСтр("ru = 'Вид цены приёма отличается валютой или режимом НДС';
			|fr = 'Le type de prix de réception diffère par la devise ou le régime de TVA';
			|en = 'The receiving price type differs in currency or VAT mode';
			|es = 'El tipo de precio de recepción difiere en moneda o régimen de IVA'"));
	КонецЕсли;
	Возврат Выборка.ВидЦены;
КонецФункции

#КонецОбласти

#Область Сопоставление

Функция СопоставитьПозицию(Узел, ДанныеСтроки)
	// Сопоставление строки: номенклатура, характеристика (владелец - текущая номенклатура), единицы и упаковка.
	//
	// Возвращаемое значение:
	//  Структура - Ошибка, Номенклатура, Характеристика, Упаковка, Количество, КоличествоУпаковок, КоэффициентИсточника.
	//
	Результат = Новый Структура("Ошибка, Номенклатура, Характеристика, Упаковка", "");
	Результат.Вставить("Количество", 0);
	Результат.Вставить("КоличествоУпаковок", 0);
	Результат.Вставить("КоэффициентИсточника", 1);
	Номенклатура = СопоставитьНоменклатуру(Узел, ДанныеСтроки.Номенклатура, Истина);
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Результат.Ошибка = ТекстНеСопоставлено(ДанныеСтроки.Номенклатура);
		Возврат Результат;
	КонецЕсли;
	Результат.Номенклатура = Номенклатура;
	Характеристика = СопоставитьХарактеристику(Узел, Номенклатура, ДанныеСтроки.Характеристика);
	Если Характеристика = Неопределено Тогда
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Характеристика «%1» товара «%2» не сопоставлена';
			|fr = 'La caractéristique « %1 » de l''article « %2 » n''est pas associée';
			|en = 'Characteristic ""%1"" of item ""%2"" is not mapped'; es = 'La característica «%1» del artículo «%2» no está asociada'"),
			ДанныеСтроки.Характеристика.Наименование, ДанныеСтроки.Номенклатура.Наименование);
		Возврат Результат;
	КонецЕсли;
	Результат.Характеристика = Характеристика;
	Коэффициент = КоэффициентЕдиниц(Узел, ДанныеСтроки.Номенклатура.Единица, Номенклатура);
	Если Коэффициент = 0 Тогда
		Результат.Ошибка = ТекстНетЕдиницы(ДанныеСтроки.Номенклатура);
		Возврат Результат;
	КонецЕсли;
	ЗаполнитьУпаковку(Результат, Узел, ДанныеСтроки, Коэффициент);
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьУпаковку(Результат, Узел, ДанныеСтроки, Коэффициент)
	// Единые формулы: количество приёмника = количество источника × K; совместимая упаковка - коэффициент источника ×
	// K; без неё - базовая единица приёмника.
	КоэффициентУпаковки = 1;
	Если ДанныеСтроки.Упаковка <> Неопределено Тогда
		КоэффициентУпаковки = ДанныеСтроки.Упаковка.Коэффициент;
		Результат.Упаковка = СопоставитьУпаковку(Узел, Результат.Номенклатура, ДанныеСтроки.Упаковка,
			КоэффициентУпаковки * Коэффициент);
	КонецЕсли;
	Результат.КоэффициентИсточника = КоэффициентУпаковки * Коэффициент;
	Если ДанныеСтроки.Свойство("Количество") Тогда
		Результат.Количество = ДанныеСтроки.Количество * Коэффициент;
		Результат.КоличествоУпаковок = ?(ЗначениеЗаполнено(Результат.Упаковка), ДанныеСтроки.КоличествоУпаковок,
			Результат.Количество);
	КонецЕсли;
КонецПроцедуры

Функция СопоставитьНоменклатуру(Узел, ДанныеНоменклатуры, ЭтоТовар)
	// Номенклатура партнёра: соответствие по Ид → штрихкод (одна позиция) → артикул (ровно одна) → для услуг -
	// точное наименование (одна). Найденное запоминается в соответствиях.
	Запись = Соответствие(Узел, "Номенклатура", ДанныеНоменклатуры.Ид, НаправлениеВходящий());
	Если ЗначениеЗаполнено(Запись.ИдОбъектаБазы) Тогда
		Ссылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Запись.ИдОбъектаБазы));
		// Тип номенклатуры проверяется и у сохранённого соответствия: товар не сопоставляется услуге.
		Возврат ?(ПодходящийТип(Ссылка, ЭтоТовар), Ссылка, Справочники.Номенклатура.ПустаяСсылка());
	КонецЕсли;
	Найдено = НоменклатураПоШтрихкодам(ДанныеНоменклатуры.Штрихкоды);
	Если Не ПодходящийТип(Найдено, ЭтоТовар) Тогда
		Найдено = ЕдинственнаяНоменклатура("Артикул", ДанныеНоменклатуры.Артикул, ЭтоТовар);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Найдено) И Не ЭтоТовар Тогда
		Найдено = ЕдинственнаяНоменклатура("Наименование", ДанныеНоменклатуры.Наименование, ЭтоТовар);
	КонецЕсли;
	Если ЗначениеЗаполнено(Найдено) Тогда
		Запись.ТипОбъектаБазы = "Справочник.Номенклатура";
		Запись.ИдОбъектаБазы = Строка(Найдено.УникальныйИдентификатор());
		Запись.Записать();
	КонецЕсли;
	Возврат Найдено;
КонецФункции

// Номенклатура существует и её тип подходит строке: товарной строке - не услуга, строке услуг - услуга.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - номенклатура.
//  ЭтоТовар     - Булево - строка товаров (Истина) или услуг (Ложь).
//
// Возвращаемое значение:
//  Булево
//
Функция ПодходящийТип(Номенклатура, ЭтоТовар) Экспорт
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ТипНоменклатуры");
	Если ТипНоменклатуры = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ЭтоУслуга = ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
	Возврат ЭтоТовар <> ЭтоУслуга;
КонецФункции

Функция НоменклатураПоШтрихкодам(Штрихкоды)
	Значения = Новый Массив;
	Для Каждого Штрихкод Из Штрихкоды Цикл
		Значения.Добавить(Штрихкод.Штрихкод);
	КонецЦикла;
	Если Значения.Количество() = 0 Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Штрихкоды.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&Штрихкоды)");
	Запрос.УстановитьПараметр("Штрихкоды", Значения);
	Найдено = Запрос.Выполнить().Выгрузить();
	Возврат ?(Найдено.Количество() = 1, Найдено[0].Номенклатура, Справочники.Номенклатура.ПустаяСсылка());
КонецФункции

Функция ЕдинственнаяНоменклатура(Реквизит, Значение, ЭтоТовар)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.&Реквизит = &Значение
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И Номенклатура.ТипНоменклатуры &Сравнение ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Реквизит", Реквизит);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Сравнение", ?(ЭтоТовар, "<>", "="));
	Запрос.УстановитьПараметр("Значение", Значение);
	Найдено = Запрос.Выполнить().Выгрузить();
	Возврат ?(Найдено.Количество() = 1, Найдено[0].Ссылка, Справочники.Номенклатура.ПустаяСсылка());
КонецФункции

Функция СопоставитьХарактеристику(Узел, Номенклатура, ДанныеХарактеристики)
	// Характеристика: пустая - пустая; соответствие проверяется на владельца (текущую номенклатуру); иначе - по
	// наименованию у текущей номенклатуры (единственная). Не найдена - Неопределено.
	Если ДанныеХарактеристики = Неопределено Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	Запись = Соответствие(Узел, "Характеристика", ДанныеХарактеристики.Ид, НаправлениеВходящий());
	Если ЗначениеЗаполнено(Запись.ИдОбъектаБазы) Тогда
		Ссылка = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Запись.ИдОбъектаБазы));
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Владелец") = Номенклатура Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2
	|	Характеристики.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК Характеристики
	|ГДЕ
	|	Характеристики.Владелец = &Номенклатура
	|	И Характеристики.Наименование = &Наименование
	|	И НЕ Характеристики.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Наименование", ДанныеХарактеристики.Наименование);
	Найдено = Запрос.Выполнить().Выгрузить();
	Если Найдено.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запись.ТипОбъектаБазы = "Справочник.ХарактеристикиНоменклатуры";
	Запись.ИдОбъектаБазы = Строка(Найдено[0].Ссылка.УникальныйИдентификатор());
	Запись.Записать();
	Возврат Найдено[0].Ссылка;
КонецФункции

// Коэффициент перевода единиц: пара (единица источника, базовая единица номенклатуры приёмника), подтверждённая
// администратором; нет - 0.
//
// Параметры:
//  Узел          - ПланОбменаСсылка.ОбменМеждуБазами - узел.
//  ДанныеЕдиницы - Структура, Неопределено - единица источника из сообщения (Ид).
//  Номенклатура  - СправочникСсылка.Номенклатура - номенклатура приёмника.
//
// Возвращаемое значение:
//  Число - коэффициент; 0 - не сопоставлено.
//
Функция КоэффициентЕдиниц(Узел, ДанныеЕдиницы, Номенклатура) Экспорт
	Если ДанныеЕдиницы = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Менеджер = РегистрыСведений.СопоставлениеЕдиницОбмена.СоздатьМенеджерЗаписи();
	Менеджер.Узел = Узел;
	Менеджер.ИдЕдиницыИсточника = ДанныеЕдиницы.Ид;
	Менеджер.ЕдиницаПриемника = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Единица");
	Менеджер.Прочитать();
	Возврат ?(Менеджер.Выбран(), Менеджер.Коэффициент, 0);
КонецФункции

Функция СопоставитьУпаковку(Узел, Номенклатура, ДанныеУпаковки, НужныйКоэффициент)
	// Упаковка: соответствие по Ид или наименование - только допустимая для номенклатуры (владелец - набор упаковок
	// номенклатуры) и с совместимым коэффициентом; нет - пустая (базовая единица).
	Набор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "НаборУпаковок");
	Пустая = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	Если Не ЗначениеЗаполнено(Набор) Тогда
		Возврат Пустая;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Упаковки.Ссылка КАК Ссылка,
	|	Упаковки.Наименование КАК Наименование
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК Упаковки
	|ГДЕ
	|	Упаковки.Владелец = &Набор
	|	И НЕ Упаковки.ПометкаУдаления");
	Запрос.УстановитьПараметр("Набор", Набор);
	Запись = Соответствие(Узел, "Упаковка", ДанныеУпаковки.Ид, НаправлениеВходящий());
	Для Каждого Кандидат Из Запрос.Выполнить().Выгрузить() Цикл
		ПоСоответствию = Строка(Кандидат.Ссылка.УникальныйИдентификатор()) = Запись.ИдОбъектаБазы;
		Если (ПоСоответствию Или Кандидат.Наименование = ДанныеУпаковки.Наименование)
			И ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы(Кандидат.Ссылка) = НужныйКоэффициент Тогда
			Возврат Кандидат.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Пустая;
КонецФункции

Функция СтавкаНДСПоДанным(ДанныеНДС, Ошибки)
	Если ДанныеНДС.Режим = "БезНДС" Тогда
		Возврат Справочники.СтавкиНДС.SansTVA;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2
	|	Ставки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтавкиНДС КАК Ставки
	|ГДЕ
	|	Ставки.Ставка = &Процент
	|	И Ставки.Ссылка <> ЗНАЧЕНИЕ(Справочник.СтавкиНДС.SansTVA)
	|	И НЕ Ставки.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка");
	Запрос.УстановитьПараметр("Процент", ДанныеНДС.Процент);
	Найдено = Запрос.Выполнить().Выгрузить();
	Если Найдено.Количество() <> 1 Тогда
		ТекстОшибкиСтроки = СтрШаблон(НСтр("ru = 'Ставка НДС %1%% не найдена или не однозначна';
			|fr = 'Taux de TVA %1 %% introuvable ou ambigu';
			|en = 'VAT rate %1%% not found or ambiguous'; es = 'Tipo de IVA %1 %% no encontrado o ambiguo'"), ДанныеНДС.Процент);
		Ошибки.Добавить(ТекстОшибкиСтроки);
		Возврат Справочники.СтавкиНДС.ПустаяСсылка();
	КонецЕсли;
	Возврат Найдено[0].Ссылка;
КонецФункции

Функция ТекстНеСопоставлено(ДанныеНоменклатуры)
	Возврат СтрШаблон(НСтр("ru = 'Не сопоставлен товар «%1» (артикул %2)'; fr = 'Article « %1 » non associé (réf. %2)';
		|en = 'Item ""%1"" is not mapped (code %2)'; es = 'Artículo «%1» no asociado (ref. %2)'"),
		ДанныеНоменклатуры.Наименование, ДанныеНоменклатуры.Артикул);
КонецФункции

Функция ТекстНетЕдиницы(ДанныеНоменклатуры)
	Единица = ?(ДанныеНоменклатуры.Единица = Неопределено, "", ДанныеНоменклатуры.Единица.Наименование);
	Возврат СтрШаблон(НСтр("ru = 'Сопоставьте единицу «%1» партнёра для товара «%2»';
		|fr = 'Associez l''unité « %1 » du partenaire pour l''article « %2 »';
		|en = 'Map the partner unit ""%1"" for item ""%2""'; es = 'Asocie la unidad «%1» del socio para el artículo «%2»'"),
		Единица, ДанныеНоменклатуры.Наименование);
КонецФункции

#КонецОбласти

#Область Сериализация

Функция ВСтрокуJSON(Значение) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	ЗаписатьJSON(Запись, Значение, Настройки);
	Возврат Запись.Закрыть();
КонецФункции

Функция ИзСтрокиJSON(Текст) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, Ложь, "Дата,ДатаВходящегоДокумента");
	Чтение.Закрыть();
	Возврат Значение;
КонецФункции

Функция ХешСтроки(Текст) Экспорт
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Текст);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СообщенияСлужебное

Функция ЛимитОбъектов()
	Возврат 500;
КонецФункции

Функция ЛимитРазмера()
	// 5 МБ сериализованного тела (в символах).
	// BSLLS:MagicNumber-off
	Возврат 5242880;
	// BSLLS:MagicNumber-on
КонецФункции

Функция ЛимитФайлаСообщения()
	// Входящий файл в байтах: тело в пределах ЛимитРазмера символов, UTF-8 - до 4 байт на символ.
	// BSLLS:MagicNumber-off
	Возврат ЛимитРазмера() * 4;
	// BSLLS:MagicNumber-on
КонецФункции

Функция ЛимитФайлаПодписи()
	// HMAC-SHA256 в hex - 64 символа; запас на перевод строки и BOM.
	// BSLLS:MagicNumber-off
	Возврат 256;
	// BSLLS:MagicNumber-on
КонецФункции

Функция ХешейВОкне()
	Возврат 100;
КонецФункции

Функция СлотИсходящего(Узел)
	Менеджер = РегистрыСведений.ИсходящееСообщениеОбмена.СоздатьМенеджерЗаписи();
	Менеджер.Узел = Узел;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Тогда
		Менеджер.Узел = Узел;
	КонецЕсли;
	Возврат Менеджер;
КонецФункции

Функция НовыйКонверт(Узел, ВидКонверта, Поколение, Состояние)
	Конверт = Новый Структура("Формат, Вид", 1, ВидКонверта);
	Конверт.Вставить("От", СокрЛП(ПланыОбмена.ОбменМеждуБазами.ЭтотУзел().Код));
	Конверт.Вставить("Кому", СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "Код")));
	Конверт.Вставить("Поколение", Поколение);
	Конверт.Вставить("ПринятыйНомер", Состояние.ПринятыйНомер);
	Возврат Конверт;
КонецФункции

Функция ПроверенныйКонверт(Узел, Текст, ВидКонверта)
	// Конверт после проверки: вид, адресация (от - узел, кому - эта база) и поколение пары.
	Конверт = ИзСтрокиJSON(Текст);
	КодУзла = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "Код"));
	Если Конверт.Вид <> ВидКонверта Или Конверт.От <> КодУзла
		Или Конверт.Кому <> СокрЛП(ПланыОбмена.ОбменМеждуБазами.ЭтотУзел().Код) Тогда
		ВызватьИсключение НСтр("ru = 'Сообщение адресовано не этой паре баз'; fr = 'Le message n''est pas adressé à cette paire de bases';
			|en = 'The message is not addressed to this pair of bases'; es = 'El mensaje no está dirigido a este par de bases'");
	КонецЕсли;
	Если Конверт.Поколение <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ПоколениеОбмена") Тогда
		ОстановитьПриОткате(Узел, НСтр("ru = 'Поколение обмена партнёра отличается'; fr = 'La génération d''échange du partenaire diffère';
			|en = 'The partner exchange generation differs'; es = 'La generación de intercambio del socio difiere'"));
	КонецЕсли;
	Возврат Конверт;
КонецФункции

Процедура ОстановитьПриОткате(Узел, Причина)
	// Признак отката одной из баз: обмен узла выключается до восстановления пары, ничего не применяется.
	Текст = СтрШаблон(НСтр("ru = '%1. Вероятно, одна из баз восстановлена из копии: обмен остановлен до восстановления пары';
		|fr = '%1. Une des bases a probablement été restaurée : l''échange est arrêté jusqu''à la restauration de la paire';
		|en = '%1. One of the bases was probably restored from a backup: the exchange is stopped until the pair is restored';
		|es = '%1. Probablemente una de las bases se restauró de una copia: el intercambio se detiene hasta restaurar el par'"),
		Причина);
	Объект = Узел.ПолучитьОбъект();
	Объект.ОбменВключен = Ложь;
	Объект.ДополнительныеСвойства.Вставить("ЗаписьОбменом", Узел);
	Объект.Записать();
	Состояние = МенеджерСостояния(Узел);
	Состояние.Диагностика = Текст;
	Состояние.Записать();
	ВызватьИсключение Текст;
КонецПроцедуры

Функция ЗакрепитьИдентичность(Узел, Номер, Хеш)
	// Закрепление идентичности (номер → хеш) до применения: другой хеш у того же номера - откат; тот же хеш у номера
	// не выше принятого - повтор (Истина).
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.СостояниеОбменаМеждуБазами");
		Элемент.УстановитьЗначение("Узел", Узел);
		Блокировка.Заблокировать();
		Состояние = МенеджерСостояния(Узел);
		Хеши = Состояние.ХешиПринятых.Получить();
		Если ТипЗнч(Хеши) <> Тип("Соответствие") Тогда
			Хеши = Новый Соответствие;
		КонецЕсли;
		Известный = Хеши[Номер];
		Конфликт = Известный <> Неопределено И Известный <> Хеш;
		Повтор = Номер <= Состояние.ПринятыйНомер;
		Если Не Повтор И Не Конфликт Тогда
			Хеши.Вставить(Номер, Хеш);
			Состояние.ХешиПринятых = Новый ХранилищеЗначения(ОкноХешей(Хеши, Номер));
			Состояние.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Конфликт Тогда
		ОстановитьПриОткате(Узел, НСтр("ru = 'Сообщение с тем же номером пришло с другим содержимым';
			|fr = 'Un message de même numéro est arrivé avec un autre contenu';
			|en = 'A message with the same number arrived with different content';
			|es = 'Llegó un mensaje con el mismo número y otro contenido'"));
	КонецЕсли;
	Возврат Повтор;
КонецФункции

Функция ОкноХешей(Хеши, Номер)
	Окно = Новый Соответствие;
	Для Каждого КлючИЗначение Из Хеши Цикл
		Если КлючИЗначение.Ключ > Номер - ХешейВОкне() Тогда
			Окно.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Окно;
КонецФункции

Процедура ЗафиксироватьПринятый(Узел, Номер)
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.СостояниеОбменаМеждуБазами");
		Элемент.УстановитьЗначение("Узел", Узел);
		Блокировка.Заблокировать();
		Состояние = МенеджерСостояния(Узел);
		Если Номер > Состояние.ПринятыйНомер Тогда
			Состояние.ПринятыйНомер = Номер;
			Состояние.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Функция ОбъектыДляОтправки(Узел)
	// Кандидаты к отправке - запросом к таблицам изменений (номера не присваиваются, выбираются только ссылки);
	// снимки строятся по одному до заполнения пакета;
	// лимиты объектов и размера; ревизия, не помещающаяся одна, отмечается «слишком велика» и пропускается.
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Регистрации.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Изменения КАК Регистрации
	|ГДЕ
	|	Регистрации.Узел = &Узел
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Регистрации.Ссылка
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры.Изменения КАК Регистрации
	|ГДЕ
	|	Регистрации.Узел = &Узел
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка");
	Запрос.УстановитьПараметр("Узел", Узел);
	Объекты = Новый Массив;
	Размер = 0;
	Для Каждого Строка Из Запрос.Выполнить().Выгрузить() Цикл
		ТипОбъекта = ТипОбъектаОбмена(Строка.Ссылка);
		Ид = Строка(Строка.Ссылка.УникальныйИдентификатор());
		Если Соответствие(Узел, ТипОбъекта, Ид, НаправлениеИсходящий()).СлишкомВелика Тогда
			Продолжить;
		КонецЕсли;
		Данные = ДанныеОбъекта(Узел, ТипОбъекта, Ид);
		РазмерОбъекта = СтрДлина(ВСтрокуJSON(Данные));
		Если РазмерОбъекта > ЛимитРазмера() Тогда
			ОтметитьСлишкомВелика(Узел, ТипОбъекта, Ид, Данные.Ревизия);
			Продолжить;
		КонецЕсли;
		Если Размер + РазмерОбъекта > ЛимитРазмера() Или Объекты.Количество() >= ЛимитОбъектов() Тогда
			Прервать;
		КонецЕсли;
		Объекты.Добавить(Данные);
		Размер = Размер + РазмерОбъекта;
	КонецЦикла;
	Возврат Объекты;
КонецФункции

Процедура ОтметитьСлишкомВелика(Узел, ТипОбъекта, Ид, Ревизия)
	// Признак относится к измеренной ревизии: документ успели перепровести - новая ревизия отправляется заново.
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.СоответствияОбъектовОбмена");
		УстановитьКлючСоответствия(Элемент, Узел, ТипОбъекта, Ид, НаправлениеИсходящий());
		Блокировка.Заблокировать();
		Запись = Соответствие(Узел, ТипОбъекта, Ид, НаправлениеИсходящий());
		Если Запись.Ревизия = Ревизия Тогда
			Запись.СлишкомВелика = Истина;
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура ЗаписатьЖурналОтправки(Узел, Поколение, Номер, Объекты)
	Для Каждого Данные Из Объекты Цикл
		Строка = РегистрыСведений.ЖурналОтправкиОбмена.СоздатьМенеджерЗаписи();
		Строка.Узел = Узел;
		Строка.ПоколениеОбмена = Поколение;
		Строка.НомерСообщения = Номер;
		Строка.ТипОбъекта = Данные.Тип;
		Строка.ВнешнийИд = Данные.Ид;
		Строка.Ревизия = Данные.Ревизия;
		Строка.Состояние = Данные.Состояние;
		Строка.Записать();
		Запись = Соответствие(Узел, Данные.Тип, Данные.Ид, НаправлениеИсходящий());
		Запись.Отправлен = Истина;
		Запись.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ПодтвердитьОбъект(Узел, Поколение, СтрокаЖурнала)
	// Подтверждение объекта одной транзакцией под блокировкой исходящего ключа: ревизия не менялась - регистрация
	// снимается; подтверждённый отзыв или удаление - «не отправлен»; строка журнала удаляется.
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.СоответствияОбъектовОбмена");
		УстановитьКлючСоответствия(Элемент, Узел, СтрокаЖурнала.ТипОбъекта, СтрокаЖурнала.ВнешнийИд,
			НаправлениеИсходящий());
		Блокировка.Заблокировать();
		Запись = Соответствие(Узел, СтрокаЖурнала.ТипОбъекта, СтрокаЖурнала.ВнешнийИд, НаправлениеИсходящий());
		Если Запись.Ревизия = СтрокаЖурнала.Ревизия Тогда
			Ссылка = СсылкаДокумента(СтрокаЖурнала.ТипОбъекта, СтрокаЖурнала.ВнешнийИд);
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Ссылка);
			Если СтрокаЖурнала.Состояние = СостояниеОтозван() Или СтрокаЖурнала.Состояние = СостояниеУдален() Тогда
				Запись.Отправлен = Ложь;
			КонецЕсли;
		КонецЕсли;
		Запись.ПодтвержденнаяРевизия = Макс(Запись.ПодтвержденнаяРевизия, СтрокаЖурнала.Ревизия);
		Запись.Записать();
		Журнал = РегистрыСведений.ЖурналОтправкиОбмена.СоздатьМенеджерЗаписи();
		Журнал.Узел = Узел;
		Журнал.ПоколениеОбмена = Поколение;
		Журнал.НомерСообщения = СтрокаЖурнала.НомерСообщения;
		Журнал.ТипОбъекта = СтрокаЖурнала.ТипОбъекта;
		Журнал.ВнешнийИд = СтрокаЖурнала.ВнешнийИд;
		Журнал.Удалить();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Функция СеансЖив(НомерСеанса, НачалоСеанса)
	Для Каждого Сеанс Из ПолучитьСеансыИнформационнойБазы() Цикл
		Если Сеанс.НомерСеанса = НомерСеанса И Сеанс.НачалоСеанса = НачалоСеанса Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ЗаписатьРезультат(Узел, Результат, Текст, Итог, ПоколениеСобытий)
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.СостояниеОбменаМеждуБазами");
		Элемент.УстановитьЗначение("Узел", Узел);
		Блокировка.Заблокировать();
		Состояние = МенеджерСостояния(Узел);
		Состояние.ДатаЗагрузки = ТекущаяДатаСеанса();
		Состояние.ДатаВыгрузки = ТекущаяДатаСеанса();
		Состояние.РезультатЗагрузки = Результат;
		Состояние.РезультатВыгрузки = Результат;
		Состояние.ТекстОшибки = Текст;
		Состояние.ОтправленоОбъектов = Итог.Отправлено;
		Состояние.ПринятоОбъектов = Итог.Принято;
		Состояние.ОтложеноОбъектов = Итог.Отложено;
		Если ПоколениеСобытий <> Неопределено Тогда
			Состояние.ПоколениеОбработано = Макс(Состояние.ПоколениеОбработано, ПоколениеСобытий);
		КонецЕсли;
		Состояние.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область Каталог

Процедура ОбменЧерезКаталог(Узел, Токен, Итог)
	// Транспорт «Каталог»: подписанные файлы с неизменяемыми именами (поколение и номер), ACK отдельными файлами.
	Каталог = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "КаталогОбмена"));
	Ключ = ОбменМеждуБазамиПолныеПрава.КлючПодписи(Узел);
	Если ПустаяСтрока(Каталог) Или ПустаяСтрока(Ключ) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан каталог обмена или ключ подписи'; fr = 'Dossier d''échange ou clé de signature non définis';
			|en = 'Exchange folder or signing key not set'; es = 'Carpeta de intercambio o clave de firma no definidas'");
	КонецЕсли;
	Мой = СокрЛП(ПланыОбмена.ОбменМеждуБазами.ЭтотУзел().Код);
	Партнер = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "Код"));
	Поколение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ПоколениеОбмена");
	Для Каждого Файл Из ФайлыПоНомеру(Каталог, "Ack_" + Партнер + "_" + Мой + "_" + Формат(Поколение, "ЧН=0; ЧГ=")) Цикл
		ЗагрузитьПодтверждение(Узел, ПроверенныйТекст(Файл, Ключ));
		УдалитьПару(Файл);
	КонецЦикла;
	Для Каждого Файл Из ФайлыПоНомеру(Каталог, "Message_" + Партнер + "_" + Мой + "_" + Формат(Поколение, "ЧН=0; ЧГ=")) Цикл
		Номер = ЗагрузитьСообщение(Узел, ПроверенныйТекст(Файл, Ключ), Итог);
		ПроверитьТокен(Узел, Токен);
		ОпубликоватьПару(Каталог, ИмяФайла("Ack", Мой, Партнер, Поколение, Номер), ТекстПодтверждения(Узел, Номер), Ключ);
		УдалитьПару(Файл);
	КонецЦикла;
	Текст = ИсходящееСообщение(Узел);
	Если Не ПустаяСтрока(Текст) Тогда
		ПроверитьТокен(Узел, Токен);
		Номер = СлотИсходящего(Узел).НомерСообщения;
		ОпубликоватьПару(Каталог, ИмяФайла("Message", Мой, Партнер, Поколение, Номер), Текст, Ключ);
		Итог.Отправлено = ИзСтрокиJSON(Текст).Объекты.Количество();
	КонецЕсли;
КонецПроцедуры

Функция ИмяФайла(Вид, От, Кому, Поколение, Номер)
	Возврат СтрШаблон("%1_%2_%3_%4_%5", Вид, От, Кому, Формат(Поколение, "ЧН=0; ЧГ="), Формат(Номер, "ЧН=0; ЧГ="));
КонецФункции

Функция ФайлыПоНомеру(Каталог, Префикс)
	// Готовые файлы (.xml) с префиксом по возрастанию номера (последний сегмент имени).
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Файл");
	Для Каждого Файл Из НайтиФайлы(Каталог, Префикс + "_*.xml") Цикл
		Номер = Число(Сред(Файл.ИмяБезРасширения, СтрДлина(Префикс + "_") + 1));
		Строка = Таблица.Добавить();
		Строка.Номер = Номер;
		Строка.Файл = Файл;
	КонецЦикла;
	Таблица.Сортировать("Номер");
	Возврат Таблица.ВыгрузитьКолонку("Файл");
КонецФункции

Функция ПроверенныйТекст(Файл, Ключ)
	// Текст файла после проверки подписи (.sig рядом); нет или не совпала - исключение, файл не трогается.
	// Размеры проверяются до чтения: чужой файл в каталоге не загружается в память целиком.
	ФайлПодписи = Новый Файл(Файл.ПолноеИмя + ".sig");
	Если Не ФайлПодписи.Существует() Или ФайлПодписи.Размер() > ЛимитФайлаПодписи()
		Или Файл.Размер() > ЛимитФайлаСообщения() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Подпись файла %1 не подтверждена'; fr = 'La signature du fichier %1 n''est pas confirmée';
			|en = 'The signature of file %1 is not confirmed'; es = 'La firma del archivo %1 no está confirmada'"), Файл.Имя);
	КонецЕсли;
	Текст = ПрочитатьТекст(Файл.ПолноеИмя);
	Если СокрЛП(ПрочитатьТекст(ФайлПодписи.ПолноеИмя)) <> ПодписьСообщения(Ключ, Текст) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Подпись файла %1 не подтверждена'; fr = 'La signature du fichier %1 n''est pas confirmée';
			|en = 'The signature of file %1 is not confirmed'; es = 'La firma del archivo %1 no está confirmada'"), Файл.Имя);
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ПрочитатьТекст(ПолноеИмя)
	Чтение = Новый ЧтениеТекста(ПолноеИмя, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

Процедура ОпубликоватьПару(Каталог, Имя, Текст, Ключ)
	// Публикация: оба файла во временные имена, сначала .sig, последним .xml (признак готовности).
	Путь = Каталог + ПолучитьРазделительПути() + Имя + ".xml";
	ЗаписатьФайлАтомарно(Путь + ".sig", ПодписьСообщения(Ключ, Текст));
	ЗаписатьФайлАтомарно(Путь, Текст);
КонецПроцедуры

Процедура ЗаписатьФайлАтомарно(Путь, Текст)
	Временный = Путь + ".tmp";
	Запись = Новый ЗаписьТекста(Временный, КодировкаТекста.UTF8, , Ложь);
	Запись.Записать(Текст);
	Запись.Закрыть();
	Существующий = Новый Файл(Путь);
	Если Существующий.Существует() Тогда
		УдалитьФайлы(Путь);
	КонецЕсли;
	ПереместитьФайл(Временный, Путь);
КонецПроцедуры

Процедура УдалитьПару(Файл)
	УдалитьФайлы(Файл.ПолноеИмя);
	Подпись = Новый Файл(Файл.ПолноеИмя + ".sig");
	Если Подпись.Существует() Тогда
		УдалитьФайлы(Файл.ПолноеИмя + ".sig");
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьТокен(Узел, Токен)
	Если МенеджерСостояния(Узел).ТокенВыполнения <> Токен Тогда
		ВызватьИсключение НСтр("ru = 'Захват обмена узла потерян'; fr = 'La prise de l''échange du nœud a été perdue';
			|en = 'The node exchange lock was lost'; es = 'Se perdió la captura del intercambio del nodo'");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Подпись

Функция РазмерБлокаХеша()
	// Размер блока SHA-256 в байтах.
	// BSLLS:MagicNumber-off
	Возврат 64;
	// BSLLS:MagicNumber-on
КонецФункции

Функция БлокКлюча(Ключ, РазмерБлока, Заполнитель)
	Блок = Новый БуферДвоичныхДанных(РазмерБлока);
	Для Индекс = 0 По РазмерБлока - 1 Цикл
		Блок.Установить(Индекс, Заполнитель);
	КонецЦикла;
	Если Ключ.Размер > 0 Тогда
		Блок.ЗаписатьПобитовоеИсключительноеИли(0, Ключ);
	КонецЕсли;
	Возврат Блок;
КонецФункции

Функция ЗаполнительВнутренний()
	// ipad HMAC (RFC 2104): байт 0x36.
	// BSLLS:MagicNumber-off
	Возврат 54;
	// BSLLS:MagicNumber-on
КонецФункции

Функция ЗаполнительВнешний()
	// opad HMAC (RFC 2104): байт 0x5C.
	// BSLLS:MagicNumber-off
	Возврат 92;
	// BSLLS:MagicNumber-on
КонецФункции

Функция ХешДанных(Данные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат Хеширование.ХешСумма;
КонецФункции

#КонецОбласти

#Область КомандыСлужебное

Функция ДлинаКода()
	Возврат 9;
КонецФункции

Процедура УвеличитьВерсиюПравил(Узел)
	Объект = Узел.ПолучитьОбъект();
	Объект.ВерсияПравилКонвертации = Объект.ВерсияПравилКонвертации + 1;
	Объект.ДополнительныеСвойства.Вставить("ЗаписьОбменом", Узел);
	Объект.Записать();
КонецПроцедуры

Функция КандидатыСверки(Узел)
	// Кандидаты сверки: документы по фильтрам узла не раньше границы и документы с исходящими записями узла.
	Настройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Узел,
		"Контрагент, Организация, ВыгружатьРеализации, ВыгружатьЦены, ДатаНачалаОбмена");
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Реализации.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации
	|ГДЕ
	|	&ВыгружатьРеализации
	|	И Реализации.Проведен
	|	И Реализации.Дата >= &ДатаНачала
	|	И Реализации.Контрагент = &Контрагент
	|	И Реализации.Организация = &Организация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Цены.Ссылка
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК Цены
	|ГДЕ
	|	&ВыгружатьЦены
	|	И Цены.Проведен
	|	И Цены.Дата >= &ДатаНачала
	|	И Цены.ВидЦены В
	|			(ВЫБРАТЬ
	|				ВидыЦен.ВидЦены КАК ВидЦены
	|			ИЗ
	|				ПланОбмена.ОбменМеждуБазами.ВидыЦенВыгрузки КАК ВидыЦен
	|			ГДЕ
	|				ВидыЦен.Ссылка = &Узел)");
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("ВыгружатьРеализации", Настройки.ВыгружатьРеализации);
	Запрос.УстановитьПараметр("ВыгружатьЦены", Настройки.ВыгружатьЦены);
	Запрос.УстановитьПараметр("ДатаНачала", Настройки.ДатаНачалаОбмена);
	Запрос.УстановитьПараметр("Контрагент", Настройки.Контрагент);
	Запрос.УстановитьПараметр("Организация", Настройки.Организация);
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Для Каждого Ссылка Из ОтправленныеДокументы(Узел) Цикл
		Если Ссылки.Найти(Ссылка) = Неопределено Тогда
			Ссылки.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Ссылки;
КонецФункции

Функция ОтправленныеДокументы(Узел)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Соответствия.ТипОбъекта КАК ТипОбъекта,
	|	Соответствия.ВнешнийИд КАК ВнешнийИд
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовОбмена КАК Соответствия
	|ГДЕ
	|	Соответствия.Узел = &Узел
	|	И Соответствия.Направление = &Направление
	|	И Соответствия.Отправлен");
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("Направление", НаправлениеИсходящий());
	Результат = Новый Массив;
	Для Каждого Строка Из Запрос.Выполнить().Выгрузить() Цикл
		Результат.Добавить(СсылкаДокумента(Строка.ТипОбъекта, Строка.ВнешнийИд));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура СверитьДокумент(Узел, Ссылка)
	// Документ сверки: принадлежит и не отправлен в актуальном состоянии - регистрация; отправлен и не принадлежит -
	// отзыв; удалён - «Удален».
	ТипОбъекта = ТипОбъектаОбмена(Ссылка);
	Ид = Строка(Ссылка.УникальныйИдентификатор());
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
		Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
		Элемент.УстановитьЗначение("Ссылка", Ссылка);
		Элемент = Блокировка.Добавить("РегистрСведений.СоответствияОбъектовОбмена");
		УстановитьКлючСоответствия(Элемент, Узел, ТипОбъекта, Ид, НаправлениеИсходящий());
		Блокировка.Заблокировать();
		Запись = Соответствие(Узел, ТипОбъекта, Ид, НаправлениеИсходящий());
		Объект = Ссылка.ПолучитьОбъект();
		Состояние = ЦелевоеСостояние(Узел, Объект);
		// Транзита нет: документ, созданный обменом, сверка не регистрирует, как и ЗарегистрироватьСобытие.
		Транзит = Объект <> Неопределено И СозданОбменом(Ссылка);
		Если Не Транзит И НуженСобытиеСверки(Состояние, Запись) Тогда
			ЗарегистрироватьНаУзел(Узел, Ссылка, ТипОбъекта, Ид, Состояние);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Функция НуженСобытиеСверки(Состояние, Запись)
	// Проведённый - если ещё не отправлен или отправлено другое состояние; прочие состояния - только уже отправленным.
	Если Состояние = СостояниеПроведен() Тогда
		Возврат Не Запись.Отправлен Или Запись.СостояниеИсточника <> Состояние;
	КонецЕсли;
	Возврат Запись.Отправлен И Запись.СостояниеИсточника <> Состояние;
КонецФункции

Функция ЦелевоеСостояние(Узел, Объект)
	Если Объект = Неопределено Тогда
		Возврат СостояниеУдален();
	ИначеЕсли УзлыДокумента(Объект).Найти(Узел) = Неопределено Тогда
		Возврат СостояниеОтозван();
	ИначеЕсли Объект.Проведен Тогда
		Возврат СостояниеПроведен();
	Иначе
		Возврат СостояниеНеПроведен();
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область МониторСлужебное

Процедура ДобавитьНесопоставленное(Узел, ДанныеНоменклатуры, ЭтоТовар, Результат, Учтенные)
	Номенклатура = СопоставитьНоменклатуру(Узел, ДанныеНоменклатуры, ЭтоТовар);
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Если Учтенные["Н" + ДанныеНоменклатуры.Ид] = Неопределено Тогда
			Учтенные.Вставить("Н" + ДанныеНоменклатуры.Ид, Истина);
			Товар = Новый Структура("Ид, Наименование", ДанныеНоменклатуры.Ид, ДанныеНоменклатуры.Наименование);
			Товар.Вставить("Артикул", ДанныеНоменклатуры.Артикул);
			Товар.Вставить("ЭтоТовар", ЭтоТовар);
			Результат.Товары.Добавить(Товар);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Единица = ДанныеНоменклатуры.Единица;
	СвояЕдиница = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Единица");
	Ключ = "Е" + ?(Единица = Неопределено, "", Единица.Ид) + Строка(СвояЕдиница.УникальныйИдентификатор());
	Если Единица = Неопределено Или КоэффициентЕдиниц(Узел, Единица, Номенклатура) <> 0
		Или Учтенные[Ключ] <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Учтенные.Вставить(Ключ, Истина);
	ДанныеЕдиницы = Новый Структура("Ид, Наименование", Единица.Ид, Единица.Наименование);
	ДанныеЕдиницы.Вставить("Код", Единица.Код);
	ДанныеЕдиницы.Вставить("СвояЕдиница", СвояЕдиница);
	Результат.Единицы.Добавить(ДанныеЕдиницы);
КонецПроцедуры

#КонецОбласти

#КонецОбласти
