////////////////////////////////////////////////////////////////////////////////
// Клиентская часть подменю «Изменить» строк товаров документов продажи: выбор строк и ввод значения без модальности.
// Расчёт - одним серверным вызовом формы (её процедура ПрименитьГрупповоеИзменениеСтрок), см. ГрупповоеИзменениеСтрок.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет команду подменю «Изменить»: собирает строки, запрашивает значение и передаёт его форме.
//
// Параметры:
//  Форма       - ФормаКлиентскогоПриложения - форма документа с таблицей ТЧТовары и экспортной клиентской процедурой
//                ПрименитьГрупповоеИзменениеСтрок(Действие, Значение, Идентификаторы).
//  ИмяКоманды  - Строка - имя команды формы вида «ИзменитьСтроки<Действие>», действие - см. ГрупповоеИзменениеСтрок.Применить.
//
Процедура ВыполнитьКоманду(Форма, ИмяКоманды) Экспорт

	Действие = Сред(ИмяКоманды, СтрДлина(ПрефиксКоманд()) + 1);
	Идентификаторы = ИдентификаторыСтрок(Форма);
	Если Идентификаторы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В документе нет строк товаров.'; fr = 'Le document ne contient aucune ligne d''article.';
			|en = 'The document has no product lines.'; es = 'El documento no tiene líneas de artículos.'"));
		Возврат;
	КонецЕсли;
	Параметры = Новый Структура("Форма, Действие, Идентификаторы", Форма, Действие, Идентификаторы);
	// Не СтрШаблон: в подсказке есть знак процента.
	Подсказка = СтрЗаменить(ЗаголовокВвода(Действие), "%1", Формат(Идентификаторы.Количество(), "ЧГ=0"));

	Если Действие = "УбратьСкидки" Тогда
		Форма.ПрименитьГрупповоеИзменениеСтрок(Действие, 0, Идентификаторы);
	ИначеЕсли Действие = "ОкруглитьЦены" Тогда
		Список = Новый СписокЗначений;
		// BSLLS:MagicNumber-off
		Список.Добавить(1, НСтр("ru = 'До целых'; fr = 'À l''unité'; en = 'To whole numbers'; es = 'A enteros'"));
		Список.Добавить(0.1, НСтр("ru = 'До 0,1'; fr = 'À 0,1'; en = 'To 0.1'; es = 'A 0,1'"));
		Список.Добавить(0.01, НСтр("ru = 'До 0,01'; fr = 'À 0,01'; en = 'To 0.01'; es = 'A 0,01'"));
		// BSLLS:MagicNumber-on
		Форма.ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораТочности", ГрупповоеИзменениеСтрокКлиент, Параметры), Список);
	Иначе
		// BSLLS:MagicNumber-off
		ПоказатьВводЧисла(Новый ОписаниеОповещения("ПослеВводаЗначения", ГрупповоеИзменениеСтрокКлиент, Параметры), 0, Подсказка, 15, 2);
		// BSLLS:MagicNumber-on
	КонецЕсли;

КонецПроцедуры

// Обработчик ввода числа команды подменю «Изменить».
//
// Параметры:
//  Число     - Число, Неопределено - введённое значение; Неопределено - ввод отменён.
//  Параметры - Структура - Форма, Действие, Идентификаторы.
//
Процедура ПослеВводаЗначения(Число, Параметры) Экспорт

	Если Число = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Параметры.Форма.ПрименитьГрупповоеИзменениеСтрок(Параметры.Действие, Число, Параметры.Идентификаторы);

КонецПроцедуры

// Обработчик выбора точности округления цен.
//
// Параметры:
//  Выбранный - ЭлементСпискаЗначений, Неопределено - выбранная точность; Неопределено - выбор отменён.
//  Параметры - Структура - Форма, Действие, Идентификаторы.
//
Процедура ПослеВыбораТочности(Выбранный, Параметры) Экспорт

	Если Выбранный = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Параметры.Форма.ПрименитьГрупповоеИзменениеСтрок(Параметры.Действие, Выбранный.Значение, Параметры.Идентификаторы);

КонецПроцедуры

// Префикс имён команд подменю «Изменить» в формах документов.
//
// Возвращаемое значение:
//  Строка - префикс.
//
Функция ПрефиксКоманд() Экспорт

	Возврат "ИзменитьСтроки";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строки команды: выделенные; если выделена одна или ни одной - все строки (как в УНФ).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа с таблицей ТЧТовары.
//
// Возвращаемое значение:
//  Массив из Число - идентификаторы строк Объект.ТЧТовары.
//
Функция ИдентификаторыСтрок(Форма)

	Выделенные = Форма.Элементы.ТЧТовары.ВыделенныеСтроки;
	Если Выделенные.Количество() > 1 Тогда
		Идентификаторы = Новый Массив;
		Для Каждого Идентификатор Из Выделенные Цикл
			Идентификаторы.Добавить(Идентификатор);
		КонецЦикла;
		Возврат Идентификаторы;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Для Каждого Стр Из Форма.Объект.ТЧТовары Цикл
		Идентификаторы.Добавить(Стр.ПолучитьИдентификатор());
	КонецЦикла;
	Возврат Идентификаторы;

КонецФункции

Функция ЗаголовокВвода(Действие)

	Если Действие = "СкидкаПроцент" Тогда
		Возврат НСтр("ru = 'Скидка, % к %1 строкам'; fr = 'Remise, % sur %1 lignes';
			|en = 'Discount, % for %1 lines'; es = 'Descuento, % a %1 líneas'");
	ИначеЕсли Действие = "СкидкаСуммой" Тогда
		Возврат НСтр("ru = 'Скидка суммой к %1 строкам'; fr = 'Remise en montant sur %1 lignes';
			|en = 'Discount amount for %1 lines'; es = 'Descuento en importe a %1 líneas'");
	ИначеЕсли Действие = "ИтогДокумента" Тогда
		Возврат НСтр("ru = 'Итог с НДС для %1 строк'; fr = 'Total TTC pour %1 lignes';
			|en = 'Total incl. VAT for %1 lines'; es = 'Total con IVA para %1 líneas'");
	ИначеЕсли Действие = "ЦеныНаПроцент" Тогда
		Возврат НСтр("ru = 'Изменить цены на % (минус - снижение) в %1 строках';
			|fr = 'Modifier les prix de % (moins = baisse) sur %1 lignes';
			|en = 'Change prices by % (minus = decrease) in %1 lines';
			|es = 'Cambiar precios en % (menos = reducción) en %1 líneas'");
	Иначе
		Возврат НСтр("ru = 'Строк: %1'; fr = 'Lignes : %1'; en = 'Lines: %1'; es = 'Líneas: %1'");
	КонецЕсли;

КонецФункции

#КонецОбласти
