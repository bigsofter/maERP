
#Область ПрограммныйИнтерфейс

// Программно добавляет в командную панель табличной части команды сервиса.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа с табличной частью ТЧТовары; в модуле формы
//          должна быть клиентская процедура Подключаемый_ВыполнитьОбщуюКоманду(Команда).
//  ИмяКоманды - Строка - "Подменю": подменю с командами "Карточка товара" и "История товара";
//          "Подбор": кнопка подбора товара (форме нужен обработчик ОбработкаВыбора,
//          см. КомандыТабличныхЧастейКлиент.ВыполнитьКоманду).
//  ЭлементФормы - ГруппаФормы - командная панель, в которую добавляются кнопки.
//
Процедура ПодключитьКоманду(Форма, ИмяКоманды, ЭлементФормы) Экспорт
	Если ИмяКоманды = "Подменю" Тогда
		Подменю = Форма.Элементы.Добавить("ГруппаКомандыТовара", Тип("ГруппаФормы"), ЭлементФормы);
		Подменю.Вид = ВидГруппыФормы.Подменю;
		Подменю.Заголовок = НСтр("ru = 'Товар'; fr = 'Article'; en = 'Product'; es = 'Artículo'");
		ДобавитьКоманду(Форма, Подменю, "КарточкаТовара",
			НСтр("ru = 'Карточка товара'; fr = 'Fiche article'; en = 'Product card'; es = 'Ficha del artículo'"),
			БиблиотекаКартинок.Справочник, ОтображениеКнопки.КартинкаИТекст);
		ДобавитьКоманду(Форма, Подменю, "ИсторияТовара",
			НСтр("ru = 'История товара'; fr = 'Historique article'; en = 'Product history'; es = 'Historial del artículo'"),
			БиблиотекаКартинок.Отчет, ОтображениеКнопки.КартинкаИТекст);
	ИначеЕсли ИмяКоманды = "Подбор" Тогда
		ДобавитьКоманду(Форма, ЭлементФормы, "ПодборТовара",
			НСтр("ru = 'Подбор товара'; fr = 'Sélection des articles'; en = 'Product picking'; es = 'Selección de artículos'"),
			БиблиотекаКартинок.мобПодборТовара, ОтображениеКнопки.КартинкаИТекст);
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

// Пользовательские настройки отчёта "История товара": период - последние 12 месяцев,
// отбор по товару и, если заполнен, по контрагенту.
//
// Параметры:
//  Товар - СправочникСсылка.Номенклатура - товар строки документа.
//  Контрагент - СправочникСсылка.Контрагенты - контрагент документа (может быть пустым).
//
// Возвращаемое значение:
//  ПользовательскиеНастройкиКомпоновкиДанных - настройки для открытия формы отчёта.
//
Функция НастройкиОтчетаИсторияТовара(Товар, Контрагент) Экспорт
	ТекущаяДата = ТекущаяДатаСеанса();
	Параметры = Новый Структура;
	Параметры.Вставить("НачалоПериода", ДобавитьМесяц(ТекущаяДата, -МесяцевИстории()));
	Параметры.Вставить("КонецПериода", ТекущаяДата);
	Отбор = Новый Структура("Номенклатура", Товар);
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Отбор.Вставить("Контрагент", Контрагент);
	КонецЕсли;
	Возврат ОбщегоНазначенияВызовСервера.УстановитьНастройкиОтчёта("ИсторияТовара", Параметры, Отбор);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьКоманду(Форма, Родитель, Имя, Заголовок, Картинка, Отображение)
	Если Форма.Команды.Найти(Имя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Команда = Форма.Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Действие = "Подключаемый_ВыполнитьОбщуюКоманду";
	Команда.Картинка = Картинка;
	Команда.Отображение = Отображение;
	Кнопка = Форма.Элементы.Добавить("Кнопка" + Имя, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = Имя;
КонецПроцедуры

Функция МесяцевИстории()
	Возврат 12;
КонецФункции

#КонецОбласти
