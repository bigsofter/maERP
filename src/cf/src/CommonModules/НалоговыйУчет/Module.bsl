#Область ПрограммныйИнтерфейс

// Включён ли раздельный управленческий и налоговый учёт (функциональная опция РаздельныйУчет,
// docs/plans/accounting-morocco-f1.md). Без неё каждый документ налоговый.
//
// Возвращаемое значение:
//  Булево
//
Функция РаздельныйУчетВключен() Экспорт
	
	// Константа, а не ПолучитьФункциональнуюОпцию: значение опции запоминается на весь серверный вызов (tiny1C
	// bsl-023), а включение в том же вызове (мастер, обработчик обновления, тест) должно действовать сразу.
	// BSLLS:SetPrivilegedMode-off - значение настройки базы читает каждый пользователь
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Возврат Константы.РаздельныйУчет.Получить() = Истина;
	
КонецФункции

// Значение признака УУ для движений документа: Истина - документ не налоговый, его движения только управленческие.
// Без опции РаздельныйУчет и у документов без реквизита УУ - Ложь (налоговый). У безналичного поступления признак
// действует только для инкассации: он задаёт кассу, из которой ушла наличность.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - проводимый документ
//
// Возвращаемое значение:
//  Булево
//
Функция ЗначениеУУ(ДокОбъект) Экспорт
	
	Если Не РаздельныйУчетВключен() Или ДокОбъект.Метаданные().Реквизиты.Найти("УУ") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств")
		И ДокОбъект.ХозяйственнаяОперация <> Перечисления.ХозяйственныеОперации.Инкассация Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ДокОбъект.УУ = Истина;
	
КонецФункции

// Проставляет признак УУ всем движениям документа в регистрах раздельного учёта перед записью. Деньги - по месту
// хранения каждого движения: банковский счёт всегда белый (Ложь), касса - по признаку документа. Регистры, которых
// нет в движениях документа, пропускаются.
// Вызывается в ОбработкаПроведения документа непосредственно перед Движения.Записать().
//
// Параметры:
//  ДокОбъект - ДокументОбъект - проводимый документ
//
Процедура УстановитьПризнакУУ(ДокОбъект) Экспорт
	
	Значение = ЗначениеУУ(ДокОбъект);
	ДвиженияДокумента = ДокОбъект.Метаданные().Движения;
	ТипКассы = Тип("СправочникСсылка.Кассы");
	Для Каждого ИмяРегистра Из ИменаРегистровРаздельногоУчета() Цикл
		Если Не ДвиженияДокумента.Содержит(Метаданные.РегистрыНакопления[ИмяРегистра]) Тогда
			Продолжить;
		КонецЕсли;
		ЭтоДеньги = ИмяРегистра = "ДенежныеСредстваОрганизаций" Или ИмяРегистра = "ДвиженияДенежныхСредств";
		НалоговыеОбъекты = НалоговыеОбъектыРасчетов(ДокОбъект.Движения[ИмяРегистра], Значение);
		Для Каждого Запись Из ДокОбъект.Движения[ИмяРегистра] Цикл
			Признак = Значение И (Не ЭтоДеньги Или ТипЗнч(Запись.МестоХранения) = ТипКассы);
			Если Признак И НалоговыеОбъекты.Количество() > 0 Тогда
				// BSLLS:YoLetterUsage-off - имя измерения
				Признак = НалоговыеОбъекты.Найти(Запись.ОбъектРасчётов) = Неопределено;
				// BSLLS:YoLetterUsage-on
			КонецЕсли;
			Запись.УУ = Признак;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Признак УУ нового документа по умолчанию: при раздельном учёте - из настройки пользователя «Налоговый по умолчанию»
// (не задана - документ налоговый), без раздельного учёта - Ложь.
//
// Параметры:
//  Объект - ДокументОбъект - заполняемый документ с реквизитом УУ
//
Процедура ЗаполнитьПризнакУУ(Объект) Экспорт
	
	Если Объект.Метаданные().Реквизиты.Найти("УУ") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.УУ = РаздельныйУчетВключен() И Не РегистрыСведений.НастройкиПользователей.НалоговыйПоУмолчанию();
	
КонецПроцедуры

// Текст запрета выключения раздельного учёта: в регистрах есть движения с признаком УУ.
//
// Возвращаемое значение:
//  Строка - пустая, если выключить можно
//
Функция ТекстЗапретаВыключенияРаздельногоУчета() Экспорт
	
	// BSLLS:SetPrivilegedMode-off - проверка данных всей базы при записи настройки, права пользователя на регистры не важны
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	// Состав - ИменаРегистровРаздельногоУчета; текст запроса явный, чтобы его проверял анализатор.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Найдено ИЗ РегистрНакопления.ТоварыВНаличии КАК Т ГДЕ Т.УУ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т ГДЕ Т.УУ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т ГДЕ Т.УУ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрНакопления.Продажи КАК Т ГДЕ Т.УУ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрНакопления.ДенежныеСредстваОрганизаций КАК Т ГДЕ Т.УУ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрНакопления.ДвиженияДенежныхСредств КАК Т ГДЕ Т.УУ");
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат НСтр("ru = 'Раздельный учёт нельзя выключить: в базе есть документы только управленческого учёта (без флажка «Налоговый»).';
		|fr = 'La comptabilité séparée ne peut pas être désactivée : la base contient des documents de gestion uniquement (sans la case « Fiscal »).';
		|en = 'Separate accounting cannot be turned off: the database has management-only documents (without the ""Tax"" box).';
		|es = 'La contabilidad separada no se puede desactivar: la base tiene documentos solo de gestión (sin la casilla «Fiscal»).'");
	
КонецФункции

// Регистры накопления с измерением УУ.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ИменаРегистровРаздельногоУчета() Экспорт
	
	Возврат СтрРазделить("ТоварыВНаличии,ВзаиморасчётыСПокупателями,ВзаиморасчётыСПоставщиками,Продажи,"
		+ "ДенежныеСредстваОрганизаций,ДвиженияДенежныхСредств", ",");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объекты расчётов набора, которые - налоговые документы на основаниях: расчёт по ним всегда налоговый, и прямая
// управленческая оплата налогового документа гасит его белый долг так же, как оплата основания, перенесённая им
// (docs/plans/accounting-morocco-f1-s2.md). Признак денежных регистров платежа не меняется.
//
// Параметры:
//  Набор    - РегистрНакопленияНаборЗаписей - набор движений документа
//  Значение - Булево - признак УУ документа: при Ложь искать нечего
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция НалоговыеОбъектыРасчетов(Набор, Значение)

	Результат = Новый Массив;
	// BSLLS:YoLetterUsage-off - имя измерения
	ИмяОбъекта = "ОбъектРасчётов";
	// BSLLS:YoLetterUsage-on
	Если Не Значение Или Набор.Метаданные().Измерения.Найти(ИмяОбъекта) = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Объект Из Набор.ВыгрузитьКолонку(ИмяОбъекта) Цикл
		Если Результат.Найти(Объект) = Неопределено И НалоговыеДокументыНаОснованиях.ЭтоРегистраторНаОснованиях(Объект) Тогда
			Результат.Добавить(Объект);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
