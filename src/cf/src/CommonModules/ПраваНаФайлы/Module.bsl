#Область ПрограммныйИнтерфейс

// Отказывает, если пользователь не может менять файлы владельца (см. ПравоИзмененияВладельца).
//
// Параметры:
//  Владелец - ОпределяемыйТип.ВладельцыПрисоединенныхФайлов - владелец файлов.
//  ИмяРоли  - Строка - роль, право которой проверяется вдобавок к праву пользователя (сценарий тестов).
//
Процедура ПроверитьПравоИзмененияВладельца(Владелец, ИмяРоли = "") Экспорт
	Если ПравоИзмененияВладельца(Владелец, ИмяРоли) Тогда
		Возврат;
	КонецЕсли;
	ШаблонОтказа = НСтр("ru = 'Недостаточно прав для изменения файлов объекта «%1».';
		|fr = 'Droits insuffisants pour modifier les fichiers de l''objet « %1 ».';
		|en = 'Insufficient rights to change the files of «%1».';
		|es = 'Derechos insuficientes para modificar los archivos de «%1».'");
	ВызватьИсключение СтрШаблон(ШаблонОтказа, Владелец);
КонецПроцедуры

// Может ли пользователь добавлять, заменять и удалять файлы владельца. Файлы документа - только с правом изменения
// документа (КП с 2.0.16.137, остальные документы с 2.0.17.9). У справочников проверки нет: файлы к товарам и
// контрагентам прикрепляют и роли, у которых сами карточки только для чтения (TECHDEBT).
//
// Параметры:
//  Владелец - ОпределяемыйТип.ВладельцыПрисоединенныхФайлов - владелец файлов.
//  ИмяРоли  - Строка - роль, право которой проверяется вдобавок к праву пользователя (сценарий тестов).
//
// Возвращаемое значение:
//  Булево - Истина, если менять файлы можно.
//
Функция ПравоИзмененияВладельца(Владелец, ИмяРоли = "") Экспорт
	МетаданныеВладельца = Метаданные.НайтиПоТипу(ТипЗнч(Владелец));
	Если МетаданныеВладельца = Неопределено Или Не Метаданные.Документы.Содержит(МетаданныеВладельца) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ПравоНаВладельца(Владелец, "Изменение", ИмяРоли);
КонецФункции

// Может ли пользователь получить файл владельца: у одной из его ролей есть и чтение владельца, и просмотр регистра
// присоединённых файлов. Просмотр регистра нужен для отказа ролям, которые читают регистр только программно (личный
// кабинет партнёра берёт картинки товаров навигационной ссылкой): привилегированная выдача файла обошла бы их RLS.
//
// Параметры:
//  Владелец - ОпределяемыйТип.ВладельцыПрисоединенныхФайлов - владелец файла.
//  ИмяРоли  - Строка - роль, право которой проверяется вдобавок к праву пользователя (сценарий тестов).
//
// Возвращаемое значение:
//  Булево - Истина, если файл можно отдать.
//
Функция ПравоЧтенияФайловВладельца(Владелец, ИмяРоли = "") Экспорт
	МетаданныеВладельца = Метаданные.НайтиПоТипу(ТипЗнч(Владелец));
	Если МетаданныеВладельца = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	// BSLLS:YoLetterUsage-off - имя регистра в метаданных.
	МетаданныеФайлов = Метаданные.РегистрыСведений.ПрисоединённыеФайлы;
	// BSLLS:YoLetterUsage-on
	Если ЗначениеЗаполнено(ИмяРоли) Тогда
		Роль = Метаданные.Роли.Найти(ИмяРоли);
		Если Роль = Неопределено Или Не ПравоЧтенияФайловРоли(МетаданныеВладельца, МетаданныеФайлов, Роль) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	ЕстьРоли = Ложь;
	Для Каждого Роль Из ПользователиИнформационнойБазы.ТекущийПользователь().Роли Цикл
		ЕстьРоли = Истина;
		Если ПравоЧтенияФайловРоли(МетаданныеВладельца, МетаданныеФайлов, Роль) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	// База без пользователей: работающий в ней - администратор.
	Возврат Не ЕстьРоли;
КонецФункции

// Есть ли у пользователя право просмотра регистра присоединённых файлов. Право берётся по ролям пользователя явно,
// как в ПравоНаВладельца: вызывается из привилегированного модуля.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ПравоПросмотраФайлов() Экспорт
	// BSLLS:YoLetterUsage-off - имя регистра в метаданных.
	МетаданныеФайлов = Метаданные.РегистрыСведений.ПрисоединённыеФайлы;
	// BSLLS:YoLetterUsage-on
	ЕстьРоли = Ложь;
	Для Каждого Роль Из ПользователиИнформационнойБазы.ТекущийПользователь().Роли Цикл
		ЕстьРоли = Истина;
		Если ПравоДоступа("Просмотр", МетаданныеФайлов, Роль) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	// База без пользователей: работающий в ней - администратор.
	Возврат Не ЕстьРоли;
КонецФункции

// Есть ли у пользователя право на объект метаданных владельца файлов. Право берётся по ролям пользователя явно, а не
// проверкой в текущем режиме: модуль файлов привилегированный, и привилегированный режим переходит в события записи
// регистра ПрисоединённыеФайлы.
//
// Параметры:
//  Владелец - ОпределяемыйТип.ВладельцыПрисоединенныхФайлов - владелец файлов.
//  Право    - Строка - имя права: «Чтение», «Изменение».
//  ИмяРоли  - Строка - роль, право которой проверяется вдобавок к праву пользователя (сценарий тестов).
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ПравоНаВладельца(Владелец, Право, ИмяРоли = "") Экспорт
	МетаданныеВладельца = Метаданные.НайтиПоТипу(ТипЗнч(Владелец));
	Если МетаданныеВладельца = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяРоли) Тогда
		Роль = Метаданные.Роли.Найти(ИмяРоли);
		Если Роль = Неопределено Или Не ПравоДоступа(Право, МетаданныеВладельца, Роль) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	ЕстьРоли = Ложь;
	Для Каждого Роль Из ПользователиИнформационнойБазы.ТекущийПользователь().Роли Цикл
		ЕстьРоли = Истина;
		Если ПравоДоступа(Право, МетаданныеВладельца, Роль) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	// База без пользователей: работающий в ней - администратор.
	Возврат Не ЕстьРоли;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПравоЧтенияФайловРоли(МетаданныеВладельца, МетаданныеФайлов, Роль)
	Возврат ПравоДоступа("Чтение", МетаданныеВладельца, Роль) И ПравоДоступа("Просмотр", МетаданныеФайлов, Роль);
КонецФункции

#КонецОбласти
