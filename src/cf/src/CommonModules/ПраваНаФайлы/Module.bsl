#Область ПрограммныйИнтерфейс

// Отказывает, если пользователь не может менять файлы владельца (см. ПравоИзмененияВладельца).
//
// Параметры:
//  Владелец - ОпределяемыйТип.ВладельцыПрисоединенныхФайлов - владелец файлов.
//  ИмяРоли  - Строка - роль, право которой проверяется вдобавок к праву пользователя (сценарий тестов).
//
Процедура ПроверитьПравоИзмененияВладельца(Владелец, ИмяРоли = "") Экспорт
	Если ПравоИзмененияВладельца(Владелец, ИмяРоли) Тогда
		Возврат;
	КонецЕсли;
	ШаблонОтказа = НСтр("ru = 'Недостаточно прав для изменения файлов объекта «%1».';
		|fr = 'Droits insuffisants pour modifier les fichiers de l''objet « %1 ».';
		|en = 'Insufficient rights to change the files of «%1».';
		|es = 'Derechos insuficientes para modificar los archivos de «%1».'");
	ВызватьИсключение СтрШаблон(ШаблонОтказа, Владелец);
КонецПроцедуры

// Может ли пользователь добавлять, заменять и удалять файлы владельца. Файлы коммерческого предложения - только с
// правом изменения предложения (2.0.16.137). У прежних владельцев проверки нет: файлы к товарам и контрагентам
// прикрепляют и роли, у которых сами карточки только для чтения (TECHDEBT).
//
// Параметры:
//  Владелец - ОпределяемыйТип.ВладельцыПрисоединенныхФайлов - владелец файлов.
//  ИмяРоли  - Строка - роль, право которой проверяется вдобавок к праву пользователя (сценарий тестов).
//
// Возвращаемое значение:
//  Булево - Истина, если менять файлы можно.
//
Функция ПравоИзмененияВладельца(Владелец, ИмяРоли = "") Экспорт
	// Владельцы 2.0.17.20 (банковские документы) - только с правом изменения документа.
	ПроверяемыеТипы = Новый ОписаниеТипов("ДокументСсылка.КоммерческоеПредложение,
		|ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств, ДокументСсылка.СписаниеБезналичныхДенежныхСредств");
	Если Не ПроверяемыеТипы.СодержитТип(ТипЗнч(Владелец)) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ПравоНаВладельца(Владелец, "Изменение", ИмяРоли);
КонецФункции

// Есть ли у пользователя право на объект метаданных владельца файлов. Право берётся по ролям пользователя явно, а не
// проверкой в текущем режиме: модуль файлов привилегированный, и привилегированный режим переходит в события записи
// регистра ПрисоединённыеФайлы.
//
// Параметры:
//  Владелец - ОпределяемыйТип.ВладельцыПрисоединенныхФайлов - владелец файлов.
//  Право    - Строка - имя права: «Чтение», «Изменение».
//  ИмяРоли  - Строка - роль, право которой проверяется вдобавок к праву пользователя (сценарий тестов).
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ПравоНаВладельца(Владелец, Право, ИмяРоли = "") Экспорт
	МетаданныеВладельца = Метаданные.НайтиПоТипу(ТипЗнч(Владелец));
	Если МетаданныеВладельца = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяРоли) Тогда
		Роль = Метаданные.Роли.Найти(ИмяРоли);
		Если Роль = Неопределено Или Не ПравоДоступа(Право, МетаданныеВладельца, Роль) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	ЕстьРоли = Ложь;
	Для Каждого Роль Из ПользователиИнформационнойБазы.ТекущийПользователь().Роли Цикл
		ЕстьРоли = Истина;
		Если ПравоДоступа(Право, МетаданныеВладельца, Роль) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	// База без пользователей: работающий в ней - администратор.
	Возврат Не ЕстьРоли;
КонецФункции

#КонецОбласти
