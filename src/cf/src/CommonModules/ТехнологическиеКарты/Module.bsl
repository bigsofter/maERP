#Область ПрограммныйИнтерфейс

// Проверяет день редактирования относительно самой поздней карты, включая будущие и черновики.
//
// Параметры:
//  Продукция - СправочникСсылка.Номенклатура - продукция карты.
//  Дата - Дата - выбранный день; пустая дата означает сегодня.
//  Сегодня - Дата, Неопределено - дата сеанса; параметр для воспроизводимой проверки границ.
//
// Возвращаемое значение:
//  Структура - Дата, ПоследняяДата, Допустима, Документ (карта выбранного дня).
//
Функция ДатаРедактированияТехкарты(Продукция, Дата, Сегодня = Неопределено) Экспорт

	ТекущийДень = НачалоДня(?(ЗначениеЗаполнено(Сегодня), Сегодня, ТекущаяДатаСеанса()));
	День = НачалоДня(?(ЗначениеЗаполнено(Дата), Дата, ТекущийДень));
	Запрос = Новый Запрос("ВЫБРАТЬ МАКСИМУМ(Карта.Дата) КАК Дата
		|ИЗ Документ.ТехнологическаяКарта КАК Карта
		|ГДЕ Карта.Номенклатура = &Продукция И НЕ Карта.ПометкаУдаления");
	Запрос.УстановитьПараметр("Продукция", Продукция);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ПоследняяДата = ?(Выборка.Дата = NULL, Дата(1, 1, 1), НачалоДня(Выборка.Дата));
	Допустима = День >= ПоследняяДата;
	Если Не Допустима Тогда
		День = Макс(ТекущийДень, КонецДня(ПоследняяДата) + 1);
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Дата", День);
	Результат.Вставить("ПоследняяДата", ПоследняяДата);
	Результат.Вставить("Допустима", Допустима);
	Результат.Вставить("Документ", ДокументДня(Продукция, День));
	Возврат Результат;

КонецФункции

// Сообщение для формы и серверной проверки записи.
//
// Параметры:
//  ПоследняяДата - Дата - дата самой поздней карты.
//
// Возвращаемое значение:
//  Строка - локализованный текст ошибки.
//
Функция ОшибкаДатыТехкарты(ПоследняяДата) Экспорт

	Шаблон = НСтр("ru = 'Дата техкарты не может быть раньше последней версии (%1).';
		|fr = 'La date de la gamme ne peut pas précéder la dernière version (%1).';
		|en = 'The routing date cannot precede the latest version (%1).';
		|es = 'La fecha de la ruta no puede ser anterior a la última versión (%1).'");
	Возврат СтрШаблон(Шаблон, Формат(ПоследняяДата, "ДЛФ=D"));

КонецФункции

// Есть ли проведённые ручные выпуски продукции начиная с дня действия изменяемой карты. Автовыпуск при отгрузке (основание -
// заполненная реализация, см. Производство.ЭтоАвтовыпуск) не учитывается: вручную он не правится, его перезаполняет
// перепроведение реализации.
//
// Параметры:
//  Продукция - СправочникСсылка.Номенклатура - продукция карты.
//  Дата - Дата - день действия карты.
//
// Возвращаемое значение:
//  Булево - требуется ручное перезаполнение выпусков.
//
Функция ЕстьВыпускиПослеДаты(Продукция, Дата) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Выпуск.Ссылка КАК Ссылка
		|ИЗ Документ.ВыпускПродукции КАК Выпуск
		|ГДЕ Выпуск.Проведен И Выпуск.Дата >= &Дата
		|	И НЕ (Выпуск.Основание ССЫЛКА Документ.РеализацияТоваровУслуг
		|		И Выпуск.Основание <> ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка))
		|	И Выпуск.Ссылка В
		|		(ВЫБРАТЬ Строки.Ссылка КАК Ссылка
		|		ИЗ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК Строки
		|		ГДЕ Строки.Номенклатура = &Продукция)
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ ПЕРВЫЕ 1 Выпуск.Ссылка КАК Ссылка
		|ИЗ Документ.ВыпускПродукции КАК Выпуск
		|ГДЕ Выпуск.Проведен И Выпуск.Дата >= &Дата И Выпуск.Номенклатура = &Продукция
		|	И НЕ (Выпуск.Основание ССЫЛКА Документ.РеализацияТоваровУслуг
		|		И Выпуск.Основание <> ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка))
		|	И НЕ Выпуск.Ссылка В
		|		(ВЫБРАТЬ Строки.Ссылка КАК Ссылка
		|		ИЗ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК Строки)");
	Запрос.УстановитьПараметр("Продукция", Продукция);
	Запрос.УстановитьПараметр("Дата", НачалоДня(Дата));
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Оценка текущего состава по остаткам всех складов и последним фактическим ценам с НДС
// в валюте регламентированного учёта. Дополнительные производственные расходы не включаются.
// Повторяющиеся материалы потребляют общий остаток; характеристики не взаимозаменяются.
//
// Параметры:
//  Продукция - СправочникСсылка.Номенклатура - продукция для поиска последней продажи.
//  Состав - ТаблицаЗначений - Номенклатура, Характеристика, Упаковка, Количество на единицу продукции.
//  Дата - Дата, Неопределено - момент остатков и цен; по умолчанию сейчас.
//
// Возвращаемое значение:
//  Структура - Строки (таблица с Цена, Сумма), Себестоимость, МожноПроизвести,
//              ЦенаПродажи, ПотенциальнаяМаржа, ВсеЦеныЕсть, Валюта.
//
Функция ПоказателиТехкарты(Продукция, Состав, Дата = Неопределено) Экспорт

	Момент = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	Строки = Состав.Скопировать(, "Номенклатура, Характеристика, Упаковка, Количество");
	Строки.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	Строки.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат = Новый Структура;
	Результат.Вставить("Строки", Строки);
	Результат.Вставить("Себестоимость", 0);
	Результат.Вставить("МожноПроизвести", 0);
	Результат.Вставить("ЦенаПродажи", 0);
	Результат.Вставить("ПотенциальнаяМаржа", 0);
	Результат.Вставить("ВсеЦеныЕсть", Истина);
	Результат.Вставить("Валюта", Константы.ВалютаРегламентированногоУчета.Получить());
	Если Строки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Материалы = Строки.ВыгрузитьКолонку("Номенклатура");
	Цены = ПоследниеЦеныМатериалов(Материалы, Момент);
	Для Каждого Строка Из Строки Цикл
		Ключ = Новый Структура("Номенклатура, Характеристика", Строка.Номенклатура, Строка.Характеристика);
		Найденные = Цены.НайтиСтроки(Ключ);
		Если Найденные.Количество() > 0 Тогда
			Строка.Цена = Найденные[0].Цена;
		КонецЕсли;
		Строка.Сумма = Окр(Строка.Количество * Строка.Цена, РазрядностьСуммТехкарты());
		Если Строка.Количество > 0 И Строка.Цена <= 0 Тогда
			Результат.ВсеЦеныЕсть = Ложь;
		КонецЕсли;
	КонецЦикла;
	Если Результат.ВсеЦеныЕсть Тогда
		Результат.Себестоимость = Строки.Итог("Сумма");
	КонецЕсли;
	Результат.МожноПроизвести = ВыпускИзОстатков(Строки, Момент);
	Результат.ЦенаПродажи = ПоследняяЦенаПродажи(Продукция, Момент);
	Если Результат.ВсеЦеныЕсть И Результат.ЦенаПродажи > 0 Тогда
		Результат.ПотенциальнаяМаржа = Окр(
			(Результат.ЦенаПродажи - Результат.Себестоимость) * Результат.МожноПроизвести, РазрядностьСуммТехкарты());
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Состав технологических карт, действующих на дату среза.
// Версия карты - это документ-регистратор: берутся строки последнего по дате документа
// продукции, а не срез последних по измерениям, иначе в состав подмешались бы материалы,
// удалённые в новой версии карты. Маркерная запись отмены карты (пустой материал) в
// результат не попадает: у отменённой карты состав пустой.
//
// Параметры:
//  Продукция - Массив, СправочникСсылка.Номенклатура - позиции, чьи карты нужны.
//  Дата      - Дата - момент среза; не заполнена - текущая дата сеанса.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Продукция, Регистратор, Номенклатура (материал),
//                    Характеристика, Упаковка, Количество (на единицу продукции),
//                    СпособИзготовления, ПроцентПотерь.
//                    Строки упорядочены по продукции и номеру строки карты.
//
Функция СоставТехкарт(Продукция, Дата = Неопределено) Экспорт
	
	Запрос = ЗапросПоСоставу(Продукция, Дата);
	Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
	                              |	ВТСостав.Продукция КАК Продукция,
	                              |	ВТСостав.Регистратор КАК Регистратор,
	                              |	ВТСостав.Номенклатура КАК Номенклатура,
	                              |	ВТСостав.Характеристика КАК Характеристика,
	                              |	ВТСостав.Упаковка КАК Упаковка,
	                              |	ВТСостав.Количество КАК Количество,
	                              |	ВТСостав.СпособИзготовления КАК СпособИзготовления,
	                              |	ВТСостав.ПроцентПотерь КАК ПроцентПотерь
	                              |ИЗ
	                              |	ВТСостав КАК ВТСостав
	                              |
	                              |УПОРЯДОЧИТЬ ПО
	                              |	ВТСостав.Продукция,
	                              |	ВТСостав.НомерСтроки";
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Действующие на дату версии технологических карт.
// Отменённая карта (маркерная запись с пустым материалом) - тоже версия: она возвращается,
// иначе повторная запись пустого состава заводила бы новый документ каждый день.
//
// Параметры:
//  Продукция - Массив, СправочникСсылка.Номенклатура - позиции, чьи версии нужны.
//  Дата      - Дата - момент среза; не заполнена - текущая дата сеанса.
//
// Возвращаемое значение:
//  Соответствие - ключ СправочникСсылка.Номенклатура (продукция), значение Структура:
//                  * Версия     - ДокументСсылка.ТехнологическаяКарта - регистратор версии.
//                  * ДействуетС - Дата - период записей этой версии.
//                 Позиции без карты в соответствие не попадают.
//
Функция ТекущиеТехкарты(Продукция, Дата = Неопределено) Экспорт
	
	Запрос = ЗапросПоСоставу(Продукция, Дата);
	Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                              |	Состав.Продукция КАК Продукция,
	                              |	Состав.Регистратор КАК Регистратор,
	                              |	Состав.Период КАК Период
	                              |ИЗ
	                              |	РегистрСведений.СоставТехКарты КАК Состав
	                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВерсии КАК ВТВерсии
	                              |		ПО Состав.Продукция = ВТВерсии.Продукция
	                              |			И Состав.Период = ВТВерсии.Период";
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Версия = Новый Структура("Версия, ДействуетС", Выборка.Регистратор, Выборка.Период);
		Результат.Вставить(Выборка.Продукция, Версия);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Состав конкретной версии технологической карты.
// Маркерная запись отмены карты в результат не попадает: у отменённой карты состав пустой.
//
// Параметры:
//  Регистратор - ДокументСсылка.ТехнологическаяКарта - версия карты.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура (материал), Характеристика, Упаковка, Количество,
//                    СпособИзготовления, ПроцентПотерь; имена совпадают с реквизитами ТЧМатериалы
//                    документа. Строки упорядочены по номеру строки записей регистра.
//
Функция СоставТехкартыПоРегистратору(Регистратор) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Состав.Материал КАК Номенклатура,
	                      |	Состав.Характеристика КАК Характеристика,
	                      |	Состав.Упаковка КАК Упаковка,
	                      |	Состав.Количество КАК Количество,
	                      |	Состав.СпособИзготовления КАК СпособИзготовления,
	                      |	Состав.ПроцентПотерь КАК ПроцентПотерь
	                      |ИЗ
	                      |	РегистрСведений.СоставТехКарты КАК Состав
	                      |ГДЕ
	                      |	Состав.Регистратор = &Регистратор
	                      |	И Состав.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Состав.НомерСтроки");
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Веса позиций продукции для распределения себестоимости мультивыпуска.
// Правило переносится дословно из прежнего расчёта по табличной части справочника: если карты
// нет хотя бы у одной позиции набора, коэффициенты всех позиций равны единице, а не смеси
// «карта / единица». Отменённая карта считается отсутствующей: её суммарный расход равен нулю.
//
// Параметры:
//  Продукция - Массив, СправочникСсылка.Номенклатура - позиции выпуска.
//  Дата      - Дата - момент среза; не заполнена - текущая дата сеанса.
//
// Возвращаемое значение:
//  Соответствие - ключ СправочникСсылка.Номенклатура, значение Число: расход сырья
//                 на единицу продукции по карте либо 1 для всего набора.
//
Функция КоэффициентыТехкарт(Продукция, Дата = Неопределено) Экспорт
	
	Запрос = ЗапросПоСоставу(Продукция, Дата);
	Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
	                              |	СпрНоменклатура.Ссылка КАК Номенклатура,
	                              |	СУММА(ЕСТЬNULL(ВТСостав.Количество, 0)) КАК Коэффициент
	                              |ИЗ
	                              |	Справочник.Номенклатура КАК СпрНоменклатура
	                              |		ЛЕВОЕ СОЕДИНЕНИЕ ВТСостав КАК ВТСостав
	                              |		ПО СпрНоменклатура.Ссылка = ВТСостав.Продукция
	                              |ГДЕ
	                              |	СпрНоменклатура.Ссылка В (&Продукция)
	                              |
	                              |СГРУППИРОВАТЬ ПО
	                              |	СпрНоменклатура.Ссылка";
	ТЗ = Запрос.Выполнить().Выгрузить();
	ПоТехкартам = ТЗ.Количество() > 0 И ТЗ.НайтиСтроки(Новый Структура("Коэффициент", 0)).Количество() = 0;
	Результат = Новый Соответствие;
	Для Каждого Стр Из ТЗ Цикл
		Результат.Вставить(Стр.Номенклатура, ?(ПоТехкартам, Стр.Коэффициент, 1));
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Материалы, нужные для выпуска заданного количества продукции по действующим картам.
// Одинаковые материалы разных позиций продукции сводятся в одну строку.
//
// Параметры:
//  ТЗПродукция - ТаблицаЗначений - выпускаемая продукция, колонки Номенклатура
//                и КоличествоУпаковок.
//  Дата        - Дата - момент среза карт; не заполнена - текущая дата сеанса.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура (материал), Характеристика, Упаковка,
//                    КоличествоЗаЕдиницу и КоличествоУпаковок (итог по всей продукции).
//                    Упаковка заполняется только при включённой функциональной опции
//                    «Использовать упаковку», иначе колонка пуста: количество в строке
//                    документа считается по базовой единице, как до перехода на регистр.
//                    Пустая таблица - ни у одной позиции карты нет.
//
Функция ЗаполнитьМатериалыПоТехкартам(ТЗПродукция, Дата = Неопределено) Экспорт
	
	Запрос = ЗапросПоСоставу(ТЗПродукция.ВыгрузитьКолонку("Номенклатура"), Дата);
	Запрос.УстановитьПараметр("ТЗПродукция", ТЗПродукция);
	Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
	                              |	ВЫРАЗИТЬ(ТЗ.Номенклатура КАК Справочник.Номенклатура) КАК Продукция,
	                              |	ВЫРАЗИТЬ(ТЗ.КоличествоУпаковок КАК ЧИСЛО(15, 3)) КАК КоличествоУпаковок
	                              |ПОМЕСТИТЬ ВТПродукция
	                              |ИЗ
	                              |	&ТЗПродукция КАК ТЗ
	                              |;
	                              |
	                              |////////////////////////////////////////////////////////////////////////////////
	                              |ВЫБРАТЬ
	                              |	ВТСостав.Номенклатура КАК Номенклатура,
	                              |	ВТСостав.Характеристика КАК Характеристика,
	                              |	ВТСостав.Упаковка КАК Упаковка,
	                              |	ВТСостав.Количество КАК КоличествоЗаЕдиницу,
	                              |	СУММА(ВТПродукция.КоличествоУпаковок * ВТСостав.Количество) КАК КоличествоУпаковок
	                              |ИЗ
	                              |	ВТПродукция КАК ВТПродукция
	                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСостав КАК ВТСостав
	                              |		ПО ВТПродукция.Продукция = ВТСостав.Продукция
	                              |
	                              |СГРУППИРОВАТЬ ПО
	                              |	ВТСостав.Номенклатура,
	                              |	ВТСостав.Характеристика,
	                              |	ВТСостав.Упаковка,
	                              |	ВТСостав.Количество";
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку") Тогда
		// Без опции упаковка в документ не уходит (решение владельца 2026-09-10): иначе
		// РаботаСДокументамиКлиентСервер.РассчитатьСтроку пересчитала бы количество по
		// коэффициенту упаковки и сдвинула суммы выпусков, которые до перехода на регистр
		// считались по базовой единице. Материалы, различавшиеся только упаковкой, после
		// очистки колонки сводятся в одну строку.
		ТЗ.ЗаполнитьЗначения(Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка(), "Упаковка");
		ТЗ.Свернуть("Номенклатура, Характеристика, Упаковка, КоличествоЗаЕдиницу", "КоличествоУпаковок");
	КонецЕсли;
	Возврат ТЗ;
	
КонецФункции

// Записывает и проводит технологическую карту продукции.
// Версия карты - это её регистратор, поэтому повторная запись в тот же день перезаписывает
// документ этого дня, а не заводит второй. Пустой состав - законное состояние: карта
// отменяется, проведение пишет маркерную запись.
//
// Параметры:
//  Продукция - СправочникСсылка.Номенклатура - продукция карты.
//  Состав    - ТаблицаЗначений, ТабличнаяЧастьОбъекта, ДанныеФормыКоллекция - строки состава
//              с реквизитами Номенклатура, Характеристика, Упаковка, Количество;
//              способ изготовления и процент потерь переносятся, если источник их знает, иначе
//              умолчание ставит сам документ карты;
//              Неопределено или пусто - карта отменяется.
//  Дата      - Дата - дата версии; не заполнена - текущая дата сеанса.
//
// Возвращаемое значение:
//  ДокументСсылка.ТехнологическаяКарта - записанный документ версии.
//
Функция ЗаписатьТехкарту(Продукция, Состав, Дата = Неопределено) Экспорт

	// Карточка номенклатуры и проведение заказа на производство (E6) пишут карту одного дня: без блокировки
	// до поиска документа дня две параллельные записи завели бы две карты на одну дату, и срез смешал бы
	// их составы.
	// Отказ по дате - не исключение внутри транзакции: ничего ещё не записано, а отмена вложенной транзакции
	// испортила бы внешнюю (проведение заказа, сценарии тестов, ловящие этот отказ).
	ОшибкаДаты = "";
	Ссылка = Документы.ТехнологическаяКарта.ПустаяСсылка();
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьКартыПродукции(Продукция);
		ПроверкаДаты = ДатаРедактированияТехкарты(Продукция, Дата);
		Если ПроверкаДаты.Допустима Тогда
			Ссылка = ЗаписатьДокументТехкарты(Продукция, Состав, ПроверкаДаты.Дата);
		Иначе
			ОшибкаДаты = ОшибкаДатыТехкарты(ПроверкаДаты.ПоследняяДата);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если ОшибкаДаты <> "" Тогда
		ВызватьИсключение ОшибкаДаты;
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

// Исключительная управляемая блокировка карт продукции: регистр СоставТехКарты по полю Продукция.
// Берут её все пути записи карты - фасад, проведение заказа на производство и запись документа карты,
// и всегда до записи самого документа карты: один порядок блокировок не даёт взаимоблокировок.
// Вызывается только в транзакции.
//
// Параметры:
//  Продукция - СправочникСсылка.Номенклатура, Массив, ТаблицаЗначений - продукция; таблица - с колонкой
//              Продукция (все значения блокируются одним элементом).
//
Процедура ЗаблокироватьКартыПродукции(Продукция) Экспорт

	ИмяПоля = "Продукция";
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СоставТехКарты");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Если ТипЗнч(Продукция) = Тип("ТаблицаЗначений") Или ТипЗнч(Продукция) = Тип("Массив") Тогда
		// Значения - в одном порядке у всех сеансов: заказы с продукциями {A, B} и {B, A} не ждут друг друга.
		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить(ИмяПоля, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		Таблица.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Строка"));
		Значения = ?(ТипЗнч(Продукция) = Тип("Массив"), Продукция, Продукция.ВыгрузитьКолонку(ИмяПоля));
		Для Каждого Значение Из Значения Цикл
			СтрокаТаблицы = Таблица.Добавить();
			СтрокаТаблицы[ИмяПоля] = Значение;
			СтрокаТаблицы.Порядок = XMLСтрока(Значение);
		КонецЦикла;
		Таблица.Свернуть(ИмяПоля + ", Порядок");
		Таблица.Сортировать("Порядок");
		ЭлементБлокировки.ИсточникДанных = Таблица;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных(ИмяПоля, ИмяПоля);
	Иначе
		ЭлементБлокировки.УстановитьЗначение(ИмяПоля, Продукция);
	КонецЕсли;
	Блокировка.Заблокировать();

КонецПроцедуры

// Отличается ли состав от записанного в указанной версии карты.
// Перестановка строк и разная разрядность количества отличием не считаются: строки
// сравниваются как упорядоченный набор ключей «материал + характеристика + упаковка +
// количество с тремя знаками».
//
// Параметры:
//  Регистратор - ДокументСсылка.ТехнологическаяКарта - версия, с которой сравниваем;
//                пустая ссылка - записанного состава нет.
//  Состав      - ТаблицаЗначений, ТабличнаяЧастьОбъекта, ДанныеФормыКоллекция - строки
//                с реквизитами Номенклатура, Характеристика, Упаковка, Количество;
//                Неопределено - состав пуст.
//
// Возвращаемое значение:
//  Булево - Истина, если состав нужно записывать новой версией.
//
Функция СоставОтличается(Регистратор, Состав) Экспорт
	
	Записанный = СоставТехкартыПоРегистратору(Регистратор);
	Возврат КлючСостава(Записанный) <> КлючСостава(Состав);
	
КонецФункции

// Сравнимое представление состава, не зависящее от порядка строк и разрядности количества:
// та же формула, по которой СоставОтличается сравнивает состав с версией карты. Нужна документам,
// чьи строки материалов хранят количество на единицу продукции в поле с другим именем.
//
// Параметры:
//  Состав            - ТаблицаЗначений, ТабличнаяЧастьОбъекта, ДанныеФормыКоллекция, Массив, Неопределено -
//                      строки с реквизитами Номенклатура, Характеристика, Упаковка и полем количества.
//  ИмяПоляКоличества - Строка - реквизит строки с количеством на единицу продукции.
//
// Возвращаемое значение:
//  Строка - равные строки означают одинаковый состав.
//
Функция КлючСоставаСтрок(Состав, ИмяПоляКоличества = "Количество") Экспорт

	Возврат КлючСостава(Состав, ИмяПоляКоличества);

КонецФункции

// Отличаются ли способ изготовления или процент потерь от записанных в версии карты.
// Отдельная функция, а не часть КлючСостава: ключ состава общий со сверкой состава заказа на
// производство, у строк которого этих полей нет, и добавление их в ключ заводило бы новую версию
// карты на каждом проведении заказа, а перенос состава новые значения не захватывал бы.
// Это половина сверки: тем, кому нужно решить «нужна ли новая версия карты», нужна ВерсияКартыУстарела -
// она проверяет и состав, и свойства, читая записанную версию один раз. Эта функция отвечает на более
// узкий вопрос «изменились ли только способ и процент» и тем разделением и ценна.
// Сравнение идёт по паре «материал + характеристика»: упаковка и количество - дело КлючСостава.
// Строка, которой в версии нет, отличием не считается: её ловит СоставОтличается.
//
// Параметры:
//  Регистратор - ДокументСсылка.ТехнологическаяКарта - версия, с которой сравниваем;
//                пустая ссылка - записанного состава нет, отличий не бывает.
//  Состав      - ТаблицаЗначений, ТабличнаяЧастьОбъекта, ДанныеФормыКоллекция, Неопределено -
//                строки с реквизитами Номенклатура, Характеристика, СпособИзготовления, ПроцентПотерь.
//
// Возвращаемое значение:
//  Булево - Истина, если состав нужно записывать новой версией.
//
Функция СвойстваИзготовленияОтличаются(Регистратор, Состав) Экспорт

	Если Состав = Неопределено Или Не ЗначениеЗаполнено(Регистратор) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СвойстваОтличаютсяОтЗаписанного(СоставТехкартыПоРегистратору(Регистратор), Состав);

КонецФункции

// Нужна ли карте новая версия: отличается состав, способ изготовления или процент потерь.
// Записанный состав читается один раз на оба сравнения - в отличие от пары
// СоставОтличается + СвойстваИзготовленияОтличаются, каждая из которых читает его сама.
//
// Параметры:
//  Регистратор - ДокументСсылка.ТехнологическаяКарта - версия, с которой сравниваем;
//                пустая ссылка - записанного состава нет.
//  Состав      - ТаблицаЗначений, ТабличнаяЧастьОбъекта, ДанныеФормыКоллекция, Неопределено -
//                строки состава.
//
// Возвращаемое значение:
//  Булево - Истина, если состав нужно записывать новой версией.
//
Функция ВерсияКартыУстарела(Регистратор, Состав) Экспорт

	Записанный = СоставТехкартыПоРегистратору(Регистратор);
	Если КлючСостава(Записанный) <> КлючСостава(Состав) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Состав = Неопределено Или Не ЗначениеЗаполнено(Регистратор) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СвойстваОтличаютсяОтЗаписанного(Записанный, Состав);

КонецФункции

// Строки состава, которые нельзя записать: у пары «материал + характеристика» способ изготовления или
// процент потерь расходятся со значениями первой её строки, либо процент отрицательный.
// Проверка общая для документа карты и карточки номенклатуры: свёртка состава берёт значения первой
// строки группы, поэтому расхождение иначе пропало бы молча, а в карточке номенклатуры отказ из
// проведения карты пришёл бы исключением уже после записи самого элемента.
//
// Параметры:
//  Состав - ТаблицаЗначений, ТабличнаяЧастьОбъекта, ДанныеФормыКоллекция, Неопределено - строки с
//           реквизитами Номенклатура, Характеристика, СпособИзготовления, ПроцентПотерь.
//
// Возвращаемое значение:
//  Массив из Структура - по одной на проблемную строку:
//   * Индекс - Число - индекс строки состава, с нуля.
//   * Поле   - Строка - имя реквизита строки, к которому привязывается сообщение.
//   * Текст  - Строка - локализованный текст ошибки.
//
Функция КонфликтыСвойствИзготовления(Состав) Экспорт

	Результат = Новый Массив;
	Если Состав = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ШаблонРасхождения = НСтр("ru = 'Материал ""%1"" указан в карте дважды с разными способом изготовления или процентом потерь';
		|fr = 'La matière « %1 » figure deux fois dans la gamme avec un mode de fabrication ou un pourcentage de pertes différents';
		|en = 'Material ""%1"" appears twice in the routing with a different manufacturing method or loss percentage';
		|es = 'El material «%1» aparece dos veces en la ruta con distinto método de fabricación o porcentaje de pérdidas'");
	ТекстПроцента = НСтр("ru = 'Процент потерь не может быть отрицательным';
		|fr = 'Le pourcentage de pertes ne peut pas être négatif';
		|en = 'The loss percentage cannot be negative';
		|es = 'El porcentaje de pérdidas no puede ser negativo'");
	Первые = Новый Соответствие;
	Индекс = -1;
	Для Каждого Стр Из Состав Цикл
		Индекс = Индекс + 1;
		Если Стр.ПроцентПотерь < 0 Тогда
			Описание = ОписаниеКонфликта(Индекс, "ПроцентПотерь", ТекстПроцента);
			Результат.Добавить(Описание);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючМатериала(Стр);
		Первая = Первые[Ключ];
		Если Первая = Неопределено Тогда
			Первые.Вставить(Ключ, Стр);
			Продолжить;
		КонецЕсли;
		// Сравниваются значения после подстановки умолчания, а не как введено: проверка заполнения идёт
		// до ПередЗаписью, и новая строка приходит с пустым способом. Без нормализации пара
		// «наше производство» + пустая строка была бы отказом там, где терять нечего.
		Если СпособИлиУмолчание(Первая) <> СпособИлиУмолчание(Стр)
			Или Первая.ПроцентПотерь <> Стр.ПроцентПотерь Тогда
			Текст = СтрШаблон(ШаблонРасхождения, Стр.Номенклатура);
			Описание = ОписаниеКонфликта(Индекс, "СпособИзготовления", Текст);
			Результат.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Предел глубины разворачивания технологических карт: сколько уровней материалов ниже продукции
// раскрывается (решение владельца 2026-09-18). Глубже - отказ с цепочкой, а не молчаливый обрыв.
//
// Возвращаемое значение:
//  Число - предельный уровень материалов; продукция - уровень 0, её материалы - уровень 1.
//
Функция ПределГлубиныРазворачивания() Экспорт
	Возврат 4;
КонецФункции

// Развёрнутая потребность: состав технологических карт в глубину, продукция -> полуфабрикат ->
// вложенный полуфабрикат -> материалы. Это НЕ состав карты: карта хранится и сверяется одним уровнем
// (см. СоставТехкарт), а здесь строится дерево до листьев для потребности, дефицита и автовыпуска.
// Подменять СоставТехкарт этой функцией нельзя: проведение заказа на производство сверяет состав его
// материалов с версией карты и при расхождении перезаписывает карту.
//
// Позиция остаётся листом, если:
//  - строка карты помечена способом изготовления «Переработчик» (значение «Оба» не останавливает:
//    материал делают и у нас тоже);
//  - позиция не производится по карте - правило Производство.ПроизводитсяПоТехкарте: способ
//    пополнения «Закупка» или «Оба» останавливают, «Производство» либо тип «Продукция»/«Полуфабрикат»
//    разворачивают;
//  - у позиции нет действующей карты либо карта отменена - это лист, а не ошибка;
//  - достигнут предел глубины - это уже ошибка с цепочкой.
// Цикл ловится набором пройденных позиций пути, а не пределом глубины: иначе кольцо приходило бы как
// «превышена глубина» там, где на самом деле A -> B -> A.
//
// Состав каждой позиции читается один раз за вызов: одна и та же позиция встречается под разными
// родителями и на разных уровнях. Кэш - в пределах вызова, не модуль повторного использования: карту
// пишут карточка номенклатуры и проведение заказа, и повторное использование отдавало бы устаревший
// состав до конца сеанса.
//
// Количество узла - на единицу продукции-владельца, в упаковке своей строки карты. Цепочка
// перемножается через базовые количества: количество строки карты задано в упаковке материала на
// БАЗОВУЮ единицу своей продукции, поэтому у первого уровня количество совпадает с количеством строки
// карты, как при одноуровневом заполнении.
//
// Параметры:
//  Продукция  - Массив из СправочникСсылка.Номенклатура, СправочникСсылка.Номенклатура - позиции,
//               чьи карты разворачиваются.
//  Дата       - Дата - момент среза карт; не заполнена - текущая дата сеанса.
//  СУпаковкой - Булево, Неопределено - опция «Использовать упаковку»; не задана - значение опции.
//               Без опции упаковка в результат не идёт и коэффициент упаковки равен единице - как в
//               заполнении материалов заказа (решение владельца 2026-09-10).
//
// Возвращаемое значение:
//  Структура - развёрнутая потребность:
//   * Строки - ТаблицаЗначений - узлы дерева в порядке обхода в глубину:
//      ** Продукция         - СправочникСсылка.Номенклатура - продукция-владелец (корень дерева).
//      ** Индекс            - Число - номер строки в этой таблице, с нуля.
//      ** ИндексРодителя    - Число - Индекс родительского узла; -1 у первого уровня.
//      ** Уровень           - Число - уровень материала, с единицы.
//      ** Номенклатура      - СправочникСсылка.Номенклатура - материал узла.
//      ** Характеристика    - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика материала.
//      ** Упаковка          - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка строки карты.
//      ** Количество        - Число - на единицу продукции-владельца, в упаковке узла.
//      ** КоличествоБазовое - Число - то же в базовых единицах материала.
//      ** СпособИзготовления - ПеречислениеСсылка.СпособыИзготовления - способ строки карты.
//      ** ПроцентПотерь     - Число - процент потерь строки карты.
//      ** Регистратор       - ДокументСсылка.ТехнологическаяКарта - версия карты, из которой взят узел.
//      ** ЕстьПотомки       - Булево - узел развёрнут; такой узел - не потребность, за него отвечают
//                             его листья.
//   * Ошибки - Массив из Структура - по одной на цикл и на превышение глубины:
//      ** Продукция - СправочникСсылка.Номенклатура - продукция-владелец дерева.
//      ** Текст     - Строка - локализованное сообщение с цепочкой.
//
Функция РазвернутыйСостав(Продукция, Дата = Неопределено, СУпаковкой = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Строки", НоваяТаблицаРазвернутогоСостава());
	Результат.Вставить("Ошибки", Новый Массив);
	Корни = ПозицииРазворачивания(Продукция);
	Если Корни.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если СУпаковкой = Неопределено Тогда
		СУпаковкой = ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку");
	КонецЕсли;
	Момент = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());

	Кэш = Новый Соответствие;
	Коэффициенты = Новый Соответствие;
	Разворачиваемые = Новый Массив;
	ДеревьяКорней = Новый Массив;
	Для Каждого Позиция Из Корни Цикл
		Корень = УзелРазворачивания(Позиция, Неопределено, 0, Позиция);
		ДеревьяКорней.Добавить(Корень);
		Разворачиваемые.Добавить(Корень);
	КонецЦикла;

	Уровень = 0;
	Пока Разворачиваемые.Количество() > 0 Цикл
		Уровень = Уровень + 1;
		// Составы читаются до проверки предела: по ним видно, есть ли у узла предельного уровня карта, то
		// есть превышение это или законный лист.
		ПрочитатьСоставыВКэш(Кэш, Разворачиваемые, Момент);
		Если Уровень > ПределГлубиныРазворачивания() Тогда
			// Строго до ДетиУровня: узел, привязанный к родителю, попал бы в дерево, у его родителя стало бы
			// ЕстьПотомки, и потребность ушла бы на уровень, который не поместился в предел.
			СообщитьОПревышенииГлубины(Результат.Ошибки, Разворачиваемые, Кэш);
			Прервать;
		КонецЕсли;
		Дети = ДетиУровня(Разворачиваемые, Кэш, Коэффициенты, СУпаковкой);
		Если Дети.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		// Цикл ищется на каждом созданном уровне, поэтому кольцо внутри предела глубины всегда приходит как
		// цикл: до сообщения о глубине доживают только по-настоящему длинные цепочки.
		Разворачиваемые = ОтобратьРазворачиваемые(Дети, Результат.Ошибки);
	КонецЦикла;

	ЗаполнитьСтрокиРазвернутогоСостава(Результат.Строки, ДеревьяКорней);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазрядностьСуммТехкарты()
	Возврат 2;
КонецФункции

// Ключ пары «материал + характеристика»: по нему сравниваются и переносятся способ изготовления и
// процент потерь. Упаковка в ключ не входит - регистр её не различает.
//
// Параметры:
//  Стр - СтрокаТаблицыЗначений, СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекции - строка состава.
//
// Возвращаемое значение:
//  Строка - ключ пары.
//
Функция КлючМатериала(Стр)
	Возврат XMLСтрока(Стр.Номенклатура) + "|" + XMLСтрока(Стр.Характеристика);
КонецФункции

// Отличаются ли способ изготовления или процент потерь состава от уже прочитанного состава версии.
//
// Параметры:
//  Записанный - ТаблицаЗначений - см. СоставТехкартыПоРегистратору.
//  Состав     - ТаблицаЗначений, ТабличнаяЧастьОбъекта, ДанныеФормыКоллекция - строки состава.
//
// Возвращаемое значение:
//  Булево - Истина, если значения разошлись хотя бы у одной пары «материал + характеристика».
//
Функция СвойстваОтличаютсяОтЗаписанного(Записанный, Состав)

	Записанные = Новый Соответствие;
	Для Каждого СтрокаВерсии Из Записанный Цикл
		Записанные.Вставить(КлючМатериала(СтрокаВерсии), СтрокаВерсии);
	КонецЦикла;
	Для Каждого Стр Из Состав Цикл
		СтрокаВерсии = Записанные[КлючМатериала(Стр)];
		Если СтрокаВерсии = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// С подстановкой умолчания, как и в проверке конфликтов: очищенный способ - это то же
		// «наше производство», и новой версии карты он требовать не должен.
		Если СпособИлиУмолчание(СтрокаВерсии) <> СпособИлиУмолчание(Стр)
			Или СтрокаВерсии.ПроцентПотерь <> Стр.ПроцентПотерь Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Способ изготовления строки с подстановкой умолчания: то значение, которое окажется в карте после
// записи (умолчание ставит ТехнологическаяКарта.ПередЗаписью).
//
// Параметры:
//  Стр - СтрокаТаблицыЗначений, СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекции - строка состава.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СпособыИзготовления - способ строки либо «наше производство».
//
Функция СпособИлиУмолчание(Стр)
	Возврат ?(ЗначениеЗаполнено(Стр.СпособИзготовления), Стр.СпособИзготовления,
		Перечисления.СпособыИзготовления.НашеПроизводство);
КонецФункции

// Описание строки состава, которую нельзя записать.
//
// Параметры:
//  Индекс - Число - индекс строки состава, с нуля.
//  Поле   - Строка - имя реквизита строки.
//  Текст  - Строка - локализованный текст ошибки.
//
// Возвращаемое значение:
//  Структура - Индекс, Поле, Текст.
//
Функция ОписаниеКонфликта(Индекс, Поле, Текст)
	Возврат Новый Структура("Индекс, Поле, Текст", Индекс, Поле, Текст);
КонецФункции

// Пустая таблица узлов развёрнутой потребности.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. РазвернутыйСостав, поле Строки.
//
Функция НоваяТаблицаРазвернутогоСостава()

	Таблица = Новый ТаблицаЗначений;
	ТипНоменклатуры = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
	ТипЧисла = Новый ОписаниеТипов("Число");
	Таблица.Колонки.Добавить("Продукция", ТипНоменклатуры);
	Таблица.Колонки.Добавить("Индекс", ТипЧисла);
	Таблица.Колонки.Добавить("ИндексРодителя", ТипЧисла);
	Таблица.Колонки.Добавить("Уровень", ТипЧисла);
	Таблица.Колонки.Добавить("Номенклатура", ТипНоменклатуры);
	Таблица.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Таблица.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Таблица.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Таблица.Колонки.Добавить("КоличествоБазовое", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Таблица.Колонки.Добавить("СпособИзготовления", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыИзготовления"));
	Таблица.Колонки.Добавить("ПроцентПотерь", Метаданные.ОпределяемыеТипы.Процент.Тип);
	Таблица.Колонки.Добавить("Регистратор", Новый ОписаниеТипов("ДокументСсылка.ТехнологическаяКарта"));
	Таблица.Колонки.Добавить("ЕстьПотомки", Новый ОписаниеТипов("Булево"));
	Возврат Таблица;

КонецФункции

// Позиции, чьи карты разворачиваются: массив без повторов и без незаполненных ссылок.
//
// Параметры:
//  Продукция - Массив, СправочникСсылка.Номенклатура - см. РазвернутыйСостав.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - позиции в порядке поступления.
//
Функция ПозицииРазворачивания(Продукция)

	Значения = ?(ТипЗнч(Продукция) = Тип("Массив"), Продукция, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Продукция));
	Результат = Новый Массив;
	Встреченные = Новый Соответствие;
	Для Каждого Значение Из Значения Цикл
		Если Не ЗначениеЗаполнено(Значение) Или Встреченные[Значение] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Встреченные.Вставить(Значение, Истина);
		Результат.Добавить(Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Узел дерева разворачивания. Родитель хранится ссылкой, а не набором пройденных позиций: глубина
// ограничена, а по ссылке строится и проверка цикла, и цепочка в сообщении.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - позиция узла; у корня - сама продукция.
//  Родитель     - Структура, Неопределено - родительский узел; Неопределено у корня.
//  Уровень      - Число - уровень материала; 0 у корня.
//  Продукция    - СправочникСсылка.Номенклатура - продукция-владелец дерева.
//
// Возвращаемое значение:
//  Структура - узел дерева; поля значений совпадают с колонками НоваяТаблицаРазвернутогоСостава.
//
Функция УзелРазворачивания(Номенклатура, Родитель, Уровень, Продукция)

	Узел = Новый Структура;
	Узел.Вставить("Продукция", Продукция);
	Узел.Вставить("Номенклатура", Номенклатура);
	Узел.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Узел.Вставить("Упаковка", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	Узел.Вставить("Количество", 0);
	// База цепочки: количества первого уровня умножаются на единицу и совпадают со строками карты.
	Узел.Вставить("КоличествоБазовое", 1);
	Узел.Вставить("СпособИзготовления", Перечисления.СпособыИзготовления.ПустаяСсылка());
	Узел.Вставить("ПроцентПотерь", 0);
	Узел.Вставить("Регистратор", Документы.ТехнологическаяКарта.ПустаяСсылка());
	Узел.Вставить("Уровень", Уровень);
	Узел.Вставить("Родитель", Родитель);
	Узел.Вставить("Потомки", Новый Массив);
	Возврат Узел;

КонецФункции

// Читает в кэш составы карт тех позиций разворачиваемых узлов, которых в кэше ещё нет: один запрос на
// уровень. Позиция без карты и позиция с отменённой картой получают пустой массив - это лист, и
// повторно она не запрашивается.
//
// Параметры:
//  Кэш   - Соответствие - ключ СправочникСсылка.Номенклатура, значение Массив из СтрокаТаблицыЗначений.
//  Узлы  - Массив из Структура - см. УзелРазворачивания.
//  Момент - Дата - момент среза карт.
//
Процедура ПрочитатьСоставыВКэш(Кэш, Узлы, Момент)

	Позиции = Новый Массив;
	Для Каждого Узел Из Узлы Цикл
		Если Кэш[Узел.Номенклатура] = Неопределено Тогда
			Кэш.Вставить(Узел.Номенклатура, Новый Массив);
			Позиции.Добавить(Узел.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Если Позиции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаКарты Из СоставТехкарт(Позиции, Момент) Цикл
		Кэш[СтрокаКарты.Продукция].Добавить(СтрокаКарты);
	КонецЦикла;

КонецПроцедуры

// Узлы следующего уровня по составам карт родителей. Количество узла - на единицу продукции-владельца:
// количество строки карты умножается на БАЗОВОЕ количество родителя, потому что норма карты задана на
// базовую единицу своей продукции.
//
// Параметры:
//  Родители     - Массив из Структура - см. УзелРазворачивания.
//  Кэш          - Соответствие - см. ПрочитатьСоставыВКэш.
//  Коэффициенты - Соответствие - ключ упаковка, значение Число; пополняется.
//  СУпаковкой   - Булево - см. РазвернутыйСостав.
//
// Возвращаемое значение:
//  Массив из Структура - созданные узлы; они же добавлены в Потомки своих родителей.
//
Функция ДетиУровня(Родители, Кэш, Коэффициенты, СУпаковкой)

	Дети = Новый Массив;
	ПустаяУпаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	Для Каждого Родитель Из Родители Цикл
		Для Каждого СтрокаКарты Из Кэш[Родитель.Номенклатура] Цикл
			Узел = УзелРазворачивания(СтрокаКарты.Номенклатура, Родитель, Родитель.Уровень + 1, Родитель.Продукция);
			Узел.Характеристика = СтрокаКарты.Характеристика;
			Узел.Упаковка = ?(СУпаковкой, СтрокаКарты.Упаковка, ПустаяУпаковка);
			Узел.Количество = Родитель.КоличествоБазовое * СтрокаКарты.Количество;
			Узел.КоличествоБазовое = Узел.Количество * КоэффициентУпаковки(Узел.Упаковка, Коэффициенты);
			Узел.СпособИзготовления = СтрокаКарты.СпособИзготовления;
			Узел.ПроцентПотерь = СтрокаКарты.ПроцентПотерь;
			Узел.Регистратор = СтрокаКарты.Регистратор;
			Родитель.Потомки.Добавить(Узел);
			Дети.Добавить(Узел);
		КонецЦикла;
	КонецЦикла;
	Возврат Дети;

КонецФункции

// Коэффициент упаковки с кэшем в пределах вызова. Пустая упаковка - единица: без функциональной опции
// «Использовать упаковку» количество считается по базовой единице, как в заполнении материалов заказа.
//
// Параметры:
//  Упаковка     - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка узла.
//  Коэффициенты - Соответствие - ключ упаковка, значение Число; пополняется.
//
// Возвращаемое значение:
//  Число - коэффициент пересчёта в базовые единицы.
//
Функция КоэффициентУпаковки(Упаковка, Коэффициенты)

	Если Не ЗначениеЗаполнено(Упаковка) Тогда
		Возврат 1;
	КонецЕсли;
	Коэффициент = Коэффициенты[Упаковка];
	Если Коэффициент = Неопределено Тогда
		Коэффициент = ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы(Упаковка);
		Коэффициенты.Вставить(Упаковка, Коэффициент);
	КонецЕсли;
	Возврат Коэффициент;

КонецФункции

// Узлы, которые разворачиваются дальше. Правило остановки проверяется раньше цикла: позиция, которая и
// так лист (закупается, делается переработчиком), кольцом не считается - разворачивание на ней
// кончается законно.
//
// Параметры:
//  Дети   - Массив из Структура - см. ДетиУровня.
//  Ошибки - Массив из Структура - пополняется описанием найденных циклов.
//
// Возвращаемое значение:
//  Массив из Структура - узлы для следующего уровня.
//
Функция ОтобратьРазворачиваемые(Дети, Ошибки)

	Позиции = Новый Массив;
	Для Каждого Узел Из Дети Цикл
		Позиции.Добавить(Узел.Номенклатура);
	КонецЦикла;
	Реквизиты = РеквизитыОстановки(Позиции);
	ШаблонЦикла = НСтр("ru = 'Технологические карты зациклены: %1. Разворачивание остановлено';
		|fr = 'Les gammes de fabrication forment une boucle : %1. Le développement est arrêté';
		|en = 'The production routings form a loop: %1. Expansion stopped';
		|es = 'Las rutas de fabricación forman un bucle: %1. El desarrollo se ha detenido'");
	Результат = Новый Массив;
	Для Каждого Узел Из Дети Цикл
		Если Узел.СпособИзготовления = Перечисления.СпособыИзготовления.Переработчик Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПозиции = Реквизиты[Узел.Номенклатура];
		Если СтрокаПозиции = Неопределено Или Не Производство.ПроизводитсяПоТехкарте(СтрокаПозиции) Тогда
			Продолжить;
		КонецЕсли;
		Если ПозицияВстречаласьВыше(Узел) Тогда
			Ошибки.Добавить(ОшибкаРазворачивания(Узел.Продукция, СтрШаблон(ШаблонЦикла, ЦепочкаУзла(Узел))));
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Узел);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Реквизиты правила остановки одним запросом на уровень: перебор ЗначениеРеквизитаОбъекта в цикле дал
// бы запрос на каждый узел дерева.
//
// Параметры:
//  Позиции - Массив из СправочникСсылка.Номенклатура - позиции уровня.
//
// Возвращаемое значение:
//  Соответствие - ключ СправочникСсылка.Номенклатура, значение Структура с полями ТипНоменклатуры и
//                 СпособПополнения: именно их читает Производство.ПроизводитсяПоТехкарте.
//
Функция РеквизитыОстановки(Позиции)

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СпрНоменклатура.Ссылка КАК Ссылка,
	                      |	СпрНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	                      |	СпрНоменклатура.СпособПополнения КАК СпособПополнения
	                      |ИЗ
	                      |	Справочник.Номенклатура КАК СпрНоменклатура
	                      |ГДЕ
	                      |	СпрНоменклатура.Ссылка В (&Позиции)");
	Запрос.УстановитьПараметр("Позиции", Позиции);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Реквизиты = Новый Структура("ТипНоменклатуры, СпособПополнения", Выборка.ТипНоменклатуры, Выборка.СпособПополнения);
		Результат.Вставить(Выборка.Ссылка, Реквизиты);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Встречалась ли позиция узла выше по цепочке, включая саму продукцию-владельца.
//
// Параметры:
//  Узел - Структура - см. УзелРазворачивания.
//
// Возвращаемое значение:
//  Булево - Истина, если цепочка замкнулась.
//
Функция ПозицияВстречаласьВыше(Узел)

	Предок = Узел.Родитель;
	Пока Предок <> Неопределено Цикл
		Если Предок.Номенклатура = Узел.Номенклатура Тогда
			Возврат Истина;
		КонецЕсли;
		Предок = Предок.Родитель;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Цепочка от продукции-владельца до узла для сообщения: «A -> B -> A».
//
// Параметры:
//  Узел - Структура - см. УзелРазворачивания.
//
// Возвращаемое значение:
//  Строка - представления позиций цепочки через стрелку.
//
Функция ЦепочкаУзла(Узел)

	Звенья = Новый Массив;
	Текущий = Узел;
	Пока Текущий <> Неопределено Цикл
		Звенья.Вставить(0, Строка(Текущий.Номенклатура));
		Текущий = Текущий.Родитель;
	КонецЦикла;
	Возврат СтрСоединить(Звенья, " → ");

КонецФункции

// Описание ошибки разворачивания.
//
// Параметры:
//  Продукция - СправочникСсылка.Номенклатура - продукция-владелец дерева.
//  Текст     - Строка - локализованное сообщение.
//
// Возвращаемое значение:
//  Структура - Продукция, Текст.
//
Функция ОшибкаРазворачивания(Продукция, Текст)
	Возврат Новый Структура("Продукция, Текст", Продукция, Текст);
КонецФункции

// Сообщения о превышении предела глубины: по одному на узел предельного уровня, у которого карта
// всё-таки есть. В цепочку добавляется первый материал его карты - тот уровень, который не поместился.
//
// Параметры:
//  Ошибки   - Массив из Структура - пополняется.
//  Родители - Массив из Структура - узлы предельного уровня.
//  Кэш      - Соответствие - см. ПрочитатьСоставыВКэш.
//
Процедура СообщитьОПревышенииГлубины(Ошибки, Родители, Кэш)

	Шаблон = НСтр("ru = 'Технологическая карта разворачивается глубже %1 уровней: %2. Разворачивание остановлено';
		|fr = 'La gamme de fabrication se développe au-delà de %1 niveaux : %2. Le développement est arrêté';
		|en = 'The production routing expands deeper than %1 levels: %2. Expansion stopped';
		|es = 'La ruta de fabricación se desarrolla más allá de %1 niveles: %2. El desarrollo se ha detenido'");
	Предел = Формат(ПределГлубиныРазворачивания(), "ЧН=0; ЧГ=0");
	Для Каждого Родитель Из Родители Цикл
		СтрокиКарты = Кэш[Родитель.Номенклатура];
		Если СтрокиКарты.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Цепочка = ЦепочкаУзла(Родитель) + " → " + Строка(СтрокиКарты[0].Номенклатура);
		Ошибки.Добавить(ОшибкаРазворачивания(Родитель.Продукция, СтрШаблон(Шаблон, Предел, Цепочка)));
	КонецЦикла;

КонецПроцедуры

// Переносит дерево узлов в таблицу в порядке обхода в глубину: так строки материалов заказа идут
// «материал первого уровня, полуфабрикат, его материалы», а не уровнями вперемешку.
//
// Параметры:
//  Строки - ТаблицаЗначений - см. НоваяТаблицаРазвернутогоСостава; пополняется.
//  Корни  - Массив из Структура - корневые узлы продукций.
//
Процедура ЗаполнитьСтрокиРазвернутогоСостава(Строки, Корни)

	Для Каждого Корень Из Корни Цикл
		ДобавитьУзлыВСтроки(Строки, Корень.Потомки, -1);
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Строки         - ТаблицаЗначений - см. НоваяТаблицаРазвернутогоСостава; пополняется.
//  Узлы           - Массив из Структура - узлы одного родителя.
//  ИндексРодителя - Число - Индекс родительской строки; -1 у первого уровня.
//
Процедура ДобавитьУзлыВСтроки(Строки, Узлы, ИндексРодителя)

	Для Каждого Узел Из Узлы Цикл
		Строка = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Узел);
		Строка.Индекс = Строки.Индекс(Строка);
		Строка.ИндексРодителя = ИндексРодителя;
		Строка.ЕстьПотомки = Узел.Потомки.Количество() > 0;
		ДобавитьУзлыВСтроки(Строки, Узел.Потомки, Строка.Индекс);
	КонецЦикла;

КонецПроцедуры

// Последняя закупочная цена единицы хранения по каждой паре материал/характеристика.
// Выборка сортируется до поиска: новая нулевая цена не подменяется старой положительной.
//
// Параметры:
//  Материалы - Массив - номенклатура состава.
//  Дата - Дата - момент расчёта.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Цена, Период.
//
Функция ПоследниеЦеныМатериалов(Материалы, Дата)

	Запрос = Новый Запрос("ВЫБРАТЬ
		|	Цены.Номенклатура КАК Номенклатура,
		|	Цены.Характеристика КАК Характеристика,
		|	Цены.ЦенаЕдиницыХранения КАК Цена,
		|	Цены.Период КАК Период
		|ИЗ РегистрСведений.ЦеныНоменклатурыПоставщиков.СрезПоследних(
		|	&Дата, Номенклатура В (&Материалы)) КАК Цены
		|УПОРЯДОЧИТЬ ПО Цены.Период УБЫВ, Цены.Регистратор УБЫВ, Цены.НомерСтроки УБЫВ");
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Материалы", Материалы);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Ограничивающий материал определяет выпуск; дробь усекается до точности количества.
//
// Параметры:
//  Состав - ТаблицаЗначений - строки рецептуры в базовых единицах.
//  Дата - Дата - момент остатков.
//
// Возвращаемое значение:
//  Число - возможное количество продукции, без закупок и переработки полуфабрикатов.
//
Функция ВыпускИзОстатков(Состав, Дата)

	Потребности = Состав.Скопировать(, "Номенклатура, Характеристика, Количество");
	Потребности.Свернуть("Номенклатура, Характеристика", "Количество");
	Запрос = Новый Запрос("ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.Характеристика КАК Характеристика,
		|	СУММА(Остатки.КоличествоОстаток) КАК Количество
		|ИЗ РегистрНакопления.ТоварыВНаличии.Остатки(&Дата, Номенклатура В (&Материалы)) КАК Остатки
		|СГРУППИРОВАТЬ ПО Остатки.Номенклатура, Остатки.Характеристика");
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Материалы", Потребности.ВыгрузитьКолонку("Номенклатура"));
	Остатки = Запрос.Выполнить().Выгрузить();
	Выпуск = Неопределено;
	Для Каждого Потребность Из Потребности Цикл
		Если Не ЗначениеЗаполнено(Потребность.Номенклатура) Или Потребность.Количество <= 0 Тогда
			Возврат 0;
		КонецЕсли;
		Ключ = Новый Структура("Номенклатура, Характеристика", Потребность.Номенклатура, Потребность.Характеристика);
		Найденные = Остатки.НайтиСтроки(Ключ);
		Остаток = ?(Найденные.Количество() = 0, 0, Макс(0, Найденные[0].Количество));
		ПоМатериалу = Остаток / Потребность.Количество;
		Выпуск = ?(Выпуск = Неопределено, ПоМатериалу, Мин(Выпуск, ПоМатериалу));
	КонецЦикла;
	Если Выпуск = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	ТочностьКоличества = 1000;
	Возврат Цел(Выпуск * ТочностьКоличества) / ТочностьКоличества;

КонецФункции

// Фактическая цена последней проведённой реализации с учётом скидок.
// Суммы реализации хранятся в валюте учёта; реквизитов валюты и курса у документа нет.
//
// Параметры:
//  Продукция - СправочникСсылка.Номенклатура - продукция карты.
//  Дата - Дата - момент расчёта.
//
// Возвращаемое значение:
//  Число - цена за единицу, с НДС, в валюте регламентированного учёта; нет продаж - 0.
//
Функция ПоследняяЦенаПродажи(Продукция, Дата)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	СУММА(Строки.СуммаСНДС) / СУММА(Строки.Количество) КАК Цена
		|ИЗ Документ.РеализацияТоваровУслуг.ТЧТовары КАК Строки
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Продажа ПО Строки.Ссылка = Продажа.Ссылка
		|ГДЕ Продажа.Проведен И НЕ Продажа.ПометкаУдаления И Продажа.Дата <= &Дата
		|	И Строки.Номенклатура = &Продукция И Строки.Количество > 0
		|СГРУППИРОВАТЬ ПО Продажа.Ссылка, Продажа.Дата
		|УПОРЯДОЧИТЬ ПО Продажа.Дата УБЫВ, Продажа.Ссылка УБЫВ");
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Продукция", Продукция);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Цена, 0);

КонецФункции

// Заготовка запроса: временные таблицы ВТВерсии и ВТСостав.
// ВТВерсии - период действующей на дату версии карты по каждой позиции продукции; строится
// без отбора по материалу, иначе отменённая карта откатилась бы к прежней версии.
// ВТСостав - строки этой версии без маркерной записи отмены.
//
// Параметры:
//  Продукция - Массив, СправочникСсылка.Номенклатура - позиции, чьи карты нужны.
//  Дата      - Дата - момент среза; не заполнена - текущая дата сеанса.
//
// Возвращаемое значение:
//  Запрос - с установленными параметрами Продукция и Дата; текст завершается разделителем
//           пакета, к нему дописывается итоговый запрос.
//
Функция ЗапросПоСоставу(Продукция, Дата)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Состав.Продукция КАК Продукция,
	                      |	МАКСИМУМ(Состав.Период) КАК Период
	                      |ПОМЕСТИТЬ ВТВерсии
	                      |ИЗ
	                      |	РегистрСведений.СоставТехКарты КАК Состав
	                      |ГДЕ
	                      |	Состав.Продукция В (&Продукция)
	                      |	И Состав.Период <= &Дата
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Состав.Продукция
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Состав.Продукция КАК Продукция,
	                      |	Состав.Регистратор КАК Регистратор,
	                      |	Состав.НомерСтроки КАК НомерСтроки,
	                      |	Состав.Материал КАК Номенклатура,
	                      |	Состав.Характеристика КАК Характеристика,
	                      |	Состав.Упаковка КАК Упаковка,
	                      |	Состав.Количество КАК Количество,
	                      |	Состав.СпособИзготовления КАК СпособИзготовления,
	                      |	Состав.ПроцентПотерь КАК ПроцентПотерь
	                      |ПОМЕСТИТЬ ВТСостав
	                      |ИЗ
	                      |	РегистрСведений.СоставТехКарты КАК Состав
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВерсии КАК ВТВерсии
	                      |		ПО Состав.Продукция = ВТВерсии.Продукция
	                      |			И Состав.Период = ВТВерсии.Период
	                      |ГДЕ
	                      |	Состав.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |");
	Запрос.УстановитьПараметр("Продукция", Продукция);
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса()));
	Возврат Запрос;
	
КонецФункции

// Записывает и проводит документ карты дня: существующий документ этого дня перезаписывается.
//
// Параметры:
//  Продукция    - СправочникСсылка.Номенклатура - продукция карты.
//  Состав       - ТаблицаЗначений, ТабличнаяЧастьОбъекта, ДанныеФормыКоллекция, Неопределено - строки состава
//                 с реквизитами Номенклатура, Характеристика, Упаковка, Количество и, если источник их
//                 знает, СпособИзготовления и ПроцентПотерь.
//  МоментЗаписи - Дата - начало дня версии.
//
// Возвращаемое значение:
//  ДокументСсылка.ТехнологическаяКарта - записанный документ.
//
Функция ЗаписатьДокументТехкарты(Продукция, Состав, МоментЗаписи)

	Ссылка = ДокументДня(Продукция, МоментЗаписи);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ДокОбъект = Ссылка.ПолучитьОбъект();
	Иначе
		ДокОбъект = Документы.ТехнологическаяКарта.СоздатьДокумент();
		ДокОбъект.Заполнить(Неопределено);
	КонецЕсли;
	ДокОбъект.Дата = МоментЗаписи;
	ДокОбъект.Номенклатура = Продукция;
	ДокОбъект.ТЧМатериалы.Очистить();
	Если Состав <> Неопределено Тогда
		Для Каждого Стр Из Состав Цикл
			НоваяСтрока = ДокОбъект.ТЧМатериалы.Добавить();
			// Список колонок не расширяется: источником бывает строка материалов заказа на производство,
			// где способа и процента нет, и явный список дал бы "Поле объекта не обнаружено" прямо в
			// проведении заказа. Заполнение свойств структуры без перечисления свойств копирует только
			// совпадающие имена, поэтому источник, который этих полей не знает, оставляет Неопределено.
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, "Номенклатура, Характеристика, Упаковка, Количество");
			Значения = Новый Структура("СпособИзготовления, ПроцентПотерь");
			ЗаполнитьЗначенияСвойств(Значения, Стр);
			Если Значения.СпособИзготовления <> Неопределено Тогда
				// Пустой способ не переносим: умолчание проставит ПередЗаписью объекта карты.
				НоваяСтрока.СпособИзготовления = Значения.СпособИзготовления;
			КонецЕсли;
			Если Значения.ПроцентПотерь <> Неопределено Тогда
				НоваяСтрока.ПроцентПотерь = Значения.ПроцентПотерь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Возврат ДокОбъект.Ссылка;

КонецФункции

// Проведённая или записанная карта продукции за тот же день, что и момент записи.
//
// Параметры:
//  Продукция - СправочникСсылка.Номенклатура - продукция карты.
//  Момент    - Дата - момент записи новой версии.
//
// Возвращаемое значение:
//  ДокументСсылка.ТехнологическаяКарта - последний документ этого дня либо пустая ссылка.
//
Функция ДокументДня(Продукция, Момент)
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Карта.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.ТехнологическаяКарта КАК Карта
	                      |ГДЕ
	                      |	Карта.Номенклатура = &Продукция
	                      |	И Карта.Дата МЕЖДУ &НачалоДня И &КонецДня
	                      |	И НЕ Карта.ПометкаУдаления
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Карта.Дата УБЫВ");
	Запрос.УстановитьПараметр("Продукция", Продукция);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Момент));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(Момент));
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Документы.ТехнологическаяКарта.ПустаяСсылка());
	
КонецФункции

// Сравнимое представление состава: отсортированный список строк «материал + характеристика +
// упаковка + количество». Сортировка убирает влияние порядка строк, формат с тремя знаками -
// влияние разрядности количества.
//
// Параметры:
//  Состав - ТаблицаЗначений, ТабличнаяЧастьОбъекта, ДанныеФормыКоллекция, Массив, Неопределено -
//           строки состава.
//  ИмяПоляКоличества - Строка - реквизит строки с количеством на единицу продукции.
//
// Возвращаемое значение:
//  Строка - представление состава для сравнения.
//
Функция КлючСостава(Состав, ИмяПоляКоличества = "Количество")
	
	Строки = Новый СписокЗначений;
	Если Состав <> Неопределено Тогда
		Для Каждого Стр Из Состав Цикл
			Ключ = XMLСтрока(Стр.Номенклатура) + "|" + XMLСтрока(Стр.Характеристика)
				+ "|" + XMLСтрока(Стр.Упаковка)
				+ "|" + Формат(Стр[ИмяПоляКоличества], "ЧДЦ=3; ЧРД=.; ЧГ=0");
			Строки.Добавить(Ключ);
		КонецЦикла;
	КонецЕсли;
	Строки.СортироватьПоЗначению();
	Результат = "";
	Для Каждого Элемент Из Строки Цикл
		Результат = Результат + Элемент.Значение + Символы.ПС;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

#КонецОбласти
