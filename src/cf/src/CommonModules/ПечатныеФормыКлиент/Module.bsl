////////////////////////////////////////////////////////////////////////////////
// Клиентская часть подсистемы печатных форм: единственная точка, из которой
// команды и формы запускают печать.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Открывает окно печати с указанными печатными формами объектов.
//
// Параметры:
//  ИмяМенеджераПечати - Строка               - полное имя объекта, чей модуль менеджера печатает
//  ИменаМакетов       - Строка               - имена макетов через запятую
//  ОбъектыПечати      - Массив, ЛюбаяСсылка  - печатаемые объекты или один объект
//  ВладелецФормы      - УправляемаяФорма     - форма, из которой запущена печать
//  ПараметрыПечати    - Структура            - произвольные параметры для модуля менеджера
//
Процедура ВыполнитьКомандуПечати(ИмяМенеджераПечати, ИменаМакетов, ОбъектыПечати,
	ВладелецФормы = Неопределено, ПараметрыПечати = Неопределено) Экспорт

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИмяМенеджераПечати", ИмяМенеджераПечати);
	ПараметрыФормы.Вставить("ИменаМакетов", ИменаМакетов);
	ПараметрыФормы.Вставить("ОбъектыПечати", МассивОбъектов(ОбъектыПечати));
	ПараметрыФормы.Вставить("ПараметрыПечати", ПараметрыПечати);

	ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ВладелецФормы);

КонецПроцедуры

// Печатает формы сразу на принтер, без окна предварительного просмотра.
//
// Параметры:
//  ИмяМенеджераПечати - Строка              - полное имя объекта, чей модуль менеджера печатает
//  ИменаМакетов       - Строка              - имена макетов через запятую
//  ОбъектыПечати      - Массив, ЛюбаяСсылка - печатаемые объекты или один объект
//  ИмяПринтера        - Строка              - принтер; пустая строка - принтер по умолчанию
//  ПараметрыПечати    - Структура           - произвольные параметры для модуля менеджера
//
Процедура ВыполнитьКомандуПечатиНаПринтер(ИмяМенеджераПечати, ИменаМакетов, ОбъектыПечати,
	ИмяПринтера = "", ПараметрыПечати = Неопределено) Экспорт

	ТабличныеДокументы = ПечатныеФормыВызовСервера.ТабличныеДокументы(ИмяМенеджераПечати, ИменаМакетов,
		МассивОбъектов(ОбъектыПечати), ПараметрыПечати);

	Для Каждого ТабличныйДокумент Из ТабличныеДокументы Цикл
		Если ЗначениеЗаполнено(ИмяПринтера) Тогда
			ТабличныйДокумент.ИмяПринтера = ИмяПринтера;
		КонецЕсли;
		ТабличныйДокумент.Напечатать(РежимИспользованияДиалогаПечати.НеИспользовать);
	КонецЦикла;

КонецПроцедуры

// Выводит стикеры на принтер этикеток: проверяет, что принтер установлен в системе,
// затем показывает документ или печатает его без диалога.
// Перенесено из ВыводПечатныхФормКлиент вместе с подсистемой печатных форм.
//
// Печать этикеток опирается на WMI, поэтому работает только под Windows - так было и раньше.
// BSLLS:UsingObjectNotAvailableUnix-off
//
// Параметры:
//  Таб                     - ТабличныйДокумент - подготовленные стикеры
//  ВысотаСтраницы          - Число             - высота стикера, мм (пока не используется)
//  ШиринаСтраницы          - Число             - ширина стикера, мм (пока не используется)
//  ПолеСлева               - Число             - левое поле, мм (пока не используется)
//  МасштабПечати           - Число             - масштаб печати, %
//  ПредварительныйПросмотр - Булево            - показать документ вместо печати
//
Процедура ВывестиСтикерыНаПринтер(Таб, ВысотаСтраницы, ШиринаСтраницы, ПолеСлева, МасштабПечати,
	ПредварительныйПросмотр = Ложь) Экспорт

	Если Не ПредварительныйПросмотр И Не ПринтерУстановлен(Таб.ИмяПринтера) Тогда
		ШаблонСообщения = НСтр("ru = 'Не найден принтер этикеток: %1';
			|fr = 'Imprimante d''étiquettes introuvable : %1';
			|en = 'Label printer not found: %1';
			|es = 'No se ha encontrado la impresora de etiquetas: %1'");
		ПоказатьПредупреждение(, СтрШаблон(ШаблонСообщения, СокрЛП(Таб.ИмяПринтера)));
		Возврат;
	КонецЕсли;

	Таб.АвтоМасштаб = Истина;
	Таб.ПолеСверху = 0;
	Таб.ПолеСнизу = 0;
	Таб.ПолеСлева = 0;
	Таб.ПолеСправа = 0;
	Таб.МасштабПечати = МасштабПечати;

	Если ПредварительныйПросмотр Тогда
		Таб.ОтображатьСетку = Истина;
		Таб.ОтображатьЗаголовки = Истина;
		Таб.Показать();
	Иначе
		Таб.Напечатать();
	КонецЕсли;

КонецПроцедуры

// Список принтеров, доступных на компьютере пользователя.
// Перенесено из ВыводПечатныхФормКлиент вместе с подсистемой печатных форм.
//
// Возвращаемое значение:
//  СписокЗначений - имена принтеров; пустой список, если получить их не удалось
//
Функция ПолучитьСписокПринтеров() Экспорт

	СписокПринтеров = Новый СписокЗначений;
	Для Каждого ИмяПринтера Из ИменаУстановленныхПринтеров() Цикл
		СписокПринтеров.Добавить(ИмяПринтера);
	КонецЦикла;

	Возврат СписокПринтеров;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Приводит объекты печати к массиву ссылок.
//
// Параметры:
//  ОбъектыПечати - Массив, ЛюбаяСсылка - печатаемые объекты или один объект
//
// Возвращаемое значение:
//  Массив - ссылки на печатаемые объекты
//
Функция МассивОбъектов(ОбъектыПечати)

	Если ТипЗнч(ОбъектыПечати) = Тип("Массив") Тогда
		Возврат ОбъектыПечати;
	КонецЕсли;

	Объекты = Новый Массив;
	Если ЗначениеЗаполнено(ОбъектыПечати) Тогда
		Объекты.Добавить(ОбъектыПечати);
	КонецЕсли;
	Возврат Объекты;

КонецФункции

// Установлен ли в системе принтер с указанным именем.
//
// Параметры:
//  ИмяПринтера - Строка - проверяемый принтер
//
// Возвращаемое значение:
//  Булево - Истина, если принтер найден
//
Функция ПринтерУстановлен(ИмяПринтера)

	Для Каждого Установленный Из ИменаУстановленныхПринтеров() Цикл
		Если НРег(СокрЛП(Установленный)) = НРег(СокрЛП(ИмяПринтера)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Имена принтеров, установленных на компьютере пользователя (Windows, WMI).
// Под другими операционными системами список пустой - печать этикеток там и не работала.
// BSLLS:UsingObjectNotAvailableUnix-off
//
// Возвращаемое значение:
//  Массив из Строка - имена принтеров
//
Функция ИменаУстановленныхПринтеров()

	Имена = Новый Массив;

	Попытка
		Локатор = Новый COMОбъект("WbemScripting.SWbemLocator");
		Сервисы = Локатор.ConnectServer(".");
		Принтеры = Сервисы.InstancesOf("Win32_Printer");
	Исключение
		Возврат Имена;
	КонецПопытки;

	Для Каждого Принтер Из Принтеры Цикл
		Имена.Добавить(СокрЛП(Принтер.Name));
	КонецЦикла;

	Возврат Имена;

КонецФункции

#КонецОбласти
