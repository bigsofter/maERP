////////////////////////////////////////////////////////////////////////////////
// Навигатор иерархии списков номенклатуры: форма списка, форма выбора и форма подбора (docs/plans/nomenclature-ui.md,
// этапы 2 и 5). Режимы, узлы со счётчиками и отбор узла - в модуле менеджера номенклатуры, здесь - общая работа с
// формой, чтобы три формы не копировали её.
//
// Форма-потребитель держит: реквизиты РежимИерархии, ИзбранныеРежимы, ВидУзла, ЗначениеУзла (savedData), таблицу
// значений УзлыИерархии (Значение, Представление, Количество, Вид), динамический список Список; элементы РежимИерархии
// (поле со списком выбора), КнопкаИзбранныйРежим, КнопкаОбновитьИерархию, УзлыИерархии, Список.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Подготовка формы при создании: запрос списка из модуля менеджера (тот же, что компонует сценарий), режим «Папки».
//
// Параметры:
//  Форма     - ФормаКлиентскогоПриложения - форма со списком номенклатуры
//  ДляВыбора - Булево - форма выбора или подбора: запрос без остатков и цен (ТекстЗапросаВыбора)
//
Процедура ПриСозданииНаСервере(Форма, ДляВыбора = Ложь) Экспорт

	Номенклатура = Справочники.Номенклатура;
	Форма.Список.ТекстЗапроса = ?(ДляВыбора, Номенклатура.ТекстЗапросаВыбора(), Номенклатура.ТекстЗапросаСписка());
	Форма.РежимИерархии = Номенклатура.РежимПапки();

КонецПроцедуры

// Режим иерархии: список режимов (избранные первыми), видимость навигатора, параметр свойства, узлы и отбор узла.
// Режима, которого больше нет (свойство удалено, производство выключено), - «Папки».
//
// Параметры:
//  Форма        - ФормаКлиентскогоПриложения - форма со списком номенклатуры
//  Контекст     - Структура - см. Справочники.Номенклатура.НовыйКонтекстСписка
//  ОтборыПанели - Структура - см. Справочники.Номенклатура.НовыеОтборыПанели
//
Процедура ПрименитьРежим(Форма, Контекст, ОтборыПанели) Экспорт

	Номенклатура = Справочники.Номенклатура;
	Режимы = Номенклатура.РежимыИерархии();
	Если Режимы.НайтиПоЗначению(Форма.РежимИерархии) = Неопределено Тогда
		Форма.РежимИерархии = Номенклатура.РежимПапки();
		Форма.ВидУзла = 0;
	КонецЕсли;
	ЗаполнитьСписокРежимов(Форма, Режимы);
	ЭтоПапки = Номенклатура.ПолеРежимаИерархии(Форма.РежимИерархии) = "";
	Форма.Элементы.УзлыИерархии.Видимость = Не ЭтоПапки;
	Форма.Элементы.КнопкаОбновитьИерархию.Видимость = Не ЭтоПапки;
	Форма.Список.Параметры.УстановитьЗначениеПараметра("СвойствоИерархии",
		Номенклатура.СвойствоРежимаИерархии(Форма.РежимИерархии));
	ОбновитьУзлы(Форма, Контекст, ОтборыПанели);
	ВыбратьУзел(Форма);

КонецПроцедуры

// Узлы навигатора со счётчиками по контексту и фильтрам панели.
//
// Параметры:
//  Форма        - ФормаКлиентскогоПриложения - форма со списком номенклатуры
//  Контекст     - Структура - см. Справочники.Номенклатура.НовыйКонтекстСписка
//  ОтборыПанели - Структура - см. Справочники.Номенклатура.НовыеОтборыПанели
//
Процедура ОбновитьУзлы(Форма, Контекст, ОтборыПанели) Экспорт

	Форма.УзлыИерархии.Загрузить(Справочники.Номенклатура.УзлыИерархии(Форма.РежимИерархии, Контекст, ОтборыПанели));

КонецПроцедуры

// Отбор узла - в группу «Иерархия» отбора списка; узла, которого больше нет, - «Все».
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма со списком номенклатуры
//
Процедура ВыбратьУзел(Форма) Экспорт

	Узлы = Форма.УзлыИерархии;
	Найденные = Узлы.НайтиСтроки(Новый Структура("Вид, Значение", Форма.ВидУзла, Форма.ЗначениеУзла));
	Если Найденные.Количество() = 0 Тогда
		Форма.ВидУзла = 0;
		Форма.ЗначениеУзла = Неопределено;
		Найденные = Узлы.НайтиСтроки(Новый Структура("Вид", 0));
	КонецЕсли;
	Если Найденные.Количество() > 0 Тогда
		Форма.Элементы.УзлыИерархии.ТекущаяСтрока = Найденные[0].ПолучитьИдентификатор();
	КонецЕсли;
	Справочники.Номенклатура.УстановитьОтборИерархии(Форма.Список.Отбор, Форма.РежимИерархии, Форма.ВидУзла,
		Форма.ЗначениеУзла);

КонецПроцедуры

// Добавляет текущий режим в избранные или убирает из них; избранные - первыми в списке выбора режима.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма со списком номенклатуры
//
Процедура ПереключитьИзбранныйРежим(Форма) Экспорт

	Избранные = СтрРазделить(Форма.ИзбранныеРежимы, ",", Ложь);
	Позиция = Избранные.Найти(Форма.РежимИерархии);
	Если Позиция = Неопределено Тогда
		Избранные.Добавить(Форма.РежимИерархии);
	Иначе
		Избранные.Удалить(Позиция);
	КонецЕсли;
	Форма.ИзбранныеРежимы = СтрСоединить(Избранные, ",");
	ЗаполнитьСписокРежимов(Форма, Справочники.Номенклатура.РежимыИерархии());

КонецПроцедуры

// Список плоский вне режима «Папки» или при отборе по реквизитам товара: папки отборы не проходят.
//
// Параметры:
//  Форма       - ФормаКлиентскогоПриложения - форма со списком номенклатуры
//  ЕстьОтборПанели - Булево - отбор панели по реквизитам товара
//
Процедура УстановитьОтображение(Форма, ЕстьОтборПанели = Ложь) Экспорт

	Плоский = ЕстьОтборПанели Или Справочники.Номенклатура.ПолеРежимаИерархии(Форма.РежимИерархии) <> "";
	Форма.Элементы.Список.Отображение = ?(Плоский, ОтображениеТаблицы.Список, ОтображениеТаблицы.ИерархическийСписок);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Избранные режимы - первыми в списке выбора; у текущего режима - звёздочка на кнопке.
//
// Параметры:
//  Форма  - ФормаКлиентскогоПриложения - форма со списком номенклатуры
//  Режимы - СписокЗначений - см. Справочники.Номенклатура.РежимыИерархии
//
Процедура ЗаполнитьСписокРежимов(Форма, Режимы)

	Избранные = СтрРазделить(Форма.ИзбранныеРежимы, ",", Ложь);
	Выбор = Форма.Элементы.РежимИерархии.СписокВыбора;
	Выбор.Очистить();
	Для Каждого Режим Из Режимы Цикл
		Если Избранные.Найти(Режим.Значение) <> Неопределено Тогда
			Выбор.Добавить(Режим.Значение, "★ " + Режим.Представление);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Режим Из Режимы Цикл
		Если Избранные.Найти(Режим.Значение) = Неопределено Тогда
			Выбор.Добавить(Режим.Значение, Режим.Представление);
		КонецЕсли;
	КонецЦикла;
	Форма.Элементы.КнопкаИзбранныйРежим.Заголовок = ?(Избранные.Найти(Форма.РежимИерархии) = Неопределено, "☆", "★");

КонецПроцедуры

#КонецОбласти
