#Область ПрограммныйИнтерфейс

// Контроль минимальной цены при проведении реализации (план docs/plans/retail-store-price.md, §2): цена строки не
// ниже порога склада - вида цен или себестоимости. Нарушение - отказ с перечнем строк; обход - роль-допуск
// ПродажаНижеМинимальнойЦены. Не проверяются: загрузка данных обменом, служебные перепроведения (признак
// фонового перепроведения или флаг СвойствоБезКонтроля) и реализация, записываемая кассой, - контроль кассы до
// оплаты появится сборкой 1.3, а отказ при проведении пришёл бы уже после оплаты.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - проводимая реализация (обычная или налоговая на основаниях).
//  Отказ     - Булево - выставляется при нарушении.
//
Процедура ПроверитьДокумент(ДокОбъект, Отказ) Экспорт
	Если ПроверкаНеНужна(ДокОбъект) Тогда
		Возврат;
	КонецЕсли;
	Результат = Нарушения(ДокОбъект);
	ПоказыватьСуммы = ПоказыватьСуммыПользователю();
	Для Каждого Текст Из Результат.Предупреждения Цикл
		Если ПоказыватьСуммы Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ДокОбъект);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Результат.ОшибкаНастройки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.ОшибкаНастройки, ДокОбъект, , , Отказ);
		Возврат;
	КонецЕсли;
	Если Результат.Нарушения.Количество() = 0 Или ДопускПродажиНижеМинимальной() Тогда
		Возврат;
	КонецЕсли;
	Текст = ТекстНарушений(Результат.Нарушения, ПоказыватьСуммы);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ДокОбъект, , , Отказ);
КонецПроцедуры

// Нарушения минимальной цены документа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - реализация; склад, дата, курс и строки берутся из неё.
//
// Возвращаемое значение:
//  Структура:
//   * Нарушения       - ТаблицаЗначений - НомерСтроки, Номенклатура, Цена, Порог, Основание (строки ниже порога).
//   * Предупреждения  - Массив из Строка - строки, проверенные мягко или не проверенные (нет цены, курса, партий).
//   * ОшибкаНастройки - Строка - непустая, если настройка контроля склада некорректна (контроль не отключается).
//
Функция Нарушения(ДокОбъект) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Нарушения", НоваяТаблицаНарушений());
	Результат.Вставить("Предупреждения", Новый Массив);
	Результат.Вставить("ОшибкаНастройки", "");
	Строки = СтрокиДокумента(ДокОбъект);
	Если Строки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ДокОбъект) Тогда
		Пороги = ПорогиНалоговойНаОснованиях(ДокОбъект, Строки, Результат);
	Иначе
		Пороги = ПорогиСклада(ДокОбъект, Строки, Результат);
	КонецЕсли;
	Если ЗначениеЗаполнено(Результат.ОшибкаНастройки) Тогда
		Возврат Результат;
	КонецЕсли;
	СравнитьСПорогами(Строки, Пороги, Результат);
	Возврат Результат;
КонецФункции

// Есть ли у текущего пользователя допуск к продаже ниже минимальной цены: роль ПродажаНижеМинимальнойЦены или
// Администратор. Проверка - по ролям пользователя информационной базы, а не РольДоступна: вызов идёт из проведения в
// привилегированном режиме. Пустой список пользователей - допуск есть.
//
// Возвращаемое значение:
//  Булево - Истина, если продажа ниже порога разрешена.
//
Функция ДопускПродажиНижеМинимальной() Экспорт
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПустаяСтрока(Пользователь.Имя) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Пользователь.Роли.Содержит(Метаданные.Роли.ПродажаНижеМинимальнойЦены)
		Или Пользователь.Роли.Содержит(Метаданные.Роли.Администратор);
КонецФункции

// Видит ли текущий пользователь суммы в сообщениях контроля: цена, себестоимость и закупочная оценка - финансовые
// показатели. Правило - как у сумм рабочего места производства (Обработки.АРМПроизводство.ПоказыватьСуммы): явная
// настройка «Видеть суммы (производство)», без неё оператору производства суммы не видны, администратору видны. Роли
// читаются у пользователя информационной базы: проверка идёт из проведения в привилегированном режиме.
//
// Возвращаемое значение:
//  Булево - Истина, если суммы можно показать.
//
Функция ПоказыватьСуммыПользователю() Экспорт
	Право = РегистрыСведений.НастройкиПользователей.ВидетьСуммыПроизводства();
	Если ТипЗнч(Право) = Тип("Булево") Тогда
		Возврат Право;
	КонецЕсли;
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПустаяСтрока(Пользователь.Имя) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Не Пользователь.Роли.Содержит(Метаданные.Роли.ОператорПроизводства)
		Или Пользователь.Роли.Содержит(Метаданные.Роли.Администратор);
КонецФункции

// Имя флага ДополнительныеСвойства, которым служебное перепроведение снимает контроль.
//
// Возвращаемое значение:
//  Строка - имя свойства.
//
Функция СвойствоБезКонтроля() Экспорт
	Возврат "БезКонтроляМинимальнойЦены";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ДанныеДокумента

// Нужна ли проверка: не нужна при загрузке данных, служебном перепроведении и записи кассой (сборка 1.3).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - документ.
//
// Возвращаемое значение:
//  Булево - Истина, если проверку пропускаем.
//
Функция ПроверкаНеНужна(ДокОбъект)
	Свойства = ДокОбъект.ДополнительныеСвойства;
	Если ДокОбъект.ОбменДанными.Загрузка
		Или Свойства.Свойство(РаботаСДокументами.СвойствоВыполняетсяФоновоеПерепроведение()) Тогда
		Возврат Истина;
	КонецЕсли;
	Значение = Неопределено;
	Если Свойства.Свойство(СвойствоБезКонтроля(), Значение) И Значение = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	// Касса: контроль до оплаты - сборка 1.3 (план, «Разбиение волны»).
	Возврат Свойства.Свойство("ЭтоИнтерфейсПродавца", Значение) И Значение = Истина;
КонецФункции

// Таблица нарушений.
//
// Возвращаемое значение:
//  ТаблицаЗначений - НомерСтроки, Номенклатура, Цена, Порог, Основание.
//
Функция НоваяТаблицаНарушений()
	ТипЧисло = Новый ОписаниеТипов("Число");
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("НомерСтроки", ТипЧисло);
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Цена", ТипЧисло);
	Таблица.Колонки.Добавить("Порог", ТипЧисло);
	Таблица.Колонки.Добавить("Основание", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;
КонецФункции

// Строки товаров документа в основной валюте: услуги и пустые количества отбрасываются.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - документ.
//
// Возвращаемое значение:
//  ТаблицаЗначений - НомерСтроки, КодСтроки, Номенклатура, Характеристика, Количество, СуммаСНДС, СуммаБезНДС, Комплект.
//
Функция СтрокиДокумента(ДокОбъект)
	Строки = Новый ТаблицаЗначений;
	Колонки = "НомерСтроки, КодСтроки, Номенклатура, Характеристика, Количество, СуммаСНДС, СуммаБезНДС, Комплект";
	Для Каждого Колонка Из СтрРазделить(Колонки, ", ", Ложь) Цикл
		Строки.Колонки.Добавить(Колонка);
	КонецЦикла;
	Если ДокОбъект.ТЧТовары.Количество() = 0 Тогда
		Возврат Строки;
	КонецЕсли;
	Номенклатура = ДокОбъект.ТЧТовары.ВыгрузитьКолонку("Номенклатура");
	Типы = ТипыНоменклатуры(Номенклатура);
	Курс = РаботаСВалютамиКлиентСервер.КурсДокумента(ДокОбъект);
	Услуга = Перечисления.ТипыНоменклатуры.Услуга;
	Для Каждого Стр Из ДокОбъект.ТЧТовары Цикл
		Тип = Типы[Стр.Номенклатура];
		Если Стр.Количество <= 0 Или Тип = Услуга Тогда
			Продолжить;
		КонецЕсли;
		Строка = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Стр, "НомерСтроки, КодСтроки, Номенклатура, Характеристика, Количество");
		Строка.СуммаСНДС = РаботаСВалютамиКлиентСервер.СуммаРегл(Стр.СуммаСНДС, Курс);
		СуммаБезНДС = Стр.СуммаСНДС - Стр.СуммаНДС;
		Строка.СуммаБезНДС = РаботаСВалютамиКлиентСервер.СуммаРегл(СуммаБезНДС, Курс);
		Строка.Комплект = (Тип = Перечисления.ТипыНоменклатуры.Комплект);
	КонецЦикла;
	Возврат Строки;
КонецФункции

// Типы номенклатуры одним запросом.
//
// Параметры:
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - товары.
//
// Возвращаемое значение:
//  Соответствие - ключ: номенклатура, значение: ПеречислениеСсылка.ТипыНоменклатуры.
//
Функция ТипыНоменклатуры(Номенклатура)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Номенклатура)");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Типы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Типы.Вставить(Выборка.Ссылка, Выборка.ТипНоменклатуры);
	КонецЦикла;
	Возврат Типы;
КонецФункции

#КонецОбласти

#Область Пороги

// Таблица порогов строк.
//
// Возвращаемое значение:
//  ТаблицаЗначений - НомерСтроки, Порог, СНДС (базис порога), Жесткий (Ложь - только предупреждение), Основание.
//
Функция НоваяТаблицаПорогов()
	ТипЧисло = Новый ОписаниеТипов("Число");
	ТипБулево = Новый ОписаниеТипов("Булево");
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("НомерСтроки", ТипЧисло);
	Таблица.Колонки.Добавить("Порог", ТипЧисло);
	Таблица.Колонки.Добавить("СНДС", ТипБулево);
	Таблица.Колонки.Добавить("Жесткий", ТипБулево);
	Таблица.Колонки.Добавить("Основание", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;
КонецФункции

// Добавляет порог строки.
//
// Параметры:
//  Пороги      - ТаблицаЗначений - см. НоваяТаблицаПорогов.
//  НомерСтроки - Число - номер строки документа.
//  Порог       - Число - порог за единицу хранения в основной валюте.
//  СНДС        - Булево - базис порога: с НДС или без.
//  Жесткий     - Булево - Ложь: нарушение даёт только предупреждение.
//  Основание   - Строка - чем задан порог.
//
Процедура ДобавитьПорог(Пороги, НомерСтроки, Порог, СНДС, Жесткий, Основание)
	Строка = Пороги.Добавить();
	Строка.НомерСтроки = НомерСтроки;
	Строка.Порог = Порог;
	Строка.СНДС = СНДС;
	Строка.Жесткий = Жесткий;
	Строка.Основание = Основание;
КонецПроцедуры

// Пороги строк обычной реализации - по режиму её склада.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - документ.
//  Строки    - ТаблицаЗначений - см. СтрокиДокумента.
//  Результат - Структура - см. Нарушения.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаПорогов.
//
Функция ПорогиСклада(ДокОбъект, Строки, Результат)
	Пороги = НоваяТаблицаПорогов();
	Склад = ДокОбъект.МестоХранения;
	Режим = Справочники.МестаХранения.РежимКонтроляМинимальнойЦены(Склад);
	Если Режим = Перечисления.РежимыКонтроляМинимальнойЦены.НеНижеВидаЦен Тогда
		ВидЦены = МинимальныйВидЦены(Склад, Результат);
		Если ЗначениеЗаполнено(ВидЦены) Тогда
			НомераСтрок = Строки.ВыгрузитьКолонку("НомерСтроки");
			ДобавитьПорогиВидаЦен(Пороги, Строки, НомераСтрок, ВидЦены, ДокОбъект.Дата, Результат);
		КонецЕсли;
	ИначеЕсли Режим = Перечисления.РежимыКонтроляМинимальнойЦены.НеНижеСебестоимости Тогда
		ДобавитьПорогиСебестоимостиСклада(Пороги, Строки, ДокОбъект, Результат);
	Иначе
		// Не контролировать - порогов нет.
		Возврат Пороги;
	КонецЕсли;
	Возврат Пороги;
КонецФункции

// Минимальный вид цены склада: пусто - «Минимальная цена продажи». Вид с динамическим расчётом - ошибка настройки:
// контроль не отключается молча.
//
// Параметры:
//  Склад     - СправочникСсылка.МестаХранения - склад.
//  Результат - Структура - см. Нарушения, заполняется ОшибкаНастройки.
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыЦен - вид или пустая ссылка при ошибке настройки.
//
Функция МинимальныйВидЦены(Склад, Результат)
	ВидЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "ВидЦеныМинимальный");
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		ВидЦены = Справочники.ВидыЦен.МинимальнаяЦенаПродажи;
	КонецЕсли;
	Если Справочники.МестаХранения.ВидЦеныДопустимДляСклада(ВидЦены, Ложь) Тогда
		Возврат ВидЦены;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Настройка контроля минимальной цены склада «%1» некорректна: минимальный вид цены «%2»
		|с динамическим расчётом. Исправьте настройку склада.';
		|fr = 'Le paramétrage du contrôle du prix minimal de l''entrepôt « %1 » est incorrect : le type de prix
		|minimal « %2 » est à calcul dynamique. Corrigez le paramétrage de l''entrepôt.';
		|en = 'The minimum price check setting of warehouse «%1» is incorrect: minimum price type «%2»
		|uses dynamic calculation. Correct the warehouse setting.';
		|es = 'La configuración del control del precio mínimo del almacén «%1» es incorrecta: el tipo de precio
		|mínimo «%2» usa cálculo dinámico. Corrija la configuración del almacén.'");
	Результат.ОшибкаНастройки = СтрШаблон(Шаблон, Склад, ВидЦены);
	Возврат Справочники.ВидыЦен.ПустаяСсылка();
КонецФункции

// Порог «не ниже вида цен»: строго цена вида на дату, без откатов на другие виды (нет цены по характеристике - по
// пустой характеристике), за единицу хранения, в основной валюте, в базисе НДС вида.
//
// Параметры:
//  Пороги      - ТаблицаЗначений - см. НоваяТаблицаПорогов.
//  Строки      - ТаблицаЗначений - см. СтрокиДокумента.
//  НомераСтрок - Массив из Число - строки, к которым относится порог.
//  ВидЦены     - СправочникСсылка.ВидыЦен - минимальный вид.
//  Дата        - Дата - дата цен.
//  Результат   - Структура - см. Нарушения, для предупреждений.
//  КэшВидов    - Соответствие, Неопределено - цены и пересчёт валюты по видам (налоговая на основаниях зовёт
//                процедуру на каждую связь строки - цены вида читаются один раз).
//
Процедура ДобавитьПорогиВидаЦен(Пороги, Строки, НомераСтрок, ВидЦены, Дата, Результат, КэшВидов = Неопределено)
	ДанныеВида = ?(КэшВидов = Неопределено, Неопределено, КэшВидов[ВидЦены]);
	Если ДанныеВида = Неопределено Тогда
		ДанныеВида = ДанныеВидаЦен(ВидЦены, Строки.ВыгрузитьКолонку("Номенклатура"), Дата);
		Если КэшВидов <> Неопределено Тогда
			КэшВидов.Вставить(ВидЦены, ДанныеВида);
		КонецЕсли;
	КонецЕсли;
	Цены = ДанныеВида.Цены;
	Основание = Строка(ВидЦены);
	Для Каждого Номер Из НомераСтрок Цикл
		Стр = Строки.Найти(Номер, "НомерСтроки");
		Если Стр = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Цена = ЦенаСтроки(Цены, Стр);
		Если Цена = Неопределено Тогда
			Шаблон = НСтр("ru = 'Строка %1: у «%2» нет цены вида «%3» - минимальная цена не проверена.';
				|fr = 'Ligne %1 : « %2 » n''a pas de prix du type « %3 » - le prix minimal n''est pas vérifié.';
				|en = 'Line %1: «%2» has no «%3» price - the minimum price is not checked.';
				|es = 'Línea %1: «%2» no tiene precio del tipo «%3»: el precio mínimo no se verifica.'");
			Результат.Предупреждения.Добавить(СтрШаблон(Шаблон, Стр.НомерСтроки, Стр.Номенклатура, ВидЦены));
			Продолжить;
		КонецЕсли;
		Если Не ДанныеВида.КурсНайден Тогда
			Шаблон = НСтр("ru = 'Строка %1: нет курса валюты вида цены «%2» на дату - минимальная цена не проверена.';
				|fr = 'Ligne %1 : pas de cours de la devise du type de prix « %2 » à la date - le prix minimal n''est pas vérifié.';
				|en = 'Line %1: no exchange rate for the currency of price type «%2» on the date - the minimum price is not checked.';
				|es = 'Línea %1: no hay tipo de cambio de la moneda del tipo de precio «%2» en la fecha: el precio mínimo no se verifica.'");
			Результат.Предупреждения.Добавить(СтрШаблон(Шаблон, Стр.НомерСтроки, ВидЦены));
			Продолжить;
		КонецЕсли;
		ДобавитьПорог(Пороги, Стр.НомерСтроки, Цена * ДанныеВида.Коэффициент, ДанныеВида.СНДС, Истина, Основание);
	КонецЦикла;
КонецПроцедуры

// Цены вида на дату и пересчёт его валюты в основную - одним разом на вид.
//
// Параметры:
//  ВидЦены      - СправочникСсылка.ВидыЦен - вид.
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - товары.
//  Дата         - Дата - дата цен и курса.
//
// Возвращаемое значение:
//  Структура:
//   * Цены        - Соответствие - см. ЦеныВида.
//   * Коэффициент - Число - множитель цены вида в основную валюту.
//   * КурсНайден  - Булево - Ложь, если курса валюты вида на дату нет.
//   * СНДС        - Булево - цены вида с НДС.
//
Функция ДанныеВидаЦен(ВидЦены, Номенклатура, Дата)
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидЦены, "Валюта, ЦенаВключаетНДС");
	КурсНайден = Истина;
	Коэффициент = РаботаСВалютами.ПересчитатьЦену(1, Реквизиты.Валюта, Неопределено, 1, Дата, КурсНайден);
	ДанныеВида = Новый Структура;
	ДанныеВида.Вставить("Цены", ЦеныВида(ВидЦены, Номенклатура, Дата));
	ДанныеВида.Вставить("Коэффициент", Коэффициент);
	ДанныеВида.Вставить("КурсНайден", КурсНайден);
	ДанныеВида.Вставить("СНДС", Реквизиты.ЦенаВключаетНДС = Истина);
	Возврат ДанныеВида;
КонецФункции

// Цена строки из соответствия цен: по характеристике, нет её - по пустой характеристике.
//
// Параметры:
//  Цены - Соответствие - см. ЦеныВида.
//  Стр  - СтрокаТаблицыЗначений - строка документа с Номенклатура и Характеристика.
//
// Возвращаемое значение:
//  Число, Неопределено - цена или Неопределено, если её нет.
//
Функция ЦенаСтроки(Цены, Стр)
	Цена = Цены[КлючЦены(Стр.Номенклатура, Стр.Характеристика)];
	Если Цена = Неопределено И ЗначениеЗаполнено(Стр.Характеристика) Тогда
		Пустая = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		Цена = Цены[КлючЦены(Стр.Номенклатура, Пустая)];
	КонецЕсли;
	Возврат Цена;
КонецФункции

// Цены вида на дату: последний период пары номенклатура + характеристика, при нескольких записях периода (измерение
// ТоварнаяГруппа) - максимум, как в Справочники.МестаХранения.ЦеныПродажиСклада.
//
// Параметры:
//  ВидЦены      - СправочникСсылка.ВидыЦен - вид.
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - товары.
//  Дата         - Дата - дата цен.
//
// Возвращаемое значение:
//  Соответствие - ключ КлючЦены, значение - цена.
//
Функция ЦеныВида(ВидЦены, Номенклатура, Дата)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Срез.Номенклатура КАК Номенклатура,
	|	Срез.Характеристика КАК Характеристика,
	|	Срез.Период КАК Период,
	|	Срез.Цена КАК Цена
	|ПОМЕСТИТЬ ВТСрез
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, ВидЦены = &ВидЦены И Номенклатура В (&Номенклатура)) КАК Срез
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСрез.Номенклатура КАК Номенклатура,
	|	ВТСрез.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ВТСрез.Период) КАК Период
	|ПОМЕСТИТЬ ВТПоследние
	|ИЗ
	|	ВТСрез КАК ВТСрез
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСрез.Номенклатура,
	|	ВТСрез.Характеристика
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПоследние.Номенклатура КАК Номенклатура,
	|	ВТПоследние.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ВТСрез.Цена) КАК Цена
	|ИЗ
	|	ВТПоследние КАК ВТПоследние
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСрез КАК ВТСрез
	|		ПО ВТПоследние.Номенклатура = ВТСрез.Номенклатура
	|			И ВТПоследние.Характеристика = ВТСрез.Характеристика
	|			И ВТПоследние.Период = ВТСрез.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПоследние.Номенклатура,
	|	ВТПоследние.Характеристика");
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Цены = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цены.Вставить(КлючЦены(Выборка.Номенклатура, Выборка.Характеристика), Выборка.Цена);
	КонецЦикла;
	Возврат Цены;
КонецФункции

// Ключ соответствия цен.
//
// Параметры:
//  Номенклатура   - СправочникСсылка.Номенклатура - товар.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика.
//
// Возвращаемое значение:
//  Строка - ключ.
//
Функция КлючЦены(Номенклатура, Характеристика)
	КлючХарактеристики = "";
	Если ЗначениеЗаполнено(Характеристика) Тогда
		КлючХарактеристики = Строка(Характеристика.УникальныйИдентификатор());
	КонецЕсли;
	Возврат Строка(Номенклатура.УникальныйИдентификатор()) + "|" + КлючХарактеристики;
КонецФункции

#КонецОбласти

#Область СебестоимостьСклада

// Порог «не ниже себестоимости» обычной реализации: максимум себестоимости единицы среди партий-кандидатов строки.
// Кандидаты - партии остатка склада на момент документа (исключая сам документ, поэтому первое проведение и
// перепроведение совпадают) и, на ордерном складе, партии ордеров, которые строка оформляет (пары оформления):
// оформленная часть строки - по партиям ордеров, неоформленная - по остатку.
//
// Параметры:
//  Пороги    - ТаблицаЗначений - см. НоваяТаблицаПорогов.
//  Строки    - ТаблицаЗначений - см. СтрокиДокумента.
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - документ.
//  Результат - Структура - см. Нарушения, для предупреждений.
//
Процедура ДобавитьПорогиСебестоимостиСклада(Пороги, Строки, ДокОбъект, Результат)
	Источники = ИсточникиСебестоимости(ДокОбъект, Строки);
	Для Каждого Стр Из Строки Цикл
		Если Стр.Комплект Тогда
			Шаблон = НСтр("ru = 'Строка %1: себестоимость комплекта «%2» не проверяется.';
				|fr = 'Ligne %1 : le coût du kit « %2 » n''est pas vérifié.';
				|en = 'Line %1: the cost of kit «%2» is not checked.';
				|es = 'Línea %1: el coste del kit «%2» no se verifica.'");
			Результат.Предупреждения.Добавить(СтрШаблон(Шаблон, Стр.НомерСтроки, Стр.Номенклатура));
			Продолжить;
		КонецЕсли;
		Кандидаты = КандидатыСтроки(Стр, Источники);
		ПорогСтроки = Неопределено;
		ЕстьНеоцененные = Ложь;
		Для Каждого Партия Из Кандидаты Цикл
			Если Источники.Неподтвержденные.Найти(Партия.Партия) <> Неопределено Тогда
				ЕстьНеоцененные = Истина;
			ИначеЕсли ПорогСтроки = Неопределено Или Партия.Себестоимость > ПорогСтроки Тогда
				ПорогСтроки = Партия.Себестоимость;
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЦикла;
		Если ПорогСтроки <> Неопределено Тогда
			ДобавитьПорог(Пороги, Стр.НомерСтроки, ПорогСтроки, Ложь, Истина, ОснованиеСебестоимость());
		КонецЕсли;
		Если ЕстьНеоцененные Тогда
			ДобавитьОценкуНеоцененных(Пороги, Стр, Источники, ДокОбъект.Дата, Результат);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Данные для себестоимости строк: партии остатка, пары и партии ордеров, неоценённые партии.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - документ.
//  Строки    - ТаблицаЗначений - см. СтрокиДокумента.
//
// Возвращаемое значение:
//  Структура:
//   * ПартииОстатка    - ТаблицаЗначений - см. ПартииОстатка.
//   * Пары             - ТаблицаЗначений, Неопределено - см. ПарыСтрок (только ордерный склад).
//   * ПартииОрдеров    - ТаблицаЗначений, Неопределено - см. ПартииОрдеров.
//   * Неподтвержденные - Массив - неоценённые партии.
//   * Номенклатура     - Массив - товары строк.
//   * ЗакупочныеЦены   - Соответствие, Неопределено - заполняется при первой неоценённой партии.
//
Функция ИсточникиСебестоимости(ДокОбъект, Строки)
	Склад = ДокОбъект.МестоХранения;
	Источники = Новый Структура;
	Источники.Вставить("Номенклатура", Строки.ВыгрузитьКолонку("Номенклатура"));
	Граница = Новый Граница(ДокОбъект.МоментВремени(), ВидГраницы.Исключая);
	Источники.Вставить("ПартииОстатка", ПартииОстатка(Склад, Источники.Номенклатура, Граница));
	Источники.Вставить("Пары", Неопределено);
	Источники.Вставить("ПартииОрдеров", Неопределено);
	Если Справочники.МестаХранения.ОрдерныйСклад(Склад, ДокОбъект.Дата) Тогда
		Источники.Пары = ПарыСтрок(ДокОбъект);
		Источники.ПартииОрдеров = ПартииОрдеров(Источники.Пары);
	КонецЕсли;
	Неподтвержденные = НеподтвержденныеСредиКандидатов(Источники.ПартииОстатка, Источники.ПартииОрдеров);
	Источники.Вставить("Неподтвержденные", Неподтвержденные);
	Источники.Вставить("ЗакупочныеЦены", Неопределено);
	Возврат Источники;
КонецФункции

// Партии-кандидаты строки: оформленная парами часть - партии ордеров, неоформленная - партии остатка.
//
// Параметры:
//  Стр       - СтрокаТаблицыЗначений - строка документа.
//  Источники - Структура - см. ИсточникиСебестоимости.
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений - партии с колонками Партия и Себестоимость.
//
Функция КандидатыСтроки(Стр, Источники)
	Кандидаты = Новый Массив;
	Покрыто = 0;
	Если Источники.Пары <> Неопределено Тогда
		ОтборПар = Новый Структура("КодСтроки", Стр.КодСтроки);
		Для Каждого Пара Из Источники.Пары.НайтиСтроки(ОтборПар) Цикл
			Покрыто = Покрыто + Пара.Количество;
			ОтборОрдера = Новый Структура("Ордер, КодСтроки", Пара.Ордер, Пара.КодСтрокиОрдера);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Кандидаты, Источники.ПартииОрдеров.НайтиСтроки(ОтборОрдера));
		КонецЦикла;
	КонецЕсли;
	Если Покрыто < Стр.Количество Тогда
		ОтборОстатка = Новый Структура("Номенклатура, Характеристика", Стр.Номенклатура, Стр.Характеристика);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Кандидаты, Источники.ПартииОстатка.НайтиСтроки(ОтборОстатка));
	КонецЕсли;
	Возврат Кандидаты;
КонецФункции

// Мягкий порог строки с неоценёнными партиями - по последней закупке позиции (план, §2).
//
// Параметры:
//  Пороги    - ТаблицаЗначений - см. НоваяТаблицаПорогов.
//  Стр       - СтрокаТаблицыЗначений - строка документа.
//  Источники - Структура - см. ИсточникиСебестоимости.
//  Дата      - Дата - дата цен закупки.
//  Результат - Структура - см. Нарушения, для предупреждений.
//
Процедура ДобавитьОценкуНеоцененных(Пороги, Стр, Источники, Дата, Результат)
	Если Источники.ЗакупочныеЦены = Неопределено Тогда
		Источники.ЗакупочныеЦены = ЗакупочныеЦеныБезНДС(Источники.Номенклатура, Дата);
	КонецЕсли;
	Оценка = Источники.ЗакупочныеЦены[КлючЦены(Стр.Номенклатура, Стр.Характеристика)];
	Если Оценка = Неопределено Тогда
		Шаблон = НСтр("ru = 'Строка %1: себестоимость части партий «%2» ещё не оформлена и не определена.';
			|fr = 'Ligne %1 : le coût d''une partie des lots de « %2 » n''est pas encore établi et reste indéterminé.';
			|en = 'Line %1: the cost of some «%2» batches is not finalized yet and cannot be determined.';
			|es = 'Línea %1: el coste de parte de los lotes de «%2» aún no está formalizado y no se puede determinar.'");
		Результат.Предупреждения.Добавить(СтрШаблон(Шаблон, Стр.НомерСтроки, Стр.Номенклатура));
		Возврат;
	КонецЕсли;
	Основание = НСтр("ru = 'последняя закупка, себестоимость партии ещё не оформлена';
		|fr = 'dernier achat, coût du lot pas encore établi';
		|en = 'last purchase, batch cost not finalized yet';
		|es = 'última compra, coste del lote aún no formalizado'");
	ДобавитьПорог(Пороги, Стр.НомерСтроки, Оценка, Ложь, Ложь, Основание);
КонецПроцедуры

// Основание порога себестоимости для сообщения.
//
// Возвращаемое значение:
//  Строка - текст.
//
Функция ОснованиеСебестоимость()
	Возврат НСтр("ru = 'себестоимость'; fr = 'coût de revient'; en = 'cost'; es = 'coste'");
КонецФункции

// Партии остатка склада по полному ключу с себестоимостью единицы без НДС: физическая стоимость ключа плюс
// дополнительные расходы партии, как в ТоварыВНаличии.ПолучитьСреднююЦенуПоОстаткам.
//
// Параметры:
//  Склад        - СправочникСсылка.МестаХранения - склад.
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - товары.
//  Граница      - Граница - момент остатков.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Серия, Партия, Количество, Сумма, Себестоимость.
//
Функция ПартииОстатка(Склад, Номенклатура, Граница)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	Остатки.Партия КАК Партия,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СуммаОстаток - Остатки.СуммаНДСОстаток КАК Сумма
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(&Граница, МестоХранения = &Склад И Номенклатура В (&Номенклатура)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	Остатки.Партия КАК Партия,
	|	СУММА(Остатки.СуммаОстаток - Остатки.СуммаНДСОстаток) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ДополнительныеРасходы.Остатки(&Граница, МестоХранения = &Склад И Номенклатура В (&Номенклатура)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика,
	|	Остатки.Серия,
	|	Остатки.Партия");
	Запрос.УстановитьПараметр("Граница", Граница);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Пакет = Запрос.ВыполнитьПакет();
	Возврат ПартииССебестоимостью(Пакет[0].Выгрузить(), Пакет[1].Выгрузить());
КонецФункции

// Себестоимость единицы ключей партий: физическая сумма ключа / количество плюс допрасходы партии на единицу (у них
// нет ДатаПартии и УУ - делятся между ключами партии пропорционально количеству).
//
// Параметры:
//  Ключи      - ТаблицаЗначений - Номенклатура, Характеристика, Серия, Партия, Количество, Сумма (без НДС).
//  Допрасходы - ТаблицаЗначений - Номенклатура, Характеристика, Серия, Партия, Сумма (без НДС).
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ключи с колонкой Себестоимость.
//
Функция ПартииССебестоимостью(Ключи, Допрасходы)
	ПоляПартии = "Номенклатура, Характеристика, Серия, Партия";
	ПоПартиям = Ключи.Скопировать(, ПоляПартии + ", Количество");
	ПоПартиям.Свернуть(ПоляПартии, "Количество");
	Ключи.Колонки.Добавить("Себестоимость", Новый ОписаниеТипов("Число"));
	Для Каждого Ключ Из Ключи Цикл
		Отбор = Новый Структура(ПоляПартии);
		ЗаполнитьЗначенияСвойств(Отбор, Ключ);
		Расходы = Допрасходы.НайтиСтроки(Отбор);
		Партия = ПоПартиям.НайтиСтроки(Отбор);
		НаЕдиницу = 0;
		Если Расходы.Количество() > 0 И Партия.Количество() > 0 И Партия[0].Количество > 0 Тогда
			НаЕдиницу = Расходы[0].Сумма / Партия[0].Количество;
		КонецЕсли;
		Ключ.Себестоимость = Ключ.Сумма / Ключ.Количество + НаЕдиницу;
	КонецЦикла;
	Возврат Ключи;
КонецФункции

// Пары оформления строк реализации ордерного склада. В точке проверки движения документа ещё не записаны:
// «ордер первым» - из набора ТоварыКОформлению в памяти (сформирован ОрдераСклада.СформироватьДвиженияОформления),
// «документ первый» (поздний ордер ссылается на реализацию) - из базы, только записи, где регистратор - ордер.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - документ.
//
// Возвращаемое значение:
//  ТаблицаЗначений - КодСтроки (строки реализации), Ордер, КодСтрокиОрдера, Количество.
//
Функция ПарыСтрок(ДокОбъект)
	Пары = Новый ТаблицаЗначений;
	Для Каждого Колонка Из СтрРазделить("КодСтроки, Ордер, КодСтрокиОрдера, Количество", ", ", Ложь) Цикл
		Пары.Колонки.Добавить(Колонка);
	КонецЦикла;
	ТипОрдера = Тип("ДокументСсылка.РасходныйОрдер");
	Для Каждого Запись Из ДокОбъект.Движения.ТоварыКОформлению Цикл
		Если Запись.ВидДвижения = ВидДвиженияНакопления.Расход И ТипЗнч(Запись.Источник) = ТипОрдера Тогда
			ДобавитьПару(Пары, Запись.КодСтрокиРегистратора, Запись.Источник, Запись.КлючСтрокиИсточника,
				Запись.Количество);
		КонецЕсли;
	КонецЦикла;
	Если ДокОбъект.Ссылка.Пустая() Тогда
		Возврат Пары;
	КонецЕсли;
	Документы = Новый Массив;
	Документы.Добавить(ДокОбъект.Ссылка);
	Для Каждого Пара Из РегистрыНакопления.ТоварыКОформлению.ПарыОформления(Документы) Цикл
		Если Пара.Регистратор <> ДокОбъект.Ссылка И Пара.Документ = ДокОбъект.Ссылка Тогда
			ДобавитьПару(Пары, Пара.КодСтрокиДокумента, Пара.Ордер, Пара.КодСтрокиОрдера, Пара.Количество);
		КонецЕсли;
	КонецЦикла;
	Возврат Пары;
КонецФункции

// Добавляет пару строки реализации и строки ордера.
//
// Параметры:
//  Пары            - ТаблицаЗначений - см. ПарыСтрок.
//  КодСтроки       - Число - код строки реализации.
//  Ордер           - ДокументСсылка.РасходныйОрдер - ордер.
//  КодСтрокиОрдера - Число - код строки ордера.
//  Количество      - Число - оформленное количество.
//
Процедура ДобавитьПару(Пары, КодСтроки, Ордер, КодСтрокиОрдера, Количество)
	Пара = Пары.Добавить();
	Пара.КодСтроки = КодСтроки;
	Пара.Ордер = Ордер;
	Пара.КодСтрокиОрдера = КодСтрокиОрдера;
	Пара.Количество = Количество;
КонецПроцедуры

// Партии расходных движений ТоварыВНаличии ордеров пар с себестоимостью единицы без НДС. Допрасходы на ордерном
// складе ордером не списываются (ТоварыВНаличии.ИсключитьЗаписиОрдерногоСклада) - порог по ним без допрасходов,
// ограничение записано в TECHDEBT.
//
// Параметры:
//  Пары - ТаблицаЗначений - см. ПарыСтрок.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ордер, КодСтроки, Партия, Себестоимость.
//
Функция ПартииОрдеров(Пары)
	Ордера = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Если Ордера.Найти(Пара.Ордер) = Неопределено Тогда
			Ордера.Добавить(Пара.Ордер);
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Движения.Регистратор КАК Ордер,
	|	Движения.КодСтроки КАК КодСтроки,
	|	Движения.Партия КАК Партия,
	|	ВЫРАЗИТЬ((Движения.Сумма - Движения.СуммаНДС) / Движения.Количество КАК ЧИСЛО(15, 4)) КАК Себестоимость
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Движения
	|ГДЕ
	|	Движения.Регистратор В (&Ордера)
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Движения.Активность
	|	И Движения.Количество > 0");
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Неоценённые партии среди кандидатов: действующая ТоварыВНаличии.НеподтвержденныеПартии (с замыканием по
// производственным цепочкам) - только если в базе включены ордерные склады и среди кандидатов есть партии ордерного
// или производного происхождения; иначе неоценённых партий нет по определению.
//
// Параметры:
//  ПартииОстатка - ТаблицаЗначений - см. ПартииОстатка.
//  ПартииОрдеров - ТаблицаЗначений, Неопределено - см. ПартииОрдеров.
//
// Возвращаемое значение:
//  Массив из ОпределяемыйТип.ПриходныйДокументПартии - неоценённые партии.
//
Функция НеподтвержденныеСредиКандидатов(ПартииОстатка, ПартииОрдеров)
	Если Не Справочники.МестаХранения.ОрдерныеСкладыВключены() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Партии = ПартииОстатка.ВыгрузитьКолонку("Партия");
	Если ПартииОрдеров <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Партии, ПартииОрдеров.ВыгрузитьКолонку("Партия"), Истина);
	КонецЕсли;
	Производные = Новый Массив;
	Производные.Добавить(Тип("ДокументСсылка.ПриходныйОрдер"));
	Производные.Добавить(Тип("ДокументСсылка.ВыпускПродукции"));
	Производные.Добавить(Тип("ДокументСсылка.ПересортицаТоваров"));
	Производные.Добавить(Тип("ДокументСсылка.АктРазбора"));
	Производные.Добавить(Тип("ДокументСсылка.ПоступлениеИзПереработки"));
	Для Каждого Партия Из Партии Цикл
		Если Производные.Найти(ТипЗнч(Партия)) <> Неопределено Тогда
			Возврат РегистрыНакопления.ТоварыВНаличии.НеподтвержденныеПартии();
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Массив;
КонецФункции

// Оценка себестоимости неоценённой партии по последней закупке позиции (мягкий порог, план §2): цена единицы
// хранения из прайса поставщиков - с НДС, ставка той закупки не сохранена; НДС исключается по ставке номенклатуры.
//
// Параметры:
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - товары.
//  Дата         - Дата - дата цен.
//
// Возвращаемое значение:
//  Соответствие - ключ КлючЦены, значение - цена без НДС.
//
Функция ЗакупочныеЦеныБезНДС(Номенклатура, Дата)
	СтоПроцентов = 100;
	Цены = Новый Соответствие;
	Прайс = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(Дата, Номенклатура);
	Ставки = Новый Соответствие;
	Для Каждого Стр Из Прайс Цикл
		Ставка = Ставки[Стр.Номенклатура];
		Если Ставка = Неопределено Тогда
			СтавкаНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Номенклатура, "СтавкаНДС");
			Ставка = ОбщегоНазначенияВызовСервераПовтИсп.ПроцентСтавкиНДС(СтавкаНДС);
			Ставки.Вставить(Стр.Номенклатура, Ставка);
		КонецЕсли;
		Цены.Вставить(КлючЦены(Стр.Номенклатура, Стр.Характеристика), Стр.Цена / (1 + Ставка / СтоПроцентов));
	КонецЦикла;
	Возврат Цены;
КонецФункции

#КонецОбласти

#Область НалоговаяНаОснованиях

// Пороги строк налоговой реализации на основаниях. Режим - по складу основания строки (основания могут быть с разных
// складов, шапку заполняет первое); порог строки - максимум по её контролируемым основаниям. Себестоимость оснований
// читается под разделяемой блокировкой, которую ставит НалоговыеДокументыНаОснованиях.ПровестиДокумент.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - налоговая реализация на основаниях.
//  Строки    - ТаблицаЗначений - см. СтрокиДокумента.
//  Результат - Структура - см. Нарушения.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаПорогов.
//
Функция ПорогиНалоговойНаОснованиях(ДокОбъект, Строки, Результат)
	Пороги = НоваяТаблицаПорогов();
	Связи = ДокОбъект.Основания.Выгрузить(, "КодСтроки, Основание");
	Связи.Свернуть("КодСтроки, Основание");
	Основания = Связи.ВыгрузитьКолонку("Основание");
	Контекст = Новый Структура;
	Контекст.Вставить("Склады", ОбщегоНазначения.ЗначенияРеквизитовОбъектовРазныхТипов(Основания, "МестоХранения"));
	Контекст.Вставить("Основания", Основания);
	Контекст.Вставить("Себестоимости", Неопределено);
	Контекст.Вставить("КэшВидов", Новый Соответствие);
	Контекст.Вставить("НастройкиСкладов", Новый Соответствие);
	Для Каждого Связь Из Связи Цикл
		Стр = Строки.Найти(Связь.КодСтроки, "КодСтроки");
		Если Стр = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьПорогОснования(Пороги, Строки, Стр, Связь.Основание, Контекст, ДокОбъект.Дата, Результат);
		Если ЗначениеЗаполнено(Результат.ОшибкаНастройки) Тогда
			Возврат Пороги;
		КонецЕсли;
	КонецЦикла;
	Возврат Пороги;
КонецФункции

// Порог строки налоговой реализации по одному её основанию - по режиму склада основания.
//
// Параметры:
//  Пороги    - ТаблицаЗначений - см. НоваяТаблицаПорогов.
//  Строки    - ТаблицаЗначений - см. СтрокиДокумента.
//  Стр       - СтрокаТаблицыЗначений - строка документа.
//  Основание - ДокументСсылка.РеализацияТоваровУслуг - основание строки.
//  Контекст  - Структура - Склады, Основания и кэши: Себестоимости (см. СебестоимостьОснований), КэшВидов
//              (см. ДанныеВидаЦен), НастройкиСкладов (режим и минимальный вид склада).
//  Дата      - Дата - дата документа.
//  Результат - Структура - см. Нарушения.
//
Процедура ДобавитьПорогОснования(Пороги, Строки, Стр, Основание, Контекст, Дата, Результат)
	Настройка = НастройкаСкладаОснования(Контекст.Склады[Основание].МестоХранения, Контекст, Результат);
	Режим = Настройка.Режим;
	Если Режим = Перечисления.РежимыКонтроляМинимальнойЦены.НеНижеВидаЦен Тогда
		ВидЦены = Настройка.ВидЦены;
		Если ЗначениеЗаполнено(ВидЦены) Тогда
			Номера = Новый Массив;
			Номера.Добавить(Стр.НомерСтроки);
			ДобавитьПорогиВидаЦен(Пороги, Строки, Номера, ВидЦены, Дата, Результат, Контекст.КэшВидов);
		КонецЕсли;
	ИначеЕсли Режим = Перечисления.РежимыКонтроляМинимальнойЦены.НеНижеСебестоимости Тогда
		Если Контекст.Себестоимости = Неопределено Тогда
			Номенклатура = Строки.ВыгрузитьКолонку("Номенклатура");
			Контекст.Себестоимости = СебестоимостьОснований(Контекст.Основания, Номенклатура);
		КонецЕсли;
		Отбор = Новый Структура("ДокументПродажи, Номенклатура, Характеристика");
		Отбор.ДокументПродажи = Основание;
		Отбор.Номенклатура = Стр.Номенклатура;
		Отбор.Характеристика = Стр.Характеристика;
		ПорогСтроки = Неопределено;
		Для Каждого Партия Из Контекст.Себестоимости.НайтиСтроки(Отбор) Цикл
			ПорогСтроки = ?(ПорогСтроки = Неопределено, Партия.Себестоимость, Макс(ПорогСтроки, Партия.Себестоимость));
		КонецЦикла;
		Если ПорогСтроки <> Неопределено Тогда
			ДобавитьПорог(Пороги, Стр.НомерСтроки, ПорогСтроки, Ложь, Истина, ОснованиеСебестоимость());
		КонецЕсли;
	Иначе
		// Склад основания не контролируется.
		Возврат;
	КонецЕсли;
КонецПроцедуры

// Режим контроля и минимальный вид склада основания - один раз на склад.
//
// Параметры:
//  Склад     - СправочникСсылка.МестаХранения - склад основания.
//  Контекст  - Структура - см. ДобавитьПорогОснования, кэш НастройкиСкладов.
//  Результат - Структура - см. Нарушения, ОшибкаНастройки.
//
// Возвращаемое значение:
//  Структура - Режим (ПеречислениеСсылка.РежимыКонтроляМинимальнойЦены), ВидЦены (СправочникСсылка.ВидыЦен).
//
Функция НастройкаСкладаОснования(Склад, Контекст, Результат)
	Настройка = Контекст.НастройкиСкладов[Склад];
	Если Настройка <> Неопределено Тогда
		Возврат Настройка;
	КонецЕсли;
	Настройка = Новый Структура("Режим, ВидЦены", Справочники.МестаХранения.РежимКонтроляМинимальнойЦены(Склад));
	Если Настройка.Режим = Перечисления.РежимыКонтроляМинимальнойЦены.НеНижеВидаЦен Тогда
		Настройка.ВидЦены = МинимальныйВидЦены(Склад, Результат);
	КонецЕсли;
	Контекст.НастройкиСкладов.Вставить(Склад, Настройка);
	Возврат Настройка;
КонецФункции

// Себестоимость единицы партий оснований по записям СебестоимостьПродаж (код строки реализации регистр не хранит):
// физика - по полному ключу (с ДатаПартии); допрасходы партии (без ДатаПартии) - пропорционально количеству ключей
// партии; допрасходы без партии (собственные допрасходы ордерного склада) - на все партии товара основания.
//
// Параметры:
//  Основания    - Массив из ДокументСсылка - основания.
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - товары.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ДокументПродажи, Номенклатура, Характеристика, Серия, Партия, Количество, Сумма, Себестоимость.
//
Функция СебестоимостьОснований(Основания, Номенклатура)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Записи.ДокументПродажи КАК ДокументПродажи,
	|	Записи.Номенклатура КАК Номенклатура,
	|	Записи.Характеристика КАК Характеристика,
	|	Записи.Серия КАК Серия,
	|	Записи.Партия КАК Партия,
	|	Записи.ДатаПартии КАК ДатаПартии,
	|	Записи.ДополнительныйРасход КАК ДополнительныйРасход,
	|	СУММА(Записи.Количество) КАК Количество,
	|	СУММА(Записи.Сумма - Записи.СуммаНДС) КАК Сумма
	|ИЗ
	|	РегистрНакопления.СебестоимостьПродаж КАК Записи
	|ГДЕ
	|	Записи.ДокументПродажи В (&Основания)
	|	И Записи.Номенклатура В (&Номенклатура)
	|	И Записи.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	Записи.ДокументПродажи,
	|	Записи.Номенклатура,
	|	Записи.Характеристика,
	|	Записи.Серия,
	|	Записи.Партия,
	|	Записи.ДатаПартии,
	|	Записи.ДополнительныйРасход");
	Запрос.УстановитьПараметр("Основания", Основания);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Записи = Запрос.Выполнить().Выгрузить();
	Физика = Записи.СкопироватьКолонки();
	Допрасходы = Записи.СкопироватьКолонки();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ДополнительныйРасход Тогда
			ЗаполнитьЗначенияСвойств(Допрасходы.Добавить(), Запись);
		ИначеЕсли Запись.Количество > 0 Тогда
			ЗаполнитьЗначенияСвойств(Физика.Добавить(), Запись);
		Иначе
			// Сторнированная физика (возвраты) - не партия остатка продажи.
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Допрасходы.Свернуть("ДокументПродажи, Номенклатура, Характеристика, Серия, Партия", "Сумма");
	Физика.Колонки.Добавить("Себестоимость", Новый ОписаниеТипов("Число"));
	Для Каждого Ключ Из Физика Цикл
		Ключ.Себестоимость = Ключ.Сумма / Ключ.Количество + ДопрасходыКлючаОснования(Ключ, Физика, Допрасходы);
	КонецЦикла;
	Возврат Физика;
КонецФункции

// Допрасходы на единицу ключа партии основания: своей партии и без партии.
//
// Параметры:
//  Ключ       - СтрокаТаблицыЗначений - ключ физики.
//  Физика     - ТаблицаЗначений - все ключи физики.
//  Допрасходы - ТаблицаЗначений - допрасходы, свёрнутые по партии.
//
// Возвращаемое значение:
//  Число - допрасходы на единицу.
//
Функция ДопрасходыКлючаОснования(Ключ, Физика, Допрасходы)
	ОтборПартии = Новый Структура("ДокументПродажи, Номенклатура, Характеристика, Серия, Партия");
	ЗаполнитьЗначенияСвойств(ОтборПартии, Ключ);
	СвоейПартии = ДопрасходыНаЕдиницу(Допрасходы.НайтиСтроки(ОтборПартии), Физика.НайтиСтроки(ОтборПартии));
	ОтборТовара = Новый Структура("ДокументПродажи, Номенклатура, Характеристика");
	ЗаполнитьЗначенияСвойств(ОтборТовара, Ключ);
	БезПартии = Новый Массив;
	Для Каждого Расход Из Допрасходы.НайтиСтроки(ОтборТовара) Цикл
		Если Не ЗначениеЗаполнено(Расход.Партия) Тогда
			БезПартии.Добавить(Расход);
		КонецЕсли;
	КонецЦикла;
	Возврат СвоейПартии + ДопрасходыНаЕдиницу(БезПартии, Физика.НайтиСтроки(ОтборТовара));
КонецФункции

// Сумма допрасходов на единицу количества ключей.
//
// Параметры:
//  Расходы - Массив из СтрокаТаблицыЗначений - допрасходы с колонкой Сумма.
//  Ключи   - Массив из СтрокаТаблицыЗначений - ключи физики с колонкой Количество.
//
// Возвращаемое значение:
//  Число - допрасходы на единицу; 0, если количества нет.
//
Функция ДопрасходыНаЕдиницу(Расходы, Ключи)
	Сумма = 0;
	Для Каждого Расход Из Расходы Цикл
		Сумма = Сумма + Расход.Сумма;
	КонецЦикла;
	Количество = 0;
	Для Каждого Ключ Из Ключи Цикл
		Количество = Количество + Ключ.Количество;
	КонецЦикла;
	Возврат ?(Количество > 0, Сумма / Количество, 0);
КонецФункции

#КонецОбласти

#Область Сравнение

// Сравнение строк с порогами: сумма строки (в базисе НДС порога) не меньше Окр(Порог * Количество, 2) - 0,01 -
// допуск одна копейка на строку независимо от количества. Мягкий порог - предупреждение, жёсткий - нарушение.
//
// Параметры:
//  Строки    - ТаблицаЗначений - см. СтрокиДокумента.
//  Пороги    - ТаблицаЗначений - см. НоваяТаблицаПорогов.
//  Результат - Структура - см. Нарушения.
//
Процедура СравнитьСПорогами(Строки, Пороги, Результат)
	Копейка = 0.01;
	Разрядность = 2;
	Для Каждого Стр Из Строки Цикл
		ОтборПорогов = Новый Структура("НомерСтроки", Стр.НомерСтроки);
		Для Каждого Порог Из Пороги.НайтиСтроки(ОтборПорогов) Цикл
			Сумма = ?(Порог.СНДС, Стр.СуммаСНДС, Стр.СуммаБезНДС);
			Минимум = Окр(Порог.Порог * Стр.Количество, Разрядность);
			Если Сумма >= Минимум - Копейка Тогда
				Продолжить;
			КонецЕсли;
			Цена = Окр(Сумма / Стр.Количество, Разрядность);
			ПорогЦены = Окр(Порог.Порог, Разрядность);
			Если Порог.Жесткий Тогда
				Нарушение = Результат.Нарушения.Добавить();
				Нарушение.НомерСтроки = Стр.НомерСтроки;
				Нарушение.Номенклатура = Стр.Номенклатура;
				Нарушение.Цена = Цена;
				Нарушение.Порог = ПорогЦены;
				Нарушение.Основание = Порог.Основание;
			Иначе
				Шаблон = НСтр("ru = 'Строка %1: цена «%2» %3 ниже оценки %4 (%5).';
					|fr = 'Ligne %1 : le prix de « %2 » %3 est inférieur à l''estimation %4 (%5).';
					|en = 'Line %1: the price of «%2» %3 is below the estimate %4 (%5).';
					|es = 'Línea %1: el precio de «%2» %3 es inferior a la estimación %4 (%5).'");
				Текст = СтрШаблон(Шаблон, Стр.НомерСтроки, Стр.Номенклатура, Цена, ПорогЦены, Порог.Основание);
				Результат.Предупреждения.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Текст отказа: перечень строк ниже порога и подсказка про роль-допуск. Без права видеть суммы - строки и основание
// порога без цены и порога.
//
// Параметры:
//  Нарушения       - ТаблицаЗначений - см. НоваяТаблицаНарушений.
//  ПоказыватьСуммы - Булево - см. ПоказыватьСуммыПользователю.
//
// Возвращаемое значение:
//  Строка - текст отказа.
//
Функция ТекстНарушений(Нарушения, ПоказыватьСуммы)
	Тексты = Новый Массив;
	Тексты.Добавить(НСтр("ru = 'Цена ниже минимальной для склада, продажа не проведена:';
		|fr = 'Prix inférieur au minimum de l''entrepôt, la vente n''est pas validée :';
		|en = 'The price is below the warehouse minimum, the sale is not posted:';
		|es = 'El precio es inferior al mínimo del almacén, la venta no se contabiliza:'"));
	Шаблон = НСтр("ru = 'строка %1: «%2» - цена %3, порог %4 (%5)';
		|fr = 'ligne %1 : « %2 » - prix %3, seuil %4 (%5)';
		|en = 'line %1: «%2» - price %3, threshold %4 (%5)';
		|es = 'línea %1: «%2» - precio %3, umbral %4 (%5)'");
	ШаблонБезСумм = НСтр("ru = 'строка %1: «%2» - цена ниже порога (%3)';
		|fr = 'ligne %1 : « %2 » - prix inférieur au seuil (%3)';
		|en = 'line %1: «%2» - price below the threshold (%3)';
		|es = 'línea %1: «%2» - precio inferior al umbral (%3)'");
	Для Каждого Нарушение Из Нарушения Цикл
		Если ПоказыватьСуммы Тогда
			Текст = СтрШаблон(Шаблон, Нарушение.НомерСтроки, Нарушение.Номенклатура, Нарушение.Цена, Нарушение.Порог,
				Нарушение.Основание);
		Иначе
			Текст = СтрШаблон(ШаблонБезСумм, Нарушение.НомерСтроки, Нарушение.Номенклатура, Нарушение.Основание);
		КонецЕсли;
		Тексты.Добавить(Текст);
	КонецЦикла;
	Тексты.Добавить(НСтр("ru = 'Продать ниже порога может пользователь с ролью «Продажа ниже минимальной цены».';
		|fr = 'Un utilisateur ayant le rôle « Vente en dessous du prix minimal » peut vendre en dessous du seuil.';
		|en = 'A user with the «Sale below minimum price» role can sell below the threshold.';
		|es = 'Un usuario con el rol «Venta por debajo del precio mínimo» puede vender por debajo del umbral.'"));
	Возврат СтрСоединить(Тексты, Символы.ПС);
КонецФункции

#КонецОбласти

#КонецОбласти
