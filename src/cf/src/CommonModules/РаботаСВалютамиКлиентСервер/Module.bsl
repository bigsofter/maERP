////////////////////////////////////////////////////////////////////////////////
// Документы в валюте: пересчёт сумм строк в основную валюту и заголовки колонок с валютой.
// Серверная часть (курсы, валюта объектов расчётов) - РаботаСВалютами.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Курс документа для пересчёта в основную валюту: при снятом флажке ВВалюте - 1.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура, ДокументОбъект - документ с реквизитами ВВалюте и КурсВалюты.
//
// Возвращаемое значение:
//  Число - курс, больше нуля.
//
Функция КурсДокумента(Объект) Экспорт
	Если Не Объект.ВВалюте Или Объект.КурсВалюты <= 0 Тогда
		Возврат 1;
	КонецЕсли;
	Возврат Объект.КурсВалюты;
КонецФункции

// Курс платёжного документа (валюта - валюта кассы или счёта, флажка нет): нулевой курс старых документов - 1.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура, ДокументОбъект - документ с реквизитом КурсВалюты.
//
// Возвращаемое значение:
//  Число - курс, больше нуля.
//
Функция КурсПлатежа(Объект) Экспорт
	Возврат ?(Объект.КурсВалюты > 0, Объект.КурсВалюты, 1);
КонецФункции

// Валюта и курс платёжного документа для пересчёта сумм оснований.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура, ДокументОбъект - платёжный документ.
//
// Возвращаемое значение:
//  Структура, Неопределено - Валюта, Курс, Дата; Неопределено у документа без валюты.
//
Функция ВалютаПлатежа(Объект) Экспорт
	// Документы с флажком ВВалюте (поступление, реализация) платёжными не являются.
	Если Не РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Объект, "КурсВалюты")
		Или РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Объект, "ВВалюте") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Валюта, Курс, Дата", Объект.Валюта, КурсПлатежа(Объект), Объект.Дата);
КонецФункции

// Сумма в основной валюте.
//
// Параметры:
//  Сумма - Число - сумма в валюте документа.
//  Курс - Число - курс валюты документа.
//
// Возвращаемое значение:
//  Число - сумма, округлённая до копеек.
//
Функция СуммаРегл(Сумма, Курс) Экспорт
	Возврат ОкруглитьСумму(Сумма * Курс);
КонецФункции

// Сумма в валюте по сумме в основной валюте.
//
// Параметры:
//  СуммаРегл - Число - сумма в основной валюте.
//  Курс - Число - курс валюты, больше нуля.
//
// Возвращаемое значение:
//  Число - сумма в валюте, округлённая до копеек.
//
Функция СуммаВВалюте(СуммаРегл, Курс) Экспорт
	Возврат ОкруглитьСумму(СуммаРегл / Курс);
КонецФункции

// Округление денежной суммы до копеек.
//
// Параметры:
//  Сумма - Число - сумма.
//
// Возвращаемое значение:
//  Число - сумма с двумя знаками после запятой.
//
Функция ОкруглитьСумму(Сумма) Экспорт
	РазрядностьКопеек = 2;
	Возврат Окр(Сумма, РазрядностьКопеек);
КонецФункции

// Пересчитывает колонку СуммаРегл в табличных частях ТЧТовары и ТЧУслуги и реквизит шапки СуммаРегл:
// строки - от колонки Сумма, шапка - от итога Сумма (с НДС).
//
// Параметры:
//  Объект - ДанныеФормыСтруктура, ДокументОбъект - документ с реквизитами ВВалюте, КурсВалюты, Сумма, СуммаРегл.
//
Процедура ПересчитатьСуммыРегл(Объект) Экспорт
	Курс = КурсДокумента(Объект);
	Для Каждого Стр Из Объект.ТЧТовары Цикл
		Стр.СуммаРегл = СуммаРегл(Стр.Сумма, Курс);
	КонецЦикла;
	Для Каждого Стр Из Объект.ТЧУслуги Цикл
		Стр.СуммаРегл = СуммаРегл(Стр.Сумма, Курс);
	КонецЦикла;
	Объект.СуммаРегл = СуммаРегл(Объект.Сумма, Курс);
КонецПроцедуры

// Заголовок колонки или поля с валютой: «Цена (EUR)».
//
// Параметры:
//  Текст - Строка - заголовок без валюты.
//  Валюта - СправочникСсылка.Валюты, Строка - валюта (её представление - код ISO).
//
// Возвращаемое значение:
//  Строка - заголовок.
//
Функция ЗаголовокСВалютой(Текст, Валюта) Экспорт
	Возврат СтрШаблон("%1 (%2)", Текст, Валюта);
КонецФункции

#КонецОбласти
