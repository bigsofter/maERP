#Область ПрограммныйИнтерфейс

// Обрабатывает запуск клиента с параметром автотестов: открывает форму прогона
// и сообщает вызывающему, что обычную инициализацию клиента выполнять не нужно.
//
// Прогон запускается так: 1cv8c ENTERPRISE /C "СмокТест;<путь-к-отчёту>" (scripts/smoke.sh),
// заполнение образцов - /C "ТестовыеДанные;<путь-к-отчёту>" (scripts/fixtures.sh),
// тесты документов - /C "ТестыДокументов;<путь-к-отчёту>" (scripts/doctests.sh).
//
// Возвращаемое значение:
//  Булево - Истина, если это технологический запуск и работа передана обработке автотестов
//
Функция ОбработатьЗапускТеста() Экспорт

	ПараметрыФормы = Неопределено;
	Если СтрНачинаетсяС(ПараметрЗапуска, "СмокТест") Тогда
		ИмяФормы = "Обработка.СмокТест.Форма";
	ИначеЕсли СтрНачинаетсяС(ПараметрЗапуска, "ТестовыеДанные") Тогда
		// Заполнение образцов запускает та же форма: она клиентский запускатель подсистемы,
		// а серверную функцию модуля менеджера с клиента иначе не позвать.
		ИмяФормы = "Обработка.СмокТест.Форма";
		ПараметрыФормы = Новый Структура("ТолькоТестовыеДанные", Истина);
	ИначеЕсли СтрНачинаетсяС(ПараметрЗапуска, "ТестыДокументов") Тогда
		ИмяФормы = "Обработка.ТестыДокументов.Форма";
	Иначе
		Возврат Ложь;
	КонецЕсли;

	ОткрытьФорму(ИмяФормы, ПараметрыФормы);
	Возврат Истина;

КонецФункции

#КонецОбласти
