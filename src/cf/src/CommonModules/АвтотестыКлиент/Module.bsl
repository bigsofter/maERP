#Область ПрограммныйИнтерфейс

// Обрабатывает запуск клиента с параметром автотестов: открывает форму прогона
// и сообщает вызывающему, что обычную инициализацию клиента выполнять не нужно.
//
// Прогон запускается так: 1cv8c ENTERPRISE /C "СмокТест;<путь-к-отчёту>",
// см. scripts/smoke.sh.
//
// Возвращаемое значение:
//  Булево - Истина, если это технологический запуск и работа передана обработке автотестов
//
Функция ОбработатьЗапускТеста() Экспорт

	Если Не СтрНачинаетсяС(ПараметрЗапуска, "СмокТест") Тогда
		Возврат Ложь;
	КонецЕсли;

	ОткрытьФорму("Обработка.СмокТест.Форма");
	Возврат Истина;

КонецФункции

#КонецОбласти
