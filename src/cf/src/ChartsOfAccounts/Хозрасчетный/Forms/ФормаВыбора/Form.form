    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ПланСчетовХозрасчетный.Ссылка,
	ПланСчетовХозрасчетный.ПометкаУдаления,
	ПланСчетовХозрасчетный.Предопределенный,
	ПланСчетовХозрасчетный.Родитель,
	ПланСчетовХозрасчетный.Код,
	ПланСчетовХозрасчетный.Наименование,
	ПланСчетовХозрасчетный.Порядок,
	ВЫБОР
		КОГДА ПланСчетовХозрасчетный.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			ТОГДА &amp;ТекстА
		ИНАЧЕ ВЫБОР
				КОГДА ПланСчетовХозрасчетный.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
					ТОГДА &amp;ТекстП
				ИНАЧЕ &amp;ТекстАП
			КОНЕЦ
	КОНЕЦ КАК Вид,
	ПланСчетовХозрасчетный.Забалансовый,
	ПланСчетовХозрасчетный.ЗапретитьИспользоватьВПроводках,
	ПланСчетовХозрасчетный.КодБыстрогоВыбора,
	ПланСчетовХозрасчетный.Валютный,
	ПланСчетовХозрасчетный.Количественный
ИЗ
	ПланСчетов.Хозрасчетный КАК ПланСчетовХозрасчетный
</queryText>
      <mainTable>ChartOfAccounts.Хозрасчетный</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ЗапретитьИспользоватьВПроводках</dataPath>
        <field>ЗапретитьИспользоватьВПроводках</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ВидыСубконто</dataPath>
        <field>ВидыСубконто</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
