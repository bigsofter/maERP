#Область ПрограммныйИнтерфейс

// Проверяет, лежит ли позиция в избранном текущего пользователя.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - проверяемая номенклатура.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика позиции.
//
// Возвращаемое значение:
//  Булево - Истина, если позиция уже в избранном.
//
Функция ЭтоИзбранное(Номенклатура, Характеристика) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Есть
	|ИЗ
	|	РегистрСведений.ИзбраннаяНоменклатураРМК КАК Избранное
	|ГДЕ
	|	Избранное.Пользователь = &Пользователь
	|	И Избранное.Номенклатура = &Номенклатура
	|	И Избранное.Характеристика = &Характеристика";
	Запрос.УстановитьПараметр("Пользователь", ТекущийПользователь());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Добавляет позицию в избранное текущего пользователя. Повторное добавление порядок не меняет.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - добавляемая номенклатура.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика позиции.
//
Процедура ДобавитьВИзбранное(Номенклатура, Характеристика) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Или ЭтоИзбранное(Номенклатура, Характеристика) Тогда
		Возврат;
	КонецЕсли;

	Пользователь = ТекущийПользователь();

	// Менеджером записи по полному ключу, а не набором с отбором по пользователю:
	// иначе две параллельные сессии одного кассира затрут список друг друга.
	Запись = РегистрыСведений.ИзбраннаяНоменклатураРМК.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователь;
	Запись.Номенклатура = Номенклатура;
	Запись.Характеристика = Характеристика;
	Запись.Порядок = СледующийПорядок(Пользователь);
	Запись.Записать(Истина);

КонецПроцедуры

// Убирает позицию из избранного текущего пользователя.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - убираемая номенклатура.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика позиции.
//
Процедура УбратьИзИзбранного(Номенклатура, Характеристика) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.ИзбраннаяНоменклатураРМК.СоздатьМенеджерЗаписи();
	Запись.Пользователь = ТекущийПользователь();
	Запись.Номенклатура = Номенклатура;
	Запись.Характеристика = Характеристика;
	Запись.Удалить();

КонецПроцедуры

// Возвращает избранное текущего пользователя с ценами для плиток окна быстрого выбора.
//
// Цена считается по виду цен контрагента-розничного клиента и показывается на плитке ровно та,
// которая уйдёт в чек. Ключ регистра цен - четыре измерения (ТоварнаяГруппа, ВидЦены,
// Номенклатура, Характеристика), а товарную группу документы заполняют по-разному
// (УстановкаЦенНоменклатурыВручную не заполняет вовсе), поэтому на одну позицию в срезе
// последних бывает НЕСКОЛЬКО записей: цена сворачивается до одной строки по паре
// номенклатура + характеристика, из записей с самым поздним периодом.
//
// Если цены на пару номенклатура + характеристика нет, берётся цена по одной номенклатуре
// (как её берёт форма подбора FormProduitsOnStock, соединяющая цену только по номенклатуре):
// иначе товар, показанный в подборе с ценой, в избранном оказался бы без цены.
//
// Параметры:
//  ВидЦены - СправочникСсылка.ВидыЦен - вид цен, по которому считается цена плитки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура, Характеристика, Наименование, Цена, Порядок;
//                    по одной строке на позицию избранного.
//
Функция ИзбранноеПользователя(ВидЦены) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Избранное.Номенклатура КАК Номенклатура,
	|	Избранное.Характеристика КАК Характеристика,
	|	Номенклатура.Наименование КАК Наименование,
	|	Избранное.Порядок КАК Порядок
	|ПОМЕСТИТЬ ВТИзбранное
	|ИЗ
	|	РегистрСведений.ИзбраннаяНоменклатураРМК КАК Избранное
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО Избранное.Номенклатура = Номенклатура.Ссылка
	|ГДЕ
	|	Избранное.Пользователь = &Пользователь
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И НЕ Номенклатура.ЭтоГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Цены.Номенклатура КАК Номенклатура,
	|	Цены.Характеристика КАК Характеристика,
	|	Цены.Цена КАК Цена,
	|	Цены.Период КАК Период
	|ПОМЕСТИТЬ ВТЦеныВсе
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦены = &ВидЦены) КАК Цены
	|ГДЕ
	|	Цены.Номенклатура В
	|			(ВЫБРАТЬ
	|				ВТИзбранное.Номенклатура КАК Номенклатура
	|			ИЗ
	|				ВТИзбранное КАК ВТИзбранное)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЦеныВсе.Номенклатура КАК Номенклатура,
	|	ВТЦеныВсе.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ВТЦеныВсе.Период) КАК Период
	|ПОМЕСТИТЬ ВТПоследниеПериоды
	|ИЗ
	|	ВТЦеныВсе КАК ВТЦеныВсе
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЦеныВсе.Номенклатура,
	|	ВТЦеныВсе.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПоследниеПериоды.Номенклатура КАК Номенклатура,
	|	ВТПоследниеПериоды.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ВТЦеныВсе.Цена) КАК Цена
	|ПОМЕСТИТЬ ВТЦенаПоХарактеристике
	|ИЗ
	|	ВТПоследниеПериоды КАК ВТПоследниеПериоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЦеныВсе КАК ВТЦеныВсе
	|		ПО ВТПоследниеПериоды.Номенклатура = ВТЦеныВсе.Номенклатура
	|			И ВТПоследниеПериоды.Характеристика = ВТЦеныВсе.Характеристика
	|			И ВТПоследниеПериоды.Период = ВТЦеныВсе.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПоследниеПериоды.Номенклатура,
	|	ВТПоследниеПериоды.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЦенаПоХарактеристике.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ВТЦенаПоХарактеристике.Цена) КАК Цена
	|ПОМЕСТИТЬ ВТЦенаПоНоменклатуре
	|ИЗ
	|	ВТЦенаПоХарактеристике КАК ВТЦенаПоХарактеристике
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЦенаПоХарактеристике.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТИзбранное.Номенклатура КАК Номенклатура,
	|	ВТИзбранное.Характеристика КАК Характеристика,
	|	ВТИзбранное.Наименование КАК Наименование,
	|	ЕСТЬNULL(ВТЦенаПоХарактеристике.Цена, ЕСТЬNULL(ВТЦенаПоНоменклатуре.Цена, 0)) КАК Цена,
	|	ВТИзбранное.Порядок КАК Порядок
	|ИЗ
	|	ВТИзбранное КАК ВТИзбранное
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦенаПоХарактеристике КАК ВТЦенаПоХарактеристике
	|		ПО ВТИзбранное.Номенклатура = ВТЦенаПоХарактеристике.Номенклатура
	|			И ВТИзбранное.Характеристика = ВТЦенаПоХарактеристике.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦенаПоНоменклатуре КАК ВТЦенаПоНоменклатуре
	|		ПО ВТИзбранное.Номенклатура = ВТЦенаПоНоменклатуре.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Наименование";
	
	Запрос.УстановитьПараметр("Пользователь", ТекущийПользователь());
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает вид цен, по которому РМК показывает цены избранного.
// Повторяет правило формы подбора FormProduitsOnStock: розничный вид цен, а если у
// розничного клиента задан свой тип цены - его.
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыЦен - вид цен для плиток избранного.
//
Функция ВидЦенРМК() Экспорт

	ВидЦены = Справочники.ВидыЦен.Розничная;

	Контрагент = Константы.РозничныйКлиент.Получить();
	Если ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(Контрагент.ТипЦены) Тогда
		ВидЦены = Контрагент.ТипЦены;
	КонецЕсли;

	Возврат ВидЦены;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекущийПользователь()

	Возврат ПараметрыСеанса.Пользователь;

КонецФункции

Функция СледующийПорядок(Пользователь)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(Избранное.Порядок), 0) КАК Порядок
	|ИЗ
	|	РегистрСведений.ИзбраннаяНоменклатураРМК КАК Избранное
	|ГДЕ
	|	Избранное.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Порядок, 0) + 1;

КонецФункции

#КонецОбласти
