Функция ПолучитьМаскиТелефонныхНомеров() Экспорт
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Страна", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("СтранаEN", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Маска", Новый ОписаниеТипов("Строка"));
	Макет = РегистрыСведений.РеквизитыКонтрагентов.ПолучитьМакет("МаскиТелефонныхНомеров");
	оДанные = Макет.ПолучитьОбласть("Данные");
	Для А = 2 По оДанные.ВысотаТаблицы Цикл
		НС = ТЗ.Добавить();
		НС.Код = СокрЛП(оДанные.Область(А, 1, А, 1).Текст);
		НС.Страна = СокрЛП(оДанные.Область(А, 2, А, 2).Текст);
		НС.СтранаEN = СокрЛП(оДанные.Область(А, 3, А, 3).Текст);
		НС.Маска = СокрЛП(оДанные.Область(А, 4, А, 4).Текст);
	КонецЦикла;	
	Возврат ТЗ;
КонецФункции	

Функция СформироватьДанныеДругое(Представление) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Представление", Представление);	
	Результат.Вставить("Значение", ОбщегоНазначенияКлиентСервер.КонвертироватьВJSON(Результат));
	Возврат Результат;
КонецФункции

Функция ДатаНепериодическогоРеквизита() Экспорт
	Возврат Дата(2000,1,1);	
КонецФункции

