#Область ПрограммныйИнтерфейс

// Возвращает выходные дни за период.
//
// Параметры:
//  НачалоПериода - Дата - начало периода.
//  КонецПериода - Дата - конец периода.
//
// Возвращаемое значение:
//  Массив - Дата - выходные дни по возрастанию.
//
Функция ПолучитьВыходные(НачалоПериода, КонецПериода) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПроизводственныйКалендарь.Дата КАК Дата
	                      |ИЗ
	                      |	РегистрСведений.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь
	                      |ГДЕ
	                      |	ПроизводственныйКалендарь.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Дата");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Дата");
КонецФункции

// Возвращает календарь за период с признаком выходного дня.
//
// Параметры:
//  НачалоПериода - Дата - начало периода.
//  КонецПериода - Дата - конец периода.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Дата (Дата), ЭтоВыходной (Булево).
//
Функция ПолучитьКалендарь(НачалоПериода, КонецПериода) Экспорт
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТЗ.Колонки.Добавить("ЭтоВыходной", Новый ОписаниеТипов("Булево"));
	МасВыходные = ПолучитьВыходные(НачалоПериода, КонецПериода);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(&НачалоПериода КАК ДАТА) КАК ДатаПериода
	                      |ИТОГИ ПО
	                      |	ДатаПериода ПЕРИОДАМИ(ДЕНЬ, &НачалоПериода, &КонецПериода)");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Выб = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ДатаПериода", "ВСЕ");
	Пока Выб.Следующий() Цикл
		НС = ТЗ.Добавить();
		НС.Дата = Выб.ДатаПериода;
		НС.ЭтоВыходной = МасВыходные.Найти(Выб.ДатаПериода) <> Неопределено; 
	КонецЦикла;	
	Возврат ТЗ;
КонецФункции

// Перезаписывает выходные дни: по годам из списка все записи удаляются и записываются заново.
//
// Параметры:
//  СЗ - СписокЗначений - даты выходных дней.
//
Процедура ПерезаписатьВыходные(СЗ) Экспорт
	ТЗДаты = Новый ТаблицаЗначений;
	ТЗДаты.Колонки.Добавить("Год", Новый ОписаниеТипов("Число"));
	ТЗДаты.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
    Для Каждого Стр Из СЗ Цикл
		НС = ТЗДаты.Добавить();
		НС.Дата = Стр.Значение;
		НС.Год = Год(Стр.Значение);
	КонецЦикла;
    ТЗДаты.Свернуть("Дата, Год");	
	ТЗГода = ТЗДаты.Скопировать();
	ТЗГода.Свернуть("Год");
	// Удаляем старые записи
	Для Каждого Стр Из ТЗГода Цикл
		НачалоПериода = НачалоГода(Дата(Стр.Год, 1, 1));
		КонецПериода = КонецДня(КонецГода(НачалоПериода));
		НЗ = РегистрыСведений.ПроизводственныйКалендарь.СоздатьНаборЗаписей();
		НЗ.Отбор.Дата.ЗначениеС = НачалоПериода;
		НЗ.Отбор.Дата.ЗначениеПо = КонецПериода;
		НЗ.Прочитать();
		НЗ.Очистить();
		МасДаты = ТЗДаты.НайтиСтроки(Новый Структура("Год", Стр.Год));
		Для Каждого МасСтр Из МасДаты Цикл
			НС = НЗ.Добавить();
			НС.Дата = МасСтр.Дата;	
		КонецЦикла;	
		НЗ.Записать(Истина);
	КонецЦикла;
КонецПроцедуры

// Проверяет, является ли день выходным по производственному календарю.
//
// Параметры:
//  Дата - Дата - проверяемый день.
//
// Возвращаемое значение:
//  Булево - Истина, если день выходной.
//
Функция ВыходнойДень(Дата) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПроизводственныйКалендарь.Дата
	                      |ИЗ
	                      |	РегистрСведений.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь
	                      |ГДЕ
	                      |	ПроизводственныйКалендарь.Дата = &Дата");
	Запрос.УстановитьПараметр("Дата", НачалоДня(Дата));
	Рез = Запрос.Выполнить();
	Возврат Не Рез.Пустой();
КонецФункции

// Возвращает страны, для которых в общем макете ПраздничныеДни описаны праздники.
//
// Возвращаемое значение:
//  СписокЗначений - значение: Строка - код страны (ISO 3166-1 alpha-2), представление: название на языке сеанса.
//
Функция СтраныКалендаря() Экспорт
	Результат = Новый СписокЗначений;
	Чтение = ЧтениеМакетаПраздничныхДней();
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.Имя = "Страна" Тогда
			Результат.Добавить(Чтение.ЗначениеАтрибута("Код"), НазваниеИзАтрибутов(Чтение));
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

// Возвращает праздничные дни страны за год по общему макету ПраздничныеДни.
//
// Параметры:
//  КодСтраны - Строка - код страны (ISO 3166-1 alpha-2); пустая строка - праздников нет.
//  Год - Число - год.
//
// Возвращаемое значение:
//  СписокЗначений - значение: Дата - день праздника, представление: название праздника на языке сеанса.
//
Функция ПраздничныеДни(КодСтраны, Год) Экспорт
	Результат = Новый СписокЗначений;
	Если ПустаяСтрока(КодСтраны) Тогда
		Возврат Результат;
	КонецЕсли;
	Чтение = ЧтениеМакетаПраздничныхДней();
	НужнаяСтрана = Ложь;
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		Если Чтение.Имя = "Страна" Тогда
			НужнаяСтрана = ВРег(Чтение.ЗначениеАтрибута("Код")) = ВРег(СокрЛП(КодСтраны));
		ИначеЕсли Чтение.Имя = "Праздник" И НужнаяСтрана Тогда
			Месяц = Число(Чтение.ЗначениеАтрибута("Месяц"));
			День = Число(Чтение.ЗначениеАтрибута("День"));
			Результат.Добавить(Дата(Год, Месяц, День), НазваниеИзАтрибутов(Чтение));
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЧтениеМакетаПраздничныхДней()
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ПолучитьОбщийМакет("ПраздничныеДни").ПолучитьТекст());
	Возврат Чтение;
КонецФункции

Функция НазваниеИзАтрибутов(Чтение)
	КодЯзыка = ТекущийЯзык().КодЯзыка;
	Название = Чтение.ЗначениеАтрибута(КодЯзыка);
	Если Название = Неопределено Тогда
		Название = Чтение.ЗначениеАтрибута("ru");
	КонецЕсли;
	Возврат ?(Название = Неопределено, "", Название);
КонецФункции

#КонецОбласти
