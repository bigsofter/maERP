#Область ПрограммныйИнтерфейс

// Удаляет ошибки прошлого пересчета последовательности. Отметки замороженной стоимости остаются: их снимает только
// успешное перепроведение документа или перепроверка отметок (план warehouse-orders-cost, Ф1.3 п. 3).
//
Процедура ОчиститьОшибки() Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Записи.Документ КАК Документ
		|ИЗ
		|	РегистрСведений.НепроведенныеДокументы КАК Записи
		|ГДЕ
		|	НЕ Записи.СтоимостьЗаморожена");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УдалитьЗапись(Выборка.Документ);
	КонецЦикла;

КонецПроцедуры

// Записывает ошибку пересчета документа.
//
// Параметры:
//  Док         - ДокументСсылка - документ последовательности
//  ТекстОшибки - Строка - текст ошибки
//
Процедура ЗаписатьОшибку(Док, ТекстОшибки) Экспорт

	МЗ = РегистрыСведений.НепроведенныеДокументы.СоздатьМенеджерЗаписи();
	МЗ.Документ = Док;
	МЗ.ТекстОшибки = ТекстОшибки;
	МЗ.Записать(Истина);

КонецПроцедуры

// Отмечает документ, стоимость которого пересчет не обновляет: основание, покрытое налоговым документом с возвратами
// или корректировками (НалоговыеДокументыНаОснованиях.ОснованиеЗаморожено).
//
// Параметры:
//  Док         - ДокументСсылка - документ последовательности
//  ТекстОшибки - Строка - пояснение
//
Процедура ЗаписатьЗаморозку(Док, ТекстОшибки) Экспорт

	МЗ = РегистрыСведений.НепроведенныеДокументы.СоздатьМенеджерЗаписи();
	МЗ.Документ = Док;
	МЗ.ТекстОшибки = ТекстОшибки;
	МЗ.СтоимостьЗаморожена = Истина;
	МЗ.Записать(Истина);

КонецПроцедуры

// Удаляет запись документа - ошибку или отметку заморозки.
//
// Параметры:
//  Док - ДокументСсылка - документ последовательности
//
Процедура УдалитьЗапись(Док) Экспорт

	Набор = РегистрыСведений.НепроведенныеДокументы.СоздатьНаборЗаписей();
	Набор.Отбор.Документ.Установить(Док);
	Набор.Записать(Истина);

КонецПроцедуры

// Документы с отметкой замороженной стоимости.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка - отмеченные документы
//
Функция ЗамороженныеДокументы() Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Записи.Документ КАК Документ
		|ИЗ
		|	РегистрСведений.НепроведенныеДокументы КАК Записи
		|ГДЕ
		|	Записи.СтоимостьЗаморожена");
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Документ");

КонецФункции

#КонецОбласти
