
Процедура Сформировать(Сотрудник, Описание, НавигационнаяСсылка = "") Экспорт
	УстановитьПривилегированныйРежим(Истина);
	МЗ = РегистрыСведений.СистемныеОповещения.СоздатьМенеджерЗаписи();
	МЗ.Сотрудник = Сотрудник;
	МЗ.ID = Новый УникальныйИдентификатор;
	МЗ.Описание = Описание;// + " / Автор - " + ПараметрыСеанса.Пользователь;
	МЗ.Дата = ТекущаяДатаСеанса();
	МЗ.Новое = Истина;
	МЗ.НавигационнаяСсылка = НавигационнаяСсылка;
	МЗ.Записать(Истина);
КонецПроцедуры

// Оповещение о событии один раз (docs/plans/retail-store-needs-3.md): ID записи - детерминированный UUID из MD5 ключа
// события; запись с таким ID у сотрудника уже есть - не повторяется (перепроведение не дублирует).
//
// Параметры:
//  Сотрудник           - СправочникСсылка.Пользователи - получатель.
//  Ключ                - Строка - ключ события.
//  Описание            - Строка - текст.
//  НавигационнаяСсылка - Строка - ссылка на объект.
//
Процедура СформироватьОднократно(Сотрудник, Ключ, Описание, НавигационнаяСсылка = "") Экспорт
	// BSLLS:SetPrivilegedMode-off - запись адресного оповещения, как Сформировать
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	ID = ИдентификаторКлюча(Ключ);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Оповещения.ID КАК ID
	|ИЗ
	|	РегистрСведений.СистемныеОповещения КАК Оповещения
	|ГДЕ
	|	Оповещения.Сотрудник = &Сотрудник
	|	И Оповещения.ID = &ID");
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("ID", ID);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	МЗ = РегистрыСведений.СистемныеОповещения.СоздатьМенеджерЗаписи();
	МЗ.Сотрудник = Сотрудник;
	МЗ.ID = ID;
	МЗ.Описание = Описание;
	МЗ.Дата = ТекущаяДатаСеанса();
	МЗ.Новое = Истина;
	МЗ.НавигационнаяСсылка = НавигационнаяСсылка;
	МЗ.Записать(Истина);
КонецПроцедуры

// Детерминированный UUID ключа события: MD5 ключа в формате 8-4-4-4-12.
//
// Параметры:
//  Ключ - Строка - ключ события.
//
// Возвращаемое значение:
//  УникальныйИдентификатор - идентификатор.
//
Функция ИдентификаторКлюча(Ключ)
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Ключ);
	Шестнадцатеричная = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	Части = Новый Массив;
	Начало = 1;
	Для Каждого Длина Из СтрРазделить("8,4,4,4,12", ",") Цикл
		Части.Добавить(Сред(Шестнадцатеричная, Начало, Число(Длина)));
		Начало = Начало + Число(Длина);
	КонецЦикла;
	Представление = СтрСоединить(Части, "-");
	Возврат Новый УникальныйИдентификатор(Представление);
КонецФункции

Функция ПолучитьНеотображённые(Сотрудник) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СистемныеОповещения.Сотрудник КАК Сотрудник,
	                      |	СистемныеОповещения.ID КАК ID,
	                      |	СистемныеОповещения.Описание КАК Описание,
	                      |	СистемныеОповещения.НавигационнаяСсылка КАК НавигационнаяСсылка
	                      |ИЗ
	                      |	РегистрСведений.СистемныеОповещения КАК СистемныеОповещения
	                      |ГДЕ
	                      |	СистемныеОповещения.Сотрудник = &Сотрудник
	                      |	И СистемныеОповещения.Отображено = ЛОЖЬ");
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ОтметитьКакОтображённое(Сотрудник, ID) Экспорт
	МЗ = РегистрыСведений.СистемныеОповещения.СоздатьМенеджерЗаписи();
	МЗ.Сотрудник = Сотрудник;
	МЗ.ID = ID;
	МЗ.Прочитать();
	Если ЗначениеЗаполнено(МЗ.Сотрудник) Тогда
		МЗ.Отображено = Истина;
		МЗ.Записать(Истина);
	КонецЕсли;	
КонецПроцедуры

Процедура ОчиститьПоСотруднику(Сотрудник) Экспорт
	НЗ = РегистрыСведений.СистемныеОповещения.СоздатьНаборЗаписей();
	НЗ.Отбор.Сотрудник.Установить(Сотрудник);
	НЗ.Записать();
КонецПроцедуры	
