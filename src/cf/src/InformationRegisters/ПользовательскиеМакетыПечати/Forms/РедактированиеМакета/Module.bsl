#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПутьКМакету = Параметры.ПутьКМакету;
	Если Не ЗначениеЗаполнено(ПутьКМакету) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Правка = ПечатныеФормы.ПравкаДляРедактирования(ПутьКМакету);
	Макет = Правка.Макет;

	ШаблонЗаголовка = НСтр("ru = 'Макет: %1'; fr = 'Modèle : %1'; en = 'Template: %1'; es = 'Plantilla: %1'");
	Если Правка.НетВКонфигурации Тогда
		// Правка макета, удалённого из конфигурации (docs/plans/branded-print.md, раздел 14.2): её открывают, чтобы
		// перенести нужное в действующий макет или сохранить в файл. Поставляемого макета нет, записывать правку
		// незачем - печать её не использует.
		ШаблонЗаголовка = НСтр("ru = 'Макет: %1 (удалён из конфигурации)'; fr = 'Modèle : %1 (supprimé de la configuration)';
			|en = 'Template: %1 (removed from the configuration)'; es = 'Plantilla: %1 (eliminada de la configuración)'");
		Элементы.ФормаЗаписатьМакет.Видимость = Ложь;
		Элементы.ФормаВернутьПоставляемый.Видимость = Ложь;
	КонецЕсли;
	Заголовок = СтрШаблон(ШаблонЗаголовка, ПутьКМакету);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьМакет(Команда)

	ЗаписатьМакетНаСервере();
	Оповестить("Запись_ПользовательскиеМакетыПечати", ПутьКМакету);
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ВернутьПоставляемый(Команда)

	ТекстВопроса = НСтр("ru = 'Вернуть поставляемый макет? Изменения будут потеряны.';
		|fr = 'Restaurer le modèle fourni ? Les modifications seront perdues.';
		|en = 'Restore the supplied template? The changes will be lost.';
		|es = '¿Restaurar la plantilla suministrada? Se perderán los cambios.'");
	Оповещение = Новый ОписаниеОповещения("ВернутьПоставляемыйЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВернутьПоставляемыйЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьПоставляемыйНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаписатьМакетНаСервере()

	Если Не ПечатныеФормы.МакетЕстьВКонфигурации(ПутьКМакету) Тогда
		ВызватьИсключение НСтр("ru = 'Макет удалён из конфигурации: правку можно перенести в действующий макет
			|или сохранить в файл.'; fr = 'Le modèle a été supprimé de la configuration : reportez la modification
			|dans un modèle actif ou enregistrez-la dans un fichier.'; en = 'The template has been removed from the
			|configuration: move the change to an active template or save it to a file.'; es = 'La plantilla se ha
			|eliminado de la configuración: traslade el cambio a una plantilla activa o guárdelo en un archivo.'");
	КонецЕсли;
	ПечатныеФормы.ЗаписатьПользовательскийМакет(ПутьКМакету, Макет);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПоставляемыйНаСервере()

	// Поставляемый макет берётся до удаления правки: у макета, удалённого из конфигурации, его нет, и правка
	// не должна пропасть вместе с исключением.
	Поставляемый = ПечатныеФормы.ПоставляемыйМакет(ПутьКМакету);
	ПечатныеФормы.УдалитьПользовательскийМакет(ПутьКМакету);
	Макет = Поставляемый;

КонецПроцедуры

#КонецОбласти
