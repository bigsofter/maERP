#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПутьКМакету = Параметры.ПутьКМакету;
	Если Не ЗначениеЗаполнено(ПутьКМакету) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Макет = ПечатныеФормы.МакетПечатнойФормы(ПутьКМакету);

	ШаблонЗаголовка = НСтр("ru = 'Макет: %1'; fr = 'Modèle : %1'; en = 'Template: %1'; es = 'Plantilla: %1'");
	Заголовок = СтрШаблон(ШаблонЗаголовка, ПутьКМакету);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьМакет(Команда)

	ЗаписатьМакетНаСервере();
	Оповестить("Запись_ПользовательскиеМакетыПечати", ПутьКМакету);
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ВернутьПоставляемый(Команда)

	ТекстВопроса = НСтр("ru = 'Вернуть поставляемый макет? Изменения будут потеряны.';
		|fr = 'Restaurer le modèle fourni ? Les modifications seront perdues.';
		|en = 'Restore the supplied template? The changes will be lost.';
		|es = '¿Restaurar la plantilla suministrada? Se perderán los cambios.'");
	Оповещение = Новый ОписаниеОповещения("ВернутьПоставляемыйЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВернутьПоставляемыйЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьПоставляемыйНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаписатьМакетНаСервере()

	ПечатныеФормы.ЗаписатьПользовательскийМакет(ПутьКМакету, Макет);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПоставляемыйНаСервере()

	ПечатныеФормы.УдалитьПользовательскийМакет(ПутьКМакету);
	Макет = ПечатныеФормы.ПоставляемыйМакет(ПутьКМакету);

КонецПроцедуры

#КонецОбласти
