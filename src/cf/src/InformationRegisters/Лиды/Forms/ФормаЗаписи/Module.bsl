&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Не Запись.ЗаказПокупателя.Пустая() Тогда 
		Запись.Сумма = ПолучитьСуммуЗаказаНаСервере();
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьСуммуЗаказаНаСервере()
	Возврат Запись.ЗаказПокупателя.ТЧТовары.Итог("Сумма");
КонецФункции

&НаСервере
Процедура СоздатьНовогоКлиентаНаСервере()
	НовыйКлиент = Справочники.Контрагенты.СоздатьЭлемент();
	//НовыйКлиент.ECommerce = Истина;
	НовыйКлиент.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ЧастноеЛицо");
	НовыйКлиент.Покупатель = Истина;
	НовыйКлиент.Наименование = Запись.ПолноеИмя;
	НовыйКлиент.Записать();
	
	НЗ = РегистрыСведений.РеквизитыКонтрагентов.СоздатьНаборЗаписей();
	НЗ.Отбор.Контрагент.Установить(НовыйКлиент.Ссылка);
	
	НС = НЗ.Добавить();
	НС.Контрагент = НовыйКлиент.Ссылка;
	НС.Реквизит = ПланыВидовХарактеристик.ВидыРеквизитовКонтрагентов.Телефон;
	НС.Представление = Запись.НомерТелефона;
	
	НС = НЗ.Добавить();
	НС.Контрагент = НовыйКлиент.Ссылка;
	НС.Реквизит = ПланыВидовХарактеристик.ВидыРеквизитовКонтрагентов.EMail;
	НС.Представление = Запись.EMail;
	НЗ.Записать(Истина);
	Запись.Клиент = НовыйКлиент.Ссылка;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовогоКлиента(Команда)
	СписокЗначений = НайтиКлиентаНаСервере();
	Если СписокЗначений.Количество() = 0 Тогда 
		СоздатьНовогоКлиентаНаСервере();
		Возврат;
	КонецЕсли;
	ОП = Новый ОписаниеОповещения("ПослеОтветаНаВопросОСозданииКлиента",ЭтаФорма);
	СписокОтветов = Новый СписокЗначений;
	СписокОтветов.Добавить("Да",НСтр("fr = 'Choisir un existant'; ru = 'Выбрать существующего'; en = 'Select an existing one'; es = 'Seleccionar existente'"));
	СписокОтветов.Добавить("Нет",НСтр("fr = 'Créer un nouveau'; ru = 'Создать нового'; en = 'Create a new one'; es = 'Crear nuevo'"));
	СписокОтветов.Добавить("Отмена",НСтр("fr = 'Annuler'; ru = 'Отмена'; en = 'Cancel'; es = 'Cancelación'"));
	ПоказатьВопрос(Оп,НСтр("fr = 'Il y a des clients avec les même coordonnées'; ru = 'Уже есть клиенты с такими же реквизитами'; en = 'There are already clients with the same banking details'; es = 'Ya hay clientes con los mismos detalles'"),СписокОтветов,10);
КонецПроцедуры

&НаКлиенте
Процедура НайтиКлиента(Команда)
	СписокЗначений = НайтиКлиентаНаСервере();
	Если СписокЗначений.Количество() = 0 Тогда 
		ПоказатьПредупреждение(,НСтр("fr = 'Client non trouvé'; ru = 'Клиент не найден'; en = 'The client was not found'; es = 'Cliente no encontrado'"),5);
		Возврат;
	КонецЕсли;
	Оп = Новый ОписаниеОповещения("ПослеВыбораКлиента",ЭтаФорма);
	ПоказатьВыборИзСписка(Оп,СписокЗначений,Элементы.Клиент);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКлиента(ВыбранноеЗначение,ДопПараметры) Экспорт
	Если Не ВыбранноеЗначение = Неопределено Тогда 
		Запись.Клиент = ВыбранноеЗначение.Значение;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НайтиКлиентаНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РеквизитыКонтрагентов.Контрагент КАК Контрагент
	|ИЗ
	|	РегистрСведений.РеквизитыКонтрагентов КАК РеквизитыКонтрагентов
	|ГДЕ
	|	(РеквизитыКонтрагентов.Реквизит = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Телефон)
	|				И (РеквизитыКонтрагентов.Представление ПОДОБНО &НомерТелефона или РеквизитыКонтрагентов.Значение ПОДОБНО &НомерТелефона)
	|			ИЛИ РеквизитыКонтрагентов.Реквизит = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.EMail)
	|				И РеквизитыКонтрагентов.Представление ПОДОБНО &EMail)
	|	И НЕ РеквизитыКонтрагентов.Контрагент.ПометкаУдаления";
	Запрос.УстановитьПараметр("НомерТелефона","%"+ОбработатьНомерТелефона(СокрЛП(Запись.НомерТелефона))+"%");
	Запрос.УстановитьПараметр("EMail",СокрЛП(Запись.EMail));
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент"));
	Возврат СписокЗначений;
КонецФункции

Функция ОбработатьНомерТелефона(НомерТелефона)
	НомерТелефонаНабор = СтрЗаменить(НомерТелефона, "-", "");
	НомерТелефонаНабор = СтрЗаменить(НомерТелефонаНабор, "(", "");
	НомерТелефонаНабор = СтрЗаменить(НомерТелефонаНабор, ")", "");
	НомерТелефонаНабор = СтрЗаменить(НомерТелефонаНабор, " ", "");
	Возврат НомерТелефонаНабор;
КонецФункции

&НаКлиенте
Процедура ПослеОтветаНаВопросОСозданииКлиента(ВыбранноеЗначение,ДопПараметры) Экспорт
	Если ВыбранноеЗначение = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	Если ВыбранноеЗначение = "Да" Тогда
		НайтиКлиента(Неопределено);
	ИначеЕсли ВыбранноеЗначение = "Нет" Тогда
		СоздатьНовогоКлиентаНаСервере();
	Иначе 
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подтвердить(Команда)
	Запись.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЛидов.Подтвержден");
	Записать();
	НастроитьФормуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)
	Запись.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЛидов.Отменен");
	Записать();
	НастроитьФормуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Заказать(Команда)
	Если Запись.Клиент.Пустая() Тогда 
		ПоказатьПредупреждение(,НСтр("fr = 'Specifiez le client'; ru = 'Укажите клиента'; en = 'Specify the client'; es = 'Especifique el cliente'"),5);
		Возврат;
	КонецЕсли;
	Если Запись.ЗаказПокупателя.Пустая() Тогда 
		Заказ = СоздатьЗаказНаСервере();
		Запись.ЗаказПокупателя = Заказ;
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Ключ",Заказ);
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаДокументаECommerce",ПараметрыОткрытия,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Запись.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЛидов.Заказан");
		Записать();
		НастроитьФормуНаСервере();
	Иначе
		ПечататьПоЛиду("ТН");
		ИндексСТатуса = ПолучитьИндексСтатуса();
		Если ИндексСТатуса < 3 Тогда 
			Запись.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЛидов.Заказан");
			Записать();
			НастроитьФормуНаСервере();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Доставить(Команда)
	Если ИндексСТатуса > 3 Тогда
		// Заказ уже доставлен: статус не меняется, накладную печатают из карточки лида.
	Иначе
		ИзменитьСтатусЗаказаНаДоставленНаСервере();
		Запись.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЛидов.Доставлен");
		Записать();
		НастроитьФормуНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИзменитьСтатусЗаказаНаДоставленНаСервере()
	Заказ = Запись.ЗаказПокупателя.ПолучитьОбъект();
	Заказ.Доставлен = Истина;
	Заказ.Записать();
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуНаСервере()
	ИндексСТатуса = ПолучитьИндексСтатуса();
	Элементы.Подтвердить.Доступность = ИндексСТатуса <= 1;
	Элементы.Подтвердить.Картинка = ?(ИндексСТатуса >= 2,БиблиотекаКартинок.Галочка16,Новый Картинка);
	Элементы.Заказать.Доступность = ИндексСТатуса >= 2;
	Элементы.Заказать.Картинка = ?(ИндексСТатуса >= 3,БиблиотекаКартинок.Галочка16,Новый Картинка);
	Элементы.Доставить.Доступность = ИндексСТатуса >= 3;
	Элементы.Доставить.Картинка = ?(ИндексСТатуса = 4,БиблиотекаКартинок.Галочка16,Новый Картинка);
	Элементы.Отменить.Доступность = ИндексСТатуса <> 4;
	Элементы.Отменить.Картинка = ?(ИндексСТатуса = 0,БиблиотекаКартинок.Удалить,Новый Картинка);
	Если ИндексСТатуса >= 3 Тогда 
		//Элементы.Заказать.Заголовок = Нстр("fr = 'Bon de commande'; ru = 'Заказ клиента'; en = ""Customer's order""; es = 'Pedido del cliente'");
		Элементы.Заказать.Заголовок = Нстр("fr = 'Bon de livraison'; ru = 'Транспортная накладная'; en = 'Bill of lading'; es = 'Carta de porte'");
	КонецЕсли;
	//Если ИндексСТатуса = 4 Тогда 
	//	Элементы.Доставить.Заголовок = Нстр("fr = 'Bon de livraison'; ru = 'Транспортная накладная'; en = 'Bill of lading'; es = 'Carta de porte'");
	//КонецЕсли;
КонецПроцедуры

Функция ПолучитьИндексСтатуса() 
	Возврат Перечисления.СтатусыЛидов.Индекс(Запись.Статус);
КонецФункции

&НаСервере
Функция СоздатьЗаказНаСервере();
	Заказ = Документы.ЗаказПокупателя.СоздатьДокумент();
	Заказ.Дата = ТекущаяДатаСеанса();
	Заказ.ECommerce = Истина;
	Заказ.Контрагент = Запись.Клиент;
	Заказ.Комментарий = Запись.Комментарий;
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(Заказ);
	Заказ.Записать();
	Возврат Заказ.Ссылка;
КонецФункции

