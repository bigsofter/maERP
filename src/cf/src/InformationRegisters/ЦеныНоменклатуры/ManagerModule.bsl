
Функция ПоследнийПрайс(ДатаЦен, ВидЦены, МассивНоменклатуры = Неопределено) Экспорт
	//Запрос = Новый Запрос("ВЫБРАТЬ
	//                      |	ЦеныНоменклатурыСрезПоследних.Период КАК Период,
	//                      |	ЦеныНоменклатурыСрезПоследних.ВидЦены КАК ВидЦены,
	//                      |	ЦеныНоменклатурыСрезПоследних.ТоварнаяГруппа КАК ТоварнаяГруппа,
	//                      |	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	//                      |	ЦеныНоменклатурыСрезПоследних.Характеристика КАК Характеристика,
	//                      |	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
	//                      |	ЦеныНоменклатурыСрезПоследних.Упаковка КАК Упаковка
	//                      |ПОМЕСТИТЬ ВТЦены
	//                      |ИЗ
	//                      |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЦен, ВидЦены В (&ВидЦены)) КАК ЦеныНоменклатурыСрезПоследних
	//                      |;
	//                      |
	//                      |////////////////////////////////////////////////////////////////////////////////
	//                      |ВЫБРАТЬ
	//                      |	ВТЦены.Период КАК Период,
	//                      |	ВТЦены.ВидЦены КАК ВидЦены,
	//                      |	ВТЦены.Номенклатура КАК Номенклатура,
	//                      |	ВТЦены.Характеристика КАК Характеристика,
	//                      |	ВТЦены.Цена КАК Цена,
	//                      |	ВТЦены.Упаковка КАК Упаковка
	//                      |ИЗ
	//                      |	(ВЫБРАТЬ
	//                      |		МАКСИМУМ(ВТЦены.Период) КАК Период,
	//                      |		ВТЦены.ВидЦены КАК ВидЦены,
	//                      |		ВТЦены.ТоварнаяГруппа КАК ТоварнаяГруппа
	//                      |	ИЗ
	//                      |		ВТЦены КАК ВТЦены
	//                      |	
	//                      |	СГРУППИРОВАТЬ ПО
	//                      |		ВТЦены.ВидЦены,
	//                      |		ВТЦены.ТоварнаяГруппа) КАК ВЗ
	//                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЦены КАК ВТЦены
	//                      |		ПО ВЗ.Период = ВТЦены.Период
	//                      |			И ВЗ.ВидЦены = ВТЦены.ВидЦены
	//                      |			И ВЗ.ТоварнаяГруппа = ВТЦены.ТоварнаяГруппа
	//                      |
	//                      |УПОРЯДОЧИТЬ ПО
	//                      |	ВТЦены.Номенклатура.Наименование,
	//                      |	ВТЦены.Характеристика.Наименование");
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЦеныНоменклатурыСрезПоследних.ВидЦены КАК ВидЦены,
	                      |	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	                      |	ЦеныНоменклатурыСрезПоследних.Характеристика КАК Характеристика,
	                      |	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
	                      |	ЦеныНоменклатурыСрезПоследних.Упаковка КАК Упаковка
	                      |ПОМЕСТИТЬ ВТЦены
	                      |ИЗ
	                      |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	                      |			&ДатаЦен,
	                      |			ВидЦены В (&ВидЦены)
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьМассивНоменклатуры
	                      |						ТОГДА Номенклатура В (&МассивНоменклатуры)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ) КАК ЦеныНоменклатурыСрезПоследних
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТЦены.ВидЦены КАК ВидЦены,
	                      |	ВТЦены.Номенклатура КАК Номенклатура,
	                      |	ВТЦены.Характеристика КАК Характеристика,
	                      |	ВТЦены.Цена КАК Цена,
	                      |	ВТЦены.Упаковка КАК Упаковка,
	                      |	ЕСТЬNULL(ВидыЦен.ЦенаВключаетНДС, ИСТИНА) КАК ЦенаВключаетНДС
	                      |ИЗ
	                      |	ВТЦены КАК ВТЦены
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЦен КАК ВидыЦен
	                      |		ПО ВТЦены.ВидЦены = ВидыЦен.Ссылка
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	                      |		ПО ВТЦены.Номенклатура = Номенклатура.Ссылка
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК Характеристики
	                      |		ПО ВТЦены.Характеристика = Характеристики.Ссылка
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Номенклатура.Наименование,
	                      |	Характеристики.Наименование");
	Запрос.УстановитьПараметр("ДатаЦен", ДатаЦен);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("ЕстьМассивНоменклатуры", Не МассивНоменклатуры = Неопределено);
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура СформироватьДвижения(ДокОбъект) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслугТЧТовары.Номенклатура КАК Номенклатура,
	|	ПоступлениеТоваровУслугТЧТовары.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ПоступлениеТоваровУслугТЧТовары.Цена) КАК Цена,
	|	МАКСИМУМ(ПоступлениеТоваровУслугТЧТовары.ЦенаМинимальная) КАК ЦенаМинимальная,
	|	МАКСИМУМ(ПоступлениеТоваровУслугТЧТовары.ЦенаРозничная) КАК ЦенаРозничная,
	|	МАКСИМУМ(ПоступлениеТоваровУслугТЧТовары.ЦенаПоТипуЦен) КАК ЦенаПоТипуЦен
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК ПоступлениеТоваровУслугТЧТовары
	|ГДЕ
	|	ПоступлениеТоваровУслугТЧТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровУслугТЧТовары.Характеристика,
	|	ПоступлениеТоваровУслугТЧТовары.Номенклатура";
	Запрос.УстановитьПараметр("ССылка",ДокОбъект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	ВидЦеныМин = Справочники.ВидыЦен.МинимальнаяЦенаПродажи;
	ВидЦеныРозн = Справочники.ВидыЦен.Розничная;
	ВидЦеныЗакуп = Справочники.ВидыЦен.Закупочная;
	ТипЦеныПоТипуЦен = ДокОбъект.ТипЦеныПоТипуЦен;
	Пока Выборка.Следующий() Цикл
		Стр = Выборка;
		Если Не Стр.ЦенаМинимальная = 0 Тогда 
			НС = ДокОбъект.Движения.ЦеныНоменклатуры.Добавить();
			НС.Период = ДокОбъект.Дата;
			НС.ВидЦены = ВидЦеныМин;
			НС.Номенклатура = Стр.Номенклатура;
			НС.Характеристика = Стр.Характеристика;
			НС.ТоварнаяГруппа = Стр.Номенклатура.ТоварнаяГруппа;
			НС.Цена = Стр.ЦенаМинимальная;
		КонецЕсли;
		Если Не Стр.ЦенаРозничная = 0 Тогда 
			НС = ДокОбъект.Движения.ЦеныНоменклатуры.Добавить();
			НС.Период = ДокОбъект.Дата;
			НС.ВидЦены = ВидЦеныРозн;
			НС.Номенклатура = Стр.Номенклатура;
			НС.Характеристика = Стр.Характеристика;
			НС.ТоварнаяГруппа = Стр.Номенклатура.ТоварнаяГруппа;
			НС.Цена = Стр.ЦенаРозничная;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТипЦеныПоТипуЦен) И ТипЦеныПоТипуЦен <> ВидЦеныРозн И ТипЦеныПоТипуЦен <> ВидЦеныМин Тогда
			Если Не Стр.ЦенаПоТипуЦен = 0 Тогда 
				НС = ДокОбъект.Движения.ЦеныНоменклатуры.Добавить();
				НС.Период = ДокОбъект.Дата;
				НС.ВидЦены = ТипЦеныПоТипуЦен;
				НС.Номенклатура = Стр.Номенклатура;
				НС.Характеристика = Стр.Характеристика;
				НС.ТоварнаяГруппа = Стр.Номенклатура.ТоварнаяГруппа;
				НС.Цена = Стр.ЦенаПоТипуЦен;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
