
#Область ПрограммныйИнтерфейс

// Есть ли у текущего пользователя действующее разрешение на редактирование документа в закрытом периоде.
//
// Параметры:
//  Документ - ДокументСсылка - редактируемый документ.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьРазрешение(Документ) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Разрешения.Разрешено КАК Разрешено
	                      |ИЗ
	                      |	РегистрСведений.РазрешениеНаРедактированиеДокументов КАК Разрешения
	                      |ГДЕ
	                      |	Разрешения.РедактируемыйДокумент = &Документ
	                      |	И Разрешения.Пользователь = &Пользователь
	                      |	И Разрешения.Разрешено");
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.Пользователь);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Гасит разрешение текущего пользователя на документ после использования.
//
// Параметры:
//  Документ - ДокументСсылка - записанный документ.
//
Процедура ПогаситьРазрешение(Документ) Экспорт
	МенеджерЗаписи = РегистрыСведений.РазрешениеНаРедактированиеДокументов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.РедактируемыйДокумент = Документ;
	МенеджерЗаписи.Пользователь = ПараметрыСеанса.Пользователь;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Или Не МенеджерЗаписи.Разрешено Тогда
		Возврат;
	КонецЕсли;
	МенеджерЗаписи.Разрешено = Ложь;
	МенеджерЗаписи.ДатаИспользования = ТекущаяДатаСеанса();
	МенеджерЗаписи.Записать();
КонецПроцедуры

#КонецОбласти
