// Склад по умолчанию для назначения: свой склад назначения, затем общий склад пользователя, затем основной склад.
//
// Параметры:
//  Назначение - Строка - «Поступление», «Отгрузка» или пустая строка - общий склад.
//
// Возвращаемое значение:
//  СправочникСсылка.МестаХранения - склад; пустая ссылка - не задан ни один.
//
Функция СкладПоУмолчанию(Назначение = "") Экспорт
	Виды = ПланыВидовХарактеристик.ВидыНастроекПользователей;
	ВидыНазначений = Новый Соответствие;
	ВидыНазначений.Вставить("Поступление", Виды.СкладПоступлений);
	ВидыНазначений.Вставить("Отгрузка", Виды.СкладОтгрузок);
	ВидНастройки = ВидыНазначений[Назначение];
	Склад = Справочники.МестаХранения.ПустаяСсылка();
	Если ВидНастройки <> Неопределено Тогда
		Склад = ПолучитьЗначениеНастройки(ВидНастройки);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = СкладПользователя();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		// BSLLS:SetPrivilegedMode-off - основной склад читает каждый, как настройку своего пользователя
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		Склад = Константы.ОсновноеМестоХранения.Получить();
	КонецЕсли;
	Возврат Склад;
КонецФункции

