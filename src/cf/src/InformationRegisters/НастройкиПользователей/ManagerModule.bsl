// Меняет ли запись набора права группы «Настройки доступа» (ПВХ ВидыНастроекПользователей): сравниваются строки прав
// в базе по отбору набора (их запись замещает или удаляет) и строки прав в самом наборе. Права, которые остаются
// прежними, изменением не считаются - не-администратор может перезаписать свои бытовые настройки целиком.
//
// Параметры:
//  Набор     - РегистрСведенийНаборЗаписей.НастройкиПользователей - записываемый набор.
//  Замещение - Булево - режим записи: Ложь - строки добавляются к базе, замещаемых нет.
//
// Возвращаемое значение:
//  Булево - Истина, если после записи права доступа будут другими.
//
Функция ИзменяютсяПраваДоступа(Набор, Замещение = Истина) Экспорт

	// BSLLS:SetPrivilegedMode-off - родителей видов и строки базы читает проверка прав, а не пишущий пользователь
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Новые = Набор.Выгрузить(, "Пользователь, Настройка, Значение");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Группа", ПланыВидовХарактеристик.ВидыНастроекПользователей.НастройкиДоступа);
	Запрос.УстановитьПараметр("Настройки", Новые.ВыгрузитьКолонку("Настройка"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Виды.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ВидыНастроекПользователей КАК Виды
	|ГДЕ
	|	Виды.Ссылка В (&Настройки)
	|	И Виды.Ссылка В ИЕРАРХИИ (&Группа)";
	ВидыДоступа = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	ПраваНовые = Новые.СкопироватьКолонки();
	Для Каждого Строка Из Новые Цикл
		Если ВидыДоступа.Найти(Строка.Настройка) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ПраваНовые.Добавить(), Строка);
		КонецЕсли;
	КонецЦикла;

	ПраваПрежние = ПраваНовые.СкопироватьКолонки();
	Если Замещение Тогда
		ПраваПрежние = ПраваДоступаВБазе(Набор.Отбор);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Не ПраваСовпадают(ПраваПрежние, ПраваНовые);

КонецФункции

// Меняет ли удаление записи с этим ключом права группы «Настройки доступа» - для смены ключа записи в форме: старая
// запись удаляется отдельно от записи новой.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - пользователь удаляемой записи.
//  Настройка    - ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - вид удаляемой записи.
//
// Возвращаемое значение:
//  Булево - Истина, если в базе есть такая запись права.
//
Функция УдалениеЗаписиМеняетПраваДоступа(Пользователь, Настройка) Экспорт

	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Установить(Пользователь);
	Набор.Отбор.Настройка.Установить(Настройка);
	Возврат ИзменяютсяПраваДоступа(Набор);

КонецФункции

// Может ли текущий пользователь менять права группы «Настройки доступа»: роль «Администратор» или «Руководитель»
// у пользователя информационной базы. РольДоступна не годится - в привилегированном режиме она отвечает «Истина» на
// любую роль. Пустой список пользователей ИБ (вход без авторизации) - полные права. Роли и список пользователей
// читаются в привилегированном режиме: без права администрирования их не прочитать, а на ответ режим не влияет.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь вправе выдавать и снимать права.
//
Функция ЭтоАдминистраторНастроек() Экспорт

	// BSLLS:SetPrivilegedMode-off - чтение ролей текущего пользователя ИБ, решение от режима не зависит
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПустаяСтрока(Пользователь.Имя) Тогда
		Результат = ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() = 0;
	Иначе
		Результат = Пользователь.Роли.Содержит(Метаданные.Роли.Администратор)
			Или Пользователь.Роли.Содержит(Метаданные.Роли.Руководитель);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;

КонецФункции

// Рабочие места, которые пользователь открывает при запуске программы (docs/plans/startup-forms-warehouse-role.md):
// булев вид настройки группы «Формы при запуске» и обработка. Это же белый список механизма: других форм он не
// открывает и не записывает.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * Настройка    - ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - булев вид настройки.
//   * ИмяОбработки - Строка - имя обработки рабочего места.
//   * ИмяФормы     - Строка - полное имя открываемой формы.
//
Функция ФормыПриЗапуске() Экспорт

	Виды = ПланыВидовХарактеристик.ВидыНастроекПользователей;
	Формы = Новый ТаблицаЗначений;
	Формы.Колонки.Добавить("Настройка");
	Формы.Колонки.Добавить("ИмяОбработки");
	Формы.Колонки.Добавить("ИмяФормы");
	ДобавитьФормуПриЗапуске(Формы, Виды.ОткрыватьАРМПроизводство, "АРМПроизводство");
	ДобавитьФормуПриЗапуске(Формы, Виды.ОткрыватьАРМЗакупки, "АРМЗакупки");
	ДобавитьФормуПриЗапуске(Формы, Виды.ОткрыватьАРМУправлениеСтанками, "АРМУправлениеСтанками");
	ДобавитьФормуПриЗапуске(Формы, Виды.ОткрыватьРабочееМестоКассира, "VentesEnDetail");
	Возврат Формы;

КонецФункции

// Закладки дашборда начальной страницы, которые пользователь видит по своим флажкам (docs/plans/startup-dashboard-settings.md):
// булев вид настройки группы «Формы при запуске» и имя страницы БазовыйДашборд. Порядок - порядок закладок: первая
// отмеченная открыта при входе.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * Настройка     - ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - булев вид настройки.
//   * ИмяСтраницы   - Строка - имя страницы формы Обработка.Дашборд.Форма.БазовыйДашборд.
//   * Представление - Строка - название закладки на языке сеанса.
//
Функция ЗакладкиДашборда() Экспорт

	Виды = ПланыВидовХарактеристик.ВидыНастроекПользователей;
	Закладки = Новый ТаблицаЗначений;
	Закладки.Колонки.Добавить("Настройка");
	Закладки.Колонки.Добавить("ИмяСтраницы", Новый ОписаниеТипов("Строка"));
	Закладки.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ДобавитьЗакладкуДашборда(Закладки, Виды.ПоказыватьДашбордСток, "СтраницаСток",
		НСтр("ru = 'Сток'; fr = 'Stock'; en = 'Stock'; es = 'Stock'"));
	ДобавитьЗакладкуДашборда(Закладки, Виды.ПоказыватьДашбордПродажи, "СтраницаПродажи",
		НСтр("ru = 'Продажи'; fr = 'Ventes'; en = 'Sales'; es = 'Ventas'"));
	ДобавитьЗакладкуДашборда(Закладки, Виды.ПоказыватьДашбордПроизводство, "СтраницаПроизводство",
		НСтр("ru = 'Производство'; fr = 'Production'; en = 'Production'; es = 'Producción'"));
	Возврат Закладки;

КонецФункции

// Все пункты закладки «При запуске» карточки пользователя: рабочие места, затем закладки дашборда.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * Настройка     - ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - булев вид настройки.
//   * Представление - Строка - название пункта на языке сеанса.
//
Функция ВсеНастройкиПриЗапуске() Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Настройка");
	Результат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Для Каждого Форма Из ФормыПриЗапуске() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Настройка = Форма.Настройка;
		НоваяСтрока.Представление = Метаданные.Обработки[Форма.ИмяОбработки].Представление();
	КонецЦикла;
	ШаблонЗакладки = НСтр("ru = 'Дашборд: %1'; fr = 'Tableau de bord : %1'; en = 'Dashboard: %1'; es = 'Panel: %1'");
	Для Каждого Закладка Из ЗакладкиДашборда() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Настройка = Закладка.Настройка;
		НоваяСтрока.Представление = СтрШаблон(ШаблонЗакладки, Закладка.Представление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отмеченные пункты «При запуске» пользователя: рабочие места и закладки дашборда.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - владелец настроек.
//
// Возвращаемое значение:
//  Массив из ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - виды со значением Истина.
//
Функция ОтмеченныеНастройкиПриЗапуске(Пользователь) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Настройки.Настройка КАК Настройка
	|ИЗ
	|	РегистрСведений.НастройкиПользователей КАК Настройки
	|ГДЕ
	|	Настройки.Пользователь = &Пользователь
	|	И Настройки.Настройка В (&Виды)
	|	И Настройки.Значение = ИСТИНА");
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Виды", ВсеНастройкиПриЗапуске().ВыгрузитьКолонку("Настройка"));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Настройка");

КонецФункции

// Пишет изменённые пункты «При запуске» пользователя - только переданные: пункт, отмеченный в рабочем месте после того,
// как карточка прочитала флажки, не снимается (docs/plans/startup-dashboard-settings.md, ревью плана).
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - владелец настроек.
//  Изменения    - Соответствие из КлючИЗначение - ключ: ПланВидовХарактеристикСсылка.ВидыНастроекПользователей, значение:
//                 Булево - новая отметка; виды вне пунктов «При запуске» пропускаются.
//
Процедура ЗаписатьНастройкиПриЗапуске(Пользователь, Изменения) Экспорт

	Разрешенные = ВсеНастройкиПриЗапуске().ВыгрузитьКолонку("Настройка");
	НачатьТранзакцию();
	Попытка
		Для Каждого Изменение Из Изменения Цикл
			Если Разрешенные.Найти(Изменение.Ключ) <> Неопределено И ТипЗнч(Изменение.Значение) = Тип("Булево") Тогда
				ЗаписатьОтметкуФормы(Пользователь, Изменение.Ключ, Изменение.Значение);
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Ставит флажки «При запуске» по ролям пользователя - то, что он видел до настройки (обработчик обновления 2.0.17.30 и
// начальное заполнение, docs/plans/startup-dashboard-settings.md). Только добавляет отметки, снятые не трогает:
// роли сверяются по пользователю ИБ, а не РольДоступна - вызов идёт под администратором.
// - Кассир (PDV без основных ролей) - касса при запуске, дашборда нет (тикет 2606229).
// - Остальные с ролью сверх «Оператора производства» - закладки дашборда, разрешённые ролями: Сток и Продажи - всем,
//   кроме оператора производства, Производство - оператору; Администратору - все.
//
// Параметры:
//  Пользователь  - СправочникСсылка.Пользователи - владелец настроек.
//  ПользовательИБ - ПользовательИнформационнойБазы - его пользователь ИБ.
//
Процедура ЗаполнитьНастройкиПриЗапускеПоРолям(Пользователь, ПользовательИБ) Экспорт

	Отмеченные = ОтмеченныеНастройкиПриЗапуске(Пользователь);
	Изменения = Новый Соответствие;
	Для Каждого Настройка Из НастройкиПриЗапускеПоРолям(ПользовательИБ.Роли) Цикл
		Если Отмеченные.Найти(Настройка) = Неопределено Тогда
			Изменения.Вставить(Настройка, Истина);
		КонецЕсли;
	КонецЦикла;
	Если Изменения.Количество() > 0 Тогда
		ЗаписатьНастройкиПриЗапуске(Пользователь, Изменения);
	КонецЕсли;

КонецПроцедуры

// Отмеченные рабочие места пользователя - для закладки «При запуске» его карточки.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - владелец настроек.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * Настройка     - ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - вид настройки.
//   * Представление - Строка - название рабочего места на языке сеанса.
//
Функция ФормыПриЗапускеПользователя(Пользователь) Экспорт

	ИмяКолонкиНастройки = "Настройка";
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить(ИмяКолонкиНастройки);
	Результат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Формы = ФормыПриЗапуске();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Настройки.Настройка КАК Настройка
	|ИЗ
	|	РегистрСведений.НастройкиПользователей КАК Настройки
	|ГДЕ
	|	Настройки.Пользователь = &Пользователь
	|	И Настройки.Настройка В (&Виды)
	|	И Настройки.Значение = ИСТИНА");
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Виды", Формы.ВыгрузитьКолонку(ИмяКолонкиНастройки));
	Отмеченные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(ИмяКолонкиНастройки);
	// Порядок - порядок ФормыПриЗапуске, тот же, в котором формы открываются.
	Для Каждого Форма Из Формы Цикл
		Если Отмеченные.Найти(Форма.Настройка) <> Неопределено Тогда
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Настройка = Форма.Настройка;
			НоваяСтрока.Представление = Метаданные.Обработки[Форма.ИмяОбработки].Представление();
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Снимает отметку «Открывать при запуске» с переданных рабочих мест пользователя - только с них: строки, отмеченные в
// рабочем месте после того, как карточка прочитала таблицу, остаются (ревью плана, круг 4).
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - владелец настроек.
//  Настройки    - Массив из ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - снимаемые виды; виды вне
//                 группы «Формы при запуске» пропускаются.
//
Процедура УдалитьФормыПриЗапуске(Пользователь, Настройки) Экспорт

	Разрешенные = ФормыПриЗапуске().ВыгрузитьКолонку("Настройка");
	НачатьТранзакцию();
	Попытка
		Для Каждого Настройка Из Настройки Цикл
			Если Разрешенные.Найти(Настройка) <> Неопределено Тогда
				ЗаписатьОтметкуФормы(Пользователь, Настройка, Ложь);
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Пишет или снимает отметку рабочего места пользователя: Истина - запись, Ложь - пустой набор (нет записи - не
// открывать). Вызывается в транзакции; блокирует запись по пользователю и виду.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - владелец настройки.
//  Настройка    - ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - вид группы «Формы при запуске».
//  Открывать    - Булево - отметка.
//
Процедура ЗаписатьОтметкуФормы(Пользователь, Настройка, Открывать) Экспорт

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НастройкиПользователей");
	ЭлементБлокировки.УстановитьЗначение("Пользователь", Пользователь);
	ЭлементБлокировки.УстановитьЗначение("Настройка", Настройка);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Установить(Пользователь);
	Набор.Отбор.Настройка.Установить(Настройка);
	Если Открывать Тогда
		Запись = Набор.Добавить();
		Запись.Пользователь = Пользователь;
		Запись.Настройка = Настройка;
		Запись.Значение = Истина;
	КонецЕсли;
	Набор.Записать();

КонецПроцедуры
#КонецОбласти

#Область Дополнительно

Функция ПолучитьЗначениеНастройки(Настройка)
	УстановитьПривилегированныйРежим(Истина);
	Результат = РегистрыСведений.НастройкиПользователей.Получить(Новый Структура("Пользователь, Настройка", ПараметрыСеанса.Пользователь, Настройка));		
	Возврат ?(Результат.Значение = Неопределено, Настройка.ТипЗначения.ПривестиЗначение(), Результат.Значение);	
КонецФункции	

// Значение настройки текущего пользователя без подстановки значения по умолчанию.
//
// Параметры:
//  Настройка - ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - вид настройки.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - записанное значение, приведённое к типу настройки; Неопределено - записи нет.
//
Функция ЗаданноеЗначениеНастройки(Настройка)
	// BSLLS:SetPrivilegedMode-off - настройку своего пользователя читает каждый, как в ПолучитьЗначениеНастройки
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Ключ = Новый Структура("Пользователь, Настройка", ПараметрыСеанса.Пользователь, Настройка);
	Результат = РегистрыСведений.НастройкиПользователей.Получить(Ключ);
	Если Результат.Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Настройка.ТипЗначения.ПривестиЗначение(Результат.Значение);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строки прав группы «Настройки доступа» в базе, которые замещает набор с таким отбором; без отбора - все.
//
// Параметры:
//  Отбор - Отбор - отбор набора записей регистра.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Пользователь, Настройка, Значение.
//
Функция ПраваДоступаВБазе(Отбор)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Группа", ПланыВидовХарактеристик.ВидыНастроекПользователей.НастройкиДоступа);
	Условия = Новый Массив;
	Для Каждого ИмяИзмерения Из СтрРазделить("Пользователь,Настройка", ",") Цикл
		ЭлементОтбора = Отбор[ИмяИзмерения];
		Если ЭлементОтбора.Использование Тогда
			Условия.Добавить(СтрШаблон("Настройки.%1 = &%1", ИмяИзмерения));
			Запрос.УстановитьПараметр(ИмяИзмерения, ЭлементОтбора.Значение);
		КонецЕсли;
	КонецЦикла;
	ТекстОтбора = "";
	Если Условия.Количество() > 0 Тогда
		ТекстОтбора = "
		|	И " + СтрСоединить(Условия, "
		|	И ");
	КонецЕсли;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Настройки.Пользователь КАК Пользователь,
	|	Настройки.Настройка КАК Настройка,
	|	Настройки.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.НастройкиПользователей КАК Настройки
	|ГДЕ
	|	Настройки.Настройка В ИЕРАРХИИ (&Группа)" + ТекстОтбора;
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Параметры:
//  Прежние - ТаблицаЗначений - строки прав в базе, колонки Пользователь, Настройка, Значение.
//  Новые   - ТаблицаЗначений - строки прав в наборе, те же колонки.
//
// Возвращаемое значение:
//  Булево - наборы прав одинаковы: те же пары «пользователь, вид» с теми же значениями. Сверка в обе стороны: дубль
//           ключа в наборе при равном числе строк не маскирует пропавшую строку базы.
//
Функция ПраваСовпадают(Прежние, Новые)

	Возврат Прежние.Количество() = Новые.Количество()
		И КаждаяСтрокаЕстьВ(Прежние, Новые) И КаждаяСтрокаЕстьВ(Новые, Прежние);

КонецФункции

// Параметры:
//  Строки - ТаблицаЗначений - колонки Пользователь, Настройка, Значение.
//  Где    - ТаблицаЗначений - те же колонки.
//
// Возвращаемое значение:
//  Булево - для каждой строки Строки в Где ровно одна строка с тем же ключом и тем же значением.
//
Функция КаждаяСтрокаЕстьВ(Строки, Где)

	Для Каждого Строка Из Строки Цикл
		Найденные = Где.НайтиСтроки(Новый Структура("Пользователь, Настройка", Строка.Пользователь, Строка.Настройка));
		Если Найденные.Количество() <> 1 Или Найденные[0].Значение <> Строка.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Процедура ДобавитьФормуПриЗапуске(Формы, Настройка, ИмяОбработки)
	Форма = Формы.Добавить();
	Форма.Настройка = Настройка;
	Форма.ИмяОбработки = ИмяОбработки;
	Форма.ИмяФормы = "Обработка." + ИмяОбработки + ".Форма";
КонецПроцедуры

// Пункты «При запуске», которые пользователь видел до настройки, - по ролям (см. ЗаполнитьНастройкиПриЗапускеПоРолям).
//
// Параметры:
//  Роли - РолиПользователяИнформационнойБазы - роли пользователя ИБ.
//
// Возвращаемое значение:
//  Массив из ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - отмечаемые виды.
//
Функция НастройкиПриЗапускеПоРолям(Роли)

	Виды = ПланыВидовХарактеристик.ВидыНастроекПользователей;
	Результат = Новый Массив;
	// Как форма дашборда (РольДоступна): все закладки - только администратору, руководителю - по общей ветке.
	ПолныеПрава = Роли.Содержит(Метаданные.Роли.Администратор);
	ОператорПроизводства = Роли.Содержит(Метаданные.Роли.ОператорПроизводства);
	Если Роли.Содержит(Метаданные.Роли.PDV) И Не ЕстьОсновнаяРоль(Роли) Тогда
		Результат.Добавить(Виды.ОткрыватьРабочееМестоКассира);
		Возврат Результат;
	КонецЕсли;
	// До настройки дашборд был виден всем, у кого есть роль сверх «Оператора производства» (у коллекции ролей
	// пользователя ИБ нет Количество - перебор).
	ЕстьКромеОператора = Ложь;
	Для Каждого Роль Из Роли Цикл
		ЕстьКромеОператора = ЕстьКромеОператора Или Роль <> Метаданные.Роли.ОператорПроизводства;
	КонецЦикла;
	Если Не ЕстьКромеОператора Тогда
		Возврат Результат;
	КонецЕсли;
	Если ПолныеПрава Или Не ОператорПроизводства Тогда
		Результат.Добавить(Виды.ПоказыватьДашбордСток);
		Результат.Добавить(Виды.ПоказыватьДашбордПродажи);
	КонецЕсли;
	Если ПолныеПрава Или ОператорПроизводства Тогда
		Результат.Добавить(Виды.ПоказыватьДашбордПроизводство);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Параметры:
//  Роли - РолиПользователяИнформационнойБазы - роли пользователя ИБ.
//
// Возвращаемое значение:
//  Булево - есть роль сверх кассира и допусков: такой пользователь не только кассир.
//
Функция ЕстьОсновнаяРоль(Роли)

	Основные = СтрРазделить("Администратор,Руководитель,МенеджерПоПродажам,МенеджерПоЗакупкам,Кладовщик,Казначей,"
		+ "Логист,Оператор,БухгалтерПоЗарплате,ОператорПроизводства", ",");
	Для Каждого Роль Из Роли Цикл
		Если Основные.Найти(Роль.Имя) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ДобавитьЗакладкуДашборда(Закладки, Настройка, ИмяСтраницы, Представление)
	Закладка = Закладки.Добавить();
	Закладка.Настройка = Настройка;
	Закладка.ИмяСтраницы = ИмяСтраницы;
	Закладка.Представление = Представление;
КонецПроцедуры

#КонецОбласти
