// Меняет ли запись набора права группы «Настройки доступа» (ПВХ ВидыНастроекПользователей): сравниваются строки прав
// в базе по отбору набора (их запись замещает или удаляет) и строки прав в самом наборе. Права, которые остаются
// прежними, изменением не считаются - не-администратор может перезаписать свои бытовые настройки целиком.
//
// Параметры:
//  Набор     - РегистрСведенийНаборЗаписей.НастройкиПользователей - записываемый набор.
//  Замещение - Булево - режим записи: Ложь - строки добавляются к базе, замещаемых нет.
//
// Возвращаемое значение:
//  Булево - Истина, если после записи права доступа будут другими.
//
Функция ИзменяютсяПраваДоступа(Набор, Замещение = Истина) Экспорт

	// BSLLS:SetPrivilegedMode-off - родителей видов и строки базы читает проверка прав, а не пишущий пользователь
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Новые = Набор.Выгрузить(, "Пользователь, Настройка, Значение");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Группа", ПланыВидовХарактеристик.ВидыНастроекПользователей.НастройкиДоступа);
	Запрос.УстановитьПараметр("Настройки", Новые.ВыгрузитьКолонку("Настройка"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Виды.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ВидыНастроекПользователей КАК Виды
	|ГДЕ
	|	Виды.Ссылка В (&Настройки)
	|	И Виды.Ссылка В ИЕРАРХИИ (&Группа)";
	ВидыДоступа = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	ПраваНовые = Новые.СкопироватьКолонки();
	Для Каждого Строка Из Новые Цикл
		Если ВидыДоступа.Найти(Строка.Настройка) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ПраваНовые.Добавить(), Строка);
		КонецЕсли;
	КонецЦикла;

	ПраваПрежние = ПраваНовые.СкопироватьКолонки();
	Если Замещение Тогда
		ПраваПрежние = ПраваДоступаВБазе(Набор.Отбор);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Не ПраваСовпадают(ПраваПрежние, ПраваНовые);

КонецФункции

// Меняет ли удаление записи с этим ключом права группы «Настройки доступа» - для смены ключа записи в форме: старая
// запись удаляется отдельно от записи новой.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - пользователь удаляемой записи.
//  Настройка    - ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - вид удаляемой записи.
//
// Возвращаемое значение:
//  Булево - Истина, если в базе есть такая запись права.
//
Функция УдалениеЗаписиМеняетПраваДоступа(Пользователь, Настройка) Экспорт

	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Установить(Пользователь);
	Набор.Отбор.Настройка.Установить(Настройка);
	Возврат ИзменяютсяПраваДоступа(Набор);

КонецФункции

// Может ли текущий пользователь менять права группы «Настройки доступа»: роль «Администратор» или «Руководитель»
// у пользователя информационной базы. РольДоступна не годится - в привилегированном режиме она отвечает «Истина» на
// любую роль. Пустой список пользователей ИБ (вход без авторизации) - полные права. Роли и список пользователей
// читаются в привилегированном режиме: без права администрирования их не прочитать, а на ответ режим не влияет.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь вправе выдавать и снимать права.
//
Функция ЭтоАдминистраторНастроек() Экспорт

	// BSLLS:SetPrivilegedMode-off - чтение ролей текущего пользователя ИБ, решение от режима не зависит
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПустаяСтрока(Пользователь.Имя) Тогда
		Результат = ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() = 0;
	Иначе
		Результат = Пользователь.Роли.Содержит(Метаданные.Роли.Администратор)
			Или Пользователь.Роли.Содержит(Метаданные.Роли.Руководитель);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;

КонецФункции
#КонецОбласти

#Область Дополнительно

Функция ПолучитьЗначениеНастройки(Настройка)
	УстановитьПривилегированныйРежим(Истина);
	Результат = РегистрыСведений.НастройкиПользователей.Получить(Новый Структура("Пользователь, Настройка", ПараметрыСеанса.Пользователь, Настройка));		
	Возврат ?(Результат.Значение = Неопределено, Настройка.ТипЗначения.ПривестиЗначение(), Результат.Значение);	
КонецФункции	

// Значение настройки текущего пользователя без подстановки значения по умолчанию.
//
// Параметры:
//  Настройка - ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - вид настройки.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - записанное значение, приведённое к типу настройки; Неопределено - записи нет.
//
Функция ЗаданноеЗначениеНастройки(Настройка)
	// BSLLS:SetPrivilegedMode-off - настройку своего пользователя читает каждый, как в ПолучитьЗначениеНастройки
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Ключ = Новый Структура("Пользователь, Настройка", ПараметрыСеанса.Пользователь, Настройка);
	Результат = РегистрыСведений.НастройкиПользователей.Получить(Ключ);
	Если Результат.Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Настройка.ТипЗначения.ПривестиЗначение(Результат.Значение);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строки прав группы «Настройки доступа» в базе, которые замещает набор с таким отбором; без отбора - все.
//
// Параметры:
//  Отбор - Отбор - отбор набора записей регистра.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Пользователь, Настройка, Значение.
//
Функция ПраваДоступаВБазе(Отбор)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Группа", ПланыВидовХарактеристик.ВидыНастроекПользователей.НастройкиДоступа);
	Условия = Новый Массив;
	Для Каждого ИмяИзмерения Из СтрРазделить("Пользователь,Настройка", ",") Цикл
		ЭлементОтбора = Отбор[ИмяИзмерения];
		Если ЭлементОтбора.Использование Тогда
			Условия.Добавить(СтрШаблон("Настройки.%1 = &%1", ИмяИзмерения));
			Запрос.УстановитьПараметр(ИмяИзмерения, ЭлементОтбора.Значение);
		КонецЕсли;
	КонецЦикла;
	ТекстОтбора = "";
	Если Условия.Количество() > 0 Тогда
		ТекстОтбора = "
		|	И " + СтрСоединить(Условия, "
		|	И ");
	КонецЕсли;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Настройки.Пользователь КАК Пользователь,
	|	Настройки.Настройка КАК Настройка,
	|	Настройки.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.НастройкиПользователей КАК Настройки
	|ГДЕ
	|	Настройки.Настройка В ИЕРАРХИИ (&Группа)" + ТекстОтбора;
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Параметры:
//  Прежние - ТаблицаЗначений - строки прав в базе, колонки Пользователь, Настройка, Значение.
//  Новые   - ТаблицаЗначений - строки прав в наборе, те же колонки.
//
// Возвращаемое значение:
//  Булево - наборы прав одинаковы: те же пары «пользователь, вид» с теми же значениями. Сверка в обе стороны: дубль
//           ключа в наборе при равном числе строк не маскирует пропавшую строку базы.
//
Функция ПраваСовпадают(Прежние, Новые)

	Возврат Прежние.Количество() = Новые.Количество()
		И КаждаяСтрокаЕстьВ(Прежние, Новые) И КаждаяСтрокаЕстьВ(Новые, Прежние);

КонецФункции

// Параметры:
//  Строки - ТаблицаЗначений - колонки Пользователь, Настройка, Значение.
//  Где    - ТаблицаЗначений - те же колонки.
//
// Возвращаемое значение:
//  Булево - для каждой строки Строки в Где ровно одна строка с тем же ключом и тем же значением.
//
Функция КаждаяСтрокаЕстьВ(Строки, Где)

	Для Каждого Строка Из Строки Цикл
		Найденные = Где.НайтиСтроки(Новый Структура("Пользователь, Настройка", Строка.Пользователь, Строка.Настройка));
		Если Найденные.Количество() <> 1 Или Найденные[0].Значение <> Строка.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти
