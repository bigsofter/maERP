#Область Дополнительно

Функция ПолучитьЗначениеНастройки(Настройка)
	УстановитьПривилегированныйРежим(Истина);
	Результат = РегистрыСведений.НастройкиПользователей.Получить(Новый Структура("Пользователь, Настройка", ПараметрыСеанса.Пользователь, Настройка));		
	Возврат ?(Результат.Значение = Неопределено, Настройка.ТипЗначения.ПривестиЗначение(), Результат.Значение);	
КонецФункции	

// Значение настройки текущего пользователя без подстановки значения по умолчанию.
//
// Параметры:
//  Настройка - ПланВидовХарактеристикСсылка.ВидыНастроекПользователей - вид настройки.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - записанное значение, приведённое к типу настройки; Неопределено - записи нет.
//
Функция ЗаданноеЗначениеНастройки(Настройка)
	// BSLLS:SetPrivilegedMode-off - настройку своего пользователя читает каждый, как в ПолучитьЗначениеНастройки
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Ключ = Новый Структура("Пользователь, Настройка", ПараметрыСеанса.Пользователь, Настройка);
	Результат = РегистрыСведений.НастройкиПользователей.Получить(Ключ);
	Если Результат.Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Настройка.ТипЗначения.ПривестиЗначение(Результат.Значение);
КонецФункции

#КонецОбласти