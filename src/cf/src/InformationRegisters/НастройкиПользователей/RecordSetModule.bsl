#Область ОбработчикиСобытий

// Права группы «Настройки доступа» («Кассир», «Видеть суммы (производство)» и другие) меняет только администратор
// (SEC-2, решение владельца 2026-10-05). Бытовые настройки - принтеры, касса, склад - пользователь пишет себе сам.
// ОбменДанными.Загрузка проверку не снимает: планов обмена с регистром нет, а выставить признак может любой код.
//
// Параметры:
//  Отказ     - Булево - отказ от записи.
//  Замещение - Булево - режим записи набора.
//
// BSLLS:DataExchangeLoading-off - признак загрузки выставляет любой код, проверка прав от него не зависит
Процедура ПередЗаписью(Отказ, Замещение)

	Менеджер = РегистрыСведений.НастройкиПользователей;
	Если Не Менеджер.ЭтоАдминистраторНастроек() И Менеджер.ИзменяютсяПраваДоступа(ЭтотОбъект, Замещение) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'Права пользователей (группа «Настройки доступа») меняет только администратор.';
			|fr = 'Seul l''administrateur modifie les droits des utilisateurs (groupe « Paramètres d''accès »).';
			|en = 'Only the administrator can change user rights (the ""Access settings"" group).';
			|es = 'Solo el administrador puede cambiar los derechos de los usuarios (grupo «Configuración de acceso»).'"));
	КонецЕсли;

КонецПроцедуры
// BSLLS:DataExchangeLoading-on

#КонецОбласти
