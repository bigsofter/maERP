
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СформироватьИзображение();		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОперацииСПодключаемымОборудованиемКлиент.ПодключитьОборудование(УникальныйИдентификатор, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ОперацииСПодключаемымОборудованиемКлиент.ОтключитьОборудование(УникальныйИдентификатор, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Штрихкод = ОперацииСПодключаемымОборудованиемКлиент.ПолучитьШтрихкод(ИмяСобытия, Параметр, Источник);
	Если ЗначениеЗаполнено(Штрихкод) Тогда
		Запись.Штрихкод = Штрихкод;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Запись.Штрихкод = РегистрыСведений.ШтрихкодыНоменклатуры.СформироватьEAN13();
	СформироватьИзображение();
КонецПроцедуры

&НаСервере
Процедура СформироватьИзображение()
	П = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
	П.Штрихкод = Запись.Штрихкод;
	П.Ширина = 200;
	П.Высота = 80;
	П.ТипКода = 16;
	П.ОтображатьТекст = Истина;
	П.Масштабировать = Истина;
	П.СохранятьПропорции = Истина;
	П.ВертикальноеВыравнивание = 0; 
	П.ТипВходныхДанных = 0;
	Данные = ГенерацияШтрихкода.ИзображениеШтрихкода(П);
	// Компонента генерации может быть недоступна (пустой штрихкод, нет внешней компоненты) -
	// тогда вместо структуры возвращается Неопределено.
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Результат Тогда
		ШтрихкодИзображение = ПоместитьВоВременноеХранилище(Данные.ДвоичныеДанные, УникальныйИдентификатор);	
	КонецЕсли;	
КонецПроцедуры	


