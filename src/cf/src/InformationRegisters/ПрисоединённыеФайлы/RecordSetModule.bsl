
Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Файлы КП меняет только тот, кто меняет КП: форма записи, удаление в списке и смена владельца идут мимо
	// модуля вызова сервера (docs/plans/kp-print-terms.md, круг 4).
	ИмяРоли = "";
	Если Не ДополнительныеСвойства.Свойство("РольПроверкиПрав", ИмяРоли) Тогда
		ИмяРоли = "";
	КонецЕсли;
	Для Каждого Владелец Из ЗатрагиваемыеВладельцы(Замещение) Цикл
		Если Не ПраваНаФайлы.ПравоИзмененияВладельца(Владелец, ИмяРоли) Тогда
			ШаблонОтказа = НСтр("ru = 'Недостаточно прав для изменения файлов объекта «%1».';
				|fr = 'Droits insuffisants pour modifier les fichiers de l''objet « %1 ».';
				|en = 'Insufficient rights to change the files of «%1».';
				|es = 'Derechos insuficientes para modificar los archivos de «%1».'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ШаблонОтказа, Владелец));
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Не ЗначениеЗаполнено(Запись.ДатаДобавления) Тогда
			Запись.ДатаДобавления = ТекущаяДатаСеанса();	
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры 

Процедура ПриЗаписи(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РегистрыСведений.ПрисоединённыеФайлыНаличие.ОбновитьНаличиеФайлов(ЭтотОбъект.Отбор.Объект.Значение);
КонецПроцедуры

Функция ЗатрагиваемыеВладельцы(Замещение)
	// Новые записи набора и, при замещении, записи, которые он заменяет или удаляет.
	Владельцы = Новый Массив;
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Владельцы.Найти(Запись.Объект) = Неопределено Тогда
			Владельцы.Добавить(Запись.Объект);
		КонецЕсли;
	КонецЦикла;
	Если Замещение Тогда
		// Только владельцы записей под отбором набора, без данных файлов.
		Запрос = Новый Запрос;
		ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Файлы.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.ПрисоединённыеФайлы КАК Файлы
		|ГДЕ
		|	ИСТИНА";
		Для Каждого ЭлементОтбора Из Отбор Цикл
			Если ЭлементОтбора.Использование Тогда
				ТекстЗапроса = ТекстЗапроса + "
				|	И Файлы." + ЭлементОтбора.Имя + " = &" + ЭлементОтбора.Имя;
				Запрос.УстановитьПараметр(ЭлементОтбора.Имя, ЭлементОтбора.Значение);
			КонецЕсли;
		КонецЦикла;
		Запрос.Текст = ТекстЗапроса;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Владельцы.Найти(Выборка.Объект) = Неопределено Тогда
				Владельцы.Добавить(Выборка.Объект);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Владельцы;
КонецФункции
