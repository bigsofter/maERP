// Вопрос об установке расширения для работы с 1С:Предприятием. Открывается только из
// РасширениеРаботыС1СПредприятиемКлиент.Подключить() и возвращает вызывающему коду
// строку действия: «РасширениеПодключено», «БольшеНеПредлагать» или «Отмена».

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ПустаяСтрока(Параметры.ТекстПредложения) Тогда
		Элементы.Пояснение.Заголовок = Параметры.ТекстПредложения + Символы.ПС
			+ НСтр("ru = 'Установить?'; fr = 'Installer ?'; en = 'Install?'; es = '¿Instalar?'");
	КонецЕсли;

	Если Не Параметры.ВозможноПродолжениеБезУстановки Тогда
		// Без расширения действие невозможно, продолжать нечего - только отменить.
		Элементы.ПродолжитьБезУстановки.Заголовок = НСтр("ru = 'Отмена'; fr = 'Annuler'; en = 'Cancel'; es = 'Cancelar'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьИПродолжить(Команда)

	НачатьУстановкуРасширенияРаботыСФайлами(Новый ОписаниеОповещения("ПослеУстановкиРасширения", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьБезУстановки(Команда)

	// Отказ запоминается на этом компьютере только тогда, когда работа без расширения возможна:
	// иначе пользователь не отказался от установки, а отменил само действие.
	Закрыть(?(Параметры.ВозможноПродолжениеБезУстановки, "БольшеНеПредлагать", "Отмена"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Продолжение команды УстановитьИПродолжить: установка расширения завершена.
//
// Параметры:
//  ДополнительныеПараметры - Произвольный - не используются.
//
&НаКлиенте
Процедура ПослеУстановкиРасширения(ДополнительныеПараметры) Экспорт

	НачатьПодключениеРасширенияРаботыСФайлами(Новый ОписаниеОповещения("ПослеПодключенияРасширения", ЭтотОбъект));

КонецПроцедуры

// Продолжение команды УстановитьИПродолжить: расширение подключено или подключить не удалось.
//
// Параметры:
//  Подключено - Булево - результат подключения.
//  ДополнительныеПараметры - Произвольный - не используются.
//
&НаКлиенте
Процедура ПослеПодключенияРасширения(Подключено, ДополнительныеПараметры) Экспорт

	Закрыть(?(Подключено, "РасширениеПодключено", "БольшеНеПредлагать"));

КонецПроцедуры

#КонецОбласти
