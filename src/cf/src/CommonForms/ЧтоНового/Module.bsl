#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Закладка на каждый язык конфигурации: реквизит, страница и поле HTML-документа
	// создаются программно, поэтому добавление языка в конфигурацию форму не затрагивает.
	СоздатьРеквизитыЯзыков();
	ЗаполнитьЗакладкиЯзыков();

	ШаблонЗаголовка = НСтр("ru = 'Что нового в maERP %1'; fr = 'Nouveautés de maERP %1';
		|en = 'What''s new in maERP %1'; es = 'Novedades de maERP %1'");
	Заголовок = СтрШаблон(ШаблонЗаголовка, ОбновлениеПрограммы.ВерсияКонфигурации());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет на форму по строковому реквизиту на каждый язык конфигурации.
//
&НаСервере
Процедура СоздатьРеквизитыЯзыков()

	ТипСтрока = Новый ОписаниеТипов("Строка");

	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого Язык Из Метаданные.Языки Цикл
		Реквизит = Новый РеквизитФормы(ИмяРеквизитаЯзыка(Язык.КодЯзыка), ТипСтрока);
		ДобавляемыеРеквизиты.Добавить(Реквизит);
	КонецЦикла;

	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

КонецПроцедуры

// Создаёт страницу с полем HTML-документа на каждый язык и заполняет их описанием изменений.
// Активной становится закладка языка текущего сеанса.
//
&НаСервере
Процедура ЗаполнитьЗакладкиЯзыков()

	// ТекущийЯзык() в части контекстов возвращает строку, в остальных - объект метаданных.
	КодЯзыкаСеанса = ?(ТипЗнч(ТекущийЯзык()) = Тип("Строка"), ТекущийЯзык(), ТекущийЯзык().КодЯзыка);

	Для Каждого Язык Из Метаданные.Языки Цикл
		ИмяРеквизита = ИмяРеквизитаЯзыка(Язык.КодЯзыка);
		ЭтотОбъект[ИмяРеквизита] = HTMLОписанияИзменений(ОбновлениеПрограммы.ОписаниеИзменений(Язык.КодЯзыка));

		Страница = Элементы.Добавить("Страница_" + Язык.КодЯзыка, Тип("ГруппаФормы"), Элементы.Языки);
		Страница.Вид = ВидГруппыФормы.Страница;
		Страница.Заголовок = ?(ЗначениеЗаполнено(Язык.Синоним), Язык.Синоним, Язык.Имя);

		Поле = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), Страница);
		Поле.Вид = ВидПоляФормы.ПолеHTMLДокумента;
		Поле.ПутьКДанным = ИмяРеквизита;
		Поле.ТолькоПросмотр = Истина;
		Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		Поле.РастягиватьПоГоризонтали = Истина;
		Поле.РастягиватьПоВертикали = Истина;

		Если Язык.КодЯзыка = КодЯзыкаСеанса Тогда
			Элементы.Языки.ТекущаяСтраница = Страница;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Имя реквизита формы, хранящего описание изменений на одном языке.
//
// Параметры:
//  КодЯзыка - Строка - код языка конфигурации
//
// Возвращаемое значение:
//  Строка - имя реквизита формы
//
&НаСервереБезКонтекста
Функция ИмяРеквизитаЯзыка(КодЯзыка)

	Возврат "Описание_" + КодЯзыка;

КонецФункции

// Собирает HTML описания изменений: заголовок версии и список её пунктов.
// Поле формы - поле HTML-документа, поэтому разметка отображается браузером как есть.
//
// Параметры:
//  Секции - Массив из Структура - см. ОбновлениеПрограммы.ОписаниеИзменений
//
// Возвращаемое значение:
//  Строка - HTML-текст описания изменений
//
&НаСервереБезКонтекста
Функция HTMLОписанияИзменений(Секции)

	Части = Новый Массив;
	// Поле HTML-документа не наследует тему клиента, поэтому фон и текст задаются явно:
	// светлая пара - фирменные крем и тёплый текст, тёмная подключается media-запросом.
	Части.Добавить("<html><head><meta charset=""utf-8""><style>");
	Части.Добавить("body { font-family: -apple-system, ""Segoe UI"", Arial, sans-serif; font-size: 13px;");
	Части.Добавить(" background: #FAF4E6; color: #453B2E; margin: 12px 16px; }");
	Части.Добавить("h3 { font-size: 14px; margin: 18px 0 6px; color: #B4762A; }");
	Части.Добавить("h3:first-child { margin-top: 0; }");
	Части.Добавить("ul { margin: 0; padding-left: 20px; }");
	Части.Добавить("li { margin: 4px 0; }");
	Части.Добавить("@media (prefers-color-scheme: dark) {");
	Части.Добавить(" body { background: #26221C; color: #EDE5D8; }");
	Части.Добавить(" h3 { color: #E8A44E; } }");
	Части.Добавить("</style></head><body>");

	Если Секции.Количество() = 0 Тогда
		ТекстНетИзменений = НСтр("ru = 'Описание изменений не заполнено.';
			|fr = 'La description des modifications n''est pas renseignée.';
			|en = 'The description of changes is not filled in.';
			|es = 'La descripción de los cambios no está rellenada.'");
		Части.Добавить("<p>" + ЭкранироватьHTML(ТекстНетИзменений) + "</p>");
	Иначе
		ШаблонЗаголовка = НСтр("ru = 'Версия %1'; fr = 'Version %1'; en = 'Version %1'; es = 'Versión %1'");
		Для Каждого Секция Из Секции Цикл
			Части.Добавить("<h3>" + ЭкранироватьHTML(СтрШаблон(ШаблонЗаголовка, Секция.Версия)) + "</h3>");
			Части.Добавить("<ul>");
			Для Каждого Изменение Из Секция.Изменения Цикл
				Части.Добавить("<li>" + ЭкранироватьHTML(Изменение) + "</li>");
			КонецЦикла;
			Части.Добавить("</ul>");
		КонецЦикла;
	КонецЕсли;

	Части.Добавить("</body></html>");
	Возврат СтрСоединить(Части, "");

КонецФункции

// Экранирует символы, значимые для HTML.
//
// Параметры:
//  Текст - Строка - исходный текст
//
// Возвращаемое значение:
//  Строка - текст, безопасный для вставки в HTML
//
&НаСервереБезКонтекста
Функция ЭкранироватьHTML(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат Результат;

КонецФункции

#КонецОбласти
