#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Параметр ВерсияОт передаётся при автоматическом показе после обновления: показываются
	// только новые для пользователя версии. Без параметра форма открывается вручную и
	// показывает всю историю изменений.
	// Отметку о показе ставит ОбновлениеПрограммыВызовСервера.ОбработатьНачалоРаботы:
	// открытие формы данные не меняет, и смок-тест можно гонять на рабочей базе.
	Секции = ОбновлениеПрограммы.ОписаниеИзменений(Параметры.ВерсияОт);
	ОписаниеИзменений.УстановитьHTML(HTMLОписанияИзменений(Секции), Новый Структура);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собирает HTML описания изменений: заголовок версии и список её пунктов.
//
// Параметры:
//  Секции - Массив из Структура - см. ОбновлениеПрограммы.ОписаниеИзменений
//
// Возвращаемое значение:
//  Строка - HTML-текст для форматированного документа
//
&НаСервереБезКонтекста
Функция HTMLОписанияИзменений(Секции)

	Если Секции.Количество() = 0 Тогда
		ТекстНетИзменений = НСтр("ru = 'Описание изменений этой версии не заполнено.';
			|fr = 'La description des modifications de cette version n''est pas renseignée.';
			|en = 'The description of changes for this version is not filled in.';
			|es = 'La descripción de los cambios de esta versión no está rellenada.'");
		Возврат "<html><body><p>" + ЭкранироватьHTML(ТекстНетИзменений) + "</p></body></html>";
	КонецЕсли;

	ШаблонЗаголовка = НСтр("ru = 'Версия %1'; fr = 'Version %1'; en = 'Version %1'; es = 'Versión %1'");

	// Разметка нарочно бедная: абзацы, перенос строки и жирный - только то, что форматированный
	// документ отображает одинаково. Заголовки и списки (h3, ul) давали пустой абзац сверху.
	Части = Новый Массив;
	Части.Добавить("<html><body>");
	Для Каждого Секция Из Секции Цикл
		Части.Добавить("<p><b>" + ЭкранироватьHTML(СтрШаблон(ШаблонЗаголовка, Секция.Версия)) + "</b>");
		Для Каждого Изменение Из Секция.Изменения Цикл
			Части.Добавить("<br>• " + ЭкранироватьHTML(Изменение));
		КонецЦикла;
		Части.Добавить("</p>");
	КонецЦикла;
	Части.Добавить("</body></html>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Экранирует символы, значимые для HTML.
//
// Параметры:
//  Текст - Строка - исходный текст
//
// Возвращаемое значение:
//  Строка - текст, безопасный для вставки в HTML
//
&НаСервереБезКонтекста
Функция ЭкранироватьHTML(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат Результат;

КонецФункции

#КонецОбласти
