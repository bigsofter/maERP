#Область ОписаниеПеременных

// Принтеры компьютера пользователя: ключ - имя принтера, значение - Массив из Строка, форматы его бумаги.
// Неопределено - список не получен (не Windows), принтер тогда выбирается в диалоге печати.
&НаКлиенте
Перем ПринтерыКомпьютера;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИмяМенеджераПечати = Параметры.ИмяМенеджераПечати;
	Копий = 1;
	ЗаполнитьЯзыкиПечати();
	ЗаполнитьСписокОриентации();

	// Параметры формы доступны только при создании, а при смене языка печатные формы формируются
	// заново, поэтому что печатать запоминается во временном хранилище формы.
	ЧтоПечатать = Новый Структура("ИменаМакетов, ОбъектыПечати, ПараметрыПечати",
		Параметры.ИменаМакетов, Параметры.ОбъектыПечати, Параметры.ПараметрыПечати);
	АдресЧтоПечатать = ПоместитьВоВременноеХранилище(ЧтоПечатать, УникальныйИдентификатор);

	Результат = ПечатныеФормы.СформироватьПечатныеФормы(ИмяМенеджераПечати, Параметры.ИменаМакетов,
		Параметры.ОбъектыПечати, Параметры.ПараметрыПечати);

	// Табличные документы нельзя хранить в реквизите-таблице формы, поэтому вся коллекция
	// лежит во временном хранилище формы, а на экране показывается текущая печатная форма.
	АдресКоллекции = ПоместитьВоВременноеХранилище(Результат.КоллекцияПечатныхФорм, УникальныйИдентификатор);

	Для Каждого ПечатнаяФорма Из Результат.КоллекцияПечатныхФорм Цикл
		Строка = НастройкиПечатныхФорм.Добавить();
		Строка.Печатать = Истина;
		Строка.Представление = ?(ЗначениеЗаполнено(ПечатнаяФорма.СинонимМакета),
			ПечатнаяФорма.СинонимМакета, ПечатнаяФорма.ИмяМакета);
		Строка.ИмяМакета = ПечатнаяФорма.ИмяМакета;
		Строка.ПутьКМакету = ПечатнаяФорма.ПутьКМакету;
		Строка.ИмяФайла = ПечатнаяФорма.ИмяФайла;
	КонецЦикла;
	ЗаполнитьПараметрыСтраниц(Результат.КоллекцияПечатныхФорм);

	Если ЗначениеЗаполнено(Результат.ПараметрыВывода.ЗаголовокФормы) Тогда
		Заголовок = Результат.ПараметрыВывода.ЗаголовокФормы;
	КонецЕсли;

	Если НастройкиПечатныхФорм.Количество() > 0 Тогда
		ПоказатьПечатнуюФорму(НастройкиПечатныхФорм[0].ИмяМакета);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗаполнитьСписокБумаги();
	// Опрос WMI на компьютере с сетевыми принтерами занимает секунды: окно открывается сразу,
	// а список принтеров приходит следом.
	ЗадержкаСекунд = 0.1;
	ПодключитьОбработчикОжидания("ЗагрузитьПринтерыКомпьютера", ЗадержкаСекунд, Истина);

КонецПроцедуры

// Печатные формы лежат во временном хранилище, поэтому показ выбранной строки требует
// обращения к серверу; строк в списке единицы, задержка незаметна.
//
// Параметры:
//  Элемент - ТаблицаФормы - таблица печатных форм
//
// BSLLS:ServerCallsInFormEvents-off
&НаКлиенте
Процедура НастройкиПечатныхФормПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.НастройкиПечатныхФорм.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.ИмяМакета <> ИмяПоказанногоМакета Тогда
		ПоказатьПечатнуюФорму(ТекущиеДанные.ИмяМакета);
		// У другой печатной формы может быть другой принтер, а с ним и другие форматы бумаги.
		ЗаполнитьСписокБумаги();
	КонецЕсли;

КонецПроцедуры

// Общий обработчик полей панели «Страница»: параметры запоминаются для показанной печатной формы
// и предпросмотр строится заново.
//
// Параметры:
//  Элемент - ПолеФормы - изменённое поле панели
//
&НаКлиенте
Процедура ПараметрСтраницыПриИзменении(Элемент)

	ИзменитьПараметрСтраницы(Элемент.Имя);
	Если Элемент = Элементы.Принтер Тогда
		ЗаполнитьСписокБумаги();
	КонецЕсли;

КонецПроцедуры

// Многоязычные тексты берутся из макета в момент вывода области, и у готового табличного
// документа язык уже не сменить: печатные формы формируются заново на выбранном языке.
//
// Параметры:
//  Элемент - ПолеФормы - поле выбора языка
//
&НаКлиенте
Процедура ЯзыкПечатиПриИзменении(Элемент)

	ТекущиеДанные = Элементы.НастройкиПечатныхФорм.ТекущиеДанные;
	СформироватьНаВыбранномЯзыке(?(ТекущиеДанные = Неопределено, "", ТекущиеДанные.ИмяМакета));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)

	Пакеты = ПакетыПечати();
	Если Пакеты.Количество() = 0 Тогда
		СообщитьОбОтсутствииОтмеченных();
		Возврат;
	КонецЕсли;

	// В веб-клиенте вывод на принтер идёт через расширение для работы с 1С:Предприятием.
	// Без него печать выполняется средствами браузера, поэтому продолжение возможно и без установки.
	Оповещение = Новый ОписаниеОповещения("ПечатьПослеПодключенияРасширения", ЭтотОбъект, Пакеты);
	РасширениеРаботыС1СПредприятиемКлиент.Подключить(Оповещение,
		НСтр("ru = 'Для печати на принтер установите расширение для работы с 1С:Предприятием.';
			|fr = 'Pour imprimer sur une imprimante, installez l''extension pour travailler avec 1C:Entreprise.';
			|en = 'To print on a printer, install the 1C:Enterprise extension.';
			|es = 'Para imprimir en una impresora, instale la extensión para trabajar con 1C:Empresa.'"));

КонецПроцедуры

// Продолжение команды Печать: расширение подключено либо пользователь решил обойтись без него.
//
// Параметры:
//  РасширениеПодключено - Булево - результат подключения расширения, на печать не влияет.
//  Пакеты - Массив из Структура - см. ПакетыПечати.
//
&НаКлиенте
Процедура ПечатьПослеПодключенияРасширения(РасширениеПодключено, Пакеты) Экспорт

	Для Каждого Пакет Из Пакеты Цикл
		НапечататьПакет(Пакет);
	КонецЦикла;

КонецПроцедуры

// Печатает пакет на принтер, выбранный в панели, без диалога печати. Принтер не выбран, список
// принтеров недоступен (не Windows) или принтер не принял задание - печать через диалог печати.
//
// Параметры:
//  Пакет - Структура - см. ПакетыПечати.
//
&НаКлиенте
Процедура НапечататьПакет(Пакет)

	ТабличныйДокумент = Пакет.ТабличныйДокумент;
	ТабличныйДокумент.КоличествоЭкземпляров = Макс(Копий, 1);
	ИмяПринтера = Пакет.ПараметрыСтраницы.Принтер;

	Если ПринтерыКомпьютера <> Неопределено И ПринтерыКомпьютера.Получить(ИмяПринтера) <> Неопределено Тогда
		Попытка
			ТабличныйДокумент.ИмяПринтера = ИмяПринтера;
			// Параметры ставятся ещё раз уже при выбранном принтере: формат бумаги, которого платформа
			// не знает, драйвер этого принтера может принять по имени.
			ПрименитьПараметрыСтраницы(ТабличныйДокумент, Пакет.ПараметрыСтраницы);
			ТабличныйДокумент.Напечатать(РежимИспользованияДиалогаПечати.НеИспользовать);
			Возврат;
		Исключение
			// Принтер отключён или удалён: пользователь выберет другой в диалоге печати ниже.
			ТабличныйДокумент.ИмяПринтера = "";
		КонецПопытки;
	КонецЕсли;

	ТабличныйДокумент.Напечатать(РежимИспользованияДиалогаПечати.Использовать);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)

	ТабличныйДокумент = ОтмеченныеПечатныеФормы();
	Если ТабличныйДокумент = Неопределено Тогда
		СообщитьОбОтсутствииОтмеченных();
		Возврат;
	КонецЕсли;

	// Диалог выбора файла в веб-клиенте работает только через расширение, поэтому без него
	// продолжать нечем: в вопросе показывается «Отмена», а не «Продолжить без установки».
	Оповещение = Новый ОписаниеОповещения("СохранитьВФайлПослеПодключенияРасширения", ЭтотОбъект, ТабличныйДокумент);
	РасширениеРаботыС1СПредприятиемКлиент.Подключить(Оповещение,
		НСтр("ru = 'Для сохранения печатной формы в файл установите расширение для работы с 1С:Предприятием.';
			|fr = 'Pour enregistrer le formulaire imprimable dans un fichier, installez l''extension pour travailler avec 1C:Entreprise.';
			|en = 'To save the print form to a file, install the 1C:Enterprise extension.';
			|es = 'Para guardar el formulario de impresión en un archivo, instale la extensión para trabajar con 1C:Empresa.'"),
		Ложь);

КонецПроцедуры

// Продолжение команды СохранитьВФайл: без расширения диалог выбора файла недоступен.
//
// Параметры:
//  РасширениеПодключено - Булево - Истина, если расширение подключено или не требуется.
//  ТабличныйДокумент - ТабличныйДокумент - что сохранять.
//
&НаКлиенте
Процедура СохранитьВФайлПослеПодключенияРасширения(РасширениеПодключено, ТабличныйДокумент) Экспорт

	Если Не РасширениеПодключено Тогда
		Возврат;
	КонецЕсли;

	СохранитьТабличныйДокумент(ТабличныйДокумент);

КонецПроцедуры

// Сохраняет отмеченные печатные формы в файл, выбранный пользователем.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - что сохранять.
//
&НаКлиенте
Асинх Процедура СохранитьТабличныйДокумент(ТабличныйДокумент)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = НСтр("ru = 'Сохранить печатную форму'; fr = 'Enregistrer le formulaire imprimable';
		|en = 'Save the print form'; es = 'Guardar el formulario de impresión'");
	Диалог.Фильтр = НСтр("ru = 'Документ PDF (*.pdf)|*.pdf|Лист Excel (*.xlsx)|*.xlsx|Табличный документ (*.mxl)|*.mxl';
		|fr = 'Document PDF (*.pdf)|*.pdf|Feuille Excel (*.xlsx)|*.xlsx|Document tabulaire (*.mxl)|*.mxl';
		|en = 'PDF document (*.pdf)|*.pdf|Excel sheet (*.xlsx)|*.xlsx|Spreadsheet document (*.mxl)|*.mxl';
		|es = 'Documento PDF (*.pdf)|*.pdf|Hoja de Excel (*.xlsx)|*.xlsx|Documento tabular (*.mxl)|*.mxl'");
	Диалог.ПолноеИмяФайла = ИмяФайлаПоУмолчанию();

	ВыбранныеФайлы = Ждать Диалог.ВыбратьАсинх();
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Ждать ТабличныйДокумент.ЗаписатьАсинх(ВыбранныеФайлы[0], ТипФайлаПоРасширению(ВыбранныеФайлы[0]));

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьМакет(Команда)

	// Без текущей строки (таблицу ещё не активировали) правится показанная печатная форма.
	ТекущиеДанные = Элементы.НастройкиПечатныхФорм.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Строки = НастройкиПечатныхФорм.НайтиСтроки(Новый Структура("ИмяМакета", ИмяПоказанногоМакета));
		ТекущиеДанные = ?(Строки.Количество() = 0, Неопределено, Строки[0]);
	КонецЕсли;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.ПутьКМакету) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для этой печатной формы макет не задан, изменить его нельзя.';
			|fr = 'Aucun modèle n''est défini pour ce formulaire imprimable, il est impossible de le modifier.';
			|en = 'No template is set for this print form, it cannot be edited.';
			|es = 'No hay plantilla definida para este formulario de impresión, no se puede editarla.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("ПутьКМакету", ТекущиеДанные.ПутьКМакету);
	ОткрытьФорму("РегистрСведений.ПользовательскиеМакетыПечати.Форма.РедактированиеМакета",
		ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Показывает печатную форму: её параметры страницы - в панель, её страницы - в предпросмотр.
//
// Параметры:
//  ИмяМакета - Строка - имя макета печатной формы
//
&НаСервере
Процедура ПоказатьПечатнуюФорму(Знач ИмяМакета)

	Коллекция = ПолучитьИзВременногоХранилища(АдресКоллекции);
	ПечатнаяФорма = Коллекция.Найти(ИмяМакета, "ИмяМакета");
	Если ПечатнаяФорма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяПоказанногоМакета = ИмяМакета;
	ПараметрыСтраниц = ПолучитьИзВременногоХранилища(АдресПараметровСтраниц);
	ПараметрыСтраницы = ПараметрыСтраниц.Получить(ИмяМакета);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыСтраницы, ПоляПараметровСтраницы());
	// Пока пользователь не выбрал принтер для этой печатной формы, предлагается принтер по умолчанию.
	Если Не ПараметрыСтраницы.ПринтерВыбран И Не ЗначениеЗаполнено(Принтер) Тогда
		Принтер = ПринтерПоУмолчанию;
	КонецЕсли;

	ОбновитьДоступностьПолейСтраницы();
	ПостроитьПредпросмотр(ПечатнаяФорма.ТабличныйДокумент);

КонецПроцедуры

// Запоминает изменённый параметр страницы для показанной печатной формы - на время работы окна
// и в настройках пользователя - и строит предпросмотр заново.
//
// Параметры:
//  ИмяПоля - Строка - имя изменённого поля панели
//
&НаСервере
Процедура ИзменитьПараметрСтраницы(Знач ИмяПоля)

	Если Не ЗначениеЗаполнено(ИмяПоказанногоМакета) Тогда
		Возврат;
	КонецЕсли;
	Если ИмяПоля = "Бумага" Тогда
		ЗаполнитьРазмерыБумаги();
	КонецЕсли;

	ПараметрыСтраниц = ПолучитьИзВременногоХранилища(АдресПараметровСтраниц);
	ПараметрыСтраницы = ПараметрыСтраницыФормы();
	ИзмененПринтер = ИмяПоля = Элементы.Принтер.Имя;
	ПараметрыСтраницы.ПринтерВыбран = ИзмененПринтер
		Или ПараметрыСтраниц.Получить(ИмяПоказанногоМакета).ПринтерВыбран;
	ПараметрыСтраниц.Вставить(ИмяПоказанногоМакета, ПараметрыСтраницы);
	ПоместитьВоВременноеХранилище(ПараметрыСтраниц, АдресПараметровСтраниц);

	// Подставленный принтер по умолчанию не запоминается: сменят принтер по умолчанию в системе
	// или откроют окно на другом компьютере - печатная форма возьмёт тамошний принтер по умолчанию.
	Сохраняемые = Новый Структура(ПоляПараметровСтраницы());
	ЗаполнитьЗначенияСвойств(Сохраняемые, ПараметрыСтраницы);
	Если Не ПараметрыСтраницы.ПринтерВыбран Тогда
		Сохраняемые.Удалить("Принтер");
	КонецЕсли;
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючОбъектаНастроек(),
		КлючНастроекМакета(ИмяПоказанногоМакета), Сохраняемые);

	ОбновитьДоступностьПолейСтраницы();
	// Принтер на вид страниц не влияет: предпросмотр строится по параметрам, а не по драйверу.
	Если Не ИзмененПринтер Тогда
		Коллекция = ПолучитьИзВременногоХранилища(АдресКоллекции);
		ПечатнаяФорма = Коллекция.Найти(ИмяПоказанногоМакета, "ИмяМакета");
		Если ПечатнаяФорма <> Неопределено Тогда
			ПостроитьПредпросмотр(ПечатнаяФорма.ТабличныйДокумент);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Предпросмотр - печатная форма, записанная в PDF с параметрами страницы из панели: PDF разбит
// на страницы так же, как их разобьёт принтер, с той же бумагой, ориентацией, полями и масштабом.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - показываемая печатная форма
//
&НаСервере
Процедура ПостроитьПредпросмотр(Знач ТабличныйДокумент)

	Попытка
		ПрименитьПараметрыСтраницы(ТабличныйДокумент, ПараметрыСтраницыФормы());
		Поток = Новый ПотокВПамяти;
		ТабличныйДокумент.Записать(Поток, ТипФайлаТабличногоДокумента.PDF);
		Поток.Перейти(0, ПозицияВПотоке.Начало);
		ДокументPDF = Новый ДокументPDF;
		ДокументPDF.Прочитать(Поток);
		Предпросмотр = ДокументPDF;
	Исключение
		Предпросмотр = Новый ДокументPDF;
		ШаблонСообщения = НСтр("ru = 'Не удалось построить предпросмотр печатной формы: %1';
			|fr = 'Impossible de générer l''aperçu du formulaire imprimable : %1';
			|en = 'Could not build the print form preview: %1';
			|es = 'No se pudo generar la vista previa del formulario de impresión: %1'");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(ШаблонСообщения, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сообщение.Сообщить();
	КонецПопытки;

КонецПроцедуры

// Параметры страницы каждой печатной формы: заданные в макете, поверх них - сохранённые
// пользователем для этой печатной формы в прошлый раз.
//
// Параметры:
//  Коллекция - ТаблицаЗначений - коллекция печатных форм
//
&НаСервере
Процедура ЗаполнитьПараметрыСтраниц(Коллекция)

	ПараметрыСтраниц = Новый Соответствие;
	Для Каждого ПечатнаяФорма Из Коллекция Цикл
		ПараметрыСтраницы = ПараметрыСтраницыМакета(ПечатнаяФорма.ТабличныйДокумент);
		Сохраненные = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючОбъектаНастроек(),
			КлючНастроекМакета(ПечатнаяФорма.ИмяМакета));
		Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(ПараметрыСтраницы, Сохраненные);
			ПараметрыСтраницы.ПринтерВыбран = Сохраненные.Свойство("Принтер");
		КонецЕсли;
		ПараметрыСтраниц.Вставить(ПечатнаяФорма.ИмяМакета, ПараметрыСтраницы);
	КонецЦикла;

	АдресПараметровСтраниц = ПоместитьВоВременноеХранилище(ПараметрыСтраниц, УникальныйИдентификатор);

КонецПроцедуры

// Параметры страницы, заданные в самом табличном документе печатной формы.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - печатная форма
//
// Возвращаемое значение:
//  Структура - см. НовыеПараметрыСтраницы
//
&НаСервереБезКонтекста
Функция ПараметрыСтраницыМакета(ТабличныйДокумент)

	ПараметрыСтраницы = НовыеПараметрыСтраницы();
	ПараметрыСтраницы.Принтер = ТабличныйДокумент.ИмяПринтера;
	ПараметрыСтраницы.ШиринаБумаги = ТабличныйДокумент.ШиринаСтраницы;
	ПараметрыСтраницы.ВысотаБумаги = ТабличныйДокумент.ВысотаСтраницы;
	// Неопределено - произвольный размер страницы; у нового документа так же, но размер A4 -
	// поэтому имя формата подбирается по размеру.
	Если ЗначениеЗаполнено(ТабличныйДокумент.РазмерСтраницы) Тогда
		ПараметрыСтраницы.Бумага = ТабличныйДокумент.РазмерСтраницы;
	Иначе
		ПараметрыСтраницы.Бумага = ФорматБумагиПоРазмеру(ПараметрыСтраницы.ШиринаБумаги, ПараметрыСтраницы.ВысотаБумаги);
	КонецЕсли;
	ПараметрыСтраницы.Ориентация = ?(ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт,
		"Landscape", "Portrait");
	ПараметрыСтраницы.ПолеСлева = ТабличныйДокумент.ПолеСлева;
	ПараметрыСтраницы.ПолеСверху = ТабличныйДокумент.ПолеСверху;
	ПараметрыСтраницы.ПолеСправа = ТабличныйДокумент.ПолеСправа;
	ПараметрыСтраницы.ПолеСнизу = ТабличныйДокумент.ПолеСнизу;
	ПараметрыСтраницы.АвтоМасштаб = ТабличныйДокумент.АвтоМасштаб;
	Если ТипЗнч(ТабличныйДокумент.МасштабПечати) = Тип("Число") И ТабличныйДокумент.МасштабПечати > 0 Тогда
		ПараметрыСтраницы.МасштабПечати = ТабличныйДокумент.МасштабПечати;
	КонецЕсли;

	Возврат ПараметрыСтраницы;

КонецФункции

// Параметры страницы, показанные в панели.
//
// Возвращаемое значение:
//  Структура - см. НовыеПараметрыСтраницы
//
&НаСервере
Функция ПараметрыСтраницыФормы()

	ПараметрыСтраницы = НовыеПараметрыСтраницы();
	ЗаполнитьЗначенияСвойств(ПараметрыСтраницы, ЭтотОбъект, ПоляПараметровСтраницы());
	Возврат ПараметрыСтраницы;

КонецФункции

// Пустые параметры страницы: бумага A4, книжная ориентация, поля по 10 мм, масштаб 100 %.
//
// Возвращаемое значение:
//  Структура:
//   * Принтер       - Строка - имя принтера; пустая строка - выбор в диалоге печати
//   * Бумага        - Строка - имя формата бумаги; пустая строка - произвольный размер
//   * ШиринаБумаги  - Число  - ширина листа в книжной ориентации, мм
//   * ВысотаБумаги  - Число  - высота листа в книжной ориентации, мм
//   * Ориентация    - Строка - Portrait или Landscape
//   * ПолеСлева, ПолеСверху, ПолеСправа, ПолеСнизу - Число - поля, мм
//   * АвтоМасштаб   - Булево - вписать по ширине страницы
//   * МасштабПечати - Число  - масштаб, %, когда АвтоМасштаб выключен
//   * ПринтерВыбран - Булево - принтер выбран пользователем; иначе предлагается принтер по умолчанию
//
&НаКлиентеНаСервереБезКонтекста
Функция НовыеПараметрыСтраницы()

	ПараметрыСтраницы = Новый Структура(ПоляПараметровСтраницы());
	ПараметрыСтраницы.Вставить("ПринтерВыбран", Ложь);
	ПараметрыСтраницы.Принтер = "";
	ПараметрыСтраницы.Бумага = "A4";
	ПараметрыСтраницы.ШиринаБумаги = 210;
	ПараметрыСтраницы.ВысотаБумаги = 297;
	ПараметрыСтраницы.Ориентация = "Portrait";
	ПараметрыСтраницы.ПолеСлева = 10;
	ПараметрыСтраницы.ПолеСверху = 10;
	ПараметрыСтраницы.ПолеСправа = 10;
	ПараметрыСтраницы.ПолеСнизу = 10;
	ПараметрыСтраницы.АвтоМасштаб = Ложь;
	ПараметрыСтраницы.МасштабПечати = 100;
	Возврат ПараметрыСтраницы;

КонецФункции

// Имена параметров страницы - они же имена реквизитов и полей панели.
//
// Возвращаемое значение:
//  Строка - имена через запятую
//
&НаКлиентеНаСервереБезКонтекста
Функция ПоляПараметровСтраницы()

	Возврат "Принтер, Бумага, ШиринаБумаги, ВысотаБумаги, Ориентация, "
		+ "ПолеСлева, ПолеСверху, ПолеСправа, ПолеСнизу, АвтоМасштаб, МасштабПечати";

КонецФункции

// Ставит табличному документу параметры страницы. Формат бумаги, которого платформа не знает
// (свой формат драйвера принтера), заменяется произвольным размером из параметров.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - печатная форма
//  ПараметрыСтраницы - Структура - см. НовыеПараметрыСтраницы
//
&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьПараметрыСтраницы(ТабличныйДокумент, ПараметрыСтраницы)

	Если Не УстановитьФорматБумаги(ТабличныйДокумент, ПараметрыСтраницы.Бумага) Тогда
		ТабличныйДокумент.РазмерСтраницы = Неопределено;
		ТабличныйДокумент.ШиринаСтраницы = ?(ПараметрыСтраницы.ШиринаБумаги > 0, ПараметрыСтраницы.ШиринаБумаги, 210);
		ТабличныйДокумент.ВысотаСтраницы = ?(ПараметрыСтраницы.ВысотаБумаги > 0, ПараметрыСтраницы.ВысотаБумаги, 297);
	КонецЕсли;
	ТабличныйДокумент.ОриентацияСтраницы = ?(ПараметрыСтраницы.Ориентация = "Landscape",
		ОриентацияСтраницы.Ландшафт, ОриентацияСтраницы.Портрет);
	ТабличныйДокумент.ПолеСлева = ПараметрыСтраницы.ПолеСлева;
	ТабличныйДокумент.ПолеСверху = ПараметрыСтраницы.ПолеСверху;
	ТабличныйДокумент.ПолеСправа = ПараметрыСтраницы.ПолеСправа;
	ТабличныйДокумент.ПолеСнизу = ПараметрыСтраницы.ПолеСнизу;
	ТабличныйДокумент.АвтоМасштаб = ПараметрыСтраницы.АвтоМасштаб;
	Если Не ПараметрыСтраницы.АвтоМасштаб Тогда
		ТабличныйДокумент.МасштабПечати = ?(ПараметрыСтраницы.МасштабПечати > 0, ПараметрыСтраницы.МасштабПечати, 100);
	КонецЕсли;

КонецПроцедуры

// Ставит табличному документу формат бумаги по имени. Неизвестное имя платформа отвергает
// исключением (проверено на 8.5.1), поэтому знает ли она формат, выясняется только попыткой.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - печатная форма
//  Бумага - Строка - имя формата бумаги
//
// Возвращаемое значение:
//  Булево - Истина, если формат известен и поставлен
//
&НаКлиентеНаСервереБезКонтекста
Функция УстановитьФорматБумаги(ТабличныйДокумент, Бумага)

	Если Не ЗначениеЗаполнено(Бумага) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ТабличныйДокумент.РазмерСтраницы = Бумага;
	Исключение
		// Формат драйвера принтера, которого платформа не знает: печатается произвольным размером.
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Размер листа выбранного формата бумаги - в поля «Ширина» и «Высота». Формат, которого
// платформа не знает, разбирается по имени («62 x 29 mm», «4 x 6 in»); не разобрался -
// размер остаётся прежним, и пользователь задаёт его сам.
//
&НаСервере
Процедура ЗаполнитьРазмерыБумаги()

	ТабличныйДокумент = Новый ТабличныйДокумент;
	Если УстановитьФорматБумаги(ТабличныйДокумент, Бумага) Тогда
		ШиринаБумаги = ТабличныйДокумент.ШиринаСтраницы;
		ВысотаБумаги = ТабличныйДокумент.ВысотаСтраницы;
		Возврат;
	КонецЕсли;

	Размер = РазмерБумагиИзИмени(Бумага);
	Если Размер <> Неопределено Тогда
		ШиринаБумаги = Размер.Ширина;
		ВысотаБумаги = Размер.Высота;
	КонецЕсли;

КонецПроцедуры

// Ширину и высоту листа можно править только у произвольного размера и у формата, которого
// платформа не знает: у известного формата размер задан самим форматом. Масштаб в процентах
// не действует, пока включено «Вписать по ширине».
//
&НаСервере
Процедура ОбновитьДоступностьПолейСтраницы()

	ИзвестныйФормат = УстановитьФорматБумаги(Новый ТабличныйДокумент, Бумага);
	Элементы.ШиринаБумаги.ТолькоПросмотр = ИзвестныйФормат;
	Элементы.ВысотаБумаги.ТолькоПросмотр = ИзвестныйФормат;
	Элементы.МасштабПечати.Доступность = Не АвтоМасштаб;

КонецПроцедуры

// Имя стандартного формата бумаги с указанным размером листа.
//
// Параметры:
//  Ширина - Число - ширина листа, мм
//  Высота - Число - высота листа, мм
//
// Возвращаемое значение:
//  Строка - имя формата; пустая строка - произвольный размер
//
&НаСервереБезКонтекста
Функция ФорматБумагиПоРазмеру(Ширина, Высота)

	ТабличныйДокумент = Новый ТабличныйДокумент;
	Для Каждого Формат Из СтандартныеФорматыБумаги() Цикл
		Если Не УстановитьФорматБумаги(ТабличныйДокумент, Формат) Тогда
			Продолжить;
		КонецЕсли;
		Если Окр(ТабличныйДокумент.ШиринаСтраницы) = Окр(Ширина) И Окр(ТабличныйДокумент.ВысотаСтраницы) = Окр(Высота) Тогда
			Возврат Формат;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Размер листа из имени формата бумаги драйвера: «62 x 29 mm», «100x150мм», «4" x 6"», «4 x 6 in».
// Без единиц размер считается в миллиметрах.
//
// Параметры:
//  Бумага - Строка - имя формата бумаги
//
// Возвращаемое значение:
//  Структура, Неопределено - Ширина и Высота в мм; Неопределено, если размер в имени не найден
//
&НаСервереБезКонтекста
Функция РазмерБумагиИзИмени(Знач Бумага)

	Бумага = НРег(Бумага);
	Для Каждого Разделитель Из СтрРазделить("×,х,*", ",") Цикл
		Бумага = СтрЗаменить(Бумага, Разделитель, "x");
	КонецЦикла;
	Бумага = СтрЗаменить(Бумага, ",", ".");

	// Ровно две части: ширина и высота.
	Части = СтрРазделить(Бумага, "x", Ложь);
	ЧастейРазмера = 2;
	Если Части.Количество() <> ЧастейРазмера Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ширина = ЧислоИзСтроки(Части[0], Истина);
	Высота = ЧислоИзСтроки(Части[1], Ложь);
	Если Ширина = 0 Или Высота = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Миллиметры проверяются первыми: «in» встречается и внутри слов имени формата.
	ВМиллиметрах = СтрНайти(Бумага, "mm") > 0 Или СтрНайти(Бумага, "мм") > 0;
	Если Не ВМиллиметрах И (СтрНайти(Бумага, "cm") > 0 Или СтрНайти(Бумага, "см") > 0) Тогда
		Множитель = 10;
	ИначеЕсли Не ВМиллиметрах И ВДюймах(Бумага) Тогда
		Множитель = 25.4;
	Иначе
		Множитель = 1;
	КонецЕсли;

	Возврат Новый Структура("Ширина, Высота", Окр(Ширина * Множитель, 1), Окр(Высота * Множитель, 1));

КонецФункции

// Размер в имени формата задан в дюймах: кавычка дюйма, «inch» или «in» сразу после числа.
// Просто «in» искать нельзя: оно есть в словах вроде «printing» и «continuous».
//
// Параметры:
//  Бумага - Строка - имя формата в нижнем регистре
//
// Возвращаемое значение:
//  Булево - Истина, если размер в дюймах
//
&НаСервереБезКонтекста
Функция ВДюймах(Бумага)

	Если СтрНайти(Бумага, """") > 0 Или СтрНайти(Бумага, "inch") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Цифра = 0 По 9 Цикл
		Если СтрНайти(Бумага, Формат(Цифра, "ЧН=0") + "in") > 0 Или СтрНайти(Бумага, Формат(Цифра, "ЧН=0") + " in") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Число в начале или в конце строки: «(62» -> 62 с конца, «29 mm)» -> 29 с начала.
//
// Параметры:
//  Текст - Строка - часть имени формата
//  СКонца - Булево - число стоит в конце строки, а не в начале
//
// Возвращаемое значение:
//  Число - найденное число; 0, если числа нет
//
&НаСервереБезКонтекста
Функция ЧислоИзСтроки(Знач Текст, СКонца)

	Текст = СокрЛП(Текст);
	Цифры = "";
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Символ = Сред(Текст, ?(СКонца, Длина - Номер + 1, Номер), 1);
		Если СтрНайти("0123456789.", Символ) = 0 Тогда
			Если ЗначениеЗаполнено(Цифры) Тогда
				Прервать;
			КонецЕсли;
			// Пробелы, кавычка дюйма и единицы между числом и краем строки пропускаются.
			Продолжить;
		КонецЕсли;
		Цифры = ?(СКонца, Символ + Цифры, Цифры + Символ);
	КонецЦикла;

	// Приведение строки к числу зависит от локали сеанса («4.00» в испанской даёт 400),
	// поэтому целая и дробная части приводятся порознь, как строки из одних цифр.
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	ОснованиеСистемы = 10;
	ЧастиЧисла = СтрРазделить(Цифры, ".");
	Результат = ОписаниеЧисла.ПривестиЗначение(ЧастиЧисла[0]);
	Если ЧастиЧисла.Количество() > 1 И ЗначениеЗаполнено(ЧастиЧисла[1]) Тогда
		Результат = Результат + ОписаниеЧисла.ПривестиЗначение(ЧастиЧисла[1]) / Pow(ОснованиеСистемы, СтрДлина(ЧастиЧисла[1]));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Форматы бумаги, которые предлагаются, когда список форматов принтера неизвестен.
//
// Возвращаемое значение:
//  Массив из Строка - имена форматов, которые знает платформа
//
&НаКлиентеНаСервереБезКонтекста
Функция СтандартныеФорматыБумаги()

	Возврат СтрРазделить("A4,A5,A6,A3,B5,Letter,Legal,Executive,Envelope DL,Envelope C5", ",");

КонецФункции

// Ключ объекта настроек окна печати в хранилище общих настроек.
//
// Возвращаемое значение:
//  Строка - ключ объекта
//
&НаСервереБезКонтекста
Функция КлючОбъектаНастроек()

	Возврат "ОбщаяФорма.ПечатьДокументов.ПараметрыСтраницы";

КонецФункции

// Ключ настроек печатной формы: имя макета уникально только внутри своего менеджера печати.
//
// Параметры:
//  ИмяМакета - Строка - имя макета печатной формы
//
// Возвращаемое значение:
//  Строка - ключ настроек
//
&НаСервере
Функция КлючНастроекМакета(ИмяМакета)

	Возврат ИмяМенеджераПечати + "/" + ИмяМакета;

КонецФункции

// Ориентация - тумблер из двух положений; подписи на всех языках задаются здесь, а не в форме.
//
&НаСервере
Процедура ЗаполнитьСписокОриентации()

	СписокОриентаций = Элементы.Ориентация.СписокВыбора;
	СписокОриентаций.Добавить("Portrait", НСтр("ru = 'Книжная'; fr = 'Portrait'; en = 'Portrait'; es = 'Vertical'"));
	СписокОриентаций.Добавить("Landscape", НСтр("ru = 'Альбомная'; fr = 'Paysage'; en = 'Landscape'; es = 'Horizontal'"));

КонецПроцедуры

// Принтеры компьютера пользователя - в список выбора поля «Принтер». Поле показывается,
// только если список получен (Windows).
//
&НаКлиенте
Процедура ЗагрузитьПринтерыКомпьютера()

	Сведения = ПечатныеФормыКлиент.ПринтерыКомпьютера();
	Если Сведения.Принтеры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПринтерыКомпьютера = Сведения.Принтеры;
	СписокПринтеров = Элементы.Принтер.СписокВыбора;
	СписокПринтеров.Очистить();
	СписокПринтеров.Добавить("", НСтр("ru = 'Выбрать при печати'; fr = 'Choisir à l''impression';
		|en = 'Choose when printing'; es = 'Elegir al imprimir'"));
	Для Каждого Элемент Из ПринтерыКомпьютера Цикл
		СписокПринтеров.Добавить(Элемент.Ключ);
	КонецЦикла;
	СписокПринтеров.СортироватьПоЗначению();
	Элементы.Принтер.Видимость = Истина;

	Если ЗначениеЗаполнено(Сведения.ПоУмолчанию) Тогда
		УстановитьПринтерПоУмолчанию(Сведения.ПоУмолчанию);
	КонецЕсли;
	ЗаполнитьСписокБумаги();

КонецПроцедуры

// Запоминает принтер по умолчанию и предлагает его показанной печатной форме, если для неё
// пользователь принтер ещё не выбирал.
//
// Параметры:
//  ИмяПринтера - Строка - принтер по умолчанию
//
&НаСервере
Процедура УстановитьПринтерПоУмолчанию(Знач ИмяПринтера)

	ПринтерПоУмолчанию = ИмяПринтера;
	ПараметрыСтраниц = ПолучитьИзВременногоХранилища(АдресПараметровСтраниц);
	ПараметрыСтраницы = ПараметрыСтраниц.Получить(ИмяПоказанногоМакета);
	Если ПараметрыСтраницы <> Неопределено И Не ПараметрыСтраницы.ПринтерВыбран И Не ЗначениеЗаполнено(Принтер) Тогда
		Принтер = ИмяПринтера;
	КонецЕсли;

КонецПроцедуры

// Форматы бумаги выбранного принтера - в список выбора поля «Бумага»; формат принтера неизвестен
// (принтер не выбран, не Windows) - стандартные форматы. Последний пункт - произвольный размер.
//
&НаКлиенте
Процедура ЗаполнитьСписокБумаги()

	Форматы = Неопределено;
	Если ПринтерыКомпьютера <> Неопределено И ЗначениеЗаполнено(Принтер) Тогда
		Форматы = ПринтерыКомпьютера.Получить(Принтер);
	КонецЕсли;
	Если Форматы = Неопределено Или Форматы.Количество() = 0 Тогда
		Форматы = СтандартныеФорматыБумаги();
	КонецЕсли;

	СписокФорматов = Элементы.Бумага.СписокВыбора;
	СписокФорматов.Очистить();
	Для Каждого Формат Из Форматы Цикл
		СписокФорматов.Добавить(Формат);
	КонецЦикла;
	// Формат из настроек или макета, которого нет у этого принтера, остаётся видимым и выбранным.
	Если ЗначениеЗаполнено(Бумага) И СписокФорматов.НайтиПоЗначению(Бумага) = Неопределено Тогда
		СписокФорматов.Вставить(0, Бумага);
	КонецЕсли;
	СписокФорматов.Добавить("", НСтр("ru = 'Свой размер'; fr = 'Format personnalisé'; en = 'Custom size';
		|es = 'Tamaño personalizado'"));

КонецПроцедуры

// Отмеченные печатные формы, собранные в пакеты для печати. Подряд идущие печатные формы
// с одинаковыми параметрами страницы печатаются одним заданием, иначе каждая - своим:
// у этикетки и счёта разные бумага и принтер.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * ТабличныйДокумент - ТабличныйДокумент - печатные формы пакета
//   * ПараметрыСтраницы - Структура - см. НовыеПараметрыСтраницы
//
&НаСервере
Функция ПакетыПечати()

	Коллекция = ПолучитьИзВременногоХранилища(АдресКоллекции);
	ПараметрыСтраниц = ПолучитьИзВременногоХранилища(АдресПараметровСтраниц);

	Пакеты = Новый Массив;
	Пакет = Неопределено;
	КлючПакета = Неопределено;
	Для Каждого Строка Из НастройкиПечатныхФорм Цикл
		Если Не Строка.Печатать Тогда
			Продолжить;
		КонецЕсли;
		ПечатнаяФорма = Коллекция.Найти(Строка.ИмяМакета, "ИмяМакета");
		Если ПечатнаяФорма = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПараметрыСтраницы = ПараметрыСтраниц.Получить(Строка.ИмяМакета);
		Если Не ПараметрыСтраницы.ПринтерВыбран И Не ЗначениеЗаполнено(ПараметрыСтраницы.Принтер) Тогда
			ПараметрыСтраницы.Принтер = ПринтерПоУмолчанию;
		КонецЕсли;
		Ключ = КлючПараметровСтраницы(ПараметрыСтраницы);

		Если Пакет = Неопределено Или Ключ <> КлючПакета Тогда
			Пакет = Новый Структура("ТабличныйДокумент, ПараметрыСтраницы", Новый ТабличныйДокумент, ПараметрыСтраницы);
			Пакеты.Добавить(Пакет);
			КлючПакета = Ключ;
		Иначе
			Пакет.ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		Пакет.ТабличныйДокумент.Вывести(ПечатнаяФорма.ТабличныйДокумент);
	КонецЦикла;

	Для Каждого Пакет Из Пакеты Цикл
		ПрименитьПараметрыСтраницы(Пакет.ТабличныйДокумент, Пакет.ПараметрыСтраницы);
	КонецЦикла;

	Возврат Пакеты;

КонецФункции

// Строка для сравнения параметров страницы двух печатных форм.
//
// Параметры:
//  ПараметрыСтраницы - Структура - см. НовыеПараметрыСтраницы
//
// Возвращаемое значение:
//  Строка - значения параметров через разделитель
//
&НаСервереБезКонтекста
Функция КлючПараметровСтраницы(ПараметрыСтраницы)

	Значения = Новый Массив;
	Для Каждого Поле Из СтрРазделить(ПоляПараметровСтраницы(), ",") Цикл
		Значения.Добавить(Строка(ПараметрыСтраницы[СокрЛП(Поле)]));
	КонецЦикла;
	Возврат СтрСоединить(Значения, "|");

КонецФункции

// Формирует печатные формы заново на выбранном языке. Отметки «Печатать» сохраняются.
// Если формирование не удалось (документ изменён или удалён), остаются прежние печатные формы
// и прежний язык.
//
// Параметры:
//  ТекущийМакет - Строка - имя макета, который показать после формирования
//
&НаСервере
Процедура СформироватьНаВыбранномЯзыке(Знач ТекущийМакет)

	ЧтоПечатать = ПолучитьИзВременногоХранилища(АдресЧтоПечатать);
	КодЯзыкаСеанса = ?(ТипЗнч(ТекущийЯзык()) = Тип("Строка"), ТекущийЯзык(), ТекущийЯзык().КодЯзыка);

	Попытка
		Результат = ПечатныеФормы.СформироватьПечатныеФормы(ИмяМенеджераПечати, ЧтоПечатать.ИменаМакетов,
			ЧтоПечатать.ОбъектыПечати, ЧтоПечатать.ПараметрыПечати,
			?(ЯзыкПечати = КодЯзыкаСеанса, "", ЯзыкПечати));
	Исключение
		ЯзыкПечати = ЯзыкСформированныхФорм;
		ШаблонСообщения = НСтр("ru = 'Не удалось сформировать печатную форму на выбранном языке, показана прежняя: %1';
			|fr = 'Impossible de générer le formulaire imprimable dans la langue choisie, l''ancien reste affiché : %1';
			|en = 'Could not generate the print form in the selected language, the previous one is shown: %1';
			|es = 'No se pudo generar el formulario de impresión en el idioma elegido, se muestra el anterior: %1'");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(ШаблонСообщения, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;

	ПоместитьВоВременноеХранилище(Результат.КоллекцияПечатныхФорм, АдресКоллекции);
	ЯзыкСформированныхФорм = ЯзыкПечати;
	Если ЗначениеЗаполнено(Результат.ПараметрыВывода.ЗаголовокФормы) Тогда
		Заголовок = Результат.ПараметрыВывода.ЗаголовокФормы;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийМакет) И НастройкиПечатныхФорм.Количество() > 0 Тогда
		ТекущийМакет = НастройкиПечатныхФорм[0].ИмяМакета;
	КонецЕсли;
	ПоказатьПечатнуюФорму(ТекущийМакет);

КонецПроцедуры

// Заполняет тумблер языка языками конфигурации; по умолчанию выбран язык сеанса.
// При единственном языке выбирать нечего, и поле скрывается.
//
&НаСервере
Процедура ЗаполнитьЯзыкиПечати()

	// ТекущийЯзык() в части контекстов возвращает строку, в остальных - объект метаданных.
	ЯзыкПечати = ?(ТипЗнч(ТекущийЯзык()) = Тип("Строка"), ТекущийЯзык(), ТекущийЯзык().КодЯзыка);
	ЯзыкСформированныхФорм = ЯзыкПечати;

	СписокЯзыков = Элементы.ЯзыкПечати.СписокВыбора;
	Для Каждого Язык Из Метаданные.Языки Цикл
		// Код вместо названия: тумблер в левой панели узкий, а код одинаково читается на любом языке.
		СписокЯзыков.Добавить(Язык.КодЯзыка, ВРег(Язык.КодЯзыка));
	КонецЦикла;

	Элементы.ЯзыкПечати.Видимость = СписокЯзыков.Количество() > 1;

КонецПроцедуры

// Собирает отмеченные печатные формы в один табличный документ. Файл один, поэтому параметры
// страницы у него - первой отмеченной печатной формы.
//
// Возвращаемое значение:
//  ТабличныйДокумент, Неопределено - документ или Неопределено, если ничего не отмечено
//
&НаСервере
Функция ОтмеченныеПечатныеФормы()

	Коллекция = ПолучитьИзВременногоХранилища(АдресКоллекции);
	ПараметрыСтраниц = ПолучитьИзВременногоХранилища(АдресПараметровСтраниц);

	Результат = Новый ТабличныйДокумент;
	ПараметрыФайла = Неопределено;
	ЕстьВывод = Ложь;
	Для Каждого Строка Из НастройкиПечатныхФорм Цикл
		Если Не Строка.Печатать Тогда
			Продолжить;
		КонецЕсли;
		ПечатнаяФорма = Коллекция.Найти(Строка.ИмяМакета, "ИмяМакета");
		Если ПечатнаяФорма = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьВывод Тогда
			Результат.ВывестиГоризонтальныйРазделительСтраниц();
		Иначе
			ПараметрыФайла = ПараметрыСтраниц.Получить(Строка.ИмяМакета);
		КонецЕсли;
		Результат.Вывести(ПечатнаяФорма.ТабличныйДокумент);
		ЕстьВывод = Истина;
	КонецЦикла;

	Если Не ЕстьВывод Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПрименитьПараметрыСтраницы(Результат, ПараметрыФайла);

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура СообщитьОбОтсутствииОтмеченных()

	ПоказатьПредупреждение(, НСтр("ru = 'Отметьте хотя бы одну печатную форму.';
		|fr = 'Cochez au moins un formulaire imprimable.';
		|en = 'Select at least one print form.';
		|es = 'Marque al menos un formulario de impresión.'"));

КонецПроцедуры

// Имя файла по умолчанию при сохранении: название первой отмеченной печатной формы.
//
// Возвращаемое значение:
//  Строка - имя файла с расширением
//
&НаКлиенте
Функция ИмяФайлаПоУмолчанию()

	Для Каждого Строка Из НастройкиПечатныхФорм Цикл
		Если Строка.Печатать Тогда
			Возврат ?(ЗначениеЗаполнено(Строка.ИмяФайла), Строка.ИмяФайла, Строка.Представление) + ".pdf";
		КонецЕсли;
	КонецЦикла;

	Возврат НСтр("ru = 'Печатная форма'; fr = 'Formulaire imprimable'; en = 'Print form';
		|es = 'Formulario de impresión'") + ".pdf";

КонецФункции

// Тип файла табличного документа по расширению выбранного файла.
//
// Параметры:
//  ИмяФайла - Строка - полное имя файла
//
// Возвращаемое значение:
//  ТипФайлаТабличногоДокумента - тип для записи
//
&НаКлиентеНаСервереБезКонтекста
Функция ТипФайлаПоРасширению(ИмяФайла)

	ИмяВНижнемРегистре = НРег(ИмяФайла);
	Если СтрЗаканчиваетсяНа(ИмяВНижнемРегистре, ".xlsx") Тогда
		Возврат ТипФайлаТабличногоДокумента.XLSX;
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(ИмяВНижнемРегистре, ".mxl") Тогда
		Возврат ТипФайлаТабличногоДокумента.MXL;
	КонецЕсли;

	Возврат ТипФайлаТабличногоДокумента.PDF;

КонецФункции

#КонецОбласти
