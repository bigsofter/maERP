  
#Область Обработчики_событий_формы
   
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтоЧекККМ = Истина;
	НеприменениеККТ = Ложь;
	ДатаКоррекции = ТекущаяДатаСеанса();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимостьЭлементов();
КонецПроцедуры

#КонецОбласти

#Область Обработчики_элементов_формы

&НаКлиенте
Процедура ЭтоЧекККМПриИзменении(Элемент)
	УстановитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧек(Команда)
	Закрыть(СформироватьДанныеЧека(Ложь));
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьВОчередьЧеков(Команда)
	Закрыть(СформироватьДанныеЧека(Истина));
КонецПроцедуры

#КонецОбласти

#Область Дополнительно

&НаКлиенте
Функция СформироватьДанныеЧека(ПоместитьВОчередьЧеков)
	Результат = Новый Структура;
	Результат.Вставить("ПоместитьВОчередьЧеков", ПоместитьВОчередьЧеков);
	Результат.Вставить("ЭтоЧекКоррекции", Не ЭтоЧекККМ);
	Результат.Вставить("ЭтоОчередьЧеков", Ложь);
	Результат.Вставить("НеприменениеККТ", НеприменениеККТ);
	Результат.Вставить("ТипКоррекции", ТипКоррекции);
	Результат.Вставить("ОписаниеКоррекции", ОписаниеКоррекции);
	Результат.Вставить("ДатаКоррекции", ДатаКоррекции);
	Результат.Вставить("НомерПредписания", НомерПредписания);
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	Элементы.ГруппаПараметрыКоррекции.Видимость = Не ЭтоЧекККМ;		
КонецПроцедуры

#КонецОбласти




