
#Область Обработчики_элементов_формы

&НаКлиенте
Процедура РезультатПриАктивизации(Элемент)
	ПодключитьОбработчикОжидания("РассчитатьПоказателиДинамически", 0.2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВычислитьВыделенные(Команда)
	РассчитатьПоказателиДинамически();
КонецПроцедуры

// Добавляет отчёт с текущими вариантом и настройками на панель избранных отчётов в «Главном».
//
// Параметры:
//  Команда - КомандаФормы - команда «В избранное».
//
&НаКлиенте
Процедура ВИзбранное(Команда)
	Наименование = ДобавитьВИзбранноеНаСервере();
	Оповестить("ИзбранныеОтчеты.Изменены");
	ПоказатьОповещениеПользователя(НСтр("ru = 'Добавлено в избранное'; fr = 'Ajouté aux favoris'; en = 'Added to favourites';
		|es = 'Añadido a favoritos'"), , Наименование);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Открытие из панели избранного: полные настройки избранного загружаются один раз - при первой
// загрузке варианта. Последующий выбор варианта пользователем избранным не подменяется.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных - загружаемые настройки варианта.
//
&НаСервере
Процедура ПриЗагрузкеВариантаНаСервере(Настройки)
	Если ИзбранноеПрименено Или ПустаяСтрока(Параметры.ИдентификаторИзбранного) Тогда
		Возврат;
	КонецЕсли;
	ИзбранноеПрименено = Истина;
	// BSLLS:PrivilegedModuleMethodCall-off - запись избранного только своего пользователя ИБ.
	Данные = ИзбранныеОтчетыПолныеПрава.ДанныеИзбранного(Параметры.ИдентификаторИзбранного);
	// BSLLS:PrivilegedModuleMethodCall-on
	Если Данные = Неопределено Или Данные.ПолноеИмяОтчета <> ПолноеИмяОтчета()
		Или ТипЗнч(Данные.Настройки) <> Тип("НастройкиКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Данные.Настройки);
КонецПроцедуры

#КонецОбласти

#Область Дополнительно

&НаКлиенте
Процедура РассчитатьПоказателиДинамически()
	ТекущаяКоманда = ""; //сумма, среднее, макс, мин...
	ОбщегоНазначенияКлиентСервер.РассчитатьПоказатели(ЭтотОбъект, "Результат", "ФормаВычислитьВыделенные", ТекущаяКоманда, 2);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ДобавитьВИзбранноеНаСервере()
	Наименование = Заголовок;
	Если Не ПустаяСтрока(ПредставлениеТекущегоВарианта) И СтрНайти(Наименование, ПредставлениеТекущегоВарианта) = 0 Тогда
		Наименование = Наименование + ": " + ПредставлениеТекущегоВарианта;
	КонецЕсли;
	// BSLLS:PrivilegedModuleMethodCall-off - добавление в избранное своего пользователя ИБ.
	ИзбранныеОтчетыПолныеПрава.Добавить(ПолноеИмяОтчета(), КлючТекущегоВарианта, Наименование,
		Отчет.КомпоновщикНастроек.Настройки, Отчет.КомпоновщикНастроек.ПользовательскиеНастройки);
	// BSLLS:PrivilegedModuleMethodCall-on
	Возврат Наименование;
КонецФункции

&НаСервере
Функция ПолноеИмяОтчета()
	Возврат РеквизитФормыВЗначение("Отчет").Метаданные().ПолноеИмя();
КонецФункции

#КонецОбласти
