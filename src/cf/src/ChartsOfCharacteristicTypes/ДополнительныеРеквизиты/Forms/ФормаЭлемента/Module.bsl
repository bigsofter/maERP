
// Форма дополнительного реквизита: тип значения выбирается из списка, разрядность числа ограничена
// типом самого плана видов характеристик (Число 15.3: до 12 цифр до запятой). Штатный диалог типа
// пропускал большую длину и падал с «Длина целой части числа превышает максимально возможную».
// Значения списка выбора ВидТипа у строки, числа, даты и булева совпадают с именами типов платформы.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПрочитатьТип(Объект.ТипЗначения);
	НастроитьЭлементыТипа(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ПустаяСтрока(ВидТипа) Тогда
		// Составной тип, заведённый раньше: не трогаем.
		Возврат;
	КонецЕсли;

	ТекстОшибки = ОшибкаРазрядности(ВидТипа, ДлинаЧисла, ТочностьЧисла, ДлинаСтроки);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ТекущийОбъект.ТипЗначения = СобранныйТип();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидТипаПриИзменении(Элемент)

	НастроитьЭлементыТипа(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура РазрядностьПриИзменении(Элемент)

	ВыровнятьРазрядность(ЭтотОбъект, Элемент.Имя = "ТочностьЧисла");

КонецПроцедуры

&НаКлиенте
Процедура ДлинаСтрокиПриИзменении(Элемент)

	ДлинаСтроки = Мин(Макс(ДлинаСтроки, 1), МаксимумДлиныСтроки());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьТип(ТипЗначения)

	ДлинаЧисла = 10;
	ТочностьЧисла = 2;
	Неотрицательное = Ложь;
	ДлинаСтроки = 100;
	ВидТипа = ВидСтрока();

	Типы = ТипЗначения.Типы();
	Если Типы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВидТипа = "";
	Если Типы.Количество() > 1 Тогда
		Шаблон = НСтр("ru = 'Составной тип: %1. Выберите один тип, чтобы его заменить.';
			|fr = 'Type composite : %1. Choisissez un seul type pour le remplacer.';
			|en = 'Composite type: %1. Choose a single type to replace it.';
			|es = 'Tipo compuesto: %1. Elija un solo tipo para reemplazarlo.'");
		Элементы.СоставнойТип.Заголовок = СтрШаблон(Шаблон, Строка(ТипЗначения));
		Возврат;
	КонецЕсли;

	Тип = Типы[0];
	Если Тип = Тип(ВидСтрока()) Тогда
		ВидТипа = ВидСтрока();
		Если ТипЗначения.КвалификаторыСтроки.Длина > 0 Тогда
			ДлинаСтроки = Мин(ТипЗначения.КвалификаторыСтроки.Длина, МаксимумДлиныСтроки());
		КонецЕсли;
	ИначеЕсли Тип = Тип(ВидЧисло()) Тогда
		ВидТипа = ВидЧисло();
		Квалификаторы = ТипЗначения.КвалификаторыЧисла;
		Если Квалификаторы.Разрядность > 0 Тогда
			ДлинаЧисла = Квалификаторы.Разрядность;
			ТочностьЧисла = Квалификаторы.РазрядностьДробнойЧасти;
		КонецЕсли;
		Неотрицательное = (Квалификаторы.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный);
		ВыровнятьРазрядность(ЭтотОбъект, Истина);
	Иначе
		Для Каждого ПрочийВид Из ПрочиеТипы() Цикл
			Если ПрочийВид.Значение.СодержитТип(Тип) Тогда
				ВидТипа = ПрочийВид.Ключ;
				Возврат;
			КонецЕсли;
		КонецЦикла;
		Элементы.СоставнойТип.Заголовок = Строка(ТипЗначения);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СобранныйТип()

	Если ВидТипа = ВидСтрока() Тогда
		Квалификаторы = Новый КвалификаторыСтроки(ДлинаСтроки, ДопустимаяДлина.Переменная);
		Результат = Новый ОписаниеТипов(ВидСтрока(), , Квалификаторы);
	ИначеЕсли ВидТипа = ВидЧисло() Тогда
		Знак = ?(Неотрицательное, ДопустимыйЗнак.Неотрицательный, ДопустимыйЗнак.Любой);
		Результат = Новый ОписаниеТипов(ВидЧисло(), Новый КвалификаторыЧисла(ДлинаЧисла, ТочностьЧисла, Знак));
	Иначе
		Результат = ПрочиеТипы()[ВидТипа];
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПрочиеТипы()

	Типы = Новый Соответствие;
	Типы.Вставить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Типы.Вставить("Булево", Новый ОписаниеТипов("Булево"));
	Типы.Вставить("Значение", Новый ОписаниеТипов("СправочникСсылка.ЗначенияДополнительныхРеквизитов"));
	Типы.Вставить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Типы.Вставить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Возврат Типы;

КонецФункции

// Проверка разрядности перед записью; пределы - тип значения плана видов характеристик.
//
// Параметры:
//  ВидТипа       - Строка - значение из списка выбора поля ВидТипа
//  ДлинаЧисла    - Число - всего цифр числа
//  ТочностьЧисла - Число - цифр после запятой
//  ДлинаСтроки   - Число - длина строки
//
// Возвращаемое значение:
//  Строка - текст ошибки или пустая строка
//
&НаКлиентеНаСервереБезКонтекста
Функция ОшибкаРазрядности(ВидТипа, ДлинаЧисла, ТочностьЧисла, ДлинаСтроки)

	ТекстОшибки = "";
	Если ВидТипа = ВидЧисло() Тогда
		ДлинаВнеПределов = ДлинаЧисла < 1 Или ДлинаЧисла > МаксимумЦифр();
		ТочностьВнеПределов = ТочностьЧисла > МаксимумДробных() Или ТочностьЧисла > ДлинаЧисла;
		ЦелаяЧастьВнеПределов = ДлинаЧисла - ТочностьЧисла > МаксимумЦифр() - МаксимумДробных();
		Если ДлинаВнеПределов Или ТочностьВнеПределов Или ЦелаяЧастьВнеПределов Тогда
			ТекстОшибки = НСтр("ru = 'Число: до запятой не больше 12 цифр, после запятой не больше 3.';
				|fr = 'Nombre : au plus 12 chiffres avant la virgule et 3 après.';
				|en = 'Number: up to 12 digits before the decimal point and 3 after.';
				|es = 'Número: hasta 12 dígitos antes de la coma y 3 después.'");
		КонецЕсли;
	ИначеЕсли ВидТипа = ВидСтрока() Тогда
		Если ДлинаСтроки < 1 Или ДлинаСтроки > МаксимумДлиныСтроки() Тогда
			ТекстОшибки = НСтр("ru = 'Длина текста: от 1 до 200 символов.';
				|fr = 'Longueur du texte : de 1 à 200 caractères.';
				|en = 'Text length: from 1 to 200 characters.';
				|es = 'Longitud del texto: de 1 a 200 caracteres.'");
		КонецЕсли;
	Иначе
		// Ссылочные типы, дата и булево разрядности не имеют.
		ТекстОшибки = "";
	КонецЕсли;
	Возврат ТекстОшибки;

КонецФункции

// Подгоняет длину и точность числа под пределы типа.
//
// Параметры:
//  Форма          - ФормаКлиентскогоПриложения - эта форма
//  МенялиТочность - Булево - при Истина точность сохраняется, подгоняется длина
//
&НаКлиентеНаСервереБезКонтекста
Процедура ВыровнятьРазрядность(Форма, МенялиТочность)

	Форма.ТочностьЧисла = Мин(Макс(Форма.ТочностьЧисла, 0), МаксимумДробных());
	Форма.ДлинаЧисла = Мин(Макс(Форма.ДлинаЧисла, 1), МаксимумЦифр());
	ЦелыхМакс = МаксимумЦифр() - МаксимумДробных();
	Если МенялиТочность Тогда
		Форма.ДлинаЧисла = Мин(Макс(Форма.ДлинаЧисла, Форма.ТочностьЧисла), Форма.ТочностьЧисла + ЦелыхМакс);
	Иначе
		Форма.ТочностьЧисла = Мин(Форма.ТочностьЧисла, Форма.ДлинаЧисла);
		Форма.ДлинаЧисла = Мин(Форма.ДлинаЧисла, Форма.ТочностьЧисла + ЦелыхМакс);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЭлементыТипа(Форма)

	Элементы = Форма.Элементы;
	ЭтоЧисло = (Форма.ВидТипа = ВидЧисло());
	ЭтоСтрока = (Форма.ВидТипа = ВидСтрока());
	Элементы.ГруппаЧисло.Видимость = ЭтоЧисло;
	Элементы.ПодсказкаЧисла.Видимость = ЭтоЧисло;
	Элементы.ДлинаСтроки.Видимость = ЭтоСтрока;
	Элементы.Многострочное.Видимость = ЭтоСтрока;
	Элементы.СоставнойТип.Видимость = ПустаяСтрока(Форма.ВидТипа);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВидСтрока()
	Возврат "Строка";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидЧисло()
	Возврат "Число";
КонецФункции

// Пределы - тип значения плана видов характеристик: Число(15, 3), Строка(200).
//
// Возвращаемое значение:
//  Число - всего цифр числа
//
&НаКлиентеНаСервереБезКонтекста
Функция МаксимумЦифр()
	Возврат 15;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция МаксимумДробных()
	Возврат 3;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция МаксимумДлиныСтроки()
	Возврат 200;
КонецФункции

#КонецОбласти
