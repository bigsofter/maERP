
Функция ПолучитьПроцентПремииПоВыполненномуПлану(ТЗКоэффициентыПремии, ВыполненныйПлан) Экспорт
	Если ТЗКоэффициентыПремии.Количество() = 0 Тогда
		ПроцентПремии = 100;	
	Иначе	
		ТЗКоэффициентыПремии.Сортировать("ВыполнениеПлана Убыв");
		ПроцентПремии = 0;
		Для Каждого Стр Из ТЗКоэффициентыПремии Цикл
			Если ВыполненныйПлан < Стр.ВыполнениеПлана Тогда Продолжить КонецЕсли;
			ПроцентПремии = Стр.ПроцентПремии;
			Прервать;		
		КонецЦикла;
	КонецЕсли;
	Возврат ПроцентПремии;
КонецФункции

Функция ПолучитьПоказателиПоСОтруднику(Сотрудник, НаДату = Неопределено) Экспорт
	ДатаРасчета = ?(НаДату = Неопределено, ТекущаяДатаСеанса(), НаДату);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПремииСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
	|	ПремииСотрудниковСрезПоследних.ВидПремии КАК Показатель,
	|	ЛОЖЬ КАК SMART,
	|	0 КАК План,
	|	0 КАК Факт,
	|	ПремииСотрудниковСрезПоследних.Премия КАК Стоимость,
	|	ПремииСотрудниковСрезПоследних.Премия КАК Премия
	|ИЗ
	|	РегистрСведений.ПремииСотрудников.СрезПоследних(&ДатаРасчета, Сотрудник = &Сотрудник) КАК ПремииСотрудниковСрезПоследних";
	Запрос.УстановитьПараметр("Сотрудник",Сотрудник);
	Запрос.УстановитьПараметр("ДатаРасчета",ДатаРасчета);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Возвращает настройки вида премии для расчёта по РегистрСведений.ПремииСотрудников.
// Для предопределённых видов, у которых анализ продаж не настроен, подставляются значения
// по умолчанию (см. ЗначенияПоУмолчаниюПредопределенного).
//
// Параметры:
//  ВидПремии - ПланВидовХарактеристикСсылка.ПоказателиРасчётаПремий - вид премии.
//
// Возвращаемое значение:
//  Структура - АнализПродажАнализировать (Булево), АнализПродажВариант (ПеречислениеСсылка.ВариантыАнализаПоказателей),
//  АнализПродажПоказатель (ПеречислениеСсылка.ПоказателиПродаж), ПоОтработаннымДням (Булево),
//  Сотрудники (Массив), Подразделения (Массив), Параметры (Массив).
//
Функция НастройкиВидаПремии(ВидПремии) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВидыПремий.АнализПродажАнализировать КАК АнализПродажАнализировать,
	                      |	ВидыПремий.АнализПродажВариант КАК АнализПродажВариант,
	                      |	ВидыПремий.АнализПродажПоказатель КАК АнализПродажПоказатель,
	                      |	ВидыПремий.ПоОтработаннымДням КАК ПоОтработаннымДням,
	                      |	ВидыПремий.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	                      |ИЗ
	                      |	ПланВидовХарактеристик.ПоказателиРасчётаПремий КАК ВидыПремий
	                      |ГДЕ
	                      |	ВидыПремий.Ссылка = &ВидПремии
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Сотрудники.Сотрудник КАК Сотрудник
	                      |ИЗ
	                      |	ПланВидовХарактеристик.ПоказателиРасчётаПремий.ТЧАнализПродажСотрудники КАК Сотрудники
	                      |ГДЕ
	                      |	Сотрудники.Ссылка = &ВидПремии
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Подразделения.Подразделение КАК Подразделение
	                      |ИЗ
	                      |	ПланВидовХарактеристик.ПоказателиРасчётаПремий.ТЧАнализПродажПодразделения КАК Подразделения
	                      |ГДЕ
	                      |	Подразделения.Ссылка = &ВидПремии
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Параметры.Параметр КАК Параметр
	                      |ИЗ
	                      |	ПланВидовХарактеристик.ПоказателиРасчётаПремий.ТЧАнализПродажПараметры КАК Параметры
	                      |ГДЕ
	                      |	Параметры.Ссылка = &ВидПремии");
	Запрос.УстановитьПараметр("ВидПремии", ВидПремии);
	Рез = Запрос.ВыполнитьПакет();
	Результат = Новый Структура("АнализПродажАнализировать, АнализПродажВариант, АнализПродажПоказатель, ПоОтработаннымДням", Ложь);
	Результат.Вставить("Сотрудники", Рез[1].Выгрузить().ВыгрузитьКолонку("Сотрудник"));
	Результат.Вставить("Подразделения", Рез[2].Выгрузить().ВыгрузитьКолонку("Подразделение"));
	Результат.Вставить("Параметры", Рез[3].Выгрузить().ВыгрузитьКолонку("Параметр"));
	Выборка = Рез[0].Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Если Не Результат.АнализПродажАнализировать Тогда
		ПоУмолчанию = ЗначенияПоУмолчаниюПредопределенного(Выборка.ИмяПредопределенныхДанных);
		Если ПоУмолчанию <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат, ПоУмолчанию);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Результат.АнализПродажПоказатель) Тогда
		Результат.АнализПродажПоказатель = Перечисления.ПоказателиПродаж.Выручка;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Возвращает значения анализа продаж по умолчанию для предопределённого вида премии.
//
// Параметры:
//  ИмяПредопределенного - Строка - имя предопределённого элемента.
//
// Возвращаемое значение:
//  Структура, Неопределено - АнализПродажАнализировать, АнализПродажВариант, АнализПродажПоказатель;
//  Неопределено - для непредопределённых видов и видов без анализа продаж.
//
Функция ЗначенияПоУмолчаниюПредопределенного(ИмяПредопределенного) Экспорт
	ВариантыАнализа = Перечисления.ВариантыАнализаПоказателей;
	Если ИмяПредопределенного = "ПроцентОтПродажСотрудника" Тогда
		Вариант = ВариантыАнализа.ПоСотруднику;
	ИначеЕсли ИмяПредопределенного = "ПроцентОтОбщегоОбъема" Тогда
		Вариант = ВариантыАнализа.ПоОрганизации;
	ИначеЕсли ИмяПредопределенного = "ПроцентОтПродажПодразделения" Тогда
		Вариант = ВариантыАнализа.ПоПодразделению;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("АнализПродажАнализировать", Истина);
	Результат.Вставить("АнализПродажВариант", Вариант);
	Результат.Вставить("АнализПродажПоказатель", Перечисления.ПоказателиПродаж.Выручка);
	Возврат Результат;
КонецФункции
