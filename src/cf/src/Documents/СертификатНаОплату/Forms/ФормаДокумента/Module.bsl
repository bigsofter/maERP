
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не РольДоступна("Администратор") Тогда 
		ТолькоПросмотр = Не Объект.Ссылка.Пустая();
	КонецЕсли;
	// Суммы взаиморасчётов - в основной валюте (документы в валюте - по своему курсу).
	ЗаголовокСуммы = РаботаСВалютамиКлиентСервер.ЗаголовокСВалютой(
		НСтр("ru = 'Сумма'; fr = 'Montant'; en = 'Amount'; es = 'Importe'"), РаботаСВалютами.ОсновнаяВалюта());
	Элементы.Сумма.Заголовок = ЗаголовокСуммы;
КонецПроцедуры
