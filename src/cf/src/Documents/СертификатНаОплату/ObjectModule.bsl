
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Поступление = ДанныеЗаполнения;
		// Сертификат гасит долг поставщику в регистре - сумма в основной валюте (поступление в валюте - по курсу).
		Сумма = РаботаСВалютами.СуммаОбъектаВОсновнойВалюте(Поступление, Поступление.Сумма);
		МестоХранения = Поступление.МестоХранения;
		Ответственный = ПараметрыСеанса.Пользователь;
		Организация = Поступление.Организация;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);	
	// Формируем
	РегистрыНакопления.ВзаиморасчётыСПоставщиками.СформироватьДвижения(ЭтотОбъект);
	РегистрыНакопления.ВзаиморасчётыСПокупателями.СформироватьДвижения(ЭтотОбъект);
	// Записываем
	Движения.Записать();
	ПроизводственныеЗаказы.ОбновитьСтадииПослеПроведения(ЭтотОбъект);
КонецПроцедуры

// Отмена проведения документа, затронувшего заказы клиента на производство: очистка движений и пересчёт стадий
// заказов (E8). Явных блокировок при проведении нет - и здесь нет. Без таких заказов движения удаляет платформа.
//
// Параметры:
//  Отказ - Булево - не используется.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроизводственныеЗаказы.ОтменитьПроведениеДокумента(ЭтотОбъект, Неопределено);
КонецПроцедуры

// Закрытая кассовая смена неизменна и при удалении документа (docs/plans/retail-cash-unfinished.md).
//
// Параметры:
//  Отказ - Булево - отказ удаления.
//
// BSLLS:EventHandlerOutsideEventRegion-off
Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	НезавершенныеПродажиКассы.ПроверитьСменуДокумента(ЭтотОбъект, Неопределено, Отказ);
КонецПроцедуры
// BSLLS:EventHandlerOutsideEventRegion-on

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Кассовая смена (docs/plans/retail-cash-unfinished.md): первой - закрытая смена неизменна.
	НезавершенныеПродажиКассы.ПроверитьСменуДокумента(ЭтотОбъект, РежимЗаписи, Отказ);
	// Порядок блокировок (docs/plans/retail-cash-unfinished.md): смена -> сам сертификат -> основания одним вызовом
	// (IMEI каскада и основания в общем порядке) -> проверки по каждому основанию (их блокировки уже взяты).
	ЗаблокироватьСебяИОснования();
	// По покрытым реализации и поступлению - только по налоговому документу (docs/plans/accounting-morocco-f1-s2.md).
	НалоговыеДокументыНаОснованиях.ПроверитьДокументПоОснованию(ЭтотОбъект, Реализация, РежимЗаписи, Отказ);
	НалоговыеДокументыНаОснованиях.ПроверитьДокументПоОснованию(ЭтотОбъект, Поступление, РежимЗаписи, Отказ);
	// Отменённая кассовая продажа не оплачивается сертификатом.
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И Не Отказ Тогда
		НезавершенныеПродажиКассы.ПроверитьКассовыеОснованияПлатежа(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Реализация));
	КонецЕсли;
	ПроизводственныеЗаказы.ЗапомнитьЗаказыДокумента(ЭтотОбъект, РежимЗаписи);
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Проведённый документ, перезаписанный без перепроведения, пересчитывает стадии своих заказов (E8).
	ПроизводственныеЗаказы.ОбновитьСтадииПриЗаписи(ЭтотОбъект);
КонецПроцедуры

// Блокировка самого сертификата и его оснований одним захватом (docs/plans/retail-cash-unfinished.md).
//
Процедура ЗаблокироватьСебяИОснования()
	Если Не ЭтоНовый() Тогда
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("Документ.СертификатНаОплату");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Ссылка", Ссылка);
		Блокировка.Заблокировать();
	КонецЕсли;
	Заполненные = Новый Массив;
	Если ЗначениеЗаполнено(Реализация) Тогда
		Заполненные.Добавить(Реализация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Поступление) Тогда
		Заполненные.Добавить(Поступление);
	КонецЕсли;
	Если Заполненные.Количество() > 0 Тогда
		НалоговыеДокументыНаОснованиях.ЗаблокироватьОснования(Заполненные, Истина);
	КонецЕсли;
КонецПроцедуры
