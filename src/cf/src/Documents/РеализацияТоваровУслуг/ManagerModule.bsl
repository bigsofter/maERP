	|		ПО ВТШапка.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВТСтроки.Produit = Номенклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ДокументЗаказ
	|		ПО ВТШапка.Заказ = ДокументЗаказ.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	LineNumber
	|ИТОГИ
	|	МАКСИМУМ(DocRef),
	|	МАКСИМУМ(Client),
	|	МАКСИМУМ(Createur),
	|	МАКСИМУМ(Date),
	|	МАКСИМУМ(Number),
	|	МАКСИМУМ(Devise),
	|	МАКСИМУМ(TotalSomme),
	|	МАКСИМУМ(TotalTVA),
	|	МАКСИМУМ(Organisation),
	|	МАКСИМУМ(Комментарий),
	|	МАКСИМУМ(КодКлиента),
	|	МАКСИМУМ(НаименованиеКлиента),
	|	МАКСИМУМ(НомерЗаказа)
	|ПО
	|	Ссылка";
КонецФункции

Функция ОбластиМакетаDevisBL(Template, ОбластьИтогов)
	Области = Новый Структура;
	Области.Вставить("Header", Template.ПолучитьОбласть("Header"));
	Области.Вставить("TabularSectionHeader", Template.ПолучитьОбласть("TabularSectionHeader"));
	Области.Вставить("TabularSection", Template.ПолучитьОбласть("TabularSection"));
	Области.Вставить("EmptyLine", Template.ПолучитьОбласть("EmptyLine"));
	Области.Вставить("FooterTotal", Template.ПолучитьОбласть(ОбластьИтогов));
	Области.Вставить("Footer", Template.ПолучитьОбласть("TabularSectionFooter"));
	Области.Вставить("FooterCodes", Template.ПолучитьОбласть("TabularSectionFooterCodes"));
	Возврат Области;
КонецФункции

Функция ДанныеШапкиDevisBL(Selection, Карточка, КарточкаКлиента, НазваниеДокумента)
	// Значения параметров шапки; в макете подставляются только те, что в нём есть (A5 и A4 различаются).
	Данные = Новый Структура;
	Данные.Вставить("Организация", Selection.Organisation);
	Данные.Вставить("НазваниеДокумента", НазваниеДокумента);
	Данные.Вставить("Комментарий", Selection.Комментарий);
	Данные.Вставить("НомерЗаказа", РаботаСДокументами.СформироватьЦифровойНомер(Selection.НомерЗаказа));
	Номер = РаботаСДокументами.СформироватьЦифровойНомер(Selection.Number) + "/" + Формат(Selection.Date, "Л=fr; ДФ=yy; ДЛФ=DD");
	Данные.Вставить("Number", НСтр("ru = 'Номер: '; fr = 'Numéro: '; en = 'Number: '; es = 'Número: '") + Номер);
	Дата = Формат(Selection.Date, "Л=fr; ДФ=dd/MM/yyyy; ДЛФ=DD");
	Данные.Вставить("Date", НСтр("ru = 'Дата: '; fr = 'Date: '; en = 'Date: '; es = 'Fecha: '") + Дата);

	Данные.Вставить("Адрес", Карточка.АдресЮридический);
	Данные.Вставить("Телефоны", МеткаТелефон() + Карточка.Телефоны);
	Данные.Вставить("RC", "RC: " + Карточка.Реквизиты.RC);
	Данные.Вставить("Patente", "PATENTE: " + Карточка.Реквизиты.TaxeProfessionnelle);
	Данные.Вставить("IF", "IF: " + Карточка.Реквизиты.NIF);
	Данные.Вставить("ICE", "ICE: " + Карточка.Реквизиты.ICE);
	Сайт = НСтр("ru = 'Сайт: '; fr = 'Site web: '; en = 'Website: '; es = 'Sitio web: '") + Карточка.Реквизиты.Web;
	Данные.Вставить("Site", Сайт);
	Данные.Вставить("Email", "E-mail: " + Карточка.Реквизиты.EMail);

	Client = Selection.НаименованиеКлиента;
	Если ЗначениеЗаполнено(КарточкаКлиента.Телефоны) Тогда
		Client = Client + Символы.ПС + МеткаТелефон() + КарточкаКлиента.Телефоны;
	КонецЕсли;
	Если ЗначениеЗаполнено(КарточкаКлиента.Реквизиты.ICE) Тогда
		Client = Client + Символы.ПС + "ICE: " + КарточкаКлиента.Реквизиты.ICE;
	КонецЕсли;
	Данные.Вставить("Client", Client);
	Возврат Данные;
КонецФункции

Функция МеткаТелефон()
	Возврат НСтр("ru = 'Тел.: '; fr = 'Tél.: '; en = 'Tel.: '; es = 'Tel.: '");
КонецФункции

Процедура ВывестиСтрокиDevisBL(Spreadsheet, Области, Selection, БезЦен)
	SelectionTabularSection = Selection.Выбрать();
	НомерСтроки = 0;
	МасОбластей = Новый Массив;
	МасОбластей.Добавить(Области.TabularSection);
	МасОбластей.Добавить(Области.FooterTotal);
	МасОбластей.Добавить(Области.Footer);
	МасОбластей.Добавить(Области.FooterCodes);
	Пока SelectionTabularSection.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		Области.TabularSection.Параметры.Заполнить(SelectionTabularSection);
		Области.TabularSection.Параметры.LineNumber = НомерСтроки;
		// У строки коммерческого предложения своё описание, у остальных документов - описание из карточки.
		ОписаниеСтроки = ?(SelectionTabularSection.ОписаниеСтроки = NULL, Неопределено, SelectionTabularSection.ОписаниеСтроки);
		Области.TabularSection.Параметры.Descriptif = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(
			SelectionTabularSection.Produit, "", , Истина, SelectionTabularSection.НоменклатураСтрока, ОписаниеСтроки);
		Области.TabularSection.Параметры.Prix = ?(БезЦен, 0, SelectionTabularSection.Prix);
		Области.TabularSection.Параметры.Somme = ?(БезЦен, 0, SelectionTabularSection.Somme);
		Если Не Spreadsheet.ПроверитьВывод(МасОбластей) Тогда
			// Страница заполнена: добиваем её пустыми строками, выводим реквизиты и продолжаем на новой.
			ПечатныеФормы.ДобитьСтраницуПустымиСтроками(Spreadsheet, Области.EmptyLine, МассивОбластей(Области.FooterCodes));
			Spreadsheet.Вывести(Области.FooterCodes);
			Spreadsheet.ВывестиГоризонтальныйРазделительСтраниц();
			Spreadsheet.Вывести(Области.Header, Selection.Уровень());
			Spreadsheet.Вывести(Области.TabularSectionHeader);
		КонецЕсли;
		Spreadsheet.Вывести(Области.TabularSection, SelectionTabularSection.Уровень());
	КонецЦикла;
КонецПроцедуры

