#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы документа.
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	// Facture, счёт на оплату, накладные BL и акт - фирменные формы под прежними именами и названиями команд
	// (docs/plans/branded-print.md, разделы 10.7 и 11.3): настройки принтера и пункты меню у пользователя не меняются.
	// Накладная DevisBL печатается на A4, как BL (A4), - ответ владельца 2026-10-11; «(A5)» из названия убрано.
	Для Каждого Вариант Из ВариантыФирменныхФорм() Цикл
		ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, Вариант.ИмяМакета, Вариант.ВидФормы, Вариант.Представление,
			Вариант.ИмяКоманды);
	КонецЦикла;

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "Чек";
	Команда.ИмяКоманды = "ПечатьЧека";
	Команда.Представление = НСтр("ru = 'Чек'; fr = 'Ticket'; en = 'Receipt'; es = 'Recibo'");

	Если ПечатьКПДоступна() Тогда
		ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаКП(), ВидФормыКП());
	КонецЕсли;

	Для Каждого ИмяМакета Из МакетыСкрытыеВМеню() Цикл
		Команда = КомандыПечати.Найти(ИмяМакета, "ИмяМакета");
		Если Команда <> Неопределено Тогда
			Команда.СкрытаВМеню = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Формирует запрошенные печатные формы документа.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые документы
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие документов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Команду «Счёт» печатают и формы заказа покупателя: по ссылке заказа - счета его реализаций, без них - сам заказ
	// (адаптер заказа, признак СчетаРеализаций). Варианты BL - параметрами команды (БезНДС, БезЦен), как прежние формы.
	Для Каждого Вариант Из ВариантыФирменныхФорм() Цикл
		ФирменнаяПечать.Напечатать(Вариант.ИмяМакета, Вариант.ВидФормы, МассивОбъектов,
			ПараметрыВарианта(ПараметрыПечати, Вариант.Параметры), КоллекцияПечатныхФорм, ОбъектыПечати,
			Вариант.Представление);
	КонецЦикла;

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "Чек") Тогда
		Таб = НовыйТабличныйДокументЧека();
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			PrintTicket(Док, Таб);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "Чек",
			НСтр("ru = 'Чек'; fr = 'Ticket'; en = 'Receipt'; es = 'Recibo'"),
			Таб, "Документ.РеализацияТоваровУслуг.Чек");
	КонецЕсли;

	НапечататьКоммерческоеПредложение(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати);

КонецПроцедуры

// Доступна ли пользователю печать коммерческого предложения из реализации (docs/plans/branded-print.md, 3.3 и 9.8):
// только когда КП не вводятся вручную (опция выключена) и только ролям, которым видны суммы реализации. Роль
// ОператорПроизводства работает с составом документов без цен и сумм (РаботаСДокументами.
// ОграничитьВидимостьРеквизитовПоТипу) - КП с ценами ей не печатается.
//
// Возвращаемое значение:
//  Булево - Истина, если команда «Коммерческое предложение» реализации доступна.
//
Функция ПечатьКПДоступна() Экспорт
	Возврат Не Документы.КоммерческоеПредложение.КПВводятсяВручную() И Не ФирменнаяПечать.ЦеныСкрыты();
КонецФункции

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать). Facture, Proforma, BL и акт - данные реализации (товары
// и услуги, у акта - только услуги; docs/plans/branded-print.md, разделы 10.6 и 11.5). КП из реализации: перед печатью протокол
// синхронизации создаёт или обновляет КП реализаций (догоняет и изменения, пришедшие загрузкой обмена), затем данные
// берёт адаптер документа КП. Печатаются только реализации, которые пользователь вправе читать; КП читается в
// привилегированном режиме - у ролей, работающих с реализацией, прав на КП может не быть (docs/plans/branded-print.md,
// 9.5 и 9.8).
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.РеализацияТоваровУслуг - печатаемые реализации.
//  ВидФормы        - Строка - вид фирменной формы: КоммерческоеПредложение, Facture, Proforma, BL, АктОбОказанииУслуг.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати (БезЦен, БезНДС - нужны ли оплаты BL); адаптеру КП не
//                    передаются (у авто-КП нет редакций).
//
// Возвращаемое значение:
//  Соответствие - реализация -> Структура: Данные, Плашка, ИмяФайла (см. ФирменнаяПечать.ИсточникТоварногоДокумента,
//                 Документы.КоммерческоеПредложение.ДанныеФирменнойПечати).
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	Если ВидФормы <> ВидФормыКП() Тогда
		Возврат ДанныеТоварныхФорм(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати);
	КонецЕсли;
	ПроверитьДоступностьПечатиКП();
	// Проверка доступа и чтение данных печати - в одной транзакции под блокировкой реализаций: иначе смена
	// контрагента реализации между проверкой и привилегированным чтением обходила бы ограничения записей.
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРеализации(Ссылки);
		Результат = ДанныеКПДоступныхРеализаций(Ссылки, ВидФормы, КодЯзыка);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Табличный документ, настроенный под печать чека на чековом принтере.
//
// Возвращаемое значение:
//  ТабличныйДокумент - подготовленный документ
//
Функция НовыйТабличныйДокументЧека() Экспорт

	Таб = Новый ТабличныйДокумент;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Таб.АвтоМасштаб = Истина;
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.Защита = Ложь;
	Таб.ПолеСверху = 5;
	Таб.ПолеСлева = 0;
	Таб.ПолеСнизу = 20;
	Таб.ПолеСправа = 10;
	Возврат Таб;

КонецФункции

// Настраивает форму реализации под ордерную схему склада (план warehouse-orders, решение 5): документ по ордерам берёт
// склад из ордера - склад только для просмотра, колонка ордера видна; документ без ордеров выбирает склад из неордерных.
// Одна настройка на основную и мобильную форму.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа с элементами МестоХранения и ТЧТоварыОрдер
//
Процедура НастроитьОрдернуюСхемуФормы(Форма) Экспорт
	ЕстьОрдера = Ложь;
	Для Каждого Строка Из Форма.Объект.ТЧТовары Цикл
		Если ЗначениеЗаполнено(Строка.Ордер) Тогда
			ЕстьОрдера = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Форма.Элементы.ТЧТоварыОрдер.Видимость = ЕстьОрдера;
	Форма.Элементы.МестоХранения.ТолькоПросмотр = ЕстьОрдера;
	Если Не ЕстьОрдера Тогда
		Справочники.МестаХранения.УстановитьОтборОрдерности(Форма.Элементы.МестоХранения, Ложь);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Закладка «Товары» списка реализаций (план docs/plans/sales-goods-tab.md, тикет 2605528): строки товаров документов
// вводятся прямо в таблице, реализация создаётся и проводится при записи строки. Модель ввода - режима «Товары»
// рабочего места закупок; правятся только простые реализации, которые закладка ведёт целиком (ТекстЗапретаПравки).

// Отборы закладки - те же, что у списка «Реализаций» на правой панели.
//
// Возвращаемое значение:
//  Структура:
//   * Контрагент            - СправочникСсылка.Контрагенты - клиент; пустой - любой.
//   * Организация           - СправочникСсылка.Организации - организация; пустая - любая.
//   * МестоХранения         - СправочникСсылка.МестаХранения - склад; пустой - любой.
//   * Ответственный         - СправочникСсылка.Пользователи - ответственный; пустой - любой.
//   * ХозяйственнаяОперация - ПеречислениеСсылка.ХозяйственныеОперации, Неопределено - операция; Неопределено - любая.
//   * Товар                 - СправочникСсылка.Номенклатура - только строки этого товара; пустой - все строки.
//   * Сумма                 - Число - сумма документа; 0 - без отбора.
//   * СуммаУсловие          - Число - 0 - больше, 1 - меньше, 2 - равно.
//   * Долг                  - Число - долг по документу; 0 - без отбора.
//   * ДолгУсловие           - Число - 0 - больше, 1 - меньше, 2 - равно.
//
Функция НовыеОтборыСтрокТоваров() Экспорт

	Отборы = Новый Структура;
	Отборы.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Отборы.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Отборы.Вставить("МестоХранения", Справочники.МестаХранения.ПустаяСсылка());
	Отборы.Вставить("Ответственный", Справочники.Пользователи.ПустаяСсылка());
	Отборы.Вставить("ХозяйственнаяОперация", Неопределено);
	Отборы.Вставить("Товар", Справочники.Номенклатура.ПустаяСсылка());
	Отборы.Вставить("Сумма", 0);
	Отборы.Вставить("СуммаУсловие", 0);
	Отборы.Вставить("Долг", 0);
	Отборы.Вставить("ДолгУсловие", 0);
	Возврат Отборы;

КонецФункции

// Возвращаемое значение:
//  Булево - Истина, если пользователь вводит строки закладки: добавление, изменение и проведение реализаций.
//
Функция МожноВводитьСтрокиТоваров() Экспорт

	МетаданныеДокумента = Метаданные.Документы.РеализацияТоваровУслуг;
	Возврат ПравоДоступа("Добавление", МетаданныеДокумента) И ПравоДоступа("Изменение", МетаданныеДокумента)
		И ПравоДоступа("Проведение", МетаданныеДокумента);

КонецФункции

// Строки товаров последних документов по отборам закладки (не больше ПределДокументовСтрокТоваров документов).
//
// Параметры:
//  Отборы - Структура - см. НовыеОтборыСтрокТоваров.
//
// Возвращаемое значение:
//  Структура:
//   * Строки   - Массив из Структура - см. НоваяСтрокаТоваровСписка; документы свежие первыми, строки по номеру.
//   * Обрезано - Булево - документов по отборам больше предела: показаны последние.
//   * Предел   - Число - предел документов.
//
Функция СтрокиТоваровСписка(Отборы) Экспорт

	Результат = Новый Структура("Строки, Обрезано, Предел", Новый Массив, Ложь, ПределДокументовСтрокТоваров());
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.РеализацияТоваровУслуг) Тогда
		Возврат Результат;
	КонецЕсли;
	ОтборыЗапроса = НовыеОтборыСтрокТоваров();
	Если ТипЗнч(Отборы) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ОтборыЗапроса, Отборы);
	КонецЕсли;
	Документы_ = ПоследниеДокументыПоОтборам(ОтборыЗапроса, Результат.Предел + 1);
	Результат.Обрезано = Документы_.Количество() > Результат.Предел;
	Если Результат.Обрезано Тогда
		Документы_.Удалить(Документы_.ВГраница());
	КонецЕсли;
	Если Документы_.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запреты = ЗапретыПравкиДокументов(Документы_);
	МожноВводить = МожноВводитьСтрокиТоваров();
	ОсновнаяВалюта = РаботаСВалютами.ОсновнаяВалюта();
	// Роль, которой цены и суммы документов не показываются (как в формах документов и печати), их не получает.
	ЦеныСкрыты = ФирменнаяПечать.ЦеныСкрыты();
	Запрос = Новый Запрос(ТекстЗапросаСтрокТоваров(ЗначениеЗаполнено(ОтборыЗапроса.Товар)));
	Запрос.УстановитьПараметр("Документы", Документы_);
	Запрос.УстановитьПараметр("Товар", ОтборыЗапроса.Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = НоваяСтрокаТоваровСписка();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Если ЦеныСкрыты Тогда
			Строка.Цена = 0;
			Строка.Сумма = 0;
		КонецЕсли;
		Строка.ДокументПредставление = ПредставлениеДокументаСтроки(Выборка.Номер, Выборка.Дата);
		Строка.Картинка = КартинкаСостоянияДокумента(Выборка.Проведен, Выборка.ПометкаУдаления);
		ВВалюте = Выборка.ВВалюте И ЗначениеЗаполнено(Выборка.Валюта);
		Строка.Валюта = ?(ВВалюте, Выборка.Валюта, ОсновнаяВалюта);
		ДокументПравится = МожноВводить И Не Выборка.ПометкаУдаления И ПустаяСтрока(Запреты[Выборка.Документ]);
		Строка.ТолькоПросмотр = Не ДокументПравится Или Не СтрокаБезСерийИОрдеров(Выборка);
		Результат.Строки.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пустая строка закладки «Товары»: колонки таблицы формы.
//
// Возвращаемое значение:
//  Структура - Документ, ДокументПредставление, Дата, Картинка, ВерсияДанных, НомерСтроки, Клиент, Организация, Склад,
//              Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Цена, Сумма, Валюта, ТолькоПросмотр.
//
Функция НоваяСтрокаТоваровСписка() Экспорт

	Возврат Новый Структура("Документ, ДокументПредставление, Дата, Картинка, ВерсияДанных, НомерСтроки, Клиент, Организация,
		|Склад, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Цена, Сумма, Валюта, ТолькоПросмотр");

КонецФункции

// Записывает строки закладки одного документа одним пакетом: одна блокировка, одна проверка версии данных, одна
// запись (проведение). Новая строка без документа - новая реализация, по одной строке на вызов.
//
// Параметры:
//  Строки - Массив из Структура - строки одного документа:
//   * Документ           - ДокументСсылка.РеализацияТоваровУслуг, Неопределено - документ; пустой - новый.
//   * НомерСтроки        - Число - номер строки товаров документа; 0 - новая строка.
//   * ВерсияДанных       - Строка - версия документа, прочитанная вместе со строкой.
//   * Клиент             - СправочникСсылка.Контрагенты - клиент нового документа.
//   * Организация        - СправочникСсылка.Организации - организация нового документа; пустая - по умолчанию.
//   * Склад              - СправочникСсылка.МестаХранения - склад нового документа.
//   * Номенклатура       - СправочникСсылка.Номенклатура - товар.
//   * Характеристика     - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика.
//   * Упаковка           - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка; пустая - единица товара.
//   * КоличествоУпаковок - Число - количество упаковок, больше нуля.
//   * Цена               - Число - цена в валюте документа, если ЦенаИзменена.
//   * ЦенаИзменена       - Булево - цену ввёл пользователь (применяется при праве заверения цен).
//   * Валюта             - СправочникСсылка.Валюты - валюта, в которой введена цена.
//
// Возвращаемое значение:
//  Структура:
//   * Успех       - Булево - документ записан.
//   * Текст       - Строка - отказ или сообщения записи.
//   * Документ    - ДокументСсылка.РеализацияТоваровУслуг, Неопределено - записанный документ.
//   * НомерСтроки - Число - номер последней записанной строки пакета.
//   * Конфликт    - Булево - документ изменил другой пользователь: строки надо перечитать.
//
Функция ЗаписатьСтрокиТоваров(Строки) Экспорт

	Результат = НовыйРезультатЗаписиСтрок();
	Результат.Текст = ТекстЗапретаДанныхСтрок(Строки);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Документ = Строки[0].Документ;
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ЗаписатьНовуюРеализацию(Строки[0], Результат);
		Возврат Результат;
	КонецЕсли;
	ДокОбъект = ЗаблокированныйДокумент(Документ, ВерсияПакета(Строки), Результат);
	Если ДокОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Изменений = 0;
		Для Каждого Строка Из Строки Цикл
			Результат.НомерСтроки = Строка.НомерСтроки;
			Если СтрокаБезИзменений(ДокОбъект, Строка) Тогда
				// Вошли в строку и вышли без правки: документ не перепроводится.
				Продолжить;
			КонецЕсли;
			СтрокаТоваров = ПрименитьСтроку(ДокОбъект, Строка, Результат);
			Если СтрокаТоваров = Неопределено Тогда
				ДокОбъект.Разблокировать();
				Возврат Результат;
			КонецЕсли;
			Результат.НомерСтроки = СтрокаТоваров.НомерСтроки;
			Изменений = Изменений + 1;
		КонецЦикла;
		Если Изменений = 0 Тогда
			Результат.Успех = Истина;
			Результат.Документ = Документ;
		Иначе
			ЗаписатьДокумент(ДокОбъект, Ложь, Результат);
		КонецЕсли;
	Исключение
		Результат.Успех = Ложь;
		Результат.Текст = ТекстНеЗаписано(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ДокОбъект.Разблокировать();
	Возврат Результат;

КонецФункции

// Удаляет строки закладки; документ без строк помечается на удаление (как в рабочем месте производства).
//
// Параметры:
//  Строки - Массив из Структура - Документ, НомерСтроки, ВерсияДанных.
//
// Возвращаемое значение:
//  Структура - Успех (Булево - все документы обработаны), Текст (Строка - отказы и сообщения по документам).
//
Функция УдалитьСтрокиТоваров(Строки) Экспорт

	Итог = Новый Структура("Успех, Текст", Истина, "");
	ПоДокументам = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Если Не ЗаписанныйДокументСтроки(Строка) Тогда
			Итог.Успех = Ложь;
			Итог.Текст = ТекстНеверныеДанные();
			Возврат Итог;
		КонецЕсли;
		Номера = ПоДокументам[Строка.Документ];
		Если Номера = Неопределено Тогда
			Номера = Новый Структура("ВерсияДанных, Номера", Строка.ВерсияДанных, Новый Массив);
			ПоДокументам.Вставить(Строка.Документ, Номера);
		КонецЕсли;
		Номера.Номера.Добавить(Строка.НомерСтроки);
	КонецЦикла;
	Для Каждого КлючИЗначение Из ПоДокументам Цикл
		Результат = НовыйРезультатЗаписиСтрок();
		УдалитьСтрокиДокумента(КлючИЗначение.Ключ, КлючИЗначение.Значение, Результат);
		Если Не Результат.Успех Тогда
			Итог.Успех = Ложь;
		КонецЕсли;
		Если Не ПустаяСтрока(Результат.Текст) Тогда
			Итог.Текст = СоединитьТексты(Итог.Текст, СтрШаблон("%1: %2", КлючИЗначение.Ключ, Результат.Текст));
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Сегодняшние реализации клиента, в которые закладка может добавить строку: на том же складе и в той же организации,
// без запретов правки (ТекстЗапретаПравки). Свежие первыми.
//
// Параметры:
//  Клиент      - СправочникСсылка.Контрагенты - клиент строки.
//  Организация - СправочникСсылка.Организации - организация строки; пустая - любая.
//  Склад       - СправочникСсылка.МестаХранения - склад строки; пустой - любой.
//
// Возвращаемое значение:
//  СписокЗначений из ДокументСсылка.РеализацияТоваровУслуг - значение - документ, представление - номер, дата,
//  позиций и сумма.
//
Функция ДокументыДляСтрокиТоваров(Клиент, Организация, Склад) Экспорт

	Список = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(Клиент) Или Не МожноВводитьСтрокиТоваров() Тогда
		Возврат Список;
	КонецЕсли;
	УсловияШапки = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		УсловияШапки = УсловияШапки + "
		|	И Д.Организация = &Организация";
	КонецЕсли;
	Если ЗначениеЗаполнено(Склад) Тогда
		УсловияШапки = УсловияШапки + "
		|	И Д.МестоХранения = &Склад";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Д.Ссылка КАК Ссылка,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Сумма КАК Сумма,
	|	Д.МестоХранения КАК МестоХранения,
	|	КОЛИЧЕСТВО(Т.НомерСтроки) КАК Позиций
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Д
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ТЧТовары КАК Т
	|		ПО (Т.Ссылка = Д.Ссылка)
	|ГДЕ
	|	Д.Контрагент = &Клиент
	|	И Д.Дата >= &НачалоДня
	|	И Д.Дата < &НачалоСледующегоДня
	|	И НЕ Д.ПометкаУдаления" + УсловияШапки + "
	|
	|СГРУППИРОВАТЬ ПО
	|	Д.Ссылка,
	|	Д.Номер,
	|	Д.Дата,
	|	Д.Сумма,
	|	Д.МестоХранения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Ссылка УБЫВ";
	// Клиент документа - головной у обособленного подразделения, как при создании (ревью плана, круг 10).
	Запрос.УстановитьПараметр("Клиент", КонтрагентДокумента(Клиент, Организация));
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("НачалоСледующегоДня", КонецДня(ТекущаяДатаСеанса()) + 1);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад);
	Таблица = Запрос.Выполнить().Выгрузить();
	ЧужиеСклады = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СкладЗапрещенРоли(СтрокаТаблицы.МестоХранения) Тогда
			ЧужиеСклады.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из ЧужиеСклады Цикл
		Таблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
	Запреты = ЗапретыПравкиДокументов(Таблица.ВыгрузитьКолонку("Ссылка"));
	ЦеныСкрыты = ФирменнаяПечать.ЦеныСкрыты();
	Шаблон = НСтр("ru = '%1 (%2 поз., %3)'; fr = '%1 (%2 art., %3)'; en = '%1 (%2 items, %3)'; es = '%1 (%2 art., %3)'");
	Для Каждого Строка Из Таблица Цикл
		Если ПустаяСтрока(Запреты[Строка.Ссылка]) Тогда
			Номер = ПредставлениеДокументаСтроки(Строка.Номер, Строка.Дата);
			Сумма = ?(ЦеныСкрыты, "-", Формат(Строка.Сумма, "ЧДЦ=2; ЧН=0"));
			Представление = СтрШаблон(Шаблон, Номер, Строка.Позиций, Сумма);
			Список.Добавить(Строка.Ссылка, Представление);
		КонецЕсли;
	КонецЦикла;
	Возврат Список;

КонецФункции

// Шапка документа для новой строки, выбравшей документ: клиент, организация, склад и валюта - из документа.
//
// Параметры:
//  Документ - ДокументСсылка.РеализацияТоваровУслуг - документ.
//
// Возвращаемое значение:
//  Структура - Клиент, Организация, Склад, Валюта; документа нет или нет права чтения - Неопределено.
//
Функция ШапкаДокументаСтрокиТоваров(Документ) Экспорт

	Если ТипЗнч(Документ) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Или Не ЗначениеЗаполнено(Документ)
		Или Не ПравоДоступа("Чтение", Метаданные.Документы.РеализацияТоваровУслуг) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Контрагент, Организация, МестоХранения, ВВалюте, Валюта");
	КонтрагентРоли = КонтрагентРолиКлиент();
	Если СкладЗапрещенРоли(Реквизиты.МестоХранения)
		Или КонтрагентРоли <> Неопределено И Реквизиты.Контрагент <> КонтрагентРоли Тогда
		Возврат Неопределено;
	КонецЕсли;
	ВВалюте = Реквизиты.ВВалюте = Истина И ЗначениеЗаполнено(Реквизиты.Валюта);
	Шапка = Новый Структура;
	Шапка.Вставить("Клиент", Реквизиты.Контрагент);
	Шапка.Вставить("Организация", Реквизиты.Организация);
	Шапка.Вставить("Склад", Реквизиты.МестоХранения);
	Шапка.Вставить("Валюта", ?(ВВалюте, Реквизиты.Валюта, РаботаСВалютами.ОсновнаяВалюта()));
	Возврат Шапка;

КонецФункции

// Значения новой строки по умолчанию: организация и склад пользователя; валюта - договора клиента.
//
// Параметры:
//  Клиент      - СправочникСсылка.Контрагенты - клиент; пустой - валюта основная.
//  Организация - СправочникСсылка.Организации - организация; пустая - по умолчанию.
//  Склад       - СправочникСсылка.МестаХранения - склад; пустой - склад отгрузок пользователя.
//
// Возвращаемое значение:
//  Структура - Организация, Склад, Валюта.
//
Функция ЗначенияНовойСтрокиТоваров(Клиент, Организация, Склад) Экспорт

	Образец = СоздатьДокумент();
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(Образец);
	Результат = Новый Структура("Организация, Склад, Валюта");
	Результат.Организация = ?(ЗначениеЗаполнено(Организация), Организация, Образец.Организация);
	Результат.Склад = ?(ЗначениеЗаполнено(Склад), Склад, Образец.МестоХранения);
	Результат.Валюта = ВалютаДоговораКлиента(Клиент, Результат.Организация);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Печать

// Строка под товаром чека: номера IMEI строки и гарантия товара в месяцах; пусто - ничего.
//
// Параметры:
//  Ссылка     - ДокументСсылка.РеализацияТоваровУслуг - чек.
//  Выборка    - ВыборкаИзРезультатаЗапроса - строка чека (Produit, НомерСтрокиТоваров).
//  СерииСтрок - Соответствие - см. СерийныйУчет.СерииСтрокДокументов.
//  Гарантии   - Соответствие - см. СерийныйУчет.ГарантияМесяцев.
//
// Возвращаемое значение:
//  Строка - перенос строки и текст или пустая строка.
//
Функция ДопСтрокаЧека(Ссылка, Выборка, СерииСтрок, Гарантии)
	Части = Новый Массив;
	Если Выборка.НомерСтрокиТоваров > 0 Тогда
		Ключ = Строка(Ссылка.УникальныйИдентификатор()) + "|" + Формат(Выборка.НомерСтрокиТоваров, "ЧГ=0");
		Номера = СерииСтрок[Ключ];
		Если Номера <> Неопределено Тогда
			Части.Добавить("IMEI: " + СтрСоединить(Номера, ", "));
		КонецЕсли;
	КонецЕсли;
	Месяцев = Гарантии[Выборка.Produit];
	Если Месяцев <> Неопределено Тогда
		Шаблон = НСтр("ru = 'гарантия: %1 мес.'; fr = 'garantie : %1 mois'; en = 'warranty: %1 months';
			|es = 'garantía: %1 meses'");
		Части.Добавить(СтрШаблон(Шаблон, Формат(Месяцев, "ЧГ=0")));
	КонецЕсли;
	Возврат ?(Части.Количество() = 0, "", Символы.ПС + СтрСоединить(Части, "; "));
КонецФункции

