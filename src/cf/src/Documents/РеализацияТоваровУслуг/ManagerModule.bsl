// КП из реализации: данные - из КП реализации (адаптер ДанныеФирменнойПечати), область печати и имя файла - по
// реализации. При включённой опции КП печатает документ КП.
//
// Параметры:
//  МассивОбъектов        - Массив - реализации.
//  ПараметрыПечати       - Структура - параметры команды печати.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - коллекция печатных форм.
//  ОбъектыПечати         - СписокЗначений - соответствие документов областям печати.
//
Процедура НапечататьКоммерческоеПредложение(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати)

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакетаКП()) Тогда
		ПроверитьДоступностьПечатиКП();
		ФирменнаяПечать.Напечатать(ИмяМакетаКП(), ВидФормыКП(), МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм,
			ОбъектыПечати);
	КонецЕсли;

КонецПроцедуры

// Отказ печати КП из реализации, если она недоступна (см. ПечатьКПДоступна): при включённой опции и роли без сумм.
// Вызывается и из адаптера ДанныеФирменнойПечати: общий механизм выбирает адаптер по типу ссылки, а не по менеджеру
// печати, поэтому проверка только в Печать обходилась бы передачей реализации менеджеру печати КП.
//
Процедура ПроверитьДоступностьПечатиКП()
	Если Документы.КоммерческоеПредложение.КПВводятсяВручную() Тогда
		ВызватьИсключение НСтр("ru = 'Включена опция «Коммерческие предложения»: коммерческое предложение печатает
			|документ «Коммерческое предложение».'; fr = 'L''option « Devis » est activée : le devis s''imprime
			|depuis le document « Devis ».'; en = 'The «Quotations» option is on: print the quotation from the
			|«Quotation» document.'; es = 'La opción «Presupuestos» está activada: el presupuesto se imprime desde
			|el documento «Presupuesto».'");
	КонецЕсли;
	Если Не ПечатьКПДоступна() Тогда
		ВызватьИсключение НСтр("ru = 'Печать коммерческого предложения из реализации недоступна вашей роли: в ней цены и
			|суммы.'; fr = 'L''impression du devis du bon de livraison n''est pas disponible pour votre rôle : il contient
			|des prix et des montants.'; en = 'Printing the quotation from the sales document is not available to your
			|role: it contains prices and amounts.'; es = 'La impresión del presupuesto del albarán no está disponible
			|para su rol: contiene precios e importes.'");
	КонецЕсли;
КонецПроцедуры

