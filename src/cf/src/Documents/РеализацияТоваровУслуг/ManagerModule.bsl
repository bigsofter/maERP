// Фирменные формы реализации под прежними именами макетов и названиями команд (docs/plans/branded-print.md, 10.7 и
// 11.3): варианты одного вида - параметрами команды, как прежние формы.
//
// Возвращаемое значение:
//  Массив из Структура - ИмяМакета, ВидФормы, Представление, Параметры (Структура - добавляются к параметрам команды).
//
Функция ВариантыФирменныхФорм()
	Варианты = Новый Массив;
	ИмяМакета = ИмяМакетаФактуры();
	ДобавитьВариант(Варианты, ИмяМакета, ВидФормыФактуры(), ПредставлениеФактуры());
	ИмяМакета = ИмяМакетаСчета();
	ДобавитьВариант(Варианты, ИмяМакета, ВидФормыПроформы(), ПредставлениеСчета(), Новый Структура("СчетаРеализаций", Истина));
	ВидНакладной = ВидФормыНакладной();
	Представление = НСтр("ru = 'Накладная BL'; fr = 'Bon de livraison'; en = 'Delivery note'; es = 'Albarán de entrega'");
	ДобавитьВариант(Варианты, "DevisBL", ВидНакладной, Представление);
	Представление = НСтр("ru = 'Накладная BL (A4)'; fr = 'Bon de livraison (A4)'; en = 'Delivery note (A4)';
		|es = 'Albarán de entrega (A4)'");
	ДобавитьВариант(Варианты, "BLA4", ВидНакладной, Представление);
	Представление = НСтр("ru = 'Накладная BL (A4, без НДС)'; fr = 'Bon de livraison (A4, hors TVA)';
		|en = 'Delivery note (A4, without VAT)'; es = 'Albarán de entrega (A4, sin IVA)'");
	ДобавитьВариант(Варианты, "BLA4БезНДС", ВидНакладной, Представление, Новый Структура("БезНДС", Истина));
	Представление = НСтр("ru = 'Накладная BL (A4, без цен)'; fr = 'Bon de livraison (A4, sans prix)';
		|en = 'Delivery note (A4, without prices)'; es = 'Albarán de entrega (A4, sin precios)'");
	ДобавитьВариант(Варианты, "BLA4БезЦен", ВидНакладной, Представление, Новый Структура("БезЦен", Истина));
	Представление = НСтр("ru = 'Акт об оказании услуг'; fr = 'Acte de prestation de services';
		|en = 'Act of provision of services'; es = 'Acta de prestación de servicios'");
	ДобавитьВариант(Варианты, "АктОбОказанииУслуг", ВидФормыАкта(), Представление);
	Возврат Варианты;
КонецФункции

Процедура ДобавитьВариант(Варианты, ИмяМакета, ВидФормы, Представление, Параметры = Неопределено)
	Вариант = Новый Структура;
	Вариант.Вставить("ИмяМакета", ИмяМакета);
	Вариант.Вставить("ВидФормы", ВидФормы);
	Вариант.Вставить("Представление", Представление);
	Вариант.Вставить("Параметры", Параметры);
	Варианты.Добавить(Вариант);
КонецПроцедуры

Функция ПараметрыВарианта(ПараметрыПечати, ПараметрыВарианта)
	// Параметры команды и параметры варианта формы - копией: переданная структура не меняется.
	Результат = Новый Структура;
	Если ТипЗнч(ПараметрыПечати) = Тип("Структура") Тогда
		Для Каждого Параметр Из ПараметрыПечати Цикл
			Результат.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(ПараметрыВарианта) = Тип("Структура") Тогда
		Для Каждого Параметр Из ПараметрыВарианта Цикл
			Результат.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Данные Facture, Proforma, BL и акта реализаций: шапки одним запросом, строки - общим запросом фирменной печати
// (docs/plans/branded-print.md, разделы 10.6 и 11.5). Номер Facture - как у прежней формы «номер/ГГ», группа строк -
// сама реализация («BL: …»); Proforma - номер документа без года и без группы, как прежний «Счёт на оплату»; BL -
// «цифровой номер/ГГ» и оплаты по документу, как прежние DevisBL и BL (A4); акт - только услуги, итоги по ним.
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.РеализацияТоваровУслуг - печатаемые реализации.
//  ВидФормы        - Строка - Facture, Proforma, BL или АктОбОказанииУслуг.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати (БезЦен, БезНДС: оплаты BL не нужны).
//
// Возвращаемое значение:
//  Соответствие - реализация -> источник печати (см. ФирменнаяПечать.ИсточникТоварногоДокумента).
//
Функция ДанныеТоварныхФорм(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати)
	ЭтоФактура = ВидФормы = ВидФормыФактуры();
	ЭтоНакладная = ВидФормы = ВидФормыНакладной();
	ЭтоАкт = ВидФормы = ВидФормыАкта();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Реализация.Ссылка КАК Ссылка,
	|	Реализация.Номер КАК НомерДокумента,
	|	Реализация.Дата КАК Дата,
	|	Реализация.Организация КАК Организация,
	|	Реализация.Контрагент КАК Контрагент,
	|	Реализация.Договор КАК Договор,
	|	Реализация.Валюта КАК Валюта,
	|	Реализация.ВВалюте КАК ВВалюте,
	|	Реализация.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Реализация.Сумма КАК Сумма,
	|	Реализация.СуммаНДС КАК СуммаНДС,
	|	Реализация.Комментарий КАК Комментарий,
	|	ВЫБОР
	|		КОГДА Реализация.Менеджер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(Реализация.Ответственный)
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Реализация.Менеджер)
	|	КОНЕЦ КАК Менеджер,
	|	ПРЕДСТАВЛЕНИЕ(Реализация.Ответственный) КАК Автор,
	|	Реализация.СуммаРегл КАК СуммаРегл,
	|	ЕСТЬNULL(Заказы.Номер, """") КАК НомерОснования,
	|	ЕСТЬNULL(Заказы.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОснования,
	|	ЕСТЬNULL(Контрагенты.Код, """") КАК КодКонтрагента,
	|	ЕСТЬNULL(Контрагенты.ПечатьНакладнойЦеныБезНДС, ЛОЖЬ) КАК ЦеныБезНДС,
	|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(Контрагенты.ТипОплаты), """") КАК ТипОплаты
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Реализация.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
	|		ПО Реализация.Основание = Заказы.Ссылка
	|ГДЕ
	|	Реализация.Ссылка В(&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	// Акт - только услуги, как прежний акт об оказании услуг.
	Строки = ФирменнаяПечать.ДанныеСтрокДокументов(Метаданные.Документы.РеализацияТоваровУслуг.Имя, Ссылки,
		?(ЭтоАкт, "ТЧУслуги", "ТЧТовары, ТЧУслуги"), ?(ЭтоФактура, "Ссылка", ""));
	НужныОплаты = ЭтоНакладная И ФирменнаяПечать.НужныОплаты(ПараметрыПечати);
	Кэш = ФирменнаяПечать.НовыйКэш();
	ПодписьЗаказа = НСтр("ru = 'Заказ'; fr = 'Commande'; en = 'Order'; es = 'Pedido'", КодЯзыка);
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Шапка = ФирменнаяПечать.НоваяШапкаДокумента();
		ЗаполнитьЗначенияСвойств(Шапка, Выборка);
		// Цены без НДС по признаку клиента печатала только Facture, остальные формы - как в документе.
		Шапка.ЦеныБезНДС = ЭтоФактура И Выборка.ЦеныБезНДС;
		Шапка.Номер = НомерФормы(ВидФормы, Выборка.НомерДокумента, Выборка.Дата);
		СтрокиДокумента = Строки[Выборка.Ссылка];
		Если ЭтоАкт Тогда
			// Прежний акт печатал договор основанием; договор выводят сведения документа.
			ФирменнаяПечать.ЗаполнитьИтогиПоСтрокам(Шапка, СтрокиДокумента);
		Иначе
			НомерОснования = РаботаСДокументами.СформироватьЦифровойНомер(Выборка.НомерОснования);
			Шапка.Основание = ФирменнаяПечать.ПредставлениеОснования(ПодписьЗаказа, НомерОснования,
				Выборка.ДатаОснования, КодЯзыка);
		КонецЕсли;
		Если Не ЭтоНакладная И Не ЭтоАкт Тогда
			Шапка.УсловияОплаты = ФирменнаяПечать.УсловияОплатыДокумента(Выборка.Ссылка, Выборка.ТипОплаты);
		КонецЕсли;
		Если НужныОплаты Тогда
			Шапка.Оплаты = ФирменнаяПечать.ОплатыДокумента(Выборка.Ссылка, Выборка.Контрагент, Выборка.СуммаРегл);
		КонецЕсли;
		ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента(ИмяФайлаФормы(ВидФормы), Выборка.НомерДокумента, Выборка.Дата);
		Источник = ФирменнаяПечать.ИсточникТоварногоДокумента(Шапка, СтрокиДокумента, Кэш, ИмяФайла);
		Результат.Вставить(Выборка.Ссылка, Источник);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НомерФормы(ВидФормы, Номер, Дата)
	// Номер - как печатала прежняя форма того же вида.
	Если ВидФормы = ВидФормыФактуры() Тогда
		НомерПечати = ФирменнаяПечать.НомерСчетаФактуры(Номер, Дата);
	ИначеЕсли ВидФормы = ВидФормыНакладной() Тогда
		НомерПечати = ФирменнаяПечать.НомерНакладной(Номер, Дата);
	ИначеЕсли ВидФормы = ВидФормыАкта() Тогда
		НомерПечати = РаботаСДокументами.СформироватьЦифровойНомер(Номер);
	Иначе
		НомерПечати = СокрЛП(Номер);
	КонецЕсли;
	Возврат НомерПечати;
КонецФункции

Функция ИмяФайлаФормы(ВидФормы)
	Если ВидФормы = ВидФормыФактуры() Тогда
		Имя = "Facture";
	ИначеЕсли ВидФормы = ВидФормыНакладной() Тогда
		Имя = "Bon de livraison";
	ИначеЕсли ВидФормы = ВидФормыАкта() Тогда
		Имя = "Acte";
	Иначе
		Имя = "Facture proforma";
	КонецЕсли;
	Возврат Имя;
КонецФункции

Процедура ЗаблокироватьРеализации(Ссылки)
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Ссылка Из Ссылки Цикл
		ЭлементБлокировки = Блокировка.Добавить("Документ.РеализацияТоваровУслуг");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	КонецЦикла;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ДанныеКПДоступныхРеализаций(Ссылки, ВидФормы, КодЯзыка)
	Результат = Новый Соответствие;
	Доступные = ДоступныеДляЧтения(Ссылки);
	Если Доступные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	МенеджерКП = Документы.КоммерческоеПредложение;
	Предложения = МенеджерКП.СинхронизироватьСРеализациями(Доступные);
	МассивКП = Новый Массив;
	Для Каждого КлючИЗначение Из Предложения Цикл
		МассивКП.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	// BSLLS:SetPrivilegedMode-off - читаются только КП, найденные протоколом по реализациям, доступным пользователю.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Попытка
		ИсточникиКП = МенеджерКП.ДанныеФирменнойПечати(МассивКП, ВидФормы, КодЯзыка, Новый Структура);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Для Каждого КлючИЗначение Из Предложения Цикл
		Источник = ИсточникиКП[КлючИЗначение.Значение];
		Если Источник <> Неопределено Тогда
			Результат.Вставить(КлючИЗначение.Ключ, Источник);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДоступныеДляЧтения(Ссылки)
	// Вне привилегированного режима: в протокол попадают только реализации, которые пользователь вправе читать вместе с
	// данными, которые КП печатает, - контрагентом, договором, организацией и номенклатурой. Адаптер КП читает их
	// привилегированно, поэтому ограничения записей (RLS) справочников проверяются здесь: роль «Клиент» читает
	// реализации без ограничения, а контрагентов и договоры - только свои (ai-security фазы 2, P0).
	Для Каждого ОбъектМетаданных Из ОбъектыДанныхПечатиКП() Цикл
		Если Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
			Возврат Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Реализации.Ссылка КАК Ссылка,
	|	Реализации.Организация КАК Организация,
	|	Реализации.Договор КАК Договор,
	|	Организации.Ссылка КАК ДоступнаяОрганизация,
	|	Договоры.Ссылка КАК ДоступныйДоговор
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Реализации.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО Реализации.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыСКонтрагентами КАК Договоры
	|		ПО Реализации.Договор = Договоры.Ссылка
	|ГДЕ
	|	Реализации.Ссылка В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	// Заполненные организация и договор, которых пользователь не вправе читать, РАЗРЕШЕННЫЕ соединение даёт NULL.
	Доступные = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОрганизацияДоступна = Не ЗначениеЗаполнено(Выборка.Организация) Или Выборка.ДоступнаяОрганизация <> NULL;
		ДоговорДоступен = Не ЗначениеЗаполнено(Выборка.Договор) Или Выборка.ДоступныйДоговор <> NULL;
		Если ОрганизацияДоступна И ДоговорДоступен Тогда
			Доступные.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Доступные;
КонецФункции

Функция ОбъектыДанныхПечатиКП()
	Объекты = Новый Массив;
	Объекты.Добавить(Метаданные.Документы.РеализацияТоваровУслуг);
	Объекты.Добавить(Метаданные.Справочники.Контрагенты);
	Объекты.Добавить(Метаданные.Справочники.ДоговорыСКонтрагентами);
	Объекты.Добавить(Метаданные.Справочники.Организации);
	Объекты.Добавить(Метаданные.Справочники.Номенклатура);
	Возврат Объекты;
КонецФункции

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	Если ВидФормы = "ФормаОбъекта" Тогда
		СтандартнаяОбработка = Ложь;
		Если ПараметрыСеанса.ПараметрыКлиентаНаСервере.ЭтоМобильныйКлиент Тогда
			ВыбраннаяФорма = "ФормаДокументаМобильныйКлиент";
		Иначе
			ВыбраннаяФорма = "ФормаДокумента";	
		КонецЕсли;	
	ИначеЕсли ВидФормы = "ФормаСписка" Тогда
		СтандартнаяОбработка = Ложь;
		Если ПараметрыСеанса.ПараметрыКлиентаНаСервере.ЭтоМобильныйКлиент Тогда
			ВыбраннаяФорма = "ФормаСпискаМобильныйКлиент";
		Иначе
			ВыбраннаяФорма = "ФормаСписка";	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти
