// Формы, снятые с меню «Печать» реализации по решению владельца 2026-11-01: в меню остаются только накладные BL и чеки.
// Код форм сохранён и печатается смоком, кнопки этих форм и печати заказа скрыты в формах документа. Чтобы вернуть
// форму, её убирают из списка и включают её кнопку в формах списка, документа и выбора.
//
// Возвращаемое значение:
//  Массив из Строка - имена макетов скрытых форм.
//
Функция МакетыСкрытыеВМеню()
	Макеты = Новый Массив;
	Макеты.Добавить(ИмяМакетаФактуры());
	Макеты.Добавить(ИмяМакетаСчета());
	Макеты.Добавить("АктОбОказанииУслуг");
	Макеты.Добавить(ИмяМакетаКП());
	Возврат Макеты;
КонецФункции

// Фирменные формы реализации под прежними именами макетов и названиями команд (docs/plans/branded-print.md, 10.7 и
// 11.3): варианты одного вида - параметрами команды, как прежние формы.
//
// Возвращаемое значение:
//  Массив из Структура - ИмяМакета, ИмяКоманды (команда печати документа), ВидФормы, Представление, Параметры
//                        (Структура - добавляются к параметрам команды).
//
Функция ВариантыФирменныхФорм()
	Варианты = Новый Массив;
	ИмяМакета = ИмяМакетаФактуры();
	ДобавитьВариант(Варианты, ИмяМакета, "ПечатьТоварнаяНакладная", ВидФормыФактуры(), ПредставлениеФактуры());
	ИмяМакета = ИмяМакетаСчета();
	ДобавитьВариант(Варианты, ИмяМакета, "ПечатьСчетНаОплату", ВидФормыПроформы(), ПредставлениеСчета(),
		Новый Структура("СчетаРеализаций", Истина));
	ВидНакладной = ВидФормыНакладной();
	Представление = НСтр("ru = 'Накладная BL'; fr = 'Bon de livraison'; en = 'Delivery note'; es = 'Albarán de entrega'");
	ДобавитьВариант(Варианты, "DevisBL", "ПечатьBL", ВидНакладной, Представление);
	Представление = НСтр("ru = 'Накладная BL (A4)'; fr = 'Bon de livraison (A4)'; en = 'Delivery note (A4)';
		|es = 'Albarán de entrega (A4)'");
	ДобавитьВариант(Варианты, "BLA4", "ПечатьBLA4", ВидНакладной, Представление);
	Представление = НСтр("ru = 'Накладная BL (A4, без НДС)'; fr = 'Bon de livraison (A4, hors TVA)';
		|en = 'Delivery note (A4, without VAT)'; es = 'Albarán de entrega (A4, sin IVA)'");
	ДобавитьВариант(Варианты, "BLA4БезНДС", "ПечатьBLA4HT", ВидНакладной, Представление, Новый Структура("БезНДС", Истина));
	Представление = НСтр("ru = 'Накладная BL (A4, без цен)'; fr = 'Bon de livraison (A4, sans prix)';
		|en = 'Delivery note (A4, without prices)'; es = 'Albarán de entrega (A4, sin precios)'");
	ДобавитьВариант(Варианты, "BLA4БезЦен", "ПечатьBLA4БезЦен", ВидНакладной, Представление,
		Новый Структура("БезЦен", Истина));
	Представление = НСтр("ru = 'Акт об оказании услуг'; fr = 'Acte de prestation de services';
		|en = 'Act of provision of services'; es = 'Acta de prestación de servicios'");
	ДобавитьВариант(Варианты, "АктОбОказанииУслуг", "АктОбОказанииУслуг", ВидФормыАкта(), Представление);
	Возврат Варианты;
КонецФункции

Процедура ДобавитьВариант(Варианты, ИмяМакета, ИмяКоманды, ВидФормы, Представление, Параметры = Неопределено)
	Вариант = Новый Структура;
	Вариант.Вставить("ИмяМакета", ИмяМакета);
	Вариант.Вставить("ИмяКоманды", ИмяКоманды);
	Вариант.Вставить("ВидФормы", ВидФормы);
	Вариант.Вставить("Представление", Представление);
	Вариант.Вставить("Параметры", Параметры);
	Варианты.Добавить(Вариант);
КонецПроцедуры

Функция ПараметрыВарианта(ПараметрыПечати, ПараметрыВарианта)
	// Параметры команды и параметры варианта формы - копией: переданная структура не меняется.
	Результат = Новый Структура;
	Если ТипЗнч(ПараметрыПечати) = Тип("Структура") Тогда
		Для Каждого Параметр Из ПараметрыПечати Цикл
			Результат.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(ПараметрыВарианта) = Тип("Структура") Тогда
		Для Каждого Параметр Из ПараметрыВарианта Цикл
			Результат.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Данные Facture, Proforma, BL и акта реализаций: шапки одним запросом, строки - общим запросом фирменной печати
// (docs/plans/branded-print.md, разделы 10.6 и 11.5). Номер Facture - как у прежней формы «номер/ГГ», группа строк -
// сама реализация («BL: …»); Proforma - номер документа без года и без группы, как прежний «Счёт на оплату»; BL -
// «цифровой номер/ГГ» и оплаты по документу, как прежние DevisBL и BL (A4); акт - только услуги, итоги по ним.
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.РеализацияТоваровУслуг - печатаемые реализации.
//  ВидФормы        - Строка - Facture, Proforma, BL или АктОбОказанииУслуг.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати (БезЦен, БезНДС: оплаты BL не нужны).
//
// Возвращаемое значение:
//  Соответствие - реализация -> источник печати (см. ФирменнаяПечать.ИсточникТоварногоДокумента).
//
Функция ДанныеТоварныхФорм(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати)
	ЭтоФактура = ВидФормы = ВидФормыФактуры();
	ЭтоНакладная = ВидФормы = ВидФормыНакладной();
	ЭтоАкт = ВидФормы = ВидФормыАкта();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Реализация.Ссылка КАК Ссылка,
	|	Реализация.Номер КАК НомерДокумента,
	|	Реализация.Дата КАК Дата,
	|	Реализация.Организация КАК Организация,
	|	Реализация.Контрагент КАК Контрагент,
	|	Реализация.Договор КАК Договор,
	|	Реализация.Валюта КАК Валюта,
	|	Реализация.ВВалюте КАК ВВалюте,
	|	Реализация.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Реализация.Сумма КАК Сумма,
	|	Реализация.СуммаНДС КАК СуммаНДС,
	|	Реализация.Комментарий КАК Комментарий,
	|	ВЫБОР
	|		КОГДА Реализация.Менеджер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(Реализация.Ответственный)
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Реализация.Менеджер)
	|	КОНЕЦ КАК Менеджер,
	|	ПРЕДСТАВЛЕНИЕ(Реализация.Ответственный) КАК Автор,
	|	Реализация.СуммаРегл КАК СуммаРегл,
	|	ЕСТЬNULL(Заказы.Номер, """") КАК НомерОснования,
	|	ЕСТЬNULL(Заказы.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОснования,
	|	ЕСТЬNULL(Контрагенты.Код, """") КАК КодКонтрагента,
	|	ЕСТЬNULL(Контрагенты.ПечатьНакладнойЦеныБезНДС, ЛОЖЬ) КАК ЦеныБезНДС,
	|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(Контрагенты.ТипОплаты), """") КАК ТипОплаты
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Реализация.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
	|		ПО Реализация.Основание = Заказы.Ссылка
	|ГДЕ
	|	Реализация.Ссылка В(&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	// Акт - только услуги, как прежний акт об оказании услуг.
	// BL - под строкой вес и дополнительные реквизиты товара (2.0.16.125).
	Строки = ФирменнаяПечать.ДанныеСтрокДокументов(Метаданные.Документы.РеализацияТоваровУслуг.Имя, Ссылки,
		?(ЭтоАкт, "ТЧУслуги", "ТЧТовары, ТЧУслуги"), ?(ЭтоФактура, "Ссылка", ""), , ?(ЭтоНакладная, КодЯзыка, ""));
	НужныОплаты = ЭтоНакладная И ФирменнаяПечать.НужныОплаты(ПараметрыПечати);
	Кэш = ФирменнаяПечать.НовыйКэш();
	ПодписьЗаказа = НСтр("ru = 'Заказ'; fr = 'Commande'; en = 'Order'; es = 'Pedido'", КодЯзыка);
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Шапка = ФирменнаяПечать.НоваяШапкаДокумента();
		ЗаполнитьЗначенияСвойств(Шапка, Выборка);
		// Цены без НДС по признаку клиента печатала только Facture, остальные формы - как в документе.
		Шапка.ЦеныБезНДС = ЭтоФактура И Выборка.ЦеныБезНДС;
		Шапка.Номер = НомерФормы(ВидФормы, Выборка.НомерДокумента, Выборка.Дата);
		СтрокиДокумента = Строки[Выборка.Ссылка];
		Если ЭтоАкт Тогда
			// Прежний акт печатал договор основанием; договор выводят сведения документа.
			ФирменнаяПечать.ЗаполнитьИтогиПоСтрокам(Шапка, СтрокиДокумента);
		Иначе
			НомерОснования = РаботаСДокументами.СформироватьЦифровойНомер(Выборка.НомерОснования);
			Шапка.Основание = ФирменнаяПечать.ПредставлениеОснования(ПодписьЗаказа, НомерОснования,
				Выборка.ДатаОснования, КодЯзыка);
		КонецЕсли;
		Если Не ЭтоНакладная И Не ЭтоАкт Тогда
			Шапка.УсловияОплаты = ФирменнаяПечать.УсловияОплатыДокумента(Выборка.Ссылка, Выборка.ТипОплаты);
		КонецЕсли;
		Если НужныОплаты Тогда
			Шапка.Оплаты = ФирменнаяПечать.ОплатыДокумента(Выборка.Ссылка, Выборка.Контрагент, Выборка.СуммаРегл);
		КонецЕсли;
		ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента(ИмяФайлаФормы(ВидФормы), Выборка.НомерДокумента, Выборка.Дата);
		Источник = ФирменнаяПечать.ИсточникТоварногоДокумента(Шапка, СтрокиДокумента, Кэш, ИмяФайла);
		Результат.Вставить(Выборка.Ссылка, Источник);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НомерФормы(ВидФормы, Номер, Дата)
	// Номер - как печатала прежняя форма того же вида.
	Если ВидФормы = ВидФормыФактуры() Тогда
		НомерПечати = ФирменнаяПечать.НомерСчетаФактуры(Номер, Дата);
	ИначеЕсли ВидФормы = ВидФормыНакладной() Тогда
		НомерПечати = ФирменнаяПечать.НомерНакладной(Номер, Дата);
	ИначеЕсли ВидФормы = ВидФормыАкта() Тогда
		НомерПечати = РаботаСДокументами.СформироватьЦифровойНомер(Номер);
	Иначе
		НомерПечати = СокрЛП(Номер);
	КонецЕсли;
	Возврат НомерПечати;
КонецФункции

Функция ИмяФайлаФормы(ВидФормы)
	Если ВидФормы = ВидФормыФактуры() Тогда
		Имя = "Facture";
	ИначеЕсли ВидФормы = ВидФормыНакладной() Тогда
		Имя = "Bon de livraison";
	ИначеЕсли ВидФормы = ВидФормыАкта() Тогда
		Имя = "Acte";
	Иначе
		Имя = "Facture proforma";
	КонецЕсли;
	Возврат Имя;
КонецФункции

Процедура ЗаблокироватьРеализации(Ссылки)
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Ссылка Из Ссылки Цикл
		ЭлементБлокировки = Блокировка.Добавить("Документ.РеализацияТоваровУслуг");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	КонецЦикла;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ДанныеКПДоступныхРеализаций(Ссылки, ВидФормы, КодЯзыка)
	Результат = Новый Соответствие;
	Доступные = ДоступныеДляЧтения(Ссылки);
	Если Доступные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	МенеджерКП = Документы.КоммерческоеПредложение;
	Предложения = МенеджерКП.СинхронизироватьСРеализациями(Доступные);
	МассивКП = Новый Массив;
	Для Каждого КлючИЗначение Из Предложения Цикл
		МассивКП.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	// BSLLS:SetPrivilegedMode-off - читаются только КП, найденные протоколом по реализациям, доступным пользователю.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Попытка
		ИсточникиКП = МенеджерКП.ДанныеФирменнойПечати(МассивКП, ВидФормы, КодЯзыка, Новый Структура);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Для Каждого КлючИЗначение Из Предложения Цикл
		Источник = ИсточникиКП[КлючИЗначение.Значение];
		Если Источник <> Неопределено Тогда
			Результат.Вставить(КлючИЗначение.Ключ, Источник);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДоступныеДляЧтения(Ссылки)
	// Вне привилегированного режима: в протокол попадают только реализации, которые пользователь вправе читать вместе с
	// данными, которые КП печатает, - контрагентом, договором, организацией и номенклатурой. Адаптер КП читает их
	// привилегированно, поэтому ограничения записей (RLS) справочников проверяются здесь: роль «Клиент» читает
	// реализации без ограничения, а контрагентов и договоры - только свои (ai-security фазы 2, P0).
	Для Каждого ОбъектМетаданных Из ОбъектыДанныхПечатиКП() Цикл
		Если Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
			Возврат Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Реализации.Ссылка КАК Ссылка,
	|	Реализации.Организация КАК Организация,
	|	Реализации.Договор КАК Договор,
	|	Организации.Ссылка КАК ДоступнаяОрганизация,
	|	Договоры.Ссылка КАК ДоступныйДоговор
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Реализации.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО Реализации.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыСКонтрагентами КАК Договоры
	|		ПО Реализации.Договор = Договоры.Ссылка
	|ГДЕ
	|	Реализации.Ссылка В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	// Заполненные организация и договор, которых пользователь не вправе читать, РАЗРЕШЕННЫЕ соединение даёт NULL.
	Доступные = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОрганизацияДоступна = Не ЗначениеЗаполнено(Выборка.Организация) Или Выборка.ДоступнаяОрганизация <> NULL;
		ДоговорДоступен = Не ЗначениеЗаполнено(Выборка.Договор) Или Выборка.ДоступныйДоговор <> NULL;
		Если ОрганизацияДоступна И ДоговорДоступен Тогда
			Доступные.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Доступные;
КонецФункции

Функция ОбъектыДанныхПечатиКП()
	Объекты = Новый Массив;
	Объекты.Добавить(Метаданные.Документы.РеализацияТоваровУслуг);
	Объекты.Добавить(Метаданные.Справочники.Контрагенты);
	Объекты.Добавить(Метаданные.Справочники.ДоговорыСКонтрагентами);
	Объекты.Добавить(Метаданные.Справочники.Организации);
	Объекты.Добавить(Метаданные.Справочники.Номенклатура);
	Возврат Объекты;
КонецФункции

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	Если ВидФормы = "ФормаОбъекта" Тогда
		СтандартнаяОбработка = Ложь;
		Если ПараметрыСеанса.ПараметрыКлиентаНаСервере.ЭтоМобильныйКлиент Тогда
			ВыбраннаяФорма = "ФормаДокументаМобильныйКлиент";
		Иначе
			ВыбраннаяФорма = "ФормаДокумента";	
		КонецЕсли;	
	ИначеЕсли ВидФормы = "ФормаСписка" Тогда
		СтандартнаяОбработка = Ложь;
		Если ПараметрыСеанса.ПараметрыКлиентаНаСервере.ЭтоМобильныйКлиент Тогда
			ВыбраннаяФорма = "ФормаСпискаМобильныйКлиент";
		Иначе
			ВыбраннаяФорма = "ФормаСписка";	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПределДокументовСтрокТоваров()

	// Как предел заказов «Продукции» рабочего места производства: больше - через отборы панели.
	// BSLLS:MagicNumber-off - предел объявлен этой функцией.
	Возврат 200;
	// BSLLS:MagicNumber-on

КонецФункции

// Строки товаров документов &Документы, свежие документы первыми.
//
// Параметры:
//  ЕстьОтборТовара - Булево - только строки товара &Товар.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаСтрокТоваров(ЕстьОтборТовара)

	Текст =
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Документ,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Проведен КАК Проведен,
	|	Д.ПометкаУдаления КАК ПометкаУдаления,
	|	Д.ВерсияДанных КАК ВерсияДанных,
	|	Д.Контрагент КАК Клиент,
	|	Д.Организация КАК Организация,
	|	Д.МестоХранения КАК Склад,
	|	Д.ВВалюте КАК ВВалюте,
	|	Д.Валюта КАК Валюта,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Упаковка КАК Упаковка,
	|	Т.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Т.Цена КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	Т.Серия КАК Серия,
	|	Т.УказаноНесколькоСерий КАК УказаноНесколькоСерий,
	|	Т.Ордер КАК Ордер
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ТЧТовары КАК Т
	|		ПО (Т.Ссылка = Д.Ссылка)
	|ГДЕ
	|	Д.Ссылка В (&Документы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Документ УБЫВ,
	|	НомерСтроки";
	Если ЕстьОтборТовара Тогда
		Текст = СтрЗаменить(Текст, "Д.Ссылка В (&Документы)", "Д.Ссылка В (&Документы)
		|	И Т.Номенклатура = &Товар");
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Последние документы по отборам закладки, свежие первыми.
//
// Параметры:
//  Отборы - Структура - см. НовыеОтборыСтрокТоваров.
//  Предел - Число - сколько документов прочитать.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.РеализацияТоваровУслуг - документы.
//
Функция ПоследниеДокументыПоОтборам(Отборы, Предел)

	Условия = Новый Массив;
	Условия.Добавить("ИСТИНА");
	Запрос = Новый Запрос;
	Для Каждого Имя Из СтрРазделить("Контрагент,Организация,МестоХранения,Ответственный", ",") Цикл
		Если ЗначениеЗаполнено(Отборы[Имя]) Тогда
			Условия.Добавить(СтрШаблон("Д.%1 = &%1", Имя));
			Запрос.УстановитьПараметр(Имя, Отборы[Имя]);
		КонецЕсли;
	КонецЦикла;
	Если Отборы.ХозяйственнаяОперация <> Неопределено Тогда
		Условия.Добавить("Д.ХозяйственнаяОперация = &ХозяйственнаяОперация");
		Запрос.УстановитьПараметр("ХозяйственнаяОперация", Отборы.ХозяйственнаяОперация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отборы.Товар) Тогда
		Условия.Добавить("Д.Ссылка В (ВЫБРАТЬ ТТ.Ссылка ИЗ Документ.РеализацияТоваровУслуг.ТЧТовары КАК ТТ ГДЕ ТТ.Номенклатура = &Товар)");
		Запрос.УстановитьПараметр("Товар", Отборы.Товар);
	КонецЕсли;
	// Роль со скрытыми суммами не отбирает по ним: иначе отбор раскрыл бы сумму (ревью безопасности).
	СуммыВидны = Не ФирменнаяПечать.ЦеныСкрыты();
	Если СуммыВидны И ЗначениеЗаполнено(Отборы.Сумма) Тогда
		Условия.Добавить("Д.Сумма " + ЗнакСравнения(Отборы.СуммаУсловие) + " &Сумма");
		Запрос.УстановитьПараметр("Сумма", Отборы.Сумма);
	КонецЕсли;
	СоединениеДолга = "";
	Если СуммыВидны И ЗначениеЗаполнено(Отборы.Долг) Тогда
		СоединениеДолга = "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки КАК Долги
		|		ПО (Долги.ОбъектРасчётов = Д.Ссылка)";
		Условия.Добавить("ЕСТЬNULL(Долги.СуммаОстаток, 0) " + ЗнакСравнения(Отборы.ДолгУсловие) + " &Долг");
		Запрос.УстановитьПараметр("Долг", Отборы.Долг);
	КонецЕсли;
	СкладРоли = СкладРолиPDV();
	Если СкладРоли <> Неопределено Тогда
		// Пустая настройка склада - пустой склад, как отбор списка: чужие склады не открываются (ревью безопасности).
		Условия.Добавить("Д.МестоХранения = &СкладРоли");
		Запрос.УстановитьПараметр("СкладРоли", СкладРоли);
	КонецЕсли;
	КонтрагентРоли = КонтрагентРолиКлиент();
	Если КонтрагентРоли <> Неопределено Тогда
		// Кабинет клиента - только его документы, пустой контрагент - ничего (ревью безопасности).
		Условия.Добавить("Д.Контрагент = &КонтрагентРоли");
		Запрос.УстановитьПараметр("КонтрагентРоли", КонтрагентРоли);
	КонецЕсли;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Д.Ссылка КАК Ссылка,
	|	Д.Дата КАК Дата
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Д" + СоединениеДолга + "
	|ГДЕ
	|	" + СтрСоединить(Условия, Символы.ПС + "	И ") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Ссылка УБЫВ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1", "ПЕРВЫЕ " + Формат(Предел, "ЧГ=0"));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Запреты правки документов (ТекстЗапретаПоПризнакам) одним запросом признаков и налоговыми накладными.
//
// Параметры:
//  Документы_ - Массив из ДокументСсылка.РеализацияТоваровУслуг - документы, прочитанные с правами пользователя.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ - документ, значение - текст запрета; пустая строка - правка допустима.
//
Функция ЗапретыПравкиДокументов(Документы_)

	Запреты = Новый Соответствие;
	Если Документы_.Количество() = 0 Тогда
		Возврат Запреты;
	КонецЕсли;
	// BSLLS:YoLetterUsage-off - имя табличной части в метаданных.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка,
	|	Д.Основание КАК Основание,
	|	Д.КассоваяСмена КАК КассоваяСмена,
	|	Д.Ссылка В
	|			(ВЫБРАТЬ
	|				У.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.РеализацияТоваровУслуг.ТЧУслуги КАК У
	|			ГДЕ
	|				У.Ссылка В (&Документы))
	|		ИЛИ Д.Ссылка В
	|			(ВЫБРАТЬ
	|				Р.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.РеализацияТоваровУслуг.ТЧДополнительныеРасходы КАК Р
	|			ГДЕ
	|				Р.Ссылка В (&Документы))
	|		ИЛИ Д.Ссылка В
	|			(ВЫБРАТЬ
	|				А.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.РеализацияТоваровУслуг.ТЧЗачётАвансов КАК А
	|			ГДЕ
	|				А.Ссылка В (&Документы)) КАК ЕстьПрочиеСтроки,
	|	Д.Ссылка В
	|			(ВЫБРАТЬ
	|				О.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.РеализацияТоваровУслуг.Основания КАК О
	|			ГДЕ
	|				О.Ссылка В (&Документы)) КАК НаОснованиях,
	|	Д.Ссылка В
	|			(ВЫБРАТЬ
	|				ТО.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.РеализацияТоваровУслуг.ТЧТовары КАК ТО
	|			ГДЕ
	|				ТО.Ссылка В (&Документы)
	|				И ТО.Ордер <> ЗНАЧЕНИЕ(Документ.РасходныйОрдер.ПустаяСсылка)) КАК ЕстьОрдера
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Д
	|ГДЕ
	|	Д.Ссылка В (&Документы)");
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Документы", Документы_);
	СНалоговой = РеализацииСНалоговойНакладной(Документы_);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЕстьНалоговая = СНалоговой.Найти(Выборка.Ссылка) <> Неопределено;
		Текст = ТекстЗапретаПоПризнакам(Выборка.Основание, Выборка.КассоваяСмена, Выборка.ЕстьПрочиеСтроки,
			Выборка.НаОснованиях, Выборка.ЕстьОрдера, ЕстьНалоговая);
		Запреты.Вставить(Выборка.Ссылка, Текст);
	КонецЦикла;
	Возврат Запреты;

КонецФункции

// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - строка товаров: Серия, УказаноНесколькоСерий, Ордер.
//
// Возвращаемое значение:
//  Булево - Истина, если у строки нет серий и расходного ордера.
//
Функция СтрокаБезСерийИОрдеров(Выборка)

	Возврат Не ЗначениеЗаполнено(Выборка.Серия) И Не Выборка.УказаноНесколькоСерий И Не ЗначениеЗаполнено(Выборка.Ордер);

КонецФункции

// Текст запрета правки документа с закладки: закладка ведёт только простую реализацию товаров целиком.
//
// Параметры:
//  Основание        - Произвольный - основание документа.
//  КассоваяСмена    - ДокументСсылка.КассоваяСмена - смена кассовой продажи.
//  ЕстьПрочиеСтроки - Булево - в документе есть услуги, доп. расходы или зачёт авансов.
//  НаОснованиях     - Булево - налоговый документ на основаниях.
//  ЕстьОрдера       - Булево - строки оформлены расходными ордерами.
//  ЕстьНалоговая    - Булево - по документу выписана налоговая накладная.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - правка допустима.
//
Функция ТекстЗапретаПоПризнакам(Основание, КассоваяСмена, ЕстьПрочиеСтроки, НаОснованиях, ЕстьОрдера, ЕстьНалоговая)

	Если ЗначениеЗаполнено(Основание) Или НаОснованиях Тогда
		Возврат НСтр("ru = 'Реализация оформлена на основании другого документа: правьте её в форме документа.';
			|fr = 'La vente est établie à partir d''un autre document : modifiez-la dans le document.';
			|en = 'The sale is based on another document: edit it in the document form.';
			|es = 'La venta se basa en otro documento: edítela en el documento.'");
	ИначеЕсли ЗначениеЗаполнено(КассоваяСмена) Тогда
		Возврат НСтр("ru = 'Кассовая продажа правится только на рабочем месте кассира.';
			|fr = 'Une vente de caisse se modifie uniquement au poste de caisse.';
			|en = 'A cash sale is edited only at the cashier workplace.';
			|es = 'Una venta de caja se edita solo en el puesto de cajero.'");
	ИначеЕсли ЕстьПрочиеСтроки Тогда
		Возврат НСтр("ru = 'В реализации есть услуги, доп. расходы или зачёт авансов: правьте её в форме документа.';
			|fr = 'La vente contient des services, des frais ou des avances imputées : modifiez-la dans le document.';
			|en = 'The sale has services, extra costs or advance offsets: edit it in the document form.';
			|es = 'La venta tiene servicios, gastos adicionales o anticipos compensados: edítela en el documento.'");
	ИначеЕсли ЕстьОрдера Тогда
		Возврат НСтр("ru = 'Реализация оформлена расходными ордерами склада: правьте её в форме документа.';
			|fr = 'La vente est établie par des bons de sortie : modifiez-la dans le document.';
			|en = 'The sale is issued by warehouse shipping orders: edit it in the document form.';
			|es = 'La venta está emitida por órdenes de salida: edítela en el documento.'");
	ИначеЕсли ЕстьНалоговая Тогда
		Возврат НСтр("ru = 'По реализации выписана налоговая накладная: документ только для просмотра.';
			|fr = 'Une facture fiscale est émise pour cette vente : document en lecture seule.';
			|en = 'A tax invoice is issued for this sale: the document is read-only.';
			|es = 'Se emitió una factura fiscal para esta venta: documento de solo lectura.'");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Текст запрета правки документа-объекта под блокировкой (те же правила, что при загрузке строк).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - документ.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - правка допустима.
//
Функция ТекстЗапретаПравки(ДокОбъект)

	Если ДокОбъект.ПометкаУдаления Тогда
		Возврат НСтр("ru = 'Реализация помечена на удаление: снимите пометку в списке.';
			|fr = 'La vente est marquée pour suppression : retirez la marque dans la liste.';
			|en = 'The sale is marked for deletion: clear the mark in the list.';
			|es = 'La venta está marcada para eliminar: quite la marca en la lista.'");
	КонецЕсли;
	ЕстьОрдера = Ложь;
	Для Каждого СтрокаТоваров Из ДокОбъект.ТЧТовары Цикл
		ЕстьОрдера = ЕстьОрдера Или ЗначениеЗаполнено(СтрокаТоваров.Ордер);
	КонецЦикла;
	// BSLLS:YoLetterUsage-off - имя табличной части в метаданных.
	ЕстьПрочиеСтроки = ДокОбъект.ТЧУслуги.Количество() > 0 Или ДокОбъект.ТЧДополнительныеРасходы.Количество() > 0
		Или ДокОбъект.ТЧЗачётАвансов.Количество() > 0;
	// BSLLS:YoLetterUsage-on
	ЕстьНалоговая = Не ДокОбъект.Ссылка.Пустая()
		И РеализацииСНалоговойНакладной(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокОбъект.Ссылка)).Количество() > 0;
	Возврат ТекстЗапретаПоПризнакам(ДокОбъект.Основание, ДокОбъект.КассоваяСмена, ЕстьПрочиеСтроки,
		НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ДокОбъект), ЕстьОрдера, ЕстьНалоговая);

КонецФункции

// Реализации, по которым выписана непомеченная налоговая накладная, - как проверка формы документа; независимо от права
// чтения налоговых накладных.
//
// Параметры:
//  Документы_ - Массив из ДокументСсылка.РеализацияТоваровУслуг - реализации.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.РеализацияТоваровУслуг - покрытые реализации.
//
Функция РеализацииСНалоговойНакладной(Документы_)

	Если Документы_.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	// Факт покрытия проверяется без права чтения налоговых накладных (ревью плана, круг 2): наружу - только подмножество
	// переданных реализаций, прочитанных с правами пользователя; реквизиты и ссылки накладных не возвращаются.
	// BSLLS:SetPrivilegedMode-off - узкая проверка факта связи, см. комментарий выше.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ОтгрузкаТовара КАК Реализация
	|ИЗ
	|	Документ.НалоговаяНакладная.ТЧТовары КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НалоговаяНакладная КАК Н
	|		ПО (Н.Ссылка = Т.Ссылка)
	|ГДЕ
	|	Т.ОтгрузкаТовара В (&Документы)
	|	И НЕ Н.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	У.ОтгрузкаТовара
	|ИЗ
	|	Документ.НалоговаяНакладная.ТЧУслуги КАК У
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НалоговаяНакладная КАК НУ
	|		ПО (НУ.Ссылка = У.Ссылка)
	|ГДЕ
	|	У.ОтгрузкаТовара В (&Документы)
	|	И НЕ НУ.ПометкаУдаления");
	Запрос.УстановитьПараметр("Документы", Документы_);
	Результат = Новый Массив;
	Для Каждого Реализация Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Реализация") Цикл
		Если Результат.Найти(Реализация) = Неопределено Тогда
			Результат.Добавить(Реализация);
		КонецЕсли;
	КонецЦикла;
	// BSLLS:SetPrivilegedMode-off - снятие режима, включённого выше.
	УстановитьПривилегированныйРежим(Ложь);
	// BSLLS:SetPrivilegedMode-on
	Возврат Результат;

КонецФункции

// Склад отбора роли PDV - как отбор списка «Реализаций» в форме.
//
// Возвращаемое значение:
//  СправочникСсылка.МестаХранения, Неопределено - склад пользователя роли PDV (пустой, если не задан - тогда ничего
//  не доступно); Неопределено - роль не PDV, без отбора.
//
Функция СкладРолиPDV()

	// BSLLS:IsInRoleMethod-off - тот же признак роли, что у отбора списка в ПриСозданииНаСервере формы.
	Если Не РольДоступна("PDV") Тогда
	// BSLLS:IsInRoleMethod-on
		Возврат Неопределено;
	КонецЕсли;
	Склад = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	Возврат ?(ЗначениеЗаполнено(Склад), Склад, Справочники.МестаХранения.ПустаяСсылка());

КонецФункции

// Роль «Клиент» (кабинет клиента) видит только документы своего контрагента - параметра сеанса, как
// ИнтерфейсКлиент.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты, Неопределено - контрагент пользователя роли (пустой, если не задан - тогда ничего
//  не доступно); Неопределено - роль не «Клиент», без отбора.
//
Функция КонтрагентРолиКлиент()

	// BSLLS:IsInRoleMethod-off - кабинет клиента привязан к роли, как ИнтерфейсКлиент.
	Если Не РольДоступна("Клиент") Тогда
	// BSLLS:IsInRoleMethod-on
		Возврат Неопределено;
	КонецЕсли;
	Контрагент = ПараметрыСеанса.Контрагент;
	Возврат ?(ЗначениеЗаполнено(Контрагент), Контрагент, Справочники.Контрагенты.ПустаяСсылка());

КонецФункции

// Роль PDV работает только со своим складом - как отбор списка в форме (ревью безопасности): чтение шапки, выбор
// документа, новая строка и правка под блокировкой.
//
// Параметры:
//  Склад - СправочникСсылка.МестаХранения - склад документа или строки.
//
// Возвращаемое значение:
//  Булево - Истина, если склад не склад пользователя роли PDV.
//
Функция СкладЗапрещенРоли(Склад)

	СкладРоли = СкладРолиPDV();
	Возврат СкладРоли <> Неопределено И Склад <> СкладРоли;

КонецФункции

// Параметры:
//  Позиция - Число - 0 - больше, 1 - меньше, 2 - равно (тумблер панели).
//
// Возвращаемое значение:
//  Строка - знак сравнения языка запросов.
//
Функция ЗнакСравнения(Позиция)

	// BSLLS:MagicNumber-off - значения объявлены списком выбора тумблера знака на форме.
	Если Позиция = 1 Тогда
		Возврат "<";
	ИначеЕсли Позиция = 2 Тогда
		Возврат "=";
	Иначе
		Возврат ">";
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецФункции

Функция ПредставлениеДокументаСтроки(Номер, Дата)

	Возврат СтрШаблон(НСтр("ru = '№ %1 от %2'; fr = 'N° %1 du %2'; en = 'No. %1 of %2'; es = 'N.º %1 del %2'"),
		СокрЛП(Номер), Формат(Дата, "ДЛФ=D"));

КонецФункции

// Индекс картинки строки в общей картинке СостоянияОбъекта (как в списке документов).
//
// Параметры:
//  Проведен        - Булево - документ проведён.
//  ПометкаУдаления - Булево - документ помечен на удаление.
//
// Возвращаемое значение:
//  Число - 0 - проведён, 1 - помечен на удаление, 2 - записан.
//
Функция КартинкаСостоянияДокумента(Проведен, ПометкаУдаления)

	Если ПометкаУдаления Тогда
		Возврат 1;
	ИначеЕсли Проведен Тогда
		Возврат 0;
	Иначе
		Возврат 2;
	КонецЕсли;

КонецФункции

// Контрагент документа клиента: головной у обособленного подразделения (ПолучитьДанныеКонтрагента, как форма).
//
// Параметры:
//  Клиент      - СправочникСсылка.Контрагенты - клиент строки.
//  Организация - СправочникСсылка.Организации - организация.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты - контрагент документа.
//
Функция КонтрагентДокумента(Клиент, Организация)

	Данные = ОбщегоНазначенияВызовСервера.ПолучитьДанныеКонтрагента(Клиент, Организация,
		Перечисления.ВидыДоговоров.СПокупателем, ТекущаяДатаСеанса());
	Возврат ?(ЗначениеЗаполнено(Данные.Контрагент), Данные.Контрагент, Клиент);

КонецФункции

// Валюта договора клиента с организацией: не основная - валюта нового документа (как ЗаполнитьВалютуПоДоговору формы).
//
// Параметры:
//  Клиент      - СправочникСсылка.Контрагенты - клиент.
//  Организация - СправочникСсылка.Организации - организация.
//
// Возвращаемое значение:
//  СправочникСсылка.Валюты - валюта договора или основная.
//
Функция ВалютаДоговораКлиента(Клиент, Организация)

	Основная = РаботаСВалютами.ОсновнаяВалюта();
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат Основная;
	КонецЕсли;
	Данные = ОбщегоНазначенияВызовСервера.ПолучитьДанныеКонтрагента(Клиент, Организация,
		Перечисления.ВидыДоговоров.СПокупателем, ТекущаяДатаСеанса());
	Если Не ЗначениеЗаполнено(Данные.Договор) Тогда
		Возврат Основная;
	КонецЕсли;
	ВалютаДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Договор, "ВалютаВзаиморасчётов");
	Возврат ?(ЗначениеЗаполнено(ВалютаДоговора), ВалютаДоговора, Основная);

КонецФункции

Функция НовыйРезультатЗаписиСтрок()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("Документ", Неопределено);
	Результат.Вставить("НомерСтроки", 0);
	Результат.Вставить("Конфликт", Ложь);
	Возврат Результат;

КонецФункции

// Проверка пакета строк до блокировок: типы, один документ на пакет, новая строка - по одной, права, обязательные
// значения, серийный товар и ордерный склад нового документа.
//
// Параметры:
//  Строки - Массив из Структура - см. ЗаписатьСтрокиТоваров.
//
// Возвращаемое значение:
//  Строка - текст отказа; пустая строка - пакет можно записывать.
//
Функция ТекстЗапретаДанныхСтрок(Строки)

	Если Не МожноВводитьСтрокиТоваров() Тогда
		Возврат НСтр("ru = 'Нет права вводить и проводить реализации.'; fr = 'Aucun droit de saisir et valider des ventes.';
			|en = 'No right to enter and post sales.'; es = 'Sin derecho a introducir y contabilizar ventas.'");
	КонецЕсли;
	Если ТипЗнч(Строки) <> Тип("Массив") Или Строки.Количество() = 0 Тогда
		Возврат ТекстНеверныеДанные();
	КонецЕсли;
	Если Не ТипыСтрокиВерны(Строки[0]) Тогда
		Возврат ТекстНеверныеДанные();
	КонецЕсли;
	Документ = Строки[0].Документ;
	Для Каждого Строка Из Строки Цикл
		// Пакет - строки одного записанного документа; новая реализация - одна строка.
		ЧужаяСтрока = Не ТипыСтрокиВерны(Строка) Или Строка.Документ <> Документ
			Или Не ЗначениеЗаполнено(Документ) И Строки.Количество() > 1;
		Если ЧужаяСтрока Тогда
			Возврат ТекстНеверныеДанные();
		КонецЕсли;
		Текст = ТекстЗапретаЗначенийСтроки(Строка);
		Если Не ПустаяСтрока(Текст) Тогда
			Возврат Текст;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат ТекстЗапретаНовогоДокумента(Строки[0]);
	КонецЕсли;
	Возврат "";

КонецФункции

// Параметры:
//  Строка - Произвольный - строка удаления от клиента.
//
// Возвращаемое значение:
//  Булево - Истина, если это структура с записанным документом-реализацией.
//
Функция ЗаписанныйДокументСтроки(Строка)

	Документ = Неопределено;
	Если ТипЗнч(Строка) <> Тип("Структура") Или Не Строка.Свойство("Документ", Документ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И ЗначениеЗаполнено(Документ);

КонецФункции

Функция ТипыСтрокиВерны(Строка)

	Если ТипЗнч(Строка) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Типы = Новый Структура;
	ТипЧисло = Новый ОписаниеТипов("Число");
	Типы.Вставить("НомерСтроки", ТипЧисло);
	Типы.Вставить("ВерсияДанных", Новый ОписаниеТипов("Строка"));
	Типы.Вставить("Клиент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Типы.Вставить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Типы.Вставить("Склад", Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
	Типы.Вставить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Типы.Вставить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Типы.Вставить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Типы.Вставить("КоличествоУпаковок", ТипЧисло);
	Типы.Вставить("Цена", ТипЧисло);
	Типы.Вставить("ЦенаИзменена", Новый ОписаниеТипов("Булево"));
	Типы.Вставить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Документ = Неопределено;
	Если Не Строка.Свойство("Документ", Документ)
		Или Документ <> Неопределено И ТипЗнч(Документ) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Типы Цикл
		Значение = Неопределено;
		Если Не Строка.Свойство(КлючИЗначение.Ключ, Значение) Или Не КлючИЗначение.Значение.СодержитТип(ТипЗнч(Значение)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Строка.НомерСтроки >= 0 И Строка.Цена >= 0 И Цел(Строка.НомерСтроки) = Строка.НомерСтроки;

КонецФункции

Функция ТекстЗапретаЗначенийСтроки(Строка)

	Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
		Возврат НСтр("ru = 'Выберите товар.'; fr = 'Choisissez l''article.'; en = 'Select the item.'; es = 'Elija el artículo.'");
	ИначеЕсли Строка.КоличествоУпаковок <= 0 Тогда
		Возврат НСтр("ru = 'Количество должно быть больше нуля.'; fr = 'La quantité doit être supérieure à zéro.';
			|en = 'The quantity must be greater than zero.'; es = 'La cantidad debe ser mayor que cero.'");
	ИначеЕсли ЗначениеЗаполнено(Строка.Характеристика)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Характеристика, "Владелец") <> Строка.Номенклатура Тогда
		Возврат НСтр("ru = 'Характеристика не относится к товару.'; fr = 'La caractéristique n''appartient pas à l''article.';
			|en = 'The characteristic does not belong to the item.'; es = 'La característica no pertenece al artículo.'");
	ИначеЕсли Строка.НомерСтроки = 0 И СерийныйУчет.ЭтоСерийнаяНоменклатура(Строка.Номенклатура) Тогда
		// Серия серийного товара обязательна, в строке закладки её нет.
		Возврат НСтр("ru = 'Товар с серийными номерами (IMEI) вводится в форме документа.';
			|fr = 'Un article à numéros de série (IMEI) se saisit dans le document.';
			|en = 'An item with serial numbers (IMEI) is entered in the document form.';
			|es = 'Un artículo con números de serie (IMEI) se introduce en el documento.'");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

Функция ТекстЗапретаНовогоДокумента(Строка)

	Если Не ЗначениеЗаполнено(Строка.Клиент) Тогда
		Возврат НСтр("ru = 'Выберите клиента.'; fr = 'Choisissez le client.'; en = 'Select the customer.'; es = 'Elija el cliente.'");
	ИначеЕсли Не ЗначениеЗаполнено(Строка.Склад) Или СкладЗапрещенРоли(Строка.Склад) Тогда
		Возврат НСтр("ru = 'Выберите склад.'; fr = 'Choisissez l''entrepôt.'; en = 'Select the warehouse.'; es = 'Elija el almacén.'");
	ИначеЕсли Справочники.МестаХранения.ОрдерныйСклад(Строка.Склад, ТекущаяДатаСеанса()) Тогда
		// Строки реализации на ордерном складе - только по расходным ордерам (ОрдераСклада.ПроверитьОформление).
		Возврат НСтр("ru = 'Склад ордерный: отгрузка оформляется расходным ордером.';
			|fr = 'Entrepôt à bons : l''expédition se fait par un bon de sortie.';
			|en = 'Order-based warehouse: the shipment is issued by a shipping order.';
			|es = 'Almacén por órdenes: el envío se emite con una orden de salida.'");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Новая реализация по строке: шапка как у формы документа при выборе клиента, строка, проведение. Отказ проведения -
// документ не создаётся (строка остаётся для правки).
//
// Параметры:
//  Строка    - Структура - см. ЗаписатьСтрокиТоваров.
//  Результат - Структура - см. НовыйРезультатЗаписиСтрок.
//
Процедура ЗаписатьНовуюРеализацию(Строка, Результат)

	ДокОбъект = СоздатьДокумент();
	Результат.Текст = ЗаполнитьШапкуНовойРеализации(ДокОбъект, Строка.Клиент, Строка.Организация, Строка.Склад);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		Возврат;
	КонецЕсли;
	СтрокаТоваров = ПрименитьСтроку(ДокОбъект, Строка, Результат);
	Если СтрокаТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат.НомерСтроки = СтрокаТоваров.НомерСтроки;
	ЗаписатьДокумент(ДокОбъект, Истина, Результат);

КонецПроцедуры

// Шапка новой реализации - как форма документа: реквизиты по умолчанию, клиент и договор (ЗаполнитьДанныеПоТорговойТочке),
// вид цен и режим НДС (УстановитьВидЦеныПоДоговору), валюта договора (ЗаполнитьВалютуПоДоговору).
//
// Параметры:
//  ДокОбъект   - ДокументОбъект.РеализацияТоваровУслуг - новый документ.
//  Клиент      - СправочникСсылка.Контрагенты - клиент.
//  Организация - СправочникСсылка.Организации - организация; пустая - по умолчанию.
//  Склад       - СправочникСсылка.МестаХранения - склад.
//
// Возвращаемое значение:
//  Строка - текст отказа; пустая строка - шапка заполнена.
//
Функция ЗаполнитьШапкуНовойРеализации(ДокОбъект, Клиент, Организация, Склад)

	ДокОбъект.Заполнить(Неопределено);
	ДокОбъект.Дата = ТекущаяДатаСеанса();
	ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Если ЗначениеЗаполнено(Организация) Тогда
		ДокОбъект.Организация = Организация;
	КонецЕсли;
	ДокОбъект.МестоХранения = Склад;
	ДокОбъект.Контрагент = Клиент;
	ДанныеКлиента = ОбщегоНазначенияВызовСервера.ПолучитьДанныеКонтрагента(Клиент, ДокОбъект.Организация,
		Перечисления.ВидыДоговоров.СПокупателем, ДокОбъект.Дата);
	// Как ЗаполнитьДанныеПоТорговойТочке формы: у обособленного подразделения контрагент документа - головной.
	ЗаполнитьЗначенияСвойств(ДокОбъект, ДанныеКлиента, "Контрагент, Договор, Менеджер");
	Если Не ЗначениеЗаполнено(ДокОбъект.Контрагент) Тогда
		ДокОбъект.Контрагент = Клиент;
	КонецЕсли;
	Если ОтгрузкаЗапрещена(ДокОбъект) Тогда
		Возврат ТекстЗапретаОтгрузки();
	КонецЕсли;
	// Вид цен - по итоговому контрагенту, как УстановитьВидЦеныПоДоговору формы после ЗаполнитьДанныеПоТорговойТочке.
	ДокОбъект.ВидЦен = ОбщегоНазначенияВызовСервера.ВидЦеныПродажиПоУмолчанию(ДокОбъект.Контрагент, Склад);
	ДокОбъект.ЦенаВключаетНДС = ОбщегоНазначенияВызовСервера.ЦенаВключаетНДСПоВидуЦен(ДокОбъект.ВидЦен);
	ДокОбъект.Валюта = РаботаСВалютами.ОсновнаяВалюта();
	ДокОбъект.КурсВалюты = 1;
	ВалютаДоговора = ВалютаДоговораКлиента(Клиент, ДокОбъект.Организация);
	Если ВалютаДоговора <> ДокОбъект.Валюта Тогда
		Курс = РаботаСВалютами.КурсВалюты(ВалютаДоговора, ДокОбъект.Дата);
		Если Курс = 0 Тогда
			Возврат РаботаСВалютами.ТекстКурсНеЗадан(ВалютаДоговора, ДокОбъект.Дата);
		КонецЕсли;
		ДокОбъект.ВВалюте = Истина;
		ДокОбъект.Валюта = ВалютаДоговора;
		ДокОбъект.КурсВалюты = Курс;
	КонецЕсли;
	Возврат "";

КонецФункции

// Версия документа, с которой прочитаны записанные строки пакета (ревью кода, круг 1): у новых строк в записанный
// документ версии нет - пакет из одних новых строк версию не сверяет.
//
// Параметры:
//  Строки - Массив из Структура - см. ЗаписатьСтрокиТоваров.
//
// Возвращаемое значение:
//  Строка, Неопределено - версия первой записанной строки; Неопределено - записанных строк нет.
//
Функция ВерсияПакета(Строки)

	Для Каждого Строка Из Строки Цикл
		Если Строка.НомерСтроки <> 0 Тогда
			Возврат Строка.ВерсияДанных;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - документ с итоговым контрагентом.
//
// Возвращаемое значение:
//  Булево - отгружать контрагенту документа на дату документа запрещено (как проверка формы документа).
//
Функция ОтгрузкаЗапрещена(ДокОбъект)

	Дата = ?(ЗначениеЗаполнено(ДокОбъект.Дата), ДокОбъект.Дата, ТекущаяДатаСеанса());
	Возврат РаботаСДокументамиВызовСервера.КлиентуЗапрещеноОтгружать(ДокОбъект.Контрагент, Дата);

КонецФункции

Функция ТекстЗапретаОтгрузки()

	Возврат НСтр("ru = 'Запрещено отгружать этому клиенту: есть неоплаченные отгрузки сверх отсрочки и кредита по договору.';
		|fr = 'Expédition interdite à ce client : des expéditions impayées dépassent le délai et le crédit du contrat.';
		|en = 'Shipping to this customer is forbidden: unpaid shipments exceed the deferral and credit of the agreement.';
		|es = 'Envío prohibido a este cliente: hay envíos impagados que superan el aplazamiento y el crédito del contrato.'");

КонецФункции

// Блокирует документ пакета и сверяет версию данных и правила правки.
//
// Параметры:
//  Документ     - ДокументСсылка.РеализацияТоваровУслуг - документ.
//  ВерсияДанных - Строка, Неопределено - версия, прочитанная вместе со строками; Неопределено - только новые строки:
//                 чужая правка документа им не мешает, правила правки перепроверяются под блокировкой.
//  Результат    - Структура - см. НовыйРезультатЗаписиСтрок, получает отказ.
//
// Возвращаемое значение:
//  ДокументОбъект.РеализацияТоваровУслуг, Неопределено - заблокированный объект; отказ - Неопределено.
//
Функция ЗаблокированныйДокумент(Документ, ВерсияДанных, Результат)

	ДокОбъект = Документ.ПолучитьОбъект();
	Если ДокОбъект = Неопределено Тогда
		Результат.Конфликт = Истина;
		Результат.Текст = ТекстДокументИзменен();
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ДокОбъект.Заблокировать();
	Исключение
		Результат.Текст = ТекстНеЗаписано(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	Если ВерсияДанных <> Неопределено И ДокОбъект.ВерсияДанных <> ВерсияДанных Тогда
		ДокОбъект.Разблокировать();
		Результат.Конфликт = Истина;
		Результат.Текст = ТекстДокументИзменен();
		Возврат Неопределено;
	КонецЕсли;
	Результат.Текст = ТекстЗапретаПравки(ДокОбъект);
	Если ПустаяСтрока(Результат.Текст) И СкладЗапрещенРоли(ДокОбъект.МестоХранения) Тогда
		Результат.Текст = ТекстНеверныеДанные();
	КонецЕсли;
	Если ПустаяСтрока(Результат.Текст) И ОтгрузкаЗапрещена(ДокОбъект) Тогда
		// Как ПередЗаписью формы документа: запрет отгрузки проверяется при каждой записи (ревью плана, круг 7).
		Результат.Текст = ТекстЗапретаОтгрузки();
	КонецЕсли;
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		ДокОбъект.Разблокировать();
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДокОбъект;

КонецФункции

// Переносит строку закладки в документ: новая строка - товар с ценой и ставкой НДС как в форме документа; записанная -
// количество (цена прежняя), смена упаковки или характеристики - цена заново. Ручная цена - при праве заверения цен.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - документ.
//  Строка    - Структура - см. ЗаписатьСтрокиТоваров.
//  Результат - Структура - см. НовыйРезультатЗаписиСтрок, получает отказ.
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти, Неопределено - строка товаров документа; отказ - Неопределено.
//
Функция ПрименитьСтроку(ДокОбъект, Строка, Результат)

	Упаковка = Строка.Упаковка;
	Если Не ЗначениеЗаполнено(Упаковка) Тогда
		Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Номенклатура, "Единица");
	КонецЕсли;
	Если Строка.НомерСтроки = 0 Тогда
		СтрокаТоваров = ДокОбъект.ТЧТовары.Добавить();
		СтрокаТоваров.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ДокОбъект.ТЧТовары);
		СтрокаТоваров.Номенклатура = Строка.Номенклатура;
		// Пустой вид цен существующего документа - как форма при его открытии (ревью плана, круг 3).
		СтрокаТоваров.ВидЦены = ?(ЗначениеЗаполнено(ДокОбъект.ВидЦен), ДокОбъект.ВидЦен,
			ОбщегоНазначенияВызовСервера.ВидЦеныПродажиПоУмолчанию(ДокОбъект.Контрагент, ДокОбъект.МестоХранения));
		НужнаЦена = Истина;
	Иначе
		СтрокаТоваров = ЗаписаннаяСтрокаТоваров(ДокОбъект, Строка, Результат);
		Если СтрокаТоваров = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		НужнаЦена = СтрокаТоваров.Упаковка <> Упаковка Или СтрокаТоваров.Характеристика <> Строка.Характеристика;
	КонецЕсли;
	Накопленные = ТекстСообщений();
	СтрокаТоваров.Характеристика = Строка.Характеристика;
	СообщенияЦены = ЗаполнитьЦенуСтроки(ДокОбъект, СтрокаТоваров, Строка, Упаковка, НужнаЦена);
	Если Не ПустаяСтрока(СообщенияЦены) Тогда
		Шаблон = НСтр("ru = 'Цена не подставлена: %1'; fr = 'Prix non renseigné : %1'; en = 'Price not set: %1';
			|es = 'Precio no asignado: %1'");
		Результат.Текст = СоединитьТексты(Накопленные, СтрШаблон(Шаблон, СообщенияЦены));
		Возврат Неопределено;
	КонецЕсли;
	Если Не ПустаяСтрока(Накопленные) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Накопленные);
	КонецЕсли;
	Если Не ПрименитьРучнуюЦену(ДокОбъект, СтрокаТоваров, Строка, Результат) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СтрокаТоваров;

КонецФункции

// Данные номенклатуры, упаковка, количество и цена строки. Сообщения подстановки цены - отказ (ревью плана, круг 5): без
// курса валюты прайса цена остаётся непересчитанной.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.РеализацияТоваровУслуг - документ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка товаров.
//  Строка        - Структура - см. ЗаписатьСтрокиТоваров.
//  Упаковка      - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка строки.
//  НужнаЦена     - Булево - цена подставляется заново.
//
// Возвращаемое значение:
//  Строка - сообщения подстановки цены; пустая строка - цена подставлена.
//
Функция ЗаполнитьЦенуСтроки(ДокОбъект, СтрокаТоваров, Строка, Упаковка, НужнаЦена)

	Если Строка.НомерСтроки = 0 Тогда
		// Та же функция, что у формы документа при выборе товара: ставка НДС и данные номенклатуры. Упаковкой она ставит
		// единицу товара - выбранная упаковка восстанавливается ниже (ревью плана, круг 2).
		РаботаСДокументамиКлиентСервер.УстановитьПараметрыНоменклатуры(СтрокаТоваров, ДокОбъект);
	КонецЕсли;
	СтрокаТоваров.Упаковка = Упаковка;
	СтрокаТоваров.КоличествоУпаковок = Строка.КоличествоУпаковок;
	Если НужнаЦена Тогда
		// Как форма при смене упаковки: цена прайса за упаковку и количество в базовых единицах.
		РаботаСДокументамиКлиентСервер.УстановитьЦенуНоменклатуры(СтрокаТоваров, ДокОбъект);
	Иначе
		// Только количество: цена упаковки прежняя. Историческая строка без цены базовой единицы - от цены, иначе расчёт
		// пересчитал бы цену из нулевой ЦенаSKU (ревью плана, круги 7 и 9; так же рабочее место производства).
		Если СтрокаТоваров.ЦенаSKU = 0 И СтрокаТоваров.Цена <> 0 Тогда
			РассчитатьОтЦеныСоСкидкой(СтрокаТоваров, ДокОбъект.ЦенаВключаетНДС);
		Иначе
			РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ДокОбъект.ЦенаВключаетНДС);
		КонецЕсли;
	КонецЕсли;
	Возврат ТекстСообщений();

КонецФункции

// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - документ.
//  Строка    - Структура - см. ЗаписатьСтрокиТоваров.
//
// Возвращаемое значение:
//  Булево - записанная строка с теми же товаром, характеристикой, упаковкой и количеством, цена не вводилась.
//
Функция СтрокаБезИзменений(ДокОбъект, Строка)

	Если Строка.НомерСтроки = 0 Или Строка.НомерСтроки > ДокОбъект.ТЧТовары.Количество() Или Строка.ЦенаИзменена Тогда
		Возврат Ложь;
	КонецЕсли;
	СтрокаТоваров = ДокОбъект.ТЧТовары[Строка.НомерСтроки - 1];
	Возврат СтрокаТоваров.Номенклатура = Строка.Номенклатура И СтрокаТоваров.Характеристика = Строка.Характеристика
		И СтрокаТоваров.Упаковка = Строка.Упаковка И СтрокаТоваров.КоличествоУпаковок = Строка.КоличествоУпаковок;

КонецФункции

// Расчёт строки от цены упаковки с сохранением процента скидки, как ПрименитьДанныеСтрокиОтгрузки рабочего места
// производства: расчёт от цены берёт процент из скидки на цену - она пересчитывается от процента, затем процент
// восстанавливается и строка досчитывается (ревью плана, круг 9).
//
// Параметры:
//  СтрокаТоваров   - СтрокаТабличнойЧасти - строка товаров с ценой упаковки.
//  ЦенаВключаетНДС - Булево - режим НДС документа.
//
Процедура РассчитатьОтЦеныСоСкидкой(СтрокаТоваров, ЦенаВключаетНДС)

	ПроцентСкидки = СтрокаТоваров.ПроцентСкидки;
	СтрокаТоваров.СкидкаНаЦену = СтрокаТоваров.Цена / РаботаСДокументамиКлиентСервер.СтоПроцентов() * ПроцентСкидки;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ЦенаВключаетНДС, "Цена");
	СтрокаТоваров.ПроцентСкидки = ПроцентСкидки;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ЦенаВключаетНДС);

КонецПроцедуры

// Ручная цена строки - при праве заверения цен и в валюте, которую видел пользователь (ревью плана, круг 6).
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.РеализацияТоваровУслуг - документ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка товаров.
//  Строка        - Структура - см. ЗаписатьСтрокиТоваров.
//  Результат     - Структура - см. НовыйРезультатЗаписиСтрок, получает отказ.
//
// Возвращаемое значение:
//  Булево - Ложь, если валюта цены не совпала с валютой документа.
//
Функция ПрименитьРучнуюЦену(ДокОбъект, СтрокаТоваров, Строка, Результат)

	Если Не Строка.ЦенаИзменена Или Не РегистрыСведений.НастройкиПользователей.ЗаверениеЦен() Тогда
		Возврат Истина;
	КонецЕсли;
	ВалютаДокумента = РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Валюта;
	Если Строка.Валюта <> ВалютаДокумента Тогда
		Шаблон = НСтр("ru = 'Валюта накладной - %1: введите цену заново.'; fr = 'Devise de la vente : %1 : saisissez à nouveau le prix.';
			|en = 'The sale currency is %1: enter the price again.'; es = 'La moneda de la venta es %1: introduzca el precio de nuevo.'");
		Результат.Текст = СтрШаблон(Шаблон, ВалютаДокумента);
		Возврат Ложь;
	КонецЕсли;
	СтрокаТоваров.Цена = Строка.Цена;
	РассчитатьОтЦеныСоСкидкой(СтрокаТоваров, ДокОбъект.ЦенаВключаетНДС);
	Возврат Истина;

КонецФункции

// Записанная строка товаров документа по номеру: товар тот же, серий нет.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - документ.
//  Строка    - Структура - см. ЗаписатьСтрокиТоваров.
//  Результат - Структура - см. НовыйРезультатЗаписиСтрок, получает отказ.
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти, Неопределено - строка; отказ - Неопределено.
//
Функция ЗаписаннаяСтрокаТоваров(ДокОбъект, Строка, Результат)

	СтрокаТоваров = Неопределено;
	Если Строка.НомерСтроки <= ДокОбъект.ТЧТовары.Количество() Тогда
		СтрокаТоваров = ДокОбъект.ТЧТовары[Строка.НомерСтроки - 1];
	КонецЕсли;
	Если СтрокаТоваров = Неопределено Или СтрокаТоваров.Номенклатура <> Строка.Номенклатура Тогда
		Результат.Конфликт = Истина;
		Результат.Текст = ТекстДокументИзменен();
		Возврат Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаТоваров.Серия) Или СтрокаТоваров.УказаноНесколькоСерий Тогда
		Результат.Текст = НСтр("ru = 'У строки указаны серии: правьте её в форме документа.';
			|fr = 'La ligne a des séries : modifiez-la dans le document.';
			|en = 'The line has series: edit it in the document form.'; es = 'La línea tiene series: edítela en el documento.'");
		Возврат Неопределено;
	КонецЕсли;
	Возврат СтрокаТоваров;

КонецФункции

// Записывает документ: новый и проведённый - с проведением, черновик - записью. Отказ - исключение не выходит наружу,
// текст - в результате.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.РеализацияТоваровУслуг - документ.
//  НовыйДокумент - Булево - документ создаётся этой записью.
//  Результат     - Структура - см. НовыйРезультатЗаписиСтрок.
//
Процедура ЗаписатьДокумент(ДокОбъект, НовыйДокумент, Результат)

	Накопленные = ТекстСообщений();
	Если Не ДокОбъект.ПроверитьЗаполнение() Тогда
		Результат.Текст = ТекстНеЗаписано(СоединитьТексты(Накопленные, ТекстСообщений()));
		Возврат;
	КонецЕсли;
	Проводить = НовыйДокумент Или ДокОбъект.Проведен;
	Попытка
		ДокОбъект.Записать(?(Проводить, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
	Исключение
		Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщения = СоединитьТексты(ТекстСообщений(), Ошибка);
		Причина = СоединитьТексты(Накопленные, Сообщения);
		Результат.Текст = ТекстНеЗаписано(Причина);
		Возврат;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Документ = ДокОбъект.Ссылка;
	Результат.Текст = СоединитьТексты(Накопленные, ТекстСообщений());

КонецПроцедуры

// Удаляет строки одного документа под блокировкой; документ без строк помечается на удаление.
//
// Параметры:
//  Документ  - ДокументСсылка.РеализацияТоваровУслуг - документ.
//  Данные    - Структура - ВерсияДанных (Строка), Номера (Массив из Число - номера строк товаров).
//  Результат - Структура - см. НовыйРезультатЗаписиСтрок.
//
Процедура УдалитьСтрокиДокумента(Документ, Данные, Результат)

	Если Не МожноВводитьСтрокиТоваров() Тогда
		Результат.Текст = ТекстЗапретаДанныхСтрок(Неопределено);
		Возврат;
	КонецЕсли;
	ДокОбъект = ЗаблокированныйДокумент(Документ, Данные.ВерсияДанных, Результат);
	Если ДокОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Номера = НомераУдаляемыхСтрок(ДокОбъект, Данные.Номера, Результат);
	Если Номера = Неопределено Тогда
		ДокОбъект.Разблокировать();
		Возврат;
	КонецЕсли;
	Попытка
		Если Номера.Количество() = ДокОбъект.ТЧТовары.Количество() Тогда
			ПометитьДокумент(ДокОбъект, Результат);
		Иначе
			УпорядоченныеНомера = Новый СписокЗначений;
			УпорядоченныеНомера.ЗагрузитьЗначения(Номера);
			УпорядоченныеНомера.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
			Для Каждого Элемент Из УпорядоченныеНомера Цикл
				ДокОбъект.ТЧТовары.Удалить(Элемент.Значение - 1);
			КонецЦикла;
			ЗаписатьДокумент(ДокОбъект, Ложь, Результат);
		КонецЕсли;
	Исключение
		Результат.Успех = Ложь;
		Результат.Текст = ТекстНеЗаписано(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ДокОбъект.Разблокировать();

КонецПроцедуры

// Номера удаляемых строк без повторов; строка с сериями удаляется только в форме документа (ревью безопасности).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - заблокированный документ.
//  Номера_   - Массив из Число - номера строк товаров от клиента.
//  Результат - Структура - см. НовыйРезультатЗаписиСтрок, получает отказ.
//
// Возвращаемое значение:
//  Массив из Число, Неопределено - номера; отказ - Неопределено.
//
Функция НомераУдаляемыхСтрок(ДокОбъект, Номера_, Результат)

	Номера = Новый Массив;
	Для Каждого Номер Из Номера_ Цикл
		Если ТипЗнч(Номер) <> Тип("Число") Или Номер < 1 Или Номер > ДокОбъект.ТЧТовары.Количество() Тогда
			Результат.Конфликт = Истина;
			Результат.Текст = ТекстДокументИзменен();
			Возврат Неопределено;
		КонецЕсли;
		УдаляемаяСтрока = ДокОбъект.ТЧТовары[Номер - 1];
		Если ЗначениеЗаполнено(УдаляемаяСтрока.Серия) Или УдаляемаяСтрока.УказаноНесколькоСерий Тогда
			Результат.Текст = НСтр("ru = 'У строки указаны серии: удалите её в форме документа.';
				|fr = 'La ligne a des séries : supprimez-la dans le document.';
				|en = 'The line has series: delete it in the document form.'; es = 'La línea tiene series: elimínela en el documento.'");
			Возврат Неопределено;
		КонецЕсли;
		Если Номера.Найти(Номер) = Неопределено Тогда
			Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;
	Возврат Номера;

КонецФункции

// Пометка документа, у которого удаляются все строки: право интерактивной пометки, как у формы списка (платформе
// хватает «Изменения»); строки остаются в помеченном документе. Объект не изменён - его платформа пометить даёт.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - заблокированный неизменённый документ.
//  Результат - Структура - см. НовыйРезультатЗаписиСтрок.
//
Процедура ПометитьДокумент(ДокОбъект, Результат)

	Если Не ПравоДоступа("ИнтерактивнаяПометкаУдаления", Метаданные.Документы.РеализацияТоваровУслуг) Тогда
		Результат.Текст = НСтр("ru = 'Нет права помечать документ на удаление: удалите строки в форме документа.';
			|fr = 'Aucun droit de marquer le document pour suppression : supprimez les lignes dans le document.';
			|en = 'No right to mark the document for deletion: delete the lines in the document form.';
			|es = 'Sin derecho a marcar el documento para eliminar: elimine las líneas en el documento.'");
		Возврат;
	КонецЕсли;
	Накопленные = ТекстСообщений();
	Попытка
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	Исключение
		Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщения = СоединитьТексты(ТекстСообщений(), Ошибка);
		Результат.Текст = ТекстНеЗаписано(СоединитьТексты(Накопленные, Сообщения));
		Возврат;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Документ = ДокОбъект.Ссылка;
	Результат.Текст = СоединитьТексты(Накопленные, ТекстСообщений());

КонецПроцедуры

Функция ТекстСообщений()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

Функция СоединитьТексты(Первый, Второй)

	Если ПустаяСтрока(Первый) Или ПустаяСтрока(Второй) Тогда
		Возврат Первый + Второй;
	КонецЕсли;
	Возврат Первый + Символы.ПС + Второй;

КонецФункции

Функция ТекстНеЗаписано(Причина)

	Возврат СтрШаблон(НСтр("ru = 'Не записано: %1'; fr = 'Non enregistré : %1'; en = 'Not saved: %1'; es = 'No guardado: %1'"),
		Причина);

КонецФункции

