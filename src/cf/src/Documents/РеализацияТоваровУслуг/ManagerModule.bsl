#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы документа.
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	// Facture, счёт на оплату, накладные BL и акт - фирменные формы под прежними именами и названиями команд
	// (docs/plans/branded-print.md, разделы 10.7 и 11.3): настройки принтера и пункты меню у пользователя не меняются.
	// Накладная DevisBL печатается на A4, как BL (A4), - ответ владельца 2026-10-11; «(A5)» из названия убрано.
	Для Каждого Вариант Из ВариантыФирменныхФорм() Цикл
		ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, Вариант.ИмяМакета, Вариант.ВидФормы, Вариант.Представление);
	КонецЦикла;

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "Чек";
	Команда.Представление = НСтр("ru = 'Чек'; fr = 'Ticket'; en = 'Receipt'; es = 'Recibo'");

	Если ПечатьКПДоступна() Тогда
		ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаКП(), ВидФормыКП());
	КонецЕсли;

КонецПроцедуры

// Формирует запрошенные печатные формы документа.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые документы
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие документов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Команду «Счёт» печатают и формы заказа покупателя: по ссылке заказа - счета его реализаций, без них - сам заказ
	// (адаптер заказа, признак СчетаРеализаций). Варианты BL - параметрами команды (БезНДС, БезЦен), как прежние формы.
	Для Каждого Вариант Из ВариантыФирменныхФорм() Цикл
		ФирменнаяПечать.Напечатать(Вариант.ИмяМакета, Вариант.ВидФормы, МассивОбъектов,
			ПараметрыВарианта(ПараметрыПечати, Вариант.Параметры), КоллекцияПечатныхФорм, ОбъектыПечати,
			Вариант.Представление);
	КонецЦикла;

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "Чек") Тогда
		Таб = НовыйТабличныйДокументЧека();
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			PrintTicket(Док, Таб);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "Чек",
			НСтр("ru = 'Чек'; fr = 'Ticket'; en = 'Receipt'; es = 'Recibo'"),
			Таб, "Документ.РеализацияТоваровУслуг.Чек");
	КонецЕсли;

	НапечататьКоммерческоеПредложение(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати);

КонецПроцедуры

// Доступна ли пользователю печать коммерческого предложения из реализации (docs/plans/branded-print.md, 3.3 и 9.8):
// только когда КП не вводятся вручную (опция выключена) и только ролям, которым видны суммы реализации. Роль
// ОператорПроизводства работает с составом документов без цен и сумм (РаботаСДокументами.
// ОграничитьВидимостьРеквизитовПоТипу) - КП с ценами ей не печатается.
//
// Возвращаемое значение:
//  Булево - Истина, если команда «Коммерческое предложение» реализации доступна.
//
Функция ПечатьКПДоступна() Экспорт
	Возврат Не Документы.КоммерческоеПредложение.КПВводятсяВручную() И Не ФирменнаяПечать.ЦеныСкрыты();
КонецФункции

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать). Facture, Proforma, BL и акт - данные реализации (товары
// и услуги, у акта - только услуги; docs/plans/branded-print.md, разделы 10.6 и 11.5). КП из реализации: перед печатью протокол
// синхронизации создаёт или обновляет КП реализаций (догоняет и изменения, пришедшие загрузкой обмена), затем данные
// берёт адаптер документа КП. Печатаются только реализации, которые пользователь вправе читать; КП читается в
// привилегированном режиме - у ролей, работающих с реализацией, прав на КП может не быть (docs/plans/branded-print.md,
// 9.5 и 9.8).
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.РеализацияТоваровУслуг - печатаемые реализации.
//  ВидФормы        - Строка - вид фирменной формы: КоммерческоеПредложение, Facture, Proforma, BL, АктОбОказанииУслуг.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати (БезЦен, БезНДС - нужны ли оплаты BL); адаптеру КП не
//                    передаются (у авто-КП нет редакций).
//
// Возвращаемое значение:
//  Соответствие - реализация -> Структура: Данные, Плашка, ИмяФайла (см. ФирменнаяПечать.ИсточникТоварногоДокумента,
//                 Документы.КоммерческоеПредложение.ДанныеФирменнойПечати).
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	Если ВидФормы <> ВидФормыКП() Тогда
		Возврат ДанныеТоварныхФорм(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати);
	КонецЕсли;
	ПроверитьДоступностьПечатиКП();
	// Проверка доступа и чтение данных печати - в одной транзакции под блокировкой реализаций: иначе смена
	// контрагента реализации между проверкой и привилегированным чтением обходила бы ограничения записей.
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРеализации(Ссылки);
		Результат = ДанныеКПДоступныхРеализаций(Ссылки, ВидФормы, КодЯзыка);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Табличный документ, настроенный под печать чека на чековом принтере.
//
// Возвращаемое значение:
//  ТабличныйДокумент - подготовленный документ
//
Функция НовыйТабличныйДокументЧека() Экспорт

	Таб = Новый ТабличныйДокумент;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Таб.АвтоМасштаб = Истина;
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.Защита = Ложь;
	Таб.ПолеСверху = 5;
	Таб.ПолеСлева = 0;
	Таб.ПолеСнизу = 20;
	Таб.ПолеСправа = 10;
	Возврат Таб;

КонецФункции

#КонецОбласти

#Область Печать

Процедура ПечатьТорг12(Док, Таб) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ЭтоВозвратПоставщику = ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратПоставщику");
	Таб.ТолькоПросмотр = Истина;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОтображатьСетку = Ложь;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Таб.АвтоМасштаб = Истина;
	Таб.КлючПараметровПечати = "Параметры_печати_Документ_РеализацияТоваровУслуг_Торг12";
	ТабФормирование = Новый ТабличныйДокумент;
	ТабФормирование.АвтоМасштаб = Истина;
	ТабФормирование.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	// Макет
	Макет = ПечатныеФормы.МакетПечатнойФормы("Документ.РеализацияТоваровУслуг.РасходнаяНакладная");
	// Переменные
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Грузоотправитель = Док.Контрагент;
		Грузополучатель = Док.Организация; 
		Плательщик = Док.Организация;
		ДокНомер = Док.НомерВходящегоДокумента;
		ДокДата = Док.ДатаВходящегоДокумента;
	Иначе
		Грузоотправитель = Док.Организация;
		Грузополучатель =  Док.Контрагент;
		Плательщик = Док.Контрагент;
		ДокНомер = РаботаСДокументами.СформироватьЦифровойНомер(Док.Номер);
		ДокДата = Док.Дата;
	КонецЕсли;
    КарточкаГрузоотправителя = Справочники.Контрагенты.ПолучитьКарточку(Грузоотправитель, Док.Дата);
	КарточкаГрузополучателя = Справочники.Контрагенты.ПолучитьКарточку(Грузополучатель, Док.Дата);
	КарточкаПлательщика = Справочники.Контрагенты.ПолучитьКарточку(Плательщик, Док.Дата);
	// Шапка
	оШапка = Макет.ПолучитьОбласть("Шапка");
	оЗаголовок = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
	оШапка.Параметры.НомерДокумента = ДокНомер;
	оШапка.Параметры.ДатаДокумента = ДокДата;
	оШапка.Параметры.ПредставлениеОрганизации = КарточкаГрузоотправителя.Представление;
	оШапка.Параметры.ПредставлениеПоставщика = КарточкаГрузоотправителя.Представление;
	оШапка.Параметры.ОрганизацияПоОКПО = КарточкаГрузоотправителя.Реквизиты.ОКПО;
	оШапка.Параметры.ПредставлениеГрузополучателя = КарточкаГрузополучателя.Наименование + ", " + КарточкаГрузополучателя.Реквизиты.АдресФактический;
	оШапка.Параметры.АдресДоставки = КарточкаГрузополучателя.Реквизиты.АдресДоставки;
	оШапка.Параметры.ГрузополучательПоОКПО = КарточкаГрузополучателя.Реквизиты.ОКПО;
	оШапка.Параметры.ПредставлениеПлательщика = КарточкаПлательщика.Представление;
	оШапка.Параметры.ПлательщикПоОКПО = КарточкаПлательщика.Реквизиты.ОКПО;
	оШапка.Параметры.Основание = "Договор " + СокрЛП(Док.Договор);
	ТабФормирование.Вывести(оШапка);
	ТабФормирование.Вывести(оЗаголовок);
	// Строки
	оСтрока = Макет.ПолучитьОбласть("Строка");
	оИтогоПоСтранице = Макет.ПолучитьОбласть("ИтогоПоСтранице");
	оВсего = Макет.ПолучитьОбласть("Всего");
	оПодвал = Макет.ПолучитьОбласть("Подвал");
	ИтогоКоличество = 0;
	ИтогоСумма = 0;
	ИтогоМест = 0;
	ИтогоНетто = 0;
	ИтогоБрутто = 0;
	ИтогоСтраницаКоличество = 0;
	ИтогоСтраницаСумма = 0;
	ИтогоСтраницаМест = 0;
	Ном = 1;
	МасВывод = Новый Массив;
	ТЧТовары = СерииИРазмещение.ОбъединитьТоварыССериями(Док);	
	ТЧТовары = ПечатныеФормы.СформироватьТабличныеДанные(ТЧТовары);	
	КоличествоТоваров = ТЧТовары.Количество();
	Для Каждого Стр Из ТЧТовары Цикл
		оСтрока.Параметры.Заполнить(Стр);
		оСтрока.Параметры.НомерСтроки = Ном;
		//Если Док.ЦенаВключаетНДС Тогда
			СуммаБезНДС = Стр.СуммаСНДС - Стр.СуммаНДС;
			ЦенаБезНДС = ?(Стр.Количество = 0, 0, СуммаБезНДС / Стр.Количество);
			оСтрока.Параметры.Сумма = СуммаБезНДС;
			оСтрока.Параметры.Цена = ЦенаБезНДС;
		//КонецЕсли;
		МасВывод.Очистить();
		МасВывод.Добавить(оСтрока);
		МасВывод.Добавить(оИтогоПоСтранице);			
		Если Ном = КоличествоТоваров Тогда				
			МасВывод.Добавить(оВсего);
			МасВывод.Добавить(оПодвал);
			Если Не ТабФормирование.ПроверитьВывод(МасВывод) Тогда
				оИтогоПоСтранице.Параметры.ИтогоКоличествоНаСтранице = ИтогоСтраницаКоличество;
				оИтогоПоСтранице.Параметры.ИтогоМестНаСтранице = ИтогоСтраницаМест;
				оИтогоПоСтранице.Параметры.ИтогоСуммаНаСтранице = ИтогоСтраницаСумма;
				ТабФормирование.Вывести(оИтогоПоСтранице);
				ТабФормирование.ВывестиГоризонтальныйРазделительСтраниц();
				ИтогоСтраницаКоличество = 0;
				ИтогоСтраницаСумма = 0;
				ИтогоСтраницаМест = 0;
				ТабФормирование.Вывести(оЗаголовок);
			КонецЕсли;
		ИначеЕсли Не ТабФормирование.ПроверитьВывод(МасВывод) Тогда
			оИтогоПоСтранице.Параметры.ИтогоКоличествоНаСтранице = ИтогоСтраницаКоличество;
			оИтогоПоСтранице.Параметры.ИтогоМестНаСтранице = ИтогоСтраницаМест;
			оИтогоПоСтранице.Параметры.ИтогоСуммаНаСтранице = ИтогоСтраницаСумма;
			ТабФормирование.Вывести(оИтогоПоСтранице);
			ТабФормирование.ВывестиГоризонтальныйРазделительСтраниц();
			ИтогоСтраницаКоличество = 0;
			ИтогоСтраницаСумма = 0;
			ИтогоСтраницаМест = 0;
			ТабФормирование.Вывести(оЗаголовок);
		КонецЕсли;
		ТабФормирование.Вывести(оСтрока);
		ИтогоКоличество = ИтогоКоличество + Стр.Количество;
		ИтогоСумма = ИтогоСумма + Стр.Сумма;
		ИтогоМест = ИтогоМест + Стр.КоличествоУпаковок;
		//ИтогоНетто = ИтогоНетто + Стр.Количество;
		//ИтогоБрутто = ИтогоБрутто + Стр.Количество;
		ИтогоСтраницаКоличество = ИтогоСтраницаКоличество + Стр.Количество;
		ИтогоСтраницаСумма = ИтогоСтраницаСумма + Стр.СуммаСНДС;
		ИтогоСтраницаМест = ИтогоСтраницаМест + Стр.КоличествоУпаковок;
		Ном = Ном + 1;
	КонецЦикла;
	оИтогоПоСтранице.Параметры.ИтогоКоличествоНаСтранице = ИтогоСтраницаКоличество;
	оИтогоПоСтранице.Параметры.ИтогоМестНаСтранице = ИтогоСтраницаМест;
	оИтогоПоСтранице.Параметры.ИтогоСуммаНаСтранице = ИтогоСтраницаСумма;
	ТабФормирование.Вывести(оИтогоПоСтранице);
	// Всего
	оВсего.Параметры.ИтогоКоличество = ИтогоКоличество;
	оВсего.Параметры.ИтогоМест = ИтогоМест;
	оВсего.Параметры.ИтогоСумма = ИтогоСумма;
	ТабФормирование.Вывести(оВсего);
	// Подвал
	оПодвал.Параметры.КоличествоПорядковыхНомеровЗаписейПрописью = ЧислоПрописью(КоличествоТоваров,,",,,,,,,,0");
	оПодвал.Параметры.ВсегоМестПрописью = ЧислоПрописью(ИтогоМест,,",,,,,,,,0");
	оПодвал.Параметры.МассаГрузаНеттоПрописью = ЧислоПрописью(ИтогоНетто,,",,,,,,,,0");
	оПодвал.Параметры.МассаГрузаБруттоПрописью = ЧислоПрописью(ИтогоБрутто,,",,,,,,,,0");
	оПодвал.Параметры.СуммаПрописью = Справочники.Валюты.СформироватьСуммуПрописью(ИтогоСумма, Справочники.Валюты.MoroccanDirham, Перечисления.Локализации.fr_CA);
	
	оПодвал.Параметры.ФИОРуководителя = КарточкаГрузоотправителя.Руководитель.ДляПечатиПолное;		
	оПодвал.Параметры.ДолжностьРуководителя = КарточкаГрузоотправителя.Руководитель.Должность;		
	оПодвал.Параметры.ФИОГлавБухгалтера = КарточкаГрузоотправителя.ГлавныйБухгалтер.Должность; 		
	
	ТабФормирование.Вывести(оПодвал);
	ТабФормирование.ВывестиГоризонтальныйРазделительСтраниц();
	Таб.Вывести(ТабФормирование);
	Таб.ИспользуемоеИмяФайла = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, "Товарная накладная");
КонецПроцедуры

// Число для вывода в печатную форму: пустые итоги запросов приходят как Неопределено
// или NULL, а арифметика с ними обрывает формирование.
//
// Параметры:
//  Значение - Произвольный - сумма из запроса или итога таблицы
//
// Возвращаемое значение:
//  Число - исходное число либо 0
//
Функция ЧислоДляПечати(Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);
КонецФункции

Функция ФорматСуммы(Сумма, Валюта)
	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=0,00") + " " + Валюта;
КонецФункции

Функция КарточкаКонтрагента(Карточки, Владелец, Дата)
	// Карточка контрагента или организации с кэшированием в пределах одной печати.
	Карточка = Карточки.Получить(Владелец);
	Если Карточка = Неопределено Тогда
		Карточка = Справочники.Контрагенты.ПолучитьКарточку(Владелец, Дата);
		Карточки.Вставить(Владелец, Карточка);
	КонецЕсли;
	Возврат Карточка;
КонецФункции

Функция МассивОбластей(Область1, Область2 = Неопределено)
	Массив = Новый Массив;
	Массив.Добавить(Область1);
	Если Область2 <> Неопределено Тогда
		Массив.Добавить(Область2);
	КонецЕсли;
	Возврат Массив;
КонецФункции

// Печать Bon de commande заказа покупателя и Demande de prix предложения поставщика на A4 (прежний макет DevisBL_A4;
// фирменными они становятся в фазах 5-6, docs/plans/branded-print.md).
//
// Параметры:
//  Док - ДокументСсылка.ЗаказПокупателя, ДокументСсылка.ПредложениеПоставщика - печатаемый документ.
//  Spreadsheet - ТабличныйДокумент - куда выводится форма.
//  НазваниеДокумента - Строка - заголовок формы.
//  БезЦен - Булево - Истина: цены и суммы не выводятся.
//
// Возвращаемое значение:
//  ТабличныйДокумент - Spreadsheet с выведенной формой.
//
Function PrintDevisA4(Док, Spreadsheet, НазваниеДокумента = "Devis", БезЦен = Ложь) Export
	Параметры = ПараметрыПечатиDevisBL("DevisBL_A4", "A4", НазваниеДокумента, БезЦен);
	Возврат ВывестиDevisBL(Док, Spreadsheet, Параметры);
EndFunction

Функция ПараметрыПечатиDevisBL(ИмяМакета, РазмерСтраницы, НазваниеДокумента, БезЦен)
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяМакета", ИмяМакета);
	Параметры.Вставить("РазмерСтраницы", РазмерСтраницы);
	Параметры.Вставить("НазваниеДокумента", НазваниеДокумента);
	Параметры.Вставить("БезЦен", БезЦен);
	Параметры.Вставить("ОбластьИтогов", "TabularSectionFooterTotal");
	Возврат Параметры;
КонецФункции

Функция ВывестиDevisBL(Док, Spreadsheet, Параметры)
	// Прежний вывод Bon de commande и Demande de prix (см. PrintDevisA4): макет и область итогов задаются в Параметры
	// (см. ПараметрыПечатиDevisBL). BL, Avoir и проформа печатаются фирменными формами (ФирменнаяПечать).
	Template = ПечатныеФормы.МакетПечатнойФормы("Документ.РеализацияТоваровУслуг." + Параметры.ИмяМакета);
	Query = Новый Запрос(ТекстЗапросаDevisBL());
	Query.УстановитьПараметр("Ref", Док);
	// Подпись валюты: у документа в валюте - его валюта, иначе валюта договора.
	ВалютаДокумента = РаботаСВалютами.ВалютаИКурсОбъекта(Док);
	Query.УстановитьПараметр("ВВалюте", ВалютаДокумента.ВВалюте);
	Query.УстановитьПараметр("ВалютаДокумента", ВалютаДокумента.Валюта);
	Результат = Query.ВыполнитьПакет();
	Логотипы = Новый Соответствие;
	Выборка = Результат[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Логотипы.Вставить(Выборка.Ссылка, Выборка.Логотип);
	КонецЦикла;
	Selection = Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Области = ОбластиМакетаDevisBL(Template, Параметры.ОбластьИтогов);
	Spreadsheet.РазмерСтраницы = Параметры.РазмерСтраницы;
	Spreadsheet.АвтоМасштаб = Истина;

	Карточки = Новый Соответствие;
	Пока Selection.Следующий() Цикл
		Карточка = КарточкаКонтрагента(Карточки, Selection.Organisation, Док.Дата);
		КарточкаКлиента = КарточкаКонтрагента(Карточки, Selection.Client, Док.Дата);
		Области.Header.Параметры.Заполнить(Selection);
		Области.Header.Параметры.Заполнить(ДанныеШапкиDevisBL(Selection, Карточка, КарточкаКлиента, Параметры.НазваниеДокумента));
		ПечатныеФормы.УстановитьЛоготип(Области.Header, Логотипы[Selection.Ссылка]);
		Области.FooterCodes.Параметры.НижнийКолонтитул = ПечатныеФормы.РеквизитыОрганизацииДляПодвала(
			Selection.Organisation, Док.Дата, Карточка);
		Spreadsheet.Вывести(Области.Header, Selection.Уровень());
		Spreadsheet.Вывести(Области.TabularSectionHeader);
		ВывестиСтрокиDevisBL(Spreadsheet, Области, Selection, Параметры.БезЦен);

		Если Не Параметры.БезЦен Тогда
			ИтогоСумма = ЧислоДляПечати(Selection.TotalSomme);
			Области.FooterTotal.Параметры.Total = ФорматСуммы(ИтогоСумма, Selection.Devise);
		КонецЕсли;
		Spreadsheet.Вывести(Области.FooterTotal);
		ПечатныеФормы.ДобитьСтраницуПустымиСтроками(Spreadsheet, Области.EmptyLine, МассивОбластей(Области.Footer, Области.FooterCodes));

		Области.Footer.Параметры.PrintDate = Формат(ТекущаяДатаСеанса(), "ДЛФ=D");
		Области.Footer.Параметры.PrintTime = Формат(ТекущаяДатаСеанса(), "ДЛФ=T");
		Области.Footer.Параметры.Author = Selection.Createur;
		Spreadsheet.Вывести(Области.Footer);
		Spreadsheet.Вывести(Области.FooterCodes);
		Spreadsheet.ПолеСнизу = 10;
		Spreadsheet.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЦикла;

	Spreadsheet.ИспользуемоеИмяФайла = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, Параметры.НазваниеДокумента);
	Возврат Spreadsheet;
КонецФункции

