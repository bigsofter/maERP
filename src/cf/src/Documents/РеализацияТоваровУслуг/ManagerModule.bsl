		//PrintManagement.SetDocumentPrintArea(Spreadsheet, FirstRowNumber, PrintObjects, Selection.DocRef);
	EndDo; 
	
	Spreadsheet.ИспользуемоеИмяФайла = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, "Facture");
	Return Spreadsheet;
	
	//}}
EndFunction

// Число для вывода в печатную форму: пустые итоги запросов приходят как Неопределено
// или NULL, а арифметика с ними обрывает формирование.
//
// Параметры:
//  Значение - Произвольный - сумма из запроса или итога таблицы
//
// Возвращаемое значение:
//  Число - исходное число либо 0
//
Функция ЧислоДляПечати(Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);
КонецФункции

Функция ФорматСуммы(Сумма, Валюта)
	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=0,00") + " " + Валюта;
КонецФункции

Функция КарточкаКонтрагента(Карточки, Владелец, Дата)
	// Карточка контрагента или организации с кэшированием в пределах одной печати.
	Карточка = Карточки.Получить(Владелец);
	Если Карточка = Неопределено Тогда
		Карточка = Справочники.Контрагенты.ПолучитьКарточку(Владелец, Дата);
		Карточки.Вставить(Владелец, Карточка);
	КонецЕсли;
	Возврат Карточка;
КонецФункции

Функция МассивОбластей(Область1, Область2 = Неопределено)
	Массив = Новый Массив;
	Массив.Добавить(Область1);
	Если Область2 <> Неопределено Тогда
		Массив.Добавить(Область2);
	КонецЕсли;
	Возврат Массив;
КонецФункции

Function PrintDevisBL(Док, Spreadsheet, НазваниеДокумента = "Devis", БезЦен = Ложь) Export
	Devis = (НазваниеДокумента = "Devis");
	Параметры = ПараметрыПечатиDevisBL("DevisBL", "A5", НазваниеДокумента, БезЦен);
	Параметры.ОбластьИтогов = ?(Devis, "TabularSectionFooterTotalDevis", "TabularSectionFooterTotal");
	Параметры.ПоказыватьОплаты = Не Devis;
	Возврат ВывестиDevisBL(Док, Spreadsheet, Параметры);
EndFunction

// Печать Devis / Bon de commande на A4 без разбивки оплат.
//
// Параметры:
//  Док - ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.ЗаказПокупателя,
//        ДокументСсылка.КоммерческоеПредложение, ДокументСсылка.ВозвратОтПокупателя,
//        ДокументСсылка.ВозвратОтПокупателяНалоговый - печатаемый документ.
//  Spreadsheet - ТабличныйДокумент - куда выводится форма.
//  НазваниеДокумента - Строка - заголовок формы.
//  БезЦен - Булево - Истина: цены и суммы не выводятся.
//
// Возвращаемое значение:
//  ТабличныйДокумент - Spreadsheet с выведенной формой.
//
Function PrintDevisA4(Док, Spreadsheet, НазваниеДокумента = "Devis", БезЦен = Ложь) Export
	Параметры = ПараметрыПечатиDevisBL("DevisBL_A4", "A4", НазваниеДокумента, БезЦен);
	Возврат ВывестиDevisBL(Док, Spreadsheet, Параметры);
EndFunction

// Печать Bon de livraison на A4 с разбивкой оплат по документу и долгом клиента.
//
// Параметры:
//  Док - ДокументСсылка.РеализацияТоваровУслуг - печатаемый документ.
//  Spreadsheet - ТабличныйДокумент - куда выводится форма.
//  НазваниеДокумента - Строка - заголовок формы.
//  БезЦен - Булево - Истина: цены, суммы и оплаты не выводятся.
//
// Возвращаемое значение:
//  ТабличныйДокумент - Spreadsheet с выведенной формой.
//
Function PrintBLA4(Док, Spreadsheet, НазваниеДокумента = "Bon de livraison", БезЦен = Ложь) Export
	Параметры = ПараметрыПечатиDevisBL("DevisBL_A4", "A4", НазваниеДокумента, БезЦен);
	Параметры.ОбластьИтогов = "TabularSectionFooterTotalBL";
