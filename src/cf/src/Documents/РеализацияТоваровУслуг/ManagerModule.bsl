// Перечисляет печатные формы документа.
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	// Facture, счёт на оплату, накладные BL и акт - фирменные формы под прежними именами и названиями команд
	// (docs/plans/branded-print.md, разделы 10.7 и 11.3): настройки принтера и пункты меню у пользователя не меняются.
	// Накладная DevisBL печатается на A4, как BL (A4), - ответ владельца 2026-10-11; «(A5)» из названия убрано.
	Для Каждого Вариант Из ВариантыФирменныхФорм() Цикл
		ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, Вариант.ИмяМакета, Вариант.ВидФормы, Вариант.Представление);
	КонецЦикла;

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "Чек";
	Команда.Представление = НСтр("ru = 'Чек'; fr = 'Ticket'; en = 'Receipt'; es = 'Recibo'");

	Если ПечатьКПДоступна() Тогда
		ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаКП(), ВидФормыКП());
	КонецЕсли;

КонецПроцедуры

// Формирует запрошенные печатные формы документа.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые документы
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие документов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Команду «Счёт» печатают и формы заказа покупателя: по ссылке заказа - счета его реализаций, без них - сам заказ
	// (адаптер заказа, признак СчетаРеализаций). Варианты BL - параметрами команды (БезНДС, БезЦен), как прежние формы.
	Для Каждого Вариант Из ВариантыФирменныхФорм() Цикл
		ФирменнаяПечать.Напечатать(Вариант.ИмяМакета, Вариант.ВидФормы, МассивОбъектов,
			ПараметрыВарианта(ПараметрыПечати, Вариант.Параметры), КоллекцияПечатныхФорм, ОбъектыПечати,
			Вариант.Представление);
	КонецЦикла;

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "Чек") Тогда
		Таб = НовыйТабличныйДокументЧека();
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			PrintTicket(Док, Таб);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "Чек",
			НСтр("ru = 'Чек'; fr = 'Ticket'; en = 'Receipt'; es = 'Recibo'"),
			Таб, "Документ.РеализацияТоваровУслуг.Чек");
	КонецЕсли;

	НапечататьКоммерческоеПредложение(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати);

КонецПроцедуры

// Доступна ли пользователю печать коммерческого предложения из реализации (docs/plans/branded-print.md, 3.3 и 9.8):
// только когда КП не вводятся вручную (опция выключена) и только ролям, которым видны суммы реализации. Роль
// ОператорПроизводства работает с составом документов без цен и сумм (РаботаСДокументами.
// ОграничитьВидимостьРеквизитовПоТипу) - КП с ценами ей не печатается.
//
// Возвращаемое значение:
//  Булево - Истина, если команда «Коммерческое предложение» реализации доступна.
//
Функция ПечатьКПДоступна() Экспорт
	Возврат Не Документы.КоммерческоеПредложение.КПВводятсяВручную() И Не ФирменнаяПечать.ЦеныСкрыты();
КонецФункции

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать). Facture, Proforma, BL и акт - данные реализации (товары
// и услуги, у акта - только услуги; docs/plans/branded-print.md, разделы 10.6 и 11.5). КП из реализации: перед печатью протокол
// синхронизации создаёт или обновляет КП реализаций (догоняет и изменения, пришедшие загрузкой обмена), затем данные
// берёт адаптер документа КП. Печатаются только реализации, которые пользователь вправе читать; КП читается в
// привилегированном режиме - у ролей, работающих с реализацией, прав на КП может не быть (docs/plans/branded-print.md,
// 9.5 и 9.8).
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.РеализацияТоваровУслуг - печатаемые реализации.
//  ВидФормы        - Строка - вид фирменной формы: КоммерческоеПредложение, Facture, Proforma, BL, АктОбОказанииУслуг.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати (БезЦен, БезНДС - нужны ли оплаты BL); адаптеру КП не
//                    передаются (у авто-КП нет редакций).
//
// Возвращаемое значение:
//  Соответствие - реализация -> Структура: Данные, Плашка, ИмяФайла (см. ФирменнаяПечать.ИсточникТоварногоДокумента,
//                 Документы.КоммерческоеПредложение.ДанныеФирменнойПечати).
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	Если ВидФормы <> ВидФормыКП() Тогда
		Возврат ДанныеТоварныхФорм(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати);
	КонецЕсли;
	ПроверитьДоступностьПечатиКП();
	// Проверка доступа и чтение данных печати - в одной транзакции под блокировкой реализаций: иначе смена
	// контрагента реализации между проверкой и привилегированным чтением обходила бы ограничения записей.
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРеализации(Ссылки);
		Результат = ДанныеКПДоступныхРеализаций(Ссылки, ВидФормы, КодЯзыка);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Табличный документ, настроенный под печать чека на чековом принтере.
//
// Возвращаемое значение:
//  ТабличныйДокумент - подготовленный документ
//
Функция НовыйТабличныйДокументЧека() Экспорт

	Таб = Новый ТабличныйДокумент;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Таб.АвтоМасштаб = Истина;
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.Защита = Ложь;
	Таб.ПолеСверху = 5;
	Таб.ПолеСлева = 0;
	Таб.ПолеСнизу = 20;
	Таб.ПолеСправа = 10;
	Возврат Таб;

КонецФункции

// Настраивает форму реализации под ордерную схему склада (план warehouse-orders, решение 5): документ по ордерам берёт
// склад из ордера - склад только для просмотра, колонка ордера видна; документ без ордеров выбирает склад из неордерных.
// Одна настройка на основную и мобильную форму.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа с элементами МестоХранения и ТЧТоварыОрдер
//
Процедура НастроитьОрдернуюСхемуФормы(Форма) Экспорт
	ЕстьОрдера = Ложь;
	Для Каждого Строка Из Форма.Объект.ТЧТовары Цикл
		Если ЗначениеЗаполнено(Строка.Ордер) Тогда
			ЕстьОрдера = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Форма.Элементы.ТЧТоварыОрдер.Видимость = ЕстьОрдера;
	Форма.Элементы.МестоХранения.ТолькоПросмотр = ЕстьОрдера;
	Если Не ЕстьОрдера Тогда
		Справочники.МестаХранения.УстановитьОтборОрдерности(Форма.Элементы.МестоХранения, Ложь);
	КонецЕсли;
КонецПроцедуры

