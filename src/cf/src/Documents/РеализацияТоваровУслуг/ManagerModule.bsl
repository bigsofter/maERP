// Данные Facture и Proforma реализаций: шапки одним запросом, строки товаров и услуг - общим запросом фирменной
// печати (docs/plans/branded-print.md, раздел 10.6). Номер Facture - как у прежней формы «номер/ГГ», группа строк -
// сама реализация («BL: …»); Proforma - номер документа без года и без группы, как прежний «Счёт на оплату».
//
// Параметры:
//  Ссылки   - Массив из ДокументСсылка.РеализацияТоваровУслуг - печатаемые реализации.
//  ВидФормы - Строка - Facture или Proforma.
//  КодЯзыка - Строка - язык печати.
//
// Возвращаемое значение:
//  Соответствие - реализация -> источник печати (см. ФирменнаяПечать.ИсточникТоварногоДокумента).
//
Функция ДанныеСчетаФактуры(Ссылки, ВидФормы, КодЯзыка)
	ЭтоФактура = ВидФормы = ВидФормыФактуры();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Реализация.Ссылка КАК Ссылка,
	|	Реализация.Номер КАК НомерДокумента,
	|	Реализация.Дата КАК Дата,
	|	Реализация.Организация КАК Организация,
	|	Реализация.Контрагент КАК Контрагент,
	|	Реализация.Договор КАК Договор,
	|	Реализация.Валюта КАК Валюта,
	|	Реализация.ВВалюте КАК ВВалюте,
	|	Реализация.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Реализация.Сумма КАК Сумма,
	|	Реализация.СуммаНДС КАК СуммаНДС,
	|	Реализация.Комментарий КАК Комментарий,
	|	ВЫБОР
	|		КОГДА Реализация.Менеджер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(Реализация.Ответственный)
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Реализация.Менеджер)
	|	КОНЕЦ КАК Менеджер,
	|	ЕСТЬNULL(Заказы.Номер, """") КАК НомерОснования,
	|	ЕСТЬNULL(Заказы.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОснования,
	|	ЕСТЬNULL(Контрагенты.Код, """") КАК КодКонтрагента,
	|	ЕСТЬNULL(Контрагенты.ПечатьНакладнойЦеныБезНДС, ЛОЖЬ) КАК ЦеныБезНДС,
	|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(Контрагенты.ТипОплаты), """") КАК ТипОплаты
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Реализация.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
	|		ПО Реализация.Основание = Заказы.Ссылка
	|ГДЕ
	|	Реализация.Ссылка В(&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Строки = ФирменнаяПечать.ДанныеСтрокДокументов(Метаданные.Документы.РеализацияТоваровУслуг.Имя, Ссылки,
		"ТЧТовары, ТЧУслуги", ?(ЭтоФактура, "Ссылка", ""));
	Кэш = ФирменнаяПечать.НовыйКэш();
	ПодписьЗаказа = НСтр("ru = 'Заказ'; fr = 'Commande'; en = 'Order'; es = 'Pedido'", КодЯзыка);
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Шапка = ФирменнаяПечать.НоваяШапкаДокумента();
		ЗаполнитьЗначенияСвойств(Шапка, Выборка);
		// Цены без НДС по признаку клиента печатала только Facture, счёт на оплату - всегда как в документе.
		Шапка.ЦеныБезНДС = ЭтоФактура И Выборка.ЦеныБезНДС;
		Шапка.Номер = ?(ЭтоФактура, ФирменнаяПечать.НомерСчетаФактуры(Выборка.НомерДокумента, Выборка.Дата),
			СокрЛП(Выборка.НомерДокумента));
		НомерОснования = РаботаСДокументами.СформироватьЦифровойНомер(Выборка.НомерОснования);
		Шапка.Основание = ФирменнаяПечать.ПредставлениеОснования(ПодписьЗаказа, НомерОснования, Выборка.ДатаОснования,
			КодЯзыка);
		Шапка.УсловияОплаты = ФирменнаяПечать.УсловияОплатыДокумента(Выборка.Ссылка, Выборка.ТипОплаты);
		ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента(?(ЭтоФактура, "Facture", "Facture proforma"),
			Выборка.НомерДокумента, Выборка.Дата);
		Источник = ФирменнаяПечать.ИсточникТоварногоДокумента(Шапка, Строки[Выборка.Ссылка], Кэш, ИмяФайла);
		Результат.Вставить(Выборка.Ссылка, Источник);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаблокироватьРеализации(Ссылки)
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Ссылка Из Ссылки Цикл
		ЭлементБлокировки = Блокировка.Добавить("Документ.РеализацияТоваровУслуг");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	КонецЦикла;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ДанныеКПДоступныхРеализаций(Ссылки, ВидФормы, КодЯзыка)
	Результат = Новый Соответствие;
	Доступные = ДоступныеДляЧтения(Ссылки);
	Если Доступные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	МенеджерКП = Документы.КоммерческоеПредложение;
	Предложения = МенеджерКП.СинхронизироватьСРеализациями(Доступные);
	МассивКП = Новый Массив;
	Для Каждого КлючИЗначение Из Предложения Цикл
		МассивКП.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	// BSLLS:SetPrivilegedMode-off - читаются только КП, найденные протоколом по реализациям, доступным пользователю.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Попытка
		ИсточникиКП = МенеджерКП.ДанныеФирменнойПечати(МассивКП, ВидФормы, КодЯзыка, Новый Структура);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Для Каждого КлючИЗначение Из Предложения Цикл
		Источник = ИсточникиКП[КлючИЗначение.Значение];
		Если Источник <> Неопределено Тогда
			Результат.Вставить(КлючИЗначение.Ключ, Источник);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДоступныеДляЧтения(Ссылки)
	// Вне привилегированного режима: в протокол попадают только реализации, которые пользователь вправе читать вместе с
	// данными, которые КП печатает, - контрагентом, договором, организацией и номенклатурой. Адаптер КП читает их
	// привилегированно, поэтому ограничения записей (RLS) справочников проверяются здесь: роль «Клиент» читает
	// реализации без ограничения, а контрагентов и договоры - только свои (ai-security фазы 2, P0).
	Для Каждого ОбъектМетаданных Из ОбъектыДанныхПечатиКП() Цикл
		Если Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
			Возврат Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Реализации.Ссылка КАК Ссылка,
	|	Реализации.Организация КАК Организация,
	|	Реализации.Договор КАК Договор,
	|	Организации.Ссылка КАК ДоступнаяОрганизация,
	|	Договоры.Ссылка КАК ДоступныйДоговор
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Реализации.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО Реализации.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыСКонтрагентами КАК Договоры
	|		ПО Реализации.Договор = Договоры.Ссылка
	|ГДЕ
	|	Реализации.Ссылка В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	// Заполненные организация и договор, которых пользователь не вправе читать, РАЗРЕШЕННЫЕ соединение даёт NULL.
	Доступные = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОрганизацияДоступна = Не ЗначениеЗаполнено(Выборка.Организация) Или Выборка.ДоступнаяОрганизация <> NULL;
		ДоговорДоступен = Не ЗначениеЗаполнено(Выборка.Договор) Или Выборка.ДоступныйДоговор <> NULL;
		Если ОрганизацияДоступна И ДоговорДоступен Тогда
			Доступные.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Доступные;
КонецФункции

Функция ОбъектыДанныхПечатиКП()
	Объекты = Новый Массив;
	Объекты.Добавить(Метаданные.Документы.РеализацияТоваровУслуг);
	Объекты.Добавить(Метаданные.Справочники.Контрагенты);
	Объекты.Добавить(Метаданные.Справочники.ДоговорыСКонтрагентами);
	Объекты.Добавить(Метаданные.Справочники.Организации);
	Объекты.Добавить(Метаданные.Справочники.Номенклатура);
	Возврат Объекты;
КонецФункции

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	Если ВидФормы = "ФормаОбъекта" Тогда
		СтандартнаяОбработка = Ложь;
		Если ПараметрыСеанса.ПараметрыКлиентаНаСервере.ЭтоМобильныйКлиент Тогда
			ВыбраннаяФорма = "ФормаДокументаМобильныйКлиент";
		Иначе
			ВыбраннаяФорма = "ФормаДокумента";	
		КонецЕсли;	
	ИначеЕсли ВидФормы = "ФормаСписка" Тогда
		СтандартнаяОбработка = Ложь;
		Если ПараметрыСеанса.ПараметрыКлиентаНаСервере.ЭтоМобильныйКлиент Тогда
			ВыбраннаяФорма = "ФормаСпискаМобильныйКлиент";
		Иначе
			ВыбраннаяФорма = "ФормаСписка";	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти
