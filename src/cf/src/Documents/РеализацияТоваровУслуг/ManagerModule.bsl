	|	МАКСИМУМ(Date),
	|	МАКСИМУМ(Number),
	|	МАКСИМУМ(Devise),
	|	МАКСИМУМ(TotalSomme),
	|	МАКСИМУМ(TotalSommeTVA),
	|	МАКСИМУМ(Organisation),
	|	МАКСИМУМ(Основание)
	|ПО
	|	Ссылка";
	Query.Parameters.Insert("Ref", Док);
	// Подпись валюты: у документа в валюте - его валюта, иначе валюта договора.
	ВалютаДокумента = РаботаСВалютами.ВалютаИКурсОбъекта(Док);
	Query.УстановитьПараметр("ВВалюте", ВалютаДокумента.ВВалюте);
	Query.УстановитьПараметр("ВалютаДокумента", ВалютаДокумента.Валюта);
	Selection = Query.Execute().Select(ОбходРезультатаЗапроса.ПоГруппировкам);

	//AreaCaption = Template.GetArea("Caption");
	Header = Template.GetArea("Шапка");
	AreaTabularSection = Template.GetArea("Строка");
	AreaTabularSectionFooterTotal = Template.GetArea("Подвал"); 
	
	InsertPageBreak = False;
	While Selection.Next() Do
		//If InsertPageBreak Then
		//	Spreadsheet.PutHorizontalPageBreak();
		//EndIf;

		FirstRowNumber = Spreadsheet.TableHeight + 1;
		//StrNumber = 11;
		Header.Parameters.Fill(Selection);
		Header.Parameters.TypeDeTicket = ?(Selection.DocRef.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПродажаВКредит,"CREDIT","VENTE");
		
		If Selection.Organisation <> Catalogs.Организации.EmptyRef() Then 
			FieldPhoto = Selection.Organisation.Логотип.Get();
			Try
				Header.Drawings[0].Picture = New Picture(FieldPhoto);
			Except
			EndTry;
		EndIf;
		
		
		VT = РегистрыНакопления.ВзаиморасчётыСПокупателями.GetTableOfPayments(Selection.DocRef);
		TotalSommePaiementBA = 0;
		СтрСертификат = VT.Найти(Справочники.TypesDePayment.Сертификат);
		Если Не СтрСертификат = Неопределено Тогда 
			TotalSommePaiementBA = СтрСертификат.Somme;
		КонецЕсли;
		TotalSommePaiement = VT.Total("Somme") - TotalSommePaiementBA;
		Spreadsheet.Put(Header, Selection.Level());
		
		TotalSomme = 0;

		// Под строкой товара - IMEI и гарантия (docs/plans/industry-phones-2.md, п. 3).
		ДокументыЧека = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Selection.DocRef);
		СерииСтрок = СерийныйУчет.СерииСтрокДокументов("РеализацияТоваровУслуг", ДокументыЧека);
		Гарантии = СерийныйУчет.ГарантияМесяцев(Selection.DocRef.ТЧТовары.ВыгрузитьКолонку("Номенклатура"));
		SelectionTabularSection = Selection.Select();
		While SelectionTabularSection.Next() Do
			AreaTabularSection.Parameters.Fill(SelectionTabularSection);
			AreaTabularSection.Parameters.Code = SelectionTabularSection.Produit.Артикул;
			AreaTabularSection.Parameters.Descriptif = SelectionTabularSection.Produit.Наименование
				+ ДопСтрокаЧека(Selection.DocRef, SelectionTabularSection, СерииСтрок, Гарантии);
			AreaTabularSection.Parameters.Prix = SelectionTabularSection.Prix;
			Spreadsheet.Put(AreaTabularSection, SelectionTabularSection.Level());
			TotalSomme = TotalSomme + SelectionTabularSection.Somme;
			//StrNumber = StrNumber - 1;
		EndDo;
		
		AreaTabularSectionFooterTotal.Parameters.Total = ""+Format(Selection.TotalSomme,"ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
		AreaTabularSectionFooterTotal.Parameters.НадписьСертификат =  ?(TotalSommePaiementBA = 0, "", "Règlé par BA:");
		Если Не TotalSommePaiementBA = 0 Тогда 
			AreaTabularSectionFooterTotal.Parameters.TotalSommePaiementBA =  ""+Format(TotalSommePaiementBA,"ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
		КонецЕсли;
		AreaTabularSectionFooterTotal.Parameters.TotalSommePaiement =  ""+Format(TotalSommePaiement,"ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
		AreaTabularSectionFooterTotal.Parameters.ОстатокОплаты =  ""+Format(Selection.TotalSomme - TotalSommePaiement - TotalSommePaiementBA,"ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
		
		//Spreadsheet.BottomMargin = 20;
			ПараметрыШтрихкода = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
			ПараметрыШтрихкода.УровеньКоррекцииQR = 0;
			ПараметрыШтрихкода.Штрихкод = Selection.Ссылка.УникальныйИдентификатор();
			ПараметрыШтрихкода.УбратьЛишнийФон = Истина;
			ПараметрыШтрихкода.ТипКода  = 16; //QR
			ПараметрыШтрихкода.Ширина = 40;
			ПараметрыШтрихкода.Высота = 40;
			
			// Рисунок - перебором: в пользовательском макете чека его может не быть (tmpl-005).
			Штрихкод = ПечатныеФормы.РисунокОбласти(AreaTabularSectionFooterTotal, "QRcode");
			Если Штрихкод <> Неопределено Тогда
				Штрихкод.РазмерКартинки = РазмерКартинки.Пропорционально;
				Изображение = ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
				Если Изображение = Неопределено Тогда
					Штрихкод.Картинка = Новый Картинка;
				Иначе
					Штрихкод.Картинка = Изображение.Картинка;
				КонецЕсли;
				Штрихкод.ГраницаСверху = Ложь;
				Штрихкод.ГраницаСнизу  = Ложь;
				Штрихкод.ГраницаСправа = Ложь;
				Штрихкод.ГраницаСлева  = Ложь;
			КонецЕсли;
		
		Spreadsheet.Put(AreaTabularSectionFooterTotal);
		//InsertPageBreak = True;
		Spreadsheet.PutHorizontalPageBreak();
		//PrintManagement.SetDocumentPrintArea(Spreadsheet, FirstRowNumber, PrintObjects, Selection.DocRef);
	EndDo; 
	
	Return Spreadsheet;
	
	//}}
EndFunction

// КП из реализации: данные - из КП реализации (адаптер ДанныеФирменнойПечати), область печати и имя файла - по
// реализации. При включённой опции КП печатает документ КП.
//
// Параметры:
//  МассивОбъектов        - Массив - реализации.
//  ПараметрыПечати       - Структура - параметры команды печати.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - коллекция печатных форм.
//  ОбъектыПечати         - СписокЗначений - соответствие документов областям печати.
//
Процедура НапечататьКоммерческоеПредложение(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати)

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакетаКП()) Тогда
		ПроверитьДоступностьПечатиКП();
		ФирменнаяПечать.Напечатать(ИмяМакетаКП(), ВидФормыКП(), МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм,
			ОбъектыПечати);
	КонецЕсли;

КонецПроцедуры

// Отказ печати КП из реализации, если она недоступна (см. ПечатьКПДоступна): при включённой опции и роли без сумм.
// Вызывается и из адаптера ДанныеФирменнойПечати: общий механизм выбирает адаптер по типу ссылки, а не по менеджеру
// печати, поэтому проверка только в Печать обходилась бы передачей реализации менеджеру печати КП.
//
Процедура ПроверитьДоступностьПечатиКП()
	Если Документы.КоммерческоеПредложение.КПВводятсяВручную() Тогда
		ВызватьИсключение НСтр("ru = 'Включена опция «Коммерческие предложения»: коммерческое предложение печатает
			|документ «Коммерческое предложение».'; fr = 'L''option « Devis » est activée : le devis s''imprime
			|depuis le document « Devis ».'; en = 'The «Quotations» option is on: print the quotation from the
			|«Quotation» document.'; es = 'La opción «Presupuestos» está activada: el presupuesto se imprime desde
			|el documento «Presupuesto».'");
	КонецЕсли;
	Если Не ПечатьКПДоступна() Тогда
		ВызватьИсключение НСтр("ru = 'Печать коммерческого предложения из реализации недоступна вашей роли: в ней цены и
			|суммы.'; fr = 'L''impression du devis du bon de livraison n''est pas disponible pour votre rôle : il contient
			|des prix et des montants.'; en = 'Printing the quotation from the sales document is not available to your
			|role: it contains prices and amounts.'; es = 'La impresión del presupuesto del albarán no está disponible
			|para su rol: contiene precios e importes.'");
	КонецЕсли;
КонецПроцедуры

