	Template = Документы.РеализацияТоваровУслуг.ПолучитьМакет("FactureModelEnTete");
	Выборки = ВыборкиFacture(Док);
	Selection = Выборки.Selection;

	Области = ОбластиМакетаFacture(Template);
	Области.Вставить("НизРеквизиты", Template.ПолучитьОбласть("ОбластьНизРеквизиты"));
	Spreadsheet.РазмерСтраницы = "A4";
	Карточки = Новый Соответствие;
	Пока Selection.Следующий() Цикл
		ЕстьНДС = (Selection.TotalSommeTVA <> 0);
		ЗаполнитьШапкуFacture(Области.Header, Selection, Док.Дата, Карточки);
		ВыводПечатныхФорм.УстановитьЛоготип(Области.Header, Выборки.Логотипы[Selection.Ссылка]);
		Области.НизРеквизиты.Параметры.НижнийКолонтитул = ВыводПечатныхФорм.РеквизитыОрганизацииДляПодвала(
			Selection.Organisation, Док.Дата, КарточкаКонтрагента(Карточки, Selection.Organisation, Док.Дата));
		Spreadsheet.Вывести(Области.Header, Selection.Уровень());
		Spreadsheet.Вывести(Области.TabularSectionHeader);
		TotalRemise = ВывестиСтрокиFactureEnTete(Spreadsheet, Области, Selection);

		ОбластиПодвала = ОбластиПодвалаFacture(Области, Ложь, ЕстьНДС);
		Если Spreadsheet.ПроверитьВывод(ОбластиПодвала) Тогда
			// Подвал помещается - прижимаем его к низу страницы пустыми строками (с запасом в две строки).
			ВыводПечатныхФорм.ДобитьСтраницуПустымиСтроками(Spreadsheet, Области.EmptyLine, ОбластиПодвалаFacture(Области, Истина, ЕстьНДС));
		Иначе
			// Подвал не помещается - добиваем страницу, выводим реквизиты и переносим подвал на новую.
			ВыводПечатныхФорм.ДобитьСтраницуПустымиСтроками(Spreadsheet, Области.EmptyLine, МассивОбластей(Области.НизРеквизиты));
			Spreadsheet.Вывести(Области.НизРеквизиты);
		КонецЕсли;
		Если Не Spreadsheet.ПроверитьВывод(ОбластиПодвала) Тогда
			Spreadsheet.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ВывестиПодвалFacture(Spreadsheet, Области, Selection, Док, TotalRemise, ЕстьНДС);
		Spreadsheet.Вывести(Области.НизРеквизиты);
		Spreadsheet.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЦикла;

	Spreadsheet.АвтоМасштаб = Истина;
	Spreadsheet.ИспользуемоеИмяФайла = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, "Facture");
	Возврат Spreadsheet;

EndFunction

Функция ВыборкиFacture(Док)
	// Selection - выборка строк по группировкам (документ - строки), Логотипы - Соответствие документ - логотип.
	Query = Новый Запрос(ТекстЗапросаFacture());
	Query.УстановитьПараметр("Ref", Док);
	Результат = Query.ВыполнитьПакет();
	Логотипы = Новый Соответствие;
	Выборка = Результат[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Логотипы.Вставить(Выборка.Ссылка, Выборка.Логотип);
	КонецЦикла;
	Выборки = Новый Структура;
	Выборки.Вставить("Selection", Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Логотипы", Логотипы);
	Возврат Выборки;
КонецФункции

Функция ТекстЗапросаFacture()
	// Пакет: [0] строки, [1] шапки, [2] логотипы организаций по документам, [3] строки счёта-фактуры
	// по РТУ и налоговой накладной с реквизитами шапки, клиента и накладной (BL), с итогами по документу.
	Возврат
	"ВЫБРАТЬ
	|	Doc.Ссылка КАК Ссылка,
	|	Doc.НомерСтроки КАК LineNumber,
	|	Doc.Номенклатура КАК Produit,
	|	Doc.Количество КАК Quantite,
	|	Doc.Цена КАК Prix,
	|	Doc.СтавкаНДС КАК TVA,
	|	Doc.СуммаНДС КАК SommeTVA,
	|	Doc.СуммаСкидки КАК Remise,
	|	Doc.Сумма КАК Somme,
	|	Doc.СуммаСНДС КАК SommeTotale,
	|	Doc.Ссылка КАК BL,
	|	Doc.НоменклатураСтрока КАК НоменклатураСтрока
	|ПОМЕСТИТЬ ВТСтроки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК Doc
	|ГДЕ
	|	Doc.Ссылка = &Ref
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Doc.Ссылка,
	|	0,
	|	Doc.Номенклатура,
	|	Doc.Количество,
	|	Doc.Цена,
	|	Doc.СтавкаНДС,
	|	Doc.СуммаНДС,
	|	0,
	|	Doc.Сумма,
	|	Doc.СуммаСНДС,
	|	Doc.Ссылка,
	|	""""
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧУслуги КАК Doc
	|ГДЕ
	|	Doc.Ссылка = &Ref
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Doc.Ссылка,
	|	Doc.НомерСтроки,
	|	Doc.Номенклатура,
	|	Doc.Количество,
	|	Doc.Цена,
	|	Doc.СтавкаНДС,
	|	Doc.СуммаНДС,
	|	Doc.СуммаСкидки,
	|	Doc.Сумма,
	|	Doc.СуммаСНДС,
	|	Doc.ОтгрузкаТовара,
	|	Doc.НоменклатураСтрока
	|ИЗ
	|	Документ.НалоговаяНакладная.ТЧТовары КАК Doc
	|ГДЕ
	|	Doc.Ссылка = &Ref
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Doc.Ссылка,
	|	0,
	|	Doc.Номенклатура,
	|	Doc.Количество,
	|	Doc.Цена,
	|	Doc.СтавкаНДС,
	|	Doc.СуммаНДС,
	|	0,
	|	Doc.Сумма,
	|	Doc.СуммаСНДС,
	|	Doc.ОтгрузкаТовара,
	|	""""
	|ИЗ
	|	Документ.НалоговаяНакладная.ТЧУслуги КАК Doc
	|ГДЕ
	|	Doc.Ссылка = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.Ответственный КАК Ответственный,
	|	Шапка.Дата КАК Дата,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Договор КАК Договор,
	|	Шапка.Сумма КАК Сумма,
	|	Шапка.СуммаНДС КАК СуммаНДС,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Основание КАК Основание,
	|	Шапка.Комментарий КАК Комментарий
	|ПОМЕСТИТЬ ВТШапка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ref
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Шапка.Ссылка,
	|	Шапка.Контрагент,
	|	Шапка.Ответственный,
	|	ВЫБОР
	|		КОГДА Шапка.ДатаИнвойса = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА Шапка.Дата
	|		ИНАЧЕ Шапка.ДатаИнвойса
	|	КОНЕЦ,
	|	Шапка.Номер,
	|	Шапка.Договор,
	|	Шапка.Сумма,
	|	Шапка.СуммаНДС,
	|	Шапка.Организация,
	|	Шапка.Основание,
	|	Шапка.Комментарий
	|ИЗ
	|	Документ.НалоговаяНакладная КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТШапка.Ссылка КАК Ссылка,
	|	Организации.Логотип КАК Логотип
	|ИЗ
	|	ВТШапка КАК ВТШапка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ВТШапка.Организация = Организации.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТШапка.Ссылка КАК Ссылка,
	|	ВТШапка.Ссылка КАК DocRef,
	|	ВТШапка.Контрагент КАК Client,
	|	ВТШапка.Ответственный КАК Createur,
	|	ВТШапка.Дата КАК Date,
	|	ВТШапка.Номер КАК Number,
	|	ЕСТЬNULL(Договоры.ВалютаВзаиморасчётов, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК Devise,
	|	ВТШапка.Сумма КАК TotalSomme,
	|	ВТШапка.СуммаНДС КАК TotalSommeTVA,
	|	ВТШапка.Организация КАК Organisation,
	|	ВТШапка.Основание КАК Основание,
	|	ВТШапка.Комментарий КАК Комментарий,
	|	ЕСТЬNULL(Контрагенты.Код, """") КАК КодКлиента,
	|	ЕСТЬNULL(Контрагенты.Наименование, """") КАК НаименованиеКлиента,
	|	ЕСТЬNULL(Контрагенты.ТипОплаты, ЗНАЧЕНИЕ(Справочник.TypesDePayment.ПустаяСсылка)) КАК КлиентТипОплаты,
	|	ЕСТЬNULL(Контрагенты.ПечатьНакладнойЦеныБезНДС, ЛОЖЬ) КАК БезНДС,
	|	ВТСтроки.LineNumber КАК LineNumber,
	|	ВТСтроки.Produit КАК Produit,
	|	ЕСТЬNULL(Номенклатура.Артикул, """") КАК Артикул,
	|	ВТСтроки.Quantite КАК Quantite,
	|	ВТСтроки.Prix КАК Prix,
	|	ВТСтроки.TVA КАК TVA,
	|	ВТСтроки.SommeTVA КАК SommeTVA,
	|	ВТСтроки.Remise КАК Remise,
	|	ВТСтроки.Somme КАК Somme,
	|	ВТСтроки.SommeTotale КАК SommeTotale,
	|	ВТСтроки.BL КАК BL,
	|	ВТСтроки.НоменклатураСтрока КАК НоменклатураСтрока,
	|	ЕСТЬNULL(BLРеализация.Номер, ЕСТЬNULL(BLОтгрузка.Номер, """")) КАК BLНомер,
	|	ЕСТЬNULL(BLРеализация.Дата, ЕСТЬNULL(BLОтгрузка.Дата, ДАТАВРЕМЯ(1, 1, 1))) КАК BLДата
	|ИЗ
	|	ВТСтроки КАК ВТСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТШапка КАК ВТШапка
	|		ПО ВТСтроки.Ссылка = ВТШапка.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыСКонтрагентами КАК Договоры
	|		ПО ВТШапка.Договор = Договоры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВТШапка.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВТСтроки.Produit = Номенклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК BLРеализация
	|		ПО ВТСтроки.BL = BLРеализация.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтгрузкаТовара КАК BLОтгрузка
	|		ПО ВТСтроки.BL = BLОтгрузка.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	BL,
	|	LineNumber
	|ИТОГИ ПО
	|	Ссылка";
КонецФункции

Функция ОбластиМакетаFacture(Template)
	Области = Новый Структура;
	Области.Вставить("Header", Template.ПолучитьОбласть("Header"));
	Области.Вставить("TabularSectionHeader", Template.ПолучитьОбласть("TabularSectionHeader"));
	Области.Вставить("TabularSection", Template.ПолучитьОбласть("TabularSection"));
	Области.Вставить("EmptyLine", Template.ПолучитьОбласть("EmptyLine"));
	Области.Вставить("FooterSousTotal", Template.ПолучитьОбласть("TabularSectionFooterSousTotal"));
	Области.Вставить("FooterRemise", Template.ПолучитьОбласть("TabularSectionFooterRemise"));
	Области.Вставить("FooterTotal", Template.ПолучитьОбласть("TabularSectionFooterTotal"));
	Области.Вставить("FooterTotalTaxe", Template.ПолучитьОбласть("TabularSectionFooterTotalTaxe"));
	Области.Вставить("AmountInWritten", Template.ПолучитьОбласть("AmountInWritten"));
	Области.Вставить("LineBC", Template.ПолучитьОбласть("LineBC"));
	Области.Вставить("ПустаяСтрока", Template.ПолучитьОбласть("ОбластьПустаяСтрока"));
	Возврат Области;
КонецФункции

Функция ОбластиПодвалаFacture(Области, СЗапасом, ЕстьНДС)
	Массив = Новый Массив;
	Массив.Добавить(Области.FooterSousTotal);
	Если ЕстьНДС Тогда
		Массив.Добавить(Области.FooterTotalTaxe);
		Массив.Добавить(Области.FooterTotal);
	КонецЕсли;
	Массив.Добавить(Области.AmountInWritten);
	Если СЗапасом Тогда
		Массив.Добавить(Области.ПустаяСтрока);
		Массив.Добавить(Области.ПустаяСтрока);
	КонецЕсли;
	Если Области.Свойство("НизРеквизиты") Тогда
		Массив.Добавить(Области.НизРеквизиты);
	КонецЕсли;
	Возврат Массив;
КонецФункции

Процедура ЗаполнитьШапкуFacture(Header, Selection, ДатаДокумента, Карточки)
	Header.Параметры.Заполнить(Selection);
	Header.Параметры.Number = Selection.Number + "/" + Формат(Selection.Date, "Л=fr; ДФ=yy; ДЛФ=DD");
	Header.Параметры.Date = Формат(Selection.Date, "Л=fr; ДФ=dd/MM/yyyy; ДЛФ=DD");

	КарточкаКлиента = КарточкаКонтрагента(Карточки, Selection.Client, ДатаДокумента);
	Client = Selection.НаименованиеКлиента;
	Если ЗначениеЗаполнено(КарточкаКлиента.Реквизиты.АдресФактический) Тогда
		Client = Client + Символы.ПС + КарточкаКлиента.Реквизиты.АдресФактический;
	ИначеЕсли ЗначениеЗаполнено(КарточкаКлиента.Реквизиты.АдресЮридический) Тогда
		Client = Client + Символы.ПС + КарточкаКлиента.Реквизиты.АдресЮридический;
	КонецЕсли;
	Header.Параметры.Client = Client;
	Header.Параметры.Комментарий = Selection.Комментарий;
	Header.Параметры.ICE = ?(ЗначениеЗаполнено(КарточкаКлиента.Реквизиты.ICE), "ICE: " + КарточкаКлиента.Реквизиты.ICE, "");
	Header.Параметры.CodeClient = Selection.КодКлиента;
КонецПроцедуры

Функция ВывестиСтрокиFactureEnTete(Spreadsheet, Области, Selection)
	// Выводит строки документа; возвращает сумму скидок по строкам.
	SelectionTabularSection = Selection.Выбрать();
	TotalRemise = 0;
	BL = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	МасОбластей = Новый Массив;
	МасОбластей.Добавить(Области.TabularSection);
	МасОбластей.Добавить(Области.НизРеквизиты);
	Пока SelectionTabularSection.Следующий() Цикл
		Если BL <> SelectionTabularSection.BL И ЗначениеЗаполнено(SelectionTabularSection.BL) Тогда
			BL = SelectionTabularSection.BL;
			Области.LineBC.Параметры.BL = ПредставлениеBL(SelectionTabularSection.BLНомер, SelectionTabularSection.BLДата);
			Spreadsheet.Вывести(Области.LineBC);
		КонецЕсли;
		ЗаполнитьСтрокуFacture(Области.TabularSection, SelectionTabularSection, Selection.БезНДС);
		Если Не Spreadsheet.ПроверитьВывод(МасОбластей) Тогда
			Spreadsheet.Вывести(Области.НизРеквизиты);
			Spreadsheet.ВывестиГоризонтальныйРазделительСтраниц();
			Spreadsheet.Вывести(Области.Header, Selection.Уровень());
			Spreadsheet.Вывести(Области.TabularSectionHeader, Selection.Уровень());
		КонецЕсли;
		Spreadsheet.Вывести(Области.TabularSection, SelectionTabularSection.Уровень());
		TotalRemise = TotalRemise + SelectionTabularSection.Remise;
	КонецЦикла;
	Возврат TotalRemise;
КонецФункции

Процедура ЗаполнитьСтрокуFacture(Область, Стр, БезНДС)
	Область.Параметры.Заполнить(Стр);
	Область.Параметры.ID = Стр.Артикул;
	Область.Параметры.Descriptif = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Стр.Produit, "", , Истина,
		Стр.НоменклатураСтрока);
	Область.Параметры.TauxTVA = Стр.TVA;
	Область.Параметры.TVA = Стр.SommeTVA;
	Если БезНДС Тогда
		СуммаБезНДС = Стр.SommeTotale - Стр.SommeTVA;
		Область.Параметры.Prix = ?(Стр.Quantite = 0, 0, СуммаБезНДС / Стр.Quantite);
		Область.Параметры.Somme = СуммаБезНДС;
	КонецЕсли;
КонецПроцедуры

Процедура ВывестиПодвалFacture(Spreadsheet, Области, Selection, Док, TotalRemise, ЕстьНДС)
	Devise = Selection.Devise;
	Области.FooterSousTotal.Параметры.SousTotal = ФорматСуммы(Selection.TotalSomme - Selection.TotalSommeTVA, Devise);
	СпособОплаты = РаботаСДокументами.ПолучитьСпособОплаты(Док);
	Если Не ЗначениеЗаполнено(СпособОплаты) Тогда
		СпособОплаты = Selection.КлиентТипОплаты;
	КонецЕсли;
	Области.FooterSousTotal.Параметры.СпособОплаты = СпособОплаты;
	Spreadsheet.Вывести(Области.FooterSousTotal);
	Если TotalRemise <> 0 Тогда
		Области.FooterRemise.Параметры.Remise = ФорматСуммы(TotalRemise, Devise);
		Spreadsheet.Вывести(Области.FooterRemise);
	КонецЕсли;
	Если ЕстьНДС Тогда
		// При нулевом НДС строки «TOTAL T.V.A.» и «TOTAL T.T.C.» не выводятся - итог равен сумме без НДС.
		Области.FooterTotalTaxe.Параметры.TotalTaxe = ФорматСуммы(Selection.TotalSommeTVA, Devise);
		Spreadsheet.Вывести(Области.FooterTotalTaxe);
		Области.FooterTotal.Параметры.Total = ФорматСуммы(Selection.TotalSomme, Devise);
		Spreadsheet.Вывести(Области.FooterTotal);
	КонецЕсли;
	Области.AmountInWritten.Параметры.AmountInWritten = СуммаСчетаПрописью(Selection.TotalSomme);
	Spreadsheet.Вывести(Области.AmountInWritten);
КонецПроцедуры

Функция ПредставлениеBL(Номер, Дата)
	Возврат "BL: " + РаботаСДокументами.СформироватьЦифровойНомер(Номер) + "/" + Формат(Дата, "Л=fr; ДФ=yy; ДЛФ=DD")
		+ " " + Формат(Дата, "Л=fr; ДФ=dd/MM/yyyy; ДЛФ=DD");
КонецФункции

Функция СуммаСчетаПрописью(Сумма)
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	СуммаПрописью = Справочники.Валюты.СформироватьСуммуПрописью(Сумма, Валюта, Перечисления.Локализации.fr_CA);
	Заголовок = НСтр("ru = 'Сумма счета прописью:';
		|fr = 'Arrêtée la présente facture à la somme de :';
		|en = 'Invoice total in words:';
		|es = 'Total de la factura en letras:'");
	Возврат Заголовок + Символы.ПС + " *** " + ВРег(СуммаПрописью) + " *** ";
КонецФункции

Функция ФорматСуммы(Сумма, Валюта)
	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=0,00") + " " + Валюта;
КонецФункции

Функция КарточкаКонтрагента(Карточки, Владелец, Дата)
	// Карточка контрагента или организации с кэшированием в пределах одной печати.
	Карточка = Карточки.Получить(Владелец);
	Если Карточка = Неопределено Тогда
		Карточка = Справочники.Контрагенты.ПолучитьКарточку(Владелец, Дата);
		Карточки.Вставить(Владелец, Карточка);
	КонецЕсли;
	Возврат Карточка;
КонецФункции

Функция МассивОбластей(Область1, Область2 = Неопределено)
	Массив = Новый Массив;
	Массив.Добавить(Область1);
	Если Область2 <> Неопределено Тогда
		Массив.Добавить(Область2);
	КонецЕсли;
	Возврат Массив;
КонецФункции

