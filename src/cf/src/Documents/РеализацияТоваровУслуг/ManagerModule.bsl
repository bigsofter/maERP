EndFunction

Функция ПараметрыПечатиDevisBL(ИмяМакета, РазмерСтраницы, НазваниеДокумента, БезЦен, БезНДС = Ложь)
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяМакета", ИмяМакета);
	Параметры.Вставить("РазмерСтраницы", РазмерСтраницы);
	Параметры.Вставить("НазваниеДокумента", НазваниеДокумента);
	Параметры.Вставить("БезЦен", БезЦен);
	Параметры.Вставить("БезНДС", БезНДС);
	Параметры.Вставить("ОбластьИтогов", ?(БезНДС, "TabularSectionFooterTotalHT", "TabularSectionFooterTotal"));
	Параметры.Вставить("ПоказыватьОплаты", Ложь);
	Возврат Параметры;
КонецФункции

Функция ВывестиDevisBL(Док, Spreadsheet, Параметры)
	// Общий вывод Devis / BL / Avoir по РТУ, заказу покупателя и возвратам: макет, область итогов
	// и необходимость разбивки оплат задаются в Параметры (см. ПараметрыПечатиDevisBL).
	Template = Документы.РеализацияТоваровУслуг.ПолучитьМакет(Параметры.ИмяМакета);
	Query = Новый Запрос(ТекстЗапросаDevisBL());
	Query.УстановитьПараметр("Ref", Док);
	Результат = Query.ВыполнитьПакет();
	Логотипы = Новый Соответствие;
	Выборка = Результат[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Логотипы.Вставить(Выборка.Ссылка, Выборка.Логотип);
	КонецЦикла;
	Selection = Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Области = ОбластиМакетаDevisBL(Template, Параметры.ОбластьИтогов);
	Spreadsheet.РазмерСтраницы = Параметры.РазмерСтраницы;
	Spreadsheet.АвтоМасштаб = Истина;

	Карточки = Новый Соответствие;
	Пока Selection.Следующий() Цикл
		Карточка = КарточкаКонтрагента(Карточки, Selection.Organisation, Док.Дата);
		КарточкаКлиента = КарточкаКонтрагента(Карточки, Selection.Client, Док.Дата);
		Области.Header.Параметры.Заполнить(Selection);
		Области.Header.Параметры.Заполнить(ДанныеШапкиDevisBL(Selection, Карточка, КарточкаКлиента, Параметры.НазваниеДокумента));
		ВыводПечатныхФорм.УстановитьЛоготип(Области.Header, Логотипы[Selection.Ссылка]);
		Области.FooterCodes.Параметры.НижнийКолонтитул = ВыводПечатныхФорм.РеквизитыОрганизацииДляПодвала(
			Selection.Organisation, Док.Дата, Карточка);
		Spreadsheet.Вывести(Области.Header, Selection.Уровень());
		Spreadsheet.Вывести(Области.TabularSectionHeader);
		ВывестиСтрокиDevisBL(Spreadsheet, Области, Selection, Параметры.БезЦен, Параметры.БезНДС);

		Если Не Параметры.БезЦен Тогда
			Области.FooterTotal.Параметры.Total = ФорматСуммы(Selection.TotalSomme, Selection.Devise);
			Если Параметры.БезНДС Тогда
				Области.FooterTotal.Параметры.TotalHT = ФорматСуммы(Selection.TotalSomme - Selection.TotalTVA,
					Selection.Devise);
				Области.FooterTotal.Параметры.TotalTVA = ФорматСуммы(Selection.TotalTVA, Selection.Devise);
			КонецЕсли;
			Если Параметры.ПоказыватьОплаты Тогда
				ЗаполнитьОплатыВПодвале(Области.FooterTotal, Selection.DocRef, Selection.Client, Selection.TotalSomme, Selection.Devise);
			КонецЕсли;
		КонецЕсли;
		Spreadsheet.Вывести(Области.FooterTotal);
		ВыводПечатныхФорм.ДобитьСтраницуПустымиСтроками(Spreadsheet, Области.EmptyLine, МассивОбластей(Области.Footer, Области.FooterCodes));

		Области.Footer.Параметры.PrintDate = Формат(ТекущаяДатаСеанса(), "ДЛФ=D");
		Области.Footer.Параметры.PrintTime = Формат(ТекущаяДатаСеанса(), "ДЛФ=T");
		Области.Footer.Параметры.Author = Selection.Createur;
		Spreadsheet.Вывести(Области.Footer);
		Spreadsheet.Вывести(Области.FooterCodes);
		Spreadsheet.ПолеСнизу = 10;
		Spreadsheet.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЦикла;

	Spreadsheet.ИспользуемоеИмяФайла = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, Параметры.НазваниеДокумента);
	Возврат Spreadsheet;
КонецФункции

Функция ТекстЗапросаDevisBL()
	// Пакет: [0] строки, [1] шапки, [2] логотипы организаций по документам, [3] строки с реквизитами и итогами.
	// Упаковка услуг - единица измерения номенклатуры.
	Возврат
	"ВЫБРАТЬ
	|	Doc.Ссылка КАК Ссылка,
	|	Doc.НомерСтроки КАК LineNumber,
	|	Doc.Номенклатура КАК Produit,
	|	Doc.Количество КАК Quantite,
	|	Doc.Цена КАК Prix,
	|	Doc.Сумма КАК Somme,
	|	Doc.СуммаНДС КАК SommeTVA,
	|	Doc.СуммаСНДС КАК SommeTTC,
	|	Doc.Упаковка КАК Упаковка,
	|	Doc.НоменклатураСтрока КАК НоменклатураСтрока
	|ПОМЕСТИТЬ ВТСтроки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК Doc
	|ГДЕ
	|	Doc.Ссылка = &Ref
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Doc.Ссылка,
	|	Doc.НомерСтроки,
	|	Doc.Номенклатура,
	|	Doc.Количество,
	|	Doc.Цена,
	|	Doc.Сумма,
	|	Doc.СуммаНДС,
	|	Doc.СуммаСНДС,
	|	NULL,
	|	""""
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧУслуги КАК Doc
	|ГДЕ
	|	Doc.Ссылка = &Ref
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Doc.Ссылка,
	|	Doc.НомерСтроки,
	|	Doc.Номенклатура,
	|	Doc.Количество,
	|	Doc.Цена,
	|	Doc.Сумма,
	|	Doc.СуммаНДС,
	|	Doc.СуммаСНДС,
	|	Doc.Упаковка,
	|	Doc.НоменклатураСтрока
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Doc
	|ГДЕ
	|	Doc.Ссылка = &Ref
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Doc.Ссылка,
	|	Doc.НомерСтроки,
	|	Doc.Номенклатура,
	|	Doc.Количество,
	|	Doc.Цена,
	|	Doc.Сумма,
	|	Doc.СуммаНДС,
	|	Doc.СуммаСНДС,
	|	Doc.Упаковка,
	|	Doc.НоменклатураСтрока
	|ИЗ
	|	Документ.ВозвратОтПокупателя.ТЧТовары КАК Doc
	|ГДЕ
	|	Doc.Ссылка = &Ref
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Doc.Ссылка,
	|	Doc.НомерСтроки,
	|	Doc.Номенклатура,
	|	Doc.Количество,
	|	Doc.Цена,
	|	Doc.Сумма,
	|	Doc.СуммаНДС,
	|	Doc.СуммаСНДС,
	|	Doc.Упаковка,
	|	Doc.НоменклатураСтрока
	|ИЗ
	|	Документ.ВозвратОтПокупателяНалоговый.ТЧТовары КАК Doc
	|ГДЕ
	|	Doc.Ссылка = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.Ответственный КАК Ответственный,
	|	Шапка.Дата КАК Дата,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Договор КАК Договор,
	|	Шапка.Сумма КАК Сумма,
	|	Шапка.СуммаНДС КАК СуммаНДС,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Комментарий КАК Комментарий,
	|	Шапка.Основание КАК Заказ
	|ПОМЕСТИТЬ ВТШапка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ref
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Шапка.Ссылка,
	|	Шапка.Контрагент,
	|	Шапка.Ответственный,
	|	Шапка.Дата,
	|	Шапка.Номер,
	|	Шапка.Договор,
	|	Шапка.Сумма,
	|	Шапка.СуммаНДС,
	|	Шапка.Организация,
	|	Шапка.Комментарий,
	|	NULL
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ref
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Шапка.Ссылка,
	|	Шапка.Контрагент,
	|	Шапка.Ответственный,
	|	Шапка.Дата,
	|	Шапка.Номер,
	|	Шапка.Договор,
	|	Шапка.Сумма,
	|	Шапка.СуммаНДС,
	|	Шапка.Организация,
	|	Шапка.Комментарий,
	|	NULL
	|ИЗ
	|	Документ.ВозвратОтПокупателя КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ref
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Шапка.Ссылка,
	|	Шапка.Контрагент,
	|	Шапка.Ответственный,
	|	Шапка.Дата,
	|	Шапка.Номер,
	|	Шапка.Договор,
	|	Шапка.Сумма,
	|	Шапка.СуммаНДС,
	|	Шапка.Организация,
	|	Шапка.Комментарий,
	|	NULL
	|ИЗ
	|	Документ.ВозвратОтПокупателяНалоговый КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТШапка.Ссылка КАК Ссылка,
	|	Организации.Логотип КАК Логотип
	|ИЗ
	|	ВТШапка КАК ВТШапка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ВТШапка.Организация = Организации.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТШапка.Ссылка КАК Ссылка,
	|	ВТШапка.Ссылка КАК DocRef,
	|	ВТШапка.Контрагент КАК Client,
	|	ВТШапка.Ответственный КАК Createur,
	|	ВТШапка.Дата КАК Date,
	|	ВТШапка.Номер КАК Number,
	|	ЕСТЬNULL(Договоры.ВалютаВзаиморасчётов, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК Devise,
	|	ВТШапка.Сумма КАК TotalSomme,
	|	ВТШапка.СуммаНДС КАК TotalTVA,
	|	ВТШапка.Организация КАК Organisation,
	|	ВТШапка.Комментарий КАК Комментарий,
	|	ЕСТЬNULL(Контрагенты.Код, """") КАК КодКлиента,
	|	ЕСТЬNULL(Контрагенты.Наименование, """") КАК НаименованиеКлиента,
	|	ВЫБОР
	|		КОГДА ВТШапка.Ссылка ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ТОГДА ЕСТЬNULL(Заказ.Номер, """")
	|		ИНАЧЕ ВТШапка.Номер
	|	КОНЕЦ КАК НомерЗаказа,
	|	ВТСтроки.LineNumber КАК LineNumber,
	|	ВТСтроки.Produit КАК Produit,
	|	ВТСтроки.Quantite КАК Quantite,
	|	ВТСтроки.Prix КАК Prix,
	|	ВТСтроки.Somme КАК Somme,
	|	ВТСтроки.SommeTVA КАК SommeTVA,
	|	ВТСтроки.SommeTTC КАК SommeTTC,
	|	ВТСтроки.НоменклатураСтрока КАК НоменклатураСтрока,
	|	ВЫБОР
	|		КОГДА ВТСтроки.Упаковка ЕСТЬ NULL
	|			ТОГДА ЕСТЬNULL(Номенклатура.Единица, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка))
	|		ИНАЧЕ ВТСтроки.Упаковка
	|	КОНЕЦ КАК Упаковка
	|ИЗ
	|	ВТСтроки КАК ВТСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТШапка КАК ВТШапка
	|		ПО ВТСтроки.Ссылка = ВТШапка.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыСКонтрагентами КАК Договоры
	|		ПО ВТШапка.Договор = Договоры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВТШапка.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВТСтроки.Produit = Номенклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказ
	|		ПО ВТШапка.Заказ = Заказ.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	LineNumber
	|ИТОГИ ПО
	|	Ссылка";
КонецФункции

Функция ОбластиМакетаDevisBL(Template, ОбластьИтогов)
	Области = Новый Структура;
	Области.Вставить("Header", Template.ПолучитьОбласть("Header"));
	Области.Вставить("TabularSectionHeader", Template.ПолучитьОбласть("TabularSectionHeader"));
	Области.Вставить("TabularSection", Template.ПолучитьОбласть("TabularSection"));
	Области.Вставить("EmptyLine", Template.ПолучитьОбласть("EmptyLine"));
	Области.Вставить("FooterTotal", Template.ПолучитьОбласть(ОбластьИтогов));
	Области.Вставить("Footer", Template.ПолучитьОбласть("TabularSectionFooter"));
	Области.Вставить("FooterCodes", Template.ПолучитьОбласть("TabularSectionFooterCodes"));
	Возврат Области;
КонецФункции

Функция ДанныеШапкиDevisBL(Selection, Карточка, КарточкаКлиента, НазваниеДокумента)
	// Значения параметров шапки; в макете подставляются только те, что в нём есть (A5 и A4 различаются).
	Данные = Новый Структура;
	Данные.Вставить("Организация", Selection.Organisation);
	Данные.Вставить("НазваниеДокумента", НазваниеДокумента);
	Данные.Вставить("Комментарий", Selection.Комментарий);
	Данные.Вставить("НомерЗаказа", РаботаСДокументами.СформироватьЦифровойНомер(Selection.НомерЗаказа));
	Номер = РаботаСДокументами.СформироватьЦифровойНомер(Selection.Number) + "/" + Формат(Selection.Date, "Л=fr; ДФ=yy; ДЛФ=DD");
	Данные.Вставить("Number", НСтр("ru = 'Номер: '; fr = 'Numéro: '; en = 'Number: '; es = 'Número: '") + Номер);
	Дата = Формат(Selection.Date, "Л=fr; ДФ=dd/MM/yyyy; ДЛФ=DD");
	Данные.Вставить("Date", НСтр("ru = 'Дата: '; fr = 'Date: '; en = 'Date: '; es = 'Fecha: '") + Дата);

	Данные.Вставить("Адрес", Карточка.АдресЮридический);
	Данные.Вставить("Телефоны", МеткаТелефон() + Карточка.Телефоны);
	Данные.Вставить("RC", "RC: " + Карточка.Реквизиты.RC);
	Данные.Вставить("Patente", "PATENTE: " + Карточка.Реквизиты.TaxeProfessionnelle);
	Данные.Вставить("IF", "IF: " + Карточка.Реквизиты.NIF);
	Данные.Вставить("ICE", "ICE: " + Карточка.Реквизиты.ICE);
	Сайт = НСтр("ru = 'Сайт: '; fr = 'Site web: '; en = 'Website: '; es = 'Sitio web: '") + Карточка.Реквизиты.Web;
	Данные.Вставить("Site", Сайт);
	Данные.Вставить("Email", "E-mail: " + Карточка.Реквизиты.EMail);

	Client = Selection.НаименованиеКлиента;
	Если ЗначениеЗаполнено(КарточкаКлиента.Телефоны) Тогда
		Client = Client + Символы.ПС + МеткаТелефон() + КарточкаКлиента.Телефоны;
	КонецЕсли;
	Если ЗначениеЗаполнено(КарточкаКлиента.Реквизиты.ICE) Тогда
		Client = Client + Символы.ПС + "ICE: " + КарточкаКлиента.Реквизиты.ICE;
	КонецЕсли;
	Данные.Вставить("Client", Client);
	Возврат Данные;
КонецФункции

Функция МеткаТелефон()
	Возврат НСтр("ru = 'Тел.: '; fr = 'Tél.: '; en = 'Tel.: '; es = 'Tel.: '");
КонецФункции

Функция РазрядностьЦены()
	Возврат 2;
КонецФункции

Процедура ВывестиСтрокиDevisBL(Spreadsheet, Области, Selection, БезЦен, БезНДС = Ложь)
	SelectionTabularSection = Selection.Выбрать();
	НомерСтроки = 0;
	МасОбластей = Новый Массив;
	МасОбластей.Добавить(Области.TabularSection);
	МасОбластей.Добавить(Области.FooterTotal);
	МасОбластей.Добавить(Области.Footer);
	МасОбластей.Добавить(Области.FooterCodes);
	Пока SelectionTabularSection.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		Области.TabularSection.Параметры.Заполнить(SelectionTabularSection);
		Области.TabularSection.Параметры.LineNumber = НомерСтроки;
		Области.TabularSection.Параметры.Descriptif = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(
			SelectionTabularSection.Produit, "", , Истина, SelectionTabularSection.НоменклатураСтрока);
		Если БезНДС Тогда
			// Цена и сумма строки без НДС независимо от режима цен документа
			СуммаHT = SelectionTabularSection.SommeTTC - SelectionTabularSection.SommeTVA;
			Области.TabularSection.Параметры.Somme = СуммаHT;
			Области.TabularSection.Параметры.Prix = ?(SelectionTabularSection.Quantite = 0, 0,
				Окр(СуммаHT / SelectionTabularSection.Quantite, РазрядностьЦены()));
		Иначе
			Области.TabularSection.Параметры.Prix = ?(БезЦен, 0, SelectionTabularSection.Prix);
			Области.TabularSection.Параметры.Somme = ?(БезЦен, 0, SelectionTabularSection.Somme);
		КонецЕсли;
		Если Не Spreadsheet.ПроверитьВывод(МасОбластей) Тогда
			// Страница заполнена: добиваем её пустыми строками, выводим реквизиты и продолжаем на новой.
			ВыводПечатныхФорм.ДобитьСтраницуПустымиСтроками(Spreadsheet, Области.EmptyLine, МассивОбластей(Области.FooterCodes));
			Spreadsheet.Вывести(Области.FooterCodes);
			Spreadsheet.ВывестиГоризонтальныйРазделительСтраниц();
			Spreadsheet.Вывести(Области.Header, Selection.Уровень());
			Spreadsheet.Вывести(Области.TabularSectionHeader);
		КонецЕсли;
		Spreadsheet.Вывести(Области.TabularSection, SelectionTabularSection.Уровень());
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьОплатыВПодвале(Область, Документ, Клиент, СуммаДокумента, Валюта)
	// Разбивка оплат по документу: наличные, чеком, прочие, кредит (неоплаченный остаток) и долг клиента до документа.
	ОплатыИДолг = РегистрыНакопления.ВзаиморасчётыСПокупателями.ОплатыИДолгПоДокументу(Документ, Клиент);
	Область.Параметры.ТипОплатыНаличные = Справочники.TypesDePayment.Cash;
	Область.Параметры.ТипОплатыЧеком = Справочники.TypesDePayment.Cheque;
	Область.Параметры.ТипОплатыПрочие = НСтр("ru = 'Прочее'; fr = 'Autres'; en = 'Other'; es = 'Otros'");
	Область.Параметры.ТипОплатыКредит = Справочники.TypesDePayment.Credit;
	Область.Параметры.Наличные = ФорматСуммы(ОплатыИДолг.Наличные, Валюта);
	Область.Параметры.Чеком = ФорматСуммы(ОплатыИДолг.Чеком, Валюта);
	Область.Параметры.Прочие = ФорматСуммы(ОплатыИДолг.ВсегоОплачено - ОплатыИДолг.Наличные - ОплатыИДолг.Чеком, Валюта);
	Область.Параметры.Кредит = ФорматСуммы(СуммаДокумента - ОплатыИДолг.ВсегоОплачено, Валюта);
	Область.Параметры.ОстатокДолга = ОплатыИДолг.Долг;
КонецПроцедуры

