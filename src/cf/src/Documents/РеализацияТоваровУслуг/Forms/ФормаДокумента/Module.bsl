// Заголовок формы: номер, продажа клиенту, у организации, дата. Суммы и срока оплаты
// в заголовке нет - они всегда видны в подвале формы.
//
// Параметры:
//  Документ - ДанныеФормыСтруктура, ДокументОбъект - данные документа
//
// Возвращаемое значение:
//  Строка - текст заголовка; пустая строка, пока контрагент не выбран
//
&НаКлиентеНаСервереБезКонтекста
Функция ТекстРезюме(Документ)

	Если Не ЗначениеЗаполнено(Документ.Контрагент) Тогда
		Возврат "";
	КонецЕсли;

	Шаблон = НСтр("ru = '№ %1 · Продажа: %2 · %3 · %4';
		|fr = '№ %1 · Vente : %2 · %3 · %4';
		|en = 'No. %1 · Sale: %2 · %3 · %4';
		|es = '№ %1 · Venta: %2 · %3 · %4'");

	Возврат СтрШаблон(Шаблон,
		ОбщегоНазначенияКлиентСервер.НомерНаПечать(Документ.Номер),
		Документ.Контрагент,
		Документ.Организация,
		Формат(Документ.Дата, "ДЛФ=D"));

КонецФункции

// Пересчитывает заголовок формы: пока контрагент не выбран - стандартный заголовок
// документа, дальше - резюме сделки. Номер документа живёт в свёрнутой группе
// «Нумерация», поэтому в заголовке полезнее видеть суть, а не реквизиты.
//
&НаКлиенте
Процедура ОбновитьРезюме()

	Резюме = ТекстРезюме(Объект);
	Если Не ПустаяСтрока(Резюме) Тогда
		Заголовок = Резюме;
	КонецЕсли;

КонецПроцедуры

