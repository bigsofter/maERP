// Подбор неналоговых документов-оснований налогового документа (docs/plans/accounting-morocco-f1-s2.md): кандидаты
// того же контрагента и организации - в списке с отметками, отмеченные заполняют строки и табличную часть Основания.
//
// Параметры:
//  Команда - КомандаФормы - команда ПодобратьОснования.
//
&НаКлиенте
Процедура ПодобратьОснования(Команда)
	
	Кандидаты = КандидатыВОснованияНаСервере();
	Если Кандидаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет проведённых неналоговых документов этого контрагента и организации без налогового документа.';
			|fr = 'Aucun document non fiscal validé de ce tiers et de cette organisation sans document fiscal.';
			|en = 'There are no posted non-tax documents of this counterparty and company without a tax document.';
			|es = 'No hay documentos no fiscales contabilizados de esta contraparte y organización sin documento fiscal.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПодобратьОснованияЗавершение", ЭтотОбъект);
	Заголовок = НСтр("ru = 'Основания налогового документа'; fr = 'Documents de base du document fiscal';
		|en = 'Tax document bases'; es = 'Bases del documento fiscal'");
	Кандидаты.ПоказатьОтметкуЭлементов(Оповещение, Заголовок);
	
КонецПроцедуры

// Завершение подбора оснований: отмеченные документы заполняют налоговый документ на сервере.
//
// Параметры:
//  Список                  - СписокЗначений, Неопределено - кандидаты с отметками; Неопределено - отказ.
//  ДополнительныеПараметры - Неопределено - не используются.
//
&НаКлиенте
Процедура ПодобратьОснованияЗавершение(Список, ДополнительныеПараметры) Экспорт
	ЗапланироватьПроверкуПорога();
	
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отмеченные = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Если Элемент.Пометка Тогда
			Отмеченные.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Если Отмеченные.Количество() > 0 Тогда
		ЗаполнитьПоОснованиямНаСервере(Отмеченные);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КандидатыВОснованияНаСервере()
	
	Возврат НалоговыеДокументыНаОснованиях.КандидатыВОснования(Объект);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоОснованиямНаСервере(Знач Основания)
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	НалоговыеДокументыНаОснованиях.ЗаполнитьПоОснованиям(ДокОбъект, Основания);
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
	Налоговый = Не Объект.УУ;
	Модифицированность = Истина;
	
КонецПроцедуры

