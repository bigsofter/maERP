// Строки ниже порога склада сверяются после окончания правки строки и после действий, меняющих строки или шапку
// (план docs/plans/sales-profit-analytics.md, А4): один отложенный вызов сервера, во время ввода в ячейку не идёт.
&НаКлиенте
Процедура ЗапланироватьПроверкуПорога()
	Если ПодсветкаПорогаВозможна = Ложь Тогда
		Возврат;
	КонецЕсли;
	ЗадержкаСекунд = 0.5;
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьСтрокиНижеПорога", ЗадержкаСекунд, Истина);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьСтрокиНижеПорога()
	ПодсветкаПорогаВозможна = ОбновитьСтрокиНижеПорогаНаСервере();
КонецПроцедуры

// Подсветка цены и суммы строк ниже порога склада - тем же расчётом, что контроль при проведении. Показывает порог
// склада, а не прибыль: фактическая себестоимость известна после проведения (отчёт «Прибыль по документам»).
//
// Возвращаемое значение:
//  Булево - Ложь: для склада, даты и пользователя сверка не ведётся, повторять вызов незачем.
//
&НаСервере
Функция ОбновитьСтрокиНижеПорогаНаСервере()
	Возможна = КонтрольЦенПродажи.ПодсветкаСтрокВозможна(Объект.МестоХранения, Объект.Дата);
	Номера = Новый СписокЗначений;
	Если Возможна Тогда
		Номера.ЗагрузитьЗначения(КонтрольЦенПродажи.НомераСтрокНижеПорога(РеквизитФормыВЗначение("Объект")));
	КонецЕсли;
	ИмяОформления = "СтрокиНижеПорога";
	Оформление = Неопределено;
	Для Каждого Элемент Из УсловноеОформление.Элементы Цикл
		Если Элемент.Представление = ИмяОформления Тогда
			Оформление = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Оформление = Неопределено Тогда
		Если Номера.Количество() = 0 Тогда
			Возврат Возможна;
		КонецЕсли;
		Оформление = УсловноеОформление.Элементы.Добавить();
		Оформление.Представление = ИмяОформления;
		Для Каждого ИмяПоля Из СтрРазделить("ТЧТоварыЦена,ТЧТоварыСумма", ",") Цикл
			Оформление.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		КонецЦикла;
		Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТЧТовары.НомерСтроки");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Оформление.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОтрицательногоЧисла);
	КонецЕсли;
	Оформление.Отбор.Элементы[0].ПравоеЗначение = Номера;
	Оформление.Использование = Номера.Количество() > 0;
	Возврат Возможна;
КонецФункции

&НаКлиенте
Процедура ТЧТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
