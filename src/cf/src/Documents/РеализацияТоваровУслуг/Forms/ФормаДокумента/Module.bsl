&НаСервере
Процедура УстановитьЦеныНаСервере()
	ВалютаДокумента = Новый Структура("Валюта, Курс", ?(Объект.ВВалюте, Объект.Валюта, Неопределено),
		РаботаСВалютамиКлиентСервер.КурсДокумента(Объект));
	РаботаСДокументами.УстановитьЦеныВТабличнойЧасти(Объект.ТЧТовары, ВидЦены, Объект.Дата, Объект.ЦенаВключаетНДС,
		Объект.Контрагент, ВалютаДокумента);
	РаботаСВалютамиКлиентСервер.ПересчитатьСуммыРегл(Объект);
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьЦеныПоЗаказуНаСервере()
	Если Не ЗначениеЗаполнено(Объект.Основание) Тогда Возврат КонецЕсли;
	ТЗЗаказ = Объект.Основание.ТЧТовары.Выгрузить();
	// Заказ - в основной валюте, цены переводятся в валюту реализации по её курсу.
	Курс = РаботаСВалютамиКлиентСервер.КурсДокумента(Объект);
	Для Каждого Стр Из Объект.ТЧТовары Цикл
		СтрЗаказ = ТЗЗаказ.Найти(Стр.КодСтроки, "КодСтроки");
		Если СтрЗаказ = Неопределено Тогда
			Стр.ВидЦены = Неопределено;
			Стр.Цена = 0;
			Стр.ЦенаSKU = 0;
		Иначе	
			Стр.ВидЦены = СтрЗаказ.ВидЦены;
			Стр.Цена = СтрЗаказ.Цена / Курс;
			Стр.ЦенаSKU = СтрЗаказ.ЦенаSKU / Курс;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

