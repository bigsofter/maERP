Процедура ЗаполнитьПоОтгрузкамНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтгрузкаТовараТЧТовары.Ссылка КАК ОтгрузкаТовара,
	|	ОтгрузкаТовараТЧТовары.Номенклатура КАК Номенклатура,
	|	ОтгрузкаТовараТЧТовары.Характеристика КАК Характеристика,
	|	ОтгрузкаТовараТЧТовары.Упаковка КАК Упаковка,
	|	ОтгрузкаТовараТЧТовары.Серия КАК Серия,
	|	ОтгрузкаТовараТЧТовары.УказаноНесколькоСерий КАК УказаноНесколькоСерий,
	|	ОтгрузкаТовараТЧТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ОтгрузкиТоваровОстатки.КоличествоОстаток КАК Количество,
	|	ОтгрузкаТовараТЧТовары.ВидЦены КАК ВидЦены,
	|	ОтгрузкаТовараТЧТовары.ЦенаSKU КАК ЦенаSKU,
	|	ОтгрузкаТовараТЧТовары.Цена КАК Цена,
	|	ОтгрузкаТовараТЧТовары.Сумма КАК Сумма,
	|	ОтгрузкаТовараТЧТовары.ПроцентСкидки КАК ПроцентСкидки,
	|	ОтгрузкаТовараТЧТовары.СуммаСкидки КАК СуммаСкидки,
	|	ОтгрузкаТовараТЧТовары.СуммаСНДС КАК СуммаСНДС,
	|	ОтгрузкаТовараТЧТовары.СтавкаНДС КАК СтавкаНДС,
	|	ОтгрузкаТовараТЧТовары.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	РегистрНакопления.ОтгрузкиТоваров.Остатки(
	|			,
	|			Организация = &Организация
	|				И Контрагент = &Контрагент) КАК ОтгрузкиТоваровОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтгрузкаТовара.ТЧТовары КАК ОтгрузкаТовараТЧТовары
	|		ПО ОтгрузкиТоваровОстатки.ДокументОтгрузки = ОтгрузкаТовараТЧТовары.Ссылка
	|			И ОтгрузкиТоваровОстатки.Номенклатура = ОтгрузкаТовараТЧТовары.Номенклатура
	|ГДЕ
	|	НЕ ОтгрузкиТоваровОстатки.КоличествоОстаток = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтгрузкаТовараТЧУслуги.Ссылка КАК ОтгрузкаТовара,
	|	ОтгрузкаТовараТЧУслуги.Номенклатура КАК Номенклатура,
	|	ОтгрузкиТоваровОстатки.КоличествоОстаток КАК Количество,
	|	ОтгрузкаТовараТЧУслуги.Цена КАК Цена,
	|	ОтгрузкаТовараТЧУслуги.Сумма КАК Сумма,
	|	ОтгрузкаТовараТЧУслуги.СуммаСНДС КАК СуммаСНДС,
	|	ОтгрузкаТовараТЧУслуги.СтавкаНДС КАК СтавкаНДС,
	|	ОтгрузкаТовараТЧУслуги.СуммаНДС КАК СуммаНДС,
	|	ОтгрузкаТовараТЧУслуги.Содержание КАК Содержание
	|ИЗ
	|	РегистрНакопления.ОтгрузкиТоваров.Остатки(
	|			,
	|			Организация = &Организация
	|				И Контрагент = &Контрагент) КАК ОтгрузкиТоваровОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтгрузкаТовара.ТЧУслуги КАК ОтгрузкаТовараТЧУслуги
	|		ПО ОтгрузкиТоваровОстатки.ДокументОтгрузки = ОтгрузкаТовараТЧУслуги.Ссылка
	|			И ОтгрузкиТоваровОстатки.Номенклатура = ОтгрузкаТовараТЧУслуги.Номенклатура
	|ГДЕ
	|	НЕ ОтгрузкиТоваровОстатки.КоличествоОстаток = 0";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	П = Запрос.ВыполнитьПакет();
	Объект.ТЧТовары.Загрузить(П.Получить(0).Выгрузить());
	Объект.ТЧУслуги.Загрузить(П.Получить(1).Выгрузить());
КонецПроцедуры

