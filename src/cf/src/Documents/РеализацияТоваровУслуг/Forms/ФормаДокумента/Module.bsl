&НаСервере
Процедура ЗаполнитьИзExcelНаСервере(Мас)
	Объект.ТЧТовары.Очистить();
	Для Каждого Эл из Мас Цикл
		НС = Объект.ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС,Эл);
		НС.СтавкаНДС = НС.Номенклатура.СтавкаНДС;
		Если ЗначениеЗаполнено(НС.Номенклатура) Тогда 
			НС.Упаковка = НС.Номенклатура.Единица;
		КонецЕсли;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(НС);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоследниеЦены(Строка = Неопределено)
	ДатаЦен = ?(Объект.Ссылка.Пустая(),ТекущаяДата(),Объект.Дата);
	Номенклатура = Объект.ТЧТовары.Выгрузить().ВыгрузитьКолонку("Номенклатура");
	ТЗЦены = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(ДатаЦен,Номенклатура,Неопределено);
	Для Каждого Стр из Объект.ТЧТовары Цикл
		СтрЦена = ТЗЦены.Найти(Стр.Номенклатура);
		Стр.ЦенаЗакупкиПоследняя = ?(СтрЦена = Неопределено, 0, СтрЦена.Цена); 
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПродажиОбороты.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ПродажиОбороты.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_Периоды
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(
	|			,
	|			&ДатаЦен,
	|			Регистратор,
	|			Контрагент = &Контрагент
	|				И Номенклатура В (&Номенклатура)) КАК ПродажиОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Периоды.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Продажи.Количество <> 0
	|			ТОГДА Продажи.Выручка / Продажи.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	ВТ_Периоды КАК ВТ_Периоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи КАК Продажи
	|		ПО ВТ_Периоды.Период = Продажи.Период
	|			И ВТ_Периоды.Номенклатура = Продажи.Номенклатура";
	Запрос.УстановитьПараметр("ДатаЦен", Новый Граница(ДатаЦен,ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	ТЗЦены = Запрос.Выполнить().Выгрузить();
	Для Каждого Стр из Объект.ТЧТовары Цикл
		СтрЦена = ТЗЦены.Найти(Стр.Номенклатура);
		Стр.ЦенаПродажиПоследняя = ?(СтрЦена = Неопределено, 0, СтрЦена.Цена); 
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСрокОплатыНаСервере()
	СрокОплаты = РаботаСДокументами.ПолучитьСрокОплаты(Объект.Контрагент,?(Объект.Ссылка.Пустая(),ТекущаяДата(),Объект.Дата));
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьСуммыОплатыДолга()     
		
		СуммаДолга = "0,00";        
		СуммаОплаты  = "0,00"; 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ВзаиморасчётыСПокупателями.ОбъектРасчётов КАК ОбъектРасчётов,
		|	ВзаиморасчётыСПокупателями.Сумма КАК Сумма
		|ИЗ
		|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК ВзаиморасчётыСПокупателями
		|ГДЕ
		|	(ВЫРАЗИТЬ(ОбъектРасчётов КАК Документ.РеализацияТоваровУслуг)) = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка",объект.Ссылка);  
		
		Выборка = Запрос.Выполнить().Выгрузить();
		
	Если Выборка.Количество() = 0 Тогда иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ВзаиморасчётыСПокупателямиОстатки.ОбъектРасчётов КАК ОбъектРасчётов,
		|	ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, (ВЫРАЗИТЬ(ОбъектРасчётов КАК Документ.РеализацияТоваровУслуг)) = &Ссылка) КАК ВзаиморасчётыСПокупателямиОстатки";
		Запрос.УстановитьПараметр("Ссылка",объект.Ссылка); 
		
		Выборка = Запрос.Выполнить().Выгрузить();
		
		СуммаДолга = Строка(Выборка.Итог("Сумма"));        
		СуммаОплаты  = Строка(объект.Сумма - Выборка.Итог("Сумма"));
	КонецЕсли;

КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	МестоХранения = Объект.МестоХранения;
	Если Не ЗначениеЗаполнено(МестоХранения) Тогда
		МестоХранения = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	КонецЕсли;
	РегистрыНакопления.ТоварыВНаличии.ЗаполнитьОстаткиСтрок(Объект.ТЧТовары, МестоХранения);
КонецПроцедуры

