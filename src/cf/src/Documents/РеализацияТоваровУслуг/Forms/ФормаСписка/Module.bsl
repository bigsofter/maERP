#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если РольДоступна("PDV") Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("МестоХранения");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = РегистрыСведений.НастройкиПользователей.СкладПользователя();
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	НомерСтраницы = 1;
	ПрименитьСтраницу();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Состояние панели сведений восстанавливается из сохранённых данных формы.
	ПрименитьСостояниеПанели();

КонецПроцедуры

&НаКлиенте
Процедура ФильтрОперацииПриИзменении(Элемент)

	ПрименитьФильтрОперации();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ПрименитьОтборы();

КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	// Отложенно: при листании стрелками не дёргать сервер на каждую строку.
	// BSLLS:MagicNumber-off - треть секунды, константа имени не добавит.
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьСведения", 0.3, Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьСведения()

	Ссылка = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьСведения(Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Создаёт реализации по выделенным заказам закладки «Заказы к отгрузке».
// Один заказ - открывается форма нового документа; несколько - документы создаются
// и записываются без проведения, чтобы кладовщик проверил и провёл каждый сам.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда
//
&НаКлиенте
Процедура ОформитьРеализацию(Команда)

	Заказы = Элементы.СписокЗаказы.ВыделенныеСтроки;
	Если Заказы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Выделите заказы, по которым оформить реализацию';
				|fr = 'Sélectionnez les commandes pour créer la vente';
				|en = 'Select the orders to create the sale for';
				|es = 'Seleccione los pedidos para crear la venta'"));
		Возврат;
	КонецЕсли;

	Если Заказы.Количество() = 1 Тогда
		ОткрытьФорму("Документ.РеализацияТоваровУслуг.ФормаОбъекта",
			Новый Структура("Основание", Заказы[0]));
		Возврат;
	КонецЕсли;

	Создано = СоздатьРеализацииНаСервере(Заказы);
	Элементы.Список.Обновить();
	Заголовок = НСтр("ru = 'Создание реализаций'; fr = 'Création des ventes';
		|en = 'Creating sales'; es = 'Creación de ventas'");
	ШаблонТекста = НСтр("ru = 'Создано документов: %1 (записаны без проведения)';
		|fr = 'Documents créés : %1 (enregistrés sans validation)';
		|en = 'Documents created: %1 (saved without posting)';
		|es = 'Documentos creados: %1 (guardados sin validar)'");
	Текст = СтрШаблон(ШаблонТекста, Создано);
	ПоказатьОповещениеПользователя(Заголовок, , Текст);

КонецПроцедуры

&НаКлиенте
Процедура СвернутьПанель(Команда)

	ПанельСвернута = Истина;
	ПрименитьСостояниеПанели();

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьПанель(Команда)

	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФильтры(Команда)

	ОткрытьСтраницуПанели("СтраницаФильтры");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКлиента(Команда)

	ОткрытьСтраницуПанели("СтраницаКлиент");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДетали(Команда)

	ОткрытьСтраницуПанели("СтраницаИнфо");

КонецПроцедуры

&НаКлиенте
Процедура СтраницаНазад(Команда)

	Если НомерСтраницы > 1 Тогда
		НомерСтраницы = НомерСтраницы - 1;
		ПрименитьСтраницу();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтраницаВперед(Команда)

	Если НомерСтраницы < ВсегоСтраниц Тогда
		НомерСтраницы = НомерСтраницы + 1;
		ПрименитьСтраницу();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Свёрнутая панель - столбик значков, развёрнутая - закладки со страницами.
// Значок открывает панель сразу на своей странице, как в УНФ.
//
&НаКлиенте
Процедура ПрименитьСостояниеПанели()

	Элементы.ГруппаПанельЗначки.Видимость = ПанельСвернута;
	Элементы.ГруппаШапкаПанели.Видимость = Не ПанельСвернута;
	Элементы.ГруппаСтраницыСведений.Видимость = Не ПанельСвернута;

КонецПроцедуры

// Разворачивает панель и активирует страницу по имени.
//
// Параметры:
//  ИмяСтраницы - Строка - имя страницы панели сведений
//
&НаКлиенте
Процедура ОткрытьСтраницуПанели(ИмяСтраницы)

	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();
	Элементы.ГруппаСтраницыСведений.ТекущаяСтраница = Элементы[ИмяСтраницы];

КонецПроцедуры

// Отбирает список по виду хозяйственной операции: 0 - все, 1 - продажи клиенту,
// 2 - накладные по отгрузкам. Отбор ставится программно, чтобы тумблер над списком
// и настройки списка не спорили за один и тот же элемент отбора.
//
&НаСервере
Процедура ПрименитьФильтрОперации()

	Поле = Новый ПолеКомпоновкиДанных("ХозяйственнаяОперация");

	Элемент = Неопределено;
	Для Каждого Существующий Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(Существующий) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Существующий.ЛевоеЗначение = Поле Тогда
			Элемент = Существующий;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Операция = ОперацияФильтра();
	Если Операция = Неопределено Тогда
		Если Элемент <> Неопределено Тогда
			Список.Отбор.Элементы.Удалить(Элемент);
		КонецЕсли;
	Иначе
		Если Элемент = Неопределено Тогда
			Элемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Элемент.ЛевоеЗначение = Поле;
			Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		Элемент.ПравоеЗначение = Операция;
		Элемент.Использование = Истина;
	КонецЕсли;

	НомерСтраницы = 1;
	ПрименитьСтраницу();

КонецПроцедуры

// Хозяйственная операция по позиции тумблера фильтра, Неопределено - без отбора.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ХозяйственныеОперации, Неопределено
//
&НаСервере
Функция ОперацияФильтра()

	// Позиции тумблера: 0 - все, 1 - продажа, 2 - по отгрузкам, 3 - в кредит.
	// BSLLS:MagicNumber-off - значения объявлены списком выбора поля на форме.
	Операции = Перечисления.ХозяйственныеОперации;
	Если ФильтрОперации = 1 Тогда
		Возврат Операции.РеализацияКлиенту;
	ИначеЕсли ФильтрОперации = 2 Тогда
		Возврат Операции.НакладнаяПоОтгрузкамТовара;
	ИначеЕсли ФильтрОперации = 3 Тогда
		Возврат Операции.ПродажаВКредит;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецФункции

// Ставит либо снимает отборы динамического списка по полям правой панели.
// Отборы программные: пользовательские настройки списка их не перетирают.
//
&НаСервере
Процедура ПрименитьОтборы()

	Отборы = Новый Структура;
	Отборы.Вставить("Контрагент", ОтборКонтрагент);
	Отборы.Вставить("Организация", ОтборОрганизация);
	Отборы.Вставить("МестоХранения", ОтборСклад);
	Отборы.Вставить("Ответственный", ОтборОтветственный);

	Для Каждого Отбор Из Отборы Цикл
		УстановитьОтборПоПолю(Отбор.Ключ, Отбор.Значение);
	КонецЦикла;

	НомерСтраницы = 1;
	ПрименитьСтраницу();

КонецПроцедуры

// Один программный элемент отбора списка: значение пусто - элемент снимается.
// Список значений отбирается видом сравнения «В списке».
//
// Параметры:
//  Поле     - Строка       - имя поля динамического списка
//  Значение - Произвольный - отбираемое значение или СписокЗначений
//
&НаСервере
Процедура УстановитьОтборПоПолю(Поле, Значение)

	ПолеКомпоновки = Новый ПолеКомпоновкиДанных(Поле);

	Найденный = Неопределено;
	Для Каждого Элемент Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Элемент.ЛевоеЗначение = ПолеКомпоновки Тогда
			Найденный = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЗначениеПусто = Не ЗначениеЗаполнено(Значение);
	Если ЗначениеПусто Тогда
		Если Найденный <> Неопределено Тогда
			Список.Отбор.Элементы.Удалить(Найденный);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Найденный = Неопределено Тогда
		Найденный = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Найденный.ЛевоеЗначение = ПолеКомпоновки;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Найденный.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Иначе
		Найденный.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	КонецЕсли;
	Найденный.ПравоеЗначение = Значение;
	Найденный.Использование = Истина;

КонецПроцедуры

// Постраничный просмотр: список ограничивается ссылками текущей страницы,
// счётчик «N / M» считается тем же набором условий, что и отборы панели.
// Страницы режутся по дате от новых к старым.
//
&НаСервере
Процедура ПрименитьСтраницу()

	// BSLLS:MagicNumber-off - размер страницы, используется только здесь.
	РазмерСтраницы = 50;
	// BSLLS:MagicNumber-on

	Условия = Новый Массив;
	Запрос = Новый Запрос;

	Операция = ОперацияФильтра();
	Если Операция <> Неопределено Тогда
		Условия.Добавить("Док.ХозяйственнаяОперация = &Операция");
		Запрос.УстановитьПараметр("Операция", Операция);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборКонтрагент) Тогда
		Условия.Добавить("Док.Контрагент = &Контрагент");
		Запрос.УстановитьПараметр("Контрагент", ОтборКонтрагент);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		Условия.Добавить("Док.Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", ОтборОрганизация);
	КонецЕсли;
	СкладОтбора = ОтборСклад;
	// BSLLS:IsInRoleMethod-off - тот же принудительный отбор склада, что и в ПриСозданииНаСервере.
	Если Не ЗначениеЗаполнено(СкладОтбора) И РольДоступна("PDV") Тогда
		СкладОтбора = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	КонецЕсли;
	// BSLLS:IsInRoleMethod-on
	Если ЗначениеЗаполнено(СкладОтбора) Тогда
		Условия.Добавить("Док.МестоХранения = &Склад");
		Запрос.УстановитьПараметр("Склад", СкладОтбора);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборОтветственный) Тогда
		Условия.Добавить("Док.Ответственный = &Ответственный");
		Запрос.УстановитьПараметр("Ответственный", ОтборОтветственный);
	КонецЕсли;

	ТекстУсловий = "";
	Если Условия.Количество() > 0 Тогда
		ТекстУсловий = "
			|ГДЕ
			|	" + СтрСоединить(Условия, "
			|	И ");
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Док.Ссылка) КАК Всего
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Док" + ТекстУсловий;
	Выборка = Запрос.Выполнить().Выбрать();
	Всего = 0;
	Если Выборка.Следующий() Тогда
		Всего = Выборка.Всего;
	КонецЕсли;

	ВсегоСтраниц = Макс(1, Цел((Всего + РазмерСтраницы - 1) / РазмерСтраницы));
	НомерСтраницы = Макс(1, НомерСтраницы);
	НомерСтраницы = Мин(НомерСтраницы, ВсегоСтраниц);

	ПолеСсылки = "Ссылка";
	Если ВсегоСтраниц = 1 Тогда
		УстановитьОтборПоПолю(ПолеСсылки, Неопределено);
	Иначе
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ " + Формат(НомерСтраницы * РазмерСтраницы, "ЧГ=") + "
			|	Док.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК Док" + ТекстУсловий + "
			|
			|УПОРЯДОЧИТЬ ПО
			|	Док.Дата УБЫВ,
			|	Док.Ссылка";
		Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

		СсылкиСтраницы = Новый СписокЗначений;
		Для Индекс = (НомерСтраницы - 1) * РазмерСтраницы По Ссылки.ВГраница() Цикл
			СсылкиСтраницы.Добавить(Ссылки[Индекс]);
		КонецЦикла;
		УстановитьОтборПоПолю(ПолеСсылки, СсылкиСтраницы);
	КонецЕсли;

	Элементы.НадписьСтраницы.Заголовок = СтрШаблон("%1 / %2", НомерСтраницы, ВсегоСтраниц);
	Элементы.КнопкаСтраницаНазад.Доступность = НомерСтраницы > 1;
	Элементы.КнопкаСтраницаВперед.Доступность = НомерСтраницы < ВсегоСтраниц;

КонецПроцедуры

// Правая панель: страницы «Клиент» (о покупателе) и «Детали» (о документе с составом).
//
// Параметры:
//  Ссылка - ДокументСсылка.РеализацияТоваровУслуг - текущая строка списка
//
&НаСервере
Процедура ЗаполнитьСведения(Знач Ссылка)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Док.Контрагент КАК Контрагент,
		|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
		|	Док.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
		|	Док.Организация КАК Организация,
		|	Док.МестоХранения КАК МестоХранения,
		|	Док.Ответственный КАК Ответственный,
		|	Док.Менеджер КАК Менеджер,
		|	Док.Сумма КАК Сумма,
		|	Док.СуммаБезНДС КАК СуммаБезНДС,
		|	Док.СуммаНДС КАК СуммаНДС,
		|	Док.Комментарий КАК Комментарий
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Док
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО Контрагенты.Ссылка = Док.Контрагент
		|ГДЕ
		|	Док.Ссылка = &Ссылка
		|;
		|ВЫБРАТЬ
		|	Реквизиты.Реквизит КАК Реквизит,
		|	Реквизиты.Представление КАК Представление
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Док
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыКонтрагентов КАК Реквизиты
		|		ПО Реквизиты.Контрагент = Док.Контрагент
		|ГДЕ
		|	Док.Ссылка = &Ссылка
		|;
		|ВЫБРАТЬ
		|	СУММА(Остатки.СуммаОстаток) КАК Долг
		|ИЗ
		|	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(
		|		,
		|		Контрагент В
		|			(ВЫБРАТЬ
		|				Док.Контрагент КАК Контрагент
		|			ИЗ
		|				Документ.РеализацияТоваровУслуг КАК Док
		|			ГДЕ
		|				Док.Ссылка = &Ссылка)) КАК Остатки
		|;
		|ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	СУММА(Товары.Количество) КАК Количество,
		|	СУММА(Товары.СуммаСНДС) КАК Сумма
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	Товары.Номенклатура");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результаты = Запрос.ВыполнитьПакет();

	Шапка = Результаты[0].Выбрать();
	Если Не Шапка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	// Страница «Клиент»: имя, контакты и общий долг покупателя.
	Строки = Новый Массив;
	Строки.Добавить(Строка(Шапка.Контрагент));
	Если ЗначениеЗаполнено(Шапка.НаименованиеПолное) Тогда
		Строки.Добавить(Шапка.НаименованиеПолное);
	КонецЕсли;
	Строки.Добавить("");
	Контакты = Результаты[1].Выбрать();
	Пока Контакты.Следующий() Цикл
		Строки.Добавить(Строка(Контакты.Реквизит) + ": " + Контакты.Представление);
	КонецЦикла;
	ФорматСуммы = "ЧДЦ=2; ЧРГ=' '";
	Долги = Результаты[2].Выбрать();
	Если Долги.Следующий() И ЗначениеЗаполнено(Долги.Долг) Тогда
		Строки.Добавить("");
		ШаблонДолга = НСтр("ru = 'Долг всего: %1'; fr = 'Dette totale : %1';
			|en = 'Total debt: %1'; es = 'Deuda total: %1'");
		ДолгСтрокой = Формат(Долги.Долг, ФорматСуммы);
		Строки.Добавить(СтрШаблон(ШаблонДолга, ДолгСтрокой));
	КонецЕсли;
	КлиентТекст = СтрСоединить(Строки, Символы.ПС);

	// Страница «Детали»: реквизиты документа, не выведенные колонками списка.
	Строки = Новый Массив;
	Строки.Добавить(Строка(Шапка.ХозяйственнаяОперация));
	Строки.Добавить(Строка(Шапка.Организация) + " · " + Строка(Шапка.МестоХранения));
	Строки.Добавить("");
	ШаблонСумм = НСтр("ru = 'Без НДС: %1  НДС: %2  Итого: %3';
		|fr = 'HT : %1  TVA : %2  Total : %3';
		|en = 'Net: %1  VAT: %2  Total: %3';
		|es = 'Sin IVA: %1  IVA: %2  Total: %3'");
	БезНДССтрокой = Формат(Шапка.СуммаБезНДС, ФорматСуммы);
	НДССтрокой = Формат(Шапка.СуммаНДС, ФорматСуммы);
	ИтогоСтрокой = Формат(Шапка.Сумма, ФорматСуммы);
	Строки.Добавить(СтрШаблон(ШаблонСумм, БезНДССтрокой, НДССтрокой, ИтогоСтрокой));
	Строки.Добавить("");
	ШаблонОтветственного = НСтр("ru = 'Ответственный: %1'; fr = 'Responsable : %1';
		|en = 'Responsible: %1'; es = 'Responsable: %1'");
	Строки.Добавить(СтрШаблон(ШаблонОтветственного, Строка(Шапка.Ответственный)));
	Если ЗначениеЗаполнено(Шапка.Менеджер) Тогда
		ШаблонМенеджера = НСтр("ru = 'Менеджер: %1'; fr = 'Manager : %1';
			|en = 'Manager: %1'; es = 'Gerente: %1'");
		Строки.Добавить(СтрШаблон(ШаблонМенеджера, Строка(Шапка.Менеджер)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Комментарий) Тогда
		Строки.Добавить("");
		Строки.Добавить(Шапка.Комментарий);
	КонецЕсли;
	ИнфоТекст = СтрСоединить(Строки, Символы.ПС);

	ТаблицаСостав.Очистить();
	Состав = Результаты[3].Выбрать();
	Пока Состав.Следующий() Цикл
		Строка = ТаблицаСостав.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Состав);
	КонецЦикла;

КонецПроцедуры

// Создаёт и записывает реализации по заказам. Проведение остаётся за пользователем:
// автоматическое проведение пачки скрыло бы ошибки остатков.
//
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказПокупателя - выделенные заказы
//
// Возвращаемое значение:
//  Число - сколько документов создано
//
&НаСервере
Функция СоздатьРеализацииНаСервере(Знач Заказы)

	Создано = 0;
	Для Каждого Заказ Из Заказы Цикл
		Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Продолжить;
		КонецЕсли;
		Док = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		Док.Дата = ТекущаяДатаСеанса();
		Док.Заполнить(Заказ);
		Док.Записать();
		Создано = Создано + 1;
	КонецЦикла;

	Возврат Создано;

КонецФункции

#КонецОбласти
