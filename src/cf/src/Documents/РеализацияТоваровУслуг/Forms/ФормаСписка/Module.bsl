// «Обновить» закладки «Товары»: незаписанные правки отбрасываются только с согласия пользователя.
//
// Параметры:
//  Команда - КомандаФормы - команда.
//
&НаКлиенте
Процедура ТоварыОбновить(Команда)

	Если СтрокаВводится Тогда
		Элементы.Товары.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	Число = ЧислоНезаписанныхСтрок();
	Если Число = 0 Тогда
		ЗагрузитьТоварыНаСервере();
		Возврат;
	КонецЕсли;
	// На время вопроса отложенная запись не идёт: иначе она сохранила бы отменяемые правки (ревью кода, круг 1).
	ОтключитьОбработчикОжидания("ЗаписатьСтрокиТоваровОжидание");
	Шаблон = НСтр("ru = 'Отменить незаписанные правки строк (%1)?'; fr = 'Annuler les modifications non enregistrées des lignes (%1) ?';
		|en = 'Cancel the unsaved line changes (%1)?'; es = '¿Cancelar los cambios de líneas sin guardar (%1)?'");
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбОтменеПравок", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, СтрШаблон(Шаблон, Число), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

// «Печать» закладки «Товары»: печатная форма документов выделенных записанных строк, каждого - целиком. Команды
// созданы в РазместитьКомандыПечатиТоваров.
//
// Параметры:
//  Команда - КомандаФормы - команда печатной формы.
//
&НаКлиенте
Процедура Подключаемый_ПечатьТоваров(Команда)

	Если СтрокаВводится Тогда
		Элементы.Товары.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	ОписаниеКоманды = Неопределено;
	Для Каждого Элемент Из КомандыПечатиТоваров Цикл
		Если Элемент.Представление = Команда.Имя Тогда
			ОписаниеКоманды = Элемент;
		КонецЕсли;
	КонецЦикла;
	Выделенные = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Товары.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы <> Неопределено И ЗначениеЗаполнено(СтрокаТаблицы.Документ)
			И Выделенные.Найти(СтрокаТаблицы.Документ) = Неопределено Тогда
			Выделенные.Добавить(СтрокаТаблицы.Документ);
		КонецЕсли;
	КонецЦикла;
	Если ОписаниеКоманды = Неопределено Или Выделенные.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выделите строки записанных накладных.';
			|fr = 'Sélectionnez des lignes de ventes enregistrées.'; en = 'Select lines of saved sales.';
			|es = 'Seleccione líneas de ventas guardadas.'"));
		Возврат;
	КонецЕсли;
	КПечати = ДокументыКПечатиНаСервере(Выделенные);
	Если КПечати.Количество() > 0 Тогда
		ПечатныеФормыКлиент.ВыполнитьКомандуПечати(ПолноеИмяДокумента(), ОписаниеКоманды.Значение, КПечати, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПечатьКоммерческоеПредложение(Команда)
	Реализации = Новый Массив;
	Для Каждого Выделенная Из Элементы.Список.ВыделенныеСтроки Цикл
		// Строки группировок списка - не документы.
		Если ТипЗнч(Выделенная) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Реализации.Добавить(Выделенная);
		КонецЕсли;
	КонецЦикла;
	Если Реализации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПечатныеФормыКлиент.ВыполнитьКомандуПечати("Документ.РеализацияТоваровУслуг", "КоммерческоеПредложение",
		Реализации, ЭтотОбъект);
КонецПроцедуры

// Создаёт реализации по выделенным заказам закладки «Заказы к отгрузке».
// Один заказ - открывается форма нового документа; несколько - документы создаются
// и записываются без проведения, чтобы кладовщик проверил и провёл каждый сам.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда
//
&НаКлиенте
Процедура ОформитьРеализацию(Команда)

	Заказы = Элементы.СписокЗаказы.ВыделенныеСтроки;
	Если Заказы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Выделите заказы, по которым оформить реализацию';
				|fr = 'Sélectionnez les commandes pour créer la vente';
				|en = 'Select the orders to create the sale for';
				|es = 'Seleccione los pedidos para crear la venta'"));
		Возврат;
	КонецЕсли;

	Если Заказы.Количество() = 1 Тогда
		ОткрытьФорму("Документ.РеализацияТоваровУслуг.ФормаОбъекта",
			Новый Структура("Основание", Заказы[0]));
		Возврат;
	КонецЕсли;

	Создано = СоздатьРеализацииНаСервере(Заказы);
	Элементы.Список.Обновить();
	Заголовок = НСтр("ru = 'Создание реализаций'; fr = 'Création des ventes';
		|en = 'Creating sales'; es = 'Creación de ventas'");
	ШаблонТекста = НСтр("ru = 'Создано документов: %1 (записаны без проведения)';
		|fr = 'Documents créés : %1 (enregistrés sans validation)';
		|en = 'Documents created: %1 (saved without posting)';
		|es = 'Documentos creados: %1 (guardados sin validar)'");
	Текст = СтрШаблон(ШаблонТекста, Создано);
	ПоказатьОповещениеПользователя(Заголовок, , Текст);

КонецПроцедуры

