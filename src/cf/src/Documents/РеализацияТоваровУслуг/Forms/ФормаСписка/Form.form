    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументРеализацияТоваровУслуг.Ссылка КАК Ссылка,
	ДокументРеализацияТоваровУслуг.Номер КАК Номер,
	ДокументРеализацияТоваровУслуг.Дата КАК Дата,
	ДокументРеализацияТоваровУслуг.Комментарий КАК Комментарий,
	ДокументРеализацияТоваровУслуг.Организация КАК Организация,
	ДокументРеализацияТоваровУслуг.Ответственный КАК Ответственный,
	ДокументРеализацияТоваровУслуг.Сумма КАК Сумма,
	ДокументРеализацияТоваровУслуг.СуммаНДС КАК СуммаНДС,
	ДокументРеализацияТоваровУслуг.СуммаБезНДС КАК СуммаБезНДС,
	ДокументРеализацияТоваровУслуг.Контрагент КАК Контрагент,
	ДокументРеализацияТоваровУслуг.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	ДокументРеализацияТоваровУслуг.МестоХранения КАК МестоХранения,
	ВЫБОР
		КОГДА ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.Собран)
				ИЛИ ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.Доставлен)
				ИЛИ ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.Отгружен)
			ТОГДА ВЫБОР
					КОГДА ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СрокОплаты = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
						ТОГДА ВЫБОР
								КОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) = 0
									ТОГДА 2
								ИНАЧЕ ВЫБОР
										КОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) &lt; ДокументРеализацияТоваровУслуг.Сумма
											ТОГДА 1
										ИНАЧЕ 2
									КОНЕЦ
							КОНЕЦ
					ИНАЧЕ ВЫБОР
							КОГДА &amp;ТекущаяДата > ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СрокОплаты
								ТОГДА ВЫБОР
										КОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) = 0
											ТОГДА ВЫБОР
													КОГДА ДокументРеализацияТоваровУслуг.Проведен = ИСТИНА
														ТОГДА 0
													ИНАЧЕ -1
												КОНЕЦ
										ИНАЧЕ ВЫБОР
												КОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) &lt; ДокументРеализацияТоваровУслуг.Сумма
													ТОГДА 1
												ИНАЧЕ 6
											КОНЕЦ
									КОНЕЦ
							ИНАЧЕ ВЫБОР
									КОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) = 0
										ТОГДА ВЫБОР
												КОГДА ДокументРеализацияТоваровУслуг.Проведен = ИСТИНА
													ТОГДА 0
												ИНАЧЕ -1
											КОНЕЦ
									ИНАЧЕ ВЫБОР
											КОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) &lt; ДокументРеализацияТоваровУслуг.Сумма
												ТОГДА 1
											ИНАЧЕ 2
										КОНЕЦ
								КОНЕЦ
						КОНЕЦ
				КОНЕЦ
		ИНАЧЕ -1
	КОНЕЦ КАК НомерКартинкиОплаты,
	ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) КАК Долг
ИЗ
	Документ.РеализацияТоваровУслуг КАК ДокументРеализацияТоваровУслуг
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних КАК ИсторияЗаказовПокупателейПоСтатусамСрезПоследних
		ПО ДокументРеализацияТоваровУслуг.Основание = ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.ЗаказПокупателя
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки КАК ВзаиморасчётыСПокупателямиОстатки
		ПО ДокументРеализацияТоваровУслуг.Ссылка = ВзаиморасчётыСПокупателямиОстатки.ОбъектРасчётов</queryText>
      <mainTable>Document.РеализацияТоваровУслуг</mainTable>
