
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	ЦенаВключаетНДС = Истина;
	// Налоговый документ на основаниях - из подбора в форме или команды списка (docs/plans/accounting-morocco-f1-s2.md);
	// прочие ветки ниже такие данные заполнения не узнают.
	НалоговыеДокументыНаОснованиях.ЗаполнитьПоДаннымЗаполнения(ЭтотОбъект, ДанныеЗаполнения);
	Ордера = ОрдераСклада.ОрдераОснования(ДанныеЗаполнения);
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		// Контроль повторного ввода по заказу снят: частичные отгрузки - по одному заказу
		// допускается несколько реализаций (решение владельца 2026-08-25).
		Дата = ТекущаяДатаСеанса();
		Основание = ДанныеЗаполнения;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Договор = ДанныеЗаполнения.Договор;
		Менеджер = ДанныеЗаполнения.Менеджер;
		ЦенаВключаетНДС = ДанныеЗаполнения.ЦенаВключаетНДС;
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
		Комментарий = ДанныеЗаполнения.Комментарий;
		Организация = ДанныеЗаполнения.Организация;
		//Рез = Документы.ЗаказПокупателя.ПолучитьТоварыПоГруппировкам(ДанныеЗаполнения);
		//ВыбГруппа = Рез.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		//Пока ВыбГруппа.Следующий() Цикл
		//	Выб = ВыбГруппа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		//	Пока Выб.Следующий() Цикл
		//    	СтрОснование = ДанныеЗаполнения.ТЧТовары.Найти(Выб.КодСтроки, "КодСтроки");
		//		НС = ТЧТовары.Добавить();
		//		ЗаполнитьЗначенияСвойств(НС, СтрОснование);
		//	КонецЦикла;	
		//КонецЦикла;
		ТЧТовары.Загрузить(ДанныеЗаполнения.ТЧТовары.Выгрузить());
		// Цены строк - в валюте заказа.
		РаботаСВалютами.ЗаполнитьВалютуПоОснованию(ЭтотОбъект, ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Организация = ДанныеЗаполнения.Организация;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(Контрагент, Организация, Истина); 
		МестоХранения = ДанныеЗаполнения.МестоХранения;
		Основание = ДанныеЗаполнения;		
		ЦенаВключаетНДС = ДанныеЗаполнения.ЦенаВключаетНДС;
		ТЧТовары.Загрузить(ДанныеЗаполнения.ТЧТовары.Выгрузить());
		ТЧСерии.Загрузить(ДанныеЗаполнения.ТЧСерии.Выгрузить());
		// Цены строк - в валюте поступления.
		РаботаСВалютами.ЗаполнитьВалютуПоОснованию(ЭтотОбъект, ДанныеЗаполнения);
	ИначеЕсли Ордера.Количество() > 0 Тогда
		// Оформление расходных ордеров - одного или нескольких (план warehouse-orders, фаза 2, §2.5).
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
		ОрдераСклада.ЗаполнитьПоОрдерам(ЭтотОбъект, Ордера);
	КонецЕсли;
КонецПроцедуры

// Ордерный склад: строки - только по расходным ордерам (план warehouse-orders, фаза 2, §2.5). Модуль без областей,
// как и прежние обработчики событий в нём: область для одного обработчика сделала бы весь код «вне области».
//
// Параметры:
//  Отказ                - Булево - выставляется при нарушении.
//  ПроверяемыеРеквизиты - Массив из Строка - не используется.
//
// BSLLS:EventHandlerOutsideEventRegion-off
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Документ на основаниях ордеров не оформляет: товар уже отгружен основаниями.
	Если НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	// Ордерный склад: строки - только по расходным ордерам (план warehouse-orders, фаза 2, §2.5).
	ОрдераСклада.ПроверитьОформление(ЭтотОбъект, Отказ);
КонецПроцедуры
// BSLLS:EventHandlerOutsideEventRegion-on

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	// Налоговый документ на основаниях - переклассификация движений оснований, без отгрузки (план С2).
	Если НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ЭтотОбъект) Тогда
		НалоговыеДокументыНаОснованиях.ПровестиДокумент(ЭтотОбъект, Отказ);
		Возврат;
	КонецЕсли;
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	// Данные для проведения
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ТЗТоварыССериями", СерииИРазмещение.ОбъединитьТоварыССериями(ЭтотОбъект));
	// Блокировки: строки реализации и всё, что возьмёт автовыпуск (E9). Реализация по ордерам берёт их в ПередЗаписью,
	// до автоудаления движений (warehouse-orders-cost, Ф3.8), - повторный захват в той же транзакции не конфликтует.
	КонтекстАвтовыпуска = Неопределено;
	Если Не ДополнительныеСвойства.Свойство("КонтекстАвтовыпускаПередЗаписью", КонтекстАвтовыпуска) Тогда
		КонтекстАвтовыпуска = Производство.КонтекстАвтовыпуска(ЭтотОбъект);
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка, КонтекстАвтовыпуска);
	Блокировка.Заблокировать();
	ОрдераСклада.ПроверитьОформление(ЭтотОбъект, Отказ);
	ОрдераСклада.ПроверитьСтаруюСхему(ЭтотОбъект, ДополнительныеСвойства.ОрдераДокумента, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Строки по расходным ордерам: расход к оформлению по строке - пары оформления (Ф3.2).
	ОрдераСклада.СформироватьДвиженияОформления(ЭтотОбъект);
	// Автовыпуск продукции заказа на производство - на секунду раньше реализации, до её списания по ФИФО (E9)
	Производство.ОбеспечитьАвтовыпуск(ЭтотОбъект, КонтекстАвтовыпуска, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Минимальная цена склада - после автовыпуска (его партии в остатке), до списания: следующая строка перезаписывает Отказ
	КонтрольЦенПродажи.ПроверитьДокумент(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Формируем
	Отказ = Не РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(ЭтотОбъект);
	Если Отказ Тогда Возврат КонецЕсли;
	РегистрыНакопления.ВзаиморасчётыСПокупателями.СформироватьДвижения(ЭтотОбъект);
	РегистрыНакопления.ВзаиморасчётыСПоставщиками.СформироватьПоДопРасходам(ЭтотОбъект);
	РегистрыНакопления.Продажи.СформироватьДвижения(ЭтотОбъект); // Рассчитывается на основании списанных партий и издержек
	// Записываем
	// Признак раздельного учёта движений (docs/plans/accounting-morocco-f1.md).
	НалоговыйУчет.УстановитьПризнакУУ(ЭтотОбъект);
	Движения.Записать();
	РегистрыНакопления.ТоварыКОформлению.ПроверитьОстатки(ДополнительныеСвойства.ОрдераДокумента, ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Себестоимость по парам: своя и соседей по строкам расходных ордеров (warehouse-orders-cost, Ф3.6, Ф3.7).
	ПересчитатьСебестоимостьПоПарам();
	ПроизводственныеЗаказы.ОбновитьСтадииПослеПроведения(ЭтотОбъект);
	// Покрывающий налоговый документ строится по движениям реализации - перепроводится следом (план С2).
	НалоговыеДокументыНаОснованиях.ПерепровестиПокрывающиеДокументы(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка), , ЭтотОбъект);
КонецПроцедуры

// Отмена проведения документа, затронувшего заказы клиента на производство: блокировки в порядке проведения,
// распроведение автовыпуска (E9), очистка движений и пересчёт стадий заказов (E8). Без таких заказов и автовыпуска
// движения удаляет платформа, как раньше.
//
// Параметры:
//  Отказ - Булево - устанавливается, если автовыпуск лежит в закрытом периоде.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	// Покрытое основание не распроводится; документ на основаниях - без автовыпуска и ордеров (план С2).
	НалоговыеДокументыНаОснованиях.ПроверитьСнятиеДокумента(ЭтотОбъект, Отказ);
	Если Отказ Или НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	КонтекстАвтовыпуска = Производство.КонтекстАвтовыпуска(ЭтотОбъект, Истина);
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка, КонтекстАвтовыпуска);
	Если КонтекстАвтовыпуска.Автовыпуски.Количество() > 0 Тогда
		Блокировка.Заблокировать();
		Производство.ОтменитьАвтовыпуск(ЭтотОбъект, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ПроизводственныеЗаказы.ОтменитьПроведениеДокумента(ЭтотОбъект, Блокировка);
	ОтменитьОформлениеОрдеров(Отказ);
КонецПроцедуры

// Отмена оформления расходных ордеров: расход ТоварыКОформлению документа снимается, контроль остатков - как при
// проведении. Без ордеров - ничего.
//
// Параметры:
//  Отказ - Булево - выставляется при нарушении.
//
Процедура ОтменитьОформлениеОрдеров(Отказ)
	Ордера = ДополнительныеСвойства.ОрдераДокумента;
	Если Ордера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ОрдераСклада.ПроверитьСтаруюСхему(ЭтотОбъект, Ордера, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Набор = Движения.ТоварыКОформлению;
	Набор.Очистить();
	Набор.Записать();
	РегистрыНакопления.ТоварыКОформлению.ПроверитьОстатки(Ордера, ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Пары ушли - доли соседей по строкам ордеров пересчитываются (warehouse-orders-cost, Ф3.7).
	ПересчитатьСебестоимостьПоПарам();
КонецПроцедуры

// Ближний пересчёт себестоимости реализаций по строкам расходных ордеров документа, прежним и новым (Ф3.7).
//
Процедура ПересчитатьСебестоимостьПоПарам()
	СтрокиОрдеров = Неопределено;
	Если ДополнительныеСвойства.Свойство("СтрокиОрдеровДокумента", СтрокиОрдеров) Тогда
		РегистрыНакопления.СебестоимостьПродаж.ПересчитатьПоПарам(СтрокиОрдеров, ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

// Реализация по ордерам при проведении и отмене проведения берёт полный набор блокировок до автоудаления движений
// (warehouse-orders-cost, Ф3.8): иначе неявные блокировки удаляемых наборов встали бы раньше явных и дали встречный путь
// с ближним пересчётом расходного ордера. Порядок: склады, остатки, взаиморасчёты, потребности автовыпуска,
// ТоварыКОформлению по прежним и новым ордерам, затем себестоимость своей и соседних реализаций.
//
// Параметры:
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//
Процедура ЗаблокироватьОрдерныеДанные(РежимЗаписи)
	ОрдераСклада.ЗаблокироватьРеализациюПоОрдерам(ЭтотОбъект, РежимЗаписи);
КонецПроцедуры

// Прямое удаление реализации кодом снимает её движения без ОбработкаУдаленияПроведения: автовыпуск распроводится и
// помечается на удаление, чтобы не остаться проведённым с потерянным основанием (E9).
//
// Параметры:
//  Отказ - Булево - устанавливается, если автовыпуск лежит в закрытом периоде.
//
Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	НезавершенныеПродажиКассы.ПроверитьСменуДокумента(ЭтотОбъект, Неопределено, Отказ);
	НалоговыеДокументыНаОснованиях.ПроверитьСнятиеДокумента(ЭтотОбъект, Отказ, Истина);
	НезавершенныеПродажиКассы.ПроверитьОтменуКассовойПродажи(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Удаление не вызывает отмену проведения и её ближний пересчёт (warehouse-orders-cost, Ф3.7): сначала - отмена.
	Если Проведен Тогда
		ОрдераСклада.ПроверитьУдалениеОформляющего(ЭтотОбъект, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	КонтекстАвтовыпуска = Производство.КонтекстАвтовыпуска(ЭтотОбъект, Истина);
	Если КонтекстАвтовыпуска.Автовыпуски.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка, КонтекстАвтовыпуска);
	Блокировка.Заблокировать();
	Производство.ОтменитьАвтовыпуск(ЭтотОбъект, Отказ, Истина);
КонецПроцедуры

// Блокировки проведения и отмены проведения - один набор в одном порядке (E8): строки реализации, остатки
// номенклатуры автовыпуска так же, как их блокирует выпуск (E9), взаиморасчёты, потребности заказов автовыпуска.
//
// Параметры:
//  Блокировка          - БлокировкаДанных - заполняемая блокировка.
//  КонтекстАвтовыпуска - Структура - см. Производство.КонтекстАвтовыпуска.
//
Процедура ЗаполнитьБлокировкуПроведения(Блокировка, КонтекстАвтовыпуска) Экспорт
	// Протокол блокировок серийного учёта: номенклатура и IMEI - раньше оснований и остатков.
	СерийныйУчет.ЗаблокироватьСерииДокумента(ЭтотОбъект);
	// Единый порядок захвата (план warehouse-orders): склады - разделяемо первыми, ТоварыКОформлению - последним.
	Склады = Новый Массив;
	Склады.Добавить(МестоХранения);
	Если Не Ссылка.Пустая() Тогда
		Склады.Добавить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "МестоХранения"));
	КонецЕсли;
	УправляемыеБлокировки.МестаХранения(Блокировка, Склады, Ложь);
	// Партии пишет версия на неордерном складе - прежняя (удаляемые движения) или новая (списание); на ордерном складе
	// партии списывает расходный ордер (warehouse-orders-cost, Ф3.8). Ключи - по обеим версиям.
	Позиции = ОрдераСклада.ПозицииБлокировкиРеализации(ЭтотОбъект);
	Если КонтекстАвтовыпуска.Номенклатура.Количество() = 0 Тогда
		Для Каждого Склад Из ОрдераСклада.СкладыПартийРеализации(ЭтотОбъект) Цикл
			УправляемыеБлокировки.ТоварыВНаличии(Блокировка, Позиции, Склад);
		КонецЦикла;
	Иначе
		// Один элемент остатков без склада по строкам и номенклатуре автовыпуска: два элемента разной ширины у двух
		// реализаций могли бы взять блокировки встречно.
		Производство.ЗаполнитьБлокировкуОстатковАвтовыпуска(Блокировка, КонтекстАвтовыпуска, Позиции);
	КонецЕсли;
	// Контроль себестоимости читает остатки и допрасходы склада; ордерный склад выше не блокируется (его партии списывает
	// ордер) - разделяемо, до ТоварыКОформлению (план retail-store-price, «Риски»).
	Если Справочники.МестаХранения.РежимКонтроляМинимальнойЦены(МестоХранения)
			= Перечисления.РежимыКонтроляМинимальнойЦены.НеНижеСебестоимости
		И Справочники.МестаХранения.ОрдерныйСклад(МестоХранения, Дата) Тогда
		УправляемыеБлокировки.ТоварыВНаличии(Блокировка, Позиции, МестоХранения, Ложь);
	КонецЕсли;
	УправляемыеБлокировки.ВзаиморасчётыСПокупателями(Блокировка, Контрагент);
	Производство.ЗаполнитьБлокировкуПотребностейАвтовыпуска(Блокировка, КонтекстАвтовыпуска);
	Ордера = РегистрыНакопления.ТоварыКОформлению.ОрдераДокумента(ЭтотОбъект);
	ДополнительныеСвойства.Вставить("ОрдераДокумента", Ордера);
	УправляемыеБлокировки.ТоварыКОформлению(Блокировка, Ордера);
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	// Для заказа контроль повторного ввода снят - частичные отгрузки (решение владельца 2026-08-25).
	Если ТипЗнч(Основание) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		РаботаСДокументами.МожноСоздатьДокументНаОсновании(Метаданные.Документы.РеализацияТоваровУслуг, Основание);
	КонецЕсли;
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Кассовая смена (docs/plans/retail-cash-unfinished.md): первой - закрытая смена неизменна.
	НезавершенныеПродажиКассы.ПроверитьСменуДокумента(ЭтотОбъект, РежимЗаписи, Отказ);
	// Протокол блокировок серийного учёта: номенклатура и IMEI - раньше оснований и остатков.
	СерийныйУчет.ЗаблокироватьСерииДокумента(ЭтотОбъект);
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	// Налоговый документ на основаниях и защита покрытого основания: блокировка оснований до записи (план С2).
	НалоговыеДокументыНаОснованиях.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, Отказ);
	// Кассовая продажа с принятыми платежами не отменяется (после оснований - взаиморасчёты).
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		НезавершенныеПродажиКассы.ПроверитьОтменуКассовойПродажи(ЭтотОбъект, Отказ);
	КонецЕсли;
	// Проведённая реализация по ордерам с изменениями - только перепроведение (общий план, «Целостность связи»).
	Если Не НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ЭтотОбъект) Тогда
		ОрдераСклада.ПроверитьЗаписьБезПроведения(ЭтотОбъект, РежимЗаписи, Отказ);
		Если Не Отказ И РежимЗаписи <> РежимЗаписиДокумента.Запись Тогда
			ЗаблокироватьОрдерныеДанные(РежимЗаписи);
			// Реализация-источник (документ первый, Ф4.3): оформленные ордерами строки - под блокировкой источника.
			ОрдераСклада.ПроверитьЗащитуИсточника(ЭтотОбъект, РежимЗаписи, Отказ);
		КонецЕсли;
	КонецЕсли;
	Менеджер = РегистрыСведений.КураторыДоговоров.ПолучитьПоследнее(ЭтотОбъект.Дата, Новый Структура("Договор", ЭтотОбъект.Договор)).Куратор;
	//РаботаСДокументами.ПроверкаСоответствияВозвратовРеализации(ЭтотОбъект, РежимЗаписи, Отказ);
	ЭтотОбъект.ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	РаботаСВалютами.ПроверитьВалютуДокумента(ЭтотОбъект, Отказ);
	РаботаСДокументами.ЗаполнитьИтогиДокумента(ЭтотОбъект);
	Если Не Отказ Тогда
		ПроизводственныеЗаказы.ЗапомнитьЗаказыДокумента(ЭтотОбъект, РежимЗаписи);
	КонецЕсли;
КонецПроцедуры 

Процедура ПриЗаписи(Отказ)    
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Опция «Коммерческие предложения» выключена - реализация сама ведёт свой КП (docs/plans/branded-print.md, 3.3).
	// Первым шагом: КП блокируется до истории статусов заказа, как при записи заказа по КП (9.7).
	Если Не НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ЭтотОбъект) Тогда
		СинхронизироватьКоммерческоеПредложение();
	КонецЕсли;
	
	// Пометка удаления непроведённой реализации переходит на её автовыпуск - до записи статусов (E9). Проведение и отмену
	// проведения обслуживают обработчики проведения.
	Если ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Производство.ПометитьАвтовыпуск(ЭтотОбъект, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ЗаписатьСтатусЗаказаПродажи();
	// Проведённый документ, перезаписанный без перепроведения, пересчитывает стадии своих заказов (E8).
	ПроизводственныеЗаказы.ОбновитьСтадииПриЗаписи(ЭтотОбъект);
КонецПроцедуры

// Создаёт или обновляет коммерческое предложение реализации, если КП не вводятся вручную. Ошибка записи КП отменяет
// запись реализации: связка не расходится, текст ошибки называет КП.
//
Процедура СинхронизироватьКоммерческоеПредложение()
	МенеджерКП = Документы.КоммерческоеПредложение;
	Если МенеджерКП.КПВводятсяВручную() Тогда
		Возврат;
	КонецЕсли;
	Реализации = Новый Массив;
	Реализации.Добавить(Ссылка);
	МенеджерКП.СинхронизироватьСРеализациями(Реализации);
КонецПроцедуры

// Статус «Собран» заказа-продажи, по которому записана реализация: только из «Новый» и «В работе».
//
Процедура ЗаписатьСтатусЗаказаПродажи()
	// Статус «Собран» - только у заказа-продажи: стадию заказа на производство считает проведение (E8).
	Если ЗначениеЗаполнено(Основание) И Не ПроизводственныеЗаказы.ЭтоЗаказНаПроизводство(Основание) Тогда
		
		ЗаписыватьСтатус = Ложь;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.ЗаказПокупателя КАК ЗаказПокупателя,
		|	ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя КАК СтатусЗаказаПокупателя
		|ИЗ
		|	РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних(, ЗаказПокупателя = &ЗаказПокупателя) КАК ИсторияЗаказовПокупателейПоСтатусамСрезПоследних
		|ГДЕ
		|	ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.Индикатор = """"";
		// Запись стадии (E8) у заказа, переведённого из производства в продажу, считается отсутствующей.
		Запрос.УстановитьПараметр("ЗаказПокупателя",Ссылка.Основание); 
		
		Выборка = Запрос.Выполнить().Выгрузить();
		
		Если Выборка.Количество() = 0 Тогда 
			ЗаписыватьСтатус = Истина;
			СтатусЗаписи = Перечисления.СтатусыЗаказовПокупателя.Собран;  
		Иначе 
			СтатусЗаписи = Выборка[0].СтатусЗаказаПокупателя; 
			Если СтатусЗаписи = Перечисления.СтатусыЗаказовПокупателя.Новый 
				или СтатусЗаписи = Перечисления.СтатусыЗаказовПокупателя.ВРаботе Тогда 
				ЗаписыватьСтатус = Истина;
				СтатусЗаписи = Перечисления.СтатусыЗаказовПокупателя.Собран;  
			Иначе
				ЗаписыватьСтатус = Ложь;
			КонецЕсли;   
		КонецЕсли; 
		
		Если ЗаписыватьСтатус = Истина тогда
			НоваяЗапись = РегистрыСведений.ИсторияЗаказовПокупателейПоСтатусам.СоздатьМенеджерЗаписи();
			НоваяЗапись.Период = РаботаСДокументами.ПериодЗаписиСтатусаЗаказа(Ссылка.Основание);
			НоваяЗапись.СрокОплаты =  РаботаСДокументами.ПолучитьСрокОплаты(Контрагент,?(Ссылка.Пустая(),ТекущаяДата(),Дата));
			НоваяЗапись.ДокументПродажи = Ссылка;
			НоваяЗапись.ЗаказПокупателя = Ссылка.Основание;
			// Статус расчётный: запись в привилегированном режиме (ревью техдолга Codex 2026-10-09, T8).
			НоваяЗапись.СтатусЗаказаПокупателя = СтатусЗаписи;
			УстановитьПривилегированныйРежим(Истина);
			НоваяЗапись.Записать(Ложь);
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры
