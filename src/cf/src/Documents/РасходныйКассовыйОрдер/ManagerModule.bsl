#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы объекта.
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "РасходныйКассовыйОрдер";
	Команда.Представление = НСтр("ru = 'Расходный кассовый ордер'; fr = 'Bon de décaissement';
		|en = 'Cash payment order'; es = 'Orden de pago de caja'");

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "Ticket";
	Команда.Представление = НСтр("ru = 'Чек'; fr = 'Ticket';
		|en = 'Receipt'; es = 'Recibo'");

	// Квитанция (Reçu) - фирменная форма A4 (docs/plans/branded-print.md, раздел 12.7); Ticket - слип принтера чеков.
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаКвитанции(), ВидФормыКвитанции());

	// Письмо о платеже - фирменная форма под прежней командой (раздел 13.7).
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаПисьма(), ВидФормыПисьма(), ПредставлениеПисьма());

КонецПроцедуры

// Формирует запрошенные печатные формы.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые объекты
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "РасходныйКассовыйОрдер") Тогда
		Таб = Новый ТабличныйДокумент;
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			ПечатьРасходныйКассовыйОрдер(Док, Таб);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "РасходныйКассовыйОрдер",
			НСтр("ru = 'Расходный кассовый ордер'; fr = 'Bon de décaissement';
			|en = 'Cash payment order'; es = 'Orden de pago de caja'"),
			Таб, "Документ.РасходныйКассовыйОрдер.РасходныйКассовыйОрдер");
	КонецЕсли;

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "Ticket") Тогда
		Таб = Новый ТабличныйДокумент;
		Таб.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		Таб.АвтоМасштаб = Истина;
		Таб.ОтображатьСетку = Ложь;
		Таб.ОтображатьЗаголовки = Ложь;
		Таб.Защита = Ложь;
		Таб.ПолеСверху = 10;
		Таб.ПолеСлева = 5;
		Таб.ПолеСнизу = 10;
		Таб.ПолеСправа = 5;
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			ПечатьЧека(Док, Таб);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "Ticket",
			НСтр("ru = 'Чек'; fr = 'Ticket';
			|en = 'Receipt'; es = 'Recibo'"),
			Таб, "Документ.РасходныйКассовыйОрдер.Ticket");
	КонецЕсли;

	// Квитанцию печатают только роли с её командой (раздел 12.6 плана): право на команду проверяется и на сервере, а не
	// только видимостью кнопки (ревью безопасности фазы 5).
	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакетаКвитанции())
		И Не ПравоДоступа("Просмотр", Метаданные.Документы.РасходныйКассовыйОрдер.Команды.ПечатьКвитанции) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для печати квитанции.'; fr = 'Droits insuffisants pour imprimer le reçu.';
			|en = 'Insufficient rights to print the receipt.'; es = 'Derechos insuficientes para imprimir el recibo.'");
	КонецЕсли;
	ФирменнаяПечать.Напечатать(ИмяМакетаКвитанции(), ВидФормыКвитанции(), МассивОбъектов, ПараметрыПечати,
		КоллекцияПечатныхФорм, ОбъектыПечати);

	// Команды письма нет ни у одной роли, кроме администратора, - проверка права и на сервере (раздел 13.6 плана).
	ФирменнаяПечать.ПроверитьПравоНаКоманду(КоллекцияПечатныхФорм, ИмяМакетаПисьма(),
		Метаданные.Документы.РасходныйКассовыйОрдер.Команды.PrintLettreDePaiement, ПараметрыПечати);
	ФирменнаяПечать.Напечатать(ИмяМакетаПисьма(), ВидФормыПисьма(), МассивОбъектов, ПараметрыПечати,
		КоллекцияПечатныхФорм, ОбъектыПечати, ПредставлениеПисьма());

КонецПроцедуры

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать): квитанция (Reçu) ордера (docs/plans/branded-print.md,
// раздел 12.5) и письмо о платеже (раздел 13.5). Контрагент - составного типа: у контрагента и организации печатается
// карточка, у физического лица - наименование; получатель квитанции - «Выдать» ордера, пусто - наименование контрагента.
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.РасходныйКассовыйОрдер - печатаемые ордера.
//  ВидФормы        - Строка - Recu или LettreDePaiement.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати.
//
// Возвращаемое значение:
//  Соответствие - ордер -> источник печати (Данные, Плашка, ИмяФайла).
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ордер.Ссылка КАК Ссылка,
	|	Ордер.Номер КАК НомерДокумента,
	|	Ордер.Дата КАК Дата,
	|	Ордер.Организация КАК Организация,
	|	Ордер.Контрагент КАК Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(Ордер.Контрагент) КАК КонтрагентПредставление,
	|	Ордер.Договор КАК Договор,
	|	Ордер.Валюта КАК Валюта,
	|	Ордер.Сумма КАК Сумма,
	|	Ордер.Комментарий КАК Комментарий,
	|	ПРЕДСТАВЛЕНИЕ(Ордер.Ответственный) КАК Автор,
	|	Ордер.Выдать КАК Плательщик,
	|	Ордер.ПоДокументу КАК ПоДокументу,
	|	Ордер.ОснованиеДляПечати КАК Основание,
	|	Ордер.Приложение КАК Приложение,
	|	ПРЕДСТАВЛЕНИЕ(Ордер.Касса) КАК Касса,
	|	ПРЕДСТАВЛЕНИЕ(Ордер.СтатьяДДС) КАК СтатьяДДС,
	|	ПРЕДСТАВЛЕНИЕ(Ордер.Кассир) КАК Кассир,
	|	ПРЕДСТАВЛЕНИЕ(Ордер.ТипОплаты) КАК ТипОплаты
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК Ордер
	|ГДЕ
	|	Ордер.Ссылка В(&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	// Ордер может прийти и в Печать другого документа: вид и право на команду проверяет сам адаптер.
	Команды = Метаданные.Документы.РасходныйКассовыйОрдер.Команды;
	Если ВидФормы = ВидФормыПисьма() Тогда
		Команда = Команды.PrintLettreDePaiement;
	ИначеЕсли ВидФормы = ВидФормыКвитанции() Тогда
		Команда = Команды.ПечатьКвитанции;
	Иначе
		Команда = Неопределено;
	КонецЕсли;
	ФирменнаяПечать.ПроверитьКомандуАдаптера(ВидФормы, Команда, ПараметрыПечати);
	Письмо = ВидФормы = ВидФормыПисьма();
	Основания = ?(Письмо, ОснованияПисем(Ссылки), Неопределено);
	Результат = Новый Соответствие;
	Кэш = ФирменнаяПечать.НовыйКэш();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Шапка = ФирменнаяПечать.НоваяШапкаДокумента();
		ЗаполнитьЗначенияСвойств(Шапка, Выборка,
			"Дата, Организация, Контрагент, КонтрагентПредставление, Договор, Валюта, Сумма, Комментарий, Автор");
		Шапка.Номер = РаботаСДокументами.СформироватьЦифровойНомер(Выборка.НомерДокумента);
		Если Письмо Тогда
			// Получатель без контрагента - «Выдать» ордера.
			Если ПустаяСтрока(Шапка.КонтрагентПредставление) Тогда
				Шапка.КонтрагентПредставление = Выборка.Плательщик;
			КонецЕсли;
			ДанныеПисьма = ФирменнаяПечать.НовоеПисьмо();
			ДанныеПисьма.СтатьяДДС = Выборка.СтатьяДДС;
			ДанныеПисьма.СпособОплаты = Выборка.ТипОплаты;
			Для Каждого Строка Из Основания.НайтиСтроки(Новый Структура("Ссылка", Выборка.Ссылка)) Цикл
				Основание = ФирменнаяПечать.НовоеОснованиеПисьма(Строка.Номер, Строка.НомерОтгрузки, Строка.ДатаОтгрузки,
					Строка.Сумма);
				ДанныеПисьма.Основания.Добавить(Основание);
			КонецЦикла;
			ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента("Lettre de paiement", Выборка.НомерДокумента, Выборка.Дата);
			Данные = ФирменнаяПечать.ДанныеПисьма(Шапка, ДанныеПисьма, Кэш);
			Результат.Вставить(Выборка.Ссылка, Новый Структура("Данные, Плашка, ИмяФайла", Данные, "", ИмяФайла));
			Продолжить;
		КонецЕсли;
		Квитанция = ФирменнаяПечать.НоваяКвитанция();
		ЗаполнитьЗначенияСвойств(Квитанция, Выборка, "Плательщик, ПоДокументу, Основание, Приложение, Касса, СтатьяДДС, Кассир");
		Квитанция.Расход = Истина;
		ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента("Reçu de décaissement", Выборка.НомерДокумента, Выборка.Дата);
		Данные = ФирменнаяПечать.ДанныеКвитанции(Шапка, Квитанция, Кэш);
		Результат.Вставить(Выборка.Ссылка, Новый Структура("Данные, Плашка, ИмяФайла", Данные, "", ИмяФайла));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Печать

Функция ИмяМакетаКвитанции()
	Возврат "Квитанция";
КонецФункции

Функция ВидФормыКвитанции()
	Возврат "Recu";
КонецФункции

Функция ИмяМакетаПисьма()
	Возврат "LettreDePaiement";
КонецФункции

Функция ПредставлениеПисьма()
	// Название прежней команды.
	Возврат НСтр("ru = 'Письмо о платеже'; fr = 'Lettre de paiement';
		|en = 'Payment letter'; es = 'Carta de pago'");
КонецФункции

Функция ВидФормыПисьма()
	Возврат "LettreDePaiement";
КонецФункции

Функция ОснованияПисем(Ссылки)
	// Основания письма о платеже (раздел 13.5 плана): строки ТЧОснования одним запросом, номера и даты оснований - одним
	// чтением на тип и только типов, которые пользователь вправе читать: основание недоступного типа печатается суммой без
	// номера (прежнее письмо падало на нём). У поступления и налоговой накладной покупки - номер и дата накладной (BL)
	// поставщика, как в прежнем письме.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Основания.Ссылка КАК Ссылка,
	|	Основания.НомерСтроки КАК НомерСтроки,
	|	Основания.Основание КАК Основание,
	|	Основания.Сумма КАК Сумма
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер.ТЧОснования КАК Основания
	|ГДЕ
	|	Основания.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("НомерОтгрузки", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ДатаОтгрузки", Новый ОписаниеТипов("Дата"));
	// Отбор строк каждого ордера - НайтиСтроки: с индексом по ссылке при печати списком (урок фазы 5).
	Таблица.Индексы.Добавить("Ссылка");
	Реквизиты = РеквизитыОснованийПисем(Таблица);
	Для Каждого Строка Из Таблица Цикл
		Реквизит = Реквизиты[Строка.Основание];
		Если Реквизит <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Строка, Реквизит);
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;
КонецФункции

Функция РеквизитыОснованийПисем(Таблица)
	// Номер и дата (у накладной поставщика - номер и дата BL) каждого основания, тип которого пользователь вправе читать.
	ПоТипам = ДоступныеОснованияПоТипам(Таблица);
	Реквизиты = Новый Соответствие;
	Для Каждого Тип Из ПоТипам Цикл
		НакладнаяПоставщика = Тип.Ключ = Метаданные.Документы.ПоступлениеТоваровУслуг
			Или Тип.Ключ = Метаданные.Документы.НалоговаяНакладнаяПокупка;
		Имена = "Номер, Дата" + ?(НакладнаяПоставщика, ", НомерОтгрузочногоДокумента, ДатаОтгрузочногоДокумента", "");
		Для Каждого Значения Из ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Тип.Значение, Имена) Цикл
			Реквизит = Новый Структура("Номер, НомерОтгрузки, ДатаОтгрузки", Значения.Значение.Номер,
				Значения.Значение.Номер, Значения.Значение.Дата);
			Если НакладнаяПоставщика Тогда
				Реквизит.НомерОтгрузки = Значения.Значение.НомерОтгрузочногоДокумента;
				Реквизит.ДатаОтгрузки = Значения.Значение.ДатаОтгрузочногоДокумента;
			КонецЕсли;
			Реквизиты.Вставить(Значения.Ключ, Реквизит);
		КонецЦикла;
	КонецЦикла;
	Возврат Реквизиты;
КонецФункции

Функция ДоступныеОснованияПоТипам(Таблица)
	ПоТипам = Новый Соответствие;
	Для Каждого Строка Из Таблица Цикл
		Если Не ЗначениеЗаполнено(Строка.Основание) Тогда
			Продолжить;
		КонецЕсли;
		МетаданныеОснования = Строка.Основание.Метаданные();
		Если Не ПравоДоступа("Чтение", МетаданныеОснования) Тогда
			Продолжить;
		КонецЕсли;
		СсылкиТипа = ПоТипам[МетаданныеОснования];
		Если СсылкиТипа = Неопределено Тогда
			СсылкиТипа = Новый Массив;
			ПоТипам.Вставить(МетаданныеОснования, СсылкиТипа);
		КонецЕсли;
		Если СсылкиТипа.Найти(Строка.Основание) = Неопределено Тогда
			СсылкиТипа.Добавить(Строка.Основание);
		КонецЕсли;
	КонецЦикла;
	Возврат ПоТипам;
КонецФункции

Процедура ПечатьРасходныйКассовыйОрдер(Док, Таб) Экспорт
	Таб.ТолькоПросмотр = Истина;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОтображатьСетку = Ложь;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Таб.АвтоМасштаб = Истина;
	Таб.КлючПараметровПечати = "Параметры_печати_Документ_РасходныйКассовыйОрдер_РасходныйКассовыйОрдер";
	КарточкаОрганизации = Справочники.Контрагенты.ПолучитьКарточку(Док.Организация, Док.Дата);
	// Валюта документа - валюта кассы (docs/plans/multicurrency-payments.md).
	Валюта = РаботаСВалютами.ВалютаИКурсОбъекта(Док).Валюта;
	Макет = ПечатныеФормы.МакетПечатнойФормы("Документ.РасходныйКассовыйОрдер.РасходныйКассовыйОрдер");	
	оШапка = Макет.ПолучитьОбласть("Шапка");
	оШапка.Параметры.ПредставлениеОрганизации = КарточкаОрганизации.Наименование;
	//оШапка.Параметры.ОрганизацияПоОКПО = КарточкаОрганизации.ОКПО;
	оШапка.Параметры.НомерДокумента = РаботаСДокументами.СформироватьЦифровойНомер(Док.Номер);
	оШапка.Параметры.ДатаДокумента = Формат(Док.Дата, "ДЛФ=D");
	оШапка.Параметры.ДатаДокументаПрописью = Формат(Док.Дата, "ДЛФ=DD");
	оШапка.Параметры.КредитСубСчет = "50.01";
	оШапка.Параметры.Сумма = Док.Сумма;
	оШапка.Параметры.СуммаПрописью = Справочники.Валюты.СформироватьСуммуПрописью(Док.Сумма, Валюта, Перечисления.Локализации.fr_CA);
	оШапка.Параметры.ФИОПолучателя = Док.Выдать;
	оШапка.Параметры.Основание = Док.ОснованиеДляПечати;
	оШапка.Параметры.Приложение = Док.Приложение;
	оШапка.Параметры.РеквизитыДокументаУдостоверяющегоЛичность = Док.ПоДокументу;
	оШапка.Параметры.ДолжностьРуководителя = КарточкаОрганизации.Руководитель.Должность;
	оШапка.Параметры.ФИОРуководителя = КарточкаОрганизации.Руководитель.ДляПечати;
	оШапка.Параметры.ФИОГлавногоБухгалтера = КарточкаОрганизации.ГлавныйБухгалтер.ДляПечати;
	//оШапка.Параметры.ФИОКассира = Справочники.ФизическиеЛица.СформироватьПредставлениеДляПечати(Док.Кассир.ФизическоеЛицо);
	Таб.Вывести(оШапка);
	Таб.ВывестиГоризонтальныйРазделительСтраниц();
КонецПроцедуры

Function ПечатьЧека(Док, Spreadsheet) Export
	Template = ПечатныеФормы.МакетПечатнойФормы("Документ.РасходныйКассовыйОрдер.Ticket");
	
	Header = Template.GetArea("Шапка");
	
	Header.Parameters.Fill(Док);
	
	FieldPhoto = Док.Организация.Логотип.Get();
	Try
		Header.Drawings[0].Picture = New Picture(FieldPhoto);
	Except
	EndTry;
	
	Header.Parameters.КонтрагентЗаголовок = ?(ЗначениеЗаполнено(Док.Контрагент), НСтр("fr = 'Bénéficiaire'; ru = 'Получатель'; en = 'Recipient'; es = 'Destinatario'"), "");
	Header.Parameters.Контрагент = ?(ЗначениеЗаполнено(Док.Контрагент), Док.Контрагент, "");

	Spreadsheet.Put(Header);
	
	Spreadsheet.PutHorizontalPageBreak();
	
	Return Spreadsheet;
	
	//}}
EndFunction

