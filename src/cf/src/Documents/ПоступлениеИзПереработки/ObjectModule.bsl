#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	СтавкаНДСУслуг = Константы.СтавкаНДСПоУмолчанию.Получить();
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПередачаВПереработку") Тогда
		ЗаполнитьПоПередаче(ДанныеЗаполнения);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	// Данные для проведения: списываемое у переработчика сырьё
	ДополнительныеСвойства.Вставить("ТЗТоварыССериями", СерииИРазмещение.ОбъединитьТоварыССериями(ЭтотОбъект));
	// Блокировки: остатки у переработчика и склад, на который приходуется продукция
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	Блокировка.Заблокировать();
	// Формируем: расход у переработчика и приход продукции - в диспетчере ТоварыВНаличии
	Если Не РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(ЭтотОбъект) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	// Долг перед переработчиком на стоимость его услуг
	РегистрыНакопления.ВзаиморасчётыСПоставщиками.СформироватьДвижения(ЭтотОбъект);
	Движения.Записать();
	// Продукция переработчика - выпуск заказа: стадии заказов пересчитываются последними (E8, E12.3b).
	ПроизводственныеЗаказы.ОбновитьСтадииПослеПроведения(ЭтотОбъект);
КонецПроцедуры

// Отмена проведения поступления по заказу на производство: блокировки в порядке проведения, очистка движений и пересчёт
// стадий заказа (E8, E12.3b). Без таких заказов движения удаляет платформа, как раньше.
//
// Параметры:
//  Отказ - Булево - не используется.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	ПроизводственныеЗаказы.ОтменитьПроведениеДокумента(ЭтотОбъект, Блокировка);
КонецПроцедуры

// Блокировки проведения и отмены проведения - один набор в одном порядке (E8).
//
// Параметры:
//  Блокировка - БлокировкаДанных - заполняемая блокировка.
//
Процедура ЗаполнитьБлокировкуПроведения(Блокировка)
	УправляемыеБлокировки.ТоварыВПереработке(Блокировка, ТЧТовары, Контрагент);
	УправляемыеБлокировки.ТоварыВНаличии(Блокировка, ТЧГотоваяПродукция, МестоХранения);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПередачаВПереработку") И ЗначениеЗаполнено(Основание)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "Контрагент") <> Контрагент Тогда
		ТекстОшибки = НСтр("ru = 'Переработчик отличается от переработчика в передаче-основании';
			|fr = 'Le sous-traitant diffère de celui du transfert de base';
			|en = 'The processor differs from the processor in the basis transfer';
			|es = 'El procesador difiere del procesador en la transferencia base'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Контрагент", , Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	Если Не Отказ Тогда
		ПроизводственныеЗаказы.ЗапомнитьЗаказыДокумента(ЭтотОбъект, РежимЗаписи);
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.ОбновитьПроизводственныйСтатусЗаказа(ЭтотОбъект);
	// Проведённый документ, перезаписанный без перепроведения, пересчитывает стадии своих заказов (E8).
	ПроизводственныеЗаказы.ОбновитьСтадииПриЗаписи(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоПередаче(Передача)
	// Сырьё - текущий остаток переданного по этой передаче у переработчика,
	// готовая продукция - ожидаемая продукция из передачи.
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Передача, "Контрагент,Организация,МестоХранения");
	Основание = Передача;
	Контрагент = Реквизиты.Контрагент;
	Организация = Реквизиты.Организация;
	МестоХранения = Реквизиты.МестоХранения;
	Отбор = Новый Структура("ПередачаВПереработку", Передача);
	ТЗОстатки = РегистрыНакопления.ТоварыВПереработке.ПолучитьОстатки(Контрагент, Неопределено, Отбор);
	ТЗОстатки.Свернуть("Номенклатура, Характеристика, Серия", "Количество");
	Единицы = ЕдиницыНоменклатуры(ТЗОстатки.ВыгрузитьКолонку("Номенклатура"));
	Для Каждого Стр Из ТЗОстатки Цикл
		Если Стр.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		НС = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Стр, "Номенклатура, Характеристика, Серия, Количество");
		НС.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ТЧТовары);
		НС.Упаковка = Единицы[Стр.Номенклатура];
		НС.КоличествоУпаковок = Стр.Количество;
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТЧГотоваяПродукция.Номенклатура КАК Номенклатура,
	                      |	ТЧГотоваяПродукция.Характеристика КАК Характеристика,
	                      |	ТЧГотоваяПродукция.Упаковка КАК Упаковка,
	                      |	ТЧГотоваяПродукция.Серия КАК Серия,
	                      |	ТЧГотоваяПродукция.КоличествоУпаковок КАК КоличествоУпаковок,
	                      |	ТЧГотоваяПродукция.Количество КАК Количество
	                      |ИЗ
	                      |	Документ.ПередачаВПереработку.ТЧГотоваяПродукция КАК ТЧГотоваяПродукция
	                      |ГДЕ
	                      |	ТЧГотоваяПродукция.Ссылка = &Передача
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ТЧГотоваяПродукция.НомерСтроки");
	Запрос.УстановитьПараметр("Передача", Передача);
	ТЧГотоваяПродукция.Загрузить(Запрос.Выполнить().Выгрузить());
	ВычестьПоступившуюПродукцию(Передача);
	Для Каждого Стр Из ТЧГотоваяПродукция Цикл
		Стр.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ТЧГотоваяПродукция);
	КонецЦикла;
КонецПроцедуры

// Ожидаемая продукция передачи за вычетом уже поступившей: по этой передаче - по номенклатуре, характеристике и серии;
// по заказу передачи - не больше заказанного без выпущенного (выпуски, автовыпуски и поступления из переработки по всем
// передачам заказа). Частичное поступление не засчитывает заказу выпуск всей ожидаемой продукции (E12.3b, ревью P2).
//
// Параметры:
//  Передача - ДокументСсылка.ПередачаВПереработку - передача-основание.
//
Процедура ВычестьПоступившуюПродукцию(Передача)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Продукция.Номенклатура КАК Номенклатура,
	                      |	Продукция.Характеристика КАК Характеристика,
	                      |	Продукция.Серия КАК Серия,
	                      |	СУММА(Продукция.Количество) КАК Количество
	                      |ИЗ
	                      |	Документ.ПоступлениеИзПереработки.ТЧГотоваяПродукция КАК Продукция
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеИзПереработки КАК Поступления
	                      |		ПО Продукция.Ссылка = Поступления.Ссылка
	                      |ГДЕ
	                      |	Поступления.Основание = &Передача
	                      |	И Поступления.Проведен
	                      |	И Поступления.Ссылка <> &Ссылка
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Продукция.Номенклатура,
	                      |	Продукция.Характеристика,
	                      |	Продукция.Серия");
	Запрос.УстановитьПараметр("Передача", Передача);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Для Каждого СтрокаПоступившего Из Запрос.Выполнить().Выгрузить() Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика, Серия", СтрокаПоступившего.Номенклатура,
			СтрокаПоступившего.Характеристика, СтрокаПоступившего.Серия);
		Невычтено = УменьшитьГотовуюПродукцию(Отбор, СтрокаПоступившего.Количество);
		Если Невычтено > 0 И ЗначениеЗаполнено(СтрокаПоступившего.Серия) Тогда
			// Ожидаемая продукция передачи - без серии: серию дали при поступлении.
			Отбор.Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
			УменьшитьГотовуюПродукцию(Отбор, Невычтено);
		КонецЕсли;
	КонецЦикла;
	Заказ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Передача, "Основание");
	Если ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") И ЗначениеЗаполнено(Заказ) Тогда
		ОграничитьОстаткомЗаказа(Заказ);
	КонецЕсли;
	Для Каждого Стр Из ТЧГотоваяПродукция.НайтиСтроки(Новый Структура("Количество", 0)) Цикл
		ТЧГотоваяПродукция.Удалить(Стр);
	КонецЦикла;
КонецПроцедуры

// Продукция по заказу на производство - не больше заказанного без выпущенного; у заказа-продажи расчёта нет.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ передачи.
//
Процедура ОграничитьОстаткомЗаказа(Заказ)
	Для Каждого Выполнение Из ПроизводственныеЗаказы.ВыполнениеПоПродукции(Заказ) Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика", Выполнение.Номенклатура, Выполнение.Характеристика);
		Строки = ТЧГотоваяПродукция.НайтиСтроки(Отбор);
		Ожидается = 0;
		Для Каждого Стр Из Строки Цикл
			Ожидается = Ожидается + Стр.Количество;
		КонецЦикла;
		Лишнее = Ожидается - Макс(0, Выполнение.Заказано - Выполнение.Выпущено);
		Если Лишнее > 0 Тогда
			УменьшитьГотовуюПродукцию(Отбор, Лишнее);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Уменьшает строки готовой продукции по отбору на количество, по порядку строк.
//
// Параметры:
//  Отбор      - Структура - отбор строк ТЧГотоваяПродукция.
//  Количество - Число - на сколько уменьшить в базовых единицах.
//
// Возвращаемое значение:
//  Число - сколько не удалось вычесть: строк по отбору не хватило.
//
Функция УменьшитьГотовуюПродукцию(Отбор, Количество)
	Остаток = Количество;
	Для Каждого Стр Из ТЧГотоваяПродукция.НайтиСтроки(Отбор) Цикл
		Если Остаток <= 0 Тогда
			Прервать;
		КонецЕсли;
		Вычесть = Мин(Остаток, Стр.Количество);
		Если Вычесть <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Коэффициент = ?(Стр.Количество = 0, 1, Стр.КоличествоУпаковок / Стр.Количество);
		Стр.Количество = Стр.Количество - Вычесть;
		Стр.КоличествоУпаковок = Стр.Количество * Коэффициент;
		Остаток = Остаток - Вычесть;
	КонецЦикла;
	Возврат Остаток;
КонецФункции

Функция ЕдиницыНоменклатуры(Номенклатура)
	// Соответствие номенклатура → единица хранения, одним запросом по списку.
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Номенклатура.Ссылка КАК Номенклатура,
	                      |	Номенклатура.Единица КАК Единица
	                      |ИЗ
	                      |	Справочник.Номенклатура КАК Номенклатура
	                      |ГДЕ
	                      |	Номенклатура.Ссылка В (&Номенклатура)");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.Единица);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
