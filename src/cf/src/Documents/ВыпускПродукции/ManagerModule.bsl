#Область ПрограммныйИнтерфейс

// Заполняет материалы ручного выпуска по технологическим картам всех позиций продукции на дату документа. В одиночном
// режиме позиция берётся из шапки (ТЧГотоваяПродукция перестроится при записи), в многострочном - из ТЧГотоваяПродукция.
// Задним числом заполняется версия карты, действовавшая на дату выпуска. Если ни у одной позиции карты нет, материалы не
// меняются.
//
// Параметры:
//  Выпуск           - ДокументОбъект.ВыпускПродукции, ДанныеФормыСтруктура - заполняемый выпуск или реквизит формы
//                     «Объект» формы документа.
//  НесколькоСтрокГП - Булево - многострочный режим: продукция задана строками ТЧГотоваяПродукция.
//
Процедура ЗаполнитьМатериалыПоТехкартам(Выпуск, НесколькоСтрокГП) Экспорт

	ТЗПродукция = Выпуск.ТЧГотоваяПродукция.Выгрузить(, "Номенклатура, КоличествоУпаковок");
	Если Не НесколькоСтрокГП Или ТЗПродукция.Количество() = 0 Тогда
		ТЗПродукция.Очистить();
		НоваяСтрока = ТЗПродукция.Добавить();
		НоваяСтрока.Номенклатура = Выпуск.Номенклатура;
		НоваяСтрока.КоличествоУпаковок = Выпуск.КоличествоУпаковок;
	КонецЕсли;
	Материалы = ТехнологическиеКарты.ЗаполнитьМатериалыПоТехкартам(ТЗПродукция, Выпуск.Дата);
	Если Материалы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Выпуск.ТЧТовары.Загрузить(Материалы);
	Для Каждого СтрокаТЧ Из Выпуск.ТЧТовары Цикл
		СтрокаТЧ.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Выпуск.ТЧТовары);
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТЧ);
	КонецЦикла;

КонецПроцедуры

// Заполняет новый выпуск по заказу на производство в работе («Выпуск по заказу», E12.3): основание и организация -
// заказа, готовая продукция - строки заказа, которые осталось выпустить (к выпуску без выпущенного проведёнными
// документами, в единице номенклатуры), шапка - по первой строке, материалы - по технологическим картам. Заказ не в
// работе или нечего выпускать - сообщение, продукция не заполняется.
//
// Параметры:
//  Выпуск - ДокументОбъект.ВыпускПродукции - новый выпуск.
//  Заказ  - ДокументСсылка.ЗаказПокупателя - заказ-основание.
//
Процедура ЗаполнитьПоЗаказу(Выпуск, Заказ) Экспорт

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "ВидОперации, Проведен, ПометкаУдаления, Организация");
	ЗаказВРаботе = Реквизиты.Проведен = Истина И Реквизиты.ПометкаУдаления = Ложь
		И Реквизиты.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Если Не ЗаказВРаботе Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выпуск по заказу вводится только по заказу на производство в работе.';
			|fr = 'La production par commande se saisit uniquement pour une commande en production lancée.';
			|en = 'Output by order is entered only for a production order in progress.';
			|es = 'La producción por pedido solo se introduce para un pedido para producción en marcha.'"));
		Возврат;
	КонецЕсли;
	Выпуск.Основание = Заказ;
	Выпуск.Организация = Реквизиты.Организация;
	Если Не ЗначениеЗаполнено(Выпуск.МестоХраненияОприходование) Тогда
		Выпуск.МестоХраненияОприходование = Выпуск.МестоХранения;
	КонецЕсли;
	Для Каждого Выполнение Из ПроизводственныеЗаказы.ВыполнениеПоПродукции(Заказ) Цикл
		Остаток = Выполнение.КВыпуску - Выполнение.Выпущено;
		Если Остаток <= 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПродукции = Выпуск.ТЧГотоваяПродукция.Добавить();
		СтрокаПродукции.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Выпуск.ТЧГотоваяПродукция);
		СтрокаПродукции.Номенклатура = Выполнение.Номенклатура;
		СтрокаПродукции.Характеристика = Выполнение.Характеристика;
		СтрокаПродукции.Упаковка = Выполнение.Единица;
		СтрокаПродукции.КоличествоУпаковок = Остаток;
		РаботаСДокументамиКлиентСервер.РассчитатьКоличество(СтрокаПродукции);
	КонецЦикла;
	Если Выпуск.ТЧГотоваяПродукция.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'По заказу нечего выпускать: вся продукция с материалами выпущена.';
			|fr = 'Rien à produire pour la commande : tous les produits avec matières sont produits.';
			|en = 'Nothing to produce for the order: all products with materials are already produced.';
			|es = 'No hay nada que producir para el pedido: todos los productos con materiales ya están producidos.'"));
		Возврат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Выпуск, Выпуск.ТЧГотоваяПродукция[0],
		"Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Количество");
	ЗаполнитьМатериалыПоТехкартам(Выпуск, Выпуск.ТЧГотоваяПродукция.Количество() > 1);

КонецПроцедуры

#КонецОбласти
