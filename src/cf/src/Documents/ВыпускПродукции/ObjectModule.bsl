
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	// «Выпуск по заказу» рабочего места производства (E12.3).
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Документы.ВыпускПродукции.ЗаполнитьПоЗаказу(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	// Данные для проведения
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ТЗТоварыССериями", СерииИРазмещение.ОбъединитьТоварыССериями(ЭтотОбъект));
	// Блокировки
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	Блокировка.Заблокировать();
	// Ручной выпуск по заказу при открытом требовании-накладной на ту же продукцию - двойное производство (N2):
	// проверка под блокировкой потребностей заказа.
	Если ВыпускБезТребованияПоЗаказу() Тогда
		ТекстЗапрета = ТребованияНакладные.ТекстЗапретаВыпускаБезТребования(Основание, ТЧГотоваяПродукция);
		Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, ЭтотОбъект, , , Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Формируем
	Отказ = Не РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(ЭтотОбъект);
	Если Отказ Тогда Возврат КонецЕсли;
	Если ЗначениеЗаполнено(ЦенаРозничная) И ТЧГотоваяПродукция.Количество() = 1 Тогда 
		НС = Движения.ЦеныНоменклатуры.Добавить();
		НС.Период = Дата;
		НС.ВидЦены = Справочники.ВидыЦен.Розничная;
		НС.Номенклатура = Номенклатура;
		НС.Характеристика = Характеристика;
		НС.ТоварнаяГруппа = Номенклатура.ТоварнаяГруппа;
		НС.Цена = ЦенаРозничная;
	КонецЕсли;
	// «ИзОстатка» автовыпуска при отгрузке: материалы, не покрытые партиями под заказ (E9)
	Если Производство.ЭтоАвтовыпуск(ЭтотОбъект) Тогда
		РегистрыНакопления.ПотребностиПроизводства.СформироватьДвижения(ЭтотОбъект);
	КонецЕсли;
	// Записываем
	Движения.Записать();
	ПроизводственныеЗаказы.ОбновитьСтадииПослеПроведения(ЭтотОбъект);
КонецПроцедуры

// Отмена проведения документа, затронувшего заказы клиента на производство: блокировки в порядке проведения,
// очистка движений и пересчёт стадий заказов (E8). Без таких заказов движения удаляет платформа, как раньше.
//
// Параметры:
//  Отказ - Булево - не используется.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	ПроизводственныеЗаказы.ОтменитьПроведениеДокумента(ЭтотОбъект, Блокировка);
КонецПроцедуры

// Блокировки проведения и отмены проведения - один набор в одном порядке (E8).
//
// Параметры:
//  Блокировка - БлокировкаДанных - заполняемая блокировка.
//
Процедура ЗаполнитьБлокировкуПроведения(Блокировка)
	УправляемыеБлокировки.ТоварыВНаличии(Блокировка, ТЧТовары);
	// Потребности заказа - после складских, как у требования-накладной и автовыпуска (порядок один у всех).
	Если ВыпускБезТребованияПоЗаказу() Тогда
		УправляемыеБлокировки.ПотребностиПроизводства(Блокировка, Основание);
	КонецЕсли;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
	// Копия выпуска по требованию-накладной - ручной выпуск: связь с требованием не копируется.
	Требование = Документы.ТребованиеНакладная.ПустаяСсылка();
	// Копия автовыпуска - ручной выпуск по заказу реализации (E9): признак снимается, иначе копия осталась бы
	// неправимой, а механизм её никогда не перезаполнил бы - он ищет свои выпуски по основанию.
	// Заказ считается до снятия признака: ЗаказОснования читает ещё не очищенное основание.
	Если Производство.ЭтоАвтовыпуск(ЭтотОбъект) Тогда
		Основание = Производство.ЗаказОснования(Основание);
		СозданАвтоматически = Ложь;
		Комментарий = "";
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Выпускаемая продукция задаётся либо шапкой (одна позиция), либо строками
	// ТЧГотоваяПродукция (мультивыпуск) - обязательно заполнение одного из двух.
	Если ТЧГотоваяПродукция.Количество() = 0 Тогда
		УдалитьПроверяемыйРеквизит(ПроверяемыеРеквизиты, "ТЧГотоваяПродукция");
	Иначе
		УдалитьПроверяемыйРеквизит(ПроверяемыеРеквизиты, "Номенклатура");
		УдалитьПроверяемыйРеквизит(ПроверяемыеРеквизиты, "КоличествоУпаковок");
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Автовыпуск меняет только проведение реализации (E9), выпуск по требованию-накладной - только требование.
	Производство.ПроверитьПравкуАвтовыпуска(ЭтотОбъект, Отказ);
	Если Не Отказ Тогда
		ТребованияНакладные.ПроверитьПравкуВыпускаПоТребованию(ЭтотОбъект, Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Автовыпуск: модуль Производство проверяет закрытый период до записи - здесь проверка пройдёт так же.
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	СинхронизироватьГотовуюПродукцию();
	Если Не Отказ Тогда
		ПроизводственныеЗаказы.ЗапомнитьЗаказыДокумента(ЭтотОбъект, РежимЗаписи);
	КонецЕсли;
КонецПроцедуры

// Автовыпуск и выпуск по требованию-накладной удаляются механизмом или, непроведённые и помеченные, удалением
// помеченных (E9).
//
// Параметры:
//  Отказ - Булево - устанавливается при удалении иного автовыпуска.
//
Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Или Не Проведен И ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	Производство.ПроверитьПравкуАвтовыпуска(ЭтотОбъект, Отказ);
	Если Не Отказ Тогда
		ТребованияНакладные.ПроверитьПравкуВыпускаПоТребованию(ЭтотОбъект, Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.ОбновитьПроизводственныйСтатусЗаказа(ЭтотОбъект);
	// Проведённый документ, перезаписанный без перепроведения, пересчитывает стадии своих заказов (E8).
	ПроизводственныеЗаказы.ОбновитьСтадииПриЗаписи(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ручной выпуск продукции заказа на производство - без требования-накладной и не автовыпуск: его сверяют с открытыми
// требованиями по той же продукции.
//
// Возвращаемое значение:
//  Булево - Истина у такого выпуска
//
Функция ВыпускБезТребованияПоЗаказу()
	Возврат ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") И ЗначениеЗаполнено(Основание)
		И Не ЗначениеЗаполнено(Требование) И Не Производство.ЭтоАвтовыпуск(ЭтотОбъект);
КонецФункции

Процедура СинхронизироватьГотовуюПродукцию()
	// Источник данных проведения - ТЧГотоваяПродукция; шапка хранит первую позицию для
	// списков, печатных форм и розничной цены. Одна позиция (или пустая ТЧ) - строка
	// перестраивается из шапки; несколько - шапка повторяет первую строку.
	ИменаРеквизитов = "Номенклатура, Характеристика, Серия, Упаковка, КоличествоУпаковок, Количество";
	Если ТЧГотоваяПродукция.Количество() <= 1 И ЗначениеЗаполнено(Номенклатура) Тогда
		ТЧГотоваяПродукция.Очистить();
		НоваяСтрока = ТЧГотоваяПродукция.Добавить();
		НоваяСтрока.КодСтроки = 1;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект, ИменаРеквизитов);
		Возврат;
	КонецЕсли;
	Если ТЧГотоваяПродукция.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ТЧГотоваяПродукция[0], ИменаРеквизитов);
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьПроверяемыйРеквизит(ПроверяемыеРеквизиты, Имя)
	Элемент = ПроверяемыеРеквизиты.Найти(Имя);
	Если Элемент <> Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(Элемент);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
