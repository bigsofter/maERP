
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	// Данные для проведения
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ТЗТоварыССериями", СерииИРазмещение.ОбъединитьТоварыССериями(ЭтотОбъект));
	// Блокировки
	Блокировка = Новый БлокировкаДанных;
	УправляемыеБлокировки.ТоварыВНаличии(Блокировка, ТЧТовары);
	Блокировка.Заблокировать();
	// Формируем
	Отказ = Не РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(ЭтотОбъект);
	Если Отказ Тогда Возврат КонецЕсли;
	Если ЗначениеЗаполнено(ЦенаРозничная) И ТЧГотоваяПродукция.Количество() = 1 Тогда 
		НС = Движения.ЦеныНоменклатуры.Добавить();
		НС.Период = Дата;
		НС.ВидЦены = Справочники.ВидыЦен.Розничная;
		НС.Номенклатура = Номенклатура;
		НС.Характеристика = Характеристика;
		НС.ТоварнаяГруппа = Номенклатура.ТоварнаяГруппа;
		НС.Цена = ЦенаРозничная;
	КонецЕсли;
	// Записываем
	Движения.Записать();
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Выпускаемая продукция задаётся либо шапкой (одна позиция), либо строками
	// ТЧГотоваяПродукция (мультивыпуск) - обязательно заполнение одного из двух.
	Если ТЧГотоваяПродукция.Количество() = 0 Тогда
		УдалитьПроверяемыйРеквизит(ПроверяемыеРеквизиты, "ТЧГотоваяПродукция");
	Иначе
		УдалитьПроверяемыйРеквизит(ПроверяемыеРеквизиты, "Номенклатура");
		УдалитьПроверяемыйРеквизит(ПроверяемыеРеквизиты, "КоличествоУпаковок");
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	СинхронизироватьГотовуюПродукцию();
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.ОбновитьПроизводственныйСтатусЗаказа(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СинхронизироватьГотовуюПродукцию()
	// Источник данных проведения - ТЧГотоваяПродукция; шапка хранит первую позицию для
	// списков, печатных форм и розничной цены. Одна позиция (или пустая ТЧ) - строка
	// перестраивается из шапки; несколько - шапка повторяет первую строку.
	ИменаРеквизитов = "Номенклатура, Характеристика, Серия, Упаковка, КоличествоУпаковок, Количество";
	Если ТЧГотоваяПродукция.Количество() <= 1 И ЗначениеЗаполнено(Номенклатура) Тогда
		ТЧГотоваяПродукция.Очистить();
		НоваяСтрока = ТЧГотоваяПродукция.Добавить();
		НоваяСтрока.КодСтроки = 1;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект, ИменаРеквизитов);
	ИначеЕсли ТЧГотоваяПродукция.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ТЧГотоваяПродукция[0], ИменаРеквизитов);
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьПроверяемыйРеквизит(ПроверяемыеРеквизиты, Имя)
	Элемент = ПроверяемыеРеквизиты.Найти(Имя);
	Если Элемент <> Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(Элемент);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
