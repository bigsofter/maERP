#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	Дата = ТекущаяДатаСеанса();
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Номенклатура") Тогда
		Номенклатура = ДанныеЗаполнения;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	Если ТЧМатериалы.Количество() = 0 Тогда
		// Пустой состав - законное состояние: карта отменена. Одна маркерная запись с пустым
		// материалом и нулём отменяет прежнюю версию, а отсутствие движений вернуло бы чтение
		// к предыдущему документу.
		НоваяЗапись = Движения.СоставТехКарты.Добавить();
		НоваяЗапись.Период = Дата;
		НоваяЗапись.Продукция = Номенклатура;
		НоваяЗапись.Количество = 0;
		Движения.Записать();
		Возврат;
	КонецЕсли;
	Для Каждого Стр Из СвёрнутыйСостав() Цикл
		НоваяЗапись = Движения.СоставТехКарты.Добавить();
		НоваяЗапись.Период = Дата;
		НоваяЗапись.Продукция = Номенклатура;
		НоваяЗапись.Материал = Стр.Номенклатура;
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Стр, "Характеристика, Упаковка, Количество");
	КонецЦикла;
	Движения.Записать();
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Пустая ТЧМатериалы - законное состояние (отмена карты), строк не требуем.
	Для Каждого Стр Из ТЧМатериалы Цикл
		Если ЗначениеЗаполнено(Номенклатура) И Стр.Номенклатура = Номенклатура Тогда
			ТекстОшибки = НСтр("ru = 'Материал совпадает с продукцией: карта включает саму себя';
				|fr = 'La matière coïncide avec le produit : la gamme se contient elle-même';
				|en = 'The material matches the product: the routing includes itself';
				|es = 'El material coincide con el producto: la ruta se incluye a sí misma'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,
				"ТЧМатериалы[" + Формат(Стр.НомерСтроки - 1, "ЧГ=0") + "].Номенклатура", , Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Состав карты, приведённый к измерениям регистра.
// Измерения регистра - продукция, материал и характеристика: две строки с одним материалом
// и одной характеристикой дали бы дубль ключа и падение записи движений. Количество таких
// строк суммируется, упаковка остаётся от первой строки - разные упаковки одного материала
// регистр не различает.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура, Характеристика, Упаковка, Количество.
//
Функция СвёрнутыйСостав()
	ТЗ = ТЧМатериалы.Выгрузить(, "Номенклатура, Характеристика, Упаковка, Количество");
	ТЗ.Свернуть("Номенклатура, Характеристика, Упаковка", "Количество");
	Результат = ТЗ.СкопироватьКолонки();
	Для Каждого Стр Из ТЗ Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика", Стр.Номенклатура, Стр.Характеристика);
		Найденные = Результат.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Стр);
		Иначе
			Найденные[0].Количество = Найденные[0].Количество + Стр.Количество;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
