#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	Дата = ТекущаяДатаСеанса();
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Номенклатура") Тогда
		Номенклатура = ДанныеЗаполнения;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Способ изготовления заполняется здесь, а не в фасаде записи карт: форма документа, копирование и
	// прямая запись объекта идут мимо фасада, и в регистр ушла бы пустая ссылка перечисления - состояние,
	// которого не знает ни одна ветка разбора состава. Умолчание то же, что у обработчика обновления.
	Для Каждого Стр Из ТЧМатериалы Цикл
		Если ЗначениеЗаполнено(Стр.Номенклатура) И Не ЗначениеЗаполнено(Стр.СпособИзготовления) Тогда
			Стр.СпособИзготовления = Перечисления.СпособыИзготовления.НашеПроизводство;
		КонецЕсли;
	КонецЦикла;
	// Тот же порядок блокировок, что у фасада и проведения заказа на производство: сначала карты продукции,
	// потом документ карты - иначе запись из формы карты и проведение заказа ждали бы друг друга.
	// При смене продукции у записанной карты записи прежней продукции тоже удаляются - блокируются обе.
	Продукция = Новый Массив;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Продукция.Добавить(Номенклатура);
	КонецЕсли;
	Если Не ЭтоНовый() Тогда
		ПрежняяПродукция = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Номенклатура");
		Если ЗначениеЗаполнено(ПрежняяПродукция) И Продукция.Найти(ПрежняяПродукция) = Неопределено Тогда
			Продукция.Добавить(ПрежняяПродукция);
		КонецЕсли;
	КонецЕсли;
	Если Продукция.Количество() > 0 Тогда
		ТехнологическиеКарты.ЗаблокироватьКартыПродукции(Продукция);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	Если ТЧМатериалы.Количество() = 0 Тогда
		// Пустой состав - законное состояние: карта отменена. Одна маркерная запись с пустым
		// материалом и нулём отменяет прежнюю версию, а отсутствие движений вернуло бы чтение
		// к предыдущему документу.
		НоваяЗапись = Движения.СоставТехКарты.Добавить();
		НоваяЗапись.Период = Дата;
		НоваяЗапись.Продукция = Номенклатура;
		НоваяЗапись.Количество = 0;
		Движения.Записать();
		Возврат;
	КонецЕсли;
	Для Каждого Стр Из СвёрнутыйСостав() Цикл
		НоваяЗапись = Движения.СоставТехКарты.Добавить();
		НоваяЗапись.Период = Дата;
		НоваяЗапись.Продукция = Номенклатура;
		НоваяЗапись.Материал = Стр.Номенклатура;
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Стр,
			"Характеристика, Упаковка, Количество, СпособИзготовления, ПроцентПотерь");
	КонецЦикла;
	Движения.Записать();
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Пустая ТЧМатериалы - законное состояние (отмена карты), строк не требуем.
	Для Каждого Стр Из ТЧМатериалы Цикл
		Если ЗначениеЗаполнено(Номенклатура) И Стр.Номенклатура = Номенклатура Тогда
			ТекстОшибки = НСтр("ru = 'Материал совпадает с продукцией: карта включает саму себя';
				|fr = 'La matière coïncide avec le produit : la gamme se contient elle-même';
				|en = 'The material matches the product: the routing includes itself';
				|es = 'El material coincide con el producto: la ruta se incluye a sí misma'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,
				"ТЧМатериалы[" + Формат(Стр.НомерСтроки - 1, "ЧГ=0") + "].Номенклатура", , Отказ);
		КонецЕсли;
	КонецЦикла;
	// Правило общее с карточкой номенклатуры, поэтому живёт в фасаде: свёртка состава молча берёт
	// значения первой строки группы, и без этой проверки второй способ пропал бы незаметно.
	Для Каждого Конфликт Из ТехнологическиеКарты.КонфликтыСвойствИзготовления(ТЧМатериалы) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Конфликт.Текст, ЭтотОбъект,
			"ТЧМатериалы[" + Формат(Конфликт.Индекс, "ЧГ=0") + "]." + Конфликт.Поле, , Отказ);
	КонецЦикла;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Состав карты, приведённый к измерениям регистра.
// Измерения регистра - продукция, материал и характеристика: две строки с одним материалом
// и одной характеристикой дали бы дубль ключа и падение записи движений. Количество таких
// строк суммируется, а упаковка, способ изготовления и процент потерь остаются от первой
// строки группы - разные упаковки одного материала регистр не различает, а разные способ и
// процент до сюда не доходят: их отсекает проверка заполнения.
// ТЗ.Свернуть здесь не применяется: он оставляет в таблице только перечисленные колонки и молча
// снёс бы способ и процент, а класть процент в ресурсы свёртки нельзя - он просуммировался бы.
// Группировку и так делает проход ниже, и делает её грубее (без упаковки), поэтому набор строк и
// суммы от отказа от Свернуть не меняются; порядок строк становится порядком строк документа.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура, Характеристика, Упаковка, Количество,
//                    СпособИзготовления, ПроцентПотерь.
//
Функция СвёрнутыйСостав()
	ТЗ = ТЧМатериалы.Выгрузить(,
		"Номенклатура, Характеристика, Упаковка, Количество, СпособИзготовления, ПроцентПотерь");
	Результат = ТЗ.СкопироватьКолонки();
	Для Каждого Стр Из ТЗ Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика", Стр.Номенклатура, Стр.Характеристика);
		Найденные = Результат.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Стр);
		Иначе
			Найденные[0].Количество = Найденные[0].Количество + Стр.Количество;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
