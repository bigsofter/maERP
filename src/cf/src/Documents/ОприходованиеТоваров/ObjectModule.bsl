
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	ЦенаВключаетНДС = Истина;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПересчётТоваров") Тогда
		ЗаполнитьПоПересчетуТоваров(ДанныеЗаполнения);
	КонецЕсли;	
КонецПроцедуры

// Излишки пересчёта: строки с положительным отклонением, цена - прежняя, иначе последний приход (с НДС).
//
// Параметры:
//  Пересчет - ДокументСсылка.ПересчётТоваров - основание.
//
Процедура ЗаполнитьПоПересчетуТоваров(Пересчет)
	Основание = Пересчет;
	Организация = Пересчет.Организация;
	МестоХранения = Пересчет.МестоХранения;
	МасНоменклатура = Пересчет.ТЧТовары.ВыгрузитьКолонку("Номенклатура");
	Данные = Новый Структура;
	Данные.Вставить("ТЗЦены", РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(ТекущаяДатаСеанса(), МасНоменклатура));
	Данные.Вставить("СтавкиНДС", ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МасНоменклатура, "СтавкаНДС"));
	Данные.Вставить("ТЗПредыдущиеДанные", ТЧТовары.Выгрузить());
	ТЧТовары.Очистить();
	Для Каждого Стр Из Пересчет.ТЧТовары Цикл
		Отклонение = Стр.КоличествоУпаковокФакт - Стр.КоличествоУпаковок;
		Если Отклонение <= 0 Тогда Продолжить КонецЕсли;
		НС = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Стр);
		НС.КоличествоУпаковок = Отклонение;
		НС.Количество = Стр.КоличествоФакт - Стр.Количество;
		ЗаполнитьЦенуИСтавкуСтроки(НС, Стр, Данные);
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(НС, ЦенаВключаетНДС);
	КонецЦикла;	
КонецПроцедуры

Процедура ЗаполнитьЦенуИСтавкуСтроки(НС, Стр, Данные)
	РеквизитыНоменклатуры = Данные.СтавкиНДС[Стр.Номенклатура];
	Если РеквизитыНоменклатуры <> Неопределено Тогда
		НС.СтавкаНДС = РеквизитыНоменклатуры.СтавкаНДС;
	КонецЕсли;
	Отбор = Новый Структура("Номенклатура, Характеристика, Упаковка", Стр.Номенклатура, Стр.Характеристика, Стр.Упаковка);
	Мас = Данные.ТЗПредыдущиеДанные.НайтиСтроки(Отбор);
	Если Мас.Количество() > 0 Тогда
		НС.Цена = Мас[0].Цена;
		Возврат;
	КонецЕсли;
	Мас = Данные.ТЗЦены.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Стр.Номенклатура, Стр.Характеристика));
	Если Мас.Количество() > 0 Тогда
		НС.Цена = Мас[0].Цена * (НС.Количество / НС.КоличествоУпаковок);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	// Данные для проведения
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ТЗТоварыССериями", СерииИРазмещение.ОбъединитьТоварыССериями(ЭтотОбъект));

	// Блокировки
	Блокировка = Новый БлокировкаДанных;
	УправляемыеБлокировки.ТоварыВНаличии(Блокировка, ТЧТовары, МестоХранения);
	Блокировка.Заблокировать();
	// Формируем
	РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(ЭтотОбъект);
	// Записываем
	Движения.Записать();
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	// Строки, введённые до появления НДС в табличной части: сумма с НДС равна сумме.
	Для Каждого Стр Из ТЧТовары Цикл
		Если Стр.СуммаСНДС = 0 И Стр.Сумма <> 0 Тогда
			Стр.СуммаСНДС = Стр.Сумма;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


