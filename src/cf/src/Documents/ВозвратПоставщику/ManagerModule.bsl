#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы объекта: фирменная форма возврата поставщику
// (docs/plans/commerce-clients-typical.md, Ф6).
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаВозврата(), ВидФормыВозврата(), "", ИмяКомандыВозврата());

КонецПроцедуры

// Формирует запрошенные печатные формы.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые объекты
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Право на команду - и на сервере: экспортный путь печати принимает любое имя макета (docs/plans/branded-print.md,
	// раздел 13.6).
	ФирменнаяПечать.ПроверитьПравоНаКоманду(КоллекцияПечатныхФорм, ИмяМакетаВозврата(), КомандаПечати(), ПараметрыПечати);
	ФирменнаяПечать.Напечатать(ИмяМакетаВозврата(), ВидФормыВозврата(), МассивОбъектов, ПараметрыПечати,
		КоллекцияПечатныхФорм, ОбъектыПечати);

КонецПроцедуры

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать): возврат поставщику - одним запросом шапок на массив
// возвратов. Организация слева, поставщик справа; основание - поступление; оплат нет.
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.ВозвратПоставщику - печатаемые возвраты.
//  ВидФормы        - Строка - вид фирменной формы: RetourFournisseur.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати.
//
// Возвращаемое значение:
//  Соответствие - возврат -> источник печати (см. ФирменнаяПечать.ИсточникТоварногоДокумента).
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт

	// Адаптер выбирается по типу ссылки: вид и право на команду он проверяет сам (ревью безопасности фазы 6 branded-print).
	ФирменнаяПечать.ПроверитьКомандуАдаптера(ВидФормы, ?(ВидФормы = ВидФормыВозврата(), КомандаПечати(), Неопределено),
		ПараметрыПечати);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Возвраты.Ссылка КАК Ссылка,
	|	Возвраты.Номер КАК НомерДокумента,
	|	Возвраты.Дата КАК Дата,
	|	Возвраты.Организация КАК Организация,
	|	Возвраты.Контрагент КАК Контрагент,
	|	Возвраты.Договор КАК Договор,
	|	Возвраты.Валюта КАК Валюта,
	|	Возвраты.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Возвраты.Сумма КАК Сумма,
	|	Возвраты.СуммаНДС КАК СуммаНДС,
	|	Возвраты.Комментарий КАК Комментарий,
	|	ПРЕДСТАВЛЕНИЕ(Возвраты.Ответственный) КАК Менеджер,
	|	ПРЕДСТАВЛЕНИЕ(Возвраты.Ответственный) КАК Автор,
	|	ЕСТЬNULL(Поступления.Номер, """") КАК НомерОснования,
	|	ЕСТЬNULL(Поступления.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОснования,
	|	ЕСТЬNULL(Контрагенты.Код, """") КАК КодКонтрагента
	|ИЗ
	|	Документ.ВозвратПоставщику КАК Возвраты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Возвраты.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК Поступления
	|		ПО Возвраты.Основание = Поступления.Ссылка
	|ГДЕ
	|	Возвраты.Ссылка В(&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Строки = ФирменнаяПечать.ДанныеСтрокДокументов(Метаданные.Документы.ВозвратПоставщику.Имя, Ссылки, "ТЧТовары");
	Кэш = ФирменнаяПечать.НовыйКэш();
	ПодписьОснования = НСтр("ru = 'Поступление'; fr = 'Réception'; en = 'Goods receipt'; es = 'Recepción'", КодЯзыка);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Шапка = ФирменнаяПечать.НоваяШапкаДокумента();
		ЗаполнитьЗначенияСвойств(Шапка, Выборка);
		Шапка.Номер = ФирменнаяПечать.НомерНакладной(Выборка.НомерДокумента, Выборка.Дата);
		Если ЗначениеЗаполнено(Выборка.НомерОснования) Тогда
			НомерОснования = ФирменнаяПечать.НомерНакладной(Выборка.НомерОснования, Выборка.ДатаОснования);
			Шапка.Основание = ФирменнаяПечать.ПредставлениеОснования(ПодписьОснования, НомерОснования,
				Выборка.ДатаОснования, КодЯзыка);
		КонецЕсли;
		ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента("Retour fournisseur", Выборка.НомерДокумента, Выборка.Дата);
		Результат.Вставить(Выборка.Ссылка,
			ФирменнаяПечать.ИсточникТоварногоДокумента(Шапка, Строки[Выборка.Ссылка], Кэш, ИмяФайла));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяМакетаВозврата()
	Возврат "RetourFournisseur";
КонецФункции

Функция ВидФормыВозврата()
	Возврат "RetourFournisseur";
КонецФункции

Функция ИмяКомандыВозврата()
	Возврат "ПечатьВозвратПоставщику";
КонецФункции

Функция КомандаПечати()
	Возврат Метаданные.Документы.ВозвратПоставщику.Команды[ИмяКомандыВозврата()];
КонецФункции

#КонецОбласти

#КонецЕсли

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Представление = НСтр("ru = 'Возврат поставщику'; fr = 'Retour fournisseur'; en = 'Return to supplier';
		|es = 'Devolución al proveedor'");
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Представление, Данные.Номер, " ");
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Представление, Формат(Данные.Дата, "ДЛФ=D"),
		НСтр("ru = ' от '; fr = ' du '; en = ' of '; es = ' de '"));

КонецПроцедуры

#КонецОбласти
