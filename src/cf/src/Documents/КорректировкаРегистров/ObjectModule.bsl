#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Прежние стоимостные записи из базы - до их замены: ПриЗаписи сдвинет границу и на их период (запись могли
	// перенести на более позднюю дату или удалить).
	ДополнительныеСвойства.Вставить("ПериодПрежнихСтоимостныхЗаписей", ПериодСтоимостныхЗаписейВБазе());
	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = ПараметрыСеанса.Пользователь;
	КонецЕсли;
КонецПроцедуры

// Ручные движения стоимостных регистров влияют на себестоимость всех документов последовательности позже них:
// граница последовательности сдвигается назад на самый ранний период прежних и новых записей (документ в
// последовательность не входит - он не проводится; план warehouse-orders-cost, Ф1.1).
//
// Параметры:
//  Отказ - Булево - не используется.
//
Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	СамыйРанний = Неопределено;
	ДополнительныеСвойства.Свойство("ПериодПрежнихСтоимостныхЗаписей", СамыйРанний);
	Для Каждого Регистр Из СтоимостныеРегистры() Цикл
		Набор = Движения[Регистр.Имя];
		Если Не Набор.Записывать Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Запись Из Набор Цикл
			СамыйРанний = РанняяДата(СамыйРанний, Запись.Период);
		КонецЦикла;
	КонецЦикла;
	СдвинутьГраницуПоследовательности(СамыйРанний);
КонецПроцедуры

// Удаление документа удаляет и его движения: граница - на самый ранний период стоимостных записей.
//
// Параметры:
//  Отказ - Булево - не используется.
//
Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	СдвинутьГраницуПоследовательности(ПериодСтоимостныхЗаписейВБазе());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Стоимостные регистры последовательности, которые документ правит вручную (ТоварыВПереработке он не пишет).
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных - регистры накопления
//
Функция СтоимостныеРегистры()
	Регистры = Новый Массив;
	Регистры.Добавить(Метаданные.РегистрыНакопления.ТоварыВНаличии);
	Регистры.Добавить(Метаданные.РегистрыНакопления.ДополнительныеРасходы);
	Возврат Регистры;
КонецФункции

Функция ПериодСтоимостныхЗаписейВБазе()
	Если ЭтоНовый() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	МИНИМУМ(Записи.Период) КАК Период
		|ИЗ
		|	(ВЫБРАТЬ
		|		МИНИМУМ(ТоварыВНаличии.Период) КАК Период
		|	ИЗ
		|		РегистрНакопления.ТоварыВНаличии КАК ТоварыВНаличии
		|	ГДЕ
		|		ТоварыВНаличии.Регистратор = &Ссылка
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		МИНИМУМ(ДополнительныеРасходы.Период)
		|	ИЗ
		|		РегистрНакопления.ДополнительныеРасходы КАК ДополнительныеРасходы
		|	ГДЕ
		|		ДополнительныеРасходы.Регистратор = &Ссылка) КАК Записи");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Период), Выборка.Период, Неопределено);
КонецФункции

Функция РанняяДата(Дата, Период)
	Если Не ЗначениеЗаполнено(Период) Тогда
		Возврат Дата;
	КонецЕсли;
	Возврат ?(Дата = Неопределено Или Период < Дата, Период, Дата);
КонецФункции

Процедура СдвинутьГраницуПоследовательности(Период)
	Если Период <> Неопределено Тогда
		РаботаСДокументами.СдвинутьГраницуПоследовательностиНазад(РаботаСДокументами.МоментДоДаты(Период));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
