
&НаКлиенте
Процедура ТЧТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если Не ОтменаРедактирования Тогда
		Стр = Элемент.ТекущиеДанные;
		Стр.ДатаРасчета = ПолучитьДатуСеанса();
		Стр.КоличествоИсх = ?(Не ЗначениеЗаполнено(Объект.ПересчетТовара), 0, ПолучитьКоличествоИзИныентаризации(Стр.Номенклатура));
		Стр.КоличествоУпаковокОтклонение = Стр.Количество - Стр.КоличествоИсх
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьДатуСеанса()
	Возврат ТекущаяДатаСеанса();
КонецФункции

&НаКлиенте
Процедура ТЧТоварыНоменклатураПриИзменении(Элемент)
	Если Не Элементы.ТЧТовары.ТекущиеДанные = Неопределено Тогда 
		СтруктураТоварПосчитан = ТоварУжеПосчитан(Элементы.ТЧТовары.ТекущиеДанные.Номенклатура);
		Если СтруктураТоварПосчитан.Посчитан Тогда
			ТекстПредупреждения = НСтр("ru = 'Товар уже посчитан пользователем '; fr = 'Le produit a déjà été compté par '");
			Для Каждого Эл из СтруктураТоварПосчитан.Значение Цикл
				ТекстПредупреждения = ТекстПредупреждения + Символы.ПС;
				ТекстПредупреждения = ТекстПредупреждения + Эл.Ответственный + " - " + Эл.ДатаРасчета + ". Qté "+ Эл.Количество;
			КонецЦикла;
			ПоказатьПредупреждение(,ТекстПредупреждения);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ТоварУжеПосчитан(Товар)
	Структура = Новый Структура("Посчитан,Значение",Ложь,Новый Массив);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданиеНаПересчетТЧТовары.Номенклатура КАК Номенклатура,
	|	ЗаданиеНаПересчетТЧТовары.ДатаРасчета КАК ДатаРасчета,
	|	ЗаданиеНаПересчетТЧТовары.Ссылка.Ответственный КАК Ответственный,
	|	ЗаданиеНаПересчетТЧТовары.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаданиеНаПересчет.ТЧТовары КАК ЗаданиеНаПересчетТЧТовары
	|ГДЕ
	|	ЗаданиеНаПересчетТЧТовары.Ссылка.ПересчетТовара = &ПересчетТовара
	|	И ЗаданиеНаПересчетТЧТовары.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("ПересчетТовара", Объект.ПересчетТовара);
	Запрос.УстановитьПараметр("Номенклатура", Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Количество() = 0 Тогда
		Структура.Посчитан = Истина;
		Пока Выборка.Следующий() Цикл
			СтруктураЗначения = Новый Структура("Ответственный,ДатаРасчета, Количество",Неопределено,Неопределено, 0);
			СтруктураЗначения.Ответственный = Выборка.Ответственный;
			СтруктураЗначения.ДатаРасчета = Выборка.ДатаРасчета;
			СтруктураЗначения.Количество = Выборка.Количество;
			Структура.Значение.Добавить(СтруктураЗначения);
		КонецЦикла;
	КонецЕсли;
	Возврат Структура;
КонецФункции

&НаСервере
Функция ПолучитьКоличествоИзИныентаризации(Товар)
	КолИсх = 0;
	Стр = Объект.ПересчетТовара.ТЧТовары.Найти(Товар,"Номенклатура");
	Если Не Стр = Неопределено Тогда 
		КолИсх = Стр.КоличествоУпаковок;
	КонецЕсли;
	Возврат КолИсх;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьКоличествоИсх();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗаполнитьКоличествоИсх();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКоличествоИсх()
	Если Не ЗначениеЗаполнено(Объект.ПересчетТовара) Тогда Возврат; КонецЕсли;
	Для Каждого Стр из Объект.ТЧТовары Цикл
		Стр.КоличествоИсх = ПолучитьКоличествоИзИныентаризации(Стр.Номенклатура);
		Стр.КоличествоУпаковокОтклонение = Стр.Количество - Стр.КоличествоИсх
	КонецЦикла;
КонецПроцедуры
