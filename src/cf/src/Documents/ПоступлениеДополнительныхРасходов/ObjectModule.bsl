
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Контрагент = ДанныеЗаполнения.Контрагент;
		Договор = ДанныеЗаполнения.Договор; 
		Организация = ДанныеЗаполнения.Организация;
		ЦенаВключаетНДС = ДанныеЗаполнения.ЦенаВключаетНДС; 
		Для Каждого Стр Из ДанныеЗаполнения.ТЧТовары Цикл
			НС = ТЧТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Стр, "Номенклатура, Характеристика");			
			НС.ДокументПартии = ДанныеЗаполнения;
			НС.СуммаТовара = Стр.СуммаСНДС;
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

// Приходные ордера базы распределения: указанные партией строки и ордера пар указанных поступлений.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ПриходныйОрдер - ордера.
//
Функция ОрдераБазы()
	Ордера = Новый Массив;
	Поступления = Новый Массив;
	Для Каждого Строка Из ТЧТовары Цикл
		Если ТипЗнч(Строка.ДокументПартии) = Тип("ДокументСсылка.ПриходныйОрдер") Тогда
			Ордера.Добавить(Строка.ДокументПартии);
		ИначеЕсли ТипЗнч(Строка.ДокументПартии) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			Поступления.Добавить(Строка.ДокументПартии);
		Иначе
			Продолжить; // партия другого документа - ордеров не касается
		КонецЕсли;
	КонецЦикла;
	Если Поступления.Количество() > 0 Тогда
		Для Каждого Пара Из РегистрыНакопления.ТоварыКОформлению.ПарыОформления(Поступления) Цикл
			Ордера.Добавить(Пара.Источник);
		КонецЦикла;
	КонецЕсли;
	Результат = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Ордера, Истина);
	Возврат Результат;
КонецФункции

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	// Блокировки
	Блокировка = Новый БлокировкаДанных;
	УправляемыеБлокировки.ДополнительныеРасходы(Блокировка, ТЧТовары);
	// База на партиях приходных ордеров (прямо или через поступления их пар) не меняется до записи: отмена и
	// перепроведение ордера и поступления берут ту же блокировку оформления по ордеру (Ф3.9).
	УправляемыеБлокировки.ТоварыКОформлению(Блокировка, ОрдераБазы());
	УправляемыеБлокировки.ВзаиморасчётыСПоставщиками(Блокировка, Контрагент);
	Блокировка.Заблокировать();
	// Формируем
	// Строка без базы распределения и ордер не раньше документа - отказ (warehouse-orders-cost, Ф3.9).
	РегистрыНакопления.ДополнительныеРасходы.РаспределитьНаСебестоимость(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	РегистрыНакопления.ВзаиморасчётыСПоставщиками.СформироватьДвижения(ЭтотОбъект);
	// Записываем
	Движения.Записать();
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
КонецПроцедуры

