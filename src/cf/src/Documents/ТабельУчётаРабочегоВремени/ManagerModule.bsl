////////////////////////////////////////////////////////////////////////////////
// Печать табеля учёта рабочего времени: перенесена из модуля команды в подсистему
// печатных форм (конвенция ДобавитьКомандыПечати/Печать).
//
// В названиях реквизитов и в тексте печатной формы используется буква "ё",
// как принято в метаданных maERP.
// BSLLS:YoLetterUsage-off
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы документа.
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "Табель";
	Команда.Представление = НСтр("ru = 'Табель учёта рабочего времени'; fr = 'Feuille de temps';
		|en = 'Timesheet'; es = 'Hoja de horas'");

КонецПроцедуры

// Формирует запрошенные печатные формы документа.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые документы
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие документов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если Не ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "Табель") Тогда
		Возврат;
	КонецЕсли;

	Таб = Новый ТабличныйДокумент;
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Таб.АвтоМасштаб = Истина;
	Для Каждого Док Из МассивОбъектов Цикл
		НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
		ПечатьТабеля(Док, Таб);
		ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
	КонецЦикла;

	ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "Табель",
		НСтр("ru = 'Табель учёта рабочего времени'; fr = 'Feuille de temps';
			|en = 'Timesheet'; es = 'Hoja de horas'"),
		Таб, "Документ.ТабельУчётаРабочегоВремени.Табель");

КонецПроцедуры

// Выводит табель одного документа в табличный документ.
//
// Параметры:
//  Док - ДокументСсылка.ТабельУчётаРабочегоВремени - печатаемый документ
//  Таб - ТабличныйДокумент                        - документ вывода
//
Процедура ПечатьТабеля(Док, Таб) Экспорт
	КоличествоДнейВМесяце = День(КонецМесяца(Док.Дата));
	Макет = ПечатныеФормы.МакетПечатнойФормы("Документ.ТабельУчётаРабочегоВремени.Табель");
	оШапкаОсновная = Макет.ПолучитьОбласть("Шапка|Основная");
	оШапкаДата = Макет.ПолучитьОбласть("Шапка|Дата");
	оСтрокаОсновная = Макет.ПолучитьОбласть("Строка|Основная");
	оСтрокаДата = Макет.ПолучитьОбласть("Строка|Дата");
	оШапкаОсновная.Параметры.Номер = Док.Номер;
	оШапкаОсновная.Параметры.Период = Формат(Док.Дата, "ДФ='MMMM yyyy'");
	оШапкаОсновная.Параметры.Группа = Док.Группа;
	Таб.Вывести(оШапкаОсновная);	
	мДата = НачалоМесяца(Док.Дата);
	Для А = 1 По КоличествоДнейВМесяце Цикл
		НомерДня = День(мДата);
		НомерДняНедели = ДеньНедели(мДата);		
		оШапкаДата.Параметры.Дата = СокрЛП(НомерДня) + " (" + ПолучитьДеньНеделиПоНомеру(НомерДняНедели) + ")";
		Таб.Присоединить(оШапкаДата);
		мДата = КонецДня(мДата) + 1;
	КонецЦикла;	
	Ном = 1;
	Для Каждого Стр Из Док.ТЧТабель Цикл
		оСтрокаОсновная.Параметры.Ном = Ном;
		оСтрокаОсновная.Параметры.Сотрудник = Стр.Сотрудник;
		оСтрокаОсновная.Параметры.ВариантУчётаРабочегоВремени = Стр.ВариантУчётаРабочегоВремени;
		оСтрокаОсновная.Параметры.ПоГрафику = Стр.ПоГрафику;
		оСтрокаОсновная.Параметры.Отработано = Стр.Отработано;
		Таб.Вывести(оСтрокаОсновная);
		Для А = 1 По КоличествоДнейВМесяце Цикл
			Если ЗначениеЗаполнено(Стр["_" + А]) И Стр["_" + А] <> Ложь Тогда
				оСтрокаДата.Параметры.Выход = Стр["_" + А];
				оСтрокаДата.Области.Выход.ЦветФона = ЦветаСтиля.ЦветФонаГруппировкиОтчета2;
			Иначе	
				оСтрокаДата.Параметры.Выход = "";
				оСтрокаДата.Области.Выход.ЦветФона = WebЦвета.Белый;
			КонецЕсли;			
			Таб.Присоединить(оСтрокаДата);	
		КонецЦикла;	
		Ном = Ном + 1;
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Русское сокращение дня недели по его номеру.
//
// Параметры:
//  Номер - Число - номер дня недели, 1 - понедельник
//
// Возвращаемое значение:
//  Строка - сокращение дня недели
//
Функция ПолучитьДеньНеделиПоНомеру(Номер)

	Сокращения = СтрРазделить(НСтр("ru = 'пн.,вт.,ср.,чт.,пт.,сб.,вс.';
		|fr = 'lun.,mar.,mer.,jeu.,ven.,sam.,dim.';
		|en = 'Mon,Tue,Wed,Thu,Fri,Sat,Sun';
		|es = 'lun.,mar.,mié.,jue.,vie.,sáb.,dom.'"), ",");

	Если Номер < 1 Или Номер > Сокращения.Количество() Тогда
		Возврат "";
	КонецЕсли;

	Возврат Сокращения[Номер - 1];

КонецФункции

#КонецОбласти
