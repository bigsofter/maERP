#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	Дата = ТекущаяДатаСеанса();
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.ПроизводственноеОборудование") Тогда
		Станок = ДанныеЗаполнения;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("Станок") Тогда
		Станок = ДанныеЗаполнения.Станок;
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ЗначениеЗаполнено(Начало) И ЗначениеЗаполнено(Окончание) И Окончание <= Начало Тогда
		ТекстОшибки = НСтр("ru = 'Окончание обслуживания должно быть позже начала';
			|fr = 'La fin de la maintenance doit être postérieure au début';
			|en = 'The maintenance end must be later than the start';
			|es = 'El fin del mantenimiento debe ser posterior al inicio'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Окончание", , Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьПлановыеДаты();
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Запись «Загрузки станков» под исключительной блокировкой станка: пересечение с занятым временем станка
	// (правило - ЗагрузкаСтанков.ПересеченияЗагрузки) отклоняет проведение. Привилегированный режим проведения
	// задан в свойствах документа.
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);

	Блокировка = Новый БлокировкаДанных;
	УправляемыеБлокировки.ЗагрузкаСтанков(Блокировка, Станок);
	Блокировка.Заблокировать();

	ВидЗаписи = Перечисления.ВидыЗагрузкиСтанков.Обслуживание;
	Пересечения = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, Начало, Окончание, ВидЗаписи, Плановое, Ссылка);
	Для Каждого Пересечение Из Пересечения Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ЗагрузкаСтанков.ТекстПересеченияЗагрузки(Пересечение),
			ЭтотОбъект, "Начало", , Отказ);
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.ЗагрузкаСтанков.Очистить();
	Запись = Движения.ЗагрузкаСтанков.Добавить();
	Запись.Станок = Станок;
	Запись.Начало = Начало;
	Запись.Окончание = Окончание;
	Запись.Часы = ЗагрузкаСтанков.ЧасыМеждуДатами(Начало, Окончание);
	Запись.ВидЗаписи = ВидЗаписи;
	Запись.План = Плановое;
	Движения.Записать();
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
	ПланНачало = '00010101';
	ПланОкончание = '00010101';
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Плановые даты обслуживания (волна 5, OEE): пока документ плановый, они следуют за началом и окончанием (перенос на
// планировщике, правка в форме); после перевода в факт остаются как были. Документ, записанный плановым до появления
// реквизитов, при переводе в факт берёт плановые даты из базы - обработчик обновления не нужен.
Процедура ЗаполнитьПлановыеДаты()
	Если Плановое Тогда
		ПланНачало = Начало;
		ПланОкончание = Окончание;
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПланНачало) Или ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Сохраненные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Плановое, Начало, Окончание");
	Если Сохраненные.Плановое = Истина Тогда
		ПланНачало = Сохраненные.Начало;
		ПланОкончание = Сохраненные.Окончание;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
