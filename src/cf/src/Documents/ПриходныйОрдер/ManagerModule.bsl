#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы ордера: фирменная накладная без цен (docs/plans/warehouse-orders.md, фаза 2, §2.9).
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаОрдера(), ВидФормыОрдера(), , "ПечатьПриходныйОрдер");
КонецПроцедуры

// Формирует запрошенные печатные формы.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые объекты
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	// Право на команду - и на сервере: экспортный путь печати принимает любое имя макета.
	ФирменнаяПечать.ПроверитьПравоНаКоманду(КоллекцияПечатныхФорм, ИмяМакетаОрдера(),
		Метаданные.Документы.ПриходныйОрдер.Команды.ПечатьПриходныйОрдер, ПараметрыПечати);
	ФирменнаяПечать.Напечатать(ИмяМакетаОрдера(), ВидФормыОрдера(), МассивОбъектов, ПараметрыПечати,
		КоллекцияПечатныхФорм, ОбъектыПечати);
КонецПроцедуры

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать, ОрдераСклада.ДанныеФирменнойПечати).
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.ПриходныйОрдер - печатаемые ордера.
//  ВидФормы        - Строка - вид фирменной формы: BonDeReception.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати.
//
// Возвращаемое значение:
//  Соответствие - ордер -> источник печати.
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	// Ордер может прийти и в Печать другого документа: вид и право на команду проверяет сам адаптер.
	Команда = ?(ВидФормы = ВидФормыОрдера(), Метаданные.Документы.ПриходныйОрдер.Команды.ПечатьПриходныйОрдер, Неопределено);
	ФирменнаяПечать.ПроверитьКомандуАдаптера(ВидФормы, Команда, ПараметрыПечати);
	Возврат ОрдераСклада.ДанныеФирменнойПечати(Метаданные.Документы.ПриходныйОрдер.Имя, Ссылки, КодЯзыка);
КонецФункции

// Заполнение по заказу поставщику: шапка заказа, строки - что осталось получить по регистру «Заказы поставщикам»,
// строка заказа - в КодСтрокиЗаказа (план warehouse-orders, фаза 2, §2.4).
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер - заполняемый ордер.
//  Заказ - ДокументСсылка.ЗаказПоставщику - основание.
//
Процедура ЗаполнитьПоЗаказуПоставщику(Ордер, Заказ) Экспорт
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "Организация, Контрагент");
	ЗаполнитьЗначенияСвойств(Ордер, Реквизиты);
	Ордер.Основание = Заказ;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.КодСтроки КАК КодСтрокиЗаказа,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(, ЗаказПоставщику = &Заказ) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодСтрокиЗаказа");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	// Упаковка - единица хранения, её проставит ЗагрузитьСтроки.
	ЗагрузитьСтроки(Ордер, Запрос.Выполнить().Выгрузить());
КонецПроцедуры

// Заполнение по заказу клиента на производство - материалы, которые осталось получить (как у поступления:
// ПотребностиПроизводства.ОстатокКПоступлению).
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер - заполняемый ордер.
//  Заказ - ДокументСсылка.ЗаказПокупателя - основание.
//
Процедура ЗаполнитьПоЗаказуНаПроизводство(Ордер, Заказ) Экспорт
	Потребности = РегистрыНакопления.ПотребностиПроизводства;
	Если Не Потребности.ЗаказФормируетПотребность(Заказ) Тогда
		ВызватьИсключение Потребности.ТекстЗаказБезПотребности();
	КонецЕсли;
	Ордер.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заказ, "Организация");
	Ордер.Основание = Заказ;
	Остаток = Потребности.ОстатокКПоступлению(Заказ);
	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Номенклатура");
	Строки.Колонки.Добавить("Характеристика");
	Строки.Колонки.Добавить("Упаковка");
	Строки.Колонки.Добавить("Количество");
	Единицы = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Остаток.ВыгрузитьКолонку("Материал"), "Единица");
	Для Каждого Строка Из Остаток Цикл
		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.Номенклатура = Строка.Материал;
		НоваяСтрока.Характеристика = Строка.Характеристика;
		НоваяСтрока.Количество = Строка.Количество;
		Реквизиты = Единицы[Строка.Материал];
		Если Реквизиты <> Неопределено Тогда
			НоваяСтрока.Упаковка = Реквизиты.Единица;
		КонецЕсли;
	КонецЦикла;
	ЗагрузитьСтроки(Ордер, Строки);
	Если Остаток.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Потребности.ТекстПотребностьПолучена());
	КонецЕсли;
КонецПроцедуры

// Заполнение по документу товаров (как у поступления по реализации и у реализации по поступлению): организация,
// контрагент, склад, строки с сериями - по строке на серию.
//
// Параметры:
//  Ордер    - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - заполняемый ордер.
//  Документ - ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.ПоступлениеТоваровУслуг - основание.
//
Процедура ЗаполнитьПоДокументуТоваров(Ордер, Документ) Экспорт
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Организация, Контрагент, МестоХранения");
	ЗаполнитьЗначенияСвойств(Ордер, Реквизиты);
	Ордер.Основание = Документ;
	Строки = СерииИРазмещение.ОбъединитьТоварыССериями(Документ.ПолучитьОбъект());
	Строки.Колонки.Удалить("КодСтроки");
	ЗагрузитьСтроки(Ордер, Строки);
КонецПроцедуры

// Заполнение по документу-источнику (документ первый, план warehouse-orders-cost, Ф4.4): шапка документа, строки -
// неоформленный остаток строк документа с документом и ключом его строки; основание - заказ документа. У приёмки по
// поступлению с заказом поставщику строка заказа - код строки поступления (поступление хранит строки в кодах заказа).
//
// Параметры:
//  Ордер    - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - заполняемый ордер.
//  Документ - ДокументСсылка.ПоступлениеТоваровУслуг, ДокументСсылка.РеализацияТоваровУслуг - источник.
//
Процедура ЗаполнитьПоДокументуИсточнику(Ордер, Документ) Экспорт
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Организация, Контрагент, МестоХранения, Основание");
	ЗаполнитьЗначенияСвойств(Ордер, Реквизиты, "Организация, Контрагент, МестоХранения");
	Если Ордер.Метаданные().Реквизиты.Основание.Тип.СодержитТип(ТипЗнч(Реквизиты.Основание)) Тогда
		Ордер.Основание = Реквизиты.Основание;
	КонецЕсли;
	ПоЗаказуПоставщику = ТипЗнч(Реквизиты.Основание) = Тип("ДокументСсылка.ЗаказПоставщику")
		И ЗначениеЗаполнено(Реквизиты.Основание);
	Остатки = РегистрыНакопления.ТоварыКОформлению.НеоформленныеСтроки(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Документ));
	Строки = Новый ТаблицаЗначений;
	Колонки = "ДокументИсточник,КлючСтрокиДокумента,КодСтрокиЗаказа,Номенклатура,Характеристика,Серия,Количество";
	Для Каждого Имя Из СтрРазделить(Колонки, ",") Цикл
		Строки.Колонки.Добавить(Имя);
	КонецЦикла;
	Для Каждого Остаток Из Остатки Цикл
		Строка = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Остаток, "Номенклатура, Характеристика, Серия, Количество");
		Строка.ДокументИсточник = Документ;
		Строка.КлючСтрокиДокумента = Остаток.КлючСтрокиОрдера;
		Строка.КодСтрокиЗаказа = ?(ПоЗаказуПоставщику, Остаток.КлючСтрокиОрдера, 0);
	КонецЦикла;
	ЗагрузитьСтроки(Ордер, Строки);
	Если Остатки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'По документу нечего принимать или отгружать: всё оформлено ордерами.';
			|fr = 'Rien à recevoir ou expédier pour ce document : tout est régularisé par des bons.';
			|en = 'Nothing to receive or ship for this document: everything is documented by orders.';
			|es = 'Nada que recibir o enviar para este documento: todo está formalizado por órdenes.'"));
	КонецЕсли;
КонецПроцедуры

// Загружает строки в ТЧ товаров ордера: коды строк 1..N, количество упаковок - по количеству при единице хранения.
//
// Параметры:
//  Ордер  - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - заполняемый ордер.
//  Строки - ТаблицаЗначений - колонки строк товаров ордера (часть).
//
Процедура ЗагрузитьСтроки(Ордер, Строки) Экспорт
	Ордер.ТЧТовары.Очистить();
	КодСтроки = 0;
	Для Каждого Строка Из Строки Цикл
		НоваяСтрока = Ордер.ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КодСтроки = КодСтроки + 1;
		НоваяСтрока.КодСтроки = КодСтроки;
		Если НоваяСтрока.КоличествоУпаковок = 0 Тогда
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НоваяСтрока.Упаковка) И ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
			НоваяСтрока.Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Номенклатура, "Единица");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяМакетаОрдера()
	Возврат "ПриходныйОрдер";
КонецФункции

Функция ВидФормыОрдера()
	Возврат "BonDeReception";
КонецФункции

#КонецОбласти
