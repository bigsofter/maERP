					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>за период: [НачалоПериода] - [КонецПериода]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fr</v8:lang>
							<v8:content>pour la période: [НачалоПериода] - [КонецПериода]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>for the period: [НачалоПериода] - [КонецПериода]</v8:content>
						</v8:item>
