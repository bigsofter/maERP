	<rowsItem>
		<index>3</index>
		<row>
			<c>
				<c>
					<f>7</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>между [Организация] и [Контрагент]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fr</v8:lang>
							<v8:content>entre [Организация] et [Контрагент]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>entre [Организация] et [Контрагент]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>es</v8:lang>
