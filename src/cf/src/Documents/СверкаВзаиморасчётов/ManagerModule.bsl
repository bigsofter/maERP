	оШапка.Параметры.Контрагент = КарточкаКонтрагента.НаименованиеПолное;
	оШапка.Параметры.КонтрагентДолжность = КарточкаКонтрагента.Руководитель.Должность;
	оШапка.Параметры.КонтрагентРуководитель = КарточкаКонтрагента.Руководитель.ДляПечати;
	оШапка.Параметры.НачальныйОстатокДт = ?(Док.НачальныйОстаток > 0, Док.НачальныйОстаток, 0);
	оШапка.Параметры.НачальныйОстатокКт = ?(Док.НачальныйОстаток < 0, -Док.НачальныйОстаток, 0);	
	Таб.Вывести(оШапка);
	// Строки
	Для Каждого Стр Из Док.ТЧПоДаннымОрганизации Цикл
		оСтрока.Параметры.Заполнить(Стр);
		Таб.Вывести(оСтрока);
	КонецЦикла;
	// Обороты
	оОборотыИтог.Параметры.СуммаРасход = Док.ТЧПоДаннымОрганизации.Итог("Кредит");
	оОборотыИтог.Параметры.СуммаПриход = Док.ТЧПоДаннымОрганизации.Итог("Дебет");
	Таб.Вывести(оОборотыИтог);
	// Подвал
	КонечныйОстатокДт = ?(Док.КонечныйОстаток > 0, Док.КонечныйОстаток, 0);
	КонечныйОстатокКт = ?(Док.КонечныйОстаток < 0, -Док.КонечныйОстаток, 0);
	оПодвал.Параметры.КонецПериода = Формат(Док.КонецПериода,"ДЛФ=DD");
	оПодвал.Параметры.КонечныйОстатокДт = КонечныйОстатокДт;
	оПодвал.Параметры.КонечныйОстатокКт = КонечныйОстатокКт;
	оПодвал.Параметры.Организация = КарточкаОрганизации.Представление;
	оПодвал.Параметры.Должность = КарточкаОрганизации.Руководитель.Должность;
	оПодвал.Параметры.Руководитель = КарточкаОрганизации.Руководитель.ДляПечати;
	оПодвал.Параметры.Контрагент = КарточкаКонтрагента.Представление;
	оПодвал.Параметры.КонтрагентДолжность = КарточкаКонтрагента.Руководитель.Должность;
	оПодвал.Параметры.КонтрагентРуководитель = КарточкаКонтрагента.Руководитель.ДляПечати;
	Если КонечныйОстатокКт > 0 Тогда
		ТекстСверки = "2. Долг " + Док.Организация + " в валюте " + Валюта + " " + 
				КонечныйОстатокКт + " (" + Справочники.Валюты.СформироватьСуммуПрописью(КонечныйОстатокКт, Валюта, Перечисления.Локализации.fr_CA) + ")";
	ИначеЕсли КонечныйОстатокДт > 0 Тогда
		ТекстСверки = "2. Долг " + КарточкаКонтрагента.НаименованиеПолное + " в валюте " + Валюта + " " + 
				КонечныйОстатокДт + " (" + Справочники.Валюты.СформироватьСуммуПрописью(КонечныйОстатокДт, Валюта, Перечисления.Локализации.fr_CA) + ")";
	Иначе
		ТекстСверки = "2. Задолженность отсутствует."
	Конецесли;
	оПодвал.Параметры.ИтогСверки = ТекстСверки;
	Если ВыводитьПечать Тогда
		ДиаметрПечати = Док.Организация.ПечатьОрганизацииДиаметр;		
		оПечать = оПодвал.Рисунки.Печать;
		оПечать.Картинка = Новый Картинка(Док.Организация.ПечатьОрганизации.Получить());
		ВыводПечатныхФорм.РассчитатьРазмерИРасположениеКартинки(оПечать, ДиаметрПечати, ДиаметрПечати, 50, 0, Таб.МасштабПечати);		
		Если ЗначениеЗаполнено(КарточкаОрганизации.Руководитель.ОтветственноеЛицо) Тогда		
			ОЛ = КарточкаОрганизации.Руководитель.ОтветственноеЛицо;
			оПодписьРуководителя = оПодвал.Рисунки.Подпись;
			оПодписьРуководителя.Картинка = Новый Картинка(ОЛ.Подпись.Получить());			
			ВыводПечатныхФорм.РассчитатьРазмерИРасположениеКартинки(оПодписьРуководителя, ОЛ.ПодписьШирина, ОЛ.ПодписьВысота, 30, 20, Таб.МасштабПечати);
		КонецЕсли;
	КонецЕсли;
	Таб.Вывести(оПодвал); 	
КонецПроцедуры

#КонецОбласти

#Область EMail

Процедура ОтправитьАктыСверокКонтрагентам(МасДокументы) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	УчётнаяЗапись = Константы.УчётнаяЗаписьРассылкиСообщенийСистемы.Получить();
	Если Не ЗначениеЗаполнено(УчётнаяЗапись) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("fr = 'Aucun compte de messagerie sélectionné'; ru = 'Не выбрана учётная запись рассылки сообщений'; en = 'The message distribution account is not selected'; es = 'No se ha seleccionado la cuenta de envío de mensajes'"));
		Возврат;
	КонецЕсли;
	ТипКО = ПланыВидовХарактеристик.ВидыРеквизитовКонтрагентов.EMail;
	НазначениеРассылки = Перечисления.НазначенияРассылок.Бухгалтерия;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СверкаВзаиморасчётов.Ссылка КАК Ссылка,
	                      |	СверкаВзаиморасчётов.Дата КАК Дата,
	                      |	СверкаВзаиморасчётов.Номер КАК Номер,
	                      |	СверкаВзаиморасчётов.Контрагент КАК Контрагент,
	                      |	СверкаВзаиморасчётов.Организация КАК Организация
	                      |ИЗ
	                      |	Документ.СверкаВзаиморасчётов КАК СверкаВзаиморасчётов
	                      |ГДЕ
	                      |	СверкаВзаиморасчётов.Ссылка В(&Док)");
	Запрос.УстановитьПараметр("Док", МасДокументы);
	ТЗДокументы = Запрос.Выполнить().Выгрузить();
	ТЗКонтактнаяИнформация = РегистрыСведений.РеквизитыКонтрагентов.ПолучитьКонтактнуюИнформацию(ТЗДокументы.ВыгрузитьКолонку("Контрагент"), ТипКО, НазначениеРассылки);	
	Для Каждого Стр Из ТЗДокументы Цикл		 
		// Адресаты
		МасАдреса = РегистрыСведений.РеквизитыКонтрагентов.ПолучитьКонтактнуюИнформациюПоТипу(Стр.Контрагент, ТипКО, НазначениеРассылки, ТЗКонтактнаяИнформация);
		Если МасАдреса.Количество() = 0 Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru = 'Не заполнены адреса по документу - '; fr = 'Adresses non renseignées sur le document -'") + СокрЛП(Стр.Ссылка));
			Возврат;
		КонецЕсли;
		// Формируем
		МасВложения = Новый Массив;
		Каталог = КаталогВременныхФайлов();
		ТемаПисьма = СокрЛП(Стр.Организация) + Нстр("fr = '- Rapport de rapprochement N°.'; ru = ' - Акт сверки №'; en = ' - Reconciliation Report No.'; es = ' - Ley de conciliación no.'") + Стр.Номер + Нстр("ru = ' от '; fr = ' du '") + Формат(Стр.Дата, "ДФ=dd.MM.yyyy");
		Таб = Новый ТабличныйДокумент;
		Документы.СверкаВзаиморасчётов.ПечатьАктСверки(Стр.Ссылка, Таб); 
		ИмяФайла = ОбщегоНазначенияКлиентСервер.ОбработатьИмяФайла(СокрЛП(Стр.Ссылка) + ".pdf");
		АдресВложения = Каталог + ИмяФайла;
		Таб.Записать(АдресВложения, ТипФайлаТабличногоДокумента.PDF);
		МасВложения.Добавить(АдресВложения);
		// Отправляем 		
		Результат = РаботаСЭлектроннойПочтой.ОтправитьСообщение(УчётнаяЗапись, МасАдреса, ТемаПисьма, "", МасВложения);
		Сообщить(Результат.Описание);
		// Удаляем временные файлы
		Для Каждого Вложение Из МасВложения Цикл
			УдалитьФайлы(Вложение);
		КонецЦикла;
	КонецЦикла;	
КонецПроцедуры	

#КонецОбласти

#Область Данные

Функция ПолучитьОстаткиИОборотыПоКонтрагенту(Организация, Контрагент, Договор = Неопределено, НачалоПериода, КонецПериода, ПоДаннымОрганизации = Истина) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Контрагент КАК Контрагент,
	                      |	СУММА(ВЗ.НачальныйОстаток) КАК НачальныйОстаток,
	                      |	ВЗ.Приход КАК Приход,
	                      |	ВЗ.Расход КАК Расход,
	                      |	СУММА(ВЗ.КонечныйОстаток) КАК КонечныйОстаток
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		Покупатели.Контрагент КАК Контрагент,
	                      |		Покупатели.СуммаНачальныйОстаток КАК НачальныйОстаток,
	                      |		Покупатели.СуммаКонечныйОстаток КАК КонечныйОстаток,
	                      |		Покупатели.СуммаПриход КАК Приход,
	                      |		Покупатели.СуммаРасход КАК Расход
	                      |	ИЗ
	                      |		РегистрНакопления.ВзаиморасчётыСПокупателями.ОстаткиИОбороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				,
	                      |				,
	                      |				Организация = &Организация
	                      |					И Контрагент В ИЕРАРХИИ (&Контрагент)
	                      |					И ВЫБОР
	                      |						КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыСКонтрагентами.ПустаяСсылка)
	                      |							ТОГДА ИСТИНА
	                      |						ИНАЧЕ Договор = &Договор
	                      |					КОНЕЦ) КАК Покупатели
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		Поставщики.Контрагент,
	                      |		Поставщики.СуммаНачальныйОстаток,
	                      |		Поставщики.СуммаКонечныйОстаток,
	                      |		Поставщики.СуммаПриход,
	                      |		Поставщики.СуммаРасход
	                      |	ИЗ
	                      |		РегистрНакопления.ВзаиморасчётыСПоставщиками.ОстаткиИОбороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				,
	                      |				,
	                      |				Организация = &Организация
	                      |					И Контрагент В ИЕРАРХИИ (&Контрагент)
	                      |					И ВЫБОР
	                      |						КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыСКонтрагентами.ПустаяСсылка)
	                      |							ТОГДА ИСТИНА
	                      |						ИНАЧЕ Договор = &Договор
	                      |					КОНЕЦ) КАК Поставщики) КАК ВЗ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВЗ.Контрагент,
	                      |	ВЗ.Приход,
	                      |	ВЗ.Расход
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ВЗ.Контрагент.Наименование
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВЗ.Контрагент КАК Контрагент,
	                      |	ВЗ.Дата КАК Дата,
	                      |	ВЗ.ДокументРегистратор КАК ДокументРегистратор,
	                      |	ВЗ.Дебет КАК Дебет,
	                      |	ВЗ.Кредит КАК Кредит
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		Покупатели.Контрагент КАК Контрагент,
	                      |		Покупатели.Регистратор.Дата КАК Дата,
	                      |		Покупатели.Регистратор КАК ДокументРегистратор,
	                      |		СУММА(Покупатели.СуммаПриход) КАК Дебет,
	                      |		СУММА(Покупатели.СуммаРасход) КАК Кредит
	                      |	ИЗ
	                      |		РегистрНакопления.ВзаиморасчётыСПокупателями.Обороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				Регистратор,
	                      |				Организация = &Организация
	                      |					И Контрагент В ИЕРАРХИИ (&Контрагент)
	                      |					И ВЫБОР
	                      |						КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыСКонтрагентами.ПустаяСсылка)
	                      |							ТОГДА ИСТИНА
	                      |						ИНАЧЕ Договор = &Договор
	                      |					КОНЕЦ) КАК Покупатели
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		Покупатели.Регистратор,
	                      |		Покупатели.Контрагент,
	                      |		Покупатели.Регистратор.Дата
	                      |		
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		Поставщики.Контрагент,
	                      |		Поставщики.ОбъектРасчётов.Дата,
	                      |		Поставщики.ОбъектРасчётов,
	                      |		СУММА(Поставщики.СуммаПриход),
	                      |		СУММА(Поставщики.СуммаРасход)
	                      |	ИЗ
	                      |		РегистрНакопления.ВзаиморасчётыСПоставщиками.Обороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				Регистратор,
	                      |				Организация = &Организация
	                      |					И Контрагент В ИЕРАРХИИ (&Контрагент)
	                      |					И ВЫБОР
	                      |						КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыСКонтрагентами.ПустаяСсылка)
	                      |							ТОГДА ИСТИНА
	                      |						ИНАЧЕ Договор = &Договор
	                      |					КОНЕЦ) КАК Поставщики
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		Поставщики.Контрагент,
	                      |		Поставщики.ОбъектРасчётов,
	                      |		Поставщики.ОбъектРасчётов.Дата) КАК ВЗ
	                      |ГДЕ
	                      |	(ВЗ.Дебет <> 0
	                      |			ИЛИ ВЗ.Кредит <> 0)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Дата");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", ?(ЗначениеЗаполнено(Договор), Договор, Справочники.ДоговорыСКонтрагентами.ПустаяСсылка()));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));	
	Возврат Запрос.ВыполнитьПакет();
КонецФункции

#КонецОбласти

