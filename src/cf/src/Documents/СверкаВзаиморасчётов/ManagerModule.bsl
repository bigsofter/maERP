#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы объекта.
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "АктСверки";
	Команда.Представление = НСтр("ru = 'Акт сверки'; fr = 'Acte de rapprochement';
		|en = 'Reconciliation act'; es = 'Acta de conciliación'");

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "АктСверкиСПечатью";
	Команда.Представление = НСтр("ru = 'Акт сверки с печатью'; fr = 'Acte de rapprochement avec cachet';
		|en = 'Reconciliation act with stamp'; es = 'Acta de conciliación con sello'");

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "АктСверкиБезНДС";
	Команда.Представление = НСтр("ru = 'Акт сверки без НДС'; fr = 'Acte de rapprochement hors TVA';
		|en = 'Reconciliation act without VAT'; es = 'Acta de conciliación sin IVA'");

КонецПроцедуры

// Формирует запрошенные печатные формы.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые объекты
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСверки") Тогда
		Таб = Новый ТабличныйДокумент;
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			ПечатьАктСверки(Док, Таб, Ложь);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "АктСверки",
			НСтр("ru = 'Акт сверки'; fr = 'Acte de rapprochement';
			|en = 'Reconciliation act'; es = 'Acta de conciliación'"),
			Таб, "Документ.СверкаВзаиморасчётов.АктСверки");
	КонецЕсли;

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСверкиСПечатью") Тогда
		Таб = Новый ТабличныйДокумент;
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			ПечатьАктСверки(Док, Таб, Истина);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "АктСверкиСПечатью",
			НСтр("ru = 'Акт сверки с печатью'; fr = 'Acte de rapprochement avec cachet';
			|en = 'Reconciliation act with stamp'; es = 'Acta de conciliación con sello'"),
			Таб, "Документ.СверкаВзаиморасчётов.АктСверки");
	КонецЕсли;

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСверкиБезНДС") Тогда
		Таб = Новый ТабличныйДокумент;
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			ПечатьАктСверкиБезНДС(Док, Таб);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "АктСверкиБезНДС",
			НСтр("ru = 'Акт сверки без НДС'; fr = 'Acte de rapprochement hors TVA';
			|en = 'Reconciliation act without VAT'; es = 'Acta de conciliación sin IVA'"),
			Таб, "Документ.СверкаВзаиморасчётов.АктСверкиБезНДС");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Печать

Процедура ПечатьАктСверки(Док, Таб, ВыводитьПечать = Ложь) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ТолькоПросмотр = Истина;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Таб.МасштабПечати = 85;
	Таб.КлючПараметровПечати = "Параметры_печати_Документ_АктСверки_АктСверки";
	// Получаем данные
	Валюта = Справочники.Валюты.MoroccanDirham;
	КарточкаОрганизации = Справочники.Контрагенты.ПолучитьКарточку(Док.Организация, Док.Дата, Истина);
	КарточкаКонтрагента = Справочники.Контрагенты.ПолучитьКарточку(Док.Контрагент, Док.Дата);
	Макет = ПечатныеФормы.МакетПечатнойФормы("Документ.СверкаВзаиморасчётов.АктСверки");	
	оШапка = Макет.ПолучитьОбласть("Шапка|Главная");
	оСтрока = Макет.ПолучитьОбласть("Строка|Главная");
	оОборотыИтог = Макет.ПолучитьОбласть("ОборотыИтог|Главная");
	оПодвал = Макет.ПолучитьОбласть("Подвал|Главная");
	оШапкаНДС = Макет.ПолучитьОбласть("Шапка|НДС");
	оСтрокаНДС = Макет.ПолучитьОбласть("Строка|НДС");
	оОборотыИтогНДС = Макет.ПолучитьОбласть("ОборотыИтог|НДС");
	оПодвалНДС = Макет.ПолучитьОбласть("Подвал|НДС");
	// Шапка
	оШапка.Параметры.Номер = Док.Номер;
	оШапка.Параметры.Дата = Формат(Док.Дата, "ДФ=dd.MM.yyyy");
	оШапка.Параметры.НачалоПериода = Формат(Док.НачалоПериода,"ДЛФ=DD");
	оШапка.Параметры.КонецПериода = Формат(Док.КонецПериода,"ДЛФ=DD");
	оШапка.Параметры.Организация = Док.Организация;
	оШапка.Параметры.Должность = КарточкаОрганизации.Руководитель.Должность;
	оШапка.Параметры.Руководитель = КарточкаОрганизации.Руководитель.ДляПечати;
	оШапка.Параметры.Контрагент = КарточкаКонтрагента.НаименованиеПолное;
	оШапка.Параметры.КонтрагентДолжность = КарточкаКонтрагента.Руководитель.Должность;
	оШапка.Параметры.КонтрагентРуководитель = КарточкаКонтрагента.Руководитель.ДляПечати;
	оШапка.Параметры.НачальныйОстатокДт = ?(Док.НачальныйОстаток > 0, Док.НачальныйОстаток, 0);
	оШапка.Параметры.НачальныйОстатокКт = ?(Док.НачальныйОстаток < 0, -Док.НачальныйОстаток, 0);	
	Таб.Вывести(оШапка);
	ТЗНдс = Новый ТаблицаЗначений;
	ТЗНдс.Колонки.Добавить("НомерСтроки");
	ТЗНдс.Колонки.Добавить("СтавкаНДС");
	ТЗНдс.Колонки.Добавить("СуммаНДС");
	Для Каждого Стр Из Док.ТЧПоДаннымОрганизации Цикл
		Если Стр.НесколькоСтавокНДС Тогда 
			ТЗ = ОбщегоНазначенияКлиентСервер.КонвертироватьИзJSON(Стр.РасшифровкаНДС, Ложь);
			Для Каждого СтрТЗ из ТЗ Цикл 
				НС = ТЗНдс.Добавить();
				НС.НомерСтроки = Стр.НомерСтроки;
				НС.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("Ставка",СтрТЗ.СтавкаНДС);
				НС.СуммаНДС = СтрТЗ.СуммаНДС;
			КонецЦикла;
		Иначе
			НС = ТЗНдс.Добавить();
			НС.НомерСтроки = Стр.НомерСтроки;
			НС.СтавкаНДС = Стр.СтавкаНДС;
			НС.СуммаНДС = Стр.СуммаНДС;
		КонецЕсли;
	КонецЦикла;
	ТЗСтавкиНДС = ТЗНдс.Скопировать();
	ТЗСтавкиНДС.Свернуть("СтавкаНДС","СуммаНДС");
	ТЗСтавкиНДС.Сортировать("СтавкаНДС");
	Для Каждого СтрТЗСтавкиНДС из ТЗСтавкиНДС Цикл
		оШапкаНДС.Параметры.СтавкаНДС = "НДС "+СокрЛП(СтрТЗСтавкиНДС.СтавкаНДС);
		Таб.Присоединить(оШапкаНДС);
	КонецЦикла;
	// Строки
	Для Каждого Стр Из Док.ТЧПоДаннымОрганизации Цикл
		оСтрока.Параметры.Заполнить(Стр);
		Таб.Вывести(оСтрока);
		Для Каждого СтрТЗСтавкиНДС из ТЗСтавкиНДС Цикл
			МасСтрокНДС = ТЗНдс.НайтиСтроки(Новый Структура("НомерСтроки,СтавкаНДС",Стр.НомерСтроки,СтрТЗСтавкиНДС.СтавкаНДС));
			оСтрокаНДС.Параметры.СуммаНДС = ?(МасСтрокНДС.Количество() = 0, 0, МасСтрокНДС.Получить(0).СуммаНДС);
			Таб.Присоединить(оСтрокаНДС);
		КонецЦикла;
	КонецЦикла;
	// Обороты
	оОборотыИтог.Параметры.СуммаРасход = Док.ТЧПоДаннымОрганизации.Итог("Кредит");
	оОборотыИтог.Параметры.СуммаПриход = Док.ТЧПоДаннымОрганизации.Итог("Дебет");
	Таб.Вывести(оОборотыИтог);
	Для Каждого СтрТЗСтавкиНДС из ТЗСтавкиНДС Цикл
		оОборотыИтогНДС.Параметры.СуммаНДС = СтрТЗСтавкиНДС.СуммаНДС;
		Таб.Присоединить(оОборотыИтогНДС);
	КонецЦикла;
	// Подвал
	КонечныйОстатокДт = ?(Док.КонечныйОстаток > 0, Док.КонечныйОстаток, 0);
	КонечныйОстатокКт = ?(Док.КонечныйОстаток < 0, -Док.КонечныйОстаток, 0);
	оПодвал.Параметры.КонецПериода = Формат(Док.КонецПериода,"ДЛФ=DD");
	оПодвал.Параметры.КонечныйОстатокДт = КонечныйОстатокДт;
	оПодвал.Параметры.КонечныйОстатокКт = КонечныйОстатокКт;
	оПодвал.Параметры.Организация = КарточкаОрганизации.Представление;
	оПодвал.Параметры.Должность = КарточкаОрганизации.Руководитель.Должность;
	оПодвал.Параметры.Руководитель = КарточкаОрганизации.Руководитель.ДляПечати;
	оПодвал.Параметры.Контрагент = КарточкаКонтрагента.Представление;
	оПодвал.Параметры.КонтрагентДолжность = КарточкаКонтрагента.Руководитель.Должность;
	оПодвал.Параметры.КонтрагентРуководитель = КарточкаКонтрагента.Руководитель.ДляПечати;
	Если КонечныйОстатокКт > 0 Тогда
		ТекстСверки = "2. Долг " + Док.Организация + " в валюте " + Валюта + " " + 
				КонечныйОстатокКт + " (" + Справочники.Валюты.СформироватьСуммуПрописью(КонечныйОстатокКт, Валюта, Перечисления.Локализации.fr_CA) + ")";
	ИначеЕсли КонечныйОстатокДт > 0 Тогда
		ТекстСверки = "2. Долг " + КарточкаКонтрагента.НаименованиеПолное + " в валюте " + Валюта + " " + 
				КонечныйОстатокДт + " (" + Справочники.Валюты.СформироватьСуммуПрописью(КонечныйОстатокДт, Валюта, Перечисления.Локализации.fr_CA) + ")";
	Иначе
		ТекстСверки = "2. Задолженность отсутствует."
	Конецесли;
	оПодвал.Параметры.ИтогСверки = ТекстСверки;
	Если ВыводитьПечать Тогда
		ДиаметрПечати = Док.Организация.ПечатьОрганизацииДиаметр;		
		оПечать = оПодвал.Рисунки.Печать;
		оПечать.Картинка = Новый Картинка(Док.Организация.ПечатьОрганизации.Получить());
		ВыводПечатныхФорм.РассчитатьРазмерИРасположениеКартинки(оПечать, ДиаметрПечати, ДиаметрПечати, 50, 0, Таб.МасштабПечати);		
		Если ЗначениеЗаполнено(КарточкаОрганизации.Руководитель.ОтветственноеЛицо) Тогда		
			ОЛ = КарточкаОрганизации.Руководитель.ОтветственноеЛицо;
			оПодписьРуководителя = оПодвал.Рисунки.Подпись;
			оПодписьРуководителя.Картинка = Новый Картинка(ОЛ.Подпись.Получить());			
			ВыводПечатныхФорм.РассчитатьРазмерИРасположениеКартинки(оПодписьРуководителя, ОЛ.ПодписьШирина, ОЛ.ПодписьВысота, 30, 20, Таб.МасштабПечати);
		КонецЕсли;
	КонецЕсли;
	Таб.Вывести(оПодвал); 	
	Для Каждого СтрТЗСтавкиНДС из ТЗСтавкиНДС Цикл
		Таб.Присоединить(оПодвалНДС);
	КонецЦикла;
КонецПроцедуры

