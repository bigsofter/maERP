#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы объекта: три варианта фирменного акта сверки под прежними именами и названиями
// (docs/plans/branded-print.md, раздел 12.7).
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	Для Каждого Вариант Из ВариантыАкта() Цикл
		ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, Вариант.ИмяМакета, ВидФормыАкта(), Вариант.Представление);
	КонецЦикла;

КонецПроцедуры

// Формирует запрошенные печатные формы.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые объекты
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Вариант акта - параметром команды (раздел 3.1 плана): переданная структура не меняется, дополняется копия.
	Для Каждого Вариант Из ВариантыАкта() Цикл
		Параметры = Новый Структура;
		Если ТипЗнч(ПараметрыПечати) = Тип("Структура") Тогда
			Для Каждого Параметр Из ПараметрыПечати Цикл
				Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
			КонецЦикла;
		КонецЕсли;
		Для Каждого Параметр Из Вариант.Параметры Цикл
			Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
		ФирменнаяПечать.Напечатать(Вариант.ИмяМакета, ВидФормыАкта(), МассивОбъектов, Параметры, КоллекцияПечатныхФорм,
			ОбъектыПечати, Вариант.Представление);
	КонецЦикла;

КонецПроцедуры

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать): акт сверки (docs/plans/branded-print.md, раздел 12.5).
// Сальдо и обороты хранит документ - регистры расчётов адаптер не читает; строки по данным организации и по данным
// контрагента - одним пакетным запросом, документ-регистратор только сравнивается (построчная сверка сторон).
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.СверкаВзаиморасчётов - печатаемые акты.
//  ВидФормы        - Строка - Releve.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати; СПечатью - печать организации и факсимиле руководителя.
//
// Возвращаемое значение:
//  Соответствие - акт -> источник печати (Данные, Плашка, ИмяФайла).
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	СПечатью = ПараметрыПечати.Свойство("СПечатью") И ПараметрыПечати.СПечатью = Истина;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Сверка.Ссылка КАК Ссылка,
	|	Сверка.Номер КАК НомерДокумента,
	|	Сверка.Дата КАК Дата,
	|	Сверка.Организация КАК Организация,
	|	Сверка.Контрагент КАК Контрагент,
	|	Сверка.Договор КАК Договор,
	|	Сверка.НачалоПериода КАК НачалоПериода,
	|	Сверка.КонецПериода КАК КонецПериода,
	|	Сверка.НачальныйОстаток КАК СальдоНачальное,
	|	Сверка.КонечныйОстаток КАК СальдоКонечное,
	|	Сверка.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.СверкаВзаиморасчётов КАК Сверка
	|ГДЕ
	|	Сверка.Ссылка В(&Ссылки)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Ссылка КАК Ссылка,
	|	Строки.НомерСтроки КАК НомерСтроки,
	|	Строки.Дата КАК Дата,
	|	Строки.ДокументРегистратор КАК Регистратор,
	|	Строки.ДокументПредставление КАК Документ,
	|	Строки.Дебет КАК Дебет,
	|	Строки.Кредит КАК Кредит,
	|	Строки.СтавкаНДС КАК СтавкаНДС,
	|	Строки.СуммаНДС КАК СуммаНДС,
	|	Строки.НесколькоСтавокНДС КАК НесколькоСтавокНДС,
	|	Строки.РасшифровкаНДС КАК РасшифровкаНДС
	|ИЗ
	|	Документ.СверкаВзаиморасчётов.ТЧПоДаннымОрганизации КАК Строки
	|ГДЕ
	|	Строки.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строки.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Ссылка КАК Ссылка,
	|	Строки.НомерСтроки КАК НомерСтроки,
	|	Строки.Дата КАК Дата,
	|	Строки.ДокументРегистратор КАК Регистратор,
	|	Строки.ДокументПредставление КАК Документ,
	|	Строки.Дебет КАК Дебет,
	|	Строки.Кредит КАК Кредит
	|ИЗ
	|	Документ.СверкаВзаиморасчётов.ТЧПоДаннымКонтрагента КАК Строки
	|ГДЕ
	|	Строки.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строки.НомерСтроки");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Пакет = Запрос.ВыполнитьПакет();
	// Строки отбираются по акту - индекс по ссылке, чтобы печать списком не просматривала таблицу на каждый акт.
	СтрокиОрганизации = Пакет[1].Выгрузить();
	СтрокиОрганизации.Индексы.Добавить("Ссылка");
	СтрокиКонтрагента = Пакет[2].Выгрузить();
	СтрокиКонтрагента.Индексы.Добавить("Ссылка");
	Ставки = СтавкиНДССтрок(СтрокиОрганизации);

	Результат = Новый Соответствие;
	Кэш = ФирменнаяПечать.НовыйКэш();
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Отбор = Новый Структура("Ссылка", Выборка.Ссылка);
		Сверка = ФирменнаяПечать.НоваяСверка();
		ЗаполнитьЗначенияСвойств(Сверка, Выборка, "НачалоПериода, КонецПериода, СальдоНачальное, СальдоКонечное");
		Сверка.СПечатью = СПечатью;
		Для Каждого Строка Из СтрокиОрганизации.НайтиСтроки(Отбор) Цикл
			СтрокаСверки = ФирменнаяПечать.НоваяСтрокаСверки(Строка.Регистратор, Строка.НомерСтроки, Строка.Дата,
				Строка.Документ, Строка.Дебет, Строка.Кредит);
			СтрокаСверки.НДС = НДССтроки(Строка, Ставки);
			Сверка.Строки.Добавить(СтрокаСверки);
		КонецЦикла;
		Для Каждого Строка Из СтрокиКонтрагента.НайтиСтроки(Отбор) Цикл
			СтрокаСверки = ФирменнаяПечать.НоваяСтрокаСверки(Строка.Регистратор, Строка.НомерСтроки, Строка.Дата,
				Строка.Документ, Строка.Дебет, Строка.Кредит);
			Сверка.СтрокиКонтрагента.Добавить(СтрокаСверки);
		КонецЦикла;

		Шапка = ФирменнаяПечать.НоваяШапкаДокумента();
		ЗаполнитьЗначенияСвойств(Шапка, Выборка, "Дата, Организация, Контрагент, Договор, Комментарий");
		Шапка.Номер = СокрЛП(Выборка.НомерДокумента);
		ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента("Acte de rapprochement", Выборка.НомерДокумента, Выборка.Дата);
		Данные = ФирменнаяПечать.ДанныеСверки(Шапка, Сверка, Кэш);
		Результат.Вставить(Выборка.Ссылка, Новый Структура("Данные, Плашка, ИмяФайла", Данные, "", ИмяФайла));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Печать

Функция ВидФормыАкта()
	Возврат "Releve";
КонецФункции

Функция ВариантыАкта()
	// Прежние команды печати: имя, название и параметры, выбирающие вариант фирменного акта (раздел 12.3 плана).
	Варианты = Новый Массив;
	ДобавитьВариантАкта(Варианты, "АктСверки", НСтр("ru = 'Акт сверки'; fr = 'Acte de rapprochement';
		|en = 'Reconciliation act'; es = 'Acta de conciliación'"), Новый Структура);
	СПечатью = Новый Структура("СПечатью", Истина);
	ДобавитьВариантАкта(Варианты, "АктСверкиСПечатью", НСтр("ru = 'Акт сверки с печатью';
		|fr = 'Acte de rapprochement avec cachet'; en = 'Reconciliation act with stamp';
		|es = 'Acta de conciliación con sello'"), СПечатью);
	БезНДС = Новый Структура("БезНДС", Истина);
	ДобавитьВариантАкта(Варианты, "АктСверкиБезНДС", НСтр("ru = 'Акт сверки без НДС'; fr = 'Acte de rapprochement hors TVA';
		|en = 'Reconciliation act without VAT'; es = 'Acta de conciliación sin IVA'"), БезНДС);
	Возврат Варианты;
КонецФункции

Процедура ДобавитьВариантАкта(Варианты, ИмяМакета, Представление, Параметры)
	Варианты.Добавить(Новый Структура("ИмяМакета, Представление, Параметры", ИмяМакета, Представление, Параметры));
КонецПроцедуры

Функция СтавкиНДССтрок(Строки)
	// Значения ставок НДС строк - одним запросом: у строки с несколькими ставками ставка лежит в РасшифровкаНДС ссылкой
	// (XMLСтрока), прежний акт искал её по значению ставки и колонки ставок пустели.
	СсылкиСтавок = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Для Каждого Ставка Из СтавкиСтроки(Строка) Цикл
			Если ЗначениеЗаполнено(Ставка.СтавкаНДС) И СсылкиСтавок.Найти(Ставка.СтавкаНДС) = Неопределено Тогда
				СсылкиСтавок.Добавить(Ставка.СтавкаНДС);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Значения = Новый Соответствие;
	Если СсылкиСтавок.Количество() = 0 Тогда
		Возврат Значения;
	КонецЕсли;
	Для Каждого Ставка Из ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СсылкиСтавок, "Ставка") Цикл
		Значения.Вставить(Ставка.Ключ, Ставка.Значение.Ставка);
	КонецЦикла;
	Возврат Значения;
КонецФункции

Функция СтавкиСтроки(Строка)
	// Ставки и суммы НДС строки: одна ставка - из колонок строки, несколько - из РасшифровкаНДС.
	Ставки = Новый Массив;
	Если Строка.НесколькоСтавокНДС Тогда
		Расшифровка = ОбщегоНазначенияКлиентСервер.КонвертироватьИзJSON(Строка.РасшифровкаНДС, Ложь);
		Для Каждого Элемент Из Расшифровка Цикл
			СсылкаСтавки = ?(ПустаяСтрока(Элемент.СтавкаНДС), Справочники.СтавкиНДС.ПустаяСсылка(),
				XMLЗначение(Тип("СправочникСсылка.СтавкиНДС"), Элемент.СтавкаНДС));
			Ставки.Добавить(Новый Структура("СтавкаНДС, СуммаНДС", СсылкаСтавки, Элемент.СуммаНДС));
		КонецЦикла;
	Иначе
		Ставки.Добавить(Новый Структура("СтавкаНДС, СуммаНДС", Строка.СтавкаНДС, Строка.СуммаНДС));
	КонецЕсли;
	Возврат Ставки;
КонецФункции

Функция НДССтроки(Строка, ЗначенияСтавок)
	НДС = Новый Массив;
	Для Каждого Ставка Из СтавкиСтроки(Строка) Цикл
		Если Не ЗначениеЗаполнено(Ставка.СтавкаНДС) И Ставка.СуммаНДС = 0 Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначенияСтавок[Ставка.СтавкаНДС];
		Представление = ?(Значение = Неопределено, "", Формат(Значение, "ЧГ=0; ЧН=0") + " %");
		НДС.Добавить(Новый Структура("Ставка, Сумма", Представление, Ставка.СуммаНДС));
	КонецЦикла;
	Возврат НДС;
КонецФункции

#КонецОбласти

#Область EMail

Процедура ОтправитьАктыСверокКонтрагентам(МасДокументы) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	УчётнаяЗапись = Константы.УчётнаяЗаписьРассылкиСообщенийСистемы.Получить();
	Если Не ЗначениеЗаполнено(УчётнаяЗапись) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("fr = 'Aucun compte de messagerie sélectionné'; ru = 'Не выбрана учётная запись рассылки сообщений'; en = 'The message distribution account is not selected'; es = 'No se ha seleccionado la cuenta de envío de mensajes'"));
		Возврат;
	КонецЕсли;
	ТипКО = ПланыВидовХарактеристик.ВидыРеквизитовКонтрагентов.EMail;
	НазначениеРассылки = Перечисления.НазначенияРассылок.Бухгалтерия;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СверкаВзаиморасчётов.Ссылка КАК Ссылка,
	                      |	СверкаВзаиморасчётов.Дата КАК Дата,
	                      |	СверкаВзаиморасчётов.Номер КАК Номер,
	                      |	СверкаВзаиморасчётов.Контрагент КАК Контрагент,
	                      |	СверкаВзаиморасчётов.Организация КАК Организация
	                      |ИЗ
	                      |	Документ.СверкаВзаиморасчётов КАК СверкаВзаиморасчётов
	                      |ГДЕ
	                      |	СверкаВзаиморасчётов.Ссылка В(&Док)");
	Запрос.УстановитьПараметр("Док", МасДокументы);
	ТЗДокументы = Запрос.Выполнить().Выгрузить();
	ТЗКонтактнаяИнформация = РегистрыСведений.РеквизитыКонтрагентов.ПолучитьКонтактнуюИнформацию(ТЗДокументы.ВыгрузитьКолонку("Контрагент"), ТипКО, НазначениеРассылки);	
	Для Каждого Стр Из ТЗДокументы Цикл		 
		// Адресаты
		МасАдреса = РегистрыСведений.РеквизитыКонтрагентов.ПолучитьКонтактнуюИнформациюПоТипу(Стр.Контрагент, ТипКО, НазначениеРассылки, ТЗКонтактнаяИнформация);
		Если МасАдреса.Количество() = 0 Тогда 
			ТекстОшибки = Нстр("ru = 'Не заполнены адреса по документу - '; fr = 'Adresses non renseignées sur le document -';
				|en = 'Addresses are not filled in for the document -'; es = 'Direcciones sin rellenar en el documento -'") + СокрЛП(Стр.Ссылка);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли;
		// Формируем
		МасВложения = Новый Массив;
		Каталог = КаталогВременныхФайлов();
		ТемаПисьма = СокрЛП(Стр.Организация) + Нстр("fr = '- Rapport de rapprochement N°.'; ru = ' - Акт сверки №'; en = ' - Reconciliation Report No.'; es = ' - Ley de conciliación no.'") + Стр.Номер + Нстр("ru = ' от '; fr = ' du ';
			|en = 'from'; es = 'de'") + Формат(Стр.Дата, "ДФ=dd.MM.yyyy");
		// Вложение - фирменный акт (раздел 12.5 плана): метод печати принимает массив и возвращает коллекцию форм.
		Печать = ПечатныеФормы.СформироватьПечатныеФормы("Документ.СверкаВзаиморасчётов", "АктСверки",
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Стр.Ссылка));
		Таб = Печать.КоллекцияПечатныхФорм.Найти("АктСверки", "ИмяМакета").ТабличныйДокумент;
		ИмяФайла = ОбщегоНазначенияКлиентСервер.ОбработатьИмяФайла(СокрЛП(Стр.Ссылка) + ".pdf");
		АдресВложения = Каталог + ИмяФайла;
		Таб.Записать(АдресВложения, ТипФайлаТабличногоДокумента.PDF);
		МасВложения.Добавить(АдресВложения);
		// Отправляем 		
		Результат = РаботаСЭлектроннойПочтой.ОтправитьСообщение(УчётнаяЗапись, МасАдреса, ТемаПисьма, "", МасВложения);
		Сообщить(Результат.Описание);
		// Удаляем временные файлы
		Для Каждого Вложение Из МасВложения Цикл
			УдалитьФайлы(Вложение);
		КонецЦикла;
	КонецЦикла;	
КонецПроцедуры	

#КонецОбласти

#Область Данные

Функция ПолучитьОстаткиИОборотыПоКонтрагенту(Организация, Контрагент, Договор = Неопределено, НачалоПериода, КонецПериода, ПоДаннымОрганизации = Истина) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Контрагент КАК Контрагент,
	                      |	СУММА(ВЗ.НачальныйОстаток) КАК НачальныйОстаток,
	                      |	ВЗ.Приход КАК Приход,
	                      |	ВЗ.Расход КАК Расход,
	                      |	СУММА(ВЗ.КонечныйОстаток) КАК КонечныйОстаток
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		Покупатели.Контрагент КАК Контрагент,
	                      |		Покупатели.СуммаНачальныйОстаток КАК НачальныйОстаток,
	                      |		Покупатели.СуммаКонечныйОстаток КАК КонечныйОстаток,
	                      |		Покупатели.СуммаПриход КАК Приход,
	                      |		Покупатели.СуммаРасход КАК Расход
	                      |	ИЗ
	                      |		РегистрНакопления.ВзаиморасчётыСПокупателями.ОстаткиИОбороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				,
	                      |				,
	                      |				Организация = &Организация
	                      |					И Контрагент В ИЕРАРХИИ (&Контрагент)
	                      |					И ВЫБОР
	                      |						КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыСКонтрагентами.ПустаяСсылка)
	                      |							ТОГДА ИСТИНА
	                      |						ИНАЧЕ Договор = &Договор
	                      |					КОНЕЦ) КАК Покупатели
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		Поставщики.Контрагент,
	                      |		Поставщики.СуммаНачальныйОстаток,
	                      |		Поставщики.СуммаКонечныйОстаток,
	                      |		Поставщики.СуммаПриход,
	                      |		Поставщики.СуммаРасход
	                      |	ИЗ
	                      |		РегистрНакопления.ВзаиморасчётыСПоставщиками.ОстаткиИОбороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				,
	                      |				,
	                      |				Организация = &Организация
	                      |					И Контрагент В ИЕРАРХИИ (&Контрагент)
	                      |					И ВЫБОР
	                      |						КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыСКонтрагентами.ПустаяСсылка)
	                      |							ТОГДА ИСТИНА
	                      |						ИНАЧЕ Договор = &Договор
	                      |					КОНЕЦ) КАК Поставщики) КАК ВЗ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВЗ.Контрагент,
	                      |	ВЗ.Приход,
	                      |	ВЗ.Расход
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ВЗ.Контрагент.Наименование
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВЗ.Контрагент КАК Контрагент,
	                      |	ВЗ.Дата КАК Дата,
	                      |	ВЗ.ДокументРегистратор КАК ДокументРегистратор,
	                      |	ВЗ.Дебет КАК Дебет,
	                      |	ВЗ.Кредит КАК Кредит
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		Покупатели.Контрагент КАК Контрагент,
	                      |		Покупатели.Регистратор.Дата КАК Дата,
	                      |		Покупатели.Регистратор КАК ДокументРегистратор,
	                      |		СУММА(Покупатели.СуммаПриход) КАК Дебет,
	                      |		СУММА(Покупатели.СуммаРасход) КАК Кредит
	                      |	ИЗ
	                      |		РегистрНакопления.ВзаиморасчётыСПокупателями.Обороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				Регистратор,
	                      |				Организация = &Организация
	                      |					И Контрагент В ИЕРАРХИИ (&Контрагент)
	                      |					И ВЫБОР
	                      |						КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыСКонтрагентами.ПустаяСсылка)
	                      |							ТОГДА ИСТИНА
	                      |						ИНАЧЕ Договор = &Договор
	                      |					КОНЕЦ) КАК Покупатели
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		Покупатели.Регистратор,
	                      |		Покупатели.Контрагент,
	                      |		Покупатели.Регистратор.Дата
	                      |		
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		Поставщики.Контрагент,
	                      |		Поставщики.ОбъектРасчётов.Дата,
	                      |		Поставщики.ОбъектРасчётов,
	                      |		СУММА(Поставщики.СуммаПриход),
	                      |		СУММА(Поставщики.СуммаРасход)
	                      |	ИЗ
	                      |		РегистрНакопления.ВзаиморасчётыСПоставщиками.Обороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				Регистратор,
	                      |				Организация = &Организация
	                      |					И Контрагент В ИЕРАРХИИ (&Контрагент)
	                      |					И ВЫБОР
	                      |						КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыСКонтрагентами.ПустаяСсылка)
	                      |							ТОГДА ИСТИНА
	                      |						ИНАЧЕ Договор = &Договор
	                      |					КОНЕЦ) КАК Поставщики
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		Поставщики.Контрагент,
	                      |		Поставщики.ОбъектРасчётов,
	                      |		Поставщики.ОбъектРасчётов.Дата) КАК ВЗ
	                      |ГДЕ
	                      |	(ВЗ.Дебет <> 0
	                      |			ИЛИ ВЗ.Кредит <> 0)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Дата");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", ?(ЗначениеЗаполнено(Договор), Договор, Справочники.ДоговорыСКонтрагентами.ПустаяСсылка()));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));	
	Возврат Запрос.ВыполнитьПакет();
КонецФункции

#КонецОбласти

