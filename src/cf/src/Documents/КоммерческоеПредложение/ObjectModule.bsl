#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	Статус = Перечисления.СтатусыКоммерческихПредложений.Черновик;
	ЦенаВключаетНДС = Истина;
	ДатаОтгрузки = НачалоДня(ТекущаяДатаСеанса());
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ЗаполнитьПоРеализации(ДанныеЗаполнения);
	КонецЕсли;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Статус = Перечисления.СтатусыКоммерческихПредложений.Черновик;
	Комментарий = "";
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыКоммерческихПредложений.Черновик;
	КонецЕсли;
	ПроверитьОписанияСтрок(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	РаботаСДокументами.ЗаполнитьИтогиДокумента(ЭтотОбъект);
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	СинхронизироватьОписанияНоменклатуры();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоРеализации(Реализация)
	Основание = Реализация;
	Организация = Реализация.Организация;
	Контрагент = Реализация.Контрагент;
	Договор = Реализация.Договор;
	Менеджер = Реализация.Менеджер;
	ЦенаВключаетНДС = Реализация.ЦенаВключаетНДС;
	Комментарий = Реализация.Комментарий;
	Для Каждого СтрокаРеализации Из Реализация.ТЧТовары Цикл
		СтрокаПредложения = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПредложения, СтрокаРеализации);
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьОписанияСтрок(Отказ)
	Описания = Новый Соответствие;
	Для Каждого СтрокаТовара Из ТЧТовары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ПредыдущееОписание = Описания.Получить(СтрокаТовара.Номенклатура);
		Если ПредыдущееОписание <> Неопределено
			И ПредыдущееОписание <> СтрокаТовара.Описание Тогда
			Отказ = Истина;
			ТекстОшибки = НСтр("ru = 'Для одной номенклатуры указаны разные описания в строках предложения.';
				|fr = 'Des descriptions différentes sont indiquées pour le même article dans le devis.';
				|en = 'Different descriptions are specified for the same item in the quotation.';
				|es = 'Se especifican descripciones diferentes para el mismo artículo en el presupuesto.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,
				"ТЧТовары", , Отказ);
			Возврат;
		КонецЕсли;
		Описания.Вставить(СтрокаТовара.Номенклатура, СтрокаТовара.Описание);
	КонецЦикла;
КонецПроцедуры

Процедура СинхронизироватьОписанияНоменклатуры()
	Описания = Новый Соответствие;
	Для Каждого СтрокаТовара Из ТЧТовары Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			Описания.Вставить(СтрокаТовара.Номенклатура, СтрокаТовара.Описание);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ОписаниеНоменклатуры Из Описания Цикл
		ОбъектНоменклатуры = ОписаниеНоменклатуры.Ключ.ПолучитьОбъект();
		Если ОбъектНоменклатуры.Описание <> ОписаниеНоменклатуры.Значение Тогда
			ОбъектНоменклатуры.Описание = ОписаниеНоменклатуры.Значение;
			ОбъектНоменклатуры.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
