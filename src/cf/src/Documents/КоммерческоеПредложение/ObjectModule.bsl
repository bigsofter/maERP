#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	Статус = Перечисления.СтатусыКоммерческихПредложений.Черновик;
	ЦенаВключаетНДС = Истина;
	ДатаОтгрузки = НачалоДня(ТекущаяДатаСеанса());
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ЗаполнитьПоРеализации(ДанныеЗаполнения);
	КонецЕсли;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Статус = Перечисления.СтатусыКоммерческихПредложений.Черновик;
	Комментарий = "";
	Ответственный = ПараметрыСеанса.Пользователь;
	// Копия - новое предложение: редакции исходного к ней не относятся.
	Версия = 0;
	ИзмененоПослеРедакции = Ложь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	// Решение прошлой, в том числе отменённой, попытки записи этого экземпляра не переживает.
	ДополнительныеСвойства.Удалить(КлючОтложенныхРедакций());
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыКоммерческихПредложений.Черновик;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	РаботаСВалютами.ПроверитьВалютуДокумента(ЭтотОбъект, Отказ);
	РаботаСДокументами.ЗаполнитьИтогиДокумента(ЭтотОбъект);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ОпределитьРедакцию();
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьОтложенныеРедакции();
КонецПроцедуры

// BSLLS:DataExchangeLoading-off - редакции удаляются и при загрузке обмена: иначе удаление документа упрётся в защиту архива

Процедура ПередУдалением(Отказ)
	// Редакции удаляются вместе с документом и до него: каскад платформы по ведущему измерению пишет пустой набор,
	// а набор с записями без флага ЗаписьРедакцииКП защита архива отклоняет.
	УдалитьРедакции();
КонецПроцедуры
// BSLLS:DataExchangeLoading-on

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоРеализации(Реализация)
	// Валюта основания переносится, курс - на дату нового документа.
	РаботаСВалютами.ЗаполнитьВалютуПоОснованию(ЭтотОбъект, Реализация);
	Основание = Реализация;
	Организация = Реализация.Организация;
	Контрагент = Реализация.Контрагент;
	Договор = Реализация.Договор;
	Менеджер = Реализация.Менеджер;
	ЦенаВключаетНДС = Реализация.ЦенаВключаетНДС;
	Комментарий = Реализация.Комментарий;
	Для Каждого СтрокаРеализации Из Реализация.ТЧТовары Цикл
		СтрокаПредложения = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПредложения, СтрокаРеализации);
		СтрокаПредложения.Описание = Документы.КоммерческоеПредложение.ОписаниеСтрокиПоУмолчанию(СтрокаРеализации.Номенклатура);
	КонецЦикла;
КонецПроцедуры

#Область Редакции

// Номер редакции и признак изменения пересчитываются из регистра редакций при каждой записи
// (docs/plans/kp-print-revisions.md, «Логика редакций»): значения экземпляра от прошлой попытки не используются.
Процедура ОпределитьРедакцию()
	МенеджерДокумента = Документы.КоммерческоеПредложение;
	Отложенные = Новый Массив;
	ЭтоНовый = ЭтоНовый();

	Если ЭтоНовый Тогда
		Если Ссылка.Пустая() И ПолучитьСсылкуНового().Пустая() Тогда
			УстановитьСсылкуНового(МенеджерДокумента.ПолучитьСсылку());
		КонецЕсли;
		Последняя = Новый Структура("Версия, Хеш", 0, "");
	Иначе
		ЗаблокироватьРедакции();
		Последняя = ПоследняяРедакция();
	КонецЕсли;

	// Предложение, отправленное до учёта редакций: сначала фиксируется то, что видел клиент, - состояние из базы.
	Если Последняя.Версия = 0 И Не ЭтоНовый Тогда
		ДобавитьНачальнуюРедакцию(Последняя, Отложенные);
	КонецЕсли;

	// Номер печатается и входит в хеш, а автонумерация платформы срабатывает после ПередЗаписью.
	Если Не ЗначениеЗаполнено(Номер) Тогда
		УстановитьНовыйНомер();
	КонецЕсли;
	ТекущийХеш = ХешДляСравнения(Последняя);

	Если МенеджерДокумента.СтатусОтправлен(Статус) И (Последняя.Версия = 0 Или ТекущийХеш <> Последняя.Хеш) Тогда
		Версия = Последняя.Версия + 1;
		ИзмененоПослеРедакции = Ложь;
		Снимок = МенеджерДокумента.СнимокРедакции(ЭтотОбъект);
		Отложенные.Добавить(НоваяОтложеннаяРедакция(Версия, ТекущийХеш, Снимок, ЭтотОбъект));
	Иначе
		Версия = Последняя.Версия;
		ИзмененоПослеРедакции = (Последняя.Версия > 0 И ТекущийХеш <> Последняя.Хеш);
	КонецЕсли;

	Если Отложенные.Количество() > 0 Тогда
		ДополнительныеСвойства.Вставить(КлючОтложенныхРедакций(), Отложенные);
	КонецЕсли;
КонецПроцедуры

// Хеш текущего содержимого. Редакция, записанная до расширения состава шапки, сравнивается в своём составе:
// при совпадении возвращается её хеш.
//
// Параметры:
//  Последняя - Структура - Версия (Число), Хеш (Строка) последней сохранённой редакции.
//
// Возвращаемое значение:
//  Строка - хеш для сравнения с Последняя.Хеш.
//
Функция ХешДляСравнения(Последняя)
	МенеджерДокумента = Документы.КоммерческоеПредложение;
	Содержимое = МенеджерДокумента.СодержимоеРедакции(ЭтотОбъект);
	Хеш = МенеджерДокумента.ХешСодержимого(Содержимое);
	Если Последняя.Версия > 0 И Хеш <> Последняя.Хеш
		И МенеджерДокумента.ХешВСоставеРедакции(Содержимое, Ссылка, Последняя.Версия) = Последняя.Хеш Тогда
		Возврат Последняя.Хеш;
	КонецЕсли;
	Возврат Хеш;
КонецФункции

Процедура ДобавитьНачальнуюРедакцию(Последняя, Отложенные)
	МенеджерДокумента = Документы.КоммерческоеПредложение;
	СохраненныйСтатус = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Статус").Статус;
	Если Не МенеджерДокумента.СтатусОтправлен(СохраненныйСтатус) Тогда
		Возврат;
	КонецЕсли;
	СохраненныйОбъект = Ссылка.ПолучитьОбъект();
	Снимок = МенеджерДокумента.СнимокРедакции(СохраненныйОбъект);
	Последняя.Версия = 1;
	Последняя.Хеш = МенеджерДокумента.ХешСодержимого(Снимок.Объект);
	Отложенные.Добавить(НоваяОтложеннаяРедакция(Последняя.Версия, Последняя.Хеш, Снимок, СохраненныйОбъект));
КонецПроцедуры

Процедура ЗаблокироватьРедакции()
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.РедакцииКоммерческихПредложений");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Предложение", Ссылка);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ПоследняяРедакция()
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Редакции.Версия КАК Версия,
	|	Редакции.Хеш КАК Хеш
	|ИЗ
	|	РегистрСведений.РедакцииКоммерческихПредложений КАК Редакции
	|ГДЕ
	|	Редакции.Предложение = &Предложение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Версия УБЫВ");
	Запрос.УстановитьПараметр("Предложение", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Версия, Хеш", Выборка.Версия, Выборка.Хеш);
	КонецЕсли;
	Возврат Новый Структура("Версия, Хеш", 0, "");
КонецФункции

Функция НоваяОтложеннаяРедакция(НомерВерсии, Хеш, Снимок, Источник)
	Редакция = Новый Структура;
	Редакция.Вставить("Версия", НомерВерсии);
	Редакция.Вставить("Хеш", Хеш);
	Редакция.Вставить("Снимок", Снимок);
	Редакция.Вставить("Сумма", Источник.Сумма);
	Редакция.Вставить("Валюта", РаботаСВалютами.ВалютаИКурсДокумента(Источник).Валюта);
	Возврат Редакция;
КонецФункции

// Снимки пишет только документ: набор записей регистра без флага ЗаписьРедакцииКП отказывает.
// Права на изменение регистра нет ни у одной роли, кроме полных прав, поэтому запись - в привилегированном
// режиме, только вокруг записи набора.
Процедура ЗаписатьОтложенныеРедакции()
	Отложенные = Неопределено;
	Если Не ДополнительныеСвойства.Свойство(КлючОтложенныхРедакций(), Отложенные) Тогда
		Возврат;
	КонецЕсли;
	ДополнительныеСвойства.Удалить(КлючОтложенныхРедакций());
	Автор = ПараметрыСеанса.Пользователь;
	Для Каждого Редакция Из Отложенные Цикл
		// BSLLS:SetPrivilegedMode-off - пишется только снимок этого документа, сформированный в ПередЗаписью; права на
		// регистр у ролей нет намеренно (архив не правится руками), набор без флага ЗаписьРедакцииКП отказывает.
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		Набор = РегистрыСведений.РедакцииКоммерческихПредложений.СоздатьНаборЗаписей();
		Набор.Отбор.Предложение.Установить(Ссылка);
		Набор.Отбор.Версия.Установить(Редакция.Версия);
		Набор.ДополнительныеСвойства.Вставить("ЗаписьРедакцииКП", Истина);
		Запись = Набор.Добавить();
		Запись.Предложение = Ссылка;
		Запись.Версия = Редакция.Версия;
		Запись.Данные = Новый ХранилищеЗначения(Редакция.Снимок, Новый СжатиеДанных(МаксимальноеСжатие()));
		Запись.Хеш = Редакция.Хеш;
		Запись.Дата = ТекущаяДатаСеанса();
		Запись.Автор = Автор;
		Запись.Сумма = Редакция.Сумма;
		Запись.Валюта = Редакция.Валюта;
		Набор.Записать(Истина);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЦикла;
КонецПроцедуры

Процедура УдалитьРедакции()
	// BSLLS:SetPrivilegedMode-off - удаляются только редакции этого документа, флаг ЗаписьРедакцииКП - как при записи.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Набор = РегистрыСведений.РедакцииКоммерческихПредложений.СоздатьНаборЗаписей();
	Набор.Отбор.Предложение.Установить(Ссылка);
	Набор.ДополнительныеСвойства.Вставить("ЗаписьРедакцииКП", Истина);
	Набор.Записать(Истина);
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Функция МаксимальноеСжатие()
	Возврат 9;
КонецФункции

Функция КлючОтложенныхРедакций()
	Возврат "ОтложенныеРедакцииКП";
КонецФункции

#КонецОбласти

#КонецОбласти
