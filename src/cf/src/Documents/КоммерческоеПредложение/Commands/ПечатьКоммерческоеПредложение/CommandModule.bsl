#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	// Из формы предложения печатается только записанное состояние: изменённая или новая форма сначала
	// записывается, источник печати (снимок редакции или данные документа) выбирается уже по записанным
	// Версия и ИзмененоПослеРедакции (docs/plans/kp-print-revisions.md, «Печать из формы КП»).
	Источник = ПараметрыВыполненияКоманды.Источник;
	ОбъектыПечати = ПараметрКоманды;
	Если ЭтоФормаПредложения(Источник) Тогда
		Если Источник.Модифицированность Или Источник.Объект.Ссылка.Пустая() Тогда
			Если Не Источник.Записать() Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		ОбъектыПечати = Источник.Объект.Ссылка;
	КонецЕсли;

	ПечатныеФормыКлиент.ВыполнитьКомандуПечати("Документ.КоммерческоеПредложение", "КоммерческоеПредложение",
		ОбъектыПечати, Источник);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЭтоФормаПредложения(Источник)
	Возврат ТипЗнч(Источник) = Тип("ФормаКлиентскогоПриложения")
		И Источник.ИмяФормы = "Документ.КоммерческоеПредложение.Форма.ФормаДокумента";
КонецФункции

#КонецОбласти
