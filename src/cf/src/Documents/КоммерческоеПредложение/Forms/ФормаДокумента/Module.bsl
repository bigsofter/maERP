#Область ОписаниеПеременных

&НаКлиенте
Перем ВалютаДоИзменения; // валюта и курс, от которых пересчитываются цены при смене валюты
&НаКлиенте
Перем КурсДоИзменения;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РаботаСДокументами.МожноРедактироватьДокументВФорме(Объект.Ссылка, ЭтотОбъект);
	РаботаСДокументамиКлиентСервер.УстановитьПараметрыФункциональныхОпций(ЭтотОбъект);
	РаботаСДокументами.УстановитьЗаголовокФормыДокумента(ЭтотОбъект, Объект);
	КомандыТабличныхЧастейВызовСервера.ПодключитьКоманду(ЭтотОбъект, "Подменю", Элементы.ТЧТовары.КоманднаяПанель);
	Если Не ТолькоПросмотр Тогда
		КомандыТабличныхЧастейВызовСервера.ПодключитьКоманду(ЭтотОбъект, "Подбор", Элементы.ТЧТовары.КоманднаяПанель);
	КонецЕсли;
	Элементы.ФормаСоздатьЗаказНаПроизводство.Видимость = ПолучитьФункциональнуюОпцию("Производство");
	Если Объект.Ссылка.Пустая() И Не Объект.ВВалюте Тогда
		Объект.Валюта = РаботаСВалютами.ОсновнаяВалюта();
		Объект.КурсВалюты = 1;
		ЗаполнитьВалютуПоДоговору();
	КонецЕсли;
	УстановитьВидимостьВалюты();
	// Копия документа в валюте - курс на её дату, а не исходного документа.
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) И Объект.ВВалюте Тогда
		ЗаполнитьКурсНаДату();
		РаботаСВалютамиКлиентСервер.ПересчитатьСуммыРегл(Объект);
	КонецЕсли;
	ОбновитьТекстРедакции(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьОписаниеСтроки();
	ЗапомнитьВалюту();
	ОбновитьТекстРедакции(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") И ВыбранноеЗначение.Свойство("Количество") Тогда
		ЧислоСтрок = Объект.ТЧТовары.Количество();
		РаботаСДокументамиКлиентСервер.ДобавитьНоменклатуруПоПодбору(Объект, ВыбранноеЗначение, , Неопределено, ЭтотОбъект);
		// Описание по умолчанию - только у добавленной строки: подбор в существующую строку описание не трогает.
		ТекущаяСтрока = Элементы.ТЧТовары.ТекущиеДанные;
		Если Объект.ТЧТовары.Количество() > ЧислоСтрок И ТекущаяСтрока <> Неопределено Тогда
			ТекущаяСтрока.Описание = ОписаниеСтрокиПоУмолчанию(ТекущаяСтрока.Номенклатура);
		КонецЕсли;
		ОбновитьОписаниеСтроки();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.ДополнительныеСвойства.Вставить(РаботаСДокументами.СвойствоЗаписьИзФормы(), Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	СохранитьОписаниеТекущейСтроки();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	РаботаСДокументами.УстановитьЗаголовокФормыДокумента(ЭтотОбъект, ТекущийОбъект);
	УстановитьВидимостьВалюты();
	ОбновитьТекстРедакции(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	ОбновитьТекстРедакции(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ТекстРедакцииНажатие(Элемент)
	Редакции = СписокРедакций(Объект.Ссылка);
	Если Редакции.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Редакций пока нет: первая фиксируется при записи предложения в статусе «Отправлен».';
			|fr = 'Aucune révision pour l''instant : la première est enregistrée lorsque le devis est enregistré au statut « Envoyé ».';
			|en = 'No revisions yet: the first one is saved when the quotation is written with the Sent status.';
			|es = 'Todavía no hay revisiones: la primera se guarda al grabar el presupuesto con el estado «Enviado».'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораРедакции", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оповещение, Редакции, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ЦенаВключаетНДСПриИзменении(Элемент)
	Для Каждого СтрокаТовара Из Объект.ТЧТовары Цикл
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТовара, Объект.ЦенаВключаетНДС);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДатаОтгрузкиПриИзменении(Элемент)
	ОбновитьТекстРедакции(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	РаботаСДокументамиКлиент.ЗаполнитьДанныеПоТорговойТочке(Объект, ВидЦены, Элементы.ТЧТоварыВидЦены);
	УстановитьВидЦеныПоДоговору();
	ВалютаПоДоговору();
	ОбновитьТекстРедакции(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	Объект.Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(Объект.Контрагент, Объект.Организация, Истина);
	Объект.Менеджер = РаботаСДокументамиВызовСервера.ПолучитьКуратораДоговора(Объект.Договор, Объект.Дата).Менеджер;
	УстановитьВидЦеныПоДоговору();
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	Объект.Менеджер = РаботаСДокументамиВызовСервера.ПолучитьКуратораДоговора(Объект.Договор, Объект.Дата).Менеджер;
	УстановитьВидЦеныПоДоговору();
	ВалютаПоДоговору();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТЧТовары

&НаКлиенте
Процедура ТЧТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекущаяСтрока = Элемент.ТекущиеДанные;
		ТекущаяСтрока.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Объект.ТЧТовары);
		ТекущаяСтрока.ВидЦены = ВидЦены;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	РаботаСДокументамиКлиент.ПроверитьКратностьЕдиницы(Элемент.ТекущиеДанные, Объект, Отказ);
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыПриАктивизацииЯчейки(Элемент)
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыПриАктивизацииСтроки(Элемент)
	ОбновитьОписаниеСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеСтрокиПриИзменении(Элемент)
	СохранитьОписаниеТекущейСтроки();
	ОбновитьТекстРедакции(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыНоменклатураПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТЧТовары.ТекущиеДанные;
	РаботаСДокументамиКлиентСервер.УстановитьПараметрыНоменклатуры(ТекущаяСтрока, Объект);
	ТекущаяСтрока.Описание = ОписаниеСтрокиПоУмолчанию(ТекущаяСтрока.Номенклатура);
	ОбновитьОписаниеСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыНоменклатураАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	ПараметрыАвтоподбора = РаботаСДокументамиКлиент.ПараметрыАвтободбораНоменклатуры();
	ПараметрыАвтоподбора.ВидЦены = ВидЦены;
	ПараметрыАвтоподбора.ИсключитьХарактеристикиДляВнутреннегоИспользования = Истина;
	РаботаСДокументамиКлиент.АвтоподборНоменклатуры(ДанныеВыбора, ПараметрыПолученияДанных, Объект,
		СтандартнаяОбработка, ПараметрыАвтоподбора);
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыНоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	РаботаСДокументамиКлиент.ОбрабокаВыбораПриАвтоподбореНоменклатуры(Элементы.ТЧТовары.ТекущиеДанные,
		ВыбранноеЗначение, Объект, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыХарактеристикаПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.УстановитьЦенуНоменклатуры(Элементы.ТЧТовары.ТекущиеДанные, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыУпаковкаПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.УстановитьЦенуНоменклатуры(Элементы.ТЧТовары.ТекущиеДанные, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыКоличествоУпаковокПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Элементы.ТЧТовары.ТекущиеДанные, Объект.ЦенаВключаетНДС);
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыВидЦеныПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.УстановитьЦенуНоменклатуры(Элементы.ТЧТовары.ТекущиеДанные, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыЦенаПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Элементы.ТЧТовары.ТекущиеДанные, Объект.ЦенаВключаетНДС, "Цена");
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыСуммаПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Элементы.ТЧТовары.ТекущиеДанные, Объект.ЦенаВключаетНДС, "Сумма");
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыПроцентСкидкиПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Элементы.ТЧТовары.ТекущиеДанные, Объект.ЦенаВключаетНДС);
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыСуммаСкидкиПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Элементы.ТЧТовары.ТекущиеДанные, Объект.ЦенаВключаетНДС, "Сумма");
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыСкидкаНаЦенуПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Элементы.ТЧТовары.ТекущиеДанные, Объект.ЦенаВключаетНДС, "Цена");
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыСтавкаНДСПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Элементы.ТЧТовары.ТекущиеДанные, Объект.ЦенаВключаетНДС);
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыСуммаНДСПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Элементы.ТЧТовары.ТекущиеДанные, Объект.ЦенаВключаетНДС);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерезаполнитьЦены(Команда)
	УстановитьЦеныНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаказКлиента(Команда)
	СоздатьЗаказПоПредложению(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаказНаПроизводство(Команда)
	СоздатьЗаказПоПредложению(Истина);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьОбщуюКоманду(Команда)
	КомандыТабличныхЧастейКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда.Имя);
КонецПроцедуры

&НаСервере
Процедура УстановитьЦеныНаСервере()
	ВалютаДокумента = Новый Структура("Валюта, Курс", ?(Объект.ВВалюте, Объект.Валюта, Неопределено),
		РаботаСВалютамиКлиентСервер.КурсДокумента(Объект));
	РаботаСДокументами.УстановитьЦеныВТабличнойЧасти(Объект.ТЧТовары, ВидЦены, Объект.Дата,
		Объект.ЦенаВключаетНДС, Объект.Контрагент, ВалютаДокумента);
	РаботаСВалютамиКлиентСервер.ПересчитатьСуммыРегл(Объект);
КонецПроцедуры

&НаСервере
Процедура УстановитьВидЦеныПоДоговору()
	ВидЦены = ?(ЗначениеЗаполнено(Объект.Контрагент.ТипЦены), Объект.Контрагент.ТипЦены, Справочники.ВидыЦен.Розничная);
	РаботаСДокументамиКлиентСервер.ЗаполнитьСписокВыбораВидовЦен(ВидЦены, Элементы.ТЧТоварыВидЦены);
	Объект.ЦенаВключаетНДС = ОбщегоНазначенияВызовСервера.ЦенаВключаетНДСПоВидуЦен(ВидЦены);
КонецПроцедуры

// Заказ клиента на основании предложения - продажа, заказ на производство - с видом операции «Производство»
// и материалами по техкартам; больше заказы ничем не различаются. Несохранённое предложение записывается.
//
// Параметры:
//  НаПроизводство - Булево - создать заказ клиента на производство
//
&НаКлиенте
Процедура СоздатьЗаказПоПредложению(НаПроизводство)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Основание = Новый Структура("Предложение, НаПроизводство", Объект.Ссылка, НаПроизводство);
	ПараметрыФормы = Новый Структура("Основание", Основание);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияЗаказа", ЭтотОбъект);
	ОткрытьФорму("Документ.ЗаказПокупателя.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);
КонецПроцедуры

// Записанный заказ переводит предложение в статус «Выигран»: форма перечитывает документ, если его не правили.
//
// Параметры:
//  Результат               - Произвольный - результат закрытия формы заказа.
//  ДополнительныеПараметры - Неопределено - не используются.
//
&НаКлиенте
Процедура ПослеЗакрытияЗаказа(Результат, ДополнительныеПараметры) Экспорт
	Если Не Модифицированность Тогда
		Прочитать();
		ОбновитьОписаниеСтроки();
		ОбновитьТекстРедакции(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОписаниеСтроки()
	ТекущаяСтрока = Элементы.ТЧТовары.ТекущиеДанные;
	ОписаниеСтроки = ?(ТекущаяСтрока = Неопределено, "", ТекущаяСтрока.Описание);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеСтрокиПоУмолчанию(Знач Номенклатура)
	Возврат Документы.КоммерческоеПредложение.ОписаниеСтрокиПоУмолчанию(Номенклатура);
КонецФункции

&НаКлиенте
Процедура СохранитьОписаниеТекущейСтроки()
	ТекущаяСтрока = Элементы.ТЧТовары.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущаяСтрока.Описание = ОписаниеСтроки;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выбранная отправленная редакция открывается на просмотр в форме редакции: её печатная форма из снимка,
// перепечатка и возврат (docs/plans/kp-print-revisions.md).
//
// Параметры:
//  ВыбранныйЭлемент        - ЭлементСпискаЗначений, Неопределено - выбранная редакция, значение - номер.
//  ДополнительныеПараметры - Неопределено - не используются.
//
&НаКлиенте
Процедура ПослеВыбораРедакции(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Предложение", Объект.Ссылка);
	ПараметрыФормы.Вставить("Версия", ВыбранныйЭлемент.Значение);
	ПараметрыФормы.Вставить("МожноВернуть", Не ТолькоПросмотр);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияРедакции", ЭтотОбъект);
	ОткрытьФорму("Документ.КоммерческоеПредложение.Форма.ФормаРедакции", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);
КонецПроцедуры

// Возврат редакции: её содержимое становится текущим содержимым формы, номер и статус предложения остаются
// своими; при записи отправленного предложения рождается следующая редакция.
//
// Параметры:
//  Результат               - Структура, Неопределено - ключ ВернутьВерсию - номер возвращаемой редакции.
//  ДополнительныеПараметры - Неопределено - не используются.
//
&НаКлиенте
Процедура ПослеЗакрытияРедакции(Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.Свойство("ВернутьВерсию") Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗаполнитьИзРедакции(Результат.ВернутьВерсию) Тогда
		Возврат;
	КонецЕсли;
	ПослеЗаполненияИзСнимка();
КонецПроцедуры

// Единственный путь восстановления редакции на клиенте: без него редактор описания строки и запомненная
// валюта остались бы от прежнего содержимого.
&НаКлиенте
Процедура ПослеЗаполненияИзСнимка()
	Если Объект.ТЧТовары.Количество() > 0 Тогда
		Элементы.ТЧТовары.ТекущаяСтрока = Объект.ТЧТовары[0].ПолучитьИдентификатор();
	КонецЕсли;
	ОбновитьОписаниеСтроки();
	ЗапомнитьВалюту();
	Модифицированность = Истина;
	ОбновитьТекстРедакции(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Функция ЗаполнитьИзРедакции(Знач Версия)
	Содержимое = Документы.КоммерческоеПредложение.СодержимоеДляВозврата(Объект.Ссылка, Версия);
	Если Содержимое = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Редакция не найдена.'; fr = 'Révision introuvable.';
			|en = 'Revision not found.'; es = 'Revisión no encontrada.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	Шапка = Содержимое.Шапка;
	// Номер не возвращается: у предложения контроль уникальности, прежний номер мог занять другой документ.
	Шапка.Удалить("Номер");
	ЗаполнитьЗначенияСвойств(Объект, Шапка);
	Объект.ТЧТовары.Очистить();
	Для Каждого СтрокаРедакции Из Содержимое.Товары Цикл
		ЗаполнитьЗначенияСвойств(Объект.ТЧТовары.Добавить(), СтрокаРедакции);
	КонецЦикла;
	ШаблонНеНайдено = НСтр("ru = 'В базе уже нет: %1'; fr = 'N''existe plus : %1';
		|en = 'No longer in the database: %1'; es = 'Ya no existe en la base: %1'");
	Для Каждого НеНайдено Из Содержимое.НеНайдено Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ШаблонНеНайдено, НеНайдено));
	КонецЦикла;
	// Вид цены - из строк редакции; не через УстановитьВидЦеныПоДоговору: она переписывает ЦенаВключаетНДС,
	// а признак - часть возвращаемой редакции.
	ВидЦены = Справочники.ВидыЦен.ПустаяСсылка();
	Для Каждого СтрокаТоваров Из Объект.ТЧТовары Цикл
		Если ЗначениеЗаполнено(СтрокаТоваров.ВидЦены) Тогда
			ВидЦены = СтрокаТоваров.ВидЦены;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		ВидЦены = ?(ЗначениеЗаполнено(Объект.Контрагент.ТипЦены), Объект.Контрагент.ТипЦены, Справочники.ВидыЦен.Розничная);
	КонецЕсли;
	РаботаСДокументамиКлиентСервер.ЗаполнитьСписокВыбораВидовЦен(ВидЦены, Элементы.ТЧТоварыВидЦены);
	УстановитьВидимостьВалюты();
	Возврат Истина;
КонецФункции

&НаСервереБезКонтекста
Функция СписокРедакций(Знач Предложение)
	Список = Новый СписокЗначений;
	ШаблонПредставления = НСтр("ru = 'v%1 · отправлена %2 · %3 %4 · %5'; fr = 'v%1 · envoyée le %2 · %3 %4 · %5';
		|en = 'v%1 · sent %2 · %3 %4 · %5'; es = 'v%1 · enviada el %2 · %3 %4 · %5'");
	Для Каждого Редакция Из Документы.КоммерческоеПредложение.СписокРедакций(Предложение) Цикл
		НомерВерсии = Формат(Редакция.Версия, "ЧГ=0");
		ДатаРедакции = Формат(Редакция.Дата, "ДЛФ=D");
		Сумма = Формат(Редакция.Сумма, "ЧДЦ=2; ЧН=0,00");
		Валюта = СокрЛП(Редакция.Валюта);
		Автор = СокрЛП(Редакция.Автор);
		Представление = СтрШаблон(ШаблонПредставления, НомерВерсии, ДатаРедакции, Сумма, Валюта, Автор);
		Список.Добавить(Редакция.Версия, Представление);
	КонецЦикла;
	Возврат Список;
КонецФункции

// Надпись-ссылка редакции в шапке: номер последней отправленной редакции и что станет с ним при записи.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма предложения.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстРедакции(Форма)
	ДанныеОбъекта = Форма.Объект;
	Версия = ДанныеОбъекта.Версия;
	Отправлено = ЗначениеЗаполнено(ДанныеОбъекта.Статус)
		И ДанныеОбъекта.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыКоммерческихПредложений.Черновик");
	НомерВерсии = Формат(Версия, "ЧГ=0");
	СледующаяВерсия = Формат(Версия + 1, "ЧГ=0");
	Если Версия = 0 И Не Отправлено Тогда
		Текст = НСтр("ru = 'Редакция: ещё не отправлялось'; fr = 'Révision : pas encore envoyé'; en = 'Revision: not sent yet';
			|es = 'Revisión: aún no enviado'");
	ИначеЕсли Версия = 0 Тогда
		Текст = НСтр("ru = 'Редакция: v1 зафиксируется при записи'; fr = 'Révision : la v1 sera enregistrée à l''écriture';
			|en = 'Revision: v1 will be saved on write'; es = 'Revisión: la v1 se guardará al grabar'");
	ИначеЕсли Отправлено И Форма.Модифицированность Тогда
		Шаблон = НСтр("ru = 'Редакция v%1 · при записи изменений станет v%2';
			|fr = 'Révision v%1 · deviendra v%2 si les modifications sont enregistrées';
			|en = 'Revision v%1 · becomes v%2 when changes are saved';
			|es = 'Revisión v%1 · pasará a v%2 al guardar los cambios'");
		Текст = СтрШаблон(Шаблон, НомерВерсии, СледующаяВерсия);
	ИначеЕсли Не Отправлено И (ДанныеОбъекта.ИзмененоПослеРедакции Или Форма.Модифицированность) Тогда
		Шаблон = НСтр("ru = 'Редакция v%1 · исправляется, станет v%2 при отправке';
			|fr = 'Révision v%1 · en cours de modification, deviendra v%2 à l''envoi';
			|en = 'Revision v%1 · being edited, becomes v%2 when sent';
			|es = 'Revisión v%1 · en edición, pasará a v%2 al enviar'");
		Текст = СтрШаблон(Шаблон, НомерВерсии, СледующаяВерсия);
	Иначе
		Шаблон = НСтр("ru = 'Редакция v%1'; fr = 'Révision v%1'; en = 'Revision v%1'; es = 'Revisión v%1'");
		Текст = СтрШаблон(Шаблон, НомерВерсии);
	КонецЕсли;
	Форма.Элементы.ТекстРедакции.Заголовок = Текст;
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	КурсПоДатеДокумента();
КонецПроцедуры

// Документ в валюте (docs/plans/multicurrency.md): флажок ВВалюте открывает валюту и курс, цены и суммы строк -
// в валюте документа, колонка СуммаРегл - в основной валюте.

&НаКлиенте
Процедура ВВалютеПриИзменении(Элемент)
	ПрежняяВалюта = Объект.Валюта;
	ПрежнийКурс = Объект.КурсВалюты;
	ВВалютеПриИзмененииНаСервере();
	ПослеСменыВалюты(ПрежняяВалюта, ПрежнийКурс);
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	ВалютаПриИзмененииНаСервере();
	ПослеСменыВалюты(ВалютаДоИзменения, КурсДоИзменения);
КонецПроцедуры

&НаКлиенте
Процедура КурсВалютыПриИзменении(Элемент)
	// Цены остаются в валюте документа - меняются только суммы в основной валюте.
	ПослеСменыВалюты(Объект.Валюта, Объект.КурсВалюты);
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ОбновитьТекстРедакции(ЭтотОбъект);
	ПересчитатьСуммуРеглСтроки(Элемент.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуРеглСтроки(Стр)
	Если Стр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Стр.СуммаРегл = РаботаСВалютамиКлиентСервер.СуммаРегл(Стр.Сумма, РаботаСВалютамиКлиентСервер.КурсДокумента(Объект));
КонецПроцедуры

// Запоминает валюту и курс, от которых пересчитываются цены при следующей смене валюты.
//
&НаКлиенте
Процедура ЗапомнитьВалюту()
	ВалютаДоИзменения = Объект.Валюта;
	КурсДоИзменения = Объект.КурсВалюты;
КонецПроцедуры

// После смены валюты, курса или флажка: суммы в основной валюте и, если сменилась сама валюта, - вопрос
// о пересчёте цен строк из прежней валюты в новую.
//
// Параметры:
//  ПрежняяВалюта - СправочникСсылка.Валюты - валюта до изменения.
//  ПрежнийКурс - Число - курс до изменения.
//
&НаКлиенте
Процедура ПослеСменыВалюты(ПрежняяВалюта, ПрежнийКурс)
	РаботаСВалютамиКлиентСервер.ПересчитатьСуммыРегл(Объект);
	ЕстьСтроки = Объект.ТЧТовары.Количество() > 0;
	Если ПрежняяВалюта = Объект.Валюта Или Не ЕстьСтроки Или ПрежнийКурс <= 0 Тогда
		ЗапомнитьВалюту();
		Возврат;
	КонецЕсли;
	Текст = СтрШаблон(НСтр("ru = 'Пересчитать цены строк из %1 в %2 по курсу?';
		|fr = 'Convertir les prix des lignes de %1 en %2 au taux de change ?';
		|en = 'Convert line prices from %1 to %2 at the exchange rate?';
		|es = '¿Convertir los precios de las líneas de %1 a %2 al tipo de cambio?'"), ПрежняяВалюта, Объект.Валюта);
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОПересчетеЦен", ЭтотОбъект, ПрежнийКурс);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОПересчетеЦен(Ответ, ПрежнийКурс) Экспорт
	ЗапомнитьВалюту();
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	// Курсы - к основной валюте (для основной 1), поэтому цена в новой валюте = цена × прежний курс / новый курс.
	Коэффициент = ПрежнийКурс / РаботаСВалютамиКлиентСервер.КурсДокумента(Объект);
	Для Каждого Стр Из Объект.ТЧТовары Цикл
		Стр.Цена = Стр.Цена * Коэффициент;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, Объект.ЦенаВключаетНДС, "Цена");
	КонецЦикла;
	РаботаСВалютамиКлиентСервер.ПересчитатьСуммыРегл(Объект);
	Модифицированность = Истина;
КонецПроцедуры

// Договор в валюте переводит документ в эту валюту; при смене валюты - вопрос о пересчёте цен.
//
&НаКлиенте
Процедура ВалютаПоДоговору()
	ЗаполнитьВалютуПоДоговору();
	ПослеСменыВалюты(ВалютаДоИзменения, КурсДоИзменения);
КонецПроцедуры

// Курс на новую дату документа.
//
&НаКлиенте
Процедура КурсПоДатеДокумента()
	Если Не Объект.ВВалюте Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьКурсНаДатуНаСервере();
	ПослеСменыВалюты(Объект.Валюта, Объект.КурсВалюты);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКурсНаДатуНаСервере()
	ЗаполнитьКурсНаДату();
КонецПроцедуры

&НаСервере
Процедура ВВалютеПриИзмененииНаСервере()
	Если Объект.ВВалюте Тогда
		ЗаполнитьКурсНаДату();
	Иначе
		Объект.Валюта = РаботаСВалютами.ОсновнаяВалюта();
		Объект.КурсВалюты = 1;
	КонецЕсли;
	УстановитьВидимостьВалюты();
КонецПроцедуры

&НаСервере
Процедура ВалютаПриИзмененииНаСервере()
	ЗаполнитьКурсНаДату();
	УстановитьВидимостьВалюты();
КонецПроцедуры

// Курс валюты документа на его дату из регистра КурсыВалют; курс не задан - нулевой курс и сообщение:
// документ без курса не запишется (РаботаСВалютами.ПроверитьВалютуДокумента), пока курс не введут вручную.
//
&НаСервере
Процедура ЗаполнитьКурсНаДату()
	Если Не Объект.ВВалюте Тогда
		Возврат;
	КонецЕсли;
	Курс = РаботаСВалютами.КурсВалюты(Объект.Валюта, Объект.Дата);
	Объект.КурсВалюты = Курс;
	Если Курс > 0 Тогда
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Курс валюты %1 на %2 не задан (Казначейство - Курсы валют): укажите курс в документе.';
		|fr = 'Le taux de change de %1 au %2 n''est pas défini (Trésorerie - Taux de change) : indiquez le taux dans le document.';
		|en = 'The %1 exchange rate on %2 is not set (Treasury - Exchange rates): enter the rate in the document.';
		|es = 'El tipo de cambio de %1 al %2 no está definido (Tesorería - Tipos de cambio): indique el tipo en el documento.'");
	ТекстСообщения = СтрШаблон(Шаблон, Объект.Валюта, Формат(Объект.Дата, "ДЛФ=D"));
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КурсВалюты");
КонецПроцедуры

// Договор в валюте, отличной от основной, переводит документ в эту валюту.
//
&НаСервере
Процедура ЗаполнитьВалютуПоДоговору()
	// Документ с заполненными строками (ввод на основании, копирование) валюту не меняет: цены строк
	// остались бы в прежней валюте.
	Если Объект.ТЧТовары.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	ВалютаДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВалютаВзаиморасчётов");
	Если Не ЗначениеЗаполнено(ВалютаДоговора) Или ВалютаДоговора = РаботаСВалютами.ОсновнаяВалюта()
		Или ВалютаДоговора = Объект.Валюта Тогда
		Возврат;
	КонецЕсли;
	Объект.ВВалюте = Истина;
	Объект.Валюта = ВалютаДоговора;
	ЗаполнитьКурсНаДату();
	УстановитьВидимостьВалюты();
КонецПроцедуры

// Доступность валюты и курса, заголовки цен и сумм с валютой, колонка сумм в основной валюте.
//
&НаСервере
Процедура УстановитьВидимостьВалюты()
	ВВалюте = Объект.ВВалюте;
	Элементы.Валюта.Доступность = ВВалюте;
	Элементы.КурсВалюты.Доступность = ВВалюте;
	Элементы.ТЧТоварыСуммаРегл.Видимость = ВВалюте;
	ТекстЦена = НСтр("ru = 'Цена'; fr = 'Prix'; en = 'Price'; es = 'Precio'");
	ТекстСумма = НСтр("ru = 'Сумма'; fr = 'Montant'; en = 'Amount'; es = 'Importe'");
	Если ВВалюте Тогда
		ЗаголовокЦена = РаботаСВалютамиКлиентСервер.ЗаголовокСВалютой(ТекстЦена, Объект.Валюта);
		ЗаголовокСумма = РаботаСВалютамиКлиентСервер.ЗаголовокСВалютой(ТекстСумма, Объект.Валюта);
	Иначе
		// Пустой заголовок - заголовок по реквизиту.
		ЗаголовокЦена = "";
		ЗаголовокСумма = "";
	КонецЕсли;
	ЗаголовокСуммаРегл = РаботаСВалютамиКлиентСервер.ЗаголовокСВалютой(ТекстСумма, РаботаСВалютами.ОсновнаяВалюта());
	Элементы.ТЧТоварыЦена.Заголовок = ЗаголовокЦена;
	Элементы.ТЧТоварыСумма.Заголовок = ЗаголовокСумма;
	Элементы.ТЧТоварыСуммаРегл.Заголовок = ЗаголовокСуммаРегл;
КонецПроцедуры

#КонецОбласти
