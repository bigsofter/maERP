#Область ОписаниеПеременных

// Строка «Товаров», вставленная формой и ещё не тронутая пользователем (ПередНачаломДобавления).
&НаКлиенте
Перем ВставленнаяСтрокаТоваров;

// Идёт ввод строки «Товаров»: очередь записи ждёт его окончания.
&НаКлиенте
Перем СтрокаВводится;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПрименитьОтборы();
	ЗаказНаПроизводствоДоступен = ПолучитьФункциональнуюОпцию("Производство");
	Элементы.КнопкаСоздатьЗаказНаПроизводство.Видимость = ЗаказНаПроизводствоДоступен;
	НастроитьЗакладкуТовары();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СтрокаВводится = Ложь;
	ПрименитьСостояниеПанели();
	ПоказатьКнопкиЗаказа();
КонецПроцедуры

// Незаписанные правки «Товаров» не теряются молча: сначала - запись; не записалось - вопрос.
//
// Параметры:
//  Отказ                - Булево - закрытие отменяется.
//  ЗавершениеРаботы     - Булево - закрывается программа: вопрос не задаётся.
//  ТекстПредупреждения  - Строка - предупреждение платформы при завершении работы.
//  СтандартнаяОбработка - Булево - не используется.
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗакрытиеПодтверждено Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаВводится Тогда
		Элементы.Товары.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	Если СтрокиТоваровКЗаписи.Количество() = 0 И ЧислоНезаписанныхСтрок() = 0 Тогда
		Возврат;
	КонецЕсли;
	ТекстНезаписано = НСтр("ru = 'На закладке «Товары» есть незаписанные правки строк.';
		|fr = 'L''onglet « Articles » contient des modifications de lignes non enregistrées.';
		|en = 'The Items tab has unsaved line changes.'; es = 'La pestaña «Artículos» tiene cambios de líneas sin guardar.'");
	Если ЗавершениеРаботы Тогда
		Отказ = Истина;
		ТекстПредупреждения = ТекстНезаписано;
		Возврат;
	КонецЕсли;
	Остаток = ЗаписатьПравкиПередЗакрытием();
	Если Остаток = 0 Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Шаблон = НСтр("ru = 'Правки строк (%1) не записаны. Закрыть без сохранения?';
		|fr = 'Modifications de lignes (%1) non enregistrées. Fermer sans enregistrer ?';
		|en = 'Line changes (%1) are not saved. Close without saving?';
		|es = 'Cambios de líneas (%1) sin guardar. ¿Cerrar sin guardar?'");
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОЗакрытии", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, СтрШаблон(Шаблон, Остаток), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	ПрименитьОтборы();
	ОбновитьТоварыПослеОтбора();
КонецПроцедуры

// Правая панель - общая для предложений и «Товаров». Кнопки создания заказа - только на странице «Предложения» (план,
// P1 круга 7): на «Товарах» заказ по строке не создаётся. Закладка «Товары» загружается при первом переходе на неё и
// после смены отборов, пока она была закрыта.
//
// Параметры:
//  Элемент         - ГруппаФормы - группа закладок списка.
//  ТекущаяСтраница - ГруппаФормы - открытая страница.
//
&НаКлиенте
Процедура ГруппаЗакладкиСписковПриСменеСтраницы(Элемент, ТекущаяСтраница)

	ПоказатьКнопкиЗаказа();
	Если ТекущаяСтраница = Элементы.СтраницаТовары И Не ТоварыЗагружены Тогда
		ЗагрузитьТоварыНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	// BSLLS:MagicNumber-off - треть секунды исключает лишние серверные вызовы при листании.
	ПодключитьОбработчикОжидания("ОбновитьСведенияОКлиенте", 0.3, Истина);
	// BSLLS:MagicNumber-on
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСведенияОКлиенте()
	Ссылка = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.КоммерческоеПредложение") Тогда
		ЗаполнитьСведения(Ссылка);
	Иначе
		КлиентТекст = "";
		ИнфоТекст = "";
		ТаблицаСостав.Очистить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

// Двойной щелчок: по колонке «Документ» и у строки только для просмотра открывается предложение, по прочим колонкам
// записанной строки - её правка (как в рабочих местах).
//
// Параметры:
//  Элемент              - ТаблицаФормы - таблица «Товары».
//  ВыбраннаяСтрока      - Число - не используется.
//  Поле                 - ПолеФормы - колонка.
//  СтандартнаяОбработка - Булево - отключается при открытии документа.
//
&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или Не ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.ТоварыДокумент Или СтрокаТаблицы.ТолькоПросмотр Или Не МожноВводитьТовары Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьДокументСтрокиТоваров(СтрокаТаблицы);
	КонецЕсли;

КонецПроцедуры

// Новая строка - в начало таблицы: строку вставляет форма, ввод начинается обработчиком ожидания (как в рабочих
// местах); копия - в то же предложение с товаром исходной строки, без цены.
//
// Параметры:
//  Элемент     - ТаблицаФормы - таблица «Товары».
//  Отказ       - Булево - стандартное добавление отменяется.
//  Копирование - Булево - строка копируется.
//  Родитель    - Неопределено - не используется.
//  Группа      - Булево - не используется.
//  Параметр    - Произвольный - не используется.
//
&НаКлиенте
Процедура ТоварыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Отказ = Истина;
	Если Не МожноВводитьТовары Тогда
		Возврат;
	КонецЕсли;
	Исходная = Неопределено;
	Если Копирование И Элемент.ТекущиеДанные <> Неопределено Тогда
		Исходная = Новый Структура("ТолькоПросмотр, Документ, ДокументПредставление, Клиент, Организация, Валюта,
			|Номенклатура, Характеристика, Упаковка");
		ЗаполнитьЗначенияСвойств(Исходная, Элемент.ТекущиеДанные);
	КонецЕсли;
	УдалитьВставленнуюСтрокуТоваров();
	НоваяСтрока = Товары.Вставить(0);
	ПодготовитьНовуюСтрокуТоваров(НоваяСтрока, Исходная);
	ВставленнаяСтрокаТоваров = НоваяСтрока.ПолучитьИдентификатор();
	Элемент.ТекущаяСтрока = ВставленнаяСтрокаТоваров;
	// Ввод начинается после выхода из обработчика: внутри него платформа ещё завершает отменённое добавление.
	ЗадержкаСекунд = 0.1;
	ПодключитьОбработчикОжидания("НачатьВводВставленнойСтрокиТоваров", ЗадержкаСекунд, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередНачаломИзменения(Элемент, Отказ)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаТаблицы.ТолькоПросмотр Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Эта строка правится в форме документа.';
			|fr = 'Cette ligne se modifie dans le formulaire du document.';
			|en = 'This line is edited in the document form.'; es = 'Esta línea se edita en el formulario del documento.'"));
		Возврат;
	КонецЕсли;
	// Документ, клиент, организация, товар, характеристика и упаковка записанной строки предложения не меняются (план,
	// правило 6: ключ сопоставления цен строки): другой товар, характеристика или упаковка - новой строкой.
	УстановитьПравкуШапкиСтрокиТоваров(СтрокаТаблицы.НомерСтроки = 0);

КонецПроцедуры

// Параметры:
//  Элемент     - ТаблицаФормы - таблица «Товары».
//  НоваяСтрока - Булево - строка добавлена платформой: форма добавляет строки сама (ПередНачаломДобавления).
//  Копирование - Булево - не используется.
//
&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	СтрокаВводится = Истина;
	Если НоваяСтрока И Элемент.ТекущиеДанные <> Неопределено Тогда
		ПодготовитьНовуюСтрокуТоваров(Элемент.ТекущиеДанные, Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	Если Не МожноВводитьТовары Тогда
		Возврат;
	КонецЕсли;
	Строки = Новый Массив;
	Незаписанные = Новый Массив;
	ДокументыСПравками = ДокументыСНезаписаннымиПравками();
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.ТолькоПросмотр Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаТаблицы.НомерСтроки = 0 Тогда
			Незаписанные.Добавить(СтрокаТаблицы);
		ИначеЕсли ДокументыСПравками.Найти(СтрокаТаблицы.Документ) <> Неопределено Тогда
			// Своё удаление перенумеровало бы строки, и незаписанные правки документа потерялись бы.
			Шаблон = НСтр("ru = 'Сначала исправьте или отмените («Обновить») незаписанные правки предложения %1.';
				|fr = 'Corrigez ou annulez d''abord (« Actualiser ») les modifications non enregistrées du devis %1.';
				|en = 'First fix or cancel (Refresh) the unsaved changes of quotation %1.';
				|es = 'Primero corrija o cancele («Actualizar») los cambios no guardados del presupuesto %1.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, СтрокаТаблицы.ДокументПредставление));
		Иначе
			ДанныеУдаления = Новый Структура("Документ, НомерСтроки, ВерсияДанных");
			ЗаполнитьЗначенияСвойств(ДанныеУдаления, СтрокаТаблицы);
			Строки.Добавить(ДанныеУдаления);
		КонецЕсли;
	КонецЦикла;
	// Незаписанная новая строка удаляется только из таблицы: в базе её нет.
	Для Каждого СтрокаТаблицы Из Незаписанные Цикл
		Назначенная = СтрокиТоваровКЗаписи.НайтиПоЗначению(СтрокаТаблицы.ПолучитьИдентификатор());
		Если Назначенная <> Неопределено Тогда
			СтрокиТоваровКЗаписи.Удалить(Назначенная);
		КонецЕсли;
		Товары.Удалить(СтрокаТаблицы);
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Удалить строки предложений (%1)? Предложение без строк будет помечено на удаление.';
		|fr = 'Supprimer les lignes des devis (%1) ? Un devis sans lignes sera marqué pour suppression.';
		|en = 'Delete the quotation lines (%1)? A quotation without lines will be marked for deletion.';
		|es = '¿Eliminar las líneas de presupuestos (%1)? Un presupuesto sin líneas se marcará para eliminar.'");
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдаленииТоваров", ЭтотОбъект, Строки);
	ПоказатьВопрос(Оповещение, СтрШаблон(Шаблон, Строки.Количество()), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

// Запись строки назначается в очередь СтрокиТоваровКЗаписи и выполняется обработчиком ожидания, а не в самом событии:
// правка могла закончиться выбором из выпадающего списка, а серверный вызов, пока список закрывается, роняет клиент 8.5
// (урок рабочего места закупок 2.0.16.106). Отмена ввода вставленной незаписанной строки её удаляет.
//
// Параметры:
//  Элемент              - ТаблицаФормы - таблица «Товары».
//  НоваяСтрока          - Булево - строка добавлена.
//  ОтменаРедактирования - Булево - правка отменена.
//
&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	СтрокаВводится = Ложь;
	Идентификатор = Элемент.ТекущаяСтрока;
	Вставлена = ВставленнаяСтрокаТоваров <> Неопределено И Идентификатор = ВставленнаяСтрокаТоваров;
	Если Вставлена Тогда
		ВставленнаяСтрокаТоваров = Неопределено;
	КонецЕсли;
	Если Идентификатор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
	Если ОтменаРедактирования Тогда
		Если Вставлена И СтрокаТаблицы <> Неопределено И СтрокаТаблицы.НомерСтроки = 0 Тогда
			Товары.Удалить(СтрокаТаблицы);
		КонецЕсли;
	ИначеЕсли СтрокаТаблицы <> Неопределено Тогда
		// Правка живёт в таблице до успешной записи: перечитывание её не стирает.
		СтрокаТаблицы.Изменена = Истина;
		Если СтрокиТоваровКЗаписи.НайтиПоЗначению(Идентификатор) = Неопределено Тогда
			СтрокиТоваровКЗаписи.Добавить(Идентификатор);
		КонецЕсли;
	Иначе
		// Строку уже убрало перечитывание.
		Возврат;
	КонецЕсли;
	Если СтрокиТоваровКЗаписи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ЗадержкаСекунд = 0.1;
	ОтключитьОбработчикОжидания("ЗаписатьСтрокиТоваровОжидание");
	ПодключитьОбработчикОжидания("ЗаписатьСтрокиТоваровОжидание", ЗадержкаСекунд, Истина);

КонецПроцедуры

// Документ строки: «Новое предложение» или сегодняшнее предложение клиента строки в её организации.
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «Документ».
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - отключается.
//
&НаКлиенте
Процедура ТоварыДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.НомерСтроки <> 0 Тогда
		Возврат;
	КонецЕсли;
	ВариантыДокументов = ДокументыДляСтрокиТоваров(СтрокаТаблицы.Клиент, СтрокаТаблицы.Организация);
	ВариантыДокументов.Вставить(0, Неопределено, ПредставлениеНовогоПредложения());
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораДокументаСтрокиТоваров", ЭтотОбъект, Элементы.Товары.ТекущаяСтрока);
	ПоказатьВыборИзСписка(Оповещение, ВариантыДокументов, Элемент);

КонецПроцедуры

// Параметры:
//  ВыбранныйЭлемент - ЭлементСпискаЗначений, Неопределено - документ; Неопределено - выбор отменён.
//  Идентификатор    - Число - идентификатор строки.
//
&НаКлиенте
Процедура ПослеВыбораДокументаСтрокиТоваров(ВыбранныйЭлемент, Идентификатор) Экспорт

	СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
	Если ВыбранныйЭлемент = Неопределено Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Документ = ВыбранныйЭлемент.Значение;
	СтрокаТаблицы.ДокументПредставление = ВыбранныйЭлемент.Представление;
	СтрокаТаблицы.ЦенаИзменена = Ложь;
	Если ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
		// Клиент, организация и валюта - предложения: цена вводится в его валюте.
		Шапка = ШапкаДокументаСтрокиТоваров(СтрокаТаблицы.Документ);
		Если Шапка <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Шапка);
		КонецЕсли;
	Иначе
		ОбновитьВалютуНовойСтроки(СтрокаТаблицы);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыКлиентПриИзменении(Элемент)

	СброситьДокументНовойСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыОрганизацияПриИзменении(Элемент)

	СброситьДокументНовойСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Характеристика и упаковка прежнего товара для нового недействительны; ручная цена относилась к прежнему товару.
	СтрокаТаблицы.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	СтрокаТаблицы.Упаковка = ЕдиницаТовара(СтрокаТаблицы.Номенклатура);
	СтрокаТаблицы.ЦенаИзменена = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыХарактеристикаПриИзменении(Элемент)

	СброситьРучнуюЦену();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыУпаковкаПриИзменении(Элемент)

	// Ручная цена относилась к прежней упаковке: цену подставит прайс для новой.
	СброситьРучнуюЦену();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы <> Неопределено Тогда
		СтрокаТаблицы.ЦенаИзменена = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СортироватьПоВозрастанию(Команда)
	СортироватьПоТекущейКолонке(Ложь);
