#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПрименитьОтборы();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПрименитьСостояниеПанели();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	ПрименитьОтборы();
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	// BSLLS:MagicNumber-off - треть секунды исключает лишние серверные вызовы при листании.
	ПодключитьОбработчикОжидания("ОбновитьСведенияОКлиенте", 0.3, Истина);
	// BSLLS:MagicNumber-on
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСведенияОКлиенте()
	Ссылка = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.КоммерческоеПредложение") Тогда
		ЗаполнитьСведения(Ссылка);
	Иначе
		КлиентТекст = "";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СвернутьПанель(Команда)
	ПанельСвернута = Истина;
	ПрименитьСостояниеПанели();
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьПанель(Команда)
	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФильтры(Команда)
	ОткрытьСтраницуПанели("СтраницаФильтры");
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКлиента(Команда)
	ОткрытьСтраницуПанели("СтраницаКлиент");
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаказ(Команда)
	Предложение = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(Предложение) <> Тип("ДокументСсылка.КоммерческоеПредложение") Тогда
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("Основание", Предложение);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияЗаказа", ЭтотОбъект);
	ОткрытьФорму("Документ.ЗаказПокупателя.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияЗаказа(Результат, ДополнительныеПараметры) Экспорт
	Элементы.Список.Обновить();
	ОбновитьСведенияОКлиенте();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрименитьСостояниеПанели()
	Элементы.ГруппаПанельЗначки.Видимость = ПанельСвернута;
	Элементы.ГруппаПодвалПанели.Видимость = Не ПанельСвернута;
	Элементы.ГруппаСтраницыСведений.Видимость = Не ПанельСвернута;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтраницуПанели(ИмяСтраницы)
	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();
	Элементы.ГруппаСтраницыСведений.ТекущаяСтраница = Элементы[ИмяСтраницы];
КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборы()
	УстановитьОтборПоПолю("Контрагент", ОтборКонтрагент);
	УстановитьОтборПоПолю("Организация", ОтборОрганизация);
	УстановитьОтборПоПолю("Ответственный", ОтборОтветственный);
	УстановитьОтборПоПолю("Менеджер", ОтборМенеджер);
	УстановитьОтборПоПолю("Договор", ОтборДоговор);
	УстановитьОтборПоПолю("ДатаОтгрузки", ОтборДатаОтгрузки);
	УстановитьОтборПоПолю("Сумма", ОтборСумма, ВидСравненияУсловия(ОтборСуммаУсловие));
	УстановитьОтборПоПолю("Статус", ЗначениеФильтраСтатуса());
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоПолю(ИмяПоля, Значение, ВидСравнения = Неопределено)
	ЭлементОтбора = Список.КомпоновщикНастроек.Настройки.Отбор.Элементы.Найти(ИмяПоля);
	Если ЭлементОтбора = Неопределено Тогда
		ЭлементОтбора = Список.КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЕсли;
	ЭлементОтбора.Использование = ЗначениеЗаполнено(Значение);
	Если ЭлементОтбора.Использование Тогда
		ЭлементОтбора.ПравоеЗначение = Значение;
		Если ВидСравнения <> Неопределено Тогда
			ЭлементОтбора.ВидСравнения = ВидСравнения;
		Иначе
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Статус, соответствующий выбранной позиции переключателя.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СтатусыКоммерческихПредложений, Неопределено - значение отбора
//
&НаСервере
// BSLLS:MagicNumber-off - позиции соответствуют вариантам переключателя статуса в форме.
Функция ЗначениеФильтраСтатуса()
	Если ФильтрСтатуса = 1 Тогда
		Возврат Перечисления.СтатусыКоммерческихПредложений.Черновик;
	КонецЕсли;
	Если ФильтрСтатуса = 2 Тогда
		Возврат Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	КонецЕсли;
	Если ФильтрСтатуса = 3 Тогда
		Возврат Перечисления.СтатусыКоммерческихПредложений.Доставлен;
	КонецЕсли;
	Если ФильтрСтатуса = 4 Тогда
		Возврат Перечисления.СтатусыКоммерческихПредложений.Проигран;
	КонецЕсли;
	Если ФильтрСтатуса = 5 Тогда
		Возврат Перечисления.СтатусыКоммерческихПредложений.Выигран;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции
// BSLLS:MagicNumber-on

// Вид сравнения суммы по выбранной позиции переключателя.
//
// Параметры:
//  Позиция - Число - позиция переключателя сравнения
//
// Возвращаемое значение:
//  ВидСравненияКомпоновкиДанных - условие отбора суммы
//
&НаСервереБезКонтекста
// BSLLS:MagicNumber-off - позиции соответствуют вариантам переключателя сравнения в форме.
Функция ВидСравненияУсловия(Позиция)
	Если Позиция = 1 Тогда
		Возврат ВидСравненияКомпоновкиДанных.Меньше;
	КонецЕсли;
	Если Позиция = 2 Тогда
		Возврат ВидСравненияКомпоновкиДанных.Равно;
	КонецЕсли;
	Возврат ВидСравненияКомпоновкиДанных.Больше;
КонецФункции
// BSLLS:MagicNumber-on

&НаСервере
Процедура ЗаполнитьСведения(Знач Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка.Контрагент) Тогда
		КлиентТекст = "";
		Возврат;
	КонецЕсли;
	Карточка = Справочники.Контрагенты.ПолучитьКарточку(Ссылка.Контрагент, Ссылка.Дата);
	Строки = Новый Массив;
	Строки.Добавить(Карточка.Наименование);
	Если ЗначениеЗаполнено(Карточка.Реквизиты.ICE) Тогда
		Строки.Добавить("ICE: " + Карточка.Реквизиты.ICE);
	КонецЕсли;
	Если ЗначениеЗаполнено(Карточка.АдресЮридический) Тогда
		Строки.Добавить(Карточка.АдресЮридический);
	КонецЕсли;
	Если ЗначениеЗаполнено(Карточка.Телефоны) Тогда
		Строки.Добавить(Карточка.Телефоны);
	КонецЕсли;
	КлиентТекст = СтрСоединить(Строки, Символы.ПС);
КонецПроцедуры
#КонецОбласти
