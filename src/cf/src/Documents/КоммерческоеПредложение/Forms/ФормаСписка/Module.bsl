КонецПроцедуры

// «Обновить» закладки «Товары»: незаписанные правки отбрасываются только с согласия пользователя.
//
// Параметры:
//  Команда - КомандаФормы - команда.
//
&НаКлиенте
Процедура ТоварыОбновить(Команда)

	Если СтрокаВводится Тогда
		Элементы.Товары.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	Число = ЧислоНезаписанныхСтрок();
	Если Число = 0 Тогда
		ЗагрузитьТоварыНаСервере();
		Возврат;
	КонецЕсли;
	// На время вопроса отложенная запись не идёт: иначе она сохранила бы отменяемые правки.
	ОтключитьОбработчикОжидания("ЗаписатьСтрокиТоваровОжидание");
	Шаблон = НСтр("ru = 'Отменить незаписанные правки строк (%1)?'; fr = 'Annuler les modifications non enregistrées des lignes (%1) ?';
		|en = 'Cancel the unsaved line changes (%1)?'; es = '¿Cancelar los cambios de líneas sin guardar (%1)?'");
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбОтменеПравок", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, СтрШаблон(Шаблон, Число), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

// «Печать» закладки «Товары»: печатная форма предложений выделенных записанных строк, каждого - целиком. Команды созданы в
// РазместитьКомандыПечатиТоваров.
//
// Параметры:
//  Команда - КомандаФормы - команда печатной формы.
//
&НаКлиенте
Процедура Подключаемый_ПечатьТоваров(Команда)

	Если СтрокаВводится Тогда
		Элементы.Товары.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	ОписаниеКоманды = Неопределено;
	Для Каждого Элемент Из КомандыПечатиТоваров Цикл
		Если Элемент.Представление = Команда.Имя Тогда
			ОписаниеКоманды = Элемент;
		КонецЕсли;
	КонецЦикла;
	Выделенные = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Товары.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы <> Неопределено И ЗначениеЗаполнено(СтрокаТаблицы.Документ)
			И Выделенные.Найти(СтрокаТаблицы.Документ) = Неопределено Тогда
			Выделенные.Добавить(СтрокаТаблицы.Документ);
		КонецЕсли;
	КонецЦикла;
	Если ОписаниеКоманды = Неопределено Или Выделенные.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выделите строки записанных предложений.';
			|fr = 'Sélectionnez des lignes de devis enregistrés.'; en = 'Select lines of saved quotations.';
			|es = 'Seleccione líneas de presupuestos guardados.'"));
		Возврат;
	КонецЕсли;
	КПечати = ДокументыКПечатиНаСервере(Выделенные);
	Если КПечати.Количество() > 0 Тогда
		ПечатныеФормыКлиент.ВыполнитьКомандуПечати(ПолноеИмяДокумента(), ОписаниеКоманды.Значение, КПечати, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СвернутьПанель(Команда)
	ПанельСвернута = Истина;
	ПрименитьСостояниеПанели();
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьПанель(Команда)
	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФильтры(Команда)
	ОткрытьСтраницуПанели("СтраницаФильтры");
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКлиента(Команда)
