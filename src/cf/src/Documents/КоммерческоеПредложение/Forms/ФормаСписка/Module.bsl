#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПрименитьОтборы();
	Элементы.КнопкаСоздатьЗаказНаПроизводство.Видимость = ПолучитьФункциональнуюОпцию("Производство");
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПрименитьСостояниеПанели();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	ПрименитьОтборы();
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	// BSLLS:MagicNumber-off - треть секунды исключает лишние серверные вызовы при листании.
	ПодключитьОбработчикОжидания("ОбновитьСведенияОКлиенте", 0.3, Истина);
	// BSLLS:MagicNumber-on
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСведенияОКлиенте()
	Ссылка = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.КоммерческоеПредложение") Тогда
		ЗаполнитьСведения(Ссылка);
	Иначе
		КлиентТекст = "";
		ИнфоТекст = "";
		ТаблицаСостав.Очистить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СвернутьПанель(Команда)
	ПанельСвернута = Истина;
	ПрименитьСостояниеПанели();
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьПанель(Команда)
	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФильтры(Команда)
	ОткрытьСтраницуПанели("СтраницаФильтры");
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКлиента(Команда)
	ОткрытьСтраницуПанели("СтраницаКлиент");
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДетали(Команда)
	ОткрытьСтраницуПанели("СтраницаИнфо");
КонецПроцедуры

// Заказ клиента - продажа, заказ на производство - с видом операции «Производство» (решение владельца 2026-09-14).
&НаКлиенте
Процедура СоздатьЗаказ(Команда)
	СоздатьЗаказПоПредложению(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаказНаПроизводство(Команда)
	СоздатьЗаказПоПредложению(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаказПоПредложению(НаПроизводство)
	Предложение = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(Предложение) <> Тип("ДокументСсылка.КоммерческоеПредложение") Тогда
		Возврат;
	КонецЕсли;
	Основание = Новый Структура("Предложение, НаПроизводство", Предложение, НаПроизводство);
	ПараметрыФормы = Новый Структура("Основание", Основание);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияЗаказа", ЭтотОбъект);
	ОткрытьФорму("Документ.ЗаказПокупателя.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияЗаказа(Результат, ДополнительныеПараметры) Экспорт
	Элементы.Список.Обновить();
	ОбновитьСведенияОКлиенте();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрименитьСостояниеПанели()
	Элементы.ГруппаПанельЗначки.Видимость = ПанельСвернута;
	Элементы.ГруппаПодвалПанели.Видимость = Не ПанельСвернута;
	Элементы.ГруппаСтраницыСведений.Видимость = Не ПанельСвернута;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтраницуПанели(ИмяСтраницы)
	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();
	Элементы.ГруппаСтраницыСведений.ТекущаяСтраница = Элементы[ИмяСтраницы];
КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборы()
	УстановитьОтборПоПолю("Контрагент", ОтборКонтрагент);
	УстановитьОтборПоПолю("Организация", ОтборОрганизация);
	УстановитьОтборПоПолю("Ответственный", ОтборОтветственный);
	УстановитьОтборПоПолю("Менеджер", ОтборМенеджер);
	УстановитьОтборПоПолю("Договор", ОтборДоговор);
	УстановитьОтборПоПолю("ДатаОтгрузки", ОтборДатаОтгрузки);
	УстановитьОтборПоПолю("Сумма", ОтборСумма, ВидСравненияУсловия(ОтборСуммаУсловие));
	УстановитьОтборПоПолю("Статус", ЗначениеФильтраСтатуса());

	ОтборыСписков.УстановитьОтборПоТовару(Список, ОтборТовар);

КонецПроцедуры

// Один программный элемент отбора списка в группе «Панель» (ОтборыСписков): пустое значение снимает отбор.
//
// Параметры:
//  Поле         - Строка - поле динамического списка.
//  Значение     - Произвольный - значение отбора; пустое значение выключает отбор.
//  ВидСравнения - ВидСравненияКомпоновкиДанных, Неопределено - вид сравнения, по умолчанию «Равно».
//
&НаСервере
Процедура УстановитьОтборПоПолю(Поле, Значение, ВидСравнения = Неопределено)

	// Общий модуль: элемент поля - в группе «Панель», пустое значение снимает отбор (docs/plans/nomenclature-ui.md, P2-3).
	ОтборыСписков.УстановитьОтборЕслиЗаполнено(Список.Отбор, ОтборыСписков.ГруппаПанель(), Поле, Значение, ВидСравнения);

КонецПроцедуры

// Статус, соответствующий выбранной позиции переключателя.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СтатусыКоммерческихПредложений, Неопределено - значение отбора
//
&НаСервере
// BSLLS:MagicNumber-off - позиции соответствуют вариантам переключателя статуса в форме.
Функция ЗначениеФильтраСтатуса()
	Если ФильтрСтатуса = 1 Тогда
		Возврат Перечисления.СтатусыКоммерческихПредложений.Черновик;
	КонецЕсли;
	Если ФильтрСтатуса = 2 Тогда
		Возврат Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	КонецЕсли;
	Если ФильтрСтатуса = 3 Тогда
		Возврат Перечисления.СтатусыКоммерческихПредложений.Доставлен;
	КонецЕсли;
	Если ФильтрСтатуса = 4 Тогда
		Возврат Перечисления.СтатусыКоммерческихПредложений.Проигран;
	КонецЕсли;
	Если ФильтрСтатуса = 5 Тогда
		Возврат Перечисления.СтатусыКоммерческихПредложений.Выигран;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции
// BSLLS:MagicNumber-on

// Вид сравнения суммы по выбранной позиции переключателя.
//
// Параметры:
//  Позиция - Число - позиция переключателя сравнения
//
// Возвращаемое значение:
//  ВидСравненияКомпоновкиДанных - условие отбора суммы
//
&НаСервереБезКонтекста
// BSLLS:MagicNumber-off - позиции соответствуют вариантам переключателя сравнения в форме.
Функция ВидСравненияУсловия(Позиция)
	Если Позиция = 1 Тогда
		Возврат ВидСравненияКомпоновкиДанных.Меньше;
	КонецЕсли;
	Если Позиция = 2 Тогда
		Возврат ВидСравненияКомпоновкиДанных.Равно;
	КонецЕсли;
	Возврат ВидСравненияКомпоновкиДанных.Больше;
КонецФункции
// BSLLS:MagicNumber-on

// Правая панель: карточка клиента, реквизиты и состав предложения текущей строки.
//
// Параметры:
//  Ссылка - ДокументСсылка.КоммерческоеПредложение - текущая строка списка
//
&НаСервере
Процедура ЗаполнитьСведения(Знач Ссылка)
	ЗаполнитьДетали(Ссылка);
	ЗаполнитьКлиента(Ссылка);
КонецПроцедуры

// Страница «Детали»: реквизиты, не выведенные колонками списка, и состав по товарам.
//
// Параметры:
//  Ссылка - ДокументСсылка.КоммерческоеПредложение - текущая строка списка
//
&НаСервере
Процедура ЗаполнитьДетали(Знач Ссылка)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Док.Организация КАК Организация,
		|	Док.Ответственный КАК Ответственный,
		|	Док.Менеджер КАК Менеджер,
		|	Док.Комментарий КАК Комментарий,
		|	Док.Сумма КАК Сумма
		|ИЗ
		|	Документ.КоммерческоеПредложение КАК Док
		|ГДЕ
		|	Док.Ссылка = &Ссылка
		|;
		|ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	СУММА(Товары.Количество) КАК Количество,
		|	СУММА(Товары.СуммаСНДС) КАК Сумма
		|ИЗ
		|	Документ.КоммерческоеПредложение.ТЧТовары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	Товары.Номенклатура");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результаты = Запрос.ВыполнитьПакет();

	ИнфоТекст = "";
	ТаблицаСостав.Очистить();
	Шапка = Результаты[0].Выбрать();
	Если Не Шапка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	Строки = Новый Массив;
	Если ЗначениеЗаполнено(Шапка.Организация) Тогда
		Шаблон = НСтр("ru = 'Наша компания: %1'; fr = 'Notre société: %1'; en = 'Our company: %1'; es = 'Nuestra empresa: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.Организация)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Ответственный) Тогда
		Шаблон = НСтр("ru = 'Ответственный: %1'; fr = 'Responsable: %1'; en = 'Responsible: %1'; es = 'Responsable: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.Ответственный)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Менеджер) Тогда
		Шаблон = НСтр("ru = 'Менеджер: %1'; fr = 'Manager: %1'; en = 'Manager: %1'; es = 'Gerente: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.Менеджер)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Комментарий) Тогда
		Строки.Добавить("");
		Строки.Добавить(Шапка.Комментарий);
	КонецЕсли;
	Строки.Добавить("");
	ШаблонСуммы = НСтр("ru = 'Сумма: %1'; fr = 'Montant : %1'; en = 'Amount: %1'; es = 'Importe: %1'");
	Строки.Добавить(СтрШаблон(ШаблонСуммы, Формат(Шапка.Сумма, "ЧДЦ=2; ЧРГ=' '")));
	ИнфоТекст = СтрСоединить(Строки, Символы.ПС);

	Состав = Результаты[1].Выбрать();
	Пока Состав.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаСостав.Добавить(), Состав);
	КонецЦикла;
КонецПроцедуры

// Страница «Клиент»: карточка контрагента на дату предложения.
//
// Параметры:
//  Ссылка - ДокументСсылка.КоммерческоеПредложение - текущая строка списка
//
&НаСервере
Процедура ЗаполнитьКлиента(Знач Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка.Контрагент) Тогда
		КлиентТекст = "";
		Возврат;
	КонецЕсли;
	Карточка = Справочники.Контрагенты.ПолучитьКарточку(Ссылка.Контрагент, Ссылка.Дата);
	Строки = Новый Массив;
	Строки.Добавить(Карточка.Наименование);
	Если ЗначениеЗаполнено(Карточка.Реквизиты.ICE) Тогда
		Строки.Добавить("ICE: " + Карточка.Реквизиты.ICE);
	КонецЕсли;
	Если ЗначениеЗаполнено(Карточка.АдресЮридический) Тогда
		Строки.Добавить(Карточка.АдресЮридический);
	КонецЕсли;
	Если ЗначениеЗаполнено(Карточка.Телефоны) Тогда
		Строки.Добавить(Карточка.Телефоны);
	КонецЕсли;
	КлиентТекст = СтрСоединить(Строки, Символы.ПС);
КонецПроцедуры
#КонецОбласти
