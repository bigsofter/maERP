// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар.
//
// Возвращаемое значение:
//  СправочникСсылка.УпаковкиЕдиницыИзмерения - единица товара; пустая - товар не задан.
//
&НаСервереБезКонтекста
Функция ЕдиницаТовара(Знач Номенклатура)

	Если ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Или Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Единица");

КонецФункции

&НаСервереБезКонтекста
Процедура СообщитьРезультат(Текст)

	Если Не ПустаяСтрока(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  ИмяТаблицы - Строка - таблица формы.
//  ИмяПоля    - Строка - поле таблицы под курсором.
//  Убывание   - Булево - по убыванию.
//
// Возвращаемое значение:
//  Булево - см. СортировкаТаблицФормы.УстановитьПорядок.
//
&НаСервере
Функция УстановитьПорядокТаблицы(Знач ИмяТаблицы, Знач ИмяПоля, Знач Убывание)

	Возврат СортировкаТаблицФормы.УстановитьПорядок(ЭтотОбъект, ИмяТаблицы, ИмяПоля, Убывание,
		Новый Структура("НомерСтроки", 0));

КонецФункции

// Сортирует таблицу «Товары» по колонке под курсором (у таблиц на значениях нет сортировки кликом по шапке).
//
// Параметры:
//  Убывание - Булево - по убыванию.
//
&НаКлиенте
Процедура СортироватьПоТекущейКолонке(Убывание)

	Таблица = ТекущийЭлемент;
	Если ТипЗнч(Таблица) <> Тип("ТаблицаФормы") Или Таблица.ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не УстановитьПорядокТаблицы(Таблица.Имя, Таблица.ТекущийЭлемент.Имя, Убывание) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'По этой колонке сортировать нельзя.'; fr = 'Impossible de trier selon cette colonne.';
			|en = 'This column cannot be sorted.'; es = 'No se puede ordenar por esta columna.'"));
	КонецЕсли;

КонецПроцедуры

