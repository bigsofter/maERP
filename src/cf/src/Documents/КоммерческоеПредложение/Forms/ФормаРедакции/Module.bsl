#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Отправленная редакция коммерческого предложения - только просмотр: показывается её печатная форма из снимка
	// регистра редакций, то есть ровно то, что ушло клиенту (docs/plans/kp-print-revisions.md).
	// Без явных параметров (открытие по ссылке, смок на образце) - последняя редакция предложения из Ключ.
	Предложение = ?(ЗначениеЗаполнено(Параметры.Предложение), Параметры.Предложение, Параметры.Ключ);
	Версия = Параметры.Версия;
	Если ЗначениеЗаполнено(Предложение) И Не ЗначениеЗаполнено(Версия) Тогда
		Редакции = Документы.КоммерческоеПредложение.СписокРедакций(Предложение);
		Версия = ?(Редакции.Количество() = 0, 0, Редакции[0].Версия);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Предложение) Или Не ЗначениеЗаполнено(Версия) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ПараметрыПечати = Новый Структура("Версия", Версия);
	Результат = ПечатныеФормы.СформироватьПечатныеФормы("Документ.КоммерческоеПредложение", "КоммерческоеПредложение",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Предложение), ПараметрыПечати);
	Для Каждого ПечатнаяФорма Из Результат.КоллекцияПечатныхФорм Цикл
		Если ТипЗнч(ПечатнаяФорма.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
			Документ = ПечатнаяФорма.ТабличныйДокумент;
		КонецЕсли;
	КонецЦикла;
	Документ.ТолькоПросмотр = Истина;
	Элементы.ФормаВернутьРедакцию.Видимость = Параметры.МожноВернуть;
	ШаблонЗаголовка = НСтр("ru = '%1 - редакция v%2 (только просмотр)'; fr = '%1 - révision v%2 (lecture seule)';
		|en = '%1 - revision v%2 (read only)'; es = '%1 - revisión v%2 (solo lectura)'");
	ПредставлениеПредложения = РаботаСДокументами.КраткоеПредставлениеДокумента(Предложение);
	Заголовок = СтрШаблон(ШаблонЗаголовка, ПредставлениеПредложения, Формат(Версия, "ЧГ=0"));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	ПараметрыПечати = Новый Структура("Версия", Версия);
	ПечатныеФормыКлиент.ВыполнитьКомандуПечати("Документ.КоммерческоеПредложение", "КоммерческоеПредложение",
		Предложение, ЭтотОбъект, ПараметрыПечати);
КонецПроцедуры

&НаКлиенте
Процедура ВернутьРедакцию(Команда)
	// Содержимое редакции подставляет в себя форма предложения, открывшая эту форму: результат закрытия.
	Закрыть(Новый Структура("ВернутьВерсию", Версия));
КонецПроцедуры

#КонецОбласти
