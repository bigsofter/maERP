	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Вид,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Предложения.Ссылка КАК Ссылка,
	|	Предложения.Основание КАК Основание,
	|	Предложения.Номер КАК Номер,
	|	Предложения.Дата КАК Дата,
	|	Предложения.ПометкаУдаления КАК ПометкаУдаления,
	|	Предложения.Организация КАК Организация,
	|	Предложения.Контрагент КАК Контрагент,
	|	Предложения.Договор КАК Договор,
	|	Предложения.Менеджер КАК Менеджер,
	|	Предложения.Ответственный КАК Ответственный,
	|	Предложения.ДатаОтгрузки КАК ДатаОтгрузки,
	|	Предложения.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Предложения.ВВалюте КАК ВВалюте,
	|	Предложения.Валюта КАК Валюта,
	|	Предложения.КурсВалюты КАК КурсВалюты,
	|	Предложения.Комментарий КАК Комментарий,
	|	Предложения.Статус КАК Статус,
	|	Предложения.Версия КАК Версия
	|ИЗ
	|	Документ.КоммерческоеПредложение КАК Предложения
	|ГДЕ
	|	Предложения.Ссылка В (&Заблокированные)
	|	И Предложения.Автосинхронизация
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПометкаУдаления,
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Ссылка КАК Ссылка,
	|	Строки.НомерСтроки КАК НомерСтроки,
	|	Строки.КодСтроки КАК КодСтроки,
	|	Строки.Номенклатура КАК Номенклатура,
	|	Строки.НоменклатураСтрока КАК НоменклатураСтрока,
	|	Строки.Характеристика КАК Характеристика,
	|	Строки.Упаковка КАК Упаковка,
	|	Строки.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Строки.Количество КАК Количество,
	|	Строки.ВидЦены КАК ВидЦены,
	|	Строки.ЦенаSKU КАК ЦенаSKU,
	|	Строки.Цена КАК Цена,
	|	Строки.Сумма КАК Сумма,
	|	Строки.ПроцентСкидки КАК ПроцентСкидки,
	|	Строки.СуммаСкидки КАК СуммаСкидки,
	|	Строки.СуммаСНДС КАК СуммаСНДС,
	|	Строки.СтавкаНДС КАК СтавкаНДС,
	|	Строки.СуммаНДС КАК СуммаНДС,
	|	Строки.СкидкаНаЦену КАК СкидкаНаЦену,
	|	Строки.Описание КАК Описание,
	|	Строки.СуммаРегл КАК СуммаРегл
	|ИЗ
	|	Документ.КоммерческоеПредложение.ТЧТовары КАК Строки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КоммерческоеПредложение КАК Предложения
	|		ПО Строки.Ссылка = Предложения.Ссылка
	|ГДЕ
	|	Предложения.Ссылка В (&Заблокированные)
	|	И Предложения.Автосинхронизация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Редакции.Предложение КАК Ссылка
	|ИЗ
	|	РегистрСведений.РедакцииКоммерческихПредложений КАК Редакции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КоммерческоеПредложение КАК Предложения
	|		ПО Редакции.Предложение = Предложения.Ссылка
	|ГДЕ
	|	Предложения.Ссылка В (&Заблокированные)
	|	И Предложения.Автосинхронизация");
	Запрос.УстановитьПараметр("Реализации", Реализации);
	// Только заблокированные КП: появившийся после блокировки (загрузкой обмена) в этот раз не трогается, следующая
	// синхронизация разберёт его как дубль.
	Запрос.УстановитьПараметр("Заблокированные", Заблокированные);
	Пакет = Запрос.ВыполнитьПакет();
	// BSLLS:MagicNumber-off - номера запросов пакета.
	Данные = Новый Структура;
	Данные.Вставить("Реализации", Пакет[0].Выгрузить());
	Данные.Вставить("Строки", Пакет[1].Выгрузить());
	Данные.Вставить("Предложения", Пакет[2].Выгрузить());
	Данные.Вставить("СтрокиПредложений", Пакет[3].Выгрузить());
	Данные.Вставить("СРедакциями", Пакет[4].Выгрузить().ВыгрузитьКолонку(ПолеСсылки()));
	// BSLLS:MagicNumber-on
	Данные.Реализации.Индексы.Добавить(ПолеСсылки());
	Данные.Строки.Индексы.Добавить(ПолеСсылки());
	Данные.Предложения.Индексы.Добавить("Основание");
	Данные.СтрокиПредложений.Индексы.Добавить(ПолеСсылки());
	Возврат Данные;
КонецФункции

Функция СинхронизироватьПредложение(Реализация, Данные)
	Отбор = Новый Структура(ПолеСсылки(), Реализация);
	НайденныеРеализации = Данные.Реализации.НайтиСтроки(Отбор);
	// Удалённой реализации в базе нет - синхронизировать нечего.
	Если НайденныеРеализации.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Желаемое = СодержимоеАвтоКП(НайденныеРеализации[0], Данные.Строки.НайтиСтроки(Отбор));

	// Отправленный или имеющий редакции КП (например, пришедший загрузкой обмена, где ПередЗаписью не работает) не
	// перезаписывается: он передаётся человеку без изменения данных - до заполнения объекта (9.5 п. 4). Редакции -
	// по регистру, источнику истины ОпределитьРедакцию: реквизит Версия после обмена может с ним расходиться.
	Предложения = Новый Массив;
	Для Каждого Найденное Из Данные.Предложения.НайтиСтроки(Новый Структура("Основание", Реализация)) Цикл
		Если СтатусОтправлен(Найденное.Статус) Или Найденное.Версия > 0
			Или Данные.СРедакциями.Найти(Найденное.Ссылка) <> Неопределено Тогда
			СнятьАвтосинхронизацию(Найденное.Ссылка, Реализация, ПричинаОтправлен());
		Иначе
			Предложения.Добавить(Найденное);
		КонецЕсли;
	КонецЦикла;

	Если Предложения.Количество() = 0 Тогда
		Предложение = Документы.КоммерческоеПредложение.СоздатьДокумент();
		ЗаписатьАвтоКП(Предложение, Реализация, Желаемое);
		Возврат Предложение.Ссылка;
	КонецЕсли;

	// Дубли прошлых сбоев: актуален первый в порядке запроса (не помеченный, затем по ссылке), остальные
	// передаются человеку - флаг снимается, факт - в журнал регистрации.
	Актуальный = Предложения[0];
	Для Индекс = 1 По Предложения.ВГраница() Цикл
		СнятьАвтосинхронизацию(Предложения[Индекс].Ссылка, Реализация, ПричинаДубль(Актуальный.Ссылка));
	КонецЦикла;

	Текущее = СодержимоеЗаписанногоАвтоКП(Актуальный,
		Данные.СтрокиПредложений.НайтиСтроки(Новый Структура(ПолеСсылки(), Актуальный.Ссылка)));
	Если ОтпечатокСодержимого(Текущее) <> ОтпечатокСодержимого(Желаемое) Тогда
		ЗаписатьАвтоКП(Актуальный.Ссылка.ПолучитьОбъект(), Реализация, Желаемое);
	КонецЕсли;
	Возврат Актуальный.Ссылка;
КонецФункции

// Содержимое авто-КП по данным реализации (соответствие колонок - docs/plans/branded-print.md, 9.6). Значения
// приведены к типам реквизитов КП: сравнение с записанным КП не даёт ложных отличий.
//
// Параметры:
//  Шапка  - СтрокаТаблицыЗначений - шапка реализации, см. ДанныеСинхронизации.
//  Строки - Массив из СтрокаТаблицыЗначений - строки товаров и услуг реализации.
//
// Возвращаемое значение:
//  Структура - Шапка (Структура), Товары (Массив из Структура).
//
Функция СодержимоеАвтоКП(Шапка, Строки)
	МетаданныеКП = Метаданные.Документы.КоммерческоеПредложение;
	Реквизиты = Новый Структура(РеквизитыШапкиАвтоКП());
	ЗаполнитьЗначенияСвойств(Реквизиты, Шапка);
	Реквизиты.ДатаОтгрузки = НачалоДня(Шапка.Дата);
	Реквизиты.Статус = Перечисления.СтатусыКоммерческихПредложений.Черновик;
	// Номер КП фиксированной длины дополняется пробелами, номер реализации - переменной длины: сравнивается без них.
	Реквизиты.Номер = СокрЛП(Шапка.Номер);
	// Та же нормализация валюты, что при записи КП: иначе сравнение видело бы отличие там, где запись его сотрёт.
	РаботаСВалютами.ПроверитьВалютуДокумента(Реквизиты);
	Для Каждого КлючИЗначение Из Реквизиты Цикл
		Реквизиты[КлючИЗначение.Ключ] = ПривестиКТипу(МетаданныеКП, КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

	МетаданныеТоваров = МетаданныеКП.ТабличныеЧасти.ТЧТовары;
	КодСтроки = 0;
	Для Каждого СтрокаРеализации Из Строки Цикл
		Если СтрокаРеализации.Вид = 0 Тогда
			КодСтроки = Макс(КодСтроки, СтрокаРеализации.КодСтроки);
		КонецЕсли;
	КонецЦикла;
	Товары = Новый Массив;
	Для Каждого СтрокаРеализации Из Строки Цикл
		Товар = Новый Структура(КолонкиТоваровАвтоКП());
		ЗаполнитьЗначенияСвойств(Товар, СтрокаРеализации);
		ОписаниеКарточки = ?(СтрокаРеализации.ВыводитьНаПечатьОписание = Истина,
			СтрокаРеализации.ОписаниеКарточки, "");
		Если СтрокаРеализации.Вид = 0 Тогда
			Товар.Описание = ОписаниеКарточки;
			// КП печатает количество упаковок; у строки без упаковки оно - количество (исторические строки - ноль).
			Если Не ЗначениеЗаполнено(СтрокаРеализации.Упаковка) Тогда
				Товар.КоличествоУпаковок = СтрокаРеализации.Количество;
			КонецЕсли;
		Иначе
			// Услуга: содержание - описанием строки, как акт печатает его рядом с наименованием; номер строки - после
			// товаров.
			КодСтроки = КодСтроки + 1;
			Товар.КодСтроки = КодСтроки;
			// Оба текста, как их выводит акт: содержание услуги и описание карточки для печати.
			Описание = СокрЛП(СтрокаРеализации.Содержание);
			ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Описание, СокрЛП(ОписаниеКарточки), Символы.ПС);
			Товар.Описание = Описание;
		КонецЕсли;
		Для Каждого КлючИЗначение Из Товар Цикл
			Товар[КлючИЗначение.Ключ] = ПривестиКТипу(МетаданныеТоваров, КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Товары.Добавить(Товар);
	КонецЦикла;
	Возврат Новый Структура("Шапка, Товары", Реквизиты, Товары);
КонецФункции

Функция СодержимоеЗаписанногоАвтоКП(Шапка, Строки)
	Реквизиты = Новый Структура(РеквизитыШапкиАвтоКП());
	ЗаполнитьЗначенияСвойств(Реквизиты, Шапка);
	Реквизиты.Номер = СокрЛП(Шапка.Номер);
	Товары = Новый Массив;
	Для Каждого СтрокаПредложения Из Строки Цикл
		Товар = Новый Структура(КолонкиТоваровАвтоКП());
		ЗаполнитьЗначенияСвойств(Товар, СтрокаПредложения);
		Товары.Добавить(Товар);
	КонецЦикла;
	Возврат Новый Структура("Шапка, Товары", Реквизиты, Товары);
КонецФункции

Функция ОтпечатокСодержимого(Содержимое)
	Значения = Новый Массив;
	Для Каждого Имя Из СтрРазделить(РеквизитыШапкиАвтоКП(), ", ", Ложь) Цикл
		Значения.Добавить(Содержимое.Шапка[Имя]);
	КонецЦикла;
	// СуммаРегл пересчитывает запись КП из суммы и курса, которые сравниваются и так.
	Колонки = СтрРазделить(КолонкиТоваровАвтоКП(), ", ", Ложь);
	Колонки.Удалить(Колонки.Найти("СуммаРегл"));
	Для Каждого Товар Из Содержимое.Товары Цикл
		Для Каждого Имя Из Колонки Цикл
			Значения.Добавить(Товар[Имя]);
		КонецЦикла;
	КонецЦикла;
	Возврат ЗначениеВСтрокуВнутр(Значения);
КонецФункции

Процедура ЗаписатьАвтоКП(Предложение, Реализация, Содержимое)
	ЗаполнитьЗначенияСвойств(Предложение, Содержимое.Шапка);
	Предложение.Основание = Реализация;
	Предложение.Автосинхронизация = Истина;
	Предложение.ТЧТовары.Очистить();
	Для Каждого Товар Из Содержимое.Товары Цикл
		ЗаполнитьЗначенияСвойств(Предложение.ТЧТовары.Добавить(), Товар);
	КонецЦикла;
	ЗаписатьСинхронизацией(Предложение, Реализация);
КонецПроцедуры

Процедура СнятьАвтосинхронизацию(Ссылка, Реализация, Причина)
	// Меняется только флаг: запись загрузкой не нормализует валюту, не пересчитывает итоги и не пишет редакцию - КП,
	// переданный человеку, остаётся таким, каким его видел клиент (9.5 п. 4). КП заблокирован протоколом.
	Предложение = Ссылка.ПолучитьОбъект();
	Предложение.Автосинхронизация = Ложь;
	Предложение.ОбменДанными.Загрузка = Истина;
	ЗаписатьСинхронизацией(Предложение, Реализация);
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	ШаблонКомментария = НСтр("ru = 'Коммерческое предложение %1 по реализации %2 передано пользователю, автосинхронизация
		|снята: %3'; fr = 'Le devis %1 du bon de livraison %2 est remis à l''utilisateur, synchronisation automatique
		|désactivée : %3'; en = 'Quotation %1 for sales document %2 is handed over to the user, auto-sync is off: %3';
		|es = 'El presupuesto %1 del albarán %2 se entrega al usuario, sincronización automática desactivada: %3'",
		КодЯзыка);
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение,
		Метаданные.Документы.КоммерческоеПредложение, Ссылка, СтрШаблон(ШаблонКомментария, Ссылка, Реализация, Причина));
КонецПроцедуры

Функция ПричинаОтправлен()
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Возврат НСтр("ru = 'предложение отправлено или имеет редакции'; fr = 'le devis est envoyé ou a des révisions';
		|en = 'the quotation is sent or has revisions'; es = 'el presupuesto está enviado o tiene revisiones'", КодЯзыка);
КонецФункции

Функция ПричинаДубль(Актуальный)
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Шаблон = НСтр("ru = 'дубль, синхронизируется %1'; fr = 'doublon, synchronisé : %1'; en = 'duplicate, synced: %1';
		|es = 'duplicado, se sincroniza %1'", КодЯзыка);
	Возврат СтрШаблон(Шаблон, Актуальный);
КонецФункции

Функция БезПовторов(Ссылки)
	Результат = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		Если ЗначениеЗаполнено(Ссылка) И Результат.Найти(Ссылка) = Неопределено Тогда
			Результат.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаписатьСинхронизацией(Предложение, Реализация)
	Предложение.ДополнительныеСвойства.Вставить(КлючСинхронизации(), Истина);
	Попытка
		Предложение.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ШаблонОшибки = НСтр("ru = 'Не удалось записать коммерческое предложение по реализации %1: %2';
			|fr = 'Impossible d''enregistrer le devis du bon de livraison %1 : %2';
			|en = 'Could not save the quotation for sales document %1: %2';
			|es = 'No se pudo guardar el presupuesto del albarán %1: %2'");
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон(ШаблонОшибки, Реализация, ТекстОшибки);
	КонецПопытки;
КонецПроцедуры

Функция ПривестиКТипу(МетаданныеВладельца, Имя, Значение)
	// Стандартные реквизиты (Номер, Дата, ПометкаУдаления) у реализации и КП одного типа - приводить нечего.
	Реквизит = МетаданныеВладельца.Реквизиты.Найти(Имя);
	Если Реквизит = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Реквизит.Тип.ПривестиЗначение(Значение);
КонецФункции

Функция РеквизитыШапкиАвтоКП()
	Возврат "Номер, Дата, ПометкаУдаления, Организация, Контрагент, Договор, Менеджер, Ответственный, ДатаОтгрузки, "
		+ "ЦенаВключаетНДС, ВВалюте, Валюта, КурсВалюты, Комментарий, Статус";
КонецФункции

Функция КолонкиТоваровАвтоКП()
	Возврат "КодСтроки, Номенклатура, НоменклатураСтрока, Характеристика, Упаковка, КоличествоУпаковок, Количество, "
		+ "ВидЦены, ЦенаSKU, Цена, Сумма, ПроцентСкидки, СуммаСкидки, СуммаСНДС, СтавкаНДС, СуммаНДС, СкидкаНаЦену, "
		+ "Описание, СуммаРегл";
КонецФункции

Функция ПолеСсылки()
	Возврат "Ссылка";
КонецФункции

Функция КлючСинхронизации()
	Возврат "СинхронизацияКП";
КонецФункции

Функция ИмяСобытияЖурнала()
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Возврат НСтр("ru = 'Печать.КП из реализации'; fr = 'Impression.Devis du bon de livraison';
		|en = 'Printing.Quotation from sales document'; es = 'Impresión.Presupuesto del albarán'", КодЯзыка);
КонецФункции

#КонецОбласти

Функция ХешПоСоставу(Содержимое, СоставШапки)
	Значения = Новый Массив;
	Для Каждого Имя Из СтрРазделить(РеквизитыШапкиРедакции(), ", ", Ложь) Цикл
		Если СоставШапки <> Неопределено И Не СоставШапки.Свойство(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Значения.Добавить(Содержимое.Шапка[Имя]);
	КонецЦикла;
	Колонки = СтрРазделить(ИменаКолонокТоваров(), ",", Ложь);
	Для Каждого СтрокаТоваров Из Содержимое.Товары Цикл
		Для Каждого Имя Из Колонки Цикл
			Значения.Добавить(СтрокаТоваров[Имя]);
		КонецЦикла;
	КонецЦикла;
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ЗначениеВСтрокуВнутр(Значения));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

Функция ИмяМакетаПечати()
	Возврат "КоммерческоеПредложение";
КонецФункции

Функция ВидФирменнойФормы()
	Возврат "КоммерческоеПредложение";
КонецФункции

Функция ИменаКолонокТоваров()
	Имена = Новый Массив;
	Для Каждого Реквизит Из Метаданные.Документы.КоммерческоеПредложение.ТабличныеЧасти.ТЧТовары.Реквизиты Цикл
		Имена.Добавить(Реквизит.Имя);
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");
КонецФункции

Функция ИсточникПечати(Документ, Реквизиты, ЯвнаяВерсия, КодЯзыка)
	Номер = РаботаСДокументами.СформироватьЦифровойНомер(Реквизиты.Номер);
	Версия = Реквизиты.Версия;
	Источник = Новый Структура("Данные, Плашка, ИмяФайла");
	ИзСнимка = ЗначениеЗаполнено(ЯвнаяВерсия) Или (Версия > 0 И Не Реквизиты.ИзмененоПослеРедакции);
	Если ИзСнимка Тогда
		ПечатаемаяВерсия = ?(ЗначениеЗаполнено(ЯвнаяВерсия), ЯвнаяВерсия, Версия);
		Снимок = ДанныеРедакции(Документ, ПечатаемаяВерсия);
		Если Снимок <> Неопределено Тогда
			Источник.Данные = Снимок.Печать;
			Источник.Плашка = ПлашкаРедакции(ПечатаемаяВерсия, Ложь, КодЯзыка);
			Источник.ИмяФайла = ИмяФайлаПечати(Номер, ПечатаемаяВерсия, КодЯзыка);
			Возврат Источник;
		КонецЕсли;
	КонецЕсли;
	Источник.Данные = ДанныеДляПечати(Документ.ПолучитьОбъект());
	Если Реквизиты.ИзмененоПослеРедакции Тогда
		Источник.Плашка = ПлашкаРедакции(Версия + 1, Истина, КодЯзыка);
		Источник.ИмяФайла = ИмяФайлаПечати(Номер, Версия + 1, КодЯзыка);
	Иначе
		Источник.Плашка = "";
		Источник.ИмяФайла = ИмяФайлаПечати(Номер, 0, КодЯзыка);
	КонецЕсли;
	Возврат Источник;
КонецФункции

Функция ПлашкаРедакции(Версия, Черновик, КодЯзыка)
	НомерВерсии = Формат(Версия, "ЧГ=0");
	Если Черновик Тогда
		Шаблон = НСтр("ru = 'Редакция v%1 · черновик'; fr = 'Révision v%1 · brouillon';
			|en = 'Revision v%1 · draft'; es = 'Revisión v%1 · borrador'", КодЯзыка);
	Иначе
		Шаблон = НСтр("ru = 'Редакция v%1'; fr = 'Révision v%1'; en = 'Revision v%1'; es = 'Revisión v%1'", КодЯзыка);
	КонецЕсли;
	Возврат СтрШаблон(Шаблон, НомерВерсии);
КонецФункции

Функция ИмяФайлаПечати(Номер, Версия, КодЯзыка)
	ИмяФайла = НСтр("ru = 'КП'; fr = 'Devis'; en = 'Quotation'; es = 'Presupuesto'", КодЯзыка) + " " + Номер;
	Если Версия > 0 Тогда
		ИмяФайла = ИмяФайла + " v" + Формат(Версия, "ЧГ=0");
	КонецЕсли;
	Возврат ИмяФайла;
КонецФункции

Функция СтрокиДляПечати(Объект)
	Товары = Объект.ТЧТовары.Выгрузить(, "НомерСтроки, Номенклатура, НоменклатураСтрока, Характеристика, Упаковка, "
		+ "КоличествоУпаковок, Цена, ПроцентСкидки, СуммаСНДС, СуммаНДС, Описание");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	Номенклатура.Артикул КАК Артикул,
	|	ПРЕДСТАВЛЕНИЕ(Номенклатура.Единица) КАК Единица
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&Номенклатура)");
	Запрос.УстановитьПараметр("Номенклатура", Товары.ВыгрузитьКолонку("Номенклатура"));
	СведенияНоменклатуры = Запрос.Выполнить().Выгрузить();
	СведенияНоменклатуры.Индексы.Добавить("Ссылка");

	Строки = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Сведения = СведенияНоменклатуры.Найти(Товар.Номенклатура, "Ссылка");
		Наименование = НаименованиеСтроки(Товар, Сведения);
		Единица = ?(Сведения = Неопределено, "", Сведения.Единица);
		Если ЗначениеЗаполнено(Товар.Упаковка) Тогда
			Единица = СокрЛП(Товар.Упаковка);
		КонецЕсли;
		// Количество и цена - в упаковках строки: сумма строки = Цена × КоличествоУпаковок (РассчитатьСтроку).
		СтрокаПечати = Новый Структура;
		СтрокаПечати.Вставить("НомерСтроки", Товар.НомерСтроки);
		СтрокаПечати.Вставить("Наименование", Наименование);
		СтрокаПечати.Вставить("Описание", СокрЛП(Товар.Описание));
		СтрокаПечати.Вставить("Количество", Товар.КоличествоУпаковок);
		СтрокаПечати.Вставить("Единица", Единица);
		СтрокаПечати.Вставить("Цена", Товар.Цена);
		СтрокаПечати.Вставить("ПроцентСкидки", Товар.ПроцентСкидки);
		СтрокаПечати.Вставить("Сумма", ?(Объект.ЦенаВключаетНДС, Товар.СуммаСНДС, Товар.СуммаСНДС - Товар.СуммаНДС));
		Строки.Добавить(СтрокаПечати);
	КонецЦикла;
	Возврат Строки;
КонецФункции

Функция НаименованиеСтроки(Товар, Сведения)
	Наименование = СокрЛП(Товар.НоменклатураСтрока);
	Если Сведения <> Неопределено Тогда
		Если ПустаяСтрока(Наименование) Тогда
			Наименование = ?(ПустаяСтрока(Сведения.НаименованиеПолное), Сведения.Наименование, Сведения.НаименованиеПолное);
			Наименование = СокрЛП(Наименование);
		КонецЕсли;
		Артикул = СокрЛП(Сведения.Артикул);
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Наименование, Артикул, ", ");
	КонецЕсли;
	Если ЗначениеЗаполнено(Товар.Характеристика) Тогда
		Характеристика = СокрЛП(Товар.Характеристика);
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Наименование, Характеристика, ", ");
	КонецЕсли;
	Возврат Наименование;
КонецФункции

Процедура ДобавитьСсылку(Ссылки, Значение)
	Если ЗначениеЗаполнено(Значение) И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение))
		И Ссылки.Найти(Значение) = Неопределено Тогда
		Ссылки.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

Функция ПустоеЗначение(Значение)
	Типы = Новый Массив;
	Типы.Добавить(ТипЗнч(Значение));
	ОписаниеТипа = Новый ОписаниеТипов(Типы);
	Возврат ОписаниеТипа.ПривестиЗначение(Неопределено);
КонецФункции

Функция ЭтоОтсутствующаяСсылка(Значение, Существующие)
	Возврат ЗначениеЗаполнено(Значение) И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение))
		И Существующие[Значение] = Неопределено;
КонецФункции

Функция СуществующиеСсылки(Ссылки)
	// Ссылки из списка, которые есть в базе: одним запросом на таблицу, а не обращением на ссылку.
	Результат = Новый Соответствие;
	ПоТаблицам = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		ПолноеИмя = Ссылка.Метаданные().ПолноеИмя();
		Список = ПоТаблицам[ПолноеИмя];
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоТаблицам.Вставить(ПолноеИмя, Список);
		КонецЕсли;
		Список.Добавить(Ссылка);
	КонецЦикла;
	Для Каждого КлючИЗначение Из ПоТаблицам Цикл
		// Перечисления в базе не удаляются: значение снимка остаётся действительным.
		Если СтрНачинаетсяС(КлючИЗначение.Ключ, "Перечисление.") Тогда
			Найденные = КлючИЗначение.Значение;
		Иначе
			Найденные = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(КлючИЗначение.Значение, "Ссылка КАК Найдена");
		КонецЕсли;
		Для Каждого Найденная Из Найденные Цикл
			Результат.Вставить(?(ТипЗнч(Найденная) = Тип("КлючИЗначение"), Найденная.Ключ, Найденная), Истина);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
