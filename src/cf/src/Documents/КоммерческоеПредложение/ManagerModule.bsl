#Область ПрограммныйИнтерфейс

// Описание новой строки предложения по умолчанию: описание из карточки номенклатуры, если оно выводится на печать.
// Дальше у каждой строки описание своё и в карточку не переносится.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - номенклатура строки.
//
// Возвращаемое значение:
//  Строка - описание строки, пустая строка, если в карточке описания для печати нет.
//
Функция ОписаниеСтрокиПоУмолчанию(Номенклатура) Экспорт
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Описание, ВыводитьНаПечатьОписание");
	Возврат ?(Реквизиты.ВыводитьНаПечатьОписание = Истина, Реквизиты.Описание, "");
КонецФункции

// Признак статуса «отправлено клиенту»: с него начинается учёт редакций предложения
// (docs/plans/kp-print-revisions.md).
//
// Параметры:
//  Статус - ПеречислениеСсылка.СтатусыКоммерческихПредложений - статус предложения.
//
// Возвращаемое значение:
//  Булево - Истина для статусов Отправлен, Доставлен, Выигран, Проигран.
//
Функция СтатусОтправлен(Статус) Экспорт
	Возврат ЗначениеЗаполнено(Статус) И Статус <> Перечисления.СтатусыКоммерческихПредложений.Черновик;
КонецФункции

// Перечисляет печатные формы коммерческого предложения.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаПечати(), ВидФирменнойФормы());
КонецПроцедуры

// Формирует печатную форму коммерческого предложения общим механизмом фирменных форм (ФирменнаяПечать).
//
// Параметры:
//  МассивОбъектов        - Массив - ссылки на коммерческие предложения.
//  ПараметрыПечати       - Структура - параметры команды печати; ключ Версия - номер печатаемой редакции.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - коллекция печатных форм.
//  ОбъектыПечати         - СписокЗначений - соответствие документов областям печати.
//  ПараметрыВывода       - Структура - параметры окна печати.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	ФирменнаяПечать.Напечатать(ИмяМакетаПечати(), ВидФирменнойФормы(), МассивОбъектов, ПараметрыПечати,
		КоллекцияПечатныхФорм, ОбъектыПечати);
КонецПроцедуры

// Адаптер данных фирменной печати (см. ФирменнаяПечать.Напечатать). Источник данных - один на номер редакции:
// отправленная редакция без правок и редакция, выбранная явно (ПараметрыПечати.Версия), печатаются из снимка
// регистра редакций, не обращаясь к справочникам; не отправлявшееся предложение и черновик правок - по данным
// документа.
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.КоммерческоеПредложение - печатаемые предложения.
//  ВидФормы        - Строка - вид фирменной формы.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати; ключ Версия - номер печатаемой редакции.
//
// Возвращаемое значение:
//  Соответствие - ссылка -> Структура: Данные (см. ДанныеДляПечати), Плашка (Строка), ИмяФайла (Строка).
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	ЯвнаяВерсия = Неопределено;
	ПараметрыПечати.Свойство("Версия", ЯвнаяВерсия);
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Ссылки, "Номер, Версия, ИзмененоПослеРедакции");
	Результат = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		РеквизитыСсылки = Реквизиты[Ссылка];
		// Удалённого предложения в базе нет - печатать нечего.
		Если РеквизитыСсылки <> Неопределено Тогда
			Результат.Вставить(Ссылка, ИсточникПечати(Ссылка, РеквизитыСсылки, ЯвнаяВерсия, КодЯзыка));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Редакции предложения для списка выбора в форме: от последней к первой.
//
// Параметры:
//  Предложение - ДокументСсылка.КоммерческоеПредложение - предложение.
//
// Возвращаемое значение:
//  Массив из Структура - Версия (Число), Дата (Дата), Автор (СправочникСсылка.Пользователи),
//                        Сумма (Число), Валюта (СправочникСсылка.Валюты); пустой, если редакций нет.
//
Функция СписокРедакций(Предложение) Экспорт
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(Предложение) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Редакции.Версия КАК Версия,
	|	Редакции.Дата КАК Дата,
	|	Редакции.Автор КАК Автор,
	|	Редакции.Сумма КАК Сумма,
	|	Редакции.Валюта КАК Валюта
	|ИЗ
	|	РегистрСведений.РедакцииКоммерческихПредложений КАК Редакции
	|ГДЕ
	|	Редакции.Предложение = &Предложение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Версия УБЫВ");
	Запрос.УстановитьПараметр("Предложение", Предложение);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Редакция = Новый Структура("Версия, Дата, Автор, Сумма, Валюта");
		ЗаполнитьЗначенияСвойств(Редакция, Выборка);
		Результат.Добавить(Редакция);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Снимок редакции предложения из регистра редакций.
//
// Параметры:
//  Предложение - ДокументСсылка.КоммерческоеПредложение - предложение.
//  Версия      - Число - номер редакции.
//
// Возвращаемое значение:
//  Структура, Неопределено - Объект (Структура: Шапка, Товары) и Печать (данные печати, см. ДанныеДляПечати);
//                            Неопределено, если такой редакции нет.
//
Функция ДанныеРедакции(Предложение, Версия) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Редакции.Данные КАК Данные
	|ИЗ
	|	РегистрСведений.РедакцииКоммерческихПредложений КАК Редакции
	|ГДЕ
	|	Редакции.Предложение = &Предложение
	|	И Редакции.Версия = &Версия");
	Запрос.УстановитьПараметр("Предложение", Предложение);
	Запрос.УстановитьПараметр("Версия", Версия);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = Выборка.Данные.Получить();
	Возврат ?(ТипЗнч(Данные) = Тип("Структура"), Данные, Неопределено);
КонецФункции

// Содержимое редакции для возврата в текущее предложение: ссылки снимка, которых уже нет в базе,
// заменены пустыми значениями и перечислены в НеНайдено (ссылки внутри хранилища значения
// ссылочной целостностью не защищены).
//
// Параметры:
//  Предложение - ДокументСсылка.КоммерческоеПредложение - предложение.
//  Версия      - Число - номер редакции.
//
// Возвращаемое значение:
//  Структура, Неопределено - Шапка (Структура), Товары (ТаблицаЗначений), НеНайдено (Массив из Строка);
//                            Неопределено, если такой редакции нет.
//
Функция СодержимоеДляВозврата(Предложение, Версия) Экспорт
	Снимок = ДанныеРедакции(Предложение, Версия);
	Если Снимок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Шапка = Снимок.Объект.Шапка;
	Товары = Снимок.Объект.Товары;
	НеНайдено = Новый Массив;

	Ссылки = Новый Массив;
	Для Каждого КлючИЗначение Из Шапка Цикл
		ДобавитьСсылку(Ссылки, КлючИЗначение.Значение);
	КонецЦикла;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Для Каждого Колонка Из Товары.Колонки Цикл
			ДобавитьСсылку(Ссылки, СтрокаТоваров[Колонка.Имя]);
		КонецЦикла;
	КонецЦикла;
	Существующие = СуществующиеСсылки(Ссылки);

	Для Каждого КлючИЗначение Из Шапка Цикл
		Если ЭтоОтсутствующаяСсылка(КлючИЗначение.Значение, Существующие) Тогда
			НеНайдено.Добавить(СтрШаблон("%1: %2", КлючИЗначение.Ключ, Строка(КлючИЗначение.Значение)));
			Шапка[КлючИЗначение.Ключ] = ПустоеЗначение(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Для Каждого Колонка Из Товары.Колонки Цикл
			Значение = СтрокаТоваров[Колонка.Имя];
			Если ЭтоОтсутствующаяСсылка(Значение, Существующие) Тогда
				ШаблонСтроки = НСтр("ru = 'строка %1, %2: %3'; fr = 'ligne %1, %2 : %3';
					|en = 'line %1, %2: %3'; es = 'línea %1, %2: %3'");
				ПредставлениеЗначения = Строка(Значение);
				НеНайдено.Добавить(СтрШаблон(ШаблонСтроки, СтрокаТоваров.НомерСтроки, Колонка.Имя, ПредставлениеЗначения));
				СтрокаТоваров[Колонка.Имя] = ПустоеЗначение(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Шапка, Товары, НеНайдено", Шапка, Товары, НеНайдено);
КонецФункции

// Признак ручного ввода коммерческих предложений - включена опция «Коммерческие предложения». Опция выключена -
// КП создаёт и поддерживает реализация (docs/plans/branded-print.md, 3.3). Читается константа, а не функциональная
// опция: значение опции кэшируется до конца серверного вызова (tiny1C bsl-023), а сценарий тестов переключает её
// внутри одного вызова. Права на константу у пользовательских ролей нет (у опции privilegedGetMode) - чтение в
// привилегированном режиме.
//
// Возвращаемое значение:
//  Булево - Истина, если КП вводит человек.
//
Функция КПВводятсяВручную() Экспорт
	// BSLLS:SetPrivilegedMode-off - читается только значение константы опции, наружу - Булево.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Значение = Константы.ИспользоватьКоммерческиеПредложения.Получить();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Значение = Истина;
КонецФункции

// Создаёт и обновляет коммерческие предложения реализаций при выключенной опции «Коммерческие предложения»
// (docs/plans/branded-print.md, 3.3 и 9.5): блокировка реализаций, повторное чтение их авто-КП после блокировки,
// создание недостающих, запись только изменившихся, разбор дублей. Номер и дата КП - из реализации, пометка
// удаления - зеркально. Вызывается при записи реализации (в её транзакции) и перед печатью КП из реализации.
// Выполняется в привилегированном режиме целиком: реализацию пишут роли без прав на КП. Вызывающий передаёт только
// реализации, которые пользователь записывает или вправе читать.
//
// Параметры:
//  МассивРеализаций - Массив из ДокументСсылка.РеализацияТоваровУслуг - реализации.
//
// Возвращаемое значение:
//  Соответствие - реализация -> ДокументСсылка.КоммерческоеПредложение (авто-КП реализации); реализаций, которых
//                 нет в базе, в нём нет.
//
Функция СинхронизироватьСРеализациями(Знач МассивРеализаций) Экспорт
	Результат = Новый Соответствие;
	Реализации = БезПовторов(МассивРеализаций);
	Если Реализации.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - протокол целиком (3.3, круг 3): реализацию пишут роли без прав на КП; вход -
	// только реализации, которые пользователь записывает или читает, наружу - только ссылки КП.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРеализации(Реализации);
		Заблокированные = ЗаблокироватьАвтоКП(Реализации);
		Данные = ДанныеСинхронизации(Реализации, Заблокированные);
		Для Каждого Реализация Из Реализации Цикл
			Предложение = СинхронизироватьПредложение(Реализация, Данные);
			Если ЗначениеЗаполнено(Предложение) Тогда
				Результат.Вставить(Реализация, Предложение);
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Реквизиты шапки, из которых состоит редакция: они попадают в снимок, в хеш и возвращаются
// вместе с редакцией (кроме Номер - у предложения контроль уникальности номера). Ответственный печатается
// вместо незаполненного менеджера, поэтому тоже входит в редакцию.
//
// Возвращаемое значение:
//  Строка - имена реквизитов через запятую.
//
Функция РеквизитыШапкиРедакции() Экспорт
	Возврат "Номер, Дата, Организация, Контрагент, Договор, Менеджер, Ответственный, ДатаОтгрузки, ЦенаВключаетНДС, "
		+ "ВВалюте, Валюта, КурсВалюты, Комментарий";
КонецФункции

// Содержимое предложения для снимка редакции и для хеша: шапка и строки товаров в фиксированном порядке.
//
// Параметры:
//  Объект - ДокументОбъект.КоммерческоеПредложение - предложение (в том числе ещё не записанное).
//
// Возвращаемое значение:
//  Структура - Шапка (Структура реквизитов РеквизитыШапкиРедакции), Товары (ТаблицаЗначений колонок ТЧТовары).
//
Функция СодержимоеРедакции(Объект) Экспорт
	Шапка = Новый Структура(РеквизитыШапкиРедакции());
	ЗаполнитьЗначенияСвойств(Шапка, Объект);
	Колонки = ИменаКолонокТоваров();
	Товары = Объект.ТЧТовары.Выгрузить(, "НомерСтроки," + Колонки);
	Возврат Новый Структура("Шапка, Товары", Шапка, Товары);
КонецФункции

// SHA-256 содержимого предложения. Считается по значениям в фиксированном порядке реквизитов и колонок,
// поэтому не зависит от порядка ключей структуры и типов колонок таблицы.
//
// Параметры:
//  Содержимое - Структура - см. СодержимоеРедакции.
//
// Возвращаемое значение:
//  Строка - хеш в шестнадцатеричном виде, 64 символа.
//
Функция ХешСодержимого(Содержимое) Экспорт
	Возврат ХешПоСоставу(Содержимое, Неопределено);
КонецФункции

// Хеш содержимого в составе шапки сохранённой редакции: редакция, записанная до расширения состава
// (2.0.16.51 - Ответственный), сравнивается по своим реквизитам, иначе запись без изменений дала бы новую редакцию.
//
// Параметры:
//  Содержимое  - Структура - см. СодержимоеРедакции.
//  Предложение - ДокументСсылка.КоммерческоеПредложение - предложение.
//  Версия      - Число - номер сохранённой редакции.
//
// Возвращаемое значение:
//  Строка - хеш; пусто, если редакции нет.
//
Функция ХешВСоставеРедакции(Содержимое, Предложение, Версия) Экспорт
	Снимок = ДанныеРедакции(Предложение, Версия);
	Если Снимок = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	СоставШапки = Снимок.Объект.Шапка;
	// Ответственного старый состав не хранил, но печатал вместо пустого менеджера: его смена сверяется с напечатанным.
	Если Не СоставШапки.Свойство("Ответственный") И Не ЗначениеЗаполнено(Содержимое.Шапка.Менеджер)
		И СокрЛП(Содержимое.Шапка.Ответственный) <> Снимок.Печать.Шапка.Менеджер Тогда
		Возврат "";
	КонецЕсли;
	Возврат ХешПоСоставу(Содержимое, СоставШапки);
КонецФункции

// Данные печати предложения на текущий момент: все представления - строками, картинки организации -
// двоичными данными. Этой же структурой печатается снимок редакции, поэтому она самодостаточна и
// справочники при перепечатке не читаются.
//
// Параметры:
//  Объект - ДокументОбъект.КоммерческоеПредложение - предложение (в том числе ещё не записанное).
//
// Возвращаемое значение:
//  Структура - Организация, Клиент, Шапка, Товары (Массив из Структура), Итоги, Логотип, ПечатьОрганизации.
//
Функция ДанныеДляПечати(Объект) Экспорт
	Дата = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
	ВалютаДокумента = РаботаСВалютами.ВалютаИКурсДокумента(Объект).Валюта;

	Данные = Новый Структура;
	// 2 - договор клиента без подписи и сумма прописью на каждом языке: снимок печатается на любом языке.
	Данные.Вставить("ВерсияФормата", 2);
	Данные.Вставить("КодВалюты", СокрЛП(ВалютаДокумента));
	Данные.Вставить("Организация", ФирменнаяПечать.ДанныеОрганизации(Объект.Организация, Дата));
	Данные.Вставить("Клиент", ФирменнаяПечать.ДанныеКонтрагента(Объект.Контрагент, Объект.Договор, Дата));

	Шапка = Новый Структура;
	Шапка.Вставить("Номер", РаботаСДокументами.СформироватьЦифровойНомер(Объект.Номер));
	Шапка.Вставить("Дата", Объект.Дата);
	Шапка.Вставить("ДатаОтгрузки", Объект.ДатаОтгрузки);
	Шапка.Вставить("ЦенаВключаетНДС", Объект.ЦенаВключаетНДС);
	Менеджер = ?(ЗначениеЗаполнено(Объект.Менеджер), СокрЛП(Объект.Менеджер), СокрЛП(Объект.Ответственный));
	Шапка.Вставить("Менеджер", Менеджер);
	Шапка.Вставить("Комментарий", СокрЛП(Объект.Комментарий));
	Данные.Вставить("Шапка", Шапка);

	Данные.Вставить("Товары", СтрокиДляПечати(Объект));
	Итоги = ФирменнаяПечать.ДанныеИтогов(Объект.Сумма, Объект.СуммаНДС, Объект.СуммаБезНДС, ВалютаДокумента);
	Данные.Вставить("Итоги", Итоги);

	Картинки = ПечатныеФормы.КартинкиОрганизации(Объект.Организация);
	Данные.Вставить("Логотип", Картинки.Логотип);
	Данные.Вставить("ПечатьОрганизации", Картинки.ПечатьОрганизации);
	Возврат Данные;
КонецФункции

// Снимок редакции для записи в регистр редакций.
//
// Параметры:
//  Объект - ДокументОбъект.КоммерческоеПредложение - предложение.
//
// Возвращаемое значение:
//  Структура - Объект (см. СодержимоеРедакции) и Печать (см. ДанныеДляПечати).
//
Функция СнимокРедакции(Объект) Экспорт
	Возврат Новый Структура("Объект, Печать", СодержимоеРедакции(Объект), ДанныеДляПечати(Объект));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СинхронизацияСРеализациями

Процедура ЗаблокироватьРеализации(Реализации)
	// Порядок блокировок один: сначала реализация, потом её КП (при записи реализации платформа уже держит её -
	// повтор безвреден).
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Реализация Из Реализации Цикл
		ЭлементБлокировки = Блокировка.Добавить("Документ.РеализацияТоваровУслуг");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Реализация);
	КонецЦикла;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ЗаблокироватьАвтоКП(Реализации)
	// Флаг КП меняет и служебная запись заказа («Выигран»), которая реализацию не блокирует: прочитанный флаг
	// защищает только блокировка самого КП (круг 1 фазы 2, P1). Данные КП перечитываются после неё.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Предложения.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КоммерческоеПредложение КАК Предложения
	|ГДЕ
	|	Предложения.Основание В (&Реализации)
	|	И Предложения.Автосинхронизация");
	Запрос.УстановитьПараметр("Реализации", Реализации);
	Предложения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Предложения.Количество() = 0 Тогда
		Возврат Предложения;
	КонецЕсли;
	// Вместе с документом - его редакции: загрузка обмена пишет их без записи документа. Порядок «документ КП -> его
	// редакции» тот же, что у ОпределитьРедакцию.
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Предложение Из Предложения Цикл
		ЭлементБлокировки = Блокировка.Добавить("Документ.КоммерческоеПредложение");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Предложение);
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.РедакцииКоммерческихПредложений");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Предложение", Предложение);
	КонецЦикла;
	Блокировка.Заблокировать();
	Возврат Предложения;
КонецФункции

// Данные реализаций и их авто-КП одним пакетом - после блокировки.
//
// Параметры:
//  Реализации      - Массив из ДокументСсылка.РеализацияТоваровУслуг - реализации.
//  Заблокированные - Массив из ДокументСсылка.КоммерческоеПредложение - авто-КП, заблокированные протоколом.
//
// Возвращаемое значение:
//  Структура - Реализации, Строки, Предложения, СтрокиПредложений (ТаблицаЗначений, индексы по ссылке).
//
Функция ДанныеСинхронизации(Реализации, Заблокированные)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Реализация.Ссылка КАК Ссылка,
	|	Реализация.Номер КАК Номер,
	|	Реализация.Дата КАК Дата,
	|	Реализация.ПометкаУдаления КАК ПометкаУдаления,
	|	Реализация.Организация КАК Организация,
	|	Реализация.Контрагент КАК Контрагент,
	|	Реализация.Договор КАК Договор,
	|	Реализация.Менеджер КАК Менеджер,
	|	Реализация.Ответственный КАК Ответственный,
	|	Реализация.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Реализация.ВВалюте КАК ВВалюте,
	|	Реализация.Валюта КАК Валюта,
	|	Реализация.КурсВалюты КАК КурсВалюты,
	|	Реализация.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Ссылка В (&Реализации)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	0 КАК Вид,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.НоменклатураСтрока КАК НоменклатураСтрока,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Количество КАК Количество,
	|	Товары.ВидЦены КАК ВидЦены,
	|	Товары.ЦенаSKU КАК ЦенаSKU,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.ПроцентСкидки КАК ПроцентСкидки,
	|	Товары.СуммаСкидки КАК СуммаСкидки,
	|	Товары.СуммаСНДС КАК СуммаСНДС,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.СкидкаНаЦену КАК СкидкаНаЦену,
	|	Товары.СуммаРегл КАК СуммаРегл,
	|	"""" КАК Содержание,
	|	ЕСТЬNULL(Карточки.ВыводитьНаПечатьОписание, ЛОЖЬ) КАК ВыводитьНаПечатьОписание,
	|	Карточки.Описание КАК ОписаниеКарточки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Карточки
	|		ПО Товары.Номенклатура = Карточки.Ссылка
	|ГДЕ
	|	Товары.Ссылка В (&Реализации)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Услуги.Ссылка,
	|	1,
	|	Услуги.НомерСтроки,
	|	0,
	|	Услуги.Номенклатура,
	|	"""",
	|	NULL,
	|	NULL,
	|	Услуги.Количество,
	|	Услуги.Количество,
	|	NULL,
	|	0,
	|	Услуги.Цена,
	|	Услуги.Сумма,
	|	0,
	|	0,
	|	Услуги.СуммаСНДС,
	|	Услуги.СтавкаНДС,
	|	Услуги.СуммаНДС,
	|	0,
	|	Услуги.СуммаРегл,
	|	Услуги.Содержание,
	|	ЕСТЬNULL(Карточки.ВыводитьНаПечатьОписание, ЛОЖЬ),
	|	Карточки.Описание
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧУслуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Карточки
	|		ПО Услуги.Номенклатура = Карточки.Ссылка
	|ГДЕ
	|	Услуги.Ссылка В (&Реализации)
