#Область ПрограммныйИнтерфейс

// Описание новой строки предложения по умолчанию: описание из карточки номенклатуры, если оно выводится на печать.
// Дальше у каждой строки описание своё и в карточку не переносится.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - номенклатура строки.
//
// Возвращаемое значение:
//  Строка - описание строки, пустая строка, если в карточке описания для печати нет.
//
Функция ОписаниеСтрокиПоУмолчанию(Номенклатура) Экспорт
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Описание, ВыводитьНаПечатьОписание");
	Возврат ?(Реквизиты.ВыводитьНаПечатьОписание = Истина, Реквизиты.Описание, "");
КонецФункции

// Признак статуса «отправлено клиенту»: с него начинается учёт редакций предложения
// (docs/plans/kp-print-revisions.md).
//
// Параметры:
//  Статус - ПеречислениеСсылка.СтатусыКоммерческихПредложений - статус предложения.
//
// Возвращаемое значение:
//  Булево - Истина для статусов Отправлен, Доставлен, Выигран, Проигран.
//
Функция СтатусОтправлен(Статус) Экспорт
	Возврат ЗначениеЗаполнено(Статус) И Статус <> Перечисления.СтатусыКоммерческихПредложений.Черновик;
КонецФункции

// Перечисляет печатные формы коммерческого предложения.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаПечати(), ВидФирменнойФормы());
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаСВложениями(), ВидФирменнойФормы(), ПредставлениеСВложениями(),
		ИмяКомандыСВложениями());
КонецПроцедуры

// Формирует печатную форму коммерческого предложения общим механизмом фирменных форм (ФирменнаяПечать).
//
// Параметры:
//  МассивОбъектов        - Массив - ссылки на коммерческие предложения.
//  ПараметрыПечати       - Структура - параметры команды печати; ключ Версия - номер печатаемой редакции.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - коллекция печатных форм.
//  ОбъектыПечати         - СписокЗначений - соответствие документов областям печати.
//  ПараметрыВывода       - Структура - параметры окна печати.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	ФирменнаяПечать.ПроверитьПравоНаКоманду(КоллекцияПечатныхФорм, ИмяМакетаСВложениями(), КомандаСВложениями(),
		ПараметрыПечати);
	ФирменнаяПечать.Напечатать(ИмяМакетаПечати(), ВидФирменнойФормы(), МассивОбъектов, ПараметрыПечати,
		КоллекцияПечатныхФорм, ОбъектыПечати);
	// Вариант с вложениями - параметром печати, как фото у запроса котировок; структура вызывающего не меняется.
	ПараметрыСВложениями = Новый Структура;
	Если ТипЗнч(ПараметрыПечати) = Тип("Структура") Тогда
		Для Каждого Параметр Из ПараметрыПечати Цикл
			ПараметрыСВложениями.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	ПараметрыСВложениями.Вставить(ПараметрВложений(), Истина);
	ФирменнаяПечать.Напечатать(ИмяМакетаСВложениями(), ВидФирменнойФормы(), МассивОбъектов, ПараметрыСВложениями,
		КоллекцияПечатныхФорм, ОбъектыПечати, ПредставлениеСВложениями());
КонецПроцедуры

// Адаптер данных фирменной печати (см. ФирменнаяПечать.Напечатать). Источник данных - один на номер редакции:
// отправленная редакция без правок и редакция, выбранная явно (ПараметрыПечати.Версия), печатаются из снимка
// регистра редакций, не обращаясь к справочникам; не отправлявшееся предложение и черновик правок - по данным
// документа.
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.КоммерческоеПредложение - печатаемые предложения.
//  ВидФормы        - Строка - вид фирменной формы.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати; ключ Версия - номер печатаемой редакции.
//
// Возвращаемое значение:
//  Соответствие - ссылка -> Структура: Данные (см. ДанныеДляПечати), Плашка (Строка), ИмяФайла (Строка).
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	ЯвнаяВерсия = Неопределено;
	ПараметрыПечати.Свойство("Версия", ЯвнаяВерсия);
	СВложениями = Неопределено;
	ПараметрыПечати.Свойство(ПараметрВложений(), СВложениями);
	СВложениями = (СВложениями = Истина);
	Если СВложениями Тогда
		// Адаптер выбирается по типу ссылки, а параметры приходят от вызывающего: право на команду с вложениями
		// проверяется здесь, а не только в Печать менеджера (docs/plans/kp-print-terms.md, круг 2).
		ФирменнаяПечать.ПроверитьКомандуАдаптера(ВидФормы, КомандаСВложениями(), ПараметрыПечати);
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Ссылки, "Номер, Версия, ИзмененоПослеРедакции");
	Вложения = ?(СВложениями, ФирменнаяПечать.КартинкиВложений(Ссылки), Новый Соответствие);
	Результат = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		РеквизитыСсылки = Реквизиты[Ссылка];
		// Удалённого предложения в базе нет - печатать нечего.
		Если РеквизитыСсылки <> Неопределено Тогда
			Источник = ИсточникПечати(Ссылка, РеквизитыСсылки, ЯвнаяВерсия, КодЯзыка);
			Если СВложениями Тогда
				КартинкиСсылки = Вложения[Ссылка];
				Источник.Вставить("Вложения", ?(КартинкиСсылки = Неопределено, Новый Массив, КартинкиСсылки));
			КонецЕсли;
			Результат.Вставить(Ссылка, Источник);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Срок действия нового предложения: месяц от текущего дня.
//
// Возвращаемое значение:
//  Дата - дата, до которой действует предложение.
//
Функция СрокДействияПоУмолчанию() Экспорт
	Возврат ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), 1);
КонецФункции

// Редакции предложения для списка выбора в форме: от последней к первой.
//
// Параметры:
//  Предложение - ДокументСсылка.КоммерческоеПредложение - предложение.
//
// Возвращаемое значение:
//  Массив из Структура - Версия (Число), Дата (Дата), Автор (СправочникСсылка.Пользователи),
//                        Сумма (Число), Валюта (СправочникСсылка.Валюты); пустой, если редакций нет.
//
Функция СписокРедакций(Предложение) Экспорт
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(Предложение) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Редакции.Версия КАК Версия,
	|	Редакции.Дата КАК Дата,
	|	Редакции.Автор КАК Автор,
	|	Редакции.Сумма КАК Сумма,
	|	Редакции.Валюта КАК Валюта
	|ИЗ
	|	РегистрСведений.РедакцииКоммерческихПредложений КАК Редакции
	|ГДЕ
	|	Редакции.Предложение = &Предложение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Версия УБЫВ");
	Запрос.УстановитьПараметр("Предложение", Предложение);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Редакция = Новый Структура("Версия, Дата, Автор, Сумма, Валюта");
		ЗаполнитьЗначенияСвойств(Редакция, Выборка);
		Результат.Добавить(Редакция);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Снимок редакции предложения из регистра редакций.
//
// Параметры:
//  Предложение - ДокументСсылка.КоммерческоеПредложение - предложение.
//  Версия      - Число - номер редакции.
//
// Возвращаемое значение:
//  Структура, Неопределено - Объект (Структура: Шапка, Товары) и Печать (данные печати, см. ДанныеДляПечати);
//                            Неопределено, если такой редакции нет.
//
Функция ДанныеРедакции(Предложение, Версия) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Редакции.Данные КАК Данные
	|ИЗ
	|	РегистрСведений.РедакцииКоммерческихПредложений КАК Редакции
	|ГДЕ
	|	Редакции.Предложение = &Предложение
	|	И Редакции.Версия = &Версия");
	Запрос.УстановитьПараметр("Предложение", Предложение);
	Запрос.УстановитьПараметр("Версия", Версия);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = Выборка.Данные.Получить();
	Возврат ?(ТипЗнч(Данные) = Тип("Структура"), Данные, Неопределено);
КонецФункции

// Содержимое редакции для возврата в текущее предложение: ссылки снимка, которых уже нет в базе,
// заменены пустыми значениями и перечислены в НеНайдено (ссылки внутри хранилища значения
// ссылочной целостностью не защищены).
//
// Параметры:
//  Предложение - ДокументСсылка.КоммерческоеПредложение - предложение.
//  Версия      - Число - номер редакции.
//
// Возвращаемое значение:
//  Структура, Неопределено - Шапка (Структура), Товары (ТаблицаЗначений), НеНайдено (Массив из Строка);
//                            Неопределено, если такой редакции нет.
//
Функция СодержимоеДляВозврата(Предложение, Версия) Экспорт
	Снимок = ДанныеРедакции(Предложение, Версия);
	Если Снимок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Шапка = ШапкаРедакцииДляВозврата(Снимок.Объект.Шапка);
	Товары = Снимок.Объект.Товары;
	НеНайдено = Новый Массив;

	Ссылки = Новый Массив;
	Для Каждого КлючИЗначение Из Шапка Цикл
		ДобавитьСсылку(Ссылки, КлючИЗначение.Значение);
	КонецЦикла;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Для Каждого Колонка Из Товары.Колонки Цикл
			ДобавитьСсылку(Ссылки, СтрокаТоваров[Колонка.Имя]);
		КонецЦикла;
	КонецЦикла;
	Существующие = СуществующиеСсылки(Ссылки);

	Для Каждого КлючИЗначение Из Шапка Цикл
		Если ЭтоОтсутствующаяСсылка(КлючИЗначение.Значение, Существующие) Тогда
			НеНайдено.Добавить(СтрШаблон("%1: %2", КлючИЗначение.Ключ, Строка(КлючИЗначение.Значение)));
			Шапка[КлючИЗначение.Ключ] = ПустоеЗначение(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Для Каждого Колонка Из Товары.Колонки Цикл
			Значение = СтрокаТоваров[Колонка.Имя];
			Если ЭтоОтсутствующаяСсылка(Значение, Существующие) Тогда
				ШаблонСтроки = НСтр("ru = 'строка %1, %2: %3'; fr = 'ligne %1, %2 : %3';
					|en = 'line %1, %2: %3'; es = 'línea %1, %2: %3'");
				ПредставлениеЗначения = Строка(Значение);
				НеНайдено.Добавить(СтрШаблон(ШаблонСтроки, СтрокаТоваров.НомерСтроки, Колонка.Имя, ПредставлениеЗначения));
				СтрокаТоваров[Колонка.Имя] = ПустоеЗначение(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Шапка, Товары, НеНайдено", Шапка, Товары, НеНайдено);
КонецФункции

// Признак ручного ввода коммерческих предложений - включена опция «Коммерческие предложения». Опция выключена -
// КП создаёт и поддерживает реализация (docs/plans/branded-print.md, 3.3). Читается константа, а не функциональная
// опция: значение опции кэшируется до конца серверного вызова (tiny1C bsl-023), а сценарий тестов переключает её
// внутри одного вызова. Права на константу у пользовательских ролей нет (у опции privilegedGetMode) - чтение в
// привилегированном режиме.
//
// Возвращаемое значение:
//  Булево - Истина, если КП вводит человек.
//
Функция КПВводятсяВручную() Экспорт
	// BSLLS:SetPrivilegedMode-off - читается только значение константы опции, наружу - Булево.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Значение = Константы.ИспользоватьКоммерческиеПредложения.Получить();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Значение = Истина;
КонецФункции

// Создаёт и обновляет коммерческие предложения реализаций при выключенной опции «Коммерческие предложения»
// (docs/plans/branded-print.md, 3.3 и 9.5): блокировка реализаций, повторное чтение их авто-КП после блокировки,
// создание недостающих, запись только изменившихся, разбор дублей. Номер и дата КП - из реализации, пометка
// удаления - зеркально. Вызывается при записи реализации (в её транзакции) и перед печатью КП из реализации.
// Выполняется в привилегированном режиме целиком: реализацию пишут роли без прав на КП. Вызывающий передаёт только
// реализации, которые пользователь записывает или вправе читать.
//
// Параметры:
//  МассивРеализаций - Массив из ДокументСсылка.РеализацияТоваровУслуг - реализации.
//
// Возвращаемое значение:
//  Соответствие - реализация -> ДокументСсылка.КоммерческоеПредложение (авто-КП реализации); реализаций, которых
//                 нет в базе, в нём нет.
//
Функция СинхронизироватьСРеализациями(Знач МассивРеализаций) Экспорт
	Результат = Новый Соответствие;
	Реализации = БезПовторов(МассивРеализаций);
	Если Реализации.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - протокол целиком (3.3, круг 3): реализацию пишут роли без прав на КП; вход -
	// только реализации, которые пользователь записывает или читает, наружу - только ссылки КП.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРеализации(Реализации);
		Заблокированные = ЗаблокироватьАвтоКП(Реализации);
		Данные = ДанныеСинхронизации(Реализации, Заблокированные);
		Для Каждого Реализация Из Реализации Цикл
			Предложение = СинхронизироватьПредложение(Реализация, Данные);
			Если ЗначениеЗаполнено(Предложение) Тогда
				Результат.Вставить(Реализация, Предложение);
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

// Ошибки цен и скидок строк предложения, записываемого пользователем без настройки «Заверение цен» (ревью безопасности
// 2.0.17.24): форма делает колонки только для чтения, запись проверяется здесь.
//  - Строка, которая есть в версии в базе (код строки, номенклатура, характеристика и упаковка совпадают), сохраняет
//    вид цены, цену и скидки этой версии; сумма скидки - не больше прежней в пересчёте на количество.
//  - Строка, цены которой совпадают с неиспользованной строкой реализации-основания (тот же код строки и товар, иначе
//    тот же товар, характеристика и упаковка), - допустима: цены той строки уже прошёл контроль проведённого документа.
//  - Прочая (новая) строка - вид цены документа (вид цены покупателя, иначе розничный, или вид цены строк версии в
//    базе и основания), цена по этому виду цены на дату документа, без скидок. Копия предложения проверяется так же:
//    особые цены исходного документа копия без настройки не наследует.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.КоммерческоеПредложение - записываемое предложение.
//
// Возвращаемое значение:
//  Массив из Строка - пустой, если записать можно.
//
Функция ОшибкиЦенБезЗаверения(ДокОбъект) Экспорт
	Ошибки = Новый Массив;
	Если ГрупповоеИзменениеСтрок.ПравоИзменятьЦены() Тогда
		Возврат Ошибки;
	КонецЕсли;
	Прежние = ?(ДокОбъект.ЭтоНовый(), Неопределено, СтрокиЦенВБазе(ДокОбъект.Ссылка));
	Основание = ПроведеннаяРеализацияОснование(ДокОбъект);
	СтрокиОснования = ?(Основание = Неопределено, Неопределено, Основание.ТЧТовары.Выгрузить());
	ВидыЦен = ДопустимыеВидыЦенНовыхСтрок(ДокОбъект, Прежние, СтрокиОснования);
	ДобавитьОшибкиШапкиЦен(ДокОбъект, Основание, ВидыЦен[0], Ошибки);
	Шаблон = НСтр("ru = 'Строка %1: без настройки «Заверение цен» цену, вид цены и скидки изменить нельзя.';
		|fr = 'Ligne %1 : sans le paramètre « Validation des prix », le prix, le type de prix et les remises ne sont pas
		|modifiables.';
		|en = 'Line %1: without the ""Price approval"" setting, the price, price type and discounts cannot be changed.';
		|es = 'Línea %1: sin el ajuste «Aprobación de precios» no se pueden cambiar el precio, el tipo de precio ni los
		|descuentos.'");
	// Каждая строка основания подтверждает цену не больше одной строки предложения.
	Использованные = Новый Соответствие;
	НовыеСтроки = Новый Массив;
	Недопустимые = Новый Массив;
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Прежняя = ?(Прежние = Неопределено, Неопределено, ПрежняяСтрокаЦен(Прежние, Строка));
		Если Прежняя <> Неопределено Тогда
			Если Не ЦеныСтрокиСовпадают(Строка, Прежняя) Тогда
				Недопустимые.Добавить(Строка);
			КонецЕсли;
		ИначеЕсли СтрокиОснования = Неопределено Или СтрокаОснованияЦен(СтрокиОснования, Строка, Использованные) = Неопределено Тогда
			НовыеСтроки.Добавить(Строка);
		Иначе
			// Цену подтвердила неиспользованная строка реализации-основания.
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	НедопустимыеНовые = НедопустимыеНовыеСтроки(ДокОбъект, НовыеСтроки, ВидыЦен);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Недопустимые, НедопустимыеНовые);
	Для Каждого Строка Из Недопустимые Цикл
		Ошибки.Добавить(СтрШаблон(Шаблон, Строка.НомерСтроки));
	КонецЦикла;
	Возврат Ошибки;
КонецФункции

// Пересчитывает суммы строк предложения пользователя без настройки «Заверение цен» из проверенных цены, количества и
// скидок (см. ОшибкиЦенБезЗаверения) - тем же расчётом строки, что форма: присланные суммы строк и итоги не
// принимаются (ревью безопасности 2.0.17.24, круг 4).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.КоммерческоеПредложение - записываемое предложение.
//
Процедура ПересчитатьСуммыБезЗаверения(ДокОбъект) Экспорт
	Если ГрупповоеИзменениеСтрок.ПравоИзменятьЦены() Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Строка, ДокОбъект.ЦенаВключаетНДС, "Цена");
	КонецЦикла;
	РаботаСВалютамиКлиентСервер.ПересчитатьСуммыРегл(ДокОбъект);
КонецПроцедуры

// Строки товаров предложения в базе - цены и скидки сохранённой версии.
//
// Параметры:
//  Ссылка - ДокументСсылка.КоммерческоеПредложение - предложение.
//
// Возвращаемое значение:
//  ТаблицаЗначений - КодСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, ВидЦены, ЦенаSKU, Цена,
//                    ПроцентСкидки, СкидкаНаЦену, СуммаСкидки.
//
Функция СтрокиЦенВБазе(Ссылка) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Т.КодСтроки КАК КодСтроки,
	                      |	Т.Номенклатура КАК Номенклатура,
	                      |	Т.Характеристика КАК Характеристика,
	                      |	Т.Упаковка КАК Упаковка,
	                      |	Т.КоличествоУпаковок КАК КоличествоУпаковок,
	                      |	Т.ВидЦены КАК ВидЦены,
	                      |	Т.ЦенаSKU КАК ЦенаSKU,
	                      |	Т.Цена КАК Цена,
	                      |	Т.ПроцентСкидки КАК ПроцентСкидки,
	                      |	Т.СкидкаНаЦену КАК СкидкаНаЦену,
	                      |	Т.СуммаСкидки КАК СуммаСкидки
	                      |ИЗ
	                      |	Документ.КоммерческоеПредложение.ТЧТовары КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Строка версии в базе, соответствующая строке предложения: совпадают код строки, номенклатура, характеристика и
// упаковка - строка с тем же кодом, но другим товаром прежней не считается.
//
// Параметры:
//  Прежние - ТаблицаЗначений - см. СтрокиЦенВБазе.
//  Строка  - СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекции - строка ТЧТовары.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено
//
Функция ПрежняяСтрокаЦен(Прежние, Строка) Экспорт
	Отбор = Новый Структура("КодСтроки, Номенклатура, Характеристика, Упаковка");
	ЗаполнитьЗначенияСвойств(Отбор, Строка);
	Найденные = Прежние.НайтиСтроки(Отбор);
	Возврат ?(Найденные.Количество() = 0, Неопределено, Найденные[0]);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Реквизиты шапки, из которых состоит редакция: они попадают в снимок, в хеш и возвращаются
// вместе с редакцией (кроме Номер - у предложения контроль уникальности номера). Ответственный печатается
// вместо незаполненного менеджера, поэтому тоже входит в редакцию.
//
// Возвращаемое значение:
//  Строка - имена реквизитов через запятую.
//
Функция РеквизитыШапкиРедакции() Экспорт
	Возврат "Номер, Дата, Организация, Контрагент, Договор, Менеджер, Ответственный, ДатаОтгрузки, ЦенаВключаетНДС, "
		+ "ВВалюте, Валюта, КурсВалюты, Комментарий, " + НовыеРеквизитыРедакции();
КонецФункции

// Реквизиты условий, которые вошли в состав редакции в 2.0.16.137: их нет в снимках прежних редакций.
//
// Возвращаемое значение:
//  Строка - имена реквизитов через запятую.
//
Функция НовыеРеквизитыРедакции() Экспорт
	Возврат "ДействуетДо, Инкотермс, МестоПоставки, СрокПоставки";
КонецФункции

// Содержимое предложения для снимка редакции и для хеша: шапка и строки товаров в фиксированном порядке.
//
// Параметры:
//  Объект - ДокументОбъект.КоммерческоеПредложение - предложение (в том числе ещё не записанное).
//
// Возвращаемое значение:
//  Структура - Шапка (Структура реквизитов РеквизитыШапкиРедакции), Товары (ТаблицаЗначений колонок ТЧТовары).
//
Функция СодержимоеРедакции(Объект) Экспорт
	Шапка = Новый Структура(РеквизитыШапкиРедакции());
	ЗаполнитьЗначенияСвойств(Шапка, Объект);
	Колонки = ИменаКолонокТоваров();
	Товары = Объект.ТЧТовары.Выгрузить(, "НомерСтроки," + Колонки);
	Возврат Новый Структура("Шапка, Товары", Шапка, Товары);
КонецФункции

// SHA-256 содержимого предложения. Считается по значениям в фиксированном порядке реквизитов и колонок,
// поэтому не зависит от порядка ключей структуры и типов колонок таблицы.
//
// Параметры:
//  Содержимое - Структура - см. СодержимоеРедакции.
//
// Возвращаемое значение:
//  Строка - хеш в шестнадцатеричном виде, 64 символа.
//
Функция ХешСодержимого(Содержимое) Экспорт
	Возврат ХешПоСоставу(Содержимое, Неопределено);
КонецФункции

// Хеш содержимого в составе шапки сохранённой редакции: редакция, записанная до расширения состава
// (2.0.16.51 - Ответственный), сравнивается по своим реквизитам, иначе запись без изменений дала бы новую редакцию.
//
// Параметры:
//  Содержимое  - Структура - см. СодержимоеРедакции.
//  Предложение - ДокументСсылка.КоммерческоеПредложение - предложение.
//  Версия      - Число - номер сохранённой редакции.
//
// Возвращаемое значение:
//  Строка - хеш; пусто, если редакции нет.
//
Функция ХешВСоставеРедакции(Содержимое, Предложение, Версия) Экспорт
	Снимок = ДанныеРедакции(Предложение, Версия);
	Если Снимок = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	СоставШапки = Снимок.Объект.Шапка;
	// Ответственного старый состав не хранил, но печатал вместо пустого менеджера: его смена сверяется с напечатанным.
	Если Не СоставШапки.Свойство("Ответственный") И Не ЗначениеЗаполнено(Содержимое.Шапка.Менеджер)
		И СокрЛП(Содержимое.Шапка.Ответственный) <> Снимок.Печать.Шапка.Менеджер Тогда
		Возврат "";
	КонецЕсли;
	// Условий (2.0.16.137) старый состав не хранил и печатал без них: заполненное условие - изменение, пустое - нет.
	Для Каждого Имя Из СтрРазделить(НовыеРеквизитыРедакции(), ", ", Ложь) Цикл
		Если Не СоставШапки.Свойство(Имя) И ЗначениеЗаполнено(Содержимое.Шапка[Имя]) Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат ХешПоСоставу(Содержимое, СоставШапки);
КонецФункции

// Данные печати предложения на текущий момент: все представления - строками, картинки организации -
// двоичными данными. Этой же структурой печатается снимок редакции, поэтому она самодостаточна и
// справочники при перепечатке не читаются.
//
// Параметры:
//  Объект       - ДокументОбъект.КоммерческоеПредложение - предложение (в том числе ещё не записанное).
//  ДатаРедакции - Дата - дата редакции, которая печатается в строке номера; пустая - дата документа.
//
// Возвращаемое значение:
//  Структура - Организация, Клиент, Шапка, Товары (Массив из Структура), Итоги, Логотип, ПечатьОрганизации.
//
Функция ДанныеДляПечати(Объект, ДатаРедакции = Неопределено) Экспорт
	Дата = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
	ВалютаДокумента = РаботаСВалютами.ВалютаИКурсДокумента(Объект).Валюта;

	Данные = Новый Структура;
	// 2 - договор клиента без подписи и сумма прописью на каждом языке: снимок печатается на любом языке;
	// 3 - блоки сторон и итогов с кодами, банком и скидкой (общие с Facture, раздел 10.2 плана фирменной печати).
	Данные.Вставить("ВерсияФормата", ФирменнаяПечать.ВерсияФормата());
	Данные.Вставить("КодВалюты", СокрЛП(ВалютаДокумента));
	Данные.Вставить("Организация", ФирменнаяПечать.ДанныеОрганизации(Объект.Организация, Дата));
	Данные.Вставить("Клиент", ФирменнаяПечать.ДанныеКонтрагента(Объект.Контрагент, Объект.Договор, Дата));

	Шапка = Новый Структура;
	Шапка.Вставить("Номер", РаботаСДокументами.СформироватьЦифровойНомер(Объект.Номер));
	Шапка.Вставить("Дата", Объект.Дата);
	// Дата редакции хранится в снимке: у восстановленной начальной редакции дата записи в регистр - дата архива, а не
	// отправки (docs/plans/kp-print-terms.md, круг 2).
	Шапка.Вставить("ДатаРедакции", ?(ЗначениеЗаполнено(ДатаРедакции), ДатаРедакции, Объект.Дата));
	Шапка.Вставить("ДатаОтгрузки", Объект.ДатаОтгрузки);
	Шапка.Вставить("ЦенаВключаетНДС", Объект.ЦенаВключаетНДС);
	Менеджер = ?(ЗначениеЗаполнено(Объект.Менеджер), СокрЛП(Объект.Менеджер), СокрЛП(Объект.Ответственный));
	Шапка.Вставить("Менеджер", Менеджер);
	Шапка.Вставить("КонтактыМенеджера", КонтактыМенеджера(Объект, Дата));
	Шапка.Вставить("Комментарий", СокрЛП(Объект.Комментарий));
	Шапка.Вставить("ДействуетДо", Объект.ДействуетДо);
	Шапка.Вставить("УсловияПлатежа", УсловияПлатежаКлиента(Объект.Контрагент));
	Шапка.Вставить("УсловияПоставки", УсловияПоставки(Объект));
	Шапка.Вставить("СрокПоставки", СокрЛП(Объект.СрокПоставки));
	Данные.Вставить("Шапка", Шапка);

	СуммаСкидки = 0;
	Данные.Вставить("Товары", СтрокиДляПечати(Объект, СуммаСкидки));
	Итоги = ФирменнаяПечать.ДанныеИтогов(Объект.Сумма, Объект.СуммаНДС, Объект.СуммаБезНДС, ВалютаДокумента,
		СуммаСкидки);
	Данные.Вставить("Итоги", Итоги);

	Картинки = ПечатныеФормы.КартинкиОрганизации(Объект.Организация);
	Данные.Вставить("Логотип", Картинки.Логотип);
	Данные.Вставить("ПечатьОрганизации", Картинки.ПечатьОрганизации);
	Возврат Данные;
КонецФункции

// Снимок редакции для записи в регистр редакций.
//
// Параметры:
//  Объект       - ДокументОбъект.КоммерческоеПредложение - предложение.
//  ДатаРедакции - Дата - дата редакции для печати (см. ДанныеДляПечати).
//
// Возвращаемое значение:
//  Структура - Объект (см. СодержимоеРедакции) и Печать (см. ДанныеДляПечати).
//
Функция СнимокРедакции(Объект, ДатаРедакции) Экспорт
	Возврат Новый Структура("Объект, Печать", СодержимоеРедакции(Объект), ДанныеДляПечати(Объект, ДатаРедакции));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЦеныБезЗаверения

// Неиспользованная строка реализации-основания с теми же ценами: сначала среди строк с тем же кодом строки и товаром,
// затем среди строк того же товара. Найденная отмечается использованной.
//
// Параметры:
//  СтрокиОснования - ТаблицаЗначений - строки товаров реализации.
//  Строка          - СтрокаТабличнойЧасти - строка предложения.
//  Использованные  - Соответствие - строки основания, уже подтвердившие цену.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено
//
Функция СтрокаОснованияЦен(СтрокиОснования, Строка, Использованные)
	Отборы = Новый Массив;
	Если ЗначениеЗаполнено(Строка.КодСтроки) Тогда
		Отборы.Добавить("КодСтроки, Номенклатура, Характеристика, Упаковка");
	КонецЕсли;
	Отборы.Добавить("Номенклатура, Характеристика, Упаковка");
	Для Каждого Поля Из Отборы Цикл
		Отбор = Новый Структура(Поля);
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		Для Каждого Кандидат Из СтрокиОснования.НайтиСтроки(Отбор) Цикл
			Если Использованные.Получить(Кандидат) = Неопределено И ЦеныСтрокиСовпадают(Строка, Кандидат) Тогда
				Использованные.Вставить(Кандидат, Истина);
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Признак «Цена включает НДС», валюта и курс меняют стоимость при тех же числах в строках: без настройки «Заверение
// цен» у записанного предложения - как в базе; у нового - как при заполнении: по реализации-основанию (её признак и
// валюта, курс на дату предложения) или по умолчанию (признак - Истина или по виду цены документа, без валюты).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.КоммерческоеПредложение - предложение.
//  Основание - ДокументСсылка.РеализацияТоваровУслуг, Неопределено - проведённая реализация-основание.
//  ВидЦены   - СправочникСсылка.ВидыЦен - вид цены документа по умолчанию.
//  Ошибки    - Массив из Строка - дополняется.
//
Процедура ДобавитьОшибкиШапкиЦен(ДокОбъект, Основание, ВидЦены, Ошибки)
	ПризнакиНДС = Новый Массив;
	Если Не ДокОбъект.ЭтоНовый() Тогда
		Ожидаемые = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОбъект.Ссылка, "ЦенаВключаетНДС, ВВалюте, Валюта, КурсВалюты");
		ПризнакиНДС.Добавить(Ожидаемые.ЦенаВключаетНДС);
	ИначеЕсли Основание <> Неопределено Тогда
		ВалютаОснования = РаботаСВалютами.ВалютаИКурсОбъекта(Основание);
		Курс = ?(ВалютаОснования.ВВалюте, РаботаСВалютами.КурсВалюты(ВалютаОснования.Валюта, ДокОбъект.Дата), 0);
		Ожидаемые = Новый Структура("ВВалюте, Валюта, КурсВалюты", ВалютаОснования.ВВалюте, ВалютаОснования.Валюта,
			?(Курс > 0, Курс, ВалютаОснования.Курс));
		ПризнакиНДС.Добавить(Основание.ЦенаВключаетНДС);
	Иначе
		Ожидаемые = Новый Структура("ВВалюте, Валюта, КурсВалюты", Ложь);
		ПризнакиНДС.Добавить(Истина);
		ПризнакиНДС.Добавить(ОбщегоНазначенияВызовСервера.ЦенаВключаетНДСПоВидуЦен(ВидЦены));
	КонецЕсли;
	Допустимо = ПризнакиНДС.Найти(ДокОбъект.ЦенаВключаетНДС) <> Неопределено И ДокОбъект.ВВалюте = Ожидаемые.ВВалюте;
	Если Допустимо И ДокОбъект.ВВалюте Тогда
		Допустимо = ДокОбъект.Валюта = Ожидаемые.Валюта И ДокОбъект.КурсВалюты = Ожидаемые.КурсВалюты;
	КонецЕсли;
	Если Не Допустимо Тогда
		Ошибки.Добавить(НСтр("ru = 'Без настройки «Заверение цен» признак «Цена включает НДС», валюту и курс предложения изменить нельзя.';
			|fr = 'Sans le paramètre « Validation des prix », l''indicateur « Prix TTC », la devise et le cours de l''offre ne
			|sont pas modifiables.';
			|en = 'Without the ""Price approval"" setting, the ""Price includes VAT"" flag, currency and rate of the offer cannot
			|be changed.';
			|es = 'Sin el ajuste «Aprobación de precios» no se pueden cambiar el indicador «Precio con IVA», la moneda ni el
			|tipo de cambio de la oferta.'"));
	КонецЕсли;
КонецПроцедуры

Функция ДопустимыеВидыЦенНовыхСтрок(ДокОбъект, Прежние, СтрокиОснования)
	ВидыЦен = Новый Массив;
	ТипЦены = ?(ЗначениеЗаполнено(ДокОбъект.Контрагент), ДокОбъект.Контрагент.ТипЦены, Справочники.ВидыЦен.ПустаяСсылка());
	ВидыЦен.Добавить(?(ЗначениеЗаполнено(ТипЦены), ТипЦены, Справочники.ВидыЦен.Розничная));
	Если ТипЗнч(Прежние) = Тип("ТаблицаЗначений") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыЦен, Прежние.ВыгрузитьКолонку("ВидЦены"), Истина);
	КонецЕсли;
	Если СтрокиОснования <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыЦен, СтрокиОснования.ВыгрузитьКолонку("ВидЦены"), Истина);
	КонецЕсли;
	Возврат ВидыЦен;
КонецФункции

// Новые строки, чья цена не равна цене по виду цены документа или у которых есть скидки. Цены читаются один раз на
// вид цены - срезом прайса и фиксированных цен покупателя по всем строкам (ревью 2.0.17.24, круг 7).
//
// Параметры:
//  ДокОбъект   - ДокументОбъект.КоммерческоеПредложение - предложение.
//  НовыеСтроки - Массив из СтрокаТабличнойЧасти - строки без прежней версии и без строки основания.
//  ВидыЦен     - Массив из СправочникСсылка.ВидыЦен - допустимые виды цены новых строк.
//
// Возвращаемое значение:
//  Массив из СтрокаТабличнойЧасти
//
Функция НедопустимыеНовыеСтроки(ДокОбъект, НовыеСтроки, ВидыЦен)
	Результат = Новый Массив;
	ПоВидамЦен = Новый Соответствие;
	Для Каждого Строка Из НовыеСтроки Цикл
		Если Не ВидЦеныИСкидкиНовойСтрокиДопустимы(Строка, ВидыЦен) Тогда
			Результат.Добавить(Строка);
			Продолжить;
		КонецЕсли;
		Строки = ПоВидамЦен.Получить(Строка.ВидЦены);
		Если Строки = Неопределено Тогда
			Строки = Новый Массив;
			ПоВидамЦен.Вставить(Строка.ВидЦены, Строки);
		КонецЕсли;
		Строки.Добавить(Строка);
	КонецЦикла;
	Для Каждого КлючИЗначение Из ПоВидамЦен Цикл
		СДругойЦеной = СтрокиСДругойЦеной(ДокОбъект, КлючИЗначение.Ключ, КлючИЗначение.Значение);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, СДругойЦеной);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Источник цен - только проведённая реализация-основание: цены непроведённой контроль цен продажи не проходили.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.КоммерческоеПредложение - предложение.
//
// Возвращаемое значение:
//  ДокументСсылка.РеализацияТоваровУслуг, Неопределено
//
Функция ПроведеннаяРеализацияОснование(ДокОбъект)
	Основание = ДокОбъект.Основание;
	Если ТипЗнч(Основание) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Или Не ЗначениеЗаполнено(Основание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ?(Основание.Проведен, Основание, Неопределено);
КонецФункции

Функция ВидЦеныИСкидкиНовойСтрокиДопустимы(Строка, ВидыЦен)
	Если Не ЗначениеЗаполнено(Строка.ВидЦены) Или ВидыЦен.Найти(Строка.ВидЦены) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Строка.ПроцентСкидки = 0 И Строка.СкидкаНаЦену = 0 И Строка.СуммаСкидки = 0;
КонецФункции

Функция СтрокиСДругойЦеной(ДокОбъект, ВидЦены, Строки)
	ВидыЦен = Новый Массив;
	ВидыЦен.Добавить(ВидЦены);
	ТЗПоследнийПрайс = РегистрыСведений.ЦеныНоменклатуры.ПоследнийПрайс(ДокОбъект.Дата, ВидыЦен);
	Номенклатура = Новый Массив;
	Характеристики = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Номенклатура.Добавить(Строка.Номенклатура);
		Характеристики.Добавить(Строка.Характеристика);
	КонецЦикла;
	ДанныеЦен = ОбщегоНазначенияВызовСервера.ДанныеЦенДляСписка(ДокОбъект.Контрагент, Ложь, Номенклатура, Характеристики,
		ВидЦены, ДокОбъект.Дата);
	Если ДокОбъект.ВВалюте Тогда
		Курс = РаботаСВалютамиКлиентСервер.КурсДокумента(ДокОбъект);
		ВалютаДокумента = Новый Структура("Валюта, Курс, Дата", ДокОбъект.Валюта, Курс, ДокОбъект.Дата);
		ДанныеЦен.Вставить("ВалютаДокумента", ВалютаДокумента);
	КонецЕсли;
	Допуск = 0.005;
	Результат = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		ДанныеСтроки = РаботаСДокументамиКлиентСервер.ПреобразоватьСтрокуТаблицыВСтруктуру(Строка, ДокОбъект);
		ОбщегоНазначенияВызовСервера.ПолучитьЦенуНоменклатуры(ДанныеСтроки, ТЗПоследнийПрайс, ДокОбъект.ЦенаВключаетНДС,
			ДанныеЦен);
		Если Макс(ДанныеСтроки.Цена - Строка.Цена, Строка.Цена - ДанныеСтроки.Цена) >= Допуск Тогда
			Результат.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЦеныСтрокиСовпадают(Строка, Прежняя)
	Допуск = 0.005;
	Для Каждого Имя Из СтрРазделить("ВидЦены,Цена,ПроцентСкидки,СкидкаНаЦену", ",") Цикл
		Если Строка[Имя] <> Прежняя[Имя] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	// Сумма скидки зависит от количества: не больше прежней в пересчёте на новое количество.
	Предел = Прежняя.СуммаСкидки;
	Если Прежняя.КоличествоУпаковок <> 0 И Строка.КоличествоУпаковок <> Прежняя.КоличествоУпаковок Тогда
		Предел = Прежняя.СуммаСкидки * Строка.КоличествоУпаковок / Прежняя.КоличествоУпаковок;
	КонецЕсли;
	Возврат Строка.СуммаСкидки <= Предел + Допуск;
КонецФункции

#КонецОбласти

#Область СинхронизацияСРеализациями

Процедура ЗаблокироватьРеализации(Реализации)
	// Порядок блокировок один: сначала реализация, потом её КП (при записи реализации платформа уже держит её -
	// повтор безвреден).
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Реализация Из Реализации Цикл
		ЭлементБлокировки = Блокировка.Добавить("Документ.РеализацияТоваровУслуг");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Реализация);
	КонецЦикла;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ЗаблокироватьАвтоКП(Реализации)
	// Флаг КП меняет и служебная запись заказа («Выигран»), которая реализацию не блокирует: прочитанный флаг
	// защищает только блокировка самого КП (круг 1 фазы 2, P1). Данные КП перечитываются после неё.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Предложения.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КоммерческоеПредложение КАК Предложения
	|ГДЕ
	|	Предложения.Основание В (&Реализации)
	|	И Предложения.Автосинхронизация");
	Запрос.УстановитьПараметр("Реализации", Реализации);
	Предложения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Предложения.Количество() = 0 Тогда
		Возврат Предложения;
	КонецЕсли;
	// Вместе с документом - его редакции: загрузка обмена пишет их без записи документа. Порядок «документ КП -> его
	// редакции» тот же, что у ОпределитьРедакцию.
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Предложение Из Предложения Цикл
		ЭлементБлокировки = Блокировка.Добавить("Документ.КоммерческоеПредложение");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Предложение);
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.РедакцииКоммерческихПредложений");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Предложение", Предложение);
	КонецЦикла;
	Блокировка.Заблокировать();
	Возврат Предложения;
КонецФункции

// Данные реализаций и их авто-КП одним пакетом - после блокировки.
//
// Параметры:
//  Реализации      - Массив из ДокументСсылка.РеализацияТоваровУслуг - реализации.
//  Заблокированные - Массив из ДокументСсылка.КоммерческоеПредложение - авто-КП, заблокированные протоколом.
//
// Возвращаемое значение:
//  Структура - Реализации, Строки, Предложения, СтрокиПредложений (ТаблицаЗначений, индексы по ссылке).
//
Функция ДанныеСинхронизации(Реализации, Заблокированные)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Реализация.Ссылка КАК Ссылка,
	|	Реализация.Номер КАК Номер,
	|	Реализация.Дата КАК Дата,
	|	Реализация.ПометкаУдаления КАК ПометкаУдаления,
	|	Реализация.Организация КАК Организация,
	|	Реализация.Контрагент КАК Контрагент,
	|	Реализация.Договор КАК Договор,
	|	Реализация.Менеджер КАК Менеджер,
	|	Реализация.Ответственный КАК Ответственный,
	|	Реализация.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Реализация.ВВалюте КАК ВВалюте,
	|	Реализация.Валюта КАК Валюта,
	|	Реализация.КурсВалюты КАК КурсВалюты,
	|	Реализация.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Ссылка В (&Реализации)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	0 КАК Вид,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.НоменклатураСтрока КАК НоменклатураСтрока,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Количество КАК Количество,
	|	Товары.ВидЦены КАК ВидЦены,
	|	Товары.ЦенаSKU КАК ЦенаSKU,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.ПроцентСкидки КАК ПроцентСкидки,
	|	Товары.СуммаСкидки КАК СуммаСкидки,
	|	Товары.СуммаСНДС КАК СуммаСНДС,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.СкидкаНаЦену КАК СкидкаНаЦену,
	|	Товары.СуммаРегл КАК СуммаРегл,
	|	"""" КАК Содержание,
	|	ЕСТЬNULL(Карточки.ВыводитьНаПечатьОписание, ЛОЖЬ) КАК ВыводитьНаПечатьОписание,
	|	Карточки.Описание КАК ОписаниеКарточки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Карточки
	|		ПО Товары.Номенклатура = Карточки.Ссылка
	|ГДЕ
	|	Товары.Ссылка В (&Реализации)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Услуги.Ссылка,
	|	1,
	|	Услуги.НомерСтроки,
	|	0,
	|	Услуги.Номенклатура,
	|	"""",
	|	NULL,
	|	NULL,
	|	Услуги.Количество,
	|	Услуги.Количество,
	|	NULL,
	|	0,
	|	Услуги.Цена,
	|	Услуги.Сумма,
	|	0,
	|	0,
	|	Услуги.СуммаСНДС,
	|	Услуги.СтавкаНДС,
	|	Услуги.СуммаНДС,
	|	0,
	|	Услуги.СуммаРегл,
	|	Услуги.Содержание,
	|	ЕСТЬNULL(Карточки.ВыводитьНаПечатьОписание, ЛОЖЬ),
	|	Карточки.Описание
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧУслуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Карточки
	|		ПО Услуги.Номенклатура = Карточки.Ссылка
	|ГДЕ
	|	Услуги.Ссылка В (&Реализации)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Вид,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Предложения.Ссылка КАК Ссылка,
	|	Предложения.Основание КАК Основание,
	|	Предложения.Номер КАК Номер,
	|	Предложения.Дата КАК Дата,
	|	Предложения.ПометкаУдаления КАК ПометкаУдаления,
	|	Предложения.Организация КАК Организация,
	|	Предложения.Контрагент КАК Контрагент,
	|	Предложения.Договор КАК Договор,
	|	Предложения.Менеджер КАК Менеджер,
	|	Предложения.Ответственный КАК Ответственный,
	|	Предложения.ДатаОтгрузки КАК ДатаОтгрузки,
	|	Предложения.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Предложения.ВВалюте КАК ВВалюте,
	|	Предложения.Валюта КАК Валюта,
	|	Предложения.КурсВалюты КАК КурсВалюты,
	|	Предложения.Комментарий КАК Комментарий,
	|	Предложения.Статус КАК Статус,
	|	Предложения.Версия КАК Версия
	|ИЗ
	|	Документ.КоммерческоеПредложение КАК Предложения
	|ГДЕ
	|	Предложения.Ссылка В (&Заблокированные)
	|	И Предложения.Автосинхронизация
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПометкаУдаления,
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Ссылка КАК Ссылка,
	|	Строки.НомерСтроки КАК НомерСтроки,
	|	Строки.КодСтроки КАК КодСтроки,
	|	Строки.Номенклатура КАК Номенклатура,
	|	Строки.НоменклатураСтрока КАК НоменклатураСтрока,
	|	Строки.Характеристика КАК Характеристика,
	|	Строки.Упаковка КАК Упаковка,
	|	Строки.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Строки.Количество КАК Количество,
	|	Строки.ВидЦены КАК ВидЦены,
	|	Строки.ЦенаSKU КАК ЦенаSKU,
	|	Строки.Цена КАК Цена,
	|	Строки.Сумма КАК Сумма,
	|	Строки.ПроцентСкидки КАК ПроцентСкидки,
	|	Строки.СуммаСкидки КАК СуммаСкидки,
	|	Строки.СуммаСНДС КАК СуммаСНДС,
	|	Строки.СтавкаНДС КАК СтавкаНДС,
	|	Строки.СуммаНДС КАК СуммаНДС,
	|	Строки.СкидкаНаЦену КАК СкидкаНаЦену,
	|	Строки.Описание КАК Описание,
	|	Строки.СуммаРегл КАК СуммаРегл
	|ИЗ
	|	Документ.КоммерческоеПредложение.ТЧТовары КАК Строки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КоммерческоеПредложение КАК Предложения
	|		ПО Строки.Ссылка = Предложения.Ссылка
	|ГДЕ
	|	Предложения.Ссылка В (&Заблокированные)
	|	И Предложения.Автосинхронизация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Редакции.Предложение КАК Ссылка
	|ИЗ
	|	РегистрСведений.РедакцииКоммерческихПредложений КАК Редакции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КоммерческоеПредложение КАК Предложения
	|		ПО Редакции.Предложение = Предложения.Ссылка
	|ГДЕ
	|	Предложения.Ссылка В (&Заблокированные)
	|	И Предложения.Автосинхронизация");
	Запрос.УстановитьПараметр("Реализации", Реализации);
	// Только заблокированные КП: появившийся после блокировки (загрузкой обмена) в этот раз не трогается, следующая
	// синхронизация разберёт его как дубль.
	Запрос.УстановитьПараметр("Заблокированные", Заблокированные);
	Пакет = Запрос.ВыполнитьПакет();
	// BSLLS:MagicNumber-off - номера запросов пакета.
	Данные = Новый Структура;
	Данные.Вставить("Реализации", Пакет[0].Выгрузить());
	Данные.Вставить("Строки", Пакет[1].Выгрузить());
	Данные.Вставить("Предложения", Пакет[2].Выгрузить());
	Данные.Вставить("СтрокиПредложений", Пакет[3].Выгрузить());
	Данные.Вставить("СРедакциями", Пакет[4].Выгрузить().ВыгрузитьКолонку(ПолеСсылки()));
	// BSLLS:MagicNumber-on
	Данные.Реализации.Индексы.Добавить(ПолеСсылки());
	Данные.Строки.Индексы.Добавить(ПолеСсылки());
	Данные.Предложения.Индексы.Добавить("Основание");
	Данные.СтрокиПредложений.Индексы.Добавить(ПолеСсылки());
	Возврат Данные;
КонецФункции

Функция СинхронизироватьПредложение(Реализация, Данные)
	Отбор = Новый Структура(ПолеСсылки(), Реализация);
	НайденныеРеализации = Данные.Реализации.НайтиСтроки(Отбор);
	// Удалённой реализации в базе нет - синхронизировать нечего.
	Если НайденныеРеализации.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Желаемое = СодержимоеАвтоКП(НайденныеРеализации[0], Данные.Строки.НайтиСтроки(Отбор));

	// Отправленный или имеющий редакции КП (например, пришедший загрузкой обмена, где ПередЗаписью не работает) не
	// перезаписывается: он передаётся человеку без изменения данных - до заполнения объекта (9.5 п. 4). Редакции -
	// по регистру, источнику истины ОпределитьРедакцию: реквизит Версия после обмена может с ним расходиться.
	Предложения = Новый Массив;
	Для Каждого Найденное Из Данные.Предложения.НайтиСтроки(Новый Структура("Основание", Реализация)) Цикл
		Если СтатусОтправлен(Найденное.Статус) Или Найденное.Версия > 0
			Или Данные.СРедакциями.Найти(Найденное.Ссылка) <> Неопределено Тогда
			СнятьАвтосинхронизацию(Найденное.Ссылка, Реализация, ПричинаОтправлен());
		Иначе
			Предложения.Добавить(Найденное);
		КонецЕсли;
	КонецЦикла;

	Если Предложения.Количество() = 0 Тогда
		Предложение = Документы.КоммерческоеПредложение.СоздатьДокумент();
		ЗаписатьАвтоКП(Предложение, Реализация, Желаемое);
		Возврат Предложение.Ссылка;
	КонецЕсли;

	// Дубли прошлых сбоев: актуален первый в порядке запроса (не помеченный, затем по ссылке), остальные
	// передаются человеку - флаг снимается, факт - в журнал регистрации.
	Актуальный = Предложения[0];
	Для Индекс = 1 По Предложения.ВГраница() Цикл
		СнятьАвтосинхронизацию(Предложения[Индекс].Ссылка, Реализация, ПричинаДубль(Актуальный.Ссылка));
	КонецЦикла;

	Текущее = СодержимоеЗаписанногоАвтоКП(Актуальный,
		Данные.СтрокиПредложений.НайтиСтроки(Новый Структура(ПолеСсылки(), Актуальный.Ссылка)));
	Если ОтпечатокСодержимого(Текущее) <> ОтпечатокСодержимого(Желаемое) Тогда
		ЗаписатьАвтоКП(Актуальный.Ссылка.ПолучитьОбъект(), Реализация, Желаемое);
	КонецЕсли;
	Возврат Актуальный.Ссылка;
КонецФункции

// Содержимое авто-КП по данным реализации (соответствие колонок - docs/plans/branded-print.md, 9.6). Значения
// приведены к типам реквизитов КП: сравнение с записанным КП не даёт ложных отличий.
//
// Параметры:
//  Шапка  - СтрокаТаблицыЗначений - шапка реализации, см. ДанныеСинхронизации.
//  Строки - Массив из СтрокаТаблицыЗначений - строки товаров и услуг реализации.
//
// Возвращаемое значение:
//  Структура - Шапка (Структура), Товары (Массив из Структура).
//
Функция СодержимоеАвтоКП(Шапка, Строки)
	МетаданныеКП = Метаданные.Документы.КоммерческоеПредложение;
	Реквизиты = Новый Структура(РеквизитыШапкиАвтоКП());
	ЗаполнитьЗначенияСвойств(Реквизиты, Шапка);
	Реквизиты.ДатаОтгрузки = НачалоДня(Шапка.Дата);
	Реквизиты.Статус = Перечисления.СтатусыКоммерческихПредложений.Черновик;
	// Номер КП фиксированной длины дополняется пробелами, номер реализации - переменной длины: сравнивается без них.
	Реквизиты.Номер = СокрЛП(Шапка.Номер);
	// Та же нормализация валюты, что при записи КП: иначе сравнение видело бы отличие там, где запись его сотрёт.
	РаботаСВалютами.ПроверитьВалютуДокумента(Реквизиты);
	Для Каждого КлючИЗначение Из Реквизиты Цикл
		Реквизиты[КлючИЗначение.Ключ] = ПривестиКТипу(МетаданныеКП, КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

	МетаданныеТоваров = МетаданныеКП.ТабличныеЧасти.ТЧТовары;
	КодСтроки = 0;
	Для Каждого СтрокаРеализации Из Строки Цикл
		Если СтрокаРеализации.Вид = 0 Тогда
			КодСтроки = Макс(КодСтроки, СтрокаРеализации.КодСтроки);
		КонецЕсли;
	КонецЦикла;
	Товары = Новый Массив;
	Для Каждого СтрокаРеализации Из Строки Цикл
		Товар = Новый Структура(КолонкиТоваровАвтоКП());
		ЗаполнитьЗначенияСвойств(Товар, СтрокаРеализации);
		ОписаниеКарточки = ?(СтрокаРеализации.ВыводитьНаПечатьОписание = Истина,
			СтрокаРеализации.ОписаниеКарточки, "");
		Если СтрокаРеализации.Вид = 0 Тогда
			Товар.Описание = ОписаниеКарточки;
			// КП печатает количество упаковок; у строки без упаковки оно - количество (исторические строки - ноль).
			Если Не ЗначениеЗаполнено(СтрокаРеализации.Упаковка) Тогда
				Товар.КоличествоУпаковок = СтрокаРеализации.Количество;
			КонецЕсли;
		Иначе
			// Услуга: содержание - описанием строки, как акт печатает его рядом с наименованием; номер строки - после
			// товаров.
			КодСтроки = КодСтроки + 1;
			Товар.КодСтроки = КодСтроки;
			// Оба текста, как их выводит акт: содержание услуги и описание карточки для печати.
			Описание = СокрЛП(СтрокаРеализации.Содержание);
			ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Описание, СокрЛП(ОписаниеКарточки), Символы.ПС);
			Товар.Описание = Описание;
		КонецЕсли;
		Для Каждого КлючИЗначение Из Товар Цикл
			Товар[КлючИЗначение.Ключ] = ПривестиКТипу(МетаданныеТоваров, КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Товары.Добавить(Товар);
	КонецЦикла;
	Возврат Новый Структура("Шапка, Товары", Реквизиты, Товары);
КонецФункции

Функция СодержимоеЗаписанногоАвтоКП(Шапка, Строки)
	Реквизиты = Новый Структура(РеквизитыШапкиАвтоКП());
	ЗаполнитьЗначенияСвойств(Реквизиты, Шапка);
	Реквизиты.Номер = СокрЛП(Шапка.Номер);
	Товары = Новый Массив;
	Для Каждого СтрокаПредложения Из Строки Цикл
		Товар = Новый Структура(КолонкиТоваровАвтоКП());
		ЗаполнитьЗначенияСвойств(Товар, СтрокаПредложения);
		Товары.Добавить(Товар);
	КонецЦикла;
	Возврат Новый Структура("Шапка, Товары", Реквизиты, Товары);
КонецФункции

Функция ОтпечатокСодержимого(Содержимое)
	Значения = Новый Массив;
	Для Каждого Имя Из СтрРазделить(РеквизитыШапкиАвтоКП(), ", ", Ложь) Цикл
		Значения.Добавить(Содержимое.Шапка[Имя]);
	КонецЦикла;
	// СуммаРегл пересчитывает запись КП из суммы и курса, которые сравниваются и так.
	Колонки = СтрРазделить(КолонкиТоваровАвтоКП(), ", ", Ложь);
	Колонки.Удалить(Колонки.Найти("СуммаРегл"));
	Для Каждого Товар Из Содержимое.Товары Цикл
		Для Каждого Имя Из Колонки Цикл
			Значения.Добавить(Товар[Имя]);
		КонецЦикла;
	КонецЦикла;
	Возврат ЗначениеВСтрокуВнутр(Значения);
КонецФункции

Процедура ЗаписатьАвтоКП(Предложение, Реализация, Содержимое)
	ЗаполнитьЗначенияСвойств(Предложение, Содержимое.Шапка);
	Предложение.Основание = Реализация;
	Предложение.Автосинхронизация = Истина;
	Предложение.ТЧТовары.Очистить();
	Для Каждого Товар Из Содержимое.Товары Цикл
		ЗаполнитьЗначенияСвойств(Предложение.ТЧТовары.Добавить(), Товар);
	КонецЦикла;
	ЗаписатьСинхронизацией(Предложение, Реализация);
КонецПроцедуры

Процедура СнятьАвтосинхронизацию(Ссылка, Реализация, Причина)
	// Меняется только флаг: запись загрузкой не нормализует валюту, не пересчитывает итоги и не пишет редакцию - КП,
	// переданный человеку, остаётся таким, каким его видел клиент (9.5 п. 4). КП заблокирован протоколом.
	Предложение = Ссылка.ПолучитьОбъект();
	Предложение.Автосинхронизация = Ложь;
	Предложение.ОбменДанными.Загрузка = Истина;
	ЗаписатьСинхронизацией(Предложение, Реализация);
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	ШаблонКомментария = НСтр("ru = 'Коммерческое предложение %1 по реализации %2 передано пользователю, автосинхронизация
		|снята: %3'; fr = 'Le devis %1 du bon de livraison %2 est remis à l''utilisateur, synchronisation automatique
		|désactivée : %3'; en = 'Quotation %1 for sales document %2 is handed over to the user, auto-sync is off: %3';
		|es = 'El presupuesto %1 del albarán %2 se entrega al usuario, sincronización automática desactivada: %3'",
		КодЯзыка);
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение,
		Метаданные.Документы.КоммерческоеПредложение, Ссылка, СтрШаблон(ШаблонКомментария, Ссылка, Реализация, Причина));
КонецПроцедуры

Функция ПричинаОтправлен()
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Возврат НСтр("ru = 'предложение отправлено или имеет редакции'; fr = 'le devis est envoyé ou a des révisions';
		|en = 'the quotation is sent or has revisions'; es = 'el presupuesto está enviado o tiene revisiones'", КодЯзыка);
КонецФункции

Функция ПричинаДубль(Актуальный)
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Шаблон = НСтр("ru = 'дубль, синхронизируется %1'; fr = 'doublon, synchronisé : %1'; en = 'duplicate, synced: %1';
		|es = 'duplicado, se sincroniza %1'", КодЯзыка);
	Возврат СтрШаблон(Шаблон, Актуальный);
КонецФункции

Функция БезПовторов(Ссылки)
	Результат = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		Если ЗначениеЗаполнено(Ссылка) И Результат.Найти(Ссылка) = Неопределено Тогда
			Результат.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаписатьСинхронизацией(Предложение, Реализация)
	Предложение.ДополнительныеСвойства.Вставить(КлючСинхронизации(), Истина);
	Попытка
		Предложение.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ШаблонОшибки = НСтр("ru = 'Не удалось записать коммерческое предложение по реализации %1: %2';
			|fr = 'Impossible d''enregistrer le devis du bon de livraison %1 : %2';
			|en = 'Could not save the quotation for sales document %1: %2';
			|es = 'No se pudo guardar el presupuesto del albarán %1: %2'");
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон(ШаблонОшибки, Реализация, ТекстОшибки);
	КонецПопытки;
КонецПроцедуры

Функция ПривестиКТипу(МетаданныеВладельца, Имя, Значение)
	// Стандартные реквизиты (Номер, Дата, ПометкаУдаления) у реализации и КП одного типа - приводить нечего.
	Реквизит = МетаданныеВладельца.Реквизиты.Найти(Имя);
	Если Реквизит = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Реквизит.Тип.ПривестиЗначение(Значение);
КонецФункции

