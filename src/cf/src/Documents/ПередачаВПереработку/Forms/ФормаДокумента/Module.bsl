#КонецОбласти

#Область ОбработчикиКомандФормы

// Пересобирает ожидаемую продукцию по требованию пользователя и снимает признак ручной правки: команда для того и
// нужна, чтобы вернуться к расчёту после собственных изменений.
//
// Параметры:
//  Команда - КомандаФормы - команда таблицы продукции.
//
&НаКлиенте
Процедура ЗаполнитьОжидаемуюПродукцию(Команда)
	ПродукцияПравиласьВручную = Ложь;
	ЗаполнитьОжидаемуюПродукциюНаСервере(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пересчёт ожидаемой продукции по строкам товаров. Молча не затирает ручную правку: пользователь, поправивший
// продукцию, владеет ею до нажатия «Заполнить по заказу».
//
// Параметры:
//  Удаляемые - Массив, Неопределено - идентификаторы удаляемых строк товаров, исключаемых из расчёта.
//
&НаКлиенте
Процедура ПересобратьОжидаемуюПродукцию(Удаляемые = Неопределено)
	Если ПродукцияПравиласьВручную Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьОжидаемуюПродукциюНаСервере(Удаляемые);
КонецПроцедуры

// Зовёт то же правило, что обработка заполнения и проведение: Документы.ПередачаВПереработку.ОжидаемаяПродукцияПередачи.
// Весь документ на сервер не переносится - только строки товаров.
//
// Параметры:
//  Удаляемые - Массив, Неопределено - см. ПересобратьОжидаемуюПродукцию.
//
&НаСервере
Процедура ЗаполнитьОжидаемуюПродукциюНаСервере(Знач Удаляемые)
	Если ТипЗнч(Объект.Основание) <> Тип("ДокументСсылка.ЗаказПокупателя") Или Не ЗначениеЗаполнено(Объект.Основание) Тогда
		Возврат;
	КонецЕсли;
	ТЗТовары = Объект.ТЧТовары.Выгрузить();
	Если ТипЗнч(Удаляемые) = Тип("Массив") Тогда
		Для Каждого Идентификатор Из Удаляемые Цикл
			Строка = Объект.ТЧТовары.НайтиПоИдентификатору(Идентификатор);
			Если Строка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Индекс = Объект.ТЧТовары.Индекс(Строка);
			Если Индекс >= 0 И Индекс < ТЗТовары.Количество() Тогда
				ТЗТовары[Индекс].Количество = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Продукция = Документы.ПередачаВПереработку.ОжидаемаяПродукцияПередачи(Объект.Основание, ТЗТовары);
	Объект.ТЧГотоваяПродукция.Загрузить(Продукция);
	Для Каждого Стр Из Объект.ТЧГотоваяПродукция Цикл
		Стр.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Объект.ТЧГотоваяПродукция);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПоказатьСебестоимость()
	// Себестоимость списанного сырья по движениям проведённого документа.
	ТЗСебестоимость = РегистрыНакопления.ТоварыВНаличии.ПолучитьСебестоимостьПоДокументу(Объект.Ссылка);
	Для Каждого Стр Из Объект.ТЧТовары Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия);
		Отбор.Вставить("ВидДвижения", ВидДвиженияНакопления.Расход);
		Мас = ТЗСебестоимость.НайтиСтроки(Отбор);
		Если Мас.Количество() = 0 Тогда
			Стр.Себестоимость = 0;
		ИначеЕсли Мас[0].Количество = Стр.Количество Тогда
			Стр.Себестоимость = Мас[0].Сумма;
		Иначе
			Стр.Себестоимость = Мас[0].Сумма / Мас[0].Количество * Стр.Количество;
		КонецЕсли;
	КонецЦикла;
	ОбщаяСебестоимость = ТЗСебестоимость.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура ПослеДобавленияНоменклатуры(Результат, ДополнительныеПараметры) Экспорт
	Штрихкод = ДополнительныеПараметры.Штрихкод;
	СтруктураТовара = ОбщегоНазначенияВызовСервера.ПолучитьНоменклатуруПоШтрихкоду(Штрихкод);
	РаботаСДокументамиКлиентСервер.ДобавитьНоменклатуруПоШтрихкоду(Штрихкод, Объект, СтруктураТовара, , , ЭтотОбъект);
	// Сканирование - штатный способ набора строк этого документа, оборудование подключается при открытии формы.
	ПересобратьОжидаемуюПродукцию();
КонецПроцедуры

#КонецОбласти
