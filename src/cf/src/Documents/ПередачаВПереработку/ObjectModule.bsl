#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Основание = ДанныеЗаполнения;
		Организация = ДанныеЗаполнения.Организация;
		ЗаполнитьОжидаемуюПродукциюПоЗаказу(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВыпускПродукции") Тогда
		ЗаполнитьПоВыпускуПродукции(ДанныеЗаполнения);
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Наборы очищаются явно: объект, проведённый в этом же экземпляре (повторное «Провести» в открытой форме,
	// перепроведение в сценарии), держит в памяти движения прошлого проведения, а СписатьНоменклатуру их не
	// чистит, а ДОПИСЫВАЕТ свои. Без очистки второе проведение уводит склад в минус на объём документа.
	Для Каждого НаборЗаписей Из Движения Цикл
		НаборЗаписей.Очистить();
	КонецЦикла;
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	// Данные для проведения
	ДополнительныеСвойства.Вставить("ТЗТоварыССериями", СерииИРазмещение.ОбъединитьТоварыССериями(ЭтотОбъект));
	// Контекст автовыпуска и блокировки проведения взяты в ПередЗаписью - до автоудаления прежних движений (план
	// subcontract-multi-order, ревью плана, раунд 16); повторный захват тех же ключей в транзакции ничего не меняет.
	КонтекстАвтовыпуска = КонтекстАвтовыпускаЗаписи(Ложь);
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка, КонтекстАвтовыпуска);
	Блокировка.Заблокировать();
	// Продукция заказа на станке (открытое требование-накладная) в переработку не передается (P1-1, N2) - по каждому
	// заказу строк. Пересчет стоимости историю не перепроверяет: требование, открытое позже, прежнюю передачу ошибочной
	// не делает. Наборы передачи все стоимостные и при AutoDelete пишутся целиком (план warehouse-orders-cost, Ф1.2).
	Если Не РаботаСДокументами.ПересчетСтоимости(ЭтотОбъект) Тогда
		ПроверитьПродукциюНаСтанках(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Автовыпуск полуфабриката - на секунду раньше передачи, до её списания со склада (S4)
	Производство.ОбеспечитьАвтовыпуск(ЭтотОбъект, КонтекстАвтовыпуска, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Формируем: списание со склада и приход в переработку - в диспетчере ТоварыВНаличии
	Если Не РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(ЭтотОбъект) Тогда
		ПодсказатьАвтовыпускОбщейПередачи();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Движения.Записать();
	// Уже списанное поступлениями не уходит в минус: уменьшение строк, смена заказа или переработчика (план
	// subcontract-multi-order, ревью плана, раунды 10-12).
	ТекстЗапрета = РегистрыНакопления.ТоварыВПереработке.ТекстОтрицательныхОстатков(КонтрагентыКонтроля(),
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка));
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, ЭтотОбъект, , , Отказ);
		Возврат;
	КонецЕсли;
	// Стадии заказов пересчитываются последней строкой проведения: блокировка истории статусов - последняя (E8).
	ПроизводственныеЗаказы.ОбновитьСтадииПослеПроведения(ЭтотОбъект);
КонецПроцедуры

// Отмена проведения передачи по заказу на производство: блокировки в порядке проведения, распроведение
// автовыпуска (S4), очистка движений и пересчёт стадий заказов (E8). Без таких заказов и автовыпуска движения
// удаляет платформа, как раньше.
//
// Параметры:
//  Отказ - Булево - устанавливается, если автовыпуск лежит в закрытом периоде.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	// Блокировки и проверка «по передаче уже списано» - в ПередЗаписью, до автоудаления движений.
	КонтекстАвтовыпуска = КонтекстАвтовыпускаЗаписи(Истина);
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка, КонтекстАвтовыпуска);
	Если КонтекстАвтовыпуска.Автовыпуски.Количество() > 0 Тогда
		Блокировка.Заблокировать();
		Производство.ОтменитьАвтовыпуск(ЭтотОбъект, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ПроизводственныеЗаказы.ОтменитьПроведениеДокумента(ЭтотОбъект, Блокировка);
КонецПроцедуры

// Прямое удаление передачи кодом снимает её движения без ОбработкаУдаленияПроведения: автовыпуск распроводится и
// помечается на удаление, чтобы не остаться проведённым с потерянным основанием (S4).
//
// Параметры:
//  Отказ - Булево - устанавливается, если автовыпуск лежит в закрытом периоде.
//
Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Удаление передачи, по партиям которой уже списано, увело бы остаток у переработчика в минус - запрет под
	// блокировкой прежних ключей, независимо от автовыпуска (ревью плана subcontract-multi-order, раунд 11).
	ЗаблокироватьПередачу();
	КонтекстАвтовыпуска = Производство.КонтекстАвтовыпуска(ЭтотОбъект, Истина);
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка, КонтекстАвтовыпуска);
	Блокировка.Заблокировать();
	Если РегистрыНакопления.ТоварыВПереработке.ЕстьСписаниеПоПередаче(Ссылка) Тогда
		СообщитьОСписании(Отказ);
		Возврат;
	КонецЕсли;
	Если КонтекстАвтовыпуска.Автовыпуски.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Производство.ОтменитьАвтовыпуск(ЭтотОбъект, Отказ, Истина);
КонецПроцедуры

// Блокировки проведения и отмены проведения - один набор в одном порядке (E8). Набор строится ОДНИМ местом
// (`Производство.ЗаполнитьБлокировкуПередачи`): тот же порядок нужен рабочему месту производства, которое
// блокирует передачу перед правкой её строк, а два разных набора в одной транзакции дают эскалацию.
//
// Параметры:
//  Блокировка          - БлокировкаДанных - заполняемая блокировка.
//  КонтекстАвтовыпуска - Структура - см. Производство.КонтекстАвтовыпуска.
//
Процедура ЗаполнитьБлокировкуПроведения(Блокировка, КонтекстАвтовыпуска)
	Производство.ЗаполнитьБлокировкуПередачи(Блокировка, КонтекстАвтовыпуска, ТЧТовары, МестоХранения, Контрагент,
		?(ЭтоНовый(), Неопределено, Ссылка));
	// Потребности заказов строк - последними и без автовыпуска: сверка с открытыми требованиями-накладными (N2). Заказы
	// упорядочены (ПроизводственныеЗаказы.ЗаказыСтрокПереработки) - порядок общий у всех документов.
	Для Каждого Заказ Из ПроизводственныеЗаказы.ЗаказыСтрокПереработки(ЭтотОбъект) Цикл
		УправляемыеБлокировки.ПотребностиПроизводства(Блокировка, Заказ);
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ЗначениеЗаполнено(Контрагент)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Субподрядчик") <> Истина Тогда
		ТекстОшибки = НСтр("ru = 'В карточке контрагента не установлен признак «Субподрядчик»';
			|fr = 'La case « Sous-traitant » n''est pas cochée dans la fiche du tiers';
			|en = 'The ""Subcontractor"" flag is not set in the counterparty card';
			|es = 'La casilla «Subcontratista» no está marcada en la ficha de la contraparte'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Контрагент", , Отказ);
	КонецЕсли;
	ПроверитьЗаказыСтрокОбщей(Отказ);
	ПроверитьПродукциюСтрок(Отказ);
	ПроверитьСменуПродукцииПриПоступлениях(Отказ);
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Протокол блокировки передачи (план subcontract-multi-order, ревью плана, раунды 9-16): сама передача -
	// исключительно и первой; затем, если документ проводится, распроводится или проведён, - весь набор проведения с
	// прежними ключами движений, до их автоудаления; решающие проверки - под ним.
	Если Не ЭтоНовый() Тогда
		ЗаблокироватьПередачу();
	КонецЕсли;
	ПривестиЗаказыСтрок(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ЗаблокироватьЗаказыСтрок();
	Если Не ЭтоНовый() Тогда
		Снимок = СнимокДвижений();
		ДополнительныеСвойства.Вставить(ИмяСвойстваСнимка(), Снимок);
		Если РежимЗаписи <> РежимЗаписиДокумента.Запись Или Проведен Тогда
			ДляОтмены = РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
			КонтекстАвтовыпуска = Производство.КонтекстАвтовыпуска(ЭтотОбъект, ДляОтмены);
			ДополнительныеСвойства.Вставить(ИмяСвойстваКонтекста(ДляОтмены), КонтекстАвтовыпуска);
			Блокировка = Новый БлокировкаДанных;
			ЗаполнитьБлокировкуПроведения(Блокировка, КонтекстАвтовыпуска);
			Блокировка.Заблокировать();
		КонецЕсли;
		ПроверитьСменуОснованияИПереработчика(Отказ, РежимЗаписи, Снимок);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	Если Не Отказ Тогда
		ПроизводственныеЗаказы.ЗапомнитьЗаказыДокумента(ЭтотОбъект, РежимЗаписи);
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Пометка удаления непроведённой передачи переходит на её автовыпуск - до записи статусов (S4). Проведение и
	// отмену проведения обслуживают обработчики проведения.
	Если ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Производство.ПометитьАвтовыпуск(ЭтотОбъект, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	РаботаСДокументами.ОбновитьПроизводственныйСтатусЗаказа(ЭтотОбъект);
	// Проведённый документ, перезаписанный без перепроведения, пересчитывает стадии своих заказов (E8).
	ПроизводственныеЗаказы.ОбновитьСтадииПриЗаписи(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Смена ПФ/ГП у записанной строки передачи, по которой уже есть поступление из переработки, запрещена: ожидаемая
// продукция пересоберётся под новый ПФ/ГП, а поступившее по прежнему сопоставляется по номенклатуре и выпало бы из
// остатка (ревью данных 2.0.16.16).
//
// Параметры:
//  Отказ - Булево - отказ от записи.
//
Процедура ПроверитьСменуПродукцииПриПоступлениях(Отказ)
	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Т.КодСтроки КАК КодСтроки,
	                      |	Т.Продукция КАК Продукция
	                      |ИЗ
	                      |	Документ.ПередачаВПереработку.ТЧТовары КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка = &Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	П.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.ПоступлениеИзПереработки КАК П
	                      |ГДЕ
	                      |	П.Основание = &Ссылка
	                      |	И НЕ П.ПометкаУдаления");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	// BSLLS:SetPrivilegedMode-off - наличие поступления проверяется и у пользователя без права их читать
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Пакет = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	Если Пакет[1].Пустой() Тогда
		Возврат;
	КонецЕсли;
	Записанные = Новый Соответствие;
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Записанные.Вставить(Выборка.КодСтроки, Выборка.Продукция);
	КонецЦикла;
	Для Каждого Стр Из ТЧТовары Цикл
		Было = Записанные[Стр.КодСтроки];
		Если Было = Неопределено Или Было = Стр.Продукция Тогда
			Продолжить;
		КонецЕсли;
		ТекстОшибки = НСтр("ru = 'ПФ/ГП строки %1 нельзя менять: по передаче уже есть поступление из переработки';
			|fr = 'Le SF/PF de la ligne %1 ne peut pas être modifié : le transfert a déjà une réception de sous-traitance';
			|en = 'The semi-finished / finished product of line %1 cannot be changed: the transfer already has a subcontracting receipt';
			|es = 'El SE/PT de la línea %1 no se puede cambiar: el envío ya tiene una recepción de subcontratación'");
		Поле = СтрШаблон("ТЧТовары[%1].Продукция", ТЧТовары.Индекс(Стр));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстОшибки, Стр.НомерСтроки), ЭтотОбъект, Поле, , Отказ);
	КонецЦикла;
КонецПроцедуры

// ПФ/ГП строки (колонка «Продукция») - только из заказа-основания: прямой родитель материала в дереве материалов или
// продукция строк товаров (Документы.ПередачаВПереработку.ДопустимаяПродукцияМатериала). Проверяются новые строки и
// строки, где ПФ/ГП изменился: записанным раньше перепроведение не мешает, даже если заказ с тех пор правили.
//
// Параметры:
//  Отказ - Булево - отказ от записи.
//
Процедура ПроверитьПродукциюСтрок(Отказ)
	Записанные = Новый Соответствие;
	Если Не ЭтоНовый() Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	Т.КодСтроки КАК КодСтроки,
		                      |	Т.Номенклатура КАК Номенклатура,
		                      |	Т.Продукция КАК Продукция,
		                      |	Т.Заказ КАК Заказ
		                      |ИЗ
		                      |	Документ.ПередачаВПереработку.ТЧТовары КАК Т
		                      |ГДЕ
		                      |	Т.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			КлючЗаписанной = Формат(Выборка.КодСтроки, "ЧГ=") + "|" + XMLСтрока(Выборка.Номенклатура)
				+ "|" + XMLСтрока(Выборка.Продукция) + "|" + XMLСтрока(Выборка.Заказ);
			Записанные.Вставить(КлючЗаписанной, Истина);
		КонецЦикла;
	КонецЕсли;
	// ПФ/ГП - из заказа строки (план subcontract-multi-order); смена заказа строки - повод проверить заново.
	ЗаказШапки = ПроизводственныеЗаказы.ЗаказШапкиПереработки(ЭтотОбъект);
	Для Каждого Стр Из ТЧТовары Цикл
		Если Не ЗначениеЗаполнено(Стр.Продукция) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Формат(Стр.КодСтроки, "ЧГ=") + "|" + XMLСтрока(Стр.Номенклатура) + "|" + XMLСтрока(Стр.Продукция)
			+ "|" + XMLСтрока(Стр.Заказ);
		Если Записанные[Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаказСтроки = ПроизводственныеЗаказы.ЗаказСтрокиПереработки(Стр, ЗаказШапки);
		Допустимая = Документы.ПередачаВПереработку.ДопустимаяПродукцияМатериала(
			?(ЗначениеЗаполнено(ЗаказСтроки), ЗаказСтроки, Неопределено), Стр.Номенклатура);
		Если Допустимая.Найти(Стр.Продукция) = Неопределено Тогда
			ТекстОшибки = НСтр("ru = 'ПФ/ГП строки %1 не из заказа-основания: материал не входит в его состав';
				|fr = 'Le SF/PF de la ligne %1 ne vient pas de la commande de base : la matière n''entre pas dans sa composition';
				|en = 'The semi-finished / finished product of line %1 is not from the base order: the material is not part of it';
				|es = 'El semielaborado / producto terminado de la línea %1 no es del pedido base: el material no forma parte de él'");
			Поле = СтрШаблон("ТЧТовары[%1].Продукция", ТЧТовары.Индекс(Стр));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстОшибки, Стр.НомерСтроки), ЭтотОбъект, Поле, ,
				Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Пересобирает ожидаемую продукцию по заказу-основанию. Зовут три места: обработка заполнения, форма передачи при
// изменении строк товаров и команда формы «Заполнить по заказу» (S5-A).
//
Процедура ЗаполнитьОжидаемуюПродукцию() Экспорт
	Если НесколькоЗаказов Тогда
		ЗаполнитьОжидаемуюПродукциюПоЗаказу(Неопределено);
		Возврат;
	КонецЕсли;
	// Передача одного заказа - прежнее правило целиком (в том числе плоский заказ без строк товаров).
	ЗаказШапки = ПроизводственныеЗаказы.ЗаказШапкиПереработки(ЭтотОбъект);
	Если ЗначениеЗаполнено(ЗаказШапки) Тогда
		ЗаполнитьОжидаемуюПродукциюПоЗаказу(ЗаказШапки);
	КонецЕсли;
КонецПроцедуры

// Ожидаемая продукция по заказам строк - одним правилом (см.
// Документы.ПередачаВПереработку.ОжидаемаяПродукцияПередачи) на каждую группу строк товаров одного заказа, с заказом в
// строке результата (план subcontract-multi-order). Своей копии правила здесь нет: его же зовёт форма передачи на
// каждое изменение строк товаров.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя, Неопределено - заказ всех строк (заполнение по заказу и по выпуску);
//          Неопределено - заказы строк.
//
Процедура ЗаполнитьОжидаемуюПродукциюПоЗаказу(Заказ)
	Менеджер = Документы.ПередачаВПереработку;
	Если Заказ = Неопределено Тогда
		ЗаказШапки = ПроизводственныеЗаказы.ЗаказШапкиПереработки(ЭтотОбъект);
		Продукция = Менеджер.ОжидаемаяПродукцияПоЗаказамСтрок(ТЧТовары.Выгрузить(), ЗаказШапки);
	Иначе
		Продукция = Менеджер.ОжидаемаяПродукцияЗаказа(Заказ, ТЧТовары.Выгрузить());
	КонецЕсли;
	ТЧГотоваяПродукция.Загрузить(Продукция);
	Для Каждого Стр Из ТЧГотоваяПродукция Цикл
		Стр.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ТЧГотоваяПродукция);
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьПоВыпускуПродукции(Выпуск)
	// Выпущенные полуфабрикаты передаются на переработку со склада оприходования выпуска;
	// ожидаемая продукция - из заказа-основания выпуска.
	// Имена реквизитов - без пробелов: ЗначенияРеквизитовОбъекта делает из них ключи структуры как есть.
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выпуск,
		"Основание,Организация,МестоХраненияОприходование,СозданАвтоматически");
	// У автовыпуска основание - не заказ: ожидаемая продукция берётся из заказа этого основания (E9, S4).
	// Признак, а не тип основания: оснований у автовыпуска два типа, и проверка по типу увела бы сюда саму
	// передачу-родителя вместо заказа. Реквизит читается тем же запросом, лишнего чтения нет.
	// ЗаказОснования разворачивает оба типа: у ПФ-автовыпуска основанием стоит передача, и до обобщения
	// имени функция молча возвращала Неопределено - новая передача приходила без заказа и без ожидаемой
	// продукции.
	// Проверка типа, а не ЗначениеЗаполнено: к Булеву та возвращает Истину и на Ложь (tiny1C bsl-017),
	// а у несуществующей ссылки реквизит приходит как Неопределено.
	Если ТипЗнч(Реквизиты.СозданАвтоматически) = Тип("Булево") И Реквизиты.СозданАвтоматически Тогда
		Основание = Производство.ЗаказОснования(Реквизиты.Основание);
	Иначе
		Основание = Реквизиты.Основание;
	КонецЕсли;
	Организация = Реквизиты.Организация;
	Если ЗначениеЗаполнено(Реквизиты.МестоХраненияОприходование) Тогда
		МестоХранения = Реквизиты.МестоХраненияОприходование;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТЧ.Номенклатура КАК Номенклатура,
	                      |	ТЧ.Характеристика КАК Характеристика,
	                      |	ТЧ.Серия КАК Серия,
	                      |	ТЧ.Упаковка КАК Упаковка,
	                      |	ТЧ.КоличествоУпаковок КАК КоличествоУпаковок,
	                      |	ТЧ.Количество КАК Количество
	                      |ИЗ
	                      |	Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ТЧ
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	                      |		ПО ТЧ.Номенклатура = СправочникНоменклатура.Ссылка
	                      |ГДЕ
	                      |	ТЧ.Ссылка = &Выпуск
	                      |	И СправочникНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Полуфабрикат)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ТЧ.НомерСтроки");
	Запрос.УстановитьПараметр("Выпуск", Выпуск);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НС = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Выборка);
		НС.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ТЧТовары);
		НС.Заказ = Основание;
	КонецЦикла;
	Если ЗначениеЗаполнено(Основание) Тогда
		ЗаполнитьОжидаемуюПродукциюПоЗаказу(Основание);
	КонецЕсли;
КонецПроцедуры

// Заказы строк, переработчик и период прихода передачи, по которой есть проведённые поступления из переработки или по
// партиям которой уже списывали, не меняются: иначе поступившая продукция засчиталась бы другому заказу без пересчёта
// стадий, а остаток у переработчика ушёл бы в минус (E12.3b). Распределение заказов сравнивается по строкам
// (план subcontract-multi-order), переработчики - по фактическим движениям (ревью плана, раунд 14), период - по дате
// приходных движений, а не шапки (раунд 15). Проведённая передача меняет заказы строк и переработчика только
// перепроведением: обычная запись развела бы строки с приходом у переработчика (раунды 4, 14). Вызывается под
// блокировками проведения (см. ПередЗаписью).
//
// Параметры:
//  Отказ       - Булево - устанавливается при запрете.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  Снимок      - Структура - см. СнимокДвижений.
//
Процедура ПроверитьСменуОснованияИПереработчика(Отказ, РежимЗаписи, Снимок)
	ПравкаБезПерепроведения = Снимок.Проведен И РежимЗаписи = РежимЗаписиДокумента.Запись;
	ЗаказыИзменены = ЗаказыСтрокИзменены(Снимок) Или ПравкаБезПерепроведения И РаспределениеЗаказовИзменено();
	ПереработчикИзменен = ПереработчикИзменен(Снимок);
	Если ПравкаБезПерепроведения И (ЗаказыИзменены Или ПереработчикИзменен) Тогда
		ТекстОшибки = НСтр("ru = 'Заказ, переработчик и строки заказов проведённой передачи меняются только с перепроведением.';
			|fr = 'La commande, le sous-traitant et les lignes des commandes d''un transfert validé ne changent qu''avec une nouvelle validation.';
			|en = 'The order, processor and order lines of a posted transfer change only by reposting it.';
			|es = 'El pedido, el procesador y las líneas de pedidos de un envío contabilizado solo cambian al volver a contabilizarlo.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Основание", , Отказ);
		Возврат;
	КонецЕсли;
	ЕстьСписание = РегистрыНакопления.ТоварыВПереработке.ЕстьСписаниеПоПередаче(Ссылка, КонтрагентыКонтроля());
	Если Не ЕстьСписание И Не ЕстьПоступленияПоПередаче() Тогда
		Возврат;
	КонецЕсли;
	ПериодСдвинут = РежимЗаписи = РежимЗаписиДокумента.Проведение И ЕстьСписание И ПериодПриходаСдвинут(Снимок);
	Если ЗаказыИзменены Или ПереработчикИзменен Или ПериодСдвинут Тогда
		ТекстОшибки = НСтр("ru = 'По передаче уже поступала продукция из переработки: заказ, переработчик и дата не меняются.';
			|fr = 'Des réceptions de sous-traitance existent pour ce transfert : la commande, le sous-traitant et la date ne changent pas.';
			|en = 'Subcontracting receipts already exist for this transfer: the order, processor and date cannot change.';
			|es = 'Ya hay recepciones de subcontratación de este envío: el pedido, el procesador y la fecha no cambian.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Основание", , Отказ);
		Возврат;
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения И ЕстьСписание Тогда
		СообщитьОСписании(Отказ);
	КонецЕсли;
КонецПроцедуры

// Параметры:
//  Снимок - Структура - см. СнимокДвижений.
//
// Возвращаемое значение:
//  Булево - переработчик шапки или движений отличается от текущего.
//
Функция ПереработчикИзменен(Снимок)
	Возврат Контрагент <> Снимок.Контрагент
		Или Снимок.Контрагенты.Количество() > 0 И Снимок.Контрагенты.Найти(Контрагент) = Неопределено;
КонецФункции

// Параметры:
//  Снимок - Структура - см. СнимокДвижений.
//
// Возвращаемое значение:
//  Булево - приходные движения записаны не одной датой документа.
//
Функция ПериодПриходаСдвинут(Снимок)
	Периоды = Снимок.ПериодыПрихода;
	Возврат Периоды.Количество() > 0 И (Периоды.Количество() > 1 Или Периоды[0] <> Дата);
КонецФункции

// Возвращаемое значение:
//  Булево - распределение строк по заказам отличается от сохранённого (см.
//           ПроизводственныеЗаказы.КлючРаспределенияЗаказов).
//
Функция РаспределениеЗаказовИзменено()
	Менеджер = ПроизводственныеЗаказы;
	Возврат Менеджер.КлючРаспределенияЗаказов(ЭтотОбъект) <> Менеджер.КлючРаспределенияЗаказов(Ссылка.ПолучитьОбъект());
КонецФункции

// Параметры:
//  Отказ - Булево - устанавливается.
//
Процедура СообщитьОСписании(Отказ)
	ТекстОшибки = НСтр("ru = 'По партиям передачи уже списано поступлением из переработки: отменить или удалить её нельзя.';
		|fr = 'Les lots du transfert sont déjà sortis par une réception de sous-traitance : impossible de l''annuler ou de le supprimer.';
		|en = 'Batches of the transfer are already written off by a subcontracting receipt: it cannot be unposted or deleted.';
		|es = 'Los lotes del envío ya se dieron de baja por una recepción de subcontratación: no se puede anular ni eliminar.'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, , , Отказ);
КонецПроцедуры

// Разделяемая блокировка заказов строк: «Заполнить по потребностям» рабочего места пересчитывает переданное по заказам
// под их исключительной блокировкой - передача, записанная в это время, ждёт конца заполнения (ревью данных сборки 2
// плана subcontract-multi-order, P1).
//
Процедура ЗаблокироватьЗаказыСтрок()
	Заказы = ЗаказыСтрок();
	Если Заказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Заказ Из Заказы Цикл
		Элемент = Блокировка.Добавить("Документ.ЗаказПокупателя");
		Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
		Элемент.УстановитьЗначение("Ссылка", Заказ);
	КонецЦикла;
	Блокировка.Заблокировать();
КонецПроцедуры

// Исключительная блокировка самой передачи - первой в транзакции записи: поступление по ней берёт её разделяемо, пока
// читает её заказы (план subcontract-multi-order, протокол блокировки передачи).
//
Процедура ЗаблокироватьПередачу()
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Документ.ПередачаВПереработку");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Блокировка.Заблокировать();
КонецПроцедуры

// Инвариант шапки и заказов строк (план subcontract-multi-order). Коды строк обеих ТЧ уникальны - по коду строки
// приход у переработчика связывается с заказом строки (ревью плана, раунд 7).
//  - Общая передача (НесколькоЗаказов): основание всегда пусто, заказ - в каждой строке; при установке флажка строки
//    без заказа получают прежнее основание.
//  - Обычная передача: строки - заказа основания. Флажок снят - основание := единственный заказ строк (несколько -
//    отказ); строки одного заказа, отличного от основания, - смена заказа документа: строки переносятся на основание;
//    строки разных заказов - отказ; строки без заказа получают основание.
//
// Параметры:
//  Отказ - Булево - устанавливается при нарушении.
//
Процедура ПривестиЗаказыСтрок(Отказ)
	РаботаСДокументамиКлиентСервер.ЗаполнитьКодыСтрок(ТЧТовары);
	РаботаСДокументамиКлиентСервер.ЗаполнитьКодыСтрок(ТЧГотоваяПродукция);
	ПустойЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();
	Если НесколькоЗаказов Тогда
		Если ЗначениеЗаполнено(Основание) Тогда
			ЗаполнитьПустыеЗаказыСтрок(Основание);
		КонецЕсли;
		Основание = ПустойЗаказ;
		ПроверитьЗаказыСтрокОбщей(Отказ);
		Возврат;
	КонецЕсли;
	БылаОбщей = Не ЭтоНовый() И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "НесколькоЗаказов") = Истина;
	Заказы = ЗаказыСтрок();
	Если Заказы.Количество() > 1 Тогда
		ТекстОшибки = ТекстНесколькихЗаказовСтрок(БылаОбщей);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "НесколькоЗаказов", , Отказ);
		Возврат;
	КонецЕсли;
	ПривестиОснованиеИЗаказСтрок(БылаОбщей, Заказы);
	ЗаполнитьПустыеЗаказыСтрок(Основание);
КонецПроцедуры

// Параметры:
//  БылаОбщей - Булево - флажок «Несколько заказов» снят в этой записи.
//
// Возвращаемое значение:
//  Строка - текст отказа для строк нескольких заказов в документе одного заказа.
//
Функция ТекстНесколькихЗаказовСтрок(БылаОбщей)
	Если БылаОбщей Тогда
		Возврат НСтр("ru = 'В строках несколько заказов: флажок «Несколько заказов» снимается только при одном заказе.';
			|fr = 'Les lignes ont plusieurs commandes : la case « Plusieurs commandes » ne se décoche qu''avec une seule commande.';
			|en = 'The lines have several orders: the ""Several orders"" flag can be cleared only with one order.';
			|es = 'Las líneas tienen varios pedidos: la casilla «Varios pedidos» solo se desmarca con un pedido.'");
	Иначе
		Возврат НСтр("ru = 'Документ одного заказа: для строк нескольких заказов отметьте «Несколько заказов».';
			|fr = 'Document d''une seule commande : pour des lignes de plusieurs commandes, cochez « Plusieurs commandes ».';
			|en = 'A single-order document: for lines of several orders, check ""Several orders"".';
			|es = 'Documento de un pedido: para líneas de varios pedidos, marque «Varios pedidos».'");
	КонецЕсли;
КонецФункции

// Основание документа одного заказа по заказу строк: снятый флажок «Несколько заказов» - основание := заказ строк;
// сменённое основание - строки переносятся на новый заказ (пустой - документ без заказа); запрет при поступлениях и
// списании - ПроверитьСменуОснованияИПереработчика.
//
// Параметры:
//  БылаОбщей - Булево - флажок «Несколько заказов» снят в этой записи.
//  Заказы    - Массив из ДокументСсылка.ЗаказПокупателя - см. ЗаказыСтрок, не больше одного.
//
Процедура ПривестиОснованиеИЗаказСтрок(БылаОбщей, Заказы)
	Если Заказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если БылаОбщей Или Заказы[0] = Основание Тогда
		Основание = Заказы[0];
	Иначе
		Для Каждого ИмяТЧ Из СтрРазделить("ТЧТовары,ТЧГотоваяПродукция", ",") Цикл
			Для Каждого Стр Из ЭтотОбъект[ИмяТЧ] Цикл
				Стр.Заказ = Основание;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПокупателя - заполненные заказы строк обеих ТЧ без повторов.
//
Функция ЗаказыСтрок()
	Заказы = Новый Массив;
	Для Каждого ИмяТЧ Из СтрРазделить("ТЧТовары,ТЧГотоваяПродукция", ",") Цикл
		Для Каждого Стр Из ЭтотОбъект[ИмяТЧ] Цикл
			Если ЗначениеЗаполнено(Стр.Заказ) И Заказы.Найти(Стр.Заказ) = Неопределено Тогда
				Заказы.Добавить(Стр.Заказ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Заказы;
КонецФункции

// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ для строк без заказа.
//
Процедура ЗаполнитьПустыеЗаказыСтрок(Заказ)
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ИмяТЧ Из СтрРазделить("ТЧТовары,ТЧГотоваяПродукция", ",") Цикл
		Для Каждого Стр Из ЭтотОбъект[ИмяТЧ] Цикл
			Если Не ЗначениеЗаполнено(Стр.Заказ) Тогда
				Стр.Заказ = Заказ;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// У общей передачи заказ обязателен в каждой строке обеих ТЧ: строка без заказа дала бы беззаказную партию у
// переработчика (ревью плана, раунд 8). Вызывается и из ПередЗаписью - программное проведение не вызывает проверку
// заполнения.
//
// Параметры:
//  Отказ - Булево - устанавливается при пустом заказе строки.
//
Процедура ПроверитьЗаказыСтрокОбщей(Отказ)
	Если Не НесколькоЗаказов Тогда
		Возврат;
	КонецЕсли;
	ТекстОшибки = НСтр("ru = 'В передаче нескольких заказов укажите заказ в строке %1';
		|fr = 'Dans un transfert de plusieurs commandes, indiquez la commande de la ligne %1';
		|en = 'In a transfer of several orders, specify the order in line %1';
		|es = 'En un envío de varios pedidos, indique el pedido en la línea %1'");
	Для Каждого ИмяТЧ Из СтрРазделить("ТЧТовары,ТЧГотоваяПродукция", ",") Цикл
		Для Каждого Стр Из ЭтотОбъект[ИмяТЧ] Цикл
			Если Не ЗначениеЗаполнено(Стр.Заказ) Тогда
				Поле = СтрШаблон("%1[%2].Заказ", ИмяТЧ, ЭтотОбъект[ИмяТЧ].Индекс(Стр));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстОшибки, Стр.НомерСтроки), ЭтотОбъект,
					Поле, , Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Снимок сохранённой версии передачи до автоудаления движений: шапка, заказы строк и переработчики и периоды приходных
// движений (ревью плана, раунды 14-16).
//
// Возвращаемое значение:
//  Структура:
//   * Контрагент     - СправочникСсылка.Контрагенты - переработчик шапки в базе.
//   * Проведен       - Булево - передача проведена в базе.
//   * Контрагенты    - Массив из СправочникСсылка.Контрагенты - переработчики движений.
//   * ПериодыПрихода - Массив из Дата - периоды приходных движений.
//   * ЗаказыСтрок    - Соответствие - ключ «ТЧ|код строки» (или «ТЧ|#номер строки» при неоднозначных кодах), значение
//                      ДокументСсылка.ЗаказПокупателя - заказ строки с запасным путём шапки.
//
Функция СнимокДвижений()
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Передачи.Контрагент КАК Контрагент,
	                      |	Передачи.Проведен КАК Проведен,
	                      |	ВЫБОР
	                      |		КОГДА Передачи.НесколькоЗаказов
	                      |			ТОГДА ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	                      |		ИНАЧЕ Передачи.Основание
	                      |	КОНЕЦ КАК ЗаказШапки
	                      |ИЗ
	                      |	Документ.ПередачаВПереработку КАК Передачи
	                      |ГДЕ
	                      |	Передачи.Ссылка = &Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	""ТЧТовары"" КАК ИмяТЧ,
	                      |	Т.НомерСтроки КАК НомерСтроки,
	                      |	Т.КодСтроки КАК КодСтроки,
	                      |	Т.Заказ КАК Заказ
	                      |ИЗ
	                      |	Документ.ПередачаВПереработку.ТЧТовары КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка = &Ссылка
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	""ТЧГотоваяПродукция"",
	                      |	Т.НомерСтроки,
	                      |	Т.КодСтроки,
	                      |	Т.Заказ
	                      |ИЗ
	                      |	Документ.ПередачаВПереработку.ТЧГотоваяПродукция КАК Т
	                      |ГДЕ
	                      |	Т.Ссылка = &Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Движения.Контрагент КАК Контрагент
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВПереработке КАК Движения
	                      |ГДЕ
	                      |	Движения.Регистратор = &Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Движения.Период КАК Период
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВПереработке КАК Движения
	                      |ГДЕ
	                      |	Движения.Регистратор = &Ссылка
	                      |	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	// BSLLS:SetPrivilegedMode-off - движения своей передачи читаются для проверок её записи, наружу не уходят.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Пакет = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	Снимок = Новый Структура("Контрагент, Проведен, Контрагенты, ПериодыПрихода, ЗаказыСтрок");
	Шапка = Пакет[0].Выбрать();
	ЗаказШапки = Документы.ЗаказПокупателя.ПустаяСсылка();
	Если Шапка.Следующий() Тогда
		Снимок.Контрагент = Шапка.Контрагент;
		Снимок.Проведен = Шапка.Проведен;
		ЗаказШапки = Шапка.ЗаказШапки;
	КонецЕсли;
	Снимок.Контрагенты = Пакет[2].Выгрузить().ВыгрузитьКолонку("Контрагент");
	Снимок.ПериодыПрихода = Пакет[3].Выгрузить().ВыгрузитьКолонку("Период");
	Строки = Пакет[1].Выгрузить();
	Снимок.ЗаказыСтрок = Новый Соответствие;
	Для Каждого ИмяТЧ Из СтрРазделить("ТЧТовары,ТЧГотоваяПродукция", ",") Цикл
		СтрокиТЧ = Строки.НайтиСтроки(Новый Структура("ИмяТЧ", ИмяТЧ));
		ПоНомеру = КодыНеоднозначны(СтрокиТЧ);
		Для Каждого Стр Из СтрокиТЧ Цикл
			Снимок.ЗаказыСтрок.Вставить(КлючСтрокиСнимка(ИмяТЧ, Стр, ПоНомеру),
				ПроизводственныеЗаказы.ЗаказСтрокиПереработки(Стр, ЗаказШапки));
		КонецЦикла;
		Снимок.ЗаказыСтрок.Вставить(ИмяТЧ + "|ПоНомеру", ПоНомеру);
	КонецЦикла;
	Возврат Снимок;
КонецФункции

// Параметры:
//  Строки - Массив - строки с колонкой КодСтроки.
//
// Возвращаемое значение:
//  Булево - есть нулевые или повторяющиеся коды строк: сравнивать по номеру строки.
//
Функция КодыНеоднозначны(Строки)
	Встреченные = Новый Соответствие;
	Для Каждого Стр Из Строки Цикл
		Если Стр.КодСтроки = 0 Или Встреченные[Стр.КодСтроки] <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		Встреченные.Вставить(Стр.КодСтроки, Истина);
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Параметры:
//  ИмяТЧ    - Строка - имя табличной части.
//  Стр      - СтрокаТаблицыЗначений, СтрокаТабличнойЧасти - строка с КодСтроки и НомерСтроки.
//  ПоНомеру - Булево - ключ по номеру строки.
//
// Возвращаемое значение:
//  Строка - ключ строки в снимке.
//
Функция КлючСтрокиСнимка(ИмяТЧ, Стр, ПоНомеру)
	Возврат ИмяТЧ + ?(ПоНомеру, "|#" + Формат(Стр.НомерСтроки, "ЧГ="), "|" + Формат(Стр.КодСтроки, "ЧГ="));
КонецФункции

// Параметры:
//  Снимок - Структура - см. СнимокДвижений.
//
// Возвращаемое значение:
//  Булево - у строки, сохранённой в базе, сменился заказ (с учётом шапки) или изменился набор заказов строк: удалены
//           все строки заказа либо добавлена строка нового заказа (ревью кода subcontract-multi-order, P1).
//
Функция ЗаказыСтрокИзменены(Снимок)
	ЗаказШапки = ПроизводственныеЗаказы.ЗаказШапкиПереработки(ЭтотОбъект);
	Стало = Новый Соответствие;
	Для Каждого ИмяТЧ Из СтрРазделить("ТЧТовары,ТЧГотоваяПродукция", ",") Цикл
		ПоНомеру = Снимок.ЗаказыСтрок[ИмяТЧ + "|ПоНомеру"] = Истина;
		Для Каждого Стр Из ЭтотОбъект[ИмяТЧ] Цикл
			ЗаказСтроки = ПроизводственныеЗаказы.ЗаказСтрокиПереработки(Стр, ЗаказШапки);
			Стало.Вставить(ЗаказСтроки, Истина);
			Было = Снимок.ЗаказыСтрок[КлючСтрокиСнимка(ИмяТЧ, Стр, ПоНомеру)];
			Если Было <> Неопределено И Было <> ЗаказСтроки Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Было = Новый Соответствие;
	ТипЗаказа = Тип("ДокументСсылка.ЗаказПокупателя");
	Для Каждого КлючИЗначение Из Снимок.ЗаказыСтрок Цикл
		Если ТипЗнч(КлючИЗначение.Значение) = ТипЗаказа Тогда
			Было.Вставить(КлючИЗначение.Значение, Истина);
		КонецЕсли;
	КонецЦикла;
	Если Было.Количество() <> Стало.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Было Цикл
		Если Стало[КлючИЗначение.Ключ] = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Переработчики контроля остатков и поиска списаний: фактических движений до записи и текущий.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты - без повторов.
//
Функция КонтрагентыКонтроля()
	Результат = Новый Массив;
	Снимок = Неопределено;
	Если ДополнительныеСвойства.Свойство(ИмяСвойстваСнимка(), Снимок) Тогда
		Для Каждого Переработчик Из Снимок.Контрагенты Цикл
			Результат.Добавить(Переработчик);
		КонецЦикла;
		Если ЗначениеЗаполнено(Снимок.Контрагент) И Результат.Найти(Снимок.Контрагент) = Неопределено Тогда
			Результат.Добавить(Снимок.Контрагент);
		КонецЕсли;
	КонецЕсли;
	Если Результат.Найти(Контрагент) = Неопределено Тогда
		Результат.Добавить(Контрагент);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ИмяСвойстваСнимка()
	Возврат "СнимокДвиженийПередачи";
КонецФункции

Функция ИмяСвойстваКонтекста(ДляОтмены)
	Возврат ?(ДляОтмены, "КонтекстАвтовыпускаОтмены", "КонтекстАвтовыпускаПроведения");
КонецФункции

// Контекст автовыпуска, посчитанный в ПередЗаписью до блокировок; нет его (проведение без ПередЗаписью не бывает, но
// процедуру можно вызвать и отдельно) - считается заново.
//
// Параметры:
//  ДляОтмены - Булево - см. Производство.КонтекстАвтовыпуска.
//
// Возвращаемое значение:
//  Структура - см. Производство.КонтекстАвтовыпуска.
//
Функция КонтекстАвтовыпускаЗаписи(ДляОтмены)
	Контекст = Неопределено;
	Если Не ДополнительныеСвойства.Свойство(ИмяСвойстваКонтекста(ДляОтмены), Контекст) Тогда
		Контекст = Производство.КонтекстАвтовыпуска(ЭтотОбъект, ДляОтмены);
	КонецЕсли;
	Возврат Контекст;
КонецФункции

// Продукция заказа на станке (открытое требование-накладная) в переработку не передаётся - по каждому заказу строк
// ожидаемой продукции (план subcontract-multi-order: при пустом основании проверка молча не выполнялась бы).
//
// Параметры:
//  Отказ - Булево - устанавливается при запрете.
//
Процедура ПроверитьПродукциюНаСтанках(Отказ)
	ЗаказШапки = ПроизводственныеЗаказы.ЗаказШапкиПереработки(ЭтотОбъект);
	Продукция = ТЧГотоваяПродукция.Выгрузить(, "Номенклатура, Характеристика, Заказ");
	Для Каждого Стр Из Продукция Цикл
		Стр.Заказ = ПроизводственныеЗаказы.ЗаказСтрокиПереработки(Стр, ЗаказШапки);
	КонецЦикла;
	Для Каждого Заказ Из ПроизводственныеЗаказы.ЗаказыСтрокПереработки(ЭтотОбъект) Цикл
		ТекстЗапрета = ТребованияНакладные.ТекстЗапретаВыпускаБезТребования(Заказ,
			Продукция.Скопировать(Новый Структура("Заказ", Заказ), "Номенклатура, Характеристика"));
		Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, ЭтотОбъект, , , Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Общая передача автовыпуск полуфабрикатов не делает (план subcontract-multi-order): при нехватке на складе - пояснение,
// что ПФ выпускается заранее.
//
Процедура ПодсказатьАвтовыпускОбщейПередачи()
	Если Не НесколькоЗаказов Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Номенклатура.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.Номенклатура КАК Номенклатура
	                      |ГДЕ
	                      |	Номенклатура.Ссылка В (&Номенклатура)
	                      |	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Полуфабрикат)");
	Запрос.УстановитьПараметр("Номенклатура", ТЧТовары.ВыгрузитьКолонку("Номенклатура"));
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	ТекстСообщения = НСтр("ru = 'В передаче нескольких заказов полуфабрикаты автоматически не выпускаются: выпустите их заранее.';
		|fr = 'Dans un transfert de plusieurs commandes, les semi-finis ne sont pas produits automatiquement : produisez-les avant.';
		|en = 'In a transfer of several orders, semi-finished goods are not produced automatically: produce them beforehand.';
		|es = 'En un envío de varios pedidos, los semielaborados no se producen automáticamente: prodúzcalos antes.'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект);
КонецПроцедуры

// Возвращаемое значение:
//  Булево - есть проведённые поступления из переработки на основании передачи.
//
Функция ЕстьПоступленияПоПередаче()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Поступления.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.ПоступлениеИзПереработки КАК Поступления
	                      |ГДЕ
	                      |	Поступления.Основание = &Передача
	                      |	И Поступления.Проведен");
	Запрос.УстановитьПараметр("Передача", Ссылка);
	// BSLLS:SetPrivilegedMode-off - наружу уходит только признак.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

#КонецОбласти
