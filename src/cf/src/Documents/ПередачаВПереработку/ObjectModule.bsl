#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Основание = ДанныеЗаполнения;
		Организация = ДанныеЗаполнения.Организация;
		ЗаполнитьОжидаемуюПродукциюПоЗаказу(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВыпускПродукции") Тогда
		ЗаполнитьПоВыпускуПродукции(ДанныеЗаполнения);
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	// Данные для проведения
	ДополнительныеСвойства.Вставить("ТЗТоварыССериями", СерииИРазмещение.ОбъединитьТоварыССериями(ЭтотОбъект));
	// Блокировки: сначала читаются остатки склада, затем пишется приход у переработчика
	Блокировка = Новый БлокировкаДанных;
	УправляемыеБлокировки.ТоварыВНаличии(Блокировка, ТЧТовары, МестоХранения);
	УправляемыеБлокировки.ТоварыВПереработке(Блокировка, ТЧТовары, Контрагент);
	Блокировка.Заблокировать();
	// Формируем: списание со склада и приход в переработку - в диспетчере ТоварыВНаличии
	Если Не РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(ЭтотОбъект) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Движения.Записать();
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ЗначениеЗаполнено(Контрагент)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Субподрядчик") <> Истина Тогда
		ТекстОшибки = НСтр("ru = 'Контрагент не помечен как субподрядчик (переработчик)';
			|fr = 'Le partenaire n''est pas marqué comme sous-traitant';
			|en = 'The counterparty is not marked as a subcontractor (processor)';
			|es = 'La contraparte no está marcada como subcontratista (procesador)'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Контрагент", , Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	Если Не Отказ И Не ЭтоНовый() Тогда
		ПроверитьСменуОснованияИПереработчика(Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.ОбновитьПроизводственныйСтатусЗаказа(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьОжидаемуюПродукциюПоЗаказу(Заказ)
	// В ожидаемую продукцию попадают строки заказа с продукцией и полуфабрикатами; типы берутся одним запросом.
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТЧТовары.Номенклатура КАК Номенклатура,
	                      |	ТЧТовары.Характеристика КАК Характеристика,
	                      |	ТЧТовары.Упаковка КАК Упаковка,
	                      |	ТЧТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	                      |	ТЧТовары.Количество КАК Количество
	                      |ИЗ
	                      |	Документ.ЗаказПокупателя.ТЧТовары КАК ТЧТовары
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	                      |		ПО ТЧТовары.Номенклатура = СправочникНоменклатура.Ссылка
	                      |ГДЕ
	                      |	ТЧТовары.Ссылка = &Заказ
	                      |	И СправочникНоменклатура.ТипНоменклатуры В (&ТипыПродукции)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ТЧТовары.НомерСтроки");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("ТипыПродукции", ТипыПродукции());
	ТЧГотоваяПродукция.Загрузить(Запрос.Выполнить().Выгрузить());
	Для Каждого Стр Из ТЧГотоваяПродукция Цикл
		Стр.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ТЧГотоваяПродукция);
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьПоВыпускуПродукции(Выпуск)
	// Выпущенные полуфабрикаты передаются на переработку со склада оприходования выпуска;
	// ожидаемая продукция - из заказа-основания выпуска.
	// Имена реквизитов - без пробелов: ЗначенияРеквизитовОбъекта делает из них ключи структуры как есть.
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выпуск, "Основание,Организация,МестоХраненияОприходование");
	// У автовыпуска при отгрузке основание - реализация: ожидаемая продукция - из её заказа (E9).
	Если ТипЗнч(Реквизиты.Основание) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Основание = Производство.ЗаказРеализацииОснования(Реквизиты.Основание);
	Иначе
		Основание = Реквизиты.Основание;
	КонецЕсли;
	Организация = Реквизиты.Организация;
	Если ЗначениеЗаполнено(Реквизиты.МестоХраненияОприходование) Тогда
		МестоХранения = Реквизиты.МестоХраненияОприходование;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТЧ.Номенклатура КАК Номенклатура,
	                      |	ТЧ.Характеристика КАК Характеристика,
	                      |	ТЧ.Серия КАК Серия,
	                      |	ТЧ.Упаковка КАК Упаковка,
	                      |	ТЧ.КоличествоУпаковок КАК КоличествоУпаковок,
	                      |	ТЧ.Количество КАК Количество
	                      |ИЗ
	                      |	Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ТЧ
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	                      |		ПО ТЧ.Номенклатура = СправочникНоменклатура.Ссылка
	                      |ГДЕ
	                      |	ТЧ.Ссылка = &Выпуск
	                      |	И СправочникНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Полуфабрикат)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ТЧ.НомерСтроки");
	Запрос.УстановитьПараметр("Выпуск", Выпуск);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НС = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Выборка);
		НС.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ТЧТовары);
	КонецЦикла;
	Если ЗначениеЗаполнено(Основание) Тогда
		ЗаполнитьОжидаемуюПродукциюПоЗаказу(Основание);
	КонецЕсли;
КонецПроцедуры

// Заказ и переработчик передачи, по которой есть проведённые поступления из переработки или по партиям которой уже
// списывали, не меняются: иначе поступившая продукция засчиталась бы другому заказу без пересчёта стадий, а остаток у
// переработчика ушёл бы в минус (E12.3b).
//
// Параметры:
//  Отказ - Булево - устанавливается при смене.
//
Процедура ПроверитьСменуОснованияИПереработчика(Отказ)
	Прежние = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Основание, Контрагент");
	Если Прежние.Основание = Основание И Прежние.Контрагент = Контрагент Тогда
		Возврат;
	КонецЕсли;
	Если Не РегистрыНакопления.ТоварыВПереработке.ЕстьСписаниеПоПередаче(Ссылка) И Не ЕстьПоступленияПоПередаче() Тогда
		Возврат;
	КонецЕсли;
	ТекстОшибки = НСтр("ru = 'По передаче уже поступала продукция из переработки: заказ и переработчик не меняются.';
		|fr = 'Des réceptions de sous-traitance existent pour ce transfert : la commande et le sous-traitant ne changent pas.';
		|en = 'Subcontracting receipts already exist for this transfer: the order and processor cannot change.';
		|es = 'Ya hay recepciones de subcontratación de este envío: el pedido y el procesador no cambian.'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Основание", , Отказ);
КонецПроцедуры

// Возвращаемое значение:
//  Булево - есть проведённые поступления из переработки на основании передачи.
//
Функция ЕстьПоступленияПоПередаче()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Поступления.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.ПоступлениеИзПереработки КАК Поступления
	                      |ГДЕ
	                      |	Поступления.Основание = &Передача
	                      |	И Поступления.Проведен");
	Запрос.УстановитьПараметр("Передача", Ссылка);
	// BSLLS:SetPrivilegedMode-off - наружу уходит только признак.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Функция ТипыПродукции()
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ТипыНоменклатуры.Продукция);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.Полуфабрикат);
	Возврат Результат;
КонецФункции

#КонецОбласти
