#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	Статус = Перечисления.СтатусыПотребностейТорговыхТочек.Черновик;
	Точка = ПотребностиТорговыхТочек.ТочкаПользователя();
	Если ЗначениеЗаполнено(Точка) Тогда
		МестоХранения = Точка;
	КонецЕсли;
	Если ЗначениеЗаполнено(МестоХранения) Тогда
		СкладСнабжения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МестоХранения, "СкладСнабженияТочки");
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументамиКлиентСервер.ЗаполнитьКодыСтрок(ТЧТовары);
	Прежние = Неопределено;
	Если Не ЭтоНовый() Тогда
		Прежние = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Статус, МестоХранения, Проведен");
	КонецЕсли;
	ДополнительныеСвойства.Вставить("ПрежнийСтатус", ?(Прежние = Неопределено, Неопределено, Прежние.Статус));
	Текст = ТекстОтказаЗаписи(Прежние, РежимЗаписи);
	Если ЗначениеЗаполнено(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Потребности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка);
	ПотребностиТорговыхТочек.ЗаблокироватьПотребности(Потребности);
	ПотребностиТорговыхТочек.СформироватьДвиженияПотребности(ЭтотОбъект);
	Движения.ПотребностиТорговыхТочек.Записывать = Истина;
	Движения.Записать();
	ПроверитьБаланс(Потребности, Отказ);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Потребности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка);
	ПотребностиТорговыхТочек.ЗаблокироватьПотребности(Потребности);
	Движения.ПотребностиТорговыхТочек.Записывать = Истина;
	Движения.ПотребностиТорговыхТочек.Очистить();
	Движения.ПотребностиТорговыхТочек.Записать();
	ПроверитьБаланс(Потребности, Отказ);
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	Если ДополнительныеСвойства.ПрежнийСтатус <> Статус Тогда
		ПотребностиТорговыхТочек.ЗаписатьИсториюСтатуса(Ссылка, Статус);
	КонецЕсли;
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если ПотребностиТорговыхТочек.ЕстьСвязиВРегистре(Ссылка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'У потребности есть движения или отгрузки: сначала отмените проведение.';
			|fr = 'Le besoin a des mouvements ou des expéditions : annulez d''abord la validation.';
			|en = 'The need has records or shipments: undo the posting first.';
			|es = 'La necesidad tiene movimientos o envíos: primero anule la contabilización.'"), ЭтотОбъект, , , Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Статус = Перечисления.СтатусыПотребностейТорговыхТочек.Черновик;
	Ответственный = ПараметрыСеанса.Пользователь;
	Для Каждого Строка Из ТЧТовары Цикл
		Строка.КоличествоПринято = 0;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Текст отказа записи (план docs/plans/retail-store-needs.md, «Права»): своя точка, переход статуса, режим записи.
//
// Параметры:
//  Прежние     - Структура, Неопределено - Статус, МестоХранения, Проведен из базы; новый документ - Неопределено.
//  РежимЗаписи - РежимЗаписиДокумента - режим.
//
// Возвращаемое значение:
//  Строка - текст отказа или пустая строка.
//
Функция ТекстОтказаЗаписи(Прежние, РежимЗаписи)
	Доверенный = ПотребностиТорговыхТочек.ДоверенныйПользователь();
	ЧужаяТочка = Не ПотребностиТорговыхТочек.СвояТочка(МестоХранения)
		Или Прежние <> Неопределено И Не ПотребностиТорговыхТочек.СвояТочка(Прежние.МестоХранения);
	Если ЧужаяТочка Тогда
		Возврат НСтр("ru = 'Потребность другой торговой точки: записать её может только эта точка или склад.';
			|fr = 'Besoin d''un autre point de vente : seuls ce point ou l''entrepôt peuvent l''enregistrer.';
			|en = 'A need of another store: only that store or the warehouse can save it.';
			|es = 'Necesidad de otro punto de venta: solo ese punto o el almacén pueden guardarla.'");
	КонецЕсли;
	Текст = ПотребностиТорговыхТочек.ТекстОшибкиПерехода(?(Прежние = Неопределено, Неопределено, Прежние.Статус),
		Статус, Доверенный);
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = ТекстОтказаРежима(Прежние, РежимЗаписи);
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Если ПринятаВБазе(Прежние) И СоставИзменен() Тогда
		Возврат НСтр("ru = 'У принятой потребности меняются только принятые количества и статус.';
			|fr = 'Dans un besoin accepté, seuls les quantités acceptées et le statut changent.';
			|en = 'In an accepted need only the accepted quantities and the status change.';
			|es = 'En una necesidad aceptada solo cambian las cantidades aceptadas y el estado.'");
	КонецЕсли;
	Если Не Доверенный И ЕстьПринятоеКоличество() Тогда
		Возврат НСтр("ru = 'Принятое количество вводит склад снабжения.';
			|fr = 'La quantité acceptée est saisie par l''entrepôt d''approvisionnement.';
			|en = 'The accepted quantity is entered by the supply warehouse.';
			|es = 'La cantidad aceptada la introduce el almacén de abastecimiento.'");
	КонецЕсли;
	Если Статус = Перечисления.СтатусыПотребностейТорговыхТочек.Отправлена
		И (Не ЗначениеЗаполнено(СкладСнабжения) Или ТЧТовары.Количество() = 0) Тогда
		Возврат НСтр("ru = 'Для отправки укажите склад снабжения и товары.';
			|fr = 'Pour l''envoi, indiquez l''entrepôt d''approvisionnement et les articles.';
			|en = 'To send, specify the supply warehouse and the items.';
			|es = 'Para enviar, indique el almacén de abastecimiento y los artículos.'");
	КонецЕсли;
	Возврат "";
КонецФункции

// Статус и движения не расходятся: смена статуса (кроме возврата в черновик и отклонения отменой проведения) -
// проведением, проведённый документ обычной записью не пишется, черновик не проводится.
//
// Параметры:
//  Прежние     - Структура, Неопределено - см. ТекстОтказаЗаписи.
//  РежимЗаписи - РежимЗаписиДокумента - режим.
//
// Возвращаемое значение:
//  Строка - текст отказа или пустая строка.
//
Функция ТекстОтказаРежима(Прежние, РежимЗаписи)
	Статусы = Перечисления.СтатусыПотребностейТорговыхТочек;
	БезДвижений = Статус = Статусы.Черновик Или Статус = Статусы.Отклонена;
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения И Не БезДвижений Тогда
		Возврат НСтр("ru = 'Отмена проведения - только при возврате в черновик или отклонении.';
			|fr = 'L''annulation de la validation - seulement pour le retour en brouillon ou le refus.';
			|en = 'Undo posting - only when returning to draft or rejecting.';
			|es = 'Anular la contabilización - solo al volver a borrador o al rechazar.'");
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Проведение И Статус = Статусы.Черновик Тогда
		Возврат НСтр("ru = 'Черновик не проводится - отправьте потребность.';
			|fr = 'Un brouillon ne se valide pas - envoyez le besoin.';
			|en = 'A draft is not posted - send the need.';
			|es = 'Un borrador no se contabiliza - envíe la necesidad.'");
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Запись И (Статус <> Статусы.Черновик Или БылПроведен(Прежние)) Тогда
		Возврат НСтр("ru = 'Потребность в этом статусе записывается проведением.';
			|fr = 'Un besoin dans ce statut s''enregistre par validation.';
			|en = 'A need in this status is saved by posting.';
			|es = 'Una necesidad en este estado se guarda contabilizándola.'");
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

// Принята или закрыта ли потребность в базе: её склад, точка и строки (кроме принятого) заморожены - по ним уже
// могли отгрузить.
//
// Параметры:
//  Прежние - Структура, Неопределено - см. ТекстОтказаЗаписи.
//
// Возвращаемое значение:
//  Булево - Истина, если принята или закрыта.
//
Функция ПринятаВБазе(Прежние)
	Если Прежние = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Статусы = Перечисления.СтатусыПотребностейТорговыхТочек;
	Возврат Прежние.Статус = Статусы.Принята Или Прежние.Статус = Статусы.Закрыта;
КонецФункции

// Изменён ли состав потребности относительно базы: точка, склад снабжения, строки (код, товар, характеристика, серия,
// запрошенное количество).
//
// Возвращаемое значение:
//  Булево - Истина, если изменён.
//
Функция СоставИзменен()
	Шапка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "МестоХранения, СкладСнабжения");
	Если Шапка.МестоХранения <> МестоХранения Или Шапка.СкладСнабжения <> СкладСнабжения Тогда
		Возврат Истина;
	КонецЕсли;
	Поля = "КодСтроки, Номенклатура, Характеристика, Серия, Количество";
	Прежние = Ссылка.ТЧТовары.Выгрузить(, Поля);
	Текущие = ТЧТовары.Выгрузить(, Поля);
	Если Прежние.Количество() <> Текущие.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	Для Индекс = 0 По Прежние.Количество() - 1 Цикл
		Для Каждого Поле Из СтрРазделить(Поля, ", ", Ложь) Цикл
			Если Прежние[Индекс][Поле] <> Текущие[Индекс][Поле] Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Есть ли в строках принятое количество (ненулевое в любую сторону).
//
// Возвращаемое значение:
//  Булево - Истина, если есть.
//
Функция ЕстьПринятоеКоличество()
	Для Каждого Строка Из ТЧТовары Цикл
		Если Строка.КоличествоПринято <> 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Проведён ли документ в базе.
//
// Параметры:
//  Прежние - Структура, Неопределено - см. ТекстОтказаЗаписи.
//
// Возвращаемое значение:
//  Булево - Истина, если проведён.
//
Функция БылПроведен(Прежние)
	Возврат Прежние <> Неопределено И Прежние.Проведен;
КонецФункции

// Сообщения о нарушениях баланса строк потребности после записи движений.
//
// Параметры:
//  Потребности - Массив из ДокументСсылка.ПотребностьТорговойТочки - проверяемые потребности.
//  Отказ       - Булево - выставляется при нарушении.
//
Процедура ПроверитьБаланс(Потребности, Отказ)
	Для Каждого Текст Из ПотребностиТорговыхТочек.НарушенияБаланса(Потребности) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
