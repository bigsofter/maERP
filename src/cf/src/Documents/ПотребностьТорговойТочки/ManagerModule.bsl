#Область ПрограммныйИнтерфейс

// Текст запроса формы списка потребностей (план docs/plans/retail-store-needs-2.md, §1): шапка, запрошено по строкам,
// исполнение по регистру, состояние и просрочка. Форма списка ставит его при создании; тест сверяет его с
// ПотребностиТорговыхТочек.СостояниеИсполнения. Параметр - НачалоДня.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
// BSLLS:JoinWithSubQuery-off - запрос динамического списка: один запрос без временных таблиц
// BSLLS:VirtualTableCallWithoutParameters-off - итоги исполнения нужны по всем потребностям списка
Функция ТекстЗапросаСписка() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.Проведен КАК Проведен,
	|	Док.ПометкаУдаления КАК ПометкаУдаления,
	|	Док.МестоХранения КАК МестоХранения,
	|	Док.СкладСнабжения КАК СкладСнабжения,
	|	Док.Статус КАК Статус,
	|	ВЫБОР
	|		КОГДА Док.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыПотребностейТорговыхТочек.Принята), ЗНАЧЕНИЕ(Перечисление.СтатусыПотребностейТорговыхТочек.Закрыта))
	|				И ЕСТЬNULL(Исполнение.Отгружено, 0) > 0
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(Исполнение.Получено, 0) >= ЕСТЬNULL(Исполнение.Отгружено, 0)
	|							И ЕСТЬNULL(Исполнение.Отгружено, 0) >= ЕСТЬNULL(Исполнение.Принято, 0)
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПотребностейТорговыхТочек.Получена)
	|					КОГДА ЕСТЬNULL(Исполнение.Отгружено, 0) >= ЕСТЬNULL(Исполнение.Принято, 0)
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПотребностейТорговыхТочек.Отгружена)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СтатусыПотребностейТорговыхТочек.ЧастичноОтгружена)
	|				КОНЕЦ
	|		ИНАЧЕ Док.Статус
	|	КОНЕЦ КАК Состояние,
	|	ЕСТЬNULL(Строки.Запрошено, 0) КАК Запрошено,
	|	ЕСТЬNULL(Исполнение.Принято, 0) КАК Принято,
	|	ЕСТЬNULL(Исполнение.Отгружено, 0) КАК Отгружено,
	|	ЕСТЬNULL(Исполнение.Получено, 0) КАК Получено,
	|	Док.ЖелаемаяДата КАК ЖелаемаяДата,
	|	Док.ЖелаемаяДата <> ДАТАВРЕМЯ(1, 1, 1)
	|		И Док.ЖелаемаяДата < &НачалоДня
	|		И (Док.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПотребностейТорговыхТочек.Отправлена)
	|			ИЛИ Док.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПотребностейТорговыхТочек.Принята)
	|				И ЕСТЬNULL(Исполнение.Принято, 0) > ЕСТЬNULL(Исполнение.Отгружено, 0)) КАК Просрочена,
	|	Док.Ответственный КАК Ответственный,
	|	Док.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ПотребностьТорговойТочки КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Товары.Ссылка КАК Ссылка,
	|			СУММА(Товары.Количество) КАК Запрошено
	|		ИЗ
	|			Документ.ПотребностьТорговойТочки.ТЧТовары КАК Товары
	|		СГРУППИРОВАТЬ ПО
	|			Товары.Ссылка) КАК Строки
	|		ПО Док.Ссылка = Строки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Остатки.Потребность КАК Потребность,
	|			СУММА(Остатки.ПринятоОстаток) КАК Принято,
	|			СУММА(Остатки.ОтгруженоОстаток) КАК Отгружено,
	|			СУММА(Остатки.ПолученоОстаток) КАК Получено
	|		ИЗ
	|			РегистрНакопления.ПотребностиТорговыхТочек.Остатки КАК Остатки
	|		СГРУППИРОВАТЬ ПО
	|			Остатки.Потребность) КАК Исполнение
	|		ПО Док.Ссылка = Исполнение.Потребность";
КонецФункции
// BSLLS:VirtualTableCallWithoutParameters-on
// BSLLS:JoinWithSubQuery-on

#КонецОбласти
