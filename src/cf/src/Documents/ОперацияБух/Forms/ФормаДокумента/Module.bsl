#Область ОбработчикиСобыйтиЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	ЕстьДвижения = Объект.Движения.Хозрасчетный.Количество() > 0;

	Если ЕстьДвижения Тогда
		ТекстВопроса = НСтр("fr = 'Les comptes de règlement, les contrats, les divisions et les documents indiqués dans les transactions seront effacés. Continuer?'; ru = 'Указанные в проводках расчетные счета, договоры, подразделения, документы будут очищены. Продолжить?'; en = 'The settlement accounts, contracts, divisions, and documents specified in the transactions will be cleared. Continue?'; es = 'Las cuentas corrientes, los contratos, las Divisiones y los documentos indicados en las transacciones se borrarán. ¿Continuar?'");
		Оповещение = Новый ОписаниеОповещения("ВопросПриИзменииОрганизацииЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	Иначе
		ТекущаяОрганизация = Объект.Организация;
		НастроитьОтображениеТаблицыПроводок();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)

	Если НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДатаДокумента) Тогда
		// Изменение времени не влияет на поведение документа.
		ТекущаяДатаДокумента = Объект.Дата;
		Возврат;
	КонецЕсли;

	// Модуля ОбщегоНазначенияБПКлиент (БСП) в maERP нет: при смене дня обработка
	// всегда передается на сервер - это безопаснее, чем пропустить пересчет.
	ДатаПриИзмененииНаСервере();
	
	// Запомним новую дату документа.
	ТекущаяДатаДокумента = Объект.Дата;
	 
КонецПроцедуры

