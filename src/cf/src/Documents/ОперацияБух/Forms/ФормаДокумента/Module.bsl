		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	// Очистка существующих движений
	Если ЕстьДвижения() Тогда
		ТекстВопроса = НСтр("fr = 'Les transactions existantes et les mouvements des registres seront effacés."
"Continuer?'; ru = 'Существующие проводки и движения регистров будут очищены."
"Продолжить?'; en = 'Existing transactions and register movements will be cleared."
"Continue?'; es = 'Se borrarán las transacciones existentes y los movimientos de registro."
"¿Continuar?'");
			
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса,РежимДиалогаВопрос.ДаНет);
	Иначе
		// Формирование движений
		СформироватьДвиженияСторноСервер();
	КонецЕсли;
	
