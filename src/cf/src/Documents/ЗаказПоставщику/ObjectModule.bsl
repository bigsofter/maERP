
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) 
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	ДатаПоставки = КонецДня(ТекущаяДатаСеанса()) + 1;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда	
		Контрагент = ДанныеЗаполнения.Контрагент;
		Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(Контрагент, Организация, Ложь);
		КодСтроки = 1;
		Для Каждого Стр Из ДанныеЗаполнения.МасТовары Цикл
			НС = ТЧТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Стр);
			НС.СтавкаНДС = НС.Номенклатура.СтавкаНДС;
			НС.КодСтроки = КодСтроки;
			НС.СуммаНДС = РаботаСДокументамиКлиентСервер.РассчитатьСуммуНДС(НС.СтавкаНДС, НС.Сумма, ЦенаВключаетНДС);
			КодСтроки = КодСтроки + 1;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Если Документы.ЗаказПокупателя.ЗаказПроводится(ДанныеЗаполнения.ВидОперации) Тогда
			ЗаполнитьПоЗаказуНаПроизводство(ДанныеЗаполнения);
		Иначе
			ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПредложениеПоставщика") Тогда
		ЗаполнитьПоПредложениюПоставщика(ДанныеЗаполнения);
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьПоЗаказуПокупателя(Заказ)
	// Заказ поставщику под заказ покупателя: состав из заказа, поставщик - основной поставщик товаров
	// (если он один на все строки), цены - последний прайс поставщика.
	Организация = Заказ.Организация;
	ЦенаВключаетНДС = Истина; // цены прайса поставщиков хранятся с НДС
	МасНоменклатура = Заказ.ТЧТовары.Выгрузить().ВыгрузитьКолонку("Номенклатура");
	ЗаполнитьОбщегоОсновногоПоставщика(МасНоменклатура);
	ТЗЦены = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(ТекущаяДатаСеанса(), МасНоменклатура,
		?(ЗначениеЗаполнено(Контрагент), Контрагент, Неопределено));
	КодСтроки = 1;
	Для Каждого Стр Из Заказ.ТЧТовары Цикл
		НС = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Стр, "Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Количество, СтавкаНДС");
		НС.КодСтроки = КодСтроки;
		КодСтроки = КодСтроки + 1;
		СтрЦена = ТЗЦены.Найти(НС.Номенклатура, "Номенклатура");
		Если СтрЦена <> Неопределено Тогда
			НС.Цена = СтрЦена.Цена;
		КонецЕсли;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(НС, ЦенаВключаетНДС);
	КонецЦикла;
КонецПроцедуры

// Заказ поставщику под заказ клиента на производство (E7): основание - заказ, строки - дефицит потребности из
// регистра, а не из текущей техкарты. Без сформированной потребности ввод отклоняется (требование 3.6).
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ клиента на производство при включённой опции.
//
Процедура ЗаполнитьПоЗаказуНаПроизводство(Заказ)
	Потребности = РегистрыНакопления.ПотребностиПроизводства;
	Если Не Потребности.ЗаказФормируетПотребность(Заказ) Тогда
		ВызватьИсключение Потребности.ТекстЗаказБезПотребности();
	КонецЕсли;
	Организация = Заказ.Организация;
	Основание = Заказ;
	ЦенаВключаетНДС = Истина; // цены прайса поставщиков хранятся с НДС
	Дефицит = Потребности.ДефицитЗаказа(Заказ);
	ЗаполнитьОбщегоОсновногоПоставщика(Дефицит.ВыгрузитьКолонку("Материал"));
	Документы.ЗаказПоставщику.ЗаполнитьПоПотребности(ТЧТовары, Дефицит, ЦенаВключаетНДС, Контрагент);
	Если Дефицит.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Потребности.ТекстПотребностьЗаказана());
	КонецЕсли;
КонецПроцедуры

// Поставщик и договор - основной поставщик номенклатуры, если он у всех позиций один.
//
// Параметры:
//  Номенклатура - Массив - ссылки на номенклатуру строк.
//
Процедура ЗаполнитьОбщегоОсновногоПоставщика(Номенклатура)
	Поставщики = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Номенклатура, "ОсновнойПоставщик");
	ОдинПоставщик = Неопределено;
	Для Каждого КлючИЗначение Из Поставщики Цикл
		Если ОдинПоставщик = Неопределено Тогда
			ОдинПоставщик = КлючИЗначение.Значение.ОсновнойПоставщик;
		ИначеЕсли ОдинПоставщик <> КлючИЗначение.Значение.ОсновнойПоставщик Тогда
			ОдинПоставщик = Справочники.Контрагенты.ПустаяСсылка();
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(ОдинПоставщик) Тогда
		Контрагент = ОдинПоставщик;
		Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(Контрагент, Организация, Ложь);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьПоПредложениюПоставщика(Предложение)
	// Заказ поставщику по выигравшему предложению тендера: поставщик, договор, состав и цены
	// из предложения, основание - заказ покупателя, по которому шёл тендер.
	Организация = Предложение.Организация;
	Контрагент = Предложение.Поставщик;
	Если ЗначениеЗаполнено(Предложение.Договор) Тогда
		Договор = Предложение.Договор;
	Иначе
		Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(Контрагент, Организация, Ложь);
	КонецЕсли;
	Основание = Предложение.ЗаказПокупателя;
	ЦенаВключаетНДС = Предложение.ЦенаВключаетНДС;
	КодСтроки = 1;
	Для Каждого Стр Из Предложение.ТЧТовары Цикл
		НС = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Стр, "Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Количество, Цена, СтавкаНДС");
		НС.КодСтроки = КодСтроки;
		КодСтроки = КодСтроки + 1;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(НС, ЦенаВключаетНДС);
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	// Блокировки: потребности заказа клиента - до чтения их остатков
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	Блокировка.Заблокировать();
	// Формируем движения
	РегистрыНакопления.ЗаказыПоставщикам.СформироватьДвижения(ЭтотОбъект);
	РегистрыНакопления.ПотребностиПроизводства.СформироватьДвижения(ЭтотОбъект);
	// Записываем
	Движения.Записать();
	ПроизводственныеЗаказы.ОбновитьСтадииПослеПроведения(ЭтотОбъект);
КонецПроцедуры

// Отмена проведения документа, затронувшего заказы клиента на производство: блокировки в порядке проведения,
// очистка движений и пересчёт стадий заказов (E8). Без таких заказов движения удаляет платформа, как раньше.
//
// Параметры:
//  Отказ - Булево - не используется.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	ПроизводственныеЗаказы.ОтменитьПроведениеДокумента(ЭтотОбъект, Блокировка);
КонецПроцедуры

// Блокировки проведения и отмены проведения - один набор в одном порядке (E8).
//
// Параметры:
//  Блокировка - БлокировкаДанных - заполняемая блокировка.
//
Процедура ЗаполнитьБлокировкуПроведения(Блокировка)
	УправляемыеБлокировки.ПотребностиПроизводстваЗакупки(Блокировка, ЭтотОбъект);
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	РаботаСДокументами.ЗаполнитьИтогиДокумента(ЭтотОбъект);
	Если Не Отказ Тогда
		ПроизводственныеЗаказы.ЗапомнитьЗаказыДокумента(ЭтотОбъект, РежимЗаписи);
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Проведённый документ, перезаписанный без перепроведения, пересчитывает стадии своих заказов (E8).
	ПроизводственныеЗаказы.ОбновитьСтадииПриЗаписи(ЭтотОбъект);
КонецПроцедуры




