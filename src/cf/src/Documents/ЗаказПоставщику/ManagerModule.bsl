#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы объекта. Заказ и запросы котировок - фирменные формы под прежними командами
// (docs/plans/branded-print.md, раздел 13.7).
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	// Названия команд - прежние.
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаЗаказа(), ВидФормыЗаказа(), ПредставлениеЗаказа(),
		"ПечатьЗаказПоставщику");
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаЗапроса(), ВидФормыЗапроса(), ПредставлениеЗапроса(),
		"ПечатьЗапросКотировок");
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаЗапросаСФото(), ВидФормыЗапроса(),
		ПредставлениеЗапросаСФото(), "ПечатьЗапросКотировокСФото");

КонецПроцедуры

// Формирует запрошенные печатные формы.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые объекты
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Команды печати даны не всем ролям, которые читают заказ: право на команду проверяется и на сервере, а не только
	// видимостью кнопки - экспортный путь печати принимает любое имя макета (раздел 13.6 плана, урок фазы 5).
	Команды = Метаданные.Документы.ЗаказПоставщику.Команды;
	ФирменнаяПечать.ПроверитьПравоНаКоманду(КоллекцияПечатныхФорм, ИмяМакетаЗаказа(), Команды.ПечатьЗаказПоставщику,
		ПараметрыПечати);
	ФирменнаяПечать.ПроверитьПравоНаКоманду(КоллекцияПечатныхФорм, ИмяМакетаЗапроса(), Команды.ПечатьЗапросКотировок,
		ПараметрыПечати);
	ФирменнаяПечать.ПроверитьПравоНаКоманду(КоллекцияПечатныхФорм, ИмяМакетаЗапросаСФото(),
		Команды.ПечатьЗапросКотировокСФото, ПараметрыПечати);

	ФирменнаяПечать.Напечатать(ИмяМакетаЗаказа(), ВидФормыЗаказа(), МассивОбъектов, ПараметрыПечати,
		КоллекцияПечатныхФорм, ОбъектыПечати, ПредставлениеЗаказа());
	ФирменнаяПечать.Напечатать(ИмяМакетаЗапроса(), ВидФормыЗапроса(), МассивОбъектов, ПараметрыПечати,
		КоллекцияПечатныхФорм, ОбъектыПечати, ПредставлениеЗапроса());
	// Вариант с фото - параметром команды (раздел 13.3 плана); структура вызывающего не меняется.
	ПараметрыСФото = Новый Структура;
	Если ТипЗнч(ПараметрыПечати) = Тип("Структура") Тогда
		Для Каждого Параметр Из ПараметрыПечати Цикл
			ПараметрыСФото.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	ПараметрыСФото.Вставить("СФото", Истина);
	ФирменнаяПечать.Напечатать(ИмяМакетаЗапросаСФото(), ВидФормыЗапроса(), МассивОбъектов, ПараметрыСФото,
		КоллекцияПечатныхФорм, ОбъектыПечати, ПредставлениеЗапросаСФото());

КонецПроцедуры

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать): заказ поставщику и запросы котировок - одним запросом
// шапки на массив заказов (docs/plans/branded-print.md, раздел 13.5). Организация - покупатель, поставщик - продавец.
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.ЗаказПоставщику - печатаемые заказы.
//  ВидФормы        - Строка - CommandeFournisseur или DemandeDeCotation.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати; СФото = Истина - фото номенклатуры строк.
//
// Возвращаемое значение:
//  Соответствие - заказ -> источник печати (Данные, Плашка, ИмяФайла).
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Заказ.Ссылка КАК Ссылка,
	|	Заказ.Номер КАК НомерДокумента,
	|	Заказ.Дата КАК Дата,
	|	Заказ.Организация КАК Организация,
	|	Заказ.Контрагент КАК Контрагент,
	|	Заказ.Договор КАК Договор,
	|	Заказ.Валюта КАК Валюта,
	|	Заказ.ВВалюте КАК ВВалюте,
	|	Заказ.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Заказ.Сумма КАК Сумма,
	|	Заказ.СуммаНДС КАК СуммаНДС,
	|	Заказ.Комментарий КАК Комментарий,
	|	ПРЕДСТАВЛЕНИЕ(Заказ.Ответственный) КАК Автор
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Заказ
	|ГДЕ
	|	Заказ.Ссылка В(&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	СФото = ТипЗнч(ПараметрыПечати) = Тип("Структура") И ПараметрыПечати.Свойство("СФото")
		И ПараметрыПечати.СФото = Истина;
	// Заказ может прийти и в Печать другого документа: вид и право на команду проверяет сам адаптер (раздел 13.6 плана).
	Команды = Метаданные.Документы.ЗаказПоставщику.Команды;
	Если ВидФормы = ВидФормыЗаказа() Тогда
		Команда = Команды.ПечатьЗаказПоставщику;
	ИначеЕсли ВидФормы = ВидФормыЗапроса() Тогда
		Команда = ?(СФото, Команды.ПечатьЗапросКотировокСФото, Команды.ПечатьЗапросКотировок);
	Иначе
		Команда = Неопределено;
	КонецЕсли;
	ФирменнаяПечать.ПроверитьКомандуАдаптера(ВидФормы, Команда, ПараметрыПечати);
	Строки = ФирменнаяПечать.ДанныеСтрокДокументов("ЗаказПоставщику", Ссылки, "ТЧТовары", , СФото);
	Наименование = ?(ВидФормы = ВидФормыЗаказа(), "Commande fournisseur", "Demande de cotation");
	Результат = Новый Соответствие;
	Кэш = ФирменнаяПечать.НовыйКэш();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Шапка = ФирменнаяПечать.НоваяШапкаДокумента();
		ЗаполнитьЗначенияСвойств(Шапка, Выборка,
			"Дата, Организация, Контрагент, Договор, Валюта, ВВалюте, ЦенаВключаетНДС, Сумма, СуммаНДС, Комментарий, Автор");
		Шапка.Номер = ФирменнаяПечать.НомерНакладной(Выборка.НомерДокумента, Выборка.Дата);
		Шапка.ОрганизацияПокупатель = Истина;
		ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента(Наименование, Выборка.НомерДокумента, Выборка.Дата);
		Результат.Вставить(Выборка.Ссылка,
			ФирменнаяПечать.ИсточникТоварногоДокумента(Шапка, Строки[Выборка.Ссылка], Кэш, ИмяФайла));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Заполняет строки товаров заказа поставщику строками потребности производства: материал, характеристика,
// продукция, базовое количество, единица и ставка НДС номенклатуры, цена - последний прайс поставщика. Работает
// над табличной частью объекта и над данными формы - одна процедура для ввода на основании и команды формы.
//
// Параметры:
//  ТЧТовары        - ТабличнаяЧасть, ДанныеФормыКоллекция - строки товаров заказа; очищаются.
//  Строки          - ТаблицаЗначений - Продукция, Материал, Характеристика, Количество
//                    (см. РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа).
//  ЦенаВключаетНДС - Булево - цена документа включает НДС.
//  Контрагент      - СправочникСсылка.Контрагенты - поставщик для цен; пустой - последний прайс любого поставщика.
//
Процедура ЗаполнитьПоПотребности(ТЧТовары, Строки, ЦенаВключаетНДС, Контрагент) Экспорт

	ТЧТовары.Очистить();
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Материалы = Строки.ВыгрузитьКолонку("Материал");
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Материалы, "Единица, СтавкаНДС");
	Цены = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(ТекущаяДатаСеанса(), Материалы,
		?(ЗначениеЗаполнено(Контрагент), Контрагент, Неопределено));
	КодСтроки = 1;
	Для Каждого Строка Из Строки Цикл
		НоваяСтрока = ТЧТовары.Добавить();
		НоваяСтрока.КодСтроки = КодСтроки;
		КодСтроки = КодСтроки + 1;
		НоваяСтрока.Номенклатура = Строка.Материал;
		НоваяСтрока.Характеристика = Строка.Характеристика;
		НоваяСтрока.Продукция = Строка.Продукция;
		РеквизитыМатериала = Реквизиты[Строка.Материал];
		Если РеквизитыМатериала <> Неопределено Тогда
			НоваяСтрока.Упаковка = РеквизитыМатериала.Единица;
			НоваяСтрока.СтавкаНДС = РеквизитыМатериала.СтавкаНДС;
		КонецЕсли;
		НоваяСтрока.КоличествоУпаковок = Строка.Количество;
		НоваяСтрока.Количество = Строка.Количество;
		Цена = Цены.Найти(Строка.Материал, "Номенклатура");
		Если Цена <> Неопределено Тогда
			НоваяСтрока.Цена = Цена.Цена;
		КонецЕсли;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(НоваяСтрока, ЦенаВключаетНДС);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Печать

Функция ИмяМакетаЗаказа()
	Возврат "ЗаказПоставщику";
КонецФункции

Функция ИмяМакетаЗапроса()
	Возврат "ЗапросКотировок";
КонецФункции

Функция ИмяМакетаЗапросаСФото()
	Возврат "ЗапросКотировокСФото";
КонецФункции

Функция ПредставлениеЗаказа()
	Возврат НСтр("ru = 'Заказ поставщику'; fr = 'Commande au fournisseur';
		|en = 'Order to the supplier'; es = 'Pedido al proveedor'");
КонецФункции

Функция ПредставлениеЗапроса()
	Возврат НСтр("ru = 'Запрос котировок'; fr = 'Demande de devis';
		|en = 'Request for quotations'; es = 'Solicitud de cotizaciones'");
КонецФункции

Функция ПредставлениеЗапросаСФото()
	Возврат НСтр("ru = 'Запрос котировок с фото'; fr = 'Demande de devis avec photos';
		|en = 'Request for quotations with photos'; es = 'Solicitud de cotizaciones con fotos'");
КонецФункции

Функция ВидФормыЗаказа()
	Возврат "CommandeFournisseur";
КонецФункции

Функция ВидФормыЗапроса()
	Возврат "DemandeDeCotation";
КонецФункции

#КонецОбласти

#Область EMail

Процедура ОтправитьЗаказыПоставщикуКонтрагентам(МасДокументы) Экспорт
	// Вложение печатает фирменный заказ (раздел 13.5 плана). Право на его команду проверяется до привилегированного
	// режима: в нём проверка права в Печать не остановила бы пользователя без команды.
	Если Не ПравоДоступа("Просмотр", Метаданные.Документы.ЗаказПоставщику.Команды.ПечатьЗаказПоставщику) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для печати заказа поставщику.';
			|fr = 'Droits insuffisants pour imprimer la commande fournisseur.';
			|en = 'Insufficient rights to print the purchase order.';
			|es = 'Derechos insuficientes para imprimir el pedido al proveedor.'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	УчётнаяЗапись = Справочники.УчётныеЗаписиЭлектроннойПочты.ПолучитьПоФизическомуЛицу(ПараметрыСеанса.ФизическоеЛицо);
	Если Не ЗначениеЗаполнено(УчётнаяЗапись) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("fr = 'Aucun compte de messagerie sélectionné'; ru = 'Не выбрана учётная запись рассылки сообщений'; en = 'The message distribution account is not selected'; es = 'No se ha seleccionado la cuenta de envío de mensajes'"));
		Возврат;
	КонецЕсли;
	ТипКО = ПланыВидовХарактеристик.ВидыРеквизитовКонтрагентов.EMail;
	НазначениеРассылки = Перечисления.НазначенияРассылок.ОтделПродаж;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаказПоставщику.Ссылка КАК Ссылка,
	                      |	ЗаказПоставщику.Дата КАК Дата,
	                      |	ЗаказПоставщику.Номер КАК Номер,
	                      |	ЗаказПоставщику.Контрагент КАК Контрагент,
	                      |	ЗаказПоставщику.Организация КАК Организация
	                      |ИЗ
	                      |	Документ.ЗаказПоставщику КАК ЗаказПоставщику
	                      |ГДЕ
	                      |	ЗаказПоставщику.Ссылка В(&Док)");
	Запрос.УстановитьПараметр("Док", МасДокументы);
	ТЗДокументы = Запрос.Выполнить().Выгрузить();
	ТЗКонтактнаяИнформация = РегистрыСведений.РеквизитыКонтрагентов.ПолучитьКонтактнуюИнформацию(ТЗДокументы.ВыгрузитьКолонку("Контрагент"), ТипКО, НазначениеРассылки);	
	Для Каждого Стр Из ТЗДокументы Цикл		 
		// Адресаты
		МасАдреса = РегистрыСведений.РеквизитыКонтрагентов.ПолучитьКонтактнуюИнформациюПоТипу(Стр.Контрагент, ТипКО, НазначениеРассылки, ТЗКонтактнаяИнформация);
		Если МасАдреса.Количество() = 0 Тогда 
			ТекстОшибки = Нстр("ru = 'Не заполнены адреса по документу - '; fr = 'Adresses non renseignées sur le document -';
				|en = 'Addresses are not filled in for the document -'; es = 'Direcciones sin rellenar en el documento -'") + СокрЛП(Стр.Ссылка);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли;
		// Формируем
		МасВложения = Новый Массив;
		Каталог = КаталогВременныхФайлов();
		ТемаПисьма = СокрЛП(Стр.Организация) +  " - Заказ поставщику №" + Стр.Номер + " от " + Формат(Стр.Дата, "ДФ=dd.MM.yyyy");
		// Метод печати принимает массив и возвращает коллекцию форм (урок фазы 5).
		Печать = ПечатныеФормы.СформироватьПечатныеФормы("Документ.ЗаказПоставщику", ИмяМакетаЗаказа(),
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Стр.Ссылка));
		Таб = Печать.КоллекцияПечатныхФорм.Найти(ИмяМакетаЗаказа(), "ИмяМакета").ТабличныйДокумент;
		ИмяФайла = ОбщегоНазначенияКлиентСервер.ОбработатьИмяФайла(СокрЛП(Стр.Ссылка) + ".pdf");
		АдресВложения = Каталог + ИмяФайла;
		Таб.Записать(АдресВложения, ТипФайлаТабличногоДокумента.PDF);
		МасВложения.Добавить(АдресВложения);
		// Отправляем 		
		Результат = РаботаСЭлектроннойПочтой.ОтправитьСообщение(УчётнаяЗапись, МасАдреса, ТемаПисьма, "", МасВложения);
		Сообщить(Результат.Описание);
		// Удаляем временные файлы
		Для Каждого Вложение Из МасВложения Цикл
			УдалитьФайлы(Вложение);
		КонецЦикла;
	КонецЦикла;	
КонецПроцедуры	

#КонецОбласти