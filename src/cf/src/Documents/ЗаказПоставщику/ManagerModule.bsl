#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы объекта.
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "ЗаказПоставщику";
	Команда.Представление = НСтр("ru = 'Заказ поставщику'; fr = 'Commande au fournisseur';
		|en = 'Order to the supplier'; es = 'Pedido al proveedor'");

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "ЗапросКотировок";
	Команда.Представление = НСтр("ru = 'Запрос котировок'; fr = 'Demande de devis';
		|en = 'Request for quotations'; es = 'Solicitud de cotizaciones'");

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "ЗапросКотировокСФото";
	Команда.Представление = НСтр("ru = 'Запрос котировок с фото'; fr = 'Demande de devis avec photos';
		|en = 'Request for quotations with photos'; es = 'Solicitud de cotizaciones con fotos'");

КонецПроцедуры

// Формирует запрошенные печатные формы.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые объекты
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗаказПоставщику") Тогда
		Таб = Новый ТабличныйДокумент;
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			ПечатьЗаказПоставщику(Док, Таб);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "ЗаказПоставщику",
			НСтр("ru = 'Заказ поставщику'; fr = 'Commande au fournisseur';
			|en = 'Order to the supplier'; es = 'Pedido al proveedor'"),
			Таб, "Документ.ЗаказПоставщику.ЗаказПоставщику");
	КонецЕсли;

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗапросКотировок") Тогда
		Таб = Новый ТабличныйДокумент;
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			ПечатьЗапросКотировок(Док, Таб);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "ЗапросКотировок",
			НСтр("ru = 'Запрос котировок'; fr = 'Demande de devis';
			|en = 'Request for quotations'; es = 'Solicitud de cotizaciones'"),
			Таб, "Документ.ЗаказПоставщику.ЗапросКотировок");
	КонецЕсли;

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗапросКотировокСФото") Тогда
		Таб = Новый ТабличныйДокумент;
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			ПечатьЗапросКотировок(Док, Таб, Истина);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "ЗапросКотировокСФото",
			НСтр("ru = 'Запрос котировок с фото'; fr = 'Demande de devis avec photos';
			|en = 'Request for quotations with photos'; es = 'Solicitud de cotizaciones con fotos'"),
			Таб, "Документ.ЗаказПоставщику.ЗапросКотировок");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Печать

Процедура ПечатьЗаказПоставщику(Док, Таб) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Таб.Автомасштаб = Истина;
	Таб.КлючПараметровПечати = "Параметры_печати_Документ_ЗаказПоставщику_ЗаказПоставщику";
	Макет = ПечатныеФормы.МакетПечатнойФормы("Документ.ЗаказПоставщику.ЗаказПоставщику");

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Док,
		"Организация, Контрагент, Дата, Номер, Комментарий, Ответственный");
	КарточкаОрганизации = Справочники.Контрагенты.ПолучитьКарточку(Реквизиты.Организация, Реквизиты.Дата);
	КарточкаКонтрагента = Справочники.Контрагенты.ПолучитьКарточку(Реквизиты.Контрагент, Реквизиты.Дата);

	оЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	оШапка = Макет.ПолучитьОбласть("Шапка");
	оСтрока = Макет.ПолучитьОбласть("Строка");
	оПодвал = Макет.ПолучитьОбласть("Подвал");
	оИтого = Макет.ПолучитьОбласть("Итого");
	оПустаяСтрока = Макет.ПолучитьОбласть("EmptyLine");
	оРеквизитыОрганизации = Макет.ПолучитьОбласть("TabularSectionFooterCodes");

	Номер = РаботаСДокументами.СформироватьЦифровойНомер(Реквизиты.Номер) + "/" + Формат(Реквизиты.Дата, "Л=fr; ДФ=yy; ДЛФ=DD");
	оЗаголовок.Параметры.ТекстЗаголовка = НСтр("ru = 'Заказ поставщику'; fr = 'Commande fournisseur';
		|en = 'Purchase order'; es = 'Pedido al proveedor'");
	оЗаголовок.Параметры.Number = НСтр("ru = 'Номер: '; fr = 'Numéro: '; en = 'Number: '; es = 'Número: '") + Номер;
	оЗаголовок.Параметры.Date = НСтр("ru = 'Дата: '; fr = 'Date: '; en = 'Date: '; es = 'Fecha: '")
		+ Формат(Реквизиты.Дата, "Л=fr; ДФ=dd/MM/yyyy; ДЛФ=DD");
	оЗаголовок.Параметры.ПредставлениеПоставщика = ПредставлениеСтороныСICE(КарточкаКонтрагента);
	оЗаголовок.Параметры.ПредставлениеПокупателя = ПредставлениеСтороныСICE(КарточкаОрганизации);
	ПечатныеФормы.УстановитьЛоготип(оЗаголовок, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизиты.Организация, "Логотип"));
	Таб.Вывести(оЗаголовок);
	оШапка.Параметры.Заполнить(Док);
	Таб.Вывести(оШапка);
	оРеквизитыОрганизации.Параметры.НижнийКолонтитул = ПечатныеФормы.РеквизитыОрганизацииДляПодвала(
		Реквизиты.Организация, Реквизиты.Дата, КарточкаОрганизации);

	ТЗТовары = ПечатныеФормы.СформироватьТабличныеДанные(Док.ТЧТовары.Выгрузить());
	Для Каждого Стр Из ТЗТовары Цикл
		оСтрока.Параметры.Заполнить(Стр);
		Таб.Вывести(оСтрока);
	КонецЦикла;
	оИтого.Параметры.Total = ТЗТовары.Итог("СуммаСНДС");
	Таб.Вывести(оИтого);
	оПодвал.Параметры.Комментарий = Реквизиты.Комментарий;
	оПодвал.Параметры.Ответственный = Реквизиты.Ответственный;
	Таб.Вывести(оПодвал);
	ОбластиВнизу = Новый Массив;
	ОбластиВнизу.Добавить(оРеквизитыОрганизации);
	ПечатныеФормы.ДобитьСтраницуПустымиСтроками(Таб, оПустаяСтрока, ОбластиВнизу);
	Таб.Вывести(оРеквизитыОрганизации);
	Таб.ВывестиГоризонтальныйРазделительСтраниц();
	Таб.ИспользуемоеИмяФайла = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, "Commande fournisseur");
КонецПроцедуры

Функция ПредставлениеСтороныСICE(Карточка)
	ICE = Карточка.Реквизиты.ICE;
	Возврат Карточка.Наименование + ?(ЗначениеЗаполнено(ICE), " ICE: " + ICE, "");
КонецФункции

Процедура ПечатьЗапросКотировок(Док, Таб, СФото = Ложь) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Таб.Автомасштаб = Истина;
	Таб.КлючПараметровПечати = "Параметры_печати_Документ_ЗаказПоставщику_ЗапросКотировок";	
	Макет = ПечатныеФормы.МакетПечатнойФормы("Документ.ЗаказПоставщику.ЗапросКотировок");
	
	КарточкаОрганизации = Справочники.Контрагенты.ПолучитьКарточку(Док.Организация, Док.Дата);
	КарточкаКонтрагента = Справочники.Контрагенты.ПолучитьКарточку(Док.Контрагент, Док.Дата);
	
	оЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Если СФото Тогда 
		оШапка = Макет.ПолучитьОбласть("ШапкаФото");
		оСтрока = Макет.ПолучитьОбласть("СтрокаФото");
	Иначе
		оШапка = Макет.ПолучитьОбласть("Шапка");
		оСтрока = Макет.ПолучитьОбласть("Строка");
	КонецЕсли;
	оПодвал = Макет.ПолучитьОбласть("Подвал");
	
	оЗаголовок.Параметры.ТекстЗаголовка = НСтр("fr = 'Demande devis'; ru = 'Запрос котировок'; en = 'Request for quotations'; es = 'Solicitar cotizaciones'");
	оЗаголовок.Параметры.ПредставлениеПоставщика = КарточкаКонтрагента.Представление;
	оЗаголовок.Параметры.ПредставлениеПокупателя = КарточкаОрганизации.Представление;
	FieldPhoto = Док.Организация.Логотип.Get();
	Try
		оЗаголовок.Drawings[0].Picture = New Picture(FieldPhoto);
	Except
	EndTry;
	Таб.Вывести(оЗаголовок);
	оШапка.Параметры.Заполнить(Док);
	Таб.Вывести(оШапка);
	
	ТЗТовары = ПечатныеФормы.СформироватьТабличныеДанные(Док.ТЧТовары.Выгрузить());	
	Для Каждого Стр Из ТЗТовары Цикл
		оСтрока.Параметры.Заполнить(Стр);
		оСтрока.Параметры.CodeFournisseur = Стр.Номенклатура.КодПоставщика;
		оСтрока.Параметры.CodeFabricant = Стр.Номенклатура.КодПроизводителя;
		оСтрока.Параметры.ID = Стр.НоменклатураАртикул;
		Если СФото Тогда 
			НЗ = РегистрыСведений.ПрисоединённыеФайлы.СоздатьНаборЗаписей();
			НЗ.Отбор.Объект.Установить(Стр.Номенклатура);
			НЗ.Прочитать();
			Если НЗ.Количество() = 0 Тогда
				Картинка = Новый Картинка;
			Иначе
				ПерваяЗапись = НЗ.Получить(0);
				Если ПерваяЗапись.Внешний Тогда 
					Картинка = Новый Картинка(ПерваяЗапись.ИмяФайла);
				Иначе 
					Картинка = Новый Картинка(ПерваяЗапись.Данные.Получить());
				КонецЕсли;
			КонецЕсли;
			оСтрока.Рисунки.Получить(0).Картинка = Картинка;
		КонецЕсли;
		Таб.Вывести(оСтрока);
	КонецЦикла;
	оПодвал.Параметры.Комментарий = Док.Комментарий;
	оПодвал.Параметры.Ответственный = Док.Ответственный;
	Таб.Вывести(оПодвал);
	Таб.ВывестиГоризонтальныйРазделительСтраниц();
	Таб.ИспользуемоеИмяФайла = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, "Заказ поставщику");
КонецПроцедуры

#КонецОбласти

#Область EMail

Процедура ОтправитьЗаказыПоставщикуКонтрагентам(МасДокументы) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	УчётнаяЗапись = Справочники.УчётныеЗаписиЭлектроннойПочты.ПолучитьПоФизическомуЛицу(ПараметрыСеанса.ФизическоеЛицо);
	Если Не ЗначениеЗаполнено(УчётнаяЗапись) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("fr = 'Aucun compte de messagerie sélectionné'; ru = 'Не выбрана учётная запись рассылки сообщений'; en = 'The message distribution account is not selected'; es = 'No se ha seleccionado la cuenta de envío de mensajes'"));
		Возврат;
	КонецЕсли;
	ТипКО = ПланыВидовХарактеристик.ВидыРеквизитовКонтрагентов.EMail;
	НазначениеРассылки = Перечисления.НазначенияРассылок.ОтделПродаж;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаказПоставщику.Ссылка КАК Ссылка,
	                      |	ЗаказПоставщику.Дата КАК Дата,
	                      |	ЗаказПоставщику.Номер КАК Номер,
	                      |	ЗаказПоставщику.Контрагент КАК Контрагент,
	                      |	ЗаказПоставщику.Организация КАК Организация
	                      |ИЗ
	                      |	Документ.ЗаказПоставщику КАК ЗаказПоставщику
	                      |ГДЕ
	                      |	ЗаказПоставщику.Ссылка В(&Док)");
	Запрос.УстановитьПараметр("Док", МасДокументы);
	ТЗДокументы = Запрос.Выполнить().Выгрузить();
	ТЗКонтактнаяИнформация = РегистрыСведений.РеквизитыКонтрагентов.ПолучитьКонтактнуюИнформацию(ТЗДокументы.ВыгрузитьКолонку("Контрагент"), ТипКО, НазначениеРассылки);	
	Для Каждого Стр Из ТЗДокументы Цикл		 
		// Адресаты
		МасАдреса = РегистрыСведений.РеквизитыКонтрагентов.ПолучитьКонтактнуюИнформациюПоТипу(Стр.Контрагент, ТипКО, НазначениеРассылки, ТЗКонтактнаяИнформация);
		Если МасАдреса.Количество() = 0 Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru = 'Не заполнены адреса по документу - '; fr = 'Adresses non renseignées sur le document -'") + СокрЛП(Стр.Ссылка));
			Возврат;
		КонецЕсли;
		// Формируем
		МасВложения = Новый Массив;
		Каталог = КаталогВременныхФайлов();
		ТемаПисьма = СокрЛП(Стр.Организация) +  " - Заказ поставщику №" + Стр.Номер + " от " + Формат(Стр.Дата, "ДФ=dd.MM.yyyy");
		Таб = Новый ТабличныйДокумент;
		Документы.ЗаказПоставщику.ПечатьЗаказПоставщику(Стр.Ссылка, Таб); 
		ИмяФайла = ОбщегоНазначенияКлиентСервер.ОбработатьИмяФайла(СокрЛП(Стр.Ссылка) + ".pdf");
		АдресВложения = Каталог + ИмяФайла;
		Таб.Записать(АдресВложения, ТипФайлаТабличногоДокумента.PDF);
		МасВложения.Добавить(АдресВложения);
		// Отправляем 		
		Результат = РаботаСЭлектроннойПочтой.ОтправитьСообщение(УчётнаяЗапись, МасАдреса, ТемаПисьма, "", МасВложения);
		Сообщить(Результат.Описание);
		// Удаляем временные файлы
		Для Каждого Вложение Из МасВложения Цикл
			УдалитьФайлы(Вложение);
		КонецЦикла;
	КонецЦикла;	
КонецПроцедуры	

#КонецОбласти