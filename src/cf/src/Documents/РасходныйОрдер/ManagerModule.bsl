#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы ордера: фирменная накладная без цен (docs/plans/warehouse-orders.md, фаза 2, §2.9).
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаОрдера(), ВидФормыОрдера());
КонецПроцедуры

// Формирует запрошенные печатные формы.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые объекты
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	// Право на команду - и на сервере: экспортный путь печати принимает любое имя макета.
	ФирменнаяПечать.ПроверитьПравоНаКоманду(КоллекцияПечатныхФорм, ИмяМакетаОрдера(),
		Метаданные.Документы.РасходныйОрдер.Команды.ПечатьРасходныйОрдер, ПараметрыПечати);
	ФирменнаяПечать.Напечатать(ИмяМакетаОрдера(), ВидФормыОрдера(), МассивОбъектов, ПараметрыПечати,
		КоллекцияПечатныхФорм, ОбъектыПечати);
КонецПроцедуры

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать, ОрдераСклада.ДанныеФирменнойПечати).
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.РасходныйОрдер - печатаемые ордера.
//  ВидФормы        - Строка - вид фирменной формы: BonDeSortie.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати.
//
// Возвращаемое значение:
//  Соответствие - ордер -> источник печати.
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	// Ордер может прийти и в Печать другого документа: вид и право на команду проверяет сам адаптер.
	Команда = ?(ВидФормы = ВидФормыОрдера(), Метаданные.Документы.РасходныйОрдер.Команды.ПечатьРасходныйОрдер, Неопределено);
	ФирменнаяПечать.ПроверитьКомандуАдаптера(ВидФормы, Команда, ПараметрыПечати);
	Возврат ОрдераСклада.ДанныеФирменнойПечати(Метаданные.Документы.РасходныйОрдер.Имя, Ссылки, КодЯзыка);
КонецФункции

// Заполнение по заказу покупателя: шапка заказа, строки заказа, строка заказа - в КодСтрокиЗаказа (план
// warehouse-orders, фаза 2, §2.4).
//
// Параметры:
//  Ордер - ДокументОбъект.РасходныйОрдер - заполняемый ордер.
//  Заказ - ДокументСсылка.ЗаказПокупателя - основание.
//
Процедура ЗаполнитьПоЗаказуПокупателя(Ордер, Заказ) Экспорт
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "Организация, Контрагент");
	ЗаполнитьЗначенияСвойств(Ордер, Реквизиты);
	Ордер.Основание = Заказ;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Товары.КодСтроки КАК КодСтрокиЗаказа,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Позиции
	|		ПО Товары.Номенклатура = Позиции.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|	И Позиции.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Документы.ПриходныйОрдер.ЗагрузитьСтроки(Ордер, Запрос.Выполнить().Выгрузить());
КонецПроцедуры

// Заполнение по поступлению - см. ПриходныйОрдер.ЗаполнитьПоДокументуТоваров.
//
// Параметры:
//  Ордер    - ДокументОбъект.РасходныйОрдер - заполняемый ордер.
//  Документ - ДокументСсылка.ПоступлениеТоваровУслуг - основание.
//
Процедура ЗаполнитьПоДокументуТоваров(Ордер, Документ) Экспорт
	Документы.ПриходныйОрдер.ЗаполнитьПоДокументуТоваров(Ордер, Документ);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяМакетаОрдера()
	Возврат "РасходныйОрдер";
КонецФункции

Функция ВидФормыОрдера()
	Возврат "BonDeSortie";
КонецФункции

#КонецОбласти
