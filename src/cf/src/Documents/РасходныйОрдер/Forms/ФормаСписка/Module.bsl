#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ТоварыКОформлению) Тогда
		// Без права на регистр - колонка «К оформлению» нулевая: право проверяется по таблицам запроса списка.
		Список.ТекстЗапроса = ТекстЗапросаБезОформлений(Список.ТекстЗапроса);
		Элементы.ОтборКОформлению.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Состояние панели сведений восстанавливается из сохранённых данных формы.
	ПрименитьСостояниеПанели();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	// Очередь «К оформлению» после записи оформляющего документа (план warehouse-orders, фаза 4, §4.1).
	Если ИмяСобытия = "Запись_РеализацияТоваровУслуг" Тогда
		ОбновитьОчередь();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ПрименитьОтборы();

КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	// Отложенно: при листании стрелками не дёргать сервер на каждую строку.
	// BSLLS:MagicNumber-off - треть секунды, константа имени не добавит.
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьСведения", 0.3, Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьСведения()

	Ссылка = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.РасходныйОрдер") Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьСведения(Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Оформление выделенных ордеров одним поступлением или реализацией: сверка на сервере, форма нового документа с
// основанием - массивом ордеров; после закрытия формы очередь пересчитывается.
//
// Параметры:
//  Команда - КомандаФормы - команда «Оформить».
//
&НаКлиенте
Процедура Оформить(Команда)

	Ордера = Новый Массив;
	Для Каждого Выделенная Из Элементы.Список.ВыделенныеСтроки Цикл
		Ордера.Добавить(Выделенная);
	КонецЦикла;
	Проверка = ПроверкаОформления(Ордера);
	Если Не ПустаяСтрока(Проверка.Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Проверка.Текст);
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеОформления", ЭтотОбъект);
	ОткрытьФорму(Проверка.ИмяФормы, Новый Структура("Основание", Ордера), ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПослеОформления(Результат, ДополнительныеПараметры) Экспорт

	ОбновитьОчередь();

КонецПроцедуры

&НаКлиенте
Процедура СвернутьПанель(Команда)

	ПанельСвернута = Истина;
	ПрименитьСостояниеПанели();

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьПанель(Команда)

	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФильтры(Команда)

	ОткрытьСтраницуПанели("СтраницаФильтры");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДетали(Команда)

	ОткрытьСтраницуПанели("СтраницаИнфо");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Свёрнутая панель - столбик значков, развёрнутая - закладки со страницами.
// Значок открывает панель сразу на своей странице, как в УНФ.
//
&НаКлиенте
Процедура ПрименитьСостояниеПанели()

	Элементы.ГруппаПанельЗначки.Видимость = ПанельСвернута;
	Элементы.ГруппаПодвалПанели.Видимость = Не ПанельСвернута;
	Элементы.ГруппаСтраницыСведений.Видимость = Не ПанельСвернута;

КонецПроцедуры

// Разворачивает панель и активирует страницу по имени.
//
// Параметры:
//  ИмяСтраницы - Строка - имя страницы панели сведений
//
&НаКлиенте
Процедура ОткрытьСтраницуПанели(ИмяСтраницы)

	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();
	Элементы.ГруппаСтраницыСведений.ТекущаяСтраница = Элементы[ИмяСтраницы];

КонецПроцедуры

// Ставит либо снимает отборы динамического списка по полям правой панели.
// Отборы программные: пользовательские настройки списка их не перетирают.
//
// Параметры:
//  Ордера - Массив из ДокументСсылка - выделенные ордера.
//
// Возвращаемое значение:
//  Структура - см. ОрдераСклада.ПроверкаОформленияОрдеров.
//
&НаСервереБезКонтекста
Функция ПроверкаОформления(Знач Ордера)

	Возврат ОрдераСклада.ПроверкаОформленияОрдеров(Ордера);

КонецФункции

&НаКлиенте
Процедура ОбновитьОчередь()

	// Данные колонки «К оформлению» - перечитыванием списка.
	Элементы.Список.Обновить();

КонецПроцедуры

// Текст запроса списка без регистра оформлений: колонка «К оформлению» - 0.
//
// Параметры:
//  Текст - Строка - текст запроса списка.
//
// Возвращаемое значение:
//  Строка - текст без соединения с ТоварыКОформлению.
//
&НаСервереБезКонтекста
Функция ТекстЗапросаБезОформлений(Знач Текст)

	// Соединение с регистром оформлений - последнее в запросе, количество строк ордера остаётся.
	Начало = СтрНайти(Текст, "ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ", НаправлениеПоиска.СКонца);
	Если Начало = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = Лев(Текст, Начало - 1);
	Возврат СтрЗаменить(Текст, "ЕСТЬNULL(Остатки.КОформлению, 0) КАК КОформлению", "0 КАК КОформлению");

КонецФункции

&НаСервере
Процедура ПрименитьОтборы()

	Отборы = Новый Структура;
	Отборы.Вставить("Организация", ОтборОрганизация);
	Отборы.Вставить("МестоХранения", ОтборСклад);
	Отборы.Вставить("Ответственный", ОтборОтветственный);

	Для Каждого Отбор Из Отборы Цикл
		УстановитьОтборПоПолю(Отбор.Ключ, Отбор.Значение);
	КонецЦикла;
	// Очередь «К оформлению»: ордера с неоформленным остатком.
	// Значение отбора 0 общий помощник счёл бы пустым - элемент ставится и снимается явно.
	Если ОтборКОформлению Тогда
		ОтборыСписков.УстановитьОтбор(Список.Отбор, ОтборыСписков.ГруппаПанель(), "КОформлению", 0,
			ВидСравненияКомпоновкиДанных.Больше);
	Иначе
		ОтборыСписков.СнятьОтбор(Список.Отбор, ОтборыСписков.ГруппаПанель(), "КОформлению");
	КонецЕсли;

КонецПроцедуры

// Один программный элемент отбора списка: значение пусто - элемент снимается.
// Список значений отбирается видом сравнения «В списке».
//
// Параметры:
//  Поле         - Строка       - имя поля динамического списка
//  Значение     - Произвольный - отбираемое значение или СписокЗначений
//  ВидСравнения - ВидСравненияКомпоновкиДанных, Неопределено - вид сравнения;
//                 не задан - «Равно» («В списке» для списка значений)
//
&НаСервере
Процедура УстановитьОтборПоПолю(Поле, Значение, ВидСравнения = Неопределено)

	// Общий модуль: элемент поля - в группе «Панель», пустое значение снимает отбор (docs/plans/nomenclature-ui.md, P2-3).
	ОтборыСписков.УстановитьОтборЕслиЗаполнено(Список.Отбор, ОтборыСписков.ГруппаПанель(), Поле, Значение, ВидСравнения);

КонецПроцедуры

// Правая панель: сведения о документе текущей строки и его состав.
//
// Параметры:
//  Ссылка - ДокументСсылка.РасходныйОрдер - текущая строка списка
//
&НаСервере
Процедура ЗаполнитьСведения(Знач Ссылка)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Док.Организация КАК Организация,
		|	Док.МестоХранения КАК МестоХранения,
		|	Док.Контрагент КАК Контрагент,
		|	Док.Ответственный КАК Ответственный,
		|	Док.Основание КАК Основание,
		|	Док.Комментарий КАК Комментарий
		|ИЗ
		|	Документ.РасходныйОрдер КАК Док
		|ГДЕ
		|	Док.Ссылка = &Ссылка
		|;
		|ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	СУММА(Товары.Количество) КАК Количество
		|ИЗ
		|	Документ.РасходныйОрдер.ТЧТовары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	Товары.Номенклатура");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результаты = Запрос.ВыполнитьПакет();

	Шапка = Результаты[0].Выбрать();
	Если Не Шапка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	// Страница «Детали»: реквизиты документа, не выведенные колонками списка.
	Строки = Новый Массив;
	Если ЗначениеЗаполнено(Шапка.Организация) Тогда
		Шаблон = НСтр("ru = 'Наша компания: %1'; fr = 'Notre société: %1'; en = 'Our company: %1'; es = 'Nuestra empresa: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.Организация)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.МестоХранения) Тогда
		Шаблон = НСтр("ru = 'Склад: %1'; fr = 'Entrepôt: %1'; en = 'Warehouse: %1'; es = 'Almacén: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.МестоХранения)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Контрагент) Тогда
		Шаблон = НСтр("ru = 'Контрагент: %1'; fr = 'Contrepartie: %1'; en = 'Counterparty: %1'; es = 'Contraparte: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.Контрагент)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Ответственный) Тогда
		Шаблон = НСтр("ru = 'Ответственный: %1'; fr = 'Responsable: %1'; en = 'Responsible: %1'; es = 'Responsable: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.Ответственный)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Основание) Тогда
		Шаблон = НСтр("ru = 'Основание: %1'; fr = 'Base: %1'; en = 'Basis: %1'; es = 'Base: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.Основание)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Комментарий) Тогда
		Строки.Добавить("");
		Строки.Добавить(Шапка.Комментарий);
	КонецЕсли;
	ИнфоТекст = СтрСоединить(Строки, Символы.ПС);

	ТаблицаСостав.Очистить();
	Состав = Результаты[1].Выбрать();
	Пока Состав.Следующий() Цикл
		Строка = ТаблицаСостав.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Состав);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
