  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ВЫБОР
		КОГДА НЕ ДокументПоступлениеТоваровУслуг.Проведен
			ТОГДА -1
		КОГДА ЕСТЬNULL(Оплата.Остаток, ДокументПоступлениеТоваровУслуг.Сумма) &lt;= 0
			ТОГДА 0
		КОГДА ЕСТЬNULL(Оплата.Остаток, ДокументПоступлениеТоваровУслуг.Сумма) &lt; ДокументПоступлениеТоваровУслуг.Сумма
			ТОГДА 1
		ИНАЧЕ 2
	КОНЕЦ КАК НомерКартинкиОплаты,
	ЕСТЬNULL(Оплата.Остаток, ДокументПоступлениеТоваровУслуг.Сумма) КАК Долг,
	ДокументПоступлениеТоваровУслуг.Ссылка КАК Ссылка,
	ДокументПоступлениеТоваровУслуг.ПометкаУдаления КАК ПометкаУдаления,
	ДокументПоступлениеТоваровУслуг.Номер КАК Номер,
	ДокументПоступлениеТоваровУслуг.Дата КАК Дата,
	ДокументПоступлениеТоваровУслуг.Проведен КАК Проведен,
	ДокументПоступлениеТоваровУслуг.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	ДокументПоступлениеТоваровУслуг.Договор КАК Договор,
	ДокументПоступлениеТоваровУслуг.Комментарий КАК Комментарий,
	ДокументПоступлениеТоваровУслуг.Контрагент КАК Контрагент,
	ДокументПоступлениеТоваровУслуг.МестоХранения КАК МестоХранения,
	ДокументПоступлениеТоваровУслуг.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	ДокументПоступлениеТоваровУслуг.Организация КАК Организация,
	ДокументПоступлениеТоваровУслуг.Основание КАК Основание,
	ДокументПоступлениеТоваровУслуг.Ответственный КАК Ответственный,
	ДокументПоступлениеТоваровУслуг.Сумма КАК Сумма,
	ДокументПоступлениеТоваровУслуг.СуммаНДС КАК СуммаНДС,
	ДокументПоступлениеТоваровУслуг.СуммаБезНДС КАК СуммаБезНДС,
	ДокументПоступлениеТоваровУслуг.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	ДокументПоступлениеТоваровУслуг.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	ДокументПоступлениеТоваровУслуг.ТипЦеныПоТипуЦен КАК ТипЦеныПоТипуЦен,
	ДокументПоступлениеТоваровУслуг.ТЧТовары.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		КодСтроки КАК КодСтроки,
		НоменклатураКонтрагента КАК НоменклатураКонтрагента,
		Номенклатура КАК Номенклатура,
		Характеристика КАК Характеристика,
		Упаковка КАК Упаковка,
		Серия КАК Серия,
		УказаноНесколькоСерий КАК УказаноНесколькоСерий,
		КоличествоУпаковок КАК КоличествоУпаковок,
		КоличествоУпаковокПринято КАК КоличествоУпаковокПринято,
		Количество КАК Количество,
		КоличествоПринято КАК КоличествоПринято,
		Цена КАК Цена,
		Сумма КАК Сумма,
		СуммаСНДС КАК СуммаСНДС,
		СтавкаНДС КАК СтавкаНДС,
		СуммаНДС КАК СуммаНДС,
		ЦенаМинимальная КАК ЦенаМинимальная,
		ЦенаРозничная КАК ЦенаРозничная,
		ЦенаПоТипуЦен КАК ЦенаПоТипуЦен
	) КАК ТЧТовары,
	ДокументПоступлениеТоваровУслуг.ТЧСерии.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		КодСтроки КАК КодСтроки,
		Серия КАК Серия,
		Количество КАК Количество
	) КАК ТЧСерии,
	ДокументПоступлениеТоваровУслуг.ТЧУслуги.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Номенклатура КАК Номенклатура,
		Содержание КАК Содержание,
		Количество КАК Количество,
		Цена КАК Цена,
		Сумма КАК Сумма,
		СтавкаНДС КАК СтавкаНДС,
		СуммаНДС КАК СуммаНДС,
		СуммаСНДС КАК СуммаСНДС,
		СтатьяДДС КАК СтатьяДДС
	) КАК ТЧУслуги,
	ДокументПоступлениеТоваровУслуг.ТЧДополнительныеРасходы.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Договор КАК Договор,
		Комментарий КАК Комментарий,
		Контрагент КАК Контрагент,
		Номенклатура КАК Номенклатура,
		Характеристика КАК Характеристика,
		СтавкаНДС КАК СтавкаНДС,
		СтатьяДДС КАК СтатьяДДС,
		Сумма КАК Сумма,
		СуммаНДС КАК СуммаНДС,
		СуммаСНДС КАК СуммаСНДС
	) КАК ТЧДополнительныеРасходы,
	ДокументПоступлениеТоваровУслуг.ТЧЗачётАвансов.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Основание КАК Основание,
		Сумма КАК Сумма
	) КАК ТЧЗачётАвансов,
	ДокументПоступлениеТоваровУслуг.МоментВремени КАК МоментВремени,
	ЕСТЬNULL(ПрисоединённыеФайлыНаличие.ЕстьФайлы, ЛОЖЬ) КАК ЕстьФайлы,
	ДокументПоступлениеТоваровУслуг.ДатаОтгрузочногоДокумента КАК ДатаОтгрузочногоДокумента,
	ДокументПоступлениеТоваровУслуг.НомерОтгрузочногоДокумента КАК НомерОтгрузочногоДокумента
ИЗ
	Документ.НалоговаяНакладнаяПокупка КАК ДокументПоступлениеТоваровУслуг
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединённыеФайлыНаличие КАК ПрисоединённыеФайлыНаличие
		ПО ДокументПоступлениеТоваровУслуг.Ссылка = ПрисоединённыеФайлыНаличие.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Налоговый.Регистратор КАК Регистратор,
			СУММА(ВЫБОР
					КОГДА Налоговый.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
						ТОГДА Налоговый.Сумма
					ИНАЧЕ -Налоговый.Сумма
				КОНЕЦ) КАК Остаток
		ИЗ
			РегистрНакопления.ВзаиморасчётыСПоcтавщикамиНалоговый КАК Налоговый
		СГРУППИРОВАТЬ ПО
			Налоговый.Регистратор) КАК Оплата
		ПО ДокументПоступлениеТоваровУслуг.Ссылка = Оплата.Регистратор</queryText>
      <mainTable>Document.НалоговаяНакладнаяПокупка</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ТЧТовары.Количество</dataPath>
        <field>ТЧТовары.Количество</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ТЧТовары.КоличествоУпаковок</dataPath>
        <field>ТЧТовары.КоличествоУпаковок</field>
      </fields>
