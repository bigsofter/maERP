#Область ОбработчикиСобытий


Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	Основание = ДанныеЗаполнения;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПотребностьТорговойТочки") Тогда
		// Списание по принятой потребности точки (docs/plans/retail-store-needs.md).
		ПотребностиТорговыхТочек.ЗаполнитьСписаниеПоПотребности(ЭтотОбъект, ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		ТЗТовары = СерииИРазмещение.ОбъединитьТоварыССериями(ДанныеЗаполнения);
		Дата = ТекущаяДатаСеанса();
		Организация = ДанныеЗаполнения.Организация;
		МестоХранения = ДанныеЗаполнения.МестоХранения;
		ТЧТовары.Загрузить(ТЗТовары);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Если ДанныеЗаполнения.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеОприходование Тогда Возврат; КонецЕсли;
		Дата = ТекущаяДатаСеанса();
		Организация = ДанныеЗаполнения.Организация;
		МестоХранения = ДанныеЗаполнения.МестоХранения;
		МестоХраненияОприходование = ДанныеЗаполнения.МестоХраненияОприходование;
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеОприходование;
		ТЧТовары.Загрузить(ДанныеЗаполнения.ТЧТовары.Выгрузить());
	Иначе
		// Прочие основания - только реквизиты по умолчанию.
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	// Данные для проведения
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ТЗТоварыССериями", СерииИРазмещение.ОбъединитьТоварыССериями(ЭтотОбъект));
	// Блокировки
	Блокировка = Новый БлокировкаДанных;
	УправляемыеБлокировки.ТоварыВНаличии(Блокировка, ТЧТовары);
	Блокировка.Заблокировать();
	// Формируем
	Отказ = Не РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(ЭтотОбъект);
	Если Отказ Тогда Возврат КонецЕсли;
	// Исполнение потребностей точек (docs/plans/retail-store-needs.md): маршрут и строки, заморозка закрытых,
	// движения, баланс строк после записи.
	Для Каждого Текст Из ПотребностиТорговыхТочек.НарушенияМаршрута(ЭтотОбъект) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Потребности = ПотребностиПеремещения();
	ПотребностиТорговыхТочек.ЗаблокироватьПотребности(Потребности);
	ПотребностиТорговыхТочек.СформироватьДвиженияПеремещения(ЭтотОбъект);
	Нарушения = ПотребностиТорговыхТочек.НарушенияЗаморозки(ПрежниеДвиженияПотребностей(), Движения.ПотребностиТорговыхТочек);
	Для Каждого Текст Из Нарушения Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.Записать();
	Для Каждого Текст Из ПотребностиТорговыхТочек.НарушенияБаланса(Потребности) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Прежние = ПрежниеДвиженияПотребностей();
	Потребности = ПотребностиПрежнихДвижений(Прежние);
	Если Потребности.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПотребностиТорговыхТочек.ЗаблокироватьПотребности(Потребности);
	Для Каждого Текст Из ПотребностиТорговыхТочек.НарушенияЗаморозки(Прежние, Неопределено) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Набор очищается явно до проверки баланса: отмена списания при проведённом оприходовании - отказ.
	Движения.ПотребностиТорговыхТочек.Записывать = Истина;
	Движения.ПотребностиТорговыхТочек.Очистить();
	Движения.ПотребностиТорговыхТочек.Записать();
	Для Каждого Текст Из ПотребностиТорговыхТочек.НарушенияБаланса(Потребности) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
	КонецЦикла;
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если ПотребностиТорговыхТочек.ЕстьСвязиВРегистре(Ссылка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'Перемещение исполняет потребность точки: сначала отмените проведение.';
			|fr = 'Le transfert exécute un besoin de point de vente : annulez d''abord la validation.';
			|en = 'The transfer fulfils a store need: undo the posting first.';
			|es = 'El traslado cumple una necesidad del punto de venta: primero anule la contabilización.'"),
			ЭтотОбъект, , , Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	// Прежние движения потребностей - до записи: при перепроведении платформа удалит их до ОбработкаПроведения.
	ДополнительныеСвойства.Вставить("ПрежниеДвиженияПотребностей",
		?(ЭтоНовый(), Неопределено, ПотребностиТорговыхТочек.ПрежниеДвиженияДокумента(Ссылка)));
	СвязаноСПотребностями = ЕстьСтрокиСПотребностью() Или ДополнительныеСвойства.ПрежниеДвиженияПотребностей <> Неопределено
		И ДополнительныеСвойства.ПрежниеДвиженияПотребностей.Количество() > 0;
	Если Не Отказ И СвязаноСПотребностями И Не ПотребностиТорговыхТочек.ЗаписьПеремещенияРазрешена(ЭтотОбъект) Тогда
		// Исполнение потребностей меняет склад (доверенный) или точка командой «Получить отгрузку».
		СообщитьОбОтказе(НСтр("ru = 'Перемещение по потребности точки оформляет склад снабжения.';
			|fr = 'Le transfert d''un besoin de point de vente est saisi par l''entrepôt d''approvisionnement.';
			|en = 'A transfer for a store need is made by the supply warehouse.';
			|es = 'El traslado de una necesidad del punto de venta lo hace el almacén de abastecimiento.'"), Отказ);
	КонецЕсли;
	Если Не Отказ Тогда
		// Проверка исполнения потребностей читает регистр, на который у ролей без потребностей прав нет.
		// BSLLS:SetPrivilegedMode-off - только чтение регистра потребностей для проверки, запись - проведением
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		ПроверитьСвязиПотребностей(РежимЗаписи, Отказ);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Связи с потребностями точек (docs/plans/retail-store-needs.md, «ПеремещениеТоваров»): коды строк списания с
// потребностью, запись проведённого со связями - только проведением, неизменность основания, операции, складов и
// связей строк с движениями при перепроведении, блокировка списания-основания при проведении оприходования.
//
// Параметры:
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  Отказ       - Булево - выставляется при запрете.
//
Процедура ПроверитьСвязиПотребностей(РежимЗаписи, Отказ)
	ЕстьСвязи = ЕстьСтрокиСПотребностью();
	Прежние = ПрежниеДвиженияПотребностей();
	ДвиженияВБазе = Прежние <> Неопределено И Прежние.Количество() > 0;
	Если Не ЕстьСвязи И Не ДвиженияВБазе Тогда
		Возврат;
	КонецЕсли;
	ПроведенВБазе = Не ЭтоНовый() И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен") = Истина;
	Если РежимЗаписи = РежимЗаписиДокумента.Запись И ПроведенВБазе Тогда
		СообщитьОбОтказе(НСтр("ru = 'Перемещение по потребности точки записывается проведением.';
			|fr = 'Un transfert de besoin de point de vente s''enregistre par validation.';
			|en = 'A transfer for a store need is saved by posting.';
			|es = 'Un traslado de necesidad del punto de venta se guarda contabilizándolo.'"), Отказ);
		Возврат;
	КонецЕсли;
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	Списание = ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание;
	Если Списание И ЕстьСвязи Тогда
		ПроверитьКодыСтрокСписания(ПроведенВБазе, Отказ);
	КонецЕсли;
	Если ДвиженияВБазе Тогда
		ПроверитьНеизменностьСвязей(Отказ);
	КонецЕсли;
	ОснованиеСписание = ТипЗнч(Основание) = Тип("ДокументСсылка.ПеремещениеТоваров") И ЗначениеЗаполнено(Основание);
	Если Не Списание И ОснованиеСписание Тогда
		// До очистки прежних движений платформой (tiny1C bsl-029): получения одного списания - по очереди.
		ПотребностиТорговыхТочек.ЗаблокироватьДокумент("Документ.ПеремещениеТоваров", Основание);
	КонецЕсли;
КонецПроцедуры

// Есть ли строки со ссылкой на потребность точки.
//
// Возвращаемое значение:
//  Булево - Истина, если есть.
//
Функция ЕстьСтрокиСПотребностью()
	Для Каждого Строка Из ТЧТовары Цикл
		Если ЗначениеЗаполнено(Строка.Потребность) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Коды строк списания с потребностью - заполнены и уникальны (непроведённое дозаполняется).
//
// Параметры:
//  ПроведенВБазе - Булево - документ проведён в базе: коды не перенумеровываются.
//  Отказ         - Булево - выставляется при повторе.
//
Процедура ПроверитьКодыСтрокСписания(ПроведенВБазе, Отказ)
	Если Не ПроведенВБазе Тогда
		РаботаСДокументамиКлиентСервер.ЗаполнитьКодыСтрок(ТЧТовары);
	КонецЕсли;
	Коды = Новый Соответствие;
	Для Каждого Строка Из ТЧТовары Цикл
		Коды.Вставить(Строка.КодСтроки, ?(Коды[Строка.КодСтроки] = Неопределено, 1, Коды[Строка.КодСтроки] + 1));
	КонецЦикла;
	Для Каждого Строка Из ТЧТовары Цикл
		Если ЗначениеЗаполнено(Строка.Потребность) И (Строка.КодСтроки = 0 Или Коды[Строка.КодСтроки] > 1) Тогда
			Шаблон = НСтр("ru = 'Строка %1: код строки списания по потребности должен быть уникальным.';
				|fr = 'Ligne %1 : le code de ligne de la sortie du besoin doit être unique.';
				|en = 'Line %1: the write-off line code of a need must be unique.';
				|es = 'Línea %1: el código de línea de la salida de la necesidad debe ser único.'");
			СообщитьОбОтказе(СтрШаблон(Шаблон, Строка.НомерСтроки), Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Перепроведение документа с движениями потребностей не меняет основание, операцию, склады и связи строк с
// движениями (номенклатура, характеристика, серия, потребность, код строки потребности) и не удаляет такие строки;
// количество - меняется.
//
// Параметры:
//  Отказ - Булево - выставляется при изменении.
//
Процедура ПроверитьНеизменностьСвязей(Отказ)
	Шапка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,
		"Основание, ХозяйственнаяОперация, МестоХранения, МестоХраненияОприходование");
	ШапкаИзменена = Шапка.Основание <> Основание Или Шапка.ХозяйственнаяОперация <> ХозяйственнаяОперация
		Или Шапка.МестоХранения <> МестоХранения Или Шапка.МестоХраненияОприходование <> МестоХраненияОприходование;
	Если ШапкаИзменена Тогда
		СообщитьОбОтказе(ТекстОтменитеПроведение(), Отказ);
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.КодСтрокиОтгрузки КАК КодСтроки,
	|	Движения.Потребность КАК Потребность,
	|	Движения.КодСтроки КАК КодСтрокиПотребности,
	|	Движения.Номенклатура КАК Номенклатура,
	|	Движения.Характеристика КАК Характеристика,
	|	Движения.Серия КАК Серия
	|ИЗ
	|	РегистрНакопления.ПотребностиТорговыхТочек КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Поля = "Потребность, КодСтрокиПотребности, Номенклатура, Характеристика, Серия";
	Пока Выборка.Следующий() Цикл
		Строка = ТЧТовары.Найти(Выборка.КодСтроки, "КодСтроки");
		Если Строка = Неопределено Тогда
			// Строка с исполнением потребности удалена - исполнение пропало бы при сохранённом списании товара.
			СообщитьОбОтказе(ТекстОтменитеПроведение(), Отказ);
			Возврат;
		КонецЕсли;
		Прежняя = Новый Структура(Поля);
		ЗаполнитьЗначенияСвойств(Прежняя, Выборка);
		Текущая = Новый Структура(Поля);
		ЗаполнитьЗначенияСвойств(Текущая, Строка);
		Для Каждого КлючИЗначение Из Прежняя Цикл
			Если Текущая[КлючИЗначение.Ключ] <> КлючИЗначение.Значение Тогда
				СообщитьОбОтказе(ТекстОтменитеПроведение(), Отказ);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Текст отказа изменения связей проведённого перемещения.
//
// Возвращаемое значение:
//  Строка - текст.
//
Функция ТекстОтменитеПроведение()
	Возврат НСтр("ru = 'Перемещение исполняет потребность точки: основание, склады и строки меняются после отмены проведения.';
		|fr = 'Le transfert exécute un besoin : la base, les entrepôts et les lignes changent après annulation de la validation.';
		|en = 'The transfer fulfils a store need: the base, warehouses and lines change after undoing the posting.';
		|es = 'El traslado cumple una necesidad: la base, los almacenes y las líneas cambian tras anular la contabilización.'");
КонецФункции

// Сообщение об отказе записи.
//
// Параметры:
//  Текст - Строка - текст сообщения.
//  Отказ - Булево - выставляется.
//
Процедура СообщитьОбОтказе(Текст, Отказ)
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
КонецПроцедуры

// Прежние движения документа в регистре потребностей, собранные в ПередЗаписью.
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - см. ПотребностиТорговыхТочек.ПрежниеДвиженияДокумента.
//
Функция ПрежниеДвиженияПотребностей()
	Прежние = Неопределено;
	Если ДополнительныеСвойства.Свойство("ПрежниеДвиженияПотребностей", Прежние) И Прежние <> Неопределено Тогда
		Возврат Прежние;
	КонецЕсли;
	Возврат ?(ЭтоНовый(), Неопределено, ПотребностиТорговыхТочек.ПрежниеДвиженияДокумента(Ссылка));
КонецФункции

// Потребности прежних движений без повторов.
//
// Параметры:
//  Прежние - ТаблицаЗначений - см. ПотребностиТорговыхТочек.ПрежниеДвиженияДокумента.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ПотребностьТорговойТочки - потребности.
//
Функция ПотребностиПрежнихДвижений(Прежние)
	Поле = "Потребность";
	Копия = Прежние.Скопировать(, Поле);
	Копия.Свернуть(Поле);
	Возврат Копия.ВыгрузитьКолонку(Поле);
КонецФункции

// Потребности, затронутые проведением: прежних движений документа и строк.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ПотребностьТорговойТочки - потребности.
//
Функция ПотребностиПеремещения()
	Прежние = ПрежниеДвиженияПотребностей();
	Потребности = ?(Прежние = Неопределено, Новый Массив, ПотребностиПрежнихДвижений(Прежние));
	Для Каждого Строка Из ТЧТовары Цикл
		Если ЗначениеЗаполнено(Строка.Потребность) И Потребности.Найти(Строка.Потребность) = Неопределено Тогда
			Потребности.Добавить(Строка.Потребность);
		КонецЕсли;
	КонецЦикла;
	Возврат Потребности;
КонецФункции

#КонецОбласти
