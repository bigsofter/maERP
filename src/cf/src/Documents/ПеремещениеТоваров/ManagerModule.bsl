#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы документа.
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "НакладнаяНаПеремещение";
	Команда.БезЦен = Истина;
	Команда.Представление = НСтр("ru = 'Накладная на перемещение'; fr = 'Bon de transfert';
		|en = 'Transfer note'; es = 'Albarán de traslado'");

КонецПроцедуры

// Формирует запрошенные печатные формы документа.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые документы
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие документов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если Не ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "НакладнаяНаПеремещение") Тогда
		Возврат;
	КонецЕсли;

	Таб = Новый ТабличныйДокумент;
	ЦеныСкрыты = ПараметрыПечати <> Неопределено И ПараметрыПечати.Свойство("ЦеныСкрыты") И ПараметрыПечати.ЦеныСкрыты = Истина;
	СПечатьюСебестоимости = Не ЦеныСкрыты И ПоказыватьСебестоимость();
	Для Каждого Док Из МассивОбъектов Цикл
		НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
		ПечатьПеремещениеТоваров(Док, Таб, СПечатьюСебестоимости);
		ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
	КонецЦикла;

	ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "НакладнаяНаПеремещение",
		НСтр("ru = 'Накладная на перемещение'; fr = 'Bon de transfert';
			|en = 'Transfer note'; es = 'Albarán de traslado'"),
		Таб, "Документ.ПеремещениеТоваров.НакладнаяНаПеремещение");

КонецПроцедуры

// Строки заполнения перемещения остатками (docs/plans/retail-tools.md, п. 6): положительные остатки склада на дату по
// номенклатуре, характеристике и серии, без партий.
//
// Параметры:
//  Склад - СправочникСсылка.МестаХранения - склад-отправитель.
//  Дата  - Дата, Граница - дата остатков.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Серия, Количество, Упаковка (единица хранения).
//
Функция СтрокиОстатковСклада(Склад, Дата) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(&Дата, МестоХранения = &Склад) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика,
	|	Остатки.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстатки.Номенклатура КАК Номенклатура,
	|	ВТОстатки.Характеристика КАК Характеристика,
	|	ВТОстатки.Серия КАК Серия,
	|	ВТОстатки.Количество КАК Количество,
	|	Товары.Единица КАК Упаковка
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	|		ПО ВТОстатки.Номенклатура = Товары.Ссылка
	|ГДЕ
	|	ВТОстатки.Количество > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Серия");
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Дата", Дата);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Себестоимость строк перемещения (docs/plans/retail-tools.md, п. 6) по фактическому складу списания операции:
// первый этап - склад-отправитель, второй - склад «в пути». Проведённый документ - по его движениям расхода,
// непроведённый - оценка по средней себестоимости остатков склада списания на дату документа. Себестоимость - без
// НДС (Сумма - СуммаНДС), с дополнительными расходами партий.
//
// Параметры:
//  Документ - ДокументОбъект.ПеремещениеТоваров, ДанныеФормыСтруктура - перемещение.
//
// Возвращаемое значение:
//  Массив из Число - себестоимость каждой строки ТЧТовары по порядку.
//
Функция СебестоимостьСтрок(Документ) Экспорт

	Результат = Новый Массив;
	Проведен = Не Документ.Ссылка.Пустая() И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Ссылка, "Проведен");
	Если Проведен Тогда
		Источник = РегистрыНакопления.ТоварыВНаличии.ПолучитьСебестоимостьПоДокументу(Документ.Ссылка);
		Источник = Источник.Скопировать(Новый Структура("ВидДвижения", ВидДвиженияНакопления.Расход));
	Иначе
		Источник = СебестоимостьОстатков(СкладСписания(Документ), Документ);
	КонецЕсли;
	Источник.Индексы.Добавить("Номенклатура, Характеристика, Серия");
	Для Каждого Строка Из Документ.ТЧТовары Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика, Серия", Строка.Номенклатура, Строка.Характеристика,
			Строка.Серия);
		Найдено = Источник.НайтиСтроки(Отбор);
		Сумма = 0;
		Если Найдено.Количество() > 0 И Найдено[0].Количество <> 0 Тогда
			СтоимостьБезНДС = Найдено[0].Сумма - Найдено[0].СуммаНДС;
			Сумма = ОкругленнаяСумма(СтоимостьБезНДС / Найдено[0].Количество * Строка.Количество);
		КонецЕсли;
		Результат.Добавить(Сумма);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Видна ли текущему пользователю себестоимость перемещения: те же правила, что у сумм в отчётах продаж и контроле
// цен (КонтрольЦенПродажи.ПоказыватьСуммыПользователю), и не скрыты цены документов (ФирменнаяПечать.ЦеныСкрыты).
//
// Возвращаемое значение:
//  Булево - Истина, если себестоимость можно показать.
//
Функция ПоказыватьСебестоимость() Экспорт
	Возврат КонтрольЦенПродажи.ПоказыватьСуммыПользователю() И Не ФирменнаяПечать.ЦеныСкрыты();
КонецФункции

#КонецОбласти

#Область Печать

Процедура ПечатьПеремещениеТоваров(Док, Таб, СПечатьюСебестоимости = Ложь) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Таб.АвтоМасштаб = Истина;
	Таб.КлючПараметровПечати = "Параметры_печати_Документ_ПеремещениеТоваров_ПеремещениеТоваров";

	Макет = ПечатныеФормы.МакетПечатнойФормы("Документ.ПеремещениеТоваров.НакладнаяНаПеремещение");	
	оЗаголовок = Макет.ПолучитьОбласть("ЗаголовокПеремещение");
	оЗаголовок.Параметры.ТекстЗаголовка = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, НСтр("fr = 'Transfert de marchandises'; ru = 'Перемещение товаров'; en = 'Movement of goods'; es = 'Movimiento de mercancías'"));
	оЗаголовок.Параметры.ОрганизацияПредставление = Док.Организация;
	оЗаголовок.Параметры.ОтправительПредставление = Док.МестоХранения;
	оЗаголовок.Параметры.ПолучательПредставление = Док.МестоХраненияОприходование;
	Таб.Вывести(оЗаголовок);
	Таб.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(ТЗ.НомерСтроки КАК ЧИСЛО) КАК НомерСтроки,
	                      |	ВЫРАЗИТЬ(ТЗ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(ТЗ.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	                      |	ВЫРАЗИТЬ(ТЗ.Упаковка КАК Справочник.УпаковкиЕдиницыИзмерения) КАК Упаковка,
	                      |	ВЫРАЗИТЬ(ТЗ.КоличествоУпаковок КАК ЧИСЛО) КАК КоличествоУпаковок,
	                      |	ВЫРАЗИТЬ(ТЗ.Количество КАК ЧИСЛО) КАК Количество
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	&ТЗ КАК ТЗ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.НомерСтроки КАК НомерСтроки,
	                      |	ВТ.Номенклатура КАК Номенклатура,
	                      |	ВТ.Характеристика КАК Характеристика,
	                      |	ВЫБОР
	                      |		КОГДА ВТ.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	                      |			ТОГДА ВТ.Номенклатура.Единица
	                      |		ИНАЧЕ ВТ.Упаковка
	                      |	КОНЕЦ КАК Упаковка,
	                      |	ВТ.КоличествоУпаковок КАК КоличествоУпаковок,
	                      |	ВТ.Количество КАК Количество,
	                      |	ВТ.Номенклатура.Артикул КАК Артикул,
	                      |	ВТ.Номенклатура.Единица КАК ЕдиницаХранения
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	НомерСтроки");
	Запрос.УстановитьПараметр("ТЗ", Док.ТЧТовары.Выгрузить());
	Выб = Запрос.Выполнить().Выбрать();
	//
	оСтрока = Макет.ПолучитьОбласть("Строка"); 	
	Пока Выб.Следующий() Цикл
		оСтрока.Параметры.Заполнить(Выб);
		оСтрока.Параметры.Товар = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Выб.Номенклатура, Выб.Характеристика, , Истина);
		Таб.Вывести(оСтрока);
	КонецЦикла;
	Таб.Вывести(Макет.ПолучитьОбласть("Подвал"));
	Если СПечатьюСебестоимости Тогда
		ВывестиСебестоимость(Док, Таб);
	КонецЕсли;
	Таб.Вывести(Макет.ПолучитьОбласть("Подписи"));
	Таб.ВывестиГоризонтальныйРазделительСтраниц();
	Таб.ИспользуемоеИмяФайла = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, "Перемещение товаров");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СкладСписания(Документ)
	Если Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание Тогда
		Возврат Документ.МестоХранения;
	КонецЕсли;
	Возврат Справочники.МестаХранения.StockEnCoursDeRoute;
КонецФункции

Функция СебестоимостьОстатков(Склад, Документ)
	Номенклатура = Новый Массив;
	Для Каждого Строка Из Документ.ТЧТовары Цикл
		Номенклатура.Добавить(Строка.Номенклатура);
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СуммаОстаток КАК Сумма,
	|	Остатки.СуммаНДСОстаток КАК СуммаНДС
	|ПОМЕСТИТЬ ВТСтоимость
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			&Граница,
	|			МестоХранения = &Склад
	|				И Номенклатура В (&Номенклатура)) КАК Остатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Расходы.Номенклатура,
	|	Расходы.Характеристика,
	|	Расходы.Серия,
	|	0,
	|	Расходы.СуммаОстаток,
	|	Расходы.СуммаНДСОстаток
	|ИЗ
	|	РегистрНакопления.ДополнительныеРасходы.Остатки(
	|			&Граница,
	|			МестоХранения = &Склад
	|				И Номенклатура В (&Номенклатура)) КАК Расходы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Стоимость.Номенклатура КАК Номенклатура,
	|	Стоимость.Характеристика КАК Характеристика,
	|	Стоимость.Серия КАК Серия,
	|	СУММА(Стоимость.Количество) КАК Количество,
	|	СУММА(Стоимость.Сумма) КАК Сумма,
	|	СУММА(Стоимость.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	ВТСтоимость КАК Стоимость
	|
	|СГРУППИРОВАТЬ ПО
	|	Стоимость.Номенклатура,
	|	Стоимость.Характеристика,
	|	Стоимость.Серия");
	Запрос.УстановитьПараметр("Граница", ?(ЗначениеЗаполнено(Документ.Дата), Документ.Дата, ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ОкругленнаяСумма(Сумма)
	ЗнаковКопеек = 2;
	Возврат Окр(Сумма, ЗнаковКопеек);
КонецФункции

// Блок себестоимости в печатной форме: строки с себестоимостью и итог, при неактуальной себестоимости - строка
// «пересчитана по …».
//
// Параметры:
//  Док - ДокументСсылка.ПеремещениеТоваров - печатаемый документ.
//  Таб - ТабличныйДокумент - печатная форма, дополняется.
//
Процедура ВывестиСебестоимость(Док, Таб)
	Суммы = СебестоимостьСтрок(Док.ПолучитьОбъект());
	Блок = Новый ТабличныйДокумент;
	КолонкаТовара = 2;
	КолонкаКоличества = 3;
	КолонкаСуммы = 4;
	Жирный = ШрифтыСтиля.ВажнаяНадписьШрифт;
	Блок.Область(1, КолонкаТовара).Текст = НСтр("ru = 'Себестоимость'; fr = 'Prix de revient'; en = 'Cost price';
		|es = 'Precio de costo'");
	Блок.Область(1, КолонкаТовара).Шрифт = Жирный;
	Номер = 1;
	Итог = 0;
	Для Индекс = 0 По Док.ТЧТовары.Количество() - 1 Цикл
		Строка = Док.ТЧТовары[Индекс];
		Номер = Номер + 1;
		Блок.Область(Номер, КолонкаТовара).Текст = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(
			Строка.Номенклатура, Строка.Характеристика, , Истина);
		Блок.Область(Номер, КолонкаКоличества).Текст = Формат(Строка.Количество, "ЧДЦ=3; ЧН=0");
		Блок.Область(Номер, КолонкаСуммы).Текст = Формат(Суммы[Индекс], "ЧДЦ=2; ЧН=0,00");
		Итог = Итог + Суммы[Индекс];
	КонецЦикла;
	Номер = Номер + 1;
	Блок.Область(Номер, КолонкаТовара).Текст = НСтр("ru = 'Итого'; fr = 'Total'; en = 'Total'; es = 'Total'");
	Блок.Область(Номер, КолонкаСуммы).Текст = Формат(Итог, "ЧДЦ=2; ЧН=0,00");
	Блок.Область(Номер, КолонкаТовара, Номер, КолонкаСуммы).Шрифт = Жирный;
	Таб.Вывести(Блок);
	РаботаСДокументами.ВывестиСтрокуАктуальностиСебестоимости(Таб);
КонецПроцедуры

#КонецОбласти
