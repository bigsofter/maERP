#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы объекта. Запрос цен - фирменная форма под прежней командой (docs/plans/branded-print.md,
// раздел 13.7).
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаЗапросаЦен(), ВидФормыЗапросаЦен(), ПредставлениеЗапросаЦен());

КонецПроцедуры

// Формирует запрошенные печатные формы.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые объекты
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Право на команду - и на сервере: сейчас она есть у всех ролей, которые читают предложение, но новая роль с
	// чтением не должна получить форму без команды (раздел 13.6 плана).
	ФирменнаяПечать.ПроверитьПравоНаКоманду(КоллекцияПечатныхФорм, ИмяМакетаЗапросаЦен(),
		Метаданные.Документы.ПредложениеПоставщика.Команды.ПечатьЗапросЦен, ПараметрыПечати);
	ФирменнаяПечать.Напечатать(ИмяМакетаЗапросаЦен(), ВидФормыЗапросаЦен(), МассивОбъектов, ПараметрыПечати,
		КоллекцияПечатныхФорм, ОбъектыПечати, ПредставлениеЗапросаЦен());

КонецПроцедуры

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать): запрос цен (Demande de prix) по предложению поставщика
// (docs/plans/branded-print.md, раздел 13.5). Организация - покупатель, поставщик - продавец.
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.ПредложениеПоставщика - печатаемые предложения.
//  ВидФормы        - Строка - DemandeDePrix.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати.
//
// Возвращаемое значение:
//  Соответствие - предложение -> источник печати (Данные, Плашка, ИмяФайла).
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Предложение.Ссылка КАК Ссылка,
	|	Предложение.Номер КАК НомерДокумента,
	|	Предложение.Дата КАК Дата,
	|	Предложение.Организация КАК Организация,
	|	Предложение.Поставщик КАК Контрагент,
	|	Предложение.Договор КАК Договор,
	|	Предложение.Валюта КАК Валюта,
	|	Предложение.ВВалюте КАК ВВалюте,
	|	Предложение.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Предложение.Сумма КАК Сумма,
	|	Предложение.СуммаНДС КАК СуммаНДС,
	|	Предложение.Комментарий КАК Комментарий,
	|	ПРЕДСТАВЛЕНИЕ(Предложение.Ответственный) КАК Автор
	|ИЗ
	|	Документ.ПредложениеПоставщика КАК Предложение
	|ГДЕ
	|	Предложение.Ссылка В(&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	// Предложение может прийти и в Печать другого документа: вид и право на команду проверяет сам адаптер.
	Команда = ?(ВидФормы = ВидФормыЗапросаЦен(), Метаданные.Документы.ПредложениеПоставщика.Команды.ПечатьЗапросЦен,
		Неопределено);
	ФирменнаяПечать.ПроверитьКомандуАдаптера(ВидФормы, Команда, ПараметрыПечати);
	Строки = ФирменнаяПечать.ДанныеСтрокДокументов("ПредложениеПоставщика", Ссылки, "ТЧТовары");
	Результат = Новый Соответствие;
	Кэш = ФирменнаяПечать.НовыйКэш();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Шапка = ФирменнаяПечать.НоваяШапкаДокумента();
		ЗаполнитьЗначенияСвойств(Шапка, Выборка,
			"Дата, Организация, Контрагент, Договор, Валюта, ВВалюте, ЦенаВключаетНДС, Сумма, СуммаНДС, Комментарий, Автор");
		Шапка.Номер = ФирменнаяПечать.НомерНакладной(Выборка.НомерДокумента, Выборка.Дата);
		Шапка.ОрганизацияПокупатель = Истина;
		ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента("Demande de prix", Выборка.НомерДокумента, Выборка.Дата);
		Результат.Вставить(Выборка.Ссылка,
			ФирменнаяПечать.ИсточникТоварногоДокумента(Шапка, Строки[Выборка.Ссылка], Кэш, ИмяФайла));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает предложения поставщиков по заказу покупателя, отсортированные по сумме в основной валюте
// (лучшее - наименьшая сумма - первым): предложения могут быть в разных валютах.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ, по которому идёт тендер.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Ссылка, Поставщик, Сумма (в валюте предложения), Валюта, СуммаРегл (в основной
//                    валюте), СрокПоставкиДней, Победитель.
//
Функция ПредложенияЗаказа(Заказ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Предложения.Ссылка КАК Ссылка,
	|	Предложения.Поставщик КАК Поставщик,
	|	Предложения.Сумма КАК Сумма,
	|	ВЫБОР
	|		КОГДА Предложения.ВВалюте
	|			ТОГДА Предложения.Валюта
	|		ИНАЧЕ &ОсновнаяВалюта
	|	КОНЕЦ КАК Валюта,
	|	ВЫБОР
	|		КОГДА Предложения.ВВалюте
	|			ТОГДА Предложения.СуммаРегл
	|		ИНАЧЕ Предложения.Сумма
	|	КОНЕЦ КАК СуммаРегл,
	|	Предложения.СрокПоставкиДней КАК СрокПоставкиДней,
	|	Предложения.Победитель КАК Победитель
	|ИЗ
	|	Документ.ПредложениеПоставщика КАК Предложения
	|ГДЕ
	|	Предложения.ЗаказПокупателя = &Заказ
	|	И НЕ Предложения.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	СуммаРегл";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("ОсновнаяВалюта", РаботаСВалютами.ОсновнаяВалюта());
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Делает предложение победителем тендера: у остальных предложений того же заказа покупателя
// флаг победителя снимается, у выбранного - устанавливается. Изменения пишутся в одной транзакции.
//
// Параметры:
//  Предложение - ДокументСсылка.ПредложениеПоставщика - выбранное предложение.
//
Процедура ВыбратьПобедителя(Предложение) Экспорт
	Заказ = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Предложение), "ЗаказПокупателя").Получить(Предложение).ЗаказПокупателя;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.ПредложениеПоставщика");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		// Предложения читаются под блокировкой: выбор, сделанный параллельно, уже виден - двух победителей не будет.
		ТЗПредложения = ПредложенияЗаказа(Заказ);
		Для Каждого Стр Из ТЗПредложения Цикл
			ЭтоПобедитель = Стр.Ссылка = Предложение;
			Если Стр.Победитель = ЭтоПобедитель Тогда
				Продолжить;
			КонецЕсли;
			ДокОбъект = Стр.Ссылка.ПолучитьОбъект();
			ДокОбъект.Победитель = ЭтоПобедитель;
			ДокОбъект.Записать();
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяМакетаЗапросаЦен()
	Возврат "ЗапросЦен";
КонецФункции

Функция ПредставлениеЗапросаЦен()
	// Название прежней команды.
	Возврат НСтр("ru = 'Запрос цен'; fr = 'Demande de prix';
		|en = 'Request for prices'; es = 'Solicitud de precios'");
КонецФункции

Функция ВидФормыЗапросаЦен()
	Возврат "DemandeDePrix";
КонецФункции

#КонецОбласти
