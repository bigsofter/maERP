#Область ПрограммныйИнтерфейс

// Заполняет требование-накладную по строке продукции заказа на производство: продукция строки, количество (не задано -
// количество строки), организация заказа и материалы - листья дерева материалов строки (полуфабрикат, который мы
// разворачиваем, сам не загружается: его делают из его же материалов), пропорционально количеству требования.
// Загруженное по умолчанию израсходуется целиком.
//
// Параметры:
//  Объект     - ДокументОбъект.ТребованиеНакладная, ДанныеФормыСтруктура - заполняемое требование
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  КодСтроки  - Число - КодСтроки строки продукции заказа
//  Количество - Число - количество продукции; 0 - количество строки заказа
//
Процедура ЗаполнитьПоСтрокеЗаказа(Объект, Заказ, КодСтроки, Количество = 0) Экспорт

	Объект.Заказ = Заказ;
	Объект.КодСтрокиПродукции = КодСтроки;
	Объект.Материалы.Очистить();
	ЗаказОбъект = Заказ.ПолучитьОбъект();
	Если ЗаказОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.Организация = ЗаказОбъект.Организация;
	СтрокаПродукции = ЗаказОбъект.ТЧТовары.Найти(КодСтроки, "КодСтроки");
	Если СтрокаПродукции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.Номенклатура = СтрокаПродукции.Номенклатура;
	Объект.Характеристика = СтрокаПродукции.Характеристика;
	Объект.Количество = ?(Количество > 0, Количество, СтрокаПродукции.Количество);
	Если СтрокаПродукции.Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	Доля = Объект.Количество / СтрокаПродукции.Количество;
	СПотомками = Документы.ЗаказПокупателя.КодыСтрокСПотомками(ЗаказОбъект.ТЧМатериалы);
	Для Каждого Материал Из ЗаказОбъект.ТЧМатериалы Цикл
		Если Материал.КодСтрокиПродукции <> КодСтроки Или Не ЗначениеЗаполнено(Материал.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Документы.ЗаказПокупателя.КлючРодителяМатериала(Материал.КодСтрокиПродукции, Материал.КодСтроки);
		Если СПотомками[Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строка = Объект.Материалы.Добавить();
		Строка.КодСтроки = Объект.Материалы.Количество();
		Строка.Номенклатура = Материал.Номенклатура;
		Строка.Характеристика = Материал.Характеристика;
		Строка.Количество = Окр(Материал.Количество * Доля, ЗнаковКоличества());
		Строка.Израсходовано = Строка.Количество;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗнаковКоличества()

	Возврат 3;

КонецФункции

#КонецОбласти
