// Форма требования-накладной: строка продукции заказа, материалы, план и факт загрузки станка. Команды «Разместить»,
// «Запустить», «Завершить», «Отменить» ставят статус и проводят документ; «Вернуть в работу» - руководителю и
// администратору. Правила - общий модуль ТребованияНакладные.
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьФорму();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьФорму();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьФорму();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтанокПриИзменении(Элемент)

	СтанокПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЗаказПриИзменении(Элемент)

	Объект.КодСтрокиПродукции = 0;
	Объект.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	Объект.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	Объект.Материалы.Очистить();
	СтрокаПродукции = ПредставлениеСтроки(Объект.КодСтрокиПродукции);

КонецПроцедуры

&НаКлиенте
Процедура СтрокаПродукцииНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строки = СтрокиПродукцииЗаказа(Объект.Заказ);
	Если Строки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите заказ на производство со строками продукции и материалами';
			|fr = 'Choisissez une commande de production avec des lignes de produits et des matières';
			|en = 'Select a production order with product lines and materials';
			|es = 'Elija un pedido de producción con líneas de producto y materiales'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораСтрокиПродукции", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оповещение, Строки, Элемент);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьМатериалы(Команда)

	Если Объект.КодСтрокиПродукции = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала выберите строку продукции заказа';
			|fr = 'Choisissez d''abord la ligne de produit de la commande';
			|en = 'Select the product line of the order first';
			|es = 'Primero elija la línea de producto del pedido'"));
		Возврат;
	КонецЕсли;
	ЗаполнитьПоСтрокеНаСервере(Объект.КодСтрокиПродукции);

КонецПроцедуры

&НаКлиенте
Процедура Разместить(Команда)

	ВыполнитьДействие("Разместить");

КонецПроцедуры

&НаКлиенте
Процедура Запустить(Команда)

	ВыполнитьДействие("Запустить");

КонецПроцедуры

&НаКлиенте
Процедура Завершить(Команда)

	ВыполнитьДействие("Завершить");

КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)

	ВыполнитьДействие("Отменить");

КонецПроцедуры

&НаКлиенте
Процедура ВернутьВРаботу(Команда)

	Если ВернутьВРаботуНаСервере() Тогда
		Оповестить("Запись_ТребованиеНакладная", , Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеВыбораСтрокиПродукции(Выбранный, ДополнительныеПараметры) Экспорт

	Если Выбранный = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьПоСтрокеНаСервере(Выбранный.Значение);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Действие)

	Если ВыполнитьДействиеНаСервере(Действие) Тогда
		Оповестить("Запись_ТребованиеНакладная", , Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВыполнитьДействиеНаСервере(Знач Действие)

	Документ = РеквизитФормыВЗначение("Объект");
	Попытка
		ТребованияНакладные.ВыполнитьДействие(Документ, Действие);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	ЗначениеВРеквизитФормы(Документ, "Объект");
	Модифицированность = Ложь;
	ОбновитьФорму();
	Возврат Истина;

КонецФункции

&НаСервере
Функция ВернутьВРаботуНаСервере()

	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Сначала запишите требование-накладную';
			|fr = 'Enregistrez d''abord le bon de consommation';
			|en = 'Save the requisition first';
			|es = 'Primero guarde el vale'"));
		Возврат Ложь;
	КонецЕсли;
	Попытка
		ТребованияНакладные.ВернутьВРаботу(Объект.Ссылка);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");
	ОбновитьФорму();
	Возврат Истина;

КонецФункции

&НаСервере
Процедура СтанокПриИзмененииНаСервере()

	Если ЗначениеЗаполнено(Объект.Станок) Тогда
		Объект.Оператор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Станок, "Оператор");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСтрокеНаСервере(Знач КодСтроки)

	Документы.ТребованиеНакладная.ЗаполнитьПоСтрокеЗаказа(Объект, Объект.Заказ, КодСтроки, Объект.Количество);
	СтрокаПродукции = ПредставлениеСтроки(КодСтроки);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СтрокиПродукцииЗаказа(Знач Заказ)

	Возврат ТребованияНакладные.СтрокиПродукцииЗаказа(Заказ);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеСтроки(КодСтроки)

	Если КодСтроки = 0 Тогда
		Возврат НСтр("ru = 'выбрать'; fr = 'choisir'; en = 'select'; es = 'elegir'");
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'строка с кодом %1'; fr = 'ligne de code %1'; en = 'line code %1'; es = 'línea de código %1'"),
		КодСтроки);

КонецФункции

// Выпуск по требованию, подпись строки продукции и доступность команд по статусу: завершённое и отменённое
// требование только просматривается.
//
&НаСервере
Процедура ОбновитьФорму()

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Статус = Объект.Статус;
	Выпуск = ТребованияНакладные.ВыпускПоТребованию(Объект.Ссылка);
	СтрокаПродукции = ПредставлениеСтроки(Объект.КодСтрокиПродукции);
	Закрыто = Статус = Статусы.Завершено Или Статус = Статусы.Отменено;
	ТолькоПросмотр = Закрыто;
	Элементы.ФормаРазместить.Видимость = Не Закрыто И Статус <> Статусы.Запущено;
	Элементы.ФормаЗапустить.Видимость = Не Закрыто;
	Элементы.ФормаЗавершить.Видимость = Статус = Статусы.Запущено;
	Элементы.ФормаОтменить.Видимость = Не Закрыто И Не Объект.Ссылка.Пустая();
	Элементы.ФормаВернутьВРаботу.Видимость = Статус = Статусы.Завершено
		И ТребованияНакладные.МожноВозвращатьВРаботу();
	Элементы.ДатаОтмены.Видимость = Статус = Статусы.Отменено;
	Элементы.МатериалыОставлены.Видимость = Статус = Статусы.Отменено;

КонецПроцедуры

#КонецОбласти
