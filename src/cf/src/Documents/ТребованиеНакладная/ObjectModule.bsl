#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	Дата = ТекущаяДатаСеанса();
	Статус = Перечисления.СтатусыТребованийНакладных.Запланировано;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.ПроизводственноеОборудование") Тогда
		Станок = ДанныеЗаполнения;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Заказ = ДанныеЗаполнения;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Станок, Заказ");
		Если ДанныеЗаполнения.Свойство("КодСтрокиПродукции") Тогда
			// Имя «Количество» здесь - реквизит документа: локальная переменная названа иначе (bsl-010).
			КоличествоПродукции = 0;
			ДанныеЗаполнения.Свойство("Количество", КоличествоПродукции);
			Документы.ТребованиеНакладная.ЗаполнитьПоСтрокеЗаказа(ЭтотОбъект, ДанныеЗаполнения.Заказ,
				ДанныеЗаполнения.КодСтрокиПродукции, КоличествоПродукции);
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Станок) Тогда
		Оператор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Станок, "Оператор");
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ТребованияНакладные.ПередЗаписьюТребования(ЭтотОбъект, Отказ, РежимЗаписи);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Привилегированный режим проведения задан в свойствах документа; блокировки, проверки и движения - в общем
	// модуле. Наборы перемещения при перепроведении не пересобираются (удаление движений - только при отмене).
	ТребованияНакладные.ОбработкаПроведенияТребования(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ТекстЗапрета = ТребованияНакладные.ТекстЗапретаУдаления(Ссылка);
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, , , , Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
	Дата = ТекущаяДатаСеанса();
	Статус = Перечисления.СтатусыТребованийНакладных.Запланировано;
	ПланНачало = '00010101';
	ПланОкончание = '00010101';
	ДлительностьВручную = 0;
	ФактНачало = '00010101';
	ФактОкончание = '00010101';
	ДатаОтмены = '00010101';
	КоличествоФакт = 0;
	МатериалыОставлены = Ложь;
	СписыватьПриРазмещении = Ложь;
	Для Каждого Строка Из Материалы Цикл
		Строка.СоСкладаСтанка = 0;
		Строка.Израсходовано = Строка.Количество;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
