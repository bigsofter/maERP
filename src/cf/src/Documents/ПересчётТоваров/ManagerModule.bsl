#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы объекта: инвентаризационная опись (все строки) и сличительная ведомость (только строки с
// расхождением) - docs/plans/inventory-print.md. Обе печатаются и без цен, количествами.
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = ИмяОписи();
	Команда.БезЦен = Истина;
	Команда.Представление = ПредставлениеОписи();
	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = ИмяВедомости();
	Команда.БезЦен = Истина;
	Команда.Представление = ПредставлениеВедомости();

КонецПроцедуры

// Формирует запрошенные печатные формы.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые объекты
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Права ролей на команды серверное формирование не ограничивают: суммы - только у кого есть команда описи.
	// BSLLS:YoLetterUsage-off - имя документа в метаданных пишется через «ё».
	БезСумм = ПечатныеФормы.ПечататьБезЦен(ПараметрыПечати)
		Или Не ПравоДоступа("Просмотр", Метаданные.Документы.ПересчётТоваров.Команды.ПечатьИнвентаризационнаяОпись);
	// BSLLS:YoLetterUsage-on
	Язык = ПечатныеФормы.ЯзыкПечати();
	Для Каждого ИмяМакета Из СтрРазделить(ИмяОписи() + "," + ИмяВедомости(), ",") Цикл
		Если Не ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета) Тогда
			Продолжить;
		КонецЕсли;
		ТолькоРасхождения = ИмяМакета = ИмяВедомости();
		Таб = Новый ТабличныйДокумент;
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			ПечатьОписи(Док, Таб, ТолькоРасхождения, БезСумм);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, ИмяМакета,
			?(ТолькоРасхождения, ПредставлениеВедомости(Язык), ПредставлениеОписи(Язык)), Таб, ПутьКМакету());
	КонецЦикла;

КонецПроцедуры

// Сумма на языке печати: два знака, ноль - «0». Тот же формат, что в описи (тест ищет сумму в печатной форме).
//
// Параметры:
//  Значение - Число - сумма.
//  Язык     - Строка - код языка печати.
//
// Возвращаемое значение:
//  Строка - представление.
//
Функция ФорматСуммы(Значение, Язык) Экспорт
	Возврат Формат(Значение, ПечатныеФормы.ЛокализацияФормата(Язык) + "; ЧДЦ=2; ЧН=0");
КонецФункции

// Строки описи пересчёта с себестоимостью: учёт и факт строк документа в базовых единицах, себестоимость без НДС -
// средняя по остаткам всех складов на момент пересчёта (все партии и дополнительные расходы), суммы - количество на
// сумму остатка без промежуточного округления цены (docs/plans/inventory-print.md).
//
// Параметры:
//  Пересчет - ДокументСсылка.ПересчётТоваров - записанный пересчёт.
//
// Возвращаемое значение:
//  ТаблицаЗначений - НомерСтроки, Номенклатура, Характеристика, Серия, Артикул, представления товара, характеристики и
//                    серии, Единица, Цена, Количество, Сумма,
//                    КоличествоФакт, СуммаФакт, РазницаКоличество, РазницаСумма.
//
Функция ДанныеОписи(Пересчет) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Серия КАК Серия,
	|	ЕСТЬNULL(Карточка.Артикул, """") КАК Артикул,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Товары.Номенклатура) КАК ТоварПредставление,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Товары.Характеристика) КАК ХарактеристикаПредставление,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Товары.Серия) КАК СерияПредставление,
	|	ЕСТЬNULL(Карточка.ВыводитьНаПечатьОписание, ЛОЖЬ) КАК ПечататьОписание,
	|	Карточка.Описание КАК ОписаниеПечати,
	|	Карточка.Единица КАК Единица,
	|	Товары.Количество КАК Количество,
	|	Товары.КоличествоФакт КАК КоличествоФакт
	|ИЗ
	|	Документ.ПересчётТоваров.ТЧТовары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Карточка
	|		ПО Карточка.Ссылка = Товары.Номенклатура
	|ГДЕ
	|	Товары.Ссылка = &Пересчет
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки");
	Запрос.УстановитьПараметр("Пересчет", Пересчет);
	Строки = Запрос.Выполнить().Выгрузить();
	Число = Новый ОписаниеТипов("Число");
	Для Каждого Имя Из СтрРазделить("Цена,Сумма,СуммаФакт,РазницаКоличество,РазницаСумма", ",") Цикл
		Строки.Колонки.Добавить(Имя, Число);
	КонецЦикла;
	Остатки = ОстаткиДляСебестоимости(Строки.ВыгрузитьКолонку("Номенклатура"),
		Новый Граница(Пересчет.МоментВремени(), ВидГраницы.Исключая));
	Отбор = Новый Структура("Номенклатура, Характеристика");
	ЗнаковСуммы = 2;
	Для Каждого Строка Из Строки Цикл
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		Найденные = Остатки.НайтиСтроки(Отбор);
		Если Найденные.Количество() > 0 И Найденные[0].Количество > 0 Тогда
			Остаток = Найденные[0];
			Строка.Цена = Окр(Остаток.Сумма / Остаток.Количество, ЗнаковСуммы);
			Строка.Сумма = Окр(Строка.Количество * Остаток.Сумма / Остаток.Количество, ЗнаковСуммы);
			Строка.СуммаФакт = Окр(Строка.КоличествоФакт * Остаток.Сумма / Остаток.Количество, ЗнаковСуммы);
		КонецЕсли;
		Строка.РазницаКоличество = Строка.КоличествоФакт - Строка.Количество;
		Строка.РазницаСумма = Строка.СуммаФакт - Строка.Сумма;
	КонецЦикла;
	Возврат Строки;

КонецФункции

// Учётные остатки места хранения пересчёта на его дату (до документа), с отбором по товарной группе. Форма заполняет
// ими товары и учётное количество строк; тест зовёт ту же функцию (волна 5, P3-4).
//
// Параметры:
//  Пересчет           - ДанныеФормыСтруктура, ДокументОбъект.ПересчётТоваров - пересчёт
//  НаборНоменклатуры  - Массив из СправочникСсылка.Номенклатура, Неопределено - явный набор товаров (строки
//                       выполненного пересчёта, отчёт «Анализ инвентаризаций»): отбор по текущей товарной группе не
//                       ставится; Неопределено - отбор по группе пересчёта, как раньше.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Серия, КоличествоУпаковок, Количество
//
Функция УчетныеОстатки(Пересчет, НаборНоменклатуры = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	Остатки.КоличествоОстаток КАК КоличествоУпаковок,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		Партии.Номенклатура КАК Номенклатура,
	|		Партии.Характеристика КАК Характеристика,
	|		Партии.Серия КАК Серия,
	|		СУММА(Партии.КоличествоОстаток) КАК КоличествоОстаток
	|	ИЗ
	|		РегистрНакопления.ТоварыВНаличии.Остатки(
	|				&ДатаОст,
	|				МестоХранения = &МестоХранения
	|					И &УсловиеГруппы) КАК Партии
	|	СГРУППИРОВАТЬ ПО
	|		Партии.Номенклатура,
	|		Партии.Характеристика,
	|		Партии.Серия) КАК Остатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика,
	|	Серия";
	Если НаборНоменклатуры <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеГруппы", "Номенклатура В (&НаборНоменклатуры)");
		Запрос.УстановитьПараметр("НаборНоменклатуры", НаборНоменклатуры);
	ИначеЕсли ЗначениеЗаполнено(Пересчет.ТоварнаяГруппа) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеГруппы",
			"Номенклатура В (ВЫБРАТЬ Товары.Ссылка ИЗ Справочник.Номенклатура КАК Товары
			|ГДЕ Товары.ТоварнаяГруппа = &ТоварнаяГруппа)");
		Запрос.УстановитьПараметр("ТоварнаяГруппа", Пересчет.ТоварнаяГруппа);
	Иначе
		Запрос.УстановитьПараметр("УсловиеГруппы", Истина);
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаОст", РаботаСДокументамиВызовСервера.ПолучитьГраницуДокумента(Пересчет));
	Запрос.УстановитьПараметр("МестоХранения", Пересчет.МестоХранения);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Учётное количество строк пересчёта - по остаткам его места хранения (см. УчетныеОстатки); строка без остатка
// получает ноль. Фактическое количество не меняется.
//
// Параметры:
//  Пересчет - ДанныеФормыСтруктура, ДокументОбъект.ПересчётТоваров - пересчёт
//
Процедура ЗаполнитьУчетноеКоличество(Пересчет) Экспорт

	Остатки = УчетныеОстатки(Пересчет);
	Для Каждого Стр Из Пересчет.ТЧТовары Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия);
		Найденные = Остатки.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			Стр.КоличествоУпаковок = 0;
			Стр.Количество = 0;
		Иначе
			Стр.КоличествоУпаковок = Найденные[0].КоличествоУпаковок;
			Стр.Количество = Найденные[0].Количество;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит опись или ведомость одного пересчёта.
//
// Параметры:
//  Пересчет          - ДокументСсылка.ПересчётТоваров - печатаемый пересчёт.
//  Таб               - ТабличныйДокумент - результат.
//  ТолькоРасхождения - Булево - сличительная ведомость: только строки с ненулевой разницей количества.
//  БезСумм           - Булево - только количества.
//
Процедура ПечатьОписи(Пересчет, Таб, ТолькоРасхождения, БезСумм)

	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Таб.АвтоМасштаб = Истина;
	Таб.КлючПараметровПечати = "Параметры_печати_Документ_ПересчётТоваров_ИнвентаризационнаяОпись";
	Макет = ПечатныеФормы.МакетПечатнойФормы(ПутьКМакету());
	Язык = ПечатныеФормы.ЯзыкПечати();
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Пересчет, "Организация, МестоХранения, Ответственный, Исполнитель");

	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.ТекстЗаголовка = СтрШаблон("%1 № %2 %3",
		?(ТолькоРасхождения, ПредставлениеВедомости(Язык), ПредставлениеОписи(Язык)),
		РаботаСДокументами.СформироватьЦифровойНомер(Пересчет.Номер),
		Формат(Пересчет.Дата, ПечатныеФормы.ЛокализацияФормата(Язык) + "; ДЛФ=DD"));
	Таб.Вывести(Область);
	Область = Макет.ПолучитьОбласть("Реквизиты");
	Область.Параметры.Организация = Реквизиты.Организация;
	Область.Параметры.МестоХранения = Реквизиты.МестоХранения;
	Область.Параметры.ПояснениеЦены = ?(БезСумм, "", НСтр("ru = 'средняя по остаткам всех складов на дату документа, без НДС';
		|fr = 'moyen du stock de tous les entrepôts à la date du document, HT';
		|en = 'average of the stock of all warehouses at the document date, excl. VAT';
		|es = 'promedio de las existencias de todos los almacenes a la fecha del documento, sin IVA'", Язык));
	Таб.Вывести(Область);

	Строки = ДанныеОписи(Пересчет);
	Если ТолькоРасхождения Тогда
		Выводимые = Новый Массив;
		Для Каждого Строка Из Строки Цикл
			Если Строка.РазницаКоличество <> 0 Тогда
				Выводимые.Добавить(Строка);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Выводимые = Строки;
	КонецЕсли;

	Если ТолькоРасхождения И Выводимые.Количество() = 0 Тогда
		Область = Макет.ПолучитьОбласть("НетРасхождений");
		Область.Параметры.ТекстНетРасхождений = НСтр("ru = 'Расхождений нет'; fr = 'Aucun écart';
			|en = 'No differences'; es = 'Sin diferencias'", Язык);
		Таб.Вывести(Область);
	Иначе
		ВывестиТаблицуОписи(Макет, Таб, Выводимые, БезСумм, Язык);
	КонецЕсли;

	Область = Макет.ПолучитьОбласть("Подписи");
	Область.Параметры.Ответственный = Реквизиты.Ответственный;
	Область.Параметры.Исполнитель = Реквизиты.Исполнитель;
	Таб.Вывести(Область);
	Таб.ВывестиГоризонтальныйРазделительСтраниц();

КонецПроцедуры

// Параметры:
//  Макет    - ТабличныйДокумент - макет описи.
//  Таб      - ТабличныйДокумент - результат.
//  Строки   - ТаблицаЗначений, Массив из СтрокаТаблицыЗначений - см. ДанныеОписи.
//  БезСумм  - Булево - только количества.
//  Язык     - Строка - код языка печати.
//
Процедура ВывестиТаблицуОписи(Макет, Таб, Строки, БезСумм, Язык)

	Суффикс = ?(БезСумм, "БезЦен", "");
	Таб.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы" + Суффикс));
	Область = Макет.ПолучитьОбласть("Строка" + Суффикс);
	Итоги = Новый Структура("Сумма, СуммаФакт, РазницаСумма", 0, 0, 0);
	Номер = 0;
	Для Каждого Строка Из Строки Цикл
		Номер = Номер + 1;
		Значения = Новый Структура;
		Значения.Вставить("НомерСтроки", Номер);
		Значения.Вставить("Артикул", Строка.Артикул);
		Значения.Вставить("Товар", ПредставлениеТовара(Строка, Язык));
		Значения.Вставить("Единица", Строка.Единица);
		Значения.Вставить("Количество", ФорматКоличества(Строка.Количество, Язык));
		Значения.Вставить("КоличествоФакт", ФорматКоличества(Строка.КоличествоФакт, Язык));
		Значения.Вставить("РазницаКоличество", ФорматРазницы(Строка.РазницаКоличество, "ЧДЦ=3", Язык));
		Если Не БезСумм Тогда
			Значения.Вставить("Цена", ФорматСуммы(Строка.Цена, Язык));
			Значения.Вставить("Сумма", ФорматСуммы(Строка.Сумма, Язык));
			Значения.Вставить("СуммаФакт", ФорматСуммы(Строка.СуммаФакт, Язык));
			Значения.Вставить("РазницаСумма", ФорматРазницы(Строка.РазницаСумма, "ЧДЦ=2", Язык));
			Итоги.Сумма = Итоги.Сумма + Строка.Сумма;
			Итоги.СуммаФакт = Итоги.СуммаФакт + Строка.СуммаФакт;
			Итоги.РазницаСумма = Итоги.РазницаСумма + Строка.РазницаСумма;
		КонецЕсли;
		Область.Параметры.Заполнить(Значения);
		Таб.Вывести(Область);
	КонецЦикла;
	Если БезСумм Тогда
		Возврат;
	КонецЕсли;
	Область = Макет.ПолучитьОбласть("Итого");
	Область.Параметры.ПодписьИтога = НСтр("ru = 'Итого'; fr = 'Total'; en = 'Total'; es = 'Total'", Язык);
	Область.Параметры.ИтогСумма = ФорматСуммы(Итоги.Сумма, Язык);
	Область.Параметры.ИтогСуммаФакт = ФорматСуммы(Итоги.СуммаФакт, Язык);
	Область.Параметры.ИтогРазница = ФорматРазницы(Итоги.РазницаСумма, "ЧДЦ=2", Язык);
	Таб.Вывести(Область);

КонецПроцедуры

// Остатки для себестоимости без НДС по всем складам: товары в наличии и дополнительные расходы, все партии.
//
// Параметры:
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - позиции описи.
//  Граница      - Граница - момент среза.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Количество, Сумма (без НДС).
//
Функция ОстаткиДляСебестоимости(Номенклатура, Граница)

	// BSLLS:SetPrivilegedMode-off - себестоимость читается служебно, как средняя цена остатков в карточке товара
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВЗ.Номенклатура КАК Номенклатура,
	|	ВЗ.Характеристика КАК Характеристика,
	|	СУММА(ВЗ.Количество) КАК Количество,
	|	СУММА(ВЗ.Сумма) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		Товары.Номенклатура КАК Номенклатура,
	|		Товары.Характеристика КАК Характеристика,
	|		Товары.КоличествоОстаток КАК Количество,
	|		Товары.СуммаОстаток - Товары.СуммаНДСОстаток КАК Сумма
	|	ИЗ
	|		РегистрНакопления.ТоварыВНаличии.Остатки(&Граница, Номенклатура В (&Номенклатура)) КАК Товары
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Расходы.Номенклатура,
	|		Расходы.Характеристика,
	|		0,
	|		Расходы.СуммаОстаток - Расходы.СуммаНДСОстаток
	|	ИЗ
	|		РегистрНакопления.ДополнительныеРасходы.Остатки(&Граница, Номенклатура В (&Номенклатура)) КАК Расходы) КАК ВЗ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЗ.Номенклатура,
	|	ВЗ.Характеристика");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Граница", Граница);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Количество на языке печати: до трёх знаков, ноль - «0».
//
// Параметры:
//  Значение - Число - количество.
//  Язык     - Строка - код языка печати.
//
// Возвращаемое значение:
//  Строка - представление.
//
Функция ФорматКоличества(Значение, Язык)
	Возврат Формат(Значение, ПечатныеФормы.ЛокализацияФормата(Язык) + "; ЧДЦ=3; ЧН=0");
КонецФункции

// Разница со знаком «+» у излишка: недостача и так печатается с минусом.
//
// Параметры:
//  Значение - Число - разница.
//  Дробные  - Строка - форматная строка дробной части.
//  Язык     - Строка - код языка печати.
//
// Возвращаемое значение:
//  Строка - представление разницы; ноль - пусто.
//
Функция ФорматРазницы(Значение, Дробные, Язык)
	Если Значение = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ?(Значение > 0, "+", "") + Формат(Значение, ПечатныеФормы.ЛокализацияФормата(Язык) + "; " + Дробные);
КонецФункции

