// Товар строки: наименование, характеристика, серия и описание для печати из запроса, без обращения к базе (артикул -
// своей колонкой).
//
// Параметры:
//  Строка - СтрокаТаблицыЗначений - см. ДанныеОписи.
//  Язык   - Строка - код языка печати.
//
// Возвращаемое значение:
//  Строка - представление товара.
//
Функция ПредставлениеТовара(Строка, Язык)
	Результат = СокрЛП(Строка.ТоварПредставление);
	Если ЗначениеЗаполнено(Строка.Характеристика) Тогда
		Результат = Результат + ", " + СокрЛП(Строка.ХарактеристикаПредставление);
	КонецЕсли;
	Если ЗначениеЗаполнено(Строка.Серия) Тогда
		Результат = Результат + НСтр("ru = ', серия - '; fr = ', série - '; en = ', lot - '; es = ', lote - '", Язык)
			+ СокрЛП(Строка.СерияПредставление);
	КонецЕсли;
	// Описание из карточки - по её флагу «Выводить на печать», как в остальных печатных формах.
	Если Строка.ПечататьОписание И ЗначениеЗаполнено(Строка.ОписаниеПечати) Тогда
		Результат = Результат + Символы.ПС + СокрЛП(Строка.ОписаниеПечати);
	КонецЕсли;
	Возврат Результат;
КонецФункции

