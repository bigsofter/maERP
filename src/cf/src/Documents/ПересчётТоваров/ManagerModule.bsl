#Область ПрограммныйИнтерфейс

// Учётные остатки места хранения пересчёта на его дату (до документа), с отбором по товарной группе. Форма заполняет
// ими товары и учётное количество строк; тест зовёт ту же функцию (волна 5, P3-4).
//
// Параметры:
//  Пересчет - ДанныеФормыСтруктура, ДокументОбъект.ПересчётТоваров - пересчёт
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Серия, КоличествоУпаковок, Количество
//
Функция УчетныеОстатки(Пересчет) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	Остатки.КоличествоОстаток КАК КоличествоУпаковок,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			&ДатаОст,
	|			МестоХранения = &МестоХранения
	|				И &УсловиеГруппы) КАК Остатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика,
	|	Серия";
	Если ЗначениеЗаполнено(Пересчет.ТоварнаяГруппа) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеГруппы",
			"Номенклатура В (ВЫБРАТЬ Товары.Ссылка ИЗ Справочник.Номенклатура КАК Товары
			|ГДЕ Товары.ТоварнаяГруппа = &ТоварнаяГруппа)");
		Запрос.УстановитьПараметр("ТоварнаяГруппа", Пересчет.ТоварнаяГруппа);
	Иначе
		Запрос.УстановитьПараметр("УсловиеГруппы", Истина);
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаОст", РаботаСДокументамиВызовСервера.ПолучитьГраницуДокумента(Пересчет));
	Запрос.УстановитьПараметр("МестоХранения", Пересчет.МестоХранения);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Учётное количество строк пересчёта - по остаткам его места хранения (см. УчетныеОстатки); строка без остатка
// получает ноль. Фактическое количество не меняется.
//
// Параметры:
//  Пересчет - ДанныеФормыСтруктура, ДокументОбъект.ПересчётТоваров - пересчёт
//
Процедура ЗаполнитьУчетноеКоличество(Пересчет) Экспорт

	Остатки = УчетныеОстатки(Пересчет);
	Для Каждого Стр Из Пересчет.ТЧТовары Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия);
		Найденные = Остатки.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			Стр.КоличествоУпаковок = 0;
			Стр.Количество = 0;
		Иначе
			Стр.КоличествоУпаковок = Найденные[0].КоличествоУпаковок;
			Стр.Количество = Найденные[0].Количество;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
