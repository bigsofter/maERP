#КонецОбласти

#Область Обработчики_элементов_формы

&НаКлиенте
Процедура МестоХраненияПриИзменении(Элемент)
	УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("МестоХранения", Объект.МестоХранения));
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыУпаковкаПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Элементы.ТЧТовары.ТекущиеДанные);
КонецПроцедуры 

&НаКлиенте
Процедура ТЧТоварыКоличествоУпаковокФактПриИзменении(Элемент)
	ТекСтр = Элементы.ТЧТовары.ТекущиеДанные;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(ТекСтр,,, "Факт");
	ТекСтр.КоличествоУпаковокОтклонение = ТекСтр.КоличествоУпаковокФакт - ТекСтр.КоличествоУпаковок;		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТовары(Команда)
	Если Объект.ТЧТовары.Количество() > 0 Тогда
		Оп = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПерезаполненииТоваров", ЭтотОбъект);
		ПоказатьВопрос(Оп, Нстр("fr = 'La liste des marchandises sera actualisée. Continuer?'; ru = 'Список товаров будет перезаполнен. Продолжить?'; en = 'The list of products will be updated. Continue?'; es = 'La lista de productos se reiniciará. ¿Continuar?'"), РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);	
	Иначе
		ПослеЗакрытияВопросаОПерезаполненииТоваров(КодВозвратаДиалога.Да, Неопределено);	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОстатки(Команда)
	ЗаполнитьОстаткиНаСервере();
	РассчитатьОтклонения();	
КонецПроцедуры
	
&НаКлиенте
Процедура СоздатьОприходованиеСписаниеТоваров(Команда)
	СозданиеПодчинённыхДокументов = Истина;
	РаботаСДокументамиКлиент.ЗаписатьЕслиНовый(ЭтаФорма, Истина);
	МасДокументы = СоздатьОприходованиеСписаниеТоваровНаСервере();
	Для Каждого Док Из МасДокументы Цикл
		ПоказатьЗначение(, Док);	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоЗаданиямНаПересчет(Команда)
	ЗаполнитьПоЗаданиямНаПересчетНаСервере();
	РассчитатьОтклонения();
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

#Область Оповещения

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПерезаполненииТоваров(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда Возврат КонецЕсли;
	ЗаполнитьТоварыНаСервере();
	РассчитатьОтклонения();
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПерезаполненииПодчинённыхДокументов(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда Возврат КонецЕсли;
	МасДокументы = ПерезаполнитьПодчинённыеДокументы(Объект.Ссылка);
	Для Каждого Док Из МасДокументы Цикл
		ПоказатьЗначение(, Док);	
	КонецЦикла;
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ScanData" и ВводДоступен() Тогда 
		Штрихкод = ОперацииСПодключаемымОборудованиемКлиент.ПолучитьШтрихкод(ИмяСобытия, Параметр, Источник);
		СтруктураТОвара = ОбщегоНазначенияВызовСервера.ПолучитьНоменклатуруПоШтрихкоду(Штрихкод);
		Если СтруктураТОвара = Неопределено Тогда
			Оп = Новый ОписаниеОповещения("ПослеДобавленияНоменклатуры",ЭтаФорма,Новый Структура("Штрихкод",Штрихкод));
			ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента",Новый Структура("Штрихкод",Штрихкод),ЭтаФорма,,,,Оп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			РаботаСДокументамиКлиентСервер.ДобавитьНоменклатуруПоШтрихкоду(Штрихкод, Объект, СтруктураТОвара,,,ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Дополнительно

&НаСервере
Процедура ЗаполнитьТоварыНаСервере()
	Объект.ТЧТовары.Загрузить(ПолучитьОстатки());	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	ТЗ = ПолучитьОстатки();
	Для Каждого Стр Из Объект.ТЧТовары Цикл
		Мас = ТЗ.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия));
		Если Мас.Количество() = 0 Тогда
			Стр.КоличествоУпаковок = 0;
			Стр.Количество = 0;
		Иначе
			Стр.КоличествоУпаковок = Мас[0].КоличествоУпаковок;
			Стр.Количество = Мас[0].Количество;	
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция ПолучитьОстатки()
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	                      |	ТоварыВНаличииОстатки.Характеристика КАК Характеристика,
	                      |	ТоварыВНаличииОстатки.Серия КАК Серия,
	                      |	ТоварыВНаличииОстатки.КоличествоОстаток КАК КоличествоУпаковок,
	                      |	ТоварыВНаличииОстатки.КоличествоОстаток КАК Количество
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВНаличии.Остатки(
	                      |			&ДатаОст,
	                      |			МестоХранения = &МестоХранения
	                      |				И (Номенклатура.ТоварнаяГруппа = &ТоварнаяГруппа
	                      |					ИЛИ &ТоварнаяГруппа = ЗНАЧЕНИЕ(Справочник.ТоварныеГруппы.ПустаяСсылка))) КАК ТоварыВНаличииОстатки
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ТоварыВНаличииОстатки.Номенклатура.Наименование,
	                      |	ТоварыВНаличииОстатки.Характеристика.Наименование,
	                      |	Серия");
	Запрос.УстановитьПараметр("ДатаОст", РаботаСДокументамиВызовСервера.ПолучитьГраницуДокумента(Объект));
	Запрос.УстановитьПараметр("МестоХранения", Объект.МестоХранения);
	Запрос.УстановитьПараметр("ТоварнаяГруппа", Объект.ТоварнаяГруппа);
	Возврат Запрос.Выполнить().Выгрузить();		
КонецФункции

&НаКлиенте
Процедура РассчитатьОтклонения()
	Для Каждого Стр Из Объект.ТЧТовары Цикл
		Стр.КоличествоУпаковокОтклонение = Стр.КоличествоУпаковокФакт - Стр.КоличествоУпаковок;	
	КонецЦикла;	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПодчинённыеДокументы(Док)
	Результат = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ОприходованиеТоваров.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.ОприходованиеТоваров КАК ОприходованиеТоваров
	                      |ГДЕ
	                      |	ОприходованиеТоваров.Основание = &Док
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	СписаниеТоваров.Ссылка
	                      |ИЗ
	                      |	Документ.СписаниеТоваров КАК СписаниеТоваров
	                      |ГДЕ
	                      |	СписаниеТоваров.Основание = &Док");
	Запрос.УстановитьПараметр("Док", Док);
	Если ЗначениеЗаполнено(Док) Тогда
		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");	
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПерезаполнитьПодчинённыеДокументы(ДокОснование)
	Результат = Новый Массив;
	МасДокументы = ПолучитьПодчинённыеДокументы(ДокОснование);
	Для Каждого Док Из МасДокументы Цикл
		ДокОбъект = Док.ПолучитьОбъект();
		ДокОбъект.Заполнить(ДокОснование);
	 	ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		Результат.Добавить(ДокОбъект.Ссылка);
	КонецЦикла;
	Возврат Результат;
КонецФункции	

