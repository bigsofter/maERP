			Если ТипЗнч(Док) <> Тип("ДокументСсылка.СписаниеТоваров") Тогда Продолжить КонецЕсли;
			ДокСписание = Док;
			Прервать;
		КонецЦикла;
		Если ЗначениеЗаполнено(ДокСписание) Тогда
			ДокСписание = ДокСписание.ПолучитьОбъект();
			ДокСписание.Заполнить(Объект.Ссылка);	
		Иначе	
			ДокСписание = Документы.СписаниеТоваров.СоздатьДокумент();
			ДокСписание.Заполнить(Объект.Ссылка);
			ДокСписание.Дата = ТекущаяДатаСеанса();
			ДокСписание.УстановитьНовыйНомер();
		КонецЕсли;
		ЗаписатьПодчиненныйДокумент(ДокСписание, Результат);
	//КонецЕсли;
	Возврат Результат
КонецФункции

&НаСервере
Процедура ЗаполнитьПоЗаданиямНаПересчетНаСервере()
	Для Каждого Стр из Объект.ТЧТовары Цикл
		Стр.КоличествоУпаковокФакт = 0;
		Стр.КоличествоФакт = 0;
	КонецЦикла;
	ТЗ = ПолучитьОстаткиПоЗаданиям();
	Для Каждого Стр Из ТЗ Цикл
		Мас = Объект.ТЧТовары.НайтиСтроки(Новый Структура("Номенклатура", Стр.Номенклатура));
		Если Мас.Количество() = 0 Тогда
			НС = Объект.ТЧТовары.Добавить();
			НС.Номенклатура = Стр.Номенклатура;
			НС.КоличествоУпаковокФакт = Стр.Количество;
			НС.КоличествоФакт = Стр.Количество;
		Иначе
			Мас[0].КоличествоУпаковокФакт = Стр.Количество;
			Мас[0].КоличествоФакт = Стр.Количество;	
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция ПолучитьОстаткиПоЗаданиям()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданиеНаПересчетТЧТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ЗаданиеНаПересчетТЧТовары.Количество) КАК Количество
	|ИЗ
	|	Документ.ЗаданиеНаПересчет.ТЧТовары КАК ЗаданиеНаПересчетТЧТовары
	|ГДЕ
	|	ЗаданиеНаПересчетТЧТовары.Ссылка.ПересчетТовара = &ПересчетТовара
	|	И НЕ ЗаданиеНаПересчетТЧТовары.Ссылка.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданиеНаПересчетТЧТовары.Номенклатура";
	Запрос.УстановитьПараметр("ПересчетТовара",Объект.Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

&НаКлиенте
Процедура Подключаемый_ВыполнитьОбщуюКоманду(Команда)
	КомандыТабличныхЧастейКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") И ВыбранноеЗначение.Свойство("Количество") Тогда
		РаботаСДокументамиКлиентСервер.ДобавитьНоменклатуруПоПодбору(Объект, ВыбранноеЗначение, , Неопределено, ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Вид операции «По станку» (волна 5): вместо склада - станок, место хранения - склад станка.

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	ВидОперацииПриИзмененииНаСервере();
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыСкладскихОпераций.Станок") Тогда
		ПересчитатьСтрокиПоМестуХранения();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтанокПриИзменении(Элемент)
	СтанокПриИзмененииНаСервере();
	ПересчитатьСтрокиПоМестуХранения();
КонецПроцедуры

// Смена склада или станка при заполненных строках: учётное количество прежнего места хранения и введённый для него
// факт не годятся - иначе оприходование и списание по пересчёту возьмут чужие отклонения (ревью техдолга Codex, T25).
// Учётное перечитывается по новому месту хранения, факт обнуляется.
&НаКлиенте
Процедура ПересчитатьСтрокиПоМестуХранения()
	Если Объект.ТЧТовары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьОстаткиНаСервере();
	Для Каждого Стр Из Объект.ТЧТовары Цикл
		Стр.КоличествоУпаковокФакт = 0;
		Стр.КоличествоФакт = 0;
	КонецЦикла;
	РассчитатьОтклонения();
	ПоказатьПредупреждение(, НСтр("ru = 'Место хранения изменилось: учётные остатки перечитаны, фактическое количество очищено';
		|fr = 'Le lieu de stockage a changé : le stock théorique est relu, la quantité réelle est effacée';
		|en = 'The storage location changed: book stock was reread, the actual quantity was cleared';
		|es = 'El lugar de almacenamiento cambió: se releyó el stock contable y se borró la cantidad real'"));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СтанокПриИзмененииНаСервере()
	Объект.МестоХранения = ЗагрузкаСтанков.СкладСтанка(Объект.Станок);
	УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("МестоХранения", Объект.МестоХранения));
КонецПроцедуры

// Смена вида операции. «По станку» - склад станка (склад пользователя по умолчанию дал бы чужие остатки, ревью кода
// волны 5, P2-1); «По складу» - станок и его склад очищаются, склад выбирают заново (волна 5, P3). Заголовок и поля -
// по виду.
&НаСервере
Процедура ВидОперацииПриИзмененииНаСервере()
	Если Объект.ВидОперации = Перечисления.ВидыСкладскихОпераций.Станок Тогда
		СтанокПриИзмененииНаСервере();
	Иначе
		Если ЗначениеЗаполнено(Объект.Станок) Тогда
			Объект.Станок = Справочники.ПроизводственноеОборудование.ПустаяСсылка();
			Объект.МестоХранения = Справочники.МестаХранения.ПустаяСсылка();
			УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("МестоХранения", Объект.МестоХранения));
		КонецЕсли;
	КонецЕсли;
	НастроитьПолеСклада(ЭтотОбъект);
	РаботаСДокументами.УстановитьЗаголовокФормыДокумента(ЭтотОбъект, Объект, ЗагрузкаСтанков.ЗаголовокДокументаПоСтанку(Объект));
КонецПроцедуры

// Видимость полей склада и станка по виду операции.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа
//
&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьПолеСклада(Форма)
	ПоСтанку = Форма.Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыСкладскихОпераций.Станок");
	Форма.Элементы.Станок.Видимость = ПоСтанку;
	Форма.Элементы.МестоХранения.Видимость = Не ПоСтанку;
КонецПроцедуры

#КонецОбласти
