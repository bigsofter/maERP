#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если ДополнительныеСвойства.Свойство(Документы.УдержаниеНДСПокупателем.ИмяСвойстваИзНакладной()) Тогда
		ЗапомнитьПрежнееРаспределение(РежимЗаписи);
		Возврат;
	КонецЕсли;
	// Пользователь меняет только справку об удержании и комментарий; остальное - налоговая накладная.
	Текст = ТекстЗапретаЗаписи(РежимЗаписи);
	Если ЗначениеЗаполнено(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , , , Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// BSLLS:SetPrivilegedMode-off - документ проводится кодом накладной (postInPrivilegedMode)
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	Для Каждого НаборЗаписей Из Движения Цикл
		НаборЗаписей.Очистить();
	КонецЦикла;
	// Расчёты контрагента накладной и контрагентов её оснований - уже удержаны проведением накладной.
	Блокировка = Новый БлокировкаДанных;
	Контрагенты = НалоговыеРасчетыПроверки.КонтрагентыБлокировки(ЭтотОбъект);
	// BSLLS:YoLetterUsage-off
	УправляемыеБлокировки.ВзаиморасчётыСПокупателямиКонтрагентов(Блокировка, Контрагенты);
	// BSLLS:YoLetterUsage-on
	Блокировка.Заблокировать();
	ЗаписатьНалоговоеУдержание();
	ЗаписатьОбычноеУдержание();
	Движения.Записать();
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Не ДополнительныеСвойства.Свойство(Документы.УдержаниеНДСПокупателем.ИмяСвойстваИзНакладной()) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстТолькоИзНакладной(), , , , Отказ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Текст отказа пользовательской записи: новый документ, проведение или отмена, изменение реквизитов накладной.
//
// Параметры:
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//
// Возвращаемое значение:
//  Строка - пустая, если запись разрешена.
//
Функция ТекстЗапретаЗаписи(РежимЗаписи) Экспорт
	Если ЭтоНовый() Или РежимЗаписи <> РежимЗаписиДокумента.Запись Тогда
		Возврат ТекстТолькоИзНакладной();
	КонецЕсли;
	Прежний = Ссылка.ПолучитьОбъект();
	Неизменяемые = "Дата,Основание,Организация,Контрагент,Договор,Сумма,РасчетыОтсечены,ОтпечатокОснований,ПометкаУдаления,Проведен";
	Для Каждого Имя Из СтрРазделить(Неизменяемые, ",") Цикл
		Если ЭтотОбъект[Имя] <> Прежний[Имя] Тогда
			Возврат ТекстТолькоИзНакладной();
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ТекстТолькоИзНакладной()
	Возврат НСтр("ru = 'Удержание НДС создаётся, проводится и меняется налоговой накладной: в документе можно изменить только
		|справку об удержании и комментарий.';
		|fr = 'La retenue de TVA est créée, validée et modifiée par la facture fiscale : dans le document, seuls
		|l''attestation de retenue et le commentaire sont modifiables.';
		|en = 'The VAT withholding is created, posted and changed by the tax invoice: only the withholding certificate
		|and the comment can be changed in the document.';
		|es = 'La retención del IVA la crea, contabiliza y modifica la factura fiscal: en el documento solo se pueden
		|cambiar el certificado de retención y el comentario.'");
КонецФункции

// Прежнее распределение удержания в обычном регистре и прежняя сумма - до удаления движений перепроведением: прирост
// разносится по доступному долгу, уменьшение сторнирует прежнее распределение с конца (Ф2, круг 9 ревью плана).
//
// Параметры:
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//
Процедура ЗапомнитьПрежнееРаспределение(РежимЗаписи)
	Прежнее = Неопределено;
	ПрежняяСумма = 0;
	Полное = ДополнительныеСвойства.Свойство("ПолноеПерераспределение") И ДополнительныеСвойства.ПолноеПерераспределение;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И Не ЭтоНовый() И Не Полное Тогда
		Если Ссылка.Проведен Тогда
			ПрежняяСумма = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Сумма");
			// BSLLS:YoLetterUsage-off
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	Т.ОбъектРасчётов КАК ОбъектРасчётов,
			                      |	Т.Организация КАК Организация,
			                      |	Т.Контрагент КАК Контрагент,
			                      |	Т.Договор КАК Договор,
			                      |	Т.Валюта КАК Валюта,
			                      |	Т.Сумма КАК Сумма
			                      |ИЗ
			                      |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
			                      |ГДЕ
			                      |	Т.Регистратор = &Ссылка
			                      |
			                      |УПОРЯДОЧИТЬ ПО
			                      |	Т.НомерСтроки");
			// BSLLS:YoLetterUsage-on
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Прежнее = Запрос.Выполнить().Выгрузить();
		КонецЕсли;
	КонецЕсли;
	ДополнительныеСвойства.Вставить("ПрежнееРаспределение", Прежнее);
	ДополнительныеСвойства.Вставить("ПрежняяСумма", ПрежняяСумма);
КонецПроцедуры

Процедура ЗаписатьНалоговоеУдержание()
	Если Сумма = 0 Тогда
		Возврат;
	КонецЕсли;
	// BSLLS:YoLetterUsage-off
	НС = Движения.ВзаиморасчётыСПокупателямиНалоговый.Добавить();
	НС.ОбъектРасчётов = Ссылка;
	// BSLLS:YoLetterUsage-on
	НС.ВидДвижения = ВидДвиженияНакопления.Расход;
	НС.Период = Дата;
	НС.Организация = Организация;
	НС.Контрагент = Контрагент;
	НС.ВидОперации = Перечисления.ВидыОперацийНалоговые.УдержаниеНДС;
	НС.Описание = "" + НС.ВидОперации + " " + Основание.Номер;
	НС.ДокументДвижения = Ссылка;
	НС.Сумма = Сумма;
КонецПроцедуры

// Обычный регистр: удержание гасит долг реализаций накладной тем же правилом, что строка оплаты по накладной, но
// только в пределах долга - остаток авансом не становится: денег покупатель не платил.
//
Процедура ЗаписатьОбычноеУдержание()
	Прежнее = Неопределено;
	ДополнительныеСвойства.Свойство("ПрежнееРаспределение", Прежнее);
	ПрежняяСумма = 0;
	ДополнительныеСвойства.Свойство("ПрежняяСумма", ПрежняяСумма);
	// BSLLS:YoLetterUsage-off
	МенеджерРасчетов = РегистрыНакопления.ВзаиморасчётыСПокупателями;
	// BSLLS:YoLetterUsage-on
	МенеджерРасчетов.НачатьРазнесениеПоДолгуНакладных(ЭтотОбъект);
	Строки = Новый ТаблицаЗначений;
	Если ТипЗнч(Прежнее) = Тип("ТаблицаЗначений") Тогда
		Строки = Прежнее.Скопировать();
	КонецЕсли;
	Если Сумма >= ПрежняяСумма Тогда
		Если Строки.Количество() > 0 Тогда
			МенеджерРасчетов.ЗанятьДолгНакладной(ЭтотОбъект, Основание, Строки);
		КонецЕсли;
		Разнесение = МенеджерРасчетов.РазнестиПоДолгуНакладной(ЭтотОбъект, Основание, Сумма - ПрежняяСумма);
		Если Строки.Колонки.Количество() = 0 Тогда
			Строки = Разнесение.Строки;
		Иначе
			Для Каждого Строка Из Разнесение.Строки Цикл
				ЗаполнитьЗначенияСвойств(Строки.Добавить(), Строка);
			КонецЦикла;
		КонецЕсли;
	Иначе
		СнятьСКонца(Строки, ПрежняяСумма - Сумма);
	КонецЕсли;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		// BSLLS:YoLetterUsage-off
		НС = Движения.ВзаиморасчётыСПокупателями.Добавить();
		НС.ОбъектРасчётов = Строка.ОбъектРасчётов;
		// BSLLS:YoLetterUsage-on
		НС.ВидДвижения = ВидДвиженияНакопления.Расход;
		НС.Период = Дата;
		НС.Организация = Строка.Организация;
		НС.Контрагент = Строка.Контрагент;
		НС.Договор = Строка.Договор;
		// Валюта измерения гасимого остатка (РазнестиПоДолгуНакладной).
		НС.Валюта = Строка.Валюта;
		НС.Сумма = Строка.Сумма;
	КонецЦикла;
КонецПроцедуры

// Уменьшение удержания: прежнее распределение сторнируется в обратном порядке объектов, без ограничения долгом.
//
// Параметры:
//  Строки - ТаблицаЗначений - прежнее распределение (Сумма).
//  Снять  - Число - на сколько уменьшить.
//
Процедура СнятьСКонца(Строки, Снять)
	Остаток = Снять;
	Индекс = Строки.Количество() - 1;
	Пока Индекс >= 0 И Остаток > 0 Цикл
		Часть = Мин(Остаток, Строки[Индекс].Сумма);
		Строки[Индекс].Сумма = Строки[Индекс].Сумма - Часть;
		Остаток = Остаток - Часть;
		Индекс = Индекс - 1;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
