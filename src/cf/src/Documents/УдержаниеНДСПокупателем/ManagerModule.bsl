#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Удержание НДС покупателем (RAS TVA, Ф2 docs/plans/commerce-two-orgs.md): неденежная оплата налоговой накладной.
// Документ создаётся, проводится, распроводится, помечается и удаляется только налоговой накладной; пользователь
// меняет лишь номер и дату справки об удержании и комментарий.

#Область ПрограммныйИнтерфейс

// Создаёт, обновляет и проводит документ удержания по проведённой накладной или снимает его, если удержания нет.
// Вызывается из проведения накладной после записи её движений, в её транзакции и привилегированном режиме.
// Документ не перепроводится, если сумма, организация, контрагент, договор, дата, отсечка расчётов датой начала учёта
// и состав оснований не изменились:
// распределение удержания по долгу фиксируется при его проведении.
//
// Параметры:
//  Накладная - ДокументОбъект.НалоговаяНакладная - проводимая накладная.
//  Отказ     - Булево, Неопределено - отказ проведения накладной: удержание больше её налогового долга без удержания
//              (ревью 2.0.17.24, круг 6); Неопределено - без проверки (историческая накладная пишется как есть).
//
Процедура ОбновитьПоНакладной(Накладная, Отказ = Неопределено) Экспорт
	// BSLLS:SetPrivilegedMode-off - документ удержания пишет только код накладной
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Найденные = ДокументыНакладной(Накладная.Ссылка);
	ПроверитьЕдинственность(Накладная.Ссылка, Найденные);
	Нужен = Накладная.УдержаниеНДС И Накладная.СуммаУдержанияНДС > 0;
	Если Не Нужен Тогда
		Если Найденные.Количество() > 0 Тогда
			СнятьДокумент(Найденные[0].ПолучитьОбъект(), Истина);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Документ = ?(Найденные.Количество() = 0, Документы.УдержаниеНДСПокупателем.СоздатьДокумент(),
		Найденные[0].ПолучитьОбъект());
	Шапка = ШапкаУдержания(Накладная);
	Полное = ПолноеПерераспределение(Документ, Шапка);
	Если Не Полное И Не ШапкаИзменена(Документ, Шапка) Тогда
		Возврат;
	КонецЕсли;
	// Удержание не больше налогового долга накладной без удержания (ревью 2.0.17.24, круг 6).
	ПрежняяСумма = ?(Документ.ЭтоНовый() Или Не Документ.Проведен, 0, Документ.Сумма);
	Если ТипЗнч(Отказ) = Тип("Булево") И Шапка.Сумма > ПрежняяСумма И Не УдержаниеВПределахДолга(Накладная, Шапка.Сумма) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Документ, Шапка);
	Документ.ПометкаУдаления = Ложь;
	Документ.ДополнительныеСвойства.Вставить(ИмяСвойстваИзНакладной(), Истина);
	Документ.ДополнительныеСвойства.Вставить("ПолноеПерераспределение", Полное);
	ИмяКонтрагентов = НалоговыеРасчетыПроверки.ИмяСвойстваКонтрагентовБлокировки();
	Контрагенты = Неопределено;
	Если Накладная.ДополнительныеСвойства.Свойство(ИмяКонтрагентов, Контрагенты) Тогда
		Документ.ДополнительныеСвойства.Вставить(ИмяКонтрагентов, Контрагенты);
	КонецЕсли;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

// Отмена проведения документа удержания вместе с накладной; с пометкой - помечается и он.
//
// Параметры:
//  Накладная - ДокументОбъект.НалоговаяНакладная - накладная.
//  Пометка   - Булево - пометить документ удержания на удаление.
//
Процедура ОтменитьПоНакладной(Накладная, Пометка = Ложь) Экспорт
	// BSLLS:SetPrivilegedMode-off - документ удержания пишет только код накладной
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Для Каждого Ссылка Из ДокументыНакладной(Накладная.Ссылка) Цикл
		СнятьДокумент(Ссылка.ПолучитьОбъект(), Пометка);
	КонецЦикла;
КонецПроцедуры

// Удаляет документы удержания накладной - перед её удалением.
//
// Параметры:
//  Накладная - ДокументСсылка.НалоговаяНакладная - удаляемая накладная.
//
Процедура УдалитьПоНакладной(Накладная) Экспорт
	// BSLLS:SetPrivilegedMode-off - документ удержания удаляет только код накладной
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Для Каждого Ссылка Из ДокументыНакладной(Накладная) Цикл
		Документ = Ссылка.ПолучитьОбъект();
		Документ.ДополнительныеСвойства.Вставить(ИмяСвойстваИзНакладной(), Истина);
		Документ.Удалить();
	КонецЦикла;
КонецПроцедуры

// Документы удержания накладной, включая помеченные на удаление.
//
// Параметры:
//  Накладная - ДокументСсылка.НалоговаяНакладная - накладная.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.УдержаниеНДСПокупателем
//
Функция ДокументыНакладной(Накладная) Экспорт
	// BSLLS:SetPrivilegedMode-off - документы удержания читаются при записи накладной и платежей
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Д.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.УдержаниеНДСПокупателем КАК Д
	                      |ГДЕ
	                      |	Д.Основание = &Накладная
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Д.Ссылка");
	Запрос.УстановитьПараметр("Накладная", Накладная);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

// Имя признака в ДополнительныеСвойства: запись документа удержания идёт из кода накладной.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСвойстваИзНакладной() Экспорт
	Возврат "ИзНакладной";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Реквизиты документа удержания по накладной.
//
// Параметры:
//  Накладная - ДокументОбъект.НалоговаяНакладная - накладная.
//
// Возвращаемое значение:
//  Структура - Дата, Основание, Организация, Контрагент, Договор, РасчетыОтсечены, Сумма, ОтпечатокОснований.
//
Функция ШапкаУдержания(Накладная)
	Курс = РаботаСВалютами.ВалютаИКурсДокумента(Накладная).Курс;
	Шапка = Новый Структура;
	Шапка.Вставить("Дата", Накладная.Дата);
	Шапка.Вставить("Основание", Накладная.Ссылка);
	Шапка.Вставить("Организация", Накладная.Организация);
	Шапка.Вставить("Контрагент", Накладная.Контрагент);
	Шапка.Вставить("Договор", Накладная.Договор);
	// Отсечка датой начала учёта взаиморасчётов - запоминается при проведении: её смена перераспределяет удержание.
	Шапка.Вставить("РасчетыОтсечены", Не ОтсечкаВзаиморасчетов.РасчетыПереносятсяОбъекта(Накладная, "ОтгрузкаТовара"));
	Шапка.Вставить("Сумма", РаботаСВалютамиКлиентСервер.СуммаРегл(Накладная.СуммаУдержанияНДС, Курс));
	// Основания и покрытые суммы - против снимка последнего проведения удержания, а не против записанной версии
	// накладной: запись накладной без проведения не теряет перераспределения (ревью 2.0.17.24, круг 6).
	Шапка.Вставить("ОтпечатокОснований", ОтпечатокОснований(Накладная));
	Возврат Шапка;
КонецФункции

// Нужно ли разнести удержание заново, а не от прежнего распределения: новый документ, другие основания или покрытые
// суммы, аналитики долга (прежнее распределение под старыми организацией, контрагентом, договором), отсечка датой
// начала учёта взаиморасчётов.
//
// Параметры:
//  Документ - ДокументОбъект.УдержаниеНДСПокупателем - документ удержания.
//  Шапка    - Структура - см. ШапкаУдержания.
//
// Возвращаемое значение:
//  Булево
//
Функция ПолноеПерераспределение(Документ, Шапка)
	Если Документ.ЭтоНовый() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Документ.ОтпечатокОснований <> Шапка.ОтпечатокОснований Или АналитикиДолгаИзменены(Документ, Шапка)
		Или Документ.РасчетыОтсечены <> Шапка.РасчетыОтсечены;
КонецФункции

// Изменились ли проведение, пометка или реквизиты документа удержания относительно шапки по накладной.
//
// Параметры:
//  Документ - ДокументОбъект.УдержаниеНДСПокупателем - документ удержания.
//  Шапка    - Структура - см. ШапкаУдержания.
//
// Возвращаемое значение:
//  Булево
//
Функция ШапкаИзменена(Документ, Шапка)
	Если Не Документ.Проведен Или Документ.ПометкаУдаления Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Шапка Цикл
		Если Документ[КлючИЗначение.Ключ] <> КлючИЗначение.Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Отпечаток оснований накладной: основание и покрытая сумма каждой строки, по порядку оснований.
//
// Параметры:
//  Накладная - ДокументОбъект.НалоговаяНакладная - накладная.
//
// Возвращаемое значение:
//  Строка
//
Функция ОтпечатокОснований(Накладная)
	Основания = РаботаСДокументами.ОснованияНалоговойНакладной(Накладная, "ОтгрузкаТовара");
	Части = Новый СписокЗначений;
	Для Каждого СтрокаОснования Из Основания Цикл
		Идентификатор = СтрокаОснования.Основание.УникальныйИдентификатор();
		Части.Добавить(Строка(Идентификатор) + "=" + Формат(СтрокаОснования.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
	КонецЦикла;
	Части.СортироватьПоЗначению();
	Возврат СтрСоединить(Части.ВыгрузитьЗначения(), ";");
КонецФункции

// Удержание не больше налогового долга накладной без самого удержания (долг минус снимок оплат), иначе сообщение:
// рост удержания после оплаты сделал бы неизменный платёж непроводимым по налоговому лимиту.
//
// Параметры:
//  Накладная - ДокументОбъект.НалоговаяНакладная - проводимая накладная (её налоговые движения уже записаны).
//  Сумма     - Число - новая сумма удержания в основной валюте.
//
// Возвращаемое значение:
//  Булево
//
Функция УдержаниеВПределахДолга(Накладная, Сумма)
	// BSLLS:YoLetterUsage-off
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЕСТЬNULL(СУММА(ВЫБОР
	                      |				КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	                      |					ТОГДА Т.Сумма
	                      |				ИНАЧЕ -Т.Сумма
	                      |			КОНЕЦ), 0) КАК Долг
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	                      |ГДЕ
	                      |	Т.Регистратор = &Накладная");
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Накладная", Накладная.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Долг = ?(Выборка.Следующий(), Выборка.Долг, 0);
	Допуск = 0.005;
	Если Сумма <= Долг + Допуск Тогда
		Возврат Истина;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Удержание НДС %1 больше налогового долга накладной %2 без удержания: сначала уменьшите оплату накладной.';
		|fr = 'La retenue de TVA %1 dépasse la dette fiscale de la facture %2 hors retenue : réduisez d''abord le paiement
		|de la facture.';
		|en = 'The VAT withholding %1 exceeds the invoice tax debt %2 without withholding: reduce the invoice payment first.';
		|es = 'La retención del IVA %1 supera la deuda fiscal de la factura %2 sin retención: reduzca primero el pago de
		|la factura.'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Формат(Сумма, "ЧДЦ=2"), Формат(Долг, "ЧДЦ=2; ЧН=0")));
	Возврат Ложь;
КонецФункции

// Сменились ли у проведённого документа аналитики долга накладной: прежнее распределение лежит под старыми
// организацией, контрагентом или договором.
//
// Параметры:
//  Документ - ДокументОбъект.УдержаниеНДСПокупателем - документ удержания.
//  Шапка    - Структура - новые реквизиты из накладной.
//
// Возвращаемое значение:
//  Булево
//
Функция АналитикиДолгаИзменены(Документ, Шапка)
	Если Документ.ЭтоНовый() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("Организация,Контрагент,Договор", ",") Цикл
		Если Документ[Имя] <> Шапка[Имя] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ПроверитьЕдинственность(Накладная, Найденные)
	Если Найденные.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;
	Представления = Новый Массив;
	Для Каждого Ссылка Из Найденные Цикл
		Представления.Добавить(Строка(Ссылка));
	КонецЦикла;
	Шаблон = НСтр("ru = 'У налоговой накладной %1 больше одного документа удержания НДС: %2. Оставьте один.';
		|fr = 'La facture fiscale %1 a plus d''un document de retenue de TVA : %2. Gardez-en un seul.';
		|en = 'Tax invoice %1 has more than one VAT withholding document: %2. Keep only one.';
		|es = 'La factura fiscal %1 tiene más de un documento de retención del IVA: %2. Deje solo uno.'");
	ВызватьИсключение СтрШаблон(Шаблон, Накладная, СтрСоединить(Представления, "; "));
КонецПроцедуры

Процедура СнятьДокумент(Документ, Пометка)
	Если Не Документ.Проведен И (Документ.ПометкаУдаления Или Не Пометка) Тогда
		Возврат;
	КонецЕсли;
	Документ.ДополнительныеСвойства.Вставить(ИмяСвойстваИзНакладной(), Истина);
	Если Пометка Тогда
		Документ.ПометкаУдаления = Истина;
	КонецЕсли;
	Документ.Записать(?(Документ.Проведен, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Запись));
КонецПроцедуры

#КонецОбласти

#КонецЕсли
