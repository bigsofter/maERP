
#Область ОписаниеПеременных

// Номенклатура строки товаров в начале редактирования: материалы очищаются при окончании
// редактирования, если номенклатура сменилась и редактирование не отменили.
&НаКлиенте
Перем НоменклатураДоРедактирования;

// Редактирование строки товаров отменили: количество вернулось, материалы пересчитываются отложенно.
&НаКлиенте
Перем ПересчитатьПослеОтмены;

#КонецОбласти

#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РаботаСДокументами.МожноРедактироватьДокументВФорме(Объект.Ссылка, ЭтаФорма);
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументамиКлиентСервер.УстановитьПараметрыФункциональныхОпций(ЭтаФорма);
	ДСОбсуждение.Параметры.УстановитьЗначениеПараметра("Владелец", Объект.Ссылка);
	УстановитьВидЦеныПоДоговору();	
	УстановитьЗаголовок(Объект);
	ЕстьПравоЗаверениеЦен = РегистрыСведений.НастройкиПользователей.ЗаверениеЦен(); 
	Элементы.ДекорацияСтатусаЗаказа.Заголовок = Строка(РаботаСДокументамиВызовСервера.ПолучитьСтатусЗаказПокупателя(Объект.Ссылка));  
	Элементы.МенеджерПодтвердилПроверилОстаток.Доступность = НЕ объект.МенеджерПодтвердилПроверилОстаток;
	НастроитьФорму(); 
	ЗаполнитьСуммыОплатыДолга();
	ЗаполнитьОстаткиНаСервере();
	Если ЕстьПравоЗаверениеЦен Тогда
		ЗаполнитьПоследниеЦены();
	КонецЕсли;
	КомандыТабличныхЧастейВызовСервера.ПодключитьКоманду(ЭтотОбъект, "Подменю", Элементы.ТЧТовары.КоманднаяПанель);
	Если Не ТолькоПросмотр Тогда
		КомандыТабличныхЧастейВызовСервера.ПодключитьКоманду(ЭтотОбъект, "Подбор", Элементы.ТЧТовары.КоманднаяПанель);
	КонецЕсли;
	ЗаполнитьДанныеТендера();
	РаботаСДокументами.ОграничитьВидимостьРеквизитовПоТипу(ЭтотОбъект, "ОператорПроизводства");
	НастроитьМатериалы();
	НастроитьПроведение(Объект.Проведен);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОперацииСПодключаемымОборудованиемКлиент.ПодключитьОборудование(УникальныйИдентификатор, Истина);
	ПрименитьОтборМатериалов();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.ДополнительныеСвойства.Вставить(РаботаСДокументами.СвойствоЗаписьИзФормы(), Истина);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)	
	УстановитьЗаголовок(ТекущийОбъект);
	ЗаполнитьОстаткиНаСервере();
	НастроитьМатериалы();
	// Данные формы к этому моменту старые: проведённость - по записанному объекту.
	НастроитьПроведение(ТекущийОбъект.Проведен);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	// Запись могла переномеровать коды строк товаров и очистить материалы.
	ПрименитьОтборМатериалов();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
