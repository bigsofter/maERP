	Возврат Справочники.Пользователи.ПолучитьПоСотруднику(Объект.Менеджер);	
КонецФункции	

&НаСервере
Процедура УстановитьВидЦеныПоДоговору()
	//ВидЦены = ?(ЗначениеЗаполнено(Объект.Договор.ВидЦены),Объект.Договор.ВидЦены, Справочники.ВидыЦен.Розничная);
	ВидЦены = ?(ЗначениеЗаполнено(Объект.Контрагент.ТипЦены),Объект.Контрагент.ТипЦены, Справочники.ВидыЦен.Розничная);
	РаботаСДокументамиКлиентСервер.ЗаполнитьСписокВыбораВидовЦен(ВидЦены, Элементы.ТЧТоварыВидЦены);
	Объект.ЦенаВключаетНДС = ОбщегоНазначенияВызовСервера.ЦенаВключаетНДСПоВидуЦен(ВидЦены);
КонецПроцедуры

// Заголовок формы: заказ на производство называется по виду операции, продажа - синонимом документа.
//
// Параметры:
//  ДанныеОбъекта - ДанныеФормыСтруктура, ДокументОбъект.ЗаказПокупателя - после записи передаётся
//                  записанный объект: номер и ссылка в данных формы к этому моменту ещё старые
//
&НаСервере
Процедура УстановитьЗаголовок(ДанныеОбъекта)
	ЗаголовокФормы = "";
	Если ДанныеОбъекта.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство Тогда
		ЗаголовокФормы = НСтр("ru = 'Заказ клиента на производство'; fr = 'Commande client en production';
			|en = 'Customer production order'; es = 'Pedido de cliente para producción'");
	КонецЕсли;
	РаботаСДокументами.УстановитьЗаголовокФормыДокумента(ЭтаФорма, ДанныеОбъекта, ЗаголовокФормы);
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	Элементы.ТЧТоварыГруппаПоследниеЦены.Видимость = ЕстьПравоЗаверениеЦен;
	Элементы.ТЧТоварыВидЦены.ТолькоПросмотр = Не ЕстьПравоЗаверениеЦен;
	Элементы.ТЧТоварыЦена.ТолькоПросмотр = Не ЕстьПравоЗаверениеЦен;
	Элементы.ТЧТоварыСумма.ТолькоПросмотр = Не ЕстьПравоЗаверениеЦен;
	Элементы.ТЧТоварыПроцентСкидки.ТолькоПросмотр = Не ЕстьПравоЗаверениеЦен;
	Элементы.ТЧТоварыСуммаСкидки.ТолькоПросмотр = Не ЕстьПравоЗаверениеЦен;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПоследниеЦены(Знач Строка = Неопределено)
	РаботаСДокументами.ЗаполнитьПоследниеЦены(Объект, Строка);
	Возврат Строка;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоследниеЦеныСтроки(ТекСтр)
	СтрСтруктура = РаботаСДокументамиКлиентСервер.ПреобразоватьСтрокуТаблицыВСтруктуру(ТекСтр, Объект);
	СтрСтруктура = ЗаполнитьПоследниеЦены(СтрСтруктура);
	ЗаполнитьЗначенияСвойств(ТекСтр, СтрСтруктура, "ЦенаЗакупкиПоследняя, ЦенаПродажиПоследняя, ПроцентНаценкиНаЦену");
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыПроцентНаценкиНаЦенуПриИзменении(Элемент)
	ТекСтр = Элементы.ТЧТовары.ТекущиеДанные;
	ТекСтр.Цена = ТекСтр.ЦенаЗакупкиПоследняя
		* (1 + ТекСтр.ПроцентНаценкиНаЦену / РаботаСДокументамиКлиентСервер.СтоПроцентов());
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(ТекСтр, Объект.ЦенаВключаетНДС, "Цена");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСуммыОплатыДолга()    
	
		СуммаДолга = "0,00";        
		СуммаОплаты  = "0,00"; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВзаиморасчётыСПокупателями.ОбъектРасчётов КАК ОбъектРасчётов,
	|	ВзаиморасчётыСПокупателями.Сумма КАК Сумма
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК ВзаиморасчётыСПокупателями
	|ГДЕ
	|	ВзаиморасчётыСПокупателями.ОбъектРасчётов.Основание = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",объект.Ссылка);  
	
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Если Выборка.Количество() = 0 Тогда иначе

		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВзаиморасчётыСПокупателямиОстатки.ОбъектРасчётов КАК ОбъектРасчётов,
		               |	ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток КАК Сумма
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, ОбъектРасчётов.Основание = &Ссылка) КАК ВзаиморасчётыСПокупателямиОстатки";
		Запрос.УстановитьПараметр("Ссылка",объект.Ссылка);  
	
		Выборка = Запрос.Выполнить().Выгрузить();
	
		СуммаДолга = Строка(Выборка.Итог("Сумма"));        
		СуммаОплаты  = Строка(объект.Сумма - Выборка.Итог("Сумма")); 
	КонецЕсли; 
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	// У заказа нет склада: остаток по складу пользователя
	МестоХранения = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	РегистрыНакопления.ТоварыВНаличии.ЗаполнитьОстаткиСтрок(Объект.ТЧТовары, МестоХранения);
КонецПроцедуры

&НаКлиенте
Процедура ПредложенияПоставщиков(Команда)
	Отбор = Новый Структура("ЗаказПокупателя", Объект.Ссылка);
	ОткрытьФорму("Документ.ПредложениеПоставщика.Форма.ФормаСписка", Новый Структура("Отбор", Отбор), ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеТендера()
	// Кнопка и декорация тендера привязаны к функциональной опции «Тендеры поставщиков»:
	// при выключенной опции платформа убирает их с формы совсем, поэтому сначала ищем.
	// В декорации - число предложений по заказу и победитель, если он выбран.
	КнопкаПредложений = Элементы.Найти("КнопкаПредложенияПоставщиков");
	ДекорацияТендера = Элементы.Найти("ДекорацияТендер");
	Если КнопкаПредложений = Неопределено Или ДекорацияТендера = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТендерыВключены = ПолучитьФункциональнуюОпцию("ТендерыПоставщиков");
	КнопкаПредложений.Видимость = ТендерыВключены;
	ДекорацияТендера.Видимость = Ложь;
	Если Не ТендерыВключены Или Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ТЗПредложения = Документы.ПредложениеПоставщика.ПредложенияЗаказа(Объект.Ссылка);
	Если ТЗПредложения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ДекорацияТендера.Видимость = Истина;
	МасПобедители = ТЗПредложения.НайтиСтроки(Новый Структура("Победитель", Истина));
	Если МасПобедители.Количество() > 0 Тогда
		Шаблон = НСтр("fr = 'Appel d''offres : %1 offre(s), gagnant - %2';
			|ru = 'Тендер: %1 предложений, победитель - %2';
			|en = 'Tender: %1 offers, winner - %2';
			|es = 'Licitación: %1 ofertas, ganador - %2'");
		ДекорацияТендера.Заголовок = СтрШаблон(Шаблон, ТЗПредложения.Количество(), МасПобедители[0].Поставщик);
	Иначе
		Шаблон = НСтр("fr = 'Appel d''offres : %1 offre(s), gagnant non choisi';
			|ru = 'Тендер: %1 предложений, победитель не выбран';
			|en = 'Tender: %1 offers, winner not selected';
			|es = 'Licitación: %1 ofertas, ganador no elegido'");
		ДекорацияТендера.Заголовок = СтрШаблон(Шаблон, ТЗПредложения.Количество());
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Оповещения

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ScanData" и ВводДоступен() Тогда 
		Штрихкод = ОперацииСПодключаемымОборудованиемКлиент.ПолучитьШтрихкод(ИмяСобытия, Параметр, Источник);
		СтруктураТОвара = ОбщегоНазначенияВызовСервера.ПолучитьНоменклатуруПоШтрихкоду(Штрихкод, Ложь);
		Если СтруктураТОвара = Неопределено Тогда
			Оп = Новый ОписаниеОповещения("ПослеДобавленияНоменклатуры",ЭтаФорма,Новый Структура("Штрихкод",Штрихкод));
			ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента",Новый Структура("Штрихкод",Штрихкод),ЭтаФорма,,,,Оп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			РаботаСДокументамиКлиентСервер.ДобавитьНоменклатуруПоШтрихкоду(Штрихкод, Объект, СтруктураТОвара,, ВидЦены,ЭтаФорма);
			ПересчитатьВсеМатериалы();
			ПрименитьОтборМатериалов();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокиПоРежимуНДС()
	Для Каждого Стр Из Объект.ТЧТовары Цикл
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, Объект.ЦенаВключаетНДС);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьОбщуюКоманду(Команда)
	КомандыТабличныхЧастейКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") И ВыбранноеЗначение.Свойство("Количество") Тогда
		РаботаСДокументамиКлиентСервер.ДобавитьНоменклатуруПоПодбору(Объект, ВыбранноеЗначение, , ВидЦены, ЭтотОбъект);
		ПересчитатьВсеМатериалы();
		ПрименитьОтборМатериалов();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТЧМатериалы

&НаКлиенте
Процедура РежимМатериаловПриИзменении(Элемент)
	ПрименитьОтборМатериалов();
КонецПроцедуры

&НаКлиенте
Процедура ТЧМатериалыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	СтрокаТоваров = Элементы.ТЧТовары.ТекущиеДанные;
	Если СтрокаТоваров = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстВыберитеСтрокуТоваров(), , , , Отказ);
		Возврат;
	КонецЕсли;
	// Повторяющийся код остаётся у первой строки с этим кодом, как при записи заказа.
	Отбор = Новый Структура("КодСтроки", СтрокаТоваров.КодСтроки);
	СтрокиСКодом = Объект.ТЧТовары.НайтиСтроки(Отбор);
	КодЗанятПредыдущейСтрокой = СтрокиСКодом.Количество() > 1 И СтрокиСКодом[0] <> СтрокаТоваров;
	Если СтрокаТоваров.КодСтроки = 0 Или КодЗанятПредыдущейСтрокой Тогда
		СтрокаТоваров.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Объект.ТЧТовары);
		ПрименитьОтборМатериалов();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТЧМатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	Материал = Элемент.ТекущиеДанные;
	Материал.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Объект.ТЧМатериалы);
	// Новая строка и копия относятся к продукции, на которой стоит пользователь, в обоих режимах.
	СтрокаТоваров = Элементы.ТЧТовары.ТекущиеДанные;
	Если СтрокаТоваров <> Неопределено Тогда
		Материал.КодСтрокиПродукции = СтрокаТоваров.КодСтроки;
		ПересчитатьСтрокуМатериала(Материал, СтрокаТоваров.Количество);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТЧМатериалыНоменклатураПриИзменении(Элемент)
	Материал = Элементы.ТЧМатериалы.ТекущиеДанные;
	Материал.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	// Материал по карте получает упаковку карты только при опции «Использовать упаковку»; вручную
	// введённый - единицу материала на тех же условиях, иначе ключ состава разошёлся бы с картой.
	Материал.Упаковка = УпаковкаМатериалаПоУмолчанию(Материал.Номенклатура);
	ПересчитатьТекущийМатериал();
КонецПроцедуры

// Упаковка вручную введённого материала.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - материал.
//
// Возвращаемое значение:
//  СправочникСсылка.УпаковкиЕдиницыИзмерения - единица материала при опции «Использовать упаковку», иначе пустая.
//
&НаСервереБезКонтекста
Функция УпаковкаМатериалаПоУмолчанию(Знач Номенклатура)
	Если Не ЗначениеЗаполнено(Номенклатура) Или Не ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку") Тогда
		Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Единица");
КонецФункции

&НаКлиенте
Процедура ТЧМатериалыУпаковкаПриИзменении(Элемент)
	ПересчитатьТекущийМатериал();
КонецПроцедуры

&НаКлиенте
Процедура ТЧМатериалыКоличествоЗаЕдиницуПриИзменении(Элемент)
	ПересчитатьТекущийМатериал();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьМатериалыПоТехкарте(Команда)
	Если Элементы.ТЧТовары.ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстВыберитеСтрокуТоваров());
		Возврат;
	КонецЕсли;
	ЗаполнитьМатериалыНаСервере(Элементы.ТЧТовары.ТекущаяСтрока);
	ПослеЗаполненияМатериалов();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВсеМатериалыПоТехкартам(Команда)
	Если Объект.ТЧМатериалы.Количество() = 0 Тогда
		ЗаполнитьМатериалыНаСервере(Неопределено);
		ПослеЗаполненияМатериалов();
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьВсеМатериалыПослеВопроса", ЭтотОбъект);
	ТекстВопроса = НСтр("ru = 'Перезаполнить материалы всех строк по техкартам? Ручные изменения материалов будут потеряны.';
		|fr = 'Remplir à nouveau les matières de toutes les lignes selon les gammes de fabrication ? Les modifications manuelles seront perdues.';
		|en = 'Refill the materials of all lines from production routings? Manual changes to materials will be lost.';
		|es = '¿Volver a rellenar los materiales de todas las líneas según las rutas de fabricación? Se perderán los cambios manuales.'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
КонецПроцедуры

// Обработчик ответа на вопрос о перезаполнении материалов всех строк.
//
// Параметры:
//  Ответ                   - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ЗаполнитьВсеМатериалыПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьМатериалыНаСервере(Неопределено);
	ПослеЗаполненияМатериалов();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Материалы видны только у заказа на производство при включённой опции «Производство»; признак
// нужен и клиентским обработчикам: у продаж поведение формы не меняется.
//
&НаСервере
Процедура НастроитьМатериалы()
	ЭтоЗаказНаПроизводство = ПолучитьФункциональнуюОпцию("Производство")
		И Объект.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	// При выключенной опции элементы реквизитов опции могут отсутствовать - сначала ищем.
	Для Каждого ИмяЭлемента Из СтрРазделить("ГруппаМатериалы,ТЧТоварыТехкарта", ",") Цикл
		Элемент = Элементы.Найти(ИмяЭлемента);
		Если Элемент <> Неопределено Тогда
			Элемент.Видимость = ЭтоЗаказНаПроизводство;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Проводится только заказ на производство (E6): у продажи команды проведения скрыты, главная кнопка -
// «Записать и закрыть», как до включения проведения. Вид операции проведённого заказа не меняется.
//
// Параметры:
//  Проведен - Булево - проведён ли заказ.
//
&НаСервере
Процедура НастроитьПроведение(Проведен)
	Проводится = Документы.ЗаказПокупателя.ЗаказПроводится(Объект.ВидОперации);
	Элементы.ФормаПровестиИЗакрыть.Видимость = Проводится;
	Элементы.ФормаПровести.Видимость = Проводится;
	Элементы.ФормаЗаписатьИЗакрыть.Видимость = Не Проводится;
	Элементы.ФормаОтменаПроведения.Видимость = Проведен;
	Если Проводится Тогда
		Элементы.ФормаПровестиИЗакрыть.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.ФормаЗаписатьИЗакрыть.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	Элементы.ВидОперации.ТолькоПросмотр = Проведен;
КонецПроцедуры

// Режим «по строке товаров» показывает материалы текущей строки товаров, «все материалы» - без отбора.
//
&НаКлиенте
Процедура ПрименитьОтборМатериалов()
	Если Не ЭтоЗаказНаПроизводство Тогда
		Возврат;
	КонецЕсли;
	Если РежимМатериалов = 1 Тогда
		Элементы.ТЧМатериалы.ОтборСтрок = Неопределено;
		Возврат;
	КонецЕсли;
	СтрокаТоваров = Элементы.ТЧТовары.ТекущиеДанные;
	КодСтроки = ?(СтрокаТоваров = Неопределено, -1, СтрокаТоваров.КодСтроки);
	Элементы.ТЧМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура("КодСтрокиПродукции", КодСтроки);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьМатериалыСтроки(КодСтроки)
	Материалы = Объект.ТЧМатериалы.НайтиСтроки(Новый Структура("КодСтрокиПродукции", КодСтроки));
	Для Каждого Материал Из Материалы Цикл
		Объект.ТЧМатериалы.Удалить(Материал);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьМатериалыСтроки(КодИсходнойСтроки, КодНовойСтроки)
	Исходные = Объект.ТЧМатериалы.НайтиСтроки(Новый Структура("КодСтрокиПродукции", КодИсходнойСтроки));
	КодМатериала = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Объект.ТЧМатериалы);
	Для Каждого Исходный Из Исходные Цикл
		Материал = Объект.ТЧМатериалы.Добавить();
		ЗаполнитьЗначенияСвойств(Материал, Исходный);
		Материал.КодСтроки = КодМатериала;
		Материал.КодСтрокиПродукции = КодНовойСтроки;
		КодМатериала = КодМатериала + 1;
	КонецЦикла;
КонецПроцедуры

// Удаляет материалы, чьей строки товаров больше нет. Вызывается и обработчиком ожидания после
// отмены добавления строки товаров.
//
&НаКлиенте
Процедура УдалитьМатериалыБезСтрокТоваров() Экспорт
	КодыТоваров = Новый Соответствие;
	Для Каждого СтрокаТоваров Из Объект.ТЧТовары Цикл
		КодыТоваров.Вставить(СтрокаТоваров.КодСтроки, Истина);
	КонецЦикла;
	Индекс = Объект.ТЧМатериалы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Материал = Объект.ТЧМатериалы[Индекс];
		Если КодыТоваров[Материал.КодСтрокиПродукции] = Неопределено Тогда
			Объект.ТЧМатериалы.Удалить(Материал);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
КонецПроцедуры

// Смена номенклатуры строки товаров: материалы и версия карты относились к прежней продукции.
//
// Параметры:
//  СтрокаТоваров - ДанныеФормыЭлементКоллекции, Неопределено - строка товаров.
//
&НаКлиенте
Процедура ОчиститьМатериалыСтрокиТоваров(СтрокаТоваров)
	Если Не ЭтоЗаказНаПроизводство Или СтрокаТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаТоваров.КодСтроки <> 0 Тогда
		УдалитьМатериалыСтроки(СтрокаТоваров.КодСтроки);
	КонецЕсли;
	СтрокаТоваров.Техкарта = ПредопределенноеЗначение("Документ.ТехнологическаяКарта.ПустаяСсылка");
КонецПроцедуры

// Та же формула, что Документы.ЗаказПокупателя.ПересчитатьСтрокуМатериала на сервере.
//
// Параметры:
//  Материал            - ДанныеФормыЭлементКоллекции - строка материалов.
//  КоличествоПродукции - Число - количество строки товаров в базовых единицах.
//
&НаКлиенте
Процедура ПересчитатьСтрокуМатериала(Материал, КоличествоПродукции)
	Материал.КоличествоУпаковок = Материал.КоличествоЗаЕдиницу * КоличествоПродукции;
	РаботаСДокументамиКлиентСервер.РассчитатьКоличество(Материал);
КонецПроцедуры

// Без упаковок пересчёт идёт на клиенте без обращений к серверу; если у материалов строки есть
// упаковки, коэффициенты считаются на сервере одним вызовом (пересчитываются материалы всего заказа -
// пересчёт идемпотентен), а не вызовом на каждый материал.
//
// Параметры:
//  СтрокаТоваров - ДанныеФормыЭлементКоллекции, Неопределено - строка товаров.
//
&НаКлиенте
Процедура ПересчитатьМатериалыСтроки(СтрокаТоваров)
	Если Не ЭтоЗаказНаПроизводство Или СтрокаТоваров = Неопределено Или СтрокаТоваров.КодСтроки = 0 Тогда
		Возврат;
	КонецЕсли;
	Материалы = Объект.ТЧМатериалы.НайтиСтроки(Новый Структура("КодСтрокиПродукции", СтрокаТоваров.КодСтроки));
	Для Каждого Материал Из Материалы Цикл
		Если ЗначениеЗаполнено(Материал.Упаковка) Тогда
			ПересчитатьВсеМатериалыНаСервере();
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Материал Из Материалы Цикл
		ПересчитатьСтрокуМатериала(Материал, СтрокаТоваров.Количество);
	КонецЦикла;
КонецПроцедуры

// Подбор и штрихкод меняют несколько строк сразу: пересчёт одним вызовом сервера, а не вызовом
// коэффициента упаковки на каждый материал с клиента. Подбор и штрихкод могли добавить строку с
// нулевым кодом - коды строк товаров здесь не трогаются.
//
&НаКлиенте
Процедура ПересчитатьВсеМатериалы()
	Если Не ЭтоЗаказНаПроизводство Или Объект.ТЧМатериалы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПересчитатьВсеМатериалыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьВсеМатериалыНаСервере()
	Для Каждого Материал Из Объект.ТЧМатериалы Цикл
		СтрокиТоваров = Объект.ТЧТовары.НайтиСтроки(Новый Структура("КодСтроки", Материал.КодСтрокиПродукции));
		КоличествоПродукции = ?(СтрокиТоваров.Количество() = 0, 0, СтрокиТоваров[0].Количество);
		Документы.ЗаказПокупателя.ПересчитатьСтрокуМатериала(Материал, КоличествоПродукции);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТекущийМатериал()
	Материал = Элементы.ТЧМатериалы.ТекущиеДанные;
	Если Материал = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокиТоваров = Объект.ТЧТовары.НайтиСтроки(Новый Структура("КодСтроки", Материал.КодСтрокиПродукции));
	КоличествоПродукции = ?(СтрокиТоваров.Количество() = 0, 0, СтрокиТоваров[0].Количество);
	ПересчитатьСтрокуМатериала(Материал, КоличествоПродукции);
КонецПроцедуры

&НаКлиенте
Функция ТекстВыберитеСтрокуТоваров()
	Возврат НСтр("ru = 'Выберите строку товаров, к которой относятся материалы';
		|fr = 'Sélectionnez la ligne d''articles à laquelle se rapportent les matières';
		|en = 'Select the product line the materials belong to';
		|es = 'Seleccione la línea de artículos a la que pertenecen los materiales'");
КонецФункции

// Серверная часть команд заполнения: данные формы, а не объект, чтобы не сбросить дополнительные
// колонки товаров (остатки, последние цены).
//
// Параметры:
//  ИдентификаторСтроки - Число, Неопределено - строка товаров; не задан - все строки.
//
&НаСервере
Процедура ЗаполнитьМатериалыНаСервере(Знач ИдентификаторСтроки)
	Строки = Неопределено;
	Если ИдентификаторСтроки <> Неопределено Тогда
		Строки = Новый Массив;
		Строки.Добавить(Объект.ТЧТовары.НайтиПоИдентификатору(ИдентификаторСтроки));
	КонецЕсли;
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Объект.ТЧТовары, Объект.ТЧМатериалы, Объект.Дата,
		Строки, Строки = Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаполненияМатериалов()
	Модифицированность = Истина;
	ПрименитьОтборМатериалов();
КонецПроцедуры

#КонецОбласти
