&НаСервере
Процедура УстановитьЦеныНаСервере()
	РаботаСДокументами.УстановитьЦеныВТабличнойЧасти(Объект.ТЧТовары, ВидЦены, Объект.ДатаОтгрузки, Объект.ЦенаВключаетНДС,
		Объект.Контрагент);		
КонецПроцедуры 

&НаСервере
Функция ПолучитьАдресатаОбсуждения()
	УстановитьПривилегированныйРежим(Истина);
	Возврат Справочники.Пользователи.ПолучитьПоСотруднику(Объект.Менеджер);	
КонецФункции	

&НаСервере
Процедура УстановитьВидЦеныПоДоговору()
	//ВидЦены = ?(ЗначениеЗаполнено(Объект.Договор.ВидЦены),Объект.Договор.ВидЦены, Справочники.ВидыЦен.Розничная);
	ВидЦены = ?(ЗначениеЗаполнено(Объект.Контрагент.ТипЦены),Объект.Контрагент.ТипЦены, Справочники.ВидыЦен.Розничная);
	РаботаСДокументамиКлиентСервер.ЗаполнитьСписокВыбораВидовЦен(ВидЦены, Элементы.ТЧТоварыВидЦены);
	Объект.ЦенаВключаетНДС = ОбщегоНазначенияВызовСервера.ЦенаВключаетНДСПоВидуЦен(ВидЦены);
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	Элементы.ТЧТоварыГруппаПоследниеЦены.Видимость = ЕстьПравоЗаверениеЦен;
	Элементы.ТЧТоварыВидЦены.ТолькоПросмотр = Не ЕстьПравоЗаверениеЦен;
	Элементы.ТЧТоварыЦена.ТолькоПросмотр = Не ЕстьПравоЗаверениеЦен;
	Элементы.ТЧТоварыСумма.ТолькоПросмотр = Не ЕстьПравоЗаверениеЦен;
	Элементы.ТЧТоварыПроцентСкидки.ТолькоПросмотр = Не ЕстьПравоЗаверениеЦен;
	Элементы.ТЧТоварыСуммаСкидки.ТолькоПросмотр = Не ЕстьПравоЗаверениеЦен;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПоследниеЦены(Знач Строка = Неопределено)
	РаботаСДокументами.ЗаполнитьПоследниеЦены(Объект, Строка);
	Возврат Строка;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоследниеЦеныСтроки(ТекСтр)
	СтрСтруктура = РаботаСДокументамиКлиентСервер.ПреобразоватьСтрокуТаблицыВСтруктуру(ТекСтр, Объект);
	СтрСтруктура = ЗаполнитьПоследниеЦены(СтрСтруктура);
	ЗаполнитьЗначенияСвойств(ТекСтр, СтрСтруктура, "ЦенаЗакупкиПоследняя, ЦенаПродажиПоследняя, ПроцентНаценкиНаЦену");
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыПроцентНаценкиНаЦенуПриИзменении(Элемент)
	ТекСтр = Элементы.ТЧТовары.ТекущиеДанные;
	ТекСтр.Цена = ТекСтр.ЦенаЗакупкиПоследняя
		* (1 + ТекСтр.ПроцентНаценкиНаЦену / РаботаСДокументамиКлиентСервер.СтоПроцентов());
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(ТекСтр, Объект.ЦенаВключаетНДС, "Цена");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСуммыОплатыДолга()    
	
		СуммаДолга = "0,00";        
		СуммаОплаты  = "0,00"; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВзаиморасчётыСПокупателями.ОбъектРасчётов КАК ОбъектРасчётов,
	|	ВзаиморасчётыСПокупателями.Сумма КАК Сумма
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК ВзаиморасчётыСПокупателями
	|ГДЕ
	|	ВзаиморасчётыСПокупателями.ОбъектРасчётов.Основание = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",объект.Ссылка);  
	
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Если Выборка.Количество() = 0 Тогда иначе

		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВзаиморасчётыСПокупателямиОстатки.ОбъектРасчётов КАК ОбъектРасчётов,
		               |	ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток КАК Сумма
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, ОбъектРасчётов.Основание = &Ссылка) КАК ВзаиморасчётыСПокупателямиОстатки";
		Запрос.УстановитьПараметр("Ссылка",объект.Ссылка);  
	
		Выборка = Запрос.Выполнить().Выгрузить();
	
		СуммаДолга = Строка(Выборка.Итог("Сумма"));        
		СуммаОплаты  = Строка(объект.Сумма - Выборка.Итог("Сумма")); 
	КонецЕсли; 
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	// У заказа нет склада: остаток по складу пользователя
	МестоХранения = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	РегистрыНакопления.ТоварыВНаличии.ЗаполнитьОстаткиСтрок(Объект.ТЧТовары, МестоХранения);
КонецПроцедуры

&НаКлиенте
Процедура ПредложенияПоставщиков(Команда)
	Отбор = Новый Структура("ЗаказПокупателя", Объект.Ссылка);
	ОткрытьФорму("Документ.ПредложениеПоставщика.Форма.ФормаСписка", Новый Структура("Отбор", Отбор), ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеТендера()
	// Кнопка и декорация тендера видны только при включённой функциональной опции;
	// в декорации - число предложений по заказу и победитель, если он выбран.
	ТендерыВключены = ПолучитьФункциональнуюОпцию("ТендерыПоставщиков");
	Элементы.КнопкаПредложенияПоставщиков.Видимость = ТендерыВключены;
	Элементы.ДекорацияТендер.Видимость = Ложь;
	Если Не ТендерыВключены Или Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ТЗПредложения = Документы.ПредложениеПоставщика.ПредложенияЗаказа(Объект.Ссылка);
	Если ТЗПредложения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Элементы.ДекорацияТендер.Видимость = Истина;
	МасПобедители = ТЗПредложения.НайтиСтроки(Новый Структура("Победитель", Истина));
	Если МасПобедители.Количество() > 0 Тогда
		Шаблон = НСтр("fr = 'Appel d''offres : %1 offre(s), gagnant - %2';
			|ru = 'Тендер: %1 предложений, победитель - %2';
			|en = 'Tender: %1 offers, winner - %2';
			|es = 'Licitación: %1 ofertas, ganador - %2'");
		Элементы.ДекорацияТендер.Заголовок = СтрШаблон(Шаблон, ТЗПредложения.Количество(), МасПобедители[0].Поставщик);
	Иначе
		Шаблон = НСтр("fr = 'Appel d''offres : %1 offre(s), gagnant non choisi';
			|ru = 'Тендер: %1 предложений, победитель не выбран';
			|en = 'Tender: %1 offers, winner not selected';
			|es = 'Licitación: %1 ofertas, ganador no elegido'");
		Элементы.ДекорацияТендер.Заголовок = СтрШаблон(Шаблон, ТЗПредложения.Количество());
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Оповещения

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ScanData" и ВводДоступен() Тогда 
		Штрихкод = ОперацииСПодключаемымОборудованиемКлиент.ПолучитьШтрихкод(ИмяСобытия, Параметр, Источник);
		СтруктураТОвара = ОбщегоНазначенияВызовСервера.ПолучитьНоменклатуруПоШтрихкоду(Штрихкод, Ложь);
		Если СтруктураТОвара = Неопределено Тогда
			Оп = Новый ОписаниеОповещения("ПослеДобавленияНоменклатуры",ЭтаФорма,Новый Структура("Штрихкод",Штрихкод));
			ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента",Новый Структура("Штрихкод",Штрихкод),ЭтаФорма,,,,Оп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			РаботаСДокументамиКлиентСервер.ДобавитьНоменклатуруПоШтрихкоду(Штрихкод, Объект, СтруктураТОвара,, ВидЦены,ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокиПоРежимуНДС()
	Для Каждого Стр Из Объект.ТЧТовары Цикл
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, Объект.ЦенаВключаетНДС);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьОбщуюКоманду(Команда)
	КомандыТабличныхЧастейКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") И ВыбранноеЗначение.Свойство("Количество") Тогда
		РаботаСДокументамиКлиентСервер.ДобавитьНоменклатуруПоПодбору(Объект, ВыбранноеЗначение, , ВидЦены, ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
