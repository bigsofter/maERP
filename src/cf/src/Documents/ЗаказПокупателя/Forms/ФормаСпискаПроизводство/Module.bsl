#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОтборПоСтатусу = "Все";  
	Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДатаСеанса());
	ДСТовары.Параметры.УстановитьЗначениеПараметра("Ссылка", Документы.ЗаказПокупателя.ПустаяСсылка());
	ДССтруктураПодчиненности.Параметры.УстановитьЗначениеПараметра("Ссылка", Документы.ЗаказПокупателя.ПустаяСсылка());
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	ТекСтрока = Элементы.Список.ТекущиеДанные;
	ТекЗаказ = ?(ТекСтрока = Неопределено,
		ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка"), ТекСтрока.Ссылка);
	УстановитьПараметрыДеталей();
КонецПроцедуры

&НаКлиенте
Процедура ДССтруктураПодчиненностиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ссылка = Элемент.ТекущиеДанные.Ссылка;
	ПараметрыОткрытия = Новый Структура("Ключ", Ссылка);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДокумента", ЭтотОбъект);
	ОткрытьФорму(ИмяФормыОбъекта(Ссылка), ПараметрыОткрытия, ЭтотОбъект, , , , Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоСтатусуПриИзменении(Элемент)
	УдалитьОтбор(Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор, "Статус");
	Если ОтборПоСтатусу = "Новый" Или ОтборПоСтатусу = "ВРаботе" Или ОтборПоСтатусу = "Собран" Тогда                                     
		ДанныеВыбора = ПолучитьСтатусыЗаказовПокупателя(ОтборПоСтатусу);
		ДобавитьОтбор(Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор, "Статус", ДанныеВыбора, ВидСравненияКомпоновкиДанных.Равно);		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеЗакрытияДокумента(Результат, ДопПараметры) Экспорт
	Элементы.Список.Обновить();
	Элементы.ДССтруктураПодчиненности.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыДеталей()
	ДСТовары.Параметры.УстановитьЗначениеПараметра("Ссылка", ТекЗаказ);
	ДССтруктураПодчиненности.Параметры.УстановитьЗначениеПараметра("Ссылка", ТекЗаказ);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяФормыОбъекта(Знач Ссылка)
	Возврат Ссылка.Метаданные().ПолноеИмя() + ".ФормаОбъекта";
КонецФункции

&НаСервере
Функция ПолучитьСтатусыЗаказовПокупателя(Знач ОтборПоСтатусу)
	Если ОтборПоСтатусу = "Новый" Тогда
		Возврат Перечисления.СтатусыЗаказовПокупателя.Новый; 
	КонецЕсли;
	Если ОтборПоСтатусу = "ВРаботе" Тогда
		Возврат Перечисления.СтатусыЗаказовПокупателя.ВРаботе; 
	КонецЕсли;  
	Если ОтборПоСтатусу = "Собран" Тогда
		Возврат Перечисления.СтатусыЗаказовПокупателя.Собран; 
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция ДобавитьОтбор(СписокОтборов, ИмяПоля, Значение, ВидСравнения = Неопределено, Использование = Истина)
	НовыйЭлемент = СписокОтборов.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	НовыйЭлемент.ВидСравнения = ?(ВидСравнения = Неопределено, ВидСравненияКомпоновкиДанных.Равно, ВидСравнения);
	НовыйЭлемент.ПравоеЗначение = Значение;
	НовыйЭлемент.Использование = Использование;
	Возврат НовыйЭлемент;
КонецФункции

&НаКлиенте
Функция УдалитьОтбор(СписокОтборов, ИмяПоля = "")
	Если ПустаяСтрока(ИмяПоля) Тогда
		СписокОтборов.Элементы.Очистить();
		Возврат Истина;
	КонецЕсли;
	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ОтборУдален = Ложь;
	УдаляемыеЭлементы = Новый Массив;
	Для Каждого ЭлементОтбора Из СписокОтборов.Элементы Цикл
		Если ЭлементОтбора.Использование И ЭлементОтбора.ЛевоеЗначение = Поле Тогда
			УдаляемыеЭлементы.Добавить(ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлементОтбора Из УдаляемыеЭлементы Цикл
		СписокОтборов.Элементы.Удалить(ЭлементОтбора);
		ОтборУдален = Истина;
	КонецЦикла;
	Возврат ОтборУдален;
КонецФункции

#КонецОбласти
