    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументЗаказПокупателя.Ссылка КАК Ссылка,
	ДокументЗаказПокупателя.ПометкаУдаления КАК ПометкаУдаления,
	ДокументЗаказПокупателя.Номер КАК Номер,
	ДокументЗаказПокупателя.Дата КАК Дата,
	ДокументЗаказПокупателя.Проведен КАК Проведен,
	ДокументЗаказПокупателя.ДатаОтгрузки КАК ДатаОтгрузки,
	ДокументЗаказПокупателя.Договор КАК Договор,
	ДокументЗаказПокупателя.Комментарий КАК Комментарий,
	ДокументЗаказПокупателя.Контрагент КАК Контрагент,
	ДокументЗаказПокупателя.Менеджер КАК Менеджер,
	ДокументЗаказПокупателя.Организация КАК Организация,
	ДокументЗаказПокупателя.Ответственный КАК Ответственный,
	ДокументЗаказПокупателя.Сумма КАК Сумма,
	ДокументЗаказПокупателя.СуммаНДС КАК СуммаНДС,
	ДокументЗаказПокупателя.СуммаБезНДС КАК СуммаБезНДС,
	ДокументЗаказПокупателя.ECommerce КАК ECommerce,
	ДокументЗаказПокупателя.Доставлен КАК Доставлен,
	ДокументЗаказПокупателя.НомерВходящегоДокументаЭлектронногоОбмена КАК НомерВходящегоДокументаЭлектронногоОбмена,
	ДокументЗаказПокупателя.ЗаказСWEBСайта КАК ЗаказСWEBСайта,
	ДокументЗаказПокупателя.ДатаВходящегоДокументаЭлектронногоОбмена КАК ДатаВходящегоДокументаЭлектронногоОбмена,
	ДокументЗаказПокупателя.МенеджерПодтвердилПроверилОстаток КАК МенеджерПодтвердилПроверилОстаток,
	ДокументЗаказПокупателя.АвторОбщий КАК АвторОбщий,
	ДокументЗаказПокупателя.ТЧТовары.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		КодСтроки КАК КодСтроки,
		Номенклатура КАК Номенклатура,
		Характеристика КАК Характеристика,
		Упаковка КАК Упаковка,
		КоличествоУпаковок КАК КоличествоУпаковок,
		Количество КАК Количество,
		ВидЦены КАК ВидЦены,
		ЦенаSKU КАК ЦенаSKU,
		Цена КАК Цена,
		Сумма КАК Сумма,
		ПроцентСкидки КАК ПроцентСкидки,
		СуммаСкидки КАК СуммаСкидки,
		СуммаСНДС КАК СуммаСНДС,
		СтавкаНДС КАК СтавкаНДС,
		СуммаНДС КАК СуммаНДС,
		СкидкаНаЦену КАК СкидкаНаЦену
	) КАК ТЧТовары,
	ДокументЗаказПокупателя.МоментВремени КАК МоментВремени,
	ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя КАК Статус,
	ВЫБОР
		КОГДА ДокументЗаказПокупателя.ПометкаУдаления
			ТОГДА 4
		КОГДА ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.Доставлен)
			ТОГДА 3
		КОГДА ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.Отгружен)
			ТОГДА 2
		КОГДА ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя В (
				ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.ВРаботе),
				ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.ВПроизводстве),
				ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.ПереданСубподрядчику),
				ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.ПолученОтСубподрядчика),
				ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.Собран))
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК НомерКартинкиОтгрузки,
	ВЫБОР
		КОГДА ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.Собран)
				ИЛИ ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.Доставлен)
				ИЛИ ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.Отгружен)
			ТОГДА ВЫБОР
					КОГДА ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СрокОплаты = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
						ТОГДА ВЫБОР
								КОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) = 0
									ТОГДА 2
								ИНАЧЕ ВЫБОР
										КОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) &lt; ДокументЗаказПокупателя.Сумма
											ТОГДА 1
										ИНАЧЕ 2
									КОНЕЦ
							КОНЕЦ
					ИНАЧЕ ВЫБОР
							КОГДА &amp;ТекущаяДата &gt; ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СрокОплаты
								ТОГДА ВЫБОР
										КОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) = 0
											ТОГДА ВЫБОР
													КОГДА РеализацияТоваровУслуг.Проведен = ИСТИНА
														ТОГДА 0
													ИНАЧЕ -1
												КОНЕЦ
										ИНАЧЕ 2
									КОНЕЦ
							ИНАЧЕ ВЫБОР
									КОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) = 0
										ТОГДА ВЫБОР
												КОГДА РеализацияТоваровУслуг.Проведен = ИСТИНА
													ТОГДА 0
												ИНАЧЕ -1
											КОНЕЦ
									ИНАЧЕ ВЫБОР
											КОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) &lt; ДокументЗаказПокупателя.Сумма
												ТОГДА 1
											ИНАЧЕ 2
										КОНЕЦ
								КОНЕЦ
						КОНЕЦ
				КОНЕЦ
		ИНАЧЕ -1
	КОНЕЦ КАК НомерКартинкиОплаты,
	ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) КАК Долг
ИЗ
	Документ.ЗаказПокупателя КАК ДокументЗаказПокупателя
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних КАК ИсторияЗаказовПокупателейПоСтатусамСрезПоследних
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки КАК ВзаиморасчётыСПокупателямиОстатки
			ПО ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.ДокументПродажи = ВзаиморасчётыСПокупателямиОстатки.ОбъектРасчётов
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
			ПО ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.ДокументПродажи = РеализацияТоваровУслуг.Ссылка
		ПО ДокументЗаказПокупателя.Ссылка = ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.ЗаказПокупателя</queryText>
      <mainTable>Document.ЗаказПокупателя</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
