#Область ОписаниеПеременных

// Строка «Товаров», вставленная формой и ещё не тронутая пользователем (ПередНачаломДобавления).
&НаКлиенте
Перем ВставленнаяСтрокаТоваров;

// Идёт ввод строки «Товаров»: очередь записи ждёт его окончания.
&НаКлиенте
Перем СтрокаВводится;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НастроитьВидОперации();
	// Отбор вида операции ставится явно: присваивание позиции тумблера отбора не ставит (план orders-kp-goods-tab,
	// P1 круга 1) - список без отбора показывает только заказы-продажи.
	УстановитьОтборВидаОперации();
	НастроитьКомандыПроведения();
	Элементы.Индикатор.Шрифт = ПроизводственныеЗаказы.ШрифтИндикатора(ШрифтыСтиля.ОбычныйШрифтТекста);
	// При выключенной опции КП создаёт реализация и в интерфейсе их нет (docs/plans/branded-print.md, 9.9).
	Элементы.СтраницаКоммерческиеПредложения.Видимость = Документы.КоммерческоеПредложение.КПВводятсяВручную();
	НастроитьЗакладкуТовары();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	СтрокаВводится = Ложь;
	// Состояние панели сведений восстанавливается из сохранённых данных формы.
	ПрименитьСостояниеПанели();
	ТекущаяСтраница = Элементы.ГруппаСтраницыДокументов.ТекущаяСтраница;
	Элементы.ГруппаПанельСведений.Видимость = ТекущаяСтраница <> Элементы.СтраницаКоммерческиеПредложения;

КонецПроцедуры

// Незаписанные правки «Товаров» не теряются молча: сначала - запись; не записалось - вопрос.
//
// Параметры:
//  Отказ                - Булево - закрытие отменяется.
//  ЗавершениеРаботы     - Булево - закрывается программа: вопрос не задаётся.
//  ТекстПредупреждения  - Строка - предупреждение платформы при завершении работы.
//  СтандартнаяОбработка - Булево - не используется.
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗакрытиеПодтверждено Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаВводится Тогда
		Элементы.Товары.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	Если СтрокиТоваровКЗаписи.Количество() = 0 И ЧислоНезаписанныхСтрок() = 0 Тогда
		Возврат;
	КонецЕсли;
	ТекстНезаписано = НСтр("ru = 'На закладке «Товары» есть незаписанные правки строк.';
		|fr = 'L''onglet « Articles » contient des modifications de lignes non enregistrées.';
		|en = 'The Items tab has unsaved line changes.'; es = 'La pestaña «Artículos» tiene cambios de líneas sin guardar.'");
	Если ЗавершениеРаботы Тогда
		Отказ = Истина;
		ТекстПредупреждения = ТекстНезаписано;
		Возврат;
	КонецЕсли;
	Остаток = ЗаписатьПравкиПередЗакрытием();
	Если Остаток = 0 Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Шаблон = НСтр("ru = 'Правки строк (%1) не записаны. Закрыть без сохранения?';
		|fr = 'Modifications de lignes (%1) non enregistrées. Fermer sans enregistrer ?';
		|en = 'Line changes (%1) are not saved. Close without saving?';
		|es = 'Cambios de líneas (%1) sin guardar. ¿Cerrar sin guardar?'");
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОЗакрытии", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, СтрШаблон(Шаблон, Остаток), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ПрименитьОтборы();
	ОбновитьТоварыПослеОтбора();

КонецПроцедуры

// Правая панель - общая для заказов и «Товаров»; у коммерческих предложений её нет, как раньше. Закладка «Товары»
// загружается при первом переходе на неё и после смены отборов, пока она была закрыта.
//
// Параметры:
//  Элемент         - ГруппаФормы - группа закладок документов.
//  ТекущаяСтраница - ГруппаФормы - открытая страница.
//
&НаКлиенте
Процедура ГруппаСтраницыДокументовПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Элементы.ГруппаПанельСведений.Видимость = ТекущаяСтраница <> Элементы.СтраницаКоммерческиеПредложения;
	Если ТекущаяСтраница = Элементы.СтраницаТовары И Не ТоварыЗагружены Тогда
		ЗагрузитьТоварыНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	// Отложенно: при листании стрелками не дёргать сервер на каждую строку.
	// BSLLS:MagicNumber-off - треть секунды, константа имени не добавит.
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьСведения", 0.3, Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

&НаКлиенте
Процедура СписокКоммерческихПредложенийПриАктивизацииСтроки(Элемент)

	// Обработчик оставлен для стандартной активизации строки встроенного списка.

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьСведения()

	Ссылка = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьСведения(Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

// Двойной щелчок: по колонке «Документ» и у строки только для просмотра открывается заказ, по прочим колонкам
// записанной строки - её правка (как в рабочих местах).
//
// Параметры:
//  Элемент              - ТаблицаФормы - таблица «Товары».
//  ВыбраннаяСтрока      - Число - не используется.
//  Поле                 - ПолеФормы - колонка.
//  СтандартнаяОбработка - Булево - отключается при открытии документа.
//
&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или Не ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.ТоварыДокумент Или СтрокаТаблицы.ТолькоПросмотр Или Не МожноВводитьТовары Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьДокументСтрокиТоваров(СтрокаТаблицы);
	КонецЕсли;

КонецПроцедуры

// Новая строка - в начало таблицы: строку вставляет форма, ввод начинается обработчиком ожидания (как в рабочих
// местах); копия - в тот же заказ с товаром исходной строки, без цены.
//
// Параметры:
//  Элемент     - ТаблицаФормы - таблица «Товары».
//  Отказ       - Булево - стандартное добавление отменяется.
//  Копирование - Булево - строка копируется.
//  Родитель    - Неопределено - не используется.
//  Группа      - Булево - не используется.
//  Параметр    - Произвольный - не используется.
//
&НаКлиенте
Процедура ТоварыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Отказ = Истина;
	Если Не МожноВводитьТовары Тогда
		Возврат;
	КонецЕсли;
	Исходная = Неопределено;
	Если Копирование И Элемент.ТекущиеДанные <> Неопределено Тогда
		Исходная = Новый Структура("ТолькоПросмотр, Документ, ДокументПредставление, Клиент, Организация, Валюта,
			|Номенклатура, Характеристика, Упаковка");
		ЗаполнитьЗначенияСвойств(Исходная, Элемент.ТекущиеДанные);
	КонецЕсли;
	УдалитьВставленнуюСтрокуТоваров();
	НоваяСтрока = Товары.Вставить(0);
	ПодготовитьНовуюСтрокуТоваров(НоваяСтрока, Исходная);
	ВставленнаяСтрокаТоваров = НоваяСтрока.ПолучитьИдентификатор();
	Элемент.ТекущаяСтрока = ВставленнаяСтрокаТоваров;
	// Ввод начинается после выхода из обработчика: внутри него платформа ещё завершает отменённое добавление.
	ЗадержкаСекунд = 0.1;
	ПодключитьОбработчикОжидания("НачатьВводВставленнойСтрокиТоваров", ЗадержкаСекунд, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередНачаломИзменения(Элемент, Отказ)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаТаблицы.ТолькоПросмотр Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Эта строка правится в форме документа.';
			|fr = 'Cette ligne se modifie dans le formulaire du document.';
			|en = 'This line is edited in the document form.'; es = 'Esta línea se edita en el formulario del documento.'"));
		Возврат;
	КонецЕсли;
	// Документ, клиент, организация и товар записанной строки не меняются: другой товар - новой строкой.
	УстановитьПравкуШапкиСтрокиТоваров(СтрокаТаблицы.НомерСтроки = 0);

КонецПроцедуры

// Параметры:
//  Элемент     - ТаблицаФормы - таблица «Товары».
//  НоваяСтрока - Булево - строка добавлена платформой: форма добавляет строки сама (ПередНачаломДобавления).
//  Копирование - Булево - не используется.
//
&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	СтрокаВводится = Истина;
	Если НоваяСтрока И Элемент.ТекущиеДанные <> Неопределено Тогда
		ПодготовитьНовуюСтрокуТоваров(Элемент.ТекущиеДанные, Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	Если Не МожноВводитьТовары Тогда
		Возврат;
	КонецЕсли;
	Строки = Новый Массив;
	Незаписанные = Новый Массив;
	ДокументыСПравками = ДокументыСНезаписаннымиПравками();
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.ТолькоПросмотр Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаТаблицы.НомерСтроки = 0 Тогда
			Незаписанные.Добавить(СтрокаТаблицы);
		ИначеЕсли ДокументыСПравками.Найти(СтрокаТаблицы.Документ) <> Неопределено Тогда
			// Своё удаление перенумеровало бы строки, и незаписанные правки документа потерялись бы.
			Шаблон = НСтр("ru = 'Сначала исправьте или отмените («Обновить») незаписанные правки заказа %1.';
				|fr = 'Corrigez ou annulez d''abord (« Actualiser ») les modifications non enregistrées de la commande %1.';
				|en = 'First fix or cancel (Refresh) the unsaved changes of order %1.';
				|es = 'Primero corrija o cancele («Actualizar») los cambios no guardados del pedido %1.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, СтрокаТаблицы.ДокументПредставление));
		Иначе
			ДанныеУдаления = Новый Структура("Документ, НомерСтроки, ВерсияДанных");
			ЗаполнитьЗначенияСвойств(ДанныеУдаления, СтрокаТаблицы);
			Строки.Добавить(ДанныеУдаления);
		КонецЕсли;
	КонецЦикла;
	// Незаписанная новая строка удаляется только из таблицы: в базе её нет.
	Для Каждого СтрокаТаблицы Из Незаписанные Цикл
		Назначенная = СтрокиТоваровКЗаписи.НайтиПоЗначению(СтрокаТаблицы.ПолучитьИдентификатор());
		Если Назначенная <> Неопределено Тогда
			СтрокиТоваровКЗаписи.Удалить(Назначенная);
		КонецЕсли;
		Товары.Удалить(СтрокаТаблицы);
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Удалить строки заказов (%1)? Заказ без строк будет помечен на удаление.';
		|fr = 'Supprimer les lignes des commandes (%1) ? Une commande sans lignes sera marquée pour suppression.';
		|en = 'Delete the order lines (%1)? An order without lines will be marked for deletion.';
		|es = '¿Eliminar las líneas de pedidos (%1)? Un pedido sin líneas se marcará para eliminar.'");
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдаленииТоваров", ЭтотОбъект, Строки);
	ПоказатьВопрос(Оповещение, СтрШаблон(Шаблон, Строки.Количество()), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

// Запись строки назначается в очередь СтрокиТоваровКЗаписи и выполняется обработчиком ожидания, а не в самом событии:
// правка могла закончиться выбором из выпадающего списка, а серверный вызов, пока список закрывается, роняет клиент 8.5
// (урок рабочего места закупок 2.0.16.106). Отмена ввода вставленной незаписанной строки её удаляет.
//
// Параметры:
//  Элемент              - ТаблицаФормы - таблица «Товары».
//  НоваяСтрока          - Булево - строка добавлена.
//  ОтменаРедактирования - Булево - правка отменена.
//
&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	СтрокаВводится = Ложь;
	Идентификатор = Элемент.ТекущаяСтрока;
	Вставлена = ВставленнаяСтрокаТоваров <> Неопределено И Идентификатор = ВставленнаяСтрокаТоваров;
	Если Вставлена Тогда
		ВставленнаяСтрокаТоваров = Неопределено;
	КонецЕсли;
	Если Идентификатор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
	Если ОтменаРедактирования Тогда
		Если Вставлена И СтрокаТаблицы <> Неопределено И СтрокаТаблицы.НомерСтроки = 0 Тогда
			Товары.Удалить(СтрокаТаблицы);
		КонецЕсли;
	ИначеЕсли СтрокаТаблицы <> Неопределено Тогда
		// Правка живёт в таблице до успешной записи: перечитывание её не стирает.
		СтрокаТаблицы.Изменена = Истина;
		Если СтрокиТоваровКЗаписи.НайтиПоЗначению(Идентификатор) = Неопределено Тогда
			СтрокиТоваровКЗаписи.Добавить(Идентификатор);
		КонецЕсли;
	Иначе
		// Строку уже убрало перечитывание.
		Возврат;
	КонецЕсли;
	Если СтрокиТоваровКЗаписи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ЗадержкаСекунд = 0.1;
	ОтключитьОбработчикОжидания("ЗаписатьСтрокиТоваровОжидание");
	ПодключитьОбработчикОжидания("ЗаписатьСтрокиТоваровОжидание", ЗадержкаСекунд, Истина);

КонецПроцедуры

// Документ строки: «Новый заказ» или сегодняшний заказ-продажа клиента строки в её организации.
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «Документ».
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - отключается.
//
&НаКлиенте
Процедура ТоварыДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.НомерСтроки <> 0 Тогда
		Возврат;
	КонецЕсли;
	ВариантыДокументов = ДокументыДляСтрокиТоваров(СтрокаТаблицы.Клиент, СтрокаТаблицы.Организация);
	ВариантыДокументов.Вставить(0, Неопределено, ПредставлениеНовогоЗаказа());
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораДокументаСтрокиТоваров", ЭтотОбъект, Элементы.Товары.ТекущаяСтрока);
	ПоказатьВыборИзСписка(Оповещение, ВариантыДокументов, Элемент);

КонецПроцедуры

// Параметры:
//  ВыбранныйЭлемент - ЭлементСпискаЗначений, Неопределено - документ; Неопределено - выбор отменён.
//  Идентификатор    - Число - идентификатор строки.
//
&НаКлиенте
Процедура ПослеВыбораДокументаСтрокиТоваров(ВыбранныйЭлемент, Идентификатор) Экспорт

	СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
	Если ВыбранныйЭлемент = Неопределено Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Документ = ВыбранныйЭлемент.Значение;
	СтрокаТаблицы.ДокументПредставление = ВыбранныйЭлемент.Представление;
	СтрокаТаблицы.ЦенаИзменена = Ложь;
	Если ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
		// Клиент, организация и валюта - заказа: цена вводится в его валюте.
		Шапка = ШапкаДокументаСтрокиТоваров(СтрокаТаблицы.Документ);
		Если Шапка <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Шапка);
		КонецЕсли;
	Иначе
		ОбновитьВалютуНовойСтроки(СтрокаТаблицы);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыКлиентПриИзменении(Элемент)

	СброситьДокументНовойСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыОрганизацияПриИзменении(Элемент)

	СброситьДокументНовойСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Характеристика и упаковка прежнего товара для нового недействительны; ручная цена относилась к прежнему товару.
	СтрокаТаблицы.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	СтрокаТаблицы.Упаковка = ЕдиницаТовара(СтрокаТаблицы.Номенклатура);
	СтрокаТаблицы.ЦенаИзменена = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыХарактеристикаПриИзменении(Элемент)

	СброситьРучнуюЦену();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыУпаковкаПриИзменении(Элемент)

	// Ручная цена относилась к прежней упаковке: цену подставит прайс для новой.
	СброситьРучнуюЦену();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы <> Неопределено Тогда
		СтрокаТаблицы.ЦенаИзменена = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СортироватьПоВозрастанию(Команда)
	СортироватьПоТекущейКолонке(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СортироватьПоУбыванию(Команда)
	СортироватьПоТекущейКолонке(Истина);
КонецПроцедуры

// «Обновить» закладки «Товары»: незаписанные правки отбрасываются только с согласия пользователя.
//
// Параметры:
//  Команда - КомандаФормы - команда.
//
&НаКлиенте
Процедура ТоварыОбновить(Команда)

	Если СтрокаВводится Тогда
		Элементы.Товары.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	Число = ЧислоНезаписанныхСтрок();
	Если Число = 0 Тогда
		ЗагрузитьТоварыНаСервере();
		Возврат;
	КонецЕсли;
	// На время вопроса отложенная запись не идёт: иначе она сохранила бы отменяемые правки.
	ОтключитьОбработчикОжидания("ЗаписатьСтрокиТоваровОжидание");
	Шаблон = НСтр("ru = 'Отменить незаписанные правки строк (%1)?'; fr = 'Annuler les modifications non enregistrées des lignes (%1) ?';
		|en = 'Cancel the unsaved line changes (%1)?'; es = '¿Cancelar los cambios de líneas sin guardar (%1)?'");
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбОтменеПравок", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, СтрШаблон(Шаблон, Число), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

// «Печать» закладки «Товары»: печатная форма заказов выделенных записанных строк, каждого - целиком. Команды созданы в
// РазместитьКомандыПечатиТоваров.
//
// Параметры:
//  Команда - КомандаФормы - команда печатной формы.
//
&НаКлиенте
Процедура Подключаемый_ПечатьТоваров(Команда)

	Если СтрокаВводится Тогда
		Элементы.Товары.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	ОписаниеКоманды = Неопределено;
	Для Каждого Элемент Из КомандыПечатиТоваров Цикл
		Если Элемент.Представление = Команда.Имя Тогда
			ОписаниеКоманды = Элемент;
		КонецЕсли;
	КонецЦикла;
	Выделенные = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Товары.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы <> Неопределено И ЗначениеЗаполнено(СтрокаТаблицы.Документ)
			И Выделенные.Найти(СтрокаТаблицы.Документ) = Неопределено Тогда
			Выделенные.Добавить(СтрокаТаблицы.Документ);
		КонецЕсли;
	КонецЦикла;
	Если ОписаниеКоманды = Неопределено Или Выделенные.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выделите строки записанных заказов.';
			|fr = 'Sélectionnez des lignes de commandes enregistrées.'; en = 'Select lines of saved orders.';
			|es = 'Seleccione líneas de pedidos guardados.'"));
		Возврат;
	КонецЕсли;
	КПечати = ДокументыКПечатиНаСервере(Выделенные);
	Если КПечати.Количество() > 0 Тогда
		ПечатныеФормыКлиент.ВыполнитьКомандуПечати(ПолноеИмяДокумента(), ОписаниеКоманды.Значение, КПечати, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СвернутьПанель(Команда)

	ПанельСвернута = Истина;
	ПрименитьСостояниеПанели();

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьПанель(Команда)

	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФильтры(Команда)

	ОткрытьСтраницуПанели("СтраницаФильтры");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКлиента(Команда)

	ОткрытьСтраницуПанели("СтраницаКлиент");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДетали(Команда)

	ОткрытьСтраницуПанели("СтраницаИнфо");

КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаказПоПредложению(Команда)

	Предложение = Элементы.СписокКоммерческихПредложений.ТекущаяСтрока;
	Если ТипЗнч(Предложение) <> Тип("ДокументСсылка.КоммерческоеПредложение") Тогда
		Возврат;
	КонецЕсли;

	Основание = Предложение;
	Если ФильтрВидаОперации = ПозицияПроизводство() Тогда
		// Список заказов на производство создаёт заказ на производство, даже если в КП только закупаемые позиции.
		Основание = Новый Структура("Предложение, НаПроизводство", Предложение, Истина);
	КонецЕсли;
	ПараметрыФормы = Новый Структура("Основание", Основание);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияЗаказаПоПредложению", ЭтотОбъект);
	ОткрытьФорму("Документ.ЗаказПокупателя.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияЗаказаПоПредложению(Результат, ДополнительныеПараметры) Экспорт

	Элементы.Список.Обновить();
	Элементы.СписокКоммерческихПредложений.Обновить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Свёрнутая панель - столбик значков, развёрнутая - закладки со страницами.
// Значок открывает панель сразу на своей странице, как в УНФ.
//
&НаКлиенте
Процедура ПрименитьСостояниеПанели()

	Элементы.ГруппаПанельЗначки.Видимость = ПанельСвернута;
	Элементы.ГруппаПодвалПанели.Видимость = Не ПанельСвернута;
	Элементы.ГруппаСтраницыСведений.Видимость = Не ПанельСвернута;

КонецПроцедуры

// Разворачивает панель и активирует страницу по имени.
//
// Параметры:
//  ИмяСтраницы - Строка - имя страницы панели сведений
//
&НаКлиенте
Процедура ОткрытьСтраницуПанели(ИмяСтраницы)

	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();
	Элементы.ГруппаСтраницыСведений.ТекущаяСтраница = Элементы[ИмяСтраницы];

КонецПроцедуры

// Ставит либо снимает отборы динамического списка по полям правой панели.
// Отборы программные: пользовательские настройки списка их не перетирают.
//
&НаСервере
Процедура ПрименитьОтборы()

	Отборы = Новый Структура;
	Отборы.Вставить("Контрагент", ОтборКонтрагент);
	Отборы.Вставить("Организация", ОтборОрганизация);
	Отборы.Вставить("Ответственный", ОтборОтветственный);

	Для Каждого Отбор Из Отборы Цикл
		УстановитьОтборПоПолю(Отбор.Ключ, Отбор.Значение);
	КонецЦикла;

	УстановитьОтборПоПолю("Сумма", ОтборСумма, ВидСравненияУсловия(ОтборСуммаУсловие));
	УстановитьОтборПоПолю("НомерКартинкиОплаты", КартинкиОплаты(),
		ВидСравненияКомпоновкиДанных.ВСписке);
	УстановитьОтборПоПолю("НомерКартинкиОтгрузки", КартинкиОтгрузки(),
		ВидСравненияКомпоновкиДанных.ВСписке);
	УстановитьОтборПоПолю("Долг", ОтборДолг, ВидСравненияУсловия(ОтборДолгУсловие));
	УстановитьОтборВидаОперации();
	НастроитьКомандыПроведения();

	ОтборыСписков.УстановитьОтборПоТовару(Список, ОтборТовар);

КонецПроцедуры

// Список заказов - только заказы-продажи (решение владельца 19.11, план orders-kp-goods-tab): тумблер вида операции
// стоит на «Продажа» и скрыт, заказы на производство ведутся своим списком. Общая команда «Заказы клиентов на
// производство» открывает список с фиксированным отбором: тумблер ставится на «Производство» и скрывается, отбор
// панели совпадает с фиксированным отбором команды. Колонка вида операции видна только при учёте производства.
//
&НаСервере
Процедура НастроитьВидОперации()

	ИспользоватьПроизводство = ПолучитьФункциональнуюОпцию("Производство");
	Элементы.ВидОперации.Видимость = ИспользоватьПроизводство;
	Элементы.ФильтрВидаОперации.Видимость = Ложь;
	ФильтрВидаОперации = ПозицияПродажа();
	СписокПродаж = Истина;

	Отбор = Неопределено;
	Если Параметры.Свойство("Отбор", Отбор)
		И (ТипЗнч(Отбор) = Тип("Структура") Или ТипЗнч(Отбор) = Тип("ФиксированнаяСтруктура")) Тогда
		ВидОперацииОтбора = Неопределено;
		Если Отбор.Свойство("ВидОперации", ВидОперацииОтбора)
			И ВидОперацииОтбора = Перечисления.ВидыОперацийЗаказаПокупателя.Производство Тогда
			ФильтрВидаОперации = ПозицияПроизводство();
			СписокПродаж = Ложь;
		КонецЕсли;
	КонецЕсли;

	// Без сброса автозаголовка платформа дописывает к заголовку представление списка.
	АвтоЗаголовок = Ложь;
	Если СписокПродаж Тогда
		Заголовок = НСтр("ru = 'Заказы клиентов'; fr = 'Commandes clients'; en = 'Customer orders'; es = 'Pedidos de clientes'");
	Иначе
		Заголовок = НСтр("ru = 'Заказы клиентов на производство'; fr = 'Commandes clients en production';
			|en = 'Customer production orders'; es = 'Pedidos de clientes para producción'");
	КонецЕсли;

КонецПроцедуры

// Проводится только заказ на производство (E6): команды проведения видны, когда список показывает
// только такие заказы - тумблер вида операции или фиксированный отбор общей команды «Заказы клиентов на
// производство». В списке с продажами команды скрыты, как до включения проведения.
//
&НаСервере
Процедура НастроитьКомандыПроведения()

	Видимость = ПолучитьФункциональнуюОпцию("Производство") И ФильтрВидаОперации = ПозицияПроизводство();
	Для Каждого ИмяЭлемента Из СтрРазделить("ФормаПровести,ФормаОтменаПроведения,"
		+ "СписокКонтекстноеМенюПровести,СписокКонтекстноеМенюОтменаПроведения", ",") Цикл
		Элементы[ИмяЭлемента].Видимость = Видимость;
	КонецЦикла;

КонецПроцедуры

// Отбор списка по тумблеру вида операции. «Продажа» - всё, что не производство: пустой вид
// операции у заказов, записанных в обход страховки ПередЗаписью, тоже считается продажей.
//
&НаСервере
Процедура УстановитьОтборВидаОперации()

	Поле = "ВидОперации";
	ВидПроизводство = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Если ФильтрВидаОперации = ПозицияПродажа() Тогда
		// Элемент отбора недоступен пользователю в настройках списка (план orders-kp-goods-tab, P1 круга 1).
		Документы.ЗаказПокупателя.УстановитьОтборСпискаПродаж(Список.Отбор);
	ИначеЕсли ФильтрВидаОперации = ПозицияПроизводство() Тогда
		УстановитьОтборПоПолю(Поле, ВидПроизводство);
	Иначе
		УстановитьОтборПоПолю(Поле, Неопределено);
	КонецЕсли;

КонецПроцедуры

// Позиция «Продажа» тумблера вида операции (список выбора в форме: 0 - все, 1 - продажа, 2 - производство).
//
// Возвращаемое значение:
//  Число
//
&НаСервере
Функция ПозицияПродажа()

	Возврат 1;

КонецФункции

// Позиция «Производство» тумблера вида операции.
//
// Возвращаемое значение:
//  Число
//
&НаКлиентеНаСервереБезКонтекста
Функция ПозицияПроизводство()

	// BSLLS:MagicNumber-off - значение объявлено списком выбора тумблера в форме.
	Возврат 2;
	// BSLLS:MagicNumber-on

КонецФункции

// Номера картинок оплаты, попадающие в позицию тумблера «Оплата»:
// 0 оплачен, 1 частично, 2 не оплачен, 6 просрочен.
// Состояние оплаты запрос списка выдаёт у каждой строки: раньше заказ без проведённой реализации
// получал -1, которого не ловит ни одна позиция, и три позиции из четырёх давали пустой список.
// Правило в запросе одно на все статусы, кроме двух, где состояние уже посчитано стадией заказа:
// «Выполнен» это 0, «ОжидаетОплаты» - 1 или 2 по ДоляОплаты регистра истории статусов.
// Кадр 6 «просрочен» запрос не выдаёт: сравнение СрокОплаты с текущей датой жило в ветках,
// сведённых к общему правилу, и писать его придётся заново (docs/TECHDEBT.md).
// Считается как «оплачено = отгружено - сальдо взаиморасчётов заказа» и сравнивается с базой
// Макс(сумма заказа, отгружено) - так же, как ПроизводственныеЗаказы.РассчитатьСтадию считает долю
// оплаты. До первой отгрузки отгружено равно нулю и сальдо это непогашенный аванс. Отгружено -
// сумма проведённых реализаций заказа за вычетом возвратов от покупателя: возврат уменьшает и
// сальдо, и начисление, иначе заказ без единой оплаты выглядел бы частично оплаченным.
// Сальдо собирается по документам заказа, а не по объекту расчётов, равному самому заказу:
// ПКО, введённый на основании заказа, пишет объект расчётов на себя и держит заказ в реквизите
// «Основание» (ПриходныйКассовыйОрдер.ОбработкаЗаполнения), а долг отгрузки после проведения
// налоговой накладной переезжает на накладную (ВзаиморасчётыСПокупателями.ДолгПоОтгрузкам) -
// накладная возвращается к заказу через строки ТЧТовары и ТЧУслуги.
// Безналичный аванс сюда не попадает - у ПоступлениеБезналичныхДенежныхСредств.Основание
// нет типа ЗаказПокупателя, привязать платёж к заказу нечем (docs/TECHDEBT.md).
// Пустой список - отбор снимается.
//
// Возвращаемое значение:
//  СписокЗначений
//
&НаСервере
Функция КартинкиОплаты()

	Номера = Новый СписокЗначений;
	Если ФильтрОплаты = 0 Тогда
		// Позиция «Все»: пустой список снимает отбор.
		Возврат Номера;
	КонецЕсли;

	// BSLLS:MagicNumber-off - номера кадров картинки заданы запросом динамического списка.
	Если ФильтрОплаты = 1 Тогда
		Номера.Добавить(2);
		Номера.Добавить(6);
	ИначеЕсли ФильтрОплаты = 2 Тогда
		Номера.Добавить(1);
	ИначеЕсли ФильтрОплаты = 3 Тогда
		Номера.Добавить(0);
	Иначе
		Номера.Очистить();
	КонецЕсли;
	// BSLLS:MagicNumber-on
	Возврат Номера;

КонецФункции

// Номера картинок отгрузки для позиции тумблера «Отгрузка»:
// 0 не отгружен, 1 в работе, 2 отгружен, 3 доставлен, 4 помечен на удаление.
//
// Возвращаемое значение:
//  СписокЗначений
//
&НаСервере
Функция КартинкиОтгрузки()

	Номера = Новый СписокЗначений;
	Если ФильтрОтгрузки = 0 Тогда
		// Позиция «Все»: пустой список снимает отбор.
		Возврат Номера;
	КонецЕсли;

	// BSLLS:MagicNumber-off - номера кадров картинки заданы запросом динамического списка.
	Если ФильтрОтгрузки = 1 Тогда
		Номера.Добавить(0);
	ИначеЕсли ФильтрОтгрузки = 2 Тогда
		Номера.Добавить(1);
	ИначеЕсли ФильтрОтгрузки = 3 Тогда
		Номера.Добавить(2);
	ИначеЕсли ФильтрОтгрузки = 4 Тогда
		Номера.Добавить(3);
	Иначе
		Номера.Очистить();
	КонецЕсли;
	// BSLLS:MagicNumber-on
	Возврат Номера;

КонецФункции

// Вид сравнения отбора по позиции тумблера знака.
//
// Параметры:
//  Позиция - Число - 0 - больше, 1 - меньше, 2 - равно
//
// Возвращаемое значение:
//  ВидСравненияКомпоновкиДанных
//
&НаСервере
Функция ВидСравненияУсловия(Позиция)

	// BSLLS:MagicNumber-off - значения объявлены списком выбора тумблера знака.
	Если Позиция = 1 Тогда
		Возврат ВидСравненияКомпоновкиДанных.Меньше;
	ИначеЕсли Позиция = 2 Тогда
		Возврат ВидСравненияКомпоновкиДанных.Равно;
	Иначе
		Возврат ВидСравненияКомпоновкиДанных.Больше;
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецФункции

// Один программный элемент отбора списка: значение пусто - элемент снимается.
// Список значений отбирается видом сравнения «В списке».
//
// Параметры:
//  Поле         - Строка       - имя поля динамического списка
//  Значение     - Произвольный - отбираемое значение или СписокЗначений
//  ВидСравнения - ВидСравненияКомпоновкиДанных, Неопределено - вид сравнения;
//                 не задан - «Равно» («В списке» для списка значений)
//
&НаСервере
Процедура УстановитьОтборПоПолю(Поле, Значение, ВидСравнения = Неопределено)

	// Общий модуль: элемент поля - в группе «Панель», пустое значение снимает отбор (docs/plans/nomenclature-ui.md, P2-3).
	ОтборыСписков.УстановитьОтборЕслиЗаполнено(Список.Отбор, ОтборыСписков.ГруппаПанель(), Поле, Значение, ВидСравнения);

КонецПроцедуры

// Правая панель: сведения о документе текущей строки и его состав.
//
// Параметры:
//  Ссылка - ДокументСсылка.ЗаказПокупателя - текущая строка списка
//
&НаСервере
Процедура ЗаполнитьСведения(Знач Ссылка)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Док.Контрагент КАК Контрагент,
		|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
		|	Контрагенты.ВидКонтрагента КАК ВидКонтрагента,
		|	Контрагенты.Категория КАК Категория,
		|	Контрагенты.РодДеятельности КАК РодДеятельности,
		|	Контрагенты.NIF КАК NIF,
		|	Контрагенты.RC КАК RC,
		|	Контрагенты.ICE КАК ICE,
		|	Контрагенты.CIN КАК CIN,
		|	Контрагенты.ТипОплаты КАК ТипОплаты,
		|	Контрагенты.УсловияОплаты КАК УсловияОплаты,
		|	Контрагенты.СрокОплаты КАК СрокОплаты,
		|	Контрагенты.ТипЦены КАК ТипЦены,
		|	ЕСТЬNULL(Контрагенты.КонтрольКредита, ЛОЖЬ) КАК КонтрольКредита,
		|	Контрагенты.СуммаКредита КАК СуммаКредита,
		|	ЕСТЬNULL(Контрагенты.ЗапретОтгрузок, ЛОЖЬ) КАК ЗапретОтгрузок,
		|	Док.Организация КАК Организация,
		|	Док.Ответственный КАК Ответственный,
		|	Док.Менеджер КАК Менеджер,
		|	Док.ДатаОтгрузки КАК ДатаОтгрузки,
		|	Док.Договор КАК Договор,
		|	Док.Комментарий КАК Комментарий,
		|	Док.Сумма КАК Сумма
		|ИЗ
		|	Документ.ЗаказПокупателя КАК Док
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО Контрагенты.Ссылка = Док.Контрагент
		|ГДЕ
		|	Док.Ссылка = &Ссылка
		|;
		|ВЫБРАТЬ
		|	Реквизиты.Реквизит КАК Реквизит,
		|	Реквизиты.Представление КАК Представление
		|ИЗ
		|	Документ.ЗаказПокупателя КАК Док
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыКонтрагентов КАК Реквизиты
		|		ПО Реквизиты.Контрагент = Док.Контрагент
		|ГДЕ
		|	Док.Ссылка = &Ссылка
		|;
		|ВЫБРАТЬ
		|	СУММА(Остатки.СуммаОстаток) КАК Долг
		|ИЗ
		|	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(
		|		,
		|		Контрагент В
		|			(ВЫБРАТЬ
		|				Док.Контрагент КАК Контрагент
		|			ИЗ
		|				Документ.ЗаказПокупателя КАК Док
		|			ГДЕ
		|				Док.Ссылка = &Ссылка)) КАК Остатки
		|;
		|ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	СУММА(Товары.Количество) КАК Количество,
		|	СУММА(Товары.СуммаСНДС) КАК Сумма
		|ИЗ
		|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	Товары.Номенклатура");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результаты = Запрос.ВыполнитьПакет();

	Шапка = Результаты[0].Выбрать();
	Если Не Шапка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	ФорматСуммы = "ЧДЦ=2; ЧРГ=' '";

	// Страница «Клиент»: карточка контрагента, контакты и общий долг.
	Долг = 0;
	Долги = Результаты[2].Выбрать();
	Если Долги.Следующий() И ЗначениеЗаполнено(Долги.Долг) Тогда
		Долг = Долги.Долг;
	КонецЕсли;
	КлиентТекст = ТекстКлиента(Шапка, Результаты[1].Выбрать(), Долг);

	// Страница «Детали»: реквизиты документа, не выведенные колонками списка.
	Строки = Новый Массив;
	ДанныеСтадии = ПроизводственныеЗаказы.ДанныеСтадии(Ссылка);
	Если ДанныеСтадии <> Неопределено И ДанныеСтадии.ЭтоЗаписьСтадии Тогда
		Шаблон = НСтр("ru = 'Стадия: %1  %2'; fr = 'Étape : %1  %2'; en = 'Stage: %1  %2'; es = 'Etapa: %1  %2'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(ДанныеСтадии.Стадия), ДанныеСтадии.Индикатор));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Организация) Тогда
		Шаблон = НСтр("ru = 'Наша компания: %1'; fr = 'Notre société: %1'; en = 'Our company: %1'; es = 'Nuestra empresa: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.Организация)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Ответственный) Тогда
		Шаблон = НСтр("ru = 'Ответственный: %1'; fr = 'Responsable: %1'; en = 'Responsible: %1'; es = 'Responsable: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.Ответственный)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Менеджер) Тогда
		Шаблон = НСтр("ru = 'Менеджер: %1'; fr = 'Manager: %1'; en = 'Manager: %1'; es = 'Gerente: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.Менеджер)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.ДатаОтгрузки) Тогда
		Шаблон = НСтр("ru = 'Дата отгрузки: %1'; fr = 'Date d''expédition: %1'; en = 'Shipment date: %1'; es = 'Fecha de expedición: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.ДатаОтгрузки)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Договор) Тогда
		Шаблон = НСтр("ru = 'Договор: %1'; fr = 'Contrat: %1'; en = 'Contract: %1'; es = 'Contrato: %1'");
		Строки.Добавить(СтрШаблон(Шаблон, Строка(Шапка.Договор)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.Комментарий) Тогда
		Строки.Добавить("");
		Строки.Добавить(Шапка.Комментарий);
	КонецЕсли;
	Строки.Добавить("");
	ШаблонСуммы = НСтр("ru = 'Сумма: %1'; fr = 'Montant : %1'; en = 'Amount: %1'; es = 'Importe: %1'");
	СуммаСтрокой = Формат(Шапка.Сумма, ФорматСуммы);
	Строки.Добавить(СтрШаблон(ШаблонСуммы, СуммаСтрокой));
	ИнфоТекст = СтрСоединить(Строки, Символы.ПС);

	ТаблицаСостав.Очистить();
	Состав = Результаты[3].Выбрать();
	Пока Состав.Следующий() Цикл
		Строка = ТаблицаСостав.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Состав);
	КонецЦикла;

КонецПроцедуры

// Карточка контрагента для страницы «Клиент»: наименование, классификация,
// налоговые реквизиты, условия работы, контакты и общий долг.
//
// Параметры:
//  Шапка    - ВыборкаИзРезультатаЗапроса - строка запроса по документу и контрагенту
//  Контакты - ВыборкаИзРезультатаЗапроса - реквизиты контрагента из регистра
//  Долг     - Число - остаток взаиморасчётов; 0 - не показывается
//
// Возвращаемое значение:
//  Строка - многострочный текст панели
//
&НаСервереБезКонтекста
Функция ТекстКлиента(Шапка, Контакты, Знач Долг = 0)

	Строки = Новый Массив;
	Строки.Добавить(Строка(Шапка.Контрагент));
	Если ЗначениеЗаполнено(Шапка.НаименованиеПолное) Тогда
		Строки.Добавить(Шапка.НаименованиеПолное);
	КонецЕсли;
	ДобавитьСтрокуСведений(Строки, НСтр("ru = 'Вид'; fr = 'Type'; en = 'Kind'; es = 'Tipo'"),
		Шапка.ВидКонтрагента);
	ДобавитьСтрокуСведений(Строки,
		НСтр("ru = 'Категория'; fr = 'Catégorie'; en = 'Category'; es = 'Categoría'"), Шапка.Категория);
	ДобавитьСтрокуСведений(Строки,
		НСтр("ru = 'Род деятельности'; fr = 'Activité'; en = 'Line of business'; es = 'Actividad'"),
		Шапка.РодДеятельности);

	ДобавитьБлокСтрок(Строки, НалоговыеРеквизитыКонтрагента(Шапка));
	ДобавитьБлокСтрок(Строки, УсловияРаботыСКонтрагентом(Шапка));
	ДобавитьБлокСтрок(Строки, КонтактыКонтрагента(Контакты));

	Если ЗначениеЗаполнено(Долг) Тогда
		ШаблонДолга = НСтр("ru = 'Долг всего: %1'; fr = 'Dette totale : %1';
			|en = 'Total debt: %1'; es = 'Deuda total: %1'");
		Итог = Новый Массив;
		Итог.Добавить(СтрШаблон(ШаблонДолга, Формат(Долг, "ЧДЦ=2; ЧРГ=' '")));
		ДобавитьБлокСтрок(Строки, Итог);
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Налоговые и регистрационные номера карточки одной строкой.
//
// Параметры:
//  Шапка - ВыборкаИзРезультатаЗапроса - строка запроса по контрагенту
//
// Возвращаемое значение:
//  Массив из Строка - пустой, если номера не заполнены
//
&НаСервереБезКонтекста
Функция НалоговыеРеквизитыКонтрагента(Шапка)

	Номера = Новый Массив;
	Для Каждого ИмяРеквизита Из СтрРазделить("NIF,RC,ICE,CIN", ",") Цикл
		Если ЗначениеЗаполнено(Шапка[ИмяРеквизита]) Тогда
			Номера.Добавить(ИмяРеквизита + ": " + Строка(Шапка[ИмяРеквизита]));
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Если Номера.Количество() > 0 Тогда
		Результат.Добавить(СтрСоединить(Номера, "   "));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Условия работы с контрагентом: оплата, цены, кредитный контроль.
//
// Параметры:
//  Шапка - ВыборкаИзРезультатаЗапроса - строка запроса по контрагенту
//
// Возвращаемое значение:
//  Массив из Строка - заполненные условия
//
&НаСервереБезКонтекста
Функция УсловияРаботыСКонтрагентом(Шапка)

	Условия = Новый Массив;
	ДобавитьСтрокуСведений(Условия,
		НСтр("ru = 'Тип оплаты'; fr = 'Mode de paiement'; en = 'Payment type'; es = 'Tipo de pago'"),
		Шапка.ТипОплаты);
	ДобавитьСтрокуСведений(Условия,
		НСтр("ru = 'Условия оплаты'; fr = 'Conditions de paiement';
			|en = 'Payment terms'; es = 'Condiciones de pago'"), Шапка.УсловияОплаты);
	ДобавитьСтрокуСведений(Условия,
		НСтр("ru = 'Отсрочка, дней'; fr = 'Délai, jours'; en = 'Deferral, days'; es = 'Aplazamiento, días'"),
		Шапка.СрокОплаты);
	ДобавитьСтрокуСведений(Условия,
		НСтр("ru = 'Тип цены'; fr = 'Type de prix'; en = 'Price type'; es = 'Tipo de precio'"), Шапка.ТипЦены);
	Если Шапка.КонтрольКредита Тогда
		ДобавитьСтрокуСведений(Условия,
			НСтр("ru = 'Кредитный лимит'; fr = 'Limite de crédit';
				|en = 'Credit limit'; es = 'Límite de crédito'"), Шапка.СуммаКредита);
	КонецЕсли;
	Если Шапка.ЗапретОтгрузок Тогда
		Условия.Добавить(НСтр("ru = 'Отгрузки запрещены'; fr = 'Expéditions interdites';
			|en = 'Shipments blocked'; es = 'Expediciones bloqueadas'"));
	КонецЕсли;
	Возврат Условия;

КонецФункции

// Контактные данные контрагента из регистра реквизитов.
//
// Параметры:
//  Контакты - ВыборкаИзРезультатаЗапроса - реквизиты контрагента
//
// Возвращаемое значение:
//  Массив из Строка - строки «реквизит: значение»
//
&НаСервереБезКонтекста
Функция КонтактыКонтрагента(Контакты)

	Строки = Новый Массив;
	Пока Контакты.Следующий() Цикл
		Строки.Добавить(Строка(Контакты.Реквизит) + ": " + Контакты.Представление);
	КонецЦикла;
	Возврат Строки;

КонецФункции

// Добавляет блок строк, отделяя его от предыдущего пустой строкой.
//
// Параметры:
//  Строки - Массив из Строка - накопитель строк панели
//  Блок   - Массив из Строка - добавляемые строки; пустой блок пропускается
//
&НаСервереБезКонтекста
Процедура ДобавитьБлокСтрок(Строки, Блок)

	Если Блок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Строки.Добавить("");
	Для Каждого Строка Из Блок Цикл
		Строки.Добавить(Строка);
	КонецЦикла;

КонецПроцедуры

// Добавляет строку «подпись: значение», если значение заполнено.
//
// Параметры:
//  Строки   - Массив из Строка - накопитель строк
//  Подпись  - Строка           - подпись показателя
//  Значение - Произвольный     - значение; пустое не выводится
//
&НаСервереБезКонтекста
Процедура ДобавитьСтрокуСведений(Строки, Подпись, Значение)

	Если ЗначениеЗаполнено(Значение) Тогда
		Строки.Добавить(Подпись + ": " + Строка(Значение));
	КонецЕсли;

КонецПроцедуры

#Область ЗакладкаТовары

// Закладка «Товары» (план docs/plans/orders-kp-goods-tab.md, тикет 2605528): только в списке заказов-продаж и не у
// внешних ролей; права ввода, цена по заверению цен, характеристики по опции, связь характеристики с товаром,
// меню «Печать».
&НаСервере
Процедура НастроитьЗакладкуТовары()

	Доступна = ФильтрВидаОперации = ПозицияПродажа() И СтрокиТоваровСписков.ЗакладкаДоступна(ИмяДокумента());
	Элементы.СтраницаТовары.Видимость = Доступна;
	Если Не Доступна Тогда
		Возврат;
	КонецЕсли;
	МожноВводитьТовары = Документы.ЗаказПокупателя.МожноВводитьСтрокиТоваров();
	ЗаверениеЦенТоваров = РегистрыСведений.НастройкиПользователей.ЗаверениеЦен();
	Элементы.Товары.ТолькоПросмотр = Не МожноВводитьТовары;
	Элементы.ТоварыЦена.ТолькоПросмотр = Не ЗаверениеЦенТоваров;
	// Цены и суммы скрыты от роли, которой их не показывают формы документов и печать.
	ЦеныВидны = Не ФирменнаяПечать.ЦеныСкрыты();
	Элементы.ТоварыЦена.Видимость = ЦеныВидны;
	Элементы.ТоварыСумма.Видимость = ЦеныВидны;
	Элементы.ТоварыХарактеристика.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	Связи = Новый Массив;
	Связи.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", "Элементы.Товары.ТекущиеДанные.Номенклатура"));
	Элементы.ТоварыХарактеристика.СвязиПараметровВыбора = Новый ФиксированныйМассив(Связи);
	РазместитьКомандыПечатиТоваров();

КонецПроцедуры

// Меню «Печать» таблицы - печатные формы заказа, доступные пользователю (как у закладки «Товары» реализаций).
// Несколько форм - подменю, одна - кнопка.
&НаСервере
Процедура РазместитьКомандыПечатиТоваров()

	ЗаголовокПечать = НСтр("ru = 'Печать'; fr = 'Impression'; en = 'Print'; es = 'Impresión'");
	КомандыПечати = ПечатныеФормы.ДоступныеКомандыПечатиОбъекта(ПолноеИмяДокумента());
	Если КомандыПечати.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ОднаФорма = КомандыПечати.Количество() = 1;
	Родитель = Элементы.Товары.КоманднаяПанель;
	Если Не ОднаФорма Тогда
		Родитель = Элементы.Добавить("ТоварыПодменюПечать", Тип("ГруппаФормы"), Родитель);
		Родитель.Вид = ВидГруппыФормы.Подменю;
		Родитель.Заголовок = ЗаголовокПечать;
		Родитель.Картинка = БиблиотекаКартинок.Печать;
	КонецЕсли;
	Для Каждого КомандаПечати Из КомандыПечати Цикл
		ИмяКоманды = "ТоварыПечать" + Формат(КомандыПечатиТоваров.Количество(), "ЧН=0; ЧГ=0");
		КомандыПечатиТоваров.Добавить(КомандаПечати.ИмяМакета, ИмяКоманды);
		Команда = Команды.Добавить(ИмяКоманды);
		Команда.Действие = "Подключаемый_ПечатьТоваров";
		Команда.Заголовок = КомандаПечати.Представление;
		Если ОднаФорма Тогда
			Команда.Заголовок = ЗаголовокПечать;
			Команда.Подсказка = КомандаПечати.Представление;
			Команда.Картинка = БиблиотекаКартинок.Печать;
			Команда.Отображение = ОтображениеКнопки.КартинкаИТекст;
		КонецЕсли;
		Кнопка = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Родитель);
		Кнопка.ИмяКоманды = ИмяКоманды;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИмяДокумента()

	Возврат "ЗаказПокупателя";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолноеИмяДокумента()

	Возврат "Документ." + ИмяДокумента();

КонецФункции

// Отборы закладки - реквизиты шапки с правой панели (вычисляемые отборы оплаты, отгрузки и долга не действуют).
//
// Возвращаемое значение:
//  Структура - см. Документы.ЗаказПокупателя.НовыеОтборыСтрокТоваров.
//
&НаСервере
Функция ОтборыТоваров()

	Отборы = Документы.ЗаказПокупателя.НовыеОтборыСтрокТоваров();
	Отборы.Контрагент = ОтборКонтрагент;
	Отборы.Организация = ОтборОрганизация;
	Отборы.Ответственный = ОтборОтветственный;
	Отборы.Товар = ОтборТовар;
	Отборы.Сумма = ОтборСумма;
	Отборы.СуммаУсловие = ОтборСуммаУсловие;
	Возврат Отборы;

КонецФункции

// Отборы панели изменились: открытая закладка «Товары» перечитывается сразу, закрытая - при переходе на неё.
&НаСервере
Процедура ОбновитьТоварыПослеОтбора()

	Если Не Элементы.СтраницаТовары.Видимость Тогда
		Возврат;
	КонецЕсли;
	Если Элементы.ГруппаСтраницыДокументов.ТекущаяСтраница = Элементы.СтраницаТовары Тогда
		ЗагрузитьТоварыНаСервере();
	Иначе
		ТоварыЗагружены = Ложь;
	КонецЕсли;

КонецПроцедуры

// Единственный вход загрузки таблицы: первым шагом - назначенные записи строк (до чтения, чтобы новый заказ попал в
// таблицу). Незаписанные правки (Изменена) и новые строки переживают любое перечитывание - смену отборов и предел
// документов тоже: они возвращаются наверх, одноимённые строки базы отбрасываются.
//
// Параметры:
//  ТекущийДокумент - ДокументСсылка.ЗаказПокупателя, Неопределено - документ под курсором после загрузки.
//  НомерСтроки     - Число - строка документа под курсором; 0 - первая строка документа.
//  СброситьПравки  - Булево - незаписанные правки и новые строки отбрасываются («Обновить» с согласия пользователя).
//
&НаСервере
Процедура ЗагрузитьТоварыНаСервере(Знач ТекущийДокумент = Неопределено, Знач НомерСтроки = 0, Знач СброситьПравки = Ложь)

	Если СброситьПравки Тогда
		// Отмена правок: очередь не записывается.
		СтрокиТоваровКЗаписи.Очистить();
		Записи = Новый Структура(ПоляКурсора() + ", Отказ", Неопределено, 0, Ложь);
	Иначе
		Записи = ВыполнитьНазначенныеЗаписи(Неопределено);
	КонецЕсли;
	Курсор = КурсорТоваров(ТекущийДокумент, НомерСтроки, Записи);
	Сохраненные = Новый Массив;
	КлючиСохраненных = Новый Соответствие;
	Если Не СброситьПравки Тогда
		СохранитьНезаписанныеСтроки(Сохраненные, КлючиСохраненных);
	КонецЕсли;
	Товары.Очистить();
	СтрокиТоваровКЗаписи.Очистить();
	Для Каждого Сохраненная Из Сохраненные Цикл
		ЗаполнитьЗначенияСвойств(Товары.Добавить(), Сохраненная);
	КонецЦикла;
	Данные = Документы.ЗаказПокупателя.СтрокиТоваровСписка(ОтборыТоваров());
	Для Каждого СтрокаДанных Из Данные.Строки Цикл
		Если КлючиСохраненных[КлючСтрокиТоваров(СтрокаДанных.Документ, СтрокаДанных.НомерСтроки)] = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Товары.Добавить(), СтрокаДанных);
		КонецЕсли;
	КонецЦикла;
	Элементы.НадписьТоварыОбрезано.Видимость = Данные.Обрезано;
	Если Данные.Обрезано Тогда
		Шаблон = НСтр("ru = 'Показаны строки последних %1 заказов: уточните отборы на панели справа.';
			|fr = 'Lignes des %1 dernières commandes affichées : précisez les filtres du panneau de droite.';
			|en = 'Lines of the last %1 orders are shown: narrow the filters on the right panel.';
			|es = 'Se muestran las líneas de los últimos %1 pedidos: precise los filtros del panel derecho.'");
		Элементы.НадписьТоварыОбрезано.Заголовок = СтрШаблон(Шаблон, Данные.Предел);
	КонецЕсли;
	// Отборы оплаты, отгрузки и долга считает запрос динамического списка: на закладку они не действуют.
	Элементы.НадписьТоварыОтборыНеДействуют.Видимость = ФильтрОплаты <> 0 Или ФильтрОтгрузки <> 0
		Или ЗначениеЗаполнено(ОтборДолг);
	СортировкаТаблицФормы.ПрименитьПорядок(ЭтотОбъект, Элементы.Товары.Имя, Новый Структура("НомерСтроки", 0));
	ТоварыЗагружены = Истина;
	УстановитьКурсорТоваров(Курсор);

КонецПроцедуры

// Незаписанные правки и новые строки - до очистки таблицы.
//
// Параметры:
//  Сохраненные      - Массив из Структура - пополняется значениями строк.
//  КлючиСохраненных - Соответствие из КлючИЗначение - ключи записанных строк с правками (КлючСтрокиТоваров).
//
&НаСервере
Процедура СохранитьНезаписанныеСтроки(Сохраненные, КлючиСохраненных)

	Для Каждого СтрокаТаблицы Из Товары Цикл
		Если Не СтрокаТаблицы.Изменена И СтрокаТаблицы.НомерСтроки <> 0 Тогда
			Продолжить;
		КонецЕсли;
		Сохраненная = СтрокиТоваровСписков.НоваяСтрокаТоваровСписка();
		Сохраненная.Вставить("ЦенаИзменена");
		Сохраненная.Вставить("Изменена");
		ЗаполнитьЗначенияСвойств(Сохраненная, СтрокаТаблицы);
		Сохраненные.Добавить(Сохраненная);
		Если СтрокаТаблицы.НомерСтроки <> 0 Тогда
			КлючиСохраненных.Вставить(КлючСтрокиТоваров(СтрокаТаблицы.Документ, СтрокаТаблицы.НомерСтроки), Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьКурсорТоваров(Курсор)

	Если Курсор.Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Найденные = Товары.НайтиСтроки(Новый Структура(ПоляКурсора(), Курсор.Документ, Курсор.НомерСтроки));
	Если Найденные.Количество() = 0 Тогда
		Найденные = Товары.НайтиСтроки(Новый Структура("Документ", Курсор.Документ));
	КонецЕсли;
	Если Найденные.Количество() > 0 Тогда
		Элементы.Товары.ТекущаяСтрока = Найденные[0].ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция КлючСтрокиТоваров(Документ, НомерСтроки)

	Возврат Строка(Документ.УникальныйИдентификатор()) + "/" + Формат(НомерСтроки, "ЧН=0; ЧГ=0");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПоляКурсора()

	Возврат "Документ, НомерСтроки";

КонецФункции

// Курсор загрузки: заданный вызывающим, иначе записанная строка очереди, иначе прежняя записанная строка.
//
// Параметры:
//  ТекущийДокумент - ДокументСсылка.ЗаказПокупателя, Неопределено - документ, заданный вызывающим.
//  НомерСтроки     - Число - строка, заданная вызывающим.
//  Записи          - Структура - см. ВыполнитьНазначенныеЗаписи.
//
// Возвращаемое значение:
//  Структура - Документ (ДокументСсылка, Неопределено), НомерСтроки (Число).
//
&НаСервере
Функция КурсорТоваров(ТекущийДокумент, НомерСтроки, Записи)

	Курсор = Новый Структура(ПоляКурсора(), ТекущийДокумент, НомерСтроки);
	Если Курсор.Документ <> Неопределено Тогда
		Возврат Курсор;
	КонецЕсли;
	Если Записи.Документ <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Курсор, Записи, ПоляКурсора());
		Возврат Курсор;
	КонецЕсли;
	Если Элементы.Товары.ТекущаяСтрока <> Неопределено Тогда
		СтрокаТаблицы = Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
		Если СтрокаТаблицы <> Неопределено И СтрокаТаблицы.НомерСтроки <> 0 Тогда
			ЗаполнитьЗначенияСвойств(Курсор, СтрокаТаблицы, ПоляКурсора());
		КонецЕсли;
	КонецЕсли;
	Возврат Курсор;

КонецФункции

// Назначенные записи пакетами по документу: правки строк одного записанного заказа - одним вызовом вместе с его
// прежними незаписанными правками; новая строка без документа - своим вызовом. Удача - строки пакета уходят из
// таблицы (их место займут строки базы); отказ - правки остаются с признаком Изменена; конфликт версии (заказ изменил
// другой пользователь) - записанные строки пакета возвращаются к базе.
//
// Параметры:
//  ТолькоДокументы - Массив из ДокументСсылка.ЗаказПокупателя, Неопределено - дополнительно записать все незаписанные
//                    правки этих заказов (печать и закрытие); Неопределено - только очередь.
//
// Возвращаемое значение:
//  Структура:
//   * Документ    - ДокументСсылка.ЗаказПокупателя, Неопределено - документ последней записанной строки.
//   * НомерСтроки - Число - её номер строки.
//   * Отказ       - Булево - хоть один пакет не записан.
//   * Конфликты   - Массив из ДокументСсылка.ЗаказПокупателя - заказы, изменённые другим пользователем: их правки
//                   вернулись к базе, печать и закрытие на них останавливаются (ревью кода 2.0.17.40, P1).
//   * Потеряно    - Число - записанные строки, правки которых вернулись к базе из-за конфликта.
//
&НаСервере
Функция ВыполнитьНазначенныеЗаписи(ТолькоДокументы)

	Итог = Новый Структура(ПоляКурсора(), Неопределено, 0);
	Итог.Вставить("Отказ", Ложь);
	Итог.Вставить("Конфликты", Новый Массив);
	Итог.Вставить("Потеряно", 0);
	Пакеты = ПакетыЗаписиТоваров(ТолькоДокументы);
	СтрокиТоваровКЗаписи.Очистить();
	ЕстьЗаписанные = Ложь;
	Для Каждого Пакет Из Пакеты Цикл
		Строки = Новый Массив;
		Для Каждого СтрокаТаблицы Из Пакет Цикл
			Строки.Добавить(ДанныеСтрокиТоваров(СтрокаТаблицы));
		КонецЦикла;
		Результат = Документы.ЗаказПокупателя.ЗаписатьСтрокиТоваров(Строки);
		СообщитьРезультат(Результат.Текст);
		Если Результат.Успех Тогда
			ЕстьЗаписанные = Истина;
			Итог.Документ = Результат.Документ;
			Итог.НомерСтроки = Результат.НомерСтроки;
			Для Каждого СтрокаТаблицы Из Пакет Цикл
				Товары.Удалить(СтрокаТаблицы);
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Итог.Отказ = Истина;
		Если Результат.Конфликт Тогда
			УчестьКонфликтПакета(Итог, Пакет);
		КонецЕсли;
		ОтметитьОтказПакета(Пакет, Результат.Конфликт);
	КонецЦикла;
	Если ЕстьЗаписанные Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Конфликт версии пакета: документ - в список конфликтов, записанные строки пакета - в число потерянных правок.
//
// Параметры:
//  Итог  - Структура - см. ВыполнитьНазначенныеЗаписи.
//  Пакет - Массив из ДанныеФормыЭлементКоллекции - строки пакета.
//
&НаСервере
Процедура УчестьКонфликтПакета(Итог, Пакет)

	ДокументПакета = Пакет[0].Документ;
	Если ЗначениеЗаполнено(ДокументПакета) Тогда
		ДобавитьБезПовтора(Итог.Конфликты, ДокументПакета);
	КонецЕсли;
	Для Каждого СтрокаТаблицы Из Пакет Цикл
		Если СтрокаТаблицы.НомерСтроки <> 0 Тогда
			Итог.Потеряно = Итог.Потеряно + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Отказ пакета: правки остаются с признаком Изменена; конфликт версии - записанные строки возвращаются к базе.
//
// Параметры:
//  Пакет    - Массив из ДанныеФормыЭлементКоллекции - строки пакета.
//  Конфликт - Булево - заказ изменил другой пользователь.
//
&НаСервере
Процедура ОтметитьОтказПакета(Пакет, Конфликт)

	Для Каждого СтрокаТаблицы Из Пакет Цикл
		Если Конфликт И СтрокаТаблицы.НомерСтроки <> 0 Тогда
			Товары.Удалить(СтрокаТаблицы);
		Иначе
			СтрокаТаблицы.Изменена = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Пакеты записи: строки очереди и незаписанные правки заказов очереди (и заказов ТолькоДокументы).
//
// Параметры:
//  ТолькоДокументы - Массив из ДокументСсылка.ЗаказПокупателя, Неопределено - см. ВыполнитьНазначенныеЗаписи.
//
// Возвращаемое значение:
//  Массив из Массив из ДанныеФормыЭлементКоллекции - строки таблицы по пакетам.
//
&НаСервере
Функция ПакетыЗаписиТоваров(ТолькоДокументы)

	Пакеты = Новый Массив;
	ДокументыПакетов = Новый Массив;
	Если ТолькоДокументы <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументыПакетов, ТолькоДокументы, Истина);
	КонецЕсли;
	Для Каждого Элемент Из СтрокиТоваровКЗаписи Цикл
		СтрокаТаблицы = Товары.НайтиПоИдентификатору(Элемент.Значение);
		Если СтрокаТаблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
			// Правка записанной строки и новая строка в записанный заказ - в пакет заказа.
			ДобавитьБезПовтора(ДокументыПакетов, СтрокаТаблицы.Документ);
		Иначе
			Пакеты.Добавить(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаТаблицы));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Документ Из ДокументыПакетов Цикл
		Пакет = Новый Массив;
		Для Каждого СтрокаТаблицы Из Товары.НайтиСтроки(Новый Структура("Документ, Изменена", Документ, Истина)) Цикл
			Пакет.Добавить(СтрокаТаблицы);
		КонецЦикла;
		Если Пакет.Количество() > 0 Тогда
			Пакеты.Добавить(Пакет);
		КонецЕсли;
	КонецЦикла;
	Возврат Пакеты;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьБезПовтора(Массив, Значение)

	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - строка таблицы «Товары».
//
// Возвращаемое значение:
//  Структура - см. СтрокиТоваровСписков.ЗаписатьСтроки.
//
&НаСервере
Функция ДанныеСтрокиТоваров(СтрокаТаблицы)

	Строка = Новый Структура("Документ, НомерСтроки, ВерсияДанных, Клиент, Организация, Номенклатура, Характеристика,
		|Упаковка, КоличествоУпаковок, Цена, ЦенаИзменена, Валюта");
	ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
	Если Не ЗначениеЗаполнено(Строка.Документ) Тогда
		Строка.Документ = Неопределено;
	КонецЕсли;
	Возврат Строка;

КонецФункции

&НаСервере
Процедура УдалитьСтрокиТоваровНаСервере(Знач Строки)

	Результат = Документы.ЗаказПокупателя.УдалитьСтрокиТоваров(Строки);
	СообщитьРезультат(Результат.Текст);
	Элементы.Список.Обновить();
	ЗагрузитьТоварыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУдаленииТоваров(Ответ, Строки) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		УдалитьСтрокиТоваровНаСервере(Строки);
	КонецЕсли;

КонецПроцедуры

// Очередь пуста или идёт ввод другой строки - ничего: таблица под вводом не перечитывается, очередь запишет
// обработчик, назначенный окончанием этого ввода.
&НаКлиенте
Процедура ЗаписатьСтрокиТоваровОжидание() Экспорт

	Если СтрокиТоваровКЗаписи.Количество() = 0 Или СтрокаВводится Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьТоварыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура НачатьВводВставленнойСтрокиТоваров() Экспорт

	Если ВставленнаяСтрокаТоваров <> Неопределено И Элементы.Товары.ТекущаяСтрока = ВставленнаяСтрокаТоваров Тогда
		Элементы.Товары.ИзменитьСтроку();
	КонецЕсли;

КонецПроцедуры

// Новая строка: документ - новый заказ; клиент - из отбора или ближайшей строки, организация - из отбора или по
// умолчанию; копия - в заказ исходной строки (кроме строки только для просмотра) с её товаром, без цены.
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - новая строка.
//  Исходная      - Структура, Неопределено - значения копируемой строки.
//
&НаКлиенте
Процедура ПодготовитьНовуюСтрокуТоваров(СтрокаТаблицы, Исходная)

	СтрокаТаблицы.НомерСтроки = 0;
	СтрокаТаблицы.ВерсияДанных = "";
	СтрокаТаблицы.Цена = 0;
	СтрокаТаблицы.ЦенаИзменена = Ложь;
	СтрокаТаблицы.Сумма = 0;
	СтрокаТаблицы.Картинка = -1; // новая строка без картинки состояния
	СтрокаТаблицы.ТолькоПросмотр = Ложь;
	СтрокаТаблицы.Изменена = Ложь;
	Если Исходная <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Исходная, "Клиент, Организация, Номенклатура, Характеристика, Упаковка");
		Если Не Исходная.ТолькоПросмотр И ЗначениеЗаполнено(Исходная.Документ) Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Исходная, "Документ, ДокументПредставление, Валюта");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	СтрокаТаблицы.Документ = Неопределено;
	СтрокаТаблицы.ДокументПредставление = ПредставлениеНовогоЗаказа();
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Клиент) Тогда
		СтрокаТаблицы.Клиент = КлиентНовойСтроки(СтрокаТаблицы);
	КонецЕсли;
	Организация = ?(ЗначениеЗаполнено(СтрокаТаблицы.Организация), СтрокаТаблицы.Организация, ОтборОрганизация);
	Значения = ЗначенияНовойСтрокиТоваров(СтрокаТаблицы.Клиент, Организация);
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Значения);

КонецПроцедуры

// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - новая строка.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты - клиент отбора панели, иначе клиент ближайшей строки (свежий заказ).
//
&НаКлиенте
Функция КлиентНовойСтроки(СтрокаТаблицы)

	Если ЗначениеЗаполнено(ОтборКонтрагент) Тогда
		Возврат ОтборКонтрагент;
	КонецЕсли;
	Для Каждого Соседняя Из Товары Цикл
		Если Соседняя <> СтрокаТаблицы И ЗначениеЗаполнено(Соседняя.Клиент) Тогда
			Возврат Соседняя.Клиент;
		КонецЕсли;
	КонецЦикла;
	Возврат ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");

КонецФункции

// Вставленная строка, в которую ещё ничего не ввели, уходит перед вставкой следующей.
&НаКлиенте
Процедура УдалитьВставленнуюСтрокуТоваров()

	Если ВставленнаяСтрокаТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Товары.НайтиПоИдентификатору(ВставленнаяСтрокаТоваров);
	ВставленнаяСтрокаТоваров = Неопределено;
	Если СтрокаТаблицы <> Неопределено И СтрокаТаблицы.НомерСтроки = 0 И Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
		Товары.Удалить(СтрокаТаблицы);
	КонецЕсли;

КонецПроцедуры

// Клиент или организация новой строки сменились: документ - снова новый заказ, валюта - договора клиента, ручная цена
// сбрасывается.
&НаКлиенте
Процедура СброситьДокументНовойСтроки()

	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.НомерСтроки <> 0 Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Документ = Неопределено;
	СтрокаТаблицы.ДокументПредставление = ПредставлениеНовогоЗаказа();
	СтрокаТаблицы.ЦенаИзменена = Ложь;
	ОбновитьВалютуНовойСтроки(СтрокаТаблицы);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВалютуНовойСтроки(СтрокаТаблицы)

	Значения = ЗначенияНовойСтрокиТоваров(СтрокаТаблицы.Клиент, СтрокаТаблицы.Организация);
	СтрокаТаблицы.Валюта = Значения.Валюта;

КонецПроцедуры

&НаКлиенте
Процедура СброситьРучнуюЦену()

	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы <> Неопределено Тогда
		СтрокаТаблицы.ЦенаИзменена = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПравкуШапкиСтрокиТоваров(Можно)

	Элементы.ТоварыДокумент.ТолькоПросмотр = Не Можно;
	Элементы.ТоварыКлиент.ТолькоПросмотр = Не Можно;
	Элементы.ТоварыОрганизация.ТолькоПросмотр = Не Можно;
	Элементы.ТоварыНоменклатура.ТолькоПросмотр = Не Можно;

КонецПроцедуры

// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПокупателя - заказы строк с незаписанными правками.
//
&НаКлиенте
Функция ДокументыСНезаписаннымиПравками()

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Товары Цикл
		Если СтрокаТаблицы.Изменена И ЗначениеЗаполнено(СтрокаТаблицы.Документ)
			И Результат.Найти(СтрокаТаблицы.Документ) = Неопределено Тогда
			Результат.Добавить(СтрокаТаблицы.Документ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//  Число - строки с незаписанными правками и незаписанные новые строки с товаром.
//
&НаКлиенте
Функция ЧислоНезаписанныхСтрок()

	Число = 0;
	Для Каждого СтрокаТаблицы Из Товары Цикл
		Если СтрокаТаблицы.Изменена Или СтрокаТаблицы.НомерСтроки = 0 И ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			Число = Число + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Число;

КонецФункции

// Заказ строки; после закрытия его формы таблица перечитывается, курсор - на той же строке.
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - строка с документом.
//
&НаКлиенте
Процедура ОткрытьДокументСтрокиТоваров(СтрокаТаблицы)

	ДопПараметры = Новый Структура(ПоляКурсора(), СтрокаТаблицы.Документ, СтрокаТаблицы.НомерСтроки);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДокументаТоваров", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму(ПолноеИмяДокумента() + ".ФормаОбъекта", Новый Структура("Ключ", СтрокаТаблицы.Документ), ЭтотОбъект, , , ,
		Оповещение);

КонецПроцедуры

// Параметры:
//  Результат    - Произвольный - не используется.
//  ДопПараметры - Структура - Документ, НомерСтроки строки, из которой открыт документ.
//
&НаКлиенте
Процедура ПослеЗакрытияДокументаТоваров(Результат, ДопПараметры) Экспорт

	ЗагрузитьТоварыНаСервере(ДопПараметры.Документ, ДопПараметры.НомерСтроки);

КонецПроцедуры

// Заказы выделенных записанных строк для печати. Перед печатью - очередь записи и незаписанные правки этих заказов:
// заказ, правки которого не записались, не печатается.
//
// Параметры:
//  Выделенные - Массив из ДокументСсылка.ЗаказПокупателя - заказы выделенных строк.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПокупателя - заказы к печати.
//
&НаСервере
Функция ДокументыКПечатиНаСервере(Знач Выделенные)

	Итог = ВыполнитьНазначенныеЗаписи(Выделенные);
	ЗагрузитьТоварыНаСервере();
	Результат = Новый Массив;
	Для Каждого Документ Из Выделенные Цикл
		Если Итог.Конфликты.Найти(Документ) <> Неопределено Тогда
			// Правки вернулись к базе: печать разошлась бы с тем, что вводил пользователь.
			Шаблон = НСтр("ru = 'Заказ %1 изменил другой пользователь: строки перечитаны, проверьте их и повторите печать.';
				|fr = 'La commande %1 a été modifiée par un autre utilisateur : lignes relues, vérifiez-les et relancez
				|l''impression.'; en = 'Order %1 was changed by another user: lines reloaded, check them and print again.';
				|es = 'Otro usuario cambió el pedido %1: líneas releídas, revíselas y vuelva a imprimir.'");
			СообщитьРезультат(СтрШаблон(Шаблон, Документ));
			Продолжить;
		КонецЕсли;
		Найденные = Товары.НайтиСтроки(Новый Структура("Документ, Изменена", Документ, Истина));
		Если Найденные.Количество() = 0 Тогда
			Результат.Добавить(Документ);
		Иначе
			Шаблон = НСтр("ru = 'Правки строк заказа %1 не записаны: исправьте их и повторите печать.';
				|fr = 'Les modifications des lignes de la commande %1 ne sont pas enregistrées : corrigez-les et relancez l''impression.';
				|en = 'Changes to the lines of order %1 are not saved: fix them and print again.';
				|es = 'Los cambios de las líneas del pedido %1 no se guardaron: corríjalos y vuelva a imprimir.'");
			СообщитьРезультат(СтрШаблон(Шаблон, Найденные[0].ДокументПредставление));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Закрытие: очередь записи и все незаписанные правки; остаток - число незаписанных строк.
//
// Возвращаемое значение:
//  Число - строки, правки которых так и не записались.
//
&НаСервере
Функция ЗаписатьПравкиПередЗакрытием()

	Документы_ = Новый Массив;
	Для Каждого СтрокаТаблицы Из Товары Цикл
		Если СтрокаТаблицы.Изменена И ЗначениеЗаполнено(СтрокаТаблицы.Документ)
			И Документы_.Найти(СтрокаТаблицы.Документ) = Неопределено Тогда
			Документы_.Добавить(СтрокаТаблицы.Документ);
		КонецЕсли;
		Если СтрокаТаблицы.НомерСтроки = 0 И ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура)
			И СтрокиТоваровКЗаписи.НайтиПоЗначению(СтрокаТаблицы.ПолучитьИдентификатор()) = Неопределено Тогда
			СтрокиТоваровКЗаписи.Добавить(СтрокаТаблицы.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
	Итог = ВыполнитьНазначенныеЗаписи(Документы_);
	// Правки, вернувшиеся к базе из-за конфликта, тоже не записаны: закрытие останавливается вопросом.
	Остаток = Итог.Потеряно;
	Для Каждого СтрокаТаблицы Из Товары Цикл
		Если СтрокаТаблицы.Изменена Или СтрокаТаблицы.НомерСтроки = 0 И ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			Остаток = Остаток + 1;
		КонецЕсли;
	КонецЦикла;
	Если Остаток > 0 Тогда
		// Закрытие остановится вопросом: записанные строки вернуть в таблицу (запись убрала их до перечитывания),
		// незаписанные правки перечитывание сохраняет (ревью кода 2.0.17.41, P2).
		ЗагрузитьТоварыНаСервере(Итог.Документ, Итог.НомерСтроки);
	КонецЕсли;
	Возврат Остаток;

КонецФункции

&НаКлиенте
Процедура ПослеВопросаОЗакрытии(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗакрытиеПодтверждено = Истина;
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОтменеПравок(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗагрузитьТоварыНаСервере(Неопределено, 0, Истина);
	ИначеЕсли СтрокиТоваровКЗаписи.Количество() > 0 Тогда
		ЗадержкаСекунд = 0.1;
		ПодключитьОбработчикОжидания("ЗаписатьСтрокиТоваровОжидание", ЗадержкаСекунд, Истина);
	Иначе
		// Отмену отклонили, очередь пуста: ничего не делается.
		Возврат;
	КонецЕсли;

КонецПроцедуры

