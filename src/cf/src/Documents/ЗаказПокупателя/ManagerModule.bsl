#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы документа.
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	Для Каждого Описание Из ОписанияПечатныхФорм() Цикл
		Команда = КомандыПечати.Добавить();
		Команда.ИмяМакета = Описание.ИмяМакета;
		Команда.Представление = Описание.Представление;
		// Внутренний лист заказа - только товары и количества, цен в макете нет.
		Команда.БезЦен = Истина;
	КонецЦикла;
	// Счёт-проформа и бланк заказа - фирменные формы под прежними именами и названиями (docs/plans/branded-print.md,
	// разделы 10.7 и 12.7).
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаПроформы(), ВидФормыПроформы(), ПредставлениеПроформы());
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаБланкаЗаказа(), ВидФормыБланкаЗаказа(),
		ПредставлениеБланкаЗаказа());

КонецПроцедуры

// Формирует запрошенные печатные формы документа.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые документы
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие документов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Для Каждого Описание Из ОписанияПечатныхФорм() Цикл
		Если Не ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, Описание.ИмяМакета) Тогда
			Продолжить;
		КонецЕсли;

		Таб = Новый ТабличныйДокумент;
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			ВывестиПечатнуюФорму(Описание.ИмяМакета, Док, Таб);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;

		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, Описание.ИмяМакета,
			Описание.Представление, Таб, Описание.ПутьКМакету);
	КонецЦикла;

	// Прежняя проформа (PrintDevisA4HT) печатала цены и суммы строк без НДС - тот же вариант фирменной формы.
	ПараметрыПроформы = Новый Структура("БезНДС", Истина);
	ФирменнаяПечать.Напечатать(ИмяМакетаПроформы(), ВидФормыПроформы(), МассивОбъектов, ПараметрыПроформы,
		КоллекцияПечатныхФорм, ОбъектыПечати, ПредставлениеПроформы());
	ФирменнаяПечать.Напечатать(ИмяМакетаБланкаЗаказа(), ВидФормыБланкаЗаказа(), МассивОбъектов, ПараметрыПечати,
		КоллекцияПечатныхФорм, ОбъектыПечати, ПредставлениеБланкаЗаказа());

КонецПроцедуры

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать): счёт-проформа заказа (docs/plans/branded-print.md,
// раздел 10.6) и бланк заказа (Bon de commande, раздел 12.5). Команда «Счёт» реализации, вызванная из форм заказа,
// передаёт признак СчетаРеализаций: по заказу печатаются счета введённых по нему реализаций, а без них - сам заказ, как
// прежний «Счёт на оплату».
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.ЗаказПокупателя - печатаемые заказы.
//  ВидФормы        - Строка - Proforma или BonDeCommande.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати; ключ СчетаРеализаций - печатать счета реализаций заказа.
//
// Возвращаемое значение:
//  Соответствие - заказ -> источник печати или Массив источников (счета реализаций), см.
//                 ФирменнаяПечать.ИсточникТоварногоДокумента.
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	БланкЗаказа = ВидФормы = ВидФормыБланкаЗаказа();
	СчетаРеализаций = Не БланкЗаказа И ПараметрыПечати.Свойство("СчетаРеализаций")
		И ПараметрыПечати.СчетаРеализаций = Истина;
	Результат = Новый Соответствие;
	БезРеализаций = Ссылки;
	Если СчетаРеализаций Тогда
		БезРеализаций = ДобавитьСчетаРеализаций(Результат, Ссылки, ВидФормы, КодЯзыка);
	КонецЕсли;
	Если БезРеализаций.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Заказ.Ссылка КАК Ссылка,
	|	Заказ.Номер КАК НомерДокумента,
	|	Заказ.Дата КАК Дата,
	|	Заказ.Организация КАК Организация,
	|	Заказ.Контрагент КАК Контрагент,
	|	Заказ.Договор КАК Договор,
	|	Заказ.Валюта КАК Валюта,
	|	Заказ.ВВалюте КАК ВВалюте,
	|	Заказ.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Заказ.Сумма КАК Сумма,
	|	Заказ.СуммаНДС КАК СуммаНДС,
	|	Заказ.Комментарий КАК Комментарий,
	|	Заказ.НомерВходящегоДокументаЭлектронногоОбмена КАК НомерЗаказаКлиента,
	|	Заказ.ДатаВходящегоДокументаЭлектронногоОбмена КАК ДатаЗаказаКлиента,
	|	ВЫБОР
	|		КОГДА Заказ.Менеджер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(Заказ.Ответственный)
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Заказ.Менеджер)
	|	КОНЕЦ КАК Менеджер,
	|	ПРЕДСТАВЛЕНИЕ(Заказ.Ответственный) КАК Автор,
	|	ЕСТЬNULL(Контрагенты.Код, """") КАК КодКонтрагента,
	|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(Контрагенты.ТипОплаты), """") КАК ТипОплаты
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Заказ.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	Заказ.Ссылка В(&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", БезРеализаций);
	Выборка = Запрос.Выполнить().Выбрать();
	Строки = ФирменнаяПечать.ДанныеСтрокДокументов(Метаданные.Документы.ЗаказПокупателя.Имя, БезРеализаций, "ТЧТовары");
	Кэш = ФирменнаяПечать.НовыйКэш();
	Пока Выборка.Следующий() Цикл
		Шапка = ФирменнаяПечать.НоваяШапкаДокумента();
		ЗаполнитьЗначенияСвойств(Шапка, Выборка);
		Шапка.Основание = ФирменнаяПечать.ПредставлениеЗаказаКлиента(Выборка.НомерЗаказаКлиента,
			Выборка.ДатаЗаказаКлиента, КодЯзыка);
		// Номер - как у прежней формы своей команды: проформа заказа и бланк заказа - «номер/ГГ», счёт из формы заказа -
		// номер.
		Шапка.Номер = ?(СчетаРеализаций, СокрЛП(Выборка.НомерДокумента),
			ФирменнаяПечать.НомерНакладной(Выборка.НомерДокумента, Выборка.Дата));
		Если БланкЗаказа Тогда
			// Прежний бланк заказа печатал автора и не печатал способа оплаты (раздел 12.1 плана).
			ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента("Bon de commande", Выборка.НомерДокумента, Выборка.Дата);
		Иначе
			Шапка.Автор = "";
			Шапка.УсловияОплаты = ФирменнаяПечать.УсловияОплатыДокумента(Выборка.Ссылка, Выборка.ТипОплаты);
			ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента("Facture proforma", Выборка.НомерДокумента, Выборка.Дата);
		КонецЕсли;
		Источник = ФирменнаяПечать.ИсточникТоварногоДокумента(Шапка, Строки[Выборка.Ссылка], Кэш, ИмяФайла);
		Результат.Вставить(Выборка.Ссылка, Источник);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Ставит новый код строкам товаров с нулевым кодом или с кодом, повторяющим код более ранней
// строки: по коду строки товаров к ней привязаны материалы заказа на производство. Штрихкод
// кода не ставит, а заполнение по основанию копирует коды основания.
// Работает и с табличной частью объекта, и с данными формы.
//
// Параметры:
//  ТЧТовары - ТабличнаяЧасть, ДанныеФормыКоллекция - товары заказа.
//  Строки   - Массив, Неопределено - проверяемые строки товаров; не задано - все строки.
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы один код изменён.
//
Функция ОбеспечитьКодыСтрокТоваров(ТЧТовары, Строки = Неопределено) Экспорт

	ПроверяемыеИндексы = Неопределено;
	Если Строки <> Неопределено Тогда
		ПроверяемыеИндексы = Новый Соответствие;
		Для Каждого СтрокаТоваров Из Строки Цикл
			ПроверяемыеИндексы.Вставить(ТЧТовары.Индекс(СтрокаТоваров), Истина);
		КонецЦикла;
	КонецЕсли;
	МаксимальныйКод = 0;
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		МаксимальныйКод = Макс(МаксимальныйКод, СтрокаТоваров.КодСтроки);
	КонецЦикла;
	ВстреченныеКоды = Новый Соответствие;
	Изменено = Ложь;
	Для Индекс = 0 По ТЧТовары.Количество() - 1 Цикл
		СтрокаТоваров = ТЧТовары[Индекс];
		Проверять = ПроверяемыеИндексы = Неопределено Или ПроверяемыеИндексы[Индекс] <> Неопределено;
		КодЗанят = СтрокаТоваров.КодСтроки = 0 Или ВстреченныеКоды[СтрокаТоваров.КодСтроки] <> Неопределено;
		Если Проверять И КодЗанят Тогда
			МаксимальныйКод = МаксимальныйКод + 1;
			СтрокаТоваров.КодСтроки = МаксимальныйКод;
			Изменено = Истина;
		КонецЕсли;
		ВстреченныеКоды.Вставить(СтрокаТоваров.КодСтроки, Истина);
	КонецЦикла;
	Возврат Изменено;

КонецФункции

// Заполняет материалы строк товаров заказа на производство по технологическим картам,
// действующим на дату заказа. Карта разворачивается в глубину: продукция -> полуфабрикат ->
// материалы, связь узла с родителем хранится в КодСтрокиРодителя (у первого уровня он нулевой).
// Прежние материалы заполняемой строки заменяются целиком, вместе с поддеревом; колонка
// «Техкарта» строки получает версию карты ПЕРВОГО уровня (её регистратор) - карту самой продукции,
// именно её сверяет и перезаписывает проведение заказа. У позиции без карты колонка очищается.
// Общая часть команды формы и заполнения заказа по коммерческому предложению: работает с
// коллекциями строк, поэтому форма не гоняет объект целиком и не теряет дополнительные колонки.
//
// Параметры:
//  ТЧТовары     - ТабличнаяЧасть, ДанныеФормыКоллекция - товары заказа.
//  ТЧМатериалы  - ТабличнаяЧасть, ДанныеФормыКоллекция - материалы заказа.
//  Дата         - Дата - момент среза карт; не заполнена - дата сеанса.
//  Строки       - Массив, Неопределено - заполняемые строки товаров; не задано - все строки
//                 с заполненной номенклатурой.
//  СообщатьТолькоПроизводимые - Булево - о позиции без карты сообщать, только если она пополняется
//                 производством: закупаемый товар в заказе на производство карты не требует.
//  КлючДанных   - ДокументОбъект.ЗаказПокупателя, Неопределено - объект для привязки сообщений;
//                 не задан - сообщения привязываются к реквизиту формы «Объект».
//
// Возвращаемое значение:
//  Структура - итог заполнения:
//   * Заполнено  - Число - сколько строк товаров получили материалы по карте.
//   * БезКарты   - Массив из СправочникСсылка.Номенклатура - позиции без карты, о которых сообщено.
//   * СОшибками  - Массив из СправочникСсылка.Номенклатура - позиции, чью карту не удалось развернуть
//                  (цикл или превышение глубины) ИЛИ у которых материал теряется округлением на
//                  заданном объёме продукции: их материалы очищены, сообщение выведено. Проведение
//                  такую строку не пропустит - производимая продукция без материалов не проводится.
//
Функция ЗаполнитьМатериалыПоТехкартам(ТЧТовары, ТЧМатериалы, Дата, Строки = Неопределено,
	СообщатьТолькоПроизводимые = Ложь, КлючДанных = Неопределено) Экспорт

	Результат = Новый Структура("Заполнено, БезКарты, СОшибками", 0, Новый Массив, Новый Массив);
	Заполняемые = Новый Массив;
	Продукция = Новый Массив;
	Для Каждого СтрокаТоваров Из ?(Строки = Неопределено, ТЧТовары, Строки) Цикл
		Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Заполняемые.Добавить(СтрокаТоваров);
		Если Продукция.Найти(СтрокаТоваров.Номенклатура) = Неопределено Тогда
			Продукция.Добавить(СтрокаТоваров.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Если Продукция.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Без опции упаковка в документ не уходит, как у заполнения выпуска (решение владельца 2026-09-10):
	// её же учитывает разворачивание, когда перемножает количества по цепочке.
	СУпаковкой = ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку");
	Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Продукция, Дата, СУпаковкой);
	// ПФ переработчика, который в заказе есть и в другой роли, не разворачивается: ключ потребности его сырья
	// совпал бы с ключом самого ПФ (план semi-finished-subcontract, редакции 12, 15).
	НеРазворачивать = ГраницыВДругойРоли(ТЧТовары, ТЧМатериалы, Заполняемые, Развернутый.Строки);
	Если НеРазворачивать.Количество() > 0 Тогда
		Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Продукция, Дата, СУпаковкой, НеРазворачивать);
	КонецЕсли;
	Состав = Развернутый.Строки;
	ПродукцияСОшибками = ПродукцияОшибокРазворачивания(Развернутый.Ошибки);
	СКартой = Новый Массив;
	БезКарты = Новый Массив;
	СОшибками = Новый Массив;
	Для Каждого СтрокаТоваров Из Заполняемые Цикл
		Если ПродукцияСОшибками[СтрокаТоваров.Номенклатура] <> Неопределено Тогда
			// Карта развернулась не до конца: заполнять дерево по обрезанной цепочке нельзя - потребность
			// вышла бы заведомо неверной. Строка остаётся без материалов, как позиция без карты.
			СОшибками.Добавить(СтрокаТоваров);
		ИначеЕсли Состав.НайтиСтроки(Новый Структура("Продукция", СтрокаТоваров.Номенклатура)).Количество() = 0 Тогда
			БезКарты.Добавить(СтрокаТоваров);
		Иначе
			СКартой.Добавить(СтрокаТоваров);
		КонецЕсли;
	КонецЦикла;
	// Код нужен только строкам, получающим материалы: коды остальных строк не трогаются, по ним
	// реализация перезаполняет цены из заказа-основания.
	ОбеспечитьКодыСтрокТоваров(ТЧТовары, СКартой);
	ОчиститьСтрокиБезКарты(ТЧТовары, ТЧМатериалы, БезКарты);
	ОчиститьСтрокиБезКарты(ТЧТовары, ТЧМатериалы, СОшибками);
	Для Каждого СтрокаТоваров Из СКартой Цикл
		Результат.Заполнено = Результат.Заполнено + ЗаполнитьМатериалыОднойСтроки(ТЧТовары, ТЧМатериалы,
			СтрокаТоваров, Состав, СУпаковкой, КлючДанных, Результат.СОшибками);
	КонецЦикла;
	СообщитьОСтрокахБезКарты(ТЧТовары, БезКарты, СообщатьТолькоПроизводимые, КлючДанных, Результат.БезКарты);
	СообщитьОбОшибкахРазворачивания(ТЧТовары, СОшибками, Развернутый.Ошибки, КлючДанных, Результат.СОшибками);
	Возврат Результат;

КонецФункции

// Номенклатуры развёрнутых границ «Переработчик», которые встречаются в заказе в другой роли: в строках товаров
// (продукция заказа), в развёрнутом составе не границей (свой ПФ, лист) или в сохранённых материалах незаполняемых
// строк со способом, отличным от «Переработчик». Сравнение по номенклатуре без характеристики: измерение «Продукция»
// регистра потребностей хранит только её (план semi-finished-subcontract, редакция 14).
//
// Параметры:
//  ТЧТовары    - ТабличнаяЧасть, ДанныеФормыКоллекция - товары заказа.
//  ТЧМатериалы - ТабличнаяЧасть, ДанныеФормыКоллекция - материалы заказа до перезаполнения.
//  Заполняемые - Массив - строки товаров, материалы которых перезаполняются.
//  Состав      - ТаблицаЗначений - см. ТехнологическиеКарты.РазвернутыйСостав.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - ПФ, которые разворачивать нельзя.
//
Функция ГраницыВДругойРоли(ТЧТовары, ТЧМатериалы, Заполняемые, Состав) Экспорт

	Результат = Новый Массив;
	Границы = Новый Массив;
	Для Каждого СтрокаСостава Из Состав.НайтиСтроки(Новый Структура("ГраницаСписания", Истина)) Цикл
		Если Границы.Найти(СтрокаСостава.Номенклатура) = Неопределено Тогда
			Границы.Добавить(СтрокаСостава.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Если Границы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	ВДругойРоли = НоменклатураВДругойРоли(ТЧТовары, ТЧМатериалы, Заполняемые, Состав);
	Для Каждого Граница Из Границы Цикл
		Если ВДругойРоли[Граница] <> Неопределено Тогда
			Результат.Добавить(Граница);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Коды строк материалов, у которых есть потомки. Такая строка - узел дерева, а не потребность: за неё
// отвечают её листья. Правило живёт здесь одно на всех потребителей - потребность (E7), списание
// автовыпуском (E9) и дерево рабочего места.
// Потомком считается только строка ТОЙ ЖЕ строки продукции: ссылка на родителя из-под другой строки
// товаров (данные загрузки, ручная правка) иначе лишала бы потребности чужой полуфабрикат, у которого
// настоящих потомков нет.
// Нулевой КодСтрокиРодителя родителем никого не делает, и это не страховка, а условие навсегда:
// КодСтроки материала не гарантирован ненулевым (ПередЗаписью выходит при ОбменДанными.Загрузка), и без
// этой оговорки строка с нулевым кодом стала бы «родителем» всех строк заказа.
//
// Параметры:
//  ТЧМатериалы - ТабличнаяЧасть, ТаблицаЗначений, ДанныеФормыКоллекция - строки с КодСтроки,
//                КодСтрокиРодителя и КодСтрокиПродукции; считается по ВСЕМ строкам, включая строки с
//                пустым материалом, - иначе у разных потребителей получились бы разные множества листьев.
//
// Возвращаемое значение:
//  Соответствие - ключ Строка (см. КлючРодителяМатериала), значение Истина. Проверять принадлежность
//                 строки так: Результат[КлючРодителяМатериала(Строка.КодСтрокиПродукции, Строка.КодСтроки)].
//
Функция КодыСтрокСПотомками(ТЧМатериалы) Экспорт

	Результат = Новый Соответствие;
	Для Каждого Материал Из ТЧМатериалы Цикл
		Если Материал.КодСтрокиРодителя <> 0 Тогда
			Результат.Вставить(КлючРодителяМатериала(Материал.КодСтрокиПродукции, Материал.КодСтрокиРодителя), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Развёрнутые границы «Переработчик» дерева материалов (2.0.16.103): узел со способом «Переработчик» и потомками. Их
// сырьё - потребность с ключом продукции = ПФ, а изделие списывает сам ПФ (Производство.СтрокиСписания).
//
// Параметры:
//  ТЧМатериалы - ТабличнаяЧасть, ТаблицаЗначений, ДанныеФормыКоллекция - строки с КодСтроки, КодСтрокиПродукции,
//                Номенклатура, СпособИзготовления.
//  СПотомками  - Соответствие - см. КодыСтрокСПотомками.
//
// Возвращаемое значение:
//  Соответствие - ключ КлючРодителяМатериала узла-границы, значение СправочникСсылка.Номенклатура (ПФ).
//
Функция ГраницыПереработчикаПоКлючам(ТЧМатериалы, СПотомками) Экспорт

	Результат = Новый Соответствие;
	Для Каждого Материал Из ТЧМатериалы Цикл
		Ключ = КлючРодителяМатериала(Материал.КодСтрокиПродукции, Материал.КодСтроки);
		Если Материал.СпособИзготовления = Перечисления.СпособыИзготовления.Переработчик
			И СПотомками[Ключ] <> Неопределено И ЗначениеЗаполнено(Материал.Номенклатура) Тогда
			Результат.Вставить(Ключ, Материал.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строки дерева материалов, которые списывает выпуск продукции (автовыпуск при отгрузке): развёрнутая граница
// «Переработчик» списывается целиком (ПФ пришёл от переработчика), её поддерево - нет; лист вне границ списывается
// (2.0.16.103, план semi-finished-subcontract, R5). Узлы собственного производства не списываются - за них отвечают
// их листья, как раньше.
//
// Параметры:
//  ТЧМатериалы - ТабличнаяЧасть, ТаблицаЗначений - строки с КодСтроки, КодСтрокиРодителя, КодСтрокиПродукции,
//                СпособИзготовления.
//
// Возвращаемое значение:
//  Соответствие - ключ КлючРодителяМатериала строки, значение Истина - строка списывается.
//
Функция СтрокиСписания(ТЧМатериалы) Экспорт

	СПотомками = КодыСтрокСПотомками(ТЧМатериалы);
	Границы = ГраницыПереработчикаПоКлючам(ТЧМатериалы, СПотомками);
	Родители = Новый Соответствие;
	Для Каждого Материал Из ТЧМатериалы Цикл
		Если Материал.КодСтрокиРодителя <> 0 Тогда
			Родители.Вставить(КлючРодителяМатериала(Материал.КодСтрокиПродукции, Материал.КодСтроки),
				КлючРодителяМатериала(Материал.КодСтрокиПродукции, Материал.КодСтрокиРодителя));
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Соответствие;
	Для Каждого Материал Из ТЧМатериалы Цикл
		Ключ = КлючРодителяМатериала(Материал.КодСтрокиПродукции, Материал.КодСтроки);
		Если Границы[Ключ] = Неопределено И СПотомками[Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Под границей - не списывается. Глубина дерева ограничена пределом разворачивания, цикла в нём нет.
		ПодГраницей = Ложь;
		Предок = Родители[Ключ];
		Пока Предок <> Неопределено Цикл
			Если Границы[Предок] <> Неопределено Тогда
				ПодГраницей = Истина;
				Прервать;
			КонецЕсли;
			Предок = Родители[Предок];
		КонецЦикла;
		Если Не ПодГраницей Тогда
			Результат.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ключ связи «родитель - потомок» внутри одной строки продукции.
//
// Параметры:
//  КодСтрокиПродукции - Число - код строки товаров.
//  КодСтроки          - Число - код строки материалов.
//
// Возвращаемое значение:
//  Строка - ключ для соответствия КодыСтрокСПотомками.
//
Функция КлючРодителяМатериала(КодСтрокиПродукции, КодСтроки) Экспорт

	Возврат Формат(КодСтрокиПродукции, "ЧН=0; ЧГ=0") + "|" + Формат(КодСтроки, "ЧН=0; ЧГ=0");

КонецФункции

// Материалы ПЕРВОГО УРОВНЯ по коду строки продукции: строки, у которых родитель не заполнен.
// Общая для СоставыПродукций и для проверки одинакового состава продукции в модуле объекта - там, где
// речь о составе технологической карты, а он одноуровневый. Экспортная по этой же причине.
//
// Параметры:
//  ТЧМатериалы - ТабличнаяЧасть, ТаблицаЗначений, ДанныеФормыКоллекция - материалы заказа.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (код строки продукции), значение Массив строк материалов первого уровня.
//
Функция МатериалыПервогоУровняПоКодам(ТЧМатериалы) Экспорт

	Результат = Новый Соответствие;
	Для Каждого Материал Из ТЧМатериалы Цикл
		Если Материал.КодСтрокиРодителя <> 0 Тогда
			Продолжить;
		КонецЕсли;
		МатериалыКода = Результат[Материал.КодСтрокиПродукции];
		Если МатериалыКода = Неопределено Тогда
			МатериалыКода = Новый Массив;
			Результат.Вставить(Материал.КодСтрокиПродукции, МатериалыКода);
		КонецЕсли;
		МатериалыКода.Добавить(Материал);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Удаляет материалы, привязанные к строке товаров.
//
// Параметры:
//  ТЧМатериалы        - ТабличнаяЧасть, ДанныеФормыКоллекция - материалы заказа.
//  КодСтрокиПродукции - Число - код строки товаров.
//
Процедура УдалитьМатериалыСтроки(ТЧМатериалы, КодСтрокиПродукции) Экспорт

	Материалы = ТЧМатериалы.НайтиСтроки(Новый Структура("КодСтрокиПродукции", КодСтрокиПродукции));
	Для Каждого Материал Из Материалы Цикл
		ТЧМатериалы.Удалить(Материал);
	КонецЦикла;

КонецПроцедуры

// Теряется ли материал: норма по цепочке карт ненулевая, а количество на заданный объём продукции
// после округления разрядностью количества - ноль. Такой материал не попал бы ни в потребность, ни
// в списание, поэтому заполнение его не пишет, а проведение отказывает.
// Формула живёт здесь одна на всех: заполнение материалов и объяснение отказа при проведении
// обязаны считать потерю одинаково, иначе пользователь получит отказ без причины или причину без
// отказа.
// Нулевое количество продукции потерей не считается - заполнение зовётся и до ввода количества.
//
// Параметры:
//  НормаЗаЕдиницу      - Число - норма расхода на единицу продукции (разрядность НормаРасхода).
//  КоличествоПродукции - Число - количество строки товаров в базовых единицах.
//  Упаковка            - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка материала.
//
// Возвращаемое значение:
//  Булево - Истина, если материал теряется.
//
Функция НормаТеряется(НормаЗаЕдиницу, КоличествоПродукции, Упаковка) Экспорт

	Если НормаЗаЕдиницу <= 0 Или КоличествоПродукции <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Коэффициент = ?(ЗначениеЗаполнено(Упаковка),
		ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы(Упаковка), 1);
	Разрядность = Метаданные.ОпределяемыеТипы.Количество.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти;
	Возврат Окр(НормаЗаЕдиницу * КоличествоПродукции * Коэффициент, Разрядность) = 0;

КонецФункции

// Количество материала по количеству продукции его строки: количество за единицу задано в
// упаковке материала на базовую единицу продукции, базовое количество материала - по коэффициенту
// упаковки, как у строк остальных документов. На клиенте формула проще: туда приходят только материалы без упаковки.
//
// Параметры:
//  Материал            - СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекции - строка материалов.
//  КоличествоПродукции - Число - количество строки товаров в базовых единицах.
//
Процедура ПересчитатьСтрокуМатериала(Материал, КоличествоПродукции) Экспорт

	// Базовое количество считается из нормы ОДНИМ выражением. Прежний порядок - положить
	// произведение в КоличествоУпаковок и умножить его на коэффициент в РассчитатьКоличество -
	// округлял произведение по разрядности количества ещё в упаковках: норма мельче разрядности
	// обнулялась до умножения на коэффициент. Норма хранится с разрядностью ОпределяемыеТипы.НормаРасхода
	// и здесь не округляется.
	Коэффициент = ?(ЗначениеЗаполнено(Материал.Упаковка),
		ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы(Материал.Упаковка), 1);
	Материал.Количество = Материал.КоличествоЗаЕдиницу * КоличествоПродукции * Коэффициент;
	Материал.КоличествоУпаковок = Материал.КоличествоЗаЕдиницу * КоличествоПродукции;

КонецПроцедуры

// Проводится ли заказ клиента: только заказ на производство при включённом учёте производства.
// Продажа не проводится (E6), форма показывает её как записанный непроводимый документ.
//
// Параметры:
//  ВидОперации - ПеречислениеСсылка.ВидыОперацийЗаказаПокупателя - вид операции заказа.
//
// Возвращаемое значение:
//  Булево - Истина, если заказ проводится.
//
Функция ЗаказПроводится(ВидОперации) Экспорт

	Возврат ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство
		И ПолучитьФункциональнуюОпцию("Производство");

КонецФункции

// Составы продукций заказа на производство в том виде, в каком их хранит технологическая карта:
// по номенклатуре строк товаров с материалами берётся состав первой такой строки (одинаковый состав
// строк одной продукции гарантирует запись заказа), строки состава свёрнуты по материалу,
// характеристике и упаковке. Работает и с табличными частями объекта, и с выгрузкой из базы.
//
// В состав идут ТОЛЬКО материалы первого уровня (КодСтрокиРодителя = 0). Карта продукции хранится и
// сверяется одним уровнем; попади в состав узлы полуфабрикатов и их материалы - ключ состава не
// совпал бы с ключом версии карты никогда, и проведение заказа перезаписало бы карту продукции
// развёрнутым листовым составом. Уровень полуфабриката исчез бы из контура для всех прочих заказов,
// выпусков и себестоимости, молча.
//
// Параметры:
//  ТЧТовары    - ТабличнаяЧасть, ТаблицаЗначений - строки с КодСтроки, Номенклатура, Техкарта.
//  ТЧМатериалы - ТабличнаяЧасть, ТаблицаЗначений - строки с КодСтрокиПродукции, КодСтрокиРодителя,
//                Номенклатура, Характеристика, Упаковка, КоличествоЗаЕдиницу.
//  СУпаковкой  - Булево - включена опция «Использовать упаковку»; без неё упаковка очищается:
//                в документах она не используется, а карта хранит свою.
//
// Возвращаемое значение:
//  Соответствие - ключ СправочникСсылка.Номенклатура (продукция), значение Структура:
//   * Продукция - СправочникСсылка.Номенклатура - продукция.
//   * Состав    - ТаблицаЗначений - Номенклатура, Характеристика, Упаковка, Количество (на единицу).
//   * Строки    - Массив - строки товаров этой продукции с материалами.
//   * Техкарта  - ДокументСсылка.ТехнологическаяКарта - первая заполненная версия карты строк.
//
Функция СоставыПродукций(ТЧТовары, ТЧМатериалы, СУпаковкой) Экспорт

	МатериалыПоКодам = МатериалыПервогоУровняПоКодам(ТЧМатериалы);
	Результат = Новый Соответствие;
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		Материалы = МатериалыПоКодам[СтрокаТоваров.КодСтроки];
		Если Материалы = Неопределено Или Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Описание = Результат[СтрокаТоваров.Номенклатура];
		Если Описание = Неопределено Тогда
			Описание = Новый Структура;
			Описание.Вставить("Продукция", СтрокаТоваров.Номенклатура);
			Описание.Вставить("Состав", НормализованныйСостав(Материалы, СУпаковкой));
			Описание.Вставить("Строки", Новый Массив);
			Описание.Вставить("Техкарта", Документы.ТехнологическаяКарта.ПустаяСсылка());
			Результат.Вставить(СтрокаТоваров.Номенклатура, Описание);
		КонецЕсли;
		Описание.Строки.Добавить(СтрокаТоваров);
		Если Не ЗначениеЗаполнено(Описание.Техкарта) И ЗначениеЗаполнено(СтрокаТоваров.Техкарта) Тогда
			Описание.Техкарта = СтрокаТоваров.Техкарта;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Переносит в состав без упаковки упаковку строк базовой версии карты с тем же материалом и
// характеристикой - как скрытая колонка карточки номенклатуры: без опции «Использовать упаковку»
// заказ упаковку не хранит, а новая версия карты не должна её терять.
//
// Параметры:
//  Состав       - ТаблицаЗначений - см. СоставыПродукций, колонка Состав.
//  Техкарта     - ДокументСсылка.ТехнологическаяКарта - базовая версия; пустая - ничего не переносится.
//  СоставВерсии - ТаблицаЗначений, Неопределено - уже прочитанный состав базовой версии; не задан -
//                 читается здесь. Задаётся проведением заказа: там же его читает перенос способа
//                 изготовления, и на каждую продукцию заказа приходился бы лишний запрос в транзакции.
//
Процедура ПеренестиУпаковкуКарты(Состав, Техкарта, СоставВерсии = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Техкарта) Тогда
		Возврат;
	КонецЕсли;
	Строки = ?(СоставВерсии = Неопределено, ТехнологическиеКарты.СоставТехкартыПоРегистратору(Техкарта),
		СоставВерсии);
	Упаковки = Новый Соответствие;
	Для Каждого СтрокаКарты Из Строки Цикл
		Ключ = XMLСтрока(СтрокаКарты.Номенклатура) + "|" + XMLСтрока(СтрокаКарты.Характеристика);
		Упаковки.Вставить(Ключ, СтрокаКарты.Упаковка);
	КонецЦикла;
	Для Каждого СтрокаСостава Из Состав Цикл
		Упаковка = Упаковки[XMLСтрока(СтрокаСостава.Номенклатура) + "|" + XMLСтрока(СтрокаСостава.Характеристика)];
		Если Не ЗначениеЗаполнено(СтрокаСостава.Упаковка) И Упаковка <> Неопределено Тогда
			СтрокаСостава.Упаковка = Упаковка;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Переносит в состав способ изготовления и процент потерь строк базовой версии карты с тем же материалом
// и характеристикой. Строки материалов заказа этих полей не знают, а новая версия карты, которую заводит
// проведение заказа при разошедшемся составе, не должна их обнулять: без переноса способ и процент
// сбрасывались бы у карты клиента при каждом изменении состава в заказе, молча.
// Материал, которого в базовой версии нет, значений не получает - умолчание ставит сам документ карты
// в ПередЗаписью. Пустая базовая версия (карта отменена, а в строках товаров версия не проставлена)
// означает, что переносить неоткуда: значения прежней версии не восстанавливаются, ровно как у упаковки.
//
// Параметры:
//  Состав       - ТаблицаЗначений - см. СоставыПродукций, колонка Состав.
//  Техкарта     - ДокументСсылка.ТехнологическаяКарта - базовая версия; пустая - ничего не переносится.
//  СоставВерсии - ТаблицаЗначений, Неопределено - уже прочитанный состав базовой версии; не задан -
//                 читается здесь. См. ПеренестиУпаковкуКарты.
//
Процедура ПеренестиСвойстваИзготовленияКарты(Состав, Техкарта, СоставВерсии = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Техкарта) Тогда
		Возврат;
	КонецЕсли;
	Строки = ?(СоставВерсии = Неопределено, ТехнологическиеКарты.СоставТехкартыПоРегистратору(Техкарта),
		СоставВерсии);
	Записанные = Новый Соответствие;
	Для Каждого СтрокаКарты Из Строки Цикл
		Ключ = XMLСтрока(СтрокаКарты.Номенклатура) + "|" + XMLСтрока(СтрокаКарты.Характеристика);
		Записанные.Вставить(Ключ, СтрокаКарты);
	КонецЦикла;
	Для Каждого СтрокаСостава Из Состав Цикл
		СтрокаКарты = Записанные[
			XMLСтрока(СтрокаСостава.Номенклатура) + "|" + XMLСтрока(СтрокаСостава.Характеристика)];
		Если СтрокаКарты <> Неопределено Тогда
			СтрокаСостава.СпособИзготовления = СтрокаКарты.СпособИзготовления;
			СтрокаСостава.ПроцентПотерь = СтрокаКарты.ПроцентПотерь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Материалы заказа на производство с упаковкой не 1:1. Коэффициент упаковки в конфигурации пока всегда 1
// (ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы), поэтому количество такого материала и потребность
// занизились бы во столько раз, сколько базовых единиц в упаковке (ревью техдолга Codex 2026-10-09, T9).
//
// Параметры:
//  Материалы - ТабличнаяЧасть, ТаблицаЗначений - строки с колонками Номенклатура и Упаковка
//
// Возвращаемое значение:
//  Соответствие - ключ: индекс строки; значение: Строка - текст запрета
//
Функция ТекстЗапретаУпаковокМатериалов(Материалы) Экспорт

	Результат = Новый Соответствие;
	Упаковки = Новый Массив;
	Для Каждого Материал Из Материалы Цикл
		Если ЗначениеЗаполнено(Материал.Упаковка) И Упаковки.Найти(Материал.Упаковка) = Неопределено Тогда
			Упаковки.Добавить(Материал.Упаковка);
		КонецЕсли;
	КонецЦикла;
	Если Упаковки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Упаковки.Ссылка КАК Упаковка
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК Упаковки
	|ГДЕ
	|	Упаковки.Ссылка В(&Упаковки)
	|	И Упаковки.Числитель <> Упаковки.Знаменатель
	|	И Упаковки.Знаменатель > 0
	|	И Упаковки.Числитель > 0";
	Запрос.УстановитьПараметр("Упаковки", Упаковки);
	НеБазовые = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Упаковка");
	Шаблон = НСтр("ru = 'Материал ""%1"": упаковка ""%2"" не 1:1 - укажите базовую единицу или упаковку 1:1, иначе количество
		|материала и потребность будут занижены';
		|fr = 'Matière « %1 » : le conditionnement « %2 » n''est pas 1:1 - indiquez l''unité de base ou un conditionnement 1:1,
		|sinon la quantité de matière et le besoin seront sous-estimés';
		|en = 'Material ""%1"": package ""%2"" is not 1:1 - use the base unit or a 1:1 package, otherwise the material quantity
		|and requirement will be understated';
		|es = 'Material «%1»: el envase «%2» no es 1:1 - indique la unidad base o un envase 1:1, de lo contrario la cantidad
		|del material y la necesidad quedarán subestimadas'");
	Для Каждого Материал Из Материалы Цикл
		Если НеБазовые.Найти(Материал.Упаковка) <> Неопределено Тогда
			Результат.Вставить(Материалы.Индекс(Материал), СтрШаблон(Шаблон, Материал.Номенклатура, Материал.Упаковка));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецЕсли

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Номенклатура заказа не в роли развёрнутой границы (см. ГраницыВДругойРоли).
//
// Параметры:
//  ТЧТовары    - ТабличнаяЧасть, ДанныеФормыКоллекция - товары заказа.
//  ТЧМатериалы - ТабличнаяЧасть, ДанныеФормыКоллекция - материалы заказа до перезаполнения.
//  Заполняемые - Массив - строки товаров, материалы которых перезаполняются.
//  Состав      - ТаблицаЗначений - см. ТехнологическиеКарты.РазвернутыйСостав.
//
// Возвращаемое значение:
//  Соответствие - ключ СправочникСсылка.Номенклатура, значение Истина.
//
Функция НоменклатураВДругойРоли(ТЧТовары, ТЧМатериалы, Заполняемые, Состав)

	Результат = Новый Соответствие;
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		Результат.Вставить(СтрокаТоваров.Номенклатура, Истина);
	КонецЦикла;
	Для Каждого СтрокаСостава Из Состав.НайтиСтроки(Новый Структура("ГраницаСписания", Ложь)) Цикл
		Результат.Вставить(СтрокаСостава.Номенклатура, Истина);
	КонецЦикла;
	КодыЗаполняемых = Новый Соответствие;
	Для Каждого СтрокаТоваров Из Заполняемые Цикл
		КодыЗаполняемых.Вставить(СтрокаТоваров.КодСтроки, Истина);
	КонецЦикла;
	Для Каждого Материал Из ТЧМатериалы Цикл
		Если КодыЗаполняемых[Материал.КодСтрокиПродукции] = Неопределено
			И Материал.СпособИзготовления <> Перечисления.СпособыИзготовления.Переработчик Тогда
			Результат.Вставить(Материал.Номенклатура, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Очищает версию карты и материалы строк товаров, у позиций которых нет действующей карты.
// Материалы удаляются только по коду, принадлежащему одной строке: нулевой или повторный код
// не должен задеть материалы другой строки.
//
// Параметры:
//  ТЧТовары    - ТабличнаяЧасть, ДанныеФормыКоллекция - товары заказа.
//  ТЧМатериалы - ТабличнаяЧасть, ДанныеФормыКоллекция - материалы заказа.
//  БезКарты    - Массив - строки товаров без карты.
//
Процедура ОчиститьСтрокиБезКарты(ТЧТовары, ТЧМатериалы, БезКарты)

	Для Каждого СтрокаТоваров Из БезКарты Цикл
		СтрокаТоваров.Техкарта = Документы.ТехнологическаяКарта.ПустаяСсылка();
		Если СтрокаТоваров.КодСтроки = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТЧТовары.НайтиСтроки(Новый Структура("КодСтроки", СтрокаТоваров.КодСтроки)).Количество() = 1 Тогда
			УдалитьМатериалыСтроки(ТЧМатериалы, СтрокаТоваров.КодСтроки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Добавляет материалы строки товаров по узлам развёрнутой карты, вместе с деревом.
// Узлы приходят в порядке обхода в глубину, поэтому родитель всегда создан раньше потомка и его код
// уже известен.
//
// Параметры:
//  ТЧМатериалы   - ТабличнаяЧасть, ДанныеФормыКоллекция - материалы заказа.
//  СтрокаТоваров - СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекции - строка продукции.
//  СтрокиСостава - Массив из СтрокаТаблицыЗначений - узлы одной продукции,
//                  см. ТехнологическиеКарты.РазвернутыйСостав.
//  СУпаковкой    - Булево - включена опция «Использовать упаковку».
//  ПотерянныеНормы - Массив - пополняется материалами, которые теряются округлением, см. НормаТеряется.
//
Процедура ДобавитьМатериалыСтроки(ТЧМатериалы, СтрокаТоваров, СтрокиСостава, СУпаковкой, ПотерянныеНормы)

	// Максимальный код считается один раз на строку продукции, а не проходом по таблице на каждый материал.
	КодМатериала = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ТЧМатериалы);
	КодыУзлов = Новый Соответствие;
	Для Каждого СтрокаСостава Из СтрокиСостава Цикл
		Материал = ТЧМатериалы.Добавить();
		Материал.КодСтроки = КодМатериала;
		КодыУзлов.Вставить(СтрокаСостава.Индекс, КодМатериала);
		КодМатериала = КодМатериала + 1;
		Материал.КодСтрокиПродукции = СтрокаТоваров.КодСтроки;
		КодРодителя = КодыУзлов[СтрокаСостава.ИндексРодителя];
		Материал.КодСтрокиРодителя = ?(КодРодителя = Неопределено, 0, КодРодителя);
		Материал.Номенклатура = СтрокаСостава.Номенклатура;
		Материал.Характеристика = СтрокаСостава.Характеристика;
		Материал.СпособИзготовления = СтрокаСостава.СпособИзготовления;
		Если СУпаковкой Тогда
			Материал.Упаковка = СтрокаСостава.Упаковка;
		КонецЕсли;
		// Количество узла уже приведено к единице продукции-владельца перемножением по цепочке.
		Материал.КоличествоЗаЕдиницу = СтрокаСостава.Количество;
		ПересчитатьСтрокуМатериала(Материал, СтрокаТоваров.Количество);
		// Потерян не тот материал, у которого мелкая норма, а тот, у которого обнулилось само
		// КОЛИЧЕСТВО: норма хранится с разрядностью НормаРасхода и переживает цепочку, а количество
		// округляется разрядностью количества. Прежнее условие сравнивало норму с количеством за
		// единицу - две величины, равные по построению, - и не срабатывало никогда.
		Если НормаТеряется(СтрокаСостава.Количество, СтрокаТоваров.Количество, Материал.Упаковка) Тогда
			ПотерянныеНормы.Добавить(СтрокаСостава.Номенклатура);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Заполняет материалы одной строки продукции и решает её судьбу: развёрнутый состав пишется в
// материалы, а если хоть один материал теряется округлением - строке отказано и материалов у неё
// не остаётся.
//
// Параметры:
//  ТЧТовары      - ТабличнаяЧасть, ДанныеФормыКоллекция - товары заказа.
//  ТЧМатериалы   - ТабличнаяЧасть, ДанныеФормыКоллекция - материалы заказа.
//  СтрокаТоваров - СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекции - строка продукции.
//  Состав        - ТаблицаЗначений - развёрнутый состав, см. ТехнологическиеКарты.РазвернутыйСостав.
//  СУпаковкой    - Булево - включена опция «Использовать упаковку».
//  КлючДанных    - ДокументОбъект.ЗаказПокупателя, Неопределено - см. ЗаполнитьМатериалыПоТехкартам.
//  СОшибками     - Массив из СправочникСсылка.Номенклатура - пополняется отказанной позицией.
//
// Возвращаемое значение:
//  Число - 1, если строка получила материалы; 0, если отказано.
//
Функция ЗаполнитьМатериалыОднойСтроки(ТЧТовары, ТЧМатериалы, СтрокаТоваров, Состав, СУпаковкой,
	КлючДанных, СОшибками)

	УдалитьМатериалыСтроки(ТЧМатериалы, СтрокаТоваров.КодСтроки);
	СтрокиСостава = Состав.НайтиСтроки(Новый Структура("Продукция", СтрокаТоваров.Номенклатура));
	СтрокаТоваров.Техкарта = РегистраторПервогоУровня(СтрокиСостава);
	ПотерянныеНормы = Новый Массив;
	ДобавитьМатериалыСтроки(ТЧМатериалы, СтрокаТоваров, СтрокиСостава, СУпаковкой, ПотерянныеНормы);
	Отказано = ОтказатьПоПотеряннымМатериалам(ТЧТовары, ТЧМатериалы, СтрокаТоваров, ПотерянныеНормы,
		КлючДанных, СОшибками);
	Возврат ?(Отказано, 0, 1);

КонецФункции

// Отказ по строке, у которой материал теряется округлением (решение владельца 2026-09-20):
// неполный состав в производство не уходит. Строка остаётся без материалов - ровно как у
// неразвернувшейся карты, и проведение отказывает по той же ветке; ПОЧЕМУ материалов нет,
// говорит сообщение отсюда и проверка при проведении.
//
// Параметры:
//  ТЧТовары        - ТабличнаяЧасть, ДанныеФормыКоллекция - товары заказа.
//  ТЧМатериалы     - ТабличнаяЧасть, ДанныеФормыКоллекция - материалы заказа.
//  СтрокаТоваров   - СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекции - строка продукции.
//  ПотерянныеНормы - Массив из СправочникСсылка.Номенклатура - потерянные материалы.
//  КлючДанных      - ДокументОбъект.ЗаказПокупателя, Неопределено - см. ЗаполнитьМатериалыПоТехкартам.
//  СОшибками       - Массив из СправочникСсылка.Номенклатура - пополняется отказанной позицией.
//
// Возвращаемое значение:
//  Булево - Истина, если строке отказано.
//
Функция ОтказатьПоПотеряннымМатериалам(ТЧТовары, ТЧМатериалы, СтрокаТоваров, ПотерянныеНормы,
	КлючДанных, СОшибками)

	Если ПотерянныеНормы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	УдалитьМатериалыСтроки(ТЧМатериалы, СтрокаТоваров.КодСтроки);
	СтрокаТоваров.Техкарта = Документы.ТехнологическаяКарта.ПустаяСсылка();
	СообщитьОПотерянныхНормах(ТЧТовары, СтрокаТоваров, ПотерянныеНормы, КлючДанных);
	Если СОшибками.Найти(СтрокаТоваров.Номенклатура) = Неопределено Тогда
		СОшибками.Добавить(СтрокаТоваров.Номенклатура);
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Сообщает о материалах, потерянных округлением на заданном объёме продукции, и о том, что
// материалы строки не заполнены. Не предупреждение: заполнение по такой строке отказано.
//
// Параметры:
//  ТЧТовары        - ТабличнаяЧасть, ДанныеФормыКоллекция - товары заказа.
//  СтрокаТоваров   - СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекции - строка продукции.
//  ПотерянныеНормы - Массив из СправочникСсылка.Номенклатура - потерянные материалы, см. НормаТеряется.
//  КлючДанных      - ДокументОбъект.ЗаказПокупателя, Неопределено - см. ЗаполнитьМатериалыПоТехкартам.
//
Процедура СообщитьОПотерянныхНормах(ТЧТовары, СтрокаТоваров, ПотерянныеНормы, КлючДанных)

	Если ПотерянныеНормы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Строка %1: количество материала ""%2"" на заданный объём продукции меньше точности
		|количества и обнулилось. Материалы строки не заполнены: увеличьте количество продукции или
		|укрупните норму в технологической карте';
		|fr = 'Ligne %1 : la quantité de la matière « %2 » pour le volume de production indiqué est inférieure à la
		|précision des quantités et devient nulle. Les matières de la ligne ne sont pas remplies : augmentez la
		|quantité de production ou arrondissez la norme dans la gamme de fabrication';
		|en = 'Line %1: the quantity of material ""%2"" for the given production volume is below the quantity
		|precision and becomes zero. The line materials are not filled: increase the production quantity or
		|coarsen the norm in the production routing';
		|es = 'Línea %1: la cantidad del material «%2» para el volumen de producción indicado es inferior a la
		|precisión de cantidades y queda en cero. Los materiales de la línea no se han rellenado: aumente la
		|cantidad de producción o redondee la norma en la ruta de fabricación'");
	Поле = "ТЧТовары[" + Формат(ТЧТовары.Индекс(СтрокаТоваров), "ЧН=0; ЧГ=0") + "].Номенклатура";
	Для Каждого Материал Из ПотерянныеНормы Цикл
		Текст = СтрШаблон(Шаблон, СтрокаТоваров.НомерСтроки, Материал);
		Если КлючДанных = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , Поле, "Объект");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, КлючДанных, Поле);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Версия карты самой продукции - регистратор первого уровня развёрнутого состава. Версии карт
// полуфабрикатов в строку товаров не попадают: проведение заказа сверяет и перезаписывает карту
// продукции, и подставленная туда карта полуфабриката перезаписала бы не тот документ.
//
// Параметры:
//  СтрокиСостава - Массив из СтрокаТаблицыЗначений - узлы одной продукции.
//
// Возвращаемое значение:
//  ДокументСсылка.ТехнологическаяКарта - версия карты продукции.
//
Функция РегистраторПервогоУровня(СтрокиСостава)

	Для Каждого СтрокаСостава Из СтрокиСостава Цикл
		Если СтрокаСостава.Уровень = 1 Тогда
			Возврат СтрокаСостава.Регистратор;
		КонецЕсли;
	КонецЦикла;
	Возврат Документы.ТехнологическаяКарта.ПустаяСсылка();

КонецФункции

// Продукция, чью карту не удалось развернуть.
//
// Параметры:
//  Ошибки - Массив из Структура - см. ТехнологическиеКарты.РазвернутыйСостав, поле Ошибки.
//
// Возвращаемое значение:
//  Соответствие - ключ СправочникСсылка.Номенклатура, значение Истина.
//
Функция ПродукцияОшибокРазворачивания(Ошибки)

	Результат = Новый Соответствие;
	Для Каждого Ошибка Из Ошибки Цикл
		Результат.Вставить(Ошибка.Продукция, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сообщает о строках товаров, чью карту не удалось развернуть: цикл или превышение предела глубины.
// Сообщение привязывается к строке товаров - пользователь видит, какую продукцию чинить.
//
// Параметры:
//  ТЧТовары   - ТабличнаяЧасть, ДанныеФормыКоллекция - товары заказа.
//  Строки     - Массив - строки товаров с неразвёрнутой картой.
//  Ошибки     - Массив из Структура - см. ТехнологическиеКарты.РазвернутыйСостав, поле Ошибки.
//  КлючДанных - ДокументОбъект.ЗаказПокупателя, Неопределено - см. ЗаполнитьМатериалыПоТехкартам.
//  СОшибками  - Массив - пополняется номенклатурой позиций, о которых сообщено.
//
Процедура СообщитьОбОшибкахРазворачивания(ТЧТовары, Строки, Ошибки, КлючДанных, СОшибками)

	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ТекстыПродукции = Новый Соответствие;
	Для Каждого Ошибка Из Ошибки Цикл
		Тексты = ТекстыПродукции[Ошибка.Продукция];
		Если Тексты = Неопределено Тогда
			Тексты = Новый Массив;
			ТекстыПродукции.Вставить(Ошибка.Продукция, Тексты);
		КонецЕсли;
		Если Тексты.Найти(Ошибка.Текст) = Неопределено Тогда
			Тексты.Добавить(Ошибка.Текст);
		КонецЕсли;
	КонецЦикла;
	Шаблон = НСтр("ru = 'Строка %1: %2. Материалы строки не заполнены';
		|fr = 'Ligne %1 : %2. Les matières de la ligne ne sont pas remplies';
		|en = 'Line %1: %2. The line materials are not filled';
		|es = 'Línea %1: %2. Los materiales de la línea no se han rellenado'");
	Для Каждого СтрокаТоваров Из Строки Цикл
		Тексты = ТекстыПродукции[СтрокаТоваров.Номенклатура];
		Если Тексты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СОшибками.Добавить(СтрокаТоваров.Номенклатура);
		Поле = "ТЧТовары[" + Формат(ТЧТовары.Индекс(СтрокаТоваров), "ЧН=0; ЧГ=0") + "].Номенклатура";
		Для Каждого Текст Из Тексты Цикл
			Сообщение = СтрШаблон(Шаблон, СтрокаТоваров.НомерСтроки, Текст);
			Если КлючДанных = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение, , Поле, "Объект");
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение, КлючДанных, Поле);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Сообщает о строках товаров без действующей технологической карты.
//
// Параметры:
//  ТЧТовары           - ТабличнаяЧасть, ДанныеФормыКоллекция - товары заказа.
//  СтрокиБезКарты     - Массив - строки товаров без карты.
//  ТолькоПроизводимые - Булево - сообщать только о позициях, пополняемых производством.
//  КлючДанных         - ДокументОбъект.ЗаказПокупателя, Неопределено - см. ЗаполнитьМатериалыПоТехкартам.
//  БезКарты           - Массив - пополняется номенклатурой позиций, о которых сообщено.
//
Процедура СообщитьОСтрокахБезКарты(ТЧТовары, СтрокиБезКарты, ТолькоПроизводимые, КлючДанных, БезКарты)

	Если СтрокиБезКарты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Производимые = Неопределено;
	Если ТолькоПроизводимые Тогда
		Номенклатура = Новый Массив;
		Для Каждого СтрокаТоваров Из СтрокиБезКарты Цикл
			Номенклатура.Добавить(СтрокаТоваров.Номенклатура);
		КонецЦикла;
		Производимые = ПроизводимаяНоменклатура(Номенклатура);
	КонецЕсли;
	Шаблон = НСтр("ru = 'Строка %1: у ""%2"" нет действующей технологической карты, материалы строки не заполнены';
		|fr = 'Ligne %1 : « %2 » n''a pas de gamme de fabrication en vigueur, les matières de la ligne ne sont pas remplies';
		|en = 'Line %1: ""%2"" has no current production routing, the line materials are not filled';
		|es = 'Línea %1: «%2» no tiene ruta de fabricación vigente, los materiales de la línea no se han rellenado'");
	Для Каждого СтрокаТоваров Из СтрокиБезКарты Цикл
		Если Производимые <> Неопределено И Производимые[СтрокаТоваров.Номенклатура] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		БезКарты.Добавить(СтрокаТоваров.Номенклатура);
		Текст = СтрШаблон(Шаблон, СтрокаТоваров.НомерСтроки, СтрокаТоваров.Номенклатура);
		Поле = "ТЧТовары[" + Формат(ТЧТовары.Индекс(СтрокаТоваров), "ЧН=0; ЧГ=0") + "].Номенклатура";
		Если КлючДанных = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , Поле, "Объект");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, КлючДанных, Поле);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Позиции, пополняемые производством (в том числе «Оба»).
//
// Параметры:
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - проверяемые позиции.
//
// Возвращаемое значение:
//  Соответствие - ключ СправочникСсылка.Номенклатура, значение Истина.
//
Функция ПроизводимаяНоменклатура(Номенклатура)

	Способы = Новый Массив;
	Способы.Добавить(Перечисления.СпособыПополненияЗапасов.Производство);
	Способы.Добавить(Перечисления.СпособыПополненияЗапасов.Оба);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СправочникНоменклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникНоменклатура
	|ГДЕ
	|	СправочникНоменклатура.Ссылка В (&Номенклатура)
	|	И СправочникНоменклатура.СпособПополнения В (&Способы)";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Способы", Способы);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строки материалов одной продукции, приведённые к строкам технологической карты.
// На вход приходят только материалы первого уровня: их отбирает МатериалыПервогоУровняПоКодам, и
// иначе состав разошёлся бы с версией карты навсегда (см. СоставыПродукций).
//
// Параметры:
//  Материалы  - Массив - строки материалов первого уровня строки товаров.
//  СУпаковкой - Булево - см. СоставыПродукций.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Упаковка, Количество.
//
Функция НормализованныйСостав(Материалы, СУпаковкой)

	Состав = Новый ТаблицаЗначений;
	Состав.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Состав.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Состав.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	// Норма, а не количество: сюда кладётся КоличествоЗаЕдиницу, и результат уходит в запись новой
	// версии техкарты. На разрядности количества ручная правка нормы мельче неё молча потеряла бы
	// материал в карте продукции, общей для всех заказов и выпусков.
	Состав.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.НормаРасхода.Тип);
	Для Каждого Материал Из Материалы Цикл
		СтрокаСостава = Состав.Добавить();
		СтрокаСостава.Номенклатура = Материал.Номенклатура;
		СтрокаСостава.Характеристика = Материал.Характеристика;
		Если СУпаковкой Тогда
			СтрокаСостава.Упаковка = Материал.Упаковка;
		КонецЕсли;
		СтрокаСостава.Количество = Материал.КоличествоЗаЕдиницу;
	КонецЦикла;
	// Проведение карты сворачивает одинаковые строки: без свёртки здесь ключ состава заказа отличался бы
	// от записанной версии при каждом перепроведении.
	Состав.Свернуть("Номенклатура, Характеристика, Упаковка", "Количество");
	// Колонки добавляются после свёртки: Свернуть оставляет только перечисленные, а перечислять их нельзя -
	// в группировке они расщепили бы строки, в ресурсах процент бы просуммировался. У заказа этих полей нет,
	// колонки пустые; значения в них кладёт ПеренестиСвойстваИзготовленияКарты из базовой версии карты.
	Состав.Колонки.Добавить("СпособИзготовления", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыИзготовления"));
	Состав.Колонки.Добавить("ПроцентПотерь", Метаданные.ОпределяемыеТипы.Процент.Тип);
	Возврат Состав;

КонецФункции

#КонецЕсли

// Печатные формы заказа покупателя, кроме фирменного счёта-проформы: названия и макеты заданы одним списком - его
// используют и команды печати, и формирование.
//
// Возвращаемое значение:
//  Массив из Структура - описания печатных форм:
//   * ИмяМакета     - Строка - идентификатор печатной формы
//   * Представление - Строка - название для пользователя
//   * ПутьКМакету   - Строка - путь макета для правки пользователем
//
Функция ОписанияПечатныхФорм()

	Описания = Новый Массив;
	// Бланк заказа (ЗаказКлиента) - фирменная форма (раздел 12.7 плана); внутренний лист заказа - прежний.
	ДобавитьОписаниеПечатнойФормы(Описания, "Заказ",
		НСтр("ru = 'Заказ покупателя'; fr = 'Commande client';
			|en = 'Customer order'; es = 'Pedido de cliente'"),
		"Документ.ЗаказПокупателя.Заказ");
	Возврат Описания;

КонецФункции

// Добавляет описание печатной формы в список.
//
// Параметры:
//  Описания      - Массив - пополняемый список описаний
//  ИмяМакета     - Строка - идентификатор печатной формы
//  Представление - Строка - название для пользователя
//  ПутьКМакету   - Строка - путь макета для правки пользователем
//
Процедура ДобавитьОписаниеПечатнойФормы(Описания, ИмяМакета, Представление, ПутьКМакету)

	Описание = Новый Структура("ИмяМакета, Представление, ПутьКМакету",
		ИмяМакета, Представление, ПутьКМакету);
	Описания.Добавить(Описание);

КонецПроцедуры

// Выводит одну печатную форму документа.
//
// Параметры:
//  ИмяМакета - Строка                             - идентификатор печатной формы
//  Док       - ДокументСсылка.ЗаказПокупателя      - печатаемый документ
//  Таб       - ТабличныйДокумент                   - документ вывода
//
Процедура ВывестиПечатнуюФорму(ИмяМакета, Док, Таб)

	Если ИмяМакета = "Заказ" Тогда
		ПечатьЗаказа(Док, Таб);
	Иначе
		ШаблонОшибки = НСтр("ru = 'Печатная форма заказа покупателя не поддерживается: %1';
			|fr = 'Le formulaire imprimable de la commande client n''est pas pris en charge : %1';
			|en = 'The customer order print form is not supported: %1';
			|es = 'El formulario de impresión del pedido de cliente no es compatible: %1'");
		ВызватьИсключение СтрШаблон(ШаблонОшибки, ИмяМакета);
	КонецЕсли;

КонецПроцедуры

Функция ИмяМакетаПроформы()
	Возврат "Проформа";
КонецФункции

Функция ВидФормыПроформы()
	Возврат "Proforma";
КонецФункции

Функция ПредставлениеПроформы()
	Возврат НСтр("ru = 'Счёт-проформа'; fr = 'Facture proforma'; en = 'Proforma invoice'; es = 'Factura proforma'");
КонецФункции

Функция ИмяМакетаБланкаЗаказа()
	Возврат "ЗаказКлиента";
КонецФункции

Функция ВидФормыБланкаЗаказа()
	Возврат "BonDeCommande";
КонецФункции

Функция ПредставлениеБланкаЗаказа()
	// Прежнее название команды - пользователь видит тот же пункт меню.
	Возврат НСтр("ru = 'Бланк заказа (A4)'; fr = 'Bon de commande (A4)'; en = 'Order form (A4)';
		|es = 'Hoja de pedido (A4)'");
КонецФункции

// Счета реализаций, введённых по заказам (не помеченных на удаление), - в результат адаптера массивами по заказу.
//
// Параметры:
//  Результат - Соответствие - пополняемый результат адаптера.
//  Заказы    - Массив из ДокументСсылка.ЗаказПокупателя - печатаемые заказы.
//  ВидФормы  - Строка - вид фирменной формы.
//  КодЯзыка  - Строка - язык печати.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПокупателя - заказы без реализаций: их счёт печатается по самому заказу.
//
Функция ДобавитьСчетаРеализаций(Результат, Заказы, ВидФормы, КодЯзыка)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Реализация.Ссылка КАК Ссылка,
	|	Реализация.Основание КАК Заказ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Основание В(&Заказы)
	|	И НЕ Реализация.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реализация.Дата,
	|	Реализация.Ссылка");
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Реализации = Запрос.Выполнить().Выгрузить();
	Если Реализации.Количество() > 0 Тогда
		Счета = Документы.РеализацияТоваровУслуг.ДанныеФирменнойПечати(Реализации.ВыгрузитьКолонку("Ссылка"), ВидФормы,
			КодЯзыка, Новый Структура);
		Для Каждого Строка Из Реализации Цикл
			Источники = Результат[Строка.Заказ];
			Если Источники = Неопределено Тогда
				Источники = Новый Массив;
				Результат.Вставить(Строка.Заказ, Источники);
			КонецЕсли;
			Источник = Счета[Строка.Ссылка];
			Если Источник <> Неопределено Тогда
				Источники.Добавить(Источник);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	БезРеализаций = Новый Массив;
	Для Каждого Заказ Из Заказы Цикл
		Если Результат[Заказ] = Неопределено Тогда
			БезРеализаций.Добавить(Заказ);
		КонецЕсли;
	КонецЦикла;
	Возврат БезРеализаций;
КонецФункции

#КонецОбласти

Процедура ПечатьЗаказа(Док, Таб) Экспорт
	Макет = ПечатныеФормы.МакетПечатнойФормы("Документ.ЗаказПокупателя.Заказ");
	// Шапка
	оЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	оЗаголовок.Параметры.ТекстЗаголовка = "Commande client № " + Док.Номер + " de " + Формат(Док.Дата, "ДЛФ=DD");
	//оЗаголовок.Параметры.АдресДоставки = Док.Контрагент.Наименование;
	//оЗаголовок.Параметры.Маршрут = Справочники.Маршруты.ПолучитьПоТорговойТочке(Док.Контрагент);
	Таб.Вывести(оЗаголовок);
	
	оПоставщик = Макет.ПолучитьОбласть("Поставщик");
	КарточкаОрганизации = Справочники.Контрагенты.ПолучитьКарточку(Док.Организация, Док.Дата);
	оПоставщик.Параметры.ПредставлениеПоставщика = КарточкаОрганизации.Наименование 
	+ ", ICE " + КарточкаОрганизации.Реквизиты.ICE + ", " 
	+ КарточкаОрганизации.АдресЮридический;
	Таб.Вывести(оПоставщик);
	
	оПокупатель = Макет.ПолучитьОбласть("Покупатель");
	КарточкаПокупателя = Справочники.Контрагенты.ПолучитьКарточку(Док.Контрагент, Док.Дата);
	оПокупатель.Параметры.ПредставлениеПокупателя = КарточкаПокупателя.Наименование
	+ ", ICE " + КарточкаПокупателя.Реквизиты.ICE + ", " 
	+ КарточкаПокупателя.АдресЮридический + ", tel.: " + КарточкаПокупателя.Телефоны;
	Таб.Вывести(оПокупатель);
	
	оШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	Таб.Вывести(оШапкаТаблицы);
	// Строки
	Рез = ПолучитьТоварыПоГруппировкам(Док);
	ВыбГруппа = Рез.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	Ном = 1;
	Пока ВыбГруппа.Следующий() Цикл
		оГруппа = Макет.ПолучитьОбласть("Группа");
		оГруппа.Параметры.Наименование = ?(ЗначениеЗаполнено(ВыбГруппа.Группа), ВыбГруппа.Группа, "Autres");
		Таб.Вывести(оГруппа);
		Выб = ВыбГруппа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выб.Следующий() Цикл
			оСтрока = Макет.ПолучитьОбласть("Строка");
			оСтрока.Параметры.Заполнить(Выб);
			оСтрока.Параметры.НомерСтроки = Ном;
			оСтрока.Параметры.Товар = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Выб.Номенклатура,
				Выб.Характеристика, , Истина, Выб.НоменклатураСтрока);
			Таб.Вывести(оСтрока);
			Ном = Ном + 1;	
		КонецЦикла;	
	КонецЦикла;	
 	// Подвал
	ОбластьПодвалСчета = Макет.ПолучитьОбласть("ПодвалЗаказа");
	ОбластьПодвалСчета.Параметры.ФиоИсполнителя = Справочники.ДоговорыСКонтрагентами.ПолучитьКуратораДоговора(Док.Договор, Док.Дата).Менеджер;
	Таб.Вывести(ОбластьПодвалСчета);
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.АвтоМасштаб = Истина;
	Таб.ИспользуемоеИмяФайла = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, "Commande client");
КонецПроцедуры

Функция ПолучитьТоварыПоГруппировкам(Док) Экспорт
	ТипДокумента = Док.ПолучитьОбъект().Метаданные().Имя;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(ТЗДопСведения.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(ТЗДопСведения.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	                      |	ВЫРАЗИТЬ(ТЗДопСведения.Описание КАК СТРОКА) КАК Описание
	                      |ПОМЕСТИТЬ ВТДопСведения
	                      |ИЗ
	                      |	&ТЗДопСведения КАК ТЗДопСведения
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТЧТовары.КодСтроки КАК КодСтроки,
	                      |	ТЧТовары.Номенклатура КАК Номенклатура,
	                      |	ТЧТовары.Характеристика КАК Характеристика,
	                      |	ТЧТовары.НоменклатураСтрока КАК НоменклатураСтрока,
	                      |	ТЧТовары.КоличествоУпаковок КАК Количество,
	                      |	ВЫБОР
	                      |		КОГДА ТЧТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Единица
	                      |		ИНАЧЕ ТЧТовары.Упаковка
	                      |	КОНЕЦ КАК Единица,
	                      |	ЕСТЬNULL(ВТДопСведения.Описание, """") КАК Комментарий,
	                      |	ВЫБОР
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель.Родитель
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель.Родитель.Родитель
	                      |	КОНЕЦ КАК Группа
	                      |ИЗ
	                      |	Документ."+ТипДокумента+".ТЧТовары КАК ТЧТовары
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТДопСведения КАК ВТДопСведения
	                      |		ПО ТЧТовары.Номенклатура = ВТДопСведения.Номенклатура
	                      |			И ТЧТовары.Характеристика = ВТДопСведения.Характеристика
	                      |ГДЕ
	                      |	ТЧТовары.Ссылка = &Док
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Группа,
	                      |	ТЧТовары.Номенклатура.Наименование
	                      |ИТОГИ ПО
	                      |	Группа");	
	Запрос.УстановитьПараметр("Док", Док);
	Запрос.УстановитьПараметр("ТЗДопСведения", РегистрыСведений.ДополнительныеСведенияНоменклатуры.ПолучитьПоКонтрагенту(Док.Контрагент));
	Возврат Запрос.Выполнить();
КонецФункции

#Область ОбработчикиСобытий

// Вид операции нужен представлению заказа на производство; номер и дата - стандартному представлению.
//
// Параметры:
//  Поля                 - Массив из Строка - поля, читаемые для представления
//  СтандартнаяОбработка - Булево           - сбрасывается: состав полей задаётся здесь
//
Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("ВидОперации");
КонецПроцедуры

// Заказ на производство называется по виду операции; у продаж и пустого вида операции представление
// стандартное, как до появления реквизита. Обработчик может выполняться на клиенте - только
// клиент-серверные функции.
//
// Параметры:
//  Данные               - Структура - значения полей из ОбработкаПолученияПолейПредставления
//  Представление        - Строка    - формируемое представление
//  СтандартнаяОбработка - Булево    - сбрасывается только для заказа на производство
//
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	Если Данные.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказаПокупателя.Производство") Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Шаблон = НСтр("ru = 'Заказ клиента на производство %1 от %2';
		|fr = 'Commande client en production %1 du %2';
		|en = 'Customer production order %1 dated %2';
		|es = 'Pedido de cliente para producción %1 del %2'");
	ДатаДокумента = Формат(Данные.Дата, "ДЛФ=DT");
	Представление = СтрШаблон(Шаблон, Данные.Номер, ДатаДокумента);
КонецПроцедуры

// Роли ECommerce - упрощённая форма документа. Стандартная обработка отключается только вместе
// с назначением формы: СтандартнаяОбработка = Ложь без ВыбраннаяФорма открывает пустую форму -
// так пропадал список «Заказы клиентов на производство» у пользователя с ролью ECommerce.
//
// Параметры:
//  ВидФормы                 - Строка    - вид или имя открываемой формы
//  Параметры                - Структура - параметры формы
//  ВыбраннаяФорма           - Строка    - имя подставляемой формы
//  ДополнительнаяИнформация - Структура - дополнительные сведения открытия
//  СтандартнаяОбработка     - Булево    - сбрасывается только при подмене формы
//
Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	Если ВидФормы = "ФормаОбъекта" И РольДоступна("ECommerce") Тогда
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = "ФормаДокументаECommerce";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

