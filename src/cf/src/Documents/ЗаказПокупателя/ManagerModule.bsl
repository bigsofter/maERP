КонецФункции

// Добавляет описание печатной формы в список.
//
// Параметры:
//  Описания      - Массив - пополняемый список описаний
//  ИмяМакета     - Строка - идентификатор печатной формы
//  Представление - Строка - название для пользователя
//  ПутьКМакету   - Строка - путь макета для правки пользователем
//
Процедура ДобавитьОписаниеПечатнойФормы(Описания, ИмяМакета, Представление, ПутьКМакету)

	Описание = Новый Структура("ИмяМакета, Представление, ПутьКМакету",
		ИмяМакета, Представление, ПутьКМакету);
	Описания.Добавить(Описание);

КонецПроцедуры

// Выводит одну печатную форму документа.
//
// Параметры:
//  ИмяМакета - Строка                             - идентификатор печатной формы
//  Док       - ДокументСсылка.ЗаказПокупателя      - печатаемый документ
//  Таб       - ТабличныйДокумент                   - документ вывода
//
Процедура ВывестиПечатнуюФорму(ИмяМакета, Док, Таб)

	Если ИмяМакета = "Заказ" Тогда
		ПечатьЗаказа(Док, Таб);
	ИначеЕсли ИмяМакета = "ЗаказКлиента" Тогда
		Документы.РеализацияТоваровУслуг.PrintDevisA4(Док, Таб, "Bon de commande");
	ИначеЕсли ИмяМакета = "КоммерческоеПредложение" Тогда
		Документы.РеализацияТоваровУслуг.PrintDevisBL(Док, Таб);
	ИначеЕсли ИмяМакета = "КоммерческоеПредложениеА4" Тогда
		Документы.РеализацияТоваровУслуг.PrintDevisA4(Док, Таб);
	ИначеЕсли ИмяМакета = "КоммерческоеПредложениеА4БезНДС" Тогда
		Документы.РеализацияТоваровУслуг.PrintDevisA4HT(Док, Таб, "Devis");
	ИначеЕсли ИмяМакета = "КоммерческоеПредложениеА4БезЦен" Тогда
		Документы.РеализацияТоваровУслуг.PrintDevisA4(Док, Таб, "Devis", Истина);
	ИначеЕсли ИмяМакета = "Проформа" Тогда
		Документы.РеализацияТоваровУслуг.PrintDevisA4HT(Док, Таб, "Facture proforma");
	Иначе
		ШаблонОшибки = НСтр("ru = 'Печатная форма заказа покупателя не поддерживается: %1';
			|fr = 'Le formulaire imprimable de la commande client n''est pas pris en charge : %1';
			|en = 'The customer order print form is not supported: %1';
			|es = 'El formulario de impresión del pedido de cliente no es compatible: %1'");
		ВызватьИсключение СтрШаблон(ШаблонОшибки, ИмяМакета);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

Процедура ПечатьЗаказа(Док, Таб) Экспорт
	Макет = ПечатныеФормы.МакетПечатнойФормы("Документ.ЗаказПокупателя.Заказ");
	// Шапка
	оЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	оЗаголовок.Параметры.ТекстЗаголовка = "Commande client № " + Док.Номер + " de " + Формат(Док.Дата, "ДЛФ=DD");
	//оЗаголовок.Параметры.АдресДоставки = Док.Контрагент.Наименование;
	//оЗаголовок.Параметры.Маршрут = Справочники.Маршруты.ПолучитьПоТорговойТочке(Док.Контрагент);
	Таб.Вывести(оЗаголовок);
	
	оПоставщик = Макет.ПолучитьОбласть("Поставщик");
	КарточкаОрганизации = Справочники.Контрагенты.ПолучитьКарточку(Док.Организация, Док.Дата);
	оПоставщик.Параметры.ПредставлениеПоставщика = КарточкаОрганизации.Наименование 
	+ ", ICE " + КарточкаОрганизации.Реквизиты.ICE + ", " 
	+ КарточкаОрганизации.АдресЮридический;
	Таб.Вывести(оПоставщик);
	
	оПокупатель = Макет.ПолучитьОбласть("Покупатель");
	КарточкаПокупателя = Справочники.Контрагенты.ПолучитьКарточку(Док.Контрагент, Док.Дата);
	оПокупатель.Параметры.ПредставлениеПокупателя = КарточкаПокупателя.Наименование
	+ ", ICE " + КарточкаПокупателя.Реквизиты.ICE + ", " 
	+ КарточкаПокупателя.АдресЮридический + ", tel.: " + КарточкаПокупателя.Телефоны;
	Таб.Вывести(оПокупатель);
	
	оШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	Таб.Вывести(оШапкаТаблицы);
	// Строки
	Рез = ПолучитьТоварыПоГруппировкам(Док);
	ВыбГруппа = Рез.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	Ном = 1;
	Пока ВыбГруппа.Следующий() Цикл
		оГруппа = Макет.ПолучитьОбласть("Группа");
		оГруппа.Параметры.Наименование = ?(ЗначениеЗаполнено(ВыбГруппа.Группа), ВыбГруппа.Группа, "Autres");
		Таб.Вывести(оГруппа);
		Выб = ВыбГруппа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выб.Следующий() Цикл
			оСтрока = Макет.ПолучитьОбласть("Строка");
			оСтрока.Параметры.Заполнить(Выб);
			оСтрока.Параметры.НомерСтроки = Ном;
			оСтрока.Параметры.Товар = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Выб.Номенклатура,
				Выб.Характеристика, , Истина, Выб.НоменклатураСтрока);
			Таб.Вывести(оСтрока);
			Ном = Ном + 1;	
		КонецЦикла;	
	КонецЦикла;	
 	// Подвал
	ОбластьПодвалСчета = Макет.ПолучитьОбласть("ПодвалЗаказа");
	ОбластьПодвалСчета.Параметры.ФиоИсполнителя = Справочники.ДоговорыСКонтрагентами.ПолучитьКуратораДоговора(Док.Договор, Док.Дата).Менеджер;
	Таб.Вывести(ОбластьПодвалСчета);
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.АвтоМасштаб = Истина;
	Таб.ИспользуемоеИмяФайла = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, "Commande client");
КонецПроцедуры

Функция ПолучитьТоварыПоГруппировкам(Док) Экспорт
	ТипДокумента = Док.ПолучитьОбъект().Метаданные().Имя;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(ТЗДопСведения.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(ТЗДопСведения.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	                      |	ВЫРАЗИТЬ(ТЗДопСведения.Описание КАК СТРОКА) КАК Описание
	                      |ПОМЕСТИТЬ ВТДопСведения
	                      |ИЗ
	                      |	&ТЗДопСведения КАК ТЗДопСведения
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТЧТовары.КодСтроки КАК КодСтроки,
	                      |	ТЧТовары.Номенклатура КАК Номенклатура,
	                      |	ТЧТовары.Характеристика КАК Характеристика,
	                      |	ТЧТовары.НоменклатураСтрока КАК НоменклатураСтрока,
	                      |	ТЧТовары.КоличествоУпаковок КАК Количество,
	                      |	ВЫБОР
	                      |		КОГДА ТЧТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Единица
	                      |		ИНАЧЕ ТЧТовары.Упаковка
	                      |	КОНЕЦ КАК Единица,
	                      |	ЕСТЬNULL(ВТДопСведения.Описание, """") КАК Комментарий,
	                      |	ВЫБОР
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель.Родитель
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель.Родитель.Родитель
	                      |	КОНЕЦ КАК Группа
	                      |ИЗ
	                      |	Документ."+ТипДокумента+".ТЧТовары КАК ТЧТовары
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТДопСведения КАК ВТДопСведения
	                      |		ПО ТЧТовары.Номенклатура = ВТДопСведения.Номенклатура
	                      |			И ТЧТовары.Характеристика = ВТДопСведения.Характеристика
	                      |ГДЕ
	                      |	ТЧТовары.Ссылка = &Док
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Группа,
	                      |	ТЧТовары.Номенклатура.Наименование
	                      |ИТОГИ ПО
	                      |	Группа");	
	Запрос.УстановитьПараметр("Док", Док);
	Запрос.УстановитьПараметр("ТЗДопСведения", РегистрыСведений.ДополнительныеСведенияНоменклатуры.ПолучитьПоКонтрагенту(Док.Контрагент));
	Возврат Запрос.Выполнить();
КонецФункции

#Область ОбработчикиСобытий

// Вид операции нужен представлению заказа на производство; номер и дата - стандартному представлению.
//
// Параметры:
//  Поля                 - Массив из Строка - поля, читаемые для представления
//  СтандартнаяОбработка - Булево           - сбрасывается: состав полей задаётся здесь
//
Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("ВидОперации");
КонецПроцедуры

// Заказ на производство называется по виду операции; у продаж и пустого вида операции представление
// стандартное, как до появления реквизита. Обработчик может выполняться на клиенте - только
// клиент-серверные функции.
//
// Параметры:
//  Данные               - Структура - значения полей из ОбработкаПолученияПолейПредставления
//  Представление        - Строка    - формируемое представление
//  СтандартнаяОбработка - Булево    - сбрасывается только для заказа на производство
//
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	Если Данные.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказаПокупателя.Производство") Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Шаблон = НСтр("ru = 'Заказ клиента на производство %1 от %2';
		|fr = 'Commande client en production %1 du %2';
		|en = 'Customer production order %1 dated %2';
		|es = 'Pedido de cliente para producción %1 del %2'");
	ДатаДокумента = Формат(Данные.Дата, "ДЛФ=DT");
	Представление = СтрШаблон(Шаблон, Данные.Номер, ДатаДокумента);
КонецПроцедуры

// Роли ECommerce - упрощённая форма документа. Стандартная обработка отключается только вместе
// с назначением формы: СтандартнаяОбработка = Ложь без ВыбраннаяФорма открывает пустую форму -
// так пропадал список «Заказы клиентов на производство» у пользователя с ролью ECommerce.
//
// Параметры:
//  ВидФормы                 - Строка    - вид или имя открываемой формы
//  Параметры                - Структура - параметры формы
//  ВыбраннаяФорма           - Строка    - имя подставляемой формы
//  ДополнительнаяИнформация - Структура - дополнительные сведения открытия
//  СтандартнаяОбработка     - Булево    - сбрасывается только при подмене формы
//
Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	Если ВидФормы = "ФормаОбъекта" И РольДоступна("ECommerce") Тогда
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = "ФормаДокументаECommerce";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


