		НСтр("ru = 'Бланк заказа (A4)'; fr = 'Bon de commande (A4)';
			|en = 'Order form (A4)'; es = 'Hoja de pedido (A4)'"),
		ПутьМакетаА4);
	ДобавитьОписаниеПечатнойФормы(Описания, "КоммерческоеПредложение",
		НСтр("ru = 'Коммерческое предложение (A5)'; fr = 'Devis (A5)';
			|en = 'Quotation (A5)'; es = 'Presupuesto (A5)'"),
		"Документ.РеализацияТоваровУслуг.DevisBL");
	ДобавитьОписаниеПечатнойФормы(Описания, "КоммерческоеПредложениеА4",
		НСтр("ru = 'Коммерческое предложение (A4)'; fr = 'Devis (A4)';
			|en = 'Quotation (A4)'; es = 'Presupuesto (A4)'"),
		ПутьМакетаА4);
