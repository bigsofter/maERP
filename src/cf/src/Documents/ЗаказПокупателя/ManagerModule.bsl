// Счета реализаций, введённых по заказам (не помеченных на удаление), - в результат адаптера массивами по заказу.
//
// Параметры:
//  Результат - Соответствие - пополняемый результат адаптера.
//  Заказы    - Массив из ДокументСсылка.ЗаказПокупателя - печатаемые заказы.
//  ВидФормы  - Строка - вид фирменной формы.
//  КодЯзыка  - Строка - язык печати.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПокупателя - заказы без реализаций: их счёт печатается по самому заказу.
//
Функция ДобавитьСчетаРеализаций(Результат, Заказы, ВидФормы, КодЯзыка)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Реализация.Ссылка КАК Ссылка,
	|	Реализация.Основание КАК Заказ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Основание В(&Заказы)
	|	И НЕ Реализация.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реализация.Дата,
	|	Реализация.Ссылка");
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Реализации = Запрос.Выполнить().Выгрузить();
	Если Реализации.Количество() > 0 Тогда
		Счета = Документы.РеализацияТоваровУслуг.ДанныеФирменнойПечати(Реализации.ВыгрузитьКолонку("Ссылка"), ВидФормы,
			КодЯзыка, Новый Структура);
		Для Каждого Строка Из Реализации Цикл
			Источники = Результат[Строка.Заказ];
			Если Источники = Неопределено Тогда
				Источники = Новый Массив;
				Результат.Вставить(Строка.Заказ, Источники);
			КонецЕсли;
			Источник = Счета[Строка.Ссылка];
			Если Источник <> Неопределено Тогда
				Источники.Добавить(Источник);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	БезРеализаций = Новый Массив;
	Для Каждого Заказ Из Заказы Цикл
		Если Результат[Заказ] = Неопределено Тогда
			БезРеализаций.Добавить(Заказ);
		КонецЕсли;
	КонецЦикла;
	Возврат БезРеализаций;
КонецФункции

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Строки товаров заказов &Документы, свежие заказы первыми (закладка «Товары»).
//
// Параметры:
//  ЕстьОтборТовара - Булево - только строки товара &Товар.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаСтрокТоваров(ЕстьОтборТовара)

	Текст =
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Документ,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Проведен КАК Проведен,
	|	Д.ПометкаУдаления КАК ПометкаУдаления,
	|	Д.ВерсияДанных КАК ВерсияДанных,
	|	Д.Контрагент КАК Клиент,
	|	Д.Организация КАК Организация,
	|	Д.ВВалюте КАК ВВалюте,
	|	Д.Валюта КАК Валюта,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Упаковка КАК Упаковка,
	|	Т.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Т.Цена КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	Т.Техкарта КАК Техкарта
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.ТЧТовары КАК Т
	|		ПО (Т.Ссылка = Д.Ссылка)
	|ГДЕ
	|	Д.Ссылка В (&Документы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Документ УБЫВ,
	|	НомерСтроки";
	Если ЕстьОтборТовара Тогда
		Текст = СтрЗаменить(Текст, "Д.Ссылка В (&Документы)", "Д.Ссылка В (&Документы)
		|	И Т.Номенклатура = &Товар");
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Последние заказы-продажи по отборам закладки, свежие первыми.
//
// Параметры:
//  Отборы - Структура - см. НовыеОтборыСтрокТоваров.
//  Предел - Число - сколько заказов прочитать.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПокупателя - заказы.
//
Функция ПоследниеЗаказыПоОтборам(Отборы, Предел)

	Условия = Новый Массив;
	Условия.Добавить("Д.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказаПокупателя.Производство)");
	Запрос = Новый Запрос;
	Для Каждого Имя Из СтрРазделить("Контрагент,Организация,Ответственный", ",") Цикл
		Если ЗначениеЗаполнено(Отборы[Имя]) Тогда
			Условия.Добавить(СтрШаблон("Д.%1 = &%1", Имя));
			Запрос.УстановитьПараметр(Имя, Отборы[Имя]);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Отборы.Товар) Тогда
		Условия.Добавить("Д.Ссылка В (ВЫБРАТЬ ТТ.Ссылка ИЗ Документ.ЗаказПокупателя.ТЧТовары КАК ТТ ГДЕ ТТ.Номенклатура = &Товар)");
		Запрос.УстановитьПараметр("Товар", Отборы.Товар);
	КонецЕсли;
	// Роль со скрытыми суммами не отбирает по ним: иначе отбор раскрыл бы сумму.
	Если Не ФирменнаяПечать.ЦеныСкрыты() И ЗначениеЗаполнено(Отборы.Сумма) Тогда
		Условия.Добавить("Д.Сумма " + СтрокиТоваровСписков.ЗнакСравнения(Отборы.СуммаУсловие) + " &Сумма");
		Запрос.УстановитьПараметр("Сумма", Отборы.Сумма);
	КонецЕсли;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Д.Ссылка КАК Ссылка,
	|	Д.Дата КАК Дата
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Д
	|ГДЕ
	|	&УсловияОтбора
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Ссылка УБЫВ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбора", СтрСоединить(Условия, Символы.ПС + "	И "));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1", "ПЕРВЫЕ " + Формат(Предел, "ЧГ=0"));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Запреты правки заказов (ТекстЗапретаПоПризнакам) одним запросом признаков и статусами.
//
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказПокупателя - заказы, прочитанные с правами пользователя.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ - заказ, значение - текст запрета; пустая строка - правка допустима.
//
Функция ЗапретыПравкиЗаказов(Заказы)

	Запреты = Новый Соответствие;
	Если Заказы.Количество() = 0 Тогда
		Возврат Запреты;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка,
	|	Д.ВидОперации КАК ВидОперации,
	|	Д.Ссылка В
	|			(ВЫБРАТЬ
	|				М.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.ЗаказПокупателя.ТЧМатериалы КАК М
	|			ГДЕ
	|				М.Ссылка В (&Документы))
	|		ИЛИ Д.Ссылка В
	|			(ВЫБРАТЬ
	|				ТК.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.ЗаказПокупателя.ТЧТовары КАК ТК
	|			ГДЕ
	|				ТК.Ссылка В (&Документы)
	|				И ТК.Техкарта <> ЗНАЧЕНИЕ(Документ.ТехнологическаяКарта.ПустаяСсылка)) КАК ЕстьПроизводство
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Д
	|ГДЕ
	|	Д.Ссылка В (&Документы)");
	Запрос.УстановитьПараметр("Документы", Заказы);
	ЗакрытыеСтатусы = ЗаказыСЗакрытымСтатусом(Заказы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗакрытыйСтатус = ЗакрытыеСтатусы.Найти(Выборка.Ссылка) <> Неопределено;
		Текст = ТекстЗапретаПоПризнакам(Выборка.ВидОперации, Выборка.ЕстьПроизводство, ЗакрытыйСтатус);
		Запреты.Вставить(Выборка.Ссылка, Текст);
	КонецЦикла;
	Возврат Запреты;

КонецФункции

// Текст запрета правки заказа с закладки: закладка ведёт только заказ-продажу, статус которого пересчитывается записью.
//
// Параметры:
//  ВидОперации     - ПеречислениеСсылка.ВидыОперацийЗаказаПокупателя - вид операции; пустой - продажа.
//  ЕстьПроизводство - Булево - в заказе есть материалы или технологические карты строк.
//  ЗакрытыйСтатус  - Булево - последний статус продажи - собран, отгружен, доставлен или выполнен.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - правка допустима.
//
Функция ТекстЗапретаПоПризнакам(ВидОперации, ЕстьПроизводство, ЗакрытыйСтатус)

	Если ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство Или ЕстьПроизводство Тогда
		Возврат ТекстЗапретаПроизводства();
	ИначеЕсли ЗакрытыйСтатус Тогда
		// Эти статусы запись заказа сохраняет как есть, не пересчитывая по изменённому количеству (ревью плана, круг 8).
		Возврат НСтр("ru = 'Заказ уже собран, отгружен или выполнен: правьте заказ в форме документа.';
			|fr = 'La commande est déjà préparée, expédiée ou terminée : modifiez-la dans le document.';
			|en = 'The order is already picked, shipped or completed: edit it in the document form.';
			|es = 'El pedido ya está preparado, enviado o completado: edítelo en el documento.'");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

Функция ТекстЗапретаПроизводства()

	Возврат НСтр("ru = 'Заказ на производство (материалы, технологические карты): правьте его в форме документа.';
		|fr = 'Commande en production (matières, gammes) : modifiez-la dans le document.';
		|en = 'Production order (materials, routings): edit it in the document form.';
		|es = 'Pedido para producción (materiales, rutas): edítelo en el documento.'");

КонецФункции

// Заказы, последний статус продажи которых (срез последних без индикатора стадии, как ЗаписатьСтатусПродажи объекта) -
// собран, отгружен, доставлен или выполнен. Независимо от права чтения истории статусов: наружу - только подмножество
// переданных заказов, прочитанных с правами пользователя.
//
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказПокупателя - заказы.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПокупателя - заказы с закрытым статусом.
//
Функция ЗаказыСЗакрытымСтатусом(Заказы)

	Если Заказы.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.СтатусыЗаказовПокупателя.Собран);
	Статусы.Добавить(Перечисления.СтатусыЗаказовПокупателя.Отгружен);
	Статусы.Добавить(Перечисления.СтатусыЗаказовПокупателя.Доставлен);
	Статусы.Добавить(Перечисления.СтатусыЗаказовПокупателя.Выполнен);
	// BSLLS:SetPrivilegedMode-off - узкая проверка факта статуса, см. комментарий выше.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	История.ЗаказПокупателя КАК Заказ
	|ИЗ
	|	РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних(, ЗаказПокупателя В (&Заказы)) КАК История
	|ГДЕ
	|	История.Индикатор = """"
	|	И История.СтатусЗаказаПокупателя В (&Статусы)");
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");
	// BSLLS:SetPrivilegedMode-off - снятие режима, включённого выше.
	УстановитьПривилегированныйРежим(Ложь);
	// BSLLS:SetPrivilegedMode-on
	Возврат Результат;

КонецФункции

#КонецЕсли

#КонецОбласти

Процедура ПечатьЗаказа(Док, Таб) Экспорт
	Макет = ПечатныеФормы.МакетПечатнойФормы("Документ.ЗаказПокупателя.Заказ");
	// Шапка
	оЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	оЗаголовок.Параметры.ТекстЗаголовка = "Commande client № " + Док.Номер + " de " + Формат(Док.Дата, "ДЛФ=DD");
	//оЗаголовок.Параметры.АдресДоставки = Док.Контрагент.Наименование;
	//оЗаголовок.Параметры.Маршрут = Справочники.Маршруты.ПолучитьПоТорговойТочке(Док.Контрагент);
	Таб.Вывести(оЗаголовок);
	
	оПоставщик = Макет.ПолучитьОбласть("Поставщик");
	КарточкаОрганизации = Справочники.Контрагенты.ПолучитьКарточку(Док.Организация, Док.Дата);
	оПоставщик.Параметры.ПредставлениеПоставщика = КарточкаОрганизации.Наименование 
	+ ", ICE " + КарточкаОрганизации.Реквизиты.ICE + ", " 
	+ КарточкаОрганизации.АдресЮридический;
	Таб.Вывести(оПоставщик);
	
	оПокупатель = Макет.ПолучитьОбласть("Покупатель");
	КарточкаПокупателя = Справочники.Контрагенты.ПолучитьКарточку(Док.Контрагент, Док.Дата);
	оПокупатель.Параметры.ПредставлениеПокупателя = КарточкаПокупателя.Наименование
	+ ", ICE " + КарточкаПокупателя.Реквизиты.ICE + ", " 
	+ КарточкаПокупателя.АдресЮридический + ", tel.: " + КарточкаПокупателя.Телефоны;
	Таб.Вывести(оПокупатель);
	
	оШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	Таб.Вывести(оШапкаТаблицы);
	// Строки
	Рез = ПолучитьТоварыПоГруппировкам(Док);
	ВыбГруппа = Рез.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	Ном = 1;
	Пока ВыбГруппа.Следующий() Цикл
		оГруппа = Макет.ПолучитьОбласть("Группа");
		оГруппа.Параметры.Наименование = ?(ЗначениеЗаполнено(ВыбГруппа.Группа), ВыбГруппа.Группа, "Autres");
		Таб.Вывести(оГруппа);
		Выб = ВыбГруппа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выб.Следующий() Цикл
			оСтрока = Макет.ПолучитьОбласть("Строка");
			оСтрока.Параметры.Заполнить(Выб);
			оСтрока.Параметры.НомерСтроки = Ном;
			оСтрока.Параметры.Товар = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Выб.Номенклатура,
				Выб.Характеристика, , Истина, Выб.НоменклатураСтрока);
			Таб.Вывести(оСтрока);
			Ном = Ном + 1;	
		КонецЦикла;	
	КонецЦикла;	
 	// Подвал
	ОбластьПодвалСчета = Макет.ПолучитьОбласть("ПодвалЗаказа");
	ОбластьПодвалСчета.Параметры.ФиоИсполнителя = Справочники.ДоговорыСКонтрагентами.ПолучитьКуратораДоговора(Док.Договор, Док.Дата).Менеджер;
	Таб.Вывести(ОбластьПодвалСчета);
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.АвтоМасштаб = Истина;
	Таб.ИспользуемоеИмяФайла = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, "Commande client");
КонецПроцедуры

Функция ПолучитьТоварыПоГруппировкам(Док) Экспорт
	ТипДокумента = Док.ПолучитьОбъект().Метаданные().Имя;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(ТЗДопСведения.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(ТЗДопСведения.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	                      |	ВЫРАЗИТЬ(ТЗДопСведения.Описание КАК СТРОКА) КАК Описание
	                      |ПОМЕСТИТЬ ВТДопСведения
	                      |ИЗ
	                      |	&ТЗДопСведения КАК ТЗДопСведения
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТЧТовары.КодСтроки КАК КодСтроки,
	                      |	ТЧТовары.Номенклатура КАК Номенклатура,
	                      |	ТЧТовары.Характеристика КАК Характеристика,
	                      |	ТЧТовары.НоменклатураСтрока КАК НоменклатураСтрока,
	                      |	ТЧТовары.КоличествоУпаковок КАК Количество,
	                      |	ВЫБОР
	                      |		КОГДА ТЧТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Единица
	                      |		ИНАЧЕ ТЧТовары.Упаковка
	                      |	КОНЕЦ КАК Единица,
	                      |	ЕСТЬNULL(ВТДопСведения.Описание, """") КАК Комментарий,
	                      |	ВЫБОР
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель.Родитель
	                      |		КОГДА ТЧТовары.Номенклатура.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА ТЧТовары.Номенклатура.Родитель.Родитель.Родитель
	                      |	КОНЕЦ КАК Группа
	                      |ИЗ
	                      |	Документ."+ТипДокумента+".ТЧТовары КАК ТЧТовары
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТДопСведения КАК ВТДопСведения
	                      |		ПО ТЧТовары.Номенклатура = ВТДопСведения.Номенклатура
	                      |			И ТЧТовары.Характеристика = ВТДопСведения.Характеристика
	                      |ГДЕ
	                      |	ТЧТовары.Ссылка = &Док
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Группа,
	                      |	ТЧТовары.Номенклатура.Наименование
	                      |ИТОГИ ПО
	                      |	Группа");	
	Запрос.УстановитьПараметр("Док", Док);
	Запрос.УстановитьПараметр("ТЗДопСведения", РегистрыСведений.ДополнительныеСведенияНоменклатуры.ПолучитьПоКонтрагенту(Док.Контрагент));
	Возврат Запрос.Выполнить();
КонецФункции

#Область ОбработчикиСобытий

// Вид операции нужен представлению заказа на производство; номер и дата - стандартному представлению.
//
// Параметры:
//  Поля                 - Массив из Строка - поля, читаемые для представления
//  СтандартнаяОбработка - Булево           - сбрасывается: состав полей задаётся здесь
//
Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("ВидОперации");
КонецПроцедуры

// Заказ на производство называется по виду операции; у продаж и пустого вида операции представление
// стандартное, как до появления реквизита. Обработчик может выполняться на клиенте - только
// клиент-серверные функции.
//
// Параметры:
//  Данные               - Структура - значения полей из ОбработкаПолученияПолейПредставления
//  Представление        - Строка    - формируемое представление
//  СтандартнаяОбработка - Булево    - сбрасывается только для заказа на производство
//
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	Если Данные.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказаПокупателя.Производство") Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Шаблон = НСтр("ru = 'Заказ клиента на производство %1 от %2';
		|fr = 'Commande client en production %1 du %2';
		|en = 'Customer production order %1 dated %2';
		|es = 'Pedido de cliente para producción %1 del %2'");
	ДатаДокумента = Формат(Данные.Дата, "ДЛФ=DT");
	Представление = СтрШаблон(Шаблон, Данные.Номер, ДатаДокумента);
КонецПроцедуры

// Роли ECommerce - упрощённая форма документа. Стандартная обработка отключается только вместе
// с назначением формы: СтандартнаяОбработка = Ложь без ВыбраннаяФорма открывает пустую форму -
// так пропадал список «Заказы клиентов на производство» у пользователя с ролью ECommerce.
//
// Параметры:
//  ВидФормы                 - Строка    - вид или имя открываемой формы
//  Параметры                - Структура - параметры формы
//  ВыбраннаяФорма           - Строка    - имя подставляемой формы
//  ДополнительнаяИнформация - Структура - дополнительные сведения открытия
//  СтандартнаяОбработка     - Булево    - сбрасывается только при подмене формы
//
Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	Если ВидФормы = "ФормаОбъекта" И РольДоступна("ECommerce") Тогда
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = "ФормаДокументаECommerce";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

