
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	ЦенаВключаетНДС = Истина;
	ДатаОтгрузки = ТекущаяДатаСеанса(); 
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ЗаполнитьПоРеализации(ДанныеЗаполнения);
	КонецЕсли;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КоммерческоеПредложение") Тогда
		ЗаполнитьПоКоммерческомуПредложению(ДанныеЗаполнения);
	КонецЕсли;
	// Из списка заказов на производство: Структура с полями Предложение и НаПроизводство.
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("Предложение")
		И ТипЗнч(ДанныеЗаполнения.Предложение) = Тип("ДокументСсылка.КоммерческоеПредложение") Тогда
		ЗаполнитьПоКоммерческомуПредложению(ДанныеЗаполнения.Предложение,
			ДанныеЗаполнения.Свойство("НаПроизводство") И ДанныеЗаполнения.НаПроизводство = Истина);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьПоРеализации(Реализация)
	// Заказ по совершившейся продаже: контрагент, цены и состав из реализации-основания.
	Основание = Реализация;
	Организация = Реализация.Организация;
	Контрагент = Реализация.Контрагент;
	Договор = Реализация.Договор;
	Менеджер = Реализация.Менеджер;
	ЦенаВключаетНДС = Реализация.ЦенаВключаетНДС;
	Для Каждого Стр Из Реализация.ТЧТовары Цикл
		НС = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Стр);
	КонецЦикла;
КонецПроцедуры

// Заказ по коммерческому предложению: шапка и строки из предложения. Заказ на производство - если так запрошено
// (создание из списка заказов на производство) или в предложении есть производимая номенклатура; материалы - сразу.
//
// Параметры:
//  Предложение    - ДокументСсылка.КоммерческоеПредложение - основание
//  НаПроизводство - Булево - создать заказ на производство независимо от номенклатуры предложения
//
Процедура ЗаполнитьПоКоммерческомуПредложению(Предложение, НаПроизводство = Ложь)
	Основание = Предложение;
	Организация = Предложение.Организация;
	Контрагент = Предложение.Контрагент;
	Договор = Предложение.Договор;
	Менеджер = Предложение.Менеджер;
	ДатаОтгрузки = Предложение.ДатаОтгрузки;
	ЦенаВключаетНДС = Предложение.ЦенаВключаетНДС;
	Комментарий = Предложение.Комментарий;
	Для Каждого СтрокаПредложения Из Предложение.ТЧТовары Цикл
		СтрокаЗаказа = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗаказа, СтрокаПредложения);
	КонецЦикла;
	Если НаПроизводство И ПолучитьФункциональнуюОпцию("Производство")
		Или ПредложениеСодержитПроизводимуюНоменклатуру(Предложение) Тогда
		ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
		// Решение владельца 2026-09-13: заказ на производство по КП получает материалы сразу.
		Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(ТЧТовары, ТЧМатериалы, Дата, , Истина, ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

// Предложение ведёт к заказу на производство, если учёт производства включён и хотя бы одна
// позиция пополняется производством (в том числе «Оба»).
//
// Параметры:
//  Предложение - ДокументСсылка.КоммерческоеПредложение - основание заказа
//
// Возвращаемое значение:
//  Булево - Истина, если заказ по предложению - заказ на производство
//
Функция ПредложениеСодержитПроизводимуюНоменклатуру(Предложение)
	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат Ложь;
	КонецЕсли;
	Способы = Новый Массив;
	Способы.Добавить(Перечисления.СпособыПополненияЗапасов.Производство);
	Способы.Добавить(Перечисления.СпособыПополненияЗапасов.Оба);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварыПредложения.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.КоммерческоеПредложение.ТЧТовары КАК ТоварыПредложения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО СправочникНоменклатура.Ссылка = ТоварыПредложения.Номенклатура
	|ГДЕ
	|	ТоварыПредложения.Ссылка = &Предложение
	|	И СправочникНоменклатура.СпособПополнения В (&Способы)";
	Запрос.УстановитьПараметр("Предложение", Предложение);
	Запрос.УстановитьПараметр("Способы", Способы);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Процедура ПриКопировании(ОбъектКопирования)
	Комментарий = "";
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Значение заполнения ставит «Продажа» при Заполнить(); страховка - для заказов, созданных кодом
	// без заполнения (кабинет партнёра, лиды), и для явно очищенного реквизита.
	Если Не ЗначениеЗаполнено(ВидОперации) Тогда
		ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	КонецЕсли;
	Если НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписи) И Не ПроверитьЗаполнение() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ПроверитьСменуВидаОперации(РежимЗаписи, Отказ);
	Если Не Отказ И РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Не Документы.ЗаказПокупателя.ЗаказПроводится(ВидОперации) Тогда
		// До ПриЗаписи: продажа не должна успеть записать статус заказа и отметить КП выигранным.
		СообщитьЗаказНеПроводится(Отказ);
	КонецЕсли;
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	Если Не Отказ Тогда
		СогласоватьМатериалы(Отказ);
	КонецЕсли;
	Если Не Отказ Тогда
		ПроверитьМатериалыПроведенногоЗаказа(РежимЗаписи, Отказ);
	КонецЕсли;
	Если Не Отказ И РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ПодготовитьПроведение(Отказ);
	КонецЕсли;
	РаботаСДокументами.ЗаполнитьИтогиДокумента(ЭтотОбъект);
	Если Не Отказ Тогда
		ПроизводственныеЗаказы.ЗапомнитьЗаказыДокумента(ЭтотОбъект, РежимЗаписи);
		// Отмена проведения документа, проведённого в базе: статус продажи пишет ОбработкаУдаленияПроведения (E8).
		ОтменаПроведенияЗаказа = РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
			И Не ЭтоНовый() И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен") = Истина;
		ДополнительныеСвойства.Вставить("ОтменаПроведенияЗаказа", ОтменаПроведенияЗаказа);
	КонецЕсли;
КонецПроцедуры

// Регистрация версий карт и отказы - в ПередЗаписью, где ещё можно записать колонку «Техкарта» (E6); там же
// берётся блокировка карт продукции, поэтому блокировка потребностей здесь - после неё, в той же транзакции.
// Отказ продаже - вторая линия на случай, если проверку в ПередЗаписью обойдут будущие правки; режим загрузки
// её не закрывает - загрузка проведение не выполняет. Движения - потребность в материалах (E7), после их записи -
// стадия заказа (E8, блокировка истории статусов последней).
//
// Параметры:
//  Отказ            - Булево - устанавливается у заказа, который не проводится.
//  РежимПроведения  - РежимПроведенияДокумента - не используется: оперативное проведение запрещено.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если Не Документы.ЗаказПокупателя.ЗаказПроводится(ВидОперации) Тогда
		СообщитьЗаказНеПроводится(Отказ);
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	Блокировка.Заблокировать();
	РегистрыНакопления.ПотребностиПроизводства.СформироватьДвижения(ЭтотОбъект);
	Движения.Записать();
	ПроизводственныеЗаказы.ОбновитьСтадииПослеПроведения(ЭтотОбъект);
КонецПроцедуры

// Отмена проведения заказа на производство: потребности очищаются под той же блокировкой, что при проведении, стадия
// становится «Черновик» (решение владельца 2026-09-14: отмена разрешена и при связанных закупках).
//
// Параметры:
//  Отказ - Булево - не используется.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	ПроизводственныеЗаказы.ОтменитьПроведениеДокумента(ЭтотОбъект, Блокировка);
	// Заказ, переведённый в продажу вместе с отменой проведения: статус продажи - после очистки потребностей, чтобы
	// история статусов блокировалась последней.
	Если ДополнительныеСвойства.Свойство("ОтменаПроведенияЗаказа") И ДополнительныеСвойства.ОтменаПроведенияЗаказа
		И ВидОперации <> Перечисления.ВидыОперацийЗаказаПокупателя.Производство Тогда
		ЗаписатьСтатусПродажи();
	КонецЕсли;
КонецПроцедуры

// Блокировки проведения и отмены проведения - один набор в одном порядке. Карты продукции блокируются в
// ПередЗаписью при проведении; отмена карту не пишет.
//
// Параметры:
//  Блокировка - БлокировкаДанных - заполняемая блокировка.
//
Процедура ЗаполнитьБлокировкуПроведения(Блокировка)
	УправляемыеБлокировки.ПотребностиПроизводства(Блокировка, Ссылка);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ECommerce Тогда
		Эл = ПроверяемыеРеквизиты.Найти("Организация");
		ПроверяемыеРеквизиты.Удалить(Эл);
	КонецЕсли;
	// Материалы проверяются только у заказа на производство: у заказа, переведённого в продажу, они
	// очищаются в ПередЗаписью, а проверка заполнения идёт раньше - и по скрытой таблице.
	Если ВидОперации <> Перечисления.ВидыОперацийЗаказаПокупателя.Производство
		Или Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		ИндексМатериала = ПроверяемыеРеквизиты.Найти("ТЧМатериалы.Номенклатура");
		Если ИндексМатериала <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ИндексМатериала);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Предложение отмечается первым: запись истории статусов - последняя в транзакции (E8).
	ОтметитьКоммерческоеПредложениеВыигранным(Основание);
	// Стадию заказа на производство и заказа, только что переведённого из производства, считает общий модуль;
	// проведение и отмену проведения - обработчики проведения.
	ПроизводственныеЗаказы.ОбновитьСтадииПриЗаписи(ЭтотОбъект);
	Если ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство
		Или ДополнительныеСвойства.Свойство("ОтменаПроведенияЗаказа") И ДополнительныеСвойства.ОтменаПроведенияЗаказа Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьСтатусПродажи();
КонецПроцедуры

// Статус заказа-продажи при записи: «Новый» или «В работе» после подтверждения менеджером. Отгруженные статусы не
// откатываются.
//
Процедура ЗаписатьСтатусПродажи()
	ЗаписыватьСтатус = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.СтатусЗаказаПокупателя КАК СтатусЗаказаПокупателя
	|ИЗ
	|	РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних(, ЗаказПокупателя = &ЗаказПокупателя) КАК ИсторияЗаказовПокупателейПоСтатусамСрезПоследних
	|ГДЕ
	|	ИсторияЗаказовПокупателейПоСтатусамСрезПоследних.Индикатор = """"";
	Запрос.УстановитьПараметр("ЗаказПокупателя",Ссылка); 
	
	// Последняя запись стадии (заполнен индикатор, E8) у заказа, переведённого из производства в продажу, считается
	// отсутствующей: продажа начинает историю статусов заново.
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Если Выборка.Количество() = 0 Тогда 
		ЗаписыватьСтатус = Истина;
		СтатусЗаписи = Перечисления.СтатусыЗаказовПокупателя.Новый;  
		Если Ссылка.МенеджерПодтвердилПроверилОстаток = Истина Тогда
			СтатусЗаписи = Перечисления.СтатусыЗаказовПокупателя.ВРаботе;		
		КонецЕсли;
	Иначе 
		СтатусЗаписи = Выборка[0].СтатусЗаказаПокупателя; 
		Если СтатусЗаписи = Перечисления.СтатусыЗаказовПокупателя.Новый Тогда 
			Если Ссылка.МенеджерПодтвердилПроверилОстаток = Истина Тогда
				ЗаписыватьСтатус = Истина;
				СтатусЗаписи = Перечисления.СтатусыЗаказовПокупателя.ВРаботе;  
			Иначе
				ЗаписыватьСтатус = Ложь;
			КонецЕсли;
		КонецЕсли;   
		Если СтатусЗаписи = Перечисления.СтатусыЗаказовПокупателя.Доставлен или 
			 СтатусЗаписи = Перечисления.СтатусыЗаказовПокупателя.Отгружен или 
			 СтатусЗаписи = Перечисления.СтатусыЗаказовПокупателя.Собран Тогда
			ЗаписыватьСтатус = Ложь;
		КонецЕсли;
	КонецЕсли; 
	
	Если ЗаписыватьСтатус = Истина тогда
		НоваяЗапись = РегистрыСведений.ИсторияЗаказовПокупателейПоСтатусам.СоздатьМенеджерЗаписи();
		НоваяЗапись.Период = РаботаСДокументами.ПериодЗаписиСтатусаЗаказа(Ссылка);
		НоваяЗапись.ЗаказПокупателя = Ссылка;
		НоваяЗапись.СтатусЗаказаПокупателя = СтатусЗаписи; 
		НоваяЗапись.Записать(Ложь);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтметитьКоммерческоеПредложениеВыигранным(Предложение)
	Если ТипЗнч(Предложение) <> Тип("ДокументСсылка.КоммерческоеПредложение") Тогда
		Возврат;
	КонецЕсли;
	Если Предложение.Статус = Перечисления.СтатусыКоммерческихПредложений.Выигран Тогда
		Возврат;
	КонецЕсли;
	ОбъектПредложения = Предложение.ПолучитьОбъект();
	ОбъектПредложения.Статус = Перечисления.СтатусыКоммерческихПредложений.Выигран;
	ОбъектПредложения.Записать();
КонецПроцедуры

// Материалы заказа на производство согласуются со строками товаров перед записью: подбор, штрихкод,
// автоподбор и форма ECommerce меняют товары, не зная о материалах. У заказа не на производство
// материалы очищаются (решение владельца 2026-09-13). Экспортная для тестов документов: отказ записи
// внутри транзакции сценария сделал бы её непригодной для дальнейших проверок.
//
// Параметры:
//  Отказ - Булево - устанавливается, если у одной продукции в разных строках разный состав.
//
Процедура СогласоватьМатериалы(Отказ) Экспорт
	Если ВидОперации <> Перечисления.ВидыОперацийЗаказаПокупателя.Производство Тогда
		ОчиститьМатериалыЗаказаНеНаПроизводство();
		Возврат;
	КонецЕсли;
	Если ТЧМатериалы.Количество() = 0 И Не ЕстьТехкартыСтрок() Тогда
		Возврат;
	КонецЕсли;
	РазвестиПовторныеКодыСтрокСМатериалами();
	ОчиститьМатериалыСменившейсяПродукции();
	УдалитьМатериалыБезСтрокТоваров();
	ПересчитатьМатериалы();
	ПроверитьСоставОднойПродукции(Отказ);
КонецПроцедуры

Функция ЕстьТехкартыСтрок()
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		Если ЗначениеЗаполнено(СтрокаТоваров.Техкарта) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ОчиститьМатериалыЗаказаНеНаПроизводство()
	Если ТЧМатериалы.Количество() = 0 И Не ЕстьТехкартыСтрок() Тогда
		Возврат;
	КонецЕсли;
	ТЧМатериалы.Очистить();
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		СтрокаТоваров.Техкарта = Документы.ТехнологическаяКарта.ПустаяСсылка();
	КонецЦикла;
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		НСтр("ru = 'Заказ не на производство: материалы и техкарты строк товаров очищены';
			|fr = 'La commande n''est pas en production : les matières et les gammes de fabrication des lignes sont effacées';
			|en = 'The order is not a production order: materials and production routings of the lines are cleared';
			|es = 'El pedido no es de producción: se han borrado los materiales y las rutas de fabricación de las líneas'"),
		ЭтотОбъект);
КонецПроцедуры

// Повторяющийся код строки товаров, на который ссылаются материалы, остаётся у первой строки;
// следующие строки с тем же кодом получают новый код. Нулевые коды строк без материалов не
// трогаются: по коду строки реализация перезаполняет цены из заказа-основания.
//
Процедура РазвестиПовторныеКодыСтрокСМатериалами()
	КодыМатериалов = Новый Соответствие;
	Для Каждого Материал Из ТЧМатериалы Цикл
		КодыМатериалов.Вставить(Материал.КодСтрокиПродукции, Истина);
	КонецЦикла;
	МаксимальныйКод = 0;
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		МаксимальныйКод = Макс(МаксимальныйКод, СтрокаТоваров.КодСтроки);
	КонецЦикла;
	ВстреченныеКоды = Новый Соответствие;
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		Код = СтрокаТоваров.КодСтроки;
		Если Код <> 0 И ВстреченныеКоды[Код] <> Неопределено И КодыМатериалов[Код] <> Неопределено Тогда
			МаксимальныйКод = МаксимальныйКод + 1;
			СтрокаТоваров.КодСтроки = МаксимальныйКод;
			СтрокаТоваров.Техкарта = Документы.ТехнологическаяКарта.ПустаяСсылка();
		КонецЕсли;
		ВстреченныеКоды.Вставить(СтрокаТоваров.КодСтроки, Истина);
	КонецЦикла;
КонецПроцедуры

// Строка, чья номенклатура сменилась после заполнения по карте (карта другой продукции), теряет
// материалы и версию карты.
//
Процедура ОчиститьМатериалыСменившейсяПродукции()
	Техкарты = Новый Массив;
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		Если ЗначениеЗаполнено(СтрокаТоваров.Техкарта) И Техкарты.Найти(СтрокаТоваров.Техкарта) = Неопределено Тогда
			Техкарты.Добавить(СтрокаТоваров.Техкарта);
		КонецЕсли;
	КонецЦикла;
	Если Техкарты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Карты.Ссылка КАК Ссылка,
	|	Карты.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ТехнологическаяКарта КАК Карты
	|ГДЕ
	|	Карты.Ссылка В (&Техкарты)";
	Запрос.УстановитьПараметр("Техкарты", Техкарты);
	ПродукцияКарт = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПродукцияКарт.Вставить(Выборка.Ссылка, Выборка.Номенклатура);
	КонецЦикла;
	Шаблон = НСтр("ru = 'Строка %1: номенклатура не совпадает с технологической картой, материалы строки очищены';
		|fr = 'Ligne %1 : l''article ne correspond pas à la gamme de fabrication, les matières de la ligne sont effacées';
		|en = 'Line %1: the item does not match the production routing, the line materials are cleared';
		|es = 'Línea %1: el artículo no coincide con la ruta de fabricación, se han borrado los materiales de la línea'");
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		Если ЗначениеЗаполнено(СтрокаТоваров.Техкарта)
			И ПродукцияКарт[СтрокаТоваров.Техкарта] <> СтрокаТоваров.Номенклатура Тогда
			СтрокаТоваров.Техкарта = Документы.ТехнологическаяКарта.ПустаяСсылка();
			Документы.ЗаказПокупателя.УдалитьМатериалыСтроки(ТЧМатериалы, СтрокаТоваров.КодСтроки);
			Поле = "ТЧТовары[" + Формат(СтрокаТоваров.НомерСтроки - 1, "ЧН=0; ЧГ=0") + "].Номенклатура";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, СтрокаТоваров.НомерСтроки), ЭтотОбъект, Поле);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура УдалитьМатериалыБезСтрокТоваров()
	КодыТоваров = Новый Соответствие;
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		Если СтрокаТоваров.КодСтроки <> 0 Тогда
			КодыТоваров.Вставить(СтрокаТоваров.КодСтроки, СтрокаТоваров);
		КонецЕсли;
	КонецЦикла;
	Индекс = ТЧМатериалы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Материал = ТЧМатериалы[Индекс];
		Если КодыТоваров[Материал.КодСтрокиПродукции] = Неопределено Тогда
			ТЧМатериалы.Удалить(Материал);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
КонецПроцедуры

// Подбор, штрихкод и форма ECommerce меняют количество продукции без обработчиков формы.
//
Процедура ПересчитатьМатериалы()
	КоличествоПродукции = Новый Соответствие;
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		Если КоличествоПродукции[СтрокаТоваров.КодСтроки] = Неопределено Тогда
			КоличествоПродукции.Вставить(СтрокаТоваров.КодСтроки, СтрокаТоваров.Количество);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Материал Из ТЧМатериалы Цикл
		Документы.ЗаказПокупателя.ПересчитатьСтрокуМатериала(Материал, КоличествоПродукции[Материал.КодСтрокиПродукции]);
	КонецЦикла;
КонецПроцедуры

// Решение владельца 2026-09-13: одна продукция в заказе производится по одному составу. Продукция -
// номенклатура без характеристики: карта и её версии ведутся по номенклатуре. Сравнивается количество
// за единицу, а не итоговое. Строка без материалов ещё не заполнена и в сравнении не участвует.
//
// Параметры:
//  Отказ - Булево - устанавливается при разном составе.
//
Процедура ПроверитьСоставОднойПродукции(Отказ)
	Составы = Новый Соответствие;
	Шаблон = НСтр("ru = 'Строки %1 и %2: у продукции ""%3"" разный состав материалов. В одном заказе продукция производится по одному составу';
		|fr = 'Lignes %1 et %2 : le produit « %3 » a des matières différentes. Dans une commande, un produit est fabriqué selon une seule composition';
		|en = 'Lines %1 and %2: product ""%3"" has different materials. Within one order a product is made from one composition';
		|es = 'Líneas %1 y %2: el producto «%3» tiene materiales distintos. En un pedido un producto se fabrica con una sola composición'");
	МатериалыПоКодам = Новый Соответствие;
	Для Каждого Материал Из ТЧМатериалы Цикл
		МатериалыКода = МатериалыПоКодам[Материал.КодСтрокиПродукции];
		Если МатериалыКода = Неопределено Тогда
			МатериалыКода = Новый Массив;
			МатериалыПоКодам.Вставить(Материал.КодСтрокиПродукции, МатериалыКода);
		КонецЕсли;
		МатериалыКода.Добавить(Материал);
	КонецЦикла;
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		Материалы = МатериалыПоКодам[СтрокаТоваров.КодСтроки];
		Если Материалы = Неопределено Или Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = ТехнологическиеКарты.КлючСоставаСтрок(Материалы, "КоличествоЗаЕдиницу");
		Первая = Составы[СтрокаТоваров.Номенклатура];
		Если Первая = Неопределено Тогда
			Составы.Вставить(СтрокаТоваров.Номенклатура, Новый Структура("Ключ, НомерСтроки", Ключ, СтрокаТоваров.НомерСтроки));
			Продолжить;
		КонецЕсли;
		Если Первая.Ключ <> Ключ Тогда
			Текст = СтрШаблон(Шаблон, Первая.НомерСтроки, СтрокаТоваров.НомерСтроки, СтрокаТоваров.Номенклатура);
			Поле = "ТЧТовары[" + Формат(СтрокаТоваров.НомерСтроки - 1, "ЧН=0; ЧГ=0") + "].Номенклатура";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, Поле, , Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Проверка заполнения при записи из формы. У документа с разрешённым проведением форма проверяет
// заполнение только при проведении, а до E6 заказ не проводился и проверялся при каждой записи из формы.
// Обе формы заказа (и ECommerce) ставят свойство записи из формы - для них проверка возвращается на
// сервер. Записи кодом (кабинет партнёра, лиды, фикстуры) проверок не имели и не получают.
//
// Параметры:
//  РежимЗаписи - РежимЗаписиДокумента - режим текущей записи.
//
// Возвращаемое значение:
//  Булево - Истина, если перед записью нужна проверка заполнения.
//
Функция НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписи) Экспорт
	Возврат РежимЗаписи = РежимЗаписиДокумента.Запись
		И ДополнительныеСвойства.Свойство(РаботаСДокументами.СвойствоЗаписьИзФормы())
		И Не ПометкаУдаления;
КонецФункции

// Вид операции проведённого заказа не меняется (обещано в E4): от него зависят проведение и движения
// следующих этапов. Отмена проведения снимает запрет, в том числе в той же записи.
//
// Параметры:
//  РежимЗаписи - РежимЗаписиДокумента - режим текущей записи.
//  Отказ       - Булево - устанавливается при смене вида у проведённого заказа.
//
Процедура ПроверитьСменуВидаОперации(РежимЗаписи, Отказ) Экспорт
	Если ЭтоНовый() Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;
	КонецЕсли;
	Сохраненные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Проведен, ВидОперации");
	Если Сохраненные.Проведен И Сохраненные.ВидОперации <> ВидОперации Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Вид операции проведённого заказа не меняется. Сначала отмените проведение заказа';
				|fr = 'Le type d''opération d''une commande validée ne change pas. Annulez d''abord la validation de la commande';
				|en = 'The operation type of a posted order cannot be changed. Unpost the order first';
				|es = 'El tipo de operación de un pedido contabilizado no cambia. Anule primero la contabilización del pedido'"),
			ЭтотОбъект, "ВидОперации", , Отказ);
	КонецЕсли;
КонецПроцедуры

// Проведённый заказ, записанный без перепроведения, остаётся проведённым: изменённые так материалы разошлись
// бы с зарегистрированной картой, а следующее перепроведение сочло бы их неизменными и карту не обновило.
// Составы на единицу не видят смены количества продукции - базовые количества материалов сверяются отдельно:
// иначе потребность в регистре (E7) разошлась бы с заказом. Экспортная для тестов документов (отказ настоящей
// записи портит транзакцию сценария).
//
// Параметры:
//  РежимЗаписи - РежимЗаписиДокумента - режим текущей записи.
//  Отказ       - Булево - устанавливается при изменённых материалах проведённого заказа.
//
Процедура ПроверитьМатериалыПроведенногоЗаказа(РежимЗаписи, Отказ) Экспорт
	Если РежимЗаписи <> РежимЗаписиДокумента.Запись Или ЭтоНовый()
		Или Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен") Тогда
		Возврат;
	КонецЕсли;
	СУпаковкой = ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку");
	Текущие = Документы.ЗаказПокупателя.СоставыПродукций(ТЧТовары, ТЧМатериалы, СУпаковкой);
	Если КлючСоставовПродукций(СоставыПроведенногоЗаказа(СУпаковкой)) = КлючСоставовПродукций(Текущие)
		И ПотребностьНеИзменилась() Тогда
		Возврат;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		НСтр("ru = 'Материалы проведённого заказа изменены: проведите заказ, чтобы зафиксировать состав';
			|fr = 'Les matières de la commande validée ont changé : validez la commande pour fixer la composition';
			|en = 'The materials of the posted order have changed: post the order to record the composition';
			|es = 'Los materiales del pedido contabilizado han cambiado: contabilice el pedido para fijar la composición'"),
		ЭтотОбъект, , , Отказ);
КонецПроцедуры

// Сравнивает базовую потребность в материалах с сохранённой версией проведённого заказа.
//
// Возвращаемое значение:
//  Булево - Истина, если продукция, материалы, характеристики и базовые количества не менялись.
//
Функция ПотребностьНеИзменилась()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.КодСтрокиПродукции КАК КодСтрокиПродукции,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.Характеристика КАК Характеристика,
	|	Материалы.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧМатериалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результаты = Запрос.ВыполнитьПакет();
	// Не «Менеджер»: в модуле объекта это реквизит заказа - присваивание затёрло бы менеджера заказа.
	Потребности = РегистрыНакопления.ПотребностиПроизводства;
	Сохраненная = Потребности.ПотребностьЗаказаКлиента(Результаты[0].Выгрузить(), Результаты[1].Выгрузить());
	Текущая = Потребности.ПотребностьЗаказаКлиента(ТЧТовары, ТЧМатериалы);
	Возврат Потребности.КлючПотребности(Сохраненная) = Потребности.КлючПотребности(Текущая);
КонецФункции

Функция КлючСоставовПродукций(Составы)
	Строки = Новый СписокЗначений;
	Для Каждого КлючИЗначение Из Составы Цикл
		Строки.Добавить(XMLСтрока(КлючИЗначение.Ключ) + ":" + ТехнологическиеКарты.КлючСоставаСтрок(КлючИЗначение.Значение.Состав));
	КонецЦикла;
	Строки.СортироватьПоЗначению();
	Возврат СтрСоединить(Строки.ВыгрузитьЗначения(), Символы.ПС);
КонецФункции

Процедура СообщитьЗаказНеПроводится(Отказ)
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		НСтр("ru = 'Проводится только заказ клиента на производство при включённом учёте производства.
			|Проведённый заказ, который больше не проводится, сначала отмените';
			|fr = 'Seule une commande client en production est validée, lorsque la production est activée.
			|Annulez d''abord la validation d''une commande qui ne l''est plus';
			|en = 'Only a customer production order is posted, when production accounting is enabled.
			|Unpost first a posted order that is no longer posted';
			|es = 'Solo se contabiliza un pedido de cliente para producción, con la producción activada.
			|Anule primero la contabilización de un pedido que ya no se contabiliza'"),
		ЭтотОбъект, , , Отказ);
КонецПроцедуры

// Проведение заказа на производство фиксирует составы продукций версиями технологических карт.
// Карты продукций заказа блокируются до решений: иначе параллельное проведение той же продукции решает
// по устаревшим данным и заводит две карты за день.
//
// Параметры:
//  Отказ - Булево - устанавливается при отказе проведения.
//
Процедура ПодготовитьПроведение(Отказ)
	ЗаблокироватьКартыПродукций();
	СУпаковкой = ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку");
	Решения = ПроверитьПроведениеЗаказа(Отказ, СУпаковкой);
	Если Не Отказ Тогда
		ЗарегистрироватьТехкарты(Решения, СУпаковкой, Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаблокироватьКартыПродукций()
	КодыМатериалов = КодыСтрокСМатериалами();
	ИмяПоля = "Продукция";
	Продукция = Новый ТаблицаЗначений;
	Продукция.Колонки.Добавить(ИмяПоля, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		Если КодыМатериалов[СтрокаТоваров.КодСтроки] <> Неопределено И ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
			Продукция.Добавить()[ИмяПоля] = СтрокаТоваров.Номенклатура;
		КонецЕсли;
	КонецЦикла;
	Если Продукция.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Продукция.Свернуть(ИмяПоля);
	ТехнологическиеКарты.ЗаблокироватьКартыПродукции(Продукция);
КонецПроцедуры

Функция КодыСтрокСМатериалами()
	Коды = Новый Соответствие;
	Для Каждого Материал Из ТЧМатериалы Цикл
		Коды.Вставить(Материал.КодСтрокиПродукции, Истина);
	КонецЦикла;
	Возврат Коды;
КонецФункции

// Проверки проведения заказа на производство и решения по версиям карт - без записи в базу: вызывается
// из ПередЗаписью и из тестов документов (отказ настоящей записи портит транзакцию сценария).
// Не вызывать в привилегированном режиме: проверяется право текущего пользователя на карты.
//
// Параметры:
//  Отказ      - Булево - устанавливается при любой причине отказа проведения.
//  СУпаковкой - Булево, Неопределено - опция «Использовать упаковку»; не задана - значение опции.
//
// Возвращаемое значение:
//  Соответствие - см. Документы.ЗаказПокупателя.СоставыПродукций; в значениях после проверки составов
//                 дополнительно:
//   * НужнаВерсия - Булево - состав регистрируется новой версией карты.
//   * Базовая     - ДокументСсылка.ТехнологическаяКарта - версия, из которой переносится упаковка.
//
Функция ПроверитьПроведениеЗаказа(Отказ, СУпаковкой = Неопределено) Экспорт
	Если СУпаковкой = Неопределено Тогда
		СУпаковкой = ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку");
	КонецЕсли;
	ПроверитьСтрокиПродукцииБезМатериалов(Отказ);
	Решения = Документы.ЗаказПокупателя.СоставыПродукций(ТЧТовары, ТЧМатериалы, СУпаковкой);
	ПроверитьСоставыПродукций(Решения, Отказ);
	Если Отказ Или Решения.Количество() = 0 Тогда
		Возврат Решения;
	КонецЕсли;
	Проведенные = СоставыПроведенногоЗаказа(СУпаковкой);
	Продукция = Новый Массив;
	Для Каждого КлючИЗначение Из Решения Цикл
		Продукция.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Сегодня = ТекущаяДатаСеанса();
	Действующие = ТехнологическиеКарты.ТекущиеТехкарты(Продукция, Сегодня);
	Для Каждого КлючИЗначение Из Решения Цикл
		Решение = КлючИЗначение.Значение;
		ОпределитьВерсиюКарты(Решение, Проведенные[Решение.Продукция], Действующие[Решение.Продукция], СУпаковкой);
		Если Решение.НужнаВерсия Тогда
			ПроверитьИзменениеКарты(Решение, Сегодня, Отказ);
		КонецЕсли;
	КонецЦикла;
	Возврат Решения;
КонецФункции

// Строка продукции, пополняемой только производством, без материалов: производить не из чего. Закупаемый
// товар и способ «Оба» без материалов проводятся - их можно закупить под заказ.
//
// Параметры:
//  Отказ - Булево - устанавливается при строке продукции без материалов.
//
Процедура ПроверитьСтрокиПродукцииБезМатериалов(Отказ)
	КодыМатериалов = КодыСтрокСМатериалами();
	БезМатериалов = Новый Массив;
	Номенклатура = Новый Массив;
	Для Каждого СтрокаТоваров Из ТЧТовары Цикл
		Если ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) И КодыМатериалов[СтрокаТоваров.КодСтроки] = Неопределено Тогда
			БезМатериалов.Добавить(СтрокаТоваров);
			Номенклатура.Добавить(СтрокаТоваров.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Если БезМатериалов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СправочникНоменклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникНоменклатура
	|ГДЕ
	|	СправочникНоменклатура.Ссылка В (&Номенклатура)
	|	И СправочникНоменклатура.СпособПополнения = ЗНАЧЕНИЕ(Перечисление.СпособыПополненияЗапасов.Производство)";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Производимые = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Производимые.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	Шаблон = НСтр("ru = 'Строка %1: у продукции ""%2"" нет материалов. Заполните материалы по техкарте';
		|fr = 'Ligne %1 : le produit « %2 » n''a pas de matières. Remplissez les matières selon la gamme de fabrication';
		|en = 'Line %1: product ""%2"" has no materials. Fill the materials from the production routing';
		|es = 'Línea %1: el producto «%2» no tiene materiales. Rellene los materiales según la ruta de fabricación'");
	Для Каждого СтрокаТоваров Из БезМатериалов Цикл
		Если Производимые[СтрокаТоваров.Номенклатура] <> Неопределено Тогда
			Текст = СтрШаблон(Шаблон, СтрокаТоваров.НомерСтроки, СтрокаТоваров.Номенклатура);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, ПолеНоменклатурыСтроки(СтрокаТоваров), , Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Составы, которые технологическая карта не сохранит как есть: пустой материал фасад читает как маркер
// отмены карты; материал, совпадающий с продукцией, карта проверяет только в своей форме; разные упаковки
// одного материала регистр карт не различает и свернул бы в одну строку.
//
// Параметры:
//  Решения - Соответствие - см. Документы.ЗаказПокупателя.СоставыПродукций.
//  Отказ   - Булево - устанавливается при недопустимом составе.
//
Процедура ПроверитьСоставыПродукций(Решения, Отказ)
	ШаблонПустого = НСтр("ru = 'Строка %1: у продукции ""%2"" не заполнен материал';
		|fr = 'Ligne %1 : une matière du produit « %2 » n''est pas renseignée';
		|en = 'Line %1: a material of product ""%2"" is not filled';
		|es = 'Línea %1: un material del producto «%2» no está rellenado'");
	ШаблонПродукции = НСтр("ru = 'Строка %1: продукция ""%2"" указана своим же материалом';
		|fr = 'Ligne %1 : le produit « %2 » figure parmi ses propres matières';
		|en = 'Line %1: product ""%2"" is listed as its own material';
		|es = 'Línea %1: el producto «%2» figura como su propio material'");
	ШаблонУпаковок = НСтр("ru = 'Строка %1: материал ""%2"" указан с разными упаковками, карта хранит одну';
		|fr = 'Ligne %1 : la matière « %2 » a plusieurs conditionnements, la gamme n''en garde qu''un';
		|en = 'Line %1: material ""%2"" has several packagings, the routing keeps one';
		|es = 'Línea %1: el material «%2» tiene varios embalajes, la ruta guarda uno'");
	Для Каждого КлючИЗначение Из Решения Цикл
		Решение = КлючИЗначение.Значение;
		СтрокаТоваров = Решение.Строки[0];
		Поле = ПолеНоменклатурыСтроки(СтрокаТоваров);
		Встреченные = Новый Соответствие;
		Для Каждого СтрокаСостава Из Решение.Состав Цикл
			Если Не ЗначениеЗаполнено(СтрокаСостава.Номенклатура) Тогда
				Текст = СтрШаблон(ШаблонПустого, СтрокаТоваров.НомерСтроки, Решение.Продукция);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, Поле, , Отказ);
				Продолжить;
			КонецЕсли;
			Если СтрокаСостава.Номенклатура = Решение.Продукция Тогда
				Текст = СтрШаблон(ШаблонПродукции, СтрокаТоваров.НомерСтроки, Решение.Продукция);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, Поле, , Отказ);
			КонецЕсли;
			Ключ = XMLСтрока(СтрокаСостава.Номенклатура) + "|" + XMLСтрока(СтрокаСостава.Характеристика);
			Если Встреченные[Ключ] <> Неопределено Тогда
				Текст = СтрШаблон(ШаблонУпаковок, СтрокаТоваров.НомерСтроки, СтрокаСостава.Номенклатура);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, Поле, , Отказ);
			КонецЕсли;
			Встреченные.Вставить(Ключ, Истина);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ПолеНоменклатурыСтроки(СтрокаТоваров)
	Возврат "ТЧТовары[" + Формат(СтрокаТоваров.НомерСтроки - 1, "ЧН=0; ЧГ=0") + "].Номенклатура";
КонецФункции

// Составы продукций заказа в проведённом состоянии из базы (до текущей записи).
//
// Параметры:
//  СУпаковкой - Булево - см. Документы.ЗаказПокупателя.СоставыПродукций.
//
// Возвращаемое значение:
//  Соответствие - см. Документы.ЗаказПокупателя.СоставыПродукций; пустое у нового и непроведённого заказа.
//
Функция СоставыПроведенногоЗаказа(СУпаковкой)
	Если ЭтоНовый() Или Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен") Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Техкарта КАК Техкарта
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.КодСтрокиПродукции КАК КодСтрокиПродукции,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.Характеристика КАК Характеристика,
	|	Материалы.Упаковка КАК Упаковка,
	|	Материалы.КоличествоЗаЕдиницу КАК КоличествоЗаЕдиницу
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧМатериалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результаты = Запрос.ВыполнитьПакет();
	Возврат Документы.ЗаказПокупателя.СоставыПродукций(Результаты[0].Выгрузить(), Результаты[1].Выгрузить(), СУпаковкой);
КонецФункции

// Решает, нужна ли новая версия карты продукции (обязательство E5: сравниваются составы, а не ссылки -
// документ карты дня перезаписывается). Версия не нужна, если состав продукции не менялся с проведённого
// состояния заказа (перепроведение не возвращает текущей картой прежний состав, если карту тем временем
// изменили), либо совпадает с версией карты строк или с действующей картой.
//
// Параметры:
//  Решение     - Структура - см. ПроверитьПроведениеЗаказа; дополняется НужнаВерсия и Базовая,
//                Техкарта - выбранная версия.
//  Проведенный - Структура, Неопределено - состав этой продукции в проведённом заказе из базы.
//  Действующая - Структура, Неопределено - см. ТехнологическиеКарты.ТекущиеТехкарты.
//  СУпаковкой  - Булево - без опции упаковка карты в сравнении не участвует.
//
Процедура ОпределитьВерсиюКарты(Решение, Проведенный, Действующая, СУпаковкой)
	Ключ = ТехнологическиеКарты.КлючСоставаСтрок(Решение.Состав);
	Решение.Вставить("НужнаВерсия", Ложь);
	// Упаковка новой версии - из действующей карты; отменённая карта (пустой состав) действующей не считается.
	Базовая = Решение.Техкарта;
	Если Действующая <> Неопределено
		И ТехнологическиеКарты.СоставТехкартыПоРегистратору(Действующая.Версия).Количество() > 0 Тогда
		Базовая = Действующая.Версия;
	КонецЕсли;
	Решение.Вставить("Базовая", Базовая);
	Если Проведенный <> Неопределено И ЗначениеЗаполнено(Проведенный.Техкарта)
		И ТехнологическиеКарты.КлючСоставаСтрок(Проведенный.Состав) = Ключ Тогда
		Решение.Техкарта = Проведенный.Техкарта;
		Возврат;
	КонецЕсли;
	Кандидаты = Новый Массив;
	Для Каждого СтрокаТоваров Из Решение.Строки Цикл
		Если ЗначениеЗаполнено(СтрокаТоваров.Техкарта) И Кандидаты.Найти(СтрокаТоваров.Техкарта) = Неопределено Тогда
			Кандидаты.Добавить(СтрокаТоваров.Техкарта);
		КонецЕсли;
	КонецЦикла;
	Если Действующая <> Неопределено И Кандидаты.Найти(Действующая.Версия) = Неопределено Тогда
		Кандидаты.Добавить(Действующая.Версия);
	КонецЕсли;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если КлючВерсииКарты(Кандидат, СУпаковкой) = Ключ Тогда
			Решение.Техкарта = Кандидат;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Решение.НужнаВерсия = Истина;
КонецПроцедуры

Функция КлючВерсииКарты(Техкарта, СУпаковкой)
	Состав = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Техкарта);
	Если Не СУпаковкой Тогда
		Состав.ЗаполнитьЗначения(Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка(), "Упаковка");
	КонецЕсли;
	Возврат ТехнологическиеКарты.КлючСоставаСтрок(Состав);
КонецФункции

// Новая версия карты меняет общую карту номенклатуры (решение владельца 2026-09-13), а пишется в
// привилегированном режиме - поэтому только пользователю с правом на технологические карты и не раньше
// последней версии карты продукции.
//
// Параметры:
//  Решение - Структура - см. ПроверитьПроведениеЗаказа.
//  Сегодня - Дата - дата версии (дата проведения, решение владельца 2026-09-13).
//  Отказ   - Булево - устанавливается, если версию записать нельзя.
//
Процедура ПроверитьИзменениеКарты(Решение, Сегодня, Отказ)
	Поле = ПолеНоменклатурыСтроки(Решение.Строки[0]);
	Если Не ЕстьПравоМенятьТехкарты() Тогда
		Шаблон = НСтр("ru = 'Состав ""%1"" отличается от технологической карты, а права менять карты нет';
			|fr = 'La composition de « %1 » diffère de la gamme, sans droit de modifier les gammes';
			|en = 'The composition of ""%1"" differs from the routing, and you have no right to change routings';
			|es = 'La composición de «%1» difiere de la ruta, y no tiene derecho a cambiar rutas'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Решение.Продукция), ЭтотОбъект, Поле, , Отказ);
	КонецЕсли;
	ПроверкаДаты = ТехнологическиеКарты.ДатаРедактированияТехкарты(Решение.Продукция, Сегодня);
	Если Не ПроверкаДаты.Допустима Тогда
		Текст = СтрШаблон("%1: %2", Решение.Продукция, ТехнологическиеКарты.ОшибкаДатыТехкарты(ПроверкаДаты.ПоследняяДата));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, Поле, , Отказ);
	КонецЕсли;
КонецПроцедуры

// Право пользователя изменять технологические карты: создать, перезаписать и провести документ карты.
// Без явного пользователя ПравоДоступа проверяет права «на момент выполнения строки», а в привилегированном
// режиме проверок прав нет - поэтому, если режим включён (например, проведение с привилегированным режимом),
// права проверяются у пользователя информационной базы явно.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь может менять технологические карты.
//
Функция ЕстьПравоМенятьТехкарты()
	МетаданныеКарты = Метаданные.Документы.ТехнологическаяКарта;
	Права = СтрРазделить("Добавление,Изменение,Проведение", ",");
	Если Не ПривилегированныйРежим() Тогда
		Для Каждого Право Из Права Цикл
			Если Не ПравоДоступа(Право, МетаданныеКарты) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	КонецЕсли;
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПустаяСтрока(Пользователь.Имя) Тогда
		// База без пользователей: у пустого пользователя все права.
		Возврат Истина;
	КонецЕсли;
	Для Каждого Право Из Права Цикл
		Если Не ПравоДоступа(Право, МетаданныеКарты, Пользователь) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Регистрирует версии карт продукций с изменённым составом и ставит версию в строки продукции с
// материалами. Дата версии - дата проведения (решение владельца 2026-09-13). Привилегированный режим
// включается явно только на время записи карты: у заказа проведение привилегированное, но охват этого режима
// платформой здесь не проверялся, поэтому защита держится на ЕстьПравоМенятьТехкарты, проверенной до
// записи. Сообщения выводятся после всех записей и только без отказа: при отказе
// транзакция откатывается и ничего не перезаписано.
//
// Параметры:
//  Решения    - Соответствие - см. ПроверитьПроведениеЗаказа.
//  СУпаковкой - Булево - опция «Использовать упаковку».
//  Отказ      - Булево - устанавливается, если карту записать не удалось.
//
Процедура ЗарегистрироватьТехкарты(Решения, СУпаковкой, Отказ)
	Сегодня = ТекущаяДатаСеанса();
	Сообщения = Новый Массив;
	ШаблонОшибки = НСтр("ru = 'Не удалось зарегистрировать технологическую карту продукции ""%1"": %2';
		|fr = 'Impossible d''enregistrer la gamme de fabrication du produit « %1 » : %2';
		|en = 'Could not register the production routing of product ""%1"": %2';
		|es = 'No se pudo registrar la ruta de fabricación del producto «%1»: %2'");
	ШаблонВыпусков = НСтр("ru = 'Продукция ""%1"": с сегодняшнего дня уже есть проведённые выпуски. Перезаполните их вручную';
		|fr = 'Produit « %1 » : des productions sont déjà validées depuis aujourd''hui. Remplissez-les à nouveau manuellement';
		|en = 'Product ""%1"": posted production issues exist from today. Refill their materials manually';
		|es = 'Producto «%1»: ya existen producciones contabilizadas desde hoy. Vuelva a rellenarlas manualmente'");
	Для Каждого КлючИЗначение Из Решения Цикл
		Решение = КлючИЗначение.Значение;
		Если Решение.НужнаВерсия Тогда
			Если Не СУпаковкой Тогда
				Документы.ЗаказПокупателя.ПеренестиУпаковкуКарты(Решение.Состав, Решение.Базовая);
			КонецЕсли;
			ДобавитьСообщениеОПерезаписиКартыДня(Сообщения, Решение, Сегодня);
			// Представление читается из базы - до записи: после исключения транзакция испорчена.
			ПредставлениеПродукции = Строка(Решение.Продукция);
			УстановитьПривилегированныйРежим(Истина);
			Попытка
				Решение.Техкарта = ТехнологическиеКарты.ЗаписатьТехкарту(Решение.Продукция, Решение.Состав, Сегодня);
				УстановитьПривилегированныйРежим(Ложь);
			Исключение
				УстановитьПривилегированныйРежим(Ложь);
				// После исключения во вложенной записи транзакция годится только для отката: к базе не обращаемся.
				// МенеджерОбработкиОшибок в конфигурации на 8.5.1 не проверен - как в тестах документов, глобальный метод.
				// BSLLS:DeprecatedMethodCall-off
				Текст = СтрШаблон(ШаблонОшибки, ПредставлениеПродукции, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				// BSLLS:DeprecatedMethodCall-on
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
				Возврат;
			КонецПопытки;
			Если ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Решение.Продукция, Сегодня) Тогда
				Сообщения.Добавить(СтрШаблон(ШаблонВыпусков, Решение.Продукция));
			КонецЕсли;
		КонецЕсли;
		Для Каждого СтрокаТоваров Из Решение.Строки Цикл
			СтрокаТоваров.Техкарта = Решение.Техкарта;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Текст Из Сообщения Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЦикла;
КонецПроцедуры

// Карта дня общая для карточки номенклатуры, формы карты и всех заказов дня: запись с другим составом
// меняет состав за ссылкой «Техкарта» у всех, кто сослался на эту карту сегодня.
//
// Параметры:
//  Сообщения - Массив из Строка - пополняется текстом сообщения.
//  Решение   - Структура - см. ПроверитьПроведениеЗаказа.
//  Сегодня   - Дата - дата версии.
//
Процедура ДобавитьСообщениеОПерезаписиКартыДня(Сообщения, Решение, Сегодня)
	ДокументДня = ТехнологическиеКарты.ДатаРедактированияТехкарты(Решение.Продукция, Сегодня).Документ;
	Если Не ЗначениеЗаполнено(ДокументДня)
		Или Не ТехнологическиеКарты.СоставОтличается(ДокументДня, Решение.Состав) Тогда
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Сегодняшняя карта ""%1"" была с другим составом и перезаписана составом заказа';
		|fr = 'La gamme du jour de « %1 » avait une autre composition, remplacée par celle de la commande';
		|en = 'Today''s routing of ""%1"" had another composition and is replaced with the order one';
		|es = 'La ruta de hoy de «%1» tenía otra composición y se sustituye por la del pedido'");
	Сообщения.Добавить(СтрШаблон(Шаблон, Решение.Продукция));
КонецПроцедуры
