#Область ПрограммныйИнтерфейс

// Перечисляет печатные формы объекта.
// См. ПечатныеФормы.НоваяКоллекцияКомандПечати
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - пополняемая коллекция команд печати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	Команда = КомандыПечати.Добавить();
	Команда.ИмяМакета = "ПоступлениеТоваров";
	Команда.Представление = НСтр("ru = 'Поступление товаров'; fr = 'Bon de réception';
		|en = 'Receipt voucher'; es = 'Vale de recibo'");
	Команда.ИмяКоманды = "ПечатьПоступлениеТоваров";

	// Акт - фирменная форма под прежним именем и названием команды (docs/plans/branded-print.md, 11.3).
	ФирменнаяПечать.ДобавитьКоманду(КомандыПечати, ИмяМакетаАкта(), ИмяМакетаАкта(), ПредставлениеАкта(),
		"АктОбОказанииУслуг");

КонецПроцедуры

// Формирует запрошенные печатные формы.
// См. ПечатныеФормы.СформироватьПечатныеФормы
//
// Параметры:
//  МассивОбъектов        - Массив          - печатаемые объекты
//  ПараметрыПечати       - Структура       - параметры команды печати
//  КоллекцияПечатныхФорм - ТаблицаЗначений - заполняемая коллекция печатных форм
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов областям печати
//  ПараметрыВывода       - Структура       - параметры окна печати
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если ПечатныеФормы.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПоступлениеТоваров") Тогда
		Таб = Новый ТабличныйДокумент;
		Для Каждого Док Из МассивОбъектов Цикл
			НомерСтрокиНачало = Таб.ВысотаТаблицы + 1;
			ПечатьПоступлениеТоваров(Док, Таб);
			ПечатныеФормы.ЗадатьОбластьПечати(Таб, НомерСтрокиНачало, ОбъектыПечати, Док);
		КонецЦикла;
		ПечатныеФормы.ВывестиТабличныйДокумент(КоллекцияПечатныхФорм, "ПоступлениеТоваров",
			НСтр("ru = 'Поступление товаров'; fr = 'Bon de réception';
			|en = 'Receipt voucher'; es = 'Vale de recibo'"),
			Таб, "Документ.ПоступлениеТоваровУслуг.ПоступлениеТоваров");
	КонецЕсли;

	ФирменнаяПечать.Напечатать(ИмяМакетаАкта(), ИмяМакетаАкта(), МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм,
		ОбъектыПечати, ПредставлениеАкта());

КонецПроцедуры

// Адаптер фирменной печати (см. ФирменнаяПечать.Напечатать): акт об оказании услуг поставщика - исполнитель
// поставщик, заказчик организация (как у счёта-фактуры поставщика), строки - услуги, итоги - по услугам
// (docs/plans/branded-print.md, 11.5).
//
// Параметры:
//  Ссылки          - Массив из ДокументСсылка.ПоступлениеТоваровУслуг - печатаемые поступления.
//  ВидФормы        - Строка - вид фирменной формы: АктОбОказанииУслуг.
//  КодЯзыка        - Строка - язык печати.
//  ПараметрыПечати - Структура - параметры команды печати.
//
// Возвращаемое значение:
//  Соответствие - поступление -> источник печати (см. ФирменнаяПечать.ИсточникТоварногоДокумента).
//
Функция ДанныеФирменнойПечати(Ссылки, ВидФормы, КодЯзыка, ПараметрыПечати) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Поступление.Ссылка КАК Ссылка,
	|	Поступление.Номер КАК НомерДокумента,
	|	Поступление.Дата КАК Дата,
	|	Поступление.Организация КАК Организация,
	|	Поступление.Контрагент КАК Контрагент,
	|	Поступление.Договор КАК Договор,
	|	Поступление.Валюта КАК Валюта,
	|	Поступление.ВВалюте КАК ВВалюте,
	|	Поступление.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Поступление.Комментарий КАК Комментарий,
	|	ПРЕДСТАВЛЕНИЕ(Поступление.Ответственный) КАК Менеджер,
	|	ПРЕДСТАВЛЕНИЕ(Поступление.Ответственный) КАК Автор,
	|	Поступление.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|	Поступление.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|	ЕСТЬNULL(Контрагенты.Код, """") КАК КодКонтрагента
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступление
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Поступление.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	Поступление.Ссылка В(&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Строки = ФирменнаяПечать.ДанныеСтрокДокументов(Метаданные.Документы.ПоступлениеТоваровУслуг.Имя, Ссылки, "ТЧУслуги");
	Кэш = ФирменнаяПечать.НовыйКэш();
	ПодписьОснования = НСтр("ru = 'Документ поставщика'; fr = 'Document du fournisseur'; en = 'Supplier document';
		|es = 'Documento del proveedor'", КодЯзыка);
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Шапка = ФирменнаяПечать.НоваяШапкаДокумента();
		ЗаполнитьЗначенияСвойств(Шапка, Выборка);
		Шапка.ОрганизацияПокупатель = Истина;
		Шапка.Номер = РаботаСДокументами.СформироватьЦифровойНомер(Выборка.НомерДокумента);
		Шапка.Основание = ФирменнаяПечать.ПредставлениеОснования(ПодписьОснования,
			СокрЛП(Выборка.НомерВходящегоДокумента), Выборка.ДатаВходящегоДокумента, КодЯзыка);
		СтрокиДокумента = Строки[Выборка.Ссылка];
		ФирменнаяПечать.ЗаполнитьИтогиПоСтрокам(Шапка, СтрокиДокумента);
		ИмяФайла = ФирменнаяПечать.ИмяФайлаДокумента("Acte", Выборка.НомерДокумента, Выборка.Дата);
		Источник = ФирменнаяПечать.ИсточникТоварногоДокумента(Шапка, СтрокиДокумента, Кэш, ИмяФайла);
		Результат.Вставить(Выборка.Ссылка, Источник);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Печать

Процедура ПечатьПоступлениеТоваров(Док, Таб) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Таб.Автомасштаб = Истина;
	Таб.КлючПараметровПечати = "Параметры_печати_Документ_ПоступлениеТоваровУслуг_ПоступлениеТоваров";
	Макет = ПечатныеФормы.МакетПечатнойФормы("Документ.ПоступлениеТоваровУслуг.ПоступлениеТоваров");
	// Шапка
	оШапка = Макет.ПолучитьОбласть("Шапка");
	оШапка.Параметры.ТекстЗаголовка = РаботаСДокументами.КраткоеПредставлениеДокумента(Док, "Bon de réception");
	//оШапка.Параметры.Контрагент = Док.Контрагент;
	оШапка.Параметры.Организация = Док.Организация;
	Таб.Вывести(оШапка);
	// Строки
	оСтрока = Макет.ПолучитьОбласть("Строка");
	Для Каждого Стр Из Док.ТЧТовары Цикл
		оСтрока.Параметры.НомерСтроки = Стр.НомерСтроки;
		оСтрока.Параметры.Номенклатура = Стр.Номенклатура;
		оСтрока.Параметры.ID = Стр.Номенклатура.Артикул;
		//оСтрока.Параметры.Количество = Стр.Количество;
		оСтрока.Параметры.Единица = Стр.Номенклатура.Единица;
		Таб.Вывести(оСтрока);
	КонецЦикла;
	//// Итого
	//оИтого = Макет.ПолучитьОбласть("Итого");
	//оИтого.Параметры.Всего = Док.Сумма;
	//Таб.Вывести(оИтого);
	//// НДС
	//оНДС = Макет.ПолучитьОбласть("ИтогоНДС");
	//оНДС.Параметры.НДС = "TVA";
	//оНДС.Параметры.ВсегоНДС = Док.ТЧТовары.Итог("СуммаНДС");
	//Таб.Вывести(оНДС);
	//// Сумма прописью
	//Валюта = Справочники.Валюты.MoroccanDirham;
	//оСуммаПрописью = Макет.ПолучитьОбласть("СуммаПрописью");
	////оСуммаПрописью.Параметры.ИтоговаяСтрока = "Всего наименований " + СокрЛП(Док.ТЧТовары.Количество()) 
	////	+ ", на сумму " + Формат(Док.Сумма, "ЧЦ=12; ЧДЦ=2") + " руб.";
	//оСуммаПрописью.Параметры.СуммаПрописью = Справочники.Валюты.СформироватьСуммуПрописью(Док.Сумма, Валюта, Перечисления.Локализации.fr_CA);
	//Таб.Вывести(оСуммаПрописью);
	// Подписи
	Таб.Вывести(Макет.ПолучитьОбласть("Подписи"));
	Таб.ВывестиГоризонтальныйРазделительСтраниц();
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

Функция ИмяМакетаАкта()
	Возврат "АктОбОказанииУслуг";
КонецФункции

Функция ПредставлениеАкта()
	Возврат НСтр("ru = 'Акт об оказании услуг за поставщика'; fr = 'Acte de prestation de services pour le fournisseur';
		|en = 'Act of provision of services for the supplier'; es = 'Acto de prestación de servicios para el proveedor'");
КонецФункции

#КонецОбласти
