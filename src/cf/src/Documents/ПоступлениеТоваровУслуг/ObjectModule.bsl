
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	ТипЦеныПоТипуЦен = Константы.ВыводитьВЗакупкеТипЦен.Получить();
	// Налоговый документ на основаниях - из подбора в форме или команды списка (docs/plans/accounting-morocco-f1-s2.md);
	// прочие ветки ниже такие данные заполнения не узнают.
	НалоговыеДокументыНаОснованиях.ЗаполнитьПоДаннымЗаполнения(ЭтотОбъект, ДанныеЗаполнения);
	Ордера = ОрдераСклада.ОрдераОснования(ДанныеЗаполнения);
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		Организация = ДанныеЗаполнения.Организация;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Договор = ДанныеЗаполнения.Договор; 
		Основание = ДанныеЗаполнения;
		ЦенаВключаетНДС = ДанныеЗаполнения.ЦенаВключаетНДС; 
		ТЧТовары.Загрузить(ДанныеЗаполнения.ТЧТовары.Выгрузить());
		// Цены строк - в валюте заказа.
		РаботаСВалютами.ЗаполнитьВалютуПоОснованию(ЭтотОбъект, ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Организация = ДанныеЗаполнения.Организация;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(Контрагент, Организация, Ложь);  
		МестоХранения = ДанныеЗаполнения.МестоХранения;
		Основание = ДанныеЗаполнения;		
		//ЦенаВключаетНДС = ДанныеЗаполнения.ЦенаВключаетНДС; 
		ТЧТовары.Загрузить(ДанныеЗаполнения.ТЧТовары.Выгрузить());
		ТЧСерии.Загрузить(ДанныеЗаполнения.ТЧСерии.Выгрузить());
		// Цены строк - в валюте реализации.
		РаботаСВалютами.ЗаполнитьВалютуПоОснованию(ЭтотОбъект, ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ЗаполнитьПоЗаказуНаПроизводство(ДанныеЗаполнения);
	ИначеЕсли Ордера.Количество() > 0 Тогда
		// Оформление приходных ордеров - одного или нескольких (план warehouse-orders, фаза 2, §2.5).
		ОрдераСклада.ЗаполнитьПоОрдерам(ЭтотОбъект, Ордера);
	КонецЕсли;
	
	Номенклатура = ТЧТовары.Выгрузить().ВыгрузитьКолонку("Номенклатура");
	ТЗЦеныРозн = РегистрыСведений.ЦеныНоменклатуры.ПоследнийПрайс(ТекущаяДатаСеанса(),Справочники.ВидыЦен.Розничная,Номенклатура);
	ТЗЦеныМин = РегистрыСведений.ЦеныНоменклатуры.ПоследнийПрайс(ТекущаяДатаСеанса(),Справочники.ВидыЦен.МинимальнаяЦенаПродажи,Номенклатура);
	Если ЗначениеЗаполнено(ТипЦеныПоТипуЦен) Тогда 
		ТЗЦеныПоТипуЦен = РегистрыСведений.ЦеныНоменклатуры.ПоследнийПрайс(ТекущаяДатаСеанса(),ТипЦеныПоТипуЦен,Номенклатура);
	КонецЕсли;
	Для Каждого Стр из ТЧТовары Цикл
		СтрЦена = ТЗЦеныРозн.Найти(Стр.Номенклатура);
		Стр.ЦенаРозничная = ?(СтрЦена = Неопределено, 0, СтрЦена.Цена); 
		СтрЦена = ТЗЦеныМин.Найти(Стр.Номенклатура);
		Стр.ЦенаМинимальная = ?(СтрЦена = Неопределено, 0, СтрЦена.Цена); 
		Если ЗначениеЗаполнено(ТипЦеныПоТипуЦен) Тогда 
			СтрЦена = ТЗЦеныПоТипуЦен.Найти(Стр.Номенклатура);
			Стр.ЦенаПоТипуЦен = ?(СтрЦена = Неопределено, 0, СтрЦена.Цена);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Поступление под заказ клиента на производство (E7): основание - заказ, строки - что осталось получить по
// потребности (см. РегистрыНакопления.ПотребностиПроизводства.ОстатокКПоступлению). Продажа и заказ без
// сформированной потребности - отказ ввода.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - основание поступления.
//
Процедура ЗаполнитьПоЗаказуНаПроизводство(Заказ)
	Потребности = РегистрыНакопления.ПотребностиПроизводства;
	Если Не Потребности.ЗаказФормируетПотребность(Заказ) Тогда
		ВызватьИсключение Потребности.ТекстЗаказБезПотребности();
	КонецЕсли;
	Организация = Заказ.Организация;
	Основание = Заказ;
	ЦенаВключаетНДС = Истина; // цены прайса поставщиков хранятся с НДС
	Остаток = Потребности.ОстатокКПоступлению(Заказ);
	Материалы = Остаток.ВыгрузитьКолонку("Материал");
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Материалы, "Единица, СтавкаНДС");
	Цены = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(ТекущаяДатаСеанса(), Материалы);
	КодСтроки = 1;
	Для Каждого Строка Из Остаток Цикл
		НоваяСтрока = ТЧТовары.Добавить();
		НоваяСтрока.КодСтроки = КодСтроки;
		КодСтроки = КодСтроки + 1;
		НоваяСтрока.Номенклатура = Строка.Материал;
		НоваяСтрока.Характеристика = Строка.Характеристика;
		РеквизитыМатериала = Реквизиты[Строка.Материал];
		Если РеквизитыМатериала <> Неопределено Тогда
			НоваяСтрока.Упаковка = РеквизитыМатериала.Единица;
			НоваяСтрока.СтавкаНДС = РеквизитыМатериала.СтавкаНДС;
		КонецЕсли;
		НоваяСтрока.КоличествоУпаковок = Строка.Количество;
		НоваяСтрока.Количество = Строка.Количество;
		Цена = Цены.Найти(Строка.Материал, "Номенклатура");
		Если Цена <> Неопределено Тогда
			НоваяСтрока.Цена = Цена.Цена;
		КонецЕсли;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(НоваяСтрока, ЦенаВключаетНДС);
	КонецЦикла;
	Если Остаток.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Потребности.ТекстПотребностьПолучена());
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ТЧТовары.Количество() > 0 Тогда
		ПроверяемыеРеквизиты.Добавить("МестоХранения");
	КонецЕсли;
	// Ордерный склад: строки - только по приходным ордерам (план warehouse-orders, фаза 2, §2.5). Документ на
	// основаниях ордеров не оформляет: товар уже принят основаниями.
	Если Не НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ЭтотОбъект) Тогда
		ОрдераСклада.ПроверитьОформление(ЭтотОбъект, Отказ);
		// Серийный товар (IMEI) принимается с номером на каждую единицу.
		СерийныйУчет.ПроверитьЗаполнениеПрихода(ЭтотОбъект, Отказ);
	КонецЕсли;
	//Если ТЧУслуги.Количество() > 0 Тогда
	//	ПроверяемыеРеквизиты.Добавить("ТЧУслуги.СтатьяДДС");	
	//КонецЕсли;
	Если Статус = Перечисления.СтатусыДокументов.ВРаботе Тогда 
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.найти("ТЧТовары.Цена"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.найти("ТЧТовары.Сумма"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.найти("ТЧТовары.СуммаСНДС"));
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	// Налоговый документ на основаниях - переклассификация движений оснований, без приёмки (план С2).
	Если НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ЭтотОбъект) Тогда
		НалоговыеДокументыНаОснованиях.ПровестиДокумент(ЭтотОбъект, Отказ);
		Возврат;
	КонецЕсли;
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);	
	// Данные для проведения
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ТЗТоварыССериями", СерииИРазмещение.ОбъединитьТоварыССериями(ЭтотОбъект));
	// Блокировки
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	Блокировка.Заблокировать();
	// Ордера пар не вышли за ключи, захваченные до блокировки (warehouse-orders-cost, Ф3.8).
	ОрдераСклада.ПроверитьСнимокОрдеровПоступления(ЭтотОбъект, ДополнительныеСвойства.СнимокОрдеров, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Строки по ордерам - после блокировки ордеров (общий план, «Целостность связи»).
	ОрдераСклада.ПроверитьОформление(ЭтотОбъект, Отказ);
	ОрдераСклада.ПроверитьСтаруюСхему(ЭтотОбъект, ДополнительныеСвойства.ОрдераДокумента, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Закупка под заказ на производство другой организации - отказ (ревью техдолга Codex 2026-10-09, T10).
	ТекстЗапрета = РегистрыНакопления.ПотребностиПроизводства.ТекстЗапретаОрганизацииЗакупки(ЭтотОбъект);
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, ЭтотОбъект, "Организация", , Отказ);
		Возврат;
	КонецЕсли;
	// Формируем
	РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(ЭтотОбъект);
	РегистрыНакопления.ЗаказыПоставщикам.СформироватьДвижения(ЭтотОбъект);
	РегистрыНакопления.ПотребностиПроизводства.СформироватьДвижения(ЭтотОбъект);
	РегистрыНакопления.ВзаиморасчётыСПоставщиками.СформироватьДвижения(ЭтотОбъект);
	РегистрыНакопления.Убытки.СформироватьДвижения(ЭтотОбъект);
	РегистрыСведений.ЦеныНоменклатурыПоставщиков.СформироватьДвижения(ЭтотОбъект);
	РегистрыСведений.ЦеныНоменклатуры.СформироватьДвижения(ЭтотОбъект);
	ОрдераСклада.СформироватьДвиженияОформления(ЭтотОбъект);
	РегистрыНакопления.ПотребностиПроизводства.ПроверитьПришло(ЭтотОбъект, Движения.ПотребностиПроизводства, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Записываем
	// Признак раздельного учёта движений (docs/plans/accounting-morocco-f1.md).
	НалоговыйУчет.УстановитьПризнакУУ(ЭтотОбъект);
	Движения.Записать();
	РегистрыНакопления.ТоварыКОформлению.ПроверитьОстатки(ДополнительныеСвойства.ОрдераДокумента, ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Ближний пересчёт: стоимость партий ордеров прежних и новых пар (warehouse-orders-cost, Ф3.7).
	ОрдераСклада.ПересчитатьСтоимостьПриходныхОрдеров(ДополнительныеСвойства.ОрдераДокумента, ЭтотОбъект);
	СдвинутьГраницуДопрасходов();
	ПроизводственныеЗаказы.ОбновитьСтадииПослеПроведения(ЭтотОбъект);
	// Покрывающий налоговый документ строится по движениям поступления - перепроводится следом (план С2).
	НалоговыеДокументыНаОснованиях.ПерепровестиПокрывающиеДокументы(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка), , ЭтотОбъект);
КонецПроцедуры

// Отмена проведения документа, затронувшего заказы клиента на производство: блокировки в порядке проведения,
// очистка движений и пересчёт стадий заказов (E8). Без таких заказов движения удаляет платформа, как раньше.
//
// Параметры:
//  Отказ - Булево - не используется.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	// Покрытое основание не распроводится; документ на основаниях - без ордеров и потребностей (план С2).
	НалоговыеДокументыНаОснованиях.ПроверитьСнятиеДокумента(ЭтотОбъект, Отказ);
	Если Отказ Или НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	Блокировка.Заблокировать();
	// «Пришло» не уходит в минус и после отмены прихода (план warehouse-orders, фаза 2, §2.8).
	РегистрыНакопления.ПотребностиПроизводства.ПроверитьПришло(ЭтотОбъект, Неопределено, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ПроизводственныеЗаказы.ОтменитьПроведениеДокумента(ЭтотОбъект, Неопределено);
	ОтменитьОформлениеОрдеров(Отказ);
КонецПроцедуры

// Отмена оформления приходных ордеров: расход ТоварыКОформлению документа снимается, контроль остатков - как при
// проведении. Без ордеров - ничего.
//
// Параметры:
//  Отказ - Булево - выставляется при нарушении.
//
Процедура ОтменитьОформлениеОрдеров(Отказ)
	Ордера = ДополнительныеСвойства.ОрдераДокумента;
	Если Ордера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ОрдераСклада.ПроверитьСтаруюСхему(ЭтотОбъект, Ордера, Отказ);
	ОрдераСклада.ПроверитьОтменуПоступленияСДопрасходами(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Набор = Движения.ТоварыКОформлению;
	Набор.Очистить();
	Набор.Записать();
	РегистрыНакопления.ТоварыКОформлению.ПроверитьОстатки(Ордера, ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Пары ушли - стоимость партий ордеров уменьшилась (warehouse-orders-cost, Ф3.7).
	ОрдераСклада.ПересчитатьСтоимостьПриходныхОрдеров(Ордера, ЭтотОбъект);
КонецПроцедуры

// Программное удаление проведённого поступления не вызывает ОбработкаУдаленияПроведения (tiny1C bsl-024): «Пришло»
// потребностей без его движений не должно уйти в минус (план warehouse-orders, фаза 2, §2.8). Регистр потребностей
// читается служебно, как при проведении.
//
// Параметры:
//  Отказ - Булево - выставляется при нарушении.
//
// Модуль без областей, как и прежние обработчики событий в нём.
// BSLLS:SetPrivilegedMode-off
// BSLLS:EventHandlerOutsideEventRegion-off
Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Или Не Проведен Тогда
		Возврат;
	КонецЕсли;
	НалоговыеДокументыНаОснованиях.ПроверитьСнятиеДокумента(ЭтотОбъект, Отказ, Истина);
	Если Отказ Или НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	// Удаление не вызывает отмену проведения и её ближний пересчёт (warehouse-orders-cost, Ф3.7): сначала - отмена.
	ОрдераСклада.ПроверитьУдалениеОформляющего(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	Блокировка.Заблокировать();
	// Удаление обходит отмену проведения: защита базы допрасходов - здесь, под той же блокировкой (Ф4.8, Редакция 42).
	ОрдераСклада.ПроверитьОтменуПоступленияСДопрасходами(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	РегистрыНакопления.ПотребностиПроизводства.ПроверитьПришло(ЭтотОбъект, Неопределено, Отказ);
КонецПроцедуры
// BSLLS:EventHandlerOutsideEventRegion-on
// BSLLS:SetPrivilegedMode-on

// Блокировки проведения и отмены проведения - один набор в одном порядке (E8). Рабочие места закупок и производства берут
// тот же набор перед проверкой остатков заказа поставщику и записью документа.
//
// Параметры:
//  Блокировка - БлокировкаДанных - заполняемая блокировка.
//
Процедура ЗаполнитьБлокировкуПроведения(Блокировка) Экспорт
	// Протокол блокировок серийного учёта: номенклатура и IMEI - раньше оснований и остатков.
	СерийныйУчет.ЗаблокироватьСерииДокумента(ЭтотОбъект);
	// Единый порядок захвата (план warehouse-orders): склады - разделяемо первыми, ТоварыКОформлению по ордерам строк
	// и прежних движений - последним.
	Склады = Новый Массив;
	Склады.Добавить(МестоХранения);
	Если Не Ссылка.Пустая() Тогда
		Склады.Добавить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "МестоХранения"));
	КонецЕсли;
	// Ближний пересчёт перезапишет целые наборы ордеров пар - их склады и номенклатура всех их строк в том же объекте
	// (warehouse-orders-cost, Ф3.8); снимок сверяется после блокировки.
	Снимок = ОрдераСклада.СнимокОрдеровПоступления(ЭтотОбъект);
	ДополнительныеСвойства.Вставить("СнимокОрдеров", Снимок);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Склады, Снимок.ВыгрузитьКолонку("МестоХранения"), Истина);
	УправляемыеБлокировки.МестаХранения(Блокировка, Склады, Ложь);
	Для Каждого Склад Из Склады Цикл
		Позиции = ОрдераСклада.ПозицииБлокировкиПоступления(ЭтотОбъект, Снимок, Склад);
		Если Позиции.Количество() > 0 Тогда
			УправляемыеБлокировки.ТоварыВНаличии(Блокировка, Позиции, Склад);
		КонецЕсли;
	КонецЦикла;
	УправляемыеБлокировки.ВзаиморасчётыСПоставщиками(Блокировка, Контрагент);
	УправляемыеБлокировки.ПотребностиПроизводстваЗакупки(Блокировка, ЭтотОбъект);
	УправляемыеБлокировки.ЗаказыПоставщикамДокумента(Блокировка, ЭтотОбъект);
	Ордера = РегистрыНакопления.ТоварыКОформлению.ОрдераДокумента(ЭтотОбъект);
	ДополнительныеСвойства.Вставить("ОрдераДокумента", Ордера);
	УправляемыеБлокировки.ТоварыКОформлению(Блокировка, Ордера);
КонецПроцедуры

// Поступление ордерного склада - источник (документ первый, Ф4.3) и база допрасходов (Ф4.8): полный захват
// блокировок до записи, защита оформленных строк и базы проведённых допрасходов, снимок базы для сдвига границы.
//
// Параметры:
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  Отказ       - Булево - выставляется.
//
Процедура ЗащититьИсточник(РежимЗаписи, Отказ)
	Если Отказ Или РежимЗаписи = РежимЗаписиДокумента.Запись Или Не ОрдераСклада.ОрдерныйСкладДокумента(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - блокировка ордерных регистров при записи, как при проведении
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Блокировка = Новый БлокировкаДанных;
	ЗаполнитьБлокировкуПроведения(Блокировка);
	Блокировка.Заблокировать();
	ОрдераСклада.ПроверитьЗащитуИсточника(ЭтотОбъект, РежимЗаписи, Отказ);
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ОрдераСклада.ПроверитьБазуДопрасходовПоступления(ЭтотОбъект, Отказ);
	КонецЕсли;
	ДополнительныеСвойства.Вставить("СнимокБазыДопрасходов", ОрдераСклада.СнимокБазыДопрасходовПоступления(Ссылка));
КонецПроцедуры

// Изменение базы документов допрасходов на поступление - граница строго раньше самого раннего из них (Ф4.8).
//
Процедура СдвинутьГраницуДопрасходов()
	Прежний = Неопределено;
	Если Не ДополнительныеСвойства.Свойство("СнимокБазыДопрасходов", Прежний) Или Не ЗначениеЗаполнено(Прежний) Тогда
		Возврат;
	КонецЕсли;
	Если ОрдераСклада.СнимокБазыДопрасходовПоступления(Ссылка) <> Прежний Тогда
		ОрдераСклада.СдвинутьГраницуПередДопрасходами(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка), ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Протокол блокировок серийного учёта: номенклатура и IMEI - раньше оснований и остатков.
	СерийныйУчет.ЗаблокироватьСерииДокумента(ЭтотОбъект);
	РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	// Мобильная приёмка (docs/plans/retail-mobile-receipt.md): переназначение при незавершённой приёмке запрещено.
	Обработки.МобильнаяПриемка.ПроверитьПереназначение(ЭтотОбъект, Отказ);
	// Налоговый документ на основаниях и защита покрытого основания: блокировка оснований до записи (план С2).
	НалоговыеДокументыНаОснованиях.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, Отказ);
	// Проведённое поступление по ордерам с изменениями - только перепроведение (общий план, «Целостность связи»).
	Если Не НалоговыеДокументыНаОснованиях.ЭтоДокументНаОснованиях(ЭтотОбъект) Тогда
		ОрдераСклада.ПроверитьЗаписьБезПроведения(ЭтотОбъект, РежимЗаписи, Отказ);
		ЗащититьИсточник(РежимЗаписи, Отказ);
	КонецЕсли;
	ЭтотОбъект.ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	РаботаСВалютами.ПроверитьВалютуДокумента(ЭтотОбъект, Отказ);
	РаботаСДокументами.ЗаполнитьИтогиДокумента(ЭтотОбъект);
	Если Не Отказ Тогда
		ПроизводственныеЗаказы.ЗапомнитьЗаказыДокумента(ЭтотОбъект, РежимЗаписи);
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Проведённый документ, перезаписанный без перепроведения, пересчитывает стадии своих заказов (E8).
	ПроизводственныеЗаказы.ОбновитьСтадииПриЗаписи(ЭтотОбъект);
КонецПроцедуры



