
&НаКлиенте
Перем ЗакрытиеФормы;

#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	РаботаСДокументами.МожноРедактироватьДокументВФорме(Объект.Ссылка, ЭтаФорма);
	РаботаСДокументамиКлиентСервер.УстановитьПараметрыФункциональныхОпций(ЭтаФорма);  
	РаботаСДокументами.УстановитьЗаголовокФормыДокумента(ЭтаФорма, Объект);
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.ТипЦеныПоТипуЦен = Константы.ВыводитьВЗакупкеТипЦен.Получить();
		Объект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
		Объект.КурсВалюты = 1;
	Иначе
		Если Объект.Статус = Перечисления.СтатусыДокументов.Завершен 
			и (не РегистрыСведений.НастройкиПользователей.РедактироватьЗавершенныеДокументы() И не РольДоступна("Администратор")) Тогда
			ЭтотОбъект.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьСрокОплатыНаСервере();
	СрокОплаты = РаботаСДокументами.ПолучитьСрокОплаты(Объект.Контрагент,Объект.Дата);
	ЗаполнитьОстаткиНаСервере();
	НастройкаФормы();
	КомандыТабличныхЧастейВызовСервера.ПодключитьКоманду(ЭтотОбъект, "Подменю", Элементы.ТЧТовары.КоманднаяПанель);
	Если Не ТолькоПросмотр Тогда
		КомандыТабличныхЧастейВызовСервера.ПодключитьКоманду(ЭтотОбъект, "Подбор", Элементы.ТЧТовары.КоманднаяПанель);
	КонецЕсли;
	РаботаСДокументами.ОграничитьВидимостьРеквизитовПоТипу(ЭтотОбъект, "ОператорПроизводства");
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОперацииСПодключаемымОборудованиемКлиент.ПодключитьОборудование(УникальныйИдентификатор, Истина); 
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	КолонкаКоличество = "КоличествоУпаковок";
	Отказ = Не СерииИРазмещениеКлиент.ПроверитьСоответствиеСерийТоварам(ЭтаФорма, Объект.ТЧТовары, Объект.ТЧСерии, ПараметрыЗаписи, КолонкаКоличество);
	РаботаСДокументамиКлиент.ПроверитьСуммуАвансовТоварногоДокумента(Объект, Отказ);
	Если Не Отказ и ЗакрытиеФормы = Неопределено Тогда
		СообщениеОбОтклонении = ПроверитьОтклонениеЦен();
		Если ЗначениеЗаполнено(СообщениеОбОтклонении) Тогда
			Отказ = Истина;
			Оп = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОтклоненииЦен", ЭтаФорма, ПараметрыЗаписи);
			РаботаСДокументамиКлиент.ПоказатьВопросОПроверкеДокумента(Оп, СообщениеОбОтклонении);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.ДополнительныеСвойства.Вставить(РаботаСДокументами.СвойствоЗаписьИзФормы(), Истина);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	РаботаСДокументами.УстановитьЗаголовокФормыДокумента(ЭтаФорма, ТекущийОбъект);
	ЗаполнитьСрокОплатыНаСервере();
	ЗаполнитьОстаткиНаСервере();
	НастройкаФормы();
КонецПроцедуры

#КонецОбласти 

#Область Обработчики_элементов_формы  

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.УстановитьПараметрыФункциональныхОпций(ЭтаФорма);
	КонтрагентПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	Объект.Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(Объект.Контрагент, Объект.Организация, Ложь);
	ЗаполнитьСрокОплатыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура МестоХраненияПриИзменении(Элемент)
	РаботаСДокументамиКлиентСервер.УстановитьПараметрыФункциональныхОпций(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ЦенаВключаетНДСПриИзменении(Элемент)
	Для Каждого Стр Из Объект.ТЧТовары Цикл
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, Объект.ЦенаВключаетНДС);	
	КонецЦикла;
	Для Каждого Стр Из Объект.ТЧУслуги Цикл
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, Объект.ЦенаВключаетНДС);	
	КонецЦикла;
	//ТипЦеныПоТипуЦенПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура УказатьСерии(Команда)
