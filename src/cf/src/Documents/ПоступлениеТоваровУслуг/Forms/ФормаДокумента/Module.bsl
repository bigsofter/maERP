&НаСервере
Процедура НастройкаФормы()
	Элементы.ТЧТоварыПечатьЭтикеток.Доступность = Не Объект.Ссылка.Пустая();
	Элементы.ТЧТоварыЗаполнитьИзExcel.Доступность = Не ТолькоПросмотр;
	Элементы.ТЧТоварыЦенаПоТипуЦен.Видимость = ЗначениеЗаполнено(Объект.ТипЦеныПоТипуЦен);
	Элементы.ТЧТоварыЦенаПоТипуЦен.Заголовок = СокрЛП(Объект.ТипЦеныПоТипуЦен) + " TTC";
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзExcelНаСервере(Мас)
	Объект.ТЧТовары.Очистить();
	Для Каждого Эл из Мас Цикл
		НС = Объект.ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС,Эл,,"ЦенаМинимальная,ЦенаРозничная");
		РаботаСДокументамиКлиентСервер.УстановитьПараметрыНоменклатуры(НС, Объект, Ложь);
		НС.Количество = Эл.Количество;
		НС.КоличествоУпаковок = Эл.КоличествоУпаковок;
		Если ЗначениеЗаполнено(Эл.Цена) Тогда 
			НС.Цена = Эл.Цена;
		КонецЕсли;
		НС.СтавкаНДС = НС.Номенклатура.СтавкаНДС;
		Если ЗначениеЗаполнено(НС.Номенклатура) Тогда 
			НС.Упаковка = НС.Номенклатура.Единица;
		КонецЕсли;
		Если ЗначениеЗаполнено(Эл.ЦенаМинимальная) Тогда 
			НС.ЦенаМинимальная = Эл.ЦенаМинимальная;
		КонецЕсли;
		Если ЗначениеЗаполнено(Эл.ЦенаРозничная) Тогда 
			НС.ЦенаРозничная = Эл.ЦенаРозничная;
		КонецЕсли;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(НС, Объект.ЦенаВключаетНДС);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ТипЦеныПоТипуЦенПриИзмененииНаСервере()
	Номенклатура = Объект.ТЧТовары.Выгрузить().ВыгрузитьКолонку("Номенклатура");
	Если ЗначениеЗаполнено(Объект.ТипЦеныПоТипуЦен) Тогда 
		ТЗЦеныПоТипуЦен = РегистрыСведений.ЦеныНоменклатуры.ПоследнийПрайс(ТекущаяДатаСеанса(),Объект.ТипЦеныПоТипуЦен,Номенклатура);
		Для Каждого Стр из Объект.ТЧТовары Цикл
			СтрЦена = ТЗЦеныПоТипуЦен.Найти(Стр.Номенклатура);
			Стр.ЦенаПоТипуЦен = ?(СтрЦена = Неопределено, 0, СтрЦена.Цена);
			//Если Не Объект.ЦенаВключаетНДС Тогда 
			//	Стр.ЦенаПоТипуЦен = Стр.ЦенаПоТипуЦен - РаботаСДокументамиКлиентСервер.РассчитатьСуммуНДС(Стр.СтавкаНДС,Стр.ЦенаПоТипуЦен, Истина);
			//КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Стр из Объект.ТЧТовары Цикл
			Стр.ЦенаПоТипуЦен = 0;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьСрокОплатыНаСервере()
	СрокОплаты = РаботаСДокументами.ПолучитьСрокОплаты(Объект.Контрагент,?(Объект.Ссылка.Пустая(),ТекущаяДата(),Объект.Дата));
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	МасПоиска = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ВТ.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ВТ КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВНаличииОстатки.Характеристика КАК Характеристика,
	|	ТоварыВНаличииОстатки.Серия КАК Серия,
	|	ТоварыВНаличииОстатки.КоличествоОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			,
	|			МестоХранения = &МестоХранения
	|				И (Номенклатура, Характеристика) В
	|					(ВЫБРАТЬ
	|						ВТ.Номенклатура,
	|						ВТ.Характеристика
	|					ИЗ
	|						ВТ КАК ВТ)) КАК ТоварыВНаличииОстатки";
	Запрос.УстановитьПараметр("ВТ",Объект.ТЧТовары.Выгрузить());
	Запрос.УстановитьПараметр("МестоХранения",РегистрыСведений.НастройкиПользователей.СкладПользователя());
	ТЗОстатки = Запрос.Выполнить().Выгрузить();
	Для Каждого Стр из Объект.ТЧТовары Цикл 
		МасОстаток = ТЗОстатки.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",Стр.Номенклатура,Стр.Характеристика));
		Если МасОстаток.Количество() = 0 Тогда Продолжить; КонецЕсли;
		СтрОстаток = МасОстаток.Получить(0);
		Стр.Остаток = СтрОстаток.Остаток;
	КонецЦикла;	
КонецПроцедуры

