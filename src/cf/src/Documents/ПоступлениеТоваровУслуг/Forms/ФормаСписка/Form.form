  <attributes>
    <name>СписокЗаказы</name>
    <id>14</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Заказ.Ссылка КАК Ссылка,
	Заказ.Дата КАК Дата,
	Заказ.Номер КАК Номер,
	Заказ.Контрагент КАК Контрагент,
	Заказ.Организация КАК Организация,
	Заказ.ДатаПоставки КАК ДатаПоставки,
	Заказ.Сумма КАК Сумма,
	СУММА(ЕСТЬNULL(Остатки.КоличествоОстаток, 0)) КАК КоличествоКПоступлению
ИЗ
	Документ.ЗаказПоставщику КАК Заказ
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПоставщикам.Остатки КАК Остатки
		ПО Остатки.ЗаказПоставщику = Заказ.Ссылка
ГДЕ
	Заказ.Проведен
	И НЕ Заказ.ПометкаУдаления
СГРУППИРОВАТЬ ПО
	Заказ.Ссылка,
	Заказ.Дата,
	Заказ.Номер,
	Заказ.Контрагент,
	Заказ.Организация,
	Заказ.ДатаПоставки,
	Заказ.Сумма
ИМЕЮЩИЕ
	СУММА(ЕСТЬNULL(Остатки.КоличествоОстаток, 0)) &gt; 0</queryText>
      <mainTable>Document.ЗаказПоставщику</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Ссылка</dataPath>
        <field>Ссылка</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Дата</dataPath>
        <field>Дата</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Номер</dataPath>
        <field>Номер</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Контрагент</dataPath>
        <field>Контрагент</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Организация</dataPath>
        <field>Организация</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ДатаПоставки</dataPath>
        <field>ДатаПоставки</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Сумма</dataPath>
        <field>Сумма</field>
      </fields>
    </extInfo>
