&НаКлиенте
Процедура ЗаполнитьПоРеализации(Команда)
	СписокТоваров = ПолучитьСписокТоваровРеализацииНаСервере();
	Оп  = Новый ОписаниеОповещения("ПослеВыбораТоваровДляВозврата",ЭтаФорма);
	СписокТоваров.ПоказатьОтметкуЭлементов(Оп,НСтр("fr = 'Sélectionnez les éléments à retourner'; ru = 'Выберите элементы для возврата'; en = 'Select items to return'; es = 'Seleccione los artículos que desea devolver'"));
	ЗаполнитьПоРеализацииНаСервере(СписокТоваров);
КонецПроцедуры

#КонецОбласти

#Область Оповещения

&НаКлиенте
Процедура ПослеВыбораТоваровДляВозврата(Результат,ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда возврат; КонецЕсли;
	Объект.ТЧТовары.Очистить();
	ЗаполнитьПоРеализацииНаСервере(Результат); 
КонецПроцедуры

#КонецОбласти

#Область Дополнительно

&НаСервере
Процедура ОснованиеПриИзмененииНаСервере()
	Об = РеквизитФормыВЗначение("Объект");
	Об.Заполнить(Об.Основание);
	ЗначениеВРеквизитФормы(Об, "Объект");
КонецПроцедуры
 
&НаСервере
Процедура УстановитьЦеныНаСервере()
	РаботаСДокументами.УстановитьЦеныВТабличнойЧасти(Объект.ТЧТовары, ВидЦены, Объект.Дата, Объект.ЦенаВключаетНДС,
		Объект.Контрагент);	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоРеализацииНаСервере(СписокТоваров)
	ТЗОснование = Объект.Основание.ТЧТовары.Выгрузить();
	Для Каждого Стр из СписокТоваров Цикл
		Если Не Стр.ПОметка Тогда Продолжить; КонецЕсли;
		Если Не Объект.ТЧТовары.НайтиСтроки(Новый Структура("Номенклатура",Стр.Значение)).Количество() = 0 Тогда Продолжить; КонецЕсли;
		СтрОснование = ТЗОснование.Найти(Стр.Значение);
		Если СтрОснование = Неопределено Тогда Продолжить; КонецЕсли;
		НС = Объект.ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС,СтрОснование);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокТоваровРеализацииНаСервере()
	СписокТоваров = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НалоговаяНакладнаяТЧТовары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.НалоговаяНакладная.ТЧТовары КАК НалоговаяНакладнаяТЧТовары
	|ГДЕ
	|	НалоговаяНакладнаяТЧТовары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Объект.Основание);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокТоваров.Добавить(Выборка.Номенклатура, ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Выборка.Номенклатура,Неопределено),Ложь);
	КонецЦикла;
	Возврат СписокТоваров;
КонецФункции

&НаСервере
Процедура УстановитьВидЦеныПоДоговору()
	//ВидЦены = ?(ЗначениеЗаполнено(Объект.Договор.ВидЦены),Объект.Договор.ВидЦены, Справочники.ВидыЦен.Розничная);
	ВидЦены = ?(ЗначениеЗаполнено(Объект.Контрагент.ТипЦены),Объект.Контрагент.ТипЦены, Справочники.ВидыЦен.Розничная);
	РаботаСДокументамиКлиентСервер.ЗаполнитьСписокВыбораВидовЦен(ВидЦены, Элементы.ТЧТоварыВидЦены);
	Объект.ЦенаВключаетНДС = ОбщегоНазначенияВызовСервера.ЦенаВключаетНДСПоВидуЦен(ВидЦены);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокиПоРежимуНДС()
	Для Каждого Стр Из Объект.ТЧТовары Цикл
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Стр, Объект.ЦенаВключаетНДС);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти  


