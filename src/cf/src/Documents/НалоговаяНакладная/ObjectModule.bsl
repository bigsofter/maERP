
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(ЭтотОбъект);
	ЦенаВключаетНДС = Истина;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		РаботаСДокументами.МожноСоздатьДокументНаОсновании(Метаданные.Документы.РеализацияТоваровУслуг, ДанныеЗаполнения);
		Дата = ТекущаяДатаСеанса();
		Основание = ДанныеЗаполнения;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Договор = ДанныеЗаполнения.Договор;
		Менеджер = ДанныеЗаполнения.Менеджер;
		ЦенаВключаетНДС = ДанныеЗаполнения.ЦенаВключаетНДС;
		Комментарий = ДанныеЗаполнения.Комментарий;
		Организация = ДанныеЗаполнения.Организация;
		РаботаСВалютами.ЗаполнитьВалютуПоОснованию(ЭтотОбъект, ДанныеЗаполнения);
		Рез = Документы.ЗаказПокупателя.ПолучитьТоварыПоГруппировкам(ДанныеЗаполнения);
		ВыбГруппа = Рез.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		Пока ВыбГруппа.Следующий() Цикл
			Выб = ВыбГруппа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока Выб.Следующий() Цикл
	        	СтрОснование = ДанныеЗаполнения.ТЧТовары.Найти(Выб.КодСтроки, "КодСтроки");
				НС = ТЧТовары.Добавить();
				ЗаполнитьЗначенияСвойств(НС, СтрОснование);
			КонецЦикла;	
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Организация = ДанныеЗаполнения.Организация;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(Контрагент, Организация, Истина); 
		МестоХранения = ДанныеЗаполнения.МестоХранения;
		Основание = ДанныеЗаполнения;		
		ЦенаВключаетНДС = ДанныеЗаполнения.ЦенаВключаетНДС;
		ТЧТовары.Загрузить(ДанныеЗаполнения.ТЧТовары.Выгрузить());
		ТЧСерии.Загрузить(ДанныеЗаполнения.ТЧСерии.Выгрузить());
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Организация = ?(ДанныеЗаполнения.Организация.ОсновнойУчет,ДанныеЗаполнения.Организация,ДанныеЗаполнения.Организация.ВедущаяОрганизация);
		Контрагент = ДанныеЗаполнения.Контрагент;
		Договор = ДанныеЗаполнения.Договор; 
		МестоХранения = ?(ДанныеЗаполнения.Организация.ОсновнойУчет,ДанныеЗаполнения.МестоХранения,ДанныеЗаполнения.Организация.ВедущаяОрганизация.ОсновнойСклад);
		Основание = ДанныеЗаполнения;		
		ЦенаВключаетНДС = ДанныеЗаполнения.ЦенаВключаетНДС;
		ТЧТовары.Загрузить(ДанныеЗаполнения.ТЧТовары.Выгрузить());
		ТЧСерии.Загрузить(ДанныеЗаполнения.ТЧСерии.Выгрузить());
		ТЗТовары = ТЧТовары.Выгрузить();
		ТЗТовары.ЗаполнитьЗначения(ДанныеЗаполнения,"ОтгрузкаТовара");
		ТЧТовары.Загрузить(ТЗТовары);
		РаботаСВалютами.ЗаполнитьВалютуПоОснованию(ЭтотОбъект, ДанныеЗаполнения, Истина);
	КонецЕсли;
	// Удержание НДС у источника (RAS TVA) - из карточки покупателя (docs/plans/commerce-two-orgs.md, Ф2).
	ЗаполнитьУдержаниеНДСПоКонтрагенту();
КонецПроцедуры

// Флажок и процент удержания НДС покупателем у источника (RAS TVA) - из карточки контрагента накладной; вызывается
// заполнением и формой при смене контрагента.
Процедура ЗаполнитьУдержаниеНДСПоКонтрагенту() Экспорт
	УдержаниеНДС = Ложь;
	ПроцентУдержанияНДС = 0;
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "УдержаниеНДС, ПроцентУдержанияНДС");
	УдержаниеНДС = Реквизиты.УдержаниеНДС = Истина;
	ПроцентУдержанияНДС = ?(УдержаниеНДС, Реквизиты.ПроцентУдержанияНДС, 0);
КонецПроцедуры

// Проверки удержания НДС для сообщения в форме до записи (Ф2).
//
// Параметры:
//  Отказ                - Булево - отказ.
//  ПроверяемыеРеквизиты - Массив - проверяемые реквизиты.
//
// BSLLS:EventHandlerOutsideEventRegion-off
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Те же проверки удержания НДС - обязательно и в проведении: программная запись проверку заполнения не вызывает.
	НалоговыеРасчетыПроверки.ПроверитьУдержаниеНДСНакладной(ЭтотОбъект, Отказ);
КонецПроцедуры
// BSLLS:EventHandlerOutsideEventRegion-on

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);
	РаботаСДокументами.УстановитьЗаписьВсехРегистров(Движения);
	Если НалоговыеРасчетыПроверки.ЭтоИсторическаяНакладная(ЭтотОбъект) Тогда
		ПровестиИсторическую();
		Возврат;
	КонецЕсли;
	// Данные для проведения
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ТЗТоварыССериями", СерииИРазмещение.ОбъединитьТоварыССериями(ЭтотОбъект));
	// Блокировки
	Блокировка = Новый БлокировкаДанных;
	// Товар накладная не двигает (ТоварыВНаличии.СформироватьДвижения) - остатки не блокируются.
	// Расчёты - своего контрагента и контрагентов оснований: сторно долга идёт под ними (Ф1 docs/plans/commerce-two-orgs.md).
	КонтрагентыБлокировки = НалоговыеРасчетыПроверки.КонтрагентыБлокировки(ЭтотОбъект);
	// BSLLS:YoLetterUsage-off
	УправляемыеБлокировки.ВзаиморасчётыСПокупателямиКонтрагентов(Блокировка, КонтрагентыБлокировки);
	// BSLLS:YoLetterUsage-on

	Блокировка.Заблокировать();
	// Обязательные проверки удержания НДС - после блокировок, в транзакции проведения (Ф2, Ф3 «Где проверки»).
	НалоговыеРасчетыПроверки.ПроверитьУдержаниеНДСНакладной(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Формируем
	Отказ = Не РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения(ЭтотОбъект);
	Если Отказ Тогда Возврат КонецЕсли;
	РегистрыНакопления.ДенежныеСредстваОрганизаций.СформироватьДвижения(ЭтотОбъект);
	// Расчеты переезжают с реализаций-оснований на накладную: в обычном регистре долг и
	// оплаты отгрузок сторнируются, накладная принимает их на себя, в налоговом - ведется долг.
	РегистрыНакопления.ВзаиморасчётыСПокупателями.СформироватьДвижения(ЭтотОбъект);
	РегистрыНакопления.ВзаиморасчётыСПокупателямиНалоговый.СформироватьДвижения(ЭтотОбъект);
	//РегистрыНакопления.ВзаиморасчётыСПоставщиками.СформироватьПоДопРасходам(ЭтотОбъект);
	//РегистрыНакопления.Продажи.СформироватьДвижения(ЭтотОбъект); // Рассчитывается на основании списанных партий и издержек
	// Записываем
	Движения.Записать();
	// Удержание НДС - отдельным документом, неденежной оплатой накладной (Ф2).
	Документы.УдержаниеНДСПокупателем.ОбновитьПоНакладной(ЭтотОбъект, Отказ);
КонецПроцедуры

// Историческая накладная (Ф4): прежние наборы товара, допрасходов, обычных расчётов и денег клиента - как есть, заново -
// только налоговый регистр и деньги организации (снимок оплат); документ удержания - как у обычной.
//
Процедура ПровестиИсторическую()
	Блокировка = Новый БлокировкаДанных;
	КонтрагентыБлокировки = НалоговыеРасчетыПроверки.КонтрагентыБлокировки(ЭтотОбъект);
	// BSLLS:YoLetterUsage-off
	УправляемыеБлокировки.ВзаиморасчётыСПокупателямиКонтрагентов(Блокировка, КонтрагентыБлокировки);
	// BSLLS:YoLetterUsage-on
	Блокировка.Заблокировать();
	Для Каждого НаборЗаписей Из Движения Цикл
		НаборЗаписей.Очистить();
	КонецЦикла;
	НалоговыеРасчетыПроверки.ВосстановитьПрежниеДвижения(ЭтотОбъект);
	РегистрыНакопления.ДенежныеСредстваОрганизаций.СформироватьДвижения(ЭтотОбъект);
	РегистрыНакопления.ВзаиморасчётыСПокупателямиНалоговый.СформироватьДвижения(ЭтотОбъект);
	Движения.Записать();
	Документы.УдержаниеНДСПокупателем.ОбновитьПоНакладной(ЭтотОбъект);
КонецПроцедуры

// Отмена проведения накладной распроводит её документ удержания НДС; пометка удаления - помечает его (Ф2).
//
// Параметры:
//  Отказ - Булево - отказ.
//
// BSLLS:EventHandlerOutsideEventRegion-off
Процедура ОбработкаУдаленияПроведения(Отказ)
	Документы.УдержаниеНДСПокупателем.ОтменитьПоНакладной(ЭтотОбъект, ПометкаУдаления);
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	// Помеченная накладная без проведения - помечается и документ удержания (Ф2).
	Если ПометкаУдаления Тогда
		Документы.УдержаниеНДСПокупателем.ОтменитьПоНакладной(ЭтотОбъект, Истина);
	КонецЕсли;
КонецПроцедуры
// BSLLS:EventHandlerOutsideEventRegion-on

Процедура ПриКопировании(ОбъектКопирования)
	// Копия накладной покрывает те же отгрузки, что и оригинал: повторное покрытие
	// сторнировало бы их долг и оплаты второй раз. Проверка - по строкам, при записи.
	Ответственный = ПараметрыСеанса.Пользователь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ИмяОснования = "ОтгрузкаТовара";
	// Историческая (замороженная) накладная пишется как есть: проведение сохраняет её движения клиента (Ф4).
	Историческая = ПеренесенныеДокументы.ЭтоИсторическийНалоговыйДокумент(Ссылка);
	ДополнительныеСвойства.Вставить(НалоговыеРасчетыПроверки.СвойствоИсторическаяНакладная(), Историческая);
	// Закрытый период обходится только неизменным документом (Ф4 «Закрытый период»).
	Если Не НалоговыеРасчетыПроверки.ДанныеНеизменныПриПерепроведении(ЭтотОбъект, Историческая) Тогда
		РаботаСДокументами.МожноРедактироватьДокумент(ЭтотОбъект, Отказ);
	КонецЕсли;
	Если Историческая Тогда
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			// BSLLS:YoLetterUsage-off
			НалоговыеРасчетыПроверки.ЗапомнитьПрежниеДвижения(ЭтотОбъект,
				"ТоварыВНаличии, ДополнительныеРасходы, ВзаиморасчётыСПокупателями, ДвиженияДенежныхСредств");
			// BSLLS:YoLetterUsage-on
			// Документ удержания разносит долг по реализациям накладной - под их контрагентами.
			НалоговыеРасчетыПроверки.ЗапомнитьКонтрагентовБлокировки(ЭтотОбъект, ИмяОснования);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	// Основания - под общей блокировкой с налоговыми документами на основаниях (docs/plans/accounting-morocco-f1-s2.md).
	РаботаСДокументами.ЗащититьОснованияНалоговойНакладной(ЭтотОбъект, ИмяОснования, РежимЗаписи, Отказ);
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		РаботаСДокументами.ПроверитьПовторноеПокрытиеОснований(ЭтотОбъект, ИмяОснования, Отказ);
		// Основание с проведёнными возвратами или сертификатами не покрывается - они остались бы на основании (Ф1).
		НалоговыеРасчетыПроверки.ПроверитьВозвратыДоНакладной(ЭтотОбъект, ИмяОснования, Отказ);
		НалоговыеРасчетыПроверки.ЗапомнитьКонтрагентовБлокировки(ЭтотОбъект, ИмяОснования);
	КонецЕсли;
	// Накладная, на которую записали расчёты другие документы, неизменна по аналитикам и основаниям (Ф1).
	НалоговыеРасчетыПроверки.ПроверитьЗависимыеРегистраторы(ЭтотОбъект, ИмяОснования, РежимЗаписи, Отказ);
	Менеджер = РегистрыСведений.КураторыДоговоров.ПолучитьПоследнее(ЭтотОбъект.Дата, Новый Структура("Договор", ЭтотОбъект.Договор)).Куратор;
	//РаботаСДокументами.ПроверкаСоответствияВозвратовРеализации(ЭтотОбъект, РежимЗаписи, Отказ);
	ЭтотОбъект.ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	РаботаСДокументами.ЗаполнитьИтогиДокумента(ЭтотОбъект);
	// Валюта - отгрузок, курс - средний по ним: сумма накладной в основной валюте равна перенесённому долгу.
	Отгрузки = РаботаСДокументами.ОснованияНалоговойНакладной(ЭтотОбъект, "ОтгрузкаТовара");
	РаботаСВалютами.ЗаполнитьВалютуПоОтгрузкам(ЭтотОбъект, Отгрузки, Отказ);
	// Удержание НДС у источника - от суммы НДС, в валюте документа (Ф2).
	Если Не УдержаниеНДС Тогда
		ПроцентУдержанияНДС = 0;
	КонецЕсли;
	ТочностьСуммы = 2;
	// BSLLS:MagicNumber-off - проценты
	СуммаУдержанияНДС = ?(УдержаниеНДС, Окр(СуммаНДС * ПроцентУдержанияНДС / 100, ТочностьСуммы), 0);
	// BSLLS:MagicNumber-on
	Если Не ЗначениеЗаполнено(ДатаИнвойса) Тогда 
		ДатаИнвойса = Дата;
	КонецЕсли;
КонецПроцедуры

// Накладная, на которую записали расчёты другие документы, не удаляется (Ф1 docs/plans/commerce-two-orgs.md).
//
// Параметры:
//  Отказ - Булево - отказ удаления.
//
// BSLLS:EventHandlerOutsideEventRegion-off
Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	НалоговыеРасчетыПроверки.ПроверитьЗависимыеРегистраторы(ЭтотОбъект, "ОтгрузкаТовара", Неопределено, Отказ);
	Если Не Отказ Тогда
		Документы.УдержаниеНДСПокупателем.УдалитьПоНакладной(Ссылка);
	КонецЕсли;
КонецПроцедуры
// BSLLS:EventHandlerOutsideEventRegion-on
