&НаСервере
Процедура ЗаполнитьПоОтгрузкамНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтгрузкаТовараТЧТовары.Ссылка КАК ОтгрузкаТовара,
	|	ОтгрузкаТовараТЧТовары.Номенклатура КАК Номенклатура,
	|	ОтгрузкаТовараТЧТовары.Характеристика КАК Характеристика,
	|	ОтгрузкаТовараТЧТовары.Упаковка КАК Упаковка,
	|	ОтгрузкаТовараТЧТовары.Серия КАК Серия,
	|	ОтгрузкаТовараТЧТовары.УказаноНесколькоСерий КАК УказаноНесколькоСерий,
	|	ОтгрузкаТовараТЧТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ОтгрузкиТоваровОстатки.КоличествоОстаток КАК Количество,
	|	ОтгрузкаТовараТЧТовары.ВидЦены КАК ВидЦены,
	|	ОтгрузкаТовараТЧТовары.ЦенаSKU КАК ЦенаSKU,
	|	ОтгрузкаТовараТЧТовары.Цена КАК Цена,
	|	ОтгрузкаТовараТЧТовары.Сумма КАК Сумма,
	|	ОтгрузкаТовараТЧТовары.ПроцентСкидки КАК ПроцентСкидки,
	|	ОтгрузкаТовараТЧТовары.СуммаСкидки КАК СуммаСкидки,
	|	ОтгрузкаТовараТЧТовары.СуммаСНДС КАК СуммаСНДС,
	|	ОтгрузкаТовараТЧТовары.СтавкаНДС КАК СтавкаНДС,
	|	ОтгрузкаТовараТЧТовары.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	РегистрНакопления.ОтгрузкиТоваров.Остатки(
	|			,
	|			Организация = &Организация
	|				И Контрагент = &Контрагент) КАК ОтгрузкиТоваровОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтгрузкаТовара.ТЧТовары КАК ОтгрузкаТовараТЧТовары
	|		ПО ОтгрузкиТоваровОстатки.ДокументОтгрузки = ОтгрузкаТовараТЧТовары.Ссылка
	|			И ОтгрузкиТоваровОстатки.Номенклатура = ОтгрузкаТовараТЧТовары.Номенклатура
	|ГДЕ
	|	НЕ ОтгрузкиТоваровОстатки.КоличествоОстаток = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтгрузкаТовараТЧУслуги.Ссылка КАК ОтгрузкаТовара,
	|	ОтгрузкаТовараТЧУслуги.Номенклатура КАК Номенклатура,
	|	ОтгрузкиТоваровОстатки.КоличествоОстаток КАК Количество,
	|	ОтгрузкаТовараТЧУслуги.Цена КАК Цена,
	|	ОтгрузкаТовараТЧУслуги.Сумма КАК Сумма,
	|	ОтгрузкаТовараТЧУслуги.СуммаСНДС КАК СуммаСНДС,
	|	ОтгрузкаТовараТЧУслуги.СтавкаНДС КАК СтавкаНДС,
	|	ОтгрузкаТовараТЧУслуги.СуммаНДС КАК СуммаНДС,
	|	ОтгрузкаТовараТЧУслуги.Содержание КАК Содержание
	|ИЗ
	|	РегистрНакопления.ОтгрузкиТоваров.Остатки(
	|			,
	|			Организация = &Организация
	|				И Контрагент = &Контрагент) КАК ОтгрузкиТоваровОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтгрузкаТовара.ТЧУслуги КАК ОтгрузкаТовараТЧУслуги
	|		ПО ОтгрузкиТоваровОстатки.ДокументОтгрузки = ОтгрузкаТовараТЧУслуги.Ссылка
	|			И ОтгрузкиТоваровОстатки.Номенклатура = ОтгрузкаТовараТЧУслуги.Номенклатура
	|ГДЕ
	|	НЕ ОтгрузкиТоваровОстатки.КоличествоОстаток = 0";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	П = Запрос.ВыполнитьПакет();
	Объект.ТЧТовары.Загрузить(П.Получить(0).Выгрузить());
	Объект.ТЧУслуги.Загрузить(П.Получить(1).Выгрузить());
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзExcelНаСервере(Мас)
	Объект.ТЧТовары.Очистить();
	Для Каждого Эл из Мас Цикл
		НС = Объект.ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС,Эл);
		НС.СтавкаНДС = НС.Номенклатура.СтавкаНДС;
		Если ЗначениеЗаполнено(НС.Номенклатура) Тогда 
			НС.Упаковка = НС.Номенклатура.Единица;
		КонецЕсли;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(НС);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументамНаСервере(МассивДокументов)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугТЧТовары.Ссылка КАК ОтгрузкаТовара,
	|	РеализацияТоваровУслугТЧТовары.Номенклатура КАК Номенклатура,
	|	РеализацияТоваровУслугТЧТовары.Характеристика КАК Характеристика,
	|	РеализацияТоваровУслугТЧТовары.Упаковка КАК Упаковка,
	|	РеализацияТоваровУслугТЧТовары.Серия КАК Серия,
	|	РеализацияТоваровУслугТЧТовары.УказаноНесколькоСерий КАК УказаноНесколькоСерий,
	|	РеализацияТоваровУслугТЧТовары.КоличествоУпаковок - ЕСТЬNULL(ВозвратОтПокупателяТЧТовары.КоличествоУпаковок, 0) КАК КоличествоУпаковок,
	|	РеализацияТоваровУслугТЧТовары.Количество - ЕСТЬNULL(ВозвратОтПокупателяТЧТовары.Количество, 0) КАК Количество,
	|	РеализацияТоваровУслугТЧТовары.ВидЦены КАК ВидЦены,
	|	РеализацияТоваровУслугТЧТовары.ЦенаSKU КАК ЦенаSKU,
	|	РеализацияТоваровУслугТЧТовары.Цена КАК Цена,
	|	РеализацияТоваровУслугТЧТовары.Сумма - ЕСТЬNULL(ВозвратОтПокупателяТЧТовары.Количество, 0) КАК Сумма,
	|	РеализацияТоваровУслугТЧТовары.ПроцентСкидки КАК ПроцентСкидки,
	|	РеализацияТоваровУслугТЧТовары.СуммаСкидки КАК СуммаСкидки,
	|	РеализацияТоваровУслугТЧТовары.СуммаСНДС - ЕСТЬNULL(ВозвратОтПокупателяТЧТовары.СуммаСНДС, 0) КАК СуммаСНДС,
	|	РеализацияТоваровУслугТЧТовары.СтавкаНДС КАК СтавкаНДС,
	|	РеализацияТоваровУслугТЧТовары.СуммаНДС - ЕСТЬNULL(ВозвратОтПокупателяТЧТовары.СуммаНДС, 0) КАК СуммаНДС
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК РеализацияТоваровУслугТЧТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратОтПокупателя.ТЧТовары КАК ВозвратОтПокупателяТЧТовары
	|		ПО РеализацияТоваровУслугТЧТовары.Ссылка = ВозвратОтПокупателяТЧТовары.Ссылка.Основание
	|			И РеализацияТоваровУслугТЧТовары.Номенклатура = ВозвратОтПокупателяТЧТовары.Номенклатура
	|			И РеализацияТоваровУслугТЧТовары.КодСтроки = ВозвратОтПокупателяТЧТовары.КодСтроки
	|ГДЕ
	|	РеализацияТоваровУслугТЧТовары.Ссылка В(&МассивДокументов)
	|	И НЕ РеализацияТоваровУслугТЧТовары.Количество - ЕСТЬNULL(ВозвратОтПокупателяТЧТовары.Количество, 0) = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугТЧУслуги.Ссылка КАК ОтгрузкаТовара,
	|	РеализацияТоваровУслугТЧУслуги.Номенклатура КАК Номенклатура,
	|	РеализацияТоваровУслугТЧУслуги.Количество КАК Количество,
	|	РеализацияТоваровУслугТЧУслуги.Цена КАК Цена,
	|	РеализацияТоваровУслугТЧУслуги.Сумма КАК Сумма,
	|	РеализацияТоваровУслугТЧУслуги.СуммаСНДС КАК СуммаСНДС,
	|	РеализацияТоваровУслугТЧУслуги.СтавкаНДС КАК СтавкаНДС,
	|	РеализацияТоваровУслугТЧУслуги.СуммаНДС КАК СуммаНДС,
	|	РеализацияТоваровУслугТЧУслуги.Содержание КАК Содержание
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧУслуги КАК РеализацияТоваровУслугТЧУслуги
	|ГДЕ
	|	РеализацияТоваровУслугТЧУслуги.Ссылка В(&МассивДокументов)";
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	П = Запрос.ВыполнитьПакет();
	Объект.ТЧТовары.Загрузить(П.Получить(0).Выгрузить());
	Объект.ТЧУслуги.Загрузить(П.Получить(1).Выгрузить());
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	МасПоиска = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ВТ.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ВТ КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВНаличииОстатки.Характеристика КАК Характеристика,
	|	ТоварыВНаличииОстатки.Серия КАК Серия,
	|	ТоварыВНаличииОстатки.КоличествоОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			,
	|			МестоХранения = &МестоХранения
	|				И (Номенклатура, Характеристика) В
	|					(ВЫБРАТЬ
	|						ВТ.Номенклатура,
	|						ВТ.Характеристика
	|					ИЗ
	|						ВТ КАК ВТ)) КАК ТоварыВНаличииОстатки";
	Запрос.УстановитьПараметр("ВТ",Объект.ТЧТовары.Выгрузить());
	Запрос.УстановитьПараметр("МестоХранения",Объект.МестоХранения);
	ТЗОстатки = Запрос.Выполнить().Выгрузить();
	Для Каждого Стр из Объект.ТЧТовары Цикл 
		МасОстаток = ТЗОстатки.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",Стр.Номенклатура,Стр.Характеристика));
		Если МасОстаток.Количество() = 0 Тогда 
			Стр.Остаток = 0;
			Продолжить;
		КонецЕсли;
		СтрОстаток = МасОстаток.Получить(0);
		Стр.Остаток = СтрОстаток.Остаток;
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура РучнаяКорректировкаПриИзмененииНаСервере()
	Если Не Объект.РучнаяКорректировка Тогда 
		СпособОплатыНаФорме = РаботаСДокументами.ПолучитьСпособОплаты(Объект);
	КонецЕсли;
	НастроитьФорму();
КонецПроцедуры

#КонецОбласти
