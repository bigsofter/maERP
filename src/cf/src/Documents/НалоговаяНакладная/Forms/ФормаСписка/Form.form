  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ВЫБОР
		КОГДА НЕ ДокументНалоговаяНакладная.Проведен
			ТОГДА -1
		КОГДА ЕСТЬNULL(Оплата.Остаток, ДокументНалоговаяНакладная.Сумма) &lt;= 0
			ТОГДА 0
		КОГДА ЕСТЬNULL(Оплата.Остаток, ДокументНалоговаяНакладная.Сумма) &lt; ДокументНалоговаяНакладная.Сумма
			ТОГДА 1
		ИНАЧЕ 2
	КОНЕЦ КАК НомерКартинкиОплаты,
	ЕСТЬNULL(Оплата.Остаток, ДокументНалоговаяНакладная.Сумма) КАК Долг,
	ДокументНалоговаяНакладная.Ссылка КАК Ссылка,
	ДокументНалоговаяНакладная.Номер КАК Номер,
	ДокументНалоговаяНакладная.Дата КАК Дата,
	ДокументНалоговаяНакладная.Комментарий КАК Комментарий,
	ДокументНалоговаяНакладная.Организация КАК Организация,
	ДокументНалоговаяНакладная.Ответственный КАК Ответственный,
	ДокументНалоговаяНакладная.Сумма КАК Сумма,
	ДокументНалоговаяНакладная.СуммаНДС КАК СуммаНДС,
	ДокументНалоговаяНакладная.СуммаБезНДС КАК СуммаБезНДС,
	ДокументНалоговаяНакладная.Контрагент КАК Контрагент,
	ДокументНалоговаяНакладная.МестоХранения КАК МестоХранения,
	ЕСТЬNULL(ПрисоединённыеФайлыНаличие.ЕстьФайлы, ЛОЖЬ) КАК ЕстьФайлы,
	ДокументНалоговаяНакладная.ДатаИнвойса КАК ДатаИнвойса
ИЗ
	Документ.НалоговаяНакладная КАК ДокументНалоговаяНакладная
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединённыеФайлыНаличие КАК ПрисоединённыеФайлыНаличие
		ПО ДокументНалоговаяНакладная.Ссылка = ПрисоединённыеФайлыНаличие.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Налоговый.Регистратор КАК Регистратор,
			СУММА(ВЫБОР
					КОГДА Налоговый.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
						ТОГДА Налоговый.Сумма
					ИНАЧЕ -Налоговый.Сумма
				КОНЕЦ) КАК Остаток
		ИЗ
			РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Налоговый
		СГРУППИРОВАТЬ ПО
			Налоговый.Регистратор) КАК Оплата
		ПО ДокументНалоговаяНакладная.Ссылка = Оплата.Регистратор</queryText>
      <mainTable>Document.НалоговаяНакладная</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
