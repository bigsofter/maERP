#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	// Учёт станков нельзя выключить, пока на станках лежат материалы: путь выпуска выбирается по данным, и
	// материалы на складе станка остались бы без закрытия. Проверка здесь, а не только в форме настроек, - так
	// её не обойдут мастер первого запуска и программная запись.
	Если ОбменДанными.Загрузка Или Значение Тогда
		Возврат;
	КонецЕсли;

	ТекстЗапрета = ЗагрузкаСтанков.ТекстЗапретаВыключенияУчета();
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, , , , Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
