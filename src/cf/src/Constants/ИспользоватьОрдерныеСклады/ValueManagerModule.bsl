#Область ОбработчикиСобытий

// Запрет выключения опции, пока ордерная схема используется.
//
// Параметры:
//  Отказ - Булево - выставляется при запрете.
//
// BSLLS:DataExchangeLoading-off - запрет действует и при загрузке: иначе загрузка нарушит инвариант опции.
Процедура ПередЗаписью(Отказ)

	// Опцию нельзя выключить, пока ордерная схема используется: признак склада скрыт опцией, а ордера пропали бы из
	// меню (план warehouse-orders-option). Проверка здесь, а не только в форме настроек, - так её не обойдут мастер
	// первого запуска, программная запись и загрузка. Исключительная блокировка опции - до поиска складов и ордеров:
	// их запись берёт ту же блокировку разделяемо.
	Если Значение Тогда
		Возврат;
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	УправляемыеБлокировки.ОпцияОрдерныхСкладов(Блокировка, Истина);
	Блокировка.Заблокировать();
	ТекстЗапрета = Справочники.МестаХранения.ТекстЗапретаВыключенияОрдерности();
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, , , , Отказ);
	КонецЕсли;

КонецПроцедуры
// BSLLS:DataExchangeLoading-on

#КонецОбласти
