#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	// Производство нельзя выключить, пока на станках открыты требования-накладные или лежат закреплённые материалы:
	// выпуск по ним закрывает только раздел производства. Проверка здесь, а не только в форме настроек, - так её не
	// обойдут мастер первого запуска и программная запись.
	Если ОбменДанными.Загрузка Или Значение Тогда
		Возврат;
	КонецЕсли;

	ТекстЗапрета = ЗагрузкаСтанков.ТекстЗапретаВыключенияУчета();
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, , , , Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
