
#Область Интерфейс

// Возвращает способ пополнения, соответствующий типу номенклатуры.
// Значение используется для новых элементов, при смене типа и при обновлении базы.
// Пользовательский выбор "Оба" эта функция не устанавливает.
//
// Параметры:
//  ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры - тип номенклатуры.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СпособыПополненияЗапасов - способ пополнения по умолчанию.
//
Функция СпособПополненияПоУмолчанию(ТипНоменклатуры) Экспорт

	Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Продукция
		Или ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Полуфабрикат Тогда
		Возврат Перечисления.СпособыПополненияЗапасов.Производство;
	КонецЕсли;

	Возврат Перечисления.СпособыПополненияЗапасов.Закупка;

КонецФункции

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	Если Не Параметры.Свойство("ПодменаАвтоподбора") Тогда Возврат КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Если Параметры.СтрокаПоиска = "" Тогда Возврат КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 30
	                      |	Номенклатура.Ссылка КАК Ссылка
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	Справочник.Номенклатура КАК Номенклатура
	                      |ГДЕ
	                      |	(Номенклатура.Наименование ПОДОБНО &Наименование
	                      |			ИЛИ Номенклатура.Артикул ПОДОБНО &Наименование
	                      |			ИЛИ Номенклатура.КодПоставщика ПОДОБНО &Наименование
	                      |			ИЛИ Номенклатура.КодПроизводителя ПОДОБНО &Наименование)
	                      |	И ВЫБОР
	                      |			КОГДА &ПометкаУдаления
	                      |				ТОГДА ИСТИНА
	                      |			ИНАЧЕ Номенклатура.ПометкаУдаления = ЛОЖЬ
	                      |		КОНЕЦ
	                      |	И ВЫБОР
	                      |			КОГДА &ЕстьТипыНоменклатуры
	                      |				ТОГДА Номенклатура.ТипНоменклатуры В (&ТипыНоменклатуры)
	                      |			ИНАЧЕ ИСТИНА
	                      |		КОНЕЦ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.Ссылка КАК Ссылка,
	                      |	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика
	                      |ПОМЕСТИТЬ ВТНоменклатура
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ВТ.Ссылка,
	                      |	ХарактеристикиНоменклатуры.Ссылка
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	                      |		ПО ВТ.Ссылка = ХарактеристикиНоменклатуры.Владелец
	                      |			И (НЕ ХарактеристикиНоменклатуры.ПометкаУдаления)
	                      |			И (ВЫБОР
	                      |				КОГДА &ИсключитьХарактеристикиДляВнутреннегоИспользования
	                      |					ТОГДА НЕ ХарактеристикиНоменклатуры.ДляВнутреннегоИспользования
	                      |				ИНАЧЕ ИСТИНА
	                      |			КОНЕЦ)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТНоменклатура.Ссылка КАК Ссылка,
	                      |	ВТНоменклатура.Характеристика КАК Характеристика,
	                      |	ВТНоменклатура.Ссылка.Единица КАК Единица,
	                      |	ВЫБОР
	                      |		КОГДА &ВыводитьСерию
	                      |			ТОГДА ЕСТЬNULL(ТоварыВНаличииОстатки.Серия, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка))
	                      |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	                      |	КОНЕЦ КАК Серия,
	                      |	СУММА(ЕСТЬNULL(ТоварыВНаличииОстатки.КоличествоОстаток, 0)) КАК Остаток,
	                      |	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	                      |	ВТНоменклатура.Ссылка.КодПоставщика КАК КодПоставщика,
	                      |	ВТНоменклатура.Ссылка.КодПроизводителя КАК КодПроизводителя
	                      |ИЗ
	                      |	ВТНоменклатура КАК ВТНоменклатура
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВНаличии.Остатки(
	                      |				&ДатаДокумента,
	                      |				ВЫБОР
	                      |					КОГДА &МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
	                      |						ТОГДА ИСТИНА
	                      |					ИНАЧЕ МестоХранения = &МестоХранения
	                      |				КОНЕЦ) КАК ТоварыВНаличииОстатки
	                      |		ПО ВТНоменклатура.Ссылка = ТоварыВНаличииОстатки.Номенклатура
	                      |			И ВТНоменклатура.Характеристика = ТоварыВНаличииОстатки.Характеристика
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	                      |		ПО ВТНоменклатура.Ссылка = ЦеныНоменклатурыСрезПоследних.Номенклатура
	                      |			И ВТНоменклатура.Характеристика = ЦеныНоменклатурыСрезПоследних.Характеристика
	                      |			И (ВЫБОР
	                      |				КОГДА &ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	                      |					ТОГДА ЛОЖЬ
	                      |				ИНАЧЕ ЦеныНоменклатурыСрезПоследних.ВидЦены = &ВидЦены
	                      |			КОНЕЦ)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТНоменклатура.Ссылка,
	                      |	ВТНоменклатура.Характеристика,
	                      |	ВТНоменклатура.Ссылка.Единица,
	                      |	ВЫБОР
	                      |		КОГДА &ВыводитьСерию
	                      |			ТОГДА ЕСТЬNULL(ТоварыВНаличииОстатки.Серия, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка))
	                      |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	                      |	КОНЕЦ,
	                      |	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ВТНоменклатура.Ссылка.Наименование,
	                      |	ВТНоменклатура.Характеристика.Наименование");
	Запрос.УстановитьПараметр("Наименование", "%" + СтрЗаменить(Параметры.СтрокаПоиска, " ", "%") + "%");
	Запрос.УстановитьПараметр("ПометкаУдаления", ?(Параметры.Отбор.Свойство("ПометкаУдаления"), Параметры.Отбор.ПометкаУдаления, Истина));
	Запрос.УстановитьПараметр("ЕстьТипыНоменклатуры", Параметры.Отбор.Свойство("ТипНоменклатуры"));
	Запрос.УстановитьПараметр("ТипыНоменклатуры", ?(Параметры.Отбор.Свойство("ТипНоменклатуры"), Параметры.Отбор.ТипНоменклатуры, Новый Массив));
	Запрос.УстановитьПараметр("МестоХранения", ?(Параметры.Отбор.Свойство("МестоХранения"), Параметры.Отбор.МестоХранения, РегистрыСведений.НастройкиПользователей.СкладПользователя()));
	Запрос.УстановитьПараметр("ДатаДокумента", ?(Параметры.Отбор.Свойство("ДатаДокумента"), Параметры.Отбор.ДатаДокумента, ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ВыводитьСерию", ?(Параметры.Свойство("ВыводитьСерию"), Параметры.ВыводитьСерию, Ложь));
	ПараметрыАвтоподбора = Параметры.Отбор.ПараметрыАвтоподбора;
	Запрос.УстановитьПараметр("ВидЦены", ?(ЗначениеЗаполнено(ПараметрыАвтоподбора.ВидЦены), ПараметрыАвтоподбора.ВидЦены, Справочники.ВидыЦен.ПустаяСсылка()));
	Запрос.УстановитьПараметр("ИсключитьХарактеристикиДляВнутреннегоИспользования", ПараметрыАвтоподбора.ИсключитьХарактеристикиДляВнутреннегоИспользования);
	Выб = Запрос.Выполнить().Выбрать();	
	ДанныеВыбора = Новый СписокЗначений;
	Пока Выб.Следующий() Цикл
		Структура = Новый Структура("Ссылка, Характеристика, Серия, Упаковка, Единица, Остаток, Цена, КодПоставщика, КодПроизводителя");
		ЗаполнитьЗначенияСвойств(Структура, Выб);
		ДанныеВыбора.Добавить(Структура);
	КонецЦикла;    
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Подбор номенклатуры в колонках документов (S7).

// Назначение колонки подбора: продукция заказа на производство (верх рабочего места производства, товары заказа).
//
// Возвращаемое значение:
//  Строка - назначение для ТипыПодбора и ДанныеПодбора.
//
Функция НазначениеПодбораПродукция() Экспорт

	Возврат "Продукция";

КонецФункции

// Назначение колонки подбора: материалы (закупки и переработка рабочего места производства, материалы заказа).
//
// Возвращаемое значение:
//  Строка - назначение для ТипыПодбора и ДанныеПодбора.
//
Функция НазначениеПодбораМатериалы() Экспорт

	Возврат "Материалы";

КонецФункции

// Типы номенклатуры, которые предлагает подбор колонки (S7, решение владельца 2026-09-22): продукция - готовая
// продукция и полуфабрикаты, материалы - сырьё, полуфабрикаты и товары. Услуги и комплекты не предлагаются нигде.
//
// Параметры:
//  Назначение - Строка - см. НазначениеПодбораПродукция, НазначениеПодбораМатериалы.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ПеречислениеСсылка.ТипыНоменклатуры - типы подбора.
//
Функция ТипыПодбора(Назначение) Экспорт

	Типы = Новый Массив;
	Если Назначение = НазначениеПодбораПродукция() Тогда
		Типы.Добавить(Перечисления.ТипыНоменклатуры.Продукция);
		Типы.Добавить(Перечисления.ТипыНоменклатуры.Полуфабрикат);
	ИначеЕсли Назначение = НазначениеПодбораМатериалы() Тогда
		Типы.Добавить(Перечисления.ТипыНоменклатуры.Сырье);
		Типы.Добавить(Перечисления.ТипыНоменклатуры.Полуфабрикат);
		Типы.Добавить(Перечисления.ТипыНоменклатуры.Товар);
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестное назначение подбора номенклатуры: %1", Назначение);
	КонецЕсли;
	Возврат Новый ФиксированныйМассив(Типы);

КонецФункции

// Последние созданные позиции номенклатуры заданных типов: не группы, без пометки удаления, с заполненной датой
// создания (у позиций без даты порядок бессмыслен).
//
// Параметры:
//  Типы       - Массив, ФиксированныйМассив из ПеречислениеСсылка.ТипыНоменклатуры - типы позиций.
//  Количество - Число - сколько позиций вернуть.
//
// Возвращаемое значение:
//  СписокЗначений - от новых к старым; значение - Структура: Номенклатура, Характеристика (пустая); представление -
//                   «наименование - создано дд.ММ.гггг».
//
Функция ПоследниеСозданные(Типы, Количество) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.ДатаСоздания КАК ДатаСоздания
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И Номенклатура.ТипНоменклатуры В (&Типы)
	|	И Номенклатура.ДатаСоздания > &ПустаяДата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура.ДатаСоздания УБЫВ,
	|	Номенклатура.Наименование";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1", "ПЕРВЫЕ " + Формат(Макс(1, Количество), "ЧГ=0"));
	Запрос.УстановитьПараметр("Типы", Новый Массив(Типы));
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
	Список = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = Новый Структура("Номенклатура, Характеристика", Выборка.Номенклатура,
			Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		Создано = СтрШаблон(НСтр("ru = 'создано %1'; fr = 'créé le %1'; en = 'created %1'; es = 'creado el %1'"),
			Формат(Выборка.ДатаСоздания, "ДЛФ=D"));
		Список.Добавить(Значение, СтрШаблон("%1 - %2", Выборка.Наименование, Создано));
	КонецЦикла;
	Возврат Список;

КонецФункции

// Данные подбора номенклатуры для колонки: один серверный вызов на нажатие кнопки выбора.
//
// Параметры:
//  Назначение - Строка - см. НазначениеПодбораПродукция, НазначениеПодбораМатериалы.
//
// Возвращаемое значение:
//  Структура:
//   * Типы   - ФиксированныйМассив из ПеречислениеСсылка.ТипыНоменклатуры - см. ТипыПодбора.
//   * Пункты - СписокЗначений - первые пункты списка выбора: у продукции - последние созданные (см. ПоследниеСозданные),
//              у материалов - пусто (материалы заказа форма добавляет сама).
//   * Мягкий - Булево - отбор мягкий: список предлагает и выбор из всей номенклатуры (материалы).
//
Функция ДанныеПодбора(Назначение) Экспорт

	Типы = ТипыПодбора(Назначение);
	ЭтоПродукция = Назначение = НазначениеПодбораПродукция();
	КоличествоПоследних = 10;
	Пункты = ?(ЭтоПродукция, ПоследниеСозданные(Типы, КоличествоПоследних), Новый СписокЗначений);
	Возврат Новый Структура("Типы, Пункты, Мягкий", Типы, Пункты, Не ЭтоПродукция);

КонецФункции

// Имя дополнительного свойства объекта, в котором форма передаёт таблицу минимумов по складам: объект пишет их
// в ПриЗаписи (см. ЗаписатьМинимумыПоСкладам).
//
// Возвращаемое значение:
//  Строка - имя свойства
//
Функция ИмяСвойстваМинимумовПоСкладам() Экспорт

	Возврат "МинимумыПоСкладам";

КонецФункции

// Пишет минимумы и максимумы по складам товара: только строки, которых в регистре нет или которые от него
// отличаются. Каждая строка - своим набором с отбором по обоим измерениям (номенклатура и склад), поэтому
// записи других складов не затрагиваются. Вызывается в транзакции записи товара (ПриЗаписи объекта).
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - записанный товар
//  Минимумы     - ТаблицаЗначений - колонки МестоХранения, МинимальноеКоличествоХранения,
//                 МаксимальноеКоличествоХранения
//
Процедура ЗаписатьМинимумыПоСкладам(Номенклатура, Минимумы) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Или Минимумы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.МинимальныйОстатокПоСкладам");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Номенклатура", Номенклатура);
	Блокировка.Заблокировать();

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Минимумы.МестоХранения КАК МестоХранения,
	|	Минимумы.МинимальноеКоличествоХранения КАК МинимальноеКоличествоХранения,
	|	Минимумы.МаксимальноеКоличествоХранения КАК МаксимальноеКоличествоХранения
	|ИЗ
	|	РегистрСведений.МинимальныйОстатокПоСкладам КАК Минимумы
	|ГДЕ
	|	Минимумы.Номенклатура = &Номенклатура");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	ВРегистре = Запрос.Выполнить().Выгрузить();
	ВРегистре.Индексы.Добавить("МестоХранения");

	Для Каждого Строка Из Минимумы Цикл
		Если Не ЗначениеЗаполнено(Строка.МестоХранения) Тогда
			Продолжить;
		КонецЕсли;
		Записанная = ВРегистре.Найти(Строка.МестоХранения, "МестоХранения");
		Если Записанная <> Неопределено
			И Записанная.МинимальноеКоличествоХранения = Строка.МинимальноеКоличествоХранения
			И Записанная.МаксимальноеКоличествоХранения = Строка.МаксимальноеКоличествоХранения Тогда
			Продолжить;
		КонецЕсли;
		Набор = РегистрыСведений.МинимальныйОстатокПоСкладам.СоздатьНаборЗаписей();
		Набор.Отбор.Номенклатура.Установить(Номенклатура);
		Набор.Отбор.МестоХранения.Установить(Строка.МестоХранения);
		Запись = Набор.Добавить();
		Запись.Номенклатура = Номенклатура;
		Запись.МестоХранения = Строка.МестоХранения;
		Запись.МинимальноеКоличествоХранения = Строка.МинимальноеКоличествоХранения;
		Запись.МаксимальноеКоличествоХранения = Строка.МаксимальноеКоличествоХранения;
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Документ установки цен из карточки товара: новый или перезаполненный прежний, проводится. Вызывается в транзакции
// записи товара (ПриЗаписиНаСервере карточки).
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар
//  Цены         - ТаблицаЗначений - колонки ВидЦены, Цена; нулевые цены пропускаются
//  Документ     - ДокументСсылка.УстановкаЦенНоменклатурыВручную - прежний документ карточки; пустой - создать новый
//
// Возвращаемое значение:
//  ДокументСсылка.УстановкаЦенНоменклатурыВручную - проведённый документ
//
Функция ЗаписатьЦеныКарточки(Номенклатура, Цены, Документ) Экспорт

	ДокументОбъект = Неопределено;
	Если ЗначениеЗаполнено(Документ) Тогда
		ДокументОбъект = Документ.ПолучитьОбъект();
	КонецЕсли;
	Если ДокументОбъект = Неопределено Тогда
		ДокументОбъект = Документы.УстановкаЦенНоменклатурыВручную.СоздатьДокумент();
		ДокументОбъект.Ответственный = ПараметрыСеанса.Пользователь;
	Иначе
		ДокументОбъект.ТЧЦены.Очистить();
	КонецЕсли;
	ДокументОбъект.Номенклатура = Номенклатура;
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	Для Каждого Строка Из Цены Цикл
		Если Строка.Цена = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ДокументОбъект.ТЧЦены.Добавить();
		НоваяСтрока.ВидЦены = Строка.ВидЦены;
		НоваяСтрока.Цена = Строка.Цена;
	КонецЦикла;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Возврат ДокументОбъект.Ссылка;

КонецФункции

// Занят ли артикул другим товаром (группы не считаются).
//
// Параметры:
//  Артикул - Строка - проверяемый артикул
//  Ссылка  - СправочникСсылка.Номенклатура - сам товар; пустая - новый
//
// Возвращаемое значение:
//  Булево - Истина, если есть другой товар с этим артикулом
//
Функция АртикулЗанят(Артикул, Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Артикул) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &Артикул
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И Номенклатура.Ссылка <> &Ссылка");
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Текст запроса динамического списка товаров (ФормаСписка). Одна строка на товар: остаток - свёрнутый вложенный
// запрос по складу фильтра (у регистра остатков характеристика, серия и партии), цены поставщика и розничная - срезы
// по всем измерениям. Продажи в список не входят: они в панели «Движение» по текущей строке. Минимумы складов
// (для «ниже минимума») соединяются, только если у пользователя есть право их читать: иначе запрос к регистру упал
// бы при открытии списка (кладовщик, менеджер по продажам), и минимум берётся из карточки товара.
// Параметры - см. ПараметрыЗапросаСписка; отборы панели - группа «Панель» отбора списка, см. УстановитьОтборыПанели.
//
// Параметры:
//  СМинимумами - Булево, Неопределено - соединять минимумы складов; Неопределено - по праву чтения регистра
//  ССведениями - Булево, Неопределено - значения свойств-сведений (регистр); Неопределено - по праву чтения регистра
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаСписка(Знач СМинимумами = Неопределено, Знач ССведениями = Неопределено) Экспорт

	// Динамический список: условия контекста включаются параметрами (ВЫБОР КОГДА &...Установлены ... ИЛИ ...),
	// цены - срезами последних, остаток - свёрнутым вложенным запросом (одна строка на товар, ревью плана Codex P1).
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	// BSLLS:JoinWithVirtualTable-off
	// BSLLS:JoinWithSubQuery-off
	Текст =
	"ВЫБРАТЬ
	|	СправочникНоменклатура.Ссылка КАК Ссылка,
	|	СправочникНоменклатура.Код КАК Код,
	|	СправочникНоменклатура.Наименование КАК Наименование,
	|	СправочникНоменклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	СправочникНоменклатура.ПометкаУдаления КАК ПометкаУдаления,
	|	СправочникНоменклатура.Родитель КАК Родитель,
	|	СправочникНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	СправочникНоменклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	СправочникНоменклатура.СтавкаНДС КАК СтавкаНДС,
	|	СправочникНоменклатура.Артикул КАК Артикул,
	|	СправочникНоменклатура.Единица КАК Единица,
	|	СправочникНоменклатура.Бренд КАК Бренд,
	|	СправочникНоменклатура.Качество КАК Качество,
	|	СправочникНоменклатура.ТоварнаяГруппа КАК ТоварнаяГруппа,
	|	СправочникНоменклатура.СпособПополнения КАК СпособПополнения,
	|	СправочникНоменклатура.КодСтарый КАК КодСтарый,
	|	СправочникНоменклатура.ЯчейкиСтрокой КАК ЯчейкиСтрокой,
	|	СправочникНоменклатура.КодПоставщика КАК КодПоставщика,
	|	СправочникНоменклатура.КодПроизводителя КАК КодПроизводителя,
	|	СправочникНоменклатура.ОсновнойПоставщик КАК ОсновнойПоставщик,
	|	ЕСТЬNULL(Остатки.Количество, 0) КАК КоличествоОстаток,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Остатки.Количество, 0) > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ВНаличии,
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.ЭтоГруппа
	|			ТОГДА ЛОЖЬ
	|		КОГДА ЕСТЬNULL(Остатки.Количество, 0) < ЕСТЬNULL(Минимумы.МинимальноеКоличествоХранения,
	|				СправочникНоменклатура.МинимальноеКоличествоХранения)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НижеМинимума,
	|	ЕСТЬNULL(ПрисоединённыеФайлыНаличие.ЕстьФайлы, ЛОЖЬ) КАК ЕстьФайлы,
	|	ЕСТЬNULL(ЦеныПоставщика.ЦенаЕдиницыХранения, 0) КАК ЦенаЗакупки,
	|	ЕСТЬNULL(ЦеныРозничные.Цена, 0) КАК РозничнаяЦена,
	|	ЗначенияИерархии.Значение КАК ЗначениеИерархии
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОстаткиСклада.Номенклатура КАК Номенклатура,
	|			СУММА(ОстаткиСклада.КоличествоОстаток) КАК Количество
	|		ИЗ
	|			РегистрНакопления.ТоварыВНаличии.Остатки(
	|					,
	|					НЕ &СкладУстановлен
	|						ИЛИ МестоХранения = &МестоХранения) КАК ОстаткиСклада
	|		СГРУППИРОВАТЬ ПО
	|			ОстаткиСклада.Номенклатура) КАК Остатки
	|		ПО СправочникНоменклатура.Ссылка = Остатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальныйОстатокПоСкладам КАК Минимумы
	|		ПО СправочникНоменклатура.Ссылка = Минимумы.Номенклатура
	|			И (&СкладУстановлен)
	|			И (Минимумы.МестоХранения = &МестоХранения)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединённыеФайлыНаличие КАК ПрисоединённыеФайлыНаличие
	|		ПО СправочникНоменклатура.Ссылка = ПрисоединённыеФайлыНаличие.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатурыПоставщиков.СрезПоследних(
	|				,
	|				Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ЦеныПоставщика
	|		ПО СправочникНоменклатура.Ссылка = ЦеныПоставщика.Номенклатура
	|			И СправочникНоменклатура.ОсновнойПоставщик = ЦеныПоставщика.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				,
	|				ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Розничная)
	|					И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|					И ТоварнаяГруппа = ЗНАЧЕНИЕ(Справочник.ТоварныеГруппы.ПустаяСсылка)) КАК ЦеныРозничные
	|		ПО СправочникНоменклатура.Ссылка = ЦеныРозничные.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Реквизиты.Ссылка КАК Объект,
	|			Реквизиты.Значение КАК Значение
	|		ИЗ
	|			Справочник.Номенклатура.ДополнительныеРеквизиты КАК Реквизиты
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					Строки.Ссылка КАК Ссылка,
	|					МАКСИМУМ(Строки.НомерСтроки) КАК НомерСтроки
	|				ИЗ
	|					Справочник.Номенклатура.ДополнительныеРеквизиты КАК Строки
	|				ГДЕ
	|					Строки.Свойство = &СвойствоИерархии
	|				СГРУППИРОВАТЬ ПО
	|					Строки.Ссылка) КАК Последние
	|				ПО Реквизиты.Ссылка = Последние.Ссылка
	|					И Реквизиты.НомерСтроки = Последние.НомерСтроки
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Сведения.Объект,
	|			Сведения.Значение
	|		ИЗ
	|			РегистрСведений.ДополнительныеСведения КАК Сведения
	|		ГДЕ
	|			Сведения.Свойство = &СвойствоИерархии) КАК ЗначенияИерархии
	|		ПО СправочникНоменклатура.Ссылка = ЗначенияИерархии.Объект
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &СпособыПополненияУстановлены
	|				ТОГДА СправочникНоменклатура.ЭтоГруппа
	|						ИЛИ СправочникНоменклатура.СпособПополнения В (&СпособыПополнения)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ИсключаемыеТипыУстановлены
	|				ТОГДА СправочникНоменклатура.ЭтоГруппа
	|						ИЛИ НЕ СправочникНоменклатура.ТипНоменклатуры В (&ИсключаемыеТипы)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоСвойству
	|				ТОГДА СправочникНоменклатура.Ссылка В
	|						(ВЫБРАТЬ
	|							ЗначенияОтбора.Объект КАК Объект
	|						ИЗ
	|							(ВЫБРАТЬ
	|									Реквизиты.Ссылка КАК Объект,
	|									Реквизиты.Значение КАК Значение
	|								ИЗ
	|									Справочник.Номенклатура.ДополнительныеРеквизиты КАК Реквизиты
	|										ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|											Строки.Ссылка КАК Ссылка,
	|											МАКСИМУМ(Строки.НомерСтроки) КАК НомерСтроки
	|										ИЗ
	|											Справочник.Номенклатура.ДополнительныеРеквизиты КАК Строки
	|										ГДЕ
	|											Строки.Свойство = &СвойствоОтбора
	|										СГРУППИРОВАТЬ ПО
	|											Строки.Ссылка) КАК Последние
	|										ПО Реквизиты.Ссылка = Последние.Ссылка
	|											И Реквизиты.НомерСтроки = Последние.НомерСтроки
	|						
	|								ОБЪЕДИНИТЬ ВСЕ
	|						
	|								ВЫБРАТЬ
	|									Сведения.Объект,
	|									Сведения.Значение
	|								ИЗ
	|									РегистрСведений.ДополнительныеСведения КАК Сведения
	|								ГДЕ
	|									Сведения.Свойство = &СвойствоОтбора) КАК ЗначенияОтбора
	|						ГДЕ
	|							ЗначенияОтбора.Значение = &ЗначениеОтбора)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	// BSLLS:JoinWithSubQuery-on
	Если ССведениями = Неопределено Тогда
		ССведениями = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ДополнительныеСведения);
	КонецЕсли;
	Если Не ССведениями Тогда
		Текст = БезДополнительныхСведений(Текст);
	КонецЕсли;
	Если СМинимумами = Неопределено Тогда
		СМинимумами = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.МинимальныйОстатокПоСкладам);
	КонецЕсли;
	Если Не СМинимумами Тогда
		Текст = СтрЗаменить(Текст, "ЕСТЬNULL(Минимумы.МинимальноеКоличествоХранения,
		|				СправочникНоменклатура.МинимальноеКоличествоХранения)",
			"СправочникНоменклатура.МинимальноеКоличествоХранения");
		Текст = СтрЗаменить(Текст, "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальныйОстатокПоСкладам КАК Минимумы
		|		ПО СправочникНоменклатура.Ссылка = Минимумы.Номенклатура
		|			И (&СкладУстановлен)
		|			И (Минимумы.МестоХранения = &МестоХранения)", "");
	КонецЕсли;
	// BSLLS:JoinWithVirtualTable-on
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	Возврат Текст;

КонецФункции

// Текст запроса динамического списка форм выбора и подбора номенклатуры: состав строк, поля режимов иерархии и
// отборы контекста - как у ТекстЗапросаСписка, но без остатков, минимумов, цен и файлов. Формы выбора открывают роли,
// которым эти регистры читать не разрешено (кладовщик, кассир, клиент личного кабинета; ревью кода Codex 2.0.16.64).
// Параметры - те же, что у ТекстЗапросаСписка (лишние запрос не использует).
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаВыбора() Экспорт

	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	// BSLLS:JoinWithSubQuery-off
	Текст =
	"ВЫБРАТЬ
	|	СправочникНоменклатура.Ссылка КАК Ссылка,
	|	СправочникНоменклатура.Код КАК Код,
	|	СправочникНоменклатура.Наименование КАК Наименование,
	|	СправочникНоменклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	СправочникНоменклатура.ПометкаУдаления КАК ПометкаУдаления,
	|	СправочникНоменклатура.Родитель КАК Родитель,
	|	СправочникНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	СправочникНоменклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	СправочникНоменклатура.СтавкаНДС КАК СтавкаНДС,
	|	СправочникНоменклатура.Артикул КАК Артикул,
	|	СправочникНоменклатура.Бренд КАК Бренд,
	|	СправочникНоменклатура.Качество КАК Качество,
	|	СправочникНоменклатура.ТоварнаяГруппа КАК ТоварнаяГруппа,
	|	СправочникНоменклатура.СпособПополнения КАК СпособПополнения,
	|	СправочникНоменклатура.ОсновнойПоставщик КАК ОсновнойПоставщик,
	|	ЗначенияИерархии.Значение КАК ЗначениеИерархии
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Реквизиты.Ссылка КАК Объект,
	|			Реквизиты.Значение КАК Значение
	|		ИЗ
	|			Справочник.Номенклатура.ДополнительныеРеквизиты КАК Реквизиты
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					Строки.Ссылка КАК Ссылка,
	|					МАКСИМУМ(Строки.НомерСтроки) КАК НомерСтроки
	|				ИЗ
	|					Справочник.Номенклатура.ДополнительныеРеквизиты КАК Строки
	|				ГДЕ
	|					Строки.Свойство = &СвойствоИерархии
	|				СГРУППИРОВАТЬ ПО
	|					Строки.Ссылка) КАК Последние
	|				ПО Реквизиты.Ссылка = Последние.Ссылка
	|					И Реквизиты.НомерСтроки = Последние.НомерСтроки
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Сведения.Объект,
	|			Сведения.Значение
	|		ИЗ
	|			РегистрСведений.ДополнительныеСведения КАК Сведения
	|		ГДЕ
	|			Сведения.Свойство = &СвойствоИерархии) КАК ЗначенияИерархии
	|		ПО СправочникНоменклатура.Ссылка = ЗначенияИерархии.Объект
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &СпособыПополненияУстановлены
	|				ТОГДА СправочникНоменклатура.ЭтоГруппа
	|						ИЛИ СправочникНоменклатура.СпособПополнения В (&СпособыПополнения)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ИсключаемыеТипыУстановлены
	|				ТОГДА СправочникНоменклатура.ЭтоГруппа
	|						ИЛИ НЕ СправочникНоменклатура.ТипНоменклатуры В (&ИсключаемыеТипы)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоСвойству
	|				ТОГДА СправочникНоменклатура.Ссылка В
	|						(ВЫБРАТЬ
	|							ЗначенияОтбора.Объект КАК Объект
	|						ИЗ
	|							(ВЫБРАТЬ
	|									Реквизиты.Ссылка КАК Объект,
	|									Реквизиты.Значение КАК Значение
	|								ИЗ
	|									Справочник.Номенклатура.ДополнительныеРеквизиты КАК Реквизиты
	|										ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|											Строки.Ссылка КАК Ссылка,
	|											МАКСИМУМ(Строки.НомерСтроки) КАК НомерСтроки
	|										ИЗ
	|											Справочник.Номенклатура.ДополнительныеРеквизиты КАК Строки
	|										ГДЕ
	|											Строки.Свойство = &СвойствоОтбора
	|										СГРУППИРОВАТЬ ПО
	|											Строки.Ссылка) КАК Последние
	|										ПО Реквизиты.Ссылка = Последние.Ссылка
	|											И Реквизиты.НомерСтроки = Последние.НомерСтроки
	|						
	|								ОБЪЕДИНИТЬ ВСЕ
	|						
	|								ВЫБРАТЬ
	|									Сведения.Объект,
	|									Сведения.Значение
	|								ИЗ
	|									РегистрСведений.ДополнительныеСведения КАК Сведения
	|								ГДЕ
	|									Сведения.Свойство = &СвойствоОтбора) КАК ЗначенияОтбора
	|						ГДЕ
	|							ЗначенияОтбора.Значение = &ЗначениеОтбора)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	// BSLLS:JoinWithSubQuery-on
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ДополнительныеСведения) Тогда
		Текст = БезДополнительныхСведений(Текст);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Контекст открытия списка товаров: параметры формы, ограничивающие состав (команды разделов).
//
// Возвращаемое значение:
//  Структура:
//   * ТолькоЗакупаемые  - Булево - способ пополнения «Закупка» или «Оба» (при включённом производстве)
//   * ТолькоПродаваемые - Булево - без сырья и полуфабрикатов (при включённом производстве)
//   * ТолькоТовары      - Булево - без услуг и комплектов
//   * ОтборТипа         - ПеречислениеСсылка.ТипыНоменклатуры - только этот тип; пустой - любой
//   * Типы              - Массив из ПеречислениеСсылка.ТипыНоменклатуры - только эти типы (подбор по назначению,
//                         отбор формы выбора); пустой - любые
//   * ДляВыбора         - Булево - форма выбора или подбора: запрос ТекстЗапросаВыбора (без остатков и цен)
//
Функция НовыйКонтекстСписка() Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("ТолькоЗакупаемые", Ложь);
	Контекст.Вставить("ТолькоПродаваемые", Ложь);
	Контекст.Вставить("ТолькоТовары", Ложь);
	Контекст.Вставить("ОтборТипа", Перечисления.ТипыНоменклатуры.ПустаяСсылка());
	Контекст.Вставить("Типы", Новый Массив);
	Контекст.Вставить("ДляВыбора", Ложь);
	Возврат Контекст;

КонецФункции

// Фильтры панели «Сведения» списка товаров со значениями «все».
//
// Возвращаемое значение:
//  Структура:
//   * Тип                 - ПеречислениеСсылка.ТипыНоменклатуры - пустой - все
//   * Пополнение          - ПеречислениеСсылка.СпособыПополненияЗапасов - пустой - все
//   * Наличие             - Число - 0 все, 1 в наличии, 2 нет в наличии, 3 ниже минимума (по складу фильтра)
//   * Склад               - СправочникСсылка.МестаХранения - склад остатка; пустой - все склады
//   * ТоварнаяГруппа, Бренд, ОсновнойПоставщик, Качество - ссылки; пустая - все
//   * ПоказыватьПомеченные - Булево - показывать помеченные на удаление
//   * Свойство            - ПланВидовХарактеристикСсылка.ДополнительныеРеквизиты - отбор «свойство = значение»
//   * ЗначениеСвойства    - Произвольный - значение свойства; пустое - отбора по свойству нет
//
Функция НовыеОтборыПанели() Экспорт

	Отборы = Новый Структура;
	Отборы.Вставить("Тип", Перечисления.ТипыНоменклатуры.ПустаяСсылка());
	Отборы.Вставить("Пополнение", Перечисления.СпособыПополненияЗапасов.ПустаяСсылка());
	Отборы.Вставить("Наличие", 0);
	Отборы.Вставить("Склад", Справочники.МестаХранения.ПустаяСсылка());
	Отборы.Вставить("ТоварнаяГруппа", Справочники.ТоварныеГруппы.ПустаяСсылка());
	Отборы.Вставить("Бренд", Справочники.Бренды.ПустаяСсылка());
	Отборы.Вставить("ОсновнойПоставщик", Справочники.Контрагенты.ПустаяСсылка());
	Отборы.Вставить("Качество", Справочники.КачествоТоваров.ПустаяСсылка());
	Отборы.Вставить("ПоказыватьПомеченные", Ложь);
	Отборы.Вставить("Свойство", ПланыВидовХарактеристик.ДополнительныеРеквизиты.ПустаяСсылка());
	Отборы.Вставить("ЗначениеСвойства", Неопределено);
	Возврат Отборы;

КонецФункции

// Значения параметров запроса списка товаров (ТекстЗапросаСписка) по контексту открытия и фильтрам панели.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекстСписка
//  ОтборыПанели - Структура - см. НовыеОтборыПанели
//  Режим        - Строка - режим иерархии, см. РежимыИерархии; свойство режима даёт поле ЗначениеИерархии
//
// Возвращаемое значение:
//  Структура - имя параметра -> значение
//
Функция ПараметрыЗапросаСписка(Контекст, ОтборыПанели, Режим = "") Экспорт

	ИспользуетсяПроизводство = ПолучитьФункциональнуюОпцию("Производство");
	Параметры = Новый Структура;

	СпособыПополнения = Новый Массив;
	СпособыПополнения.Добавить(Перечисления.СпособыПополненияЗапасов.Закупка);
	СпособыПополнения.Добавить(Перечисления.СпособыПополненияЗапасов.Оба);
	Параметры.Вставить("СпособыПополненияУстановлены", Контекст.ТолькоЗакупаемые И ИспользуетсяПроизводство);
	Параметры.Вставить("СпособыПополнения", СпособыПополнения);

	ИсключаемыеТипы = Новый Массив;
	Если Контекст.ТолькоПродаваемые И ИспользуетсяПроизводство Тогда
		ИсключаемыеТипы.Добавить(Перечисления.ТипыНоменклатуры.Сырье);
		ИсключаемыеТипы.Добавить(Перечисления.ТипыНоменклатуры.Полуфабрикат);
	КонецЕсли;
	Если Контекст.ТолькоТовары Тогда
		ИсключаемыеТипы.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
		ИсключаемыеТипы.Добавить(Перечисления.ТипыНоменклатуры.Комплект);
	КонецЕсли;
	Разрешенные = Новый Массив;
	Если ЗначениеЗаполнено(Контекст.ОтборТипа) Тогда
		Разрешенные.Добавить(Контекст.ОтборТипа);
	КонецЕсли;
	Если Контекст.Свойство("Типы") Тогда
		Для Каждого Тип Из Контекст.Типы Цикл
			Разрешенные.Добавить(Тип);
		КонецЦикла;
	КонецЕсли;
	Если Разрешенные.Количество() > 0 Тогда
		// Товар без типа в ограниченный состав не входит (прежний отбор «тип В (разрешённые)» его не пропускал).
		ИсключаемыеТипы.Добавить(Перечисления.ТипыНоменклатуры.ПустаяСсылка());
		Для Каждого Тип Из Перечисления.ТипыНоменклатуры Цикл
			Если Разрешенные.Найти(Тип) = Неопределено И ИсключаемыеТипы.Найти(Тип) = Неопределено Тогда
				ИсключаемыеТипы.Добавить(Тип);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Параметры.Вставить("ИсключаемыеТипыУстановлены", ИсключаемыеТипы.Количество() > 0);
	Параметры.Вставить("ИсключаемыеТипы", ИсключаемыеТипы);

	Параметры.Вставить("СкладУстановлен", ЗначениеЗаполнено(ОтборыПанели.Склад));
	Параметры.Вставить("МестоХранения", ОтборыПанели.Склад);
	Параметры.Вставить("СвойствоИерархии", СвойствоРежимаИерархии(Режим));
	// Отбор «свойство = значение» панели - независимо от свойства навигатора (ревью плана Codex, P1).
	Параметры.Вставить("ОтборПоСвойству", ЕстьОтборПоСвойству(ОтборыПанели));
	Параметры.Вставить("СвойствоОтбора", ОтборыПанели.Свойство);
	Параметры.Вставить("ЗначениеОтбора", ОтборыПанели.ЗначениеСвойства);
	Возврат Параметры;

КонецФункции

// Ставит фильтры панели в группу «Панель» отбора (ОтборыСписков): только её элементы, группа иерархии не трогается.
//
// Параметры:
//  Отбор        - ОтборКомпоновкиДанных - отбор динамического списка или настроек компоновки
//  ОтборыПанели - Структура - см. НовыеОтборыПанели
//
// Возвращаемое значение:
//  Булево - есть отбор по реквизитам товара: список показывается плоским, папки скрыты
//
Функция УстановитьОтборыПанели(Отбор, ОтборыПанели) Экспорт

	Группа = ОтборыСписков.ГруппаПанель();
	ОтборыСписков.ОчиститьГруппу(Отбор, Группа);
	ЕстьОтбор = Ложь;
	// Фильтр панели -> поле запроса.
	Поля = Новый Структура;
	Поля.Вставить("Тип", "ТипНоменклатуры");
	Поля.Вставить("Пополнение", "СпособПополнения");
	Для Каждого Имя Из СтрРазделить("ТоварнаяГруппа,Бренд,ОсновнойПоставщик,Качество", ",") Цикл
		Поля.Вставить(Имя, Имя);
	КонецЦикла;
	Для Каждого Поле Из Поля Цикл
		Значение = ОтборыПанели[Поле.Ключ];
		Если ЗначениеЗаполнено(Значение) Тогда
			ОтборыСписков.УстановитьОтбор(Отбор, Группа, Поле.Значение, Значение);
			ЕстьОтбор = Истина;
		КонецЕсли;
	КонецЦикла;

	// Позиции тумблера «Наличие» (см. НовыеОтборыПанели): поле запроса и значение; 0 - все, отбора нет.
	// BSLLS:MagicNumber-off
	Ключи = "Поле, Значение";
	Наличие = Новый Соответствие;
	Наличие.Вставить(1, Новый Структура(Ключи, "ВНаличии", Истина));
	Наличие.Вставить(2, Новый Структура(Ключи, "ВНаличии", Ложь));
	Наличие.Вставить(3, Новый Структура(Ключи, "НижеМинимума", Истина));
	// BSLLS:MagicNumber-on
	ОтборНаличия = Наличие.Получить(ОтборыПанели.Наличие);
	Если ОтборНаличия <> Неопределено Тогда
		ОтборыСписков.УстановитьОтбор(Отбор, Группа, ОтборНаличия.Поле, ОтборНаличия.Значение);
		ЕстьОтбор = Истина;
	КонецЕсли;

	// Отбор «свойство = значение» - условие запроса, а не элемент отбора, но папки он тоже отсекает.
	ЕстьОтбор = ЕстьОтбор Или ЕстьОтборПоСвойству(ОтборыПанели);
	Если ЕстьОтбор Тогда
		ОтборыСписков.УстановитьОтбор(Отбор, Группа, "ЭтоГруппа", Ложь);
	КонецЕсли;
	Если Не ОтборыПанели.ПоказыватьПомеченные Тогда
		ОтборыСписков.УстановитьОтбор(Отбор, Группа, "ПометкаУдаления", Ложь);
	КонецЕсли;
	Возврат ЕстьОтбор;

КонецФункции

// Режимы иерархии списка товаров (решение владельца 1: один уровень): папки, классификаторы и дополнительные
// свойства номенклатуры. Способ пополнения - при включённом производстве.
//
// Возвращаемое значение:
//  СписокЗначений - значение - имя режима («Папки», «ТипНоменклатуры», ..., «Свойство:<уникальный идентификатор>»),
//                   представление - название для поля выбора режима
//
Функция РежимыИерархии() Экспорт

	Режимы = Новый СписокЗначений;
	Режимы.Добавить(РежимПапки(), НСтр("ru = 'Папки'; fr = 'Dossiers'; en = 'Folders'; es = 'Carpetas'"));
	Режимы.Добавить("ТипНоменклатуры", НСтр("ru = 'Тип'; fr = 'Type'; en = 'Type'; es = 'Tipo'"));
	Режимы.Добавить("ТоварнаяГруппа", НСтр("ru = 'Товарная группа'; fr = 'Groupe de marchandises'; en = 'Product group';
		|es = 'Grupo de mercancías'"));
	Режимы.Добавить("Бренд", НСтр("ru = 'Бренд'; fr = 'Marque'; en = 'Brand'; es = 'Marca'"));
	Режимы.Добавить("ОсновнойПоставщик", НСтр("ru = 'Основной поставщик'; fr = 'Fournisseur principal';
		|en = 'Main supplier'; es = 'Proveedor principal'"));
	Режимы.Добавить("Качество", НСтр("ru = 'Качество'; fr = 'Qualité'; en = 'Quality'; es = 'Calidad'"));
	Если ПолучитьФункциональнуюОпцию("Производство") Тогда
		Режимы.Добавить("СпособПополнения", НСтр("ru = 'Способ пополнения'; fr = 'Mode de réapprovisionnement';
			|en = 'Replenishment method'; es = 'Forma de reposición'"));
	КонецЕсли;
	Шаблон = НСтр("ru = 'Свойство: %1'; fr = 'Propriété : %1'; en = 'Property: %1'; es = 'Propiedad: %1'");
	Для Каждого Свойство Из СвойстваДляИерархии() Цикл
		Режимы.Добавить(ПрефиксРежимаСвойства() + Строка(Свойство.Свойство.УникальныйИдентификатор()),
			СтрШаблон(Шаблон, Свойство.Заголовок));
	КонецЦикла;
	Возврат Режимы;

КонецФункции

// Возвращаемое значение:
//  Строка - режим «Папки»: дерева нет, навигация по папкам самой таблицы
//
Функция РежимПапки() Экспорт

	Возврат "Папки";

КонецФункции

// Поле запроса списка, по которому режим строит узлы и отбор.
//
// Параметры:
//  Режим - Строка - см. РежимыИерархии
//
// Возвращаемое значение:
//  Строка - имя поля ТекстЗапросаСписка; пустая - режим «Папки»
//
Функция ПолеРежимаИерархии(Режим) Экспорт

	Если Режим = РежимПапки() Или Не ЗначениеЗаполнено(Режим) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрНачинаетсяС(Режим, ПрефиксРежимаСвойства()) Тогда
		Возврат "ЗначениеИерархии";
	КонецЕсли;
	Возврат Режим;

КонецФункции

// Параметры:
//  Режим - Строка - см. РежимыИерархии
//
// Возвращаемое значение:
//  ПланВидовХарактеристикСсылка.ДополнительныеРеквизиты - свойство режима «по свойству»; пустая ссылка - иначе
//
Функция СвойствоРежимаИерархии(Режим) Экспорт

	Если Не СтрНачинаетсяС(Режим, ПрефиксРежимаСвойства()) Тогда
		Возврат ПланыВидовХарактеристик.ДополнительныеРеквизиты.ПустаяСсылка();
	КонецЕсли;
	Идентификатор = Сред(Режим, СтрДлина(ПрефиксРежимаСвойства()) + 1);
	Попытка
		Ссылка = ПланыВидовХарактеристик.ДополнительныеРеквизиты.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	Исключение
		// Режим из сохранённых настроек с испорченным идентификатором - как пустое свойство.
		Возврат ПланыВидовХарактеристик.ДополнительныеРеквизиты.ПустаяСсылка();
	КонецПопытки;
	Возврат Ссылка;

КонецФункции

// Ставит отбор узла навигатора в группу «Иерархия» отбора (ОтборыСписков): только её элементы, группа панели не
// трогается. Вне режима «Папки» папки скрыты - список плоский. «<не задано>» - явное «не заполнено» (пустая ссылка,
// для свойства - нет строки свойства или пустое значение), а не снятие отбора.
//
// Параметры:
//  Отбор    - ОтборКомпоновкиДанных - отбор динамического списка или настроек компоновки
//  Режим    - Строка - см. РежимыИерархии
//  ВидУзла  - Число - 0 - «Все», 1 - значение, 2 - «<не задано>»
//  Значение - Произвольный - значение узла вида 1
//
Процедура УстановитьОтборИерархии(Отбор, Режим, ВидУзла, Значение) Экспорт

	Группа = ОтборыСписков.ГруппаИерархия();
	ОтборыСписков.ОчиститьГруппу(Отбор, Группа);
	Поле = ПолеРежимаИерархии(Режим);
	Если Поле = "" Тогда
		Возврат;
	КонецЕсли;
	ОтборыСписков.УстановитьОтбор(Отбор, Группа, "ЭтоГруппа", Ложь);
	Если ВидУзла = ВидУзлаЗначение() Тогда
		ОтборыСписков.УстановитьОтбор(Отбор, Группа, Поле, Значение);
	ИначеЕсли ВидУзла = ВидУзлаНеЗадано() Тогда
		ОтборыСписков.УстановитьОтборНеЗаполнено(Отбор, Группа, Поле);
	Иначе
		// «Все» - без отбора по полю режима.
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Возвращаемое значение:
//  Число - вид узла навигатора «значение поля»
//
Функция ВидУзлаЗначение() Экспорт

	Возврат 1;

КонецФункции

// Возвращаемое значение:
//  Число - вид узла навигатора «<не задано>»
//
Функция ВидУзлаНеЗадано() Экспорт

	// BSLLS:MagicNumber-off
	Возврат 2;
	// BSLLS:MagicNumber-on

КонецФункции

// Узлы навигатора иерархии со счётчиками товаров: «Все» первым, значения поля режима по представлению, «<не задано>»
// последним (если такие товары есть). Счётчики учитывают контекст открытия и фильтры панели: список компонуется схемой с
// тем же запросом и той же группой отбора «Панель», что у динамического списка (ревью плана Codex, P2).
//
// Параметры:
//  Режим        - Строка - см. РежимыИерархии
//  Контекст     - Структура - см. НовыйКонтекстСписка
//  ОтборыПанели - Структура - см. НовыеОтборыПанели
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Значение, Представление, Количество, Вид (0 - все, 1 - значение, 2 - не задано);
//                    пустая - режим «Папки»
//
Функция УзлыИерархии(Режим, Контекст, ОтборыПанели) Экспорт

	Узлы = Новый ТаблицаЗначений;
	Узлы.Колонки.Добавить("Значение");
	Узлы.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТипЧисло = Новый ОписаниеТипов("Число");
	ИмяКоличества = "Количество";
	Узлы.Колонки.Добавить(ИмяКоличества, ТипЧисло);
	Узлы.Колонки.Добавить("Вид", ТипЧисло);
	Поле = ПолеРежимаИерархии(Режим);
	Если Поле = "" Тогда
		Возврат Узлы;
	КонецЕсли;

	Строки = КомпоноватьСписок(Режим, Контекст, ОтборыПанели, 0, Неопределено);
	Все = Узлы.Добавить();
	Все.Представление = НСтр("ru = 'Все товары'; fr = 'Tous les articles'; en = 'All items'; es = 'Todos los artículos'");
	Все.Количество = Строки.Количество();
	Все.Вид = 0;

	Строки.Колонки.Добавить(ИмяКоличества, ТипЧисло);
	Строки.ЗаполнитьЗначения(1, ИмяКоличества);
	Строки.Свернуть(Поле, ИмяКоличества);
	НеЗадано = 0;
	Значения = Узлы.СкопироватьКолонки();
	Для Каждого Строка Из Строки Цикл
		Значение = Строка[Поле];
		Если ЗначениеЗаполнено(Значение) Тогда
			Узел = Значения.Добавить();
			Узел.Значение = Значение;
			Узел.Представление = Строка(Значение);
			Узел.Количество = Строка.Количество;
			Узел.Вид = ВидУзлаЗначение();
		Иначе
			НеЗадано = НеЗадано + Строка.Количество;
		КонецЕсли;
	КонецЦикла;
	Значения.Сортировать("Представление");
	Для Каждого Узел Из Значения Цикл
		ЗаполнитьЗначенияСвойств(Узлы.Добавить(), Узел);
	КонецЦикла;
	Если НеЗадано > 0 Тогда
		Узел = Узлы.Добавить();
		Узел.Представление = НСтр("ru = '<не задано>'; fr = '<non renseigné>'; en = '<not set>'; es = '<sin definir>'");
		Узел.Количество = НеЗадано;
		Узел.Вид = ВидУзлаНеЗадано();
	КонецЕсли;
	Возврат Узлы;

КонецФункции

// Строки списка товаров, как их отбирает динамический список: схема компоновки с набором-запросом ТекстЗапросаСписка,
// параметрами ПараметрыЗапросаСписка и группами отбора «Панель» и «Иерархия» (тот же ОтборКомпоновкиДанных, что у
// динсписка; программные отборы обычный запрос не применяет - ревью плана Codex, P2). Папки в результат не входят.
//
// Параметры:
//  Режим        - Строка - см. РежимыИерархии
//  Контекст     - Структура - см. НовыйКонтекстСписка
//  ОтборыПанели - Структура - см. НовыеОтборыПанели
//  ВидУзла      - Число - см. УстановитьОтборИерархии
//  Значение     - Произвольный - значение узла
//  Настройки    - НастройкиКомпоновкиДанных, Неопределено - выход: настройки, по которым скомпоновано
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Ссылка и поле режима (если не «Папки»)
//
Функция КомпоноватьСписок(Режим, Контекст, ОтборыПанели, ВидУзла, Значение, Настройки = Неопределено) Экспорт

	Схема = Новый СхемаКомпоновкиДанных;
	Источник = Схема.ИсточникиДанных.Добавить();
	Источник.Имя = "ИсточникДанных";
	Источник.ТипИсточникаДанных = "Local";
	Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	Набор.Имя = "Список";
	Набор.ИсточникДанных = Источник.Имя;
	ДляВыбора = Контекст.Свойство("ДляВыбора") И Контекст.ДляВыбора;
	Набор.Запрос = ?(ДляВыбора, ТекстЗапросаВыбора(), ТекстЗапросаСписка());
	Набор.АвтоЗаполнениеДоступныхПолей = Истина;
	ПараметрыЗапроса = ПараметрыЗапросаСписка(Контекст, ОтборыПанели, Режим);
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		ПараметрСхемы = Схема.Параметры.Добавить();
		ПараметрСхемы.Имя = Параметр.Ключ;
		ПараметрСхемы.ВключатьВДоступныеПоля = Ложь;
		Если ТипЗнч(Параметр.Значение) = Тип("Массив") Тогда
			ПараметрСхемы.ДоступенСписокЗначений = Истина;
			Список = Новый СписокЗначений;
			Список.ЗагрузитьЗначения(Параметр.Значение);
			ПараметрСхемы.Значение = Список;
		Иначе
			ПараметрСхемы.Значение = Параметр.Значение;
		КонецЕсли;
	КонецЦикла;

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Настройки = Компоновщик.Настройки;
	// Значение параметра схемы - только умолчание: в настройках параметр без использования не передаётся в запрос.
	Для Каждого Параметр Из Схема.Параметры Цикл
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(Параметр.Имя, Параметр.Значение);
	КонецЦикла;
	Поля = Новый Массив;
	Поля.Добавить("Ссылка");
	Поле = ПолеРежимаИерархии(Режим);
	Если Поле <> "" Тогда
		Поля.Добавить(Поле);
	КонецЕсли;
	Для Каждого Имя Из Поля Цикл
		Выбранное = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Выбранное.Поле = Новый ПолеКомпоновкиДанных(Имя);
		Выбранное.Использование = Истина;
	КонецЦикла;
	Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Группировка.Использование = Истина;

	УстановитьОтборыПанели(Настройки.Отбор, ОтборыПанели);
	УстановитьОтборИерархии(Настройки.Отбор, Режим, ВидУзла, Значение);
	ОтборыСписков.УстановитьОтбор(Настройки.Отбор, ОтборыСписков.ГруппаПанель(), "ЭтоГруппа", Ложь);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);
	Возврат Результат;

КонецФункции

// Живые показатели шапки карточки: остаток всех складов, свободно (без закреплённого на станках), розничная и - не
// кассиру - закупочная цена; ниже минимума - остаток меньше минимального количества карточки.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар; пустая - новый, показателей нет
//
// Возвращаемое значение:
//  Структура:
//   * Текст        - Строка - строка показателей для шапки
//   * НижеМинимума - Булево - остаток ниже минимального
//
Функция ПоказателиКарточки(Номенклатура) Экспорт

	Показатели = Новый Структура("Текст, НижеМинимума", "", Ложь);
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Показатели;
	КонецЕсли;
	Остатки = Новый ТаблицаЗначений;
	Остатки.Колонки.Добавить("Склад");
	Остатки.Колонки.Добавить("Остаток");
	Остатки.Колонки.Добавить("Свободно");
	ЗаполнитьОстаткиДляПанели(Номенклатура, Остатки);
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура,
		"Единица, ОсновнойПоставщик, МинимальноеКоличествоХранения");
	Остаток = Остатки.Итог("Остаток");
	Свободно = Остатки.Итог("Свободно");
	ФорматЧисла = "ЧДЦ=3; ЧН=0";
	Строки = Новый Массив;
	Шаблон = НСтр("ru = 'Остаток %1 %2 · Свободно %3'; fr = 'Stock %1 %2 · Libre %3'; en = 'Stock %1 %2 · Free %3';
		|es = 'Existencias %1 %2 · Libre %3'");
	Строки.Добавить(СтрШаблон(Шаблон, Формат(Остаток, ФорматЧисла), Реквизиты.Единица, Формат(Свободно, ФорматЧисла)));
	Цены = ЦеныДляПанели(Номенклатура, Реквизиты.ОсновнойПоставщик);
	Если Цены.Розничная <> 0 Тогда
		Подпись = НСтр("ru = 'Цена'; fr = 'Prix'; en = 'Price'; es = 'Precio'");
		Строки.Добавить(Подпись + " " + Формат(Цены.Розничная, "ЧДЦ=2"));
	КонецЕсли;
	Если Цены.Закупочная <> 0 И Не ЭтоКассир() Тогда
		Подпись = НСтр("ru = 'Закуп.'; fr = 'Achat'; en = 'Purchase'; es = 'Compra'");
		Строки.Добавить(Подпись + " " + Формат(Цены.Закупочная, "ЧДЦ=2"));
	КонецЕсли;
	Показатели.Текст = СтрСоединить(Строки, " · ");
	Показатели.НижеМинимума = Реквизиты.МинимальноеКоличествоХранения > 0 И Остаток < Реквизиты.МинимальноеКоличествоХранения;
	Возврат Показатели;

КонецФункции

// Данные блоков карточки товара по закладке (этап 4 плана nomenclature-ui): загружаются при первом переходе на
// закладку. Блок, на регистр или справочник которого у роли нет права чтения, возвращается пустым и с признаком
// «недоступен» - форма его скрывает, а не падает (риск плана: кладовщик, кассир, продавец).
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар
//  Закладка     - Строка - «Склад», «Производство» или «Служебное»
//
// Возвращаемое значение:
//  Структура - таблицы блоков закладки и Доступные - Массив из Строка, имена доступных блоков:
//   «Склад»        - Остатки (Склад, Остаток, Свободно), НаСтанках (Станок, Требование, Количество), ДвижениеТекст;
//   «Производство» - ГдеИспользуется (Продукция, Количество), ВыработкаСтанков (Станок, Выработка, ПоТовару);
//   «Служебное»    - Штрихкоды (Штрихкод, Характеристика, Упаковка, Серия)
//
Функция ДанныеКарточки(Номенклатура, Закладка) Экспорт

	Данные = Новый Структура("Доступные", Новый Массив);
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Данные;
	КонецЕсли;
	ПравоЧтения = "Чтение";
	Если Закладка = "Склад" Тогда
		Остатки = Новый ТаблицаЗначений;
		Остатки.Колонки.Добавить("Склад");
		Остатки.Колонки.Добавить("Остаток");
		Остатки.Колонки.Добавить("Свободно");
		Если ПравоДоступа(ПравоЧтения, Метаданные.РегистрыНакопления.ТоварыВНаличии) Тогда
			ЗаполнитьОстаткиДляПанели(Номенклатура, Остатки);
			Данные.Доступные.Добавить("Остатки");
		КонецЕсли;
		Данные.Вставить("Остатки", Остатки);
		Данные.Вставить("НаСтанках", МатериалыНаСтанкахТовара(Номенклатура, Данные.Доступные));
		Данные.Вставить("ДвижениеТекст", ТекстДвиженияДляПанели(Номенклатура));
		Данные.Доступные.Добавить("ДвижениеТекст");
	ИначеЕсли Закладка = "Производство" Тогда
		Данные.Вставить("ГдеИспользуется", ГдеИспользуетсяТовар(Номенклатура, Данные.Доступные));
		Данные.Вставить("ВыработкаСтанков", ВыработкаСтанковТовара(Номенклатура, Данные.Доступные));
	ИначеЕсли Закладка = "Служебное" Тогда
		Данные.Вставить("Штрихкоды", ШтрихкодыТовара(Номенклатура, Данные.Доступные));
	Иначе
		ВызватьИсключение "ДанныеКарточки: неизвестная закладка " + Закладка;
	КонецЕсли;
	Возврат Данные;

КонецФункции

// Сведения о товаре для панели списка: закладка «Товар» - текст карточки, «Движение» - остатки по складам со
// свободным количеством и текст о заказах, потребности и продажах. Блок, на регистр которого у роли нет права
// чтения, не выводится (не ошибка).
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - текущая строка списка
//
// Возвращаемое значение:
//  Структура:
//   * ТоварТекст   - Строка - реквизиты товара
//   * Остатки      - ТаблицаЗначений - колонки Склад, Остаток, Свободно
//   * ДвижениеТекст - Строка - заказано поставщикам, потребность производства, продано за 12 месяцев
//
Функция СведенияДляПанели(Номенклатура) Экспорт

	Сведения = Новый Структура;
	Сведения.Вставить("ТоварТекст", "");
	Сведения.Вставить("Остатки", Новый ТаблицаЗначений);
	Сведения.Вставить("ДвижениеТекст", "");
	Сведения.Остатки.Колонки.Добавить("Склад");
	Сведения.Остатки.Колонки.Добавить("Остаток");
	Сведения.Остатки.Колонки.Добавить("Свободно");
	Если Не ЗначениеЗаполнено(Номенклатура) Или Номенклатура.ЭтоГруппа Тогда
		Возврат Сведения;
	КонецЕсли;
	Сведения.ТоварТекст = ТекстТовараДляПанели(Номенклатура);
	ЗаполнитьОстаткиДляПанели(Номенклатура, Сведения.Остатки);
	Сведения.ДвижениеТекст = ТекстДвиженияДляПанели(Номенклатура);
	Возврат Сведения;

КонецФункции

#КонецОбласти

#Область Прочее

// Проверяет, попадал ли комплект в движения товаров в наличии (есть проведённые документы
// со списанием комплекта). Используется для блокировки изменения состава комплекта.
//
// Параметры:
//  Комплект - СправочникСсылка.Номенклатура - проверяемый комплект.
//
// Возвращаемое значение:
//  Булево - Истина, если комплект уже использован в проведённых документах.
//
Функция КомплектИспользованВДокументах(Комплект) Экспорт
	Если Не ЗначениеЗаполнено(Комплект) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьДвижение
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК ТоварыВНаличии
	|ГДЕ
	|	ТоварыВНаличии.Комплект = &Комплект";
	Запрос.УстановитьПараметр("Комплект", Комплект);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Функция ПолучитьСрокХранения(Товар, Знач Контрагент) Экспорт
	СрокХранения = "";
	Если Товар.ТЧСтикеры.Количество() > 0 Тогда
		Пока 1 = 1 Цикл
			Если Не ЗначениеЗаполнено(Контрагент) Тогда Прервать КонецЕсли;
			Стр = Товар.ТЧСтикеры.Найти(Контрагент, "Контрагент");
			Если Стр = Неопределено Тогда
				Контрагент = Контрагент.Родитель;		
			Иначе	
				СрокХранения = Стр.СрокХранения;
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(СрокХранения), СрокХранения, Товар.СрокХранения);
КонецФункции	

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	// Карточка номенклатуры одна для всех ролей (решение владельца 2026-09-10):
	// подстановки ECommerce-форм по роли больше нет, мобильный клиент - не роль,
	// его ветка сохраняется.
	Если ВидФормы = "ФормаСписка" Тогда
		Если ПараметрыСеанса.ПараметрыКлиентаНаСервере.ЭтоМобильныйКлиент Тогда
			ВыбраннаяФорма = "ФормаВыбораМобильныйКлиент";
		Иначе
			ВыбраннаяФорма = "ФормаДокумента";	
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

// Значение свойства товара - строка табличной части с наибольшим номером по свойству или запись регистра сведений
// (одна семантика с карточкой, УправлениеСвойствами.УстановитьЗначениеСвойстваВОбъекте). Без права чтения регистра
// сведений его часть подзапроса убирается - иначе запрос списка упал бы при открытии.
//
// Параметры:
//  Текст - Строка - текст ТекстЗапросаСписка с обоими подзапросами свойств
//
// Возвращаемое значение:
//  Строка - текст без регистра ДополнительныеСведения
//
Функция БезДополнительныхСведений(Знач Текст)

	Для Каждого Параметр Из СтрРазделить("СвойствоИерархии,СвойствоОтбора", ",") Цикл
		Позиция = СтрНайти(Текст, "Сведения.Свойство = &" + Параметр + ")");
		Начало = СтрНайти(Текст, "ОБЪЕДИНИТЬ ВСЕ", НаправлениеПоиска.СКонца, Позиция);
		Если Позиция = 0 Или Начало = 0 Тогда
			ВызватьИсключение "ТекстЗапросаСписка: не найден подзапрос сведений свойства " + Параметр;
		КонецЕсли;
		Конец = Позиция + СтрДлина("Сведения.Свойство = &" + Параметр);
		Текст = Лев(Текст, Начало - 1) + Сред(Текст, Конец);
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Отбор «свойство = значение» задан: свойство выбрано и значение введено. Ноль и Ложь - значения (ревью кода Codex,
// 2.0.16.61); не введено - Неопределено или пустая строка.
//
// Параметры:
//  ОтборыПанели - Структура - см. НовыеОтборыПанели
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьОтборПоСвойству(ОтборыПанели)

	Значение = ОтборыПанели.ЗначениеСвойства;
	Возврат ЗначениеЗаполнено(ОтборыПанели.Свойство) И Значение <> Неопределено И Значение <> Null И Значение <> "";

КонецФункции

// Материалы товара, закреплённые за требованиями на станках («Материалы на станках», 2.0.16.33).
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар
//  Доступные    - Массив из Строка - дополняется именем блока при праве чтения
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Требование, Количество
//
Функция МатериалыНаСтанкахТовара(Номенклатура, Доступные)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Станок");
	Таблица.Колонки.Добавить("Требование");
	Таблица.Колонки.Добавить("Количество");
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.МатериалыНаСтанках) Тогда
		Возврат Таблица;
	КонецЕсли;
	Доступные.Добавить("НаСтанках");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Закреплено.Станок КАК Станок,
	|	Закреплено.Требование КАК Требование,
	|	Закреплено.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.МатериалыНаСтанках.Остатки(, Номенклатура = &Номенклатура) КАК Закреплено
	|ГДЕ
	|	Закреплено.КоличествоОстаток <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Станок");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Продукция, в действующие техкарты которой входит товар: последняя версия карты каждой продукции на сегодня.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - материал
//  Доступные    - Массив из Строка - дополняется именем блока при праве чтения
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Продукция, Количество (расход на единицу продукции)
//
Функция ГдеИспользуетсяТовар(Номенклатура, Доступные)

	Если Не ПолучитьФункциональнуюОпцию("Производство")
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.СоставТехКарты) Тогда
		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("Продукция");
		Таблица.Колонки.Добавить("Количество");
		Возврат Таблица;
	КонецЕсли;
	Доступные.Добавить("ГдеИспользуется");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Версии.Продукция КАК Продукция,
	|	МАКСИМУМ(Версии.Период) КАК Период
	|ПОМЕСТИТЬ ВТВерсии
	|ИЗ
	|	РегистрСведений.СоставТехКарты КАК Версии
	|ГДЕ
	|	Версии.Период <= &Дата
	|	И Версии.Продукция В
	|			(ВЫБРАТЬ
	|				Материалы.Продукция КАК Продукция
	|			ИЗ
	|				РегистрСведений.СоставТехКарты КАК Материалы
	|			ГДЕ
	|				Материалы.Материал = &Номенклатура)
	|
	|СГРУППИРОВАТЬ ПО
	|	Версии.Продукция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Состав.Продукция КАК Продукция,
	|	СУММА(Состав.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.СоставТехКарты КАК Состав
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВерсии КАК ВТВерсии
	|		ПО Состав.Продукция = ВТВерсии.Продукция
	|			И Состав.Период = ВТВерсии.Период
	|ГДЕ
	|	Состав.Материал = &Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	Состав.Продукция
	|
	|УПОРЯДОЧИТЬ ПО
	|	Продукция");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Дата", КонецДня(ТекущаяДатаСеанса()));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Выработка станков по товару: норма из карточки станка (ВыработкаПоНоменклатуре), а для допустимых станков товара без
// нормы - общая выработка станка (как считает планировщик, 2.0.16.46).
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар
//  Доступные    - Массив из Строка - дополняется именем блока при праве чтения
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Станок, Выработка (кг/ч), ПоТовару (Булево - норма товара, а не общая)
//
Функция ВыработкаСтанковТовара(Номенклатура, Доступные)

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтанков")
		Или Не ПравоДоступа("Чтение", Метаданные.Справочники.ПроизводственноеОборудование) Тогда
		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("Станок");
		Таблица.Колонки.Добавить("Выработка");
		Таблица.Колонки.Добавить("ПоТовару");
		Возврат Таблица;
	КонецЕсли;
	Доступные.Добавить("ВыработкаСтанков");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Нормы.Ссылка КАК Станок,
	|	Нормы.Выработка КАК Выработка,
	|	ИСТИНА КАК ПоТовару
	|ИЗ
	|	Справочник.ПроизводственноеОборудование.ВыработкаПоНоменклатуре КАК Нормы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПроизводственноеОборудование КАК Оборудование
	|		ПО Нормы.Ссылка = Оборудование.Ссылка
	|ГДЕ
	|	Нормы.Номенклатура = &Номенклатура
	|	И НЕ Оборудование.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Допустимые.Станок,
	|	Оборудование.Выработка,
	|	ЛОЖЬ
	|ИЗ
	|	Справочник.Номенклатура.Станки КАК Допустимые
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПроизводственноеОборудование КАК Оборудование
	|		ПО Допустимые.Станок = Оборудование.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПроизводственноеОборудование.ВыработкаПоНоменклатуре КАК Нормы
	|		ПО Допустимые.Станок = Нормы.Ссылка
	|			И (Нормы.Номенклатура = &Номенклатура)
	|ГДЕ
	|	Допустимые.Ссылка = &Номенклатура
	|	И Нормы.Ссылка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Станок");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Штрихкоды товара списком (сейчас только команда навигации).
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар
//  Доступные    - Массив из Строка - дополняется именем блока при праве чтения
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Штрихкод, Характеристика, Упаковка, Серия
//
Функция ШтрихкодыТовара(Номенклатура, Доступные)

	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ШтрихкодыНоменклатуры) Тогда
		Таблица = Новый ТаблицаЗначений;
		Для Каждого Имя Из СтрРазделить("Штрихкод,Характеристика,Упаковка,Серия", ",") Цикл
