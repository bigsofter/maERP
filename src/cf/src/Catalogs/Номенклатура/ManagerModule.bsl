// Текст закладки «Товар» панели списка: строки «реквизит: значение», пустые реквизиты пропускаются.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар
//
// Возвращаемое значение:
//  Строка - текст
//
Функция ТекстТовараДляПанели(Номенклатура)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Наименование, Артикул, ТипНоменклатуры, "
		+ "Единица, КодПоставщика, КодПроизводителя, ОсновнойПоставщик, Бренд, Качество, ТоварнаяГруппа, СтавкаНДС, "
		+ "ЯчейкиСтрокой, Родитель, КодСтарый");
	Строки = Новый Массив;
	Строки.Добавить(Реквизиты.Наименование);
	Подписи = Новый Структура;
	Подписи.Вставить("Артикул", НСтр("ru = 'Артикул'; fr = 'Référence'; en = 'Article'; es = 'Referencia'"));
	Подписи.Вставить("ТипНоменклатуры", НСтр("ru = 'Тип'; fr = 'Type'; en = 'Type'; es = 'Tipo'"));
	Подписи.Вставить("Единица", НСтр("ru = 'Ед.'; fr = 'Unité'; en = 'Unit'; es = 'Unidad'"));
	Подписи.Вставить("КодПоставщика", НСтр("ru = 'Код поставщика'; fr = 'Code fournisseur'; en = 'Supplier code';
		|es = 'Código del proveedor'"));
	Подписи.Вставить("КодПроизводителя", НСтр("ru = 'Код производителя'; fr = 'Code fabricant'; en = 'Manufacturer code';
		|es = 'Código del fabricante'"));
	Подписи.Вставить("ОсновнойПоставщик", НСтр("ru = 'Основной поставщик'; fr = 'Fournisseur principal'; en = 'Main supplier';
		|es = 'Proveedor principal'"));
	Подписи.Вставить("Бренд", НСтр("ru = 'Бренд'; fr = 'Marque'; en = 'Brand'; es = 'Marca'"));
	Подписи.Вставить("Качество", НСтр("ru = 'Качество'; fr = 'Qualité'; en = 'Quality'; es = 'Calidad'"));
	Подписи.Вставить("ТоварнаяГруппа", НСтр("ru = 'Товарная группа'; fr = 'Groupe de marchandises'; en = 'Product group';
		|es = 'Grupo de mercancías'"));
	Подписи.Вставить("СтавкаНДС", НСтр("ru = 'Ставка НДС'; fr = 'Taux de TVA'; en = 'VAT rate'; es = 'Tipo de IVA'"));
	Подписи.Вставить("ЯчейкиСтрокой", НСтр("ru = 'Ячейки'; fr = 'Emplacements'; en = 'Bins'; es = 'Ubicaciones'"));
	Подписи.Вставить("Родитель", НСтр("ru = 'Папка'; fr = 'Dossier'; en = 'Folder'; es = 'Carpeta'"));
	Подписи.Вставить("КодСтарый", НСтр("ru = 'Старый код'; fr = 'Ancien code'; en = 'Old code'; es = 'Código antiguo'"));
	// Кассир (PDV) не видит сведений о закупке - как в таблице списка (ФормаСписка.НастроитьФорму).
	Кассир = ЭтоКассир();
	Скрытые = СтрРазделить("КодПоставщика,КодПроизводителя,ОсновнойПоставщик,КодСтарый", ",");
	Для Каждого Подпись Из Подписи Цикл
		Если Кассир И Скрытые.Найти(Подпись.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Значение = Реквизиты[Подпись.Ключ];
		Если ЗначениеЗаполнено(Значение) Тогда
			Строки.Добавить(Подпись.Значение + ": " + Значение);
		КонецЕсли;
	КонецЦикла;

	Цены = ЦеныДляПанели(Номенклатура, Реквизиты.ОсновнойПоставщик);
	// Закупочную цену кассир не видит и в карточке (группа цен скрыта для роли PDV): роль, а не право на объект.
	Если Цены.Закупочная <> 0 И Не Кассир Тогда
		Подпись = НСтр("ru = 'Закупочная цена'; fr = 'Prix d''achat'; en = 'Purchase price'; es = 'Precio de compra'");
		Строки.Добавить(Подпись + ": " + Формат(Цены.Закупочная, "ЧДЦ=2"));
	КонецЕсли;
	Если Цены.Розничная <> 0 Тогда
		Подпись = НСтр("ru = 'Розничная цена'; fr = 'Prix de détail'; en = 'Retail price'; es = 'Precio minorista'");
		Строки.Добавить(Подпись + ": " + Формат(Цены.Розничная, "ЧДЦ=2"));
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Кассир - роль PDV: скрываются сведения о закупке, читать которые роль вправе (не право на объект).
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоКассир()

	Возврат РольДоступна("PDV");

КонецФункции

// Параметры:
//  Номенклатура      - СправочникСсылка.Номенклатура - товар
//  ОсновнойПоставщик - СправочникСсылка.Контрагенты - поставщик закупочной цены
//
// Возвращаемое значение:
//  Структура - Закупочная, Розничная (Число, 0 - нет цены)
//
Функция ЦеныДляПанели(Номенклатура, ОсновнойПоставщик)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ЦеныПоставщика.ЦенаЕдиницыХранения), 0) КАК Закупочная
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатурыПоставщиков.СрезПоследних(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Контрагент = &Поставщик
	|				И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ЦеныПоставщика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ЦеныРозничные.Цена), 0) КАК Розничная
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			Номенклатура = &Номенклатура
	|				И ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Розничная)
	|				И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|				И ТоварнаяГруппа = ЗНАЧЕНИЕ(Справочник.ТоварныеГруппы.ПустаяСсылка)) КАК ЦеныРозничные");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Поставщик", ОсновнойПоставщик);
	Результаты = Запрос.ВыполнитьПакет();
	Цены = Новый Структура("Закупочная, Розничная", 0, 0);
	Выборка = Результаты[0].Выбрать();
	Если Выборка.Следующий() Тогда
		Цены.Закупочная = Выборка.Закупочная;
	КонецЕсли;
	Выборка = Результаты[1].Выбрать();
	Если Выборка.Следующий() Тогда
		Цены.Розничная = Выборка.Розничная;
	КонецЕсли;
	Возврат Цены;

КонецФункции

// Остатки товара по складам и свободное количество: на складе станка - без закреплённого за требованиями (как в
// рабочем месте закупок, 2.0.16.58). Без права чтения «Материалов на станках» свободно равно остатку.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар
//  Остатки      - ТаблицаЗначений - колонки Склад, Остаток, Свободно; заполняется
//
Процедура ЗаполнитьОстаткиДляПанели(Номенклатура, Остатки)

	ПравоЧтения = "Чтение";
	Если Не ПравоДоступа(ПравоЧтения, Метаданные.РегистрыНакопления.ТоварыВНаличии) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.МестоХранения КАК Склад,
	|	СУММА(Остатки.КоличествоОстаток) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(, Номенклатура = &Номенклатура) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.МестоХранения
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.КоличествоОстаток) <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.МестоХранения");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Остатки.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.Свободно = Выборка.Остаток;
	КонецЦикла;

	// Запрос к регистру без права чтения падает при выполнении, даже с ложным условием: без права - не строится.
	Если Остатки.Количество() = 0
		Или Не ПравоДоступа(ПравоЧтения, Метаданные.РегистрыНакопления.МатериалыНаСтанках)
		Или Не ПравоДоступа(ПравоЧтения, Метаданные.Справочники.ПроизводственноеОборудование) Тогда
		Возврат;
	КонецЕсли;
	// Остаток регистра станков по товару мал, соединение со справочником станков - по закреплённым строкам.
	// BSLLS:JoinWithVirtualTable-off
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Станки.СкладСтанка КАК Склад,
	|	СУММА(Закреплено.КоличествоОстаток) КАК Закреплено
	|ИЗ
	|	РегистрНакопления.МатериалыНаСтанках.Остатки(, Номенклатура = &Номенклатура) КАК Закреплено
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПроизводственноеОборудование КАК Станки
	|		ПО Закреплено.Станок = Станки.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Станки.СкладСтанка";
	// BSLLS:JoinWithVirtualTable-on
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Остатки.Найти(Выборка.Склад, "Склад");
		Если Строка <> Неопределено Тогда
			Строка.Свободно = Строка.Остаток - Выборка.Закреплено;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Текст закладки «Движение»: заказано поставщикам и не получено, потребность производства (нужно, заказано,
// пришло), продано за 12 месяцев. Блок без права чтения своего регистра пропускается.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар
//
// Возвращаемое значение:
//  Строка - текст
//
Функция ТекстДвиженияДляПанели(Номенклатура)

	ПравоЧтения = "Чтение";
	Строки = Новый Массив;
	ФорматЧисла = "ЧДЦ=3; ЧН=0";
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Если ПравоДоступа(ПравоЧтения, Метаданные.РегистрыНакопления.ЗаказыПоставщикам) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Заказы.КоличествоОстаток), 0) КАК Количество
		|ИЗ
		|	РегистрНакопления.ЗаказыПоставщикам.Остатки(, Номенклатура = &Номенклатура) КАК Заказы";
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Подпись = НСтр("ru = 'Заказано поставщикам'; fr = 'Commandé aux fournisseurs'; en = 'Ordered from suppliers';
			|es = 'Pedido a proveedores'");
		Строки.Добавить(Подпись + ": " + Формат(Выборка.Количество, ФорматЧисла));
	КонецЕсли;

	Если ПолучитьФункциональнуюОпцию("Производство")
		И ПравоДоступа(ПравоЧтения, Метаданные.РегистрыНакопления.ПотребностиПроизводства) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Потребности.ПотребностьОстаток), 0) КАК Нужно,
		|	ЕСТЬNULL(СУММА(Потребности.ЗаказаноОстаток), 0) КАК Заказано,
		|	ЕСТЬNULL(СУММА(Потребности.ПришлоОстаток), 0) КАК Пришло
		|ИЗ
		|	РегистрНакопления.ПотребностиПроизводства.Остатки(, Материал = &Номенклатура) КАК Потребности";
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Шаблон = НСтр("ru = 'Потребность производства: нужно %1, заказано %2, пришло %3';
			|fr = 'Besoin de production : besoin %1, commandé %2, reçu %3';
			|en = 'Production need: needed %1, ordered %2, received %3';
			|es = 'Necesidad de producción: necesario %1, pedido %2, recibido %3'");
		Нужно = Формат(Выборка.Нужно, ФорматЧисла);
		Заказано = Формат(Выборка.Заказано, ФорматЧисла);
		Пришло = Формат(Выборка.Пришло, ФорматЧисла);
		Строки.Добавить(СтрШаблон(Шаблон, Нужно, Заказано, Пришло));
	КонецЕсли;

	Если ПравоДоступа(ПравоЧтения, Метаданные.РегистрыНакопления.Продажи) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Продажи.КоличествоОборот), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(Продажи.ВыручкаОборот), 0) КАК Выручка
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&Начало, , , Номенклатура = &Номенклатура) КАК Продажи";
		// BSLLS:MagicNumber-off - двенадцать месяцев.
		Запрос.УстановитьПараметр("Начало", ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), -12));
		// BSLLS:MagicNumber-on
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Шаблон = НСтр("ru = 'Продано за 12 месяцев: %1 на %2'; fr = 'Vendu sur 12 mois : %1 pour %2';
			|en = 'Sold in 12 months: %1 for %2'; es = 'Vendido en 12 meses: %1 por %2'");
		Строки.Добавить(СтрШаблон(Шаблон, Формат(Выборка.Количество, ФорматЧисла), Формат(Выборка.Выручка, "ЧДЦ=2; ЧН=0")));
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти
