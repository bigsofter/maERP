#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НавигаторНоменклатуры.ПриСозданииНаСервере(ЭтотОбъект, Истина);
	ПрименитьРежимИерархии();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Навигатор иерархии - как в форме списка товаров (НавигаторНоменклатуры); панели фильтров у формы нет, помеченные на
// удаление в счётчиках учитываются, как в самом списке.
//

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	ПрименитьРежимИерархии();

КонецПроцедуры

&НаКлиенте
Процедура РежимИерархииПриИзменении(Элемент)

	ВидУзла = 0;
	ЗначениеУзла = Неопределено;
	ПрименитьРежимИерархии();

КонецПроцедуры

&НаКлиенте
Процедура УзлыИерархииПриАктивизацииСтроки(Элемент)

	// BSLLS:MagicNumber-off - пятая доля секунды: листание узлов стрелками не дёргает сервер на каждый узел.
	ПодключитьОбработчикОжидания("Подключаемый_ВыбратьУзел", 0.2, Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыбратьУзел()

	Узел = Элементы.УзлыИерархии.ТекущиеДанные;
	Если Узел = Неопределено Или Узел.Вид = ВидУзла И Узел.Значение = ЗначениеУзла Тогда
		Возврат;
	КонецЕсли;
	ВидУзла = Узел.Вид;
	ЗначениеУзла = Узел.Значение;
	ВыбратьУзелНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ИзбранныйРежим(Команда)

	ИзбранныйРежимНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИерархию(Команда)

	ПрименитьРежимИерархии();

КонецПроцедуры

&НаСервере
Процедура ПрименитьРежимИерархии()

	НавигаторНоменклатуры.ПрименитьРежим(ЭтотОбъект, КонтекстСписка(), ОтборыНавигатора());
	ПараметрыЗапроса = Справочники.Номенклатура.ПараметрыЗапросаСписка(КонтекстСписка(), ОтборыНавигатора(),
		РежимИерархии);
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Список.Параметры.УстановитьЗначениеПараметра(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	НавигаторНоменклатуры.УстановитьОтображение(ЭтотОбъект, КонтекстСписка().Типы.Количество() > 0);

КонецПроцедуры

&НаСервере
Процедура ИзбранныйРежимНаСервере()

	НавигаторНоменклатуры.ПереключитьИзбранныйРежим(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ВыбратьУзелНаСервере()

	НавигаторНоменклатуры.ВыбратьУзел(ЭтотОбъект);

КонецПроцедуры

// Возвращаемое значение:
//  Структура - см. Справочники.Номенклатура.НовыеОтборыПанели: без фильтров, помеченные на удаление - как в списке
//
&НаСервере
Функция ОтборыНавигатора()

	Отборы = Справочники.Номенклатура.НовыеОтборыПанели();
	Отборы.ПоказыватьПомеченные = Истина;
	Возврат Отборы;

КонецФункции

// Подбор с отбором по типу (S7): отбор формы по типу - и состав счётчиков навигатора; у групп тип не заполнен, в
// иерархическом виде отбор спрятал бы группы вместе с содержимым - список плоский.
//
// Возвращаемое значение:
//  Структура - см. Справочники.Номенклатура.НовыйКонтекстСписка
//
&НаСервере
Функция КонтекстСписка()

	Контекст = Справочники.Номенклатура.НовыйКонтекстСписка();
	Контекст.ДляВыбора = Истина;
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("ТипНоменклатуры") Тогда
		Тип = Параметры.Отбор.ТипНоменклатуры;
		Если ТипЗнч(Тип) = Тип("ПеречислениеСсылка.ТипыНоменклатуры") Тогда
			Контекст.Типы.Добавить(Тип);
		ИначеЕсли ТипЗнч(Тип) = Тип("Массив") Или ТипЗнч(Тип) = Тип("ФиксированныйМассив") Тогда
			Для Каждого Значение Из Тип Цикл
				Контекст.Типы.Добавить(Значение);
			КонецЦикла;
		Иначе
			// Список значений и прочее - без ограничения счётчиков: отбор формы список всё равно применит.
			Возврат Контекст;
		КонецЕсли;
	КонецЕсли;
	Возврат Контекст;

КонецФункции

#КонецОбласти
