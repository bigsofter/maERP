
#Область Форма

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
		ИспользованиеУпаковок = "ИндивидуальныйНабор";
	Иначе
		ИспользованиеУпаковок = "ОбщийНабор";
	КонецЕсли; 
	
	ЗаполнитьКартинки();
	
	Если Параметры.Свойство("Штрихкод") Тогда 
		Штрихкод = Параметры.Штрихкод;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда 
		Объект.Единица = Константы.ЕдиницаПоУмолчанию.Получить();
		Объект.СтавкаНДС = Константы.СтавкаНДСПоУмолчанию.Получить();
		Если Не ЗначениеЗаполнено(Объект.СпособПополнения) Тогда
			Объект.СпособПополнения = Справочники.Номенклатура.СпособПополненияПоУмолчанию(
				Объект.ТипНоменклатуры);
		КонецЕсли;
	КонецЕсли; 
	
	// Минимумы грузятся сразу: запись карточки материализует вычисленные минимумы складов без записи (их читают
	// закупки и «Недостаточные запасы»). Цены и техкарта - лениво, при первом переходе на закладку.
	ЗаполнитьМинОстаткиНаСервере();

	// Опции и роль - в реквизиты формы: видимость настраивается и на клиенте, где опции недоступны (tiny1C bsl-009).
	ИспользоватьПроизводство = ПолучитьФункциональнуюОпцию("Производство");
	ИспользоватьУчетСтанков = ИспользоватьПроизводство И ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтанков");
	ИспользоватьУпаковку = ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку");
	ИспользоватьИмпорт = ПолучитьФункциональнуюОпцию("ИспользоватьИмпорт");
	ИспользоватьКомплектацию = ПолучитьФункциональнуюОпцию("ИспользоватьКомплектацию");
	ЭтоКассир = РольКассира();
	Если Не ИспользоватьПроизводство Тогда
		// Без производства типы продукции, полуфабриката и сырья в выборе не нужны;
		// записанный элемент с таким типом своё значение показывает.
		СписокТипов = Элементы.ТипНоменклатуры.СписокВыбора;
		Для Каждого ТипПроизводства Из ТипыНоменклатурыПроизводства() Цикл
			ЭлементСписка = СписокТипов.НайтиПоЗначению(ТипПроизводства);
			Если ЭлементСписка <> Неопределено Тогда
				СписокТипов.Удалить(ЭлементСписка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Видимость колонок техкарты - только здесь, на сервере: в модуле формы на клиенте
	// ПолучитьФункциональнуюОпцию недоступна. Опция за сессию не меняется.
	Элементы.ТехнологическаяКартаХарактеристика.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	Элементы.ТехнологическаяКартаЕИ.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку");
	КомплектИспользован = Справочники.Номенклатура.КомплектИспользованВДокументах(Объект.Ссылка);

	// Дополнительные реквизиты (УправлениеСвойствами): поля строятся по описанию из базы,
	// страница скрывается, если реквизитов у номенклатуры нет.
	ПолейДополнительныхРеквизитов = УправлениеСвойствами.ЗаполнитьДополнительныеРеквизитыВФорме(ЭтотОбъект,
		"Справочник.Номенклатура", "ГруппаДополнительныеРеквизиты");
	Элементы.СтраницаДополнительно.Видимость = ПолейДополнительныхРеквизитов > 0;

	ОбновитьПризнакиТипа(ЭтотОбъект);
	НастроитьВидимость(ЭтотОбъект);
	ЗаполнитьПоказателиШапки();

КонецПроцедуры

// Роль кассира, а не право на объект: цены карточки ему не показываются.
//
// Возвращаемое значение:
//  Булево
//
&НаСервере
Функция РольКассира()

	Возврат РольДоступна("PDV");

КонецФункции

// Живые показатели шапки: остаток, свободно, розничная и закупочная цена; ниже минимума - красным.
//
&НаСервере
Процедура ЗаполнитьПоказателиШапки()

	Показатели = Справочники.Номенклатура.ПоказателиКарточки(Объект.Ссылка);
	ПоказателиШапки = Показатели.Текст;
	Элементы.ПоказателиШапки.ЦветТекста = ?(Показатели.НижеМинимума, ЦветаСтиля.Цвет_Красный, ЦветаСтиля.ЦветТекстаФормы);

КонецПроцедуры

// Типы номенклатуры, доступные только при включённом производстве.
//
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.ТипыНоменклатуры
//
&НаСервере
Функция ТипыНоменклатурыПроизводства()

	Типы = Новый Массив;
	Типы.Добавить(Перечисления.ТипыНоменклатуры.Продукция);
	Типы.Добавить(Перечисления.ТипыНоменклатуры.Полуфабрикат);
	Типы.Добавить(Перечисления.ТипыНоменклатуры.Сырье);
	Возврат Типы;

КонецФункции

// Способ пополнения, который форма устанавливает после смены типа номенклатуры.
//
// Параметры:
//  ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры - выбранный тип.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СпособыПополненияЗапасов - способ пополнения по умолчанию.
//
&НаСервереБезКонтекста
Функция СпособПополненияПоУмолчаниюНаСервере(ТипНоменклатуры)

	Возврат Справочники.Номенклатура.СпособПополненияПоУмолчанию(ТипНоменклатуры);

КонецФункции

// Признаки типа и надпись техкарты по текущему типу и единице - на сервере при создании и на клиенте при смене типа.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма карточки
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПризнакиТипа(Форма)

	Объект = Форма.Объект;
	Если Форма.ИспользоватьПроизводство Тогда
		Форма.НадписьТехнологическаяКарта = СтрШаблон(НСтр("ru = 'Для изготовления 1 %1 требуется сырья и полуфабрикатов:';
			|fr = 'Matières et produits semi-finis nécessaires pour fabriquer 1 %1 :';
			|en = 'Raw materials and semi-finished products required to produce 1 %1:';
			|es = 'Materias primas y productos semielaborados necesarios para fabricar 1 %1:'"), Объект.Единица);
	КонецЕсли;
	Форма.ЭтоПолуфабрикат = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Полуфабрикат");
	Форма.ЭтоПродукция = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция");
	Форма.ЭтоКомплект = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Комплект");
	Форма.ЭтоСырье = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Сырье");

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Изображения и присоединённые файлы товара берутся с диска компьютера: в веб-клиенте
	// это возможно только через расширение для работы с 1С:Предприятием.
	РасширениеРаботыС1СПредприятиемКлиент.Подключить(Неопределено,
		НСтр("ru = 'Для работы с изображениями и файлами товара установите расширение для работы с 1С:Предприятием.';
			|fr = 'Pour travailler avec les images et les fichiers de l''article, installez l''extension pour travailler avec 1C:Entreprise.';
			|en = 'To work with item images and files, install the 1C:Enterprise extension.';
			|es = 'Para trabajar con las imágenes y los archivos del artículo, instale la extensión para trabajar con 1C:Empresa.'"));

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ПроверитьДатуТехкартыПередЗаписью(Отказ);
	ПроверитьСвойстваИзготовленияПередЗаписью(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	УправлениеСвойствами.ПеренестиЗначенияИзФормыВОбъект(ЭтотОбъект, ТекущийОбъект, Отказ);
	// Минимумы пишет модуль объекта в транзакции записи товара: строки, которых в регистре нет или которые
	// от него отличаются (вычисленные значения складов без записи сохранение карточки материализует).
	ТекущийОбъект.ДополнительныеСвойства.Вставить(Справочники.Номенклатура.ИмяСвойстваМинимумовПоСкладам(),
		ТЗХранение.Выгрузить(, "МестоХранения, МинимальноеКоличествоХранения, МаксимальноеКоличествоХранения"));
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ЗаписатьДополнительныеСведения(ЭтотОбъект, ТекущийОбъект.Ссылка);
	ЗанятьШтрихкодыКарточки(ТекущийОбъект);
	Если ПараметрыЗаписи.Свойство("ДокументУстановкиЦен") Тогда
		ДокУстановкаЦен = ПараметрыЗаписи.ДокументУстановкиЦен;
	КонецЕсли;
	// Техкарта перечитывается, только если её закладку открывали: незагруженную карточку читать незачем.
	Если ТехкартаЗагружена Тогда
		ЗаполнитьТехкартуНаСервере(?(ПараметрыЗаписи.Свойство("ДокументКарты"), ПараметрыЗаписи.ДокументКарты, Неопределено));
	КонецЕсли;
	ЗаполнитьПоказателиШапки();
	// Артикул мог стать штрихкодом, а допустимые станки - смениться: открытые блоки перечитываются.
	Если БлокиСлужебныеЗагружены Тогда
		ЗагрузитьБлоки("Служебное");
	КонецЕсли;
	Если БлокиПроизводстваЗагружены Тогда
		ЗагрузитьБлоки("Производство");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	// Цены и техкарта карточки пишутся в транзакции записи товара: отказ любой из записей откатывает и товар,
	// а не оставляет его сохранённым без цен или карты. Ссылки на записанные документы форма получает в
	// ПослеЗаписиНаСервере через ПараметрыЗаписи - реквизиты формы до фиксации транзакции не меняются.
	Если СохранитьЦены Тогда
		Цены = ТЗЦены.Выгрузить(, "ВидЦены, Цена");
		ПараметрыЗаписи.Вставить("ДокументУстановкиЦен",
			Справочники.Номенклатура.ЗаписатьЦеныКарточки(ТекущийОбъект.Ссылка, Цены, ДокУстановкаЦен));
	КонецЕсли;
	Если НужноЗаписатьТехкарту() Тогда
		ПредупредитьОЗаполненныхВыпусках();
		ПараметрыЗаписи.Вставить("ДокументКарты",
			ТехнологическиеКарты.ЗаписатьТехкарту(ТекущийОбъект.Ссылка, ТЗТехкарта, ДействуетС));
	КонецЕсли;
КонецПроцедуры

// Артикул и штрихкод сканера закрепляются за товаром, только если штрихкод свободен или уже его: чужой
// штрихкод не перезаписывается, пользователь видит отказ (РегистрыСведений.ШтрихкодыНоменклатуры.ЗанятьШтрихкод).
//
// Параметры:
//  ТекущийОбъект - СправочникОбъект.Номенклатура - записанный товар
//
&НаСервере
Процедура ЗанятьШтрихкодыКарточки(ТекущийОбъект)
	Штрихкоды = Новый Массив;
	Если ЗначениеЗаполнено(Штрихкод) Тогда
		Штрихкоды.Добавить(Штрихкод);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущийОбъект.Артикул) И Штрихкоды.Найти(ТекущийОбъект.Артикул) = Неопределено Тогда
		Штрихкоды.Добавить(ТекущийОбъект.Артикул);
	КонецЕсли;
	Для Каждого ЗанимаемыйШтрихкод Из Штрихкоды Цикл
		ТекстОтказа = РегистрыСведений.ШтрихкодыНоменклатуры.ЗанятьШтрихкод(ЗанимаемыйШтрихкод, ТекущийОбъект.Ссылка);
		Если ТекстОтказа <> "" Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОтказа);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


#КонецОбласти // Форма





#Область СлужебныеПроцедурыИФункции

// Видимость закладок и блоков карточки по типу, опциям и роли - одна процедура без контекста: зовётся из
// ПриСозданииНаСервере (без мигания) и из всех обработчиков, меняющих видимость в открытой карточке (тип, упаковки).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма карточки
//
&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимость(Форма)

	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	ПоПроизводству = Форма.ЭтоПолуфабрикат Или Форма.ЭтоПродукция;

	Элементы.ГруппаУпаковки.Видимость = Форма.ИспользоватьУпаковку;
	Элементы.ГруппаИндивидуальныйНаборУпаковок.Видимость = Объект.ИспользоватьУпаковки;
	Элементы.ГруппаОбщийНаборУпаковок.Видимость = Объект.ИспользоватьУпаковки;
	Элементы.Единица.Доступность = Истина;
	Индивидуальный = Форма.ИспользованиеУпаковок = "ИндивидуальныйНабор";
	Элементы.НаборУпаковок.Видимость = Не Индивидуальный;
	Элементы.ГиперссылкаПерейтиУпаковкиНабора.Видимость = Не Индивидуальный;
	Элементы.ГиперссылкаПерейтиУпаковкиНоменклатуры.Видимость = Индивидуальный;
	Если Не Индивидуальный И Объект.ИспользоватьУпаковки Тогда
		Элементы.Единица.Доступность = Ложь;
	КонецЕсли;

	Элементы.Производитель.Видимость = Форма.ИспользоватьИмпорт;
	Элементы.Импортер.Видимость = Форма.ИспользоватьИмпорт;
	Элементы.ГруппаЦены.Видимость = Не Форма.ЭтоКассир;

	Элементы.СтраницаТехкарта.Видимость = Форма.ИспользоватьПроизводство И ПоПроизводству;
	Элементы.СтраницаСтанки.Видимость = Форма.ИспользоватьУчетСтанков И ПоПроизводству;
	// «Где используется» - для сырья и полуфабриката (ревью плана Codex, P2); раздел ещё скрыт, пока пуст.
	ГдеИспользуется = Форма.ИспользоватьПроизводство И (Форма.ЭтоСырье Или Форма.ЭтоПолуфабрикат);
	Если Не ГдеИспользуется Тогда
		Элементы.ГруппаГдеИспользуется.Видимость = Ложь;
	КонецЕсли;
	Если Не ПоПроизводству Тогда
		Элементы.ГруппаВыработкаСтанков.Видимость = Ложь;
	КонецЕсли;
	Элементы.СтраницаПроизводство.Видимость = Элементы.СтраницаТехкарта.Видимость Или Элементы.СтраницаСтанки.Видимость
		Или ГдеИспользуется;
	Элементы.ИсторияТехкарт.Доступность = ЗначениеЗаполнено(Объект.Ссылка);

	Элементы.СтраницаКомплект.Видимость = Форма.ЭтоКомплект;
	Элементы.СтраницаХранение.Видимость = Не Форма.ЭтоКомплект;
	Элементы.СоставКомплекта.ТолькоПросмотр = Форма.КомплектИспользован;

КонецПроцедуры

// Блоки живых данных закладки (этап 4): остатки и свободно, на станках, движение; где используется и выработка
// станков; штрихкоды. Блок без права роли на свой регистр скрыт, пустой - тоже.
//
// Параметры:
//  Закладка - Строка - «Склад», «Производство» или «Служебное», см. Справочники.Номенклатура.ДанныеКарточки
//
&НаСервере
Процедура ЗагрузитьБлоки(Знач Закладка)

	Данные = Справочники.Номенклатура.ДанныеКарточки(Объект.Ссылка, Закладка);
	Если Закладка = "Склад" Тогда
		ЗагрузитьБлок(Данные, "Остатки", ОстаткиКарточки, Элементы.ГруппаОстаткиКарточки);
		ЗагрузитьБлок(Данные, "НаСтанках", НаСтанках, Элементы.ГруппаНаСтанках);
		ДвижениеКарточки = ?(Данные.Свойство("ДвижениеТекст"), Данные.ДвижениеТекст, "");
		Элементы.ДвижениеКарточки.Видимость = ДвижениеКарточки <> "";
	ИначеЕсли Закладка = "Производство" Тогда
		ЗагрузитьБлок(Данные, "ГдеИспользуется", ГдеИспользуется, Элементы.ГруппаГдеИспользуется);
		ЗагрузитьБлок(Данные, "ВыработкаСтанков", ВыработкаСтанков, Элементы.ГруппаВыработкаСтанков);
	Иначе
		ЗагрузитьБлок(Данные, "Штрихкоды", ШтрихкодыТовара, Элементы.ГруппаШтрихкоды);
	КонецЕсли;
	НастроитьВидимость(ЭтотОбъект);

КонецПроцедуры

// Параметры:
//  Данные  - Структура - см. Справочники.Номенклатура.ДанныеКарточки
//  Имя     - Строка - имя блока в данных
//  Таблица - ДанныеФормыКоллекция - таблица блока на форме
//  Группа  - ГруппаФормы - раздел блока: скрыт без права или без строк
//
&НаСервере
Процедура ЗагрузитьБлок(Данные, Имя, Таблица, Группа)

	Доступен = Данные.Доступные.Найти(Имя) <> Неопределено;
	Если Доступен Тогда
		Таблица.Загрузить(Данные[Имя]);
	Иначе
		Таблица.Очистить();
	КонецЕсли;
	Группа.Видимость = Доступен И Таблица.Количество() > 0;

КонецПроцедуры

// Цены и техкарта загружаются при первом переходе на свою закладку: открытие карточки не читает их, если они не
// нужны. Без загрузки нечего и записывать: СохранитьЦены и РедактированиеТехкарты взводятся только правкой.
//
// Параметры:
//  ИмяСтраницы - Строка - имя открытой закладки
//
&НаСервере
Процедура ЗагрузитьЗакладку(Знач ИмяСтраницы)

	Если ИмяСтраницы = "ГруппаЦены" И Не ЦеныЗагружены Тогда
		ЗаполнитьЦеныНаСервере();
		Элементы.ЗакупочнаяЦена.ТолькоПросмотр = ЗакупочнаяЦена <> 0;
		ЦеныЗагружены = Истина;
	КонецЕсли;
	Если ИмяСтраницы = "СтраницаПроизводство" И Не ТехкартаЗагружена Тогда
		ЗаполнитьТехкартуНаСервере();
		ТехкартаЗагружена = Истина;
	КонецЕсли;
	Если ИмяСтраницы = "СтраницаХранение" И Не БлокиСкладаЗагружены Тогда
		ЗагрузитьБлоки("Склад");
		БлокиСкладаЗагружены = Истина;
	КонецЕсли;
	Если ИмяСтраницы = "СтраницаПроизводство" И Не БлокиПроизводстваЗагружены Тогда
		ЗагрузитьБлоки("Производство");
		БлокиПроизводстваЗагружены = Истина;
	КонецЕсли;
	Если ИмяСтраницы = "СтраницаСлужебное" И Не БлокиСлужебныеЗагружены Тогда
		ЗагрузитьБлоки("Служебное");
		БлокиСлужебныеЗагружены = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеДобавленияУдаленияКартинок(Результат, ДопПараметры) Экспорт
	ЗаполнитьКартинки();
КонецПроцедуры

&НаСервере
Процедура УстановитьЕдиницуНабораУпаковок()
	Если Объект.НаборУпаковок <> Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
		Объект.Единица = Объект.НаборУпаковок.Единица;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКартинки()
	НЗ = РегистрыСведений.ПрисоединённыеФайлы.СоздатьНаборЗаписей();
	НЗ.Отбор.Объект.Установить(Объект.Ссылка);
	НЗ.Прочитать();
	Изображения.Загрузить(НЗ.Выгрузить());
	Изображения.Сортировать("ДатаДобавления убыв");
	Если Изображения.Количество()>0 Тогда 
		НомерКартинки = 1;
	КонецЕсли;
	ЗаполнитьИзображениеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзображениеНаСервере()
	Если НомерКартинки > Изображения.Количество() Тогда
		НомерКартинки = Изображения.Количество();
	КонецЕсли;
	Если НомерКартинки = 0 Тогда
		Изображение = "";
		УстановитьДоступностьКнопокКартинки();
		Возврат;
	КонецЕсли;
	ID = Изображения.Получить(НомерКартинки-1).ID;
	КлючЗаписиРег = РегистрыСведений.ПрисоединённыеФайлы.СоздатьКлючЗаписи(Новый Структура("Объект,ID", Объект.Ссылка,ID));
	Если Не КлючЗаписиРег.Пустой() Тогда
		Изображение = ПолучитьНавигационнуюСсылку(КлючЗаписиРег, "Данные");
	КонецЕсли;
	УстановитьДоступностьКнопокКартинки();
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКнопокКартинки()
	Если НомерКартинки = 0 Тогда 
		Элементы.ИзображениеВлево.Доступность = Ложь;
		Элементы.ИзображениеВправо.Доступность = Ложь;
	Иначе
		Элементы.ИзображениеВлево.Доступность = НомерКартинки > 1;
		Элементы.ИзображениеВправо.Доступность = НомерКартинки < Изображения.Количество();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УдалитьИзображениеНаСервере(ID)
	КлючЗаписиРег = РегистрыСведений.ПрисоединённыеФайлы.СоздатьКлючЗаписи(Новый Структура("Объект,ID", Объект.Ссылка,ID));
	МасКлючей  = Новый Массив;
	МасКлючей.Добавить(КлючЗаписиРег);
	МасУдаляемыеФайлы = ПрисоединённыеФайлыВызовСервера.ПолучитьМассивУдаляемыхФайлов(МасКлючей);
	НЗ = РегистрыСведений.ПрисоединённыеФайлы.СоздатьНаборЗаписей();
	НЗ.Отбор.Объект.Установить(Объект.Ссылка);
	НЗ.Отбор.ID.Установить(ID);
	НЗ.Записать();
	ПрисоединённыеФайлыВызовСервера.УдалитьФайлыСДиска(МасУдаляемыеФайлы);
	ЗаполнитьКартинки();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМинОстаткиНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МестаХранения.Ссылка КАК МестоХранения,
	|	ЕСТЬNULL(МинимальныйОстатокПоСкладам.МаксимальноеКоличествоХранения, &МаксимальноеКоличествоХранения) КАК МаксимальноеКоличествоХранения,
	|	ЕСТЬNULL(МинимальныйОстатокПоСкладам.МинимальноеКоличествоХранения, &МинимальноеКоличествоХранения) КАК МинимальноеКоличествоХранения
	|ИЗ
	|	Справочник.МестаХранения КАК МестаХранения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальныйОстатокПоСкладам КАК МинимальныйОстатокПоСкладам
	|		ПО МестаХранения.Ссылка = МинимальныйОстатокПоСкладам.МестоХранения
	|			И (МинимальныйОстатокПоСкладам.Номенклатура = &Номенклатура
	|				И НЕ &Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))";
	Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);
	Запрос.УстановитьПараметр("МаксимальноеКоличествоХранения", Объект.МаксимальноеКоличествоХранения);
	Запрос.УстановитьПараметр("МинимальноеКоличествоХранения", Объект.МинимальноеКоличествоХранения);
	ТЗХранение.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКоличествоМинМакс(Команда)
	Для Каждого Стр из ТЗХранение Цикл
		Стр.МинимальноеКоличествоХранения = Объект.МинимальноеКоличествоХранения;
		Стр.МаксимальноеКоличествоХранения = Объект.МаксимальноеКоличествоХранения;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦеныНаСервере()
	Запрос = Новый Запрос;
	Если Объект.Ссылка.Пустая() Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыЦен.Ссылка КАК ВидЦены
		|ИЗ
		|	Справочник.ВидыЦен КАК ВидыЦен
		|ГДЕ
		|	НЕ ВидыЦен.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Закупочная)
		|	И НЕ ВидыЦен.ПометкаУдаления";
	Иначе
		ТЗЦеныПоставщиков = РегистрыСведений.ЦеныНоменклатурыПоставщиков.СрезПоследних(,Новый Структура("Номенклатура",Объект.Ссылка));
		Если Не ТЗЦеныПоставщиков.Количество() = 0 Тогда
			ТЗЦеныПоставщиков.Сортировать("Период убыв");
			ЗакупочнаяЦена = ТЗЦеныПоставщиков.Получить(0).Цена;
		КонецЕсли;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыЦен.Ссылка КАК ВидЦены,
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ИЗ
		|	Справочник.ВидыЦен КАК ВидыЦен
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, Номенклатура = &Номенклатура) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО ВидыЦен.Ссылка = ЦеныНоменклатурыСрезПоследних.ВидЦены
		|ГДЕ
		|	НЕ ВидыЦен.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Закупочная)
		|	И НЕ ВидыЦен.ПометкаУдаления";
		Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);
	КонецЕсли;
	ТЗЦены.Загрузить(Запрос.Выполнить().Выгрузить());
	Для Каждого Стр из ТЗЦены Цикл 
		Стр.Наценка = Наценка(Стр.Цена, ЗакупочнаяЦена);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТехкартуНаСервере(ДокументКарты = Неопределено)

	ТЗТехкарта.Очистить();
	Если ДокументКарты = Неопределено Тогда
		Версия = ТехнологическиеКарты.ТекущиеТехкарты(Объект.Ссылка, КонецДня(ТекущаяДатаСеанса())).Получить(Объект.Ссылка);
		ДокументКарты = ?(Версия = Неопределено, Документы.ТехнологическаяКарта.ПустаяСсылка(), Версия.Версия);
	КонецЕсли;
	ВыбраннаяТехкарта = ДокументКарты;
	ИсходнаяТехкарта = ДокументКарты;
	Если ЗначениеЗаполнено(ДокументКарты) Тогда
		ТЗТехкарта.Загрузить(ТехнологическиеКарты.СоставТехкартыПоРегистратору(ДокументКарты));
		ДействуетС = НачалоДня(ДокументКарты.Дата);
	Иначе
		ДействуетС = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	РедактированиеТехкарты = Ложь;
	ДатаТехкартыВыбранаВручную = Ложь;
	ПредупреждениеВыпусковТехкарты = "";
	Элементы.ПредупреждениеВыпусковТехкарты.Видимость = Ложь;
	УстановитьНадписьВерсииТехкарты();
	ПересчитатьТехкартуНаСервере();

КонецПроцедуры

&НаСервере
Процедура НачатьРедактированиеТехкартыНаСервере()

	Если РедактированиеТехкарты Тогда
		Возврат;
	КонецЕсли;
	РедактированиеТехкарты = Истина;
	ДействуетС = НачалоДня(ТекущаяДатаСеанса());
	ПодобратьТехкартуПоДате();

КонецПроцедуры

// При ручном выборе другой существующей версии загружается её состав.
// При начале редактирования строки состав сохраняется: новую строку нельзя потерять.
//
// Параметры:
//  ЗагружатьСостав - Булево - ручной выбор даты.
//
&НаСервере
Процедура ПодобратьТехкартуПоДате(ЗагружатьСостав = Ложь)

	Проверка = ТехнологическиеКарты.ДатаРедактированияТехкарты(Объект.Ссылка, ДействуетС);
	ДействуетС = Проверка.Дата;
	Если Не Проверка.Допустима Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТехнологическиеКарты.ОшибкаДатыТехкарты(Проверка.ПоследняяДата));
	КонецЕсли;
	Если ЗагружатьСостав И ЗначениеЗаполнено(Проверка.Документ) И Проверка.Документ <> ВыбраннаяТехкарта Тогда
		ТЗТехкарта.Загрузить(ТехнологическиеКарты.СоставТехкартыПоРегистратору(Проверка.Документ));
		ИсходнаяТехкарта = Проверка.Документ;
	КонецЕсли;
	ВыбраннаяТехкарта = Проверка.Документ;
	УстановитьНадписьВерсииТехкарты();
	ПредупредитьОЗаполненныхВыпусках();

КонецПроцедуры

&НаСервере
Процедура УстановитьНадписьВерсииТехкарты()

	Элементы.ВерсияТехкарты.Гиперссылка = ЗначениеЗаполнено(ВыбраннаяТехкарта);

	Если Не ЗначениеЗаполнено(ВыбраннаяТехкарта) Тогда
		ВерсияТехкарты = НСтр("ru = 'Будет создана новая технологическая карта от';
			|fr = 'Une nouvelle gamme sera créée le'; en = 'A new production routing will be created for';
			|es = 'Se creará una nueva ruta de fabricación el'");
		Возврат;
	КонецЕсли;
	Номер = СокрЛП(ВыбраннаяТехкарта.Номер);
	Пока СтрДлина(Номер) > 1 И Лев(Номер, 1) = "0" Цикл
		Номер = Прав(Номер, СтрДлина(Номер) - 1);
	КонецЦикла;
	Шаблон = НСтр("ru = 'Техкарта № %1 от'; fr = 'Gamme de fabrication n° %1 du';
		|en = 'Production routing No. %1 dated'; es = 'Ruta de fabricación n.º %1 del'");
	ВерсияТехкарты = СтрШаблон(Шаблон, Номер);

КонецПроцедуры

&НаКлиенте
Процедура ВерсияТехкартыНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(ВыбраннаяТехкарта) Тогда
		ПоказатьЗначение(, ВыбраннаяТехкарта);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПредупредитьОЗаполненныхВыпусках()

	ПредупреждениеВыпусковТехкарты = "";
	Если РедактированиеТехкарты
		И ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Объект.Ссылка, ДействуетС) Тогда
		ПредупреждениеВыпусковТехкарты = НСтр("ru = 'С даты этой техкарты уже есть проведённые выпуски продукции. Перезаполните их вручную.';
			|fr = 'Des productions sont déjà validées depuis cette date. Remplissez-les à nouveau manuellement.';
			|en = 'Posted production issues exist from this date. Refill their materials manually.';
			|es = 'Ya existen producciones contabilizadas desde esta fecha. Vuelva a rellenar sus materiales manualmente.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПредупреждениеВыпусковТехкарты);
	КонецЕсли;
	Элементы.ПредупреждениеВыпусковТехкарты.Видимость = ПредупреждениеВыпусковТехкарты <> "";

КонецПроцедуры

// Сам вход в ячейку и отмена редактирования не создают карту нового дня.
//
// Возвращаемое значение:
//  Булево - состав изменён либо явно выбрана дата новой версии.
//
&НаСервере
Функция НужноЗаписатьТехкарту()

	Если Не РедактированиеТехкарты Тогда
		Возврат Ложь;
	КонецЕсли;
	// ВерсияКартыУстарела сверяет и состав, и способ изготовления с процентом потерь, читая записанную
	// версию один раз. Отдельная сверка нужна потому, что новые поля намеренно не входят в ключ состава:
	// ключ общий со сверкой состава заказа на производство, у строк которого этих полей нет.
	Если ЗначениеЗаполнено(ВыбраннаяТехкарта) Тогда
		Возврат ТехнологическиеКарты.ВерсияКартыУстарела(ВыбраннаяТехкарта, ТЗТехкарта);
	КонецЕсли;
	Возврат ТехнологическиеКарты.ВерсияКартыУстарела(ИсходнаяТехкарта, ТЗТехкарта)
		Или (ДатаТехкартыВыбранаВручную И ТЗТехкарта.Количество() > 0);

КонецФункции

&НаСервере
Процедура ПроверитьДатуТехкартыПередЗаписью(Отказ)

	Если Не НужноЗаписатьТехкарту() Тогда
		Возврат;
	КонецЕсли;
	Проверка = ТехнологическиеКарты.ДатаРедактированияТехкарты(Объект.Ссылка, ДействуетС);
	Если Не Проверка.Допустима Тогда
		Отказ = Истина;
		ПодобратьТехкартуПоДате();
	КонецЕсли;

КонецПроцедуры

// Карта записывается уже после записи самого элемента (ПослеЗаписиНаСервере), поэтому отказ проверки
// заполнения документа карты пришёл бы сюда исключением, когда номенклатура уже сохранена, а сообщение
// указывало бы на строку документа, которой пользователь не видит. Правило проверяется здесь, до записи,
// с привязкой к строке состава на закладке «Техкарта».
//
// Параметры:
//  Отказ - Булево - устанавливается, если состав записать нельзя.
//
&НаСервере
Процедура ПроверитьСвойстваИзготовленияПередЗаписью(Отказ)

	Если Не НужноЗаписатьТехкарту() Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Конфликт Из ТехнологическиеКарты.КонфликтыСвойствИзготовления(ТЗТехкарта) Цикл
		Поле = "ТЗТехкарта[" + Формат(Конфликт.Индекс, "ЧГ=0") + "]." + Конфликт.Поле;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Конфликт.Текст, , Поле, , Отказ);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьТехкартуНаСервере()

	Состав = РеквизитФормыВЗначение("ТЗТехкарта");
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Объект.Ссылка, Состав);
	Для Индекс = 0 По ТЗТехкарта.Количество() - 1 Цикл
		ТЗТехкарта[Индекс].Цена = Показатели.Строки[Индекс].Цена;
		ТЗТехкарта[Индекс].Сумма = Показатели.Строки[Индекс].Сумма;
	КонецЦикла;
	ИтогоКоличествоТехкарты = Состав.Итог("Количество");
	ИтогоСуммаТехкарты = Показатели.Себестоимость;
	ОбновитьСтатистикуТехкарты(Показатели);

КонецПроцедуры

// Нулевые показатели скрываются; отрицательная маржа остаётся видимой.
//
// Параметры:
//  Показатели - Структура - см. ТехнологическиеКарты.ПоказателиТехкарты.
//
&НаСервере
Процедура ОбновитьСтатистикуТехкарты(Показатели)

	ФорматСуммы = "ЧДЦ=2";
	ШаблонСебестоимости = НСтр("ru = 'Плановая себестоимость 1 %1: %2 %3';
		|fr = 'Coût prévisionnel pour 1 %1 : %2 %3'; en = 'Planned cost per 1 %1: %2 %3';
		|es = 'Coste previsto por 1 %1: %2 %3'");
	ПлановаяСебестоимостьТехкарты = СтрШаблон(ШаблонСебестоимости,
		Объект.Единица, Формат(Показатели.Себестоимость, ФорматСуммы), Показатели.Валюта);
	ШаблонВыпуска = НСтр("ru = 'Можно произвести из остатков: %1 %2';
		|fr = 'Production possible avec le stock : %1 %2'; en = 'Can produce from stock: %1 %2';
		|es = 'Producción posible con existencias: %1 %2'");
	ДоступныйВыпускТехкарты = СтрШаблон(ШаблонВыпуска, Формат(Показатели.МожноПроизвести, "ЧДЦ=3"), Объект.Единица);
	ШаблонМаржи = НСтр("ru = 'Потенциальная маржа всего выпуска: %1 %2 (продажа по %3 %2)';
		|fr = 'Marge potentielle totale : %1 %2 (vente à %3 %2)';
		|en = 'Potential margin for all output: %1 %2 (selling at %3 %2)';
		|es = 'Margen potencial de toda la producción: %1 %2 (venta a %3 %2)'");
	ПотенциальнаяМаржаТехкарты = СтрШаблон(ШаблонМаржи,
		Формат(Показатели.ПотенциальнаяМаржа, ФорматСуммы), Показатели.Валюта, Формат(Показатели.ЦенаПродажи, ФорматСуммы));
	ПредупреждениеЦенТехкарты = НСтр("ru = 'Для части материалов нет закупочной цены. Себестоимость и маржа не рассчитаны.';
		|fr = 'Le prix d’achat manque pour certaines matières. Le coût et la marge ne sont pas calculés.';
		|en = 'Some materials have no purchase price. Cost and margin have not been calculated.';
		|es = 'Falta el precio de compra de algunos materiales. No se han calculado el coste ni el margen.'");
	Элементы.ПлановаяСебестоимостьТехкарты.Видимость = Показатели.Себестоимость <> 0;
	Элементы.ДоступныйВыпускТехкарты.Видимость = Показатели.МожноПроизвести <> 0;
	Элементы.ПотенциальнаяМаржаТехкарты.Видимость = Показатели.ПотенциальнаяМаржа <> 0;
	Элементы.ПредупреждениеЦенТехкарты.Видимость = Не Показатели.ВсеЦеныЕсть;

КонецПроцедуры

// Наценка цены над закупочной, процентов; без закупочной цены - 0.
//
// Параметры:
//  Цена       - Число - цена вида цен
//  Закупочная - Число - закупочная цена
//
// Возвращаемое значение:
//  Число - наценка, %
//
&НаКлиентеНаСервереБезКонтекста
Функция Наценка(Цена, Закупочная)

	// BSLLS:MagicNumber-off - проценты.
	Возврат ?(Закупочная = 0, 0, (Цена / Закупочная - 1) * 100);
	// BSLLS:MagicNumber-on

КонецФункции

// Цена по наценке над закупочной - обратная к Наценка.
//
// Параметры:
//  ПроцентНаценки - Число - наценка, %
//  Закупочная - Число - закупочная цена
//
// Возвращаемое значение:
//  Число - цена
//
&НаКлиентеНаСервереБезКонтекста
Функция ЦенаПоНаценке(ПроцентНаценки, Закупочная)

	// BSLLS:MagicNumber-off - проценты.
	Возврат (ПроцентНаценки + 100) * Закупочная / 100;
	// BSLLS:MagicNumber-on

КонецФункции


#КонецОбласти // СлужебныеПроцедурыИФункции  



#Область ЭлементыФормы

&НаКлиенте
Процедура ВидПриИзменении(Элемент)

	Объект.СпособПополнения = СпособПополненияПоУмолчаниюНаСервере(Объект.ТипНоменклатуры);
	ОбновитьПризнакиТипа(ЭтотОбъект);
	// Блоки производства зависят от типа: при следующем открытии закладки они строятся заново, открытая - сразу.
	БлокиПроизводстваЗагружены = Ложь;
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаПроизводство Тогда
		ЗагрузитьЗакладку("СтраницаПроизводство");
	КонецЕсли;
	НастроитьВидимость(ЭтотОбъект);     
	
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВсеКартинки = НСтр("ru = 'Все картинки'; fr = 'Toutes les images'; en = 'All images'; es = 'Todas las imágenes'");
	Фильтр = ВсеКартинки + " (*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.png)|*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.png|"
				+ "BMP (*.bmp;*.dib;*.rle)|*.bmp;*.dib;*.rle|"
				+ "JPEG (*.jpg;*.jpeg)|*.jpg;*.jpeg|"
				+ "TIFF (*.tif)|*.tif|"
				+ "PNG (*.png)|*.png|";
	Оп = Новый ОписаниеОповещения("ПослеДобавленияУдаленияКартинок", ЭтотОбъект);
	ПрисоединённыеФайлыКлиент.ПрисоединитьФайлы(Объект.Ссылка,,Фильтр,Оп);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзображение(Команда)
	Если НомерКартинки = 0 Тогда
		Возврат;
	КонецЕсли;
	СтрКартинки = Изображения.Получить(НомерКартинки-1);
	Если СтрКартинки = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	ID = СтрКартинки.ID;
	УдалитьИзображениеНаСервере(ID);
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьУпаковкиПриИзменении(Элемент)
	Если Объект.ИспользоватьУпаковки Тогда
		ИспользованиеУпаковок = "ИндивидуальныйНабор";
		ИспользованиеУпаковокИндивидуальныйНаборПриИзменении(Элемент);
	Иначе
		Объект.НаборУпаковок = Неопределено;
		НастроитьВидимость(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользованиеУпаковокИндивидуальныйНаборПриИзменении(Элемент)
	Объект.НаборУпаковок = ПредопределенноеЗначение("Справочник.НаборыУпаковок.ИндивидуальныйДляНоменклатуры");
	НастроитьВидимость(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ИспользованиеУпаковокОбщийНаборПриИзменении(Элемент)
	Объект.НаборУпаковок = Неопределено;
	НастроитьВидимость(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаПерейтиУпаковкиНоменклатурыНажатие(Элемент)
	ОткрытьУпаковки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаПерейтиУпаковкиНабораНажатие(Элемент)
	ОткрытьУпаковки(Истина);
КонецПроцедуры

// Список упаковок товара (индивидуальный набор) или общего набора; новый товар сначала записывается.
//
// Параметры:
//  ОбщийНабор - Булево - упаковки набора, иначе - самого товара
//
&НаКлиенте
Процедура ОткрытьУпаковки(ОбщийНабор)
	РаботаСДокументамиКлиент.ЗаписатьЕслиНовый(ЭтотОбъект, Истина);
	Отбор = Новый Структура;
	Отбор.Вставить("Владелец", ?(ОбщийНабор, Объект.НаборУпаковок, Объект.Ссылка));
	Отбор.Вставить("ТипИзмеряемойВеличины", ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Упаковка"));
	П = Новый Структура("Отбор", Отбор);
	ОткрытьФорму("Справочник.УпаковкиЕдиницыИзмерения.ФормаСписка", П, , УникальныйИдентификатор, , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура НаборУпаковокПриИзменении(Элемент)
	УстановитьЕдиницуНабораУпаковок();
	НастроитьВидимость(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеВправо(Команда)
	СдвинутьИзображение(1);
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеВлево(Команда)
	СдвинутьИзображение(-1);
КонецПроцедуры

// Параметры:
//  Шаг - Число - на сколько картинок листать: 1 - вправо, -1 - влево
//
&НаКлиенте
Процедура СдвинутьИзображение(Шаг)
	НомерКартинки = НомерКартинки + Шаг;
	ЗаполнитьИзображениеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТЗХранениеПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТЗХранениеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗакупочнаяЦенаПриИзменении(Элемент)
	Для Каждого Стр из ТЗЦены Цикл 
		Стр.Наценка = Наценка(Стр.Цена, ЗакупочнаяЦена);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТЗЦеныЦенаПриИзменении(Элемент)
	ТекСтр = Элементы.ТЗЦены.ТекущиеДанные;
	ТекСтр.Наценка = Наценка(ТекСтр.Цена, ЗакупочнаяЦена);
	СохранитьЦены = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТЗЦеныНаценкаПриИзменении(Элемент)
	ТекСтр = Элементы.ТЗЦены.ТекущиеДанные;
	ТекСтр.Цена = ЦенаПоНаценке(ТекСтр.Наценка, ЗакупочнаяЦена);
	СохранитьЦены = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ИсторияТехкарт(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("Продукция", Объект.Ссылка);
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	ОткрытьФорму("РегистрСведений.СоставТехКарты.ФормаСписка", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДействуетСПриИзменении(Элемент)

	ДействуетСПриИзмененииНаСервере();

КонецПроцедуры

&НаСервере
Процедура ДействуетСПриИзмененииНаСервере()

	РедактированиеТехкарты = Истина;
	ДатаТехкартыВыбранаВручную = Истина;
	ПодобратьТехкартуПоДате(Истина);
	ПересчитатьТехкартуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТехнологическаяКартаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	НачатьРедактированиеТехкартыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТехнологическаяКартаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ПересчитатьТехкартуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТехнологическаяКартаПередУдалением(Элемент, Отказ)

	НачатьРедактированиеТехкартыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТехнологическаяКартаПослеУдаления(Элемент)

	ПересчитатьТехкартуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СоставТехкартыПриИзменении(Элемент)

	ИзменитьСоставТехкартыНаСервере();

КонецПроцедуры

// Начало редактирования и пересчёт состава - одним серверным вызовом.
//
&НаСервере
Процедура ИзменитьСоставТехкартыНаСервере()

	НачатьРедактированиеТехкартыНаСервере();
	ПересчитатьТехкартуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)

	ЗагрузитьЗакладку(ТекущаяСтраница.Имя);

КонецПроцедуры

&НаКлиенте
Процедура ТехнологическаяКартаНоменклатураПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.ТехнологическаяКарта.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		// Характеристика прежнего материала для нового недействительна, а упаковка
		// заполняется только из карты: иначе строка разойдётся с регистром.
		ТекущаяСтрока.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
		ТекущаяСтрока.Упаковка = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
	КонецЕсли;

	СоставТехкартыПриИзменении(Элемент);

КонецПроцедуры


#КонецОбласти // ЭлементыФормы
