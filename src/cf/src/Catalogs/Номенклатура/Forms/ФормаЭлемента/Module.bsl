
#Область Форма

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
		ИспользованиеУпаковок = "ИндивидуальныйНабор";
	Иначе
		ИспользованиеУпаковок = "ОбщийНабор";
	КонецЕсли; 
	
	ЗаполнитьКартинки();
	
	Если Параметры.Свойство("Штрихкод") Тогда 
		Штрихкод = Параметры.Штрихкод;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда 
		Объект.Единица = Константы.ЕдиницаПоУмолчанию.Получить();
		Объект.СтавкаНДС = Константы.СтавкаНДСПоУмолчанию.Получить();
	КонецЕсли; 
	
	ЗаполнитьМинОстаткиНаСервере();
	ЗаполнитьЦеныНаСервере();
	Элементы.ЗакупочнаяЦена.ТолькоПросмотр = Не ЗакупочнаяЦена = 0;
	Элементы.ГруппаЦены.Видимость = Не РольДоступна("PDV");
	
	ИспользоватьПроизводство = ПолучитьФункциональнуюОпцию("Производство");
	КомплектИспользован = Справочники.Номенклатура.КомплектИспользованВДокументах(Объект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыФормыПоУмолчанию()
	
	Если ИспользоватьПроизводство Тогда 
		НадписьТехнологическаяКарта = "На изготовление 1 " + Объект.Единица + " требуется сырья и полуфабриков в объеме: ";
	КонецЕсли;
	
	ЭтоПолуфабрикат = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Полуфабрикат");
	ЭтоПродукция 	= Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция");
	ЭтоКомплект 	= Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Комплект");

КонецПроцедуры

