
#Область Форма

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
		ИспользованиеУпаковок = "ИндивидуальныйНабор";
	Иначе
		ИспользованиеУпаковок = "ОбщийНабор";
	КонецЕсли; 
	
	ЗаполнитьКартинки();
	
	Если Параметры.Свойство("Штрихкод") Тогда 
		Штрихкод = Параметры.Штрихкод;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда 
		Объект.Единица = Константы.ЕдиницаПоУмолчанию.Получить();
		Объект.СтавкаНДС = Константы.СтавкаНДСПоУмолчанию.Получить();
	КонецЕсли; 
	
	ЗаполнитьМинОстаткиНаСервере();
	ЗаполнитьЦеныНаСервере();
	ЗаполнитьТехкартуНаСервере();
	Элементы.ЗакупочнаяЦена.ТолькоПросмотр = Не ЗакупочнаяЦена = 0;
	Элементы.ГруппаЦены.Видимость = Не РольДоступна("PDV");
	
	ИспользоватьПроизводство = ПолучитьФункциональнуюОпцию("Производство");
	Если Не ИспользоватьПроизводство Тогда
		// Без производства типы продукции, полуфабриката и сырья в выборе не нужны;
		// записанный элемент с таким типом своё значение показывает.
		СписокТипов = Элементы.ТипНоменклатуры.СписокВыбора;
		Для Каждого ТипПроизводства Из ТипыНоменклатурыПроизводства() Цикл
			ЭлементСписка = СписокТипов.НайтиПоЗначению(ТипПроизводства);
			Если ЭлементСписка <> Неопределено Тогда
				СписокТипов.Удалить(ЭлементСписка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Видимость колонок техкарты - только здесь, на сервере: в модуле формы на клиенте
	// ПолучитьФункциональнуюОпцию недоступна. Опция за сессию не меняется.
	Элементы.ТехнологическаяКартаХарактеристика.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	Элементы.ТехнологическаяКартаЕИ.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку");
	КомплектИспользован = Справочники.Номенклатура.КомплектИспользованВДокументах(Объект.Ссылка);

	// Дополнительные реквизиты (УправлениеСвойствами): поля строятся по описанию из базы,
	// страница скрывается, если реквизитов у номенклатуры нет.
	ПолейДополнительныхРеквизитов = УправлениеСвойствами.ЗаполнитьДополнительныеРеквизитыВФорме(ЭтотОбъект,
		"Справочник.Номенклатура", "ГруппаДополнительныеРеквизиты");
	Элементы.СтраницаДополнительно.Видимость = ПолейДополнительныхРеквизитов > 0;

КонецПроцедуры

// Типы номенклатуры, доступные только при включённом производстве.
//
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.ТипыНоменклатуры
//
&НаСервере
Функция ТипыНоменклатурыПроизводства()

	Типы = Новый Массив;
	Типы.Добавить(Перечисления.ТипыНоменклатуры.Продукция);
	Типы.Добавить(Перечисления.ТипыНоменклатуры.Полуфабрикат);
	Типы.Добавить(Перечисления.ТипыНоменклатуры.Сырье);
	Возврат Типы;

КонецФункции

&НаКлиенте
Процедура ЗаполнитьПараметрыФормыПоУмолчанию()
	
	Если ИспользоватьПроизводство Тогда 
		НадписьТехнологическаяКарта = СтрШаблон(НСтр("ru = 'Для изготовления 1 %1 требуется сырья и полуфабрикатов:';
			|fr = 'Matières et produits semi-finis nécessaires pour fabriquer 1 %1 :';
			|en = 'Raw materials and semi-finished products required to produce 1 %1:';
			|es = 'Materias primas y productos semielaborados necesarios para fabricar 1 %1:'"), Объект.Единица);
	КонецЕсли;
	
	ЭтоПолуфабрикат = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Полуфабрикат");
	ЭтоПродукция 	= Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция");
	ЭтоКомплект 	= Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Комплект");

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	//Изображение = ПолучитьНавигационнуюСсылку(ТекущийОбъект.Ссылка, "Изображение");
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗаполнитьПараметрыФормыПоУмолчанию();
	// Изображения и присоединённые файлы товара берутся с диска компьютера: в веб-клиенте
	// это возможно только через расширение для работы с 1С:Предприятием.
	РасширениеРаботыС1СПредприятиемКлиент.Подключить(Неопределено,
		НСтр("ru = 'Для работы с изображениями и файлами товара установите расширение для работы с 1С:Предприятием.';
			|fr = 'Pour travailler avec les images et les fichiers de l''article, installez l''extension pour travailler avec 1C:Entreprise.';
			|en = 'To work with item images and files, install the 1C:Enterprise extension.';
			|es = 'Para trabajar con las imágenes y los archivos del artículo, instale la extensión para trabajar con 1C:Empresa.'"));
	УстановитьВидимостьЭлементов(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Не ПроверкаНаДубли() Тогда
		ТекстСообщения = НСтр("fr = 'Produit avec ce ID existe déjà !'; ru = 'Товар с таким артикулом уже существует!'; en = 'A product with such an article already exists!'; es = 'El producto con este artículo ya existe!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
		возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.НаименованиеПолное) Тогда
		Объект.НаименованиеПолное = Объект.Наименование;	
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
		Объект.Наименование = Объект.НаименованиеПолное;	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ПроверитьДатуТехкартыПередЗаписью(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	УправлениеСвойствами.ПеренестиЗначенияИзФормыВОбъект(ЭтотОбъект, ТекущийОбъект, Отказ);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ЗаписатьДополнительныеСведения(ЭтотОбъект, ТекущийОбъект.Ссылка);
	Если ЗначениеЗаполнено(Штрихкод) Тогда
		НЗ = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
		НЗ.Штрихкод = Штрихкод;
		НЗ.Номенклатура = Объект.Ссылка;
		НЗ.Записать(Истина);
	КонецЕсли;
	ШК = РегистрыСведений.ШтрихкодыНоменклатуры.ПолучитьШК(Объект.Ссылка);
	Если (ШК = "" или ШК<>Объект.Артикул) И ЗначениеЗаполнено(Объект.Артикул) Тогда
		НЗ = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
		НЗ.Штрихкод = Объект.Артикул;
		НЗ.Номенклатура = Объект.Ссылка;
		НЗ.Записать(Истина);
	КонецЕсли;
	//ШК = РегистрыСведений.ШтрихкодыНоменклатуры.ПолучитьШК(Объект.Ссылка);
	//Если ШК = "" Тогда
	//	НЗ = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
	//	НЗ.Штрихкод = РегистрыСведений.ШтрихкодыНоменклатуры.СформироватьEAN13();
	//	НЗ.Номенклатура = Объект.Ссылка;
	//	НЗ.Записать(Истина);
	//КонецЕсли;
	//Изображение = ПолучитьНавигационнуюСсылку(ТекущийОбъект.Ссылка, "Изображение");
	Если СохранитьЦены Тогда
		Если ДокУстановкаЦен = Документы.УстановкаЦенНоменклатурыВручную.ПустаяСсылка() Тогда 
			Док = Документы.УстановкаЦенНоменклатурыВручную.СоздатьДокумент();
			Док.Ответственный = ПараметрыСеанса.Пользователь;	
		Иначе
			Док = ДокУстановкаЦен.ПолучитьОбъект();
			Док.ТЧЦены.Очистить();
		КонецЕсли;
		Док.Номенклатура = Объект.Ссылка;
		Док.Дата = ТекущаяДатаСеанса();
		Для Каждого Стр из ТЗЦены Цикл 
			Если Стр.Цена = 0 Тогда Продолжить; КонецЕсли;
			НС = Док.ТЧЦены.Добавить();
			НС.ВидЦены = Стр.ВидЦены;
			НС.Цена = Стр.Цена;
		КонецЦикла;
		Док.Записать(РежимЗаписиДокумента.Проведение);
		ДокУстановкаЦен = Док.Ссылка;
	КонецЕсли;

	Если НужноЗаписатьТехкарту() Тогда
		ПредупредитьОЗаполненныхВыпусках();
		ДокументКарты = ТехнологическиеКарты.ЗаписатьТехкарту(Объект.Ссылка, ТЗТехкарта, ДействуетС);
		ЗаполнитьТехкартуНаСервере(ДокументКарты);
	Иначе
		ЗаполнитьТехкартуНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Для Каждого Стр из ТЗХранение Цикл
		МЗ = РегистрыСведений.МинимальныйОстатокПоСкладам.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ,Стр);
		МЗ.Активность = Истина;
		МЗ.Номенклатура = Объект.Ссылка;
		МЗ.Записать(Истина);
	КонецЦикла;
КонецПроцедуры


#КонецОбласти // Форма





#Область ПрограмныйИнтерфейс

&НаКлиенте
Процедура УстановитьВидимостьЭлементов() 
	
	Элементы.ГруппаИндивидуальныйНаборУпаковок.Видимость = Объект.ИспользоватьУпаковки;
	Элементы.ГруппаОбщийНаборУпаковок.Видимость = Объект.ИспользоватьУпаковки;
	Элементы.Единица.Доступность = Истина;
	
	Если ИспользованиеУпаковок = "ИндивидуальныйНабор" Тогда
		Элементы.НаборУпаковок.Видимость = Ложь;
		Элементы.ГиперссылкаПерейтиУпаковкиНабора.Видимость = Ложь;
		Элементы.ГиперссылкаПерейтиУпаковкиНоменклатуры.Видимость = Истина;		
	Иначе
		Элементы.НаборУпаковок.Видимость = Истина;
		Элементы.ГиперссылкаПерейтиУпаковкиНабора.Видимость = Истина;
		Элементы.ГиперссылкаПерейтиУпаковкиНоменклатуры.Видимость = Ложь;
		Если Объект.ИспользоватьУпаковки Тогда
			Элементы.Единица.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли; 
	
	Элементы.СтраницаТехкарта.Видимость = ЭтаФорма.ИспользоватьПроизводство И (ЭтоПолуфабрикат ИЛИ ЭтоПродукция);

	Элементы.ИсторияТехкарт.Доступность = ЗначениеЗаполнено(Объект.Ссылка);

	Элементы.СтраницаКомплект.Видимость = ЭтоКомплект;
	Элементы.СтраницаХранение.Видимость = Не ЭтоКомплект;
	Элементы.СоставКомплекта.ТолькоПросмотр = КомплектИспользован;

КонецПроцедуры

&НаКлиенте
Процедура ПослеДобавленияУдаленияКартинок(Результат, ДопПараметры) Экспорт
	ЗаполнитьКартинки();
КонецПроцедуры

&НаСервере
Процедура УстановитьЕдиницуНабораУпаковок()
	Если Объект.НаборУпаковок <> Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
		Объект.Единица = Объект.НаборУпаковок.Единица;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКартинки()
	НЗ = РегистрыСведений.ПрисоединённыеФайлы.СоздатьНаборЗаписей();
	НЗ.Отбор.Объект.Установить(Объект.Ссылка);
	НЗ.Прочитать();
	Изображения.Загрузить(НЗ.Выгрузить());
	Изображения.Сортировать("ДатаДобавления убыв");
	Если Изображения.Количество()>0 Тогда 
		НомерКартинки = 1;
	КонецЕсли;
	ЗаполнитьИзображениеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзображениеНаСервере()
	Если НомерКартинки > Изображения.Количество() Тогда
		НомерКартинки = Изображения.Количество();
	КонецЕсли;
	Если НомерКартинки = 0 Тогда
		Изображение = "";
		УстановитьДоступностьКнопокКартинки();
		Возврат;
	КонецЕсли;
	ID = Изображения.Получить(НомерКартинки-1).ID;
	КлючЗаписиРег = РегистрыСведений.ПрисоединённыеФайлы.СоздатьКлючЗаписи(Новый Структура("Объект,ID", Объект.Ссылка,ID));
	Если Не КлючЗаписиРег.Пустой() Тогда
		Изображение = ПолучитьНавигационнуюСсылку(КлючЗаписиРег, "Данные");
	КонецЕсли;
	УстановитьДоступностьКнопокКартинки();
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКнопокКартинки()
	Если НомерКартинки = 0 Тогда 
		Элементы.ИзображениеВлево.Доступность = Ложь;
		Элементы.ИзображениеВправо.Доступность = Ложь;
	Иначе
		Элементы.ИзображениеВлево.Доступность = НомерКартинки > 1;
		Элементы.ИзображениеВправо.Доступность = НомерКартинки < Изображения.Количество();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УдалитьИзображениеНаСервере(ID)
	КлючЗаписиРег = РегистрыСведений.ПрисоединённыеФайлы.СоздатьКлючЗаписи(Новый Структура("Объект,ID", Объект.Ссылка,ID));
	МасКлючей  = Новый Массив;
	МасКлючей.Добавить(КлючЗаписиРег);
	МасУдаляемыеФайлы = ПрисоединённыеФайлыВызовСервера.ПолучитьМассивУдаляемыхФайлов(МасКлючей);
	НЗ = РегистрыСведений.ПрисоединённыеФайлы.СоздатьНаборЗаписей();
	НЗ.Отбор.Объект.Установить(Объект.Ссылка);
	НЗ.Отбор.ID.Установить(ID);
	НЗ.Записать();
	ПрисоединённыеФайлыВызовСервера.УдалитьФайлыСДиска(МасУдаляемыеФайлы);
	ЗаполнитьКартинки();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМинОстаткиНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МестаХранения.Ссылка КАК МестоХранения,
	|	ЕСТЬNULL(МинимальныйОстатокПоСкладам.МаксимальноеКоличествоХранения, &МаксимальноеКоличествоХранения) КАК МаксимальноеКоличествоХранения,
	|	ЕСТЬNULL(МинимальныйОстатокПоСкладам.МинимальноеКоличествоХранения, &МинимальноеКоличествоХранения) КАК МинимальноеКоличествоХранения
	|ИЗ
	|	Справочник.МестаХранения КАК МестаХранения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальныйОстатокПоСкладам КАК МинимальныйОстатокПоСкладам
	|		ПО МестаХранения.Ссылка = МинимальныйОстатокПоСкладам.МестоХранения
	|			И (МинимальныйОстатокПоСкладам.Номенклатура = &Номенклатура
	|				И НЕ &Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))";
	Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);
	Запрос.УстановитьПараметр("МаксимальноеКоличествоХранения", Объект.МаксимальноеКоличествоХранения);
	Запрос.УстановитьПараметр("МинимальноеКоличествоХранения", Объект.МинимальноеКоличествоХранения);
	ТЗХранение.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКоличествоМинМакс(Команда)
	Для Каждого Стр из ТЗХранение Цикл
		Стр.МинимальноеКоличествоХранения = Объект.МинимальноеКоличествоХранения;
		Стр.МаксимальноеКоличествоХранения = Объект.МаксимальноеКоличествоХранения;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПроверкаНаДубли()
	Если Не ЗначениеЗаполнено(Объект.Артикул) Тогда 
		возврат истина;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &Артикул
	|	И Номенклатура.ЭтоГруппа = ЛОЖЬ
	|	И Не Номенклатура.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Артикул", Объект.Артикул);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Возврат Запрос.Выполнить().Пустой();
КонецФункции

&НаСервере
Процедура ЗаполнитьЦеныНаСервере()
	Запрос = Новый Запрос;
	Если Объект.Ссылка.Пустая() Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыЦен.Ссылка КАК ВидЦены
		|ИЗ
		|	Справочник.ВидыЦен КАК ВидыЦен
		|ГДЕ
		|	НЕ ВидыЦен.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Закупочная)
		|	И НЕ ВидыЦен.ПометкаУдаления";
	Иначе
		ТЗЦеныПоставщиков = РегистрыСведений.ЦеныНоменклатурыПоставщиков.СрезПоследних(,Новый Структура("Номенклатура",Объект.Ссылка));
		Если Не ТЗЦеныПоставщиков.Количество() = 0 Тогда
			ТЗЦеныПоставщиков.Сортировать("Период убыв");
			ЗакупочнаяЦена = ТЗЦеныПоставщиков.Получить(0).Цена;
		КонецЕсли;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыЦен.Ссылка КАК ВидЦены,
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ИЗ
		|	Справочник.ВидыЦен КАК ВидыЦен
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, Номенклатура = &Номенклатура) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО ВидыЦен.Ссылка = ЦеныНоменклатурыСрезПоследних.ВидЦены
		|ГДЕ
		|	НЕ ВидыЦен.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Закупочная)
		|	И НЕ ВидыЦен.ПометкаУдаления";
		Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);
	КонецЕсли;
	ТЗЦены.Загрузить(Запрос.Выполнить().Выгрузить());
	Для Каждого Стр из ТЗЦены Цикл 
		Стр.Наценка = ?(ЗакупочнаяЦена = 0,0, (Стр.Цена/ЗакупочнаяЦена-1)*100);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТехкартуНаСервере(ДокументКарты = Неопределено)

	ТЗТехкарта.Очистить();
	Если ДокументКарты = Неопределено Тогда
		Версия = ТехнологическиеКарты.ТекущиеТехкарты(Объект.Ссылка, КонецДня(ТекущаяДатаСеанса())).Получить(Объект.Ссылка);
		ДокументКарты = ?(Версия = Неопределено, Документы.ТехнологическаяКарта.ПустаяСсылка(), Версия.Версия);
	КонецЕсли;
	ВыбраннаяТехкарта = ДокументКарты;
	ИсходнаяТехкарта = ДокументКарты;
	Если ЗначениеЗаполнено(ДокументКарты) Тогда
		ТЗТехкарта.Загрузить(ТехнологическиеКарты.СоставТехкартыПоРегистратору(ДокументКарты));
		ДействуетС = НачалоДня(ДокументКарты.Дата);
	Иначе
		ДействуетС = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	РедактированиеТехкарты = Ложь;
	ДатаТехкартыВыбранаВручную = Ложь;
	ПредупреждениеВыпусковТехкарты = "";
	Элементы.ПредупреждениеВыпусковТехкарты.Видимость = Ложь;
	УстановитьНадписьВерсииТехкарты();
	ПересчитатьТехкартуНаСервере();

КонецПроцедуры

&НаСервере
Процедура НачатьРедактированиеТехкартыНаСервере()

	Если РедактированиеТехкарты Тогда
		Возврат;
	КонецЕсли;
	РедактированиеТехкарты = Истина;
	ДействуетС = НачалоДня(ТекущаяДатаСеанса());
	ПодобратьТехкартуПоДате();

КонецПроцедуры

// При ручном выборе другой существующей версии загружается её состав.
// При начале редактирования строки состав сохраняется: новую строку нельзя потерять.
//
// Параметры:
//  ЗагружатьСостав - Булево - ручной выбор даты.
//
&НаСервере
Процедура ПодобратьТехкартуПоДате(ЗагружатьСостав = Ложь)

	Проверка = ТехнологическиеКарты.ДатаРедактированияТехкарты(Объект.Ссылка, ДействуетС);
	ДействуетС = Проверка.Дата;
	Если Не Проверка.Допустима Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТехнологическиеКарты.ОшибкаДатыТехкарты(Проверка.ПоследняяДата));
	КонецЕсли;
	Если ЗагружатьСостав И ЗначениеЗаполнено(Проверка.Документ) И Проверка.Документ <> ВыбраннаяТехкарта Тогда
		ТЗТехкарта.Загрузить(ТехнологическиеКарты.СоставТехкартыПоРегистратору(Проверка.Документ));
		ИсходнаяТехкарта = Проверка.Документ;
	КонецЕсли;
	ВыбраннаяТехкарта = Проверка.Документ;
	УстановитьНадписьВерсииТехкарты();
	ПредупредитьОЗаполненныхВыпусках();

КонецПроцедуры

&НаСервере
Процедура УстановитьНадписьВерсииТехкарты()

	Элементы.ДокументТехкарты.Видимость = ЗначениеЗаполнено(ВыбраннаяТехкарта);

	Если Не ЗначениеЗаполнено(ВыбраннаяТехкарта) Тогда
		ВерсияТехкарты = НСтр("ru = 'Будет создана новая технологическая карта от';
			|fr = 'Une nouvelle gamme sera créée le'; en = 'A new production routing will be created for';
			|es = 'Se creará una nueva ruta de fabricación el'");
		Возврат;
	КонецЕсли;
	Номер = СокрЛП(ВыбраннаяТехкарта.Номер);
	Пока СтрДлина(Номер) > 1 И Лев(Номер, 1) = "0" Цикл
		Номер = Прав(Номер, СтрДлина(Номер) - 1);
	КонецЦикла;
	Если РедактированиеТехкарты Тогда
		Шаблон = НСтр("ru = 'Технологическая карта № %1 (редактируется) от';
			|fr = 'Gamme de fabrication n° %1 (en cours de modification) du';
			|en = 'Production routing No. %1 (editing) dated';
			|es = 'Ruta de fabricación n.º %1 (en edición) del'");
	Иначе
		Шаблон = НСтр("ru = 'Технологическая карта № %1 от'; fr = 'Gamme de fabrication n° %1 du';
			|en = 'Production routing No. %1 dated'; es = 'Ruta de fabricación n.º %1 del'");
	КонецЕсли;
	ВерсияТехкарты = СтрШаблон(Шаблон, Номер);

КонецПроцедуры

&НаСервере
Процедура ПредупредитьОЗаполненныхВыпусках()

	ПредупреждениеВыпусковТехкарты = "";
	Если РедактированиеТехкарты
		И ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Объект.Ссылка, ДействуетС) Тогда
		ПредупреждениеВыпусковТехкарты = НСтр("ru = 'С даты этой техкарты уже есть проведённые выпуски продукции. Перезаполните их вручную.';
			|fr = 'Des productions sont déjà validées depuis cette date. Remplissez-les à nouveau manuellement.';
			|en = 'Posted production issues exist from this date. Refill their materials manually.';
			|es = 'Ya existen producciones contabilizadas desde esta fecha. Vuelva a rellenar sus materiales manualmente.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПредупреждениеВыпусковТехкарты);
	КонецЕсли;
	Элементы.ПредупреждениеВыпусковТехкарты.Видимость = ПредупреждениеВыпусковТехкарты <> "";

КонецПроцедуры

// Сам вход в ячейку и отмена редактирования не создают карту нового дня.
//
// Возвращаемое значение:
//  Булево - состав изменён либо явно выбрана дата новой версии.
//
&НаСервере
Функция НужноЗаписатьТехкарту()

	Если Не РедактированиеТехкарты Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыбраннаяТехкарта) Тогда
		Возврат ТехнологическиеКарты.СоставОтличается(ВыбраннаяТехкарта, ТЗТехкарта);
	КонецЕсли;
	Возврат ТехнологическиеКарты.СоставОтличается(ИсходнаяТехкарта, ТЗТехкарта)
		Или (ДатаТехкартыВыбранаВручную И ТЗТехкарта.Количество() > 0);

КонецФункции

&НаСервере
Процедура ПроверитьДатуТехкартыПередЗаписью(Отказ)

	Если Не НужноЗаписатьТехкарту() Тогда
		Возврат;
	КонецЕсли;
	Проверка = ТехнологическиеКарты.ДатаРедактированияТехкарты(Объект.Ссылка, ДействуетС);
	Если Не Проверка.Допустима Тогда
		Отказ = Истина;
		ПодобратьТехкартуПоДате();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьТехкартуНаСервере()

	Состав = РеквизитФормыВЗначение("ТЗТехкарта");
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Объект.Ссылка, Состав);
	Для Индекс = 0 По ТЗТехкарта.Количество() - 1 Цикл
		ТЗТехкарта[Индекс].Цена = Показатели.Строки[Индекс].Цена;
		ТЗТехкарта[Индекс].Сумма = Показатели.Строки[Индекс].Сумма;
	КонецЦикла;
	ИтогоКоличествоТехкарты = Состав.Итог("Количество");
	ИтогоСуммаТехкарты = Показатели.Себестоимость;
	ОбновитьСтатистикуТехкарты(Показатели);

КонецПроцедуры

// Нулевые показатели скрываются; отрицательная маржа остаётся видимой.
//
// Параметры:
//  Показатели - Структура - см. ТехнологическиеКарты.ПоказателиТехкарты.
//
&НаСервере
Процедура ОбновитьСтатистикуТехкарты(Показатели)

	ФорматСуммы = "ЧДЦ=2";
	ШаблонСебестоимости = НСтр("ru = 'Плановая себестоимость 1 %1: %2 %3';
		|fr = 'Coût prévisionnel pour 1 %1 : %2 %3'; en = 'Planned cost per 1 %1: %2 %3';
		|es = 'Coste previsto por 1 %1: %2 %3'");
	ПлановаяСебестоимостьТехкарты = СтрШаблон(ШаблонСебестоимости,
		Объект.Единица, Формат(Показатели.Себестоимость, ФорматСуммы), Показатели.Валюта);
	ШаблонВыпуска = НСтр("ru = 'Можно произвести из остатков: %1 %2';
		|fr = 'Production possible avec le stock : %1 %2'; en = 'Can produce from stock: %1 %2';
		|es = 'Producción posible con existencias: %1 %2'");
	ДоступныйВыпускТехкарты = СтрШаблон(ШаблонВыпуска, Формат(Показатели.МожноПроизвести, "ЧДЦ=3"), Объект.Единица);
	ШаблонМаржи = НСтр("ru = 'Потенциальная маржа всего выпуска: %1 %2 (продажа по %3 %2)';
		|fr = 'Marge potentielle totale : %1 %2 (vente à %3 %2)';
		|en = 'Potential margin for all output: %1 %2 (selling at %3 %2)';
		|es = 'Margen potencial de toda la producción: %1 %2 (venta a %3 %2)'");
	ПотенциальнаяМаржаТехкарты = СтрШаблон(ШаблонМаржи,
		Формат(Показатели.ПотенциальнаяМаржа, ФорматСуммы), Показатели.Валюта, Формат(Показатели.ЦенаПродажи, ФорматСуммы));
	ПредупреждениеЦенТехкарты = НСтр("ru = 'Для части материалов нет закупочной цены. Себестоимость и маржа не рассчитаны.';
		|fr = 'Le prix d’achat manque pour certaines matières. Le coût et la marge ne sont pas calculés.';
		|en = 'Some materials have no purchase price. Cost and margin have not been calculated.';
		|es = 'Falta el precio de compra de algunos materiales. No se han calculado el coste ni el margen.'");
	Элементы.ПлановаяСебестоимостьТехкарты.Видимость = Показатели.Себестоимость <> 0;
	Элементы.ДоступныйВыпускТехкарты.Видимость = Показатели.МожноПроизвести <> 0;
	Элементы.ПотенциальнаяМаржаТехкарты.Видимость = Показатели.ПотенциальнаяМаржа <> 0;
	Элементы.ПредупреждениеЦенТехкарты.Видимость = Не Показатели.ВсеЦеныЕсть;

КонецПроцедуры

#КонецОбласти // ПрограммныйИнтерфейс  



#Область ЭлементыФормы

&НаКлиенте
Процедура ВидПриИзменении(Элемент)
	
	ЗаполнитьПараметрыФормыПоУмолчанию();
	УстановитьВидимостьЭлементов();     
	
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеНажатие(Элемент, СтандартнаяОбработка)
	//РаботаСДокументамиКлиент.ЗаписатьЕслиНовый(ЭтаФорма);
	//Если Объект.Ссылка.Пустая() Тогда 
	//	Отказ = Истина;
	//КонецЕсли;
	//ПрисоединённыеФайлыКлиент.ВыбратьИзображение(ЭтаФорма, "Изображение", СтандартнаяОбработка);
	СтандартнаяОбработка = Ложь;
	Фильтр = "Все картинки (*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.png)|*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.png|" 
				+ "BMP (*.bmp;*.dib;*.rle)|*.bmp;*.dib;*.rle|"
				+ "JPEG (*.jpg;*.jpeg)|*.jpg;*.jpeg|"
				+ "TIFF (*.tif)|*.tif|"
				+ "PNG (*.png)|*.png|";
	Оп = Новый ОписаниеОповещения("ПослеДобавленияУдаленияКартинок",ЭтаФорма);
	ПрисоединённыеФайлыКлиент.ПрисоединитьФайлы(Объект.Ссылка,,Фильтр,Оп);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзображение(Команда)
	//ПрисоединённыеФайлыКлиент.УдалитьИзображение(ЭтаФорма, Изображение);
	Если НомерКартинки = 0 Тогда
		Возврат;
	КонецЕсли;
	СтрКартинки = Изображения.Получить(НомерКартинки-1);
	Если СтрКартинки = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	ID = СтрКартинки.ID;
	УдалитьИзображениеНаСервере(ID);
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьУпаковкиПриИзменении(Элемент)
	Если Объект.ИспользоватьУпаковки Тогда
		ИспользованиеУпаковок = "ИндивидуальныйНабор";
		ИспользованиеУпаковокИндивидуальныйНаборПриИзменении(Элемент);
	Иначе
		Объект.НаборУпаковок = Неопределено;
		УстановитьВидимостьЭлементов();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользованиеУпаковокИндивидуальныйНаборПриИзменении(Элемент)
	Объект.НаборУпаковок = ПредопределенноеЗначение("Справочник.НаборыУпаковок.ИндивидуальныйДляНоменклатуры");
	УстановитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ИспользованиеУпаковокОбщийНаборПриИзменении(Элемент)
	Объект.НаборУпаковок = Неопределено;
	УстановитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаПерейтиУпаковкиНоменклатурыНажатие(Элемент)
	РаботаСДокументамиКлиент.ЗаписатьЕслиНовый(ЭтаФорма, Истина);
	Отбор = Новый Структура;
	Отбор.Вставить("Владелец", Объект.Ссылка);
	Отбор.Вставить("ТипИзмеряемойВеличины", ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Упаковка"));
	П = Новый Структура("Отбор", Отбор);
	ОткрытьФорму("Справочник.УпаковкиЕдиницыИзмерения.ФормаСписка", П,, ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаПерейтиУпаковкиНабораНажатие(Элемент)
	РаботаСДокументамиКлиент.ЗаписатьЕслиНовый(ЭтаФорма, Истина);
	Отбор = Новый Структура;
	Отбор.Вставить("Владелец", Объект.НаборУпаковок);
	Отбор.Вставить("ТипИзмеряемойВеличины", ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Упаковка"));
	П = Новый Структура("Отбор", Отбор);
	ОткрытьФорму("Справочник.УпаковкиЕдиницыИзмерения.ФормаСписка", П,, ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура НаборУпаковокПриИзменении(Элемент)
	УстановитьЕдиницуНабораУпаковок();
	УстановитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеВправо(Команда)
	НомерКартинки = НомерКартинки + 1;
	ЗаполнитьИзображениеНаСервере();
КонецПроцедуры

&НаКлиенте
