
#Область ОписаниеПеременных

// Разрядность и точность поля ввода количества: в сеансе не меняются, читаются с сервера один раз.
&НаКлиенте
Перем ФорматКоличества;

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Отбор подбора по назначению: массовый подбор в заказе на производство предлагает только готовую
// продукцию и полуфабрикаты - те же типы, что и колонка «Номенклатура» товаров (S7). Без параметра
// подбор работает как раньше, по всей номенклатуре.
//
// Параметры:
//  Отказ                - Булево - не используется.
//  СтандартнаяОбработка - Булево - не используется.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Назначение = "";
	Если Не Параметры.Свойство("НазначениеПодбора", Назначение) Или ПустаяСтрока(Назначение) Тогда
		Возврат;
	КонецЕсли;
	Типы = Новый Массив(Справочники.Номенклатура.ТипыПодбора(Назначение));
	Список.Параметры.УстановитьЗначениеПараметра("ТипыНоменклатуры", Типы);
	Список.Параметры.УстановитьЗначениеПараметра("ТипыНоменклатурыУстановлены", Истина);
	// У групп тип не заполнен: в иерархическом виде отбор спрятал бы их вместе с содержимым.
	Элементы.Список.Отображение = ОтображениеТаблицы.Список;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные = Неопределено Или ТекДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	// Товар с характеристиками учитывается по ним: сначала выбор характеристики, потом количество.
	СЗХарактеристики = ХарактеристикиТовара(ВыбраннаяСтрока);
	Если СЗХарактеристики.Количество() = 0 Тогда
		ЗапроситьКоличество(Новый Структура("Товар", ВыбраннаяСтрока));
	Иначе
		Оп = Новый ОписаниеОповещения("ПослеВыбораХарактеристики", ЭтотОбъект, Новый Структура("Товар", ВыбраннаяСтрока));
		Заголовок = НСтр("ru = 'Выберите характеристику'; fr = 'Sélectionnez la caractéristique';
			|en = 'Select the characteristic'; es = 'Seleccione la característica'");
		СЗХарактеристики.ПоказатьВыборЭлемента(Оп, Заголовок);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораХарактеристики(ВыбранныйЭлемент, ДопПараметры) Экспорт
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДопПараметры.Вставить("Характеристика", ВыбранныйЭлемент.Значение);
	ЗапроситьКоличество(ДопПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьКоличество(ДопПараметры)
	Оп = Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект, ДопПараметры);
	Подсказка = НСтр("ru = 'Введите количество'; fr = 'Saisissez la quantité';
		|en = 'Enter the quantity'; es = 'Introduzca la cantidad'");
	Если ФорматКоличества = Неопределено Тогда
		ФорматКоличества = ФорматКоличестваПодбора();
	КонецЕсли;
	ПоказатьВводЧисла(Оп, 1, Подсказка, ФорматКоличества.Разрядность, ФорматКоличества.Точность);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКоличества(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Или Результат <= 0 Тогда
		Возврат;
	КонецЕсли;
	Структура = Новый Структура("Номенклатура, Количество", ДопПараметры.Товар, Результат);
	Если ДопПараметры.Свойство("Характеристика") Тогда
		Структура.Вставить("Характеристика", ДопПараметры.Характеристика);
	КонецЕсли;
	ОповеститьОВыборе(Структура);
	ТекущийЭлемент = Элементы.Список;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ФорматКоличестваПодбора()
	// Разрядность и точность поля ввода количества берутся у определяемого типа, в который подбор
	// это количество и положит. Литералами они здесь были потому, что на клиенте Метаданные
	// недоступны, - и разошлись с типом: стояла разрядность 15 при типе Число(12,3).
	Квалификаторы = Метаданные.ОпределяемыеТипы.КоличествоНеотрицательное.Тип.КвалификаторыЧисла;
	Результат = Новый Структура("Разрядность, Точность");
	Результат.Разрядность = Квалификаторы.Разрядность;
	Результат.Точность = Квалификаторы.РазрядностьДробнойЧасти;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ХарактеристикиТовара(Знач Товар)
	// Характеристики товара для выбора при подборе (по образцу автоподбора:
	// без помеченных на удаление и внутренних); пустой список - подбор без характеристики.
	СЗ = Новый СписокЗначений;
	Если Не Константы.ИспользоватьХарактеристикиНоменклатуры.Получить() Тогда
		Возврат СЗ;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Владелец = &Товар
	|	И НЕ ХарактеристикиНоменклатуры.ПометкаУдаления
	|	И НЕ ХарактеристикиНоменклатуры.ДляВнутреннегоИспользования
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХарактеристикиНоменклатуры.Наименование";
	Запрос.УстановитьПараметр("Товар", Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СЗ.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат СЗ;
КонецФункции

#КонецОбласти
