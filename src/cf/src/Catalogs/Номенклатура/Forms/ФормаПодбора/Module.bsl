
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные = Неопределено Или ТекДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	Оп = Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект, Новый Структура("Товар", ВыбраннаяСтрока));
	Подсказка = НСтр("ru = 'Введите количество'; fr = 'Saisissez la quantité';
		|en = 'Enter the quantity'; es = 'Introduzca la cantidad'");
	Разрядность = РазрядностьКоличества();
	Точность = ТочностьКоличества();
	ПоказатьВводЧисла(Оп, 1, Подсказка, Разрядность, Точность);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКоличества(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Или Результат <= 0 Тогда
		Возврат;
	КонецЕсли;
	Структура = Новый Структура("Номенклатура, Количество", ДопПараметры.Товар, Результат);
	ОповеститьОВыборе(Структура);
	ТекущийЭлемент = Элементы.Список;
КонецПроцедуры

&НаКлиенте
Функция РазрядностьКоличества()
	Возврат 15;
КонецФункции

&НаКлиенте
Функция ТочностьКоличества()
	Возврат 3;
КонецФункции

#КонецОбласти
