
#Область ОписаниеПеременных

// Разрядность и точность поля ввода количества: в сеансе не меняются, читаются с сервера один раз.
&НаКлиенте
Перем ФорматКоличества;

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Отбор подбора по назначению: массовый подбор в заказе на производство предлагает только готовую
// продукцию и полуфабрикаты - те же типы, что и колонка «Номенклатура» товаров (S7). Без параметра
// подбор работает как раньше, по всей номенклатуре.
//
// Параметры:
//  Отказ                - Булево - не используется.
//  СтандартнаяОбработка - Булево - не используется.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НавигаторНоменклатуры.ПриСозданииНаСервере(ЭтотОбъект, Истина);
	ПрименитьРежимИерархии();

КонецПроцедуры

// Возвращаемое значение:
//  Структура - см. Справочники.Номенклатура.НовыйКонтекстСписка: типы назначения подбора, если оно задано
//
&НаСервере
Функция КонтекстСписка()

	Контекст = Справочники.Номенклатура.НовыйКонтекстСписка();
	Контекст.ДляВыбора = Истина;
	Назначение = "";
	Если Параметры.Свойство("НазначениеПодбора", Назначение) И Не ПустаяСтрока(Назначение) Тогда
		Для Каждого Тип Из Справочники.Номенклатура.ТипыПодбора(Назначение) Цикл
			Контекст.Типы.Добавить(Тип);
		КонецЦикла;
	КонецЕсли;
	Возврат Контекст;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	// ЭтоГруппа запрос списка выбирает, но колонкой оно не выведено - значит, в ТекущиеДанные
	// его нет и обращение к нему падает («Поле объекта не обнаружено»); скрытая колонка не
	// помогает. Ключ строки - сама ссылка, признак группы и характеристики берутся по нему
	// одним вызовом сервера.
	Если ТипЗнч(ВыбраннаяСтрока) <> Тип("СправочникСсылка.Номенклатура")
		Или Не ЗначениеЗаполнено(ВыбраннаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	ДанныеТовара = ДанныеТовараПодбора(ВыбраннаяСтрока);
	// Стандартную обработку глушим только для товара. У группы она нужна: список показан
	// иерархически, и внутрь папки пользователь заходит именно двойным щелчком по ней.
	Если ДанныеТовара.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	// Товар с характеристиками учитывается по ним: сначала выбор характеристики, потом количество.
	СЗХарактеристики = ДанныеТовара.Характеристики;
	Если СЗХарактеристики.Количество() = 0 Тогда
		ЗапроситьКоличество(Новый Структура("Товар", ВыбраннаяСтрока));
	Иначе
		Оп = Новый ОписаниеОповещения("ПослеВыбораХарактеристики", ЭтотОбъект, Новый Структура("Товар", ВыбраннаяСтрока));
		Заголовок = НСтр("ru = 'Выберите характеристику'; fr = 'Sélectionnez la caractéristique';
			|en = 'Select the characteristic'; es = 'Seleccione la característica'");
		СЗХарактеристики.ПоказатьВыборЭлемента(Оп, Заголовок);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораХарактеристики(ВыбранныйЭлемент, ДопПараметры) Экспорт
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДопПараметры.Вставить("Характеристика", ВыбранныйЭлемент.Значение);
	ЗапроситьКоличество(ДопПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьКоличество(ДопПараметры)
	Оп = Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект, ДопПараметры);
	Подсказка = НСтр("ru = 'Введите количество'; fr = 'Saisissez la quantité';
		|en = 'Enter the quantity'; es = 'Introduzca la cantidad'");
	Если ФорматКоличества = Неопределено Тогда
		ФорматКоличества = ФорматКоличестваПодбора();
	КонецЕсли;
	ПоказатьВводЧисла(Оп, 1, Подсказка, ФорматКоличества.Разрядность, ФорматКоличества.Точность);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКоличества(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Или Результат <= 0 Тогда
		Возврат;
	КонецЕсли;
	Структура = Новый Структура("Номенклатура, Количество", ДопПараметры.Товар, Результат);
	Если ДопПараметры.Свойство("Характеристика") Тогда
		Структура.Вставить("Характеристика", ДопПараметры.Характеристика);
	КонецЕсли;
	ОповеститьОВыборе(Структура);
	ТекущийЭлемент = Элементы.Список;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ФорматКоличестваПодбора()
	// Разрядность и точность поля ввода количества берутся у определяемого типа, в который подбор
	// это количество и положит. Литералами они здесь были потому, что на клиенте Метаданные
	// недоступны, - и разошлись с типом: стояла разрядность 15 при типе Число(12,3).
	Квалификаторы = Метаданные.ОпределяемыеТипы.КоличествоНеотрицательное.Тип.КвалификаторыЧисла;
	Результат = Новый Структура("Разрядность, Точность");
	Результат.Разрядность = Квалификаторы.Разрядность;
	Результат.Точность = Квалификаторы.РазрядностьДробнойЧасти;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеТовараПодбора(Знач Товар)
	// Всё, что подбору нужно знать о строке списка, но чего нет в ТекущиеДанные: признак группы
	// и характеристики товара. Возвращает структуру с полями ЭтоГруппа (Булево) и Характеристики
	// (СписокЗначений, см. ХарактеристикиТовара).
	Результат = Новый Структура("ЭтоГруппа, Характеристики");
	Результат.ЭтоГруппа = Товар.ЭтоГруппа;
	Если Результат.ЭтоГруппа Тогда
		Результат.Характеристики = Новый СписокЗначений;
	Иначе
		Результат.Характеристики = ХарактеристикиТовара(Товар);
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ХарактеристикиТовара(Знач Товар)
	// Характеристики товара для выбора при подборе (по образцу автоподбора:
	// без помеченных на удаление и внутренних); пустой список - подбор без характеристики.
	СЗ = Новый СписокЗначений;
	Если Не Константы.ИспользоватьХарактеристикиНоменклатуры.Получить() Тогда
		Возврат СЗ;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Владелец = &Товар
	|	И НЕ ХарактеристикиНоменклатуры.ПометкаУдаления
	|	И НЕ ХарактеристикиНоменклатуры.ДляВнутреннегоИспользования
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХарактеристикиНоменклатуры.Наименование";
	Запрос.УстановитьПараметр("Товар", Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СЗ.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат СЗ;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Навигатор иерархии - как в форме списка товаров (НавигаторНоменклатуры); панели фильтров у формы нет, помеченные на
// удаление в счётчиках учитываются, как в самом списке.
//

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	ПрименитьРежимИерархии();

КонецПроцедуры

&НаКлиенте
Процедура РежимИерархииПриИзменении(Элемент)

	ВидУзла = 0;
	ЗначениеУзла = Неопределено;
	ПрименитьРежимИерархии();

КонецПроцедуры

&НаКлиенте
Процедура УзлыИерархииПриАктивизацииСтроки(Элемент)

	// BSLLS:MagicNumber-off - пятая доля секунды: листание узлов стрелками не дёргает сервер на каждый узел.
	ПодключитьОбработчикОжидания("Подключаемый_ВыбратьУзел", 0.2, Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыбратьУзел()

	Узел = Элементы.УзлыИерархии.ТекущиеДанные;
	Если Узел = Неопределено Или Узел.Вид = ВидУзла И Узел.Значение = ЗначениеУзла Тогда
		Возврат;
	КонецЕсли;
	ВидУзла = Узел.Вид;
	ЗначениеУзла = Узел.Значение;
	ВыбратьУзелНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ИзбранныйРежим(Команда)

	ИзбранныйРежимНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИерархию(Команда)

	ПрименитьРежимИерархии();

КонецПроцедуры

&НаСервере
Процедура ПрименитьРежимИерархии()

	НавигаторНоменклатуры.ПрименитьРежим(ЭтотОбъект, КонтекстСписка(), ОтборыНавигатора());
	ПараметрыЗапроса = Справочники.Номенклатура.ПараметрыЗапросаСписка(КонтекстСписка(), ОтборыНавигатора(),
		РежимИерархии);
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Список.Параметры.УстановитьЗначениеПараметра(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	НавигаторНоменклатуры.УстановитьОтображение(ЭтотОбъект, КонтекстСписка().Типы.Количество() > 0);

КонецПроцедуры

&НаСервере
Процедура ИзбранныйРежимНаСервере()

	НавигаторНоменклатуры.ПереключитьИзбранныйРежим(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ВыбратьУзелНаСервере()

	НавигаторНоменклатуры.ВыбратьУзел(ЭтотОбъект);

КонецПроцедуры

// Возвращаемое значение:
//  Структура - см. Справочники.Номенклатура.НовыеОтборыПанели: без фильтров, помеченные на удаление - как в списке
//
&НаСервере
Функция ОтборыНавигатора()

	Отборы = Справочники.Номенклатура.НовыеОтборыПанели();
	Отборы.ПоказыватьПомеченные = Истина;
	Возврат Отборы;

КонецФункции

#КонецОбласти
