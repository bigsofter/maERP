
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Запрос списка - из модуля менеджера: тот же текст компонует сценарий СписокНоменклатуры.
	Список.ТекстЗапроса = Справочники.Номенклатура.ТекстЗапросаСписка();
	УстановитьЗаголовок();
	НастроитьФильтры();
	ОтборСклад = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	РежимИерархии = Справочники.Номенклатура.РежимПапки();
	НастроитьФорму();
	ПрименитьРежимИерархии();

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	// Сохранённые фильтры панели, режим и узел иерархии восстановлены после ПриСозданииНаСервере - отбор строится заново.
	СброситьНедоступныеПозиции();
	НастроитьЗначениеСвойства();
	ПрименитьРежимИерархии();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОперацииСПодключаемымОборудованиемКлиент.ПодключитьОборудование(УникальныйИдентификатор, Истина);
	ПрименитьСостояниеПанели();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ScanData" И ВводДоступен() Тогда
		Штрихкод = ОперацииСПодключаемымОборудованиемКлиент.ПолучитьШтрихкод(ИмяСобытия, Параметр, Источник);
		СтруктураТовара = ОбщегоНазначенияВызовСервера.ПолучитьНоменклатуруПоШтрихкоду(Штрихкод);
		Если СтруктураТовара <> Неопределено И ЗначениеЗаполнено(СтруктураТовара.Номенклатура) Тогда
			Элементы.Список.ТекущаяСтрока = СтруктураТовара.Номенклатура;
			ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", Новый Структура("Ключ", СтруктураТовара.Номенклатура));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ФильтрПанелиПриИзменении(Элемент)

	ПрименитьОтборы();
	// Отбор мог оставить список пустым или сменить текущую строку - сведения перечитываются отложенно.
	СписокПриАктивизацииСтроки(Элементы.Список);

КонецПроцедуры

&НаКлиенте
Процедура ОтборСвойствоПриИзменении(Элемент)

	ОтборСвойствоПриИзмененииНаСервере();
	СписокПриАктивизацииСтроки(Элементы.Список);

КонецПроцедуры

&НаКлиенте
Процедура РежимИерархииПриИзменении(Элемент)

	ВидУзла = 0;
	ЗначениеУзла = Неопределено;
	ПрименитьРежимИерархии();
	СписокПриАктивизацииСтроки(Элементы.Список);

КонецПроцедуры

&НаКлиенте
Процедура УзлыИерархииПриАктивизацииСтроки(Элемент)

	// BSLLS:MagicNumber-off - пятая доля секунды: листание узлов стрелками не дёргает сервер на каждый узел.
	ПодключитьОбработчикОжидания("Подключаемый_ВыбратьУзел", 0.2, Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыбратьУзел()

	Узел = Элементы.УзлыИерархии.ТекущиеДанные;
	Если Узел = Неопределено Или Узел.Вид = ВидУзла И Узел.Значение = ЗначениеУзла Тогда
		Возврат;
	КонецЕсли;
	ВидУзла = Узел.Вид;
	ЗначениеУзла = Узел.Значение;
	ВыбратьУзелНаСервере();
	СписокПриАктивизацииСтроки(Элементы.Список);

КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	// Отложенно: при листании стрелками не дёргать сервер на каждую строку.
	// BSLLS:MagicNumber-off - треть секунды, константа имени не добавит.
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьСведения", 0.3, Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьСведения()

	Если ПанельСвернута Тогда
		Возврат;
	КонецЕсли;
	Ссылка = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.Номенклатура") Тогда
		// Нет текущей строки - сведения прежнего товара не остаются в панели.
		ТоварТекст = "";
		ДвижениеТекст = "";
		ОстаткиПоСкладам.Очистить();
		Возврат;
	КонецЕсли;
	ЗаполнитьСведения(Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СвернутьПанель(Команда)

	ПанельСвернута = Истина;
	ПрименитьСостояниеПанели();

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьПанель(Команда)

	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();
	Подключаемый_ОбновитьСведения();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФильтры(Команда)

	ОткрытьСтраницуПанели("СтраницаФильтры");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТовар(Команда)

	ОткрытьСтраницуПанели("СтраницаТовар");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДвижение(Команда)

	ОткрытьСтраницуПанели("СтраницаДвижение");

КонецПроцедуры

&НаКлиенте
Процедура ИзбранныйРежим(Команда)

	ИзбранныйРежимНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИерархию(Команда)

	ПрименитьРежимИерархии();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Панель

// Свёрнутая панель - столбик значков, развёрнутая - закладки со страницами.
//
&НаКлиенте
Процедура ПрименитьСостояниеПанели()

	Элементы.ГруппаПанельЗначки.Видимость = ПанельСвернута;
	Элементы.ГруппаПодвалПанели.Видимость = Не ПанельСвернута;
	Элементы.ГруппаСтраницыСведений.Видимость = Не ПанельСвернута;

КонецПроцедуры

// Разворачивает панель и активирует страницу по имени.
//
// Параметры:
//  ИмяСтраницы - Строка - имя страницы панели сведений
//
&НаКлиенте
Процедура ОткрытьСтраницуПанели(ИмяСтраницы)

	Свернута = ПанельСвернута;
	ПанельСвернута = Ложь;
	ПрименитьСостояниеПанели();
	Элементы.ГруппаСтраницыСведений.ТекущаяСтраница = Элементы[ИмяСтраницы];
	Если Свернута Тогда
		Подключаемый_ОбновитьСведения();
	КонецЕсли;

КонецПроцедуры

// Сведения о текущем товаре для закладок «Товар» и «Движение».
//
// Параметры:
//  Ссылка - СправочникСсылка.Номенклатура - текущая строка списка
//
&НаСервере
Процедура ЗаполнитьСведения(Знач Ссылка)

	Сведения = Справочники.Номенклатура.СведенияДляПанели(Ссылка);
	ТоварТекст = Сведения.ТоварТекст;
	ДвижениеТекст = Сведения.ДвижениеТекст;
	ОстаткиПоСкладам.Загрузить(Сведения.Остатки);

КонецПроцедуры

#КонецОбласти

#Область Отборы

// Фильтры панели - в параметры запроса и группу «Панель» отбора списка (ОтборыСписков); счётчики навигатора
// пересчитываются тем же вызовом (ревью плана Codex, P2): они учитывают фильтры панели.
//
&НаСервере
Процедура ПрименитьОтборы()

	Отборы = ОтборыПанели();
	ПараметрыЗапроса = Справочники.Номенклатура.ПараметрыЗапросаСписка(КонтекстСписка(), Отборы, РежимИерархии);
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Список.Параметры.УстановитьЗначениеПараметра(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	ЕстьОтбор = Справочники.Номенклатура.УстановитьОтборыПанели(Список.Отбор, Отборы);
	Плоский = ЕстьОтбор Или Справочники.Номенклатура.ПолеРежимаИерархии(РежимИерархии) <> "";
	Элементы.Список.Отображение = ?(Плоский, ОтображениеТаблицы.Список, ОтображениеТаблицы.ИерархическийСписок);
	ОбновитьУзлы();

КонецПроцедуры

// Возвращаемое значение:
//  Структура - см. Справочники.Номенклатура.НовыйКонтекстСписка
//
&НаСервере
Функция КонтекстСписка()

	Контекст = Справочники.Номенклатура.НовыйКонтекстСписка();
	Контекст.ТолькоЗакупаемые = Параметры.ТолькоЗакупаемые;
	Контекст.ТолькоПродаваемые = Параметры.ТолькоПродаваемые;
	Контекст.ТолькоТовары = Параметры.ТолькоТовары;
	Если ЗначениеЗаполнено(Параметры.ОтборТипа) Тогда
		Контекст.ОтборТипа = Параметры.ОтборТипа;
	КонецЕсли;
	Возврат Контекст;

КонецФункции

// Фильтры панели из реквизитов формы; позиции тумблеров «Тип» и «Пополнение» - порядок значений перечислений.
//
// Возвращаемое значение:
//  Структура - см. Справочники.Номенклатура.НовыеОтборыПанели
//
&НаСервере
Функция ОтборыПанели()

	Отборы = Справочники.Номенклатура.НовыеОтборыПанели();
	Если ФильтрТип > 0 Тогда
		Отборы.Тип = Перечисления.ТипыНоменклатуры.Получить(ФильтрТип - 1);
	КонецЕсли;
	Если ФильтрПополнение > 0 Тогда
		Отборы.Пополнение = Перечисления.СпособыПополненияЗапасов.Получить(ФильтрПополнение - 1);
	КонецЕсли;
	Отборы.Наличие = ФильтрНаличие;
	Отборы.Склад = ОтборСклад;
	Отборы.ТоварнаяГруппа = ОтборТоварнаяГруппа;
	Отборы.Бренд = ОтборБренд;
	Отборы.ОсновнойПоставщик = ОтборПоставщик;
	Отборы.Качество = ОтборКачество;
	Отборы.ПоказыватьПомеченные = ПоказыватьПомеченные;
	Отборы.Свойство = ОтборСвойство;
	Отборы.ЗначениеСвойства = ОтборЗначенияСвойства;
	Возврат Отборы;

КонецФункции

// Поле значения свойства принимает только тип выбранного свойства; без свойства - недоступно.
//
&НаСервере
Процедура ОтборСвойствоПриИзмененииНаСервере()

	ОтборЗначенияСвойства = Неопределено;
	НастроитьЗначениеСвойства();
	ПрименитьОтборы();

КонецПроцедуры

&НаСервере
Процедура НастроитьЗначениеСвойства()

	Поле = Элементы.ОтборЗначенияСвойства;
	Поле.Доступность = ЗначениеЗаполнено(ОтборСвойство);
	Если Не ЗначениеЗаполнено(ОтборСвойство) Тогда
		ОтборЗначенияСвойства = Неопределено;
		Возврат;
	КонецЕсли;
	Тип = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборСвойство, "ТипЗначения");
	Поле.ОграничениеТипа = Тип;
	// Значения-элементы - только этого свойства (владелец справочника значений). Свойство с типом «Контрагент» или
	// «Номенклатура» владельца нет - отбор не ставится.
	ПараметрыВыбора = Новый Массив;
	Если Тип.Типы().Количество() = 1 И Тип.СодержитТип(Тип("СправочникСсылка.ЗначенияДополнительныхРеквизитов")) Тогда
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ОтборСвойство));
	КонецЕсли;
	Поле.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
	// Не введённое значение остаётся Неопределено: приведение дало бы 0 или Ложь - и сразу отбор по нему.
	Если ОтборЗначенияСвойства <> Неопределено Тогда
		ОтборЗначенияСвойства = Тип.ПривестиЗначение(ОтборЗначенияСвойства);
	КонецЕсли;

КонецПроцедуры

// Позиции тумблеров по опциям: без производства - нет продукции, полуфабриката, сырья и фильтра пополнения, без
// комплектации - нет комплекта. Значения опций на клиенте недоступны (tiny1C bsl-009) - только здесь.
//
&НаСервере
Процедура НастроитьФильтры()

	ИспользуетсяПроизводство = ПолучитьФункциональнуюОпцию("Производство");
	Элементы.ФильтрПополнение.Видимость = ИспользуетсяПроизводство;
	Убрать = Новый Массив;
	Если Не ИспользуетсяПроизводство Тогда
		Убрать.Добавить(Перечисления.ТипыНоменклатуры.Продукция);
		Убрать.Добавить(Перечисления.ТипыНоменклатуры.Полуфабрикат);
		Убрать.Добавить(Перечисления.ТипыНоменклатуры.Сырье);
	КонецЕсли;
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьКомплектацию") Тогда
		Убрать.Добавить(Перечисления.ТипыНоменклатуры.Комплект);
	КонецЕсли;
	СписокТипов = Элементы.ФильтрТип.СписокВыбора;
	Для Каждого Тип Из Убрать Цикл
		Позиция = СписокТипов.НайтиПоЗначению(Перечисления.ТипыНоменклатуры.Индекс(Тип) + 1);
		Если Позиция <> Неопределено Тогда
			СписокТипов.Удалить(Позиция);
		КонецЕсли;
	КонецЦикла;
	НастроитьЗначениеСвойства();

КонецПроцедуры

// Сохранённая позиция, которой больше нет в тумблере (опцию выключили), сбрасывается на «Все».
//
&НаСервере
Процедура СброситьНедоступныеПозиции()

	Если Элементы.ФильтрТип.СписокВыбора.НайтиПоЗначению(ФильтрТип) = Неопределено Тогда
		ФильтрТип = 0;
	КонецЕсли;
	Если Не Элементы.ФильтрПополнение.Видимость Тогда
		ФильтрПополнение = 0;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Иерархия

// Режим иерархии: список режимов (избранные первыми), видимость навигатора, отборы и узлы. Режима, которого больше
// нет (свойство удалено, производство выключено), - «Папки».
//
&НаСервере
Процедура ПрименитьРежимИерархии()

	Режимы = Справочники.Номенклатура.РежимыИерархии();
	Если Режимы.НайтиПоЗначению(РежимИерархии) = Неопределено Тогда
		РежимИерархии = Справочники.Номенклатура.РежимПапки();
		ВидУзла = 0;
	КонецЕсли;
	ЗаполнитьСписокРежимов(Режимы);
	ЭтоПапки = Справочники.Номенклатура.ПолеРежимаИерархии(РежимИерархии) = "";
	Элементы.УзлыИерархии.Видимость = Не ЭтоПапки;
	Элементы.КнопкаОбновитьИерархию.Видимость = Не ЭтоПапки;
	Список.Параметры.УстановитьЗначениеПараметра("СвойствоИерархии",
		Справочники.Номенклатура.СвойствоРежимаИерархии(РежимИерархии));
	ПрименитьОтборы();
	ВыбратьУзелНаСервере();

КонецПроцедуры

// Избранные режимы - первыми в списке выбора; у текущего режима - звёздочка на кнопке.
//
// Параметры:
//  Режимы - СписокЗначений - см. Справочники.Номенклатура.РежимыИерархии
//
&НаСервере
Процедура ЗаполнитьСписокРежимов(Режимы)

	Избранные = СтрРазделить(ИзбранныеРежимы, ",", Ложь);
	Выбор = Элементы.РежимИерархии.СписокВыбора;
	Выбор.Очистить();
	Для Каждого Режим Из Режимы Цикл
		Если Избранные.Найти(Режим.Значение) <> Неопределено Тогда
			Выбор.Добавить(Режим.Значение, "★ " + Режим.Представление);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Режим Из Режимы Цикл
		Если Избранные.Найти(Режим.Значение) = Неопределено Тогда
			Выбор.Добавить(Режим.Значение, Режим.Представление);
		КонецЕсли;
	КонецЦикла;
	Элементы.КнопкаИзбранныйРежим.Заголовок = ?(Избранные.Найти(РежимИерархии) = Неопределено, "☆", "★");

КонецПроцедуры

&НаСервере
Процедура ИзбранныйРежимНаСервере()

	Избранные = СтрРазделить(ИзбранныеРежимы, ",", Ложь);
	Позиция = Избранные.Найти(РежимИерархии);
	Если Позиция = Неопределено Тогда
		Избранные.Добавить(РежимИерархии);
	Иначе
		Избранные.Удалить(Позиция);
	КонецЕсли;
	ИзбранныеРежимы = СтрСоединить(Избранные, ",");
	ЗаполнитьСписокРежимов(Справочники.Номенклатура.РежимыИерархии());

КонецПроцедуры

// Узлы навигатора со счётчиками по контексту и фильтрам панели; текущий узел сохраняется, если он остался.
//
&НаСервере
Процедура ОбновитьУзлы()

	УзлыИерархии.Загрузить(Справочники.Номенклатура.УзлыИерархии(РежимИерархии, КонтекстСписка(), ОтборыПанели()));

КонецПроцедуры

// Отбор узла - в группу «Иерархия» отбора списка; узла, которого больше нет, - «Все».
//
&НаСервере
Процедура ВыбратьУзелНаСервере()

	Найденные = УзлыИерархии.НайтиСтроки(Новый Структура("Вид, Значение", ВидУзла, ЗначениеУзла));
	Если Найденные.Количество() = 0 Тогда
		ВидУзла = 0;
		ЗначениеУзла = Неопределено;
		Найденные = УзлыИерархии.НайтиСтроки(Новый Структура("Вид", 0));
	КонецЕсли;
	Если Найденные.Количество() > 0 Тогда
		Элементы.УзлыИерархии.ТекущаяСтрока = Найденные[0].ПолучитьИдентификатор();
	КонецЕсли;
	Справочники.Номенклатура.УстановитьОтборИерархии(Список.Отбор, РежимИерархии, ВидУзла, ЗначениеУзла);

КонецПроцедуры

#КонецОбласти

#Область Прочее

// Команды разделов открывают список с параметром: «Закупаемые товары», «Товары», «Товары и услуги для продажи»,
// «Сырьё», «Полуфабрикаты», «Готовая продукция» - заголовок по нему. Отбор состава - в ПараметрыЗапросаСписка.
//
&НаСервере
Процедура УстановитьЗаголовок()

	Если Параметры.ТолькоЗакупаемые Тогда
		АвтоЗаголовок = Ложь;
		Заголовок = НСтр("ru = 'Закупаемые товары'; fr = 'Articles achetés'; en = 'Purchased items'; es = 'Artículos comprados'");
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.ОтборТипа) Тогда
		АвтоЗаголовок = Ложь;
		Заголовок = ЗаголовокПоТипу(Параметры.ОтборТипа);
	КонецЕсли;
	Если Параметры.ТолькоТовары Тогда
		АвтоЗаголовок = Ложь;
		Заголовок = НСтр("ru = 'Товары'; fr = 'Marchandises'; en = 'Goods'; es = 'Mercancías'");
	КонецЕсли;
	Если Параметры.ТолькоПродаваемые Тогда
		АвтоЗаголовок = Ложь;
		Заголовок = НСтр("ru = 'Товары и услуги для продажи'; fr = 'Articles vendus'; en = 'Items for sale';
			|es = 'Artículos para la venta'");
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Тип - ПеречислениеСсылка.ТипыНоменклатуры - тип из параметра ОтборТипа
//
// Возвращаемое значение:
//  Строка - заголовок формы
//
&НаСервереБезКонтекста
Функция ЗаголовокПоТипу(Тип)

	Если Тип = Перечисления.ТипыНоменклатуры.Сырье Тогда
		Возврат НСтр("ru = 'Сырье'; fr = 'Matières premières'; en = 'Raw materials'; es = 'Materias primas'");
	ИначеЕсли Тип = Перечисления.ТипыНоменклатуры.Полуфабрикат Тогда
		Возврат НСтр("ru = 'Полуфабрикаты'; fr = 'Produits semi-finis'; en = 'Semi-finished products';
			|es = 'Productos semielaborados'");
	ИначеЕсли Тип = Перечисления.ТипыНоменклатуры.Продукция Тогда
		Возврат НСтр("ru = 'Готовая продукция'; fr = 'Produits finis'; en = 'Finished products'; es = 'Productos terminados'");
	Иначе
		Возврат Строка(Тип);
	КонецЕсли;

КонецФункции

// Кассир (роль PDV) не видит коды поставщика и производителя, основного поставщика и старый код даже через
// «Изменить форму»: программная видимость перекрывает пользовательскую.
//
&НаСервере
Процедура НастроитьФорму()

	// Роль кассира, а не право на объект: скрываются реквизиты, читать которые он вправе.
	// BSLLS:IsInRoleMethod-off
	Если Не РольДоступна("PDV") Тогда
		Возврат;
	КонецЕсли;
	// BSLLS:IsInRoleMethod-on
	Для Каждого Имя Из СтрРазделить("КодПоставщика,КодПроизводителя,ОсновнойПоставщик,КодСтарый,ЦенаЗакупки", ",") Цикл
		Элементы[Имя].Видимость = Ложь;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
