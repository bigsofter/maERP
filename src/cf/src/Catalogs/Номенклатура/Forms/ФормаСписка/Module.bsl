
#Область Обработчики_событий_формы
 
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьПараметрыСписка();
	УстановитьОтборЗакупаемых();
	УстановитьОтборТипов();
	НастроитьФорму();
КонецПроцедуры 

#КонецОбласти

#Область Обработчики_элементов_формы
                           
#КонецОбласти

#Область Дополнительно

&НаСервере
Процедура УстановитьПараметрыСписка()
	Справочники.Номенклатура.УстановитьПараметрыСписка(Элементы.Список, Список, ДЗСегменты);
	Список.Параметры.УстановитьЗначениеПараметра("НачалоПериода", ДобавитьМесяц(ТекущаяДата(),-12));
КонецПроцедуры

// Команда «Закупаемые товары» раздела «Закупки» открывает список с параметром ТолькоЗакупаемые:
// номенклатура со способом пополнения «Закупка» или «Оба», группы - всегда. Без производства отбор не
// ставится: способ пополнения тогда скрыт, а типам «Продукция» и «Полуфабрикат» он заполняется
// «Производством» (Справочники.Номенклатура.СпособПополненияПоУмолчанию) - товар пропал бы из списка
// без возможности это исправить.
&НаСервере
Процедура УстановитьОтборЗакупаемых()
	ОтборЗакупаемых = Параметры.ТолькоЗакупаемые И ПолучитьФункциональнуюОпцию("Производство");
	СпособыПополнения = Новый Массив;
	СпособыПополнения.Добавить(Перечисления.СпособыПополненияЗапасов.Закупка);
	СпособыПополнения.Добавить(Перечисления.СпособыПополненияЗапасов.Оба);
	Список.Параметры.УстановитьЗначениеПараметра("СпособыПополненияУстановлены", ОтборЗакупаемых);
	Список.Параметры.УстановитьЗначениеПараметра("СпособыПополнения", СпособыПополнения);
	Если Параметры.ТолькоЗакупаемые Тогда
		АвтоЗаголовок = Ложь;
		Заголовок = НСтр("ru = 'Закупаемые товары'; fr = 'Articles achetés'; en = 'Purchased items'; es = 'Artículos comprados'");
	КонецЕсли;
КонецПроцедуры

// Отбор по типу номенклатуры для команд разделов, группы - всегда:
//  - «Товары и услуги для продажи» (раздел «Продажи», параметр ТолькоПродаваемые) - без сырья и полуфабрикатов.
//    Без производства отбор не ставится: тогда эти типы не про производство, и торговец может продавать то,
//    что завёл сырьём;
//  - «Товары» (раздел «Склад», параметр ТолькоТовары) - без услуг и комплектов, всегда: услуга на складе не
//    хранится, комплект при движении раскладывается на состав;
//  - «Сырьё», «Полуфабрикаты», «Готовая продукция» (раздел «Производство», параметр ОтборТипа) - только этот тип:
//    все прочие значения перечисления исключаются.
// Параметры запроса ставятся при каждом открытии - без них список не сформируется.
&НаСервере
Процедура УстановитьОтборТипов()
	ИсключаемыеТипы = Новый Массив;
	Если Параметры.ТолькоПродаваемые И ПолучитьФункциональнуюОпцию("Производство") Тогда
		ИсключаемыеТипы.Добавить(Перечисления.ТипыНоменклатуры.Сырье);
		ИсключаемыеТипы.Добавить(Перечисления.ТипыНоменклатуры.Полуфабрикат);
	КонецЕсли;
	Если Параметры.ТолькоТовары Тогда
		ИсключаемыеТипы.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
		ИсключаемыеТипы.Добавить(Перечисления.ТипыНоменклатуры.Комплект);
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.ОтборТипа) Тогда
		Для Каждого Тип Из Перечисления.ТипыНоменклатуры Цикл
			Если Тип <> Параметры.ОтборТипа И ИсключаемыеТипы.Найти(Тип) = Неопределено Тогда
				ИсключаемыеТипы.Добавить(Тип);
			КонецЕсли;
		КонецЦикла;
		АвтоЗаголовок = Ложь;
		Заголовок = ЗаголовокПоТипу(Параметры.ОтборТипа);
	КонецЕсли;
	Список.Параметры.УстановитьЗначениеПараметра("ИсключаемыеТипыУстановлены", ИсключаемыеТипы.Количество() > 0);
	Список.Параметры.УстановитьЗначениеПараметра("ИсключаемыеТипы", ИсключаемыеТипы);
	Если Параметры.ТолькоТовары Тогда
		АвтоЗаголовок = Ложь;
		Заголовок = НСтр("ru = 'Товары'; fr = 'Marchandises'; en = 'Goods'; es = 'Mercancías'");
	КонецЕсли;
	Если Параметры.ТолькоПродаваемые Тогда
		АвтоЗаголовок = Ложь;
		Заголовок = НСтр("ru = 'Товары и услуги для продажи'; fr = 'Articles vendus'; en = 'Items for sale';
			|es = 'Artículos para la venta'");
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаголовокПоТипу(Тип)
	Если Тип = Перечисления.ТипыНоменклатуры.Сырье Тогда
		Возврат НСтр("ru = 'Сырье'; fr = 'Matières premières'; en = 'Raw materials'; es = 'Materias primas'");
	ИначеЕсли Тип = Перечисления.ТипыНоменклатуры.Полуфабрикат Тогда
		Возврат НСтр("ru = 'Полуфабрикаты'; fr = 'Produits semi-finis'; en = 'Semi-finished products';
			|es = 'Productos semielaborados'");
	ИначеЕсли Тип = Перечисления.ТипыНоменклатуры.Продукция Тогда
		Возврат НСтр("ru = 'Готовая продукция'; fr = 'Produits finis'; en = 'Finished products'; es = 'Productos terminados'");
	Иначе
		Возврат Строка(Тип);
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОперацииСПодключаемымОборудованиемКлиент.ПодключитьОборудование(УникальныйИдентификатор, Истина); 
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ScanData" и ВводДоступен() Тогда 
		Штрихкод = ОперацииСПодключаемымОборудованиемКлиент.ПолучитьШтрихкод(ИмяСобытия, Параметр, Источник);
		СтруктураТОвара = ОбщегоНазначенияВызовСервера.ПолучитьНоменклатуруПоШтрихкоду(Штрихкод);
		Если СтруктураТОвара <> Неопределено И ЗначениеЗаполнено(СтруктураТОвара.Номенклатура) Тогда
			Элементы.Список.ТекущаяСтрока = СтруктураТОвара.Номенклатура;
			ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",Новый Структура("Ключ",СтруктураТОвара.Номенклатура));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	ЭтоPDV = ЭтоPDV();
	Элементы.КодПоставщика.Видимость = не ЭтоPDV;
	Элементы.КодПроизводителя.Видимость = не ЭтоPDV;
	Элементы.ОсновнойПоставщик.Видимость = не ЭтоPDV;
	Элементы.КодСтарый.Видимость = не ЭтоPDV;
	Элементы.Продажи.Видимость = не ЭтоPDV;
КонецПроцедуры

&НаСервере
Функция ЭтоPDV()
	Возврат РольДоступна("PDV");
КонецФункции

#КонецОбласти


