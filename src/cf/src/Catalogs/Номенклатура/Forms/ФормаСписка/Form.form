      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникНоменклатура.Код КАК Код,
	СправочникНоменклатура.Наименование КАК Наименование,
	СправочникНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	СправочникНоменклатура.Ссылка КАК Ссылка,
	СправочникНоменклатура.НаименованиеПолное КАК НаименованиеПолное,
	СправочникНоменклатура.СтавкаНДС КАК СтавкаНДС,
	СправочникНоменклатура.Артикул КАК Артикул,
	СправочникНоменклатура.Бренд КАК Бренд,
	СправочникНоменклатура.Качество КАК Качество,
	СправочникНоменклатура.КодСтарый КАК КодСтарый,
	ЕСТЬNULL(ТоварыВНаличииОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	СправочникНоменклатура.ЯчейкиСтрокой КАК ЯчейкиСтрокой,
	СправочникНоменклатура.КодПоставщика КАК КодПоставщика,
	СправочникНоменклатура.КодПроизводителя КАК КодПроизводителя,
	ЕСТЬNULL(ПродажиОбороты.КоличествоОборот, 0) КАК Продажи,
	СправочникНоменклатура.ОсновнойПоставщик КАК ОсновнойПоставщик,
	ЕСТЬNULL(ПрисоединённыеФайлыНаличие.ЕстьФайлы, ЛОЖЬ) КАК ЕстьФайлы,
	ЕСТЬNULL(ЦеныПоставщика.ЦенаЕдиницыХранения, 0) КАК ЦенаЗакупки,
	ЕСТЬNULL(ЦеныРозничные.Цена, 0) КАК РозничнаяЦена
ИЗ
	Справочник.Номенклатура КАК СправочникНоменклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВНаличии.Остатки(, МестоХранения = &amp;МестоХранения) КАК ТоварыВНаличииОстатки
		ПО СправочникНоменклатура.Ссылка = ТоварыВНаличииОстатки.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(&amp;НачалоПериода, , , МестоХранения = &amp;МестоХранения) КАК ПродажиОбороты
		ПО СправочникНоменклатура.Ссылка = ПродажиОбороты.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединённыеФайлыНаличие КАК ПрисоединённыеФайлыНаличие
		ПО СправочникНоменклатура.Ссылка = ПрисоединённыеФайлыНаличие.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатурыПоставщиков.СрезПоследних(, Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ЦеныПоставщика
		ПО СправочникНоменклатура.Ссылка = ЦеныПоставщика.Номенклатура
			И СправочникНоменклатура.ОсновнойПоставщик = ЦеныПоставщика.Контрагент
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Розничная) И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) И ТоварнаяГруппа = ЗНАЧЕНИЕ(Справочник.ТоварныеГруппы.ПустаяСсылка)) КАК ЦеныРозничные
		ПО СправочникНоменклатура.Ссылка = ЦеныРозничные.Номенклатура
ГДЕ
	ВЫБОР
			КОГДА &amp;ТипыНоменклатурыУстановлены
				ТОГДА СправочникНоменклатура.ТипНоменклатуры В (&amp;ТипыНоменклатуры)
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ТоварныеГруппыУстановлены
				ТОГДА СправочникНоменклатура.ТоварнаяГруппа В (&amp;ТоварныеГруппы)
			ИНАЧЕ ИСТИНА
		КОНЕЦ</queryText>
      <mainTable>Catalog.Номенклатура</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
