  <autoCommandBar>
    <name>ФормаКоманднаяПанель</name>
    <id>-1</id>
    <horizontalAlign>Left</horizontalAlign>
    <autoFill>true</autoFill>
  </autoCommandBar>
  <handlers>
    <event>NotificationProcessing</event>
    <name>ОбработкаОповещения</name>
  </handlers>
  <handlers>
    <event>OnOpen</event>
    <name>ПриОткрытии</name>
  </handlers>
  <handlers>
    <event>OnCreateAtServer</event>
    <name>ПриСозданииНаСервере</name>
  </handlers>
  <handlers>
    <event>OnLoadDataFromSettingsAtServer</event>
    <name>ПриЗагрузкеДанныхИзНастроекНаСервере</name>
  </handlers>
  <windowOpeningMode>DontBlock</windowOpeningMode>
  <autoSaveDataInSettings>Use</autoSaveDataInSettings>
  <saveWindowSettings>true</saveWindowSettings>
  <autoTitle>true</autoTitle>
  <autoUrl>true</autoUrl>
  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <verticalScroll>UseIfNecessary</verticalScroll>
  <showTitle>auto</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Родитель</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникНоменклатура.Ссылка КАК Ссылка,
	СправочникНоменклатура.Код КАК Код,
	СправочникНоменклатура.Наименование КАК Наименование,
	СправочникНоменклатура.ЭтоГруппа КАК ЭтоГруппа,
	СправочникНоменклатура.ПометкаУдаления КАК ПометкаУдаления,
	СправочникНоменклатура.Родитель КАК Родитель,
	СправочникНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	СправочникНоменклатура.НаименованиеПолное КАК НаименованиеПолное,
	СправочникНоменклатура.СтавкаНДС КАК СтавкаНДС,
	СправочникНоменклатура.Артикул КАК Артикул,
	СправочникНоменклатура.Единица КАК Единица,
	СправочникНоменклатура.Бренд КАК Бренд,
	СправочникНоменклатура.Качество КАК Качество,
	СправочникНоменклатура.ТоварнаяГруппа КАК ТоварнаяГруппа,
	СправочникНоменклатура.СпособПополнения КАК СпособПополнения,
	СправочникНоменклатура.КодСтарый КАК КодСтарый,
	СправочникНоменклатура.ЯчейкиСтрокой КАК ЯчейкиСтрокой,
	СправочникНоменклатура.КодПоставщика КАК КодПоставщика,
	СправочникНоменклатура.КодПроизводителя КАК КодПроизводителя,
	СправочникНоменклатура.ОсновнойПоставщик КАК ОсновнойПоставщик,
	ЕСТЬNULL(Остатки.Количество, 0) КАК КоличествоОстаток,
	ВЫБОР
		КОГДА ЕСТЬNULL(Остатки.Количество, 0) &gt; 0
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ВНаличии,
	ВЫБОР
		КОГДА СправочникНоменклатура.ЭтоГруппа
			ТОГДА ЛОЖЬ
		КОГДА ЕСТЬNULL(Остатки.Количество, 0) &lt; ЕСТЬNULL(Минимумы.МинимальноеКоличествоХранения,
				СправочникНоменклатура.МинимальноеКоличествоХранения)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК НижеМинимума,
	ЕСТЬNULL(ПрисоединённыеФайлыНаличие.ЕстьФайлы, ЛОЖЬ) КАК ЕстьФайлы,
	ЕСТЬNULL(ЦеныПоставщика.ЦенаЕдиницыХранения, 0) КАК ЦенаЗакупки,
	ЕСТЬNULL(ЦеныРозничные.Цена, 0) КАК РозничнаяЦена,
	ЗначенияИерархии.Значение КАК ЗначениеИерархии
ИЗ
	Справочник.Номенклатура КАК СправочникНоменклатура
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ОстаткиСклада.Номенклатура КАК Номенклатура,
			СУММА(ОстаткиСклада.КоличествоОстаток) КАК Количество
		ИЗ
			РегистрНакопления.ТоварыВНаличии.Остатки(
					,
					НЕ &amp;СкладУстановлен
						ИЛИ МестоХранения = &amp;МестоХранения) КАК ОстаткиСклада
		СГРУППИРОВАТЬ ПО
			ОстаткиСклада.Номенклатура) КАК Остатки
		ПО СправочникНоменклатура.Ссылка = Остатки.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальныйОстатокПоСкладам КАК Минимумы
		ПО СправочникНоменклатура.Ссылка = Минимумы.Номенклатура
			И (&amp;СкладУстановлен)
			И (Минимумы.МестоХранения = &amp;МестоХранения)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединённыеФайлыНаличие КАК ПрисоединённыеФайлыНаличие
		ПО СправочникНоменклатура.Ссылка = ПрисоединённыеФайлыНаличие.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатурыПоставщиков.СрезПоследних(
				,
				Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ЦеныПоставщика
		ПО СправочникНоменклатура.Ссылка = ЦеныПоставщика.Номенклатура
			И СправочникНоменклатура.ОсновнойПоставщик = ЦеныПоставщика.Контрагент
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
				,
				ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Розничная)
					И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
					И ТоварнаяГруппа = ЗНАЧЕНИЕ(Справочник.ТоварныеГруппы.ПустаяСсылка)) КАК ЦеныРозничные
		ПО СправочникНоменклатура.Ссылка = ЦеныРозничные.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Реквизиты.Ссылка КАК Объект,
			Реквизиты.Значение КАК Значение
		ИЗ
			Справочник.Номенклатура.ДополнительныеРеквизиты КАК Реквизиты
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
					Строки.Ссылка КАК Ссылка,
					МАКСИМУМ(Строки.НомерСтроки) КАК НомерСтроки
				ИЗ
					Справочник.Номенклатура.ДополнительныеРеквизиты КАК Строки
				ГДЕ
					Строки.Свойство = &amp;СвойствоИерархии
				СГРУППИРОВАТЬ ПО
					Строки.Ссылка) КАК Последние
				ПО Реквизиты.Ссылка = Последние.Ссылка
					И Реквизиты.НомерСтроки = Последние.НомерСтроки

		ОБЪЕДИНИТЬ ВСЕ

		ВЫБРАТЬ
			Сведения.Объект,
			Сведения.Значение
		ИЗ
			РегистрСведений.ДополнительныеСведения КАК Сведения
		ГДЕ
			Сведения.Свойство = &amp;СвойствоИерархии) КАК ЗначенияИерархии
		ПО СправочникНоменклатура.Ссылка = ЗначенияИерархии.Объект
ГДЕ
	ВЫБОР
			КОГДА &amp;СпособыПополненияУстановлены
				ТОГДА СправочникНоменклатура.ЭтоГруппа
						ИЛИ СправочникНоменклатура.СпособПополнения В (&amp;СпособыПополнения)
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ИсключаемыеТипыУстановлены
				ТОГДА СправочникНоменклатура.ЭтоГруппа
						ИЛИ НЕ СправочникНоменклатура.ТипНоменклатуры В (&amp;ИсключаемыеТипы)
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ОтборПоСвойству
				ТОГДА СправочникНоменклатура.Ссылка В
						(ВЫБРАТЬ
							ЗначенияОтбора.Объект
						ИЗ
							(ВЫБРАТЬ
									Реквизиты.Ссылка КАК Объект,
									Реквизиты.Значение КАК Значение
								ИЗ
									Справочник.Номенклатура.ДополнительныеРеквизиты КАК Реквизиты
										ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
											Строки.Ссылка КАК Ссылка,
											МАКСИМУМ(Строки.НомерСтроки) КАК НомерСтроки
										ИЗ
											Справочник.Номенклатура.ДополнительныеРеквизиты КАК Строки
										ГДЕ
											Строки.Свойство = &amp;СвойствоОтбора
										СГРУППИРОВАТЬ ПО
											Строки.Ссылка) КАК Последние
										ПО Реквизиты.Ссылка = Последние.Ссылка
											И Реквизиты.НомерСтроки = Последние.НомерСтроки
						
								ОБЪЕДИНИТЬ ВСЕ
						
								ВЫБРАТЬ
									Сведения.Объект,
									Сведения.Значение
								ИЗ
									РегистрСведений.ДополнительныеСведения КАК Сведения
								ГДЕ
									Сведения.Свойство = &amp;СвойствоОтбора) КАК ЗначенияОтбора
						ГДЕ
							ЗначенияОтбора.Значение = &amp;ЗначениеОтбора)
			ИНАЧЕ ИСТИНА
		КОНЕЦ</queryText>
