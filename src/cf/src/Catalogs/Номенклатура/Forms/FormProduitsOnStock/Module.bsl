
&AtServer
Procedure OnCreateAtServer(Cancel, StandardProcessing)
	ТипЦен = Справочники.ВидыЦен.Розничная;
	Если Параметры.Свойство("Контрагент") Тогда
		Если ЗначениеЗаполнено(параметры.Контрагент.ТипЦены) Тогда 
			ТипЦен = параметры.Контрагент.ТипЦены;
		КонецЕсли;
	КонецЕсли;
	// Склад продажи кассы (план retail-store-price, §2а): по нему остатки и вид цены; не передан - склад пользователя.
	Если Не Параметры.Свойство("МестоХранения", СкладПодбора) Или Не ЗначениеЗаполнено(СкладПодбора) Тогда
		СкладПодбора = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	КонецЕсли;
	LoadProducts();
	CreateButtons();
	FilterProductGroup = "__Tous1__";
	РазрешенныеПоля = СтрРазделить("Номенклатура,Артикул", ",", Ложь);
	УстановитьОграничениеДинамическогоСписка(ЭтаФорма.VT, РазрешенныеПоля);
EndProcedure

&AtServer
Procedure LoadProducts()
	If FilterProductGroup = "__Tous1__" Then 
		ProductFilter = Catalogs.Номенклатура.EmptyRef();
	Else 
		ProductFilter = Catalogs.Номенклатура.FindByCode(FilterProductGroup);
	EndIf;
	
	VT.Параметры.SetParameterValue("МестоХранения", СкладПодбора);
	VT.Параметры.SetParameterValue("Produit",ProductFilter);
	VT.Параметры.SetParameterValue("ДатаЦен", ТекущаяДатаСеанса());
	// Заданный вид цены склада - цены склада с откатом на «Розничную» (то же правило, что у строки кассы); пустой -
	// прежний вид подбора без отката.
	Если ЗначениеЗаполнено(Справочники.МестаХранения.ВидЦеныПродажи(СкладПодбора)) Тогда
		Для Каждого КлючИЗначение Из Справочники.МестаХранения.ПараметрыЦенПродажиСклада(СкладПодбора) Цикл
			VT.Параметры.SetParameterValue(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	Иначе
		VT.Параметры.SetParameterValue("ВидЦеныСклада", ТипЦен);
		VT.Параметры.SetParameterValue("ВидЦеныОтката", Справочники.ВидыЦен.ПустаяСсылка());
	КонецЕсли;
	//VT.Load(Query.Execute().Unload());
	//Элементы.VT.Обновить();
EndProcedure

// Результат выбора подбора: сетка - строка на товар без характеристики (динамический список с основной таблицей
// «Номенклатура» не может дать строку на каждую характеристику), цена в ней - цена без характеристики; характеристика
// передаётся явно пустой, строка кассы ищется по товару с пустой характеристикой (план retail-store-price, §1).
//
// Параметры:
//  ДанныеСтроки - ДанныеФормыСтруктура - текущая строка списка.
//
// Возвращаемое значение:
//  Структура - Номенклатура, Характеристика, Количество, Цена.
//
&НаКлиенте
Функция ВыбраннаяПозиция(ДанныеСтроки)
	Позиция = Новый Структура("Номенклатура, Характеристика, Количество, Цена");
	Позиция.Номенклатура = ДанныеСтроки.Номенклатура;
	Позиция.Характеристика = PredefinedValue("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	Позиция.Количество = 1;
	Позиция.Цена = ДанныеСтроки.Цена;
	Возврат Позиция;
КонецФункции

&AtClient
Procedure VTSelection(Item, SelectedRow, Field, StandardProcessing)
	CurData = items.VT.CurrentData;
	If CurData <> Undefined Then
		Str = ВыбраннаяПозиция(CurData);
		Close(Str);
	EndIf;
EndProcedure

&AtClient
Procedure Choisir(Command)
	CurData = items.VT.CurrentData;
	If CurData <> Undefined Then
		Str = ВыбраннаяПозиция(CurData);
		Close(Str);
	EndIf;
EndProcedure

&AtServer
Procedure CreateButtons()
	Items.FilterProductGroup.ChoiceList.Clear();
	
	Items.FilterProductGroup.ChoiceList.Add("__Tous1__", "Tous");
	
	Query = New Query;
	Query.Text =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СпрНоменклатура.Ссылка КАК Produit
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ГДЕ
	|	СпрНоменклатура.ЭтоГруппа
	|
	|СГРУППИРОВАТЬ ПО
	|	СпрНоменклатура.Ссылка
	|ИТОГИ ПО
	|	Produit ТОЛЬКО ИЕРАРХИЯ";
	
	Result = Query.Execute().Select(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);	
	
	While Result.Next() Do
		Items.FilterProductGroup.ChoiceList.Add(Result.Produit.Code, Result.Produit);  
	КонецЦикла;	
EndProcedure

&AtClient
Procedure FilterProductGroupOnChange(Item)
	LoadProducts();
EndProcedure

