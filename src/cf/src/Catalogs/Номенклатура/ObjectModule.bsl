#Область ОбработчикиСобытий
Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Не ЭтоГруппа И Не ЗначениеЗаполнено(СпособПополнения) Тогда
		СпособПополнения = Справочники.Номенклатура.СпособПополненияПоУмолчанию(ТипНоменклатуры);
	КонецЕсли;
	Если ЭтоНовый() И Не ЭтоГруппа Тогда
		Автор = ПараметрыСеанса.Пользователь;
		ДатаСоздания = ТекущаяДатаСеанса();
		УстановитьНовыйКод();
		Если Не ЗначениеЗаполнено(Артикул) Тогда
			Попытка
				НовыйАртикул = получитьИДТовараНаСервере();
			Исключение
				НовыйАртикул = Код;
			КонецПопытки;
			Артикул = НовыйАртикул;
		КонецЕсли;
	КонецЕсли;
	Если Не ЭтоГруппа Тогда 
		ЯчейкиСтрокой = СтрСоединить(Хранение.ВыгрузитьКолонку("Зона"),"; ");
		ЗаполнитьНаименования();
	КонецЕсли;
КонецПроцедуры

// Пустое из пары «наименование - полное» заполняется другим, заполненное не перезаписывается. Зовётся и из
// ОбработкаПроверкиЗаполнения: проверка обязательного наименования идёт раньше ПередЗаписью.
//
Процедура ЗаполнитьНаименования()
	Если Не ЗначениеЗаполнено(НаименованиеПолное) Тогда
		НаименованиеПолное = Наименование;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = НаименованиеПолное;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Дубль артикула проверяется только у нового товара или при смене артикула: исторический дубль не мешает
	// править прочие реквизиты, а программная запись (без проверки заполнения) пишет как раньше.
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьНаименования();
	Если Не ЗначениеЗаполнено(Артикул) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЭтоНовый() И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Артикул") = Артикул Тогда
		Возврат;
	КонецЕсли;
	Если Справочники.Номенклатура.АртикулЗанят(Артикул, Ссылка) Тогда
		ТекстСообщения = НСтр("ru = 'Товар с таким артикулом уже существует!'; fr = 'Produit avec ce ID existe déjà !';
			|en = 'A product with such an article already exists!'; es = 'El producto con este artículo ya existe!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "Артикул", "Объект", Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ПриУстановкеНовогоКода(СтандартнаяОбработка, Префикс)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Insérer le contenu du traitement.
КонецПроцедуры

Функция ТекстЗапросаИзСтрокиВЧисло(пИмяПоля, пДлинаСтроки, пСимволРазделителя=".")
    лТекст="ВЫБОР ";
    Для лДлинаЦелойЧасти=0 По пДлинаСтроки Цикл
        Если лДлинаЦелойЧасти=пДлинаСтроки Тогда 
            лТекст=лТекст+"ИНАЧЕ"+Символы.ПС;
        Иначе
            лТекст=лТекст+"КОГДА ПОДСТРОКА("+пИмяПоля+", "+(лДлинаЦелойЧасти+1)+", 1)="""+пСимволРазделителя+""" ИЛИ ПОДСТРОКА("+пИмяПоля+", "+(лДлинаЦелойЧасти+1)+", 1)="""" ТОГДА "+Символы.ПС;
        КонецЕсли; 
        Если лДлинаЦелойЧасти=0 Тогда лТекст=лТекст+"    0"+Символы.ПС; КонецЕсли; 
        Для лИнд=1 По лДлинаЦелойЧасти Цикл
            лТекст=лТекст+"    ВЫБОР "+Символы.ПС;
            Для лЦифра=0 По 9 Цикл
                лТекст=лТекст+"    КОГДА ПОДСТРОКА("+пИмяПоля+", "+лИнд+", 1)="""+лЦифра+""" ТОГДА "+лЦифра+Символы.ПС;
            КонецЦикла;
            лТекст=лТекст+"    ИНАЧЕ 0 КОНЕЦ"+?(лИнд=лДлинаЦелойЧасти, "", "*"+Формат(Pow(10, лДлинаЦелойЧасти-лИнд), "ЧРД=.; ЧГ=0")+"+")+Символы.ПС;
        КонецЦикла;
        Для лИнд=лДлинаЦелойЧасти+2 По пДлинаСтроки Цикл
            лТекст=лТекст+"+ ВЫБОР";
            Для лЦифра=0 По 9 Цикл
                лТекст=лТекст+"    КОГДА ПОДСТРОКА("+пИмяПоля+", "+лИнд+", 1)="""+лЦифра+""" ТОГДА "+лЦифра+Символы.ПС;
            КонецЦикла;
            лТекст=лТекст+"    ИНАЧЕ 0 КОНЕЦ"+?(лИнд=лДлинаЦелойЧасти, "", "/"+Формат(Pow(10, лИнд-лДлинаЦелойЧасти-1), "ЧРД=.; ЧГ=0"))+Символы.ПС;
        КонецЦикла;
    КонецЦикла;
    лТекст=лТекст+"КОНЕЦ";
    Возврат лТекст;
КонецФункции 

&НаСервере
функция получитьИДТовараНаСервере()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ("+ТекстЗапросаИзСтрокиВЧисло("Номенклатура.Артикул", 11)+") КАК Код
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ЭтоГруппа = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		возврат (формат(ВыборкаДетальныеЗаписи.код+1,"ЧРГ=; ЧГ=0"));
	КонецЦикла;
	
КонецФункции

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Минимумы = Неопределено;
	Если ДополнительныеСвойства.Свойство(Справочники.Номенклатура.ИмяСвойстваМинимумовПоСкладам(), Минимумы) Тогда
		Справочники.Номенклатура.ЗаписатьМинимумыПоСкладам(Ссылка, Минимумы);
	КонецЕсли;
	Если ПометкаУдаления Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод,
		|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
		|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
		|	ШтрихкодыНоменклатуры.Упаковка КАК Упаковка,
		|	ШтрихкодыНоменклатуры.Серия КАК Серия
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|ГДЕ
		|	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура";
		Запрос.УстановитьПараметр("Номенклатура", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МЗ = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ, Выборка);
			МЗ.Удалить();
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
