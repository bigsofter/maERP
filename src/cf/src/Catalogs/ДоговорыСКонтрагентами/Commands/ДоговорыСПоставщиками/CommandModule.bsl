// Договоры вида «С поставщиком» - пункт раздела «Закупки».

#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ПараметрыФормы = Новый Структура;
	ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПоставщиком");
	ПараметрыФормы.Вставить("Отбор", Новый Структура("ВидДоговора", ВидДоговора));
	ПараметрыФормы.Вставить("Заголовок", НСтр("ru = 'Договоры с поставщиками'; fr = 'Contrats fournisseurs';
		|en = 'Supplier contracts'; es = 'Contratos con proveedores'"));
	ОткрытьФорму("Справочник.ДоговорыСКонтрагентами.ФормаСписка",
		ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник,
		"ДоговорыСПоставщиками",
		ПараметрыВыполненияКоманды.Окно);
КонецПроцедуры

#КонецОбласти
