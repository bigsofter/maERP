// Договоры вида «С покупателем» - пункт раздела «Продажи».

#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ПараметрыФормы = Новый Структура;
	ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПокупателем");
	ПараметрыФормы.Вставить("Отбор", Новый Структура("ВидДоговора", ВидДоговора));
	ПараметрыФормы.Вставить("Заголовок", НСтр("ru = 'Договоры с покупателями'; fr = 'Contrats clients';
		|en = 'Customer contracts'; es = 'Contratos con clientes'"));
	ОткрытьФорму("Справочник.ДоговорыСКонтрагентами.ФормаСписка",
		ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник,
		"ДоговорыСПокупателями",
		ПараметрыВыполненияКоманды.Окно);
КонецПроцедуры

#КонецОбласти
