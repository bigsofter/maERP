#Область ОбработчикиСобытий

// Освобождающая ставка: процент 0 и основание для сноски печатных форм (план docs/plans/vat-zones.md). Признаки
// освобождения нельзя снять у ставки, которую назначает освобождённая зона контрагентов. Проверки - в ПередЗаписью, а не
// в ОбработкаПроверкиЗаполнения: программная запись проверку заполнения не вызывает.
//
// Параметры:
//  Отказ - Булево - признак отказа от записи.
//
Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если ОсвобождениеОтНДС Тогда
		Если Ставка <> 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'У ставки освобождения от НДС процент должен быть 0.';
				|fr = 'Le taux d''exonération de TVA doit être de 0 %.';
				|en = 'A VAT exemption rate must be 0%.';
				|es = 'La tasa de exención de IVA debe ser 0 %.'"), ЭтотОбъект, "Ставка", , Отказ);
		КонецЕсли;
		Если ПустаяСтрока(ОснованиеОсвобождения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Укажите основание освобождения от НДС: оно печатается в документах.';
				|fr = 'Indiquez le motif d''exonération de TVA : il est imprimé sur les documents.';
				|en = 'Specify the VAT exemption basis: it is printed on documents.';
				|es = 'Indique el motivo de exención de IVA: se imprime en los documentos.'"), ЭтотОбъект, "ОснованиеОсвобождения", ,
				Отказ);
		КонецЕсли;
	КонецЕсли;
	Если Не ЭтоНовый() Тогда
		ПроверитьСтавкуОсвобожденныхЗон(Отказ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ставка, которую назначает зона с признаком «Освобождена от НДС», должна оставаться освобождающей. Исключительная
// блокировка своей ставки сериализует запись с записью зоны: зона берёт на ту же ставку разделяемую блокировку до
// чтения её признаков (см. ЗоныКонтрагентов, ПередЗаписью).
//
// Параметры:
//  Отказ - Булево - признак отказа от записи.
//
Процедура ПроверитьСтавкуОсвобожденныхЗон(Отказ)
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.СтавкиНДС");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Если ОсвобождениеОтНДС И Ставка = 0 И Не ПустаяСтрока(ОснованиеОсвобождения) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Зоны.Представление КАК Зона
	                      |ИЗ
	                      |	Справочник.ЗоныКонтрагентов КАК Зоны
	                      |ГДЕ
	                      |	Зоны.СтавкаНДС = &Ставка
	                      |	И Зоны.ОсвобожденаОтНДС
	                      |	И НЕ Зоны.ПометкаУдаления");
	Запрос.УстановитьПараметр("Ставка", Ссылка);
	Зоны = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Зона");
	Если Зоны.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Ставку назначают зоны, освобождённые от НДС: %1. Она должна
		|оставаться освобождающей, с процентом 0 и основанием.';
		|fr = 'Ce taux est attribué par des zones exonérées de TVA : %1. Il doit rester un taux d''exonération,
		|à 0 % et avec un motif.';
		|en = 'This rate is assigned by VAT-exempt zones: %1. It must remain an exemption rate, 0% and with a basis.';
		|es = 'Esta tasa la asignan zonas exentas de IVA: %1. Debe seguir siendo una tasa de exención, 0 % y con
		|motivo.'");
	Текст = СтрШаблон(Шаблон, СтрСоединить(Зоны, ", "));
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, "ОсвобождениеОтНДС", , Отказ);
КонецПроцедуры

#КонецОбласти
