#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Набор ставок НДС страны при создании базы. Каждая ставка ищется по ключу начального заполнения и создаётся, только
// если её нет: заполнение без общей транзакции, повторный запуск после сбоя дописывает недостающие. Набор не
// заполняется, если в справочнике есть ставки вне набора (кроме предопределённой SansTVA): их завели в базе руками.
//
// Параметры:
//  Страна - Строка - код альфа-2 страны календаря; для стран без набора ничего не делается.
//
Процедура ЗаполнитьНаборСтраны(Страна) Экспорт
	Набор = НаборСтавокНДС(ВРег(СокрЛП(Страна)));
	Если Набор.Количество() = 0 Или ЕстьСтавкиВнеНабора() Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьНедостающиеСтавкиНДС(Набор);
КонецПроцедуры

// Дописывает ставки НДС страны по ключам начального заполнения без условия «в справочнике нет ставок вне набора»:
// проверка идемпотентности набора автотестами (сценарий НачальноеЗаполнениеСтавокMA). Выполняется с правами
// вызывающего: модуль менеджера с клиента не вызывается, запись ставок проверяется правами справочника (ревью
// безопасности 2.0.17.36, круг 4 - прежний вход в привилегированном модуле вызова сервера проверкой
// ПравоДоступа не защищался).
//
// Параметры:
//  Страна - Строка - код альфа-2 страны; для стран без набора ничего не делается.
//
Процедура ДописатьНаборСтраны(Страна) Экспорт
	ЗаписатьНедостающиеСтавкиНДС(НаборСтавокНДС(ВРег(СокрЛП(Страна))));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьНедостающиеСтавкиНДС(Набор)
	Если Набор.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Ключи = Новый Массив;
	Для Каждого Описание Из Набор Цикл
		Ключи.Добавить(Описание.Ключ);
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Ставки.КлючНачальногоЗаполнения КАК Ключ
	                      |ИЗ
	                      |	Справочник.СтавкиНДС КАК Ставки
	                      |ГДЕ
	                      |	Ставки.КлючНачальногоЗаполнения В (&Ключи)");
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Есть = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ключ");
	Для Каждого Описание Из Набор Цикл
		Если Есть.Найти(Описание.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтавка = Справочники.СтавкиНДС.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(НоваяСтавка, Описание, "Наименование, Ставка, ОсвобождениеОтНДС, ОснованиеОсвобождения");
		НоваяСтавка.КлючНачальногоЗаполнения = Описание.Ключ;
		НоваяСтавка.Записать();
	КонецЦикла;
КонецПроцедуры

Функция ЕстьСтавкиВнеНабора()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Ставки.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.СтавкиНДС КАК Ставки
	                      |ГДЕ
	                      |	Ставки.КлючНачальногоЗаполнения = """"
	                      |	И Ставки.Ссылка <> ЗНАЧЕНИЕ(Справочник.СтавкиНДС.SansTVA)");
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Ставки страны: облагаемые и освобождения (0 %, основание печатается сноской под итогами). Набор - текстом:
// строка «ключ|наименование|процент|основание», пустое основание - облагаемая ставка.
//
// Параметры:
//  Страна - Строка - код альфа-2 в верхнем регистре.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Наименование, Ставка, ОсвобождениеОтНДС, ОснованиеОсвобождения.
//
Функция НаборСтавокНДС(Страна)
	// Ставка - в десятых долях процента целым числом: дробь с точкой Число() читает по локали (es: «5.5» - 55).
	Если Страна = "MA" Тогда
		// Реформа LF 2024: ставки 7 % и 14 % к 2026 году сведены к 10 % и 20 %.
		Текст = "MA20|20 %|200|
		|MA10|10 %|100|
		|MAZAI|Exonéré ZAI|0|Article 92-I-36° du CGI (zone d'accélération industrielle)
		|MAEXP|Exonéré export|0|Article 92-I-1° du CGI (exportation)";
	ИначеЕсли Страна = "FR" Тогда
		Текст = "FR20|20 %|200|
		|FR10|10 %|100|
		|FR055|5,5 %|55|
		|FR021|2,1 %|21|
		|FREXP|Exonéré export|0|Article 262 I du CGI (exportation)
		|FRUE|Exonéré UE|0|Article 262 ter I du CGI (livraison intracommunautaire)";
	Иначе
		Текст = "";
	КонецЕсли;
	Набор = Новый Массив;
	Для Каждого СтрокаНабора Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Поля = СтрРазделить(СтрокаНабора, "|");
		Описание = Новый Структура;
		Описание.Вставить("Ключ", Поля[0]);
		Описание.Вставить("Наименование", Поля[1]);
		Описание.Вставить("Ставка", Число(Поля[2]) / 10);
		Описание.Вставить("ОснованиеОсвобождения", Поля[3]);
		Описание.Вставить("ОсвобождениеОтНДС", Не ПустаяСтрока(Поля[3]));
		Набор.Добавить(Описание);
	КонецЦикла;
	Возврат Набор;
КонецФункции

#КонецОбласти

#КонецЕсли
