    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникКонтрагенты.Ссылка КАК Ссылка,
	СправочникКонтрагенты.Код КАК Код,
	СправочникКонтрагенты.Наименование КАК Наименование,
	СправочникКонтрагенты.НаименованиеПолное КАК НаименованиеПолное,
	СправочникКонтрагенты.ICE КАК ICE,
	МАКСИМУМ(ВЫРАЗИТЬ(ЕСТЬNULL(Телефон.Представление, &quot;&quot;) КАК СТРОКА(50))) КАК Телефон,
	МАКСИМУМ(ВЫРАЗИТЬ(ЕСТЬNULL(EMail.Представление, &quot;&quot;) КАК СТРОКА(50))) КАК EMail,
	СправочникКонтрагенты.CIN КАК CIN,
	СправочникКонтрагенты.Ответственный КАК Ответственный,
	СправочникКонтрагенты.Автор КАК Автор,
	СправочникКонтрагенты.Покупатель КАК Покупатель
ИЗ
	Справочник.Контрагенты КАК СправочникКонтрагенты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыКонтрагентов КАК Телефон
		ПО СправочникКонтрагенты.Ссылка = Телефон.Контрагент
			И (Телефон.Реквизит = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Телефон))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыКонтрагентов КАК EMail
		ПО СправочникКонтрагенты.Ссылка = EMail.Контрагент
			И (EMail.Реквизит = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.EMail))
ГДЕ
	СправочникКонтрагенты.Покупатель

СГРУППИРОВАТЬ ПО
	СправочникКонтрагенты.Ссылка,
	СправочникКонтрагенты.Код,
	СправочникКонтрагенты.Наименование,
	СправочникКонтрагенты.НаименованиеПолное,
	СправочникКонтрагенты.ICE,
	СправочникКонтрагенты.CIN,
	СправочникКонтрагенты.Ответственный,
	СправочникКонтрагенты.Автор,
	СправочникКонтрагенты.Покупатель</queryText>
      <mainTable>Catalog.Контрагенты</mainTable>
