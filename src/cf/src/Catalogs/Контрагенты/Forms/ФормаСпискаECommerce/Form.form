    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникКонтрагенты.Ссылка КАК Ссылка,
	СправочникКонтрагенты.ПометкаУдаления КАК ПометкаУдаления,
	СправочникКонтрагенты.Родитель КАК Родитель,
	СправочникКонтрагенты.Код КАК Код,
	СправочникКонтрагенты.Наименование КАК Наименование,
	СправочникКонтрагенты.ВидКонтрагента КАК ВидКонтрагента,
	СправочникКонтрагенты.ДобавлятьКПрефиксуМесяцОтгрузки КАК ДобавлятьКПрефиксуМесяцОтгрузки,
	СправочникКонтрагенты.NIF КАК NIF,
	СправочникКонтрагенты.Комментарий КАК Комментарий,
	СправочникКонтрагенты.Конкурент КАК Конкурент,
	СправочникКонтрагенты.RC КАК RC,
	СправочникКонтрагенты.НаименованиеПолное КАК НаименованиеПолное,
	СправочникКонтрагенты.Перевозчик КАК Перевозчик,
	СправочникКонтрагенты.Покупатель КАК Покупатель,
	СправочникКонтрагенты.Поставщик КАК Поставщик,
	СправочникКонтрагенты.Префикс КАК Префикс,
	СправочникКонтрагенты.ПрочиеОтношения КАК ПрочиеОтношения,
	СправочникКонтрагенты.ЗапретОтгрузок КАК ЗапретОтгрузок,
	СправочникКонтрагенты.ICE КАК ICE,
	СправочникКонтрагенты.ECommerce КАК ECommerce,
	СправочникКонтрагенты.ТЧГрафикДоставок.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		ДеньНедели КАК ДеньНедели,
		ВремяРаботыС КАК ВремяРаботыС,
		ВремяРаботыПо КАК ВремяРаботыПо,
		ВремяДоставкиС КАК ВремяДоставкиС,
		ВремяДоставкиПо КАК ВремяДоставкиПо,
		КомментарийЛогиста КАК КомментарийЛогиста
	) КАК ТЧГрафикДоставок,
	СправочникКонтрагенты.Предопределенный КАК Предопределенный,
	СправочникКонтрагенты.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	ЕСТЬNULL(Телефон.Представление, &quot;&quot;) КАК Телефон,
	ЕСТЬNULL(EMail.Представление, &quot;&quot;) КАК EMail
ИЗ
	Справочник.Контрагенты КАК СправочникКонтрагенты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыКонтрагентов КАК Телефон
		ПО СправочникКонтрагенты.Ссылка = Телефон.Контрагент
			И (Телефон.Реквизит = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Телефон))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыКонтрагентов КАК EMail
		ПО СправочникКонтрагенты.Ссылка = EMail.Контрагент
			И (EMail.Реквизит = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.EMail))</queryText>
      <mainTable>Catalog.Контрагенты</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
