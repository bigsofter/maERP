#Область Дополнительно

&НаСервере
Функция ЗаполнитьПоИНННаСервере()
	Возврат РеквизитыКонтрагентов.ЗаполнитьРеквизитыПоИННВФорме(ЭтаФорма);
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	Элементы.СтраницаДоставка.Видимость = Объект.Покупатель;
	Элементы.СтраницаЛичныйКабинет.Видимость = Объект.Покупатель;
	Элементы.СтраницаКредит.Видимость = Объект.Покупатель;
	Элементы.СуммаКредита.Доступность = Объект.КонтрольКредита;
	Элементы.СрокОплаты.Доступность = Объект.КонтрольКредита;
	Элементы.СпособРасчётаОтсрочки.Доступность = Объект.КонтрольКредита;
КонецПроцедуры

Процедура ЗаполнитьСтраницуДоставка()
	Если Не Объект.ТЧГрафикДоставок.Количество() = 0 тогда Возврат; КонецЕсли;
	Для ДеньНедели = 1 по 7 Цикл 
		Стр = Объект.ТЧГрафикДоставок.Добавить();
		Стр.ДеньНедели = Перечисления.ДниНедели.Получить(ДеньНедели-1);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ОбновитьРеквизитыОбъектаНаСервере();
	Если РеквизитыКонтрагентовВызовСервера.СуществуетКонтрагентСУказаннымICE(Объект.ICE,Объект.Ссылка) Тогда
		ТекстСообщения = НСтр("fr = 'Contrepartie avec ce ICE existe déjà !'; ru = 'Контрагент с таким идентификационным номеров уже существует!'; en = 'A counterparty with such identification numbers already exists!'; es = 'La contraparte con estos números de identificación ya existe!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
		возврат;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьРеквизитыОбъектаНаСервере()
	ДеревоРеквизитов = РеквизитФормыВЗначение("ДЗРеквизиты");
	Мас = ДеревоРеквизитов.Строки.НайтиСтроки(Новый Структура("Реквизит",ПланыВидовХарактеристик.ВидыРеквизитовКонтрагентов.ICE),Истина);
	Если Мас.Количество() = 0 Тогда 
		Объект.ICE = "";
	Иначе
		Объект.ICE = СокрЛП(Мас.Получить(0).Представление);
	КонецЕсли;
	Мас = ДеревоРеквизитов.Строки.НайтиСтроки(Новый Структура("Реквизит",ПланыВидовХарактеристик.ВидыРеквизитовКонтрагентов.CIN),Истина);
	Если Мас.Количество() = 0 Тогда 
		Объект.CIN = "";
	Иначе
		Объект.CIN = СокрЛП(Мас.Получить(0).Представление);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЛичныйКабинет()
	Элементы.Имя.Доступность = Объект.ЛичныйКабинетПартнера;
	Элементы.Пароль.Доступность = Объект.Покупатель;
	Элементы.Организация.Доступность = Объект.Покупатель;
КонецПроцедуры	

&НаСервере
Процедура ОбновитьПользователя()
	Если ЗначениеЗаполнено(Объект.Пользователь) Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Объект.Пользователь.ИдентификаторПользователяИБ);
		ПользовательИБ.Имя = Имя;
		ПользовательИБ.Пароль = Пароль;
		ПользовательИБ.Записать();
		ТекПользователь = Объект.Пользователь.ПолучитьОбъект();
		ТекПользователь.Организация = Организация;
		ТекПользователь.Записать();
	Иначе
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПароль(Команда)
	
	Пароль = НовыйПароль();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыйПароль()
	
	ГСП = Новый ГенераторСлучайныхПаролей;	
	НовыйПароль = ГСП.СлучайныйПароль(8);
	
	Возврат НовыйПароль;
	
КонецФункции

&НаКлиенте
Процедура СоздатьЛогин(Команда)
	Имя = СтрЗаменить(Объект.Наименование, " ", "");  
КонецПроцедуры

