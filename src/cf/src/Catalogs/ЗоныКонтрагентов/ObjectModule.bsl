#Область ОбработчикиСобытий

// Освобождённая от НДС зона назначает контрагентам ставку освобождения (план docs/plans/vat-zones.md): ставка
// обязательна и сама должна быть освобождающей. Проверка - в ПередЗаписью: программная запись проверку заполнения не
// вызывает.
//
// Параметры:
//  Отказ - Булево - признак отказа от записи.
//
Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Не ОсвобожденаОтНДС Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Укажите ставку освобождения от НДС для зоны.';
			|fr = 'Indiquez le taux d''exonération de TVA de la zone.';
			|en = 'Specify the VAT exemption rate for the zone.';
			|es = 'Indique la tasa de exención de IVA de la zona.'"), ЭтотОбъект, "СтавкаНДС", , Отказ);
		Возврат;
	КонецЕсли;
	// Разделяемая блокировка ставки до чтения её признаков: запись ставки берёт исключительную (СтавкиНДС, ПередЗаписью).
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.СтавкиНДС");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", СтавкаНДС);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
	Блокировка.Заблокировать();
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтавкаНДС, "ОсвобождениеОтНДС") <> Истина Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ставка зоны должна быть освобождающей от НДС (признак у ставки).';
			|fr = 'Le taux de la zone doit être un taux d''exonération de TVA (case du taux).';
			|en = 'The zone rate must be a VAT exemption rate (flag on the rate).';
			|es = 'La tasa de la zona debe ser de exención de IVA (marca de la tasa).'"), ЭтотОбъект, "СтавкаНДС", , Отказ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
