
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	БИК = ТекущийОбъект.Банк.Код;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ИспользуетсяБанкДляРасчётов = ЗначениеЗаполнено(Объект.БанкДляРасчётов);
	УстановитьДоступностьРеквизитов();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Объект.Наименование = СокрЛП(Объект.Банк) + " (" + СокрЛП(Объект.НомерСчёта) + ")";
КонецПроцедуры

#КонецОбласти

#Область Обработчики_элементов_формы

&НаКлиенте
Процедура ЗаполнитьПоБИК(Команда)
	ЗаполнитьПоБИКНаСервере();
	Если Не ЗначениеЗаполнено(Объект.Банк) Тогда
		Оп = Новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораБанка", ЭтотОбъект);
		ОткрытьФорму("Справочник.Банки.ФормаВыбора",, ЭтаФорма,,,, Оп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ИспользуетсяБанкДляРасчетовПриИзменении(Элемент)
	УстановитьДоступностьРеквизитов();
	Если Не ИспользуетсяБанкДляРасчётов Тогда
		Объект.БанкДляРасчётов = Неопределено;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура БИКПриИзменении(Элемент)
	ЗаполнитьПоБИК(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область Оповещения

&НаКлиенте
Процедура ПослеЗакрытияФормыВыбораБанка(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	Если РезультатЗакрытия = Неопределено Тогда Возврат КонецЕсли;
	Объект.Банк = РезультатЗакрытия;
	БИК = БИКБанка();
КонецПроцедуры	

#КонецОбласти

#Область Дополнительно

&НаКлиенте
Процедура УстановитьДоступностьРеквизитов()
	Элементы.БанкДляРасчётов.Доступность = ИспользуетсяБанкДляРасчётов;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоБИКНаСервере()
	Объект.Банк = Справочники.Банки.ПолучитьПоБИК(БИК);
КонецПроцедуры

&НаСервере
Функция БИКБанка()
	Возврат Объект.Банк.Код;	
КонецФункции	

#КонецОбласти
