
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	ДатаПоступления = ТекущаяДатаСеанса();
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Номер декларации и страна скрыты функциональной опцией «Импорт»: при выключенной опции поле с
	// ошибкой пользователь не увидит, а серию с декларацией из перенесённых данных не записать.
	Если ЗначениеЗаполнено(НомерГТД) И ПолучитьФункциональнуюОпцию("ИспользоватьИмпорт") Тогда
		ПроверяемыеРеквизиты.Добавить("СтранаПроисхождения");
	КонецЕсли;	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Адресная = ТЧПокупатели.Количество()>0;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ШК = РегистрыСведений.ШтрихкодыНоменклатуры.ПолучитьШК(Ссылка.Владелец,,Ссылка);
	Если ШК = "" Тогда
		ЗанятьНовыйШтрихкод();
	КонецЕсли;
КонецПроцедуры

// Сгенерированный EAN-13 мог успеть занять другой сеанс: тогда номер генерируется заново, чужой штрихкод не
// перезаписывается (РегистрыСведений.ШтрихкодыНоменклатуры.ЗанятьШтрихкод).
//
Процедура ЗанятьНовыйШтрихкод()

	// BSLLS:MagicNumber-off
	Попыток = 10;
	// BSLLS:MagicNumber-on
	ТекстОтказа = "";
	Для НомерПопытки = 1 По Попыток Цикл
		НовыйШтрихкод = РегистрыСведений.ШтрихкодыНоменклатуры.СформироватьEAN13();
		ТекстОтказа = РегистрыСведений.ШтрихкодыНоменклатуры.ЗанятьШтрихкод(НовыйШтрихкод, Владелец, Ссылка);
		Если ТекстОтказа = "" Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение ТекстОтказа;

КонецПроцедуры
