
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	ДатаПоступления = ТекущаяДатаСеанса();
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Номер декларации и страна скрыты функциональной опцией «Импорт»: при выключенной опции поле с
	// ошибкой пользователь не увидит, а серию с декларацией из перенесённых данных не записать.
	Если ЗначениеЗаполнено(НомерГТД) И ПолучитьФункциональнуюОпцию("ИспользоватьИмпорт") Тогда
		ПроверяемыеРеквизиты.Добавить("СтранаПроисхождения");
	КонецЕсли;	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Адресная = ТЧПокупатели.Количество()>0;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ШК = РегистрыСведений.ШтрихкодыНоменклатуры.ПолучитьШК(Ссылка.Владелец,,Ссылка);
	Если ШК = "" Тогда
		НЗ = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
		НЗ.Штрихкод = РегистрыСведений.ШтрихкодыНоменклатуры.СформироватьEAN13();
		НЗ.Номенклатура = Ссылка.Владелец;
		НЗ.Серия = Ссылка;
		НЗ.Записать(Истина);
	КонецЕсли;
КонецПроцедуры
