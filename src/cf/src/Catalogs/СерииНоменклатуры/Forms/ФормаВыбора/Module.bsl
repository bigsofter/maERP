
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Производитель = ?(Параметры.Свойство("Производитель"),Параметры.Производитель,Справочники.Контрагенты.ПустаяСсылка());
	Клиент = ?(Параметры.Свойство("Клиент"),Параметры.Клиент,Справочники.Контрагенты.ПустаяСсылка());
	Список.Параметры.УстановитьЗначениеПараметра("Производитель", Производитель);
	Список.Параметры.УстановитьЗначениеПараметра("Клиент", Клиент);
КонецПроцедуры
