#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	//ЦенаВключаетНДС = Истина;
	ПроверитьСкладыСВидомЦены(Отказ);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вид цены, указанный у склада, остаётся ему подходящим (план docs/plans/retail-store-price.md, §1): вид цены продажи
// склада - в основной валюте, без динамического расчёта; минимальный вид склада - без динамического расчёта.
// Склады читаются служебно: у редактора видов цен прав на них может не быть.
//
// Параметры:
//  Отказ - Булево - выставляется при нарушении.
//
// BSLLS:SetPrivilegedMode-off
Процедура ПроверитьСкладыСВидомЦены(Отказ)
	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	// Вид, подходящий для продажи, подходит и минимальным: динамический расчёт исключён в обоих случаях.
	ПодходитДляПродажи = Не ДинамическийРасчет
		И (Не ЗначениеЗаполнено(Валюта) Или Валюта = РаботаСВалютами.ОсновнаяВалюта());
	Если ПодходитДляПродажи Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МестаХранения.Представление КАК Склад
	|ИЗ
	|	Справочник.МестаХранения КАК МестаХранения
	|ГДЕ
	|	МестаХранения.ВидЦеныПродажи = &Ссылка
	|	И НЕ МестаХранения.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МестаХранения.Представление
	|ИЗ
	|	Справочник.МестаХранения КАК МестаХранения
	|ГДЕ
	|	МестаХранения.ВидЦеныМинимальный = &Ссылка
	|	И &Динамический
	|	И НЕ МестаХранения.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Динамический", ДинамическийРасчет);
	УстановитьПривилегированныйРежим(Истина);
	Склады = Новый Массив;
	МаксимумВСообщении = 5;
	Для Каждого Склад Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Склад") Цикл
		Если Склады.Найти(Склад) = Неопределено И Склады.Количество() < МаксимумВСообщении Тогда
			Склады.Добавить(Склад);
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	Если Склады.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Вид цены указан у складов: %1. Для них вид цены продажи должен быть в основной валюте,
		|без динамического расчёта, минимальный вид - без динамического расчёта.';
		|fr = 'Le type de prix est indiqué sur les entrepôts : %1. Pour eux, le type de prix de vente doit être
		|en devise principale et sans calcul dynamique, le type minimal sans calcul dynamique.';
		|en = 'The price type is set on warehouses: %1. For them the sales price type must be in the main currency,
		|without dynamic calculation, the minimum type without dynamic calculation.';
		|es = 'El tipo de precio está indicado en los almacenes: %1. Para ellos el tipo de precio de venta debe
		|estar en la moneda principal y sin cálculo dinámico, el tipo mínimo sin cálculo dinámico.'");
	Текст = СтрШаблон(Шаблон, СтрСоединить(Склады, ", "));
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
КонецПроцедуры
// BSLLS:SetPrivilegedMode-on

#КонецОбласти
