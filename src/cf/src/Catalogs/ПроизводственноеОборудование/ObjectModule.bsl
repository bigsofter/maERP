#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Нормы по номенклатуре проверяются при любой записи, а не только интерактивной: программный Записать()
	// проверку заполнения не вызывает.
	ПроверитьВыработкуПоНоменклатуре(Отказ);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Режим работы станка: у смены без флажка «Круглосуточно» начало не равно окончанию (00:00 - пустая дата:
	// пустая строка не должна молча стать круглосуточной сменой), смены одного дня не пересекаются.
	Для Каждого Стр Из РежимРаботы Цикл
		Если Не Стр.Круглосуточно И Стр.НачалоСмены = Стр.ОкончаниеСмены Тогда
			ТекстОшибки = НСтр("ru = 'Укажите время начала и окончания смены или отметьте «Круглосуточно»';
				|fr = 'Indiquez l''heure de début et de fin du poste ou cochez « 24 h/24 »';
				|en = 'Enter the shift start and end time or select ""Around the clock""';
				|es = 'Indique la hora de inicio y fin del turno o marque «24 horas»'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,
				"РежимРаботы[" + Формат(Стр.НомерСтроки - 1, "ЧГ=0") + "].ОкончаниеСмены", , Отказ);
		КонецЕсли;
	КонецЦикла;
	ПроверитьПересечениеСмен(Отказ);
	// Склад станка: свой у каждого станка, без оповещения о минимуме и не подчинённый; при открытых
	// требованиях-накладных и закреплённых материалах не меняется.
	ТекстЗапрета = ТребованияНакладные.ТекстЗапретаСкладаСтанка(ЭтотОбъект);
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстЗапрета, ЭтотОбъект, "СкладСтанка", , Отказ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строки «Выработки по номенклатуре»: номенклатура заполнена и не повторяется, выработка больше нуля. Ошибка - у строки.
//
// Параметры:
//  Отказ - Булево - выставляется при ошибке
//
Процедура ПроверитьВыработкуПоНоменклатуре(Отказ)
	Встреченные = Новый Соответствие;
	Для Каждого Стр Из ВыработкаПоНоменклатуре Цикл
		ПутьСтроки = "ВыработкаПоНоменклатуре[" + Формат(Стр.НомерСтроки - 1, "ЧГ=0") + "].";
		Если Не ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			ТекстОшибки = НСтр("ru = 'Строка %1 выработки по номенклатуре: не указана номенклатура';
				|fr = 'Ligne %1 de la cadence par article : article non renseigné';
				|en = 'Line %1 of the output rate by item: the item is not specified';
				|es = 'Línea %1 del rendimiento por artículo: no se indica el artículo'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, Стр.НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, ПутьСтроки + "Номенклатура", , Отказ);
		ИначеЕсли Встреченные[Стр.Номенклатура] <> Неопределено Тогда
			ТекстОшибки = НСтр("ru = 'Строка %1 выработки по номенклатуре: «%2» уже указана в строке %3';
				|fr = 'Ligne %1 de la cadence par article : « %2 » figure déjà à la ligne %3';
				|en = 'Line %1 of the output rate by item: ""%2"" is already in line %3';
				|es = 'Línea %1 del rendimiento por artículo: «%2» ya figura en la línea %3'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, Стр.НомерСтроки, Стр.Номенклатура, Встреченные[Стр.Номенклатура]);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, ПутьСтроки + "Номенклатура", , Отказ);
		Иначе
			Встреченные.Вставить(Стр.Номенклатура, Стр.НомерСтроки);
		КонецЕсли;
		Если Стр.Выработка <= 0 Тогда
			ТекстОшибки = НСтр("ru = 'Строка %1 выработки по номенклатуре: укажите выработку, кг/ч';
				|fr = 'Ligne %1 de la cadence par article : indiquez le rendement, kg/h';
				|en = 'Line %1 of the output rate by item: enter the output, kg/h';
				|es = 'Línea %1 del rendimiento por artículo: indique el rendimiento, kg/h'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, Стр.НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, ПутьСтроки + "Выработка", , Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Смены одного дня недели не пересекаются: фонд времени сливает пересечения, и двойной ввод смены прошёл бы
// незаметно. Смена через полночь сверяется в пределах суток своего дня.
//
// Параметры:
//  Отказ - Булево - выставляется при пересечении
//
Процедура ПроверитьПересечениеСмен(Отказ)
	Для Индекс1 = 0 По РежимРаботы.Количество() - 1 Цикл
		Стр1 = РежимРаботы[Индекс1];
		Для Индекс2 = Индекс1 + 1 По РежимРаботы.Количество() - 1 Цикл
			Стр2 = РежимРаботы[Индекс2];
			Если Не ЗначениеЗаполнено(Стр1.ДеньНедели) Или Стр1.ДеньНедели <> Стр2.ДеньНедели Тогда
				Продолжить;
			КонецЕсли;
			Интервал1 = ЗагрузкаСтанков.СменаВСекундах(Стр1.НачалоСмены, Стр1.ОкончаниеСмены, Стр1.Круглосуточно);
			Интервал2 = ЗагрузкаСтанков.СменаВСекундах(Стр2.НачалоСмены, Стр2.ОкончаниеСмены, Стр2.Круглосуточно);
			Если Интервал1.НачалоСекунд < Интервал2.ОкончаниеСекунд И Интервал2.НачалоСекунд < Интервал1.ОкончаниеСекунд Тогда
				ТекстОшибки = НСтр("ru = 'Смены строк %1 и %2 пересекаются';
					|fr = 'Les postes des lignes %1 et %2 se chevauchent';
					|en = 'The shifts in lines %1 and %2 overlap';
					|es = 'Los turnos de las líneas %1 y %2 se solapan'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон(ТекстОшибки, Стр1.НомерСтроки, Стр2.НомерСтроки), ЭтотОбъект,
					"РежимРаботы[" + Формат(Стр2.НомерСтроки - 1, "ЧГ=0") + "].НачалоСмены", , Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
