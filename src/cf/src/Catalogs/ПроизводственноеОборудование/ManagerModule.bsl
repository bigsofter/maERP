#Область ПрограммныйИнтерфейс

// Отбор списка станков по признаку «Выведен»: выведенные станки скрыты, пока их не попросили показать. Отбор
// ставится только при включённом учёте станков - без опции реквизита в списке нет.
//
// Параметры:
//  Список     - ДинамическийСписок - список формы
//  Показывать - Булево - показывать выведенные станки
//
Процедура УстановитьОтборВыведенных(Список, Показывать = Ложь) Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтанков") Тогда
		Возврат;
	КонецЕсли;
	Поле = Новый ПолеКомпоновкиДанных("Выведен");
	Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ЭлементОтбора.ЛевоеЗначение = Поле Тогда
			ЭлементОтбора.Использование = Не Показывать;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Поле;
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;
	ЭлементОтбора.Использование = Не Показывать;

КонецПроцедуры

#КонецОбласти
