#Область ПрограммныйИнтерфейс

// Ордерный ли склад на дату (план docs/plans/warehouse-orders.md, «Ордерный склад»): единственная точка проверки -
// приход и расход такого склада оформляют ордера кладовщика.
//
// Параметры:
//  Склад - СправочникСсылка.МестаХранения - склад.
//  Дата  - Дата - дата документа или движения.
//
// Возвращаемое значение:
//  Булево - Истина, если признак установлен и дата не раньше даты начала ордерной схемы.
//
Функция ОрдерныйСклад(Склад, Дата) Экспорт
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Ложь;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Склад, "ОрдерныйСклад, ДатаНачалаОрдернойСхемы");
	Возврат ОрдерныйНаДату(Реквизиты.ОрдерныйСклад, Реквизиты.ДатаНачалаОрдернойСхемы, Дата);
КонецФункции

// Правило ордерности на дату по реквизитам склада - общее для проверки склада, запросов и записи справочника.
//
// Параметры:
//  Признак    - Булево - реквизит ОрдерныйСклад.
//  ДатаНачала - Дата - реквизит ДатаНачалаОрдернойСхемы; пустая - с начала учёта.
//  Дата       - Дата - проверяемая дата.
//
// Возвращаемое значение:
//  Булево - Истина, если на дату склад ордерный.
//
Функция ОрдерныйНаДату(Признак, ДатаНачала, Дата) Экспорт
	Если ТипЗнч(Признак) <> Тип("Булево") Или Не Признак Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ЗначениеЗаполнено(ДатаНачала) Или НачалоДня(Дата) >= НачалоДня(ДатаНачала);
КонецФункции

// Склады, ордерные хоть на какую-то дату (признак установлен), с датами начала схемы - одним запросом для проверки
// многих записей движений (см. ОрдерныйНаДату).
//
// Возвращаемое значение:
//  Соответствие - СправочникСсылка.МестаХранения -> Дата (ДатаНачалаОрдернойСхемы; пустая - с начала учёта).
//
Функция ДатыНачалаОрдерности() Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка,
	|	Склады.ДатаНачалаОрдернойСхемы КАК ДатаНачала
	|ИЗ
	|	Справочник.МестаХранения КАК Склады
	|ГДЕ
	|	Склады.ОрдерныйСклад");
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.ДатаНачала);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Отбор выбора склада в форме документа: ордера выбирают только ордерные склады, поступление и реализация без ордера -
// только неордерные (решение владельца 5). Дата начала схемы не фильтруется - её держит проверка проведения.
//
// Параметры:
//  Элемент   - ПолеФормы - поле склада.
//  Ордерные  - Булево - Истина: показывать ордерные склады; Ложь - неордерные.
//
Процедура УстановитьОтборОрдерности(Элемент, Ордерные) Экспорт
	Параметры = Новый Массив;
	Для Каждого Параметр Из Элемент.ПараметрыВыбора Цикл
		Если Параметр.Имя <> "Отбор.ОрдерныйСклад" Тогда
			Параметры.Добавить(Параметр);
		КонецЕсли;
	КонецЦикла;
	// Опция выключена - признак скрыт опцией, а ордерных складов нет (инвариант): отбор по нему не нужен.
	Если ОрдерныеСкладыВключены() Тогда
		Параметры.Добавить(Новый ПараметрВыбора("Отбор.ОрдерныйСклад", Ордерные));
	КонецЕсли;
	Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(Параметры);
КонецПроцедуры

// Значение опции «Ордерные склады» из константы, а не через ПолучитьФункциональнуюОпцию: значение опции запоминается
// на весь серверный вызов (tiny1C bsl-023), а проверки записи должны видеть константу, прочитанную под блокировкой.
//
// Возвращаемое значение:
//  Булево - константа ИспользоватьОрдерныеСклады.
//
// BSLLS:SetPrivilegedMode-off - чтение одной константы опции, без записи.
Функция ОрдерныеСкладыВключены() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ИспользоватьОрдерныеСклады.Получить() = Истина;
КонецФункции
// BSLLS:SetPrivilegedMode-on

// Используется ли ордерная схема в базе (план warehouse-orders-option): есть склад с признаком ордерности или хотя бы
// один приходный или расходный ордер - в том числе непроведённый или помеченный на удаление. Тогда опцию нельзя
// выключить, а обработчик обновления её включает.
//
// Возвращаемое значение:
//  Булево - Истина, если ордерная схема используется.
//
Функция ОрдерныеСкладыИспользуются() Экспорт
	Возврат ПричиныОрдерности().Количество() > 0;
КонецФункции

// Текст запрета выключить опцию «Ордерные склады» - пустой, если выключить можно. Проверку вызывает запись константы
// (под исключительной блокировкой опции) и форма настроек до записи.
//
// Возвращаемое значение:
//  Строка - причины запрета на языке пользователя.
//
Функция ТекстЗапретаВыключенияОрдерности() Экспорт
	Причины = ПричиныОрдерности();
	Тексты = Новый Массив;
	Если Причины.Свойство("Склады") Тогда
		Шаблон = НСтр("ru = 'Опцию «Ордерные склады» нельзя выключить: есть ордерные склады (%1).
			|Снимите у них признак «Ордерный склад».';
			|fr = 'L''option « Entrepôts à bons » ne peut pas être désactivée : des entrepôts fonctionnent par bons (%1).
			|Décochez « Entrepôt à bons » sur ces entrepôts.';
			|en = 'The «Order-based warehouses» option cannot be turned off: there are order-based warehouses (%1).
			|Clear «Order-based warehouse» on them.';
			|es = 'La opción «Almacenes con órdenes» no se puede desactivar: hay almacenes por órdenes (%1).
			|Desmarque «Almacén por órdenes» en ellos.'");
		Тексты.Добавить(СтрШаблон(Шаблон, Причины.Склады));
	КонецЕсли;
	Если Причины.Свойство("Ордера") Тогда
		Тексты.Добавить(НСтр("ru = 'Опцию «Ордерные склады» нельзя выключить: в базе есть приходные или расходные ордера.';
			|fr = 'L''option « Entrepôts à bons » ne peut pas être désactivée : la base contient des bons d''entrée ou de sortie.';
			|en = 'The «Order-based warehouses» option cannot be turned off: the database contains receiving or goods issue orders.';
			|es = 'La opción «Almacenes con órdenes» no se puede desactivar: la base contiene órdenes de entrada o de salida.'"));
	КонецЕсли;
	Возврат СтрСоединить(Тексты, Символы.ПС);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Причины, по которым ордерная схема считается используемой, - одним пакетом запросов.
//
// Возвращаемое значение:
//  Структура - ключи только при наличии причины:
//   * Склады - Строка - до пяти ордерных складов через запятую и «…ещё N».
//   * Ордера - Булево - в базе есть приходный или расходный ордер.
//
// BSLLS:SetPrivilegedMode-off - проверка инварианта видит все склады и ордера, а не только доступные пользователю.
// BSLLS:SelectTopWithoutOrderBy-off - ПЕРВЫЕ 1 - проверка существования, порядок не важен.
Функция ПричиныОрдерности()
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка,
	|	Склады.Наименование КАК Представление
	|ИЗ
	|	Справочник.МестаХранения КАК Склады
	|ГДЕ
	|	Склады.ОрдерныйСклад
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склады.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Приходные.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходныйОрдер КАК Приходные
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Расходные.Ссылка
	|ИЗ
	|	Документ.РасходныйОрдер КАК Расходные");
	Результаты = Запрос.ВыполнитьПакет();
	Причины = Новый Структура;
	Склады = Результаты[0].Выгрузить();
	Если Склады.Количество() > 0 Тогда
		ПоказыватьСкладов = 5;
		Имена = Новый Массив;
		Для Каждого Склад Из Склады Цикл
			Если Имена.Количество() = ПоказыватьСкладов Тогда
				Прервать;
			КонецЕсли;
			Имена.Добавить(Склад.Представление);
		КонецЦикла;
		Список = СтрСоединить(Имена, ", ");
		Если Склады.Количество() > ПоказыватьСкладов Тогда
			Список = Список + СтрШаблон(НСтр("ru = ' …ещё %1'; fr = ' …et %1 de plus'; en = ' …%1 more'; es = ' …%1 más'"),
				Склады.Количество() - ПоказыватьСкладов);
		КонецЕсли;
		Причины.Вставить("Склады", Список);
	КонецЕсли;
	Если Не Результаты[1].Пустой() Тогда
		Причины.Вставить("Ордера", Истина);
	КонецЕсли;
	Возврат Причины;
КонецФункции
// BSLLS:SelectTopWithoutOrderBy-on
// BSLLS:SetPrivilegedMode-on

#КонецОбласти
