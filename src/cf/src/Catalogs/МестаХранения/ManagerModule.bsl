#Область ПрограммныйИнтерфейс

// Ордерный ли склад на дату (план docs/plans/warehouse-orders.md, «Ордерный склад»): единственная точка проверки -
// приход и расход такого склада оформляют ордера кладовщика.
//
// Параметры:
//  Склад - СправочникСсылка.МестаХранения - склад.
//  Дата  - Дата - дата документа или движения.
//
// Возвращаемое значение:
//  Булево - Истина, если признак установлен и дата не раньше даты начала ордерной схемы.
//
Функция ОрдерныйСклад(Склад, Дата) Экспорт
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Ложь;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Склад, "ОрдерныйСклад, ДатаНачалаОрдернойСхемы");
	Возврат ОрдерныйНаДату(Реквизиты.ОрдерныйСклад, Реквизиты.ДатаНачалаОрдернойСхемы, Дата);
КонецФункции

// Правило ордерности на дату по реквизитам склада - общее для проверки склада, запросов и записи справочника.
//
// Параметры:
//  Признак    - Булево - реквизит ОрдерныйСклад.
//  ДатаНачала - Дата - реквизит ДатаНачалаОрдернойСхемы; пустая - с начала учёта.
//  Дата       - Дата - проверяемая дата.
//
// Возвращаемое значение:
//  Булево - Истина, если на дату склад ордерный.
//
Функция ОрдерныйНаДату(Признак, ДатаНачала, Дата) Экспорт
	Если ТипЗнч(Признак) <> Тип("Булево") Или Не Признак Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ЗначениеЗаполнено(ДатаНачала) Или НачалоДня(Дата) >= НачалоДня(ДатаНачала);
КонецФункции

// Склады, ордерные хоть на какую-то дату (признак установлен), с датами начала схемы - одним запросом для проверки
// многих записей движений (см. ОрдерныйНаДату).
//
// Возвращаемое значение:
//  Соответствие - СправочникСсылка.МестаХранения -> Дата (ДатаНачалаОрдернойСхемы; пустая - с начала учёта).
//
Функция ДатыНачалаОрдерности() Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка,
	|	Склады.ДатаНачалаОрдернойСхемы КАК ДатаНачала
	|ИЗ
	|	Справочник.МестаХранения КАК Склады
	|ГДЕ
	|	Склады.ОрдерныйСклад");
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.ДатаНачала);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Отбор выбора склада в форме документа: ордера выбирают только ордерные склады, поступление и реализация без ордера -
// только неордерные (решение владельца 5). Дата начала схемы не фильтруется - её держит проверка проведения.
//
// Параметры:
//  Элемент   - ПолеФормы - поле склада.
//  Ордерные  - Булево - Истина: показывать ордерные склады; Ложь - неордерные.
//
Процедура УстановитьОтборОрдерности(Элемент, Ордерные) Экспорт
	Параметры = Новый Массив;
	Для Каждого Параметр Из Элемент.ПараметрыВыбора Цикл
		Если Параметр.Имя <> "Отбор.ОрдерныйСклад" Тогда
			Параметры.Добавить(Параметр);
		КонецЕсли;
	КонецЦикла;
	// Опция выключена - признак скрыт опцией, а ордерных складов нет (инвариант): отбор по нему не нужен.
	Если ОрдерныеСкладыВключены() Тогда
		Параметры.Добавить(Новый ПараметрВыбора("Отбор.ОрдерныйСклад", Ордерные));
	КонецЕсли;
	Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(Параметры);
КонецПроцедуры

// Значение опции «Ордерные склады» из константы, а не через ПолучитьФункциональнуюОпцию: значение опции запоминается
// на весь серверный вызов (tiny1C bsl-023), а проверки записи должны видеть константу, прочитанную под блокировкой.
//
// Возвращаемое значение:
//  Булево - константа ИспользоватьОрдерныеСклады.
//
// BSLLS:SetPrivilegedMode-off - чтение одной константы опции, без записи.
Функция ОрдерныеСкладыВключены() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ИспользоватьОрдерныеСклады.Получить() = Истина;
КонецФункции
// BSLLS:SetPrivilegedMode-on

// Используется ли ордерная схема в базе (план warehouse-orders-option): есть склад с признаком ордерности или хотя бы
// один приходный или расходный ордер - в том числе непроведённый или помеченный на удаление. Тогда опцию нельзя
// выключить, а обработчик обновления её включает.
//
// Возвращаемое значение:
//  Булево - Истина, если ордерная схема используется.
//
Функция ОрдерныеСкладыИспользуются() Экспорт
	Возврат ПричиныОрдерности().Количество() > 0;
КонецФункции

// Текст запрета выключить опцию «Ордерные склады» - пустой, если выключить можно. Проверку вызывает запись константы
// (под исключительной блокировкой опции) и форма настроек до записи.
//
// Возвращаемое значение:
//  Строка - причины запрета на языке пользователя.
//
Функция ТекстЗапретаВыключенияОрдерности() Экспорт
	Причины = ПричиныОрдерности();
	Тексты = Новый Массив;
	Если Причины.Свойство("Склады") Тогда
		Шаблон = НСтр("ru = 'Опцию «Ордерные склады» нельзя выключить: есть ордерные склады (%1).
			|Снимите у них признак «Ордерный склад».';
			|fr = 'L''option « Entrepôts à bons » ne peut pas être désactivée : des entrepôts fonctionnent par bons (%1).
			|Décochez « Entrepôt à bons » sur ces entrepôts.';
			|en = 'The «Order-based warehouses» option cannot be turned off: there are order-based warehouses (%1).
			|Clear «Order-based warehouse» on them.';
			|es = 'La opción «Almacenes con órdenes» no se puede desactivar: hay almacenes por órdenes (%1).
			|Desmarque «Almacén por órdenes» en ellos.'");
		Тексты.Добавить(СтрШаблон(Шаблон, Причины.Склады));
	КонецЕсли;
	Если Причины.Свойство("Ордера") Тогда
		Тексты.Добавить(НСтр("ru = 'Опцию «Ордерные склады» нельзя выключить: в базе есть приходные или расходные ордера.';
			|fr = 'L''option « Entrepôts à bons » ne peut pas être désactivée : la base contient des bons d''entrée ou de sortie.';
			|en = 'The «Order-based warehouses» option cannot be turned off: the database contains receiving or goods issue orders.';
			|es = 'La opción «Almacenes con órdenes» no se puede desactivar: la base contiene órdenes de entrada o de salida.'"));
	КонецЕсли;
	Возврат СтрСоединить(Тексты, Символы.ПС);
КонецФункции

// Вид цены продажи склада (план docs/plans/retail-store-price.md, §1). Пусто - место выбора цены работает по своему
// прежнему правилу. Вид, не подходящий складу (см. ВидЦеныДопустимДляСклада), мог прийти загрузкой данных мимо
// проверки записи: он не используется, в журнал регистрации - предупреждение.
//
// Параметры:
//  Склад - СправочникСсылка.МестаХранения - склад продажи.
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыЦен - вид цены склада или пустая ссылка.
//
Функция ВидЦеныПродажи(Склад) Экспорт
	Пустой = Справочники.ВидыЦен.ПустаяСсылка();
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Пустой;
	КонецЕсли;
	ВидЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "ВидЦеныПродажи");
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат Пустой;
	КонецЕсли;
	Если ВидЦеныДопустимДляСклада(ВидЦены, Истина) Тогда
		Возврат ВидЦены;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Вид цены склада «%1» не используется: нужен вид в основной валюте без динамического расчёта.';
		|fr = 'Le type de prix « %1 » de l''entrepôt n''est pas utilisé : il faut un type en devise principale
		|sans calcul dynamique.';
		|en = 'Warehouse price type «%1» is not used: a type in the main currency without dynamic calculation
		|is required.';
		|es = 'El tipo de precio «%1» del almacén no se usa: se necesita un tipo en la moneda principal
		|sin cálculo dinámico.'");
	Комментарий = СтрШаблон(Шаблон, ВидЦены);
	МетаданныеСклада = Метаданные.Справочники.МестаХранения;
	ЗаписьЖурналаРегистрации("Цены.ВидЦеныСклада", УровеньЖурналаРегистрации.Предупреждение, МетаданныеСклада, Склад,
		Комментарий);
	Возврат Пустой;
КонецФункции

// Подходит ли вид цены складу. Касса берёт цену вида как есть - как цену с НДС в основной валюте, независимо от
// признака ЦенаВключаетНДС вида (так касса всегда работала с «Розничной», у которой признак в базах снят), а её подбор -
// динамический список, где пересчитать валюту и динамический расчёт нельзя; минимальный вид читается строго как есть,
// поэтому тоже без динамического расчёта.
//
// Параметры:
//  ВидЦены    - СправочникСсылка.ВидыЦен - проверяемый вид.
//  ДляПродажи - Булево - Истина: вид цены продажи склада (основная валюта, без динамики);
//               Ложь: минимальный вид (без динамики).
//
// Возвращаемое значение:
//  Булево - Истина, если вид подходит.
//
Функция ВидЦеныДопустимДляСклада(ВидЦены, ДляПродажи) Экспорт
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидЦены, "Валюта, ДинамическийРасчет");
	Если Данные.ДинамическийРасчет = Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ДляПродажи Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Не ЗначениеЗаполнено(Данные.Валюта) Или Данные.Валюта = РаботаСВалютами.ОсновнаяВалюта();
КонецФункции

// Режим контроля минимальной цены склада. Пустое значение реквизита (склады, записанные до появления реквизита)
// означает «не контролировать»: прямых сравнений реквизита в коде нет, только эта функция.
//
// Параметры:
//  Склад - СправочникСсылка.МестаХранения - склад.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.РежимыКонтроляМинимальнойЦены - режим, никогда не пустой.
//
Функция РежимКонтроляМинимальнойЦены(Склад) Экспорт
	НеКонтролировать = Перечисления.РежимыКонтроляМинимальнойЦены.НеКонтролировать;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат НеКонтролировать;
	КонецЕсли;
	Режим = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "КонтрольМинимальнойЦены");
	Возврат ?(ЗначениеЗаполнено(Режим), Режим, НеКонтролировать);
КонецФункции

// Цены продажи склада за единицу хранения - одно правило для строки кассы и для сеток подбора и избранного (план, §1):
// цена вида склада, нет её - цена «Розничной», если «Розничная» подходит складу. Срез цен не уникален по номенклатуре
// и характеристике (измерение ТоварнаяГруппа): берётся последний период пары, при нескольких записях периода -
// максимум цены (как в ИзбраннаяНоменклатураРМК.ИзбранноеПользователя). Коэффициент упаковки записи -
// ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы, сейчас 1 во всей конфигурации, поэтому цена берётся как есть.
//
// Параметры:
//  Склад        - СправочникСсылка.МестаХранения - склад с заполненным видом цены продажи.
//  Номенклатура - Массив из СправочникСсылка.Номенклатура, СправочникСсылка.Номенклатура - товары.
//  Дата         - Дата - дата цен.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Цена.
//
Функция ЦеныПродажиСклада(Склад, Номенклатура, Дата) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Срез.ВидЦены КАК ВидЦены,
	|	Срез.Номенклатура КАК Номенклатура,
	|	Срез.Характеристика КАК Характеристика,
	|	Срез.Период КАК Период,
	|	Срез.Цена КАК Цена
	|ПОМЕСТИТЬ ВТСрез
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаЦен,
	|			ВидЦены В (&ВидЦеныСклада, &ВидЦеныОтката)
	|				И Номенклатура В (&Номенклатура)) КАК Срез
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидЦены,
	|	Номенклатура,
	|	Характеристика,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСрез.ВидЦены КАК ВидЦены,
	|	ВТСрез.Номенклатура КАК Номенклатура,
	|	ВТСрез.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ВТСрез.Период) КАК Период
	|ПОМЕСТИТЬ ВТПоследние
	|ИЗ
	|	ВТСрез КАК ВТСрез
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСрез.ВидЦены,
	|	ВТСрез.Номенклатура,
	|	ВТСрез.Характеристика
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидЦены,
	|	Номенклатура,
	|	Характеристика,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПоследние.ВидЦены КАК ВидЦены,
	|	ВТПоследние.Номенклатура КАК Номенклатура,
	|	ВТПоследние.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ВТСрез.Цена) КАК Цена
	|ИЗ
	|	ВТПоследние КАК ВТПоследние
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСрез КАК ВТСрез
	|		ПО ВТПоследние.ВидЦены = ВТСрез.ВидЦены
	|			И ВТПоследние.Номенклатура = ВТСрез.Номенклатура
	|			И ВТПоследние.Характеристика = ВТСрез.Характеристика
	|			И ВТПоследние.Период = ВТСрез.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПоследние.ВидЦены,
	|	ВТПоследние.Номенклатура,
	|	ВТПоследние.Характеристика");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ДатаЦен", Дата);
	ПараметрыЦен = ПараметрыЦенПродажиСклада(Склад);
	Для Каждого КлючИЗначение Из ПараметрыЦен Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	ПоВидам = Запрос.Выполнить().Выгрузить();
	ВидСклада = ПараметрыЦен.ВидЦеныСклада;
	Результат = ПоВидам.СкопироватьКолонки("Номенклатура, Характеристика, Цена");
	Для Каждого Стр Из ПоВидам Цикл
		Если Стр.ВидЦены = ВидСклада Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	// Откат на «Розничную» - для пар, у которых нет цены вида склада.
	Для Каждого Стр Из ПоВидам Цикл
		Если Стр.ВидЦены = ВидСклада Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("Номенклатура, Характеристика", Стр.Номенклатура, Стр.Характеристика);
		Если Результат.НайтиСтроки(Отбор).Количество() = 0 Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Значения параметров вида цены склада и вида отката для цен продажи склада (см. ЦеныПродажиСклада и запрос подбора
// кассы). «Розничная», не подходящая складу, откатом не служит: вид отката - пустая ссылка, у которой цен нет.
//
// Параметры:
//  Склад - СправочникСсылка.МестаХранения - склад продажи.
//
// Возвращаемое значение:
//  Структура - ВидЦеныСклада, ВидЦеныОтката (СправочникСсылка.ВидыЦен).
//
Функция ПараметрыЦенПродажиСклада(Склад) Экспорт
	Розничная = Справочники.ВидыЦен.Розничная;
	Откат = Справочники.ВидыЦен.ПустаяСсылка();
	Если ВидЦеныДопустимДляСклада(Розничная, Истина) Тогда
		Откат = Розничная;
	КонецЕсли;
	Значения = Новый Структура;
	Значения.Вставить("ВидЦеныСклада", ВидЦеныПродажи(Склад));
	Значения.Вставить("ВидЦеныОтката", Откат);
	Возврат Значения;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Причины, по которым ордерная схема считается используемой, - одним пакетом запросов.
//
// Возвращаемое значение:
//  Структура - ключи только при наличии причины:
//   * Склады - Строка - до пяти ордерных складов через запятую и «…ещё N».
//   * Ордера - Булево - в базе есть приходный или расходный ордер.
//
// BSLLS:SetPrivilegedMode-off - проверка инварианта видит все склады и ордера, а не только доступные пользователю.
// BSLLS:SelectTopWithoutOrderBy-off - ПЕРВЫЕ 1 - проверка существования, порядок не важен.
Функция ПричиныОрдерности()
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка,
	|	Склады.Наименование КАК Представление
	|ИЗ
	|	Справочник.МестаХранения КАК Склады
	|ГДЕ
	|	Склады.ОрдерныйСклад
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склады.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Приходные.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходныйОрдер КАК Приходные
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Расходные.Ссылка
	|ИЗ
	|	Документ.РасходныйОрдер КАК Расходные");
	Результаты = Запрос.ВыполнитьПакет();
	Причины = Новый Структура;
	Склады = Результаты[0].Выгрузить();
	Если Склады.Количество() > 0 Тогда
		ПоказыватьСкладов = 5;
		Имена = Новый Массив;
		Для Каждого Склад Из Склады Цикл
			Если Имена.Количество() = ПоказыватьСкладов Тогда
				Прервать;
			КонецЕсли;
			Имена.Добавить(Склад.Представление);
		КонецЦикла;
		Список = СтрСоединить(Имена, ", ");
		Если Склады.Количество() > ПоказыватьСкладов Тогда
			Список = Список + СтрШаблон(НСтр("ru = ' …ещё %1'; fr = ' …et %1 de plus'; en = ' …%1 more'; es = ' …%1 más'"),
				Склады.Количество() - ПоказыватьСкладов);
		КонецЕсли;
		Причины.Вставить("Склады", Список);
	КонецЕсли;
	Если Не Результаты[1].Пустой() Тогда
		Причины.Вставить("Ордера", Истина);
	КонецЕсли;
	Возврат Причины;
КонецФункции
// BSLLS:SelectTopWithoutOrderBy-on
// BSLLS:SetPrivilegedMode-on

#КонецОбласти
