#Область ОбработчикиСобытий

// Проверки ордерной схемы - и при загрузке данных: режим склада определяет толкование уже записанных движений
// поступлений и реализаций, обходить его обменом нельзя (план warehouse-orders, фаза 2, §2.2). Связи с оборудованием и
// документы склада читаются служебно - у редактора складов прав на них может не быть.
//
// Параметры:
//  Отказ - Булево - выставляется при нарушении ордерной схемы.
//
// BSLLS:DataExchangeLoading-off
// BSLLS:SetPrivilegedMode-off
Процедура ПередЗаписью(Отказ)
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Прежние = ПрежниеРеквизиты();
	ЗаблокироватьСклады(Прежние);
	Тексты = Новый Массив;
	ПроверитьЗапрещенныеСочетания(Прежние, Тексты);
	ПроверитьИнтервалСменыРежима(Прежние, Тексты);
	Если Не ОбменДанными.Загрузка Тогда
		ПроверитьВидыЦен(Тексты);
	КонецЕсли;
	Для Каждого Текст Из Тексты Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ЭтотОбъект, , , Отказ);
	КонецЦикла;
КонецПроцедуры
// BSLLS:SetPrivilegedMode-on
// BSLLS:DataExchangeLoading-on

// Новый склад - без контроля минимальной цены (план docs/plans/retail-store-price.md, §2).
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - данные заполнения.
//  ТекстЗаполнения - Строка - текст заполнения.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(КонтрольМинимальнойЦены) Тогда
		КонтрольМинимальнойЦены = Перечисления.РежимыКонтроляМинимальнойЦены.НеКонтролировать;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вид цены продажи склада - в основной валюте, без динамического расчёта; минимальный вид - без динамического
// расчёта (Справочники.МестаХранения.ВидЦеныДопустимДляСклада).
//
// Параметры:
//  Тексты - Массив из Строка - тексты нарушений.
//
Процедура ПроверитьВидыЦен(Тексты)
	Если ЗначениеЗаполнено(ВидЦеныПродажи)
		И Не Справочники.МестаХранения.ВидЦеныДопустимДляСклада(ВидЦеныПродажи, Истина) Тогда
		Шаблон = НСтр("ru = 'Вид цены продажи «%1» не подходит складу: нужен вид в основной валюте
			|без динамического расчёта.';
			|fr = 'Le type de prix de vente « %1 » ne convient pas à l''entrepôt : il faut un type en devise
			|principale sans calcul dynamique.';
			|en = 'Sales price type «%1» does not suit the warehouse: a type in the main currency
			|without dynamic calculation is required.';
			|es = 'El tipo de precio de venta «%1» no es apto para el almacén: se necesita un tipo en la moneda
			|principal sin cálculo dinámico.'");
		Текст = СтрШаблон(Шаблон, ВидЦеныПродажи);
		Тексты.Добавить(Текст);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидЦеныМинимальный)
		И Не Справочники.МестаХранения.ВидЦеныДопустимДляСклада(ВидЦеныМинимальный, Ложь) Тогда
		Шаблон = НСтр("ru = 'Минимальный вид цены «%1» не подходит складу: вид с динамическим расчётом
			|не может быть порогом.';
			|fr = 'Le type de prix minimal « %1 » ne convient pas à l''entrepôt : un type à calcul dynamique
			|ne peut pas servir de seuil.';
			|en = 'Minimum price type «%1» does not suit the warehouse: a type with dynamic calculation
			|cannot be a threshold.';
			|es = 'El tipo de precio mínimo «%1» no es apto para el almacén: un tipo con cálculo dinámico
			|no puede ser umbral.'");
		Текст = СтрШаблон(Шаблон, ВидЦеныМинимальный);
		Тексты.Добавить(Текст);
	КонецЕсли;
КонецПроцедуры

Функция ПрежниеРеквизиты()
	Прежние = Новый Структура("ОрдерныйСклад, ДатаНачалаОрдернойСхемы, ПодчиненныйСклад", Ложь, '00010101',
		Справочники.МестаХранения.ПустаяСсылка());
	Если Не ЭтоНовый() Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "ОрдерныйСклад, ДатаНачалаОрдернойСхемы, ПодчиненныйСклад");
		ЗаполнитьЗначенияСвойств(Прежние, Реквизиты);
	КонецЕсли;
	Возврат Прежние;
КонецФункции

// Протокол блокировок склада (план, «Ордерный склад»): запись склада берёт исключительную блокировку себя, прежнего и
// нового подчинённого склада до чтения связей - писатели родителя и оборудования пересекаются с ней на тех же ключах.
//
// Параметры:
//  Прежние - Структура - см. ПрежниеРеквизиты.
//
Процедура ЗаблокироватьСклады(Прежние)
	Склады = Новый Массив;
	Если Не ЭтоНовый() Тогда
		Склады.Добавить(Ссылка);
	КонецЕсли;
	Если ЗначениеЗаполнено(Прежние.ПодчиненныйСклад) Тогда
		Склады.Добавить(Прежние.ПодчиненныйСклад);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПодчиненныйСклад) Тогда
		Склады.Добавить(ПодчиненныйСклад);
	КонецЕсли;
	Если Склады.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	УправляемыеБлокировки.МестаХранения(Блокировка, Склады, Истина);
	Блокировка.Заблокировать();
КонецПроцедуры

// Ордерным не может быть предопределённый склад «в пути», склад станка и склад, назначенный кому-то подчинённым;
// ордерный склад нельзя назначить подчинённым (поступление приходует подчинённый склад зеркалом партий).
//
// Параметры:
//  Прежние - Структура - см. ПрежниеРеквизиты.
//  Тексты  - Массив из Строка - тексты отказа.
//
Процедура ПроверитьЗапрещенныеСочетания(Прежние, Тексты)
	Если ЗначениеЗаполнено(ПодчиненныйСклад) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПодчиненныйСклад, "ОрдерныйСклад") = Истина Тогда
		Тексты.Добавить(НСтр("ru = 'Ордерный склад нельзя назначить подчинённым складом.';
			|fr = 'Un entrepôt à bons ne peut pas être désigné comme entrepôt subordonné.';
			|en = 'An order-based warehouse cannot be set as a subordinate warehouse.';
			|es = 'Un almacén por órdenes no puede asignarse como almacén subordinado.'"));
	КонецЕсли;
	Если Не ОрдерныйСклад Тогда
		Возврат;
	КонецЕсли;
	// Признак появляется только при включённой опции: выключенная опция означает, что ордерных складов нет
	// (план warehouse-orders-option). Константа читается под разделяемой блокировкой, после блокировки складов.
	Если Не Прежние.ОрдерныйСклад Тогда
		Блокировка = Новый БлокировкаДанных;
		УправляемыеБлокировки.ОпцияОрдерныхСкладов(Блокировка, Ложь);
		Блокировка.Заблокировать();
		Если Не Справочники.МестаХранения.ОрдерныеСкладыВключены() Тогда
			Тексты.Добавить(НСтр("ru = 'Ордерный склад можно назначить только при включённой опции «Ордерные склады» (настройки, раздел «Склад»).';
				|fr = 'Un entrepôt à bons ne peut être défini que si l''option « Entrepôts à bons » est activée (paramètres, section « Entrepôt »).';
				|en = 'An order-based warehouse can only be set when the «Order-based warehouses» option is on (settings, «Warehouse» section).';
				|es = 'Un almacén por órdenes solo se puede asignar con la opción «Almacenes con órdenes» activada (ajustes, sección «Almacén»).'"));
		КонецЕсли;
	КонецЕсли;
	Если Не ЭтоНовый() И Ссылка = Справочники.МестаХранения.StockEnCoursDeRoute Тогда
		Тексты.Добавить(НСтр("ru = 'Склад «в пути» не может быть ордерным.';
			|fr = 'L''entrepôt « en cours de route » ne peut pas fonctionner par bons.';
			|en = 'The «in transit» warehouse cannot be order-based.';
			|es = 'El almacén «en tránsito» no puede funcionar por órdenes.'"));
	КонецЕсли;
	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Оборудование.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПроизводственноеОборудование КАК Оборудование
	|ГДЕ
	|	Оборудование.СкладСтанка = &Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Родители.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.МестаХранения КАК Родители
	|ГДЕ
	|	Родители.ПодчиненныйСклад = &Склад
	|	И Родители.Ссылка <> &Склад");
	Запрос.УстановитьПараметр("Склад", Ссылка);
	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[0].Выбрать();
	Если Выборка.Следующий() Тогда
		Шаблон = НСтр("ru = 'Склад станка «%1» не может быть ордерным.';
			|fr = 'L''entrepôt de la machine « %1 » ne peut pas fonctionner par bons.';
			|en = 'The warehouse of machine «%1» cannot be order-based.';
			|es = 'El almacén de la máquina «%1» no puede funcionar por órdenes.'");
		Тексты.Добавить(СтрШаблон(Шаблон, Выборка.Ссылка));
	КонецЕсли;
	Выборка = Результаты[1].Выбрать();
	Если Выборка.Следующий() Тогда
		Шаблон = НСтр("ru = 'Склад назначен подчинённым складу «%1» и не может быть ордерным.';
			|fr = 'L''entrepôt est subordonné à l''entrepôt « %1 » et ne peut pas fonctionner par bons.';
			|en = 'The warehouse is subordinate to warehouse «%1» and cannot be order-based.';
			|es = 'El almacén está subordinado al almacén «%1» y no puede funcionar por órdenes.'");
		Тексты.Добавить(СтрШаблон(Шаблон, Выборка.Ссылка));
	КонецЕсли;
КонецПроцедуры

// Любое изменение режима - включение, выключение, перенос даты начала - меняет толкование документов между старой и
// новой границей. Проведённые поступления, реализации и ордера склада в этом интервале - отказ со списком.
//
// Параметры:
//  Прежние - Структура - см. ПрежниеРеквизиты.
//  Тексты  - Массив из Строка - тексты отказа.
//
Процедура ПроверитьИнтервалСменыРежима(Прежние, Тексты)
	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Интервал = ИнтервалСменыРежима(Прежние);
	Если Интервал = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.Дата КАК Дата
	|ИЗ
	|	(ВЫБРАТЬ
	|		Поступления.Ссылка КАК Ссылка,
	|		Поступления.Дата КАК Дата
	|	ИЗ
	|		Документ.ПоступлениеТоваровУслуг КАК Поступления
	|	ГДЕ
	|		Поступления.МестоХранения = &Склад
	|		И Поступления.Проведен
	|		И Поступления.Дата >= &Начало
	|		И Поступления.Дата < &Конец
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Реализации.Ссылка,
	|		Реализации.Дата
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг КАК Реализации
	|	ГДЕ
	|		Реализации.МестоХранения = &Склад
	|		И Реализации.Проведен
	|		И Реализации.Дата >= &Начало
	|		И Реализации.Дата < &Конец
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Приходные.Ссылка,
	|		Приходные.Дата
	|	ИЗ
	|		Документ.ПриходныйОрдер КАК Приходные
	|	ГДЕ
	|		Приходные.МестоХранения = &Склад
	|		И Приходные.Проведен
	|		И Приходные.Дата >= &Начало
	|		И Приходные.Дата < &Конец
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Расходные.Ссылка,
	|		Расходные.Дата
	|	ИЗ
	|		Документ.РасходныйОрдер КАК Расходные
	|	ГДЕ
	|		Расходные.МестоХранения = &Склад
	|		И Расходные.Проведен
	|		И Расходные.Дата >= &Начало
	|		И Расходные.Дата < &Конец) КАК Документы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата");
	Запрос.УстановитьПараметр("Склад", Ссылка);
	Запрос.УстановитьПараметр("Начало", Интервал.Начало);
	Запрос.УстановитьПараметр("Конец", Интервал.Конец);
	// Не «Документы»: имя занято свойством глобального контекста, присваивание ему - ошибка выполнения.
	ДокументыСклада = Запрос.Выполнить().Выгрузить();
	Если ДокументыСклада.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Список = Новый Массив;
	ПоказыватьДокументов = 10;
	Для Индекс = 0 По Мин(ДокументыСклада.Количество(), ПоказыватьДокументов) - 1 Цикл
		Список.Добавить(Строка(ДокументыСклада[Индекс].Ссылка));
	КонецЦикла;
	Шаблон = НСтр("ru = 'Смена ордерной схемы склада затрагивает проведённые документы (сначала отмените их проведение):
		|%1';
		|fr = 'Le changement du schéma à bons de l''entrepôt touche des documents validés (annulez d''abord leur validation) :
		|%1';
		|en = 'Changing the order scheme of the warehouse affects posted documents (unpost them first):
		|%1';
		|es = 'El cambio del esquema por órdenes del almacén afecta a documentos contabilizados (anule primero su contabilización):
		|%1'");
	Тексты.Добавить(СтрШаблон(Шаблон, СтрСоединить(Список, Символы.ПС)));
КонецПроцедуры

// Интервал дат, где режим склада до записи и после неё различается.
//
// Параметры:
//  Прежние - Структура - см. ПрежниеРеквизиты.
//
// Возвращаемое значение:
//  Структура, Неопределено - Начало, Конец (не включая); Неопределено - режим не меняется.
//
Функция ИнтервалСменыРежима(Прежние)
	Бесконечность = '39991231';
	НачалоПрежнего = ?(Прежние.ОрдерныйСклад = Истина, НачалоДня(Прежние.ДатаНачалаОрдернойСхемы), Бесконечность);
	НачалоНового = ?(ОрдерныйСклад, НачалоДня(ДатаНачалаОрдернойСхемы), Бесконечность);
	Если НачалоПрежнего = НачалоНового Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Начало, Конец", Мин(НачалоПрежнего, НачалоНового), Макс(НачалоПрежнего, НачалоНового));
КонецФункции

#КонецОбласти
