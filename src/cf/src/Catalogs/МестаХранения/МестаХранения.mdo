    <toolTip>
      <key>fr</key>
      <value>Interdire la vente depuis l'entrepôt en dessous du type de prix ou du coût de revient</value>
    </toolTip>
    <toolTip>
      <key>en</key>
      <value>Forbid sales from the warehouse below the price type or below cost</value>
    </toolTip>
    <toolTip>
