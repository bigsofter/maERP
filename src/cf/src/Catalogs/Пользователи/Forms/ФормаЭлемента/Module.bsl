
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьПривилегированныйРежим(Истина);
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Объект.ИдентификаторПользователяИБ);
	ЕстьПраваАдминистратора = РольДоступна("Администратор");
	// Заполняем данные формы
	Для Каждого Стр Из Метаданные.Роли Цикл
		НС = СЗРоли.Добавить();
		НС.Значение = Стр.Имя;
		НС.Представление = Стр.Синоним;
	КонецЦикла;
	Для Каждого Стр Из Метаданные.Языки Цикл
		Элементы.Язык.СписокВыбора.Добавить(Стр.Имя);	
	КонецЦикла;	
	Если ПользовательИБ <> Неопределено Тогда
		АутентификацияOpenID = ПользовательИБ.АутентификацияOpenID;
		АутентификацияOpenIDConnect = ПользовательИБ.АутентификацияOpenIDConnect;
		АутентификацияОС = ПользовательИБ.АутентификацияОС;
		АутентификацияСтандартная = ПользовательИБ.АутентификацияСтандартная;   
		Если АутентификацияОС или АутентификацияСтандартная Тогда
			Объект.ВходВПрограммуРазрешен = Истина;	
		КонецЕсли;
		ЗапрещеноВосстанавливатьПароль = ПользовательИБ.ЗапрещеноВосстанавливатьПароль;
		АдресЭлектроннойПочты = ПользовательИБ.АдресЭлектроннойПочты;
		ЗапрещеноИзменятьПароль = ПользовательИБ.ЗапрещеноИзменятьПароль;
		ЗащитаОтОпасныхДействий = ПользовательИБ.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях;
		Пароль = ПользовательИБ.СохраняемоеЗначениеПароля;
		ПоказыватьВСпискеВыбора = ПользовательИБ.ПоказыватьВСпискеВыбора;
		ПользовательОС = ПользовательИБ.ПользовательОС;
		Для Каждого Роль Из ПользовательИБ.Роли Цикл
			Эл = СЗРоли.НайтиПоЗначению(Роль.Имя);
			Если Эл <> Неопределено Тогда
				Эл.Пометка = Истина;	
			КонецЕсли;	
		КонецЦикла;
		Если ПользовательИБ.Язык <> Неопределено Тогда
			Язык = ПользовательИБ.Язык.Имя;
		КонецЕсли;
	Иначе
		ЗапрещеноВосстанавливатьПароль = Истина;
	КонецЕсли;
	ПарольИзменялся = Ложь;
	ПрочитатьСкладыПользователя();
	ПрочитатьФормыПриЗапуске();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СформироватьЗаголовкиЭлементов();
	УстановитьДоступностьРеквизитов();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УстановитьПривилегированныйРежим(Истина);
	// Получаем пользователя
	НовыйПользователь = Ложь;
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ТекущийОбъект.ИдентификаторПользователяИБ);
	Если ПользовательИБ = Неопределено Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
		НовыйПользователь = Истина;
		
	КонецЕсли;
	//Если НЕ НовыйПользователь Тогда
	//	Возврат;
	//КонецЕсли;
	// Сохраняем данные
	ПользовательИБ.АутентификацияOpenID = АутентификацияOpenID;
	ПользовательИБ.АутентификацияOpenIDConnect = АутентификацияOpenIDConnect; 
	ПользовательИБ.АутентификацияОС = АутентификацияОС; 
	ПользовательИБ.АутентификацияСтандартная = АутентификацияСтандартная;
	ПользовательИБ.ЗапрещеноВосстанавливатьПароль = ЗапрещеноВосстанавливатьПароль;
	ПользовательИБ.ЗапрещеноИзменятьПароль = ЗапрещеноИзменятьПароль;		
	ПользовательИБ.АдресЭлектроннойПочты = АдресЭлектроннойПочты;
	ПользовательИБ.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = ЗащитаОтОпасныхДействий;
	ПользовательИБ.Имя = ТекущийОбъект.Наименование;
	Если ПарольИзменялся Тогда
		ПользовательИБ.Пароль = Пароль;
	КонецЕсли;	
	ПользовательИБ.ПоказыватьВСпискеВыбора = ПоказыватьВСпискеВыбора;
	ПользовательИБ.ПолноеИмя = ТекущийОбъект.ПолноеИмя;
	ПользовательИБ.ПользовательОС = ПользовательОС;
	ПользовательИБ.Роли.Очистить();	
	Для Каждого Стр Из СЗРоли Цикл
		Если Не Стр.Пометка Тогда Продолжить КонецЕсли;
		Роль = Метаданные.Роли.Найти(Стр.Значение);
		Если Роль = Неопределено Тогда Продолжить КонецЕсли;
		Если Роль = Метаданные.Роли.Клиент Тогда 
			Стр.Пометка = Ложь;
			Продолжить;
		КонецЕсли;
		ПользовательИБ.Роли.Добавить(Роль);
	КонецЦикла;
	ПользовательИБ.Язык = ?(ЗначениеЗаполнено(Язык), Метаданные.Языки[Язык], Метаданные.ОсновнойЯзык);
	ПользовательИБ.Записать();
	ТекущийОбъект.ИдентификаторПользователяИБ = ПользовательИБ.УникальныйИдентификатор;	
	ТекущийОбъект.Роли = Справочники.Пользователи.СформироватьСписокРолей(ПользовательИБ);
КонецПроцедуры

// Склады по умолчанию пишутся в настройки пользователя после записи элемента: у нового пользователя до записи нет ссылки.
//
// Параметры:
//  ТекущийОбъект   - СправочникОбъект.Пользователи - записанный пользователь.
//  ПараметрыЗаписи - Структура - параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗаписатьСкладыПользователя(ТекущийОбъект.Ссылка);
	// Снимаются только строки, удалённые на закладке «При запуске»: рабочее место, отмеченное флажком после открытия
	// карточки, остаётся (docs/plans/startup-forms-warehouse-role.md).
	Если УдаленныеФормыПриЗапуске.Количество() > 0 Тогда
		РегистрыСведений.НастройкиПользователей.УдалитьФормыПриЗапуске(ТекущийОбъект.Ссылка,
			УдаленныеФормыПриЗапуске.ВыгрузитьЗначения());
		УдаленныеФормыПриЗапуске.Очистить();
	КонецЕсли;
	ПрочитатьФормыПриЗапуске();
КонецПроцедуры

#КонецОбласти

#Область Обработчики_элементов_формы

&НаКлиенте
Процедура ФормыПриЗапускеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	// Рабочее место отмечают флажком «Открывать при запуске» в его меню «Настройки» - здесь только просмотр и удаление.
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ФормыПриЗапускеПередУдалением(Элемент, Отказ)
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		Строка = ФормыПриЗапуске.НайтиПоИдентификатору(Идентификатор);
		Если Строка <> Неопределено И УдаленныеФормыПриЗапуске.НайтиПоЗначению(Строка.Настройка) = Неопределено Тогда
			УдаленныеФормыПриЗапуске.Добавить(Строка.Настройка);
		КонецЕсли;
	КонецЦикла;
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПользовательОСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОткрытьФорму("Справочник.Пользователи.Форма.ВыборПользователяОС",, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ЗапрещеноВосстанавливатьПарольПриИзменении(Элемент)
	УстановитьДоступностьРеквизитов();
КонецПроцедуры

&НаКлиенте
Процедура СменитьПароль(Команда)
	Оп = Новый ОписаниеОповещения("ПослеЗакрытияФормыУстановкиПароля", ЭтотОбъект);
	ОткрытьФорму("Справочник.Пользователи.Форма.УстановкаПароля",, ЭтаФорма,,,, Оп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

#КонецОбласти

#Область Оповещения

&НаКлиенте
Процедура ПослеЗакрытияФормыУстановкиПароля(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> Неопределено Тогда
		Пароль = Результат;
		ПарольИзменялся = Истина;
	КонецЕсли;
	ЭтаФорма.Модифицированность = Истина;
	СформироватьЗаголовкиЭлементов();
КонецПроцедуры

#КонецОбласти

#Область Дополнительно

&НаКлиенте
Процедура УстановитьДоступностьРеквизитов()
	Элементы.ГруппаАутентификация1СПредприятияПараметры.Доступность = АутентификацияСтандартная;
	Элементы.ГруппаАутентификацияОСПользователь.Доступность = АутентификацияОС;
	Элементы.АдресЭлектроннойПочты.Доступность = Не ЗапрещеноВосстанавливатьПароль;
	Элементы.АдресЭлектроннойПочты.АвтоОтметкаНезаполненного = Не ЗапрещеноВосстанавливатьПароль;
КонецПроцедуры	

// Соответствие реквизитов закладки «Склады» видам настроек пользователя.
//
// Возвращаемое значение:
//  Структура - ключ - имя реквизита формы, значение - ПланВидовХарактеристикСсылка.ВидыНастроекПользователей.
//
&НаСервере
Функция ВидыНастроекСкладов()
	Виды = ПланыВидовХарактеристик.ВидыНастроекПользователей;
	Результат = Новый Структура;
	Результат.Вставить("СкладПоУмолчанию", Виды.Magasin);
	Результат.Вставить("СкладПоступлений", Виды.СкладПоступлений);
	Результат.Вставить("СкладОтгрузок", Виды.СкладОтгрузок);
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ПрочитатьФормыПриЗапуске()
	ФормыПриЗапуске.Очистить();
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из РегистрыСведений.НастройкиПользователей.ФормыПриЗапускеПользователя(Объект.Ссылка) Цикл
		ЗаполнитьЗначенияСвойств(ФормыПриЗапуске.Добавить(), Строка);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПрочитатьСкладыПользователя()
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Настройки.Настройка КАК Настройка,
	|	Настройки.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.НастройкиПользователей КАК Настройки
	|ГДЕ
	|	Настройки.Пользователь = &Пользователь
	|	И Настройки.Настройка В (&Виды)");
	Виды = ВидыНастроекСкладов();
	Запрос.УстановитьПараметр("Пользователь", Объект.Ссылка);
	МассивВидов = Новый Массив;
	Для Каждого КлючИЗначение Из Виды Цикл
		МассивВидов.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	Запрос.УстановитьПараметр("Виды", МассивВидов);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого КлючИЗначение Из Виды Цикл
			Если КлючИЗначение.Значение = Выборка.Настройка
				И ТипЗнч(Выборка.Значение) = Тип("СправочникСсылка.МестаХранения") Тогда
				ЭтотОбъект[КлючИЗначение.Ключ] = Выборка.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Пустой склад удаляет настройку - тогда действует следующий по порядку: общий склад пользователя, затем основной склад.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - записанный пользователь.
//
&НаСервере
Процедура ЗаписатьСкладыПользователя(Пользователь)
	Для Каждого КлючИЗначение Из ВидыНастроекСкладов() Цикл
		Склад = ЭтотОбъект[КлючИЗначение.Ключ];
		Набор = РегистрыСведений.НастройкиПользователей.СоздатьНаборЗаписей();
		Набор.Отбор.Пользователь.Установить(Пользователь);
		Набор.Отбор.Настройка.Установить(КлючИЗначение.Значение);
		Если ЗначениеЗаполнено(Склад) Тогда
			Запись = Набор.Добавить();
			Запись.Пользователь = Пользователь;
			Запись.Настройка = КлючИЗначение.Значение;
			Запись.Значение = Склад;
		КонецЕсли;
		Набор.Записать();
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаголовкиЭлементов()
	Элементы.НадписьНаличиеПароля.Заголовок = ?(ЗначениеЗаполнено(Пароль), "Пароль установлен", "Без пароля");
	Элементы.СменитьПароль.Заголовок = ?(ЗначениеЗаполнено(Пароль), "Сменить пароль", "Установить пароль");	
КонецПроцедуры

#КонецОбласти
