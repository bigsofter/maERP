#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	Если Не МенеджерОборудованияВызовСервера.ДоступенВыборРабочегоМеста() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для выбора рабочего места.';
			|fr = 'Droits insuffisants pour choisir le poste de travail.';
			|en = 'Insufficient rights to select a workplace.';
			|es = 'Derechos insuficientes para elegir el lugar de trabajo.'");
	КонецЕсли;
	Менеджер = Справочники.РабочиеМеста;
	ИмяКомпьютера = Менеджер.ИмяКомпьютераТекущегоКлиента();
	СписокМест = ?(ТипЗнч(Параметры.Кандидаты) = Тип("Массив"), Параметры.Кандидаты, Менеджер.ДействующиеРабочиеМеста(ИмяКомпьютера));
	ТекущееМесто = МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента();

	Для Каждого Описание Из Менеджер.ОписаниеКандидатов(СписокМест, ИмяКомпьютера) Цикл
		СтрокаТаблицы = Кандидаты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Описание);
		СтрокаТаблицы.ЭтотКомпьютер = ?(Описание.ТожеИмяКомпьютера, "✓", "");
		Если Описание.Ссылка = ТекущееМесто Тогда
			Элементы.Кандидаты.ТекущаяСтрока = СтрокаТаблицы.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЦикла;

	Если Кандидаты.Количество() = 0 Тогда
		Элементы.НадписьВыбора.Заголовок = НСтр("ru = 'Рабочих мест ещё нет. Создайте рабочее место для этого компьютера.';
			|fr = 'Il n''y a encore aucun poste de travail. Créez un poste de travail pour cet ordinateur.';
			|en = 'There are no workplaces yet. Create a workplace for this computer.';
			|es = 'Aún no hay lugares de trabajo. Cree un lugar de trabajo para este equipo.'");
		Элементы.ЭтоРабочееМесто.Доступность = Ложь;
		Элементы.СоздатьНовое.КнопкаПоУмолчанию = Истина;
	Иначе
		Шаблон = НСтр("ru = 'Выберите рабочее место этого компьютера (%1):
			|к нему подключится оборудование выбранного места.';
			|fr = 'Choisissez le poste de travail de cet ordinateur (%1) : le matériel du poste choisi y sera connecté.';
			|en = 'Select the workplace of this computer (%1): the equipment of the selected workplace will be connected.';
			|es = 'Elija el lugar de trabajo de este equipo (%1): se conectará el equipo del lugar elegido.'");
		Элементы.НадписьВыбора.Заголовок = СтрШаблон(Шаблон, ?(ПустаяСтрока(ИмяКомпьютера), "?", ИмяКомпьютера));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКандидаты

&НаКлиенте
Процедура КандидатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ЭтоРабочееМесто(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЭтоРабочееМесто(Команда)

	ОчиститьСообщения();
	ТекущиеДанные = Элементы.Кандидаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выберите рабочее место в списке.';
			|fr = 'Choisissez un poste de travail dans la liste.';
			|en = 'Select a workplace in the list.'; es = 'Elija un lugar de trabajo de la lista.'"), , "Кандидаты");
		Возврат;
	КонецЕсли;

	Результат = МенеджерОборудованияВызовСервера.ВыбратьРабочееМестоСеанса(ТекущиеДанные.Ссылка);
	Если Не Результат.Успех Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
		Возврат;
	КонецЕсли;
	Закрыть(Новый Структура("РабочееМесто, Текст", ТекущиеДанные.Ссылка, Результат.Текст));

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовое(Команда)

	РабочееМесто = МенеджерОборудованияВызовСервера.СоздатьРабочееМестоСеанса();
	Закрыть(Новый Структура("РабочееМесто, Текст", РабочееМесто, ""));

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть();

КонецПроцедуры

#КонецОбласти
