#Область ОписаниеПеременных

&НаКлиенте
Перем ОтветПередЗаписью;

#КонецОбласти

#Область ОбработчикиСобытийФорм

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда     
		Возврат;
	КонецЕсли;

	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();

	#Если Не ВебКлиент Тогда
	Объект.ИмяКомпьютера = ИмяКомпьютера();
	#КонецЕсли
	
	Элементы.Оборудование.Доступность = ЗначениеЗаполнено(Объект.Ссылка); 
	
	// Перенос идентификаторов и оборудования - операции администратора (docs/plans/equipment-lite-f1.md).
	Администрирование = Справочники.РабочиеМеста.ДоступноАдминистрирование();
	Элементы.ПеренестиИдентификатор.Видимость = Администрирование;
	Элементы.ПеренестиОборудование.Видимость = Администрирование И ЗначениеЗаполнено(Объект.Ссылка);
	Элементы.ОбъединеноВ.Видимость = ЗначениеЗаполнено(Объект.ОбъединеноВ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ПустаяСтрока(Объект.Код) Тогда
		Объект.Код = МенеджерОборудованияКлиентСервер.ИдентификаторКлиентаДляРабочегоМеста();
	КонецЕсли;
	
	МенеджерОборудованияКлиентСервер.ЗаполнитьНаименованиеРабочегоМеста(Объект, ТекущийПользователь);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Место = ТекущийОбъект.Ссылка;
	
	ЛокальноеОборудование.Очистить();
	СписокУстройств = МенеджерОборудованияВызовСервера.ОборудованиеПоПараметрам( , , Место);
	Для Каждого Элемент Из СписокУстройств Цикл
		Если Элемент.РабочееМесто = Место Тогда
			ЛокальноеОборудование.Добавить(Элемент.Ссылка,Элемент.Наименование, Ложь, ПолучитьКартинку(Элемент.ТипОборудования, 16));
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьИдентификаторы(Место);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ПроверкаУникальностиПоИдентификаторуКлиента(Объект.Ссылка, Объект.Код) Тогда
		Отказ = Истина;
		Текст = НСтр("ru = 'Ошибка сохранение рабочего места."
"Рабочее место с таким идентификатором клиента уже существует.'; fr = ""Erreur enregistrement de l'espace de travail."
"Un poste de travail avec un tel ID client existe déjà.""; en = 'Error saving the workplace."
"A workplace with this customer ID already exists.'; es = 'Error guardar el lugar de trabajo."
"Un lugar de trabajo con tal id de cliente ya existe.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;
	
	Если Не ПроверкаУникальностиПоНаименованию(Объект.Ссылка, Объект.Наименование)Тогда
		Если ОтветПередЗаписью <> Истина Тогда
			Отказ = Истина;
			Текст = НСтр("ru = 'Указано неуникальное наименование рабочего места."
"Возможно в дальнейшем это затруднит идентификацию и выбор рабочего места."
"Рекомендуется указывать уникальное наименование рабочих мест."
"Продолжить сохранение с указанным наименованием?'; fr = ""Le nom non unique du lieu de travail est indiqué."
"Peut-être à l'avenir, cela rendra plus difficile l'identification et le choix du lieu de travail."
"Il est recommandé de spécifier un nom unique pour les emplois."
"Continuer à enregistrer avec le nom spécifié?""; en = 'A non-unique workplace name is indicated."
"This may make it more difficult to identify and choose a workplace in the future."
"It is recommended to specify a unique workplace name."
"Should I continue saving with the specified name?'; es = 'Nombre no exclusivo del lugar de trabajo."
"Esto puede dificultar la identificación y selección del lugar de trabajo."
"Se recomienda especificar un nombre único para los puestos de trabajo."
"¿Continuar guardando con el nombre especificado?'");
			Оповещение = Новый ОписаниеОповещения("ПередЗаписьюЗавершение", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписьюЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОтветПередЗаписью = Истина;
		Записать();
	КонецЕсли;  
	
КонецПроцедуры 
   
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если Объект.Код = МенеджерОборудованияКлиентСервер.ИдентификаторКлиентаДляРабочегоМеста() Тогда
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	
	МенеджерОборудованияКлиентСервер.ЗаполнитьНаименованиеРабочегоМеста(Объект, ТекущийПользователь);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиИдентификатор(Команда)
	
	ТекущиеДанные = Элементы.Идентификаторы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("РежимВыбора", Истина);
	Оповещение = Новый ОписаниеОповещения("ПеренестиИдентификаторЗавершение", ЭтотОбъект, ТекущиеДанные.ИдентификаторКлиента);
	ОткрытьФорму("Справочник.РабочиеМеста.ФормаВыбора", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиОборудование(Команда)
	
	ПараметрыФормы = Новый Структура("РежимВыбора", Истина);
	Оповещение = Новый ОписаниеОповещения("ПеренестиОборудованиеЗавершение", ЭтотОбъект);
	ОткрытьФорму("Справочник.РабочиеМеста.ФормаВыбора", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПеренестиИдентификаторЗавершение(НовоеМесто, ИдентификаторКлиента) Экспорт
	
	Если Не ЗначениеЗаполнено(НовоеМесто) Тогда
		Возврат;
	КонецЕсли;
	Текст = ПеренестиИдентификаторНаСервере(ИдентификаторКлиента, НовоеМесто);
	Если Не ПустаяСтрока(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиОборудованиеЗавершение(Источник, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Источник) Тогда
		Возврат;
	КонецЕсли;
	Текст = ПеренестиОборудованиеНаСервере(Источник);
	Если Не ПустаяСтрока(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПеренестиИдентификаторНаСервере(Знач ИдентификаторКлиента, Знач НовоеМесто)
	
	Результат = Справочники.РабочиеМеста.ПеренестиИдентификатор(ИдентификаторКлиента, НовоеМесто);
	ЗаполнитьИдентификаторы(Объект.Ссылка);
	Возврат Результат.Текст;
	
КонецФункции

&НаСервере
Функция ПеренестиОборудованиеНаСервере(Знач Источник)
	
	Менеджер = Справочники.РабочиеМеста;
	Оборудование = Новый Массив;
	Для Каждого Описание Из Менеджер.ОборудованиеДляОбъединения(Источник, Справочники.РабочиеМеста.ПустаяСсылка()) Цикл
		Оборудование.Добавить(Описание.Ссылка);
	КонецЦикла;
	Если Оборудование.Количество() = 0 Тогда
		Возврат НСтр("ru = 'У выбранного рабочего места нет оборудования.'; fr = 'Le poste de travail choisi n''a pas de matériel.';
			|en = 'The selected workplace has no equipment.'; es = 'El lugar de trabajo elegido no tiene equipo.'");
	КонецЕсли;
	
	Результат = Менеджер.ПеренестиОборудование(Источник, Объект.Ссылка, Оборудование);
	ПриЧтенииНаСервере(РеквизитФормыВЗначение("Объект"));
	Возврат Результат.Текст;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьИдентификаторы(Место)
	
	Идентификаторы.Очистить();
	Если Не ЗначениеЗаполнено(Место) Тогда
		Возврат;
	КонецЕсли;
	Способы = Новый Соответствие;
	Способы.Вставить("Миграция", НСтр("ru = 'Обновление программы'; fr = 'Mise à jour du programme'; en = 'Program update';
		|es = 'Actualización del programa'"));
	Способы.Вставить("Код", НСтр("ru = 'По коду места'; fr = 'Par le code du poste'; en = 'By workplace code';
		|es = 'Por el código del lugar'"));
	Способы.Вставить("Выбор", НСтр("ru = 'Выбор пользователя'; fr = 'Choix de l''utilisateur'; en = 'User choice';
		|es = 'Elección del usuario'"));
	Способы.Вставить("Создание", НСтр("ru = 'Новое рабочее место'; fr = 'Nouveau poste'; en = 'New workplace';
		|es = 'Nuevo lugar de trabajo'"));
	Способы.Вставить("Объединение", НСтр("ru = 'Объединение мест'; fr = 'Fusion des postes'; en = 'Workplace merge';
		|es = 'Fusión de lugares'"));
	Способы.Вставить("Перенос", НСтр("ru = 'Перенос администратором'; fr = 'Transfert par l''administrateur';
		|en = 'Moved by administrator'; es = 'Traslado por el administrador'"));
	Для Каждого Описание Из Справочники.РабочиеМеста.ИдентификаторыРабочегоМеста(Место) Цикл
		СтрокаТаблицы = Идентификаторы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Описание);
		Представление = Способы[Описание.Способ];
		СтрокаТаблицы.Способ = ?(Представление = Неопределено, Описание.Способ, Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверкаУникальностиПоНаименованию(Ссылка, Наименование)
	
	Результат = Истина;
	
	Если Не ПустаяСтрока(Наименование) Тогда
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|    1
		|ИЗ
		|    Справочник.РабочиеМеста КАК РабочиеМеста
		|ГДЕ
		|    РабочиеМеста.Наименование = &Наименование
		|    И РабочиеМеста.Ссылка <> &Ссылка
		|");
		Запрос.УстановитьПараметр("Наименование", Наименование);
		Запрос.УстановитьПараметр("Ссылка"      , Ссылка);
		Результат = Запрос.Выполнить().Пустой();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверкаУникальностиПоИдентификаторуКлиента(Ссылка, ИдентификаторКлиента)
	
	Результат = Истина;
	
	Если Не ПустаяСтрока(ИдентификаторКлиента) Тогда
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|    1
		|ИЗ
		|    Справочник.РабочиеМеста КАК РабочиеМеста
		|ГДЕ
		|    РабочиеМеста.Код = &Код
		|    И РабочиеМеста.Ссылка <> &Ссылка
		|");
		Запрос.УстановитьПараметр("Код"    , ИдентификаторКлиента);
		Запрос.УстановитьПараметр("Ссылка" , Ссылка);
		Результат = Запрос.Выполнить().Пустой();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьКартинку(ТипОборудования, Размер)

	Попытка // Может прийти пустая ссылка или неопределено, может не быть картинки.
		МетаОбъект  = ТипОборудования.Метаданные();
		Индекс      = Перечисления.ТипыПодключаемогоОборудования.Индекс(ТипОборудования);
		ОбъектМетаданных = МетаОбъект.ЗначенияПеречисления[Индекс]; //ОбъектМетаданных - 
		ИмяКартинки = ОбъектМетаданных.Имя;
		ИмяКартинки = "ПодключаемоеОборудование" + ИмяКартинки + Размер;
		Картинка = БиблиотекаКартинок[ИмяКартинки];
	Исключение
		Картинка = Неопределено;
	КонецПопытки;

	Возврат Картинка;

КонецФункции

#КонецОбласти