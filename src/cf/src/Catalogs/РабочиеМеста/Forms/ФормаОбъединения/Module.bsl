#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Справочники.РабочиеМеста.ДоступноАдминистрирование() Тогда
		ВызватьИсключение НСтр("ru = 'Объединение рабочих мест доступно только администратору.';
			|fr = 'La fusion des postes de travail est réservée à l''administrateur.';
			|en = 'Only an administrator can merge workplaces.';
			|es = 'Solo un administrador puede fusionar lugares de trabajo.'");
	КонецЕсли;

	Источник = Параметры.Источник;
	ПараметрыВыбора = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый ПараметрВыбора("Отбор.ПометкаУдаления", Ложь));
	Элементы.Приемник.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
	ЗаполнитьОборудование();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПриемникПриИзменении(Элемент)

	ЗаполнитьОборудование();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Объединить(Команда)

	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	Текст = СтрШаблон(НСтр("ru = 'Объединить ""%1"" с ""%2""? Дубль будет помечен на удаление. На этих кассах 1С должна быть закрыта.';
		|fr = 'Fusionner « %1 » avec « %2 » ? Le doublon sera marqué pour suppression. 1C doit être fermé sur ces caisses.';
		|en = 'Merge ""%1"" into ""%2""? The duplicate will be marked for deletion. 1C must be closed on these tills.';
		|es = '¿Fusionar «%1» con «%2»? El duplicado se marcará para eliminar. 1C debe estar cerrado en esas cajas.'"),
		Источник, Приемник);
	ПоказатьВопрос(Новый ОписаниеОповещения("ОбъединитьЗавершение", ЭтотОбъект), Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбъединитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Результат = ОбъединитьНаСервере();
	Если Не Результат.Успех Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
		ЗаполнитьОборудование();
		Возврат;
	КонецЕсли;
	ОповеститьОбИзменении(Источник);
	ОповеститьОбИзменении(Приемник);
	Закрыть(Приемник);

КонецПроцедуры

&НаСервере
Функция ОбъединитьНаСервере()

	Оставить = Новый Массив;
	Удалить = Новый Массив;
	Для Каждого СтрокаТаблицы Из Оборудование Цикл
		Если СтрокаТаблицы.Оставить Тогда
			Оставить.Добавить(СтрокаТаблицы.Ссылка);
		Иначе
			Удалить.Добавить(СтрокаТаблицы.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.РабочиеМеста.ОбъединитьРабочиеМеста(Источник, Приемник, Оставить, Удалить);

КонецФункции

&НаСервере
Процедура ЗаполнитьОборудование()

	Оборудование.Очистить();
	Если Не ЗначениеЗаполнено(Источник) Тогда
		Возврат;
	КонецЕсли;
	Приемник = ?(Приемник = Источник, Справочники.РабочиеМеста.ПустаяСсылка(), Приемник);

	Для Каждого Описание Из Справочники.РабочиеМеста.ОборудованиеДляОбъединения(Источник, Приемник) Цикл
		СтрокаТаблицы = Оборудование.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Описание);
		СтрокаТаблицы.Место = Описание.РабочееМесто;
		СтрокаТаблицы.Совпадение = ?(Описание.Совпадает, "⚠", "");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
