//
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Менеджер = "Справочник.РабочиеМеста";
	МенеджерОборудованияВызовСервераПереопределяемый.ПриЗаполненииОграниченияДоступа(Менеджер, Ограничение);

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

#Область ОпределениеРабочегоМеста

// Определяет рабочее место клиента без диалога (docs/plans/equipment-lite-f1.md). Порядок: запись регистра
// ИдентификаторыРабочихМест (с переходом по ссылке «Объединено в»), затем единственное действующее место с кодом,
// равным идентификатору (идентификатор тогда привязывается к нему в регистре). Новое место не создаётся никогда:
// если места нет, возвращаются кандидаты для выбора пользователем.
//
// Параметры:
//  ИдентификаторКлиента - Строка - идентификатор клиента (МенеджерОборудованияКлиентСервер.ИдентификаторКлиентаДляРабочегоМеста)
//  ИмяКомпьютера - Строка - имя компьютера клиента: места с тем же именем идут первыми среди кандидатов
//
// Возвращаемое значение:
//  Структура:
//   * РабочееМесто - СправочникСсылка.РабочиеМеста - найденное место или пустая ссылка
//   * Кандидаты - Массив из СправочникСсылка.РабочиеМеста - места для выбора, если место не найдено
//   * Способ - Строка - "Регистр", "Код" или "Выбор"
//
Функция ОпределитьРабочееМесто(Знач ИдентификаторКлиента, Знач ИмяКомпьютера) Экспорт

	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	ИдентификаторКлиента = НормализованныйИдентификатор(ИдентификаторКлиента);
	Результат = Новый Структура("РабочееМесто, Кандидаты, Способ", ПустаяСсылка(), Новый Массив, "Выбор");
	Если ПустаяСтрока(ИдентификаторКлиента) Тогда
		Результат.Кандидаты = ДействующиеРабочиеМеста(ИмяКомпьютера);
		Возврат Результат;
	КонецЕсли;

	МестоПоРегистру = МестоПоРегистру(ИдентификаторКлиента);
	Если ЗначениеЗаполнено(МестоПоРегистру) Тогда
		Результат.РабочееМесто = МестоПоРегистру;
		Результат.Способ = "Регистр";
		Возврат Результат;
	КонецЕсли;

	МестаПоКоду = ДействующиеРабочиеМеста(ИмяКомпьютера, ИдентификаторКлиента);
	Если МестаПоКоду.Количество() = 1 Тогда
		Привязка = ПривязатьИдентификатор(ИдентификаторКлиента, МестаПоКоду[0], ИмяКомпьютера, "Код");
		Если Привязка.Успех Тогда
			Результат.РабочееМесто = МестаПоКоду[0];
			Результат.Способ = "Код";
			Возврат Результат;
		КонецЕсли;
		// Идентификатор успели привязать в другом сеансе - решение регистра главнее кода.
		МестоПоРегистру = МестоПоРегистру(ИдентификаторКлиента);
		Если ЗначениеЗаполнено(МестоПоРегистру) Тогда
			Результат.РабочееМесто = МестоПоРегистру;
			Результат.Способ = "Регистр";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// Код нескольких мест - выбор только среди них; кода нет - среди всех действующих мест.
	Результат.Кандидаты = ?(МестаПоКоду.Количество() > 1, МестаПоКоду, ДействующиеРабочиеМеста(ИмяКомпьютера));
	Возврат Результат;

КонецФункции

// Описания рабочих мест для формы выбора: наименование, имя компьютера и оборудование места.
//
// Параметры:
//  Кандидаты - Массив из СправочникСсылка.РабочиеМеста - места в порядке показа
//  ИмяКомпьютера - Строка - имя компьютера клиента для признака ТожеИмяКомпьютера
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Ссылка - СправочникСсылка.РабочиеМеста
//   * Наименование - Строка
//   * ИмяКомпьютера - Строка
//   * ТожеИмяКомпьютера - Булево
//   * Оборудование - Строка - «N: устройство, устройство…»
//
Функция ОписаниеКандидатов(Кандидаты, Знач ИмяКомпьютера) Экспорт

	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РабочиеМеста.Ссылка КАК Ссылка,
	|	РабочиеМеста.Наименование КАК Наименование,
	|	РабочиеМеста.ИмяКомпьютера КАК ИмяКомпьютера
	|ИЗ
	|	Справочник.РабочиеМеста КАК РабочиеМеста
	|ГДЕ
	|	РабочиеМеста.Ссылка В(&Кандидаты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодключаемоеОборудование.РабочееМесто КАК РабочееМесто,
	|	ПодключаемоеОборудование.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.РабочееМесто В(&Кандидаты)
	|	И НЕ ПодключаемоеОборудование.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("Кандидаты", Кандидаты);
	Результаты = Запрос.ВыполнитьПакет();

	Места = Результаты[0].Выгрузить();
	ПолеСсылки = "Ссылка";
	Места.Индексы.Добавить(ПолеСсылки);
	Устройства = Результаты[1].Выгрузить();

	Результат = Новый Массив;
	Для Каждого Место Из Кандидаты Цикл
		СтрокаТаблицы = Места.Найти(Место, ПолеСсылки);
		Если СтрокаТаблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имена = Новый Массив;
		Для Каждого Устройство Из Устройства.НайтиСтроки(Новый Структура("РабочееМесто", Место)) Цикл
			Имена.Добавить(Устройство.Наименование);
		КонецЦикла;
		Описание = Новый Структура;
		Описание.Вставить("Ссылка", Место);
		Описание.Вставить("Наименование", СтрокаТаблицы.Наименование);
		Описание.Вставить("ИмяКомпьютера", СтрокаТаблицы.ИмяКомпьютера);
		ТожеИмя = Не ПустаяСтрока(ИмяКомпьютера) И ВРег(СокрЛП(СтрокаТаблицы.ИмяКомпьютера)) = ВРег(СокрЛП(ИмяКомпьютера));
		Описание.Вставить("ТожеИмяКомпьютера", ТожеИмя);
		СписокУстройств = "";
		Если Имена.Количество() > 0 Тогда
			СписокУстройств = Формат(Имена.Количество(), "ЧГ=0") + ": " + СтрСоединить(Имена, ", ");
		КонецЕсли;
		Описание.Вставить("Оборудование", СписокУстройств);
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Действующие (не помеченные на удаление и не объединённые) рабочие места.
//
// Параметры:
//  ИмяКомпьютера - Строка - места с этим именем компьютера идут первыми
//  Код - Строка - если задан, только места с этим кодом
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.РабочиеМеста
//
Функция ДействующиеРабочиеМеста(Знач ИмяКомпьютера = "", Знач Код = Неопределено) Экспорт

	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РабочиеМеста.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА РабочиеМеста.ИмяКомпьютера = &ИмяКомпьютера
	|				И &ИмяКомпьютера <> """"
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Порядок,
	|	РабочиеМеста.Наименование КАК Наименование
	|ИЗ
	|	Справочник.РабочиеМеста КАК РабочиеМеста
	|ГДЕ
	|	НЕ РабочиеМеста.ПометкаУдаления
	|	И РабочиеМеста.ОбъединеноВ = ЗНАЧЕНИЕ(Справочник.РабочиеМеста.ПустаяСсылка)
	|	И &УсловиеКода
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Наименование";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКода", ?(Код = Неопределено, "ИСТИНА", "РабочиеМеста.Код = &Код"));
	Запрос.УстановитьПараметр("ИмяКомпьютера", СокрЛП(ИмяКомпьютера));
	Запрос.УстановитьПараметр("Код", ?(Код = Неопределено, "", Код));

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

#КонецОбласти

#Область ПривязкаИдентификатора

// Привязывает идентификатор клиента к рабочему месту под протоколом блокировок плана: исключительная блокировка
// места, затем идентификатора; место должно быть действующим. Занятый другим действующим местом идентификатор
// не перезаписывается; запись, указывающая на помеченное или объединённое место, считается свободной.
// Логический отказ фиксирует пустую транзакцию и возвращается результатом, поэтому вызов внутри внешней
// транзакции (автотесты) её не ломает.
//
// Параметры:
//  ИдентификаторКлиента - Строка - идентификатор клиента
//  РабочееМесто - СправочникСсылка.РабочиеМеста - место для привязки
//  ИмяКомпьютера - Строка - имя компьютера клиента (история привязки)
//  Способ - Строка - "Код", "Выбор", "Создание" (история привязки)
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Текст - Строка - причина отказа
//
Функция ПривязатьИдентификатор(Знач ИдентификаторКлиента, Знач РабочееМесто, Знач ИмяКомпьютера, Знач Способ) Экспорт

	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	ИдентификаторКлиента = НормализованныйИдентификатор(ИдентификаторКлиента);
	Если ПустаяСтрока(ИдентификаторКлиента) Или Не ЗначениеЗаполнено(РабочееМесто) Тогда
		Возврат РезультатОперации(НСтр("ru = 'Не задан идентификатор клиента или рабочее место.';
			|fr = 'L''identifiant du client ou le poste de travail n''est pas renseigné.';
			|en = 'The client ID or workplace is not specified.';
			|es = 'No se ha indicado el identificador del cliente o el lugar de trabajo.'"));
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРабочиеМеста(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(РабочееМесто));
		ЗаблокироватьИдентификатор(ИдентификаторКлиента);
		Текст = ПричинаНедоступностиМеста(РабочееМесто);
		Если ПустаяСтрока(Текст) Тогда
			ТекущееМесто = РабочееМестоЗаписи(ИдентификаторКлиента);
			// Запись на помеченное или объединённое место считается свободной.
			Занят = ЗначениеЗаполнено(ТекущееМесто) И ТекущееМесто <> РабочееМесто;
			Занят = Занят И ПустаяСтрока(ПричинаНедоступностиМеста(ТекущееМесто));
			Если Занят Тогда
				Шаблон = НСтр("ru = 'Идентификатор этого компьютера уже привязан к рабочему месту ""%1"".';
					|fr = 'L''identifiant de cet ordinateur est déjà lié au poste de travail « %1 ».';
					|en = 'This computer''s identifier is already bound to workplace ""%1"".';
					|es = 'El identificador de este equipo ya está vinculado al lugar de trabajo «%1».'");
				Текст = СтрШаблон(Шаблон, ТекущееМесто);
			КонецЕсли;
			Если Не Занят И ТекущееМесто <> РабочееМесто Тогда
				ЗаписатьИдентификатор(ИдентификаторКлиента, РабочееМесто, ИмяКомпьютера, Способ);
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат РезультатОперации(Текст);

КонецФункции

// Создаёт рабочее место для идентификатора клиента и привязывает идентификатор в одной транзакции. Если
// идентификатор за это время привязали к действующему месту в другом сеансе, новое место не создаётся и
// возвращается то место.
//
// Параметры:
//  ИдентификаторКлиента - Строка - идентификатор клиента
//  ИмяКомпьютера - Строка - имя компьютера клиента
//
// Возвращаемое значение:
//  СправочникСсылка.РабочиеМеста - созданное или уже привязанное место
//
Функция СоздатьРабочееМесто(Знач ИдентификаторКлиента, Знач ИмяКомпьютера) Экспорт

	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	ИдентификаторКлиента = НормализованныйИдентификатор(ИдентификаторКлиента);
	Если ПустаяСтрока(ИдентификаторКлиента) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан идентификатор клиента.'; fr = 'L''identifiant du client n''est pas renseigné.';
			|en = 'The client ID is not specified.'; es = 'No se ha indicado el identificador del cliente.'");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьИдентификатор(ИдентификаторКлиента);
		ТекущееМесто = РабочееМестоЗаписи(ИдентификаторКлиента);
		Если ЗначениеЗаполнено(ТекущееМесто) И ПустаяСтрока(ПричинаНедоступностиМеста(ТекущееМесто)) Тогда
			Результат = ТекущееМесто;
		Иначе
			Место = СоздатьЭлемент();
			Место.Код = ИдентификаторКлиента;
			Место.ИмяКомпьютера = СокрЛП(ИмяКомпьютера);
			МенеджерОборудованияКлиентСервер.ЗаполнитьНаименованиеРабочегоМеста(Место,
				ПользователиИнформационнойБазы.ТекущийПользователь());
			Место.Записать();
			ЗаписатьИдентификатор(ИдентификаторКлиента, Место.Ссылка, ИмяКомпьютера, "Создание");
			Результат = Место.Ссылка;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Выбор рабочего места пользователем в форме выбора. Свободный идентификатор (нет записи или запись на
// недействующее место) привязывается к месту постоянно. Идентификатор, уже привязанный к другому действующему
// месту, не перепривязывается: выбранное место действует только до конца сеанса (закрепить его за компьютером -
// административная операция ПеренестиИдентификатор).
//
// Параметры:
//  ИдентификаторКлиента - Строка - идентификатор клиента текущего сеанса
//  РабочееМесто - СправочникСсылка.РабочиеМеста - выбранное место
//  ИмяКомпьютера - Строка - имя компьютера клиента
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - место можно ставить в сеанс
//   * Текст - Строка - причина отказа или пояснение для пользователя
//   * ТолькоСеанс - Булево - постоянная привязка не менялась
//
Функция ВыбратьРабочееМесто(Знач ИдентификаторКлиента, Знач РабочееМесто, Знач ИмяКомпьютера) Экспорт

	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	ИдентификаторКлиента = НормализованныйИдентификатор(ИдентификаторКлиента);
	Привязка = ПривязатьИдентификатор(ИдентификаторКлиента, РабочееМесто, ИмяКомпьютера, "Выбор");
	Результат = Новый Структура("Успех, Текст, ТолькоСеанс", Привязка.Успех, Привязка.Текст, Ложь);
	Если Привязка.Успех Тогда
		Возврат Результат;
	КонецЕсли;

	// Отказ из-за самого места (помечено, объединено) - окончательный; из-за занятого идентификатора - выбор на сеанс.
	Если Не ЗначениеЗаполнено(РабочееМесто) Или Не ПустаяСтрока(ПричинаНедоступностиМеста(РабочееМесто)) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.ТолькоСеанс = Истина;
	Шаблон = НСтр("ru = 'Рабочее место ""%1"" выбрано до конца сеанса:
		|этот компьютер закреплён за рабочим местом ""%2"".
		|Закрепить его за новым местом может администратор в карточке рабочего места (""Перенести на другое рабочее место"").';
		|fr = 'Le poste de travail « %1 » est sélectionné jusqu''à la fin de la session :
		|cet ordinateur est rattaché au poste « %2 ».
		|L''administrateur peut le rattacher au nouveau poste dans la fiche du poste de travail (« Transférer vers un autre poste »).';
		|en = 'Workplace ""%1"" is selected until the end of the session: this computer is assigned to workplace ""%2"".
		|An administrator can reassign it in the workplace card (""Move to another workplace"").';
		|es = 'El lugar de trabajo «%1» está seleccionado hasta el final de la sesión: este equipo está asignado al lugar «%2».
		|Un administrador puede reasignarlo en la ficha del lugar de trabajo («Trasladar a otro lugar de trabajo»).'");
	Результат.Текст = СтрШаблон(Шаблон, РабочееМесто, РабочееМестоЗаписи(ИдентификаторКлиента));

	Возврат Результат;

КонецФункции

// Идентификатор клиента текущего сеанса для рабочего места: фиксируется на сервере при старте сеанса
// (ПараметрыКлиентаНаСервере), с клиента в серверные функции не передаётся.
//
// Возвращаемое значение:
//  Строка - идентификатор или пустая строка, если клиент его не сообщил (внешнее соединение, фоновое задание)
//
Функция ИдентификаторТекущегоКлиента() Экспорт

	Возврат НормализованныйИдентификатор(ЗначениеПараметраКлиента("ИдентификаторРабочегоМеста"));

КонецФункции

// Имя компьютера клиента текущего сеанса (ПараметрыКлиентаНаСервере).
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяКомпьютераТекущегоКлиента() Экспорт

	Возврат СокрЛП(ЗначениеПараметраКлиента("ИмяКомпьютера"));

КонецФункции

// Идентификаторы клиента, привязанные к рабочему месту, - для формы элемента.
//
// Параметры:
//  РабочееМесто - СправочникСсылка.РабочиеМеста
//
// Возвращаемое значение:
//  Массив из Структура:
//   * ИдентификаторКлиента - Строка
//   * ИмяКомпьютера - Строка
//   * ДатаПривязки - Дата
//   * Способ - Строка
//
Функция ИдентификаторыРабочегоМеста(РабочееМесто) Экспорт

	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ИдентификаторыРабочихМест) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Идентификаторы.ИдентификаторКлиента КАК ИдентификаторКлиента,
	|	Идентификаторы.ИмяКомпьютера КАК ИмяКомпьютера,
	|	Идентификаторы.ДатаПривязки КАК ДатаПривязки,
	|	Идентификаторы.Способ КАК Способ
	|ИЗ
	|	РегистрСведений.ИдентификаторыРабочихМест КАК Идентификаторы
	|ГДЕ
	|	Идентификаторы.РабочееМесто = &РабочееМесто
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПривязки УБЫВ";
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Описание = Новый Структура("ИдентификаторКлиента, ИмяКомпьютера, ДатаПривязки, Способ");
		ЗаполнитьЗначенияСвойств(Описание, Выборка);
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОперацииАдминистратора

// Переносит идентификатор клиента на другое рабочее место (исправление ошибочного выбора). Только для
// администратора. Блокировки: прежнее и новое место в порядке uuid, затем идентификатор. Новое место должно быть
// действующим, прежнее может быть помечено на удаление.
//
// Параметры:
//  ИдентификаторКлиента - Строка - идентификатор клиента
//  НовоеМесто - СправочникСсылка.РабочиеМеста - место-приёмник
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Текст - Строка - причина отказа
//
Функция ПеренестиИдентификатор(Знач ИдентификаторКлиента, Знач НовоеМесто) Экспорт

	ПроверитьПравоАдминистрирования();
	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	ИдентификаторКлиента = НормализованныйИдентификатор(ИдентификаторКлиента);
	ПрежнееМесто = РабочееМестоЗаписи(ИдентификаторКлиента);
	Если Не ЗначениеЗаполнено(ПрежнееМесто) Или Не ЗначениеЗаполнено(НовоеМесто) Тогда
		Возврат РезультатОперации(НСтр("ru = 'Идентификатор не привязан ни к одному рабочему месту.';
			|fr = 'L''identifiant n''est lié à aucun poste de travail.';
			|en = 'The identifier is not bound to any workplace.';
			|es = 'El identificador no está vinculado a ningún lugar de trabajo.'"));
	КонецЕсли;
	Если ПрежнееМесто = НовоеМесто Тогда
		Возврат РезультатОперации("");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Места = Новый Массив;
		Места.Добавить(ПрежнееМесто);
		Места.Добавить(НовоеМесто);
		ЗаблокироватьРабочиеМеста(Места);
		ЗаблокироватьИдентификатор(ИдентификаторКлиента);
		Текст = ПричинаНедоступностиМеста(НовоеМесто);
		Если ПустаяСтрока(Текст) И РабочееМестоЗаписи(ИдентификаторКлиента) <> ПрежнееМесто Тогда
			Текст = ТекстДанныеИзменились();
		КонецЕсли;
		Если ПустаяСтрока(Текст) Тогда
			ЗаписатьИдентификатор(ИдентификаторКлиента, НовоеМесто, ИмяКомпьютераЗаписи(ИдентификаторКлиента), "Перенос");
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат РезультатОперации(Текст);

КонецФункции

// Переносит оборудование с одного рабочего места на другое. Только для администратора. Блокировки: оба места в
// порядке uuid; приёмник должен быть действующим, источник может быть помечен на удаление.
//
// Параметры:
//  Источник - СправочникСсылка.РабочиеМеста - откуда
//  Приемник - СправочникСсылка.РабочиеМеста - куда
//  Оборудование - Массив из СправочникСсылка.ПодключаемоеОборудование - переносимые устройства источника
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Текст - Строка - причина отказа
//
Функция ПеренестиОборудование(Знач Источник, Знач Приемник, Знач Оборудование) Экспорт

	ПроверитьПравоАдминистрирования();
	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	Текст = ПричинаОтказаПары(Источник, Приемник);
	Если Не ПустаяСтрока(Текст) Тогда
		Возврат РезультатОперации(Текст);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРабочиеМеста(ПараМест(Источник, Приемник));
		Текст = ПричинаНедоступностиМеста(Приемник);
		Если ПустаяСтрока(Текст) И Не ВсеОборудованиеУМеста(Оборудование, Источник) Тогда
			Текст = ТекстДанныеИзменились();
		КонецЕсли;
		Если ПустаяСтрока(Текст) Тогда
			Для Каждого Устройство Из Оборудование Цикл
				УстройствоОбъект = Устройство.ПолучитьОбъект();
				УстройствоОбъект.РабочееМесто = Приемник;
				УстройствоОбъект.Записать();
			КонецЦикла;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат РезультатОперации(Текст);

КонецФункции

// Объединяет рабочее место-дубль с основным. Только для администратора. Одна транзакция: блокировки обоих мест
// в порядке uuid, затем идентификаторов источника; идентификаторы источника переходят к приёмнику, оборудование
// из списка «Оставить» - к приёмнику, из списка «Удалить» помечается на удаление; у источника -
// «Объединено в» и пометка удаления. Встречное или повторное объединение получает отказ: источник уже объединён.
//
// Параметры:
//  Источник - СправочникСсылка.РабочиеМеста - дубль
//  Приемник - СправочникСсылка.РабочиеМеста - основное место
//  Оставить - Массив из СправочникСсылка.ПодключаемоеОборудование - устройства обоих мест, остающиеся у приёмника
//  Удалить - Массив из СправочникСсылка.ПодключаемоеОборудование - устройства обоих мест, помечаемые на удаление.
//    Вместе списки должны совпасть с непомеченным оборудованием обоих мест на момент объединения (сверка под
//    блокировкой), иначе отказ без записи: форма объединения устарела
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Текст - Строка - причина отказа
//
Функция ОбъединитьРабочиеМеста(Знач Источник, Знач Приемник, Знач Оставить, Знач Удалить) Экспорт

	ПроверитьПравоАдминистрирования();
	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	Текст = ПричинаОтказаПары(Источник, Приемник);
	Если Не ПустаяСтрока(Текст) Тогда
		Возврат РезультатОперации(Текст);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРабочиеМеста(ПараМест(Источник, Приемник));
		ОбъединеноВ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник, "ОбъединеноВ");
		Если ЗначениеЗаполнено(ОбъединеноВ) Тогда
			Текст = СтрШаблон(НСтр("ru = 'Рабочее место ""%1"" уже объединено с ""%2"".';
				|fr = 'Le poste de travail « %1 » a déjà été fusionné avec « %2 ».';
				|en = 'Workplace ""%1"" has already been merged into ""%2"".';
				|es = 'El lugar de trabajo «%1» ya se ha fusionado con «%2».'"), Источник, ОбъединеноВ);
		Иначе
			Текст = ПричинаНедоступностиМеста(Приемник);
		КонецЕсли;
		Если ПустаяСтрока(Текст) И Не СоставСовпадает(Источник, Приемник, Оставить, Удалить) Тогда
			Текст = ТекстДанныеИзменились();
		КонецЕсли;
		Если ПустаяСтрока(Текст) Тогда
			ВыполнитьОбъединение(Источник, Приемник, Оставить, Удалить);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат РезультатОперации(Текст);

КонецФункции

// Оборудование двух рабочих мест для формы объединения: совпадающие устройства (тот же тип, драйвер и порт или
// идентификатор устройства) отмечены, по умолчанию из совпадающей пары остаётся устройство приёмника.
//
// Параметры:
//  Источник - СправочникСсылка.РабочиеМеста - дубль
//  Приемник - СправочникСсылка.РабочиеМеста - основное место
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Ссылка - СправочникСсылка.ПодключаемоеОборудование
//   * РабочееМесто - СправочникСсылка.РабочиеМеста
//   * Наименование - Строка
//   * ТипОборудования - ПеречислениеСсылка.ТипыПодключаемогоОборудования
//   * ДрайверОборудования - СправочникСсылка.ДрайверыОборудования
//   * Совпадает - Булево
//   * Оставить - Булево
//
Функция ОборудованиеДляОбъединения(Источник, Приемник) Экспорт

	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПодключаемоеОборудование.Ссылка КАК Ссылка,
	|	ПодключаемоеОборудование.РабочееМесто КАК РабочееМесто,
	|	ПодключаемоеОборудование.Наименование КАК Наименование,
	|	ПодключаемоеОборудование.ТипОборудования КАК ТипОборудования,
	|	ПодключаемоеОборудование.ДрайверОборудования КАК ДрайверОборудования,
	|	ПодключаемоеОборудование.ИдентификаторУстройства КАК ИдентификаторУстройства,
	|	ПодключаемоеОборудование.Параметры КАК Параметры
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.РабочееМесто В (&Места)
	|	И НЕ ПодключаемоеОборудование.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("Места", ПараМест(Источник, Приемник));
	Таблица = Запрос.Выполнить().Выгрузить();

	КлючиПриемника = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.РабочееМесто = Приемник Тогда
			КлючиПриемника.Вставить(КлючУстройства(СтрокаТаблицы), Истина);
		КонецЕсли;
	КонецЦикла;
	КлючиИсточника = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.РабочееМесто = Источник Тогда
			КлючиИсточника.Вставить(КлючУстройства(СтрокаТаблицы), Истина);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Ключ = КлючУстройства(СтрокаТаблицы);
		ЭтоПриемник = (СтрокаТаблицы.РабочееМесто = Приемник);
		Совпадает = ?(ЭтоПриемник, КлючиИсточника[Ключ] <> Неопределено, КлючиПриемника[Ключ] <> Неопределено);
		Описание = Новый Структура("Ссылка, РабочееМесто, Наименование, ТипОборудования, ДрайверОборудования");
		ЗаполнитьЗначенияСвойств(Описание, СтрокаТаблицы);
		Описание.Вставить("Совпадает", Совпадает);
		Описание.Вставить("Оставить", ЭтоПриемник Или Не Совпадает);
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Протокол блокировок для записи устройства (ПодключаемоеОборудование.ПередЗаписью): исключительные блокировки
// места устройства и прежнего места в порядке uuid; запись на помеченное или объединённое место запрещена, кроме
// записи, ставящей устройству пометку удаления. Прежнее место (источник переноса) может быть помечено.
//
// Параметры:
//  РабочееМесто - СправочникСсылка.РабочиеМеста - место устройства после записи
//  ПрежнееМесто - СправочникСсылка.РабочиеМеста - место устройства в базе до записи
//  ПометкаУдаления - Булево - устройство записывается помеченным на удаление
//
// Возвращаемое значение:
//  Строка - пустая, если запись разрешена; иначе текст отказа
//
Функция ПроверитьМестоОборудования(Знач РабочееМесто, Знач ПрежнееМесто, Знач ПометкаУдаления) Экспорт
	
	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	ЗаблокироватьРабочиеМеста(ПараМест(РабочееМесто, ПрежнееМесто));
	Если ПометкаУдаления Или Не ЗначениеЗаполнено(РабочееМесто) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ПричинаНедоступностиМеста(РабочееМесто);
	
КонецФункции

// Проверяет, что текущему пользователю доступны административные операции с рабочими местами (перенос и
// объединение). Вызывается до включения привилегированного режима.
//
// Возвращаемое значение:
//  Булево - Истина, если операции доступны
//
Функция ДоступноАдминистрирование() Экспорт

	Возврат ПравоДоступа("Администрирование", Метаданные);

КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

// Переносит коды действующих рабочих мест в регистр ИдентификаторыРабочихМест (обработчик обновления 2.0.16.95).
// Пишется только однозначный код: одно непомеченное и необъединённое место с этим кодом и записи по коду в
// регистре ещё нет. Код нескольких мест (дубли в базах клиентов) не пишется: такие места с числом устройств
// уходят в журнал регистрации, их объединяет администратор. Повторный запуск ничего не меняет.
//
// Возвращаемое значение:
//  Структура:
//   * Перенесено - Число
//   * УжеБыло - Число
//   * Неоднозначных - Число - кодов с несколькими местами
//
Функция ПеренестиКодыВРегистр() Экспорт

	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РабочиеМеста.Ссылка КАК Ссылка,
	|	РабочиеМеста.Код КАК Код,
	|	РабочиеМеста.ИмяКомпьютера КАК ИмяКомпьютера,
	|	КОЛИЧЕСТВО(ПодключаемоеОборудование.Ссылка) КАК Устройств
	|ИЗ
	|	Справочник.РабочиеМеста КАК РабочиеМеста
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|		ПО (ПодключаемоеОборудование.РабочееМесто = РабочиеМеста.Ссылка)
	|			И (НЕ ПодключаемоеОборудование.ПометкаУдаления)
	|ГДЕ
	|	НЕ РабочиеМеста.ПометкаУдаления
	|	И РабочиеМеста.ОбъединеноВ = ЗНАЧЕНИЕ(Справочник.РабочиеМеста.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	РабочиеМеста.Ссылка,
	|	РабочиеМеста.Код,
	|	РабочиеМеста.ИмяКомпьютера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Идентификаторы.ИдентификаторКлиента КАК ИдентификаторКлиента
	|ИЗ
	|	РегистрСведений.ИдентификаторыРабочихМест КАК Идентификаторы";
	Результаты = Запрос.ВыполнитьПакет();

	Записанные = Новый Соответствие;
	Для Каждого Идентификатор Из Результаты[1].Выгрузить().ВыгрузитьКолонку("ИдентификаторКлиента") Цикл
		Записанные.Вставить(НормализованныйИдентификатор(Идентификатор), Истина);
	КонецЦикла;

	МестаПоКоду = Новый Соответствие;
	Порядок = Новый Массив;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Код = НормализованныйИдентификатор(Выборка.Код);
		Если ПустаяСтрока(Код) Тогда
			Продолжить;
		КонецЕсли;
		Группа = МестаПоКоду[Код];
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			МестаПоКоду.Вставить(Код, Группа);
			Порядок.Добавить(Код);
		КонецЕсли;
		Место = Новый Структура("Ссылка, ИмяКомпьютера, Устройств", Выборка.Ссылка, Выборка.ИмяКомпьютера, Выборка.Устройств);
		Группа.Добавить(Место);
	КонецЦикла;

	Итог = Новый Структура("Перенесено, УжеБыло, Неоднозначных", 0, 0, 0);
	Для Каждого Код Из Порядок Цикл
		Группа = МестаПоКоду[Код];
		Если Записанные[Код] <> Неопределено Тогда
			Итог.УжеБыло = Итог.УжеБыло + 1;
		ИначеЕсли Группа.Количество() = 1 Тогда
			ЗаписатьИдентификатор(Код, Группа[0].Ссылка, Группа[0].ИмяКомпьютера, "Миграция");
			Итог.Перенесено = Итог.Перенесено + 1;
		Иначе
			Итог.Неоднозначных = Итог.Неоднозначных + 1;
			Описания = Новый Массив;
			Для Каждого Место Из Группа Цикл
				ЧислоУстройств = Формат(Место.Устройств, "ЧН=0; ЧГ=0");
				Описания.Добавить(СтрШаблон("%1 (%2)", Место.Ссылка, ЧислоУстройств));
			КонецЦикла;
			Шаблон = НСтр("ru = 'Код ""%1"" у нескольких рабочих мест (в скобках - число устройств): %2.
					|Идентификатор не привязан, объедините дубли командой ""Объединить с..."".';
					|fr = 'Le code « %1 » appartient à plusieurs postes de travail (nombre d''appareils entre parenthèses) :
					|%2. L''identifiant n''est pas lié, fusionnez les doublons avec la commande « Fusionner avec... ».';
					|en = 'Code ""%1"" belongs to several workplaces (number of devices in brackets): %2.
					|The identifier is not bound; merge the duplicates with the ""Merge with..."" command.';
					|es = 'El código «%1» pertenece a varios lugares de trabajo (número de dispositivos entre paréntesis): %2.
					|El identificador no está vinculado; fusione los duplicados con el comando «Fusionar con...».'");
			Сообщение = СтрШаблон(Шаблон, Код, СтрСоединить(Описания, "; "));
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Справочники.РабочиеМеста, , Сообщение);
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#КонецЕсли

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ЗначениеПараметраКлиента(Имя)

	// Регистр и справочник рабочих мест - в обход прав ролей; права проверены до этой строки (equipment-lite-f1).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	ПараметрыКлиента = ПараметрыСеанса.ПараметрыКлиентаНаСервере;
	Значение = "";
	Если ТипЗнч(ПараметрыКлиента) = Тип("ФиксированнаяСтруктура") И ПараметрыКлиента.Свойство(Имя, Значение) Тогда
		Возврат ?(Значение = Неопределено, "", Строка(Значение));
	КонецЕсли;
	Возврат "";

КонецФункции

Функция НормализованныйИдентификатор(Знач Идентификатор)

	Длина = Метаданные.РегистрыСведений.ИдентификаторыРабочихМест.Измерения.ИдентификаторКлиента.Тип.КвалификаторыСтроки.Длина;
	Возврат Лев(ВРег(СокрЛП(Строка(Идентификатор))), Длина);

КонецФункции

Функция МестоПоРегистру(ИдентификаторКлиента)

	// Место по записи регистра с переходом по «Объединено в»; помеченное на удаление итоговое место и цикл
	// объединений - пустая ссылка.
	Место = РабочееМестоЗаписи(ИдентификаторКлиента);
	Пройденные = Новый Массив;
	Пока ЗначениеЗаполнено(Место) И Пройденные.Найти(Место) = Неопределено Цикл
		Пройденные.Добавить(Место);
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Место, "ПометкаУдаления, ОбъединеноВ");
		Если ЗначениеЗаполнено(Реквизиты.ОбъединеноВ) Тогда
			Место = Реквизиты.ОбъединеноВ;
		ИначеЕсли Реквизиты.ПометкаУдаления = Истина Тогда
			Возврат ПустаяСсылка();
		Иначе
			Возврат Место;
		КонецЕсли;
	КонецЦикла;

	Возврат ПустаяСсылка();

КонецФункции

Функция РабочееМестоЗаписи(ИдентификаторКлиента)

	Менеджер = РегистрыСведений.ИдентификаторыРабочихМест.СоздатьМенеджерЗаписи();
	Менеджер.ИдентификаторКлиента = ИдентификаторКлиента;
	Менеджер.Прочитать();
	Возврат ?(Менеджер.Выбран(), Менеджер.РабочееМесто, ПустаяСсылка());

КонецФункции

Функция ИмяКомпьютераЗаписи(ИдентификаторКлиента)

	Менеджер = РегистрыСведений.ИдентификаторыРабочихМест.СоздатьМенеджерЗаписи();
	Менеджер.ИдентификаторКлиента = ИдентификаторКлиента;
	Менеджер.Прочитать();
	Возврат ?(Менеджер.Выбран(), Менеджер.ИмяКомпьютера, "");

КонецФункции

Процедура ЗаписатьИдентификатор(ИдентификаторКлиента, РабочееМесто, ИмяКомпьютера, Способ)

	Менеджер = РегистрыСведений.ИдентификаторыРабочихМест.СоздатьМенеджерЗаписи();
	Менеджер.ИдентификаторКлиента = ИдентификаторКлиента;
	Менеджер.РабочееМесто = РабочееМесто;
	Длина = Метаданные.РегистрыСведений.ИдентификаторыРабочихМест.Реквизиты.ИмяКомпьютера.Тип.КвалификаторыСтроки.Длина;
	Менеджер.ИмяКомпьютера = Лев(СокрЛП(ИмяКомпьютера), Длина);
	Менеджер.ДатаПривязки = ТекущаяДатаСеанса();
	Менеджер.Способ = Способ;
	Менеджер.Записать(Истина);

КонецПроцедуры

Процедура ЗаблокироватьРабочиеМеста(Места)

	// Исключительные блокировки рабочих мест по одному, в порядке uuid: встречные операции над одной парой мест
	// берут блокировки в одном порядке и не взаимоблокируются.

	Список = Новый СписокЗначений;
	Для Каждого Место Из Места Цикл
		Если ЗначениеЗаполнено(Место) И Список.НайтиПоЗначению(Место) = Неопределено Тогда
			Список.Добавить(Место, Строка(Место.УникальныйИдентификатор()));
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоПредставлению();

	Для Каждого Элемент Из Список Цикл
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.РабочиеМеста");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Элемент.Значение);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаблокироватьИдентификатор(ИдентификаторКлиента)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ИдентификаторыРабочихМест");
	ЭлементБлокировки.УстановитьЗначение("ИдентификаторКлиента", ИдентификаторКлиента);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

Функция ПричинаНедоступностиМеста(РабочееМесто)

	// Пустая строка, если место действующее; иначе текст отказа. Читать под блокировкой места.

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РабочееМесто, "ПометкаУдаления, ОбъединеноВ");
	Если ЗначениеЗаполнено(Реквизиты.ОбъединеноВ) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Рабочее место ""%1"" объединено с ""%2"".';
			|fr = 'Le poste de travail « %1 » a été fusionné avec « %2 ».';
			|en = 'Workplace ""%1"" has been merged into ""%2"".';
			|es = 'El lugar de trabajo «%1» se ha fusionado con «%2».'"), РабочееМесто, Реквизиты.ОбъединеноВ);
	ИначеЕсли Реквизиты.ПометкаУдаления = Истина Тогда
		Возврат СтрШаблон(НСтр("ru = 'Рабочее место ""%1"" помечено на удаление.';
			|fr = 'Le poste de travail « %1 » est marqué pour suppression.';
			|en = 'Workplace ""%1"" is marked for deletion.';
			|es = 'El lugar de trabajo «%1» está marcado para eliminar.'"), РабочееМесто);
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

Функция ПричинаОтказаПары(Источник, Приемник)

	Если Не ЗначениеЗаполнено(Источник) Или Не ЗначениеЗаполнено(Приемник) Тогда
		Возврат НСтр("ru = 'Не заданы рабочие места.'; fr = 'Les postes de travail ne sont pas renseignés.';
			|en = 'Workplaces are not specified.'; es = 'No se han indicado los lugares de trabajo.'");
	ИначеЕсли Источник = Приемник Тогда
		Возврат НСтр("ru = 'Рабочее место нельзя объединить или обменять оборудованием само с собой.';
			|fr = 'Un poste de travail ne peut pas être fusionné ni échanger du matériel avec lui-même.';
			|en = 'A workplace cannot be merged with or exchange equipment with itself.';
			|es = 'Un lugar de trabajo no puede fusionarse ni intercambiar equipos consigo mismo.'");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

Процедура ВыполнитьОбъединение(Источник, Приемник, Оставить, Удалить)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Идентификаторы.ИдентификаторКлиента КАК ИдентификаторКлиента,
	|	Идентификаторы.ИмяКомпьютера КАК ИмяКомпьютера
	|ИЗ
	|	РегистрСведений.ИдентификаторыРабочихМест КАК Идентификаторы
	|ГДЕ
	|	Идентификаторы.РабочееМесто = &Источник";
	Запрос.УстановитьПараметр("Источник", Источник);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаблокироватьИдентификатор(Выборка.ИдентификаторКлиента);
		ЗаписатьИдентификатор(Выборка.ИдентификаторКлиента, Приемник, Выборка.ИмяКомпьютера, "Объединение");
	КонецЦикла;

	Для Каждого Устройство Из Удалить Цикл
		УстройствоОбъект = Устройство.ПолучитьОбъект();
		УстройствоОбъект.ПометкаУдаления = Истина;
		УстройствоОбъект.Записать();
	КонецЦикла;
	Для Каждого Устройство Из Оставить Цикл
		УстройствоОбъект = Устройство.ПолучитьОбъект();
		Если УстройствоОбъект.РабочееМесто <> Приемник Тогда
			УстройствоОбъект.РабочееМесто = Приемник;
			УстройствоОбъект.Записать();
		КонецЕсли;
	КонецЦикла;

	МестоОбъект = Источник.ПолучитьОбъект();
	МестоОбъект.ОбъединеноВ = Приемник;
	МестоОбъект.ПометкаУдаления = Истина;
	МестоОбъект.Записать();

КонецПроцедуры

Функция СоставСовпадает(Источник, Приемник, Оставить, Удалить)

	// Непомеченное оборудование обоих мест совпадает с объединением списков, списки не пересекаются и без повторов.
	// Читать под блокировкой мест.

	Ожидаемое = Новый Соответствие;
	Для Каждого Список Из ПараМест(Оставить, Удалить) Цикл
		Для Каждого Устройство Из Список Цикл
			Если Ожидаемое[Устройство] <> Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			Ожидаемое.Вставить(Устройство, Истина);
		КонецЦикла;
	КонецЦикла;

	Фактическое = ОборудованиеМест(ПараМест(Источник, Приемник));
	Если Фактическое.Количество() <> Ожидаемое.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Устройство Из Фактическое Цикл
		Если Ожидаемое[Устройство] = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ВсеОборудованиеУМеста(Оборудование, РабочееМесто)

	// Все устройства списка непомечены и принадлежат месту. Читать под блокировкой места.

	Фактическое = ОборудованиеМест(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(РабочееМесто));
	Для Каждого Устройство Из Оборудование Цикл
		Если Фактическое.Найти(Устройство) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Оборудование.Количество() > 0;

КонецФункции

Функция ОборудованиеМест(Места)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПодключаемоеОборудование.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.РабочееМесто В (&Места)
	|	И НЕ ПодключаемоеОборудование.ПометкаУдаления";
	Запрос.УстановитьПараметр("Места", Места);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Функция КлючУстройства(СтрокаТаблицы)

	Признак = СокрЛП(СтрокаТаблицы.ИдентификаторУстройства);
	Если ПустаяСтрока(Признак) Тогда
		Параметры = Неопределено;
		Если ТипЗнч(СтрокаТаблицы.Параметры) = Тип("ХранилищеЗначения") Тогда
			Попытка
				Параметры = СтрокаТаблицы.Параметры.Получить();
			Исключение
				// Повреждённые параметры устройства - совпадение не доказать, устройство ни с чем не совпадает.
				Параметры = Неопределено;
			КонецПопытки;
		КонецЕсли;
		Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Порт") Тогда
			Признак = СокрЛП(Строка(Параметры.Порт));
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(Признак) Тогда
		// Без идентификатора устройства и порта одинаковые тип и драйвер не доказывают, что это одно устройство:
		// ключ уникален, и устройство остаётся отмеченным «оставить».
		Возврат Строка(СтрокаТаблицы.Ссылка.УникальныйИдентификатор());
	КонецЕсли;
	Драйвер = Строка(СтрокаТаблицы.ДрайверОборудования.УникальныйИдентификатор());
	Возврат Строка(СтрокаТаблицы.ТипОборудования) + "|" + Драйвер + "|" + ВРег(Признак);

КонецФункции

Функция ПараМест(Источник, Приемник)

	Места = Новый Массив;
	Места.Добавить(Источник);
	Места.Добавить(Приемник);
	Возврат Места;

КонецФункции

Процедура ПроверитьПравоАдминистрирования()

	Если Не ДоступноАдминистрирование() Тогда
		ВызватьИсключение НСтр("ru = 'Перенос и объединение рабочих мест доступны только администратору.';
			|fr = 'Le transfert et la fusion des postes de travail sont réservés à l''administrateur.';
			|en = 'Only an administrator can move and merge workplaces.';
			|es = 'Solo un administrador puede trasladar y fusionar lugares de trabajo.'");
	КонецЕсли;

КонецПроцедуры

Функция РезультатОперации(Текст)

	Возврат Новый Структура("Успех, Текст", ПустаяСтрока(Текст), Текст);

КонецФункции

Функция ТекстДанныеИзменились()

	Возврат НСтр("ru = 'Данные рабочих мест изменились в другом сеансе. Обновите форму и повторите.';
		|fr = 'Les données des postes de travail ont été modifiées dans une autre session. Actualisez le formulaire et réessayez.';
		|en = 'Workplace data was changed in another session. Refresh the form and try again.';
		|es = 'Los datos de los lugares de trabajo se modificaron en otra sesión. Actualice el formulario y vuelva a intentarlo.'");

КонецФункции

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'Рабочие места'; fr = 'Postes de travail'; en = 'Workplaces'; es = 'Lugares de trabajo'",
		ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

#КонецЕсли

#КонецОбласти
