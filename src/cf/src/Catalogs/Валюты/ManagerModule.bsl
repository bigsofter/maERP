
// Сумма прописью в валюте на языке локализации. Параметры прописи - из табличной части валюты, а без её строки -
// параметры по умолчанию для известных кодов валют (ПараметрыПрописиПоУмолчанию): табличную часть не заполняет ни
// начальное заполнение, ни классификатор, и юридическая строка счёта-фактуры печаталась цифрами.
//
// Параметры:
//  Сумма       - Число - сумма.
//  Валюта      - СправочникСсылка.Валюты - валюта суммы.
//  Локализация - ПеречислениеСсылка.Локализации - язык прописи.
//
// Возвращаемое значение:
//  Строка - сумма прописью; валюта без параметров и с неизвестным кодом - сумма цифрами.
//
Функция СформироватьСуммуПрописью(Сумма, Валюта, Локализация) Экспорт
	Стр = Валюта.ТЧПараметрыИсчисления.Найти(Локализация, "Локализация");
	Если Стр = Неопределено Тогда
		ПараметрыИсчисления = ПараметрыПрописиПоУмолчанию(СокрЛП(Валюта.Код), Локализация);
		Если ПараметрыИсчисления = "" Тогда
			Возврат Строка(Сумма);
		КонецЕсли;
	ИначеЕсли Локализация = Перечисления.Локализации.ru_RU Тогда
		ПараметрыИсчисления = Стр.ЦелаяЧасть1 + "," + Стр.ЦелаяЧасть2 + "," + Стр.ЦелаяЧасть5 + ", м, " +
						 	Стр.ДробнаяЧасть1 + "," + Стр.ДробнаяЧасть2 + "," + Стр.ДробнаяЧасть5 + ", ж, 2";
	Иначе
		ПараметрыИсчисления = Стр.ЦелаяЧасть1 + "," + Стр.ЦелаяЧасть2 + "," +
						 	Стр.ДробнаяЧасть1 + "," + Стр.ДробнаяЧасть2 + ", 2";
	КонецЕсли;
	ФорматнаяСтрока = "Л = " + Локализация + "; ДП = False";
	Если Локализация <> Перечисления.Локализации.ru_RU Тогда
		ФорматнаяСтрока = ФорматнаяСтрока + "; ИИ = Использовать";
	КонецЕсли;
	Возврат ЧислоПрописью(Сумма, ФорматнаяСтрока, ПараметрыИсчисления);
КонецФункции

// Параметры прописи ЧислоПрописью для валют, у которых их нет в табличной части: дирхам, евро, доллар США, рубль.
//
// Параметры:
//  КодВалюты   - Строка - цифровой код валюты.
//  Локализация - ПеречислениеСсылка.Локализации - язык прописи.
//
// Возвращаемое значение:
//  Строка - параметры предмета исчисления; пусто - валюта или локализация неизвестны.
//
Функция ПараметрыПрописиПоУмолчанию(КодВалюты, Локализация)
	Если КодВалюты = "504" Тогда
		ПоЛокализациям = ПараметрыПоЛокализациям("дирхам, дирхама, дирхамов, м, сантим, сантима, сантимов, м, 2",
			"dirham, dirhams, centime, centimes, 2", "dirham, dirhams, centime, centimes, 2");
	ИначеЕсли КодВалюты = "978" Тогда
		ПоЛокализациям = ПараметрыПоЛокализациям("евро, евро, евро, м, цент, цента, центов, м, 2",
			"euro, euros, cent, cents, 2", "euro, euros, centime, centimes, 2");
	ИначеЕсли КодВалюты = "840" Тогда
		ПоЛокализациям = ПараметрыПоЛокализациям("доллар, доллара, долларов, м, цент, цента, центов, м, 2",
			"dollar, dollars, cent, cents, 2", "dollar, dollars, cent, cents, 2");
	ИначеЕсли КодВалюты = "643" Тогда
		ПоЛокализациям = ПараметрыПоЛокализациям("рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2",
			"ruble, rubles, kopeck, kopecks, 2", "rouble, roubles, kopeck, kopecks, 2");
	Иначе
		ПоЛокализациям = Неопределено;
	КонецЕсли;
	Если ПоЛокализациям = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = ПоЛокализациям.Получить(Локализация);
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

Функция ПараметрыПоЛокализациям(ПараметрыRU, ПараметрыEN, ПараметрыFR)
	Результат = Новый Соответствие;
	Результат.Вставить(Перечисления.Локализации.ru_RU, ПараметрыRU);
	Результат.Вставить(Перечисления.Локализации.en_US, ПараметрыEN);
	Результат.Вставить(Перечисления.Локализации.fr_CA, ПараметрыFR);
	Возврат Результат;
КонецФункции

Функция ПолучитьПараметрыИсчисления(Сумма, Валюта, Локализация) Экспорт
	Структура = Новый Структура("ЦелаяЧасть, ДробнаяЧасть", "", "");
	Стр = Валюта.ТЧПараметрыИсчисления.Найти(Локализация, "Локализация");
	Если Стр = Неопределено Тогда
		Возврат Структура;	
	КонецЕсли;
	ЦелаяЧасть = Цел(Сумма);
	ДробнаяЧасть = Сумма - ЦелаяЧасть;
	ЦелаяЧасть = Число(Прав(ЦелаяЧасть, 1));
	ДробнаяЧасть = Число(Прав(ДробнаяЧасть, 1));
	Структура.ЦелаяЧасть = ?(ЦелаяЧасть = 1, Стр.ЦелаяЧасть1, ?(ЦелаяЧасть = 2, Стр.ЦелаяЧасть2, Стр.ЦелаяЧасть5));
	Структура.ДробнаяЧасть = ?(ДробнаяЧасть = 1, Стр.ДробнаяЧасть1, ?(ДробнаяЧасть = 2, Стр.ДробнаяЧасть2, Стр.ДробнаяЧасть5));	
	Возврат Структура;
КонецФункции	

Функция ПолучитьУстановленные() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Валюты.Ссылка КАК Ссылка,
	                      |	Валюты.Код КАК Код,
	                      |	Валюты.Наименование КАК Наименование
	                      |ИЗ
	                      |	Справочник.Валюты КАК Валюты
	                      |ГДЕ
	                      |	Валюты.ПометкаУдаления = ЛОЖЬ");
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	