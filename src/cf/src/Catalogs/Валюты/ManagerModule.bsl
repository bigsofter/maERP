
// Сумма прописью в валюте на языке локализации. Параметры прописи - из табличной части валюты, а без её строки -
// параметры по умолчанию для известных кодов валют (ПараметрыПрописиПоУмолчанию): в базах, заполненных до того, как
// начальное заполнение стало заполнять табличную часть, юридическая строка счёта-фактуры печаталась цифрами.
//
// Параметры:
//  Сумма       - Число - сумма.
//  Валюта      - СправочникСсылка.Валюты - валюта суммы.
//  Локализация - ПеречислениеСсылка.Локализации - язык прописи.
//
// Возвращаемое значение:
//  Строка - сумма прописью; валюта без параметров и с неизвестным кодом - сумма цифрами.
//
Функция СформироватьСуммуПрописью(Сумма, Валюта, Локализация) Экспорт
	Параметры = Валюта.ТЧПараметрыИсчисления.Найти(Локализация, "Локализация");
	Если Параметры = Неопределено Тогда
		Параметры = ПараметрыПрописиПоУмолчанию(СокрЛП(Валюта.Код)).Получить(Локализация);
		Если Параметры = Неопределено Тогда
			Возврат Строка(Сумма);
		КонецЕсли;
	КонецЕсли;
	Если Локализация = Перечисления.Локализации.ru_RU Тогда
		ПараметрыИсчисления = Параметры.ЦелаяЧасть1 + "," + Параметры.ЦелаяЧасть2 + "," + Параметры.ЦелаяЧасть5 + ", "
			+ РодПрописи(Параметры.ЦелаяЧастьРод, "м") + ", " + Параметры.ДробнаяЧасть1 + "," + Параметры.ДробнаяЧасть2
			+ "," + Параметры.ДробнаяЧасть5 + ", " + РодПрописи(Параметры.ДробнаяЧастьРод, "ж") + ", 2";
	Иначе
		ПараметрыИсчисления = Параметры.ЦелаяЧасть1 + "," + Параметры.ЦелаяЧасть2 + "," +
						 	Параметры.ДробнаяЧасть1 + "," + Параметры.ДробнаяЧасть2 + ", 2";
	КонецЕсли;
	ФорматнаяСтрока = "Л = " + Локализация + "; ДП = False";
	Если Локализация <> Перечисления.Локализации.ru_RU Тогда
		ФорматнаяСтрока = ФорматнаяСтрока + "; ИИ = Использовать";
	КонецЕсли;
	Возврат ЧислоПрописью(Сумма, ФорматнаяСтрока, ПараметрыИсчисления);
КонецФункции

// Дополняет параметры прописи валют с известным кодом (дирхам, евро, доллар США, рубль) строками всех языков
// локализации - значениями ПараметрыПрописиПоУмолчанию. Строки, которые уже есть в табличной части, не меняет:
// повторный вызов правок пользователя не затирает. Вызывается начальным заполнением базы.
//
// Возвращаемое значение:
//  Число - сколько валют дополнено.
//
Функция ЗаполнитьПараметрыПрописи() Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Валюты.Ссылка КАК Ссылка,
		|	Валюты.Код КАК Код
		|ИЗ
		|	Справочник.Валюты КАК Валюты
		|ГДЕ
		|	НЕ Валюты.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Дополнено = 0;
	Пока Выборка.Следующий() Цикл
		ПоЛокализациям = ПараметрыПрописиПоУмолчанию(СокрЛП(Выборка.Код));
		Если ПоЛокализациям.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ВалютаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ВалютаОбъект.Заблокировать();
		Добавлено = Ложь;
		Для Каждого ПараметрыЯзыка Из ПоЛокализациям Цикл
			Если ВалютаОбъект.ТЧПараметрыИсчисления.Найти(ПараметрыЯзыка.Ключ, "Локализация") <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ВалютаОбъект.ТЧПараметрыИсчисления.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыЯзыка.Значение);
			НоваяСтрока.Локализация = ПараметрыЯзыка.Ключ;
			Добавлено = Истина;
		КонецЦикла;
		Если Добавлено Тогда
			ВалютаОбъект.Записать();
			Дополнено = Дополнено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Дополнено;
КонецФункции

// Параметры прописи по умолчанию для валют с известным кодом: дирхам, евро, доллар США, рубль.
//
// Параметры:
//  КодВалюты - Строка - цифровой код валюты.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - ПеречислениеСсылка.Локализации - язык прописи.
//   * Значение - Структура - поля строки табличной части ТЧПараметрыИсчисления без Локализации.
//  Пустое - валюта неизвестна.
//
Функция ПараметрыПрописиПоУмолчанию(КодВалюты)
	Если КодВалюты = "504" Тогда
		Возврат ПараметрыПоЛокализациям("дирхам, дирхама, дирхамов, м, сантим, сантима, сантимов, м",
			"dirham, dirhams, dirhams, , centime, centimes, centimes, ",
			"dirham, dirhams, dirhams, м, centime, centimes, centimes, м");
	ИначеЕсли КодВалюты = "978" Тогда
		Возврат ПараметрыПоЛокализациям("евро, евро, евро, м, цент, цента, центов, м",
			"euro, euros, euros, , cent, cents, cents, ",
			"euro, euros, euros, м, centime, centimes, centimes, м");
	ИначеЕсли КодВалюты = "840" Тогда
		Возврат ПараметрыПоЛокализациям("доллар, доллара, долларов, м, цент, цента, центов, м",
			"dollar, dollars, dollars, , cent, cents, cents, ",
			"dollar, dollars, dollars, м, cent, cents, cents, м");
	ИначеЕсли КодВалюты = "643" Тогда
		Возврат ПараметрыПоЛокализациям("рубль, рубля, рублей, м, копейка, копейки, копеек, ж",
			"ruble, rubles, rubles, , kopeck, kopecks, kopecks, ",
			"rouble, roubles, roubles, м, kopeck, kopecks, kopecks, ж");
	Иначе
		Возврат Новый Соответствие;
	КонецЕсли;
КонецФункции

Функция ПараметрыПоЛокализациям(ПараметрыRU, ПараметрыEN, ПараметрыFR)
	Результат = Новый Соответствие;
	Результат.Вставить(Перечисления.Локализации.ru_RU, ПараметрыЯзыкаИзСтроки(ПараметрыRU));
	Результат.Вставить(Перечисления.Локализации.en_US, ПараметрыЯзыкаИзСтроки(ПараметрыEN));
	Результат.Вставить(Перечисления.Локализации.fr_CA, ПараметрыЯзыкаИзСтроки(ПараметрыFR));
	Возврат Результат;
КонецФункции

// Параметры одного языка из строки: «один, два, пять, род» целой части и та же четвёрка дробной.
//
// Параметры:
//  СтрокаПараметров - Строка - восемь значений через запятую, недостающие - пустые.
//
// Возвращаемое значение:
//  Структура - поля строки табличной части ТЧПараметрыИсчисления без Локализации.
//
Функция ПараметрыЯзыкаИзСтроки(СтрокаПараметров)
	Поля = СтрРазделить("ЦелаяЧасть1,ЦелаяЧасть2,ЦелаяЧасть5,ЦелаяЧастьРод,"
		+ "ДробнаяЧасть1,ДробнаяЧасть2,ДробнаяЧасть5,ДробнаяЧастьРод", ",");
	Слова = СтрРазделить(СтрокаПараметров, ",");
	Результат = Новый Структура;
	Для Индекс = 0 По Поля.ВГраница() Цикл
		Результат.Вставить(Поля[Индекс], ?(Индекс <= Слова.ВГраница(), СокрЛП(Слова[Индекс]), ""));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Род предмета исчисления для русской прописи.
//
// Параметры:
//  Род            - Строка - род из строки параметров валюты.
//  РодПоУмолчанию - Строка - род, если в строке пусто или не м, ж, с (латиница из ручного ввода).
//
// Возвращаемое значение:
//  Строка - м, ж или с.
//
Функция РодПрописи(Род, РодПоУмолчанию)
	Значение = НРег(СокрЛП(Род));
	Возврат ?(СтрНайти("мжс", Значение) > 0 И СтрДлина(Значение) = 1, Значение, РодПоУмолчанию);
КонецФункции

Функция ПолучитьПараметрыИсчисления(Сумма, Валюта, Локализация) Экспорт
	Структура = Новый Структура("ЦелаяЧасть, ДробнаяЧасть", "", "");
	Стр = Валюта.ТЧПараметрыИсчисления.Найти(Локализация, "Локализация");
	Если Стр = Неопределено Тогда
		Возврат Структура;	
	КонецЕсли;
	ЦелаяЧасть = Цел(Сумма);
	ДробнаяЧасть = Сумма - ЦелаяЧасть;
	ЦелаяЧасть = Число(Прав(ЦелаяЧасть, 1));
	ДробнаяЧасть = Число(Прав(ДробнаяЧасть, 1));
	Структура.ЦелаяЧасть = ?(ЦелаяЧасть = 1, Стр.ЦелаяЧасть1, ?(ЦелаяЧасть = 2, Стр.ЦелаяЧасть2, Стр.ЦелаяЧасть5));
	Структура.ДробнаяЧасть = ?(ДробнаяЧасть = 1, Стр.ДробнаяЧасть1, ?(ДробнаяЧасть = 2, Стр.ДробнаяЧасть2, Стр.ДробнаяЧасть5));	
	Возврат Структура;
КонецФункции	

Функция ПолучитьУстановленные() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Валюты.Ссылка КАК Ссылка,
	                      |	Валюты.Код КАК Код,
	                      |	Валюты.Наименование КАК Наименование
	                      |ИЗ
	                      |	Справочник.Валюты КАК Валюты
	                      |ГДЕ
	                      |	Валюты.ПометкаУдаления = ЛОЖЬ");
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	