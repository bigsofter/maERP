#Область ОбщиеРасчеты

// Считает по таблице дней сумму за период диаграмм, суммы текущего и прошлого
// календарного месяца, рекорд дня и серию непрерывных дней с ненулевым значением.
//
// Параметры:
//  ТаблицаДней - ТаблицаЗначений - строки по дням с колонками День и колонкой значения.
//  ИмяПоляЗначения - Строка - имя колонки значения в таблице дней.
//  НачалоСегодня - Дата - начало текущего дня.
//  НачалоПериодаДиаграмм - Дата - начало периода, за который считаются сумма и рекорд.
//  НачалоПрошлогоМесяца - Дата - начало прошлого календарного месяца.
//
// Возвращаемое значение:
//  Структура - поля СуммаЗаПериод, ТекущийМесяц, ПрошлыйМесяц, Рекорд, ДеньРекорда, Серия.
//
Функция ПоказателиДинамики(ТаблицаДней, ИмяПоляЗначения, НачалоСегодня, НачалоПериодаДиаграмм, НачалоПрошлогоМесяца)

	НачалоТекущегоМесяца = НачалоМесяца(НачалоСегодня);

	СуммаЗаПериод = 0;
	ТекущийМесяц = 0;
	ПрошлыйМесяц = 0;
	Рекорд = 0;
	ДеньРекорда = Дата(1, 1, 1);
	ДниСоЗначением = Новый Соответствие;

	Для Каждого СтрокаДня Из ТаблицаДней Цикл
		Значение = СтрокаДня[ИмяПоляЗначения];
		Если Значение > 0 Тогда
			ДниСоЗначением.Вставить(СтрокаДня.День, Истина);
		КонецЕсли;
		Если СтрокаДня.День >= НачалоПериодаДиаграмм Тогда
			СуммаЗаПериод = СуммаЗаПериод + Значение;
			Если Значение > Рекорд Тогда
				Рекорд = Значение;
				ДеньРекорда = СтрокаДня.День;
			КонецЕсли;
		КонецЕсли;
		Если СтрокаДня.День >= НачалоТекущегоМесяца Тогда
			ТекущийМесяц = ТекущийМесяц + Значение;
		КонецЕсли;
		Если СтрокаДня.День >= НачалоПрошлогоМесяца И СтрокаДня.День < НачалоТекущегоМесяца Тогда
			ПрошлыйМесяц = ПрошлыйМесяц + Значение;
		КонецЕсли;
	КонецЦикла;

	// Серия непрерывных дней; день без значения сегодня серию не рвет - день еще не кончился.
	Серия = 0;
	День = НачалоСегодня;
	Если ДниСоЗначением[День] = Неопределено Тогда
		День = День - СекундВСутках();
	КонецЕсли;
	Пока ДниСоЗначением[День] <> Неопределено Цикл
		Серия = Серия + 1;
		День = День - СекундВСутках();
	КонецЦикла;

	Показатели = Новый Структура;
	Показатели.Вставить("СуммаЗаПериод", СуммаЗаПериод);
	Показатели.Вставить("ТекущийМесяц", ТекущийМесяц);
	Показатели.Вставить("ПрошлыйМесяц", ПрошлыйМесяц);
	Показатели.Вставить("Рекорд", Рекорд);
	Показатели.Вставить("ДеньРекорда", ДеньРекорда);
	Показатели.Вставить("Серия", Серия);
	Возврат Показатели;

КонецФункции

Функция ЗначениеДня(ТаблицаДней, ИмяПоляЗначения, День)

	Для Каждого СтрокаДня Из ТаблицаДней Цикл
		Если СтрокаДня.День = День Тогда
			Возврат СтрокаДня[ИмяПоляЗначения];
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

Функция ПредставлениеСерии(СерияДней)

	СерияДостойнаяОгня = 3;
	Шаблон = НСтр("ru = '%1 дн.'; fr = '%1 j'; en = '%1 d'; es = '%1 d'");
	Представление = СтрШаблон(Шаблон, ФорматЧисла(СерияДней));
	Если СерияДней >= СерияДостойнаяОгня Тогда
		Представление = "🔥 " + Представление;
	КонецЕсли;
	Возврат Представление;

КонецФункции

Функция ПредставлениеРекорда(РекордДня, ДеньРекорда)

	Если РекордДня = 0 Тогда
		Возврат "-";
	КонецЕсли;
	Возврат "🏆 " + ФорматЧисла(РекордДня) + " · " + Формат(ДеньРекорда, "ДФ=dd.MM");

КонецФункции

Функция ПредставлениеПрогресса(ЗначениеТекущегоМесяца, ЗначениеПрошлогоМесяца)

	Если ЗначениеПрошлогоМесяца = 0 Тогда
		Возврат ?(ЗначениеТекущегоМесяца > 0, "🚀 -", "-");
	КонецЕсли;

	СтоПроцентов = 100;
	Процент = Окр(ЗначениеТекущегоМесяца / ЗначениеПрошлогоМесяца * СтоПроцентов);
	Возврат ШкалаПроцента(Процент) + " " + ФорматЧисла(Процент) + "%" + ?(Процент >= СтоПроцентов, " 🚀", "");

КонецФункции

Функция ШкалаПроцента(Процент)

	СтоПроцентов = 100;
	КодЯчейкиЗаполненной = 9608;
	КодЯчейкиПустой = 9617;
	ДлинаШкалы = 10;
	Заполнено = Мин(ДлинаШкалы, Цел(Процент * ДлинаШкалы / СтоПроцентов));
	Шкала = "";
	Для Ячейка = 1 По ДлинаШкалы Цикл
		Шкала = Шкала + ?(Ячейка <= Заполнено, Символ(КодЯчейкиЗаполненной), Символ(КодЯчейкиПустой));
	КонецЦикла;
	Возврат Шкала;

КонецФункции

Функция ФорматЧисла(Значение)

	Возврат Формат(ЧислоИлиНоль(Значение), "ЧДЦ=0; ЧРГ=' '; ЧН=0");

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Если Значение = NULL Или Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ДнейВПериоде()

	Возврат 30;

КонецФункции

Функция СекундВСутках()

	Возврат 86400;

КонецФункции

