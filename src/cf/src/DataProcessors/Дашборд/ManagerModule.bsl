
#Область ПрограммныйИнтерфейс

// Создаёт на форме реквизиты и элементы стокового дашборда:
// карточки показателей, достижения склада и диаграммы остатков и потребностей.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой размещается дашборд.
//  Родитель - ГруппаФормы, Неопределено - группа для элементов; Неопределено - корень формы.
//
Процедура ПостроитьСтоковыйДашборд(Форма, Родитель = Неопределено) Экспорт

	ТипДиаграмма = Новый ОписаниеТипов("Диаграмма");
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаВыручка", ТипДиаграмма));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаОстатки", ТипДиаграмма));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаПотребности", ТипДиаграмма));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	ГруппаПоказателей = ДобавитьГруппу(Форма, "ГруппаПоказатели", Ложь, Родитель);
	ДобавитьКарточку(Форма, ГруппаПоказателей, "Выручка30",
		НСтр("ru = 'Выручка за 30 дней'; fr = 'CA sur 30 jours'; en = 'Revenue, 30 days'; es = 'Ingresos, 30 días'"));
	ДобавитьКарточку(Форма, ГруппаПоказателей, "Прибыль30",
		НСтр("ru = 'Валовая прибыль за 30 дней'; fr = 'Marge brute sur 30 jours';
			|en = 'Gross profit, 30 days'; es = 'Beneficio bruto, 30 días'"));
	ДобавитьКарточку(Форма, ГруппаПоказателей, "СтоимостьСклада",
		НСтр("ru = 'Стоимость остатков'; fr = 'Valeur du stock'; en = 'Stock value'; es = 'Valor del stock'"));
	ДобавитьКарточку(Форма, ГруппаПоказателей, "НижеЛимита",
		НСтр("ru = 'Позиций ниже лимита'; fr = 'Articles sous la limite'; en = 'Items below limit'; es = 'Artículos bajo el límite'"));

	ГруппаДостижений = ДобавитьГруппу(Форма, "ГруппаСтокДостижения", Ложь, Родитель);
	ДобавитьКарточку(Форма, ГруппаДостижений, "ЗдоровьеСклада",
		НСтр("ru = 'Здоровье склада'; fr = 'Santé du stock'; en = 'Stock health'; es = 'Salud del stock'"));
	ДобавитьКарточку(Форма, ГруппаДостижений, "ПерекрытиеДефицита",
		НСтр("ru = 'Дефицит перекрыт заказами'; fr = 'Déficit couvert par commandes';
			|en = 'Deficit covered by orders'; es = 'Déficit cubierto por pedidos'"));
	ДобавитьКарточку(Форма, ГруппаДостижений, "Оборачиваемость",
		НСтр("ru = 'Оборачиваемость за месяц'; fr = 'Rotation mensuelle';
			|en = 'Monthly turnover'; es = 'Rotación mensual'"));

	ГруппаВерхнихДиаграмм = ДобавитьГруппу(Форма, "ГруппаВерхниеДиаграммы", Истина, Родитель);
	ДобавитьДиаграмму(Форма, ГруппаВерхнихДиаграмм, "ДиаграммаВыручка",
		НСтр("ru = 'Выручка по клиентам за 30 дней'; fr = 'CA par client sur 30 jours';
			|en = 'Revenue by customer, 30 days'; es = 'Ingresos por cliente, 30 días'"));
	ДобавитьДиаграмму(Форма, ГруппаВерхнихДиаграмм, "ДиаграммаОстатки",
		НСтр("ru = 'Остатки по товарным группам'; fr = 'Stock par groupe de produits';
			|en = 'Stock by product group'; es = 'Stock por grupo de productos'"));

	ГруппаНижнихДиаграмм = ДобавитьГруппу(Форма, "ГруппаНижниеДиаграммы", Истина, Родитель);
	ДобавитьДиаграмму(Форма, ГруппаНижнихДиаграмм, "ДиаграммаПотребности",
		НСтр("ru = 'Потребности и лимиты: дефицитные позиции'; fr = 'Besoins et limites : articles en déficit';
			|en = 'Needs and limits: items in deficit'; es = 'Necesidades y límites: artículos en déficit'"));

КонецПроцедуры

// Пересчитывает и выводит данные стокового дашборда,
// построенного процедурой ПостроитьСтоковыйДашборд.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с построенным стоковым дашбордом.
//
Процедура ОбновитьСтоковыйДашборд(Форма) Экспорт

	// Дашборд агрегирует данные регистров только на чтение; права ролей на сами регистры не требуются.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	Данные = ДанныеСтока();

	Форма.Элементы.ЗначениеВыручка30.Заголовок = ФорматЧисла(Данные.Выручка30);
	Форма.Элементы.ЗначениеПрибыль30.Заголовок = ФорматЧисла(Данные.Прибыль30);
	Форма.Элементы.ЗначениеСтоимостьСклада.Заголовок = ФорматЧисла(Данные.СтоимостьСклада);
	Форма.Элементы.ЗначениеНижеЛимита.Заголовок = ФорматЧисла(Данные.НижеЛимита);

	Форма.Элементы.ЗначениеЗдоровьеСклада.Заголовок = ПредставлениеЗдоровьяСклада(Данные.ВсегоСЛимитом, Данные.НижеЛимита);
	Форма.Элементы.ЗначениеПерекрытиеДефицита.Заголовок =
		ПредставлениеПерекрытияДефицита(Данные.НижеЛимита, Данные.ПерекрытоЗаказами);
	Форма.Элементы.ЗначениеОборачиваемость.Заголовок =
		ПредставлениеОборачиваемости(Данные.Выручка30, Данные.Прибыль30, Данные.СтоимостьСклада);

	ЗаполнитьДиаграммуВыручкиПоКлиентам(Форма, Данные.ВыручкаПоКлиентам);
	ЗаполнитьДиаграммуОстатков(Форма, Данные.ОстаткиПоГруппам);
	ЗаполнитьДиаграммуПотребностей(Форма, Данные.Потребности);

КонецПроцедуры

// Создаёт на форме реквизиты и элементы дашборда продаж:
// карточки показателей, достижения и диаграммы выручки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой размещается дашборд.
//  Родитель - ГруппаФормы, Неопределено - группа для элементов; Неопределено - корень формы.
//
Процедура ПостроитьДашбордПродаж(Форма, Родитель = Неопределено) Экспорт

	ТипДиаграмма = Новый ОписаниеТипов("Диаграмма");
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаВыручкаПоДням", ТипДиаграмма));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаТопТоваров", ТипДиаграмма));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаПоСотрудникам", ТипДиаграмма));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	ГруппаПоказателей = ДобавитьГруппу(Форма, "ГруппаПродажиПоказатели", Ложь, Родитель);
	ДобавитьКарточку(Форма, ГруппаПоказателей, "ВыручкаСегодня",
		НСтр("ru = 'Выручка сегодня'; fr = 'CA aujourd''hui'; en = 'Revenue today'; es = 'Ingresos hoy'"));
	ДобавитьКарточку(Форма, ГруппаПоказателей, "ПродажЗаМесяц",
		НСтр("ru = 'Продаж за 30 дней'; fr = 'Ventes sur 30 jours'; en = 'Sales, 30 days'; es = 'Ventas, 30 días'"));
	ДобавитьКарточку(Форма, ГруппаПоказателей, "СреднийЧек",
		НСтр("ru = 'Средний чек за 30 дней'; fr = 'Panier moyen sur 30 jours';
			|en = 'Average sale, 30 days'; es = 'Ticket medio, 30 días'"));
	ДобавитьКарточку(Форма, ГруппаПоказателей, "ДолгПокупателей",
		НСтр("ru = 'Долг покупателей'; fr = 'Créances clients'; en = 'Customer debt'; es = 'Deuda de clientes'"));

	ГруппаДостижений = ДобавитьГруппу(Форма, "ГруппаПродажиДостижения", Ложь, Родитель);
	ДобавитьКарточку(Форма, ГруппаДостижений, "СерияПродаж",
		НСтр("ru = 'Серия дней с продажами'; fr = 'Série de jours avec ventes';
			|en = 'Sales day streak'; es = 'Racha de días con ventas'"));
	ДобавитьКарточку(Форма, ГруппаДостижений, "РекордВыручкиДня",
		НСтр("ru = 'Рекорд дня за 30 дней'; fr = 'Record du jour sur 30 jours';
			|en = 'Best day, 30 days'; es = 'Récord del día, 30 días'"));
	ДобавитьКарточку(Форма, ГруппаДостижений, "ПрогрессПродажМесяца",
		НСтр("ru = 'Месяц к прошлому месяцу'; fr = 'Mois vs mois précédent';
			|en = 'Month vs previous month'; es = 'Mes vs mes anterior'"));
	ДобавитьКарточку(Форма, ГруппаДостижений, "КлиентМесяца",
		НСтр("ru = 'Клиент месяца'; fr = 'Client du mois'; en = 'Customer of the month'; es = 'Cliente del mes'"));

	ГруппаВерхнихДиаграмм = ДобавитьГруппу(Форма, "ГруппаПродажиДиаграммыВерх", Истина, Родитель);
	ДобавитьДиаграмму(Форма, ГруппаВерхнихДиаграмм, "ДиаграммаВыручкаПоДням",
		НСтр("ru = 'Выручка по дням'; fr = 'CA par jour'; en = 'Revenue by day'; es = 'Ingresos por día'"));
	ДобавитьДиаграмму(Форма, ГруппаВерхнихДиаграмм, "ДиаграммаПоСотрудникам",
		НСтр("ru = 'Выручка по сотрудникам за 30 дней'; fr = 'CA par employé sur 30 jours';
			|en = 'Revenue by employee, 30 days'; es = 'Ingresos por empleado, 30 días'"));

	ГруппаНижнихДиаграмм = ДобавитьГруппу(Форма, "ГруппаПродажиДиаграммыНиз", Истина, Родитель);
	ДобавитьДиаграмму(Форма, ГруппаНижнихДиаграмм, "ДиаграммаТопТоваров",
		НСтр("ru = 'Топ товаров по выручке за 30 дней'; fr = 'Top produits par CA sur 30 jours';
			|en = 'Top products by revenue, 30 days'; es = 'Top productos por ingresos, 30 días'"));

КонецПроцедуры

// Пересчитывает и выводит данные дашборда продаж,
// построенного процедурой ПостроитьДашбордПродаж.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с построенным дашбордом продаж.
//
Процедура ОбновитьДашбордПродаж(Форма) Экспорт

	// Дашборд агрегирует данные регистров только на чтение; права ролей на сами регистры не требуются.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	Данные = ДанныеПродаж();

	Форма.Элементы.ЗначениеВыручкаСегодня.Заголовок = ФорматЧисла(Данные.ВыручкаСегодня);
	Форма.Элементы.ЗначениеПродажЗаМесяц.Заголовок = ФорматЧисла(Данные.ПродажЗаМесяц);
	Форма.Элементы.ЗначениеСреднийЧек.Заголовок = ФорматЧисла(Данные.СреднийЧек);
	Форма.Элементы.ЗначениеДолгПокупателей.Заголовок = ФорматЧисла(Данные.ДолгПокупателей);

	Форма.Элементы.ЗначениеСерияПродаж.Заголовок = ПредставлениеСерии(Данные.СерияДней);
	Форма.Элементы.ЗначениеРекордВыручкиДня.Заголовок = ПредставлениеРекорда(Данные.РекордДня, Данные.ДеньРекорда);
	Форма.Элементы.ЗначениеПрогрессПродажМесяца.Заголовок =
		ПредставлениеПрогресса(Данные.ВыручкаТекущегоМесяца, Данные.ВыручкаПрошлогоМесяца);
	Форма.Элементы.ЗначениеКлиентМесяца.Заголовок = ПредставлениеКлиентаМесяца(Данные.КлиентМесяца);

	ЗаполнитьДиаграммуВыручкиПоДням(Форма, Данные.ВыручкаПоДням, Данные.НачалоПериодаДиаграмм);
	ЗаполнитьДиаграммуПоСотрудникам(Форма, Данные.ВыручкаПоСотрудникам);
	ЗаполнитьДиаграммуТопТоваров(Форма, Данные.ТопТоваров);

КонецПроцедуры

// Создаёт на форме реквизиты и элементы производственного дашборда:
// карточки показателей, достижения и диаграммы выпуска.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой размещается дашборд.
//  Родитель - ГруппаФормы, Неопределено - группа для элементов; Неопределено - корень формы.
//
Процедура ПостроитьПроизводственныйДашборд(Форма, Родитель = Неопределено) Экспорт

	ТипДиаграмма = Новый ОписаниеТипов("Диаграмма");
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаВыпускПоДням", ТипДиаграмма));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаСтатусыЗаказов", ТипДиаграмма));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаТопПродукции", ТипДиаграмма));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	ГруппаПоказателей = ДобавитьГруппу(Форма, "ГруппаПроизводствоПоказатели", Ложь, Родитель);
	ДобавитьКарточку(Форма, ГруппаПоказателей, "ЗаказовВПроизводстве",
		НСтр("ru = 'Заказов в производстве'; fr = 'Commandes en production';
			|en = 'Orders in production'; es = 'Pedidos en producción'"));
	ДобавитьКарточку(Форма, ГруппаПоказателей, "ВыпущеноЗаМесяц",
		НСтр("ru = 'Выпущено за 30 дней'; fr = 'Produit sur 30 jours';
			|en = 'Produced, 30 days'; es = 'Producido, 30 días'"));
	ДобавитьКарточку(Форма, ГруппаПоказателей, "ВыпусковСегодня",
		НСтр("ru = 'Выпусков сегодня'; fr = 'Productions aujourd''hui';
			|en = 'Releases today'; es = 'Producciones hoy'"));
	ДобавитьКарточку(Форма, ГруппаПоказателей, "ПозицийВПереработке",
		НСтр("ru = 'Позиций в переработке'; fr = 'Articles en sous-traitance';
			|en = 'Items at subcontractors'; es = 'Artículos en maquila'"));

	ГруппаДостижений = ДобавитьГруппу(Форма, "ГруппаПроизводствоДостижения", Ложь, Родитель);
	ДобавитьКарточку(Форма, ГруппаДостижений, "СерияВыпусков",
		НСтр("ru = 'Серия дней с выпуском'; fr = 'Série de jours avec production';
			|en = 'Production day streak'; es = 'Racha de días con producción'"));
	ДобавитьКарточку(Форма, ГруппаДостижений, "РекордДня",
		НСтр("ru = 'Рекорд дня за 30 дней'; fr = 'Record du jour sur 30 jours';
			|en = 'Best day, 30 days'; es = 'Récord del día, 30 días'"));
	ДобавитьКарточку(Форма, ГруппаДостижений, "ПрогрессМесяца",
		НСтр("ru = 'Месяц к прошлому месяцу'; fr = 'Mois vs mois précédent';
			|en = 'Month vs previous month'; es = 'Mes vs mes anterior'"));
	ДобавитьКарточку(Форма, ГруппаДостижений, "ПросроченоОтгрузок",
		НСтр("ru = 'Просроченные отгрузки'; fr = 'Expéditions en retard';
			|en = 'Overdue shipments'; es = 'Envíos atrasados'"));

	ГруппаВерхнихДиаграмм = ДобавитьГруппу(Форма, "ГруппаПроизводствоДиаграммыВерх", Истина, Родитель);
	ДобавитьДиаграмму(Форма, ГруппаВерхнихДиаграмм, "ДиаграммаВыпускПоДням",
		НСтр("ru = 'Выпуск продукции по дням'; fr = 'Production par jour';
			|en = 'Output by day'; es = 'Producción por día'"));
	ДобавитьДиаграмму(Форма, ГруппаВерхнихДиаграмм, "ДиаграммаСтатусыЗаказов",
		НСтр("ru = 'Активные заказы по статусам'; fr = 'Commandes actives par statut';
			|en = 'Active orders by status'; es = 'Pedidos activos por estado'"));

	ГруппаНижнихДиаграмм = ДобавитьГруппу(Форма, "ГруппаПроизводствоДиаграммыНиз", Истина, Родитель);
	ДобавитьДиаграмму(Форма, ГруппаНижнихДиаграмм, "ДиаграммаТопПродукции",
		НСтр("ru = 'Топ продукции за 30 дней'; fr = 'Top produits sur 30 jours';
			|en = 'Top products, 30 days'; es = 'Top productos, 30 días'"));

КонецПроцедуры

// Пересчитывает и выводит данные производственного дашборда,
// построенного процедурой ПостроитьПроизводственныйДашборд.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с построенным производственным дашбордом.
//
Процедура ОбновитьПроизводственныйДашборд(Форма) Экспорт

	// Дашборд агрегирует данные регистров только на чтение; права ролей на сами регистры не требуются.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	Данные = ДанныеПроизводства();

	Форма.Элементы.ЗначениеЗаказовВПроизводстве.Заголовок = ФорматЧисла(Данные.ЗаказовВПроизводстве);
	Форма.Элементы.ЗначениеВыпущеноЗаМесяц.Заголовок = ФорматЧисла(Данные.ВыпущеноЗаМесяц);
	Форма.Элементы.ЗначениеВыпусковСегодня.Заголовок = ФорматЧисла(Данные.ВыпусковСегодня);
	Форма.Элементы.ЗначениеПозицийВПереработке.Заголовок = ФорматЧисла(Данные.ПозицийВПереработке);

	Форма.Элементы.ЗначениеСерияВыпусков.Заголовок = ПредставлениеСерии(Данные.СерияДней);
	Форма.Элементы.ЗначениеРекордДня.Заголовок = ПредставлениеРекорда(Данные.РекордДня, Данные.ДеньРекорда);
	Форма.Элементы.ЗначениеПрогрессМесяца.Заголовок =
		ПредставлениеПрогресса(Данные.ВыпускТекущегоМесяца, Данные.ВыпускПрошлогоМесяца);
	Форма.Элементы.ЗначениеПросроченоОтгрузок.Заголовок = ПредставлениеПросрочки(Данные.ПросроченоОтгрузок);

	ЗаполнитьДиаграммуВыпуска(Форма, Данные.ВыпускПоДням, Данные.НачалоПериодаДиаграмм);
	ЗаполнитьДиаграммуСтатусов(Форма, Данные.ЗаказыПоСтатусам);
	ЗаполнитьДиаграммуТопПродукции(Форма, Данные.ТопПродукции);

КонецПроцедуры

