Функция ДанныеСтока()

	ДнейВПериодеПродаж = ДнейВПериоде();
	КонецПериода = КонецДня(ТекущаяДатаСеанса());
	НачалоПериода = НачалоДня(КонецПериода - (ДнейВПериодеПродаж - 1) * СекундВСутках());

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	// Дашборду нужны остатки по всему складу и все открытые заказы, отбор в виртуальных таблицах не сузить.
	// BSLLS:VirtualTableCallWithoutParameters-off
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ТоварыВНаличииОстатки.КоличествоОстаток) КАК Количество,
	|	СУММА(ТоварыВНаличииОстатки.СуммаОстаток) КАК Сумма
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки() КАК ТоварыВНаличииОстатки
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВНаличииОстатки.Номенклатура
	|;
	|ВЫБРАТЬ
	|	Лимиты.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(Лимиты.Лимит) КАК Лимит
	|ПОМЕСТИТЬ ВТЛимиты
	|ИЗ
	|	(ВЫБРАТЬ
	|		Номенклатура.Ссылка КАК Номенклатура,
	|		Номенклатура.МинимальноеКоличествоХранения КАК Лимит
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Номенклатура.МинимальноеКоличествоХранения > 0
	|		И НЕ Номенклатура.ПометкаУдаления
	|	ОБЪЕДИНИТЬ ВСЕ
	|	ВЫБРАТЬ
	|		МинимальныйОстаток.Номенклатура,
	|		МинимальныйОстаток.МинимальноеКоличествоХранения
	|	ИЗ
	|		РегистрСведений.МинимальныйОстатокПоСкладам КАК МинимальныйОстаток
	|	ГДЕ
	|		МинимальныйОстаток.МинимальноеКоличествоХранения > 0) КАК Лимиты
	|СГРУППИРОВАТЬ ПО
	|	Лимиты.Номенклатура
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 10
	|	ПродажиОбороты.Контрагент КАК Контрагент,
	|	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ПродажиОбороты
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Контрагент
	|ИМЕЮЩИЕ
	|	СУММА(ПродажиОбороты.ВыручкаОборот) > 0
	|УПОРЯДОЧИТЬ ПО
	|	Выручка УБЫВ
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 8
	|	НоменклатураСправочник.ТоварнаяГруппа КАК ТоварнаяГруппа,
	|	СУММА(Остатки.Сумма) КАК Сумма
	|ИЗ
	|	ВТОстатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСправочник
	|		ПО Остатки.Номенклатура = НоменклатураСправочник.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	НоменклатураСправочник.ТоварнаяГруппа
	|УПОРЯДОЧИТЬ ПО
	|	Сумма УБЫВ
	|;
	|ВЫБРАТЬ
	|	ЗаказыОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ЗаказыОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТЗаказано
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки() КАК ЗаказыОстатки
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыОстатки.Номенклатура
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 10
	|	Лимиты.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(Остатки.Количество, 0) КАК Остаток,
	|	Лимиты.Лимит КАК Лимит,
	|	ЕСТЬNULL(Заказано.Количество, 0) КАК Заказано,
	|	Лимиты.Лимит - ЕСТЬNULL(Остатки.Количество, 0) КАК Дефицит
	|ИЗ
	|	ВТЛимиты КАК Лимиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК Остатки
	|		ПО Лимиты.Номенклатура = Остатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗаказано КАК Заказано
	|		ПО Лимиты.Номенклатура = Заказано.Номенклатура
	|ГДЕ
	|	ЕСТЬNULL(Остатки.Количество, 0) < Лимиты.Лимит
	|УПОРЯДОЧИТЬ ПО
	|	Дефицит УБЫВ
	|;
	|ВЫБРАТЬ
	|	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка,
	|	СУММА(ПродажиОбороты.ВаловаяПрибыльОборот) КАК ВаловаяПрибыль
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ПродажиОбороты
	|;
	|ВЫБРАТЬ
	|	СУММА(Остатки.Сумма) КАК СтоимостьСклада
	|ИЗ
	|	ВТОстатки КАК Остатки
	|;
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лимиты.Номенклатура) КАК ЧислоПозиций
	|ИЗ
	|	ВТЛимиты КАК Лимиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК Остатки
	|		ПО Лимиты.Номенклатура = Остатки.Номенклатура
	|ГДЕ
	|	ЕСТЬNULL(Остатки.Количество, 0) < Лимиты.Лимит
	|;
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лимиты.Номенклатура) КАК ЧислоПозиций
	|ИЗ
	|	ВТЛимиты КАК Лимиты
	|;
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лимиты.Номенклатура) КАК ЧислоПозиций
	|ИЗ
	|	ВТЛимиты КАК Лимиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК Остатки
	|		ПО Лимиты.Номенклатура = Остатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗаказано КАК Заказано
	|		ПО Лимиты.Номенклатура = Заказано.Номенклатура
	|ГДЕ
	|	ЕСТЬNULL(Остатки.Количество, 0) < Лимиты.Лимит
	|	И ЕСТЬNULL(Остатки.Количество, 0) + ЕСТЬNULL(Заказано.Количество, 0) >= Лимиты.Лимит";
	// BSLLS:VirtualTableCallWithoutParameters-on

	Пакет = Запрос.ВыполнитьПакет();

	Данные = Новый Структура;
	Данные.Вставить("ВыручкаПоКлиентам", Пакет[2].Выгрузить());
	Данные.Вставить("ОстаткиПоГруппам", Пакет[3].Выгрузить());
	Данные.Вставить("Потребности", Пакет[5].Выгрузить());

	ВыборкаПродаж = Пакет[6].Выбрать();
	ВыборкаПродаж.Следующий();
	Данные.Вставить("Выручка30", ЧислоИлиНоль(ВыборкаПродаж.Выручка));
	Данные.Вставить("Прибыль30", ЧислоИлиНоль(ВыборкаПродаж.ВаловаяПрибыль));

	ВыборкаСклада = Пакет[7].Выбрать();
	ВыборкаСклада.Следующий();
	Данные.Вставить("СтоимостьСклада", ЧислоИлиНоль(ВыборкаСклада.СтоимостьСклада));

	ВыборкаЛимитов = Пакет[8].Выбрать();
	ВыборкаЛимитов.Следующий();
	Данные.Вставить("НижеЛимита", ЧислоИлиНоль(ВыборкаЛимитов.ЧислоПозиций));

	ВыборкаВсехЛимитов = Пакет[9].Выбрать();
	ВыборкаВсехЛимитов.Следующий();
	Данные.Вставить("ВсегоСЛимитом", ЧислоИлиНоль(ВыборкаВсехЛимитов.ЧислоПозиций));

	ВыборкаПерекрытых = Пакет[10].Выбрать();
	ВыборкаПерекрытых.Следующий();
	Данные.Вставить("ПерекрытоЗаказами", ЧислоИлиНоль(ВыборкаПерекрытых.ЧислоПозиций));

	Возврат Данные;

КонецФункции

Функция ПредставлениеЗдоровьяСклада(ВсегоСЛимитом, НижеЛимита)

	Если ВсегоСЛимитом = 0 Тогда
		Возврат "✅";
	КонецЕсли;
	СтоПроцентов = 100;
	Процент = Окр((ВсегоСЛимитом - НижеЛимита) / ВсегоСЛимитом * СтоПроцентов);
	Возврат ШкалаПроцента(Процент) + " " + ФорматЧисла(Процент) + "%" + ?(Процент >= СтоПроцентов, " 💪", "");

КонецФункции

Функция ПредставлениеПерекрытияДефицита(НижеЛимита, ПерекрытоЗаказами)

	Если НижеЛимита = 0 Тогда
		Возврат "✅ 0";
	КонецЕсли;
	Шаблон = НСтр("ru = '🛒 %1 из %2'; fr = '🛒 %1 sur %2'; en = '🛒 %1 of %2'; es = '🛒 %1 de %2'");
	Возврат СтрШаблон(Шаблон, ФорматЧисла(ПерекрытоЗаказами), ФорматЧисла(НижеЛимита));

КонецФункции

Функция ПредставлениеОборачиваемости(Выручка30, Прибыль30, СтоимостьСклада)

	Если СтоимостьСклада = 0 Тогда
		Возврат "-";
	КонецЕсли;
	Себестоимость30 = Выручка30 - Прибыль30;
	Коэффициент = Окр(Себестоимость30 / СтоимостьСклада, 1);
	Возврат "🔄 " + Формат(Коэффициент, "ЧН=0") + "x";

КонецФункции

Процедура ЗаполнитьДиаграммуВыручкиПоКлиентам(Форма, Таблица)

	Диаграмма = Форма["ДиаграммаВыручка"];
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.ГистограммаГоризонтальная;
	Серия = Диаграмма.Серии.Добавить(НСтр("ru = 'Выручка'; fr = 'CA'; en = 'Revenue'; es = 'Ingresos'"));
	Для Каждого Стр Из Таблица Цикл
		Точка = Диаграмма.Точки.Добавить(Строка(Стр.Контрагент));
		Диаграмма.УстановитьЗначение(Точка, Серия, Стр.Выручка);
	КонецЦикла;
	Диаграмма.Обновление = Истина;

КонецПроцедуры

Процедура ЗаполнитьДиаграммуОстатков(Форма, Таблица)

	ПустаяГруппа = НСтр("ru = 'Без группы'; fr = 'Sans groupe'; en = 'No group'; es = 'Sin grupo'");

	Диаграмма = Форма["ДиаграммаОстатки"];
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.Круговая;
	Серия = Диаграмма.Серии.Добавить(НСтр("ru = 'Остатки'; fr = 'Stock'; en = 'Stock'; es = 'Stock'"));
	Для Каждого Стр Из Таблица Цикл
		ИмяГруппы = Строка(Стр.ТоварнаяГруппа);
		Если Не ЗначениеЗаполнено(Стр.ТоварнаяГруппа) Тогда
			ИмяГруппы = ПустаяГруппа;
		КонецЕсли;
		Точка = Диаграмма.Точки.Добавить(ИмяГруппы);
		Диаграмма.УстановитьЗначение(Точка, Серия, Стр.Сумма);
	КонецЦикла;
	Диаграмма.Обновление = Истина;

КонецПроцедуры

Процедура ЗаполнитьДиаграммуПотребностей(Форма, Таблица)

	Диаграмма = Форма["ДиаграммаПотребности"];
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.Гистограмма;
	СерияОстаток = Диаграмма.Серии.Добавить(НСтр("ru = 'Остаток'; fr = 'Stock'; en = 'On hand'; es = 'Existencias'"));
	СерияЛимит = Диаграмма.Серии.Добавить(НСтр("ru = 'Лимит'; fr = 'Limite'; en = 'Limit'; es = 'Límite'"));
	СерияЗаказано = Диаграмма.Серии.Добавить(НСтр("ru = 'Заказано'; fr = 'Commandé'; en = 'Ordered'; es = 'Pedido'"));
	Для Каждого Стр Из Таблица Цикл
		Точка = Диаграмма.Точки.Добавить(Строка(Стр.Номенклатура));
		Диаграмма.УстановитьЗначение(Точка, СерияОстаток, Стр.Остаток);
		Диаграмма.УстановитьЗначение(Точка, СерияЛимит, Стр.Лимит);
		Диаграмма.УстановитьЗначение(Точка, СерияЗаказано, Стр.Заказано);
	КонецЦикла;
	Диаграмма.Обновление = Истина;

КонецПроцедуры

#КонецОбласти

#Область Продажи

Функция ДанныеПродаж()

	ТекущаяДата = ТекущаяДатаСеанса();
	НачалоСегодня = НачалоДня(ТекущаяДата);
	КонецПериода = КонецДня(ТекущаяДата);
	НачалоПериодаДиаграмм = НачалоДня(ТекущаяДата - (ДнейВПериоде() - 1) * СекундВСутках());
	НачалоТекущегоМесяца = НачалоМесяца(ТекущаяДата);
	НачалоПрошлогоМесяца = НачалоМесяца(ДобавитьМесяц(ТекущаяДата, -1));
	НачалоПериодаДанных = Мин(НачалоПериодаДиаграмм, НачалоПрошлогоМесяца);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоСегодня", НачалоСегодня);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериодаДиаграмм", НачалоПериодаДиаграмм);
	Запрос.УстановитьПараметр("НачалоПериодаДанных", НачалоПериодаДанных);
	Запрос.УстановитьПараметр("НачалоТекущегоМесяца", НачалоТекущегоМесяца);
	// Дашборду нужен долг по всем покупателям, отбор в виртуальной таблице остатков не сузить.
	// BSLLS:VirtualTableCallWithoutParameters-off
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПродажиОбороты.Период КАК День,
	|	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериодаДанных, &КонецПериода, День, ) КАК ПродажиОбороты
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Период
	|УПОРЯДОЧИТЬ ПО
	|	День
	|;
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПродажиОбороты.ДокументПродажи) КАК Продаж,
	|	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериодаДиаграмм, &КонецПериода, , ) КАК ПродажиОбороты
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 5
	|	ПродажиОбороты.Номенклатура КАК Номенклатура,
	|	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериодаДиаграмм, &КонецПериода, , ) КАК ПродажиОбороты
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Номенклатура
	|ИМЕЮЩИЕ
	|	СУММА(ПродажиОбороты.ВыручкаОборот) > 0
	|УПОРЯДОЧИТЬ ПО
	|	Выручка УБЫВ
	|;
	|ВЫБРАТЬ
	|	ПродажиОбороты.Сотрудник КАК Сотрудник,
	|	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериодаДиаграмм, &КонецПериода, , ) КАК ПродажиОбороты
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Сотрудник
	|ИМЕЮЩИЕ
	|	СУММА(ПродажиОбороты.ВыручкаОборот) > 0
	|УПОРЯДОЧИТЬ ПО
	|	Выручка УБЫВ
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПродажиОбороты.Контрагент КАК Контрагент,
	|	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоТекущегоМесяца, &КонецПериода, , ) КАК ПродажиОбороты
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Контрагент
	|ИМЕЮЩИЕ
	|	СУММА(ПродажиОбороты.ВыручкаОборот) > 0
	|УПОРЯДОЧИТЬ ПО
	|	Выручка УБЫВ
	|;
	|ВЫБРАТЬ
	|	СУММА(ВзаиморасчётыОстатки.СуммаОстаток) КАК Долг
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки() КАК ВзаиморасчётыОстатки";
	// BSLLS:VirtualTableCallWithoutParameters-on

	Пакет = Запрос.ВыполнитьПакет();

	Данные = Новый Структура;
	Данные.Вставить("НачалоПериодаДиаграмм", НачалоПериодаДиаграмм);
	Данные.Вставить("ВыручкаПоДням", Пакет[0].Выгрузить());
	Данные.Вставить("ТопТоваров", Пакет[2].Выгрузить());
	Данные.Вставить("ВыручкаПоСотрудникам", Пакет[3].Выгрузить());

	ВыборкаПродаж = Пакет[1].Выбрать();
	ВыборкаПродаж.Следующий();
	ПродажЗаМесяц = ЧислоИлиНоль(ВыборкаПродаж.Продаж);
	ВыручкаЗаМесяц = ЧислоИлиНоль(ВыборкаПродаж.Выручка);
	Данные.Вставить("ПродажЗаМесяц", ПродажЗаМесяц);
	Данные.Вставить("СреднийЧек", ?(ПродажЗаМесяц = 0, 0, ВыручкаЗаМесяц / ПродажЗаМесяц));

	КлиентМесяца = Неопределено;
	ВыборкаКлиента = Пакет[4].Выбрать();
	Если ВыборкаКлиента.Следующий() Тогда
		КлиентМесяца = ВыборкаКлиента.Контрагент;
	КонецЕсли;
	Данные.Вставить("КлиентМесяца", КлиентМесяца);

	ВыборкаДолга = Пакет[5].Выбрать();
	ВыборкаДолга.Следующий();
	Данные.Вставить("ДолгПокупателей", ЧислоИлиНоль(ВыборкаДолга.Долг));

	Динамика = ПоказателиДинамики(Данные.ВыручкаПоДням, "Выручка",
		НачалоСегодня, НачалоПериодаДиаграмм, НачалоПрошлогоМесяца);
	Данные.Вставить("ВыручкаСегодня", ЗначениеДня(Данные.ВыручкаПоДням, "Выручка", НачалоСегодня));
	Данные.Вставить("СерияДней", Динамика.Серия);
	Данные.Вставить("РекордДня", Динамика.Рекорд);
	Данные.Вставить("ДеньРекорда", Динамика.ДеньРекорда);
	Данные.Вставить("ВыручкаТекущегоМесяца", Динамика.ТекущийМесяц);
	Данные.Вставить("ВыручкаПрошлогоМесяца", Динамика.ПрошлыйМесяц);

	Возврат Данные;

КонецФункции

Функция ПредставлениеКлиентаМесяца(КлиентМесяца)

	Если КлиентМесяца = Неопределено Или Не ЗначениеЗаполнено(КлиентМесяца) Тогда
		Возврат "-";
	КонецЕсли;
	Возврат "👑 " + Строка(КлиентМесяца);

КонецФункции

Процедура ЗаполнитьДиаграммуВыручкиПоДням(Форма, ВыручкаПоДням, НачалоПериодаДиаграмм)

	Диаграмма = Форма["ДиаграммаВыручкаПоДням"];
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.Гистограмма;
	Серия = Диаграмма.Серии.Добавить(НСтр("ru = 'Выручка'; fr = 'CA'; en = 'Revenue'; es = 'Ingresos'"));
	Для Каждого СтрокаДня Из ВыручкаПоДням Цикл
		Если СтрокаДня.День < НачалоПериодаДиаграмм Тогда
			Продолжить;
		КонецЕсли;
		Точка = Диаграмма.Точки.Добавить(Формат(СтрокаДня.День, "ДФ=dd.MM"));
		Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаДня.Выручка);
	КонецЦикла;
	Диаграмма.Обновление = Истина;

КонецПроцедуры

Процедура ЗаполнитьДиаграммуПоСотрудникам(Форма, ВыручкаПоСотрудникам)

	Диаграмма = Форма["ДиаграммаПоСотрудникам"];
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.Круговая;
	Серия = Диаграмма.Серии.Добавить(НСтр("ru = 'Выручка'; fr = 'CA'; en = 'Revenue'; es = 'Ingresos'"));
	БезСотрудника = НСтр("ru = 'Не указан'; fr = 'Non renseigné'; en = 'Not set'; es = 'No indicado'");
	Для Каждого СтрокаСотрудника Из ВыручкаПоСотрудникам Цикл
		ИмяСотрудника = Строка(СтрокаСотрудника.Сотрудник);
		Если Не ЗначениеЗаполнено(СтрокаСотрудника.Сотрудник) Тогда
			ИмяСотрудника = БезСотрудника;
		КонецЕсли;
		Точка = Диаграмма.Точки.Добавить(ИмяСотрудника);
		Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаСотрудника.Выручка);
	КонецЦикла;
	Диаграмма.Обновление = Истина;

КонецПроцедуры

Процедура ЗаполнитьДиаграммуТопТоваров(Форма, ТопТоваров)

	Диаграмма = Форма["ДиаграммаТопТоваров"];
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.ГистограммаГоризонтальная;
	Серия = Диаграмма.Серии.Добавить(НСтр("ru = 'Выручка'; fr = 'CA'; en = 'Revenue'; es = 'Ingresos'"));
	Для Каждого СтрокаТопа Из ТопТоваров Цикл
		Точка = Диаграмма.Точки.Добавить(Строка(СтрокаТопа.Номенклатура));
		Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаТопа.Выручка);
	КонецЦикла;
	Диаграмма.Обновление = Истина;

КонецПроцедуры

#КонецОбласти

#Область Производство

Функция ДанныеПроизводства()

	ТекущаяДата = ТекущаяДатаСеанса();
	НачалоСегодня = НачалоДня(ТекущаяДата);
	КонецПериода = КонецДня(ТекущаяДата);
	НачалоПериодаДиаграмм = НачалоДня(ТекущаяДата - (ДнейВПериоде() - 1) * СекундВСутках());
	НачалоПрошлогоМесяца = НачалоМесяца(ДобавитьМесяц(ТекущаяДата, -1));
	НачалоПериодаДанных = Мин(НачалоПериодаДиаграмм, НачалоПрошлогоМесяца);

	СтатусыЗавершенные = Новый Массив;
	СтатусыЗавершенные.Добавить(Перечисления.СтатусыЗаказовПокупателя.Отгружен);
	СтатусыЗавершенные.Добавить(Перечисления.СтатусыЗаказовПокупателя.Доставлен);

	СтатусыПроизводства = Новый Массив;
	СтатусыПроизводства.Добавить(Перечисления.СтатусыЗаказовПокупателя.ВПроизводстве);
	СтатусыПроизводства.Добавить(Перечисления.СтатусыЗаказовПокупателя.ПереданСубподрядчику);
	СтатусыПроизводства.Добавить(Перечисления.СтатусыЗаказовПокупателя.ПолученОтСубподрядчика);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоСегодня", НачалоСегодня);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериодаДиаграмм", НачалоПериодаДиаграмм);
	Запрос.УстановитьПараметр("НачалоПериодаДанных", НачалоПериодаДанных);
	Запрос.УстановитьПараметр("СтатусыЗавершенные", СтатусыЗавершенные);
	// Дашборду нужны все актуальные статусы и весь остаток переработки,
	// отбор в виртуальных таблицах не сузить.
	// BSLLS:VirtualTableCallWithoutParameters-off
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СрезСтатусов.ЗаказПокупателя КАК Заказ,
	|	СрезСтатусов.СтатусЗаказаПокупателя КАК Статус
	|ПОМЕСТИТЬ ВТСтатусы
	|ИЗ
	|	РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних КАК СрезСтатусов
	|ГДЕ
	|	НЕ СрезСтатусов.СтатусЗаказаПокупателя В (&СтатусыЗавершенные)
	|;
	|ВЫБРАТЬ
	|	Статусы.Статус КАК Статус,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Статусы.Заказ) КАК Заказов
	|ИЗ
	|	ВТСтатусы КАК Статусы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ПО Статусы.Заказ = ЗаказПокупателя.Ссылка
	|ГДЕ
	|	НЕ ЗаказПокупателя.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	Статусы.Статус
	|;
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Статусы.Заказ) КАК Заказов
	|ИЗ
	|	ВТСтатусы КАК Статусы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ПО Статусы.Заказ = ЗаказПокупателя.Ссылка
	|ГДЕ
	|	НЕ ЗаказПокупателя.ПометкаУдаления
	|	И ЗаказПокупателя.ДатаОтгрузки <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ЗаказПокупателя.ДатаОтгрузки < &НачалоСегодня
	|;
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ВыпускПродукции.Дата, ДЕНЬ) КАК День,
	|	СУММА(ГотоваяПродукция.Количество) КАК Количество
	|ИЗ
	|	Документ.ВыпускПродукции КАК ВыпускПродукции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ГотоваяПродукция
	|		ПО ГотоваяПродукция.Ссылка = ВыпускПродукции.Ссылка
	|ГДЕ
	|	ВыпускПродукции.Проведен
	|	И ВыпускПродукции.Дата МЕЖДУ &НачалоПериодаДанных И &КонецПериода
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ВыпускПродукции.Дата, ДЕНЬ)
	|УПОРЯДОЧИТЬ ПО
	|	День
	|;
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ВыпускПродукции.Ссылка) КАК Выпусков
	|ИЗ
	|	Документ.ВыпускПродукции КАК ВыпускПродукции
	|ГДЕ
	|	ВыпускПродукции.Проведен
	|	И ВыпускПродукции.Дата МЕЖДУ &НачалоСегодня И &КонецПериода
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 5
	|	ГотоваяПродукция.Номенклатура КАК Номенклатура,
	|	СУММА(ГотоваяПродукция.Количество) КАК Количество
	|ИЗ
	|	Документ.ВыпускПродукции КАК ВыпускПродукции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ГотоваяПродукция
	|		ПО ГотоваяПродукция.Ссылка = ВыпускПродукции.Ссылка
	|ГДЕ
	|	ВыпускПродукции.Проведен
	|	И ВыпускПродукции.Дата МЕЖДУ &НачалоПериодаДиаграмм И &КонецПериода
	|СГРУППИРОВАТЬ ПО
	|	ГотоваяПродукция.Номенклатура
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ
	|;
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТоварыВПереработкеОстатки.Номенклатура) КАК Позиций
	|ИЗ
	|	РегистрНакопления.ТоварыВПереработке.Остатки() КАК ТоварыВПереработкеОстатки";
	// BSLLS:VirtualTableCallWithoutParameters-on

	Пакет = Запрос.ВыполнитьПакет();

	Данные = Новый Структура;
	Данные.Вставить("НачалоПериодаДиаграмм", НачалоПериодаДиаграмм);
	Данные.Вставить("ЗаказыПоСтатусам", Пакет[1].Выгрузить());
	Данные.Вставить("ВыпускПоДням", Пакет[3].Выгрузить());
	Данные.Вставить("ТопПродукции", Пакет[5].Выгрузить());

	ВыборкаПросрочки = Пакет[2].Выбрать();
	ВыборкаПросрочки.Следующий();
	Данные.Вставить("ПросроченоОтгрузок", ЧислоИлиНоль(ВыборкаПросрочки.Заказов));

	ВыборкаСегодня = Пакет[4].Выбрать();
	ВыборкаСегодня.Следующий();
	Данные.Вставить("ВыпусковСегодня", ЧислоИлиНоль(ВыборкаСегодня.Выпусков));

	ВыборкаПереработки = Пакет[6].Выбрать();
	ВыборкаПереработки.Следующий();
	Данные.Вставить("ПозицийВПереработке", ЧислоИлиНоль(ВыборкаПереработки.Позиций));

	ЗаказовВПроизводстве = 0;
	Для Каждого СтрокаСтатуса Из Данные.ЗаказыПоСтатусам Цикл
		Если СтатусыПроизводства.Найти(СтрокаСтатуса.Статус) <> Неопределено Тогда
			ЗаказовВПроизводстве = ЗаказовВПроизводстве + СтрокаСтатуса.Заказов;
		КонецЕсли;
	КонецЦикла;
	Данные.Вставить("ЗаказовВПроизводстве", ЗаказовВПроизводстве);

	Динамика = ПоказателиДинамики(Данные.ВыпускПоДням, "Количество",
		НачалоСегодня, НачалоПериодаДиаграмм, НачалоПрошлогоМесяца);
	Данные.Вставить("ВыпущеноЗаМесяц", Динамика.СуммаЗаПериод);
	Данные.Вставить("СерияДней", Динамика.Серия);
	Данные.Вставить("РекордДня", Динамика.Рекорд);
	Данные.Вставить("ДеньРекорда", Динамика.ДеньРекорда);
	Данные.Вставить("ВыпускТекущегоМесяца", Динамика.ТекущийМесяц);
	Данные.Вставить("ВыпускПрошлогоМесяца", Динамика.ПрошлыйМесяц);

	Возврат Данные;

КонецФункции

Функция ПредставлениеПросрочки(ПросроченоОтгрузок)

	Возврат ?(ПросроченоОтгрузок = 0, "✅ 0", "⚠ " + ФорматЧисла(ПросроченоОтгрузок));

КонецФункции

Процедура ЗаполнитьДиаграммуВыпуска(Форма, ВыпускПоДням, НачалоПериодаДиаграмм)

	Диаграмма = Форма["ДиаграммаВыпускПоДням"];
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.Гистограмма;
	Серия = Диаграмма.Серии.Добавить(НСтр("ru = 'Выпуск'; fr = 'Production'; en = 'Output'; es = 'Producción'"));
	Для Каждого СтрокаДня Из ВыпускПоДням Цикл
		Если СтрокаДня.День < НачалоПериодаДиаграмм Тогда
			Продолжить;
		КонецЕсли;
		Точка = Диаграмма.Точки.Добавить(Формат(СтрокаДня.День, "ДФ=dd.MM"));
		Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаДня.Количество);
	КонецЦикла;
	Диаграмма.Обновление = Истина;

КонецПроцедуры

Процедура ЗаполнитьДиаграммуСтатусов(Форма, ЗаказыПоСтатусам)

	Диаграмма = Форма["ДиаграммаСтатусыЗаказов"];
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.Круговая;
	Серия = Диаграмма.Серии.Добавить(НСтр("ru = 'Заказы'; fr = 'Commandes'; en = 'Orders'; es = 'Pedidos'"));
	ПустойСтатус = НСтр("ru = 'Без статуса'; fr = 'Sans statut'; en = 'No status'; es = 'Sin estado'");
	Для Каждого СтрокаСтатуса Из ЗаказыПоСтатусам Цикл
		ИмяСтатуса = Строка(СтрокаСтатуса.Статус);
		Если Не ЗначениеЗаполнено(СтрокаСтатуса.Статус) Тогда
			ИмяСтатуса = ПустойСтатус;
		КонецЕсли;
		Точка = Диаграмма.Точки.Добавить(ИмяСтатуса);
		Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаСтатуса.Заказов);
	КонецЦикла;
	Диаграмма.Обновление = Истина;

КонецПроцедуры

Процедура ЗаполнитьДиаграммуТопПродукции(Форма, ТопПродукции)

	Диаграмма = Форма["ДиаграммаТопПродукции"];
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.ГистограммаГоризонтальная;
	Серия = Диаграмма.Серии.Добавить(НСтр("ru = 'Выпущено'; fr = 'Produit'; en = 'Produced'; es = 'Producido'"));
	Для Каждого СтрокаТопа Из ТопПродукции Цикл
		Точка = Диаграмма.Точки.Добавить(Строка(СтрокаТопа.Номенклатура));
		Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаТопа.Количество);
