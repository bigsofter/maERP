
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДобавитьКомандуОбновить();
	Обработки.Дашборд.ПостроитьДашбордПродаж(ЭтотОбъект);
	Обработки.Дашборд.ОбновитьДашбордПродаж(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Ссылка «Пересчитать» карточки «Себестоимость» (Обработки.Дашборд.ДобавитьКарточкуАктуальностиСебестоимости).
//
// Параметры:
//  Элемент - ДекорацияФормы - ссылка
//
&НаКлиенте
Процедура Подключаемый_ПересчитатьСебестоимость(Элемент)

	ОткрытьФорму("Обработка.ПерепроведениеДокументов.Форма");

КонецПроцедуры

// Ссылка «Открыть отчёт» карточки «Продажи в минус» (Обработки.Дашборд.ДобавитьКарточкуПродажВМинус): вариант
// «Продажи в минус» отчёта за период карточки.
//
// Параметры:
//  Элемент - ДекорацияФормы - ссылка
//
&НаКлиенте
Процедура Подключаемый_ОткрытьПродажиВМинус(Элемент)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючВарианта", "ПродажиВМинус");
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", РаботаСДокументамиВызовСервера.НастройкиОтчетаПродажВМинус());
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ОткрытьФорму("Отчет.ВедомостьПоПродажам.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьКомандуОбновить()

	ИмяКоманды = "Обновить";
	КомандаОбновить = Команды.Добавить(ИмяКоманды);
	КомандаОбновить.Заголовок = НСтр("ru = 'Обновить'; fr = 'Actualiser'; en = 'Refresh'; es = 'Actualizar'");
	КомандаОбновить.Действие = ИмяКоманды;
	КомандаОбновить.Картинка = БиблиотекаКартинок.КруговыеСтрелки;

	КнопкаОбновить = Элементы.Добавить("КнопкаОбновить", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
	КнопкаОбновить.ИмяКоманды = ИмяКоманды;

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Обработки.Дашборд.ОбновитьДашбордПродаж(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти
