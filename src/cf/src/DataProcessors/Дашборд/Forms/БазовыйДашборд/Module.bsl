
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьЭлементыДашборда();
	ОбновитьДанныеДашборда();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьДанныеДашборда();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьЭлементыДашборда()

	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаВыручка", Новый ОписаниеТипов("Диаграмма")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаОстатки", Новый ОписаниеТипов("Диаграмма")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаПотребности", Новый ОписаниеТипов("Диаграмма")));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	КомандаОбновить = Команды.Добавить("Обновить");
	КомандаОбновить.Заголовок = НСтр("ru = 'Обновить'; fr = 'Actualiser'; en = 'Refresh'; es = 'Actualizar'");
	КомандаОбновить.Действие = "Обновить";
	КомандаОбновить.Картинка = БиблиотекаКартинок.КруговыеСтрелки;

	КнопкаОбновить = Элементы.Добавить("КнопкаОбновить", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
	КнопкаОбновить.ИмяКоманды = "Обновить";

	ГруппаПоказателей = ДобавитьГруппу("ГруппаПоказатели", Ложь);
	ДобавитьКарточкуПоказателя(ГруппаПоказателей, "Выручка30",
		НСтр("ru = 'Выручка за 30 дней'; fr = 'CA sur 30 jours'; en = 'Revenue, 30 days'; es = 'Ingresos, 30 días'"));
	ДобавитьКарточкуПоказателя(ГруппаПоказателей, "Прибыль30",
		НСтр("ru = 'Валовая прибыль за 30 дней'; fr = 'Marge brute sur 30 jours';
			|en = 'Gross profit, 30 days'; es = 'Beneficio bruto, 30 días'"));
	ДобавитьКарточкуПоказателя(ГруппаПоказателей, "СтоимостьСклада",
		НСтр("ru = 'Стоимость остатков'; fr = 'Valeur du stock'; en = 'Stock value'; es = 'Valor del stock'"));
	ДобавитьКарточкуПоказателя(ГруппаПоказателей, "НижеЛимита",
		НСтр("ru = 'Позиций ниже лимита'; fr = 'Articles sous la limite'; en = 'Items below limit'; es = 'Artículos bajo el límite'"));

	ГруппаВерхнихДиаграмм = ДобавитьГруппу("ГруппаВерхниеДиаграммы", Истина);
	ДобавитьПолеДиаграммы(ГруппаВерхнихДиаграмм, "ДиаграммаВыручка",
		НСтр("ru = 'Выручка по клиентам за 30 дней'; fr = 'CA par client sur 30 jours';
			|en = 'Revenue by customer, 30 days'; es = 'Ingresos por cliente, 30 días'"));
	ДобавитьПолеДиаграммы(ГруппаВерхнихДиаграмм, "ДиаграммаОстатки",
		НСтр("ru = 'Остатки по товарным группам'; fr = 'Stock par groupe de produits';
			|en = 'Stock by product group'; es = 'Stock por grupo de productos'"));

	ГруппаНижнихДиаграмм = ДобавитьГруппу("ГруппаНижниеДиаграммы", Истина);
	ДобавитьПолеДиаграммы(ГруппаНижнихДиаграмм, "ДиаграммаПотребности",
		НСтр("ru = 'Потребности и лимиты: дефицитные позиции'; fr = 'Besoins et limites : articles en déficit';
			|en = 'Needs and limits: items in deficit'; es = 'Necesidades y límites: artículos en déficit'"));

КонецПроцедуры

&НаСервере
Функция ДобавитьГруппу(Имя, РастягиватьПоВертикали)

	Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	Группа.ОтображатьЗаголовок = Ложь;
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	Группа.РастягиватьПоГоризонтали = Истина;
	Группа.РастягиватьПоВертикали = РастягиватьПоВертикали;
	Возврат Группа;

КонецФункции

&НаСервере
Процедура ДобавитьКарточкуПоказателя(Родитель, Имя, Подпись)

	Карточка = Элементы.Добавить("Карточка" + Имя, Тип("ГруппаФормы"), Родитель);
	Карточка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Карточка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Карточка.ОтображатьЗаголовок = Ложь;
	Карточка.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
	Карточка.РастягиватьПоГоризонтали = Истина;

	ЭлементПодписи = Элементы.Добавить("Подпись" + Имя, Тип("ДекорацияФормы"), Карточка);
	ЭлементПодписи.Заголовок = Подпись;
	ЭлементПодписи.ЦветТекста = ЦветаСтиля.Цвет_ПоясняющийТекст;

	ЭлементЗначения = Элементы.Добавить("Значение" + Имя, Тип("ДекорацияФормы"), Карточка);
	ЭлементЗначения.Заголовок = "0";
	ЭлементЗначения.Шрифт = ШрифтыСтиля.Шрифт_Основной_Увеличенный;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПолеДиаграммы(Родитель, ИмяРеквизита, Заголовок)

	Поле = Элементы.Добавить("Поле" + ИмяРеквизита, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеДиаграммы;
	Поле.ПутьКДанным = ИмяРеквизита;
	Поле.Заголовок = Заголовок;
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	Поле.РастягиватьПоГоризонтали = Истина;
	Поле.РастягиватьПоВертикали = Истина;
	Поле.Высота = 12;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеДашборда()

	// Дашборд агрегирует данные регистров только на чтение; права ролей на сами регистры не требуются.
	УстановитьПривилегированныйРежим(Истина);

	Данные = ДанныеДашборда();

	Элементы.ЗначениеВыручка30.Заголовок = ФорматПоказателя(Данные.Выручка30);
	Элементы.ЗначениеПрибыль30.Заголовок = ФорматПоказателя(Данные.Прибыль30);
	Элементы.ЗначениеСтоимостьСклада.Заголовок = ФорматПоказателя(Данные.СтоимостьСклада);
	Элементы.ЗначениеНижеЛимита.Заголовок = ФорматПоказателя(Данные.НижеЛимита);

	ЗаполнитьДиаграммуВыручки(Данные.ВыручкаПоКлиентам);
	ЗаполнитьДиаграммуОстатков(Данные.ОстаткиПоГруппам);
	ЗаполнитьДиаграммуПотребностей(Данные.Потребности);

КонецПроцедуры

&НаСервере
Функция ФорматПоказателя(Значение)

	Число = Значение;
	Если Число = NULL Или Число = Неопределено Тогда
		Число = 0;
	КонецЕсли;
	Возврат Формат(Число, "ЧДЦ=0; ЧРГ=' '; ЧН=0");

КонецФункции

&НаСервере
Функция ДанныеДашборда()

	ДнейВПериодеПродаж = 30;
	СекундВСутках = 86400;
	КонецПериода = КонецДня(ТекущаяДатаСеанса());
	НачалоПериода = НачалоДня(КонецПериода - (ДнейВПериодеПродаж - 1) * СекундВСутках);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	// Дашборду нужны остатки по всему складу и все открытые заказы, отбор в виртуальных таблицах не сузить.
	// BSLLS:VirtualTableCallWithoutParameters-off
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ТоварыВНаличииОстатки.КоличествоОстаток) КАК Количество,
	|	СУММА(ТоварыВНаличииОстатки.СуммаОстаток) КАК Сумма
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки() КАК ТоварыВНаличииОстатки
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВНаличииОстатки.Номенклатура
	|;
	|ВЫБРАТЬ
	|	Лимиты.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(Лимиты.Лимит) КАК Лимит
	|ПОМЕСТИТЬ ВТЛимиты
	|ИЗ
	|	(ВЫБРАТЬ
	|		Номенклатура.Ссылка КАК Номенклатура,
	|		Номенклатура.МинимальноеКоличествоХранения КАК Лимит
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Номенклатура.МинимальноеКоличествоХранения > 0
	|		И НЕ Номенклатура.ПометкаУдаления
	|	ОБЪЕДИНИТЬ ВСЕ
	|	ВЫБРАТЬ
	|		МинимальныйОстаток.Номенклатура,
	|		МинимальныйОстаток.МинимальноеКоличествоХранения
	|	ИЗ
	|		РегистрСведений.МинимальныйОстатокПоСкладам КАК МинимальныйОстаток
	|	ГДЕ
	|		МинимальныйОстаток.МинимальноеКоличествоХранения > 0) КАК Лимиты
	|СГРУППИРОВАТЬ ПО
	|	Лимиты.Номенклатура
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 10
	|	ПродажиОбороты.Контрагент КАК Контрагент,
	|	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ПродажиОбороты
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Контрагент
	|ИМЕЮЩИЕ
	|	СУММА(ПродажиОбороты.ВыручкаОборот) > 0
	|УПОРЯДОЧИТЬ ПО
	|	Выручка УБЫВ
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 8
	|	НоменклатураСправочник.ТоварнаяГруппа КАК ТоварнаяГруппа,
	|	СУММА(Остатки.Сумма) КАК Сумма
	|ИЗ
	|	ВТОстатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСправочник
	|		ПО Остатки.Номенклатура = НоменклатураСправочник.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	НоменклатураСправочник.ТоварнаяГруппа
	|УПОРЯДОЧИТЬ ПО
	|	Сумма УБЫВ
	|;
	|ВЫБРАТЬ
	|	ЗаказыОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ЗаказыОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТЗаказано
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки() КАК ЗаказыОстатки
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыОстатки.Номенклатура
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 10
	|	Лимиты.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(Остатки.Количество, 0) КАК Остаток,
	|	Лимиты.Лимит КАК Лимит,
	|	ЕСТЬNULL(Заказано.Количество, 0) КАК Заказано,
	|	Лимиты.Лимит - ЕСТЬNULL(Остатки.Количество, 0) КАК Дефицит
	|ИЗ
	|	ВТЛимиты КАК Лимиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК Остатки
	|		ПО Лимиты.Номенклатура = Остатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗаказано КАК Заказано
	|		ПО Лимиты.Номенклатура = Заказано.Номенклатура
	|ГДЕ
	|	ЕСТЬNULL(Остатки.Количество, 0) < Лимиты.Лимит
	|УПОРЯДОЧИТЬ ПО
	|	Дефицит УБЫВ
	|;
	|ВЫБРАТЬ
	|	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка,
	|	СУММА(ПродажиОбороты.ВаловаяПрибыльОборот) КАК ВаловаяПрибыль
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ПродажиОбороты
	|;
	|ВЫБРАТЬ
	|	СУММА(Остатки.Сумма) КАК СтоимостьСклада
	|ИЗ
	|	ВТОстатки КАК Остатки
	|;
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лимиты.Номенклатура) КАК ЧислоПозиций
	|ИЗ
	|	ВТЛимиты КАК Лимиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК Остатки
	|		ПО Лимиты.Номенклатура = Остатки.Номенклатура
	|ГДЕ
	|	ЕСТЬNULL(Остатки.Количество, 0) < Лимиты.Лимит";
	// BSLLS:VirtualTableCallWithoutParameters-on

	Пакет = Запрос.ВыполнитьПакет();

	Данные = Новый Структура;
	Данные.Вставить("ВыручкаПоКлиентам", Пакет[2].Выгрузить());
	Данные.Вставить("ОстаткиПоГруппам", Пакет[3].Выгрузить());
	Данные.Вставить("Потребности", Пакет[5].Выгрузить());

	ВыборкаПродаж = Пакет[6].Выбрать();
	ВыборкаПродаж.Следующий();
	Данные.Вставить("Выручка30", ВыборкаПродаж.Выручка);
	Данные.Вставить("Прибыль30", ВыборкаПродаж.ВаловаяПрибыль);

	ВыборкаСклада = Пакет[7].Выбрать();
	ВыборкаСклада.Следующий();
	Данные.Вставить("СтоимостьСклада", ВыборкаСклада.СтоимостьСклада);

	ВыборкаЛимитов = Пакет[8].Выбрать();
	ВыборкаЛимитов.Следующий();
	Данные.Вставить("НижеЛимита", ВыборкаЛимитов.ЧислоПозиций);

	Возврат Данные;

КонецФункции

&НаСервере
Процедура ЗаполнитьДиаграммуВыручки(Таблица)

	Диаграмма = ЭтаФорма.ДиаграммаВыручка;
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.ГистограммаГоризонтальная;
	Серия = Диаграмма.Серии.Добавить(НСтр("ru = 'Выручка'; fr = 'CA'; en = 'Revenue'; es = 'Ingresos'"));
	Для Каждого Стр Из Таблица Цикл
		Точка = Диаграмма.Точки.Добавить(Строка(Стр.Контрагент));
		Диаграмма.УстановитьЗначение(Точка, Серия, Стр.Выручка);
	КонецЦикла;
	Диаграмма.Обновление = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДиаграммуОстатков(Таблица)

	ПустаяГруппа = НСтр("ru = 'Без группы'; fr = 'Sans groupe'; en = 'No group'; es = 'Sin grupo'");

	Диаграмма = ЭтаФорма.ДиаграммаОстатки;
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.Круговая;
	Серия = Диаграмма.Серии.Добавить(НСтр("ru = 'Остатки'; fr = 'Stock'; en = 'Stock'; es = 'Stock'"));
	Для Каждого Стр Из Таблица Цикл
		ИмяГруппы = Строка(Стр.ТоварнаяГруппа);
		Если Не ЗначениеЗаполнено(Стр.ТоварнаяГруппа) Тогда
			ИмяГруппы = ПустаяГруппа;
		КонецЕсли;
		Точка = Диаграмма.Точки.Добавить(ИмяГруппы);
		Диаграмма.УстановитьЗначение(Точка, Серия, Стр.Сумма);
	КонецЦикла;
	Диаграмма.Обновление = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДиаграммуПотребностей(Таблица)

	Диаграмма = ЭтаФорма.ДиаграммаПотребности;
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.Гистограмма;
	СерияОстаток = Диаграмма.Серии.Добавить(НСтр("ru = 'Остаток'; fr = 'Stock'; en = 'On hand'; es = 'Existencias'"));
	СерияЛимит = Диаграмма.Серии.Добавить(НСтр("ru = 'Лимит'; fr = 'Limite'; en = 'Limit'; es = 'Límite'"));
	СерияЗаказано = Диаграмма.Серии.Добавить(НСтр("ru = 'Заказано'; fr = 'Commandé'; en = 'Ordered'; es = 'Pedido'"));
	Для Каждого Стр Из Таблица Цикл
		Точка = Диаграмма.Точки.Добавить(Строка(Стр.Номенклатура));
		Диаграмма.УстановитьЗначение(Точка, СерияОстаток, Стр.Остаток);
		Диаграмма.УстановитьЗначение(Точка, СерияЛимит, Стр.Лимит);
		Диаграмма.УстановитьЗначение(Точка, СерияЗаказано, Стр.Заказано);
	КонецЦикла;
	Диаграмма.Обновление = Истина;

