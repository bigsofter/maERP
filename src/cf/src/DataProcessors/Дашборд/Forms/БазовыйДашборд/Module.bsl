
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьЭлементыДашборда();
	ОбновитьДанныеЗакладок();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьДанныеЗакладок();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьЭлементыДашборда()

	// Видимость закладок определяется составом ролей пользователя: оператор производства
	// видит только производственную закладку, показатели стока и продаж содержат суммы.
	// BSLLS:IsInRoleMethod-off
	Администратор = РольДоступна("Администратор");
	ОператорПроизводства = РольДоступна("ОператорПроизводства");
	// BSLLS:IsInRoleMethod-on
	ПоказыватьКоммерцию = Администратор Или Не ОператорПроизводства;
	ПоказыватьПроизводство = Администратор Или ОператорПроизводства;

	ИмяКоманды = "Обновить";
	КомандаОбновить = Команды.Добавить(ИмяКоманды);
	КомандаОбновить.Заголовок = НСтр("ru = 'Обновить'; fr = 'Actualiser'; en = 'Refresh'; es = 'Actualizar'");
	КомандаОбновить.Действие = ИмяКоманды;
	КомандаОбновить.Картинка = БиблиотекаКартинок.КруговыеСтрелки;

	КнопкаОбновить = Элементы.Добавить("КнопкаОбновить", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
	КнопкаОбновить.ИмяКоманды = ИмяКоманды;

	ГруппаЗакладок = Элементы.Добавить("ГруппаЗакладки", Тип("ГруппаФормы"));
	ГруппаЗакладок.Вид = ВидГруппыФормы.Страницы;
	ГруппаЗакладок.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
	ГруппаЗакладок.РастягиватьПоГоризонтали = Истина;
	ГруппаЗакладок.РастягиватьПоВертикали = Истина;
	Если Не ПоказыватьКоммерцию Тогда
		// Видна одна производственная страница - закладки не нужны.
		ГруппаЗакладок.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;

	Если ПоказыватьКоммерцию Тогда
		СтраницаСтока = ДобавитьСтраницу("СтраницаСток",
			НСтр("ru = 'Сток'; fr = 'Stock'; en = 'Stock'; es = 'Stock'"), ГруппаЗакладок);
		Обработки.Дашборд.ПостроитьСтоковыйДашборд(ЭтотОбъект, СтраницаСтока);
		СтраницаПродаж = ДобавитьСтраницу("СтраницаПродажи",
			НСтр("ru = 'Продажи'; fr = 'Ventes'; en = 'Sales'; es = 'Ventas'"), ГруппаЗакладок);
		Обработки.Дашборд.ПостроитьДашбордПродаж(ЭтотОбъект, СтраницаПродаж);
	КонецЕсли;
	Если ПоказыватьПроизводство Тогда
		СтраницаПроизводства = ДобавитьСтраницу("СтраницаПроизводство",
			НСтр("ru = 'Производство'; fr = 'Production'; en = 'Production'; es = 'Producción'"), ГруппаЗакладок);
		Обработки.Дашборд.ПостроитьПроизводственныйДашборд(ЭтотОбъект, СтраницаПроизводства);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеЗакладок()

	Если Элементы.Найти("СтраницаСток") <> Неопределено Тогда
		Обработки.Дашборд.ОбновитьСтоковыйДашборд(ЭтотОбъект);
	КонецЕсли;
	Если Элементы.Найти("СтраницаПродажи") <> Неопределено Тогда
		Обработки.Дашборд.ОбновитьДашбордПродаж(ЭтотОбъект);
	КонецЕсли;
	Если Элементы.Найти("СтраницаПроизводство") <> Неопределено Тогда
		Обработки.Дашборд.ОбновитьПроизводственныйДашборд(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДобавитьСтраницу(Имя, Заголовок, ГруппаЗакладок)

	Страница = Элементы.Добавить(Имя, Тип("ГруппаФормы"), ГруппаЗакладок);
	Страница.Вид = ВидГруппыФормы.Страница;
	Страница.Заголовок = Заголовок;
	Страница.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Возврат Страница;

КонецФункции

#КонецОбласти
