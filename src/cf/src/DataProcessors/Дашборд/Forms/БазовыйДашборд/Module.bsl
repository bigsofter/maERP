
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьЭлементыДашборда();
	Если Элементы.Найти("СтраницаСток") = Неопределено И Элементы.Найти("СтраницаПродажи") = Неопределено
		И Элементы.Найти("СтраницаПроизводство") = Неопределено Тогда
		// Начальная страница без отмеченных закладок (docs/plans/startup-dashboard-settings.md): формы нет.
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ОбновитьДанныеЗакладок();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Ссылка «Пересчитать» карточки «Себестоимость» (Обработки.Дашборд.ДобавитьКарточкуАктуальностиСебестоимости).
//
// Параметры:
//  Элемент - ДекорацияФормы - ссылка
//
&НаКлиенте
Процедура Подключаемый_ПересчитатьСебестоимость(Элемент)

	ОткрытьФорму("Обработка.ПерепроведениеДокументов.Форма");

КонецПроцедуры

// Ссылка «Открыть отчёт» карточки «Продажи в минус» (Обработки.Дашборд.ДобавитьКарточкуПродажВМинус): вариант
// «Продажи в минус» отчёта за период карточки.
//
// Параметры:
//  Элемент - ДекорацияФормы - ссылка
//
&НаКлиенте
Процедура Подключаемый_ОткрытьПродажиВМинус(Элемент)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючВарианта", "ПродажиВМинус");
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", РаботаСДокументамиВызовСервера.НастройкиОтчетаПродажВМинус());
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ОткрытьФорму("Отчет.ВедомостьПоПродажам.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьДанныеЗакладок();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьЭлементыДашборда()

	// Начальная страница - закладки, отмеченные флажками «При запуске» и разрешённые ролями; команда «Дашборд»
	// раздела «Главное» передаёт ВсеЗакладки - все разрешённые ролями.
	Показ = Обработки.Дашборд.ЗакладкиКПоказу(Параметры.ВсеЗакладки);
	ПоказыватьСток = Показ.Сток;
	ПоказыватьПродажи = Показ.Продажи;
	ПоказыватьПроизводство = Показ.Производство;
	Если Не ПоказыватьСток И Не ПоказыватьПродажи И Не ПоказыватьПроизводство Тогда
		Возврат;
	КонецЕсли;

	ИмяКоманды = "Обновить";
	КомандаОбновить = Команды.Добавить(ИмяКоманды);
	КомандаОбновить.Заголовок = НСтр("ru = 'Обновить'; fr = 'Actualiser'; en = 'Refresh'; es = 'Actualizar'");
	КомандаОбновить.Действие = ИмяКоманды;
	КомандаОбновить.Картинка = БиблиотекаКартинок.КруговыеСтрелки;

	КнопкаОбновить = Элементы.Добавить("КнопкаОбновить", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
	КнопкаОбновить.ИмяКоманды = ИмяКоманды;

	ГруппаЗакладок = Элементы.Добавить("ГруппаЗакладки", Тип("ГруппаФормы"));
	ГруппаЗакладок.Вид = ВидГруппыФормы.Страницы;
	ГруппаЗакладок.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
	ГруппаЗакладок.РастягиватьПоГоризонтали = Истина;
	ГруппаЗакладок.РастягиватьПоВертикали = Истина;
	Если Число(ПоказыватьСток) + Число(ПоказыватьПродажи) + Число(ПоказыватьПроизводство) = 1 Тогда
		// Видна одна страница - закладки не нужны.
		ГруппаЗакладок.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;

	// Порядок страниц - порядок закладок НастройкиПользователей.ЗакладкиДашборда: первая отмеченная открыта при входе.
	Если ПоказыватьСток Тогда
		СтраницаСтока = ДобавитьСтраницу("СтраницаСток",
			НСтр("ru = 'Сток'; fr = 'Stock'; en = 'Stock'; es = 'Stock'"), ГруппаЗакладок);
		Обработки.Дашборд.ПостроитьСтоковыйДашборд(ЭтотОбъект, СтраницаСтока);
	КонецЕсли;
	Если ПоказыватьПродажи Тогда
		СтраницаПродаж = ДобавитьСтраницу("СтраницаПродажи",
			НСтр("ru = 'Продажи'; fr = 'Ventes'; en = 'Sales'; es = 'Ventas'"), ГруппаЗакладок);
		Обработки.Дашборд.ПостроитьДашбордПродаж(ЭтотОбъект, СтраницаПродаж);
	КонецЕсли;
	Если ПоказыватьПроизводство Тогда
		СтраницаПроизводства = ДобавитьСтраницу("СтраницаПроизводство",
			НСтр("ru = 'Производство'; fr = 'Production'; en = 'Production'; es = 'Producción'"), ГруппаЗакладок);
		Обработки.Дашборд.ПостроитьПроизводственныйДашборд(ЭтотОбъект, СтраницаПроизводства);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеЗакладок()

	Если Элементы.Найти("СтраницаСток") <> Неопределено Тогда
		Обработки.Дашборд.ОбновитьСтоковыйДашборд(ЭтотОбъект);
	КонецЕсли;
	Если Элементы.Найти("СтраницаПродажи") <> Неопределено Тогда
		Обработки.Дашборд.ОбновитьДашбордПродаж(ЭтотОбъект);
	КонецЕсли;
	Если Элементы.Найти("СтраницаПроизводство") <> Неопределено Тогда
		Обработки.Дашборд.ОбновитьПроизводственныйДашборд(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДобавитьСтраницу(Имя, Заголовок, ГруппаЗакладок)

	Страница = Элементы.Добавить(Имя, Тип("ГруппаФормы"), ГруппаЗакладок);
	Страница.Вид = ВидГруппыФормы.Страница;
	Страница.Заголовок = Заголовок;
	Страница.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Возврат Страница;

КонецФункции

#КонецОбласти
