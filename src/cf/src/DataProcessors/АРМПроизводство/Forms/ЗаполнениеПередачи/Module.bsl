////////////////////////////////////////////////////////////////////////////////
// Заполнение общей передачи в переработку по потребностям выделенных заказов рабочего места производства (план
// docs/plans/subcontract-multi-order.md, сборка 2): предпросмотр строк по способу, отметки и количества, создание
// документа. Расчёт и запись - в модуле менеджера обработки.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Без заказов (открытие не из рабочего места, смок) форма пустая.
	Если Параметры.Свойство("Заказы") И ТипЗнч(Параметры.Заказы) = Тип("Массив") Тогда
		Заказы.ЗагрузитьЗначения(Параметры.Заказы);
	КонецЕсли;
	Если Параметры.Свойство("Склад") И ТипЗнч(Параметры.Склад) = Тип("СправочникСсылка.МестаХранения") Тогда
		Склад = Параметры.Склад;
	КонецЕсли;
	АРМ = Обработки.АРМПроизводство;
	Для Каждого ЭлементСписка Из АРМ.СпособыЗаполненияПередачи() Цикл
		Элементы.Способ.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	Способ = АРМ.СпособЭтапы();
	РассчитатьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СпособПриИзменении(Элемент)

	РассчитатьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтроки

// Количество, исправленное пользователем, при записи не сверяется с пересчётом - его решение.
//
// Параметры:
//  Элемент - ПолеФормы - колонка «Количество».
//
&НаКлиенте
Процедура СтрокиКоличествоПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Строки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ИзмененоВручную = ТекущиеДанные.Количество <> ТекущиеДанные.Рассчитано;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Рассчитать(Команда)

	РассчитатьНаСервере();

КонецПроцедуры

// «Пустая» - форма закрывается с подрядчиком и складом: рабочее место добавляет строку общего документа; иначе - новая
// общая передача по отмеченным строкам.
//
// Параметры:
//  Команда - КомандаФормы - команда «Заполнить».
//
&НаКлиенте
Процедура Заполнить(Команда)

	Если Не ЗначениеЗаполнено(Поставщик) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Укажите подрядчика.'; fr = 'Indiquez le sous-traitant.';
			|en = 'Specify the subcontractor.'; es = 'Indique el subcontratista.'"), , "Поставщик");
		Возврат;
	КонецЕсли;
	Если Способ = СпособПустая() Тогда
		Итог = Новый Структура("Пустая, Поставщик, Склад");
		Итог.Пустая = Истина;
		Итог.Поставщик = Поставщик;
		Итог.Склад = Склад;
		Закрыть(Итог);
		Возврат;
	КонецЕсли;
	Результат = ЗаполнитьНаСервере();
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
	КонецЕсли;
	Если Результат.Успех Тогда
		Закрыть(Новый Структура("Документ, Текст", Результат.Документ, Результат.Текст));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РассчитатьНаСервере()

	Строки.Очистить();
	Если Способ = СпособПустая() Тогда
		Возврат;
	КонецЕсли;
	Итог = Обработки.АРМПроизводство.СтрокиЗаполненияПередачи(Заказы.ВыгрузитьЗначения(), Способ);
	Для Каждого ДанныеСтроки Из Итог.Строки Цикл
		НоваяСтрока = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
		НоваяСтрока.Пометка = Истина;
		НоваяСтрока.Рассчитано = ДанныеСтроки.Количество;
	КонецЦикла;
	Для Каждого Текст Из Итог.Тексты Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Поставщик) Тогда
		Поставщик = Обработки.АРМПроизводство.ПодрядчикПоУмолчанию(Итог.Строки);
	КонецЕсли;

КонецПроцедуры

// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.ЗаполнитьОбщуюПередачу.
//
&НаСервере
Функция ЗаполнитьНаСервере()

	Отмеченные = Новый Массив;
	Для Каждого СтрокаТаблицы Из Строки.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		ДанныеСтроки = Новый Структура("Заказ, Продукция, Материал, Характеристика, Количество, Рассчитано,
			|ИзмененоВручную");
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаТаблицы);
		Отмеченные.Добавить(ДанныеСтроки);
	КонецЦикла;
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Заказы", Заказы.ВыгрузитьЗначения());
	ПараметрыЗаполнения.Вставить("Способ", Способ);
	ПараметрыЗаполнения.Вставить("Поставщик", Поставщик);
	ПараметрыЗаполнения.Вставить("Склад", Склад);
	ПараметрыЗаполнения.Вставить("Строки", Отмеченные);
	Результат = Обработки.АРМПроизводство.ЗаполнитьОбщуюПередачу(ПараметрыЗаполнения);
	Если Результат.Устарело Тогда
		РассчитатьНаСервере();
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СпособПустая()

	Возврат Обработки.АРМПроизводство.СпособПустая();

КонецФункции

#КонецОбласти
