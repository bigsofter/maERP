// «Поступление из переработки» панели отмеченных строк «Переработки»: форма поступления на основании передачи отмеченных
// строк - одной проведённой передачи; заполнение по передаче - механизмом документа.
//
// Параметры:
//  Команда - КомандаФормы - команда таблицы «Переработки».
//
&НаКлиенте
Процедура СоздатьПоступлениеИзПереработки(Команда)

	ОчиститьСообщения();
	Передачи = Новый Массив;
	Непроведенная = Ложь;
	Для Каждого Идентификатор Из Элементы.Переработки.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Переработки.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы = Неопределено Или Не СтрокаТаблицы.Записана Тогда
			Продолжить;
		КонецЕсли;
		Непроведенная = Непроведенная Или Не СтрокаТаблицы.Проведен;
		Если Передачи.Найти(СтрокаТаблицы.Документ) = Неопределено Тогда
			Передачи.Добавить(СтрокаТаблицы.Документ);
		КонецЕсли;
	КонецЦикла;
	Если Передачи.Количество() <> 1 Или Непроведенная Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отметьте строки одной проведённой передачи в переработку.';
			|fr = 'Cochez les lignes d''un seul transfert de sous-traitance validé.';
			|en = 'Tick lines of one posted subcontracting transfer.';
			|es = 'Marque las líneas de un solo envío a subcontratista contabilizado.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДокумента", ЭтотОбъект);
	ПараметрыФормы = Новый Структура("Основание", Передачи[0]);
	ОткрытьФорму("Документ.ПоступлениеИзПереработки.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

// «+ услуга переработки» (решения владельца S6, 3 и 8): стоимость услуг без НДС на весь документ выделенной строки.
//
// Параметры:
//  Команда - КомандаФормы - команда таблицы «Поступления из переработки».
//
&НаКлиенте
Процедура УслугаПереработки(Команда)

	ОчиститьСообщения();
	СтрокаТаблицы = Элементы.ПоступленияПереработки.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или Не СтрокаТаблицы.Записана Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выберите записанную строку поступления.';
			|fr = 'Sélectionnez une ligne de réception enregistrée.'; en = 'Select a saved receipt line.';
			|es = 'Seleccione una línea de recepción guardada.'"));
		Возврат;
	КонецЕсли;
	// Строки документа на закладке - все его строки продукции: их сумма и есть услуги документа.
	Сумма = 0;
	Для Каждого Строка Из ПоступленияПереработки.НайтиСтроки(Новый Структура("Документ", СтрокаТаблицы.Документ)) Цикл
		Сумма = Сумма + Строка.СтоимостьУслуг;
	КонецЦикла;
	Оповещение = Новый ОписаниеОповещения("ПослеВводаУслугПереработки", ЭтотОбъект,
		Элементы.ПоступленияПереработки.ТекущаяСтрока);
	Заголовок = НСтр("ru = 'Стоимость услуг по документу без НДС';
		|fr = 'Coût HT des services du document'; en = 'Document services cost excluding VAT';
		|es = 'Coste sin IVA de los servicios del documento'");
	// BSLLS:MagicNumber-off - разрядность реквизита СтоимостьУслуг документа: 12 знаков, 2 после запятой.
	ПоказатьВводЧисла(Оповещение, Сумма, Заголовок, 12, 2);
	// BSLLS:MagicNumber-on

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаУслугПереработки(Сумма, Идентификатор) Экспорт

	Если Сумма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УстановитьУслугиНаСервере(Идентификатор, Сумма);
	ОбновитьСписокЗаказов();

КонецПроцедуры

// «Поступление строкой» закладки «Переработка»: переход на «Поступления из переработки» с новой строкой по передаче
// отмеченных строк - одной проведённой. Кнопка «Поступление из переработки» рядом по-прежнему открывает документ - путь
// для ручной правки сырья (решение владельца S6, 5).
//
// Параметры:
//  Команда - КомандаФормы - команда таблицы «Переработки».
//
&НаКлиенте
Процедура ПоступлениеИзПереработкиСтрокой(Команда)

	ОчиститьСообщения();
	Выбранная = Неопределено;
	Непроведенная = Ложь;
	Передачи = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Переработки.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Переработки.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы = Неопределено Или Не СтрокаТаблицы.Записана Тогда
			Продолжить;
		КонецЕсли;
		Непроведенная = Непроведенная Или Не СтрокаТаблицы.Проведен;
		Если Передачи.Найти(СтрокаТаблицы.Документ) = Неопределено Тогда
			Передачи.Добавить(СтрокаТаблицы.Документ);
			Выбранная = СтрокаТаблицы;
		КонецЕсли;
	КонецЦикла;
	Если Передачи.Количество() <> 1 Или Непроведенная Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отметьте строки одной проведённой передачи в переработку.';
			|fr = 'Cochez les lignes d''un seul transfert de sous-traitance validé.';
			|en = 'Tick lines of one posted subcontracting transfer.';
			|es = 'Marque las líneas de un solo envío a subcontratista contabilizado.'"));
		Возврат;
	КонецЕсли;
	Значение = Новый Структура("Передача, Поставщик, Склад", Выбранная.Документ, Выбранная.Поставщик, Выбранная.Склад);
	Элементы.ГруппаНиз.ТекущаяСтраница = Элементы.СтраницаПоступленияПереработки;
	Отказ = Ложь;
	ПередДобавлениемСтрокиДокумента(Элементы.ПоступленияПереработки, Отказ, Ложь);
	Если ВставленнаяСтрока = Неопределено Или ВставленнаяТаблица <> Элементы.ПоступленияПереработки.Имя Тогда
		Возврат;
	КонецЕсли;
	НоваяСтрока = ПоступленияПереработки.НайтиПоИдентификатору(ВставленнаяСтрока);
	Если НоваяСтрока <> Неопределено Тогда
		ПрименитьПередачуПоступления(НоваяСтрока, Значение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПередачу(Команда)

