&НаКлиенте
Процедура СтанкиРазместить(Команда)

	ТекущиеДанные = Элементы.ГотовыеКЗапуску.ТекущиеДанные;
	Станок = ВыбранныйСтанок();
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(Станок) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите станок в списке станков и строку на закладке «Готовы к запуску»';
			|fr = 'Choisissez une machine dans la liste et une ligne dans l''onglet « Prêt à lancer »';
			|en = 'Select a machine in the machine list and a line on the ""Ready to start"" tab';
			|es = 'Elija una máquina en la lista y una línea en la pestaña «Listo para iniciar»'"));
		Возврат;
	КонецЕсли;
	ЗапроситьКоличествоРазмещения(ТекущиеДанные.ПолучитьИдентификатор(), Станок, Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура СтанкиАвтоплан(Команда)

	РассчитатьАвтопланНаСервере();
	Если Автоплан.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет строк, готовых к запуску'; fr = 'Aucune ligne prête à lancer';
			|en = 'No lines ready to start'; es = 'No hay líneas listas para iniciar'"));
		Возврат;
	КонецЕсли;
	Элементы.ГруппаСтанкиНиз.ТекущаяСтраница = Элементы.СтраницаАвтоплан;

КонецПроцедуры

&НаКлиенте
Процедура СтанкиПринятьАвтоплан(Команда)

	Если Автоплан.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала рассчитайте автоплан'; fr = 'Calculez d''abord la planification automatique';
			|en = 'Calculate the auto-plan first'; es = 'Primero calcule la planificación automática'"));
		Возврат;
	КонецЕсли;
	ТекстОшибки = ПринятьАвтопланНаСервере();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

