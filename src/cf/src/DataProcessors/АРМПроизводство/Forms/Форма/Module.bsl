#Область Настройка

&НаСервере
Процедура НастроитьЭлементы()

	Элементы.ЗаказыСумма.Видимость = ПоказыватьСуммы;
	Элементы.ПродукцияЦена.Видимость = ПоказыватьСуммы;
	Элементы.ПродукцияСумма.Видимость = ПоказыватьСуммы;
	Элементы.ДокументыЗаказаСумма.Видимость = ПоказыватьСуммы;
	Элементы.ЗаказыИндикатор.Подсказка = Обработки.АРМПроизводство.ПояснениеИндикатора(Неопределено);
	// Легенда кружков всегда на виду - в строке пагинатора под списком заказов (замечание владельца 2026-10-05).
	Элементы.НадписьЛегенда.Заголовок = Обработки.АРМПроизводство.ЛегендаИндикатораСтрокой();
	Элементы.НадписьЛегенда.ЦветТекста = ЦветаСтиля.Цвет_ПоясняющийТекст;
	Элементы.ПродукцияИндикатор.Подсказка = Элементы.ЗаказыИндикатор.Подсказка;
	// Легенду кружочков и цифры выполнения видно по значку у заголовка: наведения на ячейку владельцу не хватило.
	Элементы.ЗаказыИндикатор.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	Элементы.ПродукцияИндикатор.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	Элементы.ДокументыЗаказаПродукция.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
	Элементы.ДокументыЗаказаМатериалы.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
	ИспользоватьХарактеристики = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	Элементы.ПродукцияХарактеристика.Видимость = ИспользоватьХарактеристики;
	Элементы.МатериалыХарактеристика.Видимость = ИспользоватьХарактеристики;

	Элементы.Продукция.ИзменятьСоставСтрок = МожноМенятьЗаказы;
	Для Каждого ИмяИПраво Из ПраваВводаСтрок(ЭтотОбъект) Цикл
		Префикс = ИмяИПраво.Ключ;
		Элементы[Префикс].ТолькоПросмотр = Не ИмяИПраво.Значение;
		Элементы[Префикс].ИзменятьСоставСтрок = ИмяИПраво.Значение;
		Элементы[Префикс + "ПодменюСтатус"].Видимость = ИмяИПраво.Значение;
		Если Префикс <> Элементы.Выпуски.Имя И Префикс <> Элементы.Переработки.Имя
			И Префикс <> Элементы.ПоступленияПереработки.Имя Тогда
			Элементы[Префикс + "Цена"].Видимость = ПоказыватьСуммы;
			Элементы[Префикс + "Сумма"].Видимость = ПоказыватьСуммы;
		КонецЕсли;
		Элементы[Префикс + "Характеристика"].Видимость = ИспользоватьХарактеристики;
		СвязатьКолонкиПозиции(Префикс);
	КонецЦикла;
	Для Каждого Префикс Из СтрРазделить("Заказы,Продукция", ",") Цикл
		Элементы[Префикс + "СтатусВРаботу"].Видимость = МожноПроводитьЗаказы;
		Элементы[Префикс + "СтатусВЧерновик"].Видимость = МожноПроводитьЗаказы;
		Элементы[Префикс + "СтатусОтменить"].Видимость = МожноПомечатьЗаказы;
		Элементы[Префикс + "ПодменюСтатус"].Видимость = МожноПроводитьЗаказы Или МожноПомечатьЗаказы;
	КонецЦикла;
	// Кнопки ввода на основании живут в панелях своих нижних закладок и появляются по отметке заказа (E12.4).
	ОбновитьВидимостьОснований(ЭтотОбъект, Ложь);
	ОбновитьЗаголовкиЗакладок(ЭтотОбъект);

	Элементы.ПереработкиСоздатьПоступление.Видимость = МожноПоступлениеИзПереработки;
	Элементы.ПереработкиПоступлениеСтрокой.Видимость = МожноВводитьПоступленияИзПереработки;
	// Свойства ПФ/ГП (2.0.16.16): панель есть, если у номенклатуры заведены дополнительные свойства; править их может
	// тот, кто вводит передачи (узкая запись в карточку - Обработки.АРМПроизводство.ЗаписатьСвойствоПродукции).
	Элементы.ГруппаСвойстваПродукции.Видимость = УправлениеСвойствами.ЕстьСвойстваОбъекта("Справочник.Номенклатура");
	Элементы.СвойстваПродукции.ТолькоПросмотр = Не МожноВводитьПереработку;
	Элементы.СвойстваПродукции.ИзменятьСоставСтрок = Ложь;
	// Услуги переработчика - деньги: колонка и кнопка только у пользователя с суммами (S6, решение владельца 3).
	Элементы.ПоступленияПереработкиСтоимостьУслуг.Видимость = ПоказыватьСуммы;
	Элементы.ПоступленияПереработкиУслугаПереработки.Видимость = ПоказыватьСуммы И МожноВводитьПоступленияИзПереработки;
	// Переработчик - только контрагент-субподрядчик: проверка заполнения передачи другого не примет.
	ПараметрыПереработчика = Новый Массив;
	ПараметрыПереработчика.Добавить(Новый ПараметрВыбора("Отбор.Субподрядчик", Истина));
	Элементы.ПереработкиПоставщик.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыПереработчика);
	// Подбор номенклатуры (S7): продукция - только готовая и полуфабрикаты, в том числе при вводе текстом; материалы -
	// мягкий отбор в списке выбора. Форма рабочего места руками не правится (генератор), поэтому обработчики - кодом.
	Каталог = Справочники.Номенклатура;
	ТипыПродукции = Каталог.ТипыПодбора(Каталог.НазначениеПодбораПродукция());
	ПараметрыПродукции = Новый Массив;
	ПараметрыПродукции.Добавить(Новый ПараметрВыбора("Отбор.ТипНоменклатуры", ТипыПродукции));
	Элементы.ПродукцияНоменклатура.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыПродукции);
	Элементы.ОтборПродукция.ПараметрыВыбора = Элементы.ПродукцияНоменклатура.ПараметрыВыбора;
	Элементы.ОтборПродукция.ВыборГруппИЭлементов = ГруппыИЭлементы.Элементы;
	Элементы.ПродукцияНоменклатура.УстановитьДействие("НачалоВыбора", "Подключаемый_ПродукцияНоменклатураНачалоВыбора");
	Для Каждого ИмяТаблицы Из СтрРазделить("ЗаказыПоставщику,Поступления,Переработки", ",") Цикл
		Элементы[ИмяТаблицы + "Материал"].УстановитьДействие("НачалоВыбора", "Подключаемый_ЗакупкиМатериалНачалоВыбора");
	КонецЦикла;

	СвязиХарактеристики = Новый Массив;
	СвязиХарактеристики.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", "Элементы.Продукция.ТекущиеДанные.Номенклатура"));
	Элементы.ПродукцияХарактеристика.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиХарактеристики);
	СвязиУпаковки = Новый Массив;
	СвязиУпаковки.Добавить(Новый СвязьПараметраВыбора("Номенклатура", "Элементы.Продукция.ТекущиеДанные.Номенклатура"));
	Элементы.ПродукцияУпаковка.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиУпаковки);

	// Порядок - настройкой списка, а не текстом запроса: пользовательская сортировка его не ломает.
	ЭлементПорядка = Заказы.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("Дата");
	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	ЭлементПорядка.Использование = Истина;

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	// Строки проведённых заказов - только чтение и приглушённым цветом.
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Продукция.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Продукция.Редактируется");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.Цвет_ПоясняющийТекст);

	// У записанной строки клиент и заказ не меняются: перенос строки между заказами - в форме заказа.
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПродукцияКлиент.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПродукцияЗаказПредставление.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Продукция.Записана");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	// Движение по документу: приход зелёный, расход красный (E12.4, замечание владельца).
	УстановитьЦветДвижения("Продукция", Истина);
	УстановитьЦветДвижения("Продукция", Ложь);
	УстановитьЦветДвижения("Материалы", Истина);
	УстановитьЦветДвижения("Материалы", Ложь);

	УстановитьОформлениеЗакупок("ЗаказыПоставщику", "Поставщик, ДокументПредставление");
	УстановитьОформлениеЗакупок("Поступления",
		"Поставщик, ДокументПредставление, СтрокаОснованияПредставление, НомерВходящегоДокумента, ДатаВходящегоДокумента");
	УстановитьОформлениеЗакупок("Выпуски", "ДокументПредставление");
	УстановитьОформлениеЗакупок("Отгрузки", "ДокументПредставление");
	// Склад передачи задаётся, пока строка не записана: он уходит в шапку нового документа. У записанной передачи
	// склад меняется только в форме документа - смена склада переписала бы списанные партии.
	УстановитьОформлениеЗакупок("Переработки", "Поставщик, Склад, ДокументПредставление");
	// Переработчик и склад поступления - из передачи; у записанной строки передача меняется в форме документа.
	УстановитьОформлениеЗакупок("ПоступленияПереработки", "Передача, ДокументПредставление");

КонецПроцедуры

// Цвет движения колонки закладки «Документы»: приход и расход различаются цветом, а не только знаком.
//
// Параметры:
//  ИмяКолонки - Строка - «Продукция» или «Материалы».
//  Приход     - Булево - оформляется положительное движение; иначе отрицательное.
//
&НаСервере
Процедура УстановитьЦветДвижения(ИмяКолонки, Приход)

	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы["ДокументыЗаказа" + ИмяКолонки].Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДокументыЗаказа." + ИмяКолонки + "Число");
	ОтборЭлемента.ВидСравнения = ?(Приход, ВидСравненияКомпоновкиДанных.Больше, ВидСравненияКомпоновкиДанных.Меньше);
	ОтборЭлемента.ПравоеЗначение = 0;
	// BSLLS:YoLetterUsage-off - имя элемента стиля в метаданных.
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",
		?(Приход, ЦветаСтиля.Цвет_Зелёный, ЦветаСтиля.Цвет_Красный));
	// BSLLS:YoLetterUsage-on

КонецПроцедуры

// Строки документов нижних закладок: у записанной строки документ, поставщик и основание только для просмотра (перенос
// строки между документами - в форме документа); строки, которые правятся только в форме документа, - только чтение и
// приглушённые.
//
// Параметры:
//  ИмяТаблицы        - Строка - «ЗаказыПоставщику», «Поступления», «Выпуски» или «Отгрузки».
//  КолонкиДокумента  - Строка - имена колонок шапки документа через запятую.
//
&НаСервере
Процедура УстановитьОформлениеЗакупок(ИмяТаблицы, КолонкиДокумента)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Для Каждого ИмяКолонки Из СтрРазделить(КолонкиДокумента, ", ", Ложь) Цикл
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы[ИмяТаблицы + ИмяКолонки].Имя);
	КонецЦикла;
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".Записана");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы[ИмяТаблицы].Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".ТолькоПросмотр");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.Цвет_ПоясняющийТекст);

КонецПроцедуры

// Характеристика и упаковка строки выбираются по материалу строки закупки или продукции строки выпуска и отгрузки.
//
// Параметры:
//  ИмяТаблицы - Строка - «ЗаказыПоставщику», «Поступления», «Выпуски» или «Отгрузки».
//
&НаСервере
Процедура СвязатьКолонкиПозиции(ИмяТаблицы)

	ПутьМатериала = СтрШаблон("Элементы.%1.ТекущиеДанные.%2", ИмяТаблицы, ИмяПозицииТаблицы(ИмяТаблицы));
	СвязиХарактеристики = Новый Массив;
	СвязиХарактеристики.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", ПутьМатериала));
	Элементы[ИмяТаблицы + "Характеристика"].СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиХарактеристики);
	СвязиУпаковки = Новый Массив;
	СвязиУпаковки.Добавить(Новый СвязьПараметраВыбора("Номенклатура", ПутьМатериала));
	Элементы[ИмяТаблицы + "Упаковка"].СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиУпаковки);

КонецПроцедуры

// Возвращаемое значение:
//  Булево - у пользователя есть сохранённые данные формы: после создания платформа вызовет
//           ПриЗагрузкеДанныхИзНастроекНаСервере.
//
&НаСервере
Функция ЕстьСохраненныеНастройки()

	КлючОбъекта = ИмяФормы + "/ТекущиеДанные";
	Возврат ХранилищеСистемныхНастроек.Загрузить(КлючОбъекта) <> Неопределено;

КонецФункции

// Параметры списка заказов по панели фильтров (клиент, продукция в составе заказа, стадия, период отгрузки) и
// текущая страница списка.
&НаСервере
Процедура УстановитьПараметрыСписка()

	Обработки.АРМПроизводство.УстановитьЗначенияОтборов(Заказы.Параметры, ОтборыПанели(ЭтотОбъект));
	ПрименитьСтраницу();

КонецПроцедуры

// Постраничный просмотр списка заказов, как в формах списков документов: список ограничивается ссылками текущей
// страницы, счётчик считается теми же условиями, что и запрос списка (Обработки.АРМПроизводство.СтраницаЗаказов).
&НаСервере
Процедура ПрименитьСтраницу()

	Страница = Обработки.АРМПроизводство.СтраницаЗаказов(ОтборыПанели(ЭтотОбъект), НомерСтраницы, РазмерСтраницыЗаказов());
	ПоказатьСтраницу(ЭтотОбъект, Страница);

КонецПроцедуры

// Пересчёт страницы списка заказов без передачи формы на сервер: после записи строк и смены статусов заказ может
// появиться (новый черновик) или уйти из отборов панели (стадия) - счётчик и ссылки страницы должны это видеть.
&НаКлиенте
Процедура ОбновитьСтраницуЗаказов()

	Страница = ДанныеСтраницыЗаказов(ОтборыПанели(ЭтотОбъект), НомерСтраницы, РазмерСтраницыЗаказов());
	ПоказатьСтраницу(ЭтотОбъект, Страница);

КонецПроцедуры

// Страница списка заказов и перечитывание списка.
&НаКлиенте
Процедура ОбновитьСписокЗаказов()

	ОбновитьСтраницуЗаказов();
	Элементы.Заказы.Обновить();

КонецПроцедуры

// Параметры:
//  Отборы         - Структура - см. Обработки.АРМПроизводство.НовыеОтборы.
//  НомерСтраницы  - Число - запрошенная страница.
//  РазмерСтраницы - Число - заказов на странице.
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.СтраницаЗаказов.
//
&НаСервереБезКонтекста
Функция ДанныеСтраницыЗаказов(Знач Отборы, Знач НомерСтраницы, Знач РазмерСтраницы)

	Возврат Обработки.АРМПроизводство.СтраницаЗаказов(Отборы, НомерСтраницы, РазмерСтраницы);

КонецФункции

// Возвращаемое значение:
//  Число - заказов на странице списка.
//
&НаКлиентеНаСервереБезКонтекста
Функция РазмерСтраницыЗаказов()

	// BSLLS:MagicNumber-off - размер страницы, как в формах списков документов.
	Возврат 50;
	// BSLLS:MagicNumber-on

КонецФункции

// Номер страницы, отбор «Ссылка в списке» по заказам страницы и пагинатор.
//
// Параметры:
//  Форма    - ФормаКлиентскогоПриложения - рабочее место.
//  Страница - Структура - см. Обработки.АРМПроизводство.СтраницаЗаказов.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьСтраницу(Форма, Страница)

	Форма.НомерСтраницы = Страница.НомерСтраницы;
	Форма.ВсегоСтраниц = Страница.ВсегоСтраниц;
	ОтборСписка = Форма.Заказы.Отбор;
	ПолеСсылки = Новый ПолеКомпоновкиДанных("Ссылка");
	Найденный = Неопределено;
	Для Каждого Элемент Из ОтборСписка.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") И Элемент.ЛевоеЗначение = ПолеСсылки Тогда
			Найденный = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Страница.Ссылки = Неопределено Тогда
		Если Найденный <> Неопределено Тогда
			ОтборСписка.Элементы.Удалить(Найденный);
		КонецЕсли;
	Иначе
		Если Найденный = Неопределено Тогда
			Найденный = ОтборСписка.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Найденный.ЛевоеЗначение = ПолеСсылки;
		КонецЕсли;
		Найденный.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Найденный.ПравоеЗначение = Страница.Ссылки;
		Найденный.Использование = Истина;
	КонецЕсли;
	РаботаСДокументамиКлиентСервер.ОбновитьПагинатор(Форма, Форма.НомерСтраницы, Форма.ВсегоСтраниц,
		РазмерСтраницыЗаказов(), Страница.Всего);

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборыНаСервере()

	УстановитьПараметрыСписка();
	ЗагрузитьПродукцию();

КонецПроцедуры

// Отборы панели для списка заказов и строк «Продукции».
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - рабочее место.
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.НовыеОтборы.
//
&НаКлиентеНаСервереБезКонтекста
Функция ОтборыПанели(Форма)

	Отборы = Новый Структура;
	Отборы.Вставить("Клиент", Форма.ОтборКлиент);
	Отборы.Вставить("Продукция", Форма.ОтборПродукция);
	Отборы.Вставить("Стадия", Форма.ОтборСтадия);
	Отборы.Вставить("ПериодОтгрузки", Форма.ОтборПериодОтгрузки);
	Возврат Отборы;

КонецФункции

// Свёрнутая панель - столбик значков, развёрнутая - страница фильтров с кнопкой свернуть внизу, как в списках документов.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - рабочее место.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьСостояниеПанели(Форма)

	ЭлементыФормы = Форма.Элементы;
	ЭлементыФормы.ГруппаПанельЗначки.Видимость = Не Форма.ПанельРазвернута;
	ЭлементыФормы.ГруппаСтраницыСведений.Видимость = Форма.ПанельРазвернута;
	ЭлементыФормы.ГруппаПодвалПанели.Видимость = Форма.ПанельРазвернута;

КонецПроцедуры

// Кнопка ввода на основании и право, которым она включена. Кнопка лежит в командной панели своей нижней закладки
// (E12.4, замечание владельца 3): «Заказ поставщику» - в «Заказах поставщику» и так далее.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ Строка (имя кнопки), значение Строка (имя реквизита права).
//
&НаКлиентеНаСервереБезКонтекста
Функция КнопкиОснований()

	Кнопки = Новый Соответствие;
	Кнопки.Вставить("ЗаказыПоставщикуСоздатьЗаказПоставщику", "МожноЗаказПоставщику");
	Кнопки.Вставить("ПоступленияСоздатьПоступление", "МожноПоступление");
	Кнопки.Вставить("ВыпускиСоздатьВыпуск", "МожноВыпуск");
	Кнопки.Вставить("ОтгрузкиСоздатьОтгрузку", "МожноОтгрузку");
	Кнопки.Вставить("ПереработкиСоздатьПередачу", "МожноПередачу");
	Возврат Кнопки;

КонецФункции

// Количество строк в скобках в заголовке каждой нижней закладки (замечание владельца 1). Платформенный способ
// (ПутьКДаннымЗаголовка = «<таблица>.RowsCount», FORMS-STYLE правило 4) работает только для табличной части объекта:
// для реквизита формы типа ТаблицаЗначений платформа отвечает «Неверный путь к данным» - проверено загрузкой
// 2026-09-16. Поэтому заголовок собирается здесь, а базовые заголовки повторяют заголовки страниц из gen7.py.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма рабочего места.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗаголовкиЗакладок(Форма)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("СтраницаМатериалы", НСтр("ru = 'Материалы'; fr = 'Matières'; en = 'Materials';
		|es = 'Materiales'"));
	Заголовки.Вставить("СтраницаЗаказыПоставщику", НСтр("ru = 'Заказы поставщику'; fr = 'Commandes fournisseur';
		|en = 'Supplier orders'; es = 'Pedidos a proveedor'"));
	Заголовки.Вставить("СтраницаПоступления", НСтр("ru = 'Поступления'; fr = 'Réceptions'; en = 'Receipts';
		|es = 'Recepciones'"));
	Заголовки.Вставить("СтраницаВыпуски", НСтр("ru = 'Выпуск'; fr = 'Production'; en = 'Output'; es = 'Producción'"));
	Заголовки.Вставить("СтраницаОтгрузки", НСтр("ru = 'Отгрузки'; fr = 'Expéditions'; en = 'Shipments'; es = 'Envíos'"));
	Заголовки.Вставить("СтраницаПереработки", НСтр("ru = 'Передача в переработку'; fr = 'Transfert en sous-traitance';
		|en = 'Subcontracting transfer'; es = 'Envío a subcontratación'"));
	Заголовки.Вставить("СтраницаПоступленияПереработки", НСтр("ru = 'Поступления из переработки';
		|fr = 'Réceptions de sous-traitance'; en = 'Subcontracting receipts'; es = 'Recepciones de subcontratación'"));
	Заголовки.Вставить("СтраницаДокументы", НСтр("ru = 'Документы'; fr = 'Documents'; en = 'Documents';
		|es = 'Documentos'"));
	Для Каждого СтраницаИТаблица Из ТаблицыЗакладок() Цикл
		Коллекция = Форма[СтраницаИТаблица.Значение];
		// «Материалы» - дерево: в заголовке считаются все его узлы, а не только верхний уровень, иначе
		// счётчик закладки не совпадал бы с тем, что видно на раскрытом дереве.
		Количество = ?(СтраницаИТаблица.Значение = "Материалы", КоличествоУзловДерева(Коллекция.ПолучитьЭлементы()),
			Коллекция.Количество());
		Форма.Элементы[СтраницаИТаблица.Ключ].Заголовок = СтрШаблон("%1 (%2)", Заголовки[СтраницаИТаблица.Ключ],
			Формат(Количество, "ЧН=0; ЧГ=0"));
	КонецЦикла;

КонецПроцедуры

// Число узлов дерева на всех уровнях.
//
// Параметры:
//  Коллекция - ДанныеФормыКоллекцияЭлементовДерева - строки одного уровня.
//
// Возвращаемое значение:
//  Число - количество узлов этого уровня и всех нижних.
//
&НаКлиентеНаСервереБезКонтекста
Функция КоличествоУзловДерева(Коллекция)

	Количество = 0;
	Для Каждого Строка Из Коллекция Цикл
		Количество = Количество + 1 + КоличествоУзловДерева(Строка.ПолучитьЭлементы());
	КонецЦикла;
	Возврат Количество;

КонецФункции

// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ Строка (имя страницы нижней закладки), значение Строка (имя её таблицы).
//
&НаКлиентеНаСервереБезКонтекста
Функция ТаблицыЗакладок()

	Таблицы = Новый Соответствие;
	Таблицы.Вставить("СтраницаМатериалы", "Материалы");
	Таблицы.Вставить("СтраницаЗаказыПоставщику", "ЗаказыПоставщику");
	Таблицы.Вставить("СтраницаПоступления", "Поступления");
	Таблицы.Вставить("СтраницаВыпуски", "Выпуски");
	Таблицы.Вставить("СтраницаОтгрузки", "Отгрузки");
	Таблицы.Вставить("СтраницаПереработки", "Переработки");
	Таблицы.Вставить("СтраницаПоступленияПереработки", "ПоступленияПереработки");
	Таблицы.Вставить("СтраницаДокументы", "ДокументыЗаказа");
	Возврат Таблицы;

КонецФункции

// Кнопки ввода на основании видны, только когда выбран ровно один заказ на производство и по нему разрешён ввод на
// основании (замечание владельца 3; у черновика заказа кнопка прячется, а не отказывает после нажатия).
//
// Параметры:
//  Форма       - ФормаКлиентскогоПриложения - форма рабочего места.
//  ЕстьЗаказ   - Булево - отмечен ровно один заказ.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьОснований(Форма, ЕстьЗаказ)

	Доступно = ЕстьЗаказ И Форма.МожноНаОсновании;
	Для Каждого КнопкаИПраво Из КнопкиОснований() Цикл
		Форма.Элементы[КнопкаИПраво.Ключ].Видимость = Доступно И Форма[КнопкаИПраво.Значение];
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Продукция

// Новая строка «Продукции»: копия строки черновика попадает в тот же черновик новой строкой заказа, копия строки
// заказа в работе - в новый заказ, количество вводится заново.
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - вставленная строка «Продукции».
//  Копирование   - Булево - строка заполнена значениями копируемой.
//
&НаКлиенте
Процедура ПодготовитьНовуюСтроку(СтрокаТаблицы, Копирование)

	Если Не Копирование Или Не СтрокаТаблицы.Редактируется Тогда
		СтрокаТаблицы.Заказ = ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка");
		СтрокаТаблицы.ЗаказПредставление = ТекстНовыйЗаказ();
		// Стадия, индикатор и реквизиты заказа копируемой строки к новому заказу не относятся.
		СтрокаТаблицы.Стадия = ПредопределенноеЗначение("Перечисление.СтатусыЗаказовПокупателя.ПустаяСсылка");
		СтрокаТаблицы.Индикатор = "";
		СтрокаТаблицы.ДатаОтгрузки = Дата(1, 1, 1);
		СтрокаТаблицы.Менеджер = ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка");
	КонецЕсли;
	СтрокаТаблицы.НомерСтроки = 0;
	СтрокаТаблицы.Записана = Ложь;
	СтрокаТаблицы.Редактируется = Истина;
	СтрокаТаблицы.ЦенаИзменена = Ложь;
	СтрокаТаблицы.Сумма = 0;
	СтрокаТаблицы.КоличествоУпаковок = 0;
	СтрокаТаблицы.ВерсияДанных = "";
	СтрокаТаблицы.СтатусДокумента = ТекстНеЗаписано();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПродукцию()

	Результат = Обработки.АРМПроизводство.СтрокиПродукции(ОтборыПанели(ЭтотОбъект));
	// Незаписанные строки не теряются при перечитывании: они возвращаются в начало таблицы.
	Незаписанные = Продукция.Выгрузить(Новый Структура("Записана", Ложь));
	Продукция.Загрузить(Результат.Строки);
	Для Индекс = 1 По Незаписанные.Количество() Цикл
		ЗаполнитьЗначенияСвойств(Продукция.Вставить(0), Незаписанные[Незаписанные.Количество() - Индекс]);
	КонецЦикла;
	Если Результат.Обрезано Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Показаны строки последних 300 заказов.';
			|fr = 'Les lignes des 300 dernières commandes sont affichées.';
			|en = 'Lines of the last 300 orders are shown.';
			|es = 'Se muestran las líneas de los últimos 300 pedidos.'"));
	КонецЕсли;

КонецПроцедуры

// Записывает строку «Продукции» и заменяет строки её заказа в таблице.
//
// Параметры:
//  Идентификатор - Число - идентификатор строки таблицы «Продукция».
//
// Возвращаемое значение:
//  Структура, Неопределено - Клиент, Заказ, ЗаказПредставление записанного черновика; отказ - Неопределено.
//
&НаСервере
Функция ЗаписатьСтрокуНаСервере(Знач Идентификатор)

	СтрокаТаблицы = Продукция.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтроки();
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаТаблицы);
	Результат = Обработки.АРМПроизводство.ЗаписатьСтрокуПродукции(ДанныеСтроки);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
	КонецЕсли;
	Если Результат.Перечитать Тогда
		ЗагрузитьПродукцию();
		Возврат Неопределено;
	КонецЕсли;
	Если Не Результат.Успех Тогда
		СтрокаТаблицы.СтатусДокумента = ТекстНеЗаписано();
		Возврат Неопределено;
	КонецЕсли;
	Позиция = ЗаменитьСтрокиЗаказа(Результат, Продукция.Индекс(СтрокаТаблицы), СтрокаТаблицы);
	Если Позиция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Записанная = Продукция[Позиция];
	Элементы.Продукция.ТекущаяСтрока = Записанная.ПолучитьИдентификатор();
	Возврат Новый Структура("Клиент, Заказ, ЗаказПредставление", ДанныеСтроки.Клиент, Записанная.Заказ,
		Записанная.ЗаказПредставление);

КонецФункции

&НаСервере
Процедура УдалитьСтрокиНаСервере(Знач Идентификаторы)

	СтрокиДанных = ДанныеУдаляемыхСтрок(Идентификаторы);
	Если СтрокиДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Перечитать = Ложь;
	Для Каждого Результат Из Обработки.АРМПроизводство.УдалитьСтрокиПродукции(СтрокиДанных) Цикл
		Если Не ПустаяСтрока(Результат.Текст) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
		КонецЕсли;
		Перечитать = Перечитать Или Результат.Перечитать;
		Если Результат.ЗаказПомечен Тогда
			УдалитьСтрокиТаблицыЗаказа(Результат.Заказ);
		ИначеЕсли Результат.Успех Тогда
			ЗаменитьСтрокиЗаказа(Результат, Неопределено, Неопределено);
		Иначе
			Перечитать = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Перечитать Тогда
		ЗагрузитьПродукцию();
	КонецЕсли;

КонецПроцедуры

// Незаписанные строки удаляются из таблицы сразу, строки заказов в работе остаются с сообщением.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы выделенных строк «Продукции».
//
// Возвращаемое значение:
//  Массив из Структура - данные записанных строк черновиков, см. Обработки.АРМПроизводство.НовыеДанныеСтроки.
//
&НаСервере
Функция ДанныеУдаляемыхСтрок(Идентификаторы)

	СтрокиДанных = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		СтрокаТаблицы = Продукция.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не СтрокаТаблицы.Записана Тогда
			Продукция.Удалить(СтрокаТаблицы);
		ИначеЕсли СтрокаТаблицы.Редактируется Тогда
			ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтроки();
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаТаблицы);
			СтрокиДанных.Добавить(ДанныеСтроки);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСтрокаТолькоДляЧтения());
		КонецЕсли;
	КонецЦикла;
	Возврат СтрокиДанных;

КонецФункции

// Заменяет строки заказа в таблице строками из результата записи: номера строк после записи и удаления сдвигаются.
//
// Параметры:
//  Результат         - Структура - см. Обработки.АРМПроизводство.ЗаписатьСтрокуПродукции.
//  ИндексПравленой   - Число, Неопределено - индекс строки, которую правили: новая строка ещё не принадлежит заказу.
//  ПравленаяСтрока   - ДанныеФормыЭлементКоллекции, Неопределено - строка, которую правили.
//
// Возвращаемое значение:
//  Число, Неопределено - индекс записанной строки в таблице.
//
&НаСервере
Функция ЗаменитьСтрокиЗаказа(Результат, ИндексПравленой, ПравленаяСтрока)

	Позиция = ИндексПравленой;
	Всего = Продукция.Количество();
	Для Индекс = 1 По Всего Цикл
		ИндексСтроки = Всего - Индекс;
		СтрокаТаблицы = Продукция[ИндексСтроки];
		Если СтрокаТаблицы = ПравленаяСтрока Или СтрокаТаблицы.Записана И СтрокаТаблицы.Заказ = Результат.Заказ Тогда
			Позиция = ИндексСтроки;
			Продукция.Удалить(ИндексСтроки);
		КонецЕсли;
	КонецЦикла;
	Если Позиция = Неопределено Тогда
		Позиция = 0;
	КонецЕсли;
	ИндексЗаписанной = Неопределено;
	Для Каждого ДанныеСтроки Из Результат.СтрокиЗаказа Цикл
		// Отборы панели действуют и после записи: строки заказа вне отбора не вставляются, кроме введённой - её пользователь
		// только что видел. Период отгрузки здесь не проверяется: он сверяется при следующем перечитывании «Продукции».
		ВнеОтбора = СтрокаВнеОтборовПанели(ЭтотОбъект, ДанныеСтроки);
		Если ВнеОтбора И ДанныеСтроки.НомерСтроки <> Результат.НомерСтроки Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Продукция.Вставить(Позиция);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
		Если ДанныеСтроки.НомерСтроки = Результат.НомерСтроки Тогда
			ИндексЗаписанной = Позиция;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат ИндексЗаписанной;

КонецФункции

&НаСервере
Процедура УдалитьСтрокиТаблицыЗаказа(Заказ)

	Для Каждого СтрокаТаблицы Из Продукция.НайтиСтроки(Новый Структура("Заказ, Записана", Заказ, Истина)) Цикл
		Продукция.Удалить(СтрокаТаблицы);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУдалении(Ответ, Идентификаторы) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	УдалитьСтрокиНаСервере(Идентификаторы);
	ПослеЗаписиЗаказов();

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЧерновика(ВыбранныйЭлемент, Идентификатор) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Продукция.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Заказ = ВыбранныйЭлемент.Значение;
	СтрокаТаблицы.ЗаказПредставление = ВыбранныйЭлемент.Представление;
	// Новая строка в выбранный черновик: версия не нужна, сервер проверит заказ после блокировки.
	СтрокаТаблицы.ВерсияДанных = "";

КонецПроцедуры

// Черновик для новой строки клиента: куда в этом сеансе последний раз записана его строка, иначе самый свежий черновик
// клиента среди строк таблицы. Черновик из памяти берётся, только пока его строки в таблице ещё редактируются: заказ,
// переведённый в работу или помеченный, по умолчанию не подставляется.
//
// Параметры:
//  Клиент - СправочникСсылка.Контрагенты - клиент строки.
//
// Возвращаемое значение:
//  Структура, Неопределено - Заказ, ЗаказПредставление; черновика нет - Неопределено.
//
&НаКлиенте
Функция ЧерновикКлиентаПоУмолчанию(Клиент)

	ИзСеанса = Неопределено;
	Если ПоследниеЧерновики <> Неопределено Тогда
		ИзСеанса = ПоследниеЧерновики.Получить(Клиент);
	КонецЕсли;
	СвежийВТаблице = Неопределено;
	Для Каждого СтрокаТаблицы Из Продукция Цикл
		Если Не СтрокаТаблицы.Записана Или Не СтрокаТаблицы.Редактируется Или СтрокаТаблицы.Клиент <> Клиент Тогда
			Продолжить;
		КонецЕсли;
		Если ИзСеанса <> Неопределено И СтрокаТаблицы.Заказ = ИзСеанса.Заказ Тогда
			Возврат Новый Структура("Заказ, ЗаказПредставление", СтрокаТаблицы.Заказ, СтрокаТаблицы.ЗаказПредставление);
		КонецЕсли;
		Если СвежийВТаблице = Неопределено Тогда
			СвежийВТаблице = Новый Структура("Заказ, ЗаказПредставление", СтрокаТаблицы.Заказ, СтрокаТаблицы.ЗаказПредставление);
		КонецЕсли;
	КонецЦикла;
	Возврат СвежийВТаблице;

КонецФункции

&НаСервереБезКонтекста
Функция ЧерновикиКлиента(Знач Клиент)

	Возврат Обработки.АРМПроизводство.ЧерновикиКлиента(Клиент);

КонецФункции

#КонецОбласти

#Область Статус

&НаКлиенте
Процедура ИзменитьСтатус(Действие)

	ВыбранныеЗаказы = ВыделенныеЗаказы();
	Если ВыбранныеЗаказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИзменитьСтатусНаСервере(ВыбранныеЗаказы, Действие);
	ПослеЗаписиЗаказов();

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОтмене(Ответ, ВыбранныеЗаказы) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ИзменитьСтатусНаСервере(ВыбранныеЗаказы, ДействиеОтменить());
		ПослеЗаписиЗаказов();
	КонецЕсли;

КонецПроцедуры

// Заказы выделенных строк активной верхней закладки: у списка заказов ключ строки - ссылка, у «Продукции» - заказы
// записанных строк без повторов.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПокупателя - выделенные заказы.
//
&НаКлиенте
Функция ВыделенныеЗаказы()

	Результат = ОтмеченныеЗаказы();
	Если Результат.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстВыберитеЗаказ());
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Заказы выделенных строк активной верхней закладки без сообщения.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПокупателя - выделенные заказы без повторов.
//
&НаКлиенте
Функция ОтмеченныеЗаказы()

	Результат = Новый Массив;
	Если Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаЗаказы Тогда
		Для Каждого КлючСтроки Из Элементы.Заказы.ВыделенныеСтроки Цикл
			Если ТипЗнч(КлючСтроки) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
				Результат.Добавить(КлючСтроки);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Идентификатор Из Элементы.Продукция.ВыделенныеСтроки Цикл
			СтрокаТаблицы = Продукция.НайтиПоИдентификатору(Идентификатор);
			Если СтрокаТаблицы <> Неопределено И СтрокаТаблицы.Записана И Результат.Найти(СтрокаТаблицы.Заказ) = Неопределено Тогда
				Результат.Добавить(СтрокаТаблицы.Заказ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ИзменитьСтатусНаСервере(Знач ВыбранныеЗаказы, Знач Действие)

	Для Каждого Итог Из Обработки.АРМПроизводство.ИзменитьСтатусЗаказов(ВыбранныеЗаказы, Действие) Цикл
		Если Не ПустаяСтрока(Итог.Текст) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("%1: %2", Итог.Заказ, Итог.Текст));
		КонецЕсли;
	КонецЦикла;
	ЗагрузитьПродукцию();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДействиеВРаботу()
	Возврат "ВРаботу";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДействиеВЧерновик()
	Возврат "ВЧерновик";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДействиеОтменить()
	Возврат "Отменить";
КонецФункции

#КонецОбласти

#Область Закупки

// Ввод строк документов нижних закладок разрешён у заказа на производство в работе и при праве на вид документа.
//
// Параметры:
//  ИмяТаблицы - Строка - «ЗаказыПоставщику», «Поступления», «Выпуски» или «Отгрузки».
//
// Возвращаемое значение:
//  Булево - Истина, если строки таблицы можно вводить и править.
//
&НаКлиенте
Функция ВводСтрокДокументовРазрешен(ИмяТаблицы)

	Если Не МожноНаОсновании Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстТолькоЗаказВРаботе());
		Возврат Ложь;
	КонецЕсли;
	Можно = ПраваВводаСтрок(ЭтотОбъект)[ИмяТаблицы];
	Если Не Можно Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Нет права вводить эти документы: строки только для просмотра.';
			|fr = 'Aucun droit de saisir ces documents : les lignes sont en lecture seule.';
			|en = 'No right to enter these documents: the lines are read-only.';
			|es = 'Sin derecho a introducir estos documentos: las líneas son de solo lectura.'"));
	КонецЕсли;
	Возврат Можно;

КонецФункции

&НаКлиенте
Процедура ПередДобавлениемСтрокиДокумента(Элемент, Отказ, Копирование)

	ОчиститьСообщения();
	// Новая строка - в начало таблицы, как в «Продукции»: строку вставляет рабочее место, ввод начинается обработчиком
	// ожидания.
	Отказ = Истина;
	ИмяТаблицы = Элемент.Имя;
	Если Не ВводСтрокДокументовРазрешен(ИмяТаблицы) Тогда
		Возврат;
	КонецЕсли;
	УдалитьПустуюВставленнуюСтроку();
	Таблица = ЭтотОбъект[ИмяТаблицы];
	НоваяСтрока = Таблица.Вставить(0);
	НоваяСтрока.Статус = ТекстНеЗаписано();
	НоваяСтрока.ДокументПредставление = ТекстНовыйДокумент();
	Если ИмяТаблицы = Элементы.Поступления.Имя Тогда
		НоваяСтрока.СтрокаОснованияПредставление = ТекстБезЗаказаПоставщику();
	КонецЕсли;
	Если Копирование И Элемент.ТекущиеДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент.ТекущиеДанные, ИмяПозицииТаблицы(ИмяТаблицы) + ", Характеристика, Упаковка");
		Если ЭтоТаблицаЗакупок(ИмяТаблицы) Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент.ТекущиеДанные, "Поставщик");
		КонецЕсли;
		ЭтоПоступлениеПереработки = ИмяТаблицы = Элементы.ПоступленияПереработки.Имя;
		Если ЭтоПоступлениеПереработки Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент.ТекущиеДанные, "Передача, Поставщик, Склад, ПроцентПотерь");
		КонецЕсли;
		Если Не ЭтоПоступлениеПереработки И ИмяТаблицы <> Элементы.Выпуски.Имя И ИмяТаблицы <> Элементы.Переработки.Имя Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент.ТекущиеДанные, "Цена, ЦенаИзменена");
		КонецЕсли;
		ПодставитьДокументСтроки(ИмяТаблицы, НоваяСтрока);
	КонецЕсли;
	ВставленнаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	ВставленнаяТаблица = ИмяТаблицы;
	ОбновитьЗаголовкиЗакладок(ЭтотОбъект);
	Элемент.ТекущаяСтрока = ВставленнаяСтрока;
	ЗадержкаСекунд = 0.1;
	ПодключитьОбработчикОжидания("НачатьВводВставленнойСтроки", ЗадержкаСекунд, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПередИзменениемСтрокиДокумента(Элемент, Отказ)

	ОчиститьСообщения();
	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ВводСтрокДокументовРазрешен(Элемент.Имя) Тогда
		Отказ = Истина;
	ИначеЕсли СтрокаТаблицы.ТолькоПросмотр Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПравкаВФормеДокумента());
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередУдалениемСтрокДокументов(Элемент, Отказ)

	ОчиститьСообщения();
	// Удаление - одним серверным вызовом: документы закупки меняются только сервером, платформа удалила бы лишь строки
	// таблицы.
	Отказ = Истина;
	Если Элемент.ВыделенныеСтроки.Количество() = 0 Или Не ВводСтрокДокументовРазрешен(Элемент.Имя) Тогда
		Возврат;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		Идентификаторы.Добавить(Идентификатор);
	КонецЦикла;
	ДопПараметры = Новый Структура("ИмяТаблицы, Идентификаторы", Элемент.Имя, Идентификаторы);
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдаленииСтрокДокументов", ЭтотОбъект, ДопПараметры);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить выделенные строки из документов?';
		|fr = 'Supprimer les lignes sélectionnées des documents ?';
		|en = 'Delete the selected lines from the documents?';
		|es = '¿Eliminar las líneas seleccionadas de los documentos?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУдаленииСтрокДокументов(Ответ, ДопПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	УдалитьСтрокиДокументовНаСервере(ДопПараметры.ИмяТаблицы, ДопПараметры.Идентификаторы);
	ОбновитьСписокЗаказов();
	ОбновитьЗаголовкиЗакладок(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПриОкончанииРедактированияСтрокиДокумента(Элемент, ОтменаРедактирования)

	ОчиститьСообщения();
	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Вставлена = ВставленнаяСтрока <> Неопределено И ВставленнаяТаблица = Элемент.Имя
		И Элемент.ТекущаяСтрока = ВставленнаяСтрока;
	Если Вставлена Тогда
		ВставленнаяСтрока = Неопределено;
	КонецЕсли;
	Если ОтменаРедактирования Тогда
		Если Вставлена И Не СтрокаТаблицы.Записана Тогда
			ЭтотОбъект[Элемент.Имя].Удалить(СтрокаТаблицы);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Не СтрокаДокументаЗаполнена(Элемент.Имя, СтрокаТаблицы) Тогда
		// Ввод ещё идёт: отмечаем строку и молчим до выхода из неё. Замечание выдаст
		// ПриАктивизацииСтрокиДокумента, когда пользователь перейдёт на другую строку.
		СтрокаТаблицы.Статус = ТекстНеЗаписано();
		НезаполненнаяТаблица = Элемент.Имя;
		НезаполненнаяСтрока = Элемент.ТекущаяСтрока;
		Возврат;
	КонецЕсли;
	ЗабытьНезаполненнуюСтроку();
	ЗаписатьСтрокуДокументаНаСервере(Элемент.Имя, Элемент.ТекущаяСтрока);
	ОбновитьСписокЗаказов();
	ОбновитьЗаголовкиЗакладок(ЭтотОбъект);

КонецПроцедуры

// Строка таблицы документов заполнена настолько, чтобы её можно было записать в документ.
//
// Параметры:
//  ИмяТаблицы    - Строка - имя таблицы формы.
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если заполнены позиция, количество и (у закупок) поставщик.
//
&НаКлиенте
Функция СтрокаДокументаЗаполнена(ИмяТаблицы, СтрокаТаблицы)

	Если ЭтоТаблицаЗакупок(ИмяТаблицы) И Не ЗначениеЗаполнено(СтрокаТаблицы.Поставщик) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ИмяТаблицы = Элементы.ПоступленияПереработки.Имя И Не ЗначениеЗаполнено(СтрокаТаблицы.Передача) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(СтрокаТаблицы[ИмяПозицииТаблицы(ИмяТаблицы)])
		И СтрокаТаблицы.КоличествоУпаковок > 0;

КонецФункции

// Снимает отметку незаполненной строки: строка записана или замечание по ней уже выдано.
//
&НаКлиенте
Процедура ЗабытьНезаполненнуюСтроку()

	НезаполненнаяТаблица = Неопределено;
	НезаполненнаяСтрока = Неопределено;

КонецПроцедуры

// Общий обработчик активизации строки таблиц документов: пользователь ушёл со строки, и если она осталась
// незаполненной - самое время сказать об этом. Пока он в строке, Enter завершает редактирование ячейки, и
// замечание на каждое нажатие только мешало бы вводу.
//
// Параметры:
//  Элемент - ТаблицаФормы - таблица строк документов.
//
&НаКлиенте
Процедура ПриАктивизацииСтрокиДокумента(Элемент)

	Если НезаполненнаяСтрока = Неопределено Или НезаполненнаяТаблица <> Элемент.Имя
		Или Элемент.ТекущаяСтрока = НезаполненнаяСтрока Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = ЭтотОбъект[Элемент.Имя].НайтиПоИдентификатору(НезаполненнаяСтрока);
	ИмяТаблицы = НезаполненнаяТаблица;
	ЗабытьНезаполненнуюСтроку();
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.Записана
		Или СтрокаДокументаЗаполнена(ИмяТаблицы, СтрокаТаблицы) Тогда
		Возврат;
	КонецЕсли;
	СообщитьОдно(ТекстЗаполнитеСтроку(ИмяТаблицы));

КонецПроцедуры

// Единственное сообщение пользователю: прежний список очищается, чтобы в окне не копились замечания
// предыдущих попыток ввода.
//
// Параметры:
//  Текст - Строка - текст сообщения.
//
&НаКлиенте
Процедура СообщитьОдно(Текст)

	ОчиститьСообщения();
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументСтроки(Элемент, Поле, СтандартнаяОбработка)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или Не СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	ПоляДокумента = Новый Массив;
	ПоляДокумента.Добавить(Элемент.Имя + "Статус");
	ПоляДокумента.Добавить(Элемент.Имя + "ДокументПредставление");
	Если ПоляДокумента.Найти(Поле.Имя) <> Неопределено Или СтрокаТаблицы.ТолькоПросмотр Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьДокумент(СтрокаТаблицы.Документ);
	КонецЕсли;

КонецПроцедуры

// Документ и заказ поставщику новой строки - как у ближайшей записанной строки ниже: у закупок - того же поставщика
// (решение владельца 10), у выпуска и отгрузки - любой сегодняшней; нет такой - «Новый».
//
// Параметры:
//  ИмяТаблицы    - Строка - «ЗаказыПоставщику», «Поступления», «Выпуски» или «Отгрузки».
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - строка таблицы.
//
&НаКлиенте
Процедура ПодставитьДокументСтроки(ИмяТаблицы, СтрокаТаблицы)

	Если СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	Таблица = ЭтотОбъект[ИмяТаблицы];
	ЭтоПоступление = ИмяТаблицы = Элементы.Поступления.Имя;
	СтрокаТаблицы.Документ = ПустойДокументТаблицы(ИмяТаблицы);
	СтрокаТаблицы.ДокументПредставление = ТекстНовыйДокумент();
	Для Индекс = Таблица.Индекс(СтрокаТаблицы) + 1 По Таблица.Количество() - 1 Цикл
		Соседняя = Таблица[Индекс];
		Если Не СоседняяСтрокаПодходит(ИмяТаблицы, СтрокаТаблицы, Соседняя) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы.Документ = Соседняя.Документ;
		СтрокаТаблицы.ДокументПредставление = Соседняя.ДокументПредставление;
		Если ЭтоПоступление Тогда
			ПодставитьНакладнуюСоседней(СтрокаТаблицы, Соседняя);
		КонецЕсли;
		Прервать;
	КонецЦикла;

КонецПроцедуры

// Документ за сегодня, который правится в рабочем месте; у закупок - того же поставщика, у поступления - и того же
// основания и накладной, если номер набран.
//
// Параметры:
//  ИмяТаблицы    - Строка - имя таблицы строк.
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - новая строка.
//  Соседняя      - ДанныеФормыЭлементКоллекции - строка ниже.
//
// Возвращаемое значение:
//  Булево - документ соседней строки подходит новой.
//
&НаКлиенте
Функция СоседняяСтрокаПодходит(ИмяТаблицы, СтрокаТаблицы, Соседняя)

	Подходит = Соседняя.Записана И Не Соседняя.ТолькоПросмотр И Соседняя.ДокументЗаСегодня;
	Если Подходит И ЭтоТаблицаЗакупок(ИмяТаблицы) Тогда
		Подходит = Соседняя.Поставщик = СтрокаТаблицы.Поставщик;
	КонецЕсли;
	Если Подходит И ИмяТаблицы = Элементы.ПоступленияПереработки.Имя Тогда
		// Новая строка поступления идёт только в документ той же передачи.
		Подходит = Соседняя.Передача = СтрокаТаблицы.Передача;
	КонецЕсли;
	Если Подходит И ИмяТаблицы = Элементы.Поступления.Имя Тогда
		НомерНабран = Не ПустаяСтрока(СтрокаТаблицы.НомерВходящегоДокумента);
		ТотЖеНомер = СокрЛП(Соседняя.НомерВходящегоДокумента) = СокрЛП(СтрокаТаблицы.НомерВходящегоДокумента);
		Подходит = Соседняя.ЗаказПоставщику = СтрокаТаблицы.ЗаказПоставщику И (Не НомерНабран Или ТотЖеНомер);
	КонецЕсли;
	Возврат Подходит;

КонецФункции

// Номер и дата накладной соседней строки - только в пустые поля новой строки.
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - новая строка «Поступлений».
//  Соседняя      - ДанныеФормыЭлементКоллекции - строка того же документа.
//
&НаКлиенте
Процедура ПодставитьНакладнуюСоседней(СтрокаТаблицы, Соседняя)

	Если ПустаяСтрока(СтрокаТаблицы.НомерВходящегоДокумента) Тогда
		СтрокаТаблицы.НомерВходящегоДокумента = Соседняя.НомерВходящегоДокумента;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаВходящегоДокумента) Тогда
		СтрокаТаблицы.ДатаВходящегоДокумента = Соседняя.ДатаВходящегоДокумента;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  ИмяТаблицы - Строка - «ЗаказыПоставщику», «Поступления» или «Переработки».
//
// Возвращаемое значение:
//  Строка - колонка дерева «Материалы» с количеством по умолчанию: переработчику передаётся материал под потребность
//           заказа, закупается - дефицит, приходует - остаток к поступлению.
//
&НаКлиенте
Функция КолонкаКоличестваМатериала(ИмяТаблицы)

	Если ИмяТаблицы = Элементы.Поступления.Имя Тогда
		Возврат "КПоступлению";
	ИначеЕсли ИмяТаблицы = Элементы.Переработки.Имя Тогда
		Возврат "Потребность";
	Иначе
		Возврат "Дефицит";
	КонецЕсли;

КонецФункции

// Материалы текущего заказа для списка выбора колонки «Материал» (S7): каждая пара материал и характеристика один
// раз, в порядке дерева, с количеством по колонке таблицы (см. КолонкаКоличестваМатериала) по всем изделиям.
//
// Параметры:
//  ИмяТаблицы - Строка - «ЗаказыПоставщику», «Поступления» или «Переработки».
//
// Возвращаемое значение:
//  СписокЗначений - значение - Структура: Номенклатура, Характеристика; представление - «материал, характеристика -
//                   дефицит N».
//
&НаКлиенте
Функция МатериалыЗаказаДляПодбора(ИмяТаблицы)

	ИмяКолонки = КолонкаКоличестваМатериала(ИмяТаблицы);
	Если ИмяКолонки = "КПоступлению" Тогда
		Шаблон = НСтр("ru = 'к поступлению %1'; fr = 'à recevoir %1'; en = '%1 to receive'; es = 'por recibir %1'");
	ИначеЕсли ИмяКолонки = "Потребность" Тогда
		Шаблон = НСтр("ru = 'потребность %1'; fr = 'besoin %1'; en = 'required %1'; es = 'necesidad %1'");
	Иначе
		Шаблон = НСтр("ru = 'дефицит %1'; fr = 'manque %1'; en = 'shortage %1'; es = 'faltan %1'");
	КонецЕсли;
	Пары = Новый Массив;
	СобратьМатериалыВетви(Материалы.ПолучитьЭлементы(), Пары);
	Список = Новый СписокЗначений;
	Для Каждого Пара Из Пары Цикл
		Количество = КоличествоМатериала(Пара.Номенклатура, Пара.Характеристика, ИмяКолонки);
		Представление = Строка(Пара.Номенклатура);
		Если ЗначениеЗаполнено(Пара.Характеристика) Тогда
			Представление = СтрШаблон("%1, %2", Представление, Пара.Характеристика);
		КонецЕсли;
		КоличествоСтрокой = СтрШаблон(Шаблон, Формат(Количество, "ЧГ=0; ЧН=0"));
		Список.Добавить(Пара, СтрШаблон("%1 - %2", Представление, КоличествоСтрокой));
	КонецЦикла;
	Возврат Список;

КонецФункции

// Параметры:
//  Коллекция - ДанныеФормыКоллекцияЭлементовДерева - строки одного уровня дерева «Материалы».
//  Пары      - Массив из Структура - Номенклатура, Характеристика; пополняется парами, которых в нём ещё нет.
//
&НаКлиенте
Процедура СобратьМатериалыВетви(Коллекция, Пары)

	Для Каждого СтрокаМатериала Из Коллекция Цикл
		Если ЗначениеЗаполнено(СтрокаМатериала.Материал) Тогда
			Учтена = Ложь;
			Для Каждого Пара Из Пары Цикл
				Если Пара.Номенклатура = СтрокаМатериала.Материал И Пара.Характеристика = СтрокаМатериала.Характеристика Тогда
					Учтена = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не Учтена Тогда
				Пара = Новый Структура("Номенклатура, Характеристика", СтрокаМатериала.Материал,
					СтрокаМатериала.Характеристика);
				Пары.Добавить(Пара);
			КонецЕсли;
		КонецЕсли;
		СобратьМатериалыВетви(СтрокаМатериала.ПолучитьЭлементы(), Пары);
	КонецЦикла;

КонецПроцедуры

// Количество материала по умолчанию - сумма колонки «Материалов» по всем изделиям заказа.
// Обход рекурсией по всем уровням дерева: у ДанныеФормыДерево нет НайтиСтроки. Узел с потомками в сумму
// вклада не даёт - у него колонки регистра нулевые, - поэтому двойного счёта нет.
//
// Параметры:
//  Материал       - СправочникСсылка.Номенклатура - материал.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика.
//  ИмяКолонки     - Строка - «Дефицит» или «КПоступлению».
//
// Возвращаемое значение:
//  Число - количество.
//
&НаКлиенте
Функция КоличествоМатериала(Материал, Характеристика, ИмяКолонки)

	Возврат КоличествоМатериалаВетви(Материалы.ПолучитьЭлементы(), Материал, Характеристика, ИмяКолонки);

КонецФункции

// Параметры:
//  Коллекция      - ДанныеФормыКоллекцияЭлементовДерева - строки одного уровня.
//  Материал       - СправочникСсылка.Номенклатура - материал.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика.
//  ИмяКолонки     - Строка - суммируемая колонка.
//
// Возвращаемое значение:
//  Число - сумма по этому уровню и всем нижним.
//
&НаКлиенте
Функция КоличествоМатериалаВетви(Коллекция, Материал, Характеристика, ИмяКолонки)

	Количество = 0;
	Для Каждого СтрокаМатериала Из Коллекция Цикл
		Если СтрокаМатериала.Материал = Материал И СтрокаМатериала.Характеристика = Характеристика Тогда
			Количество = Количество + СтрокаМатериала[ИмяКолонки];
		КонецЕсли;
		Количество = Количество
			+ КоличествоМатериалаВетви(СтрокаМатериала.ПолучитьЭлементы(), Материал, Характеристика, ИмяКолонки);
	КонецЦикла;
	Возврат Количество;

КонецФункции

// Строка поступления: смена материала или характеристики сбрасывает строку заказа поставщику; подходящая строка одна -
// подставляется, несколько - подсказка выбрать.
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - новая строка «Поступлений».
//
&НаКлиенте
Процедура ПодобратьСтрокуОснования(СтрокаТаблицы)

	Если СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.ЗаказПоставщику = ПредопределенноеЗначение("Документ.ЗаказПоставщику.ПустаяСсылка");
	СтрокаТаблицы.КодСтрокиОснования = 0;
	СтрокаТаблицы.СтрокаОснованияПредставление = ТекстБезЗаказаПоставщику();
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Материал) Тогда
		Возврат;
	КонецЕсли;
	Список = СтрокиОснованийДляВыбора(ТекущийЗаказ, СтрокаТаблицы.Поставщик, СтрокаТаблицы.Материал,
		СтрокаТаблицы.Характеристика);
	Если Список.Количество() = 1 Тогда
		ПрименитьСтрокуОснования(СтрокаТаблицы, Список[0]);
	КонецЕсли;
	// Несколько строк - подсказка выбрать; ни одной - поступление без заказа поставщику.
	Если Список.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'По материалу несколько строк заказов поставщику:
			| выберите строку в колонке «Заказ поставщику».';
			|fr = 'Plusieurs lignes de commandes fournisseur pour cette matière : choisissez-la dans la colonne « Commande fournisseur ».';
			|en = 'Several supplier order lines for this material: select one in the ""Supplier order"" column.';
			|es = 'Varias líneas de pedidos a proveedor para este material: elija una en la columna «Pedido a proveedor».'"));
	КонецЕсли;
	ПодставитьДокументСтроки(Элементы.Поступления.Имя, СтрокаТаблицы);

КонецПроцедуры

// Параметры:
//  СтрокаТаблицы  - ДанныеФормыЭлементКоллекции - строка «Поступлений».
//  ЭлементСписка  - ЭлементСпискаЗначений - значение - см. Обработки.АРМПроизводство.СтрокиЗаказовПоставщикуДляВыбора.
//
&НаКлиенте
Процедура ПрименитьСтрокуОснования(СтрокаТаблицы, ЭлементСписка)

	Значение = ЭлементСписка.Значение;
	СтрокаТаблицы.ЗаказПоставщику = Значение.ЗаказПоставщику;
	СтрокаТаблицы.КодСтрокиОснования = Значение.КодСтроки;
	СтрокаТаблицы.СтрокаОснованияПредставление = ЭлементСписка.Представление;
	СтрокаТаблицы.Поставщик = Значение.Поставщик;
	СтрокаТаблицы.Материал = Значение.Материал;
	СтрокаТаблицы.Характеристика = Значение.Характеристика;
	СтрокаТаблицы.Упаковка = Значение.Упаковка;
	СтрокаТаблицы.КоличествоУпаковок = Значение.КоличествоУпаковок;
	СтрокаТаблицы.ЦенаИзменена = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСтрокиОснования(ВыбранныйЭлемент, Идентификатор) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Поступления.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранныйЭлемент.Значение = Неопределено Тогда
		СтрокаТаблицы.ЗаказПоставщику = ПредопределенноеЗначение("Документ.ЗаказПоставщику.ПустаяСсылка");
		СтрокаТаблицы.КодСтрокиОснования = 0;
		СтрокаТаблицы.СтрокаОснованияПредставление = ТекстБезЗаказаПоставщику();
	Иначе
		ПрименитьСтрокуОснования(СтрокаТаблицы, ВыбранныйЭлемент);
	КонецЕсли;
	ПодставитьДокументСтроки(Элементы.Поступления.Имя, СтрокаТаблицы);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораДокументаСтроки(ВыбранныйЭлемент, ДопПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = ЭтотОбъект[ДопПараметры.ИмяТаблицы].НайтиПоИдентификатору(ДопПараметры.Идентификатор);
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранныйЭлемент.Значение = Неопределено Тогда
		СтрокаТаблицы.Документ = ПустойДокументТаблицы(ДопПараметры.ИмяТаблицы);
		СтрокаТаблицы.ДокументПредставление = ТекстНовыйДокумент();
	Иначе
		СтрокаТаблицы.Документ = ВыбранныйЭлемент.Значение;
		СтрокаТаблицы.ДокументПредставление = ВыбранныйЭлемент.Представление;
	КонецЕсли;
	СтрокаТаблицы.ВерсияДанных = "";

КонецПроцедуры

// «Статус» нижних закладок: документы отмеченных записанных строк таблицы команды.
//
// Параметры:
//  Команда  - КомандаФормы - команда таблицы строк документов.
//  Действие - Строка - см. ДействиеВРаботу, ДействиеВЧерновик, ДействиеОтменить.
//
&НаКлиенте
Процедура ИзменитьСтатусДокументовСтрокФормы(Команда, Действие)

	ОчиститьСообщения();
	// Команды таблиц названы «<Таблица>СтатусВРаботу», «<Таблица>СтатусВЧерновик», «<Таблица>СтатусОтменить».
	ИмяТаблицы = Лев(Команда.Имя, СтрНайти(Команда.Имя, "Статус") - 1);
	ДокументыЗакупки = Новый Массив;
	Для Каждого Идентификатор Из Элементы[ИмяТаблицы].ВыделенныеСтроки Цикл
		СтрокаТаблицы = ЭтотОбъект[ИмяТаблицы].НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы <> Неопределено И СтрокаТаблицы.Записана И ДокументыЗакупки.Найти(СтрокаТаблицы.Документ) = Неопределено Тогда
			ДокументыЗакупки.Добавить(СтрокаТаблицы.Документ);
		КонецЕсли;
	КонецЦикла;
	Если ДокументыЗакупки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отметьте записанные строки документов.';
			|fr = 'Cochez des lignes de documents enregistrés.'; en = 'Tick lines of saved documents.';
			|es = 'Marque líneas de documentos guardados.'"));
		Возврат;
	КонецЕсли;
	Если Действие <> ДействиеОтменить() Тогда
		ИзменитьСтатусДокументовСтрокНаСервере(ДокументыЗакупки, Действие);
		ОбновитьСписокЗаказов();
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбОтменеДокументовСтрок", ЭтотОбъект, ДокументыЗакупки);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Пометить документы отмеченных строк на удаление?';
		|fr = 'Marquer les documents des lignes cochées pour suppression ?';
		|en = 'Mark the documents of the ticked lines for deletion?';
		|es = '¿Marcar los documentos de las líneas marcadas para eliminar?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОтменеДокументовСтрок(Ответ, ДокументыЗакупки) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ИзменитьСтатусДокументовСтрокНаСервере(ДокументыЗакупки, ДействиеОтменить());
		ОбновитьСписокЗаказов();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ИзменитьСтатусДокументовСтрокНаСервере(Знач ДокументыЗакупки, Знач Действие)

	Для Каждого Итог Из Обработки.АРМПроизводство.ИзменитьСтатусДокументовСтрок(ДокументыЗакупки, Действие, ТекущийЗаказ) Цикл
		Если Не ПустаяСтрока(Итог.Текст) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("%1: %2", Итог.Документ, Итог.Текст));
		КонецЕсли;
	КонецЦикла;
	ОбновитьТекущийЗаказНаСервере(ТекущийЗаказ);

КонецПроцедуры

// Данные строки таблицы нижней закладки для записи или удаления.
//
// Параметры:
//  ИмяТаблицы    - Строка - «ЗаказыПоставщику», «Поступления», «Выпуски» или «Отгрузки».
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - строка таблицы.
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента.
//
&НаСервере
Функция ДанныеСтрокиДокумента(ИмяТаблицы, СтрокаТаблицы)

	АРМ = Обработки.АРМПроизводство;
	ДанныеСтроки = АРМ.НовыеДанныеСтрокиДокумента();
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаТаблицы);
	ДанныеСтроки.Вид = ВидСтрокТаблицы(ИмяТаблицы);
	ДанныеСтроки.Заказ = ТекущийЗаказ;
	Если Не ЗначениеЗаполнено(ДанныеСтроки.Документ) Тогда
		ДанныеСтроки.Документ = Неопределено;
	КонецЕсли;
	Возврат ДанныеСтроки;

КонецФункции

&НаСервере
Процедура ЗаписатьСтрокуДокументаНаСервере(Знач ИмяТаблицы, Знач Идентификатор)

	Таблица = ЭтотОбъект[ИмяТаблицы];
	СтрокаТаблицы = Таблица.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат = Обработки.АРМПроизводство.ЗаписатьСтрокуДокумента(ДанныеСтрокиДокумента(ИмяТаблицы, СтрокаТаблицы));
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
	КонецЕсли;
	Если Не Результат.Успех И Не Результат.Перечитать И Не СтрокаТаблицы.Записана Тогда
		// Новая строка остаётся с причиной отказа; отвергнутая правка записанной строки откатывается перечитыванием.
		СтрокаТаблицы.Статус = ?(ПустаяСтрока(Результат.Текст), ТекстНеЗаписано(), Результат.Текст);
		Возврат;
	КонецЕсли;
	Если Результат.Успех И Не СтрокаТаблицы.Записана Тогда
		Таблица.Удалить(СтрокаТаблицы);
	КонецЕсли;
	ОбновитьТекущийЗаказНаСервере(ТекущийЗаказ);
	Если Не Результат.Успех Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура("Документ, НомерСтроки", Результат.Документ, Результат.НомерСтроки);
	Для Каждого Записанная Из Таблица.НайтиСтроки(Новый Структура("Документ", Результат.Документ)) Цикл
		Если Результат.СтрокиДокумента.Количество() > 0 Тогда
			Записанная.Статус = Результат.СтрокиДокумента[0].Статус;
		КонецЕсли;
		Если Записанная.НомерСтроки = Отбор.НомерСтроки Тогда
			Элементы[ИмяТаблицы].ТекущаяСтрока = Записанная.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиДокументовНаСервере(Знач ИмяТаблицы, Знач Идентификаторы)

	Таблица = ЭтотОбъект[ИмяТаблицы];
	СтрокиДанных = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		СтрокаТаблицы = Таблица.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы = Неопределено Тогда
			Продолжить;
		ИначеЕсли Не СтрокаТаблицы.Записана Тогда
			Таблица.Удалить(СтрокаТаблицы);
		ИначеЕсли СтрокаТаблицы.ТолькоПросмотр Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПравкаВФормеДокумента());
		Иначе
			СтрокиДанных.Добавить(ДанныеСтрокиДокумента(ИмяТаблицы, СтрокаТаблицы));
		КонецЕсли;
	КонецЦикла;
	Если СтрокиДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Результат Из Обработки.АРМПроизводство.УдалитьСтрокиДокументов(СтрокиДанных) Цикл
		Если Не ПустаяСтрока(Результат.Текст) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
		КонецЕсли;
	КонецЦикла;
	ОбновитьТекущийЗаказНаСервере(ТекущийЗаказ);

КонецПроцедуры

// Строки документов текущего заказа в таблицах формы: незаписанные строки того же заказа остаются в начале таблицы.
//
// Параметры:
//  Таблица              - ДанныеФормыКоллекция - таблица строк документов нижней закладки.
//  Строки               - Массив из Структура - см. Обработки.АРМПроизводство.СтрокиЗакупок.
//  СохранитьНезаписанные - Булево - заказ тот же: незаписанные строки не теряются.
//
&НаСервере
Процедура ЗагрузитьСтрокиДокументов(Таблица, Строки, СохранитьНезаписанные)

	Незаписанные = Таблица.Выгрузить(Новый Структура("Записана", Ложь));
	Таблица.Очистить();
	Если СохранитьНезаписанные Тогда
		Для Каждого Незаписанная Из Незаписанные Цикл
			ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Незаписанная);
		КонецЦикла;
	КонецЕсли;
	Для Каждого ДанныеСтроки Из Строки Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), ДанныеСтроки);
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Отбор - Структура - ИмяТаблицы, Заказ, Поставщик, ЗаказПоставщику, НомерВходящегоДокумента.
//
// Возвращаемое значение:
//  СписокЗначений - см. Обработки.АРМПроизводство.ДокументыСтрокиДляВыбора.
//
&НаСервереБезКонтекста
Функция ДокументыДляВыбора(Знач Отбор)

	АРМ = Обработки.АРМПроизводство;
	ДанныеСтроки = АРМ.НовыеДанныеСтрокиДокумента();
	ДанныеСтроки.Вид = ВидСтрокТаблицы(Отбор.ИмяТаблицы);
	ДанныеСтроки.Заказ = Отбор.Заказ;
	Если ТипЗнч(Отбор.Поставщик) = Тип("СправочникСсылка.Контрагенты") Тогда
		ДанныеСтроки.Поставщик = Отбор.Поставщик;
	КонецЕсли;
	Если ДанныеСтроки.Вид = АРМ.ВидПоступление() Тогда
		ДанныеСтроки.ЗаказПоставщику = Отбор.ЗаказПоставщику;
		ДанныеСтроки.НомерВходящегоДокумента = Отбор.НомерВходящегоДокумента;
	КонецЕсли;
	Если ТипЗнч(Отбор.Передача) = Тип("ДокументСсылка.ПередачаВПереработку") Тогда
		ДанныеСтроки.Передача = Отбор.Передача;
	КонецЕсли;
	Возврат АРМ.ДокументыСтрокиДляВыбора(ДанныеСтроки);

КонецФункции

&НаСервереБезКонтекста
Функция ПередачиЗаказаДляВыбора(Знач Заказ)

	Возврат Обработки.АРМПроизводство.ПередачиЗаказаДляВыбора(Заказ);

КонецФункции

&НаСервереБезКонтекста
Функция ПродукцияПередачиДляВыбора(Знач Передача, Знач Документ)

	Возврат Обработки.АРМПроизводство.ПродукцияПередачиДляВыбора(Передача, Документ);

КонецФункции

// «+ услуга переработки» на сервере: услуги документа строки, сообщение об отказе, строки заказа заново.
//
// Параметры:
//  Идентификатор - Число - строка таблицы «Поступления из переработки».
//  Сумма         - Число - стоимость услуг документа без НДС.
//
&НаСервере
Процедура УстановитьУслугиНаСервере(Знач Идентификатор, Знач Сумма)

	СтрокаТаблицы = ПоступленияПереработки.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДанныеСтроки = ДанныеСтрокиДокумента(Элементы.ПоступленияПереработки.Имя, СтрокаТаблицы);
	Результат = Обработки.АРМПроизводство.УстановитьУслугиПоступления(ДанныеСтроки, Сумма);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
	КонецЕсли;
	ОбновитьТекущийЗаказНаСервере(ТекущийЗаказ);

КонецПроцедуры

// Параметры:
//  ЭтоПродукция - Булево - колонка продукции; Ложь - колонка материала.
//
// Возвращаемое значение:
//  Структура - см. Справочники.Номенклатура.ДанныеПодбора.
//
&НаСервереБезКонтекста
Функция ДанныеПодбораНоменклатуры(Знач ЭтоПродукция)

	Каталог = Справочники.Номенклатура;
	Назначение = ?(ЭтоПродукция, Каталог.НазначениеПодбораПродукция(), Каталог.НазначениеПодбораМатериалы());
	Возврат Каталог.ДанныеПодбора(Назначение);

КонецФункции

// Параметры:
//  Заказ      - ДокументСсылка.ЗаказПокупателя - текущий заказ.
//  ИмяТаблицы - Строка - «Выпуски» или «Отгрузки».
//
// Возвращаемое значение:
//  СписокЗначений - см. Обработки.АРМПроизводство.ПродукцияЗаказаДляВыбора.
//
&НаСервереБезКонтекста
Функция ПродукцияЗаказаДляВыбора(Знач Заказ, Знач ИмяТаблицы)

	Возврат Обработки.АРМПроизводство.ПродукцияЗаказаДляВыбора(Заказ, ВидСтрокТаблицы(ИмяТаблицы));

КонецФункции

// Параметры:
//  ИмяТаблицы - Строка - имя таблицы строк документов нижней закладки.
//
// Возвращаемое значение:
//  Строка - вид документа строк, см. Обработки.АРМПроизводство.ВидЗаказПоставщику и другие.
//
&НаСервереБезКонтекста
Функция ВидСтрокТаблицы(Знач ИмяТаблицы)

	АРМ = Обработки.АРМПроизводство;
	Виды = Новый Структура;
	Виды.Вставить("ЗаказыПоставщику", АРМ.ВидЗаказПоставщику());
	Виды.Вставить("Поступления", АРМ.ВидПоступление());
	Виды.Вставить("Выпуски", АРМ.ВидВыпуск());
	Виды.Вставить("Отгрузки", АРМ.ВидОтгрузка());
	Виды.Вставить("Переработки", АРМ.ВидПередача());
	Виды.Вставить("ПоступленияПереработки", АРМ.ВидПоступлениеИзПереработки());
	Возврат Виды[ИмяТаблицы];

КонецФункции

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - рабочее место.
//
// Возвращаемое значение:
//  Структура - ключ - имя таблицы строк документов нижней закладки, значение - право вводить её строки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПраваВводаСтрок(Форма)

	Права = Новый Структура;
	Права.Вставить("ЗаказыПоставщику", Форма.МожноВводитьЗаказыПоставщику);
	Права.Вставить("Поступления", Форма.МожноВводитьПоступления);
	Права.Вставить("Выпуски", Форма.МожноВводитьВыпуски);
	Права.Вставить("Отгрузки", Форма.МожноВводитьОтгрузки);
	Права.Вставить("Переработки", Форма.МожноВводитьПереработку);
	Права.Вставить("ПоступленияПереработки", Форма.МожноВводитьПоступленияИзПереработки);
	Возврат Права;

КонецФункции

// Параметры:
//  ИмяТаблицы - Строка - имя таблицы строк документов нижней закладки.
//
// Возвращаемое значение:
//  Булево - таблица, строки которой вводятся с контрагентом-поставщиком: «Заказы поставщику», «Поступления»,
//           «Переработки» (переработчик).
//
&НаКлиенте
Функция ЭтоТаблицаЗакупок(ИмяТаблицы)

	Возврат ИмяТаблицы = Элементы.ЗаказыПоставщику.Имя Или ИмяТаблицы = Элементы.Поступления.Имя
		Или ИмяТаблицы = Элементы.Переработки.Имя;

КонецФункции

// Параметры:
//  ИмяТаблицы - Строка - имя таблицы строк.
//
// Возвращаемое значение:
//  Строка - колонка позиции строки: «Номенклатура» у «Продукции», «Продукция» у выпуска и отгрузки, «Материал» у закупок.
//
&НаКлиентеНаСервереБезКонтекста
Функция ИмяПозицииТаблицы(ИмяТаблицы)

	Если ИмяТаблицы = "Продукция" Тогда
		Возврат "Номенклатура";
	ИначеЕсли ИмяТаблицы = "Выпуски" Или ИмяТаблицы = "Отгрузки" Или ИмяТаблицы = "ПоступленияПереработки" Тогда
		Возврат "Продукция";
	Иначе
		Возврат "Материал";
	КонецЕсли;

КонецФункции

// Параметры:
//  ИмяТаблицы - Строка - имя таблицы строк документов нижней закладки.
//
// Возвращаемое значение:
//  ДокументСсылка - пустая ссылка документа строк таблицы: «Новый документ».
//
&НаКлиенте
Функция ПустойДокументТаблицы(ИмяТаблицы)

	Если ИмяТаблицы = Элементы.Поступления.Имя Тогда
		Возврат ПредопределенноеЗначение("Документ.ПоступлениеТоваровУслуг.ПустаяСсылка");
	ИначеЕсли ИмяТаблицы = Элементы.Выпуски.Имя Тогда
		Возврат ПредопределенноеЗначение("Документ.ВыпускПродукции.ПустаяСсылка");
	ИначеЕсли ИмяТаблицы = Элементы.Отгрузки.Имя Тогда
		Возврат ПредопределенноеЗначение("Документ.РеализацияТоваровУслуг.ПустаяСсылка");
	ИначеЕсли ИмяТаблицы = Элементы.Переработки.Имя Тогда
		Возврат ПредопределенноеЗначение("Документ.ПередачаВПереработку.ПустаяСсылка");
	ИначеЕсли ИмяТаблицы = Элементы.ПоступленияПереработки.Имя Тогда
		Возврат ПредопределенноеЗначение("Документ.ПоступлениеИзПереработки.ПустаяСсылка");
	Иначе
		Возврат ПредопределенноеЗначение("Документ.ЗаказПоставщику.ПустаяСсылка");
	КонецЕсли;

КонецФункции

// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - новая строка выпуска или отгрузки.
//  Значение      - Структура - см. Обработки.АРМПроизводство.ПродукцияЗаказаДляВыбора.
//
&НаКлиенте
Процедура ПрименитьПродукциюЗаказа(СтрокаТаблицы, Значение)

	СтрокаТаблицы.Продукция = Значение.Продукция;
	СтрокаТаблицы.Характеристика = Значение.Характеристика;
	СтрокаТаблицы.Упаковка = Значение.Упаковка;
	Если СтрокаТаблицы.КоличествоУпаковок = 0 Тогда
		СтрокаТаблицы.КоличествоУпаковок = Значение.КоличествоУпаковок;
	КонецЕсли;
	СтрокаТаблицы.ЦенаИзменена = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПродукцииЗаказа(ВыбранныйЭлемент, ДопПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = ЭтотОбъект[ДопПараметры.ИмяТаблицы].НайтиПоИдентификатору(ДопПараметры.Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПрименитьПродукциюЗаказа(СтрокаТаблицы, ВыбранныйЭлемент.Значение);
	ПодставитьДокументСтроки(ДопПараметры.ИмяТаблицы, СтрокаТаблицы);

КонецПроцедуры

