&НаКлиенте
Процедура ПереработкиПриАктивизацииСтроки(Элемент)

	ПриАктивизацииСтрокиДокумента(Элемент);
	// Свойства ПФ/ГП перечитываются после паузы: листание строк не должно дёргать сервер на каждой.
	// BSLLS:MagicNumber-off - пауза перед перечитыванием свойств, секунды.
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьСвойстваПродукции", 0.2, Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// ПФ/ГП строки передачи меняет таблицу свойств справа.
//
// Параметры:
//  Элемент - ПолеФормы - колонка «ПФ/ГП».
//
&НаКлиенте
Процедура ПереработкиПродукцияПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.Переработки.ТекущиеДанные;
	Если СтрокаТаблицы <> Неопределено Тогда
		// Смена ПФ/ГП - его норма, в том числе 0: количество прежнего ПФ/ГП не остаётся.
		СтрокаТаблицы.КоличествоПродукции = НормаПродукцииПередачи(ТекущийЗаказ, СтрокаТаблицы.Материал,
			СтрокаТаблицы.Характеристика, СтрокаТаблицы.Упаковка, СтрокаТаблицы.КоличествоУпаковок, СтрокаТаблицы.Продукция);
	КонецЕсли;
	ОбновитьСвойстваПродукции();

КонецПроцедуры

// ПФ/ГП строки - только из заказа: прямые родители материала строки в дереве материалов заказа или продукция строк
// товаров (Документы.ПередачаВПереработку.ДопустимаяПродукцияМатериала).
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «ПФ/ГП».
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - выбор из справочника отключается.
//
&НаКлиенте
Процедура ПереработкиПродукцияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элементы.Переработки.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Список = ДопустимаяПродукцияМатериала(ТекущийЗаказ, СтрокаТаблицы.Материал);
	Если Список.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'У материала нет ПФ/ГП в заказе.';
			|fr = 'La matière n''a pas de semi-fini / produit fini dans la commande.';
			|en = 'The material has no semi-finished / finished product in the order.';
			|es = 'El material no tiene semielaborado / producto terminado en el pedido.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПФГППередачи", ЭтотОбъект, Элементы.Переработки.ТекущаяСтрока);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);

КонецПроцедуры

// Параметры:
//  Выбранный     - ЭлементСпискаЗначений, Неопределено - выбранный ПФ/ГП.
//  Идентификатор - Число - идентификатор строки передачи.
//
&НаКлиенте
Процедура ПослеВыбораПФГППередачи(Выбранный, Идентификатор) Экспорт

	Если Выбранный = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Переработки.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Продукция = Выбранный.Значение;
	// Норма подставляется при выборе ПФ/ГП (решение владельца 2026-10-06: по норме, можно править).
	СтрокаТаблицы.КоличествоПродукции = НормаПродукцииПередачи(ТекущийЗаказ, СтрокаТаблицы.Материал,
		СтрокаТаблицы.Характеристика, СтрокаТаблицы.Упаковка, СтрокаТаблицы.КоличествоУпаковок, СтрокаТаблицы.Продукция);
	ОбновитьСвойстваПродукции();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСвойстваПродукции

// Поле значения принимает тип свойства строки; значения доп. справочника - только этого свойства.
//
// Параметры:
//  Элемент       - ТаблицаФормы - свойства ПФ/ГП.
//  НоваяСтрока   - Булево - не используется: строки не добавляются.
//  Копирование   - Булево - не используется.
//
&НаКлиенте
Процедура СвойстваПродукцииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Поле = Элементы.СвойстваПродукцииЗначение;
	Поле.ОграничениеТипа = ТекущиеДанные.ТипЗначения;
	ПараметрыВыбора = Новый Массив;
	Если ТекущиеДанные.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияДополнительныхРеквизитов")) Тогда
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ТекущиеДанные.Свойство));
	КонецЕсли;
	Поле.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);

КонецПроцедуры

// Новое значение свойства сразу пишется в карточку ПФ/ГП (решение владельца 2026-10-05: значения хранятся в карточке
// номенклатуры и видны везде, где она используется). Отказ - сообщение и прежнее значение.
//
// Параметры:
//  Элемент - ПолеФормы - колонка «Значение».
//
&НаКлиенте
Процедура СвойстваПродукцииЗначениеПриИзменении(Элемент)

	ТекущиеДанные = Элементы.СвойстваПродукции.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Заказ и ПФ/ГП сервер берёт из записанной строки передачи, а не отсюда (ревью безопасности 2.0.16.16).
	СтрокаПередачи = Элементы.Переработки.ТекущиеДанные;
	Передача = ?(СтрокаПередачи = Неопределено, Неопределено, СтрокаПередачи.Документ);
	НомерСтроки = ?(СтрокаПередачи = Неопределено, 0, СтрокаПередачи.НомерСтроки);
	Результат = ЗаписатьСвойствоПродукции(Передача, НомерСтроки, ПродукцияСвойств, ТекущиеДанные.Свойство,
		ТекущиеДанные.Значение);
	Если Не Результат.Успех Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
		ОбновитьСвойстваПродукции(Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоступленияПереработки

