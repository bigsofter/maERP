Процедура ПоступленияПереработкиПриАктивизацииСтроки(Элемент)

	ПриАктивизацииСтрокиДокумента(Элемент);

КонецПроцедуры

// Колонка «Передача» новой строки: проведённые передачи заказа, по которым ещё ожидается продукция (S6).
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «Передача».
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - отключается.
//
&НаКлиенте
Процедура ПоступленияПереработкиПередачаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элементы.ПоступленияПереработки.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	Список = ПередачиЗаказаДляВыбора(ТекущийЗаказ);
	Если Список.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'У заказа нет проведённых передач в переработку с ожидаемой продукцией.';
			|fr = 'La commande n''a pas de transfert de sous-traitance validé avec des produits attendus.';
			|en = 'The order has no posted subcontracting transfers with expected products.';
			|es = 'El pedido no tiene envíos a subcontratista contabilizados con productos esperados.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПередачиПоступления", ЭтотОбъект,
		Элементы.ПоступленияПереработки.ТекущаяСтрока);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПередачиПоступления(ВыбранныйЭлемент, Идентификатор) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = ПоступленияПереработки.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	ПрименитьПередачуПоступления(СтрокаТаблицы, ВыбранныйЭлемент.Значение);

КонецПроцедуры

// Передача новой строки поступления: переработчик и склад - из неё; продукция другой передачи к ней не относится.
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - новая строка «Поступлений из переработки».
//  Значение      - Структура - Передача, Поставщик, Склад.
//
&НаКлиенте
Процедура ПрименитьПередачуПоступления(СтрокаТаблицы, Значение)

	Если СтрокаТаблицы.Передача <> Значение.Передача Тогда
		СтрокаТаблицы.Продукция = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
		СтрокаТаблицы.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
		СтрокаТаблицы.Упаковка = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
		СтрокаТаблицы.КоличествоУпаковок = 0;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Значение, "Передача, Поставщик, Склад");
	ПодставитьДокументСтроки(Элементы.ПоступленияПереработки.Имя, СтрокаТаблицы);

КонецПроцедуры

// Колонка «Продукция» строки поступления: ожидаемая продукция передачи с остатком к приёму.
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «Продукция».
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - отключается.
//
&НаКлиенте
Процедура ПоступленияПереработкиПродукцияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элементы.ПоступленияПереработки.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Передача) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСначалаПередача());
		Возврат;
	КонецЕсли;
	Список = ПродукцияПередачиДляВыбора(СтрокаТаблицы.Передача, СтрокаТаблицы.Документ);
	ДопПараметры = Новый Структура("ИмяТаблицы, Идентификатор", Элементы.ПоступленияПереработки.Имя,
		Элементы.ПоступленияПереработки.ТекущаяСтрока);
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПродукцииПередачи", ЭтотОбъект, ДопПараметры);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);

КонецПроцедуры

// Продукция, набранная руками: упаковка, количество по умолчанию и процент потерь - из ожидаемой по передаче.
//
// Параметры:
//  Элемент - ПолеФормы - колонка «Продукция».
//
&НаКлиенте
Процедура ПоступленияПереработкиПродукцияПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.ПоступленияПереработки.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	СтрокаТаблицы.Упаковка = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Продукция) Или Не ЗначениеЗаполнено(СтрокаТаблицы.Передача) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ЭлементСписка Из ПродукцияПередачиДляВыбора(СтрокаТаблицы.Передача, СтрокаТаблицы.Документ) Цикл
		Если ЭлементСписка.Значение.Продукция = СтрокаТаблицы.Продукция Тогда
			ПрименитьПродукциюПередачи(СтрокаТаблицы, ЭлементСписка.Значение);
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПродукцииПередачи(ВыбранныйЭлемент, ДопПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = ЭтотОбъект[ДопПараметры.ИмяТаблицы].НайтиПоИдентификатору(ДопПараметры.Идентификатор);
	Если СтрокаТаблицы <> Неопределено Тогда
		ПрименитьПродукциюПередачи(СтрокаТаблицы, ВыбранныйЭлемент.Значение);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - строка «Поступлений из переработки».
//  Значение      - Структура - см. Обработки.АРМПроизводство.ПродукцияПередачиДляВыбора.
//
&НаКлиенте
Процедура ПрименитьПродукциюПередачи(СтрокаТаблицы, Значение)

	СтрокаТаблицы.Продукция = Значение.Продукция;
	СтрокаТаблицы.Характеристика = Значение.Характеристика;
	СтрокаТаблицы.Упаковка = Значение.Упаковка;
	СтрокаТаблицы.ПроцентПотерь = Значение.ПроцентПотерь;
	Если СтрокаТаблицы.КоличествоУпаковок = 0 Тогда
		СтрокаТаблицы.КоличествоУпаковок = Значение.КоличествоУпаковок;
	КонецЕсли;

КонецПроцедуры

