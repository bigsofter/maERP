// Параметры:
//  ИмяТаблицы - Строка - имя таблицы строк документов нижней закладки.
//
// Возвращаемое значение:
//  Строка - текст незаполненной строки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ТекстЗаполнитеСтроку(ИмяТаблицы)

	Если ИмяТаблицы = "ПоступленияПереработки" Тогда
		Возврат НСтр("ru = 'Строка не записана: укажите передачу в переработку, продукцию и количество.';
			|fr = 'Ligne non enregistrée : indiquez le transfert de sous-traitance, le produit et la quantité.';
			|en = 'Line not saved: specify the subcontracting transfer, product and quantity.';
			|es = 'Línea no guardada: indique el envío a subcontratista, el producto y la cantidad.'");
	ИначеЕсли ИмяТаблицы = "Переработки" Тогда
		Возврат НСтр("ru = 'Строка не записана: укажите переработчика, материал и количество.';
			|fr = 'Ligne non enregistrée : indiquez le sous-traitant, la matière et la quantité.';
			|en = 'Line not saved: specify the processor, material and quantity.';
			|es = 'Línea no guardada: indique el procesador, el material y la cantidad.'");
	ИначеЕсли ИмяТаблицы = "ЗаказыПоставщику" Или ИмяТаблицы = "Поступления" Тогда
		Возврат НСтр("ru = 'Строка не записана: укажите поставщика, материал и количество.';
			|fr = 'Ligne non enregistrée : indiquez le fournisseur, la matière et la quantité.';
			|en = 'Line not saved: specify the supplier, material and quantity.';
			|es = 'Línea no guardada: indique el proveedor, el material y la cantidad.'");
	Иначе
		Возврат НСтр("ru = 'Строка не записана: укажите продукцию и количество.';
			|fr = 'Ligne non enregistrée : indiquez le produit et la quantité.';
			|en = 'Line not saved: specify the product and quantity.';
			|es = 'Línea no guardada: indique el producto y la cantidad.'");
	КонецЕсли;

КонецФункции

