&НаКлиенте
Процедура ОткрытьПотребности(Команда)

	Если Не ВыбратьЗаказДляОснования() Тогда
		Возврат;
	КонецЕсли;
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Отбор", Новый Структура("Заказ", ТекущийЗаказ));
	ПараметрыОтчета.Вставить("СформироватьПриОткрытии", Истина);
	ОткрытьФорму("Отчет.ПотребностиПроизводства.Форма", ПараметрыОтчета, ЭтотОбъект, ТекущийЗаказ);

КонецПроцедуры

