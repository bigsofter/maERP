#Область ОписаниеПеременных

// Последний черновик, в который записана строка клиента: ключ - клиент, значение - Структура Заказ, ЗаказПредставление.
&НаКлиенте
Перем ПоследниеЧерновики;

// Идентификатор строки, вставленной в начало таблицы и ещё не введённой.
&НаКлиенте
Перем ВставленнаяСтрока;

// Имя таблицы формы, в которую вставлена ВставленнаяСтрока.
&НаКлиенте
Перем ВставленнаяТаблица;

// Незаполненная строка документа, с которой пользователь ещё не ушёл: имя таблицы и идентификатор строки.
// Пока он в строке, о незаполненном не сообщаем - иначе каждое завершение редактирования ячейки (Enter)
// повторяет замечание, хотя ввод ещё идёт. Сообщение выдаётся один раз, когда строка действительно покинута
// (ПриАктивизацииСтрокиДокумента).
&НаКлиенте
Перем НезаполненнаяТаблица;

// Идентификатор незаполненной строки в таблице НезаполненнаяТаблица.
&НаКлиенте
Перем НезаполненнаяСтрока;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПоказыватьСуммы = Обработки.АРМПроизводство.ПоказыватьСуммы();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Обработки.АРМПроизводство.ПраваРабочегоМеста());
	НастроитьЭлементы();
	УстановитьУсловноеОформление();
	НастроитьЗакладкуСтанков();
	НомерСтраницы = 1;
	УстановитьПараметрыСписка();
	ПрименитьСостояниеПанели(ЭтотОбъект);
	// Сохранённые настройки перечитают «Продукцию» в ПриЗагрузкеДанныхИзНастроекНаСервере.
	Если Не ЕстьСохраненныеНастройки() Тогда
		ЗагрузитьПродукцию();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Страховка: если сохранённые настройки найдены, а загрузка из них не пришла, «Продукция» перечитывается здесь.
	Если Продукция.Количество() = 0 Тогда
		ЗагрузитьПродукцию();
	КонецЕсли;
	// Восстановленная из настроек закладка «Станки» заполняется сразу.
	Если Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаСтанки Тогда
		ПриСменеСтраницыВерх();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	// Сохранённое состояние панели восстанавливается после ПриСозданииНаСервере: отборы и панель - заново.
	УстановитьПараметрыСписка();
	ПрименитьСостояниеПанели(ЭтотОбъект);
	ЗагрузитьПродукцию();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Отборы панели фильтров одни для обеих закладок: список заказов получает параметры и отбор, «Продукция» перечитывается.
//
// Параметры:
//  Элемент - ПолеФормы - изменённое поле фильтра.
//
&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	НомерСтраницы = 1;
	ПрименитьОтборыНаСервере();
	ОбновитьТекущийЗаказ();

КонецПроцедуры

&НаКлиенте
Процедура ГруппаВерхПриСменеСтраницы(Элемент, ТекущаяСтраница)

	ПриСменеСтраницыВерх();

КонецПроцедуры

&НаКлиенте
Процедура НеделяСтанковПриИзменении(Элемент)

	ОбновитьСтанкиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СтанкиСостояниеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка = СтанкиСостояние.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Щелчок по «Сейчас» открывает загрузку на станке, по остальным колонкам - станок.
	Значение = ?(Поле = Элементы.СтанкиСостояниеСостояние И ЗначениеЗаполнено(Строка.Требование), Строка.Требование,
		Строка.Станок);
	ПоказатьЗначение(, Значение);

КонецПроцедуры

&НаКлиенте
Процедура СтанкиСостояниеПриАктивизацииСтроки(Элемент)

	// Время в «Готовых к запуску» считается на выбранном станке.
	ЗадержкаСекунд = 0.3;
	ПодключитьОбработчикОжидания("ОбновитьГотовыеКЗапуску", ЗадержкаСекунд, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ГотовыеКЗапускуВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка = ГотовыеКЗапуску.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка <> Неопределено Тогда
		ПоказатьЗначение(, Строка.Заказ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТребованияСтанковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка = ТребованияСтанков.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка <> Неопределено Тогда
		ПоказатьЗначение(, Строка.Требование);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикСтанковВыбор(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Для Каждого ЭлементПланировщика Из Элемент.ВыделенныеЭлементы Цикл
		Если ЗначениеЗаполнено(ЭлементПланировщика.Значение) Тогда
			ПоказатьЗначение(, ЭлементПланировщика.Значение);
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикСтанковПередСозданием(Элемент, Начало, Конец, ЗначенияИзмерений, Текст, СтандартнаяОбработка)

	// Загрузка создаётся «Разместить» или перетаскиванием строки «Готовых к запуску», обслуживание - кнопкой.
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикСтанковПередУдалением(Элемент, Отказ)

	// Загрузку отменяют «Отменить», документ обслуживания - в его форме.
	Отказ = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикСтанковПриОкончанииРедактирования(Элемент, НовыйЭлемент, ОтменаРедактирования)

	// Перетаскивание или растяжение элемента: документ меняется сервером (смена, шаг, сверка с фактом, проведение); элементы
	// перечитываются из базы в любом случае - положение на планировщике всегда то, что записано.
	ОтменаРедактирования = Истина;
	Если НовыйЭлемент Или Не МожноРазмещатьНаСтанки Тогда
		Возврат;
	КонецЕсли;
	Переносы = Новый Массив;
	Для Каждого ЭлементПланировщика Из Элемент.ВыделенныеЭлементы Цикл
		// Черновик автоплана без документа не переносится (ревью плана волны 5, P3-13).
		Если Не ЗначениеЗаполнено(ЭлементПланировщика.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Перенос = Новый Структура("Документ, Станок, Начало", ЭлементПланировщика.Значение,
			ЭлементПланировщика.ЗначенияИзмерений.Получить("Станок"), ЭлементПланировщика.Начало);
		Перенос.Вставить("Окончание", ЭлементПланировщика.Конец);
		Переносы.Добавить(Перенос);
	КонецЦикла;
	Если Переносы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ТекстОшибки = ПеренестиЗагрузкиНаСервере(Переносы);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикСтанковПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Дата,
	ЗначенияИзмерений)

	Если ИдентификаторГотовой(ПараметрыПеретаскивания.Значение) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Если МожноРазмещатьНаСтанки Тогда
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
	Иначе
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикСтанковПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Дата, ЗначенияИзмерений)

	Идентификатор = ИдентификаторГотовой(ПараметрыПеретаскивания.Значение);
	Если Идентификатор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Станок = ?(ЗначенияИзмерений = Неопределено, Неопределено, ЗначенияИзмерений.Получить("Станок"));
	Если Не МожноРазмещатьНаСтанки Или Не ЗначениеЗаполнено(Станок) Тогда
		Возврат;
	КонецЕсли;
	ЗапроситьКоличествоРазмещения(Идентификатор, Станок, Дата);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказы

&НаКлиенте
Процедура ЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	// Ключ строки списка с основной таблицей - сама ссылка (урок 2.0.15.10, forms-011).
	Если ТипЗнч(Элемент.ТекущаяСтрока) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ОткрытьДокумент(Элемент.ТекущаяСтрока);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПриАктивизацииСтроки(Элемент)

	ЗадержкаСекунд = 0.2;
	ПодключитьОбработчикОжидания("ОбновитьТекущийЗаказ", ЗадержкаСекунд, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПродукция

&НаКлиенте
Процедура ПродукцияПриАктивизацииСтроки(Элемент)

	ЗадержкаСекунд = 0.2;
	ПодключитьОбработчикОжидания("ОбновитьТекущийЗаказ", ЗадержкаСекунд, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	// Новая строка - в начало таблицы (решение владельца 2026-09-15): платформа добавила бы её в конец, поэтому строка
	// вставляется здесь, копия - со значениями текущей строки.
	Отказ = Истина;
	Если Не МожноМенятьЗаказы Тогда
		Возврат;
	КонецЕсли;
	УдалитьПустуюВставленнуюСтроку();
	НоваяСтрока = Продукция.Вставить(0);
	Если Копирование И Элемент.ТекущиеДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент.ТекущиеДанные);
		ПодготовитьНовуюСтроку(НоваяСтрока, Истина);
	Иначе
		ПодготовитьНовуюСтроку(НоваяСтрока, Ложь);
	КонецЕсли;
	ВставленнаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	ВставленнаяТаблица = Элемент.Имя;
	Элемент.ТекущаяСтрока = ВставленнаяСтрока;
	// Ввод начинается после выхода из обработчика: внутри него платформа ещё завершает отменённое добавление.
	ЗадержкаСекунд = 0.1;
	ПодключитьОбработчикОжидания("НачатьВводВставленнойСтроки", ЗадержкаСекунд, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПередНачаломИзменения(Элемент, Отказ)

	ОчиститьСообщения();
	ТекущаяСтрокаПродукции = Элемент.ТекущиеДанные;
	Если ТекущаяСтрокаПродукции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не МожноМенятьЗаказы Или Не ТекущаяСтрокаПродукции.Редактируется Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСтрокаТолькоДляЧтения());
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПередУдалением(Элемент, Отказ)

	// Удаление - одним серверным вызовом по всем выделенным строкам: платформа сама удалила бы из таблицы все строки,
	// а из заказов - ни одной.
	Отказ = Истина;
	Если Не МожноМенятьЗаказы Или Элемент.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		Идентификаторы.Добавить(Идентификатор);
	КонецЦикла;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдалении", ЭтотОбъект, Идентификаторы);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить выделенные строки из заказов?';
		|fr = 'Supprimer les lignes sélectionnées des commandes ?';
		|en = 'Delete the selected lines from the orders?';
		|es = '¿Eliminar las líneas seleccionadas de los pedidos?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ОчиститьСообщения();
	ТекущаяСтрокаПродукции = Элемент.ТекущиеДанные;
	Если ТекущаяСтрокаПродукции = Неопределено Или Не ТекущаяСтрокаПродукции.Редактируется Тогда
		Возврат;
	КонецЕсли;
	Вставлена = ВставленнаяСтрока <> Неопределено И ВставленнаяТаблица = Элемент.Имя
		И Элемент.ТекущаяСтрока = ВставленнаяСтрока;
	Если Вставлена Тогда
		ВставленнаяСтрока = Неопределено;
	КонецЕсли;
	Если ОтменаРедактирования Тогда
		// Строку вставил ПродукцияПередНачаломДобавления, поэтому отказ от её ввода платформа сама не отменяет.
		Если Вставлена И Не ТекущаяСтрокаПродукции.Записана Тогда
			Продукция.Удалить(ТекущаяСтрокаПродукции);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущаяСтрокаПродукции.Клиент) Или Не ЗначениеЗаполнено(ТекущаяСтрокаПродукции.Номенклатура)
		Или ТекущаяСтрокаПродукции.КоличествоУпаковок <= 0 Тогда
		ТекущаяСтрокаПродукции.СтатусДокумента = ТекстНеЗаписано();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Строка не записана: укажите клиента, продукцию и количество.';
			|fr = 'Ligne non enregistrée : indiquez le client, le produit et la quantité.';
			|en = 'Line not saved: specify the customer, product and quantity.';
			|es = 'Línea no guardada: indique el cliente, el producto y la cantidad.'"));
		Возврат;
	КонецЕсли;
	Черновик = ЗаписатьСтрокуНаСервере(Элемент.ТекущаяСтрока);
	Если Черновик <> Неопределено Тогда
		Если ПоследниеЧерновики = Неопределено Тогда
			ПоследниеЧерновики = Новый Соответствие;
		КонецЕсли;
		ПоследниеЧерновики.Вставить(Черновик.Клиент, Черновик);
	КонецЕсли;
	ПослеЗаписиЗаказов();

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияЗаказПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ОчиститьСообщения();
	СтандартнаяОбработка = Ложь;
	ТекущаяСтрокаПродукции = Элементы.Продукция.ТекущиеДанные;
	Если ТекущаяСтрокаПродукции = Неопределено Или ТекущаяСтрокаПродукции.Записана Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущаяСтрокаПродукции.Клиент) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Сначала укажите клиента.';
			|fr = 'Indiquez d''abord le client.'; en = 'Specify the customer first.'; es = 'Indique primero el cliente.'"));
		Возврат;
	КонецЕсли;
	Список = ЧерновикиКлиента(ТекущаяСтрокаПродукции.Клиент);
	Список.Вставить(0, ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка"), ТекстНовыйЗаказ());
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораЧерновика", ЭтотОбъект, Элементы.Продукция.ТекущаяСтрока);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияКлиентПриИзменении(Элемент)

	// Первая строка клиента создаёт черновик, следующие по умолчанию идут в черновик, куда в этом сеансе рабочего места
	// последний раз записана строка клиента. Пока записей не было - «Новый заказ»: выбор среди черновиков - кнопкой.
	ТекущаяСтрокаПродукции = Элементы.Продукция.ТекущиеДанные;
	ТекущаяСтрокаПродукции.Заказ = ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка");
	ТекущаяСтрокаПродукции.ЗаказПредставление = ТекстНовыйЗаказ();
	ТекущаяСтрокаПродукции.ВерсияДанных = "";
	Черновик = ЧерновикКлиентаПоУмолчанию(ТекущаяСтрокаПродукции.Клиент);
	Если Черновик <> Неопределено Тогда
		ТекущаяСтрокаПродукции.Заказ = Черновик.Заказ;
		ТекущаяСтрокаПродукции.ЗаказПредставление = Черновик.ЗаказПредставление;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияНоменклатураПриИзменении(Элемент)

	ПослеСменыНоменклатурыПродукции(Элементы.Продукция.ТекущиеДанные);

КонецПроцедуры

// Колонка «Продукция» (S7): последние созданные готовая продукция и полуфабрикаты и выбор из справочника с отбором по
// типу. Обработчик привязан в НастроитьЭлементы: форма рабочего места не правится руками (генератор, README).
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «Продукция».
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - отключается.
//
&НаКлиенте
Процедура Подключаемый_ПродукцияНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Элементы.Продукция.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеПодбораПродукции", ЭтотОбъект, Элементы.Продукция.ТекущаяСтрока);
	ДанныеПодбора = ДанныеПодбораНоменклатуры(Истина);
	РаботаСДокументамиКлиент.ПоказатьПодборНоменклатуры(ЭтотОбъект, Элемент, ДанныеПодбора, Оповещение,
		Элементы.Продукция.ТекущиеДанные.Номенклатура);

КонецПроцедуры

// Параметры:
//  Значение      - Структура - Номенклатура, Характеристика, см. РаботаСДокументамиКлиент.ПоказатьПодборНоменклатуры.
//  Идентификатор - Число - идентификатор строки «Продукции».
//
&НаКлиенте
Процедура ПослеПодбораПродукции(Значение, Идентификатор) Экспорт

	СтрокаТаблицы = Продукция.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Номенклатура = Значение.Номенклатура;
	ПослеСменыНоменклатурыПродукции(СтрокаТаблицы);

КонецПроцедуры

// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - строка «Продукции» со сменённой номенклатурой.
//
&НаКлиенте
Процедура ПослеСменыНоменклатурыПродукции(СтрокаТаблицы)

	СтрокаТаблицы.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	СтрокаТаблицы.Упаковка = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
	СтрокаТаблицы.ЦенаИзменена = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияЦенаПриИзменении(Элемент)

	Элементы.Продукция.ТекущиеДанные.ЦенаИзменена = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументыЗаказа

&НаКлиенте
Процедура ДокументыЗаказаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(Элемент.ТекущиеДанные.Документ) Тогда
		ОткрытьДокумент(Элемент.ТекущиеДанные.Документ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказыПоставщику

&НаКлиенте
Процедура ЗаказыПоставщикуПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	ПередДобавлениемСтрокиДокумента(Элемент, Отказ, Копирование);

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПоставщикуПередНачаломИзменения(Элемент, Отказ)

	ПередИзменениемСтрокиДокумента(Элемент, Отказ);

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПоставщикуПередУдалением(Элемент, Отказ)

	ПередУдалениемСтрокДокументов(Элемент, Отказ);

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПоставщикуПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ПриОкончанииРедактированияСтрокиДокумента(Элемент, ОтменаРедактирования);

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПоставщикуВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ОткрытьДокументСтроки(Элемент, Поле, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПоставщикуПриАктивизацииСтроки(Элемент)

	ПриАктивизацииСтрокиДокумента(Элемент);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоступления

&НаКлиенте
Процедура ПоступленияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	ПередДобавлениемСтрокиДокумента(Элемент, Отказ, Копирование);

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПередНачаломИзменения(Элемент, Отказ)

	ПередИзменениемСтрокиДокумента(Элемент, Отказ);

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПередУдалением(Элемент, Отказ)

	ПередУдалениемСтрокДокументов(Элемент, Отказ);

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ПриОкончанииРедактированияСтрокиДокумента(Элемент, ОтменаРедактирования);

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ОткрытьДокументСтроки(Элемент, Поле, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПриАктивизацииСтроки(Элемент)

	ПриАктивизацииСтрокиДокумента(Элемент);

КонецПроцедуры

// Поставщик новой строки закупки: документ и заказ поставщику - как у ближайшей записанной строки ниже того же
// поставщика (решение владельца 10).
//
// Параметры:
//  Элемент - ПолеФормы - колонка «Поставщик» таблицы закупок.
//
&НаКлиенте
Процедура ЗакупкиПоставщикПриИзменении(Элемент)

	Таблица = Элемент.Родитель;
	Если Таблица.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПодставитьДокументСтроки(Таблица.Имя, Таблица.ТекущиеДанные);

КонецПроцедуры

// Параметры:
//  Элемент - ПолеФормы - колонка «Материал» таблицы закупок.
//
&НаКлиенте
Процедура ЗакупкиМатериалПриИзменении(Элемент)

	Таблица = Элемент.Родитель;
	Если Таблица.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Таблица.Имя = Элементы.Переработки.Имя Тогда
		// ПФ/ГП подбирается к материалу: у другого материала прежний может быть недопустим.
		Таблица.ТекущиеДанные.Продукция = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
		Таблица.ТекущиеДанные.КоличествоПродукции = 0;
		ОбновитьСвойстваПродукции();
	КонецЕсли;
	ПослеСменыМатериала(Таблица.Имя, Таблица.ТекущиеДанные,
		ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка"));

КонецПроцедуры

// Колонка «Материал» закупок и переработки (S7): материалы текущего заказа с количеством к закупке, выбор из
// справочника с отбором по типу и из всей номенклатуры. Обработчик привязан в НастроитьЭлементы.
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «Материал».
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - отключается.
//
&НаКлиенте
Процедура Подключаемый_ЗакупкиМатериалНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Таблица = Элемент.Родитель;
	Если Таблица.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДанныеПодбора = ДанныеПодбораНоменклатуры(Ложь);
	ДанныеПодбора.Пункты = МатериалыЗаказаДляПодбора(Таблица.Имя);
	ДопПараметры = Новый Структура("ИмяТаблицы, Идентификатор", Таблица.Имя, Таблица.ТекущаяСтрока);
	Оповещение = Новый ОписаниеОповещения("ПослеПодбораМатериала", ЭтотОбъект, ДопПараметры);
	РаботаСДокументамиКлиент.ПоказатьПодборНоменклатуры(ЭтотОбъект, Элемент, ДанныеПодбора, Оповещение,
		Таблица.ТекущиеДанные.Материал);

КонецПроцедуры

// Параметры:
//  Значение     - Структура - Номенклатура, Характеристика, см. РаботаСДокументамиКлиент.ПоказатьПодборНоменклатуры.
//  ДопПараметры - Структура - ИмяТаблицы, Идентификатор строки.
//
&НаКлиенте
Процедура ПослеПодбораМатериала(Значение, ДопПараметры) Экспорт

	СтрокаТаблицы = ЭтотОбъект[ДопПараметры.ИмяТаблицы].НайтиПоИдентификатору(ДопПараметры.Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Материал = Значение.Номенклатура;
	ПослеСменыМатериала(ДопПараметры.ИмяТаблицы, СтрокаТаблицы, Значение.Характеристика);

КонецПроцедуры

// Материал новой строки: количество по умолчанию - дефицит или остаток к поступлению материала по всем изделиям,
// поставщик - основной поставщик материала, у поступления - единственная подходящая строка заказа поставщику.
//
// Параметры:
//  ИмяТаблицы     - Строка - «ЗаказыПоставщику», «Поступления» или «Переработки».
//  СтрокаТаблицы  - ДанныеФормыЭлементКоллекции - строка со сменённым материалом.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика материала: из материалов заказа при
//                   выборе из списка, иначе пустая.
//
&НаКлиенте
Процедура ПослеСменыМатериала(ИмяТаблицы, СтрокаТаблицы, Характеристика)

	СтрокаТаблицы.Характеристика = Характеристика;
	СтрокаТаблицы.Упаковка = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
	СтрокаТаблицы.ЦенаИзменена = Ложь;
	ЭтоПереработка = ИмяТаблицы = Элементы.Переработки.Имя;
	Если Не ЭтоПереработка И Не ЗначениеЗаполнено(СтрокаТаблицы.Поставщик) И ЗначениеЗаполнено(СтрокаТаблицы.Материал) Тогда
		СтрокаТаблицы.Поставщик = ОсновнойПоставщикМатериала(СтрокаТаблицы.Материал);
		ПодставитьДокументСтроки(ИмяТаблицы, СтрокаТаблицы);
	КонецЕсли;
	Если СтрокаТаблицы.КоличествоУпаковок = 0 Тогда
		СтрокаТаблицы.КоличествоУпаковок = КоличествоМатериала(СтрокаТаблицы.Материал, СтрокаТаблицы.Характеристика,
			КолонкаКоличестваМатериала(ИмяТаблицы));
	КонецЕсли;
	Если ИмяТаблицы = Элементы.Поступления.Имя Тогда
		ПодобратьСтрокуОснования(СтрокаТаблицы);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗакупкиХарактеристикаПриИзменении(Элемент)

	Таблица = Элемент.Родитель;
	Если Таблица.ТекущиеДанные <> Неопределено И Таблица.Имя = Элементы.Поступления.Имя Тогда
		ПодобратьСтрокуОснования(Таблица.ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

// Номер накладной новой строки поступления: документ подбирается заново по поставщику, основанию и накладной.
//
// Параметры:
//  Элемент - ПолеФормы - колонка «Номер накладной».
//
&НаКлиенте
Процедура ПоступленияНомерВходящегоДокументаПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.Поступления.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	// Дата накладной следует за номером: подставленная дата прежней накладной к новой не относится.
	СтрокаТаблицы.ДатаВходящегоДокумента = Дата(1, 1, 1);
	ПодставитьДокументСтроки(Элементы.Поступления.Имя, СтрокаТаблицы);

КонецПроцедуры

&НаКлиенте
Процедура СтрокиДокументовЦенаПриИзменении(Элемент)

	Если Элемент.Родитель.ТекущиеДанные <> Неопределено Тогда
		Элемент.Родитель.ТекущиеДанные.ЦенаИзменена = Истина;
	КонецЕсли;

КонецПроцедуры

// Колонка «Документ» новой строки: сегодняшние документы заказа (у закупок - того же поставщика) или «Новый».
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «Документ».
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - отключается.
//
&НаКлиенте
Процедура СтрокиДокументовДокументПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ОчиститьСообщения();
	СтандартнаяОбработка = Ложь;
	Таблица = Элемент.Родитель;
	СтрокаТаблицы = Таблица.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоТаблицаЗакупок(Таблица.Имя) И Не ЗначениеЗаполнено(СтрокаТаблицы.Поставщик) Тогда
		Если Таблица.Имя = Элементы.Переработки.Имя Тогда
			Текст = НСтр("ru = 'Сначала укажите переработчика.'; fr = 'Indiquez d''abord le sous-traitant.';
				|en = 'Specify the processor first.'; es = 'Indique primero el procesador.'");
		Иначе
			Текст = НСтр("ru = 'Сначала укажите поставщика.'; fr = 'Indiquez d''abord le fournisseur.';
				|en = 'Specify the supplier first.'; es = 'Indique primero el proveedor.'");
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;
	Если Таблица.Имя = Элементы.ПоступленияПереработки.Имя И Не ЗначениеЗаполнено(СтрокаТаблицы.Передача) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСначалаПередача());
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура("ИмяТаблицы, Заказ, Поставщик, ЗаказПоставщику, НомерВходящегоДокумента, Передача",
		Таблица.Имя, ТекущийЗаказ);
	Если ЭтоТаблицаЗакупок(Таблица.Имя) Тогда
		Отбор.Поставщик = СтрокаТаблицы.Поставщик;
	КонецЕсли;
	Если Таблица.Имя = Элементы.Поступления.Имя Тогда
		Отбор.ЗаказПоставщику = СтрокаТаблицы.ЗаказПоставщику;
		Отбор.НомерВходящегоДокумента = СтрокаТаблицы.НомерВходящегоДокумента;
	КонецЕсли;
	Если Таблица.Имя = Элементы.ПоступленияПереработки.Имя Тогда
		Отбор.Поставщик = СтрокаТаблицы.Поставщик;
		Отбор.Передача = СтрокаТаблицы.Передача;
	КонецЕсли;
	Список = ДокументыДляВыбора(Отбор);
	Список.Вставить(0, Неопределено, ТекстНовыйДокумент());
	ДопПараметры = Новый Структура("ИмяТаблицы, Идентификатор", Таблица.Имя, Таблица.ТекущаяСтрока);
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораДокументаСтроки", ЭтотОбъект, ДопПараметры);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);

КонецПроцедуры

// Колонка «Заказ поставщику» поступления: строка заказа поставщику с остатком к поступлению или «Без заказа поставщику».
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «Заказ поставщику».
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - отключается.
//
&НаКлиенте
Процедура ПоступленияСтрокаОснованияПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элементы.Поступления.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	Список = СтрокиОснованийДляВыбора(ТекущийЗаказ, СтрокаТаблицы.Поставщик, СтрокаТаблицы.Материал,
		СтрокаТаблицы.Характеристика);
	// При открытых строках заказов поставщику приход без заказа сервер отклонит: пункт предлагается, только когда их нет.
	Если Список.Количество() = 0 Тогда
		Список.Добавить(Неопределено, ТекстБезЗаказаПоставщику());
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораСтрокиОснования", ЭтотОбъект, Элементы.Поступления.ТекущаяСтрока);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);

КонецПроцедуры

