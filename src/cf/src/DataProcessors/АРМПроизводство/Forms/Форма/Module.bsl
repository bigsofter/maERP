#Область ОписаниеПеременных

// Последний черновик, в который записана строка клиента: ключ - клиент, значение - Структура Заказ, ЗаказПредставление.
&НаКлиенте
Перем ПоследниеЧерновики;

// Идентификатор строки, вставленной в начало таблицы и ещё не введённой.
&НаКлиенте
Перем ВставленнаяСтрока;

// Имя таблицы формы, в которую вставлена ВставленнаяСтрока.
&НаКлиенте
Перем ВставленнаяТаблица;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПоказыватьСуммы = Обработки.АРМПроизводство.ПоказыватьСуммы();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Обработки.АРМПроизводство.ПраваРабочегоМеста());
	НастроитьЭлементы();
	УстановитьУсловноеОформление();
	УстановитьПараметрыСписка();
	ПрименитьСостояниеПанели(ЭтотОбъект);
	// Сохранённые настройки перечитают «Продукцию» в ПриЗагрузкеДанныхИзНастроекНаСервере по своему тумблеру.
	Если Не ЕстьСохраненныеНастройки() Тогда
		ЗагрузитьПродукцию();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Страховка: если сохранённые настройки найдены, а загрузка из них не пришла, «Продукция» перечитывается здесь.
	Если Продукция.Количество() = 0 Тогда
		ЗагрузитьПродукцию();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	// Сохранённые тумблер и состояние панели восстанавливаются после ПриСозданииНаСервере: отборы и панель - заново.
	УстановитьПараметрыСписка();
	ПрименитьСостояниеПанели(ЭтотОбъект);
	ЗагрузитьПродукцию();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Отборы панели фильтров одни для обеих закладок: список заказов получает параметры и отбор, «Продукция» перечитывается.
//
// Параметры:
//  Элемент - ПолеФормы - изменённое поле фильтра.
//
&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ПрименитьОтборыНаСервере();
	ОбновитьТекущийЗаказ();

КонецПроцедуры

&НаКлиенте
Процедура ГруппаВерхПриСменеСтраницы(Элемент, ТекущаяСтраница)

	ОбновитьТекущийЗаказ();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказы

&НаКлиенте
Процедура ЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	// Ключ строки списка с основной таблицей - сама ссылка (урок 2.0.15.10, forms-011).
	Если ТипЗнч(Элемент.ТекущаяСтрока) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ОткрытьДокумент(Элемент.ТекущаяСтрока);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПриАктивизацииСтроки(Элемент)

	ЗадержкаСекунд = 0.2;
	ПодключитьОбработчикОжидания("ОбновитьТекущийЗаказ", ЗадержкаСекунд, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПродукция

&НаКлиенте
Процедура ПродукцияПриАктивизацииСтроки(Элемент)

	ЗадержкаСекунд = 0.2;
	ПодключитьОбработчикОжидания("ОбновитьТекущийЗаказ", ЗадержкаСекунд, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	// Новая строка - в начало таблицы (решение владельца 2026-09-15): платформа добавила бы её в конец, поэтому строка
	// вставляется здесь, копия - со значениями текущей строки.
	Отказ = Истина;
	Если Не МожноМенятьЗаказы Тогда
		Возврат;
	КонецЕсли;
	УдалитьПустуюВставленнуюСтроку();
	НоваяСтрока = Продукция.Вставить(0);
	Если Копирование И Элемент.ТекущиеДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент.ТекущиеДанные);
		ПодготовитьНовуюСтроку(НоваяСтрока, Истина);
	Иначе
		ПодготовитьНовуюСтроку(НоваяСтрока, Ложь);
	КонецЕсли;
	ВставленнаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	ВставленнаяТаблица = Элемент.Имя;
	Элемент.ТекущаяСтрока = ВставленнаяСтрока;
	// Ввод начинается после выхода из обработчика: внутри него платформа ещё завершает отменённое добавление.
	ЗадержкаСекунд = 0.1;
	ПодключитьОбработчикОжидания("НачатьВводВставленнойСтроки", ЗадержкаСекунд, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПередНачаломИзменения(Элемент, Отказ)

	ТекущаяСтрокаПродукции = Элемент.ТекущиеДанные;
	Если ТекущаяСтрокаПродукции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не МожноМенятьЗаказы Или Не ТекущаяСтрокаПродукции.Редактируется Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСтрокаТолькоДляЧтения());
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПередУдалением(Элемент, Отказ)

	// Удаление - одним серверным вызовом по всем выделенным строкам: платформа сама удалила бы из таблицы все строки,
	// а из заказов - ни одной.
	Отказ = Истина;
	Если Не МожноМенятьЗаказы Или Элемент.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		Идентификаторы.Добавить(Идентификатор);
	КонецЦикла;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдалении", ЭтотОбъект, Идентификаторы);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить выделенные строки из заказов?';
		|fr = 'Supprimer les lignes sélectionnées des commandes ?';
		|en = 'Delete the selected lines from the orders?';
		|es = '¿Eliminar las líneas seleccionadas de los pedidos?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ТекущаяСтрокаПродукции = Элемент.ТекущиеДанные;
	Если ТекущаяСтрокаПродукции = Неопределено Или Не ТекущаяСтрокаПродукции.Редактируется Тогда
		Возврат;
	КонецЕсли;
	Вставлена = ВставленнаяСтрока <> Неопределено И ВставленнаяТаблица = Элемент.Имя
		И Элемент.ТекущаяСтрока = ВставленнаяСтрока;
	Если Вставлена Тогда
		ВставленнаяСтрока = Неопределено;
	КонецЕсли;
	Если ОтменаРедактирования Тогда
		// Строку вставил ПродукцияПередНачаломДобавления, поэтому отказ от её ввода платформа сама не отменяет.
		Если Вставлена И Не ТекущаяСтрокаПродукции.Записана Тогда
			Продукция.Удалить(ТекущаяСтрокаПродукции);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущаяСтрокаПродукции.Клиент) Или Не ЗначениеЗаполнено(ТекущаяСтрокаПродукции.Номенклатура)
		Или ТекущаяСтрокаПродукции.КоличествоУпаковок <= 0 Тогда
		ТекущаяСтрокаПродукции.СтатусДокумента = ТекстНеЗаписано();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Строка не записана: укажите клиента, продукцию и количество.';
			|fr = 'Ligne non enregistrée : indiquez le client, le produit et la quantité.';
			|en = 'Line not saved: specify the customer, product and quantity.';
			|es = 'Línea no guardada: indique el cliente, el producto y la cantidad.'"));
		Возврат;
	КонецЕсли;
	Черновик = ЗаписатьСтрокуНаСервере(Элемент.ТекущаяСтрока);
	Если Черновик <> Неопределено Тогда
		Если ПоследниеЧерновики = Неопределено Тогда
			ПоследниеЧерновики = Новый Соответствие;
		КонецЕсли;
		ПоследниеЧерновики.Вставить(Черновик.Клиент, Черновик);
	КонецЕсли;
	ПослеЗаписиЗаказов();

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияЗаказПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущаяСтрокаПродукции = Элементы.Продукция.ТекущиеДанные;
	Если ТекущаяСтрокаПродукции = Неопределено Или ТекущаяСтрокаПродукции.Записана Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущаяСтрокаПродукции.Клиент) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Сначала укажите клиента.';
			|fr = 'Indiquez d''abord le client.'; en = 'Specify the customer first.'; es = 'Indique primero el cliente.'"));
		Возврат;
	КонецЕсли;
	Список = ЧерновикиКлиента(ТекущаяСтрокаПродукции.Клиент);
	Список.Вставить(0, ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка"), ТекстНовыйЗаказ());
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораЧерновика", ЭтотОбъект, Элементы.Продукция.ТекущаяСтрока);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияКлиентПриИзменении(Элемент)

	// Первая строка клиента создаёт черновик, следующие по умолчанию идут в черновик, куда в этом сеансе рабочего места
	// последний раз записана строка клиента. Пока записей не было - «Новый заказ»: выбор среди черновиков - кнопкой.
	ТекущаяСтрокаПродукции = Элементы.Продукция.ТекущиеДанные;
	ТекущаяСтрокаПродукции.Заказ = ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка");
	ТекущаяСтрокаПродукции.ЗаказПредставление = ТекстНовыйЗаказ();
	ТекущаяСтрокаПродукции.ВерсияДанных = "";
	Черновик = ЧерновикКлиентаПоУмолчанию(ТекущаяСтрокаПродукции.Клиент);
	Если Черновик <> Неопределено Тогда
		ТекущаяСтрокаПродукции.Заказ = Черновик.Заказ;
		ТекущаяСтрокаПродукции.ЗаказПредставление = Черновик.ЗаказПредставление;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияНоменклатураПриИзменении(Элемент)

	ТекущаяСтрокаПродукции = Элементы.Продукция.ТекущиеДанные;
	ТекущаяСтрокаПродукции.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	ТекущаяСтрокаПродукции.Упаковка = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
	ТекущаяСтрокаПродукции.ЦенаИзменена = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияЦенаПриИзменении(Элемент)

	Элементы.Продукция.ТекущиеДанные.ЦенаИзменена = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументыЗаказа

&НаКлиенте
Процедура ДокументыЗаказаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(Элемент.ТекущиеДанные.Документ) Тогда
		ОткрытьДокумент(Элемент.ТекущиеДанные.Документ);
	КонецЕсли;

КонецПроцедуры

