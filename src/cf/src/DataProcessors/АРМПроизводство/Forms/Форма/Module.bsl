	ПослеЗаписиЗаказов();

КонецПроцедуры

&НаКлиенте
Процедура СтраницаПервая(Команда)

	Если НомерСтраницы > 1 Тогда
		НомерСтраницы = 1;
		ОбновитьСтраницуЗаказов();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтраницаНазад(Команда)

	Если НомерСтраницы > 1 Тогда
		НомерСтраницы = НомерСтраницы - 1;
		ОбновитьСтраницуЗаказов();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтраницаВперед(Команда)

	Если НомерСтраницы < ВсегоСтраниц Тогда
		НомерСтраницы = НомерСтраницы + 1;
		ОбновитьСтраницуЗаказов();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтраницаПоследняя(Команда)

	Если НомерСтраницы < ВсегоСтраниц Тогда
		НомерСтраницы = ВсегоСтраниц;
		ОбновитьСтраницуЗаказов();
	КонецЕсли;

КонецПроцедуры

