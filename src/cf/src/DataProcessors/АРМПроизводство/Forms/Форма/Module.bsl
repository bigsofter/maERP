#КонецОбласти

#Область Закупки

// Ввод строк закупок разрешён у заказа на производство в работе и при праве на вид документа.
//
// Параметры:
//  ИмяТаблицы - Строка - «ЗаказыПоставщику» или «Поступления».
//
// Возвращаемое значение:
//  Булево - Истина, если строки таблицы можно вводить и править.
//
&НаКлиенте
Функция ВводЗакупокРазрешен(ИмяТаблицы)

	Если Не МожноНаОсновании Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстТолькоЗаказВРаботе());
		Возврат Ложь;
	КонецЕсли;
	Можно = ?(ИмяТаблицы = Элементы.Поступления.Имя, МожноВводитьПоступления, МожноВводитьЗаказыПоставщику);
	Если Не Можно Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Нет права вводить эти документы: строки только для просмотра.';
			|fr = 'Aucun droit de saisir ces documents : les lignes sont en lecture seule.';
			|en = 'No right to enter these documents: the lines are read-only.';
			|es = 'Sin derecho a introducir estos documentos: las líneas son de solo lectura.'"));
	КонецЕсли;
	Возврат Можно;

КонецФункции

&НаКлиенте
Процедура ПередДобавлениемСтрокиЗакупки(Элемент, Отказ, Копирование)

	// Новая строка - в начало таблицы, как в «Продукции»: строку вставляет рабочее место, ввод начинается обработчиком
	// ожидания.
	Отказ = Истина;
	ИмяТаблицы = Элемент.Имя;
	Если Не ВводЗакупокРазрешен(ИмяТаблицы) Тогда
		Возврат;
	КонецЕсли;
	УдалитьПустуюВставленнуюСтроку();
	Таблица = ЭтотОбъект[ИмяТаблицы];
	НоваяСтрока = Таблица.Вставить(0);
	НоваяСтрока.Статус = ТекстНеЗаписано();
	НоваяСтрока.ДокументПредставление = ТекстНовыйДокумент();
	Если ИмяТаблицы = Элементы.Поступления.Имя Тогда
		НоваяСтрока.СтрокаОснованияПредставление = ТекстБезЗаказаПоставщику();
	КонецЕсли;
	Если Копирование И Элемент.ТекущиеДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент.ТекущиеДанные, "Поставщик, Материал, Характеристика, Упаковка, Цена, ЦенаИзменена");
		ПодставитьДокументПоставщика(ИмяТаблицы, НоваяСтрока);
	КонецЕсли;
	ВставленнаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	ВставленнаяТаблица = ИмяТаблицы;
	Элемент.ТекущаяСтрока = ВставленнаяСтрока;
	ЗадержкаСекунд = 0.1;
	ПодключитьОбработчикОжидания("НачатьВводВставленнойСтроки", ЗадержкаСекунд, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПередИзменениемСтрокиЗакупки(Элемент, Отказ)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ВводЗакупокРазрешен(Элемент.Имя) Тогда
		Отказ = Истина;
	ИначеЕсли СтрокаТаблицы.ТолькоПросмотр Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПравкаВФормеДокумента());
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередУдалениемСтрокЗакупок(Элемент, Отказ)

	// Удаление - одним серверным вызовом: документы закупки меняются только сервером, платформа удалила бы лишь строки
	// таблицы.
	Отказ = Истина;
	Если Элемент.ВыделенныеСтроки.Количество() = 0 Или Не ВводЗакупокРазрешен(Элемент.Имя) Тогда
		Возврат;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		Идентификаторы.Добавить(Идентификатор);
	КонецЦикла;
	ДопПараметры = Новый Структура("ИмяТаблицы, Идентификаторы", Элемент.Имя, Идентификаторы);
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдаленииЗакупок", ЭтотОбъект, ДопПараметры);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить выделенные строки из документов?';
		|fr = 'Supprimer les lignes sélectionnées des documents ?';
		|en = 'Delete the selected lines from the documents?';
		|es = '¿Eliminar las líneas seleccionadas de los documentos?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУдаленииЗакупок(Ответ, ДопПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	УдалитьСтрокиЗакупокНаСервере(ДопПараметры.ИмяТаблицы, ДопПараметры.Идентификаторы);
	Элементы.Заказы.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура ПриОкончанииРедактированияСтрокиЗакупки(Элемент, ОтменаРедактирования)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Вставлена = ВставленнаяСтрока <> Неопределено И ВставленнаяТаблица = Элемент.Имя
		И Элемент.ТекущаяСтрока = ВставленнаяСтрока;
	Если Вставлена Тогда
		ВставленнаяСтрока = Неопределено;
	КонецЕсли;
	Если ОтменаРедактирования Тогда
		Если Вставлена И Не СтрокаТаблицы.Записана Тогда
			ЭтотОбъект[Элемент.Имя].Удалить(СтрокаТаблицы);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Поставщик) Или Не ЗначениеЗаполнено(СтрокаТаблицы.Материал)
		Или СтрокаТаблицы.КоличествоУпаковок <= 0 Тогда
		СтрокаТаблицы.Статус = ТекстНеЗаписано();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Строка не записана: укажите поставщика, материал и количество.';
			|fr = 'Ligne non enregistrée : indiquez le fournisseur, la matière et la quantité.';
			|en = 'Line not saved: specify the supplier, material and quantity.';
			|es = 'Línea no guardada: indique el proveedor, el material y la cantidad.'"));
		Возврат;
	КонецЕсли;
	ЗаписатьСтрокуЗакупкиНаСервере(Элемент.Имя, Элемент.ТекущаяСтрока);
	Элементы.Заказы.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументСтрокиЗакупки(Элемент, Поле, СтандартнаяОбработка)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или Не СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	ПоляДокумента = Новый Массив;
	ПоляДокумента.Добавить(Элемент.Имя + "Статус");
	ПоляДокумента.Добавить(Элемент.Имя + "ДокументПредставление");
	Если ПоляДокумента.Найти(Поле.Имя) <> Неопределено Или СтрокаТаблицы.ТолькоПросмотр Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьДокумент(СтрокаТаблицы.Документ);
	КонецЕсли;

КонецПроцедуры

// Документ и заказ поставщику новой строки - как у ближайшей записанной строки ниже того же поставщика; нет такой -
// «Новый» (решение владельца 10).
//
// Параметры:
//  ИмяТаблицы    - Строка - «ЗаказыПоставщику» или «Поступления».
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - строка таблицы закупок.
//
&НаКлиенте
Процедура ПодставитьДокументПоставщика(ИмяТаблицы, СтрокаТаблицы)

	Если СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	Таблица = ЭтотОбъект[ИмяТаблицы];
	ЭтоПоступление = ИмяТаблицы = Элементы.Поступления.Имя;
	ИмяПустогоДокумента = ?(ЭтоПоступление, "Документ.ПоступлениеТоваровУслуг.ПустаяСсылка",
		"Документ.ЗаказПоставщику.ПустаяСсылка");
	СтрокаТаблицы.Документ = ПредопределенноеЗначение(ИмяПустогоДокумента);
	СтрокаТаблицы.ДокументПредставление = ТекстНовыйДокумент();
	Для Индекс = Таблица.Индекс(СтрокаТаблицы) + 1 По Таблица.Количество() - 1 Цикл
		Соседняя = Таблица[Индекс];
		Если Не СоседняяСтрокаПодходит(СтрокаТаблицы, Соседняя, ЭтоПоступление) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы.Документ = Соседняя.Документ;
		СтрокаТаблицы.ДокументПредставление = Соседняя.ДокументПредставление;
		Если ЭтоПоступление Тогда
			ПодставитьНакладнуюСоседней(СтрокаТаблицы, Соседняя);
		КонецЕсли;
		Прервать;
	КонецЦикла;

КонецПроцедуры

// Документ за сегодня того же поставщика; у поступления - и того же основания и накладной, если номер набран.
//
// Параметры:
//  СтрокаТаблицы  - ДанныеФормыЭлементКоллекции - новая строка закупки.
//  Соседняя       - ДанныеФормыЭлементКоллекции - строка ниже.
//  ЭтоПоступление - Булево - строки «Поступлений».
//
// Возвращаемое значение:
//  Булево - документ соседней строки подходит новой.
//
&НаКлиенте
Функция СоседняяСтрокаПодходит(СтрокаТаблицы, Соседняя, ЭтоПоступление)

	Подходит = Соседняя.Записана И Соседняя.Поставщик = СтрокаТаблицы.Поставщик И Не Соседняя.ТолькоПросмотр
		И Соседняя.ДокументЗаСегодня;
	Если Подходит И ЭтоПоступление Тогда
		НомерНабран = Не ПустаяСтрока(СтрокаТаблицы.НомерВходящегоДокумента);
		ТотЖеНомер = СокрЛП(Соседняя.НомерВходящегоДокумента) = СокрЛП(СтрокаТаблицы.НомерВходящегоДокумента);
		Подходит = Соседняя.ЗаказПоставщику = СтрокаТаблицы.ЗаказПоставщику И (Не НомерНабран Или ТотЖеНомер);
	КонецЕсли;
	Возврат Подходит;

КонецФункции

// Номер и дата накладной соседней строки - только в пустые поля новой строки.
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - новая строка «Поступлений».
//  Соседняя      - ДанныеФормыЭлементКоллекции - строка того же документа.
//
&НаКлиенте
Процедура ПодставитьНакладнуюСоседней(СтрокаТаблицы, Соседняя)

	Если ПустаяСтрока(СтрокаТаблицы.НомерВходящегоДокумента) Тогда
		СтрокаТаблицы.НомерВходящегоДокумента = Соседняя.НомерВходящегоДокумента;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаВходящегоДокумента) Тогда
		СтрокаТаблицы.ДатаВходящегоДокумента = Соседняя.ДатаВходящегоДокумента;
	КонецЕсли;

КонецПроцедуры

// Количество материала по умолчанию - сумма колонки «Материалов» по всем изделиям заказа.
//
// Параметры:
//  Материал       - СправочникСсылка.Номенклатура - материал.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика.
//  ИмяКолонки     - Строка - «Дефицит» или «КПоступлению».
//
// Возвращаемое значение:
//  Число - количество.
//
&НаКлиенте
Функция КоличествоМатериала(Материал, Характеристика, ИмяКолонки)

	Количество = 0;
	Для Каждого СтрокаМатериала Из Материалы.НайтиСтроки(Новый Структура("Материал, Характеристика", Материал, Характеристика)) Цикл
		Количество = Количество + СтрокаМатериала[ИмяКолонки];
	КонецЦикла;
	Возврат Количество;

КонецФункции

// Строка поступления: смена материала или характеристики сбрасывает строку заказа поставщику; подходящая строка одна -
// подставляется, несколько - подсказка выбрать.
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - новая строка «Поступлений».
//
&НаКлиенте
Процедура ПодобратьСтрокуОснования(СтрокаТаблицы)

	Если СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.ЗаказПоставщику = ПредопределенноеЗначение("Документ.ЗаказПоставщику.ПустаяСсылка");
	СтрокаТаблицы.КодСтрокиОснования = 0;
	СтрокаТаблицы.СтрокаОснованияПредставление = ТекстБезЗаказаПоставщику();
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Материал) Тогда
		Возврат;
	КонецЕсли;
	Список = СтрокиОснованийДляВыбора(ТекущийЗаказ, СтрокаТаблицы.Поставщик, СтрокаТаблицы.Материал,
		СтрокаТаблицы.Характеристика);
	Если Список.Количество() = 1 Тогда
		ПрименитьСтрокуОснования(СтрокаТаблицы, Список[0]);
	КонецЕсли;
	// Несколько строк - подсказка выбрать; ни одной - поступление без заказа поставщику.
	Если Список.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'По материалу несколько строк заказов поставщику:
			| выберите строку в колонке «Заказ поставщику».';
			|fr = 'Plusieurs lignes de commandes fournisseur pour cette matière : choisissez-la dans la colonne « Commande fournisseur ».';
			|en = 'Several supplier order lines for this material: select one in the ""Supplier order"" column.';
			|es = 'Varias líneas de pedidos a proveedor para este material: elija una en la columna «Pedido a proveedor».'"));
	КонецЕсли;
	ПодставитьДокументПоставщика(Элементы.Поступления.Имя, СтрокаТаблицы);

КонецПроцедуры

// Параметры:
//  СтрокаТаблицы  - ДанныеФормыЭлементКоллекции - строка «Поступлений».
//  ЭлементСписка  - ЭлементСпискаЗначений - значение - см. Обработки.АРМПроизводство.СтрокиЗаказовПоставщикуДляВыбора.
//
&НаКлиенте
Процедура ПрименитьСтрокуОснования(СтрокаТаблицы, ЭлементСписка)

	Значение = ЭлементСписка.Значение;
	СтрокаТаблицы.ЗаказПоставщику = Значение.ЗаказПоставщику;
	СтрокаТаблицы.КодСтрокиОснования = Значение.КодСтроки;
	СтрокаТаблицы.СтрокаОснованияПредставление = ЭлементСписка.Представление;
	СтрокаТаблицы.Поставщик = Значение.Поставщик;
	СтрокаТаблицы.Материал = Значение.Материал;
	СтрокаТаблицы.Характеристика = Значение.Характеристика;
	СтрокаТаблицы.Упаковка = Значение.Упаковка;
	СтрокаТаблицы.КоличествоУпаковок = Значение.КоличествоУпаковок;
	СтрокаТаблицы.ЦенаИзменена = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСтрокиОснования(ВыбранныйЭлемент, Идентификатор) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Поступления.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранныйЭлемент.Значение = Неопределено Тогда
		СтрокаТаблицы.ЗаказПоставщику = ПредопределенноеЗначение("Документ.ЗаказПоставщику.ПустаяСсылка");
		СтрокаТаблицы.КодСтрокиОснования = 0;
		СтрокаТаблицы.СтрокаОснованияПредставление = ТекстБезЗаказаПоставщику();
	Иначе
		ПрименитьСтрокуОснования(СтрокаТаблицы, ВыбранныйЭлемент);
	КонецЕсли;
	ПодставитьДокументПоставщика(Элементы.Поступления.Имя, СтрокаТаблицы);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораДокументаЗакупки(ВыбранныйЭлемент, ДопПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = ЭтотОбъект[ДопПараметры.ИмяТаблицы].НайтиПоИдентификатору(ДопПараметры.Идентификатор);
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.Записана Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранныйЭлемент.Значение = Неопределено Тогда
		ЭтоПоступление = ДопПараметры.ИмяТаблицы = Элементы.Поступления.Имя;
		СтрокаТаблицы.Документ = ПредопределенноеЗначение(?(ЭтоПоступление, "Документ.ПоступлениеТоваровУслуг.ПустаяСсылка",
			"Документ.ЗаказПоставщику.ПустаяСсылка"));
		СтрокаТаблицы.ДокументПредставление = ТекстНовыйДокумент();
	Иначе
		СтрокаТаблицы.Документ = ВыбранныйЭлемент.Значение;
		СтрокаТаблицы.ДокументПредставление = ВыбранныйЭлемент.Представление;
	КонецЕсли;
	СтрокаТаблицы.ВерсияДанных = "";

КонецПроцедуры

// «Статус» нижних закладок: документы отмеченных записанных строк таблицы команды.
//
// Параметры:
//  Команда  - КомандаФормы - команда таблицы закупок.
//  Действие - Строка - см. ДействиеВРаботу, ДействиеВЧерновик, ДействиеОтменить.
//
&НаКлиенте
Процедура ИзменитьСтатусЗакупок(Команда, Действие)

	ИмяТаблицы = ?(СтрНачинаетсяС(Команда.Имя, Элементы.Поступления.Имя), Элементы.Поступления.Имя,
		Элементы.ЗаказыПоставщику.Имя);
	ДокументыЗакупки = Новый Массив;
	Для Каждого Идентификатор Из Элементы[ИмяТаблицы].ВыделенныеСтроки Цикл
		СтрокаТаблицы = ЭтотОбъект[ИмяТаблицы].НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы <> Неопределено И СтрокаТаблицы.Записана И ДокументыЗакупки.Найти(СтрокаТаблицы.Документ) = Неопределено Тогда
			ДокументыЗакупки.Добавить(СтрокаТаблицы.Документ);
		КонецЕсли;
	КонецЦикла;
	Если ДокументыЗакупки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отметьте записанные строки документов.';
			|fr = 'Cochez des lignes de documents enregistrés.'; en = 'Tick lines of saved documents.';
			|es = 'Marque líneas de documentos guardados.'"));
		Возврат;
	КонецЕсли;
	Если Действие <> ДействиеОтменить() Тогда
		ИзменитьСтатусЗакупокНаСервере(ДокументыЗакупки, Действие);
		Элементы.Заказы.Обновить();
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбОтменеЗакупок", ЭтотОбъект, ДокументыЗакупки);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Пометить документы отмеченных строк на удаление?';
		|fr = 'Marquer les documents des lignes cochées pour suppression ?';
		|en = 'Mark the documents of the ticked lines for deletion?';
		|es = '¿Marcar los documentos de las líneas marcadas para eliminar?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОтменеЗакупок(Ответ, ДокументыЗакупки) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ИзменитьСтатусЗакупокНаСервере(ДокументыЗакупки, ДействиеОтменить());
		Элементы.Заказы.Обновить();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ИзменитьСтатусЗакупокНаСервере(Знач ДокументыЗакупки, Знач Действие)

	Для Каждого Итог Из Обработки.АРМПроизводство.ИзменитьСтатусДокументовЗакупки(ДокументыЗакупки, Действие, ТекущийЗаказ) Цикл
		Если Не ПустаяСтрока(Итог.Текст) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("%1: %2", Итог.Документ, Итог.Текст));
		КонецЕсли;
	КонецЦикла;
	ОбновитьТекущийЗаказНаСервере(ТекущийЗаказ);

КонецПроцедуры

// Данные строки таблицы закупок для записи или удаления.
//
// Параметры:
//  ИмяТаблицы    - Строка - «ЗаказыПоставщику» или «Поступления».
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - строка таблицы.
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиЗакупки.
//
&НаСервере
Функция ДанныеСтрокиЗакупки(ИмяТаблицы, СтрокаТаблицы)

	АРМ = Обработки.АРМПроизводство;
	ДанныеСтроки = АРМ.НовыеДанныеСтрокиЗакупки();
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаТаблицы);
	ДанныеСтроки.Вид = ?(ИмяТаблицы = Элементы.Поступления.Имя, АРМ.ВидПоступление(), АРМ.ВидЗаказПоставщику());
	ДанныеСтроки.Заказ = ТекущийЗаказ;
	Если Не ЗначениеЗаполнено(ДанныеСтроки.Документ) Тогда
		ДанныеСтроки.Документ = Неопределено;
	КонецЕсли;
	Возврат ДанныеСтроки;

КонецФункции

&НаСервере
Процедура ЗаписатьСтрокуЗакупкиНаСервере(Знач ИмяТаблицы, Знач Идентификатор)

	Таблица = ЭтотОбъект[ИмяТаблицы];
	СтрокаТаблицы = Таблица.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат = Обработки.АРМПроизводство.ЗаписатьСтрокуЗакупки(ДанныеСтрокиЗакупки(ИмяТаблицы, СтрокаТаблицы));
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
	КонецЕсли;
	Если Не Результат.Успех И Не Результат.Перечитать И Не СтрокаТаблицы.Записана Тогда
		// Новая строка остаётся с причиной отказа; отвергнутая правка записанной строки откатывается перечитыванием.
		СтрокаТаблицы.Статус = ?(ПустаяСтрока(Результат.Текст), ТекстНеЗаписано(), Результат.Текст);
		Возврат;
	КонецЕсли;
	Если Результат.Успех И Не СтрокаТаблицы.Записана Тогда
		Таблица.Удалить(СтрокаТаблицы);
	КонецЕсли;
	ОбновитьТекущийЗаказНаСервере(ТекущийЗаказ);
	Если Не Результат.Успех Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура("Документ, НомерСтроки", Результат.Документ, Результат.НомерСтроки);
	Для Каждого Записанная Из Таблица.НайтиСтроки(Новый Структура("Документ", Результат.Документ)) Цикл
		Если Результат.СтрокиДокумента.Количество() > 0 Тогда
			Записанная.Статус = Результат.СтрокиДокумента[0].Статус;
		КонецЕсли;
		Если Записанная.НомерСтроки = Отбор.НомерСтроки Тогда
			Элементы[ИмяТаблицы].ТекущаяСтрока = Записанная.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиЗакупокНаСервере(Знач ИмяТаблицы, Знач Идентификаторы)

	Таблица = ЭтотОбъект[ИмяТаблицы];
	СтрокиДанных = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		СтрокаТаблицы = Таблица.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы = Неопределено Тогда
			Продолжить;
		ИначеЕсли Не СтрокаТаблицы.Записана Тогда
			Таблица.Удалить(СтрокаТаблицы);
		ИначеЕсли СтрокаТаблицы.ТолькоПросмотр Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПравкаВФормеДокумента());
		Иначе
			СтрокиДанных.Добавить(ДанныеСтрокиЗакупки(ИмяТаблицы, СтрокаТаблицы));
		КонецЕсли;
	КонецЦикла;
	Если СтрокиДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Результат Из Обработки.АРМПроизводство.УдалитьСтрокиЗакупок(СтрокиДанных) Цикл
		Если Не ПустаяСтрока(Результат.Текст) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
		КонецЕсли;
	КонецЦикла;
	ОбновитьТекущийЗаказНаСервере(ТекущийЗаказ);

КонецПроцедуры

// Строки закупок текущего заказа в таблицах формы: незаписанные строки того же заказа остаются в начале таблицы.
//
// Параметры:
//  Таблица              - ДанныеФормыКоллекция - «ЗаказыПоставщику» или «Поступления».
//  Строки               - Массив из Структура - см. Обработки.АРМПроизводство.СтрокиЗакупок.
//  СохранитьНезаписанные - Булево - заказ тот же: незаписанные строки не теряются.
//
&НаСервере
Процедура ЗагрузитьСтрокиЗакупок(Таблица, Строки, СохранитьНезаписанные)

	Незаписанные = Таблица.Выгрузить(Новый Структура("Записана", Ложь));
	Таблица.Очистить();
	Если СохранитьНезаписанные Тогда
		Для Каждого Незаписанная Из Незаписанные Цикл
			ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Незаписанная);
		КонецЦикла;
	КонецЕсли;
	Для Каждого ДанныеСтроки Из Строки Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), ДанныеСтроки);
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Отбор - Структура - Поступление, Заказ, Поставщик, ЗаказПоставщику, НомерВходящегоДокумента.
//
// Возвращаемое значение:
//  СписокЗначений - см. Обработки.АРМПроизводство.ДокументыЗакупкиДляВыбора.
//
&НаСервереБезКонтекста
Функция ДокументыДляВыбора(Знач Отбор)

	АРМ = Обработки.АРМПроизводство;
	ДанныеСтроки = АРМ.НовыеДанныеСтрокиЗакупки();
	ДанныеСтроки.Вид = ?(Отбор.Поступление, АРМ.ВидПоступление(), АРМ.ВидЗаказПоставщику());
	ДанныеСтроки.Заказ = Отбор.Заказ;
	ДанныеСтроки.Поставщик = Отбор.Поставщик;
	Если Отбор.Поступление Тогда
		ДанныеСтроки.ЗаказПоставщику = Отбор.ЗаказПоставщику;
		ДанныеСтроки.НомерВходящегоДокумента = Отбор.НомерВходящегоДокумента;
	КонецЕсли;
	Возврат АРМ.ДокументыЗакупкиДляВыбора(ДанныеСтроки);

КонецФункции

&НаСервереБезКонтекста
Функция СтрокиОснованийДляВыбора(Знач Заказ, Знач Поставщик, Знач Материал, Знач Характеристика)

	Возврат Обработки.АРМПроизводство.СтрокиЗаказовПоставщикуДляВыбора(Заказ, Поставщик, Материал, Характеристика);

КонецФункции

&НаСервереБезКонтекста
Функция ОсновнойПоставщикМатериала(Знач Материал)

	Возврат Обработки.АРМПроизводство.ОсновнойПоставщик(Материал);

КонецФункции

// Пустая вставленная строка, ввод в которую так и не начался, не остаётся в начале таблицы.
&НаКлиенте
Процедура УдалитьПустуюВставленнуюСтроку()

	Если ВставленнаяСтрока = Неопределено Или ВставленнаяТаблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Таблица = ЭтотОбъект[ВставленнаяТаблица];
	Прежняя = Таблица.НайтиПоИдентификатору(ВставленнаяСтрока);
	ИмяПозиции = ?(ВставленнаяТаблица = Элементы.Продукция.Имя, "Номенклатура", "Материал");
	Если Прежняя <> Неопределено И Не Прежняя.Записана И Не ЗначениеЗаполнено(Прежняя[ИмяПозиции]) Тогда
		Таблица.Удалить(Прежняя);
	КонецЕсли;
	ВставленнаяСтрока = Неопределено;

КонецПроцедуры

#КонецОбласти

#Область ТекущийЗаказ

&НаКлиенте
Процедура ОбновитьТекущийЗаказ()

	Заказ = ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка");
	Если Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаЗаказы Тогда
		Если ТипЗнч(Элементы.Заказы.ТекущаяСтрока) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Заказ = Элементы.Заказы.ТекущаяСтрока;
		КонецЕсли;
	ИначеЕсли Элементы.Продукция.ТекущиеДанные <> Неопределено Тогда
		Заказ = Элементы.Продукция.ТекущиеДанные.Заказ;
	Иначе
		// Нет текущей строки продукции: нижние закладки пустые.
		Заказ = ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка");
	КонецЕсли;
	ОбновитьТекущийЗаказНаСервере(Заказ);

КонецПроцедуры

&НаСервере
Процедура ОбновитьТекущийЗаказНаСервере(Знач Заказ)

	ТотЖеЗаказ = Заказ = ТекущийЗаказ;
	ТекущийЗаказ = Заказ;
	Данные = Обработки.АРМПроизводство.ДанныеТекущегоЗаказа(Заказ);
	Материалы.Загрузить(Данные.Материалы);
	ДокументыЗаказа.Загрузить(Данные.Документы);
	// Незаписанные строки закупок живут, пока заказ тот же: при смене заказа они к нему не относятся.
	ЗагрузитьСтрокиЗакупок(ЗаказыПоставщику, Данные.Закупки.ЗаказыПоставщику, ТотЖеЗаказ);
	ЗагрузитьСтрокиЗакупок(Поступления, Данные.Закупки.Поступления, ТотЖеЗаказ);
	МожноНаОсновании = Данные.МожноНаОсновании;
	// Проценты выполнения текущего заказа - в подсказке колонки «Индикатор» вместо отдельных колонок.
	// Свойство меняется, только если пояснение другое: вызов приходит и во время ввода новой строки.
	Если Элементы.ЗаказыИндикатор.Подсказка <> Данные.ПояснениеИндикатора Тогда
		Элементы.ЗаказыИндикатор.Подсказка = Данные.ПояснениеИндикатора;
		Элементы.ПродукцияИндикатор.Подсказка = Данные.ПояснениеИндикатора;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиЗаказов()

	Элементы.Заказы.Обновить();
	ОбновитьТекущийЗаказ();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНаОсновании(ИмяФормы)

	Если Не ВыбратьЗаказДляОснования() Тогда
		Возврат;
	КонецЕсли;
	Если Не МожноНаОсновании Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстТолькоЗаказВРаботе());
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДокумента", ЭтотОбъект);
	ОткрытьФорму(ИмяФормы, Новый Структура("Основание", ТекущийЗаказ), ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

// Заказ для ввода на основании - из отмеченных строк панели выделения: отмеченная строка может не быть текущей, тогда
// нижние закладки и признак «можно на основании» перечитываются по ней.
//
// Возвращаемое значение:
//  Булево - выбран ровно один заказ, он стал текущим.
//
&НаКлиенте
Функция ВыбратьЗаказДляОснования()

	Отмеченные = ОтмеченныеЗаказы();
	Если Отмеченные.Количество() = 0 И ЕстьВыделенныеСтроки() Тогда
		// Отмечены только незаписанные строки: заказ строки под курсором вместо них не подставляется.
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстВыберитеЗаказ());
		Возврат Ложь;
	КонецЕсли;
	Если Отмеченные.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отметьте строки одного заказа.';
			|fr = 'Cochez les lignes d''une seule commande.'; en = 'Select lines of one order.';
			|es = 'Marque las líneas de un solo pedido.'"));
		Возврат Ложь;
	КонецЕсли;
	Если Отмеченные.Количество() = 1 И Отмеченные[0] <> ТекущийЗаказ Тогда
		ОбновитьТекущийЗаказНаСервере(Отмеченные[0]);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущийЗаказ) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстВыберитеЗаказ());
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ЕстьВыделенныеСтроки()

	Если Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаЗаказы Тогда
		Возврат Элементы.Заказы.ВыделенныеСтроки.Количество() > 0;
	КонецЕсли;
	Возврат Элементы.Продукция.ВыделенныеСтроки.Количество() > 0;

КонецФункции

&НаКлиенте
Процедура ОткрытьДокумент(Ссылка)

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДокумента", ЭтотОбъект);
	ОткрытьФорму(ИмяФормыОбъекта(Ссылка), Новый Структура("Ключ", Ссылка), ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияДокумента(Результат, ДопПараметры) Экспорт

	ЗагрузитьПродукцию();
	ПослеЗаписиЗаказов();

КонецПроцедуры

