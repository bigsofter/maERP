
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьЭлементыФормы();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имена программно создаваемых реквизитов-списков - идентификаторы, их повтор
// в настройке, привязке таблиц и клиентских обработчиках неустраним.
// BSLLS:DuplicateStringLiteral-off

&НаСервере
Процедура СоздатьЭлементыФормы()

	// BSLLS:IsInRoleMethod-off - скрытие сумм интерфейсное и привязано именно к роли, а не к праву
	ПоказыватьСуммы = Не РольДоступна("ОператорПроизводства") Или РольДоступна("Администратор");

	ТипДинамическийСписок = Новый ОписаниеТипов("ДинамическийСписок");
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДСЗаказы", ТипДинамическийСписок));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДСТоварыЗаказа", ТипДинамическийСписок));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДССвязанные", ТипДинамическийСписок));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	НастроитьСписки();

	ТаблицаЗаказов = ДобавитьТаблицуСписка(Неопределено, "ТаблицаЗаказы", "ДСЗаказы", Истина);
	ТаблицаЗаказов.УстановитьДействие("ПриАктивизацииСтроки", "Подключаемый_ЗаказыПриАктивизацииСтроки");
	ТаблицаЗаказов.УстановитьДействие("Выбор", "Подключаемый_ТаблицаДокументовВыбор");
	ДобавитьКолонкуСписка(ТаблицаЗаказов, "Номер");
	ДобавитьКолонкуСписка(ТаблицаЗаказов, "Дата");
	ДобавитьКолонкуСписка(ТаблицаЗаказов, "Контрагент");
	ДобавитьКолонкуСписка(ТаблицаЗаказов, "Статус");
	ДобавитьКолонкуСписка(ТаблицаЗаказов, "ДатаОтгрузки");
	Если ПоказыватьСуммы Тогда
		ДобавитьКолонкуСписка(ТаблицаЗаказов, "Сумма");
	КонецЕсли;
	ДобавитьКолонкуСписка(ТаблицаЗаказов, "Менеджер");
	ДобавитьКолонкуСписка(ТаблицаЗаказов, "Комментарий");

	ГруппаДеталей = Элементы.Добавить("ГруппаДетали", Тип("ГруппаФормы"));
	ГруппаДеталей.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаДеталей.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаДеталей.ОтображатьЗаголовок = Ложь;
	ГруппаДеталей.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаДеталей.РастягиватьПоГоризонтали = Истина;

	ТаблицаТоваров = ДобавитьТаблицуСписка(ГруппаДеталей, "ТаблицаТоварыЗаказа", "ДСТоварыЗаказа", Ложь);
	ДобавитьКолонкуСписка(ТаблицаТоваров, "НомерСтроки");
	ДобавитьКолонкуСписка(ТаблицаТоваров, "Номенклатура");
	ДобавитьКолонкуСписка(ТаблицаТоваров, "Характеристика");
	ДобавитьКолонкуСписка(ТаблицаТоваров, "Упаковка");
	ДобавитьКолонкуСписка(ТаблицаТоваров, "КоличествоУпаковок");

	ТаблицаСвязанных = ДобавитьТаблицуСписка(ГруппаДеталей, "ТаблицаСвязанные", "ДССвязанные", Ложь);
	ТаблицаСвязанных.УстановитьДействие("Выбор", "Подключаемый_ТаблицаДокументовВыбор");
	КолонкаДокумента = ДобавитьКолонкуСписка(ТаблицаСвязанных, "Ссылка");
	КолонкаДокумента.Заголовок =
		НСтр("ru = 'Связанный документ'; fr = 'Document lié'; en = 'Related document'; es = 'Documento relacionado'");

КонецПроцедуры

&НаСервере
Процедура НастроитьСписки()

	// Статус хранится в срезе последних регистра статусов: в произвольном запросе
	// динамического списка ни соединения с ним, ни параметров виртуальной таблицы не избежать.
	// BSLLS:JoinWithVirtualTable-off
	// BSLLS:VirtualTableCallWithoutParameters-off
	СписокЗаказов = ЭтотОбъект["ДСЗаказы"];
	СписокЗаказов.ПроизвольныйЗапрос = Истина;
	СписокЗаказов.ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДокументЗаказПокупателя.Ссылка КАК Ссылка,
	|	ДокументЗаказПокупателя.ПометкаУдаления КАК ПометкаУдаления,
	|	ДокументЗаказПокупателя.Проведен КАК Проведен,
	|	ДокументЗаказПокупателя.Номер КАК Номер,
	|	ДокументЗаказПокупателя.Дата КАК Дата,
	|	ДокументЗаказПокупателя.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ДокументЗаказПокупателя.Контрагент КАК Контрагент,
	|	ДокументЗаказПокупателя.Менеджер КАК Менеджер,
	|	ДокументЗаказПокупателя.Сумма КАК Сумма,
	|	ДокументЗаказПокупателя.Комментарий КАК Комментарий,
	|	ИсторияСтатусовСрезПоследних.СтатусЗаказаПокупателя КАК Статус
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ДокументЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних КАК ИсторияСтатусовСрезПоследних
	|		ПО ДокументЗаказПокупателя.Ссылка = ИсторияСтатусовСрезПоследних.ЗаказПокупателя";
	// BSLLS:JoinWithVirtualTable-on
	// BSLLS:VirtualTableCallWithoutParameters-on
	СписокЗаказов.ОсновнаяТаблица = "Документ.ЗаказПокупателя";
	СписокЗаказов.ДинамическоеСчитываниеДанных = Истина;

	СписокТоваров = ЭтотОбъект["ДСТоварыЗаказа"];
	СписокТоваров.ПроизвольныйЗапрос = Истина;
	СписокТоваров.ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗаказПокупателяТЧТовары.НомерСтроки КАК НомерСтроки,
	|	ЗаказПокупателяТЧТовары.Номенклатура КАК Номенклатура,
	|	ЗаказПокупателяТЧТовары.Характеристика КАК Характеристика,
	|	ЗаказПокупателяТЧТовары.Упаковка КАК Упаковка,
	|	ЗаказПокупателяТЧТовары.КоличествоУпаковок КАК КоличествоУпаковок
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК ЗаказПокупателяТЧТовары
	|ГДЕ
	|	ЗаказПокупателяТЧТовары.Ссылка = &Ссылка";

	// Порядок по дате связанного документа, поле через точку неизбежно:
	// критерий отбора отдаёт только Ссылка. BSLLS:QueryNestedFieldsByDot-off
	СписокСвязанных = ЭтотОбъект["ДССвязанные"];
	СписокСвязанных.ПроизвольныйЗапрос = Истина;
	СписокСвязанных.ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СвязанныеДокументы.Ссылка КАК Ссылка
	|ИЗ
	|	КритерийОтбора.СвязанныеДокументы(&Ссылка) КАК СвязанныеДокументы
	|
	|УПОРЯДОЧИТЬ ПО
	|	СвязанныеДокументы.Ссылка.Дата";
	// BSLLS:QueryNestedFieldsByDot-on

	ПустойЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();
	СписокТоваров.Параметры.УстановитьЗначениеПараметра("Ссылка", ПустойЗаказ);
	СписокСвязанных.Параметры.УстановитьЗначениеПараметра("Ссылка", ПустойЗаказ);

КонецПроцедуры

&НаСервере
Функция ДобавитьТаблицуСписка(Родитель, Имя, ИмяСписка, РастягиватьПоВертикали)

	Если Родитель = Неопределено Тогда
		Таблица = Элементы.Добавить(Имя, Тип("ТаблицаФормы"));
	Иначе
		Таблица = Элементы.Добавить(Имя, Тип("ТаблицаФормы"), Родитель);
	КонецЕсли;
	Таблица.ПутьКДанным = ИмяСписка;
	Таблица.РастягиватьПоГоризонтали = Истина;
	Таблица.РастягиватьПоВертикали = РастягиватьПоВертикали;
	Таблица.ИзменятьСоставСтрок = Ложь;
	Таблица.ИзменятьПорядокСтрок = Ложь;
	Если Не РастягиватьПоВертикали Тогда
		Таблица.ВысотаВСтрокахТаблицы = 5;
	КонецЕсли;
	Возврат Таблица;

КонецФункции

&НаСервере
Функция ДобавитьКолонкуСписка(Таблица, ИмяПоля)

	Колонка = Элементы.Добавить(Таблица.Имя + ИмяПоля, Тип("ПолеФормы"), Таблица);
	Колонка.Вид = ВидПоляФормы.ПолеНадписи;
	Колонка.ПутьКДанным = Таблица.ПутьКДанным + "." + ИмяПоля;
	Возврат Колонка;

КонецФункции

&НаКлиенте
Процедура Подключаемый_ЗаказыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Заказ = ?(ТекущиеДанные = Неопределено,
		ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка"), ТекущиеДанные.Ссылка);
	ЭтотОбъект["ДСТоварыЗаказа"].Параметры.УстановитьЗначениеПараметра("Ссылка", Заказ);
	ЭтотОбъект["ДССвязанные"].Параметры.УстановитьЗначениеПараметра("Ссылка", Заказ);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ссылка = Элемент.ТекущиеДанные.Ссылка;
	ПараметрыОткрытия = Новый Структура("Ключ", Ссылка);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДокумента", ЭтотОбъект);
	ОткрытьФорму(ИмяФормыОбъекта(Ссылка), ПараметрыОткрытия, ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияДокумента(Результат, ДопПараметры) Экспорт

	Элементы.ТаблицаЗаказы.Обновить();
	Элементы.ТаблицаСвязанные.Обновить();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяФормыОбъекта(Знач Ссылка)

	Возврат Ссылка.Метаданные().ПолноеИмя() + ".ФормаОбъекта";

КонецФункции

// BSLLS:DuplicateStringLiteral-on

#КонецОбласти
