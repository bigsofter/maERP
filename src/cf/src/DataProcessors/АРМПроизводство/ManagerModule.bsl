КонецФункции

// Результат записи или удаления строк «Продукции».
//
// Возвращаемое значение:
//  Структура:
//   * Успех        - Булево - заказ записан.
//   * Текст        - Строка - причина отказа с сообщениями документа.
//   * Перечитать   - Булево - заказ изменён в базе: форме нужно перечитать таблицу.
//   * ЗаказПомечен - Булево - черновик без строк помечен на удаление.
//   * Заказ        - ДокументСсылка.ЗаказПокупателя - записанный заказ.
//   * НомерСтроки  - Число - номер записанной строки в заказе.
//   * СтрокиЗаказа - Массив из Структура - все строки записанного заказа (колонки см. НоваяТаблицаПродукции): номера
//                    строк после удаления сдвигаются, форма заменяет строки этого заказа целиком.
//
Функция НовыйРезультатЗаписи()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("Перечитать", Ложь);
	Результат.Вставить("ЗаказПомечен", Ложь);
	Результат.Вставить("Заказ", Документы.ЗаказПокупателя.ПустаяСсылка());
	Результат.Вставить("НомерСтроки", 0);
	Результат.Вставить("СтрокиЗаказа", Новый Массив);
	Возврат Результат;

КонецФункции

// Проверка строки без записи и без блокировок. Записанная строка с верными значениями, отклонённая заказом (проведён или
// помечен в другом месте), требует перечитать таблицу.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтроки.
//  Результат    - Структура - см. НовыйРезультатЗаписи, получает текст отказа и признак перечитывания.
//
// Возвращаемое значение:
//  Булево - Истина, если строку можно записывать.
//
Функция ПроверитьСтрокуДоЗаписи(ДанныеСтроки, Результат)

	Результат.Текст = ТекстЗапретаПравкиСтроки(ДанныеСтроки);
	Если ПустаяСтрока(Результат.Текст) Тогда
		Возврат Истина;
	КонецЕсли;
	КлючВерен = ТипЗнч(ДанныеСтроки) = Тип("Структура") И ТипыКлючаСтрокиВерны(ДанныеСтроки);
	Если КлючВерен И ДанныеСтроки.НомерСтроки > 0 Тогда
		Результат.Перечитать = ПустаяСтрока(ТекстЗапретаЗначенийСтроки(ДанныеСтроки));
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Заказ, в который пишется строка: заблокированный существующий или новый черновик клиента.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтроки.
//  Результат    - Структура - см. НовыйРезультатЗаписи, получает текст отказа.
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя, Неопределено - заказ или отказ.
//
Функция ЗаказДляСтроки(ДанныеСтроки, Результат)

	Если Не ЗначениеЗаполнено(ДанныеСтроки.Заказ) Тогда
		Возврат НовыйЧерновик(ДанныеСтроки.Клиент);
	КонецЕсли;
	// Новой строке номера строк не нужны: версию сверяет только правка записанной строки.
	Версия = ?(ДанныеСтроки.НомерСтроки > 0, ДанныеСтроки.ВерсияДанных, "");
	Возврат ЗаблокированныйЗаказ(ДанныеСтроки.Заказ, ДанныеСтроки.Клиент, Версия, Результат);

КонецФункции

// Проверка ключа строки: типы значений, клиент, согласованность заказа, номера строки и версии.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтроки.
//  ДляУдаления  - Булево - удаляется записанная строка.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - ключ верен.
//
Функция ТекстЗапретаКлючаСтроки(ДанныеСтроки, ДляУдаления)

	Если ТипЗнч(ДанныеСтроки) <> Тип("Структура") Или Не ТипыКлючаСтрокиВерны(ДанныеСтроки) Тогда
		Возврат ТекстНеверныеДанныеСтроки();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДанныеСтроки.Клиент) Тогда
		Возврат НСтр("ru = 'Укажите клиента.'; fr = 'Indiquez le client.'; en = 'Specify the customer.';
			|es = 'Indique el cliente.'");
	КонецЕсли;
	ЗаписаннаяСтрока = ДанныеСтроки.НомерСтроки > 0;
	КлючЗаписаннойНеполон = Не ЗначениеЗаполнено(ДанныеСтроки.Заказ) Или ПустаяСтрока(ДанныеСтроки.ВерсияДанных);
	КлючНеверен = ЗаписаннаяСтрока И КлючЗаписаннойНеполон Или ДляУдаления И Не ЗаписаннаяСтрока;
	Если КлючНеверен Тогда
		Возврат ТекстНеверныеДанныеСтроки();
	КонецЕсли;
	Возврат "";

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтроки.
//
// Возвращаемое значение:
//  Булево - Истина, если заказ, клиент, номер строки и версия переданы значениями своих типов.
//
Функция ТипыКлючаСтрокиВерны(ДанныеСтроки)

	ТипыВерны = ТипЗнч(СвойствоИлиНеопределено(ДанныеСтроки, "Заказ")) = Тип("ДокументСсылка.ЗаказПокупателя");
	ТипыВерны = ТипыВерны И ТипЗнч(СвойствоИлиНеопределено(ДанныеСтроки, "Клиент")) = Тип("СправочникСсылка.Контрагенты");
	ТипыВерны = ТипыВерны И ТипЗнч(СвойствоИлиНеопределено(ДанныеСтроки, "НомерСтроки")) = Тип("Число");
	ТипыВерны = ТипыВерны И ТипЗнч(СвойствоИлиНеопределено(ДанныеСтроки, "ВерсияДанных")) = Тип("Строка");
	Возврат ТипыВерны;

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтроки.
//
// Возвращаемое значение:
//  Строка - текст запрета значений строки (продукция, количество, цена); пустая строка - значения верны.
//
Функция ТекстЗапретаЗначенийСтроки(ДанныеСтроки)

	Если Не ТипыЗначенийСтрокиВерны(ДанныеСтроки) Тогда
		Возврат ТекстНеверныеДанныеСтроки();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДанныеСтроки.Номенклатура) Тогда
		Возврат НСтр("ru = 'Укажите продукцию.'; fr = 'Indiquez le produit.'; en = 'Specify the product.';
			|es = 'Indique el producto.'");
	КонецЕсли;
	Если ДанныеСтроки.КоличествоУпаковок <= 0 Тогда
		Возврат НСтр("ru = 'Укажите количество больше нуля.'; fr = 'Indiquez une quantité supérieure à zéro.';
			|en = 'Specify a quantity greater than zero.'; es = 'Indique una cantidad mayor que cero.'");
	КонецЕсли;
	// Цену меняет только тот, кому видны суммы: колонка цены у остальных скрыта.
	ЦенаНедопустима = ДанныеСтроки.Цена < 0 Или Не ПоказыватьСуммы();
	Если ДанныеСтроки.ЦенаИзменена И ЦенаНедопустима Тогда
		Возврат ТекстНеверныеДанныеСтроки();
	КонецЕсли;
	Возврат "";

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтроки.
//
// Возвращаемое значение:
//  Булево - Истина, если значения строки переданы значениями своих типов.
//
Функция ТипыЗначенийСтрокиВерны(ДанныеСтроки)

	ТипыВерны = ТипЗнч(СвойствоИлиНеопределено(ДанныеСтроки, "Номенклатура")) = Тип("СправочникСсылка.Номенклатура");
	ТипыВерны = ТипыВерны И ТипЗнч(СвойствоИлиНеопределено(ДанныеСтроки, "Характеристика"))
		= Тип("СправочникСсылка.ХарактеристикиНоменклатуры");
	ТипыВерны = ТипыВерны И ТипЗнч(СвойствоИлиНеопределено(ДанныеСтроки, "Упаковка"))
		= Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения");
	ТипЧисла = Тип("Число");
	ТипыВерны = ТипыВерны И ТипЗнч(СвойствоИлиНеопределено(ДанныеСтроки, "КоличествоУпаковок")) = ТипЧисла;
	ТипыВерны = ТипыВерны И ТипЗнч(СвойствоИлиНеопределено(ДанныеСтроки, "Цена")) = ТипЧисла;
	ТипыВерны = ТипыВерны И ТипЗнч(СвойствоИлиНеопределено(ДанныеСтроки, "ЦенаИзменена")) = Тип("Булево");
	Возврат ТипыВерны;

КонецФункции

// Параметры:
//  Клиент       - СправочникСсылка.Контрагенты - клиент строки.
//  ДатаОтгрузки - Дата - дата отгрузки заказа.
//
// Возвращаемое значение:
//  Строка - текст запрета отгрузок клиенту, как у формы заказа; пустая строка - отгружать можно.
//
Функция ТекстЗапретаОтгрузки(Клиент, ДатаОтгрузки)

	Если Не РаботаСДокументамиВызовСервера.КлиентуЗапрещеноОтгружать(ГоловнойКонтрагент(Клиент), ДатаОтгрузки) Тогда
		Возврат "";
	КонецЕсли;
	Возврат НСтр("ru = 'Клиенту запрещено отгружать: есть неоплаченные отгрузки сверх отсрочки и кредита по договору.';
		|fr = 'Il est interdit d''expédier à ce client : des expéditions impayées dépassent le délai et le crédit du contrat.';
		|en = 'Shipping to this customer is blocked: unpaid shipments exceed the agreed deferral and credit.';
		|es = 'Está prohibido enviar a este cliente: hay envíos impagados que superan el aplazamiento y el crédito del contrato.'");

КонецФункции

// Запрет правки строк заказа - и по данным базы, и по заблокированному объекту.
//
// Параметры:
//  Реквизиты - Структура, ДокументОбъект.ЗаказПокупателя - ВидОперации, Проведен, ПометкаУдаления, Контрагент.
//  Клиент    - СправочникСсылка.Контрагенты - клиент строки.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - строки заказа можно менять.
//
Функция ТекстЗапретаЗаказа(Реквизиты, Клиент)

	Если Реквизиты.ВидОперации <> Перечисления.ВидыОперацийЗаказаПокупателя.Производство Тогда
		Возврат НСтр("ru = 'Это не заказ на производство: строки продаж меняются в форме заказа.';
			|fr = 'Ce n''est pas une commande en production : les lignes de vente se modifient dans la commande.';
			|en = 'This is not a production order: sales lines are changed in the order form.';
			|es = 'No es un pedido para producción: las líneas de venta se modifican en el formulario del pedido.'");
	КонецЕсли;
	Если Реквизиты.Проведен Тогда
		Возврат ТекстЗаказПроведен();
	КонецЕсли;
	Если Реквизиты.ПометкаУдаления Тогда
		Возврат НСтр("ru = 'Заказ помечен на удаление.'; fr = 'La commande est marquée pour suppression.';
			|en = 'The order is marked for deletion.'; es = 'El pedido está marcado para eliminar.'");
	КонецЕсли;
	Если Реквизиты.Контрагент <> ГоловнойКонтрагент(Клиент) Тогда
		Возврат НСтр("ru = 'Заказ оформлен на другого клиента.'; fr = 'La commande est établie pour un autre client.';
			|en = 'The order belongs to another customer.'; es = 'El pedido pertenece a otro cliente.'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Головной контрагент, как у ОбщегоНазначенияВызовСервера.ПолучитьДанныеКонтрагента: обособленное подразделение
// заменяется родителем, заказ формы оформляется на него.
//
// Параметры:
//  Клиент - СправочникСсылка.Контрагенты - клиент строки.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты - контрагент заказа.
//
Функция ГоловнойКонтрагент(Клиент)

	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат Клиент;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Клиент, "Родитель, ВидКонтрагента");
	ЭтоПодразделение = Реквизиты.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ОбособленноеПодразделение;
	Если ЗначениеЗаполнено(Реквизиты.Родитель) И ЭтоПодразделение Тогда
		Возврат Реквизиты.Родитель;
	КонецЕсли;
	Возврат Клиент;

КонецФункции

// Черновик заказа на производство, заполненный как форма заказа при выборе клиента.
//
// Параметры:
//  Клиент - СправочникСсылка.Контрагенты - клиент строки.
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя - незаписанный черновик.
//
Функция НовыйЧерновик(Клиент)

	ЗаказОбъект = Документы.ЗаказПокупателя.СоздатьДокумент();
	ЗаказОбъект.Заполнить(Неопределено);
	ЗаказОбъект.Дата = ТекущаяДатаСеанса();
	ЗаказОбъект.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Если Не ЗначениеЗаполнено(ЗаказОбъект.Организация) Тогда
		ЗаказОбъект.Организация = ЕдинственнаяОрганизация();
	КонецЕсли;
	ДанныеКлиента = ДанныеКлиентаЗаказа(Клиент, ЗаказОбъект);
	ЗаказОбъект.Контрагент = ДанныеКлиента.Контрагент;
	ЗаказОбъект.Договор = ДанныеКлиента.Договор;
	Если ЗначениеЗаполнено(ДанныеКлиента.Менеджер) Тогда
		ЗаказОбъект.Менеджер = ДанныеКлиента.Менеджер;
	КонецЕсли;
	Если ТипЗнч(ДанныеКлиента.ЦенаВключаетНДС) = Тип("Булево") Тогда
		ЗаказОбъект.ЦенаВключаетНДС = ДанныеКлиента.ЦенаВключаетНДС;
	КонецЕсли;
	Возврат ЗаказОбъект;

КонецФункции

// Организация черновика, когда у пользователя она не задана: единственная организация базы. Организаций несколько -
// пустая, запись черновика откажет проверкой заполнения, как форма заказа.
//
// Возвращаемое значение:
//  СправочникСсылка.Организации - организация или пустая ссылка.
//
Функция ЕдинственнаяОрганизация()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организации.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 И Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

// Параметры:
//  Клиент      - СправочникСсылка.Контрагенты - клиент.
//  ЗаказОбъект - ДокументОбъект.ЗаказПокупателя - заказ: организация и дата.
//
// Возвращаемое значение:
//  Структура - см. ОбщегоНазначенияВызовСервера.ПолучитьДанныеКонтрагента.
//
Функция ДанныеКлиентаЗаказа(Клиент, ЗаказОбъект)

	ВидДоговора = Перечисления.ВидыДоговоров.СПокупателем;
	Возврат ОбщегоНазначенияВызовСервера.ПолучитьДанныеКонтрагента(Клиент, ЗаказОбъект.Организация, ВидДоговора,
		ЗаказОбъект.Дата);

КонецФункции

// Заказ для правки строк: объект, объектная блокировка, повторная проверка по объекту и сверка версии.
//
// Параметры:
//  Заказ        - ДокументСсылка.ЗаказПокупателя - заказ.
//  Клиент       - СправочникСсылка.Контрагенты - клиент строки.
//  ВерсияДанных - Строка - версия, с которой строка прочитана; пустая - новая строка в выбранный черновик.
//  Результат    - Структура - см. НовыйРезультатЗаписи, получает текст отказа.
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя, Неопределено - заблокированный заказ или отказ.
//
Функция ЗаблокированныйЗаказ(Заказ, Клиент, ВерсияДанных, Результат)

	ЗаказОбъект = Заказ.ПолучитьОбъект();
	Если ЗаказОбъект = Неопределено Тогда
		Результат.Перечитать = Истина;
		Результат.Текст = ТекстЗаказИзменен();
		Возврат Неопределено;
	КонецЕсли;
	Если Не ЗаблокироватьЗаказ(ЗаказОбъект, Результат) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не ПустаяСтрока(ВерсияДанных) И ЗаказОбъект.ВерсияДанных <> ВерсияДанных Тогда
		Результат.Перечитать = Истина;
		Результат.Текст = ТекстЗаказИзменен();
		Возврат Неопределено;
	КонецЕсли;
	Результат.Текст = ТекстЗапретаЗаказа(ЗаказОбъект, Клиент);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		Результат.Перечитать = Истина;
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЗаказОбъект;

КонецФункции

// Параметры:
//  ЗаказОбъект - ДокументОбъект.ЗаказПокупателя - заказ.
//  Результат   - Структура - см. НовыйРезультатЗаписи, получает текст отказа.
//
// Возвращаемое значение:
//  Булево - Истина, если объектная блокировка получена.
//
Функция ЗаблокироватьЗаказ(ЗаказОбъект, Результат)

	Попытка
		ЗаказОбъект.Заблокировать();
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Шаблон = НСтр("ru = 'Заказ %1 сейчас редактирует другой пользователь: %2';
			|fr = 'La commande %1 est en cours de modification par un autre utilisateur : %2';
			|en = 'Order %1 is being edited by another user: %2';
			|es = 'Otro usuario está editando el pedido %1: %2'");
		Результат.Текст = СтрШаблон(Шаблон, ЗаказОбъект.Ссылка, ТекстОшибки);
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

// Переносит значения строки формы в строку товаров заказа. Цена, изменённая пользователем, считается от цены,
// материалы - копией строки той же продукции или по техкарте, только при новой номенклатуре.
//
// Параметры:
//  ЗаказОбъект   - ДокументОбъект.ЗаказПокупателя - заблокированный или новый заказ.
//  СтрокаТоваров - СтрокаТабличнойЧасти, Неопределено - изменяемая строка; не задана - новая строка.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтроки.
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти - строка товаров заказа.
//
Функция ПрименитьДанныеСтроки(ЗаказОбъект, Знач СтрокаТоваров, ДанныеСтроки)

	НоваяНоменклатура = СтрокаТоваров = Неопределено;
	Если НоваяНоменклатура Тогда
		СтрокаТоваров = ЗаказОбъект.ТЧТовары.Добавить();
		СтрокаТоваров.ВидЦены = ДанныеКлиентаЗаказа(ЗаказОбъект.Контрагент, ЗаказОбъект).ВидЦены;
	Иначе
		НоваяНоменклатура = СтрокаТоваров.Номенклатура <> ДанныеСтроки.Номенклатура;
		Если НоваяНоменклатура Тогда
			ОсвободитьКодСтроки(ЗаказОбъект, СтрокаТоваров);
		КонецЕсли;
	КонецЕсли;

	Если НоваяНоменклатура Тогда
		УстановитьНоменклатуруСтроки(ЗаказОбъект, СтрокаТоваров, ДанныеСтроки);
	Иначе
		ОбновитьЗначенияСтроки(ЗаказОбъект, СтрокаТоваров, ДанныеСтроки);
	КонецЕсли;
	Если ДанныеСтроки.ЦенаИзменена Тогда
		СтрокаТоваров.Цена = ДанныеСтроки.Цена;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ЗаказОбъект.ЦенаВключаетНДС, "Цена");
	Иначе
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ЗаказОбъект.ЦенаВключаетНДС);
	КонецЕсли;

	Если НоваяНоменклатура И Не СкопироватьМатериалыПродукции(ЗаказОбъект, СтрокаТоваров) Тогда
		СтрокиТоваров = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаТоваров);
		Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(ЗаказОбъект.ТЧТовары, ЗаказОбъект.ТЧМатериалы,
			ЗаказОбъект.Дата, СтрокиТоваров, Истина, ЗаказОбъект);
	КонецЕсли;
	Возврат СтрокаТоваров;

КонецФункции

// Новая номенклатура строки: параметры номенклатуры, как при выборе в форме заказа, затем значения пользователя и цена
// по ним. Установка параметров ставит упаковкой единицу номенклатуры, поэтому выбор пользователя возвращается после неё.
//
// Параметры:
//  ЗаказОбъект   - ДокументОбъект.ЗаказПокупателя - заказ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка товаров.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтроки.
//
Процедура УстановитьНоменклатуруСтроки(ЗаказОбъект, СтрокаТоваров, ДанныеСтроки)

	СтрокаТоваров.Номенклатура = ДанныеСтроки.Номенклатура;
	РаботаСДокументамиКлиентСервер.УстановитьПараметрыНоменклатуры(СтрокаТоваров, ЗаказОбъект);
	СтрокаТоваров.Характеристика = ДанныеСтроки.Характеристика;
	Если ЗначениеЗаполнено(ДанныеСтроки.Упаковка) Тогда
		СтрокаТоваров.Упаковка = ДанныеСтроки.Упаковка;
	КонецЕсли;
	СтрокаТоваров.КоличествоУпаковок = ДанныеСтроки.КоличествоУпаковок;
	РаботаСДокументамиКлиентСервер.УстановитьЦенуНоменклатуры(СтрокаТоваров, ЗаказОбъект);

КонецПроцедуры

// Прежняя номенклатура строки: смена характеристики или упаковки перечитывает цену; материалы при смене количества
// пересчитывает ПередЗаписью заказа.
//
// Параметры:
//  ЗаказОбъект   - ДокументОбъект.ЗаказПокупателя - заказ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка товаров.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтроки.
//
Процедура ОбновитьЗначенияСтроки(ЗаказОбъект, СтрокаТоваров, ДанныеСтроки)

	НоваяУпаковка = ЗначениеЗаполнено(ДанныеСтроки.Упаковка) И СтрокаТоваров.Упаковка <> ДанныеСтроки.Упаковка;
	ЦенаПоСтроке = НоваяУпаковка Или СтрокаТоваров.Характеристика <> ДанныеСтроки.Характеристика;
	СтрокаТоваров.Характеристика = ДанныеСтроки.Характеристика;
	Если НоваяУпаковка Тогда
		СтрокаТоваров.Упаковка = ДанныеСтроки.Упаковка;
	КонецЕсли;
	СтрокаТоваров.КоличествоУпаковок = ДанныеСтроки.КоличествоУпаковок;
	Если ЦенаПоСтроке Тогда
		РаботаСДокументамиКлиентСервер.УстановитьЦенуНоменклатуры(СтрокаТоваров, ЗаказОбъект);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  СтрокаТоваров - СтрокаТабличнойЧасти - записанная строка товаров заказа.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтроки.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь закончил редактирование строки без правок.
//
Функция СтрокаНеИзменилась(СтрокаТоваров, ДанныеСтроки)

	Совпадает = СтрокаТоваров.Номенклатура = ДанныеСтроки.Номенклатура
		И СтрокаТоваров.Характеристика = ДанныеСтроки.Характеристика
		И СтрокаТоваров.КоличествоУпаковок = ДанныеСтроки.КоличествоУпаковок;
	УпаковкаПрежняя = Не ЗначениеЗаполнено(ДанныеСтроки.Упаковка) Или СтрокаТоваров.Упаковка = ДанныеСтроки.Упаковка;
	ЦенаПрежняя = Не ДанныеСтроки.ЦенаИзменена Или СтрокаТоваров.Цена = ДанныеСтроки.Цена;
	Возврат Совпадает И УпаковкаПрежняя И ЦенаПрежняя;

КонецФункции

// Одна продукция производится в заказе по одному составу (ПроверитьСоставОднойПродукции): вторая строка той же
// продукции получает материалы строки, уже заполненной и, возможно, поправленной в форме заказа, а не текущую карту.
//
// Параметры:
//  ЗаказОбъект   - ДокументОбъект.ЗаказПокупателя - заказ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - новая строка продукции.
//
// Возвращаемое значение:
//  Булево - Истина, если материалы скопированы.
//
Функция СкопироватьМатериалыПродукции(ЗаказОбъект, СтрокаТоваров)

	Исходные = МатериалыТойЖеПродукции(ЗаказОбъект, СтрокаТоваров);
	Если Исходные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Документы.ЗаказПокупателя.ОбеспечитьКодыСтрокТоваров(ЗаказОбъект.ТЧТовары,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаТоваров));
	СтрокаТоваров.Техкарта = Исходные.Техкарта;
	Для Каждого Исходный Из Исходные.Материалы Цикл
		Материал = ЗаказОбъект.ТЧМатериалы.Добавить();
		ЗаполнитьЗначенияСвойств(Материал, Исходный);
		Материал.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ЗаказОбъект.ТЧМатериалы);
		Материал.КодСтрокиПродукции = СтрокаТоваров.КодСтроки;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Параметры:
//  ЗаказОбъект   - ДокументОбъект.ЗаказПокупателя - заказ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - новая строка продукции.
//
// Возвращаемое значение:
//  Структура, Неопределено - Техкарта и Материалы (массив строк материалов) другой строки той же продукции с
//                            материалами; такой строки нет - Неопределено.
//
Функция МатериалыТойЖеПродукции(ЗаказОбъект, СтрокаТоваров)

	Для Каждого ДругаяСтрока Из ЗаказОбъект.ТЧТовары Цикл
		ТаЖеПродукция = ДругаяСтрока <> СтрокаТоваров И ДругаяСтрока.Номенклатура = СтрокаТоваров.Номенклатура;
		Если Не ТаЖеПродукция Или ДругаяСтрока.КодСтроки = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("КодСтрокиПродукции", ДругаяСтрока.КодСтроки);
		Материалы = ЗаказОбъект.ТЧМатериалы.НайтиСтроки(Отбор);
		Если Материалы.Количество() > 0 Тогда
			Возврат Новый Структура("Техкарта, Материалы", ДругаяСтрока.Техкарта, Материалы);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Удаляет строки одного заказа: номера строк действительны только при совпавшей версии, поэтому удаление - с конца.
//
// Параметры:
//  СтрокиДанных - Массив из Структура - см. НовыеДанныеСтроки; строки одного заказа.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЗаписи.
//
Функция УдалитьСтрокиЗаказа(СтрокиДанных)

	Результат = НовыйРезультатЗаписи();
	Первая = СтрокиДанных[0];
	ЗаказОбъект = Неопределено;
	Номера = Неопределено;
	Если ВерсииСтрокСовпадают(СтрокиДанных) Тогда
		ЗаказОбъект = ЗаблокированныйЗаказ(Первая.Заказ, Первая.Клиент, Первая.ВерсияДанных, Результат);
	КонецЕсли;
	Если ЗаказОбъект <> Неопределено Тогда
		Номера = НомераУдаляемыхСтрок(ЗаказОбъект, СтрокиДанных);
	КонецЕсли;
	Если Номера = Неопределено Тогда
		Если ПустаяСтрока(Результат.Текст) Тогда
			Результат.Перечитать = Истина;
			Результат.Текст = ТекстЗаказИзменен();
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Для Каждого ЭлементНомера Из Номера Цикл
		СтрокаТоваров = ЗаказОбъект.ТЧТовары[ЭлементНомера.Значение - 1];
		УдалитьМатериалыСвоегоКода(ЗаказОбъект, СтрокаТоваров);
		ЗаказОбъект.ТЧТовары.Удалить(СтрокаТоваров);
	КонецЦикла;

	Если ЗаказОбъект.ТЧТовары.Количество() > 0 Тогда
		Если ЗаписатьЗаказ(ЗаказОбъект, РежимЗаписиДокумента.Запись, Результат) Тогда
			ЗаполнитьСтрокиЗаказа(Результат, ЗаказОбъект);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	// Строки черновика в базе не трогаются: заказ без строк не пишется, а помечается на удаление с прежним составом.
	ЗаказОбъект.Прочитать();
	Результат.ЗаказПомечен = ПометитьЗаказ(ЗаказОбъект, Результат);
	Возврат Результат;

КонецФункции

// Удаляет материалы строки товаров, только если её код ненулевой и единственный в заказе: у нулевого кода материалов
// нет, повторный код (данные загрузки) принадлежит и другой строке, а её материалы трогать нельзя.
//
// Параметры:
//  ЗаказОбъект   - ДокументОбъект.ЗаказПокупателя - заказ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка товаров.
//
Процедура УдалитьМатериалыСвоегоКода(ЗаказОбъект, СтрокаТоваров)

	Отбор = Новый Структура("КодСтроки", СтрокаТоваров.КодСтроки);
	КодЕдинственный = ЗаказОбъект.ТЧТовары.НайтиСтроки(Отбор).Количество() = 1;
	Если СтрокаТоваров.КодСтроки <> 0 И КодЕдинственный Тогда
		Документы.ЗаказПокупателя.УдалитьМатериалыСтроки(ЗаказОбъект.ТЧМатериалы, СтрокаТоваров.КодСтроки);
	КонецЕсли;

КонецПроцедуры

// Строка сменила продукцию: её материалы удаляются, а повторный ненулевой код (данные загрузки) заменяется новым - иначе
// заполнение по карте удалило бы материалы другой строки с тем же кодом.
//
// Параметры:
//  ЗаказОбъект   - ДокументОбъект.ЗаказПокупателя - заказ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка товаров.
//
Процедура ОсвободитьКодСтроки(ЗаказОбъект, СтрокаТоваров)

	Отбор = Новый Структура("КодСтроки", СтрокаТоваров.КодСтроки);
	КодПовторный = СтрокаТоваров.КодСтроки <> 0 И ЗаказОбъект.ТЧТовары.НайтиСтроки(Отбор).Количество() > 1;
	Если Не КодПовторный Тогда
		УдалитьМатериалыСвоегоКода(ЗаказОбъект, СтрокаТоваров);
		Возврат;
	КонецЕсли;
	МаксимальныйКод = 0;
	Для Каждого ДругаяСтрока Из ЗаказОбъект.ТЧТовары Цикл
		МаксимальныйКод = Макс(МаксимальныйКод, ДругаяСтрока.КодСтроки);
	КонецЦикла;
	СтрокаТоваров.КодСтроки = МаксимальныйКод + 1;
	СтрокаТоваров.Техкарта = Документы.ТехнологическаяКарта.ПустаяСсылка();

КонецПроцедуры

// Параметры:
//  СтрокиДанных - Массив из Структура - см. НовыеДанныеСтроки.
//
// Возвращаемое значение:
//  Булево - Истина, если все строки прочитаны с одной версией заказа.
//
Функция ВерсииСтрокСовпадают(СтрокиДанных)

	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		Если ДанныеСтроки.ВерсияДанных <> СтрокиДанных[0].ВерсияДанных Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Параметры:
//  ЗаказОбъект  - ДокументОбъект.ЗаказПокупателя - заблокированный заказ.
//  СтрокиДанных - Массив из Структура - см. НовыеДанныеСтроки.
//
// Возвращаемое значение:
//  СписокЗначений, Неопределено - номера удаляемых строк по убыванию; номер вне заказа - Неопределено.
//
Функция НомераУдаляемыхСтрок(ЗаказОбъект, СтрокиДанных)

	Номера = Новый СписокЗначений;
	ЧислоСтрок = ЗаказОбъект.ТЧТовары.Количество();
	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		Если ДанныеСтроки.НомерСтроки > ЧислоСтрок Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Номера.НайтиПоЗначению(ДанныеСтроки.НомерСтроки) = Неопределено Тогда
			Номера.Добавить(ДанныеСтроки.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	Номера.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	Возврат Номера;

КонецФункции

// Параметры:
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ.
//  Действие - Строка - см. ДействиеВРаботу, ДействиеВЧерновик, ДействиеОтменить.
//
// Возвращаемое значение:
//  Структура - Заказ, Успех, Текст; см. ИзменитьСтатусЗаказов.
//
Функция ВыполнитьДействиеСтатуса(Заказ, Действие)

	Итог = Новый Структура("Заказ, Успех, Текст", Заказ, Ложь, "");
	Итог.Текст = ТекстЗапретаСтатуса(Заказ, Действие);
	Если Не ПустаяСтрока(Итог.Текст) Тогда
		Возврат Итог;
	КонецЕсли;
	РезультатЗаписи = НовыйРезультатЗаписи();
	ЗаказОбъект = Заказ.ПолучитьОбъект();
	Если ЗаказОбъект = Неопределено Тогда
		Итог.Текст = ТекстЗаказИзменен();
		Возврат Итог;
	КонецЕсли;
	Если Не ЗаблокироватьЗаказ(ЗаказОбъект, РезультатЗаписи) Тогда
		Итог.Текст = РезультатЗаписи.Текст;
		Возврат Итог;
	КонецЕсли;
	// Между проверкой и блокировкой заказ могли провести или пометить: повтор по заблокированному объекту. Проведение
	// запрещено и клиенту с запретом отгрузок - как в форме заказа.
	Итог.Текст = ТекстЗапретаДействия(ЗаказОбъект, Действие);
	Если ПустаяСтрока(Итог.Текст) И Действие = ДействиеВРаботу() Тогда
		Итог.Текст = ТекстЗапретаОтгрузки(ЗаказОбъект.Контрагент, ЗаказОбъект.ДатаОтгрузки);
	КонецЕсли;
	Если Не ПустаяСтрока(Итог.Текст) Тогда
		Возврат Итог;
	КонецЕсли;
	Если Действие = ДействиеОтменить() Тогда
		Итог.Успех = ПометитьЗаказ(ЗаказОбъект, РезультатЗаписи);
	ИначеЕсли Действие = ДействиеВРаботу() Тогда
		Итог.Успех = ЗаписатьЗаказ(ЗаказОбъект, РежимЗаписиДокумента.Проведение, РезультатЗаписи);
	Иначе
		Итог.Успех = ЗаписатьЗаказ(ЗаказОбъект, РежимЗаписиДокумента.ОтменаПроведения, РезультатЗаписи);
	КонецЕсли;
	Итог.Текст = РезультатЗаписи.Текст;
	Возврат Итог;

КонецФункции

// Запрет действия кнопки «Статус» - по данным базы или по заблокированному объекту.
//
// Параметры:
//  Реквизиты - Структура, ДокументОбъект.ЗаказПокупателя - ВидОперации, Проведен, ПометкаУдаления.
//  Действие  - Строка - см. ДействиеВРаботу, ДействиеВЧерновик, ДействиеОтменить.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - действие применимо.
//
Функция ТекстЗапретаДействия(Реквизиты, Действие)

	Если Реквизиты.ПометкаУдаления Тогда
		Возврат НСтр("ru = 'Заказ уже помечен на удаление.'; fr = 'La commande est déjà marquée pour suppression.';
			|en = 'The order is already marked for deletion.'; es = 'El pedido ya está marcado para eliminar.'");
	КонецЕсли;
	Текст = "";
	Если Действие = ДействиеВРаботу() Тогда
		Если Не Документы.ЗаказПокупателя.ЗаказПроводится(Реквизиты.ВидОперации) Тогда
			Текст = НСтр("ru = 'В работу переводится только заказ на производство.';
				|fr = 'Seule une commande en production peut être lancée.';
				|en = 'Only a production order can be started.';
				|es = 'Solo un pedido para producción puede ponerse en marcha.'");
		ИначеЕсли Реквизиты.Проведен Тогда
			Текст = НСтр("ru = 'Заказ уже в работе.'; fr = 'La commande est déjà lancée.';
				|en = 'The order is already in progress.'; es = 'El pedido ya está en marcha.'");
		Иначе
			Текст = "";
		КонецЕсли;
	ИначеЕсли Действие = ДействиеВЧерновик() Тогда
		Если Не Реквизиты.Проведен Тогда
			Текст = НСтр("ru = 'Заказ и так черновик.'; fr = 'La commande est déjà un brouillon.';
				|en = 'The order is already a draft.'; es = 'El pedido ya es un borrador.'");
		КонецЕсли;
	ИначеЕсли Действие <> ДействиеОтменить() Тогда
		Текст = ТекстНеверныеДанныеСтроки();
	Иначе
		Текст = "";
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Параметры:
//  ЗаказОбъект - ДокументОбъект.ЗаказПокупателя - заказ.
//  РежимЗаписи - РежимЗаписиДокумента - запись, проведение или отмена проведения.
//  Результат   - Структура - см. НовыйРезультатЗаписи: исключение записи и сообщения документа - в текст.
//
// Возвращаемое значение:
//  Булево - Истина, если заказ записан.
//
Функция ЗаписатьЗаказ(ЗаказОбъект, РежимЗаписи, Результат)

	// Сообщения до записи (позиция без техкарты, строки только для чтения) остаются в тексте результата.
	Накопленные = ТекстСообщений();
	// Запись кодом заказ проверяет только при проведении (НужнаПроверкаЗаполненияПриЗаписи): черновик - здесь, без
	// исключения, как форма заказа.
	Если РежимЗаписи = РежимЗаписиДокумента.Запись И Не ЗаказОбъект.ПроверитьЗаполнение() Тогда
		Результат.Текст = СоединитьТексты(Накопленные, ТекстСообщений());
		Возврат Ложь;
	КонецЕсли;
	Попытка
		ЗаказОбъект.Записать(РежимЗаписи);
	Исключение
		Результат.Текст = СоединитьТексты(Накопленные, ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Заказ = ЗаказОбъект.Ссылка;
	Результат.Текст = СоединитьТексты(Накопленные, ТекстСообщений());
	Возврат Истина;

КонецФункции

// Параметры:
//  ЗаказОбъект - ДокументОбъект.ЗаказПокупателя - заказ.
//  Результат   - Структура - см. НовыйРезультатЗаписи.
//
// Возвращаемое значение:
//  Булево - Истина, если заказ помечен на удаление.
//
Функция ПометитьЗаказ(ЗаказОбъект, Результат)

	// Платформе для пометки хватает права «Изменение»; рабочее место требует и интерактивную пометку, как форма списка.
	Если Не ПравоДоступа("ИнтерактивнаяПометкаУдаления", Метаданные.Документы.ЗаказПокупателя) Тогда
		Результат.Текст = НСтр("ru = 'Нет права помечать заказы на удаление.';
			|fr = 'Aucun droit de marquer les commandes pour suppression.';
			|en = 'No right to mark orders for deletion.'; es = 'Sin derecho a marcar pedidos para eliminar.'");
		Возврат Ложь;
	КонецЕсли;
	Накопленные = ТекстСообщений();
	Попытка
		ЗаказОбъект.УстановитьПометкуУдаления(Истина);
	Исключение
		Результат.Текст = СоединитьТексты(Накопленные, ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Заказ = ЗаказОбъект.Ссылка;
	Результат.Текст = СоединитьТексты(Накопленные, ТекстСообщений());
	Возврат Истина;

КонецФункции

// Все строки записанного заказа в колонках «Продукции» - форма заменяет ими строки этого заказа.
//
// Параметры:
//  Результат   - Структура - см. НовыйРезультатЗаписи, получает СтрокиЗаказа.
//  ЗаказОбъект - ДокументОбъект.ЗаказПокупателя - записанный заказ.
//
Процедура ЗаполнитьСтрокиЗаказа(Результат, ЗаказОбъект)

	Показатели = ПоказателиЗаказа(ЗаказОбъект.Ссылка);
	СуммыВидны = ПоказыватьСуммы();
	Представление = ПредставлениеЗаказаДляВыбора(ЗаказОбъект.Номер, ЗаказОбъект.Дата, ЗаказОбъект.Контрагент,
		ЗаказОбъект.Сумма, ЗаказОбъект.ТЧТовары.Итог("Количество"), СуммыВидны);
	СтатусДокумента = ПредставлениеСтатусаДокумента(ЗаказОбъект.Проведен, ЗаказОбъект.ПометкаУдаления);
	ДанныеЗаказа = Новый Структура;
	ДанныеЗаказа.Вставить("Заказ", ЗаказОбъект.Ссылка);
	ДанныеЗаказа.Вставить("Клиент", ЗаказОбъект.Контрагент);
	ДанныеЗаказа.Вставить("ЗаказПредставление", Представление);
	ДанныеЗаказа.Вставить("ВерсияДанных", ЗаказОбъект.ВерсияДанных);
	Для Каждого Показатель Из Показатели Цикл
		ДанныеЗаказа.Вставить(Показатель.Ключ, Показатель.Значение);
	КонецЦикла;
	ДанныеЗаказа.Вставить("ДатаОтгрузки", ЗаказОбъект.ДатаОтгрузки);
	ДанныеЗаказа.Вставить("Менеджер", ЗаказОбъект.Менеджер);
	ДанныеЗаказа.Вставить("СтатусДокумента", СтатусДокумента);
	ДанныеЗаказа.Вставить("Редактируется", Не ЗаказОбъект.Проведен);
	ДанныеЗаказа.Вставить("Записана", Истина);
	Для Каждого СтрокаТоваров Из ЗаказОбъект.ТЧТовары Цикл
		Строка = Новый Структура("НомерСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Цена, Сумма");
		ЗаполнитьЗначенияСвойств(Строка, СтрокаТоваров);
		СкрытьСуммыСтроки(Строка, СуммыВидны);
		Для Каждого КлючИЗначение Из ДанныеЗаказа Цикл
			Строка.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Результат.СтрокиЗаказа.Добавить(Строка);
	КонецЦикла;

КонецПроцедуры

// Имена прав формы и документов, вводимых на основании заказа.
//
// Возвращаемое значение:
//  Структура - ключ - имя права рабочего места, значение - имя документа.
//
Функция ДокументыНаОсновании()

	Результат = Новый Структура;
	Результат.Вставить("МожноЗаказПоставщику", "ЗаказПоставщику");
	Результат.Вставить("МожноПоступление", "ПоступлениеТоваровУслуг");
	Результат.Вставить("МожноПередачу", "ПередачаВПереработку");
	Результат.Вставить("МожноОтгрузку", "РеализацияТоваровУслуг");
	Результат.Вставить("МожноВыпуск", "ВыпускПродукции");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Материалы

// Дефицит и «к поступлению» - по формулам ПотребностиПроизводства.ДефицитЗаказа и ОстатокКПоступлению.
//
// Параметры:
//  Материалы - ТаблицаЗначений - см. МатериалыЗаказа.
//
Процедура РассчитатьДефицитМатериалов(Материалы)

	ПоЗаказанному = Материалы.Итог("Заказано") <> 0;
	Для Каждого Строка Из Материалы Цикл
		// Взятое автовыпуском из общего остатка заказывать не нужно (E9).
		Строка.Дефицит = Макс(Строка.Потребность - Строка.Заказано - Строка.ИзОстатка, 0);
		Если ПоЗаказанному Тогда
			Строка.КПоступлению = Макс(Строка.Заказано - Строка.Пришло, 0);
		Иначе
			Строка.КПоступлению = Макс(Строка.Потребность - Строка.Пришло - Строка.ИзОстатка, 0);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Документы

// Параметры:
//  Таблица    - ТаблицаЗначений - см. ДокументыЗаказа.
//  Выборка    - ВыборкаИзРезультатаЗапроса - строка запроса ТекстЗапросаДокументовЗаказа.
//  СуммыВидны - Булево - сумма документа передаётся форме; иначе остаётся нулевой.
//
Процедура ДобавитьДокументЗаказа(Таблица, Выборка, СуммыВидны)

	НоваяСтрока = Таблица.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "Документ, Дата, Контрагент");
	Если СуммыВидны Тогда
		НоваяСтрока.Сумма = Выборка.Сумма;
	КонецЕсли;
	НоваяСтрока.Номер = СокрЛП(Выборка.Номер);
	НоваяСтрока.Вид = Выборка.Документ.Метаданные().Представление();
	Если ЗначениеЗаполнено(Выборка.Через) Тогда
		НоваяСтрока.Через = Выборка.Через;
	КонецЕсли;
	НоваяСтрока.Статус = ПредставлениеСтатусаДокумента(Выборка.Проведен, Выборка.ПометкаУдаления);
	Если Выборка.Автовыпуск Тогда
		НоваяСтрока.Статус = НоваяСтрока.Статус + ТекстПометкаАвтовыпуска();
	КонецЕсли;

КонецПроцедуры

// Объединение запросов по типам контура, у которых есть право чтения: критерий «Связанные документы» тянет и денежные
// документы, которых оператор производства не читает. Первый уровень - основание заказ; второй - поступления через
// заказы поставщику, возврат из переработки через передачу, автовыпуски и возвраты покупателей через реализации, возвраты
// поставщику по поступлениям обоих уровней.
//
// Возвращаемое значение:
//  Строка - текст запроса с параметром &Заказ; пустая строка - читать нечего.
//
Функция ТекстЗапросаДокументовЗаказа()

	Части = Новый Массив;
	ПервыйУровень = "Т.Основание = &Заказ";
	Для Каждого ИмяДокумента Из СтрРазделить("ЗаказПоставщику,ПоступлениеТоваровУслуг,ПередачаВПереработку,"
		+ "ПоступлениеИзПереработки,РеализацияТоваровУслуг,ВыпускПродукции", ",") Цикл
		ДобавитьЧастьЗапроса(Части, ИмяДокумента, "", ПервыйУровень, Ложь);
	КонецЦикла;

	Реализация = "РеализацияТоваровУслуг";
	Реализации = ПодзапросОснований(Реализация);
	ЗаказыПоставщику = ПодзапросОснований("ЗаказПоставщику");
	ДобавитьЧастьЗапроса(Части, "ПоступлениеТоваровУслуг", "ЗаказПоставщику", ЗаказыПоставщику, Ложь);
	Передачи = ПодзапросОснований("ПередачаВПереработку");
	ДобавитьЧастьЗапроса(Части, "ПоступлениеИзПереработки", "ПередачаВПереработку", Передачи, Ложь);
	ДобавитьЧастьЗапроса(Части, "ВыпускПродукции", Реализация, Реализации, Истина);
	ДобавитьЧастьЗапроса(Части, "ВозвратОтПокупателя", Реализация, Реализации, Ложь);
	ДобавитьЧастьЗапроса(Части, "ВозвратПоставщику", "ПоступлениеТоваровУслуг", ПодзапросПоступлений(), Ложь);

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	// РАЗРЕШЕННЫЕ первого запроса объединения действует на всё объединение.
	Части[0] = "ВЫБРАТЬ РАЗРЕШЕННЫЕ" + Сред(Части[0], СтрДлина("ВЫБРАТЬ") + 1);
	Возврат СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);

КонецФункции

// Добавляет запрос одного типа документов, если у пользователя есть право чтения его и документа-основания.
//
// Параметры:
//  Части         - Массив из Строка - запросы объединения.
//  ИмяДокумента  - Строка - имя документа контура.
//  ИмяОснования  - Строка - документ первого уровня, через который найден документ; пустая - первый уровень.
//  УсловиеИлиПодзапрос - Строка - условие первого уровня или подзапрос оснований второго уровня.
//  Автовыпуск    - Булево - документ второго уровня - автовыпуск реализации.
//
Процедура ДобавитьЧастьЗапроса(Части, ИмяДокумента, ИмяОснования, УсловиеИлиПодзапрос, Автовыпуск)

	МетаданныеДокумента = Метаданные.Документы[ИмяДокумента];
	Если Не ПравоДоступа("Чтение", МетаданныеДокумента) Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяОснования) И Не ПравоДоступа("Чтение", Метаданные.Документы[ИмяОснования]) Тогда
		Возврат;
	КонецЕсли;
	ЕстьКонтрагент = МетаданныеДокумента.Реквизиты.Найти("Контрагент") <> Неопределено;
	ЕстьСумма = МетаданныеДокумента.Реквизиты.Найти("Сумма") <> Неопределено;
	Поля = Новый Массив;
	Поля.Добавить("Т.Ссылка КАК Документ");
	Поля.Добавить(?(ЗначениеЗаполнено(ИмяОснования), "Т.Основание", "НЕОПРЕДЕЛЕНО") + " КАК Через");
	Поля.Добавить("Т.Номер КАК Номер");
	Поля.Добавить("Т.Дата КАК Дата");
	Поля.Добавить("Т.Проведен КАК Проведен");
	Поля.Добавить("Т.ПометкаУдаления КАК ПометкаУдаления");
	Поля.Добавить(?(ЕстьКонтрагент, "Т.Контрагент", "ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)") + " КАК Контрагент");
	Поля.Добавить(?(ЕстьСумма, "Т.Сумма", "0") + " КАК Сумма");
	Поля.Добавить(?(Автовыпуск, "ИСТИНА", "ЛОЖЬ") + " КАК Автовыпуск");
	Условие = ?(ЗначениеЗаполнено(ИмяОснования), "Т.Основание В (" + УсловиеИлиПодзапрос + ")", УсловиеИлиПодзапрос);
	ТекстПолей = СтрСоединить(Поля, ", ");
	ТекстЧасти = "ВЫБРАТЬ " + ТекстПолей + " ИЗ " + МетаданныеДокумента.ПолноеИмя() + " КАК Т ГДЕ " + Условие;
	Части.Добавить(ТекстЧасти);

КонецПроцедуры

// Параметры:
//  ИмяДокумента - Строка - документ первого уровня.
//
// Возвращаемое значение:
//  Строка - подзапрос ссылок документов с основанием &Заказ.
//
Функция ПодзапросОснований(ИмяДокумента)

	// Имя таблицы подставляется из метаданных. BSLLS:QueryParseError-off
	Возврат СтрШаблон("ВЫБРАТЬ О.Ссылка КАК Ссылка ИЗ %1 КАК О ГДЕ О.Основание = &Заказ",
		Метаданные.Документы[ИмяДокумента].ПолноеИмя());
	// BSLLS:QueryParseError-on

КонецФункции

// Возвращаемое значение:
//  Строка - подзапрос поступлений обоих уровней: на основании заказа и на основании его заказов поставщику.
//
Функция ПодзапросПоступлений()

	Поступления = Метаданные.Документы.ПоступлениеТоваровУслуг.ПолноеИмя();
	Условие = "П.Основание = &Заказ";
	Если ПравоДоступа("Чтение", Метаданные.Документы.ЗаказПоставщику) Тогда
		Условие = Условие + " ИЛИ П.Основание В (" + ПодзапросОснований("ЗаказПоставщику") + ")";
	КонецЕсли;
	// Имя таблицы и условие подставляются. BSLLS:QueryParseError-off
	Возврат СтрШаблон("ВЫБРАТЬ П.Ссылка КАК Ссылка ИЗ %1 КАК П ГДЕ %2", Поступления, Условие);
	// BSLLS:QueryParseError-on

КонецФункции

#КонецОбласти

#Область Закупки

// Строки документов заказа или одного документа в колонках таблиц нижних закладок формы.
//
// Параметры:
//  Вид      - Строка - см. ВидЗаказПоставщику, ВидПоступление, ВидВыпуск, ВидОтгрузка.
//  Заказ    - ДокументСсылка.ЗаказПокупателя, Неопределено - заказ на производство; не задан - строки документа.
//  Документ - ДокументСсылка, Неопределено - один документ вида.
//
// Возвращаемое значение:
//  Массив из Структура - строки; суммы обнулены у пользователя без сумм.
//
Функция СтрокиДокументов(Вид, Заказ, Документ)

	Строки = Новый Массив;
	Если Не ПравоДоступа("Чтение", Метаданные.Документы[Вид]) Тогда
		Возврат Строки;
	КонецЕсли;
	Если ЭтоВыпускИлиОтгрузка(Вид) Тогда
		Возврат СтрокиВыпусковИлиОтгрузок(Вид, Заказ, Документ);
	КонецЕсли;
	ЭтоПоступление = Вид = ВидПоступление();
	ТекстЗапроса = ?(ЭтоПоступление, ТекстЗапросаСтрокПоступлений(), ТекстЗапросаСтрокЗаказовПоставщику());
	Запрос = Новый Запрос;
	// Отбор - один документ после записи или документы заказа: у поступления основание - заказ или его заказ поставщику.
	Если Заказ = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбора", "Д.Ссылка = &Документ");
		Запрос.УстановитьПараметр("Документ", Документ);
	Иначе
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбора", "Д.Основание В (&Основания)");
		Основания = ?(ЭтоПоступление, ЗаказыПоставщикуЗаказа(Заказ), Новый Массив);
		Основания.Добавить(Заказ);
		Запрос.УстановитьПараметр("Основания", Основания);
	КонецЕсли;
	СуммыВидны = ПоказыватьСуммы();
	МожноЗавершенные = МожноПравитьЗавершенные();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура("Документ, НомерСтроки, ВерсияДанных, Поставщик, Материал, Характеристика, Упаковка,
			|КоличествоУпаковок, Цена, Сумма, Проведен");
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		СкрытьСуммыСтроки(Строка, СуммыВидны);
		Представление = ПредставлениеЗаказаДляВыбора(Выборка.Номер, Выборка.Дата, Выборка.Поставщик, Выборка.СуммаДокумента,
			Выборка.КоличествоДокумента, СуммыВидны);
		Строка.Вставить("ДокументПредставление", Представление);
		Статус = ПредставлениеСтатусаДокумента(Выборка.Проведен, Ложь);
		Строка.Вставить("Статус", Статус);
		Строка.Вставить("ДокументЗаСегодня", Выборка.Дата >= НачалоДня(ТекущаяДатаСеанса()));
		Строка.Вставить("Записана", Истина);
		Строка.Вставить("ЦенаИзменена", Ложь);
		Если ЭтоПоступление Тогда
			ДополнитьСтрокуПоступления(Строка, Выборка, МожноЗавершенные);
		Иначе
			Строка.Вставить("ДатаПоставки", Выборка.ДатаПоставки);
			Строка.Вставить("Продукция", Выборка.Продукция);
			Строка.Вставить("ТолькоПросмотр", Ложь);
		КонецЕсли;
		Строки.Добавить(Строка);
	КонецЦикла;
	Возврат Строки;

КонецФункции

// Параметры:
//  Строка           - Структура - строка поступления, получает реквизиты шапки, строку основания и признак просмотра.
//  Выборка          - ВыборкаИзРезультатаЗапроса - строка запроса ТекстЗапросаСтрокПоступлений.
//  МожноЗавершенные - Булево - см. МожноПравитьЗавершенные.
//
Процедура ДополнитьСтрокуПоступления(Строка, Выборка, МожноЗавершенные)

	Строка.Вставить("НомерВходящегоДокумента", Выборка.НомерВходящегоДокумента);
	Строка.Вставить("ДатаВходящегоДокумента", Выборка.ДатаВходящегоДокумента);
	ПоЗаказуПоставщику = ТипЗнч(Выборка.Основание) = Тип("ДокументСсылка.ЗаказПоставщику");
	Строка.Вставить("ЗаказПоставщику", ?(ПоЗаказуПоставщику, Выборка.Основание, Документы.ЗаказПоставщику.ПустаяСсылка()));
	Строка.Вставить("КодСтрокиОснования", ?(ПоЗаказуПоставщику, Выборка.КодСтроки, 0));
	Если ПоЗаказуПоставщику Тогда
		Представление = ПредставлениеСтрокиОснования(Выборка.НомерОснования, Выборка.ДатаОснования, Выборка.Материал,
			Неопределено, Неопределено);
	Иначе
		Представление = ТекстБезЗаказаПоставщику();
	КонецЕсли;
	Строка.Вставить("СтрокаОснованияПредставление", Представление);
	Завершен = Выборка.СтатусПоступления = Перечисления.СтатусыДокументов.Завершен;
	ТолькоПросмотр = ЗначениеЗаполнено(Выборка.Серия) Или Выборка.УказаноНесколькоСерий Или Выборка.ЕстьПрочиеСтроки
		Или Завершен И Не МожноЗавершенные;
	Строка.Вставить("ТолькоПросмотр", ТолькоПросмотр);

КонецПроцедуры

// Возвращаемое значение:
//  Строка - пакет: отобранные заказы поставщику, строки с итогом количества документа.
//
Функция ТекстЗапросаСтрокЗаказовПоставщику()

	Возврат
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТДокументы
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Д
	|ГДЕ
	|	НЕ Д.ПометкаУдаления
	|	И &УсловиеОтбора
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыИтога.Ссылка КАК Ссылка,
	|	СУММА(ТоварыИтога.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТИтоги
	|ИЗ
	|	Документ.ЗаказПоставщику.ТЧТовары КАК ТоварыИтога
	|ГДЕ
	|	ТоварыИтога.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыИтога.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Д.Ссылка КАК Документ,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Контрагент КАК Поставщик,
	|	Д.Сумма КАК СуммаДокумента,
	|	Д.ДатаПоставки КАК ДатаПоставки,
	|	Д.Проведен КАК Проведен,
	|	Д.ВерсияДанных КАК ВерсияДанных,
	|	ЕСТЬNULL(Итоги.Количество, 0) КАК КоличествоДокумента,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Номенклатура КАК Материал,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Упаковка КАК Упаковка,
	|	Т.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Т.Цена КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	Т.Продукция КАК Продукция
	|ИЗ
	|	ВТДокументы КАК Отобранные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Д
	|		ПО Д.Ссылка = Отобранные.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.ТЧТовары КАК Т
	|		ПО Т.Ссылка = Отобранные.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИтоги КАК Итоги
	|		ПО Итоги.Ссылка = Отобранные.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Документ,
	|	НомерСтроки";

КонецФункции

// Возвращаемое значение:
//  Строка - пакет: отобранные поступления, документы с услугами, доп. расходами или авансами, строки с шапкой.
//
Функция ТекстЗапросаСтрокПоступлений()

	Возврат
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТДокументы
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Д
	|ГДЕ
	|	НЕ Д.ПометкаУдаления
	|	И &УсловиеОтбора
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПрочиеСтроки
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧУслуги КАК Услуги
	|ГДЕ
	|	Услуги.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Расходы.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧДополнительныеРасходы КАК Расходы
	|ГДЕ
	|	Расходы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Авансы.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧЗачётАвансов КАК Авансы
	|ГДЕ
	|	Авансы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрочиеСтроки.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПрочие
	|ИЗ
	|	ВТПрочиеСтроки КАК ПрочиеСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрочиеСтроки.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыИтога.Ссылка КАК Ссылка,
	|	СУММА(ТоварыИтога.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТИтоги
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК ТоварыИтога
	|ГДЕ
	|	ТоварыИтога.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыИтога.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Д.Ссылка КАК Документ,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Контрагент КАК Поставщик,
	|	Д.Сумма КАК СуммаДокумента,
	|	Д.Проведен КАК Проведен,
	|	Д.ВерсияДанных КАК ВерсияДанных,
	|	Д.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|	Д.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|	Д.Основание КАК Основание,
	|	Д.Статус КАК СтатусПоступления,
	|	ЕСТЬNULL(ЗаказыПоставщику.Номер, """") КАК НомерОснования,
	|	ЕСТЬNULL(ЗаказыПоставщику.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОснования,
	|	ЕСТЬNULL(Итоги.Количество, 0) КАК КоличествоДокумента,
	|	НЕ Прочие.Ссылка ЕСТЬ NULL КАК ЕстьПрочиеСтроки,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.КодСтроки КАК КодСтроки,
	|	Т.Номенклатура КАК Материал,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Упаковка КАК Упаковка,
	|	Т.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Т.Цена КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	Т.Серия КАК Серия,
	|	Т.УказаноНесколькоСерий КАК УказаноНесколькоСерий
	|ИЗ
	|	ВТДокументы КАК Отобранные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК Д
	|		ПО Д.Ссылка = Отобранные.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК Т
	|		ПО Т.Ссылка = Отобранные.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК ЗаказыПоставщику
	|		ПО ЗаказыПоставщику.Ссылка = Д.Основание
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПрочие КАК Прочие
	|		ПО Прочие.Ссылка = Отобранные.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИтоги КАК Итоги
	|		ПО Итоги.Ссылка = Отобранные.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Документ,
	|	НомерСтроки";

КонецФункции

// Параметры:
//  Вид - Строка - см. ВидЗаказПоставщику, ВидПоступление.
//
// Возвращаемое значение:
//  Строка - текст запроса сегодняшних документов заказа того же поставщика с итогом количества.
//
Функция ТекстЗапросаДокументовДляВыбора(Вид)

	Текст =
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТДокументы
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Д
	|ГДЕ
	|	НЕ Д.ПометкаУдаления
	|	И Д.Основание = &Основание
	|	И Д.Контрагент = &Поставщик
	|	И Д.Дата >= &НачалоДня
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыИтога.Ссылка КАК Ссылка,
	|	СУММА(ТоварыИтога.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТИтоги
	|ИЗ
	|	Документ.ЗаказПоставщику.ТЧТовары КАК ТоварыИтога
	|ГДЕ
	|	ТоварыИтога.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыИтога.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Д.Ссылка КАК Документ,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Контрагент КАК Поставщик,
	|	Д.Сумма КАК Сумма,
	|	ЕСТЬNULL(Итоги.Количество, 0) КАК Количество
	|ИЗ
	|	ВТДокументы КАК Отобранные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Д
	|		ПО Д.Ссылка = Отобранные.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИтоги КАК Итоги
	|		ПО Итоги.Ссылка = Отобранные.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Если Вид = ВидПоступление() Тогда
		Текст = СтрЗаменить(Текст, "Документ.ЗаказПоставщику", "Документ.ПоступлениеТоваровУслуг");
		Текст = СтрЗаменить(Текст, "И Д.Дата >= &НачалоДня", "И Д.Дата >= &НачалоДня
			|	И Д.НомерВходящегоДокумента = &НомерВходящегоДокумента");
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Возвращаемое значение:
//  Строка - текст запроса строк проведённых заказов поставщику заказа с остатком к поступлению по коду строки.
//
Функция ТекстЗапросаСтрокОснований()

	Возврат
	"ВЫБРАТЬ
	|	Поступления.Основание КАК ЗаказПоставщику,
	|	ТоварыПоступлений.КодСтроки КАК КодСтроки,
	|	ТоварыПоступлений.Номенклатура КАК Номенклатура,
	|	ТоварыПоступлений.Характеристика КАК Характеристика,
	|	СУММА(ТоварыПоступлений.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТПришло
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК ТоварыПоступлений
	|		ПО ТоварыПоступлений.Ссылка = Поступления.Ссылка
	|ГДЕ
	|	НЕ Поступления.ПометкаУдаления
	|	И Поступления.Основание В (&ЗаказыПоставщику)
	|
	|СГРУППИРОВАТЬ ПО
	|	Поступления.Основание,
	|	ТоварыПоступлений.КодСтроки,
	|	ТоварыПоступлений.Номенклатура,
	|	ТоварыПоступлений.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Д.Ссылка КАК ЗаказПоставщику,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Контрагент КАК Поставщик,
	|	Т.КодСтроки КАК КодСтроки,
	|	Т.Номенклатура КАК Материал,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Упаковка КАК Упаковка,
	|	Т.Продукция КАК Продукция,
	|	СУММА(Т.КоличествоУпаковок) КАК КоличествоУпаковок,
	|	СУММА(Т.Количество) КАК Количество,
	|	СУММА(Т.Количество) - ЕСТЬNULL(МАКСИМУМ(Пришло.Количество), 0) КАК Остаток
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.ТЧТовары КАК Т
	|		ПО Т.Ссылка = Д.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПришло КАК Пришло
	|		ПО Пришло.ЗаказПоставщику = Д.Ссылка
	|			И Пришло.КодСтроки = Т.КодСтроки
	|			И Пришло.Номенклатура = Т.Номенклатура
	|			И Пришло.Характеристика = Т.Характеристика
	|ГДЕ
	|	Д.Ссылка В (&ЗаказыПоставщику)
	|	И Д.Проведен
	|	И ВЫБОР
	|			КОГДА &ЛюбойПоставщик
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Д.Контрагент = &Поставщик
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЛюбойМатериал
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Т.Номенклатура = &Материал
	|					И Т.Характеристика = &Характеристика
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	Д.Ссылка,
	|	Д.Номер,
	|	Д.Дата,
	|	Д.Контрагент,
	|	Т.КодСтроки,
	|	Т.Номенклатура,
	|	Т.Характеристика,
	|	Т.Упаковка,
	|	Т.Продукция
	|
	|ИМЕЮЩИЕ
	|	СУММА(Т.Количество) - ЕСТЬNULL(МАКСИМУМ(Пришло.Количество), 0) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	КодСтроки";

КонецФункции

// Заказы поставщику, введённые по заказу на производство, - и помеченные: их поступления остаются в цепочке.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ на производство.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПоставщику - заказы поставщику.
//
Функция ЗаказыПоставщикуЗаказа(Заказ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЗаказыОснования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ЗаказыОснования
	|ГДЕ
	|	ЗаказыОснования.Основание = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Сколько материала пришло по строке заказа поставщику: проведённое - по расходу регистра «Заказы поставщикам» (движения
// поступление и возврат пишут под той же блокировкой потребностей заказа, что берёт рабочее место, поэтому чтение под
// ней видит всё зафиксированное), непроведённые непомеченные поступления - по их строкам: черновик после проведения
// тоже закроет строку по её коду.
//
// Параметры:
//  ЗаказПоставщику - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//  СтрокаЗаказа    - СтрокаТабличнойЧасти - строка заказа поставщику: КодСтроки, Номенклатура, Характеристика.
//
// Возвращаемое значение:
//  Число - количество в базовых единицах.
//
Функция ПришлоПоСтрокеЗаказаПоставщику(ЗаказПоставщику, СтрокаЗаказа)

	Если Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Движения.Количество КАК Количество
	|ПОМЕСТИТЬ ВТПришло
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам КАК Движения
	|ГДЕ
	|	Движения.ЗаказПоставщику = &ЗаказПоставщику
	|	И Движения.КодСтроки = &КодСтроки
	|	И Движения.Номенклатура = &Номенклатура
	|	И Движения.Характеристика = &Характеристика
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Движения.Активность
	|	И НЕ Движения.Регистратор ССЫЛКА Документ.ЗаказПоставщику
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыПоступлений.Количество
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК ТоварыПоступлений
	|ГДЕ
	|	ТоварыПоступлений.Ссылка В
	|			(ВЫБРАТЬ
	|				Поступления.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.ПоступлениеТоваровУслуг КАК Поступления
	|			ГДЕ
	|				НЕ Поступления.Проведен
	|				И НЕ Поступления.ПометкаУдаления
	|				И Поступления.Основание = &ЗаказПоставщику)
	|	И ТоварыПоступлений.КодСтроки = &КодСтроки
	|	И ТоварыПоступлений.Номенклатура = &Номенклатура
	|	И ТоварыПоступлений.Характеристика = &Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВТПришло.Количество), 0) КАК Количество
	|ИЗ
	|	ВТПришло КАК ВТПришло");
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	Запрос.УстановитьПараметр("КодСтроки", СтрокаЗаказа.КодСтроки);
	Запрос.УстановитьПараметр("Номенклатура", СтрокаЗаказа.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", СтрокаЗаказа.Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Булево - Истина, если вид и типы значений строки допустимы.
//
Функция ТипыДанныхСтрокиДокументаВерны(ДанныеСтроки)

	Если ТипЗнч(ДанныеСтроки) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ИмяИЗначение Из НовыеДанныеСтрокиДокумента() Цикл
		Если Не ДанныеСтроки.Свойство(ИмяИЗначение.Ключ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Вид = ДанныеСтроки.Вид;
	Если ТипЗнч(Вид) <> Тип("Строка") Или ВидыСтрокДокументов().Найти(Вид) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипДокумента = Тип("ДокументСсылка." + Вид);
	ДокументВерен = ДанныеСтроки.Документ = Неопределено Или ТипЗнч(ДанныеСтроки.Документ) = ТипДокумента;
	Возврат ДокументВерен И СсылкиСтрокиДокументаВерны(ДанныеСтроки) И ПростыеЗначенияСтрокиДокументаВерны(ДанныеСтроки);

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Булево - Истина, если ссылочные значения строки нужных типов.
//
Функция СсылкиСтрокиДокументаВерны(ДанныеСтроки)

	Возврат ТипЗнч(ДанныеСтроки.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя")
		И ТипЗнч(ДанныеСтроки.Поставщик) = Тип("СправочникСсылка.Контрагенты")
		И ТипЗнч(ДанныеСтроки.ЗаказПоставщику) = Тип("ДокументСсылка.ЗаказПоставщику")
		И ТипЗнч(ДанныеСтроки.Материал) = Тип("СправочникСсылка.Номенклатура")
		И ТипЗнч(ДанныеСтроки.Продукция) = Тип("СправочникСсылка.Номенклатура")
		И ТипЗнч(ДанныеСтроки.Характеристика) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры")
		И ТипЗнч(ДанныеСтроки.Упаковка) = Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения");

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Булево - Истина, если числа, строки, даты и признаки строки нужных типов.
//
Функция ПростыеЗначенияСтрокиДокументаВерны(ДанныеСтроки)

	ТипЧисла = Тип("Число");
	Возврат ТипЗнч(ДанныеСтроки.НомерСтроки) = ТипЧисла И ТипЗнч(ДанныеСтроки.КоличествоУпаковок) = ТипЧисла
		И ТипЗнч(ДанныеСтроки.Цена) = ТипЧисла И ТипЗнч(ДанныеСтроки.КодСтрокиОснования) = ТипЧисла
		И ТипЗнч(ДанныеСтроки.ВерсияДанных) = Тип("Строка") И ТипЗнч(ДанныеСтроки.НомерВходящегоДокумента) = Тип("Строка")
		И ТипЗнч(ДанныеСтроки.ДатаВходящегоДокумента) = Тип("Дата") И ТипЗнч(ДанныеСтроки.ЦенаИзменена) = Тип("Булево");

КонецФункции

// Параметры:
//  Вид - Строка - см. ВидЗаказПоставщику, ВидПоступление.
//
// Возвращаемое значение:
//  Строка - текст запрета, если нет права добавлять, изменять или проводить документ; пустая строка - право есть.
//
Функция ТекстНетПраваВводаДокументов(Вид)

	МетаданныеДокумента = Метаданные.Документы[Вид];
	Если ПравоДоступа("Добавление", МетаданныеДокумента) И ПравоДоступа("Изменение", МетаданныеДокумента)
		И ПравоДоступа("Проведение", МетаданныеДокумента) Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'Нет права вводить документы «%1»: строки закладки только для просмотра.';
		|fr = 'Aucun droit de saisir les documents « %1 » : les lignes de l''onglet sont en lecture seule.';
		|en = 'No right to enter ""%1"" documents: the tab lines are read-only.';
		|es = 'Sin derecho a introducir documentos «%1»: las líneas de la pestaña son de solo lectura.'");
	Возврат СтрШаблон(Шаблон, МетаданныеДокумента.Представление());

КонецФункции

// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ верхней таблицы.
//
// Возвращаемое значение:
//  Строка - текст запрета, если заказ не заказ на производство в работе (решение владельца 7); пустая строка - можно.
//
Функция ТекстЗапретаЗаказаСтроки(Заказ)

	Если ЗначениеЗаполнено(Заказ) Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "ВидОперации, Проведен, ПометкаУдаления");
		ЗаказВРаботе = Реквизиты.Проведен = Истина И Реквизиты.ПометкаУдаления = Ложь;
		Если ЗаказВРаботе И Документы.ЗаказПокупателя.ЗаказПроводится(Реквизиты.ВидОперации) Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	Возврат ТекстТолькоЗаказВРаботе();

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Строка - текст запрета незаполненной строки; пустая строка - значения достаточны.
//
Функция ТекстЗапретаЗначенийСтрокиЗакупки(ДанныеСтроки)

	Если Не ЗначениеЗаполнено(ДанныеСтроки.Поставщик) Или Не ЗначениеЗаполнено(ДанныеСтроки.Материал)
		Или ДанныеСтроки.КоличествоУпаковок <= 0 Тогда
		Возврат НСтр("ru = 'Строка не записана: укажите поставщика, материал и количество.';
			|fr = 'Ligne non enregistrée : indiquez le fournisseur, la matière et la quantité.';
			|en = 'Line not saved: specify the supplier, material and quantity.';
			|es = 'Línea no guardada: indique el proveedor, el material y la cantidad.'");
	КонецЕсли;
	Если ДанныеСтроки.Вид = ВидПоступление() И ЗначениеЗаполнено(ДанныеСтроки.ЗаказПоставщику)
		И ДанныеСтроки.КодСтрокиОснования = 0 Тогда
		Возврат ТекстВыберитеСтрокуЗаказаПоставщику();
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеСтроки.Характеристика)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтроки.Характеристика, "Владелец") <> ДанныеСтроки.Материал Тогда
		Возврат НСтр("ru = 'Характеристика не относится к материалу строки.';
			|fr = 'La caractéristique n''appartient pas à la matière de la ligne.';
			|en = 'The characteristic does not belong to the line material.';
			|es = 'La característica no pertenece al material de la línea.'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Параметры:
//  Документ - ДокументСсылка - документ строки нижней закладки.
//
// Возвращаемое значение:
//  Структура, Неопределено - Ссылка, Дата, Основание, ПометкаУдаления, Проведен, ЗаказКлиента, Автовыпуск; у закупок и
//                            реализации - Контрагент, у поступления - НомерВходящегоДокумента; документа нет -
//                            Неопределено.
//
Функция РеквизитыДокументаСтроки(Документ)

	Имена = ИменаРеквизитовДокументаСтроки(Документ.Метаданные());
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, Имена);
	Если Реквизиты.Ссылка <> Документ Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДополнитьРеквизитыДокументаСтроки(Реквизиты);
	Возврат Реквизиты;

КонецФункции

// Реквизиты заблокированного документа строки в форме РеквизитыДокументаСтроки.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ строки нижней закладки.
//
// Возвращаемое значение:
//  Структура - см. РеквизитыДокументаСтроки.
//
Функция РеквизитыОбъектаСтроки(ДокОбъект)

	Реквизиты = Новый Структура(ИменаРеквизитовДокументаСтроки(ДокОбъект.Метаданные()));
	ЗаполнитьЗначенияСвойств(Реквизиты, ДокОбъект);
	ДополнитьРеквизитыДокументаСтроки(Реквизиты);
	Возврат Реквизиты;

КонецФункции

// Параметры:
//  МетаданныеДокумента - ОбъектМетаданных - документ строки.
//
// Возвращаемое значение:
//  Строка - имена реквизитов для РеквизитыДокументаСтроки через запятую.
//
Функция ИменаРеквизитовДокументаСтроки(МетаданныеДокумента)

	Имена = "Ссылка, Дата, Основание, ПометкаУдаления, Проведен";
	Если МетаданныеДокумента.Реквизиты.Найти("Контрагент") <> Неопределено Тогда
		Имена = Имена + ", Контрагент";
	КонецЕсли;
	Если МетаданныеДокумента = Метаданные.Документы.ПоступлениеТоваровУслуг Тогда
		Имена = Имена + ", НомерВходящегоДокумента";
	КонецЕсли;
	Возврат Имена;

КонецФункции

// Заказ клиента документа строки: основание; у поступления по заказу поставщику - основание заказа поставщику; у
// автовыпуска - заказ его реализации.
//
// Параметры:
//  Реквизиты - Структура - см. РеквизитыДокументаСтроки, получает ЗаказКлиента и Автовыпуск.
//
Процедура ДополнитьРеквизитыДокументаСтроки(Реквизиты)

	ЗаказКлиента = Реквизиты.Основание;
	Автовыпуск = ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.ВыпускПродукции")
		И ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И ЗначениеЗаполнено(ЗаказКлиента);
	Если ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказПоставщику") И ЗначениеЗаполнено(ЗаказКлиента) Тогда
		ЗаказКлиента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказКлиента, "Основание");
	ИначеЕсли Автовыпуск Тогда
		ЗаказКлиента = Производство.ЗаказРеализацииОснования(ЗаказКлиента);
	Иначе
		ЗаказКлиента = ?(ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказПокупателя"), ЗаказКлиента, Неопределено);
	КонецЕсли;
	Реквизиты.Вставить("ЗаказКлиента", ЗаказКлиента);
	Реквизиты.Вставить("Автовыпуск", Автовыпуск);

КонецПроцедуры

// Запрет строки выбранного документа по данным базы: документ этого заказа, не помечен, не автовыпуск, новая строка - в
// сегодняшний; у закупок - тот же поставщик, у поступления - основание и накладная; у отгрузки - после реализации не
// проведён ручной выпуск заказа (план E12.3a, §11).
//
// Параметры:
//  Реквизиты    - Структура, Неопределено - см. РеквизитыДокументаСтроки.
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//  ДляУдаления  - Булево - удаляемая строка: поставщик, основание и выпуск после отгрузки не сверяются.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - документ подходит.
//
Функция ТекстЗапретаДокументаСтроки(Реквизиты, ДанныеСтроки, ДляУдаления)

	Если Реквизиты = Неопределено Или Реквизиты.ЗаказКлиента <> ДанныеСтроки.Заказ Тогда
		Возврат НСтр("ru = 'Документ относится к другому заказу: обновите рабочее место.';
			|fr = 'Le document concerne une autre commande : actualisez le poste de travail.';
			|en = 'The document belongs to another order: refresh the workstation.';
			|es = 'El documento pertenece a otro pedido: actualice el puesto de trabajo.'");
	ИначеЕсли Реквизиты.ПометкаУдаления Тогда
		Возврат ТекстДокументПомечен();
	ИначеЕсли Реквизиты.Автовыпуск Тогда
		Возврат ТекстАвтовыпускЧерезРеализацию();
	ИначеЕсли Не ДляУдаления И Не ЭтоВыпускИлиОтгрузка(ДанныеСтроки.Вид) И Реквизиты.Контрагент <> ДанныеСтроки.Поставщик Тогда
		Возврат НСтр("ru = 'Выбран документ другого поставщика: выберите документ этого поставщика или «Новый».';
			|fr = 'Le document choisi est d''un autre fournisseur : choisissez un document de ce fournisseur ou « Nouveau ».';
			|en = 'The selected document is from another supplier: select a document of this supplier or ""New"".';
			|es = 'El documento elegido es de otro proveedor: elija un documento de este proveedor o «Nuevo».'");
	ИначеЕсли Не ДляУдаления И ДанныеСтроки.НомерСтроки = 0 И Реквизиты.Дата < НачалоДня(ТекущаяДатаСеанса()) Тогда
		Возврат НСтр("ru = 'Новая строка добавляется только в документ за сегодня: выберите «Новый документ».';
			|fr = 'Une nouvelle ligne ne s''ajoute qu''à un document du jour : choisissez « Nouveau document ».';
			|en = 'A new line is added only to today''s document: select ""New document"".';
			|es = 'Una línea nueva solo se añade a un documento de hoy: elija «Documento nuevo».'");
	ИначеЕсли Не ДляУдаления И ДанныеСтроки.Вид = ВидПоступление() Тогда
		Возврат ТекстЗапретаОснованияПоступления(Реквизиты, ДанныеСтроки);
	ИначеЕсли Не ДляУдаления И ЭтоВыпускИлиОтгрузка(ДанныеСтроки.Вид) Тогда
		Возврат ТекстЗапретаПорядкаВыпускаИОтгрузки(Реквизиты.Ссылка, ДанныеСтроки.Заказ);
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Поступление должно быть введено по тому же основанию и, для новой строки, по той же накладной поставщика.
//
// Параметры:
//  Реквизиты    - Структура - см. РеквизитыДокументаСтроки.
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - поступление подходит.
//
Функция ТекстЗапретаОснованияПоступления(Реквизиты, ДанныеСтроки)

	Основание = ?(ЗначениеЗаполнено(ДанныеСтроки.ЗаказПоставщику), ДанныеСтроки.ЗаказПоставщику, ДанныеСтроки.Заказ);
	Если Реквизиты.Основание <> Основание Тогда
		Возврат НСтр("ru = 'Поступление введено по другому заказу поставщику: выберите другое поступление или «Новое».';
			|fr = 'La réception concerne une autre commande fournisseur : choisissez une autre réception ou « Nouvelle ».';
			|en = 'The receipt is based on another supplier order: select another receipt or ""New"".';
			|es = 'La recepción corresponde a otro pedido a proveedor: elija otra recepción o «Nueva».'");
	КонецЕсли;
	НомерНакладной = СокрЛП(ДанныеСтроки.НомерВходящегоДокумента);
	ДругаяНакладная = Не ПустаяСтрока(НомерНакладной) И НомерНакладной <> СокрЛП(Реквизиты.НомерВходящегоДокумента);
	Если ДанныеСтроки.НомерСтроки = 0 И ДругаяНакладная Тогда
		Возврат НСтр("ru = 'У выбранного поступления другой номер накладной поставщика: выберите «Новое».';
			|fr = 'La réception choisie a un autre numéro de bon du fournisseur : choisissez « Nouvelle ».';
			|en = 'The selected receipt has another supplier invoice number: select ""New"".';
			|es = 'La recepción elegida tiene otro número de albarán del proveedor: elija «Nueva».'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Строка поступления: по выбранной строке заказа поставщику - сама строка; без неё - нет ли у поставщика строк заказов
// поставщику с остатком по материалу: приход без заказа поставщику не закрыл бы их, и следующее поступление по заказу
// учло бы материал дважды.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - основание подходит.
//
Функция ТекстЗапретаОснованияСтрокиПоступления(ДанныеСтроки)

	Если ЗначениеЗаполнено(ДанныеСтроки.ЗаказПоставщику) Тогда
		Возврат ТекстЗапретаСтрокиОснования(ДанныеСтроки);
	ИначеЕсли ДанныеСтроки.НомерСтроки = 0 И ЕстьСтрокиОснований(ДанныеСтроки) Тогда
		Возврат ТекстВыберитеСтрокуЗаказаПоставщику();
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Булево - у поставщика есть строки заказов поставщику этого заказа с остатком по материалу строки.
//
Функция ЕстьСтрокиОснований(ДанныеСтроки)

	Список = СтрокиЗаказовПоставщикуДляВыбора(ДанныеСтроки.Заказ, ДанныеСтроки.Поставщик, ДанныеСтроки.Материал,
		ДанныеСтроки.Характеристика);
	Возврат Список.Количество() > 0;

КонецФункции

// Запрет строки поступления по выбранной строке заказа поставщику.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - строка основания подходит.
//
Функция ТекстЗапретаСтрокиОснования(ДанныеСтроки)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеСтроки.ЗаказПоставщику,
		"Основание, Контрагент, Проведен, ПометкаУдаления");
	ЗаказПодходит = Реквизиты.Основание = ДанныеСтроки.Заказ И Реквизиты.Проведен И Не Реквизиты.ПометкаУдаления
		И Реквизиты.Контрагент = ДанныеСтроки.Поставщик;
	Если Не ЗаказПодходит Тогда
		Возврат НСтр("ru = 'Заказ поставщику не проведён, помечен или относится к другому заказу или поставщику.';
			|fr = 'La commande fournisseur n''est pas validée, est marquée ou concerne une autre commande ou un autre fournisseur.';
			|en = 'The supplier order is not posted, is marked, or belongs to another order or supplier.';
			|es = 'El pedido a proveedor no está contabilizado, está marcado o pertenece a otro pedido o proveedor.'");
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварыЗаказа.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.ЗаказПоставщику.ТЧТовары КАК ТоварыЗаказа
	|ГДЕ
	|	ТоварыЗаказа.Ссылка = &ЗаказПоставщику
	|	И ТоварыЗаказа.КодСтроки = &КодСтроки
	|	И ТоварыЗаказа.Номенклатура = &Материал
	|	И ТоварыЗаказа.Характеристика = &Характеристика");
	Запрос.УстановитьПараметр("ЗаказПоставщику", ДанныеСтроки.ЗаказПоставщику);
	Запрос.УстановитьПараметр("КодСтроки", ДанныеСтроки.КодСтрокиОснования);
	Запрос.УстановитьПараметр("Материал", ДанныеСтроки.Материал);
	Запрос.УстановитьПараметр("Характеристика", ДанныеСтроки.Характеристика);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат НСтр("ru = 'В заказе поставщику нет такой строки: материал строки поступления должен совпадать со строкой заказа.';
			|fr = 'La commande fournisseur n''a pas cette ligne : la matière de la réception doit correspondre à la ligne de commande.';
			|en = 'The supplier order has no such line: the receipt material must match the order line.';
			|es = 'El pedido a proveedor no tiene esa línea: el material de la recepción debe coincidir con la línea del pedido.'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Возвращаемое значение:
//  Структура:
//   * Успех              - Булево - документ записан.
//   * Текст              - Строка - причина отказа или сообщения документа.
//   * Перечитать         - Булево - документ изменён в базе: форме нужно перечитать строки закупок.
//   * Документ           - ДокументСсылка.ЗаказПоставщику, ДокументСсылка.ПоступлениеТоваровУслуг, Неопределено.
//   * НомерСтроки        - Число - номер записанной строки в документе.
//   * Проведен           - Булево - документ проведён после записи.
//   * ДокументПомечен    - Булево - документ без строк помечен на удаление.
//   * СтрокиДокумента    - Массив из Структура - строки документа в колонках таблицы формы.
//   * Причина            - Строка - причина отказа проведения.
//   * ЗаписатьЧерновиком - Булево - служебный: проведение нового документа отказало, нужна запись черновиком.
//
Функция НовыйРезультатЗаписиСтроки()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("Перечитать", Ложь);
	Результат.Вставить("Документ", Неопределено);
	Результат.Вставить("НомерСтроки", 0);
	Результат.Вставить("Проведен", Ложь);
	Результат.Вставить("ДокументПомечен", Ложь);
	Результат.Вставить("СтрокиДокумента", Новый Массив);
	Результат.Вставить("Причина", "");
	Результат.Вставить("ЗаписатьЧерновиком", Ложь);
	Возврат Результат;

КонецФункции

// Новый документ строки нижней закладки без строк.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  ДокументОбъект - незаписанный документ вида строки.
//
Функция НовыйДокументСтроки(ДанныеСтроки)

	Если ДанныеСтроки.Вид = ВидВыпуск() Тогда
		Возврат НовыйВыпуск(ДанныеСтроки);
	ИначеЕсли ДанныеСтроки.Вид = ВидОтгрузка() Тогда
		Возврат НоваяРеализация(ДанныеСтроки);
	Иначе
		Возврат НовыйДокументЗакупки(ДанныеСтроки);
	КонецЕсли;

КонецФункции

// Новый документ закупки строки: реквизиты по умолчанию и значения заполнения, шапка по заказу и поставщику; поступление
// по заказу поставщику - заполнение на основании без строк (организация, договор и режим НДС - как у заказа).
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - незаписанный документ без строк.
//
Функция НовыйДокументЗакупки(ДанныеСтроки)

	ЭтоПоступление = ДанныеСтроки.Вид = ВидПоступление();
	ДокОбъект = Документы[ДанныеСтроки.Вид].СоздатьДокумент();
	Если ЭтоПоступление И ЗначениеЗаполнено(ДанныеСтроки.ЗаказПоставщику) Тогда
		ДокОбъект.Заполнить(ДанныеСтроки.ЗаказПоставщику);
		ДокОбъект.ТЧТовары.Очистить();
		ДокОбъект.ТЧСерии.Очистить();
	Иначе
		ДокОбъект.Заполнить(Неопределено);
		ДокОбъект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтроки.Заказ, "Организация");
		ДокОбъект.Основание = ДанныеСтроки.Заказ;
		ДокОбъект.Контрагент = ДанныеСтроки.Поставщик;
		ДокОбъект.Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(ДанныеСтроки.Поставщик,
			ДокОбъект.Организация, Ложь);
		// Цены прайса поставщиков хранятся с НДС - как у заполнения по потребности.
		ДокОбъект.ЦенаВключаетНДС = Истина;
	КонецЕсли;
	ДокОбъект.Дата = ТекущаяДатаСеанса();
	Если ЭтоПоступление Тогда
		Если Не ЗначениеЗаполнено(ДокОбъект.ХозяйственнаяОперация) Тогда
			ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
		КонецЕсли;
		ДокОбъект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
		ДокОбъект.КурсВалюты = 1;
		ДокОбъект.ТипЦеныПоТипуЦен = Константы.ВыводитьВЗакупкеТипЦен.Получить();
		ДокОбъект.НомерВходящегоДокумента = СокрЛП(ДанныеСтроки.НомерВходящегоДокумента);
		ДокОбъект.ДатаВходящегоДокумента = ДанныеСтроки.ДатаВходящегоДокумента;
	Иначе
		Если Не ЗначениеЗаполнено(ДокОбъект.ВидЗаказа) Тогда
			ДокОбъект.ВидЗаказа = Перечисления.ВидыЗаказовПоставщику.Основной;
		КонецЕсли;
	КонецЕсли;
	Возврат ДокОбъект;

КонецФункции

// Документ строки под объектной блокировкой со сверкой версии и запретами правки в рабочем месте.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента: Документ, ВерсияДанных.
//  Результат    - Структура - см. НовыйРезультатЗаписиСтроки, получает текст отказа.
//  ДляУдаления  - Булево - документ удаляемых строк.
//
// Возвращаемое значение:
//  ДокументОбъект, Неопределено - документ или отказ.
//
Функция ЗаблокированныйДокументСтроки(ДанныеСтроки, Результат, ДляУдаления = Ложь)

	ДокОбъект = ДанныеСтроки.Документ.ПолучитьОбъект();
	Если ДокОбъект = Неопределено Тогда
		Результат.Перечитать = Истина;
		Результат.Текст = ТекстДокументИзменен();
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ДокОбъект.Заблокировать();
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Шаблон = НСтр("ru = 'Документ %1 сейчас редактирует другой пользователь: %2';
			|fr = 'Le document %1 est en cours de modification par un autre utilisateur : %2';
			|en = 'Document %1 is being edited by another user: %2';
			|es = 'Otro usuario está editando el documento %1: %2'");
		Результат.Текст = СтрШаблон(Шаблон, ДокОбъект.Ссылка, ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;
	Если Не ПустаяСтрока(ДанныеСтроки.ВерсияДанных) И ДокОбъект.ВерсияДанных <> ДанныеСтроки.ВерсияДанных Тогда
		Результат.Перечитать = Истина;
		Результат.Текст = ТекстДокументИзменен();
		Возврат Неопределено;
	КонецЕсли;
	Результат.Текст = ТекстЗапретаДокументаОбъекта(ДокОбъект);
	Если ПустаяСтрока(Результат.Текст) И ДанныеСтроки.Свойство("Вид") Тогда
		// Основание и поставщик сверялись запросом до блокировки: повтор по заблокированному объекту.
		Реквизиты = РеквизитыОбъектаСтроки(ДокОбъект);
		Результат.Текст = ТекстЗапретаДокументаСтроки(Реквизиты, ДанныеСтроки, ДляУдаления);
	КонецЕсли;
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		Результат.Перечитать = Истина;
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДокОбъект;

КонецФункции

// Документы, которые рабочее место не правит и чей «Статус» не меняет: помеченные; автовыпуски (правка - через
// реализацию); поступления с услугами, доп. расходами или зачётом авансов и завершённые без права правки завершённых;
// реализации с услугами, доп. расходами, авансами, кассовой сменой или налоговой накладной - их проверки живут в форме
// документа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ строки.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - документ правится в рабочем месте.
//
Функция ТекстЗапретаДокументаОбъекта(ДокОбъект)

	Если ДокОбъект.ПометкаУдаления Тогда
		Возврат ТекстДокументПомечен();
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВыпускПродукции") Тогда
		Возврат ?(Производство.ЭтоАвтовыпуск(ДокОбъект), ТекстАвтовыпускЧерезРеализацию(), "");
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		Возврат ТекстЗапретаРеализацииОбъекта(ДокОбъект);
	ИначеЕсли ТипЗнч(ДокОбъект) <> Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		Возврат "";
	Иначе
		Возврат ТекстЗапретаПоступленияОбъекта(ДокОбъект);
	КонецЕсли;

КонецФункции

// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг - поступление.
//
// Возвращаемое значение:
//  Строка - текст запрета поступления с услугами, доп. расходами, авансами или завершённого.
//
Функция ТекстЗапретаПоступленияОбъекта(ДокОбъект)

	// BSLLS:YoLetterUsage-off - имя табличной части в метаданных.
	ЕстьПрочие = ДокОбъект.ТЧУслуги.Количество() > 0 Или ДокОбъект.ТЧДополнительныеРасходы.Количество() > 0
		Или ДокОбъект.ТЧЗачётАвансов.Количество() > 0;
	// BSLLS:YoLetterUsage-on
	Завершен = ДокОбъект.Статус = Перечисления.СтатусыДокументов.Завершен И Не МожноПравитьЗавершенные();
	Если ЕстьПрочие Или Завершен Тогда
		Возврат ТекстПравкаВФормеДокумента();
	КонецЕсли;
	Возврат "";

КонецФункции

// Возвращаемое значение:
//  Булево - пользователь правит завершённые документы - как в форме поступления.
//
Функция МожноПравитьЗавершенные()

	// BSLLS:IsInRoleMethod-off - условие повторяет форму поступления, где правка завершённых разрешена администратору
	Возврат РегистрыСведений.НастройкиПользователей.РедактироватьЗавершенныеДокументы() Или РольДоступна("Администратор");
	// BSLLS:IsInRoleMethod-on

КонецФункции

// Параметры:
//  ДокОбъект   - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  НомерСтроки - Число - номер строки товаров.
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти, Неопределено - строка или Неопределено.
//
Функция СтрокаТоваровПоНомеру(ДокОбъект, НомерСтроки)

	Строки = СтрокиДокумента(ДокОбъект);
	Если НомерСтроки < 1 Или НомерСтроки > Строки.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строки[НомерСтроки - 1];

КонецФункции

// Запреты правки строки заблокированного документа: серии поступления и реализации, строки заказа поставщику с
// поступлениями, повтор строки основания в поступлении; выпуск с сериями, партиями или изменёнными материалами;
// реализация, после которой проведён ручной выпуск заказа.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  СтрокаТоваров - СтрокаТабличнойЧасти, Неопределено - изменяемая строка; не задана - новая.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - правка допустима.
//
Функция ТекстЗапретаПравкиСтрокиДокумента(ДокОбъект, СтрокаТоваров, ДанныеСтроки)

	Если ДанныеСтроки.Вид = ВидЗаказПоставщику() Тогда
		Возврат ТекстЗапретаСтрокиСПоступлениями(ДокОбъект, СтрокаТоваров, ДанныеСтроки);
	ИначеЕсли ДанныеСтроки.Вид = ВидВыпуск() Тогда
		Возврат ТекстЗапретаПравкиВыпуска(ДокОбъект);
	ИначеЕсли СтрокаТоваров <> Неопределено И (ЗначениеЗаполнено(СтрокаТоваров.Серия) Или СтрокаТоваров.УказаноНесколькоСерий) Тогда
		// Серии поступления и реализации.
		Возврат ТекстСтрокаССериями();
	ИначеЕсли ДанныеСтроки.Вид = ВидОтгрузка() Тогда
		Возврат "";
	Иначе
		Возврат ТекстЗапретаПовтораСтрокиОснования(ДокОбъект, СтрокаТоваров, ДанныеСтроки);
	КонецЕсли;

КонецФункции

// Параметры:
//  ДокОбъект     - ДокументОбъект.ПоступлениеТоваровУслуг - поступление.
//  СтрокаТоваров - СтрокаТабличнойЧасти, Неопределено - изменяемая строка; не задана - новая.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Строка - текст запрета второй строки поступления по той же строке заказа поставщику.
//
Функция ТекстЗапретаПовтораСтрокиОснования(ДокОбъект, СтрокаТоваров, ДанныеСтроки)

	Если Не ЗначениеЗаполнено(ДанныеСтроки.ЗаказПоставщику) Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого ДругаяСтрока Из ДокОбъект.ТЧТовары Цикл
		Если ДругаяСтрока <> СтрокаТоваров И ДругаяСтрока.КодСтроки = ДанныеСтроки.КодСтрокиОснования Тогда
			Возврат НСтр("ru = 'По этой строке заказа поставщику в поступлении уже есть строка: измените её количество.';
				|fr = 'La réception contient déjà une ligne pour cette ligne de commande fournisseur : modifiez sa quantité.';
				|en = 'The receipt already has a line for this supplier order line: change its quantity.';
				|es = 'La recepción ya tiene una línea para esta línea del pedido a proveedor: cambie su cantidad.'");
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Строка заказа поставщику, по коду которой уже пришёл материал, не меняет материал и не уменьшается ниже пришедшего:
// остаток регистра «Заказы поставщикам» ушёл бы в минус.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.ЗаказПоставщику - заказ поставщику.
//  СтрокаТоваров - СтрокаТабличнойЧасти, Неопределено - изменяемая или удаляемая строка.
//  ДанныеСтроки  - Структура, Неопределено - новые значения; не заданы - удаление.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - правка допустима.
//
Функция ТекстЗапретаСтрокиСПоступлениями(ДокОбъект, СтрокаТоваров, ДанныеСтроки)

	Если СтрокаТоваров = Неопределено Или ДокОбъект.Ссылка.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Пришло = ПришлоПоСтрокеЗаказаПоставщику(ДокОбъект.Ссылка, СтрокаТоваров);
	Если Пришло = 0 Тогда
		Возврат "";
	КонецЕсли;
	Если ДанныеСтроки = Неопределено Или СтрокаТоваров.Номенклатура <> ДанныеСтроки.Материал
		Или СтрокаТоваров.Характеристика <> ДанныеСтроки.Характеристика Тогда
		Возврат ТекстСтрокаСПоступлениями();
	КонецЕсли;
	Упаковка = ?(ЗначениеЗаполнено(ДанныеСтроки.Упаковка), ДанныеСтроки.Упаковка, СтрокаТоваров.Упаковка);
	Коэффициент = ?(ЗначениеЗаполнено(Упаковка), ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы(Упаковка), 1);
	Если ДанныеСтроки.КоличествоУпаковок * Коэффициент < Пришло Тогда
		Возврат ТекстСтрокаСПоступлениями();
	КонецЕсли;
	Возврат "";

КонецФункции

// Новый или заблокированный документ строки и её строка товаров.
//
// Параметры:
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтрокиДокумента.
//  НовыйДокумент - Булево - документ строки ещё не записан.
//  Результат     - Структура - см. НовыйРезультатЗаписиСтроки, получает отказ.
//
// Возвращаемое значение:
//  Структура, Неопределено - ДокОбъект, СтрокаТоваров (Неопределено у новой строки); отказ - Неопределено.
//
Функция ДокументИСтрокаДокумента(ДанныеСтроки, НовыйДокумент, Результат)

	Если НовыйДокумент Тогда
		ДокОбъект = НовыйДокументСтроки(ДанныеСтроки);
	Иначе
		ДокОбъект = ЗаблокированныйДокументСтроки(ДанныеСтроки, Результат);
	КонецЕсли;
	Если ДокОбъект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтрокаТоваров = Неопределено;
	Если ДанныеСтроки.НомерСтроки <> 0 Тогда
		СтрокаТоваров = СтрокаТоваровПоНомеру(ДокОбъект, ДанныеСтроки.НомерСтроки);
		Если СтрокаТоваров = Неопределено Тогда
			Результат.Перечитать = Истина;
			Результат.Текст = ТекстДокументИзменен();
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("ДокОбъект, СтрокаТоваров", ДокОбъект, СтрокаТоваров);

КонецФункции

// Строка записанного документа в базе совпадает с данными формы при той же версии документа - без чтения объекта.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента: Документ, НомерСтроки, ВерсияДанных и значения.
//
// Возвращаемое значение:
//  Булево - Истина, если записывать нечего.
//
Функция СтрокаВБазеНеИзменилась(ДанныеСтроки)

	Если ДанныеСтроки.НомерСтроки = 0 Или ПустаяСтрока(ДанныеСтроки.ВерсияДанных) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Цена КАК Цена,
	|	Шапки.ВерсияДанных КАК ВерсияДанных
	|ИЗ
	|	Документ.ЗаказПоставщику.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Шапки
	|		ПО Шапки.Ссылка = Товары.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Документ
	|	И Товары.НомерСтроки = &НомерСтроки");
	Если ДанныеСтроки.Вид = ВидВыпуск() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ЗаказПоставщику.ТЧТовары", "Документ.ВыпускПродукции.ТЧГотоваяПродукция");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Товары.Цена КАК Цена", "0 КАК Цена");
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ЗаказПоставщику", "Документ." + ДанныеСтроки.Вид);
	Запрос.УстановитьПараметр("Документ", ДанныеСтроки.Документ);
	Запрос.УстановитьПараметр("НомерСтроки", ДанныеСтроки.НомерСтроки);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Выборка.ВерсияДанных <> ДанныеСтроки.ВерсияДанных Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрокаДокументаНеИзменилась(Выборка, ДанныеСтроки);

КонецФункции

// Параметры:
//  СтрокаТоваров - СтрокаТабличнойЧасти, ВыборкаИзРезультатаЗапроса - строка документа.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь закончил редактирование строки без правок.
//
Функция СтрокаДокументаНеИзменилась(СтрокаТоваров, ДанныеСтроки)

	Совпадает = СтрокаТоваров.Номенклатура = ПозицияСтроки(ДанныеСтроки)
		И СтрокаТоваров.Характеристика = ДанныеСтроки.Характеристика
		И СтрокаТоваров.КоличествоУпаковок = ДанныеСтроки.КоличествоУпаковок;
	УпаковкаПрежняя = Не ЗначениеЗаполнено(ДанныеСтроки.Упаковка) Или СтрокаТоваров.Упаковка = ДанныеСтроки.Упаковка;
	// У готовой продукции выпуска цены нет.
	ЦенаПрежняя = Не ДанныеСтроки.ЦенаИзменена Или Не ПоказыватьСуммы() Или ДанныеСтроки.Вид = ВидВыпуск()
		Или СтрокаТоваров.Цена = ДанныеСтроки.Цена;
	Возврат Совпадает И УпаковкаПрежняя И ЦенаПрежняя;

КонецФункции

// Переносит значения строки формы в строку товаров документа закупки: реквизиты материала без затирания упаковки,
// цена - по правилам плана E12.2 §5.3, код строки и продукция - так, чтобы движения потребностей шли точно.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  СтрокаТоваров - СтрокаТабличнойЧасти, Неопределено - изменяемая строка; не задана - новая.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти - строка товаров документа.
//
Функция ПрименитьДанныеСтрокиЗакупки(ДокОбъект, Знач СтрокаТоваров, ДанныеСтроки)

	ЭтоПоступление = ДанныеСтроки.Вид = ВидПоступление();
	НоваяСтрока = СтрокаТоваров = Неопределено;
	Если НоваяСтрока Тогда
		СтрокаТоваров = ДокОбъект.ТЧТовары.Добавить();
		СтрокаТоваров.КодСтроки = КодНовойСтрокиЗакупки(ДокОбъект, СтрокаТоваров, ДанныеСтроки);
	КонецЕсли;
	НовыйМатериал = НоваяСтрока Или СтрокаТоваров.Номенклатура <> ДанныеСтроки.Материал
		Или СтрокаТоваров.Характеристика <> ДанныеСтроки.Характеристика;
	НоваяУпаковка = ЗначениеЗаполнено(ДанныеСтроки.Упаковка) И СтрокаТоваров.Упаковка <> ДанныеСтроки.Упаковка;
	Если НовыйМатериал Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеСтроки.Материал, "Единица, СтавкаНДС");
		СтрокаТоваров.Номенклатура = ДанныеСтроки.Материал;
		СтрокаТоваров.Характеристика = ДанныеСтроки.Характеристика;
		СтрокаТоваров.СтавкаНДС = Реквизиты.СтавкаНДС;
		СтрокаТоваров.НоменклатураКонтрагента = Справочники.НоменклатураКонтрагентов.ПустаяСсылка();
		Если Не ЗначениеЗаполнено(ДанныеСтроки.Упаковка) Тогда
			СтрокаТоваров.Упаковка = Реквизиты.Единица;
		КонецЕсли;
		Если ЭтоПоступление Тогда
			СтрокаТоваров.Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
			СтрокаТоваров.УказаноНесколькоСерий = Ложь;
			// Розничная и минимальная цены прежнего материала записались бы проведением в цены нового; нули регистр не пишет.
			СтрокаТоваров.ЦенаРозничная = 0;
			СтрокаТоваров.ЦенаМинимальная = 0;
			СтрокаТоваров.ЦенаПоТипуЦен = 0;
		Иначе
			// Продукцию распределяет регистр по пределам: явная продукция отдала бы всё количество одному изделию.
			СтрокаТоваров.Продукция = Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	Если НоваяУпаковка Тогда
		СтрокаТоваров.Упаковка = ДанныеСтроки.Упаковка;
	КонецЕсли;
	СтрокаТоваров.КоличествоУпаковок = ДанныеСтроки.КоличествоУпаковок;
	РаботаСДокументамиКлиентСервер.РассчитатьКоличество(СтрокаТоваров);
	УстановитьЦенуСтрокиЗакупки(ДокОбъект, СтрокаТоваров, ДанныеСтроки, НовыйМатериал, НоваяУпаковка);
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ДокОбъект.ЦенаВключаетНДС);
	Возврат СтрокаТоваров;

КонецФункции

// Цена пользователя с суммами - как введена; иначе новая позиция берёт цену источника, правка количества цену не меняет.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка с рассчитанным количеством.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтрокиДокумента.
//  НовыйМатериал - Булево - новая строка или сменились материал, характеристика.
//  НоваяУпаковка - Булево - сменилась упаковка.
//
Процедура УстановитьЦенуСтрокиЗакупки(ДокОбъект, СтрокаТоваров, ДанныеСтроки, НовыйМатериал, НоваяУпаковка)

	Если ДанныеСтроки.ЦенаИзменена И ПоказыватьСуммы() Тогда
		СтрокаТоваров.Цена = ДанныеСтроки.Цена;
		Возврат;
	КонецЕсли;
	Если НовыйМатериал Тогда
		// Без источника цены новый материал остаётся без цены, а не с ценой прежнего.
		СтрокаТоваров.Цена = 0;
	КонецЕсли;
	Если НовыйМатериал Или НоваяУпаковка Тогда
		СтрокаТоваров.Цена = ЦенаСтрокиЗакупки(ДокОбъект, СтрокаТоваров, ДанныеСтроки);
	КонецЕсли;

КонецПроцедуры

// Код новой строки: у поступления по заказу поставщику - код выбранной строки заказа (продукция поступления - точно по
// ней, ПотребностиПроизводства.ПродукцияСтрокиЗакупки), иначе следующий свободный.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - добавленная строка.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Число - код строки.
//
Функция КодНовойСтрокиЗакупки(ДокОбъект, СтрокаТоваров, ДанныеСтроки)

	Если ДанныеСтроки.Вид = ВидПоступление() И ЗначениеЗаполнено(ДанныеСтроки.ЗаказПоставщику) Тогда
		Возврат ДанныеСтроки.КодСтрокиОснования;
	КонецЕсли;
	Код = 0;
	Для Каждого ДругаяСтрока Из ДокОбъект.ТЧТовары Цикл
		Если ДругаяСтрока <> СтрокаТоваров Тогда
			Код = Макс(Код, ДругаяСтрока.КодСтроки);
		КонецЕсли;
	КонецЦикла;
	Возврат Код + 1;

КонецФункции

// Цена новой строки или строки с новым материалом, характеристикой, упаковкой: цена за базовую единицу из строки заказа
// поставщику-основания или из последнего прайса поставщика, приведённая к упаковке строки и к режиму НДС документа.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка с рассчитанным количеством.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Число - цена за упаковку строки; источника нет - прежняя цена строки.
//
Функция ЦенаСтрокиЗакупки(ДокОбъект, СтрокаТоваров, ДанныеСтроки)

	ЦенаЕдиницы = Неопределено;
	ИсточникСНДС = Истина;
	Если ДанныеСтроки.Вид = ВидПоступление() И ЗначениеЗаполнено(ДанныеСтроки.ЗаказПоставщику) Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА ТоварыЗаказа.Количество = 0
		|			ТОГДА ТоварыЗаказа.Цена
		|		ИНАЧЕ ТоварыЗаказа.Сумма / ТоварыЗаказа.Количество
		|	КОНЕЦ КАК ЦенаЕдиницы,
		|	Заказы.ЦенаВключаетНДС КАК ЦенаВключаетНДС
		|ИЗ
		|	Документ.ЗаказПоставщику.ТЧТовары КАК ТоварыЗаказа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказы
		|		ПО Заказы.Ссылка = ТоварыЗаказа.Ссылка
		|ГДЕ
		|	ТоварыЗаказа.Ссылка = &ЗаказПоставщику
		|	И ТоварыЗаказа.КодСтроки = &КодСтроки
		|	И ТоварыЗаказа.Номенклатура = &Материал
		|	И ТоварыЗаказа.Характеристика = &Характеристика");
		Запрос.УстановитьПараметр("ЗаказПоставщику", ДанныеСтроки.ЗаказПоставщику);
		Запрос.УстановитьПараметр("КодСтроки", ДанныеСтроки.КодСтрокиОснования);
		Запрос.УстановитьПараметр("Материал", ДанныеСтроки.Материал);
		Запрос.УстановитьПараметр("Характеристика", ДанныеСтроки.Характеристика);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЦенаЕдиницы = Выборка.ЦенаЕдиницы;
			ИсточникСНДС = Выборка.ЦенаВключаетНДС;
		КонецЕсли;
	КонецЕсли;
	Если ЦенаЕдиницы = Неопределено Тогда
		ЦенаЕдиницы = ЦенаЕдиницыПоПрайсу(ДанныеСтроки);
	КонецЕсли;
	Если ЦенаЕдиницы = Неопределено Тогда
		Возврат СтрокаТоваров.Цена;
	КонецЕсли;
	Коэффициент = ?(СтрокаТоваров.КоличествоУпаковок = 0, 1, СтрокаТоваров.Количество / СтрокаТоваров.КоличествоУпаковок);
	Цена = ЦенаЕдиницы * Коэффициент;
	// BSLLS:MagicNumber-off - процент в долю и копейки цены.
	Если ИсточникСНДС <> ДокОбъект.ЦенаВключаетНДС Тогда
		Процент = ОбщегоНазначенияВызовСервераПовтИсп.ПроцентСтавкиНДС(СтрокаТоваров.СтавкаНДС);
		Множитель = 1 + Процент / 100;
		Цена = ?(ИсточникСНДС, Цена / Множитель, Цена * Множитель);
	КонецЕсли;
	Возврат Окр(Цена, 2);
	// BSLLS:MagicNumber-on

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента: Материал, Характеристика, Поставщик.
//
// Возвращаемое значение:
//  Число, Неопределено - цена единицы хранения с НДС из последнего прайса поставщика; прайса нет - Неопределено.
//
Функция ЦенаЕдиницыПоПрайсу(ДанныеСтроки)

	Цены = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(ТекущаяДатаСеанса(),
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеСтроки.Материал), ДанныеСтроки.Поставщик);
	Найденная = Неопределено;
	Для Каждого СтрокаЦены Из Цены Цикл
		Если СтрокаЦены.Номенклатура <> ДанныеСтроки.Материал Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаЦены.Характеристика = ДанныеСтроки.Характеристика Или Найденная = Неопределено Тогда
			Найденная = СтрокаЦены;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Найденная = Неопределено, Неопределено, Найденная.Цена);

КонецФункции

// Записывает документ закупки: новый и проведённый - с проведением, черновик - записью (правка черновика его не
// проводит). Отказ проверки заполнения и отказ записи существующего документа ничего не записывают; отказ проведения
// нового документа просит записать его черновиком свежим объектом.
//
// Параметры:
//  ДокОбъект      - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  НовыйДокумент  - Булево - документ создаётся этой записью.
//  Результат      - Структура - см. НовыйРезультатЗаписиСтроки.
//  ДляУдаления    - Булево - запись после удаления строк: правило порядка выпуска и отгрузки не проверяется - уменьшение
//                   не выпускает продукцию второй раз.
//
// Возвращаемое значение:
//  Булево - Истина, если документ записан.
//
Функция ЗаписатьДокументСтроки(ДокОбъект, НовыйДокумент, Результат, ДляУдаления = Ложь)

	Накопленные = ТекстСообщений();
	Если Не ДокОбъект.ПроверитьЗаполнение() Тогда
		Результат.Текст = ТекстНеЗаписано(СоединитьТексты(Накопленные, ТекстСообщений()));
		Возврат Ложь;
	КонецЕсли;
	Проводить = НовыйДокумент Или ДокОбъект.Проведен;
	Попытка
		ЗаписатьОбъектДокумента(ДокОбъект, ?(Проводить, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись),
			Не ДляУдаления);
	Исключение
		Причина = СоединитьТексты(Накопленные, ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
		Результат.Причина = Причина;
		Результат.ЗаписатьЧерновиком = НовыйДокумент;
		Если Не НовыйДокумент Тогда
			Результат.Текст = ТекстНеЗаписано(Причина);
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Проведен = ДокОбъект.Проведен;
	Результат.Текст = СоединитьТексты(Накопленные, ТекстСообщений());
	Возврат Истина;

КонецФункции

// Запись нового документа черновиком после отказа проведения (решение владельца 9).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - свежий новый документ.
//  Результат - Структура - см. НовыйРезультатЗаписиСтроки: Причина - причина отказа проведения.
//
Процедура ЗаписатьЧерновикДокумента(ДокОбъект, Результат)

	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Результат.Текст = ТекстНеЗаписано(СоединитьТексты(Результат.Причина, ТекстОшибкиЗаписи(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Проведен = Ложь;
	Результат.Текст = ТекстНеПроведен(Результат.Причина);

КонецПроцедуры

// Строкам документа, записанного черновиком после отказа проведения, - статус с причиной.
//
// Параметры:
//  Результат - Структура - см. НовыйРезультатЗаписиСтроки.
//
Процедура ОтметитьНепроведенные(Результат)

	Если Результат.Проведен Или ПустаяСтрока(Результат.Причина) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из Результат.СтрокиДокумента Цикл
		Строка.Статус = ТекстНеПроведен(Результат.Причина);
	КонецЦикла;

КонецПроцедуры

// Удаляет строки одного документа закупки; документ без строк помечается на удаление, иначе записывается в прежнем
// режиме.
//
// Параметры:
//  СтрокиДанных - Массив из Структура - см. НовыеДанныеСтрокиДокумента, строки одного документа.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЗаписиСтроки.
//
Функция УдалитьСтрокиОдногоДокумента(СтрокиДанных)

	Результат = НовыйРезультатЗаписиСтроки();
	Первая = СтрокиДанных[0];
	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		Результат.Текст = ТекстЗапретаСтрокиДокумента(ДанныеСтроки, Истина);
		ЧужойКлюч = ДанныеСтроки.НомерСтроки = 0 Или ДанныеСтроки.Вид <> Первая.Вид
			Или ДанныеСтроки.ВерсияДанных <> Первая.ВерсияДанных;
		Если ПустаяСтрока(Результат.Текст) И ЧужойКлюч Тогда
			Результат.Текст = ТекстНеверныеДанныеСтроки();
		КонецЕсли;
		Если Не ПустаяСтрока(Результат.Текст) Тогда
			Результат.Перечитать = Истина;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Результат.Документ = Первая.Документ;
	ДокОбъект = ЗаблокированныйДокументСтроки(Первая, Результат, Истина);
	Если ДокОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если Первая.Вид <> ВидЗаказПоставщику() Тогда
		ПрименитьУдалениеСтрок(ДокОбъект, СтрокиДанных, Результат);
	Иначе
		// Как при правке: пришедшее по удаляемым строкам - под блокировкой потребностей заказа.
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьПотребностиЗаказа(Первая.Заказ);
			ПрименитьУдалениеСтрок(ДокОбъект, СтрокиДанных, Результат);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ОтметитьОтказТранзакции(Результат, ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	Если Результат.Успех И Не Результат.ДокументПомечен Тогда
		Результат.СтрокиДокумента = СтрокиДокументов(Первая.Вид, Неопределено, Первая.Документ);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Удаляет строки из заблокированного документа и записывает его; документ без строк помечается на удаление.
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  СтрокиДанных - Массив из Структура - см. НовыеДанныеСтрокиДокумента.
//  Результат    - Структура - см. НовыйРезультатЗаписиСтроки.
//
Процедура ПрименитьУдалениеСтрок(ДокОбъект, СтрокиДанных, Результат)

	ЭтоВыпуск = ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВыпускПродукции");
	СтрокБыло = СтрокиДокумента(ДокОбъект).Количество();
	Если ЭтоВыпуск Тогда
		Результат.Текст = ТекстЗапретаПравкиВыпуска(ДокОбъект);
	КонецЕсли;
	Если ПустаяСтрока(Результат.Текст) Тогда
		Результат.Текст = УдалитьСтрокиИзДокумента(ДокОбъект, СтрокиДанных);
	КонецЕсли;
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		Возврат;
	КонецЕсли;
	Если СтрокиДокумента(ДокОбъект).Количество() > 0 И ЭтоВыпуск И Не ПересчитатьВыпуск(ДокОбъект, СтрокБыло, Результат) Тогда
		Возврат;
	КонецЕсли;
	Если СтрокиДокумента(ДокОбъект).Количество() = 0 Тогда
		// Пометку ставит непрочитанный заново объект: изменённый объект платформа пометить не даёт. Строки остаются в
		// помеченном документе, рабочее место его больше не показывает. Объектная блокировка сеанса сохраняется.
		ПометитьДокументСтроки(ДокОбъект.Ссылка.ПолучитьОбъект(), Результат);
	Иначе
		ЗаписатьДокументСтроки(ДокОбъект, Ложь, Результат, Истина);
	КонецЕсли;

КонецПроцедуры

// Переносит строку в документ и записывает его: запреты правки, строка без правок, запись с проведением и черновиком
// нового документа после отказа проведения.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  СтрокаТоваров - СтрокаТабличнойЧасти, Неопределено - изменяемая строка; не задана - новая.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтрокиДокумента.
//  НовыйДокумент - Булево - документ создаётся этой записью.
//  Результат     - Структура - см. НовыйРезультатЗаписиСтроки: Успех, Текст, Документ, НомерСтроки.
//
Процедура ИзменитьСтрокуДокумента(ДокОбъект, Знач СтрокаТоваров, ДанныеСтроки, НовыйДокумент, Результат)

	Результат.Текст = ТекстЗапретаПравкиСтрокиДокумента(ДокОбъект, СтрокаТоваров, ДанныеСтроки);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаТоваров <> Неопределено И СтрокаДокументаНеИзменилась(СтрокаТоваров, ДанныеСтроки) Тогда
		Результат.Успех = Истина;
		Результат.Документ = ДокОбъект.Ссылка;
		Результат.НомерСтроки = ДанныеСтроки.НомерСтроки;
		Возврат;
	КонецЕсли;
	СтрокаТоваров = ПрименитьДанныеСтрокиДокумента(ДокОбъект, СтрокаТоваров, ДанныеСтроки, Результат);
	Если СтрокаТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат.НомерСтроки = СтрокиДокумента(ДокОбъект).Индекс(СтрокаТоваров) + 1;
	Если Не ЗаписатьДокументСтроки(ДокОбъект, НовыйДокумент, Результат) И НовыйДокумент И Результат.ЗаписатьЧерновиком Тогда
		// Свежий объект: у первого остались наборы движений, дополнительные свойства проведения и номер.
		ДокОбъект = НовыйДокументСтроки(ДанныеСтроки);
		ПрименитьДанныеСтрокиДокумента(ДокОбъект, Неопределено, ДанныеСтроки, Результат);
		ЗаписатьЧерновикДокумента(ДокОбъект, Результат);
	КонецЕсли;
	Если Результат.Успех Тогда
		Результат.Документ = ДокОбъект.Ссылка;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ на производство.
//
Процедура ЗаблокироватьПотребностиЗаказа(Заказ)

	Блокировка = Новый БлокировкаДанных;
	УправляемыеБлокировки.ПотребностиПроизводства(Блокировка, Заказ);
	Блокировка.Заблокировать();

КонецПроцедуры

// Параметры:
//  Результат  - Структура - см. НовыйРезультатЗаписиСтроки: текст отказа сохраняется, если он уже есть.
//  Информация - ИнформацияОбОшибке - исключение транзакции.
//
Процедура ОтметитьОтказТранзакции(Результат, Информация)

	Результат.Успех = Ложь;
	Результат.ДокументПомечен = Ложь;
	Если ПустаяСтрока(Результат.Текст) Тогда
		Результат.Текст = ТекстНеЗаписано(ТекстОшибкиЗаписи(Информация));
	КонецЕсли;

КонецПроцедуры

// Удаляет строки по номерам с конца вместе с сериями их кодов строк.
//
// Параметры:
//  ДокОбъект    - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - заблокированный документ.
//  СтрокиДанных - Массив из Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - строки удалены из объекта.
//
Функция УдалитьСтрокиИзДокумента(ДокОбъект, СтрокиДанных)

	ЕстьСерии = ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг")
		Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг");
	Строки = СтрокиДокумента(ДокОбъект);
	Номера = Новый СписокЗначений;
	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		Если Номера.НайтиПоЗначению(ДанныеСтроки.НомерСтроки) = Неопределено Тогда
			Номера.Добавить(ДанныеСтроки.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	Номера.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	Удаляемые = Новый Массив;
	Для Каждого ЭлементНомера Из Номера Цикл
		СтрокаТоваров = СтрокаТоваровПоНомеру(ДокОбъект, ЭлементНомера.Значение);
		Текст = ТекстЗапретаУдаленияСтроки(ДокОбъект, СтрокаТоваров);
		Если Не ПустаяСтрока(Текст) Тогда
			Возврат Текст;
		КонецЕсли;
		Удаляемые.Добавить(СтрокаТоваров);
	КонецЦикла;
	Для Каждого СтрокаТоваров Из Удаляемые Цикл
		КодСтроки = СтрокаТоваров.КодСтроки;
		Строки.Удалить(СтрокаТоваров);
		Если ЕстьСерии И Строки.НайтиСтроки(Новый Структура("КодСтроки", КодСтроки)).Количество() = 0 Тогда
			РаботаСДокументамиКлиентСервер.УдалитьСвязанныеСтроки(ДокОбъект, "ТЧСерии", КодСтроки);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Параметры:
//  ДокОбъект     - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  СтрокаТоваров - СтрокаТабличнойЧасти, Неопределено - удаляемая строка; не найдена - документ изменён.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - строку можно удалить.
//
Функция ТекстЗапретаУдаленияСтроки(ДокОбъект, СтрокаТоваров)

	Если СтрокаТоваров = Неопределено Тогда
		Возврат ТекстДокументИзменен();
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		Возврат ТекстЗапретаСтрокиСПоступлениями(ДокОбъект, СтрокаТоваров, Неопределено);
	ИначеЕсли ТипЗнч(ДокОбъект) <> Тип("ДокументОбъект.ВыпускПродукции")
		И (ЗначениеЗаполнено(СтрокаТоваров.Серия) Или СтрокаТоваров.УказаноНесколькоСерий) Тогда
		// Серии и материалы выпуска проверяет ТекстЗапретаПравкиВыпуска.
		Возврат ТекстСтрокаССериями();
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Параметры:
//  ДокОбъект - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ без строк.
//  Результат - Структура - см. НовыйРезультатЗаписиСтроки.
//
Процедура ПометитьДокументСтроки(ДокОбъект, Результат)

	// Платформе для пометки хватает права «Изменение»; рабочее место требует и интерактивную пометку, как форма списка.
	Если Не ПравоДоступа("ИнтерактивнаяПометкаУдаления", ДокОбъект.Метаданные()) Тогда
		Результат.Текст = НСтр("ru = 'Нет права помечать документ на удаление: удалите строки в форме документа.';
			|fr = 'Aucun droit de marquer le document pour suppression : supprimez les lignes dans le document.';
			|en = 'No right to mark the document for deletion: delete the lines in the document form.';
			|es = 'Sin derecho a marcar el documento para eliminar: elimine las líneas en el documento.'");
		Возврат;
	КонецЕсли;
	Накопленные = ТекстСообщений();
	Попытка
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	Исключение
		Результат.Текст = ТекстНеЗаписано(СоединитьТексты(Накопленные, ТекстОшибкиЗаписи(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.ДокументПомечен = Истина;
	Результат.Текст = СоединитьТексты(Накопленные, ТекстСообщений());

КонецПроцедуры

// Действие «Статуса» по одному документу закупки под объектной блокировкой.
//
// Параметры:
//  Документ - ДокументСсылка.ЗаказПоставщику, ДокументСсылка.ПоступлениеТоваровУслуг - документ.
//  Действие - Строка - см. ДействиеВРаботу, ДействиеВЧерновик, ДействиеОтменить.
//  Заказ    - ДокументСсылка.ЗаказПокупателя - текущий заказ рабочего места.
//
// Возвращаемое значение:
//  Структура - Документ, Успех, Текст.
//
Функция ВыполнитьДействиеСтатусаДокумента(Документ, Действие, Заказ)

	Итог = Новый Структура("Документ, Успех, Текст", Документ, Ложь, "");
	Если Не ТипДокументаСтрокиВерен(Документ) Или Не ЗначениеЗаполнено(Документ) Тогда
		Итог.Текст = ТекстНеверныеДанныеСтроки();
		Возврат Итог;
	КонецЕсли;
	Итог.Текст = ТекстЗапретаСтатусаДокумента(Документ, Действие, Заказ);
	Если Не ПустаяСтрока(Итог.Текст) Тогда
		Возврат Итог;
	КонецЕсли;
	Данные = Новый Структура("Документ, ВерсияДанных", Документ, "");
	РезультатЗаписи = НовыйРезультатЗаписиСтроки();
	ДокОбъект = ЗаблокированныйДокументСтроки(Данные, РезультатЗаписи);
	Если ДокОбъект = Неопределено Тогда
		Итог.Текст = РезультатЗаписи.Текст;
		Возврат Итог;
	КонецЕсли;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ЗаказПоставщику") И Действие <> ДействиеВРаботу() Тогда
		// Поступление, проведённое между проверкой и записью, увело бы остаток заказа в минус: повтор проверки под
		// блокировкой потребностей заказа; отказ фиксирует пустую транзакцию.
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьПотребностиЗаказа(Заказ);
			ВыполнитьСнятиеЗаказаПоставщику(ДокОбъект, Действие, РезультатЗаписи);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ОтметитьОтказТранзакции(РезультатЗаписи, ИнформацияОбОшибке());
		КонецПопытки;
	Иначе
		ВыполнитьДействиеДокумента(ДокОбъект, Действие, РезультатЗаписи);
	КонецЕсли;
	Итог.Успех = РезультатЗаписи.Успех;
	Итог.Текст = РезультатЗаписи.Текст;
	Возврат Итог;

КонецФункции

// Параметры:
//  ДокОбъект - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  Действие  - Строка - см. ДействиеВРаботу, ДействиеВЧерновик.
//  Результат - Структура - см. НовыйРезультатЗаписиСтроки.
//
Процедура ЗаписатьДокументСтатусом(ДокОбъект, Действие, Результат)

	Накопленные = ТекстСообщений();
	Режим = ?(Действие = ДействиеВРаботу(), РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.ОтменаПроведения);
	Попытка
		ЗаписатьОбъектДокумента(ДокОбъект, Режим);
	Исключение
		Результат.Текст = ТекстНеЗаписано(СоединитьТексты(Накопленные, ТекстОшибкиЗаписи(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Текст = СоединитьТексты(Накопленные, ТекстСообщений());

КонецПроцедуры

// Записывает документ строки. Проведение ручного выпуска и реализации заказа - в транзакции с повтором правила порядка
// выпуска и отгрузки после записи: оба проведения берут исключительную блокировку истории статусов заказа
// (ПроизводственныеЗаказы.ОбновитьСтадииПослеПроведения), поэтому документ другой стороны, проведённый параллельно,
// после записи уже виден (ревью данных E12.3a, DB-1).
//
// Параметры:
//  ДокОбъект        - ДокументОбъект - документ строки.
//  РежимЗаписи      - РежимЗаписиДокумента - режим записи.
//  ПроверкаПорядка  - Булево - повторять правило порядка выпуска и отгрузки; Ложь - после удаления строк.
//
Процедура ЗаписатьОбъектДокумента(ДокОбъект, РежимЗаписи, ПроверкаПорядка = Истина)

	ПроверятьПорядок = ПроверкаПорядка И РежимЗаписи = РежимЗаписиДокумента.Проведение
		И (ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВыпускПродукции")
		Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг"))
		И ТипЗнч(ДокОбъект.Основание) = Тип("ДокументСсылка.ЗаказПокупателя");
	Если Не ПроверятьПорядок Тогда
		ДокОбъект.Записать(РежимЗаписи);
		Возврат;
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ДокОбъект.Записать(РежимЗаписи);
		Текст = ТекстЗапретаПорядкаВыпускаИОтгрузки(ДокОбъект.Ссылка, ДокОбъект.Основание);
		Если Не ПустаяСтрока(Текст) Тогда
			ВызватьИсключение Текст;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Запрет действия «Статуса»: право пользователя, документ текущего заказа, отмена проведения и пометка заказа
// поставщику, по которому есть поступления (остаток «Заказы поставщикам» ушёл бы в минус), автовыпуск, проведение
// реализации при запрете отгрузки или после выпуска, проведённого позже неё.
//
// Параметры:
//  Документ - ДокументСсылка.ЗаказПоставщику, ДокументСсылка.ПоступлениеТоваровУслуг - документ закупки.
//  Действие - Строка - см. ДействиеВРаботу, ДействиеВЧерновик, ДействиеОтменить.
//  Заказ    - ДокументСсылка.ЗаказПокупателя - текущий заказ.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - действие допустимо.
//
Функция ТекстЗапретаСтатусаДокумента(Документ, Действие, Заказ)

	Реквизиты = РеквизитыДокументаСтроки(Документ);
	Если Реквизиты = Неопределено Или Реквизиты.ЗаказКлиента <> Заказ Тогда
		Возврат ТекстНеверныеДанныеСтроки();
	КонецЕсли;
	Текст = ТекстНетПраваСтатусаДокумента(Документ.Метаданные(), Действие);
	Если Не ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	ИначеЕсли Реквизиты.Автовыпуск Тогда
		Возврат ТекстАвтовыпускЧерезРеализацию();
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЗаказПоставщику") И Действие <> ДействиеВРаботу()
		И ЕстьПоступленияПоЗаказуПоставщику(Документ) Тогда
		Возврат ТекстЗаказПоставщикуСПоступлениями();
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И Действие = ДействиеВРаботу() Тогда
		// Проведение реализации пересчитывает автовыпуск: те же запреты, что у записи строки отгрузки.
		Текст = ТекстЗапретаОтгрузкиЗаказа(Заказ);
		Возврат ?(ПустаяСтрока(Текст), ТекстЗапретаПорядкаВыпускаИОтгрузки(Документ, Заказ), Текст);
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ВыпускПродукции") И Действие = ДействиеВРаботу() Тогда
		Возврат ТекстЗапретаПорядкаВыпускаИОтгрузки(Документ, Заказ);
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Проведение, отмена проведения или пометка заблокированного документа закупки.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг - документ.
//  Действие  - Строка - см. ДействиеВРаботу, ДействиеВЧерновик, ДействиеОтменить.
//  Результат - Структура - см. НовыйРезультатЗаписиСтроки.
//
Процедура ВыполнитьДействиеДокумента(ДокОбъект, Действие, Результат)

	Если Действие = ДействиеОтменить() Тогда
		ПометитьДокументСтроки(ДокОбъект, Результат);
	ИначеЕсли ДокОбъект.Проведен = (Действие = ДействиеВРаботу()) Тогда
		Результат.Текст = ?(ДокОбъект.Проведен, ТекстДокументУжеПроведен(), ТекстДокументУжеЧерновик());
	ИначеЕсли Действие = ДействиеВРаботу() И Не ДокОбъект.ПроверитьЗаполнение() Тогда
		Результат.Текст = ТекстНеЗаписано(ТекстСообщений());
	Иначе
		ЗаписатьДокументСтатусом(ДокОбъект, Действие, Результат);
	КонецЕсли;

КонецПроцедуры

// Отмена проведения или пометка заказа поставщику под блокировкой потребностей заказа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ЗаказПоставщику - заблокированный заказ поставщику.
//  Действие  - Строка - см. ДействиеВЧерновик, ДействиеОтменить.
//  Результат - Структура - см. НовыйРезультатЗаписиСтроки.
//
Процедура ВыполнитьСнятиеЗаказаПоставщику(ДокОбъект, Действие, Результат)

	Если ЕстьПоступленияПоЗаказуПоставщику(ДокОбъект.Ссылка) Тогда
		Результат.Текст = ТекстЗаказПоставщикуСПоступлениями();
	ИначеЕсли Действие = ДействиеОтменить() Тогда
		ПометитьДокументСтроки(ДокОбъект, Результат);
	ИначеЕсли Не ДокОбъект.Проведен Тогда
		Результат.Текст = ТекстДокументУжеЧерновик();
	Иначе
		ЗаписатьДокументСтатусом(ДокОбъект, Действие, Результат);
	КонецЕсли;

КонецПроцедуры

// Есть ли по заказу поставщику поступления: проведённые - по расходу регистра «Заказы поставщикам», непроведённые
// непомеченные - по документам (см. ПришлоПоСтрокеЗаказаПоставщику).
//
// Параметры:
//  ЗаказПоставщику - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//
// Возвращаемое значение:
//  Булево - есть поступления на основании заказа.
//
Функция ЕстьПоступленияПоЗаказуПоставщику(ЗаказПоставщику)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Движения.Регистратор КАК Ссылка
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам КАК Движения
	|ГДЕ
	|	Движения.ЗаказПоставщику = &ЗаказПоставщику
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Движения.Активность
	|	И НЕ Движения.Регистратор ССЫЛКА Документ.ЗаказПоставщику
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Поступления.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|ГДЕ
	|	Поступления.Основание = &ЗаказПоставщику
	|	И НЕ Поступления.ПометкаУдаления");
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Параметры:
//  МетаданныеДокумента - ОбъектМетаданных - документ закупки.
//  Действие            - Строка - см. ДействиеВРаботу, ДействиеВЧерновик, ДействиеОтменить.
//
// Возвращаемое значение:
//  Строка - текст запрета по праву пользователя; пустая строка - право есть.
//
Функция ТекстНетПраваСтатусаДокумента(МетаданныеДокумента, Действие)

	Если Действие = ДействиеВРаботу() Тогда
		Право = "Проведение";
	ИначеЕсли Действие = ДействиеВЧерновик() Тогда
		Право = "ОтменаПроведения";
	ИначеЕсли Действие = ДействиеОтменить() Тогда
		Право = "ИнтерактивнаяПометкаУдаления";
	Иначе
		Возврат ТекстНеверныеДанныеСтроки();
	КонецЕсли;
	Если ПравоДоступа(Право, МетаданныеДокумента) Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'Нет права на это действие с документами «%1».';
		|fr = 'Aucun droit pour cette action sur les documents « %1 ».';
		|en = 'No right for this action on ""%1"" documents.';
		|es = 'Sin derecho para esta acción con los documentos «%1».'");
	Возврат СтрШаблон(Шаблон, МетаданныеДокумента.Представление());

КонецФункции

// Параметры:
//  Номер     - Строка - номер заказа поставщику.
//  Дата      - Дата - дата заказа поставщику.
//  Материал  - СправочникСсылка.Номенклатура - материал строки.
//  Остаток   - Число, Неопределено - остаток к поступлению в базовых единицах; не задан - не выводится.
//  Продукция - СправочникСсылка.Номенклатура, Неопределено - продукция строки; пустая - не выводится.
//
// Возвращаемое значение:
//  Строка - «№ 12 от 15.09 · материал · осталось 5 (продукция)».
//
Функция ПредставлениеСтрокиОснования(Номер, Дата, Материал, Остаток, Продукция)

	Части = Новый Массив;
	ДатаОснования = Формат(Дата, "ДФ=dd.MM");
	НомерИДата = СтрШаблон(НСтр("ru = '№ %1 от %2'; fr = 'N° %1 du %2'; en = 'No. %1 of %2'; es = 'N.º %1 del %2'"),
		СокрЛП(Номер), ДатаОснования);
	Части.Добавить(НомерИДата);
	Части.Добавить(Строка(Материал));
	Если Остаток <> Неопределено Тогда
		ОстатокСтрокой = Формат(Остаток, "ЧГ=0");
		Осталось = СтрШаблон(НСтр("ru = 'осталось %1'; fr = 'reste %1'; en = '%1 left'; es = 'quedan %1'"), ОстатокСтрокой);
		Части.Добавить(Осталось);
	КонецЕсли;
	Текст = СтрСоединить(Части, " · ");
	Если ЗначениеЗаполнено(Продукция) Тогда
		Текст = СтрШаблон("%1 (%2)", Текст, Продукция);
	КонецЕсли;
	Возврат Текст;

КонецФункции

#КонецОбласти

#Область ВыпускИОтгрузки

// Возвращаемое значение:
//  Массив из Строка - виды документов строк нижних закладок.
//
Функция ВидыСтрокДокументов()

	Виды = Новый Массив;
	Виды.Добавить(ВидЗаказПоставщику());
	Виды.Добавить(ВидПоступление());
	Виды.Добавить(ВидВыпуск());
	Виды.Добавить(ВидОтгрузка());
	Возврат Виды;

КонецФункции

// Параметры:
//  Вид - Строка - вид документа строки.
//
// Возвращаемое значение:
//  Булево - строка выпуска или отгрузки (E12.3).
//
Функция ЭтоВыпускИлиОтгрузка(Вид)

	Возврат Вид = ВидВыпуск() Или Вид = ВидОтгрузка();

КонецФункции

// Параметры:
//  Документ - Произвольный - документ «Статуса».
//
// Возвращаемое значение:
//  Булево - ссылка на документ одного из видов строк.
//
Функция ТипДокументаСтрокиВерен(Документ)

	Для Каждого Вид Из ВидыСтрокДокументов() Цикл
		Если ТипЗнч(Документ) = Тип("ДокументСсылка." + Вид) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - материал строки закупки, продукция строки выпуска и отгрузки.
//
Функция ПозицияСтроки(ДанныеСтроки)

	Возврат ?(ЭтоВыпускИлиОтгрузка(ДанныеСтроки.Вид), ДанныеСтроки.Продукция, ДанныеСтроки.Материал);

КонецФункции

// Параметры:
//  ДокОбъект - ДокументОбъект - документ строки.
//
// Возвращаемое значение:
//  ТабличнаяЧасть - строки нижней закладки: готовая продукция у выпуска, товары у остальных документов.
//
Функция СтрокиДокумента(ДокОбъект)

	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВыпускПродукции") Тогда
		Возврат ДокОбъект.ТЧГотоваяПродукция;
	КонецЕсли;
	Возврат ДокОбъект.ТЧТовары;

КонецФункции

// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ на производство.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. ПроизводственныеЗаказы.ВыполнениеПоПродукции.
//
Функция ВыполнениеЗаказаПоПродукции(Заказ)

	Возврат ПроизводственныеЗаказы.ВыполнениеПоПродукции(Заказ);

КонецФункции

// Строки выпусков или реализаций заказа или одного документа в колонках таблиц формы «Выпуски» и «Отгрузки».
//
// Параметры:
//  Вид      - Строка - см. ВидВыпуск, ВидОтгрузка.
//  Заказ    - ДокументСсылка.ЗаказПокупателя, Неопределено - заказ; не задан - строки документа.
//  Документ - ДокументСсылка.ВыпускПродукции, ДокументСсылка.РеализацияТоваровУслуг, Неопределено - один документ.
//
// Возвращаемое значение:
//  Массив из Структура - строки; цены и суммы обнулены у пользователя без сумм.
//
Функция СтрокиВыпусковИлиОтгрузок(Вид, Заказ, Документ)

	Строки = Новый Массив;
	ЭтоВыпуск = Вид = ВидВыпуск();
	// Выпуск показывает основание-реализацию автовыпуска, отгрузка - автовыпуски: нужен и второй вид.
	ДругойВид = ?(ЭтоВыпуск, ВидОтгрузка(), ВидВыпуск());
	Если Не ПравоДоступа("Чтение", Метаданные.Документы[ДругойВид]) Тогда
		Возврат Строки;
	КонецЕсли;
	Запрос = Новый Запрос(?(ЭтоВыпуск, ТекстЗапросаСтрокВыпусков(), ТекстЗапросаСтрокОтгрузок()));
	// Отбор - один документ после записи или документы заказа: у выпуска основание - заказ или его реализация.
	Если Заказ = Неопределено Тогда
		Условие = "Д.Ссылка В (&Основания)";
		Основания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Документ);
	Иначе
		Условие = "Д.Основание В (&Основания)";
		Основания = ?(ЭтоВыпуск, РеализацииЗаказа(Заказ), Новый Массив);
		Основания.Добавить(Заказ);
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", Условие);
	Запрос.УстановитьПараметр("Основания", Основания);
	Пакет = Запрос.ВыполнитьПакет();
	СуммыВидны = ПоказыватьСуммы();
	НачалоДня = НачалоДня(ТекущаяДатаСеанса());
	Если ЭтоВыпуск Тогда
		Выборка = Пакет[Пакет.ВГраница()].Выбрать();
		Пока Выборка.Следующий() Цикл
			Строки.Добавить(СтрокаВыпуска(Выборка, НачалоДня));
		КонецЦикла;
		Возврат Строки;
	КонецЕсли;
	Автовыпуски = ПредставленияАвтовыпусков(Пакет[Пакет.ВГраница()].Выбрать());
	Реализации = Пакет[Пакет.ВГраница() - 1].Выгрузить();
	Реализации.Свернуть("Документ");
	СНалоговой = РеализацииСНалоговойНакладной(Реализации.ВыгрузитьКолонку("Документ"));
	Выборка = Пакет[Пакет.ВГраница() - 1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = СтрокаОтгрузки(Выборка, НачалоДня, СуммыВидны);
		Автовыпуск = Автовыпуски[Выборка.Документ];
		Строка.Автовыпуск = ?(Автовыпуск = Неопределено, "", Автовыпуск);
		Строка.ТолькоПросмотр = Строка.ТолькоПросмотр Или СНалоговой.Найти(Выборка.Документ) <> Неопределено;
		Строки.Добавить(Строка);
	КонецЦикла;
	Возврат Строки;

КонецФункции

// Реализации заказа, и помеченные: их автовыпуски остаются в строках выпуска, пока не помечены сами.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ на производство.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.РеализацияТоваровУслуг - реализации.
//
Функция РеализацииЗаказа(Заказ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Реализации.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации
	|ГДЕ
	|	Реализации.Основание = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Параметры:
//  Выборка   - ВыборкаИзРезультатаЗапроса - строка запроса ТекстЗапросаСтрокВыпусков.
//  НачалоДня - Дата - начало текущего дня сеанса.
//
// Возвращаемое значение:
//  Структура - строка таблицы формы «Выпуски».
//
Функция СтрокаВыпуска(Выборка, НачалоДня)

	Строка = Новый Структура("Документ, НомерСтроки, ВерсияДанных, Продукция, Характеристика, Упаковка, КоличествоУпаковок,
		|Проведен, Склад");
	ЗаполнитьЗначенияСвойств(Строка, Выборка);
	Автовыпуск = ТипЗнч(Выборка.Основание) = Тип("ДокументСсылка.РеализацияТоваровУслуг");
	Статус = ПредставлениеСтатусаДокумента(Выборка.Проведен, Ложь);
	Если Автовыпуск Тогда
		Статус = Статус + ТекстПометкаАвтовыпуска();
	КонецЕсли;
	Строка.Вставить("Статус", Статус);
	Через = ?(Автовыпуск, ПредставлениеНомерОт(Выборка.НомерРеализации, Выборка.ДатаРеализации), "");
	Строка.Вставить("Через", Через);
	Представление = ПредставлениеЗаказаДляВыбора(Выборка.Номер, Выборка.Дата, Выборка.Склад, 0, Выборка.КоличествоДокумента,
		Ложь);
	Строка.Вставить("ДокументПредставление", Представление);
	Строка.Вставить("ДокументЗаСегодня", Выборка.Дата >= НачалоДня);
	Строка.Вставить("Записана", Истина);
	Строка.Вставить("ЦенаИзменена", Ложь);
	ТолькоПросмотр = Автовыпуск Или ЗначениеЗаполнено(Выборка.Серия) Или ЗначениеЗаполнено(Выборка.СерияШапки)
		Или Выборка.ЕстьПрочиеСтроки;
	Строка.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	Возврат Строка;

КонецФункции

// Параметры:
//  Выборка    - ВыборкаИзРезультатаЗапроса - строка запроса ТекстЗапросаСтрокОтгрузок.
//  НачалоДня  - Дата - начало текущего дня сеанса.
//  СуммыВидны - Булево - см. ПоказыватьСуммы.
//
// Возвращаемое значение:
//  Структура - строка таблицы формы «Отгрузки»; Автовыпуск заполняет вызывающий.
//
Функция СтрокаОтгрузки(Выборка, НачалоДня, СуммыВидны)

	Строка = Новый Структура("Документ, НомерСтроки, ВерсияДанных, Продукция, Характеристика, Упаковка, КоличествоУпаковок,
		|Цена, Сумма, Проведен");
	ЗаполнитьЗначенияСвойств(Строка, Выборка);
	СкрытьСуммыСтроки(Строка, СуммыВидны);
	Статус = ПредставлениеСтатусаДокумента(Выборка.Проведен, Ложь);
	Строка.Вставить("Статус", Статус);
	Представление = ПредставлениеЗаказаДляВыбора(Выборка.Номер, Выборка.Дата, Выборка.Контрагент, Выборка.СуммаДокумента,
		Выборка.КоличествоДокумента, СуммыВидны);
	Строка.Вставить("ДокументПредставление", Представление);
	Строка.Вставить("ДокументЗаСегодня", Выборка.Дата >= НачалоДня);
	Строка.Вставить("Записана", Истина);
	Строка.Вставить("ЦенаИзменена", Ложь);
	Строка.Вставить("Автовыпуск", "");
	ТолькоПросмотр = ЗначениеЗаполнено(Выборка.Серия) Или Выборка.УказаноНесколькоСерий Или Выборка.ЕстьПрочиеСтроки
		Или Выборка.ЕстьКассоваяСмена Или Выборка.ПослеВыпуска;
	Строка.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	Возврат Строка;

КонецФункции

// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - автовыпуски реализаций: Реализация, Номер, Дата, Проведен.
//
// Возвращаемое значение:
//  Соответствие - ключ - реализация, значение - «№ от дд.ММ, проведён» её непомеченного автовыпуска.
//
Функция ПредставленияАвтовыпусков(Выборка)

	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Представление = СтрШаблон("%1, %2", ПредставлениеНомерОт(Выборка.Номер, Выборка.Дата),
			НРег(ПредставлениеСтатусаДокумента(Выборка.Проведен, Ложь)));
		Результат.Вставить(Выборка.Реализация, Представление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//  Строка - пакет: отобранные выпуски, выпуски с сериями, партиями или услугами в материалах, итоги, строки.
//
Функция ТекстЗапросаСтрокВыпусков()

	Возврат
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТДокументы
	|ИЗ
	|	Документ.ВыпускПродукции КАК Д
	|ГДЕ
	|	НЕ Д.ПометкаУдаления
	|	И &УсловиеОтбора
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПрочиеСтроки
	|ИЗ
	|	Документ.ВыпускПродукции.ТЧТовары КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|	И Материалы.Партия <> НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Материалы.Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции.ТЧТовары КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|	И Материалы.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Материалы.Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции.ТЧТовары КАК Материалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураМатериалов
	|		ПО НоменклатураМатериалов.Ссылка = Материалы.Номенклатура
	|ГДЕ
	|	Материалы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|	И НоменклатураМатериалов.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Серии.Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции.ТЧСерии КАК Серии
	|ГДЕ
	|	Серии.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрочиеСтроки.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПрочие
	|ИЗ
	|	ВТПрочиеСтроки КАК ПрочиеСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрочиеСтроки.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродукцияИтога.Ссылка КАК Ссылка,
	|	СУММА(ПродукцияИтога.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТИтоги
	|ИЗ
	|	Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ПродукцияИтога
	|ГДЕ
	|	ПродукцияИтога.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродукцияИтога.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Д.Ссылка КАК Документ,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Проведен КАК Проведен,
	|	Д.ВерсияДанных КАК ВерсияДанных,
	|	Д.Основание КАК Основание,
	|	Д.Серия КАК СерияШапки,
	|	Д.МестоХраненияОприходование КАК Склад,
	|	ЕСТЬNULL(Реализации.Номер, """") КАК НомерРеализации,
	|	ЕСТЬNULL(Реализации.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРеализации,
	|	ЕСТЬNULL(Итоги.Количество, 0) КАК КоличествоДокумента,
	|	НЕ Прочие.Ссылка ЕСТЬ NULL КАК ЕстьПрочиеСтроки,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Номенклатура КАК Продукция,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Упаковка КАК Упаковка,
	|	Т.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Т.Серия КАК Серия
	|ИЗ
	|	ВТДокументы КАК Отобранные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции КАК Д
	|		ПО Д.Ссылка = Отобранные.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК Т
	|		ПО Т.Ссылка = Отобранные.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Реализации
	|		ПО Реализации.Ссылка = Д.Основание
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПрочие КАК Прочие
	|		ПО Прочие.Ссылка = Отобранные.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИтоги КАК Итоги
	|		ПО Итоги.Ссылка = Отобранные.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Документ,
	|	НомерСтроки";

КонецФункции

// Возвращаемое значение:
//  Строка - пакет: отобранные реализации, реализации с услугами, доп. расходами или авансами, итоги, реализации с
//           ручным выпуском заказа после них, строки, автовыпуски.
//
Функция ТекстЗапросаСтрокОтгрузок()

	Возврат
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТДокументы
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Д
	|ГДЕ
	|	НЕ Д.ПометкаУдаления
	|	И &УсловиеОтбора
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПрочиеСтроки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧУслуги КАК Услуги
	|ГДЕ
	|	Услуги.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Расходы.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧДополнительныеРасходы КАК Расходы
	|ГДЕ
	|	Расходы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Авансы.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧЗачётАвансов КАК Авансы
	|ГДЕ
	|	Авансы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрочиеСтроки.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПрочие
	|ИЗ
	|	ВТПрочиеСтроки КАК ПрочиеСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрочиеСтроки.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыИтога.Ссылка КАК Ссылка,
	|	СУММА(ТоварыИтога.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТИтоги
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК ТоварыИтога
	|ГДЕ
	|	ТоварыИтога.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыИтога.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Реализации.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПослеВыпуска
	|ИЗ
	|	ВТДокументы КАК Отобранные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Реализации
	|		ПО Реализации.Ссылка = Отобранные.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции КАК Выпуски
	|		ПО Выпуски.Основание = Реализации.Основание
	|			И Выпуски.Проведен
	|			И Выпуски.МоментВремени > Реализации.МоментВремени
	|ГДЕ
	|	Реализации.Основание ССЫЛКА Документ.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Д.Ссылка КАК Документ,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Контрагент КАК Контрагент,
	|	Д.Сумма КАК СуммаДокумента,
	|	Д.Проведен КАК Проведен,
	|	Д.ВерсияДанных КАК ВерсияДанных,
	|	Д.КассоваяСмена <> ЗНАЧЕНИЕ(Документ.КассоваяСмена.ПустаяСсылка) КАК ЕстьКассоваяСмена,
	|	ЕСТЬNULL(Итоги.Количество, 0) КАК КоличествоДокумента,
	|	НЕ Прочие.Ссылка ЕСТЬ NULL КАК ЕстьПрочиеСтроки,
	|	НЕ ПослеВыпуска.Ссылка ЕСТЬ NULL КАК ПослеВыпуска,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Номенклатура КАК Продукция,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Упаковка КАК Упаковка,
	|	Т.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Т.Цена КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	Т.Серия КАК Серия,
	|	Т.УказаноНесколькоСерий КАК УказаноНесколькоСерий
	|ИЗ
	|	ВТДокументы КАК Отобранные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Д
	|		ПО Д.Ссылка = Отобранные.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ТЧТовары КАК Т
	|		ПО Т.Ссылка = Отобранные.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПрочие КАК Прочие
	|		ПО Прочие.Ссылка = Отобранные.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИтоги КАК Итоги
	|		ПО Итоги.Ссылка = Отобранные.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПослеВыпуска КАК ПослеВыпуска
	|		ПО ПослеВыпуска.Ссылка = Отобранные.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Документ,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Выпуски.Основание КАК Реализация,
	|	Выпуски.Номер КАК Номер,
	|	Выпуски.Дата КАК Дата,
	|	Выпуски.Проведен КАК Проведен
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|ГДЕ
	|	Выпуски.Основание В
	|			(ВЫБРАТЬ
	|				ВТДокументы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТДокументы)
	|	И НЕ Выпуски.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

КонецФункции

// Реализации, по которым выписана налоговая накладная, - правятся только в форме документа, как в её форме. Налоговые
// накладные оператор производства не читает: читается служебно, наружу уходят только реализации из переданных.
//
// Параметры:
//  Реализации - Массив из ДокументСсылка.РеализацияТоваровУслуг - проверяемые реализации.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.РеализацияТоваровУслуг - реализации с непомеченной налоговой накладной.
//
Функция РеализацииСНалоговойНакладной(Реализации)

	Если Реализации.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Связи.Реализация КАК Реализация
	|ИЗ
	|	(ВЫБРАТЬ
	|		Накладные.Основание КАК Реализация
	|	ИЗ
	|		Документ.НалоговаяНакладная КАК Накладные
	|	ГДЕ
	|		НЕ Накладные.ПометкаУдаления
	|		И Накладные.Основание В (&Реализации)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ТоварыНакладных.ОтгрузкаТовара
	|	ИЗ
	|		Документ.НалоговаяНакладная.ТЧТовары КАК ТоварыНакладных
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НалоговаяНакладная КАК ШапкиТоваров
	|			ПО ШапкиТоваров.Ссылка = ТоварыНакладных.Ссылка
	|	ГДЕ
	|		НЕ ШапкиТоваров.ПометкаУдаления
	|		И ТоварыНакладных.ОтгрузкаТовара В (&Реализации)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		УслугиНакладных.ОтгрузкаТовара
	|	ИЗ
	|		Документ.НалоговаяНакладная.ТЧУслуги КАК УслугиНакладных
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НалоговаяНакладная КАК ШапкиУслуг
	|			ПО ШапкиУслуг.Ссылка = УслугиНакладных.Ссылка
	|	ГДЕ
	|		НЕ ШапкиУслуг.ПометкаУдаления
	|		И УслугиНакладных.ОтгрузкаТовара В (&Реализации)) КАК Связи");
	Запрос.УстановитьПараметр("Реализации", Реализации);
	// BSLLS:SetPrivilegedMode-off - налоговые накладные читаются служебно, наружу - только переданные реализации.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Реализация");

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента: Вид, Заказ.
//
// Возвращаемое значение:
//  СписокЗначений - сегодняшние непомеченные ручные выпуски или реализации заказа, после которых не проведён ручной
//                   выпуск; представление - «№ от дд.ММ склад/клиент на количество/сумма».
//
Функция ДокументыВыпускаИОтгрузкиДляВыбора(ДанныеСтроки)

	Список = Новый СписокЗначений;
	ЭтоВыпуск = ДанныеСтроки.Вид = ВидВыпуск();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Реализации.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПослеВыпуска
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции КАК Выпуски
	|		ПО Выпуски.Основание = Реализации.Основание
	|			И Выпуски.Проведен
	|			И Выпуски.МоментВремени > Реализации.МоментВремени
	|ГДЕ
	|	Реализации.Основание = &Заказ
	|	И Реализации.Дата >= &НачалоДня
	|	И НЕ Реализации.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Д.Ссылка КАК Документ,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Контрагент КАК Контрагент,
	|	Д.Сумма КАК Сумма,
	|	ЕСТЬNULL(СУММА(Т.Количество), 0) КАК Количество
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Д
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ТЧТовары КАК Т
	|		ПО Т.Ссылка = Д.Ссылка
	|ГДЕ
	|	Д.Основание = &Заказ
	|	И Д.Дата >= &НачалоДня
	|	И НЕ Д.ПометкаУдаления
	|	И НЕ Д.Ссылка В
	|				(ВЫБРАТЬ
	|					ВТПослеВыпуска.Ссылка КАК Ссылка
	|				ИЗ
	|					ВТПослеВыпуска)
	|
	|СГРУППИРОВАТЬ ПО
	|	Д.Ссылка,
	|	Д.Номер,
	|	Д.Дата,
	|	Д.Контрагент,
	|	Д.Сумма
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ");
	Если ЭтоВыпуск Тогда
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Д.Ссылка КАК Документ,
		|	Д.Номер КАК Номер,
		|	Д.Дата КАК Дата,
		|	Д.МестоХраненияОприходование КАК Контрагент,
		|	0 КАК Сумма,
		|	ЕСТЬNULL(СУММА(Т.Количество), 0) КАК Количество
		|ИЗ
		|	Документ.ВыпускПродукции КАК Д
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК Т
		|		ПО Т.Ссылка = Д.Ссылка
		|ГДЕ
		|	Д.Основание = &Заказ
		|	И Д.Дата >= &НачалоДня
		|	И НЕ Д.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	Д.Ссылка,
		|	Д.Номер,
		|	Д.Дата,
		|	Д.МестоХраненияОприходование
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
	КонецЕсли;
	Запрос.УстановитьПараметр("Заказ", ДанныеСтроки.Заказ);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДатаСеанса()));
	СуммыВидны = ПоказыватьСуммы() И Не ЭтоВыпуск;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Представление = ПредставлениеЗаказаДляВыбора(Выборка.Номер, Выборка.Дата, Выборка.Контрагент, Выборка.Сумма,
			Выборка.Количество, СуммыВидны);
		Список.Добавить(Выборка.Документ, Представление);
	КонецЦикла;
	Возврат Список;

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Строка - текст запрета незаполненной строки или продукции не из заказа; пустая строка - значения достаточны.
//
Функция ТекстЗапретаЗначенийСтрокиДокумента(ДанныеСтроки)

	Если Не ЭтоВыпускИлиОтгрузка(ДанныеСтроки.Вид) Тогда
		Возврат ТекстЗапретаЗначенийСтрокиЗакупки(ДанныеСтроки);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДанныеСтроки.Продукция) Или ДанныеСтроки.КоличествоУпаковок <= 0 Тогда
		Возврат НСтр("ru = 'Строка не записана: укажите продукцию и количество.';
			|fr = 'Ligne non enregistrée : indiquez le produit et la quantité.';
			|en = 'Line not saved: specify the product and quantity.';
			|es = 'Línea no guardada: indique el producto y la cantidad.'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеСтроки.Характеристика)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтроки.Характеристика, "Владелец") <> ДанныеСтроки.Продукция Тогда
		Возврат НСтр("ru = 'Характеристика не относится к продукции строки.';
			|fr = 'La caractéristique n''appartient pas au produit de la ligne.';
			|en = 'The characteristic does not belong to the line product.';
			|es = 'La característica no pertenece al producto de la línea.'");
	КонецЕсли;
	Если СтрокаЗаказаПродукции(ДанныеСтроки.Заказ, ДанныеСтроки.Продукция, ДанныеСтроки.Характеристика) = Неопределено Тогда
		Возврат НСтр("ru = 'Такой продукции нет в заказе: выпуск и отгрузка вводятся по строкам заказа.';
			|fr = 'Ce produit n''est pas dans la commande : production et expédition se saisissent selon les lignes de la commande.';
			|en = 'This product is not in the order: output and shipment are entered by order lines.';
			|es = 'Este producto no está en el pedido: la producción y el envío se introducen por las líneas del pedido.'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Первая по номеру строка товаров заказа с продукцией и характеристикой - источник цены, вида цены, ставки НДС и скидки
// строки отгрузки (план E12.3a, §11).
//
// Параметры:
//  Заказ          - ДокументСсылка.ЗаказПокупателя - заказ.
//  Продукция      - СправочникСсылка.Номенклатура - продукция.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика.
//
// Возвращаемое значение:
//  Структура, Неопределено - КодСтроки, НоменклатураСтрока, Упаковка, КоличествоУпаковок, Количество, ВидЦены, ЦенаSKU,
//                            Цена, СтавкаНДС, ПроцентСкидки, ЦенаВключаетНДС; строки нет - Неопределено.
//
Функция СтрокаЗаказаПродукции(Заказ, Продукция, Характеристика)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.НоменклатураСтрока КАК НоменклатураСтрока,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Количество КАК Количество,
	|	Товары.ВидЦены КАК ВидЦены,
	|	Товары.ЦенаSKU КАК ЦенаSKU,
	|	Товары.Цена КАК Цена,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.ПроцентСкидки КАК ПроцентСкидки,
	|	Заказы.ЦенаВключаетНДС КАК ЦенаВключаетНДС
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
	|		ПО Заказы.Ссылка = Товары.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|	И Товары.Номенклатура = &Продукция
	|	И Товары.Характеристика = &Характеристика
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Продукция", Продукция);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("КодСтроки, НоменклатураСтрока, Упаковка, КоличествоУпаковок, Количество, ВидЦены, ЦенаSKU,
		|Цена, СтавкаНДС, ПроцентСкидки, ЦенаВключаетНДС");
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Возврат Результат;

КонецФункции

// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ на производство.
//
// Возвращаемое значение:
//  Строка - текст запрета отгрузок клиенту заказа, как у формы реализации; пустая строка - отгружать можно.
//
Функция ТекстЗапретаОтгрузкиЗаказа(Заказ)

	Клиент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заказ, "Контрагент");
	Возврат ТекстЗапретаОтгрузки(Клиент, ТекущаяДатаСеанса());

КонецФункции

// Автовыпуск считает выпущенным только то, что проведено раньше реализации (план E12.3a, §11, P1-5): после ручного
// выпуска, проведённого позже неё, перепроведение реализации выпустило бы продукцию второй раз; ручной выпуск, который
// правят, когда позже него уже проведена реализация, не пересчитал бы её автовыпуск (ревью данных, DB-2).
//
// Параметры:
//  Документ - ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.ВыпускПродукции - записанный документ.
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ на производство.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - документов другой стороны позже этого нет.
//
Функция ТекстЗапретаПорядкаВыпускаИОтгрузки(Документ, Заказ)

	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат "";
	КонецЕсли;
	ЭтоВыпуск = ТипЗнч(Документ) = Тип("ДокументСсылка.ВыпускПродукции");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Выпуски.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|ГДЕ
	|	Выпуски.Основание = &Заказ
	|	И Выпуски.Проведен
	|	И Выпуски.МоментВремени > &Момент");
	Если ЭтоВыпуск Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВыпускПродукции", "Документ.РеализацияТоваровУслуг");
	КонецЕсли;
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Момент", Документ.МоментВремени());
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат "";
	ИначеЕсли ЭтоВыпуск Тогда
		Возврат НСтр("ru = 'После этого выпуска проведена отгрузка по заказу: выпуск добавьте новым документом, этот правьте в форме.';
			|fr = 'Une expédition a été validée après cette production : ajoutez une nouvelle production, modifiez celle-ci dans le document.';
			|en = 'A shipment was posted after this output: add a new output, edit this one in its document form.';
			|es = 'Se contabilizó un envío tras esta producción: añada una producción nueva y edite esta en el documento.'");
	Иначе
		Возврат НСтр("ru = 'После этой отгрузки проведён выпуск по заказу: строку - в новую отгрузку, правку - в форме реализации.';
			|fr = 'Une production a été validée après cette expédition : ligne dans une nouvelle expédition, modification dans la vente.';
			|en = 'An output was posted after this shipment: add the line to a new shipment, edit this one in its form.';
			|es = 'Se contabilizó una producción tras este envío: la línea, en un envío nuevo; la edición, en la venta.'");
	КонецЕсли;

КонецФункции

// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - реализация.
//
// Возвращаемое значение:
//  Строка - текст запрета реализации с услугами, доп. расходами, авансами, кассовой сменой или налоговой накладной.
//
Функция ТекстЗапретаРеализацииОбъекта(ДокОбъект)

	// BSLLS:YoLetterUsage-off - имя табличной части в метаданных.
	ЕстьПрочие = ДокОбъект.ТЧУслуги.Количество() > 0 Или ДокОбъект.ТЧДополнительныеРасходы.Количество() > 0
		Или ДокОбъект.ТЧЗачётАвансов.Количество() > 0 Или ЗначениеЗаполнено(ДокОбъект.КассоваяСмена);
	// BSLLS:YoLetterUsage-on
	Если Не ЕстьПрочие И Не ДокОбъект.Ссылка.Пустая() Тогда
		Реализации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокОбъект.Ссылка);
		ЕстьПрочие = РеализацииСНалоговойНакладной(Реализации).Количество() > 0;
	КонецЕсли;
	Если ЕстьПрочие Тогда
		Возврат НСтр("ru = 'У реализации услуги, доп. расходы, авансы, кассовая смена или налоговая накладная: правьте в форме.';
			|fr = 'La vente a des services, frais, avances, une journée de caisse ou une facture fiscale : modifiez-la dans le document.';
			|en = 'The sale has services, costs, advances, a checkout day or a tax invoice: edit it in the document form.';
			|es = 'La venta tiene servicios, gastos, anticipos, cambio de caja o factura fiscal: edítela en el documento.'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Выпуск, который рабочее место перезаполняет по картам без потерь: без серий, без партий, серий и услуг в материалах, с
// материалами, равными расчёту по картам текущей продукции (план E12.3a, §11, P1-4). Новый выпуск не проверяется.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВыпускПродукции - заблокированный выпуск.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - правка допустима.
//
Функция ТекстЗапретаПравкиВыпуска(ДокОбъект)

	Если ДокОбъект.Ссылка.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	ЕстьСерии = ЗначениеЗаполнено(ДокОбъект.Серия) Или ДокОбъект.ТЧСерии.Количество() > 0;
	Для Каждого СтрокаПродукции Из ДокОбъект.ТЧГотоваяПродукция Цикл
		ЕстьСерии = ЕстьСерии Или ЗначениеЗаполнено(СтрокаПродукции.Серия);
	КонецЦикла;
	Для Каждого Материал Из ДокОбъект.ТЧТовары Цикл
		// Партия - как в запросе строк выпуска: любое значение, и пустая ссылка документа.
		ЕстьСерии = ЕстьСерии Или ЗначениеЗаполнено(Материал.Серия) Или Материал.Партия <> Неопределено;
	КонецЦикла;
	Если ЕстьСерии Или ЕстьУслугиВМатериалах(ДокОбъект) Или Не МатериалыСовпадаютСКартами(ДокОбъект) Тогда
		Возврат НСтр("ru = 'У выпуска серии, партии, услуги или материалы не по действующей карте: правьте его в форме документа.';
			|fr = 'La production a des séries, lots, services ou des matières hors fiche en vigueur : modifiez-la dans le document.';
			|en = 'The output has series, batches, services or materials not matching the current card: edit it in the document form.';
			|es = 'La producción tiene series, lotes, servicios o materiales fuera de la ficha vigente: edítela en el documento.'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Параметры:
//  ДокОбъект - ДокументОбъект.ВыпускПродукции - выпуск.
//
// Возвращаемое значение:
//  Булево - в материалах выпуска есть услуги.
//
Функция ЕстьУслугиВМатериалах(ДокОбъект)

	Материалы = ДокОбъект.ТЧТовары.ВыгрузитьКолонку("Номенклатура");
	Если Материалы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Материалы)
	|	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)");
	Запрос.УстановитьПараметр("Материалы", Материалы);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Параметры:
//  ДокОбъект - ДокументОбъект.ВыпускПродукции - выпуск.
//
// Возвращаемое значение:
//  Булево - материалы выпуска по номенклатуре, характеристике и количеству равны расчёту по картам его продукции.
//
Функция МатериалыСовпадаютСКартами(ДокОбъект)

	ПродукцияБезКарт = Новый Массив;
	Расчет = МатериалыПоКартам(ДокОбъект, ПродукцияБезКарт);
	Если Расчет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Колонки = "Номенклатура, Характеристика";
	Текущие = ДокОбъект.ТЧТовары.Выгрузить(, Колонки + ", Количество");
	Текущие.Свернуть(Колонки, "Количество");
	Расчет.Свернуть(Колонки, "Количество");
	Если Текущие.Количество() <> Расчет.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого СтрокаРасчета Из Расчет Цикл
		Отбор = Новый Структура(Колонки, СтрокаРасчета.Номенклатура, СтрокаРасчета.Характеристика);
		Найденные = Текущие.НайтиСтроки(Отбор);
		Если Найденные.Количество() <> 1 Или Найденные[0].Количество <> СтрокаРасчета.Количество Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Материалы выпуска по действующим на его дату картам продукции (E10) - количество продукции в базовых единицах: иначе
// коэффициент упаковки продукции не дошёл бы до расчёта (план E12.3a, §11).
//
// Параметры:
//  ДокОбъект        - ДокументОбъект.ВыпускПродукции - выпуск со строками готовой продукции.
//  ПродукцияБезКарт - Массив - получает продукцию без непустой карты на дату выпуска.
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - Номенклатура, Характеристика, Упаковка, КоличествоЗаЕдиницу, КоличествоУпаковок и
//                                 Количество (материала); есть продукция без карты - Неопределено.
//
Функция МатериалыПоКартам(ДокОбъект, ПродукцияБезКарт)

	ТЗПродукция = ДокОбъект.ТЧГотоваяПродукция.Выгрузить(, "Номенклатура, Количество");
	ТЗПродукция.Колонки.Количество.Имя = "КоличествоУпаковок";
	Продукция = ТЗПродукция.ВыгрузитьКолонку("Номенклатура");
	Составы = ТехнологическиеКарты.СоставТехкарт(Продукция, ДокОбъект.Дата);
	Для Каждого Позиция Из Продукция Цикл
		Если Составы.Найти(Позиция, "Продукция") = Неопределено И ПродукцияБезКарт.Найти(Позиция) = Неопределено Тогда
			ПродукцияБезКарт.Добавить(Позиция);
		КонецЕсли;
	КонецЦикла;
	Если ПродукцияБезКарт.Количество() > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Материалы = ТехнологическиеКарты.ЗаполнитьМатериалыПоТехкартам(ТЗПродукция, ДокОбъект.Дата);
	Материалы.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Точность = Метаданные.ОпределяемыеТипы.КоличествоНеотрицательное.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти;
	Для Каждого Материал Из Материалы Цикл
		// Количество - как в строке документа: реквизит хранит три знака, иначе сверка с картой не совпала бы на дробных нормах.
		Материал.КоличествоУпаковок = Окр(Материал.КоличествоУпаковок, Точность);
		РаботаСДокументамиКлиентСервер.РассчитатьКоличество(Материал);
		Материал.Количество = Окр(Материал.Количество, Точность);
	КонецЦикла;
	Возврат Материалы;

КонецФункции

// Новый ручной выпуск по заказу (решение 7, план E12.3a §4): реквизиты и склады по умолчанию, основание и организация -
// заказа, дата - текущая.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  ДокументОбъект.ВыпускПродукции - незаписанный выпуск без строк.
//
Функция НовыйВыпуск(ДанныеСтроки)

	ДокОбъект = Документы.ВыпускПродукции.СоздатьДокумент();
	ДокОбъект.Заполнить(Неопределено);
	ДокОбъект.Дата = ТекущаяДатаСеанса();
	ДокОбъект.Основание = ДанныеСтроки.Заказ;
	ДокОбъект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтроки.Заказ, "Организация");
	Если Не ЗначениеЗаполнено(ДокОбъект.МестоХраненияОприходование) Тогда
		ДокОбъект.МестоХраненияОприходование = ДокОбъект.МестоХранения;
	КонецЕсли;
	Возврат ДокОбъект;

КонецФункции

// Новая реализация по заказу: шапка - как при вводе на основании, без строк; склад - оприходования последнего
// проведённого ручного выпуска заказа; вид цен - первой строки заказа, если по договору не задан.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  ДокументОбъект.РеализацияТоваровУслуг - незаписанная реализация без строк.
//
Функция НоваяРеализация(ДанныеСтроки)

	ДокОбъект = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	ДокОбъект.Заполнить(ДанныеСтроки.Заказ);
	ДокОбъект.ТЧТовары.Очистить();
	ДокОбъект.ТЧСерии.Очистить();
	ДокОбъект.Дата = ТекущаяДатаСеанса();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Выпуски.МестоХраненияОприходование КАК Склад
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|ГДЕ
	|	Выпуски.Основание = &Заказ
	|	И Выпуски.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Выпуски.Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Товары.ВидЦены КАК ВидЦены
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки");
	Запрос.УстановитьПараметр("Заказ", ДанныеСтроки.Заказ);
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[0].Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Склад) Тогда
		ДокОбъект.МестоХранения = Выборка.Склад;
	КонецЕсли;
	Выборка = Пакет[1].Выбрать();
	Если Не ЗначениеЗаполнено(ДокОбъект.ВидЦен) И Выборка.Следующий() Тогда
		ДокОбъект.ВидЦен = Выборка.ВидЦены;
	КонецЕсли;
	Возврат ДокОбъект;

КонецФункции

// Переносит значения строки формы в документ строки нижней закладки.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект - документ строки.
//  СтрокаТоваров - СтрокаТабличнойЧасти, Неопределено - изменяемая строка; не задана - новая.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтрокиДокумента.
//  Результат     - Структура - см. НовыйРезультатЗаписиСтроки, получает текст отказа.
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти, Неопределено - строка документа; отказ - Неопределено.
//
Функция ПрименитьДанныеСтрокиДокумента(ДокОбъект, СтрокаТоваров, ДанныеСтроки, Результат)

	Если ДанныеСтроки.Вид = ВидВыпуск() Тогда
		Возврат ПрименитьДанныеСтрокиВыпуска(ДокОбъект, СтрокаТоваров, ДанныеСтроки, Результат);
	ИначеЕсли ДанныеСтроки.Вид = ВидОтгрузка() Тогда
		Возврат ПрименитьДанныеСтрокиОтгрузки(ДокОбъект, СтрокаТоваров, ДанныеСтроки, Результат);
	Иначе
		Возврат ПрименитьДанныеСтрокиЗакупки(ДокОбъект, СтрокаТоваров, ДанныеСтроки);
	КонецЕсли;

КонецФункции

// Строка готовой продукции выпуска: продукция, характеристика, упаковка, количество; шапка и материалы - по строкам.
//
// Параметры:
//  ДокОбъект       - ДокументОбъект.ВыпускПродукции - выпуск.
//  СтрокаПродукции - СтрокаТабличнойЧасти, Неопределено - изменяемая строка; не задана - новая.
//  ДанныеСтроки    - Структура - см. НовыеДанныеСтрокиДокумента.
//  Результат       - Структура - см. НовыйРезультатЗаписиСтроки.
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти, Неопределено - строка готовой продукции; нет карты - Неопределено.
//
Функция ПрименитьДанныеСтрокиВыпуска(ДокОбъект, Знач СтрокаПродукции, ДанныеСтроки, Результат)

	Строки = ДокОбъект.ТЧГотоваяПродукция;
	СтрокБыло = Строки.Количество();
	Если СтрокаПродукции = Неопределено Тогда
		СтрокаПродукции = Строки.Добавить();
		СтрокаПродукции.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Строки);
	КонецЕсли;
	НоваяПозиция = СтрокаПродукции.Номенклатура <> ДанныеСтроки.Продукция
		Или СтрокаПродукции.Характеристика <> ДанныеСтроки.Характеристика;
	Если НоваяПозиция Тогда
		СтрокаПродукции.Номенклатура = ДанныеСтроки.Продукция;
		СтрокаПродукции.Характеристика = ДанныеСтроки.Характеристика;
		СтрокаПродукции.Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
		СтрокаПродукции.Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтроки.Продукция, "Единица");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеСтроки.Упаковка) Тогда
		СтрокаПродукции.Упаковка = ДанныеСтроки.Упаковка;
	КонецЕсли;
	СтрокаПродукции.КоличествоУпаковок = ДанныеСтроки.КоличествоУпаковок;
	РаботаСДокументамиКлиентСервер.РассчитатьКоличество(СтрокаПродукции);
	Если Не ПересчитатьВыпуск(ДокОбъект, СтрокБыло, Результат) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СтрокаПродукции;

КонецФункции

// Шапка выпуска повторяет первую строку готовой продукции (как СинхронизироватьГотовуюПродукцию и форма); розничная цена
// шапки обнуляется при смене продукции шапки и при переходе к одной строке - иначе проведение записало бы цену прежней
// продукции в цены новой (план E12.3a, §11); материалы заменяются расчётом по картам целиком.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВыпускПродукции - выпуск хотя бы с одной строкой готовой продукции.
//  СтрокБыло - Число - строк готовой продукции до правки.
//  Результат - Структура - см. НовыйРезультатЗаписиСтроки, получает текст отказа.
//
// Возвращаемое значение:
//  Булево - Истина, если материалы рассчитаны.
//
Функция ПересчитатьВыпуск(ДокОбъект, СтрокБыло, Результат)

	Строки = ДокОбъект.ТЧГотоваяПродукция;
	ПродукцияБезКарт = Новый Массив;
	Материалы = МатериалыПоКартам(ДокОбъект, ПродукцияБезКарт);
	Если Материалы = Неопределено Тогда
		Шаблон = НСтр("ru = 'Нет технологической карты на дату выпуска: %1. Такой выпуск вводится в форме документа.';
			|fr = 'Aucune fiche technique à la date de production : %1. Saisissez cette production dans le document.';
			|en = 'No routing card on the output date: %1. Enter such an output in the document form.';
			|es = 'No hay ficha técnica en la fecha de producción: %1. Introduzca esta producción en el documento.'");
		Результат.Текст = СтрШаблон(Шаблон, СтрСоединить(ПродукцияБезКарт, ", "));
		Возврат Ложь;
	КонецЕсли;
	Первая = Строки[0];
	ПродукцияСменилась = ДокОбъект.Номенклатура <> Первая.Номенклатура Или ДокОбъект.Характеристика <> Первая.Характеристика;
	Если ПродукцияСменилась Или Строки.Количество() = 1 И СтрокБыло > 1 Тогда
		ДокОбъект.ЦенаРозничная = 0;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ДокОбъект, Первая, "Номенклатура, Характеристика, Серия, Упаковка, КоличествоУпаковок, Количество");
	ДокОбъект.ТЧТовары.Очистить();
	Для Каждого Материал Из Материалы Цикл
		СтрокаМатериала = ДокОбъект.ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаМатериала, Материал, "Номенклатура, Характеристика, Упаковка, КоличествоЗаЕдиницу,
			|КоличествоУпаковок");
		СтрокаМатериала.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ДокОбъект.ТЧТовары);
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаМатериала);
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Строка товаров реализации: продукция и характеристика из строки заказа - вид цены, ставка НДС, скидка и цена за
// базовую единицу, приведённая к режиму НДС реализации; цену с суммами можно ввести; правка количества цену не меняет.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.РеализацияТоваровУслуг - реализация.
//  СтрокаТоваров - СтрокаТабличнойЧасти, Неопределено - изменяемая строка; не задана - новая.
//  ДанныеСтроки  - Структура - см. НовыеДанныеСтрокиДокумента.
//  Результат     - Структура - см. НовыйРезультатЗаписиСтроки, получает отказ.
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти, Неопределено - строка товаров реализации; строки заказа уже нет - Неопределено.
//
Функция ПрименитьДанныеСтрокиОтгрузки(ДокОбъект, Знач СтрокаТоваров, ДанныеСтроки, Результат)

	СтрокаЗаказа = СтрокаЗаказаПродукции(ДанныеСтроки.Заказ, ДанныеСтроки.Продукция, ДанныеСтроки.Характеристика);
	Если СтрокаЗаказа = Неопределено Тогда
		// Заказ поправили после проверки строки.
		Результат.Перечитать = Истина;
		Результат.Текст = ТекстЗаказИзменен();
		Возврат Неопределено;
	КонецЕсли;
	Если СтрокаТоваров = Неопределено Тогда
		СтрокаТоваров = ДокОбъект.ТЧТовары.Добавить();
		СтрокаТоваров.КодСтроки = КодНовойСтрокиОтгрузки(ДокОбъект, СтрокаТоваров, СтрокаЗаказа);
	КонецЕсли;
	НоваяПозиция = СтрокаТоваров.Номенклатура <> ДанныеСтроки.Продукция
		Или СтрокаТоваров.Характеристика <> ДанныеСтроки.Характеристика;
	Если НоваяПозиция Тогда
		СтрокаТоваров.Номенклатура = ДанныеСтроки.Продукция;
		СтрокаТоваров.Характеристика = ДанныеСтроки.Характеристика;
		СтрокаТоваров.Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
		СтрокаТоваров.УказаноНесколькоСерий = Ложь;
		СтрокаТоваров.Партия = Неопределено;
		ЗаполнитьЗначенияСвойств(СтрокаТоваров, СтрокаЗаказа, "НоменклатураСтрока, Упаковка, ВидЦены, СтавкаНДС, ПроцентСкидки");
		СтрокаТоваров.ЦенаSKU = ЦенаЕдиницыЗаказаДляДокумента(СтрокаЗаказа, ДокОбъект.ЦенаВключаетНДС);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеСтроки.Упаковка) Тогда
		СтрокаТоваров.Упаковка = ДанныеСтроки.Упаковка;
	КонецЕсли;
	СтрокаТоваров.КоличествоУпаковок = ДанныеСтроки.КоличествоУпаковок;
	ЦенаВручную = ДанныеСтроки.ЦенаИзменена И ПоказыватьСуммы();
	Если ЦенаВручную Или СтрокаТоваров.ЦенаSKU = 0 И СтрокаТоваров.Цена <> 0 Тогда
		// Ручная цена или строка из формы без цены за единицу: сумма - от цены за упаковку. Расчёт от цены берёт процент
		// скидки из скидки на цену - она пересчитывается от процента, иначе скидка строки заказа обнулилась бы.
		Если ЦенаВручную Тогда
			СтрокаТоваров.Цена = ДанныеСтроки.Цена;
		КонецЕсли;
		// BSLLS:MagicNumber-off - процент в долю.
		ПроцентСкидки = СтрокаТоваров.ПроцентСкидки;
		СтрокаТоваров.СкидкаНаЦену = СтрокаТоваров.Цена / 100 * ПроцентСкидки;
		// BSLLS:MagicNumber-on
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ДокОбъект.ЦенаВключаетНДС, "Цена");
		// Процент из округлённой скидки на цену сдвигался бы при каждой правке: восстанавливается и досчитывается от цены.
		СтрокаТоваров.ПроцентСкидки = ПроцентСкидки;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ДокОбъект.ЦенаВключаетНДС);
	Иначе
		// Цена за упаковку - от цены за базовую единицу: смена упаковки и количества её не искажает.
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТоваров, ДокОбъект.ЦенаВключаетНДС);
	КонецЕсли;
	Возврат СтрокаТоваров;

КонецФункции

// Код новой строки реализации - код строки заказа, если он свободен в документе, иначе следующий.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.РеализацияТоваровУслуг - реализация.
//  СтрокаТоваров - СтрокаТабличнойЧасти - добавленная строка.
//  СтрокаЗаказа  - Структура - см. СтрокаЗаказаПродукции.
//
// Возвращаемое значение:
//  Число - код строки.
//
Функция КодНовойСтрокиОтгрузки(ДокОбъект, СтрокаТоваров, СтрокаЗаказа)

	КодЗаказа = СтрокаЗаказа.КодСтроки;
	КодСвободен = КодЗаказа > 0;
	Для Каждого ДругаяСтрока Из ДокОбъект.ТЧТовары Цикл
		Если ДругаяСтрока <> СтрокаТоваров И ДругаяСтрока.КодСтроки = КодЗаказа Тогда
			КодСвободен = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(КодСвободен, КодЗаказа, РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(ДокОбъект.ТЧТовары));

КонецФункции

// Цена за базовую единицу строки заказа в режиме НДС документа.
//
// Параметры:
//  СтрокаЗаказа    - Структура - см. СтрокаЗаказаПродукции.
//  ЦенаВключаетНДС - Булево - режим НДС документа.
//
// Возвращаемое значение:
//  Число - цена за базовую единицу.
//
Функция ЦенаЕдиницыЗаказаДляДокумента(СтрокаЗаказа, ЦенаВключаетНДС)

	ЦенаЕдиницы = СтрокаЗаказа.ЦенаSKU;
	Если ЦенаЕдиницы = 0 И СтрокаЗаказа.Количество <> 0 Тогда
		ЦенаЕдиницы = СтрокаЗаказа.Цена * СтрокаЗаказа.КоличествоУпаковок / СтрокаЗаказа.Количество;
	КонецЕсли;
	Если СтрокаЗаказа.ЦенаВключаетНДС = ЦенаВключаетНДС Тогда
		Возврат ЦенаЕдиницы;
	КонецЕсли;
	// BSLLS:MagicNumber-off - процент в долю.
	Множитель = 1 + ОбщегоНазначенияВызовСервераПовтИсп.ПроцентСтавкиНДС(СтрокаЗаказа.СтавкаНДС) / 100;
	// BSLLS:MagicNumber-on
	Возврат ?(СтрокаЗаказа.ЦенаВключаетНДС, ЦенаЕдиницы / Множитель, ЦенаЕдиницы * Множитель);

КонецФункции

// Предупреждение о выпуске сверх заказа по продукции строки: запись не запрещается (план E12.3a, §11).
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Строка - текст предупреждения; пустая строка - выпущено не больше заказанного.
//
Функция ТекстВыпускСверхЗаказа(ДанныеСтроки)

	Для Каждого Выполнение Из ВыполнениеЗаказаПоПродукции(ДанныеСтроки.Заказ) Цикл
		ТаПродукция = Выполнение.Номенклатура = ДанныеСтроки.Продукция И Выполнение.Характеристика = ДанныеСтроки.Характеристика;
		Если ТаПродукция И Выполнение.Выпущено > Выполнение.Заказано Тогда
			Шаблон = НСтр("ru = 'Выпущено %1 при заказанных %2: выпуск сверх заказа.';
				|fr = 'Produit %1 pour %2 commandés : production au-delà de la commande.';
				|en = '%1 produced for %2 ordered: output exceeds the order.';
				|es = 'Producidos %1 de %2 pedidos: producción por encima del pedido.'");
			Возврат СтрШаблон(Шаблон, Выполнение.Выпущено, Выполнение.Заказано);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Параметры:
//  Номер - Строка - номер документа.
//  Дата  - Дата - дата документа.
//
// Возвращаемое значение:
//  Строка - «№ 12 от 15.09».
//
Функция ПредставлениеНомерОт(Номер, Дата)

	Возврат СтрШаблон(НСтр("ru = '№ %1 от %2'; fr = 'N° %1 du %2'; en = 'No. %1 of %2'; es = 'N.º %1 del %2'"), СокрЛП(Номер),
		Формат(Дата, "ДФ=dd.MM"));

КонецФункции

