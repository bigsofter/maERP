#Область ПрограммныйИнтерфейс

// Показывать ли суммы в рабочем месте: оператору производства суммы не видны, администратору - видны.
//
// Возвращаемое значение:
//  Булево - Истина, если колонки сумм выводятся.
//
Функция ПоказыватьСуммы() Экспорт

	// BSLLS:IsInRoleMethod-off - скрытие сумм интерфейсное и привязано именно к роли, а не к праву
	Возврат Не РольДоступна("ОператорПроизводства") Или РольДоступна("Администратор");
	// BSLLS:IsInRoleMethod-on

КонецФункции

// Права пользователя на действия рабочего места: по ним форма скрывает кнопки. Запись документов проверяет права сама.
//
// Возвращаемое значение:
//  Структура:
//   * МожноМенятьЗаказы     - Булево - добавление и изменение заказов клиентов.
//   * МожноПроводитьЗаказы  - Булево - проведение и отмена проведения заказов.
//   * МожноПомечатьЗаказы   - Булево - пометка заказов на удаление.
//   * МожноЗаказПоставщику  - Булево - добавление заказов поставщику.
//   * МожноПоступление      - Булево - добавление поступлений товаров.
//   * МожноПередачу         - Булево - добавление передач в переработку.
//   * МожноОтгрузку         - Булево - добавление реализаций.
//
Функция ПраваРабочегоМеста() Экспорт

	МетаданныеЗаказа = Метаданные.Документы.ЗаказПокупателя;
	Добавление = "Добавление";
	Права = Новый Структура;
	МожноМенять = ПравоДоступа(Добавление, МетаданныеЗаказа) И ПравоДоступа("Изменение", МетаданныеЗаказа);
	Права.Вставить("МожноМенятьЗаказы", МожноМенять);
	МожноПроводить = ПравоДоступа("Проведение", МетаданныеЗаказа) И ПравоДоступа("ОтменаПроведения", МетаданныеЗаказа);
	Права.Вставить("МожноПроводитьЗаказы", МожноПроводить);
	МожноПомечать = ПравоДоступа("ИнтерактивнаяПометкаУдаления", МетаданныеЗаказа);
	Права.Вставить("МожноПомечатьЗаказы", МожноПомечать);
	Для Каждого ИмяИДокумент Из ДокументыНаОсновании() Цикл
		МожноДобавлять = ПравоДоступа(Добавление, Метаданные.Документы[ИмяИДокумент.Значение]);
		Права.Вставить(ИмяИДокумент.Ключ, МожноДобавлять);
	КонецЦикла;
	Возврат Права;

КонецФункции

// Строки товаров невыполненных заказов для закладки «Продукция» с отборами панели фильтров. Предел - по заказам, заказ не
// режется. Стадия заказа на производство всегда равна расчёту (E8): у непроведённого заказа она «Черновик»; у продаж
// отсекаются отгруженные, доставленные и выполненные, иначе история продаж вытеснила бы производство.
//
// Параметры:
//  Отборы - Структура, Неопределено - см. НовыеОтборы; не задано - заказы на производство без отборов.
//
// Возвращаемое значение:
//  Структура:
//   * Строки   - ТаблицаЗначений - колонки см. НоваяТаблицаПродукции.
//   * Обрезано - Булево - заказов больше предела, показаны последние.
//
Функция СтрокиПродукции(Отборы = Неопределено) Экспорт

	ОтборыЗапроса = НовыеОтборы();
	Если ТипЗнч(Отборы) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ОтборыЗапроса, Отборы);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСтрокПродукции();
	УстановитьПараметрыОтборов(Запрос, ОтборыЗапроса);
	Пакет = Запрос.ВыполнитьПакет();

	Результат = Новый Структура("Строки, Обрезано", НоваяТаблицаПродукции(), Ложь);
	ВыборкаКоличества = Пакет[2].Выбрать();
	ВыборкаКоличества.Следующий();
	Результат.Обрезано = ВыборкаКоличества.Заказов > ПределЗаказовПродукции();
	СуммыВидны = ПоказыватьСуммы();
	ПоследнийЗаказ = Неопределено;
	Выведено = 0;
	Выборка = Пакет[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Заказ <> ПоследнийЗаказ Тогда
			ПоследнийЗаказ = Выборка.Заказ;
			Выведено = Выведено + 1;
		КонецЕсли;
		Если Выведено > ПределЗаказовПродукции() Тогда
			Прервать;
		КонецЕсли;
		ДобавитьСтрокуПродукции(Результат.Строки, Выборка, СуммыВидны);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отборы панели фильтров рабочего места - одни и те же для закладок «Заказы» и «Продукция». Клиент и продукция ищутся
// по вхождению текста в наименование (решение владельца 2026-09-15).
//
// Возвращаемое значение:
//  Структура:
//   * ВсеЗаказы - Булево - показывать и продажи; иначе только заказы на производство.
//   * Клиент    - Строка - часть наименования клиента; пустая - любой.
//   * Продукция - Строка - часть наименования номенклатуры: заказы с ней в товарах и только её строки; пустая - любая.
//
Функция НовыеОтборы() Экспорт

	Отборы = Новый Структура;
	Отборы.Вставить("ВсеЗаказы", Ложь);
	Отборы.Вставить("Клиент", "");
	Отборы.Вставить("Продукция", "");
	Возврат Отборы;

КонецФункции

// Шаблон ПОДОБНО для поиска по вхождению: служебные символы шаблона в тексте экранируются символом «~», запрос
// использует его в СПЕЦСИМВОЛ.
//
// Параметры:
//  Текст - Строка - искомая часть строки.
//
// Возвращаемое значение:
//  Строка - «%текст%» с экранированными «%», «_», «[», «]», «^» и «~».
//
Функция ШаблонВхождения(Знач Текст) Экспорт

	Текст = СокрЛП(Текст);
	Для Каждого Символ Из СтрРазделить("~,%,_,[,],^", ",") Цикл
		Текст = СтрЗаменить(Текст, Символ, "~" + Символ);
	КонецЦикла;
	Возврат "%" + Текст + "%";

КонецФункции

// Пояснение индикатора выполнения заказа для подсказки колонки «Индикатор»: проценты по кружкам и легенда.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя, Неопределено - текущий заказ; пустой - только легенда.
//
// Возвращаемое значение:
//  Строка - многострочное пояснение на языке пользователя.
//
Функция ПояснениеИндикатора(Заказ) Экспорт

	Легенда = ПроизводственныеЗаказы.ЛегендаИндикатора();
	Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказПокупателя") Или Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Легенда;
	КонецЕсли;
	Показатели = ПоказателиЗаказа(Заказ);
	ФорматПроцента = "ЧН=0";
	Обеспечение = Формат(Показатели.ПроцентОбеспечения, ФорматПроцента);
	Поступление = Формат(Показатели.ПроцентПоступления, ФорматПроцента);
	Выпуск = Формат(Показатели.ПроцентВыпуска, ФорматПроцента);
	Отгрузка = Формат(Показатели.ПроцентОтгрузки, ФорматПроцента);
	Оплата = Формат(Показатели.ПроцентОплаты, ФорматПроцента);
	Шаблон = НСтр("ru = 'Обеспечение материалами %1 %%, поступление материалов %2 %%, выпуск %3 %%, отгрузка %4 %%, оплата %5 %%.';
		|fr = 'Approvisionnement en matières %1 %%, réception des matières %2 %%, production %3 %%, expédition %4 %%, paiement %5 %%.';
		|en = 'Materials ordered %1%%, materials received %2%%, production %3%%, shipment %4%%, payment %5%%.';
		|es = 'Abastecimiento de materiales %1 %%, recepción de materiales %2 %%, producción %3 %%, envío %4 %%, pago %5 %%.'");
	Проценты = СтрШаблон(Шаблон, Обеспечение, Поступление, Выпуск, Отгрузка, Оплата);
	Возврат СтрШаблон("%1%2%3", Проценты, Символы.ПС, Легенда);

КонецФункции

// Черновики заказов на производство клиента - список выбора колонки «Заказ на производство».
//
// Параметры:
//  Клиент - СправочникСсылка.Контрагенты - клиент строки; обособленное подразделение заменяется головным контрагентом,
//           как в форме заказа.
//
// Возвращаемое значение:
//  СписокЗначений - значение ДокументСсылка.ЗаказПокупателя, представление см. ПредставлениеЗаказаДляВыбора;
//                   последними созданные первыми.
//
Функция ЧерновикиКлиента(Клиент) Экспорт

	Результат = Новый СписокЗначений;
	Если ТипЗнч(Клиент) <> Тип("СправочникСсылка.Контрагенты") Или Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 50
	|	Заказы.Ссылка КАК Заказ,
	|	Заказы.Номер КАК Номер,
	|	Заказы.Дата КАК Дата,
	|	Заказы.Контрагент КАК Клиент,
	|	Заказы.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТЧерновики
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказы
	|ГДЕ
	|	Заказы.Контрагент = &Клиент
	|	И НЕ Заказы.Проведен
	|	И НЕ Заказы.ПометкаУдаления
	|	И Заказы.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказаПокупателя.Производство)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказы.Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Черновики.Заказ КАК Заказ,
	|	Черновики.Номер КАК Номер,
	|	Черновики.Дата КАК Дата,
	|	Черновики.Клиент КАК Клиент,
	|	Черновики.Сумма КАК Сумма,
	|	ЕСТЬNULL(СУММА(Товары.Количество), 0) КАК Количество
	|ИЗ
	|	ВТЧерновики КАК Черновики
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|		ПО Товары.Ссылка = Черновики.Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	Черновики.Заказ,
	|	Черновики.Номер,
	|	Черновики.Дата,
	|	Черновики.Клиент,
	|	Черновики.Сумма
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("Клиент", ГоловнойКонтрагент(Клиент));
	СуммыВидны = ПоказыватьСуммы();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Представление = ПредставлениеЗаказаДляВыбора(Выборка.Номер, Выборка.Дата, Выборка.Клиент, Выборка.Сумма,
			Выборка.Количество, СуммыВидны);
		Результат.Добавить(Выборка.Заказ, Представление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Представление заказа в списках выбора и в колонке «Заказ на производство» (решение владельца 2026-09-15):
// «№ 11111 от 12.03 Клиент на 1 250,00», у пользователя без сумм - «… на 15».
//
// Параметры:
//  Номер           - Строка - номер заказа.
//  Дата            - Дата - дата заказа.
//  Клиент          - СправочникСсылка.Контрагенты - контрагент заказа.
//  Сумма           - Число - сумма заказа.
//  Количество      - Число - количество по строкам заказа в базовых единицах.
//  ПоказыватьСуммы - Булево - выводить сумму, иначе количество.
//
// Возвращаемое значение:
//  Строка - представление на языке пользователя.
//
Функция ПредставлениеЗаказаДляВыбора(Номер, Дата, Клиент, Сумма, Количество, ПоказыватьСуммы) Экспорт

	Шаблон = НСтр("ru = '№ %1 от %2 %3 на %4'; fr = 'n° %1 du %2 %3 pour %4'; en = 'No. %1 of %2 %3 for %4';
		|es = 'N.º %1 del %2 %3 por %4'");
	Если ПоказыватьСуммы Тогда
		РазмерЗаказа = Формат(Сумма, "ЧДЦ=2; ЧН=0,00");
	Иначе
		РазмерЗаказа = Формат(Количество, "ЧДЦ=3; ЧН=0");
	КонецЕсли;
	ДатаЗаказа = Формат(Дата, "ДФ=dd.MM");
	Возврат СтрШаблон(Шаблон, СокрЛП(Номер), ДатаЗаказа, Строка(Клиент), РазмерЗаказа);

КонецФункции

// Новая строка данных для записи строки «Продукции»: поля, которые форма передаёт на сервер.
//
// Возвращаемое значение:
//  Структура:
//   * Заказ              - ДокументСсылка.ЗаказПокупателя - заказ строки; пустая ссылка - новый черновик.
//   * Клиент             - СправочникСсылка.Контрагенты - клиент строки.
//   * НомерСтроки        - Число - номер строки товаров записанной строки; 0 - новая строка.
//   * ВерсияДанных       - Строка - версия заказа, с которой строка прочитана; обязательна у записанной строки.
//   * Номенклатура       - СправочникСсылка.Номенклатура - продукция.
//   * Характеристика     - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика.
//   * Упаковка           - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка; пустая - единица номенклатуры.
//   * КоличествоУпаковок - Число - количество в упаковках.
//   * Цена               - Число - цена за упаковку, учитывается при ЦенаИзменена.
//   * ЦенаИзменена       - Булево - пользователь сам изменил цену.
//
Функция НовыеДанныеСтроки() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Заказ", Документы.ЗаказПокупателя.ПустаяСсылка());
	Результат.Вставить("Клиент", Справочники.Контрагенты.ПустаяСсылка());
	Результат.Вставить("НомерСтроки", 0);
	Результат.Вставить("ВерсияДанных", "");
	Результат.Вставить("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
	Результат.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Результат.Вставить("Упаковка", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	Результат.Вставить("КоличествоУпаковок", 0);
	Результат.Вставить("Цена", 0);
	Результат.Вставить("ЦенаИзменена", Ложь);
	Возврат Результат;

КонецФункции

// Причина, по которой строку «Продукции» нельзя записать или удалить, - по данным базы, без записи и без блокировок:
// флаги строки из формы не используются. После блокировки заказа запись проверяет его ещё раз по объекту.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтроки.
//  ДляУдаления  - Булево - проверка удаления: номенклатура, количество и запрет отгрузок не проверяются.
//
// Возвращаемое значение:
//  Строка - текст запрета на языке пользователя; пустая строка - запрета нет.
//
Функция ТекстЗапретаПравкиСтроки(ДанныеСтроки, ДляУдаления = Ложь) Экспорт

	Текст = ТекстЗапретаКлючаСтроки(ДанныеСтроки, ДляУдаления);
	Если ПустаяСтрока(Текст) И Не ДляУдаления Тогда
		Текст = ТекстЗапретаЗначенийСтроки(ДанныеСтроки);
	КонецЕсли;
	Если Не ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	ДатаОтгрузки = ТекущаяДатаСеанса();
	Если ЗначениеЗаполнено(ДанныеСтроки.Заказ) Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеСтроки.Заказ,
			"ВидОперации, Проведен, ПометкаУдаления, Контрагент, ДатаОтгрузки");
		Текст = ТекстЗапретаЗаказа(Реквизиты, ДанныеСтроки.Клиент);
		ДатаОтгрузки = Реквизиты.ДатаОтгрузки;
	КонецЕсли;
	Если ПустаяСтрока(Текст) И Не ДляУдаления Тогда
		Текст = ТекстЗапретаОтгрузки(ДанныеСтроки.Клиент, ДатаОтгрузки);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Записывает строку «Продукции» в заказ-черновик: без заказа создаёт черновик клиента, у существующего заказа
// меняет или добавляет строку товаров, заполняет материалы строки. Заказ пишется обычной записью под пользователем, со
// всеми проверками документа; объектная блокировка, повторная проверка по объекту и сверка версии не дают записать в
// проведённый заказ и затереть чужую правку.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтроки.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЗаписи.
//
Функция ЗаписатьСтрокуПродукции(ДанныеСтроки) Экспорт

	Результат = НовыйРезультатЗаписи();
	Если Не ПроверитьСтрокуДоЗаписи(ДанныеСтроки, Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	ЗаказОбъект = ЗаказДляСтроки(ДанныеСтроки, Результат);
	Если ЗаказОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	СтрокаТоваров = Неопределено;
	Если ДанныеСтроки.НомерСтроки > 0 Тогда
		// Ключ строки - номер при совпавшей версии заказа: коды строк без материалов бывают нулевыми и повторяются.
		Если ДанныеСтроки.НомерСтроки > ЗаказОбъект.ТЧТовары.Количество() Тогда
			Результат.Перечитать = Истина;
			Результат.Текст = ТекстЗаказИзменен();
			Возврат Результат;
		КонецЕсли;
		СтрокаТоваров = ЗаказОбъект.ТЧТовары[ДанныеСтроки.НомерСтроки - 1];
	КонецЕсли;
	Если СтрокаТоваров <> Неопределено И СтрокаНеИзменилась(СтрокаТоваров, ДанныеСтроки) Тогда
		// Окончание редактирования без правок: заказ не перезаписывается, форма получает его строки.
		Результат.Успех = Истина;
		Результат.Заказ = ЗаказОбъект.Ссылка;
		Результат.НомерСтроки = СтрокаТоваров.НомерСтроки;
		ЗаполнитьСтрокиЗаказа(Результат, ЗаказОбъект);
		Возврат Результат;
	КонецЕсли;
	СтрокаТоваров = ПрименитьДанныеСтроки(ЗаказОбъект, СтрокаТоваров, ДанныеСтроки);

	Если Не ЗаписатьЗаказ(ЗаказОбъект, РежимЗаписиДокумента.Запись, Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.НомерСтроки = СтрокаТоваров.НомерСтроки;
	ЗаполнитьСтрокиЗаказа(Результат, ЗаказОбъект);
	Возврат Результат;

КонецФункции

// Удаляет строки «Продукции» вместе с их материалами - одна запись на заказ. Черновик без строк помечается на удаление,
// а не удаляется (решение владельца 2026-09-15).
//
// Параметры:
//  СтрокиДанных - Массив из Структура - см. НовыеДанныеСтроки; нужны Заказ, Клиент, НомерСтроки, ВерсияДанных.
//
// Возвращаемое значение:
//  Массив из Структура - см. НовыйРезультатЗаписи, по одной на заказ; ЗаказПомечен - черновик остался без строк.
//
Функция УдалитьСтрокиПродукции(СтрокиДанных) Экспорт

	Итоги = Новый Массив;
	ПоЗаказам = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		Текст = ТекстЗапретаПравкиСтроки(ДанныеСтроки, Истина);
		Если Не ПустаяСтрока(Текст) Тогда
			Итог = НовыйРезультатЗаписи();
			Итог.Текст = Текст;
			Итоги.Добавить(Итог);
			Продолжить;
		КонецЕсли;
		Группа = ПоЗаказам[ДанныеСтроки.Заказ];
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			ПоЗаказам.Вставить(ДанныеСтроки.Заказ, Группа);
			Порядок.Добавить(ДанныеСтроки.Заказ);
		КонецЕсли;
		Группа.Добавить(ДанныеСтроки);
	КонецЦикла;
	Для Каждого Заказ Из Порядок Цикл
		Итоги.Добавить(УдалитьСтрокиЗаказа(ПоЗаказам[Заказ]));
	КонецЦикла;
	Возврат Итоги;

КонецФункции

// Причина, по которой действие кнопки «Статус» к заказу неприменимо, - по данным базы, без записи.
//
// Параметры:
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ.
//  Действие - Строка - см. ДействиеВРаботу, ДействиеВЧерновик, ДействиеОтменить.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - действие применимо.
//
Функция ТекстЗапретаСтатуса(Заказ, Действие) Экспорт

	Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказПокупателя") Или Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат ТекстНеверныеДанныеСтроки();
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "ВидОперации, Проведен, ПометкаУдаления");
	Возврат ТекстЗапретаДействия(Реквизиты, Действие);

КонецФункции

// Выполняет действие кнопки «Статус» по каждому заказу отдельно: провести, отменить проведение или пометить на удаление.
// Стадия заказа не ставится вручную - её пересчитывают обработчики документа (E8). Отказ по одному заказу не прерывает
// остальные.
//
// Параметры:
//  Заказы   - Массив из ДокументСсылка.ЗаказПокупателя - выделенные заказы.
//  Действие - Строка - см. ДействиеВРаботу, ДействиеВЧерновик, ДействиеОтменить.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Заказ - ДокументСсылка.ЗаказПокупателя - заказ.
//   * Успех - Булево - действие выполнено.
//   * Текст - Строка - причина отказа с сообщениями документа.
//
Функция ИзменитьСтатусЗаказов(Заказы, Действие) Экспорт

	Итоги = Новый Массив;
	Для Каждого Заказ Из Заказы Цикл
		Итоги.Добавить(ВыполнитьДействиеСтатуса(Заказ, Действие));
	КонецЦикла;
	Возврат Итоги;

КонецФункции

// Действие «В работу» кнопки «Статус»: провести заказ.
//
// Возвращаемое значение:
//  Строка - имя действия.
//
Функция ДействиеВРаботу() Экспорт
	Возврат "ВРаботу";
КонецФункции

