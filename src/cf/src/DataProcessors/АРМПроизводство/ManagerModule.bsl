// Строки выпусков и реализаций текущего заказа на производство для нижних закладок (E12.3): строки готовой продукции
// непомеченных ручных выпусков заказа и автовыпусков его реализаций, строки товаров непомеченных реализаций заказа.
// Вид документа без права чтения не читается.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя, Неопределено - текущий заказ.
//
// Возвращаемое значение:
//  Структура:
//   * Выпуски  - Массив из Структура - колонки таблицы формы «Выпуски», см. СтрокиДокументов.
//   * Отгрузки - Массив из Структура - колонки таблицы формы «Отгрузки».
//
Функция СтрокиВыпусковИОтгрузок(Заказ) Экспорт

	Результат = Новый Структура("Выпуски, Отгрузки", Новый Массив, Новый Массив);
	Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказПокупателя") Или Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Выпуски = СтрокиДокументов(ВидВыпуск(), Заказ, Неопределено);
	Результат.Отгрузки = СтрокиДокументов(ВидОтгрузка(), Заказ, Неопределено);
	Возврат Результат;

КонецФункции

// Продукция заказа для колонки «Продукция» строк выпуска и отгрузки с количеством по умолчанию: выпуск - заказано к
// выпуску без выпущенного, отгрузка - заказано без отгруженного (проведённые документы, E8). Отдельный лёгкий вызов при
// выборе продукции - не в ДанныеТекущегоЗаказа (план E12.3a, §11).
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ на производство.
//  Вид   - Строка - см. ВидВыпуск, ВидОтгрузка.
//
// Возвращаемое значение:
//  СписокЗначений - значение - Структура: Продукция, Характеристика, Упаковка (единица номенклатуры), КоличествоУпаковок;
//                   представление - «продукция, характеристика - осталось N».
//
Функция ПродукцияЗаказаДляВыбора(Заказ, Вид) Экспорт

	Список = Новый СписокЗначений;
	ЗаказЗадан = ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") И ЗначениеЗаполнено(Заказ);
	Если Не ЗаказЗадан Или Вид <> ВидВыпуск() И Вид <> ВидОтгрузка() Тогда
		Возврат Список;
	КонецЕсли;
	ЭтоВыпуск = Вид = ВидВыпуск();
	Для Каждого Выполнение Из ВыполнениеЗаказаПоПродукции(Заказ) Цикл
		Если ЭтоВыпуск Тогда
			КВыпуску = ?(Выполнение.КВыпуску > 0, Выполнение.КВыпуску, Выполнение.Заказано);
			Остаток = Макс(0, КВыпуску - Выполнение.Выпущено);
		Иначе
			Остаток = Макс(0, Выполнение.Заказано - Выполнение.Отгружено);
		КонецЕсли;
		Значение = Новый Структура("Продукция, Характеристика, Упаковка");
		ЗаполнитьЗначенияСвойств(Значение, Выполнение);
		Значение.Продукция = Выполнение.Номенклатура;
		Значение.Упаковка = Выполнение.Единица;
		Значение.Вставить("КоличествоУпаковок", Остаток);
		Части = Новый Массив;
		Части.Добавить(Строка(Выполнение.Номенклатура));
		Если ЗначениеЗаполнено(Выполнение.Характеристика) Тогда
			Части.Добавить(Строка(Выполнение.Характеристика));
		КонецЕсли;
		ОстатокСтрокой = Формат(Остаток, "ЧГ=0; ЧН=0");
		Осталось = СтрШаблон(НСтр("ru = 'осталось %1'; fr = 'reste %1'; en = '%1 left'; es = 'quedan %1'"), ОстатокСтрокой);
		Список.Добавить(Значение, СтрШаблон("%1 - %2", СтрСоединить(Части, ", "), Осталось));
	КонецЦикла;
	Возврат Список;

КонецФункции

// Строки заказов поставщику и поступлений текущего заказа на производство для нижних закладок (E12.2): строки товаров
// непомеченных документов, чьё основание - заказ; у поступления - и заказ поставщику этого заказа. Вид документа без
// права чтения не читается.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя, Неопределено - текущий заказ.
//
// Возвращаемое значение:
//  Структура:
//   * ЗаказыПоставщику - Массив из Структура - колонки таблицы формы «ЗаказыПоставщику», см. СтрокиДокументов.
//   * Поступления      - Массив из Структура - колонки таблицы формы «Поступления».
//
Функция СтрокиЗакупок(Заказ) Экспорт

	Результат = Новый Структура("ЗаказыПоставщику, Поступления", Новый Массив, Новый Массив);
	Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказПокупателя") Или Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.ЗаказыПоставщику = СтрокиДокументов(ВидЗаказПоставщику(), Заказ, Неопределено);
	Результат.Поступления = СтрокиДокументов(ВидПоступление(), Заказ, Неопределено);
	Возврат Результат;

КонецФункции

// Пустые данные строки документа нижней закладки для записи: форма заполняет их из строки таблицы.
//
// Возвращаемое значение:
//  Структура:
//   * Вид                     - Строка - см. ВидЗаказПоставщику, ВидПоступление, ВидВыпуск, ВидОтгрузка.
//   * Заказ                   - ДокументСсылка.ЗаказПокупателя - заказ на производство верхней таблицы.
//   * Документ                - ДокументСсылка.ЗаказПоставщику, ДокументСсылка.ПоступлениеТоваровУслуг,
//                               ДокументСсылка.ВыпускПродукции, ДокументСсылка.РеализацияТоваровУслуг, Неопределено -
//                               документ строки; пустой - новый документ.
//   * НомерСтроки             - Число - номер строки в документе; 0 - новая строка.
//   * ВерсияДанных            - Строка - версия документа, прочитанная формой.
//   * Поставщик               - СправочникСсылка.Контрагенты - поставщик.
//   * ЗаказПоставщику         - ДокументСсылка.ЗаказПоставщику - строка поступления: заказ поставщику-основание.
//   * КодСтрокиОснования      - Число - строка поступления: код строки заказа поставщику.
//   * НомерВходящегоДокумента - Строка - строка поступления: номер накладной поставщика.
//   * ДатаВходящегоДокумента  - Дата - строка поступления: дата накладной поставщика.
//   * Материал                - СправочникСсылка.Номенклатура - строка закупки: материал.
//   * Продукция               - СправочникСсылка.Номенклатура - строка выпуска и отгрузки: продукция.
//   * Характеристика, Упаковка - ссылки строки.
//   * КоличествоУпаковок      - Число - количество.
//   * Цена                    - Число - цена, если её изменил пользователь с суммами.
//   * ЦенаИзменена            - Булево - цену ввёл пользователь.
//
Функция НовыеДанныеСтрокиДокумента() Экспорт

	Данные = Новый Структура;
	Данные.Вставить("Вид", "");
	Данные.Вставить("Заказ", Документы.ЗаказПокупателя.ПустаяСсылка());
	Данные.Вставить("Документ", Неопределено);
	Данные.Вставить("НомерСтроки", 0);
	Данные.Вставить("ВерсияДанных", "");
	Данные.Вставить("Поставщик", Справочники.Контрагенты.ПустаяСсылка());
	Данные.Вставить("ЗаказПоставщику", Документы.ЗаказПоставщику.ПустаяСсылка());
	Данные.Вставить("КодСтрокиОснования", 0);
	Данные.Вставить("НомерВходящегоДокумента", "");
	Данные.Вставить("ДатаВходящегоДокумента", Дата(1, 1, 1));
	Данные.Вставить("Материал", Справочники.Номенклатура.ПустаяСсылка());
	Данные.Вставить("Продукция", Справочники.Номенклатура.ПустаяСсылка());
	Данные.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Данные.Вставить("Упаковка", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	Данные.Вставить("КоличествоУпаковок", 0);
	Данные.Вставить("Цена", 0);
	Данные.Вставить("ЦенаИзменена", Ложь);
	Возврат Данные;

КонецФункции

// Запрет записи или удаления строки документа нижней закладки без записи и без блокировок - по данным базы (для формы и
// сценария).
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//  ДляУдаления  - Булево - проверка удаляемой строки: значения строки не проверяются.
//
// Возвращаемое значение:
//  Строка - текст запрета; пустая строка - строку можно записывать.
//
Функция ТекстЗапретаСтрокиДокумента(ДанныеСтроки, ДляУдаления = Ложь) Экспорт

	Если Не ТипыДанныхСтрокиДокументаВерны(ДанныеСтроки) Тогда
		Возврат ТекстНеверныеДанныеСтроки();
	КонецЕсли;
	Текст = ТекстНетПраваВводаДокументов(ДанныеСтроки.Вид);
	Если ПустаяСтрока(Текст) Тогда
		Текст = ТекстЗапретаЗаказаСтроки(ДанныеСтроки.Заказ);
	КонецЕсли;
	Если ПустаяСтрока(Текст) И Не ДляУдаления Тогда
		Текст = ТекстЗапретаЗначенийСтрокиДокумента(ДанныеСтроки);
	КонецЕсли;
	БезКлюча = Не ЗначениеЗаполнено(ДанныеСтроки.Документ) Или ПустаяСтрока(ДанныеСтроки.ВерсияДанных);
	Если ПустаяСтрока(Текст) И ДанныеСтроки.НомерСтроки <> 0 И БезКлюча Тогда
		Текст = ТекстНеверныеДанныеСтроки();
	КонецЕсли;
	Если ПустаяСтрока(Текст) И ЗначениеЗаполнено(ДанныеСтроки.Документ) Тогда
		Реквизиты = РеквизитыДокументаСтроки(ДанныеСтроки.Документ);
		Текст = ТекстЗапретаДокументаСтроки(Реквизиты, ДанныеСтроки, ДляУдаления);
	КонецЕсли;
	Если ПустаяСтрока(Текст) И Не ДляУдаления И ДанныеСтроки.Вид = ВидПоступление() Тогда
		Текст = ТекстЗапретаОснованияСтрокиПоступления(ДанныеСтроки);
	КонецЕсли;
	Если ПустаяСтрока(Текст) И Не ДляУдаления И ДанныеСтроки.Вид = ВидОтгрузка() Тогда
		Текст = ТекстЗапретаОтгрузкиЗаказа(ДанныеСтроки.Заказ);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Записывает строку документа нижней закладки: находит или создаёт документ, переносит строку, проводит новый и
// проведённый документ (решения владельца 9-11, планы E12.2 §5, E12.3a §4-5). Отказ проведения нового документа -
// документ записывается черновиком; отказ записи существующего - документ не меняется.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЗаписиСтроки.
//
Функция ЗаписатьСтрокуДокумента(ДанныеСтроки) Экспорт

	Результат = НовыйРезультатЗаписиСтроки();
	Результат.Текст = ТекстЗапретаСтрокиДокумента(ДанныеСтроки);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		Результат.Перечитать = ДанныеСтроки.НомерСтроки <> 0 И ТипыДанныхСтрокиДокументаВерны(ДанныеСтроки);
		Возврат Результат;
	КонецЕсли;
	НовыйДокумент = Не ЗначениеЗаполнено(ДанныеСтроки.Документ);
	Если Не НовыйДокумент И СтрокаВБазеНеИзменилась(ДанныеСтроки) Тогда
		// Уход из строки без правок не блокирует документ, который может быть открыт у коллеги.
		Результат.Успех = Истина;
		Результат.Документ = ДанныеСтроки.Документ;
		Результат.НомерСтроки = ДанныеСтроки.НомерСтроки;
		Результат.СтрокиДокумента = СтрокиДокументов(ДанныеСтроки.Вид, Неопределено, ДанныеСтроки.Документ);
		Возврат Результат;
	КонецЕсли;
	ДокументИСтрока = ДокументИСтрокаДокумента(ДанныеСтроки, НовыйДокумент, Результат);
	Если ДокументИСтрока = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ДокОбъект = ДокументИСтрока.ДокОбъект;
	СтрокаТоваров = ДокументИСтрока.СтрокаТоваров;
	Если НовыйДокумент Или ДанныеСтроки.Вид <> ВидЗаказПоставщику() Тогда
		ИзменитьСтрокуДокумента(ДокОбъект, СтрокаТоваров, ДанныеСтроки, НовыйДокумент, Результат);
	Иначе
		// Пришедшее по строке проверяется и заказ поставщику пишется под блокировкой потребностей заказа, которую берёт
		// проведение поступления: иначе поступление между проверкой и записью увело бы остаток заказа в минус. Отказ
		// проверки ничего не пишет и фиксирует пустую транзакцию: откат вложенной транзакции испортил бы внешнюю.
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьПотребностиЗаказа(ДанныеСтроки.Заказ);
			ИзменитьСтрокуДокумента(ДокОбъект, СтрокаТоваров, ДанныеСтроки, Ложь, Результат);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ОтметитьОтказТранзакции(Результат, ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	Если Результат.Успех Тогда
		Результат.СтрокиДокумента = СтрокиДокументов(ДанныеСтроки.Вид, Неопределено, Результат.Документ);
		ОтметитьНепроведенные(Результат);
	КонецЕсли;
	Если Результат.Успех И ДанныеСтроки.Вид = ВидВыпуск() Тогда
		Результат.Текст = СоединитьТексты(Результат.Текст, ТекстВыпускСверхЗаказа(ДанныеСтроки));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Удаляет строки документов нижних закладок одним вызовом по каждому документу: документ без строк помечается на
// удаление.
//
// Параметры:
//  СтрокиДанных - Массив из Структура - см. НовыеДанныеСтрокиДокумента, записанные строки.
//
// Возвращаемое значение:
//  Массив из Структура - см. НовыйРезультатЗаписиСтроки, по документу.
//
Функция УдалитьСтрокиДокументов(СтрокиДанных) Экспорт

	Итоги = Новый Массив;
	ПоДокументам = Новый Соответствие;
	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		Если ПоДокументам[ДанныеСтроки.Документ] = Неопределено Тогда
			ПоДокументам.Вставить(ДанныеСтроки.Документ, Новый Массив);
		КонецЕсли;
		ПоДокументам[ДанныеСтроки.Документ].Добавить(ДанныеСтроки);
	КонецЦикла;
	Для Каждого ДокументИСтроки Из ПоДокументам Цикл
		Итоги.Добавить(УдалитьСтрокиОдногоДокумента(ДокументИСтроки.Значение));
	КонецЦикла;
	Возврат Итоги;

КонецФункции

// Документы для колонки «Документ» новой строки: сегодняшние непомеченные документы этого заказа того же вида; у закупок
// - того же поставщика, у поступления - и того же основания и номера входящего документа (решение владельца 10); у
// выпуска - ручные выпуски заказа; у отгрузки - реализации, после которых не проведён ручной выпуск заказа.
//
// Параметры:
//  ДанныеСтроки - Структура - см. НовыеДанныеСтрокиДокумента: Вид, Заказ, Поставщик, ЗаказПоставщику,
//                 НомерВходящегоДокумента.
//
// Возвращаемое значение:
//  СписокЗначений - значение - документ, представление - «№ от дд.ММ контрагент на сумма/количество»; свежие первыми.
//
Функция ДокументыСтрокиДляВыбора(ДанныеСтроки) Экспорт

	Список = Новый СписокЗначений;
	СтрокаВерна = ТипыДанныхСтрокиДокументаВерны(ДанныеСтроки)
		И (ЭтоВыпускИлиОтгрузка(ДанныеСтроки.Вид) Или ЗначениеЗаполнено(ДанныеСтроки.Поставщик));
	Если Не СтрокаВерна Или Не ПравоДоступа("Чтение", Метаданные.Документы[ДанныеСтроки.Вид]) Тогда
		Возврат Список;
	КонецЕсли;
	Если ЭтоВыпускИлиОтгрузка(ДанныеСтроки.Вид) Тогда
		Возврат ДокументыВыпускаИОтгрузкиДляВыбора(ДанныеСтроки);
	КонецЕсли;
	Запрос = Новый Запрос(ТекстЗапросаДокументовДляВыбора(ДанныеСтроки.Вид));
	Запрос.УстановитьПараметр("Поставщик", ДанныеСтроки.Поставщик);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДатаСеанса()));
	Если ДанныеСтроки.Вид = ВидПоступление() Тогда
		Основание = ?(ЗначениеЗаполнено(ДанныеСтроки.ЗаказПоставщику), ДанныеСтроки.ЗаказПоставщику, ДанныеСтроки.Заказ);
		Запрос.УстановитьПараметр("Основание", Основание);
		Запрос.УстановитьПараметр("НомерВходящегоДокумента", СокрЛП(ДанныеСтроки.НомерВходящегоДокумента));
	Иначе
		Запрос.УстановитьПараметр("Основание", ДанныеСтроки.Заказ);
	КонецЕсли;
	СуммыВидны = ПоказыватьСуммы();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Представление = ПредставлениеЗаказаДляВыбора(Выборка.Номер, Выборка.Дата, Выборка.Поставщик, Выборка.Сумма,
			Выборка.Количество, СуммыВидны);
		Список.Добавить(Выборка.Документ, Представление);
	КонецЦикла;
	Возврат Список;

КонецФункции

// Строки проведённых заказов поставщику этого заказа, по которым материал ещё не пришёл, - для колонки «Заказ
// поставщику» строки поступления. Строка выбирается целиком: её код строки связывает поступление с продукцией.
//
// Параметры:
//  Заказ          - ДокументСсылка.ЗаказПокупателя - заказ на производство.
//  Поставщик      - СправочникСсылка.Контрагенты - поставщик; пустой - любой.
//  Материал       - СправочникСсылка.Номенклатура - материал; пустой - любой.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика при заданном материале.
//
// Возвращаемое значение:
//  СписокЗначений - значение - Структура: ЗаказПоставщику, КодСтроки, Поставщик, Материал, Характеристика, Упаковка,
//                   КоличествоУпаковок (остаток в упаковках строки); представление - «№ от дд.ММ · материал ·
//                   осталось N (продукция)».
//
Функция СтрокиЗаказовПоставщикуДляВыбора(Заказ, Поставщик, Материал, Характеристика) Экспорт

	Список = Новый СписокЗначений;
	ЗаказЗадан = ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") И ЗначениеЗаполнено(Заказ);
	МожноЧитать = ПравоДоступа("Чтение", Метаданные.Документы.ЗаказПоставщику)
		И ПравоДоступа("Чтение", Метаданные.Документы.ПоступлениеТоваровУслуг);
	Если Не ЗаказЗадан Или Не МожноЧитать Тогда
		Возврат Список;
	КонецЕсли;
	Запрос = Новый Запрос(ТекстЗапросаСтрокОснований());
	Запрос.УстановитьПараметр("ЗаказыПоставщику", ЗаказыПоставщикуЗаказа(Заказ));
	Запрос.УстановитьПараметр("ЛюбойПоставщик", Не ЗначениеЗаполнено(Поставщик));
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("ЛюбойМатериал", Не ЗначениеЗаполнено(Материал));
	Запрос.УстановитьПараметр("Материал", Материал);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Коэффициент = ?(Выборка.КоличествоУпаковок = 0 Или Выборка.Количество = 0, 1,
			Выборка.Количество / Выборка.КоличествоУпаковок);
		Значение = Новый Структура("ЗаказПоставщику, КодСтроки, Поставщик, Материал, Характеристика, Упаковка");
		ЗаполнитьЗначенияСвойств(Значение, Выборка);
		Значение.Вставить("КоличествоУпаковок", Выборка.Остаток / Коэффициент);
		Представление = ПредставлениеСтрокиОснования(Выборка.Номер, Выборка.Дата, Выборка.Материал, Выборка.Остаток,
			Выборка.Продукция);
		Список.Добавить(Значение, Представление);
	КонецЦикла;
	Возврат Список;

КонецФункции

// Основной поставщик материала - поставщик новой строки закупки по умолчанию.
//
// Параметры:
//  Материал - СправочникСсылка.Номенклатура - материал строки.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты - основной поставщик; пустая ссылка - не задан.
//
Функция ОсновнойПоставщик(Материал) Экспорт

	Если ТипЗнч(Материал) <> Тип("СправочникСсылка.Номенклатура") Или Не ЗначениеЗаполнено(Материал) Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	Поставщик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Материал, "ОсновнойПоставщик");
	Возврат ?(ЗначениеЗаполнено(Поставщик), Поставщик, Справочники.Контрагенты.ПустаяСсылка());

КонецФункции

// «Статус» нижних закладок по документам отмеченных строк: провести, отменить проведение, пометить на удаление.
// Отказ по одному документу не прерывает остальные.
//
// Параметры:
//  ДокументыЗакупки - Массив из ДокументСсылка - документы строк: заказы поставщику, поступления, выпуски, реализации.
//  Действие         - Строка - см. ДействиеВРаботу (провести), ДействиеВЧерновик, ДействиеОтменить.
//  Заказ            - ДокументСсылка.ЗаказПокупателя - текущий заказ: документы другого заказа отклоняются.
//
// Возвращаемое значение:
//  Массив из Структура - Документ, Успех, Текст.
//
Функция ИзменитьСтатусДокументовСтрок(ДокументыЗакупки, Действие, Заказ) Экспорт

	Итоги = Новый Массив;
	Для Каждого Документ Из ДокументыЗакупки Цикл
		Итоги.Добавить(ВыполнитьДействиеСтатусаДокумента(Документ, Действие, Заказ));
	КонецЦикла;
	Возврат Итоги;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Продукция

// Цена и сумма строки не уходят на клиент пользователю, которому суммы не видны: скрытая колонка данные не прячет.
//
// Параметры:
//  Строка     - СтрокаТаблицыЗначений, Структура - строка с Цена и Сумма.
//  СуммыВидны - Булево - см. ПоказыватьСуммы.
//
Процедура СкрытьСуммыСтроки(Строка, СуммыВидны)

	Если Не СуммыВидны Тогда
		Строка.Цена = 0;
		Строка.Сумма = 0;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Запрос  - Запрос - запрос ТекстЗапросаСтрокПродукции.
//  Отборы  - Структура - см. НовыеОтборы.
//
Процедура УстановитьПараметрыОтборов(Запрос, Отборы)

	ВидыОпераций = Новый Массив;
	ВидыОпераций.Добавить(Перечисления.ВидыОперацийЗаказаПокупателя.Производство);
	Если Отборы.ВсеЗаказы = Истина Тогда
		ВидыОпераций.Добавить(Перечисления.ВидыОперацийЗаказаПокупателя.Продажа);
		ВидыОпераций.Добавить(Перечисления.ВидыОперацийЗаказаПокупателя.ПустаяСсылка());
	КонецЕсли;
	Финальные = Новый Массив;
	Финальные.Добавить(Перечисления.СтатусыЗаказовПокупателя.Выполнен);
	Финальные.Добавить(Перечисления.СтатусыЗаказовПокупателя.Отгружен);
	Финальные.Добавить(Перечисления.СтатусыЗаказовПокупателя.Доставлен);
	Клиент = ?(ТипЗнч(Отборы.Клиент) = Тип("Строка"), СокрЛП(Отборы.Клиент), "");
	Продукция = ?(ТипЗнч(Отборы.Продукция) = Тип("Строка"), СокрЛП(Отборы.Продукция), "");
	Запрос.УстановитьПараметр("ВидыОпераций", ВидыОпераций);
	Запрос.УстановитьПараметр("ФинальныеСтатусы", Финальные);
	Запрос.УстановитьПараметр("ЕстьКлиент", Не ПустаяСтрока(Клиент));
	Запрос.УстановитьПараметр("Клиент", ШаблонВхождения(Клиент));
	Запрос.УстановитьПараметр("ЕстьПродукция", Не ПустаяСтрока(Продукция));
	Запрос.УстановитьПараметр("Продукция", ШаблонВхождения(Продукция));

КонецПроцедуры

// Возвращаемое значение:
//  Строка - пакет: отобранные заказы, количества заказов, число заказов, строки товаров с показателями стадии.
//
Функция ТекстЗапросаСтрокПродукции()

	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 301
	|	Заказы.Ссылка КАК Заказ,
	|	Заказы.Дата КАК Дата
	|ПОМЕСТИТЬ ВТЗаказы
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних(
	|				,
	|				ЗаказПокупателя В
	|					(ВЫБРАТЬ
	|						ЗаказыОтбора.Ссылка
	|					ИЗ
	|						Документ.ЗаказПокупателя КАК ЗаказыОтбора
	|					ГДЕ
	|						ЗаказыОтбора.ВидОперации В (&ВидыОпераций)
	|						И НЕ ЗаказыОтбора.ПометкаУдаления)) КАК История
	|		ПО История.ЗаказПокупателя = Заказы.Ссылка
	|ГДЕ
	|	НЕ Заказы.ПометкаУдаления
	|	И Заказы.ВидОперации В (&ВидыОпераций)
	|	И НЕ ЕСТЬNULL(История.СтатусЗаказаПокупателя, ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателя.Черновик))
	|				В (&ФинальныеСтатусы)
	|	И ВЫБОР
	|			КОГДА &ЕстьКлиент
	|				ТОГДА Заказы.Контрагент В
	|						(ВЫБРАТЬ
	|							КлиентыОтбора.Ссылка
	|						ИЗ
	|							Справочник.Контрагенты КАК КлиентыОтбора
	|						ГДЕ
	|							КлиентыОтбора.Наименование ПОДОБНО &Клиент СПЕЦСИМВОЛ ""~"")
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьПродукция
	|				ТОГДА Заказы.Ссылка В
	|						(ВЫБРАТЬ
	|							ТоварыОтбора.Ссылка
	|						ИЗ
	|							Документ.ЗаказПокупателя.ТЧТовары КАК ТоварыОтбора
	|						ГДЕ
	|							ТоварыОтбора.Номенклатура В
	|								(ВЫБРАТЬ
	|									ПродукцияОтбора.Ссылка
	|								ИЗ
	|									Справочник.Номенклатура КАК ПродукцияОтбора
	|								ГДЕ
	|									ПродукцияОтбора.Наименование ПОДОБНО &Продукция СПЕЦСИМВОЛ ""~""))
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказы.Дата УБЫВ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Товары.Ссылка КАК Заказ,
	|	СУММА(Товары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТКоличества
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТЗаказы.Заказ
	|			ИЗ
	|				ВТЗаказы)
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ВТЗаказы.Заказ) КАК Заказов
	|ИЗ
	|	ВТЗаказы КАК ВТЗаказы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Заказы.Ссылка КАК Заказ,
	|	Заказы.Номер КАК Номер,
	|	Заказы.Дата КАК Дата,
	|	Заказы.Контрагент КАК Клиент,
	|	Заказы.Сумма КАК СуммаЗаказа,
	|	Заказы.ДатаОтгрузки КАК ДатаОтгрузки,
	|	Заказы.Менеджер КАК Менеджер,
	|	Заказы.Проведен КАК Проведен,
	|	Заказы.ВидОперации КАК ВидОперации,
	|	Заказы.ВерсияДанных КАК ВерсияДанных,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	История.СтатусЗаказаПокупателя КАК Стадия,
	|	ЕСТЬNULL(История.Индикатор, """") КАК Индикатор,
	|	ЕСТЬNULL(Количества.Количество, 0) КАК КоличествоЗаказа
	|ИЗ
	|	ВТЗаказы КАК Отобранные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
	|		ПО Заказы.Ссылка = Отобранные.Заказ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|		ПО Товары.Ссылка = Отобранные.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних(
	|				,
	|				ЗаказПокупателя В
	|					(ВЫБРАТЬ
	|						ВТЗаказы.Заказ
	|					ИЗ
	|						ВТЗаказы)) КАК История
	|		ПО История.ЗаказПокупателя = Отобранные.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоличества КАК Количества
	|		ПО Количества.Заказ = Отобранные.Заказ
	|ГДЕ
	|	ВЫБОР
	|		КОГДА &ЕстьПродукция
	|			ТОГДА Товары.Номенклатура В
	|					(ВЫБРАТЬ
	|						ПродукцияСтрок.Ссылка
	|					ИЗ
	|						Справочник.Номенклатура КАК ПродукцияСтрок
	|					ГДЕ
	|						ПродукцияСтрок.Наименование ПОДОБНО &Продукция СПЕЦСИМВОЛ ""~"")
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Отобранные.Дата УБЫВ,
	|	Заказ,
	|	НомерСтроки";

КонецФункции

// Параметры:
//  Строки     - ТаблицаЗначений - см. НоваяТаблицаПродукции.
//  Выборка    - ВыборкаИзРезультатаЗапроса - строка запроса ТекстЗапросаСтрокПродукции.
//  СуммыВидны - Булево - см. ПоказыватьСуммы.
//
Процедура ДобавитьСтрокуПродукции(Строки, Выборка, СуммыВидны)

	НоваяСтрока = Строки.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	СкрытьСуммыСтроки(НоваяСтрока, СуммыВидны);
	НоваяСтрока.ЗаказПредставление = ПредставлениеЗаказаДляВыбора(Выборка.Номер, Выборка.Дата, Выборка.Клиент,
		Выборка.СуммаЗаказа, Выборка.КоличествоЗаказа, СуммыВидны);
	НоваяСтрока.Записана = Истина;
	ЗаказНаПроизводство = Выборка.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	НоваяСтрока.Редактируется = ЗаказНаПроизводство И Не Выборка.Проведен;
	НоваяСтрока.СтатусДокумента = ПредставлениеСтатусаДокумента(Выборка.Проведен, Ложь);

КонецПроцедуры

// Стадия, индикатор и проценты выполнения заказа из последней записи истории статусов (E8): стадия и индикатор - в
// строки «Продукции», проценты - в пояснение индикатора. Запрос повторяет срез ПроизводственныеЗаказы.ДанныеСтадии и
// дополняет его процентами - см. docs/TECHDEBT.md.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  Структура - Стадия, Индикатор, ПроцентОбеспечения, ПроцентПоступления, ПроцентВыпуска, ПроцентОтгрузки, ПроцентОплаты.
//
Функция ПоказателиЗаказа(Заказ)

	Результат = Новый Структура;
	Результат.Вставить("Стадия", Перечисления.СтатусыЗаказовПокупателя.ПустаяСсылка());
	Результат.Вставить("Индикатор", "");
	ИменаПоказателей = "ПроцентОбеспечения,ПроцентПоступления,ПроцентВыпуска,ПроцентОтгрузки,ПроцентОплаты";
	Для Каждого ИмяПоказателя Из СтрРазделить(ИменаПоказателей, ",") Цикл
		Результат.Вставить(ИмяПоказателя, 0);
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	История.СтатусЗаказаПокупателя КАК Стадия,
	|	История.Индикатор КАК Индикатор,
	|	ВЫРАЗИТЬ(История.ДоляОбеспечения * 100 КАК ЧИСЛО(5, 0)) КАК ПроцентОбеспечения,
	|	ВЫРАЗИТЬ(История.ДоляПоступления * 100 КАК ЧИСЛО(5, 0)) КАК ПроцентПоступления,
	|	ВЫРАЗИТЬ(История.ДоляВыпуска * 100 КАК ЧИСЛО(5, 0)) КАК ПроцентВыпуска,
	|	ВЫРАЗИТЬ(История.ДоляОтгрузки * 100 КАК ЧИСЛО(5, 0)) КАК ПроцентОтгрузки,
	|	ВЫРАЗИТЬ(История.ДоляОплаты * 100 КАК ЧИСЛО(5, 0)) КАК ПроцентОплаты
	|ИЗ
	|	РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних(, ЗаказПокупателя = &Заказ) КАК История");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПределЗаказовПродукции()

	Возврат 300;

КонецФункции

Функция НоваяТаблицаПродукции()

	ТипСтроки = Новый ОписаниеТипов("Строка");
	ТипЧисла = Новый ОписаниеТипов("Число");
