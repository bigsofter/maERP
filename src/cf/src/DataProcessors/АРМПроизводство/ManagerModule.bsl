	Таблица.Колонки.Добавить("Клиент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Таблица.Колонки.Добавить("НомерСтроки", ТипЧисла);
	Таблица.Колонки.Добавить("ВерсияДанных", ТипСтроки);
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
