// Пользователь меняет свой пароль сам: форма работает только с пользователем текущего
// сеанса, чужие пароли отсюда не меняются - это карточка пользователя и права администратора.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();

	Если Не ЗначениеЗаполнено(ПользовательИБ.Имя) Тогда
		// База без пользователей: менять нечего, но форма должна открываться (её проверяет прогон).
		Пользователь = НСтр("ru = 'Пользователь информационной базы не задан';
			|fr = 'Utilisateur de la base d''information non défini';
			|en = 'Infobase user is not set';
			|es = 'Usuario de la base de información no definido'");
		Элементы.УстановитьПароль.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	Пользователь = ?(ПустаяСтрока(ПользовательИБ.ПолноеИмя), ПользовательИБ.Имя, ПользовательИБ.ПолноеИмя);

	// Текущий пароль спрашивается только у того, у кого он есть: иначе подтверждать нечего.
	Элементы.ТекущийПароль.Видимость = ПользовательИБ.ПарольУстановлен;

	Если ПользовательИБ.ЗапрещеноИзменятьПароль Тогда
		Элементы.УстановитьПароль.Доступность = Ложь;
		Элементы.Пояснение.Заголовок = НСтр("ru = 'Администратор запретил вам менять пароль самостоятельно.';
			|fr = 'L''administrateur vous a interdit de changer votre mot de passe vous-même.';
			|en = 'The administrator has forbidden you to change your password yourself.';
			|es = 'El administrador le ha prohibido cambiar su contraseña usted mismo.'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьПароль(Команда)

	Если ПустаяСтрока(НовыйПароль) Тогда
		СообщитьПоПолю("НовыйПароль", НСтр("ru = 'Введите новый пароль'; fr = 'Saisissez le nouveau mot de passe';
			|en = 'Enter the new password'; es = 'Introduzca la nueva contraseña'"));
		Возврат;
	КонецЕсли;

	Если НовыйПароль <> Подтверждение Тогда
		СообщитьПоПолю("Подтверждение", НСтр("ru = 'Пароли не совпадают'; fr = 'Les mots de passe ne correspondent pas';
			|en = 'Passwords do not match'; es = 'Las contraseñas no coinciden'"));
		Возврат;
	КонецЕсли;

	ОписаниеОшибки = СменитьПарольНаСервере(ТекущийПароль, НовыйПароль);

	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
		СообщитьПоПолю("ТекущийПароль", ОписаниеОшибки);
		Возврат;
	КонецЕсли;

	ТекущийПароль = "";
	НовыйПароль = "";
	Подтверждение = "";
	Элементы.ТекущийПароль.Видимость = Истина;

	ПоказатьПредупреждение(, НСтр("ru = 'Пароль изменён. Он потребуется при следующем входе в программу.';
		|fr = 'Le mot de passe a été modifié. Il sera demandé à la prochaine connexion.';
		|en = 'The password has been changed. It will be required at the next sign-in.';
		|es = 'La contraseña ha sido cambiada. Se pedirá en el próximo inicio de sesión.'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает новый пароль пользователю текущего сеанса.
//
// Параметры:
//  ТекущийПароль - Строка - пароль, который сейчас установлен; проверяется, если он есть
//  НовыйПароль   - Строка - устанавливаемый пароль
//
// Возвращаемое значение:
//  Строка - описание отказа; пустая строка, если пароль записан
//
&НаСервереБезКонтекста
Функция СменитьПарольНаСервере(Знач ТекущийПароль, Знач НовыйПароль)

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();

	Если Не ЗначениеЗаполнено(ПользовательИБ.Имя) Тогда
		Возврат НСтр("ru = 'У сеанса нет пользователя информационной базы: менять пароль не у кого';
			|fr = 'La session n''a pas d''utilisateur de la base d''information : il n''y a pas de mot de passe à changer';
			|en = 'The session has no infobase user: there is no password to change';
			|es = 'La sesión no tiene usuario de la base de información: no hay contraseña que cambiar'");
	КонецЕсли;

	Если ПользовательИБ.ЗапрещеноИзменятьПароль Тогда
		Возврат НСтр("ru = 'Администратор запретил вам менять пароль самостоятельно';
			|fr = 'L''administrateur vous a interdit de changer votre mot de passe vous-même';
			|en = 'The administrator has forbidden you to change your password yourself';
			|es = 'El administrador le ha prohibido cambiar su contraseña usted mismo'");
	КонецЕсли;

	Если ПользовательИБ.ПарольУстановлен И Не ТекущийПарольВерный(ТекущийПароль, ПользовательИБ) Тогда
		Возврат НСтр("ru = 'Текущий пароль указан неверно'; fr = 'Le mot de passe actuel est incorrect';
			|en = 'The current password is incorrect'; es = 'La contraseña actual es incorrecta'");
	КонецЕсли;

	Попытка
		ПользовательИБ.Пароль = НовыйПароль;
		ПользовательИБ.Записать();
	Исключение
		// Отказ платформы - например, пароль не отвечает требованиям сложности. Показываем
		// пользователю её текст: он объясняет причину точнее любой нашей формулировки.
		// BSLLS:DeprecatedMethodCall-off
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		// BSLLS:DeprecatedMethodCall-on
	КонецПопытки;

	Возврат "";

КонецФункции

// Совпадает ли введённый текущий пароль с сохранённым.
//
// Параметры:
//  Пароль        - Строка - введённый пользователем текущий пароль
//  ПользовательИБ - ПользовательИнформационнойБазы - пользователь сеанса
//
// Возвращаемое значение:
//  Булево - Истина, если пароль совпал либо проверка недоступна
//
&НаСервереБезКонтекста
Функция ТекущийПарольВерный(Пароль, ПользовательИБ)

	Попытка
		Возврат ПроверитьСоответствиеПароляПользователяСохраняемомуЗначению(Пароль, ПользовательИБ);
	Исключение
		// Проверка недоступна (нет прав на чтение сохраняемого значения) - пропускаем её:
		// пользователь меняет пароль себе и в своём сеансе, подтверждением служит сам вход.
		Возврат Истина;
	КонецПопытки;

КонецФункции

// Показывает сообщение рядом с полем формы.
//
// Параметры:
//  ИмяПоля - Строка - имя реквизита формы
//  Текст   - Строка - сообщение
//
&НаКлиенте
Процедура СообщитьПоПолю(ИмяПоля, Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = ИмяПоля;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
