	                      |	И НЕ Поступление.ПометкаУдаления
	                      |	И Поступление.БанковскийСчёт = &БанковскийСчёт
	                      |	И НЕ Поступление.ПроведеноБанком");		
	МасБанковскиеСчета = ТЧБанковскиеСчета.НайтиСтроки(Новый Структура("Пометка", Истина));
	ТЧДокументыКВыгрузке.Очистить();
	КоллекцияЭлементов = Метаданные.Обработки.КлиентБанк.ТабличныеЧасти.ТЧДокументыКВыгрузке.Реквизиты;
	Для Каждого МасСтр Из МасБанковскиеСчета Цикл
		Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(МасСтр.ВыгрузкаНачалоПериода));
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(МасСтр.ВыгрузкаКонецПериода));
		Запрос.УстановитьПараметр("БанковскийСчёт", МасСтр.БанковскийСчёт);	
		Выб = Запрос.Выполнить().Выбрать();		
		Пока Выб.Следующий() Цикл
			НС = ТЧДокументыКВыгрузке.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Выб);			
			НС.НомерВФорматеВыгрузки = РаботаСДокументами.СформироватьЦифровойНомер(НС.Номер);
			ПроверитьНаКорректностьИПустоеЗначениеЭкспорта(НС, КоллекцияЭлементов);		
			НС.Выгружать = ПустаяСтрока(НС.ОписаниеОшибок) И НС.Состояние = Перечисления.СостоянияБанковскихДокументов.Подготовлено;		
			Если НС.Готовность = 0 Тогда
				НС.ОписаниеОшибок = "Документ готов к выгрузке.";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ВыгрузитьДокументы(КлючУникальности) Экспорт
	ДатаСегодня = ТекущаяДатаСеанса();
	МасОписаниеФайлов = Новый Массив;
	МасБанковскиеСчета = ТЧБанковскиеСчета.НайтиСтроки(Новый Структура("Пометка", Истина));
	Для Каждого МасСтрСчёт Из МасБанковскиеСчета Цикл
		ПотокВыгрузки = Новый ТекстовыйДокумент();			
		// Формируем заголовок
		ПотокВыгрузки.ДобавитьСтроку("1CClientBankExchange");
		ПотокВыгрузки.ДобавитьСтроку("ВерсияФормата=" + ?(ПустаяСтрока(ВерсияФормата), "1.03", ВерсияФормата));	
		ПотокВыгрузки.ДобавитьСтроку("Кодировка=" + Кодировка);
		ПотокВыгрузки.ДобавитьСтроку("Отправитель=" + Метаданные.Синоним);
		ПотокВыгрузки.ДобавитьСтроку("Получатель=" + Программа);
		ПотокВыгрузки.ДобавитьСтроку("ДатаСоздания=" + Формат(ДатаСегодня, "ДЛФ=Д"));
		ПотокВыгрузки.ДобавитьСтроку("ВремяСоздания=" + Формат(ДатаСегодня, "ДЛФ=В"));
		ПотокВыгрузки.ДобавитьСтроку("ДатаНачала=" + Формат(МасСтрСчёт.ВыгрузкаНачалоПериода, "ДЛФ=Д"));
		ПотокВыгрузки.ДобавитьСтроку("ДатаКонца=" + Формат(МасСтрСчёт.ВыгрузкаКонецПериода, "ДЛФ=Д"));	
		ПотокВыгрузки.ДобавитьСтроку("РасчСчет=" + МасСтрСчёт.НомерСчёта);
		// Выводим отмеченные документы
		МасДокументы = ТЧДокументыКВыгрузке.НайтиСтроки(Новый Структура("БанковскийСчёт, Выгружать", МасСтрСчёт.БанковскийСчёт, Истина));	
		Если МасДокументы.Количество() = 0 Тогда Продолжить КонецЕсли;
		Для Каждого Стр Из МасДокументы Цикл
			Буфер = ПолучитьСекциюДокумент(Стр);
			КоличествоСрокСекции = СтрЧислоСтрок(Буфер);
			Для Сч = 1 По КоличествоСрокСекции Цикл
				ПотокВыгрузки.ДобавитьСтроку(СтрПолучитьСтроку(Буфер, Сч));
			КонецЦикла;		
			Стр.Готовность = -1;
		КонецЦикла;		
		ПотокВыгрузки.ДобавитьСтроку("КонецФайла");	
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");	
		ПотокВыгрузки.Записать(ИмяВременногоФайла, ?(Кодировка = "DOS", "cp866", "windows-1251"));
		ОписаниеФайла = Новый ОписаниеПередаваемогоФайла;
		ОписаниеФайла.Хранение = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), КлючУникальности);
		ОписаниеФайла.Имя = "1c_to_kl_" + МасСтрСчёт.НомерСчёта + ".txt";
       	МасОписаниеФайлов.Добавить(ОписаниеФайла);
	КонецЦикла;	
	Возврат МасОписаниеФайлов;	
КонецФункции

Процедура ЗагрузитьДокументы(МасАдреса) Экспорт
	ТЧДокументыКЗагрузке.Очистить();
	ТЧИнформация.Очистить();
	Для Каждого Адрес Из МасАдреса Цикл		
		Данные = Новый Структура;
		Данные.Вставить("БанковскиеСчета", Новый Массив);
		Данные.Вставить("Документы", Новый Массив);	
		// Получим данные из файла
		ЧтениеДанных = Новый ЧтениеДанных(ПолучитьИзВременногоХранилища(Адрес));
		ЧтениеТекста = Новый ЧтениеТекста(ЧтениеДанных.ИсходныйПоток());
		Стр = ЧтениеТекста.ПрочитатьСтроку();
		Если Стр <> "1CClientBankExchange" Тогда Продолжить КонецЕсли;
		НС = Неопределено;
		Пока Стр <> Неопределено Цикл
			Если ЗначениеЗаполнено(Стр) Тогда 			
				МасДанные = СтрРазделить(Стр, "=", Ложь);
				Если МасДанные[0] = "СекцияРасчСчет" Тогда
					НС = Новый Структура;			
					Данные.БанковскиеСчета.Добавить(НС);
				ИначеЕсли МасДанные[0] = "СекцияДокумент" Тогда
					НС = Новый Структура;
					Данные.Документы.Добавить(НС);	
				ИначеЕсли МасДанные[0] = "КонецРасчСчет" Или МасДанные[0] = "КонецДокумента" Тогда
					НС = Неопределено;
				КонецЕсли;
				Если НС <> Неопределено и МасДанные.Количество() >= 2 Тогда
					ЗначениеТэга = ""; // На случай, если в строке еще встречаются такие же разделители
					Для А = 1 По МасДанные.Количество() - 1 Цикл
						ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(ЗначениеТэга, МасДанные[А], " = ");	
					КонецЦикла;	
					НС.Вставить(МасДанные[0], ЗначениеТэга);
				КонецЕсли;
			КонецЕсли;
			Стр = ЧтениеТекста.ПрочитатьСтроку();
		КонецЦикла;
		ЧтениеТекста.Закрыть();
		ЧтениеДанных.Закрыть();
		// Теги
		ТегПлательщикРасчётныйСчёт = "";
		ТегПолучательРасчётныйСчёт = "";	
		Если Данные.Документы.Количество() > 0 Тогда
			Стр = Данные.Документы[0];
			Если Стр.Свойство("ПлательщикРасчСчет") Тогда
				ТегПлательщикРасчётныйСчёт = "ПлательщикРасчСчет";
			Иначе
				ТегПлательщикРасчётныйСчёт = "ПлательщикСчет";	
			КонецЕсли;	
			Если Стр.Свойство("ПолучательРасчСчет") Тогда
				ТегПолучательРасчётныйСчёт = "ПолучательРасчСчет";
			Иначе
				ТегПолучательРасчётныйСчёт = "ПолучательСчет";	
			КонецЕсли;
		КонецЕсли;
		// Обработаем расчётные счета
		Для Каждого Стр Из Данные.БанковскиеСчета Цикл
			СтрСчёт = ТЧБанковскиеСчета.Найти(Стр.РасчСчет, "НомерСчёта");
			Если СтрСчёт = Неопределено Тогда 
				// Получим БИК банка организации, для поиска счёта
				Если Данные.Документы[0][ТегПлательщикРасчётныйСчёт] = Стр.РасчСчет Тогда
					БИК = Данные.Документы[0].ПлательщикБИК;			
				ИначеЕсли Данные.Документы[0][ТегПолучательРасчётныйСчёт] = Стр.РасчСчет Тогда	
					БИК = Данные.Документы[0].ПолучательБИК;	
				Иначе
					Продолжить; // В файле ошибка, но такого быть не должно	
				КонецЕсли;					
				ДанныеБанковскогоСчёта = Справочники.БанковскиеСчета.ПолучитьПоНомеру(Стр.РасчСчет, БИК, Истина);				
				Если ДанныеБанковскогоСчёта.БанковскийСчёт = Неопределено Тогда 
					Продолжить; // Такого банковского счёта нет в базе, пропускаем, автоматически не создаём
				КонецЕсли;	
				СтрСчёт = ТЧБанковскиеСчета.Добавить(); 
				ЗаполнитьЗначенияСвойств(СтрСчёт, ДанныеБанковскогоСчёта, "Наименование, НомерСчёта, БанковскийСчёт, Банк");
				СтрСчёт.Организация = ДанныеБанковскогоСчёта.Владелец;
			КонецЕсли;
			СтрСчёт.ЗагрузкаНачалоПериода = КонвертироватьДату(Стр.ДатаНачала);
			СтрСчёт.ЗагрузкаКонецПериода = КонвертироватьДату(Стр.ДатаКонца);
			СтрСчёт.Пометка = Истина;
		КонецЦикла;
		// Обработаем документы
		Для Каждого Стр Из Данные.Документы Цикл
			Если Стр.Свойство("ДатаСписано") Тогда
				СтрСчёт = ТЧБанковскиеСчета.Найти(Стр[ТегПлательщикРасчётныйСчёт], "НомерСчёта");
				Если СтрСчёт = Неопределено Тогда
					ДобавитьИнформацию("Не найден расчётный счёт организации - " + Стр[ТегПлательщикРасчётныйСчёт], Стр);
					Продолжить; 
				КонецЕсли;
				НС = ТЧДокументыКЗагрузке.Добавить();
				ЗаполнитьЗначенияСвойств(НС, Стр);
				НС.ТегПлательщикРасчётныйСчёт = ТегПлательщикРасчётныйСчёт;
				НС.ТегПолучательРасчётныйСчёт = ТегПолучательРасчётныйСчёт;
				НС.ДатаСписано = КонвертироватьДату(Стр.ДатаСписано);
				НС.СуммаСписано = Число(Стр.Сумма);
				БанковскийСчётКонтрагента = Справочники.БанковскиеСчета.ПолучитьПоНомеру(Стр[ТегПолучательРасчётныйСчёт], Стр.ПолучательБИК, Истина);
				Если БанковскийСчётКонтрагента.Владелец = Неопределено Тогда 
					БанковскийСчётКонтрагента = Справочники.БанковскиеСчета.ПолучитьПоНомеру(Стр[ТегПолучательРасчётныйСчёт], Стр.ПолучательБИК, Ложь);
				КонецЕсли;
				НС.КонтрагентНаименование = ?(РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Стр,"Получатель1"), Стр.Получатель1, Стр.Получатель);
			ИначеЕсли Стр.Свойство("ДатаПоступило") Тогда	
				СтрСчёт = ТЧБанковскиеСчета.Найти(Стр[ТегПолучательРасчётныйСчёт], "НомерСчёта");
				Если СтрСчёт = Неопределено Тогда
					ДобавитьИнформацию("Не найден расчётный счёт организации - " + Стр[ТегПолучательРасчётныйСчёт], Стр);
					Продолжить; 
				КонецЕсли;
				НС = ТЧДокументыКЗагрузке.Добавить();
				ЗаполнитьЗначенияСвойств(НС, Стр);
				НС.ТегПлательщикРасчётныйСчёт = ТегПлательщикРасчётныйСчёт;
				НС.ТегПолучательРасчётныйСчёт = ТегПолучательРасчётныйСчёт;
				НС.ДатаПоступило = КонвертироватьДату(Стр.ДатаПоступило);
				НС.СуммаПоступило = Число(Стр.Сумма);
				БанковскийСчётКонтрагента = Справочники.БанковскиеСчета.ПолучитьПоНомеру(Стр[ТегПлательщикРасчётныйСчёт], Стр.ПлательщикБИК, Истина);
				Если БанковскийСчётКонтрагента.Владелец = Неопределено Тогда
					БанковскийСчётКонтрагента = Справочники.БанковскиеСчета.ПолучитьПоНомеру(Стр[ТегПлательщикРасчётныйСчёт], Стр.ПлательщикБИК, Ложь);
				КонецЕсли;
				НС.КонтрагентНаименование = ?(РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Стр,"Плательщик1"), Стр.Плательщик1, Стр.Плательщик);
			Иначе
				ДобавитьИнформацию("Не определено, входящий или исходящий документ", Стр);
				Продолжить;
			КонецЕсли;
			НС.Дата = КонвертироватьДату(Стр.Дата);
			Если Стр.Свойство("СрокПлатежа") Тогда
				НС.СрокПлатежа = КонвертироватьДату(Стр.СрокПлатежа);
			КонецЕсли;
			НС.Организация = СтрСчёт.Организация;
			НС.БанковскийСчёт = СтрСчёт.БанковскийСчёт;
			Если ЗначениеЗаполнено(БанковскийСчётКонтрагента.БанковскийСчёт) Тогда
				НС.Контрагент = БанковскийСчётКонтрагента.Владелец;
				НС.БанковскийСчётКонтрагента = БанковскийСчётКонтрагента.БанковскийСчёт;
			КонецЕсли;
			НС.Загружать = Истина;
		КонецЦикла;
	КонецЦикла;
	// Получим документы
	ТЗДокументы = ПолучитьДокументы();
	Для Каждого Стр Из ТЧДокументыКЗагрузке Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Организация", Стр.Организация);
		Отбор.Вставить("БанковскийСчёт", Стр.БанковскийСчёт);
		Отбор.Вставить("Контрагент", Стр.Контрагент);
		Отбор.Вставить("БанковскийСчётКонтрагента", Стр.БанковскийСчётКонтрагента);	
		Отбор.Вставить("Сумма", ?(ЗначениеЗаполнено(Стр.СуммаПоступило), Стр.СуммаПоступило, Стр.СуммаСписано));	
		Отбор.Вставить("Поступление", ЗначениеЗаполнено(Стр.СуммаПоступило));
		Отбор.Вставить("НомерВходящегоДокумента", Стр.Номер);
		Отбор.Вставить("ДатаВходящегоДокумента", Стр.Дата);					
		Мас = ТЗДокументы.НайтиСтроки(Отбор); // Ищем по уже загруженным
		Если Мас.Количество() = 0 Тогда // По загруженным не нашли, ищем по отправленым с нашим номером входящего документа
			Отбор.Удалить("НомерВходящегоДокумента");
			Отбор.Удалить("ДатаВходящегоДокумента");
			Отбор.Вставить("Номер", Стр.Номер);
			Мас = ТЗДокументы.НайтиСтроки(Отбор);
			Если Мас.Количество() = 0 Тогда // Ничего не нашли, наверное поменяли номер платёжного поручения в рабочем кабинете банка, ищем пустые 
				Отбор.Удалить("Номер");
				Отбор.Вставить("НомерВходящегоДокумента", "");
				Отбор.Вставить("ДатаВходящегоДокумента", Дата(1,1,1));
				Мас = ТЗДокументы.НайтиСтроки(Отбор);
				Если Мас.Количество() = 0 Тогда Продолжить КонецЕсли; 
			КонецЕсли;
		КонецЕсли;	
		Стр.Документ = Мас[0].Ссылка;
		Стр.Загружать = Не Стр.Документ.ПроведеноБанком;
	КонецЦикла;	
КонецПроцедуры

Процедура СоздатьДокументы() Экспорт
	Мас = ТЧДокументыКЗагрузке.НайтиСтроки(Новый Структура("Загружать", Истина));
	НачатьТранзакцию();
	Для Каждого Стр Из Мас Цикл
		Если Не ЗначениеЗаполнено(Стр.Контрагент) Тогда 
			БанковскийСчётКонтрагента = Новый Структура("Наименование, НомерСчёта, БанковскийСчёт, Владелец, Банк"); 
			Если ЗначениеЗаполнено(Стр.СуммаСписано) Тогда 
				БанковскийСчётКонтрагента.Банк = Стр.ПолучательБИК;
				БанковскийСчётКонтрагента.НомерСчёта = Стр[Стр.ТегПолучательРасчётныйСчёт];
				БанковскийСчётКонтрагента.Владелец = Новый Структура;
				БанковскийСчётКонтрагента.Владелец.Вставить("ИНН", Стр.ПолучательИНН);
				БанковскийСчётКонтрагента.Владелец.Вставить("КПП", ?(РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Стр,"ПолучательКПП"), Стр.ПолучательКПП, ""));
				БанковскийСчётКонтрагента.Владелец.Вставить("Наименование", ?(РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Стр,"Получатель1"), Стр.Получатель1, Стр.Получатель));
			Иначе
				БанковскийСчётКонтрагента.Банк = Стр.ПлательщикБИК;
				БанковскийСчётКонтрагента.НомерСчёта = Стр[Стр.ТегПлательщикРасчётныйСчёт];
				БанковскийСчётКонтрагента.Владелец = Новый Структура;
				БанковскийСчётКонтрагента.Владелец.Вставить("ИНН", Стр.ПлательщикИНН);
				БанковскийСчётКонтрагента.Владелец.Вставить("КПП", ?(РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Стр,"ПлательщикКПП"), Стр.ПлательщикКПП, ""));
				БанковскийСчётКонтрагента.Владелец.Вставить("Наименование", ?(РаботаСДокументамиКлиентСервер.ЕстьРеквизит(Стр,"Плательщик1"), Стр.Плательщик1, Стр.Плательщик));
			КонецЕсли;
			СоздатьКонтрагентаИБанковскийСчёт(БанковскийСчётКонтрагента);
			Стр.Контрагент = БанковскийСчётКонтрагента.Владелец;
			Стр.БанковскийСчётКонтрагента = БанковскийСчётКонтрагента.БанковскийСчёт;
		КонецЕсли;	
		Если ЗначениеЗаполнено(Стр.Документ) Тогда
			Док = Стр.Документ.ПолучитьОбъект();
		Иначе
			Док = ?(ЗначениеЗаполнено(Стр.СуммаСписано), Документы.СписаниеБезналичныхДенежныхСредств.СоздатьДокумент(), Документы.ПоступлениеБезналичныхДенежныхСредств.СоздатьДокумент()); 	
			Док.Заполнить(Стр);	
		КонецЕсли;
		Док.НомерВходящегоДокумента = Стр.Номер;
		Док.ДатаВходящегоДокумента = Стр.Дата;	
		Док.ПроведеноБанком = Истина;
		Док.ДатаПроведенияБанком = ?(ЗначениеЗаполнено(Стр.ДатаСписано), Стр.ДатаСписано, Стр.ДатаПоступило); 
		Док.Записать(РежимЗаписиДокумента.Проведение);		
		Стр.Документ = Док.Ссылка;
		Стр.Загружать = Ложь;
	КонецЦикла;
	ЗафиксироватьТранзакцию();
КонецПроцедуры	

#КонецОбласти

#Область Дополнительно

Процедура ПроверитьНаКорректностьИПустоеЗначениеЭкспорта(СтрокаДокумента, КоллекцияЭлементов)
	ПеречислениеНалога = Ложь;
	НепрямыеРасчетыУПлательщика = Ложь;
	НепрямыеРасчетыУПолучателя = Ложь;	
	Если СтрокаДокумента.ВидДокумента = "ПлатежноеПоручение" Тогда
		ПеречислениеНалога = ЗначениеЗаполнено(СтрокаДокумента.СтатусСоставителя);
		НепрямыеРасчетыУПлательщика = ЗначениеЗаполнено(СтрокаДокумента.ОрганизацияБанкДляРасчетов);
		НепрямыеРасчетыУПолучателя = ЗначениеЗаполнено(СтрокаДокумента.КонтрагентБанкДляРасчетов);
		СтрокаДокумента.ТипДокумента = ?(ПеречислениеНалога, 1, 0) * 4 + ?(НепрямыеРасчетыУПолучателя, 1, 0) * 2 + ?(НепрямыеРасчетыУПлательщика, 1, 0) + 1;
		Плательщик = "Организация";
		Получатель = "Контрагент";
		ПлательщикИНН = "ИННПлательщика";
		ПолучательИНН = "ИННПолучателя";
	Иначе
		СтрокаДокумента.ТипДокумента = 0;
		Плательщик = "Контрагент";
		Получатель = "Организация";
		ПлательщикИНН = "КонтрагентИНН";
		ПолучательИНН = "ОрганизацияИНН";
	КонецЕсли;	
	// РеквизитыПлДокЭкс_Основные
	Экспорт_НеПустые = Новый Структура("Номер, Дата, СуммаДокумента");
	Экспорт_НеПустые.Вставить(ПлательщикИНН);
	Экспорт_НеПустые.Вставить(Плательщик);
	Экспорт_НеПустые.Вставить(Плательщик + "Счет");	
	Если НепрямыеРасчетыУПлательщика Тогда
		// РеквизитыПлДокЭкс_ПлательщикНПР
		Экспорт_НеПустые.Вставить(Плательщик + "РасчСчет");
		Экспорт_НеПустые.Вставить(Плательщик + "БанкДляРасчетов");
		Экспорт_НеПустые.Вставить(Плательщик + "ГородБанка");
		Экспорт_НеПустые.Вставить(Плательщик + "БИКРЦБанка");
	КонецЕсли;	
	// РеквизитыПлДокЭкс_Получатель
	Экспорт_НеПустые.Вставить(ПолучательИНН);
	Экспорт_НеПустые.Вставить(Получатель);
	Экспорт_НеПустые.Вставить(Получатель + "Счет");	
	Если НепрямыеРасчетыУПолучателя Тогда
		// РеквизитыПлДокЭкс_ПолучательНПР
		Экспорт_НеПустые.Вставить(Получатель + "РасчСчет");
		Экспорт_НеПустые.Вставить(Получатель + "БанкДляРасчетов");
		Экспорт_НеПустые.Вставить(Получатель + "ГородБанка");
		Экспорт_НеПустые.Вставить(Получатель + "БИКРЦБанка");
	КонецЕсли;	
	Для Каждого Свойство Из Экспорт_НеПустые Цикл
		Если ЗначениеЗаполнено(СтрокаДокумента[Свойство.Ключ]) Тогда Продолжить КонецЕсли;
		ДобавитьЗамечание(СтрокаДокумента, 4, "Не заполнено поле " + КоллекцияЭлементов.Найти(Свойство.Ключ).Синоним);
	КонецЦикла;	
КонецПроцедуры

Процедура ДобавитьЗамечание(СтрокаДокумента, НоваяГотовность, ТекстЗамечания) Экспорт
	Если СтрокаДокумента.Готовность < НоваяГотовность Тогда
		СтрокаДокумента.Готовность = НоваяГотовность;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(СтрокаДокумента.ОписаниеОшибок, ТекстЗамечания);
	СтрокаДокумента.ЕстьОшибка = НоваяГотовность <> 0;	
КонецПроцедуры

Функция ПолучитьСекциюДокумент(СтруктураДокумента)
	Буфер = "";
	Секция = СформироватьСтруктуруЭкспорта(ВерсияФормата);
	#Область Заполнение_секции
	Если СтруктураДокумента.ВидДокумента = "ПлатежноеТребование" Тогда
		Плательщик = "Контрагент";
		Получатель = "Организация";
	Иначе
		Плательщик = "Организация";
		Получатель = "Контрагент";
	КонецЕсли;	
	Секция.Номер = СтруктураДокумента.НомерВФорматеВыгрузки;
	Секция.Дата = Формат(СтруктураДокумента.Дата, "ДЛФ=Д");
	Секция.Сумма = Формат(СтруктураДокумента.СуммаДокумента, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧРГ=' '; ЧГ=0");
	Секция.ПлательщикСчет = СтруктураДокумента[Плательщик + "НомерСчета"];
	Секция.ПолучательСчет = СтруктураДокумента[Получатель + "НомерСчета"];
	Секция.ВидПлатежа = СтруктураДокумента.ВидПлатежа;
	
	НепрямыеРасчетыУПлательщика = ЗначениеЗаполнено(СтруктураДокумента[Плательщик + "БанкДляРасчетов"]);
	НепрямыеРасчетыУПолучателя = ЗначениеЗаполнено(СтруктураДокумента[Получатель + "БанкДляРасчетов"]);
	
	//Секция.ВидОплаты = Перечисления.ТипыПлатежныхДокументов.ПолучитьВидОплаты(СтруктураДокумента.ВидДокумента);	
	
	//Плательщик
	Секция.Плательщик = "ИНН " + СтруктураДокумента.ИННПлательщика + " " + СтруктураДокумента.ТекстПлательщика;	
	Секция.ПлательщикИНН = СтруктураДокумента.ИННПлательщика;
	Секция.Плательщик1 = СтруктураДокумента[Плательщик + "Кратко"];
	
	//ПлательщикРасчСчет, ПлательщикБанк1, ПлательщикБанк2, ПлательщикБИК, ПлательщикКорсчет,Плательщик2, Плательщик3, Плательщик4
	Если НепрямыеРасчетыУПлательщика Тогда
		Секция.Плательщик2 = СтруктураДокумента[Плательщик + "НомерСчета"];
		Секция.Плательщик3 = СтруктураДокумента[Плательщик + "Банк"];
		Секция.Плательщик4 = СтруктураДокумента[Плательщик + "ГородБанка"];
		Секция.Плательщик = Секция.Плательщик + " р/с " + Секция.Плательщик2 + " в " + Секция.Плательщик3 + " " + Секция.Плательщик4;
		Секция.ПлательщикРасчСчет = СтруктураДокумента[Плательщик + "РасчСчет"];
		Секция.ПлательщикБанк1 = СтруктураДокумента[Плательщик + "БанкДляРасчетов"];
		Секция.ПлательщикБанк2 = СтруктураДокумента[Плательщик + "ГородРЦБанка"];
		Секция.ПлательщикБИК = СтруктураДокумента[Плательщик + "БИКРЦБанка"];
		Секция.ПлательщикКорсчет = СтруктураДокумента[Плательщик + "КоррСчетРЦБанка"];
	Иначе
		Секция.ПлательщикРасчСчет = СтруктураДокумента[Плательщик + "НомерСчета"];
		Секция.ПлательщикБанк1 = СтруктураДокумента[Плательщик + "Банк"];
		Секция.ПлательщикБанк2 = СтруктураДокумента[Плательщик + "ГородБанка"];
		Секция.ПлательщикБИК = СтруктураДокумента[Плательщик + "БИКБанка"];
		Секция.ПлательщикКорсчет = СтруктураДокумента[Плательщик + "РасчСчет"];
	КонецЕсли;	
	
	//Получатель
	Секция.Получатель = "ИНН " + СтруктураДокумента.ИННПолучателя + " " + СтруктураДокумента.ТекстПолучателя;	
	Секция.ПолучательИНН = СтруктураДокумента.ИННПолучателя;
	Секция.Получатель1 = СтруктураДокумента.ТекстПолучателя;
	
	//ПолучательРасчСчет, ПолучательБанк1, ПолучательБанк2, ПолучательБИК, ПолучательКорсчет, Получатель2, Получатель3, Получатель4
	Если НепрямыеРасчетыУПолучателя Тогда
		Секция.Получатель2 = СтруктураДокумента[Получатель + "НомерСчета"];
		Секция.Получатель3 = СтруктураДокумента[Получатель + "Банк"];
		Секция.Получатель4 = СтруктураДокумента[Получатель + "ГородБанка"];
		Секция.Получатель = Секция.Получатель + " р/с " + Секция.Получатель2 + " в " + Секция.Получатель3 + " " + Секция.Получатель4;
		Секция.ПолучательРасчСчет = СтруктураДокумента[Получатель + "РасчСчет"];
		Секция.ПолучательБанк1 = СтруктураДокумента[Получатель + "БанкДляРасчетов"];
		Секция.ПолучательБанк2 = СтруктураДокумента[Получатель + "ГородРЦБанка"];
		Секция.ПолучательБИК = СтруктураДокумента[Получатель + "БИКРЦБанка"];
		Секция.ПолучательКорсчет = СтруктураДокумента[Получатель + "КоррСчетРЦБанка"];
	Иначе
		Секция.ПолучательРасчСчет = СтруктураДокумента[Получатель + "НомерСчета"];
		Секция.ПолучательБанк1 = СтруктураДокумента[Получатель + "Банк"];
		Секция.ПолучательБанк2 = СтруктураДокумента[Получатель + "ГородБанка"];
		Секция.ПолучательБИК = СтруктураДокумента[Получатель + "БИКБанка"];
		Секция.ПолучательКорсчет = СтруктураДокумента[Получатель + "РасчСчет"];
	КонецЕсли;	
	
	// КПП
	Секция.ПлательщикКПП = СтруктураДокумента.КПППлательщика;
	Секция.ПолучательКПП = СтруктураДокумента.КПППолучателя;
	
	КодПредусмотренСтандартамиОбмена = Секция.Свойство("Код");
	Если КодПредусмотренСтандартамиОбмена Тогда
		Если Не ПустаяСтрока(СтруктураДокумента.ИдентификаторПлатежа) Тогда
			Секция.Код = СтруктураДокумента.ИдентификаторПлатежа;
		КонецЕсли;
	КонецЕсли;	
	//СтатусСоставителя, ПлательщикКПП ПолучательКПП ПоказательКБК ОКАТО/ОКТМО ПоказательОснования ПоказательПериода ПоказательНомера ПоказательДаты ПоказательТипа Код
	Если СтруктураДокумента.ПеречислениеВБюджет Тогда
		Секция.СтатусСоставителя = СтруктураДокумента.СтатусСоставителя;		
		
		Если Не ПустаяСтрока(СтруктураДокумента.КодБК) Тогда
			Секция.ПоказательКБК = СтруктураДокумента.КодБК;
		КонецЕсли;
		
		Если Не ПустаяСтрока(СтруктураДокумента.КодОКАТО) Тогда
			Секция.ОКАТО = СтруктураДокумента.КодОКАТО;
		КонецЕсли;
		
		Если Не ПустаяСтрока(СтруктураДокумента.ПоказательОснования) Тогда
			Секция.ПоказательОснования = СтруктураДокумента.ПоказательОснования;
		КонецЕсли;
		
		Если Не ПустаяСтрока(СтруктураДокумента.ПоказательПериода) И СтруктураДокумента.ПоказательПериода <> "  .  .    " Тогда
			Секция.ПоказательПериода = СтруктураДокумента.ПоказательПериода;
		КонецЕсли;
		
		Если Не ПустаяСтрока(СтруктураДокумента.ПоказательНомера) Тогда
			Секция.ПоказательНомера = СтруктураДокумента.ПоказательНомера;
		КонецЕсли;
		
		Если Не ПустаяСтрока(СтруктураДокумента.ПоказательДаты) Тогда
			Секция.ПоказательДаты = СтруктураДокумента.ПоказательДаты;
		КонецЕсли;
		
		ПоказательТипаПредусмотренСтандартамиОбмена = Секция.Свойство("ПоказательТипа");
		Если ПоказательТипаПредусмотренСтандартамиОбмена Тогда
			Секция.ПоказательТипа = "0";		
		КонецЕсли;
	КонецЕсли;
	
	//СрокАкцепта, ДатаОтсылкиДок, УсловиеОплаты1
	Если СтруктураДокумента.ВидДокумента = "Платежное требование" Тогда
		Секция.СрокАкцепта = СтруктураДокумента.СрокАкцепта;
		Секция.ДатаОтсылкиДок = СтруктураДокумента.ДатаОтсылкиДок;
		Секция.УсловиеОплаты1 = СтруктураДокумента.УсловиеОплаты1;
	КонецЕсли;
	
	//Очередность
	Секция.Очередность = "" + СтруктураДокумента.ОчередностьПлатежа;
	
	//НазначениеПлатежа, НазначениеПлатежа1 НазначениеПлатежа2 НазначениеПлатежа3 НазначениеПлатежа4 НазначениеПлатежа5 НазначениеПлатежа6
	Секция.НазначениеПлатежа = ОбщегоНазначенияКлиентСервер.УдалитьНеиспользуемыеСимволы(СтруктураДокумента.НазначениеПлатежа);
	КоличествоСтрокНП = СтрЧислоСтрок(СтруктураДокумента.НазначениеПлатежа);
	
	Если КоличествоСтрокНП > 6 Тогда
		КоличествоСтрокНП = 6;
	КонецЕсли;
	
	Для Сч = 1 По КоличествоСтрокНП Цикл
		Секция["НазначениеПлатежа" + Сч] = СтрПолучитьСтроку(СтруктураДокумента.НазначениеПлатежа, Сч);
	КонецЦикла;
	
	Для Сч = (КоличествоСтрокНП + 1) По 6 Цикл
		Секция["НазначениеПлатежа" + Сч] = "";
	КонецЦикла;
	#КонецОбласти
	ДобавитьВСтроку(Буфер, "СекцияДокумент=" + СтруктураДокумента.ВидДокумента);	
	Для Каждого Реквизит Из Секция Цикл		
		Значение = ПривестиЗначение(Реквизит.Значение);		
		Если ПустаяСтрока(Значение) Тогда Продолжить КонецЕсли;
		Если Реквизит.Ключ = "ПоказательТипа" Тогда
			ДобавитьВСтроку(Буфер, Реквизит.Ключ + "="); // Секция должна выгружаться пустой, потому что в банках может остаться ПО, которое ожидает такой ключ.
		КонецЕсли;
	КонецЦикла;	
	ДобавитьВСтроку(Буфер, "КонецДокумента");	
	Возврат Буфер;	
КонецФункции

