Процедура ДобавитьВСтроку(Буфер, НоваяСтрока, Разделитель = "")
	Если ПустаяСтрока(Буфер) Тогда
		Буфер = НоваяСтрока;
	Иначе
		ЕстьФразаОшибкаВФайле = СтрНайти(Буфер, "Ошибка в файле. ") > 0;
		Если ЕстьФразаОшибкаВФайле Тогда
			НоваяСтрока = СтрЗаменить(НоваяСтрока, "Ошибка в файле. ", "");
		КонецЕсли;
		Буфер = Буфер + ?(ПустаяСтрока(Разделитель), Символы.ПС, Разделитель) + НоваяСтрока;
	КонецЕсли;	
КонецПроцедуры

Функция ПривестиЗначение(Значение)
	Если ТипЗнч(Значение) = Тип("Строка") Тогда		
		Возврат СокрЛП(Значение);		
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда		
		Возврат Формат(Значение, "ЧРД=.; ЧРГ=' '; ЧГ=0");		
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда		
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");		
	Иначе		
		Возврат "";		
	КонецЕсли;	
КонецФункции

Функция КонвертироватьДату(ДатаФайл)
	Возврат Дата(ДатаФайл + " 00:00:00");	
КонецФункции	

Функция ПолучитьДокументы()
	МасДатыВходящих = ТЧДокументыКЗагрузке.ВыгрузитьКолонку("Дата"); // Чтоб найти уже обработанные документы
	МасДатыВходящих.Добавить(Дата(1,1,1)); // Чтоб найти платёжные поручения для подтверждения, в них дата пустая		
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПоступлениеБезналичныхДенежныхСредств.Ссылка КАК Ссылка,
	                      |	ПоступлениеБезналичныхДенежныхСредств.Номер КАК Номер,
	                      |	ПоступлениеБезналичныхДенежныхСредств.Организация КАК Организация,
	                      |	ПоступлениеБезналичныхДенежныхСредств.БанковскийСчёт КАК БанковскийСчёт,
	                      |	ПоступлениеБезналичныхДенежныхСредств.Контрагент КАК Контрагент,
	                      |	ПоступлениеБезналичныхДенежныхСредств.БанковскийСчётКонтрагента КАК БанковскийСчётКонтрагента,
	                      |	ПоступлениеБезналичныхДенежныхСредств.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	                      |	ПоступлениеБезналичныхДенежныхСредств.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	                      |	ИСТИНА КАК Поступление,
	                      |	ПоступлениеБезналичныхДенежныхСредств.Сумма КАК Сумма
	                      |ИЗ
	                      |	Документ.ПоступлениеБезналичныхДенежныхСредств КАК ПоступлениеБезналичныхДенежныхСредств
	                      |ГДЕ
	                      |	ПоступлениеБезналичныхДенежныхСредств.Организация В(&Организация)
	                      |	И ПоступлениеБезналичныхДенежныхСредств.БанковскийСчёт В(&БанковскийСчёт)
	                      |	И ПоступлениеБезналичныхДенежныхСредств.ДатаВходящегоДокумента В(&МасДатыВходящих)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	СписаниеБезналичныхДенежныхСредств.Ссылка,
	                      |	СписаниеБезналичныхДенежныхСредств.Номер,
	                      |	СписаниеБезналичныхДенежныхСредств.Организация,
	                      |	СписаниеБезналичныхДенежныхСредств.БанковскийСчёт,
	                      |	СписаниеБезналичныхДенежныхСредств.Контрагент,
	                      |	СписаниеБезналичныхДенежныхСредств.БанковскийСчётКонтрагента,
	                      |	СписаниеБезналичныхДенежныхСредств.НомерВходящегоДокумента,
	                      |	СписаниеБезналичныхДенежныхСредств.ДатаВходящегоДокумента,
	                      |	ЛОЖЬ,
	                      |	СписаниеБезналичныхДенежныхСредств.Сумма
	                      |ИЗ
	                      |	Документ.СписаниеБезналичныхДенежныхСредств КАК СписаниеБезналичныхДенежныхСредств
	                      |ГДЕ
	                      |	СписаниеБезналичныхДенежныхСредств.Организация В(&Организация)
	                      |	И СписаниеБезналичныхДенежныхСредств.БанковскийСчёт В(&БанковскийСчёт)
	                      |	И СписаниеБезналичныхДенежныхСредств.ДатаВходящегоДокумента В(&МасДатыВходящих)");
	Запрос.УстановитьПараметр("Организация", ТЧДокументыКЗагрузке.ВыгрузитьКолонку("Организация"));
	Запрос.УстановитьПараметр("БанковскийСчёт", ТЧДокументыКЗагрузке.ВыгрузитьКолонку("БанковскийСчёт"));
	Запрос.УстановитьПараметр("МасДатыВходящих", МасДатыВходящих);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для Каждого Стр Из ТЗ Цикл
		Стр.Номер = РаботаСДокументами.СформироватьЦифровойНомер(Стр.Номер);	
	КонецЦикла;	
	Возврат ТЗ;
КонецФункции

Процедура СоздатьКонтрагентаИБанковскийСчёт(БанковскийСчётКонтрагента)
	// Получим контрагента
	Контрагент = РегистрыСведений.РеквизитыКонтрагентов.ПолучитьКонтрагентаПоИНН(БанковскийСчётКонтрагента.Владелец.NIF);
	СозданНовыйКонтрагент = Ложь;
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
		Контрагент.Записать();
		Результат = РегистрыСведений.РеквизитыКонтрагентов.ЗаполнитьРеквизитыПоИНН(Контрагент.Ссылка, БанковскийСчётКонтрагента.Владелец.NIF);
		Если Результат.Установлены Тогда
			Контрагент.Наименование = Результат.Наименование;
			Контрагент.НаименованиеПолное = Результат.НаименованиеПолное;
			Контрагент.NIF = Результат.NIF;	
			Контрагент.RC = Результат.RC;
			Контрагент.ВидКонтрагента = Результат.ВидКонтрагента;
		Иначе
			Контрагент.Наименование = БанковскийСчётКонтрагента.Владелец.Наименование;
			Контрагент.НаименованиеПолное = Контрагент.Наименование;
			Контрагент.NIF = БанковскийСчётКонтрагента.Владелец.NIF;	
			Контрагент.RC = БанковскийСчётКонтрагента.Владелец.RC;
			РеквизитыКонтрагента = Новый Структура("NIF, RC", Контрагент.NIF, Контрагент.RC);
			РегистрыСведений.РеквизитыКонтрагентов.УстановитьРеквизиты(Контрагент.Ссылка, РеквизитыКонтрагента);
		КонецЕсли;
		Контрагент.Записать();
		ДобавитьИнформацию("Добавлен контрагент - " + Контрагент.Наименование,, Контрагент.Ссылка);
		СозданНовыйКонтрагент = Истина;
	КонецЕсли;
	БанковскийСчётКонтрагента.Владелец = Контрагент.Ссылка; 
	// Получим банковский счёт
	Если СозданНовыйКонтрагент Тогда
		СоздатьБанковскийСчёт(БанковскийСчётКонтрагента);		
	Иначе
		Результат = Справочники.БанковскиеСчета.ПолучитьПоНомеруДляВладельца(БанковскийСчётКонтрагента.НомерСчёта, БанковскийСчётКонтрагента.Владелец);
		Если ЗначениеЗаполнено(Результат.БанковскийСчёт) Тогда
			БанковскийСчёт = Результат.БанковскийСчёт.ПолучитьОбъект();
			БанковскийСчёт.Банк = Справочники.Банки.ПолучитьПоБИК(БанковскийСчётКонтрагента.Банк,, Истина);
			БанковскийСчёт.Записать();
			БанковскийСчётКонтрагента.БанковскийСчёт = БанковскийСчёт.Ссылка;
			БанковскийСчётКонтрагента.Наименование = БанковскийСчёт.Наименование;
			БанковскийСчётКонтрагента.Банк = БанковскийСчёт.Банк;
		Иначе
			СоздатьБанковскийСчёт(БанковскийСчётКонтрагента);	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура СоздатьБанковскийСчёт(БанковскийСчётКонтрагента)
	БанковскийСчёт = Справочники.БанковскиеСчета.СоздатьЭлемент();
	БанковскийСчёт.Владелец = БанковскийСчётКонтрагента.Владелец;
	БанковскийСчёт.НомерСчёта = БанковскийСчётКонтрагента.НомерСчёта;
	Если Тип("СправочникСсылка.Банки") = ТипЗнч(БанковскийСчётКонтрагента.Банк) Тогда
		БанковскийСчёт.Банк = БанковскийСчётКонтрагента.Банк;
	иначе	
		БанковскийСчёт.Банк = Справочники.Банки.ПолучитьПоБИК(БанковскийСчётКонтрагента.Банк,, Истина);
	КонецЕсли;
	БанковскийСчёт.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	БанковскийСчёт.ТипСчёта = Перечисления.ТипыБанковскихСчетов.Расчетный;	
	БанковскийСчёт.Наименование = СокрЛП(БанковскийСчёт.Банк) + " (" + СокрЛП(БанковскийСчёт.ТипСчёта) + ")";
	БанковскийСчёт.Записать();
	БанковскийСчётКонтрагента.БанковскийСчёт = БанковскийСчёт.Ссылка;
	БанковскийСчётКонтрагента.Наименование = БанковскийСчёт.Наименование;
	БанковскийСчётКонтрагента.Банк = БанковскийСчёт.Банк;
	ДобавитьИнформацию("Добавлен банковский счёт для - " + СокрЛП(БанковскийСчётКонтрагента.Владелец),, БанковскийСчёт.Ссылка);
КонецПроцедуры

Процедура ДобавитьИнформацию(Описание, Знач Структура = Неопределено, Данные = Неопределено)
	Если Структура = Неопределено Тогда
		Структура = Новый Структура	
	КонецЕсли;	
	НС = ТЧИнформация.Добавить();
	НС.Описание = Описание;
	Если Структура.Свойство("Номер") Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(НС.Описание, СокрЛП(Структура.Номер), Символы.ПС + "№ п/п ");
		Если Структура.Свойство("Дата") Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(НС.Описание, СокрЛП(Структура.Дата), " от ");	
		КонецЕсли;
		Если Структура.Свойство("Сумма") Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(НС.Описание, СокрЛП(Структура.Сумма), ", Сумма ");	
		КонецЕсли;
	КонецЕсли;
	НС.Данные = Данные;
КонецПроцедуры	

#КонецОбласти 

