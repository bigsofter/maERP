// P9. Частичная отгрузка: выпущено всё, отгружено 4 из 6 - «Ожидает отгрузки»; автовыпуск не нужен.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Структура - кейс
//
Функция ДемоЧастичнаяОтгрузка(Контекст)

	Н = Контекст.Номенклатура;
	Клиент = Контекст.Участники.Majorelle;
	// BSLLS:MagicNumber-off - Chaise 6, отгрузка 4.
	Заказ = ДемоЗаказНаПроизводство(Контекст, Клиент, Н.Chaise, 6, Истина);
	ЗаказПоставщику = ДемоЗаказПоставщикуПоПотребности(Контекст, Заказ, Контекст.Участники.Bois);
	ДемоПоступлениеПоЗаказуПоставщику(Контекст, ЗаказПоставщику, 1);
	ДемоВыпуск(Контекст, Заказ, Н.Chaise, 6);
	Реализация = ДемоРеализацияПоЗаказу(Контекст, Клиент, Заказ, 4);
	// BSLLS:MagicNumber-on
	Кейс = НовыйКейс(Заказ);
	Кейс.Вставить("Реализация", Реализация);
	Возврат Кейс;

КонецФункции

// P10. Производство на склад: ручной мультивыпуск без заказа.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Структура - кейс
//
Функция ДемоПроизводствоНаСклад(Контекст)

	Н = Контекст.Номенклатура;
	Выпуск = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	// BSLLS:MagicNumber-off - Table 2, Chaise 4.
	Обработки.ТестыДокументов.ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Н.Table, 2, 0);
	Обработки.ТестыДокументов.ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Н.Chaise, 4, 0);
	// BSLLS:MagicNumber-on
	ЗаполнитьЗначенияСвойств(Выпуск, Выпуск.ТЧГотоваяПродукция[0],
		"Номенклатура, Характеристика, Серия, Упаковка, КоличествоУпаковок, Количество");
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Истина);
	ЗаписатьДокументКейса(Контекст, Выпуск, Истина);
	Кейс = НовыйКейс();
	Кейс.Вставить("Выпуск", Выпуск.Ссылка);
	Возврат Кейс;

КонецФункции

// P11. Новая версия техкарты Table на завтра. Строго последний шаг набора: будущая версия запрещает регистрировать
// сегодняшнюю карту проведением заказа. Поверх уже существующей версии на завтра (любой) или при более поздней версии
// карта не пишется - ЗаписатьТехкарту перезаписала бы документ дня.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Структура, Строка - кейс; строка - причина пропуска
//
Функция ДемоНоваяВерсияТехкарты(Контекст)

	Н = Контекст.Номенклатура;
	// BSLLS:MagicNumber-off - секунд в сутках.
	Завтра = НачалоДня(Контекст.Дата) + 86400;
	// BSLLS:MagicNumber-on
	ТехнологическиеКарты.ЗаблокироватьКартыПродукции(Н.Table);
	Проверка = ТехнологическиеКарты.ДатаРедактированияТехкарты(Н.Table, Завтра);
	Если ЗначениеЗаполнено(Проверка.Документ) Тогда
		Возврат НСтр("ru = 'на завтра у карты уже есть версия'; fr = 'la gamme a déjà une version pour demain';
			|en = 'the routing already has a version for tomorrow'; es = 'la ruta ya tiene una versión para mañana'");
	КонецЕсли;
	Если Не Проверка.Допустима Тогда
		Возврат НСтр("ru = 'у карты есть более поздняя версия'; fr = 'la gamme a une version plus récente';
			|en = 'the routing has a later version'; es = 'la ruta tiene una versión posterior'");
	КонецЕсли;
	// BSLLS:MagicNumber-off - Planche 3 вместо 2, с завтрашнего дня.
	Версия = ТехнологическиеКарты.ЗаписатьТехкарту(Н.Table, СоставДемо(Контекст, Н.Planche, 3, Н.Pied, 4, Н.Vernis, 0.1),
		Завтра);
	// BSLLS:MagicNumber-on
	// Документ версии создан только что, в этой же транзакции: ключ ставится в него и он перепроводится.
	ВерсияОбъект = Версия.ПолучитьОбъект();
	ВерсияОбъект.Комментарий = СледующийКлюч(Контекст);
	ВерсияОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Кейс = НовыйКейс();
	Кейс.Вставить("Техкарта", Версия);
	Кейс.Вставить("Продукция", Н.Table);
	Возврат Кейс;

КонецФункции

#КонецОбласти

