	Позиция = ДемоНоменклатура(Контекст, "Tissu lin", Типы.Сырье, Способы.Закупка);
	Н.Вставить("Tissu", Позиция);
	Позиция = ДемоНоменклатура(Контекст, "Mousse assise", Типы.Сырье, Способы.Закупка);
	Н.Вставить("Mousse", Позиция);
	Позиция = ДемоНоменклатура(Контекст, "Table bistro", Типы.Продукция, Способы.Производство);
	Н.Вставить("Table", Позиция);
	Позиция = ДемоНоменклатура(Контекст, "Chaise bistro", Типы.Продукция, Способы.Производство);
	Н.Вставить("Chaise", Позиция);
	Позиция = ДемоНоменклатура(Контекст, "Banquette sur mesure", Типы.Продукция, Способы.Производство);
	Н.Вставить("Banquette", Позиция);
	Позиция = ДемоНоменклатура(Контекст, "Coussin lin", Типы.Полуфабрикат, Способы.Производство);
	Н.Вставить("Coussin", Позиция);
	Позиция = ДемоНоменклатура(Контекст, "Lampe suspendue", Типы.Товар, Способы.Закупка);
	Н.Вставить("Lampe", Позиция);

	ЦеныЗакупки.Вставить(Н.Planche, 12);
	ЦеныЗакупки.Вставить(Н.Pied, 4);
	ЦеныЗакупки.Вставить(Н.Vernis, 30);
	ЦеныЗакупки.Вставить(Н.Tissu, 8);
	ЦеныЗакупки.Вставить(Н.Mousse, 6);
	ЦеныЗакупки.Вставить(Н.Lampe, 350);
