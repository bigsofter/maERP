// Проведённый возврат поставщику первой строки поступления на заданное количество.
//
// Параметры:
//  Контекст    - Структура - см. ЗаполнитьДемоНабор
//  Участник    - Структура - см. ДемоУчастник
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - основание
//  Количество  - Число - количество возврата
//
Процедура ДемоВозвратПоставщику(Контекст, Участник, Поступление, Количество)

	ВыбратьУчастника(Контекст, Участник);
	ДокВозврат = Документы.ВозвратПоставщику.СоздатьДокумент();
	ДокВозврат.Заполнить(Поступление);
	ДокВозврат.Дата = Обработки.ТестыДокументов.СледующаяДата(Контекст);
	ДокВозврат.Комментарий = Контекст.Пометка;
	ДокВозврат.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровПоставщику;
	Пока ДокВозврат.ТЧТовары.Количество() > 1 Цикл
		ДокВозврат.ТЧТовары.Удалить(ДокВозврат.ТЧТовары.Количество() - 1);
	КонецЦикла;
	ДокВозврат.ТЧСерии.Очистить();
	Обработки.ТестыДокументов.УстановитьКоличествоСтроки(ДокВозврат.ТЧТовары[0], Количество);
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(ДокВозврат.ТЧТовары[0], ДокВозврат.ЦенаВключаетНДС);
	Обработки.ТестыДокументов.Провести(ДокВозврат);

КонецПроцедуры

