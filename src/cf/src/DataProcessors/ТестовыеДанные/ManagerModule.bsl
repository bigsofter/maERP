Процедура ДемоДоговоры(Контекст, Кейсы)

	Клиент = Контекст.Участники.Majorelle.Ссылка;
	Статусы = Перечисления.СтатусыДоговоровКонтрагентов;
	Вид = Перечисления.ВидыДоговоров.СПокупателем;
	НеСогласован = ДемоДоговор(Контекст, Клиент, Вид, Статусы.НеСогласован, "Contrat cadre 2027", Ложь);
	Закрыт = ДемоДоговор(Контекст, Клиент, Вид, Статусы.Закрыт, "Contrat 2025", Ложь);
