// S1-S7. Заказы-продажи во всех статусах, которые пишет механизм; «Доставлен» и «Получен от субподрядчика» штатно не
// пишутся.
//
// Параметры:
//  Контекст - Структура - см. ЗаполнитьДемоНабор
//  Кейсы    - Соответствие - см. ЗаполнитьДемоНабор
//
Процедура ДемоЗаказыПродажи(Контекст, Кейсы)

	Н = Контекст.Номенклатура;
	У = Контекст.Участники;
	Продажа = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;

	Новый1 = ДемоЗаказКлиента(Контекст, У.Riad, Продажа, Н.Lampe, 1);
	Обработки.ТестыДокументов.Записать(Новый1);
	НовыйКейс(Кейсы, "S1", "Заказ-продажа - статус «Новый»", Новый1.Ссылка);

	// BSLLS:MagicNumber-off - количества заказов-продаж (план, §4).
	ВРаботе = ДемоЗаказКлиента(Контекст, У.Atlas, Продажа, Н.Lampe, 2);
	ВРаботе.МенеджерПодтвердилПроверилОстаток = Истина;
	Обработки.ТестыДокументов.Записать(ВРаботе);
	НовыйКейс(Кейсы, "S2", "Заказ-продажа - статус «В работе»", ВРаботе.Ссылка);

	Собран = ДемоЗаказКлиента(Контекст, У.Majorelle, Продажа, Н.Lampe, 1);
	Обработки.ТестыДокументов.Записать(Собран);
	Реализация = ДемоРеализацияПоЗаказу(Контекст, У.Majorelle, Собран.Ссылка, Неопределено);
	Кейс = НовыйКейс(Кейсы, "S3", "Заказ-продажа - статус «Собран»", Собран.Ссылка);
	Кейс.Вставить("Реализация", Реализация);

	ВПроизводстве = ДемоЗаказКлиента(Контекст, У.Atlas, Продажа, Н.Table, 1);
	Обработки.ТестыДокументов.Записать(ВПроизводстве);
	ДемоВыпуск(Контекст, ВПроизводстве.Ссылка, Н.Table, 1);
	НовыйКейс(Кейсы, "S4", "Заказ-продажа - статус «В производстве»", ВПроизводстве.Ссылка);

	// «Отгружен» пересчитывает запись выпуска по последнему проведённому связанному документу - реализации.
	Отгружен = ДемоЗаказКлиента(Контекст, У.Riad, Продажа, Н.Chaise, 2);
	Обработки.ТестыДокументов.Записать(Отгружен);
	Выпуск = ДемоВыпуск(Контекст, Отгружен.Ссылка, Н.Chaise, 2);
	ДемоРеализацияПоЗаказу(Контекст, У.Riad, Отгружен.Ссылка, Неопределено);
	ВыпускОбъект = Выпуск.ПолучитьОбъект();
	Обработки.ТестыДокументов.Провести(ВыпускОбъект);
	НовыйКейс(Кейсы, "S5", "Заказ-продажа - статус «Отгружен»", Отгружен.Ссылка);

	Передан = ДемоЗаказКлиента(Контекст, У.Majorelle, Продажа, Н.Coussin, 3);
	Обработки.ТестыДокументов.Записать(Передан);
	ДемоПередачаВПереработку(Контекст, Передан.Ссылка, 3);
	НовыйКейс(Кейсы, "S6", "Заказ-продажа - статус «Передан субподрядчику»", Передан.Ссылка);

	Получен = ДемоЗаказКлиента(Контекст, У.Atlas, Продажа, Н.Coussin, 2);
	Обработки.ТестыДокументов.Записать(Получен);
	Передача = ДемоПередачаВПереработку(Контекст, Получен.Ссылка, 2);
	ДемоПоступлениеИзПереработки(Контекст, Передача, 40);
	// BSLLS:MagicNumber-on
	// Поступление на основании передачи в связанные документы заказа не попадает: статус остаётся «Передан субподрядчику»
	// (docs/TECHDEBT.md, «Найдено в E11»).
	НовыйКейс(Кейсы, "S7", "Заказ-продажа - поступление из переработки, статус «Передан субподрядчику»", Получен.Ссылка);

КонецПроцедуры

// Реализации без заказа, возвраты, оплаты наличными и безналичными, реализация-черновик.
//
// Параметры:
//  Контекст - Структура - см. ЗаполнитьДемоНабор
//  Кейсы    - Соответствие - см. ЗаполнитьДемоНабор
//
Процедура ДемоРеализацииИОплаты(Контекст, Кейсы)

	Н = Контекст.Номенклатура;
	У = Контекст.Участники;
	Закупки = Кейсы["R1"];
	// BSLLS:MagicNumber-off - суммы и количества (план, §4).
	ДемоВозвратПоставщику(Контекст, У.Casa, Закупки.Лампы, 2);
	ДемоРасходныйОрдер(Контекст, У.Casa, Закупки.Лампы, 3000);
	ДемоСписаниеСоСчета(Контекст, У.Bois, Закупки.Материалы, 1500);

	Полная = ДемоРеализация(Контекст, У.Atlas, Н.Lampe, 3, Истина);
	ДемоПриходныйОрдер(Контекст, У.Atlas, Полная, 1800);
	ДемоВозвратОтПокупателя(Контекст, Полная, 1);
	Частичная = ДемоРеализация(Контекст, У.Riad, Н.Lampe, 2, Истина);
	ДемоПриходныйОрдер(Контекст, У.Riad, Частичная, 500);
	Черновик = ДемоРеализация(Контекст, У.Majorelle, Н.Lampe, 1, Ложь);
	// BSLLS:MagicNumber-on
	Кейс = НовыйКейс(Кейсы, "R", "Реализации: оплачена с возвратом, оплачена частично, черновик; возврат и оплата поставщику");
	Кейс.Вставить("Полная", Полная);
	Кейс.Вставить("Частичная", Частичная);
	Кейс.Вставить("Черновик", Черновик);

