// BSLLS:MagicNumber-on
// BSLLS:CyclomaticComplexity-on
// BSLLS:CognitiveComplexity-on

Функция НовоеОписаниеКейса(Текст, Документов, Поля)

	Возврат Новый Структура("Текст, Документов, Поля", Текст, Документов, Поля);

КонецФункции

// Ключ документа кейса: «Démo 2mzl #<блок>-<кейс>-<номер>» и суффикс.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Блок     - Строка - код блока
//  Код      - Строка - код кейса
//  Номер    - Число - номер документа в кейсе
//
// Возвращаемое значение:
//  Строка - ключ
//
Функция КлючДокумента(Контекст, Блок, Код, Номер)

	Возврат ПометкаДемоНабора() + " #" + Блок + "-" + Код + "-" + Формат(Номер, "ЧГ=0") + Контекст.Суффикс;

КонецФункции

// Ключ следующего документа создаваемого кейса. Номер растёт в порядке создания - он закреплён кодом кейса.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Строка - ключ
//
Функция СледующийКлюч(Контекст)

	Контекст.НомерВКейсе = Контекст.НомерВКейсе + 1;
	Возврат КлючДокумента(Контекст, Контекст.Блок, Контекст.Код, Контекст.НомерВКейсе);

КонецФункции

// Ставит ключ кейса последним - после всех Заполнить и переносов, которые переписывают комментарий, - и записывает или
// проводит документ.
//
// Параметры:
//  Контекст  - Структура - см. ВыполнитьБлоки
//  Док       - ДокументОбъект - документ кейса
//  Проводить - Булево - провести; Ложь - записать
//
Процедура ЗаписатьДокументКейса(Контекст, Док, Проводить)

	Ключ = СледующийКлюч(Контекст);
	Если ТипЗнч(Док) = Тип("ДокументОбъект.ЗаявкаНаПоискТовара") Тогда
		Док.Артикул = Ключ;
	Иначе
		Док.Комментарий = Ключ;
	КонецЕсли;
	Если Проводить Тогда
		Обработки.ТестыДокументов.Провести(Док);
	Иначе
		Обработки.ТестыДокументов.Записать(Док);
	КонецЕсли;

КонецПроцедуры

// Документы кейса по ключам.
//
// Параметры:
//  Контекст   - Структура - см. ВыполнитьБлоки
//  Блок       - Строка - код блока
//  Код        - Строка - код кейса
//  Документов - Число - сколько ключей у кейса
//
// Возвращаемое значение:
//  Соответствие - номер документа в кейсе - Структура: Значение (ссылка; у лида - полное имя), ПометкаУдаления, Повторов
//
Функция НайтиДокументыКейса(Контекст, Блок, Код, Документов)

	Номера = Новый Соответствие;
	Ключи = Новый Массив;
	Для Номер = 1 По Документов Цикл
		Ключ = КлючДокумента(Контекст, Блок, Код, Номер);
		Ключи.Добавить(Ключ);
		Номера.Вставить(Ключ, Номер);
	КонецЦикла;

	Запрос = Новый Запрос(?(Код = "L", ТекстПоискаЛидов(), ТекстПоискаКлючей()));
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Найдено = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Номер = Номера.Получить(Выборка.Ключ);
		Если Номер = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Было = Найдено.Получить(Номер);
		Если Было = Неопределено Тогда
			Элемент = Новый Структура("Значение, ПометкаУдаления, Повторов", Выборка.Значение, Выборка.ПометкаУдаления, 1);
			Найдено.Вставить(Номер, Элемент);
		Иначе
			Было.Повторов = Было.Повторов + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

// Объединение по всем объектам, куда набор пишет ключи: документы - комментарий, заявки - артикул, договоры -
// комментарий договора.
//
// Возвращаемое значение:
//  Строка - текст запроса с параметром &Ключи
//
Функция ТекстПоискаКлючей()

	// BSLLS:QueryParseError-off - шаблон с подстановкой таблицы и поля.
	Шаблон = "ВЫБРАТЬ
		|	Т.Ссылка КАК Значение,
		|	Т.ПометкаУдаления КАК ПометкаУдаления,
		|	ВЫРАЗИТЬ(Т.%2 КАК СТРОКА(150)) КАК Ключ
		|ИЗ
		|	%1 КАК Т
		|ГДЕ
		|	ВЫРАЗИТЬ(Т.%2 КАК СТРОКА(150)) В (&Ключи)";
	// BSLLS:QueryParseError-on
	Тексты = Новый Массив;
	ИменаДокументов = "КоммерческоеПредложение,ЗаказПокупателя,ЗаказПоставщику,ПоступлениеТоваровУслуг,РеализацияТоваровУслуг,"
		+ "ПриходныйКассовыйОрдер,РасходныйКассовыйОрдер,ПоступлениеБезналичныхДенежныхСредств,"
		+ "СписаниеБезналичныхДенежныхСредств,ВыпускПродукции,ПередачаВПереработку,ПоступлениеИзПереработки,"
		+ "ВозвратПоставщику,ВозвратОтПокупателя,ТехнологическаяКарта,ТребованиеНакладная,ОбслуживаниеСтанка,"
		+ "ПересчётТоваров,СписаниеТоваров,ОприходованиеТоваров";
	Для Каждого Имя Из СтрРазделить(ИменаДокументов, ",") Цикл
		Тексты.Добавить(СтрШаблон(Шаблон, "Документ." + Имя, "Комментарий"));
	КонецЦикла;
	Тексты.Добавить(СтрШаблон(Шаблон, "Документ.ЗаявкаНаПоискТовара", "Артикул"));
	Тексты.Добавить(СтрШаблон(Шаблон, "Справочник.ДоговорыСКонтрагентами", "Комментарий"));
	Возврат СтрСоединить(Тексты, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);

КонецФункции

Функция ТекстПоискаЛидов()

	Возврат "ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Т.ПолноеИмя КАК СТРОКА(200)) КАК Значение,
		|	ЛОЖЬ КАК ПометкаУдаления,
		|	ВЫРАЗИТЬ(Т.Комментарий КАК СТРОКА(150)) КАК Ключ
		|ИЗ
		|	РегистрСведений.Лиды КАК Т
		|ГДЕ
		|	ВЫРАЗИТЬ(Т.Комментарий КАК СТРОКА(150)) В (&Ключи)";

КонецФункции

// После создания кейса: генератор завёл ровно ожидаемое число документов, и на каждый ключ - ровно один документ.
//
// Параметры:
//  Контекст   - Структура - см. ВыполнитьБлоки
//  Блок       - Строка - код блока
//  Код        - Строка - код кейса
//  Документов - Число - ожидаемое число документов
//
Процедура ПроверитьДокументыКейса(Контекст, Блок, Код, Документов)

	Если Контекст.НомерВКейсе <> Документов Тогда
		ВызватьИсключение СтрШаблон("Кейс %1 завёл %2 документов с ключами, ожидалось %3", Код,
			Контекст.НомерВКейсе, Документов);
	КонецЕсли;
	Найдено = НайтиДокументыКейса(Контекст, Блок, Код, Документов);
	Для Номер = 1 По Документов Цикл
		Элемент = Найдено.Получить(Номер);
		Повторов = ?(Элемент = Неопределено, 0, Элемент.Повторов);
		Если Повторов <> 1 Тогда
			ВызватьИсключение СтрШаблон("Ключ %1: найдено %2", КлючДокумента(Контекст, Блок, Код, Номер), Повторов);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Структура переиспользованного кейса из найденных по ключам документов.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Код      - Строка - код кейса
//  Описание - Структура - см. ОписаниеКейса
//  Найдено  - Соответствие - см. НайтиДокументыКейса
//
// Возвращаемое значение:
//  Структура - кейс с полями описания
//
Функция КейсИзНайденного(Контекст, Код, Описание, Найдено)

	Кейс = НовыйКейс();
	Кейс.Описание = Описание.Текст;
	Для Каждого Пара Из СтрРазделить(Описание.Поля, ",", Ложь) Цикл
		Части = СтрРазделить(Пара, "=");
		Если Части[1] = "*" Тогда
			Значения = Новый Массив;
			Для Номер = 1 По Описание.Документов Цикл
				Значения.Добавить(Найдено[Номер].Значение);
			КонецЦикла;
			Кейс.Вставить(Части[0], Значения);
		Иначе
			Кейс.Вставить(Части[0], Найдено[Число(Части[1])].Значение);
		КонецЕсли;
	КонецЦикла;
	Если Код = "P11" Тогда
		Кейс.Вставить("Продукция", Контекст.Номенклатура.Table);
	КонецЕсли;
	Возврат Кейс;

КонецФункции

Функция ТекстНеполногоКейса(Описание, Найдено, Помеченных)

	Нет = Новый Массив;
	Для Номер = 1 По Описание.Документов Цикл
		Если Найдено.Получить(Номер) = Неопределено Тогда
			Нет.Добавить(Формат(Номер, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;
	Шаблон = НСтр("ru = '%1: нет документов %2, помечено на удаление или с повтором ключа %3 - удалите
		|оставшиеся документы кейса, чтобы он создался заново';
		|fr = '%1 : documents manquants %2, marqués pour suppression ou clé en double %3 - supprimez
		|les documents restants du cas pour le recréer';
		|en = '%1: missing documents %2, marked for deletion or with a duplicate key %3 - delete
		|the remaining documents of the case to recreate it';
		|es = '%1: faltan documentos %2, marcados para eliminar o con clave repetida %3 - elimine
		|los documentos restantes del caso para volver a crearlo'");
	Возврат СтрШаблон(Шаблон, Описание.Текст, ?(Нет.Количество() = 0, "-", СтрСоединить(Нет, ", ")), Помеченных);

КонецФункции

#КонецОбласти

#Область СправочникиДемоНабора

