////////////////////////////////////////////////////////////////////////////////
// Серверная часть подсистемы «Автотесты»: образцы объектов для прогона.
// Прогон проверяет форму объекта и печатную форму только там, где в базе есть хотя бы
// один объект; эта обработка заводит недостающие образцы - по одному на объект.
// Цели: все документы, все справочники (у иерархических - ещё и группа) и объекты
// с командами печати.
//
// Демо-набор производственного контура и торговли (СоздатьДемоНабор) заводит документы во всех стадиях и статусах
// для ручной приёмки и скриншотов инструкций (scripts/fixtures.sh --demo).
//
// Обработка ЗАПИСЫВАЕТ данные: запускать только на тестовой базе (scripts/fixtures.sh).
// Регламент - docs/TESTING.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Заводит образец для каждого объекта с командами печати, у которого в базе нет ни одного
// объекта. Документ заполняется по минимуму: реквизиты-ссылки берутся первыми подходящими
// элементами справочников, в товарную часть добавляется одна строка. Сначала документ
// пробуется провести; если проведение не проходит, документ остаётся записанным - печати
// этого достаточно, а прогон получает образец.
//
// Возвращаемое значение:
//  Структура - итог заполнения:
//   * Строки  - Массив из Строка - строки отчёта видов ЕСТЬ, СОЗДАН, ОШИБКА
//   * Создано - Число            - сколько образцов заведено
//   * Ошибок  - Число            - для скольких объектов образец завести не удалось
//   * Было    - Число            - сколько объектов уже имели образец
//
Функция СоздатьНедостающиеОбразцы() Экспорт

	Итог = Новый Структура("Строки, Создано, Ошибок, Было");
	Итог.Строки = Новый Массив;
	Итог.Создано = 0;
	Итог.Ошибок = 0;
	Итог.Было = 0;

	Для Каждого Цель Из ЦелевыеОбъекты() Цикл

		Представление = Цель.ПолноеИмя + ?(Цель.ЭтоГруппа, " (группа)", "");

		Если Обработки.СмокТест.ОбразецОбъекта(Цель.ПолноеИмя, Цель.ЭтоГруппа) <> Неопределено Тогда
			Итог.Было = Итог.Было + 1;
			Продолжить;
		КонецЕсли;

		Попытка
			Результат = СоздатьОбразец(Цель.ПолноеИмя, Цель.ЭтоГруппа);
			Итог.Строки.Добавить("СОЗДАН;" + Представление + ";" + Результат);
			Итог.Создано = Итог.Создано + 1;
		Исключение
			// BSLLS:DeprecatedMethodCall-off
			Информация = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			// BSLLS:DeprecatedMethodCall-on
			Описание = СтрЗаменить(Информация, Символы.ПС, " | ");
			Итог.Строки.Добавить("ОШИБКА;" + Представление + ";" + Описание);
			Итог.Ошибок = Итог.Ошибок + 1;
		КонецПопытки;

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Первый непомеченный элемент справочника - группы не берутся. Им же пользуются тесты
// документов (Обработка.ТестыДокументов), когда сценарию нужен объект из базы.
//
// Параметры:
//  ИмяСправочника - Строка - имя объекта метаданных
//
// Возвращаемое значение:
//  СправочникСсылка - элемент либо пустая ссылка, если справочник пуст
//
Функция ПервыйЭлемент(ИмяСправочника) Экспорт

	ОписаниеСправочника = Метаданные.Справочники[ИмяСправочника];
	УсловиеГруппы = ?(ЭтоСправочникСГруппами(ОписаниеСправочника), "НЕ Таблица.ЭтоГруппа", "ИСТИНА");

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	&ИмяТаблицы КАК Таблица
		|ГДЕ
		|	НЕ Таблица.ПометкаУдаления
		|	И &УсловиеГруппы";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", "Справочник." + ИмяСправочника);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГруппы", УсловиеГруппы);

	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции

// Параметры заполнения демо-набора по умолчанию: только ядро, функциональные опции не включаются, база не объявлена
// тестовой.
//
// Возвращаемое значение:
//  Структура - параметры СоздатьДемоНабор:
//   * Блоки                - Строка - блоки набора через запятую: CORE - ядро производства и торговли, M - учёт станков
//   * ВключитьПроизводство - Булево - включить функциональную опцию «Производство», если она выключена
//   * ВключитьАвтовыпуск   - Булево - включить автоматический выпуск при отгрузке, если он выключен
//   * ВключитьУчетСтанков  - Булево - включить учёт станков, если он выключен
//   * ТестоваяБаза         - Булево - запуск из scripts/fixtures.sh: виды документов без комментария не проверяются
//
Функция НовыеПараметрыДемоНабора() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Блоки", БлокЯдра());
	Параметры.Вставить("ВключитьПроизводство", Ложь);
	Параметры.Вставить("ВключитьАвтовыпуск", Ложь);
	Параметры.Вставить("ВключитьУчетСтанков", Ложь);
	Параметры.Вставить("ТестоваяБаза", Ложь);
	Возврат Параметры;

КонецФункции

// Заводит демо-набор и дозаливает недостающее: ядро производственного контура и торговли (заказы на производство на
// каждой стадии, КП, заказы-продажи, закупки, реализации, возвраты, оплаты, договоры, лиды, заявки) и блок учёта станков.
// Работает только в демо- или тестовой базе: есть хоть один рабочий документ - отказ без единой записи. Справочники
// переиспользуются по ключам, документы - по ключу в комментарии; кейс атомарен: есть целиком - переиспользуется, нет
// ни одного документа - создаётся в своей транзакции, есть часть - «неполный», ничего не трогается. Состав кейсов и
// правила - docs/TESTING.md, раздел «Демо-набор», план - docs/plans/demo-data-button.md.
//
// Обработка ЗАПИСЫВАЕТ данные: кнопка «Заполнить демо-данными» в «Компания и учёт» и scripts/fixtures.sh --demo.
//
// Параметры:
//  Параметры - Структура, Неопределено - см. НовыеПараметрыДемоНабора; Неопределено - по умолчанию
//
// Возвращаемое значение:
//  Структура - итог в формате СоздатьНедостающиеОбразцы и счётчики набора:
//   * Строки           - Массив из Строка - строки отчёта видов ОТКАЗ, НАСТРОЙКА, СОЗДАН, ПЕРЕИСПОЛЬЗОВАН, НЕПОЛНЫЙ,
//                        ПРОПУСК, ОШИБКА, ССЫЛКА, ИНФО
//   * Создано          - Число - сколько кейсов заведено
//   * Ошибок           - Число - сколько кейсов не заведено из-за ошибки; 1 при отказе
//   * Было             - Число - 1, если ничего не создано и всё было в базе
//   * Переиспользовано - Число - сколько кейсов уже было в базе целиком
//   * Неполных         - Число - сколько кейсов в базе частично
//   * Пропущено        - Число - сколько кейсов пропущено по условиям
//
Функция СоздатьДемоНабор(Параметры = Неопределено) Экспорт

	ПроверитьПравоДемоНабора();
	Если Параметры = Неопределено Тогда
		Параметры = НовыеПараметрыДемоНабора();
	КонецЕсли;
	Итог = НовыйИтогДемоНабора();

	Рабочий = РабочийДокументБазы(Параметры.ТестоваяБаза);
	Если Рабочий <> Неопределено Тогда
		ДобавитьОтказ(Итог, Рабочий);
		Возврат Итог;
	КонецЕсли;

	Начало = НачалоДемоНабора();
	Если Начало = Неопределено Тогда
		Итог.Ошибок = 1;
		Шаблон = НСтр("ru = 'С начала дня прошло меньше %1 с: документы набора попали бы во вчерашний день. Запустите позже.';
			|fr = 'Moins de %1 s depuis le début de la journée : les documents tomberaient sur la veille. Relancez plus tard.';
			|en = 'Less than %1 s since the start of the day: documents would fall on the previous day. Run it later.';
			|es = 'Han pasado menos de %1 s desde el inicio del día: los documentos caerían en el día anterior. Ejecútelo más tarde.'");
		Итог.Строки.Добавить("ОШИБКА;Демо-набор;" + СтрШаблон(Шаблон, ДлительностьДемоНабора()));
		Возврат Итог;
	КонецЕсли;

	// Значение функциональной опции кэшируется в сеансе: константы ставятся до транзакций со сбросом кэша.
	ВключитьОпцииДемоНабора(Параметры, Итог);

	Прогон = НовыйПрогон(Начало, "", Итог, Истина, Параметры.ТестоваяБаза);
	ВыполнитьБлоки(Прогон, Параметры.Блоки);
	Если Итог.Создано + Итог.Ошибок + Итог.Неполных + Итог.Пропущено = 0 Тогда
		Итог.Было = 1;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Начало дат демо-набора: текущий момент минус длительность набора, если он умещается в текущий день.
//
// Возвращаемое значение:
//  Дата, Неопределено - дата первого документа; Неопределено - с начала дня прошло слишком мало времени
//
Функция НачалоДемоНабора() Экспорт

	Сейчас = ТекущаяДатаСеанса();
	Начало = Сейчас - ДлительностьДемоНабора();
	Если Начало < НачалоДня(Сейчас) + 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Начало;

КонецФункции

// Ядро демо-набора для сценария уровня 3 «ДемоНабор»: справочники и кейсы ядра в транзакции вызывающего, без своих
// транзакций и без проверки демо-базы. Ошибка кейса - исключение: транзакция вызывающего годится только для отката.
//
// Параметры:
//  Начало  - Дата   - дата первого документа, см. НачалоДемоНабора
//  Суффикс - Строка - добавляется к наименованиям и ключам набора; пустая строка - обычный набор
//
// Возвращаемое значение:
//  Соответствие - код кейса (P1…P11, R1, T, S1…S7, R, C, L, Z) - Структура с полем Описание и ссылками документов кейса
//
Функция ЗаполнитьДемоНабор(Начало, Суффикс) Экспорт

	Результат = ЗаполнитьДемоДанные(Начало, Суффикс, БлокЯдра());
	Итог = Результат.Итог;
	Если Итог.Создано <> КодыКейсовБлока(БлокЯдра()).Количество() Тогда
		ВызватьИсключение "Демо-набор создан не целиком: " + СтрСоединить(Итог.Строки, " | ");
	КонецЕсли;
	Возврат Результат.Кейсы;

КонецФункции

// Блоки демо-набора для сценариев уровня 3: в транзакции вызывающего, без своих транзакций и без проверки демо-базы.
// Переиспользование и «неполные» кейсы работают так же, как у СоздатьДемоНабор; ошибка кейса - исключение.
// Автовыпуск при отгрузке включается, как раньше в ядре: константа пишется в транзакции вызывающего.
//
// Параметры:
//  Начало  - Дата   - дата первого документа, см. НачалоДемоНабора
//  Суффикс - Строка - добавляется к наименованиям и ключам набора
//  Блоки   - Строка - блоки через запятую, см. НовыеПараметрыДемоНабора
//
// Возвращаемое значение:
//  Структура - Кейсы (Соответствие, см. ЗаполнитьДемоНабор), Итог (см. СоздатьДемоНабор), Контекст (справочники набора)
//
Функция ЗаполнитьДемоДанные(Начало, Суффикс, Блоки) Экспорт

	ПроверитьПравоДемоНабора();
	Итог = НовыйИтогДемоНабора();
	// Запись константы держит блокировку до конца транзакции: пишется, только если переключатель выключен.
	Если Не Константы.ИспользоватьАвтовыпускПриОтгрузке.Получить() Тогда
		Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	КонецЕсли;
	Прогон = НовыйПрогон(Начало, Суффикс, Итог, Ложь, Истина);
	Кейсы = ВыполнитьБлоки(Прогон, Блоки);
	Возврат Новый Структура("Кейсы, Итог, Контекст", Кейсы, Итог, Прогон.Контекст);

КонецФункции

// Первый рабочий документ базы - документ любого вида конфигурации, заведённый не демо-набором, не образцами
// scripts/fixtures.sh и не сценариями тестов (их узнают по маркеру в комментарии), не созданный механизмом
// (автовыпуск, выпуск по требованию) и не техкарта демо-номенклатуры. Вид без реквизита «Комментарий» считается
// рабочим целиком, кроме заявок на поиск товара демо-набора; в тестовой базе такие виды не проверяются.
//
// Параметры:
//  ТестоваяБаза - Булево - запуск из scripts/fixtures.sh: виды документов без комментария не проверяются
//
// Возвращаемое значение:
//  Структура, Неопределено - Вид, Номер, Дата первого найденного документа; Неопределено - рабочих документов нет
//
Функция РабочийДокументБазы(ТестоваяБаза) Экспорт

	Тексты = Новый Массив;
	Для Каждого ОписаниеДокумента Из Метаданные.Документы Цикл
		Текст = ТекстПоискаРабочегоДокумента(ОписаниеДокумента, ТестоваяБаза, Ложь);
		Если Не ПустаяСтрока(Текст) Тогда
			Тексты.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Если Тексты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(СтрСоединить(Тексты, Символы.ПС + ";" + Символы.ПС));
	Запрос.УстановитьПараметр("СтарыеЗаявки", СтарыеЗаявкиДемоНабора());
	Для Каждого Результат Из Запрос.ВыполнитьПакет() Цикл
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Новый Структура("Вид, Номер, Дата", Выборка.Вид, СокрЛП(Выборка.Номер), Выборка.Дата);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Рабочий ли документ по правилам РабочийДокументБазы - для сценария уровня 3 «ДемоНаборОтказ»: в базе могут быть
// и другие рабочие документы, поэтому проверяется конкретная ссылка.
//
// Параметры:
//  Ссылка       - ДокументСсылка - документ
//  ТестоваяБаза - Булево - см. РабочийДокументБазы
//
// Возвращаемое значение:
//  Булево - документ рабочий
//
Функция ЭтоРабочийДокумент(Ссылка, ТестоваяБаза) Экспорт

	Текст = ТекстПоискаРабочегоДокумента(Ссылка.Метаданные(), ТестоваяБаза, Истина);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("СтарыеЗаявки", СтарыеЗаявкиДемоНабора());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Текст отказа по рабочему документу для пользователя.
//
// Параметры:
//  Рабочий - Структура - см. РабочийДокументБазы
//
// Возвращаемое значение:
//  Строка - текст на языке пользователя
//
Функция ТекстОтказаДемоНабора(Рабочий) Экспорт

	Шаблон = НСтр("ru = 'База содержит рабочие документы (%1 № %2 от %3) - демо-набор заполняется только в демо- или тестовой базе.';
		|fr = 'La base contient des documents de travail (%1 n° %2 du %3) : le jeu de démo se remplit seulement en base démo ou test.';
		|en = 'The infobase contains working documents (%1 No. %2 of %3): the demo set is filled only in a demo or test infobase.';
		|es = 'La base contiene documentos de trabajo (%1 n.º %2 del %3): el conjunto demo solo se llena en una base demo o de prueba.'");
	Представление = Метаданные.Документы[Рабочий.Вид].Представление();
	Возврат СтрШаблон(Шаблон, Представление, Рабочий.Номер, Формат(Рабочий.Дата, "ДЛФ=D"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Список объектов, для которых нужен образец: все документы, все справочники (у
// иерархических дополнительно группа) и объекты с командами печати - у последних образец
// нужен, даже если это не документ и не справочник (запись регистра лидов).
//
// Возвращаемое значение:
//  Массив из Структура - цели заполнения:
//   * ПолноеИмя - Строка - полное имя объекта метаданных
//   * ЭтоГруппа - Булево - нужна группа справочника, а не элемент
//
Функция ЦелевыеОбъекты()

	Цели = Новый Массив;
	Ключи = Новый Соответствие;
	Пропуски = НеЗаводимыеОбъекты();

	Для Каждого ПолноеИмяОбъекта Из ПечатныеФормы.ОбъектыСКомандамиПечати() Цикл
		ДобавитьЦель(Цели, Ключи, Пропуски, ПолноеИмяОбъекта, Ложь);
	КонецЦикла;

	Для Каждого ОписаниеДокумента Из Метаданные.Документы Цикл
		ДобавитьЦель(Цели, Ключи, Пропуски, ОписаниеДокумента.ПолноеИмя(), Ложь);
	КонецЦикла;

	Для Каждого ОписаниеСправочника Из Метаданные.Справочники Цикл
		ДобавитьЦель(Цели, Ключи, Пропуски, ОписаниеСправочника.ПолноеИмя(), Ложь);
		Если ЭтоСправочникСГруппами(ОписаниеСправочника) Тогда
			ДобавитьЦель(Цели, Ключи, Пропуски, ОписаниеСправочника.ПолноеИмя(), Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Цели;

КонецФункции

// Добавляет цель в список, если её там ещё нет и она не в пропусках.
//
// Параметры:
//  Цели      - Массив из Структура - пополняемый список, см. ЦелевыеОбъекты
//  Ключи     - Соответствие        - уже добавленные цели
//  Пропуски  - Массив из Строка    - объекты, для которых образец не заводится
//  ПолноеИмя - Строка              - полное имя объекта метаданных
//  ЭтоГруппа - Булево              - группа справочника, а не элемент
//
Процедура ДобавитьЦель(Цели, Ключи, Пропуски, ПолноеИмя, ЭтоГруппа)

	Если Пропуски.Найти(ПолноеИмя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ключ = ПолноеИмя + ?(ЭтоГруппа, "/группа", "");
	Если Ключи[Ключ] <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ключи.Вставить(Ключ, Истина);
	Цели.Добавить(Новый Структура("ПолноеИмя, ЭтоГруппа", ПолноеИмя, ЭтоГруппа));

КонецПроцедуры

// Объекты, для которых образец не заводится. Каждый пропуск - с причиной.
//
// Возвращаемое значение:
//  Массив из Строка - полные имена объектов метаданных
//
Функция НеЗаводимыеОбъекты()

	Пропуски = Новый Массив;

	// Пользователи информационной базы заводятся администратором, а не автотестом:
	// элемент справочника без пользователя ИБ ломает вход и права.
	Пропуски.Добавить("Справочник.Пользователи");
	Пропуски.Добавить("Справочник.ГруппыПользователей");

	Возврат Пропуски;

КонецФункции

// Заводит один образец.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных
//  ЭтоГруппа        - Булево - группа справочника, а не элемент
//
// Возвращаемое значение:
//  Строка - представление созданного образца для отчёта
//
Функция СоздатьОбразец(ПолноеИмяОбъекта, ЭтоГруппа)

	Если ПолноеИмяОбъекта = "РегистрСведений.Лиды" Тогда
		Возврат СоздатьЛид();
	КонецЕсли;

	Если СтрНачинаетсяС(ПолноеИмяОбъекта, "Документ.") Тогда
		Возврат СоздатьОбразецДокумента(СтрЗаменить(ПолноеИмяОбъекта, "Документ.", ""));
	КонецЕсли;

	Если СтрНачинаетсяС(ПолноеИмяОбъекта, "Справочник.") Тогда
		Возврат СоздатьОбразецСправочника(СтрЗаменить(ПолноеИмяОбъекта, "Справочник.", ""), ЭтоГруппа);
	КонецЕсли;

	// Появится печать у объекта другого вида - правило для него добавляется сюда осознанно,
	// а не угадывается.
	ВызватьИсключение НСтр("ru = 'Образец объекта этого вида обработка заводить не умеет';
		|fr = 'Le traitement ne sait pas créer d''exemple pour ce type d''objet';
		|en = 'The data processor cannot create a sample for this object kind';
		|es = 'El procesamiento no sabe crear un ejemplo para este tipo de objeto'");

КонецФункции

// Заводит образец документа: особенности вида, ссылочные реквизиты по метаданным, запись.
//
// Параметры:
//  ИмяДокумента - Строка - имя объекта метаданных
//
// Возвращаемое значение:
//  Строка - представление созданного образца для отчёта
//
Функция СоздатьОбразецДокумента(ИмяДокумента)

	Док = Документы[ИмяДокумента].СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();

	ДовестиОбразец(ИмяДокумента, Док);
	ЗаполнитьСсылочныеРеквизиты(Док);
	ЗаполнитьКомментарий(Док);

	Режим = ЗаписатьОбразец(Док, Истина);

	Возврат СокрЛП(Док.Номер) + ";" + Режим;

КонецФункции

// Заводит образец элемента или группы справочника: владелец, наименование, ссылочные
// реквизиты по метаданным, запись.
//
// Параметры:
//  ИмяСправочника - Строка - имя объекта метаданных
//  ЭтоГруппа      - Булево - создаётся группа, а не элемент
//
// Возвращаемое значение:
//  Строка - представление созданного образца для отчёта
//
Функция СоздатьОбразецСправочника(ИмяСправочника, ЭтоГруппа)

	Описание = Метаданные.Справочники[ИмяСправочника];
	Менеджер = Справочники[ИмяСправочника];
	Элемент = ?(ЭтоГруппа, Менеджер.СоздатьГруппу(), Менеджер.СоздатьЭлемент());

	УстановитьВладельца(Элемент, Описание);

	Если Описание.ДлинаНаименования > 0 Тогда
		Элемент.Наименование = Лев(ПометкаОбразца(), Описание.ДлинаНаименования);
	КонецЕсли;

	ЗаполнитьСсылочныеРеквизиты(Элемент, ЭтоГруппа);
	ЗаполнитьКомментарий(Элемент);

	Режим = ЗаписатьОбразец(Элемент, Ложь);

	Возврат СокрЛП(Элемент.Наименование) + ";" + Режим;

КонецФункции

// Ставит владельца подчинённому справочнику: без него запись не проходит проверку.
//
// Параметры:
//  Элемент  - СправочникОбъект           - заполняемый образец
//  Описание - ОбъектМетаданныхСправочник - описание справочника
//
Процедура УстановитьВладельца(Элемент, Описание)

	// Владельцев может быть несколько типов - берём первый подходящий справочник, для образца
	// достаточно. Коллекция владельцев обходится циклом: доступа по индексу у неё нет.
	Для Каждого ОписаниеВладельца Из Описание.Владельцы Цикл
		Если Метаданные.Справочники.Содержит(ОписаниеВладельца) Тогда
			Элемент.Владелец = ПервыйЭлемент(ОписаниеВладельца.Имя);
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Записывает образец: сначала с проведением, затем просто записью, в последнюю очередь
// загрузкой. Загрузка обходит проверку заполнения и логику записи - образец нужен прогону
// как объект, на котором открывается форма, а не как корректный документ учёта.
//
// Параметры:
//  Объект      - ДокументОбъект, СправочникОбъект - заполненный образец
//  ЭтоДокумент - Булево - у документа есть режим проведения
//
// Возвращаемое значение:
//  Строка - каким способом записан, для отчёта
//
Функция ЗаписатьОбразец(Объект, ЭтоДокумент)

	// Проведение образца не обязательно, а причина отказа в отчёт не пишется: это не дефект
	// конфигурации, а нехватка данных в тестовой базе. Поэтому блоки Исключение пустые.
	// BSLLS:MissingCodeTryCatchEx-off
	Если ЭтоДокумент Тогда
		Попытка
			Объект.Записать(РежимЗаписиДокумента.Проведение);
			Возврат "проведен";
		Исключение
		КонецПопытки;
	КонецЕсли;

	Попытка
		Объект.Записать();
		Возврат "записан";
	Исключение
	КонецПопытки;
	// BSLLS:MissingCodeTryCatchEx-on

	Объект.ОбменДанными.Загрузка = Истина;
	Если ЭтоДокумент Тогда
		Если Не ЗначениеЗаполнено(Объект.Номер) Тогда
			Объект.УстановитьНовыйНомер();
		КонецЕсли;
	Иначе
		Если Объект.Метаданные().ДлинаКода > 0 И Не ЗначениеЗаполнено(Объект.Код) Тогда
			Объект.УстановитьНовыйКод();
		КонецЕсли;
	КонецЕсли;
	Объект.Записать();

	Возврат "записан загрузкой";

КонецФункции

// Особенности отдельных видов документов: то, что не выводится из метаданных - хозяйственная
// операция, согласованные контрагент с договором, строки табличных частей.
//
// Параметры:
//  ИмяДокумента - Строка         - имя объекта метаданных
//  Док          - ДокументОбъект - заполняемый образец
//
Процедура ДовестиОбразец(ИмяДокумента, Док)

	Если ДовестиТоварныйОбразец(ИмяДокумента, Док) Тогда
		Возврат;
	КонецЕсли;

	Если ДовестиДенежныйОбразец(ИмяДокумента, Док) Тогда
		Возврат;
	КонецЕсли;

	ДовестиПрочийОбразец(ИмяДокумента, Док);

КонецПроцедуры

// Образцы документов движения товаров: контрагент с договором, операция и строка товаров.
//
// Параметры:
//  ИмяДокумента - Строка         - имя объекта метаданных
//  Док          - ДокументОбъект - заполняемый образец
//
// Возвращаемое значение:
//  Булево - Истина, если документ этого вида и заполнение выполнено
//
Функция ДовестиТоварныйОбразец(ИмяДокумента, Док)

	Операции = Перечисления.ХозяйственныеОперации;

	Если ИмяДокумента = "ВозвратОтПокупателя" Тогда
		Док.ХозяйственнаяОперация = Операции.ВозвратТоваровОтКлиента;
		ЗаполнитьВозвратПоРеализации(Док);
	ИначеЕсли ИмяДокумента = "ВозвратОтПокупателяНалоговый" Тогда
		УстановитьКонтрагента(Док);
		Док.ХозяйственнаяОперация = Операции.ВозвратТоваровОтКлиента;
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "НалоговаяНакладная" Тогда
		УстановитьКонтрагента(Док);
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "НалоговаяНакладнаяПокупка" Тогда
		УстановитьКонтрагента(Док);
		Док.ХозяйственнаяОперация = Операции.ЗакупкаУПоставщика;
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "ПеремещениеТоваров" Тогда
		Док.ХозяйственнаяОперация = Операции.ПеремещениеОприходование;
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "ПередачаВПереработку" Или ИмяДокумента = "ПоступлениеИзПереработки" Тогда
		УстановитьКонтрагента(Док);
		ДобавитьСтрокуТоваров(Док);
		ДобавитьСтрокуТоваров(Док, "ТЧГотоваяПродукция");
	ИначеЕсли ИмяДокумента = "ОприходованиеТоваров" Или ИмяДокумента = "СписаниеТоваров" Тогда
		ДобавитьСтрокуТоваров(Док);
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Образцы заказов, предложений, цен и денежных документов.
//
// Параметры:
//  ИмяДокумента - Строка         - имя объекта метаданных
//  Док          - ДокументОбъект - заполняемый образец
//
// Возвращаемое значение:
//  Булево - Истина, если документ этого вида и заполнение выполнено
//
Функция ДовестиДенежныйОбразец(ИмяДокумента, Док)

	Операции = Перечисления.ХозяйственныеОперации;

	Если ИмяДокумента = "КоммерческоеПредложение" Тогда
		УстановитьКонтрагента(Док);
		Док.ДатаОтгрузки = Док.Дата;
		Док.Статус = Перечисления.СтатусыКоммерческихПредложений.Черновик;
		Док.ЦенаВключаетНДС = Истина;
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "ЗаказПоставщику" Тогда
		УстановитьКонтрагента(Док);
		Док.ВидЗаказа = Перечисления.ВидыЗаказовПоставщику.Основной;
		Док.ДатаПоставки = Док.Дата;
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "ПредложениеПоставщика" Тогда
		УстановитьКонтрагента(Док);
		Док.ЗаказПокупателя = ПервыйДокумент("ЗаказПокупателя");
		Док.ДатаПредложения = Док.Дата;
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "УстановкаЦенНоменклатуры" Тогда
		Док.ХозяйственнаяОперация = Операции.УстановкаЦенНоменклатуры;
		ДобавитьСтрокуТоваров(Док, "ТЧЦены");
	ИначеЕсли ИмяДокумента = "ПриходныйКассовыйОрдер" Тогда
		ЗаполнитьКассовыйОрдер(Док, Операции.ПоступлениеОплатыОтКлиента);
	ИначеЕсли ИмяДокумента = "РасходныйКассовыйОрдер" Тогда
		ЗаполнитьКассовыйОрдер(Док, Операции.ПрочийРасходДенежныхСредств);
	ИначеЕсли ИмяДокумента = "КассоваяСмена" Тогда
		Док.Статус = Перечисления.СтатусыКассовойСмены.Закрыта;
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Образцы документов взаиморасчётов и кадрового контура.
//
// Параметры:
//  ИмяДокумента - Строка         - имя объекта метаданных
//  Док          - ДокументОбъект - заполняемый образец
//
Процедура ДовестиПрочийОбразец(ИмяДокумента, Док)

	Если ИмяДокумента = "КорректировкаДолга" Тогда
		УстановитьКонтрагента(Док);
		Док.КонтрагентДебитор = Док.КонтрагентКредитор;
		Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеЗадолженности;
		Док.СуммаДебет = СуммаОбразца();
		Док.СуммаКредит = СуммаОбразца();
	ИначеЕсли ИмяДокумента = "СверкаВзаиморасчётов" Тогда
		УстановитьКонтрагента(Док);
		Док.НачалоПериода = НачалоМесяца(Док.Дата);
		Док.КонецПериода = КонецМесяца(Док.Дата);
		ДобавитьСтрокуСверки(Док, "ТЧПоДаннымОрганизации");
		ДобавитьСтрокуСверки(Док, "ТЧПоДаннымКонтрагента");
	ИначеЕсли ИмяДокумента = "ВыплатаЗарплаты" Или ИмяДокумента = "ПлатёжнаяВедомостьНаАванс" Тогда
		ДобавитьСтрокуСотрудника(Док);
	ИначеЕсли ИмяДокумента = "ТабельУчётаРабочегоВремени" Тогда
		ДобавитьСтрокуТабеля(Док);
	Иначе
		// Своего правила у документа нет: общее заполнение по метаданным плюс строка товаров,
		// если товарная часть есть - пустой документ чаще всего не проводится.
		УстановитьКонтрагента(Док);
		ДобавитьСтрокуТоваров(Док);
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Заполняет незаполненные реквизиты-ссылки первыми подходящими элементами справочников.
// Договор и реквизиты-документы пропускаются: их согласованность задаётся отдельно.
// У группы справочника доступны не все реквизиты - реквизиты «только для элемента»
// пропускаются, обращение к ним у группы вызывает ошибку.
//
// Параметры:
//  Объект    - ДокументОбъект, СправочникОбъект - заполняемый образец
//  ЭтоГруппа - Булево - образец является группой справочника
//
Процедура ЗаполнитьСсылочныеРеквизиты(Объект, ЭтоГруппа = Ложь)

	// Свойство реквизита называется Использование; ИспользованиеРеквизита - имя системного
	// перечисления его значений. Проверено прогоном: обращение к ИспользованиеРеквизита падает.
	ТолькоДляЭлемента = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента;

	Для Каждого Реквизит Из Объект.Метаданные().Реквизиты Цикл

		Если ЭтоГруппа И Реквизит.Использование = ТолькоДляЭлемента Тогда
			Продолжить;
		КонецЕсли;

		Если Реквизит.Имя = "Договор" Или ЗначениеЗаполнено(Объект[Реквизит.Имя]) Тогда
			Продолжить;
		КонецЕсли;

		Типы = Реквизит.Тип.Типы();
		Если Типы.Количество() <> 1 Тогда
			Продолжить;
		КонецЕсли;

		ОбъектМетаданных = Метаданные.НайтиПоТипу(Типы[0]);
		Если ОбъектМетаданных = Неопределено Или Не Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;

		Если ОбъектМетаданных = Объект.Метаданные() Тогда
			// Ссылка справочника на самого себя: подставлять образец в его же реквизит незачем.
			Продолжить;
		КонецЕсли;

		Объект[Реквизит.Имя] = ПервыйЭлемент(ОбъектМетаданных.Имя);

	КонецЦикла;

КонецПроцедуры

// Помечает образец комментарием - по нему видно, что объект заведён автотестом.
//
// Параметры:
//  Объект - ДокументОбъект, СправочникОбъект - заполняемый образец
//
Процедура ЗаполнитьКомментарий(Объект)

	Если Объект.Метаданные().Реквизиты.Найти("Комментарий") <> Неопределено Тогда
		Объект.Комментарий = ПометкаОбразца();
	КонецЕсли;

КонецПроцедуры

// Ставит документу контрагента вместе с его договором: договор выбирается первым, чтобы
// контрагент и договор заведомо соответствовали друг другу.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый образец
//
Процедура УстановитьКонтрагента(Док)

	Пара = КонтрагентСДоговором();
	Реквизиты = Док.Метаданные().Реквизиты;

	Если Реквизиты.Найти("Контрагент") <> Неопределено Тогда
		Док.Контрагент = Пара.Контрагент;
	КонецЕсли;
	Если Реквизиты.Найти("КонтрагентКредитор") <> Неопределено Тогда
		Док.КонтрагентКредитор = Пара.Контрагент;
	КонецЕсли;
	Если Реквизиты.Найти("Поставщик") <> Неопределено Тогда
		Док.Поставщик = Пара.Контрагент;
	КонецЕсли;
	Если Реквизиты.Найти("Договор") <> Неопределено Тогда
		Док.Договор = Пара.Договор;
	КонецЕсли;

КонецПроцедуры

// Заполняет кассовый ордер: сумма, статья ДДС, тип оплаты и хозяйственная операция.
//
// Параметры:
//  Док      - ДокументОбъект - заполняемый образец
//  Операция - ПеречислениеСсылка.ХозяйственныеОперации - операция ордера
//
Процедура ЗаполнитьКассовыйОрдер(Док, Операция)

	УстановитьКонтрагента(Док);
	Док.Контрагент = КонтрагентСДоговором().Контрагент;
	Док.ХозяйственнаяОперация = Операция;
	Док.Сумма = СуммаОбразца();

КонецПроцедуры

// Заполняет возврат от покупателя по реализации-основанию: без основания документ не
// записывается вовсе - проверка соответствия возврата реализации в ПередЗаписью читает
// товары документа-основания, а у пустой ссылки табличной части нет. Строка возврата
// повторяет первую строку реализации: проверка сверяет номенклатуру, серию и количество.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый образец
//
Процедура ЗаполнитьВозвратПоРеализации(Док)

	Реализация = ПервыйДокумент("РеализацияТоваровУслуг");
	Если Не ЗначениеЗаполнено(Реализация) Тогда
		УстановитьКонтрагента(Док);
		ДобавитьСтрокуТоваров(Док);
		Возврат;
	КонецЕсли;

	Док.Основание = Реализация;
	Док.Контрагент = Реализация.Контрагент;
	Док.Договор = Реализация.Договор;
	Док.Организация = Реализация.Организация;
	Док.МестоХранения = Реализация.МестоХранения;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТЧТовары.КодСтроки КАК КодСтроки,
		|	ТЧТовары.Номенклатура КАК Номенклатура,
		|	ТЧТовары.Характеристика КАК Характеристика,
		|	ТЧТовары.Упаковка КАК Упаковка,
		|	ТЧТовары.Серия КАК Серия,
		|	ТЧТовары.Количество КАК Количество,
		|	ТЧТовары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	ТЧТовары.Цена КАК Цена,
		|	ТЧТовары.Сумма КАК Сумма,
		|	ТЧТовары.СуммаСНДС КАК СуммаСНДС,
		|	ТЧТовары.СтавкаНДС КАК СтавкаНДС,
		|	ТЧТовары.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК ТЧТовары
		|ГДЕ
		|	ТЧТовары.Ссылка = &Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	ТЧТовары.НомерСтроки");
	Запрос.УстановитьПараметр("Ссылка", Реализация);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		ДобавитьСтрокуТоваров(Док);
		Возврат;
	КонецЕсли;

	Строка = Док.ТЧТовары.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Выборка);

КонецПроцедуры

// Добавляет одну строку в товарную часть документа, если такая часть у него есть.
//
// Параметры:
//  Док   - ДокументОбъект - заполняемый образец
//  ИмяТЧ - Строка         - имя табличной части, по умолчанию товарная часть документа
//
Процедура ДобавитьСтрокуТоваров(Док, ИмяТЧ = "ТЧТовары")

	ТабличныеЧасти = Док.Метаданные().ТабличныеЧасти;
	Если ТабличныеЧасти.Найти(ИмяТЧ) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Колонки = ТабличныеЧасти[ИмяТЧ].Реквизиты;
	Строка = Док[ИмяТЧ].Добавить();

	Номенклатура = ПервыйЭлемент("Номенклатура");
	СтавкаНДС = ПервыйЭлемент("СтавкиНДС");
	Сумма = СуммаОбразца();

	ЗаполнитьКолонку(Строка, Колонки, "КодСтроки", 1);
	ЗаполнитьКолонку(Строка, Колонки, "Номенклатура", Номенклатура);
	ЗаполнитьКолонку(Строка, Колонки, "СтавкаНДС", СтавкаНДС);
	ЗаполнитьКолонку(Строка, Колонки, "Количество", 1);
	ЗаполнитьКолонку(Строка, Колонки, "КоличествоУпаковок", 1);
	ЗаполнитьКолонку(Строка, Колонки, "Цена", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "ЦенаЗакупочная", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "ЦенаРозничная", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "Сумма", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "СуммаСНДС", Сумма);

КонецПроцедуры

// Добавляет строку в табличную часть акта сверки.
//
// Параметры:
//  Док   - ДокументОбъект - заполняемый образец
//  ИмяТЧ - Строка         - имя табличной части
//
Процедура ДобавитьСтрокуСверки(Док, ИмяТЧ)

	Строка = Док[ИмяТЧ].Добавить();
	Строка.Дата = Док.Дата;
	Строка.Договор = Док.Договор;
	Строка.ДокументПредставление = ПометкаОбразца();
	Строка.Дебет = СуммаОбразца();

КонецПроцедуры

// Добавляет строку сотрудника в ведомость.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый образец
//
Процедура ДобавитьСтрокуСотрудника(Док)

	Строка = Док.ТЧСотрудники.Добавить();
	Строка.Сотрудник = ПервыйЭлемент("ФизическиеЛица");
	Строка.Сумма = СуммаОбразца();
	Док.Сумма = СуммаОбразца();

КонецПроцедуры

// Добавляет строку табеля: сотрудник, график и отработанные часы первых дней месяца.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый образец
//
Процедура ДобавитьСтрокуТабеля(Док)

	Строка = Док.ТЧТабель.Добавить();
	Строка.Сотрудник = ПервыйЭлемент("ФизическиеЛица");
	Строка.ГрафикРаботы = ПервыйЭлемент("ГрафикиРаботыСотрудников");
	Часов = ЧасовВСмене();
	Колонки = Док.Метаданные().ТабличныеЧасти.ТЧТабель.Реквизиты;
	ДнейВОбразце = 5;
	Для Номер = 1 По ДнейВОбразце Цикл
		ИмяКолонкиДня = "_" + Формат(Номер, "ЧГ=0");
		ЗаполнитьКолонку(Строка, Колонки, ИмяКолонкиДня, Часов);
	КонецЦикла;

КонецПроцедуры

// Заводит запись регистра лидов: печать лида формируется по связанному заказу покупателя.
//
// Возвращаемое значение:
//  Строка - представление созданного образца для отчёта
//
Функция СоздатьЛид()

	Заказ = ПервыйДокумент("ЗаказПокупателя");
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		ВызватьИсключение НСтр("ru = 'В базе нет ни одного заказа покупателя: лид печатается по заказу';
			|fr = 'La base ne contient aucune commande client : le lead s''imprime à partir d''une commande';
			|en = 'There is no customer order in the database: the lead is printed from an order';
			|es = 'La base no contiene ningún pedido de cliente: el lead se imprime a partir de un pedido'");
	КонецЕсли;

	Запись = РегистрыСведений.Лиды.СоздатьМенеджерЗаписи();
	Запись.ДатаСоздания = ТекущаяДатаСеанса();
	Запись.Канал = ПервыйЭлемент("Каналы");
	Запись.ПолноеИмя = ПометкаОбразца();
	Запись.Клиент = Заказ.Контрагент;
	Запись.ЗаказПокупателя = Заказ;
	Запись.Комментарий = ПометкаОбразца();
	Запись.Статус = Перечисления.СтатусыЛидов.Новый;
	Запись.Сумма = Заказ.Сумма;
	Запись.Записать();

	Возврат "" + Заказ + ";запись регистра";

КонецФункции

// Записывает значение в колонку строки табличной части, если такая колонка есть.
//
// Параметры:
//  Строка   - СтрокаТабличнойЧасти - заполняемая строка
//  Колонки  - КоллекцияОбъектовМетаданных - реквизиты табличной части
//  ИмяКолонки - Строка - имя колонки
//  Значение - Произвольный - записываемое значение
//
Процедура ЗаполнитьКолонку(Строка, Колонки, ИмяКолонки, Значение)

	Если Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
		Строка[ИмяКолонки] = Значение;
	КонецЕсли;

КонецПроцедуры

// Есть ли у справочника группы - от этого зависит условие отбора элемента.
//
// Параметры:
//  ОписаниеСправочника - ОбъектМетаданныхСправочник - описание справочника
//
// Возвращаемое значение:
//  Булево - Истина, если справочник иерархический с группами
//
Функция ЭтоСправочникСГруппами(ОписаниеСправочника)

	Возврат ОписаниеСправочника.Иерархический
		И ОписаниеСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;

КонецФункции

// Контрагент вместе с его договором: первым выбирается договор, поэтому пара заведомо
// согласована - у документа не окажется договора чужого контрагента.
//
// Возвращаемое значение:
//  Структура - пара для заполнения образца:
//   * Контрагент - СправочникСсылка.Контрагенты
//   * Договор    - СправочникСсылка.ДоговорыСКонтрагентами
//
Функция КонтрагентСДоговором()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договоры.Ссылка КАК Договор,
		|	Договоры.Контрагент КАК Контрагент
		|ИЗ
		|	Справочник.ДоговорыСКонтрагентами КАК Договоры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО Договоры.Контрагент = Контрагенты.Ссылка
		|ГДЕ
		|	НЕ Договоры.ПометкаУдаления
		|	И НЕ Контрагенты.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Контрагент, Договор", Выборка.Контрагент, Выборка.Договор);
	КонецЕсли;

	Возврат Новый Структура("Контрагент, Договор",
		ПервыйЭлемент("Контрагенты"), Справочники.ДоговорыСКонтрагентами.ПустаяСсылка());

КонецФункции

// Последний документ указанного вида - образцу нужен уже существующий документ-основание.
//
// Параметры:
//  ИмяДокумента - Строка - имя объекта метаданных
//
// Возвращаемое значение:
//  ДокументСсылка - документ либо пустая ссылка
//
Функция ПервыйДокумент(ИмяДокумента)

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	&ИмяТаблицы КАК Таблица
		|УПОРЯДОЧИТЬ ПО
		|	Таблица.Дата УБЫВ";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", "Документ." + ИмяДокумента);

	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Документы[ИмяДокумента].ПустаяСсылка();

КонецФункции

// Пометка, по которой видно, что объект заведён автотестом.
//
// Возвращаемое значение:
//  Строка - текст пометки
//
Функция ПометкаОбразца()

	Возврат "Образец автотеста";

КонецФункции

// Сумма и цена в образце: печати важен не размер суммы, а то, что она заполнена.
//
// Возвращаемое значение:
//  Число - сумма образца
//
Функция СуммаОбразца()

	Возврат 100;

КонецФункции

// Отработанные часы в дне табеля-образца.
//
// Возвращаемое значение:
//  Число - часов в смене
//
Функция ЧасовВСмене()

	Возврат 8;

КонецФункции

#Область ДемоНабор

#Область Прогон

// Код блока ядра: производственный контур 2mzl и торговля.
//
// Возвращаемое значение:
//  Строка - код блока
//
Функция БлокЯдра()

	Возврат "CORE";

КонецФункции

// Код блока учёта станков.
//
// Возвращаемое значение:
//  Строка - код блока
//
Функция БлокСтанков()

	Возврат "M";

КонецФункции

// Коды кейсов блока в порядке создания: кейсы ядра связаны остатками и FIFO, порядок менять нельзя (P1 - до закупок
// на склад, P11 - строго последним).
//
// Параметры:
//  Блок - Строка - код блока
//
// Возвращаемое значение:
//  Массив из Строка - коды кейсов
//
Функция КодыКейсовБлока(Блок)

	Если Блок = БлокСтанков() Тогда
		Возврат СтрРазделить("M", ",");
	КонецЕсли;
	Возврат СтрРазделить("P1,R1,P2,P3,P4,P5,P6,P7,P8,P9,P10,T,S1,S2,S3,S4,S5,S6,S7,R,C,L,Z,P11", ",");

КонецФункции

Функция НовыйИтогДемоНабора()

	Итог = Новый Структура("Строки, Создано, Ошибок, Было, Переиспользовано, Неполных, Пропущено");
	Итог.Строки = Новый Массив;
	Итог.Создано = 0;
	Итог.Ошибок = 0;
	Итог.Было = 0;
	Итог.Переиспользовано = 0;
	Итог.Неполных = 0;
	Итог.Пропущено = 0;
	Возврат Итог;

КонецФункции

// Состояние прогона набора.
//
// Параметры:
//  Начало              - Дата - дата первого документа
//  Суффикс             - Строка - суффикс наименований и ключей
//  Итог                - Структура - см. НовыйИтогДемоНабора
//  ОтдельныеТранзакции - Булево - каждый кейс в своей транзакции верхнего уровня (кнопка и fixtures.sh); Ложь - всё
//                        в транзакции вызывающего, ошибка кейса - исключение (сценарии уровня 3)
//  ТестоваяБаза        - Булево - см. НовыеПараметрыДемоНабора
//
// Возвращаемое значение:
//  Структура - прогон
//
Функция НовыйПрогон(Начало, Суффикс, Итог, ОтдельныеТранзакции, ТестоваяБаза)

	Прогон = Новый Структура;
	Прогон.Вставить("Начало", Начало);
	Прогон.Вставить("Суффикс", Суффикс);
	Прогон.Вставить("Итог", Итог);
	Прогон.Вставить("ОтдельныеТранзакции", ОтдельныеТранзакции);
	Прогон.Вставить("ТестоваяБаза", ТестоваяБаза);
	Прогон.Вставить("Контекст", Неопределено);
	Возврат Прогон;

КонецФункции

// Справочники и блоки набора по порядку.
//
// Параметры:
//  Прогон - Структура - см. НовыйПрогон
//  Блоки  - Строка - блоки через запятую
//
// Возвращаемое значение:
//  Соответствие - код кейса - Структура кейса; только созданные и переиспользованные кейсы
//
Функция ВыполнитьБлоки(Прогон, Блоки)

	Кейсы = Новый Соответствие;
	Контекст = Обработки.ТестыДокументов.НовыйКонтекстДанных(Прогон.Начало, ПометкаДемоНабора());
	Контекст.Вставить("ШагСекунд", ШагДемоНабора());
	Контекст.Вставить("Суффикс", Прогон.Суффикс);
	Контекст.Вставить("Блок", "");
	Контекст.Вставить("Код", "");
	Контекст.Вставить("НомерВКейсе", 0);
	Контекст.Вставить("СтарыйНабор", Ложь);
	Прогон.Контекст = Контекст;

	Если Не ПодготовитьСправочники(Прогон) Тогда
		Возврат Кейсы;
	КонецЕсли;

	Для Каждого Блок Из СтрРазделить(СтрЗаменить(Блоки, " ", ""), ",", Ложь) Цикл
		Если Блок = БлокЯдра() Тогда
			ВыполнитьЯдро(Прогон, Кейсы);
		ИначеЕсли Блок = БлокСтанков() Тогда
			ВыполнитьБлокСтанков(Прогон, Кейсы);
		Иначе
			ВызватьИсключение "Неизвестный блок демо-набора: " + Блок;
		КонецЕсли;
	КонецЦикла;

	ПроверитьДатыПрогона(Прогон);
	Возврат Кейсы;

КонецФункции

// Первая транзакция прогона: повторная проверка демо-базы под блокировкой набора, справочники ядра и признак поколения.
//
// Параметры:
//  Прогон - Структура - см. НовыйПрогон
//
// Возвращаемое значение:
//  Булево - справочники готовы; Ложь - отказ или ошибка, строка уже в итоге
//
Функция ПодготовитьСправочники(Прогон)

	Если Не Прогон.ОтдельныеТранзакции Тогда
		ЗаполнитьСправочникиДемоНабора(Прогон.Контекст);
		Возврат Истина;
	КонецЕсли;

	Итог = Прогон.Итог;
	ПолучитьСообщенияПользователю(Истина);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДемоНабор();
		Рабочий = РабочийДокументБазы(Прогон.ТестоваяБаза);
		Если Рабочий = Неопределено Тогда
			ЗаполнитьСправочникиДемоНабора(Прогон.Контекст);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		// После исключения во вложенной записи транзакция годится только для отката: к базе до отката не обращаемся.
		ОтменитьТранзакцию();
		Описание = ОписаниеОшибкиСтрокой() + Обработки.ТестыДокументов.СообщенияПользователю();
		Итог.Ошибок = Итог.Ошибок + 1;
		Итог.Строки.Добавить("ОШИБКА;Справочники;" + Описание);
		Возврат Ложь;
	КонецПопытки;

	Если Рабочий <> Неопределено Тогда
		ДобавитьОтказ(Итог, Рабочий);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Кейсы ядра. Старый набор (маркер есть, признака поколения нет) переиспользуется целиком и не дополняется.
//
// Параметры:
//  Прогон - Структура - см. НовыйПрогон
//  Кейсы  - Соответствие - см. ВыполнитьБлоки
//
Процедура ВыполнитьЯдро(Прогон, Кейсы)

	Итог = Прогон.Итог;
	Если Не Константы.ИспользоватьПроизводство.Получить() Тогда
		Итог.Пропущено = Итог.Пропущено + 1;
		Текст = НСтр("ru = 'производство выключено'; fr = 'la production est désactivée';
			|en = 'production is turned off'; es = 'la producción está desactivada'");
		Итог.Строки.Добавить("ПРОПУСК;" + БлокЯдра() + ";" + Текст);
		Возврат;
	КонецЕсли;
	Если Прогон.Контекст.СтарыйНабор Тогда
		Итог.Переиспользовано = Итог.Переиспользовано + 1;
		Текст = НСтр("ru = 'старый набор - переиспользован целиком';
			|fr = 'ancien jeu - réutilisé en entier'; en = 'old set - reused as a whole'; es = 'conjunto antiguo - reutilizado completo'");
		Итог.Строки.Добавить("ПЕРЕИСПОЛЬЗОВАН;" + БлокЯдра() + ";" + Текст);
		Возврат;
	КонецЕсли;
	Для Каждого Код Из КодыКейсовБлока(БлокЯдра()) Цикл
		ВыполнитьКейсПрогона(Прогон, Кейсы, БлокЯдра(), Код);
	КонецЦикла;

КонецПроцедуры

// Блок учёта станков: один атомарный кейс M.
//
// Параметры:
//  Прогон - Структура - см. НовыйПрогон
//  Кейсы  - Соответствие - см. ВыполнитьБлоки
//
Процедура ВыполнитьБлокСтанков(Прогон, Кейсы)

	Итог = Прогон.Итог;
	Если Не Константы.ИспользоватьПроизводство.Получить() Или Не Константы.ИспользоватьУчетСтанков.Получить() Тогда
		Итог.Пропущено = Итог.Пропущено + 1;
		Текст = НСтр("ru = 'учёт станков или производство выключены';
			|fr = 'le suivi des machines ou la production est désactivé'; en = 'machine tracking or production is turned off';
			|es = 'el control de máquinas o la producción está desactivado'");
		Итог.Строки.Добавить("ПРОПУСК;" + БлокСтанков() + ";" + Текст);
		Возврат;
	КонецЕсли;
	ВыполнитьКейсПрогона(Прогон, Кейсы, БлокСтанков(), "M");

КонецПроцедуры

// Кейс в своей транзакции верхнего уровня (кнопка и fixtures.sh) или в транзакции вызывающего (сценарии уровня 3).
//
// Параметры:
//  Прогон - Структура - см. НовыйПрогон
//  Кейсы  - Соответствие - см. ВыполнитьБлоки
//  Блок   - Строка - код блока
//  Код    - Строка - код кейса
//
Процедура ВыполнитьКейсПрогона(Прогон, Кейсы, Блок, Код)

	Если Не Прогон.ОтдельныеТранзакции Тогда
		// Ошибка кейса уходит исключением вызывающему: его транзакция пригодна только для отката.
		Результат = ВыполнитьКейс(Прогон, Кейсы, Блок, Код);
		ЗаписатьРезультатКейса(Прогон, Кейсы, Код, Результат);
		Возврат;
	КонецЕсли;

	ПолучитьСообщенияПользователю(Истина);
	Результат = Неопределено;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДемоНабор();
		Результат = ВыполнитьКейс(Прогон, Кейсы, Блок, Код);
		// Пропуск выясняется и после записи справочников кейса (блок M): их откатываем, чтобы повтор начал с нуля.
		Если Результат.Вид = "ПРОПУСК" Тогда
			ВызватьИсключение Результат.Текст;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Если Результат <> Неопределено И Результат.Вид = "ПРОПУСК" Тогда
			ЗаписатьРезультатКейса(Прогон, Кейсы, Код, Результат);
			Возврат;
		КонецЕсли;
		Описание = ОписаниеОшибкиСтрокой() + Обработки.ТестыДокументов.СообщенияПользователю();
		Итог = Прогон.Итог;
		Итог.Ошибок = Итог.Ошибок + 1;
		Итог.Строки.Добавить("ОШИБКА;" + Код + ";" + Описание);
		Возврат;
	КонецПопытки;
	ЗаписатьРезультатКейса(Прогон, Кейсы, Код, Результат);

КонецПроцедуры

// Кейс по правилу атомарности: все документы по ключам есть - переиспользован; ни одного - предусловия и создание;
// часть - неполный, ничего не трогается.
//
// Параметры:
//  Прогон - Структура - см. НовыйПрогон
//  Кейсы  - Соответствие - см. ВыполнитьБлоки
//  Блок   - Строка - код блока
//  Код    - Строка - код кейса
//
// Возвращаемое значение:
//  Структура - Вид (СОЗДАН, ПЕРЕИСПОЛЬЗОВАН, НЕПОЛНЫЙ, ПРОПУСК), Текст, Кейс
//
Функция ВыполнитьКейс(Прогон, Кейсы, Блок, Код)

	Контекст = Прогон.Контекст;
	Описание = ОписаниеКейса(Код);
	Найдено = НайтиДокументыКейса(Контекст, Блок, Код, Описание.Документов);
	Помеченных = 0;
	Для Каждого Элемент Из Найдено Цикл
		// Ключ, найденный у нескольких документов, - тоже «неполный»: какой из них настоящий, набор не решает.
		Если Элемент.Значение.ПометкаУдаления Или Элемент.Значение.Повторов <> 1 Тогда
			Помеченных = Помеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если Найдено.Количество() = Описание.Документов И Помеченных = 0 Тогда
		Возврат РезультатКейса("ПЕРЕИСПОЛЬЗОВАН", Описание.Текст, КейсИзНайденного(Контекст, Код, Описание, Найдено));
	КонецЕсли;
	Если Найдено.Количество() > 0 Тогда
		Возврат РезультатКейса("НЕПОЛНЫЙ", ТекстНеполногоКейса(Описание, Найдено, Помеченных), Неопределено);
	КонецЕсли;

	Причина = ПредусловиеКейса(Контекст, Кейсы, Код);
	Если Не ПустаяСтрока(Причина) Тогда
		Возврат РезультатКейса("ПРОПУСК", Причина, Неопределено);
	КонецЕсли;

	Контекст.Блок = Блок;
	Контекст.Код = Код;
	Контекст.НомерВКейсе = 0;
	Кейс = СоздатьКейс(Контекст, Кейсы, Код);
	Если ТипЗнч(Кейс) = Тип("Строка") Тогда
		Возврат РезультатКейса("ПРОПУСК", Кейс, Неопределено);
	КонецЕсли;
	ПроверитьДокументыКейса(Контекст, Блок, Код, Описание.Документов);
	Кейс.Описание = Описание.Текст;
	Возврат РезультатКейса("СОЗДАН", Описание.Текст, Кейс);

КонецФункции

Функция РезультатКейса(Вид, Текст, Кейс)

	Возврат Новый Структура("Вид, Текст, Кейс", Вид, Текст, Кейс);

КонецФункции

// Строки итога и кейс в соответствие - после фиксации транзакции кейса.
//
// Параметры:
//  Прогон    - Структура - см. НовыйПрогон
//  Кейсы     - Соответствие - см. ВыполнитьБлоки
//  Код       - Строка - код кейса
//  Результат - Структура - см. ВыполнитьКейс
//
Процедура ЗаписатьРезультатКейса(Прогон, Кейсы, Код, Результат)

	Итог = Прогон.Итог;
	Итог.Строки.Добавить(Результат.Вид + ";" + Код + ";" + Результат.Текст);
	Если Результат.Вид = "СОЗДАН" Тогда
		Итог.Создано = Итог.Создано + 1;
		Кейсы.Вставить(Код, Результат.Кейс);
		ДобавитьСсылкиКейса(Итог.Строки, Код, Результат.Кейс);
		Если Результат.Кейс.Свойство("Инфо") И Не ПустаяСтрока(Результат.Кейс.Инфо) Тогда
			Итог.Строки.Добавить("ИНФО;" + Код + ";" + Результат.Кейс.Инфо);
		КонецЕсли;
	ИначеЕсли Результат.Вид = "ПЕРЕИСПОЛЬЗОВАН" Тогда
		Итог.Переиспользовано = Итог.Переиспользовано + 1;
		Кейсы.Вставить(Код, Результат.Кейс);
	ИначеЕсли Результат.Вид = "НЕПОЛНЫЙ" Тогда
		Итог.Неполных = Итог.Неполных + 1;
	Иначе
		Итог.Пропущено = Итог.Пропущено + 1;
	КонецЕсли;

КонецПроцедуры

// Исключительная управляемая блокировка набора: сериализует только запуски генератора. Блокировки регистров берут сами
// документы при проведении, в своём порядке.
//
Процедура ЗаблокироватьДемоНабор()

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Константа.ИспользоватьАвтовыпускПриОтгрузке");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

// Константы опций, которые администратор разрешил включить, - до транзакций, со сбросом кэша опций.
//
// Параметры:
//  Параметры - Структура - см. НовыеПараметрыДемоНабора
//  Итог      - Структура - см. НовыйИтогДемоНабора
//
Процедура ВключитьОпцииДемоНабора(Параметры, Итог)

	Изменены = Ложь;
	Если Параметры.ВключитьПроизводство И Не Константы.ИспользоватьПроизводство.Получить() Тогда
		Константы.ИспользоватьПроизводство.Установить(Истина);
		Итог.Строки.Добавить("НАСТРОЙКА;ИспользоватьПроизводство;включена");
		Изменены = Истина;
	КонецЕсли;
	Если Параметры.ВключитьАвтовыпуск И Не Константы.ИспользоватьАвтовыпускПриОтгрузке.Получить() Тогда
		Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
		Итог.Строки.Добавить("НАСТРОЙКА;ИспользоватьАвтовыпускПриОтгрузке;включена");
		Изменены = Истина;
	КонецЕсли;
	Если Параметры.ВключитьУчетСтанков И Не Константы.ИспользоватьУчетСтанков.Получить() Тогда
		Константы.ИспользоватьУчетСтанков.Установить(Истина);
		Итог.Строки.Добавить("НАСТРОЙКА;ИспользоватьУчетСтанков;включена");
		Изменены = Истина;
	КонецЕсли;
	Если Изменены Тогда
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;

КонецПроцедуры

// Даты прогона не ушли во вчерашний день и не дошли до текущего момента.
//
// Параметры:
//  Прогон - Структура - см. НовыйПрогон
//
Процедура ПроверитьДатыПрогона(Прогон)

	Контекст = Прогон.Контекст;
	Сейчас = ТекущаяДатаСеанса();
	Если НачалоДня(Сейчас) <> НачалоДня(Прогон.Начало) Тогда
		Текст = НСтр("ru = 'Демо-набор заполнялся через полночь: документы попали бы во вчерашний день. Запустите позже.';
			|fr = 'Le jeu de démonstration a franchi minuit : les documents tomberaient sur la veille. Relancez plus tard.';
			|en = 'The demo set crossed midnight: documents would fall on the previous day. Run it later.';
			|es = 'El conjunto de demostración cruzó la medianoche: los documentos caerían en el día anterior. Ejecútelo más tarde.'");
	ИначеЕсли Контекст.Дата + Контекст.Шаг >= Сейчас Тогда
		Шаблон = НСтр("ru = 'Документы демо-набора дошли до текущего момента: увеличьте длительность набора (%1 с).';
			|fr = 'Les documents de démonstration atteignent l''instant présent : augmentez la durée du jeu (%1 s).';
			|en = 'Demo set documents reached the current moment: increase the set duration (%1 s).';
			|es = 'Los documentos de demostración llegaron al momento actual: aumente la duración del conjunto (%1 s).'");
		Текст = СтрШаблон(Шаблон, ДлительностьДемоНабора());
	Иначе
		Возврат;
	КонецЕсли;
	Если Не Прогон.ОтдельныеТранзакции Тогда
		ВызватьИсключение Текст;
	КонецЕсли;
	Прогон.Итог.Ошибок = Прогон.Итог.Ошибок + 1;
	Прогон.Итог.Строки.Добавить("ОШИБКА;Демо-набор;" + Текст);

КонецПроцедуры

// Демо-набор пишет данные и включает опции: только администратору, на любом пути вызова (кнопка, fixtures.sh через
// СмокТест, сценарии уровня 3).
//
Процедура ПроверитьПравоДемоНабора()

	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Заполнить демо-данными может только администратор.';
			|fr = 'Seul l''administrateur peut remplir avec des données de démonstration.';
			|en = 'Only the administrator can fill with demo data.';
			|es = 'Solo el administrador puede llenar con datos de demostración.'");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОтказ(Итог, Рабочий)

	Итог.Ошибок = 1;
	Итог.Строки.Добавить("ОТКАЗ;Демо-набор;" + ТекстОтказаДемоНабора(Рабочий));

КонецПроцедуры

Функция ОписаниеОшибкиСтрокой()

	// BSLLS:DeprecatedMethodCall-off
	Возврат СтрЗаменить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, " | ");
	// BSLLS:DeprecatedMethodCall-on

КонецФункции

#КонецОбласти

#Область ПроверкаДемоБазы

// Запрос первого рабочего документа одного вида, см. РабочийДокументБазы.
//
// Параметры:
//  ОписаниеДокумента - ОбъектМетаданных - документ
//  ТестоваяБаза      - Булево - виды без комментария не проверяются
//  ОтборСсылки       - Булево - добавить отбор по параметру &Ссылка
//
// Возвращаемое значение:
//  Строка - текст запроса пакета; пустая строка - вид не проверяется
//
Функция ТекстПоискаРабочегоДокумента(ОписаниеДокумента, ТестоваяБаза, ОтборСсылки)

	Имя = ОписаниеДокумента.Имя;
	Реквизиты = ОписаниеДокумента.Реквизиты;
	Условия = Новый Массив;
	Если Реквизиты.Найти("Комментарий") <> Неопределено Тогда
		Условия.Добавить("НЕ (ВЫРАЗИТЬ(Д.Комментарий КАК СТРОКА(100)) ПОДОБНО ""Démo 2mzl%""
			|		ИЛИ ВЫРАЗИТЬ(Д.Комментарий КАК СТРОКА(100)) ПОДОБНО ""Образец автотеста%""
			|		ИЛИ ВЫРАЗИТЬ(Д.Комментарий КАК СТРОКА(100)) ПОДОБНО ""Тест уровня 3%"")");
	ИначеЕсли ТестоваяБаза Тогда
		Возврат "";
	ИначеЕсли Имя = "ЗаявкаНаПоискТовара" Тогда
		Условия.Добавить("НЕ (Д.Артикул ПОДОБНО ""Démo 2mzl%""
			|		ИЛИ Д.Контрагент.Наименование ПОДОБНО ""Démo 2mzl - %""
			|			И ВЫРАЗИТЬ(Д.Описание КАК СТРОКА(100)) В (&СтарыеЗаявки))");
	Иначе
		// Вид без комментария, кроме заявок набора, - рабочий целиком: отбора нет.
		Условия.Добавить("ИСТИНА");
	КонецЕсли;
	Если Реквизиты.Найти("СозданАвтоматически") <> Неопределено Тогда
		Условия.Добавить("НЕ Д.СозданАвтоматически");
	КонецЕсли;
	Если Имя = "ВыпускПродукции" Тогда
		Условия.Добавить("Д.Требование = ЗНАЧЕНИЕ(Документ.ТребованиеНакладная.ПустаяСсылка)");
	КонецЕсли;
	Если ОтборСсылки Тогда
		Условия.Добавить("Д.Ссылка = &Ссылка");
	КонецЕсли;
	Если Имя = "ТехнологическаяКарта" Тогда
		Условия.Добавить("НЕ (Д.Номенклатура.Артикул ПОДОБНО ""DEMO-2MZL%""
			|		ИЛИ Д.Номенклатура.Единица.Наименование ПОДОБНО ""pce (Démo)%"")");
	КонецЕсли;

	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	""" + Имя + """ КАК Вид,
		|	Д.Номер КАК Номер,
		|	Д.Дата КАК Дата
		|ИЗ
		|	Документ." + Имя + " КАК Д";
	Если Условия.Количество() > 0 Тогда
		Текст = Текст + "
			|ГДЕ
			|	" + СтрСоединить(Условия, Символы.ПС + "	И ");
	КонецЕсли;
	Возврат Текст;

КонецФункции

