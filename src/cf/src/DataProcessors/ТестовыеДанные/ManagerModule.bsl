КонецФункции

Функция ШагДемоНабора()

	// BSLLS:MagicNumber-off - две секунды между документами контура (E9): автовыпуск датируется на секунду раньше реализации.
	Возврат 2;
	// BSLLS:MagicNumber-on

КонецФункции

Функция ДлительностьДемоНабора()

	// BSLLS:MagicNumber-off - 15 минут: около сотни документов по две секунды с запасом.
	Возврат 900;
	// BSLLS:MagicNumber-on

КонецФункции

// Навигационные ссылки документов и элементов кейса - строками отчёта ССЫЛКА;<код>;<поле>;<ссылка>.
//
// Параметры:
//  Строки - Массив из Строка - строки отчёта
//  Код    - Строка - код кейса
//  Кейс   - Структура - см. НовыйКейс
//
Процедура ДобавитьСсылкиКейса(Строки, Код, Кейс)

	Для Каждого Поле Из Кейс Цикл
		Значения = Новый Массив;
		Если ТипЗнч(Поле.Значение) = Тип("Массив") Тогда
			Значения = Поле.Значение;
		Иначе
			Значения.Добавить(Поле.Значение);
		КонецЕсли;
		Для Каждого Значение Из Значения Цикл
			Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) И ЗначениеЗаполнено(Значение) Тогда
				Строки.Добавить("ССЫЛКА;" + Код + ";" + Поле.Ключ + ";" + ПолучитьНавигационнуюСсылку(Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Новый кейс: описание и заказ; прочие документы кейса добавляются полями.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя, Неопределено - заказ кейса
//
// Возвращаемое значение:
//  Структура - кейс с полями Описание и Заказ
//
Функция НовыйКейс(Заказ = Неопределено)

	Возврат Новый Структура("Описание, Заказ", "", Заказ);

КонецФункции

// Справочники ядра - найти или создать по ключам: единица, склад, касса, счёт, контрагенты с договорами, номенклатура
// с ценами и техкартами. Признак поколения пишется в комментарий маркера, если это не старый набор.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки; пополняется полями Единица, Склад, Касса, Счет, Участники, Номенклатура,
//             ЦеныПродажи, ЦеныЗакупки, СтарыйНабор
//
Процедура ЗаполнитьСправочникиДемоНабора(Контекст)

	Маркер = НайтиЭлементДемо("Контрагенты", Новый Структура("Наименование", ИмяМаркераДемоНабора() + Контекст.Суффикс));
	Если Маркер <> Неопределено Тогда
		Комментарий = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Маркер, "Комментарий");
		Контекст.СтарыйНабор = СтрНайти(Комментарий, ПризнакПоколения(Контекст)) = 0;
	КонецЕсли;

	Контекст.Вставить("Единица", ДемоЕдиница(Контекст, "pce (Démo)", Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук));
	Контекст.Вставить("Склад", ДемоМестоХранения(Контекст, "Atelier"));

	Отбор = Новый Структура("Владелец, Наименование", Контекст.Организация, ИмяДемо(Контекст, "Caisse"));
	Касса = НайтиЭлементДемо("Кассы", Отбор);
	Если Касса = Неопределено Тогда
		КассаОбъект = Справочники.Кассы.СоздатьЭлемент();
		КассаОбъект.Владелец = Контекст.Организация;
		КассаОбъект.Наименование = Отбор.Наименование;
		КассаОбъект.Валюта = Контекст.Валюта;
		КассаОбъект.МестоХранения = Контекст.Склад;
		КассаОбъект.Записать();
		Касса = КассаОбъект.Ссылка;
	КонецЕсли;
	Контекст.Вставить("Касса", Касса);

	Отбор = Новый Структура("Владелец, Наименование", Контекст.Организация, ИмяДемо(Контекст, "Banque"));
	Счет = НайтиЭлементДемо("БанковскиеСчета", Отбор);
	Если Счет = Неопределено Тогда
		СчетОбъект = Справочники.БанковскиеСчета.СоздатьЭлемент();
		СчетОбъект.Владелец = Контекст.Организация;
		СчетОбъект.Наименование = Отбор.Наименование;
		СчетОбъект.Валюта = Контекст.Валюта;
		// BSLLS:YoLetterUsage-off
		СчетОбъект.НомерСчёта = "DEMO-2MZL";
		СчетОбъект.ТипСчёта = Перечисления.ТипыБанковскихСчетов.Расчетный;
		// BSLLS:YoLetterUsage-on
		СчетОбъект.Банк = ПервыйЭлемент("Банки");
		СчетОбъект.Записать();
		Счет = СчетОбъект.Ссылка;
	КонецЕсли;
	Контекст.Вставить("Счет", Счет);

	Участники = Новый Структура;
	// Маркер набора - первым: новому маркеру сразу пишется признак поколения.
	Участники.Вставить("Atlas", ДемоУчастник(Контекст, "Café Atlas", Истина, Ложь, "DEMO01"));
	Участники.Вставить("Riad", ДемоУчастник(Контекст, "Riad Andalous", Истина, Ложь, "DEMO02"));
	Участники.Вставить("Majorelle", ДемоУчастник(Контекст, "Hôtel Majorelle", Истина, Ложь, "DEMO03"));
	Участники.Вставить("Bois", ДемоУчастник(Контекст, "Bois & Métal SARL", Ложь, Ложь, "DEMO04"));
	Участники.Вставить("Casa", ДемоУчастник(Контекст, "Luminaires Casa", Ложь, Ложь, "DEMO05"));
	Участники.Вставить("Textiles", ДемоУчастник(Контекст, "Textiles du Nord", Ложь, Истина, "DEMO06"));
	Контекст.Вставить("Участники", Участники);

	ЗаполнитьНоменклатуруДемоНабора(Контекст);

КонецПроцедуры

// Номенклатура ядра, цены и техкарты. Карта пишется только только что созданной позиции.
//
// Параметры:
//  Контекст - Структура - см. ЗаполнитьСправочникиДемоНабора
//
Процедура ЗаполнитьНоменклатуруДемоНабора(Контекст)

	Типы = Перечисления.ТипыНоменклатуры;
	Способы = Перечисления.СпособыПополненияЗапасов;
	Единица = Контекст.Единица;
	Н = Новый Структура;
	Новые = Новый Структура;
	Позиции = Новый Массив;
	ДобавитьПозициюДемо(Позиции, "Planche", "Planche chêne", Типы.Сырье, Способы.Закупка);
	ДобавитьПозициюДемо(Позиции, "Pied", "Pied acier", Типы.Сырье, Способы.Закупка);
	ДобавитьПозициюДемо(Позиции, "Vernis", "Vernis", Типы.Сырье, Способы.Закупка);
	ДобавитьПозициюДемо(Позиции, "Tissu", "Tissu lin", Типы.Сырье, Способы.Закупка);
	ДобавитьПозициюДемо(Позиции, "Mousse", "Mousse assise", Типы.Сырье, Способы.Закупка);
	ДобавитьПозициюДемо(Позиции, "Table", "Table bistro", Типы.Продукция, Способы.Производство);
	ДобавитьПозициюДемо(Позиции, "Chaise", "Chaise bistro", Типы.Продукция, Способы.Производство);
	ДобавитьПозициюДемо(Позиции, "Banquette", "Banquette sur mesure", Типы.Продукция, Способы.Производство);
	ДобавитьПозициюДемо(Позиции, "Coussin", "Coussin lin", Типы.Полуфабрикат, Способы.Производство);
	ДобавитьПозициюДемо(Позиции, "Lampe", "Lampe suspendue", Типы.Товар, Способы.Закупка);
	Для Каждого Позиция Из Позиции Цикл
		Результат = ДемоНоменклатура(Контекст, Позиция.Ключ, Позиция.Название, Позиция.Тип, Позиция.Способ, Единица);
		Н.Вставить(Позиция.Ключ, Результат.Ссылка);
		Новые.Вставить(Позиция.Ключ, Результат.Создана);
	КонецЦикла;

	ЦеныПродажи = Новый Соответствие;
	ЦеныЗакупки = Новый Соответствие;
	// BSLLS:MagicNumber-off - цены и нормы демо-набора (план .ai/plans/production-2mzl-e11-demo.md, §2).
	ЦеныЗакупки.Вставить(Н.Planche, 12);
	ЦеныЗакупки.Вставить(Н.Pied, 4);
	ЦеныЗакупки.Вставить(Н.Vernis, 30);
	ЦеныЗакупки.Вставить(Н.Tissu, 8);
	ЦеныЗакупки.Вставить(Н.Mousse, 6);
	ЦеныЗакупки.Вставить(Н.Lampe, 350);
	ЦеныПродажи.Вставить(Н.Table, 1200);
	ЦеныПродажи.Вставить(Н.Chaise, 450);
	ЦеныПродажи.Вставить(Н.Banquette, 3500);
	ЦеныПродажи.Вставить(Н.Coussin, 150);
	ЦеныПродажи.Вставить(Н.Lampe, 600);
	Контекст.Вставить("Номенклатура", Н);
	Контекст.Вставить("ЦеныПродажи", ЦеныПродажи);
	Контекст.Вставить("ЦеныЗакупки", ЦеныЗакупки);

	Если Новые.Table Тогда
		ТехнологическиеКарты.ЗаписатьТехкарту(Н.Table,
			СоставДемо(Контекст, Н.Planche, 2, Н.Pied, 4, Н.Vernis, 0.1), Контекст.Дата);
	КонецЕсли;
	Если Новые.Chaise Тогда
		ТехнологическиеКарты.ЗаписатьТехкарту(Н.Chaise,
			СоставДемо(Контекст, Н.Planche, 1, Н.Pied, 4, Н.Vernis, 0.05), Контекст.Дата);
	КонецЕсли;
	Если Новые.Coussin Тогда
		ТехнологическиеКарты.ЗаписатьТехкарту(Н.Coussin,
			СоставДемо(Контекст, Н.Tissu, 1, Н.Mousse, 1), Контекст.Дата);
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецПроцедуры

Процедура ДобавитьПозициюДемо(Позиции, Ключ, Название, Тип, Способ)

	Позиция = Новый Структура;
	Позиция.Вставить("Ключ", Ключ);
	Позиция.Вставить("Название", Название);
	Позиция.Вставить("Тип", Тип);
	Позиция.Вставить("Способ", Способ);
	Позиции.Добавить(Позиция);

КонецПроцедуры

// Наименование справочника набора: префикс, название и суффикс режима проверки.
//
// Параметры:
//  Контекст - Структура - см. ЗаполнитьСправочникиДемоНабора
//  Название - Строка - название без префикса
//
// Возвращаемое значение:
//  Строка - наименование
//
Функция ИмяДемо(Контекст, Название)

	Возврат ПрефиксДемоНабора() + Название + Контекст.Суффикс;

КонецФункции

// Элемент справочника набора по ключу. Найден только помеченный на удаление - исключение: набор не заводит рядом
// второй такой же элемент.
//
// Параметры:
//  ИмяСправочника - Строка - имя справочника
//  Отбор          - Структура - поле - значение; строки сравниваются через ВЫРАЗИТЬ
//
// Возвращаемое значение:
//  СправочникСсылка, Неопределено - элемент; Неопределено - не найден
//
Функция НайтиЭлементДемо(ИмяСправочника, Отбор)

	Условия = Новый Массив;
	Запрос = Новый Запрос;
	Для Каждого Поле Из Отбор Цикл
		Если ТипЗнч(Поле.Значение) = Тип("Строка") Тогда
			Условия.Добавить("ВЫРАЗИТЬ(Т." + Поле.Ключ + " КАК СТРОКА(200)) = &" + Поле.Ключ);
		Иначе
			Условия.Добавить("Т." + Поле.Ключ + " = &" + Поле.Ключ);
		КонецЕсли;
		Запрос.УстановитьПараметр(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	// BSLLS:QueryParseError-off - текст собирается из имени справочника и полей отбора.
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Ссылка,
		|	Т.ПометкаУдаления КАК ПометкаУдаления,
		|	Т.Представление КАК Представление
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Т
		|ГДЕ
		|	" + СтрСоединить(Условия, Символы.ПС + "	И ") + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПометкаУдаления";
	// BSLLS:QueryParseError-on
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Выборка.ПометкаУдаления Тогда
		Шаблон = НСтр("ru = 'Элемент демо-набора «%1» помечен на удаление - снимите пометку или удалите его окончательно и повторите.';
			|fr = 'L''élément de démonstration « %1 » est marqué pour suppression : retirez la marque ou supprimez-le, puis relancez.';
			|en = 'Demo set item ""%1"" is marked for deletion: unmark it or delete it permanently and run again.';
			|es = 'El elemento de demostración «%1» está marcado para eliminar: quite la marca o elimínelo y vuelva a ejecutar.'");
		ВызватьИсключение СтрШаблон(Шаблон, Выборка.Представление);
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

// Единица измерения набора.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Название - Строка - наименование без суффикса
//  Тип      - ПеречислениеСсылка.ТипыИзмеряемыхВеличин - тип
//
// Возвращаемое значение:
//  СправочникСсылка.УпаковкиЕдиницыИзмерения - единица
//
Функция ДемоЕдиница(Контекст, Название, Тип)

	Отбор = Новый Структура("Наименование", Название + Контекст.Суффикс);
	Единица = НайтиЭлементДемо("УпаковкиЕдиницыИзмерения", Отбор);
	Если Единица <> Неопределено Тогда
		Возврат Единица;
	КонецЕсли;
	ЕдиницаОбъект = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	ЕдиницаОбъект.Наименование = Отбор.Наименование;
	ЕдиницаОбъект.ТипИзмеряемойВеличины = Тип;
	ЕдиницаОбъект.Числитель = 1;
	ЕдиницаОбъект.Знаменатель = 1;
	ЕдиницаОбъект.Записать();
	Возврат ЕдиницаОбъект.Ссылка;

КонецФункции

// Место хранения набора.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Название - Строка - название без префикса
//
// Возвращаемое значение:
//  СправочникСсылка.МестаХранения - склад
//
Функция ДемоМестоХранения(Контекст, Название)

	Отбор = Новый Структура("Наименование", ИмяДемо(Контекст, Название));
	Склад = НайтиЭлементДемо("МестаХранения", Отбор);
	Если Склад <> Неопределено Тогда
		Возврат Склад;
	КонецЕсли;
	СкладОбъект = Справочники.МестаХранения.СоздатьЭлемент();
	СкладОбъект.Наименование = Отбор.Наименование;
	СкладОбъект.Записать();
	Возврат СкладОбъект.Ссылка;

КонецФункции

// Контрагент набора с договором по роли: клиенту - договор с покупателем, поставщику и субподрядчику - с поставщиком.
// Найден по наименованию - переиспользуется; договор ищется по контрагенту, виду и описанию.
//
// Параметры:
//  Контекст        - Структура - см. ЗаполнитьСправочникиДемоНабора
//  Название        - Строка - название без префикса
//  ЭтоКлиент       - Булево - покупатель с договором с покупателем; иначе поставщик с договором с поставщиком
//  ЭтоСубподрядчик - Булево - поставщик-переработчик
//  ICE             - Строка - идентификатор компании
//
// Возвращаемое значение:
//  Структура - Ссылка, ДоговорПокупателя, ДоговорПоставщика (пустой, если по роли не нужен)
//
Функция ДемоУчастник(Контекст, Название, ЭтоКлиент, ЭтоСубподрядчик, ICE)

	Наименование = ИмяДемо(Контекст, Название);
	Контрагент = НайтиЭлементДемо("Контрагенты", Новый Структура("Наименование", Наименование));
	Если Контрагент = Неопределено Тогда
		КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
		КонтрагентОбъект.Наименование = Наименование;
		КонтрагентОбъект.НаименованиеПолное = Наименование;
		КонтрагентОбъект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо;
		КонтрагентОбъект.Покупатель = ЭтоКлиент;
		КонтрагентОбъект.Поставщик = Не ЭтоКлиент;
		КонтрагентОбъект.Субподрядчик = ЭтоСубподрядчик;
		КонтрагентОбъект.ICE = ICE;
		Если Наименование = ИмяМаркераДемоНабора() + Контекст.Суффикс Тогда
			КонтрагентОбъект.Комментарий = ПризнакПоколения(Контекст);
		КонецЕсли;
		КонтрагентОбъект.Записать();
		Контрагент = КонтрагентОбъект.Ссылка;
	КонецЕсли;

	Участник = Новый Структура("Ссылка, ДоговорПокупателя, ДоговорПоставщика", Контрагент,
		Справочники.ДоговорыСКонтрагентами.ПустаяСсылка(), Справочники.ДоговорыСКонтрагентами.ПустаяСсылка());
	Если ЭтоКлиент Тогда
		Участник.ДоговорПокупателя = ОсновнойДоговорДемо(Контекст, Контрагент, Перечисления.ВидыДоговоров.СПокупателем,
			"Contrat client");
	Иначе
		Участник.ДоговорПоставщика = ОсновнойДоговорДемо(Контекст, Контрагент, Перечисления.ВидыДоговоров.СПоставщиком,
			"Contrat fournisseur");
	КонецЕсли;
	Возврат Участник;

КонецФункции

Функция ОсновнойДоговорДемо(Контекст, Контрагент, ВидДоговора, Описание)

	Отбор = Новый Структура("Контрагент, ВидДоговора, Описание", Контрагент, ВидДоговора,
		ПометкаДемоНабора() + ": " + Описание + Контекст.Суффикс);
	Договор = НайтиЭлементДемо("ДоговорыСКонтрагентами", Отбор);
	Если Договор <> Неопределено Тогда
		Возврат Договор;
	КонецЕсли;
	ДоговорОбъект = НовыйДоговорДемо(Контекст, Контрагент, ВидДоговора, Перечисления.СтатусыДоговоровКонтрагентов.Действует,
		Описание, Истина);
	ДоговорОбъект.Записать();
	Возврат ДоговорОбъект.Ссылка;

КонецФункции

// Незаписанный договор набора. У договора нет наименования - текст пишется в Описание (tiny1C bsl-008).
//
// Параметры:
//  Контекст    - Структура - см. ЗаполнитьСправочникиДемоНабора
//  Контрагент  - СправочникСсылка.Контрагенты - владелец договора
//  ВидДоговора - ПеречислениеСсылка.ВидыДоговоров - вид
//  Статус      - ПеречислениеСсылка.СтатусыДоговоровКонтрагентов - статус
//  Описание    - Строка - описание договора
//  Основной    - Булево - основной договор контрагента
//
// Возвращаемое значение:
//  СправочникОбъект.ДоговорыСКонтрагентами - договор
//
Функция НовыйДоговорДемо(Контекст, Контрагент, ВидДоговора, Статус, Описание, Основной)

	Договор = Справочники.ДоговорыСКонтрагентами.СоздатьЭлемент();
	Договор.Описание = ПометкаДемоНабора() + ": " + Описание + Контекст.Суффикс;
	Договор.Контрагент = Контрагент;
	Договор.Организация = Контекст.Организация;
	Договор.ВидДоговора = ВидДоговора;
	Договор.Статус = Статус;
	// BSLLS:YoLetterUsage-off - имя реквизита в метаданных.
	Договор.ВалютаВзаиморасчётов = Контекст.Валюта;
	// BSLLS:YoLetterUsage-on
	Договор.ДатаДоговора = НачалоДня(Контекст.Дата);
	Договор.Основной = Основной;
	Возврат Договор;

КонецФункции

// Номенклатура набора: найти по артикулу «DEMO-2MZL-<ключ>», для старого набора - по наименованию и демо-единице
// (тогда артикул дописывается), иначе создать.
//
// Параметры:
//  Контекст         - Структура - см. ЗаполнитьСправочникиДемоНабора
//  Ключ             - Строка - ключ артикула
//  Название         - Строка - наименование без суффикса
//  ТипНоменклатуры  - ПеречислениеСсылка.ТипыНоменклатуры - тип
//  СпособПополнения - ПеречислениеСсылка.СпособыПополненияЗапасов - способ пополнения запаса
//  Единица          - СправочникСсылка.УпаковкиЕдиницыИзмерения - единица
//
// Возвращаемое значение:
//  Структура - Ссылка (СправочникСсылка.Номенклатура), Создана (Булево)
//
Функция ДемоНоменклатура(Контекст, Ключ, Название, ТипНоменклатуры, СпособПополнения, Единица)

	Артикул = "DEMO-2MZL-" + ВРег(Ключ) + Контекст.Суффикс;
	Наименование = Название + Контекст.Суффикс;
	Номенклатура = НайтиЭлементДемо("Номенклатура", Новый Структура("Артикул", Артикул));
	Если Номенклатура <> Неопределено Тогда
		Возврат РезультатНоменклатуры(Номенклатура, Ложь);
	КонецЕсли;
	Отбор = Новый Структура("Наименование, Единица, Артикул", Наименование, Единица, "");
	Номенклатура = НайтиЭлементДемо("Номенклатура", Отбор);
	Если Номенклатура <> Неопределено Тогда
		НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
		НоменклатураОбъект.Артикул = Артикул;
		НоменклатураОбъект.Записать();
		Возврат РезультатНоменклатуры(Номенклатура, Ложь);
	КонецЕсли;

	НоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
	НоменклатураОбъект.Наименование = Наименование;
	НоменклатураОбъект.НаименованиеПолное = Наименование;
	НоменклатураОбъект.Артикул = Артикул;
	НоменклатураОбъект.ТипНоменклатуры = ТипНоменклатуры;
	НоменклатураОбъект.СпособПополнения = СпособПополнения;
	НоменклатураОбъект.Единица = Единица;
	НоменклатураОбъект.СтавкаНДС = Контекст.СтавкаНДС;
	НоменклатураОбъект.Записать();
	Возврат РезультатНоменклатуры(НоменклатураОбъект.Ссылка, Истина);

КонецФункции

Функция РезультатНоменклатуры(Ссылка, Создана)

	Возврат Новый Структура("Ссылка, Создана", Ссылка, Создана);

КонецФункции

// Состав технологической карты из пар «материал, расход на единицу».
//
// Параметры:
//  Контекст  - Структура - см. ЗаполнитьСправочникиДемоНабора
//  Материал1 - СправочникСсылка.Номенклатура - первый материал
//  Расход1   - Число - расход первого материала на единицу
//  Материал2 - СправочникСсылка.Номенклатура - второй материал
//  Расход2   - Число - расход второго материала на единицу
//  Материал3 - СправочникСсылка.Номенклатура, Неопределено - третий материал, необязательный
//  Расход3   - Число - расход третьего материала на единицу
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Упаковка, Количество
//
Функция СоставДемо(Контекст, Материал1, Расход1, Материал2, Расход2, Материал3 = Неопределено, Расход3 = 0)

	Состав = Новый ТаблицаЗначений;
	Состав.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Состав.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Состав.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Состав.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ДобавитьСтрокуСостава(Состав, Материал1, Расход1, Контекст.Единица);
	ДобавитьСтрокуСостава(Состав, Материал2, Расход2, Контекст.Единица);
	Если Материал3 <> Неопределено Тогда
		ДобавитьСтрокуСостава(Состав, Материал3, Расход3, Контекст.Единица);
	КонецЕсли;
	Возврат Состав;

КонецФункции

Процедура ДобавитьСтрокуСостава(Состав, Материал, Расход, Упаковка)

	СтрокаСостава = Состав.Добавить();
	СтрокаСостава.Номенклатура = Материал;
	СтрокаСостава.Упаковка = Упаковка;
	СтрокаСостава.Количество = Расход;

КонецПроцедуры

#КонецОбласти

#Область ПредусловияКейсов

// Предусловие кейса перед созданием: проверка «на момент» по остаткам демо-номенклатуры на складе набора и наличию
// кейсов, на которые ссылается этот.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Кейсы    - Соответствие - см. ВыполнитьБлоки
//  Код      - Строка - код кейса
//
// Возвращаемое значение:
//  Строка - причина пропуска; пустая строка - создавать
//
// BSLLS:CognitiveComplexity-off - линейная таблица предусловий: ветка на кейс.
// BSLLS:CyclomaticComplexity-off - та же причина.
Функция ПредусловиеКейса(Контекст, Кейсы, Код)

	Н = Контекст.Номенклатура;
	// BSLLS:MagicNumber-off - количества кейсов набора.
	Если (Код = "P1" Или Код = "P2") И Не Константы.ИспользоватьАвтовыпускПриОтгрузке.Получить() Тогда
		Возврат НСтр("ru = 'автовыпуск при отгрузке выключен - кейс показывает именно его';
			|fr = 'la production automatique à l''expédition est désactivée - le cas la montre justement';
			|en = 'automatic output on shipment is turned off - the case shows exactly it';
			|es = 'la producción automática al enviar está desactivada - el caso la muestra precisamente'");
	ИначеЕсли Код = "P1" Тогда
		Возврат НетГотовой(Контекст, Н.Table);
	ИначеЕсли Код = "P2" Тогда
		Причина = НетГотовой(Контекст, Н.Chaise);
		Возврат ?(ПустаяСтрока(Причина), ХватаетМатериалов(Контекст, ПродукцияДемо(Н.Chaise, 8)), Причина);
	ИначеЕсли Код = "P10" Тогда
		Продукция = ПродукцияДемо(Н.Table, 2);
		ДобавитьПродукциюДемо(Продукция, Н.Chaise, 4);
		Возврат ХватаетМатериалов(Контекст, Продукция);
	ИначеЕсли Код = "S4" Тогда
		Возврат ХватаетМатериалов(Контекст, ПродукцияДемо(Н.Table, 1));
	ИначеЕсли Код = "S5" Тогда
		Возврат ХватаетМатериалов(Контекст, ПродукцияДемо(Н.Chaise, 2));
	ИначеЕсли Код = "S3" Тогда
		Возврат ХватаетТовара(Контекст, ТоварыДемо(Н.Lampe, 1));
	ИначеЕсли Код = "R" Тогда
		Если Кейсы.Получить("R1") = Неопределено Тогда
			Возврат НетКейса("R1");
		КонецЕсли;
		Возврат ХватаетТовара(Контекст, ТоварыДемо(Н.Lampe, 7));
	ИначеЕсли Код = "S6" Или Код = "S7" Тогда
		Количество = ?(Код = "S6", 3, 2);
		Товары = ТоварыДемо(Н.Tissu, Количество);
		Товары.Вставить(Н.Mousse, Количество);
		Возврат ХватаетТовара(Контекст, Товары);
	ИначеЕсли Код = "L" Тогда
		Для Каждого Нужен Из СтрРазделить("S1,S3", ",") Цикл
			Если Кейсы.Получить(Нужен) = Неопределено Тогда
				Возврат НетКейса(Нужен);
			КонецЕсли;
		КонецЦикла;
		Возврат "";
	Иначе
		Возврат "";
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецФункции
// BSLLS:CyclomaticComplexity-on
// BSLLS:CognitiveComplexity-on

Функция НетКейса(Код)

	Шаблон = НСтр("ru = 'нет кейса %1, на который он ссылается'; fr = 'le cas %1 auquel il fait référence manque';
		|en = 'case %1 it refers to is missing'; es = 'falta el caso %1 al que hace referencia'");
	Возврат СтрШаблон(Шаблон, Код);

КонецФункции

Функция ПродукцияДемо(Номенклатура, Количество)

	Продукция = Новый ТаблицаЗначений;
	Продукция.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Продукция.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Продукция.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Продукция.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число"));
	ДобавитьПродукциюДемо(Продукция, Номенклатура, Количество);
	Возврат Продукция;

КонецФункции

Процедура ДобавитьПродукциюДемо(Продукция, Номенклатура, Количество)

	Строка = Продукция.Добавить();
	Строка.Номенклатура = Номенклатура;
	Строка.Количество = Количество;
	Строка.КоличествоУпаковок = Количество;

КонецПроцедуры

Функция ТоварыДемо(Номенклатура, Количество)

	Товары = Новый Соответствие;
	Товары.Вставить(Номенклатура, Количество);
	Возврат Товары;

КонецФункции

// Готовой продукции на складе набора нет: иначе отгрузка взяла бы её и автовыпуска, ради которого кейс, не было бы.
//
// Параметры:
//  Контекст     - Структура - см. ВыполнитьБлоки
//  Номенклатура - СправочникСсылка.Номенклатура - продукция
//
// Возвращаемое значение:
//  Строка - причина пропуска; пустая строка - готовой нет
//
Функция НетГотовой(Контекст, Номенклатура)

	Остаток = ОстаткиДемо(Контекст, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Номенклатура)).Получить(Номенклатура);
	Если Остаток = Неопределено Или Остаток <= 0 Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'на складе набора есть готовая «%1» (%2) - отгрузка обошлась бы без автовыпуска';
		|fr = 'le stock du jeu contient « %1 » fini (%2) - l''expédition se passerait de la production automatique';
		|en = 'the set warehouse has finished ""%1"" (%2) - the shipment would not need automatic output';
		|es = 'el almacén del conjunto tiene «%1» terminado (%2) - el envío no necesitaría producción automática'");
	Возврат СтрШаблон(Шаблон, Номенклатура, Остаток);

КонецФункции

// Материалов на выпуск продукции по действующим на дату набора картам хватает на складе набора.
//
// Параметры:
//  Контекст  - Структура - см. ВыполнитьБлоки
//  Продукция - ТаблицаЗначений - см. ПродукцияДемо
//
// Возвращаемое значение:
//  Строка - причина пропуска; пустая строка - хватает
//
Функция ХватаетМатериалов(Контекст, Продукция)

	Материалы = ТехнологическиеКарты.РасходПоКартам(Продукция, Контекст.Дата).Материалы;
	Нужно = Новый Соответствие;
	Для Каждого Строка Из Материалы Цикл
		Было = Нужно.Получить(Строка.Номенклатура);
		Нужно.Вставить(Строка.Номенклатура, ?(Было = Неопределено, 0, Было) + Строка.Количество);
	КонецЦикла;
	Возврат ХватаетТовара(Контекст, Нужно);

КонецФункции

// Остатка товаров на складе набора хватает.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Нужно    - Соответствие - номенклатура - количество
//
// Возвращаемое значение:
//  Строка - причина пропуска; пустая строка - хватает
//
Функция ХватаетТовара(Контекст, Нужно)

	Позиции = Новый Массив;
	Для Каждого Элемент Из Нужно Цикл
		Позиции.Добавить(Элемент.Ключ);
	КонецЦикла;
	Остатки = ОстаткиДемо(Контекст, Позиции);
	Для Каждого Элемент Из Нужно Цикл
		Есть = Остатки.Получить(Элемент.Ключ);
		Есть = ?(Есть = Неопределено, 0, Есть);
		Если Есть < Элемент.Значение Тогда
			Шаблон = НСтр("ru = 'не хватает «%1»: нужно %2, на складе набора %3';
				|fr = '« %1 » insuffisant : il faut %2, le stock du jeu a %3';
				|en = 'not enough ""%1"": %2 needed, the set warehouse has %3';
				|es = 'no hay suficiente «%1»: se necesitan %2, el almacén del conjunto tiene %3'");
			Возврат СтрШаблон(Шаблон, Элемент.Ключ, Элемент.Значение, Есть);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Текущие остатки позиций на складе набора.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Позиции  - Массив из СправочникСсылка.Номенклатура - позиции
//
// Возвращаемое значение:
//  Соответствие - номенклатура - количество
//
Функция ОстаткиДемо(Контекст, Позиции)

	Запрос = Новый Запрос("ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	СУММА(Остатки.КоличествоОстаток) КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии.Остатки(, МестоХранения = &Склад И Номенклатура В (&Позиции)) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Номенклатура");
	Запрос.УстановитьПараметр("Склад", Контекст.Склад);
	Запрос.УстановитьПараметр("Позиции", Позиции);
	Остатки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Остатки.Вставить(Выборка.Номенклатура, Выборка.Количество);
	КонецЦикла;
	Возврат Остатки;

КонецФункции

#КонецОбласти

#Область СозданиеКейсов

// Создаёт документы кейса.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Кейсы    - Соответствие - см. ВыполнитьБлоки
//  Код      - Строка - код кейса
//
// Возвращаемое значение:
//  Структура, Строка - кейс; строка - причина пропуска, выясненная по ходу (до записи документов)
//
// BSLLS:CognitiveComplexity-off - линейный диспетчер: ветка на кейс.
// BSLLS:CyclomaticComplexity-off - та же причина.
Функция СоздатьКейс(Контекст, Кейсы, Код)

	Если Код = "P1" Тогда
		Возврат ДемоПодЗаказБезОстатка(Контекст);
	ИначеЕсли Код = "R1" Тогда
		Возврат ДемоЗакупкиНаСклад(Контекст);
	ИначеЕсли Код = "P2" Тогда
		Возврат ДемоИзСвоегоОстатка(Контекст);
	ИначеЕсли Код = "P3" Тогда
		Возврат ДемоРучнойВыпускПоЗаказу(Контекст);
	ИначеЕсли Код = "P4" Тогда
		Возврат ДемоСоставВЗаказе(Контекст);
	ИначеЕсли Код = "P5" Тогда
		Возврат ДемоЗакупкаПришлаЧастично(Контекст);
	ИначеЕсли Код = "P6" Тогда
		Возврат ДемоМатериалыНеЗаказаны(Контекст);
	ИначеЕсли Код = "P7" Тогда
		Возврат ДемоЗакупаемыйТоварВЗаказе(Контекст);
	ИначеЕсли Код = "P8" Тогда
		Возврат ДемоЧерновикЗаказа(Контекст);
	ИначеЕсли Код = "P9" Тогда
		Возврат ДемоЧастичнаяОтгрузка(Контекст);
	ИначеЕсли Код = "P10" Тогда
		Возврат ДемоПроизводствоНаСклад(Контекст);
	ИначеЕсли Код = "T" Тогда
		Возврат ДемоКоммерческиеПредложения(Контекст);
	ИначеЕсли СтрНачинаетсяС(Код, "S") Тогда
		Возврат ДемоЗаказПродажи(Контекст, Код);
	ИначеЕсли Код = "R" Тогда
		Возврат ДемоРеализацииИОплаты(Контекст, Кейсы["R1"]);
	ИначеЕсли Код = "C" Тогда
		Возврат ДемоДоговоры(Контекст);
	ИначеЕсли Код = "L" Тогда
		Возврат ДемоЛиды(Контекст, Кейсы);
	ИначеЕсли Код = "Z" Тогда
		Возврат ДемоЗаявкиНаПоискТовара(Контекст);
	ИначеЕсли Код = "P11" Тогда
		Возврат ДемоНоваяВерсияТехкарты(Контекст);
	ИначеЕсли Код = "M" Тогда
		Возврат ДемоСтанки(Контекст);
	Иначе
		ВызватьИсключение "Неизвестный кейс демо-набора: " + Код;
	КонецЕсли;

КонецФункции
// BSLLS:CyclomaticComplexity-on
// BSLLS:CognitiveComplexity-on

#КонецОбласти

#Область КейсыПроизводства

// P1. Под заказ без своего остатка: КП, заказ на основании КП, закупка по потребности, реализация с автовыпуском из партий
// под заказ, оплата - «Выполнен». Идёт до закупки материалов на склад: общего остатка ещё нет.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Структура - кейс
//
Функция ДемоПодЗаказБезОстатка(Контекст)

	Н = Контекст.Номенклатура;
	Клиент = Контекст.Участники.Atlas;
	// BSLLS:MagicNumber-off - Table 6.
	Предложение = ДемоПредложение(Контекст, Клиент, Н.Table, 6, Перечисления.СтатусыКоммерческихПредложений.Отправлен);
	// BSLLS:MagicNumber-on
	ВыбратьУчастника(Контекст, Клиент);
	Заказ = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "ЗаказПокупателя");
	ДатаЗаказа = Заказ.Дата;
	Заказ.Заполнить(Новый Структура("Предложение, НаПроизводство", Предложение, Истина));
	Заказ.Дата = ДатаЗаказа;
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Если Заказ.ТЧМатериалы.Количество() = 0 Тогда
		ЗаполнитьМатериалыЗаказа(Заказ);
	КонецЕсли;
	ЗаписатьДокументКейса(Контекст, Заказ, Истина);
	ЗаказПоставщику = ДемоЗаказПоставщикуПоПотребности(Контекст, Заказ.Ссылка, Контекст.Участники.Bois);
	ДемоПоступлениеПоЗаказуПоставщику(Контекст, ЗаказПоставщику, 1);
	Реализация = ДемоРеализацияПоЗаказу(Контекст, Клиент, Заказ.Ссылка, Неопределено);
	СуммаРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реализация, "Сумма");
	ДемоПриходныйОрдер(Контекст, Клиент, Реализация, СуммаРеализации);
	Кейс = НовыйКейс(Заказ.Ссылка);
	Кейс.Вставить("Предложение", Предложение);
	Кейс.Вставить("Реализация", Реализация);
	Возврат Кейс;

КонецФункции

// R1. Закупка материалов на общий склад: остаток для кейсов «из своего остатка» и производства на склад.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Структура - кейс
//
Функция ДемоЗакупкиНаСклад(Контекст)

	Н = Контекст.Номенклатура;
	Завершен = Перечисления.СтатусыДокументов.Завершен;
	// BSLLS:MagicNumber-off - остаток материалов на складе (план, §3).
	Строки = Новый Массив;
	ДобавитьСтрокуДемо(Строки, Н.Planche, 60);
	ДобавитьСтрокуДемо(Строки, Н.Pied, 120);
	ДобавитьСтрокуДемо(Строки, Н.Vernis, 5);
	Материалы = ДемоЗакупка(Контекст, Контекст.Участники.Bois, Завершен, Строки);
	Строки = Новый Массив;
	ДобавитьСтрокуДемо(Строки, Н.Tissu, 20);
	ДобавитьСтрокуДемо(Строки, Н.Mousse, 20);
	Ткани = ДемоЗакупка(Контекст, Контекст.Участники.Textiles, Завершен, Строки);
	Лампы = ДемоЗакупка(Контекст, Контекст.Участники.Casa, Завершен, ДобавитьСтрокуДемо(Новый Массив, Н.Lampe, 20));
	ВРаботе = ДемоЗакупка(Контекст, Контекст.Участники.Casa, Перечисления.СтатусыДокументов.ВРаботе,
		ДобавитьСтрокуДемо(Новый Массив, Н.Lampe, 5));
	// BSLLS:MagicNumber-on
	Кейс = НовыйКейс();
	Кейс.Вставить("Материалы", Материалы);
	Кейс.Вставить("Ткани", Ткани);
	Кейс.Вставить("Лампы", Лампы);
	Кейс.Вставить("ПоступлениеВРаботе", ВРаботе);
	Возврат Кейс;

КонецФункции

// P2. Из своего остатка: реализация по заказу с автовыпуском из общего остатка («Из остатка»), безналичная оплата
// половины - «Ожидает оплаты».
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Структура - кейс
//
Функция ДемоИзСвоегоОстатка(Контекст)

	Клиент = Контекст.Участники.Riad;
	// BSLLS:MagicNumber-off - Chaise 8.
	Заказ = ДемоЗаказНаПроизводство(Контекст, Клиент, Контекст.Номенклатура.Chaise, 8, Истина);
	// BSLLS:MagicNumber-on
	Реализация = ДемоРеализацияПоЗаказу(Контекст, Клиент, Заказ, Неопределено);
	СуммаРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реализация, "Сумма");
	// BSLLS:MagicNumber-off - оплачена половина.
	ДемоПоступлениеНаСчет(Контекст, Клиент, Реализация, СуммаРеализации / 2);
	// BSLLS:MagicNumber-on
	Кейс = НовыйКейс(Заказ);
	Кейс.Вставить("Реализация", Реализация);
	Возврат Кейс;

КонецФункции

// P3. Ручной выпуск по заказу после закупки под заказ - «Ожидает отгрузки».
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Структура - кейс
//
Функция ДемоРучнойВыпускПоЗаказу(Контекст)

	Н = Контекст.Номенклатура;
	Клиент = Контекст.Участники.Majorelle;
	// BSLLS:MagicNumber-off - Table 4.
	Заказ = ДемоЗаказНаПроизводство(Контекст, Клиент, Н.Table, 4, Истина);
	ЗаказПоставщику = ДемоЗаказПоставщикуПоПотребности(Контекст, Заказ, Контекст.Участники.Bois);
	ДемоПоступлениеПоЗаказуПоставщику(Контекст, ЗаказПоставщику, 1);
	Выпуск = ДемоВыпуск(Контекст, Заказ, Н.Table, 4);
	// BSLLS:MagicNumber-on
	Кейс = НовыйКейс(Заказ);
	Кейс.Вставить("Выпуск", Выпуск);
	Возврат Кейс;

КонецФункции

// P4. Состав задан в заказе (изделие без техкарты): проведение регистрирует карту, закупка пришла - «В производстве».
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Структура - кейс
//
Функция ДемоСоставВЗаказе(Контекст)

	Н = Контекст.Номенклатура;
	Клиент = Контекст.Участники.Atlas;
	ЗаказОбъект = ДемоЗаказКлиента(Контекст, Клиент, Перечисления.ВидыОперацийЗаказаПокупателя.Производство,
		Н.Banquette, 1);
	СтрокаТоваров = ЗаказОбъект.ТЧТовары[0];
	// BSLLS:MagicNumber-off - Planche 6, Tissu 3, Mousse 3 на изделие.
	Обработки.ТестыДокументов.ДобавитьМатериалЗаказа(Контекст, ЗаказОбъект, СтрокаТоваров, Н.Planche, 6);
	Обработки.ТестыДокументов.ДобавитьМатериалЗаказа(Контекст, ЗаказОбъект, СтрокаТоваров, Н.Tissu, 3);
	Обработки.ТестыДокументов.ДобавитьМатериалЗаказа(Контекст, ЗаказОбъект, СтрокаТоваров, Н.Mousse, 3);
	// BSLLS:MagicNumber-on
	ЗаписатьДокументКейса(Контекст, ЗаказОбъект, Истина);
	Заказ = ЗаказОбъект.Ссылка;
	ЗаказПоставщику = ДемоЗаказПоставщикуПоПотребности(Контекст, Заказ, Контекст.Участники.Bois);
	ДемоПоступлениеПоЗаказуПоставщику(Контекст, ЗаказПоставщику, 1);
	Возврат НовыйКейс(Заказ);

КонецФункции

