////////////////////////////////////////////////////////////////////////////////
// Серверная часть подсистемы «Автотесты»: образцы объектов для прогона.
// Прогон проверяет форму объекта и печатную форму только там, где в базе есть хотя бы
// один объект; эта обработка заводит недостающие образцы - по одному на объект.
// Цели: все документы, все справочники (у иерархических - ещё и группа) и объекты
// с командами печати.
//
// Обработка ЗАПИСЫВАЕТ данные: запускать только на тестовой базе (scripts/fixtures.sh).
// Регламент - docs/TESTING.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Заводит образец для каждого объекта с командами печати, у которого в базе нет ни одного
// объекта. Документ заполняется по минимуму: реквизиты-ссылки берутся первыми подходящими
// элементами справочников, в товарную часть добавляется одна строка. Сначала документ
// пробуется провести; если проведение не проходит, документ остаётся записанным - печати
// этого достаточно, а прогон получает образец.
//
// Возвращаемое значение:
//  Структура - итог заполнения:
//   * Строки  - Массив из Строка - строки отчёта видов ЕСТЬ, СОЗДАН, ОШИБКА
//   * Создано - Число            - сколько образцов заведено
//   * Ошибок  - Число            - для скольких объектов образец завести не удалось
//   * Было    - Число            - сколько объектов уже имели образец
//
Функция СоздатьНедостающиеОбразцы() Экспорт

	Итог = Новый Структура("Строки, Создано, Ошибок, Было");
	Итог.Строки = Новый Массив;
	Итог.Создано = 0;
	Итог.Ошибок = 0;
	Итог.Было = 0;

	Для Каждого Цель Из ЦелевыеОбъекты() Цикл

		Представление = Цель.ПолноеИмя + ?(Цель.ЭтоГруппа, " (группа)", "");

		Если Обработки.СмокТест.ОбразецОбъекта(Цель.ПолноеИмя, Цель.ЭтоГруппа) <> Неопределено Тогда
			Итог.Было = Итог.Было + 1;
			Продолжить;
		КонецЕсли;

		Попытка
			Результат = СоздатьОбразец(Цель.ПолноеИмя, Цель.ЭтоГруппа);
			Итог.Строки.Добавить("СОЗДАН;" + Представление + ";" + Результат);
			Итог.Создано = Итог.Создано + 1;
		Исключение
			// BSLLS:DeprecatedMethodCall-off
			Информация = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			// BSLLS:DeprecatedMethodCall-on
			Описание = СтрЗаменить(Информация, Символы.ПС, " | ");
			Итог.Строки.Добавить("ОШИБКА;" + Представление + ";" + Описание);
			Итог.Ошибок = Итог.Ошибок + 1;
		КонецПопытки;

	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Список объектов, для которых нужен образец: все документы, все справочники (у
// иерархических дополнительно группа) и объекты с командами печати - у последних образец
// нужен, даже если это не документ и не справочник (запись регистра лидов).
//
// Возвращаемое значение:
//  Массив из Структура - цели заполнения:
//   * ПолноеИмя - Строка - полное имя объекта метаданных
//   * ЭтоГруппа - Булево - нужна группа справочника, а не элемент
//
Функция ЦелевыеОбъекты()

	Цели = Новый Массив;
	Ключи = Новый Соответствие;
	Пропуски = НеЗаводимыеОбъекты();

	Для Каждого ПолноеИмяОбъекта Из ПечатныеФормы.ОбъектыСКомандамиПечати() Цикл
		ДобавитьЦель(Цели, Ключи, Пропуски, ПолноеИмяОбъекта, Ложь);
	КонецЦикла;

	Для Каждого ОписаниеДокумента Из Метаданные.Документы Цикл
		ДобавитьЦель(Цели, Ключи, Пропуски, ОписаниеДокумента.ПолноеИмя(), Ложь);
	КонецЦикла;

	Для Каждого ОписаниеСправочника Из Метаданные.Справочники Цикл
		ДобавитьЦель(Цели, Ключи, Пропуски, ОписаниеСправочника.ПолноеИмя(), Ложь);
		Если ЭтоСправочникСГруппами(ОписаниеСправочника) Тогда
			ДобавитьЦель(Цели, Ключи, Пропуски, ОписаниеСправочника.ПолноеИмя(), Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Цели;

КонецФункции

// Добавляет цель в список, если её там ещё нет и она не в пропусках.
//
// Параметры:
//  Цели      - Массив из Структура - пополняемый список, см. ЦелевыеОбъекты
//  Ключи     - Соответствие        - уже добавленные цели
//  Пропуски  - Массив из Строка    - объекты, для которых образец не заводится
//  ПолноеИмя - Строка              - полное имя объекта метаданных
//  ЭтоГруппа - Булево              - группа справочника, а не элемент
//
Процедура ДобавитьЦель(Цели, Ключи, Пропуски, ПолноеИмя, ЭтоГруппа)

	Если Пропуски.Найти(ПолноеИмя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ключ = ПолноеИмя + ?(ЭтоГруппа, "/группа", "");
	Если Ключи[Ключ] <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ключи.Вставить(Ключ, Истина);
	Цели.Добавить(Новый Структура("ПолноеИмя, ЭтоГруппа", ПолноеИмя, ЭтоГруппа));

КонецПроцедуры

// Объекты, для которых образец не заводится. Каждый пропуск - с причиной.
//
// Возвращаемое значение:
//  Массив из Строка - полные имена объектов метаданных
//
Функция НеЗаводимыеОбъекты()

	Пропуски = Новый Массив;

	// Пользователи информационной базы заводятся администратором, а не автотестом:
	// элемент справочника без пользователя ИБ ломает вход и права.
	Пропуски.Добавить("Справочник.Пользователи");
	Пропуски.Добавить("Справочник.ГруппыПользователей");

	Возврат Пропуски;

КонецФункции

// Заводит один образец.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных
//  ЭтоГруппа        - Булево - группа справочника, а не элемент
//
// Возвращаемое значение:
//  Строка - представление созданного образца для отчёта
//
Функция СоздатьОбразец(ПолноеИмяОбъекта, ЭтоГруппа)

	Если ПолноеИмяОбъекта = "РегистрСведений.Лиды" Тогда
		Возврат СоздатьЛид();
	КонецЕсли;

	Если СтрНачинаетсяС(ПолноеИмяОбъекта, "Документ.") Тогда
		Возврат СоздатьОбразецДокумента(СтрЗаменить(ПолноеИмяОбъекта, "Документ.", ""));
	КонецЕсли;

	Если СтрНачинаетсяС(ПолноеИмяОбъекта, "Справочник.") Тогда
		Возврат СоздатьОбразецСправочника(СтрЗаменить(ПолноеИмяОбъекта, "Справочник.", ""), ЭтоГруппа);
	КонецЕсли;

	// Появится печать у объекта другого вида - правило для него добавляется сюда осознанно,
	// а не угадывается.
	ВызватьИсключение НСтр("ru = 'Образец объекта этого вида обработка заводить не умеет'");

КонецФункции

// Заводит образец документа: особенности вида, ссылочные реквизиты по метаданным, запись.
//
// Параметры:
//  ИмяДокумента - Строка - имя объекта метаданных
//
// Возвращаемое значение:
//  Строка - представление созданного образца для отчёта
//
Функция СоздатьОбразецДокумента(ИмяДокумента)

	Док = Документы[ИмяДокумента].СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();

	ДовестиОбразец(ИмяДокумента, Док);
	ЗаполнитьСсылочныеРеквизиты(Док);
	ЗаполнитьКомментарий(Док);

	Режим = ЗаписатьОбразец(Док, Истина);

	Возврат СокрЛП(Док.Номер) + ";" + Режим;

КонецФункции

// Заводит образец элемента или группы справочника: владелец, наименование, ссылочные
// реквизиты по метаданным, запись.
//
// Параметры:
//  ИмяСправочника - Строка - имя объекта метаданных
//  ЭтоГруппа      - Булево - создаётся группа, а не элемент
//
// Возвращаемое значение:
//  Строка - представление созданного образца для отчёта
//
Функция СоздатьОбразецСправочника(ИмяСправочника, ЭтоГруппа)

	Описание = Метаданные.Справочники[ИмяСправочника];
	Менеджер = Справочники[ИмяСправочника];
	Элемент = ?(ЭтоГруппа, Менеджер.СоздатьГруппу(), Менеджер.СоздатьЭлемент());

	УстановитьВладельца(Элемент, Описание);

	Если Описание.ДлинаНаименования > 0 Тогда
		Элемент.Наименование = Лев(ПометкаОбразца(), Описание.ДлинаНаименования);
	КонецЕсли;

	ЗаполнитьСсылочныеРеквизиты(Элемент, ЭтоГруппа);
	ЗаполнитьКомментарий(Элемент);

	Режим = ЗаписатьОбразец(Элемент, Ложь);

	Возврат СокрЛП(Элемент.Наименование) + ";" + Режим;

КонецФункции

// Ставит владельца подчинённому справочнику: без него запись не проходит проверку.
//
// Параметры:
//  Элемент  - СправочникОбъект           - заполняемый образец
//  Описание - ОбъектМетаданныхСправочник - описание справочника
//
Процедура УстановитьВладельца(Элемент, Описание)

	// Владельцев может быть несколько типов - берём первый подходящий справочник, для образца
	// достаточно. Коллекция владельцев обходится циклом: доступа по индексу у неё нет.
	Для Каждого ОписаниеВладельца Из Описание.Владельцы Цикл
		Если Метаданные.Справочники.Содержит(ОписаниеВладельца) Тогда
			Элемент.Владелец = ПервыйЭлемент(ОписаниеВладельца.Имя);
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Записывает образец: сначала с проведением, затем просто записью, в последнюю очередь
// загрузкой. Загрузка обходит проверку заполнения и логику записи - образец нужен прогону
// как объект, на котором открывается форма, а не как корректный документ учёта.
//
// Параметры:
//  Объект      - ДокументОбъект, СправочникОбъект - заполненный образец
//  ЭтоДокумент - Булево - у документа есть режим проведения
//
// Возвращаемое значение:
//  Строка - каким способом записан, для отчёта
//
Функция ЗаписатьОбразец(Объект, ЭтоДокумент)

	// Проведение образца не обязательно, а причина отказа в отчёт не пишется: это не дефект
	// конфигурации, а нехватка данных в тестовой базе. Поэтому блоки Исключение пустые.
	// BSLLS:MissingCodeTryCatchEx-off
	Если ЭтоДокумент Тогда
		Попытка
			Объект.Записать(РежимЗаписиДокумента.Проведение);
			Возврат "проведен";
		Исключение
		КонецПопытки;
	КонецЕсли;

	Попытка
		Объект.Записать();
		Возврат "записан";
	Исключение
	КонецПопытки;
	// BSLLS:MissingCodeTryCatchEx-on

	Объект.ОбменДанными.Загрузка = Истина;
	Если ЭтоДокумент Тогда
		Если Не ЗначениеЗаполнено(Объект.Номер) Тогда
			Объект.УстановитьНовыйНомер();
		КонецЕсли;
	Иначе
		Если Объект.Метаданные().ДлинаКода > 0 И Не ЗначениеЗаполнено(Объект.Код) Тогда
			Объект.УстановитьНовыйКод();
		КонецЕсли;
	КонецЕсли;
	Объект.Записать();

	Возврат "записан загрузкой";

КонецФункции

// Особенности отдельных видов документов: то, что не выводится из метаданных - хозяйственная
// операция, согласованные контрагент с договором, строки табличных частей.
//
// Параметры:
//  ИмяДокумента - Строка         - имя объекта метаданных
//  Док          - ДокументОбъект - заполняемый образец
//
Процедура ДовестиОбразец(ИмяДокумента, Док)

	Если ДовестиТоварныйОбразец(ИмяДокумента, Док) Тогда
		Возврат;
	КонецЕсли;

	Если ДовестиДенежныйОбразец(ИмяДокумента, Док) Тогда
		Возврат;
	КонецЕсли;

	ДовестиПрочийОбразец(ИмяДокумента, Док);

КонецПроцедуры

// Образцы документов движения товаров: контрагент с договором, операция и строка товаров.
//
// Параметры:
//  ИмяДокумента - Строка         - имя объекта метаданных
//  Док          - ДокументОбъект - заполняемый образец
//
// Возвращаемое значение:
//  Булево - Истина, если документ этого вида и заполнение выполнено
//
Функция ДовестиТоварныйОбразец(ИмяДокумента, Док)

	Операции = Перечисления.ХозяйственныеОперации;

	Если ИмяДокумента = "ВозвратОтПокупателя" Тогда
		Док.ХозяйственнаяОперация = Операции.ВозвратТоваровОтКлиента;
		ЗаполнитьВозвратПоРеализации(Док);
	ИначеЕсли ИмяДокумента = "ВозвратОтПокупателяНалоговый" Тогда
		УстановитьКонтрагента(Док);
		Док.ХозяйственнаяОперация = Операции.ВозвратТоваровОтКлиента;
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "НалоговаяНакладная" Тогда
		УстановитьКонтрагента(Док);
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "НалоговаяНакладнаяПокупка" Тогда
		УстановитьКонтрагента(Док);
		Док.ХозяйственнаяОперация = Операции.ЗакупкаУПоставщика;
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "ПеремещениеТоваров" Тогда
		Док.ХозяйственнаяОперация = Операции.ПеремещениеОприходование;
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "ПередачаВПереработку" Или ИмяДокумента = "ПоступлениеИзПереработки" Тогда
		УстановитьКонтрагента(Док);
		ДобавитьСтрокуТоваров(Док);
		ДобавитьСтрокуТоваров(Док, "ТЧГотоваяПродукция");
	ИначеЕсли ИмяДокумента = "ОприходованиеТоваров" Или ИмяДокумента = "СписаниеТоваров" Тогда
		ДобавитьСтрокуТоваров(Док);
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Образцы заказов, предложений, цен и денежных документов.
//
// Параметры:
//  ИмяДокумента - Строка         - имя объекта метаданных
//  Док          - ДокументОбъект - заполняемый образец
//
// Возвращаемое значение:
//  Булево - Истина, если документ этого вида и заполнение выполнено
//
Функция ДовестиДенежныйОбразец(ИмяДокумента, Док)

	Операции = Перечисления.ХозяйственныеОперации;

	Если ИмяДокумента = "ЗаказПоставщику" Тогда
		УстановитьКонтрагента(Док);
		Док.ВидЗаказа = Перечисления.ВидыЗаказовПоставщику.Основной;
		Док.ДатаПоставки = Док.Дата;
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "ПредложениеПоставщика" Тогда
		УстановитьКонтрагента(Док);
		Док.ЗаказПокупателя = ПервыйДокумент("ЗаказПокупателя");
		Док.ДатаПредложения = Док.Дата;
		ДобавитьСтрокуТоваров(Док);
	ИначеЕсли ИмяДокумента = "УстановкаЦенНоменклатуры" Тогда
		Док.ХозяйственнаяОперация = Операции.УстановкаЦенНоменклатуры;
		ДобавитьСтрокуТоваров(Док, "ТЧЦены");
	ИначеЕсли ИмяДокумента = "ПриходныйКассовыйОрдер" Тогда
		ЗаполнитьКассовыйОрдер(Док, Операции.ПоступлениеОплатыОтКлиента);
	ИначеЕсли ИмяДокумента = "РасходныйКассовыйОрдер" Тогда
		ЗаполнитьКассовыйОрдер(Док, Операции.ПрочийРасходДенежныхСредств);
	ИначеЕсли ИмяДокумента = "КассоваяСмена" Тогда
		Док.Статус = Перечисления.СтатусыКассовойСмены.Закрыта;
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Образцы документов взаиморасчётов и кадрового контура.
//
// Параметры:
//  ИмяДокумента - Строка         - имя объекта метаданных
//  Док          - ДокументОбъект - заполняемый образец
//
Процедура ДовестиПрочийОбразец(ИмяДокумента, Док)

	Если ИмяДокумента = "КорректировкаДолга" Тогда
		УстановитьКонтрагента(Док);
		Док.КонтрагентДебитор = Док.КонтрагентКредитор;
		Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеЗадолженности;
		Док.СуммаДебет = СуммаОбразца();
		Док.СуммаКредит = СуммаОбразца();
	ИначеЕсли ИмяДокумента = "СверкаВзаиморасчётов" Тогда
		УстановитьКонтрагента(Док);
		Док.НачалоПериода = НачалоМесяца(Док.Дата);
		Док.КонецПериода = КонецМесяца(Док.Дата);
		ДобавитьСтрокуСверки(Док, "ТЧПоДаннымОрганизации");
		ДобавитьСтрокуСверки(Док, "ТЧПоДаннымКонтрагента");
	ИначеЕсли ИмяДокумента = "ВыплатаЗарплаты" Или ИмяДокумента = "ПлатёжнаяВедомостьНаАванс" Тогда
		ДобавитьСтрокуСотрудника(Док);
	ИначеЕсли ИмяДокумента = "ТабельУчётаРабочегоВремени" Тогда
		ДобавитьСтрокуТабеля(Док);
	Иначе
		// Своего правила у документа нет: общее заполнение по метаданным плюс строка товаров,
		// если товарная часть есть - пустой документ чаще всего не проводится.
		УстановитьКонтрагента(Док);
		ДобавитьСтрокуТоваров(Док);
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Заполняет незаполненные реквизиты-ссылки первыми подходящими элементами справочников.
// Договор и реквизиты-документы пропускаются: их согласованность задаётся отдельно.
// У группы справочника доступны не все реквизиты - реквизиты «только для элемента»
// пропускаются, обращение к ним у группы вызывает ошибку.
//
// Параметры:
//  Объект    - ДокументОбъект, СправочникОбъект - заполняемый образец
//  ЭтоГруппа - Булево - образец является группой справочника
//
Процедура ЗаполнитьСсылочныеРеквизиты(Объект, ЭтоГруппа = Ложь)

	// Свойство реквизита называется Использование; ИспользованиеРеквизита - имя системного
	// перечисления его значений. Проверено прогоном: обращение к ИспользованиеРеквизита падает.
	ТолькоДляЭлемента = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента;

	Для Каждого Реквизит Из Объект.Метаданные().Реквизиты Цикл

		Если ЭтоГруппа И Реквизит.Использование = ТолькоДляЭлемента Тогда
			Продолжить;
		КонецЕсли;

		Если Реквизит.Имя = "Договор" Или ЗначениеЗаполнено(Объект[Реквизит.Имя]) Тогда
			Продолжить;
		КонецЕсли;

		Типы = Реквизит.Тип.Типы();
		Если Типы.Количество() <> 1 Тогда
			Продолжить;
		КонецЕсли;

		ОбъектМетаданных = Метаданные.НайтиПоТипу(Типы[0]);
		Если ОбъектМетаданных = Неопределено Или Не Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;

		Если ОбъектМетаданных = Объект.Метаданные() Тогда
			// Ссылка справочника на самого себя: подставлять образец в его же реквизит незачем.
			Продолжить;
		КонецЕсли;

		Объект[Реквизит.Имя] = ПервыйЭлемент(ОбъектМетаданных.Имя);

	КонецЦикла;

КонецПроцедуры

// Помечает образец комментарием - по нему видно, что объект заведён автотестом.
//
// Параметры:
//  Объект - ДокументОбъект, СправочникОбъект - заполняемый образец
//
Процедура ЗаполнитьКомментарий(Объект)

	Если Объект.Метаданные().Реквизиты.Найти("Комментарий") <> Неопределено Тогда
		Объект.Комментарий = ПометкаОбразца();
	КонецЕсли;

КонецПроцедуры

// Ставит документу контрагента вместе с его договором: договор выбирается первым, чтобы
// контрагент и договор заведомо соответствовали друг другу.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый образец
//
Процедура УстановитьКонтрагента(Док)

	Пара = КонтрагентСДоговором();
	Реквизиты = Док.Метаданные().Реквизиты;

	Если Реквизиты.Найти("Контрагент") <> Неопределено Тогда
		Док.Контрагент = Пара.Контрагент;
	КонецЕсли;
	Если Реквизиты.Найти("КонтрагентКредитор") <> Неопределено Тогда
		Док.КонтрагентКредитор = Пара.Контрагент;
	КонецЕсли;
	Если Реквизиты.Найти("Поставщик") <> Неопределено Тогда
		Док.Поставщик = Пара.Контрагент;
	КонецЕсли;
	Если Реквизиты.Найти("Договор") <> Неопределено Тогда
		Док.Договор = Пара.Договор;
	КонецЕсли;

КонецПроцедуры

// Заполняет кассовый ордер: сумма, статья ДДС, тип оплаты и хозяйственная операция.
//
// Параметры:
//  Док      - ДокументОбъект - заполняемый образец
//  Операция - ПеречислениеСсылка.ХозяйственныеОперации - операция ордера
//
Процедура ЗаполнитьКассовыйОрдер(Док, Операция)

	УстановитьКонтрагента(Док);
	Док.Контрагент = КонтрагентСДоговором().Контрагент;
	Док.ХозяйственнаяОперация = Операция;
	Док.Сумма = СуммаОбразца();

КонецПроцедуры

// Заполняет возврат от покупателя по реализации-основанию: без основания документ не
// записывается вовсе - проверка соответствия возврата реализации в ПередЗаписью читает
// товары документа-основания, а у пустой ссылки табличной части нет. Строка возврата
// повторяет первую строку реализации: проверка сверяет номенклатуру, серию и количество.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый образец
//
Процедура ЗаполнитьВозвратПоРеализации(Док)

	Реализация = ПервыйДокумент("РеализацияТоваровУслуг");
	Если Не ЗначениеЗаполнено(Реализация) Тогда
		УстановитьКонтрагента(Док);
		ДобавитьСтрокуТоваров(Док);
		Возврат;
	КонецЕсли;

	Док.Основание = Реализация;
	Док.Контрагент = Реализация.Контрагент;
	Док.Договор = Реализация.Договор;
	Док.Организация = Реализация.Организация;
	Док.МестоХранения = Реализация.МестоХранения;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТЧТовары.КодСтроки КАК КодСтроки,
		|	ТЧТовары.Номенклатура КАК Номенклатура,
		|	ТЧТовары.Характеристика КАК Характеристика,
		|	ТЧТовары.Упаковка КАК Упаковка,
		|	ТЧТовары.Серия КАК Серия,
		|	ТЧТовары.Количество КАК Количество,
		|	ТЧТовары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	ТЧТовары.Цена КАК Цена,
		|	ТЧТовары.Сумма КАК Сумма,
		|	ТЧТовары.СуммаСНДС КАК СуммаСНДС,
		|	ТЧТовары.СтавкаНДС КАК СтавкаНДС,
		|	ТЧТовары.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК ТЧТовары
		|ГДЕ
		|	ТЧТовары.Ссылка = &Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	ТЧТовары.НомерСтроки");
	Запрос.УстановитьПараметр("Ссылка", Реализация);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		ДобавитьСтрокуТоваров(Док);
		Возврат;
	КонецЕсли;

	Строка = Док.ТЧТовары.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Выборка);

КонецПроцедуры

// Добавляет одну строку в товарную часть документа, если такая часть у него есть.
//
// Параметры:
//  Док   - ДокументОбъект - заполняемый образец
//  ИмяТЧ - Строка         - имя табличной части, по умолчанию товарная часть документа
//
Процедура ДобавитьСтрокуТоваров(Док, ИмяТЧ = "ТЧТовары")

	ТабличныеЧасти = Док.Метаданные().ТабличныеЧасти;
	Если ТабличныеЧасти.Найти(ИмяТЧ) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Колонки = ТабличныеЧасти[ИмяТЧ].Реквизиты;
	Строка = Док[ИмяТЧ].Добавить();

	Номенклатура = ПервыйЭлемент("Номенклатура");
	СтавкаНДС = ПервыйЭлемент("СтавкиНДС");
	Сумма = СуммаОбразца();

	ЗаполнитьКолонку(Строка, Колонки, "КодСтроки", 1);
	ЗаполнитьКолонку(Строка, Колонки, "Номенклатура", Номенклатура);
	ЗаполнитьКолонку(Строка, Колонки, "СтавкаНДС", СтавкаНДС);
	ЗаполнитьКолонку(Строка, Колонки, "Количество", 1);
	ЗаполнитьКолонку(Строка, Колонки, "КоличествоУпаковок", 1);
	ЗаполнитьКолонку(Строка, Колонки, "Цена", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "ЦенаЗакупочная", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "ЦенаРозничная", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "Сумма", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "СуммаСНДС", Сумма);

КонецПроцедуры

// Добавляет строку в табличную часть акта сверки.
//
// Параметры:
//  Док   - ДокументОбъект - заполняемый образец
//  ИмяТЧ - Строка         - имя табличной части
//
Процедура ДобавитьСтрокуСверки(Док, ИмяТЧ)

	Строка = Док[ИмяТЧ].Добавить();
	Строка.Дата = Док.Дата;
	Строка.Договор = Док.Договор;
	Строка.ДокументПредставление = ПометкаОбразца();
	Строка.Дебет = СуммаОбразца();

КонецПроцедуры

// Добавляет строку сотрудника в ведомость.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый образец
//
Процедура ДобавитьСтрокуСотрудника(Док)

	Строка = Док.ТЧСотрудники.Добавить();
	Строка.Сотрудник = ПервыйЭлемент("ФизическиеЛица");
	Строка.Сумма = СуммаОбразца();
	Док.Сумма = СуммаОбразца();

КонецПроцедуры

// Добавляет строку табеля: сотрудник, график и отработанные часы первых дней месяца.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый образец
//
Процедура ДобавитьСтрокуТабеля(Док)

	Строка = Док.ТЧТабель.Добавить();
	Строка.Сотрудник = ПервыйЭлемент("ФизическиеЛица");
	Строка.ГрафикРаботы = ПервыйЭлемент("ГрафикиРаботыСотрудников");
	Часов = ЧасовВСмене();
	Колонки = Док.Метаданные().ТабличныеЧасти.ТЧТабель.Реквизиты;
	ДнейВОбразце = 5;
	Для Номер = 1 По ДнейВОбразце Цикл
		ИмяКолонкиДня = "_" + Формат(Номер, "ЧГ=0");
		ЗаполнитьКолонку(Строка, Колонки, ИмяКолонкиДня, Часов);
	КонецЦикла;

КонецПроцедуры

// Заводит запись регистра лидов: печать лида формируется по связанному заказу покупателя.
//
// Возвращаемое значение:
//  Строка - представление созданного образца для отчёта
//
Функция СоздатьЛид()

	Заказ = ПервыйДокумент("ЗаказПокупателя");
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		ВызватьИсключение НСтр("ru = 'В базе нет ни одного заказа покупателя: лид печатается по заказу'");
	КонецЕсли;

	Запись = РегистрыСведений.Лиды.СоздатьМенеджерЗаписи();
	Запись.ДатаСоздания = ТекущаяДатаСеанса();
	Запись.Канал = ПервыйЭлемент("Каналы");
	Запись.ПолноеИмя = ПометкаОбразца();
	Запись.Клиент = Заказ.Контрагент;
	Запись.ЗаказПокупателя = Заказ;
	Запись.Комментарий = ПометкаОбразца();
	Запись.Статус = Перечисления.СтатусыЛидов.Новый;
	Запись.Сумма = Заказ.Сумма;
	Запись.Записать();

	Возврат "" + Заказ + ";запись регистра";

КонецФункции

// Записывает значение в колонку строки табличной части, если такая колонка есть.
//
// Параметры:
//  Строка   - СтрокаТабличнойЧасти - заполняемая строка
//  Колонки  - КоллекцияОбъектовМетаданных - реквизиты табличной части
//  ИмяКолонки - Строка - имя колонки
//  Значение - Произвольный - записываемое значение
//
Процедура ЗаполнитьКолонку(Строка, Колонки, ИмяКолонки, Значение)

	Если Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
		Строка[ИмяКолонки] = Значение;
	КонецЕсли;

КонецПроцедуры

// Первый непомеченный элемент справочника - группы не берутся.
//
// Параметры:
//  ИмяСправочника - Строка - имя объекта метаданных
//
// Возвращаемое значение:
//  СправочникСсылка - элемент либо пустая ссылка, если справочник пуст
//
Функция ПервыйЭлемент(ИмяСправочника)

	ОписаниеСправочника = Метаданные.Справочники[ИмяСправочника];
	УсловиеГруппы = ?(ЭтоСправочникСГруппами(ОписаниеСправочника), "НЕ Таблица.ЭтоГруппа", "ИСТИНА");

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	&ИмяТаблицы КАК Таблица
		|ГДЕ
		|	НЕ Таблица.ПометкаУдаления
		|	И &УсловиеГруппы";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", "Справочник." + ИмяСправочника);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГруппы", УсловиеГруппы);

	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции

// Есть ли у справочника группы - от этого зависит условие отбора элемента.
//
// Параметры:
//  ОписаниеСправочника - ОбъектМетаданныхСправочник - описание справочника
//
// Возвращаемое значение:
//  Булево - Истина, если справочник иерархический с группами
//
Функция ЭтоСправочникСГруппами(ОписаниеСправочника)

	Возврат ОписаниеСправочника.Иерархический
		И ОписаниеСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;

КонецФункции

// Контрагент вместе с его договором: первым выбирается договор, поэтому пара заведомо
// согласована - у документа не окажется договора чужого контрагента.
//
// Возвращаемое значение:
//  Структура - пара для заполнения образца:
//   * Контрагент - СправочникСсылка.Контрагенты
//   * Договор    - СправочникСсылка.ДоговорыСКонтрагентами
//
Функция КонтрагентСДоговором()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договоры.Ссылка КАК Договор,
		|	Договоры.Контрагент КАК Контрагент
		|ИЗ
		|	Справочник.ДоговорыСКонтрагентами КАК Договоры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО Договоры.Контрагент = Контрагенты.Ссылка
		|ГДЕ
		|	НЕ Договоры.ПометкаУдаления
		|	И НЕ Контрагенты.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Контрагент, Договор", Выборка.Контрагент, Выборка.Договор);
	КонецЕсли;

	Возврат Новый Структура("Контрагент, Договор",
		ПервыйЭлемент("Контрагенты"), Справочники.ДоговорыСКонтрагентами.ПустаяСсылка());

КонецФункции

// Последний документ указанного вида - образцу нужен уже существующий документ-основание.
//
// Параметры:
//  ИмяДокумента - Строка - имя объекта метаданных
//
// Возвращаемое значение:
//  ДокументСсылка - документ либо пустая ссылка
//
Функция ПервыйДокумент(ИмяДокумента)

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	&ИмяТаблицы КАК Таблица
		|УПОРЯДОЧИТЬ ПО
		|	Таблица.Дата УБЫВ";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", "Документ." + ИмяДокумента);

	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Документы[ИмяДокумента].ПустаяСсылка();

КонецФункции

