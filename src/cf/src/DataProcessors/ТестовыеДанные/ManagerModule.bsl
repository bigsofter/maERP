// Запись регистра лидов, как её пишет форма записи.
//
// Параметры:
//  Контекст - Структура - см. ЗаполнитьДемоНабор
//  Имя      - Строка - полное имя лида
//  Статус   - ПеречислениеСсылка.СтатусыЛидов - статус
//  Заказ    - ДокументСсылка.ЗаказПокупателя, Неопределено - заказ лида
//
// Возвращаемое значение:
//  Строка - полное имя записанного лида
//
Функция ДемоЛид(Контекст, Имя, Статус, Заказ)

	Запись = РегистрыСведений.Лиды.СоздатьМенеджерЗаписи();
	Запись.ДатаСоздания = Обработки.ТестыДокументов.СледующаяДата(Контекст);
	Запись.ПолноеИмя = ИмяДемо(Контекст, Имя);
	Запись.НомерТелефона = "+212 600 000 000";
	Запись.EMail = "demo@example.com";
	Запись.Комментарий = Контекст.Пометка;
	Запись.Статус = Статус;
	Запись.Закрыт = (Статус = Перечисления.СтатусыЛидов.Отменен Или Статус = Перечисления.СтатусыЛидов.Доставлен);
	Если Заказ = Неопределено Тогда
		Запись.ЗаказПокупателя = Документы.ЗаказПокупателя.ПустаяСсылка();
		Запись.Сумма = 0;
	Иначе
		Запись.ЗаказПокупателя = Заказ;
		Запись.Клиент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заказ, "Контрагент");
		Запись.Сумма = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заказ, "Сумма");
	КонецЕсли;
	Запись.Записать();
	Возврат Запись.ПолноеИмя;

КонецФункции

// Записанная заявка на поиск товара в заданном статусе.
//
// Параметры:
//  Контекст     - Структура - см. ЗаполнитьДемоНабор
//  Описание     - Строка - что ищет клиент
