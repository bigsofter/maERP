#Область БлокСтанков

// M. Учёт станков одним атомарным кейсом: три станка, требования во всех состояниях, плановое и аварийное обслуживание,
// инвентаризация и оприходование на станке. Факт - в трёх последних завершённых рабочих интервалах станка E1 до начала
// набора, план - в будущем. Порядок на E1: завершение 3 → инвентаризация 6-7 до следующего запуска → запуск 10 намеренно
// закрепляет остаток после инвентаризации. План - docs/plans/demo-data-button.md, §4.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Структура, Строка - кейс; строка - причина пропуска (до записи документов)
//
Функция ДемоСтанки(Контекст)

	М = СправочникиСтанков(Контекст);
	Окно = ОкноСтанков(Контекст, М.E1);
	Если ТипЗнч(Окно) = Тип("Строка") Тогда
		Возврат Окно;
	КонецЕсли;
	Причина = ИсторияБлокаСтанков(М);
	Если Не ПустаяСтрока(Причина) Тогда
		Возврат Причина;
	КонецЕсли;
	Причина = КартаБлокаСтанков(Контекст, М, НачалоДня(Окно.Интервалы[0].Начало));
	Если Не ПустаяСтрока(Причина) Тогда
		Возврат Причина;
	КонецЕсли;

	Кейс = НовыйКейс();
	ДокументыФактаСтанков(Контекст, М, Окно, Кейс);
	ДокументыПланаСтанков(Контекст, М, Кейс);
	Станки = Новый Массив;
	Станки.Добавить(М.E1);
	Станки.Добавить(М.M1);
	Станки.Добавить(М.P1);
	Кейс.Вставить("Станки", Станки);
	Кейс.Вставить("Инфо", Окно.Инфо);
	Возврат Кейс;

КонецФункции

// Справочники блока - найти или создать: единица кг, склады станков, три станка, номенклатура, свои поставщик и клиент.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки; цены позиций добавляются в ЦеныЗакупки и ЦеныПродажи
//
// Возвращаемое значение:
//  Структура - Кг, E1, M1, P1, Гранулы, Нить, Мешок, МешокСоздан, Поставщик, Клиент
//
Функция СправочникиСтанков(Контекст)

	М = Новый Структура;
	М.Вставить("Кг", ДемоЕдиница(Контекст, "kg (Démo)", Перечисления.ТипыИзмеряемыхВеличин.Вес));
	СкладЭкструдера = ДемоМестоХранения(Контекст, "Stock Extrudeuse");
	СкладТкацкого = ДемоМестоХранения(Контекст, "Stock Métier");
	// BSLLS:MagicNumber-off - режимы, выработка и стоимость часа станков набора.
	ПнПт = СтрРазделить("1,2,3,4,5", ",");
	ПнСб = СтрРазделить("1,2,3,4,5,6", ",");
	Описание = ОписаниеСтанка("Extru E1", "extrudeuse", 120, 80);
	Описание.СкладСтанка = СкладЭкструдера;
	Описание.Дни = ПнПт;
	М.Вставить("E1", ДемоСтанок(Контекст, Описание));
	Описание = ОписаниеСтанка("Métier M1", "métier à tisser", 60, 50);
	Описание.СкладСтанка = СкладТкацкого;
	Описание.Дни = ПнСб;
	Описание.ЧасНачала = 6;
	Описание.ЧасОкончания = 22;
	Описание.БезКалендаря = Истина;
	М.Вставить("M1", ДемоСтанок(Контекст, Описание));
	Описание = ОписаниеСтанка("Presse P1", "presse", 90, 40);
	Описание.Дни = ПнПт;
	М.Вставить("P1", ДемоСтанок(Контекст, Описание));
	Типы = Перечисления.ТипыНоменклатуры;
	Способы = Перечисления.СпособыПополненияЗапасов;
	Гранулы = ДемоНоменклатура(Контекст, "M-GRANULES", "Granulés PP", Типы.Сырье, Способы.Закупка, М.Кг);
	Нить = ДемоНоменклатура(Контекст, "M-FIL", "Fil polyester", Типы.Сырье, Способы.Закупка, М.Кг);
	Мешок = ДемоНоменклатура(Контекст, "M-SAC", "Sac tissé", Типы.Продукция, Способы.Производство, Контекст.Единица);
	М.Вставить("Гранулы", Гранулы.Ссылка);
	М.Вставить("Нить", Нить.Ссылка);
	М.Вставить("Мешок", Мешок.Ссылка);
	М.Вставить("МешокСоздан", Мешок.Создана);
	Если Мешок.Создана Тогда
		МешокОбъект = Мешок.Ссылка.ПолучитьОбъект();
		МешокОбъект.Станки.Добавить().Станок = М.E1;
		МешокОбъект.Станки.Добавить().Станок = М.M1;
		МешокОбъект.Записать();
	КонецЕсли;
	Контекст.ЦеныЗакупки.Вставить(М.Гранулы, 2);
	Контекст.ЦеныЗакупки.Вставить(М.Нить, 9);
	Контекст.ЦеныПродажи.Вставить(М.Мешок, 15);
	// BSLLS:MagicNumber-on
	М.Вставить("Поставщик", ДемоУчастник(Контекст, "Plastiques Sud", Ложь, Ложь, "DEMO07"));
	М.Вставить("Клиент", ДемоУчастник(Контекст, "Sacs Export", Истина, Ложь, "DEMO08"));
	Возврат М;

КонецФункции

// Описание станка набора: смена 8-20 по дням, с календарём, без склада станка - если не задано иное.
//
// Параметры:
//  Название      - Строка - короткое название (у станка наименование до 25 знаков)
//  Вид           - Строка - вид станка
//  Выработка     - Число - кг/ч
//  СтоимостьЧаса - Число - стоимость часа работы
//
// Возвращаемое значение:
//  Структура - Название, Вид, Выработка, СтоимостьЧаса, СкладСтанка, Дни (Массив из Строка, 1 - понедельник),
//              ЧасНачала, ЧасОкончания, БезКалендаря
//
Функция ОписаниеСтанка(Название, Вид, Выработка, СтоимостьЧаса)

	Описание = Новый Структура;
	Описание.Вставить("Название", Название);
	Описание.Вставить("Вид", Вид);
	Описание.Вставить("Выработка", Выработка);
	Описание.Вставить("СтоимостьЧаса", СтоимостьЧаса);
	Описание.Вставить("СкладСтанка", Справочники.МестаХранения.ПустаяСсылка());
	Описание.Вставить("Дни", Новый Массив);
	// BSLLS:MagicNumber-off - смена 8-20.
	Описание.Вставить("ЧасНачала", 8);
	Описание.Вставить("ЧасОкончания", 20);
	// BSLLS:MagicNumber-on
	Описание.Вставить("БезКалендаря", Ложь);
	Возврат Описание;

КонецФункции

// Станок набора: найти по наименованию или создать с режимом работы.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Описание - Структура - см. ОписаниеСтанка
//
// Возвращаемое значение:
//  СправочникСсылка.ПроизводственноеОборудование - станок
//
Функция ДемоСтанок(Контекст, Описание)

	Наименование = "Démo " + Описание.Название + Контекст.Суффикс;
	Станок = НайтиЭлементДемо("ПроизводственноеОборудование", Новый Структура("Наименование", Наименование));
	Если Станок <> Неопределено Тогда
		Возврат Станок;
	КонецЕсли;
	СтанокОбъект = Справочники.ПроизводственноеОборудование.СоздатьЭлемент();
	СтанокОбъект.Наименование = Наименование;
	СтанокОбъект.ВидСтанка = Описание.Вид;
	СтанокОбъект.Выработка = Описание.Выработка;
	// BSLLS:MagicNumber-off - 15 минут на смену заказа.
	СтанокОбъект.ВремяНаСменуЗаказа = 15;
	// BSLLS:MagicNumber-on
	СтанокОбъект.СтоимостьЧаса = Описание.СтоимостьЧаса;
	СтанокОбъект.СкладСтанка = Описание.СкладСтанка;
	СтанокОбъект.РаботаетБезКалендаря = Описание.БезКалендаря;
	Для Каждого День Из Описание.Дни Цикл
		Смена = СтанокОбъект.РежимРаботы.Добавить();
		Смена.ДеньНедели = Перечисления.ДниНедели.Получить(Число(День) - 1);
		Смена.НачалоСмены = Дата(1, 1, 1, Описание.ЧасНачала, 0, 0);
		Смена.ОкончаниеСмены = Дата(1, 1, 1, Описание.ЧасОкончания, 0, 0);
	КонецЦикла;
	СтанокОбъект.Записать();
	Возврат СтанокОбъект.Ссылка;

КонецФункции

// Три последних рабочих интервала станка, целиком завершённых до начала набора (поиск назад не дальше 14 дней).
// Сегодняшний незавершённый интервал не берётся. Каждый интервал - не короче 8 часов: в него укладываются события дня.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Станок   - СправочникСсылка.ПроизводственноеОборудование - станок E1
//
// Возвращаемое значение:
//  Структура, Строка - Интервалы (Массив из Структура: Начало, Окончание), Инфо (Строка); строка - причина пропуска
//
Функция ОкноСтанков(Контекст, Станок)

	// BSLLS:MagicNumber-off - 14 дней назад, 3 интервала, 8 часов.
	Граница = Контекст.Дата;
	Сутки = 86400;
	Таблица = ЗагрузкаСтанков.ИнтервалыРаботыСтанка(Станок, НачалоДня(Граница) - 14 * Сутки, НачалоДня(Граница) + Сутки);
	Подходящие = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Если Строка.Окончание <= Граница Тогда
			Подходящие.Добавить(Новый Структура("Начало, Окончание", Строка.Начало, Строка.Окончание));
		КонецЕсли;
	КонецЦикла;
	Если Подходящие.Количество() < 3 Тогда
		Возврат НСтр("ru = 'у станка меньше трёх завершённых смен за 14 дней - повторите позже';
			|fr = 'la machine a moins de trois équipes terminées sur 14 jours - relancez plus tard';
			|en = 'the machine has fewer than three finished shifts in 14 days - run it later';
			|es = 'la máquina tiene menos de tres turnos terminados en 14 días - vuelva a ejecutar más tarde'");
	КонецЕсли;
	Интервалы = Новый Массив;
	Для Индекс = Подходящие.Количество() - 3 По Подходящие.Количество() - 1 Цикл
		Интервал = Подходящие[Индекс];
		Если Интервал.Окончание - Интервал.Начало < 8 * 3600 Тогда
			Возврат НСтр("ru = 'смена станка короче 8 часов - события дня в неё не укладываются';
				|fr = 'l''équipe de la machine dure moins de 8 heures';
				|en = 'the machine shift is shorter than 8 hours'; es = 'el turno de la máquina dura menos de 8 horas'");
		КонецЕсли;
		Интервалы.Добавить(Интервал);
	КонецЦикла;
	// BSLLS:MagicNumber-on
	Инфо = "";
	Если НачалоМесяца(Интервалы[0].Начало) < НачалоМесяца(Граница) Тогда
		Инфо = НСтр("ru = 'часть факта станков - в прошлом месяце: в отчётах выберите период шире «Этого месяца»';
			|fr = 'une partie du réalisé des machines est le mois dernier : choisissez une période plus large que « Ce mois »';
			|en = 'part of the machine actuals is in the previous month: choose a period wider than ""This month"" in reports';
			|es = 'parte de lo real de las máquinas está en el mes anterior: elija un periodo más amplio que «Este mes»'");
	КонецЕсли;
	Возврат Новый Структура("Интервалы, Инфо", Интервалы, Инфо);

КонецФункции

// У блока нет своей истории без ключей: по номенклатуре и станкам блока нет движений - партии и загрузки в прошлом ни
// с чем не пересекутся.
//
// Параметры:
//  М - Структура - см. СправочникиСтанков
//
// Возвращаемое значение:
//  Строка - причина пропуска; пустая строка - движений нет
//
Функция ИсторияБлокаСтанков(М)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК ЕстьДвижение
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии КАК Т
		|ГДЕ
		|	Т.Номенклатура В (&Позиции)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	1
		|ИЗ
		|	РегистрНакопления.МатериалыНаСтанках КАК Т
		|ГДЕ
		|	Т.Станок В (&Станки)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	1
		|ИЗ
		|	РегистрСведений.ЗагрузкаСтанков КАК Т
		|ГДЕ
		|	Т.Станок В (&Станки)");
	Позиции = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(М.Гранулы);
	Позиции.Добавить(М.Нить);
	Позиции.Добавить(М.Мешок);
	Станки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(М.E1);
	Станки.Добавить(М.M1);
	Станки.Добавить(М.P1);
	Запрос.УстановитьПараметр("Позиции", Позиции);
	Запрос.УстановитьПараметр("Станки", Станки);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат "";
	КонецЕсли;
	Возврат НСтр("ru = 'по номенклатуре или станкам блока уже есть движения без ключей блока - удалите их и повторите';
		|fr = 'des mouvements sans clés du bloc existent déjà sur ses articles ou machines - supprimez-les et relancez';
		|en = 'the block items or machines already have movements without block keys - delete them and run again';
		|es = 'los artículos o máquinas del bloque ya tienen movimientos sin claves del bloque - elimínelos y vuelva a ejecutar'");

КонецФункции

// Техкарта мешка на начало первого дня окна: заказ датирован этим днём, заполнение материалов читает карту на дату
// заказа. Переиспользованной продукции карта не пишется - проверяется, что версия на этот день есть.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  М        - Структура - см. СправочникиСтанков
//  День     - Дата - начало первого дня окна
//
// Возвращаемое значение:
//  Строка - причина пропуска; пустая строка - карта есть
//
Функция КартаБлокаСтанков(Контекст, М, День)

	Если М.МешокСоздан Тогда
		// BSLLS:MagicNumber-off - 0,5 кг гранул и 0,2 кг нити на мешок.
		Состав = СоставДемо(Контекст, М.Гранулы, 0.5, М.Нить, 0.2);
		Состав.ЗаполнитьЗначения(М.Кг, "Упаковка");
		ТехнологическиеКарты.ЗаписатьТехкарту(М.Мешок, Состав, День);
		// BSLLS:MagicNumber-on
		Возврат "";
	КонецЕсли;
	Если ТехнологическиеКарты.СоставТехкарт(М.Мешок, День).Количество() > 0 Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'у «%1» нет техкарты на %2'; fr = '« %1 » n''a pas de gamme au %2';
		|en = '""%1"" has no routing on %2'; es = '«%1» no tiene ruta al %2'");
	Возврат СтрШаблон(Шаблон, М.Мешок, Формат(День, "ДЛФ=D"));

КонецФункции

// Документы факта 1-10: закупка и заказ до первой смены, требования, обслуживание, инвентаризация на станках.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  М        - Структура - см. СправочникиСтанков
//  Окно     - Структура - см. ОкноСтанков
//  Кейс     - Структура - пополняется полями документов
//
Процедура ДокументыФактаСтанков(Контекст, М, Окно, Кейс)

	// BSLLS:MagicNumber-off - часы событий от границ интервалов и количества блока (план, §4.4).
	Час = 3600;
	Запуск = "Запустить";
	Н1 = Окно.Интервалы[0].Начало;
	Н2 = Окно.Интервалы[1].Начало;
	К2 = Окно.Интервалы[1].Окончание;
	Н3 = Окно.Интервалы[2].Начало;

	// 1-2. Закупка и заказ - за час до первой смены, без проверки интервала.
	Строки = ДобавитьСтрокуДемо(Новый Массив, М.Гранулы, 300);
	ДобавитьСтрокуДемо(Строки, М.Нить, 100);
	Поступление = ДемоЗакупка(Контекст, М.Поставщик, Перечисления.СтатусыДокументов.Завершен, Строки, Н1 - Час);
	Кейс.Вставить("Поступление", Поступление);
	Заказ = ДемоЗаказКлиента(Контекст, М.Клиент, Перечисления.ВидыОперацийЗаказаПокупателя.Производство, М.Мешок, 40);
	ЦенаМешка = Контекст.ЦеныПродажи[М.Мешок];
	Для Каждого Количество Из СтрРазделить("30,20", ",") Цикл
		Обработки.ТестыДокументов.ДобавитьСтрокуТоваров(Контекст, Заказ, ИмяТоваров(), М.Мешок, Число(Количество), ЦенаМешка);
	КонецЦикла;
	Заказ.Дата = Н1 - Час + ШагДемоНабора();
	Заказ.ДатаОтгрузки = Заказ.Дата;
	ЗаполнитьМатериалыЗаказа(Заказ);
	ЗаписатьДокументКейса(Контекст, Заказ, Истина);
	Кейс.Заказ = Заказ.Ссылка;
	Коды = Новый Массив;
	Для Каждого СтрокаЗаказа Из Заказ.ТЧТовары Цикл
		Коды.Добавить(СтрокаЗаказа.КодСтроки);
	КонецЦикла;
	Кейс.Вставить("КодыСтрок", Коды);

	// 3. E1, строка 1: запущено и завершено в первую смену, гранул израсходовано на 2 кг меньше перемещённого.
	Требование = НовоеТребованиеДемо(Контекст, М.E1, Заказ.Ссылка, Коды[0], 40, Н1);
	Требование.ФактНачало = Н1;
	ТребованияНакладные.ВыполнитьДействие(Требование, Запуск);
	ЗавершитьТребованиеДемо(Требование, Н1 + 6.5 * Час, М.Гранулы, 2);
	Кейс.Вставить("Завершено", Требование.Ссылка);

	// 4. M1, строка 2: завершено во вторую смену, нити израсходовано на 1 кг меньше.
	Требование = НовоеТребованиеДемо(Контекст, М.M1, Заказ.Ссылка, Коды[1], 30, Н2);
	Требование.ФактНачало = Н2;
	ТребованияНакладные.ВыполнитьДействие(Требование, Запуск);
	ЗавершитьТребованиеДемо(Требование, Н2 + 4 * Час, М.Нить, 1);
	Кейс.Вставить("ЗавершеноВторой", Требование.Ссылка);

	// 5. Авария E1 во вторую смену.
	Ремонт = ДемоОбслуживание(Контекст, М.E1, Перечисления.ВидыОбслуживанияСтанков.Ремонт, Ложь, Н2 + 2 * Час,
		Н2 + 4 * Час, Н2 + 2 * Час);
	Ремонт.Затраты = 300;
	ЗаписатьДокументКейса(Контекст, Ремонт, Истина);
	Кейс.Вставить("Ремонт", Ремонт.Ссылка);

	// 6-7. Инвентаризация E1 до следующего запуска: из 2 кг свободных гранул найден 1, недостача списана.
	Пересчет = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "ПересчётТоваров");
	Пересчет.Дата = К2 - 2 * Час;
	Пересчет.МестоХранения = Справочники.МестаХранения.ПустаяСсылка();
	Пересчет.ВидОперации = Перечисления.ВидыСкладскихОпераций.Станок;
	Пересчет.Станок = М.E1;
	СтрокаПересчета = Пересчет.ТЧТовары.Добавить();
	СтрокаПересчета.Номенклатура = М.Гранулы;
	СтрокаПересчета.Упаковка = М.Кг;
	СтрокаПересчета.КоличествоУпаковок = 2;
	СтрокаПересчета.Количество = 2;
	СтрокаПересчета.КоличествоУпаковокФакт = 1;
	СтрокаПересчета.КоличествоФакт = 1;
	ЗаписатьДокументКейса(Контекст, Пересчет, Ложь);
	Кейс.Вставить("Пересчет", Пересчет.Ссылка);
	Списание = Документы.СписаниеТоваров.СоздатьДокумент();
	Списание.Заполнить(Пересчет.Ссылка);
	Списание.Дата = Пересчет.Дата + ШагДемоНабора();
	Списание.СтатьяДДС = Обработки.ТестыДокументов.СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	ЗаписатьДокументКейса(Контекст, Списание, Истина);
	Кейс.Вставить("Списание", Списание.Ссылка);

	// 8. Излишек нити на M1.
	Оприходование = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "ОприходованиеТоваров");
	Оприходование.Дата = Пересчет.Дата + 2 * ШагДемоНабора();
	Оприходование.МестоХранения = Справочники.МестаХранения.ПустаяСсылка();
	Оприходование.ВидОперации = Перечисления.ВидыСкладскихОпераций.Станок;
	Оприходование.Станок = М.M1;
	ЦенаНити = Контекст.ЦеныЗакупки[М.Нить];
	Обработки.ТестыДокументов.ДобавитьСтрокуТоваров(Контекст, Оприходование, ИмяТоваров(), М.Нить, 2, ЦенаНити);
	УпаковкаСтрокПоЕдинице(Оприходование, ИмяТоваров());
	ЗаписатьДокументКейса(Контекст, Оприходование, Истина);
	Кейс.Вставить("Оприходование", Оприходование.Ссылка);

	// 9. Плановое ТО E1 в начале третьей смены, переведённое в факт с задержкой на полчаса.
	ТО = ДемоОбслуживание(Контекст, М.E1, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Н3, Н3 + 2 * Час, Н3);
	ЗаписатьДокументКейса(Контекст, ТО, Истина);
	ТО.Плановое = Ложь;
	ТО.Окончание = Н3 + 2.5 * Час;
	Обработки.ТестыДокументов.Провести(ТО);
	Кейс.Вставить("ТО", ТО.Ссылка);

	// 10. E1, строка 3: запущено в третью смену и не завершено - закрепляет 1 кг гранул после инвентаризации.
	Требование = НовоеТребованиеДемо(Контекст, М.E1, Заказ.Ссылка, Коды[2], 20, Н3 + 3 * Час);
	Требование.ФактНачало = Н3 + 3 * Час;
	ТребованияНакладные.ВыполнитьДействие(Требование, Запуск);
	Кейс.Вставить("Запущено", Требование.Ссылка);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Документы плана 11-14: второй заказ на производство (в стадии «Заказ поставщику» - он попадает в «Готовы к запуску»,
// а первый после выпусков - уже нет), требования по нему и плановое ТО. Дата документа - момент прогона, плановое время -
// в будущем через ПланНачало.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  М        - Структура - см. СправочникиСтанков
//  Кейс     - Структура - пополняется полями документов
//
Процедура ДокументыПланаСтанков(Контекст, М, Кейс)

	// BSLLS:MagicNumber-off - смещения плана и количества (план, §4.4).
	Час = 3600;

	// 11. Второй заказ: 15 мешков, материалы - из общего остатка склада набора, закупки под заказ нет.
	ЗаказПлан = ДемоЗаказКлиента(Контекст, М.Клиент, Перечисления.ВидыОперацийЗаказаПокупателя.Производство, М.Мешок, 15);
	ЗаполнитьМатериалыЗаказа(ЗаказПлан);
	ЗаписатьДокументКейса(Контекст, ЗаказПлан, Истина);
	Кейс.Вставить("ЗаказПлан", ЗаказПлан.Ссылка);
	КодСтроки = ЗаказПлан.ТЧТовары[0].КодСтроки;
	Кейс.Вставить("КодСтрокиПлана", КодСтроки);

	// 12. E1: размещено на будущую смену и отменено.
	Дата = Обработки.ТестыДокументов.СледующаяДата(Контекст);
	Требование = НовоеТребованиеДемо(Контекст, М.E1, ЗаказПлан.Ссылка, КодСтроки, 5, Дата);
	Требование.ПланНачало = БудущийИнтервал(М.E1, 1) + 4 * Час;
	ТребованияНакладные.ВыполнитьДействие(Требование, "Разместить");
	ТребованияНакладные.ВыполнитьДействие(Требование, "Отменить");
	Кейс.Вставить("Отменено", Требование.Ссылка);

	// 13. M1: размещено на будущую смену.
	Дата = Обработки.ТестыДокументов.СледующаяДата(Контекст);
	Требование = НовоеТребованиеДемо(Контекст, М.M1, ЗаказПлан.Ссылка, КодСтроки, 5, Дата);
	Требование.ПланНачало = БудущийИнтервал(М.M1, 1);
	ТребованияНакладные.ВыполнитьДействие(Требование, "Разместить");
	Кейс.Вставить("Запланировано", Требование.Ссылка);

	// 14. Плановое ТО простаивающего P1 через три смены.
	Начало = БудущийИнтервал(М.P1, 3);
	ТО = ДемоОбслуживание(Контекст, М.P1, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Начало,
		Начало + 2 * Час, Обработки.ТестыДокументов.СледующаяДата(Контекст));
	ЗаписатьДокументКейса(Контекст, ТО, Истина);
	Кейс.Вставить("ТОПлановое", ТО.Ссылка);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Начало рабочего интервала станка с завтрашнего дня.
//
// Параметры:
//  Станок - СправочникСсылка.ПроизводственноеОборудование - станок
//  Номер  - Число - номер интервала, 1 - первый
//
// Возвращаемое значение:
//  Дата - начало интервала
//
Функция БудущийИнтервал(Станок, Номер)

	// BSLLS:MagicNumber-off - горизонт 21 день.
	Сутки = 86400;
	Завтра = НачалоДня(ТекущаяДатаСеанса()) + Сутки;
	Интервалы = ЗагрузкаСтанков.ИнтервалыРаботыСтанка(Станок, Завтра, Завтра + 21 * Сутки);
	// BSLLS:MagicNumber-on
	Если Интервалы.Количество() < Номер Тогда
		ВызватьИсключение СтрШаблон("У станка %1 нет %2 рабочих смен в ближайшие три недели", Станок, Номер);
	КонецЕсли;
	Возврат Интервалы[Номер - 1].Начало;

КонецФункции

// Незаписанное требование-накладная по строке заказа, как в сценариях ТестыДокументов: одна структура данных заполнения.
// Ключ кейса ставится до первого действия - оно записывает документ.
//
// Параметры:
//  Контекст   - Структура - см. ВыполнитьБлоки
//  Станок     - СправочникСсылка.ПроизводственноеОборудование - станок
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  КодСтроки  - Число - код строки продукции
//  Количество - Число - количество продукции
//  Дата       - Дата - дата документа
//
// Возвращаемое значение:
//  ДокументОбъект.ТребованиеНакладная - требование
//
Функция НовоеТребованиеДемо(Контекст, Станок, Заказ, КодСтроки, Количество, Дата)

	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Станок", Станок);
	ДанныеЗаполнения.Вставить("Заказ", Заказ);
	ДанныеЗаполнения.Вставить("КодСтрокиПродукции", КодСтроки);
	ДанныеЗаполнения.Вставить("Количество", Количество);
	Требование = Документы.ТребованиеНакладная.СоздатьДокумент();
	Требование.Заполнить(ДанныеЗаполнения);
	Требование.Дата = Дата;
	Требование.Организация = Контекст.Организация;
	Требование.МестоХранения = Контекст.Склад;
	Требование.Комментарий = СледующийКлюч(Контекст);
	Возврат Требование;

КонецФункции

// «Завершить» запущенное требование: выпущено всё, израсходовано всё, кроме недорасхода одного материала.
//
// Параметры:
//  Требование  - ДокументОбъект.ТребованиеНакладная - запущенное требование
//  Окончание   - Дата - факт окончания
//  Материал    - СправочникСсылка.Номенклатура - материал с недорасходом
//  Недорасход  - Число - сколько этого материала осталось на станке
//
Процедура ЗавершитьТребованиеДемо(Требование, Окончание, Материал, Недорасход)

	Для Каждого Строка Из Требование.Материалы Цикл
		Строка.Израсходовано = Строка.Количество - ?(Строка.Номенклатура = Материал, Недорасход, 0);
	КонецЦикла;
	Требование.КоличествоФакт = Требование.Количество;
	Требование.ФактОкончание = Окончание;
	ТребованияНакладные.ВыполнитьДействие(Требование, "Завершить");

КонецПроцедуры

// Незаписанное обслуживание станка.
//
// Параметры:
//  Контекст  - Структура - см. ВыполнитьБлоки
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Вид       - ПеречислениеСсылка.ВидыОбслуживанияСтанков - вид
//  Плановое  - Булево - запланированное
//  Начало    - Дата - начало
//  Окончание - Дата - окончание
//  Дата      - Дата - дата документа
//
// Возвращаемое значение:
//  ДокументОбъект.ОбслуживаниеСтанка - обслуживание
//
Функция ДемоОбслуживание(Контекст, Станок, Вид, Плановое, Начало, Окончание, Дата)

	Обслуживание = Документы.ОбслуживаниеСтанка.СоздатьДокумент();
	Обслуживание.Дата = Дата;
	Обслуживание.Станок = Станок;
	Обслуживание.ВидОбслуживания = Вид;
	Обслуживание.Плановое = Плановое;
	Обслуживание.Начало = Начало;
	Обслуживание.Окончание = Окончание;
	Обслуживание.Причина = ПометкаДемоНабора();
	Возврат Обслуживание;

КонецФункции

Функция ИмяТоваров()

	Возврат "ТЧТовары";

КонецФункции

// Упаковка строк - единица номенклатуры строки: помощник тестов ставит единицу набора (штуки), а у материалов станков -
// килограммы.
//
// Параметры:
//  Док   - ДокументОбъект - документ
//  ИмяТЧ - Строка - табличная часть с колонками Номенклатура и Упаковка
//
Процедура УпаковкаСтрокПоЕдинице(Док, ИмяТЧ)

	Для Каждого Строка Из Док[ИмяТЧ] Цикл
		Строка.Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Номенклатура, "Единица");
	КонецЦикла;

КонецПроцедуры

