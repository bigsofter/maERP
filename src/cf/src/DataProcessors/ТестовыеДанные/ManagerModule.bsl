// T. Коммерческие предложения в ручных статусах; «Выигран» - предложение кейса P1.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Структура - кейс
//
Функция ДемоКоммерческиеПредложения(Контекст)

	Статусы = Перечисления.СтатусыКоммерческихПредложений;
	Клиент = Контекст.Участники.Majorelle;
	Lampe = Контекст.Номенклатура.Lampe;
	Кейс = НовыйКейс();
	Для Каждого ИмяСтатуса Из СтрРазделить("Черновик,Отправлен,Доставлен,Проигран", ",") Цикл
		// BSLLS:MagicNumber-off - Lampe 3.
		Предложение = ДемоПредложение(Контекст, Клиент, Lampe, 3, Статусы[ИмяСтатуса]);
		// BSLLS:MagicNumber-on
		Кейс.Вставить(ИмяСтатуса, Предложение);
	КонецЦикла;
	Возврат Кейс;

КонецФункции

// S1-S7. Заказы-продажи во всех статусах, которые ставит механизм: каждый - отдельный кейс.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Код      - Строка - код кейса S1…S7
//
// Возвращаемое значение:
//  Структура - кейс
//
// BSLLS:CognitiveComplexity-off - ветка на кейс.
// BSLLS:CyclomaticComplexity-off - та же причина.
Функция ДемоЗаказПродажи(Контекст, Код)

	Н = Контекст.Номенклатура;
	У = Контекст.Участники;
	Продажа = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	// BSLLS:MagicNumber-off - количества кейсов набора.
	Если Код = "S1" Тогда
		Заказ = ДемоЗаказКлиента(Контекст, У.Riad, Продажа, Н.Lampe, 1);
		ЗаписатьДокументКейса(Контекст, Заказ, Ложь);
		Возврат НовыйКейс(Заказ.Ссылка);
	ИначеЕсли Код = "S2" Тогда
		Заказ = ДемоЗаказКлиента(Контекст, У.Atlas, Продажа, Н.Lampe, 2);
		Заказ.МенеджерПодтвердилПроверилОстаток = Истина;
		ЗаписатьДокументКейса(Контекст, Заказ, Ложь);
		Возврат НовыйКейс(Заказ.Ссылка);
	ИначеЕсли Код = "S3" Тогда
		Заказ = ДемоЗаказКлиента(Контекст, У.Majorelle, Продажа, Н.Lampe, 1);
		ЗаписатьДокументКейса(Контекст, Заказ, Ложь);
		Кейс = НовыйКейс(Заказ.Ссылка);
		Кейс.Вставить("Реализация", ДемоРеализацияПоЗаказу(Контекст, У.Majorelle, Заказ.Ссылка, Неопределено));
		Возврат Кейс;
	ИначеЕсли Код = "S4" Тогда
		Заказ = ДемоЗаказКлиента(Контекст, У.Atlas, Продажа, Н.Table, 1);
		ЗаписатьДокументКейса(Контекст, Заказ, Ложь);
		Кейс = НовыйКейс(Заказ.Ссылка);
		Кейс.Вставить("Выпуск", ДемоВыпуск(Контекст, Заказ.Ссылка, Н.Table, 1));
		Возврат Кейс;
	ИначеЕсли Код = "S5" Тогда
		Заказ = ДемоЗаказКлиента(Контекст, У.Riad, Продажа, Н.Chaise, 2);
		ЗаписатьДокументКейса(Контекст, Заказ, Ложь);
		Выпуск = ДемоВыпуск(Контекст, Заказ.Ссылка, Н.Chaise, 2);
		Реализация = ДемоРеализацияПоЗаказу(Контекст, У.Riad, Заказ.Ссылка, Неопределено);
		// Перепроведение выпуска после отгрузки: тот же документ, ключ уже в нём.
		ВыпускОбъект = Выпуск.ПолучитьОбъект();
		Обработки.ТестыДокументов.Провести(ВыпускОбъект);
		Кейс = НовыйКейс(Заказ.Ссылка);
		Кейс.Вставить("Выпуск", Выпуск);
		Кейс.Вставить("Реализация", Реализация);
		Возврат Кейс;
	ИначеЕсли Код = "S6" Тогда
		Заказ = ДемоЗаказКлиента(Контекст, У.Majorelle, Продажа, Н.Coussin, 3);
		ЗаписатьДокументКейса(Контекст, Заказ, Ложь);
		Кейс = НовыйКейс(Заказ.Ссылка);
		Кейс.Вставить("Передача", ДемоПередачаВПереработку(Контекст, Заказ.Ссылка, 3));
		Возврат Кейс;
	Иначе
		Заказ = ДемоЗаказКлиента(Контекст, У.Atlas, Продажа, Н.Coussin, 2);
		ЗаписатьДокументКейса(Контекст, Заказ, Ложь);
		Передача = ДемоПередачаВПереработку(Контекст, Заказ.Ссылка, 2);
		ДемоПоступлениеИзПереработки(Контекст, Передача, 40);
		Кейс = НовыйКейс(Заказ.Ссылка);
		Кейс.Вставить("Передача", Передача);
		Возврат Кейс;
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецФункции
// BSLLS:CyclomaticComplexity-on
// BSLLS:CognitiveComplexity-on

// R. Реализации без заказа: оплачена полностью с возвратом, оплачена частично, черновик; возврат поставщику и оплаты
// поставщикам.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//  Закупки  - Структура - кейс R1
//
// Возвращаемое значение:
//  Структура - кейс
//
Функция ДемоРеализацииИОплаты(Контекст, Закупки)

	Н = Контекст.Номенклатура;
	У = Контекст.Участники;
	// BSLLS:MagicNumber-off - количества и суммы кейса R.
	ДемоВозвратПоставщику(Контекст, У.Casa, Закупки.Лампы, 2);
	ДемоРасходныйОрдер(Контекст, У.Casa, Закупки.Лампы, 3000);
	ДемоСписаниеСоСчета(Контекст, У.Bois, Закупки.Материалы, 1500);
	Полная = ДемоРеализация(Контекст, У.Atlas, Н.Lampe, 3, Истина);
	ДемоПриходныйОрдер(Контекст, У.Atlas, Полная, 1800);
	ДемоВозвратОтПокупателя(Контекст, Полная, 1);
	Частичная = ДемоРеализация(Контекст, У.Riad, Н.Lampe, 2, Истина);
	ДемоПриходныйОрдер(Контекст, У.Riad, Частичная, 500);
	Черновик = ДемоРеализация(Контекст, У.Majorelle, Н.Lampe, 1, Ложь);
	// BSLLS:MagicNumber-on
	Кейс = НовыйКейс();
	Кейс.Вставить("Полная", Полная);
	Кейс.Вставить("Частичная", Частичная);
	Кейс.Вставить("Черновик", Черновик);
	Возврат Кейс;

КонецФункции

// C. Договоры Hôtel Majorelle в статусах «Не согласован» и «Закрыт». Ключ - в комментарии договора.
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьБлоки
//
// Возвращаемое значение:
//  Структура - кейс
//
Функция ДемоДоговоры(Контекст)

	Клиент = Контекст.Участники.Majorelle.Ссылка;
	Статусы = Перечисления.СтатусыДоговоровКонтрагентов;
	Вид = Перечисления.ВидыДоговоров.СПокупателем;
	Кейс = НовыйКейс();
	НеСогласован = НовыйДоговорДемо(Контекст, Клиент, Вид, Статусы.НеСогласован, "Contrat cadre 2027", Ложь);
	НеСогласован.Комментарий = СледующийКлюч(Контекст);
	НеСогласован.Записать();
	Кейс.Вставить("НеСогласован", НеСогласован.Ссылка);
	Закрыт = НовыйДоговорДемо(Контекст, Клиент, Вид, Статусы.Закрыт, "Contrat 2025", Ложь);
	Закрыт.Комментарий = СледующийКлюч(Контекст);
	Закрыт.Записать();
	Кейс.Вставить("Закрыт", Закрыт.Ссылка);
	Возврат Кейс;

КонецФункции

// L. Лиды во всех статусах. Ключ - в комментарии записи регистра.
