// Маркер уже заведённого набора, в том числе помеченный на удаление.
//
// Возвращаемое значение:
//  Структура, Неопределено - Ссылка, ПометкаУдаления; Неопределено - набора нет
//
Функция МаркерДемоНабора()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Наименование = &Наименование");
	Запрос.УстановитьПараметр("Наименование", ИмяМаркераДемоНабора());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Ссылка, ПометкаУдаления", Выборка.Ссылка, Выборка.ПометкаУдаления);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Навигационные ссылки документов и элементов кейса - строками отчёта ССЫЛКА;<код>;<поле>;<ссылка>: по ним открываются
// формы для ручной приёмки и скриншотов инструкций.
//
// Параметры:
//  Строки - Массив из Строка - строки отчёта
//  Код    - Строка - код кейса
//  Кейс   - Структура - см. НовыйКейс
//
Процедура ДобавитьСсылкиКейса(Строки, Код, Кейс)

	Для Каждого Поле Из Кейс Цикл
		Значения = Новый Массив;
		Если ТипЗнч(Поле.Значение) = Тип("Массив") Тогда
			Значения = Поле.Значение;
		Иначе
			Значения.Добавить(Поле.Значение);
		КонецЕсли;
		Для Каждого Значение Из Значения Цикл
			Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) И ЗначениеЗаполнено(Значение) Тогда
				Строки.Добавить("ССЫЛКА;" + Код + ";" + Поле.Ключ + ";" + ПолучитьНавигационнуюСсылку(Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Новый кейс набора с описанием для отчёта; прочие документы кейса вызывающий добавляет полями.
//
// Параметры:
//  Кейсы    - Соответствие - см. ЗаполнитьДемоНабор
//  Код      - Строка - код кейса
//  Описание - Строка - описание для отчёта
//  Заказ    - ДокументСсылка.ЗаказПокупателя, Неопределено - заказ кейса, поле Заказ
//
// Возвращаемое значение:
//  Структура - кейс с полями Описание и Заказ
//
Функция НовыйКейс(Кейсы, Код, Описание, Заказ = Неопределено)

	Кейс = Новый Структура;
	Кейс.Вставить("Описание", Описание);
	Кейс.Вставить("Заказ", Заказ);
	Кейсы.Вставить(Код, Кейс);
	Возврат Кейс;

КонецФункции

#Область СправочникиДемоНабора

// Справочники набора: единица, склад, касса, счёт, контрагенты с договорами, номенклатура с ценами и техкартами.
//
// Параметры:
//  Контекст - Структура - см. Обработки.ТестыДокументов.НовыйКонтекстДанных; пополняется полями Единица, Склад, Касса,
//             Счет, Участники, Номенклатура, ЦеныПродажи, ЦеныЗакупки
//
Процедура ЗаполнитьСправочникиДемоНабора(Контекст)

	Единица = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	Единица.Наименование = "pce (Démo)" + Контекст.Суффикс;
	Единица.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
	Единица.Числитель = 1;
	Единица.Знаменатель = 1;
	Единица.Записать();
	Контекст.Вставить("Единица", Единица.Ссылка);

	Склад = Справочники.МестаХранения.СоздатьЭлемент();
	Склад.Наименование = ИмяДемо(Контекст, "Atelier");
	Склад.Записать();
	Контекст.Вставить("Склад", Склад.Ссылка);

	Касса = Справочники.Кассы.СоздатьЭлемент();
	Касса.Владелец = Контекст.Организация;
	Касса.Наименование = ИмяДемо(Контекст, "Caisse");
	Касса.Валюта = Контекст.Валюта;
	Касса.МестоХранения = Контекст.Склад;
	Касса.Записать();
	Контекст.Вставить("Касса", Касса.Ссылка);

	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Владелец = Контекст.Организация;
	Счет.Наименование = ИмяДемо(Контекст, "Banque");
	Счет.Валюта = Контекст.Валюта;
	// BSLLS:YoLetterUsage-off
	Счет.НомерСчёта = "DEMO-2MZL";
	Счет.ТипСчёта = Перечисления.ТипыБанковскихСчетов.Расчетный;
	// BSLLS:YoLetterUsage-on
	Счет.Банк = ПервыйЭлемент("Банки");
	Счет.Записать();
	Контекст.Вставить("Счет", Счет.Ссылка);

	Участники = Новый Структура;
	// Маркер набора - первым: по его наименованию повторный запуск видит заведённый набор.
	Участник = ДемоУчастник(Контекст, "Café Atlas", Истина, Ложь, "DEMO01");
	Участники.Вставить("Atlas", Участник);
	Участник = ДемоУчастник(Контекст, "Riad Andalous", Истина, Ложь, "DEMO02");
	Участники.Вставить("Riad", Участник);
	Участник = ДемоУчастник(Контекст, "Hôtel Majorelle", Истина, Ложь, "DEMO03");
	Участники.Вставить("Majorelle", Участник);
	Участник = ДемоУчастник(Контекст, "Bois & Métal SARL", Ложь, Ложь, "DEMO04");
	Участники.Вставить("Bois", Участник);
	Участник = ДемоУчастник(Контекст, "Luminaires Casa", Ложь, Ложь, "DEMO05");
	Участники.Вставить("Casa", Участник);
	Участник = ДемоУчастник(Контекст, "Textiles du Nord", Ложь, Истина, "DEMO06");
	Участники.Вставить("Textiles", Участник);
	Контекст.Вставить("Участники", Участники);

	ЗаполнитьНоменклатуруДемоНабора(Контекст);

КонецПроцедуры

// Номенклатура набора, цены и технологические карты.
//
// Параметры:
//  Контекст - Структура - см. ЗаполнитьСправочникиДемоНабора
//
Процедура ЗаполнитьНоменклатуруДемоНабора(Контекст)

	Типы = Перечисления.ТипыНоменклатуры;
	Способы = Перечисления.СпособыПополненияЗапасов;
	Н = Новый Структура;
	ЦеныПродажи = Новый Соответствие;
	ЦеныЗакупки = Новый Соответствие;
	// BSLLS:MagicNumber-off - цены и нормы демо-набора (план .ai/plans/production-2mzl-e11-demo.md, §2).
	Позиция = ДемоНоменклатура(Контекст, "Planche chêne", Типы.Сырье, Способы.Закупка);
	Н.Вставить("Planche", Позиция);
	Позиция = ДемоНоменклатура(Контекст, "Pied acier", Типы.Сырье, Способы.Закупка);
