//
// Возвращаемое значение:
//  ДокументСсылка.ЗаявкаНаПоискТовара - заявка
//
Функция ДемоЗаявка(Контекст, Описание, Статус, Номенклатура)

	Заявка = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "ЗаявкаНаПоискТовара");
	Заявка.Контрагент = Контекст.Участники.Riad.Ссылка;
	Заявка.Описание = Описание + Контекст.Суффикс;
	Заявка.Статус = Статус;
	Если Номенклатура <> Неопределено Тогда
		Заявка.Номенклатура = Номенклатура;
	КонецЕсли;
	Обработки.ТестыДокументов.Записать(Заявка);
	Возврат Заявка.Ссылка;

