#Область ДокументыДемоНабора

// Подставляет в контекст контрагента и договоры участника: помощники тестов документов берут их из контекста.
//
// Параметры:
//  Контекст - Структура - см. ЗаполнитьДемоНабор
//  Участник - Структура - см. ДемоУчастник
//
Процедура ВыбратьУчастника(Контекст, Участник)

	Контекст.Вставить("Контрагент", Участник.Ссылка);
	Контекст.Вставить("ДоговорПокупателя", Участник.ДоговорПокупателя);
	Контекст.Вставить("ДоговорПоставщика", Участник.ДоговорПоставщика);

КонецПроцедуры

// Добавляет строку документа набора.
//
// Параметры:
//  Строки       - Массив из Структура - пополняемые строки: Номенклатура, Количество
//  Номенклатура - СправочникСсылка.Номенклатура - позиция
//  Количество   - Число - количество
//
// Возвращаемое значение:
//  Массив из Структура - те же строки, для цепочки вызовов
//
Функция ДобавитьСтрокуДемо(Строки, Номенклатура, Количество)

	СтрокаДемо = Новый Структура("Номенклатура, Количество", Номенклатура, Количество);
	Строки.Добавить(СтрокаДемо);
	Возврат Строки;

КонецФункции

// Незаписанный заказ клиента с одной строкой товаров по цене продажи набора.
//
// Параметры:
//  Контекст     - Структура - см. ЗаполнитьДемоНабор
//  Участник     - Структура - см. ДемоУчастник
//  ВидОперации  - ПеречислениеСсылка.ВидыОперацийЗаказаПокупателя - вид операции
//  Номенклатура - СправочникСсылка.Номенклатура - позиция
//  Количество   - Число - количество
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя - заказ
//
Функция ДемоЗаказКлиента(Контекст, Участник, ВидОперации, Номенклатура, Количество)

	ВыбратьУчастника(Контекст, Участник);
	Заказ = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "ЗаказПокупателя");
	Заказ.Контрагент = Участник.Ссылка;
	Заказ.Договор = Участник.ДоговорПокупателя;
	Заказ.ЦенаВключаетНДС = Истина;
	Заказ.ДатаОтгрузки = Заказ.Дата;
	Заказ.ВидОперации = ВидОперации;
	Обработки.ТестыДокументов.ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Номенклатура, Количество,
		Контекст.ЦеныПродажи[Номенклатура]);
	Возврат Заказ;

КонецФункции

// Заказ клиента на производство с материалами по действующим картам.
//
// Параметры:
//  Контекст     - Структура - см. ЗаполнитьДемоНабор
//  Участник     - Структура - см. ДемоУчастник
//  Номенклатура - СправочникСсылка.Номенклатура - продукция или закупаемый товар
//  Количество   - Число - количество
//  Проводить    - Булево - провести; Ложь - записать черновиком
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПокупателя - заказ
//
Функция ДемоЗаказНаПроизводство(Контекст, Участник, Номенклатура, Количество, Проводить)

	Заказ = ДемоЗаказКлиента(Контекст, Участник, Перечисления.ВидыОперацийЗаказаПокупателя.Производство,
		Номенклатура, Количество);
	ЗаполнитьМатериалыЗаказа(Заказ);
	Если Проводить Тогда
		Обработки.ТестыДокументов.Провести(Заказ);
	Иначе
		Обработки.ТестыДокументов.Записать(Заказ);
	КонецЕсли;
	Возврат Заказ.Ссылка;

КонецФункции

Процедура ЗаполнитьМатериалыЗаказа(Заказ)

	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата, , Истина, Заказ);

КонецПроцедуры

// Коммерческое предложение на одну позицию в заданном статусе.
//
// Параметры:
//  Контекст     - Структура - см. ЗаполнитьДемоНабор
//  Участник     - Структура - см. ДемоУчастник
//  Номенклатура - СправочникСсылка.Номенклатура - позиция
//  Количество   - Число - количество
//  Статус       - ПеречислениеСсылка.СтатусыКоммерческихПредложений - статус, который ставит менеджер
//
// Возвращаемое значение:
//  ДокументСсылка.КоммерческоеПредложение - записанное предложение
//
Функция ДемоПредложение(Контекст, Участник, Номенклатура, Количество, Статус)

	ВыбратьУчастника(Контекст, Участник);
	Предложение = Документы.КоммерческоеПредложение.СоздатьДокумент();
	Предложение.Заполнить(Неопределено);
	Предложение.Дата = Обработки.ТестыДокументов.СледующаяДата(Контекст);
	Предложение.ДатаОтгрузки = Предложение.Дата;
	Предложение.Организация = Контекст.Организация;
	Предложение.Контрагент = Участник.Ссылка;
	Предложение.Договор = Участник.ДоговорПокупателя;
	Предложение.ЦенаВключаетНДС = Истина;
	Предложение.Комментарий = Контекст.Пометка;
	Обработки.ТестыДокументов.ДобавитьСтрокуТоваров(Контекст, Предложение, "ТЧТовары", Номенклатура, Количество,
		Контекст.ЦеныПродажи[Номенклатура]);
	Предложение.Статус = Статус;
	Обработки.ТестыДокументов.Записать(Предложение);
	Возврат Предложение.Ссылка;

КонецФункции

// Проведённое поступление на склад набора по закупочным ценам.
//
// Параметры:
//  Контекст  - Структура - см. ЗаполнитьДемоНабор
//  Поставщик - Структура - см. ДемоУчастник
//  Статус    - ПеречислениеСсылка.СтатусыДокументов - статус поступления
//  Строки    - Массив из Структура - см. ДобавитьСтрокуДемо
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеТоваровУслуг - поступление
//
Функция ДемоЗакупка(Контекст, Поставщик, Статус, Строки)

	ВыбратьУчастника(Контекст, Поставщик);
	Поступление = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Поступление.Контрагент = Поставщик.Ссылка;
	Поступление.Договор = Поставщик.ДоговорПоставщика;
	Поступление.ЦенаВключаетНДС = Истина;
	Поступление.Валюта = Контекст.Валюта;
	Поступление.КурсВалюты = 1;
	Поступление.Статус = Статус;
	Для Каждого СтрокаДемо Из Строки Цикл
		Обработки.ТестыДокументов.ДобавитьСтрокуТоваров(Контекст, Поступление, "ТЧТовары", СтрокаДемо.Номенклатура,
			СтрокаДемо.Количество, Контекст.ЦеныЗакупки[СтрокаДемо.Номенклатура]);
	КонецЦикла;
	Обработки.ТестыДокументов.Провести(Поступление);
	Возврат Поступление.Ссылка;

КонецФункции

// Проведённый заказ поставщику, заполненный по дефициту заказа клиента на производство.
//
// Параметры:
//  Контекст  - Структура - см. ЗаполнитьДемоНабор
//  Заказ     - ДокументСсылка.ЗаказПокупателя - проведённый заказ на производство
//  Поставщик - Структура - см. ДемоУчастник
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПоставщику - заказ поставщику
//
Функция ДемоЗаказПоставщикуПоПотребности(Контекст, Заказ, Поставщик)

	ВыбратьУчастника(Контекст, Поставщик);
	ЗаказПоставщику = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "ЗаказПоставщику");
	ДатаДокумента = ЗаказПоставщику.Дата;
	ЗаказПоставщику.Заполнить(Заказ);
	ЗаказПоставщику.Дата = ДатаДокумента;
	ЗаказПоставщику.Организация = Контекст.Организация;
	ЗаказПоставщику.ВидЗаказа = Перечисления.ВидыЗаказовПоставщику.Основной;
	ЗаказПоставщику.ДатаПоставки = ДатаДокумента;
	ЗаказПоставщику.Контрагент = Поставщик.Ссылка;
	ЗаказПоставщику.Договор = Поставщик.ДоговорПоставщика;
	ЗаказПоставщику.ЦенаВключаетНДС = Истина;
	Для Каждого СтрокаТЧ Из ЗаказПоставщику.ТЧТовары Цикл
		СтрокаТЧ.Цена = Контекст.ЦеныЗакупки[СтрокаТЧ.Номенклатура];
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТЧ, ЗаказПоставщику.ЦенаВключаетНДС);
	КонецЦикла;
	Обработки.ТестыДокументов.Провести(ЗаказПоставщику);
	Возврат ЗаказПоставщику.Ссылка;

КонецФункции

// Проведённое поступление по заказу поставщику: всё или доля каждой строки.
//
// Параметры:
//  Контекст        - Структура - см. ЗаполнитьДемоНабор
//  ЗаказПоставщику - ДокументСсылка.ЗаказПоставщику - основание
//  Доля            - Число - доля количества каждой строки, 1 - всё
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеТоваровУслуг - поступление
//
Функция ДемоПоступлениеПоЗаказуПоставщику(Контекст, ЗаказПоставщику, Доля)

	Поступление = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	ДатаДокумента = Поступление.Дата;
	Поступление.Заполнить(ЗаказПоставщику);
	Поступление.Дата = ДатаДокумента;
	Поступление.Организация = Контекст.Организация;
	Поступление.МестоХранения = Контекст.Склад;
	Поступление.Комментарий = Контекст.Пометка;
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Поступление.Валюта = Контекст.Валюта;
	Поступление.КурсВалюты = 1;
	Для Каждого СтрокаТЧ Из Поступление.ТЧТовары Цикл
		СтрокаТЧ.Цена = Контекст.ЦеныЗакупки[СтрокаТЧ.Номенклатура];
		Если Доля < 1 Тогда
			// BSLLS:MagicNumber-off - точность количества три знака.
			Обработки.ТестыДокументов.УстановитьКоличествоСтроки(СтрокаТЧ, Окр(СтрокаТЧ.Количество * Доля, 3));
			// BSLLS:MagicNumber-on
		КонецЕсли;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаТЧ, Поступление.ЦенаВключаетНДС);
	КонецЦикла;
	Обработки.ТестыДокументов.Провести(Поступление);
	Возврат Поступление.Ссылка;

КонецФункции

// Проведённая реализация, заполненная по заказу; при количестве - первая строка на это количество.
//
// Параметры:
//  Контекст   - Структура - см. ЗаполнитьДемоНабор
//  Участник   - Структура - см. ДемоУчастник
//  Заказ      - ДокументСсылка.ЗаказПокупателя - основание
//  Количество - Число, Неопределено - отгружаемое количество первой строки; Неопределено - по заказу
//
// Возвращаемое значение:
//  ДокументСсылка.РеализацияТоваровУслуг - реализация
//
Функция ДемоРеализацияПоЗаказу(Контекст, Участник, Заказ, Количество)

	ВыбратьУчастника(Контекст, Участник);
	Реализация = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	ДатаДокумента = Реализация.Дата;
	Реализация.Заполнить(Заказ);
	Реализация.Дата = ДатаДокумента;
	Реализация.МестоХранения = Контекст.Склад;
	Реализация.Комментарий = Контекст.Пометка;
	Если Количество <> Неопределено Тогда
		Обработки.ТестыДокументов.УстановитьКоличествоСтроки(Реализация.ТЧТовары[0], Количество);
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Реализация.ТЧТовары[0], Реализация.ЦенаВключаетНДС);
	КонецЕсли;
	Обработки.ТестыДокументов.Провести(Реализация);
	Возврат Реализация.Ссылка;

КонецФункции

// Реализация без заказа: проведённая или записанная черновиком.
//
// Параметры:
//  Контекст     - Структура - см. ЗаполнитьДемоНабор
//  Участник     - Структура - см. ДемоУчастник
//  Номенклатура - СправочникСсылка.Номенклатура - товар
//  Количество   - Число - количество
//  Проводить    - Булево - провести; Ложь - записать
//
// Возвращаемое значение:
//  ДокументСсылка.РеализацияТоваровУслуг - реализация
//
Функция ДемоРеализация(Контекст, Участник, Номенклатура, Количество, Проводить)

	ВыбратьУчастника(Контекст, Участник);
	Реализация = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Реализация.Контрагент = Участник.Ссылка;
	Реализация.Договор = Участник.ДоговорПокупателя;
	Реализация.ЦенаВключаетНДС = Истина;
	Обработки.ТестыДокументов.ДобавитьСтрокуТоваров(Контекст, Реализация, "ТЧТовары", Номенклатура, Количество,
		Контекст.ЦеныПродажи[Номенклатура]);
	Если Проводить Тогда
		Обработки.ТестыДокументов.Провести(Реализация);
	Иначе
		Обработки.ТестыДокументов.Записать(Реализация);
	КонецЕсли;
	Возврат Реализация.Ссылка;

КонецФункции

// Проведённый ручной выпуск по заказу с материалами по карте.
//
// Параметры:
//  Контекст   - Структура - см. ЗаполнитьДемоНабор
//  Заказ      - ДокументСсылка.ЗаказПокупателя - основание
//  Продукция  - СправочникСсылка.Номенклатура - продукция
//  Количество - Число - выпуск
//
// Возвращаемое значение:
//  ДокументСсылка.ВыпускПродукции - выпуск
//
Функция ДемоВыпуск(Контекст, Заказ, Продукция, Количество)

	Выпуск = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Основание = Заказ;
	Выпуск.Номенклатура = Продукция;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = Количество;
	Выпуск.Количество = Количество;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Ложь);
	Обработки.ТестыДокументов.Провести(Выпуск);
	Возврат Выпуск.Ссылка;

КонецФункции

// Проведённая передача в переработку по заказу-продаже: ожидаемая продукция - из заказа, материалы - ткань и поролон.
//
// Параметры:
//  Контекст   - Структура - см. ЗаполнитьДемоНабор
//  Заказ      - ДокументСсылка.ЗаказПокупателя - основание
//  Количество - Число - изделий, на каждое уходит по единице ткани и поролона
//
// Возвращаемое значение:
//  ДокументСсылка.ПередачаВПереработку - передача
//
Функция ДемоПередачаВПереработку(Контекст, Заказ, Количество)

	Н = Контекст.Номенклатура;
	Субподрядчик = Контекст.Участники.Textiles;
	ВыбратьУчастника(Контекст, Субподрядчик);
	Передача = Обработки.ТестыДокументов.НовыйДокумент(Контекст, "ПередачаВПереработку");
	ДатаДокумента = Передача.Дата;
	Передача.Заполнить(Заказ);
	Передача.Дата = ДатаДокумента;
	Передача.Контрагент = Субподрядчик.Ссылка;
	Передача.МестоХранения = Контекст.Склад;
	Передача.Комментарий = Контекст.Пометка;
	Обработки.ТестыДокументов.ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Н.Tissu, Количество, 0);
	Обработки.ТестыДокументов.ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Н.Mousse, Количество, 0);
	Обработки.ТестыДокументов.Провести(Передача);
	Возврат Передача.Ссылка;

КонецФункции

