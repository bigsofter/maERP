
&НаКлиенте
Процедура ПодборПоОСтаткам(Команда)
	ДанныеОтбора = Новый Структура("МестоХранения", ПредопределенноеЗначение("Справочник.МестаХранения.ПустаяСсылка")); 
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДатаОстатков", ТекущаяДата());
	ПараметрыФормы.Вставить("МестоХранения", ДанныеОтбора.МестоХранения);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораСерии", ЭтотОбъект);	
	ОткрытьФорму("Обработка.ПечатьЭтикеток.Форма.ВыборСерииПоОстаткам", ПараметрыФормы,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыВыбораСерии(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	Стр = Объект.ТЧТовары.Добавить();
	ЗаполнитьЗначенияСвойств(Стр,Результат);
	Стр.Штрихкод = ПолучитьШКНаСервере(Результат);
	Стр.ЦенаРозничная = ПолучитьРозничнуюЦенуНаСервере(Результат);
КонецПроцедуры

&НаСервере
Функция ПолучитьШКНаСервере(Результат)
	Возврат РегистрыСведений.ШтрихкодыНоменклатуры.ПолучитьШК(Результат.Номенклатура);
КонецФункции

&НаСервере
Функция ПолучитьРозничнуюЦенуНаСервере(Результат)
	Цена = 0;
	// Вид цены склада пользователя (план retail-store-price, §1) - то же правило, что у кассы; пустой - «Розничная».
	Склад = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	Если ЗначениеЗаполнено(Справочники.МестаХранения.ВидЦеныПродажи(Склад)) Тогда
		Цены = Справочники.МестаХранения.ЦеныПродажиСклада(Склад, Результат.Номенклатура, ТекущаяДатаСеанса());
		Если Цены.Количество() > 0 Тогда
			Цена = Цены[0].Цена;
		КонецЕсли;
		Возврат Цена;
	КонецЕсли;
	ТЗПоследнийПрайс = РегистрыСведений.ЦеныНоменклатуры.ПоследнийПрайс(ТекущаяДатаСеанса(), Справочники.ВидыЦен.Розничная,Результат.Номенклатура);
	Если Не ТЗПоследнийПрайс.Количество() = 0 Тогда 
		Цена = ТЗПоследнийПрайс.Получить(0).ЦЕна;
	КонецЕсли;
	Возврат Цена;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Док") Тогда
		Объект.ТЧТовары.Загрузить(Параметры.Док.ТЧТовары.Выгрузить());
		Для Каждого Стр из Объект.ТЧТовары Цикл 
			Стр.Штрихкод = ПолучитьШКНаСервере(Стр);
		КонецЦикла;
	КонецЕсли;
	ТипЭтикетки = Обработки.ПечатьЭтикеток.СохраненныйТипЭтикетки();
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыНоменклатураПриИзменении(Элемент)
	Стр = Элементы.ТЧТовары.ТекущиеДанные;
	Структура = Новый Структура("Номенклатура,Серия",Стр.Номенклатура,Стр.Серия);
	Если Не Стр = Неопределено Тогда 
		Стр.Штрихкод = ПолучитьШКНаСервере(Структура);
		Стр.ЦенаРозничная = ПолучитьРозничнуюЦенуНаСервере(Структура);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТЧТоварыСерияПриИзменении(Элемент)
	Стр = Элементы.ТЧТовары.ТекущиеДанные;
	Структура = Новый Структура("Номенклатура,Серия",Стр.Номенклатура,Стр.Серия);
	Если Не Стр = Неопределено Тогда 
		Стр.Штрихкод = ПолучитьШКНаСервере(Структура);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	Таб = Новый ТабличныйДокумент;
	ПредварительныйПросмотр = Ложь;
	Сформировать(Таб,ПредварительныйПросмотр);
	Если Таб = Ложь Тогда Возврат КонецЕсли;
	ПечатныеФормыКлиент.ВывестиСтикерыНаПринтер(Таб, 30, 10, 15, 50, ПредварительныйПросмотр);
КонецПроцедуры

&НаСервере
Функция Сформировать(Таб,ПредварительныйПросмотр)
	Обработки.ПечатьЭтикеток.СохранитьТипЭтикетки(ТипЭтикетки);
	Таб = Обработки.ПечатьЭтикеток.СформироватьЭтикетки(Объект.ТЧТовары.Выгрузить(), ТипЭтикетки, ПредварительныйПросмотр);
	Таб.ИмяПринтера = ?(ЗначениеЗаполнено(Принтер),Принтер,РегистрыСведений.НастройкиПользователей.ПринтерЭтикеток());
	Возврат Таб;	
КонецФункции   

&НаКлиенте
Процедура ПечатьСПросмотром(Команда)
	Таб = Новый ТабличныйДокумент;
	ПредварительныйПросмотр = Истина;
	Сформировать(Таб,Ложь);
	Если Таб = Ложь Тогда Возврат КонецЕсли;
	ПечатныеФормыКлиент.ВывестиСтикерыНаПринтер(Таб, 50, 20, 5, 50, ПредварительныйПросмотр);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СписокПринтеров = ПечатныеФормыКлиент.ПолучитьСписокПринтеров();
	Элементы.Принтер.СписокВыбора.ЗагрузитьЗначения(СписокПринтеров.ВыгрузитьЗначения());
	ПринтерПоУмолчанию = ПолучитьПринтерПользователяНаСервере();
	Если ЗначениеЗаполнено(ПринтерПоУмолчанию) Тогда
		Зн = СписокПринтеров.НайтиПоЗначению(ПринтерПоУмолчанию);
		Принтер = ?(Зн = Неопределено,"",Зн.Значение);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьПринтерПользователяНаСервере()
	Возврат РегистрыСведений.НастройкиПользователей.ПринтерЭтикеток();
КонецФункции

