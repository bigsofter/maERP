// Печать этикеток товаров (docs/plans/retail-tools.md, п. 7): стандартная этикетка (QR и EAN13, артикул, наименование,
// цена по константе ПечататьЦенуНаЭтикетке), «60×40 с QR» - тот же макет без штрихкода EAN13, «Только наименование» -
// наименование крупно, без кода и цены.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Табличный документ этикеток: по каждой строке - столько этикеток, сколько указано в количестве.
//
// Параметры:
//  Товары                  - ТаблицаЗначений - Номенклатура, Штрихкод, Количество, ЦенаРозничная.
//  ТипЭтикетки             - Строка - «Стандартная», «QR60x40», «ТолькоНаименование»; пустая - стандартная.
//  ПредварительныйПросмотр - Булево - без разделителей страниц.
//
// Возвращаемое значение:
//  ТабличныйДокумент - этикетки.
//
Функция СформироватьЭтикетки(Товары, ТипЭтикетки, ПредварительныйПросмотр) Экспорт

	// Перенесено из формы как было: этикетки печатают роли без права на константу цены на этикетке.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Таб = Новый ТабличныйДокумент;
	ПечататьЦену = Константы.ПечататьЦенуНаЭтикетке.Получить();
	ДанныеТоваров = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Товары.ВыгрузитьКолонку("Номенклатура"),
		"Артикул, Наименование, Бренд, Качество");
	Для Каждого Стр Из Товары Цикл
		Данные = ДанныеТоваров[Стр.Номенклатура];
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЭтикетки = ТипТолькоНаименование() Тогда
			Этикетка = ЭтикеткаНаименования(Данные);
		Иначе
			Этикетка = ЭтикеткаИзМакета(Стр, Данные, ТипЭтикетки <> ТипQR(), ПечататьЦену);
		КонецЕсли;
		Осталось = Стр.Количество;
		Пока Осталось > 0 Цикл
			Осталось = Осталось - 1;
			Таб.Вывести(Этикетка);
			Если Не ПредварительныйПросмотр Тогда
				Таб.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ТипЭтикетки = ТипQR() Тогда
		// Формат 60×40 мм.
		Таб.РазмерСтраницы = "Custom";
		Таб.ШиринаСтраницы = 60;
		Таб.ВысотаСтраницы = 40;
	КонецЕсли;
	Таб.АвтоМасштаб = Истина;
	Таб.КоличествоЭкземпляров = 1;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОтображатьСетку = Ложь;
	Возврат Таб;

КонецФункции

// Тип этикетки, выбранный пользователем в прошлый раз.
//
// Возвращаемое значение:
//  Строка - тип этикетки; по умолчанию - «Стандартная».
//
Функция СохраненныйТипЭтикетки() Экспорт
	Тип = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "ТипЭтикетки");
	Возврат ?(ТипЗнч(Тип) = Тип("Строка") И Не ПустаяСтрока(Тип), Тип, ТипСтандартная());
КонецФункции

// Запоминает выбранный тип этикетки пользователя.
//
// Параметры:
//  ТипЭтикетки - Строка - тип этикетки.
//
Процедура СохранитьТипЭтикетки(ТипЭтикетки) Экспорт
	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "ТипЭтикетки", ТипЭтикетки);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтикеткаИзМакета(Стр, Данные, СоШтрихкодомEAN, ПечататьЦену)

	Этикетка = ПечатныеФормы.МакетПечатнойФормы("Обработка.ПечатьЭтикеток.СтикерEAC").ПолучитьОбласть("Шапка|Колонка");
	Этикетка.Параметры.Заполнить(Стр);
	Если Не ПечататьЦену Тогда
		Этикетка.Параметры.ЦенаРозничная = "";
	КонецЕсли;
	Этикетка.Параметры.Артикул = Данные.Артикул;
	Этикетка.Параметры.Номенклатура = Данные.Наименование
		+ ?(ЗначениеЗаполнено(Данные.Бренд), " " + Данные.Бренд, "")
		+ ?(ЗначениеЗаполнено(Данные.Качество), " " + Данные.Качество, "");
	// QR - тот же штрихкод номенклатуры; без штрихкода - артикул.
	КодQR = ?(ЗначениеЗаполнено(Стр.Штрихкод), Стр.Штрихкод, Данные.Артикул);
	ЗаполнитьРисунок(Этикетка.Рисунки.QRcode, КодQR, ТипКодаQR());
	Если СоШтрихкодомEAN Тогда
		ЗаполнитьРисунок(Этикетка.Рисунки.EAN13, Стр.Штрихкод, ТипКодаEAN13());
	Иначе
		Этикетка.Рисунки.EAN13.Картинка = Новый Картинка;
	КонецЕсли;
	Возврат Этикетка;

КонецФункции

Процедура ЗаполнитьРисунок(Рисунок, Код, ТипКода)

	ПараметрыШтрихкода = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
	ПараметрыШтрихкода.Штрихкод = Код;
	ПараметрыШтрихкода.УбратьЛишнийФон = Истина;
	ПараметрыШтрихкода.ТипКода = ТипКода;
	Если ТипКода = ТипКодаQR() Тогда
		ПараметрыШтрихкода.УровеньКоррекцииQR = 0;
		ПараметрыШтрихкода.Ширина = 40;
		ПараметрыШтрихкода.Высота = 40;
		Рисунок.РазмерКартинки = РазмерКартинки.Пропорционально;
	Иначе
		ПараметрыШтрихкода.Ширина = 160;
		ПараметрыШтрихкода.Высота = 40;
		Рисунок.РазмерКартинки = РазмерКартинки.Растянуть;
	КонецЕсли;
	Изображение = ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
	Рисунок.Картинка = ?(Изображение = Неопределено, Новый Картинка, Изображение.Картинка);
	Рисунок.ГраницаСверху = Ложь;
	Рисунок.ГраницаСнизу = Ложь;
	Рисунок.ГраницаСправа = Ложь;
	Рисунок.ГраницаСлева = Ложь;

КонецПроцедуры

Функция ЭтикеткаНаименования(Данные)

	Этикетка = Новый ТабличныйДокумент;
	Область = Этикетка.Область(1, 1, 1, 1);
	Область.Текст = Данные.Наименование;
	Область.Шрифт = ШрифтыСтиля.Шрифт_Основной_Увеличенный;
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Область.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Область.ШиринаКолонки = 40;
	Область.ВысотаСтроки = 60;
	Возврат Этикетка;

КонецФункции

Функция ТипСтандартная()
	Возврат "Стандартная";
КонецФункции

Функция ТипQR()
	Возврат "QR60x40";
КонецФункции

Функция ТипТолькоНаименование()
	Возврат "ТолькоНаименование";
КонецФункции

Функция ТипКодаQR()
	Возврат 16;
КонецФункции

Функция ТипКодаEAN13()
	Возврат 4;
КонецФункции

Функция КлючНастроек()
	Возврат "Обработка.ПечатьЭтикеток";
КонецФункции

#КонецОбласти

#КонецЕсли
