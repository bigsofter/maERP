&НаКлиенте
Процедура ПослеВводаНомераСертификата(Результат,ДопПараметры) Экспорт 
	Если Результат = Неопределено Тогда возврат; КонецЕсли;
	СуммаСертификата = ПолучитьСуммуСертификатНаСервере(Результат);
	Если СуммаСертификата = 0 Тогда
		ЗаголовокИнформации = Нстр("fr = ""Bon d'achat pas trouvé!""; ru = 'Сертификат не найден!'; en = 'The certificate was not found!'; es = 'Certificado no encontrado!'");
		ТекстОшибки = ""; //Нстр("fr = ""Bon d'achat pas trouvé!""; ru = 'Сертификат не найден!'; en = 'The certificate was not found!'; es = 'Certificado no encontrado!'");
		ОбщегоНазначенияКлиент.ВывестиИнформациюДляРМКУправляемой(ЗаголовокИнформации, ТекстОшибки);
	Иначе
		СтрокаОплаты = ТекущиеВидыОплат.Добавить();
		
		СтрокаОплаты.ВидОплаты = ПредопределенноеЗначение("Справочник.TypesDePayment.Сертификат");
		СуммаКОплате = Макс(ИтогПоОрганизации - ТекущиеВидыОплат.Итог("Сумма"), 0);
		СуммаКОплате = Мин(СуммаКОплате,СуммаСертификата);
		СтрокаОплаты.Сумма = СуммаКОплате;
		
		СтрокаОплаты.ПредставлениеСуммы      = СтрокаОплаты.Сумма;
		СтрокаОплаты.ПредставлениеВидаОплаты = "BonDAchat";
		СтрокаОплаты.Организация             = Организация;
		СтрокаОплаты.Сертификат              = Результат.ВведенноеЧисло;
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраница;
		ЭтотОбъект.ТекущийЭлемент = Элементы.ТекущиеВидыОплат;
		Элементы.ТекущиеВидыОплат.ТекущаяСтрока = СтрокаОплаты.ПолучитьИдентификатор();
		
		ПервыйВвод = Истина;
		
		ОбновитьФорму();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСчета(Результат,ДопПараметры) Экспорт 
	Если Результат = Неопределено Тогда возврат; КонецЕсли;
	СтрокаОплаты = ТекущиеВидыОплат.Добавить();
	
	СтрокаОплаты.ВидОплаты = ПредопределенноеЗначение("Справочник.TypesDePayment.VirementBanquaire");
	СуммаКОплате = Макс(ИтогПоОрганизации - ТекущиеВидыОплат.Итог("Сумма"), 0);
	СтрокаОплаты.Сумма = СуммаКОплате;
	
	СтрокаОплаты.ПредставлениеСуммы      = СтрокаОплаты.Сумма;
	СтрокаОплаты.ПредставлениеВидаОплаты = "Virement";
	СтрокаОплаты.Организация             = Организация;
	СтрокаОплаты.Счет              		 = Результат;
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраница;
	ЭтотОбъект.ТекущийЭлемент = Элементы.ТекущиеВидыОплат;
	Элементы.ТекущиеВидыОплат.ТекущаяСтрока = СтрокаОплаты.ПолучитьИдентификатор();
	
	ПервыйВвод = Истина;
	
	ОбновитьФорму();

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПараметровЧека(Результат,ДопПараметры) Экспорт 
	Если Результат = Неопределено Тогда возврат; КонецЕсли;

	СтрокаОплаты = ТекущиеВидыОплат.Добавить();
	
	СтрокаОплаты.ВидОплаты = ПредопределенноеЗначение("Справочник.TypesDePayment.Cheque");
	СуммаКОплате = Макс(ИтогПоОрганизации - ТекущиеВидыОплат.Итог("Сумма"), 0);
	
	СтрокаОплаты.Сумма = Результат.СуммаЧека; //СуммаКОплате;
	
	СтрокаОплаты.ПредставлениеСуммы      = СтрокаОплаты.Сумма;
	СтрокаОплаты.ПредставлениеВидаОплаты = "Cheque";
	СтрокаОплаты.Организация             = Организация;
	СтрокаОплаты.Чек            		 = Результат.Чек;
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраница;
	ЭтотОбъект.ТекущийЭлемент = Элементы.ТекущиеВидыОплат;
	Элементы.ТекущиеВидыОплат.ТекущаяСтрока = СтрокаОплаты.ПолучитьИдентификатор();
	
	ПервыйВвод = Истина;
	
	ОбновитьФорму();
	
КонецПроцедуры

Функция ПолучитьСуммуСертификатНаСервере(НомерСертификата)
	СуммаСертификата = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СертификатНаОплату.Ссылка КАК Ссылка,
	|	СертификатНаОплату.Сумма КАК Сумма
	|ИЗ
	|	Документ.СертификатНаОплату КАК СертификатНаОплату
	|ГДЕ
	|	СертификатНаОплату.Номер = &НомерСертификата
	|	И СертификатНаОплату.Реализация = ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)
	|	И НЕ СертификатНаОплату.ПометкаУдаления";
	Запрос.УстановитьПараметр("НомерСертификата",Число(НомерСертификата.ВведенноеЧисло));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		СуммаСертификата = Выборка.Сумма;
	КонецЕсли;
	Возврат СуммаСертификата;
КонецФункции

