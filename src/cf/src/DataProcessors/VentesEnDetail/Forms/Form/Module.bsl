Процедура ЗаполнитьПоДокументуНаСЕрвере()
	// Новый открытый документ - новая попытка оплаты (п. 2 плана retail-cash-unfinished).
	ИдентификаторОплаты = Строка(Новый УникальныйИдентификатор);
	// Отложенный или неоплаченный чек открывается со своим признаком учёта.
	Налоговый = CurFacture.УУ <> Истина;
	КомментарийПродажи = CurFacture.Комментарий;
	ТЗ = CurFacture.ТЧТовары.Выгрузить();
