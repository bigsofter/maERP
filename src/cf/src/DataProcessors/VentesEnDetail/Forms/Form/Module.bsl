&AtServer
Функция СоздатьВозвратНаСервере(Док)
	CurDoc = Документы.ВозвратОтПокупателя.СоздатьДокумент();
	CurDoc.Date = ТекущаяДатаСеанса();
	CurDoc.Заполнить(Док);
	CurDoc.Ответственный = ПараметрыСеанса.Пользователь;
	CurDoc.КассоваяСмена = КассоваяСмена;
	// Возврат чека - с признаком учёта самого чека.
	CurDoc.УУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "УУ") = Истина;
    CurDoc.ТЧТовары.Очистить();
	
	КодыСтрок = Новый Соответствие;
	СтрокиРеализации = СтрокиРеализацииДляВозврата(Док);
	For Each Str in Object.TabularSection Do
		// Строка без количества в документ не переносится (план retail-cash-amounts, круг 9).
		Если Не Str.Отметка Или Str.Количество = 0 Тогда Продолжить; КонецЕсли;
		NewStr = CurDoc.ТЧТовары.Add();
		// Возврат - по сумме строки после скидки (план retail-cash-amounts, §1); код строки реализации - для штатной
		// сверки возвратов с проданным и серий.
		РозничныеПродажиКлиентСервер.ЗаполнитьСтрокуВозврата(NewStr, Str, CurDoc.ЦенаВключаетНДС);
		СтрокаРеализации = СтрокаВозвратаПоРеализации(СтрокиРеализации, Str);
		NewStr.КодСтроки = СтрокаРеализации.КодСтроки;
		NewStr.УказаноНесколькоСерий = СтрокаРеализации.УказаноНесколькоСерий;
		КодыСтрок.Вставить(NewStr.КодСтроки, Истина);
	EndDo;
	CurDoc.Сумма = CurDoc.ТЧТовары.Итог("СуммаСНДС");
	// Серии - только возвращаемых строк (Заполнить берёт все серии реализации).
	ЛишниеСерии = Новый Массив;
	Для Каждого СтрокаСерии Из CurDoc.ТЧСерии Цикл
		Если КодыСтрок[СтрокаСерии.КодСтроки] = Неопределено Тогда
			ЛишниеСерии.Добавить(СтрокаСерии);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаСерии Из ЛишниеСерии Цикл
		CurDoc.ТЧСерии.Удалить(СтрокаСерии);
	КонецЦикла;
	
	Try
		CurDoc.Write(DocumentWriteMode.Posting);
	Except
		WriteLogEvent("CreateAvoir",,,,ErrorDescription());
		Return Документы.ВозвратОтПокупателя.EmptyRef();
	EndTry;
	// Строки сверяются с реализацией после проведения: оно уже заблокировало основание
	// (НалоговыеДокументыНаОснованиях.ЗаблокироватьОснованияВозврата), чтение - под блокировкой.
	СтрокиРеализации = СтрокиРеализацииДляВозврата(Док);
	For Each Str in Object.TabularSection Do
		Если Str.Отметка И Str.Количество <> 0 Тогда
			СтрокаВозвратаПоРеализации(СтрокиРеализации, Str);
		КонецЕсли;
	EndDo;
	
	Return CurDoc.Ref;
КонецФункции

&AtServer
Procedure AfterPaymentAtServer(ResultOfEdit) 
	
	ТаблицаОплаты = ПолучитьИзВременногоХранилища(ResultOfEdit.АдресТаблицыОплата);
	
	Сдача = Макс(ТаблицаОплаты.Итог("Сумма") - ?(ЭтоВозврат, СуммаВозвратаЧека(ЭтотОбъект), СуммаКОплате),0);
	Если Сдача = 0 Тогда
		НадписьСуммаСдачи = "0,00";
	Иначе
		НадписьСуммаСдачи = Формат(Сдача, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0");
	КонецЕсли;
	
	ВыведенаСдача = Истина;
	ОставлятьФлагТаблоСдачи = Истина;
	Элементы.СтраницыИнформации.ТекущаяСтраница = Элементы.СтраницаСдача;
	ОшибкаПроведенияДокумента = "";
	// Документы чека и его оплаты - одной транзакцией (план retail-cash-amounts, §2): не записан один - не записан
	// ни один, кассир видит ошибку и повторяет оплату.
	ПрежняяРеализация = CurFacture;
	ПрежняяОперация = Object.ХозяйственнаяОперация;
	ПрежнийКредит = ЭтоКредит;
	НачатьТранзакцию();
	Попытка
		ОформитьДокументыОплаты(ТаблицаОплаты, Сдача);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		CurFacture = ПрежняяРеализация;
		ДокВозврат = Документы.ВозвратОтПокупателя.ПустаяСсылка();
		Object.ХозяйственнаяОперация = ПрежняяОперация;
		ЭтоКредит = ПрежнийКредит;
		Ошибка = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("CreatePayment", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Ошибка));
		Если Не ЗначениеЗаполнено(ОшибкаПроведенияДокумента) Тогда
			ОшибкаПроведенияДокумента = ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка);
		КонецЕсли;
	КонецПопытки;

	//If ImprimerFacture And CurFacture <> PredefinedValue("Document.FactureSortie.EmptyRef") Then
	//	Spreadsheet = PrintAtServer(CurFacture);
	//EndIf;
	
EndProcedure

// Документы чека и его оплаты: реализация (продажа) или возврат, документы оплаты и сертификаты. Вызывается в
// транзакции AfterPaymentAtServer; ошибка записи прерывает всю оплату.
//
// Параметры:
//  ТаблицаОплаты - ТаблицаЗначений - строки оплаты формы сложной оплаты.
//  Сдача         - Число - сдача наличными.
//
&НаСервере
Процедура ОформитьДокументыОплаты(ТаблицаОплаты, Сдача)
	ОснованиеОплаты = ДокументЧекаДляОплаты(ТаблицаОплаты, Сдача);
	
	For Each Str in ТаблицаОплаты Do
		If Str.ВидОплаты = PredefinedValue("Справочник.TypesDePayment.Cash") Then 
			SommeOfPayment = Str.Сумма - Сдача;
		ИначеЕсли Str.ВидОплаты = PredefinedValue("Справочник.TypesDePayment.Credit") Then
			Продолжить;
		ИначеЕсли Str.ВидОплаты = PredefinedValue("Справочник.TypesDePayment.Сертификат") Then
			ПривязатьСертификат(Str.Сертификат);
			Продолжить;
		Else 
			SommeOfPayment = Str.Сумма;
		EndIf;
		CreatePayment(Str,ОснованиеОплаты,SommeOfPayment,Str.ВидОплаты, Str.Чек);
	EndDo;
	
КонецПроцедуры

// Документ чека к оплате: реализация (продажа, записывается здесь), возврат (записывается и проверяется выплата) или
// погашаемая реализация. Не записан - исключение.
//
// Параметры:
//  ТаблицаОплаты - ТаблицаЗначений - строки оплаты формы сложной оплаты.
//  Сдача         - Число - сдача наличными.
//
// Возвращаемое значение:
//  ДокументСсылка.РеализацияТоваровУслуг - основание документов оплаты.
//
&НаСервере
Функция ДокументЧекаДляОплаты(ТаблицаОплаты, Сдача)
	ОснованиеОплаты = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	Если ЭтоПродажа Тогда
		ЭтоКредит = Не ТаблицаОплаты.Найти(PredefinedValue("Справочник.TypesDePayment.Credit")) = Неопределено;
		Если ЭтоКредит Тогда 
			Object.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПродажаВКредит");
		КонецЕсли;
		CurFacture = CreateFacture(,CurFacture = Документы.РеализацияТоваровУслуг.ПустаяСсылка());
		ОснованиеОплаты = CurFacture;
	ИначеЕсли ЭтоВозврат Тогда 
		Если CurFacture = Документы.РеализацияТоваровУслуг.ПустаяСсылка() Тогда 
			Возврат ОснованиеОплаты;
		КонецЕсли;
		ДокВозврат = СоздатьВозвратНаСервере(CurFacture);
		ОснованиеОплаты = ДокВозврат.Основание;
		Если ЗначениеЗаполнено(ДокВозврат) Тогда
			ПроверитьСуммуВозврата(ТаблицаОплаты.Итог("Сумма") - Сдача);
		КонецЕсли;
	ИначеЕсли ЭтоКредит Тогда 
		ОснованиеОплаты = CurFacture;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОснованиеОплаты) Тогда
		// Документ чека не записан: текст ошибки проведения - в ОшибкаПроведенияДокумента (если есть).
		ВызватьИсключение НСтр("ru = 'Документ чека не записан.'; fr = 'Le document du ticket n’est pas enregistré.';
			|en = 'The receipt document is not saved.'; es = 'El documento del ticket no se ha guardado.'");
	КонецЕсли;
	Возврат ОснованиеОплаты;
КонецФункции

// Привязывает сертификат оплаты к реализации чека: сертификат - один раз, под блокировкой; занятый другой
// реализацией - исключение (отказ всей оплаты).
//
// Параметры:
//  НомерСертификата - Строка - номер сертификата строки оплаты.
//
&НаСервере
Процедура ПривязатьСертификат(НомерСертификата)
	Сертификат = Документы.СертификатНаОплату.НайтиПоНомеру(НомерСертификата);
	Если Не Сертификат = Документы.СертификатНаОплату.ПустаяСсылка() Тогда 
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Документ.СертификатНаОплату").УстановитьЗначение("Ссылка", Сертификат);
		Блокировка.Заблокировать();
		ДокСертификат = Сертификат.ПолучитьОбъект();
		Если ЗначениеЗаполнено(ДокСертификат.Реализация) И ДокСертификат.Реализация <> CurFacture Тогда
			Шаблон = НСтр("ru = 'Сертификат %1 уже использован.'; fr = 'Le certificat %1 est déjà utilisé.';
				|en = 'Certificate %1 is already used.'; es = 'El certificado %1 ya está usado.'");
			ОшибкаПроведенияДокумента = СтрШаблон(Шаблон, НомерСертификата);
			ВызватьИсключение ОшибкаПроведенияДокумента;
		КонецЕсли;
		ДокСертификат.Реализация = CurFacture;
		ДокСертификат.КассоваяСмена = КассоваяСмена;
		ДокСертификат.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
КонецПроцедуры

// Проверка выплаты возврата после проведения возврата, в той же транзакции (план retail-cash-amounts, §2а): выплата -
// не больше оплаченного и ещё не возвращённого по свежим данным, а не по снимку формы. Проведение возврата уже
// заблокировало основание и расчёты контрагента (УправляемыеБлокировки.ВзаиморасчётыСПокупателями) в штатном
// порядке, блокировка ниже - в пределах уже захваченной, новой очерёдности не создаёт. Касса работает в основной
// валюте: реализация в валюте возвращается документом возврата.
//
// Параметры:
//  СуммаВыплаты - Число - сумма выплаты покупателю (оплата формы без сдачи).
//
&НаСервере
Процедура ПроверитьСуммуВозврата(СуммаВыплаты)
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(CurFacture, "ВВалюте") = Истина Тогда
		ВызватьИсключение НСтр("ru = 'Возврат реализации в валюте оформляется документом возврата, а не на кассе.';
			|fr = 'Le retour d’une vente en devise se fait par le document de retour, pas en caisse.';
			|en = 'A return of a foreign-currency sale is made with a return document, not at the cash desk.';
			|es = 'La devolución de una venta en divisa se hace con el documento de devolución, no en caja.'");
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ВзаиморасчётыСПокупателями");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("ОбъектРасчётов", CurFacture);
	Блокировка.Заблокировать();
	Доступно = ДоступноКВозврату(CurFacture);
	Если СуммаВыплаты > Доступно Тогда
		Шаблон = НСтр(
			"ru = 'К возврату по чеку доступно %1: оплачено и ещё не возвращено. Откройте чек заново.';
			|fr = 'Montant remboursable pour le ticket : %1 (payé et pas encore remboursé). Rouvrez le ticket.';
			|en = 'Refundable for the receipt: %1 (paid and not yet refunded). Reopen the receipt.';
			|es = 'Reembolsable por el ticket: %1 (pagado y aún no devuelto). Vuelva a abrir el ticket.'");
		ОшибкаПроведенияДокумента = СтрШаблон(Шаблон, Формат(Доступно, "ЧДЦ=2; ЧН=0"));
		ВызватьИсключение ОшибкаПроведенияДокумента;
	КонецЕсли;
КонецПроцедуры

// Оплачено и ещё не выплачено по реализации, в основной валюте: сумма реализации минус долг по ней (его уменьшают
// оплаты и возвраты, выплата возврата увеличивает обратно) минус проведённые возвраты, включая только что
// проведённый, - то есть оплачено минус прежние выплаты возвратов.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация в основной валюте.
//
// Возвращаемое значение:
//  Число - доступная к выплате сумма, не меньше 0.
//
&НаСервереБезКонтекста
Функция ДоступноКВозврату(Реализация)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Долг
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, ОбъектРасчётов = &Реализация) КАК Остатки";
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	СуммаРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реализация, "Сумма");
	Возврат Макс(СуммаРеализации - Выборка.Долг - СуммаПрежнихВозвратов(Реализация), 0);
КонецФункции

&AtClient
Procedure CalculateSum(CurRaw = Undefined)
	if CurRaw = Undefined Then 
		CurRaw = Items.TabularSection.CurrentData;
	EndIf;
	if CurRaw = Undefined Then 
		Return;
	EndIf;
	Если ПересчитыватьСтрокиЧека Тогда
		РозничныеПродажиКлиентСервер.РассчитатьСтрокуЧека(CurRaw);
	КонецЕсли;
	CalculateSumTotal();
EndProcedure

// Пересчитывает строки и итоги чека (план docs/plans/retail-cash-amounts.md, §2). Новый и отложенный чек: суммы строк
// из цены, количества и процента, строкам ставится скидка чека, если она единая. Проведённая реализация (возврат,
// погашение долга): суммы строк - из документа, не пересчитываются; в итоги возврата идут отмеченные строки.
&НаКлиенте
Процедура CalculateSumTotal()
	Итоги = РозничныеПродажиКлиентСервер.ПересчитатьЧек(Object.TabularSection, RemisePourCent,
		ПересчитыватьСтрокиЧека И СкидкаЧекаЕдиная, ЭтоВозврат, ПересчитыватьСтрокиЧека);
	ПрименитьИтогиЧека(ЭтотОбъект, Итоги);
КонецПроцедуры

// Пересчёт чека на сервере перед записью реализации - то же, что CalculateSumTotal.
&НаСервере
Процедура ПересчитатьЧекНаСервере()
	Итоги = РозничныеПродажиКлиентСервер.ПересчитатьЧек(Object.TabularSection, RemisePourCent,
		ПересчитыватьСтрокиЧека И СкидкаЧекаЕдиная, ЭтоВозврат, ПересчитыватьСтрокиЧека);
	ПрименитьИтогиЧека(ЭтотОбъект, Итоги);
КонецПроцедуры

// Итоги чека в реквизиты формы (вызывается и с клиента, и с сервера).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма кассы.
//  Итоги - Структура - см. РозничныеПродажиКлиентСервер.ПересчитатьЧек.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьИтогиЧека(Форма, Итоги)
	Форма.СуммаДокументаБезСкидок = Итоги.СуммаБезСкидок;
	Форма.СуммаСкидки = Итоги.СуммаСкидки;
	Форма.СуммаКОплате = Итоги.СуммаСоСкидкой - Форма.СуммаОплачено;
КонецПроцедуры

// Сумма к выплате при возврате: отмеченные строки после скидки, не больше оплаченного по реализации за вычетом прежних
// возвратов по ней. СуммаОплачено - сумма реализации минус долг по ней; долг уменьшают и оплаты, и возвраты (выплата
// возврата увеличивает его обратно), поэтому оплачено и ещё не возвращено = СуммаОплачено - СуммаВозвращено.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма кассы.
//
// Возвращаемое значение:
//  Число - сумма возврата.
//
&НаКлиентеНаСервереБезКонтекста
Функция СуммаВозвратаЧека(Форма)
	СуммаСтрок = 0;
	Для Каждого Строка Из Форма.Object.TabularSection Цикл
		Если Строка.Отметка Тогда
			СуммаСтрок = СуммаСтрок + Строка.СуммаСНДС;
		КонецЕсли;
	КонецЦикла;
	Возврат Мин(СуммаСтрок, Макс(Форма.СуммаОплачено - Форма.СуммаВозвращено, 0));
КонецФункции

// Заголовок итога скидки - процент скидки чека.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма кассы.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗаголовокСкидки(Форма)
	Шаблон = НСтр("ru = 'Скидка %1%%'; fr = 'Remise %1%%'; en = 'Discount %1%%'; es = 'Descuento %1%%'");
	Форма.Элементы.СуммаСкидки.Заголовок = СтрШаблон(Шаблон, Форма.RemisePourCent);
КонецПроцедуры

// Строка реализации для строки возврата: совпадает с текущей строкой реализации (номер, товар, характеристика,
// количество и сумма доли), иначе исключение - реализацию мог изменить другой сеанс после открытия чека.
//
// Параметры:
//  СтрокиРеализации - ТаблицаЗначений - см. СтрокиРеализацииДляВозврата.
//  СтрокаЧека       - ДанныеФормыЭлементКоллекции - отмеченная строка кассы.
//
// Возвращаемое значение:
//  Структура - см. ДоляСтрокиРеализации.
//
&НаСервере
Функция СтрокаВозвратаПоРеализации(СтрокиРеализации, СтрокаЧека)
	Отбор = ОтборСтрокиРеализации(СтрокаЧека);
	Найденные = СтрокиРеализации.НайтиСтроки(Отбор);
	Доля = ?(Найденные.Количество() = 0, Новый Структура, ДоляСтроки(Найденные[0], СтрокаЧека.Количество));
	Если Не Доля.Свойство("Количество") Или Доля.Количество <> СтрокаЧека.Количество
		Или Доля.СуммаСНДС <> СтрокаЧека.СуммаСНДС Тогда
		ОшибкаПроведенияДокумента = НСтр("ru = 'Чек изменён после открытия. Откройте его заново.';
			|fr = 'Le ticket a été modifié après ouverture. Rouvrez-le.';
			|en = 'The receipt was changed after it was opened. Reopen it.';
			|es = 'El ticket se modificó después de abrirlo. Vuelva a abrirlo.'");
		ВызватьИсключение ОшибкаПроведенияДокумента;
	КонецЕсли;
	// Какие из нескольких серий строки возвращаются, касса не спрашивает (выбор серий возврата - волна IMEI).
	Если Доля.УказаноНесколькоСерий И Не Доля.ВсяСтрока Тогда
		ОшибкаПроведенияДокумента = НСтр(
			"ru = 'Часть строки с несколькими сериями возвращается документом возврата, а не на кассе.';
			|fr = 'Une partie de ligne à plusieurs séries se retourne par le document de retour, pas en caisse.';
			|en = 'Part of a line with several series is returned with a return document, not at the cash desk.';
			|es = 'Parte de una línea con varias series se devuelve con el documento de devolución, no en caja.'");
		ВызватьИсключение ОшибкаПроведенияДокумента;
	КонецЕсли;
	Возврат Доля;
КонецФункции

// Сумма проведённых возвратов по реализации.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация.
//
// Возвращаемое значение:
//  Число - сумма возвратов.
//
&НаСервереБезКонтекста
Функция СуммаПрежнихВозвратов(Реализация)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Возвраты.Сумма), 0) КАК Сумма
	|ИЗ
	|	Документ.ВозвратОтПокупателя КАК Возвраты
	|ГДЕ
	|	Возвраты.Основание = &Реализация
	|	И Возвраты.Проведен";
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;
КонецФункции

// Открывается ли непроведённая реализация на кассе как отложенный чек: строки кассы - с НДС, а черновик формы
// реализации (без кассовой смены) с ценами без НДС к ним без изменения стоимости не приводится. Признак НДС чека
// кассы не показателен: прежняя касса записывала Ложь при ценах с НДС.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - выбранный документ.
//
// Возвращаемое значение:
//  Булево - Истина, если документ можно открыть.
//
&НаСервереБезКонтекста
Функция ЧерновикОткрываетсяНаКассе(Знач Реализация)
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Реализация, "КассоваяСмена, ЦенаВключаетНДС, Проведен");
	Возврат Реквизиты.Проведен Или ЗначениеЗаполнено(Реквизиты.КассоваяСмена) Или Реквизиты.ЦенаВключаетНДС;
КонецФункции

// Количество и суммы части строки проведённой реализации для возврата (план retail-cash-amounts, §2).
//
// Параметры:
//  Реализация  - ДокументСсылка.РеализацияТоваровУслуг - реализация, открытая для возврата.
//  СтрокаЧека  - Структура - строка кассы: НомерСтрокиДокумента, Номенклатура, Характеристика, Серия (строка
//                реализации, изменённой другим сеансом, по номеру не подменяется).
//  Количество  - Число - запрошенное количество в упаковках строки.
//
// Возвращаемое значение:
//  Структура - см. ДоляСтроки; строка не найдена - пустая структура.
//
&НаСервереБезКонтекста
Функция ДоляСтрокиРеализации(Знач Реализация, Знач СтрокаЧека, Знач Количество)
	Отбор = ОтборСтрокиРеализации(СтрокаЧека);
	Найденные = СтрокиРеализацииДляВозврата(Реализация).НайтиСтроки(Отбор);
	Если Найденные.Количество() = 0 Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Возврат ДоляСтроки(Найденные[0], Количество);
КонецФункции

// Доля строки реализации с её кодом строки и признаком нескольких серий.
//
// Параметры:
//  СтрокаРеализации - СтрокаТаблицыЗначений - см. СтрокиРеализацииДляВозврата.
//  Количество       - Число - запрошенное количество в упаковках строки.
//
// Возвращаемое значение:
//  Структура - см. РозничныеПродажиКлиентСервер.ДоляСтрокиДокумента, и КодСтроки, УказаноНесколькоСерий, ВсяСтрока.
//
&НаСервереБезКонтекста
Функция ДоляСтроки(СтрокаРеализации, Количество)
	Доля = РозничныеПродажиКлиентСервер.ДоляСтрокиДокумента(СтрокаРеализации, Количество);
	Доля.Вставить("КодСтроки", СтрокаРеализации.КодСтроки);
	Доля.Вставить("УказаноНесколькоСерий", СтрокаРеализации.УказаноНесколькоСерий);
	Доля.Вставить("ВсяСтрока", Доля.Количество = СтрокаРеализации.КоличествоУпаковок);
	Возврат Доля;
КонецФункции

// Отбор строки реализации по строке кассы: номер строки, товар, характеристика, серия.
//
// Параметры:
//  СтрокаЧека - Структура, ДанныеФормыЭлементКоллекции - НомерСтрокиДокумента, Номенклатура, Характеристика, Серия.
//
// Возвращаемое значение:
//  Структура - отбор для СтрокиРеализацииДляВозврата().НайтиСтроки.
//
&НаСервереБезКонтекста
Функция ОтборСтрокиРеализации(СтрокаЧека)
	Отбор = Новый Структура;
	Отбор.Вставить("НомерСтроки", СтрокаЧека.НомерСтрокиДокумента);
	Отбор.Вставить("Номенклатура", СтрокаЧека.Номенклатура);
	Отбор.Вставить("Характеристика", СтрокаЧека.Характеристика);
	Отбор.Вставить("Серия", СтрокаЧека.Серия);
	Возврат Отбор;
КонецФункции

// Строки реализации для возврата на кассе - одним запросом на документ.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация.
//
// Возвращаемое значение:
//  ТаблицаЗначений - НомерСтроки, Номенклатура, Характеристика, Серия, КодСтроки, УказаноНесколькоСерий,
//                    КоличествоУпаковок, Сумма, СуммаСкидки, СуммаСНДС, СуммаНДС.
//
&НаСервереБезКонтекста
Функция СтрокиРеализацииДляВозврата(Реализация)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Серия КАК Серия,
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.УказаноНесколькоСерий КАК УказаноНесколькоСерий,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СуммаСкидки КАК СуммаСкидки,
	|	Товары.СуммаСНДС КАК СуммаСНДС,
	|	Товары.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Реализация";
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Ставка НДС строк чека - ставка товара, как у строк реализации; суммы НДС пересчитывает ПересчитатьЧекНаСервере.
&НаСервере
Процедура ЗаполнитьСтавкиНДСЧека()
	Для Каждого Строка Из Object.TabularSection Цикл
		Строка.СтавкаНДС = Строка.Номенклатура.СтавкаНДС;
	КонецЦикла;
КонецПроцедуры

&AtServer
Function GetVATRateArServer(Номенклатура)
	Return Номенклатура.СтавкаНДС;
EndFunction

// Склад продажи кассы (план docs/plans/retail-store-price.md, §2а): склад продолжаемого отложенного чека, иначе склад
// кассира - цена берётся по складу, с которого товар спишется.
//
// Возвращаемое значение:
//  СправочникСсылка.МестаХранения - склад.
//
&НаСервере
Функция СкладПродажи()
	Если ЗначениеЗаполнено(CurFacture) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(CurFacture, "МестоХранения");
	КонецЕсли;
	Возврат РозничныйСклад;
КонецФункции

// Цена продажи склада для строки (Справочники.МестаХранения.ЦеныПродажиСклада - то же правило, что у сеток подбора и
// избранного); нет цены по характеристике - цена без характеристики, нет и её - 0 (касса не даст продать без цены).
//
// Параметры:
//  Склад          - СправочникСсылка.МестаХранения - склад продажи.
//  Номенклатура   - СправочникСсылка.Номенклатура - товар.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика.
//
// Возвращаемое значение:
//  Число - цена за единицу хранения.
//
&НаСервереБезКонтекста
Функция ЦенаПродажиСклада(Склад, Номенклатура, Характеристика)
	Цены = Справочники.МестаХранения.ЦеныПродажиСклада(Склад, Номенклатура, ТекущаяДатаСеанса());
	Отбор = Новый Структура("Номенклатура, Характеристика", Номенклатура, Характеристика);
	Строка = Цены.НайтиСтроки(Отбор);
	Если Строка.Количество() = 0 И ЗначениеЗаполнено(Характеристика) Тогда
		Отбор.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		Строка = Цены.НайтиСтроки(Отбор);
	КонецЕсли;
	Возврат ?(Строка.Количество() = 0, 0, Строка[0].Цена);
КонецФункции

// Новая строка аппаратного сканера получает цену вида склада; пустой вид у склада - цена сканера как раньше.
// Коэффициент упаковки строки - ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы (сейчас 1).
&НаСервере
Процедура ПрименитьЦенуСкладаПоследнейСтроки()
	Склад = СкладПродажи();
	Если Не ЗначениеЗаполнено(Справочники.МестаХранения.ВидЦеныПродажи(Склад)) Тогда
		Возврат;
	КонецЕсли;
	Строка = Object.TabularSection[Object.TabularSection.Количество() - 1];
	Строка.Цена = ЦенаПродажиСклада(Склад, Строка.Номенклатура, Строка.Характеристика)
		* ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы(Строка.Упаковка);
	РозничныеПродажиКлиентСервер.РассчитатьСтрокуЧека(Строка);
КонецПроцедуры

&AtServer
Function GetFactureNumber()
	Return CurFacture.Number;
EndFunction

&AtServer
Procedure CreatePayment(Str,ОснованиеОплаты,SommeOfPayment, ТипОплаты = Неопределено, Чек = Неопределено)
	If ТипОплаты = PredefinedValue("Справочник.TypesDePayment.VirementBanquaire") Then
		CurDoc = ?(ЭтоВозврат, Документы.СписаниеБезналичныхДенежныхСредств.СоздатьДокумент(), Документы.ПоступлениеБезналичныхДенежныхСредств.СоздатьДокумент());
		CurDoc.БанковскийСчёт = Str.Счет;
	Else
		CurDoc = ?(ЭтоВозврат, Документы.РасходныйКассовыйОрдер.СоздатьДокумент(), Документы.ПриходныйКассовыйОрдер.СоздатьДокумент());
		CurDoc.Касса = РегистрыСведений.НастройкиПользователей.КассаПользователя();
		Если ТипОплаты = Справочники.TypesDePayment.Cheque Тогда 
			CurDoc.Чек = Чек;
		КонецЕсли;
	EndIf;
	CurDoc.КассоваяСмена = КассоваяСмена; 
	Structure = New Structure("Документ,Сумма,ТипОплаты",ОснованиеОплаты,SommeOfPayment,ТипОплаты);
	CurDoc.Заполнить(Structure);
	// Деньги чека - с признаком учёта самого чека (у возврата - его признака), а не флажка формы; у безналичного
	// списания реквизита нет, у безналичного поступления признак не действует (банк всегда белый).
	Если CurDoc.Метаданные().Реквизиты.Найти("УУ") <> Неопределено Тогда
		ДокументЧека = ?(ЭтоВозврат, ДокВозврат, ОснованиеОплаты);
		CurDoc.УУ = ?(ЗначениеЗаполнено(ДокументЧека),
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументЧека, "УУ") = Истина, Не Налоговый);
	КонецЕсли;
	CurDoc.Date = ТекущаяДатаСеанса();
	Если ЭтоВозврат Тогда 
		CurDoc.Основание = ДокВозврат;
	КонецЕсли;
	Попытка
		CurDoc.write(DocumentWriteMode.Posting);
	Исключение
		WriteLogEvent("CreatePayment",,,,ErrorDescription());
	Конецпопытки;
EndProcedure

&AtServer
Procedure NewFacture()
	Object.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	//CurDoc = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	CurFacture = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	РозничныйДоговор = Константы.РозничныйДоговор.Получить();
	РозничныйКлиент = Константы.РозничныйКлиент.Получить();
	СуммаДокументаБезСкидок = 0;
	СуммаСкидки = 0;
	СуммаОплачено = 0;
	СуммаКОплате = 0;
	RemisePourCent = 0;
	СуммаВозвращено = 0;
	СкидкаЧекаЕдиная = Истина;
	ПересчитыватьСтрокиЧека = Истина;
	ОбновитьЗаголовокСкидки(ЭтотОбъект);
	КомментарийПродажи = "";
	FieldPhoto = "";
	Object.TabularSection.Clear();
	// Новый чек налоговый или нет - по настройке пользователя (раздельный учёт, docs/plans/accounting-morocco-f1.md).
	Налоговый = Не НалоговыйУчет.РаздельныйУчетВключен() Или РегистрыСведений.НастройкиПользователей.НалоговыйПоУмолчанию();
	НастроитьФорму();
EndProcedure

&AtServer
Function CreateFacture(Черновик = Ложь, СоздаватьДокумент = Истина)
	Если СоздаватьДокумент Тогда 
		CurDoc = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		CurDoc.Date = ТекущаяДатаСеанса();
		CurDoc.Контрагент = РозничныйКлиент;
		CurDoc.Договор = РозничныйДоговор;
		CurDoc.КассоваяСмена = КассоваяСмена;
		CurDoc.Ответственный = ПараметрыСеанса.Пользователь;
		CurDoc.ХозяйственнаяОперация = Object.ХозяйственнаяОперация;
		CurDoc.МестоХранения = РозничныйСклад;
		CurDoc.Организация = Object.Organisation;
		CurDoc.УУ = Не Налоговый;
		CurDoc.Комментарий = КомментарийПродажи;
	Иначе
		CurDoc = CurFacture.ПолучитьОбъект();
		//CurDoc.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		CurDoc.Контрагент = РозничныйКлиент;
		CurDoc.Договор = РозничныйДоговор;
		CurDoc.КассоваяСмена = КассоваяСмена;
		CurDoc.ХозяйственнаяОперация = Object.ХозяйственнаяОперация;
		CurDoc.Date = ТекущаяДатаСеанса();
		CurDoc.УУ = Не Налоговый;
		CurDoc.Комментарий = КомментарийПродажи;
	КонецЕсли;
	// План retail-cash-amounts, §2. Строки, посчитанные кассой, - с НДС: СоздатьДокумент() не заполняет признак, цены
	// отложенного чека приведены при открытии (ЗаполнитьПоДокументуНаСЕрвере). Оплата проведённой реализации
	// (ДокументыКОплате) переносит её строки как есть, с её признаком НДС.
	Если ПересчитыватьСтрокиЧека Тогда
		CurDoc.ЦенаВключаетНДС = Истина;
		ЗаполнитьСтавкиНДСЧека();
	КонецЕсли;
	// Суммы строк - те же, что показаны и оплачены: расчёт чека идемпотентен.
	ПересчитатьЧекНаСервере();
	
	CurDoc.ТЧТовары.Очистить();
	// Вид цены строк - вид склада продажи, пустой у склада - «Розничная», как раньше (план retail-store-price, §1).
	ВидЦеныСтроки = Справочники.МестаХранения.ВидЦеныПродажи(CurDoc.МестоХранения);
	Если Не ЗначениеЗаполнено(ВидЦеныСтроки) Тогда
		ВидЦеныСтроки = Справочники.ВидыЦен.Розничная;
	КонецЕсли;
	For Each Str in Object.TabularSection Do
		Если Str.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		NewStr = CurDoc.ТЧТовары.Add();
		РозничныеПродажиКлиентСервер.ЗаполнитьСтрокуРеализации(NewStr, Str);
		NewStr.ВидЦены = ВидЦеныСтроки;
	EndDo;
	CurDoc.Сумма = CurDoc.ТЧТовары.Итог("СуммаСНДС")+CurDoc.ТЧУслуги.Итог("СуммаСНДС");
	CurDoc.СуммаНДС = CurDoc.ТЧТовары.Итог("СуммаНДС")+CurDoc.ТЧУслуги.Итог("СуммаНДС");
	
	Try
		CurDoc.ДополнительныеСвойства.Вставить("ЭтоИнтерфейсПродавца",Истина);
		CurDoc.Write(?(Черновик, DocumentWriteMode.Write, DocumentWriteMode.Posting));
	Except
		Если CurDoc.ДополнительныеСвойства.Свойство("ТекстОшибки") Тогда 
			ОшибкаПроведенияДокумента = CurDoc.ДополнительныеСвойства.ТекстОшибки;
		КонецЕсли;
		WriteLogEvent("CreateFacture",,,,ErrorDescription());
		Return Документы.РеализацияТоваровУслуг.EmptyRef();
	EndTry;
	
	Return CurDoc.Ref;
	
EndFunction

&AtClient
Procedure RefreshInfo()
	CurStr = items.TabularSection.CurrentData;
	
	Если CurStr = Неопределено Тогда
		НадписьИнформацияОТоваре = "";
		НадписьТекущаяСумма = "";
		Возврат;
	КонецЕсли;
	ProduitDescriptif = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(CurStr.Номенклатура,"НаименованиеПолное");	
	НадписьИнформацияОТоваре = ?(ValueIsFilled(ProduitDescriptif),ProduitDescriptif,ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(CurStr.Номенклатура,"Наименование"));
	//НадписьИнформацияОТоваре = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(CurStr.Номенклатура,"Наименование") + Символы.ПС 
	//	+ ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(CurStr.Номенклатура,"НаименованиеПолное");
	НадписьИнформацияОТоваре = НадписьИнформацияОТоваре + Символы.ПС;
	НадписьЯчейка = "Emplacement: " + ПолучитьЯчейкиНаСервере(CurStr.Номенклатура);
	InfoDiscount = "";
	If CurStr.СуммаСкидки <> 0 and CurStr.СуммаСНДС <> 0 Then
		InfoDiscount = " - " + Format(CurStr.СуммаСкидки,"NFD=2") + " ( " + Round(CurStr.ПроцентСкидки,2) + "%) ";
	EndIf;
	VATRate = ОбщегоНазначенияВызовСервераПовтИсп.ПроцентСтавкиНДС(GetVATRateArServer(CurStr.Номенклатура));
	НадписьТекущаяСумма = "" + Format(CurStr.Цена,"NFD=2") + " x " + 
		CurStr.Количество + InfoDiscount + " = " + Format(CurStr.СуммаСНДС,"NFD=2");
EndProcedure

&AtServer
Function StructureProductByBarCode(BarCode)
	Query = New Query;
	Query.Text = "ВЫБРАТЬ
	             |	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	             |	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
	             |	ШтрихкодыНоменклатуры.Упаковка КАК Упаковка,
	             |	ШтрихкодыНоменклатуры.Серия КАК Серия
	             |ПОМЕСТИТЬ ВТ
	             |ИЗ
	             |	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	             |ГДЕ
	             |	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	Партии.Номенклатура КАК Номенклатура,
	             |	Партии.Характеристика КАК Характеристика,
	             |	Партии.Серия КАК Серия,
	             |	СУММА(Партии.КоличествоОстаток) КАК КоличествоОстаток
	             |ПОМЕСТИТЬ ВТОстатки
	             |ИЗ
	             |	РегистрНакопления.ТоварыВНаличии.Остатки(
	             |			,
	             |			(Номенклатура, Характеристика, Серия) В
	             |				(ВЫБРАТЬ
	             |					ВТ.Номенклатура,
	             |					ВТ.Характеристика,
	             |					ВТ.Серия
	             |				ИЗ
	             |					ВТ)) КАК Партии
	             |
	             |СГРУППИРОВАТЬ ПО
	             |	Партии.Номенклатура,
	             |	Партии.Характеристика,
	             |	Партии.Серия
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	StockBalance.Номенклатура КАК Номенклатура,
	             |	StockBalance.Характеристика КАК Характеристика,
	             |	StockBalance.КоличествоОстаток КАК Количество,
	             |	ЕСТЬNULL(PrixDeProduitSliceLast.Цена, 0) КАК Цена,
	             |	StockBalance.Серия КАК Серия
	             |ИЗ
	             |	ВТОстатки КАК StockBalance
	             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	             |				,
	             |				ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Розничная)
	             |					И (Номенклатура, Характеристика) В
	             |						(ВЫБРАТЬ
	             |							ВТ.Номенклатура КАК Номенклатура,
	             |							ВТ.Характеристика КАК Характеристика
	             |						ИЗ
	             |							ВТ)) КАК PrixDeProduitSliceLast
	             |		ПО StockBalance.Номенклатура = PrixDeProduitSliceLast.Номенклатура
	             |			И StockBalance.Характеристика = PrixDeProduitSliceLast.Характеристика
	             |			И (PrixDeProduitSliceLast.ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Розничная))
	             |			И (PrixDeProduitSliceLast.Активность)";
	Query.SetParameter("Штрихкод",BarCode);
	Result = Query.Execute();
	If Result.IsEmpty() Then
		Return Undefined;
	EndIf;
	
	ResultOfChoice = Result.Select();
	ResultOfChoice.Next();
	
	ProductStructure = New Structure("Номенклатура,Характеристика,Серия,Количество,Цена",ResultOfChoice.Номенклатура,ResultOfChoice.Характеристика,ResultOfChoice.Серия,1,ResultOfChoice.Цена);
	// Ставка НДС - здесь же: строка с ценой склада считается сразу, без пересчёта в CreateFacture.
	ProductStructure.Вставить("СтавкаНДС", GetVATRateArServer(ResultOfChoice.Номенклатура));
	Склад = СкладПродажи();
	Если ЗначениеЗаполнено(Справочники.МестаХранения.ВидЦеныПродажи(Склад)) Тогда
		ProductStructure.Цена = ЦенаПродажиСклада(Склад, ResultOfChoice.Номенклатура, ResultOfChoice.Характеристика);
	КонецЕсли;
	Return ProductStructure;
	
EndFunction

