&НаКлиенте
Процедура Избранное(Команда)

	Если Не ЭтоНоваяПродажа Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзбранного", ЭтотОбъект);
	// Режим открытия не указываем: он задан свойством самой формы избранного (LockOwner).
	// Перечисление РежимОткрытияОкнаФормы в 8.5.1 объявлено устаревшим.
	ОткрытьФорму("Обработка.VentesEnDetail.Форма.ФормаИзбранного", Новый Структура("МестоХранения", СкладПродажи()),
		ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

// Комментарий к продаже с кассы (план docs/plans/retail-store-price.md, §3): пишется в реализацию при записи чека.
//
// Параметры:
//  Команда - КомандаФормы - команда.
//
&НаКлиенте
Процедура КомментарийПродажи(Команда)
	Оповещение = Новый ОписаниеОповещения("ПослеВводаКомментария", ЭтотОбъект);
	ЗаголовокВвода = НСтр("ru = 'Комментарий к продаже'; fr = 'Commentaire de la vente';
		|en = 'Sale comment'; es = 'Comentario de la venta'");
	ДлинаКомментария = 250;
	ПоказатьВводСтроки(Оповещение, КомментарийПродажи, ЗаголовокВвода, ДлинаКомментария, Истина);
КонецПроцедуры

// Принимает введённый комментарий.
//
// Параметры:
//  Строка - Строка, Неопределено - комментарий; Неопределено - ввод отменён.
//  ДопПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ПослеВводаКомментария(Строка, ДопПараметры) Экспорт
	Если Строка <> Неопределено Тогда
		КомментарийПродажи = Строка;
	КонецЕсли;
КонецПроцедуры

// Принимает позицию, выбранную плиткой в окне избранного.
// Отдельный обработчик, а не AfterChoiceProduit: по решению владельца от 2026-09-24 повторный
// клик по плитке увеличивает количество и не открывает окно редактирования строки.
//
// Параметры:
//  Результат - Структура, Неопределено - Номенклатура, Характеристика, Количество, Цена.
//  ДопПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ПослеВыбораИзбранного(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Кнопка могла быть доступна на момент открытия окна и недоступна на момент клика.
	Если Не ЭтоНоваяПродажа Тогда
		ОбщегоНазначенияКлиент.ВывестиИнформациюДляРМКУправляемой("", НСтр(
			"fr = 'La vente est déjà validée : impossible d’ajouter un article.';
			|ru = 'Продажа уже проведена: добавить товар нельзя.';
			|en = 'The sale is already posted: the product cannot be added.';
			|es = 'La venta ya está registrada: no se puede agregar el artículo.'"));
		Возврат;
	КонецЕсли;

	ОтборСтроки = Новый Структура("Номенклатура, Характеристика");
	ОтборСтроки.Номенклатура = Результат.Номенклатура;
	ОтборСтроки.Характеристика = Результат.Характеристика;
	НайденныеСтроки = Object.TabularSection.НайтиСтроки(ОтборСтроки);

	Если НайденныеСтроки.Количество() > 0 Тогда
		Строка = НайденныеСтроки[0];
		Строка.Количество = Строка.Количество + Результат.Количество;
	Иначе
		Строка = Object.TabularSection.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Результат);
		Строка.СтавкаНДС = GetVATRateArServer(Строка.Номенклатура);
	КонецЕсли;

	РозничныеПродажиКлиентСервер.РассчитатьСтрокуЧека(Строка);
	Элементы.TabularSection.ТекущаяСтрока = Строка.ПолучитьИдентификатор();

	CalculateSumTotal();
	RefreshInfo();

КонецПроцедуры

&НаКлиенте
Процедура ВИзбранное(Команда)

	ИзменитьИзбранноеПоТекущейСтроке(Истина);

КонецПроцедуры

&НаКлиенте
Процедура УбратьИзИзбранного(Команда)

	ИзменитьИзбранноеПоТекущейСтроке(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьИзбранноеПоТекущейСтроке(Добавить)

	ТекущиеДанные = Элементы.TabularSection.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	БылоИзменение = ИзменитьИзбранноеНаСервере(ТекущиеДанные.Номенклатура, ТекущиеДанные.Характеристика,
		Добавить);

	// Сообщение по факту, а не по нажатию: оба пункта меню видны всегда, и без этого
	// «Товар добавлен в избранное» приходило бы и на товар, который там уже лежит.
	Если Добавить И БылоИзменение Тогда
		Текст = НСтр("fr = 'Article ajouté aux favoris.'; ru = 'Товар добавлен в избранное.';
			|en = 'The product has been added to favourites.'; es = 'El artículo se agregó a favoritos.'");
	ИначеЕсли Добавить Тогда
		Текст = НСтр("fr = 'Cet article est déjà dans les favoris.'; ru = 'Товар уже в избранном.';
			|en = 'This product is already in favourites.'; es = 'El artículo ya está en favoritos.'");
	ИначеЕсли БылоИзменение Тогда
		Текст = НСтр("fr = 'Article retiré des favoris.'; ru = 'Товар убран из избранного.';
			|en = 'The product has been removed from favourites.'; es = 'El artículo se quitó de favoritos.'");
	Иначе
		Текст = НСтр("fr = 'Cet article n’était pas dans les favoris.'; ru = 'Товара не было в избранном.';
			|en = 'This product was not in favourites.'; es = 'El artículo no estaba en favoritos.'");
	КонецЕсли;

	ОбщегоНазначенияКлиент.ВывестиИнформациюДляРМКУправляемой("", Текст);

КонецПроцедуры

// Меняет состав избранного текущего кассира.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - позиция строки чека.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика строки чека.
//  Добавить - Булево - Истина - положить в избранное, Ложь - убрать.
//
// Возвращаемое значение:
//  Булево - Истина, если состав избранного действительно изменился.
//
&НаСервере
Функция ИзменитьИзбранноеНаСервере(Знач Номенклатура, Знач Характеристика, Знач Добавить)

	БылоВИзбранном = РегистрыСведений.ИзбраннаяНоменклатураРМК.ЭтоИзбранное(Номенклатура, Характеристика);
	Если БылоВИзбранном = Добавить Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Добавить Тогда
		РегистрыСведений.ИзбраннаяНоменклатураРМК.ДобавитьВИзбранное(Номенклатура, Характеристика);
	Иначе
		РегистрыСведений.ИзбраннаяНоменклатураРМК.УбратьИзИзбранного(Номенклатура, Характеристика);
	КонецЕсли;

	Возврат Истина;

КонецФункции

