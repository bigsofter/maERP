	// Количество строки кассы - в упаковках строки (CreateFacture переносит его в КоличествоУпаковок), а не в единицах
	// хранения документа.
	ТЗ.Колонки.Добавить("НомерСтрокиДокумента");
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		СтрокаТЗ.Количество = СтрокаТЗ.КоличествоУпаковок;
