&AtClient
Procedure Ajouter(Command)
	Элементы.СтраницыИнформации.ТекущаяСтраница = Элементы.СтраницаИнформации;
	FormParameters = New Structure("Контрагент, МестоХранения", РозничныйКлиент, СкладПродажи());
