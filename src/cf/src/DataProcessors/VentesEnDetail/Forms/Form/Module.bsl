&НаКлиенте
Процедура Valider(Команда)
	ОшибкаПроведенияДокумента = "";
	Если Object.TabularSection.Количество() = 0 Тогда Возврат; КонецЕсли;
	Если Не Object.TabularSection.НайтиСтроки(Новый Структура("Цена",0)).Количество() = 0 Тогда 
		ОбщегоНазначенияКлиент.ВывестиИнформациюДляРМКУправляемой("", НСтр("fr = 'Produits sans prix détectés. La vente est impossible!'; ru = 'Обнаружены товары без цен. Проведение продажи невозможно!'; en = 'Products without prices were found. Conducting a sale is impossible!'; es = 'Se encontraron productos sin precios. ¡La venta es imposible!'"));
		Возврат;
	КонецЕсли;
	Если Не ЧекПрошелКонтрольМинимальнойЦены() Тогда
		Возврат;
	КонецЕсли;
	ValiderНаСервере();
	Если ЗначениеЗаполнено(ОшибкаПроведенияДокумента) Тогда 
		ОбщегоНазначенияКлиент.ВывестиИнформациюДляРМКУправляемой("", ОшибкаПроведенияДокумента);
		Элементы.СтраницыИнформации.ТекущаяСтраница = Элементы.СтраницаИнформации;
		Возврат;
	КонецЕсли;
	ПодтвердитьОперациюНаСервере(ИдентификаторОплаты);
	NewFacture();
	
	RefreshInfo();
КонецПроцедуры

// Контроль минимальной цены чека до оплаты (план docs/plans/retail-cash-price-control.md, §2): новая продажа и
// отложенный чек; нарушение - сообщение кассы, оплата не открывается.
//
// Возвращаемое значение:
//  Булево - Истина, если чек можно оплачивать или проводить.
//
&НаКлиенте
Функция ЧекПрошелКонтрольМинимальнойЦены()
	Если Не (ЭтоПродажа И ПересчитыватьСтрокиЧека) Тогда
		Возврат Истина;
	КонецЕсли;
	Текст = ТекстОтказаМинимальнойЦены();
	Если ПустаяСтрока(Текст) Тогда
		Возврат Истина;
	КонецЕсли;
	ОбщегоНазначенияКлиент.ВывестиИнформациюДляРМКУправляемой("", Текст);
	Элементы.СтраницыИнформации.ТекущаяСтраница = Элементы.СтраницаИнформации;
	Возврат Ложь;
КонецФункции

// Текст отказа контроля минимальной цены по объекту реализации чека без записи. На ордерном складе в режиме
// себестоимости не проверяется: порог зависит от пар с расходными ордерами, которые создаёт только проведение, -
// барьер там проведение (отказ откатывает оплату). Пользователю без права видеть суммы тоже не проверяется: ответ
// «ниже/не ниже» без записи позволил бы дешёвым перебором подобрать скрытую себестоимость - для него барьер только
// проведение (TECHDEBT 2.0.17.3 «Отказ контроля цены - оракул порога»).
//
// Возвращаемое значение:
//  Строка - текст отказа или пустая строка.
//
&НаСервере
Функция ТекстОтказаМинимальнойЦены()
	// Повтор записанной операции (потерянный ответ) не проверяется как новая продажа: документ уже проведён, сервер
	// вернёт результат прежней попытки (docs/plans/retail-cash-unfinished.md, п. 2).
	Если НезавершенныеПродажиКассы.ВыполненнаяОперация(ИдентификаторОплаты) <> Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Склад = СкладПродажи();
	Режим = Справочники.МестаХранения.РежимКонтроляМинимальнойЦены(Склад);
	ПорогПоОрдерам = Режим = Перечисления.РежимыКонтроляМинимальнойЦены.НеНижеСебестоимости
		И Справочники.МестаХранения.ОрдерныйСклад(Склад, ТекущаяДатаСеанса());
	Если Режим = Перечисления.РежимыКонтроляМинимальнойЦены.НеКонтролировать Или ПорогПоОрдерам
		Или Не КонтрольЦенПродажи.ПоказыватьСуммыПользователю() Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Объект = ОбъектРеализацииКассы(Не ЗначениеЗаполнено(CurFacture), Истина);
	Исключение
		Возврат ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Объект.ДополнительныеСвойства.Вставить("ЭтоИнтерфейсПродавца", Истина);
	Возврат КонтрольЦенПродажи.ТекстОтказа(Объект);
КонецФункции

