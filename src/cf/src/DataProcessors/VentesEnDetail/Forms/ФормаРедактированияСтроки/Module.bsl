// Порог минимальной цены склада для строки (план docs/plans/retail-cash-price-control.md, §3): при редактируемой цене,
// контроле склада и без допуска пользователя - запрет ввода ниже порога; показ порога - по праву видеть суммы. На
// ордерном складе в режиме себестоимости порог только показывается (ТолькоПоказ). Сами пороги в реквизиты формы не
// попадают (себестоимость - финансовый показатель): сравнение - на сервере, ЦенаНижеПорогаСклада.
&НаСервере
Процедура НастроитьПорогСклада()
	Если Не РедактироватьЦену Или Не Параметры.Свойство("Склад") Или Не Параметры.Свойство("Номенклатура") Тогда
		Возврат;
	КонецЕсли;
	Характеристика = ?(Параметры.Свойство("Характеристика"), Параметры.Характеристика,
		Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Пороги = КонтрольЦенПродажи.ПорогиЦеныЕдиницы(Параметры.Склад, Параметры.Номенклатура, Характеристика,
		ТекущаяДатаСеанса());
	Если Пороги.Пороги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СкладСтроки = Параметры.Склад;
	ХарактеристикаСтроки = Характеристика;
	СтавкаНДССтроки = ?(Параметры.Свойство("СтавкаНДС"), Параметры.СтавкаНДС, Параметры.Номенклатура.СтавкаНДС);
	КоэффициентУпаковки = 1;
	Если Параметры.Свойство("Упаковка") И ЗначениеЗаполнено(Параметры.Упаковка) Тогда
		КоэффициентУпаковки = ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы(Параметры.Упаковка);
	КонецЕсли;
	ПорогСНДС = 0;
	ПорогБезНДС = 0;
	Для Каждого Порог Из Пороги.Пороги Цикл
		Если Порог.СНДС Тогда
			ПорогСНДС = Макс(ПорогСНДС, Порог.Порог);
		Иначе
			ПорогБезНДС = Макс(ПорогБезНДС, Порог.Порог);
		КонецЕсли;
	КонецЦикла;
	ПоказыватьПорог = КонтрольЦенПродажи.ПоказыватьСуммыПользователю();
	// Без права видеть суммы редактор не проверяет порог: его ответ «ниже/не ниже» на любую цену позволил бы подобрать
	// скрытую себестоимость дешёвым перебором. Барьер для такого пользователя - проверка чека до оплаты и проведение.
	ЗапрещатьНижеПорога = ПоказыватьПорог И Не Пороги.ТолькоПоказ И Не КонтрольЦенПродажи.ДопускПродажиНижеМинимальной();
	Если ПоказыватьПорог Тогда
		ПроцентНДС = ОбщегоНазначенияВызовСервераПовтИсп.ПроцентСтавкиНДС(СтавкаНДССтроки);
		ПорогСНДСПоказ = Макс(ПорогСНДС, ПорогБезНДС * (1 + ПроцентНДС / РаботаСДокументамиКлиентСервер.СтоПроцентов()));
		МинимальнаяЦена = Макс(МинимальнаяЦена, Окр(ПорогСНДСПоказ * КоэффициентУпаковки, КоличествоСимволовПослеЗапятой));
		Элементы.МинимальнаяЦена.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры

// Цена строки ниже порога склада - на сервере (пороги клиенту не передаются), правилом проведения
// (РозничныеПродажиКлиентСервер.НижеПорога) в базе каждого порога: с НДС - сумма строки, без НДС - сумма минус НДС по
// ставке строки.
//
// Параметры:
//  Цена       - Число - введённая цена упаковки строки с НДС.
//  Количество - Число - введённое количество в упаковках строки.
//
// Возвращаемое значение:
//  Булево - Истина, если цена ниже порога.
//
&НаСервере
Функция ЦенаНижеПорогаСклада(Знач Цена, Знач Количество)
	Если Не КонтрольЦенПродажи.ПоказыватьСуммыПользователю() Тогда
		Возврат Ложь;
	КонецЕсли;
	Пороги = КонтрольЦенПродажи.ПорогиЦеныЕдиницы(СкладСтроки, Номенклатура, ХарактеристикаСтроки, ТекущаяДатаСеанса());
	Сумма = Окр(Цена * Количество, КоличествоСимволовПослеЗапятой);
	СуммаБезНДС = Сумма - РаботаСДокументамиКлиентСервер.РассчитатьСуммуНДС(СтавкаНДССтроки, Сумма, Истина);
	КоличествоЕдиниц = Количество * КоэффициентУпаковки;
	Для Каждого Порог Из Пороги.Пороги Цикл
		СуммаВБазе = ?(Порог.СНДС, Сумма, СуммаБезНДС);
		Если РозничныеПродажиКлиентСервер.НижеПорога(СуммаВБазе, Порог.Порог, КоличествоЕдиниц) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Текст отказа ввода цены ниже порога склада: с суммой - только при праве видеть суммы.
//
// Возвращаемое значение:
//  Строка - текст.
//
&НаКлиенте
Функция ТекстЦенаНижеПорога()
	Если ПоказыватьПорог Тогда
		Шаблон = НСтр("ru = 'Цена ниже минимальной для склада: %1.'; fr = 'Prix inférieur au minimum de l''entrepôt : %1.';
			|en = 'The price is below the warehouse minimum: %1.'; es = 'El precio es inferior al mínimo del almacén: %1.'");
		Возврат СтрШаблон(Шаблон, Формат(МинимальнаяЦена, "ЧДЦ=2; ЧН=0"));
	КонецЕсли;
	Возврат НСтр("ru = 'Цена ниже минимальной для склада.'; fr = 'Prix inférieur au minimum de l''entrepôt.';
		|en = 'The price is below the warehouse minimum.'; es = 'El precio es inferior al mínimo del almacén.'");
КонецФункции

&НаКлиенте
Процедура ВводимаяЦенаПриИзменении(Элемент)
	ВводимаяЦенаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВводимаяЦенаПриИзмененииНаСервере()
	Если ПривестиСтрокуКЧислу(ВводимаяЦена)<МинимальнаяЦена Тогда 
		Элементы.ВводимаяЦена.ЦветТекста = ЦветаСтиля.Цвет_Красный;
	Иначе
		Элементы.ВводимаяЦена.ЦветТекста = Новый Цвет();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти