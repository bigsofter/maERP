// Панель избранных отчётов в «Главном». Плитка строится программно: заголовок-гиперссылка,
// гиперссылки действий, строка состояния и поле HTML-документа с уменьшенным снимком отчёта.
// Щелчок по заголовку или образу открывает отчёт с сохранёнными вариантом и настройками.
// Снимки старше часа обновляются фоновым заданием после открытия формы.

#Область ОписаниеПеременных

// Фоновое формирование снимков: результат ДлительныеОперации.ВыполнитьВФоне, пока задание идёт.
&НаКлиенте
Перем ДлительнаяОперация;

// Идентификаторы, обновление которых запрошено, пока шло фоновое задание: запускаются по его завершении.
&НаКлиенте
Перем ОтложенныеИдентификаторы;

#КонецОбласти

// BSLLS:PrivilegedModuleMethodCall-off - форма работает с избранным только своего пользователя ИБ.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПостроитьПлитки();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// BSLLS:MagicNumber-off - секунды: дать форме отрисоваться до запуска фонового обновления.
	ПодключитьОбработчикОжидания("ОбновитьУстаревшие", 0.1, Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = ИмяСобытияИзменения() И Источник <> ЭтотОбъект Тогда
		ПостроитьПлитки();
		ОбновитьУстаревшие();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Обработчик нажатия на заголовок плитки. Подключается через УстановитьДействие.
//
// Параметры:
//  Элемент - ДекорацияФормы - заголовок плитки.
//
&НаКлиенте
Процедура ЗаголовокНажатие(Элемент)

	ОткрытьОтчет(СтрокаПлитки(Элемент.Имя));

КонецПроцедуры

// Обработчик щелчка по образу плитки. Подключается через УстановитьДействие.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML-документа образа.
//  ДанныеСобытия - ФиксированнаяСтруктура - данные события.
//  СтандартнаяОбработка - Булево - переход по ссылкам внутри снимка не нужен.
//
&НаКлиенте
Процедура ОбразПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьОтчет(СтрокаПлитки(Элемент.Имя));

КонецПроцедуры

// Обработчик гиперссылок действий плитки: обновить, переименовать, выше, ниже, убрать.
//
// Параметры:
//  Элемент - ДекорацияФормы - гиперссылка действия; действие - часть имени до номера плитки.
//
&НаКлиенте
Процедура ДействиеНажатие(Элемент)

	Строка = СтрокаПлитки(Элемент.Имя);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Действие = Лев(Элемент.Имя, СтрНайти(Элемент.Имя, "_") - 1);

	Если Действие = "Обновить" Тогда
		Идентификаторы = Новый Массив;
		Идентификаторы.Добавить(Строка.Идентификатор);
		ЗапуститьОбновление(Идентификаторы);
	ИначеЕсли Действие = "Переименовать" Тогда
		Оповещение = Новый ОписаниеОповещения("ПереименоватьЗавершение", ЭтотОбъект, Строка.Идентификатор);
		Текущее = Элементы["Заголовок_" + Формат(Строка.Номер, "ЧГ=0")].Заголовок;
		Подсказка = НСтр("ru = 'Название плитки'; fr = 'Nom de la tuile'; en = 'Tile name'; es = 'Nombre del mosaico'");
		ПоказатьВводСтроки(Оповещение, Текущее, Подсказка, ДлинаНаименования());
	ИначеЕсли Действие = "Выше" Или Действие = "Ниже" Тогда
		СдвинутьНаСервере(Строка.Идентификатор, ?(Действие = "Выше", -1, 1));
	ИначеЕсли Действие = "Убрать" Тогда
		Оповещение = Новый ОписаниеОповещения("УбратьЗавершение", ЭтотОбъект, Строка.Идентификатор);
		Вопрос = НСтр("ru = 'Убрать отчёт из избранного?'; fr = 'Retirer le rapport des favoris ?';
			|en = 'Remove the report from favourites?'; es = '¿Quitar el informe de favoritos?'");
		ПоказатьВопрос(Оповещение, Вопрос, РежимДиалогаВопрос.ДаНет);
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВсеОтчеты(Команда)

	ОткрытьФорму("Обработка.КонсольОтчетов.Форма.ВсеОтчеты");

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВсе(Команда)

	Идентификаторы = Новый Массив;
	Для Каждого Строка Из Плитки Цикл
		Если Строка.Доступен И Не Строка.Ярлык Тогда
			Идентификаторы.Добавить(Строка.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	ЗапуститьОбновление(Идентификаторы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПереименоватьЗавершение(Наименование, Идентификатор) Экспорт

	Если Наименование = Неопределено Или ПустаяСтрока(Наименование) Тогда
		Возврат;
	КонецЕсли;
	ПереименоватьНаСервере(Идентификатор, Наименование);
	Оповестить(ИмяСобытияИзменения(), , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура УбратьЗавершение(Ответ, Идентификатор) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		УбратьНаСервере(Идентификатор);
		Оповестить(ИмяСобытияИзменения(), , ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчет(Строка)

	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДанныеОткрытия = ПараметрыОткрытия(Строка.Идентификатор);
	Если ДанныеОткрытия = Неопределено Тогда
		ПостроитьПлитки();
		Возврат;
	КонецЕсли;
	ОткрытьФорму(ДанныеОткрытия.ПолноеИмяОтчета + ".Форма", ДанныеОткрытия.ПараметрыФормы, ЭтотОбъект,
		?(ДанныеОткрытия.Ярлык, Неопределено, Строка.Идентификатор));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыОткрытия(Знач Идентификатор)

	Данные = ИзбранныеОтчетыПолныеПрава.ДанныеИзбранного(Идентификатор);
	Если Данные = Неопределено Или Не ПанельОтчетов.ОтчетДоступен(Данные.ПолноеИмяОтчета) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	Если Не Данные.Ярлык Тогда
		Если Не ПустаяСтрока(Данные.КлючВарианта) Тогда
			ПараметрыФормы.Вставить("КлючВарианта", Данные.КлючВарианта);
		КонецЕсли;
		Если Данные.ПользовательскиеНастройки <> Неопределено Тогда
			ПараметрыФормы.Вставить("ПользовательскиеНастройки", Данные.ПользовательскиеНастройки);
		КонецЕсли;
		ПараметрыФормы.Вставить("ИдентификаторИзбранного", Идентификатор);
		ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	КонецЕсли;

	Возврат Новый Структура("ПолноеИмяОтчета, ПараметрыФормы, Ярлык", Данные.ПолноеИмяОтчета, ПараметрыФормы, Данные.Ярлык);

КонецФункции

&НаКлиенте
Функция СтрокаПлитки(ИмяЭлемента)

	Номер = Число(Сред(ИмяЭлемента, СтрНайти(ИмяЭлемента, "_") + 1));
	Найденные = Плитки.НайтиСтроки(Новый Структура("Номер", Номер));
	Возврат ?(Найденные.Количество() = 0, Неопределено, Найденные[0]);

КонецФункции

&НаКлиенте
Процедура ОбновитьУстаревшие()

	Идентификаторы = Новый Массив;
	Для Каждого Строка Из Плитки Цикл
		Если Строка.НужноОбновить Тогда
			Идентификаторы.Добавить(Строка.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	ЗапуститьОбновление(Идентификаторы);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОбновление(Идентификаторы)

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ДлительнаяОперация <> Неопределено И ДлительнаяОперация.Статус = "Выполняется" Тогда
		Если ОтложенныеИдентификаторы = Неопределено Тогда
			ОтложенныеИдентификаторы = Новый Массив;
		КонецЕсли;
		Для Каждого Идентификатор Из Идентификаторы Цикл
			Если ОтложенныеИдентификаторы.Найти(Идентификатор) = Неопределено Тогда
				ОтложенныеИдентификаторы.Добавить(Идентификатор);
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	ДлительнаяОперация = НачатьОбновлениеНаСервере(Идентификаторы);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	Оповещение = Новый ОписаниеОповещения("ОбновлениеЗавершено", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция НачатьОбновлениеНаСервере(Знач Идентификаторы)

	Для Каждого Идентификатор Из Идентификаторы Цикл
		Найденные = Плитки.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
		Если Найденные.Количество() > 0 Тогда
			Элементы["Состояние_" + Формат(Найденные[0].Номер, "ЧГ=0")].Заголовок =
				НСтр("ru = 'Формируется…'; fr = 'Génération…'; en = 'Generating…'; es = 'Generando…'");
		КонецЕсли;
	КонецЦикла;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Образы избранных отчётов'");
	Возврат ДлительныеОперации.ВыполнитьВФоне("ПанельОтчетов.СформироватьСнимки",
		Новый Структура("Идентификаторы", Идентификаторы), ПараметрыВыполнения);

КонецФункции

&НаКлиенте
Процедура ОбновлениеЗавершено(Результат, ДополнительныеПараметры) Экспорт

	ДлительнаяОперация = Неопределено;
	Если Результат <> Неопределено И Результат.Статус = "Ошибка" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Образы отчётов не обновлены'; fr = 'Aperçus non actualisés';
			|en = 'Snapshots not refreshed'; es = 'Vistas no actualizadas'"), , Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	ПостроитьПлитки();

	Если ОтложенныеИдентификаторы <> Неопределено Тогда
		Идентификаторы = ОтложенныеИдентификаторы;
		ОтложенныеИдентификаторы = Неопределено;
		ЗапуститьОбновление(Идентификаторы);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПереименоватьНаСервере(Знач Идентификатор, Знач Наименование)

	ИзбранныеОтчетыПолныеПрава.Переименовать(Идентификатор, Наименование);
	ПостроитьПлитки();

КонецПроцедуры

&НаСервере
Процедура СдвинутьНаСервере(Знач Идентификатор, Знач Направление)

	ИзбранныеОтчетыПолныеПрава.Сдвинуть(Идентификатор, Направление);
	ПостроитьПлитки();

КонецПроцедуры

&НаСервере
Процедура УбратьНаСервере(Знач Идентификатор)

	ИзбранныеОтчетыПолныеПрава.Удалить(Идентификатор);
	ПостроитьПлитки();

КонецПроцедуры

&НаСервере
Процедура ПостроитьПлитки()

	ОчиститьПлитки();
	Данные = ИзбранныеОтчетыПолныеПрава.СписокИзбранного();
	Элементы.ДекорацияПусто.Видимость = Данные.Количество() = 0;

	ДобавляемыеРеквизиты = Новый Массив;
	Для Номер = 1 По Данные.Количество() Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяОбраза(Номер), Новый ОписаниеТипов("Строка")));
	КонецЦикла;
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	КоличествоОбразов = Данные.Количество();

	Номер = 0;
	Для Каждого Элемент Из Данные Цикл
		Номер = Номер + 1;
		Строка = Плитки.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Элемент);
		Строка.Номер = Номер;
		Строка.ИмяОбраза = ИмяОбраза(Номер);
		Колонка = ?(Номер % КолонокПлиток() = 1, Элементы.ГруппаКолонка1, Элементы.ГруппаКолонка2);
		ДобавитьПлитку(Элемент, Номер, Колонка, Номер = 1, Номер = Данные.Количество());
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОчиститьПлитки()

	Для Каждого Колонка Из ПолучитьМассивКолонок() Цикл
		Удаляемые = Новый Массив;
		Для Каждого Элемент Из Колонка.ПодчиненныеЭлементы Цикл
			Удаляемые.Добавить(Элемент);
		КонецЦикла;
		Для Каждого Элемент Из Удаляемые Цикл
			Элементы.Удалить(Элемент);
		КонецЦикла;
	КонецЦикла;

	УдаляемыеРеквизиты = Новый Массив;
	Для Номер = 1 По КоличествоОбразов Цикл
		УдаляемыеРеквизиты.Добавить(ИмяОбраза(Номер));
	КонецЦикла;
	Если УдаляемыеРеквизиты.Количество() > 0 Тогда
		ИзменитьРеквизиты(, УдаляемыеРеквизиты);
	КонецЕсли;
	КоличествоОбразов = 0;
	Плитки.Очистить();

КонецПроцедуры

&НаСервере
Функция ПолучитьМассивКолонок()

	Колонки = Новый Массив;
	Колонки.Добавить(Элементы.ГруппаКолонка1);
	Колонки.Добавить(Элементы.ГруппаКолонка2);
	Возврат Колонки;

КонецФункции

&НаСервере
Процедура ДобавитьПлитку(Данные, Номер, Колонка, Первая, Последняя)

	Суффикс = "_" + Формат(Номер, "ЧГ=0");

	Плитка = Элементы.Добавить("Плитка" + Суффикс, Тип("ГруппаФормы"), Колонка);
	Плитка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Плитка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Плитка.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
	Плитка.ОтображатьЗаголовок = Ложь;
	Плитка.РастягиватьПоГоризонтали = Истина;

	Шапка = Элементы.Добавить("Шапка" + Суффикс, Тип("ГруппаФормы"), Плитка);
	Шапка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Шапка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	Шапка.Отображение = ОтображениеОбычнойГруппы.Нет;
	Шапка.ОтображатьЗаголовок = Ложь;

	Надпись = Элементы.Добавить("Заголовок" + Суффикс, Тип("ДекорацияФормы"), Шапка);
	Надпись.Заголовок = Данные.Наименование;
	Надпись.Гиперссылка = Данные.Доступен;
	Надпись.РастягиватьПоГоризонтали = Истина;
	Надпись.Шрифт = ШрифтыСтиля.Шрифт_Основной_Увеличенный;
	Надпись.УстановитьДействие("Нажатие", "ЗаголовокНажатие");

	Если Данные.Доступен И Не Данные.Ярлык Тогда
		ДобавитьДействие("Обновить", Суффикс, Шапка, "⟳",
			НСтр("ru = 'Обновить образ'; fr = 'Actualiser l''aperçu'; en = 'Refresh snapshot'; es = 'Actualizar la vista'"));
	КонецЕсли;
	ДобавитьДействие("Переименовать", Суффикс, Шапка, "✎",
		НСтр("ru = 'Переименовать'; fr = 'Renommer'; en = 'Rename'; es = 'Renombrar'"));
	Если Не Первая Тогда
		ДобавитьДействие("Выше", Суффикс, Шапка, "↑", НСтр("ru = 'Выше'; fr = 'Monter'; en = 'Move up'; es = 'Subir'"));
	КонецЕсли;
	Если Не Последняя Тогда
		ДобавитьДействие("Ниже", Суффикс, Шапка, "↓", НСтр("ru = 'Ниже'; fr = 'Descendre'; en = 'Move down'; es = 'Bajar'"));
	КонецЕсли;
	ДобавитьДействие("Убрать", Суффикс, Шапка, "✕",
		НСтр("ru = 'Убрать из избранного'; fr = 'Retirer des favoris'; en = 'Remove from favourites'; es = 'Quitar de favoritos'"));

	Состояние = Элементы.Добавить("Состояние" + Суффикс, Тип("ДекорацияФормы"), Плитка);
	Состояние.Заголовок = ТекстСостояния(Данные);
	Состояние.ЦветТекста = ЦветаСтиля.Цвет_ПоясняющийТекст;

	Если Данные.Ярлык Или Не Данные.Доступен Тогда
		Возврат;
	КонецЕсли;

	Сообщение = Данные.ОшибкаСнимка;
	Если ПустаяСтрока(Сообщение) Тогда
		Сообщение = НСтр("ru = 'Образ формируется…'; fr = 'Aperçu en cours…'; en = 'Snapshot in progress…';
			|es = 'Vista en preparación…'");
	КонецЕсли;
	ЭтотОбъект[ИмяОбраза(Номер)] = ПанельОтчетов.HTMLПлитки(Данные.Снимок, Сообщение);
	Образ = Элементы.Добавить(ИмяОбраза(Номер), Тип("ПолеФормы"), Плитка);
	Образ.Вид = ВидПоляФормы.ПолеHTMLДокумента;
	Образ.ПутьКДанным = ИмяОбраза(Номер);
	Образ.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Образ.Высота = ВысотаОбраза();
	Образ.РастягиватьПоГоризонтали = Истина;
	Образ.РастягиватьПоВертикали = Ложь;
	Образ.УстановитьДействие("ПриНажатии", "ОбразПриНажатии");

КонецПроцедуры

&НаСервере
Процедура ДобавитьДействие(Действие, Суффикс, Шапка, Символ, Подсказка)

	Ссылка = Элементы.Добавить(Действие + Суффикс, Тип("ДекорацияФормы"), Шапка);
	Ссылка.Заголовок = Символ;
	Ссылка.Гиперссылка = Истина;
	Ссылка.Подсказка = Подсказка;
	Ссылка.УстановитьДействие("Нажатие", "ДействиеНажатие");

КонецПроцедуры

&НаСервере
Функция ТекстСостояния(Данные)

	Если Не Данные.Доступен Тогда
		Возврат НСтр("ru = 'Нет доступа к отчёту - уберите плитку из избранного';
			|fr = 'Pas d''accès au rapport - retirez la tuile des favoris';
			|en = 'No access to the report - remove the tile from favourites';
			|es = 'Sin acceso al informe - quite el mosaico de favoritos'");
	ИначеЕсли Данные.Ярлык Тогда
		Возврат НСтр("ru = 'Отчёт открывается по щелчку'; fr = 'Le rapport s''ouvre d''un clic';
			|en = 'Click to open the report'; es = 'El informe se abre con un clic'");
	ИначеЕсли Не ПустаяСтрока(Данные.ОшибкаСнимка) Тогда
		Возврат НСтр("ru = 'Образ не сформирован'; fr = 'Aperçu non généré'; en = 'Snapshot not generated';
			|es = 'Vista no generada'");
	ИначеЕсли ЗначениеЗаполнено(Данные.ДатаСнимка) И Не ПустаяСтрока(Данные.Снимок) Тогда
		Шаблон = НСтр("ru = 'Обновлено %1'; fr = 'Actualisé le %1'; en = 'Updated %1'; es = 'Actualizado %1'");
		Возврат СтрШаблон(Шаблон, Формат(Данные.ДатаСнимка, "ДФ='dd.MM HH:mm'"));
	Иначе
		Возврат НСтр("ru = 'Формируется…'; fr = 'Génération…'; en = 'Generating…'; es = 'Generando…'");
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяОбраза(Номер)

	Возврат "Образ_" + Формат(Номер, "ЧГ=0");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяСобытияИзменения()

	Возврат "ИзбранныеОтчеты.Изменены";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДлинаНаименования()

	// BSLLS:MagicNumber-off - длина реквизита Наименование регистра ИзбранныеОтчеты.
	Возврат 150;
	// BSLLS:MagicNumber-on

КонецФункции

&НаСервереБезКонтекста
Функция КолонокПлиток()

	Возврат 2;

КонецФункции

&НаСервереБезКонтекста
Функция ВысотаОбраза()

	// BSLLS:MagicNumber-off - строк формы под образ плитки.
	Возврат 12;
	// BSLLS:MagicNumber-on

КонецФункции

#КонецОбласти

