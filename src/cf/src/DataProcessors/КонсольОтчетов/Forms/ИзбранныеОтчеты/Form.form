    <title>
      <key>fr</key>
      <value>Tous les rapports</value>
    </title>
    <title>
      <key>en</key>
      <value>All reports</value>
    </title>
    <title>
      <key>es</key>
      <value>Todos los informes</value>
    </title>
    <id>1</id>
    <toolTip>
      <key>ru</key>
      <value>Все отчёты и варианты с поиском</value>
    </toolTip>
    <toolTip>
      <key>fr</key>
      <value>Tous les rapports et variantes avec recherche</value>
    </toolTip>
    <toolTip>
      <key>en</key>
      <value>All reports and variants with search</value>
    </toolTip>
    <toolTip>
