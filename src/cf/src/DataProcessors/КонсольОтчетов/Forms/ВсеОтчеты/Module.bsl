// Все отчёты, доступные пользователю, деревом «раздел - отчёт - вариант» с поиском.
// Каталог строится один раз при открытии (ПанельОтчетов.КаталогОтчетов) и фильтруется на сервере
// по строке поиска. Отсюда отчёт открывают, добавляют вариант в избранное, удаляют свой вариант.

#Область ОписаниеПеременных

// Последний введённый текст строки поиска: применяется с задержкой, пока пользователь печатает.
&НаКлиенте
Перем ТекстПоиска;

#КонецОбласти

// BSLLS:PrivilegedModuleMethodCall-off - форма работает с избранным только своего пользователя ИБ.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗначениеВРеквизитФормы(ПанельОтчетов.КаталогОтчетов(), "Каталог");
	ЗаполнитьДерево();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = ИмяСобытияИзменения() Тогда
		ОбновитьКаталогНаСервере();
		РазвернутьДерево();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтрокаПоискаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	ТекстПоиска = Текст;
	ОтключитьОбработчикОжидания("ПрименитьПоиск");
	// BSLLS:MagicNumber-off - секунды паузы в наборе текста до поиска.
	ПодключитьОбработчикОжидания("ПрименитьПоиск", 0.4, Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)

	ТекстПоиска = СтрокаПоиска;
	ПрименитьПоиск();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДерево

&НаКлиенте
Процедура ДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьТекущий();

КонецПроцедуры

&НаКлиенте
Процедура ДеревоПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Дерево.ТекущиеДанные;
	ЕстьОтчет = ТекущиеДанные <> Неопределено И ТекущиеДанные.Вид > 0;
	Элементы.ФормаОткрыть.Доступность = ЕстьОтчет;
	Элементы.ФормаВИзбранное.Доступность = ЕстьОтчет
		И Не (ТекущиеДанные.Ярлык И ТекущиеДанные.Вид = ВидВарианта());
	Элементы.ФормаУдалитьВариант.Доступность = ТекущиеДанные <> Неопределено И ТекущиеДанные.Свой;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьВыбранный(Команда)

	ОткрытьТекущий();

КонецПроцедуры

&НаКлиенте
Процедура ВИзбранное(Команда)

	ТекущиеДанные = Элементы.Дерево.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Вид = 0 Тогда
		Возврат;
	КонецЕсли;

	Наименование = ТекущиеДанные.Представление;
	Если ТекущиеДанные.Вид = ВидВарианта() Тогда
		Родитель = ТекущиеДанные.ПолучитьРодителя();
		Наименование = Родитель.Представление + ": " + ТекущиеДанные.Представление;
	КонецЕсли;
	ДобавитьВИзбранноеНаСервере(ТекущиеДанные.ПолноеИмяОтчета, ТекущиеДанные.КлючВарианта, Наименование);
	Оповестить(ИмяСобытияИзменения());
	ПоказатьОповещениеПользователя(НСтр("ru = 'Добавлено в избранное'; fr = 'Ajouté aux favoris';
		|en = 'Added to favourites'; es = 'Añadido a favoritos'"), , Наименование);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВариант(Команда)

	ТекущиеДанные = Элементы.Дерево.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ТекущиеДанные.Свой Тогда
		Возврат;
	КонецЕсли;
	Вариант = Новый Структура("ПолноеИмяОтчета, КлючВарианта", ТекущиеДанные.ПолноеИмяОтчета, ТекущиеДанные.КлючВарианта);
	Оповещение = Новый ОписаниеОповещения("УдалитьВариантЗавершение", ЭтотОбъект, Вариант);
	Шаблон = НСтр("ru = 'Удалить ваш вариант «%1»?'; fr = 'Supprimer votre variante « %1 » ?';
		|en = 'Delete your variant ""%1""?'; es = '¿Eliminar su variante «%1»?'");
	ПоказатьВопрос(Оповещение, СтрШаблон(Шаблон, ТекущиеДанные.Представление), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ИзбранныеОтчеты(Команда)

	ОткрытьФорму("Обработка.КонсольОтчетов.Форма.ИзбранныеОтчеты");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрименитьПоиск()

	ПрименитьПоискНаСервере(ТекстПоиска);
	РазвернутьДерево();

КонецПроцедуры

&НаСервере
Процедура ПрименитьПоискНаСервере(Знач Текст)

	СтрокаПоиска = Текст;
	ЗаполнитьДерево();

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДерево()

	Для Каждого Раздел Из Дерево.ПолучитьЭлементы() Цикл
		Если ПустаяСтрока(СтрокаПоиска) Тогда
			Элементы.Дерево.Развернуть(Раздел.ПолучитьИдентификатор(), Ложь);
		Иначе
			Элементы.Дерево.Развернуть(Раздел.ПолучитьИдентификатор(), Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТекущий()

	ТекущиеДанные = Элементы.Дерево.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Вид = 0 Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	Если ТекущиеДанные.Вид = ВидВарианта() Тогда
		ПараметрыФормы.Вставить("КлючВарианта", ТекущиеДанные.КлючВарианта);
	КонецЕсли;
	ОткрытьФорму(ТекущиеДанные.ПолноеИмяОтчета + ".Форма", ПараметрыФормы, ЭтотОбъект,
		ТекущиеДанные.ПолноеИмяОтчета + "|" + ТекущиеДанные.КлючВарианта);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВариантЗавершение(Ответ, Вариант) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	УдалитьВариантНаСервере(Вариант.ПолноеИмяОтчета, Вариант.КлючВарианта);
	РазвернутьДерево();

КонецПроцедуры

&НаСервере
Процедура УдалитьВариантНаСервере(Знач ПолноеИмяОтчета, Знач КлючВарианта)

	ХранилищеВариантовОтчетов.Удалить(ПолноеИмяОтчета, КлючВарианта, ИмяПользователя());
	ОбновитьКаталогНаСервере();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьВИзбранноеНаСервере(Знач ПолноеИмяОтчета, Знач КлючВарианта, Знач Наименование)

	ИзбранныеОтчетыПолныеПрава.Добавить(ПолноеИмяОтчета, КлючВарианта, Наименование);

КонецПроцедуры

&НаСервере
Процедура ОбновитьКаталогНаСервере()

	ЗначениеВРеквизитФормы(ПанельОтчетов.КаталогОтчетов(), "Каталог");
	ЗаполнитьДерево();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДерево()

	ВИзбранном = ИзбранныеОтчетыПолныеПрава.ВариантыВИзбранном();
	Слова = СловаПоиска(СтрокаПоиска);
	ДеревоЗначений = РеквизитФормыВЗначение("Дерево");
	ДеревоЗначений.Строки.Очистить();

	СтрокаРаздела = Неопределено;
	СтрокаОтчета = Неопределено;
	Для Каждого Строка Из Каталог Цикл
		Если Не СтрокаПодходит(Строка, Слова) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаРаздела = Неопределено Или СтрокаРаздела.Представление <> Строка.Раздел Тогда
			СтрокаРаздела = ДеревоЗначений.Строки.Добавить();
			СтрокаРаздела.Представление = Строка.Раздел;
			СтрокаОтчета = Неопределено;
		КонецЕсли;
		Если СтрокаОтчета = Неопределено Или СтрокаОтчета.ПолноеИмяОтчета <> Строка.ПолноеИмяОтчета Тогда
			СтрокаОтчета = ДобавитьСтрокуОтчета(СтрокаРаздела, Строка, ВИзбранном);
		КонецЕсли;
		Если Не ПустаяСтрока(Строка.КлючВарианта) Тогда
			ДобавитьСтрокуВарианта(СтрокаОтчета, Строка, ВИзбранном);
		КонецЕсли;
	КонецЦикла;

	ЗначениеВРеквизитФормы(ДеревоЗначений, "Дерево");

КонецПроцедуры

&НаСервереБезКонтекста
Функция СтрокаПодходит(Строка, Слова)

	ТекстСтроки = Строка.Раздел + " " + Строка.ПредставлениеОтчета + " " + Строка.Описание + " "
		+ Строка.ПредставлениеВарианта;
	Возврат СодержитВсеСлова(ТекстСтроки, Слова);

КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьСтрокуОтчета(СтрокаРаздела, Строка, ВИзбранном)

	СтрокаОтчета = СтрокаРаздела.Строки.Добавить();
	СтрокаОтчета.Представление = Строка.ПредставлениеОтчета;
	СтрокаОтчета.ПолноеИмяОтчета = Строка.ПолноеИмяОтчета;
	СтрокаОтчета.Описание = Строка.Описание;
	СтрокаОтчета.Ярлык = Строка.Ярлык;
	СтрокаОтчета.Вид = ВидОтчета();
	СтрокаОтчета.ВИзбранном = ЗнакИзбранного(ВИзбранном, Строка.ПолноеИмяОтчета, "");
	Возврат СтрокаОтчета;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьСтрокуВарианта(СтрокаОтчета, Строка, ВИзбранном)

	СтрокаВарианта = СтрокаОтчета.Строки.Добавить();
	СтрокаВарианта.Представление = Строка.ПредставлениеВарианта;
	Если Строка.Свой Тогда
		СтрокаВарианта.Представление = СтрокаВарианта.Представление + " "
			+ НСтр("ru = '(мой)'; fr = '(le mien)'; en = '(mine)'; es = '(mío)'");
	КонецЕсли;
	СтрокаВарианта.ПолноеИмяОтчета = Строка.ПолноеИмяОтчета;
	СтрокаВарианта.КлючВарианта = Строка.КлючВарианта;
	СтрокаВарианта.Свой = Строка.Свой;
	СтрокаВарианта.Ярлык = Строка.Ярлык;
	СтрокаВарианта.Вид = ВидВарианта();
	СтрокаВарианта.ВИзбранном = ЗнакИзбранного(ВИзбранном, Строка.ПолноеИмяОтчета, Строка.КлючВарианта);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗнакИзбранного(ВИзбранном, ПолноеИмяОтчета, КлючВарианта)

	Возврат ?(ВИзбранном.Получить(ПолноеИмяОтчета + "|" + КлючВарианта) = Истина, "★", "");

КонецФункции

&НаСервереБезКонтекста
Функция СловаПоиска(Текст)

	Слова = Новый Массив;
	Для Каждого Слово Из СтрРазделить(НРег(СокрЛП(Текст)), " ", Ложь) Цикл
		Слова.Добавить(Слово);
	КонецЦикла;
	Возврат Слова;

КонецФункции

&НаСервереБезКонтекста
Функция СодержитВсеСлова(Текст, Слова)

	ТекстНРег = НРег(Текст);
	Для Каждого Слово Из Слова Цикл
		Если СтрНайти(ТекстНРег, Слово) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидОтчета()

	Возврат 1;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидВарианта()

	Возврат 2;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяСобытияИзменения()

	Возврат "ИзбранныеОтчеты.Изменены";

КонецФункции

#КонецОбласти

// BSLLS:PrivilegedModuleMethodCall-on
