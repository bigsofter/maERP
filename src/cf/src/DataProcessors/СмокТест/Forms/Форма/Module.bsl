// Дымовой тест из пяти проходов.
//
// Проход 1, «открыть все формы»: перебирает формы всех объектов метаданных и получает каждую
// через ПолучитьФорму(), выполняя тем самым ПриСозданииНаСервере. Ловит ошибки серверной части форм:
// несуществующие картинки, битые запросы динсписков, обращения к удалённым реквизитам.
// Формы объектов при этом открываются пустыми - объект новый.
//
// Проход 2, «формы объектов на образцах»: те же основные формы объекта и группы, но с параметром
// «Ключ» по образцу из базы. Ловит то, что проходом 1 не видно: ветки, работающие только с
// записанным объектом. Формы, для которых в базе нет подходящего объекта, дают ПРОПУСК.
//
// Проход 3, «сформировать все печатные формы»: по каждому объекту из
// ПечатныеФормы.ОбъектыСКомандамиПечати() берёт из базы один образец и формирует каждую его
// печатную форму. Ловит ошибки модулей менеджеров печати, которые проходом по формам не видны.
//
// Проход 4, «сформировать все отчёты»: каждый вариант каждого отчёта с основной схемой компоновки
// формируется с заполненными пустыми параметрами. Ловит ошибки схем и вариантов настроек («Поле не
// найдено»), которые проходом 1 не видны: форма отчёта открывается, падает только формирование.
//
// Проход 5, «клиентские проверки» (только пакетный запуск): списки документов открываются, строка ставится на образец и
// на документ с незаполненными реквизитами, выполняется обработчик строки (панель сведений) - ловит ошибки, которые
// видны только при выборе строки (тикет 2606365); рабочие места производства и закупок открываются в режиме «Товары»
// настройки пользователя; структура карточки товара. Документы с пустыми реквизитами записываются и удаляются.
// Третья часть параметра запуска: «БезСтрок» - без прохода 5, «ТолькоСтроки» - только он.
//
// Запуск без интерфейса: 1cv8 ENTERPRISE /C "СмокТест;<путь-к-отчёту>" (см. scripts/smoke.sh).
// Обработка пишет отчёт из строк:
//   "СТАРТ;Форм=N"                        - клиент дошёл до прогона (признак старта для smoke.sh);
//   "ОШИБКА;<что проверялось>;<описание>" - проверка не прошла;
//   "ПУСТО;<печатная форма>"              - форма сформирована, но табличный документ пустой;
//   "ПРОПУСК;<что проверялось>;<причина>" - проверить не на чем или проверка исключена;
//   "ИТОГ;Всего=N;Ошибок=M;НаОбразцах=K;ОшибокНаОбразцах=L;ПечатныхФорм=P;ОшибокПечати=Q;
//    ВариантовОтчетов=R;ОшибокОтчетов=S;КлиентскихПроверок=T;ОшибокКлиента=U"
//                                         - маркер завершения прогона,
// после чего завершает работу клиента. Проверки проходов 2 и 3 в строках отчёта помечены
// префиксами «Образец.», «Печать.» и «Отчет.». При интерактивном открытии формы результат выводится
// сообщениями. Регламент и порядок разбора ошибок - docs/TESTING.md.
//
// В этом модуле - только запуск прогона и отчёт. Состав проверяемых форм, образцы объектов и
// формирование печатных форм живут в модуле менеджера обработки: всё это серверное.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Реквизит-список создаётся программно: состав форм известен только на сервере,
	// а сам перебор идёт на клиенте - ПолучитьФорму клиентский метод.
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СписокФорм", Новый ОписаниеТипов("СписокЗначений")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СписокФормОбъектов", Новый ОписаниеТипов("СписокЗначений")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизитаРежима(), Новый ОписаниеТипов("Булево")));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	// Эта же форма служит клиентским запускателем заполнения тестовых данных: серверную
	// функцию модуля менеджера иначе не позвать, а своей формы у обработки ТестовыеДанные нет.
	// Параметры формы читаются только здесь, поэтому режим сохраняется в реквизите.
	ТолькоТестовыеДанные = Ложь;
	Если Параметры.Свойство("ТолькоТестовыеДанные") Тогда
		ТолькоТестовыеДанные = (Параметры.ТолькоТестовыеДанные = Истина);
	КонецЕсли;
	ЭтотОбъект[ИмяРеквизитаРежима()] = ТолькоТестовыеДанные;

	Если ТолькоТестовыеДанные Тогда
		// Состав форм в этом режиме не нужен: прогон не идёт, заводятся образцы объектов.
		Возврат;
	КонецЕсли;

	Список = ЭтотОбъект["СписокФорм"];
	Для Каждого ПолноеИмяФормы Из Обработки.СмокТест.ПроверяемыеФормы() Цикл
		Список.Добавить(ПолноеИмяФормы);
	КонецЦикла;

	// Второй проход: те же формы объектов, но на образцах из базы. Список готовит сервер,
	// открывает их клиент - ПолучитьФорму клиентский метод.
	СписокОбъектов = ЭтотОбъект["СписокФормОбъектов"];
	Для Каждого ЭлементСписка Из Обработки.СмокТест.ФормыОбъектовСОбразцами() Цикл
		СписокОбъектов.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Прогон запускается отложенно, чтобы форма успела открыться и клиент завершил инициализацию.
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьПрогон", 1, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Подключаемый_ВыполнитьПрогон()

	ПутьОтчета = ПутьФайлаОтчета();

	Если ЭтотОбъект[ИмяРеквизитаРежима()] Тогда
		ЗаполнитьТестовыеДанные(ПутьОтчета);
		Возврат;
	КонецЕсли;

	Ошибки = Новый Массив;
	ВсегоФорм = 0;

	// Маркер старта пишется до прогона: по нему scripts/smoke.sh отличает «клиент не поднялся»
	// от «клиент работает, прогон идёт».
	ЗаписатьМаркерСтарта(ПутьОтчета, ЭтотОбъект["СписокФорм"].Количество());

	Режим = РежимКлиентскихПроверок();
	Если Режим = "ТолькоСтроки" Тогда
		ВыполнитьТолькоКлиентскиеПроверки(ПутьОтчета);
		Возврат;
	КонецЕсли;

	// Не «ИмяФормы»: так называется встроенное свойство формы, оно только для чтения,
	// и одноимённая переменная в модуле формы резолвится в него.
	Для Каждого ЭлементСписка Из ЭтотОбъект["СписокФорм"] Цикл
		ПроверяемаяФорма = ЭлементСписка.Значение;
		ВсегоФорм = ВсегоФорм + 1;
		Попытка
			// Именно ПолучитьФорму: выполняет ПриСозданииНаСервере без показа окна - суть смок-теста.
			// BSLLS:GetFormMethod-off
			ПолучитьФорму(ПроверяемаяФорма);
			// BSLLS:GetFormMethod-on
		Исключение
			Информация = ИнформацияОбОшибке();
			Ошибки.Добавить("ОШИБКА;" + ПроверяемаяФорма + ";" + ОшибкаОднойСтрокой(Информация));
		КонецПопытки;
	КонецЦикла;

	ВсегоФорм = ВсегоФорм + ПроверитьФормыСПараметрами(Ошибки);

	ОшибокФорм = Ошибки.Количество();

	// Второй проход: формы объектов на образцах из базы.
	ИтогОбразцов = ПроверитьФормыНаОбразцах(Ошибки);
	ВсегоНаОбразцах = ИтогОбразцов.Всего;
	ОшибокНаОбразцах = ИтогОбразцов.Ошибок;

	// Третий проход: печатные формы. Формирование идёт на сервере, ошибки ложатся в тот же отчёт.
	Попытка
		ИтогПечати = ИтогПрогонаПечати();
	Исключение
		ИтогПечати = Новый Структура("Строки, Всего, Ошибок", Новый Массив, 0, 1);
		Информация = ИнформацияОбОшибке();
		ИтогПечати.Строки.Добавить("ОШИБКА;Печать;" + ОшибкаОднойСтрокой(Информация));
	КонецПопытки;

	Для Каждого СтрокаПечати Из ИтогПечати.Строки Цикл
		Ошибки.Добавить(СтрокаПечати);
	КонецЦикла;

	// Четвёртый проход: каждый вариант каждого отчёта со схемой компоновки формируется на сервере.
	ИтогОтчетов = ИтогПрогонаОтчетов();
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Ошибки, ИтогОтчетов.Строки);

	// Пятый проход: клиентские проверки. Только пакетный запуск: проход записывает и удаляет документы.
	ИтогКлиента = ИтогКлиентскихПроверок(Ошибки, Не ПустаяСтрока(ПутьОтчета) И Режим <> "БезСтрок");

	СтрокаИтога = "ИТОГ;Всего=" + Формат(ВсегоФорм, ФорматЧисла())
		+ ";Ошибок=" + Формат(ОшибокФорм, ФорматЧисла())
		+ ";НаОбразцах=" + Формат(ВсегоНаОбразцах, ФорматЧисла())
		+ ";ОшибокНаОбразцах=" + Формат(ОшибокНаОбразцах, ФорматЧисла())
		+ ";ПечатныхФорм=" + Формат(ИтогПечати.Всего, ФорматЧисла())
		+ ";ОшибокПечати=" + Формат(ИтогПечати.Ошибок, ФорматЧисла())
		+ ";ВариантовОтчетов=" + Формат(ИтогОтчетов.Всего, ФорматЧисла())
		+ ";ОшибокОтчетов=" + Формат(ИтогОтчетов.Ошибок, ФорматЧисла())
		+ ";КлиентскихПроверок=" + Формат(ИтогКлиента.Всего, ФорматЧисла())
		+ ";ОшибокКлиента=" + Формат(ИтогКлиента.Ошибок, ФорматЧисла());

	Если ПустаяСтрока(ПутьОтчета) Тогда
		// Интерактивный запуск - итог в окно сообщений, клиент не завершаем.
		Для Каждого СтрокаОшибки Из Ошибки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаОшибки);
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаИтога);
	Иначе
		ЗаписатьОтчет(ПутьОтчета, Ошибки, СтрокаИтога);
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

// Ошибка прогона одной строкой: перевод строки в отчёте разделяет записи, поэтому
// внутри описания он заменяется на разделитель. Имя не «ОписаниеОшибки»: так называется
// глобальный метод платформы без параметров, и вызов с параметром до него не доходит.
//
// Параметры:
//  Информация - ИнформацияОбОшибке - перехваченная ошибка
//
// Возвращаемое значение:
//  Строка - описание ошибки для строки отчёта
//
&НаКлиенте
Функция ОшибкаОднойСтрокой(Информация)

	// МенеджерОбработкиОшибок в клиентском контексте 8.5.1 не определён (проверено CheckConfig),
	// поэтому устаревший глобальный метод.
	// BSLLS:DeprecatedMethodCall-off
	Возврат СтрЗаменить(ПодробноеПредставлениеОшибки(Информация), Символы.ПС, " | ");
	// BSLLS:DeprecatedMethodCall-on

КонецФункции

// Режим заполнения тестовых данных: заводит недостающие образцы объектов печати и пишет
// отчёт того же формата, что и прогон. Запускается параметром /C "ТестовыеДанные;<отчёт>",
// см. scripts/fixtures.sh; параметром /C "ТестовыеДанные;<отчёт>;Демо" - демо-набор контура и торговли
// (scripts/fixtures.sh --demo), "ТестовыеДанные;<отчёт>;Демо;Станки" - ещё и блок учёта станков. Данные при этом
// ЗАПИСЫВАЮТСЯ - только тестовая база.
//
// Параметры:
//  ПутьОтчета - Строка - файл отчёта; пустая строка - интерактивный запуск
//
&НаКлиенте
Процедура ЗаполнитьТестовыеДанные(ПутьОтчета)

	ЗаписатьМаркерСтарта(ПутьОтчета, 0);

	Если РежимДемоНабора() Тогда
		Итог = ИтогДемоНабора(ДемоНаборСоСтанками());
	Иначе
		Итог = ИтогЗаполненияТестовыхДанных();
	КонецЕсли;
	СтрокаИтога = "ИТОГ;Создано=" + Формат(Итог.Создано, ФорматЧисла())
		+ ";Ошибок=" + Формат(Итог.Ошибок, ФорматЧисла())
		+ ";Было=" + Формат(Итог.Было, ФорматЧисла());

	Если ПустаяСтрока(ПутьОтчета) Тогда
		Для Каждого СтрокаОтчета Из Итог.Строки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаОтчета);
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаИтога);
	Иначе
		ЗаписатьОтчет(ПутьОтчета, Итог.Строки, СтрокаИтога);
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

// Заполнение тестовых данных. Логика - в модуле менеджера обработки ТестовыеДанные.
//
// Возвращаемое значение:
//  Структура - см. Обработки.ТестовыеДанные.СоздатьНедостающиеОбразцы
//
&НаСервереБезКонтекста
Функция ИтогЗаполненияТестовыхДанных()

	Возврат Обработки.ТестовыеДанные.СоздатьНедостающиеОбразцы();

КонецФункции

// Демо-набор контура и торговли. Логика - в модуле менеджера обработки ТестовыеДанные. Запуск из scripts/fixtures.sh -
// явное заявление о назначении базы: она тестовая, опции набора включаются.
//
// Параметры:
//  СоСтанками - Булево - заполнить и блок учёта станков, включив учёт станков
//
// Возвращаемое значение:
//  Структура - см. Обработки.ТестовыеДанные.СоздатьДемоНабор
//
&НаСервереБезКонтекста
Функция ИтогДемоНабора(Знач СоСтанками)

	Параметры = Обработки.ТестовыеДанные.НовыеПараметрыДемоНабора();
	Параметры.ТестоваяБаза = Истина;
	Параметры.ВключитьПроизводство = Истина;
	Параметры.ВключитьАвтовыпуск = Истина;
	Если СоСтанками Тогда
		Параметры.Блоки = "CORE,M";
		Параметры.ВключитьУчетСтанков = Истина;
	КонецЕсли;
	Возврат Обработки.ТестовыеДанные.СоздатьДемоНабор(Параметры);

КонецФункции

// Четвёртая часть параметра запуска «Станки»: ТестовыеДанные;<отчёт>;Демо;Станки.
//
// Возвращаемое значение:
//  Булево - заполнить и блок учёта станков
//
&НаКлиенте
Функция ДемоНаборСоСтанками()

	ЧастейСоСтанками = 4;
	ЧастиПараметра = СтрРазделить(ПараметрЗапуска, ";");
	Возврат ЧастиПараметра.Количество() >= ЧастейСоСтанками И СокрЛП(ЧастиПараметра[3]) = "Станки";

КонецФункции

// Третья часть параметра запуска «Демо» включает режим демо-набора: ТестовыеДанные;<отчёт>;Демо.
//
// Возвращаемое значение:
//  Булево - запущено заполнение демо-набора
//
&НаКлиенте
Функция РежимДемоНабора()

	ЧастейСРежимом = 3;
	ЧастиПараметра = СтрРазделить(ПараметрЗапуска, ";");
	Возврат ЧастиПараметра.Количество() >= ЧастейСРежимом И СокрЛП(ЧастиПараметра[2]) = "Демо";

КонецФункции

// Второй проход прогона: печатные формы. Логика - в модуле менеджера обработки.
//
// Возвращаемое значение:
//  Структура - см. Обработки.СмокТест.ПрогнатьПечатныеФормы
//
&НаСервереБезКонтекста
Функция ИтогПрогонаПечати()

	Возврат Обработки.СмокТест.ПрогнатьПечатныеФормы();

КонецФункции

// Итог четвёртого прохода смока - формирование вариантов отчётов.
//
// Возвращаемое значение:
//  Структура - см. Обработки.СмокТест.ПрогнатьОтчеты
//
&НаСервереБезКонтекста
Функция ИтогПрогонаОтчетов()

	Попытка
		Возврат Обработки.СмокТест.ПрогнатьОтчеты();
	Исключение
		Итог = Новый Структура("Строки, Всего, Ошибок", Новый Массив, 0, 1);
		Представление = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Итог.Строки.Добавить("ОШИБКА;Отчет;" + СтрЗаменить(Представление, Символы.ПС, " | "));
		Возврат Итог;
	КонецПопытки;

КонецФункции

// Второй проход прогона: формы объектов на образцах из базы.
//
// Параметры:
//  Ошибки - Массив из Строка - пополняемые строки отчёта.
//
// Возвращаемое значение:
//  Структура - Всего (Число), Ошибок (Число).
//
&НаКлиенте
Функция ПроверитьФормыНаОбразцах(Ошибки)

	// Второй проход: формы объектов на образцах из базы. Открываются те же формы, но с
	// параметром «Ключ» - так проверяются ветки, работающие только с записанным объектом.
	ВсегоНаОбразцах = 0;
	ОшибокНаОбразцах = 0;
	Для Каждого ЭлементСписка Из ЭтотОбъект["СписокФормОбъектов"] Цикл
		ПроверяемаяФорма = ЭлементСписка.Представление;
		Если ЭлементСписка.Значение = Неопределено Тогда
			Ошибки.Добавить("ПРОПУСК;Образец." + ПроверяемаяФорма + ";в базе нет подходящего объекта");
			Продолжить;
		КонецЕсли;
		ВсегоНаОбразцах = ВсегоНаОбразцах + 1;
		Попытка
			// BSLLS:GetFormMethod-off
			ПолучитьФорму(ПроверяемаяФорма, Новый Структура("Ключ", ЭлементСписка.Значение));
			// BSLLS:GetFormMethod-on
		Исключение
			Информация = ИнформацияОбОшибке();
			СтрокаОтчета = "ОШИБКА;Образец." + ПроверяемаяФорма + " (" + Строка(ЭлементСписка.Значение) + ");"
				+ ОшибкаОднойСтрокой(Информация);
			Ошибки.Добавить(СтрокаОтчета);
			ОшибокНаОбразцах = ОшибокНаОбразцах + 1;
		КонецПопытки;
	КонецЦикла;

	Возврат Новый Структура("Всего, Ошибок", ВсегоНаОбразцах, ОшибокНаОбразцах);

КонецФункции

// Отладочный режим «ТолькоСтроки»: один пятый проход.
//
// Параметры:
//  ПутьОтчета - Строка - файл отчёта.
//
&НаКлиенте
Процедура ВыполнитьТолькоКлиентскиеПроверки(ПутьОтчета)

	Ошибки = Новый Массив;
	ИтогКлиента = ПроверитьНаКлиенте(Ошибки);
	СтрокаИтога = "ИТОГ;Всего=0;Ошибок=0;КлиентскихПроверок=" + Формат(ИтогКлиента.Всего, ФорматЧисла())
		+ ";ОшибокКлиента=" + Формат(ИтогКлиента.Ошибок, ФорматЧисла());
	ЗаписатьОтчет(ПутьОтчета, Ошибки, СтрокаИтога);
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

// Параметры:
//  Ошибки   - Массив из Строка - пополняемые строки отчёта.
//  Включено - Булево - проход выполняется; Ложь - в отчёт пишется пропуск.
//
// Возвращаемое значение:
//  Структура - Всего (Число), Ошибок (Число).
//
&НаКлиенте
Функция ИтогКлиентскихПроверок(Ошибки, Включено)

	Если Включено Тогда
		Возврат ПроверитьНаКлиенте(Ошибки);
	КонецЕсли;
	Ошибки.Добавить("ПРОПУСК;Клиент;проход клиентских проверок выключен (интерактивный запуск или «БезСтрок»)");
	Возврат Новый Структура("Всего, Ошибок", 0, 0);

КонецФункции

// Пятый проход: клиентские проверки - строки списков документов, рабочие места в режиме «Товары», карточка товара.
//
// Параметры:
//  Ошибки - Массив из Строка - пополняемые строки отчёта.
//
// Возвращаемое значение:
//  Структура - Всего (Число), Ошибок (Число).
//
&НаКлиенте
Функция ПроверитьНаКлиенте(Ошибки)

	Итог = Новый Структура("Всего, Ошибок", 0, 0);
	Описания = СпискиДляПроверкиСтрок();
	Пустые = Новый Массив;
	Для Каждого Описание Из Описания Цикл
		Если Описание.Пустой <> Неопределено Тогда
			Пустые.Добавить(Описание.Пустой);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Описание Из Описания Цикл
		Если Не ПустаяСтрока(Описание.Причина) Тогда
			Причина = СтрЗаменить(Описание.Причина, Символы.ПС, " | ");
			Ошибки.Добавить("ПРОПУСК;Строка." + Описание.ИмяФормы + ";документ с пустыми реквизитами не записан: " + Причина);
		КонецЕсли;
		ПроверитьСтрокуСписка(Описание.ИмяФормы, Описание.Образец, "образец", Ошибки, Итог);
		ПроверитьСтрокуСписка(Описание.ИмяФормы, Описание.Пустой, "пустые реквизиты", Ошибки, Итог);
	КонецЦикла;
	Для Каждого СтрокаУдаления Из УдалитьПустыеДокументы(Пустые) Цикл
		Ошибки.Добавить(СтрокаУдаления);
		Итог.Ошибок = Итог.Ошибок + 1;
	КонецЦикла;
	ПроверитьРабочиеМестаНаТоварах(Ошибки, Итог);
	ПроверитьКарточкуТовара(Ошибки, Итог);
	Возврат Итог;

КонецФункции

// Открывает список, ставит текущую строку и выполняет обработчик строки (панель сведений). Формы без обработчика
// пропускаются молча: у них нет панели.
//
// Параметры:
//  ПроверяемаяФорма - Строка - полное имя формы списка.
//  Ссылка           - ДокументСсылка, Неопределено - строка; Неопределено - проверять не на чем.
//  Вид              - Строка - «образец» или «пустые реквизиты», для отчёта.
//  Ошибки           - Массив из Строка - строки отчёта.
//  Итог             - Структура - Всего, Ошибок.
//
&НаКлиенте
Процедура ПроверитьСтрокуСписка(ПроверяемаяФорма, Ссылка, Вид, Ошибки, Итог)

	Если Ссылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Путь = "Строка." + ПроверяемаяФорма + " (" + Вид + ")";
	Список = Неопределено;
	Попытка
		// BSLLS:GetFormMethod-off - форма нужна объектом: строка ставится и обработчик зовётся до закрытия.
		Список = ПолучитьФорму(ПроверяемаяФорма);
		// BSLLS:GetFormMethod-on
		Таблица = Список.Элементы.Найти("Список");
		Если Таблица = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Список.Открыть();
		Таблица.ТекущаяСтрока = Ссылка;
	Исключение
		Ошибки.Добавить("ОШИБКА;" + Путь + ";" + ОшибкаОднойСтрокой(ИнформацияОбОшибке()));
		Итог.Всего = Итог.Всего + 1;
		Итог.Ошибок = Итог.Ошибок + 1;
		ЗакрытьПроверяемуюФорму(Список);
		Возврат;
	КонецПопытки;
	Попытка
		Список.Подключаемый_ОбновитьСведения();
		Итог.Всего = Итог.Всего + 1;
		Если Таблица.ТекущаяСтрока <> Ссылка Тогда
			Ошибки.Добавить("ПРОПУСК;" + Путь + ";текущая строка не встала на документ - обработчик выполнен на другой");
		КонецЕсли;
	Исключение
		Информация = ИнформацияОбОшибке();
		// Формы без панели сведений: метода нет - ошибка возникает в этом модуле, а не в модуле списка.
		Если СтрНайти(Информация.ИмяМодуля, "СмокТест") = 0 Тогда
			Ошибки.Добавить("ОШИБКА;" + Путь + ";" + ОшибкаОднойСтрокой(Информация));
			Итог.Всего = Итог.Всего + 1;
			Итог.Ошибок = Итог.Ошибок + 1;
		КонецЕсли;
	КонецПопытки;
	ЗакрытьПроверяемуюФорму(Список);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПроверяемуюФорму(Проверяемая)

	Попытка
		Если Проверяемая <> Неопределено И Проверяемая.Открыта() Тогда
			Проверяемая.Закрыть();
		КонецЕсли;
	Исключение
		// Закрытие не удалось - прогон продолжается, клиент завершится в конце.
		Возврат;
	КонецПопытки;

КонецПроцедуры

// Рабочие места производства и закупок в режиме «Товары» настройки пользователя открываются на товарных закладках
// (тикет 2604974); настройка пользователя после проверки возвращается.
//
// Параметры:
//  Ошибки - Массив из Строка - строки отчёта.
//  Итог   - Структура - Всего, Ошибок.
//
&НаКлиенте
Процедура ПроверитьРабочиеМестаНаТоварах(Ошибки, Итог)

	Прежний = РежимАРМНаВремяПроверки(Истина, Неопределено);
	ПроверитьЗакладкуРабочегоМеста("Обработка.АРМПроизводство.Форма.Форма", "ГруппаВерх", "СтраницаПродукция", Ошибки, Итог);
	ПроверитьЗакладкуРабочегоМеста("Обработка.АРМЗакупки.Форма.Форма", "ГруппаВерх", "СтраницаПотребность", Ошибки, Итог);
	ПроверитьЗакладкуРабочегоМеста("Обработка.АРМЗакупки.Форма.Форма", "ГруппаНиз", "СтраницаТовары", Ошибки, Итог);
	РежимАРМНаВремяПроверки(Ложь, Прежний);

КонецПроцедуры

// Параметры:
//  ПроверяемаяФорма - Строка - полное имя формы рабочего места.
//  ИмяГруппы        - Строка - группа закладок.
//  ИмяСтраницы      - Строка - закладка, ожидаемая в режиме «Товары»; скрытая закладка не проверяется (режим приёмки).
//  Ошибки           - Массив из Строка - строки отчёта.
//  Итог             - Структура - Всего, Ошибок.
//
&НаКлиенте
Процедура ПроверитьЗакладкуРабочегоМеста(ПроверяемаяФорма, ИмяГруппы, ИмяСтраницы, Ошибки, Итог)

	Путь = "РабочееМесто." + ПроверяемаяФорма + "." + ИмяГруппы;
	РабочееМесто = Неопределено;
	Итог.Всего = Итог.Всего + 1;
	Попытка
		// BSLLS:GetFormMethod-off - форма нужна объектом: закладка читается после открытия.
		РабочееМесто = ПолучитьФорму(ПроверяемаяФорма);
		// BSLLS:GetFormMethod-on
		РабочееМесто.Открыть();
		Страница = РабочееМесто.Элементы[ИмяСтраницы];
		Текущая = РабочееМесто.Элементы[ИмяГруппы].ТекущаяСтраница;
		Если Страница.Видимость И Текущая <> Страница Тогда
			Ошибки.Добавить("ОШИБКА;" + Путь + ";в режиме «Товары» открыта закладка "
				+ ?(Текущая = Неопределено, "(нет)", Текущая.Имя) + ", ожидалась " + ИмяСтраницы);
			Итог.Ошибок = Итог.Ошибок + 1;
		КонецЕсли;
	Исключение
		Ошибки.Добавить("ОШИБКА;" + Путь + ";" + ОшибкаОднойСтрокой(ИнформацияОбОшибке()));
		Итог.Ошибок = Итог.Ошибок + 1;
	КонецПопытки;
	ЗакрытьПроверяемуюФорму(РабочееМесто);

КонецПроцедуры

// Карточка товара (тикет 2605408): описание на своей закладке, закладка «Стикер» скрыта, первая закладка - «Свойства».
//
// Параметры:
//  Ошибки - Массив из Строка - строки отчёта.
//  Итог   - Структура - Всего, Ошибок.
//
&НаКлиенте
Процедура ПроверитьКарточкуТовара(Ошибки, Итог)

	Путь = "Карточка.Справочник.Номенклатура.Форма.ФормаЭлемента";
	Итог.Всего = Итог.Всего + 1;
	Попытка
		// BSLLS:GetFormMethod-off - структура формы читается без показа окна.
		Карточка = ПолучитьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента");
		// BSLLS:GetFormMethod-on
		Замечания = Новый Массив;
		Страницы = Карточка.Элементы.ГруппаСтраницы.ПодчиненныеЭлементы;
		Если Страницы[0].Имя <> "СтраницаОсновное" Тогда
			Замечания.Добавить("первая закладка - " + Страницы[0].Имя);
		КонецЕсли;
		Если Карточка.Элементы.Описание.Родитель.Имя <> "СтраницаТекстОписания" Тогда
			Замечания.Добавить("описание не на своей закладке");
		КонецЕсли;
		Если Карточка.Элементы.СтраницаОписание.Видимость Тогда
			Замечания.Добавить("закладка «Стикер» видима");
		КонецЕсли;
		Если Замечания.Количество() > 0 Тогда
			Ошибки.Добавить("ОШИБКА;" + Путь + ";" + СтрСоединить(Замечания, "; "));
			Итог.Ошибок = Итог.Ошибок + 1;
		КонецЕсли;
	Исключение
		Ошибки.Добавить("ОШИБКА;" + Путь + ";" + ОшибкаОднойСтрокой(ИнформацияОбОшибке()));
		Итог.Ошибок = Итог.Ошибок + 1;
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СпискиДляПроверкиСтрок()

	Возврат Обработки.СмокТест.СпискиДляПроверкиСтрок();

КонецФункции

&НаСервереБезКонтекста
Функция УдалитьПустыеДокументы(Знач Ссылки)

	Возврат Обработки.СмокТест.УдалитьПустыеДокументы(Ссылки);

КонецФункции

// Параметры:
//  Включить - Булево - Истина: записать режим «Товары»; Ложь: вернуть прежнее значение.
//  Прежний  - ПеречислениеСсылка.РежимыРаботыАРМ, Неопределено - значение до проверки.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.РежимыРаботыАРМ, Неопределено - значение настройки до вызова.
//
&НаСервереБезКонтекста
Функция РежимАРМНаВремяПроверки(Знач Включить, Знач Прежний)

	Если Включить Тогда
		// Рабочее место закупок открывается на закладке, на которой его закрыли (тикет 2606448): проверяется закладка
		// по умолчанию, запомненная сбрасывается. Возвращать её незачем - закрытие формы в проверке запишет свою.
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("АРМЗакупки/ОткрытаяЗакладка", "ОткрытаяЗакладка", "");
		Возврат Обработки.СмокТест.УстановитьРежимАРМ(Перечисления.РежимыРаботыАРМ.Товары);
	КонецЕсли;
	Возврат Обработки.СмокТест.УстановитьРежимАРМ(Прежний);

КонецФункции

// Третья часть параметра запуска: «БезСтрок» - без пятого прохода, «ТолькоСтроки» - только он.
//
// Возвращаемое значение:
//  Строка - режим или пустая строка.
//
&НаКлиенте
Функция РежимКлиентскихПроверок()

	ЧастейСРежимом = 3;
	ЧастиПараметра = СтрРазделить(ПараметрЗапуска, ";");
	Возврат ?(ЧастиПараметра.Количество() >= ЧастейСРежимом, СокрЛП(ЧастиПараметра[2]), "");

КонецФункции

&НаКлиенте
Функция ПутьФайлаОтчета()

	// Формат параметра запуска: СмокТест;<путь-к-отчёту>
	ЧастейСПутемОтчета = 2;
	ЧастиПараметра = СтрРазделить(ПараметрЗапуска, ";");
	Если ЧастиПараметра.Количество() >= ЧастейСПутемОтчета Тогда
		Возврат СокрЛП(ЧастиПараметра[1]);
	КонецЕсли;
	Возврат "";

КонецФункции

// Пишет в отчёт признак того, что клиент поднялся и прогон начался.
//
// Параметры:
//  ПутьОтчета - Строка - файл отчёта; пустая строка - интерактивный запуск, отчёт не ведётся
//  ФормКПроверке - Число - сколько форм предстоит открыть
//
&НаКлиенте
Процедура ЗаписатьМаркерСтарта(ПутьОтчета, ФормКПроверке)

	Если ПустаяСтрока(ПутьОтчета) Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ПутьОтчета, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("СТАРТ;Форм=" + Формат(ФормКПроверке, ФорматЧисла()));
	Запись.Закрыть();

КонецПроцедуры

// Имя программно добавляемого реквизита формы, в котором хранится режим работы: прогон
// или заполнение тестовых данных.
//
// Возвращаемое значение:
//  Строка - имя реквизита формы
//
&НаКлиентеНаСервереБезКонтекста
Функция ИмяРеквизитаРежима()

	Возврат "РежимТестовыхДанных";

КонецФункции

// Формат целых чисел в отчёте: без разделителей групп, чтобы строку было легко разобрать.
//
// Возвращаемое значение:
//  Строка - форматная строка
//
&НаКлиентеНаСервереБезКонтекста
Функция ФорматЧисла()

	// ЧН=0: без него нулевой счётчик печатается пустой строкой, и в итоге вместо
	// «Ошибок=0» получается «Ошибок=».
	Возврат "ЧГ=0; ЧН=0";

КонецФункции

&НаКлиенте
Процедура ЗаписатьОтчет(ПутьОтчета, Ошибки, СтрокаИтога)

	// Отчёт пишется одним файлом в конце прогона: появление строки "ИТОГ;" - признак завершения
	// для scripts/smoke.sh.
	Запись = Новый ЗаписьТекста(ПутьОтчета, КодировкаТекста.UTF8);
	Для Каждого СтрокаОшибки Из Ошибки Цикл
		Запись.ЗаписатьСтроку(СтрокаОшибки);
	КонецЦикла;
	Запись.ЗаписатьСтроку(СтрокаИтога);
	Запись.Закрыть();

КонецПроцедуры

// Формы, ветки которых работают только с параметром открытия: подбор по назначению и выбор с отбором по типу -
// навигатор номенклатуры считает узлы по этим типам (2.0.16.64).
//
// Параметры:
//  Ошибки - Массив из Строка - строки отчёта, дополняются ошибками
//
// Возвращаемое значение:
//  Число - сколько форм открыто
//
&НаКлиенте
Функция ПроверитьФормыСПараметрами(Ошибки)

	Формы = ФормыСПараметрами();
	Для Каждого Описание Из Формы Цикл
		Попытка
			// BSLLS:GetFormMethod-off
			ПолучитьФорму(Описание.Форма, Описание.Параметры);
			// BSLLS:GetFormMethod-on
		Исключение
			Информация = ИнформацияОбОшибке();
			Ошибки.Добавить("ОШИБКА;" + Описание.Форма + " (" + Описание.Пояснение + ");" + ОшибкаОднойСтрокой(Информация));
		КонецПопытки;
	КонецЦикла;
	Возврат Формы.Количество();

КонецФункции

// Возвращаемое значение:
//  Массив из Структура - Форма (полное имя), Параметры (Структура), Пояснение (Строка)
//
&НаСервереБезКонтекста
Функция ФормыСПараметрами()

	Формы = Новый Массив;
	Номенклатура = Справочники.Номенклатура;
	Назначения = Новый Массив;
	Назначения.Добавить(Номенклатура.НазначениеПодбораПродукция());
	Назначения.Добавить(Номенклатура.НазначениеПодбораМатериалы());
	Для Каждого Назначение Из Назначения Цикл
		ПараметрыФормы = Новый Структура("НазначениеПодбора", Назначение);
		Описание = ОписаниеФормыСПараметрами("Справочник.Номенклатура.Форма.ФормаПодбора", ПараметрыФормы,
			"назначение " + Назначение);
		Формы.Добавить(Описание);
	КонецЦикла;
	Отбор = Новый Структура("ТипНоменклатуры", Перечисления.ТипыНоменклатуры.Сырье);
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	Описание = ОписаниеФормыСПараметрами("Справочник.Номенклатура.Форма.ФормаВыбора", ПараметрыФормы, "отбор по типу");
	Формы.Добавить(Описание);
	// Редактор макета печатной формы открывается только с путём макета (2.0.16.75: ветка удалённого макета -
	// сценарий ФирменнаяПечать, ПечатныеФормы.ПравкаДляРедактирования).
	ПараметрыФормы = Новый Структура("ПутьКМакету", "ОбщийМакет.ФирменныйДокумент");
	Описание = ОписаниеФормыСПараметрами("РегистрСведений.ПользовательскиеМакетыПечати.Форма.РедактированиеМакета",
		ПараметрыФормы, "общий фирменный макет");
	Формы.Добавить(Описание);
	// Выбор рабочего места оборудования и объединение рабочих мест (2.0.16.95): без параметров форма выбора
	// показывает все действующие места, объединение открывается на первом рабочем месте базы.
	Описание = ОписаниеФормыСПараметрами("Справочник.ПодключаемоеОборудование.Форма.ФормаВыбораРабочегоМеста",
		Новый Структура, "все действующие места");
	Формы.Добавить(Описание);
	Выборка = Справочники.РабочиеМеста.Выбрать();
	Если Выборка.Следующий() Тогда
		ПараметрыФормы = Новый Структура("Источник", Выборка.Ссылка);
		Описание = ОписаниеФормыСПараметрами("Справочник.РабочиеМеста.Форма.ФормаОбъединения", ПараметрыФормы,
			"первое рабочее место");
		Формы.Добавить(Описание);
	КонецЕсли;
	Возврат Формы;

КонецФункции

// Параметры:
//  Форма     - Строка - полное имя формы
//  Параметры - Структура - параметры открытия
//  Пояснение - Строка - вариант для отчёта
//
// Возвращаемое значение:
//  Структура - см. ФормыСПараметрами
//
&НаСервереБезКонтекста
Функция ОписаниеФормыСПараметрами(Форма, Параметры, Пояснение)

	Возврат Новый Структура("Форма, Параметры, Пояснение", Форма, Параметры, Пояснение);

КонецФункции

#КонецОбласти
