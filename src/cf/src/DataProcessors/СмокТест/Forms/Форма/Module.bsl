
// Дымовой тест «открыть все формы»: перебирает формы всех объектов метаданных и получает каждую
// через ПолучитьФорму(), выполняя тем самым ПриСозданииНаСервере. Ловит ошибки серверной части форм:
// несуществующие картинки, битые запросы динсписков, обращения к удалённым реквизитам.
//
// Запуск без интерфейса: 1cv8 ENTERPRISE /C "СмокТест;<путь-к-отчёту>" (см. scripts/smoke.sh).
// Обработка пишет отчёт (строки "ОШИБКА;<форма>;<описание>" и "ИТОГ;Всего=N;Ошибок=M")
// и завершает работу клиента. При интерактивном открытии формы результат выводится сообщениями.
// Регламент и порядок разбора ошибок - docs/TESTING.md.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьСписокФорм();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Прогон запускается отложенно, чтобы форма успела открыться и клиент завершил инициализацию.
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьПрогон", 1, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Прогон

&НаКлиенте
Процедура Подключаемый_ВыполнитьПрогон()

	ПутьОтчета = ПутьФайлаОтчета();
	Ошибки = Новый Массив;
	ВсегоФорм = 0;

	// Не «ИмяФормы»: так называется встроенное свойство формы, оно только для чтения,
	// и одноимённая переменная в модуле формы резолвится в него.
	Для Каждого ЭлементСписка Из ЭтотОбъект["СписокФорм"] Цикл
		ПроверяемаяФорма = ЭлементСписка.Значение;
		ВсегоФорм = ВсегоФорм + 1;
		Попытка
			// Именно ПолучитьФорму: выполняет ПриСозданииНаСервере без показа окна - суть смок-теста.
			// BSLLS:GetFormMethod-off
			ПолучитьФорму(ПроверяемаяФорма);
			// BSLLS:GetFormMethod-on
		Исключение
			// МенеджерОбработкиОшибок в клиентском контексте 8.5.1 не определён (проверено CheckConfig),
			// поэтому устаревший глобальный метод.
			// BSLLS:DeprecatedMethodCall-off
			Представление = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			// BSLLS:DeprecatedMethodCall-on
			Описание = СтрЗаменить(Представление, Символы.ПС, " | ");
			Ошибки.Добавить("ОШИБКА;" + ПроверяемаяФорма + ";" + Описание);
		КонецПопытки;
	КонецЦикла;

	СтрокаИтога = "ИТОГ;Всего=" + Формат(ВсегоФорм, "ЧГ=0") + ";Ошибок=" + Формат(Ошибки.Количество(), "ЧГ=0");

	Если ПустаяСтрока(ПутьОтчета) Тогда
		// Интерактивный запуск - итог в окно сообщений, клиент не завершаем.
		Для Каждого СтрокаОшибки Из Ошибки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаОшибки);
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаИтога);
	Иначе
		ЗаписатьОтчет(ПутьОтчета, Ошибки, СтрокаИтога);
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПутьФайлаОтчета()

	// Формат параметра запуска: СмокТест;<путь-к-отчёту>
	ЧастейСПутемОтчета = 2;
	ЧастиПараметра = СтрРазделить(ПараметрЗапуска, ";");
	Если ЧастиПараметра.Количество() >= ЧастейСПутемОтчета Тогда
		Возврат СокрЛП(ЧастиПараметра[1]);
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Процедура ЗаписатьОтчет(ПутьОтчета, Ошибки, СтрокаИтога)

	// Отчёт пишется одним файлом в конце прогона: появление строки "ИТОГ;" - признак завершения
	// для scripts/smoke.sh.
	Запись = Новый ЗаписьТекста(ПутьОтчета, КодировкаТекста.UTF8);
	Для Каждого СтрокаОшибки Из Ошибки Цикл
		Запись.ЗаписатьСтроку(СтрокаОшибки);
	КонецЦикла;
	Запись.ЗаписатьСтроку(СтрокаИтога);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СоставФорм

&НаСервере
Процедура ЗаполнитьСписокФорм()

	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СписокФорм", Новый ОписаниеТипов("СписокЗначений")));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	Список = ЭтотОбъект["СписокФорм"];
	Пропуски = ПропускаемыеФормы();

	Для Каждого Коллекция Из КоллекцииМетаданныхСФормами() Цикл
		Для Каждого ОбъектМетаданных Из Коллекция Цикл
			Для Каждого МетаданныеФормы Из ОбъектМетаданных.Формы Цикл
				ДобавитьФорму(Список, МетаданныеФормы, Пропуски);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Для Каждого МетаданныеФормы Из Метаданные.ОбщиеФормы Цикл
		ДобавитьФорму(Список, МетаданныеФормы, Пропуски);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция КоллекцииМетаданныхСФормами()

	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.Справочники);
	Коллекции.Добавить(Метаданные.Документы);
	Коллекции.Добавить(Метаданные.ЖурналыДокументов);
	Коллекции.Добавить(Метаданные.Перечисления);
	Коллекции.Добавить(Метаданные.Отчеты);
	Коллекции.Добавить(Метаданные.Обработки);
	Коллекции.Добавить(Метаданные.ПланыВидовХарактеристик);
	Коллекции.Добавить(Метаданные.ПланыСчетов);
	Коллекции.Добавить(Метаданные.ПланыОбмена);
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Коллекции.Добавить(Метаданные.РегистрыНакопления);
	Коллекции.Добавить(Метаданные.РегистрыБухгалтерии);
	Коллекции.Добавить(Метаданные.КритерииОтбора);
	Возврат Коллекции;

КонецФункции

&НаСервере
Процедура ДобавитьФорму(Список, МетаданныеФормы, Пропуски)

	ПолноеИмя = МетаданныеФормы.ПолноеИмя();
	Если Пропуски.Найти(ПолноеИмя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ФормаДоступнаНаКомпьютере(МетаданныеФормы) Тогда
		Возврат;
	КонецЕсли;
	Список.Добавить(ПолноеИмя);

КонецПроцедуры

&НаСервере
Функция ФормаДоступнаНаКомпьютере(МетаданныеФормы)

	Назначения = Неопределено;
	Попытка
		Назначения = МетаданныеФормы.НазначенияИспользования;
	Исключение
		// Свойство недоступно на текущей платформе - считаем форму настольной.
		Возврат Истина;
	КонецПопытки;
	Если Назначения = Неопределено Тогда
		// Назначения не заданы - форма доступна везде, в том числе на компьютере.
		Возврат Истина;
	КонецЕсли;

	// Сравнение по XML-имени: системного перечисления «ИспользованиеНазначения» в глобальном
	// контексте сервера нет (проверено CheckConfig), а XML-имена стабильны и не зависят от локали.
	Для Каждого Назначение Из Назначения Цикл
		Попытка
			ИмяНазначения = XMLСтрока(Назначение);
		Исключение
			// Значение не сериализуется - не рискуем, считаем форму настольной.
			Возврат Истина;
		КонецПопытки;
		Если ИмяНазначения = "PersonalComputer" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервере
Функция ПропускаемыеФормы()

	// Формы, которые нельзя получить без параметров или контекста. Каждый пропуск - с причиной.
	// Пополняя список, фиксируй причину и здесь, и в docs/TESTS.xlsx (лист «Пропуски смока»).
	Пропуски = Новый Массив;

	// Обязательные параметры формы (без них ПриСозданииНаСервере падает по построению).
	Пропуски.Добавить("Справочник.СерииНоменклатуры.Форма.УстановкаСерий");
	Пропуски.Добавить("Справочник.СерииНоменклатуры.Форма.ВыборСерииПоОстаткам");
	Пропуски.Добавить("Справочник.УпаковкиЕдиницыИзмерения.Форма.ФормаВыбораИзДокументов");
	Пропуски.Добавить("Документ.ЗаказПоставщику.Форма.ПодборПредварительныхЗаказов");
	Пропуски.Добавить("Документ.ОперацияБух.Форма.ФормаНастройки");
	Пропуски.Добавить("Обработка.ГрупповоеИзменениеРеквизитов.Форма.ВыбранныеЭлементы");
	Пропуски.Добавить("Обработка.ГрупповоеИзменениеРеквизитов.Форма.РедактированиеФормулы");
	Пропуски.Добавить("Обработка.ЛичныйКабинетПартнера.Форма.ФормаЗаявкиНаПоискТовара");
	Пропуски.Добавить("Обработка.ПечатьЭтикеток.Форма.ВыборСерииПоОстаткам");
	Пропуски.Добавить("Обработка.РегистрацияИзмененийДляОбменаДанными.Форма.ВыборКонстанты");
	Пропуски.Добавить("Обработка.РегистрацияИзмененийДляОбменаДанными.Форма.ВыборОбъектовОтбором");
	Пропуски.Добавить("Обработка.РегламентныеИФоновыеЗадания.Форма.ДиалогРегламентногоЗадания");
	Пропуски.Добавить("Обработка.РегламентныеИФоновыеЗадания.Форма.ДиалогФоновогоЗадания");
	Пропуски.Добавить("Обработка.РегламентныеИФоновыеЗадания.Форма.ДиалогНастроекСписка");
	Пропуски.Добавить("Обработка.РегламентныеИФоновыеЗадания.Форма.ДиалогОтбораРегламентногоЗадания");
	Пропуски.Добавить("Обработка.РегламентныеИФоновыеЗадания.Форма.ДиалогОтбораФоновогоЗадания");
	Пропуски.Добавить("РегистрСведений.РеквизитыКонтрагентов.Форма.ИсторияИзменений");
	Пропуски.Добавить("РегистрСведений.РеквизитыКонтрагентов.Форма.ВводНомераТелефона");
	Пропуски.Добавить("РегистрСведений.РеквизитыКонтрагентов.Форма.ВводДополнительныхДанных");
	Пропуски.Добавить("РегистрНакопления.ТоварыВНаличии.Форма.ВыборПартииПоОстаткам");
	Пропуски.Добавить("ОбщаяФорма.ВыборЗначений");
	Пропуски.Добавить("ОбщаяФорма.ВыборСвязанныхДанных");
	Пропуски.Добавить("ОбщаяФорма.ПредварительныйПросмотр");
	Пропуски.Добавить("ОбщаяФорма.ПодборОбъектовРасчётовПоОстаткам");
	Пропуски.Добавить("ОбщаяФорма.РедактированиеНДСПлатёжногоДокумента");
	Пропуски.Добавить("ОбщаяФорма.ФормаНастройки1ССканерыШтрихкода");
	Пропуски.Добавить("ОбщаяФорма.ФормаНастройкиУниверсальныйДрайвер");

	// Платформа: форму отчёта можно получить только для конкретного отчёта.
	Пропуски.Добавить("ОбщаяФорма.ФормаОтчёта");

	// Создание нового запрещено бизнес-логикой (ОбработкаЗаполнения: только вводом на основании).
	Пропуски.Добавить("Документ.ВозвратПоставщику.Форма.ФормаДокумента");
	Пропуски.Добавить("Документ.ВозвратПоставщикуНалоговый.Форма.ФормаДокумента");
	Пропуски.Добавить("Документ.ВыплатаЗарплаты.Форма.ФормаДокумента");

	// Интерактивное добавление не предусмотрено правами (объекты пополняются программно).
	Пропуски.Добавить("ПланВидовХарактеристик.ВидыНастроекПользователей.Форма.ФормаЭлемента");
	Пропуски.Добавить("ПланВидовХарактеристик.ВидыНастроекПользователей.Форма.ФормаГруппы");
	Пропуски.Добавить("ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов.Форма.ФормаЭлемента");
	Пропуски.Добавить("ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Форма.ФормаЭлемента");
	Пропуски.Добавить("ПланСчетов.Хозрасчетный.Форма.ФормаСчета");
	Пропуски.Добавить("Справочник.ВариантыВыходаНаРаботу.Форма.ФормаЭлемента");

	// Обработка сама запрещает запуск при включённом режиме совместимости - до поднятия
	// compatibilityMode (docs/TECHDEBT.md).
	Пропуски.Добавить("Обработка.ГрупповоеИзменениеРеквизитов.Форма.Форма");

	Возврат Пропуски;

КонецФункции

#КонецОбласти

#КонецОбласти
