// Дымовой тест из трёх проходов.
//
// Проход 1, «открыть все формы»: перебирает формы всех объектов метаданных и получает каждую
// через ПолучитьФорму(), выполняя тем самым ПриСозданииНаСервере. Ловит ошибки серверной части форм:
// несуществующие картинки, битые запросы динсписков, обращения к удалённым реквизитам.
// Формы объектов при этом открываются пустыми - объект новый.
//
// Проход 2, «формы объектов на образцах»: те же основные формы объекта и группы, но с параметром
// «Ключ» по образцу из базы. Ловит то, что проходом 1 не видно: ветки, работающие только с
// записанным объектом. Формы, для которых в базе нет подходящего объекта, дают ПРОПУСК.
//
// Проход 3, «сформировать все печатные формы»: по каждому объекту из
// ПечатныеФормы.ОбъектыСКомандамиПечати() берёт из базы один образец и формирует каждую его
// печатную форму. Ловит ошибки модулей менеджеров печати, которые проходом по формам не видны.
//
// Запуск без интерфейса: 1cv8 ENTERPRISE /C "СмокТест;<путь-к-отчёту>" (см. scripts/smoke.sh).
// Обработка пишет отчёт из строк:
//   "СТАРТ;Форм=N"                        - клиент дошёл до прогона (признак старта для smoke.sh);
//   "ОШИБКА;<что проверялось>;<описание>" - проверка не прошла;
//   "ПУСТО;<печатная форма>"              - форма сформирована, но табличный документ пустой;
//   "ПРОПУСК;<что проверялось>;<причина>" - проверить не на чем или проверка исключена;
//   "ИТОГ;Всего=N;Ошибок=M;НаОбразцах=K;ОшибокНаОбразцах=L;ПечатныхФорм=P;ОшибокПечати=Q"
//                                         - маркер завершения прогона,
// после чего завершает работу клиента. Проверки проходов 2 и 3 в строках отчёта помечены
// префиксами «Образец.» и «Печать.». При интерактивном открытии формы результат выводится
// сообщениями. Регламент и порядок разбора ошибок - docs/TESTING.md.
//
// В этом модуле - только запуск прогона и отчёт. Состав проверяемых форм, образцы объектов и
// формирование печатных форм живут в модуле менеджера обработки: всё это серверное.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Реквизит-список создаётся программно: состав форм известен только на сервере,
	// а сам перебор идёт на клиенте - ПолучитьФорму клиентский метод.
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СписокФорм", Новый ОписаниеТипов("СписокЗначений")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СписокФормОбъектов", Новый ОписаниеТипов("СписокЗначений")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизитаРежима(), Новый ОписаниеТипов("Булево")));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	// Эта же форма служит клиентским запускателем заполнения тестовых данных: серверную
	// функцию модуля менеджера иначе не позвать, а своей формы у обработки ТестовыеДанные нет.
	// Параметры формы читаются только здесь, поэтому режим сохраняется в реквизите.
	ТолькоТестовыеДанные = Ложь;
	Если Параметры.Свойство("ТолькоТестовыеДанные") Тогда
		ТолькоТестовыеДанные = (Параметры.ТолькоТестовыеДанные = Истина);
	КонецЕсли;
	ЭтотОбъект[ИмяРеквизитаРежима()] = ТолькоТестовыеДанные;

	Если ТолькоТестовыеДанные Тогда
		// Состав форм в этом режиме не нужен: прогон не идёт, заводятся образцы объектов.
		Возврат;
	КонецЕсли;

	Список = ЭтотОбъект["СписокФорм"];
	Для Каждого ПолноеИмяФормы Из Обработки.СмокТест.ПроверяемыеФормы() Цикл
		Список.Добавить(ПолноеИмяФормы);
	КонецЦикла;

	// Второй проход: те же формы объектов, но на образцах из базы. Список готовит сервер,
	// открывает их клиент - ПолучитьФорму клиентский метод.
	СписокОбъектов = ЭтотОбъект["СписокФормОбъектов"];
	Для Каждого ЭлементСписка Из Обработки.СмокТест.ФормыОбъектовСОбразцами() Цикл
		СписокОбъектов.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Прогон запускается отложенно, чтобы форма успела открыться и клиент завершил инициализацию.
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьПрогон", 1, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Подключаемый_ВыполнитьПрогон()

	ПутьОтчета = ПутьФайлаОтчета();

	Если ЭтотОбъект[ИмяРеквизитаРежима()] Тогда
		ЗаполнитьТестовыеДанные(ПутьОтчета);
		Возврат;
	КонецЕсли;

	Ошибки = Новый Массив;
	ВсегоФорм = 0;

	// Маркер старта пишется до прогона: по нему scripts/smoke.sh отличает «клиент не поднялся»
	// от «клиент работает, прогон идёт».
	ЗаписатьМаркерСтарта(ПутьОтчета, ЭтотОбъект["СписокФорм"].Количество());

	// Не «ИмяФормы»: так называется встроенное свойство формы, оно только для чтения,
	// и одноимённая переменная в модуле формы резолвится в него.
	Для Каждого ЭлементСписка Из ЭтотОбъект["СписокФорм"] Цикл
		ПроверяемаяФорма = ЭлементСписка.Значение;
		ВсегоФорм = ВсегоФорм + 1;
		Попытка
			// Именно ПолучитьФорму: выполняет ПриСозданииНаСервере без показа окна - суть смок-теста.
			// BSLLS:GetFormMethod-off
			ПолучитьФорму(ПроверяемаяФорма);
			// BSLLS:GetFormMethod-on
		Исключение
			Информация = ИнформацияОбОшибке();
			Ошибки.Добавить("ОШИБКА;" + ПроверяемаяФорма + ";" + ОписаниеОшибки(Информация));
		КонецПопытки;
	КонецЦикла;

	ОшибокФорм = Ошибки.Количество();

	// Второй проход: формы объектов на образцах из базы. Открываются те же формы, но с
	// параметром «Ключ» - так проверяются ветки, работающие только с записанным объектом.
	ВсегоНаОбразцах = 0;
	ОшибокНаОбразцах = 0;
	Для Каждого ЭлементСписка Из ЭтотОбъект["СписокФормОбъектов"] Цикл
		ПроверяемаяФорма = ЭлементСписка.Представление;
		Если ЭлементСписка.Значение = Неопределено Тогда
			Ошибки.Добавить("ПРОПУСК;Образец." + ПроверяемаяФорма + ";в базе нет подходящего объекта");
			Продолжить;
		КонецЕсли;
		ВсегоНаОбразцах = ВсегоНаОбразцах + 1;
		Попытка
			// BSLLS:GetFormMethod-off
			ПолучитьФорму(ПроверяемаяФорма, Новый Структура("Ключ", ЭлементСписка.Значение));
			// BSLLS:GetFormMethod-on
		Исключение
			Информация = ИнформацияОбОшибке();
			СтрокаОтчета = "ОШИБКА;Образец." + ПроверяемаяФорма + " (" + Строка(ЭлементСписка.Значение) + ");"
				+ ОписаниеОшибки(Информация);
			Ошибки.Добавить(СтрокаОтчета);
			ОшибокНаОбразцах = ОшибокНаОбразцах + 1;
		КонецПопытки;
	КонецЦикла;

	// Третий проход: печатные формы. Формирование идёт на сервере, ошибки ложатся в тот же отчёт.
	Попытка
		ИтогПечати = ИтогПрогонаПечати();
	Исключение
		ИтогПечати = Новый Структура("Строки, Всего, Ошибок", Новый Массив, 0, 1);
		Информация = ИнформацияОбОшибке();
		ИтогПечати.Строки.Добавить("ОШИБКА;Печать;" + ОписаниеОшибки(Информация));
	КонецПопытки;

	Для Каждого СтрокаПечати Из ИтогПечати.Строки Цикл
		Ошибки.Добавить(СтрокаПечати);
	КонецЦикла;

	СтрокаИтога = "ИТОГ;Всего=" + Формат(ВсегоФорм, ФорматЧисла())
		+ ";Ошибок=" + Формат(ОшибокФорм, ФорматЧисла())
		+ ";НаОбразцах=" + Формат(ВсегоНаОбразцах, ФорматЧисла())
		+ ";ОшибокНаОбразцах=" + Формат(ОшибокНаОбразцах, ФорматЧисла())
		+ ";ПечатныхФорм=" + Формат(ИтогПечати.Всего, ФорматЧисла())
		+ ";ОшибокПечати=" + Формат(ИтогПечати.Ошибок, ФорматЧисла());

	Если ПустаяСтрока(ПутьОтчета) Тогда
		// Интерактивный запуск - итог в окно сообщений, клиент не завершаем.
		Для Каждого СтрокаОшибки Из Ошибки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаОшибки);
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаИтога);
	Иначе
		ЗаписатьОтчет(ПутьОтчета, Ошибки, СтрокаИтога);
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

// Ошибка прогона одной строкой: перевод строки в отчёте разделяет записи, поэтому
// внутри описания он заменяется на разделитель.
//
// Параметры:
//  Информация - ИнформацияОбОшибке - перехваченная ошибка
//
// Возвращаемое значение:
//  Строка - описание ошибки для строки отчёта
//
&НаКлиенте
Функция ОписаниеОшибки(Информация)

	// МенеджерОбработкиОшибок в клиентском контексте 8.5.1 не определён (проверено CheckConfig),
	// поэтому устаревший глобальный метод.
	// BSLLS:DeprecatedMethodCall-off
	Возврат СтрЗаменить(ПодробноеПредставлениеОшибки(Информация), Символы.ПС, " | ");
	// BSLLS:DeprecatedMethodCall-on

КонецФункции

// Режим заполнения тестовых данных: заводит недостающие образцы объектов печати и пишет
// отчёт того же формата, что и прогон. Запускается параметром /C "ТестовыеДанные;<отчёт>",
// см. scripts/fixtures.sh. Данные при этом ЗАПИСЫВАЮТСЯ - только тестовая база.
//
// Параметры:
//  ПутьОтчета - Строка - файл отчёта; пустая строка - интерактивный запуск
//
&НаКлиенте
Процедура ЗаполнитьТестовыеДанные(ПутьОтчета)

	ЗаписатьМаркерСтарта(ПутьОтчета, 0);

	Итог = ИтогЗаполненияТестовыхДанных();
	СтрокаИтога = "ИТОГ;Создано=" + Формат(Итог.Создано, ФорматЧисла())
		+ ";Ошибок=" + Формат(Итог.Ошибок, ФорматЧисла())
		+ ";Было=" + Формат(Итог.Было, ФорматЧисла());

	Если ПустаяСтрока(ПутьОтчета) Тогда
		Для Каждого СтрокаОтчета Из Итог.Строки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаОтчета);
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаИтога);
	Иначе
		ЗаписатьОтчет(ПутьОтчета, Итог.Строки, СтрокаИтога);
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

// Заполнение тестовых данных. Логика - в модуле менеджера обработки ТестовыеДанные.
//
// Возвращаемое значение:
//  Структура - см. Обработки.ТестовыеДанные.СоздатьНедостающиеОбразцы
//
&НаСервереБезКонтекста
Функция ИтогЗаполненияТестовыхДанных()

	Возврат Обработки.ТестовыеДанные.СоздатьНедостающиеОбразцы();

КонецФункции

// Второй проход прогона: печатные формы. Логика - в модуле менеджера обработки.
//
// Возвращаемое значение:
//  Структура - см. Обработки.СмокТест.ПрогнатьПечатныеФормы
//
&НаСервереБезКонтекста
Функция ИтогПрогонаПечати()

	Возврат Обработки.СмокТест.ПрогнатьПечатныеФормы();

КонецФункции

&НаКлиенте
Функция ПутьФайлаОтчета()

	// Формат параметра запуска: СмокТест;<путь-к-отчёту>
	ЧастейСПутемОтчета = 2;
	ЧастиПараметра = СтрРазделить(ПараметрЗапуска, ";");
	Если ЧастиПараметра.Количество() >= ЧастейСПутемОтчета Тогда
		Возврат СокрЛП(ЧастиПараметра[1]);
	КонецЕсли;
	Возврат "";

КонецФункции

// Пишет в отчёт признак того, что клиент поднялся и прогон начался.
//
// Параметры:
//  ПутьОтчета - Строка - файл отчёта; пустая строка - интерактивный запуск, отчёт не ведётся
//  ФормКПроверке - Число - сколько форм предстоит открыть
//
&НаКлиенте
Процедура ЗаписатьМаркерСтарта(ПутьОтчета, ФормКПроверке)

	Если ПустаяСтрока(ПутьОтчета) Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ПутьОтчета, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("СТАРТ;Форм=" + Формат(ФормКПроверке, ФорматЧисла()));
	Запись.Закрыть();

КонецПроцедуры

// Имя программно добавляемого реквизита формы, в котором хранится режим работы: прогон
// или заполнение тестовых данных.
//
// Возвращаемое значение:
//  Строка - имя реквизита формы
//
&НаКлиентеНаСервереБезКонтекста
Функция ИмяРеквизитаРежима()

	Возврат "РежимТестовыхДанных";

КонецФункции

// Формат целых чисел в отчёте: без разделителей групп, чтобы строку было легко разобрать.
//
// Возвращаемое значение:
//  Строка - форматная строка
//
&НаКлиентеНаСервереБезКонтекста
Функция ФорматЧисла()

	// ЧН=0: без него нулевой счётчик печатается пустой строкой, и в итоге вместо
	// «Ошибок=0» получается «Ошибок=».
	Возврат "ЧГ=0; ЧН=0";

КонецФункции

&НаКлиенте
Процедура ЗаписатьОтчет(ПутьОтчета, Ошибки, СтрокаИтога)

	// Отчёт пишется одним файлом в конце прогона: появление строки "ИТОГ;" - признак завершения
	// для scripts/smoke.sh.
	Запись = Новый ЗаписьТекста(ПутьОтчета, КодировкаТекста.UTF8);
	Для Каждого СтрокаОшибки Из Ошибки Цикл
		Запись.ЗаписатьСтроку(СтрокаОшибки);
	КонецЦикла;
	Запись.ЗаписатьСтроку(СтрокаИтога);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти
