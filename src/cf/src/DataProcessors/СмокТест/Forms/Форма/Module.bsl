
// Дымовой тест из двух проходов.
//
// Проход 1, «открыть все формы»: перебирает формы всех объектов метаданных и получает каждую
// через ПолучитьФорму(), выполняя тем самым ПриСозданииНаСервере. Ловит ошибки серверной части форм:
// несуществующие картинки, битые запросы динсписков, обращения к удалённым реквизитам.
//
// Проход 2, «сформировать все печатные формы»: по каждому объекту из
// ПечатныеФормы.ОбъектыСКомандамиПечати() берёт из базы один образец и формирует каждую его
// печатную форму. Ловит ошибки модулей менеджеров печати, которые проходом по формам не видны.
//
// Запуск без интерфейса: 1cv8 ENTERPRISE /C "СмокТест;<путь-к-отчёту>" (см. scripts/smoke.sh).
// Обработка пишет отчёт из строк:
//   "СТАРТ;<дата>"                        - клиент дошёл до прогона (признак старта для smoke.sh);
//   "ОШИБКА;<что проверялось>;<описание>" - проверка не прошла;
//   "ПУСТО;<печатная форма>"              - форма сформирована, но табличный документ пустой;
//   "ПРОПУСК;<печатная форма>;<причина>"  - проверить не на чем или проверка исключена;
//   "ИТОГ;Всего=N;Ошибок=M;ПечатныхФорм=K;ОшибокПечати=L" - маркер завершения прогона,
// после чего завершает работу клиента. При интерактивном открытии формы результат выводится
// сообщениями. Регламент и порядок разбора ошибок - docs/TESTING.md.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьСписокФорм();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Прогон запускается отложенно, чтобы форма успела открыться и клиент завершил инициализацию.
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьПрогон", 1, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Прогон

&НаКлиенте
Процедура Подключаемый_ВыполнитьПрогон()

	ПутьОтчета = ПутьФайлаОтчета();
	Ошибки = Новый Массив;
	ВсегоФорм = 0;

	// Маркер старта пишется до прогона: по нему scripts/smoke.sh отличает «клиент не поднялся»
	// от «клиент работает, прогон идёт».
	ЗаписатьМаркерСтарта(ПутьОтчета, ЭтотОбъект["СписокФорм"].Количество());

	// Не «ИмяФормы»: так называется встроенное свойство формы, оно только для чтения,
	// и одноимённая переменная в модуле формы резолвится в него.
	Для Каждого ЭлементСписка Из ЭтотОбъект["СписокФорм"] Цикл
		ПроверяемаяФорма = ЭлементСписка.Значение;
		ВсегоФорм = ВсегоФорм + 1;
		Попытка
			// Именно ПолучитьФорму: выполняет ПриСозданииНаСервере без показа окна - суть смок-теста.
			// BSLLS:GetFormMethod-off
			ПолучитьФорму(ПроверяемаяФорма);
			// BSLLS:GetFormMethod-on
		Исключение
			// МенеджерОбработкиОшибок в клиентском контексте 8.5.1 не определён (проверено CheckConfig),
			// поэтому устаревший глобальный метод.
			// BSLLS:DeprecatedMethodCall-off
			Представление = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			// BSLLS:DeprecatedMethodCall-on
			Описание = СтрЗаменить(Представление, Символы.ПС, " | ");
			Ошибки.Добавить("ОШИБКА;" + ПроверяемаяФорма + ";" + Описание);
		КонецПопытки;
	КонецЦикла;

	ОшибокФорм = Ошибки.Количество();

	// Второй проход: печатные формы. Формирование идёт на сервере, ошибки ложатся в тот же отчёт.
	Попытка
		ИтогПечати = ПрогнатьПечатныеФормы();
	Исключение
		// BSLLS:DeprecatedMethodCall-off
		ПредставлениеПечати = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		// BSLLS:DeprecatedMethodCall-on
		ИтогПечати = Новый Структура("Строки, Всего, Ошибок", Новый Массив, 0, 1);
		ИтогПечати.Строки.Добавить("ОШИБКА;Печать;" + СтрЗаменить(ПредставлениеПечати, Символы.ПС, " | "));
	КонецПопытки;

	Для Каждого СтрокаПечати Из ИтогПечати.Строки Цикл
		Ошибки.Добавить(СтрокаПечати);
	КонецЦикла;

	СтрокаИтога = "ИТОГ;Всего=" + Формат(ВсегоФорм, ФорматЧисла())
		+ ";Ошибок=" + Формат(ОшибокФорм, ФорматЧисла())
		+ ";ПечатныхФорм=" + Формат(ИтогПечати.Всего, ФорматЧисла())
		+ ";ОшибокПечати=" + Формат(ИтогПечати.Ошибок, ФорматЧисла());

	Если ПустаяСтрока(ПутьОтчета) Тогда
		// Интерактивный запуск - итог в окно сообщений, клиент не завершаем.
		Для Каждого СтрокаОшибки Из Ошибки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаОшибки);
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаИтога);
	Иначе
		ЗаписатьОтчет(ПутьОтчета, Ошибки, СтрокаИтога);
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПутьФайлаОтчета()

	// Формат параметра запуска: СмокТест;<путь-к-отчёту>
	ЧастейСПутемОтчета = 2;
	ЧастиПараметра = СтрРазделить(ПараметрЗапуска, ";");
	Если ЧастиПараметра.Количество() >= ЧастейСПутемОтчета Тогда
		Возврат СокрЛП(ЧастиПараметра[1]);
	КонецЕсли;
	Возврат "";

КонецФункции

// Пишет в отчёт признак того, что клиент поднялся и прогон начался.
//
// Параметры:
//  ПутьОтчета - Строка - файл отчёта; пустая строка - интерактивный запуск, отчёт не ведётся
//  ФормКПроверке - Число - сколько форм предстоит открыть
//
&НаКлиенте
Процедура ЗаписатьМаркерСтарта(ПутьОтчета, ФормКПроверке)

	Если ПустаяСтрока(ПутьОтчета) Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ПутьОтчета, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("СТАРТ;Форм=" + Формат(ФормКПроверке, ФорматЧисла()));
	Запись.Закрыть();

КонецПроцедуры

// Формат целых чисел в отчёте: без разделителей групп, чтобы строку было легко разобрать.
//
// Возвращаемое значение:
//  Строка - форматная строка
//
&НаКлиентеНаСервереБезКонтекста
Функция ФорматЧисла()

	Возврат "ЧГ=0";

КонецФункции

&НаКлиенте
Процедура ЗаписатьОтчет(ПутьОтчета, Ошибки, СтрокаИтога)

	// Отчёт пишется одним файлом в конце прогона: появление строки "ИТОГ;" - признак завершения
	// для scripts/smoke.sh.
	Запись = Новый ЗаписьТекста(ПутьОтчета, КодировкаТекста.UTF8);
	Для Каждого СтрокаОшибки Из Ошибки Цикл
		Запись.ЗаписатьСтроку(СтрокаОшибки);
	КонецЦикла;
	Запись.ЗаписатьСтроку(СтрокаИтога);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область Печать

// Второй проход смока: формирует все печатные формы объектов, переведённых на подсистему печати.
// Для каждого объекта берётся один образец из базы, по нему формируется каждая его печатная форма.
//
// Возвращаемое значение:
//  Структура - итог прогона печати:
//   * Строки - Массив из Строка - строки отчёта видов ОШИБКА, ПУСТО и ПРОПУСК
//   * Всего  - Число           - сколько печатных форм формировалось
//   * Ошибок - Число           - сколько из них не сформировалось
//
&НаСервере
Функция ПрогнатьПечатныеФормы()

	Итог = Новый Структура("Строки, Всего, Ошибок", Новый Массив, 0, 0);
	Строки = Итог.Строки;
	Пропуски = ПропускаемыеПечатныеФормы();

	Для Каждого ПолноеИмяОбъекта Из ПечатныеФормы.ОбъектыСКомандамиПечати() Цикл

		Команды = ПечатныеФормы.КомандыПечатиОбъекта(ПолноеИмяОбъекта);
		Если Команды.Количество() = 0 Тогда
			Строки.Добавить("ОШИБКА;Печать." + ПолноеИмяОбъекта
				+ ";объект заявлен в ОбъектыСКомандамиПечати, но команд печати не вернул");
			Итог.Ошибок = Итог.Ошибок + 1;
			Продолжить;
		КонецЕсли;

		Образец = ОбразецДляПечати(ПолноеИмяОбъекта);
		Если Образец = Неопределено Тогда
			Строки.Добавить("ПРОПУСК;Печать." + ПолноеИмяОбъекта + ";в базе нет ни одного объекта");
			Продолжить;
		КонецЕсли;

		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Образец);

		Для Каждого Команда Из Команды Цикл
			ПроверитьПечатнуюФорму(ПолноеИмяОбъекта, Команда.ИмяМакета, МассивОбъектов, Пропуски, Строки, Итог);
		КонецЦикла;

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Формирует одну печатную форму и складывает результат проверки в отчёт.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка          - объект, чей модуль менеджера печатает
//  ИмяМакета        - Строка          - печатная форма из команд печати объекта
//  МассивОбъектов   - Массив          - образец объекта для печати
//  Пропуски         - Массив из Строка - исключённые печатные формы
//  Строки           - Массив из Строка - пополняемые строки отчёта
//  Итог             - Структура       - см. ПрогнатьПечатныеФормы
//
&НаСервере
Процедура ПроверитьПечатнуюФорму(ПолноеИмяОбъекта, ИмяМакета, МассивОбъектов, Пропуски, Строки, Итог)

	Путь = "Печать." + ПолноеИмяОбъекта + "." + ИмяМакета;
	Если Пропуски.Найти(Путь) <> Неопределено Тогда
		Строки.Добавить("ПРОПУСК;" + Путь + ";исключена в ПропускаемыеПечатныеФормы");
		Возврат;
	КонецЕсли;

	Итог.Всего = Итог.Всего + 1;

	Попытка
		Результат = ПечатныеФормы.СформироватьПечатныеФормы(ПолноеИмяОбъекта, ИмяМакета, МассивОбъектов);
		ПечатнаяФорма = Результат.КоллекцияПечатныхФорм.Найти(ИмяМакета, "ИмяМакета");
		Если ПечатнаяФорма = Неопределено
			Или ТипЗнч(ПечатнаяФорма.ТабличныйДокумент) <> Тип("ТабличныйДокумент") Тогда
			Строки.Добавить("ОШИБКА;" + Путь + ";модуль менеджера не вернул табличный документ");
			Итог.Ошибок = Итог.Ошибок + 1;
			Возврат;
		КонецЕсли;
		Если ПечатнаяФорма.ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
			// Не ошибка: у образца может не быть строк. Но пустых форм быть не должно много.
			Строки.Добавить("ПУСТО;" + Путь);
		КонецЕсли;
	Исключение
		// BSLLS:DeprecatedMethodCall-off
		Представление = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		// BSLLS:DeprecatedMethodCall-on
		Строки.Добавить("ОШИБКА;" + Путь + ";" + СтрЗаменить(Представление, Символы.ПС, " | "));
		Итог.Ошибок = Итог.Ошибок + 1;
	КонецПопытки;

КонецПроцедуры

// Один объект из базы, на котором проверяются печатные формы: последний проведённый документ
// либо любой элемент справочника.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - образец или Неопределено, если объектов в базе нет
//
&НаСервере
Функция ОбразецДляПечати(ПолноеИмяОбъекта)

	Если ПолноеИмяОбъекта = "РегистрСведений.Лиды" Тогда
		// Лиды печатают заказ покупателя, оформленный по лиду, а не саму запись регистра.
		ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Лиды.ЗаказПокупателя КАК Ссылка
			|ИЗ
			|	РегистрСведений.Лиды КАК Лиды
			|ГДЕ
			|	Лиды.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)";
	ИначеЕсли СтрНачинаетсяС(ПолноеИмяОбъекта, "Документ.") Тогда
		ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Таблица.Ссылка КАК Ссылка
			|ИЗ
			|	&ИмяТаблицы КАК Таблица
			|УПОРЯДОЧИТЬ ПО
			|	Таблица.Проведен УБЫВ,
			|	Таблица.Дата УБЫВ";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", ПолноеИмяОбъекта);
	Иначе
		ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Таблица.Ссылка КАК Ссылка
			|ИЗ
			|	&ИмяТаблицы КАК Таблица";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", ПолноеИмяОбъекта);
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Печатные формы, которые прогон не проверяет. Каждый пропуск - с причиной.
// Пополняя список, фиксируй причину и здесь, и в docs/TESTS.xlsx (лист «Пропуски смока»).
//
// Возвращаемое значение:
//  Массив из Строка - пути вида "Печать.Документ.Имя.ИмяМакета"
//
&НаСервере
Функция ПропускаемыеПечатныеФормы()

	Пропуски = Новый Массив;
	Возврат Пропуски;

КонецФункции

#КонецОбласти

#Область СоставФорм

&НаСервере
Процедура ЗаполнитьСписокФорм()

	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СписокФорм", Новый ОписаниеТипов("СписокЗначений")));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	Список = ЭтотОбъект["СписокФорм"];
	Пропуски = ПропускаемыеФормы();

	Для Каждого Коллекция Из КоллекцииМетаданныхСФормами() Цикл
		Для Каждого ОбъектМетаданных Из Коллекция Цикл
			Для Каждого МетаданныеФормы Из ОбъектМетаданных.Формы Цикл
				ДобавитьФорму(Список, МетаданныеФормы, Пропуски);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Для Каждого МетаданныеФормы Из Метаданные.ОбщиеФормы Цикл
		ДобавитьФорму(Список, МетаданныеФормы, Пропуски);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция КоллекцииМетаданныхСФормами()

	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.Справочники);
	Коллекции.Добавить(Метаданные.Документы);
	Коллекции.Добавить(Метаданные.ЖурналыДокументов);
	Коллекции.Добавить(Метаданные.Перечисления);
	Коллекции.Добавить(Метаданные.Отчеты);
	Коллекции.Добавить(Метаданные.Обработки);
	Коллекции.Добавить(Метаданные.ПланыВидовХарактеристик);
	Коллекции.Добавить(Метаданные.ПланыСчетов);
	Коллекции.Добавить(Метаданные.ПланыОбмена);
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Коллекции.Добавить(Метаданные.РегистрыНакопления);
	Коллекции.Добавить(Метаданные.РегистрыБухгалтерии);
	Коллекции.Добавить(Метаданные.КритерииОтбора);
	Возврат Коллекции;

КонецФункции

&НаСервере
Процедура ДобавитьФорму(Список, МетаданныеФормы, Пропуски)

	ПолноеИмя = МетаданныеФормы.ПолноеИмя();
	Если Пропуски.Найти(ПолноеИмя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ФормаДоступнаНаКомпьютере(МетаданныеФормы) Тогда
		Возврат;
	КонецЕсли;
	Список.Добавить(ПолноеИмя);

КонецПроцедуры

&НаСервере
Функция ФормаДоступнаНаКомпьютере(МетаданныеФормы)

	Назначения = Неопределено;
	Попытка
		Назначения = МетаданныеФормы.НазначенияИспользования;
	Исключение
		// Свойство недоступно на текущей платформе - считаем форму настольной.
		Возврат Истина;
	КонецПопытки;
	Если Назначения = Неопределено Тогда
		// Назначения не заданы - форма доступна везде, в том числе на компьютере.
		Возврат Истина;
	КонецЕсли;

	// Сравнение по XML-имени: системного перечисления «ИспользованиеНазначения» в глобальном
	// контексте сервера нет (проверено CheckConfig), а XML-имена стабильны и не зависят от локали.
	Для Каждого Назначение Из Назначения Цикл
		Попытка
			ИмяНазначения = XMLСтрока(Назначение);
		Исключение
			// Значение не сериализуется - не рискуем, считаем форму настольной.
			Возврат Истина;
		КонецПопытки;
		Если ИмяНазначения = "PersonalComputer" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

