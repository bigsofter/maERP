// Прайс-чекер (docs/plans/retail-tools.md, п. 4): товар по штрихкоду или IMEI и цена склада пользователя - той же
// функцией цен, что строка кассы (Справочники.МестаХранения.ЦеныПродажиСклада и ЦенаСтрокиИзЦен).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Данные для экрана прайс-чекера.
//
// Параметры:
//  Штрихкод - Строка - отсканированное или введённое значение.
//  Склад    - СправочникСсылка.МестаХранения, Неопределено - склад цены; Неопределено - склад пользователя.
//
// Возвращаемое значение:
//  Структура - Статус («Найден», «НеНайден», «Неоднозначен»), Наименование (Строка), Цена (Число),
//              Сообщение (Строка).
//
Функция ДанныеЦены(Штрихкод, Склад = Неопределено) Экспорт

	Результат = Новый Структура("Статус, Наименование, Сообщение", "", "", "");
	Результат.Вставить("Цена", 0);
	Товар = ОбщегоНазначенияВызовСервера.НайденныйТоварПоШтрихкоду(СокрЛП(Штрихкод));
	Результат.Статус = Товар.Статус;
	Если Товар.Статус = "НеНайден" Тогда
		Результат.Сообщение = НСтр("ru = 'Товар не найден'; fr = 'Article introuvable'; en = 'Item not found';
			|es = 'Artículo no encontrado'");
		Возврат Результат;
	ИначеЕсли Товар.Статус = "Неоднозначен" Тогда
		Результат.Сообщение = НСтр("ru = 'Обратитесь к продавцу'; fr = 'Adressez-vous au vendeur'; en = 'Please ask a seller';
			|es = 'Consulte al vendedor'");
		Возврат Результат;
	Иначе
		// Найден: цена склада пользователя ниже.
		Результат.Сообщение = "";
	КонецЕсли;
	СкладЦены = ?(Склад = Неопределено, РегистрыСведений.НастройкиПользователей.СкладПользователя(), Склад);
	Цены = Справочники.МестаХранения.ЦеныПродажиСклада(СкладЦены, Товар.Номенклатура, ТекущаяДатаСеанса());
	Результат.Цена = Справочники.МестаХранения.ЦенаСтрокиИзЦен(Цены, Товар.Номенклатура, Товар.Характеристика);
	Части = Новый Массив;
	Части.Добавить(Строка(Товар.Номенклатура));
	Если ЗначениеЗаполнено(Товар.Характеристика) Тогда
		Части.Добавить(Строка(Товар.Характеристика));
	КонецЕсли;
	Если ЗначениеЗаполнено(Товар.Упаковка) Тогда
		Части.Добавить(Строка(Товар.Упаковка));
	КонецЕсли;
	Результат.Наименование = СтрСоединить(Части, ", ");
	Если Результат.Цена = 0 Тогда
		Результат.Сообщение = НСтр("ru = 'Цена не установлена'; fr = 'Prix non défini'; en = 'Price not set';
			|es = 'Precio no establecido'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
