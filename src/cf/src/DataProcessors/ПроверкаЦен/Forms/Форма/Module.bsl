// Прайс-чекер на весь экран: штрихкод со сканера или вручную - товар и цена склада пользователя.

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОперацииСПодключаемымОборудованиемКлиент.ПодключитьОборудование(УникальныйИдентификатор, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ScanData" И ВводДоступен() Тогда
		Штрихкод = ОперацииСПодключаемымОборудованиемКлиент.ПолучитьШтрихкод(ИмяСобытия, Параметр, Источник);
		ПоказатьЦену();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ШтрихкодПриИзменении(Элемент)
	ПоказатьЦену();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьЦену()
	Данные = ДанныеЦеныНаСервере(Штрихкод);
	Наименование = Данные.Наименование;
	Цена = ?(Данные.Статус = "Найден" И Данные.Цена <> 0, Формат(Данные.Цена, "ЧДЦ=2; ЧН=0,00"), "");
	Сообщение = Данные.Сообщение;
	Штрихкод = "";
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеЦеныНаСервере(Знач Штрихкод)
	Возврат Обработки.ПроверкаЦен.ДанныеЦены(Штрихкод);
КонецФункции

#КонецОбласти
