#Область ПрограммныйИнтерфейс

// Права текущего пользователя в рабочем месте «Управление станками»: что показывать и какие действия доступны.
//
// Возвращаемое значение:
//  Структура:
//   * МожноВидетьСтанки        - Булево - учёт станков включён, загрузка станков и требования-накладные читаются.
//   * МожноРазмещатьНаСтанки   - Булево - «Разместить», «Запустить», «Завершить», «Отменить», автоплан.
//   * МожноОбслуживаниеСтанков - Булево - ввод обслуживания станка.
//
Функция ПраваРабочегоМеста() Экспорт

	Добавление = "Добавление";
	Проведение = "Проведение";
	МетаданныеТребования = Метаданные.Документы.ТребованиеНакладная;
	МожноВидетьСтанки = ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтанков")
		И ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ЗагрузкаСтанков)
		И ПравоДоступа("Чтение", МетаданныеТребования);
	МожноРазмещать = МожноВидетьСтанки И ПравоДоступа(Добавление, МетаданныеТребования)
		И ПравоДоступа(Проведение, МетаданныеТребования);
	МетаданныеОбслуживания = Метаданные.Документы.ОбслуживаниеСтанка;
	МожноОбслуживание = МожноВидетьСтанки И ПравоДоступа(Добавление, МетаданныеОбслуживания)
		И ПравоДоступа(Проведение, МетаданныеОбслуживания);
	Права = Новый Структура;
	Права.Вставить("МожноВидетьСтанки", МожноВидетьСтанки);
	Права.Вставить("МожноРазмещатьНаСтанки", МожноРазмещать);
	Права.Вставить("МожноОбслуживаниеСтанков", МожноОбслуживание);
	Возврат Права;

КонецФункции

#КонецОбласти
