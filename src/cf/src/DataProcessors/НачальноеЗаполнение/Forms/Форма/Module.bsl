// Headless-первый запуск: организация, пользователи и служебный администратор из JSON
// вместо визарда ФормаПервогоЗапуска. Клиентский запускатель: читает payload-файл, отдаёт
// его серверу (НачальноеЗаполнениеВызовСервера.ЗаполнитьБазуИзJSON), пишет result-файл и
// отчёт, завершает клиент. Вся логика записи - в общем модуле.
//
// Запуск без интерфейса (scripts/initial-fill.sh, контракт - docs/DEPLOY.md):
//   1cv8c ENTERPRISE /C "НачальноеЗаполнение;<payload.json>;<result.json>[;<отчёт.txt>]"
// Отчёт (по умолчанию <result.json>.report.txt) - строки:
//   "СТАРТ;"                       - клиент дошёл до заполнения (признак старта для run-lib.sh);
//   "ПРЕДУПРЕЖДЕНИЕ;<текст>"       - значение из payload заменено умолчанием;
//   "ИТОГ;Успех=1;<сводка>"        - заполнение выполнено, result-файл записан;
//   "ИТОГ;Успех=0;<ошибка>"        - заполнение не выполнено, в result-файле {"success": false}.
// Паролей ни в отчёте, ни в result-файле нет. Успех определяется по строке ИТОГ и
// result-файлу: кодам возврата 1cv8 скрипты не верят (scripts/run-lib.sh).
// При интерактивном открытии форма только объясняет, как её запускать.

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Заполнение запускается отложенно, чтобы форма успела открыться и клиент завершил инициализацию.
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьЗаполнение", 1, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗаполнение()

	Пути = ПутиИзПараметраЗапуска();
	Если ПустаяСтрока(Пути.Payload) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Обработка запускается параметром командной строки:
			           |/C ""НачальноеЗаполнение;<payload.json>;<result.json>"" - см. docs/DEPLOY.md.';
			     |fr = 'Le traitement se lance par paramètre de ligne de commande :
			           |/C ""НачальноеЗаполнение;<payload.json>;<result.json>"" - voir docs/DEPLOY.md.';
			     |en = 'The data processor is started with a command line parameter:
			           |/C ""НачальноеЗаполнение;<payload.json>;<result.json>"" - see docs/DEPLOY.md.';
			     |es = 'El procesamiento se inicia con un parámetro de línea de comandos:
			           |/C ""НачальноеЗаполнение;<payload.json>;<result.json>"" - véase docs/DEPLOY.md.'"));
		Возврат;
	КонецЕсли;

	// Маркер старта пишется до работы: по нему scripts/run-lib.sh отличает «клиент не поднялся»
	// от «клиент работает».
	ЗаписатьСтрокиОтчета(Пути.Отчет, ОдинЭлемент("СТАРТ;"), Ложь);

	Попытка
		ТекстPayload = ПрочитатьФайл(Пути.Payload);
		Ответ = ЗаполнитьБазуИзJSON(ТекстPayload);
	Исключение
		Информация = ИнформацияОбОшибке();
		Ответ = Новый Структура;
		Ответ.Вставить("Успех", Ложь);
		Ответ.Вставить("Ошибка", ОшибкаОднойСтрокой(Информация));
		Ответ.Вставить("Сводка", Ответ.Ошибка);
		Ответ.Вставить("РезультатJSON", "{""success"": false, ""error"": " + СтрокаВJSON(Ответ.Ошибка) + "}");
	КонецПопытки;

	Строки = Новый Массив;
	Если Ответ.Успех Тогда
		Для Каждого Предупреждение Из ПредупрежденияИзРезультата(Ответ.РезультатJSON) Цикл
			Строки.Добавить("ПРЕДУПРЕЖДЕНИЕ;" + Предупреждение);
		КонецЦикла;
	КонецЕсли;
	Строки.Добавить("ИТОГ;Успех=" + ?(Ответ.Успех, "1", "0") + ";" + СтрЗаменить(Ответ.Сводка, Символы.ПС, " | "));

	Попытка
		ЗаписатьФайл(Пути.Result, Ответ.РезультатJSON);
	Исключение
		Информация = ИнформацияОбОшибке();
		Строки.Добавить("ОШИБКА;result-файл не записан;" + ОшибкаОднойСтрокой(Информация));
	КонецПопытки;

	ЗаписатьСтрокиОтчета(Пути.Отчет, Строки, Истина);
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

// Заполнение базы. Логика - в общем модуле, здесь только вызов с клиента.
//
// Параметры:
//  ТекстJSON - Строка - содержимое payload-файла
//
// Возвращаемое значение:
//  Структура - см. НачальноеЗаполнениеВызовСервера.ЗаполнитьБазуИзJSON
//
&НаСервереБезКонтекста
Функция ЗаполнитьБазуИзJSON(Знач ТекстJSON)

	Возврат НачальноеЗаполнениеВызовСервера.ЗаполнитьБазуИзJSON(ТекстJSON);

КонецФункции

// Пути из параметра запуска: НачальноеЗаполнение;<payload>;<result>[;<отчёт>].
//
// Возвращаемое значение:
//  Структура - Payload, Result, Отчет; Payload пустой - интерактивный запуск
//
&НаКлиенте
Функция ПутиИзПараметраЗапуска()

	Пути = Новый Структура("Payload, Result, Отчет", "", "", "");
	// Формат параметра запуска: НачальноеЗаполнение;<payload>;<result>[;<отчёт>]
	ЧастейСРезультатом = 3;
	ЧастейСОтчетом = 4;
	Части = СтрРазделить(ПараметрЗапуска, ";");
	Если Части.Количество() >= ЧастейСРезультатом Тогда
		Пути.Payload = СокрЛП(Части[1]);
		Пути.Result = СокрЛП(Части[2]);
	КонецЕсли;
	Если Части.Количество() >= ЧастейСОтчетом И Не ПустаяСтрока(Части[3]) Тогда
		Пути.Отчет = СокрЛП(Части[3]);
	ИначеЕсли Не ПустаяСтрока(Пути.Result) Тогда
		Пути.Отчет = Пути.Result + ".report.txt";
	Иначе
		Пути.Отчет = "";
	КонецЕсли;
	Если ПустаяСтрока(Пути.Result) Тогда
		// Без result-файла заполнять нечего - скрипт результата не увидит.
		Пути.Payload = "";
	КонецЕсли;
	Возврат Пути;

КонецФункции

&НаКлиенте
Функция ПрочитатьФайл(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

&НаКлиенте
Процедура ЗаписатьФайл(Путь, Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

// Пишет строки отчёта. Отчёт 1С начинается с BOM - скрипты ищут маркеры без якоря ^.
//
// Параметры:
//  Путь       - Строка - файл отчёта
//  Строки     - Массив из Строка
//  Добавление - Булево - дописывать к существующему файлу
//
&НаКлиенте
Процедура ЗаписатьСтрокиОтчета(Путь, Строки, Добавление)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, , Добавление);
	Для Каждого Строка Из Строки Цикл
		Запись.ЗаписатьСтроку(Строка);
	КонецЦикла;
	Запись.Закрыть();

КонецПроцедуры

// Предупреждения из result-файла для отчёта: сервер отдаёт их внутри JSON, чтобы
// клиент не собирал результат дважды.
//
// Параметры:
//  РезультатJSON - Строка
//
// Возвращаемое значение:
//  Массив из Строка
//
&НаКлиенте
Функция ПредупрежденияИзРезультата(РезультатJSON)

	Предупреждения = Новый Массив;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(РезультатJSON);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Список = Данные.Получить("warnings");
		Если ТипЗнч(Список) = Тип("Массив") Тогда
			Для Каждого Элемент Из Список Цикл
				Предупреждения.Добавить(Строка(Элемент));
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Результат не разобрался - предупреждений в отчёте не будет, result-файл при этом цел.
		Возврат Предупреждения;
	КонецПопытки;
	Возврат Предупреждения;

КонецФункции

&НаКлиенте
Функция СтрокаВJSON(Текст)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Текст);
	Возврат Запись.Закрыть();

КонецФункции

&НаКлиенте
Функция ОдинЭлемент(Значение)

	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;

КонецФункции

// Ошибка одной строкой: перевод строки в отчёте разделяет записи.
//
// Параметры:
//  Информация - ИнформацияОбОшибке
//
// Возвращаемое значение:
//  Строка
//
&НаКлиенте
Функция ОшибкаОднойСтрокой(Информация)

	// МенеджерОбработкиОшибок в клиентском контексте 8.5.1 не определён (проверено CheckConfig в СмокТест).
	// BSLLS:DeprecatedMethodCall-off
	Возврат СтрЗаменить(КраткоеПредставлениеОшибки(Информация), Символы.ПС, " | ");
	// BSLLS:DeprecatedMethodCall-on

КонецФункции

#КонецОбласти
