// Загрузка «после» для перехода базы старой ветки Commerce на maERP (docs/plans/retail-client-update.md, раздел 3):
// файл выгрузки «до» (tools/migration/ВыгрузкаДляПереноса.bsl) применяется к базе после загрузки CF maERP и
// обработчиков обновления. Шаги идемпотентны: повтор не меняет уже перенесённое. Значение, которое в базе уже есть и
// отличается от переносимого, - остановка шага, не пропуск.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Применяет файл выгрузки и сверяет итоги «до/после».
//
// Параметры:
//  ПутьФайла - Строка - файл выгрузки (JSON).
//
// Возвращаемое значение:
//  Массив из Строка - строки отчёта: «РАЗДЕЛ;перенесено;пропущено», «ПРОПУСК;...», «РАСХОЖДЕНИЕ;...», «ОСТАНОВ;...».
//
Функция Загрузить(ПутьФайла) Экспорт
	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Перенос загружает только администратор'; fr = 'Seul l''administrateur charge le transfert';
			|en = 'Only the administrator loads the transfer'; es = 'Solo el administrador carga el traslado'");
	КонецЕсли;
	// Право администрирования проверено выше; перенос пишет служебные регистры и учётные данные обмена.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Отчет = Новый Массив;
	Выгрузка = ПрочитатьВыгрузку(ПутьФайла);
	Если Не ОтпечатокСовпадает(Выгрузка.Отпечаток, Отчет) Тогда
		Отчет.Добавить("ОСТАНОВ;отпечаток базы не совпадает с выгрузкой: в базе создавали или удаляли документы");
		Возврат Отчет;
	КонецЕсли;
	ПеренестиКассовыеОрдера(Выгрузка.КассовыеОрдера, Отчет);
	ПеренестиСкладыКасс(Выгрузка.Кассы, Отчет);
	ПеренестиУбытки(Выгрузка.Убытки, Отчет);
	ПеренестиСтатусыПересчетов(Выгрузка.СтатусыПересчетов, Отчет);
	ПеренестиКонтрагентов(Выгрузка.Контрагенты, Отчет);
	ПеренестиОбмен(Выгрузка.Обмен, Отчет);
	ПеренестиРоли(Выгрузка.Роли, Отчет);
	СверитьИтоги(Выгрузка.Сверка, Отчет);
	ЗакрытьИсториюДляПерепроведения(Отчет);
	Отчет.Добавить("НАПОМИНАНИЕ;файл выгрузки содержит пароли баз партнёров - удалите его: " + ПутьФайла);
	Возврат Отчет;
КонецФункции

// Запросы итогов сверки - те же, что в выгрузке «до» (tools/migration/ВыгрузкаДляПереноса.bsl, ЗапросыСверки).
//
// Возвращаемое значение:
//  Структура - ключ - раздел сверки, значение - текст запроса с полями К1, К2, Сумма, Количество.
//
Функция ЗапросыСверки() Экспорт
	// Остатки и обороты за всё время по всему регистру - сверка итогов «до/после» переноса.
	// BSLLS:VirtualTableCallWithoutParameters-off
	Запросы = Новый Структура;
	Запросы.Вставить("Товары", "ВЫБРАТЬ Т.МестоХранения КАК К1, Т.Номенклатура КАК К2, Т.Характеристика КАК К3, Т.Серия КАК К4,
	|ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма,
	|ЕСТЬNULL(Т.КоличествоОстаток, 0) КАК Количество ИЗ РегистрНакопления.ТоварыВНаличии.Остатки(, ) КАК Т");
	Запросы.Вставить("Покупатели", "ВЫБРАТЬ Т.Контрагент КАК К1, НЕОПРЕДЕЛЕНО КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, ) КАК Т");
	Запросы.Вставить("Поставщики", "ВЫБРАТЬ Т.Контрагент КАК К1, НЕОПРЕДЕЛЕНО КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.ВзаиморасчётыСПоставщиками.Остатки(, ) КАК Т");
	Запросы.Вставить("Деньги", "ВЫБРАТЬ Т.МестоХранения КАК К1, Т.ТипДенежныхСредств КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.ДенежныеСредстваОрганизаций.Остатки(, ) КАК Т");
	Запросы.Вставить("Убытки", "ВЫБРАТЬ Т.МестоХранения КАК К1, Т.ХозяйственнаяОперация КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОборот, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.Убытки.Обороты(, , , ) КАК Т");
	Запросы.Вставить("УбыткиСтатьи", "ВЫБРАТЬ Т.Организация КАК К1, Т.СтатьяДДС КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОборот, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.Убытки.Обороты(, , , ) КАК Т");
	Запросы.Вставить("Продажи", "ВЫБРАТЬ Т.ХозяйственнаяОперация КАК К1, НЕОПРЕДЕЛЕНО КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.ВыручкаОборот, 0) КАК Сумма,
	|ЕСТЬNULL(Т.КоличествоОборот, 0) КАК Количество ИЗ РегистрНакопления.Продажи.Обороты(, , , ) КАК Т");
	Запросы.Вставить("Касса", "ВЫБРАТЬ Т.МестоХранения КАК К1, Т.ТипДенежныхСредств КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОборот, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.ДвиженияПоКассе.Обороты(, , , ) КАК Т");
	// BSLLS:VirtualTableCallWithoutParameters-on
	Возврат Запросы;
КонецФункции

// Роли maERP, которые получает пользователь роли «РуководительПродаж» старой ветки (всё, кроме записи денег).
//
// Возвращаемое значение:
//  Массив из Строка - имена ролей.
//
Функция РолиРуководителяПродаж() Экспорт
	Возврат СтрРазделить("Кладовщик,МенеджерПоПродажам,Руководитель,СкладскиеОрдера,ПотребностиТорговыхТочек,"
		+ "РеализацииИзменениеПроведенных,РедактированиеНоменклатуры,РедактированиеКонтрагентов,"
		+ "РедактированиеПоступлениеТоваровУслуг", ",");
КонецФункции

// Роль даёт запись денежных документов или регистра денег.
//
// Параметры:
//  Роль - ОбъектМетаданных - роль.
//
// Возвращаемое значение:
//  Булево
//
Функция РольПишетДеньги(Роль) Экспорт
	Для Каждого Документ Из ДенежныеДокументы() Цикл
		Если ПравоДоступа("Изменение", Документ, Роль) Или ПравоДоступа("Добавление", Документ, Роль) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ПравоДоступа("Изменение", Метаданные.РегистрыНакопления.ДенежныеСредстваОрганизаций, Роль);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьВыгрузку(ПутьФайла)
	Чтение = Новый ЧтениеJSON;
	// BSLLS:ExternalAppStarting-off - чтение файла выгрузки переноса, не запуск приложения.
	Чтение.ОткрытьФайл(ПутьФайла, "UTF-8");
	// BSLLS:ExternalAppStarting-on
	Выгрузка = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Возврат Выгрузка;
КонецФункции

Функция ОтпечатокСовпадает(Отпечаток, Отчет)
	// Число документов и наибольшая дата по видам, существующим в maERP; созданная переносом корректировка регистров
	// исключается (её создаёт шаг Убытки - после проверки).
	Совпадает = Истина;
	Для Каждого Строка Из Отпечаток Цикл
		МетаданныеВида = Метаданные.Документы.Найти(Строка.Вид);
		Если МетаданныеВида = Неопределено Тогда
			Отчет.Добавить("ПРОПУСК;отпечаток;вида " + Строка.Вид + " нет в maERP (" + Строка.Количество + " док.)");
			Продолжить;
		КонецЕсли;
		// Вид документа - из файла; запрос на вид (их десятки), не на строку данных. Корректировки регистров, созданные
		// самим переносом (записаны в ПеренесенныеДокументы), не признак чужой записи при повторном запуске.
		// BSLLS:QueryParseError-off
		ТекстЗапроса = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К, МАКСИМУМ(Т.Дата) КАК Д ИЗ Документ." + Строка.Вид + " КАК Т";
		// BSLLS:QueryParseError-on
		Если Строка.Вид = "КорректировкаРегистров" Тогда
			ТекстЗапроса = ТекстЗапроса
				+ " ГДЕ НЕ Т.Ссылка В (ВЫБРАТЬ П.ПеренесенныйДокумент ИЗ РегистрСведений.ПеренесенныеДокументы КАК П"
				+ " ГДЕ П.Основание = &Основание)";
		КонецЕсли;
		// BSLLS:CreateQueryInCycle-off
		// BSLLS:QueryParseError-off
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Основание", ПеренесенныеДокументы.ОснованиеКорректировкаПереноса());
		// BSLLS:QueryParseError-on
		Выборка = Запрос.Выполнить().Выбрать();
		// BSLLS:CreateQueryInCycle-on
		Выборка.Следующий();
		Дата = Формат(Выборка.Д, "ДФ=yyyy-MM-ddTHH:mm:ss");
		Количество = Выборка.К;
		Если Количество <> Строка.Количество Или Дата <> Строка.Дата Тогда
			ТекстРасхождения = СтрШаблон("РАСХОЖДЕНИЕ;отпечаток;%1: было %2 по %3, стало %4 по %5", Строка.Вид,
				Строка.Количество, Строка.Дата, Выборка.К, Дата);
			Отчет.Добавить(ТекстРасхождения);
			Совпадает = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Совпадает;
КонецФункции

Функция КомментарийКорректировки()
	Возврат "Перенос убытков списаний из старой редакции";
КонецФункции

Процедура ЗакрытьИсториюДляПерепроведения(Отчет)
	// Граница последовательности - на момент переноса: пересчёт себестоимости maERP не перепроводит историю старой
	// ветки (её движения перенесены и сверены), а считает от неё новые документы.
	Граница = Последовательности.Основная.ПолучитьГраницу();
	Момент = Новый МоментВремени(ТекущаяДатаСеанса());
	Если Граница = Неопределено Или Граница.Сравнить(Момент) < 0 Тогда
		Последовательности.Основная.УстановитьГраницу(Момент);
	КонецЕсли;
	Отчет.Добавить("ПОСЛЕДОВАТЕЛЬНОСТЬ;граница " + Формат(Момент.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
КонецПроцедуры

Процедура ПеренестиКассовыеОрдера(Ордера, Отчет)
	Перенесено = 0;
	Пропущено = 0;
	Для Каждого Строка Из Ордера Цикл
		Ссылка = Документы[Строка.Вид].ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.Ид));
		Склад = Справочники.МестаХранения.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.Склад));
		Если ЗаписатьРеквизит(Ссылка, "МестоХранения", Склад, Отчет) Тогда
			Перенесено = Перенесено + 1;
		Иначе
			Пропущено = Пропущено + 1;
		КонецЕсли;
	КонецЦикла;
	ДобавитьИтогРаздела(Отчет, "КассовыеОрдера", Ордера.Количество(), Перенесено, Пропущено);
КонецПроцедуры

Процедура ПеренестиСкладыКасс(Кассы, Отчет)
	Перенесено = 0;
	Пропущено = 0;
	Для Каждого Строка Из Кассы Цикл
		Ссылка = Справочники.Кассы.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.Ид));
		Склад = Справочники.МестаХранения.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.Значение));
		Если ЗаписатьРеквизит(Ссылка, "МестоХранения", Склад, Отчет) Тогда
			Перенесено = Перенесено + 1;
		Иначе
			Пропущено = Пропущено + 1;
		КонецЕсли;
	КонецЦикла;
	ДобавитьИтогРаздела(Отчет, "Кассы", Кассы.Количество(), Перенесено, Пропущено);
КонецПроцедуры

Функция ЗаписатьРеквизит(Ссылка, Реквизит, Значение, Отчет)
	// Пустое или то же значение - запись загрузкой (без проверок и перепроведения); другое значение - остановка.
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Отчет.Добавить("ПРОПУСК;" + Реквизит + ";объекта нет в базе: " + Строка(Ссылка.УникальныйИдентификатор()));
		Возврат Ложь;
	КонецЕсли;
	Если Объект[Реквизит] = Значение Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект[Реквизит]) Тогда
		ВызватьИсключение СтрШаблон("ОСТАНОВ: у %1 реквизит %2 уже заполнен другим значением", Ссылка, Реквизит);
	КонецЕсли;
	Объект[Реквизит] = Значение;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Возврат Истина;
КонецФункции

Процедура ПеренестиУбытки(Наборы, Отчет)
	// Наборы кассовых ордеров - на месте, регистратор под защиту; наборы списаний - в одну корректировку регистров
	// (maERP убыток списания не пишет, перепроведение списания стёрло бы набор), наборы самих списаний очищаются.
	Перенесено = 0;
	Пропущено = 0;
	ЗаписиСписаний = Новый Массив;
	Списания = Новый Массив;
	Для Каждого Набор Из Наборы Цикл
		Если Метаданные.Документы.Найти(Набор.Вид) = Неопределено Тогда
			Отчет.Добавить("ПРОПУСК;Убытки;вида " + Набор.Вид + " нет в maERP");
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если ВидыРегистраторовУбытков().Найти(Набор.Вид) = Неопределено Тогда
			// Защита перенесённой истории поддерживает только эти виды: прочие - решение до переноса.
			ВызватьИсключение "ОСТАНОВ: регистратор Убытки вида " + Набор.Вид + " - защита переноса его не поддерживает";
		КонецЕсли;
		Регистратор = Документы[Набор.Вид].ПолучитьСсылку(Новый УникальныйИдентификатор(Набор.Ид));
		Если Регистратор.ПолучитьОбъект() = Неопределено Тогда
			Отчет.Добавить("ПРОПУСК;Убытки;регистратора нет в базе: " + Набор.Вид + " " + Набор.Ид);
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Набор.Вид = "СписаниеТоваров" Тогда
			Для Каждого Запись Из Набор.Записи Цикл
				ЗаписиСписаний.Добавить(Запись);
			КонецЦикла;
			Списания.Добавить(Регистратор);
		Иначе
			ЗаписатьНаборУбытков(Регистратор, Набор.Записи);
			ПеренесенныеДокументы.Защитить(Регистратор, "Убытки");
		КонецЕсли;
		Перенесено = Перенесено + 1;
	КонецЦикла;
	Если ЗаписиСписаний.Количество() > 0 Тогда
		ПеренестиУбыткиСписаний(ЗаписиСписаний, Списания, Отчет);
	КонецЕсли;
	ДобавитьИтогРаздела(Отчет, "Убытки", Наборы.Количество(), Перенесено, Пропущено);
КонецПроцедуры

Процедура ПеренестиУбыткиСписаний(ЗаписиСписаний, Списания, Отчет)
	// Корректировка создаётся раньше очистки наборов списаний и в той же транзакции: сбой не теряет записи.
	НачатьТранзакцию();
	Попытка
		Корректировка = КорректировкаУбытковСписаний(ЗаписиСписаний);
		Для Каждого Регистратор Из Списания Цикл
			ЗаписатьНаборУбытков(Регистратор, Новый Массив);
			ПеренесенныеДокументы.Защитить(Регистратор, ПеренесенныеДокументы.ОснованиеУбыткиСписания());
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Отчет.Добавить("КОРРЕКТИРОВКА;Убытки списаний;" + Строка(Корректировка) + ";записей " + ЗаписиСписаний.Количество());
КонецПроцедуры

Функция ВидыРегистраторовУбытков()
	Возврат СтрРазделить("ПриходныйКассовыйОрдер,РасходныйКассовыйОрдер,СписаниеТоваров", ",");
КонецФункции

Процедура ЗаписатьНаборУбытков(Регистратор, Записи)
	НаборЗаписей = РегистрыНакопления.Убытки.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	Для Каждого Данные Из Записи Цикл
		ЗаполнитьЗаписьУбытков(НаборЗаписей.Добавить(), Данные);
	КонецЦикла;
	НаборЗаписей.ОбменДанными.Загрузка = Истина;
	НаборЗаписей.Записать();
КонецПроцедуры

Процедура ЗаполнитьЗаписьУбытков(Запись, Данные)
	Запись.Период = XMLЗначение(Тип("Дата"), Данные.Период);
	Запись.Активность = ?(Данные.Свойство("Активность"), Данные.Активность, Истина);
	Запись.Организация = СсылкаПоИд(Справочники.Организации, Данные.Организация);
	Запись.СтатьяДДС = СсылкаПоИд(Справочники.СтатьиДвиженияДенежныхСредств, Данные.СтатьяДДС);
	Запись.МестоХранения = СсылкаПоИд(Справочники.МестаХранения, Данные.МестоХранения);
	Если Не ПустаяСтрока(Данные.Операция) Тогда
		Запись.ХозяйственнаяОперация = XMLЗначение(Тип("ПеречислениеСсылка.ХозяйственныеОперации"), Данные.Операция);
	КонецЕсли;
	Запись.Сумма = Данные.Сумма;
КонецПроцедуры

Функция КорректировкаУбытковСписаний(Записи)
	// Одна корректировка регистров на все записи списаний; повторный запуск находит её по комментарию.
	// Корректировка переноса - по записи защиты (не по комментарию, его может повторить пользователь).
	Комментарий = КомментарийКорректировки();
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 П.ПеренесенныйДокумент КАК Ссылка ИЗ РегистрСведений.ПеренесенныеДокументы КАК П
	|ГДЕ П.ПеренесенныйДокумент ССЫЛКА Документ.КорректировкаРегистров И П.Основание = &Основание
	|УПОРЯДОЧИТЬ ПО П.ДатаПереноса");
	Запрос.УстановитьПараметр("Основание", ПеренесенныеДокументы.ОснованиеКорректировкаПереноса());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Документ = Документы.КорректировкаРегистров.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Комментарий = Комментарий;
	Документ.ТаблицаРегистров.Добавить().Имя = "Убытки";
	Документ.Движения.Убытки.Записывать = Истина;
	Для Каждого Данные Из Записи Цикл
		ЗаполнитьЗаписьУбытков(Документ.Движения.Убытки.Добавить(), Данные);
	КонецЦикла;
	Документ.ОбменДанными.Загрузка = Истина;
	Документ.Записать();
	ПеренесенныеДокументы.Защитить(Документ.Ссылка, ПеренесенныеДокументы.ОснованиеКорректировкаПереноса());
	Возврат Документ.Ссылка;
КонецФункции

Процедура ПеренестиСтатусыПересчетов(Статусы, Отчет)
	Перенесено = 0;
	Пропущено = 0;
	Для Каждого Строка Из Статусы Цикл
		// BSLLS:YoLetterUsage-off - имя объекта метаданных.
		Ссылка = Документы.ПересчётТоваров.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.Ид));
		// BSLLS:YoLetterUsage-on
		Объект = Ссылка.ПолучитьОбъект();
		Значение = Перечисления.СтатусыДокументов[Строка.Статус];
		Если Объект = Неопределено Тогда
			Отчет.Добавить("ПРОПУСК;СтатусыПересчетов;документа нет в базе: " + Строка.Ид);
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Объект.Статус <> Значение Тогда
			Объект.Статус = Значение;
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
		КонецЕсли;
		Перенесено = Перенесено + 1;
	КонецЦикла;
	ДобавитьИтогРаздела(Отчет, "СтатусыПересчетов", Статусы.Количество(), Перенесено, Пропущено);
КонецПроцедуры

Процедура ПеренестиКонтрагентов(Контрагенты, Отчет)
	Перенесено = 0;
	Пропущено = 0;
	Для Каждого Строка Из Контрагенты Цикл
		Объект = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.Ид)).ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Отчет.Добавить("ПРОПУСК;Контрагенты;контрагента нет в базе: " + Строка.Ид);
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Объект.СрокОплаты = Строка.СрокОплаты;
		Если Не ПустаяСтрока(Строка.Способ) Тогда
			// BSLLS:YoLetterUsage-off - имена объектов метаданных.
			Объект.СпособРасчётаОтсрочки = XMLЗначение(Тип("ПеречислениеСсылка.СпособыРасчётаОтсрочки"), Строка.Способ);
			// BSLLS:YoLetterUsage-on
		КонецЕсли;
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
		Перенесено = Перенесено + 1;
	КонецЦикла;
	ДобавитьИтогРаздела(Отчет, "Контрагенты", Контрагенты.Количество(), Перенесено, Пропущено);
КонецПроцедуры

Процедура ПеренестиОбмен(Партнеры, Отчет)
	// Выключенные узлы обмена между базами: обмен со старой редакцией - расширением; логин и пароль - в учётные
	// данные узла, сервер и база - в наименование узла.
	Перенесено = 0;
	Пропущено = 0;
	Организация = ЕдинственнаяОрганизация();
	Для Каждого Строка Из Партнеры Цикл
		Контрагент = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.Ид));
		Если Контрагент.ПолучитьОбъект() = Неопределено Тогда
			Отчет.Добавить("ПРОПУСК;Обмен;контрагента нет в базе: " + Строка.Ид);
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Узел = УзелКонтрагента(Контрагент);
		Если Узел = Неопределено Тогда
			Узел = НовыйУзелПартнера(Контрагент, Организация, Строка);
		КонецЕсли;
		// BSLLS:PrivilegedModuleMethodCall-off - право администрирования проверено в Загрузить.
		ОбменМеждуБазамиПолныеПрава.УстановитьУчетныеДанные(Узел, Строка.Пользователь, Строка.Пароль);
		// BSLLS:PrivilegedModuleMethodCall-on
		Перенесено = Перенесено + 1;
	КонецЦикла;
	ДобавитьИтогРаздела(Отчет, "Обмен", Партнеры.Количество(), Перенесено, Пропущено);
КонецПроцедуры

Функция УзелКонтрагента(Контрагент)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ ПланОбмена.ОбменМеждуБазами КАК Т
	|ГДЕ Т.Контрагент = &Контрагент И НЕ Т.ПометкаУдаления");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

Функция НовыйУзелПартнера(Контрагент, Организация, Строка)
	Узел = ПланыОбмена.ОбменМеждуБазами.СоздатьУзел();
	// Код партнёра в обмене maERP задаётся при настройке; до неё - из идентификатора контрагента.
	Узел.Код = ВРег(Лев(СтрЗаменить(Строка.Ид, "-", ""), ДлинаКодаУзла()));
	Узел.Наименование = Лев(СтрШаблон("%1 (старая база: %2 %3)", Контрагент, Строка.Сервер, Строка.БазаДанных),
		ДлинаНаименованияУзла());
	Узел.Контрагент = Контрагент;
	Узел.Организация = Организация;
	Узел.ВыгружатьРеализации = Строка.ВыгрузкаПродажи И ЗначениеЗаполнено(Организация);
	Узел.ВыгружатьЦены = Строка.ВыгрузкаЦен;
	Узел.ДатаНачалаОбмена = НачалоДня(ТекущаяДатаСеанса());
	Узел.ВидТранспорта = Перечисления.ВидыТранспортаОбменаМеждуБазами.Каталог;
	Узел.ОбменВключен = Ложь;
	Узел.Записать();
	Возврат Узел.Ссылка;
КонецФункции

Функция ЕдинственнаяОрганизация()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Т.Ссылка КАК Ссылка ИЗ Справочник.Организации КАК Т ГДЕ НЕ Т.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО Т.Ссылка");
	Таблица = Запрос.Выполнить().Выгрузить();
	Возврат ?(Таблица.Количество() = 1, Таблица[0].Ссылка, Справочники.Организации.ПустаяСсылка());
КонецФункции

Процедура ПеренестиРоли(Пользователи, Отчет)
	// Роли старой ветки без объекта в maERP заменяются; пользователь без ролей - строка отчёта.
	Замены = Новый Соответствие;
	Замены.Вставить("РуководительПродаж", РолиРуководителяПродаж());
	Замены.Вставить("PDVПросмотрРеализаций", Новый Массив);
	Замены.Вставить("COM_ОсновнаяРоль", Новый Массив);
	Изменено = 0;
	Для Каждого Данные Из Пользователи Цикл
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Данные.Ид));
		Если ПользовательИБ = Неопределено Тогда
			Отчет.Добавить("ПРОПУСК;Роли;пользователя нет: " + Данные.Имя);
			Продолжить;
		КонецЕсли;
		Добавлено = ДобавитьРолиЗамены(ПользовательИБ, Данные.Роли, Замены, Отчет);
		Если Добавлено Тогда
			ПользовательИБ.Записать();
			Изменено = Изменено + 1;
		КонецЕсли;
		Если Не ЕстьРоли(ПользовательИБ) Тогда
			Отчет.Добавить("РАСХОЖДЕНИЕ;Роли;пользователь без ролей: " + ПользовательИБ.Имя);
		КонецЕсли;
	КонецЦикла;
	Отчет.Добавить("РАЗДЕЛ;Роли;пользователей " + Пользователи.Количество() + ";изменено " + Изменено);
КонецПроцедуры

Функция ЕстьРоли(ПользовательИБ)
	// У коллекции ролей пользователя ИБ нет метода Количество: первая итерация - признак непустой коллекции.
	// BSLLS:UseLessForEach-off
	// BSLLS:UnusedLocalVariable-off
	Для Каждого Роль Из ПользовательИБ.Роли Цикл
		Возврат Истина;
	КонецЦикла;
	// BSLLS:UnusedLocalVariable-on
	// BSLLS:UseLessForEach-on
	Возврат Ложь;
КонецФункции

Функция ДобавитьРолиЗамены(ПользовательИБ, РолиДо, Замены, Отчет)
	Добавлено = Ложь;
	Для Каждого ИмяРоли Из РолиДо Цикл
		НовыеРоли = Замены[ИмяРоли];
		Если НовыеРоли = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИмяНовой Из НовыеРоли Цикл
			Роль = Метаданные.Роли.Найти(ИмяНовой);
			Если Роль = Неопределено Или РольПишетДеньги(Роль) Тогда
				Отчет.Добавить("РАСХОЖДЕНИЕ;Роли;роль замены не назначена: " + ИмяНовой);
				Продолжить;
			КонецЕсли;
			Если Не ПользовательИБ.Роли.Содержит(Роль) Тогда
				ПользовательИБ.Роли.Добавить(Роль);
				Добавлено = Истина;
			КонецЕсли;
		КонецЦикла;
		Отчет.Добавить("РОЛЬ;" + ПользовательИБ.Имя + ";" + ИмяРоли + " -> " + СтрСоединить(НовыеРоли, ","));
	КонецЦикла;
	Возврат Добавлено;
КонецФункции

Функция ДенежныеДокументы()
	Результат = Новый Массив;
	Результат.Добавить(Метаданные.Документы.ПриходныйКассовыйОрдер);
	Результат.Добавить(Метаданные.Документы.РасходныйКассовыйОрдер);
	Результат.Добавить(Метаданные.Документы.ПоступлениеБезналичныхДенежныхСредств);
	Результат.Добавить(Метаданные.Документы.СписаниеБезналичныхДенежныхСредств);
	Возврат Результат;
КонецФункции

Процедура СверитьИтоги(ИтогиДо, Отчет)
	Расхождений = 0;
	Для Каждого КлючИЗапрос Из ЗапросыСверки() Цикл
		После = ИтогиПоКлючам(КлючИЗапрос.Значение);
		До = Новый Соответствие;
		Для Каждого Строка Из ИтогиДо[КлючИЗапрос.Ключ] Цикл
			До.Вставить(Строка.Ключ, Строка);
		КонецЦикла;
		Расхождений = Расхождений + СравнитьИтоги(КлючИЗапрос.Ключ, До, После, Отчет);
	КонецЦикла;
	Отчет.Добавить("СВЕРКА;расхождений " + Расхождений);
КонецПроцедуры

Функция ИтогиПоКлючам(ТекстЗапроса)
	Итоги = Новый Соответствие;
	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = КлючСверки(Выборка.К1) + "/" + КлючСверки(Выборка.К2) + "/" + КлючСверки(Выборка.К3) + "/"
			+ КлючСверки(Выборка.К4);
		Итог = Итоги[Ключ];
		Если Итог = Неопределено Тогда
			Итог = Новый Структура("Ключ, Сумма, Количество", Ключ, 0, 0);
			Итоги.Вставить(Ключ, Итог);
		КонецЕсли;
		Итог.Сумма = Итог.Сумма + Выборка.Сумма;
		Итог.Количество = Итог.Количество + Выборка.Количество;
	КонецЦикла;
	Возврат Итоги;
КонецФункции

Функция СравнитьИтоги(Раздел, До, После, Отчет)
	Расхождений = 0;
	Ключи = Новый Соответствие;
	Для Каждого КлючИЗначение Из До Цикл
		Ключи.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;
	Для Каждого КлючИЗначение Из После Цикл
		Ключи.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;
	Для Каждого КлючИЗначение Из Ключи Цикл
		Было = До[КлючИЗначение.Ключ];
		Стало = После[КлючИЗначение.Ключ];
		СуммаБыло = ?(Было = Неопределено, 0, Было.Сумма);
		СуммаСтало = ?(Стало = Неопределено, 0, Стало.Сумма);
		КоличествоБыло = ?(Было = Неопределено, 0, Было.Количество);
		КоличествоСтало = ?(Стало = Неопределено, 0, Стало.Количество);
		Если СуммаБыло <> СуммаСтало Или КоличествоБыло <> КоличествоСтало Тогда
			ТекстРасхождения = СтрШаблон("РАСХОЖДЕНИЕ;%1;%2;сумма %3 -> %4;количество %5 -> %6", Раздел,
				КлючИЗначение.Ключ, СуммаБыло, СуммаСтало, КоличествоБыло, КоличествоСтало);
			Отчет.Добавить(ТекстРасхождения);
			Расхождений = Расхождений + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождений;
КонецФункции

Функция КлючСверки(Значение)
	Если Значение = Неопределено Или Значение = NULL Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат XMLСтрока(Значение);
КонецФункции

Функция СсылкаПоИд(Менеджер, Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
КонецФункции

Процедура ДобавитьИтогРаздела(Отчет, Раздел, Всего, Перенесено, Пропущено)
	Отчет.Добавить(СтрШаблон("РАЗДЕЛ;%1;всего %2;перенесено %3;пропущено %4", Раздел, Всего, Перенесено, Пропущено));
КонецПроцедуры

Функция ДлинаКодаУзла()
	Возврат 9;
КонецФункции

Функция ДлинаНаименованияУзла()
	Возврат 100;
КонецФункции

