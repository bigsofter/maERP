// Загрузка строк табличной части документа из файла (docs/plans/excel-import-universal.md). Режимы:
//  - формы документа (параметры ИмяДокумента, ИмяТЧ, СоздаватьТовары, ВидЦены): форма закрывается со структурой
//    загрузки, табличную часть заполняет форма документа через ЗагрузкаИзФайла.ЗаполнитьТЧ;
//  - записанного документа (параметр Документ, общая команда или выбор документа в форме): строки загружаются
//    в документ на сервере (ЗагрузкаИзФайла.ЗагрузитьВДокумент), форма-владелец перечитывается.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ИмяДокумента") И ЗначениеЗаполнено(Параметры.ИмяДокумента) Тогда
		ПрименитьПараметрыФормыДокумента();
	ИначеЕсли Параметры.Свойство("Документ") И ЗначениеЗаполнено(Параметры.Документ) Тогда
		Документ = Параметры.Документ;
		ИмяДокумента = Документ.Метаданные().Имя;
	Иначе
		ИмяДокумента = "";
	КонецЕсли;
	СтрокаЗаголовка = 1;
	ПерваяСтрокаДанных = СтрокаЗаголовка + 1;
	ПрименитьПорядокПоиска(ЗагрузкаИзФайла.ПорядокПоискаПоУмолчанию());
	Элементы.Документ.Видимость = Не РежимФормы;
	Элементы.ИмяТЧ.ТолькоПросмотр = РежимФормы; // табличную часть заполняет форма документа - та, что передала
	Элементы.Документ.ТолькоПросмотр = Параметры.Свойство("Документ") И ЗначениеЗаполнено(Параметры.Документ);
	МожноСоздавать = ПравоДоступа("Добавление", Метаданные.Справочники.Номенклатура);
	Элементы.СоздаватьТовары.Видимость = МожноСоздавать;
	Элементы.ГруппаНовыхТоваров.Видимость = МожноСоздавать;
	СоздаватьТовары = СоздаватьТовары И МожноСоздавать;
	ЗаполнитьСписокТЧ();
	ПерестроитьСопоставление();
	ЗаполнитьСписокНастроек();
	ОбновитьДоступность();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументПриИзменении(Элемент)
	ДокументПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ИмяТЧПриИзменении(Элемент)
	ПерестроитьСопоставлениеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Заголовок = НСтр("ru = 'Выберите файл'; fr = 'Choisissez un fichier'; en = 'Choose a file'; es = 'Elija un archivo'");
	Фильтр = "Excel, CSV (*.xlsx;*.xls;*.ods;*.csv;*.txt)|*.xlsx;*.xls;*.ods;*.csv;*.txt";
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов(Заголовок, Ложь, Фильтр);
	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(Оповещение, , , ПараметрыДиалога, , УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура СтрокаЗаголовкаПриИзменении(Элемент)
	Если ПерваяСтрокаДанных <= СтрокаЗаголовка Тогда
		ПерваяСтрокаДанных = СтрокаЗаголовка + 1;
	КонецЕсли;
	ОбновитьЗаголовкиНаСервере(Истина);
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)
	ПрименитьНастройкуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздаватьТоварыПриИзменении(Элемент)
	ПерестроитьСопоставлениеНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСопоставление

&НаКлиенте
Процедура СопоставлениеНомерКолонкиПриИзменении(Элемент)
	Строка = Элементы.Сопоставление.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЭлементСписка = Элементы.СопоставлениеНомерКолонки.СписокВыбора.НайтиПоЗначению(Строка.НомерКолонки);
	Строка.ЗаголовокКолонки = "";
	Если ЭлементСписка <> Неопределено И Строка.НомерКолонки <> 0 Тогда
		Строка.ЗаголовокКолонки = ЧистыйЗаголовок(ЭлементСписка.Представление);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проверить(Команда)
	ПроверитьНаСервере();
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаПроверка;
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	Если РежимФормы Тогда
		Загрузка = ЗагрузкаДляФормыНаСервере();
		Если Загрузка <> Неопределено Тогда
			Закрыть(Загрузка);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выберите документ'; fr = 'Choisissez le document';
			|en = 'Choose the document'; es = 'Elija el documento'"), , "Документ");
		Возврат;
	КонецЕсли;
	Если ЗагрузитьВДокументНаСервере() Тогда
		ОповеститьОбИзменении(Документ);
		ПеречитатьФормуВладельца();
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройку(Команда)
	СохранитьНастройкуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры открытия из формы документа: приёмник, создание товаров, вид цены формы; строки заменяются (прежнее
// поведение кнопки документа).
//
&НаСервере
Процедура ПрименитьПараметрыФормыДокумента()
	РежимФормы = Истина;
	ИмяДокумента = Параметры.ИмяДокумента;
	ИмяТЧ = "ТЧТовары";
	Если Параметры.Свойство("ИмяТЧ") Тогда
		ИмяТЧ = Параметры.ИмяТЧ;
	КонецЕсли;
	СоздаватьТовары = Параметры.Свойство("СоздаватьТовары") И Параметры.СоздаватьТовары = Истина;
	Если Параметры.Свойство("ВидЦены") Тогда
		ВидЦеныФормы = Параметры.ВидЦены;
	КонецЕсли;
	ДокументПроведен = Параметры.Свойство("Проведен") И Параметры.Проведен = Истина;
	Заменить = Истина;
КонецПроцедуры

// Форма-владелец (форма объекта записанного документа) перечитывается после загрузки, если в ней нет несохранённых
// изменений; у формы списка реквизита Объект нет - она обновится по оповещению об изменении.
//
&НаКлиенте
Процедура ПеречитатьФормуВладельца()
	Если ВладелецФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ЭтоФормаОбъекта = ВладелецФормы.Объект <> Неопределено;
	Исключение
		// у формы списка нет реквизита Объект
		ЭтоФормаОбъекта = Ложь;
	КонецПопытки;
	Если Не ЭтоФормаОбъекта Тогда
		Возврат;
	КонецЕсли;
	Если ВладелецФормы.Модифицированность Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'Документ загружен, но в форме есть несохранённые изменения: закройте её без записи и откройте снова';
			|fr = 'Document chargé, mais le formulaire a des modifications non enregistrées : fermez-le sans enregistrer';
			|en = 'Document imported, but the form has unsaved changes: close it without saving and reopen it';
			|es = 'Documento cargado, pero el formulario tiene cambios sin guardar: ciérrelo sin guardar y ábralo'"));
		Возврат;
	КонецЕсли;
	ВладелецФормы.Прочитать();
КонецПроцедуры

// Завершение выбора файла: файл читается на сервере, колонки сопоставляются по заголовкам.
//
// Параметры:
//  ОписаниеФайла           - ОписаниеПомещенногоФайла, Неопределено - помещённый файл.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ПослеПомещенияФайла(ОписаниеФайла, ДополнительныеПараметры) Экспорт
	Если ОписаниеФайла = Неопределено Или ОписаниеФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;
	ПутьКФайлу = ОписаниеФайла.СсылкаНаФайл.Имя;
	ПрочитатьФайлНаСервере(ОписаниеФайла.Адрес, ОписаниеФайла.СсылкаНаФайл.Расширение);
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСопоставление;
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлНаСервере(Знач Адрес, Знач Расширение)
	Попытка
		ТабДок = ЗагрузкаИзФайла.ПрочитатьФайл(ПолучитьИзВременногоХранилища(Адрес), Расширение);
	Исключение
		ТабДок = Новый ТабличныйДокумент;
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	УдалитьИзВременногоХранилища(Адрес);
	ОбновитьЗаголовкиНаСервере(Истина);
КонецПроцедуры

&НаСервере
Процедура ДокументПриИзмененииНаСервере()
	ИмяДокумента = "";
	Если ЗначениеЗаполнено(Документ) Тогда
		ИмяДокумента = Документ.Метаданные().Имя;
	КонецЕсли;
	ЗаполнитьСписокТЧ();
	ПерестроитьСопоставление();
	ЗаполнитьСписокНастроек();
	ОбновитьДоступность();
КонецПроцедуры

&НаСервере
Процедура ПерестроитьСопоставлениеНаСервере()
	ПерестроитьСопоставление();
	ЗаполнитьСписокНастроек();
	ОбновитьДоступность();
КонецПроцедуры

// Список допустимых табличных частей документа; текущая - ТЧТовары, если допустима, иначе первая допустимая.
//
&НаСервере
Процедура ЗаполнитьСписокТЧ()
	Список = Элементы.ИмяТЧ.СписокВыбора;
	Список.Очистить();
	Если ПустаяСтрока(ИмяДокумента) Тогда
		ИмяТЧ = "";
		Возврат;
	КонецЕсли;
	МД = Метаданные.Документы[ИмяДокумента];
	Для Каждого Имя Из ЗагрузкаИзФайла.ПриемникиДокумента(ИмяДокумента) Цикл
		Список.Добавить(Имя, МД.ТабличныеЧасти[Имя].Представление());
	КонецЦикла;
	Если Список.НайтиПоЗначению(ИмяТЧ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяТЧ = "";
	Если Список.НайтиПоЗначению("ТЧТовары") <> Неопределено Тогда
		ИмяТЧ = "ТЧТовары";
	ИначеЕсли Список.Количество() > 0 Тогда
		ИмяТЧ = Список[0].Значение;
	Иначе
		ИмяТЧ = ""; // в документе нет допустимых табличных частей
	КонецЕсли;
КонецПроцедуры

// Строки сопоставления: колонки приёмника и, при создании товаров, поля нового товара. Номера колонок, уже выбранные
// для тех же реквизитов, сохраняются.
//
&НаСервере
Процедура ПерестроитьСопоставление()
	Прежние = Новый Соответствие;
	Для Каждого Строка Из Сопоставление Цикл
		Прежние.Вставить(Строка.Реквизит, Строка.НомерКолонки);
	КонецЦикла;
	Сопоставление.Очистить();
	Если ПустаяСтрока(ИмяДокумента) Или ПустаяСтрока(ИмяТЧ) Тогда
		Возврат;
	КонецЕсли;
	Описание = ЗагрузкаИзФайла.ОписаниеПриемника(ИмяДокумента, ИмяТЧ);
	Для Каждого Колонка Из Описание.Колонки Цикл
		Строка = Сопоставление.Добавить();
		Строка.Реквизит = Колонка.Имя;
		Строка.Представление = Колонка.Представление;
	КонецЦикла;
	Если СоздаватьТовары Тогда
		Для Каждого Поле Из ПоляНовогоТовара() Цикл
			Строка = Сопоставление.Добавить();
			Строка.Реквизит = ПрефиксСоздания() + Поле.Ключ;
			Строка.Представление = Поле.Значение;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Строка Из Сопоставление Цикл
		Номер = Прежние[Строка.Реквизит];
		Строка.НомерКолонки = ?(Номер = Неопределено, 0, Номер);
	КонецЦикла;
	ОбновитьЗаголовкиНаСервере(Истина);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрефиксСоздания()
	Возврат "Создание_";
КонецФункции

// Поля нового товара для сопоставления с колонками файла.
//
// Возвращаемое значение:
//  Структура - имя поля -> представление.
//
&НаСервере
Функция ПоляНовогоТовара()
	Шаблон = НСтр("ru = 'Новый товар: %1'; fr = 'Nouvel article : %1'; en = 'New item: %1'; es = 'Artículo nuevo: %1'");
	Названия = Новый Структура;
	Названия.Вставить("Наименование", НСтр("ru = 'наименование'; fr = 'désignation'; en = 'name'; es = 'nombre'"));
	Названия.Вставить("Артикул", НСтр("ru = 'артикул'; fr = 'référence'; en = 'article'; es = 'referencia'"));
	Названия.Вставить("Штрихкод", НСтр("ru = 'штрихкод'; fr = 'code-barres'; en = 'barcode'; es = 'código de barras'"));
	Названия.Вставить("КодПоставщика", НСтр("ru = 'код поставщика'; fr = 'code fournisseur'; en = 'supplier code';
		|es = 'código de proveedor'"));
	Названия.Вставить("Группа", НСтр("ru = 'группа'; fr = 'groupe'; en = 'group'; es = 'grupo'"));
	Названия.Вставить("Бренд", НСтр("ru = 'бренд'; fr = 'marque'; en = 'brand'; es = 'marca'"));
	Поля = Новый Структура;
	Для Каждого КлючИЗначение Из Названия Цикл
		Поля.Вставить(КлючИЗначение.Ключ, СтрШаблон(Шаблон, КлючИЗначение.Значение));
	КонецЦикла;
	Возврат Поля;
КонецФункции

// Список выбора колонок файла по строке заголовка; при Автосопоставить - несопоставленные реквизиты
// сопоставляются по заголовкам.
//
// Параметры:
//  Автосопоставить - Булево - сопоставить свободные реквизиты по заголовкам.
//
&НаСервере
Процедура ОбновитьЗаголовкиНаСервере(Знач Автосопоставить)
	Заголовки = ЗагрузкаИзФайла.ЗаголовкиКолонок(ТабДок, СтрокаЗаголовка);
	Список = Элементы.СопоставлениеНомерКолонки.СписокВыбора;
	Список.Очистить();
	Список.Добавить(0, НСтр("ru = '<не загружать>'; fr = '<ne pas charger>'; en = '<do not import>'; es = '<no cargar>'"));
	Для Каждого Заголовок Из Заголовки Цикл
		Список.Добавить(Заголовок.Номер, СтрШаблон("%1: %2", Заголовок.Номер, Заголовок.Заголовок));
	КонецЦикла;
	Если Автосопоставить И СтрокаЗаголовка > 0 Тогда
		СопоставитьСвободные(Заголовки);
	КонецЕсли;
	Для Каждого Строка Из Сопоставление Цикл
		ЭлементСписка = Список.НайтиПоЗначению(Строка.НомерКолонки);
		Если ЭлементСписка = Неопределено Или Строка.НомерКолонки = 0 Тогда
			Строка.НомерКолонки = 0;
			Строка.ЗаголовокКолонки = "";
		Иначе
			Строка.ЗаголовокКолонки = ЧистыйЗаголовок(ЭлементСписка.Представление);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Заголовок колонки файла без номера из представления списка выбора («3: Цена» -> «Цена»); текст без номера
// возвращается как есть (настройки, сохранённые с номером).
//
// Параметры:
//  Представление - Строка - представление колонки.
//
// Возвращаемое значение:
//  Строка - заголовок.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЧистыйЗаголовок(Представление)
	Позиция = СтрНайти(Представление, ": ");
	Если Позиция <= 1 Тогда
		Возврат Представление;
	КонецЕсли;
	Для Номер = 1 По Позиция - 1 Цикл
		Если СтрНайти("0123456789", Сред(Представление, Номер, 1)) = 0 Тогда
			Возврат Представление;
		КонецЕсли;
	КонецЦикла;
	Возврат Сред(Представление, Позиция + СтрДлина(": "));
КонецФункции

// Сопоставляет по заголовкам реквизиты без колонки с колонками, ещё не занятыми другими реквизитами.
//
// Параметры:
//  Заголовки - Массив из Структура - см. ЗагрузкаИзФайла.ЗаголовкиКолонок.
//
&НаСервере
Процедура СопоставитьСвободные(Заголовки)
	Колонки = Новый Массив;
	Занятые = Новый Соответствие;
	Для Каждого Строка Из Сопоставление Цикл
		Если Строка.НомерКолонки = 0 Тогда
			Колонки.Добавить(Новый Структура("Имя, Представление", Строка.Реквизит, Строка.Представление));
		Иначе
			Занятые.Вставить(Строка.НомерКолонки, Истина);
		КонецЕсли;
	КонецЦикла;
	Свободные = Новый Массив;
	Для Каждого Заголовок Из Заголовки Цикл
		Если Занятые[Заголовок.Номер] = Неопределено Тогда
			Свободные.Добавить(Заголовок);
		КонецЕсли;
	КонецЦикла;
	Найденные = ЗагрузкаИзФайла.АвтоСопоставление(Колонки, Свободные);
	Для Каждого Строка Из Сопоставление Цикл
		Номер = Найденные[Строка.Реквизит];
		Если Номер <> Неопределено Тогда
			Строка.НомерКолонки = Номер;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступность()
	ЕстьПриемник = Не ПустаяСтрока(ИмяДокумента) И Не ПустаяСтрока(ИмяТЧ);
	Элементы.ФормаЗагрузить.Доступность = ЕстьПриемник;
	Элементы.ФормаПроверить.Доступность = ЕстьПриемник;
	Элементы.СохранитьНастройку.Доступность = ЕстьПриемник;
КонецПроцедуры

&НаСервере
Функция Приемник()
	Возврат ИмяДокумента + "." + ИмяТЧ;
КонецФункции

// Правила поиска товара по флажкам формы, в порядке по умолчанию.
//
// Возвращаемое значение:
//  Массив из Строка - правила.
//
&НаСервере
Функция ПорядокПоиска()
	Флажки = Новый Структура("Штрихкод, Артикул, КодПоставщика", ПоискШтрихкод, ПоискАртикул, ПоискКодПоставщика);
	Флажки.Вставить("Код", ПоискКод);
	Флажки.Вставить("Наименование", ПоискНаименование);
	Порядок = Новый Массив;
	Для Каждого Правило Из ЗагрузкаИзФайла.ПорядокПоискаПоУмолчанию() Цикл
		Если Флажки[Правило] Тогда
			Порядок.Добавить(Правило);
		КонецЕсли;
	КонецЦикла;
	Возврат Порядок;
КонецФункции

// Флажки правил поиска товара по списку правил.
//
// Параметры:
//  Порядок - Массив из Строка - правила.
//
&НаСервере
Процедура ПрименитьПорядокПоиска(Порядок)
	ПоискШтрихкод = Порядок.Найти("Штрихкод") <> Неопределено;
	ПоискАртикул = Порядок.Найти("Артикул") <> Неопределено;
	ПоискКодПоставщика = Порядок.Найти("КодПоставщика") <> Неопределено;
	ПоискКод = Порядок.Найти("Код") <> Неопределено;
	ПоискНаименование = Порядок.Найти("Наименование") <> Неопределено;
КонецПроцедуры

// Параметры преобразования строк файла по реквизитам формы.
//
// Параметры:
//  Создавать - Булево - создавать товары (Ложь - только проверка).
//
// Возвращаемое значение:
//  Структура - см. ЗагрузкаИзФайла.НовыеПараметрыПреобразования.
//
&НаСервере
Функция ПараметрыПреобразования(Создавать)
	ПараметрыЗагрузки = ЗагрузкаИзФайла.НовыеПараметрыПреобразования();
	ПараметрыЗагрузки.ИмяДокумента = ИмяДокумента;
	ПараметрыЗагрузки.ИмяТЧ = ИмяТЧ;
	ПараметрыЗагрузки.ПерваяСтрока = ПерваяСтрокаДанных;
	ПараметрыЗагрузки.ПорядокПоиска = ПорядокПоиска();
	ПараметрыЗагрузки.СоздаватьТовары = СоздаватьТовары;
	ПараметрыЗагрузки.ГруппаНовыхТоваров = ГруппаНовыхТоваров;
	ПараметрыЗагрузки.Создавать = Создавать;
	Префикс = ПрефиксСоздания();
	Для Каждого Строка Из Сопоставление Цикл
		Если Строка.НомерКолонки = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Строка.Реквизит, Префикс) Тогда
			Поле = Сред(Строка.Реквизит, СтрДлина(Префикс) + 1);
			ПараметрыЗагрузки.ПоляСоздания.Вставить(Поле, Строка.НомерКолонки);
		Иначе
			ПараметрыЗагрузки.Колонки.Вставить(Строка.Реквизит, Строка.НомерКолонки);
		КонецЕсли;
	КонецЦикла;
	Возврат ПараметрыЗагрузки;
КонецФункции

// Преобразованные строки файла; ошибка параметров - сообщение и Неопределено.
//
// Параметры:
//  Создавать - Булево - создавать товары (Ложь - только проверка).
//
// Возвращаемое значение:
//  Структура, Неопределено - см. ЗагрузкаИзФайла.ПреобразоватьСтроки.
//
&НаСервере
Функция ПреобразованныеСтроки(Создавать)
	Если ТабДок.ВысотаТаблицы = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выберите файл'; fr = 'Choisissez un fichier';
			|en = 'Choose a file'; es = 'Elija un archivo'"), , "ПутьКФайлу");
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Результат = ЗагрузкаИзФайла.ПреобразоватьСтроки(ТабДок, ПараметрыПреобразования(Создавать));
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Предпросмотр: загружаемые значения строк и ошибки строк, счётчик «к загрузке / с ошибками».
//
&НаСервере
Процедура ПроверитьНаСервере()
	Предпросмотр = Новый ТабличныйДокумент;
	Итог = "";
	Результат = ПреобразованныеСтроки(Ложь);
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВывестиПредпросмотр(Результат);
	Шаблон = НСтр("ru = 'Строк в файле: %1, к загрузке: %2, с ошибками: %3, новых товаров: %4';
		|fr = 'Lignes du fichier : %1, à charger : %2, en erreur : %3, nouveaux articles : %4';
		|en = 'File rows: %1, to import: %2, with errors: %3, new items: %4';
		|es = 'Filas del archivo: %1, a cargar: %2, con errores: %3, artículos nuevos: %4'");
	Итог = СтрШаблон(Шаблон, Результат.ВсегоСтрок, Результат.Строки.Количество(), Результат.Ошибки.Количество(),
		Результат.Создается.Количество());
КонецПроцедуры

// Табличный документ предпросмотра: шапка, первые строки к загрузке, затем строки с ошибками (красным).
//
// Параметры:
//  Результат - Структура - см. ЗагрузкаИзФайла.ПреобразоватьСтроки.
//
&НаСервере
Процедура ВывестиПредпросмотр(Результат)
	Максимум = 1000;
	ПерваяКолонкаЗначений = 2;
	Колонки = Новый Массив;
	Для Каждого Строка Из Сопоставление Цикл
		Если Строка.НомерКолонки <> 0 И Не СтрНачинаетсяС(Строка.Реквизит, ПрефиксСоздания()) Тогда
			Колонки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	КолонкаОшибки = Колонки.Количество() + ПерваяКолонкаЗначений;
	Предпросмотр.Область(1, 1).Текст = НСтр("ru = 'Строка'; fr = 'Ligne'; en = 'Row'; es = 'Fila'");
	Для Индекс = 0 По Колонки.Количество() - 1 Цикл
		Предпросмотр.Область(1, Индекс + ПерваяКолонкаЗначений).Текст = Колонки[Индекс].Представление;
	КонецЦикла;
	Предпросмотр.Область(1, КолонкаОшибки).Текст = НСтр("ru = 'Ошибка'; fr = 'Erreur'; en = 'Error'; es = 'Error'");
	Предпросмотр.Область(1, 1, 1, КолонкаОшибки).Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
	НомерВывода = 1;
	Для Индекс = 0 По Мин(Результат.Строки.Количество(), Максимум) - 1 Цикл
		НомерВывода = НомерВывода + 1;
		Значения = Результат.Строки[Индекс];
		Предпросмотр.Область(НомерВывода, 1).Текст = Формат(Результат.НомераСтрок[Индекс], "ЧГ=0");
		Для НомерКолонки = 0 По Колонки.Количество() - 1 Цикл
			Значение = Неопределено;
			Значения.Свойство(Колонки[НомерКолонки].Реквизит, Значение);
			Предпросмотр.Область(НомерВывода, НомерКолонки + ПерваяКолонкаЗначений).Текст = Строка(Значение);
		КонецЦикла;
	КонецЦикла;
	Для Индекс = 0 По Мин(Результат.Ошибки.Количество(), Максимум) - 1 Цикл
		НомерВывода = НомерВывода + 1;
		Ошибка = Результат.Ошибки[Индекс];
		Предпросмотр.Область(НомерВывода, 1).Текст = Формат(Ошибка.НомерСтроки, "ЧГ=0");
		Предпросмотр.Область(НомерВывода, КолонкаОшибки).Текст = Ошибка.Текст;
		Предпросмотр.Область(НомерВывода, 1, НомерВывода, КолонкаОшибки).ЦветТекста = ЦветаСтиля.Цвет_Красный;
	КонецЦикла;
КонецПроцедуры

// Загрузка для формы документа: товары создаются, строки с ошибками пропускаются с сообщением.
//
// Возвращаемое значение:
//  Структура, Неопределено - см. ЗагрузкаИзФайла.ЗаполнитьТЧ, параметр Загрузка.
//
&НаСервере
Функция ЗагрузкаДляФормыНаСервере()
	Если ДокументПроведен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'Документ проведён: отмените проведение - загрузка в проведённый документ запрещена';
			|fr = 'Le document est validé : annulez la validation - chargement interdit dans un document validé';
			|en = 'The document is posted: unpost it - importing into a posted document is not allowed';
			|es = 'El documento está contabilizado: anule la contabilización - no se carga en documentos contabilizados'"));
		Возврат Неопределено;
	КонецЕсли;
	Загрузка = ПодготовитьЗагрузку();
	Если Загрузка <> Неопределено И ЗначениеЗаполнено(ВидЦеныФормы) Тогда
		Загрузка.Вставить("ВидЦены", ВидЦеныФормы);
	КонецЕсли;
	Возврат Загрузка;
КонецФункции

// Загрузка в записанный документ.
//
// Возвращаемое значение:
//  Булево - Истина: загружено.
//
&НаСервере
Функция ЗагрузитьВДокументНаСервере()
	ТекстОшибки = ЗагрузкаИзФайла.ОшибкаЗагрузкиВДокумент(Документ, ИмяТЧ, Заменить);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	Загрузка = ПодготовитьЗагрузку();
	Если Загрузка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстОшибки = ЗагрузкаИзФайла.ЗагрузитьВДокумент(Документ, ИмяТЧ, Загрузка);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Структура загрузки (см. ЗагрузкаИзФайла.ЗаполнитьТЧ) с созданием новых товаров; ошибки строк - сообщениями.
//
// Возвращаемое значение:
//  Структура, Неопределено - Строки, Сопоставлено, Заменить; Неопределено - загружать нечего.
//
&НаСервере
Функция ПодготовитьЗагрузку()
	Результат = ПреобразованныеСтроки(Истина);
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Шаблон = НСтр("ru = 'Строка %1 файла не загружена: %2'; fr = 'Ligne %1 du fichier non chargée : %2';
		|en = 'File row %1 not imported: %2'; es = 'Fila %1 del archivo no cargada: %2'");
	Для Каждого Ошибка Из Результат.Ошибки Цикл
		ТекстОшибки = СтрШаблон(Шаблон, Формат(Ошибка.НомерСтроки, "ЧГ=0"), Ошибка.Текст);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЦикла;
	Если Результат.Строки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Нечего загружать: в файле нет пригодных строк';
			|fr = 'Rien à charger : aucune ligne valide'; en = 'Nothing to import: no valid rows';
			|es = 'Nada que cargar: no hay filas válidas'"));
		Возврат Неопределено;
	КонецЕсли;
	ЗапомнитьНастройку();
	Загрузка = Новый Структура("Строки, Сопоставлено, Заменить", Результат.Строки, Результат.Сопоставлено, Заменить);
	Возврат Загрузка;
КонецФункции

// Быстрый выбор настройки: последние настройки приёмника этого пользователя.
//
&НаСервере
Процедура ЗаполнитьСписокНастроек()
	Список = Элементы.Настройка.СписокВыбора;
	Список.Очистить();
	Для Каждого Ссылка Из ПоследниеНастройки() Цикл
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Список.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Последние настройки приёмника пользователя (хранилище общих настроек).
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.НастройкиЗагрузкиИзФайла - от последней.
//
&НаСервере
Функция ПоследниеНастройки()
	Последние = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ЗагрузкаИзФайла", Приемник(), Новый Массив);
	Если ТипЗнч(Последние) <> Тип("Массив") Тогда
		Последние = Новый Массив;
	КонецЕсли;
	Возврат Последние;
КонецФункции

// Текущая настройка - первой в списке последних (не больше пяти).
//
&НаСервере
Процедура ЗапомнитьНастройку()
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат;
	КонецЕсли;
	Последних = 5;
	Последние = ПоследниеНастройки();
	Позиция = Последние.Найти(Настройка);
	Если Позиция <> Неопределено Тогда
		Последние.Удалить(Позиция);
	КонецЕсли;
	Последние.Вставить(0, Настройка);
	Пока Последние.Количество() > Последних Цикл
		Последние.Удалить(Последних);
	КонецЦикла;
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ЗагрузкаИзФайла", Приемник(), Последние);
	ЗаполнитьСписокНастроек();
КонецПроцедуры

// Колонки настройки применяются по реквизиту: если заголовок колонки из настройки найден в файле - по нему, иначе по
// номеру колонки.
//
&НаСервере
Процедура ПрименитьНастройкуНаСервере()
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат;
	КонецЕсли;
	Реквизиты = "Наименование, Приемник, СтрокаЗаголовка, ПерваяСтрокаДанных, ПорядокПоиска, Общая, Колонки";
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка, Реквизиты);
	Если Данные.Приемник <> Приемник() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Настройка сохранена для другого документа';
			|fr = 'Le paramètre a été enregistré pour un autre document'; en = 'The setting was saved for another document';
			|es = 'El ajuste se guardó para otro documento'"), , "Настройка");
		Настройка = Неопределено;
		Возврат;
	КонецЕсли;
	НаименованиеНастройки = Данные.Наименование;
	НастройкаОбщая = Данные.Общая;
	СтрокаЗаголовка = Данные.СтрокаЗаголовка;
	ПерваяСтрокаДанных = Данные.ПерваяСтрокаДанных;
	ПрименитьПорядокПоиска(СтрРазделить(Данные.ПорядокПоиска, ",", Ложь));
	ПрименитьКолонкиНастройки(Данные.Колонки.Выгрузить());
	ОбновитьЗаголовкиНаСервере(Ложь);
	ЗапомнитьНастройку();
КонецПроцедуры

// Номера колонок по настройке: по заголовку, если он есть в файле, иначе по сохранённому номеру.
//
// Параметры:
//  Колонки - ТаблицаЗначений - Реквизит, НомерКолонки, ЗаголовокКолонки.
//
&НаСервере
Процедура ПрименитьКолонкиНастройки(Колонки)
	Заголовки = ЗагрузкаИзФайла.ЗаголовкиКолонок(ТабДок, СтрокаЗаголовка);
	Для Каждого Строка Из Сопоставление Цикл
		СтрокаНастройки = Колонки.Найти(Строка.Реквизит, "Реквизит");
		Строка.НомерКолонки = 0;
		Если СтрокаНастройки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строка.НомерКолонки = НомерПоЗаголовку(Заголовки, СтрокаНастройки.ЗаголовокКолонки);
		Если Строка.НомерКолонки = 0 Тогда
			// настройки, сохранённые с номером колонки в заголовке («3: Цена»)
			Строка.НомерКолонки = НомерПоЗаголовку(Заголовки, ЧистыйЗаголовок(СтрокаНастройки.ЗаголовокКолонки));
		КонецЕсли;
		Если Строка.НомерКолонки = 0 Тогда
			Строка.НомерКолонки = СтрокаНастройки.НомерКолонки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Номер колонки файла по точному (без учёта регистра) совпадению заголовка.
//
// Параметры:
//  Заголовки - Массив из Структура - см. ЗагрузкаИзФайла.ЗаголовкиКолонок.
//  Заголовок - Строка - искомый заголовок.
//
// Возвращаемое значение:
//  Число - номер колонки; 0 - не найден.
//
&НаСервереБезКонтекста
Функция НомерПоЗаголовку(Заголовки, Заголовок)
	Для Каждого Колонка Из Заголовки Цикл
		Если НРег(Колонка.Заголовок) = НРег(Заголовок) Тогда
			Возврат Колонка.Номер;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

// Сохранение: своя выбранная настройка перезаписывается, иначе создаётся новая (автор - текущий пользователь).
//
&НаСервере
Процедура СохранитьНастройкуНаСервере()
	ЭтоСвоя = ЗначениеЗаполнено(Настройка)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Настройка, "Автор") = ПараметрыСеанса.Пользователь;
	Если ЭтоСвоя Тогда
		НастройкаОбъект = Настройка.ПолучитьОбъект();
	Иначе
		НастройкаОбъект = Справочники.НастройкиЗагрузкиИзФайла.СоздатьЭлемент();
	КонецЕсли;
	Наименование = НаименованиеНастройки;
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = СтрШаблон("%1 (%2)", Метаданные.Документы[ИмяДокумента].Представление(),
			Формат(ТекущаяДатаСеанса(), "ДЛФ=D"));
	КонецЕсли;
	НастройкаОбъект.Наименование = Наименование;
	НастройкаОбъект.Приемник = Приемник();
	НастройкаОбъект.СтрокаЗаголовка = СтрокаЗаголовка;
	НастройкаОбъект.ПерваяСтрокаДанных = ПерваяСтрокаДанных;
	НастройкаОбъект.ПорядокПоиска = СтрСоединить(ПорядокПоиска(), ",");
	НастройкаОбъект.Общая = НастройкаОбщая;
	НастройкаОбъект.Колонки.Очистить();
	Для Каждого Строка Из Сопоставление Цикл
		Если Строка.НомерКолонки <> 0 Тогда
			ЗаполнитьЗначенияСвойств(НастройкаОбъект.Колонки.Добавить(), Строка, "Реквизит, НомерКолонки, ЗаголовокКолонки");
		КонецЕсли;
	КонецЦикла;
	НастройкаОбъект.Записать();
	Настройка = НастройкаОбъект.Ссылка;
	НаименованиеНастройки = НастройкаОбъект.Наименование;
	ЗапомнитьНастройку();
КонецПроцедуры

#КонецОбласти
