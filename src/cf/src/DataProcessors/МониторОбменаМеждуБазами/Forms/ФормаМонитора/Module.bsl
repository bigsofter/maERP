#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУзлы

&НаКлиенте
Процедура УзлыПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.Узлы.ТекущиеДанные;
	НовыйУзел = ?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.Узел);
	Если НовыйУзел <> ТекущийУзел Тогда
		ТекущийУзел = НовыйУзел;
		// Серверный вызов - не в событии активизации строки, а обработчиком ожидания.
		ПодключитьОбработчикОжидания("ОбновитьПоТекущемуУзлу", ЗадержкаОбновления(), Истина);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбмен(Команда)
	Если Не ЗначениеЗаполнено(ТекущийУзел) Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение( , ВыполнитьОбменНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ПовторитьОтложенные(Команда)
	Если Не ЗначениеЗаполнено(ТекущийУзел) Тогда
		Возврат;
	КонецЕсли;
	Применено = ПовторитьНаСервере();
	Текст = СтрШаблон(НСтр("ru = 'Применено объектов: %1'; fr = 'Objets appliqués : %1';
		|en = 'Objects applied: %1'; es = 'Objetos aplicados: %1'"), Применено);
	ПоказатьПредупреждение( , Текст);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСопоставления(Команда)
	Если Не ЗначениеЗаполнено(ТекущийУзел) Тогда
		Возврат;
	КонецЕсли;
	СохранитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗадержкаОбновления()
	// BSLLS:MagicNumber-off
	Возврат 0.1;
	// BSLLS:MagicNumber-on
КонецФункции

&НаКлиенте
Процедура ОбновитьПоТекущемуУзлу()
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	Данные = ОбменМеждуБазамиВызовСервера.ДанныеМонитора(ТекущийУзел);
	Узлы.Загрузить(Данные.Узлы);
	Отложенные.Очистить();
	Единицы.Очистить();
	Товары.Очистить();
	Если Данные.Отложенные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отложенные.Загрузить(Данные.Отложенные);
	Для Каждого ДанныеЕдиницы Из Данные.Несопоставленные.Единицы Цикл
		ЗаполнитьЗначенияСвойств(Единицы.Добавить(), ДанныеЕдиницы);
	КонецЦикла;
	Для Каждого ДанныеТовара Из Данные.Несопоставленные.Товары Цикл
		ЗаполнитьЗначенияСвойств(Товары.Добавить(), ДанныеТовара);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ВыполнитьОбменНаСервере()
	Попытка
		Итог = ОбменМеждуБазамиВызовСервера.ВыполнитьОбменУзла(ТекущийУзел);
	Исключение
		Итог = ОбменМеждуБазами.ТекстОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЗаполнитьНаСервере();
	Возврат Итог;
КонецФункции

&НаСервере
Функция ПовторитьНаСервере()
	Применено = ОбменМеждуБазамиВызовСервера.ПовторитьОтложенные(ТекущийУзел);
	ЗаполнитьНаСервере();
	Возврат Применено;
КонецФункции

&НаСервере
Процедура СохранитьНаСервере()
	Для Каждого СтрокаЕдиницы Из Единицы Цикл
		Если ЗначениеЗаполнено(СтрокаЕдиницы.СвояЕдиница) И СтрокаЕдиницы.Коэффициент > 0 Тогда
			// Заполненный товар - коэффициент только для него, пусто - для всех товаров с этой парой единиц.
			ОбменМеждуБазамиВызовСервера.СопоставитьЕдиницу(ТекущийУзел, СтрокаЕдиницы.Ид, СтрокаЕдиницы.СвояЕдиница,
				СтрокаЕдиницы.Коэффициент, СтрокаЕдиницы.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаТовара Из Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.СвояНоменклатура) Тогда
			ОбменМеждуБазамиВызовСервера.СопоставитьОбъект(ТекущийУзел, "Номенклатура", СтрокаТовара.Ид,
				СтрокаТовара.СвояНоменклатура, СтрокаТовара.ЭтоТовар);
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьНаСервере();
КонецПроцедуры

#КонецОбласти
