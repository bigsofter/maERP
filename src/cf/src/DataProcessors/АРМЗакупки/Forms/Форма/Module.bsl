КонецФункции

#КонецОбласти

#Область СписокПоступлений

// Страница закладки «Поступления»; курсор - на заданном документе, иначе на прежнем, если он остался на странице.
//
// Параметры:
//  ТекущийДокумент      - ДокументСсылка.ПоступлениеТоваровУслуг, ДокументСсылка.ПриходныйОрдер, Неопределено - документ
//                         под курсором после загрузки.
//  НомерСтрокиДокумента - Число - режим «Товары»: строка документа под курсором; 0 - первая.
//  ЗаписаннаяСтрока     - Число, Неопределено - режим «Товары»: идентификатор только что записанной новой строки - она
//                         не сохраняется как несохранённая.
//
&НаСервере
Процедура ЗагрузитьПоступленияНаСервере(Знач ТекущийДокумент = Неопределено, Знач НомерСтрокиДокумента = 0,
	Знач ЗаписаннаяСтрока = Неопределено)

	Если ТекущийДокумент = Неопределено И Элементы.СписокПоступлений.ТекущаяСтрока <> Неопределено Тогда
		СтрокаТаблицы = СписокПоступлений.НайтиПоИдентификатору(Элементы.СписокПоступлений.ТекущаяСтрока);
		ТекущийДокумент = ?(СтрокаТаблицы = Неопределено, Неопределено, СтрокаТаблицы.Документ);
	КонецЕсли;
	Страница = Обработки.АРМЗакупки.СтраницаПоступлений(ОтборыПанели(), НомерСтраницыПоступлений,
		РазмерСтраницыЗаказов());
	НомерСтраницыПоступлений = Страница.НомерСтраницы;
	ВсегоСтраницПоступлений = Страница.ВсегоСтраниц;
	СписокПоступлений.Очистить();
	Для Каждого СтрокаДанных Из Страница.Строки Цикл
		ЗаполнитьЗначенияСвойств(СписокПоступлений.Добавить(), СтрокаДанных);
	КонецЦикла;
	РаботаСДокументамиКлиентСервер.ОбновитьПагинатор(ЭтотОбъект, НомерСтраницыПоступлений, ВсегоСтраницПоступлений,
		РазмерСтраницыЗаказов(), Страница.Всего, "Поступлений");
	Найденные = СписокПоступлений.НайтиСтроки(Новый Структура("Документ", ТекущийДокумент));
	Если ТекущийДокумент <> Неопределено И Найденные.Количество() > 0 Тогда
		Элементы.СписокПоступлений.ТекущаяСтрока = Найденные[0].ПолучитьИдентификатор();
	КонецЕсли;
	Если РежимПоступлений = РежимПоступленийТовары() Тогда
		ЗагрузитьТоварыПоступленийНаСервере(ТекущийДокумент, НомерСтрокиДокумента, ЗаписаннаяСтрока);
	КонецЕсли;

КонецПроцедуры

// Режим «Товары»: строки документов текущей страницы «Поступлений» (план docs/plans/arm-purchasing-receipt-lines.md);
// курсор - на заданной строке документа, иначе на первой строке документа. Новые незаписанные строки (запись
// отклонена, строка ждёт правки) остаются сверху.
//
// Параметры:
//  ТекущийДокумент  - ДокументСсылка.ПоступлениеТоваровУслуг, ДокументСсылка.ПриходныйОрдер, Неопределено - документ.
//  НомерСтроки      - Число - строка документа под курсором; 0 - первая.
//  ЗаписаннаяСтрока - Число, Неопределено - идентификатор только что записанной новой строки.
//
&НаСервере
Процедура ЗагрузитьТоварыПоступленийНаСервере(Знач ТекущийДокумент = Неопределено, Знач НомерСтроки = 0,
	Знач ЗаписаннаяСтрока = Неопределено)

	Несохраненные = Новый Массив;
	Колонки = "Документ, ДокументПредставление, НомерСтроки, ВерсияДанных, Поставщик, Номенклатура, Характеристика, Упаковка,
		|КоличествоУпаковок, Цена, Сумма, ЦенаИзменена, КодСтрокиОснования, СтрокаОснованияПредставление, Статус, Склад";
	Для Каждого СтрокаТаблицы Из ТоварыПоступлений Цикл
		Если СтрокаТаблицы.НомерСтроки = 0 И СтрокаТаблицы.ПолучитьИдентификатор() <> ЗаписаннаяСтрока Тогда
			Несохраненная = Новый Структура(Колонки);
			ЗаполнитьЗначенияСвойств(Несохраненная, СтрокаТаблицы);
			Несохраненные.Добавить(Несохраненная);
		КонецЕсли;
	КонецЦикла;
	ТоварыПоступлений.Очистить();
	Для Каждого Несохраненная Из Несохраненные Цикл
		ЗаполнитьЗначенияСвойств(ТоварыПоступлений.Добавить(), Несохраненная);
	КонецЦикла;
	ИмяКолонки = "Документ";
	ДокументыСтраницы = СписокПоступлений.Выгрузить(, ИмяКолонки).ВыгрузитьКолонку(ИмяКолонки);
	Для Каждого СтрокаДанных Из Обработки.АРМЗакупки.СтрокиТоваровПоступлений(ДокументыСтраницы) Цикл
		СтрокаТаблицы = ТоварыПоступлений.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаДанных);
		СтрокаТаблицы.Номенклатура = СтрокаДанных.Материал;
	КонецЦикла;
	Если ТекущийДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура(ИмяКолонки, ТекущийДокумент);
	Если НомерСтроки <> 0 Тогда
		Отбор.Вставить("НомерСтроки", НомерСтроки);
	КонецЕсли;
	Найденные = ТоварыПоступлений.НайтиСтроки(Отбор);
	Если Найденные.Количество() > 0 Тогда
		Элементы.ТоварыПоступлений.ТекущаяСтрока = Найденные[0].ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

// См. Обработки.АРМЗакупки.ИмяФормыНовогоПоступления.
//
// Возвращаемое значение:
//  Строка - полное имя формы объекта.
//
&НаСервереБезКонтекста
Функция ИмяФормыНовогоПоступления()

	Возврат Обработки.АРМЗакупки.ИмяФормыНовогоПоступления();

КонецФункции

// Параметры:
//  ВыбранныеЗаказы - Массив из ДокументСсылка.ЗаказПоставщику - заказы для поступления.
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеТоваровУслуг, ДокументСсылка.ПриходныйОрдер, Неопределено - первый созданный документ.
//
&НаСервере
Функция СоздатьПоступлениеПоЗаказамНаСервере(Знач ВыбранныеЗаказы)

	ПервыйДокумент = Неопределено;
	Шаблон = НСтр("ru = '%1: создано %2'; fr = '%1 : créé %2'; en = '%1: created %2'; es = '%1: creado %2'");
	Для Каждого Итог Из Обработки.АРМЗакупки.ПринятьЗаказы(ВыбранныеЗаказы) Цикл
		Если Итог.Успех Тогда
			Текст = СтрШаблон(Шаблон, Итог.Заказ, Итог.Документ);
			Текст = ?(ПустаяСтрока(Итог.Текст), Текст, СтрШаблон("%1. %2", Текст, Итог.Текст));
			Если ПервыйДокумент = Неопределено Тогда
				ПервыйДокумент = Итог.Документ;
			КонецЕсли;
		Иначе
			Текст = ?(Итог.Заказ = Неопределено, Итог.Текст, СтрШаблон("%1: %2", Итог.Заказ, Итог.Текст));
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЦикла;
	Возврат ПервыйДокумент;

КонецФункции

#КонецОбласти

#Область Потребность

// Закладка верхней группы перечитывается при открытии и после записей: «Поступления», «Потребность»; внизу - закладки
// заказа поставщику, закладки товара потребности или ничего (у «Поступлений» нижней части нет).
//
// Параметры:
//  ТекущийДокумент - ДокументСсылка.ПоступлениеТоваровУслуг, ДокументСсылка.ПриходныйОрдер, Неопределено - документ
//                    под курсором «Поступлений».
//
&НаКлиенте
Процедура ОбновитьОткрытуюЗакладку(ТекущийДокумент = Неопределено)

	НаПотребности = Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаПотребность;
	НаПоступлениях = Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаСписокПоступлений;
	Элементы.ГруппаНиз.Видимость = Не НаПотребности И Не НаПоступлениях;
	Элементы.ГруппаНизПотребности.Видимость = НаПотребности;
	УстановитьВидимостьСоздания(ЭтотОбъект);
	// «Заказы поставщикам» перечитывает ЗагрузитьСтраница.
	Если НаПоступлениях Тогда
		ЗагрузитьПоступленияНаСервере(ТекущийДокумент);
	КонецЕсли;
	Если НаПотребности Тогда
		ЗагрузитьПотребностьНаСервере();
	КонецЕсли;

КонецПроцедуры

// Новый документ из подменю «Создать» с поставщиком из отбора; по закрытии «Поступления» перечитываются.
//
// Параметры:
//  ИмяНовойФормы - Строка - полное имя формы объекта документа.
//
&НаКлиенте
Процедура ОткрытьНовыйДокументПоступления(ИмяНовойФормы)

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДокумента", ЭтотОбъект);
	ЗначенияЗаполнения = Новый Структура;
	Если ЗначениеЗаполнено(ОтборПоставщик) Тогда
		ЗначенияЗаполнения.Вставить("Контрагент", ОтборПоставщик);
	КонецЕсли;
	ОткрытьФорму(ИмяНовойФормы, Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения), ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

// На «Поступлениях» при включённой опции «Ордерные склады» - подменю «Создать поступление» / «Создать приходный
// ордер», иначе - кнопка «Создать» (заказ поставщику, на «Поступлениях» - поступление). Вызывается при создании, после
// восстановления закладки из настроек и при каждой смене закладки, в том числе программной.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма рабочего места.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСоздания(Форма)

	Элементы = Форма.Элементы;
	Подменю = Форма.ОрдерныеСкладыВключены
		И Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаСписокПоступлений;
	Элементы.ГруппаСоздатьПоступление.Видимость = Подменю;
	Элементы.ФормаСоздать.Видимость = Не Подменю;

КонецПроцедуры

&НаСервере
Процедура НастроитьПотребность()

	Выбор = Элементы.ГруппировкаПотребности;
	Выбор.РежимВыбораИзСписка = Истина;
	Выбор.СписокВыбора.Добавить(Обработки.АРМЗакупки.ГруппировкаПоТовару(),
		НСтр("ru = 'по товару'; fr = 'par article'; en = 'by item'; es = 'por artículo'"));
	Выбор.СписокВыбора.Добавить(Обработки.АРМЗакупки.ГруппировкаПоЗаказу(),
		НСтр("ru = 'по заказу клиента'; fr = 'par commande client'; en = 'by customer order'; es = 'por pedido del cliente'"));
	Выбор.СписокВыбора.Добавить(Обработки.АРМЗакупки.ГруппировкаПоПоставщику(),
		НСтр("ru = 'по поставщику'; fr = 'par fournisseur'; en = 'by supplier'; es = 'por proveedor'"));
	ГруппировкаПотребности = Обработки.АРМЗакупки.ГруппировкаПоТовару();
	ТолькоДефицит = Истина;
	// Тендер - только при опции «Тендеры поставщиков» (ревью плана 2.0.16.31, P2-4).
	ТендерыВключены = Обработки.АРМЗакупки.ТендерыВключены();
	Элементы.КнопкаЗапроситьПредложения.Видимость = ТендерыВключены;
	Элементы.ПотребностьТендер.Видимость = ТендерыВключены
		И ГруппировкаПотребности = Обработки.АРМЗакупки.ГруппировкаПоЗаказу();
	Элементы.СтраницаПредложенияТовара.Видимость = ТендерыВключены;
	// Первая закладка - «Потребность»: внизу закладки товара.
	Элементы.ГруппаНиз.Видимость = Ложь;
	Элементы.ГруппаНизПотребности.Видимость = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПотребностьНаСервере()

	ПараметрыПотребности = Обработки.АРМЗакупки.НовыеПараметрыПотребности();
	ПараметрыПотребности.Товар = ОтборТовар;
	ПараметрыПотребности.Поставщик = ОтборПоставщик;
	ПараметрыПотребности.ТолькоДефицит = ТолькоДефицит;
	ПараметрыПотребности.Группировка = ГруппировкаПотребности;
	// «Тендер» считается только по заказу клиента (ревью 2.0.16.31, P3).
	Элементы.ПотребностьТендер.Видимость = Обработки.АРМЗакупки.ТендерыВключены()
		И ГруппировкаПотребности = Обработки.АРМЗакупки.ГруппировкаПоЗаказу();
	Данные = Обработки.АРМЗакупки.СтрокиПотребности(ПараметрыПотребности);
	Потребность.Очистить();
	Для Каждого СтрокаДанных Из Данные.Строки Цикл
		ЗаполнитьЗначенияСвойств(Потребность.Добавить(), СтрокаДанных);
	КонецЦикла;
	Пояснения = Новый Массив;
	Если Не Данные.ПополнениеНастроено Тогда
		Пояснения.Добавить(НСтр("ru = 'Пополнение до минимума не настроено: нет склада с оповещением о минимальном остатке.';
			|fr = 'Réapprovisionnement non configuré : aucun entrepôt avec alerte de stock minimum.';
			|en = 'Replenishment is not set up: no warehouse with a minimum stock alert.';
			|es = 'Reposición no configurada: no hay almacén con aviso de stock mínimo.'"));
	КонецЕсли;
	Если Данные.Обрезано Тогда
		Пояснения.Добавить(НСтр("ru = 'Показаны не все строки: уточните отбор.'; fr = 'Toutes les lignes ne sont pas
			|affichées : précisez le filtre.'; en = 'Not all lines are shown: narrow the filter.';
			|es = 'No se muestran todas las líneas: precise el filtro.'"));
	КонецЕсли;
	Элементы.НадписьПополнение.Заголовок = СтрСоединить(Пояснения, " ");
	ЗагрузитьДанныеСтрокиПотребности(?(Потребность.Количество() = 0, Неопределено, Потребность[0].ПолучитьИдентификатор()));

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтрокуПотребности()

	ЗагрузитьДанныеСтрокиПотребности(Элементы.Потребность.ТекущаяСтрока);

КонецПроцедуры

// Параметры:
//  Идентификатор - Число, Неопределено - строка «Потребности»; Неопределено - нижние закладки пусты.
//
&НаСервере
Процедура ЗагрузитьДанныеСтрокиПотребности(Знач Идентификатор)

	ИсточникиТовара.Очистить();
	ЗаказыТовара.Очистить();
	ОстаткиТовара.Очистить();
	СтрокаТаблицы = ?(Идентификатор = Неопределено, Неопределено, Потребность.НайтиПоИдентификатору(Идентификатор));
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Данные = Обработки.АРМЗакупки.ДанныеСтрокиПотребности(СтрокаТаблицы.Номенклатура, СтрокаТаблицы.Характеристика);
	Для Каждого СтрокаДанных Из Данные.Источники Цикл
		ЗаполнитьЗначенияСвойств(ИсточникиТовара.Добавить(), СтрокаДанных);
	КонецЦикла;
	ЗаказыТовара.Загрузить(Данные.ЗаказыПоставщику);
	ОстаткиТовара.Загрузить(Данные.Остатки);
	ПредложенияТовара.Очистить();
	Если Обработки.АРМЗакупки.ТендерыВключены() Тогда
		// Предложения - по заказам клиентов строки: у сводной строки - по всем её заказам-источникам.
		// Не «Заказы»: так называется реквизит формы - список заказов поставщикам.
		ЗаказыИсточников = Новый Массив;
		Для Каждого Источник Из Данные.Источники Цикл
			Если ЗначениеЗаполнено(Источник.Источник) Тогда
				ЗаказыИсточников.Добавить(Источник.Источник);
			КонецЕсли;
		КонецЦикла;
		Предложения = Обработки.АРМЗакупки.ПредложенияТовара(ЗаказыИсточников, СтрокаТаблицы.Номенклатура,
			СтрокаТаблицы.Характеристика);
		Для Каждого СтрокаПредложения Из Предложения Цикл
			ЗаполнитьЗначенияСвойств(ПредложенияТовара.Добавить(), СтрокаПредложения);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗапроситьПредложенияНаСервере(Знач Поставщики)

	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Потребность.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		Строка = Новый Структура("Номенклатура, Характеристика");
		ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
		Строка.Вставить("Источник", ?(СтрокаТаблицы.Сводная, Неопределено, СтрокаТаблицы.Источник));
		Строка.Вставить("Количество", СтрокаТаблицы.КЗаказу);
		Строки.Добавить(Строка);
	КонецЦикла;
	Шаблон = НСтр("ru = '%1: создано %2'; fr = '%1 : créé %2'; en = '%1: created %2'; es = '%1: creado %2'");
	Для Каждого Итог Из Обработки.АРМЗакупки.ЗапроситьПредложения(Строки, Поставщики) Цикл
		Поставщик = ?(Итог.Поставщик = Неопределено, "", Итог.Поставщик);
		Текст = ?(Итог.Успех, СтрШаблон(Шаблон, Поставщик, Итог.Документ), СтрШаблон("%1: %2", Поставщик, Итог.Текст));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЦикла;
	ЗагрузитьПотребностьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ВыбратьПобедителяНаСервере(Знач Предложение)

	Результат = Обработки.АРМЗакупки.ВыбратьПобедителя(Предложение);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
	КонецЕсли;
	// Колонка «Тендер» показывает победителя: перечитывается вся закладка.
	Идентификатор = Элементы.Потребность.ТекущаяСтрока;
	ЗагрузитьПотребностьНаСервере();
	Если Идентификатор <> Неопределено И Потребность.НайтиПоИдентификатору(Идентификатор) <> Неопределено Тогда
		ЗагрузитьДанныеСтрокиПотребности(Идентификатор);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаказатьУПобедителяНаСервере(Знач Предложение)

	Итог = Обработки.АРМЗакупки.ЗаказатьУПобедителя(Предложение);
	Шаблон = НСтр("ru = 'Создан %1.'; fr = 'Créé %1.'; en = 'Created %1.'; es = 'Creado %1.'");
	Текст = ?(Итог.Успех, СтрШаблон(Шаблон, Итог.Документ), "");
	Текст = СокрЛП(Текст + " " + Итог.Текст);
	Если Не ПустаяСтрока(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЕсли;
	ЗагрузитьПотребностьНаСервере();

КонецПроцедуры

// Возвращаемое значение:
//  Массив из Структура - отмеченные строки «Потребности» с «к заказу» больше нуля, см.
//                        Обработки.АРМЗакупки.ЗаказатьПотребность.
//
&НаСервере
Функция ОтмеченныеСтрокиПотребности()

	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Потребность.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		Если СтрокаТаблицы.КЗаказу <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = Новый Структура("Номенклатура, Характеристика, Поставщик");
		ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
		Строка.Вставить("Источник", ?(СтрокаТаблицы.Сводная, Неопределено, СтрокаТаблицы.Источник));
		Строка.Вставить("Количество", СтрокаТаблицы.КЗаказу);
		Строка.Вставить("ДефицитНаЭкране", СтрокаТаблицы.Дефицит);
		Строки.Добавить(Строка);
	КонецЦикла;
	Возврат Строки;

КонецФункции

&НаСервере
Процедура ЗаказатьПотребностьНаСервере()

	Строки = ОтмеченныеСтрокиПотребности();
	Шаблон = НСтр("ru = '%1: создан %2'; fr = '%1 : créé %2'; en = '%1: created %2'; es = '%1: creado %2'");
	Для Каждого Итог Из Обработки.АРМЗакупки.ЗаказатьПотребность(Строки) Цикл
		Поставщик = ?(Итог.Поставщик = Неопределено, "", Итог.Поставщик);
		Текст = ?(Итог.Успех, СтрШаблон(Шаблон, Поставщик, Итог.Документ), СтрШаблон("%1: %2", Поставщик, Итог.Текст));
		Если Итог.Успех И Не ПустаяСтрока(Итог.Текст) Тогда
			Текст = СтрШаблон("%1. %2", Текст, Итог.Текст);
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЦикла;
	ЗагрузитьПотребностьНаСервере();

КонецПроцедуры

// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеТоваровУслуг, ДокументСсылка.ПриходныйОрдер, Неопределено - первый созданный документ.
//
&НаСервере
Функция СоздатьПоступлениеПоПотребностиНаСервере()

	ПервыйДокумент = Неопределено;
	Шаблон = НСтр("ru = '%1: создано %2'; fr = '%1 : créé %2'; en = '%1: created %2'; es = '%1: creado %2'");
	Для Каждого Итог Из Обработки.АРМЗакупки.ПринятьПотребность(ОтмеченныеСтрокиПотребности()) Цикл
		Поставщик = ?(Итог.Поставщик = Неопределено, "", Итог.Поставщик);
		Если Итог.Успех Тогда
			Текст = СтрШаблон(Шаблон, Поставщик, Итог.Документ);
			Текст = ?(ПустаяСтрока(Итог.Текст), Текст, СтрШаблон("%1. %2", Текст, Итог.Текст));
			Если ПервыйДокумент = Неопределено Тогда
				ПервыйДокумент = Итог.Документ;
			КонецЕсли;
		Иначе
			Текст = СтрШаблон("%1: %2", Поставщик, Итог.Текст);
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЦикла;
	ЗагрузитьПотребностьНаСервере();
	Возврат ПервыйДокумент;

КонецФункции

#КонецОбласти

#КонецОбласти
