&НаСервере
Процедура ЗаписатьСтрокуТоваровНаСервере(Знач Идентификатор)

	СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Строка = Новый Структура("НомерСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Цена, ЦенаИзменена");
	ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
	Строка.Вставить("ВерсияДанных", ВерсияЗаказа);
	Результат = Обработки.АРМЗакупки.ЗаписатьСтрокуТоваров(ТекущийЗаказ, Строка);
	СообщитьРезультат(Результат.Текст);

КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиТоваровНаСервере(Знач НомераСтрок)

	Результат = Обработки.АРМЗакупки.УдалитьСтрокиТоваров(ТекущийЗаказ, ВерсияЗаказа, НомераСтрок);
	СообщитьРезультат(Результат.Текст);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьСтрокуПоступленияНаСервере(Знач Идентификатор)

	СтрокаТаблицы = Поступления.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Строка = Новый Структура("Документ, НомерСтроки, ВерсияДанных, КодСтроки, Номенклатура, Характеристика, Упаковка,
		|КоличествоУпаковок, НомерНакладной, ДатаНакладной");
	ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
	Результат = Обработки.АРМЗакупки.ЗаписатьСтрокуПоступления(ТекущийЗаказ, Строка);
	СообщитьРезультат(Результат.Текст);

КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиПоступленийНаСервере(Знач Строки)

	Результат = Обработки.АРМЗакупки.УдалитьСтрокиПоступлений(ТекущийЗаказ, Строки);
	СообщитьРезультат(Результат.Текст);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СообщитьРезультат(Текст)

	Если Не ПустаяСтрока(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СтрокиЗаказаДляПоступления(Знач Заказ)

	Возврат Обработки.АРМЗакупки.СтрокиЗаказаДляПоступления(Заказ);

КонецФункции

// Параметры:
//  ВыбранныйЭлемент - ЭлементСпискаЗначений, Неопределено - строка заказа: Структура ЗаказПоставщику, КодСтроки, Материал,
//                     Характеристика, Упаковка, КоличествоУпаковок; Неопределено - выбор отменён.
//  Идентификатор    - Число - идентификатор строки поступления.
//
&НаКлиенте
Процедура ПослеВыбораСтрокиЗаказа(ВыбранныйЭлемент, Идентификатор) Экспорт

	СтрокаТаблицы = Поступления.НайтиПоИдентификатору(Идентификатор);
	Если ВыбранныйЭлемент = Неопределено Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Значение = ВыбранныйЭлемент.Значение;
	СтрокаТаблицы.КодСтроки = Значение.КодСтроки;
	СтрокаТаблицы.Номенклатура = Значение.Материал;
	СтрокаТаблицы.Характеристика = Значение.Характеристика;
	СтрокаТаблицы.Упаковка = Значение.Упаковка;
	СтрокаТаблицы.КоличествоУпаковок = Значение.КоличествоУпаковок;

КонецПроцедуры

// Новая строка поступления с той же накладной, что у записанного непомеченного поступления заказа, идёт в него; иначе -
// в новое поступление.
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - новая строка поступлений.
//
&НаКлиенте
Процедура ПодставитьПоступлениеНакладной(СтрокаТаблицы)

	Номер = СокрЛП(СтрокаТаблицы.НомерНакладной);
	Если ПустаяСтрока(Номер) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Соседняя Из Поступления Цикл
		Подходит = Соседняя <> СтрокаТаблицы И ЗначениеЗаполнено(Соседняя.Документ) И Не Соседняя.ПометкаУдаления
			И СокрЛП(Соседняя.НомерНакладной) = Номер;
		Если Подходит Тогда
			СтрокаТаблицы.Документ = Соседняя.Документ;
			СтрокаТаблицы.ВерсияДанных = Соседняя.ВерсияДанных;
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПравкуНакладной(Можно)

	Элементы.ПоступленияНомерНакладной.ТолькоПросмотр = Не Можно;
	Элементы.ПоступленияДатаНакладной.ТолькоПросмотр = Не Можно;
	Элементы.ПоступленияНоменклатура.ТолькоПросмотр = Не Можно;

КонецПроцедуры

// Параметры:
//  Количество - Число - удаляемых строк.
//
// Возвращаемое значение:
//  Строка - вопрос перед удалением строк.
//
&НаКлиентеНаСервереБезКонтекста
Функция ТекстВопросаОбУдалении(Количество)

	Шаблон = НСтр("ru = 'Удалить выделенные строки (%1)? Документ без строк будет помечен на удаление.';
		|fr = 'Supprimer les lignes sélectionnées (%1) ? Un document sans lignes sera marqué pour suppression.';
		|en = 'Delete the selected lines (%1)? A document without lines will be marked for deletion.';
		|es = '¿Eliminar las líneas seleccionadas (%1)? Un documento sin líneas se marcará para eliminar.'");
	Возврат СтрШаблон(Шаблон, Количество);

КонецФункции

// Возвращаемое значение:
//  Строка - запрет ввода строк без текущего заказа.
//
&НаКлиентеНаСервереБезКонтекста
Функция ТекстВыберитеЗаказ()

	Возврат НСтр("ru = 'Выберите заказ поставщику в списке.'; fr = 'Choisissez une commande fournisseur dans la liste.';
		|en = 'Select a supplier order in the list.'; es = 'Elija un pedido a proveedor en la lista.'");

КонецФункции

#КонецОбласти

#Область Статус

&НаКлиенте
Процедура ИзменитьСтатус(Действие)

	ВыбранныеЗаказы = ВыделенныеЗаказы();
	Если ВыбранныеЗаказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИзменитьСтатусНаСервере(ВыбранныеЗаказы, Действие);
	ЗагрузитьСтраницу();

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОтмене(Ответ, ВыбранныеЗаказы) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ИзменитьСтатусНаСервере(ВыбранныеЗаказы, ДействиеОтменить());
		ЗагрузитьСтраницу();
	КонецЕсли;

КонецПроцедуры

// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПоставщику - заказы выделенных строк списка; пусто - с сообщением.
//
&НаКлиенте
Функция ВыделенныеЗаказы()

	Результат = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Заказы.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Заказы.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы <> Неопределено Тогда
			Результат.Добавить(СтрокаТаблицы.Заказ);
		КонецЕсли;
	КонецЦикла;
	Если Результат.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстВыберитеЗаказ());
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ИзменитьСтатусНаСервере(Знач ВыбранныеЗаказы, Знач Действие)

	Для Каждого Итог Из Обработки.АРМЗакупки.ИзменитьСтатусЗаказов(ВыбранныеЗаказы, Действие) Цикл
		Если Не ПустаяСтрока(Итог.Текст) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("%1: %2", Итог.Документ, Итог.Текст));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

