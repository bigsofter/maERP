// Поступления на остаток отмеченных заказов (не отмечено - выделенных): по проведённому документу на заказ без номера
// накладной, затем закладка «Поступления» (план docs/plans/arm-purchasing-receipts.md, С1).
//
// Параметры:
//  Команда - КомандаФормы - «Создать поступление».
//
&НаКлиенте
Процедура СоздатьПоступлениеПоЗаказам(Команда)

	ВыбранныеЗаказы = Новый Массив;
	Для Каждого СтрокаТаблицы Из Заказы.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		ВыбранныеЗаказы.Добавить(СтрокаТаблицы.Заказ);
	КонецЦикла;
	Если ВыбранныеЗаказы.Количество() = 0 Тогда
		ВыбранныеЗаказы = ВыделенныеЗаказы();
	КонецЕсли;
	Если ВыбранныеЗаказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПервыйДокумент = СоздатьПоступлениеПоЗаказамНаСервере(ВыбранныеЗаказы);
	ЗагрузитьСтраницу();
	Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаСписокПоступлений;
	НомерСтраницыПоступлений = 1;
	// Программная смена закладки ПриСменеСтраницы не вызывает.
	ОбновитьОткрытуюЗакладку(ПервыйДокумент);

