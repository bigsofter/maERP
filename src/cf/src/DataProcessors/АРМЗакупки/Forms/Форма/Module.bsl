// Параметры:
//  ВыбранныйЭлемент - ЭлементСпискаЗначений, Неопределено - строка заказа: Структура ЗаказПоставщику, КодСтроки, Материал,
//                     Характеристика, Упаковка, КоличествоУпаковок; Неопределено - выбор отменён.
//  Идентификатор    - Число - идентификатор строки поступления.
//
&НаКлиенте
Процедура ПослеВыбораСтрокиЗаказа(ВыбранныйЭлемент, Идентификатор) Экспорт

	СтрокаТаблицы = Поступления.НайтиПоИдентификатору(Идентификатор);
	Если ВыбранныйЭлемент = Неопределено Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Значение = ВыбранныйЭлемент.Значение;
	СтрокаТаблицы.КодСтроки = Значение.КодСтроки;
	СтрокаТаблицы.Номенклатура = Значение.Материал;
	СтрокаТаблицы.Характеристика = Значение.Характеристика;
	СтрокаТаблицы.Упаковка = Значение.Упаковка;
	СтрокаТаблицы.КоличествоУпаковок = Значение.КоличествоУпаковок;

КонецПроцедуры

// Новая строка поступления с той же накладной, что у записанного непомеченного поступления заказа, идёт в него; иначе -
// в новое поступление.
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - новая строка поступлений.
//
&НаКлиенте
Процедура ПодставитьПоступлениеНакладной(СтрокаТаблицы)

	Номер = СокрЛП(СтрокаТаблицы.НомерНакладной);
	Если ПустаяСтрока(Номер) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Соседняя Из Поступления Цикл
		Подходит = Соседняя <> СтрокаТаблицы И ЗначениеЗаполнено(Соседняя.Документ) И Не Соседняя.ПометкаУдаления
			И СокрЛП(Соседняя.НомерНакладной) = Номер;
		Если Подходит Тогда
			СтрокаТаблицы.Документ = Соседняя.Документ;
			СтрокаТаблицы.ВерсияДанных = Соседняя.ВерсияДанных;
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПравкуНакладной(Можно)

	Элементы.ПоступленияНомерНакладной.ТолькоПросмотр = Не Можно;
	Элементы.ПоступленияДатаНакладной.ТолькоПросмотр = Не Можно;
	Элементы.ПоступленияНоменклатура.ТолькоПросмотр = Не Можно;

КонецПроцедуры

// Параметры:
//  Количество - Число - удаляемых строк.
//
// Возвращаемое значение:
//  Строка - вопрос перед удалением строк.
//
&НаКлиентеНаСервереБезКонтекста
Функция ТекстВопросаОбУдалении(Количество)

	Шаблон = НСтр("ru = 'Удалить выделенные строки (%1)? Документ без строк будет помечен на удаление.';
		|fr = 'Supprimer les lignes sélectionnées (%1) ? Un document sans lignes sera marqué pour suppression.';
		|en = 'Delete the selected lines (%1)? A document without lines will be marked for deletion.';
		|es = '¿Eliminar las líneas seleccionadas (%1)? Un documento sin líneas se marcará para eliminar.'");
	Возврат СтрШаблон(Шаблон, Количество);

КонецФункции

// Возвращаемое значение:
//  Строка - запрет ввода строк без текущего заказа.
//
&НаКлиентеНаСервереБезКонтекста
Функция ТекстВыберитеЗаказ()

	Возврат НСтр("ru = 'Выберите заказ поставщику в списке.'; fr = 'Choisissez une commande fournisseur dans la liste.';
		|en = 'Select a supplier order in the list.'; es = 'Elija un pedido a proveedor en la lista.'");

КонецФункции

#КонецОбласти

#Область Статус

&НаКлиенте
Процедура ИзменитьСтатус(Действие)

	ВыбранныеЗаказы = ВыделенныеЗаказы();
	Если ВыбранныеЗаказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИзменитьСтатусНаСервере(ВыбранныеЗаказы, Действие);
	ЗагрузитьСтраницу();

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОтмене(Ответ, ВыбранныеЗаказы) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ИзменитьСтатусНаСервере(ВыбранныеЗаказы, ДействиеОтменить());
		ЗагрузитьСтраницу();
	КонецЕсли;

КонецПроцедуры

// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПоставщику - заказы выделенных строк списка; пусто - с сообщением.
//
&НаКлиенте
Функция ВыделенныеЗаказы()

	Результат = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Заказы.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Заказы.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы <> Неопределено Тогда
			Результат.Добавить(СтрокаТаблицы.Заказ);
		КонецЕсли;
	КонецЦикла;
	Если Результат.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстВыберитеЗаказ());
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ИзменитьСтатусНаСервере(Знач ВыбранныеЗаказы, Знач Действие)

	Для Каждого Итог Из Обработки.АРМЗакупки.ИзменитьСтатусЗаказов(ВыбранныеЗаказы, Действие) Цикл
		Если Не ПустаяСтрока(Итог.Текст) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("%1: %2", Итог.Документ, Итог.Текст));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращаемое значение:
//  Строка - см. Обработки.АРМПроизводство.ДействиеВРаботу.
//
&НаКлиенте
Функция ДействиеВРаботу()

	Возврат "ВРаботу";

КонецФункции

// Возвращаемое значение:
//  Строка - см. Обработки.АРМПроизводство.ДействиеВЧерновик.
//
&НаКлиенте
Функция ДействиеВЧерновик()

	Возврат "ВЧерновик";

КонецФункции

// Возвращаемое значение:
//  Строка - см. Обработки.АРМПроизводство.ДействиеОтменить.
//
&НаКлиенте
Функция ДействиеОтменить()

	Возврат "Отменить";

КонецФункции

#КонецОбласти

#Область КПоступлению

&НаСервере
Процедура ЗагрузитьКПоступлениюНаСервере()

	КПоступлению.Очистить();
	ТекстПросрочен = НСтр("ru = 'просрочен'; fr = 'en retard'; en = 'overdue'; es = 'vencido'");
	Для Каждого Строка Из Обработки.АРМЗакупки.СтрокиКПоступлению(ОтборыПанели()) Цикл
		НоваяСтрока = КПоступлению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Просрочка = ?(Строка.Просрочен, ТекстПросрочен, "");
	КонецЦикла;
	Если КПоступлению.Количество() >= Обработки.АРМЗакупки.ПределСтрокКПоступлению() Тогда
		Шаблон = НСтр("ru = 'Показаны первые %1 строк: уточните отбор по поставщику или товару.';
			|fr = 'Les %1 premières lignes sont affichées : précisez le filtre par fournisseur ou article.';
			|en = 'The first %1 lines are shown: narrow the filter by supplier or item.';
			|es = 'Se muestran las primeras %1 líneas: precise el filtro por proveedor o artículo.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, КПоступлению.Количество()));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОформитьПоступлениеНаСервере()

	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из КПоступлению.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		Если СтрокаТаблицы.КоличествоУпаковок <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = Новый Структура("Заказ, КодСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок");
		ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
		Строки.Добавить(Строка);
	КонецЦикла;
	Накладная = Новый Структура("Номер, Дата", СокрЛП(НомерНакладной), ДатаНакладной);
	Шаблон = НСтр("ru = '%1: создано %2'; fr = '%1 : créé %2'; en = '%1: created %2'; es = '%1: creado %2'");
	Для Каждого Итог Из Обработки.АРМЗакупки.ОформитьПоступления(Строки, Накладная) Цикл
		Если Итог.Успех Тогда
			Текст = СтрШаблон(Шаблон, Итог.Заказ, Итог.Документ);
			Текст = ?(ПустаяСтрока(Итог.Текст), Текст, СтрШаблон("%1. %2", Текст, Итог.Текст));
		Иначе
			Текст = ?(Итог.Заказ = Неопределено, Итог.Текст, СтрШаблон("%1: %2", Итог.Заказ, Итог.Текст));
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЦикла;
	ЗагрузитьКПоступлениюНаСервере();

КонецПроцедуры

#КонецОбласти

#Область Потребность

// Закладка верхней группы перечитывается при открытии и после записей: «К поступлению», «Потребность»; внизу - закладки
// заказа поставщику или закладки товара потребности.
&НаКлиенте
Процедура ОбновитьОткрытуюЗакладку()

	НаПотребности = Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаПотребность;
	Элементы.ГруппаНиз.Видимость = Не НаПотребности;
	Элементы.ГруппаНизПотребности.Видимость = НаПотребности;
	// «Заказы поставщикам» перечитывает ЗагрузитьСтраница.
	Если Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаКПоступлению Тогда
		ЗагрузитьКПоступлениюНаСервере();
	КонецЕсли;
	Если НаПотребности Тогда
		ЗагрузитьПотребностьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НастроитьПотребность()

	Выбор = Элементы.ГруппировкаПотребности;
	Выбор.РежимВыбораИзСписка = Истина;
	Выбор.СписокВыбора.Добавить(Обработки.АРМЗакупки.ГруппировкаПоТовару(),
		НСтр("ru = 'по товару'; fr = 'par article'; en = 'by item'; es = 'por artículo'"));
	Выбор.СписокВыбора.Добавить(Обработки.АРМЗакупки.ГруппировкаПоЗаказу(),
		НСтр("ru = 'по заказу клиента'; fr = 'par commande client'; en = 'by customer order'; es = 'por pedido del cliente'"));
	Выбор.СписокВыбора.Добавить(Обработки.АРМЗакупки.ГруппировкаПоПоставщику(),
		НСтр("ru = 'по поставщику'; fr = 'par fournisseur'; en = 'by supplier'; es = 'por proveedor'"));
	ГруппировкаПотребности = Обработки.АРМЗакупки.ГруппировкаПоТовару();
	ТолькоДефицит = Истина;
	// Тендер - только при опции «Тендеры поставщиков» (ревью плана 2.0.16.31, P2-4).
	ТендерыВключены = Обработки.АРМЗакупки.ТендерыВключены();
	Элементы.КнопкаЗапроситьПредложения.Видимость = ТендерыВключены;
	Элементы.ПотребностьТендер.Видимость = ТендерыВключены
		И ГруппировкаПотребности = Обработки.АРМЗакупки.ГруппировкаПоЗаказу();
	Элементы.СтраницаПредложенияТовара.Видимость = ТендерыВключены;
	// Первая закладка - «Потребность»: внизу закладки товара.
	Элементы.ГруппаНиз.Видимость = Ложь;
	Элементы.ГруппаНизПотребности.Видимость = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПотребностьНаСервере()

	ПараметрыПотребности = Обработки.АРМЗакупки.НовыеПараметрыПотребности();
	ПараметрыПотребности.Товар = ОтборТовар;
	ПараметрыПотребности.Поставщик = ОтборПоставщик;
	ПараметрыПотребности.ТолькоДефицит = ТолькоДефицит;
	ПараметрыПотребности.Группировка = ГруппировкаПотребности;
	// «Тендер» считается только по заказу клиента (ревью 2.0.16.31, P3).
	Элементы.ПотребностьТендер.Видимость = Обработки.АРМЗакупки.ТендерыВключены()
		И ГруппировкаПотребности = Обработки.АРМЗакупки.ГруппировкаПоЗаказу();
	Данные = Обработки.АРМЗакупки.СтрокиПотребности(ПараметрыПотребности);
	Потребность.Очистить();
	Для Каждого СтрокаДанных Из Данные.Строки Цикл
		ЗаполнитьЗначенияСвойств(Потребность.Добавить(), СтрокаДанных);
	КонецЦикла;
	Пояснения = Новый Массив;
	Если Не Данные.ПополнениеНастроено Тогда
		Пояснения.Добавить(НСтр("ru = 'Пополнение до минимума не настроено: нет склада с оповещением о минимальном остатке.';
			|fr = 'Réapprovisionnement non configuré : aucun entrepôt avec alerte de stock minimum.';
			|en = 'Replenishment is not set up: no warehouse with a minimum stock alert.';
			|es = 'Reposición no configurada: no hay almacén con aviso de stock mínimo.'"));
	КонецЕсли;
	Если Данные.Обрезано Тогда
		Пояснения.Добавить(НСтр("ru = 'Показаны не все строки: уточните отбор.'; fr = 'Toutes les lignes ne sont pas
			|affichées : précisez le filtre.'; en = 'Not all lines are shown: narrow the filter.';
			|es = 'No se muestran todas las líneas: precise el filtro.'"));
	КонецЕсли;
	Элементы.НадписьПополнение.Заголовок = СтрСоединить(Пояснения, " ");
	ЗагрузитьДанныеСтрокиПотребности(?(Потребность.Количество() = 0, Неопределено, Потребность[0].ПолучитьИдентификатор()));

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтрокуПотребности()

	ЗагрузитьДанныеСтрокиПотребности(Элементы.Потребность.ТекущаяСтрока);

КонецПроцедуры

// Параметры:
//  Идентификатор - Число, Неопределено - строка «Потребности»; Неопределено - нижние закладки пусты.
//
&НаСервере
Процедура ЗагрузитьДанныеСтрокиПотребности(Знач Идентификатор)

	ИсточникиТовара.Очистить();
	ЗаказыТовара.Очистить();
	ОстаткиТовара.Очистить();
	СтрокаТаблицы = ?(Идентификатор = Неопределено, Неопределено, Потребность.НайтиПоИдентификатору(Идентификатор));
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Данные = Обработки.АРМЗакупки.ДанныеСтрокиПотребности(СтрокаТаблицы.Номенклатура, СтрокаТаблицы.Характеристика);
	Для Каждого СтрокаДанных Из Данные.Источники Цикл
		ЗаполнитьЗначенияСвойств(ИсточникиТовара.Добавить(), СтрокаДанных);
	КонецЦикла;
	ЗаказыТовара.Загрузить(Данные.ЗаказыПоставщику);
	ОстаткиТовара.Загрузить(Данные.Остатки);
	ПредложенияТовара.Очистить();
	Если Обработки.АРМЗакупки.ТендерыВключены() Тогда
		// Предложения - по заказам клиентов строки: у сводной строки - по всем её заказам-источникам.
		// Не «Заказы»: так называется реквизит формы - список заказов поставщикам.
		ЗаказыИсточников = Новый Массив;
		Для Каждого Источник Из Данные.Источники Цикл
			Если ЗначениеЗаполнено(Источник.Источник) Тогда
				ЗаказыИсточников.Добавить(Источник.Источник);
			КонецЕсли;
		КонецЦикла;
		Предложения = Обработки.АРМЗакупки.ПредложенияТовара(ЗаказыИсточников, СтрокаТаблицы.Номенклатура,
			СтрокаТаблицы.Характеристика);
		Для Каждого СтрокаПредложения Из Предложения Цикл
			ЗаполнитьЗначенияСвойств(ПредложенияТовара.Добавить(), СтрокаПредложения);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗапроситьПредложенияНаСервере(Знач Поставщики)

	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Потребность.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		Строка = Новый Структура("Номенклатура, Характеристика");
		ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
		Строка.Вставить("Источник", ?(СтрокаТаблицы.Сводная, Неопределено, СтрокаТаблицы.Источник));
		Строка.Вставить("Количество", СтрокаТаблицы.КЗаказу);
		Строки.Добавить(Строка);
	КонецЦикла;
	Шаблон = НСтр("ru = '%1: создано %2'; fr = '%1 : créé %2'; en = '%1: created %2'; es = '%1: creado %2'");
	Для Каждого Итог Из Обработки.АРМЗакупки.ЗапроситьПредложения(Строки, Поставщики) Цикл
		Поставщик = ?(Итог.Поставщик = Неопределено, "", Итог.Поставщик);
		Текст = ?(Итог.Успех, СтрШаблон(Шаблон, Поставщик, Итог.Документ), СтрШаблон("%1: %2", Поставщик, Итог.Текст));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЦикла;
	ЗагрузитьПотребностьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ВыбратьПобедителяНаСервере(Знач Предложение)

	Результат = Обработки.АРМЗакупки.ВыбратьПобедителя(Предложение);
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Текст);
	КонецЕсли;
	// Колонка «Тендер» показывает победителя: перечитывается вся закладка.
	Идентификатор = Элементы.Потребность.ТекущаяСтрока;
	ЗагрузитьПотребностьНаСервере();
	Если Идентификатор <> Неопределено И Потребность.НайтиПоИдентификатору(Идентификатор) <> Неопределено Тогда
		ЗагрузитьДанныеСтрокиПотребности(Идентификатор);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаказатьУПобедителяНаСервере(Знач Предложение)

	Итог = Обработки.АРМЗакупки.ЗаказатьУПобедителя(Предложение);
	Шаблон = НСтр("ru = 'Создан %1.'; fr = 'Créé %1.'; en = 'Created %1.'; es = 'Creado %1.'");
	Текст = ?(Итог.Успех, СтрШаблон(Шаблон, Итог.Документ), "");
	Текст = СокрЛП(Текст + " " + Итог.Текст);
	Если Не ПустаяСтрока(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЕсли;
	ЗагрузитьПотребностьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаказатьПотребностьНаСервере()

	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Потребность.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		Если СтрокаТаблицы.КЗаказу <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = Новый Структура("Номенклатура, Характеристика, Поставщик");
		ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
		Строка.Вставить("Источник", ?(СтрокаТаблицы.Сводная, Неопределено, СтрокаТаблицы.Источник));
		Строка.Вставить("Количество", СтрокаТаблицы.КЗаказу);
		Строка.Вставить("ДефицитНаЭкране", СтрокаТаблицы.Дефицит);
		Строки.Добавить(Строка);
	КонецЦикла;
	Шаблон = НСтр("ru = '%1: создан %2'; fr = '%1 : créé %2'; en = '%1: created %2'; es = '%1: creado %2'");
	Для Каждого Итог Из Обработки.АРМЗакупки.ЗаказатьПотребность(Строки) Цикл
		Поставщик = ?(Итог.Поставщик = Неопределено, "", Итог.Поставщик);
		Текст = ?(Итог.Успех, СтрШаблон(Шаблон, Поставщик, Итог.Документ), СтрШаблон("%1: %2", Поставщик, Итог.Текст));
		Если Итог.Успех И Не ПустаяСтрока(Итог.Текст) Тогда
			Текст = СтрШаблон("%1. %2", Текст, Итог.Текст);
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЦикла;
	ЗагрузитьПотребностьНаСервере();

КонецПроцедуры

#КонецОбласти

#КонецОбласти
