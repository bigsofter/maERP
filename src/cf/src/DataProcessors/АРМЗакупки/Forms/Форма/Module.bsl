#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.НадписьЛегенда.Заголовок = Обработки.АРМЗакупки.ЛегендаИндикатораСтрокой();
	НомерСтраницы = 1;
	ДатаНакладной = ТекущаяДатаСеанса();
	// Характеристика строки заказа - только своего товара.
	Связи = Новый Массив;
	СвязьВладельца = Новый СвязьПараметраВыбора("Отбор.Владелец", "Элементы.Товары.ТекущиеДанные.Номенклатура");
	Связи.Добавить(СвязьВладельца);
	Элементы.ТоварыХарактеристика.СвязиПараметровВыбора = Новый ФиксированныйМассив(Связи);
	ПрименитьСостояниеПанели(ЭтотОбъект);
	ЗагрузитьСтраницуНаСервере();
	ЗагрузитьДанныеЗаказа(?(Заказы.Количество() = 0, Неопределено, Заказы[0].Заказ));

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	// Сохранённое состояние панели восстанавливается после ПриСозданииНаСервере.
	ПрименитьСостояниеПанели(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Отборы панели фильтров: список перечитывается с первой страницы.
//
// Параметры:
//  Элемент - ПолеФормы - изменённое поле фильтра.
//
&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	НомерСтраницы = 1;
	ЗагрузитьСтраницу();
	Если Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаКПоступлению Тогда
		ЗагрузитьКПоступлениюНаСервере();
	КонецЕсли;

КонецПроцедуры

// Закладка «К поступлению» читается при открытии: строки всех заказов поставщику не нужны, пока закладка закрыта.
//
// Параметры:
//  Элемент         - ГруппаФормы - верхние закладки.
//  ТекущаяСтраница - ГруппаФормы - открытая закладка.
//
&НаКлиенте
Процедура ГруппаВерхПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаКПоступлению Тогда
		ЗагрузитьКПоступлениюНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказы

&НаКлиенте
Процедура ЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.ЗаказыЗаказКлиента И ЗначениеЗаполнено(СтрокаТаблицы.ЗаказКлиента) Тогда
		ОткрытьДокумент(СтрокаТаблицы.ЗаказКлиента);
	Иначе
		ОткрытьДокумент(СтрокаТаблицы.Заказ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПриАктивизацииСтроки(Элемент)

	ЗадержкаСекунд = 0.2;
	ПодключитьОбработчикОжидания("ОбновитьТекущийЗаказ", ЗадержкаСекунд, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКПоступлению

&НаКлиенте
Процедура КПоступлениюВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Элементы.КПоступлениюЗаказПредставление И Элемент.ТекущиеДанные <> Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьДокумент(Элемент.ТекущиеДанные.Заказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Если Не ВводРазрешен(ТекстЗапретаТоваров) Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередНачаломИзменения(Элемент, Отказ)

	Если Не ВводРазрешен(ТекстЗапретаТоваров) Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	НомераСтрок = Новый Массив;
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы <> Неопределено И СтрокаТаблицы.НомерСтроки > 0 Тогда
			НомераСтрок.Добавить(СтрокаТаблицы.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	Если НомераСтрок.Количество() = 0 Или Не ВводРазрешен(ТекстЗапретаТоваров) Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдаленииТоваров", ЭтотОбъект, НомераСтрок);
	ПоказатьВопрос(Оповещение, ТекстВопросаОбУдалении(НомераСтрок.Количество()), РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если ОтменаРедактирования Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
		// Незаполненная новая строка не записывается: её убирает перечитывание.
		ОбновитьТекущийЗаказ();
		Возврат;
	КонецЕсли;
	ЗаписатьСтрокуТоваровНаСервере(Элемент.ТекущаяСтрока);
	ПослеЗаписиСтрок();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Характеристика и упаковка - от прежнего товара; цену подставит запись (заказ-основание или прайс поставщика).
	СтрокаТаблицы.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	СтрокаТаблицы.Упаковка = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
	СтрокаТаблицы.ЦенаИзменена = Ложь;
	Если СтрокаТаблицы.КоличествоУпаковок = 0 Тогда
		СтрокаТаблицы.КоличествоУпаковок = 1;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
		Элементы.Товары.ТекущиеДанные.ЦенаИзменена = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоступления

&НаКлиенте
Процедура ПоступленияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ОткрытьДокументСтроки(Элемент, Поле, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Если ВводРазрешен(ТекстЗапретаПоступлений) Тогда
		УстановитьПравкуНакладной(Истина);
	Иначе
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПередНачаломИзменения(Элемент, Отказ)

	Если ВводРазрешен(ТекстЗапретаПоступлений) И Элемент.ТекущиеДанные <> Неопределено Тогда
		// Накладная записанной строки - реквизит шапки поступления: правится в форме документа.
		УстановитьПравкуНакладной(Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.Документ));
	Иначе
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	Строки = Новый Массив;
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Поступления.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы <> Неопределено И ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
			Ключ = Новый Структура("Документ, НомерСтроки, ВерсияДанных");
			ЗаполнитьЗначенияСвойств(Ключ, СтрокаТаблицы);
			Строки.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Если Строки.Количество() = 0 Или Не ВводРазрешен(ТекстЗапретаПоступлений) Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдаленииПоступлений", ЭтотОбъект, Строки);
	ПоказатьВопрос(Оповещение, ТекстВопросаОбУдалении(Строки.Количество()), РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если ОтменаРедактирования Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаТаблицы.КодСтроки = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выберите товар из строк заказа поставщику.';
			|fr = 'Choisissez l''article parmi les lignes de la commande fournisseur.';
			|en = 'Select the item from the supplier order lines.';
			|es = 'Elija el artículo entre las líneas del pedido a proveedor.'"));
		ОбновитьТекущийЗаказ();
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
		ПодставитьПоступлениеНакладной(СтрокаТаблицы);
	КонецЕсли;
	ЗаписатьСтрокуПоступленияНаСервере(Элемент.ТекущаяСтрока);
	ПослеЗаписиСтрок();

КонецПроцедуры

// Товар новой строки поступления - строка текущего заказа с остатком: код строки связывает поступление с заказом.
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «Товар» поступлений.
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - отключается.
//
&НаКлиенте
Процедура ПоступленияНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элементы.Поступления.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
		Возврат;
	КонецЕсли;
	Список = СтрокиЗаказаДляПоступления(ТекущийЗаказ);
	Если Список.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'По заказу всё поступило.';
			|fr = 'Tout est reçu pour la commande.'; en = 'Everything has been received for the order.';
			|es = 'Todo el pedido está recibido.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораСтрокиЗаказа", ЭтотОбъект, Элементы.Поступления.ТекущаяСтрока);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОплаты

&НаКлиенте
Процедура ОплатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ОткрытьДокументСтроки(Элемент, Поле, СтандартнаяОбработка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументы

&НаКлиенте
Процедура ДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ОткрытьДокументСтроки(Элемент, Поле, СтандартнаяОбработка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Создать(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДокумента", ЭтотОбъект);
	ЗначенияЗаполнения = Новый Структура;
	Если ЗначениеЗаполнено(ОтборПоставщик) Тогда
		ЗначенияЗаполнения.Вставить("Контрагент", ОтборПоставщик);
	КонецЕсли;
	ОткрытьФорму("Документ.ЗаказПоставщику.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения),
		ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ЗагрузитьСтраницу();
	Если Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаКПоступлению Тогда
		ЗагрузитьКПоступлениюНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтатусВРаботу(Команда)

	ИзменитьСтатус(ДействиеВРаботу());

КонецПроцедуры

&НаКлиенте
Процедура СтатусВЧерновик(Команда)

	ИзменитьСтатус(ДействиеВЧерновик());

КонецПроцедуры

&НаКлиенте
Процедура СтатусОтменить(Команда)

	ВыбранныеЗаказы = ВыделенныеЗаказы();
	Если ВыбранныеЗаказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбОтмене", ЭтотОбъект, ВыбранныеЗаказы);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Пометить выделенные заказы поставщику на удаление?';
		|fr = 'Marquer les commandes fournisseurs sélectionnées pour suppression ?';
		|en = 'Mark the selected supplier orders for deletion?';
		|es = '¿Marcar los pedidos a proveedores seleccionados para eliminar?'"), РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

// Поступления по отмеченным строкам «К поступлению» одного поставщика: по документу на каждый заказ поставщику с общей
// накладной (план docs/plans/arm-purchasing.md, «К поступлению»).
//
// Параметры:
//  Команда - КомандаФормы - «Оформить поступление».
//
&НаКлиенте
Процедура ОформитьПоступление(Команда)

	Если ПустаяСтрока(НомерНакладной) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Укажите номер накладной поставщика.';
			|fr = 'Indiquez le numéro de facture du fournisseur.'; en = 'Specify the supplier invoice number.';
			|es = 'Indique el número de factura del proveedor.'"), , "НомерНакладной");
		Возврат;
	КонецЕсли;
	Отмечено = КПоступлению.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество();
	Если Отмечено = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отметьте строки к поступлению.';
			|fr = 'Cochez les lignes à réceptionner.'; en = 'Check the lines to receive.';
			|es = 'Marque las líneas a recibir.'"));
		Возврат;
	КонецЕсли;
	ОформитьПоступлениеНаСервере();
	ЗагрузитьСтраницу();

КонецПроцедуры

&НаКлиенте
Процедура СвернутьПанель(Команда)

	ПанельРазвернута = Ложь;
	ПрименитьСостояниеПанели(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьПанель(Команда)

	ПанельРазвернута = Истина;
	ПрименитьСостояниеПанели(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФильтры(Команда)

	ПанельРазвернута = Истина;
	ПрименитьСостояниеПанели(ЭтотОбъект);
	Элементы.ГруппаСтраницыСведений.ТекущаяСтраница = Элементы.СтраницаФильтры;

КонецПроцедуры

&НаКлиенте
Процедура СтраницаПервая(Команда)

	Если НомерСтраницы > 1 Тогда
		НомерСтраницы = 1;
		ЗагрузитьСтраницу();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтраницаНазад(Команда)

	Если НомерСтраницы > 1 Тогда
		НомерСтраницы = НомерСтраницы - 1;
		ЗагрузитьСтраницу();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтраницаВперед(Команда)

	Если НомерСтраницы < ВсегоСтраниц Тогда
		НомерСтраницы = НомерСтраницы + 1;
		ЗагрузитьСтраницу();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтраницаПоследняя(Команда)

	Если НомерСтраницы < ВсегоСтраниц Тогда
		НомерСтраницы = ВсегоСтраниц;
		ЗагрузитьСтраницу();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Перечитывает страницу заказов и нижние закладки текущего заказа; текущий заказ сохраняется, если он остался на странице.
&НаКлиенте
Процедура ЗагрузитьСтраницу()

	ЗагрузитьСтраницуНаСервере();
	ОбновитьТекущийЗаказ();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСтраницуНаСервере()

	Страница = Обработки.АРМЗакупки.СтраницаЗаказов(ОтборыПанели(), НомерСтраницы, РазмерСтраницыЗаказов());
	НомерСтраницы = Страница.НомерСтраницы;
	ВсегоСтраниц = Страница.ВсегоСтраниц;
	Заказы.Очистить();
	Для Каждого СтрокаЗаказа Из Страница.Строки Цикл
		ЗаполнитьЗначенияСвойств(Заказы.Добавить(), СтрокаЗаказа);
	КонецЦикла;
	РаботаСДокументамиКлиентСервер.ОбновитьПагинатор(ЭтотОбъект, НомерСтраницы, ВсегоСтраниц, РазмерСтраницыЗаказов(),
		Страница.Всего);
	// Курсор остаётся на прежнем заказе, если тот на странице; иначе - первая строка.
	Найденные = Заказы.НайтиСтроки(Новый Структура("Заказ", ТекущийЗаказ));
	Если Найденные.Количество() > 0 Тогда
		Элементы.Заказы.ТекущаяСтрока = Найденные[0].ПолучитьИдентификатор();
	ИначеЕсли Заказы.Количество() > 0 Тогда
		Элементы.Заказы.ТекущаяСтрока = Заказы[0].ПолучитьИдентификатор();
	Иначе
		Элементы.Заказы.ТекущаяСтрока = Неопределено;
	КонецЕсли;

КонецПроцедуры

// Нижние закладки - по текущему заказу верхней таблицы; при неизменном заказе перечитываются (после записи документов).
&НаКлиенте
Процедура ОбновитьТекущийЗаказ()

	СтрокаТаблицы = Элементы.Заказы.ТекущиеДанные;
	Заказ = ?(СтрокаТаблицы = Неопределено, Неопределено, СтрокаТаблицы.Заказ);
	ЗагрузитьДанныеЗаказа(Заказ);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеЗаказа(Знач Заказ)

	ТекущийЗаказ = Заказ;
	ВерсияЗаказа = "";
	ТекстЗапретаТоваров = ТекстВыберитеЗаказ();
	ТекстЗапретаПоступлений = ТекстЗапретаТоваров;
	Товары.Очистить();
	Поступления.Очистить();
	Оплаты.Очистить();
	Документы.Очистить();
	Элементы.НадписьСальдо.Заголовок = "";
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;
	Данные = Обработки.АРМЗакупки.ДанныеЗаказа(Заказ);
	Товары.Загрузить(Данные.Товары);
	Поступления.Загрузить(Данные.Поступления);
	Оплаты.Загрузить(Данные.Оплаты);
	Документы.Загрузить(Данные.Документы);
	Элементы.НадписьСальдо.Заголовок = Данные.Сальдо;
	ВерсияЗаказа = Данные.Шапка.ВерсияДанных;
	ТекстЗапретаТоваров = Данные.Шапка.ТекстЗапретаТоваров;
	ТекстЗапретаПоступлений = Данные.Шапка.ТекстЗапретаПоступлений;

КонецПроцедуры

&НаСервере
Функция ОтборыПанели()

	Отборы = Обработки.АРМЗакупки.НовыеОтборы();
	Отборы.Поставщик = ОтборПоставщик;
	Отборы.Товар = ОтборТовар;
	Отборы.Статус = ОтборСтатус;
	Отборы.ПериодПоставки = ОтборПериодПоставки;
	Отборы.Ответственный = ОтборОтветственный;
	Отборы.ВидЗаказа = ОтборВидЗаказа;
	Возврат Отборы;

КонецФункции

// Возвращаемое значение:
//  Число - заказов на странице списка.
//
&НаСервере
Функция РазмерСтраницыЗаказов()

	// BSLLS:MagicNumber-off - размер страницы, как в формах списков документов.
	Возврат 50;
	// BSLLS:MagicNumber-on

КонецФункции

// Свёрнутая панель - столбик значков, развёрнутая - страница фильтров с кнопкой свернуть внизу, как в списках документов.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - рабочее место.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьСостояниеПанели(Форма)

	ЭлементыФормы = Форма.Элементы;
	ЭлементыФормы.ГруппаПанельЗначки.Видимость = Не Форма.ПанельРазвернута;
	ЭлементыФормы.ГруппаСтраницыСведений.Видимость = Форма.ПанельРазвернута;
	ЭлементыФормы.ГруппаПодвалПанели.Видимость = Форма.ПанельРазвернута;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументСтроки(Элемент, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Элемент = Элементы.Оплаты И Поле = Элементы.ОплатыОснование Тогда
		ОткрытьДокумент(СтрокаТаблицы.Основание);
	Иначе
		ОткрытьДокумент(СтрокаТаблицы.Документ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокумент(Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДокумента", ЭтотОбъект);
	ОткрытьФорму(ИмяФормыОбъекта(Ссылка), Новый Структура("Ключ", Ссылка), ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияДокумента(Результат, ДопПараметры) Экспорт

	ЗагрузитьСтраницу();
	Если Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаКПоступлению Тогда
		ЗагрузитьКПоступлениюНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяФормыОбъекта(Знач Ссылка)

	Возврат Ссылка.Метаданные().ПолноеИмя() + ".ФормаОбъекта";

КонецФункции

#Область ВводСтрок

&НаКлиенте
Функция ВводРазрешен(ТекстЗапрета)

	Если ПустаяСтрока(ТекстЗапрета) Тогда
