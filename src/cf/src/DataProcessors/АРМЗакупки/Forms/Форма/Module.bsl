// Единица и заказ новой строки - после смены товара, поставщика, характеристики или документа (ревью кода 2.0.16.111).
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - строка ТоварыПоступлений.
//
&НаКлиенте
Процедура ОбновитьДанныеТовараНовойСтроки(СтрокаТаблицы)

	Если СтрокаТаблицы.НомерСтроки <> 0 Тогда
		Возврат;
	КонецЕсли;
	ДанныеТовара = ДанныеТовараНовойСтроки(ДанныеСтрокиТоваровПоступлений(СтрокаТаблицы));
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеТовара);

