&НаСервере
Процедура ЗаписатьСтрокуТоваровНаСервере(Знач Идентификатор)

	СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Строка = Новый Структура("НомерСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Цена, ЦенаИзменена");
	ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
	Строка.Вставить("ВерсияДанных", ВерсияЗаказа);
	Результат = Обработки.АРМЗакупки.ЗаписатьСтрокуТоваров(ТекущийЗаказ, Строка);
	СообщитьРезультат(Результат.Текст);

КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиТоваровНаСервере(Знач НомераСтрок)

	Результат = Обработки.АРМЗакупки.УдалитьСтрокиТоваров(ТекущийЗаказ, ВерсияЗаказа, НомераСтрок);
	СообщитьРезультат(Результат.Текст);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьСтрокуПоступленияНаСервере(Знач Идентификатор)

	СтрокаТаблицы = Поступления.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Строка = Новый Структура("Документ, НомерСтроки, ВерсияДанных, КодСтроки, Номенклатура, Характеристика, Упаковка,
		|КоличествоУпаковок, НомерНакладной, ДатаНакладной");
	ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
	Результат = Обработки.АРМЗакупки.ЗаписатьСтрокуПоступления(ТекущийЗаказ, Строка);
	СообщитьРезультат(Результат.Текст);

КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиПоступленийНаСервере(Знач Строки)

	Результат = Обработки.АРМЗакупки.УдалитьСтрокиПоступлений(ТекущийЗаказ, Строки);
	СообщитьРезультат(Результат.Текст);

КонецПроцедуры

// Запись строки режима «Товары»; удачная - страница «Поступлений» перечитывается с курсором на записанной строке,
// неудачная - строка остаётся для правки.
//
// Параметры:
//  Идентификатор - Число - идентификатор строки ТоварыПоступлений.
//
&НаСервере
Процедура ЗаписатьСтрокуТоваровПоступленияНаСервере(Знач Идентификатор)

	СтрокаТаблицы = ТоварыПоступлений.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НовыйДокумент = Не ЗначениеЗаполнено(СтрокаТаблицы.Документ);
	Результат = Обработки.АРМЗакупки.ЗаписатьСтрокуТоваровПоступления(ДанныеСтрокиТоваровПоступлений(СтрокаТаблицы));
	СообщитьРезультат(Результат.Текст);
	Если Не Результат.Успех Тогда
		Возврат;
	КонецЕсли;
	// Новый документ - самый свежий: он на первой странице списка.
	Если НовыйДокумент Тогда
		НомерСтраницыПоступлений = 1;
	КонецЕсли;
	НомерЗаписаннойСтроки = ?(Результат.Свойство("НомерСтроки"), Результат.НомерСтроки, 0);
	ЗагрузитьПоступленияНаСервере(Результат.Документ, НомерЗаписаннойСтроки, Идентификатор);

КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиТоваровПоступленийНаСервере(Знач Строки)

	Результат = Обработки.АРМЗакупки.УдалитьСтрокиТоваровПоступлений(Строки);
	СообщитьРезультат(Результат.Текст);
	ЗагрузитьПоступленияНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУдаленииТоваровПоступлений(Ответ, Строки) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		УдалитьСтрокиТоваровПоступленийНаСервере(Строки);
	КонецЕсли;

