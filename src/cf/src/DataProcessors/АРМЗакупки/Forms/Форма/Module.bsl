#Область ОписаниеПеременных

// Строка режима «Товары», запись которой ждёт обработчика ожидания: идентификатор строки или Неопределено.
&НаКлиенте
Перем СтрокаТоваровКЗаписи;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.НадписьЛегенда.Заголовок = Обработки.АРМЗакупки.ЛегендаИндикатораСтрокой();
	Элементы.ЗаказыИндикатор.Шрифт = ПроизводственныеЗаказы.ШрифтИндикатора(ШрифтыСтиля.ОбычныйШрифтТекста);
	НомерСтраницы = 1;
	НомерСтраницыПоступлений = 1;
	// Характеристика строки заказа - только своего товара.
	Связи = Новый Массив;
	СвязьВладельца = Новый СвязьПараметраВыбора("Отбор.Владелец", "Элементы.Товары.ТекущиеДанные.Номенклатура");
	Связи.Добавить(СвязьВладельца);
	Элементы.ТоварыХарактеристика.СвязиПараметровВыбора = Новый ФиксированныйМассив(Связи);
	СвязиТоваровПоступлений = Новый Массив;
	СвязьТовараПоступления = Новый СвязьПараметраВыбора("Отбор.Владелец",
		"Элементы.ТоварыПоступлений.ТекущиеДанные.Номенклатура");
	СвязиТоваровПоступлений.Добавить(СвязьТовараПоступления);
	Элементы.ТоварыПоступленийХарактеристика.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиТоваровПоступлений);
	// Строки режима «Товары» пишет механизм поступлений: без права на поступление они только для просмотра.
	Элементы.ТоварыПоступлений.ТолькоПросмотр = Не ПравоДоступа("Добавление", Метаданные.Документы.ПоступлениеТоваровУслуг);
	// Товар поступления - из строк заказа: список открывается сразу, без пустого выпадающего списка платформы.
	РаботаСДокументамиКлиентСервер.УстановитьВыборСвоимСписком(Элементы.ПоступленияНоменклатура);
	ПрименитьСостояниеПанели(ЭтотОбъект);
	ЗагрузитьСтраницуНаСервере();
	ЗагрузитьДанныеЗаказа(?(Заказы.Количество() = 0, Неопределено, Заказы[0].Заказ));
	НастроитьПотребность();
	ЗагрузитьПотребностьНаСервере();
	// Опция читается один раз: её смена видна после переоткрытия формы, как у остальных опций.
	ОрдерныеСкладыВключены = ПолучитьФункциональнуюОпцию("ИспользоватьОрдерныеСклады");
	УстановитьВидимостьРежимаПоступлений(ЭтотОбъект);
	Элементы.ФормаСоздатьПриходныйОрдер.Видимость = ПравоДоступа("Добавление", Метаданные.Документы.ПриходныйОрдер);
	УстановитьВидимостьСоздания(ЭтотОбъект);
	// Как в рабочем месте производства (2.0.16.111): характеристики - по функциональной опции, цены и суммы строк
	// поступлений - по настройке пользователя «Видеть суммы».
	ИспользоватьХарактеристики = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	Для Каждого ИмяКолонки Из СтрРазделить("ПотребностьХарактеристика,ТоварыХарактеристика,ПоступленияХарактеристика,"
		+ "ТоварыПоступленийХарактеристика", ",") Цикл
		Элементы[ИмяКолонки].Видимость = ИспользоватьХарактеристики;
	КонецЦикла;
	ПоказыватьСуммы = Обработки.АРМПроизводство.ПоказыватьСуммы();
	Элементы.ТоварыПоступленийЦена.Видимость = ПоказыватьСуммы;
	Элементы.ТоварыПоступленийСумма.Видимость = ПоказыватьСуммы;

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	// Сохранённое состояние панели и параметры «Потребности» восстанавливаются после ПриСозданииНаСервере.
	ПрименитьСостояниеПанели(ЭтотОбъект);
	Если Элементы.ГруппировкаПотребности.СписокВыбора.НайтиПоЗначению(ГруппировкаПотребности) = Неопределено Тогда
		ГруппировкаПотребности = Обработки.АРМЗакупки.ГруппировкаПоТовару();
	КонецЕсли;
	ЗагрузитьПотребностьНаСервере();
	// Закладка восстанавливается из настроек после ПриСозданииНаСервере.
	УстановитьВидимостьСоздания(ЭтотОбъект);
	УстановитьВидимостьРежимаПоступлений(ЭтотОбъект);
	Если РежимПоступлений = РежимПоступленийТовары() Тогда
		ЗагрузитьТоварыПоступленийНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Закладку из настроек формы платформа восстанавливает на клиенте, после серверных обработчиков и без
	// ПриСменеСтраницы: форма, закрытая на «Поступлениях», иначе открылась бы с кнопкой «Создать» вместо подменю.
	УстановитьВидимостьСоздания(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Отборы панели фильтров: список перечитывается с первой страницы.
//
// Параметры:
//  Элемент - ПолеФормы - изменённое поле фильтра.
//
&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	НомерСтраницы = 1;
	НомерСтраницыПоступлений = 1;
	ЗагрузитьСтраницу();
	ОбновитьОткрытуюЗакладку();

КонецПроцедуры

// Группировка и «только с дефицитом» закладки «Потребность».
//
// Параметры:
//  Элемент - ПолеФормы - изменённый параметр.
//
&НаКлиенте
Процедура ПараметрыПотребностиПриИзменении(Элемент)

	ЗагрузитьПотребностьНаСервере();

КонецПроцедуры

// Закладки «Поступления» и «Потребность» читаются при открытии; внизу - закладки заказа, закладки товара
// потребности или ничего (у «Поступлений»).
//
// Параметры:
//  Элемент         - ГруппаФормы - верхние закладки.
//  ТекущаяСтраница - ГруппаФормы - открытая закладка.
//
&НаКлиенте
Процедура ГруппаВерхПриСменеСтраницы(Элемент, ТекущаяСтраница)

	ОбновитьОткрытуюЗакладку();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПотребность

&НаКлиенте
Процедура ПотребностьПриАктивизацииСтроки(Элемент)

	ЗадержкаСекунд = 0.2;
	ПодключитьОбработчикОжидания("ОбновитьСтрокуПотребности", ЗадержкаСекунд, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИсточникиТовара

&НаКлиенте
Процедура ИсточникиТовараВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ОткрытьДокумент(Элемент.ТекущиеДанные.Источник);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПредложенияТовара

&НаКлиенте
Процедура ПредложенияТовараВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ОткрытьДокумент(Элемент.ТекущиеДанные.Предложение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказыТовара

&НаКлиенте
Процедура ЗаказыТовараВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.ЗаказыТовараЗаказКлиента И ЗначениеЗаполнено(СтрокаТаблицы.ЗаказКлиента) Тогда
		ОткрытьДокумент(СтрокаТаблицы.ЗаказКлиента);
	Иначе
		ОткрытьДокумент(СтрокаТаблицы.Документ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказы

&НаКлиенте
Процедура ЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.ЗаказыЗаказКлиента И ЗначениеЗаполнено(СтрокаТаблицы.ЗаказКлиента) Тогда
		ОткрытьДокумент(СтрокаТаблицы.ЗаказКлиента);
	Иначе
		ОткрытьДокумент(СтрокаТаблицы.Заказ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПриАктивизацииСтроки(Элемент)

	ЗадержкаСекунд = 0.2;
	ПодключитьОбработчикОжидания("ОбновитьТекущийЗаказ", ЗадержкаСекунд, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокПоступлений

&НаКлиенте
Процедура СписокПоступленийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.СписокПоступленийЗаказПредставление И ЗначениеЗаполнено(СтрокаТаблицы.ЗаказПоставщику) Тогда
		ОткрытьДокумент(СтрокаТаблицы.ЗаказПоставщику);
	Иначе
		ОткрытьДокумент(СтрокаТаблицы.Документ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Если Не ВводРазрешен(ТекстЗапретаТоваров) Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередНачаломИзменения(Элемент, Отказ)

	Если Не ВводРазрешен(ТекстЗапретаТоваров) Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	НомераСтрок = Новый Массив;
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Товары.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы <> Неопределено И СтрокаТаблицы.НомерСтроки > 0 Тогда
			НомераСтрок.Добавить(СтрокаТаблицы.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	Если НомераСтрок.Количество() = 0 Или Не ВводРазрешен(ТекстЗапретаТоваров) Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдаленииТоваров", ЭтотОбъект, НомераСтрок);
	ПоказатьВопрос(Оповещение, ТекстВопросаОбУдалении(НомераСтрок.Количество()), РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если ОтменаРедактирования Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
		// Незаполненная новая строка не записывается: её убирает перечитывание.
		ОбновитьТекущийЗаказ();
		Возврат;
	КонецЕсли;
	ЗаписатьСтрокуТоваровНаСервере(Элемент.ТекущаяСтрока);
	ПослеЗаписиСтрок();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Характеристика и упаковка - от прежнего товара; цену подставит запись (заказ-основание или прайс поставщика).
	СтрокаТаблицы.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	СтрокаТаблицы.Упаковка = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
	СтрокаТаблицы.ЦенаИзменена = Ложь;
	Если СтрокаТаблицы.КоличествоУпаковок = 0 Тогда
		СтрокаТаблицы.КоличествоУпаковок = 1;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
		Элементы.Товары.ТекущиеДанные.ЦенаИзменена = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоступления

&НаКлиенте
Процедура ПоступленияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ОткрытьДокументСтроки(Элемент, Поле, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Если ВводРазрешен(ТекстЗапретаПоступлений) Тогда
		УстановитьПравкуНакладной(Истина);
	Иначе
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПередНачаломИзменения(Элемент, Отказ)

	Если ВводРазрешен(ТекстЗапретаПоступлений) И Элемент.ТекущиеДанные <> Неопределено Тогда
		// Накладная записанной строки - реквизит шапки поступления: правится в форме документа.
		УстановитьПравкуНакладной(Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.Документ));
	Иначе
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	Строки = Новый Массив;
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		СтрокаТаблицы = Поступления.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы <> Неопределено И ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
			Ключ = Новый Структура("Документ, НомерСтроки, ВерсияДанных");
			ЗаполнитьЗначенияСвойств(Ключ, СтрокаТаблицы);
			Строки.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Если Строки.Количество() = 0 Или Не ВводРазрешен(ТекстЗапретаПоступлений) Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдаленииПоступлений", ЭтотОбъект, Строки);
	ПоказатьВопрос(Оповещение, ТекстВопросаОбУдалении(Строки.Количество()), РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если ОтменаРедактирования Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаТаблицы.КодСтроки = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выберите товар из строк заказа поставщику.';
			|fr = 'Choisissez l''article parmi les lignes de la commande fournisseur.';
			|en = 'Select the item from the supplier order lines.';
			|es = 'Elija el artículo entre las líneas del pedido a proveedor.'"));
		ОбновитьТекущийЗаказ();
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
		ПодставитьПоступлениеНакладной(СтрокаТаблицы);
	КонецЕсли;
	ЗаписатьСтрокуПоступленияНаСервере(Элемент.ТекущаяСтрока);
	ПослеЗаписиСтрок();

КонецПроцедуры

// Товар новой строки поступления - строка текущего заказа с остатком: код строки связывает поступление с заказом.
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «Товар» поступлений.
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - отключается.
//
&НаКлиенте
Процедура ПоступленияНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элементы.Поступления.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
		Возврат;
	КонецЕсли;
	Список = СтрокиЗаказаДляПоступления(ТекущийЗаказ);
	Если Список.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'По заказу всё поступило.';
			|fr = 'Tout est reçu pour la commande.'; en = 'Everything has been received for the order.';
			|es = 'Todo el pedido está recibido.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораСтрокиЗаказа", ЭтотОбъект, Элементы.Поступления.ТекущаяСтрока);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТоварыПоступлений

// Переключатель «Документы / Товары» закладки «Поступления».
//
// Параметры:
//  Элемент - ПолеФормы - переключатель.
//
&НаКлиенте
Процедура РежимПоступленийПриИзменении(Элемент)

	УстановитьВидимостьРежимаПоступлений(ЭтотОбъект);
	Если РежимПоступлений = РежимПоступленийТовары() Тогда
		ЗагрузитьТоварыПоступленийНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПоступленийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ОткрытьДокументСтроки(Элемент, Поле, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПоступленийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	УстановитьПравкуЗаписаннойСтрокиТоваров(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПоступленийПередНачаломИзменения(Элемент, Отказ)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаТаблицы.ТолькоПросмотр Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Эта строка правится в форме документа.';
			|fr = 'Cette ligne se modifie dans le formulaire du document.';
			|en = 'This line is edited in the document form.'; es = 'Esta línea se edita en el formulario del documento.'"));
		Возврат;
	КонецЕсли;
	// Товар, поставщик и документ записанной строки не меняются: другой товар - новой строкой.
	УстановитьПравкуЗаписаннойСтрокиТоваров(СтрокаТаблицы.НомерСтроки = 0);

КонецПроцедуры

// Новая строка: поставщик - из отбора или предыдущей строки, документ - «Новое поступление».
//
// Параметры:
//  Элемент     - ТаблицаФормы - строки режима «Товары».
//  НоваяСтрока - Булево - строка добавлена.
//  Копирование - Булево - строка скопирована.
//
&НаКлиенте
Процедура ТоварыПоступленийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если Не НоваяСтрока Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.НомерСтроки = 0;
	СтрокаТаблицы.ВерсияДанных = "";
	СтрокаТаблицы.КодСтрокиОснования = 0;
	СтрокаТаблицы.Сумма = 0;
	СтрокаТаблицы.Статус = "";
	СтрокаТаблицы.СтрокаОснованияПредставление = "";
	СтрокаТаблицы.ТолькоПросмотр = Ложь;
	Если Копирование Тогда
		// Копия - в тот же документ.
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Документ = Неопределено;
	// Склад - по умолчанию для поступлений; по нему строка создаст поступление или приходный ордер (2.0.16.111).
	СкладСтроки = СкладНовойСтрокиТоваров();
	СтрокаТаблицы.Склад = СкладСтроки.Склад;
	СтрокаТаблицы.ДокументПредставление = СкладСтроки.ДокументПредставление;
	Если ЗначениеЗаполнено(ОтборПоставщик) Тогда
		СтрокаТаблицы.Поставщик = ОтборПоставщик;
		Возврат;
	КонецЕсли;
	// Поставщик - как у строки, записанной последней (первая строка страницы - свежий документ).
	Для Каждого Соседняя Из ТоварыПоступлений Цикл
		Если Соседняя <> СтрокаТаблицы И ЗначениеЗаполнено(Соседняя.Поставщик) Тогда
			СтрокаТаблицы.Поставщик = Соседняя.Поставщик;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПоступленийПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	Строки = Новый Массив;
	Незаписанные = Новый Массив;
	Для Каждого Идентификатор Из Элемент.ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТоварыПоступлений.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.ТолькоПросмотр Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаТаблицы.НомерСтроки = 0 Тогда
			Незаписанные.Добавить(СтрокаТаблицы);
		Иначе
			Строки.Добавить(ДанныеСтрокиТоваровПоступлений(СтрокаТаблицы));
		КонецЕсли;
	КонецЦикла;
	// Незаписанная строка удаляется только из таблицы: в базе её нет.
	Для Каждого СтрокаТаблицы Из Незаписанные Цикл
		Если СтрокаТоваровКЗаписи = СтрокаТаблицы.ПолучитьИдентификатор() Тогда
			СтрокаТоваровКЗаписи = Неопределено;
		КонецЕсли;
		ТоварыПоступлений.Удалить(СтрокаТаблицы);
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдаленииТоваровПоступлений", ЭтотОбъект, Строки);
	ПоказатьВопрос(Оповещение, ТекстВопросаОбУдалении(Строки.Количество()), РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

// Запись строки - обработчиком ожидания, а не в самом событии: правка могла закончиться выбором из выпадающего
// списка, а серверный вызов с контекстом, пока список закрывается, роняет клиент 8.5 (урок 2.0.16.106).
//
// Параметры:
//  Элемент              - ТаблицаФормы - строки режима «Товары».
//  НоваяСтрока          - Булево - строка добавлена.
//  ОтменаРедактирования - Булево - правка отменена.
//
&НаКлиенте
Процедура ТоварыПоступленийПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	Если ОтменаРедактирования Или Элемент.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТоваровКЗаписи = Элемент.ТекущаяСтрока;
	ЗадержкаСекунд = 0.1;
	ОтключитьОбработчикОжидания("ЗаписатьСтрокуТоваровПоступленияОжидание");
	ПодключитьОбработчикОжидания("ЗаписатьСтрокуТоваровПоступленияОжидание", ЗадержкаСекунд, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСтрокуТоваровПоступленияОжидание() Экспорт

	Идентификатор = СтрокаТоваровКЗаписи;
	СтрокаТоваровКЗаписи = Неопределено;
	Если Идентификатор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьСтрокуТоваровПоступленияНаСервере(Идентификатор);

КонецПроцедуры

// Документ строки: «Новое поступление» или сегодняшнее поступление (ордер) поставщика строки.
//
// Параметры:
//  Элемент              - ПолеФормы - колонка «Документ».
//  ДанныеВыбора         - СписокЗначений - не используется.
//  СтандартнаяОбработка - Булево - отключается.
//
&НаКлиенте
Процедура ТоварыПоступленийДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Элементы.ТоварыПоступлений.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.НомерСтроки <> 0 Тогда
		Возврат;
	КонецЕсли;
	Список = ДокументыДляСтрокиТоваров(СтрокаТаблицы.Поставщик, СтрокаТаблицы.Склад);
	Список.Вставить(0, Неопределено, ПредставлениеНовогоДокументаСтроки(СтрокаТаблицы.Склад));
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораДокументаСтрокиТоваров", ЭтотОбъект,
		Элементы.ТоварыПоступлений.ТекущаяСтрока);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);

КонецПроцедуры

// Параметры:
//  ВыбранныйЭлемент - ЭлементСпискаЗначений, Неопределено - документ; Неопределено - выбор отменён.
//  Идентификатор    - Число - идентификатор строки.
//
&НаКлиенте
Процедура ПослеВыбораДокументаСтрокиТоваров(ВыбранныйЭлемент, Идентификатор) Экспорт

	СтрокаТаблицы = ТоварыПоступлений.НайтиПоИдентификатору(Идентификатор);
	Если ВыбранныйЭлемент = Неопределено Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Документ = ВыбранныйЭлемент.Значение;
	СтрокаТаблицы.ДокументПредставление = ВыбранныйЭлемент.Представление;
	ОбновитьДанныеТовараНовойСтроки(СтрокаТаблицы);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПоступленийНоменклатураПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.ТоварыПоступлений.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Характеристика прежнего товара для нового недействительна; единица и строка заказа - для просмотра сразу, как в
	// рабочем месте производства (2.0.16.111), цену подставит запись строки.
	СтрокаТаблицы.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	СтрокаТаблицы.ЦенаИзменена = Ложь;
	ОбновитьДанныеТовараНовойСтроки(СтрокаТаблицы);

КонецПроцедуры

// Склад новой строки: документ - новый на этом складе (поступление или приходный ордер), выбранный документ другого
// склада снимается.
//
// Параметры:
//  Элемент - ПолеФормы - колонка «Склад».
//
&НаКлиенте
Процедура ТоварыПоступленийСкладПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.ТоварыПоступлений.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Или СтрокаТаблицы.НомерСтроки <> 0 Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Документ = Неопределено;
	СтрокаТаблицы.ДокументПредставление = ПредставлениеНовогоДокументаСтроки(СтрокаТаблицы.Склад);
	ОбновитьДанныеТовараНовойСтроки(СтрокаТаблицы);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПоступленийПоставщикПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.ТоварыПоступлений.ТекущиеДанные;
	Если СтрокаТаблицы <> Неопределено Тогда
		ОбновитьДанныеТовараНовойСтроки(СтрокаТаблицы);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПоступленийХарактеристикаПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.ТоварыПоступлений.ТекущиеДанные;
	Если СтрокаТаблицы <> Неопределено Тогда
		ОбновитьДанныеТовараНовойСтроки(СтрокаТаблицы);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПоступленийЦенаПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.ТоварыПоступлений.ТекущиеДанные;
	Если СтрокаТаблицы <> Неопределено Тогда
		СтрокаТаблицы.ЦенаИзменена = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОплаты

&НаКлиенте
Процедура ОплатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ОткрытьДокументСтроки(Элемент, Поле, СтандартнаяОбработка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументы

&НаКлиенте
Процедура ДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ОткрытьДокументСтроки(Элемент, Поле, СтандартнаяОбработка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// На закладке «Поступления» - новое поступление без заказа и потребности (на ордерном складе - приходный ордер), на прочих -
// новый заказ поставщику.
//
// Параметры:
//  Команда - КомандаФормы - «Создать».
//
&НаКлиенте
Процедура Создать(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДокумента", ЭтотОбъект);
	ЗначенияЗаполнения = Новый Структура;
	Если ЗначениеЗаполнено(ОтборПоставщик) Тогда
		ЗначенияЗаполнения.Вставить("Контрагент", ОтборПоставщик);
	КонецЕсли;
	// Не «ИмяФормы»: в модуле формы это её свойство только для чтения.
	Если Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаСписокПоступлений Тогда
		ИмяНовойФормы = ИмяФормыНовогоПоступления();
	Иначе
		ИмяНовойФормы = "Документ.ЗаказПоставщику.ФормаОбъекта";
	КонецЕсли;
	ОткрытьФорму(ИмяНовойФормы, Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения), ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

// Подменю «Создать» закладки «Поступления» при включённой опции «Ордерные склады»: поступление.
//
// Параметры:
//  Команда - КомандаФормы - «Создать поступление».
//
&НаКлиенте
Процедура СоздатьПоступление(Команда)

	ОткрытьНовыйДокументПоступления("Документ.ПоступлениеТоваровУслуг.ФормаОбъекта");

КонецПроцедуры

// Подменю «Создать» закладки «Поступления» при включённой опции «Ордерные склады»: приходный ордер.
//
// Параметры:
//  Команда - КомандаФормы - «Создать приходный ордер».
//
&НаКлиенте
Процедура СоздатьПриходныйОрдер(Команда)

	ОткрытьНовыйДокументПоступления("Документ.ПриходныйОрдер.ФормаОбъекта");

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ЗагрузитьСтраницу();
	ОбновитьОткрытуюЗакладку();

КонецПроцедуры

// Заказы поставщикам по отмеченным строкам «Потребности» (решение владельца 10): на каждый заказ клиента и на
// пополнение склада, по поставщику строки.
//
// Параметры:
//  Команда - КомандаФормы - «Заказать».
//
&НаКлиенте
Процедура ЗаказатьПотребность(Команда)

	Если Потребность.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отметьте строки потребности.';
			|fr = 'Cochez les lignes de besoin.'; en = 'Check the need lines.'; es = 'Marque las líneas de necesidad.'"));
		Возврат;
	КонецЕсли;
	ЗаказатьПотребностьНаСервере();
	ЗагрузитьСтраницу();

КонецПроцедуры

// Поступления без заказа поставщику по отмеченным строкам «Потребности»: на каждый заказ клиента по поставщику строки,
// проведённые сразу; затем закладка «Поступления» (план arm-purchasing-receipts-s2, Р3).
//
// Параметры:
//  Команда - КомандаФормы - «Создать поступление».
//
&НаКлиенте
Процедура СоздатьПоступлениеПоПотребности(Команда)

	Если Потребность.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отметьте строки потребности.';
			|fr = 'Cochez les lignes de besoin.'; en = 'Check the need lines.'; es = 'Marque las líneas de necesidad.'"));
		Возврат;
	КонецЕсли;
	ПервыйДокумент = СоздатьПоступлениеПоПотребностиНаСервере();
	ЗагрузитьСтраницу();
	Если ПервыйДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Элементы.ГруппаВерх.ТекущаяСтраница = Элементы.СтраницаСписокПоступлений;
	НомерСтраницыПоступлений = 1;
	// Программная смена закладки ПриСменеСтраницы не вызывает.
	ОбновитьОткрытуюЗакладку(ПервыйДокумент);

КонецПроцедуры

// Черновики предложений выбранным поставщикам по отмеченным строкам одного заказа клиента (решение владельца 11).
//
// Параметры:
//  Команда - КомандаФормы - «Запросить предложения».
//
&НаКлиенте
Процедура ЗапроситьПредложения(Команда)

	Если Потребность.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отметьте строки потребности одного заказа клиента.';
			|fr = 'Cochez les lignes de besoin d''une commande client.'; en = 'Check the need lines of one customer order.';
			|es = 'Marque las líneas de necesidad de un pedido del cliente.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПоставщиковТендера", ЭтотОбъект);
	ПараметрыВыбора = Новый Структура("МножественныйВыбор, ЗакрыватьПриВыборе", Истина, Истина);
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора", ПараметрыВыбора, ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

// Параметры:
//  Результат    - Массив из СправочникСсылка.Контрагенты, СправочникСсылка.Контрагенты, Неопределено - выбранные.
//  ДопПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ПослеВыбораПоставщиковТендера(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Поставщики = ?(ТипЗнч(Результат) = Тип("Массив"), Результат, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Результат));
	ЗапроситьПредложенияНаСервере(Поставщики);

КонецПроцедуры

