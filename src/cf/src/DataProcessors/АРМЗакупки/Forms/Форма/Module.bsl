//  Строка - см. Обработки.АРМПроизводство.ДействиеВРаботу.
//
&НаКлиенте
Функция ДействиеВРаботу()

	Возврат "ВРаботу";

КонецФункции

// Возвращаемое значение:
//  Строка - см. Обработки.АРМПроизводство.ДействиеВЧерновик.
//
&НаКлиенте
Функция ДействиеВЧерновик()

	Возврат "ВЧерновик";

КонецФункции

// Возвращаемое значение:
//  Строка - см. Обработки.АРМПроизводство.ДействиеОтменить.
//
&НаКлиенте
Функция ДействиеОтменить()

	Возврат "Отменить";

КонецФункции

#КонецОбласти

#Область КПоступлению

&НаСервере
Процедура ЗагрузитьКПоступлениюНаСервере()

	КПоступлению.Очистить();
	ТекстПросрочен = НСтр("ru = 'просрочен'; fr = 'en retard'; en = 'overdue'; es = 'vencido'");
	Для Каждого Строка Из Обработки.АРМЗакупки.СтрокиКПоступлению(ОтборыПанели()) Цикл
		НоваяСтрока = КПоступлению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Просрочка = ?(Строка.Просрочен, ТекстПросрочен, "");
	КонецЦикла;
	Если КПоступлению.Количество() >= Обработки.АРМЗакупки.ПределСтрокКПоступлению() Тогда
		Шаблон = НСтр("ru = 'Показаны первые %1 строк: уточните отбор по поставщику или товару.';
			|fr = 'Les %1 premières lignes sont affichées : précisez le filtre par fournisseur ou article.';
			|en = 'The first %1 lines are shown: narrow the filter by supplier or item.';
			|es = 'Se muestran las primeras %1 líneas: precise el filtro por proveedor o artículo.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, КПоступлению.Количество()));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОформитьПоступлениеНаСервере()

	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из КПоступлению.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		Если СтрокаТаблицы.КоличествоУпаковок <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = Новый Структура("Заказ, КодСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок");
		ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
		Строки.Добавить(Строка);
	КонецЦикла;
	Накладная = Новый Структура("Номер, Дата", СокрЛП(НомерНакладной), ДатаНакладной);
	Шаблон = НСтр("ru = '%1: создано %2'; fr = '%1 : créé %2'; en = '%1: created %2'; es = '%1: creado %2'");
	Для Каждого Итог Из Обработки.АРМЗакупки.ОформитьПоступления(Строки, Накладная) Цикл
		Если Итог.Успех Тогда
			Текст = СтрШаблон(Шаблон, Итог.Заказ, Итог.Документ);
			Текст = ?(ПустаяСтрока(Итог.Текст), Текст, СтрШаблон("%1. %2", Текст, Итог.Текст));
		Иначе
			Текст = ?(Итог.Заказ = Неопределено, Итог.Текст, СтрШаблон("%1: %2", Итог.Заказ, Итог.Текст));
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЦикла;
	ЗагрузитьКПоступлениюНаСервере();

КонецПроцедуры

#КонецОбласти

#КонецОбласти
