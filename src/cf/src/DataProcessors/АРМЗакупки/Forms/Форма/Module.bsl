	Шаблон = НСтр("ru = 'Удалить выделенные строки (%1)? Документ без строк будет помечен на удаление.';
		|fr = 'Supprimer les lignes sélectionnées (%1) ? Un document sans lignes sera marqué pour suppression.';
		|en = 'Delete the selected lines (%1)? A document without lines will be marked for deletion.';
		|es = '¿Eliminar las líneas seleccionadas (%1)? Un documento sin líneas se marcará para eliminar.'");
	Возврат СтрШаблон(Шаблон, Количество);

КонецФункции

