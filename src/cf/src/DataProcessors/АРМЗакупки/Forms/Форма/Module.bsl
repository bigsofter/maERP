// Закладка «Поступления»: «Документы» - список документов, «Товары» - их строки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма рабочего места.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРежимаПоступлений(Форма)

	Если Форма.РежимПоступлений <> РежимПоступленийТовары() Тогда
		Форма.РежимПоступлений = 1;
	КонецЕсли;
	Товарами = Форма.РежимПоступлений = РежимПоступленийТовары();
	Форма.Элементы.СписокПоступлений.Видимость = Не Товарами;
	Форма.Элементы.ТоварыПоступлений.Видимость = Товарами;

