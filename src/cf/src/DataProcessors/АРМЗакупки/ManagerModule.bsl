//  Число - верхняя граница размера страницы, пришедшего с клиента.
//
Функция МаксимумСтраницы()

	Возврат 200;

КонецФункции

// Данные строки общего пути ввода по текущему заказу поставщику: закупочный контекст, поставщик и заказ клиента - из
// заказа; у заказа поставщику - сам заказ документом строки, у поступления - заказ основанием.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПоставщику - текущий заказ.
//  Вид   - Строка - см. Обработки.АРМПроизводство.ВидЗаказПоставщику, ВидПоступление.
//
// Возвращаемое значение:
//  Структура, Неопределено - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента; заказ не задан - Неопределено.
//
Функция ДанныеСтрокиЗаказа(Заказ, Вид)

	Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказПоставщику") Или Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента();
	ДанныеСтроки.Вид = Вид;
	ДанныеСтроки.КонтекстЗаказПоставщику = Истина;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "Контрагент, Основание");
	ДанныеСтроки.Поставщик = Реквизиты.Контрагент;
	Если ТипЗнч(Реквизиты.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ДанныеСтроки.Заказ = Реквизиты.Основание;
	КонецЕсли;
	Если Вид = Обработки.АРМПроизводство.ВидПоступление() Тогда
		ДанныеСтроки.ЗаказПоставщику = Заказ;
	Иначе
		ДанныеСтроки.Документ = Заказ;
	КонецЕсли;
	Возврат ДанныеСтроки;

КонецФункции

// Реквизиты текущего заказа для ввода строк и запреты ввода - чтобы форма не открывала на правку то, что сервер отклонит.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПоставщику - текущий заказ.
//
// Возвращаемое значение:
//  Структура:
//   * ВерсияДанных            - Строка - версия заказа.
//   * ТекстЗапретаТоваров     - Строка - почему строки заказа только для просмотра; пустая - правятся.
//   * ТекстЗапретаПоступлений - Строка - почему поступления по заказу не вводятся; пустая - вводятся.
//
Функция ШапкаЗаказа(Заказ)

	Шапка = Новый Структура("ВерсияДанных, ТекстЗапретаТоваров, ТекстЗапретаПоступлений", "", "", "");
	ПробаТоваров = ДанныеСтрокиЗаказа(Заказ, Обработки.АРМПроизводство.ВидЗаказПоставщику());
	Если ПробаТоваров = Неопределено Тогда
		Возврат Шапка;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "ВерсияДанных, Проведен");
	Шапка.ВерсияДанных = Реквизиты.ВерсияДанных;
	// Проба удалением: права, заказ клиента, пометка и перенос строк проверяются, значения строки - нет.
	Шапка.ТекстЗапретаТоваров = Обработки.АРМПроизводство.ТекстЗапретаСтрокиДокумента(ПробаТоваров, Истина);
	ПробаПоступлений = ДанныеСтрокиЗаказа(Заказ, Обработки.АРМПроизводство.ВидПоступление());
	Текст = Обработки.АРМПроизводство.ТекстЗапретаСтрокиДокумента(ПробаПоступлений, Истина);
	Если ПустаяСтрока(Текст) И Не Реквизиты.Проведен Тогда
		Текст = НСтр("ru = 'Поступления вводятся по проведённому заказу: переведите заказ «В работу».';
			|fr = 'Les réceptions se saisissent sur une commande validée : passez la commande « En cours ».';
			|en = 'Receipts are entered for a posted order: set the order to ""In progress"".';
			|es = 'Las recepciones se introducen para un pedido contabilizado: pase el pedido a «En curso».'");
	КонецЕсли;
	Шапка.ТекстЗапретаПоступлений = Текст;
	Возврат Шапка;

КонецФункции

// Возвращаемое значение:
//  Структура - Успех (Ложь), Текст - отказ по неверным данным с клиента.
//
Функция РезультатНеверныхДанных()

	Текст = НСтр("ru = 'Неверные данные строки: обновите рабочее место.';
		|fr = 'Données de ligne incorrectes : actualisez le poste de travail.';
		|en = 'Invalid line data: refresh the workstation.'; es = 'Datos de línea incorrectos: actualice el puesto de trabajo.'");
	Возврат Новый Структура("Успех, Текст", Ложь, Текст);

КонецФункции

// Параметры:
//  Заказ     - ДокументСсылка.ЗаказПоставщику, Неопределено - заказ поступления; не определён - отказ до записи.
//  Результат - Структура - Успех, Текст и, если записано, Документ.
//
// Возвращаемое значение:
//  Структура - Заказ, Успех, Текст, Документ - итог оформления по заказу.
//
Функция ИтогПоступления(Заказ, Результат)

	Итог = Новый Структура;
	Итог.Вставить("Заказ", Заказ);
	Итог.Вставить("Успех", Результат.Успех);
	Итог.Вставить("Текст", Результат.Текст);
	Итог.Вставить("Документ", ?(Результат.Свойство("Документ"), Результат.Документ, Неопределено));
	Возврат Итог;

КонецФункции

// Параметры:
//  СтрокиДанных - Массив из Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента, удаляемые строки.
//
// Возвращаемое значение:
//  Структура - Успех (по всем документам), Текст - тексты отказов и сообщений документов.
//
Функция ИтогУдаления(СтрокиДанных)

	Итог = Новый Структура("Успех, Текст", Истина, "");
	Тексты = Новый Массив;
	Для Каждого Результат Из Обработки.АРМПроизводство.УдалитьСтрокиДокументов(СтрокиДанных) Цикл
		Итог.Успех = Итог.Успех И Результат.Успех;
		Если Не ПустаяСтрока(Результат.Текст) Тогда
			Тексты.Добавить(Результат.Текст);
		КонецЕсли;
	КонецЦикла;
	Итог.Текст = СтрСоединить(Тексты, Символы.ПС);
	Возврат Итог;

КонецФункции

// Параметры:
//  ПоЗаказам - Соответствие из КлючИЗначение - ключ - заказ поставщику отмеченных строк.
//
// Возвращаемое значение:
//  Строка - текст запрета, если отмечены строки разных поставщиков; пустая строка - поставщик один.
//
Функция ТекстЗапретаПоставщиковПоступления(ПоЗаказам)

	Заказы = Новый Массив;
	Для Каждого ЗаказИСтроки Из ПоЗаказам Цикл
		Заказы.Добавить(ЗаказИСтроки.Ключ);
	КонецЦикла;
	Если Заказы.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Отметьте строки к поступлению.'; fr = 'Cochez les lignes à réceptionner.';
			|en = 'Check the lines to receive.'; es = 'Marque las líneas a recibir.'");
	КонецЕсли;
	Поставщики = Новый Массив;
	Для Каждого ЗаказИРеквизиты Из ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Заказы, "Контрагент") Цикл
		Если Поставщики.Найти(ЗаказИРеквизиты.Значение.Контрагент) = Неопределено Тогда
			Поставщики.Добавить(ЗаказИРеквизиты.Значение.Контрагент);
		КонецЕсли;
	КонецЦикла;
	Если Поставщики.Количество() > 1 Тогда
		Возврат НСтр("ru = 'Отметьте строки одного поставщика: накладная - от одного поставщика.';
			|fr = 'Cochez les lignes d''un seul fournisseur : la facture vient d''un seul fournisseur.';
			|en = 'Check lines of one supplier: an invoice comes from one supplier.';
			|es = 'Marque líneas de un solo proveedor: la factura es de un solo proveedor.'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Возвращаемое значение:
//  Строка - пакет: остатки регистра «Заказы поставщикам» по строкам с условием &УсловиеОстатков за вычетом черновиков
//           поступлений и непроведённых заказов, забирающих строку (как в проверке пакета поступления), строки
//           проведённых непомеченных заказов (кроме предварительных) с условием &УсловиеПоставщика, первые 500 по
//           поставщику и дате поставки; Коэффициент - единиц в упаковке строки.
//
Функция ТекстЗапросаКПоступлению()

	Возврат
	"ВЫБРАТЬ
	|	Остатки.ЗаказПоставщику КАК Заказ,
	|	Остатки.КодСтроки КАК КодСтроки,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(, &УсловиеОстатков) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстатки.Заказ КАК Заказ,
	|	ВТОстатки.КодСтроки КАК КодСтроки,
	|	ВТОстатки.Номенклатура КАК Номенклатура,
	|	ВТОстатки.Характеристика КАК Характеристика,
	|	ВТОстатки.Количество КАК Количество
	|ПОМЕСТИТЬ ВТДвижения
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Поступления.Основание,
	|	ТоварыПоступлений.КодСтроки,
	|	ТоварыПоступлений.Номенклатура,
	|	ТоварыПоступлений.Характеристика,
	|	-ТоварыПоступлений.Количество
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК Поступления
	|		ПО ВТОстатки.Заказ = Поступления.Основание
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК ТоварыПоступлений
	|		ПО Поступления.Ссылка = ТоварыПоступлений.Ссылка
	|			И ВТОстатки.КодСтроки = ТоварыПоступлений.КодСтроки
	|			И ВТОстатки.Номенклатура = ТоварыПоступлений.Номенклатура
	|			И ВТОстатки.Характеристика = ТоварыПоступлений.Характеристика
	|ГДЕ
	|	НЕ Поступления.Проведен
	|	И НЕ Поступления.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыПереноса.ЗаказПоставщику,
	|	ТоварыПереноса.КодСтроки,
	|	ТоварыПереноса.Номенклатура,
	|	ТоварыПереноса.Характеристика,
	|	-ТоварыПереноса.Количество
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.ТЧТовары КАК ТоварыПереноса
	|		ПО ВТОстатки.Заказ = ТоварыПереноса.ЗаказПоставщику
	|			И ВТОстатки.КодСтроки = ТоварыПереноса.КодСтроки
	|			И ВТОстатки.Номенклатура = ТоварыПереноса.Номенклатура
	|			И ВТОстатки.Характеристика = ТоварыПереноса.Характеристика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Переносы
	|		ПО ТоварыПереноса.Ссылка = Переносы.Ссылка
	|ГДЕ
	|	НЕ Переносы.Проведен
	|	И НЕ Переносы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДвижения.Заказ КАК Заказ,
	|	ВТДвижения.КодСтроки КАК КодСтроки,
	|	ВТДвижения.Номенклатура КАК Номенклатура,
	|	ВТДвижения.Характеристика КАК Характеристика,
	|	СУММА(ВТДвижения.Количество) КАК Осталось
	|ПОМЕСТИТЬ ВТОсталось
	|ИЗ
	|	ВТДвижения КАК ВТДвижения
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТДвижения.Заказ,
	|	ВТДвижения.КодСтроки,
	|	ВТДвижения.Номенклатура,
	|	ВТДвижения.Характеристика
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВТДвижения.Количество) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	Заказы.Контрагент КАК Поставщик,
	|	ВТОсталось.Заказ КАК Заказ,
	|	Заказы.Номер КАК Номер,
	|	Заказы.Дата КАК Дата,
	|	Заказы.ДатаПоставки КАК ДатаПоставки,
	|	ВЫБОР
	|		КОГДА Заказы.ДатаПоставки > ДАТАВРЕМЯ(1, 1, 1)
	|				И Заказы.ДатаПоставки < &НачалоДня
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Просрочен,
	|	ВТОсталось.КодСтроки КАК КодСтроки,
	|	ВТОсталось.Номенклатура КАК Номенклатура,
	|	ВТОсталось.Характеристика КАК Характеристика,
	|	МАКСИМУМ(Товары.Упаковка) КАК Упаковка,
	|	МАКСИМУМ(Позиции.Единица) КАК Единица,
	|	ВТОсталось.Осталось КАК Осталось,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Товары.КоличествоУпаковок = 0
	|					ИЛИ Товары.Количество = 0
	|				ТОГДА 1
	|			ИНАЧЕ Товары.Количество / Товары.КоличествоУпаковок
	|		КОНЕЦ) КАК Коэффициент
	|ИЗ
	|	ВТОсталось КАК ВТОсталось
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказы
	|		ПО ВТОсталось.Заказ = Заказы.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.ТЧТовары КАК Товары
	|		ПО ВТОсталось.Заказ = Товары.Ссылка
	|			И ВТОсталось.КодСтроки = Товары.КодСтроки
	|			И ВТОсталось.Номенклатура = Товары.Номенклатура
	|			И ВТОсталось.Характеристика = Товары.Характеристика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Позиции
	|		ПО ВТОсталось.Номенклатура = Позиции.Ссылка
	|ГДЕ
	|	Заказы.Проведен
	|	И НЕ Заказы.ПометкаУдаления
	|	И Заказы.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовПоставщику.Предварительный)
	|	И &УсловиеПоставщика
	|
	|СГРУППИРОВАТЬ ПО
	|	Заказы.Контрагент,
	|	ВТОсталось.Заказ,
	|	Заказы.Номер,
	|	Заказы.Дата,
	|	Заказы.ДатаПоставки,
	|	ВТОсталось.КодСтроки,
	|	ВТОсталось.Номенклатура,
	|	ВТОсталось.Характеристика,
	|	ВТОсталось.Осталось
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поставщик,
	|	ДатаПоставки,
	|	Дата,
	|	КодСтроки";

КонецФункции

// Возвращаемое значение:
//  Структура - строка таблицы «Заказы» формы.
//
Функция НоваяСтрокаЗаказа()

	Возврат Новый Структура("Заказ, Номер, Дата, Поставщик, Статус, Индикатор, ДатаПоставки, Сумма, Валюта, ЗаказКлиента,
		|Ответственный, ВидЗаказа");

КонецФункции

// Пакет: ВТЗаказы - заказы по отборам панели, ВТДвижения - заказано, пришло и остаток по регистру, ВТСтатусы -
// вычисляемый статус. «Пришло» - расход регистраторами поступлений и возвратов (у возврата количество уже
// отрицательное), а не нулевой остаток: строки, забранные другим заказом поставщику, - «перенесено». Условия отборов
// вставляются в текст только для заполненных отборов, параметры ставятся в запрос.
//
// Параметры:
//  Запрос - Запрос - запрос, которому ставятся параметры отборов.
//  Отборы - Структура - см. НовыеОтборы.
//
// Возвращаемое значение:
//  Строка - текст пакета.
//
Функция ТекстЗапросаСтатусов(Запрос, Отборы)

	Условия = Новый Массив;
	Если ТипЗнч(Отборы.Поставщик) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Отборы.Поставщик) Тогда
		Условия.Добавить("Заказы.Контрагент = &Поставщик");
		Запрос.УстановитьПараметр("Поставщик", Отборы.Поставщик);
	КонецЕсли;
	Если ТипЗнч(Отборы.Ответственный) = Тип("СправочникСсылка.Пользователи") И ЗначениеЗаполнено(Отборы.Ответственный) Тогда
		Условия.Добавить("Заказы.Ответственный = &Ответственный");
		Запрос.УстановитьПараметр("Ответственный", Отборы.Ответственный);
	КонецЕсли;
	Если ТипЗнч(Отборы.ВидЗаказа) = Тип("ПеречислениеСсылка.ВидыЗаказовПоставщику") И ЗначениеЗаполнено(Отборы.ВидЗаказа) Тогда
		Условия.Добавить("Заказы.ВидЗаказа = &ВидЗаказа");
		Запрос.УстановитьПараметр("ВидЗаказа", Отборы.ВидЗаказа);
	Иначе
		Условия.Добавить("Заказы.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовПоставщику.Предварительный)");
	КонецЕсли;
	Если ТипЗнч(Отборы.ПериодПоставки) = Тип("СтандартныйПериод") Тогда
		Если ЗначениеЗаполнено(Отборы.ПериодПоставки.ДатаНачала) Тогда
			Условия.Добавить("Заказы.ДатаПоставки >= &НачалоПоставки");
			Запрос.УстановитьПараметр("НачалоПоставки", Отборы.ПериодПоставки.ДатаНачала);
		КонецЕсли;
		Если ЗначениеЗаполнено(Отборы.ПериодПоставки.ДатаОкончания) Тогда
			Условия.Добавить("Заказы.ДатаПоставки МЕЖДУ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 1) И &КонецПоставки");
			Запрос.УстановитьПараметр("КонецПоставки", Отборы.ПериодПоставки.ДатаОкончания);
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Отборы.Товар) = Тип("СправочникСсылка.Номенклатура") И ЗначениеЗаполнено(Отборы.Товар) Тогда
		Условия.Добавить("Заказы.Ссылка В
		|			(ВЫБРАТЬ
		|				ТоварыОтбора.Ссылка КАК Ссылка
		|			ИЗ
		|				Документ.ЗаказПоставщику.ТЧТовары КАК ТоварыОтбора
		|			ГДЕ
		|				ТоварыОтбора.Номенклатура = &Товар)");
		Запрос.УстановитьПараметр("Товар", Отборы.Товар);
	КонецЕсли;
	// Граница просрочки берётся при каждом чтении страницы, а не при открытии формы: после полуночи статус не отстаёт.
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДатаСеанса()));

	Текст =
	"ВЫБРАТЬ
	|	Заказы.Ссылка КАК Ссылка,
	|	Заказы.Дата КАК Дата,
	|	Заказы.ДатаПоставки КАК ДатаПоставки,
	|	Заказы.Проведен КАК Проведен,
	|	Заказы.ПометкаУдаления КАК ПометкаУдаления
	|ПОМЕСТИТЬ ВТЗаказы
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Заказы
	|ГДЕ
	|	&УсловиеЗаказов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	Движения.ЗаказПоставщику КАК Заказ,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Заказано,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					И (Движения.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|						ИЛИ Движения.Регистратор ССЫЛКА Документ.ВозвратПоставщику)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Пришло,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ -Движения.Количество
	|		КОНЕЦ) КАК Остаток
	|ПОМЕСТИТЬ ВТДвижения
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам КАК Движения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗаказы КАК ЗаказыДвижений
	|		ПО Движения.ЗаказПоставщику = ЗаказыДвижений.Ссылка
	|ГДЕ
	|	Движения.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.ЗаказПоставщику
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|ВЫБРАТЬ
	|	Заказы.Ссылка КАК Ссылка,
	|	Заказы.Дата КАК Дата,
	|	ЕСТЬNULL(Движения.Заказано, 0) КАК Заказано,
	|	ЕСТЬNULL(Движения.Пришло, 0) КАК Пришло,
	|	ВЫБОР
	|		КОГДА Заказы.ПометкаУдаления
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.Отменен)
	|		КОГДА НЕ Заказы.Проведен
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.Черновик)
	|		КОГДА ЕСТЬNULL(Движения.Заказано, 0) = 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.ОжидаетПоставки)
	|		КОГДА ЕСТЬNULL(Движения.Остаток, 0) <= 0
	|				И ЕСТЬNULL(Движения.Пришло, 0) > 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.Поступил)
	|		КОГДА ЕСТЬNULL(Движения.Остаток, 0) <= 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.Перенесен)
	|		КОГДА Заказы.ДатаПоставки > ДАТАВРЕМЯ(1, 1, 1)
	|				И Заказы.ДатаПоставки < &НачалоДня
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.Просрочен)
	|		КОГДА ЕСТЬNULL(Движения.Пришло, 0) > 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.ЧастичноПоступил)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.ОжидаетПоставки)
	|	КОНЕЦ КАК Статус
	|ПОМЕСТИТЬ ВТСтатусы
	|ИЗ
	|	ВТЗаказы КАК Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДвижения КАК Движения
	|		ПО Заказы.Ссылка = Движения.Заказ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Статус";
	// Условия подставляются на место параметра-заглушки: текст запроса остаётся разбираемым конструктором.
	УсловиеЗаказов = СтрСоединить(Условия, "
		|	И ");
	Возврат СтрЗаменить(Текст, "&УсловиеЗаказов", УсловиеЗаказов);

КонецФункции

// Запрос с временными таблицами оплат по заказам: ВТПоступления - проведённые поступления заказов в основной валюте за
// вычетом проведённых возвратов поставщику по ним (иначе рассчитанный заказ с возвратом остался бы «оплачен частично»),
// ВТПокрытие - доли поступлений в проведённых налоговых накладных покупки, ВТПлатежи - платежи поставщику по
// поступлениям и накладным (списание - плюс, возврат денег - минус), ВТОплатыПоступлений - оплачено по поступлению:
// свои платежи плюс доля платежей прямо на накладную.
//
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказПоставщику - заказы.
//
// Возвращаемое значение:
//  Запрос - запрос с менеджером временных таблиц.
//
Функция ЗапросОплат(Заказы)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Возвраты.Основание КАК Поступление,
	|	СУММА(ВЫРАЗИТЬ(Возвраты.Сумма * ВЫБОР
	|				КОГДА Возвраты.КурсВалюты > 0
	|					ТОГДА Возвраты.КурсВалюты
	|				ИНАЧЕ 1
	|			КОНЕЦ КАК ЧИСЛО(15, 2))) КАК Сумма
	|ПОМЕСТИТЬ ВТВозвраты
	|ИЗ
	|	Документ.ВозвратПоставщику КАК Возвраты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступленияВозвратов
	|		ПО Возвраты.Основание = ПоступленияВозвратов.Ссылка
	|ГДЕ
	|	Возвраты.Проведен
	|	И ПоступленияВозвратов.Основание В (&Заказы)
	|
	|СГРУППИРОВАТЬ ПО
	|	Возвраты.Основание
	|;
	|
	|ВЫБРАТЬ
	|	Поступления.Ссылка КАК Поступление,
	|	Поступления.Основание КАК Заказ,
	|	Поступления.СуммаРегл - ЕСТЬNULL(ВозвратыПоступлений.Сумма, 0) КАК Сумма
	|ПОМЕСТИТЬ ВТПоступления
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВозвраты КАК ВозвратыПоступлений
	|		ПО Поступления.Ссылка = ВозвратыПоступлений.Поступление
	|ГДЕ
	|	Поступления.Основание В (&Заказы)
	|	И Поступления.Проведен
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Поступление
	|;
	|
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Накладная
	|ПОМЕСТИТЬ ВТНакладныеВсе
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоступления КАК ПоступленияТоваров
	|		ПО Товары.ПоступлениеТовара = ПоступленияТоваров.Поступление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Услуги.Ссылка
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка.ТЧУслуги КАК Услуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоступления КАК ПоступленияУслуг
	|		ПО Услуги.ПоступлениеТовара = ПоступленияУслуг.Поступление
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НакладныеВсе.Накладная КАК Накладная
	|ПОМЕСТИТЬ ВТНакладные
	|ИЗ
	|	ВТНакладныеВсе КАК НакладныеВсе
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НалоговаяНакладнаяПокупка КАК Накладные
	|		ПО НакладныеВсе.Накладная = Накладные.Ссылка
	|ГДЕ
	|	Накладные.Проведен
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Накладная
	|;
	|
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Накладная,
	|	Товары.ПоступлениеТовара КАК Поступление,
	|	Товары.СуммаСНДС КАК Сумма
	|ПОМЕСТИТЬ ВТСтрокиНакладныхВсе
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНакладные КАК НакладныеТоваров
	|		ПО Товары.Ссылка = НакладныеТоваров.Накладная
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Услуги.Ссылка,
	|	Услуги.ПоступлениеТовара,
	|	Услуги.СуммаСНДС
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка.ТЧУслуги КАК Услуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНакладные КАК НакладныеУслуг
	|		ПО Услуги.Ссылка = НакладныеУслуг.Накладная
	|;
	|
	|ВЫБРАТЬ
	|	СтрокиВсе.Накладная КАК Накладная,
	|	СтрокиВсе.Поступление КАК Поступление,
	|	СУММА(СтрокиВсе.Сумма) КАК Покрытие
	|ПОМЕСТИТЬ ВТСтрокиНакладных
	|ИЗ
	|	ВТСтрокиНакладныхВсе КАК СтрокиВсе
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиВсе.Накладная,
	|	СтрокиВсе.Поступление
	|;
	|
	|ВЫБРАТЬ
	|	СтрокиИтог.Накладная КАК Накладная,
	|	СУММА(СтрокиИтог.Покрытие) КАК Покрытие
	|ПОМЕСТИТЬ ВТИтогиНакладных
	|ИЗ
	|	ВТСтрокиНакладных КАК СтрокиИтог
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиИтог.Накладная
	|;
	|
	|ВЫБРАТЬ
	|	Строки.Накладная КАК Накладная,
	|	Строки.Поступление КАК Поступление,
	|	Строки.Покрытие КАК Покрытие,
	|	Итоги.Покрытие КАК ВсегоПокрыто
	|ПОМЕСТИТЬ ВТПокрытие
	|ИЗ
	|	ВТСтрокиНакладных КАК Строки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТИтогиНакладных КАК Итоги
	|		ПО Строки.Накладная = Итоги.Накладная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоступления КАК ПоступленияПокрытия
	|		ПО Строки.Поступление = ПоступленияПокрытия.Поступление
	|;
	|
	|ВЫБРАТЬ
	|	ПоступленияОплат.Поступление КАК Объект
	|ПОМЕСТИТЬ ВТОбъектыОплат
	|ИЗ
	|	ВТПоступления КАК ПоступленияОплат
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НакладныеОплат.Накладная
	|ИЗ
	|	ВТНакладные КАК НакладныеОплат
	|;
	|
	|ВЫБРАТЬ
	|	Касса.Период КАК Период,
	|	Касса.Регистратор КАК Регистратор,
	|	Касса.ДокументПродажи КАК ДокументПродажи,
	|	ВЫБОР
	|		КОГДА Касса.ТипДвижения = ЗНАЧЕНИЕ(Перечисление.ТипыДвиженияДенежныхСредств.Поступление)
	|			ТОГДА -Касса.СуммаОборот
	|		ИНАЧЕ Касса.СуммаОборот
	|	КОНЕЦ КАК Сумма
	|ПОМЕСТИТЬ ВТПлатежи
	|ИЗ
	|	РегистрНакопления.ДвиженияПоКассе.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			ДокументПродажи В
	|				(ВЫБРАТЬ
	|					ОбъектыОплат.Объект КАК Объект
	|				ИЗ
	|					ВТОбъектыОплат КАК ОбъектыОплат)) КАК Касса
	|;
	|
	|ВЫБРАТЬ
	|	Доли.Поступление КАК Поступление,
	|	СУММА(Доли.Оплачено) КАК Оплачено
	|ПОМЕСТИТЬ ВТОплатыПоступлений
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПоступленияПлатежей.Поступление КАК Поступление,
	|		Платежи.Сумма КАК Оплачено
	|	ИЗ
	|		ВТПлатежи КАК Платежи
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоступления КАК ПоступленияПлатежей
	|			ПО Платежи.ДокументПродажи = ПоступленияПлатежей.Поступление
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ДолиПокрытия.Поступление,
	|		ВЫБОР
	|			КОГДА ДолиПокрытия.ВсегоПокрыто = 0
	|				ТОГДА 0
	|			ИНАЧЕ ВЫРАЗИТЬ(Платежи.Сумма * ДолиПокрытия.Покрытие / ДолиПокрытия.ВсегоПокрыто КАК ЧИСЛО(15, 2))
	|		КОНЕЦ
	|	ИЗ
	|		ВТПлатежи КАК Платежи
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПокрытие КАК ДолиПокрытия
	|			ПО Платежи.ДокументПродажи = ДолиПокрытия.Накладная) КАК Доли
	|
	|СГРУППИРОВАТЬ ПО
	|	Доли.Поступление";
	Запрос.Выполнить();
	Возврат Запрос;

КонецФункции

// Возвращаемое значение:
//  Строка - строки заказа &Заказ: заказано по строке, пришло поступлениями за вычетом возвратов, остаток.
//
Функция ТекстЗапросаТоваров()

	Возврат
	"ВЫБРАТЬ
	|	Движения.Номенклатура КАК Номенклатура,
	|	Движения.Характеристика КАК Характеристика,
	|	Движения.КодСтроки КАК КодСтроки,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					И (Движения.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|						ИЛИ Движения.Регистратор ССЫЛКА Документ.ВозвратПоставщику)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Пришло,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ -Движения.Количество
	|		КОНЕЦ) КАК Осталось
	|ПОМЕСТИТЬ ВТДвиженияСтрок
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам КАК Движения
	|ГДЕ
	|	Движения.Активность
	|	И Движения.ЗаказПоставщику = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.Номенклатура,
	|	Движения.Характеристика,
	|	Движения.КодСтроки
	|;
	|
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Количество КАК Заказано,
	|	ЕСТЬNULL(Движения.Пришло, 0) КАК Пришло,
	|	ВЫБОР
	|		КОГДА Заказы.Проведен
	|			ТОГДА ЕСТЬNULL(Движения.Осталось, 0)
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ КАК Осталось,
	|	Товары.Цена КАК Цена,
	|	Товары.СуммаСНДС КАК Сумма,
	|	Товары.Продукция КАК Продукция
	|ИЗ
	|	Документ.ЗаказПоставщику.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказы
	|		ПО Товары.Ссылка = Заказы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДвиженияСтрок КАК Движения
	|		ПО Товары.Номенклатура = Движения.Номенклатура
	|			И Товары.Характеристика = Движения.Характеристика
	|			И Товары.КодСтроки = Движения.КодСтроки
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки";

КонецФункции

// Возвращаемое значение:
//  Строка - строки поступлений по заказу &Заказ, в том числе черновиков и помеченных.
//
Функция ТекстЗапросаПоступлений()

	Возврат
	"ВЫБРАТЬ
	|	Поступления.Ссылка КАК Документ,
	|	Поступления.Дата КАК Дата,
	|	Поступления.ВерсияДанных КАК ВерсияДанных,
	|	Поступления.НомерВходящегоДокумента КАК НомерНакладной,
	|	Поступления.ДатаВходящегоДокумента КАК ДатаНакладной,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Количество КАК Количество,
	|	Товары.СуммаСНДС КАК Сумма,
	|	Поступления.Проведен КАК Проведен,
	|	Поступления.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК Товары
	|		ПО Поступления.Ссылка = Товары.Ссылка
	|ГДЕ
	|	Поступления.Основание = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поступления.Дата,
	|	Поступления.Ссылка,
	|	Товары.НомерСтроки";

КонецФункции

// Возвращаемое значение:
//  Строка - платежи поставщику по поступлениям заказа и по налоговым накладным, покрывающим эти поступления.
//
Функция ТекстЗапросаПлатежей()

	Возврат
	"ВЫБРАТЬ
	|	Платежи.Регистратор КАК Документ,
	|	Платежи.Период КАК Дата,
	|	Платежи.ДокументПродажи КАК Основание,
	|	Платежи.Сумма КАК Сумма
	|ИЗ
	|	ВТПлатежи КАК Платежи
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

КонецФункции

// Возвращаемое значение:
//  Строка - документы цепочки заказа &Заказ: сам заказ, поступления, возвраты по ним, налоговые накладные и платежи.
//
Функция ТекстЗапросаДокументов()

	Возврат
	"ВЫБРАТЬ
	|	Заказы.Ссылка КАК Документ,
	|	Заказы.Номер КАК Номер,
	|	Заказы.Дата КАК Дата,
	|	Заказы.Сумма КАК Сумма,
	|	Заказы.Проведен КАК Проведен,
	|	Заказы.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Заказы
	|ГДЕ
	|	Заказы.Ссылка = &Заказ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Поступления.Ссылка,
	|	Поступления.Номер,
	|	Поступления.Дата,
	|	Поступления.Сумма,
	|	Поступления.Проведен,
	|	Поступления.ПометкаУдаления
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|ГДЕ
	|	Поступления.Основание = &Заказ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Возвраты.Ссылка,
	|	Возвраты.Номер,
	|	Возвраты.Дата,
	|	Возвраты.Сумма,
	|	Возвраты.Проведен,
	|	Возвраты.ПометкаУдаления
	|ИЗ
	|	Документ.ВозвратПоставщику КАК Возвраты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступленияВозвратов
	|		ПО Возвраты.Основание = ПоступленияВозвратов.Ссылка
	|ГДЕ
	|	ПоступленияВозвратов.Основание = &Заказ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Накладные.Ссылка,
	|	Накладные.Номер,
	|	Накладные.Дата,
	|	Накладные.Сумма,
	|	Накладные.Проведен,
	|	Накладные.ПометкаУдаления
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка КАК Накладные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНакладные КАК НакладныеЗаказа
	|		ПО Накладные.Ссылка = НакладныеЗаказа.Накладная
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Списания.Ссылка,
	|	Списания.Номер,
	|	Списания.Дата,
	|	Списания.Сумма,
	|	Списания.Проведен,
	|	Списания.ПометкаУдаления
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств КАК Списания
	|ГДЕ
	|	Списания.Ссылка В
	|			(ВЫБРАТЬ
	|				ПлатежиСписаний.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТПлатежи КАК ПлатежиСписаний)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Расходники.Ссылка,
	|	Расходники.Номер,
	|	Расходники.Дата,
	|	Расходники.Сумма,
	|	Расходники.Проведен,
	|	Расходники.ПометкаУдаления
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК Расходники
	|ГДЕ
	|	Расходники.Ссылка В
	|			(ВЫБРАТЬ
	|				ПлатежиРасходников.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТПлатежи КАК ПлатежиРасходников)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступленияДенег.Ссылка,
	|	ПоступленияДенег.Номер,
	|	ПоступленияДенег.Дата,
	|	ПоступленияДенег.Сумма,
	|	ПоступленияДенег.Проведен,
	|	ПоступленияДенег.ПометкаУдаления
	|ИЗ
	|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК ПоступленияДенег
	|ГДЕ
	|	ПоступленияДенег.Ссылка В
	|			(ВЫБРАТЬ
	|				ПлатежиПоступлений.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТПлатежи КАК ПлатежиПоступлений)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Приходники.Ссылка,
	|	Приходники.Номер,
	|	Приходники.Дата,
	|	Приходники.Сумма,
	|	Приходники.Проведен,
	|	Приходники.ПометкаУдаления
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК Приходники
	|ГДЕ
	|	Приходники.Ссылка В
	|			(ВЫБРАТЬ
	|				ПлатежиПриходников.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТПлатежи КАК ПлатежиПриходников)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

КонецФункции

// Возвращаемое значение:
//  Строка - остаток расчётов с поставщиком по организации, контрагенту и договору заказа &Заказ.
//
Функция ТекстЗапросаСальдо()

	Возврат
	"ВЫБРАТЬ
	|	Расчеты.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПоставщиками.Остатки(
	|			,
	|			(Организация, Контрагент, Договор) В
	|				(ВЫБРАТЬ
	|					Заказы.Организация КАК Организация,
	|					Заказы.Контрагент КАК Контрагент,
	|					Заказы.Договор КАК Договор
	|				ИЗ
	|					Документ.ЗаказПоставщику КАК Заказы
	|				ГДЕ
	|					Заказы.Ссылка = &Заказ)) КАК Расчеты";

КонецФункции

// Параметры:
//  Статус   - ПеречислениеСсылка.СтатусыЗаказовПоставщику - статус заказа.
//  Заказано - Число - заказано по проведённому заказу.
//  Пришло   - Число - пришло поступлениями за вычетом возвратов.
//
// Возвращаемое значение:
//  Строка - кружок поставки: ○ ничего, ◐ часть, ● всё.
//
Функция КружокПоставки(Статус, Заказано, Пришло)

	Если Статус = Перечисления.СтатусыЗаказовПоставщику.Черновик
		Или Статус = Перечисления.СтатусыЗаказовПоставщику.Отменен
		Или Пришло <= 0 Тогда
		Кружок = КружокНет();
	ИначеЕсли Пришло >= Заказано Или Статус = Перечисления.СтатусыЗаказовПоставщику.Поступил Тогда
		// «Поступил» и при остатке, перенесённом в другой заказ: кружок совпадает со статусом.
		Кружок = КружокДа();
	Иначе
		Кружок = КружокЧастично();
	КонецЕсли;
	Возврат Кружок;

КонецФункции

// Параметры:
//  Оплата - Структура, Неопределено - см. ОплатыЗаказов, значение соответствия.
//
// Возвращаемое значение:
//  Строка - кружок оплаты поступлений: ○ нет поступлений или оплат, ◐ часть, ● всё.
//
Функция КружокОплаты(Оплата)

	Если Оплата = Неопределено Или Оплата.СуммаПоступлений <= 0 Или Оплата.Оплачено <= 0 Тогда
		Кружок = КружокНет();
	ИначеЕсли Оплата.Оплачено >= Оплата.СуммаПоступлений Тогда
		Кружок = КружокДа();
	Иначе
		Кружок = КружокЧастично();
	КонецЕсли;
	Возврат Кружок;

КонецФункции

Функция КружокНет()

	Возврат "○";

КонецФункции

Функция КружокЧастично()

	Возврат "◐";

КонецФункции

Функция КружокДа()

	Возврат "●";

КонецФункции

// Параметры:
//  Остатки - ТаблицаЗначений - колонка Сумма: остатки расчётов с поставщиком по договору заказа.
//
// Возвращаемое значение:
//  Строка - «Долг поставщику: …», «Аванс поставщику: …» или «Расчёты закрыты».
//
Функция ТекстСальдо(Остатки)

	Сумма = Остатки.Итог("Сумма");
	// Долг перед поставщиком в регистре - отрицательный остаток, аванс - положительный (см. ТестыДокументов,
	// ПроверитьДолгПоставщику).
	Если Сумма < 0 Тогда
		Шаблон = НСтр("ru = 'Долг поставщику по договору заказа: %1'; fr = 'Dette envers le fournisseur au titre du contrat : %1';
			|en = 'Owed to the supplier under the order contract: %1'; es = 'Deuda con el proveedor según el contrato: %1'");
		Текст = СтрШаблон(Шаблон, Формат(-Сумма, "ЧДЦ=2"));
	ИначеЕсли Сумма > 0 Тогда
		Шаблон = НСтр("ru = 'Аванс поставщику по договору заказа: %1'; fr = 'Avance au fournisseur au titre du contrat : %1';
			|en = 'Advance to the supplier under the order contract: %1'; es = 'Anticipo al proveedor según el contrato: %1'");
		Текст = СтрШаблон(Шаблон, Формат(Сумма, "ЧДЦ=2"));
	Иначе
		Текст = НСтр("ru = 'Расчёты с поставщиком по договору заказа закрыты'; fr = 'Comptes avec le fournisseur soldés';
			|en = 'Supplier account under the order contract is settled'; es = 'Cuentas con el proveedor saldadas'");
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Параметры:
//  Проведен        - Булево - документ проведён.
//  ПометкаУдаления - Булево - документ помечен на удаление.
//
// Возвращаемое значение:
//  Строка - статус документа на языке пользователя.
//
Функция ПредставлениеСтатусаДокумента(Проведен, ПометкаУдаления)

	Если ПометкаУдаления Тогда
		Текст = НСтр("ru = 'Помечен на удаление'; fr = 'Marqué pour suppression'; en = 'Marked for deletion';
			|es = 'Marcado para eliminar'");
	ИначеЕсли Проведен Тогда
		Текст = НСтр("ru = 'Проведён'; fr = 'Validé'; en = 'Posted'; es = 'Contabilizado'");
	Иначе
		Текст = НСтр("ru = 'Черновик'; fr = 'Brouillon'; en = 'Draft'; es = 'Borrador'");
	КонецЕсли;
	Возврат Текст;

КонецФункции

#КонецОбласти

#КонецЕсли
