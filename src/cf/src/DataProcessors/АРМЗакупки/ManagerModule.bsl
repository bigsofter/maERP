// Строки закладки «Потребность»: дефицит по заказам клиентов на производство до выпуска и пополнение до минимального
// остатка складов (одно правило с регламентным оповещением), сгруппированные по параметру.
//
// Параметры:
//  Параметры - Структура - см. НовыеПараметрыПотребности.
//
// Возвращаемое значение:
//  Структура:
//   * Строки               - ТаблицаЗначений - Пометка, Сводная, Источник, ИсточникПредставление, Номенклатура,
//                            Характеристика, Нужно, Заказано, Пришло, СоСклада, НаСкладе, Дефицит, Поставщик, Цена,
//                            КЗаказу.
//   * Обрезано             - Булево - строк больше предела, показаны первые ПределСтрокКПоступлению.
//   * ПополнениеНастроено  - Булево - есть склад с оповещением о минимальном остатке.
//
Функция СтрокиПотребности(Параметры) Экспорт

	ПараметрыЗапроса = НовыеПараметрыПотребности();
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Параметры);
	КонецЕсли;
	Товары = ?(ЗначениеЗаполнено(ПараметрыЗапроса.Товар),
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыЗапроса.Товар), Неопределено);
	Источники = ИсточникиПотребности(Товары);
	Если ЗначениеЗаполнено(ПараметрыЗапроса.Поставщик) Тогда
		Источники = ОтобранныеСтроки(Источники, "Поставщик", ПараметрыЗапроса.Поставщик);
	КонецЕсли;
	Строки = СгруппированнаяПотребность(Источники, ПараметрыЗапроса.Группировка);
	Если ПараметрыЗапроса.Группировка = ГруппировкаПоЗаказу() И ТендерыВключены() Тогда
		ЗаполнитьТендерСтрок(Строки);
	КонецЕсли;
	Если ПараметрыЗапроса.ТолькоДефицит Тогда
		Строки = ОтобранныеСтроки(Строки, "ЕстьДефицит", Истина);
	КонецЕсли;
	Результат = Новый Структура("Строки, Обрезано, ПополнениеНастроено", Строки, Ложь, ПополнениеНастроено());
	Предел = ПределСтрокКПоступлению();
	Если Строки.Количество() > Предел Тогда
		Результат.Обрезано = Истина;
		Пока Строки.Количество() > Предел Цикл
			Строки.Удалить(Строки.Количество() - 1);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Нижние закладки строки «Потребности»: источники, строки заказов поставщику по товару (и черновики), остатки по складам.
//
// Параметры:
//  Номенклатура   - СправочникСсылка.Номенклатура - товар строки.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика строки.
//
// Возвращаемое значение:
//  Структура:
//   * Источники        - ТаблицаЗначений - строки источников товара, см. СтрокиПотребности.
//   * ЗаказыПоставщику - ТаблицаЗначений - Документ, Дата, Поставщик, ЗаказКлиента, Заказано, Осталось, Статус.
//   * Остатки          - ТаблицаЗначений - Склад, Количество.
//
Функция ДанныеСтрокиПотребности(Номенклатура, Характеристика) Экспорт

	Данные = Новый Структура;
	Источники = СгруппированнаяПотребность(
		ИсточникиПотребности(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Номенклатура)), ГруппировкаПоЗаказу());
	Данные.Вставить("Источники", ОтобранныеСтроки(Источники, "Характеристика", Характеристика));
	Запрос = Новый Запрос(ТекстЗапросаЗаказовТовара());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	ЗаказыТовара = Запрос.Выполнить().Выгрузить();
	ЗаказыТовара.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	Для Каждого СтрокаЗаказа Из ЗаказыТовара Цикл
		СтрокаЗаказа.Статус = ПредставлениеСтатусаДокумента(СтрокаЗаказа.Проведен, Ложь);
	КонецЦикла;
	Данные.Вставить("ЗаказыПоставщику", ЗаказыТовара);
	Запрос.Текст = ТекстЗапросаОстатковТовара();
	Данные.Вставить("Остатки", Запрос.Выполнить().Выгрузить());
	Возврат Данные;

КонецФункции

// «Заказать» по отмеченным строкам «Потребности»: «к заказу» распределяется по свежим источникам строки (заказы клиентов
// по дате отгрузки, затем пополнение; излишек - в пополнение), по каждому поставщику - заказ на каждый заказ клиента
// (основание) и заказ без основания на пополнение (решение владельца 10). Каждый заказ пишется пакетом общего пути
// (Обработки.АРМПроизводство.ЗаписатьСтрокиЗаказа) с перепроверкой дефицита под блокировкой.
//
// Параметры:
//  Строки - Массив из Структура - Источник (ДокументСсылка.ЗаказПокупателя - заказ клиента, пустая ссылка - пополнение,
//           Неопределено - все источники сводной строки), Номенклатура, Характеристика, Поставщик, Количество,
//           ДефицитНаЭкране.
//
// Возвращаемое значение:
//  Массив из Структура - Поставщик, Источник, Успех, Текст, Документ.
//
Функция ЗаказатьПотребность(Строки) Экспорт

	Итоги = Новый Массив;
	Товары = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Если Не СтрокаЗаказаПотребностиВерна(Строка) Тогда
			Итоги.Добавить(ИтогЗаказаПотребности(Неопределено, Неопределено, РезультатНеверныхДанных().Текст));
			Возврат Итоги;
		КонецЕсли;
		Если Товары.Найти(Строка.Номенклатура) = Неопределено Тогда
			Товары.Добавить(Строка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Источники = ИсточникиПотребности(Товары);
	ТоварыСЧерновиками = ТоварыСЧерновикамиЗаказов(Товары);
	Доли = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Если ТоварыСЧерновиками.Найти(Строка.Номенклатура) <> Неопределено Тогда
			// Черновик (например, после отказа проведения) в дефицит не входит: повтор заказал бы второй раз (ревью
			// данных 2.0.16.30, P2-1).
			Текст = ТекстЕстьЧерновикЗаказа();
		Иначе
			Текст = РаспределитьСтрокуПотребности(Строка, Источники, Доли);
		КонецЕсли;
		Если Не ПустаяСтрока(Текст) Тогда
			ТекстОтказа = СтрШаблон("%1: %2", Строка.Номенклатура, Текст);
			Итоги.Добавить(ИтогЗаказаПотребности(Строка.Поставщик, Строка.Источник, ТекстОтказа));
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючИДоли Из Доли Цикл
		Итоги.Добавить(ЗаписатьЗаказПотребности(КлючИДоли.Значение));
	КонецЦикла;
	Возврат Итоги;

КонецФункции

// Повтор проверки строк заказа «Потребности» под блокировкой проведения заказа поставщику
// (Обработки.АРМПроизводство.ЗаписатьСтрокиЗаказа): производственные строки урезаются до текущего дефицита источника,
// нулевой дефицит - отказ; пополнение берёт исключительную блокировку «Заказов поставщикам» по товарам строк и
// отказывает, если дефицит стал меньше прочитанного перед записью - заказ, оформленный параллельно, дубля не даст.
//
// Параметры:
//  СтрокиДанных - Массив из Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента, строки одного заказа.
//  Проверка     - Структура - Источник (ДокументСсылка.ЗаказПокупателя; пустая - пополнение), Ожидаемые (Массив из
//                 Число - дефицит источника по строке, прочитанный перед записью).
//
// Возвращаемое значение:
//  Строка - текст отказа; пустая строка - строки можно записывать.
//
Функция ТекстЗапретаЗаказаПотребности(СтрокиДанных, Проверка) Экспорт

	Товары = Новый Массив;
	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		Товары.Добавить(ДанныеСтроки.Материал);
	КонецЦикла;
	Пополнение = Не ЗначениеЗаполнено(Проверка.Источник);
	Если Пополнение Тогда
		ЗаблокироватьЗаказыТоваров(Товары);
	КонецЕсли;
	Источники = ИсточникиПотребности(Товары);
	Для Индекс = 0 По СтрокиДанных.ВГраница() Цикл
		ДанныеСтроки = СтрокиДанных[Индекс];
		Дефицит = ДефицитИсточника(Источники, Проверка.Источник, ДанныеСтроки.Материал, ДанныеСтроки.Характеристика);
		Если ДефицитИзменился(Пополнение, Дефицит, Проверка.Ожидаемые[Индекс]) Тогда
			Возврат СтрШаблон("%1: %2", ДанныеСтроки.Материал, ТекстПотребностьИзменилась());
		ИначеЕсли Не Пополнение Тогда
			ДанныеСтроки.КоличествоУпаковок = Мин(ДанныеСтроки.КоличествоУпаковок, Дефицит);
		Иначе
			// Излишек сверх дефицита пополнения остаётся: его заказывают намеренно.
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Если Не Пополнение Тогда
		РазложитьПоПродукции(СтрокиДанных, Проверка.Источник);
	КонецЕсли;
	Возврат "";

КонецФункции

// Возвращаемое значение:
//  Булево - функциональная опция «Тендеры поставщиков»: от неё зависят запрос предложений, закладка «Предложения» и
//           колонка «Тендер» (ревью плана 2.0.16.31, P2-4).
//
Функция ТендерыВключены() Экспорт

	Возврат ПолучитьФункциональнуюОпцию("ТендерыПоставщиков");

КонецФункции

// «Запросить предложения» по отмеченным строкам «Потребности» одного заказа клиента (решение владельца 11): по каждому
// поставщику - черновик предложения с материалами строк, количеством «к заказу» и ценой последнего прайса этого
// поставщика. Поставщик, у которого по заказу уже есть непомеченное предложение с этими материалами, пропускается.
//
// Параметры:
//  Строки     - Массив из Структура - Источник (ДокументСсылка.ЗаказПокупателя), Номенклатура, Характеристика,
//               Количество.
//  Поставщики - Массив из СправочникСсылка.Контрагенты - поставщики тендера.
//
// Возвращаемое значение:
//  Массив из Структура - Поставщик, Успех, Текст, Документ.
//
Функция ЗапроситьПредложения(Строки, Поставщики) Экспорт

	Итоги = Новый Массив;
	Текст = ТекстЗапретаЗапросаПредложений(Строки, Поставщики);
	Если Не ПустаяСтрока(Текст) Тогда
		Итоги.Добавить(ИтогЗаказаПотребности(Неопределено, Неопределено, Текст));
		Возврат Итоги;
	КонецЕсли;
	Заказ = Строки[0].Источник;
	Товары = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Товары.Добавить(Строка.Номенклатура);
	КонецЦикла;
	Для Каждого Поставщик Из Поставщики Цикл
		// Материалы, которые у поставщика по заказу уже запрошены, не повторяются; остальные - в новое предложение.
		Запрошенные = МатериалыПредложенийПоставщика(Заказ, Поставщик, Товары);
		Новые = Новый Массив;
		Для Каждого Строка Из Строки Цикл
			Если Запрошенные.Найти(Строка.Номенклатура) = Неопределено Тогда
				Новые.Добавить(Строка);
			КонецЕсли;
		КонецЦикла;
		Если Новые.Количество() = 0 Тогда
			Итоги.Добавить(ИтогЗаказаПотребности(Поставщик, Заказ, ТекстПредложениеУжеЕсть()));
		Иначе
			Итоги.Добавить(НовоеПредложениеПотребности(Заказ, Поставщик, Новые));
		КонецЕсли;
	КонецЦикла;
	Возврат Итоги;

КонецФункции

// Предложения поставщиков по товару строки «Потребности»: по заказам клиентов - источникам строки, с ценой товара,
// суммой предложения в основной валюте, сроком, победителем и покрытием дефицита заказа (ревью плана 2.0.16.31, P2-5).
//
// Параметры:
//  Заказы         - Массив из ДокументСсылка.ЗаказПокупателя - заказы клиентов строки.
//  Номенклатура   - СправочникСсылка.Номенклатура - товар строки.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика строки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Предложение, Поставщик, Заказ, Цена, СуммаРегл, СрокПоставкиДней, Победитель, Покрытие.
//
Функция ПредложенияТовара(Заказы, Номенклатура, Характеристика) Экспорт

	Запрос = Новый Запрос(ТекстЗапросаПредложенийТовара());
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("Покрытие", Новый ОписаниеТипов("Строка"));
	Шаблон = НСтр("ru = '%1 из %2'; fr = '%1 sur %2'; en = '%1 of %2'; es = '%1 de %2'");
	Для Каждого СтрокаПредложения Из Таблица Цикл
		СтрокаПредложения.Покрытие = СтрШаблон(Шаблон, СтрокаПредложения.Покрыто, СтрокаПредложения.ВсегоДефицитов);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// «Победитель»: предложение становится победителем тендера своего заказа клиента отдельной транзакцией
// (Документы.ПредложениеПоставщика.ВыбратьПобедителя), не внутри записи заказа поставщику (ревью плана 2.0.16.31, P2-2).
//
// Параметры:
//  Предложение - ДокументСсылка.ПредложениеПоставщика - выбранное предложение.
//
// Возвращаемое значение:
//  Структура - Успех, Текст.
//
Функция ВыбратьПобедителя(Предложение) Экспорт

	Если ТипЗнч(Предложение) <> Тип("ДокументСсылка.ПредложениеПоставщика") Или Не ЗначениеЗаполнено(Предложение)
		Или Не ТендерыВключены() Тогда
		Возврат РезультатНеверныхДанных();
	КонецЕсли;
	Итог = РезультатНеверныхДанных();
	Итог.Текст = "";
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Предложение, "ПометкаУдаления") Тогда
		// Помеченное предложение сняло бы флажок с текущего победителя и само победителем не стало бы.
		Итог.Текст = НСтр("ru = 'Предложение помечено на удаление.';
			|fr = 'L''offre est marquée pour suppression.'; en = 'The offer is marked for deletion.';
			|es = 'La oferta está marcada para eliminar.'");
		Возврат Итог;
	КонецЕсли;
	Попытка
		Документы.ПредложениеПоставщика.ВыбратьПобедителя(Предложение);
	Исключение
		Итог.Текст = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;
	Итог.Успех = Истина;
	Возврат Итог;

КонецФункции

// «Заказать у победителя»: заказ поставщику под заказ клиента по победившему предложению - пакетом общего пути с
// перепроверкой дефицита и раскладкой по продукции, шапка - валюта, договор, режим НДС и срок предложения. Строки
// предложения свёрнуты по товару и переведены в единицы хранения; строки без дефицита отбрасываются с сообщением.
//
// Параметры:
//  Предложение - ДокументСсылка.ПредложениеПоставщика - предложение с флажком «Победитель».
//
// Возвращаемое значение:
//  Структура - см. ИтогЗаказаПотребности: Поставщик, Источник, Успех, Текст, Документ.
//
Функция ЗаказатьУПобедителя(Предложение) Экспорт

	Если ТипЗнч(Предложение) <> Тип("ДокументСсылка.ПредложениеПоставщика") Или Не ЗначениеЗаполнено(Предложение)
		Или Не ТендерыВключены() Тогда
		Возврат ИтогЗаказаПотребности(Неопределено, Неопределено, РезультатНеверныхДанных().Текст);
	КонецЕсли;
	Шапка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Предложение,
		"Поставщик, ЗаказПокупателя, Организация, Победитель, ПометкаУдаления");
	Текст = ТекстЗапретаПредложения(Шапка);
	Если Не ПустаяСтрока(Текст) Тогда
		Возврат ИтогЗаказаПотребности(Шапка.Поставщик, Шапка.ЗаказПокупателя, Текст);
	КонецЕсли;
	Строки = СтрокиПредложенияКЗаказу(Предложение, Шапка.ЗаказПокупателя);
	Если Строки.СтрокиДанных.Количество() = 0 Тогда
		Возврат ИтогЗаказаПотребности(Шапка.Поставщик, Шапка.ЗаказПокупателя,
			СоединитьТекстыИтога(ТекстНетДефицитаВПредложении(), Строки.Пояснение));
	КонецЕсли;
	Проверка = Новый Структура("Источник, Ожидаемые", Шапка.ЗаказПокупателя, Строки.Ожидаемые);
	Результат = Обработки.АРМПроизводство.ЗаписатьСтрокиЗаказа(Строки.СтрокиДанных, Проверка);
	Итог = ИтогЗаказаПотребности(Шапка.Поставщик, Шапка.ЗаказПокупателя, Результат.Текст, Результат.Успех,
		Результат.Документ);
	Итог.Текст = СоединитьТекстыИтога(Итог.Текст, Строки.Пояснение);
	Итог.Текст = СоединитьТекстыИтога(Итог.Текст, ТекстОставшегосяДефицита(Шапка.ЗаказПокупателя));
	Возврат Итог;

КонецФункции

// Строки заказа поставщику, вводимого на основании предложения: тот же расчёт, что «Заказать у победителя» -
// строки свёрнуты по товару, товары без дефицита заказа клиента, с разными ставками или с черновиками отброшены,
// количество ограничено дефицитом (ревью техдолга Codex 2026-10-09, T27: иначе повторный заказ по тому же предложению
// заказывал бы всё ещё раз).
//
// Параметры:
//  Предложение - ДокументСсылка.ПредложениеПоставщика - предложение с заказом клиента.
//
// Возвращаемое значение:
//  Структура:
//   * Строки    - ТаблицаЗначений - Номенклатура, Характеристика, Количество (в единицах хранения), Цена, СтавкаНДС
//   * Пояснение - Строка - что отброшено; пустая - ничего
//
Функция СтрокиПредложенияДляЗаказа(Предложение) Экспорт

	Строки = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Номенклатура,Характеристика,Количество,Цена,СтавкаНДС", ",") Цикл
		Строки.Колонки.Добавить(Имя);
	КонецЦикла;
	Заказ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Предложение, "ЗаказПокупателя");
	Данные = СтрокиПредложенияКЗаказу(Предложение, Заказ);
	Для Индекс = 0 По Данные.СтрокиДанных.ВГраница() Цикл
		ДанныеСтроки = Данные.СтрокиДанных[Индекс];
		Строка = Строки.Добавить();
		Строка.Номенклатура = ДанныеСтроки.Материал;
		Строка.Характеристика = ДанныеСтроки.Характеристика;
		Строка.Количество = Мин(ДанныеСтроки.КоличествоУпаковок, Данные.Ожидаемые[Индекс]);
		Строка.Цена = ДанныеСтроки.Цена;
		Строка.СтавкаНДС = ДанныеСтроки.СтавкаНДС;
	КонецЦикла;
	Возврат Новый Структура("Строки, Пояснение", Строки, Данные.Пояснение);

КонецФункции

// Легенда индикатора в одну строку - в строку пагинатора под списком заказов.
//
// Возвращаемое значение:
//  Строка - «поставка · оплата: ○ нет ◐ частично ● да».
//
Функция ЛегендаИндикатораСтрокой() Экспорт

	Возврат НСтр("ru = 'поставка · оплата:  ○ нет   ◐ частично   ● да'; fr = 'livraison · paiement :  ○ non   ◐ partiel   ● oui';
		|en = 'delivery · payment:  ○ no   ◐ partial   ● yes'; es = 'entrega · pago:  ○ no   ◐ parcial   ● sí'");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращаемое значение:
//  Число - верхняя граница размера страницы, пришедшего с клиента.
//
Функция МаксимумСтраницы()

	Возврат 200;

КонецФункции

// Данные строки общего пути ввода по текущему заказу поставщику: закупочный контекст, поставщик и заказ клиента - из
// заказа; у заказа поставщику - сам заказ документом строки, у поступления - заказ основанием.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПоставщику - текущий заказ.
//  Вид   - Строка - см. Обработки.АРМПроизводство.ВидЗаказПоставщику, ВидПоступление.
//
// Возвращаемое значение:
//  Структура, Неопределено - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента; заказ не задан - Неопределено.
//
Функция ДанныеСтрокиЗаказа(Заказ, Вид)

	Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказПоставщику") Или Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента();
	ДанныеСтроки.Вид = Вид;
	ДанныеСтроки.КонтекстЗаказПоставщику = Истина;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "Контрагент, Основание");
	ДанныеСтроки.Поставщик = Реквизиты.Контрагент;
	Если ТипЗнч(Реквизиты.Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ДанныеСтроки.Заказ = Реквизиты.Основание;
	КонецЕсли;
	Если Вид = Обработки.АРМПроизводство.ВидПоступление() Тогда
		ДанныеСтроки.ЗаказПоставщику = Заказ;
	Иначе
		ДанныеСтроки.Документ = Заказ;
	КонецЕсли;
	Возврат ДанныеСтроки;

КонецФункции

// Реквизиты текущего заказа для ввода строк и запреты ввода - чтобы форма не открывала на правку то, что сервер отклонит.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПоставщику - текущий заказ.
//
// Возвращаемое значение:
//  Структура:
//   * ВерсияДанных            - Строка - версия заказа.
//   * ТекстЗапретаТоваров     - Строка - почему строки заказа только для просмотра; пустая - правятся.
//   * ТекстЗапретаПоступлений - Строка - почему поступления по заказу не вводятся; пустая - вводятся.
//
Функция ШапкаЗаказа(Заказ)

	Шапка = Новый Структура("ВерсияДанных, ТекстЗапретаТоваров, ТекстЗапретаПоступлений", "", "", "");
	ПробаТоваров = ДанныеСтрокиЗаказа(Заказ, Обработки.АРМПроизводство.ВидЗаказПоставщику());
	Если ПробаТоваров = Неопределено Тогда
		Возврат Шапка;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "ВерсияДанных, Проведен");
	Шапка.ВерсияДанных = Реквизиты.ВерсияДанных;
	// Проба удалением: права, заказ клиента, пометка и перенос строк проверяются, значения строки - нет.
	Шапка.ТекстЗапретаТоваров = Обработки.АРМПроизводство.ТекстЗапретаСтрокиДокумента(ПробаТоваров, Истина);
	ПробаПоступлений = ДанныеСтрокиЗаказа(Заказ, Обработки.АРМПроизводство.ВидПоступление());
	Текст = Обработки.АРМПроизводство.ТекстЗапретаСтрокиДокумента(ПробаПоступлений, Истина);
	Если ПустаяСтрока(Текст) И Не Реквизиты.Проведен Тогда
		Текст = НСтр("ru = 'Поступления вводятся по проведённому заказу: переведите заказ «В работу».';
			|fr = 'Les réceptions se saisissent sur une commande validée : passez la commande « En cours ».';
			|en = 'Receipts are entered for a posted order: set the order to ""In progress"".';
			|es = 'Las recepciones se introducen para un pedido contabilizado: pase el pedido a «En curso».'");
	КонецЕсли;
	Шапка.ТекстЗапретаПоступлений = Текст;
	Возврат Шапка;

КонецФункции

// Возвращаемое значение:
//  Структура - Успех (Ложь), Текст - отказ по неверным данным с клиента.
//
Функция РезультатНеверныхДанных()

	Текст = НСтр("ru = 'Неверные данные строки: обновите рабочее место.';
		|fr = 'Données de ligne incorrectes : actualisez le poste de travail.';
		|en = 'Invalid line data: refresh the workstation.'; es = 'Datos de línea incorrectos: actualice el puesto de trabajo.'");
	Возврат Новый Структура("Успех, Текст", Ложь, Текст);

КонецФункции

// Параметры:
//  Заказ     - ДокументСсылка.ЗаказПоставщику, Неопределено - заказ поступления; не определён - отказ до записи.
//  Результат - Структура - Успех, Текст и, если записано, Документ.
//
// Возвращаемое значение:
//  Структура - Заказ, Успех, Текст, Документ - итог оформления по заказу.
//
Функция ИтогПоступления(Заказ, Результат)

	Итог = Новый Структура;
	Итог.Вставить("Заказ", Заказ);
	Итог.Вставить("Успех", Результат.Успех);
	Итог.Вставить("Текст", Результат.Текст);
	Итог.Вставить("Документ", ?(Результат.Свойство("Документ"), Результат.Документ, Неопределено));
	Возврат Итог;

КонецФункции

// Параметры:
//  СтрокиДанных - Массив из Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента, удаляемые строки.
//
// Возвращаемое значение:
//  Структура - Успех (по всем документам), Текст - тексты отказов и сообщений документов.
//
Функция ИтогУдаления(СтрокиДанных)

	Итог = Новый Структура("Успех, Текст", Истина, "");
	Тексты = Новый Массив;
	Для Каждого Результат Из Обработки.АРМПроизводство.УдалитьСтрокиДокументов(СтрокиДанных) Цикл
		Итог.Успех = Итог.Успех И Результат.Успех;
		Если Не ПустаяСтрока(Результат.Текст) Тогда
			Тексты.Добавить(Результат.Текст);
		КонецЕсли;
	КонецЦикла;
	Итог.Текст = СтрСоединить(Тексты, Символы.ПС);
	Возврат Итог;

КонецФункции

// Параметры:
//  ПоЗаказам - Соответствие из КлючИЗначение - ключ - заказ поставщику отмеченных строк.
//
// Возвращаемое значение:
//  Строка - текст запрета, если отмечены строки разных поставщиков; пустая строка - поставщик один.
//
Функция ТекстЗапретаПоставщиковПоступления(ПоЗаказам)

	Заказы = Новый Массив;
	Для Каждого ЗаказИСтроки Из ПоЗаказам Цикл
		Заказы.Добавить(ЗаказИСтроки.Ключ);
	КонецЦикла;
	Если Заказы.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Отметьте строки к поступлению.'; fr = 'Cochez les lignes à réceptionner.';
			|en = 'Check the lines to receive.'; es = 'Marque las líneas a recibir.'");
	КонецЕсли;
	Поставщики = Новый Массив;
	Для Каждого ЗаказИРеквизиты Из ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Заказы, "Контрагент") Цикл
		Если Поставщики.Найти(ЗаказИРеквизиты.Значение.Контрагент) = Неопределено Тогда
			Поставщики.Добавить(ЗаказИРеквизиты.Значение.Контрагент);
		КонецЕсли;
	КонецЦикла;
	Если Поставщики.Количество() > 1 Тогда
		Возврат НСтр("ru = 'Отметьте строки одного поставщика: накладная - от одного поставщика.';
			|fr = 'Cochez les lignes d''un seul fournisseur : la facture vient d''un seul fournisseur.';
			|en = 'Check lines of one supplier: an invoice comes from one supplier.';
			|es = 'Marque líneas de un solo proveedor: la factura es de un solo proveedor.'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Возвращаемое значение:
//  Строка - пакет: остатки регистра «Заказы поставщикам» по строкам с условием &УсловиеОстатков за вычетом черновиков
//           поступлений и непроведённых заказов, забирающих строку (как в проверке пакета поступления), строки
//           проведённых непомеченных заказов (кроме предварительных) с условием &УсловиеПоставщика, первые 500 по
//           поставщику и дате поставки; Коэффициент - единиц в упаковке строки.
//
Функция ТекстЗапросаКПоступлению()

	Возврат
	"ВЫБРАТЬ
	|	Остатки.ЗаказПоставщику КАК Заказ,
	|	Остатки.КодСтроки КАК КодСтроки,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(, &УсловиеОстатков) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстатки.Заказ КАК Заказ,
	|	ВТОстатки.КодСтроки КАК КодСтроки,
	|	ВТОстатки.Номенклатура КАК Номенклатура,
	|	ВТОстатки.Характеристика КАК Характеристика,
	|	ВТОстатки.Количество КАК Количество
	|ПОМЕСТИТЬ ВТДвижения
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Поступления.Основание,
	|	ТоварыПоступлений.КодСтроки,
	|	ТоварыПоступлений.Номенклатура,
	|	ТоварыПоступлений.Характеристика,
	|	-ТоварыПоступлений.Количество
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК Поступления
	|		ПО ВТОстатки.Заказ = Поступления.Основание
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК ТоварыПоступлений
	|		ПО Поступления.Ссылка = ТоварыПоступлений.Ссылка
	|			И ВТОстатки.КодСтроки = ТоварыПоступлений.КодСтроки
	|			И ВТОстатки.Номенклатура = ТоварыПоступлений.Номенклатура
	|			И ВТОстатки.Характеристика = ТоварыПоступлений.Характеристика
	|ГДЕ
	|	НЕ Поступления.Проведен
	|	И НЕ Поступления.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыПереноса.ЗаказПоставщику,
	|	ТоварыПереноса.КодСтроки,
	|	ТоварыПереноса.Номенклатура,
	|	ТоварыПереноса.Характеристика,
	|	-ТоварыПереноса.Количество
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.ТЧТовары КАК ТоварыПереноса
	|		ПО ВТОстатки.Заказ = ТоварыПереноса.ЗаказПоставщику
	|			И ВТОстатки.КодСтроки = ТоварыПереноса.КодСтроки
	|			И ВТОстатки.Номенклатура = ТоварыПереноса.Номенклатура
	|			И ВТОстатки.Характеристика = ТоварыПереноса.Характеристика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Переносы
	|		ПО ТоварыПереноса.Ссылка = Переносы.Ссылка
	|ГДЕ
	|	НЕ Переносы.Проведен
	|	И НЕ Переносы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДвижения.Заказ КАК Заказ,
	|	ВТДвижения.КодСтроки КАК КодСтроки,
	|	ВТДвижения.Номенклатура КАК Номенклатура,
	|	ВТДвижения.Характеристика КАК Характеристика,
	|	СУММА(ВТДвижения.Количество) КАК Осталось
	|ПОМЕСТИТЬ ВТОсталось
	|ИЗ
	|	ВТДвижения КАК ВТДвижения
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТДвижения.Заказ,
	|	ВТДвижения.КодСтроки,
	|	ВТДвижения.Номенклатура,
	|	ВТДвижения.Характеристика
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВТДвижения.Количество) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	Заказы.Контрагент КАК Поставщик,
	|	ВТОсталось.Заказ КАК Заказ,
	|	Заказы.Номер КАК Номер,
	|	Заказы.Дата КАК Дата,
	|	Заказы.ДатаПоставки КАК ДатаПоставки,
	|	ВЫБОР
	|		КОГДА Заказы.ДатаПоставки > ДАТАВРЕМЯ(1, 1, 1)
	|				И Заказы.ДатаПоставки < &НачалоДня
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Просрочен,
	|	ВТОсталось.КодСтроки КАК КодСтроки,
	|	ВТОсталось.Номенклатура КАК Номенклатура,
	|	ВТОсталось.Характеристика КАК Характеристика,
	|	МАКСИМУМ(Товары.Упаковка) КАК Упаковка,
	|	МАКСИМУМ(Позиции.Единица) КАК Единица,
	|	ВТОсталось.Осталось КАК Осталось,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Товары.КоличествоУпаковок = 0
	|					ИЛИ Товары.Количество = 0
	|				ТОГДА 1
	|			ИНАЧЕ Товары.Количество / Товары.КоличествоУпаковок
	|		КОНЕЦ) КАК Коэффициент
	|ИЗ
	|	ВТОсталось КАК ВТОсталось
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказы
	|		ПО ВТОсталось.Заказ = Заказы.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.ТЧТовары КАК Товары
	|		ПО ВТОсталось.Заказ = Товары.Ссылка
	|			И ВТОсталось.КодСтроки = Товары.КодСтроки
	|			И ВТОсталось.Номенклатура = Товары.Номенклатура
	|			И ВТОсталось.Характеристика = Товары.Характеристика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Позиции
	|		ПО ВТОсталось.Номенклатура = Позиции.Ссылка
	|ГДЕ
	|	Заказы.Проведен
	|	И НЕ Заказы.ПометкаУдаления
	|	И Заказы.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовПоставщику.Предварительный)
	|	И &УсловиеПоставщика
	|
	|СГРУППИРОВАТЬ ПО
	|	Заказы.Контрагент,
	|	ВТОсталось.Заказ,
	|	Заказы.Номер,
	|	Заказы.Дата,
	|	Заказы.ДатаПоставки,
	|	ВТОсталось.КодСтроки,
	|	ВТОсталось.Номенклатура,
	|	ВТОсталось.Характеристика,
	|	ВТОсталось.Осталось
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поставщик,
	|	ДатаПоставки,
	|	Дата,
	|	КодСтроки";

КонецФункции

#Область Потребность

// Строки источников потребности: заказы клиентов на производство на стадии до выпуска (дефицит по строке продукции -
// «Потребность - Макс(Заказано, Пришло) - ИзОстатка», положительные части по продукции складываются) и пополнение до
// минимального остатка складов с оповещением (минимум склада из регистра, иначе реквизит номенклатуры; на складе - без
// партий, пришедших под заказы клиентов до выпуска; минус остатки строк заказов поставщику без заказа клиента). Одна
// функция для экрана и для перепроверки под блокировкой (ревью плана 2.0.16.30, раунд 2).
//
// Параметры:
//  Товары - Массив из СправочникСсылка.Номенклатура, Неопределено - товары; Неопределено - все.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Источник (ДокументСсылка.ЗаказПокупателя; пустая - пополнение), Номенклатура, Характеристика, Нужно,
//                    Заказано, Пришло, СоСклада, НаСкладе, Дефицит, ДатаОтгрузки, Поставщик (основной), Цена (последний
//                    прайс основного поставщика за единицу: по характеристике строки, иначе любой по товару).
//
Функция ИсточникиПотребности(Товары)

	Текст = ТекстЗапросаПотребности();
	Запрос = Новый Запрос;
	Если Товары = Неопределено Тогда
		Для Каждого Условие Из СтрРазделить("&УсловиеМатериала,&УсловиеПозиции,&УсловиеЗаказовИстории,&УсловиеПоступлений",
			",") Цикл
			Текст = СтрЗаменить(Текст, Условие, "ИСТИНА");
		КонецЦикла;
	Иначе
		// Отбор по товарам сужает и тяжёлые части пакета - историю стадий и партии под заказы: перепроверка пополнения
		// идёт под блокировкой «Заказов поставщикам» по товарам (ревью данных 2.0.16.30, P2-2).
		Текст = СтрЗаменить(Текст, "&УсловиеМатериала", "Материал В (&Товары)");
		Текст = СтрЗаменить(Текст, "&УсловиеПозиции", "Позиции.Ссылка В (&Товары)");
		Текст = СтрЗаменить(Текст, "&УсловиеЗаказовИстории", "История.ЗаказПокупателя В (
			|		ВЫБРАТЬ ПотребностиЗаказов.Заказ ИЗ РегистрНакопления.ПотребностиПроизводства КАК ПотребностиЗаказов
			|		ГДЕ ПотребностиЗаказов.Материал В (&Товары))");
		Текст = СтрЗаменить(Текст, "&УсловиеПоступлений", "Поступления.Ссылка В (
			|		ВЫБРАТЬ ТоварыПоступлений.Ссылка ИЗ Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК ТоварыПоступлений
			|		ГДЕ ТоварыПоступлений.Номенклатура В (&Товары))");
		Запрос.УстановитьПараметр("Товары", Товары);
	КонецЕсли;
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("ПроизводствоВключено", ПолучитьФункциональнуюОпцию("Производство"));
	Запрос.УстановитьПараметр("СтадииДоВыпуска", СтадииДоВыпуска());
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.СтатусыЗаказовПокупателя - стадии заказа на производство до выпуска: его потребность ещё
//                                                          закупается (ревью плана 2.0.16.30, P1-2).
//
Функция СтадииДоВыпуска()

	Стадии = Новый Массив;
	Стадии.Добавить(Перечисления.СтатусыЗаказовПокупателя.ФормируетсяПотребность);
	Стадии.Добавить(Перечисления.СтатусыЗаказовПокупателя.ЗаказПоставщику);
	Стадии.Добавить(Перечисления.СтатусыЗаказовПокупателя.ВосполнениеПотребности);
	Стадии.Добавить(Перечисления.СтатусыЗаказовПокупателя.ВПроизводстве);
	Возврат Стадии;

КонецФункции

// Возвращаемое значение:
//  Булево - есть непомеченный склад с оповещением о минимальном остатке: без него источник «пополнение» пуст.
//
Функция ПополнениеНастроено()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.МестаХранения КАК Склады
	|ГДЕ
	|	Склады.ОповещатьОМинимальномОстатке
	|	И НЕ Склады.ПометкаУдаления");
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Параметры:
//  Таблица  - ТаблицаЗначений - строки.
//  Колонка  - Строка - имя колонки.
//  Значение - Произвольный - значение отбора.
//
// Возвращаемое значение:
//  ТаблицаЗначений - копия строк с этим значением колонки.
//
Функция ОтобранныеСтроки(Таблица, Колонка, Значение)

	Отбор = Новый Структура;
	Отбор.Вставить(Колонка, Значение);
	Возврат Таблица.Скопировать(Отбор);

КонецФункции

// Строки «Потребности» по группировке: по заказу - строки источников; по товару и по поставщику - сводно по товару и
// основному поставщику (сводная строка заказывается по всем своим источникам).
//
// Параметры:
//  Источники   - ТаблицаЗначений - см. ИсточникиПотребности.
//  Группировка - Строка - см. ГруппировкаПоТовару.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. СтрокиПотребности.
//
Функция СгруппированнаяПотребность(Источники, Группировка)

	Ресурсы = "Нужно, Заказано, Пришло, СоСклада, НаСкладе, Дефицит";
	Если Группировка = ГруппировкаПоЗаказу() Тогда
		Строки = Источники.Скопировать();
		Сводная = Ложь;
	Иначе
		Строки = Источники.Скопировать(, "Номенклатура, Характеристика, Поставщик, Цена, " + Ресурсы);
		Строки.Колонки.Добавить("Источников", Новый ОписаниеТипов("Число"));
		Строки.ЗаполнитьЗначения(1, "Источников");
		Строки.Свернуть("Номенклатура, Характеристика, Поставщик, Цена", Ресурсы + ", Источников");
		Строки.Колонки.Добавить("Источник");
		Сводная = Истина;
	КонецЕсли;
	ТипБулево = Новый ОписаниеТипов("Булево");
	Строки.Колонки.Добавить("Пометка", ТипБулево);
	Строки.Колонки.Добавить("Сводная", ТипБулево);
	Строки.Колонки.Добавить("ЕстьДефицит", ТипБулево);
	Строки.Колонки.Добавить("ИсточникПредставление", Новый ОписаниеТипов("Строка"));
	Строки.Колонки.Добавить("Тендер", Новый ОписаниеТипов("Строка"));
	// BSLLS:MagicNumber-off - количество: 15 знаков, 3 после запятой, как в строках документов.
	Строки.Колонки.Добавить("КЗаказу", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	// BSLLS:MagicNumber-on
	ШаблонИсточников = НСтр("ru = 'источников: %1'; fr = 'sources : %1'; en = 'sources: %1'; es = 'orígenes: %1'");
	Для Каждого СтрокаПотребности Из Строки Цикл
		СтрокаПотребности.Сводная = Сводная;
		СтрокаПотребности.ЕстьДефицит = СтрокаПотребности.Дефицит > 0;
		СтрокаПотребности.КЗаказу = СтрокаПотребности.Дефицит;
		Если Сводная Тогда
			СтрокаПотребности.ИсточникПредставление = СтрШаблон(ШаблонИсточников, СтрокаПотребности.Источников);
		ИначеЕсли ЗначениеЗаполнено(СтрокаПотребности.Источник) Тогда
			СтрокаПотребности.ИсточникПредставление = Строка(СтрокаПотребности.Источник);
		Иначе
			СтрокаПотребности.ИсточникПредставление = ТекстПополнениеСклада();
		КонецЕсли;
	КонецЦикла;
	Если Группировка = ГруппировкаПоПоставщику() Тогда
		Строки.Сортировать("Поставщик, Номенклатура");
	КонецЕсли;
	Возврат Строки;

КонецФункции

// Возвращаемое значение:
//  Строка - представление источника «пополнение до минимального остатка».
//
Функция ТекстПополнениеСклада()

	Возврат НСтр("ru = 'Пополнение склада'; fr = 'Réapprovisionnement du stock'; en = 'Stock replenishment';
		|es = 'Reposición de almacén'");

КонецФункции

// Возвращаемое значение:
//  Строка - отказ строки, потребность которой изменилась после чтения.
//
Функция ТекстПотребностьИзменилась()

	Возврат НСтр("ru = 'потребность изменилась (уже заказано или обеспечено): обновите закладку.';
		|fr = 'le besoin a changé (déjà commandé ou couvert) : actualisez l''onglet.';
		|en = 'the need has changed (already ordered or covered): refresh the tab.';
		|es = 'la necesidad cambió (ya pedido o cubierto): actualice la pestaña.'");

КонецФункции

// Параметры:
//  Строка - Произвольный - строка «Заказать», см. ЗаказатьПотребность.
//
// Возвращаемое значение:
//  Булево - структура нужных полей и типов.
//
Функция СтрокаЗаказаПотребностиВерна(Строка)

	Если ТипЗнч(Строка) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("Источник,Номенклатура,Характеристика,Поставщик,Количество,ДефицитНаЭкране", ",") Цикл
		Если Не Строка.Свойство(Имя) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	ИсточникВерен = Строка.Источник = Неопределено Или ТипЗнч(Строка.Источник) = Тип("ДокументСсылка.ЗаказПокупателя");
	Возврат ИсточникВерен И ТипЗнч(Строка.Номенклатура) = Тип("СправочникСсылка.Номенклатура")
		И ТипЗнч(Строка.Поставщик) = Тип("СправочникСсылка.Контрагенты") И ТипЗнч(Строка.Количество) = Тип("Число")
		И ТипЗнч(Строка.ДефицитНаЭкране) = Тип("Число");

КонецФункции

// Параметры:
//  Поставщик - СправочникСсылка.Контрагенты, Неопределено - поставщик заказа.
//  Источник  - ДокументСсылка.ЗаказПокупателя, Неопределено - заказ клиента; пустая - пополнение.
//  Текст     - Строка - отказ или сообщения записи.
//  Успех     - Булево - заказ записан.
//  Документ  - ДокументСсылка.ЗаказПоставщику, Неопределено - записанный заказ.
//
// Возвращаемое значение:
//  Структура - Поставщик, Источник, Успех, Текст, Документ.
//
Функция ИтогЗаказаПотребности(Поставщик, Источник, Текст, Успех = Ложь, Документ = Неопределено)

	Итог = Новый Структура;
	Итог.Вставить("Поставщик", Поставщик);
	Итог.Вставить("Источник", Источник);
	Итог.Вставить("Успех", Успех);
	Итог.Вставить("Текст", Текст);
	Итог.Вставить("Документ", Документ);
	Возврат Итог;

КонецФункции

// Раскладывает «к заказу» строки по её свежим источникам в порядке: заказы клиентов по дате отгрузки, затем пополнение;
// излишек сверх дефицитов - в пополнение. Свежий дефицит меньше показанного - строка отклоняется (устаревший экран).
//
// Параметры:
//  Строка    - Структура - см. ЗаказатьПотребность.
//  Источники - ТаблицаЗначений - см. ИсточникиПотребности, свежие.
//  Доли      - Соответствие - пополняется: ключ - поставщик и источник, значение - см. НоваяДоляЗаказа.
//
// Возвращаемое значение:
//  Строка - текст отказа; пустая строка - разложено.
//
Функция РаспределитьСтрокуПотребности(Строка, Источники, Доли)

	Если Не ЗначениеЗаполнено(Строка.Поставщик) Тогда
		Возврат НСтр("ru = 'укажите поставщика.'; fr = 'indiquez le fournisseur.'; en = 'specify the supplier.';
			|es = 'indique el proveedor.'");
	КонецЕсли;
	Отбор = Новый Структура("Номенклатура, Характеристика", Строка.Номенклатура, Строка.Характеристика);
	Если Строка.Источник <> Неопределено Тогда
		Отбор.Вставить("Источник", Строка.Источник);
	КонецЕсли;
	Подходящие = Источники.Скопировать(Отбор);
	Подходящие.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Для Каждого Источник Из Подходящие Цикл
		Источник.Порядок = ?(ЗначениеЗаполнено(Источник.Источник), 0, 1);
	КонецЦикла;
	Подходящие.Сортировать("Порядок, ДатаОтгрузки");
	Если Подходящие.Итог("Дефицит") < Строка.ДефицитНаЭкране Тогда
		Возврат ТекстПотребностьИзменилась();
	КонецЕсли;
	Пополнение = Документы.ЗаказПокупателя.ПустаяСсылка();
	Остаток = Строка.Количество;
	Для Каждого Источник Из Подходящие Цикл
		Взять = Мин(Остаток, Источник.Дефицит);
		Если Взять > 0 Тогда
			ДобавитьДолюЗаказа(Доли, Строка, Источник.Источник, Взять, Источник.Дефицит);
			Остаток = Остаток - Взять;
		КонецЕсли;
	КонецЦикла;
	Если Остаток > 0 Тогда
		ДефицитПополнения = ДефицитИсточника(Источники, Пополнение, Строка.Номенклатура, Строка.Характеристика);
		ДобавитьДолюЗаказа(Доли, Строка, Пополнение, Остаток, ДефицитПополнения);
	КонецЕсли;
	Возврат "";

КонецФункции

// Параметры:
//  Доли       - Соответствие - см. РаспределитьСтрокуПотребности.
//  Строка     - Структура - строка «Заказать»: Поставщик, Номенклатура, Характеристика.
//  Источник   - ДокументСсылка.ЗаказПокупателя - заказ клиента; пустая - пополнение.
//  Количество - Число - доля к заказу.
//  Ожидаемый  - Число - свежий дефицит источника по товару: перепроверка под блокировкой сравнивает с ним.
//
Процедура ДобавитьДолюЗаказа(Доли, Строка, Источник, Количество, Ожидаемый)

	Ключ = СтрШаблон("%1|%2", Строка.Поставщик.УникальныйИдентификатор(), Источник.УникальныйИдентификатор());
	Доля = Доли[Ключ];
	Если Доля = Неопределено Тогда
		Доля = Новый Структура("Поставщик, Источник, Строки", Строка.Поставщик, Источник, Новый ТаблицаЗначений);
		Доля.Строки.Колонки.Добавить("Номенклатура");
		Доля.Строки.Колонки.Добавить("Характеристика");
		Доля.Строки.Колонки.Добавить("Количество");
		Доля.Строки.Колонки.Добавить("Ожидаемый");
		Доли.Вставить(Ключ, Доля);
	КонецЕсли;
	Отбор = Новый Структура("Номенклатура, Характеристика", Строка.Номенклатура, Строка.Характеристика);
	Найденные = Доля.Строки.НайтиСтроки(Отбор);
	Если Найденные.Количество() = 0 Тогда
		СтрокаДоли = Доля.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДоли, Отбор);
		СтрокаДоли.Количество = Количество;
		СтрокаДоли.Ожидаемый = Ожидаемый;
	Иначе
		Найденные[0].Количество = Найденные[0].Количество + Количество;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Доля - Структура - Поставщик, Источник, Строки (Номенклатура, Характеристика, Количество, Ожидаемый).
//
// Возвращаемое значение:
//  Структура - см. ИтогЗаказаПотребности.
//
Функция ЗаписатьЗаказПотребности(Доля)

	СтрокиДанных = Новый Массив;
	Ожидаемые = Новый Массив;
	Для Каждого СтрокаДоли Из Доля.Строки Цикл
		ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента();
		ДанныеСтроки.Вид = Обработки.АРМПроизводство.ВидЗаказПоставщику();
		ДанныеСтроки.КонтекстЗаказПоставщику = Истина;
		ДанныеСтроки.Поставщик = Доля.Поставщик;
		ДанныеСтроки.Заказ = Доля.Источник;
		ДанныеСтроки.Материал = СтрокаДоли.Номенклатура;
		ДанныеСтроки.Характеристика = СтрокаДоли.Характеристика;
		ДанныеСтроки.КоличествоУпаковок = СтрокаДоли.Количество;
		СтрокиДанных.Добавить(ДанныеСтроки);
		Ожидаемые.Добавить(СтрокаДоли.Ожидаемый);
	КонецЦикла;
	Проверка = Новый Структура("Источник, Ожидаемые", Доля.Источник, Ожидаемые);
	Результат = Обработки.АРМПроизводство.ЗаписатьСтрокиЗаказа(СтрокиДанных, Проверка);
	Возврат ИтогЗаказаПотребности(Доля.Поставщик, Доля.Источник, Результат.Текст, Результат.Успех, Результат.Документ);

КонецФункции

// Раскладывает строки заказа под заказ клиента по продукции с дефицитом - явной продукцией строки: распределение
// проведения по пределам «Потребность - Заказано» не видит пришедшего и взятого со склада и отдало бы закупку уже
// обеспеченному изделию (ревью кода 2.0.16.30, P1). Вызывается под блокировкой потребностей заказа.
//
// Параметры:
//  СтрокиДанных - Массив из Структура - строки одного заказа поставщику, урезанные до дефицита; заменяются строками по
//                 продукции.
//  Заказ        - ДокументСсылка.ЗаказПокупателя - заказ клиента на производство.
//
Процедура РазложитьПоПродукции(СтрокиДанных, Заказ)

	Товары = Новый Массив;
	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		Товары.Добавить(ДанныеСтроки.Материал);
	КонецЦикла;
	Запрос = Новый Запрос(ТекстЗапросаДефицитаПродукции());
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Товары", Товары);
	Дефициты = Запрос.Выполнить().Выгрузить();
	Исходные = Новый Массив;
	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		Исходные.Добавить(ДанныеСтроки);
	КонецЦикла;
	СтрокиДанных.Очистить();
	Для Каждого ДанныеСтроки Из Исходные Цикл
		Отбор = Новый Структура("Материал, Характеристика", ДанныеСтроки.Материал, ДанныеСтроки.Характеристика);
		Остаток = ДанныеСтроки.КоличествоУпаковок;
		Для Каждого Дефицит Из Дефициты.НайтиСтроки(Отбор) Цикл
			Взять = Мин(Остаток, Дефицит.Дефицит);
			Если Взять <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Часть = ОбщегоНазначенияКлиентСервер.СкопироватьРекурсивно(ДанныеСтроки);
			Часть.Продукция = Дефицит.Продукция;
			Часть.КоличествоУпаковок = Взять;
			СтрокиДанных.Добавить(Часть);
			Остаток = Остаток - Взять;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Возвращаемое значение:
//  Строка - дефицит заказа клиента &Заказ по продукции и материалам &Товары - той же формулой, что ИсточникиПотребности.
//
Функция ТекстЗапросаДефицитаПродукции()

	Возврат
	"ВЫБРАТЬ
	|	Остатки.Продукция КАК Продукция,
	|	Остатки.Материал КАК Материал,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.ПотребностьОстаток - Остатки.ИзОстаткаОстаток - ВЫБОР
	|		КОГДА Остатки.ЗаказаноОстаток > Остатки.ПришлоОстаток
	|			ТОГДА Остатки.ЗаказаноОстаток
	|		ИНАЧЕ Остатки.ПришлоОстаток
	|	КОНЕЦ КАК Дефицит
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства.Остатки(
	|			,
	|			Заказ = &Заказ
	|				И Материал В (&Товары)) КАК Остатки
	|ГДЕ
	|	Остатки.ПотребностьОстаток - Остатки.ИзОстаткаОстаток - ВЫБОР
	|			КОГДА Остатки.ЗаказаноОстаток > Остатки.ПришлоОстаток
	|				ТОГДА Остатки.ЗаказаноОстаток
	|			ИНАЧЕ Остатки.ПришлоОстаток
	|		КОНЕЦ > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Продукция";

КонецФункции

// Параметры:
//  Товары - Массив из СправочникСсылка.Номенклатура - товары строк «Заказать».
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - товары, по которым есть непомеченные непроведённые заказы поставщику.
//
Функция ТоварыСЧерновикамиЗаказов(Товары)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыЗаказов.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ЗаказПоставщику.ТЧТовары КАК ТоварыЗаказов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Черновики
	|		ПО ТоварыЗаказов.Ссылка = Черновики.Ссылка
	|ГДЕ
	|	ТоварыЗаказов.Номенклатура В (&Товары)
	|	И НЕ Черновики.Проведен
	|	И НЕ Черновики.ПометкаУдаления");
	Запрос.УстановитьПараметр("Товары", Товары);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");

КонецФункции

// Возвращаемое значение:
//  Строка - отказ «Заказать» по товару с черновиком заказа поставщику.
//
Функция ТекстЕстьЧерновикЗаказа()

	Возврат НСтр("ru = 'есть черновик заказа поставщику по товару: проведите или удалите его (внизу, «Заказы поставщикам»).';
		|fr = 'une commande fournisseur brouillon existe pour l''article : validez-la ou supprimez-la.';
		|en = 'there is a draft supplier order for the item: post or delete it first.';
		|es = 'hay un borrador de pedido a proveedor del artículo: contabilícelo o elimínelo.'");

КонецФункции

// Параметры:
//  Пополнение - Булево - строка пополнения склада.
//  Дефицит    - Число - дефицит источника под блокировкой.
//  Ожидаемый  - Число - дефицит источника, прочитанный перед записью.
//
// Возвращаемое значение:
//  Булево - строку нельзя заказывать: пополнение - дефицит уменьшился; производство - дефицита нет.
//
Функция ДефицитИзменился(Пополнение, Дефицит, Ожидаемый)

	Возврат ?(Пополнение, Дефицит < Ожидаемый, Дефицит <= 0);

КонецФункции

// Параметры:
//  Источники      - ТаблицаЗначений - см. ИсточникиПотребности.
//  Источник       - ДокументСсылка.ЗаказПокупателя - заказ клиента; пустая - пополнение.
//  Номенклатура   - СправочникСсылка.Номенклатура - товар.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика.
//
// Возвращаемое значение:
//  Число - дефицит источника по товару; источника нет - 0.
//
Функция ДефицитИсточника(Источники, Источник, Номенклатура, Характеристика)

	Отбор = Новый Структура("Источник, Номенклатура, Характеристика", Источник, Номенклатура, Характеристика);
	Дефицит = 0;
	Для Каждого Найденная Из Источники.НайтиСтроки(Отбор) Цикл
		Дефицит = Дефицит + Найденная.Дефицит;
	КонецЦикла;
	Возврат Дефицит;

КонецФункции

// Исключительная блокировка «Заказов поставщикам» по товарам пополнения перед перепроверкой дефицита: заказ пополнения,
// оформляемый параллельно, ждёт её (ревью плана 2.0.16.30, раунд 2, P3-b).
//
// Параметры:
//  Товары - Массив из СправочникСсылка.Номенклатура - товары строк.
//
Процедура ЗаблокироватьЗаказыТоваров(Товары)

	Поле = "Номенклатура";
	Источник = Новый ТаблицаЗначений;
	Источник.Колонки.Добавить(Поле, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Для Каждого Товар Из Товары Цикл
		Источник.Добавить()[Поле] = Товар;
	КонецЦикла;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.ЗаказыПоставщикам");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.ИсточникДанных = Источник;
	Элемент.ИспользоватьИзИсточникаДанных(Поле, Поле);
	Блокировка.Заблокировать();

КонецПроцедуры

// Возвращаемое значение:
//  Строка - пакет источников потребности, см. ИсточникиПотребности; условия &УсловиеМатериала (по
//           РегистрНакопления.ПотребностиПроизводства) и &УсловиеПозиции (по справочнику Номенклатура) подставляются.
//
Функция ТекстЗапросаПотребности()

	// Части кончаются разделителем пакета: перевод строки не даёт строке-разделителю поглотить следующий запрос.
	Возврат ТекстЗапросаПотребностиПроизводства() + Символы.ПС + ТекстЗапросаПополнения() + Символы.ПС
		+ ТекстЗапросаИсточников();

КонецФункции

// Возвращаемое значение:
//  Строка - часть пакета: ВТЗаказыВРаботе (заказы клиентов на стадии до выпуска по последней записи стадии) и
//           ВТСтрокиПотребности (остатки регистра потребностей этих заказов с условием &УсловиеМатериала).
//
Функция ТекстЗапросаПотребностиПроизводства()

	Возврат
	"ВЫБРАТЬ
	|	История.ЗаказПокупателя КАК Заказ,
	|	МАКСИМУМ(История.Период) КАК Период
	|ПОМЕСТИТЬ ВТПериодыСтадий
	|ИЗ
	|	РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам КАК История
	|ГДЕ
	|	История.Индикатор <> """"
	|	И &ПроизводствоВключено
	|	И &УсловиеЗаказовИстории
	|
	|СГРУППИРОВАТЬ ПО
	|	История.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Заказы.Ссылка КАК Заказ,
	|	Заказы.ДатаОтгрузки КАК ДатаОтгрузки
	|ПОМЕСТИТЬ ВТЗаказыВРаботе
	|ИЗ
	|	ВТПериодыСтадий КАК Периоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам КАК История
	|		ПО Периоды.Заказ = История.ЗаказПокупателя
	|			И Периоды.Период = История.Период
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
	|		ПО Периоды.Заказ = Заказы.Ссылка
	|ГДЕ
	|	История.СтатусЗаказаПокупателя В (&СтадииДоВыпуска)
	|	И Заказы.Проведен
	|	И НЕ Заказы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Заказ КАК Заказ,
	|	Остатки.Продукция КАК Продукция,
	|	Остатки.Материал КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.ПотребностьОстаток КАК Потребность,
	|	Остатки.ЗаказаноОстаток КАК Заказано,
	|	Остатки.ПришлоОстаток КАК Пришло,
	|	Остатки.ИзОстаткаОстаток КАК ИзОстатка
	|ПОМЕСТИТЬ ВТСтрокиПотребности
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства.Остатки(
	|			,
	|			Заказ В
	|					(ВЫБРАТЬ
	|						ВТЗаказыВРаботе.Заказ КАК Заказ
	|					ИЗ
	|						ВТЗаказыВРаботе КАК ВТЗаказыВРаботе)
	|				И &УсловиеМатериала) КАК Остатки
	|ГДЕ
	|	Остатки.ПотребностьОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////";

КонецФункции

// Возвращаемое значение:
//  Строка - часть пакета: ВТМинимумы (минимум склада с оповещением по товару с условием &УсловиеПозиции), партии под
//           заказы до выпуска, ВТПополнение (дефицит складов) и ВТЗаказаноПополнение (остатки заказов без заказа
//           клиента).
//
Функция ТекстЗапросаПополнения()

	Возврат
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Склад,
	|	Позиции.Ссылка КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Минимумы.МинимальноеКоличествоХранения, 0) = 0
	|			ТОГДА Позиции.МинимальноеКоличествоХранения
	|		ИНАЧЕ Минимумы.МинимальноеКоличествоХранения
	|	КОНЕЦ КАК Минимум
	|ПОМЕСТИТЬ ВТМинимумы
	|ИЗ
	|	Справочник.МестаХранения КАК Склады
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Позиции
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальныйОстатокПоСкладам КАК Минимумы
	|		ПО Склады.Ссылка = Минимумы.МестоХранения
	|			И Позиции.Ссылка = Минимумы.Номенклатура
	|ГДЕ
	|	Склады.ОповещатьОМинимальномОстатке
	|	И НЕ Склады.ПометкаУдаления
	|	И НЕ Позиции.ЭтоГруппа
	|	И НЕ Позиции.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА ЕСТЬNULL(Минимумы.МинимальноеКоличествоХранения, 0) = 0
	|				ТОГДА Позиции.МинимальноеКоличествоХранения
	|			ИНАЧЕ Минимумы.МинимальноеКоличествоХранения
	|		КОНЕЦ > 0
	|	И &УсловиеПозиции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Поступления.Ссылка КАК Партия
	|ПОМЕСТИТЬ ВТПартииПодЗаказы
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|ГДЕ
	|	Поступления.Основание В
	|			(ВЫБРАТЬ
	|				ВТЗаказыВРаботе.Заказ КАК Заказ
	|			ИЗ
	|				ВТЗаказыВРаботе КАК ВТЗаказыВРаботе)
	|	И &УсловиеПоступлений
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Поступления.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК ЗаказыОснования
	|		ПО Поступления.Основание = ЗаказыОснования.Ссылка
	|ГДЕ
	|	ЗаказыОснования.Основание В
	|			(ВЫБРАТЬ
	|				ВТЗаказыВРаботе.Заказ КАК Заказ
	|			ИЗ
	|				ВТЗаказыВРаботе КАК ВТЗаказыВРаботе)
	|	И &УсловиеПоступлений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.МестоХранения КАК Склад,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.КоличествоОстаток) КАК НаСкладе
	|ПОМЕСТИТЬ ВТНаСкладе
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			,
	|			(МестоХранения, Номенклатура) В
	|				(ВЫБРАТЬ
	|					ВТМинимумы.Склад КАК Склад,
	|					ВТМинимумы.Номенклатура КАК Номенклатура
	|				ИЗ
	|					ВТМинимумы КАК ВТМинимумы)) КАК Остатки
	|ГДЕ
	|	НЕ Остатки.Партия В
	|				(ВЫБРАТЬ
	|					ВТПартииПодЗаказы.Партия КАК Партия
	|				ИЗ
	|					ВТПартииПодЗаказы КАК ВТПартииПодЗаказы)
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.МестоХранения,
	|	Остатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТМинимумы.Номенклатура КАК Номенклатура,
	|	СУММА(ВТМинимумы.Минимум) КАК Нужно,
	|	СУММА(ЕСТЬNULL(Наличие.НаСкладе, 0)) КАК НаСкладе,
	|	СУММА(ВЫБОР
	|			КОГДА ВТМинимумы.Минимум - ЕСТЬNULL(Наличие.НаСкладе, 0) > 0
	|				ТОГДА ВТМинимумы.Минимум - ЕСТЬNULL(Наличие.НаСкладе, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ДефицитСкладов
	|ПОМЕСТИТЬ ВТПополнение
	|ИЗ
	|	ВТМинимумы КАК ВТМинимумы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНаСкладе КАК Наличие
	|		ПО ВТМинимумы.Склад = Наличие.Склад
	|			И ВТМинимумы.Номенклатура = Наличие.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТМинимумы.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.ЗаказПоставщику КАК ЗаказПоставщику,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТОстаткиЗаказов
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	|			,
	|			Номенклатура В
	|				(ВЫБРАТЬ
	|					ВТПополнение.Номенклатура КАК Номенклатура
	|				ИЗ
	|					ВТПополнение КАК ВТПополнение)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(ВЫБОР
	|			КОГДА Остатки.Количество > 0
	|				ТОГДА Остатки.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Заказано
	|ПОМЕСТИТЬ ВТЗаказаноПополнение
	|ИЗ
	|	ВТОстаткиЗаказов КАК Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК ЗаказыПополнения
	|		ПО Остатки.ЗаказПоставщику = ЗаказыПополнения.Ссылка
	|ГДЕ
	|	ЗаказыПополнения.Проведен
	|	И НЕ ЗаказыПополнения.ПометкаУдаления
	|	И ЗаказыПополнения.Основание = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|	И ЗаказыПополнения.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовПоставщику.Предварительный)
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////";

КонецФункции

// Возвращаемое значение:
//  Строка - часть пакета: ВТИсточники (производство и пополнение), цены основного поставщика и итоговая выборка.
//
Функция ТекстЗапросаИсточников()

	Возврат
	"ВЫБРАТЬ
	|	СтрокиПотребности.Заказ КАК Источник,
	|	СтрокиПотребности.Номенклатура КАК Номенклатура,
	|	СтрокиПотребности.Характеристика КАК Характеристика,
	|	СУММА(СтрокиПотребности.Потребность) КАК Нужно,
	|	СУММА(СтрокиПотребности.Заказано) КАК Заказано,
	|	СУММА(СтрокиПотребности.Пришло) КАК Пришло,
	|	СУММА(СтрокиПотребности.ИзОстатка) КАК СоСклада,
	|	0 КАК НаСкладе,
	|	СУММА(ВЫБОР
	|			КОГДА СтрокиПотребности.Потребность - СтрокиПотребности.ИзОстатка - ВЫБОР
	|					КОГДА СтрокиПотребности.Заказано > СтрокиПотребности.Пришло
	|						ТОГДА СтрокиПотребности.Заказано
	|					ИНАЧЕ СтрокиПотребности.Пришло
	|				КОНЕЦ > 0
	|				ТОГДА СтрокиПотребности.Потребность - СтрокиПотребности.ИзОстатка - ВЫБОР
	|						КОГДА СтрокиПотребности.Заказано > СтрокиПотребности.Пришло
	|							ТОГДА СтрокиПотребности.Заказано
	|						ИНАЧЕ СтрокиПотребности.Пришло
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Дефицит
	|ПОМЕСТИТЬ ВТИсточники
	|ИЗ
	|	ВТСтрокиПотребности КАК СтрокиПотребности
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиПотребности.Заказ,
	|	СтрокиПотребности.Номенклатура,
	|	СтрокиПотребности.Характеристика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка),
	|	Пополнение.Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка),
	|	Пополнение.Нужно,
	|	ЕСТЬNULL(ЗаказаноПополнение.Заказано, 0),
	|	0,
	|	0,
	|	Пополнение.НаСкладе,
	|	ВЫБОР
	|		КОГДА Пополнение.ДефицитСкладов - ЕСТЬNULL(ЗаказаноПополнение.Заказано, 0) > 0
	|			ТОГДА Пополнение.ДефицитСкладов - ЕСТЬNULL(ЗаказаноПополнение.Заказано, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	ВТПополнение КАК Пополнение
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗаказаноПополнение КАК ЗаказаноПополнение
	|		ПО Пополнение.Номенклатура = ЗаказаноПополнение.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Цены.Номенклатура КАК Номенклатура,
	|	Цены.Характеристика КАК Характеристика,
	|	Цены.Контрагент КАК Контрагент,
	|	МАКСИМУМ(Цены.ЦенаЕдиницыХранения) КАК Цена
	|ПОМЕСТИТЬ ВТЦены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатурыПоставщиков.СрезПоследних(
	|			,
	|			Номенклатура В
	|				(ВЫБРАТЬ
	|					ВТИсточники.Номенклатура КАК Номенклатура
	|				ИЗ
	|					ВТИсточники КАК ВТИсточники)) КАК Цены
	|
	|СГРУППИРОВАТЬ ПО
	|	Цены.Номенклатура,
	|	Цены.Характеристика,
	|	Цены.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЦены.Номенклатура КАК Номенклатура,
	|	ВТЦены.Контрагент КАК Контрагент,
	|	МАКСИМУМ(ВТЦены.Цена) КАК Цена
	|ПОМЕСТИТЬ ВТЦеныТовара
	|ИЗ
	|	ВТЦены КАК ВТЦены
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЦены.Номенклатура,
	|	ВТЦены.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Источники.Источник КАК Источник,
	|	Источники.Номенклатура КАК Номенклатура,
	|	Источники.Характеристика КАК Характеристика,
	|	Источники.Нужно КАК Нужно,
	|	Источники.Заказано КАК Заказано,
	|	Источники.Пришло КАК Пришло,
	|	Источники.СоСклада КАК СоСклада,
	|	Источники.НаСкладе КАК НаСкладе,
	|	Источники.Дефицит КАК Дефицит,
	|	ЕСТЬNULL(ЗаказыВРаботе.ДатаОтгрузки, ДАТАВРЕМЯ(3999, 12, 31)) КАК ДатаОтгрузки,
	|	Позиции.ОсновнойПоставщик КАК Поставщик,
	|	ЕСТЬNULL(Цены.Цена, ЕСТЬNULL(ЦеныТовара.Цена, 0)) КАК Цена
	|ИЗ
	|	ВТИсточники КАК Источники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Позиции
	|		ПО Источники.Номенклатура = Позиции.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗаказыВРаботе КАК ЗаказыВРаботе
	|		ПО Источники.Источник = ЗаказыВРаботе.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК Цены
	|		ПО Источники.Номенклатура = Цены.Номенклатура
	|			И Источники.Характеристика = Цены.Характеристика
	|			И Позиции.ОсновнойПоставщик = Цены.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦеныТовара КАК ЦеныТовара
	|		ПО Источники.Номенклатура = ЦеныТовара.Номенклатура
	|			И Позиции.ОсновнойПоставщик = ЦеныТовара.Контрагент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Позиции.Наименование,
	|	Характеристика,
	|	ДатаОтгрузки";

КонецФункции

// Возвращаемое значение:
//  Строка - строки заказов поставщику по товару &Номенклатура и характеристике &Характеристика: черновики и проведённые
//           с остатком к поступлению, первые 100 от новых.
//
Функция ТекстЗапросаЗаказовТовара()

	Возврат
	"ВЫБРАТЬ
	|	Остатки.ЗаказПоставщику КАК Заказ,
	|	СУММА(Остатки.КоличествоОстаток) КАК Осталось
	|ПОМЕСТИТЬ ВТОсталось
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Характеристика = &Характеристика) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.ЗаказПоставщику
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 100
	|	Заказы.Ссылка КАК Документ,
	|	Заказы.Дата КАК Дата,
	|	Заказы.Контрагент КАК Поставщик,
	|	Заказы.Основание КАК ЗаказКлиента,
	|	Заказы.Проведен КАК Проведен,
	|	СУММА(Товары.Количество) КАК Заказано,
	|	ЕСТЬNULL(МАКСИМУМ(ВТОсталось.Осталось), 0) КАК Осталось
	|ИЗ
	|	Документ.ЗаказПоставщику.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказы
	|		ПО Товары.Ссылка = Заказы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОсталось КАК ВТОсталось
	|		ПО Заказы.Ссылка = ВТОсталось.Заказ
	|ГДЕ
	|	Товары.Номенклатура = &Номенклатура
	|	И Товары.Характеристика = &Характеристика
	|	И НЕ Заказы.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА Заказы.Проведен
	|				ТОГДА ЕСТЬNULL(ВТОсталось.Осталось, 0) > 0
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	Заказы.Ссылка,
	|	Заказы.Дата,
	|	Заказы.Контрагент,
	|	Заказы.Основание,
	|	Заказы.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";

КонецФункции

// Возвращаемое значение:
//  Строка - остатки товара &Номенклатура с характеристикой &Характеристика по складам.
//
Функция ТекстЗапросаОстатковТовара()

	Возврат
	"ВЫБРАТЬ
	|	Остатки.МестоХранения КАК Склад,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Характеристика = &Характеристика) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.МестоХранения
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.КоличествоОстаток) <> 0";

КонецФункции

#Область Тендеры

// Параметры:
//  Строки     - Произвольный - см. ЗапроситьПредложения.
//  Поставщики - Произвольный - см. ЗапроситьПредложения.
//
// Возвращаемое значение:
//  Строка - отказ: тендеры выключены, нет строк или поставщиков, строки не одного заказа клиента; пустая - можно.
//
Функция ТекстЗапретаЗапросаПредложений(Строки, Поставщики)

	Если Не ТендерыВключены() Тогда
		Возврат НСтр("ru = 'Тендеры поставщиков выключены в настройках.'; fr = 'Les appels d''offres fournisseurs sont
			|désactivés.'; en = 'Supplier tenders are disabled in the settings.'; es = 'Las licitaciones de proveedores están
			|desactivadas.'");
	КонецЕсли;
	СтрокиЕсть = ТипЗнч(Строки) = Тип("Массив") И Строки.Количество() > 0;
	ПоставщикиЕсть = ТипЗнч(Поставщики) = Тип("Массив") И Поставщики.Количество() > 0;
	Если Не СтрокиЕсть Или Не ПоставщикиЕсть Тогда
		Возврат РезультатНеверныхДанных().Текст;
	КонецЕсли;
	Заказ = Строки[0].Источник;
	Для Каждого Строка Из Строки Цикл
		КоличествоВерно = ТипЗнч(Строка.Количество) = Тип("Число") И Строка.Количество > 0;
		Если Не ЗначениеЗаполнено(Строка.Источник) Или Строка.Источник <> Заказ Или Не КоличествоВерно Тогда
			Возврат НСтр("ru = 'Предложения запрашиваются по строкам одного заказа клиента: группировка «по заказу клиента».';
				|fr = 'Les offres se demandent pour les lignes d''une seule commande client : regroupement « par commande client ».';
				|en = 'Offers are requested for lines of one customer order: grouping ""by customer order"".';
				|es = 'Las ofertas se piden para líneas de un solo pedido del cliente: agrupación «por pedido del cliente».'");
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Параметры:
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//  Поставщик - СправочникСсылка.Контрагенты - поставщик.
//  Товары    - Массив из СправочникСсылка.Номенклатура - материалы запроса.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - материалы из Товары, которые уже есть в непомеченных предложениях
//                                            поставщика по заказу.
//
Функция МатериалыПредложенийПоставщика(Заказ, Поставщик, Товары)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыПредложений.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ПредложениеПоставщика.ТЧТовары КАК ТоварыПредложений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПредложениеПоставщика КАК Предложения
	|		ПО ТоварыПредложений.Ссылка = Предложения.Ссылка
	|ГДЕ
	|	Предложения.ЗаказПокупателя = &Заказ
	|	И Предложения.Поставщик = &Поставщик
	|	И НЕ Предложения.ПометкаУдаления
	|	И ТоварыПредложений.Номенклатура В (&Товары)");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("Товары", Товары);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");

КонецФункции

// Черновик предложения поставщику по строкам «Потребности»: организация - заказа клиента, договор - основной с
// поставщиком, строки - материалы в единицах хранения с ценой последнего прайса этого поставщика.
//
// Параметры:
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//  Поставщик - СправочникСсылка.Контрагенты - поставщик.
//  Строки    - Массив из Структура - см. ЗапроситьПредложения.
//
// Возвращаемое значение:
//  Структура - см. ИтогЗаказаПотребности.
//
Функция НовоеПредложениеПотребности(Заказ, Поставщик, Строки)

	Предложение = Документы.ПредложениеПоставщика.СоздатьДокумент();
	Предложение.Заполнить(Неопределено);
	Предложение.Дата = ТекущаяДатаСеанса();
	Предложение.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заказ, "Организация");
	Предложение.ЗаказПокупателя = Заказ;
	Предложение.Поставщик = Поставщик;
	Предложение.Договор = ОбщегоНазначенияВызовСервера.ПолучитьОсновнойДоговор(Поставщик, Предложение.Организация, Ложь);
	Товары = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Товары.Добавить(Строка.Номенклатура);
	КонецЦикла;
	Цены = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(ТекущаяДатаСеанса(), Товары, Поставщик);
	Для Каждого Строка Из Строки Цикл
		СтрокаПредложения = Предложение.ТЧТовары.Добавить();
		СтрокаПредложения.КодСтроки = Предложение.ТЧТовары.Количество();
		СтрокаПредложения.Номенклатура = Строка.Номенклатура;
		СтрокаПредложения.Характеристика = Строка.Характеристика;
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.Номенклатура, "Единица, СтавкаНДС");
		СтрокаПредложения.Упаковка = Реквизиты.Единица;
		СтрокаПредложения.СтавкаНДС = Реквизиты.СтавкаНДС;
		СтрокаПредложения.КоличествоУпаковок = Строка.Количество;
		СтрокаПредложения.Количество = Строка.Количество;
		Цена = Цены.Найти(Строка.Номенклатура, "Номенклатура");
		СтрокаПредложения.Цена = ?(Цена = Неопределено, 0, Цена.Цена);
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаПредложения, Предложение.ЦенаВключаетНДС);
	КонецЦикла;
	Попытка
		Предложение.Записать();
	Исключение
		Возврат ИтогЗаказаПотребности(Поставщик, Заказ, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат ИтогЗаказаПотребности(Поставщик, Заказ, "", Истина, Предложение.Ссылка);

КонецФункции

// Параметры:
//  Шапка - Структура - Поставщик, ЗаказПокупателя, Организация, Победитель, ПометкаУдаления предложения.
//
// Возвращаемое значение:
//  Строка - отказ «Заказать у победителя»: помечено, не победитель, нет заказа клиента, организация другая; пустая -
//           можно (заказ клиента в работе и проводимость проверяет общий путь).
//
Функция ТекстЗапретаПредложения(Шапка)

	Если Шапка.ПометкаУдаления Тогда
		Возврат НСтр("ru = 'Предложение помечено на удаление.'; fr = 'L''offre est marquée pour suppression.';
			|en = 'The offer is marked for deletion.'; es = 'La oferta está marcada para eliminar.'");
	ИначеЕсли Не Шапка.Победитель Тогда
		Возврат НСтр("ru = 'Сначала выберите предложение победителем.'; fr = 'Choisissez d''abord l''offre gagnante.';
			|en = 'Select the offer as the winner first.'; es = 'Elija primero la oferta ganadora.'");
	ИначеЕсли Не ЗначениеЗаполнено(Шапка.ЗаказПокупателя) Тогда
		Возврат РезультатНеверныхДанных().Текст;
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шапка.ЗаказПокупателя, "Организация") <> Шапка.Организация Тогда
		Возврат НСтр("ru = 'Организация предложения не совпадает с организацией заказа клиента.';
			|fr = 'L''organisation de l''offre diffère de celle de la commande client.';
			|en = 'The offer organization differs from the customer order organization.';
			|es = 'La organización de la oferta no coincide con la del pedido del cliente.'");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Строки предложения к заказу: свёрнуты по товару (повтор материала дал бы перезаказ, P1-1), в единицах хранения с ценой
// за единицу (P1-3); строки без дефицита заказа клиента и товары с черновиками заказов поставщику отбрасываются.
//
// Параметры:
//  Предложение - ДокументСсылка.ПредложениеПоставщика - победившее предложение.
//  Заказ       - ДокументСсылка.ЗаказПокупателя - заказ клиента предложения.
//
// Возвращаемое значение:
//  Структура - СтрокиДанных (Массив из Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента),
//              Ожидаемые (Массив из Число), Пояснение (Строка - что отброшено).
//
Функция СтрокиПредложенияКЗаказу(Предложение, Заказ)

	Результат = Новый Структура("СтрокиДанных, Ожидаемые, Пояснение", Новый Массив, Новый Массив, "");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Предложения.Поставщик КАК Поставщик,
	|	ТоварыПредложения.Номенклатура КАК Номенклатура,
	|	ТоварыПредложения.Характеристика КАК Характеристика,
	|	ТоварыПредложения.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ТоварыПредложения.Количество) КАК Количество,
	|	СУММА(ТоварыПредложения.Сумма) КАК Сумма
	|ИЗ
	|	Документ.ПредложениеПоставщика.ТЧТовары КАК ТоварыПредложения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПредложениеПоставщика КАК Предложения
	|		ПО ТоварыПредложения.Ссылка = Предложения.Ссылка
	|ГДЕ
	|	ТоварыПредложения.Ссылка = &Предложение
	|
	|СГРУППИРОВАТЬ ПО
	|	Предложения.Поставщик,
	|	ТоварыПредложения.Номенклатура,
	|	ТоварыПредложения.Характеристика,
	|	ТоварыПредложения.СтавкаНДС");
	Запрос.УстановитьПараметр("Предложение", Предложение);
	СтрокиПредложения = Запрос.Выполнить().Выгрузить();
	// Ставка НДС - из предложения (ревью техдолга Codex 2026-10-09, T26); строки свёрнуты по товару, поэтому товар с
	// разными ставками в одном предложении не заказывается - его ставка не определена.
	РазныеСтавки = ТоварыСРазнымиСтавками(СтрокиПредложения);
	Товары = СтрокиПредложения.ВыгрузитьКолонку("Номенклатура");
	Источники = ИсточникиПотребности(Товары);
	ТоварыСЧерновиками = ТоварыСЧерновикамиЗаказов(Товары);
	Отброшенные = Новый Массив;
	Для Каждого СтрокаПредложения Из СтрокиПредложения Цикл
		Дефицит = ДефицитИсточника(Источники, Заказ, СтрокаПредложения.Номенклатура, СтрокаПредложения.Характеристика);
		СтрокаПодходит = Дефицит > 0 И СтрокаПредложения.Количество > 0 И СтрокаПредложения.Сумма > 0
			И ТоварыСЧерновиками.Найти(СтрокаПредложения.Номенклатура) = Неопределено
			И РазныеСтавки.Найти(КлючТовараПредложения(СтрокаПредложения)) = Неопределено;
		Если Не СтрокаПодходит Тогда
			Отброшенные.Добавить(Строка(СтрокаПредложения.Номенклатура));
			Продолжить;
		КонецЕсли;
		ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента();
		ДанныеСтроки.Вид = Обработки.АРМПроизводство.ВидЗаказПоставщику();
		ДанныеСтроки.КонтекстЗаказПоставщику = Истина;
		ДанныеСтроки.Поставщик = СтрокаПредложения.Поставщик;
		ДанныеСтроки.Заказ = Заказ;
		ДанныеСтроки.Предложение = Предложение;
		ДанныеСтроки.Материал = СтрокаПредложения.Номенклатура;
		ДанныеСтроки.Характеристика = СтрокаПредложения.Характеристика;
		ДанныеСтроки.КоличествоУпаковок = СтрокаПредложения.Количество;
		ДанныеСтроки.Цена = СтрокаПредложения.Сумма / СтрокаПредложения.Количество;
		ДанныеСтроки.ЦенаИзменена = Истина;
		ДанныеСтроки.СтавкаНДС = СтрокаПредложения.СтавкаНДС;
		Результат.СтрокиДанных.Добавить(ДанныеСтроки);
		Результат.Ожидаемые.Добавить(Дефицит);
	КонецЦикла;
	Если Отброшенные.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Не заказано (нет дефицита, нет цены, разные ставки НДС или есть черновик заказа): %1.';
			|fr = 'Non commandé (pas de manque, pas de prix, taux de TVA différents ou commande brouillon) : %1.';
			|en = 'Not ordered (no shortage, no price, different VAT rates or a draft order exists): %1.';
			|es = 'No pedido (sin déficit, sin precio, tipos de IVA distintos o con borrador de pedido): %1.'");
		Результат.Пояснение = СтрШаблон(Шаблон, СтрСоединить(Отброшенные, ", "));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Товары предложения (номенклатура и характеристика), у которых строки с разными ставками НДС.
//
// Параметры:
//  СтрокиПредложения - ТаблицаЗначений - строки, свёрнутые по товару и ставке.
//
// Возвращаемое значение:
//  Массив из Строка - ключи товаров с разными ставками, см. КлючТовараПредложения.
//
Функция ТоварыСРазнымиСтавками(СтрокиПредложения)

	Результат = Новый Массив;
	Ставки = Новый Соответствие;
	Для Каждого Товар Из СтрокиПредложения Цикл
		Ключ = КлючТовараПредложения(Товар);
		Ставка = Ставки.Получить(Ключ);
		Если Ставка = Неопределено Тогда
			Ставки.Вставить(Ключ, Товар.СтавкаНДС);
			Продолжить;
		КонецЕсли;
		Если Ставка <> Товар.СтавкаНДС И Результат.Найти(Ключ) = Неопределено Тогда
			Результат.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ключ товара строки предложения: номенклатура и характеристика.
//
// Параметры:
//  Товар - СтрокаТаблицыЗначений - строка с колонками Номенклатура, Характеристика.
//
// Возвращаемое значение:
//  Строка - ключ.
//
Функция КлючТовараПредложения(Товар)

	Возврат Строка(Товар.Номенклатура.УникальныйИдентификатор()) + "|"
		+ ?(ЗначениеЗаполнено(Товар.Характеристика), Строка(Товар.Характеристика.УникальныйИдентификатор()), "");

КонецФункции

// Параметры:
//  Первый - Строка - первый текст.
//  Второй - Строка - второй текст.
//
// Возвращаемое значение:
//  Строка - тексты через пробел без пустых.
//
Функция СоединитьТекстыИтога(Первый, Второй)

	Если ПустаяСтрока(Первый) Тогда
		Возврат Второй;
	КонецЕсли;
	Возврат ?(ПустаяСтрока(Второй), Первый, Первый + " " + Второй);

КонецФункции

// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//
// Возвращаемое значение:
//  Строка - материалы заказа, по которым после заказа у победителя остался дефицит; нет - пустая строка (ревью
//           2.0.16.31, P2-2).
//
Функция ТекстОставшегосяДефицита(Заказ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Материал КАК Материал
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства.Остатки(, Заказ = &Заказ) КАК Остатки
	|ГДЕ
	|	Остатки.ПотребностьОстаток - Остатки.ИзОстаткаОстаток - ВЫБОР
	|			КОГДА Остатки.ЗаказаноОстаток > Остатки.ПришлоОстаток
	|				ТОГДА Остатки.ЗаказаноОстаток
	|			ИНАЧЕ Остатки.ПришлоОстаток
	|		КОНЕЦ > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Материал");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Материалы = Новый Массив;
	Для Каждого Материал Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Материал") Цикл
		Материалы.Добавить(Строка(Материал));
	КонецЦикла;
	Если Материалы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Шаблон = НСтр("ru = 'По заказу клиента остался дефицит: %1.'; fr = 'Manque restant de la commande client : %1.';
		|en = 'Remaining shortage of the customer order: %1.'; es = 'Déficit restante del pedido del cliente: %1.'");
	Возврат СтрШаблон(Шаблон, СтрСоединить(Материалы, ", "));

КонецФункции

// Возвращаемое значение:
//  Строка - отказ: у поставщика уже есть предложение по заказу с этими материалами.
//
Функция ТекстПредложениеУжеЕсть()

	Возврат НСтр("ru = 'предложение по этому заказу с этими материалами уже есть - новое не создано.';
		|fr = 'une offre pour cette commande avec ces matières existe déjà - aucune nouvelle.';
		|en = 'an offer for this order with these materials already exists - no new one created.';
		|es = 'ya existe una oferta para este pedido con estos materiales - no se creó otra.'");

КонецФункции

// Возвращаемое значение:
//  Строка - отказ: ни одна строка предложения не закрывает дефицит заказа клиента.
//
Функция ТекстНетДефицитаВПредложении()

	Возврат НСтр("ru = 'В предложении нет материалов с дефицитом заказа клиента.';
		|fr = 'L''offre ne contient aucune matière en manque pour la commande client.';
		|en = 'The offer has no materials with a shortage for the customer order.';
		|es = 'La oferta no tiene materiales con déficit del pedido del cliente.'");

КонецФункции

// Возвращаемое значение:
//  Строка - предложения товара по заказам &Заказы с ценой товара, суммой в основной валюте и покрытием дефицита заказа.
//
Функция ТекстЗапросаПредложенийТовара()

	Возврат
	"ВЫБРАТЬ
	|	Остатки.Заказ КАК Заказ,
	|	Остатки.Материал КАК Материал
	|ПОМЕСТИТЬ ВТДефициты
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства.Остатки(, Заказ В (&Заказы)) КАК Остатки
	|ГДЕ
	|	Остатки.ПотребностьОстаток - Остатки.ИзОстаткаОстаток - ВЫБОР
	|			КОГДА Остатки.ЗаказаноОстаток > Остатки.ПришлоОстаток
	|				ТОГДА Остатки.ЗаказаноОстаток
	|			ИНАЧЕ Остатки.ПришлоОстаток
	|		КОНЕЦ > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Заказ,
	|	Остатки.Материал
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Предложения.Ссылка КАК Предложение,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТДефициты.Материал) КАК Покрыто
	|ПОМЕСТИТЬ ВТПокрытие
	|ИЗ
	|	Документ.ПредложениеПоставщика КАК Предложения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПредложениеПоставщика.ТЧТовары КАК ТоварыПредложений
	|		ПО Предложения.Ссылка = ТоварыПредложений.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДефициты КАК ВТДефициты
	|		ПО Предложения.ЗаказПокупателя = ВТДефициты.Заказ
	|			И ТоварыПредложений.Номенклатура = ВТДефициты.Материал
	|ГДЕ
	|	Предложения.ЗаказПокупателя В (&Заказы)
	|	И НЕ Предложения.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	Предложения.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДефициты.Заказ КАК Заказ,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТДефициты.Материал) КАК ВсегоДефицитов
	|ПОМЕСТИТЬ ВТВсегоДефицитов
	|ИЗ
	|	ВТДефициты КАК ВТДефициты
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТДефициты.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Предложения.Ссылка КАК Предложение,
	|	Предложения.Поставщик КАК Поставщик,
	|	Предложения.ЗаказПокупателя КАК Заказ,
	|	ВЫБОР
	|		КОГДА СУММА(ТоварыПредложений.Количество) = 0
	|			ТОГДА 0
	|		ИНАЧЕ СУММА(ТоварыПредложений.Сумма) / СУММА(ТоварыПредложений.Количество)
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА Предложения.ВВалюте
	|			ТОГДА Предложения.СуммаРегл
	|		ИНАЧЕ Предложения.Сумма
	|	КОНЕЦ КАК СуммаРегл,
	|	Предложения.СрокПоставкиДней КАК СрокПоставкиДней,
	|	Предложения.Победитель КАК Победитель,
	|	ЕСТЬNULL(Покрытие.Покрыто, 0) КАК Покрыто,
	|	ЕСТЬNULL(Всего.ВсегоДефицитов, 0) КАК ВсегоДефицитов
	|ИЗ
	|	Документ.ПредложениеПоставщика КАК Предложения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПредложениеПоставщика.ТЧТовары КАК ТоварыПредложений
	|		ПО Предложения.Ссылка = ТоварыПредложений.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПокрытие КАК Покрытие
	|		ПО Предложения.Ссылка = Покрытие.Предложение
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВсегоДефицитов КАК Всего
	|		ПО Предложения.ЗаказПокупателя = Всего.Заказ
	|ГДЕ
	|	Предложения.ЗаказПокупателя В (&Заказы)
	|	И НЕ Предложения.ПометкаУдаления
	|	И ТоварыПредложений.Номенклатура = &Номенклатура
	|	И ТоварыПредложений.Характеристика = &Характеристика
	|
	|СГРУППИРОВАТЬ ПО
	|	Предложения.Ссылка,
	|	Предложения.Поставщик,
	|	Предложения.ЗаказПокупателя,
	|	Предложения.ВВалюте,
	|	Предложения.СуммаРегл,
	|	Предложения.Сумма,
	|	Предложения.СрокПоставкиДней,
	|	Предложения.Победитель,
	|	Покрытие.Покрыто,
	|	Всего.ВсегоДефицитов
	|
	|УПОРЯДОЧИТЬ ПО
	|	СуммаРегл";

КонецФункции

// Колонка «Тендер» строк «Потребности» по заказу клиента: «запрошено N» или «победитель: поставщик» - одним запросом
// по заказам строк.
//
// Параметры:
//  Строки - ТаблицаЗначений - см. СтрокиПотребности, группировка по заказу клиента; получает колонку Тендер.
//
Процедура ЗаполнитьТендерСтрок(Строки)

	Заказы = Новый Массив;
	Для Каждого СтрокаПотребности Из Строки Цикл
		Если ЗначениеЗаполнено(СтрокаПотребности.Источник) И Заказы.Найти(СтрокаПотребности.Источник) = Неопределено Тогда
			Заказы.Добавить(СтрокаПотребности.Источник);
		КонецЕсли;
	КонецЦикла;
	Если Заказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Предложения.ЗаказПокупателя КАК Заказ,
	|	ТоварыПредложений.Номенклатура КАК Номенклатура,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Предложения.Ссылка) КАК Запрошено,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Предложения.Победитель
	|				ТОГДА Предложения.Поставщик
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|		КОНЕЦ) КАК Победитель
	|ИЗ
	|	Документ.ПредложениеПоставщика.ТЧТовары КАК ТоварыПредложений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПредложениеПоставщика КАК Предложения
	|		ПО ТоварыПредложений.Ссылка = Предложения.Ссылка
	|ГДЕ
	|	Предложения.ЗаказПокупателя В (&Заказы)
	|	И НЕ Предложения.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	Предложения.ЗаказПокупателя,
	|	ТоварыПредложений.Номенклатура");
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Тендеры = Запрос.Выполнить().Выгрузить();
	ШаблонЗапрошено = НСтр("ru = 'запрошено %1'; fr = 'demandé %1'; en = 'requested %1'; es = 'solicitado %1'");
	ШаблонПобедитель = НСтр("ru = 'победитель: %1'; fr = 'gagnant : %1'; en = 'winner: %1'; es = 'ganador: %1'");
	Для Каждого СтрокаПотребности Из Строки Цикл
		Отбор = Новый Структура("Заказ, Номенклатура", СтрокаПотребности.Источник, СтрокаПотребности.Номенклатура);
		Найденные = Тендеры.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Тендер = Найденные[0];
		СтрокаПотребности.Тендер = ?(ЗначениеЗаполнено(Тендер.Победитель), СтрШаблон(ШаблонПобедитель, Тендер.Победитель),
			СтрШаблон(ШаблонЗапрошено, Тендер.Запрошено));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

// Возвращаемое значение:
//  Структура - строка таблицы «Заказы» формы.
//
Функция НоваяСтрокаЗаказа()

	Возврат Новый Структура("Заказ, Номер, Дата, Поставщик, Статус, Индикатор, ДатаПоставки, Сумма, Валюта, ЗаказКлиента,
		|Ответственный, ВидЗаказа");

КонецФункции

// Пакет: ВТЗаказы - заказы по отборам панели, ВТДвижения - заказано, пришло и остаток по регистру, ВТСтатусы -
// вычисляемый статус. «Пришло» - расход регистраторами поступлений и возвратов (у возврата количество уже
// отрицательное), а не нулевой остаток: строки, забранные другим заказом поставщику, - «перенесено». Условия отборов
// вставляются в текст только для заполненных отборов, параметры ставятся в запрос.
//
// Параметры:
//  Запрос - Запрос - запрос, которому ставятся параметры отборов.
//  Отборы - Структура - см. НовыеОтборы.
//
// Возвращаемое значение:
//  Строка - текст пакета.
//
Функция ТекстЗапросаСтатусов(Запрос, Отборы)

	Условия = Новый Массив;
	Если ТипЗнч(Отборы.Поставщик) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Отборы.Поставщик) Тогда
		Условия.Добавить("Заказы.Контрагент = &Поставщик");
		Запрос.УстановитьПараметр("Поставщик", Отборы.Поставщик);
	КонецЕсли;
	Если ТипЗнч(Отборы.Ответственный) = Тип("СправочникСсылка.Пользователи") И ЗначениеЗаполнено(Отборы.Ответственный) Тогда
		Условия.Добавить("Заказы.Ответственный = &Ответственный");
		Запрос.УстановитьПараметр("Ответственный", Отборы.Ответственный);
	КонецЕсли;
	Если ТипЗнч(Отборы.ВидЗаказа) = Тип("ПеречислениеСсылка.ВидыЗаказовПоставщику") И ЗначениеЗаполнено(Отборы.ВидЗаказа) Тогда
		Условия.Добавить("Заказы.ВидЗаказа = &ВидЗаказа");
		Запрос.УстановитьПараметр("ВидЗаказа", Отборы.ВидЗаказа);
	Иначе
		Условия.Добавить("Заказы.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.ВидыЗаказовПоставщику.Предварительный)");
	КонецЕсли;
	Если ТипЗнч(Отборы.ПериодПоставки) = Тип("СтандартныйПериод") Тогда
		Если ЗначениеЗаполнено(Отборы.ПериодПоставки.ДатаНачала) Тогда
			Условия.Добавить("Заказы.ДатаПоставки >= &НачалоПоставки");
			Запрос.УстановитьПараметр("НачалоПоставки", Отборы.ПериодПоставки.ДатаНачала);
		КонецЕсли;
		Если ЗначениеЗаполнено(Отборы.ПериодПоставки.ДатаОкончания) Тогда
			Условия.Добавить("Заказы.ДатаПоставки МЕЖДУ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 1) И &КонецПоставки");
			Запрос.УстановитьПараметр("КонецПоставки", Отборы.ПериодПоставки.ДатаОкончания);
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Отборы.Товар) = Тип("СправочникСсылка.Номенклатура") И ЗначениеЗаполнено(Отборы.Товар) Тогда
		Условия.Добавить("Заказы.Ссылка В
		|			(ВЫБРАТЬ
		|				ТоварыОтбора.Ссылка КАК Ссылка
		|			ИЗ
		|				Документ.ЗаказПоставщику.ТЧТовары КАК ТоварыОтбора
		|			ГДЕ
		|				ТоварыОтбора.Номенклатура = &Товар)");
		Запрос.УстановитьПараметр("Товар", Отборы.Товар);
	КонецЕсли;
	// Граница просрочки берётся при каждом чтении страницы, а не при открытии формы: после полуночи статус не отстаёт.
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДатаСеанса()));

	Текст =
	"ВЫБРАТЬ
	|	Заказы.Ссылка КАК Ссылка,
	|	Заказы.Дата КАК Дата,
	|	Заказы.ДатаПоставки КАК ДатаПоставки,
	|	Заказы.Проведен КАК Проведен,
	|	Заказы.ПометкаУдаления КАК ПометкаУдаления
	|ПОМЕСТИТЬ ВТЗаказы
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Заказы
	|ГДЕ
	|	&УсловиеЗаказов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	Движения.ЗаказПоставщику КАК Заказ,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Заказано,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					И (Движения.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|						ИЛИ Движения.Регистратор ССЫЛКА Документ.ВозвратПоставщику)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Пришло,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ -Движения.Количество
	|		КОНЕЦ) КАК Остаток
	|ПОМЕСТИТЬ ВТДвижения
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам КАК Движения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗаказы КАК ЗаказыДвижений
	|		ПО Движения.ЗаказПоставщику = ЗаказыДвижений.Ссылка
	|ГДЕ
	|	Движения.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.ЗаказПоставщику
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|ВЫБРАТЬ
	|	Заказы.Ссылка КАК Ссылка,
	|	Заказы.Дата КАК Дата,
	|	ЕСТЬNULL(Движения.Заказано, 0) КАК Заказано,
	|	ЕСТЬNULL(Движения.Пришло, 0) КАК Пришло,
	|	ВЫБОР
	|		КОГДА Заказы.ПометкаУдаления
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.Отменен)
	|		КОГДА НЕ Заказы.Проведен
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.Черновик)
	|		КОГДА ЕСТЬNULL(Движения.Заказано, 0) = 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.ОжидаетПоставки)
	|		КОГДА ЕСТЬNULL(Движения.Остаток, 0) <= 0
	|				И ЕСТЬNULL(Движения.Пришло, 0) > 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.Поступил)
	|		КОГДА ЕСТЬNULL(Движения.Остаток, 0) <= 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.Перенесен)
	|		КОГДА Заказы.ДатаПоставки > ДАТАВРЕМЯ(1, 1, 1)
	|				И Заказы.ДатаПоставки < &НачалоДня
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.Просрочен)
	|		КОГДА ЕСТЬNULL(Движения.Пришло, 0) > 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.ЧастичноПоступил)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщику.ОжидаетПоставки)
	|	КОНЕЦ КАК Статус
	|ПОМЕСТИТЬ ВТСтатусы
	|ИЗ
	|	ВТЗаказы КАК Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДвижения КАК Движения
	|		ПО Заказы.Ссылка = Движения.Заказ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Статус";
	// Условия подставляются на место параметра-заглушки: текст запроса остаётся разбираемым конструктором.
	УсловиеЗаказов = СтрСоединить(Условия, "
		|	И ");
	Возврат СтрЗаменить(Текст, "&УсловиеЗаказов", УсловиеЗаказов);

КонецФункции

// Запрос с временными таблицами оплат по заказам: ВТПоступления - проведённые поступления заказов в основной валюте за
// вычетом проведённых возвратов поставщику по ним (иначе рассчитанный заказ с возвратом остался бы «оплачен частично»),
// ВТПокрытие - доли поступлений в проведённых налоговых накладных покупки, ВТПлатежи - платежи поставщику по
// поступлениям и накладным (списание - плюс, возврат денег - минус), ВТОплатыПоступлений - оплачено по поступлению:
// свои платежи плюс доля платежей прямо на накладную.
//
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказПоставщику - заказы.
//
// Возвращаемое значение:
//  Запрос - запрос с менеджером временных таблиц.
//
Функция ЗапросОплат(Заказы)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Возвраты.Основание КАК Поступление,
	|	СУММА(ВЫРАЗИТЬ(Возвраты.Сумма * ВЫБОР
	|				КОГДА Возвраты.КурсВалюты > 0
	|					ТОГДА Возвраты.КурсВалюты
	|				ИНАЧЕ 1
	|			КОНЕЦ КАК ЧИСЛО(15, 2))) КАК Сумма
	|ПОМЕСТИТЬ ВТВозвраты
	|ИЗ
	|	Документ.ВозвратПоставщику КАК Возвраты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступленияВозвратов
	|		ПО Возвраты.Основание = ПоступленияВозвратов.Ссылка
	|ГДЕ
	|	Возвраты.Проведен
	|	И ПоступленияВозвратов.Основание В (&Заказы)
	|
	|СГРУППИРОВАТЬ ПО
	|	Возвраты.Основание
	|;
	|
	|ВЫБРАТЬ
	|	Поступления.Ссылка КАК Поступление,
	|	Поступления.Основание КАК Заказ,
	|	Поступления.СуммаРегл - ЕСТЬNULL(ВозвратыПоступлений.Сумма, 0) КАК Сумма
	|ПОМЕСТИТЬ ВТПоступления
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВозвраты КАК ВозвратыПоступлений
	|		ПО Поступления.Ссылка = ВозвратыПоступлений.Поступление
	|ГДЕ
	|	Поступления.Основание В (&Заказы)
	|	И Поступления.Проведен
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Поступление
	|;
	|
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Накладная
	|ПОМЕСТИТЬ ВТНакладныеВсе
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоступления КАК ПоступленияТоваров
	|		ПО Товары.ПоступлениеТовара = ПоступленияТоваров.Поступление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Услуги.Ссылка
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка.ТЧУслуги КАК Услуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоступления КАК ПоступленияУслуг
	|		ПО Услуги.ПоступлениеТовара = ПоступленияУслуг.Поступление
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НакладныеВсе.Накладная КАК Накладная
	|ПОМЕСТИТЬ ВТНакладные
	|ИЗ
	|	ВТНакладныеВсе КАК НакладныеВсе
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НалоговаяНакладнаяПокупка КАК Накладные
	|		ПО НакладныеВсе.Накладная = Накладные.Ссылка
	|ГДЕ
	|	Накладные.Проведен
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Накладная
	|;
	|
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Накладная,
	|	Товары.ПоступлениеТовара КАК Поступление,
	|	Товары.СуммаСНДС КАК Сумма
	|ПОМЕСТИТЬ ВТСтрокиНакладныхВсе
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНакладные КАК НакладныеТоваров
	|		ПО Товары.Ссылка = НакладныеТоваров.Накладная
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Услуги.Ссылка,
	|	Услуги.ПоступлениеТовара,
	|	Услуги.СуммаСНДС
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка.ТЧУслуги КАК Услуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНакладные КАК НакладныеУслуг
	|		ПО Услуги.Ссылка = НакладныеУслуг.Накладная
	|;
	|
	|ВЫБРАТЬ
	|	СтрокиВсе.Накладная КАК Накладная,
	|	СтрокиВсе.Поступление КАК Поступление,
	|	СУММА(СтрокиВсе.Сумма) КАК Покрытие
	|ПОМЕСТИТЬ ВТСтрокиНакладных
	|ИЗ
	|	ВТСтрокиНакладныхВсе КАК СтрокиВсе
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиВсе.Накладная,
	|	СтрокиВсе.Поступление
	|;
	|
	|ВЫБРАТЬ
	|	СтрокиИтог.Накладная КАК Накладная,
	|	СУММА(СтрокиИтог.Покрытие) КАК Покрытие
	|ПОМЕСТИТЬ ВТИтогиНакладных
	|ИЗ
	|	ВТСтрокиНакладных КАК СтрокиИтог
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиИтог.Накладная
	|;
	|
	|ВЫБРАТЬ
	|	Строки.Накладная КАК Накладная,
	|	Строки.Поступление КАК Поступление,
	|	Строки.Покрытие КАК Покрытие,
	|	Итоги.Покрытие КАК ВсегоПокрыто
	|ПОМЕСТИТЬ ВТПокрытие
	|ИЗ
	|	ВТСтрокиНакладных КАК Строки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТИтогиНакладных КАК Итоги
	|		ПО Строки.Накладная = Итоги.Накладная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоступления КАК ПоступленияПокрытия
	|		ПО Строки.Поступление = ПоступленияПокрытия.Поступление
	|;
	|
	|ВЫБРАТЬ
	|	ПоступленияОплат.Поступление КАК Объект
	|ПОМЕСТИТЬ ВТОбъектыОплат
	|ИЗ
	|	ВТПоступления КАК ПоступленияОплат
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НакладныеОплат.Накладная
	|ИЗ
	|	ВТНакладные КАК НакладныеОплат
	|;
	|
	|ВЫБРАТЬ
	|	Касса.Период КАК Период,
	|	Касса.Регистратор КАК Регистратор,
	|	Касса.ДокументПродажи КАК ДокументПродажи,
	|	ВЫБОР
	|		КОГДА Касса.ТипДвижения = ЗНАЧЕНИЕ(Перечисление.ТипыДвиженияДенежныхСредств.Поступление)
	|			ТОГДА -Касса.СуммаОборот
	|		ИНАЧЕ Касса.СуммаОборот
	|	КОНЕЦ КАК Сумма
	|ПОМЕСТИТЬ ВТПлатежи
	|ИЗ
	|	РегистрНакопления.ДвиженияПоКассе.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			ДокументПродажи В
	|				(ВЫБРАТЬ
	|					ОбъектыОплат.Объект КАК Объект
	|				ИЗ
	|					ВТОбъектыОплат КАК ОбъектыОплат)) КАК Касса
	|;
	|
	|ВЫБРАТЬ
	|	Доли.Поступление КАК Поступление,
	|	СУММА(Доли.Оплачено) КАК Оплачено
	|ПОМЕСТИТЬ ВТОплатыПоступлений
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПоступленияПлатежей.Поступление КАК Поступление,
	|		Платежи.Сумма КАК Оплачено
	|	ИЗ
	|		ВТПлатежи КАК Платежи
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоступления КАК ПоступленияПлатежей
	|			ПО Платежи.ДокументПродажи = ПоступленияПлатежей.Поступление
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ДолиПокрытия.Поступление,
	|		ВЫБОР
	|			КОГДА ДолиПокрытия.ВсегоПокрыто = 0
	|				ТОГДА 0
	|			ИНАЧЕ ВЫРАЗИТЬ(Платежи.Сумма * ДолиПокрытия.Покрытие / ДолиПокрытия.ВсегоПокрыто КАК ЧИСЛО(15, 2))
	|		КОНЕЦ
	|	ИЗ
	|		ВТПлатежи КАК Платежи
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПокрытие КАК ДолиПокрытия
	|			ПО Платежи.ДокументПродажи = ДолиПокрытия.Накладная) КАК Доли
	|
	|СГРУППИРОВАТЬ ПО
	|	Доли.Поступление";
	Запрос.Выполнить();
	Возврат Запрос;

КонецФункции

// Возвращаемое значение:
//  Строка - строки заказа &Заказ: заказано по строке, пришло поступлениями за вычетом возвратов, остаток.
//
Функция ТекстЗапросаТоваров()

	Возврат
	"ВЫБРАТЬ
	|	Движения.Номенклатура КАК Номенклатура,
	|	Движения.Характеристика КАК Характеристика,
	|	Движения.КодСтроки КАК КодСтроки,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					И (Движения.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|						ИЛИ Движения.Регистратор ССЫЛКА Документ.ВозвратПоставщику)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Пришло,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ -Движения.Количество
	|		КОНЕЦ) КАК Осталось
	|ПОМЕСТИТЬ ВТДвиженияСтрок
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам КАК Движения
	|ГДЕ
	|	Движения.Активность
	|	И Движения.ЗаказПоставщику = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.Номенклатура,
	|	Движения.Характеристика,
	|	Движения.КодСтроки
	|;
	|
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Количество КАК Заказано,
	|	ЕСТЬNULL(Движения.Пришло, 0) КАК Пришло,
	|	ВЫБОР
	|		КОГДА Заказы.Проведен
	|			ТОГДА ЕСТЬNULL(Движения.Осталось, 0)
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ КАК Осталось,
	|	Товары.Цена КАК Цена,
	|	Товары.СуммаСНДС КАК Сумма,
	|	Товары.Продукция КАК Продукция
	|ИЗ
	|	Документ.ЗаказПоставщику.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказы
	|		ПО Товары.Ссылка = Заказы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДвиженияСтрок КАК Движения
	|		ПО Товары.Номенклатура = Движения.Номенклатура
	|			И Товары.Характеристика = Движения.Характеристика
	|			И Товары.КодСтроки = Движения.КодСтроки
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки";

КонецФункции

// Возвращаемое значение:
//  Строка - строки поступлений по заказу &Заказ, в том числе черновиков и помеченных.
//
Функция ТекстЗапросаПоступлений()

	Возврат
	"ВЫБРАТЬ
	|	Поступления.Ссылка КАК Документ,
	|	Поступления.Дата КАК Дата,
	|	Поступления.ВерсияДанных КАК ВерсияДанных,
	|	Поступления.НомерВходящегоДокумента КАК НомерНакладной,
	|	Поступления.ДатаВходящегоДокумента КАК ДатаНакладной,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Количество КАК Количество,
	|	Товары.СуммаСНДС КАК Сумма,
	|	Поступления.Проведен КАК Проведен,
	|	Поступления.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК Товары
	|		ПО Поступления.Ссылка = Товары.Ссылка
	|ГДЕ
	|	Поступления.Основание = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поступления.Дата,
	|	Поступления.Ссылка,
	|	Товары.НомерСтроки";

КонецФункции

// Возвращаемое значение:
//  Строка - платежи поставщику по поступлениям заказа и по налоговым накладным, покрывающим эти поступления.
//
Функция ТекстЗапросаПлатежей()

	Возврат
	"ВЫБРАТЬ
	|	Платежи.Регистратор КАК Документ,
	|	Платежи.Период КАК Дата,
	|	Платежи.ДокументПродажи КАК Основание,
	|	Платежи.Сумма КАК Сумма
	|ИЗ
	|	ВТПлатежи КАК Платежи
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

КонецФункции

// Возвращаемое значение:
//  Строка - документы цепочки заказа &Заказ: сам заказ, поступления, возвраты по ним, налоговые накладные и платежи.
//
Функция ТекстЗапросаДокументов()

	Возврат
	"ВЫБРАТЬ
	|	Заказы.Ссылка КАК Документ,
	|	Заказы.Номер КАК Номер,
	|	Заказы.Дата КАК Дата,
	|	Заказы.Сумма КАК Сумма,
	|	Заказы.Проведен КАК Проведен,
	|	Заказы.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Заказы
	|ГДЕ
	|	Заказы.Ссылка = &Заказ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Поступления.Ссылка,
	|	Поступления.Номер,
	|	Поступления.Дата,
	|	Поступления.Сумма,
	|	Поступления.Проведен,
	|	Поступления.ПометкаУдаления
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|ГДЕ
	|	Поступления.Основание = &Заказ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Возвраты.Ссылка,
	|	Возвраты.Номер,
	|	Возвраты.Дата,
	|	Возвраты.Сумма,
	|	Возвраты.Проведен,
	|	Возвраты.ПометкаУдаления
	|ИЗ
	|	Документ.ВозвратПоставщику КАК Возвраты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступленияВозвратов
	|		ПО Возвраты.Основание = ПоступленияВозвратов.Ссылка
	|ГДЕ
	|	ПоступленияВозвратов.Основание = &Заказ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Накладные.Ссылка,
	|	Накладные.Номер,
	|	Накладные.Дата,
	|	Накладные.Сумма,
	|	Накладные.Проведен,
	|	Накладные.ПометкаУдаления
	|ИЗ
	|	Документ.НалоговаяНакладнаяПокупка КАК Накладные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНакладные КАК НакладныеЗаказа
	|		ПО Накладные.Ссылка = НакладныеЗаказа.Накладная
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Списания.Ссылка,
	|	Списания.Номер,
	|	Списания.Дата,
	|	Списания.Сумма,
	|	Списания.Проведен,
	|	Списания.ПометкаУдаления
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств КАК Списания
	|ГДЕ
	|	Списания.Ссылка В
	|			(ВЫБРАТЬ
	|				ПлатежиСписаний.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТПлатежи КАК ПлатежиСписаний)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Расходники.Ссылка,
	|	Расходники.Номер,
	|	Расходники.Дата,
	|	Расходники.Сумма,
	|	Расходники.Проведен,
	|	Расходники.ПометкаУдаления
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК Расходники
	|ГДЕ
	|	Расходники.Ссылка В
	|			(ВЫБРАТЬ
	|				ПлатежиРасходников.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТПлатежи КАК ПлатежиРасходников)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступленияДенег.Ссылка,
	|	ПоступленияДенег.Номер,
	|	ПоступленияДенег.Дата,
	|	ПоступленияДенег.Сумма,
	|	ПоступленияДенег.Проведен,
	|	ПоступленияДенег.ПометкаУдаления
	|ИЗ
	|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК ПоступленияДенег
	|ГДЕ
	|	ПоступленияДенег.Ссылка В
	|			(ВЫБРАТЬ
	|				ПлатежиПоступлений.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТПлатежи КАК ПлатежиПоступлений)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Приходники.Ссылка,
	|	Приходники.Номер,
	|	Приходники.Дата,
	|	Приходники.Сумма,
	|	Приходники.Проведен,
	|	Приходники.ПометкаУдаления
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК Приходники
	|ГДЕ
	|	Приходники.Ссылка В
	|			(ВЫБРАТЬ
	|				ПлатежиПриходников.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТПлатежи КАК ПлатежиПриходников)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

КонецФункции

// Возвращаемое значение:
//  Строка - остаток расчётов с поставщиком по организации, контрагенту и договору заказа &Заказ.
//
Функция ТекстЗапросаСальдо()

	Возврат
	"ВЫБРАТЬ
	|	Расчеты.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПоставщиками.Остатки(
	|			,
	|			(Организация, Контрагент, Договор) В
	|				(ВЫБРАТЬ
	|					Заказы.Организация КАК Организация,
	|					Заказы.Контрагент КАК Контрагент,
	|					Заказы.Договор КАК Договор
	|				ИЗ
	|					Документ.ЗаказПоставщику КАК Заказы
	|				ГДЕ
	|					Заказы.Ссылка = &Заказ)) КАК Расчеты";

КонецФункции

// Параметры:
//  Статус   - ПеречислениеСсылка.СтатусыЗаказовПоставщику - статус заказа.
//  Заказано - Число - заказано по проведённому заказу.
//  Пришло   - Число - пришло поступлениями за вычетом возвратов.
//
// Возвращаемое значение:
//  Строка - кружок поставки: ○ ничего, ◐ часть, ● всё.
//
Функция КружокПоставки(Статус, Заказано, Пришло)

	Если Статус = Перечисления.СтатусыЗаказовПоставщику.Черновик
		Или Статус = Перечисления.СтатусыЗаказовПоставщику.Отменен
		Или Пришло <= 0 Тогда
		Кружок = КружокНет();
	ИначеЕсли Пришло >= Заказано Или Статус = Перечисления.СтатусыЗаказовПоставщику.Поступил Тогда
		// «Поступил» и при остатке, перенесённом в другой заказ: кружок совпадает со статусом.
		Кружок = КружокДа();
	Иначе
		Кружок = КружокЧастично();
	КонецЕсли;
	Возврат Кружок;

КонецФункции

// Параметры:
//  Оплата - Структура, Неопределено - см. ОплатыЗаказов, значение соответствия.
//
// Возвращаемое значение:
//  Строка - кружок оплаты поступлений: ○ нет поступлений или оплат, ◐ часть, ● всё.
//
Функция КружокОплаты(Оплата)

	Если Оплата = Неопределено Или Оплата.СуммаПоступлений <= 0 Или Оплата.Оплачено <= 0 Тогда
		Кружок = КружокНет();
	ИначеЕсли Оплата.Оплачено >= Оплата.СуммаПоступлений Тогда
		Кружок = КружокДа();
	Иначе
		Кружок = КружокЧастично();
	КонецЕсли;
	Возврат Кружок;

КонецФункции

Функция КружокНет()

	Возврат "○";

КонецФункции

Функция КружокЧастично()

	Возврат "◐";

КонецФункции

Функция КружокДа()

	Возврат "●";

КонецФункции

// Параметры:
//  Остатки - ТаблицаЗначений - колонка Сумма: остатки расчётов с поставщиком по договору заказа.
//
// Возвращаемое значение:
//  Строка - «Долг поставщику: …», «Аванс поставщику: …» или «Расчёты закрыты».
//
Функция ТекстСальдо(Остатки)

	Сумма = Остатки.Итог("Сумма");
	// Долг перед поставщиком в регистре - отрицательный остаток, аванс - положительный (см. ТестыДокументов,
	// ПроверитьДолгПоставщику).
	Если Сумма < 0 Тогда
		Шаблон = НСтр("ru = 'Долг поставщику по договору заказа: %1'; fr = 'Dette envers le fournisseur au titre du contrat : %1';
			|en = 'Owed to the supplier under the order contract: %1'; es = 'Deuda con el proveedor según el contrato: %1'");
		Текст = СтрШаблон(Шаблон, Формат(-Сумма, "ЧДЦ=2"));
	ИначеЕсли Сумма > 0 Тогда
		Шаблон = НСтр("ru = 'Аванс поставщику по договору заказа: %1'; fr = 'Avance au fournisseur au titre du contrat : %1';
			|en = 'Advance to the supplier under the order contract: %1'; es = 'Anticipo al proveedor según el contrato: %1'");
		Текст = СтрШаблон(Шаблон, Формат(Сумма, "ЧДЦ=2"));
	Иначе
		Текст = НСтр("ru = 'Расчёты с поставщиком по договору заказа закрыты'; fr = 'Comptes avec le fournisseur soldés';
			|en = 'Supplier account under the order contract is settled'; es = 'Cuentas con el proveedor saldadas'");
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Параметры:
//  Проведен        - Булево - документ проведён.
//  ПометкаУдаления - Булево - документ помечен на удаление.
//
// Возвращаемое значение:
//  Строка - статус документа на языке пользователя.
//
Функция ПредставлениеСтатусаДокумента(Проведен, ПометкаУдаления)

	Если ПометкаУдаления Тогда
		Текст = НСтр("ru = 'Помечен на удаление'; fr = 'Marqué pour suppression'; en = 'Marked for deletion';
			|es = 'Marcado para eliminar'");
	ИначеЕсли Проведен Тогда
		Текст = НСтр("ru = 'Проведён'; fr = 'Validé'; en = 'Posted'; es = 'Contabilizado'");
	Иначе
		Текст = НСтр("ru = 'Черновик'; fr = 'Brouillon'; en = 'Draft'; es = 'Borrador'");
	КонецЕсли;
	Возврат Текст;

КонецФункции

#КонецОбласти

#КонецЕсли
