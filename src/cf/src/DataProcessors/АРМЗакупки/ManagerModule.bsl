#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Отборы панели рабочего места закупок.
//
// Возвращаемое значение:
//  Структура:
//   * Поставщик      - СправочникСсылка.Контрагенты, Неопределено - поставщик заказа.
//   * Товар          - СправочникСсылка.Номенклатура, Неопределено - товар в строках заказа.
//   * Статус         - ПеречислениеСсылка.СтатусыЗаказовПоставщику, Неопределено - вычисляемый статус.
//   * ПериодПоставки - СтандартныйПериод, Неопределено - дата поставки заказа.
//   * Ответственный  - СправочникСсылка.Пользователи, Неопределено - ответственный заказа.
//   * ВидЗаказа      - ПеречислениеСсылка.ВидыЗаказовПоставщику, Неопределено - пустой: все, кроме предварительных
//                      (решение владельца 2026-10-07).
//
Функция НовыеОтборы() Экспорт

	Отборы = Новый Структура;
	Отборы.Вставить("Поставщик", Неопределено);
	Отборы.Вставить("Товар", Неопределено);
	Отборы.Вставить("Статус", Неопределено);
	Отборы.Вставить("ПериодПоставки", Неопределено);
	Отборы.Вставить("Ответственный", Неопределено);
	Отборы.Вставить("ВидЗаказа", Неопределено);
	Возврат Отборы;

КонецФункции

// Страница списка заказов поставщикам: статус считается до деления на страницы, поэтому отбор по статусу и счётчик
// записей согласованы (план docs/plans/arm-purchasing.md, «Статус и индикатор»).
//
// Параметры:
//  Отборы         - Структура - см. НовыеОтборы.
//  НомерСтраницы  - Число - запрошенная страница, нумерация с единицы; приводится к границам.
//  РазмерСтраницы - Число - заказов на странице.
//
// Возвращаемое значение:
//  Структура:
//   * Всего         - Число - заказов с учётом отборов.
//   * ВсегоСтраниц  - Число - не меньше единицы.
//   * НомерСтраницы - Число - страница в границах 1..ВсегоСтраниц.
//   * Строки        - Массив из Структура - строки страницы от новых к старым, см. НоваяСтрокаЗаказа.
//
Функция СтраницаЗаказов(Отборы, Знач НомерСтраницы, Знач РазмерСтраницы) Экспорт

	// Размер и номер приходят с клиента: неверные значения не должны ронять запрос (ПЕРВЫЕ, деление).
	РазмерСтраницы = Мин(МаксимумСтраницы(), Макс(1, Цел(?(ТипЗнч(РазмерСтраницы) = Тип("Число"), РазмерСтраницы, 1))));
	НомерСтраницы = Цел(?(ТипЗнч(НомерСтраницы) = Тип("Число"), НомерСтраницы, 1));

	ОтборыЗапроса = НовыеОтборы();
	Если ТипЗнч(Отборы) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ОтборыЗапроса, Отборы);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапросаСтатусов(Запрос, ОтборыЗапроса);
	Запрос.Выполнить();

	// Условие статуса подставляется на место параметра-заглушки: текст запроса остаётся разбираемым конструктором.
	УсловиеСтатуса = "ИСТИНА";
	Если ТипЗнч(ОтборыЗапроса.Статус) = Тип("ПеречислениеСсылка.СтатусыЗаказовПоставщику")
		И ЗначениеЗаполнено(ОтборыЗапроса.Статус) Тогда
		УсловиеСтатуса = "Док.Статус = &Статус";
		Запрос.УстановитьПараметр("Статус", ОтборыЗапроса.Статус);
	КонецЕсли;
	Запрос.Текст = СтрЗаменить("ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Всего
	|ИЗ
	|	ВТСтатусы КАК Док
	|ГДЕ
	|	&УсловиеСтатуса", "&УсловиеСтатуса", УсловиеСтатуса);
	Выборка = Запрос.Выполнить().Выбрать();
	Всего = 0;
	Если Выборка.Следующий() Тогда
		Всего = Выборка.Всего;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Всего", Всего);
	Результат.Вставить("ВсегоСтраниц", Макс(1, Цел((Всего + РазмерСтраницы - 1) / РазмерСтраницы)));
	Результат.Вставить("НомерСтраницы", Мин(Макс(1, НомерСтраницы), Результат.ВсегоСтраниц));
	Результат.Вставить("Строки", Новый Массив);
	Если Всего = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПараметрыСтраницы = РаботаСДокументамиКлиентСервер.ПараметрыВыборкиСтраницы(Результат.НомерСтраницы,
		Результат.ВсегоСтраниц, РазмерСтраницы, Всего);
	ТекстСтраницы = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Док.Ссылка КАК Ссылка,
	|	Док.Дата КАК Дата,
	|	Док.Статус КАК Статус,
	|	Док.Заказано КАК Заказано,
	|	Док.Пришло КАК Пришло,
	|	Заказы.Номер КАК Номер,
	|	Заказы.Контрагент КАК Поставщик,
	|	Заказы.ДатаПоставки КАК ДатаПоставки,
	|	Заказы.Сумма КАК Сумма,
	|	Заказы.Валюта КАК Валюта,
	|	Заказы.Основание КАК ЗаказКлиента,
	|	Заказы.Ответственный КАК Ответственный,
	|	Заказы.ВидЗаказа КАК ВидЗаказа
	|ИЗ
	|	ВТСтатусы КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказы
	|		ПО Док.Ссылка = Заказы.Ссылка
	|ГДЕ
	|	&УсловиеСтатуса
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата УБЫВ,
	|	Док.Ссылка";
	ТекстСтраницы = СтрЗаменить(ТекстСтраницы, "ПЕРВЫЕ 1", "ПЕРВЫЕ " + Формат(ПараметрыСтраницы.КоличествоСтрок, "ЧГ="));
	ТекстСтраницы = СтрЗаменить(ТекстСтраницы, "&УсловиеСтатуса", УсловиеСтатуса);
	Запрос.Текст = СтрЗаменить(ТекстСтраницы, "Док.Дата УБЫВ,
	|	Док.Ссылка", ПараметрыСтраницы.Порядок);
	Выгрузка = Запрос.Выполнить().Выгрузить();
	// Порядок строк задаёт запрос: пересортировка таблицы не устойчива при равных датах и задвоила бы строки на границе
	// страниц. Обычная страница - пропуск первых строк, последняя читается с конца (ПараметрыВыборкиСтраницы) -
	// разворот.
	СтрокиСтраницы = Новый Массив;
	Для Индекс = ПараметрыСтраницы.НачальныйИндекс По Выгрузка.Количество() - 1 Цикл
		СтрокиСтраницы.Добавить(Выгрузка[Индекс]);
	КонецЦикла;
	Если Результат.НомерСтраницы = Результат.ВсегоСтраниц Тогда
		Развернутые = Новый Массив;
		Для Каждого Строка Из СтрокиСтраницы Цикл
			Развернутые.Вставить(0, Строка);
		КонецЦикла;
		СтрокиСтраницы = Развернутые;
	КонецЕсли;

	Ссылки = Новый Массив;
	Для Каждого Строка Из СтрокиСтраницы Цикл
		Ссылки.Добавить(Строка.Ссылка);
	КонецЦикла;
	Оплаты = ОплатыЗаказов(Ссылки);
	Для Каждого Строка Из СтрокиСтраницы Цикл
		СтрокаЗаказа = НоваяСтрокаЗаказа();
		ЗаполнитьЗначенияСвойств(СтрокаЗаказа, Строка);
		СтрокаЗаказа.Заказ = Строка.Ссылка;
		Оплата = Оплаты.Получить(Строка.Ссылка);
		СтрокаЗаказа.Индикатор = КружокПоставки(Строка.Статус, Строка.Заказано, Строка.Пришло)
			+ КружокОплаты(Оплата);
		Результат.Строки.Добавить(СтрокаЗаказа);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Оплата заказов поставщикам по их проведённым поступлениям, в основной валюте. Платёж, выписанный на поступление,
// остаётся оплатой этого поступления и после налоговой накладной покупки; платёж прямо на накладную делится между
// покрытыми ею поступлениями в доле покрытия (план, «Статус и индикатор»).
//
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказПоставщику - заказы.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - ДокументСсылка.ЗаказПоставщику - заказ.
//   * Значение - Структура:
//     ** СуммаПоступлений - Число - сумма проведённых поступлений по заказу в основной валюте.
//     ** Оплачено         - Число - оплачено поставщику по этим поступлениям, за вычетом возвратов денег.
//
Функция ОплатыЗаказов(Заказы) Экспорт

	Результат = Новый Соответствие;
	Если Заказы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = ЗапросОплат(Заказы);
	Запрос.Текст = "ВЫБРАТЬ
	|	Поступления.Заказ КАК Заказ,
	|	СУММА(Поступления.Сумма) КАК СуммаПоступлений,
	|	СУММА(ЕСТЬNULL(Оплаты.Оплачено, 0)) КАК Оплачено
	|ИЗ
	|	ВТПоступления КАК Поступления
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОплатыПоступлений КАК Оплаты
	|		ПО Поступления.Поступление = Оплаты.Поступление
	|
	|СГРУППИРОВАТЬ ПО
	|	Поступления.Заказ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Оплата = Новый Структура("СуммаПоступлений, Оплачено", Выборка.СуммаПоступлений, Выборка.Оплачено);
		Результат.Вставить(Выборка.Заказ, Оплата);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Данные нижних закладок по заказу поставщику; «Товары» и «Поступления» вводятся строкой (сборка 2.0.16.29), «Оплаты» и
// «Документы» - только чтение.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПоставщику - текущий заказ.
//
// Возвращаемое значение:
//  Структура:
//   * Товары      - ТаблицаЗначений - НомерСтроки, КодСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок,
//                   Заказано, Пришло, Осталось, Цена, Сумма, Продукция.
//   * Поступления - ТаблицаЗначений - Документ, Дата, ВерсияДанных, НомерНакладной, ДатаНакладной, НомерСтроки,
//                   КодСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Количество, Сумма, Статус.
//   * Оплаты      - ТаблицаЗначений - Документ, Дата, Основание, Сумма.
//   * Документы   - ТаблицаЗначений - Документ, Вид, Номер, Дата, Сумма, Статус.
//   * Сальдо      - Строка - сальдо расчётов с поставщиком по организации и договору заказа.
//   * Шапка       - Структура - см. ШапкаЗаказа.
//
Функция ДанныеЗаказа(Заказ) Экспорт

	Заказы = Новый Массив;
	Заказы.Добавить(Заказ);
	Запрос = ЗапросОплат(Заказы);
	Запрос.УстановитьПараметр("Заказ", Заказ);

	Данные = Новый Структура;
	Запрос.Текст = ТекстЗапросаТоваров();
	Данные.Вставить("Товары", Запрос.Выполнить().Выгрузить());
	Запрос.Текст = ТекстЗапросаПоступлений();
	Данные.Вставить("Поступления", Запрос.Выполнить().Выгрузить());
	Запрос.Текст = ТекстЗапросаПлатежей();
	Данные.Вставить("Оплаты", Запрос.Выполнить().Выгрузить());
	Запрос.Текст = ТекстЗапросаДокументов();
	Данные.Вставить("Документы", Запрос.Выполнить().Выгрузить());
	Запрос.Текст = ТекстЗапросаСальдо();
	Данные.Вставить("Сальдо", ТекстСальдо(Запрос.Выполнить().Выгрузить()));

	ОписаниеСтроки = Новый ОписаниеТипов("Строка");
	Данные.Поступления.Колонки.Добавить("Статус", ОписаниеСтроки);
	Данные.Документы.Колонки.Добавить("Вид", ОписаниеСтроки);
	Данные.Документы.Колонки.Добавить("Статус", ОписаниеСтроки);
	Для Каждого Строка Из Данные.Поступления Цикл
		Строка.Статус = ПредставлениеСтатусаДокумента(Строка.Проведен, Строка.ПометкаУдаления);
	КонецЦикла;
	Для Каждого Строка Из Данные.Документы Цикл
		Строка.Вид = Строка.Документ.Метаданные().Синоним;
		Строка.Статус = ПредставлениеСтатусаДокумента(Строка.Проведен, Строка.ПометкаУдаления);
	КонецЦикла;
	Данные.Вставить("Шапка", ШапкаЗаказа(Заказ));
	Возврат Данные;

КонецФункции

// Записывает строку закладки «Товары»: новую или изменённую строку текущего заказа поставщику - общим путём ввода
// рабочего места производства в закупочном контексте (план docs/plans/arm-purchasing.md, решение 6).
//
// Параметры:
//  Заказ  - ДокументСсылка.ЗаказПоставщику - текущий заказ.
//  Строка - Структура - НомерСтроки (0 - новая), ВерсияДанных, Номенклатура, Характеристика, Упаковка,
//           КоличествоУпаковок, Цена, ЦенаИзменена.
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.ЗаписатьСтрокуДокумента: Успех, Текст.
//
Функция ЗаписатьСтрокуТоваров(Заказ, Строка) Экспорт

	ДанныеСтроки = ДанныеСтрокиЗаказа(Заказ, Обработки.АРМПроизводство.ВидЗаказПоставщику());
	Если ДанныеСтроки = Неопределено Или ТипЗнч(Строка) <> Тип("Структура") Тогда
		Возврат РезультатНеверныхДанных();
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, Строка, "НомерСтроки, ВерсияДанных, Характеристика, Упаковка,
		|КоличествоУпаковок, Цена, ЦенаИзменена");
	ДанныеСтроки.Материал = Строка.Номенклатура;
	Возврат Обработки.АРМПроизводство.ЗаписатьСтрокуДокумента(ДанныеСтроки);

КонецФункции

// Удаляет строки закладки «Товары» текущего заказа; заказ без строк помечается на удаление.
//
// Параметры:
//  Заказ        - ДокументСсылка.ЗаказПоставщику - текущий заказ.
//  ВерсияДанных - Строка - версия заказа, прочитанная формой.
//  НомераСтрок  - Массив из Число - номера удаляемых строк.
//
// Возвращаемое значение:
//  Структура - Успех, Текст.
//
Функция УдалитьСтрокиТоваров(Заказ, ВерсияДанных, НомераСтрок) Экспорт

	Строки = Новый Массив;
	Для Каждого НомерСтроки Из НомераСтрок Цикл
		ДанныеСтроки = ДанныеСтрокиЗаказа(Заказ, Обработки.АРМПроизводство.ВидЗаказПоставщику());
		Если ДанныеСтроки = Неопределено Тогда
			Возврат РезультатНеверныхДанных();
		КонецЕсли;
		ДанныеСтроки.НомерСтроки = НомерСтроки;
		ДанныеСтроки.ВерсияДанных = ВерсияДанных;
		Строки.Добавить(ДанныеСтроки);
	КонецЦикла;
	Возврат ИтогУдаления(Строки);

КонецФункции

// Записывает строку закладки «Поступления»: поступление по строке текущего заказа поставщику. Новая строка уходит в
// поступление этого заказа с той же накладной поставщика или в новое поступление.
//
// Параметры:
//  Заказ  - ДокументСсылка.ЗаказПоставщику - текущий заказ.
//  Строка - Структура - Документ (пустой - новое поступление), НомерСтроки (0 - новая), ВерсияДанных, КодСтроки (строка
//           заказа), Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, НомерНакладной, ДатаНакладной.
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.ЗаписатьСтрокуДокумента: Успех, Текст.
//
Функция ЗаписатьСтрокуПоступления(Заказ, Строка) Экспорт

	ДанныеСтроки = ДанныеСтрокиЗаказа(Заказ, Обработки.АРМПроизводство.ВидПоступление());
	Если ДанныеСтроки = Неопределено Или ТипЗнч(Строка) <> Тип("Структура") Тогда
		Возврат РезультатНеверныхДанных();
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, Строка, "НомерСтроки, ВерсияДанных, Характеристика, Упаковка,
		|КоличествоУпаковок");
	ДанныеСтроки.Документ = ?(ЗначениеЗаполнено(Строка.Документ), Строка.Документ, Неопределено);
	ДанныеСтроки.КодСтрокиОснования = Строка.КодСтроки;
	ДанныеСтроки.Материал = Строка.Номенклатура;
	ДанныеСтроки.НомерВходящегоДокумента = Строка.НомерНакладной;
	ДанныеСтроки.ДатаВходящегоДокумента = Строка.ДатаНакладной;
	Возврат Обработки.АРМПроизводство.ЗаписатьСтрокуДокумента(ДанныеСтроки);

КонецФункции

// Удаляет строки закладки «Поступления»; поступление без строк помечается на удаление.
//
// Параметры:
//  Заказ  - ДокументСсылка.ЗаказПоставщику - текущий заказ.
//  Строки - Массив из Структура - Документ, НомерСтроки, ВерсияДанных.
//
// Возвращаемое значение:
//  Структура - Успех, Текст.
//
Функция УдалитьСтрокиПоступлений(Заказ, Строки) Экспорт

	СтрокиДанных = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		ДанныеСтроки = ДанныеСтрокиЗаказа(Заказ, Обработки.АРМПроизводство.ВидПоступление());
		Если ДанныеСтроки = Неопределено Тогда
			Возврат РезультатНеверныхДанных();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, Строка, "Документ, НомерСтроки, ВерсияДанных");
		СтрокиДанных.Добавить(ДанныеСтроки);
	КонецЦикла;
	Возврат ИтогУдаления(СтрокиДанных);

КонецФункции

// Строки текущего заказа поставщику с остатком к поступлению - для выбора товара новой строки поступления.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПоставщику - текущий заказ.
//
// Возвращаемое значение:
//  СписокЗначений - см. Обработки.АРМПроизводство.СтрокиЗаказовПоставщикуДляВыбора.
//
Функция СтрокиЗаказаДляПоступления(Заказ) Экспорт

	Возврат Обработки.АРМПроизводство.СтрокиЗаказовПоставщикуДляВыбора(Заказ, Справочники.Контрагенты.ПустаяСсылка(),
		Справочники.Номенклатура.ПустаяСсылка(), Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());

КонецФункции

// «Изменить статус ▾» отмеченных заказов поставщику: в работу (провести), в черновик, отменить (пометить на удаление).
// Отказ по одному заказу не прерывает остальные.
//
// Параметры:
//  Заказы   - Массив из ДокументСсылка.ЗаказПоставщику - отмеченные заказы.
//  Действие - Строка - см. Обработки.АРМПроизводство.ДействиеВРаботу, ДействиеВЧерновик, ДействиеОтменить.
//
// Возвращаемое значение:
//  Массив из Структура - Документ, Успех, Текст.
//
Функция ИзменитьСтатусЗаказов(Заказы, Действие) Экспорт

	Итоги = Новый Массив;
	Если ТипЗнч(Заказы) <> Тип("Массив") Тогда
		Возврат Итоги;
	КонецЕсли;
	Для Каждого Заказ Из Заказы Цикл
		Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			Итог = РезультатНеверныхДанных();
			Итог.Вставить("Документ", Заказ);
			Итоги.Добавить(Итог);
			Продолжить;
		КонецЕсли;
		ДокументыЗаказа = Новый Массив;
		ДокументыЗаказа.Добавить(Заказ);
		// Неопределено вместо заказа клиента - закупочный контекст общего пути.
		Для Каждого Итог Из Обработки.АРМПроизводство.ИзменитьСтатусДокументовСтрок(ДокументыЗаказа, Действие, Неопределено) Цикл
			Итоги.Добавить(Итог);
		КонецЦикла;
	КонецЦикла;
	Возврат Итоги;

КонецФункции

// Возвращаемое значение:
//  Число - строк закладки «К поступлению» не больше этого числа (ПЕРВЫЕ в ТекстЗапросаКПоступлению).
//
Функция ПределСтрокКПоступлению() Экспорт

	Возврат 500;

КонецФункции

// Строки закладки «К поступлению»: строки проведённых непомеченных заказов поставщику (кроме предварительных) с
// остатком регистра «Заказы поставщикам» больше нуля; склада нет (решение владельца 2026-10-07, A1).
//
// Параметры:
//  Отборы - Структура - см. НовыеОтборы: Поставщик, Товар.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Пометка, Поставщик, Заказ, ЗаказПредставление, ДатаПоставки, Просрочен, КодСтроки, Номенклатура,
//                    Характеристика, Упаковка, Осталось (базовые единицы), КоличествоУпаковок (остаток в упаковках
//                    строки - количество к приёмке по умолчанию). Не больше 500 строк.
//
Функция СтрокиКПоступлению(Отборы) Экспорт

	ОтборыЗапроса = НовыеОтборы();
	Если ТипЗнч(Отборы) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ОтборыЗапроса, Отборы);
	КонецЕсли;
	Запрос = Новый Запрос;
	Текст = ТекстЗапросаКПоступлению();
	Если ЗначениеЗаполнено(ОтборыЗапроса.Товар) Тогда
		Текст = СтрЗаменить(Текст, "&УсловиеОстатков", "Номенклатура = &Товар");
		Запрос.УстановитьПараметр("Товар", ОтборыЗапроса.Товар);
	Иначе
		Текст = СтрЗаменить(Текст, "&УсловиеОстатков", "ИСТИНА");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборыЗапроса.Поставщик) Тогда
		Текст = СтрЗаменить(Текст, "&УсловиеПоставщика", "Заказы.Контрагент = &Поставщик");
		Запрос.УстановитьПараметр("Поставщик", ОтборыЗапроса.Поставщик);
	Иначе
		Текст = СтрЗаменить(Текст, "&УсловиеПоставщика", "ИСТИНА");
	КонецЕсли;
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДатаСеанса()));
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ЗаказПредставление", Новый ОписаниеТипов("Строка"));
	// BSLLS:MagicNumber-off - количество упаковок: 15 знаков, 3 после запятой, как в строках документов.
	Таблица.Колонки.Добавить("КоличествоУпаковок", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	Шаблон = НСтр("ru = '№ %1 от %2'; fr = 'N° %1 du %2'; en = 'No. %1 of %2'; es = 'N.º %1 del %2'");
	Для Каждого Строка Из Таблица Цикл
		Строка.ЗаказПредставление = СтрШаблон(Шаблон, Строка.Номер, Формат(Строка.Дата, "ДЛФ=D"));
		// Остаток, не кратный упаковке, - в единицах: дробные упаковки после округления оставили бы хвост в регистре.
		Упаковок = Окр(Строка.Осталось / Строка.Коэффициент, 3);
		// BSLLS:MagicNumber-on
		Если Упаковок * Строка.Коэффициент = Строка.Осталось Тогда
			Строка.КоличествоУпаковок = Упаковок;
		Иначе
			Строка.Упаковка = Строка.Единица;
			Строка.КоличествоУпаковок = Строка.Осталось;
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Оформляет поступления по отмеченным строкам «К поступлению» одного поставщика: по поступлению на каждый заказ
// поставщику, с общими номером и датой накладной; каждое поступление пишется пакетом
// (Обработки.АРМПроизводство.ЗаписатьСтрокиПоступления).
//
// Параметры:
//  Строки    - Массив из Структура - Заказ, КодСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок.
//  Накладная - Структура - Номер, Дата - накладная поставщика.
//
// Возвращаемое значение:
//  Массив из Структура - по заказу: Заказ, Успех, Текст, Документ.
//
Функция ОформитьПоступления(Строки, Накладная) Экспорт

	Итоги = Новый Массив;
	ПоЗаказам = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		СтрокаВерна = ТипЗнч(Строка) = Тип("Структура") И Строка.Свойство("Заказ")
			И ТипЗнч(Строка.Заказ) = Тип("ДокументСсылка.ЗаказПоставщику");
		Если Не СтрокаВерна Или Не ЗначениеЗаполнено(Строка.Заказ) Тогда
			Итоги.Добавить(ИтогПоступления(Неопределено, РезультатНеверныхДанных()));
			Возврат Итоги;
		КонецЕсли;
		Если ПоЗаказам[Строка.Заказ] = Неопределено Тогда
			ПоЗаказам.Вставить(Строка.Заказ, Новый Массив);
		КонецЕсли;
		ПоЗаказам[Строка.Заказ].Добавить(Строка);
	КонецЦикла;
	Текст = ТекстЗапретаПоставщиковПоступления(ПоЗаказам);
	Если Не ПустаяСтрока(Текст) Тогда
		Итоги.Добавить(ИтогПоступления(Неопределено, Новый Структура("Успех, Текст", Ложь, Текст)));
		Возврат Итоги;
	КонецЕсли;
	Для Каждого ЗаказИСтроки Из ПоЗаказам Цикл
		СтрокиДанных = Новый Массив;
		Для Каждого Строка Из ЗаказИСтроки.Значение Цикл
			ДанныеСтроки = ДанныеСтрокиЗаказа(ЗаказИСтроки.Ключ, Обработки.АРМПроизводство.ВидПоступление());
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, Строка, "Характеристика, Упаковка, КоличествоУпаковок");
			ДанныеСтроки.КодСтрокиОснования = Строка.КодСтроки;
			ДанныеСтроки.Материал = Строка.Номенклатура;
			СтрокиДанных.Добавить(ДанныеСтроки);
		КонецЦикла;
		Результат = Обработки.АРМПроизводство.ЗаписатьСтрокиПоступления(СтрокиДанных, Накладная);
		Итоги.Добавить(ИтогПоступления(ЗаказИСтроки.Ключ, Результат));
	КонецЦикла;
	Возврат Итоги;

КонецФункции

// Легенда индикатора в одну строку - в строку пагинатора под списком заказов.
//
// Возвращаемое значение:
//  Строка - «поставка · оплата: ○ нет ◐ частично ● да».
//
Функция ЛегендаИндикатораСтрокой() Экспорт

	Возврат НСтр("ru = 'поставка · оплата:  ○ нет   ◐ частично   ● да'; fr = 'livraison · paiement :  ○ non   ◐ partiel   ● oui';
		|en = 'delivery · payment:  ○ no   ◐ partial   ● yes'; es = 'entrega · pago:  ○ no   ◐ parcial   ● sí'");

КонецФункции

