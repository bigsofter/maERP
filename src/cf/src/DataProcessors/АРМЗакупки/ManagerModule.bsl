//
Функция ПределСтрокКПоступлению() Экспорт

	Возврат 500;

КонецФункции

// Строки закладки «К поступлению»: строки проведённых непомеченных заказов поставщику (кроме предварительных) с
// остатком регистра «Заказы поставщикам» больше нуля; склада нет (решение владельца 2026-10-07, A1).
//
// Параметры:
//  Отборы - Структура - см. НовыеОтборы: Поставщик, Товар.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Пометка, Поставщик, Заказ, ЗаказПредставление, ДатаПоставки, Просрочен, КодСтроки, Номенклатура,
//                    Характеристика, Упаковка, Осталось (базовые единицы), КоличествоУпаковок (остаток в упаковках
//                    строки - количество к приёмке по умолчанию). Не больше 500 строк.
//
Функция СтрокиКПоступлению(Отборы) Экспорт

	ОтборыЗапроса = НовыеОтборы();
	Если ТипЗнч(Отборы) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ОтборыЗапроса, Отборы);
	КонецЕсли;
	Запрос = Новый Запрос;
	Текст = ТекстЗапросаКПоступлению();
	Если ЗначениеЗаполнено(ОтборыЗапроса.Товар) Тогда
		Текст = СтрЗаменить(Текст, "&УсловиеОстатков", "Номенклатура = &Товар");
		Запрос.УстановитьПараметр("Товар", ОтборыЗапроса.Товар);
	Иначе
		Текст = СтрЗаменить(Текст, "&УсловиеОстатков", "ИСТИНА");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборыЗапроса.Поставщик) Тогда
		Текст = СтрЗаменить(Текст, "&УсловиеПоставщика", "Заказы.Контрагент = &Поставщик");
		Запрос.УстановитьПараметр("Поставщик", ОтборыЗапроса.Поставщик);
	Иначе
		Текст = СтрЗаменить(Текст, "&УсловиеПоставщика", "ИСТИНА");
	КонецЕсли;
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДатаСеанса()));
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ЗаказПредставление", Новый ОписаниеТипов("Строка"));
	// BSLLS:MagicNumber-off - количество упаковок: 15 знаков, 3 после запятой, как в строках документов.
	Таблица.Колонки.Добавить("КоличествоУпаковок", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	Шаблон = НСтр("ru = '№ %1 от %2'; fr = 'N° %1 du %2'; en = 'No. %1 of %2'; es = 'N.º %1 del %2'");
	Для Каждого Строка Из Таблица Цикл
		Строка.ЗаказПредставление = СтрШаблон(Шаблон, Строка.Номер, Формат(Строка.Дата, "ДЛФ=D"));
		// Остаток, не кратный упаковке, - в единицах: дробные упаковки после округления оставили бы хвост в регистре.
		Упаковок = Окр(Строка.Осталось / Строка.Коэффициент, 3);
		// BSLLS:MagicNumber-on
		Если Упаковок * Строка.Коэффициент = Строка.Осталось Тогда
			Строка.КоличествоУпаковок = Упаковок;
		Иначе
			Строка.Упаковка = Строка.Единица;
			Строка.КоличествоУпаковок = Строка.Осталось;
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Оформляет поступления по отмеченным строкам «К поступлению» одного поставщика: по поступлению на каждый заказ
// поставщику, с общими номером и датой накладной; каждое поступление пишется пакетом
// (Обработки.АРМПроизводство.ЗаписатьСтрокиПоступления).
//
// Параметры:
//  Строки    - Массив из Структура - Заказ, КодСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок.
//  Накладная - Структура - Номер, Дата - накладная поставщика.
//
// Возвращаемое значение:
//  Массив из Структура - по заказу: Заказ, Успех, Текст, Документ.
//
Функция ОформитьПоступления(Строки, Накладная) Экспорт

	Итоги = Новый Массив;
	ПоЗаказам = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		СтрокаВерна = ТипЗнч(Строка) = Тип("Структура") И Строка.Свойство("Заказ")
			И ТипЗнч(Строка.Заказ) = Тип("ДокументСсылка.ЗаказПоставщику");
		Если Не СтрокаВерна Или Не ЗначениеЗаполнено(Строка.Заказ) Тогда
			Итоги.Добавить(ИтогПоступления(Неопределено, РезультатНеверныхДанных()));
			Возврат Итоги;
		КонецЕсли;
		Если ПоЗаказам[Строка.Заказ] = Неопределено Тогда
			ПоЗаказам.Вставить(Строка.Заказ, Новый Массив);
		КонецЕсли;
		ПоЗаказам[Строка.Заказ].Добавить(Строка);
	КонецЦикла;
	Текст = ТекстЗапретаПоставщиковПоступления(ПоЗаказам);
	Если Не ПустаяСтрока(Текст) Тогда
		Итоги.Добавить(ИтогПоступления(Неопределено, Новый Структура("Успех, Текст", Ложь, Текст)));
		Возврат Итоги;
	КонецЕсли;
	Для Каждого ЗаказИСтроки Из ПоЗаказам Цикл
		СтрокиДанных = Новый Массив;
		Для Каждого Строка Из ЗаказИСтроки.Значение Цикл
			ДанныеСтроки = ДанныеСтрокиЗаказа(ЗаказИСтроки.Ключ, Обработки.АРМПроизводство.ВидПоступление());
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, Строка, "Характеристика, Упаковка, КоличествоУпаковок");
			ДанныеСтроки.КодСтрокиОснования = Строка.КодСтроки;
			ДанныеСтроки.Материал = Строка.Номенклатура;
			СтрокиДанных.Добавить(ДанныеСтроки);
		КонецЦикла;
		Результат = Обработки.АРМПроизводство.ЗаписатьСтрокиПоступления(СтрокиДанных, Накладная);
		Итоги.Добавить(ИтогПоступления(ЗаказИСтроки.Ключ, Результат));
	КонецЦикла;
	Возврат Итоги;

КонецФункции

// Параметры закладки «Потребность» (сборка 2.0.16.30, план docs/plans/arm-purchasing.md, решения владельца 7-10).
//
// Возвращаемое значение:
//  Структура:
//   * Товар         - СправочникСсылка.Номенклатура, Неопределено - отбор по товару.
//   * Поставщик     - СправочникСсылка.Контрагенты, Неопределено - отбор по основному поставщику товара.
//   * ТолькоДефицит - Булево - только строки с дефицитом.
//   * Группировка   - Строка - см. ГруппировкаПоТовару, ГруппировкаПоЗаказу, ГруппировкаПоПоставщику.
//
Функция НовыеПараметрыПотребности() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Товар", Неопределено);
	Параметры.Вставить("Поставщик", Неопределено);
	Параметры.Вставить("ТолькоДефицит", Истина);
	Параметры.Вставить("Группировка", ГруппировкаПоТовару());
	Возврат Параметры;

