// Тесты документов (уровень 3): клиентский запускатель прогона.
//
// Запуск без интерфейса: 1cv8c ENTERPRISE /C "ТестыДокументов;<путь-к-отчёту>" (scripts/doctests.sh).
// Обработка пишет отчёт из строк:
//   "СТАРТ;Сценариев=N"              - клиент дошёл до прогона (признак старта для скрипта);
//   "ОК;<сценарий>;<что проверено>"  - сценарий прошёл;
//   "ОШИБКА;<сценарий>;<описание>"   - проверка или проведение не прошли;
//   "ПРОПУСК;<сценарий>;<причина>"   - в базе нет условий для сценария;
//   "ИТОГ;Сценариев=N;Ошибок=M;Пропущено=K" - маркер завершения прогона,
// после чего завершает работу клиента. При интерактивном открытии формы итог выводится
// сообщениями. Сами сценарии - в модуле менеджера обработки, регламент - docs/TESTING.md.

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Прогон запускается отложенно, чтобы форма успела открыться и клиент завершил инициализацию.
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьПрогон", 1, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Подключаемый_ВыполнитьПрогон()

	ПутьОтчета = ПутьФайлаОтчета();

	// Маркер старта пишется до прогона: по нему scripts/doctests.sh отличает «клиент не поднялся»
	// от «клиент работает, сценарии идут».
	ЗаписатьМаркерСтарта(ПутьОтчета, КоличествоСценариев());

	Попытка
		Итог = ИтогПрогона();
	Исключение
		// Упал сам прогон, а не сценарий: отчёт всё равно нужен, иначе скрипт ждёт таймаут.
		Информация = ИнформацияОбОшибке();
		Итог = Новый Структура;
		Итог.Вставить("Строки", Новый Массив);
		Итог.Вставить("Сценариев", 0);
		Итог.Вставить("Ошибок", 1);
		Итог.Вставить("Пропущено", 0);
		Итог.Строки.Добавить("ОШИБКА;Прогон;" + ОшибкаОднойСтрокой(Информация));
	КонецПопытки;

	СтрокаИтога = "ИТОГ;Сценариев=" + Формат(Итог.Сценариев, ФорматЧисла())
		+ ";Ошибок=" + Формат(Итог.Ошибок, ФорматЧисла())
		+ ";Пропущено=" + Формат(Итог.Пропущено, ФорматЧисла());

	Если ПустаяСтрока(ПутьОтчета) Тогда
		// Интерактивный запуск - итог в окно сообщений, клиент не завершаем.
		Для Каждого СтрокаОтчета Из Итог.Строки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаОтчета);
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаИтога);
	Иначе
		ЗаписатьОтчет(ПутьОтчета, Итог.Строки, СтрокаИтога);
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

// Прогон сценариев. Логика - в модуле менеджера обработки.
//
// Возвращаемое значение:
//  Структура - см. Обработки.ТестыДокументов.ВыполнитьСценарии
//
&НаСервереБезКонтекста
Функция ИтогПрогона()

	Возврат Обработки.ТестыДокументов.ВыполнитьСценарии();

КонецФункции

&НаСервереБезКонтекста
Функция КоличествоСценариев()

	Возврат Обработки.ТестыДокументов.ИменаСценариев().Количество();

КонецФункции

// Ошибка прогона одной строкой: перевод строки в отчёте разделяет записи.
//
// Параметры:
//  Информация - ИнформацияОбОшибке - перехваченная ошибка
//
// Возвращаемое значение:
//  Строка - описание ошибки для строки отчёта
//
&НаКлиенте
Функция ОшибкаОднойСтрокой(Информация)

	// МенеджерОбработкиОшибок в клиентском контексте 8.5.1 не определён (см. СмокТест).
	// BSLLS:DeprecatedMethodCall-off
	Возврат СтрЗаменить(ПодробноеПредставлениеОшибки(Информация), Символы.ПС, " | ");
	// BSLLS:DeprecatedMethodCall-on

КонецФункции

&НаКлиенте
Функция ПутьФайлаОтчета()

	// Формат параметра запуска: ТестыДокументов;<путь-к-отчёту>
	ЧастейСПутемОтчета = 2;
	ЧастиПараметра = СтрРазделить(ПараметрЗапуска, ";");
	Если ЧастиПараметра.Количество() >= ЧастейСПутемОтчета Тогда
		Возврат СокрЛП(ЧастиПараметра[1]);
	КонецЕсли;
	Возврат "";

КонецФункции

// Пишет в отчёт признак того, что клиент поднялся и прогон начался.
//
// Параметры:
//  ПутьОтчета - Строка - файл отчёта; пустая строка - интерактивный запуск, отчёт не ведётся
//  Сценариев  - Число  - сколько сценариев предстоит выполнить
//
&НаКлиенте
Процедура ЗаписатьМаркерСтарта(ПутьОтчета, Сценариев)

	Если ПустаяСтрока(ПутьОтчета) Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ПутьОтчета, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("СТАРТ;Сценариев=" + Формат(Сценариев, ФорматЧисла()));
	Запись.Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтчет(ПутьОтчета, Строки, СтрокаИтога)

	// Отчёт пишется одним файлом в конце прогона: появление строки "ИТОГ;" - признак завершения
	// для scripts/doctests.sh.
	Запись = Новый ЗаписьТекста(ПутьОтчета, КодировкаТекста.UTF8);
	Для Каждого СтрокаОтчета Из Строки Цикл
		Запись.ЗаписатьСтроку(СтрокаОтчета);
	КонецЦикла;
	Запись.ЗаписатьСтроку(СтрокаИтога);
	Запись.Закрыть();

КонецПроцедуры

// Формат целых чисел в отчёте: без разделителей групп и с явным нулём.
//
// Возвращаемое значение:
//  Строка - форматная строка
//
&НаКлиенте
Функция ФорматЧисла()

	Возврат "ЧГ=0; ЧН=0";

КонецФункции

#КонецОбласти
