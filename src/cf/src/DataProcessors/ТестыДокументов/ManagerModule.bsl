// BSLLS:CognitiveComplexity-on
// BSLLS:CyclomaticComplexity-on

// Результат сценария для отчёта.
//
// Параметры:
//  Текст   - Строка - что проверено (ОК) или почему пропущено (ПРОПУСК)
//  Пропуск - Булево - сценарий пропущен: в базе нет условий для проверки
//
// Возвращаемое значение:
//  Структура - Текст, Пропуск
//
Функция РезультатСценария(Текст, Пропуск = Ложь)

	Возврат Новый Структура("Текст, Пропуск", Текст, Пропуск);

КонецФункции

#КонецОбласти

#Область Сценарии

// Закупка: поступление товара даёт остаток на складе и долг перед поставщиком.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийЗакупка(Контекст)

	Числа = Контекст.Числа;
	Поступление = ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	СуммаЗакупки = Числа.КоличествоЗакупки * Числа.ЦенаЗакупки;

	Остаток = ОстатокТовара(Контекст.Склад, Контекст.Товар);
	ПроверитьРавенство(Числа.КоличествоЗакупки, Остаток.Количество, "остаток товара после закупки");
	ПроверитьРавенство(СуммаЗакупки, Остаток.Сумма, "себестоимость остатка после закупки");
	ПроверитьДолгПоставщику(Поступление, СуммаЗакупки, "долг поставщику по поступлению");

	Текст = "остаток " + СтрокаЧисла(Остаток.Количество) + " на " + СтрокаЧисла(Остаток.Сумма)
		+ "; долг поставщику " + СтрокаЧисла(СуммаЗакупки);
	Возврат РезультатСценария(Текст);

КонецФункции

// Продажа: заказ покупателя, реализация по заказу, оплата в кассу. Проверяются остаток,
// регистр продаж (выручка и себестоимость) и закрытие долга покупателя.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПродажа(Контекст)

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);

	Заказ = ДокументЗаказаПокупателя(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);
	Реализация = ДокументРеализацииПоЗаказу(Контекст, Заказ);
	СуммаПродажи = Числа.КоличествоПродажи * Числа.ЦенаПродажи;
	Себестоимость = Числа.КоличествоПродажи * Числа.ЦенаЗакупки;

	ПроверитьРавенство(Заказ, Реализация.Основание, "основание реализации");
	ПроверитьРавенство(СуммаПродажи, Реализация.Сумма, "сумма реализации");

	Остаток = ОстатокТовара(Контекст.Склад, Контекст.Товар);
	ПроверитьРавенство(Числа.КоличествоЗакупки - Числа.КоличествоПродажи, Остаток.Количество, "остаток товара после продажи");

	Продажи = ОборотыПродаж(Реализация);
	ПроверитьРавенство(Числа.КоличествоПродажи, Продажи.Количество, "количество в регистре продаж");
	ПроверитьРавенство(СуммаПродажи, Продажи.Выручка, "выручка в регистре продаж");
	ПроверитьРавенство(Себестоимость, Продажи.Себестоимость, "себестоимость в регистре продаж");
	ПроверитьДолгПокупателя(Реализация, СуммаПродажи, "долг покупателя по реализации");

	Оплата = ДокументОплатыВКассу(Контекст, Реализация, СуммаПродажи);
	ПроверитьДолгПокупателя(Реализация, 0, "долг покупателя после оплаты");
	ПроверитьРавенство(СуммаПродажи, ОстатокДенег(Контекст.Касса), "деньги в кассе после оплаты");

	Текст = "остаток " + СтрокаЧисла(Остаток.Количество) + "; выручка "
		+ СтрокаЧисла(Продажи.Выручка) + ", себестоимость " + СтрокаЧисла(Продажи.Себестоимость)
		+ "; долг закрыт " + ПредставлениеДокумента(Оплата);
	Возврат РезультатСценария(Текст);

КонецФункции

// Возврат от покупателя по реализации: товар возвращается на склад той же партией,
// продажи сторнируются, долг покупателя гасится.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВозвратОтПокупателя(Контекст)

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	Реализация = ДокументРеализации(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);

	ДокВозврата = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	ДокВозврата.Заполнить(Реализация);
	ДокВозврата.Дата = СледующаяДата(Контекст);
	ДокВозврата.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	Провести(ДокВозврата);

	КоличествоВозврата = ДокВозврата.ТЧТовары.Итог("Количество");
	ПроверитьРавенство(Числа.КоличествоПродажи, КоличествоВозврата, "количество в возврате по реализации");

	Остаток = ОстатокТовара(Контекст.Склад, Контекст.Товар);
	ПроверитьРавенство(Числа.КоличествоЗакупки, Остаток.Количество, "остаток товара после возврата");
	ПроверитьРавенство(Числа.КоличествоЗакупки * Числа.ЦенаЗакупки, Остаток.Сумма, "себестоимость остатка после возврата");

	Продажи = ОборотыПродаж(Реализация);
	ПроверитьРавенство(0, Продажи.Количество, "количество продаж после возврата");
	ПроверитьРавенство(0, Продажи.Выручка, "выручка после возврата");
	ПроверитьДолгПокупателя(Реализация, 0, "долг покупателя после возврата");

	Текст = "товар вернулся на склад (" + СтрокаЧисла(Остаток.Количество)
		+ "), продажи сторнированы, долг покупателя закрыт";
	Возврат РезультатСценария(Текст);

КонецФункции

// Выпуск продукции по технологической карте: сырьё списывается, продукция приходуется
// по себестоимости сырья. Работает под функциональной опцией «Производство».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВыпускПродукции(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Сырье, Числа.КоличествоСырья, Числа.ЦенаСырья);

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Номенклатура = Контекст.Продукция;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = Числа.КоличествоВыпуска;
	Выпуск.Количество = Числа.КоличествоВыпуска;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ЗаполнитьСырьеПоТехкарте(Контекст, Выпуск, Числа.КоличествоВыпуска);
	Провести(Выпуск);

	РасходСырья = Числа.РасходСырьяНаЕдиницу * Числа.КоличествоВыпуска;
	Себестоимость = РасходСырья * Числа.ЦенаСырья;

	ПроверитьРавенство(1, Выпуск.ТЧГотоваяПродукция.Количество(), "строк готовой продукции в выпуске");
	ОстатокСырья = ОстатокТовара(Контекст.Склад, Контекст.Сырье);
	ПроверитьРавенство(Числа.КоличествоСырья - РасходСырья, ОстатокСырья.Количество, "остаток сырья после выпуска");
	ОстатокПродукции = ОстатокТовара(Контекст.Склад, Контекст.Продукция);
	ПроверитьРавенство(Числа.КоличествоВыпуска, ОстатокПродукции.Количество, "остаток продукции после выпуска");
	ПроверитьРавенство(Себестоимость, ОстатокПродукции.Сумма, "себестоимость продукции после выпуска");

	Текст = "списано сырья " + СтрокаЧисла(РасходСырья) + ", продукции "
		+ СтрокаЧисла(ОстатокПродукции.Количество) + " на " + СтрокаЧисла(ОстатокПродукции.Сумма);
	Возврат РезультатСценария(Текст);

КонецФункции

// Переработка: передача сырья переработчику и поступление продукции. Сырьё уходит со
// склада к переработчику, возвращается продукцией с себестоимостью сырья и услуг,
// стоимость услуг становится долгом перед переработчиком.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПереработка(Контекст)

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Сырье, Числа.КоличествоСырья, Числа.ЦенаСырья);
	РасходСырья = Числа.РасходСырьяНаЕдиницу * Числа.КоличествоВыпуска;
	СебестоимостьСырья = РасходСырья * Числа.ЦенаСырья;

	Передача = НовыйДокумент(Контекст, "ПередачаВПереработку");
	Передача.Контрагент = Контекст.Контрагент;
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Контекст.Сырье, РасходСырья, 0);
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧГотоваяПродукция", Контекст.Продукция, Числа.КоличествоВыпуска, 0);
	Провести(Передача);

	ОстатокСырья = ОстатокТовара(Контекст.Склад, Контекст.Сырье);
	ПроверитьРавенство(Числа.КоличествоСырья - РасходСырья, ОстатокСырья.Количество, "остаток сырья после передачи");
	ВПереработке = ОстатокВПереработке(Контекст.Контрагент, Контекст.Сырье);
	ПроверитьРавенство(РасходСырья, ВПереработке.Количество, "сырьё у переработчика после передачи");
	ПроверитьРавенство(СебестоимостьСырья, ВПереработке.Сумма, "себестоимость сырья у переработчика");

	Поступление = НовыйДокумент(Контекст, "ПоступлениеИзПереработки");
	Поступление.Заполнить(Передача.Ссылка);
	Поступление.Дата = СледующаяДата(Контекст);
	Поступление.Комментарий = ПометкаТеста();
	Поступление.СтоимостьУслуг = Числа.СтоимостьУслугПереработки;
	Поступление.СтавкаНДСУслуг = Контекст.СтавкаНДС;
	Поступление.СуммаНДСУслуг = 0;
	Провести(Поступление);

	ПроверитьРавенство(РасходСырья, Поступление.ТЧТовары.Итог("Количество"), "сырьё в поступлении по передаче");
	ВПереработке = ОстатокВПереработке(Контекст.Контрагент, Контекст.Сырье);
	ПроверитьРавенство(0, ВПереработке.Количество, "сырьё у переработчика после поступления");
	ОстатокПродукции = ОстатокТовара(Контекст.Склад, Контекст.Продукция);
	ПроверитьРавенство(Числа.КоличествоВыпуска, ОстатокПродукции.Количество, "остаток продукции после переработки");
	ПроверитьРавенство(СебестоимостьСырья + Числа.СтоимостьУслугПереработки, ОстатокПродукции.Сумма,
		"себестоимость продукции с услугами переработчика");
	ПроверитьДолгПоставщику(Поступление.Ссылка, Числа.СтоимостьУслугПереработки, "долг переработчику за услуги");

	Текст = "сырьё " + СтрокаЧисла(РасходСырья) + " ушло и вернулось продукцией "
		+ СтрокаЧисла(ОстатокПродукции.Количество) + " на " + СтрокаЧисла(ОстатокПродукции.Сумма)
		+ "; долг переработчику " + СтрокаЧисла(Числа.СтоимостьУслугПереработки);
	Возврат РезультатСценария(Текст);

КонецФункции

// Переработка по заказам: ожидаемая продукция передачи считается по дереву материалов заказа,
// списание у переработчика отбирает партии своего заказа и беззаказные, а перепроведение
// поступления не задваивает движения (S5-A).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПереработкаПоЗаказам(Контекст)

	Числа = Контекст.Числа;
	Расход = Числа.РасходСырьяНаЕдиницу;
	НаЗаказ = Числа.КоличествоПродажи * Расход;
	// BSLLS:MagicNumber-off - два заказа и одна беззаказная передача на один и тот же переработчик.
	Заказов = 2;
	Беззаказное = Расход * 2;
	ПродукцияБеззаказной = 2;
	Делитель = 2;
	// BSLLS:MagicNumber-on
	ДокументЗакупки(Контекст, Контекст.Сырье, Числа.КоличествоСырья * Заказов, Числа.ЦенаСырья);

	Заказ1 = ЗаказПроведенияСценария(Контекст, Расход);
	Записать(Заказ1);
	Заказ2 = ЗаказПроведенияСценария(Контекст, Расход);
	Записать(Заказ2);

	// Ожидаемая продукция - РОДИТЕЛЬ переданной строки дерева: передаём сырьё, ждём продукцию заказа,
	// а не строку товаров с закупаемым товаром.
	Передача1 = ПередачаСценарияПереработки(Контекст, Заказ1.Ссылка, НаЗаказ + Расход);
	ПроверитьРавенство(1, Передача1.ТЧГотоваяПродукция.Количество(), "ожидаемая продукция - одна строка");
	ПроверитьРавенство(Контекст.Продукция, Передача1.ТЧГотоваяПродукция[0].Номенклатура,
		"ожидаемая продукция - родитель переданного сырья");
	ПроверитьРавенство(Числа.КоличествоПродажи, Передача1.ТЧГотоваяПродукция[0].Количество,
		"сырья хватает на всю продукцию заказа");

	// Частичная передача ограничивает ожидаемую продукцию долей переданного.
	ПередачаЧасть = ПередачаСценарияПереработки(Контекст, Заказ1.Ссылка, НаЗаказ / Делитель);
	ПроверитьРавенство(Числа.КоличествоПродажи / Делитель, ПередачаЧасть.ТЧГотоваяПродукция[0].Количество,
		"половина сырья - половина ожидаемой продукции");

	// Не передано ещё ничего - ожидаемая продукция ПУСТА, а не весь заказ: иначе удаление последней строки
	// товаров молча подставляло бы полное количество заказа, и оно уехало бы в поступление.
	БезКоличества = ПередачаСценарияПереработки(Контекст, Заказ1.Ссылка, 0);
	ПроверитьРавенство(0, БезКоличества.ТЧГотоваяПродукция.Количество(),
		"строка товаров без количества не даёт ожидаемой продукции");

	// Переданное не нашлось в дереве материалов заказа - прежнее поведение: строки товаров заказа.
	ВнеДерева = НовыйДокумент(Контекст, "ПередачаВПереработку");
	ВнеДерева.Контрагент = Контекст.Контрагент;
	ВнеДерева.Основание = Заказ1.Ссылка;
	ДобавитьСтрокуТоваров(Контекст, ВнеДерева, "ТЧТовары", Контекст.Товар, 1, 0);
	ВнеДерева.ЗаполнитьОжидаемуюПродукцию();
	ПроверитьРавенство(1, ВнеДерева.ТЧГотоваяПродукция.Количество(),
		"вне дерева заказа - одна строка продукции заказа");
	ПроверитьРавенство(Контекст.Продукция, ВнеДерева.ТЧГотоваяПродукция[0].Номенклатура,
		"вне дерева заказа - прежнее поведение, продукция из строк товаров");

	Провести(Передача1);
	Передача2 = ПередачаСценарияПереработки(Контекст, Заказ2.Ссылка, НаЗаказ);
	Провести(Передача2);

	// Поступление по первому заказу не трогает партии второго; часть сырья первого заказа остаётся непринятой.
	Поступление1 = ПоступлениеСценарияПереработки(Контекст, Передача1.Ссылка);
	// Сырьё считается по карте от принятой продукции, а не берётся остатком целиком (S5-B): передали на единицу
	// продукции больше, чем нужно заказу, и лишнее у переработчика остаётся. Порога дочистки нет - в карте
	// сценария процент потерь нулевой.
	ПроверитьРавенство(НаЗаказ, ИтогКоличества(Поступление1.ТЧТовары),
		"сырьё поступления - расход по карте на принятую продукцию");
	Провести(Поступление1);
	ПроверитьРавенство(Расход, ОстатокПереработкиПоЗаказу(Контекст, Заказ1.Ссылка),
		"по первому заказу осталось непринятое сырьё");
	ПроверитьРавенство(НаЗаказ, ОстатокПереработкиПоЗаказу(Контекст, Заказ2.Ссылка),
		"партии второго заказа не тронуты");
	ПроверитьИзменениеВыпускаПоступления(Поступление1.Ссылка);

	// Беззаказная передача: списывается своя партия, партии заказов не трогаются.
	Передача3 = НовыйДокумент(Контекст, "ПередачаВПереработку");
	Передача3.Контрагент = Контекст.Контрагент;
	ДобавитьСтрокуТоваров(Контекст, Передача3, "ТЧТовары", Контекст.Сырье, Беззаказное, 0);
	ДобавитьСтрокуТоваров(Контекст, Передача3, "ТЧГотоваяПродукция", Контекст.Продукция, ПродукцияБеззаказной, 0);
	Провести(Передача3);
	Поступление2 = ПоступлениеСценарияПереработки(Контекст, Передача3.Ссылка);
	Провести(Поступление2);
	ПроверитьРавенство(0, ОстатокПереработкиПоЗаказу(Контекст, Документы.ЗаказПокупателя.ПустаяСсылка()),
		"беззаказная партия списана своей передачей");
	ПроверитьРавенство(НаЗаказ, ОстатокПереработкиПоЗаказу(Контекст, Заказ2.Ссылка),
		"беззаказное поступление не тронуло партии заказов");

	// Перепроведение со сдвинутой ВПЕРЁД датой не вычитает собственные прежние движения второй раз
	// (registerRecordsDeletion = AutoDelete), а повторное проведение того же экземпляра объекта не
	// задваивает движения (наборы очищаются явно).
	Поступление2.Дата = СледующаяДата(Контекст);
	Провести(Поступление2);
	ПроверитьРавенство(0, ОстатокПереработкиПоЗаказу(Контекст, Документы.ЗаказПокупателя.ПустаяСсылка()),
		"перепроведение со сдвинутой датой не задваивает расход");
	Провести(Поступление2);
	ПроверитьРавенство(0, ОстатокПереработкиПоЗаказу(Контекст, Документы.ЗаказПокупателя.ПустаяСсылка()),
		"повторное проведение того же объекта не задваивает движения");

	// Отмена проведения возвращает сырьё переработчику, проведение после неё списывает снова.
	Поступление2.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьРавенство(Беззаказное, ОстатокПереработкиПоЗаказу(Контекст, Документы.ЗаказПокупателя.ПустаяСсылка()),
		"отмена проведения возвращает сырьё переработчику");
	Провести(Поступление2);

	ПроверитьРасходПоКартамПереработки(Контекст);

	// Последним шагом - настоящий отказ: он отравляет транзакцию, к базе после него не обращаемся
	// (docs/TESTING.md, п. 3). По второму заказу не хватает одной единицы, а партии первого заказа
	// поступлению второго заказа недоступны - до S5 они бы ушли в списание.
	Отказано = ОтказПоступленияСверхЗаказа(Контекст, Передача2.Ссылка, НаЗаказ + 1);
	Проверить(Отказано, "поступление не добирает недостающее из партий чужого заказа");

	Текст = "ожидаемая продукция по дереву заказа, списание по своему заказу и беззаказным партиям, "
		+ "расход по картам с потерями, порог дочистки и себестоимость, отказ на партиях чужого заказа";
	Возврат РезультатСценария(Текст);

КонецФункции

// Шаги S5-B: расход сырья считается по технологическим картам пропорционально ПРИНЯТОЙ продукции.
//
// Что проверяется и почему именно так:
//  - процент потерь строки продукции подставляется из карты на дату документа;
//  - расход - лимит на ГРУППУ строк остатка, а не на строку: материал лежит двумя сериями, и поштучное
//    Мин(Остаток, Расход) списало бы его вдвое (находка P0 гейта плана);
//  - правка принятого количества пересчитывает сырьё тем же правилом, что обработка заполнения;
//  - порог: остаток выше расхода не больше чем на расчётные потери уходит в списание этого же поступления,
//    движения в регистр Убытки при этом нет, а стоимость дочищенного входит в себестоимость принятого;
//  - дочистка не трогает партии второй, ещё не вернувшейся передачи;
//  - позиция без карты - прежнее поведение, весь остаток передачи;
//  - доработка «передали продукцию - приняли её же»: расход равен принятому, карта не применяется;
//  - веса распределения себестоимости: без реквизита процента вес прежний. Себестоимость самого выпуска
//    продукции проверяет сценарий ПеренесённыеТехкарты (распределение 50/20 по весам 5 и 2).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьРасходПоКартамПереработки(Контекст)

	// BSLLS:MagicNumber-off - числа шага: норма 2, потери 5 %, две серии по 6, принято 4 из 5.
	Материал = НоваяНоменклатура(Контекст, "сырьё потерь", Перечисления.ТипыНоменклатуры.Сырье);
	Продукт = НоваяНоменклатура(Контекст, "продукция потерь", Перечисления.ТипыНоменклатуры.Продукция);
	ЗаписатьКартуСПотерями(Контекст, Продукт, Материал, 2, 5);
	ЗакупкаСерии(Контекст, Материал, 6, НоваяСерия(Материал, "серия А"));
	ЗакупкаСерии(Контекст, Материал, 6, НоваяСерия(Материал, "серия Б"));
	Передача = ПередачаПереработкиСценария(Контекст, Материал, 12, Продукт, 5, Истина);

	Поступление = ПоступлениеСценарияПереработки(Контекст, Передача.Ссылка);
	ПроверитьРавенство(5, Поступление.ТЧГотоваяПродукция[0].ПроцентПотерь,
		"процент потерь строки продукции подставлен из карты");
	УстановитьПринятое(Поступление, Передача.Ссылка, 4);
	// Принято 4: расход 4 x 2 x 1,05 = 8,4 при остатке 12 двумя сериями по 6. Лимит на группу - одна серия
	// уходит целиком, вторая добирает остаток лимита; лимит на строку списал бы 8,4 с каждой серии.
	ПроверитьРавенство(8.4, ИтогКоличества(Поступление.ТЧТовары), "расход - лимит на группу, а не на строку");
	ПроверитьРавенство(2, Поступление.ТЧТовары.Количество(), "расход разложен по двум сериям");
	Большая = Макс(Поступление.ТЧТовары[0].Количество, Поступление.ТЧТовары[1].Количество);
	Меньшая = Мин(Поступление.ТЧТовары[0].Количество, Поступление.ТЧТовары[1].Количество);
	ПроверитьРавенство(6, Большая, "одна серия списана целиком");
	ПроверитьРавенство(2.4, Меньшая, "вторая серия добирает остаток лимита");

	УстановитьПринятое(Поступление, Передача.Ссылка, 5);
	ПроверитьРавенство(10.5, ИтогКоличества(Поступление.ТЧТовары),
		"правка принятого количества пересчитывает сырьё");
	УстановитьПринятое(Поступление, Передача.Ссылка, 4);
	Провести(Поступление);
	ПроверитьРавенство(3.6, ОстатокВПереработке(Контекст.Контрагент, Материал).Количество,
		"непринятое сырьё осталось у переработчика");
	ПроверитьРавенство(84, ОстатокТовара(Контекст.Склад, Продукт).Сумма,
		"себестоимость принятого - стоимость расхода по карте");

	ПроверитьПустуюПродукциюПереработки(Контекст);
	ПроверитьПорогДочисткиПереработки(Контекст);
	ПроверитьВырожденияРасходаПереработки(Контекст);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Второе поступление по полностью принятой передаче не забирает остаток сырья.
//
// Пропорциональный расход S5-B впервые оставляет у переработчика остаток после ПОЛНОЙ приёмки продукции.
// По такой передаче ожидаемая продукция вычтена до нуля и строки удалены - и документ с пустой продукцией
// не должен попадать в ветку «карт нет ни у одной позиции», иначе он забрал бы весь остаток и провёлся,
// списав сырьё без единой строки прихода: стоимость исчезла бы из учёта.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПустуюПродукциюПереработки(Контекст)

	// BSLLS:MagicNumber-off - норма 1, потери 0, передано 6 под 5 продукции, принято 5.
	Материал = НоваяНоменклатура(Контекст, "сырьё полной приёмки", Перечисления.ТипыНоменклатуры.Сырье);
	Продукт = НоваяНоменклатура(Контекст, "продукция полной приёмки", Перечисления.ТипыНоменклатуры.Продукция);
	ЗаписатьКартуСПотерями(Контекст, Продукт, Материал, 1, 0);
	ДокументЗакупки(Контекст, Материал, 6, Контекст.Числа.ЦенаСырья);
	Передача = ПередачаПереработкиСценария(Контекст, Материал, 6, Продукт, 5, Ложь);

	Поступление = ПоступлениеСценарияПереработки(Контекст, Передача.Ссылка);
	ПроверитьРавенство(5, ИтогКоличества(Поступление.ТЧТовары), "расход по карте без потерь равен принятому");
	Провести(Поступление);
	ПроверитьРавенство(1, ОстатокВПереработке(Контекст.Контрагент, Материал).Количество,
		"после полной приёмки у переработчика остался излишек переданного");

	Второе = ПоступлениеСценарияПереработки(Контекст, Передача.Ссылка);
	ПроверитьРавенство(0, Второе.ТЧГотоваяПродукция.Количество(), "ожидаемая продукция принята полностью");
	ПроверитьРавенство(0, Второе.ТЧТовары.Количество(),
		"принимать нечего - второе поступление не забирает остаток сырья");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Порог дочистки: остаток ниже расчётных потерь уходит в списание того же поступления, движения в Убытки нет,
// а партии второй, ещё не вернувшейся передачи дочистка не трогает.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПорогДочисткиПереработки(Контекст)

	// BSLLS:MagicNumber-off - норма 1, потери 5 %, передано 10 и ещё 5 второй передачей, принято 9,5.
	Материал = НоваяНоменклатура(Контекст, "сырьё порога", Перечисления.ТипыНоменклатуры.Сырье);
	Продукт = НоваяНоменклатура(Контекст, "продукция порога", Перечисления.ТипыНоменклатуры.Продукция);
	ЗаписатьКартуСПотерями(Контекст, Продукт, Материал, 1, 5);
	ДокументЗакупки(Контекст, Материал, 15, Контекст.Числа.ЦенаСырья);
	Первая = ПередачаПереработкиСценария(Контекст, Материал, 10, Продукт, 10, Ложь);
	ПередачаПереработкиСценария(Контекст, Материал, 5, Продукт, 5, Ложь);

	Поступление = ПоступлениеСценарияПереработки(Контекст, Первая.Ссылка);
	// Принято 5 из 10: расход 5,25, остаток 10, порог 0,25 - до дочистки далеко, крошка висит.
	УстановитьПринятое(Поступление, Первая.Ссылка, 5);
	ПроверитьРавенство(5.25, ИтогКоличества(Поступление.ТЧТовары), "расход с потерями без дочистки");
	// Принято 9,5: расход 9,975, остаток 10, порог 0,475 - разница 0,025 ниже порога, идёт весь остаток.
	УстановитьПринятое(Поступление, Первая.Ссылка, 9.5);
	ПроверитьРавенство(10, ИтогКоличества(Поступление.ТЧТовары),
		"остаток ниже расчётных потерь уходит в списание того же поступления");
	Провести(Поступление);
	ПроверитьРавенство(0, УбыткиДокумента(Поступление.Ссылка), "дочистка не пишет движений в Убытки");
	ПроверитьРавенство(5, ОстатокВПереработке(Контекст.Контрагент, Материал).Количество,
		"дочистка не трогает партии второй, ещё не вернувшейся передачи");
	ПроверитьРавенство(100, ОстатокТовара(Контекст.Склад, Продукт).Сумма,
		"стоимость дочищенного остатка вошла в себестоимость принятого");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Вырождения расчёта: позиция без карты и доработка «передали продукцию - приняли её же», плюс веса
// распределения себестоимости.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьВырожденияРасходаПереработки(Контекст)

	// BSLLS:MagicNumber-off - без карты передано 4 под 2 продукции; доработка - 4 той же номенклатуры.
	БезКарты = НоваяНоменклатура(Контекст, "сырьё без карты", Перечисления.ТипыНоменклатуры.Сырье);
	ПродуктБезКарты = НоваяНоменклатура(Контекст, "продукция без карты", Перечисления.ТипыНоменклатуры.Продукция);
	ДокументЗакупки(Контекст, БезКарты, 4, Контекст.Числа.ЦенаСырья);
	ПередачаБезКарты = ПередачаПереработкиСценария(Контекст, БезКарты, 4, ПродуктБезКарты, 2, Ложь);
	Поступление = ПоступлениеСценарияПереработки(Контекст, ПередачаБезКарты.Ссылка);
	ПроверитьРавенство(4, ИтогКоличества(Поступление.ТЧТовары),
		"карты нет ни у одной позиции - весь остаток передачи, поведение до S5-B");

	// Доработка: переработчику отдали готовую продукцию и приняли её же. Карта продукции состоит из материала,
	// которого у переработчика по этой передаче нет; без правила «продукция = сырьё» документ заполнился бы
	// пустым, а себестоимость свелась к услугам.
	Материал = НоваяНоменклатура(Контекст, "сырьё доработки", Перечисления.ТипыНоменклатуры.Сырье);
	Продукт = НоваяНоменклатура(Контекст, "продукция доработки", Перечисления.ТипыНоменклатуры.Продукция);
	ЗаписатьКартуСПотерями(Контекст, Продукт, Материал, 1, 5);
	ДокументЗакупки(Контекст, Продукт, 4, Контекст.Числа.ЦенаСырья);
	ДокументЗакупки(Контекст, Материал, 4, Контекст.Числа.ЦенаСырья);
	// Передаём И изделие на перешив, И материал его карты: приёмка изделий не должна вдобавок списать
	// материал по карте этого изделия - иначе спишется вдвое больше принятого.
	ПередачаДоработки = НовыйДокумент(Контекст, "ПередачаВПереработку");
	ПередачаДоработки.Контрагент = Контекст.Контрагент;
	ИмяСырьяДоработки = ИмяТаблицыСырья();
	ДобавитьСтрокуТоваров(Контекст, ПередачаДоработки, ИмяСырьяДоработки, Продукт, 4, 0);
	ДобавитьСтрокуТоваров(Контекст, ПередачаДоработки, ИмяСырьяДоработки, Материал, 4, 0);
	ДобавитьСтрокуТоваров(Контекст, ПередачаДоработки, ИмяТаблицыПродукции(), Продукт, 4, 0);
	Провести(ПередачаДоработки);
	Доработка = ПоступлениеСценарияПереработки(Контекст, ПередачаДоработки.Ссылка);
	ПроверитьРавенство(1, Доработка.ТЧТовары.Количество(), "доработка даёт одну строку расхода");
	ПроверитьРавенство(Продукт, Доработка.ТЧТовары[0].Номенклатура,
		"в расход доработки попала сама продукция, а не материал её карты");
	ПроверитьРавенство(4, ИтогКоличества(Доработка.ТЧТовары), "расход доработки равен принятому");
	Провести(Доработка);
	ПроверитьРавенство(4, ОстатокВПереработке(Контекст.Контрагент, Материал).Количество,
		"материал карты перешиваемого изделия у переработчика не тронут");

	// Та же позиция одновременно перешив И материал карты ДРУГОЙ принимаемой продукции: её собственная
	// карта не применяется, а расход под чужую продукцию к перешиву ПРИБАВЛЯЕТСЯ. Замещение одного другим
	// недосписало бы позицию и занизило себестоимость чужой продукции, ничего не сказав.
	Изделие = НоваяНоменклатура(Контекст, "изделие из полуфабриката", Перечисления.ТипыНоменклатуры.Продукция);
	ЗаписатьКартуСПотерями(Контекст, Изделие, Продукт, 1, 0);
	ДокументЗакупки(Контекст, Продукт, 6, Контекст.Числа.ЦенаСырья);
	ПередачаОбоих = НовыйДокумент(Контекст, "ПередачаВПереработку");
	ПередачаОбоих.Контрагент = Контекст.Контрагент;
	ИмяСырья = ИмяТаблицыСырья();
	ИмяПродукции = ИмяТаблицыПродукции();
	ДобавитьСтрокуТоваров(Контекст, ПередачаОбоих, ИмяСырья, Продукт, 6, 0);
	ДобавитьСтрокуТоваров(Контекст, ПередачаОбоих, ИмяПродукции, Продукт, 4, 0);
	ДобавитьСтрокуТоваров(Контекст, ПередачаОбоих, ИмяПродукции, Изделие, 2, 0);
	Провести(ПередачаОбоих);
	Обе = ПоступлениеСценарияПереработки(Контекст, ПередачаОбоих.Ссылка);
	ПроверитьРавенство(1, Обе.ТЧТовары.Количество(), "расход обеих позиций сведён в одну строку сырья");
	ПроверитьРавенство(Продукт, Обе.ТЧТовары[0].Номенклатура, "расход идёт по самой передаваемой позиции");
	// Перешив 4 с потерями 5 % это 4,2, расход под изделие - 2 по карте; вместе 6,2 при остатке 6.
	ПроверитьРавенство(6, ИтогКоличества(Обе.ТЧТовары),
		"перешив и расход под чужую карту складываются, а не замещают друг друга");

	// Веса распределения себестоимости: у документа без реквизита процента (выпуск продукции) вес прежний -
	// «Количество х сумма норм карты». Контрольная точка к риску «единицы нормы»: расход строится по упаковкам,
	// веса - по количеству, и смешивать их нельзя.
	ТЗВеса = Новый ТаблицаЗначений;
	ТЗВеса.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗВеса.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	СтрокаВеса = ТЗВеса.Добавить();
	СтрокаВеса.Номенклатура = Продукт;
	СтрокаВеса.Количество = 3;
	ПроверитьРавенство(3, ТехнологическиеКарты.ВесаПродукции(ТЗВеса, Контекст.Дата)[0],
		"вес без реквизита процента - количество на норму карты");
	ТЗВеса.Колонки.Добавить("ПроцентПотерь", Новый ОписаниеТипов("Число"));
	ТЗВеса[0].ПроцентПотерь = 25;
	ПроверитьРавенство(3.75, ТехнологическиеКарты.ВесаПродукции(ТЗВеса, Контекст.Дата)[0],
		"процент потерь входит в вес строки продукции");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Карта продукции из одного материала с процентом потерь; датируется датой сценария, как карта НоваяПродукция.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Продукция - СправочникСсылка.Номенклатура - продукция карты
//  Материал  - СправочникСсылка.Номенклатура - материал карты
//  Норма     - Число - расход на единицу продукции
//  Процент   - Число - процент потерь строки материала
//
Процедура ЗаписатьКартуСПотерями(Контекст, Продукция, Материал, Норма, Процент)

	Состав = СоставИзМатериала(Контекст, Материал, Норма);
	Состав.Колонки.Добавить("ПроцентПотерь", Новый ОписаниеТипов("Число"));
	Состав[0].ПроцентПотерь = Процент;
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Контекст.Дата);

КонецПроцедуры

// Проведённая закупка номенклатуры с серией: остаток одной серии на складе сценария.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Номенклатура - СправочникСсылка.Номенклатура - позиция
//  Количество   - Число - количество
//  Серия        - СправочникСсылка.СерииНоменклатуры - серия строки
//
Процедура ЗакупкаСерии(Контекст, Номенклатура, Количество, Серия)

	Док = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПоставщика;
	Док.ЦенаВключаетНДС = Истина;
	Док.Валюта = Контекст.Валюта;
	Док.КурсВалюты = 1;
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Номенклатура, Количество, Контекст.Числа.ЦенаСырья);
	Док.ТЧТовары[0].Серия = Серия;
	Провести(Док);

КонецПроцедуры

// Проведённая передача в переработку без заказа-основания с явной ожидаемой продукцией.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Материал   - СправочникСсылка.Номенклатура - передаваемая позиция
//  Количество - Число - сколько передаётся; при ПоСериям делится поровну между сериями остатка
//  Продукция  - СправочникСсылка.Номенклатура - ожидаемая продукция
//  Ожидается  - Число - количество ожидаемой продукции
//  ПоСериям   - Булево - передать двумя строками по сериям остатка склада
//
// Возвращаемое значение:
//  ДокументОбъект.ПередачаВПереработку - проведённая передача
//
Функция ПередачаПереработкиСценария(Контекст, Материал, Количество, Продукция, Ожидается, ПоСериям)

	Передача = НовыйДокумент(Контекст, "ПередачаВПереработку");
	Передача.Контрагент = Контекст.Контрагент;
	Если ПоСериям Тогда
		Серии = СерииОстаткаСклада(Контекст, Материал);
		Для Каждого Серия Из Серии Цикл
			ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Материал, Серия.Количество, 0);
			Передача.ТЧТовары[Передача.ТЧТовары.Количество() - 1].Серия = Серия.Серия;
		КонецЦикла;
	Иначе
		ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Материал, Количество, 0);
	КонецЕсли;
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧГотоваяПродукция", Продукция, Ожидается, 0);
	Провести(Передача);
	Возврат Передача;

КонецФункции

// Серии остатка позиции на складе сценария, в порядке серий.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Материал - СправочникСсылка.Номенклатура - позиция
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Серия и Количество
//
Функция СерииОстаткаСклада(Контекст, Материал)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Остатки.Серия КАК Серия,
		|	Остатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии.Остатки(
		|			,
		|			МестоХранения = &Склад
		|				И Номенклатура = &Номенклатура) КАК Остатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	Серия");
	Запрос.УстановитьПараметр("Склад", Контекст.Склад);
	Запрос.УстановитьПараметр("Номенклатура", Материал);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Принятое количество единственной строки продукции и пересчёт сырья ТОЙ ЖЕ точкой, что зовёт форма
// документа (Документы.ПоступлениеИзПереработки.ЗаполнитьСырье): повторять её тело здесь нельзя - путь
// формы перестал бы проверяться сценарием.
//
// Параметры:
//  Поступление - ДокументОбъект.ПоступлениеИзПереработки - непроведённое поступление
//  Передача    - ДокументСсылка.ПередачаВПереработку - передача-основание
//  Количество  - Число - принятая продукция
//
Процедура УстановитьПринятое(Поступление, Передача, Количество)

	Поступление.ТЧГотоваяПродукция[0].Количество = Количество;
	Поступление.ТЧГотоваяПродукция[0].КоличествоУпаковок = Количество;
	Документы.ПоступлениеИзПереработки.ЗаполнитьСырье(Поступление, Передача);

КонецПроцедуры

