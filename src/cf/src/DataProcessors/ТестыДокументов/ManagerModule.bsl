//  ХозяйственнаяОперация - ПеречислениеСсылка.ХозяйственныеОперации - операция документа
//
// Возвращаемое значение:
//  СправочникСсылка.СтатьиДвиженияДенежныхСредств - статья
//
Функция СтатьяДДС(Контекст, ХозяйственнаяОперация)

	Статья = ОбщегоНазначенияВызовСервера.ПолучитьСтатьюДДСПоХозяйственнойОперации(ХозяйственнаяОперация);
	Если ЗначениеЗаполнено(Статья) Тогда
		Возврат Статья;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Контекст.СтатьяДДСЗапасная) Тогда
		Запасная = Справочники.СтатьиДвиженияДенежныхСредств.СоздатьЭлемент();
		Запасная.Наименование = ПометкаТеста() + ": статья ДДС";
		Запасная.Записать();
		Контекст.СтатьяДДСЗапасная = Запасная.Ссылка;
	КонецЕсли;

	Возврат Контекст.СтатьяДДСЗапасная;

