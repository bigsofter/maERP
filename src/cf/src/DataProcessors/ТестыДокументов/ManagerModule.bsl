// Загрузка данных инвариант не обходит: ордер в режиме загрузки при выключенной опции - отказ.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  ИмяДокумента - Строка - ПриходныйОрдер или РасходныйОрдер.
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОпцияОрдерныхСкладовОтказЗагрузки(Контекст, ИмяДокумента)

	Причина = ПричинаПропускаОпцииОрдерныхСкладов();
	Если ЗначениеЗаполнено(Причина) Тогда
		Возврат РезультатСценария(Причина, Истина);
	КонецЕсли;
	Константы.ИспользоватьОрдерныеСклады.Установить(Ложь);
	Ордер = НовыйДокумент(Контекст, ИмяДокумента);
	Ордер.ОбменДанными.Загрузка = Истина;
	ПолучитьСообщенияПользователю(Истина);
	Отказ = Ложь;
	Попытка
		Ордер.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, ИмяДокумента + " загрузкой при выключенной опции - отказ");
	Проверить(ЕстьСообщениеОтказа(ФрагментыОтказаОпцииОрдерныхСкладов()), "отказ загрузки - с текстом про опцию");
	Возврат РезультатСценария(ИмяДокумента + " и в режиме загрузки при выключенной опции не записывается");

КонецФункции

