// Обороты регистра продаж по документу продажи: количество, выручка, себестоимость.
//
// Параметры:
//  ДокументПродажи - ДокументСсылка.РеализацияТоваровУслуг - документ продажи
//
// Возвращаемое значение:
//  Структура - Количество, Выручка, Себестоимость
//
Функция ОборотыПродаж(ДокументПродажи)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Обороты.КоличествоОборот), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(Обороты.ВыручкаОборот), 0) КАК Выручка
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(, , , ДокументПродажи = &ДокументПродажи) КАК Обороты");
	Запрос.УстановитьПараметр("ДокументПродажи", ДокументПродажи);
	Результат = ПерваяСтрока(Запрос, "Количество, Выручка");
	// Себестоимость партий - из себестоимости продаж (план warehouse-orders-cost, фаза 2), без допрасходов, как прежде.
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Обороты.СуммаОборот), 0) КАК Себестоимость
		|ИЗ
		|	РегистрНакопления.СебестоимостьПродаж.Обороты(, , , ДокументПродажи = &ДокументПродажи
		|		И НЕ ДополнительныйРасход) КАК Обороты";
	Результат.Вставить("Себестоимость", ПерваяСтрока(Запрос, "Себестоимость").Себестоимость);
	Возврат Результат;

