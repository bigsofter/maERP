		Для Каждого Группа Из Группы Цикл
			Проверить(ПравоДоступа(Право, Группа, Роль), Описание + " видит " + Группа.ПолноеИмя());
		КонецЦикла;
	КонецЦикла;
	Логист = Метаданные.Роли.Логист;
	Проверить(ПравоДоступа(Право, Склад, Логист), "Логист видит раздел «Склад»");
