// Число записей себестоимости продаж документа.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ
//  Активность  - Булево, Неопределено - только с этой активностью
//  Поправка    - Булево, Неопределено - только записи поправки или только прочие
//
// Возвращаемое значение:
//  Число
//
Функция ЧислоЗаписейСебестоимости(Регистратор, Активность = Неопределено, Поправка = Неопределено)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрНакопления.СебестоимостьПродаж КАК Т
		|ГДЕ
		|	Т.Регистратор = &Регистратор
		|	И Т.Активность В (&Активности)
		|	И Т.Поправка В (&Поправки)");
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Активности", ЗначенияПризнака(Активность));
	Запрос.УстановитьПараметр("Поправки", ЗначенияПризнака(Поправка));
	Возврат ПерваяСтрока(Запрос, "Количество").Количество;

КонецФункции

Функция ЗначенияПризнака(Значение)

	Значения = Новый Массив;
	Если Значение = Неопределено Тогда
		Значения.Добавить(Истина);
		Значения.Добавить(Ложь);
	Иначе
		Значения.Добавить(Значение);
	КонецЕсли;
	Возврат Значения;

КонецФункции

