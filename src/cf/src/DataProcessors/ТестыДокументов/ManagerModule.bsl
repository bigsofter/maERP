КонецФункции

// Обороты регистра продаж по документу продажи: количество, выручка, себестоимость.
//
// Параметры:
//  ДокументПродажи - ДокументСсылка.РеализацияТоваровУслуг - документ продажи
//
// Возвращаемое значение:
//  Структура - Количество, Выручка, Себестоимость
//
Функция ОборотыПродаж(ДокументПродажи)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Обороты.КоличествоОборот), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(Обороты.ВыручкаОборот), 0) КАК Выручка,
		|	ЕСТЬNULL(СУММА(Обороты.СебестоимостьОборот), 0) КАК Себестоимость
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(, , , ДокументПродажи = &ДокументПродажи) КАК Обороты");
	Запрос.УстановитьПараметр("ДокументПродажи", ДокументПродажи);
	Возврат ПерваяСтрока(Запрос, "Количество, Выручка, Себестоимость");

КонецФункции

