// Накопленные сообщения пользователю одной строкой: в них причина отказа в проведении.
//
// Возвращаемое значение:
//  Строка - тексты сообщений через разделитель; пустая, если сообщений нет
//
Функция СообщенияПользователю()

	Части = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Части.Добавить(СтрЗаменить(Сообщение.Текст, Символы.ПС, " "));
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат " | " + СтрСоединить(Части, " | ");

КонецФункции

#КонецОбласти

#Область Регистры

// Остаток номенклатуры на складе: количество и себестоимость.
//
// Параметры:
//  Склад        - СправочникСсылка.МестаХранения - склад
//  Номенклатура - СправочникСсылка.Номенклатура - позиция номенклатуры
//
// Возвращаемое значение:
//  Структура - Количество, Сумма
//
Функция ОстатокТовара(Склад, Номенклатура)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии.Остатки(, МестоХранения = &Склад И Номенклатура = &Номенклатура) КАК Остатки");
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат ПерваяСтрока(Запрос, "Количество, Сумма");

КонецФункции

// Остаток сырья у переработчика: количество и себестоимость.
//
// Параметры:
//  Контрагент   - СправочникСсылка.Контрагенты - контрагент
//  Номенклатура - СправочникСсылка.Номенклатура - позиция номенклатуры
//
// Возвращаемое значение:
//  Структура - Количество, Сумма
//
Функция ОстатокВПереработке(Контрагент, Номенклатура)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ТоварыВПереработке.Остатки(, Контрагент = &Контрагент И Номенклатура = &Номенклатура) КАК Остатки");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат ПерваяСтрока(Запрос, "Количество, Сумма");

КонецФункции

// Остаток регистра взаиморасчётов по объекту расчётов.
//
// Параметры:
//  ИмяРегистра    - Строка - имя регистра взаиморасчётов
//  ОбъектРасчетов - ДокументСсылка - документ расчётов
//
// Возвращаемое значение:
//  Число - остаток регистра
//
Функция ОстатокВзаиморасчетов(ИмяРегистра, ОбъектРасчетов)

	// Регистры покупателей и поставщиков устроены одинаково: текст пишется по одному,
	// имя второго подставляется.
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, ОбъектРасчётов = &ОбъектРасчетов) КАК Остатки";
	Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "ВзаиморасчётыСПокупателями", ИмяРегистра));
	Запрос.УстановитьПараметр("ОбъектРасчетов", ОбъектРасчетов);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;

КонецФункции

// Остаток денег в кассе или на банковском счёте организации.
//
// Параметры:
//  МестоХранения - СправочникСсылка.Кассы, СправочникСсылка.БанковскиеСчета - касса или счёт
//
// Возвращаемое значение:
//  Число - остаток денег
