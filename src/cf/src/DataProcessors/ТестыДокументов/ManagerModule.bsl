// Снимок движений документа по всем регистрам: содержимое каждого набора записей во внутреннем представлении.
//
// Параметры:
//  Ссылка - ДокументСсылка - документ
//
// Возвращаемое значение:
//  Строка - снимок; равные снимки - одинаковые записи в том же порядке
//
Функция СнимокДвиженийДокумента(Ссылка)

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	Части = Новый Массив;
	Для Каждого Набор Из ДокументОбъект.Движения Цикл
		Набор.Прочитать();
		Части.Добавить(Набор.Метаданные().ПолноеИмя() + "=" + ЗначениеВСтрокуВнутр(Набор.Выгрузить()));
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// BSLLS:DeprecatedMethodCall-on

#КонецОбласти

#Область СтанкиИОбслуживание

// Учёт станков, сборка 1 (2.0.16.32): фонд времени по режиму работы и производственному календарю, обслуживание
// пишет «Загрузку станков», правило пересечений, отчёт «Простои станков», состав функциональной опции.
// Даты - неделя 2099 года: праздник пишется в общий производственный календарь, а сценарий откатывается.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСтанкиИОбслуживание(Контекст)

	ПроверитьСоставОпцииУчетаСтанков();

	// BSLLS:MagicNumber-off - часы смен и интервалов сценария.
	Понедельник = НачалоНедели(Дата(2099, 1, 7));
	Среда = Понедельник + 2 * 86400;
	Неделя = Понедельник + 7 * 86400;
	ЗаписатьВыходнойКалендаря(Среда);

	Станок = НовыйСтанокСценария("экструдер");
	Станок2 = НовыйСтанокСценария("ткацкий");
	ПроверитьФондВремени(Станок, Станок2, Понедельник, Неделя);

	// План пишет запись «План», перевод того же документа в факт - запись факта; перепроведение не конфликтует с собой.
	Вторник = Понедельник + 86400;
	ТО = НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина,
		Вторник + 10 * 3600, Вторник + 12 * 3600);
	ПроверитьЗаписьЗагрузки(ТО.Ссылка, Истина, 2, "плановое ТО");
	ТО.Плановое = Ложь;
	ТО.Окончание = Вторник + 12.5 * 3600;
	ТО.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьЗаписьЗагрузки(ТО.Ссылка, Ложь, 2.5, "ТО переведено в факт");
	ТО.Записать(РежимЗаписиДокумента.Проведение);

	ПроверитьПравилоПересечений(Станок, Станок2, ТО.Ссылка, Понедельник);
	ПроверитьОтчетПростоев(Станок, Понедельник, Неделя);

	// Последним шагом: после отказа проведения транзакция сценария годится только для отката.
	Отказано = ОтказОбслуживания(Станок, Вторник + 11 * 3600, Вторник + 12 * 3600);
	Проверить(Отказано, "второе фактическое обслуживание станка в занятое время не проводится");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("станки: фонд по режиму со сменой через полночь, календарём и круглосуточной сменой; "
		+ "обслуживание пишет загрузку плана и факта; пересечения по слоям; отчёт простоев с фондом и процентом");

КонецФункции

// Все новые объекты и поля станка - в составе опции «Учёт станков»: без неё их не видно ни в меню, ни в формах.
//
Процедура ПроверитьСоставОпцииУчетаСтанков()

	Опция = "ИспользоватьУчетСтанков";
	Станки = Метаданные.Справочники.ПроизводственноеОборудование;
	Проверить(ВСоставеОпции(Опция, Метаданные.Документы.ОбслуживаниеСтанка), "документ обслуживания в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.РегистрыСведений.ЗагрузкаСтанков), "регистр загрузки в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.Отчеты.ПростоиСтанков), "отчёт простоев в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.Документы.ТребованиеНакладная), "требование-накладная в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.РегистрыНакопления.МатериалыНаСтанках), "материалы на станках в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.Документы.ВыпускПродукции.Реквизиты.Требование), "требование выпуска в опции");
	Проверить(ВСоставеОпции(Опция, Станки.ТабличныеЧасти.РежимРаботы), "режим работы станка в опции");
	Проверить(ВСоставеОпции(Опция, Станки.ТабличныеЧасти.ВыработкаПоНоменклатуре), "выработка по номенклатуре в опции");
	Для Каждого Реквизит Из Станки.Реквизиты Цикл
		Проверить(ВСоставеОпции(Опция, Реквизит), "реквизит станка " + Реквизит.Имя + " в опции");
	КонецЦикла;
	// С 2.0.16.44 справочник станков и поле «Оборудование» выпуска - под опцией: без учёта станков их не видно.
	Проверить(ВСоставеОпции(Опция, Станки), "справочник станков в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.Документы.ВыпускПродукции.Реквизиты.Оборудование), "оборудование выпуска в опции");
	// С 2.0.16.44 всё по станкам - в группе «Производство / Станки», а не в «Важном» раздела.
	Группа = Метаданные.Подсистемы.Производство.Подсистемы.Станки;
	Проверить(Группа.Состав.Содержит(Метаданные.Документы.ОбслуживаниеСтанка), "обслуживание - в группе «Станки»");
	Проверить(Группа.Состав.Содержит(Метаданные.Отчеты.ПростоиСтанков), "простои - в группе «Станки»");
	Проверить(Группа.Состав.Содержит(Метаданные.Документы.ТребованиеНакладная), "требования-накладные - в группе «Станки»");
	Проверить(Группа.Состав.Содержит(Станки), "справочник станков - в группе «Станки»");
	// Рабочее место «Управление станками» (бывшая закладка АРМ производства): под опцией, в «Важном» и в «Станках».
	АРМСтанков = Метаданные.Обработки.АРМУправлениеСтанками;
	Проверить(ВСоставеОпции(Опция, АРМСтанков), "рабочее место станков в опции");
	Проверить(Метаданные.Подсистемы.Производство.Состав.Содержит(АРМСтанков), "рабочее место станков - в «Важном»");
	Проверить(Группа.Состав.Содержит(АРМСтанков), "рабочее место станков - в группе «Станки»");
	// Значение опции зависит от базы, проверяется состав прав, а не их значения.
	ПраваСтанков = Обработки.АРМУправлениеСтанками.ПраваРабочегоМеста();
	Для Каждого Имя Из СтрРазделить("МожноВидетьСтанки,МожноРазмещатьНаСтанки,МожноОбслуживаниеСтанков", ",") Цикл
		Проверить(ПраваСтанков.Свойство(Имя), "право рабочего места станков " + Имя);
	КонецЦикла;
	// Без открытых требований и закреплённых материалов выключение учёта станков не запрещено.
	ТекстЗапрета = ЗагрузкаСтанков.ТекстЗапретаВыключенияУчета();
	ПроверитьРавенство("", ТекстЗапрета, "запрет выключения учёта станков");

КонецПроцедуры

// Станок: Пн-Пт 08:00-20:00, в понедельник ещё ночная смена 22:00-06:00; календарь учитывается (умолчание).
//
// Параметры:
//  Вид - Строка - вид станка, он же начало наименования
//
// Возвращаемое значение:
//  СправочникСсылка.ПроизводственноеОборудование - записанный станок
//
Функция НовыйСтанокСценария(Вид)

	// BSLLS:MagicNumber-off
	СтанокОбъект = Справочники.ПроизводственноеОборудование.СоздатьЭлемент();
	СтанокОбъект.Наименование = Вид + " (" + ПометкаТеста() + ")";
	СтанокОбъект.ВидСтанка = Вид;
	СтанокОбъект.Выработка = 120;
	СтанокОбъект.ВремяНаСменуЗаказа = 15;
	Для НомерДня = 1 По 5 Цикл
		ДобавитьСменуСтанка(СтанокОбъект, НомерДня, Дата(1, 1, 1, 8, 0, 0), Дата(1, 1, 1, 20, 0, 0));
	КонецЦикла;
	ДобавитьСменуСтанка(СтанокОбъект, 1, Дата(1, 1, 1, 22, 0, 0), Дата(1, 1, 1, 6, 0, 0));
	// BSLLS:MagicNumber-on
	Проверить(СтанокОбъект.ПроверитьЗаполнение(), "режим станка со сменой через полночь проходит проверку");
	СтанокОбъект.Записать();
	Возврат СтанокОбъект.Ссылка;

КонецФункции

// Строка режима работы станка.
//
// Параметры:
//  СтанокОбъект   - СправочникОбъект.ПроизводственноеОборудование - станок
//  НомерДня       - Число - день недели, 1 - понедельник
//  НачалоСмены    - Дата - время начала
//  ОкончаниеСмены - Дата - время окончания
//  Круглосуточно  - Булево - смена на сутки
//
Процедура ДобавитьСменуСтанка(СтанокОбъект, НомерДня, НачалоСмены, ОкончаниеСмены, Круглосуточно = Ложь)

	Смена = СтанокОбъект.РежимРаботы.Добавить();
	Смена.ДеньНедели = Перечисления.ДниНедели.Получить(НомерДня - 1);
	Смена.НачалоСмены = НачалоСмены;
	Смена.ОкончаниеСмены = ОкончаниеСмены;
	Смена.Круглосуточно = Круглосуточно;

КонецПроцедуры

// Нерабочий день производственного календаря.
//
// Параметры:
//  День - Дата - день
//
Процедура ЗаписатьВыходнойКалендаря(День)

	Набор = РегистрыСведений.ПроизводственныйКалендарь.СоздатьНаборЗаписей();
	Набор.Отбор.Дата.Установить(День);
	Набор.Добавить().Дата = День;
	Набор.Записать();

КонецПроцедуры

// Фонд недели: 12 часов в Пн, Вт, Чт, Пт и 8 часов ночной смены понедельника, среда - день календаря.
//
// Параметры:
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок с календарём
//  Станок2     - СправочникСсылка.ПроизводственноеОборудование - станок, который станет без календаря
//  Понедельник - Дата - начало недели
//  Неделя      - Дата - начало следующей недели
//
Процедура ПроверитьФондВремени(Станок, Станок2, Понедельник, Неделя)

	// BSLLS:MagicNumber-off
	Получено = ЗагрузкаСтанков.ФондВремениСтанка(Станок, Понедельник, Неделя);
	ПроверитьРавенство(56, Получено,
		"фонд недели: смена через полночь, среда - день календаря");
	Получено = ЗагрузкаСтанков.ФондВремениСтанка(Станок, Понедельник + 8 * 3600, Понедельник + 12 * 3600);
	ПроверитьРавенство(4, Получено,
		"фонд обрезан периодом");
	Получено = ЗагрузкаСтанков.ФондВремениСтанка(Станок, Понедельник + 86400, Понедельник + 2 * 86400);
	ПроверитьРавенство(18, Получено,
		"вторник: хвост ночной смены понедельника до 06:00 и дневная смена");

	// Без календаря среда рабочая; суббота второго станка - круглосуточно.
	СтанокОбъект = Станок2.ПолучитьОбъект();
	СтанокОбъект.РаботаетБезКалендаря = Истина;
	ДобавитьСменуСтанка(СтанокОбъект, 6, '00010101', '00010101', Истина);
	СтанокОбъект.Записать();
	Получено = ЗагрузкаСтанков.ФондВремениСтанка(Станок2, Понедельник, Неделя);
	ПроверитьРавенство(56 + 12 + 24, Получено,
		"без календаря среда рабочая, суббота круглосуточно");

	// Пустая строка без «Круглосуточно» не проходит проверку: 00:00-00:00 - пустая дата, а не сутки.
	ДобавитьСменуСтанка(СтанокОбъект, 7, '00010101', '00010101');
	Проверить(Не СтанокОбъект.ПроверитьЗаполнение(), "смена 00:00-00:00 без флажка «Круглосуточно» отклоняется");
	ПолучитьСообщенияПользователю(Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Проведённое обслуживание станка.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Вид       - ПеречислениеСсылка.ВидыОбслуживанияСтанков - вид обслуживания
//  Плановое  - Булево - запланированное
//  Начало    - Дата - начало
//  Окончание - Дата - окончание
//
// Возвращаемое значение:
//  ДокументОбъект.ОбслуживаниеСтанка - документ
//
Функция НовоеОбслуживание(Станок, Вид, Плановое, Начало, Окончание)

	Обслуживание = Документы.ОбслуживаниеСтанка.СоздатьДокумент();
	Обслуживание.Дата = ТекущаяДатаСеанса();
	Обслуживание.Станок = Станок;
	Обслуживание.ВидОбслуживания = Вид;
	Обслуживание.Плановое = Плановое;
	Обслуживание.Начало = Начало;
	Обслуживание.Окончание = Окончание;
	Обслуживание.Причина = ПометкаТеста();
	Обслуживание.Комментарий = ПометкаТеста();
	Обслуживание.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Обслуживание;

КонецФункции

// Единственная запись «Загрузки станков» документа.
//
// Параметры:
//  Регистратор - ДокументСсылка.ОбслуживаниеСтанка - документ
//  План        - Булево - ожидаемый слой
//  Часы        - Число - ожидаемые часы
//  Описание    - Строка - что проверяется
//
Процедура ПроверитьЗаписьЗагрузки(Регистратор, План, Часы, Описание)

	Набор = РегистрыСведений.ЗагрузкаСтанков.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	ПроверитьРавенство(1, Набор.Количество(), Описание + ": одна запись загрузки");
	ПроверитьРавенство(План, Набор[0].План, Описание + ": план или факт");
	ПроверитьРавенство(Часы, Набор[0].Часы, Описание + ": часы");
	ПроверитьРавенство(Перечисления.ВидыЗагрузкиСтанков.Обслуживание, Набор[0].ВидЗаписи, Описание + ": вид записи");

КонецПроцедуры

// Конфликт - план с планом любого вида и факт с фактом того же вида. Факт ТО на станке - вторник 10:00-12:30.
//
// Параметры:
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок с фактом ТО
//  Станок2     - СправочникСсылка.ПроизводственноеОборудование - другой станок
//  ТО          - ДокументСсылка.ОбслуживаниеСтанка - факт ТО
//  Понедельник - Дата - начало недели
//
Процедура ПроверитьПравилоПересечений(Станок, Станок2, ТО, Понедельник)

	// BSLLS:MagicNumber-off
	Обслуживание = Перечисления.ВидыЗагрузкиСтанков.Обслуживание;
	Работа = Перечисления.ВидыЗагрузкиСтанков.Работа;
	Пусто = Документы.ОбслуживаниеСтанка.ПустаяСсылка();
	Вторник = Понедельник + 86400;
	ВторникС = Вторник + 11 * 3600;
	ВторникПо = Вторник + 13 * 3600;
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, ВторникС, ВторникПо, Обслуживание, Ложь, Пусто).Количество();
	ПроверитьРавенство(1, Получено,
		"факт обслуживания с фактом обслуживания - конфликт");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, ВторникС, ВторникПо, Обслуживание, Ложь, ТО).Количество();
	ПроверитьРавенство(0, Получено,
		"свои записи регистратора не конфликтуют");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, ВторникС, ВторникПо, Работа, Ложь, Пусто).Количество();
	ПроверитьРавенство(0, Получено,
		"факт работы поверх факта обслуживания - не конфликт");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, ВторникС, ВторникПо, Обслуживание, Истина, Пусто).Количество();
	ПроверитьРавенство(0, Получено,
		"план поверх факта - не конфликт");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок2, ВторникС, ВторникПо, Обслуживание, Ложь, Пусто).Количество();
	ПроверитьРавенство(0, Получено,
		"другой станок - не конфликт");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, Вторник + 12.5 * 3600, ВторникПо, Обслуживание, Ложь, Пусто)
		.Количество();
	ПроверитьРавенство(0, Получено, "интервалы полуоткрытые: начало в момент окончания - не пересечение");

	// План с планом - конфликт при любом виде записи.
	Четверг = Понедельник + 3 * 86400;
	НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.Переналадка, Истина,
		Четверг + 10 * 3600, Четверг + 12 * 3600);
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, Четверг + 11 * 3600, Четверг + 13 * 3600, Работа,
		Истина, Пусто).Количество();
	ПроверитьРавенство(1, Получено, "план с планом другого вида - конфликт");

	// Авария фактом поверх идущей работы допустима (ревью плана P1-1): запись «Работа» готовит сборка 2, здесь
	// её изображает набор записей документа на станке второго сценария.
	Пятница = Понедельник + 4 * 86400;
	Работа2 = НовоеОбслуживание(Станок2, Перечисления.ВидыОбслуживанияСтанков.Прочее, Ложь,
		Пятница + 8 * 3600, Пятница + 16 * 3600);
	Набор = РегистрыСведений.ЗагрузкаСтанков.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Работа2.Ссылка);
	Набор.Прочитать();
	Набор[0].ВидЗаписи = Работа;
	Набор.Записать();
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок2, Пятница + 9 * 3600, Пятница + 10 * 3600,
		Обслуживание, Ложь, Пусто).Количество();
	ПроверитьРавенство(0, Получено, "авария фактом поверх факта работы - не конфликт");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок2, Пятница + 9 * 3600, Пятница + 10 * 3600,
		Работа, Ложь, Пусто).Количество();
	ПроверитьРавенство(1, Получено, "работа фактом поверх факта работы - конфликт");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Контрольный пример отчёта: факт ТО вторник 10:00-12:30 (в смене), ремонт в субботу 10:00-12:00 (вне смен);
// плановая переналадка четверга в отчёт без «Включать план» не идёт. Фонд недели - 56 часов.
//
// Параметры:
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок
//  Понедельник - Дата - начало недели
//  Неделя      - Дата - начало следующей недели
//
Процедура ПроверитьОтчетПростоев(Станок, Понедельник, Неделя)

	// BSLLS:MagicNumber-off
	Суббота = Понедельник + 5 * 86400;
	НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.Ремонт, Ложь, Суббота + 10 * 3600, Суббота + 12 * 3600);
	Период = Новый СтандартныйПериод(Понедельник, Неделя - 1);
	Данные = Отчеты.ПростоиСтанков.ДанныеОтчета(Период, Ложь);
	ПроверитьРавенство("", Данные.Предупреждение, "календарь 2099 года заполнен");

	Строка = СтрокаОтчетаПростоев(Данные.Простои, Станок);
	ПроверитьРавенство(4.5, Строка.Часы, "часы простоя станка");
	ПроверитьРавенство(2.5, Строка.ЧасыВРабочееВремя, "в рабочее время: ремонт вне смены не входит");
	ПроверитьРавенство(2, Строка.Случаев, "случаев простоя");
	ПроверитьРавенство(56, Строка.Фонд, "фонд времени станка");
	ПроверитьРавенство(4.5, Строка.ПроцентПростоя, "процент простоя в рабочее время");

	ДанныеСПланом = Отчеты.ПростоиСтанков.ДанныеОтчета(Период, Истина);
	ПроверитьРавенство(3, СтрокаОтчетаПростоев(ДанныеСПланом.Простои, Станок).Случаев, "с планом - и переналадка");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Строка группировки «Станок» отчёта «Простои станков»: схема компонуется в таблицу значений с внешним набором.
//
// Параметры:
//  Простои - ТаблицаЗначений - внешний набор, см. Отчеты.ПростоиСтанков.ДанныеОтчета
//  Станок  - СправочникСсылка.ПроизводственноеОборудование - отбор
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - Часы, ЧасыВРабочееВремя, Случаев, Фонд, ПроцентПростоя
//
Функция СтрокаОтчетаПростоев(Простои, Станок)

	Схема = Отчеты.ПростоиСтанков.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов",
		РасположениеИтоговКомпоновкиДанных.Нет);
	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Станок");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Станок;
	Отбор.Использование = Истина;
	Настройки.Структура.Очистить();
	Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Станок");
	ПолеГруппировки.Использование = Истина;
	Для Каждого ИмяПоля Из СтрРазделить("Часы,ЧасыВРабочееВремя,Случаев,Фонд,ПроцентПростоя", ",") Цикл
		Поле = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, Новый Структура("Простои", Простои));
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);

	ПроверитьРавенство(1, Результат.Количество(), "отчёт простоев вернул одну строку по станку");
	Возврат Результат[0];

КонецФункции

// Попытка провести фактический ремонт станка.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало    - Дата - начало
//  Окончание - Дата - окончание
//
// Возвращаемое значение:
//  Булево - Истина, если проведение отклонено
//
Функция ОтказОбслуживания(Станок, Начало, Окончание)

	ПолучитьСообщенияПользователю(Истина);
	Попытка
		НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.Ремонт, Ложь, Начало, Окончание);
	Исключение
		// После исключения в записи транзакция сценария годится только для отката: к базе больше не обращаемся.
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область ЭффективностьСтанков

// Учёт станков, волна 5 (2.0.16.36): плановые даты обслуживания и OEE. Контрольный пример сборки 4 (требование A
// вторник 08:00-16:00, ремонт 10:00-12:00) плюс плановое ТО 16:00-17:00, переведённое в факт 16:30-17:30 (плановые даты
// сохранились), и плановое ТО 14:00-15:00, которого не было - станок работал. Категории 08:00-18:00: фонд 10, работа 6,
// плановые остановки 1 (14-15 вычтено работой); отчёт за день: доступность 6 / (18 - 1), производительность 0,75 / 6,
// качество без веса продукции - полное с предупреждением, с весом 9 кг - 54 / 60. Последний шаг - настоящий отказ: перевод планового ТО в
// факт на время другого фактического обслуживания станка.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийЭффективностьСтанков(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 10 продукции x 2 сырья по 6 кг; станок 120 кг/ч, 15 мин на смену заказа, 8-20.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	Час = 3600;
	Вторник = НачалоНедели(Дата(2099, 3, 18)) + 86400;
	Среда = Вторник + 86400;
	Станки = Новый Массив;
	Станки.Добавить(Данные.Станок);
	Виды = Перечисления.ВидыОбслуживанияСтанков;

	ТребованиеА = НовоеТребованиеСценария(Контекст, Данные, 6);
	ТребованиеА.ПланНачало = Вторник + 8 * Час;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Разместить");
	ТребованиеА.ФактНачало = Вторник + 8 * Час;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Запустить");
	НовоеОбслуживание(Данные.Станок, Виды.Ремонт, Ложь, Вторник + 10 * Час, Вторник + 12 * Час);
	ТребованиеА.Материалы[0].Израсходовано = 10;
	ТребованиеА.КоличествоФакт = 6;
	ТребованиеА.ФактОкончание = Вторник + 16 * Час;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Завершить");

	// Плановое ТО 16-17 переводится в факт 16:30-17:30: плановые даты остаются.
	ТО = НовоеОбслуживание(Данные.Станок, Виды.ПлановоеТО, Истина, Вторник + 16 * Час, Вторник + 17 * Час);
	ПроверитьРавенство(Вторник + 16 * Час, ТО.ПланНачало, "плановое ТО - план начала следует за началом");
	ТО.Плановое = Ложь;
	ТО.Начало = Вторник + 16 * Час + 30 * 60;
	ТО.Окончание = Вторник + 17 * Час + 30 * 60;
	ТО.Записать(РежимЗаписиДокумента.Проведение);
	ТОВБазе = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТО.Ссылка, "ПланНачало, ПланОкончание, Плановое");
	Проверить(Не ТОВБазе.Плановое, "ТО переведено в факт");
	ПроверитьРавенство(Вторник + 16 * Час, ТОВБазе.ПланНачало, "после перевода в факт план начала сохранён");
	ПроверитьРавенство(Вторник + 17 * Час, ТОВБазе.ПланОкончание, "после перевода в факт план окончания сохранён");
	// Плановое ТО 14-15 не состоялось: станок работал - плановой остановки нет.
	НовоеОбслуживание(Данные.Станок, Виды.ПлановоеТО, Истина, Вторник + 14 * Час, Вторник + 15 * Час);

	Категории = ЗагрузкаСтанков.КатегорииВремени(Станки, Вторник + 8 * Час, Вторник + 18 * Час, Среда);
	Фонд = СтрокаКатегорий(Категории, Неопределено);
	ПроверитьРавенство(10, Фонд.Фонд, "фонд 08-18");
	ПроверитьРавенство(1, Фонд.ПлановыеОстановки, "плановые остановки: 16-17, а 14-15 вычтено работой");
	ПроверитьРавенство(6, СтрокаКатегорий(Категории, ТребованиеА.Ссылка).Работа, "работа - регресс сборки 4");
	ПроверитьРавенство(1, СтрокаКатегорий(Категории, ТО.Ссылка).Обслуживание, "фактическое ТО 16:30-17:30");
	ПроверитьРавенство(1, Фонд.НетЗаказа, "нет заказа: 10 - работа 6 - ремонт 2 - ТО 1");

	ПроверитьЭффективностьСтанков(Данные, Вторник, Среда);

	// MTBF и MTTR (2.0.16.37): второй ремонт 18-20 - отказ; ремонт, запланированный заранее и переведённый в факт, - нет.
	НовоеОбслуживание(Данные.Станок, Виды.Ремонт, Ложь, Вторник + 18 * Час, Вторник + 20 * Час);
	ПлановыйРемонт = НовоеОбслуживание(Данные.Станок, Виды.Ремонт, Истина, Вторник + 20 * Час, Вторник + 21 * Час);
	ПлановыйРемонт.Плановое = Ложь;
	ПлановыйРемонт.Записать(РежимЗаписиДокумента.Проведение);
	Простои = Отчеты.ПростоиСтанков.ДанныеОтчета(Новый СтандартныйПериод(Вторник, Вторник + 86399), Ложь, Среда);
	Строка = СтрокаОтчетаСтанков("ПростоиСтанков", "Простои", Простои.Простои, Данные.Станок,
		"Отказов,ЧасыОтказов,ЧасыРаботы,MTBF,MTTR");
	ПроверитьРавенство(2, Строка.Отказов, "отказы - два ремонта, плановый ремонт и ТО не отказы");
	ПроверитьРавенство(4, Строка.ЧасыОтказов, "ремонт после отказов 2 + 2 ч");
	ПроверитьРавенство(6, Строка.ЧасыРаботы, "наработка - работа дня");
	ПроверитьРавенство(3, Строка.MTBF, "MTBF: 6 ч / 2 отказа");
	ПроверитьРавенство(2, Строка.MTTR, "MTTR: 4 ч / 2 отказа");

	// Последний шаг - настоящий отказ: второе плановое ТО переводится в факт на время фактического ТО 16:30-17:30.
	ТО2 = НовоеОбслуживание(Данные.Станок, Виды.ПлановоеТО, Истина, Среда + 8 * Час, Среда + 9 * Час);
	ТО2.Плановое = Ложь;
	ТО2.Начало = Вторник + 17 * Час;
	ТО2.Окончание = Вторник + 18 * Час;
	ПолучитьСообщенияПользователю(Истина);
	Отказ = Ложь;
	Попытка
		ТО2.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		// После исключения в записи транзакция сценария годится только для отката: к базе больше не обращаемся.
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "перевод ТО в факт на время другого фактического обслуживания отклонён проведением");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("плановые даты обслуживания сохраняются при переводе в факт, плановые остановки без "
		+ "часов работы, доступность, производительность, качество без веса продукции и с весом, OEE компоновкой, MTBF и "
		+ "MTTR без запланированного ремонта, отказ перевода ТО в факт на занятое время");

КонецФункции

// «Эффективность станков» за вторник (период отчёта - целые дни): фонд по режиму 18 ч (смена 8-20 и хвост ночной смены
// понедельника), доступность 6 / (18 - 1), производительность 0,75 / 6, качество без веса продукции - полное с
// предупреждением, с весом 9 кг на штуку - 54 / 60.
//
// Параметры:
//  Данные  - Структура - см. ДанныеТребованияСценария
//  Вторник - Дата - день примера
//  Момент  - Дата - момент расчёта
//
Процедура ПроверитьЭффективностьСтанков(Данные, Вторник, Момент)

	// BSLLS:MagicNumber-off
	Период = Новый СтандартныйПериод(Вторник, Вторник + 86399);
	Поля = "Фонд,ПлановыеОстановки,Работа,Доступность,Производительность,Качество,OEE";
	Продукция = Данные.Заказ.ПолучитьОбъект().ТЧТовары.Найти(Данные.КодСтроки, "КодСтроки").Номенклатура;
	Отчет = Отчеты.ЭффективностьСтанков.ДанныеОтчета(Период, Момент);
	Проверить(СтрНайти(Отчет.Предупреждение, Строка(Продукция)) > 0, "продукция без веса - в предупреждении");
	Строка = СтрокаОтчетаСтанков("ЭффективностьСтанков", "Эффективность", Отчет.Эффективность, Данные.Станок, Поля);
	ПроверитьРавенство(18, Строка.Фонд, "фонд дня в отчёте");
	ПроверитьРавенство(1, Строка.ПлановыеОстановки, "плановые остановки в отчёте");
	ПроверитьРавенство(35.3, Строка.Доступность, "доступность 6 / 17");
	ПроверитьРавенство(12.5, Строка.Производительность, "производительность: норма 0,75 ч / 6 ч");
	ПроверитьРавенство(100, Строка.Качество, "качество без веса продукции - полное");
	ПроверитьРавенство(4.4, Строка.OEE, "OEE без веса продукции: 6/17 × 0,125");

	ПродукцияОбъект = Продукция.ПолучитьОбъект();
	ПродукцияОбъект.ВесЕдиница = Данные.Сырье.ВесЕдиница;
	ПродукцияОбъект.ВесЗнаменатель = 9;
	ПродукцияОбъект.Записать();
	Отчет = Отчеты.ЭффективностьСтанков.ДанныеОтчета(Период, Момент);
	Проверить(СтрНайти(Отчет.Предупреждение, Строка(Продукция)) = 0, "продукция с весом - не в предупреждении");
	Строка = СтрокаОтчетаСтанков("ЭффективностьСтанков", "Эффективность", Отчет.Эффективность, Данные.Станок, Поля);
	ПроверитьРавенство(90, Строка.Качество, "качество: 6 × 9 кг / 60 кг");
	ПроверитьРавенство(4, Строка.OEE, "OEE: 6/17 × 0,125 × 0,9");
	// BSLLS:MagicNumber-on

КонецПроцедуры

#КонецОбласти

#Область АвтопланСтанков

// Учёт станков, волна 5 (2.0.16.38): автоплан. Два станка (у первого плановое ТО 8-10), два заказа: B (5 шт., 0,75 ч)
// отгружается раньше A (10 шт., 1,25 ч). Список станков - оба: B и A - на второй станок подряд (черновик мешает сам себе),
// со списком «только первый» - на первый после ТО, подряд; выведенный станок из списка - ошибка строки, а не «любой».
// Устаревший черновик не принимается; принятый создаёт требования с окнами черновика, строки уходят из «Готовых».
// Последний шаг - отказ: время строки черновика заняли плановым ТО до «Принять».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАвтопланСтанков(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 10 продукции x 2 сырья по 6 кг; станки 120 кг/ч, 15 мин на смену заказа, 8-20.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	Станок2 = ВторойСтанокСценария();
	Понедельник = НачалоНедели(Дата(2099, 1, 7));
	Час = 3600;
	Минута = 60;
	Момент = Понедельник + 7 * Час;
	Склад = Контекст.Склад;
	НовоеОбслуживание(Данные.Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Понедельник + 8 * Час,
		Понедельник + 10 * Час);
	ЗаказА = Данные.Заказ.ПолучитьОбъект();
	ЗаказА.ДатаОтгрузки = Понедельник + 3 * 86400;
	Провести(ЗаказА);
	ЗаказБ = ЗаказНаПроизводствоСтадии(Контекст, 5);
	ЗаказБ.ДатаОтгрузки = Понедельник + 86400;
	Провести(ЗаказБ);
	Заказы = Новый Массив;
	Заказы.Добавить(ЗаказА.Ссылка);
	Заказы.Добавить(ЗаказБ.Ссылка);

	// Список - оба станка сценария (в базе могут быть другие свободные станки): B раньше по отгрузке - на второй станок с
	// 8:00, A - туда же после B (окончание 10:00 раньше 11:15 на первом станке после ТО).
	Продукция = Контекст.Продукция.ПолучитьОбъект();
	Продукция.Станки.Очистить();
	Продукция.Станки.Добавить().Станок = Данные.Станок;
	Продукция.Станки.Добавить().Станок = Станок2;
	Продукция.Записать();
	Предложение = ЗагрузкаСтанков.ПредложениеАвтоплана(Момент, Склад, Заказы);
	ПроверитьРавенство(2, Предложение.Количество(), "в черновике две строки");
	ПроверитьСтрокуАвтоплана(Предложение, 0, ЗаказБ.Ссылка, Станок2, Понедельник + 8 * Час, Понедельник + 8 * Час + 45 * Минута);
	ПроверитьСтрокуАвтоплана(Предложение, 1, ЗаказА.Ссылка, Станок2, Понедельник + 8 * Час + 45 * Минута,
		Понедельник + 10 * Час);

	// Список станков продукции - только первый: оба после ТО, подряд.
	Продукция.Станки.Очистить();
	Продукция.Станки.Добавить().Станок = Данные.Станок;
	Продукция.Записать();
	Предложение = ЗагрузкаСтанков.ПредложениеАвтоплана(Момент, Склад, Заказы);
	ПроверитьСтрокуАвтоплана(Предложение, 0, ЗаказБ.Ссылка, Данные.Станок, Понедельник + 10 * Час,
		Понедельник + 10 * Час + 45 * Минута);
	ПроверитьСтрокуАвтоплана(Предложение, 1, ЗаказА.Ссылка, Данные.Станок, Понедельник + 10 * Час + 45 * Минута,
		Понедельник + 12 * Час);

	// Станок списка выведен - строки с ошибкой, а не на любой станок.
	СтанокОбъект = Данные.Станок.ПолучитьОбъект();
	СтанокОбъект.Выведен = Истина;
	СтанокОбъект.Записать();
	СВыведенным = ЗагрузкаСтанков.ПредложениеАвтоплана(Момент, Склад, Заказы);
	Проверить(ЗначениеЗаполнено(СВыведенным[0].ТекстОшибки), "станок списка выведен - ошибка строки");
	Проверить(Не ЗначениеЗаполнено(СВыведенным[0].Станок), "станок списка выведен - на другой станок не ставится");
	СтанокОбъект.Выведен = Ложь;
	СтанокОбъект.Записать();

	// Устаревший черновик не принимается: уже через минуту шаг планирования другой (ревью кода, P1-1).
	Итог = ЗагрузкаСтанков.ПринятьАвтоплан(Предложение, Момент + Минута, Склад);
	ПроверитьРавенство(0, Итог.Размещено, "устаревший черновик ничего не размещает");
	ПроверитьРавенство(1, Итог.Ошибки.Количество(), "устаревший черновик - одна ошибка");

	// Окно под блокировками не совпало с черновиком по окончанию (выработку изменили после расчёта) - строка не
	// размещается (2.0.16.57, ревью Codex волны 5, P2).
	Измененное = Предложение.Скопировать();
	Измененное.Удалить(1);
	Измененное[0].Окончание = Измененное[0].Окончание + 15 * Минута;
	Итог = ЗагрузкаСтанков.ПринятьАвтоплан(Измененное, Момент, Склад);
	ПроверитьРавенство(0, Итог.Размещено, "окно не совпало с черновиком - не размещено");
	ПроверитьРавенство(1, Итог.Ошибки.Количество(), "окно не совпало с черновиком - текст ошибки");
	Измененное = Предложение.Скопировать();
	Измененное.Удалить(1);
	Измененное[0].Начало = Измененное[0].Начало + 15 * Минута;
	Итог = ЗагрузкаСтанков.ПринятьАвтоплан(Измененное, Момент, Склад);
	ПроверитьРавенство(0, Итог.Размещено, "начало окна не совпало с черновиком - не размещено");

	// Принять: требования с окнами черновика, строки ушли из «Готовых».
	Итог = ЗагрузкаСтанков.ПринятьАвтоплан(Предложение, Момент, Склад);
	ПроверитьРавенство(2, Итог.Размещено, "принято две строки: " + СтрСоединить(Итог.Ошибки, "; "));
	ТребованиеА = ТребованиеЗаказаСценария(ЗаказА.Ссылка);
	Проверить(ТребованиеА <> Неопределено, "по заказу A создано требование");
	Если ТребованиеА <> Неопределено Тогда
		ПроверитьРавенство(Данные.Станок, ТребованиеА.Станок, "станок требования - из черновика");
		ПроверитьРавенство(Понедельник + 10 * Час + 45 * Минута, ТребованиеА.ПланНачало, "начало - из черновика");
		ПроверитьРавенство(Понедельник + 12 * Час, ТребованиеА.ПланОкончание, "окончание совпало с черновиком");
	КонецЕсли;
	ПроверитьРавенство(0, ЗагрузкаСтанков.ПредложениеАвтоплана(Момент, Склад, Заказы).Количество(),
		"размещённые строки ушли из черновика, запланированное не трогается");

	// Последний шаг - отказ: время строки черновика заняли плановым ТО до «Принять».
	ЗаказВ = ЗаказНаПроизводствоСтадии(Контекст, 5);
	ЗаказВ.ДатаОтгрузки = Понедельник + 86400;
	Провести(ЗаказВ);
	ТолькоВ = Новый Массив;
	ТолькоВ.Добавить(ЗаказВ.Ссылка);
	Предложение = ЗагрузкаСтанков.ПредложениеАвтоплана(Момент, Склад, ТолькоВ);
	ПроверитьСтрокуАвтоплана(Предложение, 0, ЗаказВ.Ссылка, Данные.Станок, Понедельник + 12 * Час,
		Понедельник + 12 * Час + 45 * Минута);
	НовоеОбслуживание(Данные.Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Понедельник + 12 * Час,
		Понедельник + 13 * Час);
	Итог = ЗагрузкаСтанков.ПринятьАвтоплан(Предложение, Момент, Склад);
	ПроверитьРавенство(0, Итог.Размещено, "занятое время строки - не размещено");
	ПроверитьРавенство(1, Итог.Ошибки.Количество(), "занятое время строки - текст ошибки");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("черновик по отгрузке на станок с ранним окончанием, строки черновика не пересекаются, "
		+ "список станков продукции, выведенный станок - ошибка строки, устаревший черновик, принятие с окнами черновика, "
		+ "запланированное не трогается, отказ строки на занятом времени");

КонецФункции

// Строка черновика автоплана: заказ, станок и окно.
//
// Параметры:
//  Предложение - ТаблицаЗначений - см. ЗагрузкаСтанков.ПредложениеАвтоплана
//  Индекс      - Число - номер строки
//  Заказ       - ДокументСсылка.ЗаказПокупателя - ожидаемый заказ
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - ожидаемый станок
//  Начало      - Дата - ожидаемое начало
//  Окончание   - Дата - ожидаемое окончание
//
Процедура ПроверитьСтрокуАвтоплана(Предложение, Индекс, Заказ, Станок, Начало, Окончание)

	Если Предложение.Количество() <= Индекс Тогда
		Проверить(Ложь, СтрШаблон("в черновике нет строки %1", Индекс + 1));
		Возврат;
	КонецЕсли;
	Строка = Предложение[Индекс];
	Описание = СтрШаблон("строка %1 черновика: ", Индекс + 1);
	ПроверитьРавенство("", Строка.ТекстОшибки, Описание + "без ошибки");
	ПроверитьРавенство(Заказ, Строка.Заказ, Описание + "заказ по дате отгрузки");
	ПроверитьРавенство(Станок, Строка.Станок, Описание + "станок");
	ПроверитьРавенство(Начало, Строка.Начало, Описание + "начало");
	ПроверитьРавенство(Окончание, Строка.Окончание, Описание + "окончание");

КонецПроцедуры

// Проведённое требование по заказу сценария.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ
//
// Возвращаемое значение:
//  ДокументОбъект.ТребованиеНакладная, Неопределено - требование
//
Функция ТребованиеЗаказаСценария(Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Требования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Заказ = &Заказ
	|	И Требования.Проведен";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка.ПолучитьОбъект(), Неопределено);

КонецФункции

#КонецОбласти

#Область АналитикаЗагрузкиСтанков

// Аналитика загрузки для планирования (docs/plans/machines-analytics.md, сборка 2.0.16.52). Станок сценария: Пн-Пт 8-20 и
// ночь Пн 22-06 - фонд недели 68 ч. Плановое ТО Пн 8-10 и 10 шт. заказа A (1,25 ч) с 10:00: фонд, занятость, свободное
// время, окно и дни двух недель, период 31 день; ТО до субботы второй недели - узкое место без окна. Риски: заказ A
// с отгрузкой накануне - «Запланировано»; заказ C - опаздывает по черновику автоплана, дефицит на его дату; запущенная
// и затянувшаяся работа - по продлённому окончанию; сорванный старт незапущенной работы - по рабочему времени от
// момента и в потребности дефицита; выведенный станок - риск с причиной и без мощности. Отчёт «План загрузки станков»:
// данные и компоновка варианта «По дням».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАналитикаЗагрузкиСтанков(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 10 продукции x 2 сырья по 6 кг; станки 120 кг/ч, 15 мин на смену заказа.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	ДокументЗакупки(Контекст, Контекст.Сырье, 40, 12);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	Данные.Вставить("Склад", Контекст.Склад);
	Понедельник = НачалоНедели(Дата(2099, 1, 7));
	Сутки = 86400;
	Час = 3600;
	Момент = Понедельник + 7 * Час;
	Станки = Новый Массив;
	Станки.Добавить(Данные.Станок);
	Продукция = Контекст.Продукция.ПолучитьОбъект();
	Продукция.Станки.Очистить();
	Продукция.Станки.Добавить().Станок = Данные.Станок;
	Продукция.Записать();

	НовоеОбслуживание(Данные.Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Понедельник + 8 * Час,
		Понедельник + 10 * Час);
	ЗаказА = Данные.Заказ.ПолучитьОбъект();
	ЗаказА.ДатаОтгрузки = Понедельник - Сутки;
	Провести(ЗаказА);
	ТребованиеА = РазместитьСтрокуСценария(Данные, 10, Данные.Станок, Неопределено, Момент);
	ПроверитьРавенство(Понедельник + 10 * Час + 15 * 60 + Час, ТребованиеА.ПланОкончание, "заказ A: 10:00-11:15");

	ПроверитьАналитикуДвухНедель(Станки, Понедельник, Момент);
	НовоеОбслуживание(Данные.Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Понедельник + 12 * Час,
		Понедельник + 12 * Сутки);
	Аналитика = ЗагрузкаСтанков.АналитикаЗагрузки(Станки, Понедельник, Понедельник + 14 * Сутки, 4, Момент);
	Строка = Аналитика.Станки[0];
	ПроверитьРавенство(135.25, Строка.Занято, "ТО до субботы второй недели: свободно 0,75 ч в понедельник");
	ПроверитьРавенство(99, Строка.Процент, "занято 99 %");
	Проверить(Строка.УзкоеМесто, "узкое место");
	Проверить(Не ЗначениеЗаполнено(Строка.ОкноС), "окна на 4 ч в двух неделях нет");

	ЗаказС = ЗаказНаПроизводствоСтадии(Контекст, 10);
	ЗаказС.ДатаОтгрузки = Понедельник + Сутки;
	Провести(ЗаказС);
	ПроверитьРискиЗаказов(Данные, ТребованиеА.Ссылка, ЗаказС.Ссылка, Понедельник, Момент);
	ПроверитьРискиЗапущенной(Данные, ТребованиеА, Понедельник);
	ПроверитьОтчетПланаЗагрузки(Данные, ЗаказС.Ссылка, Понедельник, Момент);
	ПроверитьСорванныйСтарт(Контекст, Понедельник);
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("фонд, занятость, свободное время, окно и дни двух недель и 31 дня, узкое место; риски "
		+ "запланированной работы, очереди по черновику автоплана, затянувшейся и незапущенной работы, выведенный станок, "
		+ "дефицит мощности; отчёт «План загрузки станков»");

КонецФункции

// Аналитика двух недель: ТО Пн 8-10 и работа 10:00-11:15 (момент - Пн 07:00), периоды 7 и 31 день.
//
// Параметры:
//  Станки      - Массив из СправочникСсылка.ПроизводственноеОборудование - станок сценария
//  Понедельник - Дата - начало недели сценария
//  Момент      - Дата - момент расчёта
//
Процедура ПроверитьАналитикуДвухНедель(Станки, Понедельник, Момент)

	// BSLLS:MagicNumber-off
	Сутки = 86400;
	Аналитика = ЗагрузкаСтанков.АналитикаЗагрузки(Станки, Понедельник, Понедельник + 14 * Сутки, 4, Момент);
	Строка = Аналитика.Станки[0];
	ПроверитьРавенство(136, Строка.Фонд, "фонд двух недель");
	ПроверитьРавенство(1.25, Строка.Работа, "работа");
	ПроверитьРавенство(2, Строка.Обслуживание, "обслуживание");
	ПроверитьРавенство(3.25, Строка.Занято, "занято - работа и ТО без двойного счёта");
	ПроверитьРавенство(132.75, Строка.Свободно, "свободно от момента");
	ПроверитьРавенство(2, Строка.Процент, "занято, %");
	ПроверитьРавенство(Понедельник + 11 * 3600 + 15 * 60, Строка.ОкноС, "окно на 4 ч - после работы");
	Проверить(Не Строка.УзкоеМесто, "не узкое место");
	ПроверитьРавенство(14, Аналитика.Дни.Количество(), "две недели - 14 дней");
	ПроверитьРавенство(136, Аналитика.Дни.Итог("Фонд"), "сумма фондов дней = фонд периода");
	ПроверитьРавенство(14, Аналитика.Дни[0].Фонд, "понедельник: 8-20 и 22-24");
	ПроверитьРавенство(23, Аналитика.Дни[0].Процент, "понедельник занят на 23 %");
	ПроверитьРавенство(18, Аналитика.Дни[1].Фонд, "вторник: хвост ночной смены и 8-20");
	ПроверитьРавенство(0, Аналитика.Дни[5].Фонд, "суббота - выходной");
	Для Каждого Дней Из СтрРазделить("7,31", ",") Цикл
		Аналитика = ЗагрузкаСтанков.АналитикаЗагрузки(Станки, Понедельник, Понедельник + Число(Дней) * Сутки, 4, Момент);
		ПроверитьРавенство(Число(Дней), Аналитика.Дни.Количество(), "дней в периоде " + Дней);
		ПроверитьРавенство(Аналитика.Станки[0].Фонд, Аналитика.Дни.Итог("Фонд"), "сумма фондов дней, период " + Дней);
	КонецЦикла;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Риски: A (отгрузка накануне) - запланированная работа, C - очередь по черновику автоплана, дефицит на дату C.
//
// Параметры:
//  Данные      - Структура - см. ДанныеТребованияСценария
//  ТребованиеА - ДокументСсылка.ТребованиеНакладная - работа заказа A
//  ЗаказС      - ДокументСсылка.ЗаказПокупателя - заказ C
//  Понедельник - Дата - начало недели сценария
//  Момент      - Дата - момент расчёта
//
Процедура ПроверитьРискиЗаказов(Данные, ТребованиеА, ЗаказС, Понедельник, Момент)

	// BSLLS:MagicNumber-off
	Станки = Новый Массив;
	Станки.Добавить(Данные.Станок);
	Заказы = Новый Массив;
	Заказы.Добавить(Данные.Заказ);
	Заказы.Добавить(ЗаказС);
	Риски = ЗагрузкаСтанков.РискиСрыва(Станки, Момент, Данные.Склад, Заказы);
	СтрокиА = Риски.Заказы.НайтиСтроки(Новый Структура("Документ", ТребованиеА));
	ПроверитьРавенство(1, СтрокиА.Количество(), "работа заказа A под риском");
	Если СтрокиА.Количество() = 1 Тогда
		ПроверитьРавенство(1, СтрокиА[0].ОпозданиеДней, "заказ A опаздывает на день");
	КонецЕсли;
	СтрокиС = Риски.Заказы.НайтиСтроки(Новый Структура("Заказ", ЗаказС));
	ПроверитьРавенство(1, СтрокиС.Количество(), "заказ C - в очереди под риском");
	Если СтрокиС.Количество() = 1 Тогда
		ПроверитьРавенство(Понедельник + 14 * 86400 + 9 * 3600 + 15 * 60, СтрокиС[0].Окончание,
			"заказ C по черновику - в понедельник третьей недели после ТО");
	КонецЕсли;
	ПроверитьРавенство(1, Риски.Дефицит.Количество(), "дефицит - одна дата отгрузки");
	Если Риски.Дефицит.Количество() = 1 Тогда
		ПроверитьРавенство(1.25, Риски.Дефицит[0].Потребность, "потребность на вторник - заказ C");
		ПроверитьРавенство(0.75, Риски.Дефицит[0].Мощность, "мощность до вторника - окно 11:15-12:00");
		ПроверитьРавенство(0.5, Риски.Дефицит[0].Дефицит, "дефицит на вторник");
	КонецЕсли;
	СЧерновиком = ЗагрузкаСтанков.РискиСрыва(Станки, Момент, Данные.Склад, Заказы, Риски.Предложение);
	ПроверитьРавенство(Риски.Заказы.Количество(), СЧерновиком.Заказы.Количество(),
		"с готовым черновиком - те же риски без второго расчёта");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Запущенная работа A с отгрузкой в понедельник: в полдень понедельника продлена до 12:15 - вовремя, во вторник в 10:00
// ещё идёт - под риском, хотя по расчёту закончилась в 11:15.
//
// Параметры:
//  Данные      - Структура - см. ДанныеТребованияСценария
//  ТребованиеА - ДокументОбъект.ТребованиеНакладная - работа заказа A
//  Понедельник - Дата - начало недели сценария
//
Процедура ПроверитьРискиЗапущенной(Данные, ТребованиеА, Понедельник)

	// BSLLS:MagicNumber-off
	Час = 3600;
	ЗаказА = Данные.Заказ.ПолучитьОбъект();
	ЗаказА.ДатаОтгрузки = Понедельник;
	Провести(ЗаказА);
	Требование = ТребованиеА.Ссылка.ПолучитьОбъект();
	Требование.ФактНачало = Понедельник + 10 * Час;
	ТребованияНакладные.ВыполнитьДействие(Требование, "Запустить");
	Станки = Новый Массив;
	Станки.Добавить(Данные.Станок);
	Заказы = Новый Массив;
	Заказы.Добавить(Данные.Заказ);
	Отбор = Новый Структура("Документ", Требование.Ссылка);
	Риски = ЗагрузкаСтанков.РискиСрыва(Станки, Понедельник + 12 * Час, Данные.Склад, Заказы);
	ПроверитьРавенство(0, Риски.Заказы.НайтиСтроки(Отбор).Количество(), "затянувшаяся в день отгрузки - вовремя");
	Риски = ЗагрузкаСтанков.РискиСрыва(Станки, Понедельник + 34 * Час, Данные.Склад, Заказы);
	Строки = Риски.Заказы.НайтиСтроки(Отбор);
	ПроверитьРавенство(1, Строки.Количество(), "затянувшаяся после дня отгрузки - под риском");
	Если Строки.Количество() = 1 Тогда
		ПроверитьРавенство(1, Строки[0].ОпозданиеДней, "опоздание по продлённому окончанию");
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Отчёт «План загрузки станков»: вариант «По дням» - фонд станка за две недели, вариант «Заказы под риском» строится;
// риски по всем станкам (как в отчёте и на закладке) - заказ C. Склад черновика в отчёте - склад пользователя, в
// сценарии материалы на складе контекста: заказ C проверяется вызовом с этим складом.
//
// Параметры:
//  Данные      - Структура - см. ДанныеТребованияСценария, со складом Склад
//  ЗаказС      - ДокументСсылка.ЗаказПокупателя - заказ под риском
//  Понедельник - Дата - начало недели сценария
//  Момент      - Дата - момент расчёта
//
Процедура ПроверитьОтчетПланаЗагрузки(Данные, ЗаказС, Понедельник, Момент)

	// BSLLS:MagicNumber-off
	Станок = Данные.Станок;
	Склад = Данные.Склад;
	Период = Новый СтандартныйПериод(Понедельник, Понедельник + 14 * 86400 - 1);
	ДанныеОтчета = Отчеты.ПланЗагрузкиСтанков.ДанныеОтчета(Период, Момент, "Дни");
	ПроверитьРавенство(14, ДанныеОтчета.Дни.НайтиСтроки(Новый Структура("Станок", Станок)).Количество(),
		"отчёт по дням: 14 строк станка");
	Строка = СтрокаОтчетаСтанков("ПланЗагрузкиСтанков", "Дни", ДанныеОтчета.Дни, Станок, "Фонд",
		Новый Структура("Риски", ДанныеОтчета.Риски));
	ПроверитьРавенство(136, Строка.Фонд, "компоновка «По дням»: фонд станка");
	ДанныеОтчета = Отчеты.ПланЗагрузкиСтанков.ДанныеОтчета(Неопределено, Момент, "Риски");
	Проверить(ТипЗнч(ДанныеОтчета.Риски) = Тип("ТаблицаЗначений"), "отчёт «Заказы под риском» строится");
	Заказы = Новый Массив;
	Заказы.Добавить(ЗаказС);
	Риски = ЗагрузкаСтанков.РискиСрыва(Неопределено, Момент, Склад, Заказы);
	Проверить(Риски.Заказы.НайтиСтроки(Новый Структура("Заказ", ЗаказС)).Количество() > 0,
		"риски по всем станкам: заказ C");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Сорванный старт: заказ E (5 шт., 0,75 ч) запланирован на второй станок в понедельник 10:00 и не запущен. Во вторник
// в 07:00 он закончится не раньше 08:45 (рабочее время от момента): отгрузка в понедельник - риск и дефицит без
// мощности, во вторник - вовремя. Станок выведен - риск с причиной, мощности нет.
//
// Параметры:
//  Контекст    - Структура - см. НовыйКонтекст
//  Понедельник - Дата - начало недели сценария
//
Процедура ПроверитьСорванныйСтарт(Контекст, Понедельник)

	// BSLLS:MagicNumber-off
	Час = 3600;
	Станок2 = ВторойСтанокСценария();
	Продукция = Контекст.Продукция.ПолучитьОбъект();
	Продукция.Станки.Добавить().Станок = Станок2;
	Продукция.Записать();
	ЗаказЕ = ЗаказНаПроизводствоСтадии(Контекст, 5);
	ЗаказЕ.ДатаОтгрузки = Понедельник;
	Провести(ЗаказЕ);
	ДанныеЕ = Новый Структура("Заказ, КодСтроки, Склад", ЗаказЕ.Ссылка, ЗаказЕ.ТЧТовары[1].КодСтроки, Контекст.Склад);
	ТребованиеЕ = РазместитьСтрокуСценария(ДанныеЕ, 5, Станок2, Понедельник + 10 * Час, Понедельник + 7 * Час);
	Станки = Новый Массив;
	Станки.Добавить(Станок2);
	Заказы = Новый Массив;
	Заказы.Добавить(ЗаказЕ.Ссылка);
	Момент = Понедельник + 31 * Час;
	Отбор = Новый Структура("Документ", ТребованиеЕ.Ссылка);

	Риски = ЗагрузкаСтанков.РискиСрыва(Станки, Момент, Контекст.Склад, Заказы);
	Строки = Риски.Заказы.НайтиСтроки(Отбор);
	ПроверитьРавенство(1, Строки.Количество(), "сорванный старт с отгрузкой в понедельник - под риском, одной строкой");
	Если Строки.Количество() = 1 Тогда
		Проверить(Строки[0].НеЗапущено, "строка незапущенной работы");
		ПроверитьРавенство(Понедельник + 32 * Час + 45 * 60, Строки[0].Окончание, "окончание по рабочему времени от момента");
	КонецЕсли;
	ПроверитьРавенство(1, Риски.Дефицит.Количество(), "дефицит - дата отгрузки E");
	Если Риски.Дефицит.Количество() = 1 Тогда
		ПроверитьРавенство(0.75, Риски.Дефицит[0].Потребность, "потребность - длительность незапущенной работы");
		ПроверитьРавенство(0.75, Риски.Дефицит[0].Дефицит, "отгрузка прошла - мощности нет");
	КонецЕсли;

	ЗаказЕ = ЗаказЕ.Ссылка.ПолучитьОбъект();
	ЗаказЕ.ДатаОтгрузки = Понедельник + 86400;
	Провести(ЗаказЕ);
	Риски = ЗагрузкаСтанков.РискиСрыва(Станки, Момент, Контекст.Склад, Заказы);
	ПроверитьРавенство(0, Риски.Заказы.НайтиСтроки(Отбор).Количество(), "отгрузка во вторник - успевает");
	Если Риски.Дефицит.Количество() = 1 Тогда
		ПроверитьРавенство(0, Риски.Дефицит[0].Дефицит, "во вторник мощности хватает");
	КонецЕсли;

	СтанокОбъект = Станок2.ПолучитьОбъект();
	СтанокОбъект.Выведен = Истина;
	СтанокОбъект.Записать();
	Риски = ЗагрузкаСтанков.РискиСрыва(Станки, Момент, Контекст.Склад, Заказы);
	Строки = Риски.Заказы.НайтиСтроки(Отбор);
	ПроверитьРавенство(1, Строки.Количество(), "работа на выведенном станке - под риском");
	Если Строки.Количество() = 1 Тогда
		Проверить(ЗначениеЗаполнено(Строки[0].ТекстОшибки), "причина - станок выведен");
		Проверить(Не ЗначениеЗаполнено(Строки[0].Окончание), "окончание на выведенном станке не считается");
	КонецЕсли;
	Если Риски.Дефицит.Количество() = 1 Тогда
		ПроверитьРавенство(0, Риски.Дефицит[0].Мощность, "выведенный станок мощности не даёт");
	КонецЕсли;
	СтанокОбъект.Выведен = Ложь;
	СтанокОбъект.Записать();
	// BSLLS:MagicNumber-on

КонецПроцедуры

#КонецОбласти

#Область РастяжениеСтанков

// Учёт станков, волна 5 (2.0.16.39): растяжение на планировщике меняет только время. Требование 4 шт. (48 кг, 0,65 ч)
// с 8:00 растянуто до 9:39 - конец вверх до шага 9:45, ручная длительность 1,75 ч, количество прежнее; перенос той же
// длины сохраняет её; растяжение через конец смены - только рабочие часы; обслуживание растягивается; очистка ручной
// длительности возвращает расчёт по весу; перенос на другой станок её сбрасывает. Последний шаг - настоящий отказ:
// растяжение на время другого плана станка.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийРастяжениеСтанков(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 10 продукции x 2 сырья по 6 кг; станки 120 кг/ч, 15 мин на смену заказа, 8-20.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	Станок2 = ВторойСтанокСценария();
	Понедельник = НачалоНедели(Дата(2099, 1, 7));
	Вторник = Понедельник + 86400;
	Среда = Вторник + 86400;
	Час = 3600;
	Минута = 60;
	Момент = Понедельник + 7 * Час;
	Данные.Вставить("Склад", Контекст.Склад);

	Требование = РазместитьСтрокуСценария(Данные, 4, Данные.Станок, Неопределено, Момент);
	ПроверитьРавенство(Понедельник + 8 * Час + 39 * Минута, Требование.ПланОкончание, "до растяжения: 0,65 ч");

	// Растяжение вправо на час: 9:39 - вверх до шага 9:45.
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Данные.Станок, Понедельник + 8 * Час,
		Понедельник + 9 * Час + 39 * Минута, Момент);
	ПроверитьРавенство("", ТекстОшибки, "растяжение без ошибки");
	Требование = Требование.Ссылка.ПолучитьОбъект();
	ПроверитьРавенство(1.75, Требование.ДлительностьВручную, "ручная длительность - рабочие часы 8:00-9:45");
	ПроверитьРавенство(1.75, Требование.Длительность, "длительность - ручная");
	ПроверитьРавенство(Понедельник + 9 * Час + 45 * Минута, Требование.ПланОкончание, "окончание после растяжения");
	ПроверитьРавенство(4, Требование.Количество, "растяжение не меняет количество");

	// Перенос той же длины - перенос, а не растяжение: ручная длительность сохраняется.
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Данные.Станок, Понедельник + 10 * Час,
		Понедельник + 11 * Час + 45 * Минута, Момент);
	ПроверитьРавенство("", ТекстОшибки, "перенос растянутой загрузки");
	Требование = Требование.Ссылка.ПолучитьОбъект();
	ПроверитьРавенство(Понедельник + 10 * Час, Требование.ПланНачало, "перенос: новое начало");
	ПроверитьРавенство(1.75, Требование.ДлительностьВручную, "перенос сохраняет ручную длительность");

	// Растяжение через конец смены 20:00: в длительность идут только рабочие часы, окончание - конец смены.
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Данные.Станок, Понедельник + 19 * Час,
		Понедельник + 21 * Час, Момент);
	ПроверитьРавенство("", ТекстОшибки, "растяжение через конец смены");
	Требование = Требование.Ссылка.ПолучитьОбъект();
	ПроверитьРавенство(1, Требование.ДлительностьВручную, "через конец смены - только рабочий час");
	ПроверитьРавенство(Понедельник + 20 * Час, Требование.ПланОкончание, "окончание - конец смены");

	// Плановое обслуживание растягивается: новое окончание.
	ТО = НовоеОбслуживание(Данные.Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Вторник + 8 * Час,
		Вторник + 9 * Час);
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(ТО.Ссылка, Данные.Станок, Вторник + 8 * Час, Вторник + 10 * Час, Момент);
	ПроверитьРавенство("", ТекстОшибки, "растяжение планового ТО");
	ПроверитьРавенство(Вторник + 10 * Час, ТО.Ссылка.Окончание, "окончание ТО после растяжения");

	// Очистка ручной длительности - снова по весу.
	Требование.ДлительностьВручную = 0;
	ТребованияНакладные.ВыполнитьДействие(Требование, "Разместить");
	ПроверитьРавенство(0.65, Требование.Ссылка.Длительность, "без ручной длительности - по весу");

	// Ручная длительность сбрасывается переносом на другой станок.
	ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Данные.Станок, Вторник + 12 * Час, Вторник + 14 * Час, Момент);
	ПроверитьРавенство(2, Требование.Ссылка.ДлительностьВручную, "растянуто до 2 ч");
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Станок2, Среда + 12 * Час, Среда + 14 * Час, Момент);
	ПроверитьРавенство("", ТекстОшибки, "перенос на другой станок");
	ПроверитьРавенство(0, Требование.Ссылка.ДлительностьВручную, "на другом станке ручная длительность сброшена");
	ПроверитьРавенство(0.65, Требование.Ссылка.Длительность, "на другом станке - по весу");

	// Последний шаг - настоящий отказ: растяжение на время другого плана станка (план с планом).
	Второе = РазместитьСтрокуСценария(Данные, 2, Станок2, Среда + 14 * Час, Момент);
	ПроверитьРавенство(Среда + 14 * Час, Второе.ПланНачало, "второе требование - после первого");
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Станок2, Среда + 12 * Час, Среда + 15 * Час, Момент);
	Проверить(ЗначениеЗаполнено(ТекстОшибки), "растяжение на другой план станка отклонено проведением");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("растяжение меняет только время с шагом 15 минут, перенос той же длины сохраняет ручную "
		+ "длительность, через конец смены - рабочие часы, растяжение ТО, очистка - снова по весу, сброс на другом станке, "
		+ "отказ растяжения на другой план");

КонецФункции

#КонецОбласти

#Область ПростоиСтанковПланИФакт

// Учёт станков, волна 6 (2.0.16.55), отчёт «Простои станков». Станок Пн-Пт 08:00-20:00 (и ночь понедельника), 2099 год.
// Вторник: факт ТО 10:00-12:00 и план ТО 11:00-13:00 - с «Включать план» план идёт только вне факта (12:00-13:00); факт
// 15:00-17:00 и план 15:30-16:30 внутри него - план не считается. Ремонт со среды 23:00 до четверга 01:00 в отчёте по
// среду - в периоде 1 час, MTTR - полные 2 часа. Выведенный станок без обслуживания, но с работой в периоде - в отчёте со
// строкой фонда; с запущенным требованием, расчётное окончание которого раньше периода, - тоже, с наработкой. Отбор
// по виду обслуживания применяется к строкам обслуживания и не убирает фонд, вариант «Основной» компонуется. Последний
// шаг - настоящий отказ: программное проведение обслуживания с окончанием, равным началу.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПростоиСтанковПланИФакт(Контекст)

	// BSLLS:MagicNumber-off - часы интервалов сценария.
	Константы.ИспользоватьУчетСтанков.Установить(Истина);
	Понедельник = НачалоНедели(Дата(2099, 1, 7));
	Вторник = Понедельник + 86400;
	Среда = Вторник + 86400;
	Час = 3600;
	ТО = Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО;
	Станок = НовыйСтанокСценария("простои");
	НовоеОбслуживание(Станок, ТО, Ложь, Вторник + 10 * Час, Вторник + 12 * Час);
	НовоеОбслуживание(Станок, ТО, Истина, Вторник + 11 * Час, Вторник + 13 * Час);
	НовоеОбслуживание(Станок, ТО, Ложь, Вторник + 15 * Час, Вторник + 17 * Час);
	НовоеОбслуживание(Станок, ТО, Истина, Вторник + 15.5 * Час, Вторник + 16.5 * Час);
	НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.Ремонт, Ложь, Среда + 23 * Час, Среда + 25 * Час);

	Выведенный = ВыведенныйСтанокСРаботой(Вторник + 8 * Час, Вторник + 10 * Час);

	ДеньВторника = Новый СтандартныйПериод(Вторник, Вторник + 86399);
	Данные = Отчеты.ПростоиСтанков.ДанныеОтчета(ДеньВторника, Истина);
	Строка = СтрокаОтчетаПростоев(Данные.Простои, Станок);
	ПроверитьРавенство(5, Строка.Часы, "план поверх факта - только вне факта: 2 + 2 + 1");
	ПроверитьРавенство(5, Строка.ЧасыВРабочееВремя, "в рабочее время - так же");
	ПроверитьРавенство(3, Строка.Случаев, "план целиком внутри факта - не отдельный случай");
	Строки = Данные.Простои.НайтиСтроки(Новый Структура("Станок", Выведенный));
	ПроверитьРавенство(1, Строки.Количество(), "выведенный станок с работой - в отчёте строкой фонда");

	ДоСреды = Новый СтандартныйПериод(Вторник, КонецДня(Среда));
	Данные = Отчеты.ПростоиСтанков.ДанныеОтчета(ДоСреды, Ложь);
	Отказы = Данные.Простои.НайтиСтроки(Новый Структура("Станок, Отказов", Станок, 1));
	ПроверитьРавенство(1, Отказы.Количество(), "ремонт в среду - отказ в периоде своего начала");
	Если Отказы.Количество() = 1 Тогда
		ПроверитьРавенство(1, Отказы[0].Часы, "часы ремонта в периоде - до конца периода");
		ПроверитьРавенство(2, Отказы[0].ЧасыОтказов, "MTTR - полная длительность ремонта");
	КонецЕсли;

	ПроверитьОтборыПростоев(Станок, ДоСреды);
	ПроверитьЗатянувшеесяНаВыведенном(Контекст);

	// Последний шаг - настоящий отказ: окончание равно началу при программном проведении.
	ПолучитьСообщенияПользователю(Истина);
	Отказано = Ложь;
	Попытка
		НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.Ремонт, Ложь, Среда + 10 * Час, Среда + 10 * Час);
	Исключение
		// После исключения в записи транзакция сценария годится только для отката: к базе больше не обращаемся.
		Отказано = Истина;
	КонецПопытки;
	Проверить(Отказано, "обслуживание с окончанием, равным началу, программно не проводится");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("простои: план только вне факта, MTTR полной длительностью ремонта, выведенный станок с "
		+ "работой и с затянувшимся требованием в отчёте, отбор по виду обслуживания без потери фонда, вариант компонуется, "
		+ "отказ нулевого интервала");

КонецФункции

// Выведенный станок с работой в интервале: запись «Работа» изображает обслуживание с переписанным видом записи.
//
// Параметры:
//  Начало    - Дата - начало работы
//  Окончание - Дата - окончание работы
//
// Возвращаемое значение:
//  СправочникСсылка.ПроизводственноеОборудование - выведенный станок
//
Функция ВыведенныйСтанокСРаботой(Начало, Окончание)

	Выведенный = НовыйСтанокСценария("выведенный");
	Работа = НовоеОбслуживание(Выведенный, Перечисления.ВидыОбслуживанияСтанков.Прочее, Ложь, Начало, Окончание);
	Набор = РегистрыСведений.ЗагрузкаСтанков.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Работа.Ссылка);
	Набор.Прочитать();
	Набор[0].ВидЗаписи = Перечисления.ВидыЗагрузкиСтанков.Работа;
	Набор.Записать();
	ВыведенныйОбъект = Выведенный.ПолучитьОбъект();
	ВыведенныйОбъект.Выведен = Истина;
	ВыведенныйОбъект.Записать();
	Возврат Выведенный;

КонецФункции

// Выведенный станок с затянувшимся требованием: требование запущено, расчётное окончание его записи раньше периода
// отчёта - станок в отчёте, наработка до момента расчёта (ревью Codex сборки 2.0.16.55, P2).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьЗатянувшеесяНаВыведенном(Контекст)

	// BSLLS:MagicNumber-off
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	Требование = НовоеТребованиеСценария(Контекст, Данные, 6);
	Требование.ФактНачало = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(Требование, "Запустить");
	Набор = РегистрыСведений.ЗагрузкаСтанков.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Требование.Ссылка);
	Набор.Прочитать();
	ПроверитьРавенство(1, Набор.Количество(), "запущенное требование - одна запись загрузки");
	День = НачалоДня(Набор[0].Окончание) + 86400;
	Пока ДеньНедели(День) > 5 Цикл
		День = День + 86400;
	КонецЦикла;
	СтанокОбъект = Данные.Станок.ПолучитьОбъект();
	СтанокОбъект.Выведен = Истина;
	СтанокОбъект.Записать();

	Период = Новый СтандартныйПериод(День, КонецДня(День));
	Простои = Отчеты.ПростоиСтанков.ДанныеОтчета(Период, Ложь, День + 12 * 3600).Простои;
	Строки = Простои.НайтиСтроки(Новый Структура("Станок", Данные.Станок));
	ПроверитьРавенство(1, Строки.Количество(), "выведенный станок с затянувшимся требованием - в отчёте");
	Если Строки.Количество() = 1 Тогда
		Проверить(Строки[0].ЧасыРаботы > 0, "наработка затянувшегося требования - до момента расчёта");
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Отборы «Простоев станков» (ревью Codex плана сборки 1, P2): отбор по виду обслуживания уходит в данные и не
// убирает строку фонда, отбор по часам не применяется и называется в предупреждении, отбор по станку остаётся
// компоновке; вариант «Основной» с такими настройками компонуется.
//
// Параметры:
//  Станок - СправочникСсылка.ПроизводственноеОборудование - станок с ремонтом в среду 23:00-01:00
//  Период - СтандартныйПериод - вторник и среда
//
Процедура ПроверитьОтборыПростоев(Станок, Период)

	Схема = Отчеты.ПростоиСтанков.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.ПолучитьНастройки();
	ПоСтанку = ДобавитьОтборПростоев(Настройки, "Станок", ВидСравненияКомпоновкиДанных.Равно, Станок);
	ДобавитьОтборПростоев(Настройки, "ВидОбслуживания", ВидСравненияКомпоновкиДанных.Равно,
		Перечисления.ВидыОбслуживанияСтанков.Ремонт);
	ДобавитьОтборПростоев(Настройки, "Часы", ВидСравненияКомпоновкиДанных.Больше, 0);
	// Отбор группировки «Станок» по причине убрал бы строку фонда - выключается; отбор вложенной группировки по виду
	// и причине (вариант «Основной») остаётся.
	ГруппировкаСтанка = Настройки.Структура[0];
	ОтборГруппировки = ГруппировкаСтанка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборГруппировки.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Причина");
	ОтборГруппировки.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ОтборГруппировки.Использование = Истина;
	ОтборыОтчета = Отчеты.ПростоиСтанков.ОтборыИзНастроек(Настройки);
	Проверить(Не ОтборГруппировки.Использование, "отбор группировки «Станок» по причине выключен");
	Проверить(ГруппировкаСтанка.Структура[0].Отбор.Элементы[0].Использование, "отбор группировки по виду остаётся");
	// Таблица в структуре: отбор группировки строк по станку тоже выключается (ревью Codex 2.0.16.56, verify).
	НастройкиТаблицы = Компоновщик.ПолучитьНастройки();
	Таблица = НастройкиТаблицы.Структура.Добавить(Тип("ТаблицаКомпоновкиДанных"));
	СтрокиТаблицы = Таблица.Строки.Добавить();
	ПолеСтрок = СтрокиТаблицы.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеСтрок.Поле = Новый ПолеКомпоновкиДанных("Станок");
	ПолеСтрок.Использование = Истина;
	ОтборСтрок = СтрокиТаблицы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСтрок.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Причина");
	ОтборСтрок.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ОтборСтрок.Использование = Истина;
	Отчеты.ПростоиСтанков.ОтборыИзНастроек(НастройкиТаблицы);
	Проверить(Не ОтборСтрок.Использование, "отбор строк таблицы по станку по причине выключен");
	ПроверитьРавенство(1, ОтборыОтчета.Отборы.Количество(), "отбор по виду обслуживания - в данные");
	Проверить(СтрНайти(ОтборыОтчета.Предупреждение, "Часы") > 0, "отбор по часам не применён - назван в предупреждении");
	Проверить(ПоСтанку.Использование, "отбор по станку остаётся компоновке");

	Простои = Отчеты.ПростоиСтанков.ДанныеОтчета(Период, Ложь, , ОтборыОтчета.Отборы).Простои;
	Строка = СтрокаОтчетаПростоев(Простои, Станок);
	ПроверитьРавенство(1, Строка.Случаев, "с отбором по ремонту - только ремонт");
	ПроверитьРавенство(1, Строка.Часы, "с отбором по ремонту - час ремонта в периоде");
	Проверить(Строка.Фонд > 0, "с отбором по ремонту фонд станка остаётся");

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, Новый Структура("Простои", Простои));
	Результат = Новый ДеревоЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);
	Проверить(Результат.Строки.Количество() > 0, "вариант «Основной» с отбором по станку компонуется");

КонецПроцедуры

// Элемент общего отбора настроек отчёта.
//
// Параметры:
//  Настройки    - НастройкиКомпоновкиДанных - настройки
//  ИмяПоля      - Строка - поле
//  ВидСравнения - ВидСравненияКомпоновкиДанных - вид сравнения
//  Значение     - Произвольный - правое значение
//
// Возвращаемое значение:
//  ЭлементОтбораКомпоновкиДанных - добавленный элемент
//
Функция ДобавитьОтборПростоев(Настройки, ИмяПоля, ВидСравнения, Значение)

	Элемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Элемент.ВидСравнения = ВидСравнения;
	Элемент.ПравоеЗначение = Значение;
	Элемент.Использование = Истина;
	Возврат Элемент;

КонецФункции

#КонецОбласти

#Область ИнвентаризацияСтанков

// Учёт станков, волна 5 (2.0.16.40): пересчёт, списание и оприходование «По станку». Требование A запущено (12 сырья
// на склад станка) и завершено с расходом 8 - свободный остаток 4; требование B (1 шт.) запущено - берёт 2 из
// свободного: на складе станка 4, закреплено 2, свободно 2. Пересчёт «По станку» - склад станка; списание недостачи 1
// на основании - «По станку», со склада станка, закреплённое цело; оприходование материалов 2 - на склад станка. Вид
// без станка и станок без склада - отказ записи; документы «По складу» - как раньше; документ на основании пересчёта
// держит склад пересчёта после смены склада станка, другой станок - отказ (2.0.16.54). Последний шаг - настоящий
// отказ: списание больше свободного остатка станка (инвариант закреплённого).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийИнвентаризацияСтанков(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 10 продукции x 2 сырья; закупки сырья 30.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	ПоСтанку = Перечисления.ВидыСкладскихОпераций.Станок;
	ИмяПересчета = "ПересчётТоваров";
	ТребованиеА = НовоеТребованиеСценария(Контекст, Данные, 6);
	ТребованиеА.ФактНачало = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Запустить");
	ЗавершитьТребованиеСценария(Контекст, ТребованиеА, 6, 8);
	ТребованиеБ = НовоеТребованиеСценария(Контекст, Данные, 1);
	ТребованиеБ.ФактНачало = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(ТребованиеБ, "Запустить");
	ПроверитьРавенство(4, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "на складе станка 4");

	// Пересчёт «По станку»: место хранения - склад станка, учётное - всё на станке, его заполняет модуль менеджера, как
	// форма (2.0.16.56).
	Пересчет = НовыйДокумент(Контекст, ИмяПересчета);
	Пересчет.МестоХранения = Справочники.МестаХранения.ПустаяСсылка();
	Пересчет.ВидОперации = ПоСтанку;
	Пересчет.Станок = Данные.Станок;
	Строка = Пересчет.ТЧТовары.Добавить();
	Строка.Номенклатура = Данные.Сырье;
	Строка.Упаковка = Контекст.Единица;
	Строка.КоличествоУпаковокФакт = 3;
	Строка.КоличествоФакт = 3;
	Проверить(Пересчет.ПроверитьЗаполнение(), "пересчёт по станку без склада проходит проверку: " + СообщенияПользователю());
	Пересчет.Записать(РежимЗаписиДокумента.Запись);
	ПроверитьРавенство(Данные.СкладСтанка, Пересчет.МестоХранения, "пересчёт по станку - склад станка");
	// BSLLS:YoLetterUsage-off - имя документа
	Документы.ПересчётТоваров.ЗаполнитьУчетноеКоличество(Пересчет);
	Синоним = Метаданные.Документы.ПересчётТоваров.Синоним;
	// BSLLS:YoLetterUsage-on
	ПроверитьРавенство(4, Строка.Количество, "учётное пересчёта по станку - остаток склада станка");
	ПроверитьРавенство(4, Строка.КоличествоУпаковок, "учётное в упаковках - остаток склада станка");
	Пересчет.Записать(РежимЗаписиДокумента.Запись);
	Заголовок = ЗагрузкаСтанков.ЗаголовокДокументаПоСтанку(Пересчет);
	ДлинаЗаголовка = СтрДлина(Заголовок);
	Проверить(СтрНайти(Заголовок, Синоним) = 1 И ДлинаЗаголовка > СтрДлина(Синоним),
		"заголовок формы пересчёта по станку - с пометкой вида");

	// Списание недостачи 1 на основании: по станку, со склада станка; закреплённое за B цело.
	Списание = Документы.СписаниеТоваров.СоздатьДокумент();
	Списание.Заполнить(Пересчет.Ссылка);
	Списание.Дата = СледующаяДата(Контекст);
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	ПроверитьРавенство(ПоСтанку, Списание.ВидОперации, "списание на основании - по станку");
	ПроверитьРавенство(Данные.Станок, Списание.Станок, "списание на основании - станок пересчёта");
	ПроверитьРавенство(1, Списание.ТЧТовары.Итог("Количество"), "списывается недостача 1");
	Провести(Списание);
	ПроверитьРавенство(3, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "после списания на станке 3");
	ПроверитьРавенство(2, ЗакрепленоНаСтанке(ТребованиеБ.Ссылка), "закреплённое за B цело");

	// Оприходование материалов 2 - на склад станка.
	Оприходование = НовыйДокумент(Контекст, "ОприходованиеТоваров");
	Оприходование.МестоХранения = Справочники.МестаХранения.ПустаяСсылка();
	Оприходование.ВидОперации = ПоСтанку;
	Оприходование.Станок = Данные.Станок;
	ДобавитьСтрокуТоваров(Контекст, Оприходование, "ТЧТовары", Данные.Сырье, 2, 10);
	Провести(Оприходование);
	ПроверитьРавенство(Данные.СкладСтанка, Оприходование.МестоХранения, "оприходование материалов - склад станка");
	ПроверитьРавенство(5, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "после оприходования на станке 5");

	// Вид «По станку» без станка и станок без склада - отказ записи; «По складу» станок очищается.
	// Отказы проверяются без записи: отказ записи в середине сценария испортил бы транзакцию прогона.
	БезСтанка = НовыйДокумент(Контекст, ИмяПересчета);
	БезСтанка.ВидОперации = ПоСтанку;
	Проверить(Не БезСтанка.ПроверитьЗаполнение(), "по станку без станка - проверка заполнения не пройдена");
	БезСклада = НовыйДокумент(Контекст, "ОприходованиеТоваров");
	БезСклада.ВидОперации = ПоСтанку;
	БезСклада.Станок = НовыйСтанокСценария("без склада");
	ОтказБезСклада = Ложь;
	ЗагрузкаСтанков.ЗаполнитьСкладСтанкаДокумента(БезСклада, ОтказБезСклада);
	Проверить(ОтказБезСклада, "станок без склада станка - отказ записи");
	ПолучитьСообщенияПользователю(Истина);
	ПоСкладу = НовыйДокумент(Контекст, ИмяПересчета);
	ПоСкладу.Станок = Данные.Станок;
	ПоСкладу.Записать(РежимЗаписиДокумента.Запись);
	Проверить(Не ЗначениеЗаполнено(ПоСкладу.Станок), "по складу (пустой вид) - станок очищен");
	ПроверитьРавенство("", ЗагрузкаСтанков.ЗаголовокДокументаПоСтанку(ПоСкладу), "заголовок по складу - обычный");
	ПроверитьРавенство(Контекст.Склад, ПоСкладу.МестоХранения, "по складу - склад прежний");

	// Склад станка сменили после пересчёта: документ на основании - со складом пересчёта, другой станок - отказ
	// (ревью Codex волны 5, P1). Проверка без записи.
	СкладДо = Справочники.МестаХранения.СоздатьЭлемент();
	СкладДо.Наименование = ПометкаТеста() + ": склад станка до смены";
	СкладДо.Записать();
	СкладПосле = Справочники.МестаХранения.СоздатьЭлемент();
	СкладПосле.Наименование = ПометкаТеста() + ": склад станка после смены";
	СкладПосле.Записать();
	СтанокОбъект = НовыйСтанокСценария("смена склада").ПолучитьОбъект();
	СтанокОбъект.СкладСтанка = СкладДо.Ссылка;
	СтанокОбъект.Записать();
	ПересчетДо = НовыйДокумент(Контекст, ИмяПересчета);
	ПересчетДо.ВидОперации = ПоСтанку;
	ПересчетДо.Станок = СтанокОбъект.Ссылка;
	ПересчетДо.Записать(РежимЗаписиДокумента.Запись);
	СтанокОбъект.СкладСтанка = СкладПосле.Ссылка;
	СтанокОбъект.Записать();
	ПоПересчету = Документы.ОприходованиеТоваров.СоздатьДокумент();
	ПоПересчету.Заполнить(ПересчетДо.Ссылка);
	ПроверитьРавенство(СкладДо.Ссылка, ЗагрузкаСтанков.СкладСтанкаДокумента(ПоПересчету.Станок, ПоПересчету.Основание),
		"форма документа на основании - склад пересчёта");
	ОтказСклада = Ложь;
	ЗагрузкаСтанков.ЗаполнитьСкладСтанкаДокумента(ПоПересчету, ОтказСклада, ПоПересчету.Основание);
	Проверить(Не ОтказСклада, "документ на основании пересчёта по станку записывается: " + СообщенияПользователю());
	ПроверитьРавенство(СкладДо.Ссылка, ПоПересчету.МестоХранения, "документ на основании - склад пересчёта, не новый");
	ПоПересчету.Станок = Данные.Станок;
	ЗагрузкаСтанков.ЗаполнитьСкладСтанкаДокумента(ПоПересчету, ОтказСклада, ПоПересчету.Основание);
	Проверить(ОтказСклада, "документ на основании пересчёта с другим станком - отказ записи");
	ПолучитьСообщенияПользователю(Истина);

	// Последний шаг - настоящий отказ: списание по станку больше свободного остатка (5 на станке, 2 закреплено за B).
	Лишнее = НовыйДокумент(Контекст, "СписаниеТоваров");
	Лишнее.ВидОперации = ПоСтанку;
	Лишнее.Станок = Данные.Станок;
	Лишнее.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	ДобавитьСтрокуТоваров(Контекст, Лишнее, "ТЧТовары", Данные.Сырье, 4, 0);
	Проверить(ОтказЗаписиДокумента(Лишнее), "списание закреплённого со станка отклонено");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("пересчёт по станку - склад станка, списание недостачи на основании по станку с целым "
		+ "закреплённым, оприходование материалов на склад станка, отказ без станка и без склада станка, по складу - как "
		+ "раньше, на основании пересчёта - его склад после смены склада станка, отказ списания закреплённого");

КонецФункции

// Закреплено за требованием в «Материалах на станках» сейчас.
//
// Параметры:
//  Требование - ДокументСсылка.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Число - количество
//
Функция ЗакрепленоНаСтанке(Требование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.МатериалыНаСтанках.Остатки(, Требование = &Требование) КАК Остатки";
	Запрос.УстановитьПараметр("Требование", Требование);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

#КонецОбласти

#Область СебестоимостьПродаж

// Сценарии фазы 2 ордерных складов v2 - регистр себестоимости продаж (docs/plans/warehouse-orders-cost.md, Ф2.11).
//
// Возвращаемое значение:
//  Массив из Строка - имена сценариев
//
Функция ИменаСценариевСебестоимостиПродаж()

	Возврат СтрРазделить("СебестоимостьПродажРеализации,ВозвратИзСебестоимостиПродаж,ВозвратДвумяСтроками,"
		+ "СебестоимостьНалоговогоНаОснованиях,ПереносСебестоимостиПродаж,МаржаОтчетов,РаскладкаКопеек,"
		+ "ПраваСебестоимостиПродаж", ",");

КонецФункции

// Параметры:
//  Имя      - Строка - имя сценария
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСебестоимостиПродажПоИмени(Имя, Контекст)

	Если Имя = "СебестоимостьПродажРеализации" Тогда
		Возврат СценарийСебестоимостьПродажРеализации(Контекст);
	ИначеЕсли Имя = "ВозвратИзСебестоимостиПродаж" Тогда
		Возврат СценарийВозвратИзСебестоимостиПродаж(Контекст);
	ИначеЕсли Имя = "ВозвратДвумяСтроками" Тогда
		Возврат СценарийВозвратДвумяСтроками(Контекст);
	ИначеЕсли Имя = "СебестоимостьНалоговогоНаОснованиях" Тогда
		Возврат СценарийСебестоимостьНалоговогоНаОснованиях(Контекст);
	ИначеЕсли Имя = "ПереносСебестоимостиПродаж" Тогда
		Возврат СценарийПереносСебестоимостиПродаж(Контекст);
	ИначеЕсли Имя = "МаржаОтчетов" Тогда
		Возврат СценарийМаржаОтчетов(Контекст);
	ИначеЕсли Имя = "РаскладкаКопеек" Тогда
		Возврат СценарийРаскладкаКопеек();
	Иначе
		Возврат СценарийПраваСебестоимостиПродаж();
	КонецЕсли;

КонецФункции

// Реализация двух партий: записи себестоимости продаж = записи расхода склада построчно, услуга без закупочной цены
// себестоимости не дает, в продажах - одна запись на товар без партии и себестоимости.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСебестоимостьПродажРеализации(Контекст)

	// BSLLS:MagicNumber-off - две партии по 10 штук ценой 10 и 30, продажа 15 штук по 50 - себестоимость 250.
	Товар = НоваяНоменклатура(Контекст, "товар себестоимости продаж", Перечисления.ТипыНоменклатуры.Товар);
	Услуга = НоваяНоменклатура(Контекст, "услуга себестоимости продаж", Перечисления.ТипыНоменклатуры.Услуга);
	ДокументЗакупки(Контекст, Товар, 10, 10);
	ДокументЗакупки(Контекст, Товар, 10, 30);
	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Реализация.Контрагент = Контекст.Контрагент;
	Реализация.Договор = Контекст.ДоговорПокупателя;
	Реализация.ЦенаВключаетНДС = Истина;
	ДобавитьСтрокуТоваров(Контекст, Реализация, "ТЧТовары", Товар, 15, 50);
	ДобавитьСтрокуТоваров(Контекст, Реализация, "ТЧТовары", Услуга, 1, 20);
	Провести(Реализация);
	Ссылка = Реализация.Ссылка;
	ПроверитьРавенство(ЗаписиРегистраСтрокой("ТоварыВНаличии", Ссылка, "Номенклатура, Партия, Количество, Сумма, СуммаНДС"),
		ЗаписиРегистраСтрокой(РегистрСебестоимости(), Ссылка, "НоменклатураПартии, Партия, Количество, Сумма, СуммаНДС"),
		"записи себестоимости = записи расхода склада");
	ПроверитьРавенство(250, СебестоимостьДокумента(Ссылка).Себестоимость, "себестоимость: 10 x 10 + 5 x 30");
	ПроверитьРавенство(2, ЧислоЗаписейПродаж(Ссылка), "продажи: одна запись на товар и на услугу");
	ПроверитьРавенство(0, СебестоимостьВПродажах(Ссылка), "в продажах себестоимости нет");
	Продажи = ОборотыПродаж(Ссылка);
	ПроверитьРавенство(15 * 50 + 20, Продажи.Выручка, "выручка товара и услуги");
	ПроверитьРавенство(Продажи.Выручка - 250, ПрибыльФункцией(Ссылка), "прибыль единой формулой");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("себестоимость продаж реализации = ее списание склада построчно, продажи - без партий и "
		+ "себестоимости, прибыль - единой формулой");

КонецФункции

// Возврат читает партии из себестоимости продаж основания: первый возврат восстанавливает те же партии и суммы, что
// прежнее поведение (эталон - числа FIFO), второй частичный - оставшиеся партии, а не первые снова; после полного
// возврата продажа и себестоимость основания с возвратами - нулевые, перепроведение возврата их не меняет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВозвратИзСебестоимостиПродаж(Контекст)

	// BSLLS:MagicNumber-off - партии 10 по 10 и 5 по 30, продажа 15; возвраты 12 и 3.
	Товар = НоваяНоменклатура(Контекст, "товар возврата себестоимости", Перечисления.ТипыНоменклатуры.Товар);
	Первая = ДокументЗакупки(Контекст, Товар, 10, 10);
	ДопрасходНаПартию(Контекст, Первая, 20);
	Вторая = ДокументЗакупки(Контекст, Товар, 5, 30);
	Реализация = ДокументРеализации(Контекст, Товар, 15, 50);
	СебестоимостьРеализации = СебестоимостьДокумента(Реализация);
	ПроверитьРавенство(20, СебестоимостьРеализации.ДополнительныеРасходы, "допрасход партии 1 в продаже");
	ПервыйВозврат = ВозвратЧасти(Контекст, Реализация, 12);
	СебестоимостьПервого = СебестоимостьДокумента(ПервыйВозврат);
	ПроверитьРавенство(-20, СебестоимостьПервого.ДополнительныеРасходы, "первый возврат сторнирует допрасход партии 1");
	ПроверитьРавенство(10, КоличествоПриходаПартии(ПервыйВозврат, Первая), "первый возврат: партия 1 целиком");
	ПроверитьРавенство(2, КоличествоПриходаПартии(ПервыйВозврат, Вторая), "первый возврат: 2 из партии 2");
	ПроверитьРавенство(-160, СебестоимостьПервого.Себестоимость, "сторно себестоимости 100 + 60");
	ВторойВозврат = ВозвратЧасти(Контекст, Реализация, 3);
	ПроверитьРавенство(0, КоличествоПриходаПартии(ВторойВозврат, Первая), "второй возврат не берет партию 1 снова");
	ПроверитьРавенство(3, КоличествоПриходаПартии(ВторойВозврат, Вторая), "второй возврат: остаток партии 2");
	Итог = ОборотыПродаж(Реализация);
	ПроверитьРавенство(0, Итог.Количество, "продажа с возвратами: количество 0");
	ПроверитьРавенство(0, Итог.Выручка, "продажа с возвратами: выручка 0");
	ПроверитьРавенство(0, Итог.Себестоимость, "продажа с возвратами: себестоимость 0");
	ДопрасходыВторого = СебестоимостьДокумента(ВторойВозврат).ДополнительныеРасходы;
	ПроверитьРавенство(0, СебестоимостьРеализации.ДополнительныеРасходы + СебестоимостьПервого.ДополнительныеРасходы
		+ ДопрасходыВторого, "продажа с возвратами: допрасходы 0");
	Снимок = ЗаписиРегистраСтрокой(РегистрСебестоимости(), ВторойВозврат, "НоменклатураПартии, Партия, Количество, Сумма");
	ВозвратОбъект = ВторойВозврат.ПолучитьОбъект();
	ВозвратОбъект.Записать(РежимЗаписиДокумента.Проведение);
	// Тот же экземпляр второй раз подряд - наборы не удваиваются.
	ВозвратОбъект.Записать(РежимЗаписиДокумента.Проведение);
	ИтогПовтора = ОборотыПродаж(Реализация);
	ПроверитьРавенство(0, ИтогПовтора.Количество, "повторное проведение экземпляра: продажи не удвоены");
	ПроверитьРавенство(0, ИтогПовтора.Себестоимость, "повторное проведение экземпляра: себестоимость не удвоена");
	СнимокПосле = ЗаписиРегистраСтрокой(РегистрСебестоимости(), ВторойВозврат, "НоменклатураПартии, Партия, Количество, Сумма");
	ПроверитьРавенство(Снимок, СнимокПосле, "перепроведение возврата - те же записи");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("возврат из себестоимости продаж: партии FIFO основания, второй возврат - оставшиеся "
		+ "партии, итог продажи с возвратами нулевой, перепроведение не меняет записи");

КонецФункции

// Две строки одного товара в одном возврате не восстанавливают одну партию дважды.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВозвратДвумяСтроками(Контекст)

	// BSLLS:MagicNumber-off - партии 1 по 10 и 1 по 30, продажа 2, возврат двумя строками по 1.
	Товар = НоваяНоменклатура(Контекст, "товар возврата двумя строками", Перечисления.ТипыНоменклатуры.Товар);
	Первая = ДокументЗакупки(Контекст, Товар, 1, 10);
	Вторая = ДокументЗакупки(Контекст, Товар, 1, 30);
	Реализация = ДокументРеализации(Контекст, Товар, 2, 50);
	ДокВозврата = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	ДокВозврата.Заполнить(Реализация);
	ДокВозврата.Дата = СледующаяДата(Контекст);
	ДокВозврата.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	Строка = ДокВозврата.ТЧТовары[0];
	УстановитьКоличествоСтрокиВозврата(Строка, 1, ДокВозврата.ЦенаВключаетНДС);
	СтрокаДубль = ДокВозврата.ТЧТовары.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаДубль, Строка, , "НомерСтроки");
	Провести(ДокВозврата);
	ПроверитьРавенство(1, КоличествоПриходаПартии(ДокВозврата.Ссылка, Первая), "строки возврата: партия 1 один раз");
	ПроверитьРавенство(1, КоличествоПриходаПартии(ДокВозврата.Ссылка, Вторая), "строки возврата: партия 2 один раз");
	ПроверитьРавенство(0, ОборотыПродаж(Реализация).Себестоимость, "себестоимость продажи с возвратом - 0");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("две строки одного товара в возврате восстанавливают каждую партию один раз");

КонецФункции

// Налоговый документ на основаниях: черная сторона себестоимости - минус записи основания, белая - те же суммы с его
// измерениями; возврат по нему берет партии из белой стороны. Основание с возвратом по налоговому документу больше не
// замораживается: пересчет после поступления задним числом перепроводит основание, налоговый документ и возврат
// (Ф2.4), отметки «стоимость заморожена» нет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСебестоимостьНалоговогоНаОснованиях(Контекст)

	Константы.РаздельныйУчет.Установить(Истина);
	// BSLLS:MagicNumber-off - партия 20 по 10, продажа 3, возврат 1; позже - поступление задним числом 20 по 4.
	Товар = НоваяНоменклатура(Контекст, "товар налогового на основаниях", Перечисления.ТипыНоменклатуры.Товар);
	НачалоСценария = СледующаяДата(Контекст);
	ДокументЗакупки(Контекст, Товар, 20, 10);
	Основание = НоваяРеализацияУУ(Контекст, Товар, 3, Контекст.Числа.ЦенаПродажи, Истина);
	Налоговый = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	НалоговыеДокументыНаОснованиях.ЗаполнитьПоОснованиям(Налоговый, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основание));
	Провести(Налоговый);
	СебестоимостьОснования = СебестоимостьДокумента(Основание).Себестоимость;
	ПроверитьРавенство(30, СебестоимостьОснования, "себестоимость основания");
	ПроверитьРавенство(0, СебестоимостьДокумента(Налоговый.Ссылка).Себестоимость, "налоговый: черная + белая = 0");
	ПроверитьРавенство(30, СебестоимостьСтороны(Налоговый.Ссылка, Ложь), "налоговый: белая сторона = основанию");
	ДокВозврата = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	ДокВозврата.Заполнить(Налоговый.Ссылка);
	ДокВозврата.Дата = СледующаяДата(Контекст);
	ДокВозврата.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	УстановитьКоличествоСтрокиВозврата(ДокВозврата.ТЧТовары[0], 1, ДокВозврата.ЦенаВключаетНДС);
	Провести(ДокВозврата);
	ПроверитьРавенство(-10, СебестоимостьДокумента(ДокВозврата.Ссылка).Себестоимость, "возврат по налоговому: 1 по 10");
	Проверить(Не НалоговыеДокументыНаОснованиях.ОснованиеЗаморожено(Основание), "продажа-основание не заморожена");

	Версия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "ВерсияДанных");
	Позднее = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Позднее.Дата = НачалоСценария;
	Позднее.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Позднее.Контрагент = Контекст.Контрагент;
	Позднее.Договор = Контекст.ДоговорПоставщика;
	Позднее.ЦенаВключаетНДС = Истина;
	Позднее.Валюта = Контекст.Валюта;
	Позднее.КурсВалюты = 1;
	ДобавитьСтрокуТоваров(Контекст, Позднее, "ТЧТовары", Товар, 20, 4);
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Позднее.ТЧТовары[0], Позднее.ЦенаВключаетНДС);
	Провести(Позднее);
	ПересчитатьСценарий(Позднее.МоментВремени());
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "ВерсияДанных") <> Версия,
		"пересчет перепровел основание с возвратом по налоговому документу");
	ПроверитьБезОшибокПересчета(Основание);
	Проверить(РегистрыСведений.НепроведенныеДокументы.ЗамороженныеДокументы().Найти(Основание) = Неопределено,
		"отметки «стоимость заморожена» нет");
	ПроверитьРавенство(12, СебестоимостьДокумента(Основание).Себестоимость, "основание после пересчета: 3 по 4");
	ПроверитьРавенство(12, СебестоимостьСтороны(Налоговый.Ссылка, Ложь), "белая сторона налогового пересчитана");
	ПроверитьРавенство(-4, СебестоимостьДокумента(ДокВозврата.Ссылка).Себестоимость, "возврат пересчитан: 1 по 4");
	ПроверитьРавенство(4, СуммаПриходаДокумента(ДокВозврата.Ссылка), "приход возврата на склад - по 4");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("налоговый на основаниях: черная и белая стороны себестоимости, возврат из белой; "
		+ "пересчет перепроводит основание с возвратом, налоговый документ и возврат, без заморозки");

КонецФункции

// Перенос истории (Ф2.6): движения Продажи прежнего вида (партия и себестоимость в продажах, записей нового регистра
// нет) у реализации двух партий, исторического возврата с пропорциональной себестоимостью и ручной корректировки с
// записями разных месяцев и неактивной; обработчик дает физическую детализацию, поправку разницы и построчную
// корректировку, сверка сходится, повтор - те же записи; следующий возврат восстанавливает оставшуюся партию и,
// завершая товар, компенсирует поправку - себестоимость продажи с возвратами 0. Излишек исторических возвратов
// останавливает перенос.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПереносСебестоимостиПродаж(Контекст)

	// BSLLS:MagicNumber-off - партии 1 по 10 и 1 по 30, продажа 2 по 50; исторический возврат 1 из партии 2 со
	// старой пропорциональной себестоимостью 20 вместо 30 - поправка 10.
	Товар = НоваяНоменклатура(Контекст, "товар переноса себестоимости", Перечисления.ТипыНоменклатуры.Товар);
	Первая = ДокументЗакупки(Контекст, Товар, 1, 10);
	Вторая = ДокументЗакупки(Контекст, Товар, 1, 30);
	Реализация = ДокументРеализации(Контекст, Товар, 2, 50);
	ДокВозврата = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	ДокВозврата.Заполнить(Реализация);
	ДокВозврата.Дата = СледующаяДата(Контекст);
	ДокВозврата.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	УстановитьКоличествоСтрокиВозврата(ДокВозврата.ТЧТовары[0], 1, ДокВозврата.ЦенаВключаетНДС);
	Провести(ДокВозврата);
	// Исторический возврат восстановил партию 2 (подмена движения склада, как если бы ее выбрал прежний алгоритм).
	ПодменитьПартиюПрихода(ДокВозврата.Ссылка, Первая, Вторая, 30);
	Корректировка = РучнаяКорректировкаПродаж(Контекст, Товар, 2, Истина);
	Неактивная = РучнаяКорректировкаПродаж(Контекст, Товар, 1, Ложь);
	ЗаписатьПродажиПрежнегоВида(Реализация, ДокВозврата.Ссылка, Товар, Первая, Вторая);
	Регистраторы = Новый Массив;
	Регистраторы.Добавить(Реализация);
	Регистраторы.Добавить(ДокВозврата.Ссылка);
	Регистраторы.Добавить(Корректировка);
	Регистраторы.Добавить(Неактивная);
	Итог = РегистрыНакопления.СебестоимостьПродаж.ПеренестиИсторию(Регистраторы);
	ПроверитьРавенство(1, Итог.Поправок, "одна поправка: исторический возврат");
	ПроверитьРавенство(10, Итог.СуммаПоправок, "поправка = -20 - (-30)");
	ПроверитьРавенство(ЗаписиРегистраСтрокой("ТоварыВНаличии", Реализация, "Номенклатура, Партия, Количество, Сумма"),
		ЗаписиРегистраСтрокой(РегистрСебестоимости(), Реализация, "НоменклатураПартии, Партия, Количество, Сумма"),
		"перенос реализации - ее записи склада");
	ПроверитьРавенство(0, РегистрыНакопления.СебестоимостьПродаж.РасхожденияПереноса(Регистраторы).Количество(),
		"сверка переноса");
	ПроверитьРавенство(2, ЧислоЗаписейСебестоимости(Корректировка), "корректировка - построчно");
	ПроверитьРавенство(1, ЧислоЗаписейСебестоимости(Неактивная, Ложь), "неактивный набор сохранен неактивным");
	ТаблицаКорректировки = Корректировка.ПолучитьОбъект().ТаблицаРегистров;
	Проверить(ТаблицаКорректировки.Найти(РегистрСебестоимости(), "Имя") <> Неопределено,
		"перенесенный регистр - в таблице регистров корректировки");
	Снимок = ЗаписиРегистраСтрокой(РегистрСебестоимости(), ДокВозврата.Ссылка, "Партия, Количество, Сумма, Поправка, Списание");
	РегистрыНакопления.СебестоимостьПродаж.ПеренестиИсторию(Регистраторы);
	СнимокПосле = ЗаписиРегистраСтрокой(РегистрСебестоимости(), ДокВозврата.Ссылка, "Партия, Количество, Сумма, Поправка, Списание");
	ПроверитьРавенство(Снимок, СнимокПосле, "повторный перенос - те же записи");
	ПроверитьРавенство(0, СебестоимостьВПродажах(Реализация) - 40, "в прежних продажах себестоимость осталась");

	Последний = ВозвратЧасти(Контекст, Реализация, 1);
	ПроверитьРавенство(1, КоличествоПриходаПартии(Последний, Первая), "следующий возврат - оставшаяся партия 1");
	Проверить(ЧислоЗаписейСебестоимости(Последний, Истина, Истина) > 0,
		"завершающий возврат компенсирует поправку");
	ПроверитьРавенство(0, ОборотыПродаж(Реализация).Себестоимость, "себестоимость продажи с возвратами - 0");
	ПроверитьРавенство(0, ОборотыПродаж(Реализация).Выручка, "выручка продажи с возвратами - 0");

	ПодменитьПартиюПрихода(Последний, Первая, Вторая, 30);
	Излишки = РегистрыНакопления.СебестоимостьПродаж.ИзлишкиИсторическихВозвратов(Регистраторы);
	ПроверитьРавенство(1, Излишки.Количество(), "излишек: партия 2 возвращена дважды");
	Остановлен = Ложь;
	Попытка
		РегистрыНакопления.СебестоимостьПродаж.ПеренестиИсторию(Регистраторы);
	Исключение
		Остановлен = Истина;
	КонецПопытки;
	Проверить(Остановлен, "излишек исторических возвратов останавливает перенос");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("перенос истории: детализация движениями склада, поправка исторического возврата, "
		+ "построчная корректировка, сверка, повтор; компенсация поправки завершающим возвратом; излишек - остановка");

КонецФункции

// Прибыль отчета «Ведомость по продажам» (схема компоновки) равна прибыли единой функции.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийМаржаОтчетов(Контекст)

	// BSLLS:MagicNumber-off
	Товар = НоваяНоменклатура(Контекст, "товар маржи отчетов", Перечисления.ТипыНоменклатуры.Товар);
	ДокументЗакупки(Контекст, Товар, 5, 10);
	Реализация = ДокументРеализации(Контекст, Товар, 4, 25);
	ВозвратЧасти(Контекст, Реализация, 1);
	// BSLLS:MagicNumber-on
	ИмяПрибыли = "ВаловаяПрибыль";
	Схема = Отчеты.ВедомостьПоПродажам.Создать().СхемаКомпоновкиДанных;
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;
	Настройки.Структура.Очистить();
	Настройки.Выбор.Элементы.Очистить();
	Настройки.Отбор.Элементы.Очистить();
	Период = Новый СтандартныйПериод(НачалоГода(Контекст.Дата), КонецГода(ТекущаяДатаСеанса()));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Период);
	Поле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПрибыли);
	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДокументПродажи");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Реализация;
	Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	// Без общего итога: в коллекцию значений он выводится отдельной строкой и удвоил бы сумму.
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов",
		РасположениеИтоговКомпоновкиДанных.Нет);
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);
	Колонки = Новый Массив;
	Для Каждого Колонка Из Результат.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	Проверить(Колонки.Найти(ИмяПрибыли) <> Неопределено, "колонка прибыли в выводе: " + СтрСоединить(Колонки, ", "));
	ПроверитьРавенство(ПрибыльФункцией(Реализация), Результат.Итог(ИмяПрибыли),
		"прибыль ведомости по продажам = прибыли функции");

	Возврат РезультатСценария("ведомость по продажам: прибыль из себестоимости продаж совпадает с единой функцией");

КонецФункции

// Раскладка допрасхода по знаковым остаткам источников до копейки (Ф2.3, Редакции 22-24).
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийРаскладкаКопеек()

	// BSLLS:MagicNumber-off
	Менеджер = РегистрыНакопления.СебестоимостьПродаж;
	ПроверитьРаскладку(Менеджер, СтрРазделить("0.01,0.01,0.01,0.01", ","), 0.03, "четыре малые суммы");
	ПроверитьРаскладку(Менеджер, СтрРазделить("10,-3,5", ","), 7.01, "смешанные знаки");
	ПроверитьРаскладку(Менеджер, СтрРазделить("-10,-0.07,-5", ","), -9.99, "отрицательный итог");
	ПроверитьРаскладку(Менеджер, СтрРазделить("100,0", ","), 100, "полное сторно: 100 и 0");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("раскладка до копейки: сумма частей = итогу, знак и предел каждого источника");

КонецФункции

Процедура ПроверитьРаскладку(Менеджер, Строки, Итог, Описание)

	Базы = Новый Массив;
	Для Каждого Значение Из Строки Цикл
		Базы.Добавить(Число(Значение));
	КонецЦикла;
	Части = Менеджер.РаспределитьПропорционально(Базы, Итог);
	Сумма = 0;
	Для Индекс = 0 По Базы.ВГраница() Цикл
		Сумма = Сумма + Части[Индекс];
		Проверить(Части[Индекс] * Базы[Индекс] >= 0, Описание + ": знак части " + Индекс);
		Проверить(Макс(Части[Индекс], -Части[Индекс]) <= Макс(Базы[Индекс], -Базы[Индекс]),
			Описание + ": часть не больше источника " + Индекс);
	КонецЦикла;
	ПроверитьРавенство(Итог, Сумма, Описание + ": сумма частей");

КонецПроцедуры

// Чтение себестоимости продаж - ролям, читающим продажи, кроме личного кабинета и оператора производства; изменения нет.
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПраваСебестоимостиПродаж()

	Регистр = Метаданные.РегистрыНакопления.СебестоимостьПродаж;
	Чтение = "Чтение";
	Читают = СтрРазделить("Казначей,БухгалтерПоЗарплате,Логист,МенеджерПоПродажам,Оператор,"
		+ "Кладовщик,МенеджерПоЗакупкам,MobileClient,PDV", ",");
	Для Каждого ИмяРоли Из Читают Цикл
		Роль = Метаданные.Роли[ИмяРоли];
		Проверить(ПравоДоступа(Чтение, Регистр, Роль), "чтение себестоимости продаж: " + ИмяРоли);
		Проверить(Не ПравоДоступа("Изменение", Регистр, Роль), "без изменения себестоимости продаж: " + ИмяРоли);
	КонецЦикла;
	Проверить(Не ПравоДоступа(Чтение, Регистр, Метаданные.Роли.ЛичныйКабинет), "личный кабинет себестоимость не читает");
	// Оператор производства денег не видит (дашборд показывает ему только производство) - себестоимость не читает.
	Проверить(Не ПравоДоступа(Чтение, Регистр, Метаданные.Роли.ОператорПроизводства),
		"оператор производства себестоимость не читает");

	Возврат РезультатСценария("чтение себестоимости продаж у ролей, читающих продажи, кроме личного кабинета; "
		+ "изменения нет");

КонецФункции

// Проведенный документ допрасходов на партию поступления.
//
// Параметры:
//  Контекст    - Структура - см. НовыйКонтекст
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - партия
//  Сумма       - Число - сумма допрасхода
//
Процедура ДопрасходНаПартию(Контекст, Поступление, Сумма)

	Док = НовыйДокумент(Контекст, "ПоступлениеДополнительныхРасходов");
	Док.Заполнить(Поступление);
	Док.Дата = СледующаяДата(Контекст);
	Док.Валюта = Контекст.Валюта;
	Док.КурсВалюты = 1;
	Док.СтавкаНДС = Контекст.СтавкаНДС;
	Док.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.Себестоимость;
	Док.ТЧТовары[0].Сумма = Сумма;
	Док.Сумма = Сумма;
	Провести(Док);

КонецПроцедуры

// Возврат части первой строки реализации.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - основание
//  Количество - Число - возвращаемое количество
//
// Возвращаемое значение:
//  ДокументСсылка.ВозвратОтПокупателя - проведенный возврат
//
Функция ВозвратЧасти(Контекст, Реализация, Количество)

	Док = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	Док.Заполнить(Реализация);
	Док.Дата = СледующаяДата(Контекст);
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	УстановитьКоличествоСтрокиВозврата(Док.ТЧТовары[0], Количество, Док.ЦенаВключаетНДС);
	Провести(Док);
	Возврат Док.Ссылка;

КонецФункции

Процедура УстановитьКоличествоСтрокиВозврата(Строка, Количество, ЦенаВключаетНДС)

	Строка.Количество = Количество;
	Строка.КоличествоУпаковок = Количество;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Строка, ЦенаВключаетНДС);

КонецПроцедуры

// Себестоимость документа продажи (по документу продажи, с его возвратами) или регистратора.
//
// Параметры:
//  Документ - ДокументСсылка - реализация или возврат
//
// Возвращаемое значение:
//  Структура - Себестоимость (партии), ДополнительныеРасходы
//
Функция СебестоимостьДокумента(Документ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА Т.ДополнительныйРасход
		|					ТОГДА 0
		|				ИНАЧЕ Т.Сумма
		|			КОНЕЦ), 0) КАК Себестоимость,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА Т.ДополнительныйРасход
		|					ТОГДА Т.Сумма
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК ДополнительныеРасходы
		|ИЗ
		|	РегистрНакопления.СебестоимостьПродаж КАК Т
		|ГДЕ
		|	Т.Регистратор = &Документ
		|	И Т.Активность");
	Запрос.УстановитьПараметр("Документ", Документ);
	Возврат ПерваяСтрока(Запрос, "Себестоимость, ДополнительныеРасходы");

КонецФункции

