	Настройка.Записать();
КонецПроцедуры

Функция СтрокаДокументаАРМ(Строки, Документ)
	Для Каждого Строка Из Строки Цикл
		Если Строка.Документ = Документ Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ДвижениеПродукцииДокументаАРМ(Заказ, Документ)
	ДокументыЗаказа = Обработки.АРМПроизводство.ДокументыЗаказа(Заказ);
	Строка = ДокументыЗаказа.Найти(Документ, "Документ");
	Возврат ?(Строка = Неопределено, Неопределено, Строка.ПродукцияЧисло);
КонецФункции

// Правка оформленного ордера - отказ защиты (без записи: проверка ПередЗаписью ордера).
//
// Параметры:
//  Ордер    - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - изменённый ордер
//  Описание - Строка - что проверяется
//
Процедура ПроверитьОтказЗащитыОрдера(Ордер, Описание)
	Отказ = Ложь;
	ОрдераСклада.ПередЗаписьюОрдера(Ордер, Отказ, РежимЗаписиДокумента.Проведение);
	Проверить(Отказ, Описание);
	ПолучитьСообщенияПользователю(Истина);
КонецПроцедуры

// Есть ли среди сообщений пользователя текст отказа: сообщения - на языке сеанса, фрагменты - на всех языках.
//
// Параметры:
//  Фрагменты - Строка - фрагменты текста через «|»
//
// Возвращаемое значение:
//  Булево - Истина, если какое-то сообщение содержит какой-то фрагмент; очередь сообщений очищается.
//
Функция ЕстьСообщениеОтказа(Фрагменты)
	Найдено = Ложь;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Для Каждого Фрагмент Из СтрРазделить(Фрагменты, "|", Ложь) Цикл
			Найдено = Найдено Или СтрНайти(Сообщение.Текст, Фрагмент) > 0;
		КонецЦикла;
	КонецЦикла;
	Возврат Найдено;
КонецФункции

Функция ФрагментыОтказаОформления()
	Возврат "оформлено больше, чем по документу|régularisé au-delà du document|more than the document|más que el documento";
КонецФункции

// Ордерные склады, доработки 2.0.16.81 (docs/plans/warehouse-orders.md, 6.3): «К поступлению» рабочего места закупок на
// ордерном складе - пакет пишет приходный ордер по заказу без номера накладной, строка заказа закрыта, повтор пакета
// отклонён под блокировкой, приход - физика без партий.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладПакетЗакупок(Контекст)

	// BSLLS:MagicNumber-off - заказы на 5 и 3 единицы.
	АРМ = Обработки.АРМЗакупки;
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	УстановитьСкладПользователяСценария(Склад);
	Товар = НоваяНоменклатура(Контекст, "товар пакета на ордерном складе", Перечисления.ТипыНоменклатуры.Товар);
	ЗаказА = ЗаказВводомРабочегоМеста(Контекст, Товар, 5);
	ЗаказБ = ЗаказВводомРабочегоМеста(Контекст, Товар, 3);
	Отборы = АРМ.НовыеОтборы();
	Отборы.Товар = Товар;
	Строки = СтрокиКПоступлениюСценария(АРМ.СтрокиКПоступлению(Отборы));
	ПроверитьРавенство(2, Строки.Количество(), "строк «К поступлению» двух заказов");
	// Ордеру номер накладной не нужен: документ с ценами введёт менеджер при оформлении.
	Накладная = Новый Структура("Номер, Дата", "", НачалоДня(ТекущаяДатаСеанса()));
	Итоги = АРМ.ОформитьПоступления(Строки, Накладная);
	ПроверитьРавенство(2, Итоги.Количество(), "пакет: документ на каждый заказ");
	Для Каждого Итог Из Итоги Цикл
		Проверить(Итог.Успех, "пакет на ордерном складе: " + Итог.Текст);
		Проверить(ТипЗнч(Итог.Документ) = Тип("ДокументСсылка.ПриходныйОрдер"), "пакет на ордерном складе - приходный ордер");
		Проверить(ЗначениеРеквизитаЗапросом(Итог.Документ, "Проведен"), "приходный ордер пакета проведён");
		ПроверитьРавенство(Итог.Заказ, ЗначениеРеквизитаЗапросом(Итог.Документ, "Основание"), "основание ордера - заказ");
		ПроверитьРавенство(Склад, ЗначениеРеквизитаЗапросом(Итог.Документ, "МестоХранения"), "склад ордера пакета");
		Ордер = Итог.Документ.ПолучитьОбъект();
		Для Каждого Строка Из Строки Цикл
			Если Строка.Заказ = Итог.Заказ Тогда
				ПроверитьРавенство(Строка.КодСтроки, Ордер.ТЧТовары[0].КодСтрокиЗаказа, "строка заказа - в КодСтрокиЗаказа");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ПроверитьРавенство(0, АРМ.СтрокиКПоступлению(Отборы).Количество(), "«К поступлению» пусто после пакета ордеров");
	ПроверитьРавенство(8, ФизическийОстаток(Склад, Товар), "физика склада - приход по ордерам");
	ПроверитьРавенство(8, ОстатокПартийСклада(Склад, Товар), "партии ордеров до оформления - 8 по нулевой стоимости");

	Итоги = АРМ.ОформитьПоступления(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Строки[0]), Накладная);
	Проверить(Не Итоги[0].Успех, "повтор пакета по принятой строке отклонён");
	ПроверитьРавенство(1, ПриходныхОрдеровЗаказа(ЗаказА), "приходных ордеров первого заказа после повтора");
	ПроверитьРавенство(1, ПриходныхОрдеровЗаказа(ЗаказБ), "приходных ордеров второго заказа");

	// «Создать» на закладке «Поступления»: склад поступлений пользователя ордерный - приходный ордер, иначе поступление.
	УстановитьСкладПоступленийСценария(Склад);
	ПроверитьРавенство("Документ.ПриходныйОрдер.ФормаОбъекта", АРМ.ИмяФормыНовогоПоступления(),
		"«Создать» на ордерном складе - приходный ордер");
	УстановитьСкладПоступленийСценария(НовыйСклад());
	ПроверитьРавенство("Документ.ПоступлениеТоваровУслуг.ФормаОбъекта", АРМ.ИмяФормыНовогоПоступления(),
		"«Создать» на неордерном складе - поступление");
	// BSLLS:MagicNumber-on
	Возврат РезультатСценария("пакет «К поступлению» на ордерном складе - приходный ордер на заказ без номера накладной, "
		+ "код строки заказа, «К поступлению» пусто, физика и партии ордеров 8; повтор пакета отклонён; «Создать» на "
		+ "«Поступлениях» - приходный ордер на ордерном складе поступлений, поступление на обычном");

КонецФункции

// Подписка ПрежниеПозицииСкладаПередЗаписью покрывает ровно документы, которые удаляют движения автоматически и двигают
// ТоварыВНаличии: новый такой документ вне подписки снова терял бы снятые позиции.
//
Процедура ПроверитьИсточникиПрежнихПозицийСклада()
	Типы = Метаданные.ПодпискиНаСобытия.ПрежниеПозицииСкладаПередЗаписью.Источник.Типы();
	Регистры = Новый Массив;
	Регистры.Добавить(Метаданные.РегистрыНакопления.ТоварыВНаличии);
	Нужных = 0;
	Для Каждого Документ Из Метаданные.Документы Цикл
		Если Документ.УдалениеДвижений <> Метаданные.СвойстваОбъектов.УдалениеДвижений.УдалятьАвтоматически Тогда
			Продолжить;
		КонецЕсли;
		ДвигаетСклад = Документ.Движения.Содержит(Регистры[0]);
		ВПодписке = Типы.Найти(Тип("ДокументОбъект." + Документ.Имя)) <> Неопределено;
		ПроверитьРавенство(ДвигаетСклад, ВПодписке, "подписка ПрежниеПозицииСкладаПередЗаписью, документ " + Документ.Имя);
		Нужных = Нужных + ?(ДвигаетСклад, 1, 0);
	КонецЦикла;
	ПроверитьРавенство(Нужных, Типы.Количество(), "в подписке ПрежниеПозицииСкладаПередЗаписью нет лишних типов");
КонецПроцедуры

Функция ПриходныхОрдеровЗаказа(Заказ)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Ордера.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ПриходныйОрдер КАК Ордера
	|ГДЕ
	|	Ордера.Основание = &Заказ
	|	И НЕ Ордера.ПометкаУдаления");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);
КонецФункции

Функция ОстатокПартийСклада(Склад, Товар)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(, МестоХранения = &Склад И Номенклатура = &Товар) КАК Остатки");
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Товар", Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);
КонецФункции

// Ордерные склады, доработки 2.0.16.81 (docs/plans/warehouse-orders.md, 6.1): перепроведение приходного ордера (движения
// удаляются автоматически) со снятой строкой оповещает о минимуме снятой позиции - её остаток ушёл в ноль.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладМинимум(Контекст)

	// BSLLS:MagicNumber-off - минимум 5, строки ордера по 10.
	Товары = "ТЧТовары";
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	СкладОбъект = Склад.ПолучитьОбъект();
	СкладОбъект.ОповещатьОМинимальномОстатке = Истина;
	СкладОбъект.Записать();
	Остающийся = НоваяНоменклатура(Контекст, "товар ордера, строка остаётся", Перечисления.ТипыНоменклатуры.Товар);
	Снятый = НоваяНоменклатура(Контекст, "товар ордера, строка снята", Перечисления.ТипыНоменклатуры.Товар);
	ТоварОбъект = Снятый.ПолучитьОбъект();
	ТоварОбъект.МинимальноеКоличествоХранения = 5;
	ТоварОбъект.Записать();
	ВключитьОповещениеОМинимуме();

	Ордер = НовыйДокумент(Контекст, "ПриходныйОрдер");
	Ордер.МестоХранения = Склад;
	Ордер.Контрагент = Контекст.Контрагент;
	ДобавитьСтрокуТоваров(Контекст, Ордер, Товары, Остающийся, 10, 0);
	ДобавитьСтрокуТоваров(Контекст, Ордер, Товары, Снятый, 10, 0);
	Провести(Ордер);
	ПроверитьРавенство(0, ОповещенийОМинимуме(Снятый), "минимум: приход 10 - оповещений нет");

	Ордер.ТЧТовары.Удалить(1);
	Провести(Ордер);
	ПроверитьРавенство(0, ФизическийОстаток(Склад, Снятый), "снятая строка: остаток 0");
	ПроверитьРавенство(10, ФизическийОстаток(Склад, Остающийся), "оставшаяся строка: остаток 10");
	ПроверитьРавенство(1, ОповещенийОМинимуме(Снятый), "минимум: перепроведение со снятой строкой - оповещение");

	// Окончательная запись без складских строк: товар реализации заменён услугой, набор движений склада пуст.
	СкладПродажи = НовыйСклад();
	СкладОбъект = СкладПродажи.ПолучитьОбъект();
	СкладОбъект.ОповещатьОМинимальномОстатке = Истина;
	СкладОбъект.Записать();
	Товар = НоваяНоменклатура(Контекст, "товар реализации, заменённый услугой", Перечисления.ТипыНоменклатуры.Товар);
	ТоварОбъект = Товар.ПолучитьОбъект();
	ТоварОбъект.МинимальноеКоличествоХранения = 5;
	ТоварОбъект.Записать();
	Оприходование = НовыйДокумент(Контекст, "ОприходованиеТоваров");
	Оприходование.МестоХранения = СкладПродажи;
	ДобавитьСтрокуТоваров(Контекст, Оприходование, Товары, Товар, 4, 5);
	Провести(Оприходование);
	Оповещений = ОповещенийОМинимуме(Товар);
	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Реализация.МестоХранения = СкладПродажи;
	Реализация.Контрагент = Контекст.Контрагент;
	Реализация.Договор = Контекст.ДоговорПокупателя;
	ДобавитьСтрокуТоваров(Контекст, Реализация, Товары, Товар, 1, 10);
	Провести(Реализация);
	ПроверитьРавенство(Оповещений + 1, ОповещенийОМинимуме(Товар), "минимум: реализация до 3 - оповещение");
	Реализация.ТЧТовары.Очистить();
	Услуга = НоваяНоменклатура(Контекст, "услуга вместо товара реализации", Перечисления.ТипыНоменклатуры.Услуга);
	ДобавитьСтрокуТоваров(Контекст, Реализация, "ТЧУслуги", Услуга, 1, 10);
	Провести(Реализация);
	ПроверитьРавенство(4, ФизическийОстаток(СкладПродажи, Товар), "реализация без товара: остаток 4");
	ПроверитьРавенство(Оповещений + 2, ОповещенийОМинимуме(Товар),
		"минимум: перепроведение без складских строк проверяет прежний товар");
	// BSLLS:MagicNumber-on
	ПроверитьИсточникиПрежнихПозицийСклада();
	Возврат РезультатСценария("перепроведение приходного ордера со снятой строкой: остаток снятой позиции 0, оповещение "
		+ "о минимуме одно; реализация, где товар заменён услугой, проверяет прежний товар; подписка "
		+ "ПрежниеПозицииСкладаПередЗаписью - ровно документы с автоудалением движений склада");

КонецФункции

// Сценарии ордерных складов (docs/plans/warehouse-orders.md, 2.0.16.77 и далее) - своя ветка диспетчера.
//
// Параметры:
//  Имя      - Строка - имя сценария
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныхСкладовПоИмени(Имя, Контекст)

	// Признак ордерности склада записывается только при включённой опции (2.0.16.107); откат раннера вернёт значение.
	Константы.ИспользоватьОрдерныеСклады.Установить(Истина);
	Если Имя = "ОрдерныйСклад" Тогда
		Возврат СценарийОрдерныйСклад(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладСверхОрдера" Тогда
		Возврат СценарийОрдерныйСкладСверхОрдера(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладУменьшение" Тогда
		Возврат СценарийОрдерныйСкладУменьшение(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладОтчеты" Тогда
		Возврат СценарийОрдерныйСкладОтчеты(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладОтчетыМест" Тогда
		Возврат СценарийОрдерныйСкладОтчетыМест(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладАРМ" Тогда
		Возврат СценарийОрдерныйСкладАРМ(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладВключение" Тогда
		Возврат СценарийОрдерныйСкладВключение(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладПакетЗакупок" Тогда
		Возврат СценарийОрдерныйСкладПакетЗакупок(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладМинимум" Тогда
		Возврат СценарийОрдерныйСкладМинимум(Контекст);
	КонецЕсли;
	Возврат СценарийОрдерныхСкладовФазы3(Имя, Контекст);
КонецФункции

// Сценарии ордерных складов v2, фаза 3 (2.0.16.122).
