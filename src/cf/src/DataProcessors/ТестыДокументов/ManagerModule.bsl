Функция ПоступлениеБезОрдера(Контекст, Склад, Товар, Количество, Цена)
	Поступление = НовоеПоступлениеБезОрдера(Контекст, Склад, Товар, Количество, Цена);
	Провести(Поступление);
	Возврат Поступление;
