//
Функция СценарийДокументПервыйВозвратСверх(Контекст)

	// BSLLS:MagicNumber-off
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар возврата сверх отгрузки", Перечисления.ТипыНоменклатуры.Товар);
	ОприходоватьНаСклад(Контекст, Склад, Товар, 10, 5);
	Реализация = РеализацияБезОрдера(Контекст, Склад, Товар, 5);
	ОрдерПоДокументу(Контекст, "РасходныйОрдер", Реализация.Ссылка, 3);
	ДокВозврата = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	ДокВозврата.Заполнить(Реализация.Ссылка);
