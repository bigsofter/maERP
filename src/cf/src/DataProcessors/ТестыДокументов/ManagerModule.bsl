	Касса.МестоХранения = Контекст.Склад;
	Касса.Записать();
	Возврат Касса.Ссылка;

КонецФункции

Функция НовыйБанковскийСчет(Контекст)

	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Владелец = Контекст.Организация;
	Счет.Наименование = ПометкаТеста() + ": счёт";
	Счет.Валюта = Контекст.Валюта;
	// Имена реквизитов справочника - с буквой ё, как в метаданных.
	// BSLLS:YoLetterUsage-off
	Счет.НомерСчёта = "TEST-3";
