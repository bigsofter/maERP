КонецФункции

// Дата следующего документа сценария: на секунду позже предыдущего, а при поле контекста ШагСекунд - на столько секунд.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекстДанных
//
// Возвращаемое значение:
//  Дата - дата документа
//
Функция СледующаяДата(Контекст) Экспорт

	Контекст.Шаг = Контекст.Шаг + ?(Контекст.Свойство("ШагСекунд"), Контекст.ШагСекунд, 1);
	Возврат Контекст.Дата + Контекст.Шаг;

КонецФункции

