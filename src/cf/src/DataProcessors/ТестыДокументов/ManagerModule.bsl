Функция ОстатокТовараУУ(Склад, Номенклатура, УУ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии.Остатки(, МестоХранения = &Склад И Номенклатура = &Номенклатура
		|		И УУ = &УУ) КАК Остатки");
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("УУ", УУ);
	Возврат ПерваяСтрока(Запрос, "Количество").Количество;

КонецФункции

Функция ЕстьДвиженияУУ(Регистратор, ТолькоДеньги = Ложь)

	ТекстДенег =
	"ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Найдено ИЗ РегистрНакопления.ДенежныеСредстваОрганизаций КАК Т
	|ГДЕ Т.Регистратор = &Регистратор И Т.УУ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрНакопления.ДвиженияДенежныхСредств КАК Т ГДЕ Т.Регистратор = &Регистратор И Т.УУ";
	ТекстТоваров =
	"ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Найдено ИЗ РегистрНакопления.ТоварыВНаличии КАК Т ГДЕ Т.Регистратор = &Регистратор И Т.УУ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т ГДЕ Т.Регистратор = &Регистратор И Т.УУ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т ГДЕ Т.Регистратор = &Регистратор И Т.УУ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрНакопления.Продажи КАК Т ГДЕ Т.Регистратор = &Регистратор И Т.УУ";
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.Текст = ТекстДенег;
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТолькоДеньги Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос.Текст = ТекстТоваров;
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция СценарийНалоговогоУчета(Имя, Контекст)

	Если Имя = "РаздельныйУчет" Тогда
		Возврат СценарийРаздельныйУчет(Контекст);
	КонецЕсли;
	Возврат СценарийНалоговыйДокументНаОсновании(Контекст);

