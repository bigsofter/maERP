// Число движений документа в регистре убытков.
//
// Параметры:
//  Документ - ДокументСсылка - регистратор
//
// Возвращаемое значение:
//  Число - строк движений
//
Функция УбыткиДокумента(Документ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Движений
		|ИЗ
		|	РегистрНакопления.Убытки КАК Убытки
		|ГДЕ
		|	Убытки.Регистратор = &Документ");
	Запрос.УстановитьПараметр("Документ", Документ);
	Возврат ПерваяСтрока(Запрос, "Движений").Движений;

КонецФункции

// Фирменный акт передачи в переработку (2.0.16.110) на четырёх языках: заголовок вида, группы переданного и ожидаемого,
// подписи сторон, без незаполненных шаблонов; клиент заказа в шапке, вес и дополнительный реквизит под строкой
// переданного товара (2.0.16.125).
//
// Параметры:
//  Передача - ДокументСсылка.ПередачаВПереработку - проведённая передача с ожидаемой продукцией.
//
Процедура ПроверитьПечатьАктаПередачи(Передача)
	СтрокаТоваров = Передача.ТЧТовары[0];
	Товар = СтрокаТоваров.Номенклатура;
	Параметры = УправлениеСвойствами.ПараметрыДобавленияСвойства();
	Параметры.ИмяОбъекта = "Справочник.Номенклатура";
	Параметры.Имя = "ТестПечатиПередачи";
	Параметры.Наименование = ПометкаТеста() + ": обработка";
	// Заголовок на французском - переводом свойства, на остальных языках - наименованием.
	Параметры.Заголовки.Вставить("fr", ПометкаТеста() + ": traitement");
	Параметры.ТипЗначения = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(ДлинаСтроковогоРеквизита()));
	Свойство = УправлениеСвойствами.ДобавитьСвойство(Параметры);
	ЗначениеСвойства = "ТЕСТ-ОБРАБОТКА";
	УправлениеСвойствами.ЗаписатьЗначениеСвойства(Товар, Свойство, ЗначениеСвойства);
	// Единица товара сценария - штуки: вес единицы печатается строкой «Вес» под товаром.
	КгНаЕдиницу = 0.5;
	Объект = Товар.ПолучитьОбъект();
	Объект.ВесЗнаменатель = КгНаЕдиницу;
	Объект.Записать();
	Вес = СтрокаТоваров.Количество * КгНаЕдиницу;
	Клиент = Строка(Передача.Основание.Контрагент);
	Для Каждого КодЯзыка Из СтрРазделить("ru,fr,en,es", ",") Цикл
		Печать = ПечатьКоманды("ПередачаВПереработку", "АктПередачи", Передача, КодЯзыка);
		Описание = ФирменнаяПечать.ОписаниеВида("BonDeTransfert", КодЯзыка);
		Пояснение = "акт передачи в переработку (" + КодЯзыка + ")";
		ПодписьКлиента = НСтр("ru = 'Клиент'; fr = 'Client'; en = 'Customer'; es = 'Cliente'", КодЯзыка) + ": " + Клиент;
		Проверить(Печать.НайтиТекст(ПодписьКлиента) <> Неопределено, Пояснение + ": клиент заказа «" + ПодписьКлиента + "»");
		СтрокаВеса = НСтр("ru = 'Вес'; fr = 'Poids'; en = 'Weight'; es = 'Peso'", КодЯзыка) + ": "
			+ Формат(Вес, "Л=" + КодЯзыка + "; ЧГ=0") + " " + НСтр("ru = 'кг'; fr = 'kg'; en = 'kg'; es = 'kg'", КодЯзыка);
		Проверить(Печать.НайтиТекст(СтрокаВеса) <> Неопределено, Пояснение + ": вес под строкой «" + СтрокаВеса + "»");
		Заголовок = Параметры.Заголовки[КодЯзыка];
		СтрокаСвойства = ?(Заголовок = Неопределено, Параметры.Наименование, Заголовок) + ": " + ЗначениеСвойства;
		Проверить(Печать.НайтиТекст(СтрокаСвойства) <> Неопределено, Пояснение + ": доп. реквизит под строкой");
		Проверить(Описание.БезЦен, Пояснение + ": вид без цен");
		Проверить(Печать.НайтиТекст(Описание.Заголовок) <> Неопределено, Пояснение + ": заголовок «" + Описание.Заголовок + "»");
		Проверить(Печать.НайтиТекст(Описание.ПодписьПокупателя) <> Неопределено, Пояснение + ": сторона переработчика");
		Проверить(Печать.НайтиТекст(Описание.ПодписьПравая) <> Неопределено, Пояснение + ": подпись получателя");
		ГруппаОжидаемых = НСтр("ru = 'ОЖИДАЕМАЯ ПРОДУКЦИЯ'; fr = 'PRODUITS ATTENDUS'; en = 'EXPECTED PRODUCTS';
			|es = 'PRODUCTOS ESPERADOS'", КодЯзыка);
		Проверить(Печать.НайтиТекст(ГруппаОжидаемых) <> Неопределено, Пояснение + ": группа ожидаемой продукции");
		Проверить(Печать.НайтиТекст("[") = Неопределено, Пояснение + ": незаполненный шаблон «[...]»");
		Проверить(Печать.НайтиТекст("%1") = Неопределено, Пояснение + ": неподставленный «%1»");
	КонецЦикла;

	// Количество строки в весовой упаковке - вес не повторяется под строкой (ревью кода 2.0.16.125, P2).
	Килограмм = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	Килограмм.Наименование = "кг (" + ПометкаТеста() + ")";
	Килограмм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Вес;
	Килограмм.Числитель = 1;
	Килограмм.Знаменатель = 1;
	Килограмм.Записать();
	// Передача нужна сценарию дальше (поступление по ней): после проверки упаковка строки - прежняя.
	Объект = Передача.ПолучитьОбъект();
	УпаковкаСтроки = Объект.ТЧТовары[0].Упаковка;
	Объект.ТЧТовары[0].Упаковка = Килограмм.Ссылка;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Печать = ПечатьКоманды("ПередачаВПереработку", "АктПередачи", Передача, "ru");
	СтрокаВеса = "Вес: " + Формат(Вес, "Л=ru; ЧГ=0") + " кг";
	Проверить(Печать.НайтиТекст(СтрокаВеса) = Неопределено, "акт передачи: весовая упаковка строки - вес не повторяется");
	Объект.ТЧТовары[0].Упаковка = УпаковкаСтроки;
	Объект.Записать();
КонецПроцедуры

// Непроведённая передача сценария с ожидаемой продукцией, посчитанной по дереву заказа.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументСсылка.ЗаказПокупателя - основание передачи
//  Сырье    - Число - сколько сырья передаётся
//
// Возвращаемое значение:
//  ДокументОбъект.ПередачаВПереработку - непроведённая передача
//
Функция ПередачаСценарияПереработки(Контекст, Заказ, Сырье)

	Передача = НовыйДокумент(Контекст, "ПередачаВПереработку");
	Передача.Контрагент = Контекст.Контрагент;
	Передача.Основание = Заказ;
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Контекст.Сырье, Сырье, 0);
	Передача.ЗаполнитьОжидаемуюПродукцию();
	Возврат Передача;

КонецФункции

// Непроведённое поступление, заполненное по передаче.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Передача - ДокументСсылка.ПередачаВПереработку - основание
//
// Возвращаемое значение:
//  ДокументОбъект.ПоступлениеИзПереработки - непроведённое поступление
//
Функция ПоступлениеСценарияПереработки(Контекст, Передача)

	Поступление = НовыйДокумент(Контекст, "ПоступлениеИзПереработки");
	// Дата - ДО заполнения: сырьё считается по остаткам на дату документа (S5-B).
	Поступление.Дата = СледующаяДата(Контекст);
	Поступление.Заполнить(Передача);
	Поступление.Комментарий = ПометкаТеста();
	Поступление.СтавкаНДСУслуг = Контекст.СтавкаНДС;
	Поступление.СуммаНДСУслуг = 0;
	Возврат Поступление;

КонецФункции

// Проведение поступления, которому не хватает сырья своего заказа.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Передача   - ДокументСсылка.ПередачаВПереработку - основание
//  Количество - Число - сколько сырья списывается
//
// Возвращаемое значение:
//  Булево - Истина, если проведение отклонено.
//
Функция ОтказПоступленияСверхЗаказа(Контекст, Передача, Количество)

	Поступление = ПоступлениеСценарияПереработки(Контекст, Передача);
	Поступление.ТЧТовары[0].Количество = Количество;
	Поступление.ТЧТовары[0].КоличествоУпаковок = Количество;
	ПолучитьСообщенияПользователю(Истина);
	Попытка
		Поступление.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		// После исключения в записи транзакция сценария годится только для отката: к базе больше не обращаемся.
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;

КонецФункции

// Остаток сырья сценария у переработчика по конкретному заказу; пустая ссылка - беззаказные партии.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ партий
//
// Возвращаемое значение:
//  Число - количество остатка
//
Функция ОстатокПереработкиПоЗаказу(Контекст, Заказ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыВПереработке.Остатки(
		|			,
		|			Контрагент = &Контрагент
		|				И Номенклатура = &Номенклатура
		|				И ЗаказПокупателя = &Заказ) КАК Остатки");
	Запрос.УстановитьПараметр("Контрагент", Контекст.Контрагент);
	Запрос.УстановитьПараметр("Номенклатура", Контекст.Сырье);
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Возврат ПерваяСтрока(Запрос, "Количество").Количество;

КонецФункции

// Зарплата: начисление даёт остаток по сотруднику, ведомость на выплату заполняется по
// начислению, расходный ордер по ведомости закрывает остаток и списывает деньги из кассы.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийЗарплата(Контекст)

	ДатаНачала = Константы.ДатаНачалаРасчетаЗарплаты.Получить();
	Если Контекст.Дата < ДатаНачала Тогда
		Текст = "дата начала расчёта зарплаты " + Формат(ДатаНачала, "ДЛФ=D")
			+ " позже даты теста - движений по зарплате не будет";
		Возврат РезультатСценария(Текст, Истина);
	КонецЕсли;

	Оклад = Контекст.Числа.Оклад;
	Начисление = НовыйДокумент(Контекст, "НачислениеЗарплаты");
	Строка = Начисление.ТЧСотрудники.Добавить();
	Строка.Сотрудник = Контекст.Сотрудник;
	Строка.Оклад = Оклад;
	Строка.Сумма = Оклад;
	Начисление.Сумма = Оклад;
	Провести(Начисление);
	ПроверитьРавенство(Оклад, ОстатокЗарплаты(Контекст.Сотрудник), "остаток по сотруднику после начисления");

	Выплата = НовыйДокумент(Контекст, "ВыплатаЗарплаты");
	Выплата.Заполнить(Начисление.Ссылка);
	Выплата.Дата = СледующаяДата(Контекст);
	ПроверитьРавенство(Оклад, Выплата.ТЧСотрудники.Итог("Сумма"), "сумма ведомости по начислению");
	Провести(Выплата);

	Ордер = НовыйДокумент(Контекст, "РасходныйКассовыйОрдер");
	Ордер.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплаты;
	Ордер.Основание = Выплата.Ссылка;
	Ордер.Контрагент = Контекст.Сотрудник;
	Ордер.Касса = Контекст.Касса;
	Ордер.ТипОплаты = Справочники.TypesDePayment.Cash;
	Ордер.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ВыплатаЗарплаты;
	Ордер.Сумма = Оклад;
	Провести(Ордер);

	ПроверитьРавенство(0, ОстатокЗарплаты(Контекст.Сотрудник), "остаток по сотруднику после выплаты");
	ПроверитьРавенство(-Оклад, ОстатокДенег(Контекст.Касса), "деньги в кассе после выплаты");

	Текст = "начислено и выплачено " + СтрокаЧисла(Оклад) + ", остаток по сотруднику 0";
	Возврат РезультатСценария(Текст);

КонецФункции

// Безналичные деньги: поступление от покупателя закрывает долг по реализации, списание
// поставщику закрывает долг по поступлению; остаток на счёте - разница.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийБезналичныеДеньги(Контекст)

	Числа = Контекст.Числа;
	Закупка = ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	СуммаЗакупки = Числа.КоличествоЗакупки * Числа.ЦенаЗакупки;
	Реализация = ДокументРеализации(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);
	СуммаПродажи = Числа.КоличествоПродажи * Числа.ЦенаПродажи;

	Поступление = НовыйДокумент(Контекст, "ПоступлениеБезналичныхДенежныхСредств");
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	Поступление.Контрагент = Контекст.Контрагент;
	Поступление.Договор = Контекст.ДоговорПокупателя;
	// BSLLS:YoLetterUsage-off
	Поступление.БанковскийСчёт = Контекст.Счет;
	// BSLLS:YoLetterUsage-on
	Поступление.ТипОплаты = Справочники.TypesDePayment.VirementBanquaire;
	Поступление.СтатьяДДС = СтатьяДДС(Контекст, Поступление.ХозяйственнаяОперация);
	Поступление.Сумма = СуммаПродажи;
	ДобавитьОснование(Поступление, Реализация, СуммаПродажи);
	Провести(Поступление);

	ПроверитьДолгПокупателя(Реализация, 0, "долг покупателя после безналичной оплаты");
	ПроверитьРавенство(СуммаПродажи, ОстатокДенег(Контекст.Счет), "деньги на счёте после поступления");

	Списание = НовыйДокумент(Контекст, "СписаниеБезналичныхДенежныхСредств");
	Списание.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	Списание.Контрагент = Контекст.Контрагент;
	Списание.Договор = Контекст.ДоговорПоставщика;
	// BSLLS:YoLetterUsage-off
	Списание.БанковскийСчёт = Контекст.Счет;
	// BSLLS:YoLetterUsage-on
	Списание.ТипОплаты = Справочники.TypesDePayment.VirementBanquaire;
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Списание.ХозяйственнаяОперация);
	Списание.Валюта = Контекст.Валюта;
	Списание.Сумма = СуммаЗакупки;
	Списание.СуммаВВалютеРеглУчета = СуммаЗакупки;
	ДобавитьОснование(Списание, Закупка, СуммаЗакупки);
	Провести(Списание);

	ПроверитьДолгПоставщику(Закупка, 0, "долг поставщику после безналичной оплаты");
	ПроверитьРавенство(СуммаПродажи - СуммаЗакупки, ОстатокДенег(Контекст.Счет), "деньги на счёте после списания");

	Текст = "получено " + СтрокаЧисла(СуммаПродажи) + ", уплачено " + СтрокаЧисла(СуммаЗакупки)
		+ ", оба долга закрыты, на счёте " + СтрокаЧисла(СуммаПродажи - СуммаЗакупки);
	Возврат РезультатСценария(Текст);

КонецФункции

// Дополнительные реквизиты (УправлениеСвойствами): реквизит и сведение заводятся
// идемпотентно, значение реквизита живёт в табличной части объекта, сведения - в регистре,
// оба читаются по имени.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДополнительныеРеквизиты(Контекст)

	ИмяОбъекта = "Справочник.Номенклатура";
	ИмяРеквизита = "ТестУровня3";
	ИмяСведения = "ТестУровня3Сведение";

	Параметры = УправлениеСвойствами.ПараметрыДобавленияСвойства();
	Параметры.ИмяОбъекта = ИмяОбъекта;
	Параметры.Имя = ИмяРеквизита;
	Параметры.Наименование = ПометкаТеста();
	Параметры.ТипЗначения = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(ДлинаСтроковогоРеквизита()));
	Параметры.Заголовки.Вставить("fr", "Test niveau 3");
	Реквизит = УправлениеСвойствами.ДобавитьСвойство(Параметры);
	Проверить(ЗначениеЗаполнено(Реквизит), "дополнительный реквизит не создан");
	Повтор = УправлениеСвойствами.ДобавитьСвойство(Параметры);
	ПроверитьРавенство(Реквизит, Повтор, "повторное добавление реквизита");
	Найденный = УправлениеСвойствами.НайтиСвойство(ИмяОбъекта, ИмяРеквизита);
	ПроверитьРавенство(Реквизит, Найденный, "поиск реквизита по имени");

	Параметры.Имя = ИмяСведения;
	Параметры.ЭтоСведение = Истина;
	Параметры.ТипЗначения = Новый ОписаниеТипов("Число");
	Сведение = УправлениеСвойствами.ДобавитьСвойство(Параметры);
	Проверить(ЗначениеЗаполнено(Сведение) И Сведение <> Реквизит, "дополнительное сведение не создано");

	ЗначениеРеквизита = "Значение уровня 3";
	ЗначениеСведения = Контекст.Числа.ЦенаПродажи;

	Товар = Контекст.Товар.ПолучитьОбъект();
	Строка = Товар.ДополнительныеРеквизиты.Добавить();
	Строка.Свойство = Реквизит;
	Строка.Значение = ЗначениеРеквизита;
	Товар.Записать();

	Запись = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	Запись.Объект = Контекст.Товар;
	Запись.Свойство = Сведение;
	Запись.Значение = ЗначениеСведения;
	Запись.Записать();

	Прочитано = УправлениеСвойствами.ЗначениеСвойства(Контекст.Товар, ИмяРеквизита);
	ПроверитьРавенство(ЗначениеРеквизита, Прочитано, "значение реквизита из табличной части");
	Прочитано = УправлениеСвойствами.ЗначениеСвойства(Контекст.Товар, ИмяСведения);
	ПроверитьРавенство(ЗначениеСведения, Прочитано, "значение сведения из регистра");
	Прочитано = УправлениеСвойствами.ЗначениеСвойства(Контекст.Товар, "НетТакогоРеквизита");
	ПроверитьРавенство(Неопределено, Прочитано, "значение несуществующего реквизита");

	Возврат РезультатСценария("реквизит и сведение заведены идемпотентно, значения читаются по имени");

КонецФункции

// Отрасль: применение «Строительства» ставит константу и заводит реквизиты объекта
// недвижимости у номенклатуры, повтор ничего не создаёт, другая отрасль реквизитов не добавляет.
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОтрасль()

	ИмяОбъекта = "Справочник.Номенклатура";
	Имена = ИменаРеквизитовСтроительства();

	Было = 0;
	Для Каждого Имя Из Имена Цикл
		Если ЗначениеЗаполнено(УправлениеСвойствами.НайтиСвойство(ИмяОбъекта, Имя)) Тогда
			Было = Было + 1;
		КонецЕсли;
	КонецЦикла;

	// Модуль привилегированный: отрасль ставится от имени администратора при первом запуске,
	// тест проверяет тот же метод в своей транзакции.
	// BSLLS:PrivilegedModuleMethodCall-off
	Строительство = Перечисления.Отрасли.Строительство;
	Создано = НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(Строительство);
	ПроверитьРавенство(Имена.Количество() - Было, Создано, "создано реквизитов строительства");
	Отрасль = Константы.Отрасль.Получить();
	ПроверитьРавенство(Строительство, Отрасль, "константа Отрасль");
	Для Каждого Имя Из Имена Цикл
		Свойство = УправлениеСвойствами.НайтиСвойство(ИмяОбъекта, Имя);
		Проверить(ЗначениеЗаполнено(Свойство), "после применения отрасли нет реквизита " + Имя);
	КонецЦикла;

	Повтор = НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(Строительство);
	ПроверитьРавенство(0, Повтор, "создано реквизитов при повторном применении");

	// Ткани: свойства ткани только при производстве; без него - предупреждение и ничего не создаётся.
	Ткани = Перечисления.Отрасли.Ткани;
	БылоПроизводство = Константы.ИспользоватьПроизводство.Получить();
	Константы.ИспользоватьПроизводство.Установить(Ложь);
	ПроверитьРавенство(0, НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(Ткани), "ткани без производства свойств не заводят");
	Проверить(Не ПустаяСтрока(НачальноеЗаполнениеВызовСервера.ПредупреждениеОтрасли(Ткани)),
		"ткани без производства - предупреждение");
	Константы.ИспользоватьПроизводство.Установить(Истина);
	НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(Ткани);
	Для Каждого Имя Из СтрРазделить("Материал,Цвет,Ширина,ТипОбработки", ",") Цикл
		Проверить(ЗначениеЗаполнено(УправлениеСвойствами.НайтиСвойство(ИмяОбъекта, Имя)),
			"ткани при производстве: нет свойства " + Имя);
	КонецЦикла;
	ПроверитьРавенство("", НачальноеЗаполнениеВызовСервера.ПредупреждениеОтрасли(Ткани), "ткани при производстве - без предупреждения");
	Константы.ИспользоватьПроизводство.Установить(БылоПроизводство);

	Торговля = Перечисления.Отрасли.Торговля;
	СозданоДляТорговли = НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(Торговля);
	ПроверитьРавенство(0, СозданоДляТорговли, "создано реквизитов для торговли");
	// BSLLS:PrivilegedModuleMethodCall-on
	Отрасль = Константы.Отрасль.Получить();
	ПроверитьРавенство(Торговля, Отрасль, "константа Отрасль после торговли");

	Текст = "строительство: создано " + СтрокаЧисла(Создано) + " из " + СтрокаЧисла(Имена.Количество())
		+ " реквизитов, повтор 0; ткани: без производства 0 и предупреждение, при производстве 4 свойства; торговля: 0";
	Возврат РезультатСценария(Текст);

КонецФункции

// Панель настроек: запись константы модулем менеджера, признак расположения ФО,
// имя константы по пути данных, список часовых поясов, заголовок окна.
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийНастройкиПрограммы()

	Новое = ПометкаТеста();
	ЭтоОпция = Обработки.НастройкиПрограммы.ЗаписатьКонстанту("ЗаголовокСистемы", Новое);
	ПроверитьРавенство(Ложь, ЭтоОпция, "ЗаголовокСистемы как расположение функциональной опции");
	Записано = Константы.ЗаголовокСистемы.Получить();
	ПроверитьРавенство(Новое, Записано, "значение константы после записи");

	ЭтоОпция = Обработки.НастройкиПрограммы.ЭтоРасположениеФункциональнойОпции("Бухгалтерия");
	ПроверитьРавенство(Истина, ЭтоОпция, "Бухгалтерия как расположение функциональной опции");

	ИмяКонстанты = Обработки.НастройкиПрограммы.ИмяКонстантыПоПутиДанных("НаборКонстант.ЗаголовокСистемы");
	ПроверитьРавенство("ЗаголовокСистемы", ИмяКонстанты, "имя константы по пути данных");

	Варианты = Обработки.НастройкиПрограммы.ВариантыЧасовыхПоясов();
	Проверить(Варианты.Количество() > 0, "список часовых поясов пуст");
	Текущий = Обработки.НастройкиПрограммы.ТекущийЧасовойПояс();
	// У машины без канонического имени зоны платформа отдаёт сырое смещение («+00», «-03:30»).
	// В ПолучитьДопустимыеЧасовыеПояса() таких строк нет по определению, поэтому искать их в
	// списке бессмысленно: проверяем принадлежность списку только для имени зоны.
	Если ЭтоСмещениеЧасовогоПояса(Текущий) Тогда
		Проверить(Варианты.НайтиПоЗначению(Текущий) = Неопределено,
			"смещение " + Текущий + " не должно совпадать с именем зоны");
	Иначе
		Проверить(Варианты.НайтиПоЗначению(Текущий) <> Неопределено, "текущий часовой пояс " + Текущий + " не в списке");
	КонецЕсли;

	Заголовок = Обработки.НастройкиПрограммы.ЗаголовокОкнаПрограммы();
	Проверить(СтрНайти(Заголовок, Новое) > 0, "заголовок окна не содержит заголовок системы");

	Текст = "константа записана и прочитана, признак ФО верен, часовых поясов " + СтрокаЧисла(Варианты.Количество())
		+ ", текущий " + Текущий;
	Возврат РезультатСценария(Текст);

КонецФункции

// Имена дополнительных реквизитов номенклатуры, которые заводит отрасль «Строительство»
// (НачальноеЗаполнениеВызовСервера.ОтраслевыеРеквизитыСтроительства).
//
// Возвращаемое значение:
//  Массив из Строка - имена реквизитов
//
Функция ИменаРеквизитовСтроительства()

	Имена = Новый Массив;
	Имена.Добавить("ОбъектНедвижимости");
	Имена.Добавить("Этаж");
	Имена.Добавить("Площадь");
	Имена.Добавить("НомерПраваСобственности");
	Возврат Имена;

КонецФункции

#КонецОбласти

#Область ТехнологическиеКарты

// Числа здесь - независимые входные данные и ожидаемые результаты сценариев.
// BSLLS:MagicNumber-off

// История рецептуры: удалённые материалы не возвращаются из прежних версий.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТехнологическиеКарты(Контекст)

	Продукция = НоваяНоменклатура(Контекст, "история карты", Перечисления.ТипыНоменклатуры.Продукция);
	ДатаПервой = Дата(2020, 1, 1);
	ДатаВторой = Дата(2020, 1, 2);
	ДатаОтмены = Дата(2020, 1, 3);
	Состав = СоставКарты(Контекст);
	Строка = Состав.Добавить();
	Строка.Номенклатура = Контекст.Товар;
	Строка.Упаковка = Контекст.Единица;
	Строка.Количество = 3;
	Первая = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ДатаПервой);
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаПервой - 1).Количество(),
		"до первой версии карты нет");
	ПроверитьРавенство(2, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаПервой).Количество(),
		"первая версия содержит оба материала");
	Состав.Сортировать("Номенклатура Убыв");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Первая, Состав), "перестановка строк не меняет состав");

	Состав = СоставКарты(Контекст);
	Состав[0].Количество = 4;
	Вторая = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ДатаВторой);
	Проверить(Первая <> Вторая, "другой день создаёт новую версию");
	ПроверитьРавенство(2, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаВторой - 1).Количество(),
		"до второй версии остаётся прежний состав");
	Актуальный = ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаВторой);
	ПроверитьРавенство(1, Актуальный.Количество(), "удалённый материал не примешивается во вторую версию");
	ПроверитьРавенство(Контекст.Сырье, Актуальный[0].Номенклатура, "оставшийся материал второй версии");
	ПроверитьРавенство(4, Актуальный[0].Количество, "расход второй версии");

	Состав[0].Количество = 6;
	Повторная = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ДатаВторой);
	ПроверитьРавенство(Вторая, Повторная, "правка в тот же день перезаписывает документ");
	ПроверитьРавенство(2, КоличествоДокументовТехкарт(Продукция), "повторная запись не создаёт дубль");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Вторая, Состав), "сохранённый состав не требует записи");

	ПродукцияВыпуска = Новый ТаблицаЗначений;
	ПродукцияВыпуска.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПродукцияВыпуска.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число"));
	Строка = ПродукцияВыпуска.Добавить();
	Строка.Номенклатура = Продукция;
	Строка.КоличествоУпаковок = 2;
	Материалы = ТехнологическиеКарты.ЗаполнитьМатериалыПоТехкартам(ПродукцияВыпуска, ДатаВторой);
	ПроверитьРавенство(1, Материалы.Количество(), "заполнение выпуска не возвращает удалённый материал");
	ПроверитьРавенство(12, Материалы[0].КоличествоУпаковок, "расход на две единицы продукции");
	ОжидаемаяУпаковка = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку"), Контекст.Единица,
		Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	ПроверитьРавенство(ОжидаемаяУпаковка, Материалы[0].Упаковка, "упаковка подчиняется функциональной опции");

	Набор = Новый Массив;
	Набор.Добавить(Продукция);
	Набор.Добавить(Контекст.Товар);
	Веса = ТехнологическиеКарты.КоэффициентыТехкарт(Набор, ДатаВторой);
	ПроверитьРавенство(1, Веса[Продукция], "при отсутствии одной карты все веса равны единице");
	ПроверитьРавенство(1, Веса[Контекст.Товар], "вес продукции без карты");

	Отмена = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Неопределено, ДатаОтмены);
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаОтмены).Количество(),
		"отмена не возвращает прежнюю рецептуру");
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкартыПоРегистратору(Отмена).Количество(),
		"маркер отмены не попадает в материалы");
	Версия = ТехнологическиеКарты.ТекущиеТехкарты(Продукция, ДатаОтмены).Получить(Продукция);
	ПроверитьРавенство(Отмена, Версия.Версия, "маркер остаётся действующей версией");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Отмена, Неопределено), "пустой состав не требует новой отмены");
	ПроверитьРавенство(0,
		ТехнологическиеКарты.ЗаполнитьМатериалыПоТехкартам(ПродукцияВыпуска, ДатаОтмены).Количество(),
		"отменённая карта не заполняет выпуск");
	ПроверитьРавенство(1, ТехнологическиеКарты.КоэффициентыТехкарт(Продукция, ДатаОтмены).Получить(Продукция),
		"отменённая карта даёт единичный вес");
	ПроверитьРавенство(6, ТехнологическиеКарты.КоэффициентыТехкарт(Продукция, ДатаВторой).Получить(Продукция),
		"отмена не меняет исторический вес");

	Возврат РезультатСценария("границы дат, удаление материала, перезапись дня, заполнение выпуска, веса и отмена карты");

КонецФункции

// Способ строки карты при смене материала (ТехнологическиеКарты.СпособПриСменеМатериала, 2.0.16.103): умолчания
// «Закупка»/«Наше производство» и пустой заменяются умолчанием нового материала, выбор «Переработчик»/«Оба» сохраняется.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьСменуМатериалаКарты(Контекст)

	Способы = Перечисления.СпособыИзготовления;
	ПФ = НовыйПолуфабрикатСценария(Контекст, "ПФ смены материала");
	Карты = ТехнологическиеКарты;
	ПроверитьРавенство(Способы.Закупка, Карты.СпособИзготовленияПоУмолчанию(Контекст.Сырье), "умолчание сырья - «Закупка»");
	ПроверитьРавенство(Способы.НашеПроизводство, Карты.СпособИзготовленияПоУмолчанию(ПФ),
		"умолчание производимого ПФ - «Наше производство»");
	ПроверитьРавенство(Способы.НашеПроизводство, Карты.СпособПриСменеМатериала(Способы.Закупка, ПФ),
		"сырьё сменили на ПФ - «Закупка» сменилась на «Наше производство»");
	ПроверитьРавенство(Способы.Закупка, Карты.СпособПриСменеМатериала(Способы.НашеПроизводство, Контекст.Сырье),
		"ПФ сменили на сырьё - умолчание «Закупка»");
	ПроверитьРавенство(Способы.Закупка, Карты.СпособПриСменеМатериала(Способы.ПустаяСсылка(), Контекст.Сырье),
		"пустой способ - умолчание нового материала");
	ПроверитьРавенство(Способы.Переработчик, Карты.СпособПриСменеМатериала(Способы.Переработчик, Контекст.Сырье),
		"выбор «Переработчик» сохраняется");
	ПроверитьРавенство(Способы.Оба, Карты.СпособПриСменеМатериала(Способы.Оба, ПФ), "выбор «Оба» сохраняется");

КонецПроцедуры

// Способ изготовления и процент потерь строки состава: запись через документ, свёртка одинаковых строк,
// отказ при расхождении значений у одного материала, умолчание объекта карты и обработчик обновления.
// Перезапись карты проведением заказа проверяется в сценарии «Продажа»
// (ПроверитьРегистрациюТехкарты): там заказ и его материалы уже собраны.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСпособИзготовленияТехкарты(Контекст)

	Продукция = НоваяНоменклатура(Контекст, "способ изготовления", Перечисления.ТипыНоменклатуры.Продукция);
	Переработчик = Перечисления.СпособыИзготовления.Переработчик;
	НашеПроизводство = Перечисления.СпособыИзготовления.НашеПроизводство;

	// Запись через документ карты: значения доходят до движений.
	Карта = Документы.ТехнологическаяКарта.СоздатьДокумент();
	Карта.Заполнить(Неопределено);
	Карта.Дата = Дата(2020, 2, 1);
	Карта.Номенклатура = Продукция;
	ДобавитьМатериалКарты(Контекст, Карта, Контекст.Сырье, 2, Переработчик, 5);
	Карта.Записать(РежимЗаписиДокумента.Проведение);
	Состав = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Карта.Ссылка);
	ПроверитьРавенство(1, Состав.Количество(), "карта записана одной строкой");
	ПроверитьРавенство(Переработчик, Состав[0].СпособИзготовления, "способ изготовления дошёл до движений");
	ПроверитьРавенство(5, Состав[0].ПроцентПотерь, "процент потерь дошёл до движений");

	// Свёртка: две строки одного материала с одинаковыми значениями складываются, значения сохраняются.
	ДобавитьМатериалКарты(Контекст, Карта, Контекст.Сырье, 3, Переработчик, 5);
	Карта.Записать(РежимЗаписиДокумента.Проведение);
	Состав = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Карта.Ссылка);
	ПроверитьРавенство(1, Состав.Количество(), "одинаковые строки материала свёрнуты в одну");
	ПроверитьРавенство(5, Состав[0].Количество, "количество свёрнутых строк сложилось");
	ПроверитьРавенство(Переработчик, Состав[0].СпособИзготовления, "свёртка сохраняет способ изготовления");
	ПроверитьРавенство(5, Состав[0].ПроцентПотерь, "свёртка сохраняет процент потерь");

	// Пустой способ во второй строке - не расхождение: умолчание сделает обе строки одинаковыми.
	// Проверка заполнения идёт до ПередЗаписью, поэтому сравнивать «как введено» нельзя.
	// Обе строки очищаются намеренно: строки пришли сюда с «Переработчиком», и очистка только второй
	// давала бы пару «Переработчик + умолчание» - это конфликт, и ровно его ждёт проверка ниже.
	// Сценарий с S1 очищал одну строку и падал; поймано первым же прогоном уровня 3 после починки
	// лицензии (2026-09-20).
	Карта.ТЧМатериалы[0].СпособИзготовления = Перечисления.СпособыИзготовления.ПустаяСсылка();
	Карта.ТЧМатериалы[1].СпособИзготовления = Перечисления.СпособыИзготовления.ПустаяСсылка();
	ПроверитьРавенство(0, ТехнологическиеКарты.КонфликтыСвойствИзготовления(Карта.ТЧМатериалы).Количество(),
		"пустой способ рядом с умолчанием - не конфликт");
	// Умолчание - по номенклатуре (2.0.16.103): закупаемому материалу - «Закупка», производимому - «Наше производство».
	Карта.ТЧМатериалы[0].СпособИзготовления =
		ТехнологическиеКарты.СпособИзготовленияПоУмолчанию(Карта.ТЧМатериалы[0].Номенклатура);
	ПроверитьРавенство(0, ТехнологическиеКарты.КонфликтыСвойствИзготовления(Карта.ТЧМатериалы).Количество(),
		"пустой способ равен явному умолчанию по номенклатуре");
	Карта.ТЧМатериалы[0].СпособИзготовления = Переработчик;
	Проверить(ТехнологическиеКарты.КонфликтыСвойствИзготовления(Карта.ТЧМатериалы).Количество() > 0,
		"пустой способ рядом с переработчиком - конфликт: умолчание их не сравняет");
	Карта.ТЧМатериалы[1].СпособИзготовления = Переработчик;

	// Расхождение значений у одного материала: отказ, а не молчаливая потеря второй строки.
	Карта.ТЧМатериалы[1].ПроцентПотерь = 7;
	Проверить(ТехнологическиеКарты.КонфликтыСвойствИзготовления(Карта.ТЧМатериалы).Количество() > 0,
		"разные проценты у одного материала - конфликт");
	Проверить(Не Карта.ПроверитьЗаполнение(), "карта с разными процентами у одного материала не записывается");
	Карта.ТЧМатериалы[1].ПроцентПотерь = 5;
	Карта.ТЧМатериалы[1].СпособИзготовления = НашеПроизводство;
	Проверить(Не Карта.ПроверитьЗаполнение(), "карта с разными способами у одного материала не записывается");
	Карта.ТЧМатериалы.Удалить(Карта.ТЧМатериалы[1]);
	Карта.ТЧМатериалы[0].ПроцентПотерь = -1;
	Проверить(Не Карта.ПроверитьЗаполнение(), "отрицательный процент потерь не записывается");
	Карта.ТЧМатериалы[0].ПроцентПотерь = 5;

	// Умолчание ставит сам объект карты: пустой способ мимо фасада в движения не уходит. Сырьё закупается -
	// умолчание «Закупка» (2.0.16.103).
	Закупка = Перечисления.СпособыИзготовления.Закупка;
	Карта.ТЧМатериалы[0].СпособИзготовления = Перечисления.СпособыИзготовления.ПустаяСсылка();
	Карта.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(Закупка, Карта.ТЧМатериалы[0].СпособИзготовления,
		"пустой способ заменяется умолчанием по номенклатуре при записи карты");
	ПроверитьРавенство(Закупка,
		ТехнологическиеКарты.СоставТехкартыПоРегистратору(Карта.Ссылка)[0].СпособИзготовления,
		"умолчание дошло до движений");
	ПроверитьСменуМатериалаКарты(Контекст);

	ПроверитьСверкуСвойствИзготовления(Контекст, Продукция, Карта.Ссылка);
	ПроверитьПереносСвойствИзготовления(Контекст, Карта.Ссылка);
	ПроверитьОбработчикСпособовИзготовления(Контекст, Продукция);

	Возврат РезультатСценария("запись через документ, свёртка, отказ при расхождении, умолчание объекта по номенклатуре "
		+ "(сырьё - «Закупка»), смена материала строки, сверка, перенос и обработчик");

КонецФункции

// Перенос значений из базовой версии карты в состав заказа: это он не даёт проведению заказа обнулить
// способ и процент, когда состав разошёлся. Материал, которого в базовой версии нет, значений не получает -
// умолчание ему поставит сам документ карты.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Версия   - ДокументСсылка.ТехнологическаяКарта - базовая версия карты
//
Процедура ПроверитьПереносСвойствИзготовления(Контекст, Версия)

	// Таблица собирается по тем же колонкам, что кладёт ЗаказПокупателя.НормализованныйСостав.
	Состав = НовыйСоставПереноса();
	Строка = Состав.Добавить();
	Строка.Номенклатура = Контекст.Сырье;
	Строка = Состав.Добавить();
	Строка.Номенклатура = Контекст.Товар;

	Документы.ЗаказПокупателя.ПеренестиСвойстваИзготовленияКарты(Состав, Версия);
	// В версии у сырья - умолчание по номенклатуре «Закупка» (2.0.16.103).
	ПроверитьРавенство(Перечисления.СпособыИзготовления.Закупка, Состав[0].СпособИзготовления,
		"материал базовой версии получает её способ изготовления");
	ПроверитьРавенство(5, Состав[0].ПроцентПотерь, "материал базовой версии получает её процент потерь");
	Проверить(Не ЗначениеЗаполнено(Состав[1].СпособИзготовления),
		"материала нет в базовой версии - способ не переносится, умолчание поставит документ карты");
	ПроверитьРавенство(0, Состав[1].ПроцентПотерь, "материала нет в базовой версии - процент остаётся нулём");

	ПустаяВерсия = Документы.ТехнологическаяКарта.ПустаяСсылка();
	Документы.ЗаказПокупателя.ПеренестиСвойстваИзготовленияКарты(Состав, ПустаяВерсия);
	ПроверитьРавенство(Перечисления.СпособыИзготовления.Закупка, Состав[0].СпособИзготовления,
		"пустая базовая версия ничего не переносит и ничего не затирает");

КонецПроцедуры

// Таблица состава продукции с колонками, которые кладёт ЗаказПокупателя.НормализованныйСостав.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Упаковка, Количество, СпособИзготовления, ПроцентПотерь.
//
Функция НовыйСоставПереноса()

	Состав = Новый ТаблицаЗначений;
	Состав.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Состав.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Состав.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Состав.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Состав.Колонки.Добавить("СпособИзготовления", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыИзготовления"));
	Состав.Колонки.Добавить("ПроцентПотерь", Метаданные.ОпределяемыеТипы.Процент.Тип);
	Возврат Состав;

КонецФункции

// Сверка «сменился только способ или процент» - отдельная от ключа состава: ключ общий со сверкой состава
// заказа на производство, у строк которого этих полей нет.
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Продукция - СправочникСсылка.Номенклатура - продукция карты
//  Версия    - ДокументСсылка.ТехнологическаяКарта - записанная версия карты
//
Процедура ПроверитьСверкуСвойствИзготовления(Контекст, Продукция, Версия)

	Состав = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Версия);
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Версия, Состав), "записанный состав не отличается");
	Проверить(Не ТехнологическиеКарты.СвойстваИзготовленияОтличаются(Версия, Состав),
		"записанные способ и процент не отличаются");
	Состав[0].ПроцентПотерь = Состав[0].ПроцентПотерь + 1;
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Версия, Состав),
		"смена процента не меняет ключ состава: ключ общий со сверкой состава заказа");
	Проверить(ТехнологическиеКарты.СвойстваИзготовленияОтличаются(Версия, Состав),
		"смена процента видна отдельной сверке");
	Состав[0].ПроцентПотерь = Состав[0].ПроцентПотерь - 1;
	Состав[0].СпособИзготовления = Перечисления.СпособыИзготовления.Оба;
	Проверить(ТехнологическиеКарты.СвойстваИзготовленияОтличаются(Версия, Состав),
		"смена способа видна отдельной сверке");
	Состав[0].Номенклатура = Контекст.Товар;
	Проверить(Не ТехнологическиеКарты.СвойстваИзготовленияОтличаются(Версия, Состав),
		"материала нет в версии - это не отличие способа, а другой состав");

КонецПроцедуры

// Обработчик обновления правит и документ, и движения: только регистра мало - первое же перепроведение
// старой карты вернуло бы в движения пустое значение из табличной части документа.
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Продукция - СправочникСсылка.Номенклатура - продукция карты
//
Процедура ПроверитьОбработчикСпособовИзготовления(Контекст, Продукция)

	Карта = Документы.ТехнологическаяКарта.СоздатьДокумент();
	Карта.Заполнить(Неопределено);
	Карта.Дата = Дата(2020, 2, 2);
	Карта.Номенклатура = Продукция;
	ДобавитьМатериалКарты(Контекст, Карта, Контекст.Сырье, 4,
		Перечисления.СпособыИзготовления.НашеПроизводство, 0);
	Карта.Записать(РежимЗаписиДокумента.Проведение);
	Ссылка = Карта.Ссылка;
	// Карта клиента до обновления: способ пуст и в табличной части, и в движениях. Воспроизводится записью
	// в режиме загрузки - она обходит и ПередЗаписью, и проведение, поэтому движения правятся отдельно.
	Объект = Ссылка.ПолучитьОбъект();
	Объект.ТЧМатериалы[0].СпособИзготовления = Перечисления.СпособыИзготовления.ПустаяСсылка();
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	НаборЗаписей = РегистрыСведений.СоставТехКарты.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
	НаборЗаписей.Прочитать();
	НаборЗаписей[0].СпособИзготовления = Перечисления.СпособыИзготовления.ПустаяСсылка();
	НаборЗаписей.ОбменДанными.Загрузка = Истина;
	НаборЗаписей.Записать();
	СпособВДвижениях = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Ссылка)[0].СпособИзготовления;
	Проверить(Не ЗначениеЗаполнено(СпособВДвижениях), "до обновления способ в движениях пуст");
	СпособВДокументе = Ссылка.ПолучитьОбъект().ТЧМатериалы[0].СпособИзготовления;
	Проверить(Не ЗначениеЗаполнено(СпособВДокументе), "до обновления способ в табличной части пуст");

	// Умолчание обработчика - по номенклатуре (2.0.16.103): сырьё - «Закупка».
	ОбновлениеПрограммыОбработчики.ЗаполнитьСпособыИзготовленияТехкарт();
	ПроверитьРавенство(Перечисления.СпособыИзготовления.Закупка,
		Ссылка.ПолучитьОбъект().ТЧМатериалы[0].СпособИзготовления,
		"обработчик обновления заполнил табличную часть документа");
	ПроверитьРавенство(Перечисления.СпособыИзготовления.Закупка,
		ТехнологическиеКарты.СоставТехкартыПоРегистратору(Ссылка)[0].СпособИзготовления,
		"обработчик обновления заполнил движения");
	ПроверитьОбработчикСпособаЗакупка(Контекст, Ссылка);

	// Повтор проверяется на значении, которое обработчик ставить не должен: сверка с «нашим производством»
	// прошла бы и у обработчика, затирающего выбор клиента.
	Объект = Ссылка.ПолучитьОбъект();
	Объект.ТЧМатериалы[0].СпособИзготовления = Перечисления.СпособыИзготовления.Переработчик;
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	ОбновлениеПрограммыОбработчики.ЗаполнитьСпособыИзготовленияТехкарт();
	ПроверитьРавенство(Перечисления.СпособыИзготовления.Переработчик,
		Ссылка.ПолучитьОбъект().ТЧМатериалы[0].СпособИзготовления,
		"повторный запуск не затирает выбор пользователя в документе");
	ПроверитьРавенство(Перечисления.СпособыИзготовления.Переработчик,
		ТехнологическиеКарты.СоставТехкартыПоРегистратору(Ссылка)[0].СпособИзготовления,
		"повторный запуск не затирает выбор пользователя в движениях");

КонецПроцедуры

// Обработчик 2.0.16.103 (УстановитьСпособЗакупкаМатериаловТехкарт): «Наше производство» у закупаемого сырья - в
// «Закупка» и в документе, и в движениях; производимый ПФ и «Переработчик» не трогаются; повтор ничего не пишет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Ссылка   - ДокументСсылка.ТехнологическаяКарта - карта с сырьём первой строкой.
//
Процедура ПроверитьОбработчикСпособаЗакупка(Контекст, Ссылка)

	Способы = Перечисления.СпособыИзготовления;
	ПФ = НовыйПолуфабрикатСценария(Контекст, "ПФ обработчика закупки");
	// Карта до обновления: сырьё и ПФ с «нашим производством» - как ставил прежний умолчательный обработчик.
	Объект = Ссылка.ПолучитьОбъект();
	Объект.ТЧМатериалы[0].СпособИзготовления = Способы.НашеПроизводство;
	ДобавитьМатериалКарты(Контекст, Объект, ПФ, 1, Способы.НашеПроизводство, 0);
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	ПолеПоиска = "Номенклатура";
	СоставДо = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Ссылка);
	ПроверитьРавенство(Способы.НашеПроизводство, СоставДо.Найти(Контекст.Сырье, ПолеПоиска).СпособИзготовления,
		"до обработчика у сырья «наше производство»");

	ОбновлениеПрограммыОбработчики.УстановитьСпособЗакупкаМатериаловТехкарт();
	Объект = Ссылка.ПолучитьОбъект();
	Состав = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Ссылка);
	// BSLLS:UsingHardcodeNetworkAddress-off - номер версии конфигурации, а не адрес.
	ПроверитьРавенство(Способы.Закупка, Объект.ТЧМатериалы.Найти(Контекст.Сырье, ПолеПоиска).СпособИзготовления,
		"обработчик 2.0.16.103: сырьё в документе - «Закупка»");
	ПроверитьРавенство(Способы.Закупка, Состав.Найти(Контекст.Сырье, ПолеПоиска).СпособИзготовления,
		"обработчик 2.0.16.103: сырьё в движениях - «Закупка»");
	ПроверитьРавенство(Способы.НашеПроизводство, Состав.Найти(ПФ, ПолеПоиска).СпособИзготовления,
		"обработчик 2.0.16.103 не трогает производимый ПФ");
	// BSLLS:UsingHardcodeNetworkAddress-on
	ВерсияДо = Объект.ВерсияДанных;
	ОбновлениеПрограммыОбработчики.УстановитьСпособЗакупкаМатериаловТехкарт();
	ПроверитьРавенство(ВерсияДо, Ссылка.ПолучитьОбъект().ВерсияДанных, "повтор обработчика 2.0.16.103 ничего не пишет");

	// Возврат исходного состава: дальше сценарий проверяет повтор старого обработчика на одной строке.
	Объект.ТЧМатериалы.Удалить(Объект.ТЧМатериалы.Найти(ПФ, "Номенклатура"));
	Объект.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

// Строка материалов документа карты со способом изготовления и процентом потерь.
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Карта     - ДокументОбъект.ТехнологическаяКарта - документ карты
//  Материал  - СправочникСсылка.Номенклатура - материал строки
//  Количество - Число - количество на единицу продукции
//  Способ    - ПеречислениеСсылка.СпособыИзготовления - способ изготовления
//  Процент   - Число - процент потерь
//
Процедура ДобавитьМатериалКарты(Контекст, Карта, Материал, Количество, Способ, Процент)

	Строка = Карта.ТЧМатериалы.Добавить();
	Строка.Номенклатура = Материал;
	Строка.Упаковка = Контекст.Единица;
	Строка.Количество = Количество;
	Строка.СпособИзготовления = Способ;
	Строка.ПроцентПотерь = Процент;

КонецПроцедуры

// Дополняет таблицу состава колонками способа и процента: у СоставКарты их нет намеренно - так остальные
// сценарии проверяют ветку «источник этих полей не знает» в записи документа карты.
//
// Параметры:
//  Состав  - ТаблицаЗначений - см. СоставКарты
//  Способ  - ПеречислениеСсылка.СпособыИзготовления - способ изготовления всех строк
//  Процент - Число - процент потерь всех строк
//
Процедура ДобавитьСвойстваИзготовления(Состав, Способ, Процент)

	Состав.Колонки.Добавить("СпособИзготовления", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыИзготовления"));
	Состав.Колонки.Добавить("ПроцентПотерь", Метаданные.ОпределяемыеТипы.Процент.Тип);
	Состав.ЗаполнитьЗначения(Способ, "СпособИзготовления");
	Состав.ЗаполнитьЗначения(Процент, "ПроцентПотерь");

КонецПроцедуры

// Перенос вызывается тем же обработчиком, что при обновлении базы, с общим откатом сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПереносТехнологическихКарт(Контекст)

	ДатаСоздания = НачалоДня(Контекст.Дата) - 86400;
	Старая = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	БезДаты = НоменклатураСоСтаройТехкартой(Контекст, Дата(1, 1, 1));
	Будущая = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	Отмененная = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	Черновик = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	Пустая = НоваяНоменклатура(Контекст, "без старой карты", Перечисления.ТипыНоменклатуры.Продукция);
	Состав = СоставКарты(Контекст);
	Состав[0].Количество = 7;
	ДатаБудущей = НачалоДня(Контекст.Дата) + 86400;
	БудущаяВерсия = ТехнологическиеКарты.ЗаписатьТехкарту(Будущая, Состав, ДатаБудущей);
	Отмена = ТехнологическиеКарты.ЗаписатьТехкарту(Отмененная, Неопределено, ДатаСоздания);
	ДокЧерновик = Документы.ТехнологическаяКарта.СоздатьДокумент();
	ДокЧерновик.Заполнить(Черновик);
	ДокЧерновик.Дата = ДатаСоздания;
	ДокЧерновик.ТЧМатериалы.Загрузить(Состав);
	ДокЧерновик.Записать();

	ОбновлениеПрограммыОбработчики.ПеренестиТехнологическиеКарты();
	Версия = ТехнологическиеКарты.ТекущиеТехкарты(Старая, ДатаСоздания).Получить(Старая);
	Проверить(Версия <> Неопределено, "старая карта перенесена на дату создания номенклатуры");
	ПроверитьРавенство(ДатаСоздания, Версия.ДействуетС, "дата перенесённой карты");
	ПеренесенныйСостав = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Версия.Версия);
	ПроверитьРавенство(1, ПеренесенныйСостав.Количество(), "повторяющиеся строки сырья свёрнуты");
	ПроверитьРавенство(Контекст.Сырье, ПеренесенныйСостав[0].Номенклатура, "перенесён материал");
	ПроверитьРавенство(Контекст.Единица, ПеренесенныйСостав[0].Упаковка, "ЕИ перенесена в упаковку");
	ПроверитьРавенство(5, ПеренесенныйСостав[0].Количество, "суммарный расход сохранён");
	Проверить(Не ЗначениеЗаполнено(ПеренесенныйСостав[0].Характеристика), "у старой карты характеристика пустая");
	ПроверитьРавенство(2, Старая.ПолучитьОбъект().ТехнологическаяКарта.Количество(), "исходная карта сохранена");
	ВерсияБезДаты = ТехнологическиеКарты.ТекущиеТехкарты(БезДаты, ДатаСоздания).Получить(БезДаты);
	ПроверитьРавенство(Дата(2000, 1, 1), ВерсияБезДаты.ДействуетС, "запасная дата переноса");

	ОбновлениеПрограммыОбработчики.ПеренестиТехнологическиеКарты();
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Старая), "повтор переноса не создаёт дубликат");
	Повторная = ТехнологическиеКарты.ТекущиеТехкарты(Старая, ДатаСоздания).Получить(Старая);
	ПроверитьРавенство(Версия.Версия, Повторная.Версия, "повтор сохраняет регистратор");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Версия.Версия, ПеренесенныйСостав), "повтор сохраняет состав");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(БезДаты), "запасная дата не мешает идемпотентности");
	ПроверитьРавенство(0, КоличествоДокументовТехкарт(Пустая), "пустая старая карта не переносится");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Будущая), "будущая карта запрещает перенос старой");
	БудущаяПосле = ТехнологическиеКарты.ТекущиеТехкарты(Будущая, ДатаБудущей).Получить(Будущая);
	ПроверитьРавенство(БудущаяВерсия, БудущаяПосле.Версия, "будущая версия сохранена");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(БудущаяВерсия, Состав), "будущий состав сохранён");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Отмененная), "маркер отмены запрещает перенос");
	ОтменаПосле = ТехнологическиеКарты.ТекущиеТехкарты(Отмененная, ДатаСоздания).Получить(Отмененная);
	ПроверитьРавенство(Отмена, ОтменаПосле.Версия, "отмена сохранена");
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкарт(Отмененная, ДатаСоздания).Количество(),
		"отменённая карта не восстановлена");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Черновик), "черновик не заменён переносом");
	Проверить(Не ДокЧерновик.Ссылка.Проведен, "черновик не проведён переносом");
	ПроверитьРавенство(7, ДокЧерновик.Ссылка.ПолучитьОбъект().ТЧМатериалы[0].Количество, "состав черновика сохранён");

	Возврат РезультатСценария("перенос дат и состава, повтор без дублей, сохранение будущих карт, отмен и черновиков");

КонецФункции

// Мультивыпуск по перенесённой карте: будущая рецептура не меняет старую себестоимость.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСебестоимостьТехкарт(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;

	Продукция = НоменклатураСоСтаройТехкартой(Контекст, НачалоДня(Контекст.Дата) - 86400);
	ОбновлениеПрограммыОбработчики.ПеренестиТехнологическиеКарты();
	ДокументЗакупки(Контекст, Контекст.Сырье, 7, 10);
	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Продукция, 1, 0);
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Контекст.Продукция, 1, 0);
	Материалы = ТехнологическиеКарты.ЗаполнитьМатериалыПоТехкартам(Выпуск.ТЧГотоваяПродукция.Выгрузить(), Выпуск.Дата);
	ПроверитьРавенство(7, Материалы.Итог("КоличествоУпаковок"), "расход сырья по двум картам после переноса");
	Для Каждого Строка Из Материалы Цикл
		ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧТовары", Строка.Номенклатура, Строка.КоличествоУпаковок, 0);
	КонецЦикла;
	Провести(Выпуск);
	ПроверитьРавенство(50, ОстатокТовара(Контекст.Склад, Продукция).Сумма, "себестоимость по перенесённой карте: вес 5");
	ПроверитьРавенство(20, ОстатокТовара(Контекст.Склад, Контекст.Продукция).Сумма, "себестоимость второй продукции: вес 2");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, Контекст.Сырье).Количество, "сырьё списано полностью");

	НовыйСостав = СоставКарты(Контекст);
	НовыйСостав[0].Количество = 9;
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, НовыйСостав, НачалоДня(Выпуск.Дата) + 86400);
	// Повторное проведение пользователем начинается с перечитанного объекта. Иначе наборы
	// движений первого проведения остаются в памяти теста и складываются с новыми.
	Выпуск = Выпуск.Ссылка.ПолучитьОбъект();
	Провести(Выпуск);
	ПроверитьРавенство(50, ОстатокТовара(Контекст.Склад, Продукция).Сумма, "перепроведение сохраняет старый вес 5");
	ПроверитьРавенство(20, ОстатокТовара(Контекст.Склад, Контекст.Продукция).Сумма, "перепроведение сохраняет долю второй продукции");
	ПроверитьРавенство(1, ОстатокТовара(Контекст.Склад, Продукция).Количество, "перепроведение не удваивает выпуск");

	Проверить(ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Продукция, НачалоДня(Выпуск.Дата)),
		"нужно предупредить о выпуске в день действия карты");
	Проверить(Не ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Продукция, КонецДня(Выпуск.Дата) + 1),
		"более ранний выпуск не требует предупреждения");

	Возврат РезультатСценария("перенос → мультивыпуск: себестоимость 50/20; новая рецептура не меняет старый выпуск");

КонецФункции

// Дата в карточке не может предшествовать последней карте, даже если в тот день есть версия.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДатыТехкарты(Контекст)

	Продукция = НоваяНоменклатура(Контекст, "выбор даты карты", Перечисления.ТипыНоменклатуры.Продукция);
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Вчера = НачалоДня(Сегодня - 1);
	Завтра = КонецДня(Сегодня) + 1;
	Состав = СоставКарты(Контекст);
	Вчерашняя = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Вчера);
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Сегодня);
	Проверить(Выбор.Допустима, "новая версия может начинаться сегодня");
	Проверить(Не ЗначениеЗаполнено(Выбор.Документ), "сегодняшняя версия ещё не создана");
	Ссылка = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ТекущаяДатаСеанса());
	ПроверитьРавенство(Сегодня, Ссылка.Дата, "новая карта хранит день без времени");
	Проверить(Вчерашняя <> Ссылка, "новый день создаёт отдельную версию");
	Состав[0].Количество = 4;
	Повторная = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, КонецДня(Сегодня));
	ПроверитьРавенство(Ссылка, Повторная, "сегодня редактируется существующая карта");
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Сегодня);
	ПроверитьРавенство(Ссылка, Выбор.Документ, "по дате подобрана та же карта");
	ДокументКарты = Ссылка.ПолучитьОбъект();
	ДокументКарты.Дата = КонецДня(Сегодня);
	ДокументКарты.Записать(РежимЗаписиДокумента.Проведение);
	Повторная = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Сегодня);
	ПроверитьРавенство(Ссылка, Повторная, "карта со временем перезаписывается без дубля");
	ПроверитьРавенство(Сегодня, Повторная.Дата, "у существующей карты время также сбрасывается");
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Вчера);
	Проверить(Не Выбор.Допустима, "вчера запрещено, несмотря на существующую вчерашнюю карту");
	ПроверитьРавенство(Завтра, Выбор.Дата, "после ошибки выбирается следующий день после последней версии");
	ЗаписьОтклонена = Ложь;
	Попытка
		ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Вчера);
	Исключение
		ЗаписьОтклонена = Истина;
	КонецПопытки;
	Проверить(ЗаписьОтклонена, "сервер запрещает перезапись старой версии независимо от формы");
	ПроверитьРавенство(2, ТехнологическиеКарты.СоставТехкартыПоРегистратору(Вчерашняя)[0].Количество,
		"отклонённая запись не меняет старый состав");
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Завтра);
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Сегодня);
	Проверить(Не Выбор.Допустима, "будущая карта запрещает новую сегодняшнюю");
	ПроверитьРавенство(КонецДня(Завтра) + 1, Выбор.Дата, "исправленная дата не нарушает запрет будущей карты");

	Возврат РезультатСценария("день без времени, редактирование сегодняшней версии, запрет прошлых дат и будущая последняя карта");

КонецФункции

// Реальные поступления и продажи дают последние цены; два одинаковых материала делят остаток.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПоказателиТехкарты(Контекст)

	ДокументЗакупки(Контекст, Контекст.Сырье, 10, 9);
	ДокументЗакупки(Контекст, Контекст.Сырье, 10, 10);
	ДокументЗакупки(Контекст, Контекст.Товар, 12, 2);
	ДокументЗакупки(Контекст, Контекст.Продукция, 2, 20);
	ДокументРеализации(Контекст, Контекст.Продукция, 1, 90);
	ДокументРеализации(Контекст, Контекст.Продукция, 1, 100);
	Состав = СоставКарты(Контекст);
	Строка = Состав.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Состав[0]);
	Строка.Количество = 3;
	Строка = Состав.Добавить();
	Строка.Номенклатура = Контекст.Товар;
	Строка.Количество = 6;

	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	Проверить(Показатели.ВсеЦеныЕсть, "у всех материалов есть закупочная цена");
	ПроверитьРавенство(10, Показатели.Строки[0].Цена, "последняя цена заменяет прежнюю цену 9");
	ПроверитьРавенство(62, Показатели.Себестоимость, "себестоимость: (2 + 3) * 10 + 6 * 2");
	ПроверитьРавенство(2, Показатели.МожноПроизвести, "ограничивает второй материал: 12 / 6");
	ПроверитьРавенство(100, Показатели.ЦенаПродажи, "взята последняя продажа, а не прайс и не прежняя цена 90");
	ПроверитьРавенство(76, Показатели.ПотенциальнаяМаржа, "маржа всего выпуска: (100 - 62) * 2");
	Состав.Удалить(2);
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(4, Показатели.МожноПроизвести, "дубли материала используют один остаток: 20 / (2 + 3)");
	Состав[0].Количество = 30;
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(0.606, Показатели.МожноПроизвести, "дробный выпуск усекается, а не округляется вверх");
	Проверить(Показатели.ПотенциальнаяМаржа < 0, "отрицательная маржа сохраняется для показа убытка");

	Характеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	Характеристика.Владелец = Контекст.Сырье;
	Характеристика.Наименование = ПометкаТеста() + ": другая характеристика";
	Характеристика.Записать();
	Состав[0].Характеристика = Характеристика.Ссылка;
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(0, Показатели.МожноПроизвести, "остаток другой характеристики не используется");
	Проверить(Не Показатели.ВсеЦеныЕсть, "нет закупочной цены выбранной характеристики");
	ПроверитьРавенство(0, Показатели.Себестоимость, "неполная себестоимость не выдаётся за полную");
	ПроверитьРавенство(0, Показатели.ПотенциальнаяМаржа, "при неполной себестоимости маржа не рассчитывается");
	Состав.Очистить();
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(0, Показатели.МожноПроизвести, "пустой состав не обещает выпуск");
	ПроверитьРавенство(0, Показатели.Себестоимость, "пустой состав сбрасывает себестоимость");

	Возврат РезультатСценария("последние цены, себестоимость, ограничивающий материал, дубли, дробный выпуск, характеристики и маржа");

КонецФункции

// Способ пополнения: единое правило умолчаний, страховка записи, ручное значение
// "Оба" и идемпотентное заполнение существующей номенклатуры обработчиком обновления.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСпособыПополненияЗапасов(Контекст)

	Закупка = Перечисления.СпособыПополненияЗапасов.Закупка;
	СпособПроизводство = Перечисления.СпособыПополненияЗапасов.Производство;
	Оба = Перечисления.СпособыПополненияЗапасов.Оба;

	Умолчания = Новый Соответствие;
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Продукция, СпособПроизводство);
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Полуфабрикат, СпособПроизводство);
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Товар, Закупка);
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Сырье, Закупка);
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Комплект, Закупка);
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Услуга, Закупка);
	Для Каждого Умолчание Из Умолчания Цикл
		Получено = Справочники.Номенклатура.СпособПополненияПоУмолчанию(Умолчание.Ключ);
		ПроверитьРавенство(Умолчание.Значение, Получено, "способ пополнения по умолчанию для типа " + Умолчание.Ключ);
	КонецЦикла;

	Страховка = Справочники.Номенклатура.СоздатьЭлемент();
	Страховка.Наименование = ПометкаТеста() + ": страховка способа пополнения";
	Страховка.НаименованиеПолное = Страховка.Наименование;
	Страховка.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Сырье;
	Страховка.Единица = Контекст.Единица;
	Страховка.СтавкаНДС = Контекст.СтавкаНДС;
	Страховка.СпособПополнения = Перечисления.СпособыПополненияЗапасов.ПустаяСсылка();
	Страховка.Записать();
	ПроверитьРавенство(Закупка, Страховка.Ссылка.СпособПополнения,
		"ПередЗаписью заполняет пустой способ пополнения");

	ЯвныйВыбор = Контекст.Товар.ПолучитьОбъект();
	ЯвныйВыбор.СпособПополнения = Оба;
	ЯвныйВыбор.Записать();
	ПроверитьРавенство(Оба, ЯвныйВыбор.Ссылка.СпособПополнения,
		"явно выбранное значение Оба сохраняется при записи");

	СуществующийЭлемент = НоменклатураБезСпособаПополнения(Контекст);
	СуществующаяГруппа = ГруппаНоменклатурыБезСпособаПополнения();
	Проверить(Не ЗначениеЗаполнено(СуществующийЭлемент.СпособПополнения),
		"режим загрузки сохраняет пустое значение до миграции");

	ОбновлениеПрограммыОбработчики.ЗаполнитьСпособыПополненияЗапасов();
	ПроверитьРавенство(СпособПроизводство, СуществующийЭлемент.СпособПополнения,
		"миграция заполняет существующую продукцию");
	ПроверитьРавенство(Оба, ЯвныйВыбор.Ссылка.СпособПополнения,
		"миграция не меняет явно выбранное значение Оба");
	Проверить(Не ЗначениеЗаполнено(СуществующаяГруппа.СпособПополнения),
		"миграция не обрабатывает группы номенклатуры");
	ПроверитьРавенство(0, КоличествоЭлементовБезСпособаПополнения(),
		"после миграции не осталось элементов с пустым способом пополнения");

	ОбновлениеПрограммыОбработчики.ЗаполнитьСпособыПополненияЗапасов();
	ПроверитьРавенство(СпособПроизводство, СуществующийЭлемент.СпособПополнения,
		"повторная миграция сохраняет заполненное значение");
	ПроверитьРавенство(Оба, ЯвныйВыбор.Ссылка.СпособПополнения,
		"повторная миграция сохраняет Оба");
	ПроверитьРавенство(0, КоличествоЭлементовБезСпособаПополнения(),
		"повторная миграция идемпотентна");

	Возврат РезультатСценария("умолчания шести типов, страховка записи, Оба, миграция элементов и повторный запуск");

КонецФункции

// Коммерческое предложение: статусы, описание у каждой строки, печать и ввод заказа
// на основании. Неуспешная проверка заполнения заказа не меняет статус предложения.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийКоммерческоеПредложение(Контекст)

	ОписаниеСтроки = ПометкаТеста() + ": описание из коммерческого предложения";
	Предложение = НовоеКоммерческоеПредложение(Контекст, Контекст.Товар, ОписаниеСтроки);
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Черновик,
		Предложение.Статус, "статус нового предложения");
	ОписаниеКарточки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контекст.Товар, "Описание");
	ВтораяСтрока = Предложение.ТЧТовары.Добавить();
	ЗаполнитьЗначенияСвойств(ВтораяСтрока, Предложение.ТЧТовары[0], , "КодСтроки, Описание");
	ВтораяСтрока.КодСтроки = Предложение.ТЧТовары[0].КодСтроки + 1;
	ВтораяСтрока.Описание = ОписаниеСтроки + " (вторая строка)";
	Записать(Предложение);
	ПроверитьРавенство(ОписаниеСтроки, Предложение.Ссылка.ТЧТовары[0].Описание, "описание первой строки сохраняется");
	ПроверитьРавенство(ВтораяСтрока.Описание, Предложение.Ссылка.ТЧТовары[1].Описание,
		"у второй строки той же номенклатуры своё описание");
	ПроверитьРавенство(ОписаниеКарточки, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контекст.Товар, "Описание"),
		"описание строки не переносится в карточку номенклатуры");

	Предложение.Статус = Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	Предложение.Записать();
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Отправлен,
		Предложение.Ссылка.Статус, "выбранный статус сохраняется");

	ПечатнаяФорма = ПечатьПредложения(Предложение.Ссылка);
	Проверить(ПечатнаяФорма.НайтиТекст(ВтораяСтрока.Описание) <> Неопределено,
		"печатная форма выводит описание строки предложения");
	// Команда печати видна ролям, работающим с предложениями (у них setForNewObjects = false: право ставится явно).
	КомандаПечати = Метаданные.Документы.КоммерческоеПредложение.Команды.ПечатьКоммерческоеПредложение;
	Для Каждого ИмяРоли Из СтрРазделить("Оператор,МенеджерПоПродажам,Руководитель", ",") Цикл
		Проверить(ПравоДоступа("Просмотр", КомандаПечати, Метаданные.Роли[ИмяРоли]),
			"команда печати коммерческого предложения видна роли " + ИмяРоли);
	КонецЦикла;

	Заказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	Заказ.Заполнить(Предложение.Ссылка);
	Заказ.Дата = СледующаяДата(Контекст);
	Записать(Заказ);
	ПроверитьРавенство(Предложение.Ссылка, Заказ.Основание, "основание заказа");
	ПроверитьРавенство(Предложение.Организация, Заказ.Организация, "организация заказа");
	ПроверитьРавенство(Предложение.Контрагент, Заказ.Контрагент, "контрагент заказа");
	ПроверитьРавенство(Предложение.Договор, Заказ.Договор, "договор заказа");
	ПроверитьРавенство(Предложение.ДатаОтгрузки, Заказ.ДатаОтгрузки, "дата отгрузки заказа");
	ПроверитьРавенство(Предложение.ЦенаВключаетНДС, Заказ.ЦенаВключаетНДС, "режим НДС заказа");
	ПроверитьРавенство(Предложение.Комментарий, Заказ.Комментарий, "комментарий заказа");
	ПроверитьРавенство(Предложение.ТЧТовары.Количество(), Заказ.ТЧТовары.Количество(),
		"количество строк заказа");
	ПроверитьРавенство(Предложение.ТЧТовары[0].Номенклатура, Заказ.ТЧТовары[0].Номенклатура,
		"номенклатура заказа");
	ПроверитьРавенство(Предложение.ТЧТовары[0].Количество, Заказ.ТЧТовары[0].Количество,
		"количество товара в заказе");
	ПроверитьРавенство(Предложение.ТЧТовары[0].Цена, Заказ.ТЧТовары[0].Цена, "цена товара в заказе");
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Выигран,
		Предложение.Ссылка.Статус, "успешный заказ устанавливает статус Выигран");

	ПредложениеСОшибкой = НовоеКоммерческоеПредложение(Контекст, Контекст.Сырье,
		ПометкаТеста() + ": статус при ошибке заказа");
	ПредложениеСОшибкой.Статус = Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	Записать(ПредложениеСОшибкой);
	НезаполненныйЗаказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	НезаполненныйЗаказ.Заполнить(ПредложениеСОшибкой.Ссылка);
	НезаполненныйЗаказ.Организация = Справочники.Организации.ПустаяСсылка();
	Проверить(Не НезаполненныйЗаказ.ПроверитьЗаполнение(),
		"заказ без организации должен отклоняться проверкой заполнения");
	ПолучитьСообщенияПользователю(Истина);
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Отправлен,
		ПредложениеСОшибкой.Ссылка.Статус, "неуспешное создание заказа не меняет статус предложения");

	Возврат РезультатСценария(
		"черновик и ручной статус, описание, печать и её команда у ролей, заказ-основание, Выигран и отказ без смены статуса");

КонецФункции

// Редакции коммерческого предложения (docs/plans/kp-print-revisions.md): номер редакции растёт только у
// отправленного предложения при изменении содержимого, снимок хранит данные печати на момент отправки,
// возврат редакции, начальная редакция КП, отправленного до учёта редакций, защита архива.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийРедакцииКоммерческогоПредложения(Контекст)

	Отправлен = Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	Товар = НоваяНоменклатура(Контекст, "товар редакций", Перечисления.ТипыНоменклатуры.Товар);
	ПрежнееНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Товар, "НаименованиеПолное");
	НовоеНаименование = ПрежнееНаименование + " (новое имя)";
	// Две разные картинки 1×1 PNG.
	ПервыйЛоготип = Base64Значение("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9"
		+ "awAAAABJRU5ErkJggg==");
	ВторойЛоготип = Base64Значение("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFBQIAX8jx"
		+ "0gAAAABJRU5ErkJggg==");
	ЗаписатьЛоготипОрганизации(Контекст.Организация, ПервыйЛоготип);

	Предложение = НовоеКоммерческоеПредложение(Контекст, Товар, ПометкаТеста() + ": редакции");
	Записать(Предложение);
	ПроверитьРедакции(Предложение, 0, 0, Ложь, "черновик");

	Предложение.Статус = Отправлен;
	Записать(Предложение);
	ПроверитьРедакции(Предложение, 1, 1, Ложь, "первая отправка");
	Записать(Предложение);
	Предложение.Статус = Перечисления.СтатусыКоммерческихПредложений.Доставлен;
	Записать(Предложение);
	ПроверитьРедакции(Предложение, 1, 1, Ложь, "запись без изменений и смена статуса");

	// Архивность печати: справочники и логотип меняются, отправленная редакция печатается как ушла клиенту.
	ПереименоватьНоменклатуру(Товар, НовоеНаименование);
	ЗаписатьЛоготипОрганизации(Контекст.Организация, ВторойЛоготип);
	ПечатьТекущей = ПечатьПредложения(Предложение.Ссылка);
	Проверить(ПечатьТекущей.НайтиТекст(НовоеНаименование) = Неопределено,
		"неизменённая отправленная редакция печатается из снимка, без нового наименования");
	Проверить(ПечатьТекущей.НайтиТекст(ПрежнееНаименование) <> Неопределено, "в снимке прежнее наименование");
	ПроверитьРавенство(Base64Строка(ПервыйЛоготип), ЛоготипПечати(ПечатьТекущей), "логотип печати - из снимка");

	ИзменитьКоличество(Предложение, 0, Контекст.Числа.КоличествоПродажи + 1);
	Записать(Предложение);
	ПроверитьРедакции(Предложение, 2, 2, Ложь, "изменено количество");
	ПечатьВторойРедакции = ПечатьПредложения(Предложение.Ссылка);
	Проверить(ПечатьВторойРедакции.НайтиТекст(НовоеНаименование) <> Неопределено,
		"новая редакция печатается с актуальным наименованием");
	Проверить(ПечатьВторойРедакции.НайтиТекст("v2") <> Неопределено, "на печати редакция v2");
	ПечатьПервойРедакции = ПечатьПредложения(Предложение.Ссылка, 1);
	Проверить(ПечатьПервойРедакции.НайтиТекст("v1") <> Неопределено, "печать выбранной редакции v1");
	ПроверитьЯзыкПечатиРедакции(Предложение.Ссылка, 1);

	// Возврат редакции v1: номер свой, содержимое v1, при записи рождается v3 с тем же хешем.
	Содержимое = Документы.КоммерческоеПредложение.СодержимоеДляВозврата(Предложение.Ссылка, 1);
	Проверить(Содержимое <> Неопределено, "содержимое редакции v1");
	Содержимое.Шапка.Удалить("Номер");
	ЗаполнитьЗначенияСвойств(Предложение, Содержимое.Шапка);
	Предложение.ТЧТовары.Загрузить(Содержимое.Товары);
	Записать(Предложение);
	ПроверитьРедакции(Предложение, 3, 3, Ложь, "возврат редакции v1");
	ПроверитьРавенство(ХешРедакции(Предложение.Ссылка, 1), ХешРедакции(Предложение.Ссылка, 3),
		"возвращённая редакция совпадает с v1");

	// Черновик правок после отправки: номер не растёт, на печати следующая редакция с пометкой.
	Предложение.Статус = Перечисления.СтатусыКоммерческихПредложений.Черновик;
	ИзменитьКоличество(Предложение, 0, Контекст.Числа.КоличествоПродажи + 2);
	Записать(Предложение);
	ПроверитьРедакции(Предложение, 3, 3, Истина, "черновик правок после отправки");
	Проверить(ПечатьПредложения(Предложение.Ссылка).НайтиТекст("v4") <> Неопределено,
		"черновик правок печатается как v4 с пометкой");

	// Номер печатается и входит в редакцию.
	Предложение.Статус = Отправлен;
	Записать(Предложение);
	ПроверитьРедакции(Предложение, 4, 4, Ложь, "отправка черновика правок");
	Предложение.УстановитьНовыйНомер();
	Записать(Предложение);
	ПроверитьРедакции(Предложение, 5, 5, Ложь, "смена номера");

	// Копия - новое предложение без редакций.
	Копия = Предложение.Скопировать();
	Копия.Дата = СледующаяДата(Контекст);
	Записать(Копия);
	ПроверитьРедакции(Копия, 0, 0, Ложь, "копия");

	ПроверитьВозвратСУдаленнойНоменклатурой(Контекст);
	ПроверитьНачальнуюРедакцию(Контекст, Товар, Ложь);
	ПроверитьНачальнуюРедакцию(Контекст, Товар, Истина);
	ПроверитьСбросОтложенныхРедакций(Контекст, Товар);

	Ссылка = Предложение.Ссылка;
	Предложение.Удалить();
	ПроверитьРавенство(0, ЧислоРедакций(Ссылка), "редакции удаляются вместе с предложением");

	// Последней: отказ записи в транзакции годится только для отката.
	ПроверитьЗащитуАрхиваРедакций(Копия.Ссылка);

	Возврат РезультатСценария("номер редакции, снимок печати, возврат, черновик правок, начальная редакция, архив");

КонецФункции

Процедура ПроверитьРедакции(Предложение, Версия, ЧислоСнимков, Изменено, Описание)

	Ссылка = Предложение.Ссылка;
	ПроверитьРавенство(Версия, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Версия"), Описание + ": номер редакции");
	ПроверитьРавенство(ЧислоСнимков, ЧислоРедакций(Ссылка), Описание + ": число редакций");
	ПроверитьРавенство(Изменено, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ИзмененоПослеРедакции"),
		Описание + ": признак черновика правок");

КонецПроцедуры

Функция ЧислоРедакций(Предложение)

	Возврат Документы.КоммерческоеПредложение.СписокРедакций(Предложение).Количество();

КонецФункции

Функция ХешРедакции(Предложение, Версия)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Редакции.Хеш КАК Хеш
	|ИЗ
	|	РегистрСведений.РедакцииКоммерческихПредложений КАК Редакции
	|ГДЕ
	|	Редакции.Предложение = &Предложение
	|	И Редакции.Версия = &Версия");
	Запрос.УстановитьПараметр("Предложение", Предложение);
	Запрос.УстановитьПараметр("Версия", Версия);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Хеш, "");

КонецФункции

// Снимок редакции печатается на языке, выбранном в окне печати, а не на языке сеанса, в котором записан:
// сумма прописью и надпись редакции - на каждом языке конфигурации.
//
// Параметры:
//  Предложение - ДокументСсылка.КоммерческоеПредложение - предложение с записанной редакцией.
//  Версия      - Число - номер проверяемой редакции.
//
Процедура ПроверитьЯзыкПечатиРедакции(Предложение, Версия)

	Снимок = Документы.КоммерческоеПредложение.ДанныеРедакции(Предложение, Версия);
	Проверить(Снимок <> Неопределено, "снимок редакции для проверки языка печати");
	ПоЯзыкам = Неопределено;
	Проверить(Снимок.Печать.Итоги.Свойство("СуммаПрописьюПоЯзыкам", ПоЯзыкам),
		"снимок хранит сумму прописью на каждом языке");
	Для Каждого Язык Из Метаданные.Языки Цикл
		КодЯзыка = Язык.КодЯзыка;
		СуммаПрописью = ПоЯзыкам.Получить(КодЯзыка);
		Проверить(ЗначениеЗаполнено(СуммаПрописью), "сумма прописью в снимке на языке " + КодЯзыка);
		Печать = ПечатьПредложения(Предложение, Версия, КодЯзыка);
		Проверить(Печать.НайтиТекст(СуммаПрописью) <> Неопределено,
			"сумма прописью на языке печати " + КодЯзыка);
		Плашка = СтрШаблон(НСтр("ru = 'Редакция v%1'; fr = 'Révision v%1'; en = 'Revision v%1'; es = 'Revisión v%1'",
			КодЯзыка), Версия);
		Проверить(Печать.НайтиТекст(Плашка) <> Неопределено, "надпись редакции на языке печати " + КодЯзыка);
	КонецЦикла;
	// Различие текстов по языкам не проверяется: у валюты без параметров прописи на языке сумма прописью - число.

КонецПроцедуры

// Фирменные печатные формы (docs/plans/branded-print.md, фаза 1): каждый вид формы на каждом языке формируется
// без незаполненных параметров; вариант без цен; снимки КП форматов 1 (2.0.16.50) и 2 (2.0.16.51+) печатаются на
// всех языках; пользовательская правка общего макета без области вида не ломает печать.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийФирменнаяПечать(Контекст)

	ОписаниеСтроки = ПометкаТеста() + ": описание фирменной печати";
	Предложение = НовоеКоммерческоеПредложение(Контекст, Контекст.Товар, ОписаниеСтроки);
	Записать(Предложение);
	НаименованиеСтроки = Документы.КоммерческоеПредложение.ДанныеДляПечати(Предложение).Товары[0].Наименование;

	ВидКП = "КоммерческоеПредложение";
	Проверить(ФирменнаяПечать.ВидыФорм().Найти(ВидКП) <> Неопределено, "вид КП в списке видов фирменных форм");
	Для Каждого Язык Из Метаданные.Языки Цикл
		КодЯзыка = Язык.КодЯзыка;
		Описание = ФирменнаяПечать.ОписаниеВида(ВидКП, КодЯзыка);
		Печать = ПечатьПредложения(Предложение.Ссылка, , КодЯзыка);
		ПроверитьФирменнуюФорму(Печать, Описание, ВидКП + ", " + КодЯзыка);
		Проверить(Печать.НайтиТекст(ОписаниеСтроки) <> Неопределено, "описание строки, " + КодЯзыка);
	КонецЦикла;

	// Без цен: та же форма, таблица без цены и суммы, без итогов.
	Данные = Документы.КоммерческоеПредложение.ДанныеДляПечати(Предложение);
	БезЦен = ФирменнаяПечать.ТабличныйДокументПоДанным(Данные, ВидКП, "ru", "",
		Новый Структура("БезЦен", Истина));
	ПроверитьФирменнуюФорму(БезЦен, ФирменнаяПечать.ОписаниеВида(ВидКП, "ru"), "без цен");
	Проверить(БезЦен.НайтиТекст(НаименованиеСтроки) <> Неопределено, "без цен: наименование строки");
	Проверить(БезЦен.НайтиТекст(Данные.Итоги.СуммаПрописьюПоЯзыкам["ru"]) = Неопределено,
		"без цен: итогов и суммы прописью нет");

	ПроверитьФорматыСнимков(Предложение);
	ПроверитьЯвныйЯзыкМакета();
	ПроверитьСуммуПрописьюВалюты();
	Счета = ПроверитьСчетаФактуры(Контекст);
	ПроверитьНакладныеИАкты(Контекст, Счета);
	ПроверитьКомандыИПраваФазы4();
	ПроверитьФормыФазы5(Контекст, Счета);
	ПроверитьКомандыИПраваФазы5();
	ПроверитьФормыФазы6(Контекст, Счета);
	ПроверитьКомандыИПраваФазы6();
	ПроверитьУстаревшийПользовательскийМакет(Предложение.Ссылка, НаименованиеСтроки, Счета);
	ПроверитьПравкуУдаленногоМакета(Счета);
	// Отказ печати формы с ценами роли без цен - последним шагом сценария.
	ПроверитьСкрытиеЦен(Счета);

	Возврат РезультатСценария("вид КП на 4 языках без незаполненных параметров, вариант без цен, снимки форматов 1, "
		+ "2, 3 и 4 на 4 языках; Facture реализации, налоговой накладной и накладной покупки (стороны наоборот), "
		+ "Proforma реализации, налоговой накладной и заказа (цены без НДС, счёт реализаций по ссылке заказа); BL "
		+ "(DevisBL с параметром без цен и без, A4, без НДС, без цен), акт реализации и поступления (стороны наоборот), "
		+ "Avoir обоих возвратов на 4 языках - обязательные реквизиты, итоги, оплаты, значения запроса прежней формы; "
		+ "команды и права на замену FactureOld; бланк заказа, акт сверки трёх вариантов (сальдо, обороты, НДС по ставкам, "
		+ "печать и факсимиле, построчные расхождения сторон, руководитель по уставу), квитанции ПКО и РКО на 4 языках, "
		+ "права на команды и данные адаптеров фазы 5; заказ поставщику, запросы котировок без фото и с фото, запрос цен, "
		+ "письмо о платеже на 4 языках, права и данные адаптеров фазы 6, вложение рассылки заказа; скрытие цен роли; "
		+ "правка общего макета без области вида - печать "
		+ "поставляемым; обработчики обновления правки сохраняют; правка удалённого макета - в списке макетов, "
		+ "открывается редактором, печать прежних команд её не подмешивает");

КонецФункции

// Форма содержит заголовок и подписи вида и не содержит незаполненных параметров и шаблонов.
//
// Параметры:
//  Печать   - ТабличныйДокумент - сформированная форма
//  Описание - Структура         - см. ФирменнаяПечать.ОписаниеВида
//  Пояснение - Строка           - вид и язык для текста ошибки
//
Процедура ПроверитьФирменнуюФорму(Печать, Описание, Пояснение)

	Проверить(Печать.ВысотаТаблицы > 0, "форма сформирована: " + Пояснение);
	Проверить(Печать.НайтиТекст(Описание.Заголовок) <> Неопределено, "заголовок вида: " + Пояснение);
	Проверить(Печать.НайтиТекст(Описание.ПодписьСтороны) <> Неопределено, "подпись стороны: " + Пояснение);
	Проверить(Печать.НайтиТекст(Описание.ПодписьКонтакта) <> Неопределено, "подпись контакта: " + Пояснение);
	Проверить(Печать.НайтиТекст("[") = Неопределено, "незаполненный шаблон «[...]»: " + Пояснение);
	Проверить(Печать.НайтиТекст("%1") = Неопределено, "неподставленный «%1»: " + Пояснение);

КонецПроцедуры

// Язык, переданный макету явно, не зависит от кэша контекста формирования (2.0.16.81): при пустом контексте - как после
// вытеснения значения кэша - макет получает заданный язык, а не язык сеанса.
//
Процедура ПроверитьЯвныйЯзыкМакета()

	Контекст = ПечатныеФормыПовтИсп.КонтекстФормирования();
	ПрежнийКодЯзыка = Контекст.КодЯзыка;
	Контекст.КодЯзыка = "";
	Путь = "ОбщийМакет.ФирменныйДокумент";
	Попытка
		Для Каждого Язык Из Метаданные.Языки Цикл
			Макет = ПечатныеФормы.МакетПечатнойФормы(Путь, Язык.КодЯзыка);
			ПроверитьРавенство(Язык.КодЯзыка, Макет.КодЯзыка, "явный язык макета при пустом контексте, " + Язык.КодЯзыка);
		КонецЦикла;
	Исключение
		Контекст.КодЯзыка = ПрежнийКодЯзыка;
		ВызватьИсключение;
	КонецПопытки;
	Контекст.КодЯзыка = ПрежнийКодЯзыка;

КонецПроцедуры

// Данные печати, записанные в снимки редакций КП прежних сборок, печатаются на любом языке: формат 1
// (2.0.16.50: без ВерсияФормата, договор вписан в реквизиты, сумма прописью только на языке записи) и формат 2.
//
// Параметры:
//  Предложение - ДокументОбъект.КоммерческоеПредложение - записанное предложение с договором
//
Процедура ПроверитьФорматыСнимков(Предложение)

	ДанныеФормата6 = Документы.КоммерческоеПредложение.ДанныеДляПечати(Предложение);
	ПроверитьРавенство(6, ДанныеФормата6.ВерсияФормата, "текущий формат данных печати КП");
	ДанныеФормата5 = ДанныеФормата5(Документы.КоммерческоеПредложение.ДанныеДляПечати(Предложение));
	ДанныеФормата4 = ДанныеФормата4(Документы.КоммерческоеПредложение.ДанныеДляПечати(Предложение));
	ДанныеФормата3 = ДанныеФормата3(Документы.КоммерческоеПредложение.ДанныеДляПечати(Предложение));
	ДанныеФормата2 = ДанныеФормата2(Документы.КоммерческоеПредложение.ДанныеДляПечати(Предложение));
	Договор = ДанныеФормата2.Клиент.КлиентДоговор;
	Проверить(ЗначениеЗаполнено(Договор), "у предложения сценария есть договор");

	ДанныеФормата1 = Документы.КоммерческоеПредложение.ДанныеДляПечати(Предложение);
	ДанныеФормата1.Удалить("ВерсияФормата");
	ДанныеФормата1.Итоги.Удалить("СуммаПрописьюПоЯзыкам");
	ДанныеФормата1.Итоги.СуммаПрописью = ПометкаТеста() + ": сумма прописью формата 1";
	ДанныеФормата1.Клиент.КлиентРеквизиты = ДанныеФормата1.Клиент.КлиентРеквизиты + Символы.ПС + "Договор: " + Договор;
	ДанныеФормата1.Клиент.Удалить("КлиентДоговор");
	ВидКП = "КоммерческоеПредложение";

	Для Каждого Язык Из Метаданные.Языки Цикл
		КодЯзыка = Язык.КодЯзыка;
		Плашка = "v1 " + КодЯзыка;
		Печать1 = ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата1, ВидКП, КодЯзыка, Плашка);
		Проверить(Печать1.НайтиТекст(ДанныеФормата1.Итоги.СуммаПрописью) <> Неопределено,
			"формат 1: сумма прописью языка записи, " + КодЯзыка);
		Проверить(Печать1.НайтиТекст(Договор) <> Неопределено, "формат 1: договор в реквизитах, " + КодЯзыка);
		Проверить(Печать1.НайтиТекст(Плашка) <> Неопределено, "формат 1: плашка, " + КодЯзыка);
		Печать2 = ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата2, ВидКП, КодЯзыка);
		Проверить(Печать2.НайтиТекст(ДанныеФормата2.Итоги.СуммаПрописьюПоЯзыкам[КодЯзыка]) <> Неопределено,
			"формат 2: сумма прописью на языке печати, " + КодЯзыка);
		Проверить(Печать2.НайтиТекст(Договор) <> Неопределено, "формат 2: договор, " + КодЯзыка);
		Печать3 = ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата3, ВидКП, КодЯзыка);
		Проверить(Печать3.НайтиТекст(ДанныеФормата3.Итоги.СуммаПрописьюПоЯзыкам[КодЯзыка]) <> Неопределено,
			"формат 3: сумма прописью на языке печати, " + КодЯзыка);
		Печать4 = ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата4, ВидКП, КодЯзыка);
		Проверить(Печать4.НайтиТекст(ДанныеФормата4.Итоги.СуммаПрописьюПоЯзыкам[КодЯзыка]) <> Неопределено,
			"формат 4: сумма прописью на языке печати, " + КодЯзыка);
		Печать5 = ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата5, ВидКП, КодЯзыка);
		Проверить(Печать5.НайтиТекст(ДанныеФормата5.Итоги.СуммаПрописьюПоЯзыкам[КодЯзыка]) <> Неопределено,
			"формат 5: сумма прописью на языке печати, " + КодЯзыка);
		Печать6 = ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата6, ВидКП, КодЯзыка);
		Проверить(Печать6.НайтиТекст(ДанныеФормата6.Итоги.СуммаПрописьюПоЯзыкам[КодЯзыка]) <> Неопределено,
			"формат 6: сумма прописью на языке печати, " + КодЯзыка);
		// Снимок формата 5 печатается заказом поставщику и запросом котировок с фото: ключи формата 6 (коды и фото
		// строк) приведение добавляет пустыми; данные без блока письма письмом о платеже не печатаются.
		Для Каждого ВидФормы Из СтрРазделить("CommandeFournisseur,DemandeDeCotation,DemandeDePrix", ",") Цикл
			Печать = ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата5, ВидФормы, КодЯзыка, "",
				Новый Структура("СФото", Истина));
			Проверить(Печать.НайтиТекст("[") = Неопределено, "формат 5 видом " + ВидФормы + " без шаблонов, " + КодЯзыка);
		КонецЦикла;
		ОтказПисьма = Ложь;
		Попытка
			ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата5, "LettreDePaiement", КодЯзыка);
		Исключение
			ОтказПисьма = Истина;
		КонецПопытки;
		Проверить(ОтказПисьма, "данные без блока письма письмом о платеже не печатаются, " + КодЯзыка);
		// Снимок формата 4 печатается и бланком заказа: ключи формата 5 приведение добавляет пустыми.
		Бланк4 = ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата4, "BonDeCommande", КодЯзыка);
		Проверить(Бланк4.НайтиТекст("[") = Неопределено, "формат 4 бланком заказа без шаблонов, " + КодЯзыка);
		// Данные товарного документа видом акта сверки не печатаются: блока сверки в них нет.
		Отказ = Ложь;
		Попытка
			ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата4, "Releve", КодЯзыка);
		Исключение
			Отказ = Истина;
		КонецПопытки;
		Проверить(Отказ, "данные без блока сверки актом сверки не печатаются, " + КодЯзыка);
		// Снимок формата 3 печатается и накладной BL: ключи формата 4 приведение добавляет пустыми.
		Накладная3 = ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата3, "BL", КодЯзыка);
		Проверить(Накладная3.НайтиТекст("[") = Неопределено, "формат 3 накладной BL без шаблонов, " + КодЯзыка);
		// Снимок формата 2 печатается и счётом-фактурой: новые ключи приведение добавляет пустыми.
		Фактура2 = ФирменнаяПечать.ТабличныйДокументПоДанным(ДанныеФормата2, "Facture", КодЯзыка);
		Проверить(Фактура2.НайтиТекст("[") = Неопределено, "формат 2 счётом-фактурой без шаблонов, " + КодЯзыка);
	КонецЦикла;

КонецПроцедуры

// Данные печати КП формата 5 (2.0.16.73) из текущих: удалены ключи, которые добавил формат 6 (блок письма, коды и фото
// строк). У КП их нет и в текущих данных (ключи добавляет приведение) - удаляются, если есть.
//
// Параметры:
//  Данные - Структура - данные печати текущего формата, см. Документы.КоммерческоеПредложение.ДанныеДляПечати
//
// Возвращаемое значение:
//  Структура - те же данные без ключей формата 6, ВерсияФормата = 5
//
Функция ДанныеФормата5(Данные)

	Данные.ВерсияФормата = 5;
	Если Данные.Свойство("Письмо") Тогда
		Данные.Удалить("Письмо");
	КонецЕсли;
	Для Каждого Товар Из Данные.Товары Цикл
		Для Каждого Ключ Из СтрРазделить("КодПоставщика,КодПроизводителя,Фото", ",") Цикл
			Если Товар.Свойство(Ключ) Тогда
				Товар.Удалить(Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Данные;

КонецФункции

// Данные печати КП формата 4 (2.0.16.72) из текущих: удалены ключи, которые добавил формат 5. У КП их нет и в
// текущих данных (ключи добавляет приведение) - удаляются, если есть.
//
// Параметры:
//  Данные - Структура - данные печати текущего формата, см. Документы.КоммерческоеПредложение.ДанныеДляПечати
//
// Возвращаемое значение:
//  Структура - те же данные без ключей формата 5, ВерсияФормата = 4
//
Функция ДанныеФормата4(Данные)

	ДанныеФормата5(Данные);
	Данные.ВерсияФормата = 4;
	Для Каждого Ключ Из СтрРазделить("Сверка,Квитанция,ПодписьРуководителя", ",") Цикл
		Если Данные.Свойство(Ключ) Тогда
			Данные.Удалить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Данные;

КонецФункции

// Данные печати КП формата 3 (2.0.16.70-71) из текущих: удалены ключи, которые добавили форматы 4 и 5.
//
// Параметры:
//  Данные - Структура - данные печати текущего формата, см. Документы.КоммерческоеПредложение.ДанныеДляПечати
//
// Возвращаемое значение:
//  Структура - те же данные без ключей форматов 4 и 5, ВерсияФормата = 3
//
Функция ДанныеФормата3(Данные)

	ДанныеФормата4(Данные);
	Данные.ВерсияФормата = 3;
	Данные.Удалить("Оплаты");
	Данные.Клиент.Удалить("КлиентАдресДоставки");
	Данные.Шапка.Удалить("Автор");
	Возврат Данные;

КонецФункции

// Данные печати КП формата 2 (2.0.16.51-69) из текущих: удалены ключи, которые добавили форматы 3 и 4.
//
// Параметры:
//  Данные - Структура - данные печати текущего формата, см. Документы.КоммерческоеПредложение.ДанныеДляПечати
//
// Возвращаемое значение:
//  Структура - те же данные без ключей форматов 3 и 4, ВерсияФормата = 2
//
Функция ДанныеФормата2(Данные)

	ДанныеФормата3(Данные);
	Данные.ВерсияФормата = 2;
	Данные.Организация.Удалить("Коды");
	Данные.Организация.Удалить("Банк");
	Для Каждого Ключ Из СтрРазделить("КлиентКоды,КлиентАдрес,КлиентТелефоны,КлиентКод", ",") Цикл
		Данные.Клиент.Удалить(Ключ);
	КонецЦикла;
	Данные.Итоги.Удалить("СуммаСкидки");
	Возврат Данные;

КонецФункции

// Сумма прописью в валюте без параметров прописи - словами (раздел 10.5 плана фирменной печати): у дирхама в базах
// клиентов табличная часть параметров пуста, и строка «Arrêtée la présente facture» печаталась цифрами. Строка
// параметров валюты главнее параметров по умолчанию. Изменение валюты откатывается вместе со сценарием.
//
Процедура ПроверитьСуммуПрописьюВалюты()

	// Параметры по умолчанию есть у дирхама, евро, доллара и рубля: валюта учёта копий баз - дирхам.
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	Если Не ЗначениеЗаполнено(Валюта) Или СокрЛП(Валюта.Код) <> "504" Тогда
		Возврат;
	КонецЕсли;
	ВалютаОбъект = Валюта.ПолучитьОбъект();
	ВалютаОбъект.ТЧПараметрыИсчисления.Очистить();
	ВалютаОбъект.Записать();
	// BSLLS:MagicNumber-off - сумма из предпросмотра фазы 2, печаталась «279.000».
	Сумма = 279000;
	// BSLLS:MagicNumber-on
	Для Каждого Локализация Из Метаданные.Перечисления.Локализации.ЗначенияПеречисления Цикл
		Прописью = Справочники.Валюты.СформироватьСуммуПрописью(Сумма, Валюта,
			Перечисления.Локализации[Локализация.Имя]);
		Проверить(СтрНайти(Прописью, "279") = 0 И СтрДлина(Прописью) > 10,
			"сумма прописью словами без параметров валюты, " + Локализация.Имя + ": " + Прописью);
	КонецЦикла;
	Строка = ВалютаОбъект.ТЧПараметрыИсчисления.Добавить();
	Строка.Локализация = Перечисления.Локализации.fr_CA;
	Строка.ЦелаяЧасть1 = "unitetest";
	Строка.ЦелаяЧасть2 = "unitestests";
	Строка.ДробнаяЧасть1 = "centest";
	Строка.ДробнаяЧасть2 = "centests";
	ВалютаОбъект.Записать();
	Прописью = Справочники.Валюты.СформироватьСуммуПрописью(Сумма, Валюта, Перечисления.Локализации.fr_CA);
	Проверить(СтрНайти(Прописью, "unitest") > 0, "строка параметров прописи валюты главнее параметров по умолчанию");

КонецПроцедуры

// Facture и Proforma (раздел 10.8 плана фирменной печати): реализация со скидкой, товаром без упаковки и услугой,
// налоговая накладная по ней, накладная покупки, заказ покупателя - каждой командой на каждом языке. Обязательные
// реквизиты Марокко (коды организации и клиента, HT/TVA/TTC, сумма прописью словами, способ оплаты), итоги документа
// и значения, которые выбирал запрос прежней формы, - в тексте новой формы.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - Реализация (ДокументОбъект.РеализацияТоваровУслуг) - для проверки пользовательского макета
//
Функция ПроверитьСчетаФактуры(Контекст)

	КодыОрганизации = ЗаписатьКодыСтороны(Контекст.Организация, "ORG");
	КодыКлиента = ЗаписатьКодыСтороны(Контекст.Контрагент, "CLI");
	КлиентОбъект = Контекст.Контрагент.ПолучитьОбъект();
	КлиентОбъект.ТипОплаты = Справочники.TypesDePayment.Cash;
	КлиентОбъект.Записать();
	ТипОплаты = СокрЛП(Справочники.TypesDePayment.Cash);
	// BSLLS:MagicNumber-off - ставка НДС сценария.
	СтавкаНДС = НоваяСтавкаНДС(20);
	// BSLLS:MagicNumber-on

	Реализация = РеализацияДляСчета(Контекст, СтавкаНДС);
	Накладная = НалоговаяНакладнаяДляСчета(Контекст, Реализация, СтавкаНДС);
	Покупка = НакладнаяПокупкиДляСчета(Контекст);
	Заказ = ЗаказДляПроформы(Контекст, СтавкаНДС);
	// Второй заказ - с реализацией по нему: команда «Счёт» печатает её счёт (первый заказ остаётся без реализаций).
	ЗаказСРеализацией = ЗаказДляПроформы(Контекст, СтавкаНДС);
	РеализацияЗаказа = РеализацияДляКП(Контекст, Неопределено, Истина, Истина);
	РеализацияЗаказа.Основание = ЗаказСРеализацией.Ссылка;
	РеализацияЗаказа.Записать();
	Заказы = Новый Структура("БезРеализаций, СРеализацией, Реализация", Заказ, ЗаказСРеализацией, РеализацияЗаказа);

	Для Каждого Язык Из Метаданные.Языки Цикл
		КодЯзыка = Язык.КодЯзыка;
		Фактура = ФирменнаяПечать.ОписаниеВида("Facture", КодЯзыка);
		Проформа = ФирменнаяПечать.ОписаниеВида("Proforma", КодЯзыка);

		Печать = ПечатьКоманды("РеализацияТоваровУслуг", "Facture", Реализация.Ссылка, КодЯзыка);
		Пояснение = "Facture реализации, " + КодЯзыка;
		ПроверитьТоварнуюФорму(Печать, Фактура.Заголовок, Фактура, Пояснение);
		ПроверитьРеквизитыСчета(Печать, Реализация, КодыОрганизации, КодыКлиента, КодЯзыка, Пояснение);
		ПроверитьЗначенияПрежнейФактуры(Печать, Реализация, ТипОплаты, КодЯзыка, Пояснение);
		Проверить(Печать.НайтиТекст(СодержаниеУслугиКП()) <> Неопределено, Пояснение + ": содержание услуги");

		Печать = ПечатьКоманды("РеализацияТоваровУслуг", "Счёт", Реализация.Ссылка, КодЯзыка);
		Пояснение = "Proforma реализации, " + КодЯзыка;
		ПроверитьТоварнуюФорму(Печать, Проформа.Заголовок, Проформа, Пояснение);
		ПроверитьРеквизитыСчета(Печать, Реализация, КодыОрганизации, КодыКлиента, КодЯзыка, Пояснение);
		Проверить(Печать.НайтиТекст(СокрЛП(Реализация.Номер)) <> Неопределено, Пояснение + ": номер документа");

		Для Каждого ИмяКоманды Из СтрРазделить("Facture,FactureСФоном", ",") Цикл
			Печать = ПечатьКоманды("НалоговаяНакладная", ИмяКоманды, Накладная.Ссылка, КодЯзыка);
			Пояснение = ИмяКоманды + " налоговой накладной, " + КодЯзыка;
			ПроверитьТоварнуюФорму(Печать, Фактура.Заголовок, Фактура, Пояснение);
			ПроверитьРеквизитыСчета(Печать, Накладная, КодыОрганизации, КодыКлиента, КодЯзыка, Пояснение);
			ПроверитьЗначенияПрежнейФактуры(Печать, Накладная, ТипОплаты, КодЯзыка, Пояснение);
			БезОтгрузки = Печать.НайтиТекст(Накладная.ТЧТовары[1].Номенклатура.Наименование);
			ГруппаОтгрузки = Печать.НайтиТекст("BL: ");
			Проверить(БезОтгрузки <> Неопределено И ГруппаОтгрузки <> Неопределено
				И БезОтгрузки.Верх < ГруппаОтгрузки.Верх, Пояснение + ": строка без отгрузки - до групп BL");
			НомерФактуры = ФирменнаяПечать.НомерСчетаФактуры(Накладная.Номер, Накладная.ДатаИнвойса);
			Проверить(Печать.НайтиТекст(НомерФактуры) <> Неопределено, Пояснение + ": номер с годом даты инвойса");
		КонецЦикла;
		Печать = ПечатьКоманды("НалоговаяНакладная", "Счёт", Накладная.Ссылка, КодЯзыка);
		ПроверитьТоварнуюФорму(Печать, Проформа.Заголовок, Проформа, "Proforma налоговой накладной, " + КодЯзыка);
		Проверить(Печать.НайтиТекст(ФорматДатыПечати(Накладная.Дата, КодЯзыка)) <> Неопределено,
			"Proforma налоговой накладной: дата документа, а не дата инвойса, " + КодЯзыка);

		ПроверитьНакладнуюПокупки(Покупка, КодыОрганизации, Фактура, КодЯзыка);
		ПроверитьПроформуЗаказа(Заказы, Проформа, КодыКлиента, КодЯзыка);
	КонецЦикла;

	Возврат Новый Структура("Реализация, Накладная, Покупка", Реализация, Накладная, Покупка);

КонецФункции

// Коды стороны в регистре реквизитов контрагентов (IF, PATENTE, RC, CNSS, ICE); запись откатывается со сценарием.
//
// Параметры:
//  Владелец - СправочникСсылка.Организации, СправочникСсылка.Контрагенты - сторона
//  Префикс  - Строка - префикс значений
//
// Возвращаемое значение:
//  Массив из Строка - записанные значения кодов
//
Функция ЗаписатьКодыСтороны(Владелец, Префикс)

	Значения = Новый Массив;
	Для Каждого Код Из ПечатныеФормы.МеткиКодов() Цикл
		Значение = Префикс + "-" + Код.Метка + "-77";
		Набор = РегистрыСведений.РеквизитыКонтрагентов.СоздатьНаборЗаписей();
		Набор.Отбор.Контрагент.Установить(Владелец);
		Набор.Отбор.Реквизит.Установить(ПланыВидовХарактеристик.ВидыРеквизитовКонтрагентов[Код.Имя]);
		Запись = Набор.Добавить();
		Запись.Период = Дата(2000, 1, 1);
		Запись.Контрагент = Владелец;
		Запись.Реквизит = ПланыВидовХарактеристик.ВидыРеквизитовКонтрагентов[Код.Имя];
		Запись.Представление = Значение;
		Запись.Значение = Значение;
		Набор.Записать();
		Значения.Добавить(Значение);
	КонецЦикла;
	Возврат Значения;

КонецФункции

Функция РеализацияДляСчета(Контекст, СтавкаНДС)

	Док = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПокупателя;
	Док.ЦенаВключаетНДС = Истина;
	// BSLLS:MagicNumber-off - количества, цены, скидка и НДС строк сценария.
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Контекст.Товар, 2, 60);
	СтрокаСНДС(Док.ТЧТовары[0], СтавкаНДС, 120, 20);
	Док.ТЧТовары[0].ПроцентСкидки = 10;
	Док.ТЧТовары[0].СуммаСкидки = 12;
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Контекст.Сырье, 3, 5);
	Док.ТЧТовары[1].Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	Услуга = НоваяНоменклатура(Контекст, "услуга Facture", Перечисления.ТипыНоменклатуры.Услуга);
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧУслуги", Услуга, 1, 100);
	// BSLLS:MagicNumber-on
	Док.ТЧУслуги[0].Содержание = СодержаниеУслугиКП();
	Записать(Док);
	Возврат Док;

КонецФункции

Процедура СтрокаСНДС(Строка, СтавкаНДС, Сумма, СуммаНДС)

	Строка.СтавкаНДС = СтавкаНДС;
	Строка.Сумма = Сумма;
	Строка.СуммаСНДС = Сумма;
	Строка.СуммаНДС = СуммаНДС;

КонецПроцедуры

Функция НалоговаяНакладнаяДляСчета(Контекст, Реализация, СтавкаНДС)

	Док = НовыйДокумент(Контекст, "НалоговаяНакладная");
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПокупателя;
	Док.ЦенаВключаетНДС = Истина;
	Док.Основание = Реализация.Ссылка;
	// Дата инвойса - в другом году: Facture печатает год даты инвойса, Proforma - дату документа.
	Док.ДатаИнвойса = ДобавитьМесяц(Док.Дата, -12);
	// BSLLS:MagicNumber-off
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Контекст.Товар, 2, 60);
	СтрокаСНДС(Док.ТЧТовары[0], СтавкаНДС, 120, 20);
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧУслуги", Реализация.ТЧУслуги[0].Номенклатура, 1, 100);
	// BSLLS:MagicNumber-on
	Док.ТЧТовары[0].ОтгрузкаТовара = Реализация.Ссылка;
	Док.ТЧУслуги[0].ОтгрузкаТовара = Реализация.Ссылка;
	// Строка без документа отгрузки после строки с ним: печатается первой, не под чужим «BL:».
	// BSLLS:MagicNumber-off
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Контекст.Сырье, 1, 7);
	// BSLLS:MagicNumber-on
	Записать(Док);
	Возврат Док;

КонецФункции

Функция НакладнаяПокупкиДляСчета(Контекст)

	Док = НовыйДокумент(Контекст, "НалоговаяНакладнаяПокупка");
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПоставщика;
	Док.НомерВходящегоДокумента = "FRN-4471";
	Док.ДатаВходящегоДокумента = Док.Дата;
	// BSLLS:MagicNumber-off
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Контекст.Сырье, 4, 25);
	// BSLLS:MagicNumber-on
	Записать(Док);
	Возврат Док;

КонецФункции

Функция ЗаказДляПроформы(Контекст, СтавкаНДС)

	Док = НовыйДокумент(Контекст, "ЗаказПокупателя");
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПокупателя;
	Док.ЦенаВключаетНДС = Истина;
	Док.ДатаОтгрузки = Док.Дата;
	// BSLLS:MagicNumber-off - цена с НДС 120, без НДС 100.
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Контекст.Товар, 1, 120);
	СтрокаСНДС(Док.ТЧТовары[0], СтавкаНДС, 120, 20);
	// BSLLS:MagicNumber-on
	Записать(Док);
	Возврат Док;

КонецФункции

Функция ПечатьКоманды(ИмяДокумента, ИмяМакета, Ссылка, КодЯзыка, ПараметрыПечати = Неопределено)

	Параметры = ?(ПараметрыПечати = Неопределено, Новый Структура, ПараметрыПечати);
	Результат = ПечатныеФормы.СформироватьПечатныеФормы("Документ." + ИмяДокумента, ИмяМакета,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка), Параметры, КодЯзыка);
	ТабличныйДокумент = Результат.КоллекцияПечатныхФорм[0].ТабличныйДокумент;
	Проверить(ТипЗнч(ТабличныйДокумент) = Тип("ТабличныйДокумент") И ТабличныйДокумент.ВысотаТаблицы > 0,
		"печатная форма " + ИмяДокумента + "." + ИмяМакета + " пуста");
	Возврат ТабличныйДокумент;

КонецФункции

// Товарная фирменная форма: заголовок вида, подписи продавца и покупателя, нет незаполненных шаблонов.
//
// Параметры:
//  Печать    - ТабличныйДокумент - сформированная форма
//  Заголовок - Строка - ожидаемый заголовок
//  Описание  - Структура - см. ФирменнаяПечать.ОписаниеВида
//  Пояснение - Строка - форма и язык для текста ошибки
//
Процедура ПроверитьТоварнуюФорму(Печать, Заголовок, Описание, Пояснение)

	Проверить(Печать.НайтиТекст(Заголовок) <> Неопределено, Пояснение + ": заголовок «" + Заголовок + "»");
	Проверить(Печать.НайтиТекст(Описание.ПодписьПродавца) <> Неопределено, Пояснение + ": подпись продавца");
	Проверить(Печать.НайтиТекст(Описание.ПодписьПокупателя) <> Неопределено, Пояснение + ": подпись покупателя");
	Проверить(Печать.НайтиТекст("[") = Неопределено, Пояснение + ": незаполненный шаблон «[...]»");
	Проверить(Печать.НайтиТекст("%1") = Неопределено, Пояснение + ": неподставленный «%1»");

КонецПроцедуры

// Обязательные реквизиты счёта Марокко: коды организации и клиента, итоги документа HT/TVA/TTC, сумма прописью
// словами на языке печати.
//
// Параметры:
//  Печать          - ТабличныйДокумент - сформированная форма
//  Док             - ДокументОбъект - печатаемый документ
//  КодыОрганизации - Массив из Строка - коды организации, см. ЗаписатьКодыСтороны
//  КодыКлиента     - Массив из Строка - коды клиента, последний - ICE
//  КодЯзыка        - Строка - язык печати
//  Пояснение       - Строка - форма и язык для текста ошибки
//
Процедура ПроверитьРеквизитыСчета(Печать, Док, КодыОрганизации, КодыКлиента, КодЯзыка, Пояснение)

	Для Каждого Код Из КодыОрганизации Цикл
		Проверить(Печать.НайтиТекст(Код) <> Неопределено, Пояснение + ": код организации " + Код);
	КонецЦикла;
	Проверить(Печать.НайтиТекст(КодыКлиента[КодыКлиента.ВГраница()]) <> Неопределено, Пояснение + ": ICE клиента");
	Ссылка = Док.Ссылка;
	Итоги = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Сумма, СуммаНДС");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Итоги.Сумма, КодЯзыка)) <> Неопределено, Пояснение + ": TOTAL TTC");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Итоги.Сумма - Итоги.СуммаНДС, КодЯзыка)) <> Неопределено,
		Пояснение + ": TOTAL HT");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Итоги.СуммаНДС, КодЯзыка)) <> Неопределено, Пояснение + ": TVA");
	Прописью = ПечатныеФормы.СуммаПрописью(Итоги.Сумма, РаботаСВалютами.ВалютаИКурсОбъекта(Ссылка).Валюта, КодЯзыка);
	Проверить(Печать.НайтиТекст(ВРег(Прописью)) <> Неопределено, Пояснение + ": сумма прописью " + Прописью);
	Проверить(СтрНайти(Прописью, Формат(Цел(Итоги.Сумма), "ЧГ=0")) = 0, Пояснение + ": сумма прописью словами");

КонецПроцедуры

// Значения, которые выбирал запрос прежней Facture (ТекстЗапросаFacture до 2.0.16.70), есть в новой форме: номер с
// годом, код клиента, артикул, количество, цена, ставка и НДС строки, сумма строки, документ отгрузки, способ оплаты.
//
// Параметры:
//  Печать    - ТабличныйДокумент - сформированная форма
//  Док       - ДокументОбъект - печатаемый документ
//  ТипОплаты - Строка - тип оплаты клиента (способ оплаты без оплат по документу)
//  КодЯзыка  - Строка - язык печати
//  Пояснение - Строка - форма и язык для текста ошибки
//
Процедура ПроверитьЗначенияПрежнейФактуры(Печать, Док, ТипОплаты, КодЯзыка, Пояснение)

	Проверить(Печать.НайтиТекст(СокрЛП(Док.Контрагент.Код)) <> Неопределено, Пояснение + ": код клиента");
	Проверить(Печать.НайтиТекст(ТипОплаты) <> Неопределено, Пояснение + ": способ оплаты");
	Строка = Док.ТЧТовары[0];
	Артикул = СокрЛП(Строка.Номенклатура.Артикул);
	Если ЗначениеЗаполнено(Артикул) Тогда
		Проверить(Печать.НайтиТекст(Артикул) <> Неопределено, Пояснение + ": артикул");
	КонецЕсли;
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Строка.Цена, КодЯзыка)) <> Неопределено, Пояснение + ": цена строки");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Строка.Сумма, КодЯзыка)) <> Неопределено, Пояснение + ": сумма строки");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Строка.СуммаНДС, КодЯзыка)) <> Неопределено, Пояснение + ": НДС строки");
	Проверить(Печать.НайтиТекст(СокрЛП(Строка.СтавкаНДС)) <> Неопределено, Пояснение + ": ставка НДС");
	Проверить(Печать.НайтиТекст("BL: ") <> Неопределено, Пояснение + ": документ отгрузки строк");

КонецПроцедуры

// Накладная покупки: стороны наоборот - поставщик продавец, организация покупатель, печати организации нет.
//
// Параметры:
//  Покупка         - ДокументОбъект.НалоговаяНакладнаяПокупка - накладная покупки
//  КодыОрганизации - Массив из Строка - коды организации, см. ЗаписатьКодыСтороны
//  Фактура         - Структура - описание вида Facture на языке печати
//  КодЯзыка        - Строка - язык печати
//
Процедура ПроверитьНакладнуюПокупки(Покупка, КодыОрганизации, Фактура, КодЯзыка)

	Пояснение = "Facture накладной покупки, " + КодЯзыка;
	Печать = ПечатьКоманды("НалоговаяНакладнаяПокупка", "Facture", Покупка.Ссылка, КодЯзыка);
	ПроверитьТоварнуюФорму(Печать, Фактура.ЗаголовокПокупки, Фактура, Пояснение);
	Проверить(Печать.НайтиТекст(КодыОрганизации[0]) <> Неопределено, Пояснение + ": коды организации-покупателя");
	Проверить(Печать.НайтиТекст("FRN-4471") <> Неопределено, Пояснение + ": номер поставщика в основании");
	Источник = Документы.НалоговаяНакладнаяПокупка.ДанныеФирменнойПечати(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Покупка.Ссылка), "Facture", КодЯзыка, Новый Структура)[Покупка.Ссылка];
	Проверить(Источник.Данные.Шапка.ОрганизацияПокупатель, Пояснение + ": организация - покупатель");
	// Колонка продавца - левая: поставщик в ней, подпись «продавец» над ним.
	Продавец = Печать.НайтиТекст(Источник.Данные.Клиент.КлиентНаименование);
	Подпись = Печать.НайтиТекст(Фактура.ПодписьПродавца);
	Проверить(Продавец <> Неопределено И Подпись <> Неопределено И Продавец.Лево = Подпись.Лево,
		Пояснение + ": поставщик - в колонке продавца");
	Проверить(Фактура.Заголовок <> Фактура.ЗаголовокПокупки, Пояснение + ": заголовок покупки свой");

КонецПроцедуры

// Счёт-проформа заказа: цены строк без НДС (вариант прежней формы); команда «Счёт» реализации по ссылке заказа печатает
// сам заказ, пока реализаций нет, и счёт реализации, когда она введена по заказу.
//
// Параметры:
//  Заказы      - Структура - БезРеализаций, СРеализацией (ДокументОбъект.ЗаказПокупателя), Реализация (по второму)
//  Проформа    - Структура - описание вида Proforma на языке печати
//  КодыКлиента - Массив из Строка - коды клиента, последний - ICE
//  КодЯзыка    - Строка - язык печати
//
Процедура ПроверитьПроформуЗаказа(Заказы, Проформа, КодыКлиента, КодЯзыка)

	Пояснение = "Proforma заказа, " + КодЯзыка;
	Заказ = Заказы.БезРеализаций;
	Печать = ПечатьКоманды("ЗаказПокупателя", "Проформа", Заказ.Ссылка, КодЯзыка);
	ПроверитьТоварнуюФорму(Печать, Проформа.Заголовок, Проформа, Пояснение);
	// BSLLS:MagicNumber-off - цена 120 с НДС 20 - без НДС 100.
	Проверить(Печать.НайтиТекст(ДеньгиПечати(100, КодЯзыка)) <> Неопределено, Пояснение + ": цена без НДС");
	// BSLLS:MagicNumber-on
	Проверить(Печать.НайтиТекст(КодыКлиента[КодыКлиента.ВГраница()]) <> Неопределено, Пояснение + ": ICE клиента");

	Печать = ПечатьКоманды("РеализацияТоваровУслуг", "Счёт", Заказ.Ссылка, КодЯзыка);
	Проверить(Печать.НайтиТекст(СокрЛП(Заказ.Номер)) <> Неопределено,
		"счёт по ссылке заказа без реализаций - сам заказ, " + КодЯзыка);
	Печать = ПечатьКоманды("РеализацияТоваровУслуг", "Счёт", Заказы.СРеализацией.Ссылка, КодЯзыка);
	Проверить(Печать.НайтиТекст(СокрЛП(Заказы.Реализация.Номер)) <> Неопределено,
		"счёт по ссылке заказа с реализацией - счёт реализации, " + КодЯзыка);
	// Нумерации заказов и реализаций разные: номера могут совпасть, тогда отсутствие номера заказа не проверяется.
	НомерЗаказа = СокрЛП(Заказы.СРеализацией.Номер);
	Если НомерЗаказа <> СокрЛП(Заказы.Реализация.Номер) Тогда
		Проверить(Печать.НайтиТекст(НомерЗаказа) = Неопределено,
			"счёт по ссылке заказа с реализацией - не счёт заказа, " + КодЯзыка);
	КонецЕсли;

КонецПроцедуры

// Накладные BL, акт об оказании услуг и Avoir (раздел 11.9 плана фирменной печати): каждая команда на каждом языке -
// заголовок и подписи вида, без незаполненных шаблонов; значения запроса прежней формы (номер «N/ГГ», заказ,
// клиент, количество, цена и сумма строки, итог, оплаты, подписи транспорта и клиента); варианты без НДС и без цен;
// акт - только услуги, итоги по ним, у поступления исполнитель - поставщик; Avoir - основание и причина возврата.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Счета    - Структура - см. ПроверитьСчетаФактуры
//
Процедура ПроверитьНакладныеИАкты(Контекст, Счета)

	Реализация = Счета.Реализация;
	АдресДоставки = ПометкаТеста() + ": адрес доставки";
	ЗаписатьРеквизитСтороны(Контекст.Контрагент, "АдресДоставки", АдресДоставки);
	Причина = Справочники.ПричиныВозвратов.СоздатьЭлемент();
	Причина.Наименование = ПометкаТеста() + ": причина возврата";
	Причина.Записать();
	Возвраты = Новый Массив;
	Возвраты.Добавить(ВозвратДляAvoir(Контекст, "ВозвратОтПокупателя", Реализация, Причина.Ссылка));
	Возвраты.Добавить(ВозвратДляAvoir(Контекст, "ВозвратОтПокупателяНалоговый", Счета.Накладная, Причина.Ссылка));
	Поступление = ПоступлениеДляАкта(Контекст);
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("Реализация", Реализация);
	ДанныеПроверки.Вставить("АдресДоставки", АдресДоставки);
	ДанныеПроверки.Вставить("Возвраты", Возвраты);
	ДанныеПроверки.Вставить("Поступление", Поступление);
	ДанныеПроверки.Вставить("Причина", Причина.Наименование);

	Для Каждого Язык Из Метаданные.Языки Цикл
		ПроверитьНакладныеНаЯзыке(ДанныеПроверки, Язык.КодЯзыка);
		ПроверитьАктыИВозвратыНаЯзыке(ДанныеПроверки, Язык.КодЯзыка);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНакладныеНаЯзыке(ДанныеПроверки, КодЯзыка)

	Реализация = ДанныеПроверки.Реализация;
	Ссылка = Реализация.Ссылка;
	ИмяДокумента = Реализация.Метаданные().Имя;
	Вид = ФирменнаяПечать.ОписаниеВида("BL", КодЯзыка);
	Итоги = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Сумма, СуммаНДС, Ответственный");
	Строка = Реализация.ТЧТовары[0];
	ПодписьКредит = СокрЛП(Справочники.TypesDePayment.Credit);
	Для Каждого ИмяКоманды Из СтрРазделить("DevisBL,BLA4", ",") Цикл
		Печать = ПечатьКоманды(ИмяДокумента, ИмяКоманды, Ссылка, КодЯзыка);
		Пояснение = ИмяКоманды + " реализации, " + КодЯзыка;
		ПроверитьТоварнуюФорму(Печать, Вид.Заголовок, Вид, Пояснение);
		НомерНакладной = ФирменнаяПечать.НомерНакладной(Реализация.Номер, Реализация.Дата);
		Проверить(Печать.НайтиТекст(НомерНакладной) <> Неопределено, Пояснение + ": номер «N/ГГ»");
		Проверить(Печать.НайтиТекст(СокрЛП(Реализация.Контрагент.Наименование)) <> Неопределено, Пояснение + ": клиент");
		Проверить(Печать.НайтиТекст(ДеньгиПечати(Строка.Цена, КодЯзыка)) <> Неопределено, Пояснение + ": цена строки");
		Проверить(Печать.НайтиТекст(ДеньгиПечати(Строка.Сумма, КодЯзыка)) <> Неопределено, Пояснение + ": сумма строки");
		Проверить(Печать.НайтиТекст(ДеньгиПечати(Итоги.Сумма, КодЯзыка)) <> Неопределено, Пояснение + ": TOTAL");
		Проверить(Печать.НайтиТекст(СодержаниеУслугиКП()) <> Неопределено, Пояснение + ": содержание услуги");
		// Реализация не оплачена: кредит - вся сумма документа.
		Проверить(Печать.НайтиТекст(ПодписьКредит + ": " + ДеньгиПечати(Итоги.Сумма, КодЯзыка)) <> Неопределено,
			Пояснение + ": оплаты по документу, кредит");
		Проверить(Печать.НайтиТекст(Вид.ПодписьЛевая) <> Неопределено И Печать.НайтиТекст(Вид.ПодписьПравая) <> Неопределено,
			Пояснение + ": подписи транспорта и клиента");
		Проверить(Печать.НайтиТекст(ДанныеПроверки.АдресДоставки) <> Неопределено, Пояснение + ": адрес доставки");
		Если ЗначениеЗаполнено(Итоги.Ответственный) Тогда
			Проверить(Печать.НайтиТекст(СокрЛП(Итоги.Ответственный)) <> Неопределено, Пояснение + ": кто выписал");
		КонецЕсли;
	КонецЦикла;

	Пояснение = "BL без НДС, " + КодЯзыка;
	Печать = ПечатьКоманды(ИмяДокумента, "BLA4БезНДС", Ссылка, КодЯзыка);
	ПроверитьТоварнуюФорму(Печать, Вид.Заголовок, Вид, Пояснение);
	ЦенаБезНДС = (Строка.СуммаСНДС - Строка.СуммаНДС) / Строка.Количество;
	Проверить(Печать.НайтиТекст(ДеньгиПечати(ЦенаБезНДС, КодЯзыка)) <> Неопределено, Пояснение + ": цена без НДС");
	Проверить(Печать.НайтиТекст(ПодписьКредит + ": ") = Неопределено, Пояснение + ": без оплат");

	ПараметрыБезЦен = Новый Структура("БезЦен", Истина);
	Для Каждого Вариант Из СтрРазделить("BLA4БезЦен,DevisBL", ",") Цикл
		Пояснение = Вариант + " без цен, " + КодЯзыка;
		Печать = ПечатьКоманды(ИмяДокумента, Вариант, Ссылка, КодЯзыка,
			?(Вариант = "DevisBL", ПараметрыБезЦен, Неопределено));
		ПроверитьТоварнуюФорму(Печать, Вид.Заголовок, Вид, Пояснение);
		Проверить(Печать.НайтиТекст(Строка.Номенклатура.Наименование) <> Неопределено, Пояснение + ": наименование");
		Проверить(Печать.НайтиТекст(ДеньгиПечати(Строка.Цена, КодЯзыка)) = Неопределено, Пояснение + ": цены нет");
		Проверить(Печать.НайтиТекст(ДеньгиПечати(Итоги.Сумма, КодЯзыка)) = Неопределено, Пояснение + ": итогов нет");
		Проверить(Печать.НайтиТекст(ПодписьКредит + ": ") = Неопределено, Пояснение + ": оплат нет");
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьАктыИВозвратыНаЯзыке(ДанныеПроверки, КодЯзыка)

	Реализация = ДанныеПроверки.Реализация;
	ИмяАкта = "АктОбОказанииУслуг";
	Акт = ФирменнаяПечать.ОписаниеВида(ИмяАкта, КодЯзыка);
	Пояснение = "акт реализации, " + КодЯзыка;
	Печать = ПечатьКоманды(Реализация.Метаданные().Имя, ИмяАкта, Реализация.Ссылка, КодЯзыка);
	ПроверитьТоварнуюФорму(Печать, Акт.Заголовок, Акт, Пояснение);
	Проверить(Печать.НайтиТекст(СодержаниеУслугиКП()) <> Неопределено, Пояснение + ": содержание услуги");
	Проверить(Печать.НайтиТекст(Реализация.ТЧТовары[1].Номенклатура.Наименование) = Неопределено,
		Пояснение + ": товаров нет - только услуги");
	СуммаУслуг = Реализация.ТЧУслуги.Итог("СуммаСНДС");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(СуммаУслуг, КодЯзыка)) <> Неопределено, Пояснение + ": итог по услугам");
	Проверить(Печать.НайтиТекст(Лев(Акт.ТекстПодписей, 20)) <> Неопределено, Пояснение + ": текст над подписями");

	Поступление = ДанныеПроверки.Поступление;
	Пояснение = "акт поступления, " + КодЯзыка;
	Печать = ПечатьКоманды(Поступление.Метаданные().Имя, ИмяАкта, Поступление.Ссылка, КодЯзыка);
	ПроверитьТоварнуюФорму(Печать, Акт.ЗаголовокПокупки, Акт, Пояснение);
	Проверить(Печать.НайтиТекст("FRN-ACT-7") <> Неопределено, Пояснение + ": номер документа поставщика");
	Источник = Документы.ПоступлениеТоваровУслуг.ДанныеФирменнойПечати(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Поступление.Ссылка), ИмяАкта, КодЯзыка,
		Новый Структура)[Поступление.Ссылка];
	Исполнитель = Печать.НайтиТекст(Источник.Данные.Клиент.КлиентНаименование);
	Подпись = Печать.НайтиТекст(Акт.ПодписьПродавца);
	Проверить(Исполнитель <> Неопределено И Подпись <> Неопределено И Исполнитель.Лево = Подпись.Лево,
		Пояснение + ": поставщик - в колонке исполнителя");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Поступление.ТЧУслуги.Итог("СуммаСНДС"), КодЯзыка)) <> Неопределено,
		Пояснение + ": итог по услугам");

	ВидВозврата = ФирменнаяПечать.ОписаниеВида("Avoir", КодЯзыка);
	Для Каждого ДокВозврата Из ДанныеПроверки.Возвраты Цикл
		ИмяДокумента = ДокВозврата.Метаданные().Имя;
		Пояснение = "Avoir " + ИмяДокумента + ", " + КодЯзыка;
		Печать = ПечатьКоманды(ИмяДокумента, "Avoir", ДокВозврата.Ссылка, КодЯзыка);
		ПроверитьТоварнуюФорму(Печать, ВидВозврата.Заголовок, ВидВозврата, Пояснение);
		Проверить(Печать.НайтиТекст(ДанныеПроверки.Причина) <> Неопределено, Пояснение + ": причина возврата");
		НомерОснования = РаботаСДокументами.СформироватьЦифровойНомер(ДокВозврата.Основание.Номер);
		Проверить(Печать.НайтиТекст(НомерОснования + "/") <> Неопределено, Пояснение + ": номер основания");
		Проверить(Печать.НайтиТекст(ДеньгиПечати(ДокВозврата.Сумма, КодЯзыка)) <> Неопределено, Пояснение + ": итог");
	КонецЦикла;

КонецПроцедуры

// Реквизит стороны в регистре реквизитов контрагентов; запись откатывается со сценарием.
//
// Параметры:
//  Владелец - СправочникСсылка.Контрагенты - сторона
//  ИмяВида  - Строка - вид реквизита (ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов)
//  Значение - Строка - значение
//
Процедура ЗаписатьРеквизитСтороны(Владелец, ИмяВида, Значение)

	Вид = ПланыВидовХарактеристик.ВидыРеквизитовКонтрагентов[ИмяВида];
	Набор = РегистрыСведений.РеквизитыКонтрагентов.СоздатьНаборЗаписей();
	Набор.Отбор.Контрагент.Установить(Владелец);
	Набор.Отбор.Реквизит.Установить(Вид);
	Запись = Набор.Добавить();
	Запись.Период = Дата(2000, 1, 1);
	Запись.Контрагент = Владелец;
	Запись.Реквизит = Вид;
	Запись.Представление = Значение;
	Запись.Значение = Значение;
	Набор.Записать();

КонецПроцедуры

Функция ВозвратДляAvoir(Контекст, ИмяДокумента, Основание, Причина)

	Док = НовыйДокумент(Контекст, ИмяДокумента);
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	Док.Контрагент = Основание.Контрагент;
	Док.Договор = Основание.Договор;
	Док.Основание = Основание.Ссылка;
	Док.ПричинаВозврата = Причина;
	Док.ЦенаВключаетНДС = Истина;
	// BSLLS:MagicNumber-off - количество и цена строки возврата.
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Основание.ТЧТовары[0].Номенклатура, 1, 60);
	// BSLLS:MagicNumber-on
	Записать(Док);
	Возврат Док;

КонецФункции

Функция ПоступлениеДляАкта(Контекст)

	Док = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПоставщика;
	Док.ЦенаВключаетНДС = Истина;
	Док.НомерВходящегоДокумента = "FRN-ACT-7";
	Док.ДатаВходящегоДокумента = Док.Дата;
	Услуга = НоваяНоменклатура(Контекст, "услуга акта", Перечисления.ТипыНоменклатуры.Услуга);
	// BSLLS:MagicNumber-off - количество и цена услуги.
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧУслуги", Услуга, 2, 45);
	// BSLLS:MagicNumber-on
	Док.ТЧУслуги[0].Содержание = ПометкаТеста() + ": содержание услуги поставщика";
	Записать(Док);
	Возврат Док;

КонецФункции

// Команды печати после фазы 4: «Товарная накладная (прежняя форма)» удалена, её заменяют Avoir возврата и Facture
// реализации - права на замену у ролей, у которых была прежняя команда (раздел 11.6 плана).
//
Процедура ПроверитьКомандыИПраваФазы4()

	Проверить(Метаданные.Документы.РеализацияТоваровУслуг.Команды.Найти("ПечатьТоварнаяНакладнаяOld") = Неопределено,
		"команды «Товарная накладная (прежняя форма)» нет");
	Для Каждого ИмяДокумента Из СтрРазделить("РеализацияТоваровУслуг,ВозвратОтПокупателя", ",") Цикл
		Команды = ПечатныеФормы.НоваяКоллекцияКомандПечати();
		Документы[ИмяДокумента].ДобавитьКомандыПечати(Команды);
		Проверить(Команды.Найти("FactureOld", "ИмяМакета") = Неопределено, ИмяДокумента + ": команды FactureOld нет");
	КонецЦикла;
	Просмотр = "Просмотр";
	Чтение = "Чтение";
	ПечатьВозврата = Метаданные.Документы.ВозвратОтПокупателя.Команды.ПечатьВозврат;
	Для Каждого ИмяРоли Из СтрРазделить("PDV,Казначей,Кладовщик,МенеджерПоПродажам,Оператор,ОператорПроизводства", ",") Цикл
		Роль = Метаданные.Роли[ИмяРоли];
		Проверить(ПравоДоступа(Просмотр, ПечатьВозврата, Роль), "Avoir возврата у роли " + ИмяРоли);
	КонецЦикла;
	Фактура = Метаданные.Документы.РеализацияТоваровУслуг.Команды.ПечатьТоварнаяНакладная;
	Для Каждого ИмяРоли Из СтрРазделить("PDV,Казначей,МенеджерПоПродажам", ",") Цикл
		Роль = Метаданные.Роли[ИмяРоли];
		Проверить(ПравоДоступа(Просмотр, Фактура, Роль), "Facture реализации у роли " + ИмяРоли);
	КонецЦикла;
	Проверить(Не ПравоДоступа(Просмотр, Фактура, Метаданные.Роли.ОператорПроизводства),
		"роли ОператорПроизводства Facture с ценами не добавлена");
	// Право на команду без права на её данные - отказ при печати (ревью плана фазы 4, круги 2-4): роли с Avoir читают
	// всё, что читает адаптер возврата без блока оплат.
	ДанныеAvoir = Новый Массив;
	ДанныеAvoir.Добавить(Метаданные.Документы.ВозвратОтПокупателя);
	ДанныеAvoir.Добавить(Метаданные.Документы.РеализацияТоваровУслуг);
	ДанныеAvoir.Добавить(Метаданные.Справочники.Контрагенты);
	ДанныеAvoir.Добавить(Метаданные.Справочники.Номенклатура);
	ДанныеAvoir.Добавить(Метаданные.Справочники.ПричиныВозвратов);
	ДанныеAvoir.Добавить(Метаданные.РегистрыСведений.РеквизитыКонтрагентов);
	ДанныеAvoir.Добавить(Метаданные.Справочники.БанковскиеСчета);
	Для Каждого ИмяРоли Из СтрРазделить("PDV,Казначей,Кладовщик,МенеджерПоПродажам,Оператор,ОператорПроизводства", ",") Цикл
		Роль = Метаданные.Роли[ИмяРоли];
		Для Каждого Объект Из ДанныеAvoir Цикл
			ЧтениеЕсть = ПравоДоступа(Чтение, Объект, Роль);
			Проверить(ЧтениеЕсть, "чтение " + Объект.ПолноеИмя() + " для Avoir у роли " + ИмяРоли);
		КонецЦикла;
	КонецЦикла;
	// Блок оплат и Facture - только ролям с правом на данные оплат (ФирменнаяПечать.НужныОплаты).
	Для Каждого ИмяРоли Из СтрРазделить("PDV,Казначей,МенеджерПоПродажам", ",") Цикл
		Роль = Метаданные.Роли[ИмяРоли];
		ЧтениеЕсть = ПравоДоступа(Чтение, Метаданные.Документы.ПриходныйКассовыйОрдер, Роль)
			И ПравоДоступа(Чтение, Метаданные.Справочники.БанковскиеЧеки, Роль);
		Проверить(ЧтениеЕсть, "чтение данных оплат для Facture у роли " + ИмяРоли);
	КонецЦикла;

КонецПроцедуры

// Фаза 5 (раздел 12.8 плана фирменной печати): бланк заказа, акт сверки трёх вариантов и квитанции ПКО и РКО на
// четырёх языках; построчные расхождения сторон акта, руководитель по уставу и факсимиле, вложение рассылки. Документы
// фазы добавляются в Счета - их печатают проверки правки общего макета и скрытых цен.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Счета    - Структура - см. ПроверитьСчетаФактуры; дополняется ключами Заказ, Сверка, Приход
//
Процедура ПроверитьФормыФазы5(Контекст, Счета)

	ПечатьОрганизации = Base64Значение("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk"
		+ "+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==");
	ЗаписатьПечатьОрганизации(Контекст.Организация, ПечатьОрганизации);
	Заказ = ЗаказДляПроформы(Контекст, Счета.Реализация.ТЧТовары[0].СтавкаНДС);
	Ордера = ОрдераДляКвитанций(Контекст);
	Сверка = СверкаДляАкта(Контекст, Счета.Реализация.Ссылка, Ордера.Приход.Ссылка);
	Счета.Вставить("Заказ", Заказ);
	Счета.Вставить("Сверка", Сверка);
	Счета.Вставить("Приход", Ордера.Приход);
	Для Каждого Язык Из Метаданные.Языки Цикл
		ПроверитьБланкЗаказаНаЯзыке(Заказ, Язык.КодЯзыка);
		ПроверитьАктСверкиНаЯзыке(Сверка, Язык.КодЯзыка);
		ПроверитьКвитанцииНаЯзыке(Ордера, Язык.КодЯзыка);
	КонецЦикла;
	ПроверитьПодписантаАкта(Сверка);
	ПроверитьРасхожденияСверки(Сверка, Ордера);
	// Рассылка актов собирает вложение тем же методом печати: массив ссылок, строка коллекции «АктСверки».
	Печать = ПечатныеФормы.СформироватьПечатныеФормы("Документ.СверкаВзаиморасчётов", "АктСверки",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сверка.Ссылка));
	СтрокаАкта = Печать.КоллекцияПечатныхФорм.Найти("АктСверки", "ИмяМакета");
	Вложение = ?(СтрокаАкта = Неопределено, Неопределено, СтрокаАкта.ТабличныйДокумент);
	Сформировано = ТипЗнч(Вложение) = Тип("ТабличныйДокумент") И Вложение.ВысотаТаблицы > 0;
	Проверить(Сформировано, "вложение рассылки акта сверки сформировано");

КонецПроцедуры

// Формы фазы 6 (раздел 13.8 плана): заказ поставщику, запросы котировок без фото и с фото, запрос цен предложения
// поставщика и письмо о платеже на всех языках; вложение рассылки заказов. Документы добавляются в Счета для проверок
// скрытых цен и устаревшей правки общего макета.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Счета    - Структура - см. ПроверитьСчетаФактуры, ПроверитьФормыФазы5
//
Процедура ПроверитьФормыФазы6(Контекст, Счета)

	ФотоТовара = Base64Значение("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==");
	ЗаписатьФотоНоменклатуры(Контекст.Товар, ФотоТовара);
	ЗаказПоставщику = ЗаказПоставщикуДляПечати(Контекст);
	Предложение = ПредложениеДляЗапросаЦен(Контекст, Счета.Заказ.Ссылка);
	Письмо = РасходДляПисьма(Контекст, Счета.Реализация.Ссылка);
	Счета.Вставить(ИмяЗаказаПоставщику(), ЗаказПоставщику);
	Счета.Вставить("Письмо", Письмо);
	Для Каждого Язык Из Метаданные.Языки Цикл
		КодЯзыка = Язык.КодЯзыка;
		ПроверитьЗаказПоставщикуНаЯзыке(ЗаказПоставщику, КодЯзыка);
		ПроверитьЗапросыКотировокНаЯзыке(ЗаказПоставщику, КодЯзыка);
		ПроверитьЗапросЦенНаЯзыке(Предложение, КодЯзыка);
		ПроверитьПисьмоНаЯзыке(Письмо, КодЯзыка);
	КонецЦикла;

	// Фото строк - в самих данных печати (раздел 13.2 плана): у товара с картинкой заполнено, у товара без неё - нет.
	Параметры = Новый Структура("СФото", Истина);
	Ссылки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗаказПоставщику.Ссылка);
	Данные = Документы.ЗаказПоставщику.ДанныеФирменнойПечати(Ссылки, "DemandeDeCotation", "ru", Параметры);
	Товары = Данные[ЗаказПоставщику.Ссылка].Данные.Товары;
	ПроверитьРавенство(2, Товары.Количество(), "запрос с фото: строки заказа");
	Проверить(ТипЗнч(Товары[0].Фото) = Тип("ДвоичныеДанные"), "запрос с фото: фото товара с картинкой в данных");
	Проверить(Товары[1].Фото = Неопределено, "запрос с фото: у товара без картинки фото нет");
	Без = Документы.ЗаказПоставщику.ДанныеФирменнойПечати(Ссылки, "DemandeDeCotation", "ru", Новый Структура);
	Проверить(Без[ЗаказПоставщику.Ссылка].Данные.Товары[0].Фото = Неопределено,
		"запрос без фото: фото не собираются");

	// Рассылка заказов собирает вложение тем же методом печати: массив ссылок, строка коллекции «ЗаказПоставщику».
	Печать = ПечатныеФормы.СформироватьПечатныеФормы("Документ." + ИмяЗаказаПоставщику(), ИмяЗаказаПоставщику(), Ссылки);
	СтрокаЗаказа = Печать.КоллекцияПечатныхФорм.Найти(ИмяЗаказаПоставщику(), "ИмяМакета");
	Вложение = ?(СтрокаЗаказа = Неопределено, Неопределено, СтрокаЗаказа.ТабличныйДокумент);
	Сформировано = ТипЗнч(Вложение) = Тип("ТабличныйДокумент") И Вложение.ВысотаТаблицы > 0;
	Проверить(Сформировано, "вложение рассылки заказа поставщику сформировано");
	ПроверитьОтказБезПраваНаКоманду(ЗаказПоставщику, Письмо);

КонецПроцедуры

// Серверный отказ печати без права на команду (раздел 13.8 плана) - через ту же цепочку, что окно печати и рассылка:
// СформироватьПечатныеФормы -> Печать менеджера. Раннер работает от администратора, а внешнюю обработку пользователь
// роли не откроет (права на внешние обработки нет ни у одной роли, кроме администратора) - право роли добавляет
// параметр РольПроверкиПрав, который только ужесточает проверку. МенеджерПоЗакупкам печатает заказ и запросы, но не
// письмо; Казначей читает заказ, но команд его печати не имеет. У PDV право на команду заказа есть, но без права на
// просмотр самого документа платформа считает команду недоступной - роль для проверки не подходит.
//
// Параметры:
//  ЗаказПоставщику - ДокументОбъект.ЗаказПоставщику - заказ сценария
//  Письмо          - Структура - см. РасходДляПисьма
//
Процедура ПроверитьОтказБезПраваНаКоманду(ЗаказПоставщику, Письмо)

	Закупки = Новый Структура("РольПроверкиПрав", "МенеджерПоЗакупкам");
	Казначей = Новый Структура("РольПроверкиПрав", "Казначей");
	Заказы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗаказПоставщику.Ссылка);
	Ордера = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Письмо.Расход.Ссылка);
	ИмяДокумента = "Документ." + ИмяЗаказаПоставщику();
	ВсеФормыЗаказа = ИмяЗаказаПоставщику() + ",ЗапросКотировок,ЗапросКотировокСФото";
	Печать = ПечатныеФормы.СформироватьПечатныеФормы(ИмяДокумента, ВсеФормыЗаказа, Заказы, Закупки);
	ПроверитьРавенство(3, Печать.КоллекцияПечатныхФорм.Количество(), "МенеджерПоЗакупкам: заказ и оба запроса печатаются");
	Запреты = Новый Массив;
	Запреты.Добавить(ВызовПечати(ИмяДокумента, ИмяЗаказаПоставщику(), Заказы, Казначей));
	Запреты.Добавить(ВызовПечати(ИмяДокумента, "ЗапросКотировокСФото", Заказы, Казначей));
	Запреты.Добавить(ВызовПечати("Документ.РасходныйКассовыйОрдер", "LettreDePaiement", Ордера, Закупки));
	// Подмена типа ссылки (ревью безопасности фазы 6, P0): у Казначея есть запрос цен предложения, но не печать заказа -
	// заказ, переданный в печать предложения, адаптер заказа не отдаёт.
	Запреты.Добавить(ВызовПечати("Документ.ПредложениеПоставщика", "ЗапросЦен", Заказы, Казначей));
	Для Каждого Вызов Из Запреты Цикл
		ТекстОшибки = "";
		Попытка
			ПечатныеФормы.СформироватьПечатныеФормы(Вызов.Документ, Вызов.Макеты, Вызов.Ссылки, Вызов.Параметры);
		Исключение
			ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		// Текст отказа - на языке сеанса; в шаблоне на всех языках имя формы в кавычках «».
		Отказ = ЗначениеЗаполнено(ТекстОшибки) И СтрНайти(ТекстОшибки, "«") > 0;
		Пояснение = Вызов.Параметры.РольПроверкиПрав + ": " + Вызов.Документ + " " + Вызов.Макеты;
		Проверить(Отказ, Пояснение + " - отказ без права на команду");
	КонецЦикла;

КонецПроцедуры

Функция ВызовПечати(Документ, Макеты, Ссылки, Параметры)

	Вызов = Новый Структура("Документ, Макеты, Ссылки", Документ, Макеты, Ссылки);
	Вызов.Вставить("Параметры", Параметры);
	Возврат Вызов;

КонецФункции

Процедура ЗаписатьФотоНоменклатуры(Номенклатура, Данные)

	// BSLLS:YoLetterUsage-off - имя регистра в метаданных.
	Запись = РегистрыСведений.ПрисоединённыеФайлы.СоздатьМенеджерЗаписи();
	// BSLLS:YoLetterUsage-on
	Запись.Объект = Номенклатура;
	Запись.Связь = Новый УникальныйИдентификатор;
	Запись.ID = Новый УникальныйИдентификатор;
	Запись.Данные = Новый ХранилищеЗначения(Данные);
	Запись.ИмяФайла = ПометкаТеста() + " фото";
	Запись.Расширение = "PNG";
	Запись.ДатаДобавления = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

// Заказ поставщику фазы 6: товар с упаковкой и картинкой, сырьё без упаковки; коды поставщика и производителя товара.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПоставщику - записанный заказ
//
Функция ЗаказПоставщикуДляПечати(Контекст)

	Товар = Контекст.Товар.ПолучитьОбъект();
	Товар.КодПоставщика = "FRN-" + СокрЛП(Контекст.Товар.Код);
	Товар.КодПроизводителя = "MFR-" + СокрЛП(Контекст.Товар.Код);
	Товар.Записать();
	Док = НовыйЗаказПоставщикуПотребности(Контекст, Неопределено);
	// BSLLS:MagicNumber-off - количества и цены строк.
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Контекст.Товар, 4, 75);
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Контекст.Сырье, 6, 12.5);
	// BSLLS:MagicNumber-on
	Док.ТЧТовары[1].Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	Док.Сумма = Док.ТЧТовары.Итог("СуммаСНДС");
	Записать(Док);
	Возврат Док;

КонецФункции

Функция ПредложениеДляЗапросаЦен(Контекст, ЗаказПокупателя)

	Док = НовыйДокумент(Контекст, "ПредложениеПоставщика");
	Док.ЗаказПокупателя = ЗаказПокупателя;
	Док.Поставщик = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПоставщика;
	Док.ЦенаВключаетНДС = Истина;
	// BSLLS:MagicNumber-off - количество и цена строки.
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Контекст.Товар, 3, 41.5);
	// BSLLS:MagicNumber-on
	Док.Сумма = Док.ТЧТовары.Итог("СуммаСНДС");
	Записать(Док);
	Возврат Док;

КонецФункции

// Расходный ордер письма о платеже: основания - поступление (номер и дата накладной BL поставщика) и реализация.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - второе основание
//
// Возвращаемое значение:
//  ДокументОбъект.РасходныйКассовыйОрдер - записанный ордер
//
Функция РасходДляПисьма(Контекст, Реализация)

	Поступление = ПоступлениеДляАкта(Контекст);
	Поступление.НомерОтгрузочногоДокумента = "BL-FRN-61";
	Поступление.ДатаОтгрузочногоДокумента = НачалоДня(Поступление.Дата);
	Записать(Поступление);
	Расход = НовыйДокумент(Контекст, "РасходныйКассовыйОрдер");
	Расход.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	Расход.Контрагент = Контекст.Контрагент;
	Расход.Договор = Контекст.ДоговорПоставщика;
	Расход.Касса = Контекст.Касса;
	Расход.ТипОплаты = Справочники.TypesDePayment.Cash;
	Расход.СтатьяДДС = СтатьяДДС(Контекст, Расход.ХозяйственнаяОперация);
	// BSLLS:MagicNumber-off - суммы ордера и оснований.
	Расход.Сумма = 432.1;
	Основание = Расход.ТЧОснования.Добавить();
	Основание.Основание = Поступление.Ссылка;
	Основание.Сумма = 400;
	Основание = Расход.ТЧОснования.Добавить();
	Основание.Основание = Реализация;
	Основание.Сумма = 32.1;
	// BSLLS:MagicNumber-on
	Расход.Выдать = ПометкаТеста() + ": выдать письмо";
	Расход.Кассир = Контекст.Сотрудник;
	Записать(Расход);
	Возврат Новый Структура("Расход, Поступление, Реализация", Расход, Поступление, Реализация);

КонецФункции

Процедура ПроверитьЗаказПоставщикуНаЯзыке(Заказ, КодЯзыка)

	Вид = ФирменнаяПечать.ОписаниеВида("CommandeFournisseur", КодЯзыка);
	Печать = ПечатьКоманды(ИмяЗаказаПоставщику(), ИмяЗаказаПоставщику(), Заказ.Ссылка, КодЯзыка);
	Пояснение = "заказ поставщику, " + КодЯзыка;
	ПроверитьТоварнуюФорму(Печать, Вид.Заголовок, Вид, Пояснение);
	ПроверитьПоставщикаВКолонкеПродавца(Печать, Вид, Заказ.Контрагент, Пояснение);
	Проверить(Печать.НайтиТекст(ФирменнаяПечать.НомерНакладной(Заказ.Номер, Заказ.Дата)) <> Неопределено,
		Пояснение + ": номер «N/ГГ»");
	Для Каждого Строка Из Заказ.ТЧТовары Цикл
		Проверить(Печать.НайтиТекст(ДеньгиПечати(Строка.Цена, КодЯзыка)) <> Неопределено, Пояснение + ": цена строки");
		Проверить(Печать.НайтиТекст(ДеньгиПечати(Строка.Сумма, КодЯзыка)) <> Неопределено, Пояснение + ": сумма строки");
	КонецЦикла;
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Заказ.Сумма, КодЯзыка)) <> Неопределено, Пояснение + ": итог заказа");
	Проверить(Печать.НайтиТекст(СокрЛП(Заказ.Ответственный)) <> Неопределено, Пояснение + ": ответственный");
	Проверить(Печать.НайтиТекст(Заказ.Комментарий) <> Неопределено, Пояснение + ": комментарий");

КонецПроцедуры

Процедура ПроверитьЗапросыКотировокНаЯзыке(Заказ, КодЯзыка)

	Вид = ФирменнаяПечать.ОписаниеВида("DemandeDeCotation", КодЯзыка);
	Товар = Заказ.ТЧТовары[0].Номенклатура;
	Коды = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Товар, "КодПоставщика, КодПроизводителя, Артикул");
	КартинокБезФото = 0;
	Для Каждого ИмяМакета Из СтрРазделить("ЗапросКотировок,ЗапросКотировокСФото", ",") Цикл
		Печать = ПечатьКоманды(ИмяЗаказаПоставщику(), ИмяМакета, Заказ.Ссылка, КодЯзыка);
		Пояснение = ИмяМакета + ", " + КодЯзыка;
		ПроверитьТоварнуюФорму(Печать, Вид.Заголовок, Вид, Пояснение);
		ПроверитьПоставщикаВКолонкеПродавца(Печать, Вид, Заказ.Контрагент, Пояснение);
		Проверить(Печать.НайтиТекст(Коды.КодПоставщика) <> Неопределено, Пояснение + ": код поставщика");
		Проверить(Печать.НайтиТекст(Коды.КодПроизводителя) <> Неопределено, Пояснение + ": код производителя");
		Если ЗначениеЗаполнено(Коды.Артикул) Тогда
			Проверить(Печать.НайтиТекст(СокрЛП(Коды.Артикул)) <> Неопределено, Пояснение + ": артикул");
		КонецЕсли;
		// Цен и итогов у запроса нет - как у прежней формы.
		Проверить(Печать.НайтиТекст(ДеньгиПечати(Заказ.ТЧТовары[0].Цена, КодЯзыка)) = Неопределено, Пояснение + ": без цен");
		Проверить(Печать.НайтиТекст(ДеньгиПечати(Заказ.Сумма, КодЯзыка)) = Неопределено, Пояснение + ": без итога");
		// Одноимённые рисунки строк платформа при выводе переименовывает - фото считается разницей непустых картинок
		// формы с фото и без (логотип у обеих одинаковый).
		Если ИмяМакета = "ЗапросКотировок" Тогда
			КартинокБезФото = КоличествоКартинок(Печать);
		Иначе
			ПроверитьРавенство(1, КоличествоКартинок(Печать) - КартинокБезФото, Пояснение + ": фото только у строки с картинкой");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЗапросЦенНаЯзыке(Предложение, КодЯзыка)

	Вид = ФирменнаяПечать.ОписаниеВида("DemandeDePrix", КодЯзыка);
	Печать = ПечатьКоманды("ПредложениеПоставщика", "ЗапросЦен", Предложение.Ссылка, КодЯзыка);
	Пояснение = "запрос цен, " + КодЯзыка;
	ПроверитьТоварнуюФорму(Печать, Вид.Заголовок, Вид, Пояснение);
	ПроверитьПоставщикаВКолонкеПродавца(Печать, Вид, Предложение.Поставщик, Пояснение);
	Проверить(Печать.НайтиТекст(ФирменнаяПечать.НомерНакладной(Предложение.Номер, Предложение.Дата)) <> Неопределено,
		Пояснение + ": номер «N/ГГ»");
	Строка = Предложение.ТЧТовары[0];
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Строка.Цена, КодЯзыка)) <> Неопределено, Пояснение + ": цена строки");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Предложение.Сумма, КодЯзыка)) <> Неопределено, Пояснение + ": итог");
	// Подписи «TRANSPORT : / CLIENT :» были подвалом чужого макета DevisBL_A4 (раздел 13.1 плана).
	Проверить(Печать.НайтиТекст("TRANSPORT") = Неопределено, Пояснение + ": подписей транспорта и клиента нет");

КонецПроцедуры

Процедура ПроверитьПисьмоНаЯзыке(Письмо, КодЯзыка)

	Вид = ФирменнаяПечать.ОписаниеВида("LettreDePaiement", КодЯзыка);
	Расход = Письмо.Расход;
	Печать = ПечатьКоманды("РасходныйКассовыйОрдер", "LettreDePaiement", Расход.Ссылка, КодЯзыка);
	Пояснение = "письмо о платеже, " + КодЯзыка;
	ПроверитьТоварнуюФорму(Печать, Вид.Заголовок, Вид, Пояснение);
	Проверить(Печать.НайтиТекст(СокрЛП(Расход.Контрагент)) <> Неопределено, Пояснение + ": получатель");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Расход.Сумма, КодЯзыка)) <> Неопределено, Пояснение + ": сумма");
	Валюта = ?(ЗначениеЗаполнено(Расход.Валюта), Расход.Валюта, РаботаСВалютами.ОсновнаяВалюта());
	Прописью = ПечатныеФормы.СуммаПрописью(Расход.Сумма, Валюта, КодЯзыка);
	Проверить(Печать.НайтиТекст(Прописью) <> Неопределено, Пояснение + ": сумма прописью");
	Проверить(Печать.НайтиТекст(СокрЛП(Расход.СтатьяДДС)) <> Неопределено, Пояснение + ": статья");
	// Способ оплаты - тип оплаты ордера; без него - постоянный текст вида (прежнее «Espèce»).
	Проверить(Печать.НайтиТекст(СокрЛП(Расход.ТипОплаты)) <> Неопределено, Пояснение + ": способ оплаты");
	// Основания - как в прежнем письме: номер документа; у поступления - номер и дата накладной поставщика.
	Поступление = Письмо.Поступление;
	Проверить(Печать.НайтиТекст(СокрЛП(Поступление.Номер)) <> Неопределено, Пояснение + ": номер поступления");
	Проверить(Печать.НайтиТекст(Поступление.НомерОтгрузочногоДокумента) <> Неопределено, Пояснение + ": номер BL");
	Проверить(Печать.НайтиТекст(ФорматДатыПечати(Поступление.ДатаОтгрузочногоДокумента, КодЯзыка)) <> Неопределено,
		Пояснение + ": дата BL");
	НомерРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Письмо.Реализация, "Номер");
	Проверить(Печать.НайтиТекст(СокрЛП(НомерРеализации)) <> Неопределено, Пояснение + ": номер реализации");
	Для Каждого Основание Из Расход.ТЧОснования Цикл
		Проверить(Печать.НайтиТекст(ДеньгиПечати(Основание.Сумма, КодЯзыка)) <> Неопределено, Пояснение + ": сумма основания");
	КонецЦикла;
	Проверить(Печать.НайтиТекст(Расход.Комментарий) <> Неопределено, Пояснение + ": комментарий");

КонецПроцедуры

Процедура ПроверитьПоставщикаВКолонкеПродавца(Печать, Вид, Поставщик, Пояснение)

	// Документы поставщику: поставщик - в левой колонке под подписью продавца, организация - справа (раздел 13.3).
	ОбластьПодписи = Печать.НайтиТекст(Вид.ПодписьПродавца);
	ОбластьПоставщика = Печать.НайтиТекст(СокрЛП(Поставщик.Наименование));
	Проверить(ОбластьПодписи <> Неопределено И ОбластьПоставщика <> Неопределено, Пояснение + ": поставщик на форме");
	Если ОбластьПодписи <> Неопределено И ОбластьПоставщика <> Неопределено Тогда
		Проверить(ОбластьПоставщика.Лево = ОбластьПодписи.Лево, Пояснение + ": поставщик в колонке продавца");
	КонецЕсли;

КонецПроцедуры

Функция КоличествоКартинок(ТабличныйДокумент)

	Количество = 0;
	Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл
		Если Рисунок.ТипРисунка = ТипРисункаТабличногоДокумента.Картинка И Рисунок.Картинка.Вид <> ВидКартинки.Пустая Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

// Команды и права фазы 6 (раздел 13.6 плана): прежние команды под прежними именами, состав прав на них прежний; роли
// с командой читают всё, что читает адаптер формы.
//
Процедура ПроверитьКомандыИПраваФазы6()

	Ожидаемые = Новый Соответствие;
	Ожидаемые.Вставить(ИмяЗаказаПоставщику(), ИмяЗаказаПоставщику() + ",ЗапросКотировок,ЗапросКотировокСФото");
	Ожидаемые.Вставить("ПредложениеПоставщика", "ЗапросЦен");
	Ожидаемые.Вставить("РасходныйКассовыйОрдер", "LettreDePaiement");
	Для Каждого Документ Из Ожидаемые Цикл
		Команды = ПечатныеФормы.НоваяКоллекцияКомандПечати();
		Документы[Документ.Ключ].ДобавитьКомандыПечати(Команды);
		Для Каждого ИмяМакета Из СтрРазделить(Документ.Значение, ",") Цикл
			Проверить(Команды.Найти(ИмяМакета, "ИмяМакета") <> Неопределено, Документ.Ключ + ": команда " + ИмяМакета);
		КонецЦикла;
	КонецЦикла;

	Просмотр = "Просмотр";
	Письмо = Метаданные.Документы.РасходныйКассовыйОрдер.Команды.PrintLettreDePaiement;
	// Администратор и Руководитель получают права на новые объекты автоматически (setForNewObjects) - у них письмо было.
	Для Каждого Роль Из Метаданные.Роли Цикл
		Если Роль.Имя <> "Администратор" И Роль.Имя <> "Руководитель" Тогда
			Проверить(Не ПравоДоступа(Просмотр, Письмо, Роль), "письмо о платеже у роли " + Роль.Имя + " не появилось");
		КонецЕсли;
	КонецЦикла;
	КомандыЗаказа = Метаданные.Документы.ЗаказПоставщику.Команды;
	Для Каждого Команда Из КомандыЗаказа Цикл
		Если СтрНачинаетсяС(Команда.Имя, "Печать") Тогда
			Проверить(ПравоДоступа(Просмотр, Команда, Метаданные.Роли.МенеджерПоЗакупкам),
				Команда.Имя + " у роли МенеджерПоЗакупкам");
			Проверить(Не ПравоДоступа(Просмотр, Команда, Метаданные.Роли.Казначей), Команда.Имя + " у роли Казначей нет");
		КонецЕсли;
	КонецЦикла;

	Карточки = "Справочник.Контрагенты,Справочник.Организации,Справочник.БанковскиеСчета,"
		+ "РегистрСведений.РеквизитыКонтрагентов,ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов";
	Строки = "Справочник.Номенклатура,Справочник.УпаковкиЕдиницыИзмерения,Справочник.ХарактеристикиНоменклатуры,"
		+ "Справочник.СтавкиНДС,Справочник.Валюты,Справочник.ДоговорыСКонтрагентами,Справочник.Пользователи,";
	ДанныеФорм = Новый Соответствие;
	ДанныеФорм.Вставить("Документ.ЗаказПоставщику.Команда.ПечатьЗаказПоставщику", "Документ.ЗаказПоставщику,"
		+ Строки + Карточки);
	ДанныеФорм.Вставить("Документ.ЗаказПоставщику.Команда.ПечатьЗапросКотировокСФото", "Документ.ЗаказПоставщику,"
		+ "РегистрСведений.ПрисоединённыеФайлы," + Строки + Карточки);
	ДанныеФорм.Вставить("Документ.ПредложениеПоставщика.Команда.ПечатьЗапросЦен", "Документ.ПредложениеПоставщика,"
		+ Строки + Карточки);
	Для Каждого Форма Из ДанныеФорм Цикл
		ПроверитьЧтениеДанныхКоманды(Форма.Ключ, СтрРазделить(Форма.Значение, ","));
	КонецЦикла;

КонецПроцедуры

Функция ИмяЗаказаПоставщику()

	Возврат "ЗаказПоставщику";

