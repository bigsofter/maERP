	Ордер.Заполнить(Заказ);
	Ордер.МестоХранения = Склад;
	Провести(Ордер);
	Возврат Ордер.Ссылка;
КонецФункции

Функция РеализацияПоОрдеру(Контекст, Ордер, Количество)
