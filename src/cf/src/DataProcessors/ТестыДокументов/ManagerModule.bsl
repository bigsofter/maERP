Функция ЕстьКомандаПечатиКП()

	Команды = ПечатныеФормы.КомандыПечатиОбъекта("Документ.РеализацияТоваровУслуг");
	Возврат Команды.Найти("КоммерческоеПредложение", "ИмяМакета") <> Неопределено;

