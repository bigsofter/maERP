КонецФункции

Функция НовыйКонтрагент()

	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.Наименование = ПометкаТеста() + ": контрагент";
	Контрагент.НаименованиеПолное = Контрагент.Наименование;
	Контрагент.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо;
	Контрагент.Покупатель = Истина;
	Контрагент.Поставщик = Истина;
	// Переработчиком может быть только субподрядчик (проверка заполнения передачи в переработку).
	Контрагент.Субподрядчик = Истина;
	Контрагент.ICE = "TEST3";
	Контрагент.Записать();
	Возврат Контрагент.Ссылка;

КонецФункции

Функция НовыйДоговор(Контекст, ВидДоговора)

	Договор = Справочники.ДоговорыСКонтрагентами.СоздатьЭлемент();
	// У договоров наименования нет (длина 0), текст договора - в реквизите Описание.
	Договор.Описание = ПометкаТеста() + ": " + Строка(ВидДоговора);
	Договор.Контрагент = Контекст.Контрагент;
	Договор.Организация = Контекст.Организация;
	Договор.ВидДоговора = ВидДоговора;
	Договор.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
	// BSLLS:YoLetterUsage-off
	Договор.ВалютаВзаиморасчётов = Контекст.Валюта;
	// BSLLS:YoLetterUsage-on
	Договор.ДатаДоговора = НачалоДня(Контекст.Дата);
	Договор.Основной = Истина;
	Договор.Записать();
	Возврат Договор.Ссылка;

КонецФункции

Функция НоваяКасса(Контекст)

	Касса = Справочники.Кассы.СоздатьЭлемент();
	Касса.Владелец = Контекст.Организация;
	Касса.Наименование = ПометкаТеста() + ": касса";
