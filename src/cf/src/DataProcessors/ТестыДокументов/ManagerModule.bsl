Функция ОрдераДляКвитанций(Контекст)

	Приход = НовыйДокумент(Контекст, "ПриходныйКассовыйОрдер");
	Приход.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	Приход.Контрагент = Контекст.Контрагент;
	Приход.Договор = Контекст.ДоговорПокупателя;
	Приход.Касса = Контекст.Касса;
	Приход.ТипОплаты = Справочники.TypesDePayment.Cash;
	Приход.СтатьяДДС = СтатьяДДС(Контекст, Приход.ХозяйственнаяОперация);
	// BSLLS:MagicNumber-off - сумма прихода.
	Приход.Сумма = 1234.5;
	// BSLLS:MagicNumber-on
	Приход.ПринятоОт = ПометкаТеста() + ": принято от";
	Приход.ОснованиеДляПечати = ПометкаТеста() + ": основание прихода";
	Приход.ВТомЧислеНДС = ПометкаТеста() + ": НДС прихода";
	Приход.Кассир = Контекст.Сотрудник;
	Записать(Приход);

	Расход = НовыйДокумент(Контекст, "РасходныйКассовыйОрдер");
	Расход.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	Расход.Контрагент = Контекст.Контрагент;
	Расход.Договор = Контекст.ДоговорПоставщика;
	Расход.Касса = Контекст.Касса;
	Расход.ТипОплаты = Справочники.TypesDePayment.Cash;
	Расход.СтатьяДДС = СтатьяДДС(Контекст, Расход.ХозяйственнаяОперация);
	// BSLLS:MagicNumber-off - сумма расхода.
	Расход.Сумма = 432.1;
	// BSLLS:MagicNumber-on
	Расход.Выдать = ПометкаТеста() + ": выдать";
	Расход.ОснованиеДляПечати = ПометкаТеста() + ": основание расхода";
	Расход.ПоДокументу = ПометкаТеста() + ": паспорт";
	Расход.Кассир = Контекст.Сотрудник;
	Записать(Расход);
	Возврат Новый Структура("Приход, Расход", Приход, Расход);

КонецФункции

// Акт сверки по нашим данным: строка реализации с одной ставкой НДС и строка ПКО с двумя ставками (РасшифровкаНДС),
// сальдо на начало 150 и на конец 350.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - регистратор первой строки
//  Приход     - ДокументСсылка.ПриходныйКассовыйОрдер - регистратор второй строки
//
// Возвращаемое значение:
//  ДокументОбъект.СверкаВзаиморасчётов - записанный акт
//
Функция СверкаДляАкта(Контекст, Реализация, Приход)

	Док = НовыйДокумент(Контекст, "СверкаВзаиморасчётов");
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПокупателя;
	Док.НачалоПериода = НачалоМесяца(Док.Дата);
	Док.КонецПериода = КонецДня(Док.Дата);
	// BSLLS:MagicNumber-off - суммы и ставки акта.
	Док.НачальныйОстаток = 150;
	Док.КонечныйОстаток = 350;
	Строка = Док.ТЧПоДаннымОрганизации.Добавить();
	Строка.Дата = Док.НачалоПериода;
	Строка.ДокументРегистратор = Реализация;
	Строка.ДокументПредставление = ПометкаТеста() + ": накладная акта";
	Строка.Дебет = 500;
	Строка.СтавкаНДС = НоваяСтавкаНДС(20);
	Строка.СуммаНДС = 83.33;
	Строка = Док.ТЧПоДаннымОрганизации.Добавить();
	Строка.Дата = Док.НачалоПериода;
	Строка.ДокументРегистратор = Приход;
	Строка.ДокументПредставление = ПометкаТеста() + ": оплата акта";
	Строка.Кредит = 300;
	Строка.НесколькоСтавокНДС = Истина;
	Расшифровка = Новый Массив;
	Расшифровка.Добавить(Новый Структура("СтавкаНДС, СуммаНДС, СуммаСНДС", XMLСтрока(НоваяСтавкаНДС(10)), 10, 110));
	Расшифровка.Добавить(Новый Структура("СтавкаНДС, СуммаНДС, СуммаСНДС", XMLСтрока(НоваяСтавкаНДС(7)), 12.6, 190));
	// BSLLS:MagicNumber-on
	Строка.РасшифровкаНДС = ОбщегоНазначенияКлиентСервер.КонвертироватьВJSON(Расшифровка);
	Записать(Док);
	Возврат Док;

КонецФункции

Процедура ПроверитьБланкЗаказаНаЯзыке(Заказ, КодЯзыка)

	Вид = ФирменнаяПечать.ОписаниеВида("BonDeCommande", КодЯзыка);
	Печать = ПечатьКоманды("ЗаказПокупателя", "ЗаказКлиента", Заказ.Ссылка, КодЯзыка);
	Пояснение = "бланк заказа, " + КодЯзыка;
	ПроверитьТоварнуюФорму(Печать, Вид.Заголовок, Вид, Пояснение);
	Строка = Заказ.ТЧТовары[0];
	Проверить(Печать.НайтиТекст(ФирменнаяПечать.НомерНакладной(Заказ.Номер, Заказ.Дата)) <> Неопределено,
		Пояснение + ": номер «N/ГГ»");
	Проверить(Печать.НайтиТекст(СокрЛП(Заказ.Контрагент.Наименование)) <> Неопределено, Пояснение + ": клиент");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(Строка.Цена, КодЯзыка)) <> Неопределено, Пояснение + ": цена строки");
	СуммаЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заказ.Ссылка, "Сумма");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(СуммаЗаказа, КодЯзыка)) <> Неопределено, Пояснение + ": итог");
	Если ЗначениеЗаполнено(Заказ.Ответственный) Тогда
		Проверить(Печать.НайтиТекст(СокрЛП(Заказ.Ответственный)) <> Неопределено, Пояснение + ": автор");
	КонецЕсли;
	Проверить(Печать.НайтиТекст(Вид.ПодписьЛевая) <> Неопределено И Печать.НайтиТекст(Вид.ПодписьПравая) <> Неопределено,
		Пояснение + ": подписи транспорта и клиента");
	ПодписьКредит = СокрЛП(Справочники.TypesDePayment.Credit) + ": ";
	Проверить(Печать.НайтиТекст(ПодписьКредит) = Неопределено, Пояснение + ": оплат прежний бланк не печатал");

КонецПроцедуры

Процедура ПроверитьАктСверкиНаЯзыке(Сверка, КодЯзыка)

	Вид = ФирменнаяПечать.ОписаниеВида("Releve", КодЯзыка);
	КодВалюты = СокрЛП(РаботаСВалютами.ОсновнаяВалюта());
	Для Каждого Команда Из СтрРазделить("АктСверки,АктСверкиСПечатью,АктСверкиБезНДС", ",") Цикл
		Печать = ПечатьКоманды("СверкаВзаиморасчётов", Команда, Сверка.Ссылка, КодЯзыка);
		Пояснение = Команда + ", " + КодЯзыка;
		ПроверитьТоварнуюФорму(Печать, Вид.Заголовок, Вид, Пояснение);
		// Значения прежней формы: номер, период, документы строк, дебет, кредит, сальдо на начало и конец.
		Проверить(Печать.НайтиТекст(СокрЛП(Сверка.Номер)) <> Неопределено, Пояснение + ": номер");
		Проверить(Печать.НайтиТекст(ФорматДатыПечати(Сверка.КонецПериода, КодЯзыка)) <> Неопределено,
			Пояснение + ": конец периода");
		Для Каждого Строка Из Сверка.ТЧПоДаннымОрганизации Цикл
			Проверить(Печать.НайтиТекст(Строка.ДокументПредставление) <> Неопределено, Пояснение + ": документ строки");
		КонецЦикла;
		// BSLLS:MagicNumber-off - суммы акта, см. СверкаДляАкта.
		Для Каждого Сумма Из СтрРазделить("500,300,150,350", ",") Цикл
			Проверить(Печать.НайтиТекст(ДеньгиПечати(Число(Сумма), КодЯзыка)) <> Неопределено, Пояснение + ": сумма " + Сумма);
		КонецЦикла;
		// Долг контрагента на конец периода - суммой в основной валюте и прописью на языке печати.
		Проверить(Печать.НайтиТекст(ДеньгиПечати(350, КодЯзыка) + " " + КодВалюты) <> Неопределено,
			Пояснение + ": долг в основной валюте");
		Прописью = ПечатныеФормы.СуммаПрописью(350, РаботаСВалютами.ОсновнаяВалюта(), КодЯзыка);
		Проверить(Печать.НайтиТекст(Прописью) <> Неопределено, Пояснение + ": долг прописью");
		// НДС по ставкам - у вариантов с НДС; ставки строки с несколькими ставками - из РасшифровкаНДС.
		ЕстьНДС = Команда <> "АктСверкиБезНДС";
		СуммыНДС = Новый Соответствие;
		СуммыНДС.Вставить("20 %", 83.33);
		СуммыНДС.Вставить("10 %", 10);
		СуммыНДС.Вставить("7 %", 12.6);
		Для Каждого Ставка Из СуммыНДС Цикл
			ТекстСтавки = Ставка.Ключ + ": " + ДеньгиПечати(Ставка.Значение, КодЯзыка);
			Проверить((Печать.НайтиТекст(ТекстСтавки) <> Неопределено) = ЕстьНДС, Пояснение + ": НДС " + Ставка.Ключ);
		КонецЦикла;
		// BSLLS:MagicNumber-on
		СПечатью = Команда = "АктСверкиСПечатью";
		Проверить(РисунокЗаполнен(Печать, "ПечатьПодписей") = СПечатью, Пояснение + ": печать организации");
		// Без данных контрагента акт не утверждает «расхождений не выявлено» (раздел 12.3 плана).
		Проверить(Печать.НайтиТекст("расхождений не выявлено") = Неопределено, Пояснение + ": нет утверждения о сверке");
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьКвитанцииНаЯзыке(Ордера, КодЯзыка)

	Вид = ФирменнаяПечать.ОписаниеВида("Recu", КодЯзыка);
	Для Каждого Ордер Из Ордера Цикл
		Док = Ордер.Значение;
		Расход = Ордер.Ключ = "Расход";
		ИмяДокумента = Док.Метаданные().Имя;
		Печать = ПечатьКоманды(ИмяДокумента, "Квитанция", Док.Ссылка, КодЯзыка);
		Пояснение = "квитанция " + ИмяДокумента + ", " + КодЯзыка;
		Проверить(Печать.НайтиТекст("[") = Неопределено И Печать.НайтиТекст("%1") = Неопределено,
			Пояснение + ": незаполненный шаблон");
		Проверить((Печать.НайтиТекст(Вид.ЗаголовокРасхода) <> Неопределено) = Расход, Пояснение + ": заголовок расхода");
		Проверить(Печать.НайтиТекст(Вид.Заголовок) <> Неопределено, Пояснение + ": заголовок");
		Проверить(Печать.НайтиТекст(Вид.ПодписьЛевая) <> Неопределено, Пояснение + ": подпись кассира");
		ПодписьКонтрагента = ?(Расход, Вид.ПодписьПродавца, Вид.ПодписьПокупателя);
		Проверить(Печать.НайтиТекст(ПодписьКонтрагента) <> Неопределено, Пояснение + ": плательщик или получатель");
		Валюта = ?(ЗначениеЗаполнено(Док.Валюта), Док.Валюта, РаботаСВалютами.ОсновнаяВалюта());
		Проверить(Печать.НайтиТекст(ДеньгиПечати(Док.Сумма, КодЯзыка)) <> Неопределено, Пояснение + ": сумма");
		Прописью = ПечатныеФормы.СуммаПрописью(Док.Сумма, Валюта, КодЯзыка);
		Проверить(Печать.НайтиТекст(Прописью) <> Неопределено, Пояснение + ": сумма прописью");
		Проверить(Печать.НайтиТекст(Док.ОснованиеДляПечати) <> Неопределено, Пояснение + ": основание");
		Плательщик = ?(Расход, Док.Выдать, Док.ПринятоОт);
		Проверить(Печать.НайтиТекст(Плательщик) <> Неопределено, Пояснение + ": принято от / выдать");
		Проверить(Печать.НайтиТекст(СокрЛП(Док.Кассир)) <> Неопределено, Пояснение + ": кассир");
		Если Расход Тогда
			Проверить(Печать.НайтиТекст(Док.ПоДокументу) <> Неопределено, Пояснение + ": по документу");
		Иначе
			Проверить(Печать.НайтиТекст(Док.ВТомЧислеНДС) <> Неопределено, Пояснение + ": в том числе НДС");
		КонецЕсли;
		Проверить(РисунокЗаполнен(Печать, "ПечатьПодписей"), Пояснение + ": печать организации");
	КонецЦикла;

КонецПроцедуры

// Руководитель организации в акте - по уставу, как прежний акт: более поздний руководитель по доверенности не
// печатается; факсимиле - подпись руководителя по уставу из регистра лиц с правом подписи, только «с печатью».
//
// Параметры:
//  Сверка - ДокументОбъект.СверкаВзаиморасчётов - акт сценария
//
Процедура ПроверитьПодписантаАкта(Сверка)

	ПоУставу = НовоеФизическоеЛицо();
	ОбъектЛица = ПоУставу.ПолучитьОбъект();
	ОбъектЛица.Фамилия = ПометкаТеста() + "Устав";
	ОбъектЛица.Записать();
	Факсимиле = Base64Значение("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8"
		+ "z8DwHwAFBQIAX8jx0gAAAABJRU5ErkJggg==");
	ПоДоверенности = НовоеФизическоеЛицо();
	ОбъектЛица = ПоДоверенности.ПолучитьОбъект();
	ОбъектЛица.Фамилия = ПометкаТеста() + "Доверенность";
	ОбъектЛица.Записать();
	СекундВДне = 86400;
	ЗаписатьРуководителя(Сверка.Организация, ПоУставу, Перечисления.ОснованияПраваПодписи.Устав,
		НачалоДня(Сверка.Дата) - 2 * СекундВДне, Факсимиле);
	ЗаписатьРуководителя(Сверка.Организация, ПоДоверенности, Перечисления.ОснованияПраваПодписи.Доверенность,
		НачалоДня(Сверка.Дата) - СекундВДне, Неопределено);

	Печать = ПечатьКоманды("СверкаВзаиморасчётов", "АктСверкиСПечатью", Сверка.Ссылка, "ru");
	Проверить(Печать.НайтиТекст(ПометкаТеста() + "Устав") <> Неопределено, "акт сверки: руководитель по уставу");
	Проверить(Печать.НайтиТекст(ПометкаТеста() + "Доверенность") = Неопределено,
		"акт сверки: руководитель по доверенности не печатается");
	Проверить(РисунокЗаполнен(Печать, "ПодписьПодписей"), "акт сверки с печатью: факсимиле руководителя");
	БезПечати = ПечатьКоманды("СверкаВзаиморасчётов", "АктСверки", Сверка.Ссылка, "ru");
	Проверить(Не РисунокЗаполнен(БезПечати, "ПодписьПодписей"), "акт сверки без печати: факсимиле нет");
	Данные = ДанныеАкта(Сверка, Новый Структура);
	Проверить(Данные.ПодписьРуководителя = Неопределено, "акт сверки без печати: факсимиле в данные не собирается");

КонецПроцедуры

Процедура ЗаписатьРуководителя(Организация, ФизическоеЛицо, Основание, Период, Факсимиле)

	Набор = РегистрыСведений.ЛицаСПравомПодписи.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(Период);
	Набор.Отбор.Организация.Установить(Организация);
	Набор.Отбор.ТипОтветственного.Установить(Перечисления.ТипыОтветственныхЛиц.Руководитель);
	Запись = Набор.Добавить();
	Запись.Период = Период;
	Запись.Организация = Организация;
	Запись.ТипОтветственного = Перечисления.ТипыОтветственныхЛиц.Руководитель;
	Запись.ФизическоеЛицо = ФизическоеЛицо;
	Запись.ОснованиеПраваПодписи = Основание;
	Запись.Подпись = Новый ХранилищеЗначения(Факсимиле);
	Набор.Записать();

КонецПроцедуры

// Построчная сверка сторон (раздел 12.2 плана): (а) зеркальные данные контрагента - расхождений нет, пункт 3 не
// утверждает их отсутствие; (б) взаимно компенсирующиеся расхождения - оба документа; (в) документ только у
// контрагента; (в') строки без регистратора с одинаковым представлением не склеиваются.
//
// Параметры:
//  Сверка - ДокументОбъект.СверкаВзаиморасчётов - акт сценария
//  Ордера - Структура - см. ОрдераДляКвитанций
//
Процедура ПроверитьРасхожденияСверки(Сверка, Ордера)

	// (а) зеркало наших данных.
	Сверка.ТЧПоДаннымКонтрагента.Очистить();
	Для Каждого Строка Из Сверка.ТЧПоДаннымОрганизации Цикл
		Зеркало = Сверка.ТЧПоДаннымКонтрагента.Добавить();
		ЗаполнитьЗначенияСвойств(Зеркало, Строка, "Дата, ДокументРегистратор, ДокументПредставление");
		Зеркало.Дебет = Строка.Кредит;
		Зеркало.Кредит = Строка.Дебет;
	КонецЦикла;
	Записать(Сверка);
	ПроверитьРавенство(0, РасхожденияАкта(Сверка).Количество(), "зеркальные данные контрагента: расхождений нет");
	Печать = ПечатьКоманды("СверкаВзаиморасчётов", "АктСверки", Сверка.Ссылка, "ru");
	Проверить(Печать.НайтиТекст("ВНЕСЕНО В ДОКУМЕНТ") <> Неопределено, "блок данных контрагента, внесённых в документ");
	Проверить(Печать.НайтиТекст("подтверждает отсутствие расхождений") <> Неопределено,
		"без расхождений - подтверждение подписью, а не утверждение");

	// (б) компенсирующиеся: у контрагента по накладной +100 к кредиту, по оплате +100 к дебету - нетто равны.
	// BSLLS:MagicNumber-off
	Сверка.ТЧПоДаннымКонтрагента[0].Кредит = 600;
	Сверка.ТЧПоДаннымКонтрагента[1].Дебет = 400;
	// (в) документ только у контрагента.
	Лишняя = Сверка.ТЧПоДаннымКонтрагента.Добавить();
	Лишняя.Дата = Сверка.НачалоПериода;
	Лишняя.ДокументРегистратор = Ордера.Расход.Ссылка;
	Лишняя.ДокументПредставление = ПометкаТеста() + ": только у контрагента";
	Лишняя.Дебет = 50;
	Записать(Сверка);
	Расхождения = РасхожденияАкта(Сверка);
	ПроверитьРавенство(3, Расхождения.Количество(), "компенсирующиеся расхождения и документ только у контрагента");
	Печать = ПечатьКоманды("СверкаВзаиморасчётов", "АктСверки", Сверка.Ссылка, "ru");
	Проверить(Печать.НайтиТекст("Выявлены расхождения") <> Неопределено, "пункт 3: выявлены расхождения");
	Проверить(Печать.НайтиТекст(Лишняя.ДокументПредставление) <> Неопределено, "расхождение: документ только у контрагента");

	// (в') две наши строки и одна строка контрагента без регистратора с одним представлением - не склеиваются.
	Сверка.ТЧПоДаннымКонтрагента.Очистить();
	ВозвратДня = ПометкаТеста() + ": возврат дня";
	ДобавитьСтрокуБезДокумента(Сверка.ТЧПоДаннымОрганизации, Сверка.НачалоПериода, ВозвратДня, 10, 0);
	ДобавитьСтрокуБезДокумента(Сверка.ТЧПоДаннымОрганизации, Сверка.НачалоПериода, ВозвратДня, 10, 0);
	ДобавитьСтрокуБезДокумента(Сверка.ТЧПоДаннымКонтрагента, Сверка.НачалоПериода, ВозвратДня, 0, 10);
	// BSLLS:MagicNumber-on
	Записать(Сверка);
	Расхождения = РасхожденияАкта(Сверка);
	БезДокумента = 0;
	Для Каждого Расхождение Из Расхождения Цикл
		Если Расхождение.Документ = ВозвратДня Тогда
			БезДокумента = БезДокумента + 1;
		КонецЕсли;
	КонецЦикла;
	ПроверитьРавенство(3, БезДокумента, "строки без регистратора с одним представлением не склеиваются");

КонецПроцедуры

Функция РасхожденияАкта(Сверка)

	Возврат ДанныеАкта(Сверка, Новый Структура).Сверка.Расхождения;

КонецФункции

Функция ДанныеАкта(Сверка, ПараметрыПечати)

	Ссылки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сверка.Ссылка);
	Менеджер = Документы[Сверка.Метаданные().Имя];
	Источники = Менеджер.ДанныеФирменнойПечати(Ссылки, "Releve", "ru", ПараметрыПечати);
	Возврат Источники[Сверка.Ссылка].Данные;

КонецФункции

Процедура ДобавитьСтрокуБезДокумента(ТабличнаяЧасть, Дата, Представление, Дебет, Кредит)

	Строка = ТабличнаяЧасть.Добавить();
	Строка.Дата = Дата;
	Строка.ДокументПредставление = Представление;
	Строка.Дебет = Дебет;
	Строка.Кредит = Кредит;

КонецПроцедуры

Функция РисунокЗаполнен(ТабличныйДокумент, ИмяРисунка)

	Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл
		Если Рисунок.Имя = ИмяРисунка И Рисунок.Картинка.Вид <> ВидКартинки.Пустая Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Команды и права фазы 5 (раздел 12.6 плана): прежние команды под прежними именами, квитанция у ролей с чеком ордеров;
// роли с командой читают всё, что читает адаптер формы (право на команду без права на данные - отказ при печати).
//
Процедура ПроверитьКомандыИПраваФазы5()

	Ожидаемые = Новый Соответствие;
	Ожидаемые.Вставить("ЗаказПокупателя", "ЗаказКлиента,Проформа,Заказ");
	Ожидаемые.Вставить("СверкаВзаиморасчётов", "АктСверки,АктСверкиСПечатью,АктСверкиБезНДС");
	Ожидаемые.Вставить("ПриходныйКассовыйОрдер", "Квитанция,Ticket,ПриходныйКассовыйОрдер");
	Ожидаемые.Вставить("РасходныйКассовыйОрдер", "Квитанция,Ticket,РасходныйКассовыйОрдер,LettreDePaiement");
	Для Каждого Документ Из Ожидаемые Цикл
		Команды = ПечатныеФормы.НоваяКоллекцияКомандПечати();
		Документы[Документ.Ключ].ДобавитьКомандыПечати(Команды);
		Для Каждого ИмяМакета Из СтрРазделить(Документ.Значение, ",") Цикл
			Проверить(Команды.Найти(ИмяМакета, "ИмяМакета") <> Неопределено, Документ.Ключ + ": команда " + ИмяМакета);
		КонецЦикла;
	КонецЦикла;

	Просмотр = "Просмотр";
	Квитанции = Новый Массив;
	Квитанции.Добавить(Метаданные.Документы.ПриходныйКассовыйОрдер.Команды.ПечатьКвитанции);
	Квитанции.Добавить(Метаданные.Документы.РасходныйКассовыйОрдер.Команды.ПечатьКвитанции);
	Для Каждого Команда Из Квитанции Цикл
		Для Каждого ИмяРоли Из СтрРазделить("PDV,Казначей", ",") Цикл
			Проверить(ПравоДоступа(Просмотр, Команда, Метаданные.Роли[ИмяРоли]), "квитанция у роли " + ИмяРоли);
		КонецЦикла;
		Проверить(Не ПравоДоступа(Просмотр, Команда, Метаданные.Роли.МенеджерПоПродажам),
			"квитанции у роли МенеджерПоПродажам нет: кассовых форм у неё не было");
	КонецЦикла;

	Карточки = "Справочник.Контрагенты,Справочник.Организации,Справочник.БанковскиеСчета,"
		+ "РегистрСведений.РеквизитыКонтрагентов,ПланВидовХарактеристик.ВидыРеквизитовКонтрагентов";
	ДанныеФорм = Новый Соответствие;
	ДанныеФорм.Вставить("Документ.ЗаказПокупателя.Команда.ПечатьЗаказаКлиента", "Документ.ЗаказПокупателя,"
		+ "Справочник.Номенклатура,Справочник.УпаковкиЕдиницыИзмерения,Справочник.СтавкиНДС,Справочник.Пользователи,"
		+ Карточки);
	ДанныеФорм.Вставить("Документ.СверкаВзаиморасчётов.Команда.ПечатьАктСверки", "Документ.СверкаВзаиморасчётов,"
		+ "РегистрСведений.ЛицаСПравомПодписи,РегистрСведений.ТарифныеСтавки,Справочник.Должности,"
		+ "Справочник.ФизическиеЛица,Справочник.СтавкиНДС," + Карточки);
	ДанныеФорм.Вставить("Документ.ПриходныйКассовыйОрдер.Команда.ПечатьКвитанции", "Документ.ПриходныйКассовыйОрдер,"
		+ "Справочник.Кассы,Справочник.СтатьиДвиженияДенежныхСредств,Справочник.ФизическиеЛица,Справочник.Валюты,"
		+ "Справочник.ДоговорыСКонтрагентами,Справочник.Пользователи," + Карточки);
	ДанныеФорм.Вставить("Документ.РасходныйКассовыйОрдер.Команда.ПечатьКвитанции", "Документ.РасходныйКассовыйОрдер,"
		+ "Справочник.Кассы,Справочник.СтатьиДвиженияДенежныхСредств,Справочник.ФизическиеЛица,Справочник.Валюты,"
		+ "Справочник.ДоговорыСКонтрагентами,Справочник.Пользователи," + Карточки);
	Для Каждого Форма Из ДанныеФорм Цикл
		ПроверитьЧтениеДанныхКоманды(Форма.Ключ, СтрРазделить(Форма.Значение, ","));
	КонецЦикла;

КонецПроцедуры

// Каждая роль с командой и правом чтения её документа читает все объекты, которые читает адаптер формы.
//
// Параметры:
//  ИмяКоманды    - Строка - полное имя команды документа
//  ИменаОбъектов - Массив из Строка - полные имена объектов данных адаптера
//
Процедура ПроверитьЧтениеДанныхКоманды(ИмяКоманды, ИменаОбъектов)

	Команда = Метаданные.НайтиПоПолномуИмени(ИмяКоманды);
	Проверить(Команда <> Неопределено, "команда " + ИмяКоманды);
	Для Каждого Роль Из Метаданные.Роли Цикл
		// Администратор - все права; у БухгалтерПоЗарплате команда акта без права на сам документ (раздел 12.1).
		Если Роль.Имя = "Администратор" Или Не ПравоДоступа("Просмотр", Команда, Роль)
			Или Не ПравоДоступа("Чтение", Команда.Родитель(), Роль) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИмяОбъекта Из ИменаОбъектов Цикл
			ЧтениеЕсть = ПравоДоступа("Чтение", Метаданные.НайтиПоПолномуИмени(ИмяОбъекта), Роль);
			Проверить(ЧтениеЕсть, "чтение " + ИмяОбъекта + " для " + ИмяКоманды + " у роли " + Роль.Имя);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Роль без цен (ОператорПроизводства): форма с вариантом без цен печатается без цен, форма без такого варианта - отказ.
// Раннер не умеет работать от пользователя роли - ветку включает параметр ЦеныСкрыты, который только ужесточает печать
// (раздел 11.6 плана). Отказ - последним шагом сценария.
//
// Параметры:
//  Счета - Структура - см. ПроверитьСчетаФактуры: Реализация со строками товаров и услуг; Заказ, Сверка, Приход -
//          документы фазы 5 (см. ПроверитьФормыФазы5)
//
Процедура ПроверитьСкрытиеЦен(Счета)

	Реализация = Счета.Реализация;
	Скрыть = Новый Структура("ЦеныСкрыты", Истина);
	// Бланк заказа - вариант без цен; акт сверки и квитанция - суммы суть формы, отказ (раздел 12.6 плана).
	Бланк = ПечатьКоманды("ЗаказПокупателя", "ЗаказКлиента", Счета.Заказ.Ссылка, "ru", Скрыть);
	ЦенаЗаказа = ДеньгиПечати(Счета.Заказ.ТЧТовары[0].Цена, "ru");
	Проверить(Бланк.НайтиТекст(ЦенаЗаказа) = Неопределено, "скрытые цены: бланк заказа без цен");
	// Заказ поставщику - без цен, запрос котировок с фото - печатается (цен у него нет), письмо о платеже - отказ
	// (раздел 13.6 плана).
	ЗаказПоставщику = Счета.ЗаказПоставщику;
	БезЦен = ПечатьКоманды(ИмяЗаказаПоставщику(), ИмяЗаказаПоставщику(), ЗаказПоставщику.Ссылка, "ru", Скрыть);
	Проверить(БезЦен.НайтиТекст(ДеньгиПечати(ЗаказПоставщику.ТЧТовары[0].Цена, "ru")) = Неопределено,
		"скрытые цены: заказ поставщику без цен");
	Запрос = ПечатьКоманды(ИмяЗаказаПоставщику(), "ЗапросКотировокСФото", ЗаказПоставщику.Ссылка, "ru", Скрыть);
	ЗапросБезФото = ПечатьКоманды(ИмяЗаказаПоставщику(), "ЗапросКотировок", ЗаказПоставщику.Ссылка, "ru", Скрыть);
	ПроверитьРавенство(1, КоличествоКартинок(Запрос) - КоличествоКартинок(ЗапросБезФото),
		"скрытые цены: запрос котировок с фото печатается с фото");
	Ссылки = Новый Соответствие;
	Ссылки.Вставить("СверкаВзаиморасчётов", Счета.Сверка.Ссылка);
	Ссылки.Вставить("ПриходныйКассовыйОрдер", Счета.Приход.Ссылка);
	Ссылки.Вставить("РасходныйКассовыйОрдер", Счета.Письмо.Расход.Ссылка);
	Для Каждого Команда Из СтрРазделить("СверкаВзаиморасчётов.АктСверки,ПриходныйКассовыйОрдер.Квитанция,"
		+ "РасходныйКассовыйОрдер.LettreDePaiement", ",") Цикл
		Части = СтрРазделить(Команда, ".");
		Ссылка = Ссылки[Части[0]];
		ОтказФормы = Ложь;
		Попытка
			ПечатьКоманды(Части[0], Части[1], Ссылка, "ru", Скрыть);
		Исключение
			ОтказФормы = Истина;
		КонецПопытки;
		Проверить(ОтказФормы, "скрытые цены: " + Команда + " не печатается");
	КонецЦикла;
	ИмяДокумента = Реализация.Метаданные().Имя;
	Печать = ПечатьКоманды(ИмяДокумента, "АктОбОказанииУслуг", Реализация.Ссылка, "ru", Скрыть);
	Проверить(Печать.НайтиТекст(СодержаниеУслугиКП()) <> Неопределено, "скрытые цены: акт печатается");
	СуммаУслуг = Реализация.ТЧУслуги.Итог("СуммаСНДС");
	Проверить(Печать.НайтиТекст(ДеньгиПечати(СуммаУслуг, "ru")) = Неопределено, "скрытые цены: в акте нет сумм");
	Отказ = Ложь;
	Попытка
		ПечатьКоманды(ИмяДокумента, "Facture", Реализация.Ссылка, "ru", Скрыть);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "скрытые цены: Facture не печатается");

КонецПроцедуры

Функция ДеньгиПечати(Сумма, КодЯзыка)

	Локализация = ПечатныеФормы.ЛокализацияФормата(КодЯзыка);
	Ноль = СтрЗаменить(Формат(1, "ЧДЦ=2; " + Локализация), "1", "0");
	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=" + Ноль + "; " + Локализация);

КонецФункции

Функция ФорматДатыПечати(Дата, КодЯзыка)

	Возврат Формат(Дата, "ДЛФ=D; " + ПечатныеФормы.ЛокализацияФормата(КодЯзыка));

КонецФункции

// Правка общего макета, сохранённая до сборки, добавившей области, не ломает печать: вид, которому не хватает
// области, печатается поставляемым макетом (план, раздел 3.4а). Запись регистра откатывается вместе со сценарием.
//
// Параметры:
//  Предложение        - ДокументСсылка.КоммерческоеПредложение - печатаемое предложение
//  НаименованиеСтроки - Строка - наименование первой строки на печати
//  Счета              - Структура - см. ПроверитьСчетаФактуры
//
Процедура ПроверитьУстаревшийПользовательскийМакет(Предложение, НаименованиеСтроки, Счета)

	ПутьМакета = "ОбщийМакет.ФирменныйДокумент";
	Макет = ПечатныеФормы.ПоставляемыйМакет(ПутьМакета);
	Макет.Области.СтрокаБезЦен.Имя = "СтрокаБезЦенПрежняя";
	// Правка, сохранённая на 2.0.16.68-69: областей Facture в ней нет.
	Макет.Области.СтрокаФактура.Имя = "СтрокаФактураПрежняя";
	Макет.Области.СтрокаНакладная.Имя = "СтрокаНакладнаяПрежняя";
	// Правка, сохранённая на 2.0.16.72: областей акта сверки и квитанции в ней нет.
	Макет.Области.СтрокаСверка.Имя = "СтрокаСверкаПрежняя";
	Макет.Области.КвитанцияСумма.Имя = "КвитанцияСуммаПрежняя";
	// Правка, сохранённая на 2.0.16.73: областей запроса котировок и письма в ней нет.
	Макет.Области.СтрокаКотировка.Имя = "СтрокаКотировкаПрежняя";
	Макет.Области.СтрокаПисьмо.Имя = "СтрокаПисьмоПрежняя";
	ПечатныеФормы.ЗаписатьПользовательскийМакет(ПутьМакета, Макет);
	Проверить(ПечатныеФормы.ИспользуетсяПользовательскийМакет(ПутьМакета), "пользовательская правка общего макета");
	Данные = Документы.КоммерческоеПредложение.ДанныеДляПечати(Предложение.ПолучитьОбъект());
	БезЦен = ФирменнаяПечать.ТабличныйДокументПоДанным(Данные, "КоммерческоеПредложение", "ru", "",
		Новый Структура("БезЦен", Истина));
	Проверить(БезЦен.НайтиТекст(НаименованиеСтроки) <> Неопределено,
		"правка без области вида: печать поставляемым макетом");
	Проверить(ПечатьПредложения(Предложение).НайтиТекст(НаименованиеСтроки) <> Неопределено,
		"правка без области вида: полная форма печатается правкой");
	Фактура = ПечатьКоманды("РеализацияТоваровУслуг", "Facture", Счета.Реализация.Ссылка, "fr");
	Проверить(Фактура.НайтиТекст(Счета.Реализация.ТЧТовары[0].Номенклатура.Наименование) <> Неопределено,
		"правка без областей Facture: Facture печатается поставляемым макетом");
	// Правка, сохранённая на 2.0.16.70-71: областей BL, Avoir и акта в ней нет.
	Накладная = ПечатьКоманды(Счета.Реализация.Метаданные().Имя, "BLA4", Счета.Реализация.Ссылка, "fr");
	Проверить(Накладная.НайтиТекст(Счета.Реализация.ТЧТовары[0].Номенклатура.Наименование) <> Неопределено,
		"правка без областей BL: накладная печатается поставляемым макетом");
	Акт = ПечатьКоманды("СверкаВзаиморасчётов", "АктСверки", Счета.Сверка.Ссылка, "fr");
	Проверить(Акт.НайтиТекст(Счета.Сверка.ТЧПоДаннымОрганизации[0].ДокументПредставление) <> Неопределено,
		"правка без областей акта сверки: акт печатается поставляемым макетом");
	Квитанция = ПечатьКоманды("ПриходныйКассовыйОрдер", "Квитанция", Счета.Приход.Ссылка, "fr");
	Проверить(Квитанция.НайтиТекст(Счета.Приход.ОснованиеДляПечати) <> Неопределено,
		"правка без областей квитанции: квитанция печатается поставляемым макетом");
	ЗаказПоставщику = Счета.ЗаказПоставщику;
	КодПоставщика = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказПоставщику.ТЧТовары[0].Номенклатура, "КодПоставщика");
	Запрос = ПечатьКоманды(ИмяЗаказаПоставщику(), "ЗапросКотировок", ЗаказПоставщику.Ссылка, "fr");
	Проверить(Запрос.НайтиТекст(КодПоставщика) <> Неопределено,
		"правка без областей запроса котировок: запрос печатается поставляемым макетом");
	ПисьмоОПлатеже = ПечатьКоманды("РасходныйКассовыйОрдер", "LettreDePaiement", Счета.Письмо.Расход.Ссылка, "fr");
	Проверить(ПисьмоОПлатеже.НайтиТекст(Счета.Письмо.Поступление.НомерОтгрузочногоДокумента) <> Неопределено,
		"правка без областей письма: письмо печатается поставляемым макетом");

	// Обработчик 2.0.16.68 только предупреждает о правке заменённого макета КП и не удаляет её.
	ПрежнийМакетКП = "Документ.КоммерческоеПредложение.КоммерческоеПредложение";
	ПечатныеФормы.ЗаписатьПользовательскийМакет(ПрежнийМакетКП, Макет);
	ОбновлениеПрограммыОбработчики.ПредупредитьОЗамененномМакетеКП();
	Проверить(ПечатныеФормы.ИспользуетсяПользовательскийМакет(ПрежнийМакетКП),
		"правка заменённого макета КП после обработчика обновления сохранена");

	// Обработчик 2.0.16.70 так же только предупреждает о правках макетов Facture и счетов.
	ПрежнийМакетПроформы = "Документ.РеализацияТоваровУслуг.DevisBL_A4";
	ПечатныеФормы.ЗаписатьПользовательскийМакет(ПрежнийМакетПроформы, Макет);
	ОбновлениеПрограммыОбработчики.ПредупредитьОЗамененныхМакетахФактуры();
	Проверить(ПечатныеФормы.ИспользуетсяПользовательскийМакет(ПрежнийМакетПроформы),
		"правка макета DevisBL_A4 после обработчика обновления фазы 3 сохранена");

	// Обработчик 2.0.16.72 - правки макетов накладных, акта и FactureOld так же сохраняются.
	Для Каждого ПрежнийМакет Из СтрРазделить("Документ.РеализацияТоваровУслуг.DevisBL,"
		+ "Документ.РеализацияТоваровУслуг.FactureOld,ОбщийМакет.АктОбОказанииУслуг", ",") Цикл
		ПечатныеФормы.ЗаписатьПользовательскийМакет(ПрежнийМакет, Макет);
	КонецЦикла;
	ОбновлениеПрограммыОбработчики.ПредупредитьОЗамененныхМакетахНакладных();
	ПравкиСохранены = ПечатныеФормы.ИспользуетсяПользовательскийМакет(ПрежнийМакетПроформы)
		И ПечатныеФормы.ИспользуетсяПользовательскийМакет("ОбщийМакет.АктОбОказанииУслуг")
		И ПечатныеФормы.ИспользуетсяПользовательскийМакет("Документ.РеализацияТоваровУслуг.DevisBL");
	Проверить(ПравкиСохранены, "правки макетов накладных и акта после обработчика обновления фазы 4 сохранены");

	// Обработчик 2.0.16.73 - правки макетов акта сверки и бланка заказа так же сохраняются.
	Для Каждого ПрежнийМакет Из СтрРазделить("Документ.СверкаВзаиморасчётов.АктСверки,"
		+ "Документ.СверкаВзаиморасчётов.АктСверкиБезНДС", ",") Цикл
		ПечатныеФормы.ЗаписатьПользовательскийМакет(ПрежнийМакет, Макет);
	КонецЦикла;
	ОбновлениеПрограммыОбработчики.ПредупредитьОЗамененныхМакетахСверки();
	ПравкиСохранены = ПечатныеФормы.ИспользуетсяПользовательскийМакет(ПрежнийМакетПроформы)
		И ПечатныеФормы.ИспользуетсяПользовательскийМакет("Документ.СверкаВзаиморасчётов.АктСверки")
		И ПечатныеФормы.ИспользуетсяПользовательскийМакет("Документ.СверкаВзаиморасчётов.АктСверкиБезНДС");
	Проверить(ПравкиСохранены, "правки макетов акта сверки и бланка заказа после обработчика обновления фазы 5 сохранены");

	// Обработчик 2.0.16.74 - правки макетов закупок и письма о платеже так же сохраняются.
	МакетыЗакупок = СтрРазделить("Документ.ЗаказПоставщику.ЗаказПоставщику,Документ.ЗаказПоставщику.ЗапросКотировок,"
		+ "Документ.РасходныйКассовыйОрдер.LettreDePaiement", ",");
	Для Каждого ПрежнийМакет Из МакетыЗакупок Цикл
		ПечатныеФормы.ЗаписатьПользовательскийМакет(ПрежнийМакет, Макет);
	КонецЦикла;
	ОбновлениеПрограммыОбработчики.ПредупредитьОЗамененныхМакетахЗакупок();
	ПравкиСохранены = ПечатныеФормы.ИспользуетсяПользовательскийМакет(ПрежнийМакетПроформы);
	Для Каждого ПрежнийМакет Из МакетыЗакупок Цикл
		ПравкиСохранены = ПравкиСохранены И ПечатныеФормы.ИспользуетсяПользовательскийМакет(ПрежнийМакет);
	КонецЦикла;
	Проверить(ПравкиСохранены, "правки макетов закупок и письма после обработчика обновления фазы 6 сохранены");

КонецПроцедуры

// Правка макета, удаленного из конфигурации в 2.0.16.75 (план, раздел 14.2): запись регистра не теряется - список
// макетов показывает ее строкой «удален из конфигурации», редактор открывает сохраненную правку и при выключенном
// использовании, поставляемого макета нет (понятное исключение), обработчик 2.0.16.75 запись не трогает, а команды
// под прежним именем макета печатают фирменную форму без правки. Запись откатывается вместе со сценарием.
//
// Параметры:
//  Счета - Структура - см. ПроверитьСчетаФактуры
//
Процедура ПроверитьПравкуУдаленногоМакета(Счета)

	ПутьУдаленногоМакета = "Документ.РеализацияТоваровУслуг.DevisBL";
	Проверить(Не ПечатныеФормы.МакетЕстьВКонфигурации(ПутьУдаленногоМакета), "макет DevisBL удален из конфигурации");
	Проверить(Не ПечатныеФормы.МакетЕстьВКонфигурации("ОбщийМакет.АктОбОказанииУслуг"),
		"общий макет акта удален из конфигурации");
	Проверить(ПечатныеФормы.МакетЕстьВКонфигурации("ОбщийМакет.ФирменныйДокумент"), "общий фирменный макет есть");
	Проверить(ПечатныеФормы.МакетЕстьВКонфигурации("Документ.РеализацияТоваровУслуг.Чек"), "макет чека реализации есть");

	МеткаПравки = "Правка удаленного макета " + Строка(Новый УникальныйИдентификатор);
	Правка = Новый ТабличныйДокумент;
	Правка.Область("R1C1").Текст = МеткаПравки;
	ПечатныеФормы.ЗаписатьПользовательскийМакет(ПутьУдаленногоМакета, Правка);
	ПечатныеФормы.УстановитьИспользованиеМакета(ПутьУдаленногоМакета, Ложь);

	Отбор = Новый Структура("ПутьКМакету", ПутьУдаленногоМакета);
	Строки = ПечатныеФормы.МакетыПечатныхФорм().НайтиСтроки(Отбор);
	ПроверитьРавенство(1, Строки.Количество(), "правка удаленного макета - одна строка в списке макетов");
	Если Строки.Количество() = 1 Тогда
		Проверить(Строки[0].ТребуетВнимания И Не Строки[0].Используется,
			"правка удаленного макета в списке: требует внимания, не используется");
		Проверить(СтрНайти(Строки[0].ПредставлениеМакета, "DevisBL") > 0, "правка удаленного макета: имя макета в списке");
	КонецЕсли;

	Редактор = ПечатныеФормы.ПравкаДляРедактирования(ПутьУдаленногоМакета);
	Проверить(Редактор.НетВКонфигурации, "редактор: макет удален из конфигурации");
	Проверить(Редактор.Макет.НайтиТекст(МеткаПравки) <> Неопределено,
		"редактор открывает сохраненную правку удаленного макета при выключенном использовании");
	Проверить(Не ПечатныеФормы.ПравкаДляРедактирования("Документ.РеализацияТоваровУслуг.Чек").НетВКонфигурации,
		"редактор: макет чека не удален");

	ТекстОшибки = "";
	Попытка
		ПечатныеФормы.ПоставляемыйМакет(ПутьУдаленногоМакета);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	Проверить(СтрНайти(ТекстОшибки, ПутьУдаленногоМакета) > 0, "поставляемого макета удаленного нет - исключение с путем макета");

	ОбновлениеПрограммыОбработчики.ПредупредитьОбУдаленныхМакетах();
	Проверить(ПечатныеФормы.ПравкаДляРедактирования(ПутьУдаленногоМакета).Макет.НайтиТекст(МеткаПравки) <> Неопределено,
		"правка удаленного макета после обработчика обновления фазы 7 сохранена");

	ПечатныеФормы.УстановитьИспользованиеМакета(ПутьУдаленногоМакета, Истина);
	Реализация = Счета.Реализация;
	Наименование = Реализация.ТЧТовары[0].Номенклатура.Наименование;
	Накладная = ПечатьКоманды(Реализация.Метаданные().Имя, "DevisBL", Реализация.Ссылка, "fr");
	Проверить(Накладная.НайтиТекст(Наименование) <> Неопределено И Накладная.НайтиТекст(МеткаПравки) = Неопределено,
		"команда DevisBL печатает фирменную накладную, правка удаленного макета не подмешивается");
	Фактура = ПечатьКоманды(Реализация.Метаданные().Имя, "Facture", Реализация.Ссылка, "fr");
	Проверить(Фактура.НайтиТекст(Наименование) <> Неопределено, "Facture печатается при правке удаленного макета");

КонецПроцедуры

Функция ПечатьПредложения(Предложение, Версия = Неопределено, КодЯзыка = "")

	ПараметрыПечати = Новый Структура;
	Если Версия <> Неопределено Тогда
		ПараметрыПечати.Вставить("Версия", Версия);
	КонецЕсли;
	Результат = ПечатныеФормы.СформироватьПечатныеФормы("Документ.КоммерческоеПредложение", "КоммерческоеПредложение",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Предложение), ПараметрыПечати, КодЯзыка);
	ТабличныйДокумент = Результат.КоллекцияПечатныхФорм[0].ТабличныйДокумент;
	Проверить(ТипЗнч(ТабличныйДокумент) = Тип("ТабличныйДокумент") И ТабличныйДокумент.ВысотаТаблицы > 0,
		"печатная форма коммерческого предложения пуста");
	Возврат ТабличныйДокумент;

КонецФункции

Функция ЛоготипПечати(ТабличныйДокумент)

	Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл
		Если Рисунок.Имя = "ЛоготипДокумента" И Рисунок.Картинка.Вид <> ВидКартинки.Пустая Тогда
			Возврат Base64Строка(Рисунок.Картинка.ПолучитьДвоичныеДанные());
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ЗаписатьЛоготипОрганизации(Организация, Данные)

	ОбъектОрганизации = Организация.ПолучитьОбъект();
	ОбъектОрганизации.Логотип = Новый ХранилищеЗначения(Данные);
	ОбъектОрганизации.Записать();

КонецПроцедуры

Процедура ПереименоватьНоменклатуру(Номенклатура, Наименование)

	ОбъектНоменклатуры = Номенклатура.ПолучитьОбъект();
	ОбъектНоменклатуры.Наименование = Наименование;
	ОбъектНоменклатуры.НаименованиеПолное = Наименование;
	ОбъектНоменклатуры.Записать();

КонецПроцедуры

Процедура ИзменитьКоличество(Предложение, Индекс, Количество)

	Строка = Предложение.ТЧТовары[Индекс];
	Строка.КоличествоУпаковок = Количество;
	Строка.Количество = Количество;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Строка, Предложение.ЦенаВключаетНДС);

КонецПроцедуры

// Возврат редакции, номенклатуры которой уже нет в базе: строка остаётся с пустой номенклатурой,
// отсутствующая ссылка называется в НеНайдено, печать редакции - с прежним наименованием из снимка.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьВозвратСУдаленнойНоменклатурой(Контекст)

	Удаляемый = НоваяНоменклатура(Контекст, "удаляемый товар редакции", Перечисления.ТипыНоменклатуры.Товар);
	НаименованиеУдаляемого = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Удаляемый, "НаименованиеПолное");
	Предложение = НовоеКоммерческоеПредложение(Контекст, Удаляемый, ПометкаТеста() + ": удалённая номенклатура");
	Предложение.Статус = Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	Записать(Предложение);
	Предложение.ТЧТовары[0].Номенклатура = Контекст.Товар;
	Записать(Предложение);
	ПроверитьРедакции(Предложение, 2, 2, Ложь, "замена удаляемой номенклатуры");
	Удаляемый.ПолучитьОбъект().Удалить();

	Содержимое = Документы.КоммерческоеПредложение.СодержимоеДляВозврата(Предложение.Ссылка, 1);
	ПроверитьРавенство(1, Содержимое.НеНайдено.Количество(), "удалённая номенклатура названа при возврате");
	Проверить(Не ЗначениеЗаполнено(Содержимое.Товары[0].Номенклатура), "номенклатура строки возврата очищена");
	ПроверитьРавенство(Предложение.ТЧТовары[0].Количество, Содержимое.Товары[0].Количество,
		"количество строки возврата - из снимка");
	Проверить(ПечатьПредложения(Предложение.Ссылка, 1).НайтиТекст(НаименованиеУдаляемого) <> Неопределено,
		"печать редакции с удалённой номенклатурой - прежнее наименование из снимка");

КонецПроцедуры

// КП, отправленное до учёта редакций (записано загрузкой без снимков): первая обычная запись сначала
// фиксирует v1 из базы, затем текущее содержимое.
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Товар     - СправочникСсылка.Номенклатура - товар предложения
//  ВЧерновик - Булево - первая правка переводит предложение в черновик
//
Процедура ПроверитьНачальнуюРедакцию(Контекст, Товар, ВЧерновик)

	Предложение = НовоеКоммерческоеПредложение(Контекст, Товар, ПометкаТеста() + ": до учёта редакций");
	Предложение.Статус = Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	Предложение.ОбменДанными.Загрузка = Истина;
	Предложение.Записать();
	Предложение = Предложение.Ссылка.ПолучитьОбъект();
	ПроверитьРедакции(Предложение, 0, 0, Ложь, "отправлено до учёта редакций");
	ПрежнееКоличество = Предложение.ТЧТовары[0].Количество;

	ИзменитьКоличество(Предложение, 0, ПрежнееКоличество + 1);
	Если ВЧерновик Тогда
		Предложение.Статус = Перечисления.СтатусыКоммерческихПредложений.Черновик;
		Записать(Предложение);
		ПроверитьРедакции(Предложение, 1, 1, Истина, "первая правка старого КП в черновик");
	Иначе
		Записать(Предложение);
		ПроверитьРедакции(Предложение, 2, 2, Ложь, "первая правка старого КП");
	КонецЕсли;
	Снимок = Документы.КоммерческоеПредложение.ДанныеРедакции(Предложение.Ссылка, 1);
	ПроверитьРавенство(ПрежнееКоличество, Снимок.Объект.Товары[0].Количество, "v1 - состояние из базы до правки");

КонецПроцедуры

// Решение о снимке от прошлой попытки записи не переживает: запись загрузкой с подложенным «отложенным»
// снимком редакцию не создаёт.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Товар    - СправочникСсылка.Номенклатура - товар предложения
//
Процедура ПроверитьСбросОтложенныхРедакций(Контекст, Товар)

	Предложение = НовоеКоммерческоеПредложение(Контекст, Товар, ПометкаТеста() + ": сброс отложенных");
	Записать(Предложение);
	Подложенный = Новый Массив;
	ПодложеннаяРедакция = Новый Структура("Версия, Хеш, Снимок, Сумма, Валюта");
	ПодложеннаяРедакция.Версия = 7;
	Подложенный.Добавить(ПодложеннаяРедакция);
	Предложение.ДополнительныеСвойства.Вставить("ОтложенныеРедакцииКП", Подложенный);
	Предложение.ОбменДанными.Загрузка = Истина;
	Предложение.Записать();
	ПроверитьРавенство(0, ЧислоРедакций(Предложение.Ссылка), "подложенный снимок не записан");

КонецПроцедуры

Процедура ПроверитьЗащитуАрхиваРедакций(Предложение)

	Набор = РегистрыСведений.РедакцииКоммерческихПредложений.СоздатьНаборЗаписей();
	Набор.Отбор.Предложение.Установить(Предложение);
	Набор.Отбор.Версия.Установить(1);
	Запись = Набор.Добавить();
	Запись.Предложение = Предложение;
	Запись.Версия = 1;
	Отказано = Ложь;
	Попытка
		Набор.Записать();
	Исключение
		Отказано = Истина;
	КонецПопытки;
	ПолучитьСообщенияПользователю(Истина);
	Проверить(Отказано, "архив редакций не пишется в обход документа");

КонецПроцедуры

// Вид операции заказа клиента (E4): умолчание, страховка записи, заполнение из отбора списка
// и по коммерческому предложению, смена у записанного заказа, представление и обработчик обновления.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВидОперацииЗаказа(Контекст)

	Продажа = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	ВидПроизводство = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;

	ЗаказПоУмолчанию = Документы.ЗаказПокупателя.СоздатьДокумент();
	ЗаказПоУмолчанию.Заполнить(Неопределено);
	ПроверитьРавенство(Продажа, ЗаказПоУмолчанию.ВидОперации, "значение заполнения нового заказа");

	ЗаказИзОтбора = Документы.ЗаказПокупателя.СоздатьДокумент();
	ЗаказИзОтбора.Заполнить(Новый Структура("ВидОперации", ВидПроизводство));
	ПроверитьРавенство(ВидПроизводство, ЗаказИзОтбора.ВидОперации,
		"заполнение из отбора списка (fillFromFillingValue)");

	// Вид операции очищается явно: проверяется страховка записи, а не то, применяет ли
	// СоздатьДокумент значения заполнения.
	ЗаказБезЗаполнения = ЗаказКлиентаСценария(Контекст);
	ЗаказБезЗаполнения.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.ПустаяСсылка();
	Записать(ЗаказБезЗаполнения);
	ПроверитьРавенство(Продажа, ЗаказБезЗаполнения.Ссылка.ВидОперации, "ПередЗаписью заполняет пустой вид операции");

	ЗаказБезЗаполнения.ВидОперации = ВидПроизводство;
	Записать(ЗаказБезЗаполнения);
	ПроверитьРавенство(ВидПроизводство, ЗаказБезЗаполнения.Ссылка.ВидОперации,
		"вид операции записанного заказа меняется");
	ПроверитьПредставлениеЗаказаНаПроизводство(ЗаказБезЗаполнения.Ссылка);

	// Вид операции заказа по КП задаёт команда, а не номенклатура предложения (решение владельца 2026-09-14).
	ОжидаемыйНаПроизводство = ?(ПолучитьФункциональнуюОпцию("Производство"), ВидПроизводство, Продажа);
	ПроверитьЗаказПоПредложению(Контекст, Контекст.Товар, Ложь, Продажа, "заказ клиента по КП с закупаемым товаром");
	ПроверитьЗаказПоПредложению(Контекст, Контекст.Продукция, Ложь, Продажа, "заказ клиента по КП с продукцией");
	ПроверитьЗаказПоПредложению(Контекст, Контекст.Товар, Истина, ОжидаемыйНаПроизводство,
		"заказ на производство по КП с закупаемым товаром");
	ПроверитьЗаказПоПредложению(Контекст, Контекст.Продукция, Истина, ОжидаемыйНаПроизводство,
		"заказ на производство по КП с продукцией");

	ПроверитьПредставлениеПродажи(Контекст);

	ЗаказДоОбновления = ЗаказКлиентаСценария(Контекст);
	ЗаказДоОбновления.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.ПустаяСсылка();
	ЗаказДоОбновления.ОбменДанными.Загрузка = Истина;
	ЗаказДоОбновления.Записать();
	Проверить(Не ЗначениеЗаполнено(ЗаказДоОбновления.Ссылка.ВидОперации),
		"режим загрузки сохраняет пустой вид операции до обновления");
	ОбновлениеПрограммыОбработчики.ЗаполнитьВидОперацииЗаказовПокупателей();
	ПроверитьРавенство(Продажа, ЗаказДоОбновления.Ссылка.ВидОперации, "обновление заполняет существующий заказ");
	ПроверитьРавенство(ВидПроизводство, ЗаказБезЗаполнения.Ссылка.ВидОперации,
		"обновление не меняет заполненный вид операции");
	ПроверитьРавенство(0, КоличествоЗаказовБезВидаОперации(), "после обновления нет заказов без вида операции");
	ОбновлениеПрограммыОбработчики.ЗаполнитьВидОперацииЗаказовПокупателей();
	ПроверитьРавенство(Продажа, ЗаказДоОбновления.Ссылка.ВидОперации, "повторное обновление сохраняет значение");
	ПроверитьРавенство(0, КоличествоЗаказовБезВидаОперации(), "повторное обновление идемпотентно");

	Возврат РезультатСценария("умолчание, отбор списка, страховка записи, смена вида, заказ клиента и заказ "
		+ "на производство по КП, представления продажи и производства, обновление и повтор");

КонецФункции

// Материалы заказа клиента на производство (E5): заполнение по технологическим картам и коды строк,
// пересчёт и согласование при записи, один состав одной продукции, заказ по коммерческому
// предложению и очистка материалов у заказа не на производство.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийМатериалыЗаказа(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;

	Заказ = ЗаказНаПроизводствоСценария(Контекст);
	ПроверитьЗаполнениеМатериаловЗаказа(Контекст, Заказ);
	ПроверитьСогласованиеМатериаловЗаказа(Контекст, Заказ);
	ПроверитьМатериалыЗаказаПоПредложению(Контекст);
	ПроверитьОтказЗаписиРазногоСостава(Контекст);

	Возврат РезультатСценария("заполнение по карте, коды строк, количество, пересчёт, смена номенклатуры и удаление "
		+ "строки, один состав продукции, заказ по КП, очистка у продажи, режим загрузки, отказ записи");

КонецФункции

// Заказ на производство с закупаемым товаром и продукцией с картой; коды строк обнулены, как у
// строк, добавленных штрихкодом.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя - незаписанный заказ, строки: товар, продукция
//
Функция ЗаказНаПроизводствоСценария(Контекст)

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция,
		Контекст.Числа.КоличествоПродажи, Контекст.Числа.ЦенаПродажи);
	Для Каждого СтрокаТоваров Из Заказ.ТЧТовары Цикл
		СтрокаТоваров.КодСтроки = 0;
	КонецЦикла;
	Возврат Заказ;

КонецФункции

// Материалы строки товаров заказа.
//
// Параметры:
//  Заказ         - ДокументОбъект.ЗаказПокупателя - заказ
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка товаров
//
// Возвращаемое значение:
//  Массив из СтрокаТабличнойЧасти - строки материалов
//
Функция МатериалыСтрокиЗаказа(Заказ, СтрокаТоваров)

	Возврат Заказ.ТЧМатериалы.НайтиСтроки(Новый Структура("КодСтрокиПродукции", СтрокаТоваров.КодСтроки));

КонецФункции

// Заполнение всех строк и одной строки: коды строк, состав и количество по карте, версия карты,
// упаковка по опции, позиция без карты, строка с повторным кодом.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументОбъект.ЗаказПокупателя - см. ЗаказНаПроизводствоСценария
//
Процедура ПроверитьЗаполнениеМатериаловЗаказа(Контекст, Заказ)

	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	КоличествоПродукции = Контекст.Числа.КоличествоПродажи;
	СтрокаТовара = Заказ.ТЧТовары[0];
	СтрокаПродукции = Заказ.ТЧТовары[1];

	Итог = Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата, ,
		Истина, Заказ);
	Проверить(СтрокаПродукции.КодСтроки > 0, "строка, получившая материалы, получает ненулевой код");
	ПроверитьРавенство(0, СтрокаТовара.КодСтроки, "код строки без карты заполнение не меняет");
	ПроверитьРавенство(1, Итог.Заполнено, "материалы по карте получила только строка продукции");
	ПроверитьРавенство(0, Итог.БезКарты.Количество(), "о закупаемом товаре без карты при заполнении всех строк не сообщается");
	ПроверитьРавенство(1, Заказ.ТЧМатериалы.Количество(), "одна строка материалов по карте продукции");
	Материал = Заказ.ТЧМатериалы[0];
	ПроверитьРавенство(Контекст.Сырье, Материал.Номенклатура, "материал из карты");
	ПроверитьРавенство(СтрокаПродукции.КодСтроки, Материал.КодСтрокиПродукции, "материал привязан к строке продукции");
	ПроверитьРавенство(Расход, Материал.КоличествоЗаЕдиницу, "количество за единицу из карты");
	ПроверитьРавенство(Расход * КоличествоПродукции, Материал.КоличествоУпаковок, "количество упаковок: расход × продукция");
	ПроверитьРавенство(Расход * КоличествоПродукции, Материал.Количество, "базовое количество материала");
	Версия = ТехнологическиеКарты.ТекущиеТехкарты(Контекст.Продукция, Заказ.Дата)[Контекст.Продукция].Версия;
	ПроверитьРавенство(Версия, СтрокаПродукции.Техкарта, "колонка Техкарта - действующая версия карты");
	ОжидаемаяУпаковка = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку"), Контекст.Единица,
		Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	ПроверитьРавенство(ОжидаемаяУпаковка, Материал.Упаковка, "упаковка материала - только при опции «Использовать упаковку»");

	Строки = Новый Массив;
	Строки.Добавить(СтрокаТовара);
	Итог = Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата,
		Строки, Ложь, Заказ);
	ПроверитьРавенство(1, Итог.БезКарты.Количество(), "о позиции без карты при заполнении строки сообщается");
	ПроверитьРавенство(0, МатериалыСтрокиЗаказа(Заказ, СтрокаТовара).Количество(), "у позиции без карты материалов нет");
	ПроверитьРавенство(1, Заказ.ТЧМатериалы.Количество(), "материалы другой строки не тронуты");

	КоличествоВторой = Контекст.Числа.КоличествоВыпуска;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, КоличествоВторой, Контекст.Числа.ЦенаПродажи);
	ВтораяСтрока = Заказ.ТЧТовары[2];
	ВтораяСтрока.КодСтроки = СтрокаПродукции.КодСтроки;
	Строки = Новый Массив;
	Строки.Добавить(ВтораяСтрока);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата, Строки, Ложь, Заказ);
	Проверить(ВтораяСтрока.КодСтроки <> СтрокаПродукции.КодСтроки, "строка с повторным кодом получает новый код");
	МатериалыВторой = МатериалыСтрокиЗаказа(Заказ, ВтораяСтрока);
	ПроверитьРавенство(1, МатериалыВторой.Количество(), "материалы получила переданная строка с повторным кодом");
	ПроверитьРавенство(Расход * КоличествоВторой, МатериалыВторой[0].КоличествоУпаковок,
		"количество второй строки считается от её количества");
	ПроверитьРавенство(1, МатериалыСтрокиЗаказа(Заказ, СтрокаПродукции).Количество(), "материалы исходной строки не заменены");

КонецПроцедуры

// Запись заказа на производство: пересчёт, один состав продукции, смена номенклатуры, удаление строки.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументОбъект.ЗаказПокупателя - заказ после ПроверитьЗаполнениеМатериаловЗаказа:
//             строки товар, продукция, продукция
//
Процедура ПроверитьСогласованиеМатериаловЗаказа(Контекст, Заказ)

	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	СтрокаТовара = Заказ.ТЧТовары[0];
	СтрокаПродукции = Заказ.ТЧТовары[1];
	ВтораяСтрока = Заказ.ТЧТовары[2];
	Записать(Заказ);
	ПроверитьРавенство(2, Заказ.Ссылка.ПолучитьОбъект().ТЧМатериалы.Количество(),
		"строки одной продукции с разным количеством и одним составом записываются");

	НовоеКоличество = Контекст.Числа.КоличествоЗакупки;
	СтрокаПродукции.КоличествоУпаковок = НовоеКоличество;
	СтрокаПродукции.Количество = НовоеКоличество;
	Записать(Заказ);
	ПроверитьРавенство(Расход * НовоеКоличество, МатериалыСтрокиЗаказа(Заказ, СтрокаПродукции)[0].Количество,
		"запись пересчитывает материалы по количеству продукции");

	МатериалВторой = МатериалыСтрокиЗаказа(Заказ, ВтораяСтрока)[0];
	МатериалВторой.КоличествоЗаЕдиницу = Расход + 1;
	Отказ = Ложь;
	Заказ.СогласоватьМатериалы(Отказ);
	Проверить(Отказ, "разный состав одной продукции в двух строках отклоняется");
	МатериалВторой.КоличествоЗаЕдиницу = Расход;

	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, 1, Контекст.Числа.ЦенаПродажи);
	СтрокаБезМатериалов = Заказ.ТЧТовары[3];
	СтрокаБезМатериалов.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Заказ.ТЧТовары);
	Отказ = Ложь;
	Заказ.СогласоватьМатериалы(Отказ);
	Проверить(Не Отказ, "строка той же продукции без материалов не считается другим составом");

	Характеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	Характеристика.Владелец = Контекст.Продукция;
	Характеристика.Наименование = ПометкаТеста() + ": характеристика продукции";
	Характеристика.Записать();
	СтрокаБезМатериалов.Характеристика = Характеристика.Ссылка;
	МатериалХарактеристики = Заказ.ТЧМатериалы.Добавить();
	ЗаполнитьЗначенияСвойств(МатериалХарактеристики, МатериалВторой);
	МатериалХарактеристики.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Заказ.ТЧМатериалы);
	МатериалХарактеристики.КодСтрокиПродукции = СтрокаБезМатериалов.КодСтроки;
	МатериалХарактеристики.КоличествоЗаЕдиницу = Расход + 1;
	Отказ = Ложь;
	Заказ.СогласоватьМатериалы(Отказ);
	Проверить(Отказ, "другая характеристика той же номенклатуры - та же продукция, разный состав отклоняется");
	Заказ.ТЧМатериалы.Удалить(МатериалХарактеристики);

	ВтораяСтрока.Номенклатура = Контекст.Товар;
	СтрокаТовара.КодСтроки = 0;
	Записать(Заказ);
	Проверить(Не ЗначениеЗаполнено(ВтораяСтрока.Техкарта), "смена номенклатуры очищает версию карты строки");
	ПроверитьРавенство(0, МатериалыСтрокиЗаказа(Заказ, ВтораяСтрока).Количество(), "смена номенклатуры очищает материалы строки");
	ПроверитьРавенство(0, СтрокаТовара.КодСтроки, "нулевой код строки без материалов запись не меняет");

	КодУдаленной = СтрокаПродукции.КодСтроки;
	Заказ.ТЧТовары.Удалить(СтрокаПродукции);
	Записать(Заказ);
	Отбор = Новый Структура("КодСтрокиПродукции", КодУдаленной);
	Оставшиеся = Заказ.Ссылка.ПолучитьОбъект().ТЧМатериалы.НайтиСтроки(Отбор);
	ПроверитьРавенство(0, Оставшиеся.Количество(), "удаление строки товаров удаляет её материалы");

КонецПроцедуры

// Заказ по коммерческому предложению с продукцией получает материалы сразу; у продажи материалы
// очищаются при записи; режим загрузки материалы не трогает; обычная продажа пишется как раньше.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьМатериалыЗаказаПоПредложению(Контекст)

	Предложение = НовоеКоммерческоеПредложение(Контекст, Контекст.Продукция, ПометкаТеста() + ": материалы по КП");
	Записать(Предложение);
	ЗаказПоПредложению = НовыйДокумент(Контекст, "ЗаказПокупателя");
	ЗаказПоПредложению.Заполнить(Новый Структура("Предложение, НаПроизводство", Предложение.Ссылка, Истина));
	ПроверитьРавенство(Перечисления.ВидыОперацийЗаказаПокупателя.Производство, ЗаказПоПредложению.ВидОперации,
		"заказ по КП с продукцией - на производство");
	ПроверитьРавенство(1, ЗаказПоПредложению.ТЧМатериалы.Количество(), "заказ по КП получает материалы сразу");
	Проверить(ЗначениеЗаполнено(ЗаказПоПредложению.ТЧТовары[0].Техкарта), "заказ по КП получает версию карты строки");
	Записать(ЗаказПоПредложению);

	ЗаказПоПредложению.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	Записать(ЗаказПоПредложению);
	ПроверитьРавенство(0, ЗаказПоПредложению.Ссылка.ПолучитьОбъект().ТЧМатериалы.Количество(),
		"у заказа не на производство материалы очищаются при записи");
	Проверить(Не ЗначениеЗаполнено(ЗаказПоПредложению.ТЧТовары[0].Техкарта), "у продажи версия карты строки очищается");

	Материал = ЗаказПоПредложению.ТЧМатериалы.Добавить();
	Материал.Номенклатура = Контекст.Сырье;
	Материал.КодСтрокиПродукции = ЗаказПоПредложению.ТЧТовары[0].КодСтроки;
	ЗаказПоПредложению.ОбменДанными.Загрузка = Истина;
	ЗаказПоПредложению.Записать();
	ПроверитьРавенство(1, ЗаказПоПредложению.Ссылка.ПолучитьОбъект().ТЧМатериалы.Количество(),
		"запись в режиме загрузки материалы не трогает");

	Продажа = ЗаказКлиентаСценария(Контекст);
	Продажа.ТЧТовары[0].КодСтроки = 0;
	Записать(Продажа);
	ПроверитьРавенство(0, Продажа.ТЧМатериалы.Количество(), "у продажи материалов нет");
	ПроверитьРавенство(0, Продажа.ТЧТовары[0].КодСтроки, "коды строк продажи запись не меняет");

КонецПроцедуры

// Настоящая запись с разным составом одной продукции отклоняется. Отказ записи оставляет транзакцию
// сценария пригодной только для отката, поэтому проверка - последняя.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказЗаписиРазногоСостава(Контекст)

	Заказ = ЗаказНаПроизводствоСценария(Контекст);
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, 1, Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата, , Истина, Заказ);
	ПроверитьРавенство(2, Заказ.ТЧМатериалы.Количество(), "обе строки продукции заполнены по карте");
	Заказ.ТЧМатериалы[1].КоличествоЗаЕдиницу = Заказ.ТЧМатериалы[0].КоличествоЗаЕдиницу + 1;
	Отклонено = Ложь;
	Попытка
		Заказ.Записать();
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	Проверить(Отклонено, "запись заказа с разным составом одной продукции отклоняется");

КонецПроцедуры

// Сценарий S2: разворачивание технологической карты в глубину. Проверяет саму функцию
// ТехнологическиеКарты.РазвернутыйСостав - правило остановки, перемножение количеств, предел глубины,
// цикл и кэш в пределах вызова. Документы здесь не участвуют: потребитель функции проверяется
// сценарием ИерархияМатериаловЗаказа.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийРазворачиваниеТехкарты(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;

	ПроверитьТриУровняРазворачивания(Контекст);
	ПроверитьПравилоОстановкиРазворачивания(Контекст);
	ПроверитьОтказыРазворачивания(Контекст);
	ПроверитьКэшРазворачивания(Контекст);
	ПроверитьПотерюМатериала(Контекст);

	Возврат РезультатСценария("три уровня до листьев и количество по цепочке, правило остановки "
		+ "(закупка, переработчик, «Оба», без карты, отменённая карта), предел глубины и цикл с цепочкой, "
		+ "кэш в пределах вызова, потеря материала округлением - отказ заполнения");

КонецФункции

// Три уровня до листьев: продукция -> полуфабрикат -> вложенный полуфабрикат -> сырьё. Количество
// перемножается по цепочке, уровни и связь с родителем проставлены, разворачиваемый узел помечен.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьТриУровняРазворачивания(Контекст)

	// BSLLS:MagicNumber-off - нормы цепочки: 2 ПФ1 на изделие, 3 ПФ2 на ПФ1, 5 сырья на ПФ2.
	Сырье = Контекст.Сырье;
	ПФ2 = НовыйПолуфабрикатСценария(Контекст, "ПФ2");
	ПФ1 = НовыйПолуфабрикатСценария(Контекст, "ПФ1");
	Изделие = НовоеИзделиеСценария(Контекст, "изделие трёх уровней");
	ЗаписатьКартуСценария(Контекст, ПФ2, СтрокаКартыСценария(Сырье, 5));
	ЗаписатьКартуСценария(Контекст, ПФ1, СтрокаКартыСценария(ПФ2, 3));
	ЗаписатьКартуСценария(Контекст, Изделие, СтрокаКартыСценария(ПФ1, 2));

	Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Изделие, Контекст.Дата);
	ПроверитьРавенство(0, Развернутый.Ошибки.Количество(), "исправная карта разворачивается без ошибок");
	ПроверитьРавенство(3, Развернутый.Строки.Количество(), "три уровня дают три узла");
	Дерево = РазвернутыйСоставСтрокой(Контекст, Развернутый);
	ПроверитьРавенство("ПФ1 1 2 да / ПФ2 2 6 да / сырьё 3 30 нет", Дерево,
		"уровни, количества по цепочке и признак потомков");
	// BSLLS:MagicNumber-on
	ПроверитьРавенство(-1, Развернутый.Строки[0].ИндексРодителя, "материал первого уровня без родителя");
	ПроверитьРавенство(Развернутый.Строки[0].Индекс, Развернутый.Строки[1].ИндексРодителя,
		"вложенный полуфабрикат висит на полуфабрикате");
	ПроверитьРавенство(Изделие, Развернутый.Строки[2].Продукция, "узел любого уровня помнит продукцию-владельца");

КонецПроцедуры

// Правило остановки: закупаемый полуфабрикат, полуфабрикат со способом изготовления «Переработчик»,
// позиция без карты и позиция с отменённой картой - листья; способ «Оба» разворачивается.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПравилоОстановкиРазворачивания(Контекст)

	// BSLLS:MagicNumber-off - нормы по единице на каждый полуфабрикат, сырьё по 4 на полуфабрикат.
	Сырье = Контекст.Сырье;
	Закупаемый = НовыйПолуфабрикатСценария(Контекст, "ПФ закупаемый", Перечисления.СпособыПополненияЗапасов.Закупка);
	Переработчик = НовыйПолуфабрикатСценария(Контекст, "ПФ переработчика");
	Оба = НовыйПолуфабрикатСценария(Контекст, "ПФ оба способа");
	БезКарты = НовыйПолуфабрикатСценария(Контекст, "ПФ без карты");
	Отмененный = НовыйПолуфабрикатСценария(Контекст, "ПФ с отменённой картой");
	СКартой = Новый Массив;
	СКартой.Добавить(Закупаемый);
	СКартой.Добавить(Переработчик);
	СКартой.Добавить(Оба);
	Для Каждого Позиция Из СКартой Цикл
		ЗаписатьКартуСценария(Контекст, Позиция, СтрокаКартыСценария(Сырье, 4));
	КонецЦикла;
	ЗаписатьКартуСценария(Контекст, Отмененный, СтрокаКартыСценария(Сырье, 4));
	// Отмена карты - пустой состав: маркерная запись, состав действующей версии пуст.
	ТехнологическиеКарты.ЗаписатьТехкарту(Отмененный, Неопределено, Контекст.Дата);

	Изделие = НовоеИзделиеСценария(Контекст, "изделие правила остановки");
	Строки = Новый Массив;
	Строки.Добавить(СтрокаКартыСценария(Закупаемый, 1));
	Строки.Добавить(СтрокаКартыСценария(Переработчик, 1, Перечисления.СпособыИзготовления.Переработчик));
	Строки.Добавить(СтрокаКартыСценария(Оба, 1, Перечисления.СпособыИзготовления.Оба));
	Строки.Добавить(СтрокаКартыСценария(БезКарты, 1));
	Строки.Добавить(СтрокаКартыСценария(Отмененный, 1));
	ЗаписатьКартуСценария(Контекст, Изделие, Строки);

	Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Изделие, Контекст.Дата);
	ПроверитьРавенство(0, Развернутый.Ошибки.Количество(), "правило остановки ошибок не заводит");
	Дерево = РазвернутыйСоставСтрокой(Контекст, Развернутый);
	// ПФ переработчика с одноуровневой картой разворачивается (2.0.16.103): его сырьё - потребность для передачи.
	ПроверитьРавенство("ПФ закупаемый 1 1 нет / ПФ переработчика 1 1 да / сырьё 2 4 нет / ПФ оба способа 1 1 да"
		+ " / сырьё 2 4 нет / ПФ без карты 1 1 нет / ПФ с отменённой картой 1 1 нет", Дерево,
		"закупка, отсутствие и отмена карты останавливают; «Оба» и одноуровневый переработчик разворачиваются");
	Граница = Развернутый.Строки.Найти(Переработчик, "Номенклатура");
	Проверить(Граница.ГраницаСписания, "ПФ переработчика - граница списания");
	Проверить(Не Развернутый.Строки.Найти(Оба, "Номенклатура").ГраницаСписания, "ПФ «Оба» - не граница");
	ПроверитьОстановкуПереработчика(Контекст);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Приоритеты правил остановки (2.0.16.103, план semi-finished-subcontract, R3, редакция 6): «Переработчик» разворачивается
// независимо от способа пополнения ПФ; «Закупка» - лист, даже если у позиции есть карта; ПФ переработчика с вложенным
// собственным ПФ - лист без ошибки разворачивания; запрещённый (НеРазворачивать) - лист.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОстановкуПереработчика(Контекст)

	// BSLLS:MagicNumber-off - нормы по единице, сырьё по 3.
	Способы = Перечисления.СпособыИзготовления;
	Сырье = Контекст.Сырье;
	ПереработчикОба = НовыйПолуфабрикатСценария(Контекст, "ПФ переработчика оба", Перечисления.СпособыПополненияЗапасов.Оба);
	ЗакупкаСКартой = НовыйПолуфабрикатСценария(Контекст, "ПФ закупка с картой");
	Вложенный = НовыйПолуфабрикатСценария(Контекст, "ПФ вложенный свой");
	Многоуровневый = НовыйПолуфабрикатСценария(Контекст, "ПФ переработчика многоуровневый");
	ЗаписатьКартуСценария(Контекст, ПереработчикОба, СтрокаКартыСценария(Сырье, 3));
	ЗаписатьКартуСценария(Контекст, ЗакупкаСКартой, СтрокаКартыСценария(Сырье, 3));
	ЗаписатьКартуСценария(Контекст, Вложенный, СтрокаКартыСценария(Сырье, 3));
	ЗаписатьКартуСценария(Контекст, Многоуровневый, СтрокаКартыСценария(Вложенный, 1));

	Изделие = НовоеИзделиеСценария(Контекст, "изделие приоритетов остановки");
	Строки = Новый Массив;
	Строки.Добавить(СтрокаКартыСценария(ПереработчикОба, 1, Способы.Переработчик));
	Строки.Добавить(СтрокаКартыСценария(ЗакупкаСКартой, 1, Способы.Закупка));
	Строки.Добавить(СтрокаКартыСценария(Многоуровневый, 1, Способы.Переработчик));
	ЗаписатьКартуСценария(Контекст, Изделие, Строки);

	Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Изделие, Контекст.Дата);
	ПроверитьРавенство(0, Развернутый.Ошибки.Количество(), "приоритеты остановки ошибок не заводят");
	СоставСтрокой = РазвернутыйСоставСтрокой(Контекст, Развернутый);
	ПроверитьРавенство("ПФ переработчика оба 1 1 да / сырьё 2 3 нет / ПФ закупка с картой 1 1 нет"
		+ " / ПФ переработчика многоуровневый 1 1 нет", СоставСтрокой,
		"переработчик при пополнении «Оба» - разворачивается; «Закупка» с картой и многоуровневый переработчик - листья");
	Запрет = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПереработчикОба);
	Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Изделие, Контекст.Дата, , Запрет);
	Проверить(Не Развернутый.Строки.Найти(ПереработчикОба, "Номенклатура").ЕстьПотомки,
		"ПФ из НеРазворачивать остаётся листом");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Норма мельче разрядности количества: три уровня по 0,005 дают 1,25e-7. Норма хранится с
// разрядностью ОпределяемыеТипы.НормаРасхода и цепочку переживает, а количество материала
// округляется разрядностью количества - и на маленьком заказе обнуляется. Заполнение такой строке
// отказывает, а на большом объёме тот же материал проходит.
// Сценарий на нормы 0,05 этого не ловит: 0,000125 в шести знаках представимо и до правки, и после.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПотерюМатериала(Контекст)

	Норма = 0.005;
	ПФ1 = НовыйПолуфабрикатСценария(Контекст, "ПФ мелкой нормы 1");
	ПФ2 = НовыйПолуфабрикатСценария(Контекст, "ПФ мелкой нормы 2");
	Изделие = НовоеИзделиеСценария(Контекст, "изделие мелкой нормы");
	ЗаписатьКартуСценария(Контекст, ПФ2, СтрокаКартыСценария(Контекст.Сырье, Норма));
	ЗаписатьКартуСценария(Контекст, ПФ1, СтрокаКартыСценария(ПФ2, Норма));
	ЗаписатьКартуСценария(Контекст, Изделие, СтрокаКартыСценария(ПФ1, Норма));

	Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Изделие, Контекст.Дата);
	ПроверитьРавенство(0, Развернутый.Ошибки.Количество(), "цепочка из трёх уровней разворачивается без ошибок");
	Лист = Неопределено;
	Для Каждого Узел Из Развернутый.Строки Цикл
		Если Узел.Номенклатура = Контекст.Сырье Тогда
			Лист = Узел;
		КонецЕсли;
	КонецЦикла;
	Проверить(Лист <> Неопределено, "сырьё дошло до листа дерева");
	ПроверитьРавенство(Норма * Норма * Норма, Лист.Количество,
		"норма по цепочке не обнулена разрядностью: 1,25e-7 живёт в типе нормы");

	// Большой объём: количество вытягивается обратно и материал остаётся в заказе.
	Большой = ЗаказКлиентаСценария(Контекст);
	Большой.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Большой, "ТЧТовары", Изделие, 10000, Контекст.Числа.ЦенаПродажи);
	ИтогБольшого = Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Большой.ТЧТовары,
		Большой.ТЧМатериалы, Большой.Дата);
	ПроверитьРавенство(1, ИтогБольшого.Заполнено, "на объёме 10000 материалы заполняются");
	ПроверитьРавенство(0, ИтогБольшого.СОшибками.Количество(), "на объёме 10000 отказа нет");
	МатериалСырья = Неопределено;
	Для Каждого Материал Из Большой.ТЧМатериалы Цикл
		Если Материал.Номенклатура = Контекст.Сырье Тогда
			МатериалСырья = Материал;
		КонецЕсли;
	КонецЦикла;
	Проверить(МатериалСырья <> Неопределено, "сырьё попало в материалы заказа");
	ПроверитьРавенство(Норма * Норма * Норма * 10000, МатериалСырья.Количество,
		"количество сырья вытянуто объёмом заказа");

	// Единица продукции: то же количество обнуляется - заполнению отказано, материалов нет.
	Малый = ЗаказКлиентаСценария(Контекст);
	Малый.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Малый, "ТЧТовары", Изделие, 1, Контекст.Числа.ЦенаПродажи);
	ИтогМалого = Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Малый.ТЧТовары,
		Малый.ТЧМатериалы, Малый.Дата);
	ПроверитьРавенство(0, ИтогМалого.Заполнено, "на объёме 1 заполнение отказано");
	ПроверитьРавенство(1, ИтогМалого.СОшибками.Количество(), "отказанная позиция названа в итоге");
	ПроверитьРавенство(0, Малый.ТЧМатериалы.Количество(), "материалов у отказанной строки не остаётся");
	ПроверитьРавенство(Документы.ТехнологическаяКарта.ПустаяСсылка(), Малый.ТЧТовары[0].Техкарта,
		"версия карты у отказанной строки очищена");

КонецПроцедуры

// Отказы разворачивания: цепочка глубже предела и кольцо в картах. Кольцо внутри предела обязано
// приходить сообщением про цикл, а не про глубину.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказыРазворачивания(Контекст)

	Предел = ТехнологическиеКарты.ПределГлубиныРазворачивания();
	// Число зафиксировано намеренно: остальная часть сценария параметризована пределом и смены
	// значения не заметит. Предел - решение владельца: четыре уровня, потому что норма хранится с
	// разрядностью НормаРасхода и на четвёртом уровне считается точно (0,05 в четвёртой = 6,25e-6).
	ПроверитьРавенство(4, Предел, "предел глубины разворачивания - четыре уровня");
	Цепочка = Новый Массив;
	Для Номер = 1 По Предел + 1 Цикл
		Звено = НовыйПолуфабрикатСценария(Контекст, "ПФ глубины " + Формат(Номер, "ЧН=0; ЧГ=0"));
		Цепочка.Добавить(Звено);
	КонецЦикла;
	ЗаписатьКартуСценария(Контекст, Цепочка[Предел], СтрокаКартыСценария(Контекст.Сырье, 1));
	Для Номер = 0 По Предел - 1 Цикл
		ЗаписатьКартуСценария(Контекст, Цепочка[Номер], СтрокаКартыСценария(Цепочка[Номер + 1], 1));
	КонецЦикла;
	Глубокое = НовоеИзделиеСценария(Контекст, "изделие за пределом глубины");
	ЗаписатьКартуСценария(Контекст, Глубокое, СтрокаКартыСценария(Цепочка[0], 1));

	Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Глубокое, Контекст.Дата);
	ПроверитьРавенство(1, Развернутый.Ошибки.Количество(), "цепочка за пределом глубины - одна ошибка");
	Текст = Развернутый.Ошибки[0].Текст;
	Проверить(СтрНайти(Текст, "глубже") > 0, "сообщение о превышении глубины: " + Текст);
	Проверить(СтрНайти(Текст, "→") > 0 И СтрНайти(Текст, Строка(Глубокое)) > 0,
		"в сообщении о глубине есть цепочка от продукции: " + Текст);
	ПроверитьРавенство(Предел, Развернутый.Строки.Количество(), "за предел глубины узлы в дерево не попадают");
	Для Каждого Узел Из Развернутый.Строки Цикл
		Проверить(Узел.Уровень <= Предел, "уровень узла не больше предела глубины");
	КонецЦикла;

	// Кольцо: изделие -> A -> B -> A. Ловится набором пройденных позиций, до предела глубины далеко.
	Кольцо1 = НовыйПолуфабрикатСценария(Контекст, "ПФ кольца A");
	Кольцо2 = НовыйПолуфабрикатСценария(Контекст, "ПФ кольца B");
	ЗаписатьКартуСценария(Контекст, Кольцо1, СтрокаКартыСценария(Кольцо2, 1));
	ЗаписатьКартуСценария(Контекст, Кольцо2, СтрокаКартыСценария(Кольцо1, 1));
	Закольцованное = НовоеИзделиеСценария(Контекст, "изделие с кольцом в картах");
	ЗаписатьКартуСценария(Контекст, Закольцованное, СтрокаКартыСценария(Кольцо1, 1));

	Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Закольцованное, Контекст.Дата);
	ПроверитьРавенство(1, Развернутый.Ошибки.Количество(), "кольцо в картах - одна ошибка");
	Текст = Развернутый.Ошибки[0].Текст;
	Проверить(СтрНайти(Текст, "зациклены") > 0, "кольцо приходит сообщением про цикл, а не про глубину: " + Текст);
	Проверить(СтрНайти(Текст, Строка(Кольцо1) + " → " + Строка(Кольцо2) + " → " + Строка(Кольцо1)) > 0,
		"в сообщении о цикле есть цепочка A → B → A: " + Текст);

КонецПроцедуры

// Кэш живёт в пределах вызова, а не в модуле повторного использования: карта, переписанная в той же
// транзакции, читается следующим вызовом заново.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьКэшРазворачивания(Контекст)

	// BSLLS:MagicNumber-off - норма 7 сырья на изделие, после правки карты 9.
	Изделие = НовоеИзделиеСценария(Контекст, "изделие для кэша");
	ЗаписатьКартуСценария(Контекст, Изделие, СтрокаКартыСценария(Контекст.Сырье, 7));
	Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Изделие, Контекст.Дата);
	ПроверитьРавенство(7, Развернутый.Строки[0].Количество, "норма первой версии карты");
	ЗаписатьКартуСценария(Контекст, Изделие, СтрокаКартыСценария(Контекст.Сырье, 9));
	Развернутый = ТехнологическиеКарты.РазвернутыйСостав(Изделие, Контекст.Дата);
	ПроверитьРавенство(9, Развернутый.Строки[0].Количество,
		"карта, переписанная в той же транзакции, читается заново");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Развёрнутый состав одной строкой для сравнения: «материал уровень количество есть-потомки» через « / »
// в порядке обхода. Наименования берутся без пометки теста, чтобы ожидание читалось.
//
// Параметры:
//  Контекст    - Структура - см. НовыйКонтекст
//  Развернутый - Структура - см. ТехнологическиеКарты.РазвернутыйСостав
//
// Возвращаемое значение:
//  Строка - представление дерева.
//
Функция РазвернутыйСоставСтрокой(Контекст, Развернутый)

	Звенья = Новый Массив;
	Для Каждого Строка Из Развернутый.Строки Цикл
		Название = НазваниеПозицииСценария(Строка.Номенклатура);
		Уровень = Формат(Строка.Уровень, "ЧН=0; ЧГ=0");
		Количество = Формат(Строка.Количество, "ЧН=0; ЧГ=0");
		Звено = СтрШаблон("%1 %2 %3 %4", Название, Уровень, Количество, ?(Строка.ЕстьПотомки, "да", "нет"));
		Звенья.Добавить(Звено);
	КонецЦикла;
	Возврат СтрСоединить(Звенья, " / ");

КонецФункции

// Наименование позиции без пометки теста.
//
// Параметры:
//  Позиция - СправочникСсылка.Номенклатура - позиция.
//
// Возвращаемое значение:
//  Строка - наименование без префикса прогона.
//
Функция НазваниеПозицииСценария(Позиция)

	Префикс = ПометкаТеста() + ": ";
	Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Позиция, "Наименование");
	Возврат ?(СтрНачинаетсяС(Наименование, Префикс), Сред(Наименование, СтрДлина(Префикс) + 1), Наименование);

КонецФункции

// Полуфабрикат сценария: тип «Полуфабрикат», способ пополнения по умолчанию «Производство» - такая
// позиция разворачивается по правилу Производство.ПроизводитсяПоТехкарте.
//
// Параметры:
//  Контекст         - Структура - см. НовыйКонтекст
//  Название         - Строка - наименование без пометки теста
//  СпособПополнения - ПеречислениеСсылка.СпособыПополненияЗапасов - способ пополнения позиции
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - записанный полуфабрикат
//
Функция НовыйПолуфабрикатСценария(Контекст, Название, СпособПополнения = Неопределено)

	Способ = ?(СпособПополнения = Неопределено, Перечисления.СпособыПополненияЗапасов.Производство, СпособПополнения);
	Возврат НоваяПозицияСценария(Контекст, Название, Перечисления.ТипыНоменклатуры.Полуфабрикат, Способ);

КонецФункции

// Изделие сценария: тип «Продукция», способ пополнения «Производство».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Название - Строка - наименование без пометки теста
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - записанное изделие
//
Функция НовоеИзделиеСценария(Контекст, Название)

	Возврат НоваяПозицияСценария(Контекст, Название, Перечисления.ТипыНоменклатуры.Продукция,
		Перечисления.СпособыПополненияЗапасов.Производство);

КонецФункции

// Номенклатура с заданным типом и способом пополнения: от НоваяНоменклатура отличается тем, что
// способ пополнения задаётся явно - от него зависит правило остановки разворачивания.
//
// Параметры:
//  Контекст         - Структура - см. НовыйКонтекст
//  Название         - Строка - наименование без пометки теста
//  ТипНоменклатуры  - ПеречислениеСсылка.ТипыНоменклатуры - тип позиции
//  СпособПополнения - ПеречислениеСсылка.СпособыПополненияЗапасов - способ пополнения
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - записанная позиция
//
Функция НоваяПозицияСценария(Контекст, Название, ТипНоменклатуры, СпособПополнения)

	Позиция = Справочники.Номенклатура.СоздатьЭлемент();
	Позиция.Наименование = ПометкаТеста() + ": " + Название;
	Позиция.НаименованиеПолное = Позиция.Наименование;
	Позиция.ТипНоменклатуры = ТипНоменклатуры;
	Позиция.СпособПополнения = СпособПополнения;
	Позиция.Единица = Контекст.Единица;
	Позиция.СтавкаНДС = Контекст.СтавкаНДС;
	Позиция.Записать();
	Возврат Позиция.Ссылка;

КонецФункции

// Описание строки состава карты для ЗаписатьКартуСценария.
//
// Параметры:
//  Материал   - СправочникСсылка.Номенклатура - материал строки
//  Количество - Число - количество на единицу продукции
//  Способ     - ПеречислениеСсылка.СпособыИзготовления, Неопределено - способ изготовления строки;
//               не задан - «Наше производство» проставит сам документ карты
//
// Возвращаемое значение:
//  Структура - Материал, Количество, Способ
//
Функция СтрокаКартыСценария(Материал, Количество, Способ = Неопределено)

	Возврат Новый Структура("Материал, Количество, Способ", Материал, Количество, Способ);

КонецФункции

// Записывает карту продукции по описаниям строк.
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Продукция - СправочникСсылка.Номенклатура - продукция карты
//  Строки    - Массив из Структура, Структура - см. СтрокаКартыСценария
//
// Возвращаемое значение:
//  ДокументСсылка.ТехнологическаяКарта - записанная версия карты
//
Функция ЗаписатьКартуСценария(Контекст, Продукция, Строки)

	Описания = ?(ТипЗнч(Строки) = Тип("Массив"), Строки, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Строки));
	Состав = Новый ТаблицаЗначений;
	Состав.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Состав.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Состав.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Состав.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Состав.Колонки.Добавить("СпособИзготовления", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыИзготовления"));
	Для Каждого Описание Из Описания Цикл
		Строка = Состав.Добавить();
		Строка.Номенклатура = Описание.Материал;
		Строка.Упаковка = Контекст.Единица;
		Строка.Количество = Описание.Количество;
		Если Описание.Способ <> Неопределено Тогда
			Строка.СпособИзготовления = Описание.Способ;
		КонецЕсли;
	КонецЦикла;
	Возврат ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Контекст.Дата);

КонецФункции

// Сценарий S3: иерархия материалов заказа на производство. Главная проверка - заказ с деревом
// материалов проводится и НЕ заводит новую версию технологической карты: одноуровневые потребители
// состава обязаны видеть только первый уровень, иначе проведение перезапишет карту продукции
// развёрнутым листовым составом. Плюс потребность и списание автовыпуском по листьям, удаление
// поддерева, копирование строки и материал, встречающийся и у продукции, и под полуфабрикатом.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийИерархияМатериаловЗаказа(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;

	Данные = ДанныеИерархииСценария(Контекст);
	ПроверитьЗаполнениеДереваМатериалов(Контекст, Данные);
	ПроверитьПроведениеЗаказаСДеревом(Контекст, Данные);
	ПроверитьПотребностьИСписаниеПоЛистьям(Контекст, Данные);
	ПроверитьУдалениеИКопированиеПоддерева(Контекст, Данные);
	ПроверитьНормализациюДереваМатериалов(Контекст, Данные);
	ПроверитьМатериалНаДвухУровнях(Контекст);

	Возврат РезультатСценария("заполнение дерева и коды родителей, проведение не заводит новую версию карты, "
		+ "потребность и нормы автовыпуска по листьям, удаление строки убирает поддерево, копирование строки "
		+ "переставляет родителей, нормализация кодов и отказ на кольце, материал у продукции и под "
		+ "полуфабрикатом не даёт отказа и раскладывается по обоим вхождениям");

КонецФункции

// Изделие с двухуровневой картой: изделие -> полуфабрикат (2 на изделие) -> сырьё (3 на полуфабрикат).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - Изделие, Полуфабрикат, НормаПолуфабриката, НормаСырья
//
Функция ДанныеИерархииСценария(Контекст)

	// BSLLS:MagicNumber-off - нормы двухуровневой карты сценария.
	НормаПолуфабриката = 2;
	НормаСырья = 3;
	// BSLLS:MagicNumber-on
	Полуфабрикат = НовыйПолуфабрикатСценария(Контекст, "ПФ иерархии");
	ЗаписатьКартуСценария(Контекст, Полуфабрикат, СтрокаКартыСценария(Контекст.Сырье, НормаСырья));
	Изделие = НовоеИзделиеСценария(Контекст, "изделие иерархии");
	Карта = ЗаписатьКартуСценария(Контекст, Изделие, СтрокаКартыСценария(Полуфабрикат, НормаПолуфабриката));
	Данные = Новый Структура;
	Данные.Вставить("Изделие", Изделие);
	Данные.Вставить("Полуфабрикат", Полуфабрикат);
	Данные.Вставить("Карта", Карта);
	Данные.Вставить("НормаПолуфабриката", НормаПолуфабриката);
	Данные.Вставить("НормаСырья", НормаСырья);
	Возврат Данные;

КонецФункции

// Заполнение по карте кладёт в заказ дерево: полуфабрикат первым уровнем, сырьё под ним, количество
// сырья перемножено по цепочке, а в строке товаров стоит версия карты ИЗДЕЛИЯ, а не полуфабриката.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеИерархииСценария
//
Процедура ПроверитьЗаполнениеДереваМатериалов(Контекст, Данные)

	Заказ = ЗаказИерархииСценария(Контекст, Данные);
	ПроверитьРавенство(2, Заказ.ТЧМатериалы.Количество(), "дерево двух уровней - две строки материалов");
	Узел = Заказ.ТЧМатериалы[0];
	Лист = Заказ.ТЧМатериалы[1];
	ПроверитьРавенство(Данные.Полуфабрикат, Узел.Номенклатура, "первым уровнем идёт полуфабрикат");
	ПроверитьРавенство(0, Узел.КодСтрокиРодителя, "у материала первого уровня родитель не заполнен");
	ПроверитьРавенство(Контекст.Сырье, Лист.Номенклатура, "под полуфабрикатом - его сырьё");
	ПроверитьРавенство(Узел.КодСтроки, Лист.КодСтрокиРодителя, "сырьё привязано к строке полуфабриката");
	ПроверитьРавенство(Узел.КодСтрокиПродукции, Лист.КодСтрокиПродукции,
		"код строки продукции одинаков на всех уровнях: по нему удаляется всё поддерево");
	ПроверитьРавенство(Данные.НормаПолуфабриката, Узел.КоличествоЗаЕдиницу, "норма полуфабриката - из карты изделия");
	ПроверитьРавенство(Данные.НормаПолуфабриката * Данные.НормаСырья, Лист.КоличествоЗаЕдиницу,
		"норма сырья перемножена по цепочке");
	ПроверитьРавенство(Данные.Карта, Заказ.ТЧТовары[0].Техкарта,
		"в строке товаров стоит версия карты изделия, а не полуфабриката");

КонецПроцедуры

// Главная проверка этапа: проведение заказа с деревом сверяет с картой ТОЛЬКО первый уровень, поэтому
// новой версии карты не заводит и состав карты изделия остаётся одноуровневым.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеИерархииСценария
//
Процедура ПроверитьПроведениеЗаказаСДеревом(Контекст, Данные)

	Заказ = ЗаказИерархииСценария(Контекст, Данные);
	Отказ = Ложь;
	Решения = Заказ.ПроверитьПроведениеЗаказа(Отказ);
	Проверить(Не Отказ, "заказ с деревом материалов проводится");
	Решение = Решения[Данные.Изделие];
	Проверить(Решение <> Неопределено, "решение по изделию найдено");
	Проверить(Не Решение.НужнаВерсия, "заказ с деревом материалов не заводит новую версию карты");
	ПроверитьРавенство(1, Решение.Состав.Количество(), "в состав для карты идёт только первый уровень");
	ПроверитьРавенство(Данные.Полуфабрикат, Решение.Состав[0].Номенклатура, "состав карты - полуфабрикат");

	Провести(Заказ);
	Версия = ТехнологическиеКарты.ТекущиеТехкарты(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Изделие), Контекст.Дата)[Данные.Изделие];
	ПроверитьРавенство(Данные.Карта, Версия.Версия, "действующая версия карты изделия не сменилась");
	Состав = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Данные.Карта);
	ПроверитьРавенство(1, Состав.Количество(), "состав карты изделия остался одноуровневым");
	ПроверитьРавенство(Данные.Полуфабрикат, Состав[0].Номенклатура, "в карте изделия по-прежнему полуфабрикат");
	Данные.Вставить("ПроведенныйЗаказ", Заказ.Ссылка);

КонецПроцедуры

// Потребность (E7) и нормы списания автовыпуском (E9) считаются по ЛИСТЬЯМ дерева: разворачиваемый
// полуфабрикат ни закупается, ни списывается - за него отвечает его сырьё.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеИерархииСценария
//
Процедура ПроверитьПотребностьИСписаниеПоЛистьям(Контекст, Данные)

	Заказ = Данные.ПроведенныйЗаказ;
	Количество = Контекст.Числа.КоличествоПродажи;
	Запрос = Новый Запрос("ВЫБРАТЬ
		|	Движения.Материал КАК Материал,
		|	Движения.Потребность КАК Потребность
		|ИЗ
		|	РегистрНакопления.ПотребностиПроизводства КАК Движения
		|ГДЕ
		|	Движения.Регистратор = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Движения = Запрос.Выполнить().Выгрузить();
	ПроверитьРавенство(1, Движения.Количество(), "потребность заведена только по листу дерева");
	ПроверитьРавенство(Контекст.Сырье, Движения[0].Материал, "в потребности - сырьё, а не полуфабрикат");
	ПроверитьРавенство(Количество * Данные.НормаПолуфабриката * Данные.НормаСырья, Движения[0].Потребность,
		"потребность в сырье посчитана по цепочке");

	// Остаток сырья нужен самому расчёту автовыпуска: без него списывать нечего и строк не будет.
	ЗакупитьСырьеСценария(Контекст, Количество * Данные.НормаПолуфабриката * Данные.НормаСырья);
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	Реализация = РеализацияСтадии(Контекст, Заказ);
	Расчет = Производство.ДанныеАвтовыпуска(Реализация);
	Проверить(Расчет.Активен, "автовыпуск по заказу на производство активен");
	ПроверитьРавенство(1, Расчет.Материалы.Количество(), "автовыпуск списывает только листья дерева");
	ПроверитьРавенство(Контекст.Сырье, Расчет.Материалы[0].Номенклатура,
		"автовыпуск списывает сырьё, а не полуфабрикат, которого на складе нет");
	ПроверитьРавенство(Количество * Данные.НормаПолуфабриката * Данные.НормаСырья, Расчет.Материалы[0].Количество,
		"списывается норма по цепочке");

КонецПроцедуры

// Удаление строки продукции убирает всё её поддерево, а копирование строки товаров переставляет
// родителей на коды копий - иначе копия узла повисла бы в чужом поддереве.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеИерархииСценария
//
Процедура ПроверитьУдалениеИКопированиеПоддерева(Контекст, Данные)

	Заказ = ЗаказИерархииСценария(Контекст, Данные);
	СтрокаТоваров = Заказ.ТЧТовары[0];
	Документы.ЗаказПокупателя.УдалитьМатериалыСтроки(Заказ.ТЧМатериалы, СтрокаТоваров.КодСтроки);
	ПроверитьРавенство(0, Заказ.ТЧМатериалы.Количество(), "удаление строки продукции убирает всё поддерево");

	// Копирование идёт рабочим местом: вторая строка того же изделия получает копию поддерева.
	Первая = ДанныеСтрокиАРМ(Контекст, Данные.Изделие, 1);
	Результат = ЗаписьСтрокиАРМ(Первая, "черновик рабочего места с деревом материалов");
	Вторая = ДанныеСтрокиАРМ(Контекст, Данные.Изделие, 1);
	Вторая.Заказ = Результат.Заказ;
	Вторая.ВерсияДанных = Результат.СтрокиЗаказа[0].ВерсияДанных;
	Результат = ЗаписьСтрокиАРМ(Вторая, "вторая строка того же изделия");
	Черновик = Результат.Заказ.ПолучитьОбъект();
	ПроверитьРавенство(4, Черновик.ТЧМатериалы.Количество(), "поддерево скопировано второй строке целиком");
	ПродукцияКодов = Новый Соответствие;
	Для Каждого Материал Из Черновик.ТЧМатериалы Цикл
		ПродукцияКодов.Вставить(Материал.КодСтроки, Материал.КодСтрокиПродукции);
	КонецЦикла;
	Листьев = 0;
	Для Каждого Материал Из Черновик.ТЧМатериалы Цикл
		Если Материал.КодСтрокиРодителя = 0 Тогда
			Продолжить;
		КонецЕсли;
		Листьев = Листьев + 1;
		ПроверитьРавенство(Материал.КодСтрокиПродукции, ПродукцияКодов[Материал.КодСтрокиРодителя],
			"родитель копии - строка той же строки продукции, а не исходного поддерева");
	КонецЦикла;
	ПроверитьРавенство(2, Листьев, "у каждой строки продукции свой лист под своим полуфабрикатом");

КонецПроцедуры

// Нормализация кодов строк материалов при записи: нулевой и повторный код заменяются, потомок остаётся
// за строкой, которая код сохранила, строка с пропавшим родителем к корню НЕ поднимается и в состав
// технологической карты не попадает, кольцо ссылок - отказ записи.
// Согласование вызывается напрямую: настоящий отказ записи испортил бы транзакцию сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеИерархииСценария
//
Процедура ПроверитьНормализациюДереваМатериалов(Контекст, Данные)

	Заказ = ЗаказИерархииСценария(Контекст, Данные);
	Узел = Заказ.ТЧМатериалы[0];
	Лист = Заказ.ТЧМатериалы[1];
	КодУзла = Узел.КодСтроки;
	// Нулевой код у узла и повторный у листа: так приходят данные загрузки и ручной правки.
	Узел.КодСтроки = 0;
	Лист.КодСтроки = 0;
	Отказ = Ложь;
	Заказ.СогласоватьМатериалы(Отказ);
	Проверить(Не Отказ, "нулевые коды строк материалов записи не мешают");
	Проверить(Узел.КодСтроки <> 0 И Лист.КодСтроки <> 0, "нулевые коды строк материалов заменены");
	Проверить(Узел.КодСтроки <> Лист.КодСтроки, "коды строк материалов различны");
	// Ссылка листа на родителя осталась висеть с прежним кодом: новый код не имеет права на неё сесть,
	// иначе лист молча усыновится не туда. Это сторож коллизии кодов, а не проверка связи.
	Проверить(Лист.КодСтрокиРодителя <> Узел.КодСтроки И Лист.КодСтрокиРодителя <> Лист.КодСтроки,
		"новый код строки не садится на висящую ссылку родителя");

	Заказ = ЗаказИерархииСценария(Контекст, Данные);
	Узел = Заказ.ТЧМатериалы[0];
	Лист = Заказ.ТЧМатериалы[1];
	КодУзла = Узел.КодСтроки;
	// Дубль кода: код остаётся за первой строкой, лист обязан остаться её потомком.
	Лист.КодСтроки = КодУзла;
	Отказ = Ложь;
	Заказ.СогласоватьМатериалы(Отказ);
	Проверить(Не Отказ, "повторный код строки материалов записи не мешает");
	ПроверитьРавенство(КодУзла, Узел.КодСтроки, "код остаётся за первой строкой");
	Проверить(Лист.КодСтроки <> КодУзла, "повторный код заменён новым");
	ПроверитьРавенство(КодУзла, Лист.КодСтрокиРодителя, "потомок остался за строкой, сохранившей код");

	Заказ = ЗаказИерархииСценария(Контекст, Данные);
	Лист = Заказ.ТЧМатериалы[1];
	Заказ.ТЧМатериалы.Удалить(Заказ.ТЧМатериалы[0]);
	Отказ = Ложь;
	Заказ.СогласоватьМатериалы(Отказ);
	Проверить(Не Отказ, "пропавший родитель записи не мешает");
	Проверить(Лист.КодСтрокиРодителя <> 0,
		"строка с пропавшим родителем к корню не поднимается: иначе она попала бы в состав карты");
	Составы = Документы.ЗаказПокупателя.СоставыПродукций(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Ложь);
	Проверить(Составы[Данные.Изделие] = Неопределено,
		"удаление строки полуфабриката не переписывает карту изделия составом его сырья");

	Заказ = ЗаказИерархииСценария(Контекст, Данные);
	Узел = Заказ.ТЧМатериалы[0];
	Лист = Заказ.ТЧМатериалы[1];
	Узел.КодСтрокиРодителя = Лист.КодСтроки;
	Отказ = Ложь;
	Заказ.СогласоватьМатериалы(Отказ);
	Проверить(Отказ, "кольцо в ссылках на родителя - отказ записи");

КонецПроцедуры

// Остаток регистра по материалу, встречающемуся в дереве дважды, раскладывается по обоим вхождениям, а
// итог по дереву равен остатку регистра.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументСсылка.ЗаказПокупателя - проведённый заказ с материалом на двух уровнях
//  Ожидание - Число - потребность по материалу в регистре
//
Процедура ПроверитьРаскладкуОстатковДерева(Контекст, Заказ, Ожидание)

	Дерево = Обработки.АРМПроизводство.МатериалыЗаказа(Заказ);
	ПроверитьРавенство(Ожидание, ИтогДереваМатериалов(Дерево, "Потребность"),
		"итог потребности по дереву равен остатку регистра");
	Вхождения = Новый Массив;
	СобратьВхожденияМатериала(Дерево.Строки, Контекст.Сырье, Вхождения);
	ПроверитьРавенство(2, Вхождения.Количество(), "сырьё встречается в дереве дважды");
	Для Каждого Вхождение Из Вхождения Цикл
		Проверить(Вхождение.Потребность > 0, "остаток разложен по обоим вхождениям, а не отдан одному");
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Коллекция - КоллекцияСтрокДереваЗначений - строки одного уровня
//  Материал  - СправочникСсылка.Номенклатура - искомый материал
//  Вхождения - Массив - пополняется строками дерева
//
Процедура СобратьВхожденияМатериала(Коллекция, Материал, Вхождения)

	Для Каждого Узел Из Коллекция Цикл
		Если Узел.Материал = Материал Тогда
			Вхождения.Добавить(Узел);
		КонецЕсли;
		СобратьВхожденияМатериала(Узел.Строки, Материал, Вхождения);
	КонецЦикла;

КонецПроцедуры

// Материал, встречающийся и у продукции первым уровнем, и под полуфабрикатом, не даёт отказа «указан с
// разными упаковками»: в состав карты идёт только первый уровень, и дубля ключа там нет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьМатериалНаДвухУровнях(Контекст)

	Полуфабрикат = НовыйПолуфабрикатСценария(Контекст, "ПФ с общим сырьём");
	ЗаписатьКартуСценария(Контекст, Полуфабрикат, СтрокаКартыСценария(Контекст.Сырье, 1));
	Изделие = НовоеИзделиеСценария(Контекст, "изделие с общим сырьём");
	Строки = Новый Массив;
	Строки.Добавить(СтрокаКартыСценария(Полуфабрикат, 1));
	Строки.Добавить(СтрокаКартыСценария(Контекст.Сырье, 1));
	ЗаписатьКартуСценария(Контекст, Изделие, Строки);

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Изделие, Контекст.Числа.КоличествоПродажи,
		Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	ПроверитьРавенство(3, Заказ.ТЧМатериалы.Количество(), "сырьё есть и первым уровнем, и под полуфабрикатом");
	Отказ = Ложь;
	Заказ.ПроверитьПроведениеЗаказа(Отказ);
	Проверить(Не Отказ, "материал у продукции и под полуфабрикатом не даёт отказа проведения");
	Провести(Заказ);
	// Оба вхождения сырья - листья с одинаковой нормой, в регистре они свёрнуты в одну строку.
	ПроверитьРаскладкуОстатковДерева(Контекст, Заказ.Ссылка, 2 * Контекст.Числа.КоличествоПродажи);

КонецПроцедуры

// Записанный заказ на производство одной строкой изделия с материалами по карте.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеИерархииСценария
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя - записанный заказ
//
Функция ЗаказИерархииСценария(Контекст, Данные)

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.Изделие, Контекст.Числа.КоличествоПродажи,
		Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	Записать(Заказ);
	Возврат Заказ;

КонецФункции

// Закупка сырья на склад сценария: остаток нужен расчёту автовыпуска.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Количество - Число - количество сырья
//
Процедура ЗакупитьСырьеСценария(Контекст, Количество)

	Закупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Закупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.ЦенаВключаетНДС = Истина;
	Закупка.Валюта = Контекст.Валюта;
	Закупка.КурсВалюты = 1;
	Закупка.МестоХранения = Контекст.Склад;
	ДобавитьСтрокуТоваров(Контекст, Закупка, "ТЧТовары", Контекст.Сырье, Количество, Контекст.Числа.ЦенаСырья);
	Провести(Закупка);

КонецПроцедуры

// Сценарий E6: проведение заказа на производство регистрирует версию технологической карты при
// отличии состава и не регистрирует при совпадении; отказы проведения; запрет смены вида операции;
// продажа не проводится. Настоящий отказ проведения - последним шагом: он портит транзакцию сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПроведениеЗаказа(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	МетаданныеКарты = Метаданные.Документы.ТехнологическаяКарта;
	ПравоПроведения = "Проведение";
	ЕстьПраваНаКарты = ПравоДоступа(ПравоПроведения, МетаданныеКарты) И ПравоДоступа("Изменение", МетаданныеКарты);
	Проверить(ЕстьПраваНаКарты, "пользователю прогона нужно право менять технологические карты: сценарий регистрирует версии карт");
	Проверить(Документы.ЗаказПокупателя.ЗаказПроводится(Перечисления.ВидыОперацийЗаказаПокупателя.Производство),
		"заказ на производство проводится при включённой опции");
	Проверить(Не Документы.ЗаказПокупателя.ЗаказПроводится(Перечисления.ВидыОперацийЗаказаПокупателя.Продажа),
		"продажа не проводится - отказ до ПриЗаписи в ПередЗаписью опирается на эту функцию");

	Заказ = ЗаказПроведенияСценария(Контекст, Контекст.Числа.РасходСырьяНаЕдиницу + 1);
	Версия = ПроверитьРегистрациюТехкарты(Контекст, Заказ);
	ПроверитьУпаковкуСоставаПродукции(Контекст, Версия);
	ПроверитьОтказыПроведенияЗаказа(Контекст);
	Проверить(Не ПравоДоступа(ПравоПроведения, МетаданныеКарты, Метаданные.Роли.Оператор),
		"у роли Оператор нет права менять технологические карты - заказ проверяет его перед записью карты");
	Проверить(ПравоДоступа(ПравоПроведения, МетаданныеКарты, Метаданные.Роли.ОператорПроизводства),
		"роль ОператорПроизводства меняет технологические карты");
	ПроверитьСменуВидаПроведенногоЗаказа(Заказ, Версия);
	ПроверитьПроверкуЗаполненияПриЗаписи(Контекст);
	ПроверитьЗаголовокФормыЗаказа(Контекст);
	ПроверитьОтказПроведенияПродажи(Контекст);

	ВеткаУпаковки = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку"), "упаковка из заказа (опция включена)",
		"перенос упаковки из карты (опция выключена)");
	Возврат РезультатСценария("регистрация версии карты и дата проведения, перепроведение без новой версии и без отката "
		+ "карты, совпадение с действующей картой, новый состав, " + ВеткаУпаковки + ", отказы, права, запрет смены вида "
		+ "и записи изменённых материалов проведённого заказа, отмена проведения, проверка заполнения при записи, "
		+ "заголовок, продажа не проводится");

КонецФункции

// Незаписанный заказ на производство: закупаемый товар и продукция с одним материалом, введённым вручную.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Расход   - Число - количество сырья на единицу продукции
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя - строки: товар, продукция
//
Функция ЗаказПроведенияСценария(Контекст, Расход)

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция,
		Контекст.Числа.КоличествоПродажи, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Контекст.Сырье, Расход);
	Возврат Заказ;

КонецФункции

// Строка материалов заказа с упаковкой, как у заполнения по карте: при опции «Использовать упаковку» -
// упаковка карты сценария, без опции - пустая.
//
// Параметры:
//  Контекст      - Структура - см. НовыйКонтекст
//  Заказ         - ДокументОбъект.ЗаказПокупателя - заказ
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка продукции
//  Материал      - СправочникСсылка.Номенклатура - материал
//  Расход        - Число - количество на единицу продукции
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти - строка материалов
//
Функция ДобавитьМатериалЗаказа(Контекст, Заказ, СтрокаТоваров, Материал, Расход) Экспорт

	СтрокаМатериала = Заказ.ТЧМатериалы.Добавить();
	СтрокаМатериала.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Заказ.ТЧМатериалы);
	СтрокаМатериала.КодСтрокиПродукции = СтрокаТоваров.КодСтроки;
	СтрокаМатериала.Номенклатура = Материал;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку") Тогда
		СтрокаМатериала.Упаковка = Контекст.Единица;
	КонецЕсли;
	СтрокаМатериала.КоличествоЗаЕдиницу = Расход;
	Документы.ЗаказПокупателя.ПересчитатьСтрокуМатериала(СтрокаМатериала, СтрокаТоваров.Количество);
	Возврат СтрокаМатериала;

КонецФункции

// Версия данных документа карты: одна и та же карта дня перезаписывается, поэтому лишнюю регистрацию
// видно только по версии данных, а не по ссылке и числу документов.
//
// Параметры:
//  Карта - ДокументСсылка.ТехнологическаяКарта - документ карты
//
// Возвращаемое значение:
//  Строка - версия данных
//
Функция ВерсияДанныхКарты(Карта)

	Запрос = Новый Запрос("ВЫБРАТЬ Карты.ВерсияДанных КАК ВерсияДанных
		|ИЗ Документ.ТехнологическаяКарта КАК Карты ГДЕ Карты.Ссылка = &Карта");
	Запрос.УстановитьПараметр("Карта", Карта);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.ВерсияДанных;

КонецФункции

// Количество первой строки состава версии карты.
//
// Параметры:
//  Карта - ДокументСсылка.ТехнологическаяКарта - версия карты
//
// Возвращаемое значение:
//  Число - количество на единицу продукции
//
Функция РасходПоВерсииКарты(Карта)

	Возврат ТехнологическиеКарты.СоставТехкартыПоРегистратору(Карта)[0].Количество;

КонецФункции

// Регистрация при пустой колонке «Техкарта», перепроведение без изменений, правка карты технологом после
// проведения, заказ с составом действующей карты, изменение состава.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументОбъект.ЗаказПокупателя - см. ЗаказПроведенияСценария, расход на единицу +1 к карте
//
// Возвращаемое значение:
//  ДокументСсылка.ТехнологическаяКарта - версия карты продукции после изменения состава
//
Функция ПроверитьРегистрациюТехкарты(Контекст, Заказ)

	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	Продукция = Контекст.Продукция;
	СтрокаТовара = Заказ.ТЧТовары[0];
	СтрокаПродукции = Заказ.ТЧТовары[1];

	Провести(Заказ);
	Версия = СтрокаПродукции.Техкарта;
	Проверить(ЗначениеЗаполнено(Версия), "проведение ставит версию карты в строку продукции");
	ПроверитьРавенство(Версия, Заказ.Ссылка.ПолучитьОбъект().ТЧТовары[1].Техкарта, "версия карты строки записана в базу");
	Проверить(Не ЗначениеЗаполнено(СтрокаТовара.Техкарта), "у закупаемого товара без материалов версии нет");
	ПроверитьРавенство(Расход + 1, РасходПоВерсииКарты(Версия), "состав версии - состав заказа");
	ПроверитьРавенство(НачалоДня(ТекущаяДатаСеанса()), Версия.Дата, "дата версии - день проведения");
	ПроверитьРавенство(Версия, ТехнологическиеКарты.ТекущиеТехкарты(Продукция)[Продукция].Версия,
		"версия заказа становится действующей картой продукции");

	ВерсияДанных = ВерсияДанныхКарты(Версия);
	Провести(Заказ);
	ПроверитьРавенство(ВерсияДанных, ВерсияДанныхКарты(Версия), "повторное проведение без изменений карту не перезаписывает");
	ПроверитьРавенство(Версия, СтрокаПродукции.Техкарта, "повторное проведение оставляет версию строки");

	Состав = СоставКарты(Контекст);
	Состав[0].Количество = Расход + 2;
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ТекущаяДатаСеанса());
	Материал = Заказ.ТЧМатериалы[0];
	Материал.КоличествоЗаЕдиницу = (Расход + 1) / 2;
	Документы.ЗаказПокупателя.ПересчитатьСтрокуМатериала(Материал, СтрокаПродукции.Количество);
	ДобавитьМатериалЗаказа(Контекст, Заказ, СтрокаПродукции, Контекст.Сырье, (Расход + 1) / 2);
	ВерсияДанных = ВерсияДанныхКарты(Версия);
	Провести(Заказ);
	ПроверитьРавенство(ВерсияДанных, ВерсияДанныхКарты(Версия),
		"перепроведение с тем же составом (две одинаковые строки материала) не возвращает карте прежний состав");
	ПроверитьРавенство(Расход + 2, РасходПоВерсииКарты(Версия), "действующая карта остаётся в правке технолога");

	Второй = ЗаказПроведенияСценария(Контекст, Расход + 2);
	Провести(Второй);
	ПроверитьРавенство(Версия, Второй.ТЧТовары[1].Техкарта, "состав, равный действующей карте, получает её версию");
	ПроверитьРавенство(ВерсияДанных, ВерсияДанныхКарты(Версия), "состав, равный действующей карте, новой версии не заводит");

	// Технолог ставит способ изготовления и процент потерь. У строк материалов заказа этих полей нет,
	// поэтому следующее перепроведение с изменённым составом - это и есть проверка на молчаливое обнуление.
	СоставСоСпособом = СоставКарты(Контекст);
	СоставСоСпособом[0].Количество = Расход + 2;
	ДобавитьСвойстваИзготовления(СоставСоСпособом, Перечисления.СпособыИзготовления.Переработчик, 5);
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, СоставСоСпособом, ТекущаяДатаСеанса());
	ПроверитьРавенство(Перечисления.СпособыИзготовления.Переработчик,
		ТехнологическиеКарты.СоставТехкартыПоРегистратору(Версия)[0].СпособИзготовления,
		"способ изготовления записан технологом");
	ВерсияДанных = ВерсияДанныхКарты(Версия);

	Заказ.ТЧМатериалы.Удалить(Заказ.ТЧМатериалы[1]);
	Материал.КоличествоЗаЕдиницу = Расход + 3;
	Документы.ЗаказПокупателя.ПересчитатьСтрокуМатериала(Материал, СтрокаПродукции.Количество);
	Провести(Заказ);
	Проверить(ВерсияДанных <> ВерсияДанныхКарты(Версия), "изменённый состав перезаписывает карту дня");
	ПроверитьРавенство(Версия, СтрокаПродукции.Техкарта, "новая версия того же дня - тот же документ карты");
	ПроверитьРавенство(Расход + 3, РасходПоВерсииКарты(Версия), "новый состав зарегистрирован");
	СоставВерсии = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Версия);
	ПроверитьРавенство(Контекст.Единица, СоставВерсии[0].Упаковка,
		"упаковка карты сохраняется при регистрации из заказа");
	ПроверитьРавенство(Перечисления.СпособыИзготовления.Переработчик, СоставВерсии[0].СпособИзготовления,
		"способ изготовления не обнуляется перезаписью карты из заказа");
	ПроверитьРавенство(5, СоставВерсии[0].ПроцентПотерь,
		"процент потерь не обнуляется перезаписью карты из заказа");
	Возврат Версия;

КонецФункции

// Составы продукций: свёртка одинаковых строк, очистка упаковки без опции, перенос упаковки из карты -
// обе ветки опции «Использовать упаковку» независимо от её значения в базе.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Версия   - ДокументСсылка.ТехнологическаяКарта - карта продукции с упаковкой материала
//
Процедура ПроверитьУпаковкуСоставаПродукции(Контекст, Версия)

	Заказ = ЗаказПроведенияСценария(Контекст, 1);
	СтрокаПродукции = Заказ.ТЧТовары[1];
	Заказ.ТЧМатериалы[0].Упаковка = Контекст.Единица;
	ВторойМатериал = ДобавитьМатериалЗаказа(Контекст, Заказ, СтрокаПродукции, Контекст.Сырье, 2);
	ВторойМатериал.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();

	СУпаковкой = Документы.ЗаказПокупателя.СоставыПродукций(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Истина)[Контекст.Продукция];
	ПроверитьРавенство(2, СУпаковкой.Состав.Количество(), "с опцией разные упаковки материала - разные строки состава");
	Отказ = Ложь;
	Заказ.ПроверитьПроведениеЗаказа(Отказ, Истина);
	Проверить(Отказ, "с опцией один материал с разными упаковками не проводится");

	БезУпаковки = Документы.ЗаказПокупателя.СоставыПродукций(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Ложь)[Контекст.Продукция];
	ПроверитьРавенство(1, БезУпаковки.Состав.Количество(), "без опции строки материала сворачиваются");
	ПроверитьРавенство(3, БезУпаковки.Состав[0].Количество, "без опции количество свёрнутых строк суммируется");
	ПроверитьРавенство(Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка(), БезУпаковки.Состав[0].Упаковка,
		"без опции упаковка состава очищается");
	Отказ = Ложь;
	Заказ.ПроверитьПроведениеЗаказа(Отказ, Ложь);
	Проверить(Не Отказ, "без опции упаковка не участвует в проверке разных упаковок");
	Документы.ЗаказПокупателя.ПеренестиУпаковкуКарты(БезУпаковки.Состав, Версия);
	ПроверитьРавенство(Контекст.Единица, БезУпаковки.Состав[0].Упаковка, "упаковка переносится из базовой версии карты");
	ПолучитьСообщенияПользователю(Истина);

КонецПроцедуры

// Отказы проведения через проверку без записи: строка продукции без материалов, пустой материал, материал
// совпадает с продукцией, будущая карта продукции; закупаемый товар без материалов отказа не даёт.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказыПроведенияЗаказа(Контекст)

	ПроверитьРавенство(Перечисления.СпособыПополненияЗапасов.Производство, Контекст.Продукция.СпособПополнения,
		"продукция сценария пополняется производством");
	ПолучитьСообщенияПользователю(Истина);

	ТолькоТовар = ЗаказКлиентаСценария(Контекст);
	ТолькоТовар.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ПроверитьОтказПроверкиПроведения(ТолькоТовар, Ложь, "закупаемый товар без материалов проводится");

	БезМатериалов = ЗаказПроведенияСценария(Контекст, 1);
	БезМатериалов.ТЧМатериалы.Очистить();
	ПроверитьОтказПроверкиПроведения(БезМатериалов, Истина, "строка продукции без материалов не проводится");

	ПустойМатериал = ЗаказПроведенияСценария(Контекст, 1);
	ПустойМатериал.ТЧМатериалы[0].Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	ПроверитьОтказПроверкиПроведения(ПустойМатериал, Истина, "материал с пустой номенклатурой не проводится");

	СамаСебя = ЗаказПроведенияСценария(Контекст, 1);
	СамаСебя.ТЧМатериалы[0].Номенклатура = Контекст.Продукция;
	ПроверитьОтказПроверкиПроведения(СамаСебя, Истина, "продукция своим же материалом не проводится");

	Продукция = НоваяНоменклатура(Контекст, "будущая карта", Перечисления.ТипыНоменклатуры.Продукция);
	Завтра = КонецДня(ТекущаяДатаСеанса()) + 1;
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, СоставКарты(Контекст), Завтра);
	БудущаяКарта = ЗаказПроведенияСценария(Контекст, Контекст.Числа.РасходСырьяНаЕдиницу + 5);
	БудущаяКарта.ТЧТовары[1].Номенклатура = Продукция;
	ПроверитьОтказПроверкиПроведения(БудущаяКарта, Истина, "новая версия раньше будущей карты не проводится");
	Ожидаемое = ТехнологическиеКарты.ОшибкаДатыТехкарты(Завтра);
	ЕстьТекст = Ложь;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		ЕстьТекст = ЕстьТекст Или СтрНайти(Сообщение.Текст, Ожидаемое) > 0;
	КонецЦикла;
	Проверить(ЕстьТекст, "отказ по дате сообщает дату последней версии карты: " + Ожидаемое);

КонецПроцедуры

// Проверка проведения без записи даёт ожидаемый отказ.
//
// Параметры:
//  Заказ     - ДокументОбъект.ЗаказПокупателя - незаписанный заказ на производство
//  Ожидается - Булево - ожидается отказ
//  Описание  - Строка - что проверяется
//
Процедура ПроверитьОтказПроверкиПроведения(Заказ, Ожидается, Описание)

	Отказ = Ложь;
	Заказ.ПроверитьПроведениеЗаказа(Отказ, ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку"));
	ПроверитьРавенство(Ожидается, Отказ, Описание);

КонецПроцедуры

// Вид операции проведённого заказа не меняется; отмена проведения снимает запрет и карту не трогает.
//
// Параметры:
//  Заказ  - ДокументОбъект.ЗаказПокупателя - проведённый заказ на производство
//  Версия - ДокументСсылка.ТехнологическаяКарта - версия карты, зарегистрированная заказом
//
Процедура ПроверитьСменуВидаПроведенногоЗаказа(Заказ, Версия)

	Материал = Заказ.ТЧМатериалы[0];
	Материал.КоличествоЗаЕдиницу = Материал.КоличествоЗаЕдиницу + 1;
	Отказ = Ложь;
	Заказ.ПроверитьМатериалыПроведенногоЗаказа(РежимЗаписиДокумента.Запись, Отказ);
	Проверить(Отказ, "запись проведённого заказа с изменёнными материалами без перепроведения отклоняется");
	Отказ = Ложь;
	Заказ.ПроверитьМатериалыПроведенногоЗаказа(РежимЗаписиДокумента.Проведение, Отказ);
	Проверить(Не Отказ, "изменённые материалы проведённого заказа фиксируются перепроведением");
	Материал.КоличествоЗаЕдиницу = Материал.КоличествоЗаЕдиницу - 1;
	Отказ = Ложь;
	Заказ.ПроверитьМатериалыПроведенногоЗаказа(РежимЗаписиДокумента.Запись, Отказ);
	Проверить(Не Отказ, "проведённый заказ без изменения материалов записывается");
	ПолучитьСообщенияПользователю(Истина);

	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	Отказ = Ложь;
	Заказ.ПроверитьСменуВидаОперации(РежимЗаписиДокумента.Проведение, Отказ);
	Проверить(Отказ, "смена вида операции проведённого заказа при перепроведении отклоняется");
	Отказ = Ложь;
	Заказ.ПроверитьСменуВидаОперации(РежимЗаписиДокумента.Запись, Отказ);
	Проверить(Отказ, "смена вида операции проведённого заказа при записи отклоняется");
	Отказ = Ложь;
	Заказ.ПроверитьСменуВидаОперации(РежимЗаписиДокумента.ОтменаПроведения, Отказ);
	Проверить(Не Отказ, "смена вида вместе с отменой проведения разрешена");
	ПолучитьСообщенияПользователю(Истина);

	Заказ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Проверить(Не Заказ.Ссылка.Проведен, "отмена проведения заказа");
	ПроверитьРавенство(Перечисления.ВидыОперацийЗаказаПокупателя.Продажа, Заказ.Ссылка.ВидОперации,
		"смена вида операции записывается вместе с отменой проведения");
	Проверить(ТехнологическиеКарты.СоставТехкартыПоРегистратору(Версия).Количество() > 0,
		"отмена проведения заказа версию карты не трогает");
	ПолучитьСообщенияПользователю(Истина);

КонецПроцедуры

// Проверка заполнения на сервере - только при записи из формы в режиме «Запись» и не при пометке удаления.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПроверкуЗаполненияПриЗаписи(Контекст)

	Заказ = ЗаказКлиентаСценария(Контекст);
	Проверить(Не Заказ.НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписиДокумента.Запись),
		"запись кодом без свойства формы проверку заполнения не получает");
	Заказ.ДополнительныеСвойства.Вставить(РаботаСДокументами.СвойствоЗаписьИзФормы(), Истина);
	Проверить(Заказ.НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписиДокумента.Запись),
		"запись из формы проверяет заполнение, как до включения проведения");
	Проверить(Не Заказ.НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписиДокумента.Проведение),
		"при проведении из формы заполнение проверяет сама форма");
	Проверить(Не Заказ.НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписиДокумента.ОтменаПроведения),
		"отмена проведения проверку заполнения не требует");
	Заказ.ПометкаУдаления = Истина;
	Проверить(Не Заказ.НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписиДокумента.Запись),
		"пометка удаления проверку заполнения не требует");

КонецПроцедуры

// Заголовок формы на языке сеанса: записанная продажа - «Записан», как до включения проведения; непроведённый заказ
// на производство - «Не проведён».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьЗаголовокФормыЗаказа(Контекст)

	Форма = Новый Структура("АвтоЗаголовок, Заголовок", Истина, "");
	Продажа = ЗаказКлиентаСценария(Контекст);
	Записать(Продажа);
	РаботаСДокументами.УстановитьЗаголовокФормыДокумента(Форма, Продажа);
	Записан = НСтр("ru = 'Записан'; fr = 'Enregistré'; en = 'Saved'; es = 'Guardado'");
	Проверить(СтрЗаканчиваетсяНа(Форма.Заголовок, ": " + Записан), "заголовок записанной продажи: " + Форма.Заголовок);

	НаПроизводство = ЗаказПроведенияСценария(Контекст, 1);
	Записать(НаПроизводство);
	РаботаСДокументами.УстановитьЗаголовокФормыДокумента(Форма, НаПроизводство);
	НеПроведен = НСтр("ru = 'Не проведён'; fr = 'Non reporté'; en = 'Not posted'; es = 'No contabilizado'");
	Проверить(СтрЗаканчиваетсяНа(Форма.Заголовок, ": " + НеПроведен),
		"заголовок непроведённого заказа на производство: " + Форма.Заголовок);

КонецПроцедуры

// Продажа не проводится: настоящая запись с проведением отклоняется. Отказ портит транзакцию сценария,
// поэтому шаг последний и проверяет только объект в памяти.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказПроведенияПродажи(Контекст)

	Продажа = ЗаказКлиентаСценария(Контекст);
	Отклонено = Ложь;
	Попытка
		Продажа.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	Проверить(Отклонено, "продажа не проводится");
	Проверить(Не Продажа.Проведен, "продажа остаётся непроведённой");

КонецПроцедуры

// Незаписанный заказ клиента без вызова Заполнить(), как в кабинете партнёра и лидах.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя - заказ с одной товарной строкой
//
Функция ЗаказКлиентаСценария(Контекст)

	Заказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	Заказ.Контрагент = Контекст.Контрагент;
	Заказ.Договор = Контекст.ДоговорПокупателя;
	Заказ.ЦенаВключаетНДС = Истина;
	Заказ.ДатаОтгрузки = Заказ.Дата;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Товар,
		Контекст.Числа.КоличествоПродажи, Контекст.Числа.ЦенаПродажи);
	Возврат Заказ;

КонецФункции

// Заказ, введённый на основании нового предложения с одной позицией, получает ожидаемый вид операции.
//
// Параметры:
//  Контекст       - Структура - см. НовыйКонтекст
//  Номенклатура   - СправочникСсылка.Номенклатура - позиция предложения
//  НаПроизводство - Булево - команда «Заказ клиента на производство», иначе «Заказ клиента»
//  Ожидаемый      - ПеречислениеСсылка.ВидыОперацийЗаказаПокупателя - вид операции заказа
//  Описание       - Строка - что проверяется
//
Процедура ПроверитьЗаказПоПредложению(Контекст, Номенклатура, НаПроизводство, Ожидаемый, Описание)

	Предложение = НовоеКоммерческоеПредложение(Контекст, Номенклатура, ПометкаТеста() + ": " + Описание);
	Записать(Предложение);
	Заказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	Если НаПроизводство Тогда
		Заказ.Заполнить(Новый Структура("Предложение, НаПроизводство", Предложение.Ссылка, Истина));
	Иначе
		Заказ.Заполнить(Предложение.Ссылка);
	КонецЕсли;
	Заказ.Дата = СледующаяДата(Контекст);
	Записать(Заказ);
	ПроверитьРавенство(Ожидаемый, Заказ.Ссылка.ВидОперации, "вид операции заказа " + Описание);

КонецПроцедуры

// Представление заказа на производство собирается обработчиком модуля менеджера.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - записанный заказ на производство
//
Процедура ПроверитьПредставлениеЗаказаНаПроизводство(Заказ)

	Шаблон = НСтр("ru = 'Заказ клиента на производство %1 от %2';
		|fr = 'Commande client en production %1 du %2';
		|en = 'Customer production order %1 dated %2';
		|es = 'Pedido de cliente para producción %1 del %2'");
	ДатаЗаказа = Формат(Заказ.Дата, "ДЛФ=DT");
	Ожидалось = СтрШаблон(Шаблон, Заказ.Номер, ДатаЗаказа);
	ПроверитьРавенство(Ожидалось, Строка(Заказ), "представление заказа на производство");

КонецПроцедуры

// Представление продажи остаётся стандартным. Эталон формата платформы - коммерческое предложение,
// у которого обработчиков представления нет: из него берётся разделитель номера и даты на языке сеанса.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПредставлениеПродажи(Контекст)

	Предложение = НовоеКоммерческоеПредложение(Контекст, Контекст.Товар, ПометкаТеста() + ": эталон представления");
	Записать(Предложение);
	// Номер в представлении - без дополняющих пробелов: номер КП может быть короче длины (после авто-КП из реализаций).
	ПрефиксПредложения = ПредставлениеОбъектаДокумента(Предложение.Метаданные()) + " " + СокрЛП(Предложение.Номер);
	ДатаПредложения = Формат(Предложение.Дата, "ДЛФ=DT");
	ЭталонПредложения = Строка(Предложение.Ссылка);
	Проверить(СтрНачинаетсяС(ЭталонПредложения, ПрефиксПредложения) И СтрЗаканчиваетсяНа(ЭталонПредложения, ДатаПредложения),
		"стандартное представление предложения не в формате «представление номер … дата»: " + ЭталонПредложения);
	Разделитель = Сред(ЭталонПредложения, СтрДлина(ПрефиксПредложения) + 1,
		СтрДлина(ЭталонПредложения) - СтрДлина(ПрефиксПредложения) - СтрДлина(ДатаПредложения));

	Продажа = ЗаказКлиентаСценария(Контекст);
	Записать(Продажа);
	Ожидалось = ПредставлениеОбъектаДокумента(Продажа.Метаданные()) + " " + СокрЛП(Продажа.Номер) + Разделитель
		+ Формат(Продажа.Дата, "ДЛФ=DT");
	ПроверитьРавенство(Ожидалось, Строка(Продажа.Ссылка), "стандартное представление заказа-продажи");

КонецПроцедуры

// Представление объекта документа из метаданных; пустое - синоним, как у стандартного представления.
//
// Параметры:
//  МетаданныеДокумента - ОбъектМетаданных - документ
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеОбъектаДокумента(МетаданныеДокумента)

	Представление = МетаданныеДокумента.ПредставлениеОбъекта;
	Если ПустаяСтрока(Представление) Тогда
		Представление = МетаданныеДокумента.Синоним;
	КонецЕсли;
	Возврат Представление;

КонецФункции

// Количество заказов клиентов с пустым видом операции.
//
// Возвращаемое значение:
//  Число
//
Функция КоличествоЗаказовБезВидаОперации()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказаПокупателя.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

#Область КПИзРеализации

// КП из реализации при выключенной опции «Коммерческие предложения» (docs/plans/branded-print.md, 3.3 и 9.10):
// создание с номером и датой реализации, строки товаров и услуг и итоги, повторная запись и печать без перезаписи,
// смена номера, пометка удаления, загрузка обмена и догон при печати, ручной КП по той же реализации, переходы опции,
// защищённый КП, дубли, служебная запись заказа в обоих порядках, команда печати, права; последним шагом - отказ
// ручной записи КП при выключенной опции. Опция переключается константой в транзакции сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийКПИзРеализации(Контекст)

	МенеджерКП = Документы.КоммерческоеПредложение;
	УстановитьОпциюКП(Ложь);
	Проверить(Не МенеджерКП.КПВводятсяВручную(), "опция выключена константой в транзакции сценария");
	Услуга = НоваяНоменклатура(Контекст, "услуга КП", Перечисления.ТипыНоменклатуры.Услуга);

	// Создание: номер и дата реализации, товары, строка без упаковки, услуга; итоги и строки печати.
	Реализация = РеализацияДляКП(Контекст, Услуга, Истина);
	Предложение = ЕдинственныйАвтоКП(Реализация.Ссылка, "запись реализации создаёт авто-КП");
	ПроверитьАвтоКППоРеализации(Предложение, Реализация, "смешанная реализация");
	ТолькоУслуги = РеализацияДляКП(Контекст, Услуга, Ложь);
	ПроверитьАвтоКППоРеализации(ЕдинственныйАвтоКП(ТолькоУслуги.Ссылка, "авто-КП реализации только из услуг"),
		ТолькоУслуги, "реализация только из услуг");

	ПроверитьДлинноеОписаниеУслуги(Контекст);

	// Повторная запись и печать без изменений КП не переписывают.
	ВерсияДанных = ВерсияДанныхКП(Предложение);
	Реализация.Записать();
	ПечатнаяФорма = ПечатьКПРеализации(Реализация.Ссылка);
	ПроверитьРавенство(ВерсияДанных, ВерсияДанныхКП(Предложение),
		"повторная запись и печать без изменений не переписывают авто-КП");
	Проверить(ПечатнаяФорма.НайтиТекст(РаботаСДокументами.СформироватьЦифровойНомер(Реализация.Номер)) <> Неопределено,
		"печать КП из реализации выводит номер КП - номер реализации");
	Проверить(ПечатнаяФорма.НайтиТекст(СодержаниеУслугиКП()) <> Неопределено,
		"печать КП из реализации выводит содержание услуги");

	// Смена номера реализации меняет номер КП; пометка удаления переносится туда и обратно.
	Реализация.Номер = НовыйНомерКП();
	Реализация.Записать();
	ПроверитьРавенство(СокрЛП(Реализация.Номер), СокрЛП(РеквизитКП(Предложение, "Номер")),
		"смена номера реализации меняет номер КП");
	ВерсияДанных = ВерсияДанныхКП(Предложение);
	Реализация.Записать();
	ПроверитьРавенство(ВерсияДанных, ВерсияДанныхКП(Предложение),
		"короткий номер реализации: повторная запись не переписывает КП (номер КП дополнен пробелами)");
	Реализация.УстановитьПометкуУдаления(Истина);
	Проверить(РеквизитКП(Предложение, "ПометкаУдаления"), "пометка удаления реализации помечает её КП");
	Реализация.УстановитьПометкуУдаления(Ложь);
	ПроверитьРавенство(Предложение, ЕдинственныйАвтоКП(Реализация.Ссылка, "снятие пометки"),
		"снятие пометки реализации возвращает тот же КП, а не создаёт новый");
	Проверить(Не РеквизитКП(Предложение, "ПометкаУдаления"), "снятие пометки реализации снимает её с КП");

	// Загрузка обмена КП не трогает, печать догоняет изменения.
	НоваяЦена = Реализация.ТЧТовары[0].Цена + 1;
	Реализация.ТЧТовары[0].Цена = НоваяЦена;
	Реализация.ОбменДанными.Загрузка = Истина;
	Реализация.Записать();
	Реализация.ОбменДанными.Загрузка = Ложь;
	ПроверитьРавенство(Реализация.ТЧТовары[0].Цена - 1, ЦенаПервойСтрокиКП(Предложение),
		"загрузка обмена реализации авто-КП не меняет");
	ПечатьКПРеализации(Реализация.Ссылка);
	ПроверитьРавенство(НоваяЦена, ЦенаПервойСтрокиКП(Предложение), "печать после загрузки обмена обновляет авто-КП");

	// Ручной КП по той же реализации, введённый при включённой опции, синхронизация не трогает.
	Ручной = НовоеКоммерческоеПредложение(Контекст, Контекст.Товар, ПометкаТеста() + ": ручной КП по реализации");
	Ручной.Основание = Реализация.Ссылка;
	Записать(Ручной);
	УстановитьОпциюКП(Ложь);
	ВерсияРучного = ВерсияДанныхКП(Ручной.Ссылка);
	Реализация.Записать();
	ПроверитьРавенство(ВерсияРучного, ВерсияДанныхКП(Ручной.Ссылка), "ручной КП по реализации не тронут");
	ПроверитьРавенство(Предложение, ЕдинственныйАвтоКП(Реализация.Ссылка, "при ручном КП"),
		"ручной КП не становится авто-КП");

	ПроверитьПереходыОпцииКП(Контекст, Реализация, Предложение);
	ПроверитьЗащищенныйАвтоКП(Реализация);
	ПроверитьДублиАвтоКП(Реализация);
	// Заказу по КП нужна строка, которую он пропустит проверкой заполнения: реализация с одним товаром в упаковке.
	РеализацияТовара = РеализацияДляКП(Контекст, Неопределено, Ложь, Истина);
	ПроверитьСлужебнуюЗаписьАвтоКП(Контекст, РеализацияТовара, Ложь);
	ПроверитьСлужебнуюЗаписьАвтоКП(Контекст, РеализацияТовара, Истина);
	ПроверитьКомандуПечатиКП(Реализация);

	// Роли, которые пишут реализацию без прав на КП: протокол работает в привилегированном режиме. Запуск под
	// пользователем роли раннер не умеет - проверяется предпосылка (прав нет), запись проверена под администратором.
	Для Каждого ИмяРоли Из СтрРазделить("Кладовщик,PDV,Казначей,МенеджерПоЗакупкам,ОператорПроизводства", ",") Цикл
		Роль = Метаданные.Роли[ИмяРоли];
		ПишетРеализацию = ПравоДоступа("Изменение", Метаданные.Документы.РеализацияТоваровУслуг, Роль);
		ПишетКП = ПравоДоступа("Изменение", Метаданные.Документы.КоммерческоеПредложение, Роль);
		Проверить(ПишетРеализацию И Не ПишетКП, "роль " + ИмяРоли + " пишет реализацию без права на КП");
	КонецЦикла;

	// Последним шагом: отказ записи портит транзакцию сценария.
	УстановитьОпциюКП(Ложь);
	Запрещенный = Документы.КоммерческоеПредложение.СоздатьДокумент();
	Запрещенный.Заполнить(Неопределено);
	Запрещенный.Дата = СледующаяДата(Контекст);
	Запрещенный.Организация = Контекст.Организация;
	Запрещенный.Контрагент = Контекст.Контрагент;
	Запрещенный.Договор = Контекст.ДоговорПокупателя;
	Отклонено = Ложь;
	Попытка
		Запрещенный.Записать();
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	ПолучитьСообщенияПользователю(Истина);
	Проверить(Отклонено, "ручная запись КП при выключенной опции отклоняется");

	Возврат РезультатСценария("авто-КП: номер, дата, товары и услуги, итоги, без лишней перезаписи, смена номера, пометка, "
		+ "загрузка обмена и печать, ручной КП, переходы опции, защищённый КП, дубли, служебная запись заказа, команда "
		+ "печати, права ролей, отказ ручной записи");

КонецФункции

// Уникальность номера КП без контроля платформы (docs/plans/branded-print.md, 9.4): ручной КП с номером авто-КП
// правится свободно, новый ручной КП с занятым номером - отказ (последним шагом).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийКПИзРеализацииНомер(Контекст)

	Номер = НовыйНомерКП();
	Ручной = НовоеКоммерческоеПредложение(Контекст, Контекст.Товар, ПометкаТеста() + ": ручной КП с номером");
	Ручной.Номер = Номер;
	Записать(Ручной);
	УстановитьОпциюКП(Ложь);
	Реализация = РеализацияДляКП(Контекст, Неопределено, Истина);
	Реализация.Номер = Номер;
	Реализация.Записать();
	Предложение = ЕдинственныйАвтоКП(Реализация.Ссылка, "авто-КП с номером ручного");
	ПроверитьРавенство(Номер, СокрЛП(РеквизитКП(Предложение, "Номер")),
		"авто-КП получает номер реализации, занятый ручным КП");

	УстановитьОпциюКП(Истина);
	Ручной.Комментарий = Ручной.Комментарий + " (правка)";
	Записать(Ручной);
	ПроверитьРавенство(Ручной.Комментарий, РеквизитКП(Ручной.Ссылка, "Комментарий"),
		"ручной КП с прежним номером, совпавшим с авто-КП, записывается");

	Второй = НовоеКоммерческоеПредложение(Контекст, Контекст.Товар, ПометкаТеста() + ": занятый номер");
	Второй.Номер = Номер;
	Отклонено = Ложь;
	Попытка
		Второй.Записать();
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	ПолучитьСообщенияПользователю(Истина);
	Проверить(Отклонено, "новый ручной КП с занятым номером года отклоняется");

	Возврат РезультатСценария("ручной и авто-КП с одним номером, правка ручного, отказ нового ручного с занятым номером");

КонецФункции

// Переходы опции (docs/plans/branded-print.md, 3.3): включение - ручная правка, отправка и копирование снимают
// автосинхронизацию; выключение - запись реализации создаёт новый авто-КП, ручные изменения целы.
//
// Параметры:
//  Контекст    - Структура - см. НовыйКонтекст
//  Реализация  - ДокументОбъект.РеализацияТоваровУслуг - записанная реализация
//  Предложение - ДокументСсылка.КоммерческоеПредложение - авто-КП реализации
//
Процедура ПроверитьПереходыОпцииКП(Контекст, Реализация, Предложение)

	УстановитьОпциюКП(Истина);
	Правка = Предложение.ПолучитьОбъект();
	Правка.Комментарий = ПометкаТеста() + ": ручная правка авто-КП";
	Правка.Записать();
	Проверить(Не АвтосинхронизацияКП(Предложение), "ручная правка снимает автосинхронизацию");
	Копия = Правка.Скопировать();
	Копия.Дата = СледующаяДата(Контекст);
	// Номер копии выдаёт автонумерация: прежний занят оригиналом.
	Копия.Номер = "";
	Копия.Записать();
	Проверить(Не АвтосинхронизацияКП(Копия.Ссылка), "копия КП - не авто-КП");
	Реализация.Записать();
	ПроверитьРавенство(0, АвтоКП(Реализация.Ссылка).Количество(), "при включённой опции реализация КП не создаёт");

	УстановитьОпциюКП(Ложь);
	Реализация.Записать();
	НовыйАвтоКП = ЕдинственныйАвтоКП(Реализация.Ссылка, "после выключения опции");
	Проверить(НовыйАвтоКП <> Предложение, "после выключения опции создан новый авто-КП");
	ПроверитьРавенство(Правка.Комментарий, РеквизитКП(Предложение, "Комментарий"),
		"ручная правка прежнего авто-КП цела");

	УстановитьОпциюКП(Истина);
	Отправка = НовыйАвтоКП.ПолучитьОбъект();
	Отправка.Статус = Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	Отправка.Записать();
	Проверить(Не АвтосинхронизацияКП(НовыйАвтоКП), "отправка снимает автосинхронизацию");
	УстановитьОпциюКП(Ложь);
	Реализация.Записать();
	Проверить(ЕдинственныйАвтоКП(Реализация.Ссылка, "после отправки") <> НовыйАвтоКП,
		"после отправки реализация ведёт новый авто-КП");

КонецПроцедуры

// Авто-КП, пришедший загрузкой обмена отправленным с ненормализованной валютой, и черновик с Версия = 0, но с записью
// архива редакций, не перезаписываются: снимается только флаг, у реализации - новый авто-КП
// (docs/plans/branded-print.md, 9.5 п. 4).
//
// Параметры:
//  Реализация  - ДокументОбъект.РеализацияТоваровУслуг - записанная реализация
//
Процедура ПроверитьЗащищенныйАвтоКП(Реализация)

	Защищенный = ЕдинственныйАвтоКП(Реализация.Ссылка, "перед загрузкой отправленного");
	Загруженный = Защищенный.ПолучитьОбъект();
	Загруженный.Статус = Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	Загруженный.ВВалюте = Ложь;
	Загруженный.КурсВалюты = 0;
	Загруженный.Комментарий = ПометкаТеста() + ": отправлен в другой базе";
	Загруженный.ОбменДанными.Загрузка = Истина;
	Загруженный.Записать();
	Снимок = СнимокКП(Защищенный);
	ПечатьКПРеализации(Реализация.Ссылка);
	Проверить(Не АвтосинхронизацияКП(Защищенный), "у отправленного из обмена авто-КП снят флаг");
	ПроверитьРавенство(Снимок, СнимокКП(Защищенный), "отправленный из обмена авто-КП не перезаписан");
	Проверить(ЕдинственныйАвтоКП(Реализация.Ссылка, "после защищённого") <> Защищенный,
		"вместо защищённого КП у реализации новый авто-КП");

	// Черновик с Версия = 0, но с записью архива редакций (загрузка обмена пишет редакции без документа): архив -
	// источник истины, КП не перезаписывается.
	САрхивом = ЕдинственныйАвтоКП(Реализация.Ссылка, "перед загрузкой редакции");
	Набор = РегистрыСведений.РедакцииКоммерческихПредложений.СоздатьНаборЗаписей();
	Набор.Отбор.Предложение.Установить(САрхивом);
	Запись = Набор.Добавить();
	Запись.Предложение = САрхивом;
	Запись.Версия = 1;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	СнимокСАрхивом = СнимокКП(САрхивом);
	Реализация.Комментарий = ПометкаТеста() + ": после загрузки редакции";
	Реализация.Записать();
	Проверить(Не АвтосинхронизацияКП(САрхивом), "у черновика с архивом редакций снят флаг");
	ПроверитьРавенство(СнимокСАрхивом, СнимокКП(САрхивом), "черновик с архивом редакций не перезаписан");

КонецПроцедуры

// Дубли прошлых сбоев: синхронизируется один авто-КП, у остальных флаг снимается (docs/plans/branded-print.md, 9.5).
//
// Параметры:
//  Реализация  - ДокументОбъект.РеализацияТоваровУслуг - записанная реализация
//
Процедура ПроверитьДублиАвтоКП(Реализация)

	Актуальный = ЕдинственныйАвтоКП(Реализация.Ссылка, "перед дублем");
	Дубль = Актуальный.ПолучитьОбъект().Скопировать();
	Дубль.Дата = Реализация.Дата;
	Дубль.Основание = Реализация.Ссылка;
	Дубль.Автосинхронизация = Истина;
	Дубль.Номер = Реализация.Номер;
	Дубль.ОбменДанными.Загрузка = Истина;
	Дубль.Записать();
	ПроверитьРавенство(2, АвтоКП(Реализация.Ссылка).Количество(), "дубль авто-КП записан загрузкой");
	ПечатьКПРеализации(Реализация.Ссылка);
	ПроверитьРавенство(1, АвтоКП(Реализация.Ссылка).Количество(), "после печати авто-КП реализации один");

КонецПроцедуры

// Служебная запись «Выигран» из заказа по авто-КП при выключенной опции: заказ записывается, КП передан человеку и не
// перезаписан, печать ведёт новый авто-КП. Порядки: служебная запись, потом печать; печать, служебная запись, печать.
//
// Параметры:
//  Контекст    - Структура - см. НовыйКонтекст
//  Реализация  - ДокументОбъект.РеализацияТоваровУслуг - записанная реализация
//  СначалаПечать - Булево - печать реализации до служебной записи
//
Процедура ПроверитьСлужебнуюЗаписьАвтоКП(Контекст, Реализация, СначалаПечать)

	Если СначалаПечать Тогда
		ПечатьКПРеализации(Реализация.Ссылка);
	КонецЕсли;
	Выигранный = ЕдинственныйАвтоКП(Реализация.Ссылка, "перед заказом");
	Заказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	Заказ.Заполнить(Выигранный);
	Заказ.Дата = СледующаяДата(Контекст);
	Записать(Заказ);
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Выигран, РеквизитКП(Выигранный, "Статус"),
		"заказ по авто-КП при выключенной опции отмечает КП выигранным");
	Проверить(Не АвтосинхронизацияКП(Выигранный), "выигранный КП передан человеку");
	Снимок = СнимокКП(Выигранный);
	ПечатьКПРеализации(Реализация.Ссылка);
	Проверить(ЕдинственныйАвтоКП(Реализация.Ссылка, "после заказа") <> Выигранный,
		"после служебной записи печать ведёт новый авто-КП");
	ПроверитьРавенство(Снимок, СнимокКП(Выигранный), "выигранный КП не перезаписан");

КонецПроцедуры

Процедура ПроверитьКомандуПечатиКП(Реализация)

	УстановитьОпциюКП(Ложь);
	Проверить(ЕстьКомандаПечатиКП(), "при выключенной опции у реализации есть команда печати КП");
	УстановитьОпциюКП(Истина);
	Проверить(Не ЕстьКомандаПечатиКП(), "при включённой опции команды печати КП у реализации нет");
	Отклонено = Ложь;
	Попытка
		ПечатьКПРеализации(Реализация.Ссылка);
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	Проверить(Отклонено, "при включённой опции печать КП из реализации отказывает");
	// Адаптер выбирается по типу ссылки: реализация, переданная менеджеру печати КП, проходит ту же проверку
	// (ai-security фазы 2, P0).
	Отклонено = Ложь;
	Попытка
		ПечатныеФормы.СформироватьПечатныеФормы("Документ.КоммерческоеПредложение", "КоммерческоеПредложение",
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Реализация.Ссылка));
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	Проверить(Отклонено, "реализация через менеджер печати КП при включённой опции - отказ");

КонецПроцедуры

// Содержание услуги и описание карточки для печати вместе длиннее 1024 знаков переходят в КП целиком
// (docs/plans/branded-print.md, 9.1 и 9.6).
//
// Параметры:
//  Контекст    - Структура - см. НовыйКонтекст
//
Процедура ПроверитьДлинноеОписаниеУслуги(Контекст)

	// BSLLS:MagicNumber-off - длины текстов: вместе больше прежнего предела строки КП в 1024 знака.
	Услуга = НоваяНоменклатура(Контекст, "услуга с длинным описанием", Перечисления.ТипыНоменклатуры.Услуга);
	Карточка = Услуга.ПолучитьОбъект();
	Карточка.Описание = ДлинныйТекст("описание карточки", 900);
	Карточка.ВыводитьНаПечатьОписание = Истина;
	Карточка.Записать();
	Реализация = РеализацияДляКП(Контекст, Услуга, Ложь);
	Реализация.ТЧУслуги[0].Содержание = ДлинныйТекст("содержание", 250);
	// BSLLS:MagicNumber-on
	Реализация.Записать();
	Предложение = ЕдинственныйАвтоКП(Реализация.Ссылка, "услуга с длинным описанием");
	Строки = Документы.КоммерческоеПредложение.ДанныеДляПечати(Предложение.ПолучитьОбъект()).Товары;
	ПроверитьРавенство(Реализация.ТЧУслуги[0].Содержание + Символы.ПС + Карточка.Описание, Строки[0].Описание,
		"длинные содержание услуги и описание карточки в КП целиком");

КонецПроцедуры

Функция ДлинныйТекст(Слово, Длина)

	Текст = "";
	Пока СтрДлина(Текст) < Длина Цикл
		Текст = Текст + Слово + " ";
	КонецЦикла;
	Возврат Лев(Текст, Длина - 1) + ".";

КонецФункции

// Реализация для КП: товар с упаковкой, товар без упаковки с нулевым количеством упаковок (историческая строка),
// услуга с содержанием; без товаров - только услуга.
//
// Параметры:
//  Контекст    - Структура - см. НовыйКонтекст
//  Услуга     - СправочникСсылка.Номенклатура, Неопределено - услуга строки услуг
//  СТоварами  - Булево - добавить строки товаров
//  ОдинТовар  - Булево - одна строка товара в упаковке, без услуги и строки без упаковки
//
// Возвращаемое значение:
//  ДокументОбъект.РеализацияТоваровУслуг - записанная реализация
//
Функция РеализацияДляКП(Контекст, Услуга, СТоварами, ОдинТовар = Ложь)

	Док = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПокупателя;
	Док.ЦенаВключаетНДС = Истина;
	Товары = "ТЧТовары";
	Если ОдинТовар Тогда
		// BSLLS:MagicNumber-off
		ДобавитьСтрокуТоваров(Контекст, Док, Товары, Контекст.Товар, 2, 10);
		// BSLLS:MagicNumber-on
		Записать(Док);
		Возврат Док;
	КонецЕсли;
	Если СТоварами Тогда
		// BSLLS:MagicNumber-off - количества и цены строк сценария.
		ДобавитьСтрокуТоваров(Контекст, Док, Товары, Контекст.Товар, 2, 10);
		ДобавитьСтрокуТоваров(Контекст, Док, Товары, Контекст.Сырье, 3, 5);
		// BSLLS:MagicNumber-on
		Док.ТЧТовары[1].Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	КонецЕсли;
	Если Услуга <> Неопределено Тогда
		// BSLLS:MagicNumber-off
		ДобавитьСтрокуТоваров(Контекст, Док, "ТЧУслуги", Услуга, 1, 100);
		// BSLLS:MagicNumber-on
		Док.ТЧУслуги[0].Содержание = СодержаниеУслугиКП();
	КонецЕсли;
	Записать(Док);
	Если СТоварами Тогда
		// Историческая строка без упаковки с нулевым количеством упаковок: проверка заполнения её бы не пропустила,
		// в базе такие строки есть из старых данных - запись без проверки.
		Док.ТЧТовары[1].КоличествоУпаковок = 0;
		Док.Записать();
	КонецЕсли;
	Возврат Док;

КонецФункции

// Авто-КП совпадает с реализацией: номер, дата, основание, статус, итоги; строки печати - наименование, описание,
// количество, единица товаров и услуг.
//
// Параметры:
//  Предложение - ДокументСсылка.КоммерческоеПредложение - авто-КП
//  Реализация  - ДокументОбъект.РеализацияТоваровУслуг - записанная реализация
//  Описание    - Строка - случай для текста проверки
//
Процедура ПроверитьАвтоКППоРеализации(Предложение, Реализация, Описание)

	Объект = Предложение.ПолучитьОбъект();
	ПроверитьРавенство(СокрЛП(Реализация.Номер), СокрЛП(Объект.Номер), Описание + ": номер КП - номер реализации");
	ПроверитьРавенство(Реализация.Дата, Объект.Дата, Описание + ": дата КП - дата реализации");
	ПроверитьРавенство(Реализация.Ссылка, Объект.Основание, Описание + ": основание КП");
	Проверить(Объект.Автосинхронизация, Описание + ": КП из реализации синхронизируется");
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Черновик, Объект.Статус, Описание + ": статус");
	ПроверитьРавенство(Реализация.Сумма, Объект.Сумма, Описание + ": сумма КП - сумма реализации");
	ПроверитьРавенство(Реализация.СуммаНДС, Объект.СуммаНДС, Описание + ": НДС КП - НДС реализации");
	ПроверитьРавенство(Реализация.СуммаБезНДС, Объект.СуммаБезНДС, Описание + ": сумма без НДС");

	Строки = Документы.КоммерческоеПредложение.ДанныеДляПечати(Объект).Товары;
	ПроверитьРавенство(Реализация.ТЧТовары.Количество() + Реализация.ТЧУслуги.Количество(), Строки.Количество(),
		Описание + ": строки КП - товары и услуги реализации");
	Индекс = 0;
	Для Каждого Товар Из Реализация.ТЧТовары Цикл
		ПроверитьСтрокуПечатиКП(Строки[Индекс], Товар.Номенклатура, Товар.Количество, "", Описание);
		Индекс = Индекс + 1;
	КонецЦикла;
	Для Каждого Услуга Из Реализация.ТЧУслуги Цикл
		ПроверитьСтрокуПечатиКП(Строки[Индекс], Услуга.Номенклатура, Услуга.Количество, Услуга.Содержание, Описание);
		Индекс = Индекс + 1;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьСтрокуПечатиКП(СтрокаПечати, Номенклатура, Количество, Содержание, Описание)

	Сведения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "НаименованиеПолное, Единица");
	Проверить(СтрНайти(СтрокаПечати.Наименование, СокрЛП(Сведения.НаименованиеПолное)) = 1,
		Описание + ": наименование строки печати - " + СтрокаПечати.Наименование);
	ПроверитьРавенство(Количество, СтрокаПечати.Количество, Описание + ": количество строки печати");
	ПроверитьРавенство(СокрЛП(Сведения.Единица), СтрокаПечати.Единица, Описание + ": единица строки печати");
	ПроверитьРавенство(СокрЛП(Содержание), СтрокаПечати.Описание, Описание + ": описание строки печати");

КонецПроцедуры

Функция ПечатьКПРеализации(Реализация)

	Результат = ПечатныеФормы.СформироватьПечатныеФормы("Документ.РеализацияТоваровУслуг", "КоммерческоеПредложение",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Реализация));
	ТабличныйДокумент = Результат.КоллекцияПечатныхФорм[0].ТабличныйДокумент;
	Проверить(ТипЗнч(ТабличныйДокумент) = Тип("ТабличныйДокумент") И ТабличныйДокумент.ВысотаТаблицы > 0,
		"печатная форма КП из реализации пуста");
	Возврат ТабличныйДокумент;

КонецФункции

Функция АвтоКП(Реализация)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Предложения.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КоммерческоеПредложение КАК Предложения
	|ГДЕ
	|	Предложения.Основание = &Реализация
	|	И Предложения.Автосинхронизация");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Функция ЕдинственныйАвтоКП(Реализация, Описание)

	Найденные = АвтоКП(Реализация);
	ПроверитьРавенство(1, Найденные.Количество(), Описание + ": авто-КП реализации ровно один");
	Возврат Найденные[0];

