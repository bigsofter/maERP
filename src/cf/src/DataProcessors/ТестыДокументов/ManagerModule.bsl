// Реализация без ордера: себестоимость не определена, пока расходный ордер на её основании не отгрузил; после -
// себестоимость по списанию ордера.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДокументПервыйРасход(Контекст)

	// BSLLS:MagicNumber-off
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар отгрузки по реализации", Перечисления.ТипыНоменклатуры.Товар);
	ОприходоватьНаСклад(Контекст, Склад, Товар, 10, 5);
	Реализация = РеализацияБезОрдера(Контекст, Склад, Товар, 4);
	ПроверитьРавенство(0, СебестоимостьРеализацииСценария(Реализация.Ссылка), "до отгрузки себестоимости нет");
	Проверить(РаботаСДокументами.АктуальностьСебестоимости().Неотгружено > 0, "реализация с неотгруженными строками в счётчике");
	ОрдерПоДокументу(Контекст, "РасходныйОрдер", Реализация.Ссылка, 3);
	ПроверитьРавенство(7, ОстатокПартийСклада(Склад, Товар), "расходный ордер списал партии");
	ПроверитьРавенство(15, СебестоимостьРеализацииСценария(Реализация.Ссылка), "себестоимость отгруженных 3");
	ОрдерПоДокументу(Контекст, "РасходныйОрдер", Реализация.Ссылка, Неопределено);
	ПроверитьРавенство(20, СебестоимостьРеализацииСценария(Реализация.Ссылка), "вторая отгрузка - себестоимость 4");
	ПроверитьРавенство(0, ОстатокКОформлению(Реализация.Ссылка), "реализация отгружена");
	// BSLLS:MagicNumber-on
	Возврат РезультатСценария("реализация без ордера: себестоимость - по отгрузкам расходных ордеров на её основании");

КонецФункции

