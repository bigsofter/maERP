Функция ЦенаПервойСтрокиКП(Предложение)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Строки.Цена КАК Цена
	|ИЗ
	|	Документ.КоммерческоеПредложение.ТЧТовары КАК Строки
	|ГДЕ
	|	Строки.Ссылка = &Предложение
	|	И Строки.НомерСтроки = 1");
	Запрос.УстановитьПараметр("Предложение", Предложение);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Цена, Неопределено);

КонецФункции

// Состояние КП для сравнения «до и после», кроме флага автосинхронизации и версии данных: шапка и строки.
//
// Параметры:
//  Предложение - ДокументСсылка.КоммерческоеПредложение - предложение
//
// Возвращаемое значение:
//  Строка - строки «шапка|строка» в порядке строк, через перевод строки
//
Функция СнимокКП(Предложение)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Предложения.Номер КАК Номер,
	|	Предложения.Статус КАК Статус,
	|	Предложения.ВВалюте КАК ВВалюте,
	|	Предложения.КурсВалюты КАК КурсВалюты,
	|	Предложения.Сумма КАК Сумма,
	|	Предложения.Комментарий КАК Комментарий,
	|	Строки.НомерСтроки КАК НомерСтроки,
	|	Строки.Номенклатура КАК Номенклатура,
	|	Строки.Количество КАК Количество,
	|	Строки.Цена КАК Цена,
	|	Строки.Описание КАК Описание
	|ИЗ
	|	Документ.КоммерческоеПредложение КАК Предложения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КоммерческоеПредложение.ТЧТовары КАК Строки
	|		ПО Предложения.Ссылка = Строки.Ссылка
	|ГДЕ
	|	Предложения.Ссылка = &Предложение
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки");
	Запрос.УстановитьПараметр("Предложение", Предложение);
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Значения = СтрШаблон("%1|%2|%3|%4|%5|%6|%7|%8|%9", Выборка.Номер, Выборка.Статус, Выборка.ВВалюте,
			Выборка.КурсВалюты, Выборка.Сумма, Выборка.Комментарий, Выборка.Номенклатура, Выборка.Количество,
			Выборка.Цена);
		Строки.Добавить(Значения + "|" + Выборка.Описание);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

