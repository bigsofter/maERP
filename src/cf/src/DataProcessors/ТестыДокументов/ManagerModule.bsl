//
// Возвращаемое значение:
//  Строка - текст пометки
//
Функция ПометкаТеста()

	Возврат "Тест уровня 3";

КонецФункции

Функция НоваяЕдиница()

	Единица = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	Единица.Наименование = "шт (" + ПометкаТеста() + ")";
	Единица.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
	Единица.Числитель = 1;
	Единица.Знаменатель = 1;
	Единица.Записать();
	Возврат Единица.Ссылка;

КонецФункции

Функция НовыйСклад()

	Склад = Справочники.МестаХранения.СоздатьЭлемент();
	Склад.Наименование = ПометкаТеста() + ": склад";
	Склад.Записать();
