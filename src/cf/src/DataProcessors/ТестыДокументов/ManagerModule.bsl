Функция РеализацияБезОрдера(Контекст, Склад, Товар, Количество)
	// BSLLS:MagicNumber-off - цена продажи
	Заказ = ДокументЗаказаПокупателя(Контекст, Товар, Количество, 50);
	// BSLLS:MagicNumber-on
	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.Заполнить(Заказ);
	Реализация.Дата = СледующаяДата(Контекст);
	Реализация.МестоХранения = Склад;
	Реализация.Комментарий = Контекст.Пометка;
	Провести(Реализация);
	Возврат Реализация;
КонецФункции

Функция ОрдерПоДокументу(Контекст, ИмяОрдера, Документ, Количество)
	Ордер = НовыйДокумент(Контекст, ИмяОрдера);
	Ордер.Заполнить(Документ);
	Ордер.Дата = СледующаяДата(Контекст);
	Если Количество <> Неопределено Тогда
		Ордер.ТЧТовары[0].Количество = Количество;
		Ордер.ТЧТовары[0].КоличествоУпаковок = Количество;
	КонецЕсли;
	Провести(Ордер);
	Возврат Ордер.Ссылка;
КонецФункции

Функция СуммаПартииСценария(Партия)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Записи.Сумма), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии КАК Записи
		|ГДЕ
		|	Записи.Партия = &Партия
		|	И Записи.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
	Запрос.УстановитьПараметр("Партия", Партия);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;
КонецФункции

Функция ОтказЗаписиВРежиме(Документ, Режим)
	ПолучитьСообщенияПользователю(Истина);
	Попытка
		Документ.Записать(Режим);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

#КонецОбласти

#Область ОпцияОрдерныхСкладов

// Опция «Ордерные склады» (2.0.16.107, docs/plans/warehouse-orders-option.md): инвариант «опция выключена - ордерных
// складов и ордеров нет». Каждый отказ записи - отдельный сценарий и последнее действие с данными: после него
// транзакция раннера годна только для отката. Сценарии, которым нужна база без ордеров, на заполненной базе
// пропускаются - данные базы ради теста не чистятся.
//
// Параметры:
//  Имя      - Строка - имя сценария.
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОпцииОрдерныхСкладовПоИмени(Имя, Контекст)

	Если Имя = "ОпцияОрдерныхСкладовОтказСклада" Тогда
		Возврат СценарийОпцияОрдерныхСкладовОтказСклада(Контекст);
	КонецЕсли;
	Если Имя = "ОпцияОрдерныхСкладовОтказОрдера" Тогда
		Возврат СценарийОпцияОрдерныхСкладовОтказОрдера(Контекст);
	КонецЕсли;
	Если Имя = "ОпцияОрдерныхСкладовОтказЗагрузки" Тогда
		Возврат СценарийОпцияОрдерныхСкладовОтказЗагрузки(Контекст, "РасходныйОрдер");
	КонецЕсли;
	Если Имя = "ОпцияОрдерныхСкладовОтказЗагрузкиПрихода" Тогда
		Возврат СценарийОпцияОрдерныхСкладовОтказЗагрузки(Контекст, "ПриходныйОрдер");
	КонецЕсли;
	Если Имя = "ОпцияОрдерныхСкладовВключение" Тогда
		Возврат СценарийОпцияОрдерныхСкладовВключение(Контекст);
	КонецЕсли;
	Если Имя = "ОпцияОрдерныхСкладовОтказВыключения" Тогда
		Возврат СценарийОпцияОрдерныхСкладовОтказВыключения(Контекст);
	КонецЕсли;
	Если Имя = "ОпцияОрдерныхСкладовЧерновик" Тогда
		Возврат СценарийОпцияОрдерныхСкладовЧерновик(Контекст);
	КонецЕсли;
	Если Имя = "ОпцияОрдерныхСкладовОбновление" Тогда
		Возврат СценарийОпцияОрдерныхСкладовОбновление(Контекст);
	КонецЕсли;
	ВызватьИсключение "Сценарий " + Имя + " не описан в СценарийОпцииОрдерныхСкладовПоИмени";

КонецФункции

Функция ПричинаПропускаОпцииОрдерныхСкладов()
	Если Справочники.МестаХранения.ОрдерныеСкладыИспользуются() Тогда
		Возврат "в базе есть ордерные склады или ордера - опцию не выключить";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ФрагментыОтказаОпцииОрдерныхСкладов()
	Возврат "«Ордерные склады»|« Entrepôts à bons »|«Order-based warehouses»|«Almacenes con órdenes»";
КонецФункции

Функция СценарийОпцияОрдерныхСкладовОтказСклада(Контекст)

	Причина = ПричинаПропускаОпцииОрдерныхСкладов();
	Если ЗначениеЗаполнено(Причина) Тогда
		Возврат РезультатСценария(Причина, Истина);
	КонецЕсли;
	Константы.ИспользоватьОрдерныеСклады.Установить(Ложь);
	Склад = Справочники.МестаХранения.СоздатьЭлемент();
	Склад.Наименование = ПометкаТеста() + ": ордерный склад без опции";
	Склад.ОрдерныйСклад = Истина;
	ПолучитьСообщенияПользователю(Истина);
	Отказ = Ложь;
	Попытка
		Склад.Записать();
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "ордерный склад при выключенной опции - отказ");
	Проверить(ЕстьСообщениеОтказа(ФрагментыОтказаОпцииОрдерныхСкладов()), "отказ склада - с текстом про опцию");
	Возврат РезультатСценария("признак «Ордерный склад» при выключенной опции не записывается");

КонецФункции

