	Проверить(Не ПравоДоступа(Право, Группы.Товары, Логист), "у Логиста нет группы «Товары»");
	// PDV и оператору производства раздел скрыт в командном интерфейсе конфигурации, но права на группы сохранены.
	Для Каждого ИмяРоли Из СтрРазделить("PDV,ОператорПроизводства", ",") Цикл
		Роль = Метаданные.Роли[ИмяРоли];
		Описание = "роль " + ИмяРоли;
		Для Каждого ИмяГруппы Из СтрРазделить("Инвентаризация,ИзлишкиИСписания,Товары,Хранение", ",") Цикл
			Проверить(ПравоДоступа(Право, Группы[ИмяГруппы], Роль), Описание + " видит группу " + ИмяГруппы);
		КонецЦикла;
	КонецЦикла;
	Проверить(ПравоДоступа(Право, Группы.Комплектация, Метаданные.Роли.PDV), "роль PDV видит группу Комплектация");
	Проверить(Не ПравоДоступа(Право, Группы.Комплектация, Метаданные.Роли.ОператорПроизводства),
		"у оператора производства нет «Комплектации», как не было «Внутреннего товародвижения»");

КонецПроцедуры

// Разделы «Казначейство» и «Бухгалтерия» (этап 5 menu-restructure, 2.0.16.10): группы и их права, группы под
// опциями, платёжные документы в составе раздела, «Главная книга» удалена (дубль «Расчетов с покупателями»), её
// разрез - вариантом «По объектам расчётов»; бухгалтерские отчёты, выведенные в меню, формируются на настоящей
// проводке (на пустом регистре смок их формирует, а падение выражения на данных не видит - tiny1C query-007).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийМенюКазначействаИБухгалтерии(Контекст)

	Казначейство = Метаданные.Подсистемы.Казначейство;
	ПроверитьРавенство("Касса, Банк, ОплатыКлиентов, Расчёты, Справочники", ИменаГрупп(Казначейство),
		"группы раздела «Казначейство»");
	Проверить(ВСоставеОпции("ИспользоватьАльтернативныеОплаты", Казначейство.Подсистемы.ОплатыКлиентов),
		"«Оплаты клиентов» - в опции альтернативных оплат");
	МетаДокументы = Метаданные.Документы;
	Для Каждого ИмяДокумента Из СтрРазделить("ПриходныйКассовыйОрдер,РасходныйКассовыйОрдер,"
		+ "ПоступлениеБезналичныхДенежныхСредств,СписаниеБезналичныхДенежныхСредств", ",") Цикл
		Проверить(Казначейство.Состав.Содержит(МетаДокументы[ИмяДокумента]), ИмяДокумента + " - в корне «Казначейства»");
	КонецЦикла;
	Проверить(Казначейство.Состав.Содержит(Метаданные.Отчеты.КассоваяКнига), "кассовая книга - в «Казначействе»");
	Проверить(Не Казначейство.Состав.Содержит(Метаданные.Обработки.ПерепроведениеДокументов),
		"перепроведение ушло из «Казначейства»");
	Право = "Просмотр";
	Для Каждого ИмяРоли Из СтрРазделить("Казначей,Оператор", ",") Цикл
		Роль = Метаданные.Роли[ИмяРоли];
		Описание = "роль " + ИмяРоли;
		Для Каждого Группа Из Казначейство.Подсистемы Цикл
			Проверить(ПравоДоступа(Право, Группа, Роль), Описание + " видит " + Группа.ПолноеИмя());
		КонецЦикла;
	КонецЦикла;
	Казначей = Метаданные.Роли.Казначей;
	Сервис = Метаданные.Подсистемы.Сервис;
	Проверить(ПравоДоступа(Право, Сервис, Казначей) И ПравоДоступа(Право, Сервис.Подсистемы.СервисныеОперации, Казначей),
		"Казначей видит «Настройка / Сервисные операции» (перепроведение)");
	Проверить(Не ПравоДоступа(Право, Сервис.Подсистемы.ПользователиИПрава, Казначей),
		"у Казначея нет «Пользователей и прав»");

	Бухгалтерия = Метаданные.Подсистемы.Бухгалтерия;
	ПроверитьРавенство("НалоговыеДокументы, РегламентированныйУчет, ПрочиеДокументы", ИменаГрупп(Бухгалтерия),
		"группы раздела «Бухгалтерия»");
	Проверить(ВСоставеОпции("ИспользоватьРегламентированныйУчет", Бухгалтерия.Подсистемы.РегламентированныйУчет),
		"«Регламентированный учёт» - в своей опции");
	Проверить(Метаданные.Отчеты.Найти("ГлавнаяКнига") = Неопределено, "«Главная книга» удалена");
	Схема = Отчеты.РасчетыСПокупателями.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Проверить(Схема.НаборыДанных[0].Поля.Найти("ОбъектРасчётов") <> Неопределено,
		"«Расчеты с покупателями» отдают объект расчётов");
	Проверить(Схема.ВариантыНастроек.Найти("ПоОбъектамРасчётов") <> Неопределено,
		"вариант «По объектам расчётов» - разрез «Главной книги»");

	Сумма = Контекст.Числа.ЦенаЗакупки;
	Проводка = ПроводкаРегламентированногоУчета(Контекст, Сумма);
	Сформировано = Новый Массив;
	Проверить(Бухгалтерия.Состав.Содержит(Метаданные.Отчеты.КарточкаСубконто), "КарточкаСубконто - в «Бухгалтерии»");
	// «Карточка субконто» не формируется без видов субконто (обязательный реквизит формы), а у счетов сценария
	// субконто нет - её проверка руками на счёте с субконто.
	Для Каждого ИмяОтчета Из СтрРазделить("ОборотноСальдоваяВедомость,ОборотноСальдоваяВедомостьПоСчету,ОборотыСчета,"
		+ "АнализСчета,КарточкаСчета,АнализСубконто,ОтчетПоПроводкам", ",") Цикл
		Проверить(Бухгалтерия.Состав.Содержит(Метаданные.Отчеты[ИмяОтчета]), ИмяОтчета + " - в «Бухгалтерии»");
		Сформирован = ОтчетНаПроводке(ИмяОтчета, Контекст, Проводка);
		// Модуль отчёта и выражения схемы отработали на данных. Группировки и периодичность форма задаёт своими
		// реквизитами - без них строки счетов не выводятся; содержимое отчётов проверяется руками в форме.
		Проверить(Сформирован.Выполнено, ИмяОтчета + " сформирован на проводке: " + Сформирован.КраткоеПредставлениеОшибки);
		Сформировано.Добавить(ИмяОтчета);
	КонецЦикла;
	ЧислоОтчетов = Сформировано.Количество();

	Возврат РезультатСценария("Казначейство: Касса, Банк, Оплаты клиентов (в опции), Расчёты, Справочники, платёжные "
		+ "документы в корне, перепроведение - в «Настройке»; Бухгалтерия: Налоговые документы, Регламентированный учёт "
		+ "(в опции), Прочие документы, «Главной книги» нет, её разрез - вариантом; на проводке сформированы "
		+ ЧислоОтчетов + " бухотчётов");

КонецФункции

Функция ИменаГрупп(Подсистема)

	Группы = Новый Массив;
	Для Каждого Группа Из Подсистема.Подсистемы Цикл
		Группы.Добавить(Группа.Имя);
	КонецЦикла;
	Возврат СтрСоединить(Группы, ", ");

КонецФункции

// Операция регламентированного учёта с одной проводкой между двумя новыми счетами.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Сумма    - Число     - сумма проводки
//
// Возвращаемое значение:
//  Структура - Операция, СчетДт, СчетКт, КодДт
//
Функция ПроводкаРегламентированногоУчета(Контекст, Сумма)

	Пометка = ПометкаТеста();
	Счета = Новый Массив;
	// План счетов предопределён: интерактивного добавления счетов нет и у администратора. Счета - только подготовка
	// данных сценария, отчёты дальше формируются под правами пользователя.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Для Каждого Код Из СтрРазделить("Т991,Т992", ",") Цикл
		Счет = ПланыСчетов.Хозрасчетный.СоздатьСчет();
		Счет.Код = Код;
		Счет.Наименование = Пометка + ": счёт " + Код;
		Счет.Записать();
		Счета.Добавить(Счет.Ссылка);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);

	Операция = НовыйДокумент(Контекст, "ОперацияБух");
	Операция.СуммаОперации = Сумма;
	Операция.Содержание = Пометка;
	Движение = Операция.Движения.Хозрасчетный.Добавить();
	Движение.Период = Операция.Дата;
	Движение.Организация = Контекст.Организация;
	Движение.СчетДт = Счета[0];
	Движение.СчетКт = Счета[1];
	Движение.Сумма = Сумма;
	Движение.Содержание = Пометка;
	Операция.Записать(РежимЗаписиДокумента.Запись);

	Результат = Новый Структура;
	Результат.Вставить("Операция", Операция.Ссылка);
	Результат.Вставить("СчетДт", Счета[0]);
	Результат.Вставить("СчетКт", Счета[1]);
	Результат.Вставить("КодДт", "Т991");
	Возврат Результат;

КонецФункции

// Бухгалтерский отчёт, сформированный так же, как его формирует форма: параметры отчёта - из реквизитов объекта отчёта
// (табличные части - выгрузкой) поверх пустых параметров, схема и её настройки по умолчанию, затем
// БухгалтерскиеОтчетыВызовСервера.ПодготовитьОтчет - модуль менеджера строит структуру по параметрам
// (ПередКомпоновкойМакета). Период и счёт - из проводки, показатель - бухгалтерский учёт.
//
// Параметры:
//  ИмяОтчета - Строка    - имя отчёта
//  Контекст  - Структура - см. НовыйКонтекст
//  Проводка  - Структура - см. ПроводкаРегламентированногоУчета
//
// Возвращаемое значение:
//  Структура - результат ПодготовитьОтчет: Выполнено, Результат (ТабличныйДокумент), КраткоеПредставлениеОшибки
//
Функция ОтчетНаПроводке(ИмяОтчета, Контекст, Проводка)

	Отчет = Отчеты[ИмяОтчета].Создать();
	МетаОтчета = Отчет.Метаданные();
	Реквизиты = МетаОтчета.Реквизиты;
	Отчет.Организация = Контекст.Организация;
	Отчет.НачалоПериода = НачалоДня(Контекст.Дата);
	Отчет.КонецПериода = КонецДня(ТекущаяДатаСеанса());
	Если Реквизиты.Найти("Счет") <> Неопределено Тогда
		Отчет.Счет = Проводка.СчетДт;
	КонецЕсли;
	Отчет.ПоказательБУ = Истина;
	// Колонки сальдо и оборотов форма включает при открытии (БухгалтерскиеОтчетыВызовСервера.ПриСозданииНаСервере).
	Если Реквизиты.Найти("СальдоНаНачалоДт") <> Неопределено Тогда
		Для Каждого Колонка Из СтрРазделить("СальдоНаНачалоДт,СальдоНаНачалоКт,СальдоНаКонецДт,СальдоНаКонецКт,"
			+ "ОборотыЗаПериодДт,ОборотыЗаПериодКт,ОборотыСоСчетамиДт,ОборотыСоСчетамиКт", ",") Цикл
			Отчет[Колонка] = Истина;
		КонецЦикла;
	КонецЕсли;

	ПараметрыОтчета = БухгалтерскиеОтчеты.ПустыеПараметрыКомпоновкиОтчета();
	Для Каждого Реквизит Из Реквизиты Цикл
		ПараметрыОтчета.Вставить(Реквизит.Имя, Отчет[Реквизит.Имя]);
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из МетаОтчета.ТабличныеЧасти Цикл
		ПараметрыОтчета.Вставить(ТабличнаяЧасть.Имя, Отчет[ТабличнаяЧасть.Имя].Выгрузить());
	КонецЦикла;
	Схема = Отчет.ПолучитьМакет(МетаОтчета.ОсновнаяСхемаКомпоновкиДанных.Имя);
	ПараметрыОтчета.ИдентификаторОтчета = ИмяОтчета;
	ПараметрыОтчета.СхемаКомпоновкиДанных = Схема;
	ПараметрыОтчета.НастройкиКомпоновкиДанных = Схема.НастройкиПоУмолчанию;
	ПараметрыОтчета.НаборПоказателей = Отчеты[ИмяОтчета].ПолучитьНаборПоказателей();
	ПараметрыОтчета.ВыводитьЗаголовок = Ложь;
	Возврат БухгалтерскиеОтчетыВызовСервера.ПодготовитьОтчет(ПараметрыОтчета);

КонецФункции

// Разделы «Производство», «Зарплата и кадры», CRM, «Настройка» (этап 6 menu-restructure, 2.0.16.10): группы и права,
// группы под опциями, своя команда «Переработчики» по признаку «Субподрядчик», «Сотрудники» в ЗиК (общий список
// физлиц - в «Главном»), отбор типа у команд «Сырьё», «Полуфабрикаты», «Готовая продукция» объявлен в форме.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
