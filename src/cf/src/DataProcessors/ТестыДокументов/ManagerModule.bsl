// Первая строка результата запроса структурой с указанными полями (агрегатный запрос
// без группировки возвращает ровно одну строку).
//
// Параметры:
//  Запрос - Запрос - подготовленный запрос с параметрами
//  Поля   - Строка - имена полей результата через запятую
//
// Возвращаемое значение:
//  Структура - значения полей первой строки; нули, если строк нет
//
Функция ПерваяСтрока(Запрос, Поля)

	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Структура(Поля);
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Иначе
		Для Каждого Поле Из Результат Цикл
			Результат[Поле.Ключ] = 0;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

