КонецФункции

// Ордерные склады v2, фаза 3 (Ф3.15): реализация оформила два расходных ордера (6 и 4) до 2.0.16.122, партии 6 и 4 -
// перепроведение раннего ордера списывает партии обоих по возрастанию момента: ни одна партия не уходит в минус.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладПереводРасходных(Контекст)

	// BSLLS:MagicNumber-off
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар перевода расходных", Перечисления.ТипыНоменклатуры.Товар);
	Для Каждого Количество Из СтрРазделить("6,4", ",") Цикл
		Приход = ПриходныйОрдерНаТовар(Контекст, Склад, Товар, Число(Количество));
		Поступление = ПоступлениеПоОрдеру(Контекст, Приход);
		УстановитьЦенуСтрок(Поступление, 10 * Число(Количество));
		Провести(Поступление);
	КонецЦикла;
	Заказ = ДокументЗаказаПокупателя(Контекст, Товар, 10, 50);
	Расходные = Новый Массив;
	Для Каждого Количество Из СтрРазделить("6,4", ",") Цикл
		Ордер = НовыйДокумент(Контекст, "РасходныйОрдер");
		Ордер.Заполнить(Заказ);
		Ордер.МестоХранения = Склад;
		Ордер.ТЧТовары[0].Количество = Число(Количество);
		Ордер.ТЧТовары[0].КоличествоУпаковок = Число(Количество);
		Провести(Ордер);
		Расходные.Добавить(Ордер.Ссылка);
	КонецЦикла;
	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.Заполнить(Расходные[0]);
	Реализация.Комментарий = Контекст.Пометка;
	Строка = Реализация.ТЧТовары.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Реализация.ТЧТовары[0], , "КодСтроки, КлючСтрокиОрдера");
	Строка.КодСтроки = Реализация.ТЧТовары.Итог("КодСтроки") + 1;
	Строка.Ордер = Расходные[1];
	Строка.КлючСтрокиОрдера = Расходные[1].ТЧТовары[0].КодСтроки;
	УстановитьКоличествоСтроки(Реализация.ТЧТовары[0], 6);
	УстановитьКоличествоСтроки(Строка, 4);
	Провести(Реализация);
	// BSLLS:MagicNumber-on
	// Прежнее состояние: списание партий - у реализации, у ордеров нет.
	СтароеСписание = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей();
	СтароеСписание.Отбор.Регистратор.Установить(Реализация.Ссылка);
	Для Каждого Ордер Из Расходные Цикл
		Набор = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Ордер);
		Набор.Прочитать();
		Для Каждого Запись Из Набор Цикл
			Новая = СтароеСписание.ДобавитьРасход();
			ЗаполнитьЗначенияСвойств(Новая, Запись, , "Регистратор, КодСтроки");
			Новая.Период = Реализация.Дата;
		КонецЦикла;
		Набор.Очистить();
		Набор.Записать();
	КонецЦикла;
	СтароеСписание.Записать();
	Объект = Расходные[0].ПолучитьОбъект();
	Провести(Объект);
	Проверить(Не ЕстьОтрицательныеПартии(Склад, Товар), "перевод расходных: ни одна партия не ушла в минус");
	ПроверитьРавенство(0, ОстатокПартийСклада(Склад, Товар), "перевод расходных: обе партии списаны целиком");
	Возврат РезультатСценария("перепроведение раннего расходного ордера переводит оба ордера реализации, списание по
		|возрастанию момента");

КонецФункции

// Ордерные склады v2, фаза 3 (Ф3.15): списание до 2.0.16.122 указало партию-поступление ордерного склада - после
// перевода ордера его записи ссылаются на партию ордера, партия поступления не уходит в минус.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладПереводПотребителя(Контекст)

	// BSLLS:MagicNumber-off
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар перевода потребителя", Перечисления.ТипыНоменклатуры.Товар);
	Ордер = ПриходныйОрдерНаТовар(Контекст, Склад, Товар, 5);
	Поступление = ПоступлениеПоОрдеру(Контекст, Ордер);
	Провести(Поступление);
	Списание = НовыйДокумент(Контекст, "СписаниеТоваров");
	Списание.МестоХранения = Склад;
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	ДобавитьСтрокуТоваров(Контекст, Списание, "ТЧТовары", Товар, 2, 0);
	Провести(Списание);
	// BSLLS:MagicNumber-on
	// Прежнее состояние: партия - поступление, у ордера записей нет.
	СтарыеПартии = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей();
	СтарыеПартии.Отбор.Регистратор.Установить(Поступление.Ссылка);
	Набор = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Ордер);
	Набор.Прочитать();
	Для Каждого Запись Из Набор Цикл
		Новая = СтарыеПартии.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Запись, , "Регистратор, КодСтроки");
		Новая.Период = Поступление.Дата;
		Новая.Партия = Поступление.Ссылка;
	КонецЦикла;
	Набор.Очистить();
	Набор.Записать();
	СтарыеПартии.Записать();
	НаборСписания = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей();
	НаборСписания.Отбор.Регистратор.Установить(Списание.Ссылка);
	НаборСписания.Прочитать();
	Для Каждого Запись Из НаборСписания Цикл
		Запись.Партия = Поступление.Ссылка;
	КонецЦикла;
	НаборСписания.Записать();
	Объект = Ордер.ПолучитьОбъект();
	Провести(Объект);
	НаборСписания.Прочитать();
	Проверить(НаборСписания.Количество() > 0 И НаборСписания[0].Партия = Ордер, "перевод: списание - на партии ордера");
	Проверить(Не ЕстьОтрицательныеПартии(Склад, Товар), "перевод: партия поступления не ушла в минус");
	Возврат РезультатСценария("списание партии-поступления до перевода переходит на партию ордера");

КонецФункции

// Обработчик 2.0.16.124 (Ф5.1, Редакция 48): ордер без партий (старая схема) переводится - партии ордера записаны;
// повтор ничего не находит.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладОбновлениеФазы5(Контекст)

	// BSLLS:MagicNumber-off
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар обновления фазы 5", Перечисления.ТипыНоменклатуры.Товар);
	Ордер = ПриходныйОрдерНаТовар(Контекст, Склад, Товар, 4);
	// BSLLS:MagicNumber-on
	Набор = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Ордер);
	Набор.Записать();
	ПроверитьРавенство(0, ОстатокПартийСклада(Склад, Товар), "ордер старой схемы - без партий");
	// BSLLS:MagicNumber-off
	ОбновлениеПрограммыОбработчики.ПеревестиОрдераСтаройСхемы();
	ПроверитьРавенство(4, ОстатокПартийСклада(Склад, Товар), "обработчик перевода ордеров перевёл ордер - партии есть");
	ОбновлениеПрограммыОбработчики.ПеревестиОрдераСтаройСхемы();
	ПроверитьРавенство(4, ОстатокПартийСклада(Склад, Товар), "повтор обработчика ничего не меняет");
	// BSLLS:MagicNumber-on
	Возврат РезультатСценария("обработчик перевода ордеров фазы 5 переводит ордера без партий, повтор ничего не меняет");

КонецФункции

Функция ЕстьОтрицательныеПартии(Склад, Товар)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Остатки.Партия КАК Партия
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(, МестоХранения = &Склад И Номенклатура = &Товар) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0");
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Товар", Товар);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Поступление оформило два ордера (3 и 2) до 2.0.16.122: партии - у поступления, у ордеров нет. Перепроведение первого
// ордера переводит группу: партии создают оба ордера, у поступления записей на ордерном складе нет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Склад    - СправочникСсылка.МестаХранения - ордерный склад
//
Процедура ПроверитьПереводГруппыСтарыхОрдеров(Контекст, Склад)
	// BSLLS:MagicNumber-off
	Первый = ПриходныйОрдерНаТовар(Контекст, Склад, Контекст.Товар, 3);
	Второй = ПриходныйОрдерНаТовар(Контекст, Склад, Контекст.Товар, 2);
	Поступление = ПоступлениеПоОрдеру(Контекст, Первый);
	Строка = Поступление.ТЧТовары.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Поступление.ТЧТовары[0], , "КодСтроки, КлючСтрокиОрдера");
	Строка.КодСтроки = Поступление.ТЧТовары.Итог("КодСтроки") + 1;
	Строка.Ордер = Второй;
	Строка.КлючСтрокиОрдера = Второй.ТЧТовары[0].КодСтроки;
	УстановитьКоличествоСтроки(Строка, 2);
	Провести(Поступление);
	// BSLLS:MagicNumber-on
	// Прежнее состояние: партии ордеров - у поступления.
	Записи = Новый Массив;
	Записи.Добавить(Первый);
	Записи.Добавить(Второй);
	СтарыеПартии = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей();
	СтарыеПартии.Отбор.Регистратор.Установить(Поступление.Ссылка);
	Для Каждого Ордер Из Записи Цикл
		Набор = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Ордер);
		Набор.Прочитать();
		Для Каждого Запись Из Набор Цикл
			Новая = СтарыеПартии.Добавить();
			ЗаполнитьЗначенияСвойств(Новая, Запись, , "Регистратор, КодСтроки");
			Новая.Период = Поступление.Дата;
			Новая.Партия = Поступление.Ссылка;
		КонецЦикла;
		Набор.Очистить();
		Набор.Записать();
	КонецЦикла;
	СтарыеПартии.Записать();
	Физика = ОстатокПартийСклада(Склад, Контекст.Товар);
	Объект = Первый.ПолучитьОбъект();
	Провести(Объект);
	Проверить(ОстатокПартийСклада(Склад, Контекст.Товар) = Физика, "перевод группы: остаток партий не изменился");
	Набор = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Второй);
	Набор.Прочитать();
	Проверить(Набор.Количество() > 0, "перевод группы: второй ордер получил партии");
	Набор.Отбор.Регистратор.Установить(Поступление.Ссылка);
	Набор.Прочитать();
	Проверить(Набор.Количество() = 0, "перевод группы: у поступления партий на ордерном складе нет");
КонецПроцедуры

Функция ПриходныйОрдерНаТовар(Контекст, Склад, Товар, Количество)
	Ордер = НовыйДокумент(Контекст, "ПриходныйОрдер");
	Ордер.МестоХранения = Склад;
	Ордер.Контрагент = Контекст.Контрагент;
	ДобавитьСтрокуТоваров(Контекст, Ордер, "ТЧТовары", Товар, Количество, 0);
	Провести(Ордер);
	Возврат Ордер.Ссылка;
КонецФункции

Функция РасходныйОрдерНаТовар(Контекст, Склад, Товар, Количество)
	// BSLLS:MagicNumber-off - цена продажи
