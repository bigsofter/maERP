Функция СуммаПриходаНоменклатуры(Документ, Номенклатура)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Записи.Сумма), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии КАК Записи
		|ГДЕ
		|	Записи.Регистратор = &Документ
		|	И Записи.Номенклатура = &Номенклатура
		|	И Записи.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;
КонецФункции

// Сумма допрасходов документа со знаком (приход плюс, расход минус).
//
// Параметры:
//  Документ - ДокументСсылка - регистратор
//
// Возвращаемое значение:
//  Число - сумма
//
Функция ДопрасходыДокумента(Документ)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА Записи.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|					ТОГДА Записи.Сумма
		|				ИНАЧЕ -Записи.Сумма
		|			КОНЕЦ), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ДополнительныеРасходы КАК Записи
		|ГДЕ
		|	Записи.Регистратор = &Документ");
	Запрос.УстановитьПараметр("Документ", Документ);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;
