#Область Документы

// Новый документ с реквизитами по умолчанию, организацией и складом сценария.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  ИмяДокумента - Строка    - имя объекта метаданных
//
// Возвращаемое значение:
//  ДокументОбъект - незаписанный документ
//
Функция НовыйДокумент(Контекст, ИмяДокумента)

	Док = Документы[ИмяДокумента].СоздатьДокумент();
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(Док);
	Док.Дата = СледующаяДата(Контекст);

	Реквизиты = Док.Метаданные().Реквизиты;
	Если Реквизиты.Найти("Организация") <> Неопределено Тогда
		Док.Организация = Контекст.Организация;
	КонецЕсли;
	Если Реквизиты.Найти("МестоХранения") <> Неопределено Тогда
		Док.МестоХранения = Контекст.Склад;
	КонецЕсли;
	Если Реквизиты.Найти("Комментарий") <> Неопределено Тогда
		Док.Комментарий = ПометкаТеста();
	КонецЕсли;

	Возврат Док;

КонецФункции

// Проверка заполнения, запись с проведением и контроль результата. Ошибка проведения
// приходит исключением платформы, сообщения из ОбработкаПроведения добавляет ВыполнитьСценарий.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый документ
//
Процедура Провести(Док)

	Если Не Док.ПроверитьЗаполнение() Тогда
		ВызватьИсключение ПредставлениеДокумента(Док) + ": не прошла проверка заполнения" + СообщенияПользователю();
	КонецЕсли;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Проверить(Док.Проведен, ПредставлениеДокумента(Док) + ": записан, но не проведён");

КонецПроцедуры

// Проверка заполнения и запись документа, у которого проведение запрещено.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый документ
//
Процедура Записать(Док)

	Если Не Док.ПроверитьЗаполнение() Тогда
		ВызватьИсключение ПредставлениеДокумента(Док) + ": не прошла проверка заполнения" + СообщенияПользователю();
	КонецЕсли;
	Док.Записать();

КонецПроцедуры

Функция ПредставлениеДокумента(Док)

	Представление = Док.Метаданные().Имя;
	Если ЗначениеЗаполнено(Док.Номер) Тогда
		Представление = Представление + " № " + СокрЛП(Док.Номер);
	КонецЕсли;
	Возврат Представление;

КонецФункции

// Строка товарной табличной части: заполняются те колонки, которые у части есть.
//
// Параметры:
//  Контекст     - Структура      - см. НовыйКонтекст
//  Док          - ДокументОбъект - заполняемый документ
//  ИмяТЧ        - Строка         - имя табличной части
//  Номенклатура - СправочникСсылка.Номенклатура
//  Количество   - Число
//  Цена         - Число - 0, если у части нет цены
//
Процедура ДобавитьСтрокуТоваров(Контекст, Док, ИмяТЧ, Номенклатура, Количество, Цена)

	Колонки = Док.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты;
	Строка = Док[ИмяТЧ].Добавить();
	Сумма = Количество * Цена;

	ЗаполнитьКолонку(Строка, Колонки, "КодСтроки", Док[ИмяТЧ].Количество());
	ЗаполнитьКолонку(Строка, Колонки, "Номенклатура", Номенклатура);
	ЗаполнитьКолонку(Строка, Колонки, "Упаковка", Контекст.Единица);
	ЗаполнитьКолонку(Строка, Колонки, "КоличествоУпаковок", Количество);
	ЗаполнитьКолонку(Строка, Колонки, "Количество", Количество);
	ЗаполнитьКолонку(Строка, Колонки, "Цена", Цена);
	ЗаполнитьКолонку(Строка, Колонки, "Сумма", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "СуммаСНДС", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "СтавкаНДС", Контекст.СтавкаНДС);
	ЗаполнитьКолонку(Строка, Колонки, "СуммаНДС", 0);

КонецПроцедуры

Процедура ЗаполнитьКолонку(Строка, Колонки, ИмяКолонки, Значение)

	Если Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
		Строка[ИмяКолонки] = Значение;
	КонецЕсли;

КонецПроцедуры

// Строка оснований платёжного документа: по ней закрывается долг по документу расчётов.
//
// Параметры:
//  Док       - ДокументОбъект - заполняемый документ
//  Основание - ДокументСсылка - документ расчётов
//  Сумма     - Число - сумма
//
Процедура ДобавитьОснование(Док, Основание, Сумма)

	Строка = Док.ТЧОснования.Добавить();
	Строка.Основание = Основание;
	Строка.Сумма = Сумма;

КонецПроцедуры

// Сырьё выпуска по технологической карте продукции: расход на единицу умножается на выпуск.
//
// Параметры:
//  Контекст          - Структура - см. НовыйКонтекст
//  Выпуск            - ДокументОбъект.ВыпускПродукции - заполняемый выпуск
//  КоличествоВыпуска - Число - сколько продукции выпускается
//
Процедура ЗаполнитьСырьеПоТехкарте(Контекст, Выпуск, КоличествоВыпуска)

	Для Каждого СтрокаКарты Из Выпуск.Номенклатура.ТехнологическаяКарта Цикл
		ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧТовары", СтрокаКарты.Номенклатура,
			СтрокаКарты.Количество * КоличествоВыпуска, 0);
	КонецЦикла;
	Проверить(Выпуск.ТЧТовары.Количество() > 0, "у продукции нет технологической карты");

КонецПроцедуры

// Проведённое поступление товаров от контрагента сценария.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Номенклатура - СправочникСсылка.Номенклатура - позиция номенклатуры
//  Количество   - Число - количество в единицах
//  Цена         - Число - цена; 0, если у части нет цены
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеТоваровУслуг - проведённое поступление
//
Функция ДокументЗакупки(Контекст, Номенклатура, Количество, Цена)

	Док = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПоставщика;
	Док.ЦенаВключаетНДС = Истина;
	Док.Валюта = Контекст.Валюта;
	Док.КурсВалюты = 1;
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Номенклатура, Количество, Цена);
	Провести(Док);
	Возврат Док.Ссылка;

КонецФункции

