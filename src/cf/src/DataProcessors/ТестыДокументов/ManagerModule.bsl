// Сценарии ревью техдолга Codex - отдельная ветка диспетчера: СценарийПоИмени упирается в длину метода.
//
// Параметры:
//  Имя      - Строка - имя сценария, см. ИменаСценариевТехдолгаРевью.
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТехдолгаРевьюПоИмени(Имя, Контекст)

	Вид = Сред(Имя, СтрДлина(ПрефиксСценариевТехдолгаРевью()) + 1);
	Если Вид = "ПоступлениеДоАвтовыпуска" Тогда
		Возврат СценарийТехдолгРевьюПоступлениеДоАвтовыпуска(Контекст);
	КонецЕсли;
	Если Вид = "ОбнуленныйРасход" Тогда
		Возврат СценарийТехдолгРевьюОбнуленныйРасход(Контекст);
	КонецЕсли;
	Если Вид = "СтадииБезИстории" Тогда
		Возврат СценарийТехдолгРевьюСтадииБезИстории(Контекст);
	КонецЕсли;
	Если Вид = "ПраваРолей" Тогда
		Возврат СценарийТехдолгРевьюПраваРолей();
	КонецЕсли;
	ВызватьИсключение "Сценарий " + Имя + " не описан в СценарийТехдолгаРевьюПоИмени";

КонецФункции

// T12: поступление из переработки по заказу на производство датой раньше реализации того же заказа с автовыпуском той
// же продукции действительно не проводится, в сообщениях - текст запрета по дате. Текст запрета и признак «выпуск
// изменён» по отдельности проверяет сценарий АвтовыпускПриОтгрузке; здесь - отказ самого проведения. Отказ портит
// транзакцию сценария, поэтому он - последний шаг.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТехдолгРевьюПоступлениеДоАвтовыпуска(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Данные = ДанныеАвтовыпускаСценария(Контекст);
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	Реализация = РеализацияАвтовыпуска(Контекст, Данные.Заказ);
	// BSLLS:MagicNumber-off - P1 6 из 10, как первая отгрузка сценария АвтовыпускПриОтгрузке; автовыпуск на секунду
	// раньше реализации, поступление - на две.
	УстановитьКоличествоСтроки(Реализация.ТЧТовары[1], 6);
	Провести(Реализация);
	ЕдинственныйАвтовыпуск(Реализация.Ссылка, "T12: реализация с автовыпуском P1");

	Ссылка = Документы.ПоступлениеИзПереработки.ПолучитьСсылку();
	Поступление = НовыйДокумент(Контекст, "ПоступлениеИзПереработки");
	Поступление.УстановитьСсылкуНового(Ссылка);
	Поступление.Дата = Реализация.Дата - 2;
	// BSLLS:MagicNumber-on
	Поступление.Основание = Данные.Заказ;
	Поступление.Контрагент = Контекст.Контрагент;
	СтрокаПродукции = Поступление.ТЧГотоваяПродукция.Добавить();
	СтрокаПродукции.КодСтроки = 1;
	СтрокаПродукции.Номенклатура = Данные.P1;
	СтрокаПродукции.КоличествоУпаковок = 1;
	СтрокаПродукции.Количество = 1;
	Продукция = Поступление.ТЧГотоваяПродукция.Выгрузить(, "Номенклатура, Характеристика");
	Ожидаемый = ПроизводственныеЗаказы.ТекстЗапретаПорядкаВыпускаИОтгрузки(Ссылка, Данные.Заказ,
		Новый МоментВремени(Поступление.Дата, Ссылка), Продукция);
	Проверить(ЗначениеЗаполнено(Ожидаемый), "T12: у поступления раньше реализации с автовыпуском есть текст запрета");
	// Последний шаг - настоящий отказ проведения.
	ПроверитьОтказПроведенияСТекстом(Поступление, Ожидаемый, "T12: поступление из переработки раньше автовыпуска");

	Возврат РезультатСценария("T12: поступление из переработки по заказу датой раньше реализации с автовыпуском той же "
		+ "продукции не проводится, в сообщениях - текст запрета по дате");

КонецФункции

// T13: материал заказа с положительной нормой 0,000000125 на единицу продукции, расход которого на отгружаемую единицу
// после округления до разрядности количества равен нулю: расчёт автовыпуска возвращает ошибку с материалом, продукцией
// и количеством и не берёт продукцию в выпуск, проведение реализации отклоняется с этой ошибкой - автовыпуск не
// пишется. Отказ портит транзакцию сценария, поэтому он - последний шаг.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТехдолгРевьюОбнуленныйРасход(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	Материал = НоваяНоменклатура(Контекст, "сырьё с малой нормой", Перечисления.ТипыНоменклатуры.Сырье);
	Продукция = НоваяНоменклатура(Контекст, "продукция с малой нормой", Перечисления.ТипыНоменклатуры.Продукция);
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	// BSLLS:MagicNumber-off - продукция 8 с нормой 0,000000125: материал заказа 0,000001 (разрядность количества),
	// норма автовыпуска 0,000001 / 8; отгрузка 1 - расход 0,000000125 округляется до нуля.
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Продукция, 8, Контекст.Числа.ЦенаПродажи);
	СтрокаМатериала = ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Материал, 0.000000125);
	ПроверитьРавенство(0.000001, СтрокаМатериала.Количество, "T13: материал заказа на 8 продукции");
	// BSLLS:MagicNumber-on
	Провести(Заказ);
	Реализация = РеализацияАвтовыпуска(Контекст, Заказ.Ссылка);
	Реализация.ТЧТовары.Удалить(0);
	УстановитьКоличествоСтроки(Реализация.ТЧТовары[0], 1);

	Расчет = Производство.ДанныеАвтовыпуска(Реализация);
	Проверить(Расчет.Активен, "T13: автовыпуск реализации по заказу на производство активен");
	Ожидаемый = СтрШаблон(Производство.ТекстОбнуленногоРасхода(), Материал, Продукция, 1);
	ПроверитьРавенство(1, Расчет.Ошибки.Количество(), "T13: ошибок расчёта автовыпуска");
	Если Расчет.Ошибки.Количество() > 0 Тогда
		ПроверитьРавенство(Ожидаемый, Расчет.Ошибки[0], "T13: ошибка расчёта - обнулённый расход");
	КонецЕсли;
	ПроверитьРавенство(0, Расчет.Продукция.Количество(), "T13: продукция с обнулённым расходом не выпускается");
	// Последний шаг - настоящий отказ проведения.
	ПроверитьОтказПроведенияСТекстом(Реализация, Ожидаемый, "T13: реализация с обнулённым расходом автовыпуска");

	Возврат РезультатСценария("T13: положительная норма материала, расход которой на отгрузку округляется до нуля, - "
		+ "ошибка расчёта автовыпуска с материалом и продукцией, продукция не выпускается, проведение реализации "
		+ "отклоняется этой ошибкой");

КонецФункции

// T28: обработчик обновления ЗаполнитьСтадииЗаказовБезИстории на данных - проведённому заказу на производство с удалённой
// историей статусов пишет запись стадии с индикатором; повторный запуск записей не добавляет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТехдолгРевьюСтадииБезИстории(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Заказ = ЗаказНаПроизводствоСтадии(Контекст, Контекст.Числа.КоличествоВыпуска);
	Провести(Заказ);
	Проверить(ЧислоЗаписейИстории(Заказ.Ссылка) > 0, "T28: проведение заказа на производство пишет историю");
	Набор = РегистрыСведений.ИсторияЗаказовПокупателейПоСтатусам.СоздатьНаборЗаписей();
	Набор.Отбор.ЗаказПокупателя.Установить(Заказ.Ссылка);
	Набор.Записать();
	ПроверитьРавенство(0, ЧислоЗаписейИстории(Заказ.Ссылка), "T28: история заказа удалена");

	ОбновлениеПрограммыОбработчики.ЗаполнитьСтадииЗаказовБезИстории();
	Записей = ЧислоЗаписейИстории(Заказ.Ссылка);
	ПроверитьРавенство(1, Записей, "T28: обработчик пишет заказу без истории одну запись");
	Стадия = ПроизводственныеЗаказы.ДанныеСтадии(Заказ.Ссылка);
	Проверить(Стадия <> Неопределено И Не ПустаяСтрока(Стадия.Индикатор),
		"T28: запись обработчика - с индикатором стадии");

	ОбновлениеПрограммыОбработчики.ЗаполнитьСтадииЗаказовБезИстории();
	ПроверитьРавенство(Записей, ЧислоЗаписейИстории(Заказ.Ссылка), "T28: повторный запуск обработчика записей не добавляет");

	Возврат РезультатСценария("T28: обработчик стадий заказов без истории пишет проведённому заказу на производство "
		+ "без истории запись с индикатором, повторный запуск её не дублирует");

КонецФункции

// T7, T8: права ролей по метаданным - роль ЛичныйКабинет читает, но не изменяет регистры взаиморасчётов, продаж, товаров
// в наличии, заказов поставщикам и историю статусов заказов; ОператорПроизводства читает историю статусов, но не
// изменяет её (стадию пишет механизм в привилегированном режиме).
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТехдолгРевьюПраваРолей()

	Чтение = "Чтение";
	Изменение = "Изменение";
	История = Метаданные.РегистрыСведений.ИсторияЗаказовПокупателейПоСтатусам;
	Регистры = Новый Массив;
	// BSLLS:YoLetterUsage-off - имена регистров
	Регистры.Добавить(Метаданные.РегистрыНакопления.ВзаиморасчётыСПокупателями);
	Регистры.Добавить(Метаданные.РегистрыНакопления.ВзаиморасчётыСКонтрагентамиПрочие);
	// BSLLS:YoLetterUsage-on
	Регистры.Добавить(Метаданные.РегистрыНакопления.Продажи);
	Регистры.Добавить(Метаданные.РегистрыНакопления.ТоварыВНаличии);
	Регистры.Добавить(Метаданные.РегистрыНакопления.ЗаказыПоставщикам);
	Регистры.Добавить(История);
	Кабинет = Метаданные.Роли.ЛичныйКабинет;
	Для Каждого Регистр Из Регистры Цикл
		ИмяРегистра = Регистр.ПолноеИмя();
		Проверить(ПравоДоступа(Чтение, Регистр, Кабинет), "T7: роль ЛичныйКабинет читает " + ИмяРегистра);
		Проверить(Не ПравоДоступа(Изменение, Регистр, Кабинет), "T7: роль ЛичныйКабинет не изменяет " + ИмяРегистра);
	КонецЦикла;
	Оператор = Метаданные.Роли.ОператорПроизводства;
	Проверить(ПравоДоступа(Чтение, История, Оператор), "T8: роль ОператорПроизводства читает историю статусов заказов");
	Проверить(Не ПравоДоступа(Изменение, История, Оператор),
		"T8: роль ОператорПроизводства не изменяет историю статусов заказов");

	Возврат РезультатСценария("T7, T8: ЛичныйКабинет только читает взаиморасчёты, продажи, товары в наличии, заказы "
		+ "поставщикам и историю статусов заказов; ОператорПроизводства только читает историю статусов");

КонецФункции

// Настоящий отказ проведения документа с ожидаемым текстом в сообщениях или ошибке. После исключения в записи
// транзакция сценария годится только для отката: шаг вызывается последним, к базе после него не обращаются.
//
// Параметры:
//  Документ  - ДокументОбъект - непроведённый документ, проведение которого должно быть отклонено.
//  Ожидаемый - Строка - текст запрета; переводы строк в сообщениях заменены пробелами.
//  Описание  - Строка - шаг сценария.
//
Процедура ПроверитьОтказПроведенияСТекстом(Документ, Ожидаемый, Описание)

	ПолучитьСообщенияПользователю(Истина);
	Проведен = Истина;
	ТекстОшибки = "";
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Проведен = Ложь;
		ТекстОшибки = ОшибкаОднойСтрокой(ИнформацияОбОшибке());
	КонецПопытки;
	Проверить(Не Проведен, Описание + ": документ не проводится");
	Сообщения = СообщенияПользователю();
	Проверить(СтрНайти(Сообщения + ТекстОшибки, СтрЗаменить(Ожидаемый, Символы.ПС, " ")) > 0,
		Описание + ": в отказе ожидаемый текст:" + Сообщения + " | ошибка: " + ТекстОшибки);

КонецПроцедуры

#КонецОбласти

#Область ПроизводительностьЗапросов

// Волна производительности 2.0.16.83 (docs/plans/performance-vt.md, раздел 5): отбор перенесён в параметры виртуальных
// таблиц, две ошибки смысла исправлены. (а) «Формирование заказов поставщику»: заказ 10, два поступления по 3 -
// «Заказано» 4, а не 8 (остаток заказа больше не множится на число поступлений); (б) кредитный контроль без
// контрагента берёт в долг только реализации и налоговые накладные; (в) автоподбор номенклатуры с заданным видом
// цены - цена этого вида одной строкой, с пустым видом цены - без цены.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПроизводительностьЗапросов(Контекст)

	Заказано = ПроверитьЗаказаноФормированияЗаказов(Контекст);
	Долг = ПроверитьДолгКредитногоКонтроля(Контекст);
	ПроверитьЦенуАвтоподбора(Контекст);

	Текст = "формирование заказов: заказано " + СтрокаЧисла(Заказано)
		+ "; кредитный контроль без контрагента: долг " + СтрокаЧисла(Долг) + " только по реализации"
		+ "; автоподбор: цена вида одной строкой, без вида цены - без цены";
	Возврат РезультатСценария(Текст);

КонецФункции

// (а) Заказ поставщику на 10, два поступления по 3 по заказу: «Заказано» в данных формирования заказов - 4.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Число - «Заказано» по товару
//
Функция ПроверитьЗаказаноФормированияЗаказов(Контекст)

	// BSLLS:MagicNumber-off - заказ 10, два поступления по 3.
	КоличествоЗаказа = 10;
	КоличествоПоступления = 3;
	ЧислоПоступлений = 2;
	// BSLLS:MagicNumber-on
	Товар = Контекст.Товар;
	ЗаказПоставщику = НовыйЗаказПоставщикуПотребности(Контекст, Неопределено);
	ДобавитьСтрокуЗакупкиПотребности(Контекст, ЗаказПоставщику, Товар, КоличествоЗаказа, Неопределено);
	Провести(ЗаказПоставщику);
	Поступление1 = НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику.Ссылка);
	УстановитьКоличествоСтроки(Поступление1.ТЧТовары[0], КоличествоПоступления);
	Провести(Поступление1);
	Поступление2 = НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику.Ссылка);
	УстановитьКоличествоСтроки(Поступление2.ТЧТовары[0], КоличествоПоступления);
	Провести(Поступление2);

	Номенклатура = Новый Массив;
	Номенклатура.Добавить(Товар);
	Данные = Обработки.ФормированиеЗаказовПоставщику.ОстаткиИОборотыТоваров(НачалоДня(Контекст.Дата),
		КонецДня(ТекущаяДатаСеанса()), Номенклатура);
	Строки = Данные.НайтиСтроки(Новый Структура("Номенклатура", Товар));
	ПроверитьРавенство(1, Строки.Количество(), "строк товара в данных формирования заказов");
	ПроверитьРавенство(КоличествоЗаказа - ЧислоПоступлений * КоличествоПоступления, Строки[0].Заказано,
		"заказано после двух поступлений по заказу");
	Возврат Строки[0].Заказано;

КонецФункции

// (б) Реализация с долгом и возврат оплаты клиенту без оснований (положительный остаток расчётов по самому ордеру):
// просроченная задолженность без отбора по контрагенту (регламентное ЗапретОтгрузок) - долг только по реализации.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Число - долг контрагента сценария в кредитном контроле
//
Функция ПроверитьДолгКредитногоКонтроля(Контекст)

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	Реализация = ДокументРеализации(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);
	СуммаПродажи = Числа.КоличествоПродажи * Числа.ЦенаПродажи;
	ПроверитьДолгПокупателя(Реализация, СуммаПродажи, "долг покупателя по реализации");

	ВозвратОплаты = НовыйДокумент(Контекст, "РасходныйКассовыйОрдер");
	ВозвратОплаты.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту;
	ВозвратОплаты.Контрагент = Контекст.Контрагент;
	ВозвратОплаты.Договор = Контекст.ДоговорПокупателя;
	ВозвратОплаты.Касса = Контекст.Касса;
	ВозвратОплаты.ТипОплаты = Справочники.TypesDePayment.Cash;
	ВозвратОплаты.СтатьяДДС = СтатьяДДС(Контекст, ВозвратОплаты.ХозяйственнаяОперация);
	ВозвратОплаты.Сумма = Числа.ЦенаЗакупки;
	Провести(ВозвратОплаты);
	Проверить(ОстатокВзаиморасчетов("ВзаиморасчётыСПокупателями", ВозвратОплаты.Ссылка) > 0,
		"возврат оплаты без оснований даёт положительный остаток расчётов по ордеру");

	БезОтбораПоПросрочке = Истина;
	// BSLLS:YoLetterUsage-off - имя регистра в метаданных.
	Задолженность = РегистрыНакопления.ВзаиморасчётыСПокупателями.ПолучитьПросроченнуюЗадолженность(Неопределено, 0,
		БезОтбораПоПросрочке);
	// BSLLS:YoLetterUsage-on
	Долг = 0;
	Для Каждого СтрокаДолга Из Задолженность.НайтиСтроки(Новый Структура("Контрагент", Контекст.Контрагент)) Цикл
		Долг = Долг + СтрокаДолга.Долг;
	КонецЦикла;
	ПроверитьРавенство(СуммаПродажи, Долг, "долг кредитного контроля без контрагента - только реализации");
	Возврат Долг;

КонецФункции

// (в) Автоподбор номенклатуры (подмена в ОбработкаПолученияДанныхВыбора): у товара цены двух видов; с заданным видом
// цены - одна строка с ценой этого вида, с пустым - одна строка без цены.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьЦенуАвтоподбора(Контекст)

	Ключ = Строка(Новый УникальныйИдентификатор);
	Товар = НоваяНоменклатура(Контекст, "автоподбор " + Ключ, Перечисления.ТипыНоменклатуры.Товар);
	Числа = Контекст.Числа;
	Цены = Новый ТаблицаЗначений;
	Цены.Колонки.Добавить("ВидЦены");
	Цены.Колонки.Добавить("Цена");
	СтрокаЦены = Цены.Добавить();
	СтрокаЦены.ВидЦены = Справочники.ВидыЦен.Розничная;
	СтрокаЦены.Цена = Числа.ЦенаПродажи;
	СтрокаЦены = Цены.Добавить();
	СтрокаЦены.ВидЦены = Справочники.ВидыЦен.Закупочная;
	СтрокаЦены.Цена = Числа.ЦенаЗакупки;
	Справочники.Номенклатура.ЗаписатьЦеныКарточки(Товар, Цены, Документы.УстановкаЦенНоменклатурыВручную.ПустаяСсылка());

	ПроверитьСтрокуАвтоподбора(Контекст, Товар, Ключ, Справочники.ВидыЦен.Розничная, Числа.ЦенаПродажи,
		"автоподбор с розничным видом цены");
	ПроверитьСтрокуАвтоподбора(Контекст, Товар, Ключ, Справочники.ВидыЦен.ПустаяСсылка(), 0,
		"автоподбор без вида цены");

КонецПроцедуры

// Одна строка автоподбора товара с ожидаемой ценой.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Товар    - СправочникСсылка.Номенклатура - товар
//  Ключ     - Строка - строка поиска, уникальная для товара
//  ВидЦены  - СправочникСсылка.ВидыЦен - вид цены автоподбора, пустой - без цены
//  Цена     - Число - ожидаемая цена
//  Описание - Строка - что проверялось
//
Процедура ПроверитьСтрокуАвтоподбора(Контекст, Товар, Ключ, ВидЦены, Цена, Описание)

	ПараметрыАвтоподбора = Новый Структура;
	ПараметрыАвтоподбора.Вставить("ВидЦены", ВидЦены);
	ПараметрыАвтоподбора.Вставить("ИсключитьХарактеристикиДляВнутреннегоИспользования", Истина);
	Отбор = Новый Структура;
	Отбор.Вставить("МестоХранения", Контекст.Склад);
	Отбор.Вставить("ДатаДокумента", ТекущаяДатаСеанса());
	Отбор.Вставить("ПараметрыАвтоподбора", ПараметрыАвтоподбора);
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("СтрокаПоиска", Ключ);
	ПараметрыВыбора.Вставить("Отбор", Отбор);
	ПараметрыВыбора.Вставить("ПодменаАвтоподбора", Истина);
	ДанныеВыбора = Справочники.Номенклатура.ПолучитьДанныеВыбора(ПараметрыВыбора);

	Строки = Новый Массив;
	Для Каждого Элемент Из ДанныеВыбора Цикл
		Если Элемент.Значение.Ссылка = Товар Тогда
			Строки.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	ПроверитьРавенство(1, Строки.Количество(), Описание + ": строк товара");
	ПроверитьРавенство(Цена, Строки[0].Цена, Описание + ": цена");

КонецПроцедуры

// Выпадающий список колонки товара при входе в поле без истории выбора (2.0.16.90): автоподбор с пустой строкой
// отдаёт последние созданные позиции, а не пустой список; группы и помеченные на удаление в умолчание не попадают.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАвтоподборПоУмолчанию(Контекст)

	Ключ = Строка(Новый УникальныйИдентификатор);
	Первый = НоваяНоменклатура(Контекст, "умолчание 1 " + Ключ, Перечисления.ТипыНоменклатуры.Товар);
	Второй = НоваяНоменклатура(Контекст, "умолчание 2 " + Ключ, Перечисления.ТипыНоменклатуры.Товар);
	Помеченный = НоваяНоменклатура(Контекст, "умолчание помеченный " + Ключ, Перечисления.ТипыНоменклатуры.Товар);
	ОбъектПомеченного = Помеченный.ПолучитьОбъект();
	ОбъектПомеченного.УстановитьПометкуУдаления(Истина);
	Группа = Справочники.Номенклатура.СоздатьГруппу();
	Группа.Наименование = ПометкаТеста() + ": умолчание группа " + Ключ;
	Группа.Записать();

	ПараметрыАвтоподбора = Новый Структура;
	ПараметрыАвтоподбора.Вставить("ВидЦены", Справочники.ВидыЦен.ПустаяСсылка());
	ПараметрыАвтоподбора.Вставить("ИсключитьХарактеристикиДляВнутреннегоИспользования", Истина);
	Отбор = Новый Структура;
	Отбор.Вставить("МестоХранения", Контекст.Склад);
	Отбор.Вставить("ДатаДокумента", ТекущаяДатаСеанса());
	Отбор.Вставить("ПараметрыАвтоподбора", ПараметрыАвтоподбора);
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("СтрокаПоиска", "");
	ПараметрыВыбора.Вставить("Отбор", Отбор);
	ПараметрыВыбора.Вставить("ПодменаАвтоподбора", Истина);
	ДанныеВыбора = Справочники.Номенклатура.ПолучитьДанныеВыбора(ПараметрыВыбора);

	Ссылки = Новый Массив;
	Для Каждого Элемент Из ДанныеВыбора Цикл
		Ссылки.Добавить(Элемент.Значение.Ссылка);
	КонецЦикла;
	Проверить(Ссылки.Найти(Первый) <> Неопределено, "умолчание: последний созданный товар в списке");
	Проверить(Ссылки.Найти(Второй) <> Неопределено, "умолчание: предпоследний созданный товар в списке");
	Проверить(Ссылки.Найти(Помеченный) = Неопределено, "умолчание: помеченный на удаление не предлагается");
	Проверить(Ссылки.Найти(Группа.Ссылка) = Неопределено, "умолчание: группа не предлагается");

	Текст = "пустая строка автоподбора - последние созданные: " + СтрокаЧисла(Ссылки.Количество())
		+ " позиций, без групп и помеченных";
	Возврат РезультатСценария(Текст);

КонецФункции

#КонецОбласти

#Область ДемоНабор

// Демо-набор (E11): тот же генератор, что заполняет базу для приёмки и скриншотов (scripts/fixtures.sh --demo), в
// транзакции прогона с суффиксом наименований. Сверяются стадии и индикаторы заказов на производство по схемам,
// статусы коммерческих предложений, заказов-продаж и договоров, автовыпуски, лиды и заявки на поиск товара.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст (не используется: у набора свои справочники)
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДемоНабор(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Начало = Обработки.ТестовыеДанные.НачалоДемоНабора();
	Если Начало = Неопределено Тогда
		Возврат РезультатСценария("с начала дня прошло слишком мало времени для дат набора", Истина);
	КонецЕсли;

	Начат = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Кейсы = Обработки.ТестовыеДанные.ЗаполнитьДемоНабор(Начало, " (тест)");
	// BSLLS:MagicNumber-off - миллисекунды в секунды.
	Длительность = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начат) / 1000);
	// BSLLS:MagicNumber-on

	ПроверитьСтадииДемоНабора(Кейсы);
	ПроверитьТорговлюДемоНабора(Кейсы);
	ПроверитьРавенство(1, ЧислоАвтовыпусков(Кейсы["P1"].Реализация), "P1: один автовыпуск реализации");
	ПроверитьРавенство(1, ЧислоАвтовыпусков(Кейсы["P2"].Реализация), "P2: один автовыпуск реализации");
	ПроверитьРавенство(0, ЧислоАвтовыпусков(Кейсы["P9"].Реализация), "P9: выпущенного хватает, автовыпуска нет");
	// Демо-набор - единственное место, где признак автосоздания получают образцы для смока и печати: автовыпуски
	// здесь делает настоящий механизм (константа включается в ЗаполнитьДемоНабор), а не прямая запись документа.
	Проверить(Производство.ЭтоАвтовыпуск(ЕдинственныйАвтовыпуск(Кейсы["P1"].Реализация, "P1")),
		"P1: у автовыпуска демо-набора есть признак автосоздания");
	Выпуск = Кейсы["P10"].Выпуск;
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выпуск, "Проведен"), "P10: мультивыпуск проведён");
	Проверить(Не Производство.ЭтоАвтовыпуск(Выпуск), "P10: мультивыпуск без заказа автовыпуском не считается");
	// BSLLS:MagicNumber-off - две позиции мультивыпуска, пять лидов и пять заявок.
	ПроверитьРавенство(2, Выпуск.ТЧГотоваяПродукция.Количество(), "P10: две позиции продукции");
	ПроверитьРавенство(5, ЧислоЗаписейНабора("РегистрСведений.Лиды", "ПолноеИмя", Кейсы["L"].Имена), "лиды набора");
	ПроверитьРавенство(5, ЧислоЗаписейНабора("Документ.ЗаявкаНаПоискТовара", "Ссылка", Кейсы["Z"].Заявки),
		"заявки на поиск товара набора");
	// BSLLS:MagicNumber-on

	Текст = "кейсов " + СтрокаЧисла(Кейсы.Количество()) + " за " + СтрокаЧисла(Длительность)
		+ " с: стадии P1-P9 по схемам производства, статусы КП, заказов-продаж и договоров, автовыпуски, лиды и заявки";
	Возврат РезультатСценария(Текст);

КонецФункции

// Стадии и индикаторы заказов на производство P1-P9 (план демо-набора E11, §3).
//
// Параметры:
//  Кейсы - Соответствие - см. Обработки.ТестовыеДанные.ЗаполнитьДемоНабор
//
Процедура ПроверитьСтадииДемоНабора(Кейсы)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	ПроверитьСтадиюЗаказа(Кейсы["P1"].Заказ, Стадии.Выполнен, "●●●●●", "P1 под заказ без своего остатка");
	ПроверитьСтадиюЗаказа(Кейсы["P2"].Заказ, Стадии.ОжидаетОплаты, "●●●●◐", "P2 из своего остатка");
	ПроверитьСтадиюЗаказа(Кейсы["P3"].Заказ, Стадии.ОжидаетОтгрузки, "●●●○○", "P3 ручной выпуск по заказу");
	ПроверитьСтадиюЗаказа(Кейсы["P4"].Заказ, Стадии.ВПроизводстве, "●●○○○", "P4 состав в заказе");
	ПроверитьСтадиюЗаказа(Кейсы["P5"].Заказ, Стадии.ВосполнениеПотребности, "●◐○○○", "P5 закупка пришла частично");
	ПроверитьСтадиюЗаказа(Кейсы["P6"].Заказ, Стадии.ЗаказПоставщику, "○○○○○", "P6 материалы не заказаны");
	ПроверитьСтадиюЗаказа(Кейсы["P7"].Заказ, Стадии.ФормируетсяПотребность, "○○○○◐", "P7 закупаемый товар с авансом");
	ПроверитьСтадиюЗаказа(Кейсы["P8"].Заказ, Стадии.Черновик, "○○○○○", "P8 черновик");
	ПроверитьСтадиюЗаказа(Кейсы["P9"].Заказ, Стадии.ОжидаетОтгрузки, "●●●◐○", "P9 частичная отгрузка");

КонецПроцедуры

// Статусы коммерческих предложений, заказов-продаж и договоров набора.
//
// Параметры:
//  Кейсы - Соответствие - см. Обработки.ТестовыеДанные.ЗаполнитьДемоНабор
//
Процедура ПроверитьТорговлюДемоНабора(Кейсы)

	ИмяСтатуса = "Статус";
	СтатусыКП = Перечисления.СтатусыКоммерческихПредложений;
	ПроверитьРавенство(СтатусыКП.Выигран, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейсы["P1"].Предложение, ИмяСтатуса),
		"P1: предложение выиграно заказом");
	Предложения = Кейсы["T"];
	Для Каждого ЗначениеСтатуса Из СтрРазделить("Черновик,Отправлен,Доставлен,Проигран", ",") Цикл
		Фактический = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Предложения[ЗначениеСтатуса], ИмяСтатуса);
		ПроверитьРавенство(СтатусыКП[ЗначениеСтатуса], Фактический, "статус коммерческого предложения " + ЗначениеСтатуса);
	КонецЦикла;

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	ПроверитьСтатусПродажи(Кейсы["S1"].Заказ, Стадии.Новый, "S1");
	ПроверитьСтатусПродажи(Кейсы["S2"].Заказ, Стадии.ВРаботе, "S2");
	ПроверитьСтатусПродажи(Кейсы["S3"].Заказ, Стадии.Собран, "S3");
	ПроверитьСтатусПродажи(Кейсы["S4"].Заказ, Стадии.ВПроизводстве, "S4");
	ПроверитьСтатусПродажи(Кейсы["S5"].Заказ, Стадии.Отгружен, "S5");
	ПроверитьСтатусПродажи(Кейсы["S6"].Заказ, Стадии.ПереданСубподрядчику, "S6");
	// Поступление на основании передачи статус «Получен от субподрядчика» не ставит (TECHDEBT «Найдено в E11»).
	ПроверитьСтатусПродажи(Кейсы["S7"].Заказ, Стадии.ПереданСубподрядчику, "S7");

	СтатусыДоговоров = Перечисления.СтатусыДоговоровКонтрагентов;
	ПроверитьРавенство(СтатусыДоговоров.НеСогласован, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейсы["C"].НеСогласован, ИмяСтатуса),
		"договор «Не согласован»");
	ПроверитьРавенство(СтатусыДоговоров.Закрыт, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейсы["C"].Закрыт, ИмяСтатуса),
		"договор «Закрыт»");

КонецПроцедуры

// Число выпусков продукции, основание которых - реализация.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация
//
// Возвращаемое значение:
//  Число - автовыпусков реализации
//
Функция ЧислоАвтовыпусков(Реализация)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Выпуск.Ссылка) КАК Выпусков
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуск
	|ГДЕ
	|	Выпуск.Основание = &Реализация
	|	И НЕ Выпуск.ПометкаУдаления");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Выпусков;

КонецФункции

// Число записей таблицы, созданных прогоном: поле среди значений, которые вернул генератор.
//
// Параметры:
//  ИмяТаблицы - Строка - таблица запроса
//  ИмяПоля    - Строка - поле отбора
//  Значения   - Массив - значения поля, записанные прогоном
//
// Возвращаемое значение:
//  Число - записей прогона
//
Функция ЧислоЗаписейНабора(ИмяТаблицы, ИмяПоля, Значения)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Записей
	|ИЗ
	|	&ИмяТаблицы КАК Таблица
	|ГДЕ
	|	Таблица.&ИмяПоля В (&Значения)";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", ИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПоля", ИмяПоля);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Значения", Значения);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Записей;

КонецФункции

#КонецОбласти

#Область ДемоНаборПовтор

// Диспетчер сценариев демо-набора: держит СценарийПоИмени в лимите длины метода.
//
// Параметры:
//  Имя      - Строка - имя сценария
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДемо(Имя, Контекст)

	Если Имя = "ДемоНабор" Тогда
		Возврат СценарийДемоНабор(Контекст);
	ИначеЕсли Имя = "ДемоНаборПовтор" Тогда
		Возврат СценарийДемоНаборПовтор(Контекст);
	ИначеЕсли Имя = "ДемоНаборРабочаяБаза" Тогда
		Возврат СценарийДемоНаборРабочаяБаза(Контекст);
	ИначеЕсли Имя = "ДемоСтанки" Тогда
		Возврат СценарийДемоСтанки(Контекст);
	Иначе
		ВызватьИсключение "Неизвестный сценарий демо-набора: " + Имя;
	КонецЕсли;

КонецФункции

// Повторный запуск демо-набора (2.0.16.47): всё переиспользуется по ключам; удалённый документ кейса - «неполный» без
// дублей; кейс, удалённый целиком, создаётся заново; помеченный документ - «неполный»; старый набор (маркер без признака
// поколения) переиспользуется целиком; прерванный прогон (справочники без кейсов) доливается; P11 при чужой версии карты
// на завтра пропускается, не трогая её. Ключ каждого документа цепочки P1 - свой, а не скопированный из основания.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст (не используется: у набора свои справочники)
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДемоНаборПовтор(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Начало = Обработки.ТестовыеДанные.НачалоДемоНабора();
	Если Начало = Неопределено Тогда
		Возврат РезультатСценария("с начала дня прошло слишком мало времени для дат набора", Истина);
	КонецЕсли;

	// BSLLS:MagicNumber-off - 24 кейса ядра.
	Суффикс = " (повтор)";
	Ядро = "CORE";
	КодТехкарты = "P11";
	Первый = Обработки.ТестовыеДанные.ЗаполнитьДемоДанные(Начало, Суффикс, Ядро);
	ПроверитьРавенство(24, Первый.Итог.Создано, "первый прогон - все кейсы созданы: " + СтрСоединить(Первый.Итог.Строки, " | "));
	ПроверитьКлючиЦепочкиПервогоКейса(Первый.Кейсы["P1"], Суффикс);
	Позиций = ЧислоДемоНоменклатуры(Суффикс);

	Второй = Обработки.ТестовыеДанные.ЗаполнитьДемоДанные(Начало, Суффикс, Ядро);
	ПроверитьРавенство(0, Второй.Итог.Создано, "повтор ничего не создаёт");
	ПроверитьРавенство(24, Второй.Итог.Переиспользовано, "повтор - все кейсы переиспользованы");
	ПроверитьРавенство(Первый.Кейсы["P1"].Заказ, Второй.Кейсы["P1"].Заказ, "ссылки кейса - те же");
	ПроверитьРавенство(Первый.Кейсы["L"].Имена[2], Второй.Кейсы["L"].Имена[2], "лиды - те же");
	ПроверитьРавенство(Позиций, ЧислоДемоНоменклатуры(Суффикс), "номенклатура набора не задвоилась");

	// Удалён один документ кейса Z, помечен документ кейса T, удалены оба документа кейса C.
	Первый.Кейсы["Z"].Заявки[0].ПолучитьОбъект().Удалить();
	// Пометку КП ставит человек - при выключенной опции «Коммерческие предложения» ручная запись КП запрещена.
	ВключитьКоммерческиеПредложения();
	Первый.Кейсы["T"].Черновик.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
	Первый.Кейсы["C"].НеСогласован.ПолучитьОбъект().Удалить();
	Первый.Кейсы["C"].Закрыт.ПолучитьОбъект().Удалить();
	Третий = Обработки.ТестовыеДанные.ЗаполнитьДемоДанные(Начало, Суффикс, Ядро);
	ПроверитьРавенство(1, Третий.Итог.Создано, "создан только кейс C, удалённый целиком");
	Проверить(Третий.Кейсы["C"] <> Неопределено, "кейс C создан заново");
	ПроверитьРавенство(2, Третий.Итог.Неполных, "неполные - Z (удалён документ) и T (помечен документ)");
	ПроверитьРавенство(21, Третий.Итог.Переиспользовано, "остальные переиспользованы");
	ПроверитьРавенство(4, ЧислоЗаписейНабора("Документ.ЗаявкаНаПоискТовара", "Ссылка", Первый.Кейсы["Z"].Заявки),
		"неполный кейс Z не дополнен");

	// P11: версия набора удалена, на завтра - чужая версия Table; повтор её не трогает.
	КейсТехкарты = Первый.Кейсы[КодТехкарты];
	Техкарта = КейсТехкарты.Техкарта;
	Продукция = КейсТехкарты.Продукция;
	Техкарта.ПолучитьОбъект().Удалить();
	Состав = ТехнологическиеКарты.СоставТехкарт(Продукция, Начало);
	Чужая = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, НачалоДня(Начало) + 86400);
	ВерсияЧужой = Чужая.ВерсияДанных;
	Четвертый = Обработки.ТестовыеДанные.ЗаполнитьДемоДанные(Начало, Суффикс, Ядро);
	Проверить(Четвертый.Кейсы.Получить(КодТехкарты) = Неопределено, "P11 пропущен: на завтра уже есть версия карты");
	ПроверитьРавенство(ВерсияЧужой, Чужая.ПолучитьОбъект().ВерсияДанных, "чужая версия карты не изменена");

	// Старый набор: у маркера нет признака поколения - ядро переиспользуется целиком, кейсы не создаются.
	Маркер = Первый.Контекст.Участники.Atlas.Ссылка.ПолучитьОбъект();
	Маркер.Комментарий = "";
	Маркер.Записать();
	Пятый = Обработки.ТестовыеДанные.ЗаполнитьДемоДанные(Начало, Суффикс, Ядро);
	ПроверитьРавенство(0, Пятый.Итог.Создано, "старый набор - ничего не создано");
	Проверить(СтрНачинаетсяС(Пятый.Итог.Строки[0], "ПЕРЕИСПОЛЬЗОВАН;CORE;"), "старый набор - строка «ядро переиспользовано»");
	ПроверитьРавенство("", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Маркер.Ссылка, "Комментарий"),
		"признак поколения старому набору не пишется");

	// Прерванный прогон: справочники и признак есть, кейсов нет - повтор создаёт кейсы целиком.
	Прерванный = " (прерв)";
	Обработки.ТестовыеДанные.ЗаполнитьДемоДанные(Начало, Прерванный, "");
	Шестой = Обработки.ТестовыеДанные.ЗаполнитьДемоДанные(Начало, Прерванный, Ядро);
	ПроверитьРавенство(24, Шестой.Итог.Создано, "прерванный прогон долит целиком");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("повтор - 24 переиспользовано, 0 создано; удалённый документ и пометка - «неполный» без "
		+ "дублей; кейс, удалённый целиком, создан заново; P11 не пишет поверх чужой версии; старый набор - ядро целиком; "
		+ "прерванный прогон долит; ключи цепочки P1 свои");

КонецФункции

Процедура ПроверитьКлючиЦепочкиПервогоКейса(Кейс, Суффикс)

	Ключ = "Démo 2mzl #CORE-P1-%1" + Суффикс;
	Поле = "Комментарий";
	ПроверитьРавенство(СтрШаблон(Ключ, 1), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.Предложение, Поле), "ключ КП P1");
	// BSLLS:MagicNumber-off - номера документов цепочки P1.
	ПроверитьРавенство(СтрШаблон(Ключ, 2), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.Заказ, Поле),
		"ключ заказа P1 - свой, а не из КП");
	ПроверитьРавенство(СтрШаблон(Ключ, 5), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.Реализация, Поле),
		"ключ реализации P1 - свой, а не из заказа");
	// BSLLS:MagicNumber-on

КонецПроцедуры

Функция ЧислоДемоНоменклатуры(Суффикс)

	Запрос = Новый Запрос("ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник.Номенклатура КАК Т
		|ГДЕ
		|	Т.Артикул ПОДОБНО &Шаблон");
	Запрос.УстановитьПараметр("Шаблон", "DEMO-2MZL-%" + Суффикс);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

#КонецОбласти

#Область ДемоНаборРабочаяБаза

// Рабочие документы базы и кнопка демо-данных (2.0.16.47, с 2.0.16.84 - без отказа): рабочий документ - любой документ
// любого вида, проведённый или нет, кроме маркированных набором, образцами и тестами, созданных механизмом и техкарт
// демо-номенклатуры; вид без комментария - рабочий, кроме заявок набора; в тестовой базе виды без комментария не
// проверяются. При рабочем документе СоздатьДемоНабор не отказывает: справочники набора готовятся, в итоге - строка
// ИНФО с предупреждением, строки ОТКАЗ нет (блоки не запускаются - они проверяются сценариями ДемоНабор…).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДемоНаборРабочаяБаза(Контекст)

	ТестовыеДанные = Обработки.ТестовыеДанные;
	Расход = ДокументБезПроверок("ПрочиеРасходы", Контекст, "Обычный расход");
	Проверить(ТестовыеДанные.ЭтоРабочийДокумент(Расход, Ложь), "непроведённые прочие расходы - рабочий документ");
	Проверить(ТестовыеДанные.ЭтоРабочийДокумент(Расход, Истина), "и в тестовой базе");
	Корректировка = ДокументБезПроверок("КорректировкаРегистров", Контекст, "");
	Проверить(ТестовыеДанные.ЭтоРабочийДокумент(Корректировка, Ложь), "корректировка регистров - рабочий документ");
	Смена = ДокументБезПроверок("КассоваяСмена", Контекст, Неопределено);
	Проверить(ТестовыеДанные.ЭтоРабочийДокумент(Смена, Ложь), "вид без комментария - рабочий");
	Проверить(Не ТестовыеДанные.ЭтоРабочийДокумент(Смена, Истина), "в тестовой базе вид без комментария не проверяется");
	Демо = ДокументБезПроверок("РеализацияТоваровУслуг", Контекст, "Démo 2mzl #CORE-X-1 (отказ)");
	Проверить(Не ТестовыеДанные.ЭтоРабочийДокумент(Демо, Ложь), "документ с ключом набора - не рабочий");
	Образец = ДокументБезПроверок("РеализацияТоваровУслуг", Контекст, "Образец автотеста");
	Проверить(Не ТестовыеДанные.ЭтоРабочийДокумент(Образец, Ложь), "образец fixtures.sh - не рабочий");
	Выпуск = Документы.ВыпускПродукции.СоздатьДокумент();
	Выпуск.Дата = СледующаяДата(Контекст);
	Выпуск.СозданАвтоматически = Истина;
	Выпуск.Комментарий = "Автоматический выпуск при отгрузке";
	Выпуск.ОбменДанными.Загрузка = Истина;
	Выпуск.Записать();
	Проверить(Не ТестовыеДанные.ЭтоРабочийДокумент(Выпуск.Ссылка, Ложь), "автовыпуск - не рабочий");

	ДемоКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
	ДемоКонтрагент.Наименование = "Démo 2mzl - Riad Andalous (отказ)";
	ДемоКонтрагент.Записать();
	СтараяЗаявка = ЗаявкаБезПроверок(Контекст, ДемоКонтрагент.Ссылка, "Tapis berbère 3x4", "");
	Проверить(Не ТестовыеДанные.ЭтоРабочийДокумент(СтараяЗаявка, Ложь), "заявка старого набора - не рабочая");
	ЧужаяЗаявка = ЗаявкаБезПроверок(Контекст, ДемоКонтрагент.Ссылка, "Чужая заявка", "");
	Проверить(ТестовыеДанные.ЭтоРабочийДокумент(ЧужаяЗаявка, Ложь), "посторонняя заявка демо-клиента - рабочая");
	Заявка = ЗаявкаБезПроверок(Контекст, Контекст.Контрагент, "Lampe suspendue", "Démo 2mzl #CORE-Z-3 (отказ)");
	Проверить(Не ТестовыеДанные.ЭтоРабочийДокумент(Заявка, Ложь), "заявка с ключом набора в артикуле - не рабочая");

	Параметры = ТестовыеДанные.НовыеПараметрыДемоНабора();
	Параметры.Блоки = "";
	Итог = ТестовыеДанные.СоздатьДемоНабор(Параметры);
	Если ТестовыеДанные.НачалоДемоНабора() = Неопределено Тогда
		Возврат РезультатСценария("начало дня: демо-набор не запускается по времени, проверка рабочей базы пропущена", Истина);
	КонецЕсли;
	ПроверитьРавенство(0, Итог.Ошибок, "при рабочих документах - без ошибок и без отказа: " + СтрСоединить(Итог.Строки, " | "));
	Предупреждений = 0;
	Для Каждого Строка Из Итог.Строки Цикл
		Проверить(Не СтрНачинаетсяС(Строка, "ОТКАЗ;"), "строки отказа нет: " + Строка);
		Если СтрНачинаетсяС(Строка, "ИНФО;Демо-набор;") Тогда
			Предупреждений = Предупреждений + 1;
		КонецЕсли;
	КонецЦикла;
	ПроверитьРавенство(1, Предупреждений, "одна строка ИНФО о рабочих документах");
	Проверить(ЧислоДемоНоменклатуры("") > 0, "справочники набора подготовлены рядом с рабочими");

	Возврат РезультатСценария("рабочий - любой документ (прочие расходы без проведения, корректировка регистров, вид без "
		+ "комментария); не рабочие - ключ набора, образец, автовыпуск, заявка старого набора; посторонняя заявка - "
		+ "рабочая; в тестовой базе виды без комментария не проверяются; при рабочем документе набор не отказывает - "
		+ "справочники готовы, в итоге ИНФО");

КонецФункции

Функция ДокументБезПроверок(ИмяДокумента, Контекст, Комментарий)

	Док = Документы[ИмяДокумента].СоздатьДокумент();
	Док.Дата = СледующаяДата(Контекст);
	Если Комментарий <> Неопределено Тогда
		Док.Комментарий = Комментарий;
	КонецЕсли;
	Док.ОбменДанными.Загрузка = Истина;
	Док.Записать();
	Возврат Док.Ссылка;

КонецФункции

Функция ЗаявкаБезПроверок(Контекст, Контрагент, Описание, Артикул)

	Заявка = Документы.ЗаявкаНаПоискТовара.СоздатьДокумент();
	Заявка.Дата = СледующаяДата(Контекст);
	Заявка.Контрагент = Контрагент;
	Заявка.Описание = Описание;
	Заявка.Артикул = Артикул;
	Заявка.ОбменДанными.Загрузка = Истина;
	Заявка.Записать();
	Возврат Заявка.Ссылка;

КонецФункции

#КонецОбласти

#Область ДемоСтанки

// Блок учёта станков демо-набора (2.0.16.47): требования во всех четырёх состояниях, плановое и аварийное обслуживание,
// инвентаризация E1 до следующего запуска (запуск закрепляет оставшийся 1 кг), свободный остаток M1, «Готовы к запуску» -
// 10 шт. строки 4; все 7 отчётов и закладка «Станки» непустые; повтор - блок переиспользован.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст (не используется: у набора свои справочники)
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДемоСтанки(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Начало = Обработки.ТестовыеДанные.НачалоДемоНабора();
	Если Начало = Неопределено Тогда
		Возврат РезультатСценария("с начала дня прошло слишком мало времени для дат набора", Истина);
	КонецЕсли;
	Константы.ИспользоватьУчетСтанков.Установить(Истина);
	Суффикс = " (станки)";
	Результат = Обработки.ТестовыеДанные.ЗаполнитьДемоДанные(Начало, Суффикс, "M");
	Кейс = Результат.Кейсы["M"];
	Если Кейс = Неопределено Тогда
		Возврат РезультатСценария("блок M не создан: " + СтрСоединить(Результат.Итог.Строки, " | "), Истина);
	КонецЕсли;

	Статусы = Перечисления.СтатусыТребованийНакладных;
	Статус = "Статус";
	ПроверитьРавенство(Статусы.Завершено, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.Завершено, Статус), "E1 завершено");
	ПроверитьРавенство(Статусы.Завершено, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.ЗавершеноВторой, Статус),
		"M1 завершено");
	ПроверитьРавенство(Статусы.Запущено, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.Запущено, Статус), "запущено");
	ПроверитьРавенство(Статусы.Отменено, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.Отменено, Статус), "отменено");
	ПроверитьРавенство(Статусы.Запланировано, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.Запланировано, Статус),
		"запланировано");
	Проверить(Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.Ремонт, "Плановое"), "ремонт - аварийный");
	Проверить(ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.ТО, "ПланНачало")),
		"плановое ТО переведено в факт с плановыми датами");
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.ТОПлановое, "Плановое"), "будущее ТО - плановое");

	// BSLLS:MagicNumber-off - количества блока (план, §4.4).
	Запущено = Кейс.Запущено.ПолучитьОбъект();
	СоСклада = 0;
	Для Каждого Строка Из Запущено.Материалы Цикл
		СоСклада = СоСклада + Строка.СоСкладаСтанка;
	КонецЦикла;
	ПроверитьРавенство(1, СоСклада, "запуск после инвентаризации закрепил оставшийся 1 кг гранул");
	E1 = Кейс.Станки[0];
	M1 = Кейс.Станки[1];
	Материалы = Отчеты.МатериалыНаСтанках.ДанныеОтчета(ТекущаяДатаСеанса()).Материалы;
	Проверить(Материалы.НайтиСтроки(Новый Структура("Станок, Требование", E1, Кейс.Запущено)).Количество() > 0,
		"на E1 - закреплённое за запущенным");
	СвободноТкацкий = 0;
	Для Каждого Строка Из Материалы.НайтиСтроки(Новый Структура("Станок", M1)) Цикл
		Если Не ЗначениеЗаполнено(Строка.Требование) Тогда
			СвободноТкацкий = СвободноТкацкий + Строка.Количество;
		КонецЕсли;
	КонецЦикла;
	Ожидается = ?(Константы.СписыватьМатериалыНаСтанокПриРазмещении.Получить(), 2, 3);
	ПроверитьРавенство(Ожидается, СвободноТкацкий, "свободная нить на M1: недорасход 1 + излишек 2, минус закреплённое планом");

	Готовые = ЗагрузкаСтанков.ГотовыеКЗапуску(E1, ТекущаяДатаСеанса(), Результат.Контекст.Склад);
	Строки = Готовые.НайтиСтроки(Новый Структура("Заказ, КодСтроки", Кейс.ЗаказПлан, Кейс.КодСтрокиПлана));
	ПроверитьРавенство(1, Строки.Количество(), "второй заказ - в «Готовы к запуску»");
	Если Строки.Количество() = 1 Тогда
		ПроверитьРавенство(10, Строки[0].Остаток, "остаток второго заказа - 10 шт. (15 - 5 за запланированным)");
	КонецЕсли;
	// BSLLS:MagicNumber-on

	ПроверитьОтчетыДемоСтанков(Кейс, Начало);
	Повтор = Обработки.ТестовыеДанные.ЗаполнитьДемоДанные(Начало, Суффикс, "M");
	ПроверитьРавенство(1, Повтор.Итог.Переиспользовано, "повтор - блок M переиспользован");
	ПроверитьРавенство(0, Повтор.Итог.Создано, "повтор ничего не создаёт");

	Возврат РезультатСценария("требования завершено ×2, запущено, отменено, запланировано; ТО плановое и аварийное; "
		+ "инвентаризация до запуска, закреплён 1 кг; свободная нить M1; готово к запуску 10 шт.; 7 отчётов и закладка "
		+ "непустые; повтор - переиспользован");

КонецФункции

// Все 7 отчётов по станкам и закладка «Станки» показывают блок: период - от первой смены блока до сегодня.
//
// Параметры:
//  Кейс   - Структура - кейс M
//  Начало - Дата - начало набора
//
Процедура ПроверитьОтчетыДемоСтанков(Кейс, Начало)

	E1 = Кейс.Станки[0];
	P1 = Кейс.Станки[2];
	Момент = ТекущаяДатаСеанса();
	НачалоПериода = НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейс.Поступление, "Дата"));
	Период = Новый СтандартныйПериод(НачалоПериода, КонецДня(Начало));
	Простои = Отчеты.ПростоиСтанков.ДанныеОтчета(Период, Ложь).Простои;
	Проверить(СтрокаОтчетаПростоев(Простои, E1).Часы > 0, "«Простои станков» - авария E1");
	Занятость = Отчеты.ЗанятостьСтанков.ДанныеОтчета(Момент).Занятость;
	Проверить(Занятость.НайтиСтроки(Новый Структура("Станок, Занят", E1, Истина)).Количество() = 1,
		"«Занятость станков» - E1 загружен");
	Проверить(Занятость.НайтиСтроки(Новый Структура("Станок, Занят", P1, Ложь)).Количество() = 1,
		"«Занятость станков» - P1 свободен");
	Загрузка = Отчеты.ЗагрузкаСтанков.ДанныеОтчета(Период, Момент).Загрузка;
	Проверить(СтрокаОтчетаСтанков("ЗагрузкаСтанков", "Загрузка", Загрузка, E1, "Фонд,Работа").Работа > 0,
		"«Загрузка станков» - работа E1");
	Выработка = Отчеты.ВыработкаСтанков.ДанныеОтчета(Период, Момент).Выработка;
	Проверить(СтрокаОтчетаСтанков("ВыработкаСтанков", "Выработка", Выработка, E1, "Кг,Выпущено").Кг > 0,
		"«Выработка станков» - кг E1");
	Эффективность = Отчеты.ЭффективностьСтанков.ДанныеОтчета(Период, Момент).Эффективность;
	Проверить(СтрокаОтчетаСтанков("ЭффективностьСтанков", "Эффективность", Эффективность, E1, "Фонд,OEE").OEE > 0,
		"«Эффективность станков» - OEE E1");
	Деньги = Отчеты.ДеньгиПоСтанкам.ДанныеОтчета(Период, Момент).Деньги;
	Проверить(СтрокаОтчетаСтанков("ДеньгиПоСтанкам", "Деньги", Деньги, E1, "Выручка,ЗатратыОбслуживания").Выручка > 0,
		"«Деньги по станкам» - выручка E1");
	Проверить(Отчеты.МатериалыНаСтанках.ДанныеОтчета(Момент).Материалы.Количество() > 0, "«Материалы на станках» - есть");
	Состояние = ЗагрузкаСтанков.СостояниеСтанков(Кейс.Станки, НачалоПериода, КонецДня(Момент) + 1, Момент);
	ПроверитьРавенство(Кейс.Станки.Количество(), Состояние.Количество(), "закладка «Станки» - три станка блока");

КонецПроцедуры

#КонецОбласти

#Область ДанныеСценариев

// Данные, общие для сценариев. Всё, что записывается, заводится заново внутри
// транзакции сценария и откатывается вместе с ней; из базы берутся только организация,
// валюта учёта и предопределённые элементы. Свежая номенклатура и склад дают нулевые
// остатки - ожидаемые значения не зависят от содержимого базы.
//
// Возвращаемое значение:
//  Структура - контекст сценария, см. НовыйКонтекстДанных
//
Функция НовыйКонтекст()

	// Документы датируются чуть раньше текущего момента и с шагом в секунду: так
	// порядок документов на оси времени регистров совпадает с порядком их создания.
	Контекст = НовыйКонтекстДанных(ТекущаяДатаСеанса() - ЗапасСекунд(), ПометкаТеста());
	Контекст.Вставить("Единица", НоваяЕдиница());
	Контекст.Вставить("Склад", НовыйСклад());
	Контекст.Вставить("Контрагент", НовыйКонтрагент());
	Контекст.Вставить("ДоговорПокупателя", НовыйДоговор(Контекст, Перечисления.ВидыДоговоров.СПокупателем));
	Контекст.Вставить("ДоговорПоставщика", НовыйДоговор(Контекст, Перечисления.ВидыДоговоров.СПоставщиком));
	Контекст.Вставить("Касса", НоваяКасса(Контекст));
	Контекст.Вставить("Счет", НовыйБанковскийСчет(Контекст));
	Контекст.Вставить("Сотрудник", НовоеФизическоеЛицо());
	Контекст.Вставить("Товар", НоваяНоменклатура(Контекст, "товар", Перечисления.ТипыНоменклатуры.Товар));
	Контекст.Вставить("Сырье", НоваяНоменклатура(Контекст, "сырьё", Перечисления.ТипыНоменклатуры.Сырье));
	Контекст.Вставить("Продукция", НоваяПродукция(Контекст));

	Возврат Контекст;

КонецФункции

// Контекст документов без справочников: даты, организация, валюта и ставка НДС из базы. Им пользуются тесты документов и
// демо-набор (Обработки.ТестовыеДанные.СоздатьДемоНабор) вместе с помощниками НовыйДокумент, Провести, Записать,
// ДобавитьСтрокуТоваров, ДобавитьОснование, ДобавитьМатериалЗаказа, УстановитьКоличествоСтроки, СледующаяДата, СтатьяДДС.
// Справочники документов вызывающий кладёт в контекст сам; перед каждым кейсом можно подменить контрагента и договоры.
//
// Параметры:
//  Дата    - Дата   - дата, от которой отсчитываются даты документов (СледующаяДата прибавляет шаг)
//  Пометка - Строка - комментарий документов и признак объектов прогона
//
// Возвращаемое значение:
//  Структура - контекст:
//   * Числа              - Структура - количества и цены тестов, см. ЧислаСценариев
//   * Дата               - Дата      - начало отсчёта дат
//   * Шаг                - Число     - номер последнего шага дат
//   * Организация        - СправочникСсылка.Организации - первая организация базы
//   * Валюта             - СправочникСсылка.Валюты - валюта регламентированного учёта или первая валюта
//   * СтавкаНДС          - СправочникСсылка.СтавкиНДС - ставка без НДС
//   * СтатьяДДСЗапасная  - СправочникСсылка.СтатьиДвиженияДенежныхСредств - заводится при первой нужде, см. СтатьяДДС
//   * Пометка            - Строка - комментарий документов
//   Заполняет вызывающий: Единица, Склад, Контрагент, ДоговорПокупателя, ДоговорПоставщика, Касса, Счет.
//
Функция НовыйКонтекстДанных(Дата, Пометка) Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Числа", ЧислаСценариев());
	Контекст.Вставить("Дата", Дата);
	Контекст.Вставить("Шаг", 0);
	Контекст.Вставить("Пометка", Пометка);
	Контекст.Вставить("СтатьяДДСЗапасная", Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка());

	Организация = Обработки.ТестовыеДанные.ПервыйЭлемент("Организации");
	Проверить(ЗначениеЗаполнено(Организация), "в базе нет ни одной организации");
	Контекст.Вставить("Организация", Организация);

	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Обработки.ТестовыеДанные.ПервыйЭлемент("Валюты");
	КонецЕсли;
	Проверить(ЗначениеЗаполнено(Валюта), "не задана валюта регламентированного учёта и нет ни одной валюты");
	Контекст.Вставить("Валюта", Валюта);
	Контекст.Вставить("СтавкаНДС", Справочники.СтавкиНДС.SansTVA);

	Возврат Контекст;

КонецФункции

// Количества и цены сценариев в одном месте: ожидаемые значения считаются из них же.
//
// Возвращаемое значение:
//  Структура - количества и цены по именам
