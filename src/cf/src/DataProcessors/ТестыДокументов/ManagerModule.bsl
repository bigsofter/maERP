// Раздельный управленческий и налоговый учёт, Ф1 С1 (docs/plans/accounting-morocco-f1.md): признак УУ движений
// по флажку документа, физический остаток партии при белой закупке и чёрной продаже, белый и чёрный остатки, касса
// по флажку, банк всегда белый, без опции всё налоговое, запрет выключения опции при чёрных движениях.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Строка - строка отчёта, см. РезультатСценария
//
Функция СценарийРаздельныйУчет(Контекст)

	Числа = Контекст.Числа;
	Товар = Контекст.Товар;
	Склад = Контекст.Склад;
	Закуплено = 10;
	БезОпции = 1;
	Черная = 4;
	Белая = 3;

	ДокументЗакупки(Контекст, Товар, Закуплено, Числа.ЦенаЗакупки);

	// Без опции флажок документа не действует: документ налоговый.
	Константы.РаздельныйУчет.Установить(Ложь);
	РеализацияБезОпции = НоваяРеализацияУУ(Контекст, Товар, БезОпции, Числа.ЦенаПродажи, Истина);
	Проверить(Не ЕстьДвиженияУУ(РеализацияБезОпции), "без раздельного учёта движения документа с признаком - белые");
	Проверить(НалоговыйУчет.ТекстЗапретаВыключенияРаздельногоУчета() = "", "без чёрных движений опцию выключить можно");

	Константы.РаздельныйУчет.Установить(Истина);
	ЧернаяПродажа = НоваяРеализацияУУ(Контекст, Товар, Черная, Числа.ЦенаПродажи, Истина);
	БелаяПродажа = НоваяРеализацияУУ(Контекст, Товар, Белая, Числа.ЦенаПродажи, Ложь);

	ПроверитьРавенство(Закуплено - БезОпции - Черная - Белая, ОстатокТовара(Склад, Товар).Количество, "физический остаток - все движения");
	ПроверитьРавенство(Закуплено - БезОпции - Белая, ОстатокТовараУУ(Склад, Товар, Ложь), "белый остаток - без чёрной продажи");
	ПроверитьРавенство(-Черная, ОстатокТовараУУ(Склад, Товар, Истина), "чёрный остаток - чёрная продажа");
	Проверить(ЕстьДвиженияУУ(ЧернаяПродажа), "чёрная продажа пишет признак в товары, долги и продажи");
	Проверить(Не ЕстьДвиженияУУ(БелаяПродажа), "белая продажа пишет движения без признака");

	ЧернаяКасса = ДокументОплатыВКассуУУ(Контекст, ЧернаяПродажа, Черная * Числа.ЦенаПродажи, Истина);
	Проверить(ЕстьДвиженияУУ(ЧернаяКасса.Ссылка), "касса по чёрной продаже - с признаком");

	Банк = НовыйДокумент(Контекст, "ПоступлениеБезналичныхДенежныхСредств");
	Банк.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	Банк.Контрагент = Контекст.Контрагент;
	Банк.Договор = Контекст.ДоговорПокупателя;
	// BSLLS:YoLetterUsage-off
	Банк.БанковскийСчёт = Контекст.Счет;
	// BSLLS:YoLetterUsage-on
	Банк.ТипОплаты = Справочники.TypesDePayment.VirementBanquaire;
	Банк.СтатьяДДС = СтатьяДДС(Контекст, Банк.ХозяйственнаяОперация);
	Банк.Сумма = Белая * Числа.ЦенаПродажи;
	Банк.УУ = Истина;
	ДобавитьОснование(Банк, БелаяПродажа, Банк.Сумма);
	Провести(Банк);
	Проверить(Не ЕстьДвиженияУУ(Банк.Ссылка, Истина),
		"банк всегда белый, даже с признаком у документа");

	Проверить(НалоговыйУчет.ТекстЗапретаВыключенияРаздельногоУчета() <> "", "при чёрных движениях опцию выключить нельзя");

	Возврат РезультатСценария("без опции признак не действует, физический остаток - все движения, белый и чёрный "
		+ "остатки раздельно, признак в товарах, долгах, продажах и кассе, банк белый, запрет выключения опции");

КонецФункции

Функция НоваяРеализацияУУ(Контекст, Номенклатура, Количество, Цена, УУ)

	Док = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПокупателя;
	Док.ЦенаВключаетНДС = Истина;
	Док.УУ = УУ;
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Номенклатура, Количество, Цена);
	Провести(Док);
	Возврат Док.Ссылка;

