Функция СценарийОпцияОрдерныхСкладовЧерновик(Контекст)

	Константы.ИспользоватьОрдерныеСклады.Установить(Истина);
	БазаЧистая = Не ЗначениеЗаполнено(ПричинаПропускаОпцииОрдерныхСкладов());
	Ордер = НовыйДокумент(Контекст, "ПриходныйОрдер");
	Ордер.Записать(РежимЗаписиДокумента.Запись);
	Проверить(Справочники.МестаХранения.ОрдерныеСкладыИспользуются(), "черновик ордера - ордерная схема используется");
	Проверить(ЗначениеЗаполнено(Справочники.МестаХранения.ТекстЗапретаВыключенияОрдерности()),
		"при черновике ордера выключение запрещено");
	Если Не БазаЧистая Тогда
		Возврат РезультатСценария("черновик ордера запрещает выключение; без него - не проверено: в базе есть ордера");
	КонецЕсли;
	Ордер.Удалить();
	Проверить(Не Справочники.МестаХранения.ОрдерныеСкладыИспользуются(), "без черновика ордерная схема не используется");
	Проверить(Не ЗначениеЗаполнено(Справочники.МестаХранения.ТекстЗапретаВыключенияОрдерности()),
		"без черновика выключение разрешено");
	Возврат РезультатСценария("непроведённый ордер запрещает выключение опции, без него - разрешено");

КонецФункции

Функция СценарийОпцияОрдерныхСкладовОбновление(Контекст)

	Если ЗначениеЗаполнено(ПричинаПропускаОпцииОрдерныхСкладов()) Тогда
		// Заполненная база: по инварианту опция включена, обработчик её не трогает.
		ОбновлениеПрограммыОбработчики.ВключитьОпциюОрдерныхСкладов();
		Проверить(Константы.ИспользоватьОрдерныеСклады.Получить(), "опция включена при используемой ордерной схеме");
		Возврат РезультатСценария("обработчик обновления при используемой ордерной схеме оставляет опцию включённой");
	КонецЕсли;
	Константы.ИспользоватьОрдерныеСклады.Установить(Ложь);
	ОбновлениеПрограммыОбработчики.ВключитьОпциюОрдерныхСкладов();
	ПроверитьРавенство(Ложь, Константы.ИспользоватьОрдерныеСклады.Получить(), "база без ордеров - опция остаётся выключенной");
	Константы.ИспользоватьОрдерныеСклады.Установить(Истина);
	ОбновлениеПрограммыОбработчики.ВключитьОпциюОрдерныхСкладов();
	ПроверитьРавенство(Истина, Константы.ИспользоватьОрдерныеСклады.Получить(), "повтор при включённой опции ничего не меняет");
	Возврат РезультатСценария("обработчик обновления не включает опцию в базе без ордеров, повтор безопасен");

КонецФункции

#КонецОбласти

#Область ПоступленияТоварамиАРМ

// Режим «Товары» закладки «Поступления» рабочего места закупок (2.0.16.108, docs/plans/arm-purchasing-receipt-lines.md):
// строка - новое поступление по открытой строке заказа поставщика или без заказа, выбранный документ - по его заказу или
// без заказа; смешанных документов нет. Отказы адаптера и гейта механизма - до записи, транзакцию не портят.
//
// Параметры:
//  Имя      - Строка - имя сценария.
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПоступленийТоварамиПоИмени(Имя, Контекст)

	Если Имя = "ПоступленияТоварамиАРМ" Тогда
		Возврат СценарийПоступленияТоварамиАРМ(Контекст);
	КонецЕсли;
	Если Имя = "ПоступленияТоварамиАРМДваКода" Тогда
		Возврат СценарийПоступленияТоварамиАРМДваКода(Контекст);
	КонецЕсли;
	Если Имя = "ПоступленияТоварамиАРМОрдер" Тогда
		Возврат СценарийПоступленияТоварамиАРМОрдер(Контекст);
	КонецЕсли;
	ВызватьИсключение "Сценарий " + Имя + " не описан в СценарийПоступленийТоварамиПоИмени";

КонецФункции

Функция СтрокаТоваровАРМ(Документ, Поставщик, Товар, Количество)
	Строка = Новый Структура("Документ, НомерСтроки, ВерсияДанных, Поставщик, Номенклатура, Характеристика, Упаковка,
		|КоличествоУпаковок, Цена, ЦенаИзменена, КодСтрокиОснования");
	Строка.Документ = Документ;
	Строка.НомерСтроки = 0;
	Строка.ВерсияДанных = "";
	Строка.Поставщик = Поставщик;
	Строка.Номенклатура = Товар;
	Строка.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Строка.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	Строка.КоличествоУпаковок = Количество;
	// BSLLS:MagicNumber-off - цена сценария.
	Строка.Цена = 100;
	// BSLLS:MagicNumber-on
	Строка.ЦенаИзменена = Истина;
	Строка.КодСтрокиОснования = 0;
	Возврат Строка;
КонецФункции

// Строка документа из чтения режима «Товары» - для правки и удаления записанной строки.
//
// Параметры:
//  Документ - ДокументСсылка.ПоступлениеТоваровУслуг, ДокументСсылка.ПриходныйОрдер - документ строки.
//  Товар    - СправочникСсылка.Номенклатура - товар строки.
//
// Возвращаемое значение:
//  Структура, Неопределено - данные строки режима «Товары»; Неопределено - строки нет.
//
Функция ЗаписаннаяСтрокаТоваровАРМ(Документ, Товар)
	Для Каждого СтрокаДанных Из Обработки.АРМЗакупки.СтрокиТоваровПоступлений(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Документ)) Цикл
		Если СтрокаДанных.Материал = Товар Тогда
			Строка = СтрокаТоваровАРМ(Документ, СтрокаДанных.Поставщик, Товар, СтрокаДанных.КоличествоУпаковок);
			ЗаполнитьЗначенияСвойств(Строка, СтрокаДанных, "НомерСтроки, ВерсияДанных, Характеристика, Упаковка, Цена,
				|КодСтрокиОснования");
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция СтрокТоварногоДокумента(Документ)
	Возврат Обработки.АРМЗакупки.СтрокиТоваровПоступлений(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Документ)).Количество();
КонецФункции

Функция СценарийПоступленияТоварамиАРМ(Контекст)

	// BSLLS:MagicNumber-off - количества сценария.
	АРМ = Обработки.АРМЗакупки;
	УстановитьСкладПользователяСценария(Контекст.Склад);
	УстановитьСкладПоступленийСценария(Контекст.Склад);
	ТоварА = НоваяНоменклатура(Контекст, "товар А режима «Товары»", Перечисления.ТипыНоменклатуры.Товар);
	ТоварБ = НоваяНоменклатура(Контекст, "товар Б режима «Товары»", Перечисления.ТипыНоменклатуры.Товар);
	ЗаказХ = ЗаказВводомРабочегоМеста(Контекст, ТоварА, 10);
	Поставщик = Контекст.Контрагент;

	// 1. Товар с открытой строкой заказа - новое поступление по этому заказу.
	Р1 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Неопределено, Поставщик, ТоварА, 4));
	Проверить(Р1.Успех, "строка А: " + Р1.Текст);
	ПроверитьРавенство(ЗаказХ, ЗначениеРеквизитаЗапросом(Р1.Документ, "Основание"), "строка А - поступление по заказу");
	Проверить(ЗначениеРеквизитаЗапросом(Р1.Документ, "Проведен"), "поступление по заказу проведено");
	Открытые = АРМ.ОткрытыеСтрокиЗаказовПоставщика(Поставщик, ТоварА, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ПроверитьРавенство(1, Открытые.Количество(), "строка заказа открыта на остаток");
	ПроверитьРавенство(6, Открытые[0].Осталось, "остаток строки заказа после поступления 4");

	// 2. Товар вне заказов - поступление без основания.
	Р2 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Неопределено, Поставщик, ТоварБ, 2));
	Проверить(Р2.Успех, "строка Б: " + Р2.Текст);
	Проверить(Не ЗначениеЗаполнено(ЗначениеРеквизитаЗапросом(Р2.Документ, "Основание")), "строка Б - поступление без заказа");
	Проверить(Р2.Документ <> Р1.Документ, "строка Б - другое поступление");

	// 3. Вторая строка Б в выбранное поступление без заказа - тот же документ.
	Р3 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Р2.Документ, Поставщик, ТоварБ, 1));
	Проверить(Р3.Успех, "вторая строка Б в документ: " + Р3.Текст);
	ПроверитьРавенство(Р2.Документ, Р3.Документ, "вторая строка Б - тот же документ");
	ПроверитьРавенство(2, СтрокТоварногоДокумента(Р2.Документ), "в поступлении без заказа две строки");

	// 4. Правка количества записанной строки по заказу - основание то же, остаток заказа пересчитан.
	Правка = ЗаписаннаяСтрокаТоваровАРМ(Р1.Документ, ТоварА);
	Правка.КоличествоУпаковок = 5;
	Р4 = АРМ.ЗаписатьСтрокуТоваровПоступления(Правка);
	Проверить(Р4.Успех, "правка строки по заказу: " + Р4.Текст);
	Открытые = АРМ.ОткрытыеСтрокиЗаказовПоставщика(Поставщик, ТоварА, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ПроверитьРавенство(5, Открытые[0].Осталось, "остаток строки заказа после правки до 5");

	// 5. Запреты до записи: товар вне заказа в поступление по заказу; товар заказа в поступление без заказа.
	Р5 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Р1.Документ, Поставщик, ТоварБ, 1));
	Проверить(Не Р5.Успех, "товар вне заказа в поступление по заказу - отказ");
	Р6 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Р2.Документ, Поставщик, ТоварА, 1));
	Проверить(Не Р6.Успех, "товар открытого заказа в поступление без заказа - отказ");

	// 6. Чтение строк двух документов: три строки, заказ - у строки А.
	Строки = АРМ.СтрокиТоваровПоступлений(СтрЗаменитьМассив(Р1.Документ, Р2.Документ));
	ПроверитьРавенство(3, Строки.Количество(), "строк режима «Товары» двух документов");
	Для Каждого СтрокаДанных Из Строки Цикл
		Если СтрокаДанных.Материал = ТоварА Тогда
			ПроверитьРавенство(ЗаказХ, СтрокаДанных.ЗаказПоставщику, "строка А - с заказом");
		КонецЕсли;
	КонецЦикла;

	// 7. Удаление второй строки Б - в документе одна строка.
	Строки = Обработки.АРМЗакупки.СтрокиТоваровПоступлений(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Р2.Документ));
	Удаляемая = СтрокаТоваровАРМ(Р2.Документ, Поставщик, ТоварБ, 0);
	// Строки документа - последняя добавленная первой (2.0.16.115).
	ЗаполнитьЗначенияСвойств(Удаляемая, Строки[0], "НомерСтроки, ВерсияДанных");
	ПроверитьРавенство(2, Строки[0].НомерСтроки, "первой - последняя добавленная строка документа");
	Итог = АРМ.УдалитьСтрокиТоваровПоступлений(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаляемая));
	Проверить(Итог.Успех, "удаление строки: " + Итог.Текст);
	ПроверитьРавенство(1, СтрокТоварногоДокумента(Р2.Документ), "после удаления - одна строка");

	// 9. Заказ на Б после поступления без заказа: правка записанной строки проходит, новая строка Б - отказ.
	ЗаказВводомРабочегоМеста(Контекст, ТоварБ, 3);
	ПравкаБ = ЗаписаннаяСтрокаТоваровАРМ(Р2.Документ, ТоварБ);
	ПравкаБ.КоличествоУпаковок = 3;
	Р7 = АРМ.ЗаписатьСтрокуТоваровПоступления(ПравкаБ);
	Проверить(Р7.Успех, "правка строки без заказа после заказа на товар: " + Р7.Текст);
	Р8 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Р2.Документ, Поставщик, ТоварБ, 1));
	Проверить(Не Р8.Успех, "новая строка Б при открытом заказе в поступление без заказа - отказ");

	// 12. Поступление без заказа с основанием Неопределено (введено вручную) - строка добавляется.
	ТоварВ = НоваяНоменклатура(Контекст, "товар В режима «Товары»", Перечисления.ТипыНоменклатуры.Товар);
	Ручное = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Ручное.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Ручное.Контрагент = Поставщик;
	Ручное.Договор = Контекст.ДоговорПоставщика;
	Ручное.ЦенаВключаетНДС = Истина;
	Ручное.Валюта = Контекст.Валюта;
	Ручное.КурсВалюты = 1;
	Ручное.Основание = Неопределено;
	// Новая строка режима «Товары» добавляется только в сегодняшний документ.
	Ручное.Дата = ТекущаяДатаСеанса();
	ДобавитьСтрокуТоваров(Контекст, Ручное, "ТЧТовары", ТоварВ, 1, 10);
	Провести(Ручное);
	Р9 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Ручное.Ссылка, Поставщик, ТоварВ, 2));
	Проверить(Р9.Успех, "строка в поступление с основанием Неопределено: " + Р9.Текст);
	ПроверитьПравкуСтрокТоваровАРМ(Контекст, Р1.Документ, Ручное.Ссылка, ТоварА, ТоварВ, ТоварБ);
	// BSLLS:MagicNumber-on
	Возврат РезультатСценария("строки «Товаров»: по открытому заказу, без заказа, в выбранный документ, правка и удаление,
		|запреты смешанного документа, правка после нового заказа, основание Неопределено; порядок строк, смена товара
		|записанной строки, статус документа");

КонецФункции

// Режим «Товары» 2.0.16.115 (план docs/plans/arm-purchasing-receipt-lines-edit.md): порядок строк - документы в порядке
// страницы, строки документа - последняя добавленная первой; смена товара записанной строки по заказу - отказ, без
// заказа - запись, на товар открытого заказа - отказ; статус документа «В черновик» и «Провести» в закупочном контексте.
//
// Параметры:
//  Контекст      - Структура - см. НовыйКонтекст
//  ПоЗаказу      - ДокументСсылка.ПоступлениеТоваровУслуг - поступление по заказу со строкой товара А.
//  БезЗаказа     - ДокументСсылка.ПоступлениеТоваровУслуг - поступление без заказа с двумя строками товара В.
//  ТоварА        - СправочникСсылка.Номенклатура - товар строки по заказу.
//  ТоварВ        - СправочникСсылка.Номенклатура - товар строк без заказа.
//  ТоварОткрытый - СправочникСсылка.Номенклатура - товар открытого заказа поставщика.
//
Процедура ПроверитьПравкуСтрокТоваровАРМ(Контекст, ПоЗаказу, БезЗаказа, ТоварА, ТоварВ, ТоварОткрытый)

	// BSLLS:MagicNumber-off - номера строк сценария.
	АРМ = Обработки.АРМЗакупки;
	Строки = АРМ.СтрокиТоваровПоступлений(СтрЗаменитьМассив(БезЗаказа, ПоЗаказу));
	ПроверитьРавенство(3, Строки.Количество(), "строк двух документов");
	ПроверитьРавенство(БезЗаказа, Строки[0].Документ, "первым - документ, первый в порядке страницы");
	ПроверитьРавенство(2, Строки[0].НомерСтроки, "в документе первой - последняя добавленная строка");
	ПроверитьРавенство(1, Строки[1].НомерСтроки, "затем - первая строка документа");
	ПроверитьРавенство(ПоЗаказу, Строки[2].Документ, "вторым - следующий документ страницы");

	ТоварГ = НоваяНоменклатура(Контекст, "товар Г режима «Товары»", Перечисления.ТипыНоменклатуры.Товар);
	Правка = ЗаписаннаяСтрокаТоваровАРМ(ПоЗаказу, ТоварА);
	Правка.Номенклатура = ТоварГ;
	Итог = АРМ.ЗаписатьСтрокуТоваровПоступления(Правка);
	Проверить(Не Итог.Успех, "смена товара строки по заказу - отказ");
	Проверить(ЗаписаннаяСтрокаТоваровАРМ(ПоЗаказу, ТоварА) <> Неопределено, "строка по заказу с прежним товаром");

	Правка = ЗаписаннаяСтрокаТоваровАРМ(БезЗаказа, ТоварВ);
	Правка.Номенклатура = ТоварГ;
	Итог = АРМ.ЗаписатьСтрокуТоваровПоступления(Правка);
	Проверить(Итог.Успех, "смена товара строки без заказа: " + Итог.Текст);
	Проверить(ЗаписаннаяСтрокаТоваровАРМ(БезЗаказа, ТоварГ) <> Неопределено, "строка без заказа - с новым товаром");
	Правка = ЗаписаннаяСтрокаТоваровАРМ(БезЗаказа, ТоварГ);
	Правка.Номенклатура = ТоварОткрытый;
	Итог = АРМ.ЗаписатьСтрокуТоваровПоступления(Правка);
	Проверить(Не Итог.Успех, "смена товара строки без заказа на товар открытого заказа - отказ");

	ДокументыСтатуса = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(БезЗаказа);
	АРМПроизводства = Обработки.АРМПроизводство;
	Итог = АРМПроизводства.ИзменитьСтатусДокументовСтрок(ДокументыСтатуса, АРМПроизводства.ДействиеВЧерновик(), Неопределено)[0];
	Проверить(Итог.Успех, "«В черновик» документа строк: " + Итог.Текст);
	Проверить(Не ЗначениеРеквизитаЗапросом(БезЗаказа, "Проведен"), "документ строк - черновик");
	Итог = АРМПроизводства.ИзменитьСтатусДокументовСтрок(ДокументыСтатуса, АРМПроизводства.ДействиеВРаботу(), Неопределено)[0];
	Проверить(Итог.Успех, "«Провести» документа строк: " + Итог.Текст);
	Проверить(ЗначениеРеквизитаЗапросом(БезЗаказа, "Проведен"), "документ строк - проведён");
	// BSLLS:MagicNumber-on

КонецПроцедуры

Функция СтрЗаменитьМассив(Первый, Второй)
	Массив = Новый Массив;
	Массив.Добавить(Первый);
	Массив.Добавить(Второй);
	Возврат Массив;
КонецФункции

// Две строки заказа одного товара: вторая строка в тот же документ - к свободному коду, третья - отказ.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПоступленияТоварамиАРМДваКода(Контекст)

	// BSLLS:MagicNumber-off - количества сценария.
	АРМ = Обработки.АРМЗакупки;
	УстановитьСкладПользователяСценария(Контекст.Склад);
	УстановитьСкладПоступленийСценария(Контекст.Склад);
	Товар = НоваяНоменклатура(Контекст, "товар двух строк заказа", Перечисления.ТипыНоменклатуры.Товар);
	Заказ = НовыйДокумент(Контекст, "ЗаказПоставщику");
	Заказ.ВидЗаказа = Перечисления.ВидыЗаказовПоставщику.Основной;
	Заказ.ДатаПоставки = Заказ.Дата;
	Заказ.Контрагент = Контекст.Контрагент;
	Заказ.Договор = Контекст.ДоговорПоставщика;
	Заказ.ЦенаВключаетНДС = Истина;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Товар, 10, 5);
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Товар, 10, 5);
	Провести(Заказ);
	Р1 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Неопределено, Контекст.Контрагент, Товар, 3));
	Проверить(Р1.Успех, "первая строка: " + Р1.Текст);
	Р2 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Р1.Документ, Контекст.Контрагент, Товар, 2));
	Проверить(Р2.Успех, "вторая строка того же товара в тот же документ: " + Р2.Текст);
	Строки = АРМ.СтрокиТоваровПоступлений(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Р1.Документ));
	ПроверитьРавенство(2, Строки.Количество(), "в документе две строки");
	Проверить(Строки[0].КодСтрокиОснования <> Строки[1].КодСтрокиОснования, "строки документа - к разным кодам заказа");
	Р3 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Р1.Документ, Контекст.Контрагент, Товар, 1));
	Проверить(Не Р3.Успех, "третья строка - отказ: обе строки заказа уже в документе");
	// BSLLS:MagicNumber-on
	Возврат РезультатСценария("две строки заказа одного товара: вторая - к свободному коду, третья - отказ");

КонецФункции

// Ордерный склад поступлений пользователя: строка по заказу - приходный ордер с кодом строки заказа, без заказа -
// приходный ордер без основания.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПоступленияТоварамиАРМОрдер(Контекст)

	// BSLLS:MagicNumber-off - количества сценария.
	Константы.ИспользоватьОрдерныеСклады.Установить(Истина);
	АРМ = Обработки.АРМЗакупки;
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	УстановитьСкладПользователяСценария(Склад);
	УстановитьСкладПоступленийСценария(Склад);
	ТоварА = НоваяНоменклатура(Контекст, "товар А ордера «Товаров»", Перечисления.ТипыНоменклатуры.Товар);
	ТоварБ = НоваяНоменклатура(Контекст, "товар Б ордера «Товаров»", Перечисления.ТипыНоменклатуры.Товар);
	Заказ = ЗаказВводомРабочегоМеста(Контекст, ТоварА, 5);
	Р1 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Неопределено, Контекст.Контрагент, ТоварА, 5));
	Проверить(Р1.Успех, "строка по заказу на ордерном складе: " + Р1.Текст);
	Проверить(ТипЗнч(Р1.Документ) = Тип("ДокументСсылка.ПриходныйОрдер"), "по заказу - приходный ордер");
	ПроверитьРавенство(Заказ, ЗначениеРеквизитаЗапросом(Р1.Документ, "Основание"), "основание ордера - заказ");
	Строки = АРМ.СтрокиТоваровПоступлений(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Р1.Документ));
	Проверить(Строки.Количество() = 1 И Строки[0].КодСтрокиОснования <> 0, "строка ордера - с кодом строки заказа");
	Р2 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаТоваровАРМ(Неопределено, Контекст.Контрагент, ТоварБ, 2));
	Проверить(Р2.Успех, "строка без заказа на ордерном складе: " + Р2.Текст);
	Проверить(ТипЗнч(Р2.Документ) = Тип("ДокументСсылка.ПриходныйОрдер"), "без заказа - приходный ордер");
	Проверить(Не ЗначениеЗаполнено(ЗначениеРеквизитаЗапросом(Р2.Документ, "Основание")), "ордер без заказа - без основания");
	ПроверитьСкладСтрокиТоваров(Контекст, Склад, ТоварБ);
	// BSLLS:MagicNumber-on
	Возврат РезультатСценария("ордерный склад: строки «Товаров» по заказу и без заказа - приходные ордера; склад строки "
		+ "выбирает поступление или приходный ордер, единица и заказ новой строки - по товару");

КонецФункции

#КонецОбласти

// Склад строки режима «Товары» (2.0.16.111): по умолчанию - склад поступлений пользователя; строка на обычном складе
// создаёт поступление, на ордерном - приходный ордер, независимо от склада по умолчанию; по товару новой строки -
// его единица и строка открытого заказа.
//
// Параметры:
//  Контекст      - Структура - см. НовыйКонтекст
//  ОрдерныйСклад - СправочникСсылка.МестаХранения - ордерный склад сценария.
//  Товар         - СправочникСсылка.Номенклатура - товар.
//
Процедура ПроверитьСкладСтрокиТоваров(Контекст, ОрдерныйСклад, Товар)

	// BSLLS:MagicNumber-off - количества сценария.
	АРМ = Обработки.АРМЗакупки;
	УстановитьСкладПоступленийСценария(Контекст.Склад);
	ПроверитьРавенство(Контекст.Склад, АРМ.СкладНовойСтрокиТоваров().Склад, "склад новой строки - склад поступлений");
	НовыйНаОрдерном = АРМ.ПредставлениеНовогоДокументаСтроки(ОрдерныйСклад);
	НовыйНаОбычном = АРМ.ПредставлениеНовогоДокументаСтроки(Контекст.Склад);
	Проверить(НовыйНаОрдерном <> НовыйНаОбычном, "ордерный склад - другой документ новой строки");
	СтрокаОрдера = СтрокаТоваровАРМ(Неопределено, Контекст.Контрагент, Товар, 1);
	СтрокаОрдера.Вставить("Склад", ОрдерныйСклад);
	Р1 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаОрдера);
	Проверить(Р1.Успех И ТипЗнч(Р1.Документ) = Тип("ДокументСсылка.ПриходныйОрдер"),
		"строка на ордерном складе - приходный ордер: " + Р1.Текст);
	СтрокаПоступления = СтрокаТоваровАРМ(Неопределено, Контекст.Контрагент, Товар, 1);
	СтрокаПоступления.Вставить("Склад", Контекст.Склад);
	Р2 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаПоступления);
	Проверить(Р2.Успех И ТипЗнч(Р2.Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг"),
		"строка на обычном складе - поступление: " + Р2.Текст);
	ПроверитьРавенство(Контекст.Склад, ЗначениеРеквизитаЗапросом(Р2.Документ, "МестоХранения"), "склад поступления - склад строки");
	ДанныеТовара = АРМ.ДанныеТовараНовойСтроки(СтрокаТоваровАРМ(Неопределено, Контекст.Контрагент, Товар, 1));
	ЕдиницаТовара = ЗначениеРеквизитаЗапросом(Товар, "Единица");
	ПроверитьРавенство(ЕдиницаТовара, ДанныеТовара.Упаковка, "единица новой строки - из карточки товара");
	ЗаказВводомРабочегоМеста(Контекст, Товар, 3);
	ДанныеТовара = АРМ.ДанныеТовараНовойСтроки(СтрокаТоваровАРМ(Неопределено, Контекст.Контрагент, Товар, 1));
	Проверить(ЗначениеЗаполнено(ДанныеТовара.СтрокаОснованияПредставление), "открытый заказ - виден в новой строке");
	ПроверитьЗаказНовойСтрокиТоваров(Контекст);
	ПроверитьНакладнуюСтрокиТоваров(Контекст);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Заказ новой строки «Товаров» - тем же путём, что запись (ревью кода 2.0.16.111): два открытых заказа поставщика на
// товар; после поступления по первому новая строка показывает второй; в выбранном поступлении по первому заказу его
// строка уже занята - заказа нет (запись откажет).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьЗаказНовойСтрокиТоваров(Контекст)

	// BSLLS:MagicNumber-off - количества сценария.
	АРМ = Обработки.АРМЗакупки;
	Товар = НоваяНоменклатура(Контекст, "товар двух заказов «Товаров»", Перечисления.ТипыНоменклатуры.Товар);
	Заказ1 = ЗаказВводомРабочегоМеста(Контекст, Товар, 2);
	Заказ2 = ЗаказВводомРабочегоМеста(Контекст, Товар, 2);
	СтрокаСклада = СтрокаТоваровАРМ(Неопределено, Контекст.Контрагент, Товар, 2);
	СтрокаСклада.Вставить("Склад", Контекст.Склад);
	Р1 = АРМ.ЗаписатьСтрокуТоваровПоступления(СтрокаСклада);
	Проверить(Р1.Успех, "поступление по первому заказу: " + Р1.Текст);
	ПроверитьРавенство(Заказ1, ЗначениеРеквизитаЗапросом(Р1.Документ, "Основание"), "первая строка - по первому заказу");
	НомерВторого = ОбщегоНазначенияКлиентСервер.НомерНаПечать(ЗначениеРеквизитаЗапросом(Заказ2, "Номер"));
	Новая = АРМ.ДанныеТовараНовойСтроки(СтрокаТоваровАРМ(Неопределено, Контекст.Контрагент, Товар, 1));
	Проверить(СтрНайти(Новая.СтрокаОснованияПредставление, НомерВторого) > 0,
		"новая строка - второй заказ: " + Новая.СтрокаОснованияПредставление);
	ВДокумент = АРМ.ДанныеТовараНовойСтроки(СтрокаТоваровАРМ(Р1.Документ, Контекст.Контрагент, Товар, 1));
	ПроверитьРавенство("", ВДокумент.СтрокаОснованияПредставление, "в поступлении по первому заказу его строка занята");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Накладная поставщика строки «Товаров» (2.0.16.112): номер и дата новой строки - в шапке нового поступления; по номеру
// находится сегодняшнее поступление поставщика на складе, и вторая строка той же накладной записывается в него.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьНакладнуюСтрокиТоваров(Контекст)

	// BSLLS:MagicNumber-off - количества сценария.
	АРМ = Обработки.АРМЗакупки;
	Товар = НоваяНоменклатура(Контекст, "товар накладной «Товаров»", Перечисления.ТипыНоменклатуры.Товар);
	Номер = "BL-" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=");
	ДатаНакладной = НачалоДня(ТекущаяДатаСеанса());
	Первая = СтрокаТоваровАРМ(Неопределено, Контекст.Контрагент, Товар, 1);
	Первая.Вставить("Склад", Контекст.Склад);
	ПолеНомера = "НомерВходящегоДокумента";
	Первая.Вставить(ПолеНомера, Номер);
	Первая.Вставить("ДатаВходящегоДокумента", ДатаНакладной);
	Р1 = АРМ.ЗаписатьСтрокуТоваровПоступления(Первая);
	Проверить(Р1.Успех, "строка с накладной: " + Р1.Текст);
	ПроверитьРавенство(Номер, ЗначениеРеквизитаЗапросом(Р1.Документ, ПолеНомера), "номер накладной в шапке");
	ПроверитьРавенство(ДатаНакладной, ЗначениеРеквизитаЗапросом(Р1.Документ, "ДатаВходящегоДокумента"),
		"дата накладной в шапке");
	// Выбор колонки «Документ» с правами на оба вида документов: до 2.0.16.112 запрос объединения падал.
	ДокументыВыбора = АРМ.ДокументыДляСтрокиТоваров(Контекст.Контрагент);
	Проверить(ДокументыВыбора.НайтиПоЗначению(Р1.Документ) <> Неопределено, "поступление - в выборе документа строки");
	ДокументыСклада = АРМ.ДокументыДляСтрокиТоваров(Контекст.Контрагент, Контекст.Склад);
	Проверить(ДокументыСклада.НайтиПоЗначению(Р1.Документ) <> Неопределено, "поступление - в выборе по складу");
	Найденный = АРМ.ДокументНакладнойСтроки(Контекст.Контрагент, Контекст.Склад, Номер);
	Проверить(Найденный <> Неопределено И Найденный.Значение = Р1.Документ, "по номеру накладной найдено поступление");
	Вторая = СтрокаТоваровАРМ(Р1.Документ, Контекст.Контрагент, Товар, 2);
	Вторая.Вставить(ПолеНомера, Номер);
	Р2 = АРМ.ЗаписатьСтрокуТоваровПоступления(Вторая);
	Проверить(Р2.Успех И Р2.Документ = Р1.Документ, "вторая строка накладной - в то же поступление: " + Р2.Текст);
	// BSLLS:MagicNumber-on

КонецПроцедуры

Функция ОрдерныйСкладСценария(Контекст, ДатаНачала)
	Склад = Справочники.МестаХранения.СоздатьЭлемент();
	Склад.Наименование = ПометкаТеста() + ": ордерный склад";
	Склад.ОрдерныйСклад = Истина;
	Склад.ДатаНачалаОрдернойСхемы = ДатаНачала;
	Склад.Записать();
	Возврат Склад.Ссылка;
КонецФункции

Функция ПриходныйОрдерСценария(Контекст, Склад, Количество)
	Ордер = НовыйДокумент(Контекст, "ПриходныйОрдер");
	Ордер.МестоХранения = Склад;
	Ордер.Контрагент = Контекст.Контрагент;
	ДобавитьСтрокуТоваров(Контекст, Ордер, "ТЧТовары", Контекст.Товар, Количество, 0);
	Провести(Ордер);
	Возврат Ордер.Ссылка;
КонецФункции

Функция ПоступлениеПоОрдеру(Контекст, Ордер)
	Поступление = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Поступление.Заполнить(Ордер);
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Поступление.Комментарий = Контекст.Пометка;
	Поступление.Договор = Контекст.ДоговорПоставщика;
	Если Не ЗначениеЗаполнено(Поступление.Валюта) Тогда
		Поступление.Валюта = Контекст.Валюта;
		Поступление.КурсВалюты = 1;
	КонецЕсли;
	Для Каждого Строка Из Поступление.ТЧТовары Цикл
		Если Строка.Цена = 0 Тогда
			Строка.Цена = 5;
			РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Строка, Поступление.ЦенаВключаетНДС);
		КонецЕсли;
	КонецЦикла;
	Возврат Поступление;
КонецФункции

Процедура ОприходоватьНаСклад(Контекст, Склад, Номенклатура, Количество, Цена)
	Оприходование = НовыйДокумент(Контекст, "ОприходованиеТоваров");
	Оприходование.МестоХранения = Склад;
	ДобавитьСтрокуТоваров(Контекст, Оприходование, "ТЧТовары", Номенклатура, Количество, Цена);
	Провести(Оприходование);
КонецПроцедуры

// Остаток количества регистра «Заказы поставщикам» по заказу.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПоставщику - заказ
//
// Возвращаемое значение:
//  Число - количество к поступлению
//
Функция КоличествоЗаказовПоставщикам(Заказ)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
		|ИЗ
		|	РегистрНакопления.ЗаказыПоставщикам.Остатки(, ЗаказПоставщику = &Заказ) КАК Остатки");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Возврат ПерваяСтрока(Запрос, "Количество").Количество;
КонецФункции

// Неоформленный остаток ордера по регистру ТоварыКОформлению (коммерческие строки).
//
// Параметры:
//  Ордер - ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - ордер
//
// Возвращаемое значение:
//  Число - остаток количества
//
Функция ОстатокКОформлению(Ордер)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыКОформлению.Остатки(, Источник = &Ордер) КАК Остатки");
	Запрос.УстановитьПараметр("Ордер", Ордер);
	Возврат ПерваяСтрока(Запрос, "Количество").Количество;
КонецФункции

// Себестоимость реализации без допрасходов по регистру СебестоимостьПродаж.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация
//
// Возвращаемое значение:
//  Число - сумма
//
Функция СебестоимостьРеализацииСценария(Реализация)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Записи.Сумма), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.СебестоимостьПродаж КАК Записи
		|ГДЕ
		|	Записи.Регистратор = &Реализация
		|	И НЕ Записи.ДополнительныйРасход");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;
КонецФункции

// Ордерные склады v2, фаза 3 (2.0.16.122, docs/plans/warehouse-orders-cost.md, Ф3.17): приходный ордер создаёт партию,
// выпуск списывает материал до оформления поступления (жалоба клиента) по нулевой стоимости, поступление даёт стоимость
// ближним пересчётом и сдвигает границу на ордер, пересчёт последовательности доводит стоимость до выпуска; повторный
// пересчёт и перепроведение поступления границу не двигают; неподтверждённые партии и база цен.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладПартии(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - количества и цены сценария.
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Материал = НоваяНоменклатура(Контекст, "сырье приходного ордера", Перечисления.ТипыНоменклатуры.Сырье);
	Продукция = НоваяНоменклатура(Контекст, "продукция из ордера", Перечисления.ТипыНоменклатуры.Продукция);
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, СоставИзМатериала(Контекст, Материал, 1), Контекст.Дата);
	Ордер = ПриходныйОрдерНаТовар(Контекст, Склад, Материал, 10);
	Остаток = ОстатокТовара(Склад, Материал);
	ПроверитьРавенство(10, Остаток.Количество, "приходный ордер создал партию");
	ПроверитьРавенство(0, Остаток.Сумма, "стоимость партии до оформления - 0");
	Выпуск = ВыпускНаСкладе(Контекст, Склад, Продукция, 5);
	ПроверитьРавенство(0, СуммаРасходаДокумента(Выпуск, Материал), "выпуск списал материал ордера до поступления");
	Неподтвержденные = РегистрыНакопления.ТоварыВНаличии.НеподтвержденныеПартии();
	Проверить(Неподтвержденные.Найти(Ордер) <> Неопределено, "партия ордера до оформления не подтверждена");
	Проверить(Неподтвержденные.Найти(Выпуск) <> Неопределено, "продукция из неподтверждённой партии не подтверждена");

	Поступление = ПоступлениеПоОрдеру(Контекст, Ордер);
	УстановитьЦенуСтрок(Поступление, 7);
	Провести(Поступление);
	ПроверитьРавенство(70, СуммаПриходаНоменклатуры(Ордер, Материал), "ближний пересчёт: партия ордера 10 по 7");
	ПроверитьРавенство(0, СуммаПриходаНоменклатуры(Поступление.Ссылка, Материал), "поступление ордерного склада партий не пишет");
	МоментОрдера = Ордер.ПолучитьОбъект().МоментВремени();
	Проверить(Последовательности.Основная.ПолучитьГраницу().Сравнить(МоментОрдера) <= 0, "граница - не позже ордера");
	Неподтвержденные = РегистрыНакопления.ТоварыВНаличии.НеподтвержденныеПартии();
	Проверить(Неподтвержденные.Найти(Ордер) <> Неопределено, "оформленный ордер до пересчёта его расходов не подтверждён");
	Проверить(Неподтвержденные.Найти(Выпуск) <> Неопределено, "продукция до пересчёта не подтверждена");

	ПересчитатьСценарий(Последовательности.Основная.ПолучитьГраницу());
	ПроверитьРавенство(35, СуммаРасходаДокумента(Выпуск, Материал), "после пересчёта выпуск списал материал по 7");
	Неподтвержденные = РегистрыНакопления.ТоварыВНаличии.НеподтвержденныеПартии();
	Проверить(Неподтвержденные.Найти(Ордер) = Неопределено, "после пересчёта партия ордера подтверждена");
	Проверить(Неподтвержденные.Найти(Выпуск) = Неопределено, "после пересчёта продукция подтверждена");
	Граница = Последовательности.Основная.ПолучитьГраницу();
	Повтор = Поступление.Ссылка.ПолучитьОбъект();
	Провести(Повтор);
	ПроверитьРавенство(Граница, Последовательности.Основная.ПолучитьГраницу(),
		"перепроведение поступления без изменений границу не двигает (Редакция 5)");
	ПересчитатьСценарий(Граница);
	ПроверитьРавенство(35, СуммаРасходаДокумента(Выпуск, Материал), "повторный пересчёт: те же движения");

	Частичный = ПриходныйОрдерНаТовар(Контекст, Склад, Материал, 10);
	ЧастьПоступления = ПоступлениеПоОрдеру(Контекст, Частичный);
	УстановитьКоличествоСтроки(ЧастьПоступления.ТЧТовары[0], 8);
	УстановитьЦенуСтрок(ЧастьПоступления, 7);
	Провести(ЧастьПоступления);
	ПроверитьРавенство(56, СуммаПриходаНоменклатуры(Частичный, Материал), "оформлено 8 из 10: сумма партии 8 по 7");
	Проверить(РегистрыНакопления.ТоварыВНаличии.НеподтвержденныеПартии().Найти(Частичный) <> Неопределено,
		"частично оформленная партия не подтверждена");
	Характеристики = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Цены = РегистрыНакопления.ТоварыВНаличии.ПолучитьСреднююЦенуПоОстаткам(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Материал), Характеристики, Неопределено);
	Цена = Цены.Найти(Материал, "Номенклатура");
	ПроверитьРавенство(7, ?(Цена = Неопределено, 0, Цена.Цена), "база цен - без неподтверждённой партии");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("приходный ордер - партия с нулевой стоимостью, выпуск до поступления; поступление - стоимость "
		+ "партии ближним пересчётом и граница на ордере; пересчёт - выпуск по цене поступления; повтор и перепроведение "
		+ "границу не двигают; частичное оформление и база цен без неподтверждённой партии");

КонецФункции

// Расходный ордер списывает партии по FIFO, реализации по его строке получают себестоимость кусками списания по
// порядку (Ф3.6): отмена одной пары, повторное проведение раньше соседа и смена даты меняют получателей кусков.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладРасходПартий(Контекст)

	// BSLLS:MagicNumber-off - партии 6 по 10 и 4 по 20, реализации 4 и 6.
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар расходного ордера v2", Перечисления.ТипыНоменклатуры.Товар);
	ОприходоватьНаСклад(Контекст, Склад, Товар, 6, 10);
	ОприходоватьНаСклад(Контекст, Склад, Товар, 4, 20);
	Ордер = РасходныйОрдерНаТовар(Контекст, Склад, Товар, 10);
	ПроверитьРавенство(140, СуммаРасходаДокумента(Ордер, Товар), "расходный ордер списал партии по FIFO");
	ПроверитьРавенство(0, ОстатокТовара(Склад, Товар).Количество, "партий после ордера нет");
	Первая = РеализацияПоОрдеру(Контекст, Ордер, 4);
	Вторая = РеализацияПоОрдеру(Контекст, Ордер, 6);
	ПроверитьРавенство(40, СебестоимостьРеализацииСценария(Первая), "первая реализация - первые 4 первой партии");
	ПроверитьРавенство(100, СебестоимостьРеализацииСценария(Вторая), "вторая - 2 по 10 и 4 по 20");

	Отмена = Первая.ПолучитьОбъект();
	Отмена.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьРавенство(60, СебестоимостьРеализацииСценария(Вторая), "после отмены первой вторая - первые 6 по 10");
	Провести(Первая.ПолучитьОбъект());
	ПроверитьРавенство(40, СебестоимостьРеализацииСценария(Первая), "повторно проведённая ранняя - снова первые 4");
	ПроверитьРавенство(100, СебестоимостьРеализацииСценария(Вторая), "соседняя пересчитана обратно");

	Перенос = Первая.ПолучитьОбъект();
	Перенос.Дата = СледующаяДата(Контекст);
	Провести(Перенос);
	ПроверитьРавенство(60, СебестоимостьРеализацииСценария(Вторая), "после переноса первой позже вторая - первые 6");
	ПроверитьРавенство(80, СебестоимостьРеализацииСценария(Первая), "перенесённая - 4 по 20");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("расходный ордер списывает партии; реализации по строке - куски FIFO по порядку пар; отмена, "
		+ "повторное проведение и смена даты пересчитывают себестоимость соседей");

КонецФункции

// Расходный ордер без партий не проводится (Р1) - последнее действие сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладРасходБезПартий(Контекст)

	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар без партий", Перечисления.ТипыНоменклатуры.Товар);
	// BSLLS:MagicNumber-off
	Заказ = ДокументЗаказаПокупателя(Контекст, Товар, 3, 50);
	// BSLLS:MagicNumber-on
	Ордер = НовыйДокумент(Контекст, "РасходныйОрдер");
	Ордер.Заполнить(Заказ);
	Ордер.МестоХранения = Склад;
	Проверить(ОтказЗаписиДокумента(Ордер), "расходный ордер без партий - отказ");
	Возврат РезультатСценария("расходный ордер при нехватке партий не проводится");

КонецФункции

// Изменение кусков прежней реализации сдвигает границу строго раньше её возврата (Редакция 11), пересчёт
// восстанавливает возвратом новую партию.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладВозвратМеждуОформлениями(Контекст)

	// BSLLS:MagicNumber-off - партии 5 по 10 и 5 по 20; реализации по 3, возврат 1.
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар возврата ордера", Перечисления.ТипыНоменклатуры.Товар);
	ОприходоватьНаСклад(Контекст, Склад, Товар, 5, 10);
	ОприходоватьНаСклад(Контекст, Склад, Товар, 5, 20);
	Ордер = РасходныйОрдерНаТовар(Контекст, Склад, Товар, 10);
	РеализацияПоОрдеру(Контекст, Ордер, 3);
	ДатаВставки = СледующаяДата(Контекст);
	Вторая = РеализацияПоОрдеру(Контекст, Ордер, 3);
	ДокВозврата = ВозвратНаСклад(Контекст, Вторая, Склад, 1);
	ПроверитьРавенство(10, СуммаПриходаДокумента(ДокВозврата), "возврат восстановил партию по 10 (2 по 10 и 1 по 20 у второй)");

	Вставка = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Вставка.Заполнить(Ордер);
	Вставка.Дата = ДатаВставки;
	УстановитьКоличествоСтроки(Вставка.ТЧТовары[0], 3);
	Провести(Вставка);
	ПроверитьРавенство(60, СебестоимостьРеализацииСценария(Вторая), "реализация, вставленная раньше, сдвинула вторую на 3 по 20");
	Проверить(Последовательности.Основная.ПолучитьГраницу().Сравнить(ДокВозврата.ПолучитьОбъект().МоментВремени()) < 0,
		"граница строго раньше возврата изменённой реализации");
	ПересчитатьСценарий(Последовательности.Основная.ПолучитьГраницу());
	ПроверитьРавенство(20, СуммаПриходаДокумента(ДокВозврата), "после пересчёта возврат восстановил партию по 20");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("реализация, вставленная раньше, меняет куски прежней; граница - раньше её возврата; "
		+ "пересчёт восстанавливает возвратом новую партию");

КонецФункции

// Допрасходы поступления ордерного склада - на партию ордера по парам; допрасход партии с нулевой суммой списывается по
// количеству (Ф3.9); документ допрасходов по поступлению ордерного склада - на партию ордера; без базы - отказ
// (последнее действие).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладДопрасходы(Контекст)

	// BSLLS:MagicNumber-off - ордер 10, поступление по нулевой цене с допрасходом 100, списание 4.
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар с допрасходом ордера", Перечисления.ТипыНоменклатуры.Товар);
	Ордер = ПриходныйОрдерНаТовар(Контекст, Склад, Товар, 10);
	Поступление = ПоступлениеПоОрдеру(Контекст, Ордер);
	УстановитьЦенуСтрок(Поступление, 0);
	Допрасход = Поступление.ТЧДополнительныеРасходы.Добавить();
	Допрасход.Контрагент = Контекст.Контрагент;
	Допрасход.Договор = Контекст.ДоговорПоставщика;
	Допрасход.Сумма = 100;
	Допрасход.СуммаСНДС = 100;
	Допрасход.СтавкаНДС = Контекст.СтавкаНДС;
	Допрасход.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.Себестоимость;
	Провести(Поступление);
	ПроверитьРавенство(100, ДопрасходыДокумента(Ордер), "допрасход поступления - на партии ордера");
	Списание = НовыйДокумент(Контекст, "СписаниеТоваров");
	Списание.МестоХранения = Склад;
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	ДобавитьСтрокуТоваров(Контекст, Списание, "ТЧТовары", Товар, 4, 0);
	Провести(Списание);
	ПроверитьРавенство(-40, ДопрасходыДокумента(Списание.Ссылка), "допрасход нулевой партии списан по количеству");

	Документ = НовыйДокумент(Контекст, "ПоступлениеДополнительныхРасходов");
	Документ.Заполнить(Поступление.Ссылка);
	Документ.Валюта = Контекст.Валюта;
	Документ.КурсВалюты = 1;
	Документ.СтавкаНДС = Контекст.СтавкаНДС;
	Документ.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.Себестоимость;
	Документ.ТЧТовары[0].СуммаТовара = 1;
	Документ.ТЧТовары[0].Сумма = 50;
	Документ.Сумма = 50;
	Провести(Документ);
	ПроверитьРавенство(150, ДопрасходыПоПартии(Ордер), "документ допрасходов по поступлению ордерного склада - на партию ордера");

	БезБазы = НовыйДокумент(Контекст, "ПоступлениеДополнительныхРасходов");
	БезБазы.Заполнить(Поступление.Ссылка);
	БезБазы.Валюта = Контекст.Валюта;
	БезБазы.КурсВалюты = 1;
	БезБазы.СтавкаНДС = Контекст.СтавкаНДС;
	БезБазы.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.Себестоимость;
	БезБазы.ТЧТовары[0].Номенклатура = Контекст.Товар;
	БезБазы.ТЧТовары[0].СуммаТовара = 1;
	БезБазы.ТЧТовары[0].Сумма = 10;
	БезБазы.Сумма = 10;
	Проверить(ОтказЗаписиДокумента(БезБазы), "допрасход на товар, которого нет в партии, - отказ");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("допрасходы поступления - на партию ордера, нулевая партия списывает допрасход по количеству, "
		+ "документ допрасходов по поступлению ордерного склада - на ордер, без базы - отказ");

КонецФункции

// Отмена поступления ордерного склада, на которое распределён проведённый документ допрасходов, - отказ (Ф3.9):
// без пар база документа пуста.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладОтменаСДопрасходами(Контекст)

	// BSLLS:MagicNumber-off
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Ордер = ПриходныйОрдерНаТовар(Контекст, Склад, Контекст.Товар, 4);
	Поступление = ПоступлениеПоОрдеру(Контекст, Ордер);
	Провести(Поступление);
	Документ = НовыйДокумент(Контекст, "ПоступлениеДополнительныхРасходов");
	Документ.Заполнить(Поступление.Ссылка);
	Документ.Валюта = Контекст.Валюта;
	Документ.КурсВалюты = 1;
	Документ.СтавкаНДС = Контекст.СтавкаНДС;
	Документ.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.Себестоимость;
	Документ.ТЧТовары[0].СуммаТовара = 1;
	Документ.ТЧТовары[0].Сумма = 20;
	Документ.Сумма = 20;
	Провести(Документ);
	// BSLLS:MagicNumber-on
	ПолучитьСообщенияПользователю(Истина);
	Отказ = Ложь;
	Попытка
		Поступление.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "отмена поступления с допрасходами на него - отказ");
	Возврат РезультатСценария("отмена поступления ордерного склада с проведёнными допрасходами на него - отказ");

КонецФункции

// Обработчик 2.0.16.122: записи последовательности проведённых ордеров и граница строго раньше самого раннего;
// повторный вызов ничего не меняет (Ф3.15).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладОбновление(Контекст)

	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	// BSLLS:MagicNumber-off
	Ордер = ПриходныйОрдерНаТовар(Контекст, Склад, Контекст.Товар, 2);
	// BSLLS:MagicNumber-on
	Набор = Последовательности.Основная.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Ордер);
	Набор.Записать();
	Последовательности.Основная.УстановитьГраницу(Новый МоментВремени(КонецДня(Контекст.Дата) + 1));
	ОбновлениеПрограммыОбработчики.ДобавитьОрдераВПоследовательность();
	Набор.Прочитать();
	ПроверитьРавенство(1, Набор.Количество(), "запись последовательности ордера восстановлена");
	Граница = Последовательности.Основная.ПолучитьГраницу();
	Проверить(Граница.Сравнить(Ордер.ПолучитьОбъект().МоментВремени()) < 0, "граница строго раньше ордера");
	ОбновлениеПрограммыОбработчики.ДобавитьОрдераВПоследовательность();
	ПроверитьРавенство(Граница, Последовательности.Основная.ПолучитьГраницу(), "повторный вызов границу не меняет");

	// Запись составляющей комплекта прежних версий удаляется, коммерческая строка остаётся.
	НаборОформления = РегистрыНакопления.ТоварыКОформлению.СоздатьНаборЗаписей();
	НаборОформления.Отбор.Регистратор.Установить(Ордер);
	НаборОформления.Прочитать();
	Старая = НаборОформления.ДобавитьПриход();
	ЗаполнитьЗначенияСвойств(Старая, НаборОформления[0]);
	Старая.Составляющая = Контекст.Товар;
	НаборОформления.Записать();
	ОбновлениеПрограммыОбработчики.ОчиститьСоставляющиеТоваровКОформлению();
	НаборОформления.Прочитать();
	ПроверитьРавенство(1, НаборОформления.Количество(), "запись составляющей удалена, коммерческая осталась");
	// BSLLS:MagicNumber-off - количество ордера
	ПроверитьРавенство(2, ОстатокКОформлению(Ордер), "остаток к оформлению - по коммерческой строке");
	// BSLLS:MagicNumber-on
	Возврат РезультатСценария("обработчик обновления: записи последовательности ордеров, граница раньше первого, повтор "
		+ "идемпотентен");

КонецФункции

// Ордер, проведённый до 2.0.16.122 (без партий), вне пересчёта не оформляется - отказ с подсказкой (Ф3.15); последнее
// действие сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОрдерныйСкладСтараяСхема(Контекст)

	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	// BSLLS:MagicNumber-off
	Ордер = ПриходныйОрдерНаТовар(Контекст, Склад, Контекст.Товар, 3);
	// BSLLS:MagicNumber-on
	// Ордер прежней версии: движений партий у него не было.
	Партии = РегистрыНакопления.ТоварыВНаличии.СоздатьНаборЗаписей();
	Партии.Отбор.Регистратор.Установить(Ордер);
	Партии.Записать();
	Поступление = ПоступлениеПоОрдеру(Контекст, Ордер);
	Проверить(ОтказЗаписиДокумента(Поступление), "оформление ордера старой схемы вне пересчёта - отказ");
	Возврат РезультатСценария("ордер старой схемы (без своих партий) вне пересчёта не оформляется");

КонецФункции

