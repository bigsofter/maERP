Процедура ПроверитьОтказ(ТекстОтказа, Описание)

	ЕстьОтказ = ЗначениеЗаполнено(ТекстОтказа);
	Проверить(ЕстьОтказ, Описание);

КонецПроцедуры

// Налоговый документ на основаниях, Ф1 С2а (docs/plans/accounting-morocco-f1-s2.md): полное покрытие двух чёрных
// реализаций одним налоговым документом с другой ценой строки - переклассификация товаров без изменения физического
// остатка, белые продажи и долг по налоговому документу при неизменных фактических, перенос оплат до и после документа
// (подписка, перенос и отмена распределения платежа), запреты (неполное и повторное покрытие, изменение и распроведение
// основания, обычная запись изменённого документа, возврат по покрытому основанию и управленческий возврат по
// налоговому документу, покрытие основания с возвратом), возврат по налоговому документу, поступление на основании.
// Отказы проверяются функциями: отказ записи в транзакции прогона ломает её.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Строка - строка отчёта, см. РезультатСценария
//
Функция СценарийНалоговыйДокументНаОсновании(Контекст)

	// BSLLS:MagicNumber-off - количества и надбавка цены сценария
	Числа = Контекст.Числа;
	Товар = Контекст.Товар;
	Склад = Контекст.Склад;
	Контрагент = Контекст.Контрагент;
	Цена = Числа.ЦенаПродажи;
	Надбавка = 10;
	ИмяВозврата = "ВозвратОтПокупателя";
	Константы.РаздельныйУчет.Установить(Истина);
	ДокументЗакупки(Контекст, Товар, 20, Числа.ЦенаЗакупки);
	Черная1 = НоваяРеализацияУУ(Контекст, Товар, 3, Цена, Истина);
	Черная2 = НоваяРеализацияУУ(Контекст, Товар, 2, Цена, Истина);
	ДокументОплатыВКассуУУ(Контекст, Черная1, 3 * Цена, Истина);
	Физический = ОстатокТовара(Склад, Товар).Количество;
	Белый = ОстатокТовараУУ(Склад, Товар, Ложь);
	Выручка = ВыручкаПокупателяУУ(Контрагент, Ложь) + ВыручкаПокупателяУУ(Контрагент, Истина);
	Сальдо = СальдоПокупателя(Контрагент);

	Основания = Новый Массив;
	Основания.Добавить(Черная1);
	Основания.Добавить(Черная2);
	Налоговый = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	НалоговыеДокументыНаОснованиях.ЗаполнитьПоОснованиям(Налоговый, Основания);
	Проверить(Не Налоговый.УУ И Налоговый.Основания.Количество() = 2 И Налоговый.ТЧТовары.Количество() = 2,
		"заполнение по основаниям: налоговый документ, строка покрытия на каждую строку оснований");

	// Неполное покрытие строки - отказ.
	Налоговый.ТЧТовары[0].Количество = 1;
	Налоговый.Основания[0].Количество = 1;
	ТекстОтказа = НалоговыеДокументыНаОснованиях.ТекстОшибокДокумента(Налоговый);
	ПроверитьОтказ(ТекстОтказа, "неполное покрытие основания - отказ");
	Налоговый.ТЧТовары[0].Количество = 3;
	Налоговый.Основания[0].Количество = 3;

	// Другая цена строки второго основания: белый долг и выручка - по налоговому документу.
	СтрокаЦены = Налоговый.ТЧТовары[1];
	СтрокаЦены.Цена = Цена + Надбавка;
	СтрокаЦены.Сумма = СтрокаЦены.Количество * СтрокаЦены.Цена;
	СтрокаЦены.СуммаСНДС = СтрокаЦены.Сумма;
	Провести(Налоговый);
	СуммаНалогового = 5 * Цена + 2 * Надбавка;

	ПроверитьРавенство(Физический, ОстатокТовара(Склад, Товар).Количество, "физический остаток не меняется");
	ПроверитьРавенство(Белый - 5, ОстатокТовараУУ(Склад, Товар, Ложь), "белый остаток - минус покрытое количество");
	ПроверитьРавенство(СуммаНалогового, ВыручкаПокупателяУУ(Контрагент, Ложь), "белая выручка - налогового документа");
	ПроверитьРавенство(Выручка, ВыручкаПокупателяУУ(Контрагент, Ложь) + ВыручкаПокупателяУУ(Контрагент, Истина),
		"фактическая выручка не меняется");
	ПроверитьРавенство(Сальдо, СальдоПокупателя(Контрагент), "фактический долг не меняется");
	ПроверитьРавенство(СуммаНалогового - 3 * Цена, СальдоПокупателяУУ(Контрагент, Ложь),
		"белый долг - сумма документа минус перенесённая оплата основания");
	ПроверитьРавенство(-2 * Надбавка, СальдоПокупателяУУ(Контрагент, Истина), "чёрный долг - минус разница цен");

	// Повторное покрытие и запреты.
	Копия = Налоговый.Скопировать();
	Копия.Дата = СледующаяДата(Контекст);
	ТекстОтказа = НалоговыеДокументыНаОснованиях.ТекстОшибокДокумента(Копия);
	ПроверитьОтказ(ТекстОтказа, "второй документ на те же основания - отказ");
	ОснованиеОбъект = Черная1.ПолучитьОбъект();
	ТекстОтказа = НалоговыеДокументыНаОснованиях.ТекстЗапретаИзмененияОснования(ОснованиеОбъект, РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьОтказ(ТекстОтказа, "покрытое основание не распроводится");
	ОснованиеОбъект.ТЧТовары[0].Количество = 1;
	ТекстОтказа = НалоговыеДокументыНаОснованиях.ТекстЗапретаИзмененияОснования(ОснованиеОбъект, РежимЗаписиДокумента.Проведение);
	ПроверитьОтказ(ТекстОтказа, "строка покрытого основания не меняется");
	НалоговыйОбъект = Налоговый.Ссылка.ПолучитьОбъект();
	НалоговыйОбъект.ТЧТовары[1].Цена = Цена;
	ТекстОтказа = НалоговыеДокументыНаОснованиях.ТекстЗапретаЗаписиДокумента(НалоговыйОбъект, РежимЗаписиДокумента.Запись);
	ПроверитьОтказ(ТекстОтказа, "изменённый проведённый документ обычной записью не пишется");
	НалоговыйОбъект = Налоговый.Ссылка.ПолучитьОбъект();
	НалоговыйОбъект.Основания.Очистить();
	ТекстОтказа = НалоговыеДокументыНаОснованиях.ТекстЗапретаЗаписиДокумента(НалоговыйОбъект, РежимЗаписиДокумента.Проведение);
	ПроверитьОтказ(ТекстОтказа, "проведённый документ не меняет вид");

	// Оплата основания после документа - переносится подпиской; перенос и отмена распределения - снимается.
	Обычная = НоваяРеализацияУУ(Контекст, Товар, 2, Цена, Ложь);
	Банк = ДокументОплатыВБанк(Контекст, Черная2, 2 * Цена);
	// Фактический остаток по объекту налогового документа: пара разницы цен в сумме ноль.
	ПроверитьРавенство(0, ОстатокПоОбъектуРасчетов(Контрагент, Налоговый.Ссылка),
		"оплата основания после документа перенесена на налоговый документ");
	ПроверитьРавенство(0, ОстатокПоОбъектуРасчетов(Контрагент, Черная2), "на основании после оплаты - ноль");
	Банк.ТЧОснования[0].Основание = Обычная;
	Банк.Дата = СледующаяДата(Контекст);
	Провести(Банк);
	ПроверитьРавенство(2 * Цена, ОстатокПоОбъектуРасчетов(Контрагент, Налоговый.Ссылка),
		"перенос распределения платежа на другое основание снимает перенос оплаты");
	Банк.ТЧОснования[0].Основание = Черная2;
	Провести(Банк);
	Банк.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьРавенство(2 * Цена, ОстатокПоОбъектуРасчетов(Контрагент, Налоговый.Ссылка),
		"отмена проведения платежа снимает перенос оплаты");

	// Возвраты: по покрытому основанию - отказ, управленческий по налоговому документу - отказ, налоговый - партии и
	// продажи в белом.
	ВозвратНалоговый = НовыйДокумент(Контекст, ИмяВозврата);
	ВозвратНалоговый.Заполнить(Черная1);
	ТекстОтказа = НалоговыеДокументыНаОснованиях.ТекстЗапретаДокументаПоОснованию(ВозвратНалоговый, Черная1);
	ПроверитьОтказ(ТекстОтказа, "возврат по покрытому основанию - отказ");
	ВозвратНалоговый = НовыйДокумент(Контекст, ИмяВозврата);
	ВозвратНалоговый.Заполнить(Налоговый.Ссылка);
	ВозвратНалоговый.Дата = СледующаяДата(Контекст);
	ВозвратНалоговый.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	Проверить(Не ВозвратНалоговый.УУ, "возврат по налоговому документу заполняется налоговым");
	ВозвратНалоговый.УУ = Истина;
	ТекстОтказа = НалоговыеДокументыНаОснованиях.ТекстЗапретаДокументаПоОснованию(ВозвратНалоговый, Налоговый.Ссылка);
	ПроверитьОтказ(ТекстОтказа, "управленческий возврат по налоговому документу - отказ");
	ВозвратНалоговый.УУ = Ложь;
	Белый = ОстатокТовараУУ(Склад, Товар, Ложь);
	Провести(ВозвратНалоговый);
	ПроверитьРавенство(Белый + 5, ОстатокТовараУУ(Склад, Товар, Ложь), "возврат по налоговому документу - белый приход");
	ПроверитьРавенство(0, ВыручкаПокупателяУУ(Контрагент, Ложь) - ВыручкаДокументаУУ(Обычная),
		"возврат снимает белую выручку налогового документа один раз");
	НалоговыйОбъект = Налоговый.Ссылка.ПолучитьОбъект();
	ТекстОтказа = НалоговыеДокументыНаОснованиях.ТекстЗапретаЗаписиДокумента(НалоговыйОбъект, РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьОтказ(ТекстОтказа, "налоговый документ с возвратом не распроводится");

	// Основание с возвратом до покрытия не покрывается.
	Черная3 = НоваяРеализацияУУ(Контекст, Товар, 1, Цена, Истина);
	ВозвратДо = НовыйДокумент(Контекст, ИмяВозврата);
	ВозвратДо.Заполнить(Черная3);
	ВозвратДо.Дата = СледующаяДата(Контекст);
	ВозвратДо.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	Провести(ВозвратДо);
	Налоговый3 = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	НалоговыеДокументыНаОснованиях.ЗаполнитьПоОснованиям(Налоговый3, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Черная3));
	ТекстОтказа = НалоговыеДокументыНаОснованиях.ТекстОшибокДокумента(Налоговый3);
	ПроверитьОтказ(ТекстОтказа, "основание с возвратом не покрывается");

	// Поступление на основании: чёрная закупка переходит в белую, долг поставщику - в налоговый признак.
	ЧернаяЗакупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	ЧернаяЗакупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	ЧернаяЗакупка.Контрагент = Контрагент;
	ЧернаяЗакупка.Договор = Контекст.ДоговорПоставщика;
	ЧернаяЗакупка.ЦенаВключаетНДС = Истина;
	ЧернаяЗакупка.Валюта = Контекст.Валюта;
	ЧернаяЗакупка.КурсВалюты = 1;
	ЧернаяЗакупка.УУ = Истина;
	ДобавитьСтрокуТоваров(Контекст, ЧернаяЗакупка, "ТЧТовары", Товар, 4, Числа.ЦенаЗакупки);
	Провести(ЧернаяЗакупка);
	Физический = ОстатокТовара(Склад, Товар).Количество;
	Белый = ОстатокТовараУУ(Склад, Товар, Ложь);
	ЧерныйДолг = СальдоПоставщикаУУ(Контрагент, Истина);
	БелыйДолг = СальдоПоставщикаУУ(Контрагент, Ложь);
	НалоговаяЗакупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	НалоговыеДокументыНаОснованиях.ЗаполнитьПоОснованиям(НалоговаяЗакупка,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЧернаяЗакупка.Ссылка));
	Провести(НалоговаяЗакупка);
	ПроверитьРавенство(Физический, ОстатокТовара(Склад, Товар).Количество, "поступление на основании: физический остаток");
	ПроверитьРавенство(Белый + 4, ОстатокТовараУУ(Склад, Товар, Ложь), "поступление на основании: белый приход");
	ПроверитьРавенство(0, СальдоПоставщикаУУ(Контрагент, Истина), "поступление на основании: чёрный долг перенесён");
	ПроверитьРавенство(БелыйДолг + ЧерныйДолг, СальдоПоставщикаУУ(Контрагент, Ложь),
		"поступление на основании: белый долг - сумма документа");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("полное покрытие двух оснований, физический остаток и фактические долг и выручка не "
		+ "меняются, белые - по налоговому документу, оплаты до и после документа, перенос и отмена распределения, "
		+ "запреты покрытия и изменения, возврат по налоговому документу, поступление на основании");

КонецФункции

Функция ДокументОплатыВБанк(Контекст, Реализация, Сумма)

	Банк = НовыйДокумент(Контекст, "ПоступлениеБезналичныхДенежныхСредств");
	Банк.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	Банк.Контрагент = Контекст.Контрагент;
	Банк.Договор = Контекст.ДоговорПокупателя;
	// BSLLS:YoLetterUsage-off
	Банк.БанковскийСчёт = Контекст.Счет;
	// BSLLS:YoLetterUsage-on
	Банк.ТипОплаты = Справочники.TypesDePayment.VirementBanquaire;
	Банк.СтатьяДДС = СтатьяДДС(Контекст, Банк.ХозяйственнаяОперация);
	Банк.Сумма = Сумма;
	ДобавитьОснование(Банк, Реализация, Сумма);
	Провести(Банк);
	Возврат Банк;

КонецФункции

Функция СальдоПокупателяУУ(Контрагент, УУ)

	// BSLLS:YoLetterUsage-off
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Ост.СуммаОстаток), 0) КАК Сальдо
		|ИЗ
		|	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, Контрагент = &Контрагент И УУ = &УУ) КАК Ост");
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("УУ", УУ);
	Возврат ПерваяСтрока(Запрос, "Сальдо").Сальдо;

КонецФункции

Функция СальдоПоставщикаУУ(Контрагент, УУ)

	// BSLLS:YoLetterUsage-off
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Ост.СуммаОстаток), 0) КАК Сальдо
		|ИЗ
		|	РегистрНакопления.ВзаиморасчётыСПоставщиками.Остатки(, Контрагент = &Контрагент И УУ = &УУ) КАК Ост");
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("УУ", УУ);
	Возврат ПерваяСтрока(Запрос, "Сальдо").Сальдо;

КонецФункции

Функция ВыручкаПокупателяУУ(Контрагент, УУ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Обороты.ВыручкаОборот), 0) КАК Выручка
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(, , , Контрагент = &Контрагент И УУ = &УУ) КАК Обороты");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("УУ", УУ);
	Возврат ПерваяСтрока(Запрос, "Выручка").Выручка;

КонецФункции

Функция ВыручкаДокументаУУ(Документ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Т.Выручка), 0) КАК Выручка
		|ИЗ
		|	РегистрНакопления.Продажи КАК Т
		|ГДЕ
		|	Т.Регистратор = &Документ
		|	И НЕ Т.УУ");
	Запрос.УстановитьПараметр("Документ", Документ);
	Возврат ПерваяСтрока(Запрос, "Выручка").Выручка;

КонецФункции

// Переезд расчётов с реализации на налоговую накладную (2.0.15.58).
// Проверяет то, что не ловят ни линтер, ни смок: знаки сторно, сохранение сальдо контрагента,
// долю покрытия при частичной накладной, видимость долга контролем кредита и запрет повторного
// покрытия отгрузки второй накладной.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПереездРасчетовНаНакладную(Контекст)

	Числа = Контекст.Числа;
	Контрагент = Контекст.Контрагент;
	ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	Реализация = ДокументРеализации(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);
	СуммаПродажи = Числа.КоличествоПродажи * Числа.ЦенаПродажи;
	ПроверитьРавенство(СуммаПродажи, СальдоПокупателя(Контрагент), "долг по реализации до накладной");

	// BSLLS:MagicNumber-off - половина суммы: оплата до накладной, чтобы сторно затронуло и долг, и платёж.
	ЧастьОплаты = Окр(СуммаПродажи / 2, 2);
	// BSLLS:MagicNumber-on
	ДокументОплатыВКассу(Контекст, Реализация, ЧастьОплаты);
	Долг = СуммаПродажи - ЧастьОплаты;
	ПроверитьРавенство(Долг, СальдоПокупателя(Контрагент), "долг уменьшен оплатой");

	Накладная = ПроведеннаяНалоговаяНакладная(Контекст, Реализация);
	ПроверитьРавенство(0, ОстатокПоОбъектуРасчетов(Контрагент, Реализация),
		"реализация обнулена: долг и оплата сторнированы накладной");
	ПроверитьРавенство(Долг, ОстатокПоОбъектуРасчетов(Контрагент, Накладная),
		"долг переехал на накладную");
	ПроверитьРавенство(Долг, СальдоПокупателя(Контрагент),
		"сальдо контрагента переездом не изменилось");
	ПроверитьРавенство(Долг, ПросроченныйДолгКонтрагента(Контрагент),
		"контроль кредита видит долг, ставший долгом по накладной");

	ПроверитьЗапретВторойНакладной(Контекст, Реализация);

	Возврат РезультатСценария("переезд расчётов на налоговую накладную: реализация обнулена, "
		+ "накладная приняла долг и оплату, сальдо контрагента сохранено, "
		+ "контроль кредита видит долг, вторая накладная по той же отгрузке не проводится");

КонецФункции

// Раздел «Закупки» (этап 2 menu-restructure, 2.0.16.6): группы раздела и их права у ролей закупочного контура,
// группа «Импорт» под своей опцией; «Просроченные долги поставщиков» формируются (вариант был сломан полем
// покупательского отчёта) и показывают долг и дни просрочки по поступлению с истёкшим сроком оплаты.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийМенюЗакупок(Контекст)

	Закупки = Метаданные.Подсистемы.Закупки;
	Группы = Новый Массив;
	Для Каждого Группа Из Закупки.Подсистемы Цикл
		Группы.Добавить(Группа.Имя);
	КонецЦикла;
	ПроверитьРавенство("Планирование, ПоставщикиИЦены, Импорт, Справочники", СтрСоединить(Группы, ", "),
		"группы раздела «Закупки»");
	Проверить(ВСоставеОпции("ИспользоватьИмпорт", Закупки.Подсистемы.Импорт), "группа «Импорт» - в опции «Импорт»");
	Проверить(ВСоставеОпции("Производство", Метаданные.Отчеты.ПотребностиПроизводства),
		"потребности производства - в опции «Производство»");
	Проверить(Закупки.Состав.Содержит(Метаданные.Отчеты.ПросроченныеДолгиПоставщиков), "просроченные долги - в разделе");
	Проверить(Не Метаданные.Подсистемы.Казначейство.Состав.Содержит(Метаданные.Отчеты.РеестрПоступленийТоваровУслуг),
		"реестр поступлений ушёл из Казначейства");

	ПроверитьПраваНаГруппыЗакупок(Закупки);

	// BSLLS:MagicNumber-off
	Данные = ПоступлениеСОтсрочкой(Контекст, 10);
	// BSLLS:MagicNumber-on
	СтрокаДолга = СтрокаПросроченныхДолговПоставщиков(Контекст, Данные.Поступление);
	Проверить(СтрокаДолга <> Неопределено, "поступление в отчёте «Просроченные долги поставщиков»");
	ПроверитьРавенство(Данные.Сумма, СтрокаДолга.Долг, "просроченный долг по поступлению");
	Проверить(СтрокаДолга.ПросроченоДней >= Данные.ДнейПросрочки И СтрокаДолга.ПросроченоДней <= Данные.ДнейПросрочки + 1,
		"дней просрочки " + Данные.ДнейПросрочки + " или на день больше, получено " + СтрокаДолга.ПросроченоДней);
	СрокНеНаступил = ПоступлениеСОтсрочкой(Контекст, 0);
	Проверить(СтрокаПросроченныхДолговПоставщиков(Контекст, СрокНеНаступил.Поступление) = Неопределено,
		"долг, срок оплаты которого не наступил, в отчёт не попадает");

	// Вариант отчёта целиком, как его формирует пользователь: модуль объекта подаёт внешний набор данных.
	Отчет = Отчеты.ПросроченныеДолгиПоставщиков.Создать();
	Схема = Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Схема.ВариантыНастроек.Найти("Основной").Настройки);
	Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОтчёта", ТекущаяДатаСеанса());
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Отчет.СкомпоноватьРезультат(ТабличныйДокумент, Новый ДанныеРасшифровкиКомпоновкиДанных);
	Проверить(ТабличныйДокумент.НайтиТекст(Строка(Данные.Поступление)) <> Неопределено,
		"поступление в табличном документе варианта «Основной»");

	Долг = СтрокаЧисла(СтрокаДолга.Долг);
	Возврат РезультатСценария("группы Планирование, Поставщики и цены, Импорт (в опции), Справочники; View у четырёх "
		+ "ролей, у оператора производства раздела нет; просроченный долг " + Долг + ", "
		+ СтрокаДолга.ПросроченоДней + " дн., долг без просрочки не показан; вариант «Основной» сформирован");

КонецФункции

Процедура ПроверитьПраваНаГруппыЗакупок(Закупки)

	Группы = Новый Массив;
	Группы.Добавить(Закупки);
	Для Каждого Группа Из Закупки.Подсистемы Цикл
		Группы.Добавить(Группа);
	КонецЦикла;
	Для Каждого ИмяРоли Из СтрРазделить("МенеджерПоЗакупкам,Кладовщик,Казначей,Логист", ",") Цикл
		Роль = Метаданные.Роли[ИмяРоли];
		Для Каждого Группа Из Группы Цикл
			Проверить(ПравоДоступа("Просмотр", Группа, Роль), "роль " + ИмяРоли + " видит " + Группа.ПолноеИмя());
		КонецЦикла;
	КонецЦикла;
	Проверить(Не ПравоДоступа("Просмотр", Закупки, Метаданные.Роли.ОператорПроизводства),
		"у оператора производства раздела «Закупки» нет");

КонецПроцедуры

// Раздел «Продажи» (этап 3 menu-restructure, 2.0.16.7): группы раздела и их права у ролей с доступом к «Продажам»,
// группы под опциями, налоговые отчёты и реестр реализаций на своих местах; «Просроченные долги покупателей»
// показывают только долги с истёкшим сроком оплаты (раньше - весь долг сверх кредита), а функция источника без
// ключа отбора по-прежнему отдаёт весь долг - его читают РМК и форма клиента.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийМенюПродаж(Контекст)

	Продажи = Метаданные.Подсистемы.Продажи;
	Группы = Новый Массив;
	Для Каждого Группа Из Продажи.Подсистемы Цикл
		Группы.Добавить(Группа.Имя);
	КонецЦикла;
	ПроверитьРавенство("Опт, РозничныеПродажи, Цены, Клиенты, Справочники", СтрСоединить(Группы, ", "),
		"группы раздела «Продажи»");
	ПроверитьСоставРазделаПродаж(Продажи);
	ПроверитьПраваНаГруппыПродаж(Продажи);

	// BSLLS:MagicNumber-off
	ПоступлениеСОтсрочкой(Контекст, 12);
	Данные = ПродажаСОтсрочкой(Контекст, 10, 1);
	// Срок не задан в договоре - берётся из карточки контрагента, как у кредитного контроля: 30 дней не истекли.
	Клиент = Контекст.Контрагент.ПолучитьОбъект();
	Клиент.СрокОплаты = 30;
	Клиент.Записать();
	СрокИзКарточки = ПродажаСОтсрочкой(Контекст, 10, 0);
	// BSLLS:MagicNumber-on
	СрокНеНаступил = ПродажаСОтсрочкой(Контекст, 0, 1);
	СтрокаДолга = СтрокаПросроченныхДолговПокупателей(Контекст, Данные.Продажа);
	Проверить(СтрокаДолга <> Неопределено, "продажа в отчёте «Просроченные долги покупателей»");
	ПроверитьРавенство(Данные.Сумма, СтрокаДолга.Долг, "просроченный долг по продаже");
	// Контекст может быть датирован прошлыми сутками (запас секунд) - тогда на день больше.
	Проверить(СтрокаДолга.ПросроченоДней >= Данные.ДнейПросрочки И СтрокаДолга.ПросроченоДней <= Данные.ДнейПросрочки + 1,
		"дней просрочки " + Данные.ДнейПросрочки + " или на день больше, получено " + СтрокаДолга.ПросроченоДней);
	Проверить(СтрокаПросроченныхДолговПокупателей(Контекст, СрокИзКарточки.Продажа) = Неопределено,
		"срок из карточки контрагента (30 дней) не истёк - долга в отчёте нет");
	Проверить(СтрокаПросроченныхДолговПокупателей(Контекст, СрокНеНаступил.Продажа) = Неопределено,
		"долг, срок оплаты которого не наступил, в отчёт не попадает");
	// BSLLS:YoLetterUsage-off
	ВесьДолг = РегистрыНакопления.ВзаиморасчётыСПокупателями.ПолучитьЗадолженностьКлиентовПоКлассификации(
		ТекущаяДатаСеанса(), Новый Структура("Контрагенты", ОдинКонтрагент(Контекст)));
	// BSLLS:YoLetterUsage-on
	Проверить(ВесьДолг.Найти(СрокНеНаступил.Продажа, "РеализацияТоваровУслуг") <> Неопределено,
		"без ключа ТолькоПросроченные функция отдаёт и долг с ненаступившим сроком (РМК, форма клиента)");

	// Вариант отчёта целиком, как его формирует пользователь: модуль объекта подаёт внешний набор данных.
	Отчет = Отчеты.ПросроченныеДолгиПокупателей.Создать();
	Схема = Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Схема.ВариантыНастроек.Найти("Основной").Настройки);
	Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОтчёта", ТекущаяДатаСеанса());
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Отчет.СкомпоноватьРезультат(ТабличныйДокумент, Новый ДанныеРасшифровкиКомпоновкиДанных);
	Проверить(ТабличныйДокумент.НайтиТекст(Строка(Данные.Продажа)) <> Неопределено,
		"продажа в табличном документе варианта «Основной»");
	Проверить(ТабличныйДокумент.НайтиТекст(Строка(СрокНеНаступил.Продажа)) = Неопределено,
		"продажи с ненаступившим сроком в варианте «Основной» нет");

	Долг = СтрокаЧисла(СтрокаДолга.Долг);
	Возврат РезультатСценария("группы Опт, Розница, Цены, Клиенты, Справочники; View у семи ролей по матрице; "
		+ "«Опт» в четырёх опциях; налоговые отчёты вне раздела; просроченный долг " + Долг + ", "
		+ СтрокаДолга.ПросроченоДней + " дн., долг без просрочки не показан, но функция без ключа его отдаёт; "
		+ "вариант «Основной» сформирован");

КонецФункции

Процедура ПроверитьСоставРазделаПродаж(Продажи)

	Опт = Продажи.Подсистемы.Опт;
	ЗаявокВОпте = 0;
	Для Каждого Объект Из Опт.Состав Цикл
		Если Объект = Метаданные.Документы.ЗаявкаНаПоискТовара Тогда
			ЗаявокВОпте = ЗаявокВОпте + 1;
		КонецЕсли;
	КонецЦикла;
	ПроверитьРавенство(1, ЗаявокВОпте, "заявка на поиск товара в «Опте» один раз");
	Для Каждого ИмяОпции Из СтрРазделить("ИспользоватьКоммерческиеПредложения,ИспользоватьЗадачиЗаказов,"
		+ "ИспользоватьЗаявкиНаПоискТовара,ИспользоватьЛичныйКабинет", ",") Цикл
		Проверить(ВСоставеОпции(ИмяОпции, Опт), "группа «Опт» - в опции " + ИмяОпции);
	КонецЦикла;
	Проверить(ВСоставеОпции("ИспользоватьРозничныеПродажи", Продажи.Подсистемы.РозничныеПродажи),
		"группа «Розница» - в опции «Розничные продажи»");
	Проверить(ВСоставеОпции("ИспользоватьАльтернативныеОплаты", Метаданные.РегистрыНакопления.ОплатыЧеками),
		"оплаты чеками - в опции альтернативных оплат");

	МетаОтчеты = Метаданные.Отчеты;
	Для Каждого Налоговый Из СтрРазделить("РасчетыСПокупателями,ВедомостьПоПродажамНалоговая,ПроданныйТоварБезНакладной",
		",") Цикл
		Проверить(Не Продажи.Состав.Содержит(МетаОтчеты[Налоговый]), "налоговый отчёт " + Налоговый + " ушёл из «Продаж»");
	КонецЦикла;
	Проверить(Метаданные.Подсистемы.Бухгалтерия.Состав.Содержит(МетаОтчеты.ПроданныйТоварБезНакладной),
		"проданный товар без накладной - в «Бухгалтерии»");
	Проверить(Продажи.Состав.Содержит(МетаОтчеты.РеестрРеализацийТоваровУслуг), "реестр реализаций - в «Продажах»");
	Проверить(Не Метаданные.Подсистемы.Казначейство.Состав.Содержит(МетаОтчеты.РеестрРеализацийТоваровУслуг),
		"реестр реализаций ушёл из Казначейства");
	Проверить(Продажи.Состав.Содержит(МетаОтчеты.ПросроченныеДолгиПокупателей), "просроченные долги - в разделе");

КонецПроцедуры

Процедура ПроверитьПраваНаГруппыПродаж(Продажи)

	Группы = Продажи.Подсистемы;
	Право = "Просмотр";
	БезЦен = "Казначей,PDV,ОператорПроизводства";
	СРозницей = "Казначей,МенеджерПоЗакупкам,PDV";
	Для Каждого ИмяРоли Из СтрРазделить("Казначей,МенеджерПоПродажам,ОператорПроизводства,Оператор,Кладовщик,"
		+ "МенеджерПоЗакупкам,PDV", ",") Цикл
		Роль = Метаданные.Роли[ИмяРоли];
		Описание = "роль " + ИмяРоли;
		Для Каждого Группа Из СтрРазделить(",Опт,Клиенты,Справочники", ",") Цикл
			Подсистема = ?(ПустаяСтрока(Группа), Продажи, Группы[Группа]);
			Проверить(ПравоДоступа(Право, Подсистема, Роль), Описание + " видит " + Подсистема.ПолноеИмя());
		КонецЦикла;
		ЕстьЦены = СтрНайти("," + БезЦен + ",", "," + ИмяРоли + ",") = 0;
		ПроверитьРавенство(ЕстьЦены, ПравоДоступа(Право, Группы.Цены, Роль), Описание + " и группа «Цены»");
		ЕстьРозница = СтрНайти("," + СРозницей + ",", "," + ИмяРоли + ",") > 0;
		ПроверитьРавенство(ЕстьРозница, ПравоДоступа(Право, Группы.РозничныеПродажи, Роль), Описание + " и группа «Розница»");
	КонецЦикла;

КонецПроцедуры

// Раздел «Склад» (этап 4 menu-restructure, 2.0.16.9): группы раздела и их права у ролей, группы под опциями
// «Пересчёты» и «Комплектация», «Перевозчики» и штрихкоды на своих местах, «Стоимость склада» и «Ведомость по
// поступлениям» - в одном разделе; вариант «Отчет по списанию» отчёта «Движения товара» формируется (ссылался на
// поля «Склад» и «Товар» старого регистра) и показывает списанное количество по месту хранения.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийМенюСклада(Контекст)

	Склад = Метаданные.Подсистемы.Склад;
	Группы = Новый Массив;
	Для Каждого Группа Из Склад.Подсистемы Цикл
		Группы.Добавить(Группа.Имя);
	КонецЦикла;
	ПроверитьРавенство("Инвентаризация, ИзлишкиИСписания, Комплектация, Товары, Хранение", СтрСоединить(Группы, ", "),
		"группы раздела «Склад»");
	ПроверитьСоставРазделаСклада(Склад);
	ПроверитьПраваНаГруппыСклада(Склад);

	Числа = Контекст.Числа;
	// Вес единицы: колонка «Оборот (кг)» варианта - количество, умноженное на вес (до 2.0.16.9 - вес одной единицы).
	ВесЕдиницы = 2;
	Товар = Контекст.Товар.ПолучитьОбъект();
	Товар.ВесЗнаменатель = ВесЕдиницы;
	Товар.Записать();
	ПоступлениеСОтсрочкой(Контекст, 0);
	Списание = НовыйДокумент(Контекст, "СписаниеТоваров");
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	Списано = 3;
	ДобавитьСтрокуТоваров(Контекст, Списание, "ТЧТовары", Контекст.Товар, Списано, Числа.ЦенаЗакупки);
	Провести(Списание);

	Схема = Отчеты.ДвиженияТовара.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.ВариантыНастроек.Найти("ОтчетПоСписанию").Настройки);
	Настройки = Компоновщик.Настройки;
	Период = Новый СтандартныйПериод(НачалоДня(Контекст.Дата), КонецДня(ТекущаяДатаСеанса()));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Период);
	ОтборПоМестуХранения(Настройки, Контекст.Склад);

	// Вариант целиком, как его видит пользователь: таблица по периодам, строки - место хранения и номенклатура.
	ТабличныйДокумент = Новый ТабличныйДокумент;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(КомпоновщикМакета.Выполнить(Схема, Настройки));
	ВыводВДокумент = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ВыводВДокумент.УстановитьДокумент(ТабличныйДокумент);
	ВыводВДокумент.Вывести(Процессор);
	Проверить(ТабличныйДокумент.НайтиТекст(Строка(Контекст.Товар)) <> Неопределено,
		"товар в табличном документе варианта «Отчет по списанию»");

	// Числа: те же отборы варианта (показатель «Списано», место хранения), группировка по номенклатуре.
	Настройки.Структура.Очистить();
	Детали = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Для Каждого ИмяПоля Из СтрРазделить("Номенклатура,Количество,Сумма,ОборотКг", ",") Цикл
		Поле = Детали.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;
	ПолеГруппировки = Детали.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Номенклатура");
	ПолеГруппировки.Использование = Истина;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора));
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);

	СтрокаСписания = Результат.Найти(Контекст.Товар, "Номенклатура");
	Проверить(СтрокаСписания <> Неопределено, "товар в варианте «Отчет по списанию»");
	// Поступление того же товара на тот же склад в вариант не попадает: отбор по показателю «Списано».
	ПроверитьРавенство(-Списано, СтрокаСписания.Количество, "списанное количество (расход - со знаком минус)");
	ПроверитьРавенство(-Списано * Числа.ЦенаЗакупки, СтрокаСписания.Сумма, "себестоимость списанного");
	ПроверитьРавенство(-Списано * ВесЕдиницы, СтрокаСписания.ОборотКг, "оборот в килограммах: количество на вес единицы");

	Количество = СтрокаЧисла(-СтрокаСписания.Количество);
	Сумма = СтрокаЧисла(-СтрокаСписания.Сумма);
	Вес = СтрокаЧисла(-СтрокаСписания.ОборотКг);
	Возврат РезультатСценария("группы Инвентаризация, Излишки и списания, Комплектация, Товары, Хранение; View по "
		+ "матрице ролей, у Логиста - корень и «Хранение»; группы под опциями; «Отчет по списанию»: списано "
		+ Количество + " на " + Сумма + ", " + Вес + " кг, поступление не показано");

КонецФункции

Процедура ОтборПоМестуХранения(Настройки, МестоХранения)

	ПолеОтбора = Новый ПолеКомпоновкиДанных("МестоХранения");
	Для Каждого Элемент Из Настройки.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") И Элемент.ЛевоеЗначение = ПолеОтбора Тогда
			Элемент.ПравоеЗначение = МестоХранения;
			Элемент.Использование = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В варианте «Отчет по списанию» нет отбора по месту хранения";

КонецПроцедуры

Процедура ПроверитьСоставРазделаСклада(Склад)

	Группы = Склад.Подсистемы;
	Проверить(ВСоставеОпции("ИспользоватьПересчеты", Группы.Инвентаризация), "«Инвентаризация» - в опции «Пересчёты»");
	Проверить(ВСоставеОпции("ИспользоватьКомплектацию", Группы.Комплектация),
		"«Комплектация» - в опции «Комплектация»");
	Проверить(ВСоставеОпции("ИспользоватьУпаковку", Метаданные.Справочники.НаборыУпаковок),
		"наборы упаковок - в опции «Упаковка»");
	Проверить(Группы.Хранение.Состав.Содержит(Метаданные.Справочники.Контрагенты), "перевозчики - в «Хранении»");
	Проверить(Группы.Товары.Состав.Содержит(Метаданные.РегистрыСведений.ШтрихкодыНоменклатуры), "штрихкоды - в «Товарах»");
	Проверить(Склад.Состав.Содержит(Метаданные.Документы.ПеремещениеТоваров), "перемещения - в корне");
	МетаОтчеты = Метаданные.Отчеты;
	Проверить(Склад.Состав.Содержит(МетаОтчеты.ДвиженияТовара), "движения товара - в разделе");
	Проверить(Склад.Состав.Содержит(МетаОтчеты.СтоимостьСклада), "стоимость склада - в разделе");
	Проверить(Не Метаданные.Подсистемы.Бухгалтерия.Состав.Содержит(МетаОтчеты.СтоимостьСклада),
		"стоимость склада ушла из «Бухгалтерии»");
	Проверить(Не Склад.Состав.Содержит(МетаОтчеты.ВедомостьПоПоступлениям), "ведомость по поступлениям ушла из «Склада»");
	Проверить(Метаданные.Подсистемы.Закупки.Состав.Содержит(МетаОтчеты.ВедомостьПоПоступлениям),
		"ведомость по поступлениям - в «Закупках»");

КонецПроцедуры

Процедура ПроверитьПраваНаГруппыСклада(Склад)

