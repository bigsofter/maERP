// Документ допрасходов по поступлению до приёмки: распределяется по мере приёмки, неоформленная часть ждёт.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДокументПервыйДопрасходы(Контекст)

	// BSLLS:MagicNumber-off
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар допрасходов до приёмки", Перечисления.ТипыНоменклатуры.Товар);
	Поступление = ПоступлениеБезОрдера(Контекст, Склад, Товар, 10, 10);
	Первый = ОрдерПоДокументу(Контекст, "ПриходныйОрдер", Поступление.Ссылка, 6);
	Документ = НовыйДокумент(Контекст, "ПоступлениеДополнительныхРасходов");
	Документ.Заполнить(Поступление.Ссылка);
	Документ.Валюта = Контекст.Валюта;
	Документ.КурсВалюты = 1;
	Документ.СтавкаНДС = Контекст.СтавкаНДС;
	Документ.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.Себестоимость;
	Документ.ТЧТовары[0].СуммаТовара = 1;
	Документ.ТЧТовары[0].Сумма = 100;
	Документ.Сумма = 100;
	Провести(Документ);
	ПроверитьРавенство(60, ДопрасходыПоПартии(Первый), "допрасход до полной приёмки - на принятую часть 6/10");
	Второй = ОрдерПоДокументу(Контекст, "ПриходныйОрдер", Поступление.Ссылка, Неопределено);
	Документ = Документ.Ссылка.ПолучитьОбъект();
	Провести(Документ);
	ПроверитьРавенство(40, ДопрасходыПоПартии(Второй), "после второй приёмки перепроведение - остаток на второй ордер");
	ПроверитьРавенство(60, ДопрасходыПоПартии(Первый), "доля первой приёмки не изменилась");
	// BSLLS:MagicNumber-on
	Возврат РезультатСценария("допрасход по поступлению до приёмки - по мере приёмки, остаток ждёт ордера");

