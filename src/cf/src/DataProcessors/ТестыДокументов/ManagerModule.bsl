	Попытка
		Константы.ИспользоватьОрдерныеСклады.Установить(Ложь);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "выключение опции при ордерном складе - отказ");
	Проверить(ЕстьСообщениеОтказа(ФрагментыОтказаОпцииОрдерныхСкладов()), "отказ выключения - с текстом про опцию");
