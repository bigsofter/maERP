Функция НовыйДоговор(Контекст, ВидДоговора)

	Договор = Справочники.ДоговорыСКонтрагентами.СоздатьЭлемент();
	// У договоров наименования нет (длина 0), текст договора - в реквизите Описание.
	Договор.Описание = ПометкаТеста() + ": " + Строка(ВидДоговора);
	Договор.Контрагент = Контекст.Контрагент;
	Договор.Организация = Контекст.Организация;
	Договор.ВидДоговора = ВидДоговора;
	Договор.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
	// BSLLS:YoLetterUsage-off
	Договор.ВалютаВзаиморасчётов = Контекст.Валюта;
	// BSLLS:YoLetterUsage-on
	Договор.ДатаДоговора = НачалоДня(Контекст.Дата);
	Договор.Основной = Истина;
	Договор.Записать();
	Возврат Договор.Ссылка;

