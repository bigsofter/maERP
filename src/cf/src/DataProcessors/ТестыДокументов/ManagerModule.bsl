////////////////////////////////////////////////////////////////////////////////
// Серверная часть автотестов уровня 3: жизненный цикл документов.
// Каждый сценарий сам заводит нужные ему данные (контрагент, склад, номенклатура,
// касса, счёт), создаёт, записывает и проводит документы и сверяет движения по
// регистрам. Сценарий выполняется в транзакции, которая всегда откатывается -
// после прогона база не меняется, поэтому его можно гонять и на копии базы клиента.
// Модуль формы обработки только запускает прогон и пишет отчёт.
// Регламент, состав сценариев и разбор ошибок - docs/TESTING.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Имена сценариев прогона в порядке выполнения. Новый документооборот - новый
// сценарий: имя сюда, ветка в СценарийПоИмени, описание в docs/TESTING.md и docs/TESTS.xlsx.
//
// Возвращаемое значение:
//  Массив из Строка - имена сценариев
//
Функция ИменаСценариев() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Закупка");
	Имена.Добавить("Продажа");
	Имена.Добавить("ВозвратОтПокупателя");
	Имена.Добавить("ВыпускПродукции");
	Имена.Добавить("Переработка");
	Имена.Добавить("Зарплата");
	Имена.Добавить("БезналичныеДеньги");
	Имена.Добавить("ДополнительныеРеквизиты");
	Имена.Добавить("Отрасль");
	Имена.Добавить("НастройкиПрограммы");
	Имена.Добавить("ТехнологическиеКарты");
	Имена.Добавить("ПереносТехнологическихКарт");
	Имена.Добавить("СебестоимостьТехкарт");
	Имена.Добавить("ДатыТехкарты");
	Имена.Добавить("ПоказателиТехкарты");
	Имена.Добавить("СпособыПополненияЗапасов");
	Имена.Добавить("КоммерческоеПредложение");
	Имена.Добавить("ВидОперацииЗаказа");
	Имена.Добавить("МатериалыЗаказа");
	Имена.Добавить("ПроведениеЗаказа");
	Имена.Добавить("ПотребностиПроизводства");
	Имена.Добавить("СтадииЗаказа");
	Имена.Добавить("АвтовыпускПриОтгрузке");
	Имена.Добавить("РучнойВыпуск");
	Имена.Добавить("СебестоимостьПродукции");
	Имена.Добавить("ДемоНабор");
	Имена.Добавить("АвторВОтветственного");
	Имена.Добавить("АРМПроизводство");
	Имена.Добавить("АРМЗакупки");
	Имена.Добавить("АРМВыпускОтгрузка");
	Имена.Добавить("АРМПереработка");
	Возврат Имена;

КонецФункции

// Выполняет все сценарии, каждый в своей транзакции с откатом.
//
// Возвращаемое значение:
//  Структура - итог прогона:
//   * Строки    - Массив из Строка - строки отчёта видов ОК, ОШИБКА, ПРОПУСК
//   * Сценариев - Число           - сколько сценариев выполнялось
//   * Ошибок    - Число           - сколько из них упало
//   * Пропущено - Число           - сколько пропущено (нет условий для проверки)
//
Функция ВыполнитьСценарии() Экспорт

	Итог = Новый Структура;
	Итог.Вставить("Строки", Новый Массив);
	Итог.Вставить("Сценариев", 0);
	Итог.Вставить("Ошибок", 0);
	Итог.Вставить("Пропущено", 0);

	Для Каждого Имя Из ИменаСценариев() Цикл
		ВыполнитьСценарий(Имя, Итог);
	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Прогон

// Один сценарий в транзакции. Откат делается в обеих ветках: сценарий проверяет
// поведение, а не оставляет данные, и после исключения внутри вложенной записи
// транзакция всё равно годится только для отката.
//
// Параметры:
//  Имя  - Строка    - имя сценария из ИменаСценариев
//  Итог - Структура - см. ВыполнитьСценарии
//
Процедура ВыполнитьСценарий(Имя, Итог)

	Итог.Сценариев = Итог.Сценариев + 1;
	// Чужие сообщения в очереди не должны попасть в описание ошибки сценария.
	ПолучитьСообщенияПользователю(Истина);

	// Фиксации нет намеренно: данные сценария живут только внутри его транзакции.
	// BSLLS:PairingBrokenTransaction-off
	// BSLLS:WrongUseOfRollbackTransactionMethod-off
	НачатьТранзакцию();
	Попытка
		Результат = СценарийПоИмени(Имя);
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		// BSLLS:WrongUseOfRollbackTransactionMethod-on
		// BSLLS:PairingBrokenTransaction-on
		Информация = ИнформацияОбОшибке();
		Итог.Строки.Добавить("ОШИБКА;" + Имя + ";" + ОшибкаОднойСтрокой(Информация) + СообщенияПользователю());
		Итог.Ошибок = Итог.Ошибок + 1;
		Возврат;
	КонецПопытки;

	Если Результат.Пропуск Тогда
		Итог.Строки.Добавить("ПРОПУСК;" + Имя + ";" + Результат.Текст);
		Итог.Пропущено = Итог.Пропущено + 1;
	Иначе
		Итог.Строки.Добавить("ОК;" + Имя + ";" + Результат.Текст);
	КонецЕсли;

КонецПроцедуры

// Диспетчер сценариев: имя - ветка. Контекст с данными заводится заново для каждого
// сценария внутри его транзакции.
//
// Параметры:
//  Имя - Строка - имя сценария
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
// BSLLS:CognitiveComplexity-off - линейный диспетчер сценариев, ветви независимы.
// BSLLS:CyclomaticComplexity-off - та же причина: ветка на сценарий.
Функция СценарийПоИмени(Имя)

	Контекст = НовыйКонтекст();

	Если Имя = "Закупка" Тогда
		Возврат СценарийЗакупка(Контекст);
	КонецЕсли;
	Если Имя = "Продажа" Тогда
		Возврат СценарийПродажа(Контекст);
	КонецЕсли;
	Если Имя = "ВозвратОтПокупателя" Тогда
		Возврат СценарийВозвратОтПокупателя(Контекст);
	КонецЕсли;
	Если Имя = "ВыпускПродукции" Тогда
		Возврат СценарийВыпускПродукции(Контекст);
	КонецЕсли;
	Если Имя = "Переработка" Тогда
		Возврат СценарийПереработка(Контекст);
	КонецЕсли;
	Если Имя = "Зарплата" Тогда
		Возврат СценарийЗарплата(Контекст);
	КонецЕсли;
	Если Имя = "БезналичныеДеньги" Тогда
		Возврат СценарийБезналичныеДеньги(Контекст);
	КонецЕсли;
	Если Имя = "ДополнительныеРеквизиты" Тогда
		Возврат СценарийДополнительныеРеквизиты(Контекст);
	КонецЕсли;
	Если Имя = "Отрасль" Тогда
		Возврат СценарийОтрасль();
	КонецЕсли;
	Если Имя = "НастройкиПрограммы" Тогда
		Возврат СценарийНастройкиПрограммы();
	КонецЕсли;
	Если Имя = "ТехнологическиеКарты" Тогда
		Возврат СценарийТехнологическиеКарты(Контекст);
	КонецЕсли;
	Если Имя = "ПереносТехнологическихКарт" Тогда
		Возврат СценарийПереносТехнологическихКарт(Контекст);
	КонецЕсли;
	Если Имя = "СебестоимостьТехкарт" Тогда
		Возврат СценарийСебестоимостьТехкарт(Контекст);
	КонецЕсли;
	Если Имя = "ДатыТехкарты" Тогда
		Возврат СценарийДатыТехкарты(Контекст);
	КонецЕсли;
	Если Имя = "ПоказателиТехкарты" Тогда
		Возврат СценарийПоказателиТехкарты(Контекст);
	КонецЕсли;
	Если Имя = "СпособыПополненияЗапасов" Тогда
		Возврат СценарийСпособыПополненияЗапасов(Контекст);
	КонецЕсли;
	Если Имя = "КоммерческоеПредложение" Тогда
		Возврат СценарийКоммерческоеПредложение(Контекст);
	КонецЕсли;
	Если Имя = "ВидОперацииЗаказа" Тогда
		Возврат СценарийВидОперацииЗаказа(Контекст);
	КонецЕсли;
	Если Имя = "МатериалыЗаказа" Тогда
		Возврат СценарийМатериалыЗаказа(Контекст);
	КонецЕсли;
	Если Имя = "ПроведениеЗаказа" Тогда
		Возврат СценарийПроведениеЗаказа(Контекст);
	КонецЕсли;
	Если Имя = "ПотребностиПроизводства" Тогда
		Возврат СценарийПотребностиПроизводства(Контекст);
	КонецЕсли;
	Если Имя = "СтадииЗаказа" Тогда
		Возврат СценарийСтадииЗаказа(Контекст);
	КонецЕсли;
	Если Имя = "АвтовыпускПриОтгрузке" Тогда
		Возврат СценарийАвтовыпускПриОтгрузке(Контекст);
	КонецЕсли;
	Если Имя = "РучнойВыпуск" Тогда
		Возврат СценарийРучнойВыпуск(Контекст);
	КонецЕсли;
	Если Имя = "СебестоимостьПродукции" Тогда
		Возврат СценарийСебестоимостьПродукции(Контекст);
	КонецЕсли;
	Если Имя = "ДемоНабор" Тогда
		Возврат СценарийДемоНабор(Контекст);
	КонецЕсли;
	Если Имя = "АвторВОтветственного" Тогда
		Возврат СценарийАвторВОтветственного(Контекст);
	КонецЕсли;
	Если Имя = "АРМПроизводство" Тогда
		Возврат СценарийАРМПроизводство(Контекст);
	КонецЕсли;
	Если Имя = "АРМЗакупки" Тогда
		Возврат СценарийАРМЗакупки(Контекст);
	КонецЕсли;
	Если Имя = "АРМВыпускОтгрузка" Тогда
		Возврат СценарийАРМВыпускОтгрузка(Контекст);
	КонецЕсли;
	Если Имя = "АРМПереработка" Тогда
		Возврат СценарийАРМПереработка(Контекст);
	КонецЕсли;

	ВызватьИсключение "Сценарий " + Имя + " не описан в СценарийПоИмени";

КонецФункции
// BSLLS:CognitiveComplexity-on
// BSLLS:CyclomaticComplexity-on

// Результат сценария для отчёта.
//
// Параметры:
//  Текст   - Строка - что проверено (ОК) или почему пропущено (ПРОПУСК)
//  Пропуск - Булево - сценарий пропущен: в базе нет условий для проверки
//
// Возвращаемое значение:
//  Структура - Текст, Пропуск
//
Функция РезультатСценария(Текст, Пропуск = Ложь)

	Возврат Новый Структура("Текст, Пропуск", Текст, Пропуск);

КонецФункции

#КонецОбласти

#Область Сценарии

// Закупка: поступление товара даёт остаток на складе и долг перед поставщиком.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийЗакупка(Контекст)

	Числа = Контекст.Числа;
	Поступление = ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	СуммаЗакупки = Числа.КоличествоЗакупки * Числа.ЦенаЗакупки;

	Остаток = ОстатокТовара(Контекст.Склад, Контекст.Товар);
	ПроверитьРавенство(Числа.КоличествоЗакупки, Остаток.Количество, "остаток товара после закупки");
	ПроверитьРавенство(СуммаЗакупки, Остаток.Сумма, "себестоимость остатка после закупки");
	ПроверитьДолгПоставщику(Поступление, СуммаЗакупки, "долг поставщику по поступлению");

	Текст = "остаток " + СтрокаЧисла(Остаток.Количество) + " на " + СтрокаЧисла(Остаток.Сумма)
		+ "; долг поставщику " + СтрокаЧисла(СуммаЗакупки);
	Возврат РезультатСценария(Текст);

КонецФункции

// Продажа: заказ покупателя, реализация по заказу, оплата в кассу. Проверяются остаток,
// регистр продаж (выручка и себестоимость) и закрытие долга покупателя.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПродажа(Контекст)

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);

	Заказ = ДокументЗаказаПокупателя(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);
	Реализация = ДокументРеализацииПоЗаказу(Контекст, Заказ);
	СуммаПродажи = Числа.КоличествоПродажи * Числа.ЦенаПродажи;
	Себестоимость = Числа.КоличествоПродажи * Числа.ЦенаЗакупки;

	ПроверитьРавенство(Заказ, Реализация.Основание, "основание реализации");
	ПроверитьРавенство(СуммаПродажи, Реализация.Сумма, "сумма реализации");

	Остаток = ОстатокТовара(Контекст.Склад, Контекст.Товар);
	ПроверитьРавенство(Числа.КоличествоЗакупки - Числа.КоличествоПродажи, Остаток.Количество, "остаток товара после продажи");

	Продажи = ОборотыПродаж(Реализация);
	ПроверитьРавенство(Числа.КоличествоПродажи, Продажи.Количество, "количество в регистре продаж");
	ПроверитьРавенство(СуммаПродажи, Продажи.Выручка, "выручка в регистре продаж");
	ПроверитьРавенство(Себестоимость, Продажи.Себестоимость, "себестоимость в регистре продаж");
	ПроверитьДолгПокупателя(Реализация, СуммаПродажи, "долг покупателя по реализации");

	Оплата = ДокументОплатыВКассу(Контекст, Реализация, СуммаПродажи);
	ПроверитьДолгПокупателя(Реализация, 0, "долг покупателя после оплаты");
	ПроверитьРавенство(СуммаПродажи, ОстатокДенег(Контекст.Касса), "деньги в кассе после оплаты");

	Текст = "остаток " + СтрокаЧисла(Остаток.Количество) + "; выручка "
		+ СтрокаЧисла(Продажи.Выручка) + ", себестоимость " + СтрокаЧисла(Продажи.Себестоимость)
		+ "; долг закрыт " + ПредставлениеДокумента(Оплата);
	Возврат РезультатСценария(Текст);

КонецФункции

// Возврат от покупателя по реализации: товар возвращается на склад той же партией,
// продажи сторнируются, долг покупателя гасится.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВозвратОтПокупателя(Контекст)

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	Реализация = ДокументРеализации(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);

	ДокВозврата = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	ДокВозврата.Заполнить(Реализация);
	ДокВозврата.Дата = СледующаяДата(Контекст);
	ДокВозврата.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	Провести(ДокВозврата);

	КоличествоВозврата = ДокВозврата.ТЧТовары.Итог("Количество");
	ПроверитьРавенство(Числа.КоличествоПродажи, КоличествоВозврата, "количество в возврате по реализации");

	Остаток = ОстатокТовара(Контекст.Склад, Контекст.Товар);
	ПроверитьРавенство(Числа.КоличествоЗакупки, Остаток.Количество, "остаток товара после возврата");
	ПроверитьРавенство(Числа.КоличествоЗакупки * Числа.ЦенаЗакупки, Остаток.Сумма, "себестоимость остатка после возврата");

	Продажи = ОборотыПродаж(Реализация);
	ПроверитьРавенство(0, Продажи.Количество, "количество продаж после возврата");
	ПроверитьРавенство(0, Продажи.Выручка, "выручка после возврата");
	ПроверитьДолгПокупателя(Реализация, 0, "долг покупателя после возврата");

	Текст = "товар вернулся на склад (" + СтрокаЧисла(Остаток.Количество)
		+ "), продажи сторнированы, долг покупателя закрыт";
	Возврат РезультатСценария(Текст);

КонецФункции

// Выпуск продукции по технологической карте: сырьё списывается, продукция приходуется
// по себестоимости сырья. Работает под функциональной опцией «Производство».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВыпускПродукции(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Сырье, Числа.КоличествоСырья, Числа.ЦенаСырья);

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Номенклатура = Контекст.Продукция;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = Числа.КоличествоВыпуска;
	Выпуск.Количество = Числа.КоличествоВыпуска;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ЗаполнитьСырьеПоТехкарте(Контекст, Выпуск, Числа.КоличествоВыпуска);
	Провести(Выпуск);

	РасходСырья = Числа.РасходСырьяНаЕдиницу * Числа.КоличествоВыпуска;
	Себестоимость = РасходСырья * Числа.ЦенаСырья;

	ПроверитьРавенство(1, Выпуск.ТЧГотоваяПродукция.Количество(), "строк готовой продукции в выпуске");
	ОстатокСырья = ОстатокТовара(Контекст.Склад, Контекст.Сырье);
	ПроверитьРавенство(Числа.КоличествоСырья - РасходСырья, ОстатокСырья.Количество, "остаток сырья после выпуска");
	ОстатокПродукции = ОстатокТовара(Контекст.Склад, Контекст.Продукция);
	ПроверитьРавенство(Числа.КоличествоВыпуска, ОстатокПродукции.Количество, "остаток продукции после выпуска");
	ПроверитьРавенство(Себестоимость, ОстатокПродукции.Сумма, "себестоимость продукции после выпуска");

	Текст = "списано сырья " + СтрокаЧисла(РасходСырья) + ", продукции "
		+ СтрокаЧисла(ОстатокПродукции.Количество) + " на " + СтрокаЧисла(ОстатокПродукции.Сумма);
	Возврат РезультатСценария(Текст);

КонецФункции

// Переработка: передача сырья переработчику и поступление продукции. Сырьё уходит со
// склада к переработчику, возвращается продукцией с себестоимостью сырья и услуг,
// стоимость услуг становится долгом перед переработчиком.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПереработка(Контекст)

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Сырье, Числа.КоличествоСырья, Числа.ЦенаСырья);
	РасходСырья = Числа.РасходСырьяНаЕдиницу * Числа.КоличествоВыпуска;
	СебестоимостьСырья = РасходСырья * Числа.ЦенаСырья;

	Передача = НовыйДокумент(Контекст, "ПередачаВПереработку");
	Передача.Контрагент = Контекст.Контрагент;
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Контекст.Сырье, РасходСырья, 0);
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧГотоваяПродукция", Контекст.Продукция, Числа.КоличествоВыпуска, 0);
	Провести(Передача);

	ОстатокСырья = ОстатокТовара(Контекст.Склад, Контекст.Сырье);
	ПроверитьРавенство(Числа.КоличествоСырья - РасходСырья, ОстатокСырья.Количество, "остаток сырья после передачи");
	ВПереработке = ОстатокВПереработке(Контекст.Контрагент, Контекст.Сырье);
	ПроверитьРавенство(РасходСырья, ВПереработке.Количество, "сырьё у переработчика после передачи");
	ПроверитьРавенство(СебестоимостьСырья, ВПереработке.Сумма, "себестоимость сырья у переработчика");

	Поступление = НовыйДокумент(Контекст, "ПоступлениеИзПереработки");
	Поступление.Заполнить(Передача.Ссылка);
	Поступление.Дата = СледующаяДата(Контекст);
	Поступление.Комментарий = ПометкаТеста();
	Поступление.СтоимостьУслуг = Числа.СтоимостьУслугПереработки;
	Поступление.СтавкаНДСУслуг = Контекст.СтавкаНДС;
	Поступление.СуммаНДСУслуг = 0;
	Провести(Поступление);

	ПроверитьРавенство(РасходСырья, Поступление.ТЧТовары.Итог("Количество"), "сырьё в поступлении по передаче");
	ВПереработке = ОстатокВПереработке(Контекст.Контрагент, Контекст.Сырье);
	ПроверитьРавенство(0, ВПереработке.Количество, "сырьё у переработчика после поступления");
	ОстатокПродукции = ОстатокТовара(Контекст.Склад, Контекст.Продукция);
	ПроверитьРавенство(Числа.КоличествоВыпуска, ОстатокПродукции.Количество, "остаток продукции после переработки");
	ПроверитьРавенство(СебестоимостьСырья + Числа.СтоимостьУслугПереработки, ОстатокПродукции.Сумма,
		"себестоимость продукции с услугами переработчика");
	ПроверитьДолгПоставщику(Поступление.Ссылка, Числа.СтоимостьУслугПереработки, "долг переработчику за услуги");

	Текст = "сырьё " + СтрокаЧисла(РасходСырья) + " ушло и вернулось продукцией "
		+ СтрокаЧисла(ОстатокПродукции.Количество) + " на " + СтрокаЧисла(ОстатокПродукции.Сумма)
		+ "; долг переработчику " + СтрокаЧисла(Числа.СтоимостьУслугПереработки);
	Возврат РезультатСценария(Текст);

КонецФункции

// Зарплата: начисление даёт остаток по сотруднику, ведомость на выплату заполняется по
// начислению, расходный ордер по ведомости закрывает остаток и списывает деньги из кассы.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийЗарплата(Контекст)

	ДатаНачала = Константы.ДатаНачалаРасчетаЗарплаты.Получить();
	Если Контекст.Дата < ДатаНачала Тогда
		Текст = "дата начала расчёта зарплаты " + Формат(ДатаНачала, "ДЛФ=D")
			+ " позже даты теста - движений по зарплате не будет";
		Возврат РезультатСценария(Текст, Истина);
	КонецЕсли;

	Оклад = Контекст.Числа.Оклад;
	Начисление = НовыйДокумент(Контекст, "НачислениеЗарплаты");
	Строка = Начисление.ТЧСотрудники.Добавить();
	Строка.Сотрудник = Контекст.Сотрудник;
	Строка.Оклад = Оклад;
	Строка.Сумма = Оклад;
	Начисление.Сумма = Оклад;
	Провести(Начисление);
	ПроверитьРавенство(Оклад, ОстатокЗарплаты(Контекст.Сотрудник), "остаток по сотруднику после начисления");

	Выплата = НовыйДокумент(Контекст, "ВыплатаЗарплаты");
	Выплата.Заполнить(Начисление.Ссылка);
	Выплата.Дата = СледующаяДата(Контекст);
	ПроверитьРавенство(Оклад, Выплата.ТЧСотрудники.Итог("Сумма"), "сумма ведомости по начислению");
	Провести(Выплата);

	Ордер = НовыйДокумент(Контекст, "РасходныйКассовыйОрдер");
	Ордер.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплаты;
	Ордер.Основание = Выплата.Ссылка;
	Ордер.Контрагент = Контекст.Сотрудник;
	Ордер.Касса = Контекст.Касса;
	Ордер.ТипОплаты = Справочники.TypesDePayment.Cash;
	Ордер.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ВыплатаЗарплаты;
	Ордер.Сумма = Оклад;
	Провести(Ордер);

	ПроверитьРавенство(0, ОстатокЗарплаты(Контекст.Сотрудник), "остаток по сотруднику после выплаты");
	ПроверитьРавенство(-Оклад, ОстатокДенег(Контекст.Касса), "деньги в кассе после выплаты");

	Текст = "начислено и выплачено " + СтрокаЧисла(Оклад) + ", остаток по сотруднику 0";
	Возврат РезультатСценария(Текст);

КонецФункции

// Безналичные деньги: поступление от покупателя закрывает долг по реализации, списание
// поставщику закрывает долг по поступлению; остаток на счёте - разница.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийБезналичныеДеньги(Контекст)

	Числа = Контекст.Числа;
	Закупка = ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	СуммаЗакупки = Числа.КоличествоЗакупки * Числа.ЦенаЗакупки;
	Реализация = ДокументРеализации(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);
	СуммаПродажи = Числа.КоличествоПродажи * Числа.ЦенаПродажи;

	Поступление = НовыйДокумент(Контекст, "ПоступлениеБезналичныхДенежныхСредств");
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	Поступление.Контрагент = Контекст.Контрагент;
	Поступление.Договор = Контекст.ДоговорПокупателя;
	// BSLLS:YoLetterUsage-off
	Поступление.БанковскийСчёт = Контекст.Счет;
	// BSLLS:YoLetterUsage-on
	Поступление.ТипОплаты = Справочники.TypesDePayment.VirementBanquaire;
	Поступление.СтатьяДДС = СтатьяДДС(Контекст, Поступление.ХозяйственнаяОперация);
	Поступление.Сумма = СуммаПродажи;
	ДобавитьОснование(Поступление, Реализация, СуммаПродажи);
	Провести(Поступление);

	ПроверитьДолгПокупателя(Реализация, 0, "долг покупателя после безналичной оплаты");
	ПроверитьРавенство(СуммаПродажи, ОстатокДенег(Контекст.Счет), "деньги на счёте после поступления");

	Списание = НовыйДокумент(Контекст, "СписаниеБезналичныхДенежныхСредств");
	Списание.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	Списание.Контрагент = Контекст.Контрагент;
	Списание.Договор = Контекст.ДоговорПоставщика;
	// BSLLS:YoLetterUsage-off
	Списание.БанковскийСчёт = Контекст.Счет;
	// BSLLS:YoLetterUsage-on
	Списание.ТипОплаты = Справочники.TypesDePayment.VirementBanquaire;
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Списание.ХозяйственнаяОперация);
	Списание.Валюта = Контекст.Валюта;
	Списание.Сумма = СуммаЗакупки;
	Списание.СуммаВВалютеРеглУчета = СуммаЗакупки;
	ДобавитьОснование(Списание, Закупка, СуммаЗакупки);
	Провести(Списание);

	ПроверитьДолгПоставщику(Закупка, 0, "долг поставщику после безналичной оплаты");
	ПроверитьРавенство(СуммаПродажи - СуммаЗакупки, ОстатокДенег(Контекст.Счет), "деньги на счёте после списания");

	Текст = "получено " + СтрокаЧисла(СуммаПродажи) + ", уплачено " + СтрокаЧисла(СуммаЗакупки)
		+ ", оба долга закрыты, на счёте " + СтрокаЧисла(СуммаПродажи - СуммаЗакупки);
	Возврат РезультатСценария(Текст);

КонецФункции

// Дополнительные реквизиты (УправлениеСвойствами): реквизит и сведение заводятся
// идемпотентно, значение реквизита живёт в табличной части объекта, сведения - в регистре,
// оба читаются по имени.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДополнительныеРеквизиты(Контекст)

	ИмяОбъекта = "Справочник.Номенклатура";
	ИмяРеквизита = "ТестУровня3";
	ИмяСведения = "ТестУровня3Сведение";

	Параметры = УправлениеСвойствами.ПараметрыДобавленияСвойства();
	Параметры.ИмяОбъекта = ИмяОбъекта;
	Параметры.Имя = ИмяРеквизита;
	Параметры.Наименование = ПометкаТеста();
	Параметры.ТипЗначения = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(ДлинаСтроковогоРеквизита()));
	Параметры.Заголовки.Вставить("fr", "Test niveau 3");
	Реквизит = УправлениеСвойствами.ДобавитьСвойство(Параметры);
	Проверить(ЗначениеЗаполнено(Реквизит), "дополнительный реквизит не создан");
	Повтор = УправлениеСвойствами.ДобавитьСвойство(Параметры);
	ПроверитьРавенство(Реквизит, Повтор, "повторное добавление реквизита");
	Найденный = УправлениеСвойствами.НайтиСвойство(ИмяОбъекта, ИмяРеквизита);
	ПроверитьРавенство(Реквизит, Найденный, "поиск реквизита по имени");

	Параметры.Имя = ИмяСведения;
	Параметры.ЭтоСведение = Истина;
	Параметры.ТипЗначения = Новый ОписаниеТипов("Число");
	Сведение = УправлениеСвойствами.ДобавитьСвойство(Параметры);
	Проверить(ЗначениеЗаполнено(Сведение) И Сведение <> Реквизит, "дополнительное сведение не создано");

	ЗначениеРеквизита = "Значение уровня 3";
	ЗначениеСведения = Контекст.Числа.ЦенаПродажи;

	Товар = Контекст.Товар.ПолучитьОбъект();
	Строка = Товар.ДополнительныеРеквизиты.Добавить();
	Строка.Свойство = Реквизит;
	Строка.Значение = ЗначениеРеквизита;
	Товар.Записать();

	Запись = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	Запись.Объект = Контекст.Товар;
	Запись.Свойство = Сведение;
	Запись.Значение = ЗначениеСведения;
	Запись.Записать();

	Прочитано = УправлениеСвойствами.ЗначениеСвойства(Контекст.Товар, ИмяРеквизита);
	ПроверитьРавенство(ЗначениеРеквизита, Прочитано, "значение реквизита из табличной части");
	Прочитано = УправлениеСвойствами.ЗначениеСвойства(Контекст.Товар, ИмяСведения);
	ПроверитьРавенство(ЗначениеСведения, Прочитано, "значение сведения из регистра");
	Прочитано = УправлениеСвойствами.ЗначениеСвойства(Контекст.Товар, "НетТакогоРеквизита");
	ПроверитьРавенство(Неопределено, Прочитано, "значение несуществующего реквизита");

	Возврат РезультатСценария("реквизит и сведение заведены идемпотентно, значения читаются по имени");

КонецФункции

// Отрасль: применение «Строительства» ставит константу и заводит реквизиты объекта
// недвижимости у номенклатуры, повтор ничего не создаёт, другая отрасль реквизитов не добавляет.
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОтрасль()

	ИмяОбъекта = "Справочник.Номенклатура";
	Имена = ИменаРеквизитовСтроительства();

	Было = 0;
	Для Каждого Имя Из Имена Цикл
		Если ЗначениеЗаполнено(УправлениеСвойствами.НайтиСвойство(ИмяОбъекта, Имя)) Тогда
			Было = Было + 1;
		КонецЕсли;
	КонецЦикла;

	// Модуль привилегированный: отрасль ставится от имени администратора при первом запуске,
	// тест проверяет тот же метод в своей транзакции.
	// BSLLS:PrivilegedModuleMethodCall-off
	Строительство = Перечисления.Отрасли.Строительство;
	Создано = НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(Строительство);
	ПроверитьРавенство(Имена.Количество() - Было, Создано, "создано реквизитов строительства");
	Отрасль = Константы.Отрасль.Получить();
	ПроверитьРавенство(Строительство, Отрасль, "константа Отрасль");
	Для Каждого Имя Из Имена Цикл
		Свойство = УправлениеСвойствами.НайтиСвойство(ИмяОбъекта, Имя);
		Проверить(ЗначениеЗаполнено(Свойство), "после применения отрасли нет реквизита " + Имя);
	КонецЦикла;

	Повтор = НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(Строительство);
	ПроверитьРавенство(0, Повтор, "создано реквизитов при повторном применении");

	Торговля = Перечисления.Отрасли.Торговля;
	СозданоДляТорговли = НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(Торговля);
	ПроверитьРавенство(0, СозданоДляТорговли, "создано реквизитов для торговли");
	// BSLLS:PrivilegedModuleMethodCall-on
	Отрасль = Константы.Отрасль.Получить();
	ПроверитьРавенство(Торговля, Отрасль, "константа Отрасль после торговли");

	Текст = "строительство: создано " + СтрокаЧисла(Создано) + " из " + СтрокаЧисла(Имена.Количество())
		+ " реквизитов, повтор 0; торговля: 0";
	Возврат РезультатСценария(Текст);

КонецФункции

// Панель настроек: запись константы модулем менеджера, признак расположения ФО,
// имя константы по пути данных, список часовых поясов, заголовок окна.
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийНастройкиПрограммы()

	Новое = ПометкаТеста();
	ЭтоОпция = Обработки.НастройкиПрограммы.ЗаписатьКонстанту("ЗаголовокСистемы", Новое);
	ПроверитьРавенство(Ложь, ЭтоОпция, "ЗаголовокСистемы как расположение функциональной опции");
	Записано = Константы.ЗаголовокСистемы.Получить();
	ПроверитьРавенство(Новое, Записано, "значение константы после записи");

	ЭтоОпция = Обработки.НастройкиПрограммы.ЭтоРасположениеФункциональнойОпции("Бухгалтерия");
	ПроверитьРавенство(Истина, ЭтоОпция, "Бухгалтерия как расположение функциональной опции");

	ИмяКонстанты = Обработки.НастройкиПрограммы.ИмяКонстантыПоПутиДанных("НаборКонстант.ЗаголовокСистемы");
	ПроверитьРавенство("ЗаголовокСистемы", ИмяКонстанты, "имя константы по пути данных");

	Варианты = Обработки.НастройкиПрограммы.ВариантыЧасовыхПоясов();
	Проверить(Варианты.Количество() > 0, "список часовых поясов пуст");
	Текущий = Обработки.НастройкиПрограммы.ТекущийЧасовойПояс();
	Проверить(Варианты.НайтиПоЗначению(Текущий) <> Неопределено, "текущий часовой пояс " + Текущий + " не в списке");

	Заголовок = Обработки.НастройкиПрограммы.ЗаголовокОкнаПрограммы();
	Проверить(СтрНайти(Заголовок, Новое) > 0, "заголовок окна не содержит заголовок системы");

	Текст = "константа записана и прочитана, признак ФО верен, часовых поясов " + СтрокаЧисла(Варианты.Количество())
		+ ", текущий " + Текущий;
	Возврат РезультатСценария(Текст);

КонецФункции

// Имена дополнительных реквизитов номенклатуры, которые заводит отрасль «Строительство»
// (НачальноеЗаполнениеВызовСервера.ОтраслевыеРеквизитыСтроительства).
//
// Возвращаемое значение:
//  Массив из Строка - имена реквизитов
//
Функция ИменаРеквизитовСтроительства()

	Имена = Новый Массив;
	Имена.Добавить("ОбъектНедвижимости");
	Имена.Добавить("Этаж");
	Имена.Добавить("Площадь");
	Имена.Добавить("НомерПраваСобственности");
	Возврат Имена;

КонецФункции

#КонецОбласти

#Область ТехнологическиеКарты

// Числа здесь - независимые входные данные и ожидаемые результаты сценариев.
// BSLLS:MagicNumber-off

// История рецептуры: удалённые материалы не возвращаются из прежних версий.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТехнологическиеКарты(Контекст)

	Продукция = НоваяНоменклатура(Контекст, "история карты", Перечисления.ТипыНоменклатуры.Продукция);
	ДатаПервой = Дата(2020, 1, 1);
	ДатаВторой = Дата(2020, 1, 2);
	ДатаОтмены = Дата(2020, 1, 3);
	Состав = СоставКарты(Контекст);
	Строка = Состав.Добавить();
	Строка.Номенклатура = Контекст.Товар;
	Строка.Упаковка = Контекст.Единица;
	Строка.Количество = 3;
	Первая = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ДатаПервой);
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаПервой - 1).Количество(),
		"до первой версии карты нет");
	ПроверитьРавенство(2, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаПервой).Количество(),
		"первая версия содержит оба материала");
	Состав.Сортировать("Номенклатура Убыв");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Первая, Состав), "перестановка строк не меняет состав");

	Состав = СоставКарты(Контекст);
	Состав[0].Количество = 4;
	Вторая = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ДатаВторой);
	Проверить(Первая <> Вторая, "другой день создаёт новую версию");
	ПроверитьРавенство(2, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаВторой - 1).Количество(),
		"до второй версии остаётся прежний состав");
	Актуальный = ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаВторой);
	ПроверитьРавенство(1, Актуальный.Количество(), "удалённый материал не примешивается во вторую версию");
	ПроверитьРавенство(Контекст.Сырье, Актуальный[0].Номенклатура, "оставшийся материал второй версии");
	ПроверитьРавенство(4, Актуальный[0].Количество, "расход второй версии");

	Состав[0].Количество = 6;
	Повторная = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ДатаВторой);
	ПроверитьРавенство(Вторая, Повторная, "правка в тот же день перезаписывает документ");
	ПроверитьРавенство(2, КоличествоДокументовТехкарт(Продукция), "повторная запись не создаёт дубль");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Вторая, Состав), "сохранённый состав не требует записи");

	ПродукцияВыпуска = Новый ТаблицаЗначений;
	ПродукцияВыпуска.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПродукцияВыпуска.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число"));
	Строка = ПродукцияВыпуска.Добавить();
	Строка.Номенклатура = Продукция;
	Строка.КоличествоУпаковок = 2;
	Материалы = ТехнологическиеКарты.ЗаполнитьМатериалыПоТехкартам(ПродукцияВыпуска, ДатаВторой);
	ПроверитьРавенство(1, Материалы.Количество(), "заполнение выпуска не возвращает удалённый материал");
	ПроверитьРавенство(12, Материалы[0].КоличествоУпаковок, "расход на две единицы продукции");
	ОжидаемаяУпаковка = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку"), Контекст.Единица,
		Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	ПроверитьРавенство(ОжидаемаяУпаковка, Материалы[0].Упаковка, "упаковка подчиняется функциональной опции");

	Набор = Новый Массив;
	Набор.Добавить(Продукция);
	Набор.Добавить(Контекст.Товар);
	Веса = ТехнологическиеКарты.КоэффициентыТехкарт(Набор, ДатаВторой);
	ПроверитьРавенство(1, Веса[Продукция], "при отсутствии одной карты все веса равны единице");
	ПроверитьРавенство(1, Веса[Контекст.Товар], "вес продукции без карты");

	Отмена = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Неопределено, ДатаОтмены);
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаОтмены).Количество(),
		"отмена не возвращает прежнюю рецептуру");
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкартыПоРегистратору(Отмена).Количество(),
		"маркер отмены не попадает в материалы");
	Версия = ТехнологическиеКарты.ТекущиеТехкарты(Продукция, ДатаОтмены).Получить(Продукция);
	ПроверитьРавенство(Отмена, Версия.Версия, "маркер остаётся действующей версией");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Отмена, Неопределено), "пустой состав не требует новой отмены");
	ПроверитьРавенство(0,
		ТехнологическиеКарты.ЗаполнитьМатериалыПоТехкартам(ПродукцияВыпуска, ДатаОтмены).Количество(),
		"отменённая карта не заполняет выпуск");
	ПроверитьРавенство(1, ТехнологическиеКарты.КоэффициентыТехкарт(Продукция, ДатаОтмены).Получить(Продукция),
		"отменённая карта даёт единичный вес");
	ПроверитьРавенство(6, ТехнологическиеКарты.КоэффициентыТехкарт(Продукция, ДатаВторой).Получить(Продукция),
		"отмена не меняет исторический вес");

	Возврат РезультатСценария("границы дат, удаление материала, перезапись дня, заполнение выпуска, веса и отмена карты");

КонецФункции

// Перенос вызывается тем же обработчиком, что при обновлении базы, с общим откатом сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПереносТехнологическихКарт(Контекст)

	ДатаСоздания = НачалоДня(Контекст.Дата) - 86400;
	Старая = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	БезДаты = НоменклатураСоСтаройТехкартой(Контекст, Дата(1, 1, 1));
	Будущая = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	Отмененная = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	Черновик = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	Пустая = НоваяНоменклатура(Контекст, "без старой карты", Перечисления.ТипыНоменклатуры.Продукция);
	Состав = СоставКарты(Контекст);
	Состав[0].Количество = 7;
	ДатаБудущей = НачалоДня(Контекст.Дата) + 86400;
	БудущаяВерсия = ТехнологическиеКарты.ЗаписатьТехкарту(Будущая, Состав, ДатаБудущей);
	Отмена = ТехнологическиеКарты.ЗаписатьТехкарту(Отмененная, Неопределено, ДатаСоздания);
	ДокЧерновик = Документы.ТехнологическаяКарта.СоздатьДокумент();
	ДокЧерновик.Заполнить(Черновик);
	ДокЧерновик.Дата = ДатаСоздания;
	ДокЧерновик.ТЧМатериалы.Загрузить(Состав);
	ДокЧерновик.Записать();

	ОбновлениеПрограммыОбработчики.ПеренестиТехнологическиеКарты();
	Версия = ТехнологическиеКарты.ТекущиеТехкарты(Старая, ДатаСоздания).Получить(Старая);
	Проверить(Версия <> Неопределено, "старая карта перенесена на дату создания номенклатуры");
	ПроверитьРавенство(ДатаСоздания, Версия.ДействуетС, "дата перенесённой карты");
	ПеренесенныйСостав = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Версия.Версия);
	ПроверитьРавенство(1, ПеренесенныйСостав.Количество(), "повторяющиеся строки сырья свёрнуты");
	ПроверитьРавенство(Контекст.Сырье, ПеренесенныйСостав[0].Номенклатура, "перенесён материал");
	ПроверитьРавенство(Контекст.Единица, ПеренесенныйСостав[0].Упаковка, "ЕИ перенесена в упаковку");
	ПроверитьРавенство(5, ПеренесенныйСостав[0].Количество, "суммарный расход сохранён");
	Проверить(Не ЗначениеЗаполнено(ПеренесенныйСостав[0].Характеристика), "у старой карты характеристика пустая");
	ПроверитьРавенство(2, Старая.ПолучитьОбъект().ТехнологическаяКарта.Количество(), "исходная карта сохранена");
	ВерсияБезДаты = ТехнологическиеКарты.ТекущиеТехкарты(БезДаты, ДатаСоздания).Получить(БезДаты);
	ПроверитьРавенство(Дата(2000, 1, 1), ВерсияБезДаты.ДействуетС, "запасная дата переноса");

	ОбновлениеПрограммыОбработчики.ПеренестиТехнологическиеКарты();
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Старая), "повтор переноса не создаёт дубликат");
	Повторная = ТехнологическиеКарты.ТекущиеТехкарты(Старая, ДатаСоздания).Получить(Старая);
	ПроверитьРавенство(Версия.Версия, Повторная.Версия, "повтор сохраняет регистратор");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Версия.Версия, ПеренесенныйСостав), "повтор сохраняет состав");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(БезДаты), "запасная дата не мешает идемпотентности");
	ПроверитьРавенство(0, КоличествоДокументовТехкарт(Пустая), "пустая старая карта не переносится");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Будущая), "будущая карта запрещает перенос старой");
	БудущаяПосле = ТехнологическиеКарты.ТекущиеТехкарты(Будущая, ДатаБудущей).Получить(Будущая);
	ПроверитьРавенство(БудущаяВерсия, БудущаяПосле.Версия, "будущая версия сохранена");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(БудущаяВерсия, Состав), "будущий состав сохранён");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Отмененная), "маркер отмены запрещает перенос");
	ОтменаПосле = ТехнологическиеКарты.ТекущиеТехкарты(Отмененная, ДатаСоздания).Получить(Отмененная);
	ПроверитьРавенство(Отмена, ОтменаПосле.Версия, "отмена сохранена");
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкарт(Отмененная, ДатаСоздания).Количество(),
		"отменённая карта не восстановлена");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Черновик), "черновик не заменён переносом");
	Проверить(Не ДокЧерновик.Ссылка.Проведен, "черновик не проведён переносом");
	ПроверитьРавенство(7, ДокЧерновик.Ссылка.ПолучитьОбъект().ТЧМатериалы[0].Количество, "состав черновика сохранён");

	Возврат РезультатСценария("перенос дат и состава, повтор без дублей, сохранение будущих карт, отмен и черновиков");

КонецФункции

// Мультивыпуск по перенесённой карте: будущая рецептура не меняет старую себестоимость.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСебестоимостьТехкарт(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;

	Продукция = НоменклатураСоСтаройТехкартой(Контекст, НачалоДня(Контекст.Дата) - 86400);
	ОбновлениеПрограммыОбработчики.ПеренестиТехнологическиеКарты();
	ДокументЗакупки(Контекст, Контекст.Сырье, 7, 10);
	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Продукция, 1, 0);
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Контекст.Продукция, 1, 0);
	Материалы = ТехнологическиеКарты.ЗаполнитьМатериалыПоТехкартам(Выпуск.ТЧГотоваяПродукция.Выгрузить(), Выпуск.Дата);
	ПроверитьРавенство(7, Материалы.Итог("КоличествоУпаковок"), "расход сырья по двум картам после переноса");
	Для Каждого Строка Из Материалы Цикл
		ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧТовары", Строка.Номенклатура, Строка.КоличествоУпаковок, 0);
	КонецЦикла;
	Провести(Выпуск);
	ПроверитьРавенство(50, ОстатокТовара(Контекст.Склад, Продукция).Сумма, "себестоимость по перенесённой карте: вес 5");
	ПроверитьРавенство(20, ОстатокТовара(Контекст.Склад, Контекст.Продукция).Сумма, "себестоимость второй продукции: вес 2");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, Контекст.Сырье).Количество, "сырьё списано полностью");

	НовыйСостав = СоставКарты(Контекст);
	НовыйСостав[0].Количество = 9;
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, НовыйСостав, НачалоДня(Выпуск.Дата) + 86400);
	// Повторное проведение пользователем начинается с перечитанного объекта. Иначе наборы
	// движений первого проведения остаются в памяти теста и складываются с новыми.
	Выпуск = Выпуск.Ссылка.ПолучитьОбъект();
	Провести(Выпуск);
	ПроверитьРавенство(50, ОстатокТовара(Контекст.Склад, Продукция).Сумма, "перепроведение сохраняет старый вес 5");
	ПроверитьРавенство(20, ОстатокТовара(Контекст.Склад, Контекст.Продукция).Сумма, "перепроведение сохраняет долю второй продукции");
	ПроверитьРавенство(1, ОстатокТовара(Контекст.Склад, Продукция).Количество, "перепроведение не удваивает выпуск");

	Проверить(ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Продукция, НачалоДня(Выпуск.Дата)),
		"нужно предупредить о выпуске в день действия карты");
	Проверить(Не ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Продукция, КонецДня(Выпуск.Дата) + 1),
		"более ранний выпуск не требует предупреждения");

	Возврат РезультатСценария("перенос → мультивыпуск: себестоимость 50/20; новая рецептура не меняет старый выпуск");

КонецФункции

// Дата в карточке не может предшествовать последней карте, даже если в тот день есть версия.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДатыТехкарты(Контекст)

	Продукция = НоваяНоменклатура(Контекст, "выбор даты карты", Перечисления.ТипыНоменклатуры.Продукция);
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Вчера = НачалоДня(Сегодня - 1);
	Завтра = КонецДня(Сегодня) + 1;
	Состав = СоставКарты(Контекст);
	Вчерашняя = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Вчера);
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Сегодня);
	Проверить(Выбор.Допустима, "новая версия может начинаться сегодня");
	Проверить(Не ЗначениеЗаполнено(Выбор.Документ), "сегодняшняя версия ещё не создана");
	Ссылка = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ТекущаяДатаСеанса());
	ПроверитьРавенство(Сегодня, Ссылка.Дата, "новая карта хранит день без времени");
	Проверить(Вчерашняя <> Ссылка, "новый день создаёт отдельную версию");
	Состав[0].Количество = 4;
	Повторная = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, КонецДня(Сегодня));
	ПроверитьРавенство(Ссылка, Повторная, "сегодня редактируется существующая карта");
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Сегодня);
	ПроверитьРавенство(Ссылка, Выбор.Документ, "по дате подобрана та же карта");
	ДокументКарты = Ссылка.ПолучитьОбъект();
	ДокументКарты.Дата = КонецДня(Сегодня);
	ДокументКарты.Записать(РежимЗаписиДокумента.Проведение);
	Повторная = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Сегодня);
	ПроверитьРавенство(Ссылка, Повторная, "карта со временем перезаписывается без дубля");
	ПроверитьРавенство(Сегодня, Повторная.Дата, "у существующей карты время также сбрасывается");
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Вчера);
	Проверить(Не Выбор.Допустима, "вчера запрещено, несмотря на существующую вчерашнюю карту");
	ПроверитьРавенство(Завтра, Выбор.Дата, "после ошибки выбирается следующий день после последней версии");
	ЗаписьОтклонена = Ложь;
	Попытка
		ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Вчера);
	Исключение
		ЗаписьОтклонена = Истина;
	КонецПопытки;
	Проверить(ЗаписьОтклонена, "сервер запрещает перезапись старой версии независимо от формы");
	ПроверитьРавенство(2, ТехнологическиеКарты.СоставТехкартыПоРегистратору(Вчерашняя)[0].Количество,
		"отклонённая запись не меняет старый состав");
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Завтра);
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Сегодня);
	Проверить(Не Выбор.Допустима, "будущая карта запрещает новую сегодняшнюю");
	ПроверитьРавенство(КонецДня(Завтра) + 1, Выбор.Дата, "исправленная дата не нарушает запрет будущей карты");

	Возврат РезультатСценария("день без времени, редактирование сегодняшней версии, запрет прошлых дат и будущая последняя карта");

КонецФункции

// Реальные поступления и продажи дают последние цены; два одинаковых материала делят остаток.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПоказателиТехкарты(Контекст)

	ДокументЗакупки(Контекст, Контекст.Сырье, 10, 9);
	ДокументЗакупки(Контекст, Контекст.Сырье, 10, 10);
	ДокументЗакупки(Контекст, Контекст.Товар, 12, 2);
	ДокументЗакупки(Контекст, Контекст.Продукция, 2, 20);
	ДокументРеализации(Контекст, Контекст.Продукция, 1, 90);
	ДокументРеализации(Контекст, Контекст.Продукция, 1, 100);
	Состав = СоставКарты(Контекст);
	Строка = Состав.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Состав[0]);
	Строка.Количество = 3;
	Строка = Состав.Добавить();
	Строка.Номенклатура = Контекст.Товар;
	Строка.Количество = 6;

	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	Проверить(Показатели.ВсеЦеныЕсть, "у всех материалов есть закупочная цена");
	ПроверитьРавенство(10, Показатели.Строки[0].Цена, "последняя цена заменяет прежнюю цену 9");
	ПроверитьРавенство(62, Показатели.Себестоимость, "себестоимость: (2 + 3) * 10 + 6 * 2");
	ПроверитьРавенство(2, Показатели.МожноПроизвести, "ограничивает второй материал: 12 / 6");
	ПроверитьРавенство(100, Показатели.ЦенаПродажи, "взята последняя продажа, а не прайс и не прежняя цена 90");
	ПроверитьРавенство(76, Показатели.ПотенциальнаяМаржа, "маржа всего выпуска: (100 - 62) * 2");
	Состав.Удалить(2);
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(4, Показатели.МожноПроизвести, "дубли материала используют один остаток: 20 / (2 + 3)");
	Состав[0].Количество = 30;
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(0.606, Показатели.МожноПроизвести, "дробный выпуск усекается, а не округляется вверх");
	Проверить(Показатели.ПотенциальнаяМаржа < 0, "отрицательная маржа сохраняется для показа убытка");

	Характеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	Характеристика.Владелец = Контекст.Сырье;
	Характеристика.Наименование = ПометкаТеста() + ": другая характеристика";
	Характеристика.Записать();
	Состав[0].Характеристика = Характеристика.Ссылка;
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(0, Показатели.МожноПроизвести, "остаток другой характеристики не используется");
	Проверить(Не Показатели.ВсеЦеныЕсть, "нет закупочной цены выбранной характеристики");
	ПроверитьРавенство(0, Показатели.Себестоимость, "неполная себестоимость не выдаётся за полную");
	ПроверитьРавенство(0, Показатели.ПотенциальнаяМаржа, "при неполной себестоимости маржа не рассчитывается");
	Состав.Очистить();
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(0, Показатели.МожноПроизвести, "пустой состав не обещает выпуск");
	ПроверитьРавенство(0, Показатели.Себестоимость, "пустой состав сбрасывает себестоимость");

	Возврат РезультатСценария("последние цены, себестоимость, ограничивающий материал, дубли, дробный выпуск, характеристики и маржа");

КонецФункции

// Способ пополнения: единое правило умолчаний, страховка записи, ручное значение
// "Оба" и идемпотентное заполнение существующей номенклатуры обработчиком обновления.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСпособыПополненияЗапасов(Контекст)

	Закупка = Перечисления.СпособыПополненияЗапасов.Закупка;
	СпособПроизводство = Перечисления.СпособыПополненияЗапасов.Производство;
	Оба = Перечисления.СпособыПополненияЗапасов.Оба;

	Умолчания = Новый Соответствие;
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Продукция, СпособПроизводство);
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Полуфабрикат, СпособПроизводство);
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Товар, Закупка);
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Сырье, Закупка);
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Комплект, Закупка);
	Умолчания.Вставить(Перечисления.ТипыНоменклатуры.Услуга, Закупка);
	Для Каждого Умолчание Из Умолчания Цикл
		Получено = Справочники.Номенклатура.СпособПополненияПоУмолчанию(Умолчание.Ключ);
		ПроверитьРавенство(Умолчание.Значение, Получено, "способ пополнения по умолчанию для типа " + Умолчание.Ключ);
	КонецЦикла;

	Страховка = Справочники.Номенклатура.СоздатьЭлемент();
	Страховка.Наименование = ПометкаТеста() + ": страховка способа пополнения";
	Страховка.НаименованиеПолное = Страховка.Наименование;
	Страховка.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Сырье;
	Страховка.Единица = Контекст.Единица;
	Страховка.СтавкаНДС = Контекст.СтавкаНДС;
	Страховка.СпособПополнения = Перечисления.СпособыПополненияЗапасов.ПустаяСсылка();
	Страховка.Записать();
	ПроверитьРавенство(Закупка, Страховка.Ссылка.СпособПополнения,
		"ПередЗаписью заполняет пустой способ пополнения");

	ЯвныйВыбор = Контекст.Товар.ПолучитьОбъект();
	ЯвныйВыбор.СпособПополнения = Оба;
	ЯвныйВыбор.Записать();
	ПроверитьРавенство(Оба, ЯвныйВыбор.Ссылка.СпособПополнения,
		"явно выбранное значение Оба сохраняется при записи");

	СуществующийЭлемент = НоменклатураБезСпособаПополнения(Контекст);
	СуществующаяГруппа = ГруппаНоменклатурыБезСпособаПополнения();
	Проверить(Не ЗначениеЗаполнено(СуществующийЭлемент.СпособПополнения),
		"режим загрузки сохраняет пустое значение до миграции");

	ОбновлениеПрограммыОбработчики.ЗаполнитьСпособыПополненияЗапасов();
	ПроверитьРавенство(СпособПроизводство, СуществующийЭлемент.СпособПополнения,
		"миграция заполняет существующую продукцию");
	ПроверитьРавенство(Оба, ЯвныйВыбор.Ссылка.СпособПополнения,
		"миграция не меняет явно выбранное значение Оба");
	Проверить(Не ЗначениеЗаполнено(СуществующаяГруппа.СпособПополнения),
		"миграция не обрабатывает группы номенклатуры");
	ПроверитьРавенство(0, КоличествоЭлементовБезСпособаПополнения(),
		"после миграции не осталось элементов с пустым способом пополнения");

	ОбновлениеПрограммыОбработчики.ЗаполнитьСпособыПополненияЗапасов();
	ПроверитьРавенство(СпособПроизводство, СуществующийЭлемент.СпособПополнения,
		"повторная миграция сохраняет заполненное значение");
	ПроверитьРавенство(Оба, ЯвныйВыбор.Ссылка.СпособПополнения,
		"повторная миграция сохраняет Оба");
	ПроверитьРавенство(0, КоличествоЭлементовБезСпособаПополнения(),
		"повторная миграция идемпотентна");

	Возврат РезультатСценария("умолчания шести типов, страховка записи, Оба, миграция элементов и повторный запуск");

КонецФункции

// Коммерческое предложение: статусы, описание у каждой строки, печать и ввод заказа
// на основании. Неуспешная проверка заполнения заказа не меняет статус предложения.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийКоммерческоеПредложение(Контекст)

	ОписаниеСтроки = ПометкаТеста() + ": описание из коммерческого предложения";
	Предложение = НовоеКоммерческоеПредложение(Контекст, Контекст.Товар, ОписаниеСтроки);
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Черновик,
		Предложение.Статус, "статус нового предложения");
	ОписаниеКарточки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контекст.Товар, "Описание");
	ВтораяСтрока = Предложение.ТЧТовары.Добавить();
	ЗаполнитьЗначенияСвойств(ВтораяСтрока, Предложение.ТЧТовары[0], , "КодСтроки, Описание");
	ВтораяСтрока.КодСтроки = Предложение.ТЧТовары[0].КодСтроки + 1;
	ВтораяСтрока.Описание = ОписаниеСтроки + " (вторая строка)";
	Записать(Предложение);
	ПроверитьРавенство(ОписаниеСтроки, Предложение.Ссылка.ТЧТовары[0].Описание, "описание первой строки сохраняется");
	ПроверитьРавенство(ВтораяСтрока.Описание, Предложение.Ссылка.ТЧТовары[1].Описание,
		"у второй строки той же номенклатуры своё описание");
	ПроверитьРавенство(ОписаниеКарточки, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контекст.Товар, "Описание"),
		"описание строки не переносится в карточку номенклатуры");

	Предложение.Статус = Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	Предложение.Записать();
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Отправлен,
		Предложение.Ссылка.Статус, "выбранный статус сохраняется");

	ПечатнаяФорма = Новый ТабличныйДокумент;
	Документы.РеализацияТоваровУслуг.PrintDevisA4(Предложение.Ссылка, ПечатнаяФорма);
	Проверить(ПечатнаяФорма.ВысотаТаблицы > 0, "печатная форма коммерческого предложения пуста");
	Проверить(ПечатнаяФорма.НайтиТекст(ВтораяСтрока.Описание) <> Неопределено,
		"печатная форма выводит описание строки предложения");

	Заказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	Заказ.Заполнить(Предложение.Ссылка);
	Заказ.Дата = СледующаяДата(Контекст);
	Записать(Заказ);
	ПроверитьРавенство(Предложение.Ссылка, Заказ.Основание, "основание заказа");
	ПроверитьРавенство(Предложение.Организация, Заказ.Организация, "организация заказа");
	ПроверитьРавенство(Предложение.Контрагент, Заказ.Контрагент, "контрагент заказа");
	ПроверитьРавенство(Предложение.Договор, Заказ.Договор, "договор заказа");
	ПроверитьРавенство(Предложение.ДатаОтгрузки, Заказ.ДатаОтгрузки, "дата отгрузки заказа");
	ПроверитьРавенство(Предложение.ЦенаВключаетНДС, Заказ.ЦенаВключаетНДС, "режим НДС заказа");
	ПроверитьРавенство(Предложение.Комментарий, Заказ.Комментарий, "комментарий заказа");
	ПроверитьРавенство(Предложение.ТЧТовары.Количество(), Заказ.ТЧТовары.Количество(),
		"количество строк заказа");
	ПроверитьРавенство(Предложение.ТЧТовары[0].Номенклатура, Заказ.ТЧТовары[0].Номенклатура,
		"номенклатура заказа");
	ПроверитьРавенство(Предложение.ТЧТовары[0].Количество, Заказ.ТЧТовары[0].Количество,
		"количество товара в заказе");
	ПроверитьРавенство(Предложение.ТЧТовары[0].Цена, Заказ.ТЧТовары[0].Цена, "цена товара в заказе");
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Выигран,
		Предложение.Ссылка.Статус, "успешный заказ устанавливает статус Выигран");

	ПредложениеСОшибкой = НовоеКоммерческоеПредложение(Контекст, Контекст.Сырье,
		ПометкаТеста() + ": статус при ошибке заказа");
	ПредложениеСОшибкой.Статус = Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	Записать(ПредложениеСОшибкой);
	НезаполненныйЗаказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	НезаполненныйЗаказ.Заполнить(ПредложениеСОшибкой.Ссылка);
	НезаполненныйЗаказ.Организация = Справочники.Организации.ПустаяСсылка();
	Проверить(Не НезаполненныйЗаказ.ПроверитьЗаполнение(),
		"заказ без организации должен отклоняться проверкой заполнения");
	ПолучитьСообщенияПользователю(Истина);
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Отправлен,
		ПредложениеСОшибкой.Ссылка.Статус, "неуспешное создание заказа не меняет статус предложения");

	Возврат РезультатСценария(
		"черновик и ручной статус, описание, печать, заказ-основание, Выигран и отказ без смены статуса");

КонецФункции

// Вид операции заказа клиента (E4): умолчание, страховка записи, заполнение из отбора списка
// и по коммерческому предложению, смена у записанного заказа, представление и обработчик обновления.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВидОперацииЗаказа(Контекст)

	Продажа = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	ВидПроизводство = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;

	ЗаказПоУмолчанию = Документы.ЗаказПокупателя.СоздатьДокумент();
	ЗаказПоУмолчанию.Заполнить(Неопределено);
	ПроверитьРавенство(Продажа, ЗаказПоУмолчанию.ВидОперации, "значение заполнения нового заказа");

	ЗаказИзОтбора = Документы.ЗаказПокупателя.СоздатьДокумент();
	ЗаказИзОтбора.Заполнить(Новый Структура("ВидОперации", ВидПроизводство));
	ПроверитьРавенство(ВидПроизводство, ЗаказИзОтбора.ВидОперации,
		"заполнение из отбора списка (fillFromFillingValue)");

	// Вид операции очищается явно: проверяется страховка записи, а не то, применяет ли
	// СоздатьДокумент значения заполнения.
	ЗаказБезЗаполнения = ЗаказКлиентаСценария(Контекст);
	ЗаказБезЗаполнения.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.ПустаяСсылка();
	Записать(ЗаказБезЗаполнения);
	ПроверитьРавенство(Продажа, ЗаказБезЗаполнения.Ссылка.ВидОперации, "ПередЗаписью заполняет пустой вид операции");

	ЗаказБезЗаполнения.ВидОперации = ВидПроизводство;
	Записать(ЗаказБезЗаполнения);
	ПроверитьРавенство(ВидПроизводство, ЗаказБезЗаполнения.Ссылка.ВидОперации,
		"вид операции записанного заказа меняется");
	ПроверитьПредставлениеЗаказаНаПроизводство(ЗаказБезЗаполнения.Ссылка);

	// Вид операции заказа по КП задаёт команда, а не номенклатура предложения (решение владельца 2026-09-14).
	ОжидаемыйНаПроизводство = ?(ПолучитьФункциональнуюОпцию("Производство"), ВидПроизводство, Продажа);
	ПроверитьЗаказПоПредложению(Контекст, Контекст.Товар, Ложь, Продажа, "заказ клиента по КП с закупаемым товаром");
	ПроверитьЗаказПоПредложению(Контекст, Контекст.Продукция, Ложь, Продажа, "заказ клиента по КП с продукцией");
	ПроверитьЗаказПоПредложению(Контекст, Контекст.Товар, Истина, ОжидаемыйНаПроизводство,
		"заказ на производство по КП с закупаемым товаром");
	ПроверитьЗаказПоПредложению(Контекст, Контекст.Продукция, Истина, ОжидаемыйНаПроизводство,
		"заказ на производство по КП с продукцией");

	ПроверитьПредставлениеПродажи(Контекст);

	ЗаказДоОбновления = ЗаказКлиентаСценария(Контекст);
	ЗаказДоОбновления.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.ПустаяСсылка();
	ЗаказДоОбновления.ОбменДанными.Загрузка = Истина;
	ЗаказДоОбновления.Записать();
	Проверить(Не ЗначениеЗаполнено(ЗаказДоОбновления.Ссылка.ВидОперации),
		"режим загрузки сохраняет пустой вид операции до обновления");
	ОбновлениеПрограммыОбработчики.ЗаполнитьВидОперацииЗаказовПокупателей();
	ПроверитьРавенство(Продажа, ЗаказДоОбновления.Ссылка.ВидОперации, "обновление заполняет существующий заказ");
	ПроверитьРавенство(ВидПроизводство, ЗаказБезЗаполнения.Ссылка.ВидОперации,
		"обновление не меняет заполненный вид операции");
	ПроверитьРавенство(0, КоличествоЗаказовБезВидаОперации(), "после обновления нет заказов без вида операции");
	ОбновлениеПрограммыОбработчики.ЗаполнитьВидОперацииЗаказовПокупателей();
	ПроверитьРавенство(Продажа, ЗаказДоОбновления.Ссылка.ВидОперации, "повторное обновление сохраняет значение");
	ПроверитьРавенство(0, КоличествоЗаказовБезВидаОперации(), "повторное обновление идемпотентно");

	Возврат РезультатСценария("умолчание, отбор списка, страховка записи, смена вида, заказ клиента и заказ "
		+ "на производство по КП, представления продажи и производства, обновление и повтор");

КонецФункции

// Материалы заказа клиента на производство (E5): заполнение по технологическим картам и коды строк,
// пересчёт и согласование при записи, один состав одной продукции, заказ по коммерческому
// предложению и очистка материалов у заказа не на производство.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийМатериалыЗаказа(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;

	Заказ = ЗаказНаПроизводствоСценария(Контекст);
	ПроверитьЗаполнениеМатериаловЗаказа(Контекст, Заказ);
	ПроверитьСогласованиеМатериаловЗаказа(Контекст, Заказ);
	ПроверитьМатериалыЗаказаПоПредложению(Контекст);
	ПроверитьОтказЗаписиРазногоСостава(Контекст);

	Возврат РезультатСценария("заполнение по карте, коды строк, количество, пересчёт, смена номенклатуры и удаление "
		+ "строки, один состав продукции, заказ по КП, очистка у продажи, режим загрузки, отказ записи");

КонецФункции

// Заказ на производство с закупаемым товаром и продукцией с картой; коды строк обнулены, как у
// строк, добавленных штрихкодом.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя - незаписанный заказ, строки: товар, продукция
//
Функция ЗаказНаПроизводствоСценария(Контекст)

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция,
		Контекст.Числа.КоличествоПродажи, Контекст.Числа.ЦенаПродажи);
	Для Каждого СтрокаТоваров Из Заказ.ТЧТовары Цикл
		СтрокаТоваров.КодСтроки = 0;
	КонецЦикла;
	Возврат Заказ;

КонецФункции

// Материалы строки товаров заказа.
//
// Параметры:
//  Заказ         - ДокументОбъект.ЗаказПокупателя - заказ
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка товаров
//
// Возвращаемое значение:
//  Массив из СтрокаТабличнойЧасти - строки материалов
//
Функция МатериалыСтрокиЗаказа(Заказ, СтрокаТоваров)

	Возврат Заказ.ТЧМатериалы.НайтиСтроки(Новый Структура("КодСтрокиПродукции", СтрокаТоваров.КодСтроки));

КонецФункции

// Заполнение всех строк и одной строки: коды строк, состав и количество по карте, версия карты,
// упаковка по опции, позиция без карты, строка с повторным кодом.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументОбъект.ЗаказПокупателя - см. ЗаказНаПроизводствоСценария
//
Процедура ПроверитьЗаполнениеМатериаловЗаказа(Контекст, Заказ)

	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	КоличествоПродукции = Контекст.Числа.КоличествоПродажи;
	СтрокаТовара = Заказ.ТЧТовары[0];
	СтрокаПродукции = Заказ.ТЧТовары[1];

	Итог = Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата, ,
		Истина, Заказ);
	Проверить(СтрокаПродукции.КодСтроки > 0, "строка, получившая материалы, получает ненулевой код");
	ПроверитьРавенство(0, СтрокаТовара.КодСтроки, "код строки без карты заполнение не меняет");
	ПроверитьРавенство(1, Итог.Заполнено, "материалы по карте получила только строка продукции");
	ПроверитьРавенство(0, Итог.БезКарты.Количество(), "о закупаемом товаре без карты при заполнении всех строк не сообщается");
	ПроверитьРавенство(1, Заказ.ТЧМатериалы.Количество(), "одна строка материалов по карте продукции");
	Материал = Заказ.ТЧМатериалы[0];
	ПроверитьРавенство(Контекст.Сырье, Материал.Номенклатура, "материал из карты");
	ПроверитьРавенство(СтрокаПродукции.КодСтроки, Материал.КодСтрокиПродукции, "материал привязан к строке продукции");
	ПроверитьРавенство(Расход, Материал.КоличествоЗаЕдиницу, "количество за единицу из карты");
	ПроверитьРавенство(Расход * КоличествоПродукции, Материал.КоличествоУпаковок, "количество упаковок: расход × продукция");
	ПроверитьРавенство(Расход * КоличествоПродукции, Материал.Количество, "базовое количество материала");
	Версия = ТехнологическиеКарты.ТекущиеТехкарты(Контекст.Продукция, Заказ.Дата)[Контекст.Продукция].Версия;
	ПроверитьРавенство(Версия, СтрокаПродукции.Техкарта, "колонка Техкарта - действующая версия карты");
	ОжидаемаяУпаковка = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку"), Контекст.Единица,
		Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	ПроверитьРавенство(ОжидаемаяУпаковка, Материал.Упаковка, "упаковка материала - только при опции «Использовать упаковку»");

	Строки = Новый Массив;
	Строки.Добавить(СтрокаТовара);
	Итог = Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата,
		Строки, Ложь, Заказ);
	ПроверитьРавенство(1, Итог.БезКарты.Количество(), "о позиции без карты при заполнении строки сообщается");
	ПроверитьРавенство(0, МатериалыСтрокиЗаказа(Заказ, СтрокаТовара).Количество(), "у позиции без карты материалов нет");
	ПроверитьРавенство(1, Заказ.ТЧМатериалы.Количество(), "материалы другой строки не тронуты");

	КоличествоВторой = Контекст.Числа.КоличествоВыпуска;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, КоличествоВторой, Контекст.Числа.ЦенаПродажи);
	ВтораяСтрока = Заказ.ТЧТовары[2];
	ВтораяСтрока.КодСтроки = СтрокаПродукции.КодСтроки;
	Строки = Новый Массив;
	Строки.Добавить(ВтораяСтрока);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата, Строки, Ложь, Заказ);
	Проверить(ВтораяСтрока.КодСтроки <> СтрокаПродукции.КодСтроки, "строка с повторным кодом получает новый код");
	МатериалыВторой = МатериалыСтрокиЗаказа(Заказ, ВтораяСтрока);
	ПроверитьРавенство(1, МатериалыВторой.Количество(), "материалы получила переданная строка с повторным кодом");
	ПроверитьРавенство(Расход * КоличествоВторой, МатериалыВторой[0].КоличествоУпаковок,
		"количество второй строки считается от её количества");
	ПроверитьРавенство(1, МатериалыСтрокиЗаказа(Заказ, СтрокаПродукции).Количество(), "материалы исходной строки не заменены");

КонецПроцедуры

// Запись заказа на производство: пересчёт, один состав продукции, смена номенклатуры, удаление строки.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументОбъект.ЗаказПокупателя - заказ после ПроверитьЗаполнениеМатериаловЗаказа:
//             строки товар, продукция, продукция
//
Процедура ПроверитьСогласованиеМатериаловЗаказа(Контекст, Заказ)

	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	СтрокаТовара = Заказ.ТЧТовары[0];
	СтрокаПродукции = Заказ.ТЧТовары[1];
	ВтораяСтрока = Заказ.ТЧТовары[2];
	Записать(Заказ);
	ПроверитьРавенство(2, Заказ.Ссылка.ПолучитьОбъект().ТЧМатериалы.Количество(),
		"строки одной продукции с разным количеством и одним составом записываются");

	НовоеКоличество = Контекст.Числа.КоличествоЗакупки;
	СтрокаПродукции.КоличествоУпаковок = НовоеКоличество;
	СтрокаПродукции.Количество = НовоеКоличество;
	Записать(Заказ);
	ПроверитьРавенство(Расход * НовоеКоличество, МатериалыСтрокиЗаказа(Заказ, СтрокаПродукции)[0].Количество,
		"запись пересчитывает материалы по количеству продукции");

	МатериалВторой = МатериалыСтрокиЗаказа(Заказ, ВтораяСтрока)[0];
	МатериалВторой.КоличествоЗаЕдиницу = Расход + 1;
	Отказ = Ложь;
	Заказ.СогласоватьМатериалы(Отказ);
	Проверить(Отказ, "разный состав одной продукции в двух строках отклоняется");
	МатериалВторой.КоличествоЗаЕдиницу = Расход;

	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, 1, Контекст.Числа.ЦенаПродажи);
	СтрокаБезМатериалов = Заказ.ТЧТовары[3];
	СтрокаБезМатериалов.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Заказ.ТЧТовары);
	Отказ = Ложь;
	Заказ.СогласоватьМатериалы(Отказ);
	Проверить(Не Отказ, "строка той же продукции без материалов не считается другим составом");

	Характеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	Характеристика.Владелец = Контекст.Продукция;
	Характеристика.Наименование = ПометкаТеста() + ": характеристика продукции";
	Характеристика.Записать();
	СтрокаБезМатериалов.Характеристика = Характеристика.Ссылка;
	МатериалХарактеристики = Заказ.ТЧМатериалы.Добавить();
	ЗаполнитьЗначенияСвойств(МатериалХарактеристики, МатериалВторой);
	МатериалХарактеристики.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Заказ.ТЧМатериалы);
	МатериалХарактеристики.КодСтрокиПродукции = СтрокаБезМатериалов.КодСтроки;
	МатериалХарактеристики.КоличествоЗаЕдиницу = Расход + 1;
	Отказ = Ложь;
	Заказ.СогласоватьМатериалы(Отказ);
	Проверить(Отказ, "другая характеристика той же номенклатуры - та же продукция, разный состав отклоняется");
	Заказ.ТЧМатериалы.Удалить(МатериалХарактеристики);

	ВтораяСтрока.Номенклатура = Контекст.Товар;
	СтрокаТовара.КодСтроки = 0;
	Записать(Заказ);
	Проверить(Не ЗначениеЗаполнено(ВтораяСтрока.Техкарта), "смена номенклатуры очищает версию карты строки");
	ПроверитьРавенство(0, МатериалыСтрокиЗаказа(Заказ, ВтораяСтрока).Количество(), "смена номенклатуры очищает материалы строки");
	ПроверитьРавенство(0, СтрокаТовара.КодСтроки, "нулевой код строки без материалов запись не меняет");

	КодУдаленной = СтрокаПродукции.КодСтроки;
	Заказ.ТЧТовары.Удалить(СтрокаПродукции);
	Записать(Заказ);
	Отбор = Новый Структура("КодСтрокиПродукции", КодУдаленной);
	Оставшиеся = Заказ.Ссылка.ПолучитьОбъект().ТЧМатериалы.НайтиСтроки(Отбор);
	ПроверитьРавенство(0, Оставшиеся.Количество(), "удаление строки товаров удаляет её материалы");

КонецПроцедуры

// Заказ по коммерческому предложению с продукцией получает материалы сразу; у продажи материалы
// очищаются при записи; режим загрузки материалы не трогает; обычная продажа пишется как раньше.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьМатериалыЗаказаПоПредложению(Контекст)

	Предложение = НовоеКоммерческоеПредложение(Контекст, Контекст.Продукция, ПометкаТеста() + ": материалы по КП");
	Записать(Предложение);
	ЗаказПоПредложению = НовыйДокумент(Контекст, "ЗаказПокупателя");
	ЗаказПоПредложению.Заполнить(Новый Структура("Предложение, НаПроизводство", Предложение.Ссылка, Истина));
	ПроверитьРавенство(Перечисления.ВидыОперацийЗаказаПокупателя.Производство, ЗаказПоПредложению.ВидОперации,
		"заказ по КП с продукцией - на производство");
	ПроверитьРавенство(1, ЗаказПоПредложению.ТЧМатериалы.Количество(), "заказ по КП получает материалы сразу");
	Проверить(ЗначениеЗаполнено(ЗаказПоПредложению.ТЧТовары[0].Техкарта), "заказ по КП получает версию карты строки");
	Записать(ЗаказПоПредложению);

	ЗаказПоПредложению.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	Записать(ЗаказПоПредложению);
	ПроверитьРавенство(0, ЗаказПоПредложению.Ссылка.ПолучитьОбъект().ТЧМатериалы.Количество(),
		"у заказа не на производство материалы очищаются при записи");
	Проверить(Не ЗначениеЗаполнено(ЗаказПоПредложению.ТЧТовары[0].Техкарта), "у продажи версия карты строки очищается");

	Материал = ЗаказПоПредложению.ТЧМатериалы.Добавить();
	Материал.Номенклатура = Контекст.Сырье;
	Материал.КодСтрокиПродукции = ЗаказПоПредложению.ТЧТовары[0].КодСтроки;
	ЗаказПоПредложению.ОбменДанными.Загрузка = Истина;
	ЗаказПоПредложению.Записать();
	ПроверитьРавенство(1, ЗаказПоПредложению.Ссылка.ПолучитьОбъект().ТЧМатериалы.Количество(),
		"запись в режиме загрузки материалы не трогает");

	Продажа = ЗаказКлиентаСценария(Контекст);
	Продажа.ТЧТовары[0].КодСтроки = 0;
	Записать(Продажа);
	ПроверитьРавенство(0, Продажа.ТЧМатериалы.Количество(), "у продажи материалов нет");
	ПроверитьРавенство(0, Продажа.ТЧТовары[0].КодСтроки, "коды строк продажи запись не меняет");

КонецПроцедуры

// Настоящая запись с разным составом одной продукции отклоняется. Отказ записи оставляет транзакцию
// сценария пригодной только для отката, поэтому проверка - последняя.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказЗаписиРазногоСостава(Контекст)

	Заказ = ЗаказНаПроизводствоСценария(Контекст);
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, 1, Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата, , Истина, Заказ);
	ПроверитьРавенство(2, Заказ.ТЧМатериалы.Количество(), "обе строки продукции заполнены по карте");
	Заказ.ТЧМатериалы[1].КоличествоЗаЕдиницу = Заказ.ТЧМатериалы[0].КоличествоЗаЕдиницу + 1;
	Отклонено = Ложь;
	Попытка
		Заказ.Записать();
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	Проверить(Отклонено, "запись заказа с разным составом одной продукции отклоняется");

КонецПроцедуры

// Сценарий E6: проведение заказа на производство регистрирует версию технологической карты при
// отличии состава и не регистрирует при совпадении; отказы проведения; запрет смены вида операции;
// продажа не проводится. Настоящий отказ проведения - последним шагом: он портит транзакцию сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПроведениеЗаказа(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	МетаданныеКарты = Метаданные.Документы.ТехнологическаяКарта;
	ПравоПроведения = "Проведение";
	ЕстьПраваНаКарты = ПравоДоступа(ПравоПроведения, МетаданныеКарты) И ПравоДоступа("Изменение", МетаданныеКарты);
	Проверить(ЕстьПраваНаКарты, "пользователю прогона нужно право менять технологические карты: сценарий регистрирует версии карт");
	Проверить(Документы.ЗаказПокупателя.ЗаказПроводится(Перечисления.ВидыОперацийЗаказаПокупателя.Производство),
		"заказ на производство проводится при включённой опции");
	Проверить(Не Документы.ЗаказПокупателя.ЗаказПроводится(Перечисления.ВидыОперацийЗаказаПокупателя.Продажа),
		"продажа не проводится - отказ до ПриЗаписи в ПередЗаписью опирается на эту функцию");

	Заказ = ЗаказПроведенияСценария(Контекст, Контекст.Числа.РасходСырьяНаЕдиницу + 1);
	Версия = ПроверитьРегистрациюТехкарты(Контекст, Заказ);
	ПроверитьУпаковкуСоставаПродукции(Контекст, Версия);
	ПроверитьОтказыПроведенияЗаказа(Контекст);
	Проверить(Не ПравоДоступа(ПравоПроведения, МетаданныеКарты, Метаданные.Роли.Оператор),
		"у роли Оператор нет права менять технологические карты - заказ проверяет его перед записью карты");
	Проверить(ПравоДоступа(ПравоПроведения, МетаданныеКарты, Метаданные.Роли.ОператорПроизводства),
		"роль ОператорПроизводства меняет технологические карты");
	ПроверитьСменуВидаПроведенногоЗаказа(Заказ, Версия);
	ПроверитьПроверкуЗаполненияПриЗаписи(Контекст);
	ПроверитьЗаголовокФормыЗаказа(Контекст);
	ПроверитьОтказПроведенияПродажи(Контекст);

	ВеткаУпаковки = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку"), "упаковка из заказа (опция включена)",
		"перенос упаковки из карты (опция выключена)");
	Возврат РезультатСценария("регистрация версии карты и дата проведения, перепроведение без новой версии и без отката "
		+ "карты, совпадение с действующей картой, новый состав, " + ВеткаУпаковки + ", отказы, права, запрет смены вида "
		+ "и записи изменённых материалов проведённого заказа, отмена проведения, проверка заполнения при записи, "
		+ "заголовок, продажа не проводится");

КонецФункции

// Незаписанный заказ на производство: закупаемый товар и продукция с одним материалом, введённым вручную.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Расход   - Число - количество сырья на единицу продукции
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя - строки: товар, продукция
//
Функция ЗаказПроведенияСценария(Контекст, Расход)

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция,
		Контекст.Числа.КоличествоПродажи, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Контекст.Сырье, Расход);
	Возврат Заказ;

КонецФункции

// Строка материалов заказа с упаковкой, как у заполнения по карте: при опции «Использовать упаковку» -
// упаковка карты сценария, без опции - пустая.
//
// Параметры:
//  Контекст      - Структура - см. НовыйКонтекст
//  Заказ         - ДокументОбъект.ЗаказПокупателя - заказ
//  СтрокаТоваров - СтрокаТабличнойЧасти - строка продукции
//  Материал      - СправочникСсылка.Номенклатура - материал
//  Расход        - Число - количество на единицу продукции
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти - строка материалов
//
Функция ДобавитьМатериалЗаказа(Контекст, Заказ, СтрокаТоваров, Материал, Расход) Экспорт

	СтрокаМатериала = Заказ.ТЧМатериалы.Добавить();
	СтрокаМатериала.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Заказ.ТЧМатериалы);
	СтрокаМатериала.КодСтрокиПродукции = СтрокаТоваров.КодСтроки;
	СтрокаМатериала.Номенклатура = Материал;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку") Тогда
		СтрокаМатериала.Упаковка = Контекст.Единица;
	КонецЕсли;
	СтрокаМатериала.КоличествоЗаЕдиницу = Расход;
	Документы.ЗаказПокупателя.ПересчитатьСтрокуМатериала(СтрокаМатериала, СтрокаТоваров.Количество);
	Возврат СтрокаМатериала;

КонецФункции

// Версия данных документа карты: одна и та же карта дня перезаписывается, поэтому лишнюю регистрацию
// видно только по версии данных, а не по ссылке и числу документов.
//
// Параметры:
//  Карта - ДокументСсылка.ТехнологическаяКарта - документ карты
//
// Возвращаемое значение:
//  Строка - версия данных
//
Функция ВерсияДанныхКарты(Карта)

	Запрос = Новый Запрос("ВЫБРАТЬ Карты.ВерсияДанных КАК ВерсияДанных
		|ИЗ Документ.ТехнологическаяКарта КАК Карты ГДЕ Карты.Ссылка = &Карта");
	Запрос.УстановитьПараметр("Карта", Карта);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.ВерсияДанных;

КонецФункции

// Количество первой строки состава версии карты.
//
// Параметры:
//  Карта - ДокументСсылка.ТехнологическаяКарта - версия карты
//
// Возвращаемое значение:
//  Число - количество на единицу продукции
//
Функция РасходПоВерсииКарты(Карта)

	Возврат ТехнологическиеКарты.СоставТехкартыПоРегистратору(Карта)[0].Количество;

КонецФункции

// Регистрация при пустой колонке «Техкарта», перепроведение без изменений, правка карты технологом после
// проведения, заказ с составом действующей карты, изменение состава.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументОбъект.ЗаказПокупателя - см. ЗаказПроведенияСценария, расход на единицу +1 к карте
//
// Возвращаемое значение:
//  ДокументСсылка.ТехнологическаяКарта - версия карты продукции после изменения состава
//
Функция ПроверитьРегистрациюТехкарты(Контекст, Заказ)

	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	Продукция = Контекст.Продукция;
	СтрокаТовара = Заказ.ТЧТовары[0];
	СтрокаПродукции = Заказ.ТЧТовары[1];

	Провести(Заказ);
	Версия = СтрокаПродукции.Техкарта;
	Проверить(ЗначениеЗаполнено(Версия), "проведение ставит версию карты в строку продукции");
	ПроверитьРавенство(Версия, Заказ.Ссылка.ПолучитьОбъект().ТЧТовары[1].Техкарта, "версия карты строки записана в базу");
	Проверить(Не ЗначениеЗаполнено(СтрокаТовара.Техкарта), "у закупаемого товара без материалов версии нет");
	ПроверитьРавенство(Расход + 1, РасходПоВерсииКарты(Версия), "состав версии - состав заказа");
	ПроверитьРавенство(НачалоДня(ТекущаяДатаСеанса()), Версия.Дата, "дата версии - день проведения");
	ПроверитьРавенство(Версия, ТехнологическиеКарты.ТекущиеТехкарты(Продукция)[Продукция].Версия,
		"версия заказа становится действующей картой продукции");

	ВерсияДанных = ВерсияДанныхКарты(Версия);
	Провести(Заказ);
	ПроверитьРавенство(ВерсияДанных, ВерсияДанныхКарты(Версия), "повторное проведение без изменений карту не перезаписывает");
	ПроверитьРавенство(Версия, СтрокаПродукции.Техкарта, "повторное проведение оставляет версию строки");

	Состав = СоставКарты(Контекст);
	Состав[0].Количество = Расход + 2;
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ТекущаяДатаСеанса());
	Материал = Заказ.ТЧМатериалы[0];
	Материал.КоличествоЗаЕдиницу = (Расход + 1) / 2;
	Документы.ЗаказПокупателя.ПересчитатьСтрокуМатериала(Материал, СтрокаПродукции.Количество);
	ДобавитьМатериалЗаказа(Контекст, Заказ, СтрокаПродукции, Контекст.Сырье, (Расход + 1) / 2);
	ВерсияДанных = ВерсияДанныхКарты(Версия);
	Провести(Заказ);
	ПроверитьРавенство(ВерсияДанных, ВерсияДанныхКарты(Версия),
		"перепроведение с тем же составом (две одинаковые строки материала) не возвращает карте прежний состав");
	ПроверитьРавенство(Расход + 2, РасходПоВерсииКарты(Версия), "действующая карта остаётся в правке технолога");

	Второй = ЗаказПроведенияСценария(Контекст, Расход + 2);
	Провести(Второй);
	ПроверитьРавенство(Версия, Второй.ТЧТовары[1].Техкарта, "состав, равный действующей карте, получает её версию");
	ПроверитьРавенство(ВерсияДанных, ВерсияДанныхКарты(Версия), "состав, равный действующей карте, новой версии не заводит");

	Заказ.ТЧМатериалы.Удалить(Заказ.ТЧМатериалы[1]);
	Материал.КоличествоЗаЕдиницу = Расход + 3;
	Документы.ЗаказПокупателя.ПересчитатьСтрокуМатериала(Материал, СтрокаПродукции.Количество);
	Провести(Заказ);
	Проверить(ВерсияДанных <> ВерсияДанныхКарты(Версия), "изменённый состав перезаписывает карту дня");
	ПроверитьРавенство(Версия, СтрокаПродукции.Техкарта, "новая версия того же дня - тот же документ карты");
	ПроверитьРавенство(Расход + 3, РасходПоВерсииКарты(Версия), "новый состав зарегистрирован");
	ПроверитьРавенство(Контекст.Единица, ТехнологическиеКарты.СоставТехкартыПоРегистратору(Версия)[0].Упаковка,
		"упаковка карты сохраняется при регистрации из заказа");
	Возврат Версия;

КонецФункции

// Составы продукций: свёртка одинаковых строк, очистка упаковки без опции, перенос упаковки из карты -
// обе ветки опции «Использовать упаковку» независимо от её значения в базе.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Версия   - ДокументСсылка.ТехнологическаяКарта - карта продукции с упаковкой материала
//
Процедура ПроверитьУпаковкуСоставаПродукции(Контекст, Версия)

	Заказ = ЗаказПроведенияСценария(Контекст, 1);
	СтрокаПродукции = Заказ.ТЧТовары[1];
	Заказ.ТЧМатериалы[0].Упаковка = Контекст.Единица;
	ВторойМатериал = ДобавитьМатериалЗаказа(Контекст, Заказ, СтрокаПродукции, Контекст.Сырье, 2);
	ВторойМатериал.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();

	СУпаковкой = Документы.ЗаказПокупателя.СоставыПродукций(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Истина)[Контекст.Продукция];
	ПроверитьРавенство(2, СУпаковкой.Состав.Количество(), "с опцией разные упаковки материала - разные строки состава");
	Отказ = Ложь;
	Заказ.ПроверитьПроведениеЗаказа(Отказ, Истина);
	Проверить(Отказ, "с опцией один материал с разными упаковками не проводится");

	БезУпаковки = Документы.ЗаказПокупателя.СоставыПродукций(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Ложь)[Контекст.Продукция];
	ПроверитьРавенство(1, БезУпаковки.Состав.Количество(), "без опции строки материала сворачиваются");
	ПроверитьРавенство(3, БезУпаковки.Состав[0].Количество, "без опции количество свёрнутых строк суммируется");
	ПроверитьРавенство(Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка(), БезУпаковки.Состав[0].Упаковка,
		"без опции упаковка состава очищается");
	Отказ = Ложь;
	Заказ.ПроверитьПроведениеЗаказа(Отказ, Ложь);
	Проверить(Не Отказ, "без опции упаковка не участвует в проверке разных упаковок");
	Документы.ЗаказПокупателя.ПеренестиУпаковкуКарты(БезУпаковки.Состав, Версия);
	ПроверитьРавенство(Контекст.Единица, БезУпаковки.Состав[0].Упаковка, "упаковка переносится из базовой версии карты");
	ПолучитьСообщенияПользователю(Истина);

КонецПроцедуры

// Отказы проведения через проверку без записи: строка продукции без материалов, пустой материал, материал
// совпадает с продукцией, будущая карта продукции; закупаемый товар без материалов отказа не даёт.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказыПроведенияЗаказа(Контекст)

	ПроверитьРавенство(Перечисления.СпособыПополненияЗапасов.Производство, Контекст.Продукция.СпособПополнения,
		"продукция сценария пополняется производством");
	ПолучитьСообщенияПользователю(Истина);

	ТолькоТовар = ЗаказКлиентаСценария(Контекст);
	ТолькоТовар.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ПроверитьОтказПроверкиПроведения(ТолькоТовар, Ложь, "закупаемый товар без материалов проводится");

	БезМатериалов = ЗаказПроведенияСценария(Контекст, 1);
	БезМатериалов.ТЧМатериалы.Очистить();
	ПроверитьОтказПроверкиПроведения(БезМатериалов, Истина, "строка продукции без материалов не проводится");

	ПустойМатериал = ЗаказПроведенияСценария(Контекст, 1);
	ПустойМатериал.ТЧМатериалы[0].Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	ПроверитьОтказПроверкиПроведения(ПустойМатериал, Истина, "материал с пустой номенклатурой не проводится");

	СамаСебя = ЗаказПроведенияСценария(Контекст, 1);
	СамаСебя.ТЧМатериалы[0].Номенклатура = Контекст.Продукция;
	ПроверитьОтказПроверкиПроведения(СамаСебя, Истина, "продукция своим же материалом не проводится");

	Продукция = НоваяНоменклатура(Контекст, "будущая карта", Перечисления.ТипыНоменклатуры.Продукция);
	Завтра = КонецДня(ТекущаяДатаСеанса()) + 1;
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, СоставКарты(Контекст), Завтра);
	БудущаяКарта = ЗаказПроведенияСценария(Контекст, Контекст.Числа.РасходСырьяНаЕдиницу + 5);
	БудущаяКарта.ТЧТовары[1].Номенклатура = Продукция;
	ПроверитьОтказПроверкиПроведения(БудущаяКарта, Истина, "новая версия раньше будущей карты не проводится");
	Ожидаемое = ТехнологическиеКарты.ОшибкаДатыТехкарты(Завтра);
	ЕстьТекст = Ложь;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		ЕстьТекст = ЕстьТекст Или СтрНайти(Сообщение.Текст, Ожидаемое) > 0;
	КонецЦикла;
	Проверить(ЕстьТекст, "отказ по дате сообщает дату последней версии карты: " + Ожидаемое);

КонецПроцедуры

// Проверка проведения без записи даёт ожидаемый отказ.
//
// Параметры:
//  Заказ     - ДокументОбъект.ЗаказПокупателя - незаписанный заказ на производство
//  Ожидается - Булево - ожидается отказ
//  Описание  - Строка - что проверяется
//
Процедура ПроверитьОтказПроверкиПроведения(Заказ, Ожидается, Описание)

	Отказ = Ложь;
	Заказ.ПроверитьПроведениеЗаказа(Отказ, ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку"));
	ПроверитьРавенство(Ожидается, Отказ, Описание);

КонецПроцедуры

// Вид операции проведённого заказа не меняется; отмена проведения снимает запрет и карту не трогает.
//
// Параметры:
//  Заказ  - ДокументОбъект.ЗаказПокупателя - проведённый заказ на производство
//  Версия - ДокументСсылка.ТехнологическаяКарта - версия карты, зарегистрированная заказом
//
Процедура ПроверитьСменуВидаПроведенногоЗаказа(Заказ, Версия)

	Материал = Заказ.ТЧМатериалы[0];
	Материал.КоличествоЗаЕдиницу = Материал.КоличествоЗаЕдиницу + 1;
	Отказ = Ложь;
	Заказ.ПроверитьМатериалыПроведенногоЗаказа(РежимЗаписиДокумента.Запись, Отказ);
	Проверить(Отказ, "запись проведённого заказа с изменёнными материалами без перепроведения отклоняется");
	Отказ = Ложь;
	Заказ.ПроверитьМатериалыПроведенногоЗаказа(РежимЗаписиДокумента.Проведение, Отказ);
	Проверить(Не Отказ, "изменённые материалы проведённого заказа фиксируются перепроведением");
	Материал.КоличествоЗаЕдиницу = Материал.КоличествоЗаЕдиницу - 1;
	Отказ = Ложь;
	Заказ.ПроверитьМатериалыПроведенногоЗаказа(РежимЗаписиДокумента.Запись, Отказ);
	Проверить(Не Отказ, "проведённый заказ без изменения материалов записывается");
	ПолучитьСообщенияПользователю(Истина);

	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	Отказ = Ложь;
	Заказ.ПроверитьСменуВидаОперации(РежимЗаписиДокумента.Проведение, Отказ);
	Проверить(Отказ, "смена вида операции проведённого заказа при перепроведении отклоняется");
	Отказ = Ложь;
	Заказ.ПроверитьСменуВидаОперации(РежимЗаписиДокумента.Запись, Отказ);
	Проверить(Отказ, "смена вида операции проведённого заказа при записи отклоняется");
	Отказ = Ложь;
	Заказ.ПроверитьСменуВидаОперации(РежимЗаписиДокумента.ОтменаПроведения, Отказ);
	Проверить(Не Отказ, "смена вида вместе с отменой проведения разрешена");
	ПолучитьСообщенияПользователю(Истина);

	Заказ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Проверить(Не Заказ.Ссылка.Проведен, "отмена проведения заказа");
	ПроверитьРавенство(Перечисления.ВидыОперацийЗаказаПокупателя.Продажа, Заказ.Ссылка.ВидОперации,
		"смена вида операции записывается вместе с отменой проведения");
	Проверить(ТехнологическиеКарты.СоставТехкартыПоРегистратору(Версия).Количество() > 0,
		"отмена проведения заказа версию карты не трогает");
	ПолучитьСообщенияПользователю(Истина);

КонецПроцедуры

// Проверка заполнения на сервере - только при записи из формы в режиме «Запись» и не при пометке удаления.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПроверкуЗаполненияПриЗаписи(Контекст)

	Заказ = ЗаказКлиентаСценария(Контекст);
	Проверить(Не Заказ.НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписиДокумента.Запись),
		"запись кодом без свойства формы проверку заполнения не получает");
	Заказ.ДополнительныеСвойства.Вставить(РаботаСДокументами.СвойствоЗаписьИзФормы(), Истина);
	Проверить(Заказ.НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписиДокумента.Запись),
		"запись из формы проверяет заполнение, как до включения проведения");
	Проверить(Не Заказ.НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписиДокумента.Проведение),
		"при проведении из формы заполнение проверяет сама форма");
	Проверить(Не Заказ.НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписиДокумента.ОтменаПроведения),
		"отмена проведения проверку заполнения не требует");
	Заказ.ПометкаУдаления = Истина;
	Проверить(Не Заказ.НужнаПроверкаЗаполненияПриЗаписи(РежимЗаписиДокумента.Запись),
		"пометка удаления проверку заполнения не требует");

КонецПроцедуры

// Заголовок формы на языке сеанса: записанная продажа - «Записан», как до включения проведения; непроведённый заказ
// на производство - «Не проведён».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьЗаголовокФормыЗаказа(Контекст)

	Форма = Новый Структура("АвтоЗаголовок, Заголовок", Истина, "");
	Продажа = ЗаказКлиентаСценария(Контекст);
	Записать(Продажа);
	РаботаСДокументами.УстановитьЗаголовокФормыДокумента(Форма, Продажа);
	Записан = НСтр("ru = 'Записан'; fr = 'Enregistré'; en = 'Saved'; es = 'Guardado'");
	Проверить(СтрЗаканчиваетсяНа(Форма.Заголовок, ": " + Записан), "заголовок записанной продажи: " + Форма.Заголовок);

	НаПроизводство = ЗаказПроведенияСценария(Контекст, 1);
	Записать(НаПроизводство);
	РаботаСДокументами.УстановитьЗаголовокФормыДокумента(Форма, НаПроизводство);
	НеПроведен = НСтр("ru = 'Не проведён'; fr = 'Non reporté'; en = 'Not posted'; es = 'No contabilizado'");
	Проверить(СтрЗаканчиваетсяНа(Форма.Заголовок, ": " + НеПроведен),
		"заголовок непроведённого заказа на производство: " + Форма.Заголовок);

КонецПроцедуры

// Продажа не проводится: настоящая запись с проведением отклоняется. Отказ портит транзакцию сценария,
// поэтому шаг последний и проверяет только объект в памяти.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказПроведенияПродажи(Контекст)

	Продажа = ЗаказКлиентаСценария(Контекст);
	Отклонено = Ложь;
	Попытка
		Продажа.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	Проверить(Отклонено, "продажа не проводится");
	Проверить(Не Продажа.Проведен, "продажа остаётся непроведённой");

КонецПроцедуры

// Незаписанный заказ клиента без вызова Заполнить(), как в кабинете партнёра и лидах.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя - заказ с одной товарной строкой
//
Функция ЗаказКлиентаСценария(Контекст)

	Заказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	Заказ.Контрагент = Контекст.Контрагент;
	Заказ.Договор = Контекст.ДоговорПокупателя;
	Заказ.ЦенаВключаетНДС = Истина;
	Заказ.ДатаОтгрузки = Заказ.Дата;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Товар,
		Контекст.Числа.КоличествоПродажи, Контекст.Числа.ЦенаПродажи);
	Возврат Заказ;

КонецФункции

// Заказ, введённый на основании нового предложения с одной позицией, получает ожидаемый вид операции.
//
// Параметры:
//  Контекст       - Структура - см. НовыйКонтекст
//  Номенклатура   - СправочникСсылка.Номенклатура - позиция предложения
//  НаПроизводство - Булево - команда «Заказ клиента на производство», иначе «Заказ клиента»
//  Ожидаемый      - ПеречислениеСсылка.ВидыОперацийЗаказаПокупателя - вид операции заказа
//  Описание       - Строка - что проверяется
//
Процедура ПроверитьЗаказПоПредложению(Контекст, Номенклатура, НаПроизводство, Ожидаемый, Описание)

	Предложение = НовоеКоммерческоеПредложение(Контекст, Номенклатура, ПометкаТеста() + ": " + Описание);
	Записать(Предложение);
	Заказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	Если НаПроизводство Тогда
		Заказ.Заполнить(Новый Структура("Предложение, НаПроизводство", Предложение.Ссылка, Истина));
	Иначе
		Заказ.Заполнить(Предложение.Ссылка);
	КонецЕсли;
	Заказ.Дата = СледующаяДата(Контекст);
	Записать(Заказ);
	ПроверитьРавенство(Ожидаемый, Заказ.Ссылка.ВидОперации, "вид операции заказа " + Описание);

КонецПроцедуры

// Представление заказа на производство собирается обработчиком модуля менеджера.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - записанный заказ на производство
//
Процедура ПроверитьПредставлениеЗаказаНаПроизводство(Заказ)

	Шаблон = НСтр("ru = 'Заказ клиента на производство %1 от %2';
		|fr = 'Commande client en production %1 du %2';
		|en = 'Customer production order %1 dated %2';
		|es = 'Pedido de cliente para producción %1 del %2'");
	ДатаЗаказа = Формат(Заказ.Дата, "ДЛФ=DT");
	Ожидалось = СтрШаблон(Шаблон, Заказ.Номер, ДатаЗаказа);
	ПроверитьРавенство(Ожидалось, Строка(Заказ), "представление заказа на производство");

КонецПроцедуры

// Представление продажи остаётся стандартным. Эталон формата платформы - коммерческое предложение,
// у которого обработчиков представления нет: из него берётся разделитель номера и даты на языке сеанса.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПредставлениеПродажи(Контекст)

	Предложение = НовоеКоммерческоеПредложение(Контекст, Контекст.Товар, ПометкаТеста() + ": эталон представления");
	Записать(Предложение);
	ПрефиксПредложения = ПредставлениеОбъектаДокумента(Предложение.Метаданные()) + " " + Предложение.Номер;
	ДатаПредложения = Формат(Предложение.Дата, "ДЛФ=DT");
	ЭталонПредложения = Строка(Предложение.Ссылка);
	Проверить(СтрНачинаетсяС(ЭталонПредложения, ПрефиксПредложения) И СтрЗаканчиваетсяНа(ЭталонПредложения, ДатаПредложения),
		"стандартное представление предложения не в формате «представление номер … дата»: " + ЭталонПредложения);
	Разделитель = Сред(ЭталонПредложения, СтрДлина(ПрефиксПредложения) + 1,
		СтрДлина(ЭталонПредложения) - СтрДлина(ПрефиксПредложения) - СтрДлина(ДатаПредложения));

	Продажа = ЗаказКлиентаСценария(Контекст);
	Записать(Продажа);
	Ожидалось = ПредставлениеОбъектаДокумента(Продажа.Метаданные()) + " " + Продажа.Номер + Разделитель
		+ Формат(Продажа.Дата, "ДЛФ=DT");
	ПроверитьРавенство(Ожидалось, Строка(Продажа.Ссылка), "стандартное представление заказа-продажи");

КонецПроцедуры

// Представление объекта документа из метаданных; пустое - синоним, как у стандартного представления.
//
// Параметры:
//  МетаданныеДокумента - ОбъектМетаданных - документ
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеОбъектаДокумента(МетаданныеДокумента)

	Представление = МетаданныеДокумента.ПредставлениеОбъекта;
	Если ПустаяСтрока(Представление) Тогда
		Представление = МетаданныеДокумента.Синоним;
	КонецЕсли;
	Возврат Представление;

КонецФункции

// Количество заказов клиентов с пустым видом операции.
//
// Возвращаемое значение:
//  Число
//
Функция КоличествоЗаказовБезВидаОперации()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказаПокупателя.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

// Новое коммерческое предложение с одной товарной строкой.
//
// Параметры:
//  Контекст      - Структура - см. НовыйКонтекст
//  Номенклатура  - СправочникСсылка.Номенклатура - товар предложения
//  Описание      - Строка - описание товарной строки
//
// Возвращаемое значение:
//  ДокументОбъект.КоммерческоеПредложение - незаписанное предложение
//
Функция НовоеКоммерческоеПредложение(Контекст, Номенклатура, Описание)

	Предложение = Документы.КоммерческоеПредложение.СоздатьДокумент();
	Предложение.Заполнить(Неопределено);
	Предложение.Дата = СледующаяДата(Контекст);
	Предложение.ДатаОтгрузки = Предложение.Дата;
	Предложение.Организация = Контекст.Организация;
	Предложение.Контрагент = Контекст.Контрагент;
	Предложение.Договор = Контекст.ДоговорПокупателя;
	Предложение.ЦенаВключаетНДС = Истина;
	Предложение.Комментарий = ПометкаТеста();
	ДобавитьСтрокуТоваров(Контекст, Предложение, "ТЧТовары", Номенклатура,
		Контекст.Числа.КоличествоПродажи, Контекст.Числа.ЦенаПродажи);
	Предложение.ТЧТовары[0].Описание = Описание;
	Возврат Предложение;

КонецФункции

// Создаёт элемент с пустым способом пополнения, как запись базы до E2.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - существующая продукция без способа пополнения
//
Функция НоменклатураБезСпособаПополнения(Контекст)

	Номенклатура = Справочники.Номенклатура.СоздатьЭлемент();
	Номенклатура.Наименование = ПометкаТеста() + ": существующая номенклатура E2";
	Номенклатура.НаименованиеПолное = Номенклатура.Наименование;
	Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Продукция;
	Номенклатура.Единица = Контекст.Единица;
	Номенклатура.СтавкаНДС = Контекст.СтавкаНДС;
	Номенклатура.СпособПополнения = Перечисления.СпособыПополненияЗапасов.ПустаяСсылка();
	Номенклатура.ОбменДанными.Загрузка = Истина;
	Номенклатура.Записать();
	Возврат Номенклатура.Ссылка;

КонецФункции

// Создаёт группу с пустым способом пополнения для проверки границы миграции.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - группа без способа пополнения
//
Функция ГруппаНоменклатурыБезСпособаПополнения()

	Группа = Справочники.Номенклатура.СоздатьГруппу();
	Группа.Наименование = ПометкаТеста() + ": группа E2";
	Группа.ОбменДанными.Загрузка = Истина;
	Группа.Записать();
	Возврат Группа.Ссылка;

КонецФункции

// Количество элементов номенклатуры с пустым способом пополнения.
//
// Возвращаемое значение:
//  Число - количество незаполненных элементов; группы не учитываются
//
Функция КоличествоЭлементовБезСпособаПополнения()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И Номенклатура.СпособПополнения = ЗНАЧЕНИЕ(Перечисление.СпособыПополненияЗапасов.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

// Старая рецептура содержит две строки одного материала: при переносе расход суммируется.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  ДатаСоздания - Дата - дата старой номенклатуры, в том числе пустая
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - продукция без карты в регистре
//
Функция НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания)

	Ссылка = НоваяНоменклатура(Контекст, "перенос карты", Перечисления.ТипыНоменклатуры.Продукция);
	Объект = Ссылка.ПолучитьОбъект();
	Объект.ДатаСоздания = ДатаСоздания;
	Строка = Объект.ТехнологическаяКарта.Добавить();
	Строка.Номенклатура = Контекст.Сырье;
	Строка.ЕИ = Контекст.Единица;
	Строка.Количество = 2;
	Строка = Объект.ТехнологическаяКарта.Добавить();
	Строка.Номенклатура = Контекст.Сырье;
	Строка.ЕИ = Контекст.Единица;
	Строка.Количество = 3;
	Объект.Записать();
	Возврат Ссылка;

КонецФункции

// Количество всех документов карты, включая непроведённые.
//
// Параметры:
//  Продукция - СправочникСсылка.Номенклатура - проверяемая продукция
//
// Возвращаемое значение:
//  Число - количество документов
//
Функция КоличествоДокументовТехкарт(Продукция)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ Документ.ТехнологическаяКарта КАК Карта
		|ГДЕ Карта.Номенклатура = &Продукция");
	Запрос.УстановитьПараметр("Продукция", Продукция);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

#КонецОбласти

// BSLLS:MagicNumber-on

#Область ПотребностиПроизводства

// Потребности производства (E7): заказ клиента на производство пишет «Потребность», заказ поставщику - «Заказано»,
// поступление - «Пришло», возврат поставщику сторнирует «Пришло». Ожидания - план E7, п. 12.7: продукция P1
// (M1 ×2, M2 ×1 на единицу) ×10, P2 (M1 ×3) ×5.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПотребностиПроизводства(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Данные = ДанныеПотребностей(Контекст);
	ПроверитьПотребностьЗаказа(Контекст, Данные);
	ПроверитьЗакупкиБезПотребности(Контекст, Данные);
	ПроверитьЗаказыПоставщикуПотребности(Контекст, Данные);
	ПроверитьПоступленияПотребности(Контекст, Данные);
	ПроверитьВозвратыПотребности(Контекст, Данные);
	ПроверитьОтчетПотребностей(Данные);
	ПроверитьПерепроведениеПотребностей(Данные);
	ПроверитьЗаписьИзмененнойПотребности(Данные);
	ПроверитьОтказВводаБезПотребности(Контекст);

	Возврат РезультатСценария("потребность заказа в базовых единицах и перепроведение без дублей, закупка под продажу, "
		+ "непроведённый заказ и строка предварительного заказа без движений, ввод заказа поставщику по дефициту, "
		+ "явная продукция раньше распределения, излишек на последнюю продукцию, поступления по коду строки и по "
		+ "«Заказано» заказа поставщику, ввод поступления по заказу клиента, сторно возвратов по своему поступлению, "
		+ "отчёт с флагом «только дефицит», перепроведение и отмена проведения всех документов, отказ записи "
		+ "изменённой потребности, отказ ввода без потребности");

КонецФункции

// Данные сценария: продукция P1 - продукция контекста, P2 - новая, материалы M1 - сырьё контекста, M2 - новое.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - P1, P2, M1, M2, Заказ (ДокументСсылка.ЗаказПокупателя) и документы шагов по мере создания.
//
Функция ДанныеПотребностей(Контекст)

	Данные = Новый Структура;
	Данные.Вставить("P1", Контекст.Продукция);
	Данные.Вставить("P2", НоваяНоменклатура(Контекст, "продукция 2", Перечисления.ТипыНоменклатуры.Продукция));
	Данные.Вставить("M1", Контекст.Сырье);
	Данные.Вставить("M2", НоваяНоменклатура(Контекст, "сырьё 2", Перечисления.ТипыНоменклатуры.Сырье));
	Данные.Вставить("Заказ", Документы.ЗаказПокупателя.ПустаяСсылка());
	Данные.Вставить("Документы", Новый Массив);
	Возврат Данные;

КонецФункции

// Шаг 1: проведение заказа на производство и перепроведение без изменений.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьПотребностьЗаказа(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария из плана E7, п. 12.7.
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.P1, 10, Контекст.Числа.ЦенаПродажи);
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.P2, 5, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M1, 2);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M2, 1);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[2], Данные.M1, 3);
	Провести(Заказ);
	Данные.Заказ = Заказ.Ссылка;
	ПроверитьОстаткиПотребности(Данные, "20/0/0, 10/0/0, 15/0/0", "после проведения заказа");
	Заказ.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьОстаткиПотребности(Данные, "20/0/0, 10/0/0, 15/0/0", "после перепроведения заказа без изменений");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 2: заказ поставщику по продаже, по непроведённому заказу на производство и строка предварительного
// заказа движений потребности не дают.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьЗакупкиБезПотребности(Контекст, Данные)

	Продажа = ЗаказКлиентаСценария(Контекст);
	Записать(Продажа);
	ПоПродаже = НовыйЗаказПоставщикуПотребности(Контекст, Продажа.Ссылка);
	Проверить(Не ЗначениеЗаполнено(ПоПродаже.Основание), "ввод заказа поставщику по продаже основание не ставит");
	ПроверитьРавенство(1, ПоПродаже.ТЧТовары.Количество(), "ввод заказа поставщику по продаже - состав товаров");
	ПоПродаже.Основание = Продажа.Ссылка;
	Провести(ПоПродаже);
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(ПоПродаже.Ссылка), "заказ поставщику под продажу");

	// BSLLS:MagicNumber-off - количество строки закупки без движений.
	КоличествоСтроки = 5;
	// BSLLS:MagicNumber-on
	Непроведенный = ЗаказКлиентаСценария(Контекст);
	Непроведенный.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Записать(Непроведенный);
	ПодНепроведенный = НовыйЗаказПоставщикуПотребности(Контекст, Неопределено);
	ПодНепроведенный.Основание = Непроведенный.Ссылка;
	ДобавитьСтрокуЗакупкиПотребности(Контекст, ПодНепроведенный, Данные.M1, КоличествоСтроки, Неопределено);
	Провести(ПодНепроведенный);
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(ПодНепроведенный.Ссылка), "заказ поставщику под непроведённый заказ");

	Предварительный = НовыйЗаказПоставщикуПотребности(Контекст, Неопределено);
	Предварительный.ВидЗаказа = Перечисления.ВидыЗаказовПоставщику.Предварительный;
	ДобавитьСтрокуЗакупкиПотребности(Контекст, Предварительный, Данные.M1, КоличествоСтроки, Неопределено);
	Провести(Предварительный);
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(Предварительный.Ссылка), "предварительный заказ поставщику без основания");
	Итоговый = НовыйЗаказПоставщикуПотребности(Контекст, Неопределено);
	Итоговый.Основание = Данные.Заказ;
	Строка = ДобавитьСтрокуЗакупкиПотребности(Контекст, Итоговый, Данные.M1, КоличествоСтроки, Неопределено);
	Строка.ЗаказПоставщику = Предварительный.Ссылка;
	Провести(Итоговый);
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(Итоговый.Ссылка), "строка из предварительного заказа поставщику");
	ПроверитьОстаткиПотребности(Данные, "20/0/0, 10/0/0, 15/0/0", "после закупок без потребности");

КонецПроцедуры

// Шаги 3-4: ЗП1 вводом на основании (дефицит), правка строк с явной продукцией; ЗП2 по дефициту и с излишком.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьЗаказыПоставщикуПотребности(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария из плана E7, п. 12.7.
	ЗП1 = НовыйЗаказПоставщикуПотребности(Контекст, Данные.Заказ);
	ПроверитьРавенство(Данные.Заказ, ЗП1.Основание, "основание заказа поставщику по заказу на производство");
	ПроверитьРавенство("M1/P1 20, M2/P1 10, M1/P2 15", СтрокиЗакупкиСтрокой(Данные, ЗП1.ТЧТовары),
		"строки заказа поставщику по дефициту");
	ЗП1.ТЧТовары.Очистить();
	ДобавитьСтрокуЗакупкиПотребности(Контекст, ЗП1, Данные.M1, 30, Неопределено);
	ДобавитьСтрокуЗакупкиПотребности(Контекст, ЗП1, Данные.M1, 5, Данные.P1);
	ДобавитьСтрокуЗакупкиПотребности(Контекст, ЗП1, Данные.M2, 4, Данные.P1);
	Провести(ЗП1);
	ПроверитьОстаткиПотребности(Данные, "20/20/0, 10/4/0, 15/15/0", "ЗП1: явная продукция до распределения");

	Дефицит = РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа(Данные.Заказ);
	ПроверитьРавенство("M2/P1 6", СтрокиЗакупкиСтрокой(Данные, Дефицит), "дефицит заказа после ЗП1");
	ЗП2 = НовыйЗаказПоставщикуПотребности(Контекст, Неопределено);
	ЗП2.Основание = Данные.Заказ;
	Документы.ЗаказПоставщику.ЗаполнитьПоПотребности(ЗП2.ТЧТовары, Дефицит, ЗП2.ЦенаВключаетНДС, ЗП2.Контрагент);
	ЗП2.ТЧТовары[0].КоличествоУпаковок = 9;
	ЗП2.ТЧТовары[0].Количество = 9;
	ДобавитьСтрокуЗакупкиПотребности(Контекст, ЗП2, Данные.M1, 4, Неопределено);
	Провести(ЗП2);
	ПроверитьОстаткиПотребности(Данные, "20/20/0, 10/13/0, 15/19/0", "ЗП2: сверх дефицита и излишек на последнюю продукцию");
	Данные.Вставить("ЗП1", ЗП1.Ссылка);
	Данные.Вставить("ЗП2", ЗП2.Ссылка);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 5: ПТУ1 по ЗП1 (код строки и «Заказано» заказа поставщику), ПТУ2 по ЗП2, ПТУ3 по заказу клиента - только
// заполнение.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьПоступленияПотребности(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария из плана E7, п. 12.7.
	ПТУ1 = НовоеПоступлениеПотребности(Контекст, Данные.ЗП1);
	УстановитьКоличествоСтроки(ПТУ1.ТЧТовары[0], 22);
	УстановитьКоличествоСтроки(ПТУ1.ТЧТовары[1], 5);
	УстановитьКоличествоСтроки(ПТУ1.ТЧТовары[2], 4);
	Провести(ПТУ1);
	ПроверитьРавенство("M1/P1 20, M2/P1 4, M1/P2 7", ДвиженияПотребностиСтрокой(Данные, ПТУ1.Ссылка, "Пришло"),
		"ПТУ1: продукция по коду строки и по «Заказано» ЗП1");
	ПТУ2 = НовоеПоступлениеПотребности(Контекст, Данные.ЗП2);
	Провести(ПТУ2);
	ПроверитьОстаткиПотребности(Данные, "20/20/20, 10/13/13, 15/19/11", "после ПТУ1 и ПТУ2");

	ПТУ3 = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	ПТУ3.Заполнить(Данные.Заказ);
	ПроверитьРавенство(Данные.Заказ, ПТУ3.Основание, "основание поступления по заказу клиента");
	ПроверитьРавенство("M1 8", СтрокиЗакупкиСтрокой(Данные, ПТУ3.ТЧТовары), "поступление по заказу клиента: заказано - пришло");
	Данные.Вставить("ПТУ1", ПТУ1.Ссылка);
	Данные.Вставить("ПТУ2", ПТУ2.Ссылка);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 6: два возврата по ПТУ1 строкой «M1 без продукции» - сторно «Пришло» этого поступления в обратном порядке.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьВозвратыПотребности(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария из плана E7, п. 12.7.
	Возврат1 = НовыйВозвратПотребности(Контекст, Данные.ПТУ1, 10);
	Провести(Возврат1);
	ПроверитьРавенство("M1/P1 -3, M1/P2 -7", ДвиженияПотребностиСтрокой(Данные, Возврат1.Ссылка, "Пришло"),
		"Возврат1: сторно в обратном порядке продукции");
	Возврат2 = НовыйВозвратПотребности(Контекст, Данные.ПТУ1, 5);
	Провести(Возврат2);
	ПроверитьОстаткиПотребности(Данные, "20/20/12, 10/13/13, 15/19/4", "после возвратов: предел P2 исчерпан Возвратом1");
	Данные.Вставить("Возврат1", Возврат1.Ссылка);
	Данные.Вставить("Возврат2", Возврат2.Ссылка);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Отчёт по регистру: схема компонуется, флаг «только дефицит» отбрасывает строки без дефицита.
//
// Параметры:
//  Данные - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьОтчетПотребностей(Данные)

	СтрокиОтчета = СтрокиОтчетаПотребностей(Данные, Ложь);
	ПроверитьРавенство("M1/P1 20/20/12, M2/P1 10/13/13, M1/P2 15/19/4", СтрокиОтчета, "строки отчёта по заказу");
	ПроверитьРавенство("", СтрокиОтчетаПотребностей(Данные, Истина), "строки отчёта «только дефицит»");

КонецПроцедуры

// Шаг 7: перепроведение каждого документа, отмена проведения в обратном порядке и повторное проведение.
//
// Параметры:
//  Данные - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьПерепроведениеПотребностей(Данные)

	Итог = "20/20/12, 10/13/13, 15/19/4";
	Порядок = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Заказ,ЗП1,ЗП2,ПТУ1,ПТУ2,Возврат1,Возврат2", ",") Цикл
		Порядок.Добавить(Данные[Имя]);
	КонецЦикла;
	Для Каждого СсылкаДокумента Из Порядок Цикл
		СсылкаДокумента.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
		ПроверитьОстаткиПотребности(Данные, Итог, "перепроведение " + СсылкаДокумента);
	КонецЦикла;
	Для Индекс = 1 По Порядок.Количество() Цикл
		Порядок[Порядок.Количество() - Индекс].ПолучитьОбъект().Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЦикла;
	ПроверитьОстаткиПотребности(Данные, "", "после отмены проведения всех документов");
	Для Каждого СсылкаДокумента Из Порядок Цикл
		СсылкаДокумента.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	ПроверитьОстаткиПотребности(Данные, Итог, "после повторного проведения в прямом порядке");

КонецПроцедуры

// Шаг 8: проведённый заказ с другим количеством продукции в режиме «Запись» - отказ без записи.
//
// Параметры:
//  Данные - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьЗаписьИзмененнойПотребности(Данные)

	Заказ = Данные.Заказ.ПолучитьОбъект();
	СтрокаПродукции = Заказ.ТЧТовары[1];
	// BSLLS:MagicNumber-off - новое количество продукции P1.
	СтрокаПродукции.Количество = 12;
	СтрокаПродукции.КоличествоУпаковок = 12;
	// BSLLS:MagicNumber-on
	Для Каждого Материал Из Заказ.ТЧМатериалы.НайтиСтроки(Новый Структура("КодСтрокиПродукции", СтрокаПродукции.КодСтроки)) Цикл
		Документы.ЗаказПокупателя.ПересчитатьСтрокуМатериала(Материал, СтрокаПродукции.Количество);
	КонецЦикла;
	Отказ = Ложь;
	Заказ.ПроверитьМатериалыПроведенногоЗаказа(РежимЗаписиДокумента.Запись, Отказ);
	Проверить(Отказ, "запись проведённого заказа с изменённой потребностью без перепроведения отклоняется");
	ПолучитьСообщенияПользователю(Истина);

КонецПроцедуры

// Шаг 9, последний: ввод заказа поставщику на основании непроведённого заказа на производство - исключение.
// Исключение внутри Заполнить оставляет транзакцию пригодной только для отката.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказВводаБезПотребности(Контекст)

	Непроведенный = ЗаказКлиентаСценария(Контекст);
	Непроведенный.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Записать(Непроведенный);
	ЗаказПоставщику = Документы.ЗаказПоставщику.СоздатьДокумент();
	ТекстОшибки = "";
	Попытка
		ЗаказПоставщику.Заполнить(Непроведенный.Ссылка);
	Исключение
		ТекстОшибки = ОшибкаОднойСтрокой(ИнформацияОбОшибке());
	КонецПопытки;
	Ожидаемый = РегистрыНакопления.ПотребностиПроизводства.ТекстЗаказБезПотребности();
	Проверить(СтрНайти(ТекстОшибки, Ожидаемый) > 0, "ввод заказа поставщику без потребности: " + ТекстОшибки);

КонецПроцедуры

// Новый заказ поставщику сценария; при заполненном основании - ввод на основании.
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Основание - ДокументСсылка.ЗаказПокупателя, Неопределено - основание ввода.
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПоставщику - незаписанный заказ
//
Функция НовыйЗаказПоставщикуПотребности(Контекст, Основание)

	ЗаказПоставщику = НовыйДокумент(Контекст, "ЗаказПоставщику");
	Если Основание <> Неопределено Тогда
		ЗаказПоставщику.Заполнить(Основание);
		ЗаказПоставщику.Дата = СледующаяДата(Контекст);
		ЗаказПоставщику.Организация = Контекст.Организация;
	КонецЕсли;
	ЗаказПоставщику.ВидЗаказа = Перечисления.ВидыЗаказовПоставщику.Основной;
	ЗаказПоставщику.ДатаПоставки = ЗаказПоставщику.Дата;
	ЗаказПоставщику.Контрагент = Контекст.Контрагент;
	ЗаказПоставщику.Договор = Контекст.ДоговорПоставщика;
	ЗаказПоставщику.ЦенаВключаетНДС = Истина;
	Возврат ЗаказПоставщику;

КонецФункции

// Строка закупки с материалом, количеством, ценой сырья и продукцией.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Док        - ДокументОбъект.ЗаказПоставщику - документ
//  Материал   - СправочникСсылка.Номенклатура - материал
//  Количество - Число - количество
//  Продукция  - СправочникСсылка.Номенклатура, Неопределено - продукция строки
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти - добавленная строка
//
Функция ДобавитьСтрокуЗакупкиПотребности(Контекст, Док, Материал, Количество, Продукция)

	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Материал, Количество, Контекст.Числа.ЦенаСырья);
	Строка = Док.ТЧТовары[Док.ТЧТовары.Количество() - 1];
	Строка.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Док.ТЧТовары);
	Если Продукция <> Неопределено Тогда
		Строка.Продукция = Продукция;
	КонецЕсли;
	Возврат Строка;

КонецФункции

// Поступление на основании заказа поставщику со складом, операцией и валютой сценария.
//
// Параметры:
//  Контекст        - Структура - см. НовыйКонтекст
//  ЗаказПоставщику - ДокументСсылка.ЗаказПоставщику - основание
//
// Возвращаемое значение:
//  ДокументОбъект.ПоступлениеТоваровУслуг - незаписанное поступление
//
Функция НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику)

	Поступление = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Поступление.Заполнить(ЗаказПоставщику);
	Поступление.Дата = СледующаяДата(Контекст);
	Поступление.Организация = Контекст.Организация;
	Поступление.МестоХранения = Контекст.Склад;
	Поступление.Комментарий = ПометкаТеста();
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Поступление.Валюта = Контекст.Валюта;
	Поступление.КурсВалюты = 1;
	Для Каждого Строка Из Поступление.ТЧТовары Цикл
		Строка.Цена = Контекст.Числа.ЦенаСырья;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Строка, Поступление.ЦенаВключаетНДС);
	КонецЦикла;
	Возврат Поступление;

КонецФункции

// Возврат поставщику на основании поступления: остаётся только первая строка (M1 без продукции) с количеством.
//
// Параметры:
//  Контекст    - Структура - см. НовыйКонтекст
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - основание
//  Количество  - Число - возвращаемое количество
//
// Возвращаемое значение:
//  ДокументОбъект.ВозвратПоставщику - незаписанный возврат
//
Функция НовыйВозвратПотребности(Контекст, Поступление, Количество)

	ДокВозврат = Документы.ВозвратПоставщику.СоздатьДокумент();
	ДокВозврат.Заполнить(Поступление);
	ДокВозврат.Дата = СледующаяДата(Контекст);
	ДокВозврат.Комментарий = ПометкаТеста();
	ДокВозврат.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровПоставщику;
	Пока ДокВозврат.ТЧТовары.Количество() > 1 Цикл
		ДокВозврат.ТЧТовары.Удалить(ДокВозврат.ТЧТовары.Количество() - 1);
	КонецЦикла;
	ДокВозврат.ТЧСерии.Очистить();
	УстановитьКоличествоСтроки(ДокВозврат.ТЧТовары[0], Количество);
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(ДокВозврат.ТЧТовары[0], ДокВозврат.ЦенаВключаетНДС);
	Возврат ДокВозврат;

КонецФункции

// Количество строки в упаковках и в базовых единицах (коэффициент упаковки сценария - 1).
//
// Параметры:
//  Строка     - СтрокаТабличнойЧасти - строка товаров
//  Количество - Число - количество
//
Процедура УстановитьКоличествоСтроки(Строка, Количество) Экспорт

	Строка.КоличествоУпаковок = Количество;
	Строка.Количество = Количество;
	Строка.Сумма = Количество * Строка.Цена;
	Строка.СуммаСНДС = Строка.Сумма;

КонецПроцедуры

// Остатки потребности заказа строкой «Потребность/Заказано/Пришло» по строкам M1/P1, M2/P1, M1/P2; пустая строка -
// остатков нет.
//
// Параметры:
//  Данные    - Структура - см. ДанныеПотребностей
//  Ожидалось - Строка - ожидаемые остатки
//  Описание  - Строка - что проверяется
//
Процедура ПроверитьОстаткиПотребности(Данные, Ожидалось, Описание)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Остатки.Продукция КАК Продукция,
	|	Остатки.Материал КАК Материал,
	|	Остатки.ПотребностьОстаток КАК Потребность,
	|	Остатки.ЗаказаноОстаток КАК Заказано,
	|	Остатки.ПришлоОстаток КАК Пришло
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства.Остатки(, Заказ = &Заказ) КАК Остатки";
	Запрос.УстановитьПараметр("Заказ", Данные.Заказ);
	Остатки = Запрос.Выполнить().Выгрузить();
	Части = Новый Массив;
	Пары = Новый Массив;
	Пары.Добавить(СтрРазделить("M1,P1", ","));
	Пары.Добавить(СтрРазделить("M2,P1", ","));
	Пары.Добавить(СтрРазделить("M1,P2", ","));
	Для Каждого Пара Из Пары Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Материал", Данные[Пара[0]]);
		Отбор.Вставить("Продукция", Данные[Пара[1]]);
		Найденные = Остатки.НайтиСтроки(Отбор);
		Если Найденные.Количество() > 0 Тогда
			Строка = Найденные[0];
			Часть = СтрШаблон("%1/%2/%3", СтрокаЧисла(Строка.Потребность), СтрокаЧисла(Строка.Заказано),
				СтрокаЧисла(Строка.Пришло));
			Части.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	ПроверитьРавенство(Ожидалось, СтрСоединить(Части, ", "), "остатки потребностей " + Описание);
	ПроверитьРавенство(Части.Количество(), Остатки.Количество(), "лишние строки остатков потребностей " + Описание);

КонецПроцедуры

// Движения документа по одному ресурсу строкой «M/P количество» в порядке M1/P1, M2/P1, M1/P2.
//
// Параметры:
//  Данные      - Структура - см. ДанныеПотребностей
//  Регистратор - ДокументСсылка - документ
//  ИмяРесурса  - Строка - ресурс регистра
//
// Возвращаемое значение:
//  Строка - движения
//
Функция ДвиженияПотребностиСтрокой(Данные, Регистратор, ИмяРесурса)

	Набор = РегистрыНакопления.ПотребностиПроизводства.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	Таблица = Набор.Выгрузить();
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Таблица Цикл
		Строка.Количество = Строка[ИмяРесурса];
	КонецЦикла;
	Возврат СтрокиЗакупкиСтрокой(Данные, Таблица);

КонецФункции

// Строки с колонками Материал (или Номенклатура), Продукция (может отсутствовать) и Количество строкой
// «M/P количество» в порядке M1/P1, M2/P1, M1/P2, M1, M2.
//
// Параметры:
//  Данные - Структура - см. ДанныеПотребностей
//  Строки - ТаблицаЗначений, ТабличнаяЧасть - строки
//
// Возвращаемое значение:
//  Строка - строки через запятую
//
Функция СтрокиЗакупкиСтрокой(Данные, Строки)

	Имена = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("M1,M2,P1,P2", ",") Цикл
		Имена.Вставить(Данные[Имя], Имя);
	КонецЦикла;
	Суммы = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Структура = Новый Структура("Материал, Номенклатура, Продукция");
		ЗаполнитьЗначенияСвойств(Структура, Строка);
		Материал = ?(Структура.Материал = Неопределено, Структура.Номенклатура, Структура.Материал);
		Ключ = Имена[Материал] + ?(ЗначениеЗаполнено(Структура.Продукция), "/" + Имена[Структура.Продукция], "");
		Суммы.Вставить(Ключ, ?(Суммы[Ключ] = Неопределено, 0, Суммы[Ключ]) + Строка.Количество);
	КонецЦикла;
	Части = Новый Массив;
	Для Каждого Ключ Из СтрРазделить("M1/P1,M2/P1,M1/P2,M1,M2", ",") Цикл
		Если Суммы[Ключ] <> Неопределено И Суммы[Ключ] <> 0 Тогда
			Части.Добавить(Ключ + " " + СтрокаЧисла(Суммы[Ключ]));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Число движений потребностей документа.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ
//
// Возвращаемое значение:
//  Число - записей регистра
//
Функция ЧислоДвиженийПотребности(Регистратор)

	Набор = РегистрыНакопления.ПотребностиПроизводства.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	Возврат Набор.Количество();

КонецФункции

// Детальные строки отчёта «Потребности производства» по заказу строкой «M/P потребность/заказано/пришло» в порядке
// M1/P1, M2/P1, M1/P2. Поля выводятся явно (детальные записи с автовыбором без измерений компоновка сворачивает),
// общий итог отключён.
//
// Параметры:
//  Данные        - Структура - см. ДанныеПотребностей
//  ТолькоДефицит - Булево - параметр отчёта
//
// Возвращаемое значение:
//  Строка - строки результата
//
Функция СтрокиОтчетаПотребностей(Данные, ТолькоДефицит)

	Схема = Отчеты.ПотребностиПроизводства.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТолькоДефицит", ТолькоДефицит);
	// Общий итог вариант выводит в конце: в коллекцию значений он попал бы строкой без измерений.
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов",
		РасположениеИтоговКомпоновкиДанных.Нет);
	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Заказ");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Данные.Заказ;
	Отбор.Использование = Истина;
	Настройки.Структура.Очистить();
	Детали = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Для Каждого ИмяПоля Из СтрРазделить("Продукция,Материал,Характеристика,Потребность,Заказано,Пришло", ",") Цикл
		Поле = Детали.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);

	Имена = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("M1,M2,P1,P2", ",") Цикл
		Имена.Вставить(Данные[Имя], Имя);
	КонецЦикла;
	ПоКлючам = Новый Соответствие;
	Лишние = Новый Массив;
	Для Каждого СтрокаОтчета Из Результат Цикл
		Материал = ?(Имена[СтрокаОтчета.Материал] = Неопределено, "?", Имена[СтрокаОтчета.Материал]);
		Продукция = ?(Имена[СтрокаОтчета.Продукция] = Неопределено, "?", Имена[СтрокаОтчета.Продукция]);
		Ключ = Материал + "/" + Продукция;
		Значение = СтрШаблон("%1 %2/%3/%4", Ключ, СтрокаЧисла(СтрокаОтчета.Потребность),
			СтрокаЧисла(СтрокаОтчета.Заказано), СтрокаЧисла(СтрокаОтчета.Пришло));
		Если ПоКлючам[Ключ] = Неопределено Тогда
			ПоКлючам.Вставить(Ключ, Значение);
		Иначе
			Лишние.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Части = Новый Массив;
	Для Каждого Ключ Из СтрРазделить("M1/P1,M2/P1,M1/P2", ",") Цикл
		Если ПоКлючам[Ключ] <> Неопределено Тогда
			Части.Добавить(ПоКлючам[Ключ]);
			ПоКлючам.Удалить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючИЗначение Из ПоКлючам Цикл
		Лишние.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	Если Лишние.Количество() > 0 Тогда
		Части.Добавить("лишние: " + СтрСоединить(Лишние, "; "));
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

#КонецОбласти

#Область СтадииЗаказа

// Стадии заказа клиента на производство (E8): пересчёт из каждого документа контура, откаты отменой проведения и
// возвратом, поздняя веха, оплата двумя путями, продажи без стадий. Ожидаемые значения - по коду
// ПроизводственныеЗаказы.РассчитатьСтадию: заказ O1 - товар 3 и продукция 10 по цене продажи, материал - сырьё
// контекста 2 на единицу продукции (потребность 20).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСтадииЗаказа(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// Отгрузки сценария идут без автовыпуска (E9): включённый в базе переключатель дал бы отказ по материалам.
	Константы.ИспользоватьВыпускПродукцииПриПродаже.Установить(Ложь);
	// BSLLS:MagicNumber-off - количества сценария: товар 3 + 3 + 1, продукция на склад 1.
	ДокументЗакупки(Контекст, Контекст.Товар, 7, Контекст.Числа.ЦенаЗакупки);
	// BSLLS:MagicNumber-on
	Данные = Новый Структура;
	ПроверитьЧерновикИПроведениеСтадии(Контекст, Данные);
	ПроверитьЗакупкиСтадии(Контекст, Данные);
	ПроверитьВыпускСтадии(Контекст, Данные);
	ПроверитьОтгрузкиСтадии(Контекст, Данные);
	ПроверитьОплатыСтадии(Контекст, Данные);
	ПроверитьПозднююВехуСтадии(Контекст);
	ПроверитьОтменуПроведенияЗаказаСтадии(Данные);
	ПроверитьПродажиБезСтадий(Контекст);

	Возврат РезультатСценария("черновик и перепроведение без дублей истории, заказ поставщику, восполнение и откат "
		+ "отменой поступления, выпуск частями, отгрузка частями, возврат и его отмена, оплата по реализации, аванс "
		+ "«на основании заказа» с зачётом в реализации, отмена оплаты, аванс по строке оснований, поздняя веха, "
		+ "формируется потребность, отмена проведения заказа со связанными документами, продажа и смена вида операции "
		+ "без стадий");

КонецФункции

// Шаги 1-2: запись без проведения, повторная запись, проведение и перепроведение.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - документы сценария по мере создания
//
Процедура ПроверитьЧерновикИПроведениеСтадии(Контекст, Данные)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	// BSLLS:MagicNumber-off - продукция 10, записей истории 1 и 2.
	Заказ = ЗаказНаПроизводствоСтадии(Контекст, 10);
	Записать(Заказ);
	Данные.Вставить("Заказ", Заказ);
	ПроверитьСтадиюЗаказа(Заказ.Ссылка, Стадии.Черновик, "○○○○○", "запись без проведения");
	Заказ.Записать();
	ПроверитьРавенство(1, ЧислоЗаписейИстории(Заказ.Ссылка), "записей истории после повторной записи черновика");

	Провести(Заказ);
	ПроверитьСтадиюЗаказа(Заказ.Ссылка, Стадии.ЗаказПоставщику, "○○○○○", "проведение без закупок");
	Заказ.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(2, ЧислоЗаписейИстории(Заказ.Ссылка), "записей истории после перепроведения");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаги 3-4: заказ поставщику по дефициту, два поступления, отмена второго и повторное проведение.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьЧерновикИПроведениеСтадии
//
Процедура ПроверитьЗакупкиСтадии(Контекст, Данные)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Заказ = Данные.Заказ.Ссылка;
	ЗаказПоставщику = НовыйЗаказПоставщикуПотребности(Контекст, Заказ);
	Провести(ЗаказПоставщику);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ВосполнениеПотребности, "●○○○○", "заказ поставщику на всю потребность");

	// BSLLS:MagicNumber-off - поступления 12 и 8 из потребности 20.
	Поступление1 = НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику.Ссылка);
	УстановитьКоличествоСтроки(Поступление1.ТЧТовары[0], 12);
	Провести(Поступление1);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ВосполнениеПотребности, "●◐○○○", "первое поступление");
	ПроверитьРавенство(0.6, Расчет.ДоляПоступления, "доля поступления после первого поступления");
	Поступление2 = НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику.Ссылка);
	УстановитьКоличествоСтроки(Поступление2.ТЧТовары[0], 8);
	// BSLLS:MagicNumber-on
	Провести(Поступление2);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ВПроизводстве, "●●○○○", "второе поступление");
	Поступление2.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ВосполнениеПотребности, "●◐○○○", "отмена проведения второго поступления");
	Провести(Поступление2);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ВПроизводстве, "●●○○○", "повторное проведение второго поступления");

КонецПроцедуры

// Шаг 5: ручные выпуски 4 и 6 по заказу.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьЧерновикИПроведениеСтадии
//
Процедура ПроверитьВыпускСтадии(Контекст, Данные)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Заказ = Данные.Заказ.Ссылка;
	// BSLLS:MagicNumber-off - выпуски 4 и 6 из 10.
	ВыпускСтадии(Контекст, Заказ, 4);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ВПроизводстве, "●●◐○○", "первый выпуск");
	ПроверитьРавенство(0.4, Расчет.ДоляВыпуска, "доля выпуска после первого выпуска");
	ВыпускСтадии(Контекст, Заказ, 6);
	// BSLLS:MagicNumber-on
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОтгрузки, "●●●○○", "второй выпуск");

КонецПроцедуры

// Шаг 6: реализация товара и части продукции, реализация остатка, возврат одной единицы и отмена возврата.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьЧерновикИПроведениеСтадии
//
Процедура ПроверитьОтгрузкиСтадии(Контекст, Данные)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Заказ = Данные.Заказ.Ссылка;
	Цена = Контекст.Числа.ЦенаПродажи;
	// BSLLS:MagicNumber-off - отгрузки: товар 3 и продукция 4, затем продукция 6; возврат 1.
	Реализация1 = РеализацияСтадии(Контекст, Заказ);
	УстановитьКоличествоСтроки(Реализация1.ТЧТовары[1], 4);
	Провести(Реализация1);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОтгрузки, "●●●◐○", "первая реализация");
	ПроверитьРавенство(7 * Цена, Расчет.Долг, "долг после первой реализации");

	Реализация2 = РеализацияСтадии(Контекст, Заказ);
	Реализация2.ТЧТовары.Удалить(0);
	УстановитьКоличествоСтроки(Реализация2.ТЧТовары[0], 6);
	Провести(Реализация2);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОплаты, "●●●●○", "вторая реализация");
	ПроверитьРавенство(13 * Цена, Расчет.Долг, "долг после второй реализации");

	Возврат1 = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	Возврат1.Заполнить(Реализация2.Ссылка);
	Возврат1.Дата = СледующаяДата(Контекст);
	Возврат1.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	УстановитьКоличествоСтроки(Возврат1.ТЧТовары[0], 1);
	Возврат1.ТЧСерии.Очистить();
	Провести(Возврат1);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОтгрузки, "●●●◐○", "возврат одной единицы");
	ПроверитьРавенство(12 * Цена, Расчет.Долг, "долг после возврата");
	// BSLLS:MagicNumber-on
	Возврат1.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОплаты, "●●●●○", "отмена проведения возврата");
	Данные.Вставить("Реализация1", Реализация1.Ссылка);
	Данные.Вставить("Реализация2", Реализация2);

КонецПроцедуры

// Шаг 7: оплата первой реализации, аванс «на основании заказа» (объект расчётов - сам ПКО) с зачётом во второй
// реализации, отмена проведения первой оплаты.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьОтгрузкиСтадии
//
Процедура ПроверитьОплатыСтадии(Контекст, Данные)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Заказ = Данные.Заказ.Ссылка;
	Цена = Контекст.Числа.ЦенаПродажи;
	// BSLLS:MagicNumber-off - оплаты 700 (первая реализация) и 600 (аванс под вторую).
	Оплата1 = ДокументОплатыВКассу(Контекст, Данные.Реализация1, 7 * Цена);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОплаты, "●●●●◐", "оплата первой реализации");
	ПроверитьРавенство(0.5385, Расчет.ДоляОплаты, "доля оплаты после первой оплаты");

	ЧислоЗаписей = ЧислоЗаписейИстории(Заказ);
	Аванс = НовыйДокумент(Контекст, "ПриходныйКассовыйОрдер");
	Аванс.Заполнить(Заказ);
	Аванс.Дата = СледующаяДата(Контекст);
	Аванс.Касса = Контекст.Касса;
	Аванс.СтатьяДДС = СтатьяДДС(Контекст, Аванс.ХозяйственнаяОперация);
	Аванс.Сумма = 6 * Цена;
	Провести(Аванс);
	ПроверитьРавенство(Заказ, Аванс.Основание, "основание аванса по заказу");
	ПроверитьРавенство(ЧислоЗаписей, ЧислоЗаписейИстории(Заказ), "аванс «на основании заказа» стадию не пересчитывает");

	Реализация2 = Данные.Реализация2;
	СтрокаЗачета = Реализация2.ТЧЗачётАвансов.Добавить();
	СтрокаЗачета.Основание = Аванс.Ссылка;
	СтрокаЗачета.Сумма = 6 * Цена;
	// BSLLS:MagicNumber-on
	Провести(Реализация2);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.Выполнен, "●●●●●", "зачёт аванса во второй реализации");
	ПроверитьРавенство(1, Расчет.ДоляОплаты, "доля оплаты выполненного заказа");

	Оплата1.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОплаты, "●●●●◐", "отмена проведения оплаты первой реализации");

КонецПроцедуры

// Шаг 8: заказ без закупок и выпуска, отгруженный со склада, - «Ожидает оплаты», а не «Заказ поставщику»; заказ без
// материалов - «Формируется потребность», аванс по строке оснований на заказ двигает только долю оплаты.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПозднююВехуСтадии(Контекст)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Заказ = ЗаказНаПроизводствоСтадии(Контекст, 1);
	Провести(Заказ);
	ПроверитьСтадиюЗаказа(Заказ.Ссылка, Стадии.ЗаказПоставщику, "○○○○○", "заказ без закупок");
	ДокументЗакупки(Контекст, Контекст.Продукция, 1, Контекст.Числа.ЦенаЗакупки);
	Провести(РеализацияСтадии(Контекст, Заказ.Ссылка));
	ПроверитьСтадиюЗаказа(Заказ.Ссылка, Стадии.ОжидаетОплаты, "○○○●○", "поздняя веха: отгрузка без закупок и выпуска");

	БезМатериалов = ЗаказКлиентаСценария(Контекст);
	БезМатериалов.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Провести(БезМатериалов);
	ПроверитьСтадиюЗаказа(БезМатериалов.Ссылка, Стадии.ФормируетсяПотребность, "○○○○○", "заказ без материалов");
	ДокументОплатыВКассу(Контекст, БезМатериалов.Ссылка, Контекст.Числа.ЦенаПродажи);
	Расчет = ПроверитьСтадиюЗаказа(БезМатериалов.Ссылка, Стадии.ФормируетсяПотребность, "○○○○◐",
		"аванс по строке оснований на заказ");
	ПроверитьРавенство(-Контекст.Числа.ЦенаПродажи, Расчет.Долг, "долг заказа после аванса");

КонецПроцедуры

// Шаг 9: отмена проведения заказа со связанными закупками, выпусками и реализациями.
//
// Параметры:
//  Данные - Структура - см. ПроверитьЧерновикИПроведениеСтадии
//
Процедура ПроверитьОтменуПроведенияЗаказаСтадии(Данные)

	Заказ = Данные.Заказ;
	Заказ.Прочитать();
	Заказ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьСтадиюЗаказа(Заказ.Ссылка, Перечисления.СтатусыЗаказовПокупателя.Черновик, "○○●●◐",
		"отмена проведения заказа со связанными документами");
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(Заказ.Ссылка), "движений потребности после отмены проведения заказа");

КонецПроцедуры

// Шаг 10: заказ-продажа и реализация по нему - прежние статусы; заказ на производство, переведённый в продажу
// записью и вместе с отменой проведения, - «Новый».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПродажиБезСтадий(Контекст)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Продажа = ДокументЗаказаПокупателя(Контекст, Контекст.Товар, 1, Контекст.Числа.ЦенаПродажи);
	Проверить(ПроизводственныеЗаказы.РассчитатьСтадию(Продажа) = Неопределено, "у продажи нет расчёта стадии");
	ПроверитьСтатусПродажи(Продажа, Стадии.Новый, "запись продажи");
	ДокументРеализацииПоЗаказу(Контекст, Продажа);
	ПроверитьСтатусПродажи(Продажа, Стадии.Собран, "реализация по продаже");

	Черновик = ЗаказНаПроизводствоСтадии(Контекст, 1);
	Записать(Черновик);
	ПроверитьСтадиюЗаказа(Черновик.Ссылка, Стадии.Черновик, "○○○○○", "черновик перед сменой вида операции");
	Черновик.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	Черновик.Записать();
	ПроверитьСтатусПродажи(Черновик.Ссылка, Стадии.Новый, "черновик, переведённый в продажу");

	Проведенный = ЗаказКлиентаСценария(Контекст);
	Проведенный.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Провести(Проведенный);
	Проведенный.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	Проведенный.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьСтатусПродажи(Проведенный.Ссылка, Стадии.Новый, "смена вида операции вместе с отменой проведения");

КонецПроцедуры

// Заказ на производство: строка товара контекста и строка продукции с материалом по карте (2 сырья на единицу).
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Продукции - Число - количество продукции
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя - незаписанный заказ
//
Функция ЗаказНаПроизводствоСтадии(Контекст, Продукции)

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, Продукции, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Контекст.Сырье, Контекст.Числа.РасходСырьяНаЕдиницу);
	Возврат Заказ;

КонецФункции

// Проведённый ручной выпуск продукции контекста с основанием - заказом и сырьём по карте.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Заказ      - ДокументСсылка.ЗаказПокупателя - основание
//  Количество - Число - выпуск
//
Процедура ВыпускСтадии(Контекст, Заказ, Количество)

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Основание = Заказ;
	Выпуск.Номенклатура = Контекст.Продукция;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = Количество;
	Выпуск.Количество = Количество;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ЗаполнитьСырьеПоТехкарте(Контекст, Выпуск, Количество);
	Провести(Выпуск);

КонецПроцедуры

// Реализация, заполненная по заказу, со складом сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументСсылка.ЗаказПокупателя - основание
//
// Возвращаемое значение:
//  ДокументОбъект.РеализацияТоваровУслуг - непроведённая реализация
//
Функция РеализацияСтадии(Контекст, Заказ)

	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.Заполнить(Заказ);
	Реализация.Дата = СледующаяДата(Контекст);
	Реализация.МестоХранения = Контекст.Склад;
	Реализация.Комментарий = ПометкаТеста();
	Возврат Реализация;

КонецФункции

// Стадия и индикатор расчёта совпадают с ожидаемыми и с последней записью истории.
//
// Параметры:
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  Стадия    - ПеречислениеСсылка.СтатусыЗаказовПокупателя - ожидаемая стадия
//  Индикатор - Строка - ожидаемый индикатор
//  Описание  - Строка - шаг сценария
//
// Возвращаемое значение:
//  Структура - см. ПроизводственныеЗаказы.РассчитатьСтадию
//
Функция ПроверитьСтадиюЗаказа(Заказ, Стадия, Индикатор, Описание)

	Расчет = ПроизводственныеЗаказы.РассчитатьСтадию(Заказ);
	Проверить(Расчет <> Неопределено, Описание + ": нет расчёта стадии у заказа на производство");
	ПроверитьРавенство(Стадия, Расчет.Стадия, Описание + " - стадия расчёта");
	ПроверитьРавенство(Индикатор, Расчет.Индикатор, Описание + " - индикатор расчёта");
	Запись = ПроизводственныеЗаказы.ДанныеСтадии(Заказ);
	Проверить(Запись <> Неопределено, Описание + ": нет записи истории");
	ПроверитьРавенство(Стадия, Запись.Стадия, Описание + " - стадия в истории");
	ПроверитьРавенство(Индикатор, Запись.Индикатор, Описание + " - индикатор в истории");
	Возврат Расчет;

КонецФункции

// Последняя запись истории заказа-продажи: ожидаемый статус без индикатора.
//
// Параметры:
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ
//  Статус   - ПеречислениеСсылка.СтатусыЗаказовПокупателя - ожидаемый статус
//  Описание - Строка - шаг сценария
//
Процедура ПроверитьСтатусПродажи(Заказ, Статус, Описание)

	Запись = ПроизводственныеЗаказы.ДанныеСтадии(Заказ);
	Проверить(Запись <> Неопределено, Описание + ": нет записи истории");
	ПроверитьРавенство(Статус, Запись.Стадия, Описание + " - статус");
	Проверить(Не Запись.ЭтоЗаписьСтадии, Описание + ": у продажи записана стадия");

КонецПроцедуры

// Число записей истории статусов заказа.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ
//
// Возвращаемое значение:
//  Число - записей регистра по заказу
//
Функция ЧислоЗаписейИстории(Заказ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Записей
	|ИЗ
	|	РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам КАК История
	|ГДЕ
	|	История.ЗаказПокупателя = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Записей;

КонецФункции

#КонецОбласти

#Область АвтовыпускПриОтгрузке

// Автовыпуск при отгрузке (E9): проведение реализации по заказу на производство создаёт выпуск продукции на секунду
// раньше, материалы - из партий под заказ, затем из общей очереди с «ИзОстатка»; реализация списывает продукцию по ФИФО.
// Шаг между документами - две секунды. Настоящий отказ проведения - последним шагом: после исключения транзакция
// сценария годится только для отката.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАвтовыпускПриОтгрузке(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Данные = ДанныеАвтовыпускаСценария(Контекст);
	Константы.ИспользоватьВыпускПродукцииПриПродаже.Установить(Истина);
	ПроверитьПервуюОтгрузкуАвтовыпуска(Контекст, Данные);
	ПроверитьВторуюОтгрузкуАвтовыпуска(Контекст, Данные);
	ПроверитьОтменуИПометкуАвтовыпуска(Данные);
	ПроверитьЗапретыАвтовыпуска(Контекст, Данные);
	ПроверитьОднуСекундуАвтовыпуска(Контекст);
	ПроверитьСериюАвтовыпуска(Контекст);
	ПроверитьОтказПоМатериаламАвтовыпуска(Контекст);

	Возврат РезультатСценария("автовыпуск на секунду раньше реализации, партии под заказ и продукция по техкарте, "
		+ "себестоимость продажи из выпуска, ручной выпуск и «ИзОстатка», перепроведение без дублей, отмена проведения "
		+ "и перенос пометки удаления, запрет правки, выключенная константа и продажа без автовыпуска, граница по "
		+ "моменту времени, две реализации в одну секунду, серия продукции, отказ по нехватке материалов");

КонецФункции

// Шаг 1: остатки, продукция P2 по техкарте, заказ на производство P1 x 10 (M1 x 2), закупка M1 x 12 под заказ.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - документы и номенклатура сценария
//
Функция ДанныеАвтовыпускаСценария(Контекст)

	Данные = Новый Структура;
	Данные.Вставить("M1", Контекст.Сырье);
	Данные.Вставить("P1", Контекст.Продукция);
	Данные.Вставить("M2", НоваяНоменклатура(Контекст, "сырьё 2", Перечисления.ТипыНоменклатуры.Сырье));
	Данные.Вставить("P2", НоваяНоменклатура(Контекст, "продукция по техкарте", Перечисления.ТипыНоменклатуры.Продукция));
	// BSLLS:MagicNumber-off - остатки: товар 3 по 50, M1 50 по 40, M2 10 по 30; заказ P1 10, P2 3; под заказ M1 12.
	ТехнологическиеКарты.ЗаписатьТехкарту(Данные.P2, СоставИзМатериала(Контекст, Данные.M2, 1), Контекст.Дата);
	ДокументЗакупки(Контекст, Контекст.Товар, 3, 50);
	ДокументЗакупки(Контекст, Данные.M1, 50, 40);
	ДокументЗакупки(Контекст, Данные.M2, 10, 30);

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.P1, 10, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M1, 2);
	Провести(Заказ);
	Данные.Вставить("Заказ", Заказ.Ссылка);

	ЗаказПоставщику = НовыйЗаказПоставщикуПотребности(Контекст, Заказ.Ссылка);
	Провести(ЗаказПоставщику);
	Поступление = НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику.Ссылка);
	УстановитьКоличествоСтроки(Поступление.ТЧТовары[0], 12);
	// BSLLS:MagicNumber-on
	Провести(Поступление);
	Данные.Вставить("Поступление", Поступление.Ссылка);
	Возврат Данные;

КонецФункции

// Шаг 2: реализация T x 3, P1 x 6 - расчёт без записи, проведение, себестоимость и стадия; продукция без материалов
// в заказе - по техкарте (проведение заказа такую строку продукции со способом «Производство» не пропускает (E6), поэтому
// ветка проверяется на записанном заказе).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАвтовыпускаСценария
//
Процедура ПроверитьПервуюОтгрузкуАвтовыпуска(Контекст, Данные)

	Реализация = РеализацияАвтовыпуска(Контекст, Данные.Заказ);
	// BSLLS:MagicNumber-off - P1 6 из 10; M1 12 партией под заказ по 10, товар 3 по 50; P2 3 по техкарте (M2 3).
	УстановитьКоличествоСтроки(Реализация.ТЧТовары[1], 6);
	Расчет = Производство.ДанныеАвтовыпуска(Реализация);
	Проверить(Расчет.Активен, "автовыпуск реализации по заказу на производство активен");
	ПроверитьРавенство("P1 6", ПродукцияАвтовыпускаСтрокой(Данные, Расчет.Продукция), "продукция расчёта");
	ПроверитьРавенство("M1 12 под заказ", МатериалыАвтовыпускаСтрокой(Данные, Расчет.Материалы), "материалы расчёта");
	ПроверитьРавенство(0, Расчет.ИзОстатка.Количество(), "«ИзОстатка» при покрытии партиями под заказ");

	ЗаказПоТехкарте = ЗаказКлиентаСценария(Контекст);
	ЗаказПоТехкарте.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ЗаказПоТехкарте.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, ЗаказПоТехкарте, "ТЧТовары", Данные.P2, 3, Контекст.Числа.ЦенаПродажи);
	Записать(ЗаказПоТехкарте);
	РеализацияПоТехкарте = РеализацияСтадии(Контекст, ЗаказПоТехкарте.Ссылка);
	РасчетПоТехкарте = Производство.ДанныеАвтовыпуска(РеализацияПоТехкарте);
	ПроверитьРавенство("P2 3", ПродукцияАвтовыпускаСтрокой(Данные, РасчетПоТехкарте.Продукция),
		"продукция без материалов в заказе - по техкарте");
	ПроверитьРавенство("M2 3", МатериалыАвтовыпускаСтрокой(Данные, РасчетПоТехкарте.Материалы), "материалы по техкарте");
	ПроверитьРавенство(0, РасчетПоТехкарте.ИзОстатка.Количество(), "«ИзОстатка» без потребности заказа");

	Провести(Реализация);
	Автовыпуск = ЕдинственныйАвтовыпуск(Реализация.Ссылка, "первая реализация");
	Проверить(Не ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Данные.P1, НачалоДня(Контекст.Дата)),
		"автовыпуск не требует ручного перезаполнения при смене карты");
	ПроверитьРавенство(Реализация.Дата - 1, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "Дата"),
		"дата автовыпуска на секунду раньше реализации");
	ПроверитьРавенство(120, СуммаПриходаВыпуска(Автовыпуск), "себестоимость автовыпуска: M1 12 x 10");
	ПроверитьРавенство(270, ОборотыПродаж(Реализация.Ссылка).Себестоимость,
		"себестоимость продажи: автовыпуск 120 + товар 150");
	Остаток = ОстатокТовара(Контекст.Склад, Данные.M1);
	ПроверитьРавенство(50, Остаток.Количество, "общая партия M1 не тронута");
	ПроверитьРавенство(2000, Остаток.Сумма, "стоимость общей партии M1");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, Данные.P1).Количество, "остаток P1 после отгрузки");
	// BSLLS:MagicNumber-on
	ПроверитьСтадиюЗаказа(Данные.Заказ, Перечисления.СтатусыЗаказовПокупателя.ВосполнениеПотребности, "●◐◐◐○",
		"первая реализация с автовыпуском");
	Данные.Вставить("Реализация1", Реализация.Ссылка);

КонецПроцедуры

// Шаги 3-4: ручной выпуск P1 x 2 по заказу, реализация P1 x 4 выпускает 2 из общей очереди («ИзОстатка» 4),
// перепроведение без дублей.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАвтовыпускаСценария
//
Процедура ПроверитьВторуюОтгрузкуАвтовыпуска(Контекст, Данные)

	// BSLLS:MagicNumber-off - ручной выпуск 2 (M1 4 по 40), реализация 4: автовыпуск 2 (M1 4 по 40).
	ВыпускСтадии(Контекст, Данные.Заказ, 2);
	Проверить(ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Данные.P1, НачалоДня(Контекст.Дата)),
		"ручной выпуск рядом с автовыпуском требует перезаполнения при смене карты");
	Реализация = РеализацияАвтовыпуска(Контекст, Данные.Заказ);
	Реализация.ТЧТовары.Удалить(0);
	УстановитьКоличествоСтроки(Реализация.ТЧТовары[0], 4);
	Расчет = Производство.ДанныеАвтовыпуска(Реализация);
	ПроверитьРавенство("P1 2", ПродукцияАвтовыпускаСтрокой(Данные, Расчет.Продукция),
		"к выпуску: отгрузка 4 минус свободные 2 ручного выпуска");
	ПроверитьРавенство("M1 4", МатериалыАвтовыпускаСтрокой(Данные, Расчет.Материалы), "M1 из общей очереди");

	Провести(Реализация);
	Автовыпуск = ЕдинственныйАвтовыпуск(Реализация.Ссылка, "вторая реализация");
	ПроверитьРавенство(4, ИзОстаткаДвижений(Автовыпуск), "«ИзОстатка» автовыпуска");
	ПроверитьРавенство(320, ОборотыПродаж(Реализация.Ссылка).Себестоимость,
		"себестоимость продажи: партия ручного выпуска 160 + автовыпуска 160");
	ПроверитьРавенство(42, ОстатокТовара(Контекст.Склад, Данные.M1).Количество, "M1 после второй реализации");
	Расчет = ПроверитьСтадиюЗаказа(Данные.Заказ, Перечисления.СтатусыЗаказовПокупателя.ОжидаетОплаты, "●◐●●○",
		"вторая реализация: «ИзОстатка» в поступлении");
	ПроверитьРавенство(0.8, Расчет.ДоляПоступления, "доля поступления: пришло 12 + из остатка 4 из 20");

	Реализация.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(Автовыпуск, ЕдинственныйАвтовыпуск(Реализация.Ссылка, "перепроведение"), "тот же автовыпуск");
	ПроверитьРавенство(4, ИзОстаткаДвижений(Автовыпуск), "«ИзОстатка» после перепроведения");
	ПроверитьРавенство(42, ОстатокТовара(Контекст.Склад, Данные.M1).Количество, "M1 после перепроведения");
	// BSLLS:MagicNumber-on
	Данные.Вставить("Реализация2", Реализация);
	Данные.Вставить("Автовыпуск2", Автовыпуск);

КонецПроцедуры

// Шаг 5: отмена проведения второй реализации распроводит автовыпуск, пометка удаления переходит и снимается,
// повторное проведение проводит тот же автовыпуск.
//
// Параметры:
//  Данные - Структура - см. ПроверитьВторуюОтгрузкуАвтовыпуска
//
Процедура ПроверитьОтменуИПометкуАвтовыпуска(Данные)

	Реализация = Данные.Реализация2;
	Автовыпуск = Данные.Автовыпуск2;
	Реализация.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Проверить(Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "Проведен"),
		"автовыпуск распроведён отменой проведения реализации");
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(Автовыпуск), "движения потребностей распроведённого автовыпуска");
	ПроверитьСтадиюЗаказа(Данные.Заказ, Перечисления.СтатусыЗаказовПокупателя.ВосполнениеПотребности, "●◐◐◐○",
		"отмена проведения второй реализации");

	Реализация.УстановитьПометкуУдаления(Истина);
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "ПометкаУдаления"),
		"пометка удаления реализации перешла на автовыпуск");
	Реализация.УстановитьПометкуУдаления(Ложь);
	Проверить(Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "ПометкаУдаления"),
		"снятие пометки удаления реализации снято у автовыпуска");

	Провести(Реализация);
	ПроверитьРавенство(Автовыпуск, ЕдинственныйАвтовыпуск(Реализация.Ссылка, "повторное проведение"),
		"повторное проведение - тот же автовыпуск");
	ПроверитьСтадиюЗаказа(Данные.Заказ, Перечисления.СтатусыЗаказовПокупателя.ОжидаетОплаты, "●◐●●○",
		"повторное проведение второй реализации");

КонецПроцедуры

// Шаг 6: без записи - запрет правки автовыпуска и ручного выпуска с основанием-реализацией, выключенная константа,
// продажа, граница по моменту времени.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьВторуюОтгрузкуАвтовыпуска
//
Процедура ПроверитьЗапретыАвтовыпуска(Контекст, Данные)

	Отказ = Ложь;
	Производство.ПроверитьПравкуАвтовыпуска(Данные.Автовыпуск2.ПолучитьОбъект(), Отказ);
	Проверить(Отказ, "ручная правка автовыпуска отклоняется");
	Ручной = НовыйДокумент(Контекст, "ВыпускПродукции");
	Ручной.Основание = Данные.Реализация1;
	Отказ = Ложь;
	Производство.ПроверитьПравкуАвтовыпуска(Ручной, Отказ);
	Проверить(Отказ, "ручной выпуск с основанием-реализацией отклоняется");
	ПолучитьСообщенияПользователю(Истина);

	// Первая реализация предшествует ручному выпуску и второй реализации: их её расчёт не учитывает.
	Расчет = Производство.ДанныеАвтовыпуска(Данные.Реализация1);
	ПроверитьРавенство("P1 6", ПродукцияАвтовыпускаСтрокой(Данные, Расчет.Продукция),
		"граница по моменту времени: поздние выпуски и реализации не учитываются");

	Константы.ИспользоватьВыпускПродукцииПриПродаже.Установить(Ложь);
	Расчет = Производство.ДанныеАвтовыпуска(Данные.Реализация1);
	Проверить(Не Расчет.Управляется И Не Расчет.Активен, "выключенная константа: автовыпуск не управляется");
	Константы.ИспользоватьВыпускПродукцииПриПродаже.Установить(Истина);

	Продажа = ДокументЗаказаПокупателя(Контекст, Контекст.Товар, 1, Контекст.Числа.ЦенаПродажи);
	РеализацияПродажи = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	РеализацияПродажи.Заполнить(Продажа);
	Проверить(Не Производство.ДанныеАвтовыпуска(РеализацияПродажи).Активен, "реализация по продаже без автовыпуска");

КонецПроцедуры

// Шаг 7: две реализации одного заказа в одну секунду получают свои автовыпуски; перепроведение обеих не меняет их.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОднуСекундуАвтовыпуска(Контекст)

	// BSLLS:MagicNumber-off - заказ P1 10: отгрузки 6 и 4 в одну секунду.
	Заказ = ЗаказНаПроизводствоСтадии(Контекст, 10);
	Провести(Заказ);
	Дата = ДатаЧерезДвеСекунды(Контекст);
	Первая = РеализацияПродукцииАвтовыпуска(Контекст, Заказ.Ссылка, 6, Дата);
	Вторая = РеализацияПродукцииАвтовыпуска(Контекст, Заказ.Ссылка, 4, Дата);
	Провести(Первая);
	Провести(Вторая);
	ПроверитьРавенство(6, ВыпущеноАвтовыпуском(Первая.Ссылка), "первая реализация секунды");
	ПроверитьРавенство(4, ВыпущеноАвтовыпуском(Вторая.Ссылка), "вторая реализация секунды");
	Первая.Записать(РежимЗаписиДокумента.Проведение);
	Вторая.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(6, ВыпущеноАвтовыпуском(Первая.Ссылка), "первая реализация секунды после перепроведения");
	ПроверитьРавенство(4, ВыпущеноАвтовыпуском(Вторая.Ссылка), "вторая реализация секунды после перепроведения");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 8: продукция с серией в строке реализации выпускается с той же серией и списывается; материал с серией из
// общего остатка склада подбирается по серии.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьСериюАвтовыпуска(Контекст)

	СерияПродукции = НоваяСерия(Контекст.Продукция, "серия продукции");
	МатериалССерией = НоваяНоменклатура(Контекст, "сырьё с серией", Перечисления.ТипыНоменклатуры.Сырье);
	СерияМатериала = НоваяСерия(МатериалССерией, "серия сырья");
	// BSLLS:MagicNumber-off - остаток сырья с серией 5, на единицу продукции 2.
	Поступление = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Поступление.Контрагент = Контекст.Контрагент;
	Поступление.Договор = Контекст.ДоговорПоставщика;
	Поступление.ЦенаВключаетНДС = Истина;
	Поступление.Валюта = Контекст.Валюта;
	Поступление.КурсВалюты = 1;
	ДобавитьСтрокуТоваров(Контекст, Поступление, "ТЧТовары", МатериалССерией, 5, Контекст.Числа.ЦенаСырья);
	Поступление.ТЧТовары[0].Серия = СерияМатериала;
	Провести(Поступление);

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, 1, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], МатериалССерией, 2);
	Провести(Заказ);
	Реализация = РеализацияПродукцииАвтовыпуска(Контекст, Заказ.Ссылка, 1, ДатаЧерезДвеСекунды(Контекст));
	Реализация.ТЧТовары[0].Серия = СерияПродукции;
	Провести(Реализация);
	Автовыпуск = ЕдинственныйАвтовыпуск(Реализация.Ссылка, "реализация с серией");
	Строки = Автовыпуск.ТЧГотоваяПродукция.Выгрузить();
	ПроверитьРавенство(1, Строки.Количество(), "строк готовой продукции автовыпуска с серией");
	ПроверитьРавенство(СерияПродукции, Строки[0].Серия, "серия готовой продукции автовыпуска");
	Материалы = Автовыпуск.ТЧТовары.Выгрузить();
	ПроверитьРавенство(1, Материалы.Количество(), "строк материалов автовыпуска с серией");
	ПроверитьРавенство(СерияМатериала, Материалы[0].Серия, "серия материала из общего остатка");
	ПроверитьРавенство(2, ИзОстаткаДвижений(Автовыпуск), "«ИзОстатка» материала с серией");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Серия номенклатуры сценария.
//
// Параметры:
//  Владелец - СправочникСсылка.Номенклатура - номенклатура
//  Название - Строка - часть наименования
//
// Возвращаемое значение:
//  СправочникСсылка.СерииНоменклатуры - записанная серия
//
Функция НоваяСерия(Владелец, Название)

	Серия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
	Серия.Владелец = Владелец;
	Серия.Наименование = ПометкаТеста() + ": " + Название;
	Серия.Записать();
	Возврат Серия.Ссылка;

КонецФункции

// Шаг 9, последний: заказ P3 x 5 с M3 x 2 при остатке M3 3 - отказ проведения реализации с сообщением про M3.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказПоМатериаламАвтовыпуска(Контекст)

	ИмяМатериала = "сырьё 3";
	M3 = НоваяНоменклатура(Контекст, ИмяМатериала, Перечисления.ТипыНоменклатуры.Сырье);
	P3 = НоваяНоменклатура(Контекст, "продукция 3", Перечисления.ТипыНоменклатуры.Продукция);
	// BSLLS:MagicNumber-off - остаток M3 3, нужно 10.
	ДокументЗакупки(Контекст, M3, 3, Контекст.Числа.ЦенаСырья);
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", P3, 5, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], M3, 2);
	// BSLLS:MagicNumber-on
	Провести(Заказ);
	Реализация = РеализацияАвтовыпуска(Контекст, Заказ.Ссылка);
	Реализация.ТЧТовары.Удалить(0);
	ПолучитьСообщенияПользователю(Истина);
	Проведена = Истина;
	ТекстОшибки = "";
	Попытка
		Реализация.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		// После исключения в записи транзакция сценария годится только для отката: к базе больше не обращаемся.
		Проведена = Ложь;
		ТекстОшибки = ОшибкаОднойСтрокой(ИнформацияОбОшибке());
	КонецПопытки;
	Проверить(Не Проведена, "реализация при нехватке материалов автовыпуска не проводится");
	Сообщения = СообщенияПользователю();
	Проверить(СтрНайти(Сообщения + ТекстОшибки, ПометкаТеста() + ": " + ИмяМатериала) > 0,
		"в отказе названа недостающая M3:" + Сообщения + " | ошибка: " + ТекстОшибки);

КонецПроцедуры

// Реализация, заполненная по заказу, со складом сценария и датой через две секунды после предыдущего документа.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументСсылка.ЗаказПокупателя - основание
//
// Возвращаемое значение:
//  ДокументОбъект.РеализацияТоваровУслуг - непроведённая реализация
//
Функция РеализацияАвтовыпуска(Контекст, Заказ)

	Реализация = РеализацияСтадии(Контекст, Заказ);
	Реализация.Дата = ДатаЧерезДвеСекунды(Контекст);
	Возврат Реализация;

КонецФункции

// Реализация только продукции заказа (строка товара удалена) с количеством и датой.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ со строками «товар, продукция»
//  Количество - Число - отгружаемая продукция
//  Дата       - Дата - дата реализации
//
// Возвращаемое значение:
//  ДокументОбъект.РеализацияТоваровУслуг - непроведённая реализация
//
Функция РеализацияПродукцииАвтовыпуска(Контекст, Заказ, Количество, Дата)

	Реализация = РеализацияСтадии(Контекст, Заказ);
	Реализация.ТЧТовары.Удалить(0);
	УстановитьКоличествоСтроки(Реализация.ТЧТовары[0], Количество);
	Реализация.Дата = Дата;
	Возврат Реализация;

КонецФункции

// Дата документа через две секунды после предыдущего: автовыпуск на секунду раньше реализации не совпадает по секунде
// с предыдущим документом сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Дата - дата документа
//
Функция ДатаЧерезДвеСекунды(Контекст)

	СледующаяДата(Контекст);
	Возврат СледующаяДата(Контекст);

КонецФункции

// Состав технологической карты из одного материала.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Материал   - СправочникСсылка.Номенклатура - материал
//  Количество - Число - расход на единицу
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Упаковка, Количество
//
Функция СоставИзМатериала(Контекст, Материал, Количество)

	Состав = СоставКарты(Контекст);
	Состав[0].Номенклатура = Материал;
	Состав[0].Количество = Количество;
	Возврат Состав;

КонецФункции

// Единственный автовыпуск реализации.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация
//  Описание   - Строка - шаг сценария
//
// Возвращаемое значение:
//  ДокументСсылка.ВыпускПродукции - проведённый автовыпуск
//
Функция ЕдинственныйАвтовыпуск(Реализация, Описание)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Выпуски.Ссылка КАК Ссылка,
	|	Выпуски.Проведен КАК Проведен
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|ГДЕ
	|	Выпуски.Основание = &Реализация");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Выпуски = Запрос.Выполнить().Выгрузить();
	ПроверитьРавенство(1, Выпуски.Количество(), Описание + ": автовыпусков у реализации");
	Проверить(Выпуски[0].Проведен, Описание + ": автовыпуск не проведён");
	Возврат Выпуски[0].Ссылка;

КонецФункции

// Выпущено продукции проведённым автовыпуском реализации.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация
//
// Возвращаемое значение:
//  Число - количество готовой продукции
//
Функция ВыпущеноАвтовыпуском(Реализация)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ГотоваяПродукция.Количество), 0) КАК Количество
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ГотоваяПродукция
	|		ПО Выпуски.Ссылка = ГотоваяПродукция.Ссылка
	|ГДЕ
	|	Выпуски.Основание = &Реализация
	|	И Выпуски.Проведен");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Возврат ПерваяСтрока(Запрос, "Количество").Количество;

КонецФункции

// Себестоимость, оприходованная выпуском.
//
// Параметры:
//  Выпуск - ДокументСсылка.ВыпускПродукции - выпуск
//
// Возвращаемое значение:
//  Число - сумма прихода регистра товаров
//
Функция СуммаПриходаВыпуска(Выпуск)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Движения.Сумма), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Выпуск
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
	Запрос.УстановитьПараметр("Выпуск", Выпуск);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;

КонецФункции

// «ИзОстатка» в движениях потребностей документа.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ
//
// Возвращаемое значение:
//  Число - сумма ресурса
//
Функция ИзОстаткаДвижений(Регистратор)

	Набор = РегистрыНакопления.ПотребностиПроизводства.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	Возврат Набор.Выгрузить().Итог("ИзОстатка");

КонецФункции

// Продукция расчёта автовыпуска строкой «P1 6, P2 3» в порядке строк.
//
// Параметры:
//  Данные    - Структура - номенклатура сценария (P1, P2, M1, M2)
//  Продукция - ТаблицаЗначений - см. Производство.ДанныеАвтовыпуска
//
// Возвращаемое значение:
//  Строка - продукция
//
Функция ПродукцияАвтовыпускаСтрокой(Данные, Продукция)

	Имена = ИменаНоменклатурыАвтовыпуска(Данные);
	Части = Новый Массив;
	Для Каждого Строка Из Продукция Цикл
		Части.Добавить(Имена[Строка.Номенклатура] + " " + СтрокаЧисла(Строка.Количество));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Материалы расчёта автовыпуска строкой «M1 12 под заказ, M2 3»: партия поступления сценария - «под заказ».
//
// Параметры:
//  Данные    - Структура - номенклатура и поступление под заказ сценария
//  Материалы - ТаблицаЗначений - см. Производство.ДанныеАвтовыпуска
//
// Возвращаемое значение:
//  Строка - материалы
//
Функция МатериалыАвтовыпускаСтрокой(Данные, Материалы)

	Имена = ИменаНоменклатурыАвтовыпуска(Данные);
	Части = Новый Массив;
	Для Каждого Строка Из Материалы Цикл
		Часть = Имена[Строка.Номенклатура] + " " + СтрокаЧисла(Строка.Количество);
		Если ЗначениеЗаполнено(Строка.Партия) Тогда
			Часть = Часть + ?(Строка.Партия = Данные.Поступление, " под заказ", " партия " + Строка(Строка.Партия));
		КонецЕсли;
		Части.Добавить(Часть);
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

Функция ИменаНоменклатурыАвтовыпуска(Данные)

	Имена = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("M1,M2,P1,P2", ",") Цикл
		Имена.Вставить(Данные[Имя], Имя);
	КонецЦикла;
	Возврат Имена;

КонецФункции

#КонецОбласти

#Область РучнойВыпуск

// Ручной выпуск (E10): материалы заполняет та же процедура модуля менеджера, что вызывает форма документа, - по картам на
// дату документа, в одиночном и многострочном режиме; продукция без карты материалы не меняет; совет перезаполнить
// выпуски при смене карты видит ручной мультивыпуск.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийРучнойВыпуск(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - остатки M1 20 по 10, M2 10 по 30; карта P: M1 2, через два дня M1 3; карта P2: M2 1.
	Данные = Новый Структура;
	Данные.Вставить("M1", Контекст.Сырье);
	Данные.Вставить("P1", Контекст.Продукция);
	Данные.Вставить("M2", НоваяНоменклатура(Контекст, "сырьё 2", Перечисления.ТипыНоменклатуры.Сырье));
	Данные.Вставить("P2", НоваяНоменклатура(Контекст, "продукция 2", Перечисления.ТипыНоменклатуры.Продукция));
	ДатаВторойВерсии = НачалоДня(Контекст.Дата) + 2 * 86400;
	ТехнологическиеКарты.ЗаписатьТехкарту(Данные.P1, СоставИзМатериала(Контекст, Данные.M1, 3), ДатаВторойВерсии);
	ТехнологическиеКарты.ЗаписатьТехкарту(Данные.P2, СоставИзМатериала(Контекст, Данные.M2, 1), Контекст.Дата);
	ДокументЗакупки(Контекст, Данные.M1, 20, 10);
	ДокументЗакупки(Контекст, Данные.M2, 10, 30);

	ПроверитьОдиночныйРучнойВыпуск(Контекст, Данные, ДатаВторойВерсии);
	ПроверитьРучнойМультивыпуск(Контекст, Данные);

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Номенклатура = Контекст.Товар;
	Выпуск.КоличествоУпаковок = 1;
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧТовары", Данные.M2, 4, 0);
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Ложь);
	ПроверитьРавенство("M2 4", МатериалыРучногоВыпускаСтрокой(Данные, Выпуск), "продукция без карты не меняет материалы");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("материалы по карте на дату документа, одиночный режим не читает строки продукции, "
		+ "мультивыпуск по двум картам, продукция без карты, совет перезаполнить выпуски по строке мультивыпуска");

КонецФункции

// Шаг 1: выпуск P 5 в одиночном режиме с посторонней строкой материалов и строкой P2 в ТЧГотоваяПродукция.
//
// Параметры:
//  Контекст         - Структура - см. НовыйКонтекст
//  Данные           - Структура - номенклатура сценария
//  ДатаВторойВерсии - Дата - день второй версии карты P
//
Процедура ПроверитьОдиночныйРучнойВыпуск(Контекст, Данные, ДатаВторойВерсии)

	// BSLLS:MagicNumber-off - P 5: по первой версии M1 10, по второй M1 15.
	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Номенклатура = Данные.P1;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = 5;
	Выпуск.Количество = 5;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧТовары", Контекст.Товар, 1, 0);
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Данные.P2, 9, 0);
	ДатаВыпуска = Выпуск.Дата;
	Выпуск.Дата = ДатаВторойВерсии;
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Ложь);
	ПроверитьРавенство("M1 15", МатериалыРучногоВыпускаСтрокой(Данные, Выпуск), "материалы на дату второй версии карты");
	Выпуск.Дата = ДатаВыпуска;
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Ложь);
	ПроверитьРавенство("M1 10", МатериалыРучногоВыпускаСтрокой(Данные, Выпуск),
		"материалы на дату выпуска, продукция из шапки, посторонняя строка заменена");
	СтрокаМатериалов = Выпуск.ТЧТовары[0];
	ПроверитьРавенство(10, СтрокаМатериалов.Количество, "количество строки материалов рассчитано");
	ПроверитьРавенство(2, СтрокаМатериалов.КоличествоЗаЕдиницу, "расход на единицу по карте");
	ПроверитьРавенство(1, СтрокаМатериалов.КодСтроки, "код строки материалов");
	Провести(Выпуск);

	ПроверитьРавенство(10, ОстатокТовара(Контекст.Склад, Данные.M1).Количество, "M1 после одиночного выпуска");
	ПроверитьРавенство(100, ОстатокТовара(Контекст.Склад, Данные.P1).Сумма, "себестоимость P после одиночного выпуска");
	Проверить(Не ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Данные.P2, НачалоДня(Контекст.Дата)),
		"посторонняя строка продукции одиночного выпуска не записана");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 2: мультивыпуск P 1 и P2 2 по двум картам, себестоимость итогом, совет перезаполнить выпуски по строке P2.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - номенклатура сценария
//
Процедура ПроверитьРучнойМультивыпуск(Контекст, Данные)

	// BSLLS:MagicNumber-off - M1 2 по 10 и M2 2 по 30: к 100 первого выпуска прибавляется 80.
	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Данные.P1, 1, 0);
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Данные.P2, 2, 0);
	ЗаполнитьЗначенияСвойств(Выпуск, Выпуск.ТЧГотоваяПродукция[0],
		"Номенклатура, Характеристика, Серия, Упаковка, КоличествоУпаковок, Количество");
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧТовары", Контекст.Товар, 1, 0);
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Истина);
	ПроверитьРавенство("M1 2, M2 2", МатериалыРучногоВыпускаСтрокой(Данные, Выпуск), "материалы мультивыпуска по двум картам");
	ПроверитьРавенство(2, Выпуск.ТЧТовары[1].КодСтроки, "код второй строки материалов");
	Провести(Выпуск);

	ПроверитьРавенство(8, ОстатокТовара(Контекст.Склад, Данные.M1).Количество, "M1 после мультивыпуска");
	ПроверитьРавенство(8, ОстатокТовара(Контекст.Склад, Данные.M2).Количество, "M2 после мультивыпуска");
	ПроверитьРавенство(180, ОстатокТовара(Контекст.Склад, Данные.P1).Сумма + ОстатокТовара(Контекст.Склад, Данные.P2).Сумма,
		"себестоимость продукции после мультивыпуска");
	Проверить(ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Данные.P2, НачалоДня(Контекст.Дата)),
		"ручной мультивыпуск требует перезаполнения при смене карты второй продукции");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Материалы выпуска строкой «M1 2, M2 2» по возрастанию: порядок строк фасад не задаёт. Имена - ключи структуры данных
// сценария.
//
// Параметры:
//  Данные - Структура - номенклатура сценария
//  Выпуск - ДокументОбъект.ВыпускПродукции - выпуск
//
// Возвращаемое значение:
//  Строка - материалы и количества упаковок
//
Функция МатериалыРучногоВыпускаСтрокой(Данные, Выпуск)

	Части = Новый СписокЗначений;
	Для Каждого СтрокаТЧ Из Выпуск.ТЧТовары Цикл
		Имя = Строка(СтрокаТЧ.Номенклатура);
		Для Каждого КлючИЗначение Из Данные Цикл
			Если КлючИЗначение.Значение = СтрокаТЧ.Номенклатура Тогда
				Имя = КлючИЗначение.Ключ;
			КонецЕсли;
		КонецЦикла;
		Части.Добавить(Имя + " " + СтрокаЧисла(СтрокаТЧ.КоличествоУпаковок));
	КонецЦикла;
	Части.СортироватьПоЗначению();
	Возврат СтрСоединить(Части.ВыгрузитьЗначения(), ", ");

КонецФункции

#КонецОбласти

#Область АвторВОтветственного

// BSLLS:DeprecatedMethodCall-off - сценарий заполняет устаревший общий реквизит, как в базе до обновления.

// Перенос автора в ответственного (2.0.15.28): обработчик обновления переносит общий реквизит УдалитьАвторОбщий
// в пустой Ответственный записью в режиме загрузки. Проведённый документ остаётся проведённым с теми же движениями,
// непроведённая оплата не перепроводит связанную налоговую накладную, заполненный ответственный не меняется,
// справочник без ответственного сохраняет автора, повторный запуск ничего не пишет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАвторВОтветственного(Контекст)

	Автор = ПараметрыСеанса.Пользователь;
	Другой = НовыйПользовательСценария();
	ПустойПользователь = Справочники.Пользователи.ПустаяСсылка();
	Числа = Контекст.Числа;
	ПолеВерсии = "ВерсияДанных";
	ПолеОтветственного = "Ответственный";

	ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	Заказ = ДокументЗаказаПокупателя(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);
	Реализация = ДокументРеализацииПоЗаказу(Контекст, Заказ);
	Накладная = ПроведеннаяНалоговаяНакладная(Контекст, Реализация);
	ВерсияНакладной = ЗначениеРеквизитаЗапросом(Накладная, ПолеВерсии);
	ДвиженияНакладной = СнимокДвиженийДокумента(Накладная);

	УстановитьАвтора(Реализация, Автор, ПустойПользователь);
	ДвиженияРеализации = СнимокДвиженийДокумента(Реализация);
	УстановитьАвтора(Заказ, Автор, Другой);
	Оплата = НовыйДокумент(Контекст, "ПриходныйКассовыйОрдер");
	Оплата.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	Оплата.Контрагент = Контекст.Контрагент;
	Оплата.Договор = Контекст.ДоговорПокупателя;
	Оплата.Сумма = Числа.КоличествоПродажи * Числа.ЦенаПродажи;
	ДобавитьОснование(Оплата, Реализация, Оплата.Сумма);
	Оплата.УдалитьАвторОбщий = Автор;
	Оплата.Ответственный = ПустойПользователь;
	Оплата.ОбменДанными.Загрузка = Истина;
	Оплата.Записать();
	Проверить(ЗначениеРеквизитаЗапросом(Накладная, ПолеВерсии) = ВерсияНакладной,
		"запись непроведённой оплаты в режиме загрузки не перепроводит налоговую накладную");

	Проект = Справочники.ПроектыКонфигураций.СоздатьЭлемент();
	Проект.Наименование = ПометкаТеста() + ": проект конфигурации";
	Проект.УдалитьАвторОбщий = Автор;
	Проект.Записать();
	Валюта = Справочники.Валюты.СоздатьЭлемент();
	Валюта.Наименование = ПометкаТеста() + ": валюта";
	Валюта.УдалитьАвторОбщий = Автор;
	Валюта.ОбменДанными.Загрузка = Истина;
	Валюта.Записать();

	ОбновлениеПрограммыОбработчики.ПеренестиАвтораВОтветственного();

	ПроверитьРавенство(Автор, ЗначениеРеквизитаЗапросом(Реализация, ПолеОтветственного),
		"проведённая реализация получает ответственного");
	Проверить(ЗначениеРеквизитаЗапросом(Реализация, "Проведен"), "реализация остаётся проведённой");
	Проверить(СнимокДвиженийДокумента(Реализация) = ДвиженияРеализации, "движения реализации не меняются");
	ПроверитьРавенство(Другой, ЗначениеРеквизитаЗапросом(Заказ, ПолеОтветственного),
		"заполненный ответственный заказа не меняется");
	ПроверитьРавенство(Автор, ЗначениеРеквизитаЗапросом(Оплата.Ссылка, ПолеОтветственного),
		"непроведённая оплата получает ответственного");
	Проверить(Не ЗначениеРеквизитаЗапросом(Оплата.Ссылка, "Проведен"), "оплата остаётся непроведённой");
	ПроверитьРавенство(ВерсияНакладной, ЗначениеРеквизитаЗапросом(Накладная, ПолеВерсии),
		"налоговая накладная не перепроводится");
	Проверить(СнимокДвиженийДокумента(Накладная) = ДвиженияНакладной, "движения налоговой накладной не меняются");
	ПроверитьРавенство(Автор, ЗначениеРеквизитаЗапросом(Проект.Ссылка, ПолеОтветственного),
		"проект конфигураций получает ответственного");
	ПроверитьРавенство(Автор, ЗначениеРеквизитаЗапросом(Валюта.Ссылка, "УдалитьАвторОбщий"),
		"справочник без ответственного сохраняет автора");

	Записываемые = Новый Массив;
	Записываемые.Добавить(Реализация);
	Записываемые.Добавить(Заказ);
	Записываемые.Добавить(Оплата.Ссылка);
	Записываемые.Добавить(Проект.Ссылка);
	Записываемые.Добавить(Валюта.Ссылка);
	Версии = Новый Соответствие;
	Для Каждого Ссылка Из Записываемые Цикл
		Версии.Вставить(Ссылка, ЗначениеРеквизитаЗапросом(Ссылка, ПолеВерсии));
	КонецЦикла;
	ОбновлениеПрограммыОбработчики.ПеренестиАвтораВОтветственного();
	Для Каждого Ссылка Из Записываемые Цикл
		ПроверитьРавенство(Версии[Ссылка], ЗначениеРеквизитаЗапросом(Ссылка, ПолеВерсии),
			"повторный перенос не пишет " + Ссылка.Метаданные().ПолноеИмя());
	КонецЦикла;

	// Контроль самой проверки: запись объекта меняет версию, иначе проверка повторного переноса ничего не доказывает.
	ПроектОбъект = Проект.Ссылка.ПолучитьОбъект();
	ПроектОбъект.Записать();
	Проверить(ЗначениеРеквизитаЗапросом(Проект.Ссылка, ПолеВерсии) <> Версии[Проект.Ссылка],
		"запись проекта меняет версию данных");

	Возврат РезультатСценария("проведённая реализация и непроведённая оплата получают ответственного, движения "
		+ "и налоговая накладная не меняются, заполненный ответственный и автор справочника без ответственного "
		+ "сохраняются, проект конфигураций, повторный запуск без записи");

КонецФункции

// Проведённая налоговая накладная по реализации: налоговые документы проводятся только по складу с признаком
// «Налоговый», поэтому накладная получает свой налоговый склад с закупкой товара на него.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - основание накладной
//
// Возвращаемое значение:
//  ДокументСсылка.НалоговаяНакладная - проведённая накладная
//
Функция ПроведеннаяНалоговаяНакладная(Контекст, Реализация)

	Склад = Справочники.МестаХранения.СоздатьЭлемент();
	Склад.Наименование = ПометкаТеста() + ": налоговый склад";
	Склад.Налоговый = Истина;
	Склад.Записать();

	Закупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Закупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.ЦенаВключаетНДС = Истина;
	Закупка.Валюта = Контекст.Валюта;
	Закупка.КурсВалюты = 1;
	Закупка.МестоХранения = Склад.Ссылка;
	ДобавитьСтрокуТоваров(Контекст, Закупка, "ТЧТовары", Контекст.Товар,
		Контекст.Числа.КоличествоЗакупки, Контекст.Числа.ЦенаЗакупки);
	Провести(Закупка);

	Накладная = НовыйДокумент(Контекст, "НалоговаяНакладная");
	Накладная.Заполнить(Реализация);
	// Заполнение подставляет ведущую организацию, если у организации нет основного учёта: сценарий от этого не зависит.
	Накладная.Организация = Контекст.Организация;
	Накладная.Договор = Контекст.ДоговорПокупателя;
	Накладная.Дата = СледующаяДата(Контекст);
	Накладная.МестоХранения = Склад.Ссылка;
	Провести(Накладная);
	Возврат Накладная.Ссылка;

КонецФункции

// Значение реквизита, прочитанное запросом: без кэша значений ссылок сеанса.
//
// Параметры:
//  Ссылка   - ЛюбаяСсылка - объект
//  Реквизит - Строка - имя реквизита
//
// Возвращаемое значение:
//  Произвольный - значение реквизита
//
Функция ЗначениеРеквизитаЗапросом(Ссылка, Реквизит)

	ИмяТаблицы = Ссылка.Метаданные().ПолноеИмя();
	// BSLLS:QueryParseError-off - имя таблицы и реквизита подставляются по ссылке.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Т." + Реквизит + " КАК Значение ИЗ " + ИмяТаблицы + " КАК Т ГДЕ Т.Ссылка = &Ссылка";
	// BSLLS:QueryParseError-on
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Значение;

КонецФункции

// Пользователь для сценария, отличный от текущего; пишется в режиме загрузки, без связанного контрагента.
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи - новый пользователь
//
Функция НовыйПользовательСценария()

	Элемент = Справочники.Пользователи.СоздатьЭлемент();
	Элемент.Наименование = ПометкаТеста() + ": другой пользователь";
	Элемент.ОбменДанными.Загрузка = Истина;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

// Автор и ответственный документа, записанные в режиме загрузки: так они выглядят в базе до обновления.
//
// Параметры:
//  Ссылка        - ДокументСсылка - документ
//  Автор         - СправочникСсылка.Пользователи - автор
//  Ответственный - СправочникСсылка.Пользователи - ответственный
//
Процедура УстановитьАвтора(Ссылка, Автор, Ответственный)

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ДокументОбъект.УдалитьАвторОбщий = Автор;
	ДокументОбъект.Ответственный = Ответственный;
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать();

КонецПроцедуры

// Снимок движений документа по всем регистрам: содержимое каждого набора записей во внутреннем представлении.
//
// Параметры:
//  Ссылка - ДокументСсылка - документ
//
// Возвращаемое значение:
//  Строка - снимок; равные снимки - одинаковые записи в том же порядке
//
Функция СнимокДвиженийДокумента(Ссылка)

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	Части = Новый Массив;
	Для Каждого Набор Из ДокументОбъект.Движения Цикл
		Набор.Прочитать();
		Части.Добавить(Набор.Метаданные().ПолноеИмя() + "=" + ЗначениеВСтрокуВнутр(Набор.Выгрузить()));
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// BSLLS:DeprecatedMethodCall-on

#КонецОбласти

#Область РабочееМестоПроизводства

// Рабочее место производства (E12.1): строки «Продукции» пишут заказ-черновик и правят его строки, выбор черновиков
// клиента, представление заказа, отказы без записи, сверка версии, кнопка «Статус», материалы с остатками потребностей и
// документы цепочки второго уровня, удаление строк с пометкой пустого черновика. Все записи сценария успешные: отказ
// записи испортил бы транзакцию прогона, поэтому отказы проверяются функциями проверки без записи.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАРМПроизводство(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	ПроверитьПредставлениеЗаказаАРМ(Контекст);
	ПроверитьЗапретыСтрокиАРМ(Контекст);
	Данные = ПроверитьЧерновикАРМ(Контекст);
	ПроверитьПравкуСтрокАРМ(Контекст, Данные);
	ПроверитьСтатусИЦепочкуАРМ(Контекст, Данные);
	ПроверитьУдалениеСтрокАРМ(Данные);

	Возврат РезультатСценария("представление заказа с суммой и количеством, отказы строки без записи, черновик первой "
		+ "строкой с материалами по карте и стадией «Черновик», вторая строка той же продукции в тот же черновик, "
		+ "черновики клиента, отборы «Продукции» по части наименования клиента и продукции без учёта регистра "
		+ "с экранированием шаблона, стадия в строках, правка количества с пересчётом "
		+ "материалов, строка без правок без записи, устаревшая версия, "
		+ "«В работу» и «В черновик», пояснение индикатора с процентами, материалы с потребностью и заказанным, "
		+ "документы второго уровня через заказ "
		+ "поставщику, движение продукции и материалов по документам со знаком, в базовых единицах без услуг "
		+ "и только у проведённых, "
		+ "количества в подсказке индикатора, удаление строк с пометкой пустого черновика");

КонецФункции

// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПредставлениеЗаказаАРМ(Контекст)

	// BSLLS:MagicNumber-off - дата и числа примера из решения владельца 2026-09-15.
	АРМ = Обработки.АРМПроизводство;
	ДатаПримера = Дата(2026, 3, 12);
	НомерПримера = "11111";
	СуммаПримера = АРМ.ПредставлениеЗаказаДляВыбора(НомерПримера, ДатаПримера, Контекст.Контрагент, 1250, 15, Истина);
	Проверить(СтрНайти(СуммаПримера, НомерПримера) > 0 И СтрНайти(СуммаПримера, "12.03") > 0,
		"представление заказа содержит номер и дату дд.ММ: " + СуммаПримера);
	Проверить(СтрНайти(СуммаПримера, Строка(Контекст.Контрагент)) > 0, "представление заказа содержит клиента");
	Проверить(СтрНайти(СуммаПримера, Формат(1250, "ЧДЦ=2; ЧН=0,00")) > 0, "представление с суммами показывает сумму");
	КоличествоПримера = АРМ.ПредставлениеЗаказаДляВыбора(НомерПримера, ДатаПримера, Контекст.Контрагент, 1250, 15, Ложь);
	Проверить(СтрНайти(КоличествоПримера, Формат(1250, "ЧДЦ=2; ЧН=0,00")) = 0 И СтрНайти(КоличествоПримера, "15") > 0,
		"представление без сумм показывает количество: " + КоличествоПримера);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьЗапретыСтрокиАРМ(Контекст)

	АРМ = Обработки.АРМПроизводство;
	БезПродукции = ДанныеСтрокиАРМ(Контекст, Справочники.Номенклатура.ПустаяСсылка(), 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(БезПродукции)), "строка без продукции не записывается");
	БезКоличества = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 0);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(БезКоличества)), "строка без количества не записывается");
	БезВерсии = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 1);
	БезВерсии.НомерСтроки = 1;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(БезВерсии)), "записанная строка без заказа и версии отклоняется");
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(Новый Структура)), "неполные данные строки отклоняются");

	Продажа = ЗаказКлиентаСценария(Контекст);
	Записать(Продажа);
	ВПродажу = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 1);
	ВПродажу.Заказ = Продажа.Ссылка;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(ВПродажу)), "строка в заказ-продажу не записывается");
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтатуса(Продажа.Ссылка, АРМ.ДействиеВРаботу())),
		"продажа в работу не переводится");

КонецПроцедуры

// Первая строка создаёт черновик, вторая строка той же продукции идёт в тот же черновик.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - Заказ (ДокументСсылка.ЗаказПокупателя), Результат (последний результат записи строки).
//
Функция ПроверитьЧерновикАРМ(Контекст)

	// BSLLS:MagicNumber-off - количества строк сценария: 2 и 3 упаковки, правка до 4, устаревшая правка 9.
	АРМ = Обработки.АРМПроизводство;
	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	Первая = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 2);
	Результат = ЗаписьСтрокиАРМ(Первая, "первая строка создаёт черновик");
	Заказ = Результат.Заказ.ПолучитьОбъект();
	ПроверитьРавенство(Перечисления.ВидыОперацийЗаказаПокупателя.Производство, Заказ.ВидОперации,
		"черновик АРМ - заказ на производство");
	ПроверитьРавенство(Контекст.Контрагент, Заказ.Контрагент, "черновик АРМ оформлен на клиента строки");
	Проверить(Не Заказ.Проведен И ЗначениеЗаполнено(Заказ.Организация), "черновик АРМ записан без проведения с организацией");
	ПроверитьРавенство(1, Заказ.ТЧТовары.Количество(), "в черновике одна строка");
	ПроверитьРавенство(1, Заказ.ТЧМатериалы.Количество(), "материалы первой строки заполнены по карте");
	ПроверитьРавенство(2 * Расход, Заказ.ТЧМатериалы.Итог("Количество"), "количество материала первой строки");
	Стадия = ПроизводственныеЗаказы.ДанныеСтадии(Заказ.Ссылка);
	Проверить(Стадия <> Неопределено И Стадия.Стадия = Перечисления.СтатусыЗаказовПокупателя.Черновик,
		"стадия черновика АРМ - «Черновик»");
	ПроверитьРавенство(1, Результат.СтрокиЗаказа.Количество(), "результат записи возвращает строки заказа");

	Вторая = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 3);
	Вторая.Заказ = Результат.Заказ;
	Вторая.ВерсияДанных = Результат.СтрокиЗаказа[0].ВерсияДанных;
	Результат = ЗаписьСтрокиАРМ(Вторая, "вторая строка в тот же черновик");
	ПроверитьРавенство(Заказ.Ссылка, Результат.Заказ, "вторая строка не создаёт новый заказ");
	Заказ.Прочитать();
	ПроверитьРавенство(2, Заказ.ТЧТовары.Количество(), "в черновике две строки");
	Проверить(Заказ.ТЧТовары[0].КодСтроки <> Заказ.ТЧТовары[1].КодСтроки, "коды строк продукции разные");
	ПроверитьРавенство(5 * Расход, Заказ.ТЧМатериалы.Итог("Количество"), "материалы второй строки той же продукции");

	Черновики = АРМ.ЧерновикиКлиента(Контекст.Контрагент);
	Проверить(Черновики.НайтиПоЗначению(Заказ.Ссылка) <> Неопределено, "черновик в списке черновиков клиента");
	ДругойКлиент = НовыйКонтрагент();
	ДругойКлиентОбъект = ДругойКлиент.ПолучитьОбъект();
	ДругойКлиентОбъект.Наименование = ПометкаТеста() + ": другой клиент АРМ";
	ДругойКлиентОбъект.Записать();
	Проверить(АРМ.ЧерновикиКлиента(ДругойКлиент).НайтиПоЗначению(Заказ.Ссылка) = Неопределено,
		"черновика нет в списке другого клиента");
	ПроверитьРавенство("%50~%~_~[~]%", АРМ.ШаблонВхождения(" 50%_[] "), "служебные символы шаблона поиска экранируются");
	// Отборы панели - часть наименования без учёта регистра (решение владельца 2026-09-15).
	Отборы = АРМ.НовыеОтборы();
	Отборы.Клиент = ВРег(": контрагент");
	Отборы.Продукция = ": продукция";
	СтрокиЧерновика = АРМ.СтрокиПродукции(Отборы).Строки.НайтиСтроки(Новый Структура("Заказ", Заказ.Ссылка));
	ПроверитьРавенство(2, СтрокиЧерновика.Количество(),
		"отбор «Продукции» по части наименования клиента и продукции показывает строки черновика");
	ПроверитьРавенство(Перечисления.СтатусыЗаказовПокупателя.Черновик, СтрокиЧерновика[0].Стадия,
		"строка «Продукции» показывает стадию заказа");
	Проверить(СтрокиЧерновика[0].Редактируется, "строка черновика в «Продукции» редактируется");
	Отборы.Клиент = "другой клиент арм";
	ПроверитьРавенство(0, АРМ.СтрокиПродукции(Отборы).Строки.НайтиСтроки(Новый Структура("Заказ", Заказ.Ссылка)).Количество(),
		"отбор по другому клиенту строки черновика не показывает");
	Отборы.Клиент = "контрагент%";
	ПроверитьРавенство(0, АРМ.СтрокиПродукции(Отборы).Строки.НайтиСтроки(Новый Структура("Заказ", Заказ.Ссылка)).Количество(),
		"«%» в отборе ищется как символ, а не как шаблон");
	ЧужаяСтрока = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 1);
	ЧужаяСтрока.Клиент = ДругойКлиент;
	ЧужаяСтрока.Заказ = Заказ.Ссылка;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(ЧужаяСтрока)), "строка другого клиента в черновик не пишется");
	Возврат Новый Структура("Заказ, Результат", Заказ.Ссылка, Результат);
	// BSLLS:MagicNumber-on

КонецФункции

// Правка количества пересчитывает материалы; строка без правок заказ не перезаписывает; устаревшая версия отклоняется.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьЧерновикАРМ
//
Процедура ПроверитьПравкуСтрокАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества строк сценария: 2 и 3 упаковки, правка до 4, устаревшая правка 9.
	АРМ = Обработки.АРМПроизводство;
	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	Правка = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 4);
	ЗаполнитьКлючСтрокиАРМ(Правка, Данные.Результат, 1);
	Результат = ЗаписьСтрокиАРМ(Правка, "правка количества первой строки");
	Заказ = Данные.Заказ.ПолучитьОбъект();
	ПроверитьРавенство(4, Заказ.ТЧТовары[0].КоличествоУпаковок, "количество первой строки изменено");
	ПроверитьРавенство(7 * Расход, Заказ.ТЧМатериалы.Итог("Количество"), "материалы пересчитаны по количеству");

	БезПравок = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 4);
	ЗаполнитьКлючСтрокиАРМ(БезПравок, Результат, 1);
	Результат = ЗаписьСтрокиАРМ(БезПравок, "окончание редактирования без правок");
	ПроверитьРавенство(Заказ.ВерсияДанных, Результат.СтрокиЗаказа[0].ВерсияДанных, "строка без правок заказ не перезаписывает");

	Устаревшая = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 9);
	ЗаполнитьКлючСтрокиАРМ(Устаревшая, Данные.Результат, 1);
	Отказ = АРМ.ЗаписатьСтрокуПродукции(Устаревшая);
	Проверить(Не Отказ.Успех И Отказ.Перечитать, "строка с устаревшей версией заказа отклоняется с перечитыванием");
	Заказ.Прочитать();
	ПроверитьРавенство(4, Заказ.ТЧТовары[0].КоличествоУпаковок, "устаревшая правка заказ не меняет");
	Данные.Результат = Результат;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «В работу» проводит заказ и закрывает строки для правки; материалы и документы цепочки видят закупку; «В черновик»
// отменяет проведение.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьЧерновикАРМ
//
Процедура ПроверитьСтатусИЦепочкуАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества строк сценария: 2 и 3 упаковки, правка до 4, устаревшая правка 9.
	АРМ = Обработки.АРМПроизводство;
	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	Заказы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Заказ);
	Итог = АРМ.ИзменитьСтатусЗаказов(Заказы, АРМ.ДействиеВРаботу())[0];
	Проверить(Итог.Успех, "«В работу» проводит черновик: " + Итог.Текст);
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Заказ, "Проведен"), "заказ в работе проведён");
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтатуса(Данные.Заказ, АРМ.ДействиеВРаботу())), "повторно в работу не переводится");
	Правка = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 1);
	ЗаполнитьКлючСтрокиАРМ(Правка, Данные.Результат, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(Правка)), "строки заказа в работе не правятся");

	Текущий = АРМ.ДанныеТекущегоЗаказа(Данные.Заказ);
	Проверить(Текущий.МожноНаОсновании, "у заказа в работе разрешён ввод на основании");
	Пояснение = Текущий.ПояснениеИндикатора;
	Проверить(СтрНайти(Пояснение, "%") > 0 И СтрНайти(Пояснение, "%%") = 0
		И СтрНайти(Пояснение, ПроизводственныеЗаказы.ЛегендаИндикатора()) > 0,
		"пояснение индикатора - проценты заказа и легенда: " + Пояснение);
	ПроверитьРавенство(7 * Расход, Текущий.Материалы.Итог("Потребность"), "потребность материалов заказа в работе");
	ПроверитьРавенство(7 * Расход, Текущий.Материалы.Итог("Дефицит"), "дефицит до закупки");

	ЗаказПоставщику = НовыйЗаказПоставщикуПотребности(Контекст, Данные.Заказ);
	Провести(ЗаказПоставщику);
	Поступление = НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику.Ссылка);
	Провести(Поступление);
	Текущий = АРМ.ДанныеТекущегоЗаказа(Данные.Заказ);
	ПроверитьРавенство(0, Текущий.Материалы.Итог("Дефицит"), "после заказа поставщику дефицита нет");
	СтрокаЗаказа = Текущий.Документы.Найти(ЗаказПоставщику.Ссылка, "Документ");
	Проверить(СтрокаЗаказа <> Неопределено И СтрокаЗаказа.Через = Неопределено, "заказ поставщику - первый уровень цепочки");
	СтрокаПоступления = Текущий.Документы.Найти(Поступление.Ссылка, "Документ");
	Проверить(СтрокаПоступления <> Неопределено И СтрокаПоступления.Через = ЗаказПоставщику.Ссылка,
		"поступление по заказу поставщику - второй уровень цепочки");
	ПроверитьДвижениеДокументовАРМ(Данные, Текущий, ЗаказПоставщику, Поступление);

	Итог = АРМ.ИзменитьСтатусЗаказов(Заказы, АРМ.ДействиеВЧерновик())[0];
	Проверить(Итог.Успех, "«В черновик» отменяет проведение: " + Итог.Текст);
	Проверить(Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Заказ, "Проведен"), "заказ в черновике не проведён");
	Данные.Результат.СтрокиЗаказа[0].ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Заказ, "ВерсияДанных");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Движение продукции и материалов в колонках закладки «Документы» (E12.4): заказ поставщику движения не даёт,
// поступление приходует материалы со знаком плюс, непроведённый документ движения не показывает; количества попадают
// в подсказку индикатора.
//
// Параметры:
//  Данные         - Структура - см. ПроверитьЧерновикАРМ
//  Текущий        - Структура - см. Обработки.АРМПроизводство.ДанныеТекущегоЗаказа
//  ЗаказПоставщику - ДокументОбъект.ЗаказПоставщику - заказ поставщику заказа.
//  Поступление    - ДокументОбъект.ПоступлениеТоваровУслуг - поступление по нему.
//
Процедура ПроверитьДвижениеДокументовАРМ(Данные, Текущий, ЗаказПоставщику, Поступление)

	ПолеДокумента = "Документ";
	СтрокаЗаказа = Текущий.Документы.Найти(ЗаказПоставщику.Ссылка, ПолеДокумента);
	ПроверитьРавенство(0, СтрокаЗаказа.МатериалыЧисло, "заказ поставщику движения материалов не даёт");
	Проверить(ПустаяСтрока(СтрокаЗаказа.Материалы), "у заказа поставщику колонка движения пустая");
	СтрокаПоступления = Текущий.Документы.Найти(Поступление.Ссылка, ПолеДокумента);
	Проверить(СтрокаПоступления.МатериалыЧисло > 0, "поступление приходует материалы");
	ПроверитьРавенство(1, СтрНайти(СтрокаПоступления.Материалы, "+"),
		"приход показан со знаком плюс: " + СтрокаПоступления.Материалы);
	ПроверитьРавенство(0, СтрокаПоступления.ПродукцияЧисло, "поступление материалов продукцию не двигает");
	Проверить(ПустаяСтрока(СтрокаПоступления.Продукция), "колонка продукции поступления материалов пустая");
	Количества = СтрРазделить(Текущий.ПояснениеИндикатора, Символы.ПС, Ложь)[1];
	// Число ищется вместе со следующим за ним разделителем: иначе «10» нашлось бы внутри «100».
	ПришлоВПодсказке = Формат(СтрокаПоступления.МатериалыЧисло, "ЧГ=0") + ",";
	Проверить(СтрНайти(Количества, ПришлоВПодсказке) > 0,
		"пришедшие материалы попали в подсказку индикатора: " + Количества);

	Поступление.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	БезПроведения = Обработки.АРМПроизводство.ДанныеТекущегоЗаказа(Данные.Заказ);
	СтрокаПоступления = БезПроведения.Документы.Найти(Поступление.Ссылка, ПолеДокумента);
	БезДвижения = СтрокаПоступления <> Неопределено И ПустаяСтрока(СтрокаПоступления.Материалы)
		И СтрокаПоступления.МатериалыЧисло = 0;
	Проверить(БезДвижения, "у непроведённого поступления движения нет");
	Провести(Поступление);

КонецПроцедуры

// Удаление строк: обе строки черновика одним вызовом, пустой черновик помечается на удаление.
//
// Параметры:
//  Данные - Структура - см. ПроверитьЧерновикАРМ
//
Процедура ПроверитьУдалениеСтрокАРМ(Данные)

	АРМ = Обработки.АРМПроизводство;
	Версия = Данные.Результат.СтрокиЗаказа[0].ВерсияДанных;
	Удаляемые = Новый Массив;
	Для НомерСтроки = 1 По 2 Цикл
		ДанныеСтроки = АРМ.НовыеДанныеСтроки();
		ДанныеСтроки.Заказ = Данные.Заказ;
		ДанныеСтроки.Клиент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Заказ, "Контрагент");
		ДанныеСтроки.НомерСтроки = НомерСтроки;
		ДанныеСтроки.ВерсияДанных = Версия;
		Удаляемые.Добавить(ДанныеСтроки);
	КонецЦикла;
	Итог = АРМ.УдалитьСтрокиПродукции(Удаляемые)[0];
	Проверить(Итог.Успех И Итог.ЗаказПомечен, "удаление всех строк черновика помечает его на удаление: " + Итог.Текст);
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Заказ, "ПометкаУдаления"), "черновик помечен на удаление");

КонецПроцедуры

// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Номенклатура - СправочникСсылка.Номенклатура - продукция строки
//  Количество   - Число - количество в упаковках
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтроки
//
Функция ДанныеСтрокиАРМ(Контекст, Номенклатура, Количество)

	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтроки();
	ДанныеСтроки.Клиент = Контекст.Контрагент;
	ДанныеСтроки.Номенклатура = Номенклатура;
	ДанныеСтроки.КоличествоУпаковок = Количество;
	Возврат ДанныеСтроки;

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтроки
//  Результат    - Структура - результат записи строки с СтрокиЗаказа
//  НомерСтроки  - Число - номер строки заказа
//
Процедура ЗаполнитьКлючСтрокиАРМ(ДанныеСтроки, Результат, НомерСтроки)

	СтрокаЗаказа = Результат.СтрокиЗаказа[НомерСтроки - 1];
	ДанныеСтроки.Заказ = СтрокаЗаказа.Заказ;
	ДанныеСтроки.НомерСтроки = СтрокаЗаказа.НомерСтроки;
	ДанныеСтроки.ВерсияДанных = СтрокаЗаказа.ВерсияДанных;

КонецПроцедуры

// Параметры:
//  ДанныеСтроки - Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтроки
//  Описание     - Строка - что проверяется
//
// Возвращаемое значение:
//  Структура - результат записи строки, проверенный на успех
//
Функция ЗаписьСтрокиАРМ(ДанныеСтроки, Описание)

	Результат = Обработки.АРМПроизводство.ЗаписатьСтрокуПродукции(ДанныеСтроки);
	Проверить(Результат.Успех, Описание + ": " + Результат.Текст);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область АРМЗакупки

// Рабочее место производства, закупки в строках (E12.2): заказы поставщику и поступления строками заказа на производство
// в работе через модуль менеджера обработки - запись, проведение, распределение по двум изделиям, строки заказа
// поставщику, запреты, «Статус», удаление.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАРМЗакупки(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// Склад нового поступления - из настроек пользователя или основного места хранения, как в форме документа.
	Если Не ЗначениеЗаполнено(Константы.ОсновноеМестоХранения.Получить()) Тогда
		Константы.ОсновноеМестоХранения.Установить(Контекст.Склад);
	КонецЕсли;
	Данные = ДанныеАРМЗакупок(Контекст);
	ПроверитьЗапретыЗакупокАРМ(Контекст, Данные);
	ПроверитьЗаказыПоставщикуАРМ(Контекст, Данные);
	ПроверитьПоступленияАРМ(Контекст, Данные);
	ПроверитьСтатусЗакупокАРМ(Контекст, Данные);

	Возврат РезультатСценария("заказ поставщику строкой: новый проведённый документ без явной продукции с распределением "
		+ "«Заказано» на два изделия, вторая строка в тот же документ, правка количества с перепроведением, устаревшая "
		+ "версия; поступление по строке заказа поставщику с кодом строки и накладной, без заказа поставщику - по заказу; "
		+ "строки заказа поставщику для выбора с остатком; запреты: черновик заказа, другой поставщик, нулевое количество, "
		+ "строка чужого заказа поставщику, повтор строки основания, уменьшение и удаление строки с поступлениями; "
		+ "документы для выбора; «Статус» и правка черновика без проведения; удаление строк с пометкой документа");

КонецФункции

// Заказ на производство в работе: изделие P1 - 10 шт., P2 - 5 шт., у обоих материал M (2 и 3 на единицу).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - Заказ, P2, M, Потребность (35) и документы по мере создания.
//
Функция ДанныеАРМЗакупок(Контекст)

	// BSLLS:MagicNumber-off - количества сценария: 10 и 5 изделий, расход 2 и 3.
	Данные = Новый Структура;
	Данные.Вставить("P2", НоваяНоменклатура(Контекст, "продукция АРМ 2", Перечисления.ТипыНоменклатуры.Продукция));
	Данные.Вставить("M", Контекст.Сырье);
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, 10, Контекст.Числа.ЦенаПродажи);
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.P2, 5, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M, 2);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[2], Данные.M, 3);
	Провести(Заказ);
	Данные.Вставить("Заказ", Заказ.Ссылка);
	Данные.Вставить("Потребность", 35);
	Данные.Вставить("ЗаказПоставщику", Документы.ЗаказПоставщику.ПустаяСсылка());
	Данные.Вставить("РезультатЗаказа", Неопределено);
	Возврат Данные;
	// BSLLS:MagicNumber-on

КонецФункции

// Отказы без записи: черновик заказа на производство, пустой поставщик, нулевое количество.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМЗакупок
//
Процедура ПроверитьЗапретыЗакупокАРМ(Контекст, Данные)

	АРМ = Обработки.АРМПроизводство;
	Черновик = ЗаказКлиентаСценария(Контекст);
	Черновик.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Черновик.Записать(РежимЗаписиДокумента.Запись);
	НаЧерновик = СтрокаЗакупкиАРМ(Контекст, Черновик.Ссылка, АРМ.ВидЗаказПоставщику(), Данные.M, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(НаЧерновик)), "по черновику заказа закупки не вводятся");
	БезПоставщика = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 1);
	БезПоставщика.Поставщик = Справочники.Контрагенты.ПустаяСсылка();
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(БезПоставщика)), "строка без поставщика не записывается");
	БезКоличества = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 0);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(БезКоличества)), "строка без количества не записывается");
	Допустимая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 1);
	ТекстЗапрета = АРМ.ТекстЗапретаСтрокиДокумента(Допустимая);
	Проверить(ПустаяСтрока(ТекстЗапрета), "строка поступления по заказу в работе допустима: " + ТекстЗапрета);

КонецПроцедуры

// Заказ поставщику строками: новый документ, распределение на два изделия, вторая строка, правка, устаревшая версия.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМЗакупок
//
Процедура ПроверитьЗаказыПоставщикуАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария: весь дефицит 35, правка до 30, строка товара 1.
	АРМ = Обработки.АРМПроизводство;
	Первая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, Данные.Потребность);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Первая, "строка заказа поставщику создаёт документ");
	Проверить(Результат.Проведен, "новый заказ поставщику проведён сразу");
	ЗаказПоставщику = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Данные.Заказ, ЗаказПоставщику.Основание, "основание заказа поставщику - заказ на производство");
	ПроверитьРавенство(Контекст.Контрагент, ЗаказПоставщику.Контрагент, "поставщик заказа из строки");
	Проверить(Не ЗначениеЗаполнено(ЗаказПоставщику.ТЧТовары[0].Продукция), "продукция строки не задана - распределяет регистр");
	ПроверитьРавенство(0, ДефицитМатериалаАРМ(Данные), "весь дефицит двух изделий заказан одной строкой");
	ПроверитьРавенство(2, ЗаказаноПоИзделиямАРМ(Данные).Количество(), "«Заказано» распределено на оба изделия");

	Вторая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Контекст.Товар, 1);
	Вторая.Документ = Результат.Документ;
	Результат = ЗаписьСтрокиЗакупкиАРМ(Вторая, "вторая строка того же поставщика");
	ПроверитьРавенство(ЗаказПоставщику.Ссылка, Результат.Документ, "вторая строка в тот же заказ поставщику");
	ПроверитьРавенство(2, Результат.СтрокиДокумента.Количество(), "в заказе поставщику две строки");

	Правка = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 30);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Правка, Результат, 1);
	Устаревшая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 20);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Устаревшая, Результат, 1);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Правка, "правка количества строки заказа поставщику");
	Проверить(Результат.Проведен, "заказ поставщику перепроведён после правки");
	ПроверитьРавенство(5, ДефицитМатериалаАРМ(Данные), "дефицит после уменьшения заказанного");
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Устаревшая);
	Проверить(Не Отказ.Успех И Отказ.Перечитать, "правка по устаревшей версии документа отклоняется с перечитыванием");

	ДругойПоставщик = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 1);
	ДругойПоставщик.Поставщик = НовыйКонтрагент();
	ДругойПоставщик.Документ = Результат.Документ;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ДругойПоставщик)), "в документ другого поставщика строка не пишется");
	Вчерашний = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Контекст.Товар, 1);
	РезультатВчерашнего = ЗаписьСтрокиЗакупкиАРМ(Вчерашний, "заказ поставщику товара");
	ВчерашнийОбъект = РезультатВчерашнего.Документ.ПолучитьОбъект();
	ВчерашнийОбъект.Дата = НачалоДня(ТекущаяДатаСеанса()) - 1;
	ВчерашнийОбъект.Записать(РежимЗаписиДокумента.Запись);
	ВоВчерашний = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Контекст.Товар, 1);
	ВоВчерашний.Документ = РезультатВчерашнего.Документ;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ВоВчерашний)), "новая строка во вчерашний документ не пишется");
	Выбор = АРМ.ДокументыСтрокиДляВыбора(СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 1));
	Проверить(Выбор.НайтиПоЗначению(РезультатВчерашнего.Документ) = Неопределено, "вчерашний документ не в списке выбора");
	Проверить(Выбор.НайтиПоЗначению(Результат.Документ) <> Неопределено, "сегодняшний заказ поставщику в списке выбора");
	Данные.ЗаказПоставщику = Результат.Документ;
	Данные.РезультатЗаказа = Результат;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Поступления строками: по строке заказа поставщику, без заказа поставщику, запреты строки с поступлениями.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМЗакупок
//
Процедура ПроверитьПоступленияАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария: заказано 30, пришло 30, без заказа 2, уменьшение до 20.
	АРМ = Обработки.АРМПроизводство;
	СтрокиОснований = АРМ.СтрокиЗаказовПоставщикуДляВыбора(Данные.Заказ, Контекст.Контрагент, Данные.M,
		Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ПроверитьРавенство(1, СтрокиОснований.Количество(), "строка заказа поставщику с остатком к поступлению");
	Основание = СтрокиОснований[0].Значение;
	ПроверитьРавенство(30, Основание.КоличествоУпаковок, "остаток строки заказа поставщику к поступлению");
	БезВыбораСтроки = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 30);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(БезВыбораСтроки)),
		"поступление без заказа поставщику при открытой строке заказа отклоняется");

	Приход = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 30);
	Приход.ЗаказПоставщику = Основание.ЗаказПоставщику;
	Приход.КодСтрокиОснования = Основание.КодСтроки;
	Приход.НомерВходящегоДокумента = "АРМ-1";
	Приход.ДатаВходящегоДокумента = НачалоДня(Контекст.Дата);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Приход, "поступление по строке заказа поставщику");
	Проверить(Результат.Проведен, "поступление проведено сразу");
	Поступление = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Данные.ЗаказПоставщику, Поступление.Основание, "основание поступления - заказ поставщику");
	ПроверитьРавенство(Основание.КодСтроки, Поступление.ТЧТовары[0].КодСтроки, "код строки поступления - код строки заказа");
	ПроверитьРавенство("АРМ-1", Поступление.НомерВходящегоДокумента, "номер накладной поставщика в шапке");
	СтрокиОснований = АРМ.СтрокиЗаказовПоставщикуДляВыбора(Данные.Заказ, Контекст.Контрагент, Данные.M,
		Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ПроверитьРавенство(0, СтрокиОснований.Количество(), "пришедшая строка из выбора уходит");
	ОстатокМатериала = 0;
	Для Каждого СтрокаОстатка Из РегистрыНакопления.ПотребностиПроизводства.ОстатокКПоступлению(Данные.Заказ) Цикл
		Если СтрокаОстатка.Материал = Данные.M Тогда
			ОстатокМатериала = ОстатокМатериала + СтрокаОстатка.Количество;
		КонецЕсли;
	КонецЦикла;
	ПроверитьРавенство(0, ОстатокМатериала, "после поступления заказанного к поступлению по материалу ничего не осталось");
	ПроверитьРавенство(2, ПришлоПоИзделиямАРМ(Данные).Количество(), "«Пришло» распределено на оба изделия");

	Повтор = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 1);
	Повтор.ЗаказПоставщику = Основание.ЗаказПоставщику;
	Повтор.КодСтрокиОснования = Основание.КодСтроки;
	Повтор.Документ = Результат.Документ;
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Повтор);
	Проверить(Не Отказ.Успех И Не Отказ.Перечитать, "вторая строка поступления по той же строке заказа отклоняется: "
		+ Отказ.Текст);

	Уменьшение = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 20);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Уменьшение, Данные.РезультатЗаказа, 1);
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Уменьшение);
	Проверить(Не Отказ.Успех И Не Отказ.Перечитать, "строка заказа поставщику не уменьшается ниже пришедшего: "
		+ Отказ.Текст);
	Удаление = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 30);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Удаление, Данные.РезультатЗаказа, 1);
	ОтказУдаления = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Не ОтказУдаления.Успех И Не ОтказУдаления.Перечитать,
		"строка заказа поставщику с поступлениями не удаляется: " + ОтказУдаления.Текст);

	ЧужаяСтрока = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 1);
	ЧужаяСтрока.ЗаказПоставщику = Основание.ЗаказПоставщику;
	ЧужаяСтрока.КодСтрокиОснования = Основание.КодСтроки;
	ЧужаяСтрока.Поставщик = НовыйКонтрагент();
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ЧужаяСтрока)), "строка заказа поставщику другого поставщика отклоняется");

	БезЗаказа = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 2);
	Результат = ЗаписьСтрокиЗакупкиАРМ(БезЗаказа, "поступление без заказа поставщику");
	ПроверитьРавенство(Данные.Заказ, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат.Документ, "Основание"),
		"основание поступления без заказа поставщику - заказ на производство");
	Данные.Вставить("Поступление", Результат.Документ);
	Данные.Вставить("РезультатПоступления", Результат);
	ПроверитьНулевуюЦенуПрайсаАРМ(Результат.Документ);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «Статус» документов закупки, правка черновика без проведения, удаление всех строк с пометкой.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьПоступленияАРМ
//
Процедура ПроверитьСтатусЗакупокАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - правка строки поступления до 3.
	АРМ = Обработки.АРМПроизводство;
	ДокументыСтатуса = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Поступление);
	ЗаказыСтатуса = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.ЗаказПоставщику);
	Отказ = АРМ.ИзменитьСтатусДокументовСтрок(ЗаказыСтатуса, АРМ.ДействиеВЧерновик(), Данные.Заказ)[0];
	Проверить(Не Отказ.Успех, "заказ поставщику с поступлениями в черновик не возвращается");
	ЧужойЗаказ = АРМ.ИзменитьСтатусДокументовСтрок(ДокументыСтатуса, АРМ.ДействиеВЧерновик(),
		Документы.ЗаказПокупателя.ПустаяСсылка())[0];
	Проверить(Не ЧужойЗаказ.Успех, "«Статус» не меняет документ другого заказа");
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(ДокументыСтатуса, АРМ.ДействиеВЧерновик(), Данные.Заказ)[0];
	Проверить(Итог.Успех, "«В черновик» отменяет проведение поступления: " + Итог.Текст);
	Версия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Поступление, "ВерсияДанных");
	Правка = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 3);
	Правка.Документ = Данные.Поступление;
	Правка.НомерСтроки = 1;
	Правка.ВерсияДанных = Версия;
	Результат = ЗаписьСтрокиЗакупкиАРМ(Правка, "правка строки черновика поступления");
	Проверить(Не Результат.Проведен, "правка черновика его не проводит");
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(ДокументыСтатуса, АРМ.ДействиеВРаботу(), Данные.Заказ)[0];
	Проверить(Итог.Успех, "«Провести» проводит поступление: " + Итог.Текст);
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Поступление, "Проведен"), "поступление проведено «Статусом»");

	Удаление = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 3);
	Удаление.Документ = Данные.Поступление;
	Удаление.НомерСтроки = 1;
	Удаление.ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Поступление, "ВерсияДанных");
	Итог = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Итог.Успех И Итог.ДокументПомечен, "удаление единственной строки помечает поступление: " + Итог.Текст);
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Поступление, "ПометкаУдаления"), "поступление помечено");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Поступление без цены (оператор без сумм, прайса нет) не пишет нулевую цену в прайс поставщика (решение владельца
// 2026-09-15): ноль перекрыл бы цены других поставщиков.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - проведённое поступление рабочего места.
//
Процедура ПроверитьНулевуюЦенуПрайсаАРМ(Поступление)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Строк,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Товары.Цена = 0
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК БезЦены
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Поступление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Нулевых
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатурыПоставщиков КАК Цены
	|ГДЕ
	|	Цены.Регистратор = &Поступление
	|	И Цены.Цена = 0");
	Запрос.УстановитьПараметр("Поступление", Поступление);
	Пакет = Запрос.ВыполнитьПакет();
	Строки = Пакет[0].Выгрузить()[0];
	Проверить(Строки.БезЦены > 0, "у поступления рабочего места без прайса строка без цены");
	ПроверитьРавенство(0, Пакет[1].Выгрузить()[0].Нулевых, "нулевая цена поступления в прайс поставщика не записана");

КонецПроцедуры

// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  Вид        - Строка - вид документа закупки
//  Материал   - СправочникСсылка.Номенклатура - материал
//  Количество - Число - количество упаковок
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента
//
Функция СтрокаЗакупкиАРМ(Контекст, Заказ, Вид, Материал, Количество)

	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента();
	ДанныеСтроки.Вид = Вид;
	ДанныеСтроки.Заказ = Заказ;
	ДанныеСтроки.Поставщик = Контекст.Контрагент;
	ДанныеСтроки.Материал = Материал;
	ДанныеСтроки.КоличествоУпаковок = Количество;
	Возврат ДанныеСтроки;

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента
//  Результат    - Структура - результат записи строки закупки с СтрокиДокумента
//  НомерСтроки  - Число - номер строки документа
//
Процедура ЗаполнитьКлючСтрокиЗакупкиАРМ(ДанныеСтроки, Результат, НомерСтроки)

	СтрокаДокумента = Результат.СтрокиДокумента[НомерСтроки - 1];
	ДанныеСтроки.Документ = СтрокаДокумента.Документ;
	ДанныеСтроки.НомерСтроки = СтрокаДокумента.НомерСтроки;
	ДанныеСтроки.ВерсияДанных = СтрокаДокумента.ВерсияДанных;

КонецПроцедуры

// Параметры:
//  ДанныеСтроки - Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента
//  Описание     - Строка - что проверяется
//
// Возвращаемое значение:
//  Структура - результат записи строки закупки, проверенный на успех
//
Функция ЗаписьСтрокиЗакупкиАРМ(ДанныеСтроки, Описание)

	Результат = Обработки.АРМПроизводство.ЗаписатьСтрокуДокумента(ДанныеСтроки);
	Проверить(Результат.Успех, Описание + ": " + Результат.Текст);
	Возврат Результат;

КонецФункции

// Параметры:
//  Данные - Структура - см. ДанныеАРМЗакупок
//
// Возвращаемое значение:
//  Число - дефицит материала сценария по заказу.
//
Функция ДефицитМатериалаАРМ(Данные)

	Дефицит = 0;
	Для Каждого Строка Из РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа(Данные.Заказ) Цикл
		Если Строка.Материал = Данные.M Тогда
			Дефицит = Дефицит + Строка.Количество;
		КонецЕсли;
	КонецЦикла;
	Возврат Дефицит;

КонецФункции

// Параметры:
//  Данные - Структура - см. ДанныеАРМЗакупок
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - изделия с ненулевым «Заказано» материала сценария.
//
Функция ЗаказаноПоИзделиямАРМ(Данные)

	Возврат ИзделияСОстаткомАРМ(Данные, "ЗаказаноОстаток");

КонецФункции

// Параметры:
//  Данные - Структура - см. ДанныеАРМЗакупок
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - изделия с ненулевым «Пришло» материала сценария.
//
Функция ПришлоПоИзделиямАРМ(Данные)

	Возврат ИзделияСОстаткомАРМ(Данные, "ПришлоОстаток");

КонецФункции

// Параметры:
//  Данные       - Структура - см. ДанныеАРМЗакупок
//  ИмяОстатка   - Строка - «ЗаказаноОстаток» или «ПришлоОстаток».
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - изделия с положительным остатком ресурса.
//
Функция ИзделияСОстаткомАРМ(Данные, ИмяОстатка)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Продукция КАК Продукция
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства.Остатки(, Заказ = &Заказ И Материал = &Материал) КАК Остатки
	|ГДЕ
	|	Остатки.ЗаказаноОстаток > 0");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗаказаноОстаток", ИмяОстатка);
	Запрос.УстановитьПараметр("Заказ", Данные.Заказ);
	Запрос.УстановитьПараметр("Материал", Данные.M);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Продукция");

КонецФункции

#КонецОбласти

#Область АРМВыпускОтгрузка

// Рабочее место производства, выпуск и отгрузки в строках (E12.3a): выпуски и реализации строками заказа на производство
// в работе через модуль менеджера обработки - запись с материалами по карте, правка, запреты, отгрузка с ценой заказа и
// автовыпуском, «Статус», правило выпуска после отгрузки, удаление, заполнение выпуска по заказу, отказ проведения.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАРМВыпускОтгрузка(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Данные = ДанныеАРМВыпускаОтгрузки(Контекст);
	ПроверитьВыпускАРМ(Контекст, Данные);
	ПроверитьЗапретыВыпускаАРМ(Контекст, Данные);
	ПроверитьОтгрузкуАРМ(Контекст, Данные);
	ПроверитьСтатусОтгрузкиАРМ(Контекст, Данные);
	ПроверитьВыпускПослеОтгрузкиАРМ(Контекст, Данные);
	ПроверитьЗаполнениеВыпускаПоЗаказуАРМ(Данные);
	// Отказ проведения портит транзакцию сценария: последним шагом.
	ПроверитьОтказОтгрузкиАРМ(Контекст, Данные);

	Возврат РезультатСценария("выпуск строкой: новый проведённый документ по заказу, шапка по строке, материалы по карте, "
		+ "правка количества с перепроведением, устаревшая версия; запреты: продукция не из заказа, продукция без карты, "
		+ "вчерашний выпуск; отгрузка строкой с ценой заказа, вторая строка с автовыпуском, автовыпуск только для чтения и "
		+ "не документ строки; «Статус» реализации с автовыпуском; выпуск после отгрузки запрещает её правку и выбор; "
		+ "удаление строки выпуска с пометкой; заполнение выпуска по заказу; отказ проведения отгрузки");

КонецФункции

// Заказ на производство в работе: продукция контекста 10 шт. (сырьё 2 на единицу, карта контекста) и товар контекста без
// карты; сырьё 30 на складе новых документов, константа автовыпуска включена.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - Заказ, P, БезКарты, M, Склад и документы по мере создания.
//
Функция ДанныеАРМВыпускаОтгрузки(Контекст)

	// BSLLS:MagicNumber-off - количества сценария: заказ 10 и 1, расход 2, сырьё 30 по 10.
	Склад = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновноеМестоХранения.Получить();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Контекст.Склад;
		Константы.ОсновноеМестоХранения.Установить(Склад);
	КонецЕсли;
	Константы.ИспользоватьВыпускПродукцииПриПродаже.Установить(Истина);
	Данные = Новый Структура;
	Данные.Вставить("P", Контекст.Продукция);
	// Строка товара заказа без материалов - позиция без карты.
	Данные.Вставить("БезКарты", Контекст.Товар);
	Данные.Вставить("M", Контекст.Сырье);
	Данные.Вставить("Склад", Склад);
	Закупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Закупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.ЦенаВключаетНДС = Истина;
	Закупка.Валюта = Контекст.Валюта;
	Закупка.КурсВалюты = 1;
	Закупка.МестоХранения = Склад;
	ИмяТоваров = "ТЧТовары";
	ДобавитьСтрокуТоваров(Контекст, Закупка, ИмяТоваров, Данные.M, 30, 10);
	Провести(Закупка);
	Данные.Вставить("ДатаЗакупки", Закупка.Дата);

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, ИмяТоваров, Данные.P, 10, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M, 2);
	// Скидка строки заказа переходит в отгрузку и не теряется при ручной цене.
	Заказ.ТЧТовары[1].СкидкаНаЦену = Контекст.Числа.ЦенаПродажи / 10;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Заказ.ТЧТовары[1], Заказ.ЦенаВключаетНДС, "Цена");
	Провести(Заказ);
	Данные.Вставить("Заказ", Заказ.Ссылка);
	Данные.Вставить("Выпуск", Документы.ВыпускПродукции.ПустаяСсылка());
	Данные.Вставить("Реализация", Документы.РеализацияТоваровУслуг.ПустаяСсылка());
	Возврат Данные;
	// BSLLS:MagicNumber-on

КонецФункции

// Выпуск строкой: новый документ, шапка и материалы, правка количества, устаревшая версия.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМВыпускаОтгрузки
//
Процедура ПроверитьВыпускАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария: выпуск 4, правка до 5, расход 2.
	АРМ = Обработки.АРМПроизводство;
	Выбор = АРМ.ПродукцияЗаказаДляВыбора(Данные.Заказ, АРМ.ВидВыпуск());
	Проверить(Выбор.Количество() >= 2, "продукция заказа для выбора в строке выпуска");
	Первая = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 4);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Первая, "строка выпуска создаёт документ");
	Проверить(Результат.Проведен, "новый выпуск проведён сразу");
	Выпуск = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Данные.Заказ, Выпуск.Основание, "основание выпуска - заказ на производство");
	ПроверитьРавенство(Данные.P, Выпуск.Номенклатура, "шапка выпуска повторяет строку");
	ПроверитьРавенство(4, Выпуск.КоличествоУпаковок, "количество шапки выпуска");
	ПроверитьРавенство(1, Выпуск.ТЧТовары.Количество(), "материалы выпуска по карте");
	ПроверитьРавенство(8, Выпуск.ТЧТовары[0].Количество, "расход сырья по карте на 4 шт.");
	ПроверитьРавенство(4, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "«Выпущено» по заказу после выпуска строкой");

	Правка = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 5);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Правка, Результат, 1);
	Устаревшая = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 6);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Устаревшая, Результат, 1);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Правка, "правка количества строки выпуска");
	Проверить(Результат.Проведен, "выпуск перепроведён после правки");
	Выпуск = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(10, Выпуск.ТЧТовары[0].Количество, "материалы пересчитаны по карте на 5 шт.");
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Устаревшая);
	Проверить(Не Отказ.Успех И Отказ.Перечитать, "правка выпуска по устаревшей версии отклоняется с перечитыванием");
	Выбор = АРМ.ДокументыСтрокиДляВыбора(СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1));
	Проверить(Выбор.НайтиПоЗначению(Результат.Документ) <> Неопределено, "сегодняшний выпуск в списке выбора");

	// Розничная цена шапки не переходит к строке, оставшейся одной.
	Выпуск.ЦенаРозничная = 50;
	Провести(Выпуск);
	ВтораяСтрока = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
	ВтораяСтрока.Документ = Выпуск.Ссылка;
	Результат = ЗаписьСтрокиЗакупкиАРМ(ВтораяСтрока, "вторая строка выпуска");
	ПроверитьРавенство(2, Результат.СтрокиДокумента.Количество(), "в выпуске две строки продукции");
	ПроверитьРавенство(12, Выпуск.Ссылка.ТЧТовары[0].Количество, "материалы по картам двух строк");
	Удаление = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Удаление, Результат, 2);
	Итог = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Итог.Успех И Не Итог.ДокументПомечен, "удаление второй строки выпуска: " + Итог.Текст);
	Выпуск = Выпуск.Ссылка.ПолучитьОбъект();
	ПроверитьРавенство(0, Выпуск.ЦенаРозничная, "переход к одной строке обнуляет розничную цену шапки");
	ПроверитьРавенство(10, Выпуск.ТЧТовары[0].Количество, "материалы пересчитаны после удаления строки");

	// Автовыпуск видит выпуски раньше реализации: выпуск сценария отодвигается от будущей отгрузки.
	Выпуск.Дата = Макс(НачалоДня(ТекущаяДатаСеанса()), Данные.ДатаЗакупки + 1);
	Провести(Выпуск);
	Данные.Выпуск = Выпуск.Ссылка;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Отказы строки выпуска: продукция не из заказа, продукция без карты, новая строка во вчерашний выпуск.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМВыпускаОтгрузки
//
Процедура ПроверитьЗапретыВыпускаАРМ(Контекст, Данные)

	АРМ = Обработки.АРМПроизводство;
	НеИзЗаказа = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Контекст.Сырье, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(НеИзЗаказа)), "продукция не из заказа не выпускается");
	БезКарты = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.БезКарты, 1);
	БезКарты.Документ = Данные.Выпуск;
	Отказ = АРМ.ЗаписатьСтрокуДокумента(БезКарты);
	Проверить(Не Отказ.Успех И Не Отказ.Перечитать, "продукция без карты в выпуск не пишется: " + Отказ.Текст);
	ПроверитьРавенство(1, Данные.Выпуск.ТЧГотоваяПродукция.Количество(), "выпуск после отказа не изменён");

	Вчерашний = НовыйДокумент(Контекст, "ВыпускПродукции");
	Вчерашний.Основание = Данные.Заказ;
	Вчерашний.Дата = НачалоДня(ТекущаяДатаСеанса()) - 1;
	Вчерашний.Номенклатура = Данные.P;
	Вчерашний.КоличествоУпаковок = 1;
	Вчерашний.Количество = 1;
	Вчерашний.МестоХраненияОприходование = Данные.Склад;
	Вчерашний.Записать(РежимЗаписиДокумента.Запись);
	ВоВчерашний = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
	ВоВчерашний.Документ = Вчерашний.Ссылка;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ВоВчерашний)), "новая строка во вчерашний выпуск не пишется");
	Вчерашний.УстановитьПометкуУдаления(Истина);

КонецПроцедуры

// Отгрузка строками: новая реализация с ценой заказа, вторая строка с автовыпуском.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМВыпускаОтгрузки
//
Процедура ПроверитьОтгрузкуАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария: отгрузка 3 и 4 при выпущенных 5, автовыпуск 2.
	АРМ = Обработки.АРМПроизводство;
	Первая = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 3);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Первая, "строка отгрузки создаёт реализацию");
	Проверить(Результат.Проведен, "новая реализация проведена сразу");
	Реализация = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Данные.Заказ, Реализация.Основание, "основание реализации - заказ на производство");
	ПроверитьРавенство(Контекст.Контрагент, Реализация.Контрагент, "клиент реализации - клиент заказа");
	ПроверитьРавенство(Контекст.ДоговорПокупателя, Реализация.Договор, "договор реализации - договор заказа");
	ПроверитьРавенство(Контекст.Числа.ЦенаПродажи, Реализация.ТЧТовары[0].Цена, "цена строки отгрузки - цена заказа");
	ПроверитьРавенство(3 * Контекст.Числа.ЦенаПродажи, Реализация.ТЧТовары[0].Сумма, "сумма строки отгрузки");
	ПроверитьРавенство(10, Реализация.ТЧТовары[0].ПроцентСкидки, "скидка строки отгрузки - скидка строки заказа");
	ПроверитьРавенство(0, ЧислоАвтовыпусков(Реализация.Ссылка), "отгрузка в пределах выпущенного без автовыпуска");
	ПроверитьРавенство(3, ВыполнениеПродукцииАРМ(Данные, Данные.P).Отгружено, "«Отгружено» по заказу");

	Вторая = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 4);
	Вторая.Документ = Реализация.Ссылка;
	Результат = ЗаписьСтрокиЗакупкиАРМ(Вторая, "вторая строка отгрузки в ту же реализацию");
	ПроверитьРавенство(Реализация.Ссылка, Результат.Документ, "вторая строка - в ту же реализацию");
	ПроверитьРавенство(1, ЧислоАвтовыпусков(Реализация.Ссылка), "отгрузка сверх выпущенного создала автовыпуск");
	Проверить(Не ПустаяСтрока(Результат.СтрокиДокумента[0].Автовыпуск), "колонка «Автовыпуск» заполнена");
	ПроверитьРавенство(7, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "автовыпуск досчитан в «Выпущено»");
	Автовыпуск = Неопределено;
	Для Каждого СтрокаВыпуска Из АРМ.СтрокиВыпусковИОтгрузок(Данные.Заказ).Выпуски Цикл
		Если СтрокаВыпуска.Документ <> Данные.Выпуск Тогда
			Автовыпуск = СтрокаВыпуска;
		КонецЕсли;
	КонецЦикла;
	Проверить(Автовыпуск <> Неопределено И Автовыпуск.ТолькоПросмотр, "автовыпуск в строках выпуска только для чтения");
	Если Автовыпуск <> Неопределено Тогда
		ВАвтовыпуск = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
		ЗаполнитьЗначенияСвойств(ВАвтовыпуск, Автовыпуск, "Документ, НомерСтроки, ВерсияДанных");
		Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ВАвтовыпуск)), "автовыпуск не правится строкой выпуска");
	КонецЕсли;
	ПравкаРанее = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 6);
	ПравкаРанее.Документ = Данные.Выпуск;
	ПравкаРанее.НомерСтроки = 1;
	ПравкаРанее.ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Выпуск, "ВерсияДанных");
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ПравкаРанее)), "выпуск, после которого проведена отгрузка, не правится");
	Данные.Реализация = Реализация.Ссылка;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «Статус» реализации: в черновик и провести - механизм реализации распроводит и проводит автовыпуск.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьОтгрузкуАРМ
//
Процедура ПроверитьСтатусОтгрузкиАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - выпущено 5 вручную и 7 с автовыпуском.
	АРМ = Обработки.АРМПроизводство;
	Реализации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Реализация);
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(Реализации, АРМ.ДействиеВЧерновик(), Данные.Заказ)[0];
	Проверить(Итог.Успех, "«В черновик» отменяет проведение реализации: " + Итог.Текст);
	ПроверитьРавенство(0, ВыполнениеПродукцииАРМ(Данные, Данные.P).Отгружено, "черновик реализации не отгружает");
	ПроверитьРавенство(5, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "автовыпуск распроведён вместе с реализацией");
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(Реализации, АРМ.ДействиеВРаботу(), Данные.Заказ)[0];
	Проверить(Итог.Успех, "«Провести» проводит реализацию: " + Итог.Текст);
	ПроверитьРавенство(7, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "автовыпуск снова проведён");

	ЦенаВручную = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 3);
	ЦенаВручную.Документ = Данные.Реализация;
	ЦенаВручную.НомерСтроки = 1;
	ЦенаВручную.ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Реализация, "ВерсияДанных");
	ЦенаВручную.Цена = 95;
	ЦенаВручную.ЦенаИзменена = Истина;
	ЗаписьСтрокиЗакупкиАРМ(ЦенаВручную, "ручная цена строки отгрузки");
	СтрокаРеализации = Данные.Реализация.ТЧТовары[0];
	ПроверитьРавенство(95, СтрокаРеализации.Цена, "ручная цена записана");
	ПроверитьРавенство(10, СтрокаРеализации.ПроцентСкидки, "скидка заказа не теряется при ручной цене");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Ручной выпуск, проведённый после реализации, запрещает её правку, «Провести» и выбор; удаление его единственной строки
// помечает выпуск и снимает запрет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьОтгрузкуАРМ
//
Процедура ПроверитьВыпускПослеОтгрузкиАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - выпуск 1 на минуту позже реализации.
	АРМ = Обработки.АРМПроизводство;
	Позже = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Позже, "выпуск после отгрузки");
	ВыпускПозже = Результат.Документ.ПолучитьОбъект();
	ВыпускПозже.Дата = ТекущаяДатаСеанса() + 60;
	Провести(ВыпускПозже);
	Третья = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 1);
	Третья.Документ = Данные.Реализация;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Третья)), "строка отгрузки после позднего выпуска не пишется");
	Реализации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Реализация);
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(Реализации, АРМ.ДействиеВРаботу(), Данные.Заказ)[0];
	Проверить(Не Итог.Успех, "«Провести» реализации после позднего выпуска отклоняется");
	Выбор = АРМ.ДокументыСтрокиДляВыбора(СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 1));
	Проверить(Выбор.НайтиПоЗначению(Данные.Реализация) = Неопределено, "реализация до позднего выпуска не в списке выбора");

	Удаление = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
	Удаление.Документ = ВыпускПозже.Ссылка;
	Удаление.НомерСтроки = 1;
	Удаление.ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыпускПозже.Ссылка, "ВерсияДанных");
	Итог = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Итог.Успех И Итог.ДокументПомечен, "удаление единственной строки помечает выпуск: " + Итог.Текст);
	Проверить(ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Третья)), "после пометки позднего выпуска отгрузка снова правится");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «Выпуск по заказу»: заполнение нового выпуска строками заказа, которые осталось выпустить.
//
// Параметры:
//  Данные - Структура - см. ПроверитьОтгрузкуАРМ
//
Процедура ПроверитьЗаполнениеВыпускаПоЗаказуАРМ(Данные)

	// BSLLS:MagicNumber-off - заказано 10, выпущено 7 (5 и автовыпуск 2), расход 2.
	Выпуск = Документы.ВыпускПродукции.СоздатьДокумент();
	Выпуск.Заполнить(Данные.Заказ);
	ПроверитьРавенство(Данные.Заказ, Выпуск.Основание, "основание выпуска по заказу");
	ПроверитьРавенство(1, Выпуск.ТЧГотоваяПродукция.Количество(), "к выпуску - только продукция с материалами");
	Если Выпуск.ТЧГотоваяПродукция.Количество() = 1 Тогда
		ПроверитьРавенство(3, Выпуск.ТЧГотоваяПродукция[0].Количество, "к выпуску - заказанное без выпущенного");
	КонецЕсли;
	ПроверитьРавенство(Данные.P, Выпуск.Номенклатура, "шапка выпуска по заказу - первая строка");
	ПроверитьРавенство(1, Выпуск.ТЧТовары.Количество(), "материалы выпуска по заказу по карте");
	Если Выпуск.ТЧТовары.Количество() = 1 Тогда
		ПроверитьРавенство(6, Выпуск.ТЧТовары[0].КоличествоУпаковок, "сырьё по карте на остаток к выпуску");
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Строка отгрузки сверх выпущенного и заказанного: реализация не проводится, строка не записывается проведённой.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМВыпускаОтгрузки
//
Процедура ПроверитьОтказОтгрузкиАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - отгрузка 20 при заказанных 10.
	АРМ = Обработки.АРМПроизводство;
	Сверх = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 20);
	ТекстЗапрета = АРМ.ТекстЗапретаСтрокиДокумента(Сверх);
	Проверить(ПустаяСтрока(ТекстЗапрета), "строка сверх продукции проходит проверки до записи: отказ даёт проведение - " + ТекстЗапрета);
	Попытка
		Результат = АРМ.ЗаписатьСтрокуДокумента(Сверх);
		НеПроведена = (Не Результат.Успех Или Не Результат.Проведен) И Не ПустаяСтрока(Результат.Текст);
		Пояснение = Результат.Текст;
	Исключение
		// Отказ проведения испортил транзакцию сценария: черновик свежим объектом в ней уже не создаётся. В работе
		// внешней транзакции нет - черновик записывается.
		НеПроведена = Истина;
		Пояснение = ОшибкаОднойСтрокой(ИнформацияОбОшибке());
	КонецПопытки;
	Проверить(НеПроведена, "отгрузка сверх продукции не проводится: " + Пояснение);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Параметры:
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  Вид        - Строка - вид документа строки: выпуск или отгрузка
//  Продукция  - СправочникСсылка.Номенклатура - продукция
//  Количество - Число - количество упаковок
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента
//
Функция СтрокаВыпускаАРМ(Заказ, Вид, Продукция, Количество)

	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента();
	ДанныеСтроки.Вид = Вид;
	ДанныеСтроки.Заказ = Заказ;
	ДанныеСтроки.Продукция = Продукция;
	ДанныеСтроки.КоличествоУпаковок = Количество;
	Возврат ДанныеСтроки;

КонецФункции

// Параметры:
//  Данные    - Структура - см. ДанныеАРМВыпускаОтгрузки
//  Продукция - СправочникСсылка.Номенклатура - продукция заказа
//
// Возвращаемое значение:
//  Структура - Заказано, Выпущено, Отгружено проведёнными документами.
//
Функция ВыполнениеПродукцииАРМ(Данные, Продукция)

	Итог = Новый Структура("Заказано, Выпущено, Отгружено", 0, 0, 0);
	Для Каждого Выполнение Из ПроизводственныеЗаказы.ВыполнениеПоПродукции(Данные.Заказ) Цикл
		Если Выполнение.Номенклатура = Продукция Тогда
			ЗаполнитьЗначенияСвойств(Итог, Выполнение);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область АРМПереработка

// Рабочее место производства, переработка в строках (E12.3b): передачи в переработку строками заказа на производство в
// работе, продукция поступления из переработки как выпуск в стадии и автовыпуске, запреты правки передачи со списанными
// партиями, правило порядка отгрузки и поступления, удаление строк, смена основания передачи.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАРМПереработка(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Данные = ДанныеАРМПереработки(Контекст);
	ПроверитьЗапретыПереработкиАРМ(Контекст, Данные);
	ПроверитьПередачуАРМ(Контекст, Данные);
	ПроверитьПоступлениеИзПереработкиАРМ(Контекст, Данные);
	ПроверитьПередачуСоСписаниемАРМ(Контекст, Данные);
	ПроверитьОтгрузкуПослеПереработкиАРМ(Контекст, Данные);
	// Отказ записи портит транзакцию сценария: последним шагом.
	ПроверитьСменуОснованияПередачиАРМ(Контекст, Данные);

	Возврат РезультатСценария("передача строкой: новый проведённый документ по заказу с ожидаемой продукцией, остаток у "
		+ "переработчика, правка количества, устаревшая версия; запреты: не субподрядчик, без количества; поступление из "
		+ "переработки по передаче - «Выпущено» и стадия заказа, заполнение остатком ожидаемой продукции; передача со "
		+ "списанными партиями не правится, не удаляется и не возвращается в черновик; отгрузка без автовыпуска в пределах "
		+ "поступившего; поздний приход из переработки запрещает правку отгрузки, отмена его проведения снимает запрет; "
		+ "удаление строки передачи с пометкой; смена основания передачи со списанием - отказ");

КонецФункции

// Заказ на производство в работе: продукция контекста 10 шт. (сырьё 2 на единицу); сырьё 30 на складе новых документов.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - Заказ, P, M, Склад, ДатаЗакупки и документы по мере создания.
//
Функция ДанныеАРМПереработки(Контекст)

	// BSLLS:MagicNumber-off - количества сценария: заказ 10, расход 2, сырьё 30 по 10.
	Склад = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновноеМестоХранения.Получить();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Контекст.Склад;
		Константы.ОсновноеМестоХранения.Установить(Склад);
	КонецЕсли;
	Константы.ИспользоватьВыпускПродукцииПриПродаже.Установить(Истина);
	Данные = Новый Структура("P, M, Склад", Контекст.Продукция, Контекст.Сырье, Склад);
	Закупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Закупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.ЦенаВключаетНДС = Истина;
	Закупка.Валюта = Контекст.Валюта;
	Закупка.КурсВалюты = 1;
	Закупка.МестоХранения = Склад;
	ДобавитьСтрокуТоваров(Контекст, Закупка, "ТЧТовары", Данные.M, 30, 10);
	Провести(Закупка);
	Данные.Вставить("ДатаЗакупки", Закупка.Дата);

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.P, 10, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M, 2);
	Провести(Заказ);
	Данные.Вставить("Заказ", Заказ.Ссылка);
	Данные.Вставить("Передача", Документы.ПередачаВПереработку.ПустаяСсылка());
	Данные.Вставить("Реализация", Документы.РеализацияТоваровУслуг.ПустаяСсылка());
	Возврат Данные;
	// BSLLS:MagicNumber-on

КонецФункции

// Отказы без записи: переработчик без признака субподрядчика, строка без количества.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМПереработки
//
Процедура ПроверитьЗапретыПереработкиАРМ(Контекст, Данные)

	АРМ = Обработки.АРМПроизводство;
	НеСубподрядчик = НовыйКонтрагент().ПолучитьОбъект();
	НеСубподрядчик.Субподрядчик = Ложь;
	НеСубподрядчик.Записать();
	Строка = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 1);
	Строка.Поставщик = НеСубподрядчик.Ссылка;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Строка)), "переработчик без признака субподрядчика отклоняется");
	БезКоличества = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 0);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(БезКоличества)), "строка передачи без количества отклоняется");

КонецПроцедуры

// Передача строкой: новый документ по заказу, остаток у переработчика, правка количества, устаревшая версия.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМПереработки
//
Процедура ПроверитьПередачуАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - передача 6, правка до 8.
	АРМ = Обработки.АРМПроизводство;
	Первая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 6);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Первая, "строка переработки создаёт передачу");
	Проверить(Результат.Проведен, "новая передача проведена сразу");
	Передача = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Данные.Заказ, Передача.Основание, "основание передачи - заказ на производство");
	ПроверитьРавенство(Контекст.Контрагент, Передача.Контрагент, "переработчик передачи - из строки");
	Проверить(Передача.ТЧГотоваяПродукция.Количество() > 0, "ожидаемая продукция передачи - по заказу");
	ПроверитьРавенство(6, ОстатокВПереработке(Контекст.Контрагент, Данные.M).Количество, "сырьё у переработчика");

	Правка = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 8);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Правка, Результат, 1);
	Устаревшая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 7);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Устаревшая, Результат, 1);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Правка, "правка количества строки передачи");
	ПроверитьРавенство(8, ОстатокВПереработке(Контекст.Контрагент, Данные.M).Количество, "сырьё у переработчика после правки");
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Устаревшая);
	Проверить(Не Отказ.Успех И Отказ.Перечитать, "правка передачи по устаревшей версии отклоняется с перечитыванием");
	Выбор = АРМ.ДокументыСтрокиДляВыбора(СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 1));
	Проверить(Выбор.НайтиПоЗначению(Результат.Документ) <> Неопределено, "сегодняшняя передача в списке выбора");
	ПроверитьРавенство(1, АРМ.СтрокиПереработок(Данные.Заказ).Количество(), "строка передачи в закладке «Переработка»");

	// Поступление из переработки датируется между передачей и будущей отгрузкой.
	Передача = Результат.Документ.ПолучитьОбъект();
	Передача.Дата = Макс(НачалоДня(ТекущаяДатаСеанса()), Данные.ДатаЗакупки + 1);
	Провести(Передача);
	Данные.Передача = Передача.Ссылка;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Поступление из переработки по передаче: «Выпущено» и стадия заказа, заполнение остатком ожидаемой продукции.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьПередачуАРМ
//
Процедура ПроверитьПоступлениеИзПереработкиАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - поступило 4 из ожидаемых 10.
	Поступление = НовоеПоступлениеИзПереработкиАРМ(Контекст, Данные.Передача, 4);
	Поступление.Дата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Передача, "Дата") + 1;
	Провести(Поступление);
	ПроверитьРавенство(4, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "продукция переработчика - «Выпущено» заказа");
	Проверить(ДоляВыпускаИстории(Данные.Заказ) > 0, "стадия заказа пересчитана проведением поступления из переработки");
	Второе = Документы.ПоступлениеИзПереработки.СоздатьДокумент();
	Второе.Заполнить(Данные.Передача);
	ПроверитьРавенство(6, Второе.ТЧГотоваяПродукция.Итог("Количество"), "второе поступление - остаток ожидаемой продукции");
	Данные.Вставить("Поступление", Поступление.Ссылка);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Передача, партии которой списаны поступлением: правка, удаление и «В черновик» отклоняются.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьПоступлениеИзПереработкиАРМ
//
Процедура ПроверитьПередачуСоСписаниемАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - правка до 9.
	АРМ = Обработки.АРМПроизводство;
	Строки = АРМ.СтрокиПереработок(Данные.Заказ);
	Проверить(Строки.Количество() = 1 И Строки[0].ТолькоПросмотр, "передача со списанными партиями только для чтения");
	Правка = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 9);
	Правка.Документ = Данные.Передача;
	Правка.НомерСтроки = 1;
	Правка.ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Передача, "ВерсияДанных");
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Правка)), "строка передачи со списанием не правится");
	Отказ = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Правка))[0];
	Проверить(Не Отказ.Успех, "строка передачи со списанием не удаляется");
	Передачи = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Передача);
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(Передачи, АРМ.ДействиеВЧерновик(), Данные.Заказ)[0];
	Проверить(Не Итог.Успех, "передача со списанием не возвращается в черновик");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Отгрузка в пределах поступившего без автовыпуска; поздний приход из переработки запрещает правку отгрузки, отмена его
// проведения снимает запрет; удаление строки передачи без списания помечает передачу.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьПоступлениеИзПереработкиАРМ
//
Процедура ПроверитьОтгрузкуПослеПереработкиАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - отгрузка 3 при поступивших 4; вторая передача 2, поздний приход 1.
	АРМ = Обработки.АРМПроизводство;
	Результат = ЗаписьСтрокиЗакупкиАРМ(СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 3), "отгрузка продукции переработчика");
	ПроверитьРавенство(0, ЧислоАвтовыпусков(Результат.Документ), "продукция переработчика отгружается без автовыпуска");
	Данные.Реализация = Результат.Документ;

	ВтораяПередача = ЗаписьСтрокиЗакупкиАРМ(СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 2),
		"вторая передача");
	Проверить(ВтораяПередача.Документ <> Данные.Передача, "в передачу со списанием новая строка не попадает");
	Проба = Документы.ПоступлениеИзПереработки.СоздатьДокумент();
	Проба.Заполнить(ВтораяПередача.Документ);
	ПроверитьРавенство(6, Проба.ТЧГотоваяПродукция.Итог("Количество"),
		"поступление по второй передаче - не больше, чем заказу осталось выпустить");
	// Поступление по второй передаче списывает её партию и, по FIFO, партию третьей передачи того же переработчика.
	ТретьяПередача = ЗаписьСтрокиЗакупкиАРМ(СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 1),
		"третья передача");
	Проверить(ТретьяПередача.Документ <> ВтораяПередача.Документ, "третья передача - новый документ");
	Поздний = НовоеПоступлениеИзПереработкиАРМ(Контекст, ВтораяПередача.Документ, 1);
	Поздний.ТЧТовары[0].КоличествоУпаковок = 3;
	Поздний.ТЧТовары[0].Количество = 3;
	Поздний.Дата = ТекущаяДатаСеанса() + 60;
	Провести(Поздний);
	ПравкаТретьей = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 2);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(ПравкаТретьей, ТретьяПередача, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ПравкаТретьей)),
		"передача, чью партию списало поступление по другой передаче, не правится");
	Отгрузка = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 1);
	Отгрузка.Документ = Данные.Реализация;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Отгрузка)), "после позднего прихода из переработки отгрузка не правится");
	Поздний.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьРавенство(4, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "отмена проведения прихода возвращает «Выпущено»");
	Проверить(ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Отгрузка)), "после отмены проведения прихода отгрузка правится");

	Удаление = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 2);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Удаление, ВтораяПередача, 1);
	Итог = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Итог.Успех И Итог.ДокументПомечен, "удаление единственной строки помечает передачу: " + Итог.Текст);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Смена основания передачи, партии которой списаны поступлением, - отказ записи.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьПоступлениеИзПереработкиАРМ
//
Процедура ПроверитьСменуОснованияПередачиАРМ(Контекст, Данные)

	ДругойЗаказ = ЗаказКлиентаСценария(Контекст);
	ДругойЗаказ.Записать(РежимЗаписиДокумента.Запись);
	Передача = Данные.Передача.ПолучитьОбъект();
	Передача.Основание = ДругойЗаказ.Ссылка;
	Записана = Истина;
	Попытка
		Передача.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Записана = Ложь;
	КонецПопытки;
	Проверить(Не Записана, "основание передачи со списанными партиями не меняется");

КонецПроцедуры

// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Передача   - ДокументСсылка.ПередачаВПереработку - передача-основание
//  Количество - Число - поступившая продукция
//
// Возвращаемое значение:
//  ДокументОбъект.ПоступлениеИзПереработки - заполненное по передаче поступление с одной строкой продукции.
//
Функция НовоеПоступлениеИзПереработкиАРМ(Контекст, Передача, Количество)

	Поступление = НовыйДокумент(Контекст, "ПоступлениеИзПереработки");
	Поступление.Заполнить(Передача);
	Поступление.СтоимостьУслуг = 0;
	Поступление.СтавкаНДСУслуг = Контекст.СтавкаНДС;
	Поступление.СуммаНДСУслуг = 0;
	Пока Поступление.ТЧГотоваяПродукция.Количество() > 1 Цикл
		Поступление.ТЧГотоваяПродукция.Удалить(1);
	КонецЦикла;
	СтрокаПродукции = Поступление.ТЧГотоваяПродукция[0];
	СтрокаПродукции.КоличествоУпаковок = Количество;
	СтрокаПродукции.Количество = Количество;
	Возврат Поступление;

КонецФункции

// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ на производство
//
// Возвращаемое значение:
//  Число - доля выпуска последней записи истории статусов заказа.
//
Функция ДоляВыпускаИстории(Заказ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	История.ДоляВыпуска КАК ДоляВыпуска
	|ИЗ
	|	РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних(, ЗаказПокупателя = &Заказ) КАК История");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.ДоляВыпуска, 0);

КонецФункции

#КонецОбласти

#Область СебестоимостьПродукции

// Отчёт «Себестоимость продукции»: единственная проверка текста запроса схемы компоновки. Смок отчёт не открывает -
// своей формы у него нет, а .dcs не читает ни один статический гейт. Данные сценария намеренно со ставкой НДС 20%:
// ресурс «Сумма» регистра ТоварыВНаличии хранит стоимость с НДС, и отчёт обязан вычесть СуммаНДСПриход.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСебестоимостьПродукции(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - сырьё 10 по 12 со ставкой 20%: приход продукции 120, в нём НДС 20, продукции 5 штук.
	Контекст.СтавкаНДС = НоваяСтавкаНДС(20);
	Материал = НоваяНоменклатура(Контекст, "сырьё со ставкой", Перечисления.ТипыНоменклатуры.Сырье);
	Продукция = НоваяНоменклатура(Контекст, "продукция со ставкой", Перечисления.ТипыНоменклатуры.Продукция);
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, СоставИзМатериала(Контекст, Материал, 2), Контекст.Дата);
	ЗакупкаСоСтавкойНДС(Контекст, Материал, 10, 12);

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Номенклатура = Продукция;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = 5;
	Выпуск.Количество = 5;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Ложь);
	Провести(Выпуск);

	Остаток = ОстатокТовара(Контекст.Склад, Продукция);
	ПроверитьРавенство(5, Остаток.Количество, "продукция оприходована");
	ПроверитьРавенство(120, Остаток.Сумма, "себестоимость продукции в регистре хранится с НДС");
	ПроверитьРавенство(20, НДСОстатка(Контекст.Склад, Продукция), "НДС партии продукции");

	Строка = СтрокаОтчетаСебестоимости(Выпуск.Дата, Продукция);
	ПроверитьРавенство(5, Строка.Количество, "количество в отчёте");
	ПроверитьРавенство(100, Строка.Себестоимость, "себестоимость в отчёте без НДС");
	ПроверитьРавенство(20, Строка.НДС, "НДС в составе себестоимости выделен отдельной колонкой");
	ПроверитьРавенство(20, Строка.СебестоимостьЕдиницы, "себестоимость единицы на группировке продукции");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("отчёт себестоимости: приход регистра по выпуску, НДС вычтен из себестоимости, "
		+ "себестоимость единицы считается на группировке продукции");

КонецФункции

// Строка отчёта «Себестоимость продукции» по одной продукции: схема компонуется в таблицу значений.
// Образец - СтрокиОтчетаПотребностей.
//
// Параметры:
//  ДатаВыпуска - Дата - день выпуска; период отчёта берётся по нему, а не по дате контекста:
//                документы сценария идут вперёд шагами и в первые секунды суток ушли бы за границу
//  Продукция   - СправочникСсылка.Номенклатура - отбор отчёта
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - Количество, Себестоимость, НДС, СебестоимостьЕдиницы
//
Функция СтрокаОтчетаСебестоимости(ДатаВыпуска, Продукция)

	Схема = Отчеты.СебестоимостьПродукции.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;
	Период = Новый СтандартныйПериод;
	Период.ДатаНачала = НачалоДня(ДатаВыпуска);
	Период.ДатаОкончания = КонецДня(ДатаВыпуска);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Период);
	// Общий итог вариант выводит в конце: в коллекцию значений он попал бы строкой без измерений.
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов",
		РасположениеИтоговКомпоновкиДанных.Нет);
	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Продукция");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Продукция;
	Отбор.Использование = Истина;
	Настройки.Структура.Очистить();
	Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Продукция");
	ПолеГруппировки.Использование = Истина;
	Для Каждого ИмяПоля Из СтрРазделить("Количество,Себестоимость,НДС,СебестоимостьЕдиницы", ",") Цикл
		Поле = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);

	ПроверитьРавенство(1, Результат.Количество(), "отчёт себестоимости вернул одну строку по продукции");
	Возврат Результат[0];

КонецФункции

// Поступление сырья с посчитанным НДС строки. Общий помощник ДокументЗакупки не годится: ДобавитьСтрокуТоваров
// кладёт СуммаНДС = 0 и строку не пересчитывает, поэтому в регистр ушёл бы нулевой НДС и проверка вычитания
// оказалась бы пустой. Пересчёт строки - как в НовоеПоступлениеПотребности и НовыйВозвратПотребности.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Номенклатура - СправочникСсылка.Номенклатура - сырьё
//  Количество   - Число - количество в единицах
//  Цена         - Число - цена с НДС
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеТоваровУслуг - проведённое поступление
//
Функция ЗакупкаСоСтавкойНДС(Контекст, Номенклатура, Количество, Цена)

	Док = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПоставщика;
	Док.ЦенаВключаетНДС = Истина;
	Док.Валюта = Контекст.Валюта;
	Док.КурсВалюты = 1;
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Номенклатура, Количество, Цена);
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Док.ТЧТовары[0], Док.ЦенаВключаетНДС);
	Провести(Док);
	Возврат Док.Ссылка;

КонецФункции

// НДС в составе себестоимости остатка: ОстатокТовара его не возвращает.
//
// Параметры:
//  Склад        - СправочникСсылка.МестаХранения - место хранения
//  Номенклатура - СправочникСсылка.Номенклатура - позиция номенклатуры
//
// Возвращаемое значение:
//  Число - СуммаНДС остатка
//
Функция НДСОстатка(Склад, Номенклатура)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.СуммаНДСОстаток), 0) КАК СуммаНДС
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии.Остатки(, МестоХранения = &Склад И Номенклатура = &Номенклатура) КАК Остатки");
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат ПерваяСтрока(Запрос, "СуммаНДС").СуммаНДС;

КонецФункции

// Ставка НДС сценария: предопределена только «без НДС», а проверке нужна ненулевая ставка.
//
// Параметры:
//  Процент - Число - ставка в процентах
//
// Возвращаемое значение:
//  СправочникСсылка.СтавкиНДС - записанная ставка
//
Функция НоваяСтавкаНДС(Процент)

	Ставка = Справочники.СтавкиНДС.СоздатьЭлемент();
	Ставка.Наименование = ПометкаТеста() + ": " + Строка(Процент) + "%";
	Ставка.Ставка = Процент;
	Ставка.Записать();
	Возврат Ставка.Ссылка;

КонецФункции

#КонецОбласти

#Область ДемоНабор

// Демо-набор (E11): тот же генератор, что заполняет базу для приёмки и скриншотов (scripts/fixtures.sh --demo), в
// транзакции прогона с суффиксом наименований. Сверяются стадии и индикаторы заказов на производство по схемам,
// статусы коммерческих предложений, заказов-продаж и договоров, автовыпуски, лиды и заявки на поиск товара.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст (не используется: у набора свои справочники)
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДемоНабор(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Начало = Обработки.ТестовыеДанные.НачалоДемоНабора();
	Если Начало = Неопределено Тогда
		Возврат РезультатСценария("с начала дня прошло слишком мало времени для дат набора", Истина);
	КонецЕсли;

	Начат = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Кейсы = Обработки.ТестовыеДанные.ЗаполнитьДемоНабор(Начало, " (тест)");
	// BSLLS:MagicNumber-off - миллисекунды в секунды.
	Длительность = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начат) / 1000);
	// BSLLS:MagicNumber-on

	ПроверитьСтадииДемоНабора(Кейсы);
	ПроверитьТорговлюДемоНабора(Кейсы);
	ПроверитьРавенство(1, ЧислоАвтовыпусков(Кейсы["P1"].Реализация), "P1: один автовыпуск реализации");
	ПроверитьРавенство(1, ЧислоАвтовыпусков(Кейсы["P2"].Реализация), "P2: один автовыпуск реализации");
	ПроверитьРавенство(0, ЧислоАвтовыпусков(Кейсы["P9"].Реализация), "P9: выпущенного хватает, автовыпуска нет");
	Выпуск = Кейсы["P10"].Выпуск;
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выпуск, "Проведен"), "P10: мультивыпуск проведён");
	// BSLLS:MagicNumber-off - две позиции мультивыпуска, пять лидов и пять заявок.
	ПроверитьРавенство(2, Выпуск.ТЧГотоваяПродукция.Количество(), "P10: две позиции продукции");
	ПроверитьРавенство(5, ЧислоЗаписейНабора("РегистрСведений.Лиды", "ПолноеИмя", Кейсы["L"].Имена), "лиды набора");
	ПроверитьРавенство(5, ЧислоЗаписейНабора("Документ.ЗаявкаНаПоискТовара", "Ссылка", Кейсы["Z"].Заявки),
		"заявки на поиск товара набора");
	// BSLLS:MagicNumber-on

	Текст = "кейсов " + СтрокаЧисла(Кейсы.Количество()) + " за " + СтрокаЧисла(Длительность)
		+ " с: стадии P1-P9 по схемам производства, статусы КП, заказов-продаж и договоров, автовыпуски, лиды и заявки";
	Возврат РезультатСценария(Текст);

КонецФункции

// Стадии и индикаторы заказов на производство P1-P9 (план .ai/plans/production-2mzl-e11-demo.md, §3).
//
// Параметры:
//  Кейсы - Соответствие - см. Обработки.ТестовыеДанные.ЗаполнитьДемоНабор
//
Процедура ПроверитьСтадииДемоНабора(Кейсы)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	ПроверитьСтадиюЗаказа(Кейсы["P1"].Заказ, Стадии.Выполнен, "●●●●●", "P1 под заказ без своего остатка");
	ПроверитьСтадиюЗаказа(Кейсы["P2"].Заказ, Стадии.ОжидаетОплаты, "●●●●◐", "P2 из своего остатка");
	ПроверитьСтадиюЗаказа(Кейсы["P3"].Заказ, Стадии.ОжидаетОтгрузки, "●●●○○", "P3 ручной выпуск по заказу");
	ПроверитьСтадиюЗаказа(Кейсы["P4"].Заказ, Стадии.ВПроизводстве, "●●○○○", "P4 состав в заказе");
	ПроверитьСтадиюЗаказа(Кейсы["P5"].Заказ, Стадии.ВосполнениеПотребности, "●◐○○○", "P5 закупка пришла частично");
	ПроверитьСтадиюЗаказа(Кейсы["P6"].Заказ, Стадии.ЗаказПоставщику, "○○○○○", "P6 материалы не заказаны");
	ПроверитьСтадиюЗаказа(Кейсы["P7"].Заказ, Стадии.ФормируетсяПотребность, "○○○○◐", "P7 закупаемый товар с авансом");
	ПроверитьСтадиюЗаказа(Кейсы["P8"].Заказ, Стадии.Черновик, "○○○○○", "P8 черновик");
	ПроверитьСтадиюЗаказа(Кейсы["P9"].Заказ, Стадии.ОжидаетОтгрузки, "●●●◐○", "P9 частичная отгрузка");

КонецПроцедуры

// Статусы коммерческих предложений, заказов-продаж и договоров набора.
//
// Параметры:
//  Кейсы - Соответствие - см. Обработки.ТестовыеДанные.ЗаполнитьДемоНабор
//
Процедура ПроверитьТорговлюДемоНабора(Кейсы)

	ИмяСтатуса = "Статус";
	СтатусыКП = Перечисления.СтатусыКоммерческихПредложений;
	ПроверитьРавенство(СтатусыКП.Выигран, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейсы["P1"].Предложение, ИмяСтатуса),
		"P1: предложение выиграно заказом");
	Предложения = Кейсы["T"];
	Для Каждого ЗначениеСтатуса Из СтрРазделить("Черновик,Отправлен,Доставлен,Проигран", ",") Цикл
		Фактический = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Предложения[ЗначениеСтатуса], ИмяСтатуса);
		ПроверитьРавенство(СтатусыКП[ЗначениеСтатуса], Фактический, "статус коммерческого предложения " + ЗначениеСтатуса);
	КонецЦикла;

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	ПроверитьСтатусПродажи(Кейсы["S1"].Заказ, Стадии.Новый, "S1");
	ПроверитьСтатусПродажи(Кейсы["S2"].Заказ, Стадии.ВРаботе, "S2");
	ПроверитьСтатусПродажи(Кейсы["S3"].Заказ, Стадии.Собран, "S3");
	ПроверитьСтатусПродажи(Кейсы["S4"].Заказ, Стадии.ВПроизводстве, "S4");
	ПроверитьСтатусПродажи(Кейсы["S5"].Заказ, Стадии.Отгружен, "S5");
	ПроверитьСтатусПродажи(Кейсы["S6"].Заказ, Стадии.ПереданСубподрядчику, "S6");
	// Поступление на основании передачи статус «Получен от субподрядчика» не ставит (TECHDEBT «Найдено в E11»).
	ПроверитьСтатусПродажи(Кейсы["S7"].Заказ, Стадии.ПереданСубподрядчику, "S7");

	СтатусыДоговоров = Перечисления.СтатусыДоговоровКонтрагентов;
	ПроверитьРавенство(СтатусыДоговоров.НеСогласован, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейсы["C"].НеСогласован, ИмяСтатуса),
		"договор «Не согласован»");
	ПроверитьРавенство(СтатусыДоговоров.Закрыт, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейсы["C"].Закрыт, ИмяСтатуса),
		"договор «Закрыт»");

КонецПроцедуры

// Число выпусков продукции, основание которых - реализация.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация
//
// Возвращаемое значение:
//  Число - автовыпусков реализации
//
Функция ЧислоАвтовыпусков(Реализация)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Выпуск.Ссылка) КАК Выпусков
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуск
	|ГДЕ
	|	Выпуск.Основание = &Реализация
	|	И НЕ Выпуск.ПометкаУдаления");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Выпусков;

КонецФункции

// Число записей таблицы, созданных прогоном: поле среди значений, которые вернул генератор.
//
// Параметры:
//  ИмяТаблицы - Строка - таблица запроса
//  ИмяПоля    - Строка - поле отбора
//  Значения   - Массив - значения поля, записанные прогоном
//
// Возвращаемое значение:
//  Число - записей прогона
//
Функция ЧислоЗаписейНабора(ИмяТаблицы, ИмяПоля, Значения)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Записей
	|ИЗ
	|	&ИмяТаблицы КАК Таблица
	|ГДЕ
	|	Таблица.&ИмяПоля В (&Значения)";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", ИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПоля", ИмяПоля);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Значения", Значения);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Записей;

КонецФункции

#КонецОбласти

#Область ДанныеСценариев

// Данные, общие для сценариев. Всё, что записывается, заводится заново внутри
// транзакции сценария и откатывается вместе с ней; из базы берутся только организация,
// валюта учёта и предопределённые элементы. Свежая номенклатура и склад дают нулевые
// остатки - ожидаемые значения не зависят от содержимого базы.
//
// Возвращаемое значение:
//  Структура - контекст сценария, см. НовыйКонтекстДанных
//
Функция НовыйКонтекст()

	// Документы датируются чуть раньше текущего момента и с шагом в секунду: так
	// порядок документов на оси времени регистров совпадает с порядком их создания.
	Контекст = НовыйКонтекстДанных(ТекущаяДатаСеанса() - ЗапасСекунд(), ПометкаТеста());
	Контекст.Вставить("Единица", НоваяЕдиница());
	Контекст.Вставить("Склад", НовыйСклад());
	Контекст.Вставить("Контрагент", НовыйКонтрагент());
	Контекст.Вставить("ДоговорПокупателя", НовыйДоговор(Контекст, Перечисления.ВидыДоговоров.СПокупателем));
	Контекст.Вставить("ДоговорПоставщика", НовыйДоговор(Контекст, Перечисления.ВидыДоговоров.СПоставщиком));
	Контекст.Вставить("Касса", НоваяКасса(Контекст));
	Контекст.Вставить("Счет", НовыйБанковскийСчет(Контекст));
	Контекст.Вставить("Сотрудник", НовоеФизическоеЛицо());
	Контекст.Вставить("Товар", НоваяНоменклатура(Контекст, "товар", Перечисления.ТипыНоменклатуры.Товар));
	Контекст.Вставить("Сырье", НоваяНоменклатура(Контекст, "сырьё", Перечисления.ТипыНоменклатуры.Сырье));
	Контекст.Вставить("Продукция", НоваяПродукция(Контекст));

	Возврат Контекст;

КонецФункции

// Контекст документов без справочников: даты, организация, валюта и ставка НДС из базы. Им пользуются тесты документов и
// демо-набор (Обработки.ТестовыеДанные.СоздатьДемоНабор) вместе с помощниками НовыйДокумент, Провести, Записать,
// ДобавитьСтрокуТоваров, ДобавитьОснование, ДобавитьМатериалЗаказа, УстановитьКоличествоСтроки, СледующаяДата, СтатьяДДС.
// Справочники документов вызывающий кладёт в контекст сам; перед каждым кейсом можно подменить контрагента и договоры.
//
// Параметры:
//  Дата    - Дата   - дата, от которой отсчитываются даты документов (СледующаяДата прибавляет шаг)
//  Пометка - Строка - комментарий документов и признак объектов прогона
//
// Возвращаемое значение:
//  Структура - контекст:
//   * Числа              - Структура - количества и цены тестов, см. ЧислаСценариев
//   * Дата               - Дата      - начало отсчёта дат
//   * Шаг                - Число     - номер последнего шага дат
//   * Организация        - СправочникСсылка.Организации - первая организация базы
//   * Валюта             - СправочникСсылка.Валюты - валюта регламентированного учёта или первая валюта
//   * СтавкаНДС          - СправочникСсылка.СтавкиНДС - ставка без НДС
//   * СтатьяДДСЗапасная  - СправочникСсылка.СтатьиДвиженияДенежныхСредств - заводится при первой нужде, см. СтатьяДДС
//   * Пометка            - Строка - комментарий документов
//   Заполняет вызывающий: Единица, Склад, Контрагент, ДоговорПокупателя, ДоговорПоставщика, Касса, Счет.
//
Функция НовыйКонтекстДанных(Дата, Пометка) Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Числа", ЧислаСценариев());
	Контекст.Вставить("Дата", Дата);
	Контекст.Вставить("Шаг", 0);
	Контекст.Вставить("Пометка", Пометка);
	Контекст.Вставить("СтатьяДДСЗапасная", Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка());

	Организация = Обработки.ТестовыеДанные.ПервыйЭлемент("Организации");
	Проверить(ЗначениеЗаполнено(Организация), "в базе нет ни одной организации");
	Контекст.Вставить("Организация", Организация);

	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Обработки.ТестовыеДанные.ПервыйЭлемент("Валюты");
	КонецЕсли;
	Проверить(ЗначениеЗаполнено(Валюта), "не задана валюта регламентированного учёта и нет ни одной валюты");
	Контекст.Вставить("Валюта", Валюта);
	Контекст.Вставить("СтавкаНДС", Справочники.СтавкиНДС.SansTVA);

	Возврат Контекст;

КонецФункции

// Количества и цены сценариев в одном месте: ожидаемые значения считаются из них же.
//
// Возвращаемое значение:
//  Структура - количества и цены по именам
//
Функция ЧислаСценариев()

	// BSLLS:MagicNumber-off
	Числа = Новый Структура;
	Числа.Вставить("КоличествоЗакупки", 10);
	Числа.Вставить("ЦенаЗакупки", 50);
	Числа.Вставить("КоличествоПродажи", 3);
	Числа.Вставить("ЦенаПродажи", 100);
	Числа.Вставить("КоличествоСырья", 20);
	Числа.Вставить("ЦенаСырья", 10);
