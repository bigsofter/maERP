	Если Имя = "ОрдерныйСкладРасходПартий" Тогда
		Возврат СценарийОрдерныйСкладРасходПартий(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладВозвратМеждуОформлениями" Тогда
		Возврат СценарийОрдерныйСкладВозвратМеждуОформлениями(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладДопрасходы" Тогда
		Возврат СценарийОрдерныйСкладДопрасходы(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладОтменаСДопрасходами" Тогда
		Возврат СценарийОрдерныйСкладОтменаСДопрасходами(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладОбновление" Тогда
		Возврат СценарийОрдерныйСкладОбновление(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладРасходБезПартий" Тогда
		Возврат СценарийОрдерныйСкладРасходБезПартий(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладСтараяСхема" Тогда
		Возврат СценарийОрдерныйСкладСтараяСхема(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладПереводГруппы" Тогда
		Возврат СценарийОрдерныйСкладПереводГруппы(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладПереводРасходных" Тогда
		Возврат СценарийОрдерныйСкладПереводРасходных(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладПереводПотребителя" Тогда
		Возврат СценарийОрдерныйСкладПереводПотребителя(Контекст);
	КонецЕсли;
	Если Имя = "ОрдерныйСкладОбновлениеФазы5" Тогда
		Возврат СценарийОрдерныйСкладОбновлениеФазы5(Контекст);
	КонецЕсли;
	ВызватьИсключение "Сценарий " + Имя + " не описан в СценарийОрдерныхСкладовПоИмени";

КонецФункции

#Область ДокументПервый

// Ордерные склады v2, фаза 4 (docs/plans/warehouse-orders-cost.md, Ф4.13): документ первый - поступление и
// реализация на ордерном складе без ордера, ордер на их основании. Каждый отказ записи - последнее действие сценария.
//
// Параметры:
//  Имя      - Строка - имя сценария.
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДокументПервый(Имя, Контекст)
	// Признак ордерности склада записывается только при включённой опции; откат раннера вернёт значение.
	Константы.ИспользоватьОрдерныеСклады.Установить(Истина);
	Если Имя = "ДокументПервыйПриход" Тогда
		Возврат СценарийДокументПервыйПриход(Контекст);
	КонецЕсли;
	Если Имя = "ДокументПервыйДоли" Тогда
		Возврат СценарийДокументПервыйДоли(Контекст);
	КонецЕсли;
	Если Имя = "ДокументПервыйОтменаПоступления" Тогда
		Возврат СценарийДокументПервыйОтменаПоступления(Контекст);
	КонецЕсли;
	Если Имя = "ДокументПервыйРасход" Тогда
		Возврат СценарийДокументПервыйРасход(Контекст);
	КонецЕсли;
	Если Имя = "ДокументПервыйВозвратСверх" Тогда
		Возврат СценарийДокументПервыйВозвратСверх(Контекст);
	КонецЕсли;
	Если Имя = "ДокументПервыйОтменаОрдераСВозвратом" Тогда
		Возврат СценарийДокументПервыйОтменаОрдераСВозвратом(Контекст);
	КонецЕсли;
	Если Имя = "ДокументПервыйМомент" Тогда
		Возврат СценарийДокументПервыйМомент(Контекст);
	КонецЕсли;
	Если Имя = "ДокументПервыйДопрасходы" Тогда
		Возврат СценарийДокументПервыйДопрасходы(Контекст);
	КонецЕсли;
	Если Имя = "ДокументПервыйСерии" Тогда
		Возврат СценарийДокументПервыйСерии(Контекст);
	КонецЕсли;
	ВызватьИсключение "Сценарий " + Имя + " не описан в СценарийОрдерныхСкладовПоИмени";
КонецФункции

// Поступление без ордера ждёт приёмки, приходные ордера на его основании создают партии по доле строки, смена цены
// поступления пересчитывает партии обоих ордеров.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДокументПервыйПриход(Контекст)

	// BSLLS:MagicNumber-off
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар документа первого", Перечисления.ТипыНоменклатуры.Товар);
	Поступление = ПоступлениеБезОрдера(Контекст, Склад, Товар, 10, 10);
	ПроверитьРавенство(0, ОстатокПартийСклада(Склад, Товар), "поступление без ордера партий не создаёт");
	ПроверитьРавенство(10, ОстатокКОформлению(Поступление.Ссылка), "поступление ждёт приёмки 10");
	Первый = ОрдерПоДокументу(Контекст, "ПриходныйОрдер", Поступление.Ссылка, 6);
	ПроверитьРавенство(6, ОстатокПартийСклада(Склад, Товар), "приёмка 6 - партия 6");
	ПроверитьРавенство(60, СуммаПартииСценария(Первый), "партия первой приёмки - 6/10 стоимости строки");
	ПроверитьРавенство(4, ОстатокКОформлению(Поступление.Ссылка), "ждёт приёмки 4");
	Второй = ОрдерПоДокументу(Контекст, "ПриходныйОрдер", Поступление.Ссылка, Неопределено);
	ПроверитьРавенство(40, СуммаПартииСценария(Второй), "партия второй приёмки - остаток 4/10");
	ПроверитьРавенство(0, ОстатокКОформлению(Поступление.Ссылка), "всё принято");
	УстановитьЦенуСтрок(Поступление, 20);
	Провести(Поступление);
	ПроверитьРавенство(120, СуммаПартииСценария(Первый), "смена цены поступления - партия первого ордера пересчитана");
	ПроверитьРавенство(80, СуммаПартииСценария(Второй), "смена цены поступления - партия второго ордера пересчитана");
	// BSLLS:MagicNumber-on
	Возврат РезультатСценария("поступление без ордера ждёт приёмки, ордера на основании - партии по доле строки, смена "
		+ "цены поступления пересчитывает партии");

КонецФункции

// Три приёмки одной строки 10,00 за три штуки: доли наибольшими остатками - сумма равна строке, ни одна не отрицательна.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДокументПервыйДоли(Контекст)

	// BSLLS:MagicNumber-off
	Склад = ОрдерныйСкладСценария(Контекст, '00010101');
	Товар = НоваяНоменклатура(Контекст, "товар долей приёмки", Перечисления.ТипыНоменклатуры.Товар);
	Поступление = НовоеПоступлениеБезОрдера(Контекст, Склад, Товар, 3, 1);
	Строка = Поступление.ТЧТовары[0];
	Строка.Сумма = 10;
	Строка.СуммаСНДС = 10;
	Строка.Цена = 10 / 3;
	Провести(Поступление);
	Ордера = Новый Массив;
	Для Каждого Количество Из СтрРазделить("1,1,1", ",") Цикл
		Ордера.Добавить(ОрдерПоДокументу(Контекст, "ПриходныйОрдер", Поступление.Ссылка, Число(Количество)));
	КонецЦикла;
	// Доли пересчитываются у всех ордеров строки - читаются после последней приёмки.
	Итог = 0;
	Для Каждого Ордер Из Ордера Цикл
		Сумма = СуммаПартииСценария(Ордер);
		Проверить(Сумма > 0, "доля приёмки положительна");
		Итог = Итог + Сумма;
	КонецЦикла;
	ПроверитьРавенство(10, Итог, "доли трёх приёмок - вся стоимость строки");
	// BSLLS:MagicNumber-on
	Возврат РезультатСценария("три приёмки строки 10,00 - доли положительны, в сумме 10,00");

КонецФункции

// Поступление, принятое ордером, не отменяется: сначала ордер.
//
