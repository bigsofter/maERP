	Право = "Просмотр";
	Для Каждого ИмяРоли Из СтрРазделить("Кладовщик,Оператор,МенеджерПоЗакупкам", ",") Цикл
		Роль = Метаданные.Роли[ИмяРоли];
		Описание = "роль " + ИмяРоли;
