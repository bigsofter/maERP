// Продукция с технологической картой: на единицу уходит РасходСырьяНаЕдиницу сырья.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - записанная продукция
//
Функция НоваяПродукция(Контекст)

	Продукция = Справочники.Номенклатура.СоздатьЭлемент();
	Продукция.Наименование = ПометкаТеста() + ": продукция";
	Продукция.НаименованиеПолное = Продукция.Наименование;
	Продукция.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Продукция;
	Продукция.Единица = Контекст.Единица;
	Продукция.СтавкаНДС = Контекст.СтавкаНДС;
	Продукция.Записать();
	// Карта датируется датой сценария, а не текущим моментом: документы сценария начинаются
	// на ЗапасСекунд() раньше «сейчас» и идут вперёд шагом, поэтому карта на текущий момент
	// оказалась бы позже выпуска и на его дату не прочиталась бы.
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция.Ссылка, СоставКарты(Контекст), Контекст.Дата);
	Возврат Продукция.Ссылка;

КонецФункции

// Состав технологической карты продукции сценария: одно сырьё с расходом на единицу.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура, Характеристика, Упаковка, Количество
//
Функция СоставКарты(Контекст)

	Состав = Новый ТаблицаЗначений;
	Состав.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Состав.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Состав.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Состав.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Строка = Состав.Добавить();
	Строка.Номенклатура = Контекст.Сырье;
	Строка.Упаковка = Контекст.Единица;
	Строка.Количество = Контекст.Числа.РасходСырьяНаЕдиницу;
	Возврат Состав;

КонецФункции

// Статья ДДС для денежного документа: настроенная на операцию, а если такой нет -
// одна запасная статья на сценарий.
//
// Параметры:
//  Контекст              - Структура - см. НовыйКонтекст
//  ХозяйственнаяОперация - ПеречислениеСсылка.ХозяйственныеОперации - операция документа
//
// Возвращаемое значение:
//  СправочникСсылка.СтатьиДвиженияДенежныхСредств - статья
//
Функция СтатьяДДС(Контекст, ХозяйственнаяОперация) Экспорт

	Статья = ОбщегоНазначенияВызовСервера.ПолучитьСтатьюДДСПоХозяйственнойОперации(ХозяйственнаяОперация);
	Если ЗначениеЗаполнено(Статья) Тогда
		Возврат Статья;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Контекст.СтатьяДДСЗапасная) Тогда
		Запасная = Справочники.СтатьиДвиженияДенежныхСредств.СоздатьЭлемент();
		Запасная.Наименование = ПометкаТеста() + ": статья ДДС";
		Запасная.Записать();
		Контекст.СтатьяДДСЗапасная = Запасная.Ссылка;
	КонецЕсли;

	Возврат Контекст.СтатьяДДСЗапасная;

КонецФункции

#КонецОбласти

#Область Документы

// Новый документ с реквизитами по умолчанию, организацией и складом сценария.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  ИмяДокумента - Строка    - имя объекта метаданных
//
// Возвращаемое значение:
//  ДокументОбъект - незаписанный документ
//
Функция НовыйДокумент(Контекст, ИмяДокумента) Экспорт

	Док = Документы[ИмяДокумента].СоздатьДокумент();
	РаботаСДокументами.ЗаполнитьРеквизитыПоУмолчанию(Док);
	Док.Дата = СледующаяДата(Контекст);

	Реквизиты = Док.Метаданные().Реквизиты;
	Если Реквизиты.Найти("Организация") <> Неопределено Тогда
		Док.Организация = Контекст.Организация;
	КонецЕсли;
	Если Реквизиты.Найти("МестоХранения") <> Неопределено Тогда
		Док.МестоХранения = Контекст.Склад;
	КонецЕсли;
	Если Реквизиты.Найти("Комментарий") <> Неопределено Тогда
		Док.Комментарий = Контекст.Пометка;
	КонецЕсли;

	Возврат Док;

КонецФункции

// Проверка заполнения, запись с проведением и контроль результата. Ошибка проведения
// приходит исключением платформы, сообщения из ОбработкаПроведения добавляет ВыполнитьСценарий.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый документ
//
Процедура Провести(Док) Экспорт

	Если Не Док.ПроверитьЗаполнение() Тогда
		ВызватьИсключение ПредставлениеДокумента(Док) + ": не прошла проверка заполнения" + СообщенияПользователю();
	КонецЕсли;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Проверить(Док.Проведен, ПредставлениеДокумента(Док) + ": записан, но не проведён");

КонецПроцедуры

// Проверка заполнения и запись документа, у которого проведение запрещено.
//
// Параметры:
//  Док - ДокументОбъект - заполняемый документ
//
Процедура Записать(Док) Экспорт

	Если Не Док.ПроверитьЗаполнение() Тогда
		ВызватьИсключение ПредставлениеДокумента(Док) + ": не прошла проверка заполнения" + СообщенияПользователю();
	КонецЕсли;
	Док.Записать();

КонецПроцедуры

Функция ПредставлениеДокумента(Док)

	Представление = Док.Метаданные().Имя;
	Если ЗначениеЗаполнено(Док.Номер) Тогда
		Представление = Представление + " № " + СокрЛП(Док.Номер);
	КонецЕсли;
	Возврат Представление;

КонецФункции

// Строка товарной табличной части: заполняются те колонки, которые у части есть.
//
// Параметры:
//  Контекст     - Структура      - см. НовыйКонтекст
//  Док          - ДокументОбъект - заполняемый документ
//  ИмяТЧ        - Строка         - имя табличной части
//  Номенклатура - СправочникСсылка.Номенклатура
//  Количество   - Число
//  Цена         - Число - 0, если у части нет цены
//
Процедура ДобавитьСтрокуТоваров(Контекст, Док, ИмяТЧ, Номенклатура, Количество, Цена) Экспорт

	Колонки = Док.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты;
	Строка = Док[ИмяТЧ].Добавить();
	Сумма = Количество * Цена;

	ЗаполнитьКолонку(Строка, Колонки, "КодСтроки", Док[ИмяТЧ].Количество());
	ЗаполнитьКолонку(Строка, Колонки, "Номенклатура", Номенклатура);
	ЗаполнитьКолонку(Строка, Колонки, "Упаковка", Контекст.Единица);
	ЗаполнитьКолонку(Строка, Колонки, "КоличествоУпаковок", Количество);
	ЗаполнитьКолонку(Строка, Колонки, "Количество", Количество);
	ЗаполнитьКолонку(Строка, Колонки, "Цена", Цена);
	ЗаполнитьКолонку(Строка, Колонки, "Сумма", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "СуммаСНДС", Сумма);
	ЗаполнитьКолонку(Строка, Колонки, "СтавкаНДС", Контекст.СтавкаНДС);
	ЗаполнитьКолонку(Строка, Колонки, "СуммаНДС", 0);

КонецПроцедуры

Процедура ЗаполнитьКолонку(Строка, Колонки, ИмяКолонки, Значение)

	Если Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
		Строка[ИмяКолонки] = Значение;
	КонецЕсли;

КонецПроцедуры

// Строка оснований платёжного документа: по ней закрывается долг по документу расчётов.
//
// Параметры:
//  Док       - ДокументОбъект - заполняемый документ
//  Основание - ДокументСсылка - документ расчётов
//  Сумма     - Число - сумма
//
Процедура ДобавитьОснование(Док, Основание, Сумма) Экспорт

	Строка = Док.ТЧОснования.Добавить();
	Строка.Основание = Основание;
	Строка.Сумма = Сумма;

КонецПроцедуры

// Сырьё выпуска по технологической карте продукции: расход на единицу умножается на выпуск.
//
// Параметры:
//  Контекст          - Структура - см. НовыйКонтекст
//  Выпуск            - ДокументОбъект.ВыпускПродукции - заполняемый выпуск
//  КоличествоВыпуска - Число - сколько продукции выпускается
//
Процедура ЗаполнитьСырьеПоТехкарте(Контекст, Выпуск, КоличествоВыпуска)

	Продукция = Новый Массив;
	Продукция.Добавить(Выпуск.Номенклатура);
	Для Каждого СтрокаКарты Из ТехнологическиеКарты.СоставТехкарт(Продукция, Выпуск.Дата) Цикл
		ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧТовары", СтрокаКарты.Номенклатура,
			СтрокаКарты.Количество * КоличествоВыпуска, 0);
	КонецЦикла;
	Проверить(Выпуск.ТЧТовары.Количество() > 0, "у продукции нет технологической карты");

КонецПроцедуры

// Проведённое поступление товаров от контрагента сценария.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Номенклатура - СправочникСсылка.Номенклатура - позиция номенклатуры
//  Количество   - Число - количество в единицах
//  Цена         - Число - цена; 0, если у части нет цены
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеТоваровУслуг - проведённое поступление
//
Функция ДокументЗакупки(Контекст, Номенклатура, Количество, Цена)

	Док = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПоставщика;
	Док.ЦенаВключаетНДС = Истина;
	Док.Валюта = Контекст.Валюта;
	Док.КурсВалюты = 1;
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Номенклатура, Количество, Цена);
	Провести(Док);
	Возврат Док.Ссылка;

КонецФункции

// Записанный заказ покупателя (проведение у заказа запрещено).
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Номенклатура - СправочникСсылка.Номенклатура - позиция номенклатуры
//  Количество   - Число - количество в единицах
//  Цена         - Число - цена; 0, если у части нет цены
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПокупателя - записанный заказ
//
Функция ДокументЗаказаПокупателя(Контекст, Номенклатура, Количество, Цена)

	Док = НовыйДокумент(Контекст, "ЗаказПокупателя");
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПокупателя;
	Док.ЦенаВключаетНДС = Истина;
	Док.ДатаОтгрузки = Док.Дата;
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Номенклатура, Количество, Цена);
	Записать(Док);
	Возврат Док.Ссылка;

КонецФункции

// Проведённая реализация, введённая на основании заказа: состав и контрагент - из заказа.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ-основание
//
// Возвращаемое значение:
//  ДокументСсылка.РеализацияТоваровУслуг - проведённая реализация
//
Функция ДокументРеализацииПоЗаказу(Контекст, Заказ)

	Док = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Док.Заполнить(Заказ);
	Док.Дата = СледующаяДата(Контекст);
	Док.МестоХранения = Контекст.Склад;
	Док.Комментарий = ПометкаТеста();
	Провести(Док);
	Возврат Док.Ссылка;

КонецФункции

// Проведённая реализация без заказа.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Номенклатура - СправочникСсылка.Номенклатура - позиция номенклатуры
//  Количество   - Число - количество в единицах
