	Настройки.Структура.Очистить();
	Детали = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Для Каждого ИмяПоля Из СтрРазделить("ПоступлениеТоваровУслуг,Долг,ПросроченоДней", ",") Цикл
		Поле = Детали.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, Новый Структура("ТЗ", Источник));
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);

	Возврат Результат.Найти(Поступление, "ПоступлениеТоваровУслуг");

КонецФункции

// Цена, установленная в карточке номенклатуры после того, как номенклатуру выбрали в строке КП без цены,
// подставляется при повторном выборе в той же строке (2MZL, 2026-09-29). Раньше подбор цены без результата
// сбрасывал вид цен строки, пустой вид означает «произвольная цена», и цена больше не искалась.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийЦенаПослеУстановкиВКарточке(Контекст)

	ВидЦены = Справочники.ВидыЦен.Розничная;
	Товар = НоваяНоменклатура(Контекст, "товар без цены", Перечисления.ТипыНоменклатуры.Товар);
	Предложение = НовыйДокумент(Контекст, "КоммерческоеПредложение");
	Предложение.Контрагент = Контекст.Контрагент;
	Предложение.Договор = Контекст.ДоговорПокупателя;
	СтрокаТовара = Предложение.ТЧТовары.Добавить();
	СтрокаТовара.КодСтроки = 1;
	СтрокаТовара.ВидЦены = ВидЦены;
	СтрокаТовара.Номенклатура = Товар;
	РаботаСДокументамиКлиентСервер.УстановитьПараметрыНоменклатуры(СтрокаТовара, Предложение);
	ПроверитьРавенство(0, СтрокаТовара.Цена, "цены ещё нет");
	ПроверитьРавенство(ВидЦены, СтрокаТовара.ВидЦены, "вид цен строки без цены не сброшен");

	Установка = НовыйДокумент(Контекст, "УстановкаЦенНоменклатурыВручную");
	Установка.Номенклатура = Товар;
	Установка.Дата = Предложение.Дата;
	СтрокаЦены = Установка.ТЧЦены.Добавить();
	СтрокаЦены.ВидЦены = ВидЦены;
	СтрокаЦены.Цена = Контекст.Числа.ЦенаПродажи;
	Провести(Установка);

	РаботаСДокументамиКлиентСервер.УстановитьПараметрыНоменклатуры(СтрокаТовара, Предложение);
	Проверить(СтрокаТовара.Цена > 0, "цена из карточки подставилась при повторном выборе в той же строке");

	Возврат РезультатСценария("номенклатура без цены не сбрасывает вид цен строки КП, "
		+ "цена, установленная позже, подставляется при повторном выборе в той же строке");

КонецФункции

// Документы в валюте (2.0.16.22, docs/plans/multicurrency.md): поступление и реализация с флажком «В валюте»
// пишут в регистры суммы в основной валюте по курсу документа, а взаиморасчёты - ещё валюту и сумму в ней;
// оплата в основной валюте закрывает валютный долг и по сумме, и по сумме в валюте; цена вида цен в валюте
// пересчитывается в валюту документа; возврат по валютной реализации отклоняется (последний шаг - отказ).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДокументыВВалюте(Контекст)

	Основная = РаботаСВалютами.ОсновнаяВалюта();
	Проверить(ЗначениеЗаполнено(Основная), "не задана валюта регламентированного учёта");
	Валюта = ?(Основная = Справочники.Валюты.Евро, Справочники.Валюты.ДолларСША, Справочники.Валюты.Евро);
	Курс = 11;
	КоличествоЗакупки = 10;
	ЦенаЗакупки = 5; // в валюте
	КоличествоПродажи = 4;
	ЦенаПродажи = 8; // в валюте
	ЦенаВидаЦен = 7; // в валюте вида цен
	СуммаЗакупки = КоличествоЗакупки * ЦенаЗакупки;
	СуммаЗакупкиРегл = СуммаЗакупки * Курс;
	СуммаПродажи = КоличествоПродажи * ЦенаПродажи;
	СуммаПродажиРегл = СуммаПродажи * Курс;
	ЗаписьКурса = РегистрыСведений.КурсыВалют.СоздатьМенеджерЗаписи();
	ЗаписьКурса.Период = НачалоДня(Контекст.Дата);
	ЗаписьКурса.Валюта = Валюта;
	ЗаписьКурса.Курс = Курс;
	ЗаписьКурса.Записать();
	ПроверитьРавенство(Курс, РаботаСВалютами.КурсВалюты(Валюта, СледующаяДата(Контекст)), "курс из регистра");
	ПроверитьРавенство(1, РаботаСВалютами.КурсВалюты(Основная, Контекст.Дата), "курс основной валюты");

	// Поступление: 10 по 5 в валюте
	Поступление = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Поступление.Контрагент = Контекст.Контрагент;
	Поступление.Договор = Контекст.ДоговорПоставщика;
	Поступление.ЦенаВключаетНДС = Истина;
	Поступление.ВВалюте = Истина;
	Поступление.Валюта = Валюта;
	Поступление.КурсВалюты = Курс;
	ДобавитьСтрокуТоваров(Контекст, Поступление, "ТЧТовары", Контекст.Товар, КоличествоЗакупки, ЦенаЗакупки);
	Провести(Поступление);
	ПроверитьРавенство(СуммаЗакупкиРегл, Поступление.СуммаРегл, "сумма поступления в основной валюте");
	ПроверитьРавенство(СуммаЗакупкиРегл, Поступление.ТЧТовары[0].СуммаРегл, "сумма строки поступления в основной валюте");
	Остаток = ОстатокТовара(Контекст.Склад, Контекст.Товар);
	ПроверитьРавенство(СуммаЗакупкиРегл, Остаток.Сумма, "себестоимость остатка - в основной валюте");
	ПроверитьВалютныйОстаток("ВзаиморасчётыСПоставщиками", Поступление.Ссылка, Валюта, -СуммаЗакупкиРегл, -СуммаЗакупки,
		"долг поставщику");
	ЦенаПоставщика = РегистрыСведений.ЦеныНоменклатурыПоставщиков.ПоследнийПрайс(СледующаяДата(Контекст),
		Контекст.Товар, Контекст.Контрагент);
	ПроверитьРавенство(1, ЦенаПоставщика.Количество(), "цена поставщика записана");
	ПроверитьРавенство(ЦенаЗакупки * Курс, ЦенаПоставщика[0].Цена, "цена поставщика - в основной валюте");

	// Флажок снят - валюта и курс приводятся к основной
	Черновик = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Черновик.Валюта = Валюта;
	Черновик.КурсВалюты = Курс;
	РаботаСВалютами.ПроверитьВалютуДокумента(Черновик);
	ПроверитьРавенство(Основная, Черновик.Валюта, "без флажка - основная валюта");
	ПроверитьРавенство(1, Черновик.КурсВалюты, "без флажка - курс 1");

	// Реализация: 4 по 8 в валюте, оплата в основной валюте
	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Реализация.Контрагент = Контекст.Контрагент;
	Реализация.Договор = Контекст.ДоговорПокупателя;
	Реализация.ЦенаВключаетНДС = Истина;
	Реализация.ВВалюте = Истина;
	Реализация.Валюта = Валюта;
	Реализация.КурсВалюты = Курс;
	ДобавитьСтрокуТоваров(Контекст, Реализация, "ТЧТовары", Контекст.Товар, КоличествоПродажи, ЦенаПродажи);
	Провести(Реализация);
	ПроверитьРавенство(СуммаПродажиРегл, Реализация.СуммаРегл, "сумма реализации в основной валюте");
	Продажи = ОборотыПродаж(Реализация.Ссылка);
	ПроверитьРавенство(СуммаПродажиРегл, Продажи.Выручка, "выручка - в основной валюте");
	ПроверитьРавенство(КоличествоПродажи * ЦенаЗакупки * Курс, Продажи.Себестоимость, "себестоимость - в основной валюте");
	ПроверитьВалютныйОстаток("ВзаиморасчётыСПокупателями", Реализация.Ссылка, Валюта, СуммаПродажиРегл, СуммаПродажи,
		"долг покупателя");
	ДокументОплатыВКассу(Контекст, Реализация.Ссылка, СуммаПродажиРегл);
	ПроверитьВалютныйОстаток("ВзаиморасчётыСПокупателями", Реализация.Ссылка, Валюта, 0, 0,
		"оплата в основной валюте закрыла валютный долг");

	// Цена вида цен в валюте
	ВидЦены = Справочники.ВидыЦен.СоздатьЭлемент();
	ВидЦены.Наименование = Контекст.Пометка + " цены в валюте";
	ВидЦены.ЦенаВключаетНДС = Истина;
	ВидЦены.Валюта = Валюта;
	ВидЦены.Записать();
	Установка = НовыйДокумент(Контекст, "УстановкаЦенНоменклатурыВручную");
	Установка.Номенклатура = Контекст.Товар;
	СтрокаЦены = Установка.ТЧЦены.Добавить();
	СтрокаЦены.ВидЦены = ВидЦены.Ссылка;
	СтрокаЦены.Цена = ЦенаВидаЦен;
	Провести(Установка);
	ПроверитьРавенство(ЦенаВидаЦен, ЦенаВидаЦенВДокументе(Контекст, ВидЦены.Ссылка, Истина, Валюта, Курс),
		"цена вида цен в валюте документа - без пересчёта");
	ПроверитьРавенство(ЦенаВидаЦен * Курс, ЦенаВидаЦенВДокументе(Контекст, ВидЦены.Ссылка, Ложь, Валюта, Курс),
		"цена вида цен в валюте - пересчёт в основную валюту");
	ПроверитьРавенство(ЦенаВидаЦен, РаботаСВалютами.ПересчитатьЦену(ЦенаВидаЦен * Курс, Основная, Валюта, Курс, Контекст.Дата),
		"цена в основной валюте - пересчёт в валюту документа");

	// Возврат по валютной реализации - сценарий ВозвратыВВалюте (2.0.16.25).
	Возврат РезультатСценария("поступление и реализация в валюте: себестоимость, выручка, цена поставщика и "
		+ "взаиморасчёты в основной валюте, долг в валюте; оплата в основной валюте закрыла валютный долг; "
		+ "цена вида цен в валюте пересчитана");

КонецФункции

// Оплаты в валюте (2.0.16.23, docs/plans/multicurrency-payments.md): валюта платёжного документа - валюта счёта,
// долг в валюте закрывается полностью по курсу объекта расчётов, разница с деньгами в основной валюте - курсовая
// разница в регистре Убытки (поступление денег - со знаком минус, списание - плюс); остаток валютного счёта - в
// основной валюте и в валюте счёта; оплата валютного долга в основной валюте закрывает его по курсу на дату
// оплаты; в валюте нельзя провести операцию, кроме расчётов с контрагентами (последний шаг - отказ).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОплатыВВалюте(Контекст)

	Основная = РаботаСВалютами.ОсновнаяВалюта();
	Валюта = ?(Основная = Справочники.Валюты.Евро, Справочники.Валюты.ДолларСША, Справочники.Валюты.Евро);
	КурсДокументов = 11;
	КурсОплаты = 11.2;
	ЗаписьКурса = РегистрыСведений.КурсыВалют.СоздатьМенеджерЗаписи();
	ЗаписьКурса.Период = НачалоДня(Контекст.Дата);
	ЗаписьКурса.Валюта = Валюта;
	ЗаписьКурса.Курс = КурсОплаты;
	ЗаписьКурса.Записать();
	СчетВВалюте = НовыйБанковскийСчет(Контекст);
	ОбъектСчета = СчетВВалюте.ПолучитьОбъект();
	ОбъектСчета.Валюта = Валюта;
	ОбъектСчета.Записать();

	// Поступление 10 по 10 в валюте по курсу 11 и оплата с валютного счёта по курсу 11,2
	КоличествоЗакупки = 10;
	ЦенаЗакупки = 10;
	СуммаЗакупки = КоличествоЗакупки * ЦенаЗакупки;
	Поступление = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Поступление.Контрагент = Контекст.Контрагент;
	Поступление.Договор = Контекст.ДоговорПоставщика;
	Поступление.ЦенаВключаетНДС = Истина;
	Поступление.ВВалюте = Истина;
	Поступление.Валюта = Валюта;
	Поступление.КурсВалюты = КурсДокументов;
	ДобавитьСтрокуТоваров(Контекст, Поступление, "ТЧТовары", Контекст.Товар, КоличествоЗакупки, ЦенаЗакупки);
	Провести(Поступление);

	Списание = НовыйДокумент(Контекст, "СписаниеБезналичныхДенежныхСредств");
	Списание.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	Списание.Контрагент = Контекст.Контрагент;
	Списание.Договор = Контекст.ДоговорПоставщика;
	// BSLLS:YoLetterUsage-off
	Списание.БанковскийСчёт = СчетВВалюте;
	// BSLLS:YoLetterUsage-on
	Списание.ТипОплаты = Справочники.TypesDePayment.VirementBanquaire;
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Списание.ХозяйственнаяОперация);
	Списание.Сумма = СуммаЗакупки;
	ДобавитьОснование(Списание, Поступление.Ссылка, СуммаЗакупки);
	Провести(Списание);
	ПроверитьРавенство(Валюта, Списание.Валюта, "валюта списания - валюта счёта");
	ПроверитьРавенство(КурсОплаты, Списание.КурсВалюты, "курс списания - на дату оплаты");
	ПроверитьВалютныйОстаток("ВзаиморасчётыСПоставщиками", Поступление.Ссылка, Валюта, 0, 0,
		"оплата в валюте закрыла долг поставщику");
	ПроверитьРавенство(-СуммаЗакупки * КурсОплаты, ОстатокДенег(СчетВВалюте), "деньги на счёте в основной валюте");
	ПроверитьРавенство(-СуммаЗакупки, ОстатокДенегВВалюте(СчетВВалюте), "деньги на счёте в валюте счёта");
	ПроверитьРавенство(СуммаЗакупки * (КурсОплаты - КурсДокументов), КурсоваяРазницаДокумента(Списание.Ссылка),
		"курсовая разница оплаты поставщику - расход");

	// Реализация 5 по 10 в валюте по курсу 11 и оплата в кассу в основной валюте по курсу 11,2
	КоличествоПродажи = 5;
	ЦенаПродажи = 10;
	СуммаПродажи = КоличествоПродажи * ЦенаПродажи;
	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Реализация.Контрагент = Контекст.Контрагент;
	Реализация.Договор = Контекст.ДоговорПокупателя;
	Реализация.ЦенаВключаетНДС = Истина;
	Реализация.ВВалюте = Истина;
	Реализация.Валюта = Валюта;
	Реализация.КурсВалюты = КурсДокументов;
	ДобавитьСтрокуТоваров(Контекст, Реализация, "ТЧТовары", Контекст.Товар, КоличествоПродажи, ЦенаПродажи);
	Провести(Реализация);
	СуммаОплаты = СуммаПродажи * КурсОплаты;
	Оплата = ДокументОплатыВКассу(Контекст, Реализация.Ссылка, СуммаОплаты);
	ПроверитьВалютныйОстаток("ВзаиморасчётыСПокупателями", Реализация.Ссылка, Валюта, 0, 0,
		"оплата в основной валюте по курсу дня закрыла валютный долг");
	ПроверитьРавенство(-СуммаПродажи * (КурсОплаты - КурсДокументов), КурсоваяРазницаДокумента(Оплата.Ссылка),
		"курсовая разница поступления от покупателя - доход");

	// Документ в основной валюте, оплаченный основной валютой, - без курсовой разницы и без валюты
	РеализацияВОсновной = ДокументРеализации(Контекст, Контекст.Товар, 1, ЦенаПродажи);
	ОплатаВОсновной = ДокументОплатыВКассу(Контекст, РеализацияВОсновной, ЦенаПродажи);
	ПроверитьРавенство(0, КурсоваяРазницаДокумента(ОплатаВОсновной.Ссылка), "оплата в основной валюте - без разницы");
	ПроверитьДолгПокупателя(РеализацияВОсновной, 0, "долг в основной валюте закрыт");
	ПроверитьРавенство(Основная, ОплатаВОсновной.Валюта, "валюта оплаты в основной кассе - основная");

	// Последний шаг - настоящий отказ записи: прочая операция с валютного счёта
	Прочее = НовыйДокумент(Контекст, "СписаниеБезналичныхДенежныхСредств");
	Прочее.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочийРасходДенежныхСредств;
	// BSLLS:YoLetterUsage-off
	Прочее.БанковскийСчёт = СчетВВалюте;
	// BSLLS:YoLetterUsage-on
	Прочее.ТипОплаты = Справочники.TypesDePayment.VirementBanquaire;
	Прочее.СтатьяДДС = СтатьяДДС(Контекст, Прочее.ХозяйственнаяОперация);
	Прочее.Сумма = ЦенаЗакупки;
	Отклонено = Ложь;
	Попытка
		Прочее.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	Проверить(Отклонено, "прочий расход с валютного счёта не проводится");

	Возврат РезультатСценария("оплата поставщику с валютного счёта: долг закрыт в обеих суммах, деньги в основной "
		+ "валюте и в валюте счёта, курсовая разница - расход; оплата покупателя в основной валюте по курсу дня "
		+ "закрыла валютный долг, курсовая разница - доход; прочий расход в валюте отклонён");

КонецФункции

// Заказы в валюте (2.0.16.24, docs/plans/multicurrency-orders.md): реализация и поступление на основании
// заказов переносят валюту и цены, курс - на дату нового документа; заказ поставщику пишет «Заказы поставщикам»
// в основной валюте; ПКО на основании валютного заказа - сумма в основной валюте по курсу заказа.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийЗаказыВВалюте(Контекст)

	Основная = РаботаСВалютами.ОсновнаяВалюта();
	Валюта = ?(Основная = Справочники.Валюты.Евро, Справочники.Валюты.ДолларСША, Справочники.Валюты.Евро);
	КурсЗаказа = 11;
	КурсДня = 11.2;
	ЗаписьКурса = РегистрыСведений.КурсыВалют.СоздатьМенеджерЗаписи();
	ЗаписьКурса.Период = НачалоДня(Контекст.Дата);
	ЗаписьКурса.Валюта = Валюта;
	ЗаписьКурса.Курс = КурсДня;
	ЗаписьКурса.Записать();
	Количество = 2;
	Цена = 8;

	// Заказ покупателя в валюте -> реализация на основании
	Заказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	Заказ.Контрагент = Контекст.Контрагент;
	Заказ.Договор = Контекст.ДоговорПокупателя;
	Заказ.ЦенаВключаетНДС = Истина;
	Заказ.ДатаОтгрузки = Заказ.Дата;
	Заказ.ВВалюте = Истина;
	Заказ.Валюта = Валюта;
	Заказ.КурсВалюты = КурсЗаказа;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Товар, Количество, Цена);
	Записать(Заказ);
	ПроверитьРавенство(Количество * Цена * КурсЗаказа, Заказ.СуммаРегл, "сумма заказа в основной валюте");
	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.Заполнить(Заказ.Ссылка);
	Проверить(Реализация.ВВалюте, "реализация на основании валютного заказа - в валюте");
	ПроверитьРавенство(Валюта, Реализация.Валюта, "валюта реализации - валюта заказа");
	ПроверитьРавенство(КурсДня, Реализация.КурсВалюты, "курс реализации - на её дату");
	ПроверитьРавенство(Цена, Реализация.ТЧТовары[0].Цена, "цена заказа перенесена в валюте");

	// ПКО на основании валютного заказа в кассу в основной валюте
	Оплата = НовыйДокумент(Контекст, "ПриходныйКассовыйОрдер");
	Оплата.Заполнить(Заказ.Ссылка);
	ПроверитьРавенство(Количество * Цена * КурсЗаказа, Оплата.Сумма, "аванс по валютному заказу - в основной валюте по курсу заказа");

	// Заказ поставщику в валюте -> «Заказы поставщикам» в основной валюте, поступление на основании
	ЗаказПоставщику = НовыйДокумент(Контекст, "ЗаказПоставщику");
	ЗаказПоставщику.ВидЗаказа = Перечисления.ВидыЗаказовПоставщику.Основной;
	ЗаказПоставщику.ДатаПоставки = ЗаказПоставщику.Дата;
	ЗаказПоставщику.Контрагент = Контекст.Контрагент;
	ЗаказПоставщику.Договор = Контекст.ДоговорПоставщика;
	ЗаказПоставщику.ЦенаВключаетНДС = Истина;
	ЗаказПоставщику.ВВалюте = Истина;
	ЗаказПоставщику.Валюта = Валюта;
	ЗаказПоставщику.КурсВалюты = КурсЗаказа;
	ДобавитьСтрокуТоваров(Контекст, ЗаказПоставщику, "ТЧТовары", Контекст.Товар, Количество, Цена);
	Провести(ЗаказПоставщику);
	ПроверитьРавенство(Количество * Цена * КурсЗаказа, СуммаЗаказовПоставщикам(ЗаказПоставщику.Ссылка),
		"«Заказы поставщикам» - в основной валюте");
	Поступление = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Поступление.Заполнить(ЗаказПоставщику.Ссылка);
	ПроверитьРавенство(Валюта, Поступление.Валюта, "поступление на основании - валюта заказа");
	Проверить(Поступление.ВВалюте, "поступление на основании валютного заказа - в валюте");

	Возврат РезультатСценария("реализация и поступление на основании валютных заказов - валюта и цены заказа, "
		+ "курс на дату документа; заказ поставщику - в основной валюте в регистре; ПКО по заказу - по курсу заказа");

КонецФункции

// Возвраты, налоговая накладная, прочие расходы и сертификат в валюте (2.0.16.25,
// docs/plans/multicurrency-returns.md): возврат берёт валюту и курс реализации (не курс дня) и закрывает её долг в
// обеих суммах, товар возвращается по себестоимости в основной валюте; налоговая накладная по валютной реализации -
// в её валюте, долг переезжает на накладную в обеих суммах; прочие расходы в валюте проводятся в основной валюте;
// сертификат по валютному поступлению - в основной валюте.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВозвратыВВалюте(Контекст)

	Основная = РаботаСВалютами.ОсновнаяВалюта();
	Валюта = ?(Основная = Справочники.Валюты.Евро, Справочники.Валюты.ДолларСША, Справочники.Валюты.Евро);
	КурсДокументов = 11;
	КурсДня = 11.2;
	ЗаписьКурса = РегистрыСведений.КурсыВалют.СоздатьМенеджерЗаписи();
	ЗаписьКурса.Период = НачалоДня(Контекст.Дата);
	ЗаписьКурса.Валюта = Валюта;
	ЗаписьКурса.Курс = КурсДня;
	ЗаписьКурса.Записать();
	КоличествоЗакупки = 10;
	ЦенаЗакупки = 5;
	КоличествоПродажи = 4;
	ЦенаПродажи = 8;
	СуммаПродажи = КоличествоПродажи * ЦенаПродажи;
	РегистрПокупателей = "ВзаиморасчётыСПокупателями";

	// Поступление и реализация в валюте по курсу 11, возврат на основании реализации
	Поступление = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Поступление.Контрагент = Контекст.Контрагент;
	Поступление.Договор = Контекст.ДоговорПоставщика;
	Поступление.ЦенаВключаетНДС = Истина;
	Поступление.ВВалюте = Истина;
	Поступление.Валюта = Валюта;
	Поступление.КурсВалюты = КурсДокументов;
	ДобавитьСтрокуТоваров(Контекст, Поступление, "ТЧТовары", Контекст.Товар, КоличествоЗакупки, ЦенаЗакупки);
	Провести(Поступление);
	Реализация = РеализацияВВалюте(Контекст, Валюта, КурсДокументов, КоличествоПродажи, ЦенаПродажи);

	ДокВозврата = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	ДокВозврата.Заполнить(Реализация);
	ДокВозврата.Дата = СледующаяДата(Контекст);
	ДокВозврата.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	Провести(ДокВозврата);
	Проверить(ДокВозврата.ВВалюте, "возврат по валютной реализации - в валюте");
	ПроверитьРавенство(Валюта, ДокВозврата.Валюта, "валюта возврата - валюта реализации");
	ПроверитьРавенство(КурсДокументов, ДокВозврата.КурсВалюты, "курс возврата - курс реализации, не курс дня");
	ПроверитьРавенство(СуммаПродажи * КурсДокументов, ДокВозврата.СуммаРегл, "сумма возврата в основной валюте");
	ПроверитьВалютныйОстаток(РегистрПокупателей, Реализация, Валюта, 0, 0,
		"возврат закрыл долг реализации в обеих суммах");
	Остаток = ОстатокТовара(Контекст.Склад, Контекст.Товар);
	ПроверитьРавенство(КоличествоЗакупки, Остаток.Количество, "товар вернулся на склад");
	ПроверитьРавенство(КоличествоЗакупки * ЦенаЗакупки * КурсДокументов, Остаток.Сумма,
		"себестоимость остатка после возврата - в основной валюте");

	// Налоговая накладная по второй валютной реализации, оплаченной наполовину в основной валюте по курсу дня:
	// долг и оплата переезжают на накладную в обеих суммах, перепроведение накладной их не задваивает
	Реализация2 = РеализацияВВалюте(Контекст, Валюта, КурсДокументов, КоличествоПродажи, ЦенаПродажи);
	ДоляОплаты = 0.5;
	ОплатаВВалюте = СуммаПродажи * ДоляОплаты;
	ДокументОплатыВКассу(Контекст, Реализация2, ОплатаВВалюте * КурсДня);
	Накладная = ПроведеннаяНалоговаяНакладная(Контекст, Реализация2);
	ПроверитьРавенство(Валюта, ЗначениеРеквизитаЗапросом(Накладная, "Валюта"), "валюта накладной - валюта отгрузки");
	ПроверитьРавенство(КурсДокументов, ЗначениеРеквизитаЗапросом(Накладная, "КурсВалюты"), "курс накладной - курс отгрузки");
	ПроверитьВалютныйОстаток(РегистрПокупателей, Реализация2, Валюта, 0, 0, "долг ушёл с реализации");
	ДолгРегл = (СуммаПродажи - ОплатаВВалюте) * КурсДокументов;
	ДолгВВалюте = СуммаПродажи - ОплатаВВалюте;
	ПроверитьВалютныйОстаток(РегистрПокупателей, Накладная, Валюта, ДолгРегл, ДолгВВалюте, "долг за вычетом оплаты на накладной");
	ПроверитьРавенство(СуммаПродажи * КурсДокументов, ЗначениеРеквизитаЗапросом(Накладная, "СуммаРегл"),
		"сумма накладной в основной валюте - сумма отгрузки");
	ОбъектНакладной = Накладная.ПолучитьОбъект();
	Провести(ОбъектНакладной);
	ПроверитьВалютныйОстаток(РегистрПокупателей, Накладная, Валюта, ДолгРегл, ДолгВВалюте,
		"перепроведённая накладная не задвоила оплату");

	// Прочие расходы в валюте - в основной валюте по курсу
	СуммаРасходов = 30;
	Расходы = НовыйДокумент(Контекст, "ПрочиеРасходы");
	Расходы.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОперационныеЗатраты;
	Расходы.Контрагент = Контекст.Контрагент;
	Расходы.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	Расходы.Сумма = СуммаРасходов;
	СтрокаРасходов = Расходы.ТЧРасходы.Добавить();
	СтрокаРасходов.СтатьяДДС = Расходы.СтатьяДДС;
	СтрокаРасходов.Сумма = СуммаРасходов;
	Расходы.ВВалюте = Истина;
	Расходы.Валюта = Валюта;
	Расходы.КурсВалюты = КурсДокументов;
	Провести(Расходы);
	ПроверитьРавенство(СуммаРасходов * КурсДокументов, СуммаДвиженийДокумента("Убытки", Расходы.Ссылка),
		"убытки прочих расходов - в основной валюте");
	ПроверитьРавенство(СуммаРасходов * КурсДокументов,
		СуммаДвиженийДокумента("ВзаиморасчётыСКонтрагентамиПрочие", Расходы.Ссылка),
		"долг по прочим расходам - в основной валюте");

	// Сертификат по валютному поступлению - в основной валюте
	Сертификат = НовыйДокумент(Контекст, "СертификатНаОплату");
	Сертификат.Заполнить(Поступление.Ссылка);
	ПроверитьРавенство(КоличествоЗакупки * ЦенаЗакупки * КурсДокументов, Сертификат.Сумма,
		"сертификат по валютному поступлению - в основной валюте");

	Возврат РезультатСценария("возврат по валютной реализации - в её валюте и по её курсу, долг закрыт в обеих суммах, "
		+ "товар вернулся по себестоимости; налоговая накладная - в валюте отгрузки, долг и оплата по курсу дня "
		+ "переехали в обеих суммах, перепроведение их не задваивает; "
		+ "прочие расходы и сертификат - в основной валюте по курсу");

КонецФункции

// Проведённая реализация товара сценария в валюте.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Валюта - СправочникСсылка.Валюты - валюта реализации.
//  Курс - Число - курс реализации.
//  Количество - Число - количество товара.
//  Цена - Число - цена в валюте.
//
// Возвращаемое значение:
//  ДокументСсылка.РеализацияТоваровУслуг - реализация
//
Функция РеализацияВВалюте(Контекст, Валюта, Курс, Количество, Цена)

	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Реализация.Контрагент = Контекст.Контрагент;
	Реализация.Договор = Контекст.ДоговорПокупателя;
	Реализация.ЦенаВключаетНДС = Истина;
	Реализация.ВВалюте = Истина;
	Реализация.Валюта = Валюта;
	Реализация.КурсВалюты = Курс;
	ДобавитьСтрокуТоваров(Контекст, Реализация, "ТЧТовары", Контекст.Товар, Количество, Цена);
	Провести(Реализация);
	Возврат Реализация.Ссылка;

КонецФункции

// Сумма движений документа по регистру накопления (ресурс Сумма, со знаком вида движения не считается).
//
// Параметры:
//  ИмяРегистра - Строка - Убытки или ВзаиморасчётыСКонтрагентамиПрочие.
//  Документ - ДокументСсылка - регистратор.
//
// Возвращаемое значение:
//  Число - сумма движений
//
Функция СуммаДвиженийДокумента(ИмяРегистра, Документ)

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Движения.Сумма), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.Убытки КАК Движения
		|ГДЕ
		|	Движения.Регистратор = &Документ";
	Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "РегистрНакопления.Убытки", "РегистрНакопления." + ИмяРегистра));
	Запрос.УстановитьПараметр("Документ", Документ);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;

КонецФункции

// Остаток суммы регистра «Заказы поставщикам» по заказу.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПоставщику - заказ
//
// Возвращаемое значение:
//  Число - сумма в основной валюте
//
Функция СуммаЗаказовПоставщикам(Заказ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ЗаказыПоставщикам.Остатки(, ЗаказПоставщику = &Заказ) КАК Остатки");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;

КонецФункции

// Остаток денег кассы или счёта в их валюте (ресурс СуммаВВалюте).
//
// Параметры:
//  МестоХранения - СправочникСсылка.Кассы, СправочникСсылка.БанковскиеСчета - касса или счёт
//
// Возвращаемое значение:
//  Число - остаток в валюте
//
Функция ОстатокДенегВВалюте(МестоХранения)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.СуммаВВалютеОстаток), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваОрганизаций.Остатки(, МестоХранения = &МестоХранения) КАК Остатки");
	Запрос.УстановитьПараметр("МестоХранения", МестоХранения);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;

КонецФункции

// Курсовая разница документа в регистре Убытки (убыток - плюс).
//
// Параметры:
//  Документ - ДокументСсылка - платёжный документ
//
// Возвращаемое значение:
//  Число - сумма по статье «Курсовые разницы»
//
Функция КурсоваяРазницаДокумента(Документ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Убытки.Сумма), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.Убытки КАК Убытки
		|ГДЕ
		|	Убытки.Регистратор = &Документ
		|	И Убытки.СтатьяДДС = ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.КурсовыеРазницы)");
	Запрос.УстановитьПараметр("Документ", Документ);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;

КонецФункции

// Сверяет остаток взаиморасчётов по объекту: одна строка с валютой объекта, сумма в основной валюте
// и в валюте; нулевые ожидания - остатка нет.
//
// Параметры:
//  ИмяРегистра - Строка - ВзаиморасчётыСПокупателями или ВзаиморасчётыСПоставщиками.
//  ОбъектРасчетов - ДокументСсылка - объект расчётов.
//  Валюта - СправочникСсылка.Валюты - ожидаемая валюта.
//  Сумма - Число - ожидаемый остаток в основной валюте.
//  СуммаВВалюте - Число - ожидаемый остаток в валюте.
//  Описание - Строка - что проверяется.
//
Процедура ПроверитьВалютныйОстаток(ИмяРегистра, ОбъектРасчетов, Валюта, Сумма, СуммаВВалюте, Описание)

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Остатки.Валюта КАК Валюта,
		|	Остатки.СуммаОстаток КАК Сумма,
		|	Остатки.СуммаВВалютеОстаток КАК СуммаВВалюте
		|ИЗ
		|	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, ОбъектРасчётов = &ОбъектРасчетов) КАК Остатки";
	Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "ВзаиморасчётыСПокупателями", ИмяРегистра));
	Запрос.УстановитьПараметр("ОбъектРасчетов", ОбъектРасчетов);
	Остатки = Запрос.Выполнить().Выгрузить();
	Если Сумма = 0 И СуммаВВалюте = 0 Тогда
		ПроверитьРавенство(0, Остатки.Количество(), Описание + ": остатка нет");
		Возврат;
	КонецЕсли;
	ПроверитьРавенство(1, Остатки.Количество(), Описание + ": одна строка остатка");
	ПроверитьРавенство(Валюта, Остатки[0].Валюта, Описание + ": валюта");
	ПроверитьРавенство(Сумма, Остатки[0].Сумма, Описание + ": сумма в основной валюте");
	ПроверитьРавенство(СуммаВВалюте, Остатки[0].СуммаВВалюте, Описание + ": сумма в валюте");

КонецПроцедуры

// Цена строки реализации по виду цен - так же, как её подставляет форма при выборе номенклатуры.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  ВидЦены - СправочникСсылка.ВидыЦен - вид цен строки.
//  ВВалюте - Булево - реализация в валюте.
//  Валюта - СправочникСсылка.Валюты - валюта реализации в валюте.
//  Курс - Число - курс реализации в валюте.
//
// Возвращаемое значение:
//  Число - цена строки.
//
Функция ЦенаВидаЦенВДокументе(Контекст, ВидЦены, ВВалюте, Валюта, Курс)

	Док = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПокупателя;
	Док.ЦенаВключаетНДС = Истина;
	Док.ВВалюте = ВВалюте;
	Док.Валюта = Валюта;
	Док.КурсВалюты = Курс;
	Строка = Док.ТЧТовары.Добавить();
	Строка.КодСтроки = 1;
	Строка.ВидЦены = ВидЦены;
	Строка.Номенклатура = Контекст.Товар;
	РаботаСДокументамиКлиентСервер.УстановитьПараметрыНоменклатуры(Строка, Док);
	Возврат Строка.Цена;

КонецФункции

// Функциональные опции перестройки меню (2.0.16.5, docs/plans/menu-restructure.md): обработчик обновления
// включает новые опции, а регламентированный учёт ставит по опции «Бухгалтерия»; повторный запуск ничего
// не меняет; мастер первого запуска пишет только константы из своего списка и только булевы значения и
// выключает дочерние опции без родительских; заказ покупателя и заявка на поиск входят
// в две опции; проверка страны происхождения серии не срабатывает при выключенном «Импорте».
// Константы пишутся внутри транзакции сценария и откатываются вместе с ней.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийФункциональныеОпцииМеню(Контекст)

	Новые = ОбновлениеПрограммыОбработчики.КонстантыНовыхФункциональныхОпций();
	Для Каждого Имя Из Новые Цикл
		Проверить(Метаданные.ФункциональныеОпции.Найти(Имя) <> Неопределено, "константа " + Имя + " - расположение опции");
	КонецЦикла;

	// Существующая база, бухгалтерия выключена: регламентированный учёт остаётся выключенным.
	УстановитьОпции(Новые, Ложь);
	Константы.ИспользоватьРегламентированныйУчет.Установить(Ложь);
	Константы.Бухгалтерия.Установить(Ложь);
	ОбновлениеПрограммыОбработчики.ВключитьНовыеФункциональныеОпции();
	ПроверитьОпции(Новые, Истина, "существующая база");
	ПроверитьРавенство(Ложь, Константы.ИспользоватьРегламентированныйУчет.Получить(),
		"регламентированный учёт при выключенной бухгалтерии");

	// Бухгалтерия включена: регламентированный учёт включается вместе с ней.
	Константы.Бухгалтерия.Установить(Истина);
	ОбновлениеПрограммыОбработчики.ВключитьНовыеФункциональныеОпции();
	ПроверитьРавенство(Истина, Константы.ИспользоватьРегламентированныйУчет.Получить(),
		"регламентированный учёт при включённой бухгалтерии");

	// Повторный запуск: все опции уже включены, обработчик ничего не меняет.
	ОбновлениеПрограммыОбработчики.ВключитьНовыеФункциональныеОпции();
	ПроверитьОпции(Новые, Истина, "повторный запуск");

	// Выбор мастера согласуется: дочерние опции без родительских выключаются.
	Константы.Бухгалтерия.Установить(Ложь);
	Константы.ИспользоватьРегламентированныйУчет.Установить(Истина);
	Константы.ИспользоватьПроизводство.Установить(Ложь);
	Константы.ИспользоватьПереработку.Установить(Истина);
	Константы.ИспользоватьЗаказыПокупателей.Установить(Ложь);
	Константы.ТендерыПоставщиков.Установить(Истина);
	Согласование = Новый Соответствие;
	Согласование.Вставить("ИспользоватьЛиды", Истина);
	НачальноеЗаполнениеВызовСервера.ПрименитьФункциональныеОпции(Согласование);
	ПроверитьРавенство(Ложь, Константы.ИспользоватьРегламентированныйУчет.Получить(), "учёт без бухгалтерии выключен");
	ПроверитьРавенство(Ложь, Константы.ИспользоватьПереработку.Получить(), "переработка без производства выключена");
	ПроверитьРавенство(Ложь, Константы.ТендерыПоставщиков.Получить(), "тендеры без заказов и производства выключены");
	Константы.ИспользоватьЗаказыПокупателей.Установить(Истина);

	// Мастер первого запуска: чужая константа и небулево значение не пишутся.
	ПарольКластера = Константы.ПарольКластера.Получить();
	Выбор = Новый Соответствие;
	Выбор.Вставить("ИспользоватьЛиды", Ложь);
	Выбор.Вставить("ИспользоватьИмпорт", "нет");
	Выбор.Вставить("ПарольКластера", ПометкаТеста());
	НачальноеЗаполнениеВызовСервера.ПрименитьФункциональныеОпции(Выбор);
	ПроверитьРавенство(Ложь, Константы.ИспользоватьЛиды.Получить(), "выбор мастера записан");
	ПроверитьРавенство(Истина, Константы.ИспользоватьИмпорт.Получить(), "небулево значение не записано");
	ПроверитьРавенство(ПарольКластера, Константы.ПарольКластера.Получить(), "константа вне списка мастера не записана");

	// Объекты в двух опциях: виден, если включена любая.
	Заказ = Метаданные.Документы.ЗаказПокупателя;
	Заявка = Метаданные.Документы.ЗаявкаНаПоискТовара;
	Проводки = Метаданные.РегистрыБухгалтерии.Хозрасчетный;
	ЗаказВДвух = ВСоставеОпции("Производство", Заказ) И ВСоставеОпции("ИспользоватьЗаказыПокупателей", Заказ);
	Проверить(ЗаказВДвух, "заказ покупателя - и в производстве, и в заказах покупателей");
	ЗаявкаВДвух = ВСоставеОпции("ИспользоватьЗаявкиНаПоискТовара", Заявка) И ВСоставеОпции("ИспользоватьЛичныйКабинет", Заявка);
	Проверить(ЗаявкаВДвух, "заявка на поиск - и в заявках, и в личном кабинете");
	ПроводкиПеренесены = Не ВСоставеОпции("Бухгалтерия", Проводки)
		И ВСоставеОпции("ИспользоватьРегламентированныйУчет", Проводки);
	Проверить(ПроводкиПеренесены, "регистр проводок перенесён в регламентированный учёт");

	// Скрытое поле не блокирует запись: страна происхождения нужна только при включённом «Импорте».
	Серия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
	Серия.Владелец = Контекст.Товар;
	Серия.Наименование = ПометкаТеста() + ": серия с декларацией";
	ЗаполнитьНомерДекларацииСерии(Серия);
	// Значение функциональной опции платформа запоминает на весь серверный вызов, и
	// ОбновитьПовторноИспользуемыеЗначения его в этом же вызове не сбрасывает (tiny1C bsl-023): проверяется
	// только ветка «импорт выключен», и только если опция ещё не прочитана включённой.
	Константы.ИспользоватьИмпорт.Установить(Ложь);
	ОбновитьПовторноИспользуемыеЗначения();
	Если ПолучитьФункциональнуюОпцию("ИспользоватьИмпорт") Тогда
		ТекстСерии = "проверка серии пропущена: опция «Импорт» уже прочитана в этом вызове включённой";
	Иначе
		Проверить(Серия.ПроверитьЗаполнение(), "серия с декларацией без страны при выключенном импорте");
		ТекстСерии = "страна серии не требуется при выключенном импорте";
	КонецЕсли;
	ПолучитьСообщенияПользователю(Истина);

	Возврат РезультатСценария("обработчик включает 14 опций, регламентированный учёт - по бухгалтерии, "
		+ "повтор без изменений; мастер пишет только свои булевы опции и согласует зависимые; "
		+ "заказ покупателя и заявка на поиск в двух опциях, проводки - в регламентированном учёте; "
		+ ТекстСерии);

КонецФункции

Процедура УстановитьОпции(Имена, Значение)

	Для Каждого Имя Из Имена Цикл
		Константы[Имя].Установить(Значение);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОпции(Имена, Ожидалось, Описание)

	Для Каждого Имя Из Имена Цикл
		ПроверитьРавенство(Ожидалось, Константы[Имя].Получить(), Описание + ": " + Имя);
	КонецЦикла;

КонецПроцедуры

Функция ВСоставеОпции(ИмяОпции, ОбъектМетаданных)

	Возврат Метаданные.ФункциональныеОпции[ИмяОпции].Состав.Содержит(ОбъектМетаданных);

КонецФункции

Процедура ЗаполнитьНомерДекларацииСерии(Серия)

	Номер = Справочники.НомераГТД.СоздатьЭлемент();
	// У справочника нет наименования, только уникальный код.
	Номер.Код = "ТЕСТ-" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0");
	Номер.Записать();
	Серия.НомерГТД = Номер.Ссылка;

КонецПроцедуры

// Налоговые документы товар не двигают (решение владельца 2026-09-28): склад, помеченный «Налоговый», - он же
// управленческий, как в базе 2MZL. Реализация продаёт весь остаток, после чего налоговая накладная, возврат по ней,
// налоговая накладная покупки и возврат поставщику проводятся без отказа по недостаче, не пишут движений
// ТоварыВНаличии и ДополнительныеРасходы и не меняют остаток склада.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийНалоговыеДокументыБезТовара(Контекст)

	Числа = Контекст.Числа;
	Склад = Справочники.МестаХранения.СоздатьЭлемент();
	Склад.Наименование = ПометкаТеста() + ": склад продаж и налогового учёта";
	Склад.Налоговый = Истина;
	Склад.Записать();

	Закупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Закупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.ЦенаВключаетНДС = Истина;
	Закупка.Валюта = Контекст.Валюта;
	Закупка.КурсВалюты = 1;
	Закупка.МестоХранения = Склад.Ссылка;
	ДобавитьСтрокуТоваров(Контекст, Закупка, "ТЧТовары", Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаЗакупки);
	Провести(Закупка);

	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Реализация.Контрагент = Контекст.Контрагент;
	Реализация.Договор = Контекст.ДоговорПокупателя;
	Реализация.ЦенаВключаетНДС = Истина;
	Реализация.МестоХранения = Склад.Ссылка;
	ДобавитьСтрокуТоваров(Контекст, Реализация, "ТЧТовары", Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);
	Провести(Реализация);
	ПроверитьРавенство(0, ОстатокТовара(Склад.Ссылка, Контекст.Товар).Количество, "реализация продала весь остаток");

	Накладная = НовыйДокумент(Контекст, "НалоговаяНакладная");
	Накладная.Заполнить(Реализация.Ссылка);
	НалоговыйДокументСценария(Контекст, Накладная, Склад.Ссылка, Контекст.ДоговорПокупателя);

	ВозвратПокупателя = НовыйДокумент(Контекст, "ВозвратОтПокупателяНалоговый");
	ВозвратПокупателя.Заполнить(Накладная.Ссылка);
	НалоговыйДокументСценария(Контекст, ВозвратПокупателя, Склад.Ссылка, Контекст.ДоговорПокупателя);

	НакладнаяПокупки = НовыйДокумент(Контекст, "НалоговаяНакладнаяПокупка");
	НакладнаяПокупки.Заполнить(Закупка.Ссылка);
	НалоговыйДокументСценария(Контекст, НакладнаяПокупки, Склад.Ссылка, Контекст.ДоговорПоставщика);

	ВозвратПоставщику = НовыйДокумент(Контекст, "ВозвратПоставщикуНалоговый");
	ВозвратПоставщику.Заполнить(НакладнаяПокупки.Ссылка);
	НалоговыйДокументСценария(Контекст, ВозвратПоставщику, Склад.Ссылка, Контекст.ДоговорПоставщика);

	Возврат РезультатСценария("налоговые документы товар не двигают: накладная продажи, возврат по ней, накладная "
		+ "покупки и возврат поставщику проводятся по налоговому складу с нулевым остатком, движений по складу и "
		+ "издержкам нет, остаток склада не изменился");

КонецФункции

// Проводит налоговый документ сценария по складу и проверяет, что товарных движений у него нет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Док      - ДокументОбъект - заполненный по основанию налоговый документ
//  Склад    - СправочникСсылка.МестаХранения - склад с признаком «Налоговый»
//  Договор  - СправочникСсылка.ДоговорыСКонтрагентами - договор сценария
//
Процедура НалоговыйДокументСценария(Контекст, Док, Склад, Договор)

	// Заполнение подставляет ведущую организацию, если у организации нет основного учёта: сценарий от этого не зависит.
	Док.Организация = Контекст.Организация;
	Док.Договор = Договор;
	Док.Дата = СледующаяДата(Контекст);
	Док.МестоХранения = Склад;
	Остаток = ОстатокТовара(Склад, Контекст.Товар).Количество;
	Провести(Док);
	Представление = ПредставлениеДокумента(Док);
	ПроверитьРавенство(0, ДвиженийРегистра("ТоварыВНаличии", Док.Ссылка), Представление + ": движений по складу нет");
	ПроверитьРавенство(0, ДвиженийРегистра("ДополнительныеРасходы", Док.Ссылка), Представление + ": движений издержек нет");
	ПроверитьРавенство(Остаток, ОстатокТовара(Склад, Контекст.Товар).Количество, Представление + ": остаток склада не изменился");

КонецПроцедуры

// Число строк движений документа в регистре накопления.
//
// Параметры:
//  ИмяРегистра - Строка - имя регистра накопления
//  Регистратор - ДокументСсылка - документ
//
// Возвращаемое значение:
//  Число - строк движений
//
Функция ДвиженийРегистра(ИмяРегистра, Регистратор)

	// BSLLS:QueryParseError-off - имя регистра подставляется параметром функции.
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Движений ИЗ РегистрНакопления." + ИмяРегистра
		+ " КАК Движения ГДЕ Движения.Регистратор = &Регистратор");
	// BSLLS:QueryParseError-on
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Возврат ПерваяСтрока(Запрос, "Движений").Движений;

КонецФункции

// Вторая накладная по уже покрытой отгрузке не должна проводиться: иначе она сторнирует
// долг и оплаты второй раз и раздвоит задолженность.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - уже покрытая отгрузка
//
Процедура ПроверитьЗапретВторойНакладной(Контекст, Реализация)

	Вторая = НовыйДокумент(Контекст, "НалоговаяНакладная");
	Вторая.Заполнить(Реализация);
	Вторая.Организация = Контекст.Организация;
	Вторая.Договор = Контекст.ДоговорПокупателя;
	Вторая.Дата = СледующаяДата(Контекст);
	Проведена = Ложь;
	Попытка
		Вторая.Записать(РежимЗаписиДокумента.Проведение);
		Проведена = Вторая.Проведен;
	Исключение
		Проведена = Ложь;
	КонецПопытки;
	Проверить(Не Проведена, "вторая накладная по покрытой отгрузке не должна проводиться");

КонецПроцедуры

// Сальдо контрагента по обычным взаиморасчётам: сумма остатков по всем объектам расчётов.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - клиент
//
// Возвращаемое значение:
//  Число - сальдо
//
Функция СальдоПокупателя(Контрагент)

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЕСТЬNULL(СУММА(Ост.СуммаОстаток), 0) КАК Сальдо
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, Контрагент = &Контрагент) КАК Ост");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сальдо;

КонецФункции

// Остаток взаиморасчётов по одному объекту расчётов.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - клиент
//  Объект     - ДокументСсылка - объект расчётов
//
// Возвращаемое значение:
//  Число - остаток
//
Функция ОстатокПоОбъектуРасчетов(Контрагент, Объект)

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЕСТЬNULL(СУММА(Ост.СуммаОстаток), 0) КАК Остаток
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(
	                      |			,
	                      |			Контрагент = &Контрагент
	                      |				И ОбъектРасчётов = &Объект) КАК Ост");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Объект", Объект);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Остаток;

КонецФункции

// Долг контрагента глазами контроля кредита: та же функция, что зовут запрет отгрузок и дашборд.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - клиент
//
// Возвращаемое значение:
//  Число - долг
//
Функция ПросроченныйДолгКонтрагента(Контрагент)

	ТЗДолг = РегистрыНакопления.ВзаиморасчётыСПокупателями.ПолучитьПросроченнуюЗадолженность(Контрагент, 0, Истина);
	Возврат ?(ТЗДолг.Количество() = 0, 0, ТЗДолг.Итог("Долг"));

КонецФункции

// Проведённая налоговая накладная по реализации: налоговые документы проводятся только по складу с признаком
// «Налоговый», поэтому накладная получает свой налоговый склад с закупкой товара на него.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - основание накладной
//
// Возвращаемое значение:
//  ДокументСсылка.НалоговаяНакладная - проведённая накладная
//
Функция ПроведеннаяНалоговаяНакладная(Контекст, Реализация)

	Склад = Справочники.МестаХранения.СоздатьЭлемент();
	Склад.Наименование = ПометкаТеста() + ": налоговый склад";
	Склад.Налоговый = Истина;
	Склад.Записать();

	Закупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Закупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.ЦенаВключаетНДС = Истина;
	Закупка.Валюта = Контекст.Валюта;
	Закупка.КурсВалюты = 1;
	Закупка.МестоХранения = Склад.Ссылка;
	ДобавитьСтрокуТоваров(Контекст, Закупка, "ТЧТовары", Контекст.Товар,
		Контекст.Числа.КоличествоЗакупки, Контекст.Числа.ЦенаЗакупки);
	Провести(Закупка);

	Накладная = НовыйДокумент(Контекст, "НалоговаяНакладная");
	Накладная.Заполнить(Реализация);
	// Заполнение подставляет ведущую организацию, если у организации нет основного учёта: сценарий от этого не зависит.
	Накладная.Организация = Контекст.Организация;
	Накладная.Договор = Контекст.ДоговорПокупателя;
	Накладная.Дата = СледующаяДата(Контекст);
	Накладная.МестоХранения = Склад.Ссылка;
	Провести(Накладная);
	Возврат Накладная.Ссылка;

КонецФункции

// Значение реквизита, прочитанное запросом: без кэша значений ссылок сеанса.
//
// Параметры:
//  Ссылка   - ЛюбаяСсылка - объект
//  Реквизит - Строка - имя реквизита
//
// Возвращаемое значение:
//  Произвольный - значение реквизита
//
Функция ЗначениеРеквизитаЗапросом(Ссылка, Реквизит)

	ИмяТаблицы = Ссылка.Метаданные().ПолноеИмя();
	// BSLLS:QueryParseError-off - имя таблицы и реквизита подставляются по ссылке.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Т." + Реквизит + " КАК Значение ИЗ " + ИмяТаблицы + " КАК Т ГДЕ Т.Ссылка = &Ссылка";
	// BSLLS:QueryParseError-on
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Значение;

КонецФункции

// Пользователь для сценария, отличный от текущего; пишется в режиме загрузки, без связанного контрагента.
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи - новый пользователь
//
Функция НовыйПользовательСценария()

	Элемент = Справочники.Пользователи.СоздатьЭлемент();
	Элемент.Наименование = ПометкаТеста() + ": другой пользователь";
	Элемент.ОбменДанными.Загрузка = Истина;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

// Автор и ответственный документа, записанные в режиме загрузки: так они выглядят в базе до обновления.
//
// Параметры:
//  Ссылка        - ДокументСсылка - документ
//  Автор         - СправочникСсылка.Пользователи - автор
//  Ответственный - СправочникСсылка.Пользователи - ответственный
//
Процедура УстановитьАвтора(Ссылка, Автор, Ответственный)

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ДокументОбъект.УдалитьАвторОбщий = Автор;
	ДокументОбъект.Ответственный = Ответственный;
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать();

КонецПроцедуры

// Снимок движений документа по всем регистрам: содержимое каждого набора записей во внутреннем представлении.
//
// Параметры:
//  Ссылка - ДокументСсылка - документ
//
// Возвращаемое значение:
//  Строка - снимок; равные снимки - одинаковые записи в том же порядке
//
Функция СнимокДвиженийДокумента(Ссылка)

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	Части = Новый Массив;
	Для Каждого Набор Из ДокументОбъект.Движения Цикл
		Набор.Прочитать();
		Части.Добавить(Набор.Метаданные().ПолноеИмя() + "=" + ЗначениеВСтрокуВнутр(Набор.Выгрузить()));
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// BSLLS:DeprecatedMethodCall-on

#КонецОбласти

#Область СтанкиИОбслуживание

// Учёт станков, сборка 1 (2.0.16.32): фонд времени по режиму работы и производственному календарю, обслуживание
// пишет «Загрузку станков», правило пересечений, отчёт «Простои станков», состав функциональной опции.
// Даты - неделя 2099 года: праздник пишется в общий производственный календарь, а сценарий откатывается.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСтанкиИОбслуживание(Контекст)

	ПроверитьСоставОпцииУчетаСтанков();

	// BSLLS:MagicNumber-off - часы смен и интервалов сценария.
	Понедельник = НачалоНедели(Дата(2099, 1, 7));
	Среда = Понедельник + 2 * 86400;
	Неделя = Понедельник + 7 * 86400;
	ЗаписатьВыходнойКалендаря(Среда);

	Станок = НовыйСтанокСценария("экструдер");
	Станок2 = НовыйСтанокСценария("ткацкий");
	ПроверитьФондВремени(Станок, Станок2, Понедельник, Неделя);

	// План пишет запись «План», перевод того же документа в факт - запись факта; перепроведение не конфликтует с собой.
	Вторник = Понедельник + 86400;
	ТО = НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина,
		Вторник + 10 * 3600, Вторник + 12 * 3600);
	ПроверитьЗаписьЗагрузки(ТО.Ссылка, Истина, 2, "плановое ТО");
	ТО.Плановое = Ложь;
	ТО.Окончание = Вторник + 12.5 * 3600;
	ТО.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьЗаписьЗагрузки(ТО.Ссылка, Ложь, 2.5, "ТО переведено в факт");
	ТО.Записать(РежимЗаписиДокумента.Проведение);

	ПроверитьПравилоПересечений(Станок, Станок2, ТО.Ссылка, Понедельник);
	ПроверитьОтчетПростоев(Станок, Понедельник, Неделя);

	// Последним шагом: после отказа проведения транзакция сценария годится только для отката.
	Отказано = ОтказОбслуживания(Станок, Вторник + 11 * 3600, Вторник + 12 * 3600);
	Проверить(Отказано, "второе фактическое обслуживание станка в занятое время не проводится");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("станки: фонд по режиму со сменой через полночь, календарём и круглосуточной сменой; "
		+ "обслуживание пишет загрузку плана и факта; пересечения по слоям; отчёт простоев с фондом и процентом");

КонецФункции

// Все новые объекты и поля станка - в составе опции «Учёт станков»: без неё их не видно ни в меню, ни в формах.
//
Процедура ПроверитьСоставОпцииУчетаСтанков()

	Опция = "ИспользоватьУчетСтанков";
	Станки = Метаданные.Справочники.ПроизводственноеОборудование;
	Проверить(ВСоставеОпции(Опция, Метаданные.Документы.ОбслуживаниеСтанка), "документ обслуживания в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.РегистрыСведений.ЗагрузкаСтанков), "регистр загрузки в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.Отчеты.ПростоиСтанков), "отчёт простоев в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.Обработки.ЗагрузкаСтанков), "проба планировщика в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.Документы.ТребованиеНакладная), "требование-накладная в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.РегистрыНакопления.МатериалыНаСтанках), "материалы на станках в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.Документы.ВыпускПродукции.Реквизиты.Требование), "требование выпуска в опции");
	Проверить(ВСоставеОпции(Опция, Станки.ТабличныеЧасти.РежимРаботы), "режим работы станка в опции");
	Проверить(ВСоставеОпции(Опция, Станки.ТабличныеЧасти.ВыработкаПоНоменклатуре), "выработка по номенклатуре в опции");
	Для Каждого Реквизит Из Станки.Реквизиты Цикл
		Проверить(ВСоставеОпции(Опция, Реквизит), "реквизит станка " + Реквизит.Имя + " в опции");
	КонецЦикла;
	// С 2.0.16.44 справочник станков и поле «Оборудование» выпуска - под опцией: без учёта станков их не видно.
	Проверить(ВСоставеОпции(Опция, Станки), "справочник станков в опции");
	Проверить(ВСоставеОпции(Опция, Метаданные.Документы.ВыпускПродукции.Реквизиты.Оборудование), "оборудование выпуска в опции");
	// С 2.0.16.44 всё по станкам - в группе «Производство / Станки», а не в «Важном» раздела.
	Группа = Метаданные.Подсистемы.Производство.Подсистемы.Станки;
	Проверить(Группа.Состав.Содержит(Метаданные.Документы.ОбслуживаниеСтанка), "обслуживание - в группе «Станки»");
	Проверить(Группа.Состав.Содержит(Метаданные.Отчеты.ПростоиСтанков), "простои - в группе «Станки»");
	Проверить(Группа.Состав.Содержит(Метаданные.Документы.ТребованиеНакладная), "требования-накладные - в группе «Станки»");
	Проверить(Группа.Состав.Содержит(Станки), "справочник станков - в группе «Станки»");
	// Без открытых требований и закреплённых материалов выключение учёта станков не запрещено.
	ТекстЗапрета = ЗагрузкаСтанков.ТекстЗапретаВыключенияУчета();
	ПроверитьРавенство("", ТекстЗапрета, "запрет выключения учёта станков");

КонецПроцедуры

// Станок: Пн-Пт 08:00-20:00, в понедельник ещё ночная смена 22:00-06:00; календарь учитывается (умолчание).
//
// Параметры:
//  Вид - Строка - вид станка, он же начало наименования
//
// Возвращаемое значение:
//  СправочникСсылка.ПроизводственноеОборудование - записанный станок
//
Функция НовыйСтанокСценария(Вид)

	// BSLLS:MagicNumber-off
	СтанокОбъект = Справочники.ПроизводственноеОборудование.СоздатьЭлемент();
	СтанокОбъект.Наименование = Вид + " (" + ПометкаТеста() + ")";
	СтанокОбъект.ВидСтанка = Вид;
	СтанокОбъект.Выработка = 120;
	СтанокОбъект.ВремяНаСменуЗаказа = 15;
	Для НомерДня = 1 По 5 Цикл
		ДобавитьСменуСтанка(СтанокОбъект, НомерДня, Дата(1, 1, 1, 8, 0, 0), Дата(1, 1, 1, 20, 0, 0));
	КонецЦикла;
	ДобавитьСменуСтанка(СтанокОбъект, 1, Дата(1, 1, 1, 22, 0, 0), Дата(1, 1, 1, 6, 0, 0));
	// BSLLS:MagicNumber-on
	Проверить(СтанокОбъект.ПроверитьЗаполнение(), "режим станка со сменой через полночь проходит проверку");
	СтанокОбъект.Записать();
	Возврат СтанокОбъект.Ссылка;

КонецФункции

// Строка режима работы станка.
//
// Параметры:
//  СтанокОбъект   - СправочникОбъект.ПроизводственноеОборудование - станок
//  НомерДня       - Число - день недели, 1 - понедельник
//  НачалоСмены    - Дата - время начала
//  ОкончаниеСмены - Дата - время окончания
//  Круглосуточно  - Булево - смена на сутки
//
Процедура ДобавитьСменуСтанка(СтанокОбъект, НомерДня, НачалоСмены, ОкончаниеСмены, Круглосуточно = Ложь)

	Смена = СтанокОбъект.РежимРаботы.Добавить();
	Смена.ДеньНедели = Перечисления.ДниНедели.Получить(НомерДня - 1);
	Смена.НачалоСмены = НачалоСмены;
	Смена.ОкончаниеСмены = ОкончаниеСмены;
	Смена.Круглосуточно = Круглосуточно;

КонецПроцедуры

// Нерабочий день производственного календаря.
//
// Параметры:
//  День - Дата - день
//
Процедура ЗаписатьВыходнойКалендаря(День)

	Набор = РегистрыСведений.ПроизводственныйКалендарь.СоздатьНаборЗаписей();
	Набор.Отбор.Дата.Установить(День);
	Набор.Добавить().Дата = День;
	Набор.Записать();

КонецПроцедуры

// Фонд недели: 12 часов в Пн, Вт, Чт, Пт и 8 часов ночной смены понедельника, среда - день календаря.
//
// Параметры:
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок с календарём
//  Станок2     - СправочникСсылка.ПроизводственноеОборудование - станок, который станет без календаря
//  Понедельник - Дата - начало недели
//  Неделя      - Дата - начало следующей недели
//
Процедура ПроверитьФондВремени(Станок, Станок2, Понедельник, Неделя)

	// BSLLS:MagicNumber-off
	Получено = ЗагрузкаСтанков.ФондВремениСтанка(Станок, Понедельник, Неделя);
	ПроверитьРавенство(56, Получено,
		"фонд недели: смена через полночь, среда - день календаря");
	Получено = ЗагрузкаСтанков.ФондВремениСтанка(Станок, Понедельник + 8 * 3600, Понедельник + 12 * 3600);
	ПроверитьРавенство(4, Получено,
		"фонд обрезан периодом");
	Получено = ЗагрузкаСтанков.ФондВремениСтанка(Станок, Понедельник + 86400, Понедельник + 2 * 86400);
	ПроверитьРавенство(18, Получено,
		"вторник: хвост ночной смены понедельника до 06:00 и дневная смена");

	// Без календаря среда рабочая; суббота второго станка - круглосуточно.
	СтанокОбъект = Станок2.ПолучитьОбъект();
	СтанокОбъект.РаботаетБезКалендаря = Истина;
	ДобавитьСменуСтанка(СтанокОбъект, 6, '00010101', '00010101', Истина);
	СтанокОбъект.Записать();
	Получено = ЗагрузкаСтанков.ФондВремениСтанка(Станок2, Понедельник, Неделя);
	ПроверитьРавенство(56 + 12 + 24, Получено,
		"без календаря среда рабочая, суббота круглосуточно");

	// Пустая строка без «Круглосуточно» не проходит проверку: 00:00-00:00 - пустая дата, а не сутки.
	ДобавитьСменуСтанка(СтанокОбъект, 7, '00010101', '00010101');
	Проверить(Не СтанокОбъект.ПроверитьЗаполнение(), "смена 00:00-00:00 без флажка «Круглосуточно» отклоняется");
	ПолучитьСообщенияПользователю(Истина);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Проведённое обслуживание станка.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Вид       - ПеречислениеСсылка.ВидыОбслуживанияСтанков - вид обслуживания
//  Плановое  - Булево - запланированное
//  Начало    - Дата - начало
//  Окончание - Дата - окончание
//
// Возвращаемое значение:
//  ДокументОбъект.ОбслуживаниеСтанка - документ
//
Функция НовоеОбслуживание(Станок, Вид, Плановое, Начало, Окончание)

	Обслуживание = Документы.ОбслуживаниеСтанка.СоздатьДокумент();
	Обслуживание.Дата = ТекущаяДатаСеанса();
	Обслуживание.Станок = Станок;
	Обслуживание.ВидОбслуживания = Вид;
	Обслуживание.Плановое = Плановое;
	Обслуживание.Начало = Начало;
	Обслуживание.Окончание = Окончание;
	Обслуживание.Причина = ПометкаТеста();
	Обслуживание.Комментарий = ПометкаТеста();
	Обслуживание.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Обслуживание;

КонецФункции

// Единственная запись «Загрузки станков» документа.
//
// Параметры:
//  Регистратор - ДокументСсылка.ОбслуживаниеСтанка - документ
//  План        - Булево - ожидаемый слой
//  Часы        - Число - ожидаемые часы
//  Описание    - Строка - что проверяется
//
Процедура ПроверитьЗаписьЗагрузки(Регистратор, План, Часы, Описание)

	Набор = РегистрыСведений.ЗагрузкаСтанков.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	ПроверитьРавенство(1, Набор.Количество(), Описание + ": одна запись загрузки");
	ПроверитьРавенство(План, Набор[0].План, Описание + ": план или факт");
	ПроверитьРавенство(Часы, Набор[0].Часы, Описание + ": часы");
	ПроверитьРавенство(Перечисления.ВидыЗагрузкиСтанков.Обслуживание, Набор[0].ВидЗаписи, Описание + ": вид записи");

КонецПроцедуры

// Конфликт - план с планом любого вида и факт с фактом того же вида. Факт ТО на станке - вторник 10:00-12:30.
//
// Параметры:
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок с фактом ТО
//  Станок2     - СправочникСсылка.ПроизводственноеОборудование - другой станок
//  ТО          - ДокументСсылка.ОбслуживаниеСтанка - факт ТО
//  Понедельник - Дата - начало недели
//
Процедура ПроверитьПравилоПересечений(Станок, Станок2, ТО, Понедельник)

	// BSLLS:MagicNumber-off
	Обслуживание = Перечисления.ВидыЗагрузкиСтанков.Обслуживание;
	Работа = Перечисления.ВидыЗагрузкиСтанков.Работа;
	Пусто = Документы.ОбслуживаниеСтанка.ПустаяСсылка();
	Вторник = Понедельник + 86400;
	ВторникС = Вторник + 11 * 3600;
	ВторникПо = Вторник + 13 * 3600;
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, ВторникС, ВторникПо, Обслуживание, Ложь, Пусто).Количество();
	ПроверитьРавенство(1, Получено,
		"факт обслуживания с фактом обслуживания - конфликт");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, ВторникС, ВторникПо, Обслуживание, Ложь, ТО).Количество();
	ПроверитьРавенство(0, Получено,
		"свои записи регистратора не конфликтуют");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, ВторникС, ВторникПо, Работа, Ложь, Пусто).Количество();
	ПроверитьРавенство(0, Получено,
		"факт работы поверх факта обслуживания - не конфликт");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, ВторникС, ВторникПо, Обслуживание, Истина, Пусто).Количество();
	ПроверитьРавенство(0, Получено,
		"план поверх факта - не конфликт");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок2, ВторникС, ВторникПо, Обслуживание, Ложь, Пусто).Количество();
	ПроверитьРавенство(0, Получено,
		"другой станок - не конфликт");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, Вторник + 12.5 * 3600, ВторникПо, Обслуживание, Ложь, Пусто)
		.Количество();
	ПроверитьРавенство(0, Получено, "интервалы полуоткрытые: начало в момент окончания - не пересечение");

	// План с планом - конфликт при любом виде записи.
	Четверг = Понедельник + 3 * 86400;
	НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.Переналадка, Истина,
		Четверг + 10 * 3600, Четверг + 12 * 3600);
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок, Четверг + 11 * 3600, Четверг + 13 * 3600, Работа,
		Истина, Пусто).Количество();
	ПроверитьРавенство(1, Получено, "план с планом другого вида - конфликт");

	// Авария фактом поверх идущей работы допустима (ревью плана P1-1): запись «Работа» готовит сборка 2, здесь
	// её изображает набор записей документа на станке второго сценария.
	Пятница = Понедельник + 4 * 86400;
	Работа2 = НовоеОбслуживание(Станок2, Перечисления.ВидыОбслуживанияСтанков.Прочее, Ложь,
		Пятница + 8 * 3600, Пятница + 16 * 3600);
	Набор = РегистрыСведений.ЗагрузкаСтанков.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Работа2.Ссылка);
	Набор.Прочитать();
	Набор[0].ВидЗаписи = Работа;
	Набор.Записать();
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок2, Пятница + 9 * 3600, Пятница + 10 * 3600,
		Обслуживание, Ложь, Пусто).Количество();
	ПроверитьРавенство(0, Получено, "авария фактом поверх факта работы - не конфликт");
	Получено = ЗагрузкаСтанков.ПересеченияЗагрузки(Станок2, Пятница + 9 * 3600, Пятница + 10 * 3600,
		Работа, Ложь, Пусто).Количество();
	ПроверитьРавенство(1, Получено, "работа фактом поверх факта работы - конфликт");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Контрольный пример отчёта: факт ТО вторник 10:00-12:30 (в смене), ремонт в субботу 10:00-12:00 (вне смен);
// плановая переналадка четверга в отчёт без «Включать план» не идёт. Фонд недели - 56 часов.
//
// Параметры:
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок
//  Понедельник - Дата - начало недели
//  Неделя      - Дата - начало следующей недели
//
Процедура ПроверитьОтчетПростоев(Станок, Понедельник, Неделя)

	// BSLLS:MagicNumber-off
	Суббота = Понедельник + 5 * 86400;
	НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.Ремонт, Ложь, Суббота + 10 * 3600, Суббота + 12 * 3600);
	Период = Новый СтандартныйПериод(Понедельник, Неделя - 1);
	Данные = Отчеты.ПростоиСтанков.ДанныеОтчета(Период, Ложь);
	ПроверитьРавенство("", Данные.Предупреждение, "календарь 2099 года заполнен");

	Строка = СтрокаОтчетаПростоев(Данные.Простои, Станок);
	ПроверитьРавенство(4.5, Строка.Часы, "часы простоя станка");
	ПроверитьРавенство(2.5, Строка.ЧасыВРабочееВремя, "в рабочее время: ремонт вне смены не входит");
	ПроверитьРавенство(2, Строка.Случаев, "случаев простоя");
	ПроверитьРавенство(56, Строка.Фонд, "фонд времени станка");
	ПроверитьРавенство(4.5, Строка.ПроцентПростоя, "процент простоя в рабочее время");

	ДанныеСПланом = Отчеты.ПростоиСтанков.ДанныеОтчета(Период, Истина);
	ПроверитьРавенство(3, СтрокаОтчетаПростоев(ДанныеСПланом.Простои, Станок).Случаев, "с планом - и переналадка");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Строка группировки «Станок» отчёта «Простои станков»: схема компонуется в таблицу значений с внешним набором.
//
// Параметры:
//  Простои - ТаблицаЗначений - внешний набор, см. Отчеты.ПростоиСтанков.ДанныеОтчета
//  Станок  - СправочникСсылка.ПроизводственноеОборудование - отбор
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - Часы, ЧасыВРабочееВремя, Случаев, Фонд, ПроцентПростоя
//
Функция СтрокаОтчетаПростоев(Простои, Станок)

	Схема = Отчеты.ПростоиСтанков.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов",
		РасположениеИтоговКомпоновкиДанных.Нет);
	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Станок");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Станок;
	Отбор.Использование = Истина;
	Настройки.Структура.Очистить();
	Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Станок");
	ПолеГруппировки.Использование = Истина;
	Для Каждого ИмяПоля Из СтрРазделить("Часы,ЧасыВРабочееВремя,Случаев,Фонд,ПроцентПростоя", ",") Цикл
		Поле = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, Новый Структура("Простои", Простои));
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);

	ПроверитьРавенство(1, Результат.Количество(), "отчёт простоев вернул одну строку по станку");
	Возврат Результат[0];

КонецФункции

// Попытка провести фактический ремонт станка.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало    - Дата - начало
//  Окончание - Дата - окончание
//
// Возвращаемое значение:
//  Булево - Истина, если проведение отклонено
//
Функция ОтказОбслуживания(Станок, Начало, Окончание)

	ПолучитьСообщенияПользователю(Истина);
	Попытка
		НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.Ремонт, Ложь, Начало, Окончание);
	Исключение
		// После исключения в записи транзакция сценария годится только для отката: к базе больше не обращаемся.
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область ЭффективностьСтанков

// Учёт станков, волна 5 (2.0.16.36): плановые даты обслуживания и OEE. Контрольный пример сборки 4 (требование A
// вторник 08:00-16:00, ремонт 10:00-12:00) плюс плановое ТО 16:00-17:00, переведённое в факт 16:30-17:30 (плановые даты
// сохранились), и плановое ТО 14:00-15:00, которого не было - станок работал. Категории 08:00-18:00: фонд 10, работа 6,
// плановые остановки 1 (14-15 вычтено работой); отчёт за день: доступность 6 / (18 - 1), производительность 0,75 / 6,
// качество без веса продукции - полное с предупреждением, с весом 9 кг - 54 / 60. Последний шаг - настоящий отказ: перевод планового ТО в
// факт на время другого фактического обслуживания станка.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийЭффективностьСтанков(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 10 продукции x 2 сырья по 6 кг; станок 120 кг/ч, 15 мин на смену заказа, 8-20.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	Час = 3600;
	Вторник = НачалоНедели(Дата(2099, 3, 18)) + 86400;
	Среда = Вторник + 86400;
	Станки = Новый Массив;
	Станки.Добавить(Данные.Станок);
	Виды = Перечисления.ВидыОбслуживанияСтанков;

	ТребованиеА = НовоеТребованиеСценария(Контекст, Данные, 6);
	ТребованиеА.ПланНачало = Вторник + 8 * Час;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Разместить");
	ТребованиеА.ФактНачало = Вторник + 8 * Час;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Запустить");
	НовоеОбслуживание(Данные.Станок, Виды.Ремонт, Ложь, Вторник + 10 * Час, Вторник + 12 * Час);
	ТребованиеА.Материалы[0].Израсходовано = 10;
	ТребованиеА.КоличествоФакт = 6;
	ТребованиеА.ФактОкончание = Вторник + 16 * Час;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Завершить");

	// Плановое ТО 16-17 переводится в факт 16:30-17:30: плановые даты остаются.
	ТО = НовоеОбслуживание(Данные.Станок, Виды.ПлановоеТО, Истина, Вторник + 16 * Час, Вторник + 17 * Час);
	ПроверитьРавенство(Вторник + 16 * Час, ТО.ПланНачало, "плановое ТО - план начала следует за началом");
	ТО.Плановое = Ложь;
	ТО.Начало = Вторник + 16 * Час + 30 * 60;
	ТО.Окончание = Вторник + 17 * Час + 30 * 60;
	ТО.Записать(РежимЗаписиДокумента.Проведение);
	ТОВБазе = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТО.Ссылка, "ПланНачало, ПланОкончание, Плановое");
	Проверить(Не ТОВБазе.Плановое, "ТО переведено в факт");
	ПроверитьРавенство(Вторник + 16 * Час, ТОВБазе.ПланНачало, "после перевода в факт план начала сохранён");
	ПроверитьРавенство(Вторник + 17 * Час, ТОВБазе.ПланОкончание, "после перевода в факт план окончания сохранён");
	// Плановое ТО 14-15 не состоялось: станок работал - плановой остановки нет.
	НовоеОбслуживание(Данные.Станок, Виды.ПлановоеТО, Истина, Вторник + 14 * Час, Вторник + 15 * Час);

	Категории = ЗагрузкаСтанков.КатегорииВремени(Станки, Вторник + 8 * Час, Вторник + 18 * Час, Среда);
	Фонд = СтрокаКатегорий(Категории, Неопределено);
	ПроверитьРавенство(10, Фонд.Фонд, "фонд 08-18");
	ПроверитьРавенство(1, Фонд.ПлановыеОстановки, "плановые остановки: 16-17, а 14-15 вычтено работой");
	ПроверитьРавенство(6, СтрокаКатегорий(Категории, ТребованиеА.Ссылка).Работа, "работа - регресс сборки 4");
	ПроверитьРавенство(1, СтрокаКатегорий(Категории, ТО.Ссылка).Обслуживание, "фактическое ТО 16:30-17:30");
	ПроверитьРавенство(1, Фонд.НетЗаказа, "нет заказа: 10 - работа 6 - ремонт 2 - ТО 1");

	ПроверитьЭффективностьСтанков(Данные, Вторник, Среда);

	// MTBF и MTTR (2.0.16.37): второй ремонт 18-20 - отказ; ремонт, запланированный заранее и переведённый в факт, - нет.
	НовоеОбслуживание(Данные.Станок, Виды.Ремонт, Ложь, Вторник + 18 * Час, Вторник + 20 * Час);
	ПлановыйРемонт = НовоеОбслуживание(Данные.Станок, Виды.Ремонт, Истина, Вторник + 20 * Час, Вторник + 21 * Час);
	ПлановыйРемонт.Плановое = Ложь;
	ПлановыйРемонт.Записать(РежимЗаписиДокумента.Проведение);
	Простои = Отчеты.ПростоиСтанков.ДанныеОтчета(Новый СтандартныйПериод(Вторник, Вторник + 86399), Ложь, Среда);
	Строка = СтрокаОтчетаСтанков("ПростоиСтанков", "Простои", Простои.Простои, Данные.Станок,
		"Отказов,ЧасыОтказов,ЧасыРаботы,MTBF,MTTR");
	ПроверитьРавенство(2, Строка.Отказов, "отказы - два ремонта, плановый ремонт и ТО не отказы");
	ПроверитьРавенство(4, Строка.ЧасыОтказов, "ремонт после отказов 2 + 2 ч");
	ПроверитьРавенство(6, Строка.ЧасыРаботы, "наработка - работа дня");
	ПроверитьРавенство(3, Строка.MTBF, "MTBF: 6 ч / 2 отказа");
	ПроверитьРавенство(2, Строка.MTTR, "MTTR: 4 ч / 2 отказа");

	// Последний шаг - настоящий отказ: второе плановое ТО переводится в факт на время фактического ТО 16:30-17:30.
	ТО2 = НовоеОбслуживание(Данные.Станок, Виды.ПлановоеТО, Истина, Среда + 8 * Час, Среда + 9 * Час);
	ТО2.Плановое = Ложь;
	ТО2.Начало = Вторник + 17 * Час;
	ТО2.Окончание = Вторник + 18 * Час;
	ПолучитьСообщенияПользователю(Истина);
	Отказ = Ложь;
	Попытка
		ТО2.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		// После исключения в записи транзакция сценария годится только для отката: к базе больше не обращаемся.
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "перевод ТО в факт на время другого фактического обслуживания отклонён проведением");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("плановые даты обслуживания сохраняются при переводе в факт, плановые остановки без "
		+ "часов работы, доступность, производительность, качество без веса продукции и с весом, OEE компоновкой, MTBF и "
		+ "MTTR без запланированного ремонта, отказ перевода ТО в факт на занятое время");

КонецФункции

// «Эффективность станков» за вторник (период отчёта - целые дни): фонд по режиму 18 ч (смена 8-20 и хвост ночной смены
// понедельника), доступность 6 / (18 - 1), производительность 0,75 / 6, качество без веса продукции - полное с
// предупреждением, с весом 9 кг на штуку - 54 / 60.
//
// Параметры:
//  Данные  - Структура - см. ДанныеТребованияСценария
//  Вторник - Дата - день примера
//  Момент  - Дата - момент расчёта
//
Процедура ПроверитьЭффективностьСтанков(Данные, Вторник, Момент)

	// BSLLS:MagicNumber-off
	Период = Новый СтандартныйПериод(Вторник, Вторник + 86399);
	Поля = "Фонд,ПлановыеОстановки,Работа,Доступность,Производительность,Качество,OEE";
	Продукция = Данные.Заказ.ПолучитьОбъект().ТЧТовары.Найти(Данные.КодСтроки, "КодСтроки").Номенклатура;
	Отчет = Отчеты.ЭффективностьСтанков.ДанныеОтчета(Период, Момент);
	Проверить(СтрНайти(Отчет.Предупреждение, Строка(Продукция)) > 0, "продукция без веса - в предупреждении");
	Строка = СтрокаОтчетаСтанков("ЭффективностьСтанков", "Эффективность", Отчет.Эффективность, Данные.Станок, Поля);
	ПроверитьРавенство(18, Строка.Фонд, "фонд дня в отчёте");
	ПроверитьРавенство(1, Строка.ПлановыеОстановки, "плановые остановки в отчёте");
	ПроверитьРавенство(35.3, Строка.Доступность, "доступность 6 / 17");
	ПроверитьРавенство(12.5, Строка.Производительность, "производительность: норма 0,75 ч / 6 ч");
	ПроверитьРавенство(100, Строка.Качество, "качество без веса продукции - полное");
	ПроверитьРавенство(4.4, Строка.OEE, "OEE без веса продукции: 6/17 × 0,125");

	ПродукцияОбъект = Продукция.ПолучитьОбъект();
	ПродукцияОбъект.ВесЕдиница = Данные.Сырье.ВесЕдиница;
	ПродукцияОбъект.ВесЗнаменатель = 9;
	ПродукцияОбъект.Записать();
	Отчет = Отчеты.ЭффективностьСтанков.ДанныеОтчета(Период, Момент);
	Проверить(СтрНайти(Отчет.Предупреждение, Строка(Продукция)) = 0, "продукция с весом - не в предупреждении");
	Строка = СтрокаОтчетаСтанков("ЭффективностьСтанков", "Эффективность", Отчет.Эффективность, Данные.Станок, Поля);
	ПроверитьРавенство(90, Строка.Качество, "качество: 6 × 9 кг / 60 кг");
	ПроверитьРавенство(4, Строка.OEE, "OEE: 6/17 × 0,125 × 0,9");
	// BSLLS:MagicNumber-on

КонецПроцедуры

#КонецОбласти

#Область АвтопланСтанков

// Учёт станков, волна 5 (2.0.16.38): автоплан. Два станка (у первого плановое ТО 8-10), два заказа: B (5 шт., 0,75 ч)
// отгружается раньше A (10 шт., 1,25 ч). Список станков - оба: B и A - на второй станок подряд (черновик мешает сам себе),
// со списком «только первый» - на первый после ТО, подряд; выведенный станок из списка - ошибка строки, а не «любой».
// Устаревший черновик не принимается; принятый создаёт требования с окнами черновика, строки уходят из «Готовых».
// Последний шаг - отказ: время строки черновика заняли плановым ТО до «Принять».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАвтопланСтанков(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 10 продукции x 2 сырья по 6 кг; станки 120 кг/ч, 15 мин на смену заказа, 8-20.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	Станок2 = ВторойСтанокСценария();
	Понедельник = НачалоНедели(Дата(2099, 1, 7));
	Час = 3600;
	Минута = 60;
	Момент = Понедельник + 7 * Час;
	Склад = Контекст.Склад;
	НовоеОбслуживание(Данные.Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Понедельник + 8 * Час,
		Понедельник + 10 * Час);
	ЗаказА = Данные.Заказ.ПолучитьОбъект();
	ЗаказА.ДатаОтгрузки = Понедельник + 3 * 86400;
	Провести(ЗаказА);
	ЗаказБ = ЗаказНаПроизводствоСтадии(Контекст, 5);
	ЗаказБ.ДатаОтгрузки = Понедельник + 86400;
	Провести(ЗаказБ);
	Заказы = Новый Массив;
	Заказы.Добавить(ЗаказА.Ссылка);
	Заказы.Добавить(ЗаказБ.Ссылка);

	// Список - оба станка сценария (в базе могут быть другие свободные станки): B раньше по отгрузке - на второй станок с
	// 8:00, A - туда же после B (окончание 10:00 раньше 11:15 на первом станке после ТО).
	Продукция = Контекст.Продукция.ПолучитьОбъект();
	Продукция.Станки.Очистить();
	Продукция.Станки.Добавить().Станок = Данные.Станок;
	Продукция.Станки.Добавить().Станок = Станок2;
	Продукция.Записать();
	Предложение = ЗагрузкаСтанков.ПредложениеАвтоплана(Момент, Склад, Заказы);
	ПроверитьРавенство(2, Предложение.Количество(), "в черновике две строки");
	ПроверитьСтрокуАвтоплана(Предложение, 0, ЗаказБ.Ссылка, Станок2, Понедельник + 8 * Час, Понедельник + 8 * Час + 45 * Минута);
	ПроверитьСтрокуАвтоплана(Предложение, 1, ЗаказА.Ссылка, Станок2, Понедельник + 8 * Час + 45 * Минута,
		Понедельник + 10 * Час);

	// Список станков продукции - только первый: оба после ТО, подряд.
	Продукция.Станки.Очистить();
	Продукция.Станки.Добавить().Станок = Данные.Станок;
	Продукция.Записать();
	Предложение = ЗагрузкаСтанков.ПредложениеАвтоплана(Момент, Склад, Заказы);
	ПроверитьСтрокуАвтоплана(Предложение, 0, ЗаказБ.Ссылка, Данные.Станок, Понедельник + 10 * Час,
		Понедельник + 10 * Час + 45 * Минута);
	ПроверитьСтрокуАвтоплана(Предложение, 1, ЗаказА.Ссылка, Данные.Станок, Понедельник + 10 * Час + 45 * Минута,
		Понедельник + 12 * Час);

	// Станок списка выведен - строки с ошибкой, а не на любой станок.
	СтанокОбъект = Данные.Станок.ПолучитьОбъект();
	СтанокОбъект.Выведен = Истина;
	СтанокОбъект.Записать();
	СВыведенным = ЗагрузкаСтанков.ПредложениеАвтоплана(Момент, Склад, Заказы);
	Проверить(ЗначениеЗаполнено(СВыведенным[0].ТекстОшибки), "станок списка выведен - ошибка строки");
	Проверить(Не ЗначениеЗаполнено(СВыведенным[0].Станок), "станок списка выведен - на другой станок не ставится");
	СтанокОбъект.Выведен = Ложь;
	СтанокОбъект.Записать();

	// Устаревший черновик не принимается: уже через минуту шаг планирования другой (ревью кода, P1-1).
	Итог = ЗагрузкаСтанков.ПринятьАвтоплан(Предложение, Момент + Минута, Склад);
	ПроверитьРавенство(0, Итог.Размещено, "устаревший черновик ничего не размещает");
	ПроверитьРавенство(1, Итог.Ошибки.Количество(), "устаревший черновик - одна ошибка");

	// Принять: требования с окнами черновика, строки ушли из «Готовых».
	Итог = ЗагрузкаСтанков.ПринятьАвтоплан(Предложение, Момент, Склад);
	ПроверитьРавенство(2, Итог.Размещено, "принято две строки: " + СтрСоединить(Итог.Ошибки, "; "));
	ТребованиеА = ТребованиеЗаказаСценария(ЗаказА.Ссылка);
	Проверить(ТребованиеА <> Неопределено, "по заказу A создано требование");
	Если ТребованиеА <> Неопределено Тогда
		ПроверитьРавенство(Данные.Станок, ТребованиеА.Станок, "станок требования - из черновика");
		ПроверитьРавенство(Понедельник + 10 * Час + 45 * Минута, ТребованиеА.ПланНачало, "начало - из черновика");
		ПроверитьРавенство(Понедельник + 12 * Час, ТребованиеА.ПланОкончание, "окончание совпало с черновиком");
	КонецЕсли;
	ПроверитьРавенство(0, ЗагрузкаСтанков.ПредложениеАвтоплана(Момент, Склад, Заказы).Количество(),
		"размещённые строки ушли из черновика, запланированное не трогается");

	// Последний шаг - отказ: время строки черновика заняли плановым ТО до «Принять».
	ЗаказВ = ЗаказНаПроизводствоСтадии(Контекст, 5);
	ЗаказВ.ДатаОтгрузки = Понедельник + 86400;
	Провести(ЗаказВ);
	ТолькоВ = Новый Массив;
	ТолькоВ.Добавить(ЗаказВ.Ссылка);
	Предложение = ЗагрузкаСтанков.ПредложениеАвтоплана(Момент, Склад, ТолькоВ);
	ПроверитьСтрокуАвтоплана(Предложение, 0, ЗаказВ.Ссылка, Данные.Станок, Понедельник + 12 * Час,
		Понедельник + 12 * Час + 45 * Минута);
	НовоеОбслуживание(Данные.Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Понедельник + 12 * Час,
		Понедельник + 13 * Час);
	Итог = ЗагрузкаСтанков.ПринятьАвтоплан(Предложение, Момент, Склад);
	ПроверитьРавенство(0, Итог.Размещено, "занятое время строки - не размещено");
	ПроверитьРавенство(1, Итог.Ошибки.Количество(), "занятое время строки - текст ошибки");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("черновик по отгрузке на станок с ранним окончанием, строки черновика не пересекаются, "
		+ "список станков продукции, выведенный станок - ошибка строки, устаревший черновик, принятие с окнами черновика, "
		+ "запланированное не трогается, отказ строки на занятом времени");

КонецФункции

// Строка черновика автоплана: заказ, станок и окно.
//
// Параметры:
//  Предложение - ТаблицаЗначений - см. ЗагрузкаСтанков.ПредложениеАвтоплана
//  Индекс      - Число - номер строки
//  Заказ       - ДокументСсылка.ЗаказПокупателя - ожидаемый заказ
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - ожидаемый станок
//  Начало      - Дата - ожидаемое начало
//  Окончание   - Дата - ожидаемое окончание
//
Процедура ПроверитьСтрокуАвтоплана(Предложение, Индекс, Заказ, Станок, Начало, Окончание)

	Если Предложение.Количество() <= Индекс Тогда
		Проверить(Ложь, СтрШаблон("в черновике нет строки %1", Индекс + 1));
		Возврат;
	КонецЕсли;
	Строка = Предложение[Индекс];
	Описание = СтрШаблон("строка %1 черновика: ", Индекс + 1);
	ПроверитьРавенство("", Строка.ТекстОшибки, Описание + "без ошибки");
	ПроверитьРавенство(Заказ, Строка.Заказ, Описание + "заказ по дате отгрузки");
	ПроверитьРавенство(Станок, Строка.Станок, Описание + "станок");
	ПроверитьРавенство(Начало, Строка.Начало, Описание + "начало");
	ПроверитьРавенство(Окончание, Строка.Окончание, Описание + "окончание");

КонецПроцедуры

// Проведённое требование по заказу сценария.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ
//
// Возвращаемое значение:
//  ДокументОбъект.ТребованиеНакладная, Неопределено - требование
//
Функция ТребованиеЗаказаСценария(Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Требования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Требования
	|ГДЕ
	|	Требования.Заказ = &Заказ
	|	И Требования.Проведен";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка.ПолучитьОбъект(), Неопределено);

КонецФункции

#КонецОбласти

#Область РастяжениеСтанков

// Учёт станков, волна 5 (2.0.16.39): растяжение на планировщике меняет только время. Требование 4 шт. (48 кг, 0,65 ч)
// с 8:00 растянуто до 9:39 - конец вверх до шага 9:45, ручная длительность 1,75 ч, количество прежнее; перенос той же
// длины сохраняет её; растяжение через конец смены - только рабочие часы; обслуживание растягивается; очистка ручной
// длительности возвращает расчёт по весу; перенос на другой станок её сбрасывает. Последний шаг - настоящий отказ:
// растяжение на время другого плана станка.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийРастяжениеСтанков(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 10 продукции x 2 сырья по 6 кг; станки 120 кг/ч, 15 мин на смену заказа, 8-20.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	Станок2 = ВторойСтанокСценария();
	Понедельник = НачалоНедели(Дата(2099, 1, 7));
	Вторник = Понедельник + 86400;
	Среда = Вторник + 86400;
	Час = 3600;
	Минута = 60;
	Момент = Понедельник + 7 * Час;
	Данные.Вставить("Склад", Контекст.Склад);

	Требование = РазместитьСтрокуСценария(Данные, 4, Данные.Станок, Неопределено, Момент);
	ПроверитьРавенство(Понедельник + 8 * Час + 39 * Минута, Требование.ПланОкончание, "до растяжения: 0,65 ч");

	// Растяжение вправо на час: 9:39 - вверх до шага 9:45.
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Данные.Станок, Понедельник + 8 * Час,
		Понедельник + 9 * Час + 39 * Минута, Момент);
	ПроверитьРавенство("", ТекстОшибки, "растяжение без ошибки");
	Требование = Требование.Ссылка.ПолучитьОбъект();
	ПроверитьРавенство(1.75, Требование.ДлительностьВручную, "ручная длительность - рабочие часы 8:00-9:45");
	ПроверитьРавенство(1.75, Требование.Длительность, "длительность - ручная");
	ПроверитьРавенство(Понедельник + 9 * Час + 45 * Минута, Требование.ПланОкончание, "окончание после растяжения");
	ПроверитьРавенство(4, Требование.Количество, "растяжение не меняет количество");

	// Перенос той же длины - перенос, а не растяжение: ручная длительность сохраняется.
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Данные.Станок, Понедельник + 10 * Час,
		Понедельник + 11 * Час + 45 * Минута, Момент);
	ПроверитьРавенство("", ТекстОшибки, "перенос растянутой загрузки");
	Требование = Требование.Ссылка.ПолучитьОбъект();
	ПроверитьРавенство(Понедельник + 10 * Час, Требование.ПланНачало, "перенос: новое начало");
	ПроверитьРавенство(1.75, Требование.ДлительностьВручную, "перенос сохраняет ручную длительность");

	// Растяжение через конец смены 20:00: в длительность идут только рабочие часы, окончание - конец смены.
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Данные.Станок, Понедельник + 19 * Час,
		Понедельник + 21 * Час, Момент);
	ПроверитьРавенство("", ТекстОшибки, "растяжение через конец смены");
	Требование = Требование.Ссылка.ПолучитьОбъект();
	ПроверитьРавенство(1, Требование.ДлительностьВручную, "через конец смены - только рабочий час");
	ПроверитьРавенство(Понедельник + 20 * Час, Требование.ПланОкончание, "окончание - конец смены");

	// Плановое обслуживание растягивается: новое окончание.
	ТО = НовоеОбслуживание(Данные.Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Вторник + 8 * Час,
		Вторник + 9 * Час);
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(ТО.Ссылка, Данные.Станок, Вторник + 8 * Час, Вторник + 10 * Час, Момент);
	ПроверитьРавенство("", ТекстОшибки, "растяжение планового ТО");
	ПроверитьРавенство(Вторник + 10 * Час, ТО.Ссылка.Окончание, "окончание ТО после растяжения");

	// Очистка ручной длительности - снова по весу.
	Требование.ДлительностьВручную = 0;
	ТребованияНакладные.ВыполнитьДействие(Требование, "Разместить");
	ПроверитьРавенство(0.65, Требование.Ссылка.Длительность, "без ручной длительности - по весу");

	// Ручная длительность сбрасывается переносом на другой станок.
	ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Данные.Станок, Вторник + 12 * Час, Вторник + 14 * Час, Момент);
	ПроверитьРавенство(2, Требование.Ссылка.ДлительностьВручную, "растянуто до 2 ч");
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Станок2, Среда + 12 * Час, Среда + 14 * Час, Момент);
	ПроверитьРавенство("", ТекстОшибки, "перенос на другой станок");
	ПроверитьРавенство(0, Требование.Ссылка.ДлительностьВручную, "на другом станке ручная длительность сброшена");
	ПроверитьРавенство(0.65, Требование.Ссылка.Длительность, "на другом станке - по весу");

	// Последний шаг - настоящий отказ: растяжение на время другого плана станка (план с планом).
	Второе = РазместитьСтрокуСценария(Данные, 2, Станок2, Среда + 14 * Час, Момент);
	ПроверитьРавенство(Среда + 14 * Час, Второе.ПланНачало, "второе требование - после первого");
	ТекстОшибки = ЗагрузкаСтанков.ИзменитьЗагрузку(Требование.Ссылка, Станок2, Среда + 12 * Час, Среда + 15 * Час, Момент);
	Проверить(ЗначениеЗаполнено(ТекстОшибки), "растяжение на другой план станка отклонено проведением");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("растяжение меняет только время с шагом 15 минут, перенос той же длины сохраняет ручную "
		+ "длительность, через конец смены - рабочие часы, растяжение ТО, очистка - снова по весу, сброс на другом станке, "
		+ "отказ растяжения на другой план");

КонецФункции

#КонецОбласти

#Область ИнвентаризацияСтанков

// Учёт станков, волна 5 (2.0.16.40): пересчёт, списание и оприходование «По станку». Требование A запущено (12 сырья
// на склад станка) и завершено с расходом 8 - свободный остаток 4; требование B (1 шт.) запущено - берёт 2 из
// свободного: на складе станка 4, закреплено 2, свободно 2. Пересчёт «По станку» - склад станка; списание недостачи 1
// на основании - «По станку», со склада станка, закреплённое цело; оприходование материалов 2 - на склад станка. Вид
// без станка и станок без склада - отказ записи; документы «По складу» - как раньше. Последний шаг - настоящий отказ:
// списание больше свободного остатка станка (инвариант закреплённого).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийИнвентаризацияСтанков(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 10 продукции x 2 сырья; закупки сырья 30.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	ПоСтанку = Перечисления.ВидыСкладскихОпераций.Станок;
	ИмяПересчета = "ПересчётТоваров";
	ТребованиеА = НовоеТребованиеСценария(Контекст, Данные, 6);
	ТребованиеА.ФактНачало = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Запустить");
	ЗавершитьТребованиеСценария(Контекст, ТребованиеА, 6, 8);
	ТребованиеБ = НовоеТребованиеСценария(Контекст, Данные, 1);
	ТребованиеБ.ФактНачало = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(ТребованиеБ, "Запустить");
	ПроверитьРавенство(4, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "на складе станка 4");

	// Пересчёт «По станку»: место хранения - склад станка, учётное - всё на станке.
	Пересчет = НовыйДокумент(Контекст, ИмяПересчета);
	Пересчет.МестоХранения = Справочники.МестаХранения.ПустаяСсылка();
	Пересчет.ВидОперации = ПоСтанку;
	Пересчет.Станок = Данные.Станок;
	Строка = Пересчет.ТЧТовары.Добавить();
	Строка.Номенклатура = Данные.Сырье;
	Строка.Упаковка = Контекст.Единица;
	Строка.КоличествоУпаковок = 4;
	Строка.Количество = 4;
	Строка.КоличествоУпаковокФакт = 3;
	Строка.КоличествоФакт = 3;
	Проверить(Пересчет.ПроверитьЗаполнение(), "пересчёт по станку без склада проходит проверку: " + СообщенияПользователю());
	Пересчет.Записать(РежимЗаписиДокумента.Запись);
	ПроверитьРавенство(Данные.СкладСтанка, Пересчет.МестоХранения, "пересчёт по станку - склад станка");

	// Списание недостачи 1 на основании: по станку, со склада станка; закреплённое за B цело.
	Списание = Документы.СписаниеТоваров.СоздатьДокумент();
	Списание.Заполнить(Пересчет.Ссылка);
	Списание.Дата = СледующаяДата(Контекст);
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	ПроверитьРавенство(ПоСтанку, Списание.ВидОперации, "списание на основании - по станку");
	ПроверитьРавенство(Данные.Станок, Списание.Станок, "списание на основании - станок пересчёта");
	ПроверитьРавенство(1, Списание.ТЧТовары.Итог("Количество"), "списывается недостача 1");
	Провести(Списание);
	ПроверитьРавенство(3, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "после списания на станке 3");
	ПроверитьРавенство(2, ЗакрепленоНаСтанке(ТребованиеБ.Ссылка), "закреплённое за B цело");

	// Оприходование материалов 2 - на склад станка.
	Оприходование = НовыйДокумент(Контекст, "ОприходованиеТоваров");
	Оприходование.МестоХранения = Справочники.МестаХранения.ПустаяСсылка();
	Оприходование.ВидОперации = ПоСтанку;
	Оприходование.Станок = Данные.Станок;
	ДобавитьСтрокуТоваров(Контекст, Оприходование, "ТЧТовары", Данные.Сырье, 2, 10);
	Провести(Оприходование);
	ПроверитьРавенство(Данные.СкладСтанка, Оприходование.МестоХранения, "оприходование материалов - склад станка");
	ПроверитьРавенство(5, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "после оприходования на станке 5");

	// Вид «По станку» без станка и станок без склада - отказ записи; «По складу» станок очищается.
	// Отказы проверяются без записи: отказ записи в середине сценария испортил бы транзакцию прогона.
	БезСтанка = НовыйДокумент(Контекст, ИмяПересчета);
	БезСтанка.ВидОперации = ПоСтанку;
	Проверить(Не БезСтанка.ПроверитьЗаполнение(), "по станку без станка - проверка заполнения не пройдена");
	БезСклада = НовыйДокумент(Контекст, "ОприходованиеТоваров");
	БезСклада.ВидОперации = ПоСтанку;
	БезСклада.Станок = НовыйСтанокСценария("без склада");
	ОтказБезСклада = Ложь;
	ЗагрузкаСтанков.ЗаполнитьСкладСтанкаДокумента(БезСклада, ОтказБезСклада);
	Проверить(ОтказБезСклада, "станок без склада станка - отказ записи");
	ПолучитьСообщенияПользователю(Истина);
	ПоСкладу = НовыйДокумент(Контекст, ИмяПересчета);
	ПоСкладу.Станок = Данные.Станок;
	ПоСкладу.Записать(РежимЗаписиДокумента.Запись);
	Проверить(Не ЗначениеЗаполнено(ПоСкладу.Станок), "по складу (пустой вид) - станок очищен");
	ПроверитьРавенство(Контекст.Склад, ПоСкладу.МестоХранения, "по складу - склад прежний");

	// Последний шаг - настоящий отказ: списание по станку больше свободного остатка (5 на станке, 2 закреплено за B).
	Лишнее = НовыйДокумент(Контекст, "СписаниеТоваров");
	Лишнее.ВидОперации = ПоСтанку;
	Лишнее.Станок = Данные.Станок;
	Лишнее.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	ДобавитьСтрокуТоваров(Контекст, Лишнее, "ТЧТовары", Данные.Сырье, 4, 0);
	Проверить(ОтказЗаписиДокумента(Лишнее), "списание закреплённого со станка отклонено");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("пересчёт по станку - склад станка, списание недостачи на основании по станку с целым "
		+ "закреплённым, оприходование материалов на склад станка, отказ без станка и без склада станка, по складу - как "
		+ "раньше, отказ списания закреплённого");

КонецФункции

// Закреплено за требованием в «Материалах на станках» сейчас.
//
// Параметры:
//  Требование - ДокументСсылка.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Число - количество
//
Функция ЗакрепленоНаСтанке(Требование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.МатериалыНаСтанках.Остатки(, Требование = &Требование) КАК Остатки";
	Запрос.УстановитьПараметр("Требование", Требование);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

#КонецОбласти

#Область ТехдолгОктябрь

// Исправления ревью техдолга Codex 2026-10-09 (docs/plans/techdebt-codex-2026-10-09.md, 2.0.16.41): T9 упаковка не 1:1
// у материала заказа на производство - текст запрета; T22 налоговая накладная покупки по валютному поступлению - его
// валюта и курс, начисление в основной валюте; T21 допрасход перевозчику по реализации в валюте - в основной валюте без
// суммы в валюте; T10 закупка под заказ на производство другой организации - текст запрета. Последний шаг - настоящий
// отказ проведения такой закупки.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТехдолгОктябрь(Контекст)

	// BSLLS:MagicNumber-off
	ИмяТоваров = "ТЧТовары";
	Основная = РаботаСВалютами.ОсновнаяВалюта();
	Валюта = ?(Основная = Справочники.Валюты.Евро, Справочники.Валюты.ДолларСША, Справочники.Валюты.Евро);
	Курс = 11;
	ЗаписьКурса = РегистрыСведений.КурсыВалют.СоздатьМенеджерЗаписи();
	ЗаписьКурса.Период = НачалоДня(Контекст.Дата);
	ЗаписьКурса.Валюта = Валюта;
	ЗаписьКурса.Курс = Курс;
	ЗаписьКурса.Записать();

	// T9: упаковка 10:1 у материала - запрет, базовая единица - нет.
	Упаковка = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	Упаковка.Наименование = "уп. 10 (" + ПометкаТеста() + ")";
	Упаковка.Числитель = 10;
	Упаковка.Знаменатель = 1;
	Упаковка.Записать();
	Материалы = Новый ТаблицаЗначений;
	Материалы.Колонки.Добавить("Номенклатура");
	Материалы.Колонки.Добавить("Упаковка");
	СтрокаУпаковки = Материалы.Добавить();
	СтрокаУпаковки.Номенклатура = Контекст.Сырье;
	СтрокаУпаковки.Упаковка = Упаковка.Ссылка;
	СтрокаЕдиницы = Материалы.Добавить();
	СтрокаЕдиницы.Номенклатура = Контекст.Сырье;
	СтрокаЕдиницы.Упаковка = Контекст.Единица;
	Запреты = Документы.ЗаказПокупателя.ТекстЗапретаУпаковокМатериалов(Материалы);
	ПроверитьРавенство(1, Запреты.Количество(), "запрет - только у упаковки не 1:1");
	Проверить(Запреты.Получить(0) <> Неопределено, "запрет - у строки с упаковкой 10:1");

	// T22: налоговая накладная по поступлению 10 × 5 в валюте - его валюта и курс, начисление 50 × 11.
	Поступление = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Поступление.Контрагент = Контекст.Контрагент;
	Поступление.Договор = Контекст.ДоговорПоставщика;
	Поступление.ЦенаВключаетНДС = Истина;
	Поступление.ВВалюте = Истина;
	Поступление.Валюта = Валюта;
	Поступление.КурсВалюты = Курс;
	ДобавитьСтрокуТоваров(Контекст, Поступление, ИмяТоваров, Контекст.Товар, 10, 5);
	Провести(Поступление);
	Накладная = Документы.НалоговаяНакладнаяПокупка.СоздатьДокумент();
	Накладная.Дата = СледующаяДата(Контекст);
	Накладная.Заполнить(Поступление.Ссылка);
	ПроверитьРавенство(Валюта, Накладная.Валюта, "накладная по валютному поступлению - его валюта");
	ПроверитьРавенство(Курс, Накладная.КурсВалюты, "накладная по валютному поступлению - его курс");
	Накладная.Сумма = 50;
	// BSLLS:YoLetterUsage-off - имя регистра
	Начисление = РегистрыНакопления.ВзаиморасчётыСПоcтавщикамиНалоговый.СуммаДокументаВОсновнойВалюте(Накладная);
	// BSLLS:YoLetterUsage-on
	ПроверитьРавенство(550, Начисление, "начисление закупочного налогового регистра - в основной валюте");
	СкладНалоговый = Справочники.МестаХранения.СоздатьЭлемент();
	СкладНалоговый.Наименование = ПометкаТеста() + ": налоговый склад техдолга";
	СкладНалоговый.Налоговый = Истина;
	СкладНалоговый.Записать();
	НалоговыйДокументСценария(Контекст, Накладная, СкладНалоговый.Ссылка, Контекст.ДоговорПоставщика);
	ПроверитьОбработчикНалоговыхДокументовПокупки(Накладная, Начисление);

	// T21: реализация в валюте с допрасходом перевозчику 100 в основной валюте - долг в основной валюте.
	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Реализация.Контрагент = Контекст.Контрагент;
	Реализация.Договор = Контекст.ДоговорПокупателя;
	Реализация.ЦенаВключаетНДС = Истина;
	Реализация.ВВалюте = Истина;
	Реализация.Валюта = Валюта;
	Реализация.КурсВалюты = Курс;
	ДобавитьСтрокуТоваров(Контекст, Реализация, ИмяТоваров, Контекст.Товар, 2, 8);
	ДопРасход = Реализация.ТЧДополнительныеРасходы.Добавить();
	ДопРасход.Контрагент = Контекст.Контрагент;
	ДопРасход.Договор = Контекст.ДоговорПоставщика;
	ДопРасход.Сумма = 100;
	ДопРасход.СуммаСНДС = 100;
	ДопРасход.СтавкаНДС = Контекст.СтавкаНДС;
	ДопРасход.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	Провести(Реализация);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расчеты.Сумма КАК Сумма,
	|	Расчеты.СуммаВВалюте КАК СуммаВВалюте,
	|	Расчеты.Валюта КАК Валюта
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Расчеты
	|ГДЕ
	|	Расчеты.Регистратор = &Реализация";
	Запрос.УстановитьПараметр("Реализация", Реализация.Ссылка);
	Долги = Запрос.Выполнить().Выгрузить();
	ПроверитьРавенство(1, Долги.Количество(), "долг перевозчику по реализации - одна запись");
	Если Долги.Количество() = 1 Тогда
		ПроверитьРавенство(100, Долги[0].Сумма, "долг перевозчику - 100 в основной валюте");
		ПроверитьРавенство(0, Долги[0].СуммаВВалюте, "долг перевозчику - без суммы в валюте реализации");
		Проверить(Долги[0].Валюта <> Валюта, "долг перевозчику - не в валюте реализации");
	КонецЕсли;

	// T10: заказ поставщику под заказ на производство своей организации - можно, другой - запрет.
	Заказ = ЗаказНаПроизводствоСтадии(Контекст, 2);
	Провести(Заказ);
	Закупка = НовыйДокумент(Контекст, "ЗаказПоставщику");
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.Основание = Заказ.Ссылка;
	ДобавитьСтрокуТоваров(Контекст, Закупка, ИмяТоваров, Контекст.Сырье, 1, 1);
	ПроверитьРавенство("", РегистрыНакопления.ПотребностиПроизводства.ТекстЗапретаОрганизацииЗакупки(Закупка),
		"закупка своей организации под заказ на производство");
	Чужая = Справочники.Организации.СоздатьЭлемент();
	Чужая.Наименование = ПометкаТеста() + ": другая организация";
	Чужая.ОбменДанными.Загрузка = Истина;
	Чужая.Записать();
	Закупка.Организация = Чужая.Ссылка;
	Проверить(ЗначениеЗаполнено(РегистрыНакопления.ПотребностиПроизводства.ТекстЗапретаОрганизацииЗакупки(Закупка)),
		"закупка другой организации под заказ на производство - текст запрета");

	// Последний шаг - настоящий отказ: проведение такой закупки.
	Проверить(ОтказЗаписиДокумента(Закупка), "проведение закупки другой организации под заказ отклонено");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("упаковка не 1:1 у материала - запрет, накладная покупки по валютному поступлению - его "
		+ "валюта и курс, начисление в основной валюте, допрасход перевозчику по валютной реализации - в основной "
		+ "валюте, закупка под заказ другой организации - запрет и отказ проведения");

КонецФункции

#КонецОбласти

#Область ТребованиеНакладная

// Учёт станков, сборка 2 (2.0.16.33): вес и длительность загрузки, «Разместить» без перемещения, «Запустить» -
// перемещение на склад станка партиями, перепроведение без дублей, стадия и дефицит заказа без изменений, «Завершить» -
// выпуск со склада станка с себестоимостью партий, недорасход свободен, история закрепления, «Вернуть в работу»,
// один запуск на станок, ручное перемещение недорасхода, закрепление недорасхода следующим требованием. Последний шаг
// - настоящий отказ: списание закреплённого материала со склада станка.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТребованиеНакладная(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - сырьё по 6 кг; заказ 10 продукции x 2 сырья; закупки 15 по 10 и 15 по 12.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	ПроверитьВесИДлительность(Контекст, Данные);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);

	Требование = НовоеТребованиеСценария(Контекст, Данные, 10);
	Требование.ПланНачало = НачалоНедели(Дата(2099, 1, 7)) + 8 * 3600;
	ТребованияНакладные.ВыполнитьДействие(Требование, "Разместить");
	ПроверитьРавенство(1.25, Требование.Длительность, "длительность: 120 кг / 120 кг/ч + 15 мин");
	ПроверитьРавенство(Требование.ПланНачало + 1.25 * 3600, Требование.ПланОкончание, "план окончания по режиму");
	Загрузка = ЗаписьЗагрузкиТребования(Требование.Ссылка);
	Проверить(Загрузка.План И Загрузка.Заказ = Данные.Заказ И Загрузка.Вес = 120, "«Разместить» - запись плана с заказом и весом");
	ПроверитьРавенство(0, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "без флажка размещение не перемещает");
	Стадия = ПроизводственныеЗаказы.РассчитатьСтадию(Данные.Заказ).Стадия;
	Дефицит = РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа(Данные.Заказ).Количество();

	Требование.ФактНачало = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(Требование, "Запустить");
	ПроверитьПеремещениеТребования(Данные, 20, 210, "«Запустить»");
	Требование.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьПеремещениеТребования(Данные, 20, 210, "перепроведение того же требования");
	ПроверитьРавенство(Стадия, ПроизводственныеЗаказы.РассчитатьСтадию(Данные.Заказ).Стадия, "стадия после запуска");
	ПроверитьРавенство(Дефицит, РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа(Данные.Заказ).Количество(),
		"дефицит заказа после запуска");

	ЗавершитьТребованиеСценария(Контекст, Требование, 8, 16);
	ПроверитьЗавершениеТребования(Данные, Требование, 8, 162);
	ПроверитьВозвратВРаботу(Контекст, Данные, Требование);

	// Ручное перемещение недорасхода (1 из 4) проходит: недорасход свободен.
	Возврат1 = НовыйДокумент(Контекст, "ПеремещениеТоваров");
	Возврат1.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание;
	Возврат1.МестоХранения = Данные.СкладСтанка;
	Возврат1.МестоХраненияОприходование = Контекст.Склад;
	ДобавитьСтрокуТоваров(Контекст, Возврат1, "ТЧТовары", Данные.Сырье, 1, 0);
	Провести(Возврат1);
	ПроверитьРавенство(3, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "недорасход после ручного перемещения");

	// Следующее требование закрепляет недорасход станка и ничего не перемещает.
	Требование2 = НовоеТребованиеСценария(Контекст, Данные, 1);
	Требование2.ФактНачало = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(Требование2, "Запустить");
	ПроверитьРавенство(2, Требование2.Материалы[0].СоСкладаСтанка, "недорасход закреплён следующим требованием");
	ПроверитьРавенство(10, ОстатокТовара(Контекст.Склад, Данные.Сырье).Количество, "склад-источник не тронут");

	// Последний шаг - настоящий отказ: списание закреплённого со склада станка.
	Списание = НовыйДокумент(Контекст, "СписаниеТоваров");
	Списание.МестоХранения = Данные.СкладСтанка;
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	ДобавитьСтрокуТоваров(Контекст, Списание, "ТЧТовары", Данные.Сырье, 2, Контекст.Числа.ЦенаЗакупки);
	Проверить(ОтказЗаписиДокумента(Списание), "списание закреплённого материала со склада станка отклонено");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("вес и длительность по режиму, размещение без перемещения, перемещение партиями "
		+ "с суммами, перепроведение без дублей, стадия и дефицит без изменений, выпуск со склада станка 162 за 16, "
		+ "недорасход свободен, история закрепления, «Вернуть в работу», один запуск на станок, ручное перемещение "
		+ "недорасхода, закрепление недорасхода, отказ списания закреплённого");

КонецФункции

// Отмена требования-накладной: после запуска материалы возвращаются на склад-источник, а если соседняя загрузка уже
// списала по FIFO перемещённую партию (ревью плана, P0), остаются на станке свободными. Последний шаг - настоящий отказ:
// распроведение перемещения, принёсшего на станок закреплённый остаток.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТребованиеОтмена(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 20 продукции x 2 сырья; партии P1 15 по 10 и P2 15 по 12.
	Данные = ДанныеТребованияСценария(Контекст, 20);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);

	Отменяемое = НовоеТребованиеСценария(Контекст, Данные, 5);
	Отменяемое.ФактНачало = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(Отменяемое, "Запустить");
	ПроверитьРавенство(10, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "отменяемое перемещено");
	ТребованияНакладные.ВыполнитьДействие(Отменяемое, "Отменить");
	Проверить(Не Отменяемое.МатериалыОставлены, "отмена после запуска возвращает материалы");
	ПроверитьРавенство(0, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "склад станка после отмены");
	ПроверитьРавенство(30, ОстатокТовара(Контекст.Склад, Данные.Сырье).Количество, "склад-источник после отмены");
	ПроверитьРавенство(0, ЗакрепленоЗаТребованием(Отменяемое.Ссылка), "закрепление после отмены");

	// Цепочка P0: A размещено с перемещением P1, B запущено и выпущено первым - FIFO склада станка берёт P1 из A.
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Истина);
	ТребованиеА = НовоеТребованиеСценария(Контекст, Данные, 5);
	ТребованиеА.ПланНачало = НачалоНедели(Дата(2099, 1, 7)) + 8 * 3600;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Разместить");
	ПроверитьРавенство(10, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "A перемещено при размещении");
	ТребованиеБ = НовоеТребованиеСценария(Контекст, Данные, 5);
	ТребованиеБ.ФактНачало = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(ТребованиеБ, "Запустить");
	ЗавершитьТребованиеСценария(Контекст, ТребованиеБ, 5, 10);
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Отменить");
	Проверить(ТребованиеА.МатериалыОставлены, "партию A списал выпуск B: материалы остались на станке");
	ПроверитьРавенство(10, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "материалы A на станке");
	ПроверитьРавенство(0, ЗакрепленоЗаТребованием(ТребованиеА.Ссылка), "закрепление A снято");

	// Обычное перемещение приносит на станок 3, требование C закрепляет 12 из 13 свободных.
	Оприходование = ПеремещениеНаСтанокСценария(Контекст, Данные, 3);
	ТребованиеВ = НовоеТребованиеСценария(Контекст, Данные, 6);
	ТребованиеВ.ПланНачало = НачалоНедели(Дата(2099, 1, 7)) + 10 * 3600;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеВ, "Разместить");
	ПроверитьРавенство(12, ТребованиеВ.Материалы[0].СоСкладаСтанка, "C закрепило свободный остаток станка");
	// Последний шаг - настоящий отказ: распроведение перемещения уводит склад станка ниже закреплённого.
	Отказано = Ложь;
	ПолучитьСообщенияПользователю(Истина);
	Попытка
		ОприходованиеОбъект = Оприходование.ПолучитьОбъект();
		ОприходованиеОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Исключение
		Отказано = Истина;
	КонецПопытки;
	Проверить(Отказано, "распроведение перемещения закреплённого остатка отклонено");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("отмена после запуска возвращает материалы, отмена после FIFO соседней загрузки "
		+ "оставляет их на станке, закрепление свободного остатка, отказ распроведения перемещения");

КонецФункции

// Запреты требований-накладных функциями текста (без отказа в транзакции): двойной выпуск, лимит заказа, переработка,
// правка завершённого, ручная правка выпуска по требованию, тронутая продукция при «Вернуть в работу», выключение
// опции; регресс - выпуск без требования по другому заказу. Последний шаг - настоящий отказ автовыпуска при отгрузке.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТребованиеЗапреты(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);

	// Переработка: продукция второго заказа передана переработчику до требований.
	Заказ2 = ЗаказНаПроизводствоСтадии(Контекст, 2);
	Провести(Заказ2);
	ДокументЗакупки(Контекст, Контекст.Продукция, 1, 50);
	Передача = ПередачаПоЗаказу(Контекст, Заказ2.Ссылка, Контекст.Продукция, 1);
	Провести(Передача);
	Данные2 = Новый Структура;
	Данные2.Вставить("Заказ", Заказ2.Ссылка);
	Данные2.Вставить("Станок", Данные.Станок);
	Данные2.Вставить("КодСтроки", Заказ2.ТЧТовары[1].КодСтроки);
	Проверить(ЗначениеЗаполнено(ТребованияНакладные.ТекстПродукцииВПереработке(НовоеТребованиеСценария(Контекст, Данные2, 1))),
		"требование на продукцию в переработке запрещено");
	// Регресс: ручной выпуск без требования по заказу без требований проводится.
	ВыпускСтадии(Контекст, Заказ2.Ссылка, 1);

	Требование = НовоеТребованиеСценария(Контекст, Данные, 5);
	Требование.ФактНачало = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(Требование, "Запустить");
	Продукция = Требование.Материалы.Выгрузить(, "Номенклатура, Характеристика");
	Продукция.Очистить();
	ЗаполнитьЗначенияСвойств(Продукция.Добавить(), Требование, "Номенклатура, Характеристика");
	Проверить(ЗначениеЗаполнено(ТребованияНакладные.ТекстЗапретаВыпускаБезТребования(Данные.Заказ, Продукция)),
		"выпуск продукции заказа без требования при открытом требовании запрещён");
	// Лимит сверяется без самого требования: остальным открытым требованиям заказа 10 доступно целиком.
	Проверить(ЗначениеЗаполнено(ТребованияНакладные.ТекстПревышенияЗаказа(Требование, 11)), "лимит заказа: 11 > 10");
	ПроверитьРавенство("", ТребованияНакладные.ТекстПревышенияЗаказа(Требование, 10), "лимит заказа: 10 в пределах");
	Второе = НовоеТребованиеСценария(Контекст, Данные, 6);
	Проверить(ЗначениеЗаполнено(ТребованияНакладные.ТекстПревышенияЗаказа(Второе, 6)), "лимит заказа: 5 открыто + 6 > 10");
	Проверить(ЗначениеЗаполнено(ЗагрузкаСтанков.ТекстЗапретаВыключенияУчета()), "выключение учёта при открытом требовании");

	ЗавершитьТребованиеСценария(Контекст, Требование, 5, 10);
	ВБазе = Новый Структура("Статус", Перечисления.СтатусыТребованийНакладных.Завершено);
	Проверить(ЗначениеЗаполнено(ТребованияНакладные.ТекстЗапретаЗаписи(Требование, РежимЗаписиДокумента.Запись, ВБазе)),
		"завершённое требование не меняется");
	Выпуск = ТребованияНакладные.ВыпускПоТребованию(Требование.Ссылка).ПолучитьОбъект();
	ОтказПравки = Ложь;
	ТребованияНакладные.ПроверитьПравкуВыпускаПоТребованию(Выпуск, ОтказПравки);
	Проверить(ОтказПравки, "ручная правка выпуска по требованию запрещена");
	// Продукция выпуска списана: вернуть требование в работу нельзя. По FIFO первой уходит более ранняя партия -
	// выпуск второго заказа, поэтому списывается 2: вторая единица - из выпуска по требованию.
	Списание = НовыйДокумент(Контекст, "СписаниеТоваров");
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	ДобавитьСтрокуТоваров(Контекст, Списание, "ТЧТовары", Требование.Номенклатура, 2, 0);
	Провести(Списание);
	Проверить(ЗначениеЗаполнено(ТребованияНакладные.ТекстЗапретаВозвратаВРаботу(Требование)),
		"«Вернуть в работу» при тронутой продукции запрещено");

	// Последний шаг - настоящий отказ: автовыпуск при отгрузке по заказу с открытым требованием.
	Открытое = НовоеТребованиеСценария(Контекст, Данные, 2);
	Открытое.ФактНачало = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(Открытое, "Запустить");
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	Реализация = РеализацияПродукцииАвтовыпуска(Контекст, Данные.Заказ, 6, ДатаЧерезДвеСекунды(Контекст));
	Проверить(ОтказЗаписиДокумента(Реализация), "автовыпуск при отгрузке с открытым требованием отклонён");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("переработка, регресс ручного выпуска, двойной выпуск, лимит заказа, выключение учёта, "
		+ "правка завершённого и выпуска по требованию, тронутая продукция, отказ автовыпуска при отгрузке");

КонецФункции

// Выработка станка по номенклатуре (2.0.16.46, Drissotex): норма продукции важнее норм материалов, нормы материалов -
// суммой времён, остаток веса - по общей выработке, без норм - как раньше; «Готовы к запуску» и требование считают по
// норме продукции; последним шагом - настоящий отказ записи станка с дублем номенклатуры.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВыработкаПоНоменклатуре(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - станок 120 кг/ч и 15 мин на смену заказа; продукция P1 - 200 кг/ч, сырьё M1 - 60 кг/ч.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Данные.Вставить("Склад", Контекст.Склад);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	Продукция = Данные.Заказ.ТЧТовары.Найти(Данные.КодСтроки, "КодСтроки").Номенклатура;
	Материал2 = НоваяНоменклатура(Контекст, "материал без нормы", Перечисления.ТипыНоменклатуры.Сырье);
	Продукция2 = НоваяНоменклатура(Контекст, "продукция без нормы", Перечисления.ТипыНоменклатуры.Продукция);
	СтанокОбъект = Данные.Станок.ПолучитьОбъект();
	ДобавитьНормуСтанка(СтанокОбъект, Продукция, 200);
	ДобавитьНормуСтанка(СтанокОбъект, Данные.Сырье, 60);
	СтанокОбъект.Записать();

	Веса = Новый Соответствие;
	Веса.Вставить(Данные.Сырье, 60);
	Веса.Вставить(Материал2, 540);
	ПроверитьДлительностьПоНормам(Данные.Станок, Продукция, Веса, 3.25, "Продукция", "норма продукции: 600 / 200 + 15 мин");
	ПроверитьДлительностьПоНормам(Данные.Станок, Продукция2, Веса, 5.75, "Материалы",
		"нормы материалов: 60 / 60 + 540 / 120 + 15 мин");
	Веса = Новый Соответствие;
	Веса.Вставить(Материал2, 600);
	ПроверитьДлительностьПоНормам(Данные.Станок, Продукция2, Веса, 5.25, "Станок", "без норм - общая выработка, как раньше");
	ПроверитьРавенство(5.25, ЗагрузкаСтанков.ДлительностьЗагрузки(Данные.Станок, 600).Часы, "без состава - как раньше");

	// Станок без общей выработки, только с нормой материала: остаток веса без нормы - текст отказа с материалом.
	Станок2 = НовыйСтанокСценария("пресс").ПолучитьОбъект();
	Станок2.Выработка = 0;
	ДобавитьНормуСтанка(Станок2, Данные.Сырье, 60);
	Станок2.Записать();
	Веса = Новый Соответствие;
	Веса.Вставить(Данные.Сырье, 60);
	ПроверитьДлительностьПоНормам(Станок2.Ссылка, Продукция2, Веса, 1.25, "Материалы", "только норма материала: 60 / 60 + 15 мин");
	Веса.Вставить(Материал2, 10);
	Длительность = ЗагрузкаСтанков.ДлительностьЗагрузки(Станок2.Ссылка, 70, ,
		ЗагрузкаСтанков.СоставЗагрузки(Продукция2, Веса));
	Проверить(СтрНайти(Длительность.ТекстОшибки, Строка(Материал2)) > 0, "материал без нормы и без общей выработки - в тексте отказа");
	ПроверитьРавенство(0, Длительность.Часы, "без нормы для части веса часы не считаются");

	// «Готовы к запуску» и размещённое требование - по норме продукции: 12 кг на штуку.
	Понедельник = НачалоНедели(Дата(2099, 1, 7));
	Момент = Понедельник + 7 * 3600;
	Готовая = ГотоваяСтрокаСценария(Данные, Момент);
	Проверить(Готовая <> Неопределено, "строка заказа в «Готовых к запуску»");
	Если Готовая = Неопределено Тогда
		Возврат РезультатСценария("строки заказа нет в «Готовых к запуску»");
	КонецЕсли;
	ПроверитьРавенство(0.85, Готовая.Часы, "«Готовы к запуску»: 120 кг / 200 + 15 мин");
	Проверить(Готовая.Владелец().Колонки.Найти("ВесаПозиций") = Неопределено, "служебная колонка весов не уходит в форму");
	Требование = РазместитьСтрокуСценария(Данные, 4, Данные.Станок, Неопределено, Момент);
	ПроверитьРавенство(0.49, Требование.Длительность, "требование: 48 кг / 200 + 15 мин");

	// Последний шаг - настоящий отказ: программная запись станка с дублем номенклатуры отклонена.
	СтанокОбъект = Данные.Станок.ПолучитьОбъект();
	ДобавитьНормуСтанка(СтанокОбъект, Продукция, 150);
	Отказано = Ложь;
	Попытка
		СтанокОбъект.Записать();
	Исключение
		Отказано = Истина;
	КонецПопытки;
	Проверить(Отказано, "запись станка с дублем номенклатуры в «Выработке по номенклатуре» отклонена");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("выработка по номенклатуре: продукция, материалы суммой времён, остаток по общей, без норм "
		+ "как раньше, отказ без общей выработки, «Готовы к запуску» и требование, дубль номенклатуры");

КонецФункции

// Строка «Выработки по номенклатуре» станка.
//
// Параметры:
//  СтанокОбъект - СправочникОбъект.ПроизводственноеОборудование - станок
//  Номенклатура - СправочникСсылка.Номенклатура - продукция или материал
//  Выработка    - Число - кг/ч
//
Процедура ДобавитьНормуСтанка(СтанокОбъект, Номенклатура, Выработка)

	Норма = СтанокОбъект.ВыработкаПоНоменклатуре.Добавить();
	Норма.Номенклатура = Номенклатура;
	Норма.Выработка = Выработка;

КонецПроцедуры

// Длительность загрузки по нормам станка: часы и чья выработка применена.
//
// Параметры:
//  Станок    - СправочникСсылка.ПроизводственноеОборудование - станок
//  Продукция - СправочникСсылка.Номенклатура - продукция загрузки
//  Веса      - Соответствие - материал -> кг
//  Часы      - Число - ожидаемые часы
//  Источник  - Строка - ожидаемый источник выработки
//  Описание  - Строка - текст проверки
//
Процедура ПроверитьДлительностьПоНормам(Станок, Продукция, Веса, Часы, Источник, Описание)

	Вес = 0;
	Для Каждого КлючИЗначение Из Веса Цикл
		Вес = Вес + КлючИЗначение.Значение;
	КонецЦикла;
	Длительность = ЗагрузкаСтанков.ДлительностьЗагрузки(Станок, Вес, , ЗагрузкаСтанков.СоставЗагрузки(Продукция, Веса));
	ПроверитьРавенство("", Длительность.ТекстОшибки, Описание + ": без отказа");
	ПроверитьРавенство(Часы, Длительность.Часы, Описание);
	ПроверитьРавенство(Источник, Длительность.Источник, Описание + ": источник выработки");

КонецПроцедуры

// Данные сценариев требований: учёт станков включён, станок со складом, сырьё по 6 кг, заказ на производство продукции
// x 2 сырья, закупки сырья двумя партиями 15 по 10 и 15 по 12.
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Продукции - Число - количество продукции в заказе
//
// Возвращаемое значение:
//  Структура - Станок, СкладСтанка, Сырье, Заказ, КодСтроки
//
Функция ДанныеТребованияСценария(Контекст, Продукции)

	// BSLLS:MagicNumber-off
	Константы.ИспользоватьУчетСтанков.Установить(Истина);
	Сырье = Контекст.Сырье.ПолучитьОбъект();
	Сырье.ВесЗнаменатель = 6;
	Сырье.Записать();
	СкладСтанка = Справочники.МестаХранения.СоздатьЭлемент();
	СкладСтанка.Наименование = ПометкаТеста() + ": склад станка";
	СкладСтанка.Записать();
	СтанокОбъект = НовыйСтанокСценария("экструдер").ПолучитьОбъект();
	СтанокОбъект.СкладСтанка = СкладСтанка.Ссылка;
	СтанокОбъект.Записать();
	ДокументЗакупки(Контекст, Контекст.Сырье, 15, 10);
	ДокументЗакупки(Контекст, Контекст.Сырье, 15, 12);
	Заказ = ЗаказНаПроизводствоСтадии(Контекст, Продукции);
	Провести(Заказ);
	// BSLLS:MagicNumber-on
	Данные = Новый Структура;
	Данные.Вставить("Станок", СтанокОбъект.Ссылка);
	Данные.Вставить("СкладСтанка", СкладСтанка.Ссылка);
	Данные.Вставить("Сырье", Контекст.Сырье);
	Данные.Вставить("Заказ", Заказ.Ссылка);
	Данные.Вставить("КодСтроки", Заказ.ТЧТовары[1].КодСтроки);
	Возврат Данные;

КонецФункции

// Новое требование по строке продукции заказа сценария.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Данные     - Структура - Станок, Заказ, КодСтроки
//  Количество - Число - количество продукции
//
// Возвращаемое значение:
//  ДокументОбъект.ТребованиеНакладная - незаписанное требование
//
Функция НовоеТребованиеСценария(Контекст, Данные, Количество)

	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Станок", Данные.Станок);
	ДанныеЗаполнения.Вставить("Заказ", Данные.Заказ);
	ДанныеЗаполнения.Вставить("КодСтрокиПродукции", Данные.КодСтроки);
	ДанныеЗаполнения.Вставить("Количество", Количество);
	Требование = Документы.ТребованиеНакладная.СоздатьДокумент();
	Требование.Заполнить(ДанныеЗаполнения);
	Требование.Дата = СледующаяДата(Контекст);
	Требование.Организация = Контекст.Организация;
	Требование.МестоХранения = Контекст.Склад;
	Требование.Комментарий = Контекст.Пометка;
	Возврат Требование;

КонецФункции

// Вес в кг по единице, весу единицы в граммах и без веса; длительность 600 кг на станке 120 кг/ч с 15 мин на смену
// заказа; окончание по режиму через выходные.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеТребованияСценария
//
Процедура ПроверитьВесИДлительность(Контекст, Данные)

	// BSLLS:MagicNumber-off
	Килограмм = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	Килограмм.Наименование = "кг (" + ПометкаТеста() + ")";
	Килограмм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Вес;
	Килограмм.Числитель = 1;
	Килограмм.Знаменатель = 1;
	Килограмм.Записать();
	Грамм = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	Грамм.Наименование = "г (" + ПометкаТеста() + ")";
	Грамм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Вес;
	Грамм.Числитель = 1;
	Грамм.Знаменатель = 1000;
	Грамм.Записать();
	Нить = НоваяНоменклатура(Контекст, "нить в кг", Перечисления.ТипыНоменклатуры.Сырье).ПолучитьОбъект();
	Нить.Единица = Килограмм.Ссылка;
	Нить.Записать();
	Деталь = НоваяНоменклатура(Контекст, "деталь 500 г", Перечисления.ТипыНоменклатуры.Сырье).ПолучитьОбъект();
	Деталь.ВесЗнаменатель = 500;
	Деталь.ВесЕдиница = Грамм.Ссылка;
	Деталь.Записать();
	БезВеса = НоваяНоменклатура(Контекст, "без веса", Перечисления.ТипыНоменклатуры.Сырье);
	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Номенклатура");
	Строки.Колонки.Добавить("Количество");
	Строки.Добавить().Номенклатура = Нить.Ссылка;
	Строки[0].Количество = 7;
	Строки.Добавить().Номенклатура = Деталь.Ссылка;
	Строки[1].Количество = 4;
	Строки.Добавить().Номенклатура = Данные.Сырье;
	Строки[2].Количество = 10;
	Строки.Добавить().Номенклатура = БезВеса;
	Строки[3].Количество = 1;
	Вес = ЗагрузкаСтанков.ВесНоменклатурыКг(Строки);
	ПроверитьРавенство(69, Вес.Вес, "вес: 7 кг + 4 x 500 г + 10 x 6 кг");
	ПроверитьРавенство(1, Вес.БезВеса.Количество(), "позиция без веса - отдельным списком");
	ПроверитьРавенство(5.25, ЗагрузкаСтанков.ДлительностьЗагрузки(Данные.Станок, 600).Часы, "600 кг / 120 + 15 мин");
	Проверить(ЗначениеЗаполнено(ЗагрузкаСтанков.ДлительностьЗагрузки(Данные.Станок, 0).ТекстОшибки), "без веса - текст отказа");
	Пятница = НачалоНедели(Дата(2099, 1, 7)) + 4 * 86400;
	ПроверитьРавенство(Пятница + 3 * 86400 + 9 * 3600, ЗагрузкаСтанков.ОкончаниеПоРежиму(Данные.Станок, Пятница + 19 * 3600, 2),
		"2 ч с пятницы 19:00 - понедельник 09:00");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Склад станка и склад-источник после перемещения требования.
//
// Параметры:
//  Данные     - Структура - см. ДанныеТребованияСценария
//  Количество - Число - ожидаемый остаток сырья на складе станка
//  Сумма      - Число - ожидаемая сумма партий на складе станка
//  Описание   - Строка - шаг сценария
//
Процедура ПроверитьПеремещениеТребования(Данные, Количество, Сумма, Описание)

	Остаток = ОстатокТовара(Данные.СкладСтанка, Данные.Сырье);
	ПроверитьРавенство(Количество, Остаток.Количество, Описание + ": количество на складе станка");
	ПроверитьРавенство(Сумма, Остаток.Сумма, Описание + ": партии и суммы на складе станка");

КонецПроцедуры

// «Завершить» требование с выпущенным и израсходованным.
//
// Параметры:
//  Контекст      - Структура - см. НовыйКонтекст
//  Требование    - ДокументОбъект.ТребованиеНакладная - запущенное требование
//  Выпущено      - Число - продукции
//  Израсходовано - Число - сырья
//
Процедура ЗавершитьТребованиеСценария(Контекст, Требование, Выпущено, Израсходовано)

	Требование.Материалы[0].Израсходовано = Израсходовано;
	Требование.КоличествоФакт = Выпущено;
	Требование.ФактОкончание = СледующаяДата(Контекст);
	ТребованияНакладные.ВыполнитьДействие(Требование, "Завершить");

КонецПроцедуры

// Выпуск по требованию, себестоимость продукции, свободный недорасход и история закрепления.
//
// Параметры:
//  Данные        - Структура - см. ДанныеТребованияСценария
//  Требование    - ДокументОбъект.ТребованиеНакладная - завершённое требование
//  Выпущено      - Число - продукции
//  Себестоимость - Число - ожидаемая себестоимость продукции выпуска
//
Процедура ПроверитьЗавершениеТребования(Данные, Требование, Выпущено, Себестоимость)

	Приход = ТоварыВНаличииВыпуска(ТребованияНакладные.ВыпускПоТребованию(Требование.Ссылка), Требование.Номенклатура);
	ПроверитьРавенство(Выпущено, Приход.Количество, "выпущено продукции");
	ПроверитьРавенство(Себестоимость, Приход.Сумма, "себестоимость продукции со склада станка");
	ПроверитьЗакреплениеЗавершенного(Данные, Требование, Выпущено);

КонецПроцедуры

// Недорасход свободен, закрепление снято с историей, выпуск в выполнении заказа.
//
// Параметры:
//  Данные     - Структура - см. ДанныеТребованияСценария
//  Требование - ДокументОбъект.ТребованиеНакладная - завершённое требование
//  Выпущено   - Число - продукции
//
Процедура ПроверитьЗакреплениеЗавершенного(Данные, Требование, Выпущено)

	// BSLLS:MagicNumber-off
	ПроверитьРавенство(4, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "недорасход на складе станка");
	ПроверитьРавенство(0, ЗакрепленоЗаТребованием(Требование.Ссылка), "закрепление снято при завершении");
	НаЗапуск = Новый Граница(Требование.МоментВремени(), ВидГраницы.Включая);
	ПроверитьРавенство(20, ЗакрепленоЗаТребованием(Требование.Ссылка, НаЗапуск), "история: на дату запуска закреплено 20");
	// BSLLS:MagicNumber-on
	ПоЗаказу = 0;
	Для Каждого Строка Из ПроизводственныеЗаказы.ВыполнениеПоПродукции(Данные.Заказ) Цикл
		Если Строка.Номенклатура = Требование.Номенклатура Тогда
			ПоЗаказу = ПоЗаказу + Строка.Выпущено;
		КонецЕсли;
	КонецЦикла;
	ПроверитьРавенство(Выпущено, ПоЗаказу, "выпуск по требованию - в выполнении заказа");

КонецПроцедуры

// «Вернуть в работу» без движений продукции: выпуск распроведён и помечен, требование запущено с закреплением, второй
// запуск на станке запрещён; повторное «Завершить» создаёт новый выпуск.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Данные     - Структура - см. ДанныеТребованияСценария
//  Требование - ДокументОбъект.ТребованиеНакладная - завершённое требование
//
Процедура ПроверитьВозвратВРаботу(Контекст, Данные, Требование)

	// BSLLS:MagicNumber-off
	Проверить(ТребованияНакладные.МожноВозвращатьВРаботу(), "прогон идёт под ролью администратора");
	Выпуск = ТребованияНакладные.ВыпускПоТребованию(Требование.Ссылка);
	ТребованияНакладные.ВернутьВРаботу(Требование.Ссылка);
	Требование.Прочитать();
	ПроверитьРавенство(Перечисления.СтатусыТребованийНакладных.Запущено, Требование.Статус, "требование снова запущено");
	Проверить(Выпуск.ПолучитьОбъект().ПометкаУдаления И Не Выпуск.Проведен, "прежний выпуск распроведён и помечен");
	ПроверитьРавенство(20, ЗакрепленоЗаТребованием(Требование.Ссылка), "закрепление восстановлено");
	Второе = НовоеТребованиеСценария(Контекст, Данные, 1);
	Проверить(ЗначениеЗаполнено(ТребованияНакладные.ТекстЗапретаВторогоЗапуска(Второе)), "один запуск на станок");
	ЗавершитьТребованиеСценария(Контекст, Требование, 8, 16);
	ВыпускПовторный = ТребованияНакладные.ВыпускПоТребованию(Требование.Ссылка);
	Проверить(ЗначениеЗаполнено(ВыпускПовторный) И ВыпускПовторный <> Выпуск, "повторное «Завершить» - новый выпуск");
	ПроверитьРавенство(4, ОстатокТовара(Данные.СкладСтанка, Данные.Сырье).Количество, "недорасход после повторного завершения");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Обычное перемещение сырья со склада сценария на склад станка двумя документами.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Данные     - Структура - см. ДанныеТребованияСценария
//  Количество - Число - количество сырья
//
// Возвращаемое значение:
//  ДокументСсылка.ПеремещениеТоваров - проведённое оприходование на склад станка
//
Функция ПеремещениеНаСтанокСценария(Контекст, Данные, Количество)

	Списание = НовыйДокумент(Контекст, "ПеремещениеТоваров");
	Списание.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание;
	Списание.МестоХраненияОприходование = Данные.СкладСтанка;
	ДобавитьСтрокуТоваров(Контекст, Списание, "ТЧТовары", Данные.Сырье, Количество, 0);
	Провести(Списание);
	Оприходование = НовыйДокумент(Контекст, "ПеремещениеТоваров");
	Оприходование.Заполнить(Списание.Ссылка);
	Оприходование.Дата = СледующаяДата(Контекст);
	Провести(Оприходование);
	Возврат Оприходование.Ссылка;

КонецФункции

// Запись «Загрузки станков» требования.
//
// Параметры:
//  Требование - ДокументСсылка.ТребованиеНакладная - требование
//
// Возвращаемое значение:
//  Структура - План, Заказ, Вес; пустые - записи нет
//
Функция ЗаписьЗагрузкиТребования(Требование)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Загрузка.План КАК План,
		|	Загрузка.Заказ КАК Заказ,
		|	Загрузка.Вес КАК Вес
		|ИЗ
		|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
		|ГДЕ
		|	Загрузка.Регистратор = &Требование");
	Запрос.УстановитьПараметр("Требование", Требование);
	Результат = Новый Структура("План, Заказ, Вес", Ложь, Неопределено, 0);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Остаток закрепления за требованием.
//
// Параметры:
//  Требование - ДокументСсылка.ТребованиеНакладная - требование
//  Граница    - Граница, Неопределено - момент остатка; Неопределено - текущий
//
// Возвращаемое значение:
//  Число - закреплено
//
Функция ЗакрепленоЗаТребованием(Требование, Граница = Неопределено)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
		|ИЗ
		|	РегистрНакопления.МатериалыНаСтанках.Остатки(&Граница, Требование = &Требование) КАК Остатки");
	Запрос.УстановитьПараметр("Требование", Требование);
	Запрос.УстановитьПараметр("Граница", Граница);
	Возврат ПерваяСтрока(Запрос, "Количество").Количество;

КонецФункции

// Приход продукции выпуска: количество и себестоимость.
//
// Параметры:
//  Выпуск       - ДокументСсылка.ВыпускПродукции - выпуск
//  Номенклатура - СправочникСсылка.Номенклатура - продукция
//
// Возвращаемое значение:
//  Структура - Количество, Сумма
//
Функция ТоварыВНаличииВыпуска(Выпуск, Номенклатура)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Записи.Количество), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(Записи.Сумма), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии КАК Записи
		|ГДЕ
		|	Записи.Регистратор = &Выпуск
		|	И Записи.Номенклатура = &Номенклатура
		|	И Записи.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
	Запрос.УстановитьПараметр("Выпуск", Выпуск);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат ПерваяСтрока(Запрос, "Количество, Сумма");

КонецФункции

// Запись документа с проведением, которая обязана отказать. После исключения транзакция сценария годится только для
// отката, поэтому вызывается последним шагом.
//
// Параметры:
//  Документ - ДокументОбъект - документ
//
// Возвращаемое значение:
//  Булево - Истина, если запись отклонена
//
Функция ОтказЗаписиДокумента(Документ)

	ПолучитьСообщенияПользователю(Истина);
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область ЗакладкаСтанков

// Учёт станков, сборка 3 (2.0.16.34): функции закладки «Станки» рабочего места производства. «Готовы к запуску» до и
// после размещения, ближайшее окно мимо планового ТО и соседней загрузки с шагом 15 минут, разбиение на второй станок,
// перенос плана и отказ переноса на фактический ремонт без записи, затянувшаяся загрузка занята до «Завершить».
// Последний шаг - настоящий отказ: перенос плана на время другого плана того же станка.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийЗакладкаСтанков(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 10 продукции x 2 сырья по 6 кг; станки 120 кг/ч, 15 мин на смену заказа, 8-20.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	Станок2 = ВторойСтанокСценария();
	Понедельник = НачалоНедели(Дата(2099, 1, 7));
	Час = 3600;
	Момент = Понедельник + 7 * Час;
	Данные.Вставить("Склад", Контекст.Склад);

	Готовая = ГотоваяСтрокаСценария(Данные, Момент);
	Проверить(Готовая <> Неопределено, "строка заказа в «Готовых к запуску»");
	Если Готовая = Неопределено Тогда
		Возврат РезультатСценария("строки заказа нет в «Готовых к запуску»");
	КонецЕсли;
	Стадия = ПроизводственныеЗаказы.РассчитатьСтадию(Данные.Заказ).Стадия;
	ПроверитьРавенство(Стадия <> Перечисления.СтатусыЗаказовПокупателя.ВПроизводстве, Готовая.ИзСклада,
		"материалы строки - со склада, пока заказ не в производстве");
	ПроверитьРавенство(10, Готовая.Остаток, "остаток строки до размещения");
	ПроверитьРавенство(120, Готовая.Вес, "вес материалов остатка, кг");
	ПроверитьРавенство(1.25, Готовая.Часы, "время на станке: 120 кг / 120 кг/ч + 15 мин");
	Проверить(Готовая.Просрочен, "отгрузка раньше окончания ближайшего окна - просрочка");

	// Ближайшее окно мимо планового ТО 8-10: загрузка 4 шт. (48 кг, 0,65 ч) - с 10:00, следующая 3 шт. - после неё
	// с округлением до 15 минут.
	НовоеОбслуживание(Данные.Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Понедельник + 8 * Час,
		Понедельник + 10 * Час);
	Требование1 = РазместитьСтрокуСценария(Данные, 4, Данные.Станок, Неопределено, Момент);
	ПроверитьРавенство(Понедельник + 10 * Час, Требование1.ПланНачало, "первая загрузка - после ТО");
	ПроверитьРавенство(Понедельник + 10 * Час + 39 * 60, Требование1.ПланОкончание, "окончание: 48 кг / 120 кг/ч + 15 мин");
	Требование2 = РазместитьСтрокуСценария(Данные, 3, Данные.Станок, Неопределено, Момент);
	ПроверитьРавенство(Понедельник + 10 * Час + 45 * 60, Требование2.ПланНачало, "вторая загрузка - после первой, шаг 15 мин");
	ПроверитьРавенство(3, ГотоваяСтрокаСценария(Данные, Момент).Остаток, "остаток строки после двух размещений");

	// Разбиение: остаток - на второй станок, с начала смены.
	Требование3 = РазместитьСтрокуСценария(Данные, 3, Станок2, Неопределено, Момент);
	ПроверитьРавенство(Понедельник + 8 * Час, Требование3.ПланНачало, "разбиение на второй станок - с начала смены");
	Проверить(ГотоваяСтрокаСценария(Данные, Момент) = Неопределено, "размещённая целиком строка ушла из «Готовых»");

	// Перенос в свободное время сохраняет длительность; на фактический ремонт - отказ без записи.
	ТекстОшибки = ЗагрузкаСтанков.ПеренестиЗагрузку(Требование2.Ссылка, Данные.Станок, Понедельник + 13 * Час + 5 * 60, Момент);
	ПроверитьРавенство("", ТекстОшибки, "перенос в свободное время");
	Требование2 = Требование2.Ссылка.ПолучитьОбъект();
	ПроверитьРавенство(Понедельник + 13 * Час + 15 * 60, Требование2.ПланНачало, "перенос округлён до шага");
	ПроверитьРавенство(Понедельник + 13 * Час + 48 * 60, Требование2.ПланОкончание, "длительность после переноса: 0,55 ч");
	Ремонт = НовоеОбслуживание(Данные.Станок, Перечисления.ВидыОбслуживанияСтанков.Ремонт, Ложь, Понедельник + 15 * Час,
		Понедельник + 16 * Час);
	ТекстОшибки = ЗагрузкаСтанков.ПеренестиЗагрузку(Ремонт.Ссылка, Данные.Станок, Понедельник + 17 * Час, Момент);
	Проверить(ЗначениеЗаполнено(ТекстОшибки), "фактическое обслуживание не переносится");
	ПроверитьРавенство(Понедельник + 15 * Час, Ремонт.Ссылка.Начало, "фактический ремонт остался на месте");
	ТекстОшибки = ЗагрузкаСтанков.ПеренестиЗагрузку(Требование2.Ссылка, Данные.Станок, Понедельник + 15 * Час, Момент);
	Проверить(ЗначениеЗаполнено(ТекстОшибки), "перенос плана на фактический ремонт отклонён");
	ПроверитьРавенство(Понедельник + 13 * Час + 15 * 60, Требование2.Ссылка.ПланНачало, "отклонённый перенос не записан");

	ПроверитьОсвобождениеСтанка(Данные.Станок, Понедельник);

	// Затянувшаяся загрузка: запущена в 8:00 на 0,55 ч, в 12:00 не завершена - станок занят до 12:15 и дальше.
	МоментПозже = Понедельник + 12 * Час;
	Требование3.ФактНачало = Понедельник + 8 * Час;
	ТребованияНакладные.ВыполнитьДействие(Требование3, "Запустить");
	ПроверитьЗатянувшуюсяЗагрузку(Станок2, Требование3.Ссылка, Понедельник, МоментПозже);
	ТекстОшибки = ЗагрузкаСтанков.ВыполнитьДействиеТребования(Требование3.Ссылка, "Завершить", 0);
	Проверить(ЗначениеЗаполнено(ТекстОшибки), "«Завершить» с нулевым выпуском отклонён без записи");
	ПроверитьРавенство(Перечисления.СтатусыТребованийНакладных.Запущено, Требование3.Ссылка.Статус,
		"требование после отказа «Завершить» - запущено");

	// Последний шаг - настоящий отказ: перенос первой загрузки на время второй (план с планом).
	ТекстОшибки = ЗагрузкаСтанков.ПеренестиЗагрузку(Требование1.Ссылка, Данные.Станок, Понедельник + 13 * Час + 15 * 60, Момент);
	Проверить(ЗначениеЗаполнено(ТекстОшибки), "перенос плана на другой план станка отклонён проведением");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("«Готовы к запуску» до и после размещения, ближайшее окно мимо ТО и соседней загрузки, "
		+ "шаг 15 минут, разбиение на второй станок, перенос с сохранением длительности, отказ переноса на ремонт и "
		+ "фактического ремонта, затянувшаяся загрузка занята, отказ «Завершить» с нулём, отказ переноса план на план");

КонецФункции

// Второй станок сценария закладки со своим складом.
//
// Возвращаемое значение:
//  СправочникСсылка.ПроизводственноеОборудование - станок
//
Функция ВторойСтанокСценария()

	Склад = Справочники.МестаХранения.СоздатьЭлемент();
	Склад.Наименование = ПометкаТеста() + ": склад второго станка";
	Склад.Записать();
	СтанокОбъект = НовыйСтанокСценария("ткацкий").ПолучитьОбъект();
	СтанокОбъект.СкладСтанка = Склад.Ссылка;
	СтанокОбъект.Записать();
	Возврат СтанокОбъект.Ссылка;

КонецФункции

// Строка заказа сценария в «Готовых к запуску» на станке сценария.
//
// Параметры:
//  Данные - Структура - см. ДанныеТребованияСценария, со складом размещения Склад
//  Момент - Дата - момент расчёта
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - строка; Неопределено - строки нет
//
Функция ГотоваяСтрокаСценария(Данные, Момент)

	Отбор = Новый Структура("Заказ, КодСтроки", Данные.Заказ, Данные.КодСтроки);
	Строки = ЗагрузкаСтанков.ГотовыеКЗапуску(Данные.Станок, Момент, Данные.Склад).НайтиСтроки(Отбор);
	Возврат ?(Строки.Количество() = 0, Неопределено, Строки[0]);

КонецФункции

// «Разместить» строки заказа сценария; ошибка размещения - провал проверки.
//
// Параметры:
//  Данные     - Структура - см. ДанныеТребованияСценария
//  Количество - Число - количество продукции
//  Станок     - СправочникСсылка.ПроизводственноеОборудование - станок
//  Начало     - Дата, Неопределено - время; Неопределено - ближайшее окно
//  Момент     - Дата - момент расчёта
//
// Возвращаемое значение:
//  ДокументОбъект.ТребованиеНакладная - размещённое требование
//
Функция РазместитьСтрокуСценария(Данные, Количество, Станок, Начало, Момент)

	Результат = ЗагрузкаСтанков.РазместитьСтроку(Данные.Заказ, Данные.КодСтроки, Количество, Станок, Начало, Момент,
		Данные.Склад);
	ПроверитьРавенство("", Результат.ТекстОшибки, "размещение " + Количество + " шт.");
	Если Результат.Требование = Неопределено Тогда
		ВызватьИсключение "Размещение не выполнено: " + Результат.ТекстОшибки;
	КонецЕсли;
	Возврат Результат.Требование.ПолучитьОбъект();

КонецФункции

// Затянувшаяся загрузка занята до «Завершить»: продлена до момента плюс шаг, окно - не раньше, станок «работает».
//
// Параметры:
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок
//  Требование  - ДокументСсылка.ТребованиеНакладная - запущенное требование
//  Понедельник - Дата - начало недели сценария
//  Момент      - Дата - момент расчёта
//
Процедура ПроверитьЗатянувшуюсяЗагрузку(Станок, Требование, Понедельник, Момент)

	// BSLLS:MagicNumber-off
	Станки = Новый Массив;
	Станки.Добавить(Станок);
	Шаг = ЗагрузкаСтанков.ШагПланированияМинут() * 60;
	Час = 3600;
	// Период начинается после расчётного окончания: запись всё равно в выборке.
	Занятость = ЗагрузкаСтанков.ЗанятостьСтанков(Станки, Понедельник + 11 * Час, Понедельник + 24 * Час, Момент);
	Строки = Занятость.НайтиСтроки(Новый Структура("Регистратор", Требование));
	Проверить(Строки.Количество() = 1, "затянувшаяся загрузка в занятости периода после расчётного окончания");
	Если Строки.Количество() = 1 Тогда
		Проверить(Строки[0].Затянулась, "загрузка помечена затянувшейся");
		ПроверитьРавенство(Момент + Шаг, Строки[0].Окончание, "затянувшаяся загрузка продлена до момента и шага");
	КонецЕсли;
	Окно = ЗагрузкаСтанков.БлижайшееОкно(Станок, 1, Понедельник + 8 * Час, , Момент);
	ПроверитьРавенство(Момент + Шаг, Окно.Начало, "окно - после затянувшейся загрузки");
	Состояние = ЗагрузкаСтанков.СостояниеСтанков(Станки, Понедельник, Понедельник + 7 * 24 * Час, Момент);
	ПроверитьРавенство(Требование, Состояние[0].Требование, "станок работает по затянувшейся загрузке");
	Проверить(Состояние[0].Загрузка > 0, "загрузка периода учитывает затянувшуюся работу");

	// Конец затянувшейся работы неизвестен до «Завершить»: ни «Освободится», ни «Свободен с» (продление на шаг -
	// граница планировщика, а не прогноз). Фактический ремонт поверх неё меняет состояние, но не даты.
	ПроверитьЗатянувшуюсяВОсвобождении(Станок, Момент, Понедельник + 8 * Час + 33 * 60, "затянувшаяся работа");
	НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.Ремонт, Ложь, Момент - Час / 2, Момент + Час);
	ПроверитьЗатянувшуюсяВОсвобождении(Станок, Момент, Понедельник + 8 * Час + 33 * 60, "ремонт поверх затянувшейся");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «Занятость станков» на станке сценария закладки в 8:30 понедельника: ТО по плану 8-10, загрузки 10:00-10:39 и
// 13:15-13:48, фактический ремонт 15-16. Освободится по окончании ТО, первое окно - после первой загрузки с шагом
// (разрыв внутри очереди), конец очереди - ремонт, а плановое ТО за годовым горизонтом сдвигает его дальше. Отчёт
// собирается вариантом по умолчанию.
//
// Параметры:
//  Станок      - СправочникСсылка.ПроизводственноеОборудование - станок сценария
//  Понедельник - Дата - начало недели сценария
//
Процедура ПроверитьОсвобождениеСтанка(Станок, Понедельник)

	// BSLLS:MagicNumber-off
	Час = 3600;
	Момент = Понедельник + 8 * Час + 30 * 60;
	Станки = Новый Массив;
	Станки.Добавить(Станок);
	Строка = ЗагрузкаСтанков.ОсвобождениеСтанков(Станки, Момент)[0];
	Проверить(Строка.Занят, "в 8:30 станок занят плановым ТО");
	Проверить(ТипЗнч(Строка.Документ) = Тип("ДокументСсылка.ОбслуживаниеСтанка"), "документ состояния - обслуживание");
	ПроверитьРавенство(Понедельник + 10 * Час, Строка.Освободится, "освободится по окончании ТО");
	ПроверитьРавенство(Понедельник + 10 * Час + 45 * 60, Строка.СвободенС,
		"первое окно - после загрузки 10:00-10:39 с шагом 15 минут");
	ПроверитьРавенство(Понедельник + 16 * Час, Строка.ЗагруженДо, "конец очереди - фактический ремонт 15-16");
	ПроверитьРавенство(1.2, Строка.ЧасовРаботыВпереди, "работы впереди: 0,65 + 0,55 ч");
	Проверить(Не Строка.Затянулась, "затянувшейся работы нет");

	Состояние = ЗагрузкаСтанков.СостояниеСтанков(Станки, Понедельник, Понедельник + 7 * 24 * Час, Момент);
	ПроверитьРавенство(Строка.СвободенС, Состояние[0].СвободенС, "закладка «Станки» - те же даты, что отчёт");
	ПроверитьРавенство(Строка.ЗагруженДо, Состояние[0].ЗагруженДо, "закладка «Станки» - тот же конец очереди");

	// Годовой горизонт окна не обрезает конец очереди: ТО через 413 дней.
	Дальнее = Понедельник + 59 * 7 * 24 * Час + 8 * Час;
	НовоеОбслуживание(Станок, Перечисления.ВидыОбслуживанияСтанков.ПлановоеТО, Истина, Дальнее, Дальнее + Час);
	Строка = ЗагрузкаСтанков.ОсвобождениеСтанков(Станки, Момент)[0];
	ПроверитьРавенство(Дальнее + Час, Строка.ЗагруженДо, "конец очереди за годовым горизонтом");
	ПроверитьРавенство(Понедельник + 10 * Час + 45 * 60, Строка.СвободенС, "дальнее ТО не меняет первое окно");

	Данные = Отчеты.ЗанятостьСтанков.ДанныеОтчета(Момент);
	Проверить(Данные.Занятость.Найти(Станок, "Станок") <> Неопределено, "станок в данных отчёта «Занятость станков»");
	Схема = Отчеты.ЗанятостьСтанков.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Результат = Новый ТабличныйДокумент;
	ЗагрузкаСтанков.ВывестиОтчет(Результат, Схема, Схема.НастройкиПоУмолчанию,
		Новый Структура("Занятость", Данные.Занятость));
	Проверить(Результат.ВысотаТаблицы > 0, "отчёт «Занятость станков» собирается вариантом по умолчанию");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Затянувшаяся работа в «Занятости станков»: станок занят, «Освободится» и «Свободен с» пусты, расчётное окончание -
// до продления.
//
// Параметры:
//  Станок             - СправочникСсылка.ПроизводственноеОборудование - станок
//  Момент             - Дата - момент расчёта
//  РасчетноеОкончание - Дата - ожидаемое расчётное окончание
//  Описание           - Строка - что проверяется
//
Процедура ПроверитьЗатянувшуюсяВОсвобождении(Станок, Момент, РасчетноеОкончание, Описание)

	Станки = Новый Массив;
	Станки.Добавить(Станок);
	Строка = ЗагрузкаСтанков.ОсвобождениеСтанков(Станки, Момент)[0];
	Проверить(Строка.Занят, Описание + ": станок занят");
	Проверить(Строка.Затянулась, Описание + ": помечена затянувшейся");
	ПроверитьРавенство(Дата(1, 1, 1), Строка.Освободится, Описание + ": «Освободится» пусто");
	ПроверитьРавенство(Дата(1, 1, 1), Строка.СвободенС, Описание + ": «Свободен с» пусто");
	ПроверитьРавенство(РасчетноеОкончание, Строка.РасчетноеОкончание, Описание + ": расчётное окончание");

КонецПроцедуры

#КонецОбласти

#Область ОтчетыСтанков

// Учёт станков, сборка 4 (2.0.16.35): отчёты на контрольном примере. Требование A вторник 08:00-16:00 в смене, ремонт
// 10:00-12:00 внутри загрузки: работа 6 ч, обслуживание 2 ч, нет заказа 0, загрузка 75 %. Заказ в валюте по курсу 2:
// выручка - выпущено × цена строки без НДС × 2, материалы - себестоимость выпуска, часы × стоимость часа, затраты ремонта
// в марже станка. Выработка - кг израсходованного и норма. Требование B запущено в среду: работа до момента расчёта,
// «Материалы на станках» на вторник - свободный недорасход A, на среду - закреплённое за B. Возврат A в работу после
// запуска B - запрет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОтчетыСтанков(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - заказ 10 продукции x 2 сырья по 6 кг; станок 120 кг/ч, 15 мин на смену заказа, 8-20.
	Данные = ДанныеТребованияСценария(Контекст, 10);
	Константы.СписыватьМатериалыНаСтанокПриРазмещении.Установить(Ложь);
	Курс = 2;
	ПеревестиЗаказВВалюту(Данные.Заказ, Курс);
	СтанокОбъект = Данные.Станок.ПолучитьОбъект();
	СтанокОбъект.СтоимостьЧаса = 10;
	СтанокОбъект.Записать();
	Час = 3600;
	Вторник = НачалоНедели(Дата(2099, 3, 18)) + 86400;
	Среда = Вторник + 86400;
	Станки = Новый Массив;
	Станки.Добавить(Данные.Станок);

	// A: размещено на 08:00 (план 72 кг / 120 кг/ч + 15 мин = 0,85 ч), запущено в 08:00, завершено в 16:00: 6 шт.,
	// из 12 сырья израсходовано 10.
	ТребованиеА = НовоеТребованиеСценария(Контекст, Данные, 6);
	ТребованиеА.ПланНачало = Вторник + 8 * Час;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Разместить");
	ТребованиеА.ФактНачало = Вторник + 8 * Час;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Запустить");
	Ремонт = НовоеОбслуживание(Данные.Станок, Перечисления.ВидыОбслуживанияСтанков.Ремонт, Ложь, Вторник + 10 * Час,
		Вторник + 12 * Час);
	Ремонт.Затраты = 50;
	Ремонт.Записать(РежимЗаписиДокумента.Проведение);
	ТребованиеА.Материалы[0].Израсходовано = 10;
	ТребованиеА.КоличествоФакт = 6;
	ТребованиеА.ФактОкончание = Вторник + 16 * Час;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеА, "Завершить");

	ПроверитьКатегорииСтанков(Станки, Вторник, ТребованиеА.Ссылка, Ремонт.Ссылка, Среда);
	ПроверитьДеньгиПоСтанкам(Данные, ТребованиеА.Ссылка, Вторник, Курс, Среда);
	ПроверитьВыработкуСтанков(Данные.Станок, Вторник, Среда);

	// B: 4 шт. запущено в среду 08:00 - берёт 2 сырья недорасхода A и перемещает 6; расчётное окончание 08:45.
	ТребованиеБ = НовоеТребованиеСценария(Контекст, Данные, 4);
	ТребованиеБ.ФактНачало = Среда + 8 * Час;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеБ, "Запустить");
	// Затянувшаяся загрузка выбирается, хотя расчётное окончание до периода: работа - до момента расчёта.
	Категории = ЗагрузкаСтанков.КатегорииВремени(Станки, Среда + 12 * Час, Среда + 20 * Час, Среда + 14 * Час);
	ПроверитьРавенство(2, СтрокаКатегорий(Категории, ТребованиеБ.Ссылка).Работа, "запущенное - работа до момента расчёта");
	ПроверитьРавенство(2, СтрокаКатегорий(Категории, Неопределено).Фонд, "фонд - только прошедшее время периода");
	ПроверитьРавенство(0, СтрокаКатегорий(Категории, Неопределено).НетЗаказа, "будущее время - не простой");

	ПроверитьМатериалыНаСтанках(Данные, ТребованиеБ.Ссылка, Вторник, Среда);

	// Возврат A после B: пока B запущено, запрещает второй запуск; после завершения B - новая проверка работы после A.
	ТекстЗапрета = ТребованияНакладные.ТекстЗапретаВозвратаВРаботу(ТребованиеА.Ссылка.ПолучитьОбъект());
	Проверить(ЗначениеЗаполнено(ТекстЗапрета), "возврат A в работу при запущенном B - запрет");
	ТребованиеБ.КоличествоФакт = 4;
	ТребованиеБ.ФактОкончание = Среда + 16 * Час;
	ТребованияНакладные.ВыполнитьДействие(ТребованиеБ, "Завершить");
	ТекстЗапрета = ТребованияНакладные.ТекстЗапретаВозвратаВРаботу(ТребованиеА.Ссылка.ПолучитьОбъект());
	Проверить(СтрНайти(ТекстЗапрета, Строка(ТребованиеБ.Ссылка)) > 0,
		"возврат A в работу после завершённого B - запрет по работе B: " + ТекстЗапрета);
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("категории времени 6/2/0 из 8 ч и 75 %, план требования, деньги по курсу заказа без НДС с "
		+ "себестоимостью выпуска, стоимостью часов и затратами ремонта, выработка и норма, запущенное - до момента, "
		+ "будущее время не простой, материалы на станках: свободный недорасход и закреплённое, запрет возврата в работу "
		+ "при запущенном и после завершённого следующего требования");

КонецФункции

// Заказ сценария - в валюте с курсом: строки и суммы в валюте не меняются.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ
//  Курс  - Число - курс заказа
//
Процедура ПеревестиЗаказВВалюту(Заказ, Курс)

	Основная = РаботаСВалютами.ОсновнаяВалюта();
	ЗаказОбъект = Заказ.ПолучитьОбъект();
	ЗаказОбъект.ВВалюте = Истина;
	ЗаказОбъект.Валюта = ?(Основная = Справочники.Валюты.Евро, Справочники.Валюты.ДолларСША, Справочники.Валюты.Евро);
	ЗаказОбъект.КурсВалюты = Курс;
	Провести(ЗаказОбъект);

КонецПроцедуры

// Категории времени контрольного примера и процент загрузки компоновкой отчёта.
//
// Параметры:
//  Станки     - Массив из СправочникСсылка.ПроизводственноеОборудование - станок сценария
//  Вторник    - Дата - день примера
//  Требование - ДокументСсылка.ТребованиеНакладная - требование A
//  Ремонт     - ДокументСсылка.ОбслуживаниеСтанка - ремонт внутри загрузки
//  Момент     - Дата - момент расчёта после примера
//
Процедура ПроверитьКатегорииСтанков(Станки, Вторник, Требование, Ремонт, Момент)

	// BSLLS:MagicNumber-off
	Час = 3600;
	Категории = ЗагрузкаСтанков.КатегорииВремени(Станки, Вторник + 8 * Час, Вторник + 16 * Час, Момент);
	Фонд = СтрокаКатегорий(Категории, Неопределено);
	ПроверитьРавенство(8, Фонд.Фонд, "фонд 8 ч");
	ПроверитьРавенство(0, Фонд.НетЗаказа, "нет заказа - остаток фонда");
	СтрокаТребования = СтрокаКатегорий(Категории, Требование);
	ПроверитьРавенство(6, СтрокаТребования.Работа, "работа - факт за вычетом ремонта");
	ПроверитьРавенство(0.85, СтрокаТребования.План, "план требования - по плановым датам документа");
	ПроверитьРавенство(2, СтрокаКатегорий(Категории, Ремонт).Обслуживание, "ремонт внутри загрузки");
	Строка = СтрокаОтчетаСтанков("ЗагрузкаСтанков", "Загрузка", Категории, Станки[0], "Фонд,Работа,Обслуживание,НетЗаказа,ПроцентЗагрузки");
	ПроверитьРавенство(75, Строка.ПроцентЗагрузки, "загрузка 6 из 8 ч");
	ПроверитьРавенство(2, Строка.Обслуживание, "обслуживание в итоге станка");

	// Отчёт за день по режиму: смена 8-20 и хвост ночной смены понедельника 0-6 - фонд 18 ч, нет заказа 10 ч.
	Данные = Отчеты.ЗагрузкаСтанков.ДанныеОтчета(Новый СтандартныйПериод(Вторник, Вторник + 86399), Момент);
	Строка = СтрокаОтчетаСтанков("ЗагрузкаСтанков", "Загрузка", Данные.Загрузка, Станки[0], "Фонд,Работа,НетЗаказа");
	ПроверитьРавенство(18, Строка.Фонд, "фонд дня по режиму");
	ПроверитьРавенство(10, Строка.НетЗаказа, "нет заказа за день");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «Деньги по станкам» за день примера: выручка по курсу заказа без НДС, себестоимость выпуска, часы и затраты ремонта.
//
// Параметры:
//  Данные     - Структура - см. ДанныеТребованияСценария
//  Требование - ДокументСсылка.ТребованиеНакладная - завершённое требование A
//  Вторник    - Дата - день примера
//  Курс       - Число - курс заказа
//  Момент     - Дата - момент расчёта
//
Процедура ПроверитьДеньгиПоСтанкам(Данные, Требование, Вторник, Курс, Момент)

	// BSLLS:MagicNumber-off
	СтрокаЗаказа = Данные.Заказ.ПолучитьОбъект().ТЧТовары.Найти(Данные.КодСтроки, "КодСтроки");
	Выручка = Окр(6 * (СтрокаЗаказа.СуммаСНДС - СтрокаЗаказа.СуммаНДС) / СтрокаЗаказа.Количество * Курс, 2);
	Материалы = СебестоимостьВыпускаТребования(Требование);
	Проверить(Материалы > 0, "себестоимость выпуска по требованию посчитана");
	Деньги = Отчеты.ДеньгиПоСтанкам.ДанныеОтчета(Новый СтандартныйПериод(Вторник, Вторник + 86399), Момент);
	Строки = Деньги.Деньги.НайтиСтроки(Новый Структура("Документ", Требование));
	ПроверитьРавенство(1, Строки.Количество(), "одна строка требования");
	Если Строки.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	ПроверитьРавенство(Выручка, Строки[0].Выручка, "выручка: выпущено × цена без НДС × курс заказа");
	ПроверитьРавенство(Материалы, Строки[0].Материалы, "материалы - себестоимость выпуска");
	ПроверитьРавенство(6, Строки[0].Часы, "часы - работа за вычетом ремонта");
	ПроверитьРавенство(60, Строки[0].СтоимостьЧасов, "стоимость часов: 6 × 10");
	ПроверитьРавенство(60, Строки[0].Кг, "кг израсходованного: 10 × 6");
	Строка = СтрокаОтчетаСтанков("ДеньгиПоСтанкам", "Деньги", Деньги.Деньги, Данные.Станок,
		"Выручка,ЗатратыОбслуживания,Маржа,МаржаНаЧас");
	Маржа = Выручка - Материалы - 60 - 50;
	ПроверитьРавенство(50, Строка.ЗатратыОбслуживания, "затраты ремонта в итоге станка");
	ПроверитьРавенство(Маржа, Строка.Маржа, "маржа станка");
	ПроверитьРавенство(Окр(Маржа / 6, 2), Строка.МаржаНаЧас, "маржа на час");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «Выработка станков» за день примера: кг израсходованного, часы и норма.
//
// Параметры:
//  Станок  - СправочникСсылка.ПроизводственноеОборудование - станок сценария
//  Вторник - Дата - день примера
//  Момент  - Дата - момент расчёта
//
Процедура ПроверитьВыработкуСтанков(Станок, Вторник, Момент)

	// BSLLS:MagicNumber-off
	Данные = Отчеты.ВыработкаСтанков.ДанныеОтчета(Новый СтандартныйПериод(Вторник, Вторник + 86399), Момент);
	Строка = СтрокаОтчетаСтанков("ВыработкаСтанков", "Выработка", Данные.Выработка, Станок,
		"Кг,Выпущено,Часы,НормаЧасов,Отклонение,КгВЧас");
	ПроверитьРавенство(60, Строка.Кг, "кг израсходованного");
	ПроверитьРавенство(6, Строка.Выпущено, "выпущено");
	ПроверитьРавенство(6, Строка.Часы, "часы работы");
	ПроверитьРавенство(0.75, Строка.НормаЧасов, "норма: 60 кг / 120 кг/ч + 15 мин");
	ПроверитьРавенство(5.25, Строка.Отклонение, "отклонение от нормы");
	ПроверитьРавенство(10, Строка.КгВЧас, "кг в час");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «Материалы на станках»: на вторник - свободный недорасход A, на среду - закреплённое за запущенным B.
//
// Параметры:
//  Данные     - Структура - см. ДанныеТребованияСценария
//  Требование - ДокументСсылка.ТребованиеНакладная - запущенное требование B
//  Вторник    - Дата - день завершения A
//  Среда      - Дата - день запуска B
//
Процедура ПроверитьМатериалыНаСтанках(Данные, Требование, Вторник, Среда)

	// BSLLS:MagicNumber-off
	Отбор = Новый Структура("Станок, Материал", Данные.Станок, Данные.Сырье);
	НаВторник = Отчеты.МатериалыНаСтанках.ДанныеОтчета(Вторник).Материалы.НайтиСтроки(Отбор);
	ПроверитьРавенство(1, НаВторник.Количество(), "на вторник - одна строка сырья");
	Если НаВторник.Количество() = 1 Тогда
		Проверить(Не ЗначениеЗаполнено(НаВторник[0].Требование), "на вторник - свободный остаток станка");
		ПроверитьРавенство(2, НаВторник[0].Количество, "недорасход A: 12 - 10");
		ПроверитьРавенство(12, НаВторник[0].Кг, "кг недорасхода");
		Проверить(НаВторник[0].Сумма > 0, "себестоимость недорасхода");
	КонецЕсли;
	НаСреду = Отчеты.МатериалыНаСтанках.ДанныеОтчета(Среда).Материалы.НайтиСтроки(Отбор);
	ПроверитьРавенство(1, НаСреду.Количество(), "на среду - одна строка сырья: свободного нет");
	Если НаСреду.Количество() = 1 Тогда
		ПроверитьРавенство(Требование, НаСреду[0].Требование, "на среду - закреплено за B");
		ПроверитьРавенство(Данные.Заказ, НаСреду[0].Заказ, "заказ закреплённого");
		ПроверитьРавенство(8, НаСреду[0].Количество, "закреплено: 4 × 2");
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Строка категорий времени документа или строка фонда.
//
// Параметры:
//  Категории - ТаблицаЗначений - см. ЗагрузкаСтанков.КатегорииВремени
//  Документ  - ДокументСсылка, Неопределено - документ; Неопределено - строка фонда
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Структура - строка; нет её - нули
//
Функция СтрокаКатегорий(Категории, Документ)

	Для Каждого Строка Из Категории Цикл
		Если Строка.Документ = Документ Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Нули = Новый Структура("Фонд, Работа, Обслуживание, НетЗаказа, План");
	Для Каждого КлючИЗначение Из Нули Цикл
		Нули[КлючИЗначение.Ключ] = 0;
	КонецЦикла;
	Возврат Нули;

КонецФункции

// Себестоимость продукции выпуска по требованию без НДС - приход регистра.
//
// Параметры:
//  Требование - ДокументСсылка.ТребованиеНакладная - завершённое требование
//
// Возвращаемое значение:
//  Число - сумма
//
Функция СебестоимостьВыпускаТребования(Требование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Движения.Сумма - Движения.СуммаНДС), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Выпуск
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)";
	Запрос.УстановитьПараметр("Выпуск", ТребованияНакладные.ВыпускПоТребованию(Требование));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;

КонецФункции

// Итог группировки «Станок» отчёта учёта станков: схема компонуется в таблицу значений с внешним набором.
//
// Параметры:
//  ИмяОтчета  - Строка - имя отчёта
//  ИмяНабора  - Строка - имя внешнего набора схемы
//  Таблица    - ТаблицаЗначений - внешний набор, см. ДанныеОтчета отчёта
//  Станок     - СправочникСсылка.ПроизводственноеОборудование - отбор
//  ИменаПолей - Строка - поля через запятую
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Структура - строка группировки; нет её - Структура с нулями
//
Функция СтрокаОтчетаСтанков(ИмяОтчета, ИмяНабора, Таблица, Станок, ИменаПолей)

	Схема = Отчеты[ИмяОтчета].ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов",
		РасположениеИтоговКомпоновкиДанных.Нет);
	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Станок");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Станок;
	Отбор.Использование = Истина;
	Настройки.Структура.Очистить();
	Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Станок");
	ПолеГруппировки.Использование = Истина;
	Для Каждого ИмяПоля Из СтрРазделить(ИменаПолей, ",") Цикл
		Поле = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, Новый Структура(ИмяНабора, Таблица));
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);
	Если Результат.Количество() = 0 Тогда
		Пусто = Новый Структура(СтрЗаменить(ИменаПолей, ",", ", "));
		Для Каждого КлючИЗначение Из Пусто Цикл
			Пусто[КлючИЗначение.Ключ] = 0;
		КонецЦикла;
		Возврат Пусто;
	КонецЕсли;
	Возврат Результат[0];

КонецФункции

#КонецОбласти

#Область РабочееМестоПроизводства

// Рабочее место производства (E12.1): строки «Продукции» пишут заказ-черновик и правят его строки, выбор черновиков
// клиента, представление заказа, отказы без записи, сверка версии, кнопка «Статус», материалы с остатками потребностей и
// документы цепочки второго уровня, удаление строк с пометкой пустого черновика. Все записи сценария успешные: отказ
// записи испортил бы транзакцию прогона, поэтому отказы проверяются функциями проверки без записи.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАРМПроизводство(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	ПроверитьПредставлениеЗаказаАРМ(Контекст);
	ПроверитьЗапретыСтрокиАРМ(Контекст);
	Данные = ПроверитьЧерновикАРМ(Контекст);
	ПроверитьПравкуСтрокАРМ(Контекст, Данные);
	ПроверитьСтатусИЦепочкуАРМ(Контекст, Данные);
	ПроверитьУдалениеСтрокАРМ(Данные);
	ПроверитьПодборНоменклатурыАРМ(Контекст);

	Возврат РезультатСценария("представление заказа с суммой и количеством, отказы строки без записи, черновик первой "
		+ "строкой с материалами по карте и стадией «Черновик», вторая строка той же продукции в тот же черновик, "
		+ "черновики клиента, отборы «Продукции» и счётчик страниц заказов по клиенту, продукции, стадии и периоду "
		+ "отгрузки, стадия в строках, правка количества с пересчётом "
		+ "материалов, строка без правок без записи, устаревшая версия, "
		+ "«В работу» и «В черновик», пояснение индикатора с процентами, материалы с потребностью и заказанным, "
		+ "документы второго уровня через заказ "
		+ "поставщику, движение продукции и материалов по документам со знаком, в базовых единицах без услуг "
		+ "и только у проведённых, "
		+ "количества в подсказке индикатора, удаление строк с пометкой пустого черновика, "
		+ "типы подбора продукции и материалов, последние созданные по дате создания с пределом без помеченных "
		+ "и чужих типов");

КонецФункции

// Подбор номенклатуры в колонках рабочего места и заказа (S7): правило типов по назначению колонки и последние
// созданные позиции.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПодборНоменклатурыАРМ(Контекст)

	// BSLLS:MagicNumber-off - количества типов, пределы и часы сдвига дат создания примера.
	Каталог = Справочники.Номенклатура;
	Типы = Перечисления.ТипыНоменклатуры;
	ТипыПродукции = Каталог.ТипыПодбора(Каталог.НазначениеПодбораПродукция());
	ТипыМатериалов = Каталог.ТипыПодбора(Каталог.НазначениеПодбораМатериалы());
	ПроверитьРавенство(2, ТипыПродукции.Количество(), "типов в подборе продукции");
	ЕстьГотовая = ТипыПродукции.Найти(Типы.Продукция) <> Неопределено;
	ЕстьПолуфабрикат = ТипыПродукции.Найти(Типы.Полуфабрикат) <> Неопределено;
	Проверить(ЕстьГотовая И ЕстьПолуфабрикат, "подбор продукции предлагает готовую продукцию и полуфабрикаты");
	ПроверитьРавенство(3, ТипыМатериалов.Количество(), "типов в подборе материалов");
	ЕстьСырье = ТипыМатериалов.Найти(Типы.Сырье) <> Неопределено;
	ЕстьПолуфабрикат = ТипыМатериалов.Найти(Типы.Полуфабрикат) <> Неопределено;
	ЕстьТовар = ТипыМатериалов.Найти(Типы.Товар) <> Неопределено;
	Проверить(ЕстьСырье И ЕстьПолуфабрикат И ЕстьТовар, "подбор материалов предлагает сырьё, полуфабрикаты и товары");
	Лишние = Новый Массив;
	Лишние.Добавить(Типы.Услуга);
	Лишние.Добавить(Типы.Комплект);
	Для Каждого Лишний Из Лишние Цикл
		Проверить(ТипыПродукции.Найти(Лишний) = Неопределено И ТипыМатериалов.Найти(Лишний) = Неопределено,
			"тип «" + Лишний + "» не предлагается подбором");
	КонецЦикла;
	НеизвестноеОтклонено = Ложь;
	Попытка
		Каталог.ТипыПодбора("Неизвестное");
	Исключение
		НеизвестноеОтклонено = Истина;
	КонецПопытки;
	Проверить(НеизвестноеОтклонено, "неизвестное назначение подбора отклоняется исключением");

	// Даты создания в будущем обгоняют всю номенклатуру базы: порядок проверяется на своих позициях.
	Час = 3600;
	Основа = ТекущаяДатаСеанса();
	Третья = НоменклатураСДатойСоздания(Контекст, "подбор 3", Типы.Продукция, Основа + 3 * Час, Ложь);
	Вторая = НоменклатураСДатойСоздания(Контекст, "подбор 2", Типы.Полуфабрикат, Основа + 2 * Час, Ложь);
	НоменклатураСДатойСоздания(Контекст, "подбор 1", Типы.Продукция, Основа + 1 * Час, Ложь);
	Помеченная = НоменклатураСДатойСоздания(Контекст, "подбор помеченная", Типы.Продукция, Основа + 4 * Час, Истина);
	Сырье = НоменклатураСДатойСоздания(Контекст, "подбор сырьё", Типы.Сырье, Основа + 5 * Час, Ложь);
	Последние = Каталог.ПоследниеСозданные(ТипыПродукции, 2);
	ПроверитьРавенство(2, Последние.Количество(), "последних созданных при пределе 2");
	ПроверитьРавенство(Третья, Последние[0].Значение.Номенклатура, "первая из последних созданных - самая новая");
	ПроверитьРавенство(Вторая, Последние[1].Значение.Номенклатура, "вторая из последних созданных");
	Для Каждого Пункт Из Каталог.ПоследниеСозданные(ТипыПродукции, 10) Цикл
		Проверить(Пункт.Значение.Номенклатура <> Помеченная, "помеченная на удаление не попадает в последние созданные");
		Проверить(Пункт.Значение.Номенклатура <> Сырье, "сырьё не попадает в последние созданные продукции");
	КонецЦикла;

	Продукция = Каталог.ДанныеПодбора(Каталог.НазначениеПодбораПродукция());
	Проверить(Не Продукция.Мягкий И Продукция.Пункты.Количество() > 0, "подбор продукции жёсткий, с последними созданными");
	Материалы = Каталог.ДанныеПодбора(Каталог.НазначениеПодбораМатериалы());
	Проверить(Материалы.Мягкий И Материалы.Пункты.Количество() = 0, "подбор материалов мягкий, без своих пунктов");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Параметры:
//  Контекст        - Структура - см. НовыйКонтекст
//  Название        - Строка - окончание наименования.
//  ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры - тип.
//  ДатаСоздания    - Дата - дата создания: новый элемент получает текущую, поэтому она ставится второй записью.
//  Пометка         - Булево - пометить на удаление.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - записанная позиция.
//
Функция НоменклатураСДатойСоздания(Контекст, Название, ТипНоменклатуры, ДатаСоздания, Пометка)

	Номенклатура = НоваяНоменклатура(Контекст, Название, ТипНоменклатуры).ПолучитьОбъект();
	Номенклатура.ДатаСоздания = ДатаСоздания;
	Номенклатура.ПометкаУдаления = Пометка;
	Номенклатура.Записать();
	Возврат Номенклатура.Ссылка;

КонецФункции

// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПредставлениеЗаказаАРМ(Контекст)

	// BSLLS:MagicNumber-off - дата и числа примера из решения владельца 2026-09-15.
	АРМ = Обработки.АРМПроизводство;
	ДатаПримера = Дата(2026, 3, 12);
	НомерПримера = "11111";
	СуммаПримера = АРМ.ПредставлениеЗаказаДляВыбора(НомерПримера, ДатаПримера, Контекст.Контрагент, 1250, 15, Истина);
	Проверить(СтрНайти(СуммаПримера, НомерПримера) > 0 И СтрНайти(СуммаПримера, "12.03") > 0,
		"представление заказа содержит номер и дату дд.ММ: " + СуммаПримера);
	Проверить(СтрНайти(СуммаПримера, Строка(Контекст.Контрагент)) > 0, "представление заказа содержит клиента");
	Проверить(СтрНайти(СуммаПримера, Формат(1250, "ЧДЦ=2; ЧН=0,00")) > 0, "представление с суммами показывает сумму");
	КоличествоПримера = АРМ.ПредставлениеЗаказаДляВыбора(НомерПримера, ДатаПримера, Контекст.Контрагент, 1250, 15, Ложь);
	Проверить(СтрНайти(КоличествоПримера, Формат(1250, "ЧДЦ=2; ЧН=0,00")) = 0 И СтрНайти(КоличествоПримера, "15") > 0,
		"представление без сумм показывает количество: " + КоличествоПримера);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьЗапретыСтрокиАРМ(Контекст)

	АРМ = Обработки.АРМПроизводство;
	БезПродукции = ДанныеСтрокиАРМ(Контекст, Справочники.Номенклатура.ПустаяСсылка(), 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(БезПродукции)), "строка без продукции не записывается");
	БезКоличества = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 0);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(БезКоличества)), "строка без количества не записывается");
	БезВерсии = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 1);
	БезВерсии.НомерСтроки = 1;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(БезВерсии)), "записанная строка без заказа и версии отклоняется");
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(Новый Структура)), "неполные данные строки отклоняются");

	Продажа = ЗаказКлиентаСценария(Контекст);
	Записать(Продажа);
	ВПродажу = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 1);
	ВПродажу.Заказ = Продажа.Ссылка;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(ВПродажу)), "строка в заказ-продажу не записывается");
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтатуса(Продажа.Ссылка, АРМ.ДействиеВРаботу())),
		"продажа в работу не переводится");

КонецПроцедуры

// Первая строка создаёт черновик, вторая строка той же продукции идёт в тот же черновик.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - Заказ (ДокументСсылка.ЗаказПокупателя), Результат (последний результат записи строки).
//
Функция ПроверитьЧерновикАРМ(Контекст)

	// BSLLS:MagicNumber-off - количества строк сценария: 2 и 3 упаковки, правка до 4, устаревшая правка 9.
	АРМ = Обработки.АРМПроизводство;
	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	Первая = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 2);
	Результат = ЗаписьСтрокиАРМ(Первая, "первая строка создаёт черновик");
	Заказ = Результат.Заказ.ПолучитьОбъект();
	ПроверитьРавенство(Перечисления.ВидыОперацийЗаказаПокупателя.Производство, Заказ.ВидОперации,
		"черновик АРМ - заказ на производство");
	ПроверитьРавенство(Контекст.Контрагент, Заказ.Контрагент, "черновик АРМ оформлен на клиента строки");
	Проверить(Не Заказ.Проведен И ЗначениеЗаполнено(Заказ.Организация), "черновик АРМ записан без проведения с организацией");
	ПроверитьРавенство(1, Заказ.ТЧТовары.Количество(), "в черновике одна строка");
	ПроверитьРавенство(1, Заказ.ТЧМатериалы.Количество(), "материалы первой строки заполнены по карте");
	ПроверитьРавенство(2 * Расход, Заказ.ТЧМатериалы.Итог("Количество"), "количество материала первой строки");
	Стадия = ПроизводственныеЗаказы.ДанныеСтадии(Заказ.Ссылка);
	Проверить(Стадия <> Неопределено И Стадия.Стадия = Перечисления.СтатусыЗаказовПокупателя.Черновик,
		"стадия черновика АРМ - «Черновик»");
	ПроверитьРавенство(1, Результат.СтрокиЗаказа.Количество(), "результат записи возвращает строки заказа");

	Вторая = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 3);
	Вторая.Заказ = Результат.Заказ;
	Вторая.ВерсияДанных = Результат.СтрокиЗаказа[0].ВерсияДанных;
	Результат = ЗаписьСтрокиАРМ(Вторая, "вторая строка в тот же черновик");
	ПроверитьРавенство(Заказ.Ссылка, Результат.Заказ, "вторая строка не создаёт новый заказ");
	Заказ.Прочитать();
	ПроверитьРавенство(2, Заказ.ТЧТовары.Количество(), "в черновике две строки");
	Проверить(Заказ.ТЧТовары[0].КодСтроки <> Заказ.ТЧТовары[1].КодСтроки, "коды строк продукции разные");
	ПроверитьРавенство(5 * Расход, Заказ.ТЧМатериалы.Итог("Количество"), "материалы второй строки той же продукции");

	Черновики = АРМ.ЧерновикиКлиента(Контекст.Контрагент);
	Проверить(Черновики.НайтиПоЗначению(Заказ.Ссылка) <> Неопределено, "черновик в списке черновиков клиента");
	ДругойКлиент = НовыйКонтрагент();
	ДругойКлиентОбъект = ДругойКлиент.ПолучитьОбъект();
	ДругойКлиентОбъект.Наименование = ПометкаТеста() + ": другой клиент АРМ";
	ДругойКлиентОбъект.Записать();
	Проверить(АРМ.ЧерновикиКлиента(ДругойКлиент).НайтиПоЗначению(Заказ.Ссылка) = Неопределено,
		"черновика нет в списке другого клиента");
	// Отборы панели - элементы справочников, стадия и период отгрузки (решение владельца 2026-10-05).
	Отборы = АРМ.НовыеОтборы();
	Отборы.Клиент = Контекст.Контрагент;
	Отборы.Продукция = Контекст.Продукция;
	ОтборЧерновика = Новый Структура("Заказ", Заказ.Ссылка);
	СтрокиЧерновика = АРМ.СтрокиПродукции(Отборы).Строки.НайтиСтроки(ОтборЧерновика);
	ПроверитьРавенство(2, СтрокиЧерновика.Количество(),
		"отбор «Продукции» по клиенту и продукции показывает строки черновика");
	ПроверитьРавенство(Перечисления.СтатусыЗаказовПокупателя.Черновик, СтрокиЧерновика[0].Стадия,
		"строка «Продукции» показывает стадию заказа");
	Проверить(СтрокиЧерновика[0].Редактируется, "строка черновика в «Продукции» редактируется");
	Страница = АРМ.СтраницаЗаказов(Отборы, 1, 50);
	Проверить(Страница.Всего >= 1 И Страница.НомерСтраницы = 1, "счётчик страниц списка заказов видит черновик клиента");
	Отборы.Стадия = Перечисления.СтатусыЗаказовПокупателя.Черновик;
	ПроверитьРавенство(2, АРМ.СтрокиПродукции(Отборы).Строки.НайтиСтроки(ОтборЧерновика).Количество(),
		"отбор по стадии «Черновик» показывает строки черновика");
	Проверить(АРМ.СтраницаЗаказов(Отборы, 1, 50).Всего >= 1, "счётчик страниц учитывает отбор по стадии «Черновик»");
	Отборы.Стадия = Перечисления.СтатусыЗаказовПокупателя.Выполнен;
	ПроверитьРавенство(0, АРМ.СтрокиПродукции(Отборы).Строки.НайтиСтроки(ОтборЧерновика).Количество(),
		"отбор по другой стадии строки черновика не показывает");
	ПроверитьРавенство(0, АРМ.СтраницаЗаказов(Отборы, 1, 50).Всего, "счётчик страниц учитывает отбор по стадии");
	Отборы.Стадия = Неопределено;
	// Черновик без даты отгрузки в отбор по периоду не попадает ни с какой границей.
	ДатаОтгрузки = ?(ЗначениеЗаполнено(Заказ.ДатаОтгрузки), Заказ.ДатаОтгрузки, ТекущаяДатаСеанса());
	Отборы.ПериодОтгрузки = Новый СтандартныйПериод(НачалоДня(ДатаОтгрузки), КонецДня(ДатаОтгрузки));
	ПроверитьРавенство(?(ЗначениеЗаполнено(Заказ.ДатаОтгрузки), 2, 0),
		АРМ.СтрокиПродукции(Отборы).Строки.НайтиСтроки(ОтборЧерновика).Количество(),
		"отбор по периоду: строки черновика видны только при дате отгрузки в периоде");
	Отборы.ПериодОтгрузки = Новый СтандартныйПериод(ДобавитьМесяц(НачалоДня(ДатаОтгрузки), 12),
		ДобавитьМесяц(КонецДня(ДатаОтгрузки), 12));
	ПроверитьРавенство(0, АРМ.СтрокиПродукции(Отборы).Строки.НайтиСтроки(ОтборЧерновика).Количество(),
		"отбор по периоду без даты отгрузки черновика строки не показывает");
	Отборы.ПериодОтгрузки = Неопределено;
	Отборы.Клиент = ДругойКлиент;
	ПроверитьРавенство(0, АРМ.СтрокиПродукции(Отборы).Строки.НайтиСтроки(ОтборЧерновика).Количество(),
		"отбор по другому клиенту строки черновика не показывает");
	ПроверитьРавенство(0, АРМ.СтраницаЗаказов(Отборы, 1, 50).Всего, "у нового клиента без заказов страниц с заказами нет");
	ЧужаяСтрока = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 1);
	ЧужаяСтрока.Клиент = ДругойКлиент;
	ЧужаяСтрока.Заказ = Заказ.Ссылка;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(ЧужаяСтрока)), "строка другого клиента в черновик не пишется");
	Возврат Новый Структура("Заказ, Результат", Заказ.Ссылка, Результат);
	// BSLLS:MagicNumber-on

КонецФункции

// Правка количества пересчитывает материалы; строка без правок заказ не перезаписывает; устаревшая версия отклоняется.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьЧерновикАРМ
//
Процедура ПроверитьПравкуСтрокАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества строк сценария: 2 и 3 упаковки, правка до 4, устаревшая правка 9.
	АРМ = Обработки.АРМПроизводство;
	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	Правка = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 4);
	ЗаполнитьКлючСтрокиАРМ(Правка, Данные.Результат, 1);
	Результат = ЗаписьСтрокиАРМ(Правка, "правка количества первой строки");
	Заказ = Данные.Заказ.ПолучитьОбъект();
	ПроверитьРавенство(4, Заказ.ТЧТовары[0].КоличествоУпаковок, "количество первой строки изменено");
	ПроверитьРавенство(7 * Расход, Заказ.ТЧМатериалы.Итог("Количество"), "материалы пересчитаны по количеству");

	БезПравок = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 4);
	ЗаполнитьКлючСтрокиАРМ(БезПравок, Результат, 1);
	Результат = ЗаписьСтрокиАРМ(БезПравок, "окончание редактирования без правок");
	ПроверитьРавенство(Заказ.ВерсияДанных, Результат.СтрокиЗаказа[0].ВерсияДанных, "строка без правок заказ не перезаписывает");

	Устаревшая = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 9);
	ЗаполнитьКлючСтрокиАРМ(Устаревшая, Данные.Результат, 1);
	Отказ = АРМ.ЗаписатьСтрокуПродукции(Устаревшая);
	Проверить(Не Отказ.Успех И Отказ.Перечитать, "строка с устаревшей версией заказа отклоняется с перечитыванием");
	Заказ.Прочитать();
	ПроверитьРавенство(4, Заказ.ТЧТовары[0].КоличествоУпаковок, "устаревшая правка заказ не меняет");
	Данные.Результат = Результат;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «В работу» проводит заказ и закрывает строки для правки; материалы и документы цепочки видят закупку; «В черновик»
// отменяет проведение.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьЧерновикАРМ
//
Процедура ПроверитьСтатусИЦепочкуАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества строк сценария: 2 и 3 упаковки, правка до 4, устаревшая правка 9.
	АРМ = Обработки.АРМПроизводство;
	Расход = Контекст.Числа.РасходСырьяНаЕдиницу;
	Заказы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Заказ);
	Итог = АРМ.ИзменитьСтатусЗаказов(Заказы, АРМ.ДействиеВРаботу())[0];
	Проверить(Итог.Успех, "«В работу» проводит черновик: " + Итог.Текст);
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Заказ, "Проведен"), "заказ в работе проведён");
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтатуса(Данные.Заказ, АРМ.ДействиеВРаботу())), "повторно в работу не переводится");
	Правка = ДанныеСтрокиАРМ(Контекст, Контекст.Продукция, 1);
	ЗаполнитьКлючСтрокиАРМ(Правка, Данные.Результат, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаПравкиСтроки(Правка)), "строки заказа в работе не правятся");

	Текущий = АРМ.ДанныеТекущегоЗаказа(Данные.Заказ);
	Проверить(Текущий.МожноНаОсновании, "у заказа в работе разрешён ввод на основании");
	Пояснение = Текущий.ПояснениеИндикатора;
	Проверить(СтрНайти(Пояснение, "%") > 0 И СтрНайти(Пояснение, "%%") = 0
		И СтрНайти(Пояснение, ПроизводственныеЗаказы.ЛегендаИндикатора()) > 0,
		"пояснение индикатора - проценты заказа и легенда: " + Пояснение);
	ПроверитьРавенство(7 * Расход, ИтогДереваМатериалов(Текущий.Материалы, "Потребность"),
		"потребность материалов заказа в работе");
	ПроверитьРавенство(7 * Расход, ИтогДереваМатериалов(Текущий.Материалы, "Дефицит"), "дефицит до закупки");

	ЗаказПоставщику = НовыйЗаказПоставщикуПотребности(Контекст, Данные.Заказ);
	Провести(ЗаказПоставщику);
	Поступление = НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику.Ссылка);
	Провести(Поступление);
	Текущий = АРМ.ДанныеТекущегоЗаказа(Данные.Заказ);
	ПроверитьРавенство(0, ИтогДереваМатериалов(Текущий.Материалы, "Дефицит"), "после заказа поставщику дефицита нет");
	СтрокаЗаказа = Текущий.Документы.Найти(ЗаказПоставщику.Ссылка, "Документ");
	Проверить(СтрокаЗаказа <> Неопределено И СтрокаЗаказа.Через = Неопределено, "заказ поставщику - первый уровень цепочки");
	СтрокаПоступления = Текущий.Документы.Найти(Поступление.Ссылка, "Документ");
	Проверить(СтрокаПоступления <> Неопределено И СтрокаПоступления.Через = ЗаказПоставщику.Ссылка,
		"поступление по заказу поставщику - второй уровень цепочки");
	ПроверитьДвижениеДокументовАРМ(Данные, Текущий, ЗаказПоставщику, Поступление);

	Итог = АРМ.ИзменитьСтатусЗаказов(Заказы, АРМ.ДействиеВЧерновик())[0];
	Проверить(Итог.Успех, "«В черновик» отменяет проведение: " + Итог.Текст);
	Проверить(Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Заказ, "Проведен"), "заказ в черновике не проведён");
	Данные.Результат.СтрокиЗаказа[0].ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Заказ, "ВерсияДанных");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Движение продукции и материалов в колонках закладки «Документы» (E12.4): заказ поставщику движения не даёт,
// поступление приходует материалы со знаком плюс, непроведённый документ движения не показывает; количества попадают
// в подсказку индикатора.
//
// Параметры:
//  Данные         - Структура - см. ПроверитьЧерновикАРМ
//  Текущий        - Структура - см. Обработки.АРМПроизводство.ДанныеТекущегоЗаказа
//  ЗаказПоставщику - ДокументОбъект.ЗаказПоставщику - заказ поставщику заказа.
//  Поступление    - ДокументОбъект.ПоступлениеТоваровУслуг - поступление по нему.
//
Процедура ПроверитьДвижениеДокументовАРМ(Данные, Текущий, ЗаказПоставщику, Поступление)

	ПолеДокумента = "Документ";
	СтрокаЗаказа = Текущий.Документы.Найти(ЗаказПоставщику.Ссылка, ПолеДокумента);
	ПроверитьРавенство(0, СтрокаЗаказа.МатериалыЧисло, "заказ поставщику движения материалов не даёт");
	Проверить(ПустаяСтрока(СтрокаЗаказа.Материалы), "у заказа поставщику колонка движения пустая");
	СтрокаПоступления = Текущий.Документы.Найти(Поступление.Ссылка, ПолеДокумента);
	Проверить(СтрокаПоступления.МатериалыЧисло > 0, "поступление приходует материалы");
	ПроверитьРавенство(1, СтрНайти(СтрокаПоступления.Материалы, "+"),
		"приход показан со знаком плюс: " + СтрокаПоступления.Материалы);
	ПроверитьРавенство(0, СтрокаПоступления.ПродукцияЧисло, "поступление материалов продукцию не двигает");
	Проверить(ПустаяСтрока(СтрокаПоступления.Продукция), "колонка продукции поступления материалов пустая");
	Количества = СтрРазделить(Текущий.ПояснениеИндикатора, Символы.ПС, Ложь)[1];
	// Число ищется вместе со следующим за ним разделителем: иначе «10» нашлось бы внутри «100».
	ПришлоВПодсказке = Формат(СтрокаПоступления.МатериалыЧисло, "ЧГ=0") + ",";
	Проверить(СтрНайти(Количества, ПришлоВПодсказке) > 0,
		"пришедшие материалы попали в подсказку индикатора: " + Количества);

	Поступление.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	БезПроведения = Обработки.АРМПроизводство.ДанныеТекущегоЗаказа(Данные.Заказ);
	СтрокаПоступления = БезПроведения.Документы.Найти(Поступление.Ссылка, ПолеДокумента);
	БезДвижения = СтрокаПоступления <> Неопределено И ПустаяСтрока(СтрокаПоступления.Материалы)
		И СтрокаПоступления.МатериалыЧисло = 0;
	Проверить(БезДвижения, "у непроведённого поступления движения нет");
	Провести(Поступление);

КонецПроцедуры

// Удаление строк: обе строки черновика одним вызовом, пустой черновик помечается на удаление.
//
// Параметры:
//  Данные - Структура - см. ПроверитьЧерновикАРМ
//
Процедура ПроверитьУдалениеСтрокАРМ(Данные)

	АРМ = Обработки.АРМПроизводство;
	Версия = Данные.Результат.СтрокиЗаказа[0].ВерсияДанных;
	Удаляемые = Новый Массив;
	Для НомерСтроки = 1 По 2 Цикл
		ДанныеСтроки = АРМ.НовыеДанныеСтроки();
		ДанныеСтроки.Заказ = Данные.Заказ;
		ДанныеСтроки.Клиент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Заказ, "Контрагент");
		ДанныеСтроки.НомерСтроки = НомерСтроки;
		ДанныеСтроки.ВерсияДанных = Версия;
		Удаляемые.Добавить(ДанныеСтроки);
	КонецЦикла;
	Итог = АРМ.УдалитьСтрокиПродукции(Удаляемые)[0];
	Проверить(Итог.Успех И Итог.ЗаказПомечен, "удаление всех строк черновика помечает его на удаление: " + Итог.Текст);
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Заказ, "ПометкаУдаления"), "черновик помечен на удаление");

КонецПроцедуры

// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Номенклатура - СправочникСсылка.Номенклатура - продукция строки
//  Количество   - Число - количество в упаковках
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтроки
//
Функция ДанныеСтрокиАРМ(Контекст, Номенклатура, Количество)

	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтроки();
	ДанныеСтроки.Клиент = Контекст.Контрагент;
	ДанныеСтроки.Номенклатура = Номенклатура;
	ДанныеСтроки.КоличествоУпаковок = Количество;
	Возврат ДанныеСтроки;

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтроки
//  Результат    - Структура - результат записи строки с СтрокиЗаказа
//  НомерСтроки  - Число - номер строки заказа
//
Процедура ЗаполнитьКлючСтрокиАРМ(ДанныеСтроки, Результат, НомерСтроки)

	СтрокаЗаказа = Результат.СтрокиЗаказа[НомерСтроки - 1];
	ДанныеСтроки.Заказ = СтрокаЗаказа.Заказ;
	ДанныеСтроки.НомерСтроки = СтрокаЗаказа.НомерСтроки;
	ДанныеСтроки.ВерсияДанных = СтрокаЗаказа.ВерсияДанных;

КонецПроцедуры

// Параметры:
//  ДанныеСтроки - Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтроки
//  Описание     - Строка - что проверяется
//
// Возвращаемое значение:
//  Структура - результат записи строки, проверенный на успех
//
Функция ЗаписьСтрокиАРМ(ДанныеСтроки, Описание)

	Результат = Обработки.АРМПроизводство.ЗаписатьСтрокуПродукции(ДанныеСтроки);
	Проверить(Результат.Успех, Описание + ": " + Результат.Текст);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область РабочееМестоЗакупок

// Рабочее место закупок, сборка 2.0.16.28 (docs/plans/arm-purchasing.md): вычисляемый статус заказа поставщику до
// пагинации, индикатор поставки и оплаты, данные нижних закладок. Опция «Производство» не нужна: закупка без заказа
// клиента.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийРабочееМестоЗакупок(Контекст)

	// BSLLS:MagicNumber-off - количества и суммы сценария: заказы по 10, поступления 4 и 6, возврат 1, перенос 3.
	Товар = НоваяНоменклатура(Контекст, "товар рабочего места закупок", Перечисления.ТипыНоменклатуры.Товар);
	Данные = Новый Структура;
	Данные.Вставить("Товар", Товар);
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	АРМ = Обработки.АРМЗакупки;

	Черновик = ЗаказПоставщикуРабочегоМеста(Контекст, Данные.Товар, 1, Сегодня + 10 * 86400);
	Черновик.Записать(РежимЗаписиДокумента.Запись);
	ЗаказА = ЗаказПоставщикуРабочегоМеста(Контекст, Данные.Товар, 10, Сегодня + 10 * 86400);
	Провести(ЗаказА);
	ЗаказБ = ЗаказПоставщикуРабочегоМеста(Контекст, Данные.Товар, 10, Сегодня - 86400);
	Провести(ЗаказБ);
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, Черновик.Ссылка, Перечисления.СтатусыЗаказовПоставщику.Черновик, "○○");
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, ЗаказА.Ссылка, Перечисления.СтатусыЗаказовПоставщику.ОжидаетПоставки,
		"○○");
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, ЗаказБ.Ссылка, Перечисления.СтатусыЗаказовПоставщику.Просрочен, "○○");

	Первое = НовоеПоступлениеПотребности(Контекст, ЗаказА.Ссылка);
	УстановитьКоличествоСтроки(Первое.ТЧТовары[0], 4);
	Провести(Первое);
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, ЗаказА.Ссылка,
		Перечисления.СтатусыЗаказовПоставщику.ЧастичноПоступил, "◐○");
	Второе = НовоеПоступлениеПотребности(Контекст, ЗаказА.Ссылка);
	УстановитьКоличествоСтроки(Второе.ТЧТовары[0], 6);
	Провести(Второе);
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, ЗаказА.Ссылка, Перечисления.СтатусыЗаказовПоставщику.Поступил, "●○");

	ОплатаПоставщикуРабочегоМеста(Контекст, Первое.Ссылка, Первое.СуммаРегл);
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, ЗаказА.Ссылка, Перечисления.СтатусыЗаказовПоставщику.Поступил, "●◐");
	ОплатаПоставщикуРабочегоМеста(Контекст, Второе.Ссылка, Второе.СуммаРегл);
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, ЗаказА.Ссылка, Перечисления.СтатусыЗаказовПоставщику.Поступил, "●●");
	Оплата = АРМ.ОплатыЗаказов(ОдинЗаказ(ЗаказА.Ссылка)).Получить(ЗаказА.Ссылка);
	ПроверитьРавенство(Первое.СуммаРегл + Второе.СуммаРегл, Оплата.СуммаПоступлений, "сумма поступлений заказа");
	ПроверитьРавенство(Первое.СуммаРегл + Второе.СуммаРегл, Оплата.Оплачено, "оплачено по заказу");

	// Возврат пишет в регистр расход с отрицательным количеством: пришло уменьшается, а не удваивается.
	Возврат1 = НовыйВозвратПотребности(Контекст, Второе.Ссылка, 1);
	Провести(Возврат1);
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, ЗаказА.Ссылка,
		Перечисления.СтатусыЗаказовПоставщику.ЧастичноПоступил, "◐●");

	ПроверитьОплатуЧерезНакладнуюРабочегоМеста(Контекст, Данные, Сегодня);
	ПроверитьПереносРабочегоМеста(Контекст, Данные, Сегодня);
	ПроверитьСтраницыРабочегоМеста(Контекст, Данные);
	ПроверитьДанныеЗаказаРабочегоМеста(ЗаказА.Ссылка, Первое.Ссылка, Возврат1.Ссылка);
	ПроверитьВводРабочегоМеста(Контекст, Данные);
	ПроверитьВалютуВводаРабочегоМеста(Контекст, Данные);

	Возврат РезультатСценария("статус заказа поставщику: черновик, ожидает, просрочен, частично, поступил, перенесён; "
		+ "индикатор поставки и оплаты по прямым платежам и по платежу на налоговую накладную в доле покрытия; возврат "
		+ "уменьшает «пришло»; предварительные заказы - только отбором; страницы и отбор по статусу согласованы со "
		+ "счётчиком; товары, поступления, оплаты, документы и сальдо заказа; ввод строками: заказ строкой без заказа "
		+ "клиента, строка в документ любой даты, «К поступлению» - поступление на заказ с общей накладной, отказ строки "
		+ "пакета и полностью поступившей строки ничего не пишет, «Изменить статус», защита перенесённых строк, валюта и "
		+ "курс поступления по валютному заказу, цена прайса в валюте заказа");
	// BSLLS:MagicNumber-on

КонецФункции

// Заказ поставщику сценария без заказа клиента: одна строка товара.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Товар        - СправочникСсылка.Номенклатура - товар строки
//  Количество   - Число - количество
//  ДатаПоставки - Дата - дата поставки
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПоставщику - незаписанный заказ
//
Функция ЗаказПоставщикуРабочегоМеста(Контекст, Товар, Количество, ДатаПоставки)

	Заказ = НовыйЗаказПоставщикуПотребности(Контекст, Неопределено);
	Заказ.ДатаПоставки = ДатаПоставки;
	ДобавитьСтрокуЗакупкиПотребности(Контекст, Заказ, Товар, Количество, Неопределено);
	Возврат Заказ;

КонецФункции

// Оплата поставщику безналичным списанием по основанию.
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Основание - ДокументСсылка.ПоступлениеТоваровУслуг, ДокументСсылка.НалоговаяНакладнаяПокупка - основание оплаты
//  Сумма     - Число - сумма в основной валюте
//
Процедура ОплатаПоставщикуРабочегоМеста(Контекст, Основание, Сумма)

	Списание = НовыйДокумент(Контекст, "СписаниеБезналичныхДенежныхСредств");
	Списание.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	Списание.Контрагент = Контекст.Контрагент;
	Списание.Договор = Контекст.ДоговорПоставщика;
	// BSLLS:YoLetterUsage-off
	Списание.БанковскийСчёт = Контекст.Счет;
	// BSLLS:YoLetterUsage-on
	Списание.ТипОплаты = Справочники.TypesDePayment.VirementBanquaire;
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Списание.ХозяйственнаяОперация);
	Списание.Валюта = Контекст.Валюта;
	Списание.Сумма = Сумма;
	Списание.СуммаВВалютеРеглУчета = Сумма;
	ДобавитьОснование(Списание, Основание, Сумма);
	Провести(Списание);

КонецПроцедуры

// Строка страницы рабочего места по заказу: статус и индикатор «поставка · оплата».
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Данные    - Структура - Товар сценария
//  Заказ     - ДокументСсылка.ЗаказПоставщику - заказ
//  Статус    - ПеречислениеСсылка.СтатусыЗаказовПоставщику - ожидаемый статус
//  Индикатор - Строка - ожидаемый индикатор
//  ВидЗаказа - ПеречислениеСсылка.ВидыЗаказовПоставщику, Неопределено - отбор вида заказа
//
Процедура ПроверитьСтрокуРабочегоМеста(Контекст, Данные, Заказ, Статус, Индикатор, ВидЗаказа = Неопределено)

	Отборы = Обработки.АРМЗакупки.НовыеОтборы();
	Отборы.Товар = Данные.Товар;
	Отборы.ВидЗаказа = ВидЗаказа;
	// BSLLS:MagicNumber-off - страница с запасом на все заказы сценария.
	Страница = Обработки.АРМЗакупки.СтраницаЗаказов(Отборы, 1, 100);
	// BSLLS:MagicNumber-on
	Найдена = Неопределено;
	Для Каждого СтрокаСтраницы Из Страница.Строки Цикл
		Если СтрокаСтраницы.Заказ = Заказ Тогда
			Найдена = СтрокаСтраницы;
		КонецЕсли;
	КонецЦикла;
	Описание = СтрШаблон("заказ поставщику %1", Строка(Заказ));
	Проверить(Найдена <> Неопределено, Описание + ": есть на странице рабочего места");
	ПроверитьРавенство(Статус, Найдена.Статус, Описание + ": статус");
	ПроверитьРавенство(Индикатор, Найдена.Индикатор, Описание + ": индикатор поставки и оплаты");

КонецПроцедуры

// Налоговая накладная покупки переносит на себя расчёты поступления; платёж прямо на накладную считается оплатой
// заказа в доле покрытия.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - Товар сценария
//  Сегодня  - Дата - начало текущего дня
//
Процедура ПроверитьОплатуЧерезНакладнуюРабочегоМеста(Контекст, Данные, Сегодня)

	// BSLLS:MagicNumber-off - заказ 4 единицы, оплата накладной половиной суммы.
	СкладНалоговый = Справочники.МестаХранения.СоздатьЭлемент();
	СкладНалоговый.Наименование = ПометкаТеста() + ": налоговый склад рабочего места закупок";
	СкладНалоговый.Налоговый = Истина;
	СкладНалоговый.Записать();
	ЗаказВ = ЗаказПоставщикуРабочегоМеста(Контекст, Данные.Товар, 4, Сегодня + 10 * 86400);
	Провести(ЗаказВ);
	Поступление = НовоеПоступлениеПотребности(Контекст, ЗаказВ.Ссылка);
	Провести(Поступление);
	Накладная = НовыйДокумент(Контекст, "НалоговаяНакладнаяПокупка");
	Накладная.Заполнить(Поступление.Ссылка);
	// Покрытие поступления накладной - по строкам (РаботаСДокументами.ОснованияНалоговойНакладной), заполнение по
	// поступлению ссылку в строках не ставит.
	Для Каждого СтрокаНакладной Из Накладная.ТЧТовары Цикл
		СтрокаНакладной.ПоступлениеТовара = Поступление.Ссылка;
	КонецЦикла;
	НалоговыйДокументСценария(Контекст, Накладная, СкладНалоговый.Ссылка, Контекст.ДоговорПоставщика);
	Половина = Поступление.СуммаРегл / 2;
	ОплатаПоставщикуРабочегоМеста(Контекст, Накладная.Ссылка, Половина);
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, ЗаказВ.Ссылка, Перечисления.СтатусыЗаказовПоставщику.Поступил, "●◐");
	Оплата = Обработки.АРМЗакупки.ОплатыЗаказов(ОдинЗаказ(ЗаказВ.Ссылка)).Получить(ЗаказВ.Ссылка);
	ПроверитьРавенство(Половина, Оплата.Оплачено, "оплачено платежом на налоговую накладную в доле покрытия");
	ОплатаПоставщикуРабочегоМеста(Контекст, Накладная.Ссылка, Поступление.СуммаРегл - Половина);
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, ЗаказВ.Ссылка, Перечисления.СтатусыЗаказовПоставщику.Поступил, "●●");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Предварительный заказ, строки которого забрал основной заказ: «Перенесён», в списке по умолчанию не виден.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - Товар сценария
//  Сегодня  - Дата - начало текущего дня
//
Процедура ПроверитьПереносРабочегоМеста(Контекст, Данные, Сегодня)

	// BSLLS:MagicNumber-off - перенос 3 единиц.
	Предварительный = ЗаказПоставщикуРабочегоМеста(Контекст, Данные.Товар, 3, Сегодня + 10 * 86400);
	Предварительный.ВидЗаказа = Перечисления.ВидыЗаказовПоставщику.Предварительный;
	Провести(Предварительный);
	Основной = ЗаказПоставщикуРабочегоМеста(Контекст, Данные.Товар, 3, Сегодня + 10 * 86400);
	Основной.ТЧТовары[0].ЗаказПоставщику = Предварительный.Ссылка;
	Основной.ТЧТовары[0].КодСтроки = Предварительный.ТЧТовары[0].КодСтроки;
	Провести(Основной);
	// BSLLS:MagicNumber-on
	Данные.Вставить("Предварительный", Предварительный.Ссылка);
	Данные.Вставить("Основной", Основной.Ссылка);
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, Предварительный.Ссылка, Перечисления.СтатусыЗаказовПоставщику.Перенесен,
		"○○", Перечисления.ВидыЗаказовПоставщику.Предварительный);
	ПроверитьСтрокуРабочегоМеста(Контекст, Данные, Основной.Ссылка, Перечисления.СтатусыЗаказовПоставщику.ОжидаетПоставки,
		"○○");

КонецПроцедуры

// Пагинация: счётчик, число страниц и строки последней страницы; отбор по статусу - до деления на страницы.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - Товар и Предварительный сценария
//
Процедура ПроверитьСтраницыРабочегоМеста(Контекст, Данные)

	АРМ = Обработки.АРМЗакупки;
	Отборы = АРМ.НовыеОтборы();
	Отборы.Товар = Данные.Товар;
	// BSLLS:MagicNumber-off - пять непредварительных заказов сценария по два на странице: три страницы.
	Страница = АРМ.СтраницаЗаказов(Отборы, 3, 2);
	ПроверитьРавенство(5, Страница.Всего, "заказов товара сценария без предварительного");
	ПроверитьРавенство(3, Страница.ВсегоСтраниц, "страниц по два заказа");
	ПроверитьРавенство(1, Страница.Строки.Количество(), "строк на последней странице");
	Первая = АРМ.СтраницаЗаказов(Отборы, 1, 2);
	ПроверитьРавенство(2, Первая.Строки.Количество(), "строк на первой странице");
	Проверить(Первая.Строки[0].Дата >= Первая.Строки[1].Дата, "страница идёт от новых заказов к старым");
	Для Каждого СтрокаСтраницы Из Первая.Строки Цикл
		Проверить(СтрокаСтраницы.Заказ <> Данные.Предварительный,
			"предварительный заказ без отбора по виду не показывается");
	КонецЦикла;
	Отборы.Статус = Перечисления.СтатусыЗаказовПоставщику.Черновик;
	Черновики = АРМ.СтраницаЗаказов(Отборы, 1, 2);
	// BSLLS:MagicNumber-on
	ПроверитьРавенство(1, Черновики.Всего, "отбор по статусу «Черновик»");
	ПроверитьРавенство(1, Черновики.Строки.Количество(), "строк отбора по статусу");

КонецПроцедуры

// Нижние закладки по заказу: строки товаров, поступления, платежи, документы цепочки, сальдо.
//
// Параметры:
//  Заказ       - ДокументСсылка.ЗаказПоставщику - заказ с двумя поступлениями и возвратом
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - первое поступление
//  ВозвратТоваров - ДокументСсылка.ВозвратПоставщику - возврат по второму поступлению
//
Процедура ПроверитьДанныеЗаказаРабочегоМеста(Заказ, Поступление, ВозвратТоваров)

	Данные = Обработки.АРМЗакупки.ДанныеЗаказа(Заказ);
	ПроверитьРавенство(1, Данные.Товары.Количество(), "строк товаров заказа");
	// BSLLS:MagicNumber-off - заказано 10, пришло 10 - 1 возврат.
	ПроверитьРавенство(10, Данные.Товары[0].Заказано, "заказано по строке");
	ПроверитьРавенство(9, Данные.Товары[0].Пришло, "пришло по строке за вычетом возврата");
	ПроверитьРавенство(1, Данные.Товары[0].Осталось, "осталось по строке");
	ПроверитьРавенство(2, Данные.Поступления.Количество(), "строк поступлений заказа");
	ПроверитьРавенство(2, Данные.Оплаты.Количество(), "платежей по поступлениям заказа");
	// BSLLS:MagicNumber-on
	ДокументыЦепочки = Данные.Документы.ВыгрузитьКолонку("Документ");
	Проверить(ДокументыЦепочки.Найти(Заказ) <> Неопределено, "заказ в документах цепочки");
	Проверить(ДокументыЦепочки.Найти(Поступление) <> Неопределено, "поступление в документах цепочки");
	Проверить(ДокументыЦепочки.Найти(ВозвратТоваров) <> Неопределено, "возврат в документах цепочки");
	Проверить(Не ПустаяСтрока(Данные.Сальдо), "сальдо расчётов с поставщиком");
	Проверить(Не ПустаяСтрока(Данные.Поступления[0].Статус), "статус поступления");

КонецПроцедуры

// Ввод в рабочем месте закупок (сборка 2.0.16.29): заказ поставщику без заказа клиента строкой общим путём, вторая
// строка, «К поступлению» - по поступлению на каждый из двух заказов с одной накладной, отказ строки пакета (до записи и
// под блокировкой) ничего не пишет, строка во вчерашний черновик и в проведённый заказ, «Изменить статус», защита
// перенесённых строк предварительного заказа и заказ, забравший строки, - только чтение.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - Предварительный, Основной сценария; получает ТоварВвода
//
Процедура ПроверитьВводРабочегоМеста(Контекст, Данные)

	// BSLLS:MagicNumber-off - заказ на пять единиц и строка на две, второй заказ на три; цена прайса сто.
	АРМ = Обработки.АРМЗакупки;
	Товар = НоваяНоменклатура(Контекст, "товар ввода рабочего места закупок", Перечисления.ТипыНоменклатуры.Товар);
	Данные.Вставить("ТоварВвода", Товар);
	ЗаказА = ЗаказВводомРабочегоМеста(Контекст, Товар, 5);
	Проверить(ЗначениеРеквизитаЗапросом(ЗаказА, "Проведен"), "заказ поставщику строкой без заказа клиента проведён");
	Проверить(Не ЗначениеЗаполнено(ЗначениеРеквизитаЗапросом(ЗаказА, "Основание")),
		"у заказа поставщику строкой нет заказа клиента");
	Результат = АРМ.ЗаписатьСтрокуТоваров(ЗаказА, СтрокаТоваровРабочегоМеста(Товар, 2, 0));
	Проверить(Результат.Успех, "вторая строка в заказ поставщику: " + Результат.Текст);
	ПроверитьРавенство(2, АРМ.ДанныеЗаказа(ЗаказА).Товары.Количество(), "строк заказа после второй строки");
	ЗаказБ = ЗаказВводомРабочегоМеста(Контекст, Товар, 3);

	Отборы = АРМ.НовыеОтборы();
	Отборы.Товар = Товар;
	КПоступлению = АРМ.СтрокиКПоступлению(Отборы);
	ПроверитьРавенство(3, КПоступлению.Количество(), "строк «К поступлению» двух заказов");
	Накладная = Новый Структура("Номер, Дата", "РМЗ-" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0"),
		НачалоДня(ТекущаяДатаСеанса()));
	Итоги = АРМ.ОформитьПоступления(СтрокиКПоступлениюСценария(КПоступлению), Накладная);
	ПроверитьРавенство(2, Итоги.Количество(), "поступлений - по одному на заказ");
	Для Каждого Итог Из Итоги Цикл
		Проверить(Итог.Успех, "поступление по заказу «К поступлению»: " + Итог.Текст);
		ПроверитьРавенство(Накладная.Номер, ЗначениеРеквизитаЗапросом(Итог.Документ, "НомерВходящегоДокумента"),
			"номер накладной поступления");
		ПроверитьРавенство(Итог.Заказ, ЗначениеРеквизитаЗапросом(Итог.Документ, "Основание"), "основание поступления");
		Проверить(ЗначениеРеквизитаЗапросом(Итог.Документ, "Проведен"), "поступление «К поступлению» проведено");
	КонецЦикла;
	ПроверитьРавенство(0, АРМ.СтрокиКПоступлению(Отборы).Количество(), "«К поступлению» пусто после приёмки");
	ДанныеТовара = Новый Структура("Товар", Товар);
	ПроверитьСтрокуРабочегоМеста(Контекст, ДанныеТовара, ЗаказА, Перечисления.СтатусыЗаказовПоставщику.Поступил, "●○");
	ПроверитьСтрокуРабочегоМеста(Контекст, ДанныеТовара, ЗаказБ, Перечисления.СтатусыЗаказовПоставщику.Поступил, "●○");

	ПроверитьОтказПакетаРабочегоМеста(Контекст, Товар, Накладная);
	ПроверитьСтрокиЛюбойДатыРабочегоМеста(Контекст, Товар);
	Итоги = АРМ.ИзменитьСтатусЗаказов(ОдинЗаказ(ЗаказА), "ВЧерновик");
	Проверить(Не Итоги[0].Успех, "заказ с поступлениями не уходит в черновик");

	// Перенесённые строки: исходный не правится и не снимается, забравший строки - только чтение.
	Версия = ЗначениеРеквизитаЗапросом(Данные.Предварительный, "ВерсияДанных");
	Строка = СтрокаТоваровРабочегоМеста(Товар, 1, 0);
	Строка.НомерСтроки = 1;
	Строка.ВерсияДанных = Версия;
	Строка.Номенклатура = Данные.Товар;
	Результат = АРМ.ЗаписатьСтрокуТоваров(Данные.Предварительный, Строка);
	Проверить(Не Результат.Успех И СтрНайти(Результат.Текст, "забрал") > 0,
		"строка предварительного заказа, забранная другим, не уменьшается: " + Результат.Текст);
	Результат = АРМ.УдалитьСтрокиТоваров(Данные.Предварительный, Версия, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(1));
	Проверить(Не Результат.Успех, "строка предварительного заказа, забранная другим, не удаляется");
	Итоги = АРМ.ИзменитьСтатусЗаказов(ОдинЗаказ(Данные.Предварительный), "ВЧерновик");
	Проверить(Не Итоги[0].Успех, "предварительный заказ, строки которого забрали, не уходит в черновик");
	Результат = АРМ.ЗаписатьСтрокуТоваров(Данные.Основной, СтрокаТоваровРабочегоМеста(Товар, 1, 0));
	Проверить(Не Результат.Успех И СтрНайти(Результат.Текст, "забрал строки") > 0,
		"заказ, забравший строки другого, в рабочем месте только читается: " + Результат.Текст);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Отказ строки пакета поступления: с несуществующей строкой заказа - до записи, по уже поступившей строке - под
// блокировкой проведения; в обоих случаях поступление не записано.
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Товар     - СправочникСсылка.Номенклатура - товар ввода
//  Накладная - Структура - Номер, Дата
//
Процедура ПроверитьОтказПакетаРабочегоМеста(Контекст, Товар, Накладная)

	// BSLLS:MagicNumber-off - заказ 1 единицы, несуществующий код строки 999.
	АРМ = Обработки.АРМЗакупки;
	ЗаказВ = ЗаказВводомРабочегоМеста(Контекст, Товар, 1);
	Отборы = АРМ.НовыеОтборы();
	Отборы.Товар = Товар;
	Строки = СтрокиКПоступлениюСценария(АРМ.СтрокиКПоступлению(Отборы));
	ПроверитьРавенство(1, Строки.Количество(), "строк «К поступлению» третьего заказа");
	Хорошая = Строки[0];
	Плохая = Новый Структура;
	Для Каждого КлючИЗначение Из Хорошая Цикл
		Плохая.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Плохая.КодСтроки = 999;
	Строки.Добавить(Плохая);
	Итоги = АРМ.ОформитьПоступления(Строки, Накладная);
	Проверить(Не Итоги[0].Успех, "пакет со строкой, которой нет в заказе, не записан");
	ПроверитьРавенство(0, ПоступленийЗаказаРабочегоМеста(ЗаказВ), "поступлений после отказа второй строки пакета");
	Итоги = АРМ.ОформитьПоступления(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Хорошая), Накладная);
	Проверить(Итоги[0].Успех, "поступление по третьему заказу: " + Итоги[0].Текст);
	Итоги = АРМ.ОформитьПоступления(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Хорошая), Накладная);
	Проверить(Не Итоги[0].Успех, "повтор пакета по поступившей строке отклонён под блокировкой");
	ПроверитьРавенство(1, ПоступленийЗаказаРабочегоМеста(ЗаказВ), "поступлений после повтора пакета");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Строка в заказ поставщику не за сегодня: во вчерашний черновик - черновик остаётся черновиком, в проведённый -
// перепроводится; «В работу» и «Отменить» из «Изменить статус».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Товар    - СправочникСсылка.Номенклатура - товар ввода
//
Процедура ПроверитьСтрокиЛюбойДатыРабочегоМеста(Контекст, Товар)

	// BSLLS:MagicNumber-off - вчера 23:00, заказы по 1 единице.
	АРМ = Обработки.АРМЗакупки;
	Вчера = НачалоДня(ТекущаяДатаСеанса()) - 3600;
	Черновик = ЗаказПоставщикуРабочегоМеста(Контекст, Товар, 1, Вчера + 10 * 86400);
	Черновик.Дата = Вчера;
	Черновик.Записать(РежимЗаписиДокумента.Запись);
	Результат = АРМ.ЗаписатьСтрокуТоваров(Черновик.Ссылка, СтрокаТоваровРабочегоМеста(Товар, 1, 0));
	Проверить(Результат.Успех, "строка во вчерашний черновик: " + Результат.Текст);
	Проверить(Не ЗначениеРеквизитаЗапросом(Черновик.Ссылка, "Проведен"), "черновик со строкой остаётся черновиком");
	Проведенный = ЗаказПоставщикуРабочегоМеста(Контекст, Товар, 1, Вчера + 10 * 86400);
	Проведенный.Дата = Вчера;
	Провести(Проведенный);
	Результат = АРМ.ЗаписатьСтрокуТоваров(Проведенный.Ссылка, СтрокаТоваровРабочегоМеста(Товар, 1, 0));
	Проверить(Результат.Успех, "строка во вчерашний проведённый заказ: " + Результат.Текст);
	Проверить(Результат.Проведен, "вчерашний заказ перепроведён со строкой");
	Итоги = АРМ.ИзменитьСтатусЗаказов(ОдинЗаказ(Черновик.Ссылка), "ВРаботу");
	Проверить(Итоги[0].Успех И ЗначениеРеквизитаЗапросом(Черновик.Ссылка, "Проведен"), "«В работу» проводит черновик");
	Итоги = АРМ.ИзменитьСтатусЗаказов(ОдинЗаказ(Проведенный.Ссылка), "Отменить");
	Проверить(Итоги[0].Успех И ЗначениеРеквизитаЗапросом(Проведенный.Ссылка, "ПометкаУдаления"),
		"«Отменить» помечает заказ без поступлений");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Валютный заказ поставщику: поступление «К поступлению» - в валюте заказа по курсу на свою дату, цена - из заказа;
// новая строка без цены - цена прайса поставщика (основная валюта) по курсу заказа.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - ТоварВвода сценария: его прайс поставщика - 100 по поступлениям ввода
//
Процедура ПроверитьВалютуВводаРабочегоМеста(Контекст, Данные)

	// BSLLS:MagicNumber-off - курсы заказа и дня, цена 8 в валюте, прайс 100.
	АРМ = Обработки.АРМЗакупки;
	Основная = РаботаСВалютами.ОсновнаяВалюта();
	Валюта = ?(Основная = Справочники.Валюты.Евро, Справочники.Валюты.ДолларСША, Справочники.Валюты.Евро);
	КурсЗаказа = 11;
	КурсДня = 11.4;
	ЗаписьКурса = РегистрыСведений.КурсыВалют.СоздатьМенеджерЗаписи();
	ЗаписьКурса.Период = НачалоДня(ТекущаяДатаСеанса());
	ЗаписьКурса.Валюта = Валюта;
	ЗаписьКурса.Курс = КурсДня;
	ЗаписьКурса.Записать();
	Товар = НоваяНоменклатура(Контекст, "валютный товар рабочего места закупок", Перечисления.ТипыНоменклатуры.Товар);
	ЗаказЕ = ЗаказПоставщикуРабочегоМеста(Контекст, Товар, 2, НачалоДня(ТекущаяДатаСеанса()) + 10 * 86400);
	ЗаказЕ.Дата = НачалоДня(ТекущаяДатаСеанса()) - 86400;
	ЗаказЕ.ВВалюте = Истина;
	ЗаказЕ.Валюта = Валюта;
	ЗаказЕ.КурсВалюты = КурсЗаказа;
	ЗаказЕ.ТЧТовары[0].Цена = 8;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(ЗаказЕ.ТЧТовары[0], ЗаказЕ.ЦенаВключаетНДС);
	Провести(ЗаказЕ);

	// Цена прайса ТовараВвода (100 в основной валюте) - в валюту заказа по его курсу.
	Результат = АРМ.ЗаписатьСтрокуТоваров(ЗаказЕ.Ссылка, СтрокаТоваровРабочегоМеста(Данные.ТоварВвода, 1, 0));
	Проверить(Результат.Успех, "строка прайса в валютный заказ: " + Результат.Текст);
	ТоварыЗаказа = АРМ.ДанныеЗаказа(ЗаказЕ.Ссылка).Товары;
	ПроверитьРавенство(Окр(100 / КурсЗаказа, 2), ТоварыЗаказа[ТоварыЗаказа.Количество() - 1].Цена,
		"цена прайса в валютном заказе - по курсу заказа");

	Отборы = АРМ.НовыеОтборы();
	Отборы.Товар = Товар;
	Накладная = Новый Структура("Номер, Дата", "РМЗ-ВАЛ", НачалоДня(ТекущаяДатаСеанса()));
	Итоги = АРМ.ОформитьПоступления(СтрокиКПоступлениюСценария(АРМ.СтрокиКПоступлению(Отборы)), Накладная);
	Проверить(Итоги[0].Успех, "поступление по валютному заказу: " + Итоги[0].Текст);
	Поступление = Итоги[0].Документ;
	Проверить(ЗначениеРеквизитаЗапросом(Поступление, "ВВалюте"), "поступление по валютному заказу - в валюте");
	ПроверитьРавенство(Валюта, ЗначениеРеквизитаЗапросом(Поступление, "Валюта"), "валюта поступления - валюта заказа");
	ПроверитьРавенство(КурсДня, ЗначениеРеквизитаЗапросом(Поступление, "КурсВалюты"), "курс поступления - на его дату");
	ПроверитьРавенство(8, ЗначениеРеквизитаЗапросом(Поступление, "ТЧТовары").Выгрузить()[0].Цена,
		"цена поступления - цена заказа в валюте");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Новый заказ поставщику общим путём ввода строкой в закупочном контексте: без заказа клиента, цена 100 введена.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Товар      - СправочникСсылка.Номенклатура - товар строки
//  Количество - Число - количество
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПоставщику - записанный заказ
//
Функция ЗаказВводомРабочегоМеста(Контекст, Товар, Количество)

	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента();
	ДанныеСтроки.Вид = Обработки.АРМПроизводство.ВидЗаказПоставщику();
	ДанныеСтроки.КонтекстЗаказПоставщику = Истина;
	ДанныеСтроки.Поставщик = Контекст.Контрагент;
	ДанныеСтроки.Материал = Товар;
	ДанныеСтроки.КоличествоУпаковок = Количество;
	// BSLLS:MagicNumber-off - цена прайса сценария.
	ДанныеСтроки.Цена = 100;
	// BSLLS:MagicNumber-on
	ДанныеСтроки.ЦенаИзменена = Истина;
	Результат = Обработки.АРМПроизводство.ЗаписатьСтрокуДокумента(ДанныеСтроки);
	Проверить(Результат.Успех, "заказ поставщику строкой без заказа клиента: " + Результат.Текст);
	Возврат Результат.Документ;

КонецФункции

// Параметры:
//  Товар      - СправочникСсылка.Номенклатура - товар
//  Количество - Число - количество в единицах
//  Цена       - Число - введённая цена; 0 - цену подставит запись
//
// Возвращаемое значение:
//  Структура - строка закладки «Товары», см. Обработки.АРМЗакупки.ЗаписатьСтрокуТоваров
//
Функция СтрокаТоваровРабочегоМеста(Товар, Количество, Цена)

	Строка = Новый Структура("НомерСтроки, ВерсияДанных, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Цена,
		|ЦенаИзменена");
	Строка.НомерСтроки = 0;
	Строка.ВерсияДанных = "";
	Строка.Номенклатура = Товар;
	Строка.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Строка.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	Строка.КоличествоУпаковок = Количество;
	Строка.Цена = Цена;
	Строка.ЦенаИзменена = Цена <> 0;
	Возврат Строка;

КонецФункции

// Параметры:
//  КПоступлению - ТаблицаЗначений - см. Обработки.АРМЗакупки.СтрокиКПоступлению.
//
// Возвращаемое значение:
//  Массив из Структура - все строки с остатком в количестве к приёмке, см. Обработки.АРМЗакупки.ОформитьПоступления.
//
Функция СтрокиКПоступлениюСценария(КПоступлению)

	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из КПоступлению Цикл
		Строка = Новый Структура("Заказ, КодСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок");
		ЗаполнитьЗначенияСвойств(Строка, СтрокаТаблицы);
		Строки.Добавить(Строка);
	КонецЦикла;
	Возврат Строки;

КонецФункции

// Параметры:
//  Заказ - ДокументСсылка.ЗаказПоставщику - заказ.
//
// Возвращаемое значение:
//  Число - непомеченных поступлений на основании заказа.
//
Функция ПоступленийЗаказаРабочегоМеста(Заказ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Поступления.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|ГДЕ
	|	Поступления.Основание = &Заказ
	|	И НЕ Поступления.ПометкаУдаления");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);

КонецФункции

// Параметры:
//  Заказ - ДокументСсылка.ЗаказПоставщику - заказ.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПоставщику - один заказ.
//
Функция ОдинЗаказ(Заказ)

	Заказы = Новый Массив;
	Заказы.Добавить(Заказ);
	Возврат Заказы;

КонецФункции

#КонецОбласти

#Область ПотребностьЗакупок

// «Потребность» рабочего места закупок, сборка 2.0.16.30 (docs/plans/arm-purchasing.md): пополнение до минимального
// остатка склада с оповещением и, при включённой опции «Производство», дефицит заказа на производство - «Заказать»
// создаёт заказ без основания и заказ с основанием-заказом клиента, повтор по устаревшему экрану отклоняется,
// поступление прямо под заказ клиента закрывает дефицит, сводная строка складывает источники и раскладывает «к заказу»
// с излишком в пополнение, строка без поставщика отклоняется.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПотребностьЗакупок(Контекст)

	СкладОбъект = Контекст.Склад.ПолучитьОбъект();
	СкладОбъект.ОповещатьОМинимальномОстатке = Истина;
	СкладОбъект.Записать();
	ПроверитьПополнениеПотребности(Контекст);
	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("пополнение до минимального остатка: дефицит, заказ без основания, дефицит закрыт; "
			+ "опция «Производство» выключена - производственная часть пропущена");
	КонецЕсли;
	ПроверитьПроизводствоПотребности(Контекст);
	ВеткаТендера = ПроверитьТендерПотребности(Контекст);
	Возврат РезультатСценария("пополнение до минимального остатка: дефицит, заказ без основания, дефицит закрыт; "
		+ "дефицит заказа на производство: заказ с основанием-заказом клиента, повтор по устаревшему экрану без дубля, "
		+ "поступление под заказ клиента закрывает дефицит, сводная строка складывает источники и раскладывает «к заказу» "
		+ "с излишком в пополнение; строка без поставщика отклоняется; " + ВеткаТендера);

КонецФункции

// Пополнение: товар с минимальным остатком на складе с оповещением и без остатка - строка пополнения, «Заказать» -
// заказ без основания, после него дефицит пополнения закрыт; строка без поставщика отклоняется.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПополнениеПотребности(Контекст)

	// BSLLS:MagicNumber-off - минимальный остаток 7.
	АРМ = Обработки.АРМЗакупки;
	Товар = НоваяНоменклатура(Контекст, "товар пополнения", Перечисления.ТипыНоменклатуры.Товар);
	ТоварОбъект = Товар.ПолучитьОбъект();
	ТоварОбъект.МинимальноеКоличествоХранения = 7;
	ТоварОбъект.Записать();
	Строка = СтрокаПотребностиСценария(Товар, Документы.ЗаказПокупателя.ПустаяСсылка());
	Проверить(Строка <> Неопределено, "строка пополнения товара с минимальным остатком");
	Проверить(Строка.Дефицит >= 7, "дефицит пополнения не меньше минимума склада сценария");
	ПроверитьРавенство(Строка.Нужно - Строка.НаСкладе - Строка.Заказано, Строка.Дефицит,
		"дефицит пополнения = нужно - на складе - заказано");
	БезПоставщика = ЗаказПотребностиСценария(Строка, Справочники.Контрагенты.ПустаяСсылка(), Строка.Дефицит);
	Итоги = АРМ.ЗаказатьПотребность(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(БезПоставщика));
	Проверить(Итоги.Количество() = 1 И Не Итоги[0].Успех, "строка без поставщика отклонена");
	Заказ = ЗаказПотребностиСценария(Строка, Контекст.Контрагент, Строка.Дефицит);
	Итоги = АРМ.ЗаказатьПотребность(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Заказ));
	ПроверитьРавенство(1, Итоги.Количество(), "один заказ пополнения");
	Проверить(Итоги[0].Успех, "заказ пополнения: " + Итоги[0].Текст);
	Проверить(Не ЗначениеЗаполнено(ЗначениеРеквизитаЗапросом(Итоги[0].Документ, "Основание")),
		"заказ пополнения - без заказа клиента");
	Проверить(ЗначениеРеквизитаЗапросом(Итоги[0].Документ, "Проведен"), "заказ пополнения проведён");
	Проверить(СтрокаПотребностиСценария(Товар, Документы.ЗаказПокупателя.ПустаяСсылка()) = Неопределено,
		"дефицит пополнения закрыт заказом");
	Итоги = АРМ.ЗаказатьПотребность(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Заказ));
	Проверить(Не Итоги[0].Успех, "повтор пополнения по устаревшему экрану отклонён");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Производство: дефицит заказа на производство по двум материалам; «Заказать» M2 - заказ с основанием-заказом клиента,
// повтор отклонён; поступление M1 прямо под заказ клиента уменьшает дефицит; сводная строка M1 с минимальным остатком
// складывает источники, «к заказу» с излишком раскладывается на заказ под заказ клиента и заказ пополнения.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПроизводствоПотребности(Контекст)

	// BSLLS:MagicNumber-off - количества плана E7: M1 - 20 и 15, M2 - 10; поступление M1 - 20; минимум M1 - 3, излишек 2.
	АРМ = Обработки.АРМЗакупки;
	Данные = ДанныеПотребностей(Контекст);
	ПроверитьПотребностьЗаказа(Контекст, Данные);
	СтрокаМатериала2 = СтрокаПотребностиСценария(Данные.M2, Данные.Заказ);
	Проверить(СтрокаМатериала2 <> Неопределено, "строка дефицита M2 заказа на производство");
	ПроверитьРавенство(10, СтрокаМатериала2.Дефицит, "дефицит M2 по заказу");
	ЗаказМатериала2 = ЗаказПотребностиСценария(СтрокаМатериала2, Контекст.Контрагент, СтрокаМатериала2.Дефицит);
	Итоги = АРМ.ЗаказатьПотребность(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗаказМатериала2));
	Проверить(Итоги[0].Успех, "заказ M2 под заказ клиента: " + Итоги[0].Текст);
	ПроверитьРавенство(Данные.Заказ, ЗначениеРеквизитаЗапросом(Итоги[0].Документ, "Основание"),
		"основание заказа M2 - заказ клиента");
	Проверить(СтрокаПотребностиСценария(Данные.M2, Данные.Заказ) = Неопределено, "дефицит M2 закрыт заказом");
	Итоги = АРМ.ЗаказатьПотребность(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗаказМатериала2));
	Проверить(Не Итоги[0].Успех, "повтор заказа M2 по устаревшему экрану отклонён");

	// Поступление прямо под заказ клиента: «пришло» закрывает дефицит, как «обеспечено» в стадии заказа.
	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента();
	ДанныеСтроки.Вид = Обработки.АРМПроизводство.ВидПоступление();
	ДанныеСтроки.Заказ = Данные.Заказ;
	ДанныеСтроки.Поставщик = Контекст.Контрагент;
	ДанныеСтроки.Материал = Данные.M1;
	ДанныеСтроки.КоличествоУпаковок = 20;
	Результат = Обработки.АРМПроизводство.ЗаписатьСтрокуДокумента(ДанныеСтроки);
	Проверить(Результат.Успех, "поступление M1 прямо под заказ клиента: " + Результат.Текст);
	СтрокаМатериала1 = СтрокаПотребностиСценария(Данные.M1, Данные.Заказ);
	ПроверитьРавенство(15, СтрокаМатериала1.Дефицит, "дефицит M1 после поступления под заказ клиента");

	// Сводная строка M1: заказ клиента и пополнение склада.
	Материал1 = Данные.M1.ПолучитьОбъект();
	Материал1.МинимальноеКоличествоХранения = 3;
	Материал1.Записать();
	ПоЗаказу = СтрокаПотребностиСценария(Данные.M1, Документы.ЗаказПокупателя.ПустаяСсылка());
	Проверить(ПоЗаказу <> Неопределено, "строка пополнения M1");
	Параметры = АРМ.НовыеПараметрыПотребности();
	Параметры.Товар = Данные.M1;
	Сводные = АРМ.СтрокиПотребности(Параметры).Строки;
	ПроверитьРавенство(1, Сводные.Количество(), "одна сводная строка M1");
	ПроверитьРавенство(15 + ПоЗаказу.Дефицит, Сводные[0].Дефицит, "сводный дефицит M1 - сумма источников");
	ЗаказМатериала1 = ЗаказПотребностиСценария(Сводные[0], Контекст.Контрагент, Сводные[0].Дефицит + 2);
	ЗаказМатериала1.Источник = Неопределено;
	Итоги = АРМ.ЗаказатьПотребность(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗаказМатериала1));
	ПроверитьРавенство(2, Итоги.Количество(), "сводная строка - заказ под заказ клиента и заказ пополнения");
	Для Каждого Итог Из Итоги Цикл
		Проверить(Итог.Успех, "заказ по сводной строке: " + Итог.Текст);
		Количество = ЗначениеРеквизитаЗапросом(Итог.Документ, "ТЧТовары").Выгрузить().Итог("Количество");
		Если ЗначениеЗаполнено(Итог.Источник) Тогда
			ПроверитьРавенство(15, Количество, "под заказ клиента - его дефицит");
			// M1 изделия P1 уже пришло поступлением: закупка - на изделие P2 с дефицитом (ревью кода, P1).
			ПродукцияСтрок = ЗначениеРеквизитаЗапросом(Итог.Документ, "ТЧТовары").Выгрузить().ВыгрузитьКолонку("Продукция");
			ПроверитьРавенство(Данные.P2, ПродукцияСтрок[0], "строка под заказ клиента - на изделие с дефицитом");
		Иначе
			ПроверитьРавенство(ПоЗаказу.Дефицит + 2, Количество, "в пополнение - его дефицит и излишек");
		КонецЕсли;
	КонецЦикла;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Тендер по дефициту M2 заказа на производство: «Запросить предложения» двум поставщикам - два черновика, повтор без
// дубля; «Заказать у победителя» без флажка - отказ; победитель в валюте с ценой без НДС и двумя строками материала -
// заказ поставщику в его валюте, курсе и режиме НДС с ценой предложения и количеством дефицита; повтор - отказ.
// Функциональную опцию в одном серверном вызове не переключить (tiny1C bsl-023): проверяется ветка её текущего значения,
// выключенная - отказом запроса.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Строка - какая ветка тендера проверена.
//
Функция ПроверитьТендерПотребности(Контекст)

	// BSLLS:MagicNumber-off - дефицит M2 10, строки 6 и 4, цена 4 в валюте без НДС, курс 11.
	АРМ = Обработки.АРМЗакупки;
	Данные = ДанныеПотребностей(Контекст);
	ПроверитьПотребностьЗаказа(Контекст, Данные);
	СтрокаМатериала = СтрокаПотребностиСценария(Данные.M2, Данные.Заказ);
	ЗапросТендера = Новый Структура("Источник, Номенклатура, Характеристика", Данные.Заказ, Данные.M2,
		Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ЗапросТендера.Вставить("Количество", СтрокаМатериала.Дефицит);
	Строки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗапросТендера);
	Поставщики = Новый Массив;
	Поставщики.Добавить(Контекст.Контрагент);
	Поставщики.Добавить(НовыйКонтрагент());
	Если Не АРМ.ТендерыВключены() Тогда
		Итоги = АРМ.ЗапроситьПредложения(Строки, Поставщики);
		Проверить(Итоги.Количество() = 1 И Не Итоги[0].Успех И СтрНайти(Итоги[0].Текст, "выключены") > 0,
			"без опции «Тендеры поставщиков» запрос предложений отклонён");
		Возврат "тендер: опция «Тендеры поставщиков» выключена - запрос предложений отклонён (включённая ветка не "
			+ "проверялась)";
	КонецЕсли;
	Итоги = АРМ.ЗапроситьПредложения(Строки, Поставщики);
	ПроверитьРавенство(2, Итоги.Количество(), "предложений двум поставщикам");
	Для Каждого Итог Из Итоги Цикл
		Проверить(Итог.Успех, "черновик предложения: " + Итог.Текст);
	КонецЦикла;
	Итоги = АРМ.ЗапроситьПредложения(Строки, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Контекст.Контрагент));
	Проверить(Не Итоги[0].Успех И СтрНайти(Итоги[0].Текст, "уже есть") > 0,
		"повтор запроса тому же поставщику - без дубля: " + Итоги[0].Текст);
	Предложения = АРМ.ПредложенияТовара(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Заказ), Данные.M2,
		Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ПроверитьРавенство(2, Предложения.Количество(), "предложения M2 по заказу");
	Предложение = Предложения.Найти(Контекст.Контрагент, "Поставщик").Предложение;

	// Цены предложения: валюта, без НДС.
	Основная = РаботаСВалютами.ОсновнаяВалюта();
	Валюта = ?(Основная = Справочники.Валюты.Евро, Справочники.Валюты.ДолларСША, Справочники.Валюты.Евро);
	ЗаписьКурса = РегистрыСведений.КурсыВалют.СоздатьМенеджерЗаписи();
	ЗаписьКурса.Период = НачалоДня(ТекущаяДатаСеанса());
	ЗаписьКурса.Валюта = Валюта;
	ЗаписьКурса.Курс = 11;
	ЗаписьКурса.Записать();
	ПредложениеОбъект = Предложение.ПолучитьОбъект();
	ПредложениеОбъект.ВВалюте = Истина;
	ПредложениеОбъект.Валюта = Валюта;
	ПредложениеОбъект.КурсВалюты = 11;
	ПредложениеОбъект.ЦенаВключаетНДС = Ложь;
	// Два строки одного материала (6 + 4): строки предложения сворачиваются по товару - без перезаказа (P1-1).
	Первая = ПредложениеОбъект.ТЧТовары[0];
	Вторая = ПредложениеОбъект.ТЧТовары.Добавить();
	ЗаполнитьЗначенияСвойств(Вторая, Первая);
	Вторая.КодСтроки = 2;
	Первая.КоличествоУпаковок = 6;
	Первая.Количество = 6;
	Вторая.КоличествоУпаковок = СтрокаМатериала.Дефицит - 6;
	Вторая.Количество = СтрокаМатериала.Дефицит - 6;
	// Ставка НДС предложения отличается от карточки - заказ получает ставку предложения (T26).
	СтавкаПредложения = ДругаяСтавкаНДС(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.M2, "СтавкаНДС"));
	Для Каждого СтрокаПредложения Из ПредложениеОбъект.ТЧТовары Цикл
		СтрокаПредложения.Цена = 4;
		Если ЗначениеЗаполнено(СтавкаПредложения) Тогда
			СтрокаПредложения.СтавкаНДС = СтавкаПредложения;
		КонецЕсли;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(СтрокаПредложения, Ложь);
	КонецЦикла;
	ПредложениеОбъект.Записать();

	Итог = АРМ.ЗаказатьУПобедителя(Предложение);
	Проверить(Не Итог.Успех И СтрНайти(Итог.Текст, "победител") > 0,
		"заказ у предложения без флажка «Победитель» отклонён: " + Итог.Текст);
	Проверить(АРМ.ВыбратьПобедителя(Предложение).Успех, "выбор победителя");
	СтрокаТендера = СтрокаПотребностиСценария(Данные.M2, Данные.Заказ);
	Проверить(СтрНайти(СтрокаТендера.Тендер, Строка(Контекст.Контрагент)) > 0,
		"колонка «Тендер» показывает победителя: " + СтрокаТендера.Тендер);
	Итог = АРМ.ЗаказатьУПобедителя(Предложение);
	Проверить(Итог.Успех, "заказ у победителя: " + Итог.Текст);
	ПроверитьРавенство(Данные.Заказ, ЗначениеРеквизитаЗапросом(Итог.Документ, "Основание"),
		"заказ у победителя - под заказ клиента");
	ПроверитьРавенство(Валюта, ЗначениеРеквизитаЗапросом(Итог.Документ, "Валюта"), "валюта заказа - валюта предложения");
	Проверить(Не ЗначениеРеквизитаЗапросом(Итог.Документ, "ЦенаВключаетНДС"), "режим НДС заказа - предложения");
	ПроверитьРавенство(11, ЗначениеРеквизитаЗапросом(Итог.Документ, "КурсВалюты"), "курс заказа - на его дату");
	ТоварыЗаказа = ЗначениеРеквизитаЗапросом(Итог.Документ, "ТЧТовары").Выгрузить();
	ПроверитьРавенство(4, ТоварыЗаказа[0].Цена, "цена заказа - цена предложения");
	ПроверитьРавенство(СтрокаМатериала.Дефицит, ТоварыЗаказа.Итог("Количество"), "количество заказа - дефицит");
	Если ЗначениеЗаполнено(СтавкаПредложения) Тогда
		ПроверитьРавенство(СтавкаПредложения, ТоварыЗаказа[0].СтавкаНДС, "ставка НДС заказа - из предложения (T26)");
	КонецЕсли;
	Итог = АРМ.ЗаказатьУПобедителя(Предложение);
	Проверить(Не Итог.Успех, "повтор заказа у победителя - дефицита нет");
	// Заказ на основании того же предложения: дефицита нет - строк нет (T27).
	НаОсновании = Документы.ЗаказПоставщику.СоздатьДокумент();
	НаОсновании.Заполнить(Предложение);
	ПолучитьСообщенияПользователю(Истина);
	ПроверитьРавенство(0, НаОсновании.ТЧТовары.Количество(), "заказ на основании предложения без дефицита - без строк (T27)");
	// BSLLS:MagicNumber-on
	Возврат "тендер: предложения двум поставщикам, повтор без дубля, колонка «Тендер», заказ у победителя в его валюте, "
		+ "курсе и режиме НДС с ценой предложения на дефицит (две строки материала свёрнуты), повтор и заказ без "
		+ "победителя отклонены";

КонецФункции

// Любая ставка НДС, кроме данной.
//
// Параметры:
//  Ставка - СправочникСсылка.СтавкиНДС - ставка карточки.
//
// Возвращаемое значение:
//  СправочникСсылка.СтавкиНДС, Неопределено - другая ставка; нет - Неопределено.
//
Функция ДругаяСтавкаНДС(Ставка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ставки.Ссылка КАК Ставка
	|ИЗ
	|	Справочник.СтавкиНДС КАК Ставки
	|ГДЕ
	|	Ставки.Ссылка <> &Ставка
	|	И НЕ Ставки.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ставка", Ставка);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ставка, Неопределено);

КонецФункции

// Параметры:
//  Товар    - СправочникСсылка.Номенклатура - товар.
//  Источник - ДокументСсылка.ЗаказПокупателя - заказ клиента; пустая - пополнение.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - строка «Потребности» по заказу клиента с дефицитом; нет - Неопределено.
//
Функция СтрокаПотребностиСценария(Товар, Источник)

	Параметры = Обработки.АРМЗакупки.НовыеПараметрыПотребности();
	Параметры.Товар = Товар;
	Параметры.Группировка = Обработки.АРМЗакупки.ГруппировкаПоЗаказу();
	Для Каждого СтрокаПотребности Из Обработки.АРМЗакупки.СтрокиПотребности(Параметры).Строки Цикл
		Если СтрокаПотребности.Источник = Источник Тогда
			Возврат СтрокаПотребности;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Параметры:
//  СтрокаПотребности - СтрокаТаблицыЗначений - см. Обработки.АРМЗакупки.СтрокиПотребности.
//  Поставщик         - СправочникСсылка.Контрагенты - поставщик заказа.
//  Количество        - Число - к заказу.
//
// Возвращаемое значение:
//  Структура - строка «Заказать», см. Обработки.АРМЗакупки.ЗаказатьПотребность.
//
Функция ЗаказПотребностиСценария(СтрокаПотребности, Поставщик, Количество)

	Строка = Новый Структура("Источник, Номенклатура, Характеристика");
	ЗаполнитьЗначенияСвойств(Строка, СтрокаПотребности);
	Строка.Вставить("Поставщик", Поставщик);
	Строка.Вставить("Количество", Количество);
	Строка.Вставить("ДефицитНаЭкране", СтрокаПотребности.Дефицит);
	Возврат Строка;

КонецФункции

#КонецОбласти

#Область АРМЗакупки

// Рабочее место производства, закупки в строках (E12.2): заказы поставщику и поступления строками заказа на производство
// в работе через модуль менеджера обработки - запись, проведение, распределение по двум изделиям, строки заказа
// поставщику, запреты, «Статус», удаление.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАРМЗакупки(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// Склад нового поступления - из настроек пользователя или основного места хранения, как в форме документа.
	Если Не ЗначениеЗаполнено(Константы.ОсновноеМестоХранения.Получить()) Тогда
		Константы.ОсновноеМестоХранения.Установить(Контекст.Склад);
	КонецЕсли;
	Данные = ДанныеАРМЗакупок(Контекст);
	ПроверитьЗапретыЗакупокАРМ(Контекст, Данные);
	ПроверитьЗаказыПоставщикуАРМ(Контекст, Данные);
	ПроверитьПоступленияАРМ(Контекст, Данные);
	ПроверитьСтатусЗакупокАРМ(Контекст, Данные);

	Возврат РезультатСценария("заказ поставщику строкой: новый проведённый документ без явной продукции с распределением "
		+ "«Заказано» на два изделия, вторая строка в тот же документ, правка количества с перепроведением, устаревшая "
		+ "версия; поступление по строке заказа поставщику с кодом строки и накладной, без заказа поставщику - по заказу; "
		+ "строки заказа поставщику для выбора с остатком; запреты: черновик заказа, другой поставщик, нулевое количество, "
		+ "строка чужого заказа поставщику, повтор строки основания, уменьшение и удаление строки с поступлениями; "
		+ "документы для выбора; «Статус» и правка черновика без проведения; удаление строк с пометкой документа");

КонецФункции

// Заказ на производство в работе: изделие P1 - 10 шт., P2 - 5 шт., у обоих материал M (2 и 3 на единицу).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - Заказ, P2, M, Потребность (35) и документы по мере создания.
//
Функция ДанныеАРМЗакупок(Контекст)

	// BSLLS:MagicNumber-off - количества сценария: 10 и 5 изделий, расход 2 и 3.
	Данные = Новый Структура;
	Данные.Вставить("P2", НоваяНоменклатура(Контекст, "продукция АРМ 2", Перечисления.ТипыНоменклатуры.Продукция));
	Данные.Вставить("M", Контекст.Сырье);
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, 10, Контекст.Числа.ЦенаПродажи);
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.P2, 5, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M, 2);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[2], Данные.M, 3);
	Провести(Заказ);
	Данные.Вставить("Заказ", Заказ.Ссылка);
	Данные.Вставить("Потребность", 35);
	Данные.Вставить("ЗаказПоставщику", Документы.ЗаказПоставщику.ПустаяСсылка());
	Данные.Вставить("РезультатЗаказа", Неопределено);
	Возврат Данные;
	// BSLLS:MagicNumber-on

КонецФункции

// Отказы без записи: черновик заказа на производство, пустой поставщик, нулевое количество.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМЗакупок
//
Процедура ПроверитьЗапретыЗакупокАРМ(Контекст, Данные)

	АРМ = Обработки.АРМПроизводство;
	Черновик = ЗаказКлиентаСценария(Контекст);
	Черновик.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Черновик.Записать(РежимЗаписиДокумента.Запись);
	НаЧерновик = СтрокаЗакупкиАРМ(Контекст, Черновик.Ссылка, АРМ.ВидЗаказПоставщику(), Данные.M, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(НаЧерновик)), "по черновику заказа закупки не вводятся");
	БезПоставщика = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 1);
	БезПоставщика.Поставщик = Справочники.Контрагенты.ПустаяСсылка();
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(БезПоставщика)), "строка без поставщика не записывается");
	БезКоличества = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 0);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(БезКоличества)), "строка без количества не записывается");
	Допустимая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 1);
	ТекстЗапрета = АРМ.ТекстЗапретаСтрокиДокумента(Допустимая);
	Проверить(ПустаяСтрока(ТекстЗапрета), "строка поступления по заказу в работе допустима: " + ТекстЗапрета);

КонецПроцедуры

// Заказ поставщику строками: новый документ, распределение на два изделия, вторая строка, правка, устаревшая версия.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМЗакупок
//
Процедура ПроверитьЗаказыПоставщикуАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария: весь дефицит 35, правка до 30, строка товара 1.
	АРМ = Обработки.АРМПроизводство;
	Первая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, Данные.Потребность);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Первая, "строка заказа поставщику создаёт документ");
	Проверить(Результат.Проведен, "новый заказ поставщику проведён сразу");
	ЗаказПоставщику = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Данные.Заказ, ЗаказПоставщику.Основание, "основание заказа поставщику - заказ на производство");
	ПроверитьРавенство(Контекст.Контрагент, ЗаказПоставщику.Контрагент, "поставщик заказа из строки");
	Проверить(Не ЗначениеЗаполнено(ЗаказПоставщику.ТЧТовары[0].Продукция), "продукция строки не задана - распределяет регистр");
	ПроверитьРавенство(0, ДефицитМатериалаАРМ(Данные), "весь дефицит двух изделий заказан одной строкой");
	ПроверитьРавенство(2, ЗаказаноПоИзделиямАРМ(Данные).Количество(), "«Заказано» распределено на оба изделия");

	Вторая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Контекст.Товар, 1);
	Вторая.Документ = Результат.Документ;
	Результат = ЗаписьСтрокиЗакупкиАРМ(Вторая, "вторая строка того же поставщика");
	ПроверитьРавенство(ЗаказПоставщику.Ссылка, Результат.Документ, "вторая строка в тот же заказ поставщику");
	ПроверитьРавенство(2, Результат.СтрокиДокумента.Количество(), "в заказе поставщику две строки");

	Правка = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 30);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Правка, Результат, 1);
	Устаревшая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 20);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Устаревшая, Результат, 1);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Правка, "правка количества строки заказа поставщику");
	Проверить(Результат.Проведен, "заказ поставщику перепроведён после правки");
	ПроверитьРавенство(5, ДефицитМатериалаАРМ(Данные), "дефицит после уменьшения заказанного");
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Устаревшая);
	Проверить(Не Отказ.Успех И Отказ.Перечитать, "правка по устаревшей версии документа отклоняется с перечитыванием");

	ДругойПоставщик = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 1);
	ДругойПоставщик.Поставщик = НовыйКонтрагент();
	ДругойПоставщик.Документ = Результат.Документ;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ДругойПоставщик)), "в документ другого поставщика строка не пишется");
	Вчерашний = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Контекст.Товар, 1);
	РезультатВчерашнего = ЗаписьСтрокиЗакупкиАРМ(Вчерашний, "заказ поставщику товара");
	ВчерашнийОбъект = РезультатВчерашнего.Документ.ПолучитьОбъект();
	ВчерашнийОбъект.Дата = НачалоДня(ТекущаяДатаСеанса()) - 1;
	ВчерашнийОбъект.Записать(РежимЗаписиДокумента.Запись);
	ВоВчерашний = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Контекст.Товар, 1);
	ВоВчерашний.Документ = РезультатВчерашнего.Документ;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ВоВчерашний)), "новая строка во вчерашний документ не пишется");
	Выбор = АРМ.ДокументыСтрокиДляВыбора(СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 1));
	Проверить(Выбор.НайтиПоЗначению(РезультатВчерашнего.Документ) = Неопределено, "вчерашний документ не в списке выбора");
	Проверить(Выбор.НайтиПоЗначению(Результат.Документ) <> Неопределено, "сегодняшний заказ поставщику в списке выбора");
	Данные.ЗаказПоставщику = Результат.Документ;
	Данные.РезультатЗаказа = Результат;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Поступления строками: по строке заказа поставщику, без заказа поставщику, запреты строки с поступлениями.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМЗакупок
//
Процедура ПроверитьПоступленияАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария: заказано 30, пришло 30, без заказа 2, уменьшение до 20.
	АРМ = Обработки.АРМПроизводство;
	СтрокиОснований = АРМ.СтрокиЗаказовПоставщикуДляВыбора(Данные.Заказ, Контекст.Контрагент, Данные.M,
		Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ПроверитьРавенство(1, СтрокиОснований.Количество(), "строка заказа поставщику с остатком к поступлению");
	Основание = СтрокиОснований[0].Значение;
	ПроверитьРавенство(30, Основание.КоличествоУпаковок, "остаток строки заказа поставщику к поступлению");
	БезВыбораСтроки = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 30);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(БезВыбораСтроки)),
		"поступление без заказа поставщику при открытой строке заказа отклоняется");

	Приход = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 30);
	Приход.ЗаказПоставщику = Основание.ЗаказПоставщику;
	Приход.КодСтрокиОснования = Основание.КодСтроки;
	Приход.НомерВходящегоДокумента = "АРМ-1";
	Приход.ДатаВходящегоДокумента = НачалоДня(Контекст.Дата);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Приход, "поступление по строке заказа поставщику");
	Проверить(Результат.Проведен, "поступление проведено сразу");
	Поступление = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Данные.ЗаказПоставщику, Поступление.Основание, "основание поступления - заказ поставщику");
	ПроверитьРавенство(Основание.КодСтроки, Поступление.ТЧТовары[0].КодСтроки, "код строки поступления - код строки заказа");
	ПроверитьРавенство("АРМ-1", Поступление.НомерВходящегоДокумента, "номер накладной поставщика в шапке");
	СтрокиОснований = АРМ.СтрокиЗаказовПоставщикуДляВыбора(Данные.Заказ, Контекст.Контрагент, Данные.M,
		Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ПроверитьРавенство(0, СтрокиОснований.Количество(), "пришедшая строка из выбора уходит");
	ОстатокМатериала = 0;
	Для Каждого СтрокаОстатка Из РегистрыНакопления.ПотребностиПроизводства.ОстатокКПоступлению(Данные.Заказ) Цикл
		Если СтрокаОстатка.Материал = Данные.M Тогда
			ОстатокМатериала = ОстатокМатериала + СтрокаОстатка.Количество;
		КонецЕсли;
	КонецЦикла;
	ПроверитьРавенство(0, ОстатокМатериала, "после поступления заказанного к поступлению по материалу ничего не осталось");
	ПроверитьРавенство(2, ПришлоПоИзделиямАРМ(Данные).Количество(), "«Пришло» распределено на оба изделия");

	Повтор = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 1);
	Повтор.ЗаказПоставщику = Основание.ЗаказПоставщику;
	Повтор.КодСтрокиОснования = Основание.КодСтроки;
	Повтор.Документ = Результат.Документ;
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Повтор);
	Проверить(Не Отказ.Успех И Не Отказ.Перечитать, "вторая строка поступления по той же строке заказа отклоняется: "
		+ Отказ.Текст);

	Уменьшение = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 20);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Уменьшение, Данные.РезультатЗаказа, 1);
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Уменьшение);
	Проверить(Не Отказ.Успех И Не Отказ.Перечитать, "строка заказа поставщику не уменьшается ниже пришедшего: "
		+ Отказ.Текст);
	Удаление = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидЗаказПоставщику(), Данные.M, 30);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Удаление, Данные.РезультатЗаказа, 1);
	ОтказУдаления = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Не ОтказУдаления.Успех И Не ОтказУдаления.Перечитать,
		"строка заказа поставщику с поступлениями не удаляется: " + ОтказУдаления.Текст);

	ЧужаяСтрока = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 1);
	ЧужаяСтрока.ЗаказПоставщику = Основание.ЗаказПоставщику;
	ЧужаяСтрока.КодСтрокиОснования = Основание.КодСтроки;
	ЧужаяСтрока.Поставщик = НовыйКонтрагент();
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ЧужаяСтрока)), "строка заказа поставщику другого поставщика отклоняется");

	БезЗаказа = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 2);
	Результат = ЗаписьСтрокиЗакупкиАРМ(БезЗаказа, "поступление без заказа поставщику");
	ПроверитьРавенство(Данные.Заказ, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат.Документ, "Основание"),
		"основание поступления без заказа поставщику - заказ на производство");
	Данные.Вставить("Поступление", Результат.Документ);
	Данные.Вставить("РезультатПоступления", Результат);
	ПроверитьНулевуюЦенуПрайсаАРМ(Результат.Документ);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «Статус» документов закупки, правка черновика без проведения, удаление всех строк с пометкой.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьПоступленияАРМ
//
Процедура ПроверитьСтатусЗакупокАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - правка строки поступления до 3.
	АРМ = Обработки.АРМПроизводство;
	ДокументыСтатуса = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Поступление);
	ЗаказыСтатуса = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.ЗаказПоставщику);
	Отказ = АРМ.ИзменитьСтатусДокументовСтрок(ЗаказыСтатуса, АРМ.ДействиеВЧерновик(), Данные.Заказ)[0];
	Проверить(Не Отказ.Успех, "заказ поставщику с поступлениями в черновик не возвращается");
	ЧужойЗаказ = АРМ.ИзменитьСтатусДокументовСтрок(ДокументыСтатуса, АРМ.ДействиеВЧерновик(),
		Документы.ЗаказПокупателя.ПустаяСсылка())[0];
	Проверить(Не ЧужойЗаказ.Успех, "«Статус» не меняет документ другого заказа");
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(ДокументыСтатуса, АРМ.ДействиеВЧерновик(), Данные.Заказ)[0];
	Проверить(Итог.Успех, "«В черновик» отменяет проведение поступления: " + Итог.Текст);
	Версия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Поступление, "ВерсияДанных");
	Правка = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 3);
	Правка.Документ = Данные.Поступление;
	Правка.НомерСтроки = 1;
	Правка.ВерсияДанных = Версия;
	Результат = ЗаписьСтрокиЗакупкиАРМ(Правка, "правка строки черновика поступления");
	Проверить(Не Результат.Проведен, "правка черновика его не проводит");
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(ДокументыСтатуса, АРМ.ДействиеВРаботу(), Данные.Заказ)[0];
	Проверить(Итог.Успех, "«Провести» проводит поступление: " + Итог.Текст);
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Поступление, "Проведен"), "поступление проведено «Статусом»");

	Удаление = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПоступление(), Данные.M, 3);
	Удаление.Документ = Данные.Поступление;
	Удаление.НомерСтроки = 1;
	Удаление.ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Поступление, "ВерсияДанных");
	Итог = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Итог.Успех И Итог.ДокументПомечен, "удаление единственной строки помечает поступление: " + Итог.Текст);
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Поступление, "ПометкаУдаления"), "поступление помечено");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Поступление без цены (оператор без сумм, прайса нет) не пишет нулевую цену в прайс поставщика (решение владельца
// 2026-09-15): ноль перекрыл бы цены других поставщиков.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - проведённое поступление рабочего места.
//
Процедура ПроверитьНулевуюЦенуПрайсаАРМ(Поступление)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Строк,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Товары.Цена = 0
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК БезЦены
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Поступление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Нулевых
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатурыПоставщиков КАК Цены
	|ГДЕ
	|	Цены.Регистратор = &Поступление
	|	И Цены.Цена = 0");
	Запрос.УстановитьПараметр("Поступление", Поступление);
	Пакет = Запрос.ВыполнитьПакет();
	Строки = Пакет[0].Выгрузить()[0];
	Проверить(Строки.БезЦены > 0, "у поступления рабочего места без прайса строка без цены");
	ПроверитьРавенство(0, Пакет[1].Выгрузить()[0].Нулевых, "нулевая цена поступления в прайс поставщика не записана");

КонецПроцедуры

// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  Вид        - Строка - вид документа закупки
//  Материал   - СправочникСсылка.Номенклатура - материал
//  Количество - Число - количество упаковок
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента
//
Функция СтрокаЗакупкиАРМ(Контекст, Заказ, Вид, Материал, Количество)

	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента();
	ДанныеСтроки.Вид = Вид;
	ДанныеСтроки.Заказ = Заказ;
	ДанныеСтроки.Поставщик = Контекст.Контрагент;
	ДанныеСтроки.Материал = Материал;
	ДанныеСтроки.КоличествоУпаковок = Количество;
	Возврат ДанныеСтроки;

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента
//  Результат    - Структура - результат записи строки закупки с СтрокиДокумента
//  НомерСтроки  - Число - номер строки документа
//
Процедура ЗаполнитьКлючСтрокиЗакупкиАРМ(ДанныеСтроки, Результат, НомерСтроки)

	СтрокаДокумента = Результат.СтрокиДокумента[НомерСтроки - 1];
	ДанныеСтроки.Документ = СтрокаДокумента.Документ;
	ДанныеСтроки.НомерСтроки = СтрокаДокумента.НомерСтроки;
	ДанныеСтроки.ВерсияДанных = СтрокаДокумента.ВерсияДанных;

КонецПроцедуры

// Параметры:
//  ДанныеСтроки - Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента
//  Описание     - Строка - что проверяется
//
// Возвращаемое значение:
//  Структура - результат записи строки закупки, проверенный на успех
//
Функция ЗаписьСтрокиЗакупкиАРМ(ДанныеСтроки, Описание)

	Результат = Обработки.АРМПроизводство.ЗаписатьСтрокуДокумента(ДанныеСтроки);
	Проверить(Результат.Успех, Описание + ": " + Результат.Текст);
	Возврат Результат;

КонецФункции

// Параметры:
//  Данные - Структура - см. ДанныеАРМЗакупок
//
// Возвращаемое значение:
//  Число - дефицит материала сценария по заказу.
//
Функция ДефицитМатериалаАРМ(Данные)

	Дефицит = 0;
	Для Каждого Строка Из РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа(Данные.Заказ) Цикл
		Если Строка.Материал = Данные.M Тогда
			Дефицит = Дефицит + Строка.Количество;
		КонецЕсли;
	КонецЦикла;
	Возврат Дефицит;

КонецФункции

// Параметры:
//  Данные - Структура - см. ДанныеАРМЗакупок
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - изделия с ненулевым «Заказано» материала сценария.
//
Функция ЗаказаноПоИзделиямАРМ(Данные)

	Возврат ИзделияСОстаткомАРМ(Данные, "ЗаказаноОстаток");

КонецФункции

// Параметры:
//  Данные - Структура - см. ДанныеАРМЗакупок
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - изделия с ненулевым «Пришло» материала сценария.
//
Функция ПришлоПоИзделиямАРМ(Данные)

	Возврат ИзделияСОстаткомАРМ(Данные, "ПришлоОстаток");

КонецФункции

// Параметры:
//  Данные       - Структура - см. ДанныеАРМЗакупок
//  ИмяОстатка   - Строка - «ЗаказаноОстаток» или «ПришлоОстаток».
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - изделия с положительным остатком ресурса.
//
Функция ИзделияСОстаткомАРМ(Данные, ИмяОстатка)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Продукция КАК Продукция
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства.Остатки(, Заказ = &Заказ И Материал = &Материал) КАК Остатки
	|ГДЕ
	|	Остатки.ЗаказаноОстаток > 0");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗаказаноОстаток", ИмяОстатка);
	Запрос.УстановитьПараметр("Заказ", Данные.Заказ);
	Запрос.УстановитьПараметр("Материал", Данные.M);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Продукция");

КонецФункции

#КонецОбласти

#Область АРМВыпускОтгрузка

// Рабочее место производства, выпуск и отгрузки в строках (E12.3a): выпуски и реализации строками заказа на производство
// в работе через модуль менеджера обработки - запись с материалами по карте, правка, запреты, отгрузка с ценой заказа и
// автовыпуском, «Статус», правило выпуска после отгрузки, удаление, заполнение выпуска по заказу, отказ проведения.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАРМВыпускОтгрузка(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Данные = ДанныеАРМВыпускаОтгрузки(Контекст);
	ПроверитьВыпускАРМ(Контекст, Данные);
	ПроверитьЗапретыВыпускаАРМ(Контекст, Данные);
	ПроверитьОтгрузкуАРМ(Контекст, Данные);
	ПроверитьСтатусОтгрузкиАРМ(Контекст, Данные);
	ПроверитьВыпускПослеОтгрузкиАРМ(Контекст, Данные);
	ПроверитьЗаполнениеВыпускаПоЗаказуАРМ(Данные);
	// Отказ проведения портит транзакцию сценария: последним шагом.
	ПроверитьОтказОтгрузкиАРМ(Контекст, Данные);

	Возврат РезультатСценария("выпуск строкой: новый проведённый документ по заказу, шапка по строке, материалы по карте, "
		+ "правка количества с перепроведением, устаревшая версия; запреты: продукция не из заказа, продукция без карты, "
		+ "вчерашний выпуск; отгрузка строкой с ценой заказа, вторая строка с автовыпуском, автовыпуск только для чтения и "
		+ "не документ строки; «Статус» реализации с автовыпуском; выпуск после отгрузки запрещает её правку и выбор; "
		+ "удаление строки выпуска с пометкой; заполнение выпуска по заказу; отказ проведения отгрузки");

КонецФункции

// Заказ на производство в работе: продукция контекста 10 шт. (сырьё 2 на единицу, карта контекста) и товар контекста без
// карты; сырьё 30 на складе новых документов, константа автовыпуска включена.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - Заказ, P, БезКарты, M, Склад и документы по мере создания.
//
Функция ДанныеАРМВыпускаОтгрузки(Контекст)

	// BSLLS:MagicNumber-off - количества сценария: заказ 10 и 1, расход 2, сырьё 30 по 10.
	Склад = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновноеМестоХранения.Получить();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Контекст.Склад;
		Константы.ОсновноеМестоХранения.Установить(Склад);
	КонецЕсли;
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	Данные = Новый Структура;
	Данные.Вставить("P", Контекст.Продукция);
	// Строка товара заказа без материалов - позиция без карты.
	Данные.Вставить("БезКарты", Контекст.Товар);
	Данные.Вставить("M", Контекст.Сырье);
	Данные.Вставить("Склад", Склад);
	Закупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Закупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.ЦенаВключаетНДС = Истина;
	Закупка.Валюта = Контекст.Валюта;
	Закупка.КурсВалюты = 1;
	Закупка.МестоХранения = Склад;
	ИмяТоваров = "ТЧТовары";
	ДобавитьСтрокуТоваров(Контекст, Закупка, ИмяТоваров, Данные.M, 30, 10);
	Провести(Закупка);
	Данные.Вставить("ДатаЗакупки", Закупка.Дата);

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, ИмяТоваров, Данные.P, 10, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M, 2);
	// Скидка строки заказа переходит в отгрузку и не теряется при ручной цене.
	Заказ.ТЧТовары[1].СкидкаНаЦену = Контекст.Числа.ЦенаПродажи / 10;
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Заказ.ТЧТовары[1], Заказ.ЦенаВключаетНДС, "Цена");
	Провести(Заказ);
	Данные.Вставить("Заказ", Заказ.Ссылка);
	Данные.Вставить("Выпуск", Документы.ВыпускПродукции.ПустаяСсылка());
	Данные.Вставить("Реализация", Документы.РеализацияТоваровУслуг.ПустаяСсылка());
	Возврат Данные;
	// BSLLS:MagicNumber-on

КонецФункции

// Выпуск строкой: новый документ, шапка и материалы, правка количества, устаревшая версия.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМВыпускаОтгрузки
//
Процедура ПроверитьВыпускАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария: выпуск 4, правка до 5, расход 2.
	АРМ = Обработки.АРМПроизводство;
	Выбор = АРМ.ПродукцияЗаказаДляВыбора(Данные.Заказ, АРМ.ВидВыпуск());
	Проверить(Выбор.Количество() >= 2, "продукция заказа для выбора в строке выпуска");
	Первая = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 4);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Первая, "строка выпуска создаёт документ");
	Проверить(Результат.Проведен, "новый выпуск проведён сразу");
	Выпуск = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Данные.Заказ, Выпуск.Основание, "основание выпуска - заказ на производство");
	ПроверитьРавенство(Данные.P, Выпуск.Номенклатура, "шапка выпуска повторяет строку");
	ПроверитьРавенство(4, Выпуск.КоличествоУпаковок, "количество шапки выпуска");
	ПроверитьРавенство(1, Выпуск.ТЧТовары.Количество(), "материалы выпуска по карте");
	ПроверитьРавенство(8, Выпуск.ТЧТовары[0].Количество, "расход сырья по карте на 4 шт.");
	ПроверитьРавенство(4, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "«Выпущено» по заказу после выпуска строкой");

	Правка = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 5);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Правка, Результат, 1);
	Устаревшая = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 6);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Устаревшая, Результат, 1);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Правка, "правка количества строки выпуска");
	Проверить(Результат.Проведен, "выпуск перепроведён после правки");
	Выпуск = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(10, Выпуск.ТЧТовары[0].Количество, "материалы пересчитаны по карте на 5 шт.");
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Устаревшая);
	Проверить(Не Отказ.Успех И Отказ.Перечитать, "правка выпуска по устаревшей версии отклоняется с перечитыванием");
	Выбор = АРМ.ДокументыСтрокиДляВыбора(СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1));
	Проверить(Выбор.НайтиПоЗначению(Результат.Документ) <> Неопределено, "сегодняшний выпуск в списке выбора");

	// Розничная цена шапки не переходит к строке, оставшейся одной.
	Выпуск.ЦенаРозничная = 50;
	Провести(Выпуск);
	ВтораяСтрока = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
	ВтораяСтрока.Документ = Выпуск.Ссылка;
	Результат = ЗаписьСтрокиЗакупкиАРМ(ВтораяСтрока, "вторая строка выпуска");
	ПроверитьРавенство(2, Результат.СтрокиДокумента.Количество(), "в выпуске две строки продукции");
	ПроверитьРавенство(12, Выпуск.Ссылка.ТЧТовары[0].Количество, "материалы по картам двух строк");
	Удаление = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Удаление, Результат, 2);
	Итог = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Итог.Успех И Не Итог.ДокументПомечен, "удаление второй строки выпуска: " + Итог.Текст);
	Выпуск = Выпуск.Ссылка.ПолучитьОбъект();
	ПроверитьРавенство(0, Выпуск.ЦенаРозничная, "переход к одной строке обнуляет розничную цену шапки");
	ПроверитьРавенство(10, Выпуск.ТЧТовары[0].Количество, "материалы пересчитаны после удаления строки");

	// Автовыпуск видит выпуски раньше реализации: выпуск сценария отодвигается от будущей отгрузки.
	Выпуск.Дата = Макс(НачалоДня(ТекущаяДатаСеанса()), Данные.ДатаЗакупки + 1);
	Провести(Выпуск);
	Данные.Выпуск = Выпуск.Ссылка;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Отказы строки выпуска: продукция не из заказа, продукция без карты, новая строка во вчерашний выпуск.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМВыпускаОтгрузки
//
Процедура ПроверитьЗапретыВыпускаАРМ(Контекст, Данные)

	АРМ = Обработки.АРМПроизводство;
	НеИзЗаказа = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Контекст.Сырье, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(НеИзЗаказа)), "продукция не из заказа не выпускается");
	БезКарты = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.БезКарты, 1);
	БезКарты.Документ = Данные.Выпуск;
	Отказ = АРМ.ЗаписатьСтрокуДокумента(БезКарты);
	Проверить(Не Отказ.Успех И Не Отказ.Перечитать, "продукция без карты в выпуск не пишется: " + Отказ.Текст);
	ПроверитьРавенство(1, Данные.Выпуск.ТЧГотоваяПродукция.Количество(), "выпуск после отказа не изменён");

	Вчерашний = НовыйДокумент(Контекст, "ВыпускПродукции");
	Вчерашний.Основание = Данные.Заказ;
	Вчерашний.Дата = НачалоДня(ТекущаяДатаСеанса()) - 1;
	Вчерашний.Номенклатура = Данные.P;
	Вчерашний.КоличествоУпаковок = 1;
	Вчерашний.Количество = 1;
	Вчерашний.МестоХраненияОприходование = Данные.Склад;
	Вчерашний.Записать(РежимЗаписиДокумента.Запись);
	ВоВчерашний = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
	ВоВчерашний.Документ = Вчерашний.Ссылка;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ВоВчерашний)), "новая строка во вчерашний выпуск не пишется");
	Вчерашний.УстановитьПометкуУдаления(Истина);

КонецПроцедуры

// Отгрузка строками: новая реализация с ценой заказа, вторая строка с автовыпуском.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМВыпускаОтгрузки
//
Процедура ПроверитьОтгрузкуАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария: отгрузка 3 и 4 при выпущенных 5, автовыпуск 2.
	АРМ = Обработки.АРМПроизводство;
	Первая = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 3);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Первая, "строка отгрузки создаёт реализацию");
	Проверить(Результат.Проведен, "новая реализация проведена сразу");
	Реализация = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Данные.Заказ, Реализация.Основание, "основание реализации - заказ на производство");
	ПроверитьРавенство(Контекст.Контрагент, Реализация.Контрагент, "клиент реализации - клиент заказа");
	ПроверитьРавенство(Контекст.ДоговорПокупателя, Реализация.Договор, "договор реализации - договор заказа");
	ПроверитьРавенство(Контекст.Числа.ЦенаПродажи, Реализация.ТЧТовары[0].Цена, "цена строки отгрузки - цена заказа");
	ПроверитьРавенство(3 * Контекст.Числа.ЦенаПродажи, Реализация.ТЧТовары[0].Сумма, "сумма строки отгрузки");
	ПроверитьРавенство(10, Реализация.ТЧТовары[0].ПроцентСкидки, "скидка строки отгрузки - скидка строки заказа");
	ПроверитьРавенство(0, ЧислоАвтовыпусков(Реализация.Ссылка), "отгрузка в пределах выпущенного без автовыпуска");
	ПроверитьРавенство(3, ВыполнениеПродукцииАРМ(Данные, Данные.P).Отгружено, "«Отгружено» по заказу");

	Вторая = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 4);
	Вторая.Документ = Реализация.Ссылка;
	Результат = ЗаписьСтрокиЗакупкиАРМ(Вторая, "вторая строка отгрузки в ту же реализацию");
	ПроверитьРавенство(Реализация.Ссылка, Результат.Документ, "вторая строка - в ту же реализацию");
	ПроверитьРавенство(1, ЧислоАвтовыпусков(Реализация.Ссылка), "отгрузка сверх выпущенного создала автовыпуск");
	Проверить(Не ПустаяСтрока(Результат.СтрокиДокумента[0].Автовыпуск), "колонка «Автовыпуск» заполнена");
	ПроверитьРавенство(7, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "автовыпуск досчитан в «Выпущено»");
	Автовыпуск = Неопределено;
	Для Каждого СтрокаВыпуска Из АРМ.СтрокиВыпусковИОтгрузок(Данные.Заказ).Выпуски Цикл
		Если СтрокаВыпуска.Документ <> Данные.Выпуск Тогда
			Автовыпуск = СтрокаВыпуска;
		КонецЕсли;
	КонецЦикла;
	Проверить(Автовыпуск <> Неопределено И Автовыпуск.ТолькоПросмотр, "автовыпуск в строках выпуска только для чтения");
	Если Автовыпуск <> Неопределено Тогда
		ВАвтовыпуск = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
		ЗаполнитьЗначенияСвойств(ВАвтовыпуск, Автовыпуск, "Документ, НомерСтроки, ВерсияДанных");
		Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ВАвтовыпуск)), "автовыпуск не правится строкой выпуска");
	КонецЕсли;
	ПравкаРанее = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 6);
	ПравкаРанее.Документ = Данные.Выпуск;
	ПравкаРанее.НомерСтроки = 1;
	ПравкаРанее.ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Выпуск, "ВерсияДанных");
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ПравкаРанее)), "выпуск, после которого проведена отгрузка, не правится");
	Данные.Реализация = Реализация.Ссылка;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «Статус» реализации: в черновик и провести - механизм реализации распроводит и проводит автовыпуск.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьОтгрузкуАРМ
//
Процедура ПроверитьСтатусОтгрузкиАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - выпущено 5 вручную и 7 с автовыпуском.
	АРМ = Обработки.АРМПроизводство;
	Реализации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Реализация);
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(Реализации, АРМ.ДействиеВЧерновик(), Данные.Заказ)[0];
	Проверить(Итог.Успех, "«В черновик» отменяет проведение реализации: " + Итог.Текст);
	ПроверитьРавенство(0, ВыполнениеПродукцииАРМ(Данные, Данные.P).Отгружено, "черновик реализации не отгружает");
	ПроверитьРавенство(5, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "автовыпуск распроведён вместе с реализацией");
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(Реализации, АРМ.ДействиеВРаботу(), Данные.Заказ)[0];
	Проверить(Итог.Успех, "«Провести» проводит реализацию: " + Итог.Текст);
	ПроверитьРавенство(7, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "автовыпуск снова проведён");

	ЦенаВручную = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 3);
	ЦенаВручную.Документ = Данные.Реализация;
	ЦенаВручную.НомерСтроки = 1;
	ЦенаВручную.ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Реализация, "ВерсияДанных");
	ЦенаВручную.Цена = 95;
	ЦенаВручную.ЦенаИзменена = Истина;
	ЗаписьСтрокиЗакупкиАРМ(ЦенаВручную, "ручная цена строки отгрузки");
	СтрокаРеализации = Данные.Реализация.ТЧТовары[0];
	ПроверитьРавенство(95, СтрокаРеализации.Цена, "ручная цена записана");
	ПроверитьРавенство(10, СтрокаРеализации.ПроцентСкидки, "скидка заказа не теряется при ручной цене");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Ручной выпуск, проведённый после реализации, запрещает её правку, «Провести» и выбор; удаление его единственной строки
// помечает выпуск и снимает запрет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьОтгрузкуАРМ
//
Процедура ПроверитьВыпускПослеОтгрузкиАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - выпуск 1 на минуту позже реализации.
	АРМ = Обработки.АРМПроизводство;
	Позже = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
	Результат = ЗаписьСтрокиЗакупкиАРМ(Позже, "выпуск после отгрузки");
	ВыпускПозже = Результат.Документ.ПолучитьОбъект();
	ВыпускПозже.Дата = ТекущаяДатаСеанса() + 60;
	Провести(ВыпускПозже);
	Третья = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 1);
	Третья.Документ = Данные.Реализация;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Третья)), "строка отгрузки после позднего выпуска не пишется");
	Реализации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Реализация);
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(Реализации, АРМ.ДействиеВРаботу(), Данные.Заказ)[0];
	Проверить(Не Итог.Успех, "«Провести» реализации после позднего выпуска отклоняется");
	Выбор = АРМ.ДокументыСтрокиДляВыбора(СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 1));
	Проверить(Выбор.НайтиПоЗначению(Данные.Реализация) = Неопределено, "реализация до позднего выпуска не в списке выбора");

	Удаление = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидВыпуск(), Данные.P, 1);
	Удаление.Документ = ВыпускПозже.Ссылка;
	Удаление.НомерСтроки = 1;
	Удаление.ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыпускПозже.Ссылка, "ВерсияДанных");
	Итог = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Итог.Успех И Итог.ДокументПомечен, "удаление единственной строки помечает выпуск: " + Итог.Текст);
	Проверить(ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Третья)), "после пометки позднего выпуска отгрузка снова правится");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «Выпуск по заказу»: заполнение нового выпуска строками заказа, которые осталось выпустить.
//
// Параметры:
//  Данные - Структура - см. ПроверитьОтгрузкуАРМ
//
Процедура ПроверитьЗаполнениеВыпускаПоЗаказуАРМ(Данные)

	// BSLLS:MagicNumber-off - заказано 10, выпущено 7 (5 и автовыпуск 2), расход 2.
	Выпуск = Документы.ВыпускПродукции.СоздатьДокумент();
	Выпуск.Заполнить(Данные.Заказ);
	ПроверитьРавенство(Данные.Заказ, Выпуск.Основание, "основание выпуска по заказу");
	ПроверитьРавенство(1, Выпуск.ТЧГотоваяПродукция.Количество(), "к выпуску - только продукция с материалами");
	Если Выпуск.ТЧГотоваяПродукция.Количество() = 1 Тогда
		ПроверитьРавенство(3, Выпуск.ТЧГотоваяПродукция[0].Количество, "к выпуску - заказанное без выпущенного");
	КонецЕсли;
	ПроверитьРавенство(Данные.P, Выпуск.Номенклатура, "шапка выпуска по заказу - первая строка");
	ПроверитьРавенство(1, Выпуск.ТЧТовары.Количество(), "материалы выпуска по заказу по карте");
	Если Выпуск.ТЧТовары.Количество() = 1 Тогда
		ПроверитьРавенство(6, Выпуск.ТЧТовары[0].КоличествоУпаковок, "сырьё по карте на остаток к выпуску");
	КонецЕсли;
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Строка отгрузки сверх выпущенного и заказанного: реализация не проводится, строка не записывается проведённой.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМВыпускаОтгрузки
//
Процедура ПроверитьОтказОтгрузкиАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - отгрузка 20 при заказанных 10.
	АРМ = Обработки.АРМПроизводство;
	Сверх = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 20);
	ТекстЗапрета = АРМ.ТекстЗапретаСтрокиДокумента(Сверх);
	Проверить(ПустаяСтрока(ТекстЗапрета), "строка сверх продукции проходит проверки до записи: отказ даёт проведение - " + ТекстЗапрета);
	Попытка
		Результат = АРМ.ЗаписатьСтрокуДокумента(Сверх);
		НеПроведена = (Не Результат.Успех Или Не Результат.Проведен) И Не ПустаяСтрока(Результат.Текст);
		Пояснение = Результат.Текст;
	Исключение
		// Отказ проведения испортил транзакцию сценария: черновик свежим объектом в ней уже не создаётся. В работе
		// внешней транзакции нет - черновик записывается.
		НеПроведена = Истина;
		Пояснение = ОшибкаОднойСтрокой(ИнформацияОбОшибке());
	КонецПопытки;
	Проверить(НеПроведена, "отгрузка сверх продукции не проводится: " + Пояснение);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Параметры:
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  Вид        - Строка - вид документа строки: выпуск или отгрузка
//  Продукция  - СправочникСсылка.Номенклатура - продукция
//  Количество - Число - количество упаковок
//
// Возвращаемое значение:
//  Структура - см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента
//
Функция СтрокаВыпускаАРМ(Заказ, Вид, Продукция, Количество)

	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента();
	ДанныеСтроки.Вид = Вид;
	ДанныеСтроки.Заказ = Заказ;
	ДанныеСтроки.Продукция = Продукция;
	ДанныеСтроки.КоличествоУпаковок = Количество;
	Возврат ДанныеСтроки;

КонецФункции

// Параметры:
//  Данные    - Структура - см. ДанныеАРМВыпускаОтгрузки
//  Продукция - СправочникСсылка.Номенклатура - продукция заказа
//
// Возвращаемое значение:
//  Структура - Заказано, Выпущено, Отгружено проведёнными документами.
//
Функция ВыполнениеПродукцииАРМ(Данные, Продукция)

	Итог = Новый Структура("Заказано, Выпущено, Отгружено", 0, 0, 0);
	Для Каждого Выполнение Из ПроизводственныеЗаказы.ВыполнениеПоПродукции(Данные.Заказ) Цикл
		Если Выполнение.Номенклатура = Продукция Тогда
			ЗаполнитьЗначенияСвойств(Итог, Выполнение);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область АРМПереработка

// Рабочее место производства, переработка в строках (E12.3b): передачи в переработку строками заказа на производство в
// работе, продукция поступления из переработки как выпуск в стадии и автовыпуске, запреты правки передачи со списанными
// партиями, правило порядка отгрузки и поступления, удаление строк, смена основания передачи.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАРМПереработка(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Данные = ДанныеАРМПереработки(Контекст);
	ПроверитьЗапретыПереработкиАРМ(Контекст, Данные);
	ПроверитьПродукциюПередачиАРМ(Контекст, Данные);
	ПроверитьПередачуАРМ(Контекст, Данные);
	ПроверитьСвойстваПродукцииАРМ(Контекст, Данные);
	ПроверитьПоступлениеИзПереработкиАРМ(Контекст, Данные);
	ПроверитьПередачуСоСписаниемАРМ(Контекст, Данные);
	ПроверитьОтгрузкуПослеПереработкиАРМ(Контекст, Данные);
	ПроверитьПоступлениеСтрокойАРМ(Контекст, Данные);
	// Отказ записи портит транзакцию сценария: последним шагом.
	ПроверитьСменуОснованияПередачиАРМ(Контекст, Данные);

	Возврат РезультатСценария("ПФ/ГП строки передачи (2.0.16.16): допустимые - прямой родитель материала в дереве или "
		+ "товары заказа, ПФ/ГП не из заказа отклоняется, ожидаемая продукция по указанному ПФ/ГП совпадает с правилом "
		+ "заказа, ПФ/ГП из товаров при материале вне дерева - количество заказа; свойство ПФ/ГП пишется из рабочего места "
		+ "только для ПФ/ГП заказа и по типу; передача строкой: новый проведённый документ по заказу с ожидаемой продукцией, остаток у "
		+ "переработчика, правка количества, устаревшая версия; запреты: не субподрядчик, без количества; поступление из "
		+ "переработки по передаче - «Выпущено» и стадия заказа, заполнение остатком ожидаемой продукции; передача со "
		+ "списанными партиями не правится, не удаляется и не возвращается в черновик; отгрузка без автовыпуска в пределах "
		+ "поступившего; поздний приход из переработки запрещает правку отгрузки, отмена его проведения снимает запрет; "
		+ "удаление строки передачи с пометкой; поступление из переработки строкой (S6): новый проведённый документ, "
		+ "движения как через документ, вторая строка, право на суммы по записи пользователя и по роли, "
		+ "услуги по строкам с НДС, удаление строки, правки количества без "
		+ "задвоения и с остатком заказа без себя, запреты, шапка услуг и ручной НДС, обработчик 2.0.15.48, «В работу» "
		+ "черновика, права оператора, пометка без строк; смена основания передачи со списанием - отказ");

КонецФункции

// Заказ на производство в работе: продукция контекста 10 шт. (сырьё 2 на единицу); сырьё 30 на складе новых документов.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - Заказ, P, M, Склад, ДатаЗакупки и документы по мере создания.
//
Функция ДанныеАРМПереработки(Контекст)

	// BSLLS:MagicNumber-off - количества сценария: заказ 10, расход 2, сырьё 30 по 10.
	Склад = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновноеМестоХранения.Получить();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Контекст.Склад;
		Константы.ОсновноеМестоХранения.Установить(Склад);
	КонецЕсли;
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	Данные = Новый Структура("P, M, Склад", Контекст.Продукция, Контекст.Сырье, Склад);
	Закупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Закупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.ЦенаВключаетНДС = Истина;
	Закупка.Валюта = Контекст.Валюта;
	Закупка.КурсВалюты = 1;
	Закупка.МестоХранения = Склад;
	ДобавитьСтрокуТоваров(Контекст, Закупка, "ТЧТовары", Данные.M, 30, 10);
	Провести(Закупка);
	Данные.Вставить("ДатаЗакупки", Закупка.Дата);

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.P, 10, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M, 2);
	Провести(Заказ);
	Данные.Вставить("Заказ", Заказ.Ссылка);
	Данные.Вставить("Передача", Документы.ПередачаВПереработку.ПустаяСсылка());
	Данные.Вставить("Реализация", Документы.РеализацияТоваровУслуг.ПустаяСсылка());
	Возврат Данные;
	// BSLLS:MagicNumber-on

КонецФункции

// Отказы без записи: переработчик без признака субподрядчика, строка без количества.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМПереработки
//
Процедура ПроверитьЗапретыПереработкиАРМ(Контекст, Данные)

	АРМ = Обработки.АРМПроизводство;
	НеСубподрядчик = НовыйКонтрагент().ПолучитьОбъект();
	НеСубподрядчик.Субподрядчик = Ложь;
	НеСубподрядчик.Записать();
	Строка = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 1);
	Строка.Поставщик = НеСубподрядчик.Ссылка;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Строка)), "переработчик без признака субподрядчика отклоняется");
	БезКоличества = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 0);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(БезКоличества)), "строка передачи без количества отклоняется");

КонецПроцедуры

// ПФ/ГП строки передачи и свойства ПФ/ГП (2.0.16.16) - без записи документов: допустимые ПФ/ГП материала, ожидаемая
// продукция с указанным ПФ/ГП, запрет ПФ/ГП не из заказа, запись свойства из рабочего места.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМПереработки
//
Процедура ПроверитьПродукциюПередачиАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - передано 6 сырья при норме 2: ожидается 3; в заказе 10.
	АРМ = Обработки.АРМПроизводство;
	Менеджер = Документы.ПередачаВПереработку;
	Количество = "Количество";
	Допустимая = Менеджер.ДопустимаяПродукцияМатериала(Данные.Заказ, Данные.M);
	Проверить(Допустимая.Количество() = 1 И Допустимая[0] = Данные.P, "ПФ/ГП материала дерева - его прямой родитель");
	ВнеДерева = НоваяНоменклатура(Контекст, "материал вне дерева", Перечисления.ТипыНоменклатуры.Сырье);
	Проверить(Менеджер.ДопустимаяПродукцияМатериала(Данные.Заказ, ВнеДерева).Найти(Данные.P) <> Неопределено,
		"материал вне дерева - ПФ/ГП из товаров заказа");

	Товары = Новый ТаблицаЗначений;
	Товары.Колонки.Добавить("Номенклатура");
	Товары.Колонки.Добавить("Характеристика");
	Товары.Колонки.Добавить(Количество);
	Строка = Товары.Добавить();
	Строка.Номенклатура = Данные.M;
	Строка.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Строка.Количество = 6;
	ПоПравилу = Менеджер.ОжидаемаяПродукцияПередачи(Данные.Заказ, Товары);
	Товары.Колонки.Добавить("Продукция");
	Товары[0].Продукция = Данные.P;
	СПродукцией = Менеджер.ОжидаемаяПродукцияПередачи(Данные.Заказ, Товары);
	ПроверитьРавенство(ПоПравилу.Итог(Количество), СПродукцией.Итог(Количество),
		"ПФ/ГП - прямой родитель: ожидаемая продукция та же, что по правилу заказа");
	ПроверитьРавенство(3, СПродукцией.Итог(Количество), "ожидается по переданному под ПФ/ГП сырью");
	Товары[0].Номенклатура = ВнеДерева;
	ИзТоваров = Менеджер.ОжидаемаяПродукцияПередачи(Данные.Заказ, Товары);
	ПроверитьРавенство(10, ИзТоваров.Скопировать(Новый Структура("Номенклатура", Данные.P)).Итог(Количество),
		"ПФ/ГП из товаров при материале вне дерева - количество заказа");
	ПроверитьРавенство(0, ИзТоваров.Скопировать(Новый Структура(Количество, 0)).Количество(), "нулевых строк нет");

	Строка = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 1);
	Строка.Продукция = Данные.P;
	ПроверитьРавенство("", АРМ.ТекстЗапретаСтрокиДокумента(Строка), "строка передачи с ПФ/ГП заказа принимается");
	Строка.Продукция = Данные.M;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Строка)), "ПФ/ГП не из заказа отклоняется");

	// Смешанные строки: материал дерева под ПФ/ГП и материал вне дерева без ПФ/ГП - ПФ/ГП ждётся по своему сырью (3),
	// а не всем количеством заказа, которое дал бы запасной путь строк без ПФ/ГП.
	Товары[0].Номенклатура = Данные.M;
	Вторая = Товары.Добавить();
	Вторая.Номенклатура = ВнеДерева;
	Вторая.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Вторая.Количество = 5;
	Вторая.Продукция = Справочники.Номенклатура.ПустаяСсылка();
	Смешанные = Менеджер.ОжидаемаяПродукцияПередачи(Данные.Заказ, Товары);
	ПроверитьРавенство(3, Смешанные.Скопировать(Новый Структура("Номенклатура", Данные.P)).Итог(Количество),
		"смешанные строки: указанный ПФ/ГП - по своему сырью, строки без ПФ/ГП его не подменяют");
	Товары.Удалить(Вторая);
	Товары[0].Количество = 0;
	ПроверитьРавенство(0, Менеджер.ОжидаемаяПродукцияПередачи(Данные.Заказ, Товары).Количество(),
		"под ПФ/ГП ничего не передано - ничего и не ждётся");

	// Количество ПФ/ГП (2.0.16.17): норма по дереву, явное значение, минимум по материалам, удаляемая строка.
	БезХарактеристики = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	ПроверитьРавенство(3, Менеджер.КоличествоПродукцииПоНорме(Данные.Заказ, Данные.M, БезХарактеристики, 6, Данные.P),
		"норма ПФ/ГП: 6 сырья при норме 2 на единицу - 3");
	Товары.Колонки.Добавить("КоличествоПродукции");
	Товары[0].Количество = 6;
	Товары[0].КоличествоПродукции = 2;
	ПроверитьРавенство(2, Менеджер.ОжидаемаяПродукцияПередачи(Данные.Заказ, Товары).Итог(Количество),
		"указанное количество ПФ/ГП меньше нормы - ожидается оно");
	Вторая = Товары.Добавить();
	Вторая.Номенклатура = ВнеДерева;
	Вторая.Характеристика = БезХарактеристики;
	Вторая.Количество = 5;
	Вторая.Продукция = Данные.P;
	Вторая.КоличествоПродукции = 1;
	ПроверитьРавенство(1, Менеджер.ОжидаемаяПродукцияПередачи(Данные.Заказ, Товары).Итог(Количество),
		"два материала под один ПФ/ГП - ожидается по самому дефицитному");
	Вторая.Количество = 0;
	ПроверитьРавенство(2, Менеджер.ОжидаемаяПродукцияПередачи(Данные.Заказ, Товары).Итог(Количество),
		"удаляемая строка (без количества) ПФ/ГП не ограничивает");
	Товары.Удалить(Вторая);
	Товары[0].КоличествоПродукции = 0;
	ПроверитьРавенство(3, Менеджер.ОжидаемаяПродукцияПередачи(Данные.Заказ, Товары).Итог(Количество),
		"количество ПФ/ГП не указано - по правилу заказа");

	// BSLLS:MagicNumber-on

КонецПроцедуры

// Свойство ПФ/ГП пишется из рабочего места по записанной строке передачи (2.0.16.16): заказ и ПФ/ГП - из строки.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьПередачуАРМ (Передача - с ПФ/ГП в первой строке)
//
Процедура ПроверитьСвойстваПродукцииАРМ(Контекст, Данные)

	АРМ = Обработки.АРМПроизводство;
	ИмяСвойства = "ТестЦветАРМ";
	Цвет = "синий";
	Передача = Данные.Передача;
	Параметры = УправлениеСвойствами.ПараметрыДобавленияСвойства();
	Параметры.ИмяОбъекта = "Справочник.Номенклатура";
	Параметры.Имя = ИмяСвойства;
	Параметры.Наименование = ПометкаТеста() + ": цвет";
	Свойство = УправлениеСвойствами.ДобавитьСвойство(Параметры);
	Результат = АРМ.ЗаписатьСвойствоПродукции(Передача, 1, Данные.P, Свойство, Цвет);
	Проверить(Результат.Успех, "свойство ПФ/ГП заказа записано: " + Результат.Текст);
	ПроверитьРавенство(Цвет, УправлениеСвойствами.ЗначениеСвойства(Данные.P, ИмяСвойства), "значение в карточке ПФ/ГП");
	Свойства = АРМ.СвойстваПродукции(Данные.P);
	Найдено = Ложь;
	Для Каждого Описание Из Свойства Цикл
		Найдено = Найдено Или Описание.Свойство = Свойство И Описание.Значение = Цвет;
	КонецЦикла;
	Проверить(Найдено, "таблица свойств рабочего места показывает записанное значение");
	// BSLLS:MagicNumber-off - строки 99 в передаче нет, число 5 - не строка.
	Проверить(Не АРМ.ЗаписатьСвойствоПродукции(Передача, 99, Данные.P, Свойство, "красный").Успех,
		"строки передачи нет - свойство не пишется");
	Проверить(Не АРМ.ЗаписатьСвойствоПродукции(Передача, 1, Данные.M, Свойство, "красный").Успех,
		"в строке другой ПФ/ГП, чем показан, - свойство не пишется");
	Проверить(Не АРМ.ЗаписатьСвойствоПродукции(Передача, 1, Данные.P, Свойство, 5).Успех,
		"значение не того типа не пишется");
	// BSLLS:MagicNumber-on
	Результат = АРМ.ЗаписатьСвойствоПродукции(Передача, 1, Данные.P, Свойство, "");
	Проверить(Результат.Успех И УправлениеСвойствами.ЗначениеСвойства(Данные.P, ИмяСвойства) = Неопределено,
		"пустое значение очищает свойство");

КонецПроцедуры

// Передача строкой: новый документ по заказу, остаток у переработчика, правка количества, устаревшая версия.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМПереработки
//
Процедура ПроверитьПередачуАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - передача 6, правка до 8.
	АРМ = Обработки.АРМПроизводство;
	Первая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 6);
	// ПФ/ГП - прямой родитель сырья: ожидаемая продукция та же, что по правилу заказа (2.0.16.16).
	Первая.Продукция = Данные.P;
	Результат = ЗаписьСтрокиЗакупкиАРМ(Первая, "строка переработки создаёт передачу");
	Проверить(Результат.Проведен, "новая передача проведена сразу");
	Передача = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Данные.Заказ, Передача.Основание, "основание передачи - заказ на производство");
	ПроверитьРавенство(Контекст.Контрагент, Передача.Контрагент, "переработчик передачи - из строки");
	Проверить(Передача.ТЧГотоваяПродукция.Количество() > 0, "ожидаемая продукция передачи - по заказу");
	ПроверитьРавенство(6, ОстатокВПереработке(Контекст.Контрагент, Данные.M).Количество, "сырьё у переработчика");

	Правка = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 8);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Правка, Результат, 1);
	Правка.Продукция = Данные.P;
	// Как вернёт строку рабочее место: с нормой 3, подставленной при первой записи - пересчитается под 8 сырья.
	Правка.КоличествоПродукции = 3;
	Устаревшая = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 7);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Устаревшая, Результат, 1);
	Устаревшая.Продукция = Данные.P;
	Результат = ЗаписьСтрокиЗакупкиАРМ(Правка, "правка количества строки передачи");
	ПроверитьРавенство(8, ОстатокВПереработке(Контекст.Контрагент, Данные.M).Количество, "сырьё у переработчика после правки");
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Устаревшая);
	Проверить(Не Отказ.Успех И Отказ.Перечитать, "правка передачи по устаревшей версии отклоняется с перечитыванием");
	Выбор = АРМ.ДокументыСтрокиДляВыбора(СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 1));
	Проверить(Выбор.НайтиПоЗначению(Результат.Документ) <> Неопределено, "сегодняшняя передача в списке выбора");
	ПроверитьРавенство(1, АРМ.СтрокиПереработок(Данные.Заказ).Количество(), "строка передачи в закладке «Переработка»");

	// Поступление из переработки датируется между передачей и будущей отгрузкой.
	Передача = Результат.Документ.ПолучитьОбъект();
	Передача.Дата = Макс(НачалоДня(ТекущаяДатаСеанса()), Данные.ДатаЗакупки + 1);
	Провести(Передача);
	Данные.Передача = Передача.Ссылка;
	ПроверитьРавенство(4, Передача.ТЧТовары[0].КоличествоПродукции,
		"количество ПФ/ГП строки рабочего места - по норме переданного сырья (8 при норме 2)");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Поступление из переработки по передаче: «Выпущено» и стадия заказа, заполнение остатком ожидаемой продукции.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьПередачуАРМ
//
Процедура ПроверитьПоступлениеИзПереработкиАРМ(Контекст, Данные)

	// Ожидаемая продукция передачи - 4, а не все 10 строк заказа: рабочее место передало 8 сырья при норме 2 на
	// единицу, и больше четырёх из этого не выйдет (S5-A, ожидаемая продукция по дереву материалов заказа).
	// BSLLS:MagicNumber-off - поступило 3 из ожидаемых 4.
	ПроверитьРавенство(4, ОжидаемаяПродукцияПередачиАРМ(Данные.Передача),
		"ожидаемая продукция передачи ограничена переданным сырьём");
	Поступление = НовоеПоступлениеИзПереработкиАРМ(Контекст, Данные.Передача, 3);
	Поступление.Дата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Передача, "Дата") + 1;
	Провести(Поступление);
	ПроверитьРавенство(3, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "продукция переработчика - «Выпущено» заказа");
	Проверить(ДоляВыпускаИстории(Данные.Заказ) > 0, "стадия заказа пересчитана проведением поступления из переработки");
	Второе = Документы.ПоступлениеИзПереработки.СоздатьДокумент();
	Второе.Заполнить(Данные.Передача);
	ПроверитьРавенство(1, Второе.ТЧГотоваяПродукция.Итог("Количество"), "второе поступление - остаток ожидаемой продукции");
	ПроверитьРавенство(Второе.ТЧГотоваяПродукция.Количество(),
		Второе.ТЧГотоваяПродукция.НайтиСтроки(Новый Структура("Номенклатура", Данные.P)).Количество(),
		"поступление по передаче с ПФ/ГП - только этот ПФ/ГП");
	Данные.Вставить("Поступление", Поступление.Ссылка);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Ожидаемая продукция проведённой передачи рабочего места.
//
// Параметры:
//  Передача - ДокументСсылка.ПередачаВПереработку - передача рабочего места.
//
// Возвращаемое значение:
//  Число - итог количества ожидаемой продукции.
//
Функция ОжидаемаяПродукцияПередачиАРМ(Передача)

	Возврат Передача.ПолучитьОбъект().ТЧГотоваяПродукция.Итог("Количество");

КонецФункции

// Передача, партии которой списаны поступлением: правка, удаление и «В черновик» отклоняются.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьПоступлениеИзПереработкиАРМ
//
Процедура ПроверитьПередачуСоСписаниемАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - правка до 9.
	АРМ = Обработки.АРМПроизводство;
	Строки = АРМ.СтрокиПереработок(Данные.Заказ);
	Проверить(Строки.Количество() = 1 И Строки[0].ТолькоПросмотр, "передача со списанными партиями только для чтения");
	Правка = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 9);
	Правка.Документ = Данные.Передача;
	Правка.НомерСтроки = 1;
	Правка.ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Передача, "ВерсияДанных");
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Правка)), "строка передачи со списанием не правится");
	Отказ = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Правка))[0];
	Проверить(Не Отказ.Успех, "строка передачи со списанием не удаляется");
	Передачи = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Передача);
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(Передачи, АРМ.ДействиеВЧерновик(), Данные.Заказ)[0];
	Проверить(Не Итог.Успех, "передача со списанием не возвращается в черновик");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Отгрузка в пределах поступившего без автовыпуска; поздний приход из переработки запрещает правку отгрузки, отмена его
// проведения снимает запрет; удаление строки передачи без списания помечает передачу.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьПоступлениеИзПереработкиАРМ
//
Процедура ПроверитьОтгрузкуПослеПереработкиАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - отгрузка 3 при поступивших 3; вторая передача 2, поздний приход 1.
	// Количество второй передачи держит ДВА шага сразу: по нему считается ожидаемая продукция (S5-A) и по нему же
	// поздний приход на 3 сырья вылезает за её партию и достаёт партию третьей передачи по FIFO. Второе и есть
	// смысл шага «передача, чью партию списало поступление по другой передаче», поэтому число не растёт.
	АРМ = Обработки.АРМПроизводство;
	Результат = ЗаписьСтрокиЗакупкиАРМ(СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 3), "отгрузка продукции переработчика");
	ПроверитьРавенство(0, ЧислоАвтовыпусков(Результат.Документ), "продукция переработчика отгружается без автовыпуска");
	Данные.Реализация = Результат.Документ;

	ВтораяПередача = ЗаписьСтрокиЗакупкиАРМ(СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 2),
		"вторая передача");
	Проверить(ВтораяПередача.Документ <> Данные.Передача, "в передачу со списанием новая строка не попадает");
	Проба = Документы.ПоступлениеИзПереработки.СоздатьДокумент();
	Проба.Заполнить(ВтораяПередача.Документ);
	// До S5-A здесь связывал потолок заказа (осталось выпустить 6 из 10), теперь сильнее связывает переданное:
	// 2 сырья при норме 2 на единицу - это одна единица продукции. Потолок заказа никуда не делся, но на этих
	// числах он больше не различающий; отдельного шага на него в сценариях нет (docs/TECHDEBT.md).
	ПроверитьРавенство(1, Проба.ТЧГотоваяПродукция.Итог("Количество"),
		"поступление по второй передаче - не больше, чем даёт переданное сырьё");
	// Поступление по второй передаче списывает её партию и, по FIFO, партию третьей передачи того же переработчика.
	ТретьяПередача = ЗаписьСтрокиЗакупкиАРМ(СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 1),
		"третья передача");
	Проверить(ТретьяПередача.Документ <> ВтораяПередача.Документ, "третья передача - новый документ");
	Поздний = НовоеПоступлениеИзПереработкиАРМ(Контекст, ВтораяПередача.Документ, 1);
	Поздний.ТЧТовары[0].КоличествоУпаковок = 3;
	Поздний.ТЧТовары[0].Количество = 3;
	Поздний.Дата = ТекущаяДатаСеанса() + 60;
	Провести(Поздний);
	ПравкаТретьей = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 2);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(ПравкаТретьей, ТретьяПередача, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ПравкаТретьей)),
		"передача, чью партию списало поступление по другой передаче, не правится");
	Отгрузка = СтрокаВыпускаАРМ(Данные.Заказ, АРМ.ВидОтгрузка(), Данные.P, 1);
	Отгрузка.Документ = Данные.Реализация;
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Отгрузка)), "после позднего прихода из переработки отгрузка не правится");
	Поздний.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьРавенство(3, ВыполнениеПродукцииАРМ(Данные, Данные.P).Выпущено, "отмена проведения прихода возвращает «Выпущено»");
	Проверить(ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Отгрузка)), "после отмены проведения прихода отгрузка правится");

	Удаление = СтрокаЗакупкиАРМ(Контекст, Данные.Заказ, АРМ.ВидПередача(), Данные.M, 2);
	ЗаполнитьКлючСтрокиЗакупкиАРМ(Удаление, ВтораяПередача, 1);
	Итог = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Итог.Успех И Итог.ДокументПомечен, "удаление единственной строки помечает передачу: " + Итог.Текст);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Признак «выпуск изменён» поступления из переработки сравнивает документ с его движениями, а не с сохранённой версией
// (ревью техдолга Codex 2026-10-09, T12): без изменений - нет; больше продукции или дата раньше - да; запись без
// проведения не прячет изменение от следующего проведения. Документ возвращается к исходному количеству.
//
// Параметры:
//  Ссылка - ДокументСсылка.ПоступлениеИзПереработки - проведённое поступление.
//
Процедура ПроверитьИзменениеВыпускаПоступления(Ссылка)

	Объект = Ссылка.ПолучитьОбъект();
	Проверить(Не ПроизводственныеЗаказы.ВыпускПоступленияИзменен(Объект), "T12: перепроведение без изменений не проверяется");
	Объект.Дата = Объект.Дата - 1;
	Проверить(ПроизводственныеЗаказы.ВыпускПоступленияИзменен(Объект), "T12: дата раньше - выпуск изменён");
	Объект = Ссылка.ПолучитьОбъект();
	Исходное = Объект.ТЧГотоваяПродукция[0].Количество;
	Объект.ТЧГотоваяПродукция[0].Количество = Исходное + 1;
	Проверить(ПроизводственныеЗаказы.ВыпускПоступленияИзменен(Объект), "T12: продукции больше - выпуск изменён");
	Объект.Записать(РежимЗаписиДокумента.Запись);
	Объект = Ссылка.ПолучитьОбъект();
	Проверить(ПроизводственныеЗаказы.ВыпускПоступленияИзменен(Объект),
		"T12: запись без проведения не прячет изменение - сравнение с движениями");
	Объект.ТЧГотоваяПродукция[0].Количество = Исходное;
	Объект.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры

// Поступление из переработки строкой рабочего места (S6) на своём заказе, чтобы не сдвигать «Выпущено» и остатки
// первого: заказ 7 штук, две передачи по 8 сырья (ожидается по 4 продукции с каждой). Строкой - новый проведённый
// документ, сырьё посчитано сервером, движения совпадают с поступлением через документ, вторая строка в тот же документ,
// услуги по строкам с НДС, удаление строки, правки количества, запреты, синхронизация шапки услуг, обработчик 2.0.15.48,
// «В работу» черновика, права оператора, пометка документа без строк.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМПереработки
//
Процедура ПроверитьПоступлениеСтрокойАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - заказ 7, передачи по 8 сырья, строки 2 и 1, правки до 3, 4 и 5, услуги 100 со ставкой 20%.
	АРМ = Обработки.АРМПроизводство;
	Поступления = НовыеДанныеПоступленийСтрокойАРМ(Контекст, Данные);
	Заказ = Поступления.Заказ;

	// 1. Новая строка - новый проведённый документ по передаче.
	Первая = ЗаписьСтрокиЗакупкиАРМ(СтрокаПоступленияАРМ(Контекст, Заказ, Поступления.ПередачаА, Данные.P, 2),
		"строка поступления из переработки создаёт документ");
	Проверить(Первая.Проведен, "новое поступление из переработки проведено сразу");
	Поступление = Первая.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Поступления.ПередачаА, Поступление.Основание, "основание поступления - передача строки");
	ПроверитьРавенство(1, Поступление.ТЧГотоваяПродукция.Количество(), "одна строка продукции");
	ПроверитьРавенство(2, Поступление.ТЧГотоваяПродукция[0].Количество, "количество продукции из строки");
	ПроверитьРавенство(0, Поступление.ТЧГотоваяПродукция[0].ПроцентПотерь, "процент потерь - из карты");
	ПроверитьРавенство(4, ИтогКоличества(Поступление.ТЧТовары), "сырьё посчитано сервером по карте");
	ПроверитьРавенство(2, ВыполнениеЗаказаАРМ(Заказ, Данные.P).Выпущено, "поступление строкой - «Выпущено» заказа");
	ПроверитьРавенство(1, АРМ.СтрокиПоступленийПереработки(Заказ).Количество(), "строка на закладке поступлений");

	// 2. Те же данные через документ: вторая передача, заполнение и продукция 2.
	ЧерезДокумент = НовоеПоступлениеИзПереработкиАРМ(Контекст, Поступления.ПередачаБ, 2);
	Документы.ПоступлениеИзПереработки.ЗаполнитьСырье(ЧерезДокумент, Поступления.ПередачаБ);
	Провести(ЧерезДокумент);
	Поступления.Вставить("ЧерезДокумент", ЧерезДокумент.Ссылка);
	Строкой = ИтогДвиженийПоступления(Первая.Документ);
	Документом = ИтогДвиженийПоступления(ЧерезДокумент.Ссылка);
	ПроверитьРавенство(Документом.СписаноКоличество, Строкой.СписаноКоличество, "списано у переработчика - как через документ");
	ПроверитьРавенство(Документом.СписаноСумма, Строкой.СписаноСумма, "себестоимость списанного - как через документ");
	ПроверитьРавенство(Документом.ПриходКоличество, Строкой.ПриходКоличество, "оприходовано продукции - как через документ");
	ПроверитьРавенство(Документом.ПриходСумма, Строкой.ПриходСумма, "себестоимость продукции - как через документ");

	// 3. Вторая строка в тот же документ.
	Новая = СтрокаПоступленияАРМ(Контекст, Заказ, Поступления.ПередачаА, Данные.P, 1);
	Выбор = АРМ.ДокументыСтрокиДляВыбора(Новая);
	Проверить(Выбор.НайтиПоЗначению(Первая.Документ) <> Неопределено, "сегодняшнее поступление передачи в списке выбора");
	Новая.Документ = Первая.Документ;
	Новая.ВерсияДанных = Первая.СтрокиДокумента[0].ВерсияДанных;
	Вторая = ЗаписьСтрокиЗакупкиАРМ(Новая, "вторая строка в то же поступление");
	ПроверитьРавенство(Первая.Документ, Вторая.Документ, "вторая строка - в тот же документ");
	ПроверитьРавенство(6, ИтогКоличества(Первая.Документ.ПолучитьОбъект().ТЧТовары), "сырьё пересчитано по двум строкам");

	// 4. «+ услуга переработки»: 100 на документ из строк 2 и 1, ставка 20%. Перед ней - право на суммы пользователя.
	ПроверитьПравоСуммАРМ();
	ПроверитьУслугиПоступленияАРМ(Контекст, Заказ, Вторая);

	// 5. Удаление второй строки: услуги переходят на оставшуюся, сырьё пересчитано.
	Строки = АРМ.СтрокиПоступленийПереработки(Заказ);
	Удаление = СтрокаПоступленияАРМ(Контекст, Заказ, Поступления.ПередачаА, Данные.P, 1);
	ЗаполнитьКлючСтрокиПоступленияАРМ(Удаление, Строки, Первая.Документ, 2);
	Итог = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Итог.Успех И Не Итог.ДокументПомечен, "удаление второй строки поступления: " + Итог.Текст);
	Поступление = Первая.Документ.ПолучитьОбъект();
	ПроверитьРавенство(100, Поступление.СтоимостьУслуг, "услуги документа после удаления строки не уменьшились");
	ПроверитьРавенство(100, Поступление.ТЧГотоваяПродукция[0].СтоимостьУслуг, "услуги удалённой строки - на оставшейся");
	ПроверитьРавенство(4, ИтогКоличества(Поступление.ТЧТовары), "сырьё пересчитано после удаления строки");

	// 6. Правки количества: сырьё пересчитывается, остаток у переработчика не двоится, остаток заказа - без себя.
	ПроверитьПравкиПоступленияАРМ(Контекст, Данные, Поступления);

	// 7. Запреты без записи и под блокировкой.
	ПроверитьЗапретыПоступленияАРМ(Контекст, Данные, Поступления);

	// 8. Шапка услуг и НДС документа, обработчик обновления, «В работу» черновика, права.
	ПроверитьШапкуУслугПоступления(Поступления.ЧерезДокумент);
	ПроверитьОбработчикПоступленийИзПереработки(Поступления.ЧерезДокумент);
	ПроверитьЧерновикПоступленияАРМ(Контекст, Данные, Поступления);
	МетаданныеПоступления = Метаданные.Документы.ПоступлениеИзПереработки;
	Оператор = Метаданные.Роли.ОператорПроизводства;
	ПраваОператора = ПравоДоступа("Добавление", МетаданныеПоступления, Оператор)
		И ПравоДоступа("Изменение", МетаданныеПоступления, Оператор)
		И ПравоДоступа("Проведение", МетаданныеПоступления, Оператор)
		И ПравоДоступа("Использование", Метаданные.Обработки.АРМПроизводство, Оператор);
	Проверить(ПраваОператора, "оператор производства вводит поступления из переработки строками рабочего места");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Свой заказ на производство 7 штук и две проведённые передачи по 8 сырья, датированные раньше текущего момента: документы
// рабочего места датируются «сейчас», и поступление должно видеть партии передач.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАРМПереработки
//
// Возвращаемое значение:
//  Структура - Заказ, ПередачаА, ПередачаБ.
//
Функция НовыеДанныеПоступленийСтрокойАРМ(Контекст, Данные)

	// BSLLS:MagicNumber-off - закупка 20 по 10, заказ 7, передачи по 8.
	Закупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Закупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.ЦенаВключаетНДС = Истина;
	Закупка.Валюта = Контекст.Валюта;
	Закупка.КурсВалюты = 1;
	Закупка.МестоХранения = Данные.Склад;
	ДобавитьСтрокуТоваров(Контекст, Закупка, "ТЧТовары", Данные.M, 20, 10);
	Провести(Закупка);
	ЗаказОбъект = ЗаказКлиентаСценария(Контекст);
	ЗаказОбъект.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, ЗаказОбъект, "ТЧТовары", Данные.P, 7, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, ЗаказОбъект, ЗаказОбъект.ТЧТовары[1], Данные.M, 2);
	Провести(ЗаказОбъект);
	Результат = Новый Структура("Заказ", ЗаказОбъект.Ссылка);
	АРМ = Обработки.АРМПроизводство;
	ДатаПередач = Макс(НачалоДня(ТекущаяДатаСеанса()), Закупка.Дата + 1);
	Для Каждого Имя Из СтрРазделить("ПередачаА,ПередачаБ", ",") Цикл
		Записано = ЗаписьСтрокиЗакупкиАРМ(СтрокаЗакупкиАРМ(Контекст, ЗаказОбъект.Ссылка, АРМ.ВидПередача(), Данные.M, 8),
			"передача под поступление строкой");
		Передача = Записано.Документ.ПолучитьОбъект();
		Передача.Дата = ДатаПередач;
		Провести(Передача);
		Результат.Вставить(Имя, Передача.Ссылка);
	КонецЦикла;
	Проверить(Результат.ПередачаА <> Результат.ПередачаБ, "две разные передачи");
	Возврат Результат;
	// BSLLS:MagicNumber-on

КонецФункции

// Право «Видеть суммы (производство)»: без записи - прежнее правило по роли, запись «Ложь» скрывает суммы, «Истина» -
// показывает. Прежняя запись пользователя прогона восстанавливается и при падении проверки.
Процедура ПроверитьПравоСуммАРМ()

	АРМ = Обработки.АРМПроизводство;
	// Права группы «Настройки доступа» пишет только администратор (SEC-2): без этой роли сценарий записать их не сможет.
	Проверить(РегистрыСведений.НастройкиПользователей.ЭтоАдминистраторНастроек(),
		"пользователь прогона - администратор или руководитель: вправе менять права пользователей");
	Набор = РегистрыСведений.НастройкиПользователей.СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Установить(ПараметрыСеанса.Пользователь);
	Набор.Отбор.Настройка.Установить(ПланыВидовХарактеристик.ВидыНастроекПользователей.ВидетьСуммыПроизводства);
	Набор.Прочитать();
	Прежние = Набор.Выгрузить();
	Попытка
		Набор.Очистить();
		Набор.Записать();
		// BSLLS:IsInRoleMethod-off - сверка с прежним правилом рабочего места, которое привязано к роли
		ПоРоли = Не РольДоступна("ОператорПроизводства") Или РольДоступна("Администратор");
		// BSLLS:IsInRoleMethod-on
		ПроверитьРавенство(ПоРоли, АРМ.ПоказыватьСуммы(), "без записи права суммы видны по роли");
		ЗаписатьПравоСуммАРМ(Набор, Ложь);
		Проверить(Не АРМ.ПоказыватьСуммы(), "право «Нет» скрывает суммы рабочего места");
		ЗаписатьПравоСуммАРМ(Набор, Истина);
		Проверить(АРМ.ПоказыватьСуммы(), "право «Да» показывает суммы рабочего места");
		ПроверитьЗапретЗаписиПрав();
	Исключение
		Набор.Загрузить(Прежние);
		Набор.Записать();
		ВызватьИсключение;
	КонецПопытки;
	Набор.Загрузить(Прежние);
	Набор.Записать();

КонецПроцедуры

// Что считается изменением прав группы «Настройки доступа» при записи набора (SEC-2). У пользователя прогона уже
// записано «Видеть суммы (производство) = Да». Наборы только проверяются, не записываются.
Процедура ПроверитьЗапретЗаписиПрав()

	Менеджер = РегистрыСведений.НастройкиПользователей;
	Виды = ПланыВидовХарактеристик.ВидыНастроекПользователей;
	Пользователь = ПараметрыСеанса.Пользователь;

	ТеЖеПрава = Менеджер.СоздатьНаборЗаписей();
	ТеЖеПрава.Отбор.Пользователь.Установить(Пользователь);
	ТеЖеПрава.Отбор.Настройка.Установить(Виды.ВидетьСуммыПроизводства);
	Запись = ТеЖеПрава.Добавить();
	Запись.Пользователь = Пользователь;
	Запись.Настройка = Виды.ВидетьСуммыПроизводства;
	Запись.Значение = Истина;
	Проверить(Не Менеджер.ИзменяютсяПраваДоступа(ТеЖеПрава), "перезапись права тем же значением правом не меняется");
	Запись.Значение = Ложь;
	Проверить(Менеджер.ИзменяютсяПраваДоступа(ТеЖеПрава), "смена значения права - изменение прав");

	Принтер = Менеджер.СоздатьНаборЗаписей();
	Принтер.Отбор.Пользователь.Установить(Пользователь);
	Принтер.Отбор.Настройка.Установить(Виды.ПринтерЧеков);
	Запись = Принтер.Добавить();
	Запись.Пользователь = Пользователь;
	Запись.Настройка = Виды.ПринтерЧеков;
	Запись.Значение = "Тест";
	Проверить(Не Менеджер.ИзменяютсяПраваДоступа(Принтер), "бытовая настройка - не право доступа");
	Проверить(Менеджер.ИзменяютсяПраваДоступа(ТеЖеПрава, Ложь),
		"добавление строки права без замещения - изменение прав");

	ВсеНастройки = Менеджер.СоздатьНаборЗаписей();
	ВсеНастройки.Отбор.Пользователь.Установить(Пользователь);
	Проверить(Менеджер.ИзменяютсяПраваДоступа(ВсеНастройки),
		"очистка всех настроек пользователя стирает его права - изменение прав");
	Проверить(Менеджер.ИзменяютсяПраваДоступа(Менеджер.СоздатьНаборЗаписей()),
		"пустой набор без отбора замещает весь регистр - изменение прав");
	Проверить(Менеджер.УдалениеЗаписиМеняетПраваДоступа(Пользователь, Виды.ВидетьСуммыПроизводства),
		"смена ключа записи права в форме удаляет право - изменение прав");
	Проверить(Не Менеджер.УдалениеЗаписиМеняетПраваДоступа(Пользователь, Виды.ПринтерЧеков),
		"смена ключа бытовой настройки правом не считается");

КонецПроцедуры

// Параметры:
//  Набор    - РегистрСведенийНаборЗаписей.НастройкиПользователей - набор с отбором по пользователю и праву на суммы.
//  Значение - Булево - значение права.
//
Процедура ЗаписатьПравоСуммАРМ(Набор, Значение)

	Набор.Очистить();
	Запись = Набор.Добавить();
	Запись.Пользователь = ПараметрыСеанса.Пользователь;
	Запись.Настройка = ПланыВидовХарактеристик.ВидыНастроекПользователей.ВидетьСуммыПроизводства;
	Запись.Значение = Значение;
	Набор.Записать();

КонецПроцедуры

// «+ услуга переработки»: сумма на документ из двух строк одной продукции распределяется по весу (количеству), НДС по
// ставке 20% делится по строкам при проведении, долг переработчику - услуги с НДС.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ поступлений строкой
//  Записано - Структура - результат записи второй строки поступления (СтрокиДокумента)
//
Процедура ПроверитьУслугиПоступленияАРМ(Контекст, Заказ, Записано)

	// BSLLS:MagicNumber-off - услуги 100 со ставкой 20%: строки 2 и 1 - 66.67 и 33.33, НДС 13.33 и 6.67.
	АРМ = Обработки.АРМПроизводство;
	Проверить(АРМ.ПоказыватьСуммы(), "пользователь прогона видит суммы рабочего места");
	Поступление = Записано.Документ.ПолучитьОбъект();
	Поступление.СтавкаНДСУслуг = НоваяСтавкаНДС(20);
	Поступление.Записать(РежимЗаписиДокумента.Проведение);
	Данные = АРМ.НовыеДанныеСтрокиДокумента();
	Данные.Вид = АРМ.ВидПоступлениеИзПереработки();
	Данные.Заказ = Заказ;
	Данные.Документ = Поступление.Ссылка;
	Данные.ВерсияДанных = Поступление.ВерсияДанных;
	Данные.Передача = Поступление.Основание;
	Данные.Поставщик = Поступление.Контрагент;
	Итог = АРМ.УстановитьУслугиПоступления(Данные, 100);
	Проверить(Итог.Успех, "«+ услуга переработки»: " + Итог.Текст);
	Поступление = Поступление.Ссылка.ПолучитьОбъект();
	ПроверитьРавенство(100, Поступление.СтоимостьУслуг, "шапка услуг - сумма документа");
	ПроверитьРавенство(20, Поступление.СуммаНДСУслуг, "НДС услуг по ставке документа");
	ПроверитьРавенство(66.67, Поступление.ТЧГотоваяПродукция[0].СтоимостьУслуг, "услуги первой строки - по весу");
	ПроверитьРавенство(33.33, Поступление.ТЧГотоваяПродукция[1].СтоимостьУслуг, "остаток округления - на последнюю строку");
	Проверить(Поступление.Проведен, "документ перепроведён");
	Строкой = ИтогДвиженийПоступления(Поступление.Ссылка);
	ПроверитьРавенство(Строкой.СписаноСумма + 100, Строкой.ПриходСумма, "себестоимость продукции = сырьё + услуги");
	ПроверитьРавенство(Строкой.СписаноНДС + 20, Строкой.ПриходНДС, "НДС продукции = НДС сырья + НДС услуг");
	ПриходПоСтрокам = ПриходПродукцииПоступления(Поступление.Ссылка);
	ПроверитьРавенство(2, ПриходПоСтрокам.Количество(), "приход по двум строкам продукции");
	ДоляСырья = Окр(Строкой.СписаноСумма * 2 / 3, 2);
	ПроверитьРавенство(ДоляСырья + 66.67, ПриходПоСтрокам[0].Сумма, "себестоимость первой строки = доля сырья + её услуги");
	ДоляНДССырья = РегистрыНакопления.ТоварыВНаличии.ДоляСуммы(Строкой.СписаноНДС, ДоляСырья, Строкой.СписаноСумма);
	ПроверитьРавенство(ДоляНДССырья + 13.33, ПриходПоСтрокам[0].СуммаНДС, "НДС первой строки = доля НДС сырья + доля НДС услуг");
	ПроверитьДолгПоставщику(Поступление.Ссылка, 120, "долг переработчику - услуги с НДС");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Правки количества строки проведённого поступления: 2 -> 3 -> 4. Сырьё пересчитывается, остаток у переработчика
// уменьшается на расход разницы и не двоится при второй правке (bsl-018). Правка 3 -> 4 проходит только при остатке
// заказа без самого документа (ревью плана S6, P1-3): заказ 7 минус 2 через документ - 5, а с собственными 3 осталось бы
// 2. Устаревшая версия и количество сверх ожидаемого по передаче (4) - отказ.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Данные       - Структура - см. ДанныеАРМПереработки
//  Поступления  - Структура - см. НовыеДанныеПоступленийСтрокойАРМ
//
Процедура ПроверитьПравкиПоступленияАРМ(Контекст, Данные, Поступления)

	// BSLLS:MagicNumber-off - правки до 3, 4 и 5; расход 2 на единицу.
	АРМ = Обработки.АРМПроизводство;
	Заказ = Поступления.Заказ;
	Документ = АРМ.СтрокиПоступленийПереработки(Заказ)[0].Документ;
	ОстатокДо = ОстатокВПереработке(Контекст.Контрагент, Данные.M).Количество;
	Устаревшая = Неопределено;
	Для Каждого Количество Из СтрРазделить("3,4", ",") Цикл
		Правка = СтрокаПоступленияАРМ(Контекст, Заказ, Поступления.ПередачаА, Данные.P, Число(Количество));
		ЗаполнитьКлючСтрокиПоступленияАРМ(Правка, АРМ.СтрокиПоступленийПереработки(Заказ), Документ, 1);
		Если Устаревшая = Неопределено Тогда
			Устаревшая = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Правка);
		КонецЕсли;
		ЗаписьСтрокиЗакупкиАРМ(Правка, "правка количества строки поступления до " + Количество);
	КонецЦикла;
	ПроверитьРавенство(8, ИтогКоличества(Документ.ПолучитьОбъект().ТЧТовары), "сырьё пересчитано по количеству 4");
	ПроверитьРавенство(ОстатокДо - 4, ОстатокВПереработке(Контекст.Контрагент, Данные.M).Количество,
		"остаток у переработчика - минус расход разницы, без задвоения");
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Устаревшая);
	Проверить(Не Отказ.Успех И Отказ.Перечитать, "правка поступления по устаревшей версии отклоняется с перечитыванием");
	Сверх = СтрокаПоступленияАРМ(Контекст, Заказ, Поступления.ПередачаА, Данные.P, 5);
	ЗаполнитьКлючСтрокиПоступленияАРМ(Сверх, АРМ.СтрокиПоступленийПереработки(Заказ), Документ, 1);
	Отказ = АРМ.ЗаписатьСтрокуДокумента(Сверх);
	Проверить(Не Отказ.Успех, "количество сверх ожидаемого отклоняется");
	ПроверитьРавенство(4, Документ.ПолучитьОбъект().ТЧГотоваяПродукция[0].Количество, "отказ ничего не записал");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Запреты поступления строкой: непроведённая передача, продукция не из ожидаемой, чужой заказ, раннее поступление при
// позднем (ревью плана S6, P1-5), документ с ручной правкой сырья (решение владельца S6, 4), отгрузка заказа после
// поступления (ревью кода S6, P1-1).
//
// Параметры:
//  Контекст    - Структура - см. НовыйКонтекст
//  Данные      - Структура - см. ДанныеАРМПереработки
//  Поступления - Структура - см. НовыеДанныеПоступленийСтрокойАРМ
//
Процедура ПроверитьЗапретыПоступленияАРМ(Контекст, Данные, Поступления)

	АРМ = Обработки.АРМПроизводство;
	Заказ = Поступления.Заказ;
	// Своя передача без поступлений: распровести передачу со списанными партиями нельзя.
	Записано = ЗаписьСтрокиЗакупкиАРМ(СтрокаЗакупкиАРМ(Контекст, Заказ, АРМ.ВидПередача(), Данные.M, 1),
		"передача под запрет непроведённой");
	Непроведенная = Записано.Документ.ПолучитьОбъект();
	Непроведенная.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Строка = СтрокаПоступленияАРМ(Контекст, Заказ, Непроведенная.Ссылка, Данные.P, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Строка)), "поступление по непроведённой передаче отклоняется");
	НеОжидаемая = ЗаписьОтказаАРМ(СтрокаПоступленияАРМ(Контекст, Заказ, Поступления.ПередачаА, Данные.M, 1));
	Проверить(Не НеОжидаемая.Успех, "продукция не из ожидаемой отклоняется: " + НеОжидаемая.Текст);
	ЧужойЗаказ = СтрокаПоступленияАРМ(Контекст, Данные.Заказ, Поступления.ПередачаА, Данные.P, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ЧужойЗаказ)), "передача другого заказа отклоняется");
	// Поступление через документ датировано раньше поступления строкой: его строку рабочее место не правит.
	Строки = АРМ.СтрокиПоступленийПереработки(Заказ);
	Раннее = СтрокаПоступленияАРМ(Контекст, Заказ, Поступления.ПередачаБ, Данные.P, 1);
	ЗаполнитьКлючСтрокиПоступленияАРМ(Раннее, Строки, Поступления.ЧерезДокумент, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(Раннее)),
		"раннее поступление при проведённом позднем не правится");
	Строки = АРМ.СтрокиПоступленийПереработки(Заказ);
	Последнее = Строки[0].Документ;
	Объект = Последнее.ПолучитьОбъект();
	Объект.СырьеИзмененоВручную = Истина;
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	Строки = АРМ.СтрокиПоступленийПереработки(Заказ);
	КоличествоПравки = 3;
	Ручное = СтрокаПоступленияАРМ(Контекст, Заказ, Поступления.ПередачаА, Данные.P, КоличествоПравки);
	ЗаполнитьКлючСтрокиПоступленияАРМ(Ручное, Строки, Последнее, 1);
	Текст = АРМ.ТекстЗапретаСтрокиДокумента(Ручное);
	Проверить(Не ПустаяСтрока(Текст), "строка поступления с ручной правкой сырья не правится");
	Проверить(ЗначениеСтрокиАРМ(Строки, Последнее, "ТолькоПросмотр") = Истина, "строка ручного сырья только для просмотра");
	Объект = Последнее.ПолучитьОбъект();
	Объект.СырьеИзмененоВручную = Ложь;
	// Документы рабочего места датируются «сейчас»: в одну секунду с отгрузкой порядок решило бы сравнение ссылок, и
	// поступление могло оказаться «позже» отгрузки - тогда отказало бы проведение самой отгрузки.
	СдвигСекунд = 2;
	Объект.Дата = Объект.Дата - СдвигСекунд;
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	// Поступление - сторона выпуска заказа: реализация, проведённая позже него, запрещает правку его строки, иначе её
	// автовыпуск не пересчитался бы (ревью кода S6, P1-1, правило DB-2 выпуска).
	ЗаписьСтрокиЗакупкиАРМ(СтрокаВыпускаАРМ(Заказ, АРМ.ВидОтгрузка(), Данные.P, 1), "отгрузка после поступлений строкой");
	Строки = АРМ.СтрокиПоступленийПереработки(Заказ);
	ПослеОтгрузки = СтрокаПоступленияАРМ(Контекст, Заказ, Поступления.ПередачаА, Данные.P, КоличествоПравки);
	ЗаполнитьКлючСтрокиПоступленияАРМ(ПослеОтгрузки, Строки, Последнее, 1);
	Проверить(Не ПустаяСтрока(АРМ.ТекстЗапретаСтрокиДокумента(ПослеОтгрузки)),
		"строка поступления, после которого проведена отгрузка заказа, не правится");

КонецПроцедуры

// Шапка услуг документа: шапка без строк распределяется при записи (старый код и демо), правка одной шапки
// перераспределяется, ручной НДС переживает запись (ревью плана S6, P1-1, P2-5).
//
// Параметры:
//  Документ - ДокументСсылка.ПоступлениеИзПереработки - проведённое поступление без услуг.
//
Процедура ПроверитьШапкуУслугПоступления(Документ)

	// BSLLS:MagicNumber-off - услуги 30, затем 40, ручной НДС 5.
	Объект = Документ.ПолучитьОбъект();
	Объект.СтоимостьУслуг = 30;
	Объект.СуммаНДСУслуг = 5;
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	Объект = Документ.ПолучитьОбъект();
	ПроверитьРавенство(30, Объект.ТЧГотоваяПродукция.Итог("СтоимостьУслуг"), "шапка без строк распределена при записи");
	ПроверитьРавенство(5, Объект.СуммаНДСУслуг, "ручной НДС услуг запись не пересчитывает");
	Объект.СтоимостьУслуг = 40;
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	Объект = Документ.ПолучитьОбъект();
	ПроверитьРавенство(40, Объект.ТЧГотоваяПродукция.Итог("СтоимостьУслуг"), "правка одной шапки перераспределена");
	ПроверитьДолгПоставщику(Документ, 45, "долг переработчику - шапка услуг и её НДС");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Обработчик 2.0.15.48 на документе «до S6»: услуги только в шапке, сырьё не по расчёту. Строки получают услуги, признак
// ручного сырья взводится, шапка, проведённость и движения не меняются; повтор ничего не пишет.
//
// Параметры:
//  Документ - ДокументСсылка.ПоступлениеИзПереработки - проведённое поступление с услугами 40 в строках.
//
Процедура ПроверитьОбработчикПоступленийИзПереработки(Документ)

	// BSLLS:MagicNumber-off - сырьё правится на 1 больше расчёта.
	Объект = Документ.ПолучитьОбъект();
	Для Каждого Стр Из Объект.ТЧГотоваяПродукция Цикл
		Стр.СтоимостьУслуг = 0;
	КонецЦикла;
	Объект.ТЧТовары[0].КоличествоУпаковок = Объект.ТЧТовары[0].КоличествоУпаковок + 1;
	Объект.ТЧТовары[0].Количество = Объект.ТЧТовары[0].Количество + 1;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	ДвиженияДо = ИтогДвиженийПоступления(Документ);
	Ссылки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Документ);
	ОбновлениеПрограммыОбработчики.ЗаполнитьУслугиИПризнакПоступленийИзПереработки(Ссылки);
	Объект = Документ.ПолучитьОбъект();
	ПроверитьРавенство(40, Объект.ТЧГотоваяПродукция.Итог("СтоимостьУслуг"), "обработчик разнёс услуги шапки по строкам");
	ПроверитьРавенство(40, Объект.СтоимостьУслуг, "обработчик не меняет шапку услуг");
	ПроверитьРавенство(5, Объект.СуммаНДСУслуг, "обработчик не меняет НДС услуг");
	Проверить(Объект.СырьеИзмененоВручную, "сырьё не по расчёту - признак ручной правки");
	Проверить(Объект.Проведен, "обработчик не распроводит документ");
	ДвиженияПосле = ИтогДвиженийПоступления(Документ);
	ПроверитьРавенство(ДвиженияДо.ПриходСумма, ДвиженияПосле.ПриходСумма, "обработчик не меняет движения");
	Версия = Объект.ВерсияДанных;
	ОбновлениеПрограммыОбработчики.ЗаполнитьУслугиИПризнакПоступленийИзПереработки(Ссылки);
	ПроверитьРавенство(Версия, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ВерсияДанных"),
		"повтор обработчика ничего не пишет");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// «В работу» черновика поступления из переработки: проведение под блокировкой с пересчётом сырья; затем удаление
// единственной строки помечает документ.
//
// Параметры:
//  Контекст    - Структура - см. НовыйКонтекст
//  Данные      - Структура - см. ДанныеАРМПереработки
//  Поступления - Структура - см. НовыеДанныеПоступленийСтрокойАРМ
//
Процедура ПроверитьЧерновикПоступленияАРМ(Контекст, Данные, Поступления)

	// BSLLS:MagicNumber-off - черновик на 1 по второй передаче: расход 2.
	АРМ = Обработки.АРМПроизводство;
	Черновик = Документы.ПоступлениеИзПереработки.СоздатьДокумент();
	Черновик.Заполнить(Неопределено);
	// Позже поступления строкой: проведение черновика раньше проведённого поступления запрещено (P1-5).
	Черновик.Дата = ТекущаяДатаСеанса() + 1;
	Черновик.Основание = Поступления.ПередачаБ;
	Черновик.Контрагент = Контекст.Контрагент;
	Черновик.Организация = Контекст.Организация;
	Черновик.МестоХранения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поступления.ПередачаБ, "МестоХранения");
	СтрокаПродукции = Черновик.ТЧГотоваяПродукция.Добавить();
	СтрокаПродукции.КодСтроки = 1;
	СтрокаПродукции.Номенклатура = Данные.P;
	СтрокаПродукции.Упаковка = Контекст.Единица;
	СтрокаПродукции.КоличествоУпаковок = 1;
	СтрокаПродукции.Количество = 1;
	Черновик.Записать(РежимЗаписиДокумента.Запись);
	Итог = АРМ.ИзменитьСтатусДокументовСтрок(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Черновик.Ссылка),
		АРМ.ДействиеВРаботу(), Поступления.Заказ)[0];
	Проверить(Итог.Успех, "«В работу» черновика поступления из переработки: " + Итог.Текст);
	Черновик = Черновик.Ссылка.ПолучитьОбъект();
	Проверить(Черновик.Проведен, "черновик проведён");
	ПроверитьРавенство(2, ИтогКоличества(Черновик.ТЧТовары), "сырьё черновика пересчитано при проведении");
	Удаление = СтрокаПоступленияАРМ(Контекст, Поступления.Заказ, Поступления.ПередачаБ, Данные.P, 1);
	ЗаполнитьКлючСтрокиПоступленияАРМ(Удаление, АРМ.СтрокиПоступленийПереработки(Поступления.Заказ), Черновик.Ссылка, 1);
	Итог = АРМ.УдалитьСтрокиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Удаление))[0];
	Проверить(Итог.Успех И Итог.ДокументПомечен, "удаление единственной строки помечает поступление: " + Итог.Текст);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  Передача   - ДокументСсылка.ПередачаВПереработку - передача строки
//  Продукция  - СправочникСсылка.Номенклатура - продукция
//  Количество - Число - количество
//
// Возвращаемое значение:
//  Структура - данные строки поступления из переработки, см. Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента
//
Функция СтрокаПоступленияАРМ(Контекст, Заказ, Передача, Продукция, Количество)

	ДанныеСтроки = Обработки.АРМПроизводство.НовыеДанныеСтрокиДокумента();
	ДанныеСтроки.Вид = Обработки.АРМПроизводство.ВидПоступлениеИзПереработки();
	ДанныеСтроки.Заказ = Заказ;
	ДанныеСтроки.Передача = Передача;
	ДанныеСтроки.Поставщик = Контекст.Контрагент;
	ДанныеСтроки.Продукция = Продукция;
	ДанныеСтроки.КоличествоУпаковок = Количество;
	Возврат ДанныеСтроки;

КонецФункции

// Ключ строки поступления из строк закладки: документ, номер строки, версия; процент потерь - из строки, чтобы правка
// количества не выглядела правкой процента.
//
// Параметры:
//  ДанныеСтроки - Структура - данные строки; заполняется.
//  Строки       - Массив из Структура - строки закладки, см. Обработки.АРМПроизводство.СтрокиПоступленийПереработки
//  Документ     - ДокументСсылка.ПоступлениеИзПереработки - документ строки
//  НомерСтроки  - Число - номер строки продукции
//
Процедура ЗаполнитьКлючСтрокиПоступленияАРМ(ДанныеСтроки, Строки, Документ, НомерСтроки)

	Для Каждого Строка Из Строки Цикл
		Если Строка.Документ = Документ И Строка.НомерСтроки = НомерСтроки Тогда
			ДанныеСтроки.Документ = Документ;
			ДанныеСтроки.НомерСтроки = НомерСтроки;
			ДанныеСтроки.ВерсияДанных = Строка.ВерсияДанных;
			ДанныеСтроки.ПроцентПотерь = Строка.ПроцентПотерь;
			ДанныеСтроки.Упаковка = Строка.Упаковка;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Нет строки закладки поступлений: " + Строка(Документ) + " / " + НомерСтроки;

КонецПроцедуры

// Параметры:
//  Строки   - Массив из Структура - строки закладки
//  Документ - ДокументСсылка - документ строки
//  Имя      - Строка - имя колонки
//
// Возвращаемое значение:
//  Произвольный - значение колонки первой строки документа; строки нет - Неопределено.
//
Функция ЗначениеСтрокиАРМ(Строки, Документ, Имя)

	Для Каждого Строка Из Строки Цикл
		Если Строка.Документ = Документ Тогда
			Возврат Строка[Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Запись строки, которая должна быть отклонена проверкой под блокировкой, без проверки успеха.
//
// Параметры:
//  ДанныеСтроки - Структура - данные строки
//
// Возвращаемое значение:
//  Структура - результат записи строки
//
Функция ЗаписьОтказаАРМ(ДанныеСтроки)

	Возврат Обработки.АРМПроизводство.ЗаписатьСтрокуДокумента(ДанныеСтроки);

КонецФункции

// Параметры:
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  Продукция - СправочникСсылка.Номенклатура - продукция заказа
//
// Возвращаемое значение:
//  Структура - Заказано, Выпущено, Отгружено проведёнными документами.
//
Функция ВыполнениеЗаказаАРМ(Заказ, Продукция)

	Возврат ВыполнениеПродукцииАРМ(Новый Структура("Заказ", Заказ), Продукция);

КонецФункции

// Итоги движений поступления из переработки: списание у переработчика и приход продукции.
//
// Параметры:
//  Документ - ДокументСсылка.ПоступлениеИзПереработки - поступление
//
// Возвращаемое значение:
//  Структура - СписаноКоличество, СписаноСумма, СписаноНДС, ПриходКоличество, ПриходСумма, ПриходНДС.
//
Функция ИтогДвиженийПоступления(Документ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Д.Количество), 0) КАК Количество,
	|	ЕСТЬNULL(СУММА(Д.Сумма), 0) КАК Сумма,
	|	ЕСТЬNULL(СУММА(Д.СуммаНДС), 0) КАК СуммаНДС
	|ИЗ
	|	РегистрНакопления.ТоварыВПереработке КАК Д
	|ГДЕ
	|	Д.Регистратор = &Документ
	|	И Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Д.Количество), 0) КАК Количество,
	|	ЕСТЬNULL(СУММА(Д.Сумма), 0) КАК Сумма,
	|	ЕСТЬNULL(СУММА(Д.СуммаНДС), 0) КАК СуммаНДС
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Д
	|ГДЕ
	|	Д.Регистратор = &Документ
	|	И Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
	Запрос.УстановитьПараметр("Документ", Документ);
	Пакет = Запрос.ВыполнитьПакет();
	Списано = Пакет[0].Выбрать();
	Списано.Следующий();
	Приход = Пакет[1].Выбрать();
	Приход.Следующий();
	Итог = Новый Структура;
	Итог.Вставить("СписаноКоличество", Списано.Количество);
	Итог.Вставить("СписаноСумма", Списано.Сумма);
	Итог.Вставить("СписаноНДС", Списано.СуммаНДС);
	Итог.Вставить("ПриходКоличество", Приход.Количество);
	Итог.Вставить("ПриходСумма", Приход.Сумма);
	Итог.Вставить("ПриходНДС", Приход.СуммаНДС);
	Возврат Итог;

КонецФункции

// Параметры:
//  Документ - ДокументСсылка.ПоступлениеИзПереработки - поступление
//
// Возвращаемое значение:
//  ТаблицаЗначений - Сумма, СуммаНДС прихода продукции по строкам движений в порядке номеров строк.
//
Функция ПриходПродукцииПоступления(Документ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Д.Сумма КАК Сумма,
	|	Д.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Д
	|ГДЕ
	|	Д.Регистратор = &Документ
	|	И Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Д.НомерСтроки");
	Запрос.УстановитьПараметр("Документ", Документ);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Смена основания передачи, партии которой списаны поступлением, - отказ записи.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьПоступлениеИзПереработкиАРМ
//
Процедура ПроверитьСменуОснованияПередачиАРМ(Контекст, Данные)

	ДругойЗаказ = ЗаказКлиентаСценария(Контекст);
	ДругойЗаказ.Записать(РежимЗаписиДокумента.Запись);
	Передача = Данные.Передача.ПолучитьОбъект();
	Передача.Основание = ДругойЗаказ.Ссылка;
	Записана = Истина;
	Попытка
		Передача.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Записана = Ложь;
	КонецПопытки;
	Проверить(Не Записана, "основание передачи со списанными партиями не меняется");

КонецПроцедуры

// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Передача   - ДокументСсылка.ПередачаВПереработку - передача-основание
//  Количество - Число - поступившая продукция
//
// Возвращаемое значение:
//  ДокументОбъект.ПоступлениеИзПереработки - заполненное по передаче поступление с одной строкой продукции.
//
Функция НовоеПоступлениеИзПереработкиАРМ(Контекст, Передача, Количество)

	Поступление = НовыйДокумент(Контекст, "ПоступлениеИзПереработки");
	// Дата - ДО заполнения: сырьё считается по остаткам на дату документа (S5-B), а документы рабочего места
	// датируются текущим моментом, тогда как даты сценария начинаются раньше него. Поступление, датированное
	// раньше своей передачи, её партий не видит, и строки сырья вышли бы пустыми.
	Поступление.Дата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Передача, "Дата") + 1;
	Поступление.Заполнить(Передача);
	Поступление.СтоимостьУслуг = 0;
	Поступление.СтавкаНДСУслуг = Контекст.СтавкаНДС;
	Поступление.СуммаНДСУслуг = 0;
	Пока Поступление.ТЧГотоваяПродукция.Количество() > 1 Цикл
		Поступление.ТЧГотоваяПродукция.Удалить(1);
	КонецЦикла;
	СтрокаПродукции = Поступление.ТЧГотоваяПродукция[0];
	СтрокаПродукции.КоличествоУпаковок = Количество;
	СтрокаПродукции.Количество = Количество;
	Возврат Поступление;

КонецФункции

// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ на производство
//
// Возвращаемое значение:
//  Число - доля выпуска последней записи истории статусов заказа.
//
Функция ДоляВыпускаИстории(Заказ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	История.ДоляВыпуска КАК ДоляВыпуска
	|ИЗ
	|	РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам.СрезПоследних(, ЗаказПокупателя = &Заказ) КАК История");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.ДоляВыпуска, 0);

КонецФункции

#КонецОбласти

#Область СебестоимостьПродукции

// Отчёт «Себестоимость продукции»: единственная проверка текста запроса схемы компоновки. Смок отчёт не открывает -
// своей формы у него нет, а .dcs не читает ни один статический гейт. Данные сценария намеренно со ставкой НДС 20%:
// ресурс «Сумма» регистра ТоварыВНаличии хранит стоимость с НДС, и отчёт обязан вычесть СуммаНДСПриход.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСебестоимостьПродукции(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - сырьё 10 по 12 со ставкой 20%: приход продукции 120, в нём НДС 20, продукции 5 штук.
	Контекст.СтавкаНДС = НоваяСтавкаНДС(20);
	Материал = НоваяНоменклатура(Контекст, "сырьё со ставкой", Перечисления.ТипыНоменклатуры.Сырье);
	Продукция = НоваяНоменклатура(Контекст, "продукция со ставкой", Перечисления.ТипыНоменклатуры.Продукция);
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, СоставИзМатериала(Контекст, Материал, 2), Контекст.Дата);
	ЗакупкаСоСтавкойНДС(Контекст, Материал, 10, 12);

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Номенклатура = Продукция;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = 5;
	Выпуск.Количество = 5;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Ложь);
	Провести(Выпуск);

	Остаток = ОстатокТовара(Контекст.Склад, Продукция);
	ПроверитьРавенство(5, Остаток.Количество, "продукция оприходована");
	ПроверитьРавенство(120, Остаток.Сумма, "себестоимость продукции в регистре хранится с НДС");
	ПроверитьРавенство(20, НДСОстатка(Контекст.Склад, Продукция), "НДС партии продукции");

	Строка = СтрокаОтчетаСебестоимости(Выпуск.Дата, Продукция);
	ПроверитьРавенство(5, Строка.Количество, "количество в отчёте");
	ПроверитьРавенство(100, Строка.Себестоимость, "себестоимость в отчёте без НДС");
	ПроверитьРавенство(20, Строка.НДС, "НДС в составе себестоимости выделен отдельной колонкой");
	ПроверитьРавенство(20, Строка.СебестоимостьЕдиницы, "себестоимость единицы на группировке продукции");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("отчёт себестоимости: приход регистра по выпуску, НДС вычтен из себестоимости, "
		+ "себестоимость единицы считается на группировке продукции");

КонецФункции

// Строка отчёта «Себестоимость продукции» по одной продукции: схема компонуется в таблицу значений.
// Образец - СтрокиОтчетаПотребностей.
//
// Параметры:
//  ДатаВыпуска - Дата - день выпуска; период отчёта берётся по нему, а не по дате контекста:
//                документы сценария идут вперёд шагами и в первые секунды суток ушли бы за границу
//  Продукция   - СправочникСсылка.Номенклатура - отбор отчёта
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - Количество, Себестоимость, НДС, СебестоимостьЕдиницы
//
Функция СтрокаОтчетаСебестоимости(ДатаВыпуска, Продукция)

	Схема = Отчеты.СебестоимостьПродукции.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;
	Период = Новый СтандартныйПериод;
	Период.ДатаНачала = НачалоДня(ДатаВыпуска);
	Период.ДатаОкончания = КонецДня(ДатаВыпуска);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Период);
	// Общий итог вариант выводит в конце: в коллекцию значений он попал бы строкой без измерений.
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов",
		РасположениеИтоговКомпоновкиДанных.Нет);
	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Продукция");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Продукция;
	Отбор.Использование = Истина;
	Настройки.Структура.Очистить();
	Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Продукция");
	ПолеГруппировки.Использование = Истина;
	Для Каждого ИмяПоля Из СтрРазделить("Количество,Себестоимость,НДС,СебестоимостьЕдиницы", ",") Цикл
		Поле = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);

	ПроверитьРавенство(1, Результат.Количество(), "отчёт себестоимости вернул одну строку по продукции");
	Возврат Результат[0];

КонецФункции

// Поступление сырья с посчитанным НДС строки. Общий помощник ДокументЗакупки не годится: ДобавитьСтрокуТоваров
// кладёт СуммаНДС = 0 и строку не пересчитывает, поэтому в регистр ушёл бы нулевой НДС и проверка вычитания
// оказалась бы пустой. Пересчёт строки - как в НовоеПоступлениеПотребности и НовыйВозвратПотребности.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Номенклатура - СправочникСсылка.Номенклатура - сырьё
//  Количество   - Число - количество в единицах
//  Цена         - Число - цена с НДС
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеТоваровУслуг - проведённое поступление
//
Функция ЗакупкаСоСтавкойНДС(Контекст, Номенклатура, Количество, Цена)

	Док = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПоставщика;
	Док.ЦенаВключаетНДС = Истина;
	Док.Валюта = Контекст.Валюта;
	Док.КурсВалюты = 1;
	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Номенклатура, Количество, Цена);
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Док.ТЧТовары[0], Док.ЦенаВключаетНДС);
	Провести(Док);
	Возврат Док.Ссылка;

КонецФункции

// НДС в составе себестоимости остатка: ОстатокТовара его не возвращает.
//
// Параметры:
//  Склад        - СправочникСсылка.МестаХранения - место хранения
//  Номенклатура - СправочникСсылка.Номенклатура - позиция номенклатуры
//
// Возвращаемое значение:
//  Число - СуммаНДС остатка
//
Функция НДСОстатка(Склад, Номенклатура)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.СуммаНДСОстаток), 0) КАК СуммаНДС
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии.Остатки(, МестоХранения = &Склад И Номенклатура = &Номенклатура) КАК Остатки");
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат ПерваяСтрока(Запрос, "СуммаНДС").СуммаНДС;

КонецФункции

// Ставка НДС сценария: предопределена только «без НДС», а проверке нужна ненулевая ставка.
//
// Параметры:
//  Процент - Число - ставка в процентах
//
// Возвращаемое значение:
//  СправочникСсылка.СтавкиНДС - записанная ставка
//
Функция НоваяСтавкаНДС(Процент)

	Ставка = Справочники.СтавкиНДС.СоздатьЭлемент();
	Ставка.Наименование = ПометкаТеста() + ": " + Строка(Процент) + "%";
	Ставка.Ставка = Процент;
	Ставка.Записать();
	Возврат Ставка.Ссылка;

КонецФункции

#КонецОбласти

#Область ДемоНабор

// Демо-набор (E11): тот же генератор, что заполняет базу для приёмки и скриншотов (scripts/fixtures.sh --demo), в
// транзакции прогона с суффиксом наименований. Сверяются стадии и индикаторы заказов на производство по схемам,
// статусы коммерческих предложений, заказов-продаж и договоров, автовыпуски, лиды и заявки на поиск товара.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст (не используется: у набора свои справочники)
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДемоНабор(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Начало = Обработки.ТестовыеДанные.НачалоДемоНабора();
	Если Начало = Неопределено Тогда
		Возврат РезультатСценария("с начала дня прошло слишком мало времени для дат набора", Истина);
	КонецЕсли;

	Начат = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Кейсы = Обработки.ТестовыеДанные.ЗаполнитьДемоНабор(Начало, " (тест)");
	// BSLLS:MagicNumber-off - миллисекунды в секунды.
	Длительность = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начат) / 1000);
	// BSLLS:MagicNumber-on

	ПроверитьСтадииДемоНабора(Кейсы);
	ПроверитьТорговлюДемоНабора(Кейсы);
	ПроверитьРавенство(1, ЧислоАвтовыпусков(Кейсы["P1"].Реализация), "P1: один автовыпуск реализации");
	ПроверитьРавенство(1, ЧислоАвтовыпусков(Кейсы["P2"].Реализация), "P2: один автовыпуск реализации");
	ПроверитьРавенство(0, ЧислоАвтовыпусков(Кейсы["P9"].Реализация), "P9: выпущенного хватает, автовыпуска нет");
	// Демо-набор - единственное место, где признак автосоздания получают образцы для смока и печати: автовыпуски
	// здесь делает настоящий механизм (константа включается в ЗаполнитьДемоНабор), а не прямая запись документа.
	Проверить(Производство.ЭтоАвтовыпуск(ЕдинственныйАвтовыпуск(Кейсы["P1"].Реализация, "P1")),
		"P1: у автовыпуска демо-набора есть признак автосоздания");
	Выпуск = Кейсы["P10"].Выпуск;
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выпуск, "Проведен"), "P10: мультивыпуск проведён");
	Проверить(Не Производство.ЭтоАвтовыпуск(Выпуск), "P10: мультивыпуск без заказа автовыпуском не считается");
	// BSLLS:MagicNumber-off - две позиции мультивыпуска, пять лидов и пять заявок.
	ПроверитьРавенство(2, Выпуск.ТЧГотоваяПродукция.Количество(), "P10: две позиции продукции");
	ПроверитьРавенство(5, ЧислоЗаписейНабора("РегистрСведений.Лиды", "ПолноеИмя", Кейсы["L"].Имена), "лиды набора");
	ПроверитьРавенство(5, ЧислоЗаписейНабора("Документ.ЗаявкаНаПоискТовара", "Ссылка", Кейсы["Z"].Заявки),
		"заявки на поиск товара набора");
	// BSLLS:MagicNumber-on

	Текст = "кейсов " + СтрокаЧисла(Кейсы.Количество()) + " за " + СтрокаЧисла(Длительность)
		+ " с: стадии P1-P9 по схемам производства, статусы КП, заказов-продаж и договоров, автовыпуски, лиды и заявки";
	Возврат РезультатСценария(Текст);

КонецФункции

// Стадии и индикаторы заказов на производство P1-P9 (план .ai/plans/production-2mzl-e11-demo.md, §3).
//
// Параметры:
//  Кейсы - Соответствие - см. Обработки.ТестовыеДанные.ЗаполнитьДемоНабор
//
Процедура ПроверитьСтадииДемоНабора(Кейсы)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	ПроверитьСтадиюЗаказа(Кейсы["P1"].Заказ, Стадии.Выполнен, "●●●●●", "P1 под заказ без своего остатка");
	ПроверитьСтадиюЗаказа(Кейсы["P2"].Заказ, Стадии.ОжидаетОплаты, "●●●●◐", "P2 из своего остатка");
	ПроверитьСтадиюЗаказа(Кейсы["P3"].Заказ, Стадии.ОжидаетОтгрузки, "●●●○○", "P3 ручной выпуск по заказу");
	ПроверитьСтадиюЗаказа(Кейсы["P4"].Заказ, Стадии.ВПроизводстве, "●●○○○", "P4 состав в заказе");
	ПроверитьСтадиюЗаказа(Кейсы["P5"].Заказ, Стадии.ВосполнениеПотребности, "●◐○○○", "P5 закупка пришла частично");
	ПроверитьСтадиюЗаказа(Кейсы["P6"].Заказ, Стадии.ЗаказПоставщику, "○○○○○", "P6 материалы не заказаны");
	ПроверитьСтадиюЗаказа(Кейсы["P7"].Заказ, Стадии.ФормируетсяПотребность, "○○○○◐", "P7 закупаемый товар с авансом");
	ПроверитьСтадиюЗаказа(Кейсы["P8"].Заказ, Стадии.Черновик, "○○○○○", "P8 черновик");
	ПроверитьСтадиюЗаказа(Кейсы["P9"].Заказ, Стадии.ОжидаетОтгрузки, "●●●◐○", "P9 частичная отгрузка");

КонецПроцедуры

// Статусы коммерческих предложений, заказов-продаж и договоров набора.
//
// Параметры:
//  Кейсы - Соответствие - см. Обработки.ТестовыеДанные.ЗаполнитьДемоНабор
//
Процедура ПроверитьТорговлюДемоНабора(Кейсы)

	ИмяСтатуса = "Статус";
	СтатусыКП = Перечисления.СтатусыКоммерческихПредложений;
	ПроверитьРавенство(СтатусыКП.Выигран, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейсы["P1"].Предложение, ИмяСтатуса),
		"P1: предложение выиграно заказом");
	Предложения = Кейсы["T"];
	Для Каждого ЗначениеСтатуса Из СтрРазделить("Черновик,Отправлен,Доставлен,Проигран", ",") Цикл
		Фактический = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Предложения[ЗначениеСтатуса], ИмяСтатуса);
		ПроверитьРавенство(СтатусыКП[ЗначениеСтатуса], Фактический, "статус коммерческого предложения " + ЗначениеСтатуса);
	КонецЦикла;

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	ПроверитьСтатусПродажи(Кейсы["S1"].Заказ, Стадии.Новый, "S1");
	ПроверитьСтатусПродажи(Кейсы["S2"].Заказ, Стадии.ВРаботе, "S2");
	ПроверитьСтатусПродажи(Кейсы["S3"].Заказ, Стадии.Собран, "S3");
	ПроверитьСтатусПродажи(Кейсы["S4"].Заказ, Стадии.ВПроизводстве, "S4");
	ПроверитьСтатусПродажи(Кейсы["S5"].Заказ, Стадии.Отгружен, "S5");
	ПроверитьСтатусПродажи(Кейсы["S6"].Заказ, Стадии.ПереданСубподрядчику, "S6");
	// Поступление на основании передачи статус «Получен от субподрядчика» не ставит (TECHDEBT «Найдено в E11»).
	ПроверитьСтатусПродажи(Кейсы["S7"].Заказ, Стадии.ПереданСубподрядчику, "S7");

	СтатусыДоговоров = Перечисления.СтатусыДоговоровКонтрагентов;
	ПроверитьРавенство(СтатусыДоговоров.НеСогласован, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейсы["C"].НеСогласован, ИмяСтатуса),
		"договор «Не согласован»");
	ПроверитьРавенство(СтатусыДоговоров.Закрыт, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кейсы["C"].Закрыт, ИмяСтатуса),
		"договор «Закрыт»");

КонецПроцедуры

// Число выпусков продукции, основание которых - реализация.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация
//
// Возвращаемое значение:
//  Число - автовыпусков реализации
//
Функция ЧислоАвтовыпусков(Реализация)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Выпуск.Ссылка) КАК Выпусков
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуск
	|ГДЕ
	|	Выпуск.Основание = &Реализация
	|	И НЕ Выпуск.ПометкаУдаления");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Выпусков;

КонецФункции

// Число записей таблицы, созданных прогоном: поле среди значений, которые вернул генератор.
//
// Параметры:
//  ИмяТаблицы - Строка - таблица запроса
//  ИмяПоля    - Строка - поле отбора
//  Значения   - Массив - значения поля, записанные прогоном
//
// Возвращаемое значение:
//  Число - записей прогона
//
Функция ЧислоЗаписейНабора(ИмяТаблицы, ИмяПоля, Значения)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Записей
	|ИЗ
	|	&ИмяТаблицы КАК Таблица
	|ГДЕ
	|	Таблица.&ИмяПоля В (&Значения)";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", ИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПоля", ИмяПоля);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Значения", Значения);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Записей;

КонецФункции

#КонецОбласти

#Область ДанныеСценариев

// Данные, общие для сценариев. Всё, что записывается, заводится заново внутри
// транзакции сценария и откатывается вместе с ней; из базы берутся только организация,
// валюта учёта и предопределённые элементы. Свежая номенклатура и склад дают нулевые
// остатки - ожидаемые значения не зависят от содержимого базы.
//
// Возвращаемое значение:
//  Структура - контекст сценария, см. НовыйКонтекстДанных
//
Функция НовыйКонтекст()

	// Документы датируются чуть раньше текущего момента и с шагом в секунду: так
	// порядок документов на оси времени регистров совпадает с порядком их создания.
	Контекст = НовыйКонтекстДанных(ТекущаяДатаСеанса() - ЗапасСекунд(), ПометкаТеста());
	Контекст.Вставить("Единица", НоваяЕдиница());
	Контекст.Вставить("Склад", НовыйСклад());
	Контекст.Вставить("Контрагент", НовыйКонтрагент());
	Контекст.Вставить("ДоговорПокупателя", НовыйДоговор(Контекст, Перечисления.ВидыДоговоров.СПокупателем));
	Контекст.Вставить("ДоговорПоставщика", НовыйДоговор(Контекст, Перечисления.ВидыДоговоров.СПоставщиком));
	Контекст.Вставить("Касса", НоваяКасса(Контекст));
	Контекст.Вставить("Счет", НовыйБанковскийСчет(Контекст));
	Контекст.Вставить("Сотрудник", НовоеФизическоеЛицо());
	Контекст.Вставить("Товар", НоваяНоменклатура(Контекст, "товар", Перечисления.ТипыНоменклатуры.Товар));
	Контекст.Вставить("Сырье", НоваяНоменклатура(Контекст, "сырьё", Перечисления.ТипыНоменклатуры.Сырье));
	Контекст.Вставить("Продукция", НоваяПродукция(Контекст));

	Возврат Контекст;

КонецФункции

// Контекст документов без справочников: даты, организация, валюта и ставка НДС из базы. Им пользуются тесты документов и
// демо-набор (Обработки.ТестовыеДанные.СоздатьДемоНабор) вместе с помощниками НовыйДокумент, Провести, Записать,
// ДобавитьСтрокуТоваров, ДобавитьОснование, ДобавитьМатериалЗаказа, УстановитьКоличествоСтроки, СледующаяДата, СтатьяДДС.
// Справочники документов вызывающий кладёт в контекст сам; перед каждым кейсом можно подменить контрагента и договоры.
//
// Параметры:
//  Дата    - Дата   - дата, от которой отсчитываются даты документов (СледующаяДата прибавляет шаг)
//  Пометка - Строка - комментарий документов и признак объектов прогона
//
// Возвращаемое значение:
//  Структура - контекст:
//   * Числа              - Структура - количества и цены тестов, см. ЧислаСценариев
//   * Дата               - Дата      - начало отсчёта дат
//   * Шаг                - Число     - номер последнего шага дат
//   * Организация        - СправочникСсылка.Организации - первая организация базы
//   * Валюта             - СправочникСсылка.Валюты - валюта регламентированного учёта или первая валюта
//   * СтавкаНДС          - СправочникСсылка.СтавкиНДС - ставка без НДС
//   * СтатьяДДСЗапасная  - СправочникСсылка.СтатьиДвиженияДенежныхСредств - заводится при первой нужде, см. СтатьяДДС
//   * Пометка            - Строка - комментарий документов
//   Заполняет вызывающий: Единица, Склад, Контрагент, ДоговорПокупателя, ДоговорПоставщика, Касса, Счет.
//
Функция НовыйКонтекстДанных(Дата, Пометка) Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Числа", ЧислаСценариев());
	Контекст.Вставить("Дата", Дата);
	Контекст.Вставить("Шаг", 0);
	Контекст.Вставить("Пометка", Пометка);
	Контекст.Вставить("СтатьяДДСЗапасная", Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка());

	Организация = Обработки.ТестовыеДанные.ПервыйЭлемент("Организации");
	Проверить(ЗначениеЗаполнено(Организация), "в базе нет ни одной организации");
	Контекст.Вставить("Организация", Организация);

	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Обработки.ТестовыеДанные.ПервыйЭлемент("Валюты");
	КонецЕсли;
	Проверить(ЗначениеЗаполнено(Валюта), "не задана валюта регламентированного учёта и нет ни одной валюты");
	Контекст.Вставить("Валюта", Валюта);
	Контекст.Вставить("СтавкаНДС", Справочники.СтавкиНДС.SansTVA);

	Возврат Контекст;

КонецФункции

// Количества и цены сценариев в одном месте: ожидаемые значения считаются из них же.
//
// Возвращаемое значение:
//  Структура - количества и цены по именам
//
Функция ЧислаСценариев()

	// BSLLS:MagicNumber-off
	Числа = Новый Структура;
	Числа.Вставить("КоличествоЗакупки", 10);
	Числа.Вставить("ЦенаЗакупки", 50);
	Числа.Вставить("КоличествоПродажи", 3);
	Числа.Вставить("ЦенаПродажи", 100);
	Числа.Вставить("КоличествоСырья", 20);
	Числа.Вставить("ЦенаСырья", 10);
	Числа.Вставить("РасходСырьяНаЕдиницу", 2);
	Числа.Вставить("КоличествоВыпуска", 5);
	Числа.Вставить("СтоимостьУслугПереработки", 50);
	Числа.Вставить("Оклад", 1000);
	// BSLLS:MagicNumber-on
	Возврат Числа;

КонецФункции

