	Возврат Док.Ссылка;

КонецФункции

// Проведённый приходный кассовый ордер в оплату реализации.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - оплачиваемая реализация
//  Сумма      - Число - сумма
//
// Возвращаемое значение:
//  ДокументОбъект.ПриходныйКассовыйОрдер - проведённый ордер
//
Функция ДокументОплатыВКассу(Контекст, Реализация, Сумма)

	Док = НовыйДокумент(Контекст, "ПриходныйКассовыйОрдер");
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	Док.Контрагент = Контекст.Контрагент;
	Док.Договор = Контекст.ДоговорПокупателя;
	Док.Касса = Контекст.Касса;
	Док.ТипОплаты = Справочники.TypesDePayment.Cash;
	Док.СтатьяДДС = СтатьяДДС(Контекст, Док.ХозяйственнаяОперация);
	Док.Сумма = Сумма;
	ДобавитьОснование(Док, Реализация, Сумма);
	Провести(Док);
	Возврат Док;

КонецФункции

#КонецОбласти

#Область Проверки

// Сумма колонки по всему дереву материалов рабочего места: у ДереваЗначений нет Итог(), а колонки
// регистра лежат на листьях - считать надо по всем уровням.
//
// Параметры:
//  Дерево     - ДеревоЗначений - см. Обработки.АРМПроизводство.МатериалыЗаказа
//  ИмяКолонки - Строка - суммируемая колонка
//
// Возвращаемое значение:
//  Число - сумма по всем узлам дерева.
//
Функция ИтогДереваМатериалов(Дерево, ИмяКолонки)

	Возврат ИтогВетвиМатериалов(Дерево.Строки, ИмяКолонки);

КонецФункции

// Параметры:
//  Коллекция  - КоллекцияСтрокДереваЗначений - строки одного уровня
//  ИмяКолонки - Строка - суммируемая колонка
//
// Возвращаемое значение:
//  Число - сумма по этому уровню и всем нижним.
//
Функция ИтогВетвиМатериалов(Коллекция, ИмяКолонки)

	Итог = 0;
	Для Каждого Узел Из Коллекция Цикл
		Итог = Итог + Узел[ИмяКолонки] + ИтогВетвиМатериалов(Узел.Строки, ИмяКолонки);
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Признак того, что строка часового пояса - сырое смещение от UTC («+00», «-03:30»), а не имя
// зоны из ПолучитьДопустимыеЧасовыеПояса(). Такое платформа отдаёт, когда у системной зоны
// машины нет канонического имени: поймано 2026-09-16 на зоне Africa/Casablanca, из-за чего
// сценарий НастройкиПрограммы падал на любом прогоне этой машины.
//
// Параметры:
//  ЧасовойПояс - Строка - значение ТекущийЧасовойПояс().
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоСмещениеЧасовогоПояса(Знач ЧасовойПояс)

	Если ПустаяСтрока(ЧасовойПояс) Тогда
		Возврат Ложь;
	КонецЕсли;
	Первый = Лев(ЧасовойПояс, 1);
	Возврат Первый = "+" Или Первый = "-";

КонецФункции

Процедура Проверить(Условие, Описание)

	Если Не Условие Тогда
		ВызватьИсключение Описание;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРавенство(Ожидалось, Получено, Описание)

	Если Ожидалось <> Получено Тогда
		ВызватьИсключение Описание + ": ожидалось " + СтрокаЗначения(Ожидалось)
			+ ", получено " + СтрокаЗначения(Получено);
	КонецЕсли;

КонецПроцедуры

// Долг покупателя по документу расчётов: положительный остаток регистра
// (РегистрыНакопления.ВзаиморасчётыСПокупателями.ПолучитьЗадолженностьКлиентовПоКлассификации).
//
// Параметры:
//  ОбъектРасчетов - ДокументСсылка - документ расчётов
//  Долг           - Число - ожидаемый долг
//  Описание       - Строка - что проверялось
//
Процедура ПроверитьДолгПокупателя(ОбъектРасчетов, Долг, Описание)

	ПроверитьРавенство(Долг, ОстатокВзаиморасчетов("ВзаиморасчётыСПокупателями", ОбъектРасчетов), Описание);

КонецПроцедуры

// Долг поставщику по документу расчётов: отрицательный остаток регистра - так его читает
// РегистрыНакопления.ВзаиморасчётыСПоставщиками.ПолучитьЗадолженностьПоставшиковПоКлассификации,
// и так его гасит оплата поставщику (приход).
//
// Параметры:
//  ОбъектРасчетов - ДокументСсылка - документ расчётов
//  Долг           - Число - ожидаемый долг
//  Описание       - Строка - что проверялось
//
Процедура ПроверитьДолгПоставщику(ОбъектРасчетов, Долг, Описание)

	ПроверитьРавенство(-Долг, ОстатокВзаиморасчетов("ВзаиморасчётыСПоставщиками", ОбъектРасчетов), Описание);

КонецПроцедуры

