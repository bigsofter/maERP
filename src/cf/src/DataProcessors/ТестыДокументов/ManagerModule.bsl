#КонецОбласти

// Новое коммерческое предложение с одной товарной строкой.
//
// Параметры:
//  Контекст      - Структура - см. НовыйКонтекст
//  Номенклатура  - СправочникСсылка.Номенклатура - товар предложения
//  Описание      - Строка - описание товарной строки
//
// Возвращаемое значение:
//  ДокументОбъект.КоммерческоеПредложение - незаписанное предложение
//
Функция НовоеКоммерческоеПредложение(Контекст, Номенклатура, Описание)

	ВключитьКоммерческиеПредложения();
	Предложение = Документы.КоммерческоеПредложение.СоздатьДокумент();
	Предложение.Заполнить(Неопределено);
	Предложение.Дата = СледующаяДата(Контекст);
	Предложение.ДатаОтгрузки = Предложение.Дата;
	Предложение.Организация = Контекст.Организация;
	Предложение.Контрагент = Контекст.Контрагент;
	Предложение.Договор = Контекст.ДоговорПокупателя;
	Предложение.ЦенаВключаетНДС = Истина;
	Предложение.Комментарий = ПометкаТеста();
	ДобавитьСтрокуТоваров(Контекст, Предложение, "ТЧТовары", Номенклатура,
		Контекст.Числа.КоличествоПродажи, Контекст.Числа.ЦенаПродажи);
	Предложение.ТЧТовары[0].Описание = Описание;
	Возврат Предложение;

КонецФункции

// Ручной ввод КП - только при включённой опции «Коммерческие предложения» (docs/plans/branded-print.md, 3.3). Сценарии
// ручных КП включают её константой в своей транзакции - откат сценария её возвращает. Код КП читает константу, а не
// функциональную опцию, поэтому переключение видно в том же вызове (tiny1C bsl-023).
//
Процедура ВключитьКоммерческиеПредложения()

	УстановитьОпциюКП(Истина);

КонецПроцедуры

// Значение опции «Коммерческие предложения» внутри транзакции сценария.
//
// Параметры:
//  Значение - Булево - Истина: КП вводит человек; Ложь: КП создаёт реализация.
//
Процедура УстановитьОпциюКП(Значение)

	Если Константы.ИспользоватьКоммерческиеПредложения.Получить() <> Значение Тогда
		Константы.ИспользоватьКоммерческиеПредложения.Установить(Значение);
	КонецЕсли;

КонецПроцедуры

// Создаёт элемент с пустым способом пополнения, как запись базы до E2.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - существующая продукция без способа пополнения
//
Функция НоменклатураБезСпособаПополнения(Контекст)

	Номенклатура = Справочники.Номенклатура.СоздатьЭлемент();
	Номенклатура.Наименование = ПометкаТеста() + ": существующая номенклатура E2";
	Номенклатура.НаименованиеПолное = Номенклатура.Наименование;
	Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Продукция;
	Номенклатура.Единица = Контекст.Единица;
	Номенклатура.СтавкаНДС = Контекст.СтавкаНДС;
	Номенклатура.СпособПополнения = Перечисления.СпособыПополненияЗапасов.ПустаяСсылка();
	Номенклатура.ОбменДанными.Загрузка = Истина;
	Номенклатура.Записать();
	Возврат Номенклатура.Ссылка;

КонецФункции

// Создаёт группу с пустым способом пополнения для проверки границы миграции.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - группа без способа пополнения
//
Функция ГруппаНоменклатурыБезСпособаПополнения()

	Группа = Справочники.Номенклатура.СоздатьГруппу();
	Группа.Наименование = ПометкаТеста() + ": группа E2";
	Группа.ОбменДанными.Загрузка = Истина;
	Группа.Записать();
	Возврат Группа.Ссылка;

КонецФункции

// Количество элементов номенклатуры с пустым способом пополнения.
//
// Возвращаемое значение:
//  Число - количество незаполненных элементов; группы не учитываются
//
Функция КоличествоЭлементовБезСпособаПополнения()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И Номенклатура.СпособПополнения = ЗНАЧЕНИЕ(Перечисление.СпособыПополненияЗапасов.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

// Старая рецептура содержит две строки одного материала: при переносе расход суммируется.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  ДатаСоздания - Дата - дата старой номенклатуры, в том числе пустая
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - продукция без карты в регистре
//
Функция НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания)

	Ссылка = НоваяНоменклатура(Контекст, "перенос карты", Перечисления.ТипыНоменклатуры.Продукция);
	Объект = Ссылка.ПолучитьОбъект();
	Объект.ДатаСоздания = ДатаСоздания;
	Строка = Объект.ТехнологическаяКарта.Добавить();
	Строка.Номенклатура = Контекст.Сырье;
	Строка.ЕИ = Контекст.Единица;
	Строка.Количество = 2;
	Строка = Объект.ТехнологическаяКарта.Добавить();
	Строка.Номенклатура = Контекст.Сырье;
	Строка.ЕИ = Контекст.Единица;
	Строка.Количество = 3;
	Объект.Записать();
	Возврат Ссылка;

КонецФункции

// Количество всех документов карты, включая непроведённые.
//
// Параметры:
//  Продукция - СправочникСсылка.Номенклатура - проверяемая продукция
//
// Возвращаемое значение:
//  Число - количество документов
//
Функция КоличествоДокументовТехкарт(Продукция)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ Документ.ТехнологическаяКарта КАК Карта
		|ГДЕ Карта.Номенклатура = &Продукция");
	Запрос.УстановитьПараметр("Продукция", Продукция);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

#КонецОбласти

// BSLLS:MagicNumber-on

#Область ПотребностиПроизводства

// Потребности производства (E7): заказ клиента на производство пишет «Потребность», заказ поставщику - «Заказано»,
// поступление - «Пришло», возврат поставщику сторнирует «Пришло». Ожидания - план E7, п. 12.7: продукция P1
// (M1 ×2, M2 ×1 на единицу) ×10, P2 (M1 ×3) ×5.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПотребностиПроизводства(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Данные = ДанныеПотребностей(Контекст);
	ПроверитьПотребностьЗаказа(Контекст, Данные);
	ПроверитьЗакупкиБезПотребности(Контекст, Данные);
	ПроверитьЗаказыПоставщикуПотребности(Контекст, Данные);
	ПроверитьПоступленияПотребности(Контекст, Данные);
	ПроверитьВозвратыПотребности(Контекст, Данные);
	ПроверитьОтчетПотребностей(Данные);
	ПроверитьПерепроведениеПотребностей(Данные);
	ПроверитьЗаписьИзмененнойПотребности(Данные);
	ПроверитьОтказВводаБезПотребности(Контекст);

	Возврат РезультатСценария("потребность заказа в базовых единицах и перепроведение без дублей, закупка под продажу, "
		+ "непроведённый заказ и строка предварительного заказа без движений, ввод заказа поставщику по дефициту, "
		+ "явная продукция раньше распределения, излишек на последнюю продукцию, поступления по коду строки и по "
		+ "«Заказано» заказа поставщику, ввод поступления по заказу клиента, сторно возвратов по своему поступлению, "
		+ "отчёт с флагом «только дефицит», перепроведение и отмена проведения всех документов, отказ записи "
		+ "изменённой потребности, отказ ввода без потребности");

КонецФункции

// Данные сценария: продукция P1 - продукция контекста, P2 - новая, материалы M1 - сырьё контекста, M2 - новое.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - P1, P2, M1, M2, Заказ (ДокументСсылка.ЗаказПокупателя) и документы шагов по мере создания.
//
Функция ДанныеПотребностей(Контекст)

	Данные = Новый Структура;
	Данные.Вставить("P1", Контекст.Продукция);
	Данные.Вставить("P2", НоваяНоменклатура(Контекст, "продукция 2", Перечисления.ТипыНоменклатуры.Продукция));
	Данные.Вставить("M1", Контекст.Сырье);
	Данные.Вставить("M2", НоваяНоменклатура(Контекст, "сырьё 2", Перечисления.ТипыНоменклатуры.Сырье));
	Данные.Вставить("Заказ", Документы.ЗаказПокупателя.ПустаяСсылка());
	Данные.Вставить("Документы", Новый Массив);
	Возврат Данные;

КонецФункции

// Шаг 1: проведение заказа на производство и перепроведение без изменений.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьПотребностьЗаказа(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария из плана E7, п. 12.7.
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.P1, 10, Контекст.Числа.ЦенаПродажи);
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.P2, 5, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M1, 2);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M2, 1);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[2], Данные.M1, 3);
	Провести(Заказ);
	Данные.Заказ = Заказ.Ссылка;
	ПроверитьОстаткиПотребности(Данные, "20/0/0, 10/0/0, 15/0/0", "после проведения заказа");
	Заказ.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьОстаткиПотребности(Данные, "20/0/0, 10/0/0, 15/0/0", "после перепроведения заказа без изменений");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 2: заказ поставщику по продаже, по непроведённому заказу на производство и строка предварительного
// заказа движений потребности не дают.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьЗакупкиБезПотребности(Контекст, Данные)

	Продажа = ЗаказКлиентаСценария(Контекст);
	Записать(Продажа);
	ПоПродаже = НовыйЗаказПоставщикуПотребности(Контекст, Продажа.Ссылка);
	Проверить(Не ЗначениеЗаполнено(ПоПродаже.Основание), "ввод заказа поставщику по продаже основание не ставит");
	ПроверитьРавенство(1, ПоПродаже.ТЧТовары.Количество(), "ввод заказа поставщику по продаже - состав товаров");
	ПоПродаже.Основание = Продажа.Ссылка;
	Провести(ПоПродаже);
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(ПоПродаже.Ссылка), "заказ поставщику под продажу");

	// BSLLS:MagicNumber-off - количество строки закупки без движений.
	КоличествоСтроки = 5;
	// BSLLS:MagicNumber-on
	Непроведенный = ЗаказКлиентаСценария(Контекст);
	Непроведенный.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Записать(Непроведенный);
	ПодНепроведенный = НовыйЗаказПоставщикуПотребности(Контекст, Неопределено);
	ПодНепроведенный.Основание = Непроведенный.Ссылка;
	ДобавитьСтрокуЗакупкиПотребности(Контекст, ПодНепроведенный, Данные.M1, КоличествоСтроки, Неопределено);
	Провести(ПодНепроведенный);
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(ПодНепроведенный.Ссылка), "заказ поставщику под непроведённый заказ");

	Предварительный = НовыйЗаказПоставщикуПотребности(Контекст, Неопределено);
	Предварительный.ВидЗаказа = Перечисления.ВидыЗаказовПоставщику.Предварительный;
	ДобавитьСтрокуЗакупкиПотребности(Контекст, Предварительный, Данные.M1, КоличествоСтроки, Неопределено);
	Провести(Предварительный);
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(Предварительный.Ссылка), "предварительный заказ поставщику без основания");
	Итоговый = НовыйЗаказПоставщикуПотребности(Контекст, Неопределено);
	Итоговый.Основание = Данные.Заказ;
	Строка = ДобавитьСтрокуЗакупкиПотребности(Контекст, Итоговый, Данные.M1, КоличествоСтроки, Неопределено);
	Строка.ЗаказПоставщику = Предварительный.Ссылка;
	Провести(Итоговый);
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(Итоговый.Ссылка), "строка из предварительного заказа поставщику");
	ПроверитьОстаткиПотребности(Данные, "20/0/0, 10/0/0, 15/0/0", "после закупок без потребности");

КонецПроцедуры

// Шаги 3-4: ЗП1 вводом на основании (дефицит), правка строк с явной продукцией; ЗП2 по дефициту и с излишком.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьЗаказыПоставщикуПотребности(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария из плана E7, п. 12.7.
	ЗП1 = НовыйЗаказПоставщикуПотребности(Контекст, Данные.Заказ);
	ПроверитьРавенство(Данные.Заказ, ЗП1.Основание, "основание заказа поставщику по заказу на производство");
	ПроверитьРавенство("M1/P1 20, M2/P1 10, M1/P2 15", СтрокиЗакупкиСтрокой(Данные, ЗП1.ТЧТовары),
		"строки заказа поставщику по дефициту");
	ЗП1.ТЧТовары.Очистить();
	ДобавитьСтрокуЗакупкиПотребности(Контекст, ЗП1, Данные.M1, 30, Неопределено);
	ДобавитьСтрокуЗакупкиПотребности(Контекст, ЗП1, Данные.M1, 5, Данные.P1);
	ДобавитьСтрокуЗакупкиПотребности(Контекст, ЗП1, Данные.M2, 4, Данные.P1);
	Провести(ЗП1);
	ПроверитьОстаткиПотребности(Данные, "20/20/0, 10/4/0, 15/15/0", "ЗП1: явная продукция до распределения");

	Дефицит = РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа(Данные.Заказ);
	ПроверитьРавенство("M2/P1 6", СтрокиЗакупкиСтрокой(Данные, Дефицит), "дефицит заказа после ЗП1");
	ЗП2 = НовыйЗаказПоставщикуПотребности(Контекст, Неопределено);
	ЗП2.Основание = Данные.Заказ;
	Документы.ЗаказПоставщику.ЗаполнитьПоПотребности(ЗП2.ТЧТовары, Дефицит, ЗП2.ЦенаВключаетНДС, ЗП2.Контрагент);
	ЗП2.ТЧТовары[0].КоличествоУпаковок = 9;
	ЗП2.ТЧТовары[0].Количество = 9;
	ДобавитьСтрокуЗакупкиПотребности(Контекст, ЗП2, Данные.M1, 4, Неопределено);
	Провести(ЗП2);
	ПроверитьОстаткиПотребности(Данные, "20/20/0, 10/13/0, 15/19/0", "ЗП2: сверх дефицита и излишек на последнюю продукцию");
	Данные.Вставить("ЗП1", ЗП1.Ссылка);
	Данные.Вставить("ЗП2", ЗП2.Ссылка);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 5: ПТУ1 по ЗП1 (код строки и «Заказано» заказа поставщику), ПТУ2 по ЗП2, ПТУ3 по заказу клиента - только
// заполнение.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьПоступленияПотребности(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария из плана E7, п. 12.7.
	ПТУ1 = НовоеПоступлениеПотребности(Контекст, Данные.ЗП1);
	УстановитьКоличествоСтроки(ПТУ1.ТЧТовары[0], 22);
	УстановитьКоличествоСтроки(ПТУ1.ТЧТовары[1], 5);
	УстановитьКоличествоСтроки(ПТУ1.ТЧТовары[2], 4);
	Провести(ПТУ1);
	ПроверитьРавенство("M1/P1 20, M2/P1 4, M1/P2 7", ДвиженияПотребностиСтрокой(Данные, ПТУ1.Ссылка, "Пришло"),
		"ПТУ1: продукция по коду строки и по «Заказано» ЗП1");
	ПТУ2 = НовоеПоступлениеПотребности(Контекст, Данные.ЗП2);
	Провести(ПТУ2);
	ПроверитьОстаткиПотребности(Данные, "20/20/20, 10/13/13, 15/19/11", "после ПТУ1 и ПТУ2");

	ПТУ3 = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	ПТУ3.Заполнить(Данные.Заказ);
	ПроверитьРавенство(Данные.Заказ, ПТУ3.Основание, "основание поступления по заказу клиента");
	ПроверитьРавенство("M1 8", СтрокиЗакупкиСтрокой(Данные, ПТУ3.ТЧТовары), "поступление по заказу клиента: заказано - пришло");
	Данные.Вставить("ПТУ1", ПТУ1.Ссылка);
	Данные.Вставить("ПТУ2", ПТУ2.Ссылка);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 6: два возврата по ПТУ1 строкой «M1 без продукции» - сторно «Пришло» от остатка пришедшего по заказу в обратном
// порядке строк заказа (с 2.0.16.77; раньше - в обратном порядке распределения самого поступления).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьВозвратыПотребности(Контекст, Данные)

	// BSLLS:MagicNumber-off - количества сценария из плана E7, п. 12.7.
	Возврат1 = НовыйВозвратПотребности(Контекст, Данные.ПТУ1, 10);
	Провести(Возврат1);
	// Пределы возврата - от остатка пришедшего по заказу (ордерные склады, фаза 2, §2.8): P2 получила 11 (ПТУ1 7 +
	// ПТУ2 4), обратный порядок строк заказа снимает возврат с неё первой.
	ПроверитьРавенство("M1/P2 -10", ДвиженияПотребностиСтрокой(Данные, Возврат1.Ссылка, "Пришло"),
		"Возврат1: сторно от остатка пришедшего по заказу, с последней продукции");
	Возврат2 = НовыйВозвратПотребности(Контекст, Данные.ПТУ1, 5);
	Провести(Возврат2);
	ПроверитьОстаткиПотребности(Данные, "20/20/16, 10/13/13, 15/19/0", "после возвратов: остаток P2 исчерпан, остальное - с P1");
	Данные.Вставить("Возврат1", Возврат1.Ссылка);
	Данные.Вставить("Возврат2", Возврат2.Ссылка);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Отчёт по регистру: схема компонуется, флаг «только дефицит» отбрасывает строки без дефицита.
//
// Параметры:
//  Данные - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьОтчетПотребностей(Данные)

	СтрокиОтчета = СтрокиОтчетаПотребностей(Данные, Ложь);
	ПроверитьРавенство("M1/P1 20/20/16, M2/P1 10/13/13, M1/P2 15/19/0", СтрокиОтчета, "строки отчёта по заказу");
	ПроверитьРавенство("", СтрокиОтчетаПотребностей(Данные, Истина), "строки отчёта «только дефицит»");

КонецПроцедуры

// Шаг 7: перепроведение каждого документа, отмена проведения в обратном порядке и повторное проведение.
//
// Параметры:
//  Данные - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьПерепроведениеПотребностей(Данные)

	Итог = "20/20/16, 10/13/13, 15/19/0";
	Порядок = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Заказ,ЗП1,ЗП2,ПТУ1,ПТУ2,Возврат1,Возврат2", ",") Цикл
		Порядок.Добавить(Данные[Имя]);
	КонецЦикла;
	Для Каждого СсылкаДокумента Из Порядок Цикл
		СсылкаДокумента.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
		ПроверитьОстаткиПотребности(Данные, Итог, "перепроведение " + СсылкаДокумента);
	КонецЦикла;
	Для Индекс = 1 По Порядок.Количество() Цикл
		Порядок[Порядок.Количество() - Индекс].ПолучитьОбъект().Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЦикла;
	ПроверитьОстаткиПотребности(Данные, "", "после отмены проведения всех документов");
	Для Каждого СсылкаДокумента Из Порядок Цикл
		СсылкаДокумента.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	ПроверитьОстаткиПотребности(Данные, Итог, "после повторного проведения в прямом порядке");

КонецПроцедуры

// Шаг 8: проведённый заказ с другим количеством продукции в режиме «Запись» - отказ без записи.
//
// Параметры:
//  Данные - Структура - см. ДанныеПотребностей
//
Процедура ПроверитьЗаписьИзмененнойПотребности(Данные)

	Заказ = Данные.Заказ.ПолучитьОбъект();
	СтрокаПродукции = Заказ.ТЧТовары[1];
	// BSLLS:MagicNumber-off - новое количество продукции P1.
	СтрокаПродукции.Количество = 12;
	СтрокаПродукции.КоличествоУпаковок = 12;
	// BSLLS:MagicNumber-on
	Для Каждого Материал Из Заказ.ТЧМатериалы.НайтиСтроки(Новый Структура("КодСтрокиПродукции", СтрокаПродукции.КодСтроки)) Цикл
		Документы.ЗаказПокупателя.ПересчитатьСтрокуМатериала(Материал, СтрокаПродукции.Количество);
	КонецЦикла;
	Отказ = Ложь;
	Заказ.ПроверитьМатериалыПроведенногоЗаказа(РежимЗаписиДокумента.Запись, Отказ);
	Проверить(Отказ, "запись проведённого заказа с изменённой потребностью без перепроведения отклоняется");
	ПолучитьСообщенияПользователю(Истина);

КонецПроцедуры

// Шаг 9, последний: ввод заказа поставщику на основании непроведённого заказа на производство - исключение.
// Исключение внутри Заполнить оставляет транзакцию пригодной только для отката.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказВводаБезПотребности(Контекст)

	Непроведенный = ЗаказКлиентаСценария(Контекст);
	Непроведенный.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Записать(Непроведенный);
	ЗаказПоставщику = Документы.ЗаказПоставщику.СоздатьДокумент();
	ТекстОшибки = "";
	Попытка
		ЗаказПоставщику.Заполнить(Непроведенный.Ссылка);
	Исключение
		ТекстОшибки = ОшибкаОднойСтрокой(ИнформацияОбОшибке());
	КонецПопытки;
	Ожидаемый = РегистрыНакопления.ПотребностиПроизводства.ТекстЗаказБезПотребности();
	Проверить(СтрНайти(ТекстОшибки, Ожидаемый) > 0, "ввод заказа поставщику без потребности: " + ТекстОшибки);

КонецПроцедуры

// Новый заказ поставщику сценария; при заполненном основании - ввод на основании.
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Основание - ДокументСсылка.ЗаказПокупателя, Неопределено - основание ввода.
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПоставщику - незаписанный заказ
//
Функция НовыйЗаказПоставщикуПотребности(Контекст, Основание)

	ЗаказПоставщику = НовыйДокумент(Контекст, "ЗаказПоставщику");
	Если Основание <> Неопределено Тогда
		ЗаказПоставщику.Заполнить(Основание);
		ЗаказПоставщику.Дата = СледующаяДата(Контекст);
		ЗаказПоставщику.Организация = Контекст.Организация;
	КонецЕсли;
	ЗаказПоставщику.ВидЗаказа = Перечисления.ВидыЗаказовПоставщику.Основной;
	ЗаказПоставщику.ДатаПоставки = ЗаказПоставщику.Дата;
	ЗаказПоставщику.Контрагент = Контекст.Контрагент;
	ЗаказПоставщику.Договор = Контекст.ДоговорПоставщика;
	ЗаказПоставщику.ЦенаВключаетНДС = Истина;
	Возврат ЗаказПоставщику;

КонецФункции

// Строка закупки с материалом, количеством, ценой сырья и продукцией.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Док        - ДокументОбъект.ЗаказПоставщику - документ
//  Материал   - СправочникСсылка.Номенклатура - материал
//  Количество - Число - количество
//  Продукция  - СправочникСсылка.Номенклатура, Неопределено - продукция строки
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти - добавленная строка
//
Функция ДобавитьСтрокуЗакупкиПотребности(Контекст, Док, Материал, Количество, Продукция)

	ДобавитьСтрокуТоваров(Контекст, Док, "ТЧТовары", Материал, Количество, Контекст.Числа.ЦенаСырья);
	Строка = Док.ТЧТовары[Док.ТЧТовары.Количество() - 1];
	Строка.КодСтроки = РаботаСДокументамиКлиентСервер.ПолучитьСледующийКодСтроки(Док.ТЧТовары);
	Если Продукция <> Неопределено Тогда
		Строка.Продукция = Продукция;
	КонецЕсли;
	Возврат Строка;

КонецФункции

// Поступление на основании заказа поставщику со складом, операцией и валютой сценария.
//
// Параметры:
//  Контекст        - Структура - см. НовыйКонтекст
//  ЗаказПоставщику - ДокументСсылка.ЗаказПоставщику - основание
//
// Возвращаемое значение:
//  ДокументОбъект.ПоступлениеТоваровУслуг - незаписанное поступление
//
Функция НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику)

	Поступление = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Поступление.Заполнить(ЗаказПоставщику);
	Поступление.Дата = СледующаяДата(Контекст);
	Поступление.Организация = Контекст.Организация;
	Поступление.МестоХранения = Контекст.Склад;
	Поступление.Комментарий = ПометкаТеста();
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Поступление.Валюта = Контекст.Валюта;
	Поступление.КурсВалюты = 1;
	Для Каждого Строка Из Поступление.ТЧТовары Цикл
		Строка.Цена = Контекст.Числа.ЦенаСырья;
		РаботаСДокументамиКлиентСервер.РассчитатьСтроку(Строка, Поступление.ЦенаВключаетНДС);
	КонецЦикла;
	Возврат Поступление;

КонецФункции

// Возврат поставщику на основании поступления: остаётся только первая строка (M1 без продукции) с количеством.
//
// Параметры:
//  Контекст    - Структура - см. НовыйКонтекст
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - основание
//  Количество  - Число - возвращаемое количество
//
// Возвращаемое значение:
//  ДокументОбъект.ВозвратПоставщику - незаписанный возврат
//
Функция НовыйВозвратПотребности(Контекст, Поступление, Количество)

	ДокВозврат = Документы.ВозвратПоставщику.СоздатьДокумент();
	ДокВозврат.Заполнить(Поступление);
	ДокВозврат.Дата = СледующаяДата(Контекст);
	ДокВозврат.Комментарий = ПометкаТеста();
	ДокВозврат.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровПоставщику;
	Пока ДокВозврат.ТЧТовары.Количество() > 1 Цикл
		ДокВозврат.ТЧТовары.Удалить(ДокВозврат.ТЧТовары.Количество() - 1);
	КонецЦикла;
	ДокВозврат.ТЧСерии.Очистить();
	УстановитьКоличествоСтроки(ДокВозврат.ТЧТовары[0], Количество);
	РаботаСДокументамиКлиентСервер.РассчитатьСтроку(ДокВозврат.ТЧТовары[0], ДокВозврат.ЦенаВключаетНДС);
	Возврат ДокВозврат;

КонецФункции

// Количество строки в упаковках и в базовых единицах (коэффициент упаковки сценария - 1).
//
// Параметры:
//  Строка     - СтрокаТабличнойЧасти - строка товаров
//  Количество - Число - количество
//
Процедура УстановитьКоличествоСтроки(Строка, Количество) Экспорт

	Строка.КоличествоУпаковок = Количество;
	Строка.Количество = Количество;
	Строка.Сумма = Количество * Строка.Цена;
	Строка.СуммаСНДС = Строка.Сумма;

КонецПроцедуры

// Остатки потребности заказа строкой «Потребность/Заказано/Пришло» по строкам M1/P1, M2/P1, M1/P2; пустая строка -
// остатков нет.
//
// Параметры:
//  Данные    - Структура - см. ДанныеПотребностей
//  Ожидалось - Строка - ожидаемые остатки
//  Описание  - Строка - что проверяется
//
Процедура ПроверитьОстаткиПотребности(Данные, Ожидалось, Описание)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Остатки.Продукция КАК Продукция,
	|	Остатки.Материал КАК Материал,
	|	Остатки.ПотребностьОстаток КАК Потребность,
	|	Остатки.ЗаказаноОстаток КАК Заказано,
	|	Остатки.ПришлоОстаток КАК Пришло
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства.Остатки(, Заказ = &Заказ) КАК Остатки";
	Запрос.УстановитьПараметр("Заказ", Данные.Заказ);
	Остатки = Запрос.Выполнить().Выгрузить();
	Части = Новый Массив;
	Пары = Новый Массив;
	Пары.Добавить(СтрРазделить("M1,P1", ","));
	Пары.Добавить(СтрРазделить("M2,P1", ","));
	Пары.Добавить(СтрРазделить("M1,P2", ","));
	Для Каждого Пара Из Пары Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Материал", Данные[Пара[0]]);
		Отбор.Вставить("Продукция", Данные[Пара[1]]);
		Найденные = Остатки.НайтиСтроки(Отбор);
		Если Найденные.Количество() > 0 Тогда
			Строка = Найденные[0];
			Часть = СтрШаблон("%1/%2/%3", СтрокаЧисла(Строка.Потребность), СтрокаЧисла(Строка.Заказано),
				СтрокаЧисла(Строка.Пришло));
			Части.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	ПроверитьРавенство(Ожидалось, СтрСоединить(Части, ", "), "остатки потребностей " + Описание);
	ПроверитьРавенство(Части.Количество(), Остатки.Количество(), "лишние строки остатков потребностей " + Описание);

КонецПроцедуры

// Движения документа по одному ресурсу строкой «M/P количество» в порядке M1/P1, M2/P1, M1/P2.
//
// Параметры:
//  Данные      - Структура - см. ДанныеПотребностей
//  Регистратор - ДокументСсылка - документ
//  ИмяРесурса  - Строка - ресурс регистра
//
// Возвращаемое значение:
//  Строка - движения
//
Функция ДвиженияПотребностиСтрокой(Данные, Регистратор, ИмяРесурса)

	Набор = РегистрыНакопления.ПотребностиПроизводства.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	Таблица = Набор.Выгрузить();
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Таблица Цикл
		Строка.Количество = Строка[ИмяРесурса];
	КонецЦикла;
	Возврат СтрокиЗакупкиСтрокой(Данные, Таблица);

КонецФункции

// Строки с колонками Материал (или Номенклатура), Продукция (может отсутствовать) и Количество строкой
// «M/P количество» в порядке M1/P1, M2/P1, M1/P2, M1, M2.
//
// Параметры:
//  Данные - Структура - см. ДанныеПотребностей
//  Строки - ТаблицаЗначений, ТабличнаяЧасть - строки
//
// Возвращаемое значение:
//  Строка - строки через запятую
//
Функция СтрокиЗакупкиСтрокой(Данные, Строки)

	Имена = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("M1,M2,P1,P2", ",") Цикл
		Имена.Вставить(Данные[Имя], Имя);
	КонецЦикла;
	Суммы = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Структура = Новый Структура("Материал, Номенклатура, Продукция");
		ЗаполнитьЗначенияСвойств(Структура, Строка);
		Материал = ?(Структура.Материал = Неопределено, Структура.Номенклатура, Структура.Материал);
		Ключ = Имена[Материал] + ?(ЗначениеЗаполнено(Структура.Продукция), "/" + Имена[Структура.Продукция], "");
		Суммы.Вставить(Ключ, ?(Суммы[Ключ] = Неопределено, 0, Суммы[Ключ]) + Строка.Количество);
	КонецЦикла;
	Части = Новый Массив;
	Для Каждого Ключ Из СтрРазделить("M1/P1,M2/P1,M1/P2,M1,M2", ",") Цикл
		Если Суммы[Ключ] <> Неопределено И Суммы[Ключ] <> 0 Тогда
			Части.Добавить(Ключ + " " + СтрокаЧисла(Суммы[Ключ]));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Число движений потребностей документа.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ
//
// Возвращаемое значение:
//  Число - записей регистра
//
Функция ЧислоДвиженийПотребности(Регистратор)

	Набор = РегистрыНакопления.ПотребностиПроизводства.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	Возврат Набор.Количество();

КонецФункции

// Детальные строки отчёта «Потребности производства» по заказу строкой «M/P потребность/заказано/пришло» в порядке
// M1/P1, M2/P1, M1/P2. Поля выводятся явно (детальные записи с автовыбором без измерений компоновка сворачивает),
// общий итог отключён.
//
// Параметры:
//  Данные        - Структура - см. ДанныеПотребностей
//  ТолькоДефицит - Булево - параметр отчёта
//
// Возвращаемое значение:
//  Строка - строки результата
//
Функция СтрокиОтчетаПотребностей(Данные, ТолькоДефицит)

	Схема = Отчеты.ПотребностиПроизводства.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТолькоДефицит", ТолькоДефицит);
	// Общий итог вариант выводит в конце: в коллекцию значений он попал бы строкой без измерений.
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов",
		РасположениеИтоговКомпоновкиДанных.Нет);
	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Заказ");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Данные.Заказ;
	Отбор.Использование = Истина;
	Настройки.Структура.Очистить();
	Детали = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Для Каждого ИмяПоля Из СтрРазделить("Продукция,Материал,Характеристика,Потребность,Заказано,Пришло", ",") Цикл
		Поле = Детали.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);

	Имена = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("M1,M2,P1,P2", ",") Цикл
		Имена.Вставить(Данные[Имя], Имя);
	КонецЦикла;
	ПоКлючам = Новый Соответствие;
	Лишние = Новый Массив;
	Для Каждого СтрокаОтчета Из Результат Цикл
		Материал = ?(Имена[СтрокаОтчета.Материал] = Неопределено, "?", Имена[СтрокаОтчета.Материал]);
		Продукция = ?(Имена[СтрокаОтчета.Продукция] = Неопределено, "?", Имена[СтрокаОтчета.Продукция]);
		Ключ = Материал + "/" + Продукция;
		Значение = СтрШаблон("%1 %2/%3/%4", Ключ, СтрокаЧисла(СтрокаОтчета.Потребность),
			СтрокаЧисла(СтрокаОтчета.Заказано), СтрокаЧисла(СтрокаОтчета.Пришло));
		Если ПоКлючам[Ключ] = Неопределено Тогда
			ПоКлючам.Вставить(Ключ, Значение);
		Иначе
			Лишние.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Части = Новый Массив;
	Для Каждого Ключ Из СтрРазделить("M1/P1,M2/P1,M1/P2", ",") Цикл
		Если ПоКлючам[Ключ] <> Неопределено Тогда
			Части.Добавить(ПоКлючам[Ключ]);
			ПоКлючам.Удалить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючИЗначение Из ПоКлючам Цикл
		Лишние.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	Если Лишние.Количество() > 0 Тогда
		Части.Добавить("лишние: " + СтрСоединить(Лишние, "; "));
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

#КонецОбласти

#Область СтадииЗаказа

// Стадии заказа клиента на производство (E8): пересчёт из каждого документа контура, откаты отменой проведения и
// возвратом, поздняя веха, оплата двумя путями, продажи без стадий. Ожидаемые значения - по коду
// ПроизводственныеЗаказы.РассчитатьСтадию: заказ O1 - товар 3 и продукция 10 по цене продажи, материал - сырьё
// контекста 2 на единицу продукции (потребность 20).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСтадииЗаказа(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// Отгрузки сценария идут без автовыпуска (E9): включённый в базе переключатель дал бы отказ по материалам.
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Ложь);
	// BSLLS:MagicNumber-off - количества сценария: товар 3 + 3 + 1, продукция на склад 1.
	ДокументЗакупки(Контекст, Контекст.Товар, 7, Контекст.Числа.ЦенаЗакупки);
	// BSLLS:MagicNumber-on
	Данные = Новый Структура;
	ПроверитьЧерновикИПроведениеСтадии(Контекст, Данные);
	ПроверитьЗакупкиСтадии(Контекст, Данные);
	ПроверитьВыпускСтадии(Контекст, Данные);
	ПроверитьОтгрузкиСтадии(Контекст, Данные);
	ПроверитьОплатыСтадии(Контекст, Данные);
	ПроверитьПозднююВехуСтадии(Контекст);
	ПроверитьОтменуПроведенияЗаказаСтадии(Данные);
	ПроверитьПродажиБезСтадий(Контекст);

	Возврат РезультатСценария("черновик и перепроведение без дублей истории, заказ поставщику, восполнение и откат "
		+ "отменой поступления, выпуск частями, отгрузка частями, возврат и его отмена, оплата по реализации, аванс "
		+ "«на основании заказа» с зачётом в реализации, отмена оплаты, аванс по строке оснований, поздняя веха, "
		+ "формируется потребность, отмена проведения заказа со связанными документами, продажа и смена вида операции "
		+ "без стадий");

КонецФункции

// Шаги 1-2: запись без проведения, повторная запись, проведение и перепроведение.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - документы сценария по мере создания
//
Процедура ПроверитьЧерновикИПроведениеСтадии(Контекст, Данные)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	// BSLLS:MagicNumber-off - продукция 10, записей истории 1 и 2.
	Заказ = ЗаказНаПроизводствоСтадии(Контекст, 10);
	Записать(Заказ);
	Данные.Вставить("Заказ", Заказ);
	ПроверитьСтадиюЗаказа(Заказ.Ссылка, Стадии.Черновик, "○○○○○", "запись без проведения");
	Заказ.Записать();
	ПроверитьРавенство(1, ЧислоЗаписейИстории(Заказ.Ссылка), "записей истории после повторной записи черновика");

	Провести(Заказ);
	ПроверитьСтадиюЗаказа(Заказ.Ссылка, Стадии.ЗаказПоставщику, "○○○○○", "проведение без закупок");
	Заказ.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(2, ЧислоЗаписейИстории(Заказ.Ссылка), "записей истории после перепроведения");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаги 3-4: заказ поставщику по дефициту, два поступления, отмена второго и повторное проведение.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьЧерновикИПроведениеСтадии
//
Процедура ПроверитьЗакупкиСтадии(Контекст, Данные)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Заказ = Данные.Заказ.Ссылка;
	ЗаказПоставщику = НовыйЗаказПоставщикуПотребности(Контекст, Заказ);
	Провести(ЗаказПоставщику);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ВосполнениеПотребности, "●○○○○", "заказ поставщику на всю потребность");

	// BSLLS:MagicNumber-off - поступления 12 и 8 из потребности 20.
	Поступление1 = НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику.Ссылка);
	УстановитьКоличествоСтроки(Поступление1.ТЧТовары[0], 12);
	Провести(Поступление1);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ВосполнениеПотребности, "●◐○○○", "первое поступление");
	ПроверитьРавенство(0.6, Расчет.ДоляПоступления, "доля поступления после первого поступления");
	Поступление2 = НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику.Ссылка);
	УстановитьКоличествоСтроки(Поступление2.ТЧТовары[0], 8);
	// BSLLS:MagicNumber-on
	Провести(Поступление2);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ВПроизводстве, "●●○○○", "второе поступление");
	Поступление2.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ВосполнениеПотребности, "●◐○○○", "отмена проведения второго поступления");
	Провести(Поступление2);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ВПроизводстве, "●●○○○", "повторное проведение второго поступления");

КонецПроцедуры

// Шаг 5: ручные выпуски 4 и 6 по заказу.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьЧерновикИПроведениеСтадии
//
Процедура ПроверитьВыпускСтадии(Контекст, Данные)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Заказ = Данные.Заказ.Ссылка;
	// BSLLS:MagicNumber-off - выпуски 4 и 6 из 10.
	ВыпускСтадии(Контекст, Заказ, 4);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ВПроизводстве, "●●◐○○", "первый выпуск");
	ПроверитьРавенство(0.4, Расчет.ДоляВыпуска, "доля выпуска после первого выпуска");
	ВыпускСтадии(Контекст, Заказ, 6);
	// BSLLS:MagicNumber-on
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОтгрузки, "●●●○○", "второй выпуск");

КонецПроцедуры

// Шаг 6: реализация товара и части продукции, реализация остатка, возврат одной единицы и отмена возврата.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьЧерновикИПроведениеСтадии
//
Процедура ПроверитьОтгрузкиСтадии(Контекст, Данные)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Заказ = Данные.Заказ.Ссылка;
	Цена = Контекст.Числа.ЦенаПродажи;
	// BSLLS:MagicNumber-off - отгрузки: товар 3 и продукция 4, затем продукция 6; возврат 1.
	Реализация1 = РеализацияСтадии(Контекст, Заказ);
	УстановитьКоличествоСтроки(Реализация1.ТЧТовары[1], 4);
	Провести(Реализация1);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОтгрузки, "●●●◐○", "первая реализация");
	ПроверитьРавенство(7 * Цена, Расчет.Долг, "долг после первой реализации");

	Реализация2 = РеализацияСтадии(Контекст, Заказ);
	Реализация2.ТЧТовары.Удалить(0);
	УстановитьКоличествоСтроки(Реализация2.ТЧТовары[0], 6);
	Провести(Реализация2);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОплаты, "●●●●○", "вторая реализация");
	ПроверитьРавенство(13 * Цена, Расчет.Долг, "долг после второй реализации");

	Возврат1 = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	Возврат1.Заполнить(Реализация2.Ссылка);
	Возврат1.Дата = СледующаяДата(Контекст);
	Возврат1.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	УстановитьКоличествоСтроки(Возврат1.ТЧТовары[0], 1);
	Возврат1.ТЧСерии.Очистить();
	Провести(Возврат1);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОтгрузки, "●●●◐○", "возврат одной единицы");
	ПроверитьРавенство(12 * Цена, Расчет.Долг, "долг после возврата");
	// BSLLS:MagicNumber-on
	Возврат1.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОплаты, "●●●●○", "отмена проведения возврата");
	Данные.Вставить("Реализация1", Реализация1.Ссылка);
	Данные.Вставить("Реализация2", Реализация2);

КонецПроцедуры

// Шаг 7: оплата первой реализации, аванс «на основании заказа» (объект расчётов - сам ПКО) с зачётом во второй
// реализации, отмена проведения первой оплаты.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьОтгрузкиСтадии
//
Процедура ПроверитьОплатыСтадии(Контекст, Данные)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Заказ = Данные.Заказ.Ссылка;
	Цена = Контекст.Числа.ЦенаПродажи;
	// BSLLS:MagicNumber-off - оплаты 700 (первая реализация) и 600 (аванс под вторую).
	Оплата1 = ДокументОплатыВКассу(Контекст, Данные.Реализация1, 7 * Цена);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОплаты, "●●●●◐", "оплата первой реализации");
	ПроверитьРавенство(0.5385, Расчет.ДоляОплаты, "доля оплаты после первой оплаты");

	ЧислоЗаписей = ЧислоЗаписейИстории(Заказ);
	Аванс = НовыйДокумент(Контекст, "ПриходныйКассовыйОрдер");
	Аванс.Заполнить(Заказ);
	Аванс.Дата = СледующаяДата(Контекст);
	Аванс.Касса = Контекст.Касса;
	Аванс.СтатьяДДС = СтатьяДДС(Контекст, Аванс.ХозяйственнаяОперация);
	Аванс.Сумма = 6 * Цена;
	Провести(Аванс);
	ПроверитьРавенство(Заказ, Аванс.Основание, "основание аванса по заказу");
	ПроверитьРавенство(ЧислоЗаписей, ЧислоЗаписейИстории(Заказ), "аванс «на основании заказа» стадию не пересчитывает");

	Реализация2 = Данные.Реализация2;
	СтрокаЗачета = Реализация2.ТЧЗачётАвансов.Добавить();
	СтрокаЗачета.Основание = Аванс.Ссылка;
	СтрокаЗачета.Сумма = 6 * Цена;
	// BSLLS:MagicNumber-on
	Провести(Реализация2);
	Расчет = ПроверитьСтадиюЗаказа(Заказ, Стадии.Выполнен, "●●●●●", "зачёт аванса во второй реализации");
	ПроверитьРавенство(1, Расчет.ДоляОплаты, "доля оплаты выполненного заказа");

	Оплата1.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьСтадиюЗаказа(Заказ, Стадии.ОжидаетОплаты, "●●●●◐", "отмена проведения оплаты первой реализации");

КонецПроцедуры

// Шаг 8: заказ без закупок и выпуска, отгруженный со склада, - «Ожидает оплаты», а не «Заказ поставщику»; заказ без
// материалов - «Формируется потребность», аванс по строке оснований на заказ двигает только долю оплаты.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПозднююВехуСтадии(Контекст)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Заказ = ЗаказНаПроизводствоСтадии(Контекст, 1);
	Провести(Заказ);
	ПроверитьСтадиюЗаказа(Заказ.Ссылка, Стадии.ЗаказПоставщику, "○○○○○", "заказ без закупок");
	ДокументЗакупки(Контекст, Контекст.Продукция, 1, Контекст.Числа.ЦенаЗакупки);
	Провести(РеализацияСтадии(Контекст, Заказ.Ссылка));
	ПроверитьСтадиюЗаказа(Заказ.Ссылка, Стадии.ОжидаетОплаты, "○○○●○", "поздняя веха: отгрузка без закупок и выпуска");

	БезМатериалов = ЗаказКлиентаСценария(Контекст);
	БезМатериалов.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Провести(БезМатериалов);
	ПроверитьСтадиюЗаказа(БезМатериалов.Ссылка, Стадии.ФормируетсяПотребность, "○○○○○", "заказ без материалов");
	ДокументОплатыВКассу(Контекст, БезМатериалов.Ссылка, Контекст.Числа.ЦенаПродажи);
	Расчет = ПроверитьСтадиюЗаказа(БезМатериалов.Ссылка, Стадии.ФормируетсяПотребность, "○○○○◐",
		"аванс по строке оснований на заказ");
	ПроверитьРавенство(-Контекст.Числа.ЦенаПродажи, Расчет.Долг, "долг заказа после аванса");

КонецПроцедуры

// Шаг 9: отмена проведения заказа со связанными закупками, выпусками и реализациями.
//
// Параметры:
//  Данные - Структура - см. ПроверитьЧерновикИПроведениеСтадии
//
Процедура ПроверитьОтменуПроведенияЗаказаСтадии(Данные)

	Заказ = Данные.Заказ;
	Заказ.Прочитать();
	Заказ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьСтадиюЗаказа(Заказ.Ссылка, Перечисления.СтатусыЗаказовПокупателя.Черновик, "○○●●◐",
		"отмена проведения заказа со связанными документами");
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(Заказ.Ссылка), "движений потребности после отмены проведения заказа");

КонецПроцедуры

// Шаг 10: заказ-продажа и реализация по нему - прежние статусы; заказ на производство, переведённый в продажу
// записью и вместе с отменой проведения, - «Новый».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьПродажиБезСтадий(Контекст)

	Стадии = Перечисления.СтатусыЗаказовПокупателя;
	Продажа = ДокументЗаказаПокупателя(Контекст, Контекст.Товар, 1, Контекст.Числа.ЦенаПродажи);
	Проверить(ПроизводственныеЗаказы.РассчитатьСтадию(Продажа) = Неопределено, "у продажи нет расчёта стадии");
	ПроверитьСтатусПродажи(Продажа, Стадии.Новый, "запись продажи");
	ДокументРеализацииПоЗаказу(Контекст, Продажа);
	ПроверитьСтатусПродажи(Продажа, Стадии.Собран, "реализация по продаже");

	Черновик = ЗаказНаПроизводствоСтадии(Контекст, 1);
	Записать(Черновик);
	ПроверитьСтадиюЗаказа(Черновик.Ссылка, Стадии.Черновик, "○○○○○", "черновик перед сменой вида операции");
	Черновик.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	Черновик.Записать();
	ПроверитьСтатусПродажи(Черновик.Ссылка, Стадии.Новый, "черновик, переведённый в продажу");

	Проведенный = ЗаказКлиентаСценария(Контекст);
	Проведенный.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Провести(Проведенный);
	Проведенный.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Продажа;
	Проведенный.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьСтатусПродажи(Проведенный.Ссылка, Стадии.Новый, "смена вида операции вместе с отменой проведения");

КонецПроцедуры

// Лимит строки продукции (2.0.16.57, ревью кода Codex сборки 3, P2): заказ с двумя строками одной продукции, 10 и 5 -
// требование на 8 по второй строке в пределах продукции (15), но сверх строки - запрет; на 5 - в пределах.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеТребованияСценария
//
Процедура ПроверитьПревышениеСтроки(Контекст, Данные)

	// BSLLS:MagicNumber-off
	Заказ = ЗаказНаПроизводствоСтадии(Контекст, 10);
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, 5, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[2], Контекст.Сырье, Контекст.Числа.РасходСырьяНаЕдиницу);
	Провести(Заказ);
	ДанныеСтроки = Новый Структура("Станок, Заказ, КодСтроки", Данные.Станок, Заказ.Ссылка, Заказ.ТЧТовары[2].КодСтроки);
	Требование = НовоеТребованиеСценария(Контекст, ДанныеСтроки, 8);
	Проверить(ЗначениеЗаполнено(ТребованияНакладные.ТекстПревышенияЗаказа(Требование, 8)), "лимит строки: 8 > 5 строки");
	ПроверитьРавенство("", ТребованияНакладные.ТекстПревышенияЗаказа(Требование, 5), "лимит строки: 5 в пределах");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Заказ на производство: строка товара контекста и строка продукции с материалом по карте (2 сырья на единицу).
//
// Параметры:
//  Контекст  - Структура - см. НовыйКонтекст
//  Продукции - Число - количество продукции
//
// Возвращаемое значение:
//  ДокументОбъект.ЗаказПокупателя - незаписанный заказ
//
Функция ЗаказНаПроизводствоСтадии(Контекст, Продукции)

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, Продукции, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Контекст.Сырье, Контекст.Числа.РасходСырьяНаЕдиницу);
	Возврат Заказ;

КонецФункции

// Проведённый ручной выпуск продукции контекста с основанием - заказом и сырьём по карте.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Заказ      - ДокументСсылка.ЗаказПокупателя - основание
//  Количество - Число - выпуск
//
Процедура ВыпускСтадии(Контекст, Заказ, Количество)

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Основание = Заказ;
	Выпуск.Номенклатура = Контекст.Продукция;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = Количество;
	Выпуск.Количество = Количество;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ЗаполнитьСырьеПоТехкарте(Контекст, Выпуск, Количество);
	Провести(Выпуск);

КонецПроцедуры

// Реализация, заполненная по заказу, со складом сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументСсылка.ЗаказПокупателя - основание
//
// Возвращаемое значение:
//  ДокументОбъект.РеализацияТоваровУслуг - непроведённая реализация
//
Функция РеализацияСтадии(Контекст, Заказ)

	Реализация = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	Реализация.Заполнить(Заказ);
	Реализация.Дата = СледующаяДата(Контекст);
	Реализация.МестоХранения = Контекст.Склад;
	Реализация.Комментарий = ПометкаТеста();
	Возврат Реализация;

КонецФункции

// Стадия и индикатор расчёта совпадают с ожидаемыми и с последней записью истории.
//
// Параметры:
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  Стадия    - ПеречислениеСсылка.СтатусыЗаказовПокупателя - ожидаемая стадия
//  Индикатор - Строка - ожидаемый индикатор
//  Описание  - Строка - шаг сценария
//
// Возвращаемое значение:
//  Структура - см. ПроизводственныеЗаказы.РассчитатьСтадию
//
Функция ПроверитьСтадиюЗаказа(Заказ, Стадия, Индикатор, Описание)

	Расчет = ПроизводственныеЗаказы.РассчитатьСтадию(Заказ);
	Проверить(Расчет <> Неопределено, Описание + ": нет расчёта стадии у заказа на производство");
	ПроверитьРавенство(Стадия, Расчет.Стадия, Описание + " - стадия расчёта");
	ПроверитьРавенство(Индикатор, Расчет.Индикатор, Описание + " - индикатор расчёта");
	Запись = ПроизводственныеЗаказы.ДанныеСтадии(Заказ);
	Проверить(Запись <> Неопределено, Описание + ": нет записи истории");
	ПроверитьРавенство(Стадия, Запись.Стадия, Описание + " - стадия в истории");
	ПроверитьРавенство(Индикатор, Запись.Индикатор, Описание + " - индикатор в истории");
	Возврат Расчет;

КонецФункции

// Последняя запись истории заказа-продажи: ожидаемый статус без индикатора.
//
// Параметры:
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ
//  Статус   - ПеречислениеСсылка.СтатусыЗаказовПокупателя - ожидаемый статус
//  Описание - Строка - шаг сценария
//
Процедура ПроверитьСтатусПродажи(Заказ, Статус, Описание)

	Запись = ПроизводственныеЗаказы.ДанныеСтадии(Заказ);
	Проверить(Запись <> Неопределено, Описание + ": нет записи истории");
	ПроверитьРавенство(Статус, Запись.Стадия, Описание + " - статус");
	Проверить(Не Запись.ЭтоЗаписьСтадии, Описание + ": у продажи записана стадия");

КонецПроцедуры

// Число записей истории статусов заказа.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ
//
// Возвращаемое значение:
//  Число - записей регистра по заказу
//
Функция ЧислоЗаписейИстории(Заказ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Записей
	|ИЗ
	|	РегистрСведений.ИсторияЗаказовПокупателейПоСтатусам КАК История
	|ГДЕ
	|	История.ЗаказПокупателя = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Записей;

КонецФункции

#КонецОбласти

#Область АвтовыпускПриОтгрузке

// Автовыпуск при отгрузке (E9): проведение реализации по заказу на производство создаёт выпуск продукции на секунду
// раньше, материалы - из партий под заказ, затем из общей очереди с «ИзОстатка»; реализация списывает продукцию по ФИФО.
// Шаг между документами - две секунды. Настоящий отказ проведения - последним шагом: после исключения транзакция
// сценария годится только для отката.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАвтовыпускПриОтгрузке(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Данные = ДанныеАвтовыпускаСценария(Контекст);
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	ПроверитьПервуюОтгрузкуАвтовыпуска(Контекст, Данные);
	ПроверитьВторуюОтгрузкуАвтовыпуска(Контекст, Данные);
	ПроверитьОтменуИПометкуАвтовыпуска(Данные);
	ПроверитьЗапретыАвтовыпуска(Контекст, Данные);
	ПроверитьОднуСекундуАвтовыпуска(Контекст);
	ПроверитьСериюАвтовыпуска(Контекст);
	ПроверитьПризнакАвтосоздания(Контекст, Данные);
	ПроверитьСкладскойОстатокАвтовыпуска(Контекст);
	// Отказ проведения отравляет транзакцию сценария: после него запросы уже не выполняются, поэтому
	// шаг с настоящим отказом остаётся последним - соглашение сценариев проекта.
	ПроверитьОтказПоМатериаламАвтовыпуска(Контекст);

	Возврат РезультатСценария("автовыпуск на секунду раньше реализации, партии под заказ и продукция по техкарте, "
		+ "себестоимость продажи из выпуска, ручной выпуск и «ИзОстатка», перепроведение без дублей, отмена проведения "
		+ "и перенос пометки удаления, запрет правки, выключенная константа и продажа без автовыпуска, граница по "
		+ "моменту времени, две реализации в одну секунду, серия продукции, отказ по нехватке материалов, "
		+ "признак автосоздания у автовыпуска и его копии, обработчик обновления и его повтор, свободный остаток "
		+ "склада раньше производства (S9): покрытие, частичное покрытие, реализация задним числом, дефицит заказа");

КонецФункции

// Шаг 1: остатки, продукция P2 по техкарте, заказ на производство P1 x 10 (M1 x 2), закупка M1 x 12 под заказ.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - документы и номенклатура сценария
//
Функция ДанныеАвтовыпускаСценария(Контекст)

	Данные = Новый Структура;
	Данные.Вставить("M1", Контекст.Сырье);
	Данные.Вставить("P1", Контекст.Продукция);
	Данные.Вставить("M2", НоваяНоменклатура(Контекст, "сырьё 2", Перечисления.ТипыНоменклатуры.Сырье));
	Данные.Вставить("P2", НоваяНоменклатура(Контекст, "продукция по техкарте", Перечисления.ТипыНоменклатуры.Продукция));
	// BSLLS:MagicNumber-off - остатки: товар 3 по 50, M1 50 по 40, M2 10 по 30; заказ P1 10, P2 3; под заказ M1 12.
	ТехнологическиеКарты.ЗаписатьТехкарту(Данные.P2, СоставИзМатериала(Контекст, Данные.M2, 1), Контекст.Дата);
	ДокументЗакупки(Контекст, Контекст.Товар, 3, 50);
	ДокументЗакупки(Контекст, Данные.M1, 50, 40);
	ДокументЗакупки(Контекст, Данные.M2, 10, 30);

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.P1, 10, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], Данные.M1, 2);
	Провести(Заказ);
	Данные.Вставить("Заказ", Заказ.Ссылка);

	ЗаказПоставщику = НовыйЗаказПоставщикуПотребности(Контекст, Заказ.Ссылка);
	Провести(ЗаказПоставщику);
	Поступление = НовоеПоступлениеПотребности(Контекст, ЗаказПоставщику.Ссылка);
	УстановитьКоличествоСтроки(Поступление.ТЧТовары[0], 12);
	// BSLLS:MagicNumber-on
	Провести(Поступление);
	Данные.Вставить("Поступление", Поступление.Ссылка);
	Возврат Данные;

КонецФункции

// Шаг 2: реализация T x 3, P1 x 6 - расчёт без записи, проведение, себестоимость и стадия; продукция без материалов
// в заказе - по техкарте (проведение заказа такую строку продукции со способом «Производство» не пропускает (E6), поэтому
// ветка проверяется на записанном заказе).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАвтовыпускаСценария
//
Процедура ПроверитьПервуюОтгрузкуАвтовыпуска(Контекст, Данные)

	Реализация = РеализацияАвтовыпуска(Контекст, Данные.Заказ);
	// BSLLS:MagicNumber-off - P1 6 из 10; M1 12 партией под заказ по 10, товар 3 по 50; P2 3 по техкарте (M2 3).
	УстановитьКоличествоСтроки(Реализация.ТЧТовары[1], 6);
	Расчет = Производство.ДанныеАвтовыпуска(Реализация);
	Проверить(Расчет.Активен, "автовыпуск реализации по заказу на производство активен");
	ПроверитьРавенство("P1 6", ПродукцияАвтовыпускаСтрокой(Данные, Расчет.Продукция), "продукция расчёта");
	ПроверитьРавенство("M1 12 под заказ", МатериалыАвтовыпускаСтрокой(Данные, Расчет.Материалы), "материалы расчёта");
	ПроверитьРавенство(0, Расчет.ИзОстатка.Количество(), "«ИзОстатка» при покрытии партиями под заказ");

	ЗаказПоТехкарте = ЗаказКлиентаСценария(Контекст);
	ЗаказПоТехкарте.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ЗаказПоТехкарте.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, ЗаказПоТехкарте, "ТЧТовары", Данные.P2, 3, Контекст.Числа.ЦенаПродажи);
	Записать(ЗаказПоТехкарте);
	РеализацияПоТехкарте = РеализацияСтадии(Контекст, ЗаказПоТехкарте.Ссылка);
	РасчетПоТехкарте = Производство.ДанныеАвтовыпуска(РеализацияПоТехкарте);
	ПроверитьРавенство("P2 3", ПродукцияАвтовыпускаСтрокой(Данные, РасчетПоТехкарте.Продукция),
		"продукция без материалов в заказе - по техкарте");
	ПроверитьРавенство("M2 3", МатериалыАвтовыпускаСтрокой(Данные, РасчетПоТехкарте.Материалы), "материалы по техкарте");
	ПроверитьРавенство(0, РасчетПоТехкарте.ИзОстатка.Количество(), "«ИзОстатка» без потребности заказа");

	Провести(Реализация);
	Автовыпуск = ЕдинственныйАвтовыпуск(Реализация.Ссылка, "первая реализация");
	Проверить(Не ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Данные.P1, НачалоДня(Контекст.Дата)),
		"автовыпуск не требует ручного перезаполнения при смене карты");
	ПроверитьРавенство(Реализация.Дата - 1, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "Дата"),
		"дата автовыпуска на секунду раньше реализации");
	ПроверитьРавенство(120, СуммаПриходаВыпуска(Автовыпуск), "себестоимость автовыпуска: M1 12 x 10");
	ПроверитьРавенство(270, ОборотыПродаж(Реализация.Ссылка).Себестоимость,
		"себестоимость продажи: автовыпуск 120 + товар 150");
	Остаток = ОстатокТовара(Контекст.Склад, Данные.M1);
	ПроверитьРавенство(50, Остаток.Количество, "общая партия M1 не тронута");
	ПроверитьРавенство(2000, Остаток.Сумма, "стоимость общей партии M1");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, Данные.P1).Количество, "остаток P1 после отгрузки");
	// BSLLS:MagicNumber-on
	ПроверитьСтадиюЗаказа(Данные.Заказ, Перечисления.СтатусыЗаказовПокупателя.ВосполнениеПотребности, "●◐◐◐○",
		"первая реализация с автовыпуском");
	Данные.Вставить("Реализация1", Реализация.Ссылка);
	ПроверитьЗапретПоступленияДоАвтовыпуска(Данные, Реализация);

КонецПроцедуры

// Валютная налоговая накладная покупки, проведённая до 2.0.16.41 (начисление в валюте документа), попадает в список
// обработчика к перепроведению, перепроведение переводит начисление в основную валюту и убирает её из списка; движения
// обработчик не переписывает (ревью техдолга Codex 2026-10-09, T22).
//
// Параметры:
//  Накладная - ДокументОбъект.НалоговаяНакладнаяПокупка - проведённая валютная накладная.
//  Ожидаемое - Число - начисление в основной валюте.
//
Процедура ПроверитьОбработчикНалоговыхДокументовПокупки(Накладная, Ожидаемое)

	ВидОперации = Перечисления.ВидыОперацийНалоговые.Накладная;
	// BSLLS:YoLetterUsage-off - имя регистра
	Набор = РегистрыНакопления.ВзаиморасчётыСПоcтавщикамиНалоговый.СоздатьНаборЗаписей();
	// BSLLS:YoLetterUsage-on
	Набор.Отбор.Регистратор.Установить(Накладная.Ссылка);
	Набор.Прочитать();
	ПроверитьРавенство(Ожидаемое, СуммаНачисленияНабора(Набор, ВидОперации), "T22: проведение - начисление в основной валюте");
	КПерепроведению = ОбновлениеПрограммыОбработчики.НалоговыеДокументыПокупкиКПерепроведению();
	Проверить(КПерепроведению.Найти(Накладная.Ссылка) = Неопределено, "T22: пересчитанная накладная - не к перепроведению");
	Для Каждого Запись Из Набор Цикл
		Если Запись.ВидОперации = ВидОперации Тогда
			Запись.Сумма = Накладная.Сумма;
		КонецЕсли;
	КонецЦикла;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	КПерепроведению = ОбновлениеПрограммыОбработчики.НалоговыеДокументыПокупкиКПерепроведению();
	Проверить(КПерепроведению.Найти(Накладная.Ссылка) <> Неопределено,
		"T22: начисление в валюте документа - накладная к перепроведению");
	ОбновлениеПрограммыОбработчики.НайтиНалоговыеДокументыПокупкиКПерепроведению();
	Набор.Прочитать();
	ПроверитьРавенство(Накладная.Сумма, СуммаНачисленияНабора(Набор, ВидОперации), "T22: обработчик движения не меняет");
	// Свежий объект: повторное проведение того же экземпляра задваивает его движения (TECHDEBT).
	Провести(Накладная.Ссылка.ПолучитьОбъект());
	Набор.Прочитать();
	ПроверитьРавенство(Ожидаемое, СуммаНачисленияНабора(Набор, ВидОперации), "T22: перепроведение - в основной валюте");

КонецПроцедуры

// Сумма записей набора налогового регистра с видом операции.
//
// Параметры:
//  Набор       - РегистрНакопленияНаборЗаписей - прочитанный набор.
//  ВидОперации - ПеречислениеСсылка.ВидыОперацийНалоговые - вид операции.
//
// Возвращаемое значение:
//  Число - сумма.
//
Функция СуммаНачисленияНабора(Набор, ВидОперации)

	Сумма = 0;
	Для Каждого Запись Из Набор Цикл
		Если Запись.ВидОперации = ВидОперации Тогда
			Сумма = Сумма + Запись.Сумма;
		КонецЕсли;
	КонецЦикла;
	Возврат Сумма;

КонецФункции

// Поступление из переработки по заказу датой раньше реализации с автовыпуском той же продукции - запрет проведения,
// другой продукции или датой позже - нет (ревью техдолга Codex 2026-10-09, T12).
//
// Параметры:
//  Данные     - Структура - см. ДанныеАвтовыпускаСценария
//  Реализация - ДокументОбъект.РеализацияТоваровУслуг - проведённая реализация заказа с автовыпуском P1.
//
Процедура ПроверитьЗапретПоступленияДоАвтовыпуска(Данные, Реализация)

	Поступление = Документы.ПоступлениеИзПереработки.СоздатьДокумент();
	Поступление.ТЧГотоваяПродукция.Добавить().Номенклатура = Данные.P1;
	Своя = Поступление.ТЧГотоваяПродукция.Выгрузить(, "Номенклатура, Характеристика");
	Поступление.ТЧГотоваяПродукция[0].Номенклатура = Данные.M1;
	Другая = Поступление.ТЧГотоваяПродукция.Выгрузить(, "Номенклатура, Характеристика");
	Ссылка = Документы.ПоступлениеИзПереработки.ПолучитьСсылку();
	// BSLLS:MagicNumber-off - автовыпуск на секунду раньше реализации, поступление - ещё раньше.
	Раньше = Новый МоментВремени(Реализация.Дата - 2, Ссылка);
	// BSLLS:MagicNumber-on
	Позже = Новый МоментВремени(Реализация.Дата + 1, Ссылка);
	Текст = ПроизводственныеЗаказы.ТекстЗапретаПорядкаВыпускаИОтгрузки(Ссылка, Данные.Заказ, Раньше, Своя);
	Проверить(ЗначениеЗаполнено(Текст), "T12: поступление продукции автовыпуска раньше реализации - запрет");
	Текст = ПроизводственныеЗаказы.ТекстЗапретаПорядкаВыпускаИОтгрузки(Ссылка, Данные.Заказ, Раньше, Другая);
	Проверить(Не ЗначениеЗаполнено(Текст), "T12: другой продукции раньше реализации - без запрета");
	Текст = ПроизводственныеЗаказы.ТекстЗапретаПорядкаВыпускаИОтгрузки(Ссылка, Данные.Заказ, Позже, Своя);
	Проверить(Не ЗначениеЗаполнено(Текст), "T12: после реализации - без запрета");

КонецПроцедуры

// Шаги 3-4: ручной выпуск P1 x 2 по заказу, реализация P1 x 4 берёт 2 со склада и выпускает 2 из общей очереди
// («ИзОстатка» 4), перепроведение без дублей. До S9 те же 2 вычитались как документное «свободно» ручного выпуска;
// с S9 - как свободный складской остаток, число то же.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАвтовыпускаСценария
//
Процедура ПроверитьВторуюОтгрузкуАвтовыпуска(Контекст, Данные)

	// BSLLS:MagicNumber-off - ручной выпуск 2 (M1 4 по 40), реализация 4: автовыпуск 2 (M1 4 по 40).
	ВыпускСтадии(Контекст, Данные.Заказ, 2);
	Проверить(ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Данные.P1, НачалоДня(Контекст.Дата)),
		"ручной выпуск рядом с автовыпуском требует перезаполнения при смене карты");
	Реализация = РеализацияАвтовыпуска(Контекст, Данные.Заказ);
	Реализация.ТЧТовары.Удалить(0);
	УстановитьКоличествоСтроки(Реализация.ТЧТовары[0], 4);
	Расчет = Производство.ДанныеАвтовыпуска(Реализация);
	ПроверитьРавенство("P1 2", ПродукцияАвтовыпускаСтрокой(Данные, Расчет.Продукция),
		"к выпуску: отгрузка 4 минус свободный складской остаток 2");
	ПроверитьРавенство("M1 4", МатериалыАвтовыпускаСтрокой(Данные, Расчет.Материалы), "M1 из общей очереди");

	Провести(Реализация);
	Автовыпуск = ЕдинственныйАвтовыпуск(Реализация.Ссылка, "вторая реализация");
	ПроверитьРавенство(4, ИзОстаткаДвижений(Автовыпуск), "«ИзОстатка» автовыпуска");
	ПроверитьРавенство(320, ОборотыПродаж(Реализация.Ссылка).Себестоимость,
		"себестоимость продажи: партия ручного выпуска 160 + автовыпуска 160");
	ПроверитьРавенство(42, ОстатокТовара(Контекст.Склад, Данные.M1).Количество, "M1 после второй реализации");
	// С 2.0.16.109 ручной выпуск по заказу тоже пишет «ИзОстатка» (M1 4 со свободного склада): материалы покрыты целиком.
	Расчет = ПроверитьСтадиюЗаказа(Данные.Заказ, Перечисления.СтатусыЗаказовПокупателя.ОжидаетОплаты, "●●●●○",
		"вторая реализация: «ИзОстатка» в поступлении");
	ПроверитьРавенство(1, Расчет.ДоляПоступления,
		"доля поступления: пришло 12 + из остатка автовыпуска 4 и ручного выпуска 4 из 20");

	Реализация.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(Автовыпуск, ЕдинственныйАвтовыпуск(Реализация.Ссылка, "перепроведение"), "тот же автовыпуск");
	ПроверитьРавенство(4, ИзОстаткаДвижений(Автовыпуск), "«ИзОстатка» после перепроведения");
	ПроверитьРавенство(42, ОстатокТовара(Контекст.Склад, Данные.M1).Количество, "M1 после перепроведения");
	// BSLLS:MagicNumber-on
	Данные.Вставить("Реализация2", Реализация);
	Данные.Вставить("Автовыпуск2", Автовыпуск);

КонецПроцедуры

// Шаг 5: отмена проведения второй реализации распроводит автовыпуск, пометка удаления переходит и снимается,
// повторное проведение проводит тот же автовыпуск.
//
// Параметры:
//  Данные - Структура - см. ПроверитьВторуюОтгрузкуАвтовыпуска
//
Процедура ПроверитьОтменуИПометкуАвтовыпуска(Данные)

	Реализация = Данные.Реализация2;
	Автовыпуск = Данные.Автовыпуск2;
	Реализация.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Проверить(Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "Проведен"),
		"автовыпуск распроведён отменой проведения реализации");
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(Автовыпуск), "движения потребностей распроведённого автовыпуска");
	ПроверитьСтадиюЗаказа(Данные.Заказ, Перечисления.СтатусыЗаказовПокупателя.ВосполнениеПотребности, "●◐◐◐○",
		"отмена проведения второй реализации");

	Реализация.УстановитьПометкуУдаления(Истина);
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "ПометкаУдаления"),
		"пометка удаления реализации перешла на автовыпуск");
	Реализация.УстановитьПометкуУдаления(Ложь);
	Проверить(Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "ПометкаУдаления"),
		"снятие пометки удаления реализации снято у автовыпуска");

	Провести(Реализация);
	ПроверитьРавенство(Автовыпуск, ЕдинственныйАвтовыпуск(Реализация.Ссылка, "повторное проведение"),
		"повторное проведение - тот же автовыпуск");
	// Материалы - «●»: ручной выпуск пишет «ИзОстатка» с 2.0.16.109 (см. ПроверитьВторуюОтгрузкуАвтовыпуска).
	ПроверитьСтадиюЗаказа(Данные.Заказ, Перечисления.СтатусыЗаказовПокупателя.ОжидаетОплаты, "●●●●○",
		"повторное проведение второй реализации");

КонецПроцедуры

// Шаг 6: без записи - запрет правки автовыпуска и ручного выпуска с основанием-реализацией, выключенная константа,
// продажа, граница по моменту времени.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ПроверитьВторуюОтгрузкуАвтовыпуска
//
Процедура ПроверитьЗапретыАвтовыпуска(Контекст, Данные)

	Отказ = Ложь;
	Производство.ПроверитьПравкуАвтовыпуска(Данные.Автовыпуск2.ПолучитьОбъект(), Отказ);
	Проверить(Отказ, "ручная правка автовыпуска отклоняется");
	Ручной = НовыйДокумент(Контекст, "ВыпускПродукции");
	Ручной.Основание = Данные.Реализация1;
	Отказ = Ложь;
	Производство.ПроверитьПравкуАвтовыпуска(Ручной, Отказ);
	Проверить(Отказ, "ручной выпуск с основанием-реализацией отклоняется");
	ПолучитьСообщенияПользователю(Истина);

	// Первая реализация предшествует ручному выпуску и второй реализации: их её расчёт не учитывает.
	Расчет = Производство.ДанныеАвтовыпуска(Данные.Реализация1);
	ПроверитьРавенство("P1 6", ПродукцияАвтовыпускаСтрокой(Данные, Расчет.Продукция),
		"граница по моменту времени: поздние выпуски и реализации не учитываются");

	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Ложь);
	Расчет = Производство.ДанныеАвтовыпуска(Данные.Реализация1);
	Проверить(Не Расчет.Управляется И Не Расчет.Активен, "выключенная константа: автовыпуск не управляется");
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);

	Продажа = ДокументЗаказаПокупателя(Контекст, Контекст.Товар, 1, Контекст.Числа.ЦенаПродажи);
	РеализацияПродажи = НовыйДокумент(Контекст, "РеализацияТоваровУслуг");
	РеализацияПродажи.Заполнить(Продажа);
	Проверить(Не Производство.ДанныеАвтовыпуска(РеализацияПродажи).Активен, "реализация по продаже без автовыпуска");

КонецПроцедуры

// Шаг 10: признак «создан автоматически» отличает автовыпуск от ручного выпуска, а обработчик обновления 2.0.15.42
// проставляет его выпускам, созданным до появления реквизита.
//
// Обработчик проверяется здесь, а не прогоном обновления базы: при технологическом запуске (scripts/doctests.sh)
// ПриНачалеРаботыСистемы выходит на АвтотестыКлиент.ОбработатьЗапускТеста до ОбновлениеПрограммыКлиент.ОбработатьНачалоРаботы,
// то есть ВыполнитьОбновление на тестовой базе не вызывается никогда. Без этого шага первая проба обработчика
// пришлась бы на данные клиента.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАвтовыпускаСценария
//
Процедура ПроверитьПризнакАвтосоздания(Контекст, Данные)

	Проверить(Производство.ЭтоАвтовыпуск(Данные.Автовыпуск2), "у автовыпуска есть признак автосоздания");

	// Копия автовыпуска - ручной выпуск по заказу: без снятия признака она осталась бы неправимой навсегда.
	Копия = Данные.Автовыпуск2.Скопировать();
	Проверить(Не Копия.СозданАвтоматически, "копия автовыпуска признака не наследует");
	ПроверитьРавенство(Данные.Заказ, Копия.Основание, "основание копии автовыпуска - заказ реализации");

	Ручной = РучнойВыпускПризнака(Контекст, Данные);
	Проверить(Не Производство.ЭтоАвтовыпуск(Ручной), "ручной выпуск признака не получает");

	// Выпуск, созданный до появления реквизита: признак снимается прямой записью в режиме загрузки.
	ДвиженияДо = СнимокДвиженийДокумента(Данные.Автовыпуск2);
	Объект = Данные.Автовыпуск2.ПолучитьОбъект();
	Объект.СозданАвтоматически = Ложь;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Проверить(Не Производство.ЭтоАвтовыпуск(Данные.Автовыпуск2), "признак снят прямой записью");

	ОбновлениеПрограммыОбработчики.ЗаполнитьПризнакАвтовыпусков();
	Проверить(Производство.ЭтоАвтовыпуск(Данные.Автовыпуск2), "обработчик обновления проставил признак");
	Проверить(Данные.Автовыпуск2.Проведен, "обработчик обновления не распровёл выпуск");
	ПроверитьРавенство(ДвиженияДо, СнимокДвиженийДокумента(Данные.Автовыпуск2),
		"обработчик обновления не изменил движения");
	Проверить(Не Производство.ЭтоАвтовыпуск(Ручной), "обработчик обновления не трогает ручной выпуск по заказу");

	// Повтор: уже обработанные документы не выбираются, признаки не меняются.
	ОбновлениеПрограммыОбработчики.ЗаполнитьПризнакАвтовыпусков();
	Проверить(Производство.ЭтоАвтовыпуск(Данные.Автовыпуск2), "повторный запуск обработчика сохраняет признак");
	Проверить(Не Производство.ЭтоАвтовыпуск(Ручной), "повторный запуск не помечает ручной выпуск");
	ПроверитьРавенство(ДвиженияДо, СнимокДвиженийДокумента(Данные.Автовыпуск2),
		"повторный запуск не изменил движения");

КонецПроцедуры

// Записанный (непроведённый) ручной выпуск по заказу сценария - образец документа без признака автосоздания.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеАвтовыпускаСценария
//
// Возвращаемое значение:
//  ДокументСсылка.ВыпускПродукции - записанный выпуск
//
Функция РучнойВыпускПризнака(Контекст, Данные)

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Основание = Данные.Заказ;
	Выпуск.Номенклатура = Данные.P1;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = 1;
	Выпуск.Количество = 1;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	Выпуск.Записать();
	Возврат Выпуск.Ссылка;

КонецФункции

// Шаг 11 (S9): свободный складской остаток идёт в отгрузку раньше производства. Своя номенклатура: P4 по заказу Б
// x 8 с M4 x 1 на единицу, M4 20 по 10 и P4 5 по 70 закупкой - свободный остаток не под заказ.
//
// Себестоимость САМОЙ отгрузки правило не различает: реализация списывает по ФИФО даты партии, партия автовыпуска
// (реализация - 1 с) самая свежая, и до S9 продажа тоже ушла бы по закупке. Различают правила сырьё и остаток
// продукции - их шаг и проверяет, называя значения по обоим правилам.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьСкладскойОстатокАвтовыпуска(Контекст)

	M4 = НоваяНоменклатура(Контекст, "сырьё свободного остатка", Перечисления.ТипыНоменклатуры.Сырье);
	P4 = НоваяНоменклатура(Контекст, "продукция свободного остатка", Перечисления.ТипыНоменклатуры.Продукция);
	// BSLLS:MagicNumber-off - M4 20 по 10, P4 5 по 70; заказ P4 8, M4 1 на единицу; отгрузки 3, 4 и 1 задним числом.
	ДокументЗакупки(Контекст, M4, 20, 10);
	ДокументЗакупки(Контекст, P4, 5, 70);
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", P4, 8, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], M4, 1);
	Провести(Заказ);
	// Секунда для реализации задним числом: её автовыпуск ляжет в пропущенную секунду перед ней, после закупок.
	ДатаЗаднимЧислом = ДатаЧерезДвеСекунды(Контекст);

	Первая = РеализацияПродукцииАвтовыпуска(Контекст, Заказ.Ссылка, 3, ДатаЧерезДвеСекунды(Контекст));
	Провести(Первая);
	ПроверитьРавенство(0, ЧислоВыпусковОснования(Первая.Ссылка),
		"свободный остаток 5 покрыл отгрузку 3: автовыпуска нет (до S9 - выпуск 3)");
	ПроверитьРавенство(20, ОстатокТовара(Контекст.Склад, M4).Количество, "M4 не списано (до S9 - 17)");
	Остаток = ОстатокТовара(Контекст.Склад, P4);
	ПроверитьРавенство(2, Остаток.Количество, "остаток P4 после отгрузки со склада (до S9 - 5)");
	ПроверитьРавенство(140, Остаток.Сумма, "стоимость остатка P4: 2 x 70 (до S9 - 170 с партией автовыпуска 3 x 10)");
	ПроверитьРавенство(210, ОборотыПродаж(Первая.Ссылка).Себестоимость,
		"себестоимость продажи: 3 x 70 - та же и до S9, ФИФО не берёт свежую партию автовыпуска");

	Вторая = РеализацияПродукцииАвтовыпуска(Контекст, Заказ.Ссылка, 4, ДатаЧерезДвеСекунды(Контекст));
	Провести(Вторая);
	Автовыпуск = ЕдинственныйАвтовыпуск(Вторая.Ссылка, "частичный свободный остаток");
	ПроверитьРавенство(2, ВыпущеноАвтовыпуском(Вторая.Ссылка), "к выпуску: отгрузка 4 минус свободный остаток 2");
	ПроверитьРавенство(18, ОстатокТовара(Контекст.Склад, M4).Количество, "M4 после частичного покрытия (до S9 - 13)");
	ПроверитьРавенство(160, ОборотыПродаж(Вторая.Ссылка).Себестоимость, "себестоимость продажи: 2 x 70 + 2 x 10");
	Вторая.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(Автовыпуск, ЕдинственныйАвтовыпуск(Вторая.Ссылка, "перепроведение при частичном остатке"),
		"перепроведение - тот же автовыпуск");
	ПроверитьРавенство(2, ВыпущеноАвтовыпуском(Вторая.Ссылка), "перепроведение не изменило количество");
	ПроверитьРавенство(18, ОстатокТовара(Контекст.Склад, M4).Количество, "M4 после перепроведения");

	// Задним числом, до первой реализации: на границе на складе 5, но все 5 уже нужны первой и второй.
	ЗаднимЧислом = РеализацияПродукцииАвтовыпуска(Контекст, Заказ.Ссылка, 1, ДатаЗаднимЧислом);
	Провести(ЗаднимЧислом);
	ПроверитьРавенство(1, ВыпущеноАвтовыпуском(ЗаднимЧислом.Ссылка),
		"реализация задним числом не забирает остаток, нужный более поздним отгрузкам");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, P4).Количество, "остаток P4 после всех отгрузок");
	// Собственные движения из последующих исключаются: приход своего автовыпуска на первом проходе перепроведения
	// и расход самого основания в расчёте по проведённому документу подняли бы или опустили свободный остаток.
	ЗаднимЧислом.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(1, ВыпущеноАвтовыпуском(ЗаднимЧислом.Ссылка),
		"перепроведение задним числом: собственный автовыпуск в свободный остаток не входит");
	ПроверитьРавенство(2, Производство.ДанныеАвтовыпуска(Вторая.Ссылка).Продукция.Итог("Количество"),
		"расчёт по проведённой второй: её собственная отгрузка последующим расходом не считается");

	Первая.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(0, ЧислоВыпусковОснования(Первая.Ссылка),
		"перепроведение первой: последующие отгрузки её остаток 3 не отнимают");

	Дефицит = 0;
	Отбор = Новый Структура("Материал", M4);
	Для Каждого Строка Из РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа(Заказ.Ссылка).НайтиСтроки(Отбор) Цикл
		Дефицит = Дефицит + Строка.Количество;
	КонецЦикла;
	ПроверитьРавенство(5, Дефицит,
		"дефицит M4: 8 минус «ИзОстатка» автовыпусков 2 + 1; взятое со склада потребность не уменьшает (решение S9)");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 7: две реализации одного заказа в одну секунду получают свои автовыпуски; перепроведение обеих не меняет их.
// С S9 шаг проверяет границу свободного остатка по НАЧАЛУ секунды: оба автовыпуска лежат в одной секунде, и приход
// автовыпуска второй в остаток на границе первой не попадает при любом порядке ссылок. Учёт последующих движений
// этот шаг не ловит - его держат шаг 11 и шаг 18 сценария передачи.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОднуСекундуАвтовыпуска(Контекст)

	// BSLLS:MagicNumber-off - заказ P1 10: отгрузки 6 и 4 в одну секунду.
	Заказ = ЗаказНаПроизводствоСтадии(Контекст, 10);
	Провести(Заказ);
	Дата = ДатаЧерезДвеСекунды(Контекст);
	Первая = РеализацияПродукцииАвтовыпуска(Контекст, Заказ.Ссылка, 6, Дата);
	Вторая = РеализацияПродукцииАвтовыпуска(Контекст, Заказ.Ссылка, 4, Дата);
	Провести(Первая);
	Провести(Вторая);
	ПроверитьРавенство(6, ВыпущеноАвтовыпуском(Первая.Ссылка), "первая реализация секунды");
	ПроверитьРавенство(4, ВыпущеноАвтовыпуском(Вторая.Ссылка), "вторая реализация секунды");
	Первая.Записать(РежимЗаписиДокумента.Проведение);
	Вторая.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(6, ВыпущеноАвтовыпуском(Первая.Ссылка), "первая реализация секунды после перепроведения");
	ПроверитьРавенство(4, ВыпущеноАвтовыпуском(Вторая.Ссылка), "вторая реализация секунды после перепроведения");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 8: продукция с серией в строке реализации выпускается с той же серией и списывается; материал с серией из
// общего остатка склада подбирается по серии.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьСериюАвтовыпуска(Контекст)

	СерияПродукции = НоваяСерия(Контекст.Продукция, "серия продукции");
	МатериалССерией = НоваяНоменклатура(Контекст, "сырьё с серией", Перечисления.ТипыНоменклатуры.Сырье);
	СерияМатериала = НоваяСерия(МатериалССерией, "серия сырья");
	// BSLLS:MagicNumber-off - остаток сырья с серией 5, на единицу продукции 2.
	Поступление = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Поступление.Контрагент = Контекст.Контрагент;
	Поступление.Договор = Контекст.ДоговорПоставщика;
	Поступление.ЦенаВключаетНДС = Истина;
	Поступление.Валюта = Контекст.Валюта;
	Поступление.КурсВалюты = 1;
	ДобавитьСтрокуТоваров(Контекст, Поступление, "ТЧТовары", МатериалССерией, 5, Контекст.Числа.ЦенаСырья);
	Поступление.ТЧТовары[0].Серия = СерияМатериала;
	Провести(Поступление);

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, 1, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], МатериалССерией, 2);
	Провести(Заказ);
	Реализация = РеализацияПродукцииАвтовыпуска(Контекст, Заказ.Ссылка, 1, ДатаЧерезДвеСекунды(Контекст));
	Реализация.ТЧТовары[0].Серия = СерияПродукции;
	Провести(Реализация);
	Автовыпуск = ЕдинственныйАвтовыпуск(Реализация.Ссылка, "реализация с серией");
	Строки = Автовыпуск.ТЧГотоваяПродукция.Выгрузить();
	ПроверитьРавенство(1, Строки.Количество(), "строк готовой продукции автовыпуска с серией");
	ПроверитьРавенство(СерияПродукции, Строки[0].Серия, "серия готовой продукции автовыпуска");
	Материалы = Автовыпуск.ТЧТовары.Выгрузить();
	ПроверитьРавенство(1, Материалы.Количество(), "строк материалов автовыпуска с серией");
	ПроверитьРавенство(СерияМатериала, Материалы[0].Серия, "серия материала из общего остатка");
	ПроверитьРавенство(2, ИзОстаткаДвижений(Автовыпуск), "«ИзОстатка» материала с серией");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Серия номенклатуры сценария.
//
// Параметры:
//  Владелец - СправочникСсылка.Номенклатура - номенклатура
//  Название - Строка - часть наименования
//
// Возвращаемое значение:
//  СправочникСсылка.СерииНоменклатуры - записанная серия
//
Функция НоваяСерия(Владелец, Название)

	Серия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
	Серия.Владелец = Владелец;
	Серия.Наименование = ПометкаТеста() + ": " + Название;
	Серия.Записать();
	Возврат Серия.Ссылка;

КонецФункции

// Шаг 9, последний: заказ P3 x 5 с M3 x 2 при остатке M3 3 - отказ проведения реализации с сообщением про M3.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказПоМатериаламАвтовыпуска(Контекст)

	ИмяМатериала = "сырьё 3";
	M3 = НоваяНоменклатура(Контекст, ИмяМатериала, Перечисления.ТипыНоменклатуры.Сырье);
	P3 = НоваяНоменклатура(Контекст, "продукция 3", Перечисления.ТипыНоменклатуры.Продукция);
	// BSLLS:MagicNumber-off - остаток M3 3, нужно 10.
	ДокументЗакупки(Контекст, M3, 3, Контекст.Числа.ЦенаСырья);
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", P3, 5, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[1], M3, 2);
	// BSLLS:MagicNumber-on
	Провести(Заказ);
	Реализация = РеализацияАвтовыпуска(Контекст, Заказ.Ссылка);
	Реализация.ТЧТовары.Удалить(0);
	ПолучитьСообщенияПользователю(Истина);
	Проведена = Истина;
	ТекстОшибки = "";
	Попытка
		Реализация.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		// После исключения в записи транзакция сценария годится только для отката: к базе больше не обращаемся.
		Проведена = Ложь;
		ТекстОшибки = ОшибкаОднойСтрокой(ИнформацияОбОшибке());
	КонецПопытки;
	Проверить(Не Проведена, "реализация при нехватке материалов автовыпуска не проводится");
	Сообщения = СообщенияПользователю();
	Проверить(СтрНайти(Сообщения + ТекстОшибки, ПометкаТеста() + ": " + ИмяМатериала) > 0,
		"в отказе названа недостающая M3:" + Сообщения + " | ошибка: " + ТекстОшибки);

КонецПроцедуры

// Сценарий: продукция заказа пришла от переработчика позже даты отгрузки, созданной заранее (2.0.16.119, инцидент
// клиента: расходный ордер с датой до поступления из переработки не проводился - автовыпуск собирался производить
// продукцию из сырья, уже переданного переработчику). Отгрузка датой после поступления проводится без автовыпуска,
// отгрузка датой раньше - отказ с понятным текстом вместо нехватки материалов.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Строка - описание проверенного
//
Функция СценарийАвтовыпускПослеПереработки(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Числа = Контекст.Числа;
	Расход = Числа.РасходСырьяНаЕдиницу;
	ДокументЗакупки(Контекст, Контекст.Сырье, Числа.КоличествоСырья, Числа.ЦенаСырья);
	Заказ = ЗаказПроведенияСценария(Контекст, Расход);
	Провести(Заказ);
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	Передача = ПередачаСценарияПереработки(Контекст, Заказ.Ссылка, Числа.КоличествоПродажи * Расход);
	Провести(Передача);

	// BSLLS:MagicNumber-off - отгрузки 2 (раньше поступления) и 1 (позже) из 3 продукции заказа.
	Ранняя = РеализацияПродукцииАвтовыпуска(Контекст, Заказ.Ссылка, 2, ДатаЧерезДвеСекунды(Контекст));
	Записать(Ранняя);
	Поступление = ПоступлениеСценарияПереработки(Контекст, Передача.Ссылка);
	Провести(Поступление);
	Поздняя = РеализацияПродукцииАвтовыпуска(Контекст, Заказ.Ссылка, 1, ДатаЧерезДвеСекунды(Контекст));
	// BSLLS:MagicNumber-on
	Провести(Поздняя);
	ПроверитьРавенство(0, ЧислоВыпусковОснования(Поздняя.Ссылка),
		"отгрузка после поступления из переработки - без автовыпуска");

	// Отказ проведения отравляет транзакцию сценария - шаг последний.
	ПолучитьСообщенияПользователю(Истина);
	Проведена = Истина;
	ТекстОшибки = "";
	Попытка
		Ранняя.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Проведена = Ложь;
		ТекстОшибки = ОшибкаОднойСтрокой(ИнформацияОбОшибке());
	КонецПопытки;
	Проверить(Не Проведена, "отгрузка датой раньше поступления из переработки не проводится");
	Сообщения = СообщенияПользователю() + " | ошибка: " + ТекстОшибки;
	Ожидаемый = СтрШаблон(Производство.ТекстПродукцияПолученаПозже(), Контекст.Продукция, Поступление.Ссылка, "");
	Ожидаемый = Лев(Ожидаемый, СтрНайти(Ожидаемый, Символы.ПС) - 1);
	Проверить(СтрНайти(Сообщения, Ожидаемый) > 0, "отказ называет продукцию и поступление: " + Сообщения);

	Возврат РезультатСценария("продукция от переработчика позже даты созданной заранее отгрузки: отгрузка после "
		+ "поступления - без автовыпуска, отгрузка раньше - отказ с продукцией и поступлением вместо нехватки сырья");

КонецФункции

// Реализация, заполненная по заказу, со складом сценария и датой через две секунды после предыдущего документа.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Заказ    - ДокументСсылка.ЗаказПокупателя - основание
//
// Возвращаемое значение:
//  ДокументОбъект.РеализацияТоваровУслуг - непроведённая реализация
//
Функция РеализацияАвтовыпуска(Контекст, Заказ)

	Реализация = РеализацияСтадии(Контекст, Заказ);
	Реализация.Дата = ДатаЧерезДвеСекунды(Контекст);
	Возврат Реализация;

КонецФункции

// Реализация только продукции заказа (строка товара удалена) с количеством и датой.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ со строками «товар, продукция»
//  Количество - Число - отгружаемая продукция
//  Дата       - Дата - дата реализации
//
// Возвращаемое значение:
//  ДокументОбъект.РеализацияТоваровУслуг - непроведённая реализация
//
Функция РеализацияПродукцииАвтовыпуска(Контекст, Заказ, Количество, Дата)

	Реализация = РеализацияСтадии(Контекст, Заказ);
	Реализация.ТЧТовары.Удалить(0);
	УстановитьКоличествоСтроки(Реализация.ТЧТовары[0], Количество);
	Реализация.Дата = Дата;
	Возврат Реализация;

КонецФункции

// Дата документа через две секунды после предыдущего: автовыпуск на секунду раньше реализации не совпадает по секунде
// с предыдущим документом сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Дата - дата документа
//
Функция ДатаЧерезДвеСекунды(Контекст)

	СледующаяДата(Контекст);
	Возврат СледующаяДата(Контекст);

КонецФункции

// Состав технологической карты из одного материала.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Материал   - СправочникСсылка.Номенклатура - материал
//  Количество - Число - расход на единицу
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Упаковка, Количество
//
Функция СоставИзМатериала(Контекст, Материал, Количество)

	Состав = СоставКарты(Контекст);
	Состав[0].Номенклатура = Материал;
	Состав[0].Количество = Количество;
	Возврат Состав;

КонецФункции

// Единственный автовыпуск реализации.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация
//  Описание   - Строка - шаг сценария
//
// Возвращаемое значение:
//  ДокументСсылка.ВыпускПродукции - проведённый автовыпуск
//
Функция ЕдинственныйАвтовыпуск(Реализация, Описание)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Выпуски.Ссылка КАК Ссылка,
	|	Выпуски.Проведен КАК Проведен
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|ГДЕ
	|	Выпуски.Основание = &Реализация");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Выпуски = Запрос.Выполнить().Выгрузить();
	ПроверитьРавенство(1, Выпуски.Количество(), Описание + ": автовыпусков у реализации");
	Проверить(Выпуски[0].Проведен, Описание + ": автовыпуск не проведён");
	Возврат Выпуски[0].Ссылка;

КонецФункции

// Выпущено продукции проведённым автовыпуском реализации.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация
//
// Возвращаемое значение:
//  Число - количество готовой продукции
//
Функция ВыпущеноАвтовыпуском(Реализация)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ГотоваяПродукция.Количество), 0) КАК Количество
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ГотоваяПродукция
	|		ПО Выпуски.Ссылка = ГотоваяПродукция.Ссылка
	|ГДЕ
	|	Выпуски.Основание = &Реализация
	|	И Выпуски.Проведен");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Возврат ПерваяСтрока(Запрос, "Количество").Количество;

КонецФункции

// Себестоимость, оприходованная выпуском.
//
// Параметры:
//  Выпуск - ДокументСсылка.ВыпускПродукции - выпуск
//
// Возвращаемое значение:
//  Число - сумма прихода регистра товаров
//
Функция СуммаПриходаВыпуска(Выпуск)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Движения.Сумма), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Выпуск
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
	Запрос.УстановитьПараметр("Выпуск", Выпуск);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;

КонецФункции

// «ИзОстатка» в движениях потребностей документа.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ
//
// Возвращаемое значение:
//  Число - сумма ресурса
//
Функция ИзОстаткаДвижений(Регистратор)

	Набор = РегистрыНакопления.ПотребностиПроизводства.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	Возврат Набор.Выгрузить().Итог("ИзОстатка");

КонецФункции

// Продукция расчёта автовыпуска строкой «P1 6, P2 3» в порядке строк.
//
// Параметры:
//  Данные    - Структура - номенклатура сценария (P1, P2, M1, M2)
//  Продукция - ТаблицаЗначений - см. Производство.ДанныеАвтовыпуска
//
// Возвращаемое значение:
//  Строка - продукция
//
Функция ПродукцияАвтовыпускаСтрокой(Данные, Продукция)

	Имена = ИменаНоменклатурыАвтовыпуска(Данные);
	Части = Новый Массив;
	Для Каждого Строка Из Продукция Цикл
		Части.Добавить(Имена[Строка.Номенклатура] + " " + СтрокаЧисла(Строка.Количество));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Материалы расчёта автовыпуска строкой «M1 12 под заказ, M2 3»: партия поступления сценария - «под заказ».
//
// Параметры:
//  Данные    - Структура - номенклатура и поступление под заказ сценария
//  Материалы - ТаблицаЗначений - см. Производство.ДанныеАвтовыпуска
//
// Возвращаемое значение:
//  Строка - материалы
//
Функция МатериалыАвтовыпускаСтрокой(Данные, Материалы)

	Имена = ИменаНоменклатурыАвтовыпуска(Данные);
	Части = Новый Массив;
	Для Каждого Строка Из Материалы Цикл
		Часть = Имена[Строка.Номенклатура] + " " + СтрокаЧисла(Строка.Количество);
		Если ЗначениеЗаполнено(Строка.Партия) Тогда
			Часть = Часть + ?(Строка.Партия = Данные.Поступление, " под заказ", " партия " + Строка(Строка.Партия));
		КонецЕсли;
		Части.Добавить(Часть);
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

Функция ИменаНоменклатурыАвтовыпуска(Данные)

	Имена = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("M1,M2,P1,P2", ",") Цикл
		Имена.Вставить(Данные[Имя], Имя);
	КонецЦикла;
	Возврат Имена;

КонецФункции

#КонецОбласти

#Область СырьеПереработчика

// Давальческая схема (2.0.16.103, план semi-finished-subcontract): изделие из ПФ переработчика, ПФ из сырья.
// Сырьё ПФ - потребность с ключом продукции = ПФ, сам ПФ - не потребность; свободное сырьё, переданное переработчику
// по заказу, закрывает дефицит и «к поступлению»; поступление ПФ из переработки; отгрузка изделия с автовыпуском
// списывает ПФ, а не сырьё. Проведение заказа с тем же ПФ отдельной строкой товаров - отказ.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСырьеПереработчика(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	// BSLLS:MagicNumber-off - норма 1, заказ 15, сырья закуплено свободно 20.
	Способы = Перечисления.СпособыИзготовления;
	Хлопок = НоваяПозицияСценария(Контекст, "хлопок давальческий", Перечисления.ТипыНоменклатуры.Сырье,
		Перечисления.СпособыПополненияЗапасов.Закупка);
	ПФ = НовыйПолуфабрикатСценария(Контекст, "ПФ давальческий");
	Изделие = НовоеИзделиеСценария(Контекст, "изделие из давальческого ПФ");
	ЗаписатьКартуСценария(Контекст, ПФ, СтрокаКартыСценария(Хлопок, 1));
	ЗаписатьКартуСценария(Контекст, Изделие, СтрокаКартыСценария(ПФ, 1, Способы.Переработчик));

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Изделие, 15, Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	СтрокаПФ = Заказ.ТЧМатериалы.Найти(ПФ, "Номенклатура");
	СтрокаХлопка = Заказ.ТЧМатериалы.Найти(Хлопок, "Номенклатура");
	Проверить(СтрокаПФ <> Неопределено И СтрокаХлопка <> Неопределено, "дерево заказа: ПФ и его сырьё");
	ПроверитьРавенство(Способы.Переработчик, СтрокаПФ.СпособИзготовления, "способ ПФ в строке заказа");
	ПроверитьРавенство(Способы.Закупка, СтрокаХлопка.СпособИзготовления, "способ сырья в строке заказа");
	ПроверитьРавенство(СтрокаПФ.КодСтроки, СтрокаХлопка.КодСтрокиРодителя, "сырьё - под ПФ");
	Провести(Заказ);

	Дефицит = РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа(Заказ.Ссылка);
	ПроверитьРавенство(1, Дефицит.Количество(), "дефицит - одной строкой: сырьё ПФ");
	ПроверитьРавенство(ПФ, Дефицит[0].Продукция, "ключ потребности сырья - сам ПФ");
	ПроверитьРавенство(Хлопок, Дефицит[0].Материал, "в закупку идёт сырьё, а не ПФ");
	ПроверитьРавенство(15, Дефицит[0].Количество, "дефицит сырья 15");

	// Свободное сырьё (без заказа поставщику) передаётся переработчику по заказу - потребность закрыта.
	ДокументЗакупки(Контекст, Хлопок, 20, Контекст.Числа.ЦенаСырья);
	Передача = НовыйДокумент(Контекст, "ПередачаВПереработку");
	Передача.Основание = Заказ.Ссылка;
	Передача.Контрагент = Контекст.Контрагент;
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Хлопок, 15, 0);
	Передача.ТЧТовары[0].Продукция = ПФ;
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧГотоваяПродукция", ПФ, 15, 0);
	Провести(Передача);
	ПроверитьРавенство(0, РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа(Заказ.Ссылка).Количество(),
		"передача свободного сырья переработчику закрыла дефицит");
	КПоступлению = РегистрыНакопления.ПотребностиПроизводства.ОстатокКПоступлению(Заказ.Ссылка);
	Проверить(КПоступлению.Найти(Хлопок, "Материал") = Неопределено, "переданное сырьё «к поступлению» не ждёт");
	Поправки = РегистрыНакопления.ПотребностиПроизводства.ПоправкиДефицитаПереработчика(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Заказ.Ссылка));
	КлючПоправки = XMLСтрока(Заказ.Ссылка) + "|" + XMLСтрока(Хлопок) + "|"
		+ XMLСтрока(Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ПроверитьРавенство(15, Поправки[КлючПоправки], "поправка «Потребности» АРМ закупок 15");
	Расчет = ПроверитьСинхронностьСтадииЗаказа(Заказ.Ссылка, "передача сырья переработчику");
	ПроверитьРавенство(1, Расчет.ДоляОбеспечения, "передача сырья - обеспечение заказа");

	// ПФ пришёл от переработчика; отгрузка изделия списывает ПФ, а не сырьё.
	Провести(ПоступлениеСценарияПереработки(Контекст, Передача.Ссылка));
	ПроверитьРавенство(15, ОстатокТовара(Контекст.Склад, ПФ).Количество, "ПФ поступил из переработки");
	ХлопкаДоОтгрузки = ОстатокТовара(Контекст.Склад, Хлопок).Количество;
	Реализация = РеализацияСтадии(Контекст, Заказ.Ссылка);
	Реализация.Дата = ДатаЧерезДвеСекунды(Контекст);
	Провести(Реализация);
	ЕдинственныйАвтовыпуск(Реализация.Ссылка, "отгрузка изделия из давальческого ПФ");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, ПФ).Количество, "автовыпуск изделия списал ПФ");
	ПроверитьРавенство(ХлопкаДоОтгрузки, ОстатокТовара(Контекст.Склад, Хлопок).Количество,
		"сырьё ПФ изделием не списано");
	// BSLLS:MagicNumber-on

	ПроверитьКоллизиюГраницыПереработчика(Контекст, Изделие, ПФ);
	Возврат РезультатСценария("сырьё ПФ переработчика - потребность с ключом ПФ, ПФ - нет; передача свободного сырья "
		+ "закрыла дефицит, «к поступлению» и поправку АРМ закупок, стадия - обеспечено; ПФ из переработки, отгрузка "
		+ "изделия списала ПФ, а не сырьё; ПФ ещё и строкой товаров - отказ проведения");

КонецФункции

// Ручной выпуск ПФ собственного производства из закладки «Выпуск» рабочего места (2.0.16.104): ПФ из дерева материалов
// заказа есть в выборе с остатком по дереву, строка выпуска ПФ записывается и списывает его сырьё по карте ПФ; остаток к
// выпуску обнуляется; выпуск изделия из ПФ списывает выпущенный ПФ со склада, а не сырьё.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВыпускПолуфабрикатаАРМ(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;

	// Ручной выпуск ПФ предлагается только без автовыпуска при отгрузке (2.0.16.109); с ним - проверка в конце.
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Ложь);
	// BSLLS:MagicNumber-off - ПФ из сырья по 2, изделие из ПФ по 1, заказ 3, сырья закуплено 10.
	АРМ = Обработки.АРМПроизводство;
	Сырье = НоваяПозицияСценария(Контекст, "сырьё своего ПФ", Перечисления.ТипыНоменклатуры.Сырье,
		Перечисления.СпособыПополненияЗапасов.Закупка);
	ПФ = НовыйПолуфабрикатСценария(Контекст, "свой ПФ ручного выпуска");
	Изделие = НовоеИзделиеСценария(Контекст, "изделие из своего ПФ");
	ЗаписатьКартуСценария(Контекст, ПФ, СтрокаКартыСценария(Сырье, 2));
	ЗаписатьКартуСценария(Контекст, Изделие, СтрокаКартыСценария(ПФ, 1));
	// Выпуск строкой рабочего места пишется на склад пользователя - сырьё закупается туда же (как ДанныеАРМВыпускаОтгрузки).
	Склад = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновноеМестоХранения.Получить();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Контекст.Склад;
		Константы.ОсновноеМестоХранения.Установить(Склад);
	КонецЕсли;
	Закупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Закупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.ЦенаВключаетНДС = Истина;
	Закупка.Валюта = Контекст.Валюта;
	Закупка.КурсВалюты = 1;
	Закупка.МестоХранения = Склад;
	ДобавитьСтрокуТоваров(Контекст, Закупка, "ТЧТовары", Сырье, 10, Контекст.Числа.ЦенаСырья);
	Провести(Закупка);
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Изделие, 3, Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	Провести(Заказ);

	Выбор = АРМ.ПродукцияЗаказаДляВыбора(Заказ.Ссылка, АРМ.ВидВыпуск());
	ЭлементПФ = Неопределено;
	Для Каждого Элемент Из Выбор Цикл
		Если Элемент.Значение.Продукция = ПФ Тогда
			ЭлементПФ = Элемент;
		КонецЕсли;
	КонецЦикла;
	Проверить(ЭлементПФ <> Неопределено, "свой ПФ из дерева заказа - в выборе продукции выпуска");
	ПроверитьРавенство(3, ЭлементПФ.Значение.КоличествоУпаковок, "остаток ПФ к выпуску по дереву - 3");
	ПроверитьРавенство(6, ДефицитМатериалаЗаказа(Заказ.Ссылка, Сырье), "до выпуска ПФ дефицит его сырья - 6");

	Результат = ЗаписьСтрокиЗакупкиАРМ(СтрокаВыпускаАРМ(Заказ.Ссылка, АРМ.ВидВыпуск(), ПФ, 3), "строка выпуска ПФ");
	Проверить(Результат.Проведен, "выпуск ПФ проведён");
	Выпуск = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(Сырье, Выпуск.ТЧТовары[0].Номенклатура, "выпуск ПФ списывает его сырьё");
	ПроверитьРавенство(6, Выпуск.ТЧТовары[0].Количество, "сырья на 3 ПФ - 6");
	ПроверитьРавенство(0, АРМ.ПолуфабрикатыЗаказаКВыпуску(Заказ.Ссылка).Итог("Осталось"), "ПФ выпущен целиком");
	ПроверитьРавенство(3, ОстатокТовара(Склад, ПФ).Количество, "ПФ на складе после выпуска");
	ПроверитьРавенство(0, ДефицитМатериалаЗаказа(Заказ.Ссылка, Сырье), "выпуск ПФ со свободного склада закрыл дефицит сырья");
	ПроверитьИзОстаткаРучногоВыпуска(Результат.Документ, Заказ.Ссылка, Сырье, 6);

	Результат = ЗаписьСтрокиЗакупкиАРМ(СтрокаВыпускаАРМ(Заказ.Ссылка, АРМ.ВидВыпуск(), Изделие, 3), "выпуск изделия");
	Выпуск = Результат.Документ.ПолучитьОбъект();
	ПроверитьРавенство(ПФ, Выпуск.ТЧТовары[0].Номенклатура, "выпуск изделия списывает ПФ, а не сырьё");
	ПроверитьРавенство(0, ОстатокТовара(Склад, ПФ).Количество, "ПФ ушёл в изделие");
	ПроверитьРавенство(4, ОстатокТовара(Склад, Сырье).Количество, "сырьё списано один раз: 10 - 6");
	ПроверитьВыпускПолуфабрикатаПриАвтовыпуске(Контекст, Склад);
	ПроверитьРазворачиваниеПолуфабрикатаОба(Контекст, Сырье);
	ПроверитьВыборПолуфабрикатаЛиста(Контекст, Склад);
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("свой ПФ из дерева заказа в выборе «Выпуска» АРМ с остатком по дереву; выпуск ПФ строкой "
		+ "списал его сырьё и закрыл его дефицит «ИзОстатка», перепроведение и отмена - без задвоения; выпуск изделия "
		+ "списал ПФ, сырьё списано один раз; при автовыпуске ПФ предлагается, автовыпуск отгрузки берёт выпущенный ПФ вместо "
		+ "сырья; «Оба» с «Наше производство» в строке техкарты - ПФ разворачивается; ПФ-лист дерева без сырья - в выборе "
		+ "и с автовыпуском, закупаемый лист - нет");

КонецФункции

// «ИзОстатка» ручного выпуска при повторном проведении того же объекта (наборы не копят прежние записи), отмене и
// новом проведении (2.0.16.109).
//
// Параметры:
//  Выпуск   - ДокументСсылка.ВыпускПродукции - проведённый ручной выпуск.
//  Заказ    - ДокументСсылка.ЗаказПокупателя - его заказ.
//  Материал - СправочникСсылка.Номенклатура - сырьё, взятое со свободного склада.
//  Ожидаемо - Число - «ИзОстатка» выпуска.
//
Процедура ПроверитьИзОстаткаРучногоВыпуска(Выпуск, Заказ, Материал, Ожидаемо)

	ПроверитьРавенство(Ожидаемо, ИзОстаткаВыпуска(Выпуск), "«ИзОстатка» ручного выпуска");
	Объект = Выпуск.ПолучитьОбъект();
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(Ожидаемо, ИзОстаткаВыпуска(Выпуск), "дважды перепроведённый объект - «ИзОстатка» без задвоения");
	ПроверитьРавенство(0, ДефицитМатериалаЗаказа(Заказ, Материал), "после перепроведения дефицит сырья - 0");
	Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ПроверитьРавенство(0, ИзОстаткаВыпуска(Выпуск), "отмена проведения убрала «ИзОстатка»");
	ПроверитьРавенство(Ожидаемо, ДефицитМатериалаЗаказа(Заказ, Материал), "после отмены дефицит сырья вернулся");
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(0, ДефицитМатериалаЗаказа(Заказ, Материал), "после нового проведения дефицит сырья - 0");

КонецПроцедуры

// Параметры:
//  Выпуск - ДокументСсылка.ВыпускПродукции - выпуск.
//
// Возвращаемое значение:
//  Число - «ИзОстатка» движений потребностей производства выпуска.
//
Функция ИзОстаткаВыпуска(Выпуск)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Потребности.ИзОстатка), 0) КАК ИзОстатка
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства КАК Потребности
	|ГДЕ
	|	Потребности.Регистратор = &Выпуск");
	Запрос.УстановитьПараметр("Выпуск", Выпуск);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.ИзОстатка;

КонецФункции

// Параметры:
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ на производство.
//  Материал - СправочникСсылка.Номенклатура - материал.
//
// Возвращаемое значение:
//  Число - дефицит материала заказа по всем ключам.
//
Функция ДефицитМатериалаЗаказа(Заказ, Материал)

	Дефицит = 0;
	Для Каждого Строка Из РегистрыНакопления.ПотребностиПроизводства.ДефицитЗаказа(Заказ) Цикл
		Если Строка.Материал = Материал Тогда
			Дефицит = Дефицит + Строка.Количество;
		КонецЕсли;
	КонецЦикла;
	Возврат Дефицит;

КонецФункции

// Ручной выпуск изделия списывает сырьё по дате партии: сначала партию под заказ, потом свободную. «ИзОстатка» - только
// свободная часть в пределах нормы ветви; выпуск сверх заказа «ИзОстатка» не даёт (2.0.16.109).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВыпускИзОстаткаРучной(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Ложь);
	// BSLLS:MagicNumber-off - изделие из сырья по 2, заказ 3: потребность 6; под заказ куплено 2, без заказа 10.
	АРМ = Обработки.АРМПроизводство;
	Сырье = НоваяПозицияСценария(Контекст, "сырьё ручного выпуска", Перечисления.ТипыНоменклатуры.Сырье,
		Перечисления.СпособыПополненияЗапасов.Закупка);
	Изделие = НовоеИзделиеСценария(Контекст, "изделие ручного выпуска");
	ЗаписатьКартуСценария(Контекст, Изделие, СтрокаКартыСценария(Сырье, 2));
	Склад = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновноеМестоХранения.Получить();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Контекст.Склад;
		Константы.ОсновноеМестоХранения.Установить(Склад);
	КонецЕсли;
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Изделие, 3, Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	Провести(Заказ);
	ЗакупкаСырьяСценария(Контекст, Склад, Сырье, 2, Заказ.Ссылка);
	ЗакупкаСырьяСценария(Контекст, Склад, Сырье, 10, Неопределено);
	ПроверитьРавенство(4, ДефицитМатериалаЗаказа(Заказ.Ссылка, Сырье), "под заказ пришло 2 из 6 - дефицит 4");

	Результат = ЗаписьСтрокиЗакупкиАРМ(СтрокаВыпускаАРМ(Заказ.Ссылка, АРМ.ВидВыпуск(), Изделие, 3), "выпуск изделия");
	ПроверитьРавенство(6, ОстатокТовара(Склад, Сырье).Количество, "списано 6 из 12");
	ПроверитьИзОстаткаРучногоВыпуска(Результат.Документ, Заказ.Ссылка, Сырье, 4);

	Сверх = ЗаписьСтрокиЗакупкиАРМ(СтрокаВыпускаАРМ(Заказ.Ссылка, АРМ.ВидВыпуск(), Изделие, 1), "выпуск сверх заказа");
	ПроверитьРавенство(0, ИзОстаткаВыпуска(Сверх.Документ), "выпуск сверх заказа «ИзОстатка» не даёт");
	// BSLLS:MagicNumber-on
	ПроверитьДвеВетвиПолуфабриката(Контекст);

	Возврат РезультатСценария("ручной выпуск изделия: «ИзОстатка» 4 - свободная часть расхода 6 (2 из партии под заказ), "
		+ "дефицит 0; перепроведение и отмена без задвоения; выпуск сверх заказа «ИзОстатка» не даёт; общий ПФ двух "
		+ "изделий - свободный расход закрывает ветвь, не покрытую поступлением под заказ");

КонецФункции

// Ревью кода 2.0.16.109: изделия A и B, у каждого свой ПФ P из 2 сырья M; под заказ пришло 2 M (одна ветвь покрыта),
// без заказа 2 M. Ручной выпуск 2 P списывает 4 M; свободные 2 закрывают непокрытую ветвь - дефицит M 0.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьДвеВетвиПолуфабриката(Контекст)

	// BSLLS:MagicNumber-off - P из 2 M, A и B по 1 P, заказ по 1.
	АРМ = Обработки.АРМПроизводство;
	Сырье = НоваяПозицияСценария(Контекст, "сырьё общего ПФ", Перечисления.ТипыНоменклатуры.Сырье,
		Перечисления.СпособыПополненияЗапасов.Закупка);
	ПФ = НовыйПолуфабрикатСценария(Контекст, "общий ПФ двух изделий");
	ИзделиеА = НовоеИзделиеСценария(Контекст, "изделие A из общего ПФ");
	ИзделиеБ = НовоеИзделиеСценария(Контекст, "изделие B из общего ПФ");
	ЗаписатьКартуСценария(Контекст, ПФ, СтрокаКартыСценария(Сырье, 2));
	ЗаписатьКартуСценария(Контекст, ИзделиеА, СтрокаКартыСценария(ПФ, 1));
	ЗаписатьКартуСценария(Контекст, ИзделиеБ, СтрокаКартыСценария(ПФ, 1));
	Склад = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновноеМестоХранения.Получить();
	КонецЕсли;
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", ИзделиеА, 1, Контекст.Числа.ЦенаПродажи);
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", ИзделиеБ, 1, Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	Провести(Заказ);
	ЗакупкаСырьяСценария(Контекст, Склад, Сырье, 2, Заказ.Ссылка);
	ЗакупкаСырьяСценария(Контекст, Склад, Сырье, 2, Неопределено);
	ПроверитьРавенство(2, ДефицитМатериалаЗаказа(Заказ.Ссылка, Сырье), "до выпуска: нужно 4, пришло под заказ 2");
	Результат = ЗаписьСтрокиЗакупкиАРМ(СтрокаВыпускаАРМ(Заказ.Ссылка, АРМ.ВидВыпуск(), ПФ, 2), "выпуск общего ПФ");
	ПроверитьРавенство(2, ИзОстаткаВыпуска(Результат.Документ), "«ИзОстатка» - свободная часть расхода");
	ПроверитьРавенство(0, ДефицитМатериалаЗаказа(Заказ.Ссылка, Сырье), "свободный расход закрыл непокрытую ветвь");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Проведённая закупка сырья на склад сценария, под заказ клиента или без него.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Склад      - СправочникСсылка.МестаХранения - склад.
//  Сырье      - СправочникСсылка.Номенклатура - сырьё.
//  Количество - Число - количество.
//  Заказ      - ДокументСсылка.ЗаказПокупателя, Неопределено - заказ клиента-основание.
//
Процедура ЗакупкаСырьяСценария(Контекст, Склад, Сырье, Количество, Заказ)

	Закупка = НовыйДокумент(Контекст, "ПоступлениеТоваровУслуг");
	Закупка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Закупка.Контрагент = Контекст.Контрагент;
	Закупка.Договор = Контекст.ДоговорПоставщика;
	Закупка.ЦенаВключаетНДС = Истина;
	Закупка.Валюта = Контекст.Валюта;
	Закупка.КурсВалюты = 1;
	Закупка.МестоХранения = Склад;
	Если Заказ <> Неопределено Тогда
		Закупка.Основание = Заказ;
	КонецЕсли;
	ДобавитьСтрокуТоваров(Контекст, Закупка, "ТЧТовары", Сырье, Количество, Контекст.Числа.ЦенаСырья);
	Провести(Закупка);

КонецПроцедуры

// При автовыпуске при отгрузке (2.0.16.113, решение владельца 2026-10-28): верхний свой ПФ предлагается в выборе
// «Выпуска»; выпуск ПФ списывает его сырьё; автовыпуск отгрузки берёт выпущенный ПФ вместо его сырья, сырьё - только на
// непокрытое изделие.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Склад    - СправочникСсылка.МестаХранения - склад выпуска и отгрузки.
//
Процедура ПроверитьВыпускПолуфабрикатаПриАвтовыпуске(Контекст, Склад)

	// BSLLS:MagicNumber-off - заказ 2 изделия, выпуск ПФ 1, сырьё по 2 на ПФ.
	АРМ = Обработки.АРМПроизводство;
	// Свои позиции шага: изделие прежних шагов лежит на складе, и отгрузка взяла бы его со склада без автовыпуска (S9).
	Сырье = НоваяПозицияСценария(Контекст, "сырьё ПФ при автовыпуске", Перечисления.ТипыНоменклатуры.Сырье,
		Перечисления.СпособыПополненияЗапасов.Закупка);
	ПФ = НовыйПолуфабрикатСценария(Контекст, "свой ПФ при автовыпуске");
	Изделие = НовоеИзделиеСценария(Контекст, "изделие из своего ПФ при автовыпуске");
	ЗаписатьКартуСценария(Контекст, ПФ, СтрокаКартыСценария(Сырье, 2));
	ЗаписатьКартуСценария(Контекст, Изделие, СтрокаКартыСценария(ПФ, 1));
	ЗакупкаСырьяСценария(Контекст, Склад, Сырье, 10, Неопределено);
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Изделие, 2, Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	Провести(Заказ);
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	ЕстьПФ = Ложь;
	Для Каждого Элемент Из АРМ.ПродукцияЗаказаДляВыбора(Заказ.Ссылка, АРМ.ВидВыпуск()) Цикл
		ЕстьПФ = ЕстьПФ Или Элемент.Значение.Продукция = ПФ;
	КонецЦикла;
	Проверить(ЕстьПФ, "при автовыпуске верхний свой ПФ предлагается в выборе выпуска");
	СырьяДо = ОстатокТовара(Склад, Сырье).Количество;
	ЗаписьСтрокиЗакупкиАРМ(СтрокаВыпускаАРМ(Заказ.Ссылка, АРМ.ВидВыпуск(), ПФ, 1), "выпуск ПФ при автовыпуске");
	ПроверитьРавенство(СырьяДо - 2, ОстатокТовара(Склад, Сырье).Количество, "выпуск ПФ на 1 списал сырьё 2");
	Реализация = РеализацияАвтовыпуска(Контекст, Заказ.Ссылка);
	Реализация.МестоХранения = Склад;
	// Выпуск строкой рабочего места датирован текущим моментом: отгрузка - после него, иначе ПФ ещё не выпущен.
	Реализация.Дата = Макс(Реализация.Дата, ТекущаяДатаСеанса() + 2);
	Провести(Реализация);
	Автовыпуск = ЕдинственныйАвтовыпуск(Реализация.Ссылка, "отгрузка с выпущенным ПФ").ПолучитьОбъект();
	ПроверитьРавенство(1, КоличествоМатериала(Автовыпуск, ПФ), "автовыпуск взял выпущенный ПФ 1");
	ПроверитьРавенство(2, КоличествоМатериала(Автовыпуск, Сырье), "сырьё автовыпуска - только на непокрытое изделие");
	ПроверитьРавенство(СырьяДо - 4, ОстатокТовара(Склад, Сырье).Количество, "сырьё всего на 2 ПФ, а не на 3");
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Ложь);
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Параметры:
//  Выпуск   - ДокументОбъект.ВыпускПродукции - выпуск.
//  Материал - СправочникСсылка.Номенклатура - материал.
//
// Возвращаемое значение:
//  Число - количество материала в строках выпуска.
//
Функция КоличествоМатериала(Выпуск, Материал)

	Количество = 0;
	Для Каждого Строка Из Выпуск.ТЧТовары.НайтиСтроки(Новый Структура("Номенклатура", Материал)) Цикл
		Количество = Количество + Строка.Количество;
	КонецЦикла;
	Возврат Количество;

КонецФункции

// Строка техкарты «Наше производство» разворачивает свой ПФ и при способе пополнения «Оба» в карточке (2.0.16.113),
// «Закупка» - оставляет листом.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Сырье    - СправочникСсылка.Номенклатура - сырьё.
//
Процедура ПроверитьРазворачиваниеПолуфабрикатаОба(Контекст, Сырье)

	// BSLLS:MagicNumber-off - сырьё 2 на ПФ.
	Способы = Перечисления.СпособыИзготовления;
	ПФ = НовыйПолуфабрикатСценария(Контекст, "ПФ «Оба»", Перечисления.СпособыПополненияЗапасов.Оба);
	ЗаписатьКартуСценария(Контекст, ПФ, СтрокаКартыСценария(Сырье, 2));
	СвоимПроизводством = НовоеИзделиеСценария(Контекст, "изделие из ПФ «Оба», наше производство");
	ЗаписатьКартуСценария(Контекст, СвоимПроизводством, СтрокаКартыСценария(ПФ, 1, Способы.НашеПроизводство));
	Закупкой = НовоеИзделиеСценария(Контекст, "изделие из ПФ «Оба», закупка");
	ЗаписатьКартуСценария(Контекст, Закупкой, СтрокаКартыСценария(ПФ, 1, Способы.Закупка));
	Строки = ТехнологическиеКарты.РазвернутыйСостав(СвоимПроизводством, Контекст.Дата).Строки;
	Проверить(Строки.Найти(ПФ, "Номенклатура").ЕстьПотомки, "«Оба» и «Наше производство» в строке - ПФ разворачивается");
	Строки = ТехнологическиеКарты.РазвернутыйСостав(Закупкой, Контекст.Дата).Строки;
	Проверить(Не Строки.Найти(ПФ, "Номенклатура").ЕстьПотомки, "«Оба» и «Закупка» в строке - ПФ лист");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// ПФ - лист дерева заказа (2.0.16.114, решение владельца 2026-10-28): карты у ПФ при заполнении заказа не было, сырья под
// ним нет. Он есть в выборе «Выпуска» и с автовыпуском при отгрузке, и без него; закупаемый лист - нет; выпуск ПФ по карте,
// заведённой позже, проводится.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Склад    - СправочникСсылка.МестаХранения - склад выпуска.
//
Процедура ПроверитьВыборПолуфабрикатаЛиста(Контекст, Склад)

	// BSLLS:MagicNumber-off - заказ 2 изделия, ПФ и покупного по 1 на изделие, сырья 2 на ПФ.
	АРМ = Обработки.АРМПроизводство;
	Сырье = НоваяПозицияСценария(Контекст, "сырьё ПФ-листа", Перечисления.ТипыНоменклатуры.Сырье,
		Перечисления.СпособыПополненияЗапасов.Закупка);
	Покупное = НоваяПозицияСценария(Контекст, "покупной лист рядом с ПФ-листом", Перечисления.ТипыНоменклатуры.Сырье,
		Перечисления.СпособыПополненияЗапасов.Закупка);
	ПФ = НовыйПолуфабрикатСценария(Контекст, "ПФ-лист без карты");
	Изделие = НовоеИзделиеСценария(Контекст, "изделие из ПФ-листа");
	Строки = Новый Массив;
	Строки.Добавить(СтрокаКартыСценария(ПФ, 1));
	Строки.Добавить(СтрокаКартыСценария(Покупное, 1));
	ЗаписатьКартуСценария(Контекст, Изделие, Строки);
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Изделие, 2, Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	Провести(Заказ);
	Верхних = Заказ.ТЧМатериалы.НайтиСтроки(Новый Структура("КодСтрокиРодителя", 0)).Количество();
	ПроверитьРавенство(Заказ.ТЧМатериалы.Количество(), Верхних, "у ПФ без карты сырья в дереве нет - лист");
	Режимы = Новый Массив;
	Режимы.Добавить(Истина);
	Режимы.Добавить(Ложь);
	Для Каждого Автовыпуск Из Режимы Цикл
		Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Автовыпуск);
		ЭлементПФ = Неопределено;
		ЕстьПокупное = Ложь;
		Для Каждого Элемент Из АРМ.ПродукцияЗаказаДляВыбора(Заказ.Ссылка, АРМ.ВидВыпуск()) Цикл
			Если Элемент.Значение.Продукция = ПФ Тогда
				ЭлементПФ = Элемент;
			КонецЕсли;
			ЕстьПокупное = ЕстьПокупное Или Элемент.Значение.Продукция = Покупное;
		КонецЦикла;
		Суффикс = ?(Автовыпуск, " (с автовыпуском)", " (без автовыпуска)");
		Проверить(ЭлементПФ <> Неопределено, "ПФ-лист дерева - в выборе продукции выпуска" + Суффикс);
		Если ЭлементПФ <> Неопределено Тогда
			ПроверитьРавенство(2, ЭлементПФ.Значение.КоличествоУпаковок, "остаток ПФ-листа к выпуску - 2" + Суффикс);
		КонецЕсли;
		Проверить(Не ЕстьПокупное, "закупаемый лист - не в выборе выпуска" + Суффикс);
	КонецЦикла;
	ЗаписатьКартуСценария(Контекст, ПФ, СтрокаКартыСценария(Сырье, 2));
	ЗакупкаСырьяСценария(Контекст, Склад, Сырье, 4, Неопределено);
	Результат = ЗаписьСтрокиЗакупкиАРМ(СтрокаВыпускаАРМ(Заказ.Ссылка, АРМ.ВидВыпуск(), ПФ, 2), "выпуск ПФ-листа");
	Проверить(Результат.Проведен, "выпуск ПФ-листа проведён");
	ПроверитьРавенство(0, АРМ.ПолуфабрикатыЗаказаКВыпуску(Заказ.Ссылка).Итог("Осталось"), "ПФ-лист выпущен целиком");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Последний шаг (отказ проведения отравляет транзакцию сценария): тот же ПФ в строках товаров заказа при развёрнутой
// границе - отказ проведения; после перезаполнения материалов ПФ - лист и заказ проводится.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Изделие  - СправочникСсылка.Номенклатура - изделие из ПФ переработчика.
//  ПФ       - СправочникСсылка.Номенклатура - ПФ переработчика.
//
Процедура ПроверитьКоллизиюГраницыПереработчика(Контекст, Изделие, ПФ)

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	// BSLLS:MagicNumber-off - изделие 2, у границы два материала.
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Изделие, 2, Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	Проверить(Заказ.ТЧМатериалы.Количество() = 2, "граница развёрнута до добавления ПФ строкой товаров");
	// BSLLS:MagicNumber-on
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", ПФ, 1, Контекст.Числа.ЦенаПродажи);
	// Заполнение с ПФ в товарах: граница не разворачивается - у изделия один материал-лист ПФ.
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	СтрокаИзделия = Заказ.ТЧТовары.Найти(Изделие, "Номенклатура");
	ОтборИзделия = Новый Структура("КодСтрокиПродукции", СтрокаИзделия.КодСтроки);
	ПроверитьРавенство(1, Заказ.ТЧМатериалы.НайтиСтроки(ОтборИзделия).Количество(), "ПФ и в товарах - граница не развёрнута");
	// Развёрнутое вручную дерево при ПФ в товарах - отказ проведения.
	СтрокаХлопка = Заказ.ТЧМатериалы.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаХлопка, Заказ.ТЧМатериалы[0], "КодСтрокиПродукции, Упаковка");
	СтрокаПФ = Заказ.ТЧМатериалы.Найти(ПФ, "Номенклатура");
	СтрокаХлопка.КодСтроки = 100;
	СтрокаХлопка.КодСтрокиРодителя = СтрокаПФ.КодСтроки;
	СтрокаХлопка.Номенклатура = Контекст.Сырье;
	СтрокаХлопка.Количество = 2;
	СтрокаХлопка.КоличествоЗаЕдиницу = 1;
	СтрокаХлопка.КоличествоУпаковок = 2;
	Проверить(ОтказЗаписиДокумента(Заказ), "ПФ и в товарах, и развёрнутой границей - отказ проведения");

КонецПроцедуры

#КонецОбласти

#Область АвтовыпускПриПередаче

// Автовыпуск при передаче в переработку (S4): проведение передачи по заказу на производство выпускает передаваемый
// полуфабрикат на секунду раньше передачи по его технологической карте и списывает её сырьё; лежащее на складе не
// выпускается повторно. Шаг между документами - две секунды. Настоящий отказ проведения - последним шагом: после
// исключения транзакция сценария годится только для отката (docs/TESTING.md, п. 3).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАвтовыпускПриПередаче(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);
	Данные = ДанныеПередачиСценария(Контекст);
	ПроверитьПервуюПередачуАвтовыпуска(Контекст, Данные);
	ПроверитьОстатокПолуфабрикатаПередачи(Контекст, Данные);
	ПроверитьОтменуИУдалениеПередачи(Контекст, Данные);
	ПроверитьЗапретыПередачи(Контекст, Данные);
	ПроверитьГраницыПередачи(Контекст, Данные);
	ПроверитьПотолокПередачи(Контекст, Данные);
	ПроверитьДваКаналаАвтовыпуска(Контекст, Данные);
	ПроверитьСвободныйОстатокПередачи(Контекст);
	// Отказ проведения отравляет транзакцию сценария: после него запросы уже не выполняются, поэтому
	// шаг с настоящим отказом остаётся последним - соглашение сценариев проекта.
	ПроверитьОтказПоМатериаламПередачи(Контекст);

	Возврат РезультатСценария("автовыпуск полуфабриката на секунду раньше передачи по листьям его карты, "
		+ "складской остаток не выпускается повторно, перепроведение и сдвиг даты вперёд без дублей, отмена проведения "
		+ "и прямое удаление, "
		+ "пересчёт стадий заказа и «ИзОстатка» под ключами верхнеуровневой продукции, запреты правки с текстом про "
		+ "передачу, выключенная константа и сырьё без автовыпуска, позиция без карты и без потребности, исчерпанный "
		+ "потолок, два канала на одном заказе, передача задним числом не забирает уже переданное (S9), отказ по "
		+ "нехватке материалов");

КонецФункции

// Шаг 1: полуфабрикат ПФ (карта: СМ x 2) входит в карты двух изделий ГП (1) и ГП2 (2); заказ на производство
// ГП x 10 и ГП2 x 5 разворачивается по картам, потребность в ПФ - 20, в СМ - 40.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - номенклатура и заказ сценария
//
Функция ДанныеПередачиСценария(Контекст)

	Данные = Новый Структура;
	Данные.Вставить("СМ", Контекст.Сырье);
	Данные.Вставить("ПФ", НовыйПолуфабрикатСценария(Контекст, "полуфабрикат переработки"));
	Данные.Вставить("ГП", НовоеИзделиеСценария(Контекст, "изделие из полуфабриката"));
	Данные.Вставить("ГП2", НовоеИзделиеСценария(Контекст, "второе изделие из полуфабриката"));
	// BSLLS:MagicNumber-off - карты: ПФ из СМ x 2, ГП из ПФ x 1, ГП2 из ПФ x 2; заказ ГП 10 и ГП2 5; сырья 200.
	ЗаписатьКартуСценария(Контекст, Данные.ПФ, СтрокаКартыСценария(Данные.СМ, 2));
	ЗаписатьКартуСценария(Контекст, Данные.ГП, СтрокаКартыСценария(Данные.ПФ, 1));
	ЗаписатьКартуСценария(Контекст, Данные.ГП2, СтрокаКартыСценария(Данные.ПФ, 2));
	ДокументЗакупки(Контекст, Данные.СМ, 200, Контекст.Числа.ЦенаСырья);

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.ГП, 10, Контекст.Числа.ЦенаПродажи);
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Данные.ГП2, 5, Контекст.Числа.ЦенаПродажи);
	// BSLLS:MagicNumber-on
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	Провести(Заказ);
	Данные.Вставить("Заказ", Заказ.Ссылка);
	Возврат Данные;

КонецФункции

// Шаги 1 и 5: передача ПФ без складского остатка выпускает его целиком по листьям карты, автовыпуск датирован на
// секунду раньше передачи и несёт признак автосоздания; «ИзОстатка» ложится под ключи верхнеуровневой продукции
// заказа, а стадия заказа пересчитывается проведением передачи (без ветки передачи в ЗаказОснованияДокумента
// история осталась бы от прошлого состояния).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПередачиСценария
//
Процедура ПроверитьПервуюПередачуАвтовыпуска(Контекст, Данные)

	// BSLLS:MagicNumber-off - передаётся ПФ 4: автовыпуск 4, сырья 8, остаток сырья 200 - 8.
	Передача = ПередачаПолуфабриката(Контекст, Данные, Данные.ПФ, 4);
	Расчет = Производство.ДанныеАвтовыпуска(Передача);
	Проверить(Расчет.Активен, "автовыпуск передачи по заказу на производство активен");
	ПроверитьРавенство("ПФ 4", ПозицииПередачиСтрокой(Данные, Расчет.Продукция), "продукция расчёта передачи");
	ПроверитьРавенство("СМ 8", ПозицииПередачиСтрокой(Данные, Расчет.Материалы), "материалы расчёта передачи");

	Провести(Передача);
	Автовыпуск = ЕдинственныйАвтовыпуск(Передача.Ссылка, "первая передача");
	ПроверитьРавенство(Передача.Дата - 1, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "Дата"),
		"дата автовыпуска на секунду раньше передачи");
	Проверить(Производство.ЭтоАвтовыпуск(Автовыпуск), "у автовыпуска передачи есть признак автосоздания");
	ПроверитьРавенство(4, ВыпущеноАвтовыпуском(Передача.Ссылка), "выпущено полуфабриката первой передачей");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, Данные.ПФ).Количество, "полуфабрикат ушёл переработчику");
	ПроверитьРавенство(4, ОстатокВПереработке(Контекст.Контрагент, Данные.ПФ).Количество,
		"полуфабрикат у переработчика");
	ПроверитьРавенство(192, ОстатокТовара(Контекст.Склад, Данные.СМ).Количество, "сырьё после автовыпуска: 200 - 8");
	ПроверитьРавенство("ГП/СМ 8", ДвиженияИзОстаткаСтрокой(Данные, Автовыпуск),
		"«ИзОстатка» под ключами верхнеуровневой продукции заказа");
	// BSLLS:MagicNumber-on
	Расчет = ПроверитьСинхронностьСтадииЗаказа(Данные.Заказ, "первая передача");
	Проверить(Расчет.ДоляПоступления > 0, "«ИзОстатка» автовыпуска передачи подняла долю поступления заказа");
	Видим = Ложь;
	Для Каждого СтрокаВыпуска Из Обработки.АРМПроизводство.СтрокиВыпусковИОтгрузок(Данные.Заказ).Выпуски Цикл
		Видим = Видим Или СтрокаВыпуска.Документ = Автовыпуск;
	КонецЦикла;
	// BSLLS:UsingHardcodeNetworkAddress-off - номер версии конфигурации, а не адрес.
	Проверить(Видим, "автовыпуск передачи - в строках закладки «Выпуск» рабочего места (2.0.16.105)");
	// BSLLS:UsingHardcodeNetworkAddress-on
	Данные.Вставить("Передача1", Передача.Ссылка);
	Данные.Вставить("Автовыпуск1", Автовыпуск);

КонецПроцедуры

// Шаги 2-4: полностью покрытая складским остатком передача автовыпуска не заводит; при частичном остатке
// выпускается разница; перепроведение не плодит дублей и не распроводит собственный автовыпуск; сдвиг даты
// проведённой передачи вперёд оставляет границу остатков на дате существующего автовыпуска.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПередачиСценария
//
Процедура ПроверитьОстатокПолуфабрикатаПередачи(Контекст, Данные)

	// BSLLS:MagicNumber-off - остаток ПФ 3, передаётся 3: выпускать нечего.
	ДокументЗакупки(Контекст, Данные.ПФ, 3, Контекст.Числа.ЦенаСырья);
	Покрытая = ПередачаПолуфабриката(Контекст, Данные, Данные.ПФ, 3);
	ПроверитьРавенство(0, Производство.ДанныеАвтовыпуска(Покрытая).Продукция.Количество(),
		"полуфабрикат на складе повторно не выпускается");
	Провести(Покрытая);
	ПроверитьРавенство(0, ЧислоВыпусковОснования(Покрытая.Ссылка), "у покрытой остатком передачи автовыпуска нет");

	// Остаток ПФ 2, передаётся 5: выпускается разница 3 (сырья 6).
	ДокументЗакупки(Контекст, Данные.ПФ, 2, Контекст.Числа.ЦенаСырья);
	Частичная = ПередачаПолуфабриката(Контекст, Данные, Данные.ПФ, 5);
	Провести(Частичная);
	Автовыпуск = ЕдинственныйАвтовыпуск(Частичная.Ссылка, "частичный остаток");
	ПроверитьРавенство(3, ВыпущеноАвтовыпуском(Частичная.Ссылка), "к выпуску: передаётся 5 минус остаток 2");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, Данные.ПФ).Количество, "остаток ПФ после частичной передачи");

	// Перепроведение: тот же автовыпуск, то же количество - собственный приход и собственный расход отсекает граница.
	Частичная.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(Автовыпуск, ЕдинственныйАвтовыпуск(Частичная.Ссылка, "перепроведение передачи"),
		"перепроведение - тот же автовыпуск");
	ПроверитьРавенство(3, ВыпущеноАвтовыпуском(Частичная.Ссылка), "перепроведение не изменило количество");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, Данные.ПФ).Количество, "остаток ПФ после перепроведения");

	// Дата проведённой передачи сдвинута ВПЕРЁД: движения существующего автовыпуска лежат на ЕГО прежней дате,
	// и граница остатков обязана остаться там же. Считай её по новой дате - собственный приход полуфабриката
	// попал бы в остаток, «к выпуску» вышел бы нулём, автовыпуск распровёлся бы и пометился на удаление, а
	// передача отказывала бы по нехватке уже навсегда.
	// Проверяется и расчётом, и настоящим перепроведением: расчёт ловит границу, а проведение - то, что
	// документ со сдвинутой датой больше не вычитает собственные ПРЕЖНИЕ движения второй раз (для этого
	// у передачи выставлено удаление движений «автоматически», как у реализации).
	Частичная.Дата = ДатаЧерезДвеСекунды(Контекст);
	ПроверитьРавенство("ПФ 3", ПозицииПередачиСтрокой(Данные, Производство.ДанныеАвтовыпуска(Частичная).Продукция),
		"сдвиг даты вперёд: граница осталась на дате существующего автовыпуска");
	Частичная.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(Автовыпуск, ЕдинственныйАвтовыпуск(Частичная.Ссылка, "сдвиг даты передачи вперёд"),
		"сдвиг даты вперёд - тот же автовыпуск");
	ПроверитьРавенство(3, ВыпущеноАвтовыпуском(Частичная.Ссылка), "сдвиг даты вперёд не изменил количество");
	ПроверитьРавенство(Частичная.Дата - 1, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "Дата"),
		"автовыпуск переехал вслед за датой передачи");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, Данные.ПФ).Количество, "остаток ПФ после сдвига даты");
	// BSLLS:MagicNumber-on
	Данные.Вставить("Передача2", Частичная);
	Данные.Вставить("Автовыпуск2", Автовыпуск);

КонецПроцедуры

// Шаги 6-7: отмена проведения передачи распроводит её автовыпуск и пересчитывает стадии, пометка удаления переходит
// и снимается, повторное проведение проводит тот же автовыпуск; прямое удаление передачи распроводит и помечает её
// автовыпуск (ПередУдалением).
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПередачиСценария
//
Процедура ПроверитьОтменуИУдалениеПередачи(Контекст, Данные)

	Передача = Данные.Передача2;
	Автовыпуск = Данные.Автовыпуск2;
	Передача.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Проверить(Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "Проведен"),
		"автовыпуск распроведён отменой проведения передачи");
	ПроверитьРавенство(0, ЧислоДвиженийПотребности(Автовыпуск), "движения потребностей распроведённого автовыпуска");
	ПроверитьСинхронностьСтадииЗаказа(Данные.Заказ, "отмена проведения передачи");

	Передача.УстановитьПометкуУдаления(Истина);
	Проверить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "ПометкаУдаления"),
		"пометка удаления передачи перешла на автовыпуск");
	Передача.УстановитьПометкуУдаления(Ложь);
	Проверить(Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Автовыпуск, "ПометкаУдаления"),
		"снятие пометки удаления передачи снято у автовыпуска");
	Провести(Передача);
	ПроверитьРавенство(Автовыпуск, ЕдинственныйАвтовыпуск(Передача.Ссылка, "повторное проведение передачи"),
		"повторное проведение - тот же автовыпуск");

	// BSLLS:MagicNumber-off - отдельная передача ПФ 1 удаляется целиком.
	Удаляемая = ПередачаПолуфабриката(Контекст, Данные, Данные.ПФ, 1);
	// BSLLS:MagicNumber-on
	Провести(Удаляемая);
	АвтовыпускУдаляемой = ЕдинственныйАвтовыпуск(Удаляемая.Ссылка, "удаляемая передача");
	Удаляемая.Ссылка.ПолучитьОбъект().Удалить();
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АвтовыпускУдаляемой, "Проведен,ПометкаУдаления");
	Проверить(Не Реквизиты.Проведен, "прямое удаление передачи распровело её автовыпуск");
	Проверить(Реквизиты.ПометкаУдаления, "прямое удаление передачи пометило её автовыпуск");

КонецПроцедуры

// Шаги 8, 15 и 13: запрет ручной правки автовыпуска передачи с текстом про передачу, отклонение ручного выпуска с
// основанием-передачей и смены основания у существующего выпуска, ввод передачи на основании ПФ-автовыпуска
// подставляет заказ и ожидаемую продукцию. Все отказы - в ПередЗаписью и в проверке без записи: транзакцию они не
// травят и могут стоять в середине сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПередачиСценария
//
Процедура ПроверитьЗапретыПередачи(Контекст, Данные)

	ПолучитьСообщенияПользователю(Истина);
	Отказ = Ложь;
	Производство.ПроверитьПравкуАвтовыпуска(Данные.Автовыпуск1.ПолучитьОбъект(), Отказ);
	Проверить(Отказ, "ручная правка автовыпуска передачи отклоняется");
	Сообщения = СообщенияПользователю();
	Проверить(СтрНайти(Сообщения, Строка(Данные.Передача1)) > 0,
		"в тексте запрета названа передача, а не реализация: " + Сообщения);

	Ручной = НовыйДокумент(Контекст, "ВыпускПродукции");
	Ручной.Основание = Данные.Передача1;
	Отказ = Ложь;
	Производство.ПроверитьПравкуАвтовыпуска(Ручной, Отказ);
	Проверить(Отказ, "ручной выпуск с основанием-передачей отклоняется");

	// Смена основания у существующего выпуска: в базе лежит заказ, в объекте - передача.
	Существующий = РучнойВыпускПередачи(Контекст, Данные);
	Объект = Существующий.ПолучитьОбъект();
	Объект.Основание = Данные.Передача1;
	Отказ = Ложь;
	Производство.ПроверитьПравкуАвтовыпуска(Объект, Отказ);
	Проверить(Отказ, "смена основания существующего выпуска на передачу отклоняется");
	ПолучитьСообщенияПользователю(Истина);

	// Ввод передачи на основании ПФ-автовыпуска: основание - заказ автовыпуска, а не сама передача-родитель.
	НоваяПередача = НовыйДокумент(Контекст, "ПередачаВПереработку");
	НоваяПередача.Заполнить(Данные.Автовыпуск1);
	ПроверитьРавенство(Данные.Заказ, НоваяПередача.Основание, "ввод передачи на основании автовыпуска берёт заказ");
	Проверить(НоваяПередача.ТЧГотоваяПродукция.Количество() > 0,
		"ввод передачи на основании автовыпуска заполнил ожидаемую продукцию");

КонецПроцедуры

// Шаги 9-11: выключенная константа гасит автовыпуск и на передаче; сырьё в переработку автовыпуска не запускает
// (негативная граница правила ПроизводитсяПоТехкарте); полуфабрикат без действующей техкарты даёт сообщение и
// передачу без автовыпуска.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПередачиСценария
//
Процедура ПроверитьГраницыПередачи(Контекст, Данные)

	// BSLLS:MagicNumber-off - по единице ПФ на каждую проверку, сырья 2.
	ДокументЗакупки(Контекст, Данные.ПФ, 1, Контекст.Числа.ЦенаСырья);
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Ложь);
	БезКонстанты = ПередачаПолуфабриката(Контекст, Данные, Данные.ПФ, 1);
	Расчет = Производство.ДанныеАвтовыпуска(БезКонстанты);
	Проверить(Не Расчет.Управляется И Не Расчет.Активен, "выключенная константа: автовыпуск передачи не управляется");
	Провести(БезКонстанты);
	ПроверитьРавенство(0, ЧислоВыпусковОснования(БезКонстанты.Ссылка),
		"выключенная константа: передача проведена без автовыпуска");
	Константы.ИспользоватьАвтовыпускПриОтгрузке.Установить(Истина);

	// Сырьё переработчику: правило ПроизводитсяПоТехкарте его не пропускает, автовыпуска нет.
	Сырьевая = ПередачаПолуфабриката(Контекст, Данные, Данные.СМ, 2);
	ПроверитьРавенство(0, Производство.ДанныеАвтовыпуска(Сырьевая).Продукция.Количество(),
		"сырьё в переработку автовыпуска не запускает");
	Провести(Сырьевая);
	ПроверитьРавенство(0, ЧислоВыпусковОснования(Сырьевая.Ссылка), "у передачи сырья автовыпуска нет");

	// Полуфабрикат без карты: потребность в заказе есть, карты нет - сообщение и передача без автовыпуска.
	БезКарты = НовыйПолуфабрикатСценария(Контекст, "полуфабрикат без карты");
	ДокументЗакупки(Контекст, БезКарты, 2, Контекст.Числа.ЦенаСырья);
	ЗаказБезКарты = ЗаказМатериалаСценария(Контекст, БезКарты, 2);
	БезКартыПередача = ПередачаПоЗаказу(Контекст, ЗаказБезКарты, БезКарты, 2);
	// BSLLS:MagicNumber-on
	ПроверитьРавенство(0, Производство.ДанныеАвтовыпуска(БезКартыПередача).Продукция.Количество(),
		"позиция без действующей карты из выпускаемой продукции убирается");
	ПолучитьСообщенияПользователю(Истина);
	Провести(БезКартыПередача);
	Сообщения = СообщенияПользователю();
	Проверить(СтрНайти(Сообщения, Строка(БезКарты)) > 0, "о позиции без карты сообщено: " + Сообщения);
	ПроверитьРавенство(0, ЧислоВыпусковОснования(БезКартыПередача.Ссылка), "у передачи без карты автовыпуска нет");

КонецПроцедуры

// Шаги 12 и 12a: нулевая потребность заказа даёт сообщение, а не молчаливый ноль; исчерпанный потолок
// «Потребность - Выпущено» при нулевом складском остатке оставляет передачу без автовыпуска. Потолок проверяется
// РАСЧЁТОМ БЕЗ ЗАПИСИ: настоящее проведение здесь дало бы отказ по нехватке, а двух шагов с отказом в сценарии быть
// не может - первый отравляет транзакцию.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПередачиСценария
//
Процедура ПроверитьПотолокПередачи(Контекст, Данные)

	// BSLLS:MagicNumber-off - заказ без ПФ в составе, передаётся 1: потребности нет.
	ДокументЗакупки(Контекст, Данные.ПФ, 1, Контекст.Числа.ЦенаСырья);
	ЗаказБезПотребности = ЗаказМатериалаСценария(Контекст, Данные.СМ, 1);
	БезПотребности = ПередачаПоЗаказу(Контекст, ЗаказБезПотребности, Данные.ПФ, 1);
	ПроверитьРавенство(0, Производство.ДанныеАвтовыпуска(БезПотребности).Продукция.Количество(),
		"при нулевой потребности заказа автовыпуска нет");
	ПолучитьСообщенияПользователю(Истина);
	Провести(БезПотребности);
	Сообщения = СообщенияПользователю();
	Проверить(СтрНайти(Сообщения, Строка(Данные.ПФ)) > 0, "о нулевой потребности сообщено: " + Сообщения);

	// Потолок исчерпан: потребность 2, ручной выпуск 2 вне канала передачи, остаток израсходован первой передачей.
	ЗаказПотолка = ЗаказМатериалаСценария(Контекст, Данные.ПФ, 2);
	РучнойВыпускПолуфабриката(Контекст, Данные, ЗаказПотолка, 2);
	Первая = ПередачаПоЗаказу(Контекст, ЗаказПотолка, Данные.ПФ, 2);
	Провести(Первая);
	ПроверитьРавенство(0, ЧислоВыпусковОснования(Первая.Ссылка), "ручной выпуск покрыл первую передачу потолка");
	Вторая = ПередачаПоЗаказу(Контекст, ЗаказПотолка, Данные.ПФ, 2);
	// BSLLS:MagicNumber-on
	Расчет = Производство.ДанныеАвтовыпуска(Вторая);
	Проверить(Расчет.Активен, "расчёт исчерпанного потолка активен");
	ПроверитьРавенство(0, Расчет.Продукция.Количество(),
		"исчерпанный потолок «Потребность - Выпущено» автовыпуска не даёт - это правильный отказ, а не дефект");

КонецПроцедуры

// Шаг 14: один свободный ручной выпуск не зачитывается обоим каналам. В последовательности «выпуск -> передача ->
// реализация» отгрузка обязана выпустить заново. До S9 это держало слагаемое «Передано» документного «свободно»;
// с S9 покрытие у обоих каналов - свободный складской остаток, а склад после передачи пуст. Число то же.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПередачиСценария
//
Процедура ПроверитьДваКаналаАвтовыпуска(Контекст, Данные)

	// BSLLS:MagicNumber-off - заказ X 20 с сырьём 2 на единицу: ручной выпуск 10, передача 10, отгрузка 10.
	Изделие = НовоеИзделиеСценария(Контекст, "изделие двух каналов");
	ЗаписатьКартуСценария(Контекст, Изделие, СтрокаКартыСценария(Данные.СМ, 2));
	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Изделие, 20, Контекст.Числа.ЦенаПродажи);
	Документы.ЗаказПокупателя.ЗаполнитьМатериалыПоТехкартам(Заказ.ТЧТовары, Заказ.ТЧМатериалы, Заказ.Дата);
	Провести(Заказ);

	РучнойВыпускИзделия(Контекст, Данные, Заказ.Ссылка, Изделие, 10);
	Передача = ПередачаПоЗаказу(Контекст, Заказ.Ссылка, Изделие, 10);
	Провести(Передача);
	ПроверитьРавенство(0, ЧислоВыпусковОснования(Передача.Ссылка),
		"передача берёт со склада то, что выпустил ручной выпуск");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, Изделие).Количество, "склад после передачи пуст");

	Реализация = РеализацияСтадии(Контекст, Заказ.Ссылка);
	Реализация.Дата = ДатаЧерезДвеСекунды(Контекст);
	УстановитьКоличествоСтроки(Реализация.ТЧТовары[0], 10);
	Провести(Реализация);
	ПроверитьРавенство(10, ВыпущеноАвтовыпуском(Реализация.Ссылка),
		"склад пуст после передачи: переданное переработчику отгрузке второй раз не зачитывается");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 18 (S9): передача задним числом не забирает полуфабрикат, уже переданный более поздней передачей. Свой
// полуфабрикат ПФ18 (карта: СМ18 x 2) и свой заказ с потребностью ПФ18 5.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьСвободныйОстатокПередачи(Контекст)

	СМ18 = НоваяНоменклатура(Контекст, "сырьё свободного остатка передачи", Перечисления.ТипыНоменклатуры.Сырье);
	ПФ18 = НовыйПолуфабрикатСценария(Контекст, "полуфабрикат свободного остатка");
	// BSLLS:MagicNumber-off - СМ18 10, ПФ18 3 на складе, потребность 5; передачи 3 и 2 задним числом.
	ЗаписатьКартуСценария(Контекст, ПФ18, СтрокаКартыСценария(СМ18, 2));
	ДокументЗакупки(Контекст, СМ18, 10, Контекст.Числа.ЦенаСырья);
	ДокументЗакупки(Контекст, ПФ18, 3, Контекст.Числа.ЦенаСырья);
	Заказ = ЗаказМатериалаСценария(Контекст, ПФ18, 5);
	// Секунда для передачи задним числом: её автовыпуск ляжет в пропущенную секунду перед ней, после закупок.
	ДатаЗаднимЧислом = ДатаЧерезДвеСекунды(Контекст);

	Поздняя = ПередачаПоЗаказу(Контекст, Заказ, ПФ18, 3);
	Провести(Поздняя);
	ПроверитьРавенство(0, ЧислоВыпусковОснования(Поздняя.Ссылка), "передача 3 покрыта складским остатком 3");

	ЗаднимЧислом = ПередачаПоЗаказу(Контекст, Заказ, ПФ18, 2);
	ЗаднимЧислом.Дата = ДатаЗаднимЧислом;
	Провести(ЗаднимЧислом);
	ПроверитьРавенство(2, ВыпущеноАвтовыпуском(ЗаднимЧислом.Ссылка),
		"передача задним числом выпускает 2: остаток 3 на её границе уже передан более поздней передачей");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, ПФ18).Количество, "остаток ПФ18 не ушёл в минус");
	ПроверитьРавенство(6, ОстатокТовара(Контекст.Склад, СМ18).Количество, "сырьё: 10 минус 2 x 2");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 17, последний: полуфабрикат с картой на 10 единиц сырья при остатке сырья 3 - отказ проведения передачи с
// сообщением про недостающее сырьё.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
Процедура ПроверитьОтказПоМатериаламПередачи(Контекст)

	ИмяМатериала = "сырьё передачи";
	// BSLLS:MagicNumber-off - остаток сырья 3, на 5 полуфабрикатов нужно 50.
	СМ17 = НоваяНоменклатура(Контекст, ИмяМатериала, Перечисления.ТипыНоменклатуры.Сырье);
	ПФ17 = НовыйПолуфабрикатСценария(Контекст, "полуфабрикат без сырья");
	ЗаписатьКартуСценария(Контекст, ПФ17, СтрокаКартыСценария(СМ17, 10));
	ДокументЗакупки(Контекст, СМ17, 3, Контекст.Числа.ЦенаСырья);
	Заказ = ЗаказМатериалаСценария(Контекст, ПФ17, 5);
	Передача = ПередачаПоЗаказу(Контекст, Заказ, ПФ17, 5);
	// BSLLS:MagicNumber-on
	ПолучитьСообщенияПользователю(Истина);
	Проведена = Истина;
	ТекстОшибки = "";
	Попытка
		Передача.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		// После исключения в записи транзакция сценария годится только для отката: к базе больше не обращаемся.
		Проведена = Ложь;
		ТекстОшибки = ОшибкаОднойСтрокой(ИнформацияОбОшибке());
	КонецПопытки;
	Проверить(Не Проведена, "передача при нехватке материалов автовыпуска не проводится");
	Сообщения = СообщенияПользователю();
	Проверить(СтрНайти(Сообщения + ТекстОшибки, ПометкаТеста() + ": " + ИмяМатериала) > 0,
		"в отказе названо недостающее сырьё:" + Сообщения + " | ошибка: " + ТекстОшибки);

КонецПроцедуры

// Непроведённая передача заказа сценария на переработчика контекста с датой через две секунды.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Данные       - Структура - см. ДанныеПередачиСценария
//  Номенклатура - СправочникСсылка.Номенклатура - передаваемая позиция
//  Количество   - Число - количество
//
// Возвращаемое значение:
//  ДокументОбъект.ПередачаВПереработку - непроведённая передача
//
Функция ПередачаПолуфабриката(Контекст, Данные, Номенклатура, Количество)

	Возврат ПередачаПоЗаказу(Контекст, Данные.Заказ, Номенклатура, Количество);

КонецФункции

// Непроведённая передача по заданному заказу: ожидаемая продукция обязательна - без неё не проходит проверка
// заполнения документа.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Заказ        - ДокументСсылка.ЗаказПокупателя - основание передачи
//  Номенклатура - СправочникСсылка.Номенклатура - передаваемая позиция
//  Количество   - Число - количество
//
// Возвращаемое значение:
//  ДокументОбъект.ПередачаВПереработку - непроведённая передача
//
Функция ПередачаПоЗаказу(Контекст, Заказ, Номенклатура, Количество)

	Передача = НовыйДокумент(Контекст, "ПередачаВПереработку");
	Передача.Дата = ДатаЧерезДвеСекунды(Контекст);
	Передача.Контрагент = Контекст.Контрагент;
	Передача.Основание = Заказ;
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Номенклатура, Количество, 0);
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧГотоваяПродукция", Номенклатура, Количество, 0);
	Возврат Передача;

КонецФункции

// Записанный заказ на производство, у которого позиция лежит МАТЕРИАЛОМ строки товаров: потребность в
// полуфабрикате берётся именно отсюда - в строках товаров заказа полуфабрикат не лежит.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Материал   - СправочникСсылка.Номенклатура - материал строки
//  Количество - Число - потребность в материале
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПокупателя - записанный заказ
//
Функция ЗаказМатериалаСценария(Контекст, Материал, Количество)

	Заказ = ЗаказКлиентаСценария(Контекст);
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказаПокупателя.Производство;
	Заказ.ТЧТовары.Очистить();
	ДобавитьСтрокуТоваров(Контекст, Заказ, "ТЧТовары", Контекст.Продукция, 1, Контекст.Числа.ЦенаПродажи);
	ДобавитьМатериалЗаказа(Контекст, Заказ, Заказ.ТЧТовары[0], Материал, Количество);
	Записать(Заказ);
	Возврат Заказ.Ссылка;

КонецФункции

// Проведённый ручной выпуск полуфабриката по заказу: сырьё - по его карте.
//
// Параметры:
//  Контекст   - Структура - см. НовыйКонтекст
//  Данные     - Структура - см. ДанныеПередачиСценария
//  Заказ      - ДокументСсылка.ЗаказПокупателя - основание выпуска
//  Количество - Число - выпуск
//
Процедура РучнойВыпускПолуфабриката(Контекст, Данные, Заказ, Количество)

	РучнойВыпускИзделия(Контекст, Данные, Заказ, Данные.ПФ, Количество);

КонецПроцедуры

// Проведённый ручной выпуск позиции по заказу: сырьё - по её карте.
//
// Параметры:
//  Контекст     - Структура - см. НовыйКонтекст
//  Данные       - Структура - см. ДанныеПередачиСценария
//  Заказ        - ДокументСсылка.ЗаказПокупателя - основание выпуска
//  Номенклатура - СправочникСсылка.Номенклатура - выпускаемая позиция
//  Количество   - Число - выпуск
//
Процедура РучнойВыпускИзделия(Контекст, Данные, Заказ, Номенклатура, Количество)

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Основание = Заказ;
	Выпуск.Номенклатура = Номенклатура;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = Количество;
	Выпуск.Количество = Количество;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ЗаполнитьСырьеПоТехкарте(Контекст, Выпуск, Количество);
	Провести(Выпуск);

КонецПроцедуры

// Записанный (непроведённый) ручной выпуск полуфабриката по заказу сценария - образец выпуска, которому меняют
// основание.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - см. ДанныеПередачиСценария
//
// Возвращаемое значение:
//  ДокументСсылка.ВыпускПродукции - записанный выпуск
//
Функция РучнойВыпускПередачи(Контекст, Данные)

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Основание = Данные.Заказ;
	Выпуск.Номенклатура = Данные.ПФ;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = 1;
	Выпуск.Количество = 1;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	Выпуск.Записать();
	Возврат Выпуск.Ссылка;

КонецФункции

// Расчёт стадии заказа совпадает с последней записью истории: именно эту сверку ломает пропущенная ветка передачи
// в ПроизводственныеЗаказы.ЗаказОснованияДокумента - расчёт уезжает вперёд, а история остаётся прежней.
//
// Параметры:
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ на производство
//  Описание - Строка - шаг сценария
//
// Возвращаемое значение:
//  Структура - см. ПроизводственныеЗаказы.РассчитатьСтадию
//
Функция ПроверитьСинхронностьСтадииЗаказа(Заказ, Описание)

	Расчет = ПроизводственныеЗаказы.РассчитатьСтадию(Заказ);
	Проверить(Расчет <> Неопределено, Описание + ": нет расчёта стадии у заказа на производство");
	Запись = ПроизводственныеЗаказы.ДанныеСтадии(Заказ);
	Проверить(Запись <> Неопределено, Описание + ": нет записи истории");
	ПроверитьРавенство(Расчет.Стадия, Запись.Стадия, Описание + " - стадия в истории");
	ПроверитьРавенство(Расчет.Индикатор, Запись.Индикатор, Описание + " - индикатор в истории");
	Возврат Расчет;

КонецФункции

// Число выпусков с заданным основанием - и проведённых, и нет.
//
// Параметры:
//  Основание - ДокументСсылка - основание выпуска
//
// Возвращаемое значение:
//  Число - выпусков
//
Функция ЧислоВыпусковОснования(Основание)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Выпусков
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|ГДЕ
	|	Выпуски.Основание = &Основание");
	Запрос.УстановитьПараметр("Основание", Основание);
	Возврат ПерваяСтрока(Запрос, "Выпусков").Выпусков;

КонецФункции

// Позиции таблицы расчёта строкой «ПФ 4» в порядке строк - именами сценария, а не представлениями справочника.
//
// Параметры:
//  Данные  - Структура - см. ДанныеПередачиСценария
//  Таблица - ТаблицаЗначений - Номенклатура, Количество
//
// Возвращаемое значение:
//  Строка - позиции
//
Функция ПозицииПередачиСтрокой(Данные, Таблица)

	Имена = ИменаПередачиСценария(Данные);
	Части = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Части.Добавить(ИмяПозицииПередачи(Имена, Строка.Номенклатура) + " " + СтрокаЧисла(Строка.Количество));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Движения «ИзОстатка» выпуска строкой «ГП/СМ 8»: ключ - продукция и материал потребности заказа.
//
// Параметры:
//  Данные      - Структура - см. ДанныеПередачиСценария
//  Регистратор - ДокументСсылка.ВыпускПродукции - выпуск
//
// Возвращаемое значение:
//  Строка - движения
//
Функция ДвиженияИзОстаткаСтрокой(Данные, Регистратор)

	Имена = ИменаПередачиСценария(Данные);
	Набор = РегистрыНакопления.ПотребностиПроизводства.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	Части = Новый Массив;
	Для Каждого Запись Из Набор Цикл
		Если Запись.ИзОстатка = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = ИмяПозицииПередачи(Имена, Запись.Продукция) + "/" + ИмяПозицииПередачи(Имена, Запись.Материал);
		Части.Добавить(Ключ + " " + СтрокаЧисла(Запись.ИзОстатка));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

Функция ИменаПередачиСценария(Данные)

	Имена = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("СМ,ПФ,ГП,ГП2", ",") Цикл
		Имена.Вставить(Данные[Имя], Имя);
	КонецЦикла;
	Возврат Имена;

КонецФункции

Функция ИмяПозицииПередачи(Имена, Номенклатура)

	Имя = Имена[Номенклатура];
	Возврат ?(Имя = Неопределено, Строка(Номенклатура), Имя);

КонецФункции

#КонецОбласти

#Область РучнойВыпуск

// Ручной выпуск (E10): материалы заполняет та же процедура модуля менеджера, что вызывает форма документа, - по картам на
// дату документа, в одиночном и многострочном режиме; продукция без карты материалы не меняет; совет перезаполнить
// выпуски при смене карты видит ручной мультивыпуск.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийРучнойВыпуск(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;
	// BSLLS:MagicNumber-off - остатки M1 20 по 10, M2 10 по 30; карта P: M1 2, через два дня M1 3; карта P2: M2 1.
	Данные = Новый Структура;
	Данные.Вставить("M1", Контекст.Сырье);
	Данные.Вставить("P1", Контекст.Продукция);
	Данные.Вставить("M2", НоваяНоменклатура(Контекст, "сырьё 2", Перечисления.ТипыНоменклатуры.Сырье));
	Данные.Вставить("P2", НоваяНоменклатура(Контекст, "продукция 2", Перечисления.ТипыНоменклатуры.Продукция));
	ДатаВторойВерсии = НачалоДня(Контекст.Дата) + 2 * 86400;
	ТехнологическиеКарты.ЗаписатьТехкарту(Данные.P1, СоставИзМатериала(Контекст, Данные.M1, 3), ДатаВторойВерсии);
	ТехнологическиеКарты.ЗаписатьТехкарту(Данные.P2, СоставИзМатериала(Контекст, Данные.M2, 1), Контекст.Дата);
	ДокументЗакупки(Контекст, Данные.M1, 20, 10);
	ДокументЗакупки(Контекст, Данные.M2, 10, 30);

	ПроверитьОдиночныйРучнойВыпуск(Контекст, Данные, ДатаВторойВерсии);
	ПроверитьРучнойМультивыпуск(Контекст, Данные);

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Номенклатура = Контекст.Товар;
	Выпуск.КоличествоУпаковок = 1;
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧТовары", Данные.M2, 4, 0);
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Ложь);
	ПроверитьРавенство("M2 4", МатериалыРучногоВыпускаСтрокой(Данные, Выпуск), "продукция без карты не меняет материалы");
	// BSLLS:MagicNumber-on

	Возврат РезультатСценария("материалы по карте на дату документа, одиночный режим не читает строки продукции, "
		+ "мультивыпуск по двум картам, продукция без карты, совет перезаполнить выпуски по строке мультивыпуска");

КонецФункции

// Шаг 1: выпуск P 5 в одиночном режиме с посторонней строкой материалов и строкой P2 в ТЧГотоваяПродукция.
//
// Параметры:
//  Контекст         - Структура - см. НовыйКонтекст
//  Данные           - Структура - номенклатура сценария
//  ДатаВторойВерсии - Дата - день второй версии карты P
//
Процедура ПроверитьОдиночныйРучнойВыпуск(Контекст, Данные, ДатаВторойВерсии)

	// BSLLS:MagicNumber-off - P 5: по первой версии M1 10, по второй M1 15.
	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Номенклатура = Данные.P1;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = 5;
	Выпуск.Количество = 5;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧТовары", Контекст.Товар, 1, 0);
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Данные.P2, 9, 0);
	ДатаВыпуска = Выпуск.Дата;
	Выпуск.Дата = ДатаВторойВерсии;
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Ложь);
	ПроверитьРавенство("M1 15", МатериалыРучногоВыпускаСтрокой(Данные, Выпуск), "материалы на дату второй версии карты");
	Выпуск.Дата = ДатаВыпуска;
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Ложь);
	ПроверитьРавенство("M1 10", МатериалыРучногоВыпускаСтрокой(Данные, Выпуск),
		"материалы на дату выпуска, продукция из шапки, посторонняя строка заменена");
	СтрокаМатериалов = Выпуск.ТЧТовары[0];
	ПроверитьРавенство(10, СтрокаМатериалов.Количество, "количество строки материалов рассчитано");
	ПроверитьРавенство(2, СтрокаМатериалов.КоличествоЗаЕдиницу, "расход на единицу по карте");
	ПроверитьРавенство(1, СтрокаМатериалов.КодСтроки, "код строки материалов");
	Провести(Выпуск);

	ПроверитьРавенство(10, ОстатокТовара(Контекст.Склад, Данные.M1).Количество, "M1 после одиночного выпуска");
	ПроверитьРавенство(100, ОстатокТовара(Контекст.Склад, Данные.P1).Сумма, "себестоимость P после одиночного выпуска");
	Проверить(Не ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Данные.P2, НачалоДня(Контекст.Дата)),
		"посторонняя строка продукции одиночного выпуска не записана");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Шаг 2: мультивыпуск P 1 и P2 2 по двум картам, себестоимость итогом, совет перезаполнить выпуски по строке P2.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Данные   - Структура - номенклатура сценария
//
Процедура ПроверитьРучнойМультивыпуск(Контекст, Данные)

	// BSLLS:MagicNumber-off - M1 2 по 10 и M2 2 по 30: к 100 первого выпуска прибавляется 80.
	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Данные.P1, 1, 0);
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Данные.P2, 2, 0);
	ЗаполнитьЗначенияСвойств(Выпуск, Выпуск.ТЧГотоваяПродукция[0],
		"Номенклатура, Характеристика, Серия, Упаковка, КоличествоУпаковок, Количество");
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧТовары", Контекст.Товар, 1, 0);
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Истина);
	ПроверитьРавенство("M1 2, M2 2", МатериалыРучногоВыпускаСтрокой(Данные, Выпуск), "материалы мультивыпуска по двум картам");
	ПроверитьРавенство(2, Выпуск.ТЧТовары[1].КодСтроки, "код второй строки материалов");
	Провести(Выпуск);

	ПроверитьРавенство(8, ОстатокТовара(Контекст.Склад, Данные.M1).Количество, "M1 после мультивыпуска");
	ПроверитьРавенство(8, ОстатокТовара(Контекст.Склад, Данные.M2).Количество, "M2 после мультивыпуска");
	ПроверитьРавенство(180, ОстатокТовара(Контекст.Склад, Данные.P1).Сумма + ОстатокТовара(Контекст.Склад, Данные.P2).Сумма,
		"себестоимость продукции после мультивыпуска");
	Проверить(ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Данные.P2, НачалоДня(Контекст.Дата)),
		"ручной мультивыпуск требует перезаполнения при смене карты второй продукции");
	// BSLLS:MagicNumber-on

КонецПроцедуры

// Материалы выпуска строкой «M1 2, M2 2» по возрастанию: порядок строк фасад не задаёт. Имена - ключи структуры данных
// сценария.
//
// Параметры:
//  Данные - Структура - номенклатура сценария
//  Выпуск - ДокументОбъект.ВыпускПродукции - выпуск
//
// Возвращаемое значение:
//  Строка - материалы и количества упаковок
//
Функция МатериалыРучногоВыпускаСтрокой(Данные, Выпуск)

	Части = Новый СписокЗначений;
	Для Каждого СтрокаТЧ Из Выпуск.ТЧТовары Цикл
		Имя = Строка(СтрокаТЧ.Номенклатура);
		Для Каждого КлючИЗначение Из Данные Цикл
			Если КлючИЗначение.Значение = СтрокаТЧ.Номенклатура Тогда
				Имя = КлючИЗначение.Ключ;
			КонецЕсли;
		КонецЦикла;
		Части.Добавить(Имя + " " + СтрокаЧисла(СтрокаТЧ.КоличествоУпаковок));
	КонецЦикла;
	Части.СортироватьПоЗначению();
	Возврат СтрСоединить(Части.ВыгрузитьЗначения(), ", ");

КонецФункции

#КонецОбласти

#Область ДлительнаяОперацияВФоне

// ДлительныеОперации.ВыполнитьВФоне запускает фоновое задание и возвращает его результат (2.0.16.109): до правки порт
// БСП звал запуск со сдвинутыми аргументами и задание не стартовало.
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДлительнаяОперацияВФоне()

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	// BSLLS:MagicNumber-off - ожидание задания в секундах.
	ПараметрыВыполнения.ОжидатьЗавершение = 30;
	// BSLLS:MagicNumber-on
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Проба длительной операции";
	Операция = ДлительныеОперации.ВыполнитьВФоне("ДлительныеОперации.ПробаФоновогоЗадания", "проба", ПараметрыВыполнения);
	ПроверитьРавенство("Выполнено", Операция.Статус, "задание выполнено: " + Операция.ПодробноеПредставлениеОшибки);
	Проверить(Операция.ИдентификаторЗадания <> Неопределено, "задание запущено в фоне");
	ПроверитьРавенство("проба", ПолучитьИзВременногоХранилища(Операция.АдресРезультата), "результат задания в хранилище");
	Возврат РезультатСценария("ВыполнитьВФоне запускает фоновое задание, результат - во временном хранилище");

КонецФункции

#КонецОбласти

#Область КонсольОтчетов

// Сценарии служебных механизмов: фоновые операции и консоль отчётов - отдельной веткой, чтобы диспетчер
// СценарийПоИмени не рос.
//
// Параметры:
//  Имя - Строка - имя сценария
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСлужебныхМеханизмов(Имя, Контекст)

	Если Имя = "ДлительнаяОперацияВФоне" Тогда
		Возврат СценарийДлительнаяОперацияВФоне();
	ИначеЕсли Имя = "ПрослеживаемостьПартий" Тогда
		Возврат СценарийПрослеживаемостьПартий(Контекст);
	ИначеЕсли Имя = "ПереработкаПоПереработчикам" Тогда
		Возврат СценарийПереработкаПоПереработчикам(Контекст);
	Иначе
		Возврат СценарийКонсольОтчетов(Контекст);
	КонецЕсли;

КонецФункции

// BSLLS:PrivilegedModuleMethodCall-off - тест хранения избранного своего пользователя ИБ.

// Консоль отчётов в «Главном» (docs/plans/reports-console.md): образ избранного отчёта строится по
// полным настройкам избранного - в снимке есть товар из отбора и нет второго; старый результат не
// затирает новый; удалённое избранное не воскрешается снимком; права на регистр избранного только
// у администратора; ярлык у отчёта со своей формой.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийКонсольОтчетов(Контекст)

	Второй = НоваяНоменклатура(Контекст, "второй товар консоли", Перечисления.ТипыНоменклатуры.Товар);
	// BSLLS:MagicNumber-off - количества и цены прихода
	ПоступлениеБезОрдера(Контекст, Контекст.Склад, Контекст.Товар, 7, 5);
	ПоступлениеБезОрдера(Контекст, Контекст.Склад, Второй, 3, 5);
	// BSLLS:MagicNumber-on

	ПолноеИмяОтчета = "Отчет.ОстаткиНаСкладах";
	Схема = Отчеты.ОстаткиНаСкладах.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", КонецДня(Контекст.Дата) + 1);
	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Номенклатура");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Контекст.Товар;
	Отбор.Использование = Истина;

	Идентификатор = ИзбранныеОтчетыПолныеПрава.Добавить(ПолноеИмяОтчета, "", "Остатки консоли", Настройки);
	Проверить(ПанельОтчетов.СформироватьСнимок(Идентификатор), "снимок записан");
	Запись = ЗаписьИзбранногоОтчета(Идентификатор);
	Проверить(Запись <> Неопределено, "запись избранного есть");
	ПроверитьРавенство("", Запись.ОшибкаСнимка, "снимок без ошибки");
	Проверить(СтрНайти(Запись.Снимок, Строка(Контекст.Товар)) > 0, "в образе товар из отбора");
	Проверить(СтрНайти(Запись.Снимок, Строка(Второй)) = 0, "второго товара в образе нет - отбор полных настроек применён");
	Проверить(СтрНайти(Запись.Снимок, "class=""msg""") = 0, "образ - результат отчёта, а не заглушка");
	// BSLLS:MagicNumber-off - длина шестнадцатеричного SHA-256.
	ПроверитьРавенство(64, СтрДлина(Запись.ОтпечатокПрав), "отпечаток прав записан");
	// BSLLS:MagicNumber-on
	Проверить(Запись.МоментСнимка > 0, "момент снимка записан");

	Проверить(Не ИзбранныеОтчетыПолныеПрава.ЗаписатьСнимок(Идентификатор, "старый", "", 1),
		"результат более раннего формирования не записан");
	ПроверитьРавенство(Запись.Снимок, ЗаписьИзбранногоОтчета(Идентификатор).Снимок, "снимок не затёрт старым");

	ИзбранныеОтчетыПолныеПрава.Удалить(Идентификатор);
	Проверить(Не ПанельОтчетов.СформироватьСнимок(Идентификатор), "снимок удалённого избранного не записан");
	Проверить(ЗаписьИзбранногоОтчета(Идентификатор) = Неопределено, "удалённое избранное не воскрешено");

	Для Каждого Роль Из Метаданные.Роли Цикл
		ПроверитьРавенство(Роль = Метаданные.Роли.Администратор,
			ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ИзбранныеОтчеты, Роль),
			"чтение регистра избранного у роли " + Роль.Имя);
	КонецЦикла;

	Проверить(ПанельОтчетов.ОтчетНаОбщейФорме(ПолноеИмяОтчета), "отчёт на общей форме - с образом");
	Проверить(Не ПанельОтчетов.ОтчетНаОбщейФорме("Отчет.АнализСчета"), "отчёт со своей формой - ярлык");
	Каталог = ПанельОтчетов.КаталогОтчетов();
	Проверить(Каталог.НайтиСтроки(Новый Структура("ПолноеИмяОтчета", ПолноеИмяОтчета)).Количество() > 0,
		"«Остатки на складах» в каталоге «Все отчёты»");

	// Именованный вариант пользователя (2.0.16.127): виден в каталоге с пометкой «свой», образ избранного по ключу варианта.
	// Хранилище вариантов вне транзакции теста - вариант удаляется явно.
	КлючВарианта = "КонсольОтчетовТест" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0");
	Описание = Новый ОписаниеНастроек;
	Описание.Представление = "Вариант консоли";
	ХранилищеВариантовОтчетов.Сохранить(ПолноеИмяОтчета, КлючВарианта, Настройки, Описание);
	Попытка
		ОтборВарианта = Новый Структура("ПолноеИмяОтчета, КлючВарианта", ПолноеИмяОтчета, КлючВарианта);
		Строки = ПанельОтчетов.КаталогОтчетов().НайтиСтроки(ОтборВарианта);
		Проверить(Строки.Количество() > 0 И Строки[0].Свой, "свой вариант в каталоге «Все отчёты»");
		ИдентификаторВарианта = ИзбранныеОтчетыПолныеПрава.Добавить(ПолноеИмяОтчета, КлючВарианта, "Вариант консоли");
		Проверить(ПанельОтчетов.СформироватьСнимок(ИдентификаторВарианта), "снимок своего варианта записан");
		Снимок = ЗаписьИзбранногоОтчета(ИдентификаторВарианта).Снимок;
		Проверить(СтрНайти(Снимок, Строка(Контекст.Товар)) > 0 И СтрНайти(Снимок, Строка(Второй)) = 0,
			"образ своего варианта - по его настройкам");
	Исключение
		ХранилищеВариантовОтчетов.Удалить(ПолноеИмяОтчета, КлючВарианта, ИмяПользователя());
		ВызватьИсключение;
	КонецПопытки;
	ХранилищеВариантовОтчетов.Удалить(ПолноеИмяОтчета, КлючВарианта, ИмяПользователя());

	Возврат РезультатСценария("образ избранного по полным настройкам с отбором, порядок снимков, удаление без воскрешения, "
		+ "права на регистр только у администратора, ярлык отчёта со своей формой, каталог, свой именованный вариант");

КонецФункции

Функция ЗаписьИзбранногоОтчета(Идентификатор)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Избранные.Снимок КАК Снимок,
	|	Избранные.ОшибкаСнимка КАК ОшибкаСнимка,
	|	Избранные.ОтпечатокПрав КАК ОтпечатокПрав,
	|	Избранные.МоментСнимка КАК МоментСнимка
	|ИЗ
	|	РегистрСведений.ИзбранныеОтчеты КАК Избранные
	|ГДЕ
	|	Избранные.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("Снимок, ОшибкаСнимка, ОтпечатокПрав, МоментСнимка");
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Возврат Результат;
КонецФункции

// BSLLS:PrivilegedModuleMethodCall-on

#КонецОбласти

#Область ПрослеживаемостьПартий

// Отчёт «Прослеживаемость партий материала» (docs/plans/lot-traceability.md): две партии сырья с номерами поставщика;
// выпуск ПФ по заказу клиента A берёт первую партию, выпуск по заказу клиента B - её остаток и вторую (смешанный);
// передачи ПФ переработчику, поступление продукции, реализация, возврат и списание продукции. По тексту отчёта: лот,
// воронка каждой партии, пометка смешения по цепочке, возврат с минусом и прочее выбытие, отбор по клиенту без
// «На складе», лот неоформленного приходного ордера.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПрослеживаемостьПартий(Контекст)

	Числа = Контекст.Числа;
	Расход = Числа.РасходСырьяНаЕдиницу;
	Суффикс = Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0");
	ЛотА = "LA" + Суффикс;
	ЛотБ = "LB" + Суффикс;
	// BSLLS:MagicNumber-off - количества сценария: партия на три единицы ПФ, выпуски и передачи по две.
	ПоступлениеСЛотом(Контекст, Контекст.Сырье, Расход * 3, ЛотА);
	ПоступлениеСЛотом(Контекст, Контекст.Сырье, Расход * 3, ЛотБ);
	ЗаказА = ЗаказПроведенияСценария(Контекст, Расход);
	Записать(ЗаказА);
	КлиентБ = НовыйКонтрагент();
	ЗаказБ = ЗаказДругогоКлиента(Контекст, КлиентБ, Расход);
	Выпуск1 = ВыпускПоЗаказу(Контекст, ЗаказА.Ссылка, 2);
	Выпуск2 = ВыпускПоЗаказу(Контекст, ЗаказБ.Ссылка, 2);
	Крашеная = НоваяНоменклатура(Контекст, "крашеная продукция", Перечисления.ТипыНоменклатуры.Продукция);
	Передача1 = ПередачаПФ(Контекст, ЗаказА.Ссылка, 2, Крашеная);
	Передача2 = ПередачаПФ(Контекст, ЗаказБ.Ссылка, 2, Крашеная);
	Поступление = НовыйДокумент(Контекст, "ПоступлениеИзПереработки");
	Поступление.Заполнить(Передача1.Ссылка);
	Поступление.Дата = СледующаяДата(Контекст);
	Поступление.Комментарий = ПометкаТеста();
	Поступление.СтавкаНДСУслуг = Контекст.СтавкаНДС;
	Провести(Поступление);
	Реализация = ДокументРеализации(Контекст, Крашеная, 2, Числа.ЦенаПродажи);
	ВозвратПокупателя = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	ВозвратПокупателя.Заполнить(Реализация);
	ВозвратПокупателя.Дата = СледующаяДата(Контекст);
	ВозвратПокупателя.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	Провести(ВозвратПокупателя);
	Списание = НовыйДокумент(Контекст, "СписаниеТоваров");
	Списание.МестоХранения = Контекст.Склад;
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Перечисления.ХозяйственныеОперации.ПустаяСсылка());
	ДобавитьСтрокуТоваров(Контекст, Списание, "ТЧТовары", Крашеная, 1, Числа.ЦенаПродажи);
	Провести(Списание);

	// Ордерный склад: партия - неоформленный приходный ордер.
	Константы.ИспользоватьОрдерныеСклады.Установить(Истина);
	МатериалОрдера = НоваяНоменклатура(Контекст, "сырьё ордера прослеживаемости", Перечисления.ТипыНоменклатуры.Сырье);
	ПриходныйОрдерНаТовар(Контекст, ОрдерныйСкладСценария(Контекст, '00010101'), МатериалОрдера, 5);
	// BSLLS:MagicNumber-on

	Текст = ТекстОтчетаПартий(Контекст, Неопределено);
	ГруппаА = ГруппаПартииОтчета(Текст, ЛотА);
	ГруппаБ = ГруппаПартииОтчета(Текст, ЛотБ);
	Проверить(Не ПустаяСтрока(ГруппаА) И Не ПустаяСтрока(ГруппаБ), "обе партии сырья - группами с лотом поставщика");
	Для Каждого Номер Из ЗначенияВМассив(Выпуск1.Номер, Передача1.Номер, Реализация.Номер) Цикл
		Проверить(СтрНайти(ГруппаА, Номер) > 0, "в группе партии A документ " + Номер);
	КонецЦикла;
	Проверить(СтрНайти(ГруппаА, Выпуск2.Номер + " ◐") > 0, "выпуск из двух партий помечен смешанным");
	Проверить(СтрНайти(ГруппаА, Передача2.Номер + " ◐") > 0, "передача ПФ смешанного выпуска помечена");
	Проверить(СтрНайти(ГруппаА, ВозвратПокупателя.Номер) > 0 И СтрНайти(ГруппаА, "-2") > 0, "возврат - строкой с минусом");
	Проверить(СтрНайти(ГруппаА, Списание.Номер) > 0, "списание продукции - прочим выбытием");
	Проверить(СтрНайти(ГруппаА, НСтр("ru = 'На складе'")) > 0, "остаток продукции - строкой «На складе»");
	Проверить(СтрНайти(ГруппаБ, Выпуск2.Номер) > 0 И СтрНайти(ГруппаБ, Передача2.Номер) > 0,
		"в группе партии B - её выпуск и передача");
	Проверить(СтрНайти(ГруппаБ, Выпуск1.Номер) = 0 И СтрНайти(ГруппаБ, Реализация.Номер) = 0,
		"в группе партии B нет выпуска и отгрузки только партии A");
	Проверить(СтрНайти(Текст, НСтр("ru = '(не оформлен)'")) > 0, "лот неоформленного приходного ордера");

	ТекстКлиента = ТекстОтчетаПартий(Контекст, КлиентБ);
	ГруппаАКлиента = ГруппаПартииОтчета(ТекстКлиента, ЛотА);
	Проверить(СтрНайти(ГруппаАКлиента, Выпуск2.Номер) > 0 И СтрНайти(ГруппаАКлиента, Выпуск1.Номер) = 0,
		"отбор по клиенту B - только выпуск его заказа");
	Проверить(СтрНайти(ГруппаАКлиента, НСтр("ru = 'На складе'")) = 0, "при отборе по клиенту «На складе» не выводится");

	Возврат РезультатСценария("лот поставщика, воронка двух партий, смешение по цепочке, возврат и прочее выбытие, "
		+ "отбор по клиенту, лот неоформленного ордера");

КонецФункции

Функция ПоступлениеСЛотом(Контекст, Товар, Количество, Лот)
	// BSLLS:MagicNumber-off - цена закупки сырья.
	Поступление = НовоеПоступлениеБезОрдера(Контекст, Контекст.Склад, Товар, Количество, 5);
	// BSLLS:MagicNumber-on
	Поступление.НомерВходящегоДокумента = Лот;
	Поступление.ДатаВходящегоДокумента = Поступление.Дата;
	Провести(Поступление);
	Возврат Поступление.Ссылка;
КонецФункции

Функция ЗаказДругогоКлиента(Контекст, Клиент, Расход)
	Прежний = Новый Структура("Контрагент, ДоговорПокупателя", Контекст.Контрагент, Контекст.ДоговорПокупателя);
	Контекст.Контрагент = Клиент;
	Контекст.ДоговорПокупателя = НовыйДоговор(Контекст, Перечисления.ВидыДоговоров.СПокупателем);
	Попытка
		Заказ = ЗаказПроведенияСценария(Контекст, Расход);
		Записать(Заказ);
	Исключение
		ЗаполнитьЗначенияСвойств(Контекст, Прежний);
		ВызватьИсключение;
	КонецПопытки;
	ЗаполнитьЗначенияСвойств(Контекст, Прежний);
	Возврат Заказ;
КонецФункции

Функция ВыпускПоЗаказу(Контекст, Заказ, Количество)
	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Основание = Заказ;
	Выпуск.Номенклатура = Контекст.Продукция;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = Количество;
	Выпуск.Количество = Количество;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	Документы.ВыпускПродукции.ЗаполнитьМатериалыПоТехкартам(Выпуск, Ложь);
	Провести(Выпуск);
	Возврат Выпуск;
КонецФункции

Функция ПередачаПФ(Контекст, Заказ, Количество, Продукция)
	Передача = НовыйДокумент(Контекст, "ПередачаВПереработку");
	Передача.Контрагент = Контекст.Контрагент;
	Передача.Основание = Заказ;
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Контекст.Продукция, Количество, 0);
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧГотоваяПродукция", Продукция, Количество, 0);
	Провести(Передача);
	Возврат Передача;
КонецФункции

// Текст результата отчёта построчно: ячейки строки через табуляцию.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Клиент - СправочникСсылка.Контрагенты, Неопределено - отбор по клиенту.
//
// Возвращаемое значение:
//  Строка - текст результата.
//
Функция ТекстОтчетаПартий(Контекст, Клиент)
	Отчет = Отчеты.ПрослеживаемостьПартий.Создать();
	Схема = Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Отчет.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	ПараметрыДанных = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных;
	// BSLLS:MagicNumber-off - сутки в секундах: период с запасом на день вокруг дат сценария.
	Период = Новый СтандартныйПериод(НачалоДня(Контекст.Дата) - 86400, КонецДня(СледующаяДата(Контекст)) + 86400);
	// BSLLS:MagicNumber-on
	ПараметрыДанных.УстановитьЗначениеПараметра("Период", Период);
	Если Клиент <> Неопределено Тогда
		ПараметрыДанных.УстановитьЗначениеПараметра("Клиент", Клиент);
	КонецЕсли;
	Результат = Новый ТабличныйДокумент;
	Отчет.СкомпоноватьРезультат(Результат);
	Строки = Новый Массив;
	Для НомерСтроки = 1 По Результат.ВысотаТаблицы Цикл
		Ячейки = Новый Массив;
		Для НомерКолонки = 1 По Результат.ШиринаТаблицы Цикл
			Ячейки.Добавить(Результат.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Ячейки, Символы.Таб));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Строки группы партии: от шапки группы с лотом до шапки следующей группы.
//
// Параметры:
//  Текст - Строка - см. ТекстОтчетаПартий.
//  Лот - Строка - номер поставщика партии.
//
// Возвращаемое значение:
//  Строка - строки группы.
//
Функция ГруппаПартииОтчета(Текст, Лот)
	Строки = СтрРазделить(Текст, Символы.ПС);
	Группа = Новый Массив;
	ВГруппе = Ложь;
	Для Каждого СтрокаТекста Из Строки Цикл
		ШапкаГруппы = СтрНайти(СтрокаТекста, " · ") > 0;
		Если ШапкаГруппы Тогда
			ВГруппе = СтрНайти(СтрокаТекста, Лот) > 0;
		КонецЕсли;
		Если ВГруппе Тогда
			Группа.Добавить(СтрокаТекста);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Группа, Символы.ПС);
КонецФункции

Функция ЗначенияВМассив(Значение1, Значение2, Значение3)
	Результат = Новый Массив;
	Результат.Добавить(Значение1);
	Результат.Добавить(Значение2);
	Результат.Добавить(Значение3);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПереработкаПоПереработчикам

// Отчёт «Переработка по переработчикам» (docs/plans/processing-by-processor.md): переработчик П1 - передачи по заказам
// A (две) и B (одна), поступление, списавшее сырьё A и B (смешанное), второе поступление только по A (хвост без сырья
// проверкой заполнения не проводится - руками, docs/TESTING.md);
// переработчик П2 - передача без заказа с остатком. По тексту результата: группы и их передачи, смешанное поступление
// в A и B с «◐», итог «Принято» П1 считает смешанное один раз, остаток П2 со старейшей
// передачей, отбор по переработчику.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПереработкаПоПереработчикам(Контекст)

	Числа = Контекст.Числа;
	Расход = Числа.РасходСырьяНаЕдиницу;
	// BSLLS:MagicNumber-off - количества сценария: сырьё на десять единиц, передачи по одной-две единицы продукции.
	ДокументЗакупки(Контекст, Контекст.Сырье, Расход * 10, Числа.ЦенаСырья);
	ЗаказА = ЗаказПроведенияСценария(Контекст, Расход);
	Записать(ЗаказА);
	ЗаказБ = ЗаказДругогоКлиента(Контекст, НовыйКонтрагент(), Расход);
	П1 = Контекст.Контрагент;
	ПустойЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();
	ПередачаА1 = ПередачаСырьяСценария(Контекст, П1, ЗаказА.Ссылка, Расход * 2, 2);
	ПередачаБ = ПередачаСырьяСценария(Контекст, П1, ЗаказБ.Ссылка, Расход, 1);
	ПередачаА2 = ПередачаСырьяСценария(Контекст, П1, ЗаказА.Ссылка, Расход, 1);
	П2 = НовыйКонтрагент();
	ПередачаП2 = ПередачаСырьяСценария(Контекст, П2, ПустойЗаказ, Расход, 1);
	Смешанное = ПоступлениеИзПереработкиСценария(Контекст, П1, Неопределено, Расход * 3, 3);
	Второе = ПоступлениеИзПереработкиСценария(Контекст, П1, ПередачаА2, Расход, 1);
	ПринятоП1 = Формат(4, "ЧДЦ=3; ЧН=0");
	ДваждыП1 = Формат(7, "ЧДЦ=3; ЧН=0");
	// BSLLS:MagicNumber-on

	Текст = ТекстОтчетаПереработки(Контекст, Неопределено);
	ГруппаА = ГруппаПартииОтчета(Текст, Строка(ЗаказА.Ссылка));
	ГруппаБ = ГруппаПартииОтчета(Текст, Строка(ЗаказБ.Ссылка));
	ГруппаП2 = ГруппаПартииОтчета(Текст, НСтр("ru = 'Без заказа'"));
	Проверить(СтрНайти(ГруппаА, ПередачаА1.Номер) > 0 И СтрНайти(ГруппаА, ПередачаА2.Номер) > 0, "передачи заказа A - в его группе");
	Проверить(СтрНайти(ГруппаБ, ПередачаБ.Номер) > 0 И СтрНайти(ГруппаБ, ПередачаА1.Номер) = 0, "передача заказа B - в его группе");
	Проверить(СтрНайти(ГруппаА, Смешанное.Номер + " ◐") > 0 И СтрНайти(ГруппаБ, Смешанное.Номер + " ◐") > 0,
		"смешанное поступление - в обеих группах с пометкой");
	Проверить(СтрНайти(ГруппаА, Второе.Номер) > 0 И СтрНайти(ГруппаБ, Второе.Номер) = 0, "второе поступление - только в A");
	Проверить(СтрНайти(Текст, НСтр("ru = 'принято'") + " " + ПринятоП1) > 0, "итог «Принято» П1: смешанное поступление один раз");
	Проверить(СтрНайти(Текст, НСтр("ru = 'принято'") + " " + ДваждыП1) = 0, "итог П1 не повторяет смешанное поступление");
	Проверить(СтрНайти(ГруппаП2, ПередачаП2.Номер) > 0, "остаток П2 - со старейшей передачей");
	Проверить(СтрНайти(ГруппаА, НСтр("ru = 'средний срок'")) > 0, "средний срок в шапке группы A");

	ТекстП2 = ТекстОтчетаПереработки(Контекст, П2);
	Проверить(СтрНайти(ТекстП2, ПередачаП2.Номер) > 0 И СтрНайти(ТекстП2, ПередачаА1.Номер) = 0,
		"отбор по переработчику П2 - только его группа");

	Возврат РезультатСценария("группы переработчик × заказ, смешанное поступление в двух заказах с пометкой и одним "
		+ "итогом переработчика, остаток со старейшей передачей, средний срок, отбор по переработчику");

КонецФункции

Функция ПередачаСырьяСценария(Контекст, Переработчик, Заказ, Сырье, Продукция)
	Передача = НовыйДокумент(Контекст, "ПередачаВПереработку");
	Передача.Контрагент = Переработчик;
	Передача.Основание = Заказ;
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Контекст.Сырье, Сырье, 0);
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧГотоваяПродукция", Контекст.Продукция, Продукция, 0);
	Провести(Передача);
	Возврат Передача;
КонецФункции

Функция ПоступлениеИзПереработкиСценария(Контекст, Переработчик, Основание, Сырье, Продукция)
	Поступление = НовыйДокумент(Контекст, "ПоступлениеИзПереработки");
	Поступление.Контрагент = Переработчик;
	Если Основание <> Неопределено Тогда
		Поступление.Основание = Основание.Ссылка;
	КонецЕсли;
	Поступление.МестоХранения = Контекст.Склад;
	Поступление.Комментарий = ПометкаТеста();
	Поступление.СтавкаНДСУслуг = Контекст.СтавкаНДС;
	ДобавитьСтрокуТоваров(Контекст, Поступление, "ТЧТовары", Контекст.Сырье, Сырье, 0);
	ДобавитьСтрокуТоваров(Контекст, Поступление, "ТЧГотоваяПродукция", Контекст.Продукция, Продукция, 0);
	Провести(Поступление);
	Возврат Поступление;
КонецФункции

// Текст результата отчёта «Переработка по переработчикам» построчно.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Переработчик - СправочникСсылка.Контрагенты, Неопределено - отбор по переработчику.
//
// Возвращаемое значение:
//  Строка - текст результата.
//
Функция ТекстОтчетаПереработки(Контекст, Переработчик)
	Отчет = Отчеты.ПереработкаПоПереработчикам.Создать();
	Схема = Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Отчет.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Отчет.КомпоновщикНастроек.Настройки;
	// BSLLS:MagicNumber-off - сутки в секундах: период с запасом на день вокруг дат сценария.
	Период = Новый СтандартныйПериод(НачалоДня(Контекст.Дата) - 86400, КонецДня(СледующаяДата(Контекст)) + 86400);
	// BSLLS:MagicNumber-on
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Период);
	Если Переработчик <> Неопределено Тогда
		Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Переработчик");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ПравоеЗначение = Переработчик;
		Отбор.Использование = Истина;
	КонецЕсли;
	Результат = Новый ТабличныйДокумент;
	Отчет.СкомпоноватьРезультат(Результат);
	Строки = Новый Массив;
	Для НомерСтроки = 1 По Результат.ВысотаТаблицы Цикл
		Ячейки = Новый Массив;
		Для НомерКолонки = 1 По Результат.ШиринаТаблицы Цикл
			Ячейки.Добавить(Результат.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Ячейки, Символы.Таб));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

#КонецОбласти

#Область АвторВОтветственного

// BSLLS:DeprecatedMethodCall-off - сценарий заполняет устаревший общий реквизит, как в базе до обновления.

// Перенос автора в ответственного (2.0.15.28): обработчик обновления переносит общий реквизит УдалитьАвторОбщий
// в пустой Ответственный записью в режиме загрузки. Проведённый документ остаётся проведённым с теми же движениями,
// непроведённая оплата не перепроводит связанную налоговую накладную, заполненный ответственный не меняется,
// справочник без ответственного сохраняет автора, повторный запуск ничего не пишет.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийАвторВОтветственного(Контекст)

	Автор = ПараметрыСеанса.Пользователь;
	Другой = НовыйПользовательСценария();
	ПустойПользователь = Справочники.Пользователи.ПустаяСсылка();
	Числа = Контекст.Числа;
	ПолеВерсии = "ВерсияДанных";
	ПолеОтветственного = "Ответственный";

	ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	Заказ = ДокументЗаказаПокупателя(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);
	Реализация = ДокументРеализацииПоЗаказу(Контекст, Заказ);
	Накладная = ПроведеннаяНалоговаяНакладная(Контекст, Реализация);
	ВерсияНакладной = ЗначениеРеквизитаЗапросом(Накладная, ПолеВерсии);
	ДвиженияНакладной = СнимокДвиженийДокумента(Накладная);

	УстановитьАвтора(Реализация, Автор, ПустойПользователь);
	ДвиженияРеализации = СнимокДвиженийДокумента(Реализация);
	УстановитьАвтора(Заказ, Автор, Другой);
	Оплата = НовыйДокумент(Контекст, "ПриходныйКассовыйОрдер");
	Оплата.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	Оплата.Контрагент = Контекст.Контрагент;
	Оплата.Договор = Контекст.ДоговорПокупателя;
	Оплата.Сумма = Числа.КоличествоПродажи * Числа.ЦенаПродажи;
	ДобавитьОснование(Оплата, Реализация, Оплата.Сумма);
	Оплата.УдалитьАвторОбщий = Автор;
	Оплата.Ответственный = ПустойПользователь;
	Оплата.ОбменДанными.Загрузка = Истина;
	Оплата.Записать();
	Проверить(ЗначениеРеквизитаЗапросом(Накладная, ПолеВерсии) = ВерсияНакладной,
		"запись непроведённой оплаты в режиме загрузки не перепроводит налоговую накладную");

	Проект = Справочники.ПроектыКонфигураций.СоздатьЭлемент();
	Проект.Наименование = ПометкаТеста() + ": проект конфигурации";
	Проект.УдалитьАвторОбщий = Автор;
	Проект.Записать();
	Валюта = Справочники.Валюты.СоздатьЭлемент();
	Валюта.Наименование = ПометкаТеста() + ": валюта";
	Валюта.УдалитьАвторОбщий = Автор;
	Валюта.ОбменДанными.Загрузка = Истина;
	Валюта.Записать();

	ОбновлениеПрограммыОбработчики.ПеренестиАвтораВОтветственного();

	ПроверитьРавенство(Автор, ЗначениеРеквизитаЗапросом(Реализация, ПолеОтветственного),
		"проведённая реализация получает ответственного");
	Проверить(ЗначениеРеквизитаЗапросом(Реализация, "Проведен"), "реализация остаётся проведённой");
	Проверить(СнимокДвиженийДокумента(Реализация) = ДвиженияРеализации, "движения реализации не меняются");
	ПроверитьРавенство(Другой, ЗначениеРеквизитаЗапросом(Заказ, ПолеОтветственного),
		"заполненный ответственный заказа не меняется");
	ПроверитьРавенство(Автор, ЗначениеРеквизитаЗапросом(Оплата.Ссылка, ПолеОтветственного),
		"непроведённая оплата получает ответственного");
	Проверить(Не ЗначениеРеквизитаЗапросом(Оплата.Ссылка, "Проведен"), "оплата остаётся непроведённой");
	ПроверитьРавенство(ВерсияНакладной, ЗначениеРеквизитаЗапросом(Накладная, ПолеВерсии),
		"налоговая накладная не перепроводится");
	Проверить(СнимокДвиженийДокумента(Накладная) = ДвиженияНакладной, "движения налоговой накладной не меняются");
	ПроверитьРавенство(Автор, ЗначениеРеквизитаЗапросом(Проект.Ссылка, ПолеОтветственного),
		"проект конфигураций получает ответственного");
	ПроверитьРавенство(Автор, ЗначениеРеквизитаЗапросом(Валюта.Ссылка, "УдалитьАвторОбщий"),
		"справочник без ответственного сохраняет автора");

	Записываемые = Новый Массив;
	Записываемые.Добавить(Реализация);
	Записываемые.Добавить(Заказ);
	Записываемые.Добавить(Оплата.Ссылка);
	Записываемые.Добавить(Проект.Ссылка);
	Записываемые.Добавить(Валюта.Ссылка);
	Версии = Новый Соответствие;
	Для Каждого Ссылка Из Записываемые Цикл
		Версии.Вставить(Ссылка, ЗначениеРеквизитаЗапросом(Ссылка, ПолеВерсии));
	КонецЦикла;
	ОбновлениеПрограммыОбработчики.ПеренестиАвтораВОтветственного();
	Для Каждого Ссылка Из Записываемые Цикл
		ПроверитьРавенство(Версии[Ссылка], ЗначениеРеквизитаЗапросом(Ссылка, ПолеВерсии),
			"повторный перенос не пишет " + Ссылка.Метаданные().ПолноеИмя());
	КонецЦикла;

	// Контроль самой проверки: запись объекта меняет версию, иначе проверка повторного переноса ничего не доказывает.
	ПроектОбъект = Проект.Ссылка.ПолучитьОбъект();
	ПроектОбъект.Записать();
	Проверить(ЗначениеРеквизитаЗапросом(Проект.Ссылка, ПолеВерсии) <> Версии[Проект.Ссылка],
		"запись проекта меняет версию данных");

	Возврат РезультатСценария("проведённая реализация и непроведённая оплата получают ответственного, движения "
		+ "и налоговая накладная не меняются, заполненный ответственный и автор справочника без ответственного "
		+ "сохраняются, проект конфигураций, повторный запуск без записи");

КонецФункции

// Устойчивое рабочее место (БПО-лайт, фаза 1, 2.0.16.95, docs/plans/equipment-lite-f1.md): определение места по
// регистру идентификаторов и однозначному коду без создания нового, кандидаты по имени компьютера, отказ привязки
// занятого идентификатора, выбор на сеанс, объединение дублей с переносом оборудования и идентификаторов, отказ
// повторного и встречного объединения и устаревшего списка оборудования, перенос кодов обработчиком обновления.
// Идентификаторы и имена компьютеров уникальны на прогон, поэтому места базы клиента не задеваются.
//
// Параметры:
//  Контекст - Структура - контекст прогона (не используется: сценарий заводит свои рабочие места)
//
// Возвращаемое значение:
//  Строка - строка отчёта, см. РезультатСценария
//
Функция СценарийРабочиеМеста(Контекст)

	Менеджер = Справочники.РабочиеМеста;
	Проверить(Менеджер.ДоступноАдминистрирование(), "прогон выполняется под администратором");
	Метка = ВРег(Строка(Новый УникальныйИдентификатор));
	Компьютер = "ТЕСТ-" + СтрРазделить(Метка, "-")[0];
	Ид = Новый Структура;
	Для Каждого Ключ Из СтрРазделить("Известный,Новый,Однозначный,Двойной,Занятый,Дубля,Сеанса", ",") Цикл
		Ид.Вставить(Ключ, Ключ + "-" + Метка);
	КонецЦикла;
	ПолеМеста = "РабочееМесто";
	ПолеПометки = "ПометкаУдаления";
	СпособВыбор = "Выбор";
	ДваМеста = 2;

	МестоА = НовоеРабочееМестоТеста("А", Компьютер, "");
	МестоБ = НовоеРабочееМестоТеста("Б", Компьютер + "-2", "");
	Проверить(Менеджер.ПривязатьИдентификатор(Ид.Известный, МестоА, Компьютер, СпособВыбор).Успех, "свободный идентификатор привязывается");

	// 1. Известный идентификатор - место из регистра, без диалога.
	Определение = Менеджер.ОпределитьРабочееМесто(Ид.Известный, Компьютер);
	ПроверитьРавенство(МестоА, Определение.РабочееМесто, "известный идентификатор определяет место");
	ПроверитьРавенство("Регистр", Определение.Способ, "место определено по регистру");

	// 2. Новый идентификатор при месте с тем же именем компьютера - кандидат, а не привязка.
	Определение = Менеджер.ОпределитьРабочееМесто(Ид.Новый, Компьютер);
	Проверить(Не ЗначениеЗаполнено(Определение.РабочееМесто), "новый идентификатор молча не привязывается");
	Проверить(Определение.Кандидаты.Количество() > 1 И Определение.Кандидаты[0] = МестоА,
		"место с тем же именем компьютера - первый кандидат");
	Проверить(Не ЗначениеЗаполнено(РабочееМестоИдентификатораТеста(Ид.Новый)), "кандидат не записан в регистр");

	// 3. Код: однозначный - привязка с записью в регистр, неоднозначный - выбор среди совпавших.
	МестоКода = НовоеРабочееМестоТеста("код", Компьютер, Ид.Однозначный);
	Определение = Менеджер.ОпределитьРабочееМесто(Ид.Однозначный, Компьютер);
	ПроверитьРавенство(МестоКода, Определение.РабочееМесто, "однозначный код определяет место");
	ПроверитьРавенство(МестоКода, РабочееМестоИдентификатораТеста(Ид.Однозначный), "однозначный код записан в регистр");
	Двойное1 = НовоеРабочееМестоТеста("двойной 1", Компьютер, Ид.Двойной);
	Двойное2 = НовоеРабочееМестоТеста("двойной 2", Компьютер, Ид.Двойной);
	Определение = Менеджер.ОпределитьРабочееМесто(Ид.Двойной, Компьютер);
	Проверить(Не ЗначениеЗаполнено(Определение.РабочееМесто), "неоднозначный код не выбирает первое место");
	ПроверитьРавенство(ДваМеста, Определение.Кандидаты.Количество(), "кандидаты неоднозначного кода - только совпавшие");
	Проверить(Определение.Кандидаты.Найти(Двойное1) <> Неопределено И Определение.Кандидаты.Найти(Двойное2) <> Неопределено,
		"оба места неоднозначного кода среди кандидатов");

	// 4. Занятый идентификатор не перепривязывается; выбор пользователя - только на сеанс; помеченное место.
	Проверить(Менеджер.ПривязатьИдентификатор(Ид.Занятый, МестоА, Компьютер, СпособВыбор).Успех, "привязка к месту А");
	Привязка = Менеджер.ПривязатьИдентификатор(Ид.Занятый, МестоБ, Компьютер, СпособВыбор);
	Проверить(Не Привязка.Успех, "занятый действующим местом идентификатор не перепривязывается");
	ПроверитьРавенство(МестоА, РабочееМестоИдентификатораТеста(Ид.Занятый), "запись занятого идентификатора не изменилась");
	Выбор = Менеджер.ВыбратьРабочееМесто(Ид.Занятый, МестоБ, Компьютер);
	Проверить(Выбор.Успех И Выбор.ТолькоСеанс, "выбор другого места при занятом идентификаторе - только на сеанс");
	ПроверитьРавенство(МестоА, РабочееМестоИдентификатораТеста(Ид.Занятый), "выбор на сеанс не меняет постоянную привязку");
	МестоП = НовоеРабочееМестоТеста("помеченное", Компьютер, "");
	Проверить(Менеджер.ПривязатьИдентификатор(Ид.Сеанса, МестоП, Компьютер, СпособВыбор).Успех, "привязка к будущему помеченному");
	ПометитьРабочееМестоТеста(МестоП);
	Проверить(Не Менеджер.ПривязатьИдентификатор(Ид.Новый, МестоП, Компьютер, СпособВыбор).Успех,
		"к помеченному месту идентификатор не привязывается");
	Проверить(Не Менеджер.ВыбратьРабочееМесто(Ид.Новый, МестоП, Компьютер).Успех, "помеченное место не выбирается на сеанс");
	Проверить(Не ЗначениеЗаполнено(Менеджер.ОпределитьРабочееМесто(Ид.Сеанса, Компьютер).РабочееМесто),
		"запись на помеченное место не определяет место");
	Проверить(Менеджер.ПривязатьИдентификатор(Ид.Сеанса, МестоБ, Компьютер, СпособВыбор).Успех,
		"запись на помеченное место считается свободной");
	ПроверитьРавенство(МестоБ, РабочееМестоИдентификатораТеста(Ид.Сеанса), "идентификатор перепривязан с помеченного места");

	// 5. Объединение: оборудование и идентификаторы дубля - у основного, совпадающее устройство - на удаление.
	Дубль = НовоеРабочееМестоТеста("дубль", Компьютер, "");
	Проверить(Менеджер.ПривязатьИдентификатор(Ид.Дубля, Дубль, Компьютер, СпособВыбор).Успех, "привязка к дублю");
	СканерОсновного = НовоеУстройствоТеста(МестоА, "сканер основного", "COM1");
	СканерДубля = НовоеУстройствоТеста(Дубль, "сканер дубля", "COM1");
	ВесыДубля = НовоеУстройствоТеста(Дубль, "весы дубля", "COM7");
	Описания = Менеджер.ОборудованиеДляОбъединения(Дубль, МестоА);
	Совпадающие = 0;
	Для Каждого Описание Из Описания Цикл
		Совпадающие = Совпадающие + ?(Описание.Совпадает, 1, 0);
		Если Описание.Ссылка = СканерДубля Тогда
			Проверить(Не Описание.Оставить, "из совпадающей пары по умолчанию не остаётся устройство дубля");
		КонецЕсли;
	КонецЦикла;
	ПроверитьРавенство(ДваМеста, Совпадающие, "совпадение по типу, драйверу и порту отмечено у обоих устройств");

	Оставить = Новый Массив;
	Оставить.Добавить(СканерОсновного);
	Удалить = Новый Массив;
	Удалить.Добавить(СканерДубля);
	Проверить(Не Менеджер.ОбъединитьРабочиеМеста(Дубль, МестоА, Оставить, Удалить).Успех,
		"устаревший список (без весов дубля) - отказ без записи");
	ПроверитьРавенство(Дубль, ЗначениеРеквизитаЗапросом(ВесыДубля, ПолеМеста), "после отказа ничего не перенесено");
	Проверить(Не ЗначениеРеквизитаЗапросом(СканерДубля, ПолеПометки), "после отказа ничего не помечено");

	Оставить.Добавить(ВесыДубля);
	Проверить(Менеджер.ОбъединитьРабочиеМеста(Дубль, МестоА, Оставить, Удалить).Успех, "объединение дубля с основным");
	ПроверитьРавенство(МестоА, ЗначениеРеквизитаЗапросом(ВесыДубля, ПолеМеста), "устройство дубля перенесено");
	Проверить(ЗначениеРеквизитаЗапросом(СканерДубля, ПолеПометки), "лишнее совпадающее устройство помечено на удаление");
	ПроверитьРавенство(МестоА, ЗначениеРеквизитаЗапросом(Дубль, "ОбъединеноВ"), "у дубля ссылка «объединено в»");
	Проверить(ЗначениеРеквизитаЗапросом(Дубль, ПолеПометки), "дубль помечен на удаление");
	ПроверитьРавенство(МестоА, РабочееМестоИдентификатораТеста(Ид.Дубля), "идентификатор дубля перенесён");
	ПроверитьРавенство(МестоА, Менеджер.ОпределитьРабочееМесто(Ид.Дубля, Компьютер).РабочееМесто,
		"компьютер дубля определяется как основное место");
	Пусто = Новый Массив;
	Проверить(Не Менеджер.ОбъединитьРабочиеМеста(Дубль, МестоА, Пусто, Пусто).Успех, "повторное объединение - отказ");
	Проверить(Не Менеджер.ОбъединитьРабочиеМеста(МестоА, Дубль, Пусто, Пусто).Успех, "встречное объединение - отказ");
	Проверить(Не Менеджер.ПеренестиОборудование(МестоА, Дубль, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВесыДубля)).Успех,
		"оборудование на объединённое место не переносится");
	ПроверитьРавенство(МестоА, ЗначениеРеквизитаЗапросом(ВесыДубля, ПолеМеста), "после отказа переноса устройство на месте");
	// Запрет записи устройства на объединённое место (ПодключаемоеОборудование.ПередЗаписью) проверяется через
	// функцию протокола: отказ самой записи внутри транзакции прогона сломал бы транзакцию.
	Проверить(Не ПустаяСтрока(Менеджер.ПроверитьМестоОборудования(Дубль, МестоА, Ложь)),
		"устройство не записывается на объединённое место");
	ПроверитьРавенство("", Менеджер.ПроверитьМестоОборудования(Дубль, МестоА, Истина),
		"пометку удаления устройству на объединённом месте поставить можно");

	// 6. Перенос идентификатора администратором.
	Проверить(Менеджер.ПеренестиИдентификатор(Ид.Занятый, МестоБ).Успех, "перенос идентификатора на другое место");
	ПроверитьРавенство(МестоБ, РабочееМестоИдентификатораТеста(Ид.Занятый), "идентификатор перенесён");

	// 7. Миграция кодов: однозначный записан, двойной - нет, повтор ничего не меняет.
	МестоМиграции = НовоеРабочееМестоТеста("миграция", Компьютер, "МИГРАЦИЯ-" + Метка);
	Итог = Менеджер.ПеренестиКодыВРегистр();
	ПроверитьРавенство(МестоМиграции, РабочееМестоИдентификатораТеста("МИГРАЦИЯ-" + Метка), "однозначный код перенесён");
	Проверить(Не ЗначениеЗаполнено(РабочееМестоИдентификатораТеста(Ид.Двойной)), "код двух мест не перенесён");
	Проверить(Итог.Неоднозначных > 0, "неоднозначный код посчитан");
	Повтор = Менеджер.ПеренестиКодыВРегистр();
	ПроверитьРавенство(0, Повтор.Перенесено, "повторный перенос кодов ничего не пишет");

	Возврат РезультатСценария("место по регистру и однозначному коду, кандидаты по имени компьютера без привязки, "
		+ "неоднозначный код - выбор, занятый идентификатор не перепривязывается, выбор на сеанс, помеченное место, "
		+ "объединение с переносом и пометкой совпадающего, отказ устаревшего списка, повторного и встречного "
		+ "объединения, перенос идентификатора, миграция кодов и её повтор");

КонецФункции

Функция НовоеРабочееМестоТеста(Суффикс, ИмяКомпьютера, Код)

	Место = Справочники.РабочиеМеста.СоздатьЭлемент();
	Место.Наименование = ПометкаТеста() + ": рабочее место " + Суффикс + " " + Новый УникальныйИдентификатор;
	Место.ИмяКомпьютера = ИмяКомпьютера;
	Место.Код = Код;
	Место.Записать();
	Возврат Место.Ссылка;

КонецФункции

Процедура ПометитьРабочееМестоТеста(Место)

	МестоОбъект = Место.ПолучитьОбъект();
	МестоОбъект.ПометкаУдаления = Истина;
	МестоОбъект.Записать();

КонецПроцедуры

Функция НовоеУстройствоТеста(Место, Наименование, Порт)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Драйверы.Ссылка КАК Ссылка ИЗ Справочник.ДрайверыОборудования КАК Драйверы
		|ГДЕ Драйверы.ТипОборудования = ЗНАЧЕНИЕ(Перечисление.ТипыПодключаемогоОборудования.СканерШтрихкода)");
	Выборка = Запрос.Выполнить().Выбрать();
	Устройство = Справочники.ПодключаемоеОборудование.СоздатьЭлемент();
	Устройство.Наименование = ПометкаТеста() + ": " + Наименование;
	Устройство.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.СканерШтрихкода;
	Устройство.ДрайверОборудования = ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.ДрайверыОборудования.ПустаяСсылка());
	Устройство.РабочееМесто = Место;
	Устройство.УстройствоИспользуется = Истина;
	Устройство.Записать();
	// Параметры нового устройства ПередЗаписью обнуляет - порт пишется вторым шагом, как форма настройки.
	Устройство.Параметры = Новый ХранилищеЗначения(Новый Структура("Порт", Порт));
	Устройство.Записать();
	Возврат Устройство.Ссылка;

