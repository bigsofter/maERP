////////////////////////////////////////////////////////////////////////////////
// Серверная часть автотестов уровня 3: жизненный цикл документов.
// Каждый сценарий сам заводит нужные ему данные (контрагент, склад, номенклатура,
// касса, счёт), создаёт, записывает и проводит документы и сверяет движения по
// регистрам. Сценарий выполняется в транзакции, которая всегда откатывается -
// после прогона база не меняется, поэтому его можно гонять и на копии базы клиента.
// Модуль формы обработки только запускает прогон и пишет отчёт.
// Регламент, состав сценариев и разбор ошибок - docs/TESTING.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Имена сценариев прогона в порядке выполнения. Новый документооборот - новый
// сценарий: имя сюда, ветка в СценарийПоИмени, описание в docs/TESTING.md и docs/TESTS.xlsx.
//
// Возвращаемое значение:
//  Массив из Строка - имена сценариев
//
Функция ИменаСценариев() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Закупка");
	Имена.Добавить("Продажа");
	Имена.Добавить("ВозвратОтПокупателя");
	Имена.Добавить("ВыпускПродукции");
	Имена.Добавить("Переработка");
	Имена.Добавить("Зарплата");
	Имена.Добавить("БезналичныеДеньги");
	Имена.Добавить("ДополнительныеРеквизиты");
	Имена.Добавить("Отрасль");
	Имена.Добавить("НастройкиПрограммы");
	Имена.Добавить("ТехнологическиеКарты");
	Имена.Добавить("ПереносТехнологическихКарт");
	Имена.Добавить("СебестоимостьТехкарт");
	Имена.Добавить("ДатыТехкарты");
	Имена.Добавить("ПоказателиТехкарты");
	Имена.Добавить("СпособыПополненияЗапасов");
	Имена.Добавить("КоммерческоеПредложение");
	Возврат Имена;

КонецФункции

// Выполняет все сценарии, каждый в своей транзакции с откатом.
//
// Возвращаемое значение:
//  Структура - итог прогона:
//   * Строки    - Массив из Строка - строки отчёта видов ОК, ОШИБКА, ПРОПУСК
//   * Сценариев - Число           - сколько сценариев выполнялось
//   * Ошибок    - Число           - сколько из них упало
//   * Пропущено - Число           - сколько пропущено (нет условий для проверки)
//
Функция ВыполнитьСценарии() Экспорт

	Итог = Новый Структура;
	Итог.Вставить("Строки", Новый Массив);
	Итог.Вставить("Сценариев", 0);
	Итог.Вставить("Ошибок", 0);
	Итог.Вставить("Пропущено", 0);

	Для Каждого Имя Из ИменаСценариев() Цикл
		ВыполнитьСценарий(Имя, Итог);
	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Прогон

// Один сценарий в транзакции. Откат делается в обеих ветках: сценарий проверяет
// поведение, а не оставляет данные, и после исключения внутри вложенной записи
// транзакция всё равно годится только для отката.
//
// Параметры:
//  Имя  - Строка    - имя сценария из ИменаСценариев
//  Итог - Структура - см. ВыполнитьСценарии
//
Процедура ВыполнитьСценарий(Имя, Итог)

	Итог.Сценариев = Итог.Сценариев + 1;
	// Чужие сообщения в очереди не должны попасть в описание ошибки сценария.
	ПолучитьСообщенияПользователю(Истина);

	// Фиксации нет намеренно: данные сценария живут только внутри его транзакции.
	// BSLLS:PairingBrokenTransaction-off
	// BSLLS:WrongUseOfRollbackTransactionMethod-off
	НачатьТранзакцию();
	Попытка
		Результат = СценарийПоИмени(Имя);
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		// BSLLS:WrongUseOfRollbackTransactionMethod-on
		// BSLLS:PairingBrokenTransaction-on
		Информация = ИнформацияОбОшибке();
		Итог.Строки.Добавить("ОШИБКА;" + Имя + ";" + ОшибкаОднойСтрокой(Информация) + СообщенияПользователю());
		Итог.Ошибок = Итог.Ошибок + 1;
		Возврат;
	КонецПопытки;

	Если Результат.Пропуск Тогда
		Итог.Строки.Добавить("ПРОПУСК;" + Имя + ";" + Результат.Текст);
		Итог.Пропущено = Итог.Пропущено + 1;
	Иначе
		Итог.Строки.Добавить("ОК;" + Имя + ";" + Результат.Текст);
	КонецЕсли;

КонецПроцедуры

// Диспетчер сценариев: имя - ветка. Контекст с данными заводится заново для каждого
// сценария внутри его транзакции.
//
// Параметры:
//  Имя - Строка - имя сценария
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
// BSLLS:CognitiveComplexity-off - линейный диспетчер сценариев, ветви независимы.
Функция СценарийПоИмени(Имя)

	Контекст = НовыйКонтекст();

	Если Имя = "Закупка" Тогда
		Возврат СценарийЗакупка(Контекст);
	КонецЕсли;
	Если Имя = "Продажа" Тогда
		Возврат СценарийПродажа(Контекст);
	КонецЕсли;
	Если Имя = "ВозвратОтПокупателя" Тогда
		Возврат СценарийВозвратОтПокупателя(Контекст);
	КонецЕсли;
	Если Имя = "ВыпускПродукции" Тогда
		Возврат СценарийВыпускПродукции(Контекст);
	КонецЕсли;
	Если Имя = "Переработка" Тогда
		Возврат СценарийПереработка(Контекст);
	КонецЕсли;
	Если Имя = "Зарплата" Тогда
		Возврат СценарийЗарплата(Контекст);
	КонецЕсли;
	Если Имя = "БезналичныеДеньги" Тогда
		Возврат СценарийБезналичныеДеньги(Контекст);
	КонецЕсли;
	Если Имя = "ДополнительныеРеквизиты" Тогда
		Возврат СценарийДополнительныеРеквизиты(Контекст);
	КонецЕсли;
	Если Имя = "Отрасль" Тогда
		Возврат СценарийОтрасль();
	КонецЕсли;
	Если Имя = "НастройкиПрограммы" Тогда
		Возврат СценарийНастройкиПрограммы();
	КонецЕсли;
	Если Имя = "ТехнологическиеКарты" Тогда
		Возврат СценарийТехнологическиеКарты(Контекст);
	КонецЕсли;
	Если Имя = "ПереносТехнологическихКарт" Тогда
		Возврат СценарийПереносТехнологическихКарт(Контекст);
	КонецЕсли;
	Если Имя = "СебестоимостьТехкарт" Тогда
		Возврат СценарийСебестоимостьТехкарт(Контекст);
	КонецЕсли;
	Если Имя = "ДатыТехкарты" Тогда
		Возврат СценарийДатыТехкарты(Контекст);
	КонецЕсли;
	Если Имя = "ПоказателиТехкарты" Тогда
		Возврат СценарийПоказателиТехкарты(Контекст);
	КонецЕсли;
	Если Имя = "СпособыПополненияЗапасов" Тогда
		Возврат СценарийСпособыПополненияЗапасов(Контекст);
	КонецЕсли;
	Если Имя = "КоммерческоеПредложение" Тогда
		Возврат СценарийКоммерческоеПредложение(Контекст);
	КонецЕсли;

	ВызватьИсключение "Сценарий " + Имя + " не описан в СценарийПоИмени";

КонецФункции
// BSLLS:CognitiveComplexity-on

// Результат сценария для отчёта.
//
// Параметры:
//  Текст   - Строка - что проверено (ОК) или почему пропущено (ПРОПУСК)
//  Пропуск - Булево - сценарий пропущен: в базе нет условий для проверки
//
// Возвращаемое значение:
//  Структура - Текст, Пропуск
//
Функция РезультатСценария(Текст, Пропуск = Ложь)

	Возврат Новый Структура("Текст, Пропуск", Текст, Пропуск);

КонецФункции

#КонецОбласти

#Область Сценарии

// Закупка: поступление товара даёт остаток на складе и долг перед поставщиком.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийЗакупка(Контекст)

	Числа = Контекст.Числа;
	Поступление = ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	СуммаЗакупки = Числа.КоличествоЗакупки * Числа.ЦенаЗакупки;

	Остаток = ОстатокТовара(Контекст.Склад, Контекст.Товар);
	ПроверитьРавенство(Числа.КоличествоЗакупки, Остаток.Количество, "остаток товара после закупки");
	ПроверитьРавенство(СуммаЗакупки, Остаток.Сумма, "себестоимость остатка после закупки");
	ПроверитьДолгПоставщику(Поступление, СуммаЗакупки, "долг поставщику по поступлению");

	Текст = "остаток " + СтрокаЧисла(Остаток.Количество) + " на " + СтрокаЧисла(Остаток.Сумма)
		+ "; долг поставщику " + СтрокаЧисла(СуммаЗакупки);
	Возврат РезультатСценария(Текст);

КонецФункции

// Продажа: заказ покупателя, реализация по заказу, оплата в кассу. Проверяются остаток,
// регистр продаж (выручка и себестоимость) и закрытие долга покупателя.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПродажа(Контекст)

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);

	Заказ = ДокументЗаказаПокупателя(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);
	Реализация = ДокументРеализацииПоЗаказу(Контекст, Заказ);
	СуммаПродажи = Числа.КоличествоПродажи * Числа.ЦенаПродажи;
	Себестоимость = Числа.КоличествоПродажи * Числа.ЦенаЗакупки;

	ПроверитьРавенство(Заказ, Реализация.Основание, "основание реализации");
	ПроверитьРавенство(СуммаПродажи, Реализация.Сумма, "сумма реализации");

	Остаток = ОстатокТовара(Контекст.Склад, Контекст.Товар);
	ПроверитьРавенство(Числа.КоличествоЗакупки - Числа.КоличествоПродажи, Остаток.Количество, "остаток товара после продажи");

	Продажи = ОборотыПродаж(Реализация);
	ПроверитьРавенство(Числа.КоличествоПродажи, Продажи.Количество, "количество в регистре продаж");
	ПроверитьРавенство(СуммаПродажи, Продажи.Выручка, "выручка в регистре продаж");
	ПроверитьРавенство(Себестоимость, Продажи.Себестоимость, "себестоимость в регистре продаж");
	ПроверитьДолгПокупателя(Реализация, СуммаПродажи, "долг покупателя по реализации");

	Оплата = ДокументОплатыВКассу(Контекст, Реализация, СуммаПродажи);
	ПроверитьДолгПокупателя(Реализация, 0, "долг покупателя после оплаты");
	ПроверитьРавенство(СуммаПродажи, ОстатокДенег(Контекст.Касса), "деньги в кассе после оплаты");

	Текст = "остаток " + СтрокаЧисла(Остаток.Количество) + "; выручка "
		+ СтрокаЧисла(Продажи.Выручка) + ", себестоимость " + СтрокаЧисла(Продажи.Себестоимость)
		+ "; долг закрыт " + ПредставлениеДокумента(Оплата);
	Возврат РезультатСценария(Текст);

КонецФункции

// Возврат от покупателя по реализации: товар возвращается на склад той же партией,
// продажи сторнируются, долг покупателя гасится.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВозвратОтПокупателя(Контекст)

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	Реализация = ДокументРеализации(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);

	ДокВозврата = НовыйДокумент(Контекст, "ВозвратОтПокупателя");
	ДокВозврата.Заполнить(Реализация);
	ДокВозврата.Дата = СледующаяДата(Контекст);
	ДокВозврата.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	Провести(ДокВозврата);

	КоличествоВозврата = ДокВозврата.ТЧТовары.Итог("Количество");
	ПроверитьРавенство(Числа.КоличествоПродажи, КоличествоВозврата, "количество в возврате по реализации");

	Остаток = ОстатокТовара(Контекст.Склад, Контекст.Товар);
	ПроверитьРавенство(Числа.КоличествоЗакупки, Остаток.Количество, "остаток товара после возврата");
	ПроверитьРавенство(Числа.КоличествоЗакупки * Числа.ЦенаЗакупки, Остаток.Сумма, "себестоимость остатка после возврата");

	Продажи = ОборотыПродаж(Реализация);
	ПроверитьРавенство(0, Продажи.Количество, "количество продаж после возврата");
	ПроверитьРавенство(0, Продажи.Выручка, "выручка после возврата");
	ПроверитьДолгПокупателя(Реализация, 0, "долг покупателя после возврата");

	Текст = "товар вернулся на склад (" + СтрокаЧисла(Остаток.Количество)
		+ "), продажи сторнированы, долг покупателя закрыт";
	Возврат РезультатСценария(Текст);

КонецФункции

// Выпуск продукции по технологической карте: сырьё списывается, продукция приходуется
// по себестоимости сырья. Работает под функциональной опцией «Производство».
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийВыпускПродукции(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Сырье, Числа.КоличествоСырья, Числа.ЦенаСырья);

	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.Номенклатура = Контекст.Продукция;
	Выпуск.Упаковка = Контекст.Единица;
	Выпуск.КоличествоУпаковок = Числа.КоличествоВыпуска;
	Выпуск.Количество = Числа.КоличествоВыпуска;
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ЗаполнитьСырьеПоТехкарте(Контекст, Выпуск, Числа.КоличествоВыпуска);
	Провести(Выпуск);

	РасходСырья = Числа.РасходСырьяНаЕдиницу * Числа.КоличествоВыпуска;
	Себестоимость = РасходСырья * Числа.ЦенаСырья;

	ПроверитьРавенство(1, Выпуск.ТЧГотоваяПродукция.Количество(), "строк готовой продукции в выпуске");
	ОстатокСырья = ОстатокТовара(Контекст.Склад, Контекст.Сырье);
	ПроверитьРавенство(Числа.КоличествоСырья - РасходСырья, ОстатокСырья.Количество, "остаток сырья после выпуска");
	ОстатокПродукции = ОстатокТовара(Контекст.Склад, Контекст.Продукция);
	ПроверитьРавенство(Числа.КоличествоВыпуска, ОстатокПродукции.Количество, "остаток продукции после выпуска");
	ПроверитьРавенство(Себестоимость, ОстатокПродукции.Сумма, "себестоимость продукции после выпуска");

	Текст = "списано сырья " + СтрокаЧисла(РасходСырья) + ", продукции "
		+ СтрокаЧисла(ОстатокПродукции.Количество) + " на " + СтрокаЧисла(ОстатокПродукции.Сумма);
	Возврат РезультатСценария(Текст);

КонецФункции

// Переработка: передача сырья переработчику и поступление продукции. Сырьё уходит со
// склада к переработчику, возвращается продукцией с себестоимостью сырья и услуг,
// стоимость услуг становится долгом перед переработчиком.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПереработка(Контекст)

	Числа = Контекст.Числа;
	ДокументЗакупки(Контекст, Контекст.Сырье, Числа.КоличествоСырья, Числа.ЦенаСырья);
	РасходСырья = Числа.РасходСырьяНаЕдиницу * Числа.КоличествоВыпуска;
	СебестоимостьСырья = РасходСырья * Числа.ЦенаСырья;

	Передача = НовыйДокумент(Контекст, "ПередачаВПереработку");
	Передача.Контрагент = Контекст.Контрагент;
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧТовары", Контекст.Сырье, РасходСырья, 0);
	ДобавитьСтрокуТоваров(Контекст, Передача, "ТЧГотоваяПродукция", Контекст.Продукция, Числа.КоличествоВыпуска, 0);
	Провести(Передача);

	ОстатокСырья = ОстатокТовара(Контекст.Склад, Контекст.Сырье);
	ПроверитьРавенство(Числа.КоличествоСырья - РасходСырья, ОстатокСырья.Количество, "остаток сырья после передачи");
	ВПереработке = ОстатокВПереработке(Контекст.Контрагент, Контекст.Сырье);
	ПроверитьРавенство(РасходСырья, ВПереработке.Количество, "сырьё у переработчика после передачи");
	ПроверитьРавенство(СебестоимостьСырья, ВПереработке.Сумма, "себестоимость сырья у переработчика");

	Поступление = НовыйДокумент(Контекст, "ПоступлениеИзПереработки");
	Поступление.Заполнить(Передача.Ссылка);
	Поступление.Дата = СледующаяДата(Контекст);
	Поступление.Комментарий = ПометкаТеста();
	Поступление.СтоимостьУслуг = Числа.СтоимостьУслугПереработки;
	Поступление.СтавкаНДСУслуг = Контекст.СтавкаНДС;
	Поступление.СуммаНДСУслуг = 0;
	Провести(Поступление);

	ПроверитьРавенство(РасходСырья, Поступление.ТЧТовары.Итог("Количество"), "сырьё в поступлении по передаче");
	ВПереработке = ОстатокВПереработке(Контекст.Контрагент, Контекст.Сырье);
	ПроверитьРавенство(0, ВПереработке.Количество, "сырьё у переработчика после поступления");
	ОстатокПродукции = ОстатокТовара(Контекст.Склад, Контекст.Продукция);
	ПроверитьРавенство(Числа.КоличествоВыпуска, ОстатокПродукции.Количество, "остаток продукции после переработки");
	ПроверитьРавенство(СебестоимостьСырья + Числа.СтоимостьУслугПереработки, ОстатокПродукции.Сумма,
		"себестоимость продукции с услугами переработчика");
	ПроверитьДолгПоставщику(Поступление.Ссылка, Числа.СтоимостьУслугПереработки, "долг переработчику за услуги");

	Текст = "сырьё " + СтрокаЧисла(РасходСырья) + " ушло и вернулось продукцией "
		+ СтрокаЧисла(ОстатокПродукции.Количество) + " на " + СтрокаЧисла(ОстатокПродукции.Сумма)
		+ "; долг переработчику " + СтрокаЧисла(Числа.СтоимостьУслугПереработки);
	Возврат РезультатСценария(Текст);

КонецФункции

// Зарплата: начисление даёт остаток по сотруднику, ведомость на выплату заполняется по
// начислению, расходный ордер по ведомости закрывает остаток и списывает деньги из кассы.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийЗарплата(Контекст)

	ДатаНачала = Константы.ДатаНачалаРасчетаЗарплаты.Получить();
	Если Контекст.Дата < ДатаНачала Тогда
		Текст = "дата начала расчёта зарплаты " + Формат(ДатаНачала, "ДЛФ=D")
			+ " позже даты теста - движений по зарплате не будет";
		Возврат РезультатСценария(Текст, Истина);
	КонецЕсли;

	Оклад = Контекст.Числа.Оклад;
	Начисление = НовыйДокумент(Контекст, "НачислениеЗарплаты");
	Строка = Начисление.ТЧСотрудники.Добавить();
	Строка.Сотрудник = Контекст.Сотрудник;
	Строка.Оклад = Оклад;
	Строка.Сумма = Оклад;
	Начисление.Сумма = Оклад;
	Провести(Начисление);
	ПроверитьРавенство(Оклад, ОстатокЗарплаты(Контекст.Сотрудник), "остаток по сотруднику после начисления");

	Выплата = НовыйДокумент(Контекст, "ВыплатаЗарплаты");
	Выплата.Заполнить(Начисление.Ссылка);
	Выплата.Дата = СледующаяДата(Контекст);
	ПроверитьРавенство(Оклад, Выплата.ТЧСотрудники.Итог("Сумма"), "сумма ведомости по начислению");
	Провести(Выплата);

	Ордер = НовыйДокумент(Контекст, "РасходныйКассовыйОрдер");
	Ордер.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплаты;
	Ордер.Основание = Выплата.Ссылка;
	Ордер.Контрагент = Контекст.Сотрудник;
	Ордер.Касса = Контекст.Касса;
	Ордер.ТипОплаты = Справочники.TypesDePayment.Cash;
	Ордер.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ВыплатаЗарплаты;
	Ордер.Сумма = Оклад;
	Провести(Ордер);

	ПроверитьРавенство(0, ОстатокЗарплаты(Контекст.Сотрудник), "остаток по сотруднику после выплаты");
	ПроверитьРавенство(-Оклад, ОстатокДенег(Контекст.Касса), "деньги в кассе после выплаты");

	Текст = "начислено и выплачено " + СтрокаЧисла(Оклад) + ", остаток по сотруднику 0";
	Возврат РезультатСценария(Текст);

КонецФункции

// Безналичные деньги: поступление от покупателя закрывает долг по реализации, списание
// поставщику закрывает долг по поступлению; остаток на счёте - разница.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийБезналичныеДеньги(Контекст)

	Числа = Контекст.Числа;
	Закупка = ДокументЗакупки(Контекст, Контекст.Товар, Числа.КоличествоЗакупки, Числа.ЦенаЗакупки);
	СуммаЗакупки = Числа.КоличествоЗакупки * Числа.ЦенаЗакупки;
	Реализация = ДокументРеализации(Контекст, Контекст.Товар, Числа.КоличествоПродажи, Числа.ЦенаПродажи);
	СуммаПродажи = Числа.КоличествоПродажи * Числа.ЦенаПродажи;

	Поступление = НовыйДокумент(Контекст, "ПоступлениеБезналичныхДенежныхСредств");
	Поступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	Поступление.Контрагент = Контекст.Контрагент;
	Поступление.Договор = Контекст.ДоговорПокупателя;
	// BSLLS:YoLetterUsage-off
	Поступление.БанковскийСчёт = Контекст.Счет;
	// BSLLS:YoLetterUsage-on
	Поступление.ТипОплаты = Справочники.TypesDePayment.VirementBanquaire;
	Поступление.СтатьяДДС = СтатьяДДС(Контекст, Поступление.ХозяйственнаяОперация);
	Поступление.Сумма = СуммаПродажи;
	ДобавитьОснование(Поступление, Реализация, СуммаПродажи);
	Провести(Поступление);

	ПроверитьДолгПокупателя(Реализация, 0, "долг покупателя после безналичной оплаты");
	ПроверитьРавенство(СуммаПродажи, ОстатокДенег(Контекст.Счет), "деньги на счёте после поступления");

	Списание = НовыйДокумент(Контекст, "СписаниеБезналичныхДенежныхСредств");
	Списание.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	Списание.Контрагент = Контекст.Контрагент;
	Списание.Договор = Контекст.ДоговорПоставщика;
	// BSLLS:YoLetterUsage-off
	Списание.БанковскийСчёт = Контекст.Счет;
	// BSLLS:YoLetterUsage-on
	Списание.ТипОплаты = Справочники.TypesDePayment.VirementBanquaire;
	Списание.СтатьяДДС = СтатьяДДС(Контекст, Списание.ХозяйственнаяОперация);
	Списание.Валюта = Контекст.Валюта;
	Списание.Сумма = СуммаЗакупки;
	Списание.СуммаВВалютеРеглУчета = СуммаЗакупки;
	ДобавитьОснование(Списание, Закупка, СуммаЗакупки);
	Провести(Списание);

	ПроверитьДолгПоставщику(Закупка, 0, "долг поставщику после безналичной оплаты");
	ПроверитьРавенство(СуммаПродажи - СуммаЗакупки, ОстатокДенег(Контекст.Счет), "деньги на счёте после списания");

	Текст = "получено " + СтрокаЧисла(СуммаПродажи) + ", уплачено " + СтрокаЧисла(СуммаЗакупки)
		+ ", оба долга закрыты, на счёте " + СтрокаЧисла(СуммаПродажи - СуммаЗакупки);
	Возврат РезультатСценария(Текст);

КонецФункции

// Дополнительные реквизиты (УправлениеСвойствами): реквизит и сведение заводятся
// идемпотентно, значение реквизита живёт в табличной части объекта, сведения - в регистре,
// оба читаются по имени.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДополнительныеРеквизиты(Контекст)

	ИмяОбъекта = "Справочник.Номенклатура";
	ИмяРеквизита = "ТестУровня3";
	ИмяСведения = "ТестУровня3Сведение";

	Параметры = УправлениеСвойствами.ПараметрыДобавленияСвойства();
	Параметры.ИмяОбъекта = ИмяОбъекта;
	Параметры.Имя = ИмяРеквизита;
	Параметры.Наименование = ПометкаТеста();
	Параметры.ТипЗначения = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(ДлинаСтроковогоРеквизита()));
	Параметры.Заголовки.Вставить("fr", "Test niveau 3");
	Реквизит = УправлениеСвойствами.ДобавитьСвойство(Параметры);
	Проверить(ЗначениеЗаполнено(Реквизит), "дополнительный реквизит не создан");
	Повтор = УправлениеСвойствами.ДобавитьСвойство(Параметры);
	ПроверитьРавенство(Реквизит, Повтор, "повторное добавление реквизита");
	Найденный = УправлениеСвойствами.НайтиСвойство(ИмяОбъекта, ИмяРеквизита);
	ПроверитьРавенство(Реквизит, Найденный, "поиск реквизита по имени");

	Параметры.Имя = ИмяСведения;
	Параметры.ЭтоСведение = Истина;
	Параметры.ТипЗначения = Новый ОписаниеТипов("Число");
	Сведение = УправлениеСвойствами.ДобавитьСвойство(Параметры);
	Проверить(ЗначениеЗаполнено(Сведение) И Сведение <> Реквизит, "дополнительное сведение не создано");

	ЗначениеРеквизита = "Значение уровня 3";
	ЗначениеСведения = Контекст.Числа.ЦенаПродажи;

	Товар = Контекст.Товар.ПолучитьОбъект();
	Строка = Товар.ДополнительныеРеквизиты.Добавить();
	Строка.Свойство = Реквизит;
	Строка.Значение = ЗначениеРеквизита;
	Товар.Записать();

	Запись = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	Запись.Объект = Контекст.Товар;
	Запись.Свойство = Сведение;
	Запись.Значение = ЗначениеСведения;
	Запись.Записать();

	Прочитано = УправлениеСвойствами.ЗначениеСвойства(Контекст.Товар, ИмяРеквизита);
	ПроверитьРавенство(ЗначениеРеквизита, Прочитано, "значение реквизита из табличной части");
	Прочитано = УправлениеСвойствами.ЗначениеСвойства(Контекст.Товар, ИмяСведения);
	ПроверитьРавенство(ЗначениеСведения, Прочитано, "значение сведения из регистра");
	Прочитано = УправлениеСвойствами.ЗначениеСвойства(Контекст.Товар, "НетТакогоРеквизита");
	ПроверитьРавенство(Неопределено, Прочитано, "значение несуществующего реквизита");

	Возврат РезультатСценария("реквизит и сведение заведены идемпотентно, значения читаются по имени");

КонецФункции

// Отрасль: применение «Строительства» ставит константу и заводит реквизиты объекта
// недвижимости у номенклатуры, повтор ничего не создаёт, другая отрасль реквизитов не добавляет.
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийОтрасль()

	ИмяОбъекта = "Справочник.Номенклатура";
	Имена = ИменаРеквизитовСтроительства();

	Было = 0;
	Для Каждого Имя Из Имена Цикл
		Если ЗначениеЗаполнено(УправлениеСвойствами.НайтиСвойство(ИмяОбъекта, Имя)) Тогда
			Было = Было + 1;
		КонецЕсли;
	КонецЦикла;

	// Модуль привилегированный: отрасль ставится от имени администратора при первом запуске,
	// тест проверяет тот же метод в своей транзакции.
	// BSLLS:PrivilegedModuleMethodCall-off
	Строительство = Перечисления.Отрасли.Строительство;
	Создано = НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(Строительство);
	ПроверитьРавенство(Имена.Количество() - Было, Создано, "создано реквизитов строительства");
	Отрасль = Константы.Отрасль.Получить();
	ПроверитьРавенство(Строительство, Отрасль, "константа Отрасль");
	Для Каждого Имя Из Имена Цикл
		Свойство = УправлениеСвойствами.НайтиСвойство(ИмяОбъекта, Имя);
		Проверить(ЗначениеЗаполнено(Свойство), "после применения отрасли нет реквизита " + Имя);
	КонецЦикла;

	Повтор = НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(Строительство);
	ПроверитьРавенство(0, Повтор, "создано реквизитов при повторном применении");

	Торговля = Перечисления.Отрасли.Торговля;
	СозданоДляТорговли = НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(Торговля);
	ПроверитьРавенство(0, СозданоДляТорговли, "создано реквизитов для торговли");
	// BSLLS:PrivilegedModuleMethodCall-on
	Отрасль = Константы.Отрасль.Получить();
	ПроверитьРавенство(Торговля, Отрасль, "константа Отрасль после торговли");

	Текст = "строительство: создано " + СтрокаЧисла(Создано) + " из " + СтрокаЧисла(Имена.Количество())
		+ " реквизитов, повтор 0; торговля: 0";
	Возврат РезультатСценария(Текст);

КонецФункции

// Панель настроек: запись константы модулем менеджера, признак расположения ФО,
// имя константы по пути данных, список часовых поясов, заголовок окна.
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийНастройкиПрограммы()

	Новое = ПометкаТеста();
	ЭтоОпция = Обработки.НастройкиПрограммы.ЗаписатьКонстанту("ЗаголовокСистемы", Новое);
	ПроверитьРавенство(Ложь, ЭтоОпция, "ЗаголовокСистемы как расположение функциональной опции");
	Записано = Константы.ЗаголовокСистемы.Получить();
	ПроверитьРавенство(Новое, Записано, "значение константы после записи");

	ЭтоОпция = Обработки.НастройкиПрограммы.ЭтоРасположениеФункциональнойОпции("Бухгалтерия");
	ПроверитьРавенство(Истина, ЭтоОпция, "Бухгалтерия как расположение функциональной опции");

	ИмяКонстанты = Обработки.НастройкиПрограммы.ИмяКонстантыПоПутиДанных("НаборКонстант.ЗаголовокСистемы");
	ПроверитьРавенство("ЗаголовокСистемы", ИмяКонстанты, "имя константы по пути данных");

	Варианты = Обработки.НастройкиПрограммы.ВариантыЧасовыхПоясов();
	Проверить(Варианты.Количество() > 0, "список часовых поясов пуст");
	Текущий = Обработки.НастройкиПрограммы.ТекущийЧасовойПояс();
	Проверить(Варианты.НайтиПоЗначению(Текущий) <> Неопределено, "текущий часовой пояс " + Текущий + " не в списке");

	Заголовок = Обработки.НастройкиПрограммы.ЗаголовокОкнаПрограммы();
	Проверить(СтрНайти(Заголовок, Новое) > 0, "заголовок окна не содержит заголовок системы");

	Текст = "константа записана и прочитана, признак ФО верен, часовых поясов " + СтрокаЧисла(Варианты.Количество())
		+ ", текущий " + Текущий;
	Возврат РезультатСценария(Текст);

КонецФункции

// Имена дополнительных реквизитов номенклатуры, которые заводит отрасль «Строительство»
// (НачальноеЗаполнениеВызовСервера.ОтраслевыеРеквизитыСтроительства).
//
// Возвращаемое значение:
//  Массив из Строка - имена реквизитов
//
Функция ИменаРеквизитовСтроительства()

	Имена = Новый Массив;
	Имена.Добавить("ОбъектНедвижимости");
	Имена.Добавить("Этаж");
	Имена.Добавить("Площадь");
	Имена.Добавить("НомерПраваСобственности");
	Возврат Имена;

КонецФункции

#КонецОбласти

#Область ТехнологическиеКарты

// Числа здесь - независимые входные данные и ожидаемые результаты сценариев.
// BSLLS:MagicNumber-off

// История рецептуры: удалённые материалы не возвращаются из прежних версий.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийТехнологическиеКарты(Контекст)

	Продукция = НоваяНоменклатура(Контекст, "история карты", Перечисления.ТипыНоменклатуры.Продукция);
	ДатаПервой = Дата(2020, 1, 1);
	ДатаВторой = Дата(2020, 1, 2);
	ДатаОтмены = Дата(2020, 1, 3);
	Состав = СоставКарты(Контекст);
	Строка = Состав.Добавить();
	Строка.Номенклатура = Контекст.Товар;
	Строка.Упаковка = Контекст.Единица;
	Строка.Количество = 3;
	Первая = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ДатаПервой);
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаПервой - 1).Количество(),
		"до первой версии карты нет");
	ПроверитьРавенство(2, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаПервой).Количество(),
		"первая версия содержит оба материала");
	Состав.Сортировать("Номенклатура Убыв");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Первая, Состав), "перестановка строк не меняет состав");

	Состав = СоставКарты(Контекст);
	Состав[0].Количество = 4;
	Вторая = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ДатаВторой);
	Проверить(Первая <> Вторая, "другой день создаёт новую версию");
	ПроверитьРавенство(2, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаВторой - 1).Количество(),
		"до второй версии остаётся прежний состав");
	Актуальный = ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаВторой);
	ПроверитьРавенство(1, Актуальный.Количество(), "удалённый материал не примешивается во вторую версию");
	ПроверитьРавенство(Контекст.Сырье, Актуальный[0].Номенклатура, "оставшийся материал второй версии");
	ПроверитьРавенство(4, Актуальный[0].Количество, "расход второй версии");

	Состав[0].Количество = 6;
	Повторная = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ДатаВторой);
	ПроверитьРавенство(Вторая, Повторная, "правка в тот же день перезаписывает документ");
	ПроверитьРавенство(2, КоличествоДокументовТехкарт(Продукция), "повторная запись не создаёт дубль");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Вторая, Состав), "сохранённый состав не требует записи");

	ПродукцияВыпуска = Новый ТаблицаЗначений;
	ПродукцияВыпуска.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПродукцияВыпуска.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число"));
	Строка = ПродукцияВыпуска.Добавить();
	Строка.Номенклатура = Продукция;
	Строка.КоличествоУпаковок = 2;
	Материалы = ТехнологическиеКарты.ЗаполнитьМатериалыПоТехкартам(ПродукцияВыпуска, ДатаВторой);
	ПроверитьРавенство(1, Материалы.Количество(), "заполнение выпуска не возвращает удалённый материал");
	ПроверитьРавенство(12, Материалы[0].КоличествоУпаковок, "расход на две единицы продукции");
	ОжидаемаяУпаковка = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУпаковку"), Контекст.Единица,
		Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	ПроверитьРавенство(ОжидаемаяУпаковка, Материалы[0].Упаковка, "упаковка подчиняется функциональной опции");

	Набор = Новый Массив;
	Набор.Добавить(Продукция);
	Набор.Добавить(Контекст.Товар);
	Веса = ТехнологическиеКарты.КоэффициентыТехкарт(Набор, ДатаВторой);
	ПроверитьРавенство(1, Веса[Продукция], "при отсутствии одной карты все веса равны единице");
	ПроверитьРавенство(1, Веса[Контекст.Товар], "вес продукции без карты");

	Отмена = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Неопределено, ДатаОтмены);
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкарт(Продукция, ДатаОтмены).Количество(),
		"отмена не возвращает прежнюю рецептуру");
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкартыПоРегистратору(Отмена).Количество(),
		"маркер отмены не попадает в материалы");
	Версия = ТехнологическиеКарты.ТекущиеТехкарты(Продукция, ДатаОтмены).Получить(Продукция);
	ПроверитьРавенство(Отмена, Версия.Версия, "маркер остаётся действующей версией");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Отмена, Неопределено), "пустой состав не требует новой отмены");
	ПроверитьРавенство(0,
		ТехнологическиеКарты.ЗаполнитьМатериалыПоТехкартам(ПродукцияВыпуска, ДатаОтмены).Количество(),
		"отменённая карта не заполняет выпуск");
	ПроверитьРавенство(1, ТехнологическиеКарты.КоэффициентыТехкарт(Продукция, ДатаОтмены).Получить(Продукция),
		"отменённая карта даёт единичный вес");
	ПроверитьРавенство(6, ТехнологическиеКарты.КоэффициентыТехкарт(Продукция, ДатаВторой).Получить(Продукция),
		"отмена не меняет исторический вес");

	Возврат РезультатСценария("границы дат, удаление материала, перезапись дня, заполнение выпуска, веса и отмена карты");

КонецФункции

// Перенос вызывается тем же обработчиком, что при обновлении базы, с общим откатом сценария.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПереносТехнологическихКарт(Контекст)

	ДатаСоздания = НачалоДня(Контекст.Дата) - 86400;
	Старая = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	БезДаты = НоменклатураСоСтаройТехкартой(Контекст, Дата(1, 1, 1));
	Будущая = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	Отмененная = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	Черновик = НоменклатураСоСтаройТехкартой(Контекст, ДатаСоздания);
	Пустая = НоваяНоменклатура(Контекст, "без старой карты", Перечисления.ТипыНоменклатуры.Продукция);
	Состав = СоставКарты(Контекст);
	Состав[0].Количество = 7;
	ДатаБудущей = НачалоДня(Контекст.Дата) + 86400;
	БудущаяВерсия = ТехнологическиеКарты.ЗаписатьТехкарту(Будущая, Состав, ДатаБудущей);
	Отмена = ТехнологическиеКарты.ЗаписатьТехкарту(Отмененная, Неопределено, ДатаСоздания);
	ДокЧерновик = Документы.ТехнологическаяКарта.СоздатьДокумент();
	ДокЧерновик.Заполнить(Черновик);
	ДокЧерновик.Дата = ДатаСоздания;
	ДокЧерновик.ТЧМатериалы.Загрузить(Состав);
	ДокЧерновик.Записать();

	ОбновлениеПрограммыОбработчики.ПеренестиТехнологическиеКарты();
	Версия = ТехнологическиеКарты.ТекущиеТехкарты(Старая, ДатаСоздания).Получить(Старая);
	Проверить(Версия <> Неопределено, "старая карта перенесена на дату создания номенклатуры");
	ПроверитьРавенство(ДатаСоздания, Версия.ДействуетС, "дата перенесённой карты");
	ПеренесенныйСостав = ТехнологическиеКарты.СоставТехкартыПоРегистратору(Версия.Версия);
	ПроверитьРавенство(1, ПеренесенныйСостав.Количество(), "повторяющиеся строки сырья свёрнуты");
	ПроверитьРавенство(Контекст.Сырье, ПеренесенныйСостав[0].Номенклатура, "перенесён материал");
	ПроверитьРавенство(Контекст.Единица, ПеренесенныйСостав[0].Упаковка, "ЕИ перенесена в упаковку");
	ПроверитьРавенство(5, ПеренесенныйСостав[0].Количество, "суммарный расход сохранён");
	Проверить(Не ЗначениеЗаполнено(ПеренесенныйСостав[0].Характеристика), "у старой карты характеристика пустая");
	ПроверитьРавенство(2, Старая.ПолучитьОбъект().ТехнологическаяКарта.Количество(), "исходная карта сохранена");
	ВерсияБезДаты = ТехнологическиеКарты.ТекущиеТехкарты(БезДаты, ДатаСоздания).Получить(БезДаты);
	ПроверитьРавенство(Дата(2000, 1, 1), ВерсияБезДаты.ДействуетС, "запасная дата переноса");

	ОбновлениеПрограммыОбработчики.ПеренестиТехнологическиеКарты();
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Старая), "повтор переноса не создаёт дубликат");
	Повторная = ТехнологическиеКарты.ТекущиеТехкарты(Старая, ДатаСоздания).Получить(Старая);
	ПроверитьРавенство(Версия.Версия, Повторная.Версия, "повтор сохраняет регистратор");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(Версия.Версия, ПеренесенныйСостав), "повтор сохраняет состав");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(БезДаты), "запасная дата не мешает идемпотентности");
	ПроверитьРавенство(0, КоличествоДокументовТехкарт(Пустая), "пустая старая карта не переносится");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Будущая), "будущая карта запрещает перенос старой");
	БудущаяПосле = ТехнологическиеКарты.ТекущиеТехкарты(Будущая, ДатаБудущей).Получить(Будущая);
	ПроверитьРавенство(БудущаяВерсия, БудущаяПосле.Версия, "будущая версия сохранена");
	Проверить(Не ТехнологическиеКарты.СоставОтличается(БудущаяВерсия, Состав), "будущий состав сохранён");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Отмененная), "маркер отмены запрещает перенос");
	ОтменаПосле = ТехнологическиеКарты.ТекущиеТехкарты(Отмененная, ДатаСоздания).Получить(Отмененная);
	ПроверитьРавенство(Отмена, ОтменаПосле.Версия, "отмена сохранена");
	ПроверитьРавенство(0, ТехнологическиеКарты.СоставТехкарт(Отмененная, ДатаСоздания).Количество(),
		"отменённая карта не восстановлена");
	ПроверитьРавенство(1, КоличествоДокументовТехкарт(Черновик), "черновик не заменён переносом");
	Проверить(Не ДокЧерновик.Ссылка.Проведен, "черновик не проведён переносом");
	ПроверитьРавенство(7, ДокЧерновик.Ссылка.ПолучитьОбъект().ТЧМатериалы[0].Количество, "состав черновика сохранён");

	Возврат РезультатСценария("перенос дат и состава, повтор без дублей, сохранение будущих карт, отмен и черновиков");

КонецФункции

// Мультивыпуск по перенесённой карте: будущая рецептура не меняет старую себестоимость.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСебестоимостьТехкарт(Контекст)

	Если Не ПолучитьФункциональнуюОпцию("Производство") Тогда
		Возврат РезультатСценария("функциональная опция «Производство» выключена", Истина);
	КонецЕсли;

	Продукция = НоменклатураСоСтаройТехкартой(Контекст, НачалоДня(Контекст.Дата) - 86400);
	ОбновлениеПрограммыОбработчики.ПеренестиТехнологическиеКарты();
	ДокументЗакупки(Контекст, Контекст.Сырье, 7, 10);
	Выпуск = НовыйДокумент(Контекст, "ВыпускПродукции");
	Выпуск.МестоХраненияОприходование = Контекст.Склад;
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Продукция, 1, 0);
	ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧГотоваяПродукция", Контекст.Продукция, 1, 0);
	Материалы = ТехнологическиеКарты.ЗаполнитьМатериалыПоТехкартам(Выпуск.ТЧГотоваяПродукция.Выгрузить(), Выпуск.Дата);
	ПроверитьРавенство(7, Материалы.Итог("КоличествоУпаковок"), "расход сырья по двум картам после переноса");
	Для Каждого Строка Из Материалы Цикл
		ДобавитьСтрокуТоваров(Контекст, Выпуск, "ТЧТовары", Строка.Номенклатура, Строка.КоличествоУпаковок, 0);
	КонецЦикла;
	Провести(Выпуск);
	ПроверитьРавенство(50, ОстатокТовара(Контекст.Склад, Продукция).Сумма, "себестоимость по перенесённой карте: вес 5");
	ПроверитьРавенство(20, ОстатокТовара(Контекст.Склад, Контекст.Продукция).Сумма, "себестоимость второй продукции: вес 2");
	ПроверитьРавенство(0, ОстатокТовара(Контекст.Склад, Контекст.Сырье).Количество, "сырьё списано полностью");

	НовыйСостав = СоставКарты(Контекст);
	НовыйСостав[0].Количество = 9;
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, НовыйСостав, НачалоДня(Выпуск.Дата) + 86400);
	// Повторное проведение пользователем начинается с перечитанного объекта. Иначе наборы
	// движений первого проведения остаются в памяти теста и складываются с новыми.
	Выпуск = Выпуск.Ссылка.ПолучитьОбъект();
	Провести(Выпуск);
	ПроверитьРавенство(50, ОстатокТовара(Контекст.Склад, Продукция).Сумма, "перепроведение сохраняет старый вес 5");
	ПроверитьРавенство(20, ОстатокТовара(Контекст.Склад, Контекст.Продукция).Сумма, "перепроведение сохраняет долю второй продукции");
	ПроверитьРавенство(1, ОстатокТовара(Контекст.Склад, Продукция).Количество, "перепроведение не удваивает выпуск");

	Проверить(ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Продукция, НачалоДня(Выпуск.Дата)),
		"нужно предупредить о выпуске в день действия карты");
	Проверить(Не ТехнологическиеКарты.ЕстьВыпускиПослеДаты(Продукция, КонецДня(Выпуск.Дата) + 1),
		"более ранний выпуск не требует предупреждения");

	Возврат РезультатСценария("перенос → мультивыпуск: себестоимость 50/20; новая рецептура не меняет старый выпуск");

КонецФункции

// Дата в карточке не может предшествовать последней карте, даже если в тот день есть версия.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийДатыТехкарты(Контекст)

	Продукция = НоваяНоменклатура(Контекст, "выбор даты карты", Перечисления.ТипыНоменклатуры.Продукция);
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Вчера = НачалоДня(Сегодня - 1);
	Завтра = КонецДня(Сегодня) + 1;
	Состав = СоставКарты(Контекст);
	Вчерашняя = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Вчера);
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Сегодня);
	Проверить(Выбор.Допустима, "новая версия может начинаться сегодня");
	Проверить(Не ЗначениеЗаполнено(Выбор.Документ), "сегодняшняя версия ещё не создана");
	Ссылка = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, ТекущаяДатаСеанса());
	ПроверитьРавенство(Сегодня, Ссылка.Дата, "новая карта хранит день без времени");
	Проверить(Вчерашняя <> Ссылка, "новый день создаёт отдельную версию");
	Состав[0].Количество = 4;
	Повторная = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, КонецДня(Сегодня));
	ПроверитьРавенство(Ссылка, Повторная, "сегодня редактируется существующая карта");
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Сегодня);
	ПроверитьРавенство(Ссылка, Выбор.Документ, "по дате подобрана та же карта");
	ДокументКарты = Ссылка.ПолучитьОбъект();
	ДокументКарты.Дата = КонецДня(Сегодня);
	ДокументКарты.Записать(РежимЗаписиДокумента.Проведение);
	Повторная = ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Сегодня);
	ПроверитьРавенство(Ссылка, Повторная, "карта со временем перезаписывается без дубля");
	ПроверитьРавенство(Сегодня, Повторная.Дата, "у существующей карты время также сбрасывается");
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Вчера);
	Проверить(Не Выбор.Допустима, "вчера запрещено, несмотря на существующую вчерашнюю карту");
	ПроверитьРавенство(Завтра, Выбор.Дата, "после ошибки выбирается следующий день после последней версии");
	ЗаписьОтклонена = Ложь;
	Попытка
		ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Вчера);
	Исключение
		ЗаписьОтклонена = Истина;
	КонецПопытки;
	Проверить(ЗаписьОтклонена, "сервер запрещает перезапись старой версии независимо от формы");
	ПроверитьРавенство(2, ТехнологическиеКарты.СоставТехкартыПоРегистратору(Вчерашняя)[0].Количество,
		"отклонённая запись не меняет старый состав");
	ТехнологическиеКарты.ЗаписатьТехкарту(Продукция, Состав, Завтра);
	Выбор = ТехнологическиеКарты.ДатаРедактированияТехкарты(Продукция, Сегодня);
	Проверить(Не Выбор.Допустима, "будущая карта запрещает новую сегодняшнюю");
	ПроверитьРавенство(КонецДня(Завтра) + 1, Выбор.Дата, "исправленная дата не нарушает запрет будущей карты");

	Возврат РезультатСценария("день без времени, редактирование сегодняшней версии, запрет прошлых дат и будущая последняя карта");

КонецФункции

// Реальные поступления и продажи дают последние цены; два одинаковых материала делят остаток.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийПоказателиТехкарты(Контекст)

	ДокументЗакупки(Контекст, Контекст.Сырье, 10, 9);
	ДокументЗакупки(Контекст, Контекст.Сырье, 10, 10);
	ДокументЗакупки(Контекст, Контекст.Товар, 12, 2);
	ДокументЗакупки(Контекст, Контекст.Продукция, 2, 20);
	ДокументРеализации(Контекст, Контекст.Продукция, 1, 90);
	ДокументРеализации(Контекст, Контекст.Продукция, 1, 100);
	Состав = СоставКарты(Контекст);
	Строка = Состав.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Состав[0]);
	Строка.Количество = 3;
	Строка = Состав.Добавить();
	Строка.Номенклатура = Контекст.Товар;
	Строка.Количество = 6;

	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	Проверить(Показатели.ВсеЦеныЕсть, "у всех материалов есть закупочная цена");
	ПроверитьРавенство(10, Показатели.Строки[0].Цена, "последняя цена заменяет прежнюю цену 9");
	ПроверитьРавенство(62, Показатели.Себестоимость, "себестоимость: (2 + 3) * 10 + 6 * 2");
	ПроверитьРавенство(2, Показатели.МожноПроизвести, "ограничивает второй материал: 12 / 6");
	ПроверитьРавенство(100, Показатели.ЦенаПродажи, "взята последняя продажа, а не прайс и не прежняя цена 90");
	ПроверитьРавенство(76, Показатели.ПотенциальнаяМаржа, "маржа всего выпуска: (100 - 62) * 2");
	Состав.Удалить(2);
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(4, Показатели.МожноПроизвести, "дубли материала используют один остаток: 20 / (2 + 3)");
	Состав[0].Количество = 30;
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(0.606, Показатели.МожноПроизвести, "дробный выпуск усекается, а не округляется вверх");
	Проверить(Показатели.ПотенциальнаяМаржа < 0, "отрицательная маржа сохраняется для показа убытка");

	Характеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	Характеристика.Владелец = Контекст.Сырье;
	Характеристика.Наименование = ПометкаТеста() + ": другая характеристика";
	Характеристика.Записать();
	Состав[0].Характеристика = Характеристика.Ссылка;
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(0, Показатели.МожноПроизвести, "остаток другой характеристики не используется");
	Проверить(Не Показатели.ВсеЦеныЕсть, "нет закупочной цены выбранной характеристики");
	ПроверитьРавенство(0, Показатели.Себестоимость, "неполная себестоимость не выдаётся за полную");
	ПроверитьРавенство(0, Показатели.ПотенциальнаяМаржа, "при неполной себестоимости маржа не рассчитывается");
	Состав.Очистить();
	Показатели = ТехнологическиеКарты.ПоказателиТехкарты(Контекст.Продукция, Состав);
	ПроверитьРавенство(0, Показатели.МожноПроизвести, "пустой состав не обещает выпуск");
	ПроверитьРавенство(0, Показатели.Себестоимость, "пустой состав сбрасывает себестоимость");

	Возврат РезультатСценария("последние цены, себестоимость, ограничивающий материал, дубли, дробный выпуск, характеристики и маржа");

КонецФункции

// Способ пополнения: единое правило умолчаний, страховка записи, ручное значение
// "Оба" и идемпотентное заполнение существующей номенклатуры обработчиком обновления.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийСпособыПополненияЗапасов(Контекст)

	Закупка = Перечисления.СпособыПополненияЗапасов.Закупка;
	Производство = Перечисления.СпособыПополненияЗапасов.Производство;
	Оба = Перечисления.СпособыПополненияЗапасов.Оба;

	ПроверитьРавенство(Производство, Справочники.Номенклатура.СпособПополненияПоУмолчанию(
		Перечисления.ТипыНоменклатуры.Продукция), "продукция пополняется производством");
	ПроверитьРавенство(Производство, Справочники.Номенклатура.СпособПополненияПоУмолчанию(
		Перечисления.ТипыНоменклатуры.Полуфабрикат), "полуфабрикат пополняется производством");
	ПроверитьРавенство(Закупка, Справочники.Номенклатура.СпособПополненияПоУмолчанию(
		Перечисления.ТипыНоменклатуры.Товар), "товар пополняется закупкой");
	ПроверитьРавенство(Закупка, Справочники.Номенклатура.СпособПополненияПоУмолчанию(
		Перечисления.ТипыНоменклатуры.Сырье), "сырьё пополняется закупкой");
	ПроверитьРавенство(Закупка, Справочники.Номенклатура.СпособПополненияПоУмолчанию(
		Перечисления.ТипыНоменклатуры.Комплект), "комплект пополняется закупкой");
	ПроверитьРавенство(Закупка, Справочники.Номенклатура.СпособПополненияПоУмолчанию(
		Перечисления.ТипыНоменклатуры.Услуга), "услуга пополняется закупкой");

	Страховка = Справочники.Номенклатура.СоздатьЭлемент();
	Страховка.Наименование = ПометкаТеста() + ": страховка способа пополнения";
	Страховка.НаименованиеПолное = Страховка.Наименование;
	Страховка.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Сырье;
	Страховка.Единица = Контекст.Единица;
	Страховка.СтавкаНДС = Контекст.СтавкаНДС;
	Страховка.СпособПополнения = Перечисления.СпособыПополненияЗапасов.ПустаяСсылка();
	Страховка.Записать();
	ПроверитьРавенство(Закупка, Страховка.Ссылка.СпособПополнения,
		"ПередЗаписью заполняет пустой способ пополнения");

	ЯвныйВыбор = Контекст.Товар.ПолучитьОбъект();
	ЯвныйВыбор.СпособПополнения = Оба;
	ЯвныйВыбор.Записать();
	ПроверитьРавенство(Оба, ЯвныйВыбор.Ссылка.СпособПополнения,
		"явно выбранное значение Оба сохраняется при записи");

	СуществующийЭлемент = НоменклатураБезСпособаПополнения(Контекст);
	СуществующаяГруппа = ГруппаНоменклатурыБезСпособаПополнения();
	Проверить(Не ЗначениеЗаполнено(СуществующийЭлемент.СпособПополнения),
		"режим загрузки сохраняет пустое значение до миграции");

	ОбновлениеПрограммыОбработчики.ЗаполнитьСпособыПополненияЗапасов();
	ПроверитьРавенство(Производство, СуществующийЭлемент.СпособПополнения,
		"миграция заполняет существующую продукцию");
	ПроверитьРавенство(Оба, ЯвныйВыбор.Ссылка.СпособПополнения,
		"миграция не меняет явно выбранное значение Оба");
	Проверить(Не ЗначениеЗаполнено(СуществующаяГруппа.СпособПополнения),
		"миграция не обрабатывает группы номенклатуры");
	ПроверитьРавенство(0, КоличествоЭлементовБезСпособаПополнения(),
		"после миграции не осталось элементов с пустым способом пополнения");

	ОбновлениеПрограммыОбработчики.ЗаполнитьСпособыПополненияЗапасов();
	ПроверитьРавенство(Производство, СуществующийЭлемент.СпособПополнения,
		"повторная миграция сохраняет заполненное значение");
	ПроверитьРавенство(Оба, ЯвныйВыбор.Ссылка.СпособПополнения,
		"повторная миграция сохраняет Оба");
	ПроверитьРавенство(0, КоличествоЭлементовБезСпособаПополнения(),
		"повторная миграция идемпотентна");

	Возврат РезультатСценария("умолчания шести типов, страховка записи, Оба, миграция элементов и повторный запуск");

КонецФункции

// Коммерческое предложение: статусы, описание номенклатуры, печать и ввод заказа
// на основании. Неуспешная проверка заполнения заказа не меняет статус предложения.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура - см. РезультатСценария
//
Функция СценарийКоммерческоеПредложение(Контекст)

	ОписаниеСтроки = ПометкаТеста() + ": описание из коммерческого предложения";
	Предложение = НовоеКоммерческоеПредложение(Контекст, Контекст.Товар, ОписаниеСтроки);
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Черновик,
		Предложение.Статус, "статус нового предложения");
	Записать(Предложение);
	ПроверитьРавенство(ОписаниеСтроки, Предложение.ТЧТовары[0].Номенклатура.Описание,
		"описание строки перенесено в номенклатуру");

	Предложение.Статус = Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	Предложение.Записать();
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Отправлен,
		Предложение.Ссылка.Статус, "выбранный статус сохраняется");

	ПечатнаяФорма = Новый ТабличныйДокумент;
	Документы.РеализацияТоваровУслуг.PrintDevisA4(Предложение.Ссылка, ПечатнаяФорма);
	Проверить(ПечатнаяФорма.ВысотаТаблицы > 0, "печатная форма коммерческого предложения пуста");

	Заказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	Заказ.Заполнить(Предложение.Ссылка);
	Заказ.Дата = СледующаяДата(Контекст);
	Записать(Заказ);
	ПроверитьРавенство(Предложение.Ссылка, Заказ.Основание, "основание заказа");
	ПроверитьРавенство(Предложение.Организация, Заказ.Организация, "организация заказа");
	ПроверитьРавенство(Предложение.Контрагент, Заказ.Контрагент, "контрагент заказа");
	ПроверитьРавенство(Предложение.Договор, Заказ.Договор, "договор заказа");
	ПроверитьРавенство(Предложение.ДатаОтгрузки, Заказ.ДатаОтгрузки, "дата отгрузки заказа");
	ПроверитьРавенство(Предложение.ЦенаВключаетНДС, Заказ.ЦенаВключаетНДС, "режим НДС заказа");
	ПроверитьРавенство(Предложение.Комментарий, Заказ.Комментарий, "комментарий заказа");
	ПроверитьРавенство(Предложение.ТЧТовары.Количество(), Заказ.ТЧТовары.Количество(),
		"количество строк заказа");
	ПроверитьРавенство(Предложение.ТЧТовары[0].Номенклатура, Заказ.ТЧТовары[0].Номенклатура,
		"номенклатура заказа");
	ПроверитьРавенство(Предложение.ТЧТовары[0].Количество, Заказ.ТЧТовары[0].Количество,
		"количество товара в заказе");
	ПроверитьРавенство(Предложение.ТЧТовары[0].Цена, Заказ.ТЧТовары[0].Цена, "цена товара в заказе");
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Выигран,
		Предложение.Ссылка.Статус, "успешный заказ устанавливает статус Выигран");

	ПредложениеСОшибкой = НовоеКоммерческоеПредложение(Контекст, Контекст.Сырье,
		ПометкаТеста() + ": статус при ошибке заказа");
	ПредложениеСОшибкой.Статус = Перечисления.СтатусыКоммерческихПредложений.Отправлен;
	Записать(ПредложениеСОшибкой);
	НезаполненныйЗаказ = НовыйДокумент(Контекст, "ЗаказПокупателя");
	НезаполненныйЗаказ.Заполнить(ПредложениеСОшибкой.Ссылка);
	НезаполненныйЗаказ.Организация = Справочники.Организации.ПустаяСсылка();
	Проверить(Не НезаполненныйЗаказ.ПроверитьЗаполнение(),
		"заказ без организации должен отклоняться проверкой заполнения");
	ПолучитьСообщенияПользователю(Истина);
	ПроверитьРавенство(Перечисления.СтатусыКоммерческихПредложений.Отправлен,
		ПредложениеСОшибкой.Ссылка.Статус, "неуспешное создание заказа не меняет статус предложения");

	Возврат РезультатСценария(
		"черновик и ручной статус, описание, печать, заказ-основание, Выигран и отказ без смены статуса");

КонецФункции

// Новое коммерческое предложение с одной товарной строкой.
//
// Параметры:
//  Контекст      - Структура - см. НовыйКонтекст
//  Номенклатура  - СправочникСсылка.Номенклатура - товар предложения
//  Описание      - Строка - описание товарной строки
//
// Возвращаемое значение:
//  ДокументОбъект.КоммерческоеПредложение - незаписанное предложение
//
Функция НовоеКоммерческоеПредложение(Контекст, Номенклатура, Описание)

	Предложение = Документы.КоммерческоеПредложение.СоздатьДокумент();
	Предложение.Заполнить(Неопределено);
	Предложение.Дата = СледующаяДата(Контекст);
	Предложение.ДатаОтгрузки = Предложение.Дата;
	Предложение.Организация = Контекст.Организация;
	Предложение.Контрагент = Контекст.Контрагент;
	Предложение.Договор = Контекст.ДоговорПокупателя;
	Предложение.ЦенаВключаетНДС = Истина;
	Предложение.Комментарий = ПометкаТеста();
	ДобавитьСтрокуТоваров(Контекст, Предложение, "ТЧТовары", Номенклатура,
		Контекст.Числа.КоличествоПродажи, Контекст.Числа.ЦенаПродажи);
	Предложение.ТЧТовары[0].Описание = Описание;
	Возврат Предложение;

КонецФункции

