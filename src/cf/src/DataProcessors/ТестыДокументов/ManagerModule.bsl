КонецФункции

// Единственный автовыпуск реализации.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация
//  Описание   - Строка - шаг сценария
//
// Возвращаемое значение:
//  ДокументСсылка.ВыпускПродукции - проведённый автовыпуск
//
Функция ЕдинственныйАвтовыпуск(Реализация, Описание)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Выпуски.Ссылка КАК Ссылка,
	|	Выпуски.Проведен КАК Проведен
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|ГДЕ
	|	Выпуски.Основание = &Реализация");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Выпуски = Запрос.Выполнить().Выгрузить();
	ПроверитьРавенство(1, Выпуски.Количество(), Описание + ": автовыпусков у реализации");
	Проверить(Выпуски[0].Проведен, Описание + ": автовыпуск не проведён");
	Возврат Выпуски[0].Ссылка;

КонецФункции

// Выпущено продукции проведённым автовыпуском реализации.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация
//
// Возвращаемое значение:
//  Число - количество готовой продукции
//
Функция ВыпущеноАвтовыпуском(Реализация)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ГотоваяПродукция.Количество), 0) КАК Количество
	|ИЗ
	|	Документ.ВыпускПродукции КАК Выпуски
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ГотоваяПродукция
	|		ПО Выпуски.Ссылка = ГотоваяПродукция.Ссылка
	|ГДЕ
	|	Выпуски.Основание = &Реализация
	|	И Выпуски.Проведен");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Возврат ПерваяСтрока(Запрос, "Количество").Количество;

КонецФункции

// Себестоимость, оприходованная выпуском.
//
// Параметры:
//  Выпуск - ДокументСсылка.ВыпускПродукции - выпуск
//
// Возвращаемое значение:
//  Число - сумма прихода регистра товаров
//
Функция СуммаПриходаВыпуска(Выпуск)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Движения.Сумма), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Выпуск
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
	Запрос.УстановитьПараметр("Выпуск", Выпуск);
	Возврат ПерваяСтрока(Запрос, "Сумма").Сумма;

КонецФункции

// «ИзОстатка» в движениях потребностей документа.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ
//
// Возвращаемое значение:
//  Число - сумма ресурса
//
Функция ИзОстаткаДвижений(Регистратор)

	Набор = РегистрыНакопления.ПотребностиПроизводства.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	Возврат Набор.Выгрузить().Итог("ИзОстатка");

КонецФункции

// Продукция расчёта автовыпуска строкой «P1 6, P2 3» в порядке строк.
//
// Параметры:
//  Данные    - Структура - номенклатура сценария (P1, P2, M1, M2)
//  Продукция - ТаблицаЗначений - см. Производство.ДанныеАвтовыпуска
//
// Возвращаемое значение:
//  Строка - продукция
//
Функция ПродукцияАвтовыпускаСтрокой(Данные, Продукция)

	Имена = ИменаНоменклатурыАвтовыпуска(Данные);
	Части = Новый Массив;
	Для Каждого Строка Из Продукция Цикл
		Части.Добавить(Имена[Строка.Номенклатура] + " " + СтрокаЧисла(Строка.Количество));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Материалы расчёта автовыпуска строкой «M1 12 под заказ, M2 3»: партия поступления сценария - «под заказ».
//
// Параметры:
//  Данные    - Структура - номенклатура и поступление под заказ сценария
//  Материалы - ТаблицаЗначений - см. Производство.ДанныеАвтовыпуска
//
// Возвращаемое значение:
//  Строка - материалы
//
Функция МатериалыАвтовыпускаСтрокой(Данные, Материалы)

	Имена = ИменаНоменклатурыАвтовыпуска(Данные);
	Части = Новый Массив;
	Для Каждого Строка Из Материалы Цикл
		Часть = Имена[Строка.Номенклатура] + " " + СтрокаЧисла(Строка.Количество);
		Если ЗначениеЗаполнено(Строка.Партия) Тогда
			Часть = Часть + ?(Строка.Партия = Данные.Поступление, " под заказ", " партия " + Строка(Строка.Партия));
		КонецЕсли;
		Части.Добавить(Часть);
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

Функция ИменаНоменклатурыАвтовыпуска(Данные)

	Имена = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("M1,M2,P1,P2", ",") Цикл
		Имена.Вставить(Данные[Имя], Имя);
	КонецЦикла;
	Возврат Имена;

КонецФункции

#КонецОбласти

#Область ДанныеСценариев

// Данные, общие для сценариев. Всё, что записывается, заводится заново внутри
// транзакции сценария и откатывается вместе с ней; из базы берутся только организация,
// валюта учёта и предопределённые элементы. Свежая номенклатура и склад дают нулевые
// остатки - ожидаемые значения не зависят от содержимого базы.
//
// Возвращаемое значение:
//  Структура - контекст сценария
//
Функция НовыйКонтекст()

	Контекст = Новый Структура;
	Контекст.Вставить("Числа", ЧислаСценариев());
	// Документы датируются чуть раньше текущего момента и с шагом в секунду: так
	// порядок документов на оси времени регистров совпадает с порядком их создания.
	Контекст.Вставить("Дата", ТекущаяДатаСеанса() - ЗапасСекунд());
	Контекст.Вставить("Шаг", 0);

	Организация = Обработки.ТестовыеДанные.ПервыйЭлемент("Организации");
	Проверить(ЗначениеЗаполнено(Организация), "в базе нет ни одной организации");
	Контекст.Вставить("Организация", Организация);

	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Обработки.ТестовыеДанные.ПервыйЭлемент("Валюты");
	КонецЕсли;
	Проверить(ЗначениеЗаполнено(Валюта), "не задана валюта регламентированного учёта и нет ни одной валюты");
	Контекст.Вставить("Валюта", Валюта);
	Контекст.Вставить("СтавкаНДС", Справочники.СтавкиНДС.SansTVA);

	Контекст.Вставить("Единица", НоваяЕдиница());
	Контекст.Вставить("Склад", НовыйСклад());
	Контекст.Вставить("Контрагент", НовыйКонтрагент());
	Контекст.Вставить("ДоговорПокупателя", НовыйДоговор(Контекст, Перечисления.ВидыДоговоров.СПокупателем));
	Контекст.Вставить("ДоговорПоставщика", НовыйДоговор(Контекст, Перечисления.ВидыДоговоров.СПоставщиком));
	Контекст.Вставить("Касса", НоваяКасса(Контекст));
	Контекст.Вставить("Счет", НовыйБанковскийСчет(Контекст));
	Контекст.Вставить("Сотрудник", НовоеФизическоеЛицо());
	Контекст.Вставить("Товар", НоваяНоменклатура(Контекст, "товар", Перечисления.ТипыНоменклатуры.Товар));
	Контекст.Вставить("Сырье", НоваяНоменклатура(Контекст, "сырьё", Перечисления.ТипыНоменклатуры.Сырье));
	Контекст.Вставить("Продукция", НоваяПродукция(Контекст));
	Контекст.Вставить("СтатьяДДСЗапасная", Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка());

	Возврат Контекст;

КонецФункции

// Количества и цены сценариев в одном месте: ожидаемые значения считаются из них же.
//
// Возвращаемое значение:
//  Структура - количества и цены по именам
//
Функция ЧислаСценариев()

	// BSLLS:MagicNumber-off
	Числа = Новый Структура;
	Числа.Вставить("КоличествоЗакупки", 10);
	Числа.Вставить("ЦенаЗакупки", 50);
	Числа.Вставить("КоличествоПродажи", 3);
	Числа.Вставить("ЦенаПродажи", 100);
	Числа.Вставить("КоличествоСырья", 20);
	Числа.Вставить("ЦенаСырья", 10);
	Числа.Вставить("РасходСырьяНаЕдиницу", 2);
	Числа.Вставить("КоличествоВыпуска", 5);
	Числа.Вставить("СтоимостьУслугПереработки", 50);
	Числа.Вставить("Оклад", 1000);
	// BSLLS:MagicNumber-on
	Возврат Числа;

