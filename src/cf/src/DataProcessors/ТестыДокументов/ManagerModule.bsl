#Область Регистры

// Остаток номенклатуры на складе: количество и себестоимость.
//
// Параметры:
//  Склад        - СправочникСсылка.МестаХранения - склад
//  Номенклатура - СправочникСсылка.Номенклатура - позиция номенклатуры
//
// Возвращаемое значение:
//  Структура - Количество, Сумма
//
Функция ОстатокТовара(Склад, Номенклатура)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии.Остатки(, МестоХранения = &Склад И Номенклатура = &Номенклатура) КАК Остатки");
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат ПерваяСтрока(Запрос, "Количество, Сумма");

КонецФункции

