	Менеджер.ИдентификаторКлиента = ВРег(Идентификатор);
	Менеджер.Прочитать();
	Возврат ?(Менеджер.Выбран(), Менеджер.РабочееМесто, Справочники.РабочиеМеста.ПустаяСсылка());

