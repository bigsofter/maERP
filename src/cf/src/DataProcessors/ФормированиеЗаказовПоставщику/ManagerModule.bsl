#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Данные для расчёта дозаказа по позициям номенклатуры: расход за период, текущие остаток на складах, закреплённые на
// станках материалы, незакрытые заказы клиентов и незакрытые заказы поставщикам (ЗаказыПоставщикам - остатки, без
// соединения с оборотами: иначе строка остатка множилась на число поступлений по заказу).
//
// Параметры:
//  НачалоПериода - Дата - начало периода расхода.
//  КонецПериода  - Дата - конец периода расхода.
//  Номенклатура  - Массив из СправочникСсылка.Номенклатура - позиции, по которым нужны данные.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Расход, Остаток, ЗаказыКлиентов, Заказано, ЗаказаноВнутр:
//   строка на позицию и характеристику.
//
Функция ОстаткиИОборотыТоваров(НачалоПериода, КонецПериода, Номенклатура) Экспорт

	// BSLLS:QueryNestedFieldsByDot-off - запрос перенесён из формы обработки, пометка удаления заказа - через Ссылка.
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	СУММА(ВЗ.Расход) КАК Расход,
	                      |	СУММА(ВЗ.Остаток) КАК Остаток,
	                      |	СУММА(ВЗ.ЗаказыКлиентов) КАК ЗаказыКлиентов,
	                      |	СУММА(ВЗ.Заказано) КАК Заказано,
	                      |	СУММА(ВЗ.ЗаказаноВнутр) КАК ЗаказаноВнутр
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ТоварыВНаличииОбороты.Номенклатура КАК Номенклатура,
	                      |		ТоварыВНаличииОбороты.Характеристика КАК Характеристика,
	                      |		ТоварыВНаличииОбороты.КоличествоРасход КАК Расход,
	                      |		0 КАК Остаток,
	                      |		0 КАК ЗаказыКлиентов,
	                      |		0 КАК Заказано,
	                      |		0 КАК ЗаказаноВнутр
	                      |	ИЗ
	                      |		РегистрНакопления.ТоварыВНаличии.Обороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				Регистратор,
	                      |				Номенклатура В (&Номенклатура)) КАК ТоварыВНаличииОбороты
	                      |	ГДЕ
	                      |		НЕ ТоварыВНаличииОбороты.Регистратор В
	                      |					(ВЫБРАТЬ
	                      |						Основания.Ссылка КАК Ссылка
	                      |					ИЗ
	                      |						Документ.РеализацияТоваровУслуг.Основания КАК Основания
	                      |
	                      |					ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |					ВЫБРАТЬ
	                      |						Основания.Ссылка КАК Ссылка
	                      |					ИЗ
	                      |						Документ.ПоступлениеТоваровУслуг.Основания КАК Основания)
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		ТоварыВНаличииОстатки.Номенклатура,
	                      |		ТоварыВНаличииОстатки.Характеристика,
	                      |		0,
	                      |		ТоварыВНаличииОстатки.КоличествоОстаток,
	                      |		0,
	                      |		0,
	                      |		0
	                      |	ИЗ
	                      |		РегистрНакопления.ТоварыВНаличии.Остатки(, Номенклатура В (&Номенклатура)) КАК ТоварыВНаличииОстатки
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		Закреплено.Номенклатура,
	                      |		Закреплено.Характеристика,
	                      |		0,
	                      |		-Закреплено.КоличествоОстаток,
	                      |		0,
	                      |		0,
	                      |		0
	                      |	ИЗ
	                      |		РегистрНакопления.МатериалыНаСтанках.Остатки(, Номенклатура В (&Номенклатура)) КАК Закреплено
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		ЗаказПокупателяТЧТовары.Номенклатура,
	                      |		ЗаказПокупателяТЧТовары.Характеристика,
	                      |		0,
	                      |		0,
	                      |		ЕСТЬNULL(ЗаказПокупателяТЧТовары.Количество, 0),
	                      |		0,
	                      |		0
	                      |	ИЗ
	                      |		Документ.ЗаказПокупателя.ТЧТовары КАК ЗаказПокупателяТЧТовары
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	                      |			ПО ЗаказПокупателяТЧТовары.Ссылка = РеализацияТоваровУслуг.Основание
	                      |	ГДЕ
	                      |		ЕСТЬNULL(РеализацияТоваровУслуг.Ссылка, ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)
	                      |		И Не ЗаказПокупателяТЧТовары.Ссылка.ПометкаУдаления
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		ЗаказыПоставщикамОстатки.Номенклатура,
	                      |		ЗаказыПоставщикамОстатки.Характеристика,
	                      |		0,
	                      |		0,
	                      |		0,
	                      |		ЗаказыПоставщикамОстатки.КоличествоОстаток,
	                      |		0
	                      |	ИЗ
	                      |		РегистрНакопления.ЗаказыПоставщикам.Остатки(, Номенклатура В (&Номенклатура)) КАК ЗаказыПоставщикамОстатки) КАК ВЗ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВЗ.Номенклатура,
	                      |	ВЗ.Характеристика");
	// BSLLS:QueryNestedFieldsByDot-on
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'; fr = 'Appel d''objet non valide sur le client.';
	|en = 'Invalid object call on the client.'; es = 'Llamada de objeto no válida en el cliente.'");
#КонецЕсли
