// Блок «Обслуживание»: доступ к кластеру и ссылки на инструменты администратора.
// Константы записываются сразу при изменении поля.
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)

	ОбновлятьИнтерфейс = ЗаписатьНастройкуНаСервере(Элемент.Имя);
	Модифицированность = Ложь;
	ОбновитьПовторноИспользуемыеЗначения();
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СсылкаНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму(ФормыСсылок()[Элемент.Имя]);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьНастройкуНаСервере(Знач ИмяЭлемента)

	Возврат Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, ИмяЭлемента);

КонецФункции

// Формы, которые открывают гиперссылки: имя декорации - полное имя формы.
//
// Возвращаемое значение:
//  Соответствие
//
&НаКлиенте
Функция ФормыСсылок()

	Формы = Новый Соответствие;
	Формы.Вставить("СсылкаЗадания", "Обработка.РегламентныеИФоновыеЗадания.Форма.Форма");
	Формы.Вставить("СсылкаExcel", "Обработка.ЗагрузкаИзExcel.Форма.Форма");
	Формы.Вставить("СсылкаГрупповоеИзменение", "Обработка.ГрупповоеИзменениеРеквизитов.Форма.Форма");
	Формы.Вставить("СсылкаГрупповоеСоздание", "Обработка.ГрупповоеСозданиеДокументов.Форма.Форма");
	Формы.Вставить("СсылкаКорректировка", "Документ.КорректировкаРегистров.ФормаСписка");
	Формы.Вставить("СсылкаДвижения", "Отчет.ДвиженияДокумента.Форма.ФормаОтчета");
	Формы.Вставить("СсылкаОбмен", "РегистрСведений.ПараметрыОбменаДанными.Форма.ФормаСписка");
	Формы.Вставить("СсылкаРегистрация", "Обработка.РегистрацияИзмененийДляОбменаДанными.Форма.Форма");
	Формы.Вставить("СсылкаМакеты", "РегистрСведений.ПользовательскиеМакетыПечати.Форма.МакетыПечатныхФорм");
	Возврат Формы;

КонецФункции

#КонецОбласти
