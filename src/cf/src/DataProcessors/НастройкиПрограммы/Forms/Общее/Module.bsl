// Блок настроек «Общее»: заголовок окна, часовой пояс, файлы, почта рассылки.
// Константы записываются сразу при изменении поля (Обработки.НастройкиПрограммы).

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Для Каждого Вариант Из Обработки.НастройкиПрограммы.ВариантыЧасовыхПоясов() Цикл
		Элементы.ЧасовойПояс.СписокВыбора.Добавить(Вариант.Значение, Вариант.Представление);
	КонецЦикла;
	Если ПустаяСтрока(НаборКонстант.ЧасовойПояс) Тогда
		// Константа ещё не задана - показываем пояс, в котором база работает сейчас.
		НаборКонстант.ЧасовойПояс = Обработки.НастройкиПрограммы.ТекущийЧасовойПояс();
	КонецЕсли;
	ОбновитьВремяСеанса();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)

	ОбновлятьИнтерфейс = ЗаписатьНастройкуНаСервере(Элемент.Имя);
	Модифицированность = Ложь;
	ОбновитьПовторноИспользуемыеЗначения();
	Если Элемент.Имя = "ЗаголовокСистемы" Тогда
		КлиентскоеПриложение.УстановитьЗаголовок(ЗаголовокОкнаПрограммы());
	КонецЕсли;
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Процедура КаталогХраненияФайловНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = НСтр("ru = 'Выберите каталог для хранения файлов';
		|fr = 'Choisissez le dossier de stockage des fichiers';
		|en = 'Choose the folder for storing files';
		|es = 'Elija la carpeta para almacenar archivos'");
	Каталоги = Ждать Диалог.ВыбратьАсинх();
	Если Каталоги = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НаборКонстант.КаталогХраненияФайлов = Каталоги[0];
	НастройкаПриИзменении(Элемент);

КонецПроцедуры

&НаКлиенте
Процедура УчетныеЗаписиНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник.УчётныеЗаписиЭлектроннойПочты.ФормаСписка");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрименитьЧасовойПояс(Команда)

	Результат = ПрименитьЧасовойПоясНаСервере();
	Если Результат.Успех Тогда
		Текст = НСтр("ru = 'Часовой пояс базы установлен';
			|fr = 'Fuseau horaire de la base défini';
			|en = 'Database time zone set';
			|es = 'Zona horaria de la base establecida'");
		ПоказатьОповещениеПользователя(Текст, , НаборКонстант.ЧасовойПояс);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.Ошибка, , "ЧасовойПояс");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьНастройкуНаСервере(Знач ИмяЭлемента)

	Возврат Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, ИмяЭлемента);

КонецФункции

&НаСервере
Функция ПрименитьЧасовойПоясНаСервере()

	Результат = Обработки.НастройкиПрограммы.ПрименитьЧасовойПояс(НаборКонстант.ЧасовойПояс);
	Если Результат.Успех Тогда
		ОбновитьВремяСеанса();
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЗаголовокОкнаПрограммы()

	Возврат Обработки.НастройкиПрограммы.ЗаголовокОкнаПрограммы();

КонецФункции

&НаСервере
Процедура ОбновитьВремяСеанса()

	Шаблон = НСтр("ru = 'Время сеанса: %1 (%2)';
		|fr = 'Heure de la session : %1 (%2)';
		|en = 'Session time: %1 (%2)';
		|es = 'Hora de la sesión: %1 (%2)'");
	Элементы.ВремяСеанса.Заголовок = СтрШаблон(Шаблон, Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"),
		Обработки.НастройкиПрограммы.ТекущийЧасовойПояс());

КонецПроцедуры

#КонецОбласти
