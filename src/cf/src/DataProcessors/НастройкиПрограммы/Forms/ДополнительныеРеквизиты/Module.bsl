// Блок «Дополнительные реквизиты»: описание механизма и ссылки на его справочники.
// Констант на форме нет.
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)

	ОбновлятьИнтерфейс = ЗаписатьНастройкуНаСервере(Элемент.Имя);
	Модифицированность = Ложь;
	ОбновитьПовторноИспользуемыеЗначения();
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СсылкаНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму(ФормыСсылок()[Элемент.Имя]);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьНастройкуНаСервере(Знач ИмяЭлемента)

	Возврат Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, ИмяЭлемента);

КонецФункции

// Формы, которые открывают гиперссылки: имя декорации - полное имя формы.
//
// Возвращаемое значение:
//  Соответствие
//
&НаКлиенте
Функция ФормыСсылок()

	Формы = Новый Соответствие;
	Формы.Вставить("СсылкаРеквизиты", "ПланВидовХарактеристик.ДополнительныеРеквизиты.ФормаСписка");
	Формы.Вставить("СсылкаНаборы", "Справочник.НаборыДополнительныхРеквизитов.ФормаСписка");
	Формы.Вставить("СсылкаЗначения", "Справочник.ЗначенияДополнительныхРеквизитов.ФормаСписка");
	Формы.Вставить("СсылкаСведения", "РегистрСведений.ДополнительныеСведения.ФормаСписка");
	Возврат Формы;

КонецФункции

#КонецОбласти
