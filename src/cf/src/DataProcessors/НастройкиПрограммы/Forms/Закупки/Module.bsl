// Блок настроек «Закупки»: импорт, тендеры поставщиков, тип цен в поступлении.
// Константы записываются сразу при изменении поля.
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьДоступностьЗависимых();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)

	ОбновлятьИнтерфейс = ЗаписатьНастройкуНаСервере(Элемент.Имя);
	Модифицированность = Ложь;
	ОбновитьПовторноИспользуемыеЗначения();
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьНастройкуНаСервере(Знач ИмяЭлемента)

	ОбновлятьИнтерфейс = Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, ИмяЭлемента);
	УстановитьДоступностьЗависимых();
	Возврат ОбновлятьИнтерфейс;

КонецФункции

// Предложение поставщика требует заказ покупателя (обязательный реквизит, ввод на основании): тендеры
// доступны, только пока заказ покупателя виден - через заказы покупателей или производство.
//
&НаСервере
Процедура УстановитьДоступностьЗависимых()

	Элементы.ТендерыПоставщиков.Доступность = Константы.ИспользоватьЗаказыПокупателей.Получить()
		Или Константы.ИспользоватьПроизводство.Получить();

КонецПроцедуры

#КонецОбласти
