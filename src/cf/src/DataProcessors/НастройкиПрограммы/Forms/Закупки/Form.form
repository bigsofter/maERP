<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <items xsi:type="form:Decoration">
    <name>ОписаниеРаздела</name>
    <id>1</id>
    <title>
      <key>ru</key>
      <value>Закупки: тендеры поставщиков и тип цен, который показывается в поступлении.</value>
    </title>
    <title>
      <key>fr</key>
      <value>Achats : appels d'offres fournisseurs et type de prix affiché dans la réception.</value>
    </title>
    <title>
      <key>en</key>
      <value>Purchases: supplier tenders and the price type shown in the receipt.</value>
    </title>
    <title>
      <key>es</key>
      <value>Compras: licitaciones de proveedores y tipo de precio mostrado en la recepción.</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>ОписаниеРазделаРасширеннаяПодсказка</name>
      <id>2</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>ОписаниеРазделаКонтекстноеМеню</name>
      <id>3</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <type>Label</type>
    <autoMaxHeight>true</autoMaxHeight>
    <extInfo xsi:type="form:LabelDecorationExtInfo">
      <horizontalAlign>Left</horizontalAlign>
    </extInfo>
  </items>
  <items xsi:type="form:FormGroup">
    <name>ГруппаЗакупки</name>
    <id>4</id>
    <items xsi:type="form:FormField">
      <name>ТендерыПоставщиков</name>
      <id>5</id>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <dataPath xsi:type="form:DataPath">
        <segments>НаборКонстант.ТендерыПоставщиков</segments>
      </dataPath>
      <titleLocation>Right</titleLocation>
      <toolTip>
        <key>ru</key>
        <value>Включает документ «Предложение поставщика»</value>
      </toolTip>
      <toolTip>
        <key>fr</key>
        <value>Active le document « Offre du fournisseur »</value>
      </toolTip>
      <toolTip>
        <key>en</key>
        <value>Enables the "Supplier offer" document</value>
      </toolTip>
      <toolTip>
        <key>es</key>
        <value>Activa el documento «Oferta del proveedor»</value>
      </toolTip>
      <extendedTooltip>
        <name>ТендерыПоставщиковРасширеннаяПодсказка</name>
        <id>6</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <contextMenu>
        <name>ТендерыПоставщиковКонтекстноеМеню</name>
        <id>7</id>
        <autoFill>true</autoFill>
      </contextMenu>
      <type>CheckBoxField</type>
      <editMode>Enter</editMode>
      <showInHeader>true</showInHeader>
      <headerHorizontalAlign>Left</headerHorizontalAlign>
      <showInFooter>true</showInFooter>
      <extInfo xsi:type="form:CheckBoxFieldExtInfo">
        <handlers>
          <event>OnChange</event>
          <name>НастройкаПриИзменении</name>
        </handlers>
        <checkBoxType>Switcher</checkBoxType>
      </extInfo>
    </items>
    <items xsi:type="form:FormField">
      <name>ВыводитьВЗакупкеТипЦен</name>
      <id>8</id>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <dataPath xsi:type="form:DataPath">
        <segments>НаборКонстант.ВыводитьВЗакупкеТипЦен</segments>
      </dataPath>
      <toolTip>
        <key>ru</key>
        <value>Цена этого типа подставляется в колонку «Цена по типу цен» поступления</value>
      </toolTip>
      <toolTip>
        <key>fr</key>
        <value>Le prix de ce type est repris dans la colonne « Prix par type » de la réception</value>
      </toolTip>
      <toolTip>
        <key>en</key>
        <value>The price of this type fills the "Price by price type" column of the receipt</value>
      </toolTip>
      <toolTip>
        <key>es</key>
        <value>El precio de este tipo se pone en la columna «Precio por tipo» de la recepción</value>
      </toolTip>
      <extendedTooltip>
        <name>ВыводитьВЗакупкеТипЦенРасширеннаяПодсказка</name>
        <id>9</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <contextMenu>
        <name>ВыводитьВЗакупкеТипЦенКонтекстноеМеню</name>
        <id>10</id>
        <autoFill>true</autoFill>
      </contextMenu>
      <type>InputField</type>
