<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <items xsi:type="form:Decoration">
    <name>ОписаниеРаздела</name>
    <id>1</id>
    <title>
      <key>ru</key>
      <value>Производство: выпуск продукции по технологическим картам, передача в переработку.</value>
    </title>
    <title>
      <key>fr</key>
      <value>Production : fabrication selon les nomenclatures, sous-traitance.</value>
    </title>
    <title>
      <key>en</key>
      <value>Production: output by bills of materials, subcontracting.</value>
    </title>
    <title>
      <key>es</key>
      <value>Producción: fabricación según listas de materiales, subcontratación.</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>ОписаниеРазделаРасширеннаяПодсказка</name>
      <id>2</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>ОписаниеРазделаКонтекстноеМеню</name>
      <id>3</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <type>Label</type>
    <autoMaxHeight>true</autoMaxHeight>
    <extInfo xsi:type="form:LabelDecorationExtInfo">
      <horizontalAlign>Left</horizontalAlign>
    </extInfo>
  </items>
  <items xsi:type="form:FormGroup">
    <name>ГруппаПроизводство</name>
    <id>4</id>
    <items xsi:type="form:FormField">
      <name>ИспользоватьПроизводство</name>
      <id>5</id>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <dataPath xsi:type="form:DataPath">
        <segments>НаборКонстант.ИспользоватьПроизводство</segments>
      </dataPath>
      <titleLocation>Right</titleLocation>
      <toolTip>
        <key>ru</key>
        <value>Включает раздел «Производство» и типы «Продукция», «Полуфабрикат», «Сырьё» в карточке номенклатуры</value>
      </toolTip>
      <toolTip>
        <key>fr</key>
        <value>Active la section « Production » et les types « Produit fini », « Semi-fini », « Matière première » dans la fiche article</value>
      </toolTip>
      <toolTip>
        <key>en</key>
        <value>Enables the "Production" section and the "Finished product", "Semi-finished", "Raw material" types in the item card</value>
      </toolTip>
      <toolTip>
        <key>es</key>
        <value>Activa la sección «Producción» y los tipos «Producto», «Semielaborado», «Materia prima» en la ficha del artículo</value>
      </toolTip>
      <extendedTooltip>
        <name>ИспользоватьПроизводствоРасширеннаяПодсказка</name>
        <id>6</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <contextMenu>
        <name>ИспользоватьПроизводствоКонтекстноеМеню</name>
        <id>7</id>
        <autoFill>true</autoFill>
      </contextMenu>
      <type>CheckBoxField</type>
      <editMode>Enter</editMode>
      <showInHeader>true</showInHeader>
      <headerHorizontalAlign>Left</headerHorizontalAlign>
      <showInFooter>true</showInFooter>
      <extInfo xsi:type="form:CheckBoxFieldExtInfo">
        <handlers>
          <event>OnChange</event>
          <name>НастройкаПриИзменении</name>
        </handlers>
        <checkBoxType>Switcher</checkBoxType>
      </extInfo>
    </items>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <title>
      <key>ru</key>
      <value>Производство</value>
    </title>
    <title>
      <key>fr</key>
      <value>Production</value>
    </title>
    <title>
      <key>en</key>
      <value>Production</value>
    </title>
    <title>
      <key>es</key>
      <value>Producción</value>
    </title>
    <extendedTooltip>
      <name>ГруппаПроизводствоРасширеннаяПодсказка</name>
      <id>8</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <type>UsualGroup</type>
