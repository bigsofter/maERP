      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <dataPath xsi:type="form:DataPath">
        <segments>НаборКонстант.ИспользоватьПереработку</segments>
      </dataPath>
      <titleLocation>Right</titleLocation>
      <toolTip>
        <key>ru</key>
        <value>Передача в переработку и поступление из переработки; работает при включённом производстве</value>
      </toolTip>
      <toolTip>
        <key>fr</key>
        <value>Transfert et réception de sous-traitance ; fonctionne si la production est activée</value>
      </toolTip>
      <toolTip>
        <key>en</key>
        <value>Transfer to and receipt from subcontracting; works when production is enabled</value>
      </toolTip>
      <toolTip>
        <key>es</key>
        <value>Transferencia y recepción de subcontratación; funciona con la producción activada</value>
      </toolTip>
      <extendedTooltip>
        <name>ИспользоватьПереработкуРасширеннаяПодсказка</name>
        <id>15</id>
