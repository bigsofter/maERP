  <items xsi:type="form:Decoration">
    <name>ОписаниеРаздела</name>
    <id>1</id>
    <title>
      <key>ru</key>
      <value>Производство: выпуск продукции по технологическим картам, передача в переработку.</value>
    </title>
    <title>
      <key>fr</key>
      <value>Production : fabrication selon les nomenclatures, sous-traitance.</value>
    </title>
    <title>
      <key>en</key>
      <value>Production: output by bills of materials, subcontracting.</value>
    </title>
    <title>
      <key>es</key>
      <value>Producción: fabricación según listas de materiales, subcontratación.</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>ОписаниеРазделаРасширеннаяПодсказка</name>
