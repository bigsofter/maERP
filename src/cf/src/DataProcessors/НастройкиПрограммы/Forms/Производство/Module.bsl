// Блок настроек «Производство»: включение раздела и автоматическое создание выпусков при отгрузке.
// Константа записывается сразу при изменении поля.
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьДоступностьАвтовыпуска();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)

	ОбновлятьИнтерфейс = ЗаписатьНастройкуНаСервере(Элемент.Имя);
	Модифицированность = Ложь;
	ОбновитьПовторноИспользуемыеЗначения();
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьНастройкуНаСервере(Знач ИмяЭлемента)

	ОбновлятьИнтерфейс = Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, ИмяЭлемента);
	УстановитьДоступностьАвтовыпуска();
	Возврат ОбновлятьИнтерфейс;

КонецФункции

// Автоматическое создание выпусков при отгрузке (E9) и переработка работают только при включённом
// разделе «Производство».
//
&НаСервере
Процедура УстановитьДоступностьАвтовыпуска()

	Элементы.ИспользоватьАвтовыпускПриОтгрузке.Доступность = НаборКонстант.ИспользоватьПроизводство;
	Элементы.ИспользоватьПереработку.Доступность = НаборКонстант.ИспользоватьПроизводство;

КонецПроцедуры

#КонецОбласти
