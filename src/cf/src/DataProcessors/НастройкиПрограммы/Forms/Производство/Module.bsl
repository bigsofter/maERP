// Блок настроек «Производство»: включение раздела, автоматическое создание выпусков при отгрузке, переработка и
// учёт станков. Константа записывается сразу при изменении поля.
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьДоступностьАвтовыпуска();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)

	ТекстЗапрета = "";
	ОбновлятьИнтерфейс = ЗаписатьНастройкуНаСервере(Элемент.Имя, ТекстЗапрета);
	Модифицированность = Ложь;
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ПоказатьПредупреждение(, ТекстЗапрета);
		Возврат;
	КонецЕсли;
	ОбновитьПовторноИспользуемыеЗначения();
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьНастройкуНаСервере(Знач ИмяЭлемента, ТекстЗапрета)

	// Выключить учёт станков нельзя, пока на станках лежат материалы (проверка - со сборки требований-накладных).
	Если ИмяЭлемента = "ИспользоватьУчетСтанков" И Не НаборКонстант.ИспользоватьУчетСтанков Тогда
		ТекстЗапрета = ЗагрузкаСтанков.ТекстЗапретаВыключенияУчета();
		Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
			НаборКонстант.ИспользоватьУчетСтанков = Истина;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	ОбновлятьИнтерфейс = Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, ИмяЭлемента);
	УстановитьДоступностьАвтовыпуска();
	Возврат ОбновлятьИнтерфейс;

КонецФункции

// Автоматическое создание выпусков при отгрузке (E9), переработка и учёт станков работают только при включённом
// разделе «Производство»; момент списания материалов на станок - только при включённом учёте станков.
//
&НаСервере
Процедура УстановитьДоступностьАвтовыпуска()

	Элементы.ИспользоватьАвтовыпускПриОтгрузке.Доступность = НаборКонстант.ИспользоватьПроизводство;
	Элементы.ИспользоватьПереработку.Доступность = НаборКонстант.ИспользоватьПроизводство;
	Элементы.ИспользоватьУчетСтанков.Доступность = НаборКонстант.ИспользоватьПроизводство;
	Элементы.СписыватьМатериалыНаСтанокПриРазмещении.Доступность = НаборКонстант.ИспользоватьПроизводство
		И НаборКонстант.ИспользоватьУчетСтанков;

КонецПроцедуры

#КонецОбласти
