// Блок настроек «Продажи»: возможности раздела, партии, значения по умолчанию, розница.
// Константы записываются сразу при изменении поля.
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьДоступностьРозницы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)

	ОбновлятьИнтерфейс = ЗаписатьНастройкуНаСервере(Элемент.Имя);
	Модифицированность = Ложь;
	ОбновитьПовторноИспользуемыеЗначения();
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьНастройкуНаСервере(Знач ИмяЭлемента)

	ОбновлятьИнтерфейс = Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, ИмяЭлемента);
	УстановитьДоступностьРозницы();
	Возврат ОбновлятьИнтерфейс;

КонецФункции

// Розничный клиент, договор, печать чека и прочие настройки РМК нужны только при включённой рознице.
//
&НаСервере
Процедура УстановитьДоступностьРозницы()

	Элементы.ГруппаРозница.Доступность = НаборКонстант.ИспользоватьРозничныеПродажи;

КонецПроцедуры

#КонецОбласти
