// Блок настроек «Компания и учёт»: отрасль, валюта учёта, основной склад, закрытие периода,
// календарь, бухгалтерия. Константы записываются сразу при изменении поля.
// Смена отрасли - тот же сценарий, что в визарде первого запуска
// (НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль), после подтверждения пользователем.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьВидимостьКнопкиСвойств(ЭтотОбъект);
	НастроитьДемоДанные();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Асинх Процедура ОтрасльПриИзменении(Элемент)

	Прежняя = ТекущаяОтрасль();
	Если НаборКонстант.Отрасль = Прежняя Тогда
		Возврат;
	КонецЕсли;

	Текст = НСтр("ru = 'Смена отрасли перенастраивает базу, как при первом запуске: заводит отраслевые
		|дополнительные реквизиты номенклатуры и настройки отрасли. Уже заведённые реквизиты
		|и данные не удаляются, автоматически откатить операцию нельзя.
		|
		|Сменить отрасль на «%1»?';
		|fr = 'Changer de secteur reconfigure la base comme au premier lancement : attributs
		|supplémentaires d''articles et paramètres du secteur. Les attributs et données déjà saisis
		|ne sont pas supprimés, l''opération ne peut pas être annulée automatiquement.
		|
		|Passer au secteur « %1 » ?';
		|en = 'Changing the industry reconfigures the database as at first start: industry item
		|attributes and settings are created. Existing attributes and data are not removed,
		|the operation cannot be rolled back automatically.
		|
		|Switch the industry to ""%1""?';
		|es = 'Cambiar el sector reconfigura la base como en el primer inicio: se crean atributos
		|adicionales de artículos y ajustes del sector. Los atributos y datos existentes no se
		|eliminan, la operación no se puede deshacer automáticamente.
		|
		|¿Cambiar el sector a «%1»?'");
	Текст = СтрШаблон(Текст, НаборКонстант.Отрасль);
	Заголовок = НСтр("ru = 'Опасная операция: перенастройка базы';
		|fr = 'Opération risquée : reconfiguration de la base';
		|en = 'Risky operation: database reconfiguration';
		|es = 'Operación peligrosa: reconfiguración de la base'");
	Ответ = Ждать ВопросАсинх(Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, Заголовок);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		НаборКонстант.Отрасль = Прежняя;
		Модифицированность = Ложь;
		Возврат;
	КонецЕсли;

	Создано = ПрименитьОтрасльНаСервере();
	Модифицированность = Ложь;
	ОбновитьВидимостьКнопкиСвойств(ЭтотОбъект);
	ОбновитьПовторноИспользуемыеЗначения();
	ОбновитьИнтерфейс();
	Пояснение = НСтр("ru = 'Заведено реквизитов номенклатуры: %1';
		|fr = 'Attributs d''articles créés : %1';
		|en = 'Item attributes created: %1';
		|es = 'Atributos de artículos creados: %1'");
	Пояснение = СтрШаблон(Пояснение, Создано);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Отрасль изменена'; fr = 'Secteur modifié';
		|en = 'Industry changed'; es = 'Sector cambiado'"), , Пояснение);
	СообщитьПредупреждениеОтрасли();

КонецПроцедуры

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)

	ОбновлятьИнтерфейс = ЗаписатьНастройкуНаСервере(Элемент.Имя);
	Модифицированность = Ложь;
	ОбновитьПовторноИспользуемыеЗначения();
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Повторное применение отрасли: заводит недостающие дополнительные свойства номенклатуры, уже заведённые не дублирует
// (замечание владельца 2026-10-05 - кнопка в настройках, а не только смена отрасли).
//
// Параметры:
//  Команда - КомандаФормы - команда.
//
&НаКлиенте
Процедура СоздатьСвойстваНоменклатуры(Команда)

	Создано = ПрименитьОтрасльНаСервере();
	Пояснение = СтрШаблон(НСтр("ru = 'Заведено реквизитов номенклатуры: %1';
		|fr = 'Attributs d''articles créés : %1';
		|en = 'Item attributes created: %1';
		|es = 'Atributos de artículos creados: %1'"), Создано);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Свойства номенклатуры'; fr = 'Propriétés des articles';
		|en = 'Item properties'; es = 'Propiedades de artículos'"), , Пояснение);
	СообщитьПредупреждениеОтрасли();

КонецПроцедуры

// Кнопка «Заполнить демо-данными»: только администратору и только в демо- или тестовой базе. Подтверждение, затем
// фоновое задание (образец - обработка ПерепроведениеДокументов): форма опрашивает его раз в секунду и показывает итог.
//
// Параметры:
//  Команда - КомандаФормы - команда.
//
&НаКлиенте
Асинх Процедура ЗаполнитьДемоДанные(Команда)

	Если ЗаданиеДемоДанныхИдет() Тогда
		Пояснение = НСтр("ru = 'Заполнение уже выполняется'; fr = 'Le remplissage est en cours';
			|en = 'Filling is already running'; es = 'El llenado ya está en curso'");
		ПоказатьОповещениеПользователя(ЗаголовокДемоДанных(), , Пояснение);
		Возврат;
	КонецЕсли;
	Отказ = ОтказДемоДанныхНаСервере();
	Если Не ПустаяСтрока(Отказ) Тогда
		Ждать ПредупреждениеАсинх(Отказ, , ЗаголовокДемоДанных());
		Возврат;
	КонецЕсли;
	Ответ = Ждать ВопросАсинх(ТекстПодтвержденияДемоДанных(), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет,
		ЗаголовокДемоДанных());
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Ошибка = НачатьЗаполнениеДемоДанныхНаСервере();
	Если Не ПустаяСтрока(Ошибка) Тогда
		Ждать ПредупреждениеАсинх(Ошибка, , ЗаголовокДемоДанных());
		Возврат;
	КонецЕсли;
	Пояснение = НСтр("ru = 'Заполнение запущено, итог появится по окончании';
		|fr = 'Remplissage lancé, le résultat s''affichera à la fin'; en = 'Filling started, the result appears when it ends';
		|es = 'Llenado iniciado, el resultado aparecerá al terminar'");
	ПоказатьОповещениеПользователя(ЗаголовокДемоДанных(), , Пояснение);
	ПодключитьОбработчикОжидания("ПроверитьЗаполнениеДемоДанных", 1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кнопка «Создать свойства номенклатуры» - у отраслей со своими свойствами: строительство и ткани.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма настроек.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьКнопкиСвойств(Форма)

	Отрасль = Форма.НаборКонстант.Отрасль;
	Форма.Элементы.СоздатьСвойстваНоменклатуры.Видимость = Отрасль = ПредопределенноеЗначение("Перечисление.Отрасли.Ткани")
		Или Отрасль = ПредопределенноеЗначение("Перечисление.Отрасли.Строительство");

КонецПроцедуры

&НаКлиенте
Процедура СообщитьПредупреждениеОтрасли()

	Текст = ПредупреждениеОтрасли(НаборКонстант.Отрасль);
	Если Не ПустаяСтрока(Текст) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредупреждениеОтрасли(Знач Отрасль)

	// BSLLS:PrivilegedModuleMethodCall-off - текст предупреждения, без записи данных
	Возврат НачальноеЗаполнениеВызовСервера.ПредупреждениеОтрасли(Отрасль);
	// BSLLS:PrivilegedModuleMethodCall-on

КонецФункции

&НаСервереБезКонтекста
Функция ТекущаяОтрасль()

	Возврат Константы.Отрасль.Получить();

КонецФункции

&НаСервере
Функция ПрименитьОтрасльНаСервере()

	// Модуль привилегированный: тот же сценарий, что ставит отрасль в визарде первого запуска;
	// команда доступна из настроек только администратору.
	// BSLLS:PrivilegedModuleMethodCall-off
	Возврат НачальноеЗаполнениеВызовСервера.ПрименитьОтрасль(НаборКонстант.Отрасль);
	// BSLLS:PrivilegedModuleMethodCall-on

КонецФункции

&НаСервере
Функция ЗаписатьНастройкуНаСервере(Знач ИмяЭлемента)

	Возврат Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, ИмяЭлемента);

КонецФункции

// Группа «Демо-данные» - только администратору. Состав набора задают включённые функциональные опции, флажков нет.
//
&НаСервере
Процедура НастроитьДемоДанные()

	Элементы.ГруппаДемоДанные.Видимость = ПравоДоступа("Администрирование", Метаданные);

КонецПроцедуры

// Опрос фонового задания заполнения; по окончании - итог.
//
&НаКлиенте
Процедура ПроверитьЗаполнениеДемоДанных() Экспорт

	Состояние = СостояниеЗаполненияДемоДанных(ДемоЗадание, ДемоАдресРезультата);
	Если Состояние.Активно Тогда
		Возврат;
	КонецЕсли;
	ОтключитьОбработчикОжидания("ПроверитьЗаполнениеДемоДанных");
	ДемоЗадание = ПустойИдентификаторЗадания();
	Если Не ПустаяСтрока(Состояние.Ошибка) Тогда
		ПоказатьПредупреждение(, Состояние.Ошибка, , ЗаголовокДемоДанных());
		Возврат;
	КонецЕсли;
	ПоказатьИтогДемоДанных(Состояние.Итог);

КонецПроцедуры

// Итог заполнения: оповещение со счётчиками и сообщения по строкам отчёта набора.
//
// Параметры:
//  Итог - Структура - см. Обработки.ТестовыеДанные.СоздатьДемоНабор
//
&НаКлиенте
Процедура ПоказатьИтогДемоДанных(Итог)

	Шаблон = НСтр("ru = 'Создано: %1, переиспользовано: %2, неполных: %3, пропущено: %4, ошибок: %5';
		|fr = 'Créés : %1, réutilisés : %2, incomplets : %3, ignorés : %4, erreurs : %5';
		|en = 'Created: %1, reused: %2, incomplete: %3, skipped: %4, errors: %5';
		|es = 'Creados: %1, reutilizados: %2, incompletos: %3, omitidos: %4, errores: %5'");
	Пояснение = СтрШаблон(Шаблон, Итог.Создано, Итог.Переиспользовано, Итог.Неполных, Итог.Пропущено, Итог.Ошибок);
	ПоказатьОповещениеПользователя(ЗаголовокДемоДанных(), , Пояснение);
	ОпцииВключены = Ложь;
	Для Каждого СтрокаОтчета Из Итог.Строки Цикл
		Части = СтрРазделить(СтрокаОтчета, ";");
		Если Части[0] = "ССЫЛКА" Тогда
			Продолжить;
		КонецЕсли;
		ОпцииВключены = ОпцииВключены Или Части[0] = "НАСТРОЙКА";
		Вид = Части[0];
		Части.Удалить(0);
		Если Вид = "НАСТРОЙКА" Тогда
			Части = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПредставлениеОпцииДемо(Части[0]));
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПредставлениеВидаСтрокиДемо(Вид) + ": " + СтрСоединить(Части, " - "));
	КонецЦикла;
	Если ОпцииВключены Тогда
		ОбновитьПовторноИспользуемыеЗначения();
		ОбновитьИнтерфейс();
	КонецЕсли;
	ОбновитьДемоДанныеНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДемоДанныеНаСервере()

	НастроитьДемоДанные();

КонецПроцедуры

// Включённая набором функциональная опция словами на языке пользователя.
//
// Параметры:
//  Имя - Строка - имя константы опции из строки НАСТРОЙКА
//
// Возвращаемое значение:
//  Строка - представление
//
&НаКлиенте
Функция ПредставлениеОпцииДемо(Имя)

	Если Имя = "ИспользоватьПроизводство" Тогда
		Возврат НСтр("ru = 'производство'; fr = 'production'; en = 'production'; es = 'producción'");
	ИначеЕсли Имя = "ИспользоватьАвтовыпускПриОтгрузке" Тогда
		Возврат НСтр("ru = 'автовыпуск при отгрузке'; fr = 'production automatique à l''expédition';
			|en = 'automatic output on shipment'; es = 'producción automática al enviar'");
	ИначеЕсли Имя = "ИспользоватьУчетСтанков" Тогда
		Возврат НСтр("ru = 'учёт станков'; fr = 'suivi des machines'; en = 'machine tracking'; es = 'control de máquinas'");
	Иначе
		Возврат Имя;
	КонецЕсли;

КонецФункции

// Вид строки отчёта набора словами на языке пользователя.
//
// Параметры:
//  Вид - Строка - вид строки отчёта
//
// Возвращаемое значение:
//  Строка - представление
//
&НаКлиенте
Функция ПредставлениеВидаСтрокиДемо(Вид)

	Если Вид = "СОЗДАН" Тогда
		Возврат НСтр("ru = 'Создано'; fr = 'Créé'; en = 'Created'; es = 'Creado'");
	ИначеЕсли Вид = "ПЕРЕИСПОЛЬЗОВАН" Тогда
		Возврат НСтр("ru = 'Уже было'; fr = 'Existait déjà'; en = 'Already there'; es = 'Ya existía'");
	ИначеЕсли Вид = "НЕПОЛНЫЙ" Тогда
		Возврат НСтр("ru = 'Неполный'; fr = 'Incomplet'; en = 'Incomplete'; es = 'Incompleto'");
	ИначеЕсли Вид = "ПРОПУСК" Тогда
		Возврат НСтр("ru = 'Пропущено'; fr = 'Ignoré'; en = 'Skipped'; es = 'Omitido'");
	ИначеЕсли Вид = "НАСТРОЙКА" Тогда
		Возврат НСтр("ru = 'Включено'; fr = 'Activé'; en = 'Turned on'; es = 'Activado'");
	ИначеЕсли Вид = "ОТКАЗ" Тогда
		Возврат НСтр("ru = 'Отказ'; fr = 'Refus'; en = 'Refused'; es = 'Rechazo'");
	ИначеЕсли Вид = "ИНФО" Тогда
		Возврат НСтр("ru = 'Обратите внимание'; fr = 'À noter'; en = 'Note'; es = 'Nota'");
	Иначе
		Возврат НСтр("ru = 'Ошибка'; fr = 'Erreur'; en = 'Error'; es = 'Error'");
	КонецЕсли;

КонецФункции

// Текст подтверждения: что запишется и какие блоки заполнятся по включённым опциям. Опции кнопка не включает.
//
// Возвращаемое значение:
//  Строка - текст вопроса
//
&НаСервереБезКонтекста
Функция ТекстПодтвержденияДемоДанных()

	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'Демо-данные запишутся в настоящие регистры этой базы: остатки, партии, долги, деньги. Сами они
		|не удаляются. Уже заведённые элементы и кейсы набора переиспользуются, не дублируются.';
		|fr = 'Les données de démonstration seront écrites dans les registres réels de cette base : stocks, lots, dettes,
		|trésorerie. Elles ne se suppriment pas d''elles-mêmes. Les éléments et cas déjà créés sont réutilisés, pas dupliqués.';
		|en = 'Demo data will be written to the real registers of this infobase: stock, batches, debts, money. They are not
		|removed by themselves. Items and cases already created are reused, not duplicated.';
		|es = 'Los datos de demostración se escribirán en los registros reales de esta base: existencias, lotes, deudas,
		|dinero. No se eliminan solos. Los elementos y casos ya creados se reutilizan, no se duplican.'"));
	Строки.Добавить(НСтр("ru = 'Заполняется то, что включено в функциональных опциях; выключенные опции не включаются.';
		|fr = 'Seul ce qui est activé dans les options fonctionnelles est rempli ; les options désactivées ne sont pas activées.';
		|en = 'Only what is turned on in the functional options is filled; options that are off are not turned on.';
		|es = 'Solo se llena lo activado en las opciones funcionales; las opciones desactivadas no se activan.'"));
	Если Константы.ИспользоватьПроизводство.Получить() Тогда
		Строки.Добавить(НСтр("ru = '- производство и торговля'; fr = '- production et commerce';
			|en = '- production and trade'; es = '- producción y comercio'"));
		Если Константы.ИспользоватьУчетСтанков.Получить() Тогда
			Строки.Добавить(НСтр("ru = '- учёт станков'; fr = '- suivi des machines'; en = '- machine tracking';
				|es = '- control de máquinas'"));
		КонецЕсли;
	Иначе
		Строки.Добавить(НСтр("ru = '- производство выключено: набор будет пропущен'; fr = '- la production est désactivée : le jeu sera ignoré';
			|en = '- production is turned off: the set will be skipped'; es = '- la producción está desactivada: el conjunto se omitirá'"));
	КонецЕсли;
	Строки.Добавить(НСтр("ru = 'Заполнить?'; fr = 'Remplir ?'; en = 'Fill?'; es = '¿Llenar?'"));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокДемоДанных()

	Возврат НСтр("ru = 'Демо-данные'; fr = 'Données de démonstration'; en = 'Demo data'; es = 'Datos de demostración'");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПустойИдентификаторЗадания()

	Возврат Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");

КонецФункции

&НаКлиенте
Функция ЗаданиеДемоДанныхИдет()

	Возврат ЗначениеЗаполнено(ДемоЗадание) И ДемоЗадание <> ПустойИдентификаторЗадания();

КонецФункции

// Отказ до подтверждения: право администратора и демо-база.
//
// Возвращаемое значение:
//  Строка - текст отказа; пустая строка - можно заполнять
//
&НаСервереБезКонтекста
Функция ОтказДемоДанныхНаСервере()

	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат ТекстНетПраваДемоДанных();
	КонецЕсли;
	Рабочий = Обработки.ТестовыеДанные.РабочийДокументБазы(Ложь);
	Если Рабочий = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Обработки.ТестовыеДанные.ТекстОтказаДемоНабора(Рабочий);

КонецФункции

&НаСервереБезКонтекста
Функция ТекстНетПраваДемоДанных()

	Возврат НСтр("ru = 'Заполнить демо-данными может только администратор.';
		|fr = 'Seul l''administrateur peut remplir avec des données de démonstration.';
		|en = 'Only the administrator can fill with demo data.';
		|es = 'Solo el administrador puede llenar con datos de demostración.'");

КонецФункции

// Фоновое задание заполнения с ключом «ДемоДанные»: второе активное с тем же ключом платформа не запускает.
//
// Возвращаемое значение:
//  Строка - текст ошибки запуска; пустая строка - задание запущено
//
&НаСервере
Функция НачатьЗаполнениеДемоДанныхНаСервере()

	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат ТекстНетПраваДемоДанных();
	КонецЕсли;
	ПараметрыЗаполнения = Обработки.ТестовыеДанные.НовыеПараметрыДемоНабора();
	// Блоки - по включённым опциям; сами опции кнопка не включает (ВключитьХ остаются Ложь).
	Если Константы.ИспользоватьУчетСтанков.Получить() Тогда
		ПараметрыЗаполнения.Блоки = "CORE,M";
	КонецЕсли;
	ДемоАдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ПараметрыЗаполнения);
	ПараметрыЗадания.Добавить(ДемоАдресРезультата);
	Попытка
		Задание = ФоновыеЗадания.Выполнить("ПроцедурыРегламентныхЗаданий.ЗаполнитьДемоДанные", ПараметрыЗадания, "ДемоДанные",
			ЗаголовокДемоДанных());
	Исключение
		// BSLLS:DeprecatedMethodCall-off
		Описание = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		// BSLLS:DeprecatedMethodCall-on
		Возврат НСтр("ru = 'Заполнение не запущено (возможно, оно уже выполняется):';
			|fr = 'Le remplissage n''a pas démarré (il est peut-être déjà en cours) :';
			|en = 'Filling did not start (it may already be running):';
			|es = 'El llenado no se inició (quizá ya está en curso):'") + " " + Описание;
	КонецПопытки;
	ДемоЗадание = Задание.УникальныйИдентификатор;
	Возврат "";

КонецФункции

// Состояние фонового задания заполнения.
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - задание
//  Адрес         - Строка - адрес временного хранилища итога
//
// Возвращаемое значение:
//  Структура - Активно (Булево), Итог (Структура, Неопределено), Ошибка (Строка)
//
&НаСервереБезКонтекста
Функция СостояниеЗаполненияДемоДанных(Знач Идентификатор, Знач Адрес)

	Состояние = Новый Структура("Активно, Итог, Ошибка", Ложь, Неопределено, "");
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Идентификатор);
	Если Задание = Неопределено Тогда
		Состояние.Ошибка = НСтр("ru = 'Задание заполнения не найдено'; fr = 'Tâche de remplissage introuvable';
			|en = 'The filling job was not found'; es = 'No se encontró la tarea de llenado'");
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Состояние.Активно = Истина;
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Состояние.Итог = ПолучитьИзВременногоХранилища(Адрес);
		Если Состояние.Итог = Неопределено Тогда
			Состояние.Ошибка = НСтр("ru = 'Задание завершилось без итога'; fr = 'La tâche s''est terminée sans résultat';
				|en = 'The job ended without a result'; es = 'La tarea terminó sin resultado'");
		КонецЕсли;
	ИначеЕсли Задание.ИнформацияОбОшибке <> Неопределено Тогда
		// BSLLS:DeprecatedMethodCall-off
		Состояние.Ошибка = КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		// BSLLS:DeprecatedMethodCall-on
	Иначе
		Состояние.Ошибка = НСтр("ru = 'Задание заполнения отменено'; fr = 'Tâche de remplissage annulée';
			|en = 'The filling job was cancelled'; es = 'La tarea de llenado se canceló'");
	КонецЕсли;
	Возврат Состояние;

КонецФункции

#КонецОбласти
