// Блок настроек «Склад»: ячейки, ордерные склады, инвентаризация, комплектация.
// Константы записываются сразу при изменении поля.
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)

	ОбновлятьИнтерфейс = ЗаписатьНастройкуНаСервере(Элемент.Имя);
	Модифицированность = Ложь;
	ОбновитьПовторноИспользуемыеЗначения();
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

// Выключение опции «Ордерные склады» запрещено, пока ордерная схема используется: флажок возвращается, причина -
// предупреждением.
//
// Параметры:
//  Элемент - ПолеФормы - флажок опции.
//
&НаКлиенте
Процедура ОрдерныеСкладыПриИзменении(Элемент)

	ТекстЗапрета = "";
	ОбновлятьИнтерфейс = ЗаписатьОрдерныеСкладыНаСервере(ТекстЗапрета);
	Модифицированность = Ложь;
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ПоказатьПредупреждение(, ТекстЗапрета);
		Возврат;
	КонецЕсли;
	ОбновитьПовторноИспользуемыеЗначения();
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выключение - в одной транзакции под исключительной блокировкой опции: проверка и запись константы не разойдутся с
// параллельной записью ордерного склада или ордера (план warehouse-orders-option). Запрет - транзакция без записи и
// текст; исключения записи после отката идут дальше.
//
// Параметры:
//  ТекстЗапрета - Строка - возвращается причина запрета выключения.
//
// Возвращаемое значение:
//  Булево - нужно обновить интерфейс.
//
&НаСервере
Функция ЗаписатьОрдерныеСкладыНаСервере(ТекстЗапрета)

	Если НаборКонстант.ИспользоватьОрдерныеСклады Тогда
		Возврат Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, "ИспользоватьОрдерныеСклады");
	КонецЕсли;
	ОбновлятьИнтерфейс = Ложь;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		УправляемыеБлокировки.ОпцияОрдерныхСкладов(Блокировка, Истина);
		Блокировка.Заблокировать();
		ТекстЗапрета = Справочники.МестаХранения.ТекстЗапретаВыключенияОрдерности();
		// При запрете константа не пишется: транзакция фиксируется пустой, флажок возвращается.
		Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
			НаборКонстант.ИспользоватьОрдерныеСклады = Истина;
		Иначе
			ОбновлятьИнтерфейс = Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, "ИспользоватьОрдерныеСклады");
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат ОбновлятьИнтерфейс;

КонецФункции

&НаСервере
Функция ЗаписатьНастройкуНаСервере(Знач ИмяЭлемента)

	Возврат Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, ИмяЭлемента);

КонецФункции

#КонецОбласти
