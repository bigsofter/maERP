// Блок настроек «Бухгалтерия»: раздел и регламентированный учёт.
// Константы записываются сразу при изменении поля.
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьДоступностьЗависимых();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)

	ОбновлятьИнтерфейс = ЗаписатьНастройкуНаСервере(Элемент.Имя);
	Модифицированность = Ложь;
	ОбновитьПовторноИспользуемыеЗначения();
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьНастройкуНаСервере(Знач ИмяЭлемента)

	ОбновлятьИнтерфейс = Обработки.НастройкиПрограммы.ЗаписатьНастройкуФормы(ЭтотОбъект, ИмяЭлемента);
	УстановитьДоступностьЗависимых();
	Возврат ОбновлятьИнтерфейс;

КонецФункции

// Зависимые опции доступны только при включённой родительской.
//
&НаСервере
Процедура УстановитьДоступностьЗависимых()

	Элементы.ИспользоватьРегламентированныйУчет.Доступность = НаборКонстант.Бухгалтерия;

КонецПроцедуры

#КонецОбласти
