    <items xsi:type="form:FormField">
      <name>Бухгалтерия</name>
      <id>6</id>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <dataPath xsi:type="form:DataPath">
        <segments>НаборКонстант.Бухгалтерия</segments>
      </dataPath>
      <titleLocation>Right</titleLocation>
      <toolTip>
        <key>ru</key>
        <value>Включает раздел «Бухгалтерия»: налоговые документы, реестры и налоговые отчёты</value>
      </toolTip>
      <toolTip>
        <key>fr</key>
        <value>Active la section « Comptabilité » : documents fiscaux, registres et états fiscaux</value>
      </toolTip>
      <toolTip>
        <key>en</key>
        <value>Enables the "Accounting" section: tax documents, registers and tax reports</value>
      </toolTip>
      <toolTip>
        <key>es</key>
        <value>Activa la sección «Contabilidad»: documentos fiscales, registros e informes fiscales</value>
      </toolTip>
      <extendedTooltip>
        <name>БухгалтерияРасширеннаяПодсказка</name>
        <id>7</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <contextMenu>
        <name>БухгалтерияКонтекстноеМеню</name>
        <id>8</id>
        <autoFill>true</autoFill>
      </contextMenu>
      <type>CheckBoxField</type>
      <editMode>Enter</editMode>
      <showInHeader>true</showInHeader>
      <headerHorizontalAlign>Left</headerHorizontalAlign>
      <showInFooter>true</showInFooter>
      <extInfo xsi:type="form:CheckBoxFieldExtInfo">
        <handlers>
          <event>OnChange</event>
          <name>НастройкаПриИзменении</name>
        </handlers>
        <checkBoxType>Switcher</checkBoxType>
      </extInfo>
    </items>
    <items xsi:type="form:FormField">
