<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <items xsi:type="form:Decoration">
    <name>ОписаниеРаздела</name>
    <id>1</id>
    <title>
      <key>ru</key>
      <value>Зарплата и кадры: включение раздела и дата, с которой формируются движения по зарплате.</value>
    </title>
    <title>
      <key>fr</key>
      <value>Paie et personnel : activation de la section et date à partir de laquelle les mouvements de paie sont générés.</value>
    </title>
    <title>
      <key>en</key>
      <value>Payroll and HR: enabling the section and the date from which payroll movements are generated.</value>
    </title>
    <title>
      <key>es</key>
      <value>Nómina y personal: activación de la sección y fecha desde la que se generan los movimientos de nómina.</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>ОписаниеРазделаРасширеннаяПодсказка</name>
      <id>2</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>ОписаниеРазделаКонтекстноеМеню</name>
      <id>3</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <type>Label</type>
    <autoMaxHeight>true</autoMaxHeight>
    <extInfo xsi:type="form:LabelDecorationExtInfo">
      <horizontalAlign>Left</horizontalAlign>
    </extInfo>
  </items>
  <items xsi:type="form:FormGroup">
    <name>ГруппаЗарплата</name>
    <id>4</id>
    <items xsi:type="form:FormField">
      <name>Зарплата</name>
      <id>5</id>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <dataPath xsi:type="form:DataPath">
        <segments>НаборКонстант.Зарплата</segments>
      </dataPath>
      <titleLocation>Right</titleLocation>
      <toolTip>
        <key>ru</key>
        <value>Включает раздел «Зарплата и кадры» и его документы</value>
      </toolTip>
      <toolTip>
        <key>fr</key>
        <value>Active la section « Paie et personnel » et ses documents</value>
      </toolTip>
      <toolTip>
        <key>en</key>
        <value>Enables the "Payroll and HR" section and its documents</value>
      </toolTip>
      <toolTip>
        <key>es</key>
        <value>Activa la sección «Nómina y personal» y sus documentos</value>
      </toolTip>
      <extendedTooltip>
        <name>ЗарплатаРасширеннаяПодсказка</name>
        <id>6</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <contextMenu>
        <name>ЗарплатаКонтекстноеМеню</name>
        <id>7</id>
        <autoFill>true</autoFill>
      </contextMenu>
      <type>CheckBoxField</type>
      <editMode>Enter</editMode>
      <showInHeader>true</showInHeader>
      <headerHorizontalAlign>Left</headerHorizontalAlign>
      <showInFooter>true</showInFooter>
      <extInfo xsi:type="form:CheckBoxFieldExtInfo">
        <handlers>
          <event>OnChange</event>
          <name>НастройкаПриИзменении</name>
        </handlers>
        <checkBoxType>Switcher</checkBoxType>
      </extInfo>
    </items>
    <items xsi:type="form:FormField">
      <name>ДатаНачалаРасчетаЗарплаты</name>
      <id>8</id>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <dataPath xsi:type="form:DataPath">
        <segments>НаборКонстант.ДатаНачалаРасчетаЗарплаты</segments>
      </dataPath>
      <toolTip>
        <key>ru</key>
        <value>Движения по регистру зарплаты формируются только документами с этой даты; после заполнения не меняется</value>
      </toolTip>
      <toolTip>
        <key>fr</key>
        <value>Les mouvements de paie ne sont générés que par les documents à partir de cette date ; non modifiable une fois renseignée</value>
      </toolTip>
      <toolTip>
        <key>en</key>
        <value>Payroll movements are generated only by documents from this date on; cannot be changed once set</value>
      </toolTip>
      <toolTip>
        <key>es</key>
        <value>Los movimientos de nómina solo se generan por documentos desde esta fecha; no se cambia una vez rellenada</value>
      </toolTip>
      <extendedTooltip>
        <name>ДатаНачалаРасчетаЗарплатыРасширеннаяПодсказка</name>
        <id>9</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <contextMenu>
        <name>ДатаНачалаРасчетаЗарплатыКонтекстноеМеню</name>
        <id>10</id>
        <autoFill>true</autoFill>
      </contextMenu>
      <type>InputField</type>
      <editMode>Enter</editMode>
      <showInHeader>true</showInHeader>
      <headerHorizontalAlign>Left</headerHorizontalAlign>
      <showInFooter>true</showInFooter>
      <extInfo xsi:type="form:InputFieldExtInfo">
        <handlers>
          <event>OnChange</event>
          <name>НастройкаПриИзменении</name>
        </handlers>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <wrap>true</wrap>
        <chooseType>true</chooseType>
        <typeDomainEnabled>true</typeDomainEnabled>
        <textEdit>true</textEdit>
        <textSize>Normal</textSize>
        <font xsi:type="core:FontRef">
          <font>Style.Шрифт_Основной</font>
        </font>
      </extInfo>
    </items>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <title>
      <key>ru</key>
      <value>Зарплата</value>
    </title>
    <title>
      <key>fr</key>
      <value>Paie</value>
    </title>
    <title>
      <key>en</key>
      <value>Payroll</value>
    </title>
    <title>
      <key>es</key>
      <value>Nómina</value>
    </title>
    <extendedTooltip>
      <name>ГруппаЗарплатаРасширеннаяПодсказка</name>
      <id>11</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <type>UsualGroup</type>
    <extInfo xsi:type="form:UsualGroupExtInfo">
      <group>Vertical</group>
      <representation>WeakSeparation</representation>
      <showLeftMargin>true</showLeftMargin>
      <united>true</united>
      <showTitle>auto</showTitle>
      <currentRowUse>Auto</currentRowUse>
    </extInfo>
  </items>
  <autoCommandBar>
    <name>ФормаКоманднаяПанель</name>
    <id>-1</id>
    <horizontalAlign>Left</horizontalAlign>
    <autoFill>true</autoFill>
  </autoCommandBar>
  <handlers>
    <event>OnCreateAtServer</event>
    <name>ПриСозданииНаСервере</name>
  </handlers>
  <saveWindowSettings>true</saveWindowSettings>
  <autoTitle>true</autoTitle>
  <autoUrl>true</autoUrl>
  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <enabled>true</enabled>
  <showTitle>auto</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>НаборКонстант</name>
    <id>1</id>
    <valueType>
      <types>ConstantsSet</types>
    </valueType>
    <view>
      <common>true</common>
