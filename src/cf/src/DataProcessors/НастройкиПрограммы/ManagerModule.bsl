////////////////////////////////////////////////////////////////////////////////
// Панель настроек: серверная часть, общая для всех форм обработки.
// Каждая форма - один блок настроек на наборе констант; константа записывается
// сразу при изменении поля, кнопки «Записать» нет. Образец архитектуры -
// панель администрирования БСП (docs/UNF-ADOPTION.md), код свой.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Записывает константу, к которой привязано поле формы настроек, если значение изменилось.
//
// Параметры:
//  Форма      - ФормаКлиентскогоПриложения - форма на наборе констант с реквизитом НаборКонстант
//  ИмяЭлемента - Строка - имя поля формы с путём к данным вида «НаборКонстант.<Константа>»
//
// Возвращаемое значение:
//  Булево - Истина, если константа - расположение функциональной опции и клиенту нужно
//           обновить интерфейс
//
Функция ЗаписатьНастройкуФормы(Форма, ИмяЭлемента) Экспорт

	ИмяКонстанты = ИмяКонстантыПоПутиДанных(Форма.Элементы[ИмяЭлемента].ПутьКДанным);
	Возврат ЗаписатьКонстанту(ИмяКонстанты, Форма.НаборКонстант[ИмяКонстанты]);

КонецФункции

// Записывает константу, если значение изменилось.
//
// Параметры:
//  ИмяКонстанты - Строка - имя константы
//  Значение     - Произвольный - новое значение
//
// Возвращаемое значение:
//  Булево - Истина, если константа - расположение функциональной опции
//
Функция ЗаписатьКонстанту(ИмяКонстанты, Значение) Экспорт

	Менеджер = Константы[ИмяКонстанты];
	Если Менеджер.Получить() <> Значение Тогда
		Менеджер.Установить(Значение);
	КонецЕсли;
	Возврат ЭтоРасположениеФункциональнойОпции(ИмяКонстанты);

КонецФункции

// Имя константы из пути к данным поля формы настроек.
//
// Параметры:
//  ПутьКДанным - Строка - путь вида «НаборКонстант.<Константа>»
//
// Возвращаемое значение:
//  Строка - имя константы
//
Функция ИмяКонстантыПоПутиДанных(ПутьКДанным) Экспорт

	Части = СтрРазделить(ПутьКДанным, ".");
	Возврат Части[Части.ВГраница()];

КонецФункции

// Является ли константа расположением функциональной опции: после её записи
// клиенту нужно обновить интерфейс, иначе разделы появятся только после перезапуска.
//
// Параметры:
//  ИмяКонстанты - Строка - имя константы
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоРасположениеФункциональнойОпции(ИмяКонстанты) Экспорт

	МетаданныеКонстанты = Метаданные.Константы[ИмяКонстанты];
	Для Каждого Опция Из Метаданные.ФункциональныеОпции Цикл
		Если Опция.Хранение = МетаданныеКонстанты Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Допустимые часовые пояса для списка выбора: значение - имя пояса, представление -
// смещение и имя, например «UTC+01:00 Africa/Casablanca».
//
// Возвращаемое значение:
//  СписокЗначений
//
Функция ВариантыЧасовыхПоясов() Экспорт

	Варианты = Новый СписокЗначений;
	Для Каждого ЧасовойПояс Из ПолучитьДопустимыеЧасовыеПояса() Цикл
		Варианты.Добавить(ЧасовойПояс, ПредставлениеСмещения(СмещениеСтандартногоВремени(ЧасовойПояс)) + " " + ЧасовойПояс);
	КонецЦикла;
	Возврат Варианты;

КонецФункции

// Часовой пояс, в котором сейчас работает база: пояс информационной базы, а если он
// не задан - пояс сеанса.
//
// Возвращаемое значение:
//  Строка - имя часового пояса
//
Функция ТекущийЧасовойПояс() Экспорт

	ЧасовойПояс = ПолучитьЧасовойПоясИнформационнойБазы();
	Если ПустаяСтрока(ЧасовойПояс) Тогда
		ЧасовойПояс = ЧасовойПоясСеанса();
	КонецЕсли;
	Возврат ЧасовойПояс;

КонецФункции

// Устанавливает часовой пояс информационной базе и текущему сеансу. Нужен монопольный
// режим: при других открытых сеансах возвращает отказ с текстом, ничего не меняя.
//
// Параметры:
//  ЧасовойПояс - Строка - имя пояса из ПолучитьДопустимыеЧасовыеПояса()
//
// Возвращаемое значение:
//  Структура:
//   * Успех  - Булево
//   * Ошибка - Строка - причина отказа; пустая при успехе
//
Функция ПрименитьЧасовойПояс(ЧасовойПояс) Экспорт

	Результат = Новый Структура("Успех, Ошибка", Ложь, "");

	Если ПолучитьДопустимыеЧасовыеПояса().Найти(ЧасовойПояс) = Неопределено Тогда
		Результат.Ошибка = НСтр("ru = 'Часовой пояс не выбран или не известен платформе';
			|fr = 'Fuseau horaire non choisi ou inconnu de la plateforme';
			|en = 'Time zone is not chosen or unknown to the platform';
			|es = 'Zona horaria no elegida o desconocida para la plataforma'");
		Возврат Результат;
	КонецЕсли;

	// Смена пояса базы - административное действие; права на монопольный режим есть
	// не у всех ролей, а команда доступна из настроек только администратору.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Попытка
		УстановитьМонопольныйРежим(Истина);
	Исключение
		Результат.Ошибка = НСтр("ru = 'Не удалось занять базу монопольно - закройте другие сеансы и повторите';
			|fr = 'Impossible de verrouiller la base en mode exclusif - fermez les autres sessions et réessayez';
			|en = 'Could not lock the database exclusively - close other sessions and retry';
			|es = 'No se pudo bloquear la base en modo exclusivo - cierre las otras sesiones y reintente'");
		Возврат Результат;
	КонецПопытки;

	Попытка
		УстановитьЧасовойПоясИнформационнойБазы(ЧасовойПояс);
		УстановитьМонопольныйРежим(Ложь);
	Исключение
		УстановитьМонопольныйРежим(Ложь);
		// BSLLS:DeprecatedMethodCall-off
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		// BSLLS:DeprecatedMethodCall-on
		Возврат Результат;
	КонецПопытки;

	УстановитьЧасовойПоясСеанса(ЧасовойПояс);
	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Заголовок окна программы: название конфигурации и заголовок системы из настроек.
// Тот же состав, что ставит модуль приложения при запуске.
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаголовокОкнаПрограммы() Экспорт

	Заголовок = Метаданные.Синоним;
	Если ПустаяСтрока(Заголовок) Тогда
		Заголовок = Метаданные.Имя;
	КонецЕсли;
	Возврат СокрЛП(Заголовок + " " + Константы.ЗаголовокСистемы.Получить());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Смещение пояса строкой вида «UTC+01:00».
//
// Параметры:
//  СмещениеСекунд - Число - смещение стандартного времени пояса от UTC в секундах
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеСмещения(СмещениеСекунд)

	СекундВЧасе = 3600;
	СекундВМинуте = 60;
	Знак = ?(СмещениеСекунд < 0, "-", "+");
	Модуль = ?(СмещениеСекунд < 0, -СмещениеСекунд, СмещениеСекунд);
	Часы = Цел(Модуль / СекундВЧасе);
	Минуты = Цел((Модуль - Часы * СекундВЧасе) / СекундВМинуте);
	Возврат "UTC" + Знак + Формат(Часы, "ЧЦ=2; ЧВН=; ЧГ=0") + ":" + Формат(Минуты, "ЧЦ=2; ЧВН=; ЧГ=0");

КонецФункции

#КонецОбласти
