
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.Заголовок = Строка(ПараметрыСеанса.Пользователь);  
	Партнер  = ПараметрыСеанса.Контрагент;
	Пароль   = ПараметрыСеанса.Контрагент.Пароль;
	Менеджер = ПараметрыСеанса.Контрагент.Ответственный; 
	
	элементы.Партнер.Заголовок = Нстр("fr = 'Partenaire'; ru = 'Партнёр'; en = 'Partner'; es = 'Socio'");  
	элементы.Пароль.Заголовок = Нстр("fr = 'Mot de passe'; ru = 'Пароль'; en = 'Password'; es = 'Contraseña'");  
	элементы.Менеджер.Заголовок = Нстр("fr = 'Gestionnaire'; ru = 'Менеджер'; en = 'Manager'; es = 'Gerente'");  
	элементы.КомандаВыйти.Заголовок = Нстр("fr = 'Sortir'; ru = 'Выйти'; en = 'Exit'; es = 'Salir'");  
	элементы.КомандаИзменитьПаротль.Заголовок = Нстр("fr = 'Changer le mot de passe'; ru = 'Изменить пароль'; en = 'Change the password'; es = 'Cambiar contraseña'");  
	// Администратор, вошедший от имени партнёра, пароль партнёра не видит и не меняет.
	Если Обработки.ЛичныйКабинетПартнера.ЭтоВходАдминистратора() Тогда
		Пароль = "";
		Элементы.Пароль.Видимость = Ложь;
		Элементы.КомандаИзменитьПаротль.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

// Администратор, вошедший от имени партнёра, закрывает только кабинет; партнёр завершает работу.
//
// Параметры:
//  Команда - КомандаФормы - команда «Выйти»
//
&НаКлиенте
Процедура КомандаВыйти(Команда)
	Если ВыйтиИзКабинетаПартнера() Тогда
		Кабинет = ВладелецФормы;
		Закрыть();
		Если Кабинет <> Неопределено Тогда
			Кабинет.Закрыть();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыйтиИзКабинетаПартнера()
	Возврат Обработки.ЛичныйКабинетПартнера.ВыйтиИзКабинетаПартнера();
КонецФункции

&НаКлиенте
Процедура КомандаИзменитьПаротль(Команда)
	
	Если элементы.Пароль.Доступность = Ложь Тогда      
		элементы.Пароль.Доступность = Истина;		
		элементы.КомандаИзменитьПаротль.Заголовок = Нстр("fr = 'Enregistrer'; ru = 'Сохранить'; en = 'Save'; es = 'Guardar'"); 
	Иначе         
		Если СокрЛП(Пароль) = "" Тогда
			Элементы.Пароль.ЦветРамки = WebЦвета.Красный;	
		Иначе 
			ИзменитьПарольНасервере();
			элементы.Пароль.Доступность = Ложь;	 
			элементы.КомандаИзменитьПаротль.Заголовок = Нстр("fr = 'Changer le mot de passe'; ru = 'Изменить пароль'; en = 'Change the password'; es = 'Cambiar contraseña'");   
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьПарольНасервере()
	Если ЗначениеЗаполнено(Партнер.Пользователь) Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Партнер.Пользователь.ИдентификаторПользователяИБ);
		ПользовательИБ.Пароль = Пароль;
		ПользовательИБ.Записать();
		Спр = Партнер.ПолучитьОбъект();
		Спр.Пароль = Пароль;
		Попытка
			Спр.Записать();  
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры
