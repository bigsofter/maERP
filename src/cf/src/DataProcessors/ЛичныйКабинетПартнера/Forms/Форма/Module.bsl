
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НадписьПриветствие = НСтр("fr = 'Bienvenu au espace client!'; ru = 'Добро пожаловать в личный кабинет!'; en = 'Welcome to your personal account!'; es = 'Bienvenido a su cuenta personal!'");
    Польз = ПараметрыСеанса.Пользователь;

КонецПроцедуры

// +GAN  29/10/2025  Временная кнопка
// Партнёру кабинет открывается сразу. Администратор каждый раз выбирает покупателя, от имени которого откроется
// кабинет (закрытый крестиком кабинет оставляет прежнего партнёра сеанса), - см.
// Обработки.ЛичныйКабинетПартнера.ВойтиОтИмениПартнера.
&НаКлиенте
Процедура КомандаВойти(Команда)
	Если Не ЭтоВходАдминистратора() Тогда
		ОткрытьКабинет();
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура("Покупатель", Истина);
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("Отбор", Отбор);
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора", ПараметрыВыбора, ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ПартнерВыбран", ЭтотОбъект));
КонецПроцедуры

// Обработчик выбора партнёра администратором.
//
// Параметры:
//  Партнер                 - СправочникСсылка.Контрагенты, Неопределено - выбранный покупатель
//  ДополнительныеПараметры - Неопределено - не используются
//
&НаКлиенте
Процедура ПартнерВыбран(Партнер, ДополнительныеПараметры) Экспорт
	Если ЗначениеЗаполнено(Партнер) И ВойтиОтИмениПартнера(Партнер) Тогда
		ОткрытьКабинет();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКабинет()
	// BSLLS:UsingThisForm-off
	// BSLLS:DeprecatedMethodCall-off
	ЭтаФорма.Закрыть("ОК");
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Логин", ИмяПользователя());
	ОткрытьФорму("Обработка.ЛичныйКабинетПартнера.Форма.ФормаНоменклатура",ПараметрыФормы,Этаформа,,,,,РежимОткрытияОкнаФормы.Независимый);
	// BSLLS:DeprecatedMethodCall-on
	// BSLLS:UsingThisForm-on
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоВходАдминистратора()
	Возврат Обработки.ЛичныйКабинетПартнера.ЭтоВходАдминистратора();
КонецФункции

&НаСервереБезКонтекста
Функция ВойтиОтИмениПартнера(Знач Партнер)
	Возврат Обработки.ЛичныйКабинетПартнера.ВойтиОтИмениПартнера(Партнер);
КонецФункции


