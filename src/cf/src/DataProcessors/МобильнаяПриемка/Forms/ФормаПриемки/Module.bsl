// Мобильная приёмка поступления: скан штрихкода или ввод количества строки, проведение. Каждое изменение - серверная
// транзакция с версией черновика (docs/plans/retail-mobile-receipt.md); форма показывает ответ сервера.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Параметры.Свойство("Поступление", Поступление);
	Если Не ЗначениеЗаполнено(Поступление) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ПоказатьСостояние(Обработки.МобильнаяПриемка.СостояниеПриемки(Поступление));
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОперацииСПодключаемымОборудованиемКлиент.ПодключитьОборудование(УникальныйИдентификатор, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ScanData" И ВводДоступен() Тогда
		Код = ОперацииСПодключаемымОборудованиемКлиент.ПолучитьШтрихкод(ИмяСобытия, Параметр, Источник);
		ОбработатьСкан(Код, Неопределено);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ШтрихкодПриИзменении(Элемент)
	Если Не ПустаяСтрока(Штрихкод) Тогда
		ОбработатьСкан(Штрихкод, Неопределено);
		Штрихкод = "";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтроки

&НаКлиенте
Процедура СтрокиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Строки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.НеПринимается Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект, ТекущиеДанные.Ключ);
	Разрядность = 15;
	Точность = 3;
	ПоказатьВводЧисла(Оповещение, ТекущиеДанные.Принято, НСтр("ru = 'Принято'; fr = 'Reçu'; en = 'Received';
		|es = 'Recibido'"), Разрядность, Точность);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКоличества(Число, Ключ) Экспорт
	Если Число <> Неопределено Тогда
		ПоказатьОтвет(УстановитьКоличествоНаСервере(Ключ, Число));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Провести(Команда)
	ПоказатьОтвет(ПровестиНаСервере());
	Оповестить("МобильнаяПриемкаИзменена");
КонецПроцедуры

&НаКлиенте
Процедура ПривестиКПоступлению(Команда)
	ПоказатьОтвет(ПривестиНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработатьСкан(Код, Ключ)
	Ответ = СканНаСервере(Код, Ключ);
	Если Ответ.Результат = "Выбор" Тогда
		Список = Новый СписокЗначений;
		Для Каждого Позиция Из Ответ.Позиции Цикл
			Список.Добавить(Позиция.Ключ, Позиция.Представление);
		КонецЦикла;
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораПозиции", ЭтотОбъект, Код);
		ПоказатьВыборИзСписка(Оповещение, Список);
	Иначе
		ПоказатьОтвет(Ответ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПозиции(Выбранный, Код) Экспорт
	Если Выбранный <> Неопределено Тогда
		ОбработатьСкан(Код, Выбранный.Значение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтвет(Ответ)
	Сообщение = Ответ.Сообщение;
КонецПроцедуры

&НаСервере
Функция СканНаСервере(Знач Код, Знач Ключ)
	Ответ = Обработки.МобильнаяПриемка.Скан(Поступление, Код, Версия, ВыделеннаяСсылка, Ключ, ВерсияПоступления);
	Возврат ПринятьОтвет(Ответ);
КонецФункции

&НаСервере
Функция УстановитьКоличествоНаСервере(Знач Ключ, Знач Количество)
	Ответ = Обработки.МобильнаяПриемка.УстановитьКоличество(Поступление, Ключ, Количество, Версия, ВыделеннаяСсылка,
		ВерсияПоступления);
	Возврат ПринятьОтвет(Ответ);
КонецФункции

&НаСервере
Функция ПровестиНаСервере()
	Ответ = Обработки.МобильнаяПриемка.Провести(Поступление, Черновик, Версия);
	Возврат ПринятьОтвет(Ответ);
КонецФункции

&НаСервере
Функция ПривестиНаСервере()
	Ответ = Обработки.МобильнаяПриемка.ПривестиКПоступлению(Поступление, Версия);
	Возврат ПринятьОтвет(Ответ);
КонецФункции

&НаСервере
Процедура ОбновитьНаСервере()
	ПоказатьСостояние(Обработки.МобильнаяПриемка.СостояниеПриемки(Поступление));
КонецПроцедуры

// Состояние из ответа - в реквизиты формы; клиенту - результат и сообщение (позиции для выбора).
//
// Параметры:
//  Ответ - Структура - ответ функции обработки (см. Обработки.МобильнаяПриемка.Скан).
//
// Возвращаемое значение:
//  Структура - Результат, Сообщение, Позиции.
//
&НаСервере
Функция ПринятьОтвет(Ответ)
	Если Ответ.Состояние <> Неопределено Тогда
		ПоказатьСостояние(Ответ.Состояние);
	КонецЕсли;
	Результат = Новый Структура("Результат, Сообщение, Позиции", Ответ.Результат, Ответ.Сообщение, Ответ.Позиции);
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ПоказатьСостояние(Состояние)
	Черновик = Состояние.Черновик;
	Версия = Состояние.Версия;
	// Ссылку первого изменения форма меняет только по ответу сервера без активного черновика.
	Если Не ЗначениеЗаполнено(Состояние.Черновик) Тогда
		ВыделеннаяСсылка = Состояние.ВыделеннаяСсылка;
	КонецЕсли;
	КонфликтШапки = Состояние.КонфликтШапки;
	ВерсияПоступления = Состояние.ВерсияПоступления;
	Строки.Очистить();
	Для Каждого СтрокаСостояния Из Состояние.Строки Цикл
		НоваяСтрока = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСостояния, "Ключ, Доступно, Принято, Осталось, Конфликт, НеПринимается");
		НоваяСтрока.Товар = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(СтрокаСостояния.Номенклатура,
			СтрокаСостояния.Характеристика, , Истина) + ?(ЗначениеЗаполнено(СтрокаСостояния.Серия),
			" / " + СтрокаСостояния.Серия, "");
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
