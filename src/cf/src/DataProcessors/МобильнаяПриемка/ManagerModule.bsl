// Мобильная приёмка поступлений через приходный ордер (docs/plans/retail-mobile-receipt.md). Кладовщику назначено
// поступление на ордерный склад (ОтветственныйЗаПриемку); приёмка ведётся в черновике приходного ордера на сервере
// (МобильнаяПриемка, ПоступлениеПриемки), каждое изменение - транзакция под блокировкой поступления с проверкой
// версии черновика; первый шаг приёмки - с заранее выделенной ссылкой ордера, след - регистр
// ИспользованныеСсылкиПриемки. Права на ордер даёт роль СкладскиеОрдера: право проверяется до привилегированного
// чтения назначения и остатков; запись и проведение ордера - под правами пользователя.
//
// Привилегированный режим - осознанно и только в функциях чтения, после проверки права на приходный ордер.
// BSLLS:SetPrivilegedMode-off

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Поступления к приёмке текущего пользователя: с остатком к приёмке или его черновиком.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Поступление, Представление, Осталось, ЕстьЧерновик; пустая без права на приходный ордер.
//
Функция СписокПриемки() Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Поступление");
	Результат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Осталось", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ЕстьЧерновик", Новый ОписаниеТипов("Булево"));
	Если Не ЕстьПравоПриемки() Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Данные Из НазначенныеПоступления() Цикл
		Если Данные.Осталось > 0 Или Данные.ЕстьЧерновик Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Данные);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Состояние приёмки поступления: черновик, его версия, строки ожидания (доступно, принято, осталось), конфликты.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//
// Возвращаемое значение:
//  Структура - см. НовоеСостояние.
//
Функция СостояниеПриемки(Поступление) Экспорт
	ПроверитьПраво();
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПоступление(Поступление);
		ПроверитьНазначение(Поступление);
		Состояние = СостояниеПоступления(Поступление);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Состояние;
КонецФункции

// Скан штрихкода: +1 базовая единица к строке ожидания по дереву сопоставления; при нескольких позициях - выбор.
//
// Параметры:
//  Поступление       - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//  Штрихкод          - Строка - отсканированное значение.
//  Версия            - Строка - версия данных черновика, которую видела форма; пустая - черновика не было.
//  ВыделеннаяСсылка  - Строка - уникальный идентификатор ссылки для первого изменения.
//  Ключ              - Число, Неопределено - ключ строки, выбранной пользователем (неоднозначность).
//  ВерсияПоступления - Строка - версия данных поступления из ответа «Выбор»: выбранная позиция применяется, только
//                      если поступление с тех пор не менялось; пустая - не проверяется.
//
// Возвращаемое значение:
//  Структура - Результат («Принято», «Выбор», «Отказ», «Устарело»), Сообщение, Позиции (Массив из Структура:
//              Ключ, Представление - для выбора), Состояние.
//
Функция Скан(Поступление, Штрихкод, Версия, ВыделеннаяСсылка, Ключ = Неопределено, ВерсияПоступления = "") Экспорт
	ПроверитьПраво();
	Ответ = НовыйОтвет();
	ВерсияПодбора = ВерсияПоступления;
	Если Ключ <> Неопределено И Не КлючСреди(Ключ, ПодборСкана(Поступление, Штрихкод).Позиции) Тогда
		// Выбранная позиция повторно сверяется со штрихкодом: ключ не из подбора - отказ без записи.
		Ответ.Результат = "Отказ";
		Ответ.Сообщение = ТекстНетВПоступлении();
		Ответ.Состояние = СостояниеПриемки(Поступление);
		Возврат Ответ;
	ИначеЕсли Ключ = Неопределено Тогда
		Подбор = ПодборСкана(Поступление, Штрихкод);
		Если Подбор.Отказ <> "" Тогда
			Ответ.Результат = "Отказ";
			Ответ.Сообщение = Подбор.Отказ;
			Ответ.Состояние = Подбор.Состояние;
			Возврат Ответ;
		ИначеЕсли Подбор.Позиции.Количество() > 1 Тогда
			Ответ.Результат = "Выбор";
			Ответ.Позиции = Подбор.Позиции;
			Ответ.Состояние = Подбор.Состояние;
			Возврат Ответ;
		Иначе
			Ключ = Подбор.Позиции[0].Ключ;
			ВерсияПодбора = Подбор.Состояние.ВерсияПоступления;
		КонецЕсли;
	Иначе
		// Выбранная позиция сверена со штрихкодом выше.
		ВерсияПодбора = ВерсияПоступления;
	КонецЕсли;
	// Позиция подобрана по версии поступления ВерсияПодбора: изменённое с тех пор поступление - «Устарело».
	Изменение = Новый Структура("Вид, Ключ, Количество", "Приращение", Ключ, 1);
	Изменение.Вставить("ВерсияПоступления", ВерсияПодбора);
	Изменение.Вставить("ВерсияОбязательна", Ложь);
	Возврат ИзменитьЧерновик(Поступление, Версия, ВыделеннаяСсылка, Изменение);
КонецФункции

// Ручной ввод принятого количества строки (0 - снять принятие строки).
//
// Параметры:
//  Поступление      - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//  Ключ             - Число - ключ строки источника.
//  Количество       - Число - принятое количество (0..доступно).
//  Версия           - Строка - версия черновика из формы.
//  ВыделеннаяСсылка - Строка - ссылка первого изменения.
//  ВерсияПоступления - Строка - версия данных поступления, по которой форма показала строку (защита от замены товара
//                      в строке между показом и вводом); обязательна, не совпала - «Устарело».
//
// Возвращаемое значение:
//  Структура - см. Скан.
//
Функция УстановитьКоличество(Поступление, Ключ, Количество, Версия, ВыделеннаяСсылка, ВерсияПоступления) Экспорт
	ПроверитьПраво();
	Изменение = Новый Структура("Вид, Ключ, Количество", "Количество", Ключ, Количество);
	Изменение.Вставить("ВерсияПоступления", ВерсияПоступления);
	Изменение.Вставить("ВерсияОбязательна", Истина);
	Возврат ИзменитьЧерновик(Поступление, Версия, ВыделеннаяСсылка, Изменение);
КонецФункции

// Приведение черновика к изменившемуся поступлению: принятое уменьшается до доступного, исчезнувшие и заменённые
// строки обнуляются; при конфликте даты - перенос даты приёмки.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//  Версия      - Строка - версия черновика из формы.
//
// Возвращаемое значение:
//  Структура - см. Скан.
//
Функция ПривестиКПоступлению(Поступление, Версия) Экспорт
	ПроверитьПраво();
	Изменение = Новый Структура("Вид, Ключ, Количество", "Привести", 0, 0);
	Изменение.Вставить("ВерсияПоступления", "");
	Изменение.Вставить("ВерсияОбязательна", Ложь);
	Возврат ИзменитьЧерновик(Поступление, Версия, "", Изменение);
КонецФункции

// Проведение черновика приёмки. Повтор после потерянного ответа (ордер уже проведён) возвращает результат прежней
// операции без записи; изменённый с тех пор черновик (другая версия) - отказ.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//  Черновик    - ДокументСсылка.ПриходныйОрдер - ордер, который показала форма.
//  Версия      - Строка - его версия данных из формы.
//
// Возвращаемое значение:
//  Структура - см. Скан; Результат «Проведено».
//
Функция Провести(Поступление, Черновик, Версия) Экспорт
	ПроверитьПраво();
	Ответ = НовыйОтвет();
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПоступление(Поступление);
		ПроверитьНазначение(Поступление);
		Данные = ДанныеОрдера(Черновик);
		Если Данные = Неопределено Или Данные.ПоступлениеПриемки <> Поступление Тогда
			ВызватьИсключение ТекстНетЧерновика();
		КонецЕсли;
		Если Данные.Проведен Тогда
			Ответ.Результат = "Проведено";
			Ответ.Сообщение = НСтр("ru = 'Приёмка уже проведена'; fr = 'La réception est déjà validée';
				|en = 'The receiving is already posted'; es = 'La recepción ya está contabilizada'");
		ИначеЕсли Данные.ВерсияДанных <> Версия Или Данные.ПометкаУдаления Тогда
			Ответ.Результат = "Устарело";
			Ответ.Сообщение = ТекстУстарело();
		Иначе
			Состояние = СостояниеПоступления(Поступление);
			Если Состояние.ЕстьКонфликты Тогда
				ВызватьИсключение НСтр("ru = 'Есть расхождения с поступлением: приведите приёмку к поступлению';
					|fr = 'Des écarts avec la réception existent : alignez la réception';
					|en = 'There are differences with the goods receipt: align the receiving';
					|es = 'Hay diferencias con la recepción: ajuste la recepción'");
			КонецЕсли;
			Ордер = Черновик.ПолучитьОбъект();
			Ордер.Записать(РежимЗаписиДокумента.Проведение);
			Ответ.Результат = "Проведено";
		КонецЕсли;
		Ответ.Состояние = СостояниеПоступления(Поступление);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// Приходный ордер, ПередЗаписью: инварианты ордера мобильной приёмки - поступление приёмки в шапке и у всех строк;
// черновик (непроведённый, без пометки) - единственный у ответственного по поступлению и ответственный совпадает с
// назначением поступления.
//
// Параметры:
//  Ордер       - ДокументОбъект.ПриходныйОрдер - записываемый ордер.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  Отказ       - Булево - отказ записи.
//
Процедура ПроверитьОрдерПриемки(Ордер, РежимЗаписи, Отказ) Экспорт
	Если Ордер.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Тексты = Новый Массив;
	// Любая запись ордера приёмки - до и после записи, в том числе вывод из приёмки, - только назначенным кладовщиком
	// или администратором.
	ПоступлениеДоЗаписи = СохраненноеПоступлениеПриемки(Ордер);
	ПроверитьПользователяОрдера(ПоступлениеДоЗаписи, Тексты);
	Если Ордер.МобильнаяПриемка И Ордер.ПоступлениеПриемки <> ПоступлениеДоЗаписи Тогда
		ПроверитьПользователяОрдера(Ордер.ПоступлениеПриемки, Тексты);
	КонецЕсли;
	Если Не Ордер.МобильнаяПриемка Или Тексты.Количество() > 0 Тогда
		СообщитьОтказ(Ордер, Тексты, Отказ);
		Возврат;
	КонецЕсли;
	// Черновиком после записи ордер станет при отмене проведения или записи непроведённого.
	СтанетЧерновиком = РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
		Или РежимЗаписи = РежимЗаписиДокумента.Запись И Не Ордер.Проведен;
	Если Не ЗначениеЗаполнено(Ордер.ПоступлениеПриемки) Тогда
		Тексты.Добавить(НСтр("ru = 'Не указано поступление мобильной приёмки'; fr = 'La réception mobile n''a pas de réception';
			|en = 'The mobile receiving has no goods receipt'; es = 'La recepción móvil no tiene recepción de mercancías'"));
	ИначеЕсли Ордер.ТЧТовары.НайтиСтроки(Новый Структура("ДокументИсточник", Ордер.ПоступлениеПриемки)).Количество()
		<> Ордер.ТЧТовары.Количество() Тогда
		Тексты.Добавить(НСтр("ru = 'Строки мобильной приёмки - только из её поступления';
			|fr = 'Les lignes de la réception mobile proviennent uniquement de sa réception';
			|en = 'Mobile receiving rows come only from its goods receipt';
			|es = 'Las filas de la recepción móvil solo proceden de su recepción'"));
	ИначеЕсли СтанетЧерновиком И Не Ордер.ПометкаУдаления Тогда
		ПроверитьЧерновикВПоступлении(Ордер, Тексты);
	Иначе
		// Проведение, запись проведённого или помеченного - уникальность черновика не затрагивается.
		Возврат;
	КонецЕсли;
	СообщитьОтказ(Ордер, Тексты, Отказ);
КонецПроцедуры

// Допуск пользователя к ордеру мобильной приёмки поступления: назначенный кладовщик или администратор.
//
// Параметры:
//  Поступление   - ДокументСсылка.ПоступлениеТоваровУслуг - поступление приёмки.
//  Пользователь  - СправочникСсылка.Пользователи - пользователь.
//  Администратор - Булево - у пользователя право администрирования.
//
// Возвращаемое значение:
//  Булево - Истина, если ордер этой приёмки пользователю можно изменять, проводить и выводить из приёмки.
//
Функция ДопускКОрдеруПриемки(Поступление, Пользователь, Администратор) Экспорт
	Если Администратор Тогда
		Возврат Истина;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поступление, "ОтветственныйЗаПриемку") = Пользователь;
КонецФункции

// Поступление, ПередЗаписью: смена ответственного за приёмку при незавершённой мобильной приёмке запрещена.
//
// Параметры:
//  Поступление - ДокументОбъект.ПоступлениеТоваровУслуг - записываемое поступление.
//  Отказ       - Булево - отказ записи.
//
Процедура ПроверитьПереназначение(Поступление, Отказ) Экспорт
	Если Поступление.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Поступление.ЭтоНовый() Тогда
		Прежний = Справочники.Пользователи.ПустаяСсылка();
	Иначе
		Прежний = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поступление.Ссылка, "ОтветственныйЗаПриемку");
	КонецЕсли;
	Если Прежний = Поступление.ОтветственныйЗаПриемку Тогда
		Возврат;
	КонецЕсли;
	ПолеНазначения = "ОтветственныйЗаПриемку";
	Если Не ПравоНазначенияКладовщика(ПравоДоступа("Администрирование", Метаданные), ЕстьПравоПриемки()) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'Назначает кладовщика приёмки менеджер без права на приходные ордера или администратор';
			|fr = 'Le magasinier de réception est affecté par un responsable sans droit sur les bons d''entrée ou par l''administrateur';
			|en = 'The receiving clerk is assigned by a manager without receipt order rights or by an administrator';
			|es = 'Asigna el almacenero de recepción un responsable sin derecho a órdenes de entrada o el administrador'"),
			Поступление, ПолеНазначения, , Отказ);
		Возврат;
	КонецЕсли;
	Если Поступление.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	ЗаблокироватьПоступление(Поступление.Ссылка);
	Черновики = ЧерновикиПоступления(Поступление.Ссылка, Неопределено);
	Если Черновики.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Есть незавершённая приёмка %1 (%2): проведите или отмените её, затем переназначьте';
			|fr = 'Une réception %1 (%2) est inachevée : validez-la ou annulez-la, puis réaffectez';
			|en = 'Receiving %1 (%2) is unfinished: post or cancel it, then reassign';
			|es = 'Hay una recepción %1 (%2) sin terminar: contabilícela o anúlela y luego reasigne'");
		Текст = СтрШаблон(Шаблон, Черновики[0].Ссылка, Черновики[0].Ответственный);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Поступление, ПолеНазначения, , Отказ);
	КонецЕсли;
КонецПроцедуры

// Полномочие назначения кладовщика приёмки (разделение обязанностей): исполнитель приходных ордеров сам себе и
// другим приёмку не назначает - назначение даёт доступ к ордерам приёмки.
//
// Параметры:
//  Администратор - Булево - у пользователя право администрирования.
//  ЕстьПравоОрдеров - Булево - у пользователя право добавления приходных ордеров.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь может назначать, менять и снимать кладовщика приёмки.
//
Функция ПравоНазначенияКладовщика(Администратор, ЕстьПравоОрдеров) Экспорт
	Возврат Администратор Или Не ЕстьПравоОрдеров;
КонецФункции

// Исключительная блокировка поступления приёмки - первая блокировка записи ордера мобильной приёмки: поступление
// записанной версии ордера (вывод из приёмки) и записываемой.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер - записываемый ордер.
//
Процедура ЗаблокироватьПоступлениеПриемки(Ордер) Экспорт
	ДоЗаписи = СохраненноеПоступлениеПриемки(Ордер);
	Если ЗначениеЗаполнено(ДоЗаписи) Тогда
		ЗаблокироватьПоступление(ДоЗаписи);
	КонецЕсли;
	Если Ордер.МобильнаяПриемка И ЗначениеЗаполнено(Ордер.ПоступлениеПриемки) И Ордер.ПоступлениеПриемки <> ДоЗаписи Тогда
		ЗаблокироватьПоступление(Ордер.ПоступлениеПриемки);
	КонецЕсли;
КонецПроцедуры

// Вывод ордера из мобильной приёмки (обычная форма ордера): снимает признак; у проведённого - вместе с отменой
// проведения одной записью.
//
// Параметры:
//  Ордер - ДокументСсылка.ПриходныйОрдер - ордер.
//
Процедура ВывестиИзМобильнойПриемки(Ордер) Экспорт
	Объект = Ордер.ПолучитьОбъект();
	Если Не Объект.МобильнаяПриемка Тогда
		Возврат;
	КонецЕсли;
	Объект.МобильнаяПриемка = Ложь;
	Объект.ПоступлениеПриемки = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();
	Если Объект.Проведен Тогда
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Доступ

Функция ЕстьПравоПриемки()
	Возврат ПравоДоступа("Добавление", Метаданные.Документы.ПриходныйОрдер);
КонецФункции

// Право на ордер - реальными правами пользователя, до привилегированного чтения и до транзакции.
Процедура ПроверитьПраво()
	Если Не ЕстьПравоПриемки() Тогда
		ВызватьИсключение НСтр("ru = 'Нет права на приёмку (приходный ордер)'; fr = 'Pas de droit de réception (bon d''entrée)';
			|en = 'No right to receive (receipt order)'; es = 'Sin derecho de recepción (orden de entrada)'");
	КонецЕсли;
КонецПроцедуры

// Назначение поступления пользователю на ордерный склад - внутри транзакции под блокировкой поступления (та же
// блокировка, что берёт переназначение), до привилегированного чтения состояния.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//
Процедура ПроверитьНазначение(Поступление)
	Если Не НазначеноПользователю(Поступление) Тогда
		ВызватьИсключение НСтр("ru = 'Поступление не назначено вам для приёмки';
			|fr = 'La réception ne vous est pas affectée'; en = 'The goods receipt is not assigned to you';
			|es = 'La recepción no le está asignada'");
	КонецЕсли;
КонецПроцедуры

Функция НазначеноПользователю(Поступление)
	УстановитьПривилегированныйРежим(Истина);
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Поступление, "ОтветственныйЗаПриемку, МестоХранения, Дата, Проведен");
	Возврат Данные.ОтветственныйЗаПриемку = ПараметрыСеанса.Пользователь И Данные.Проведен = Истина
		И Справочники.МестаХранения.ОрдерныйСклад(Данные.МестоХранения, Данные.Дата);
КонецФункции

Функция НазначенныеПоступления()
	УстановитьПривилегированныйРежим(Истина);
	// Ордерность склада на дату поступления - тем же правилом, что МестаХранения.ОрдерныйНаДату; завершённые
	// поступления (без остатка к оформлению и без черновика пользователя) отсекаются запросом.
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Поступления.Ссылка КАК Поступление,
	|	Поступления.Дата КАК Дата
	|ПОМЕСТИТЬ Назначенные
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МестаХранения КАК Склады
	|		ПО Поступления.МестоХранения = Склады.Ссылка
	|ГДЕ
	|	Поступления.ОтветственныйЗаПриемку = &Пользователь
	|	И Поступления.Проведен
	|	И НЕ Поступления.ПометкаУдаления
	|	И Склады.ОрдерныйСклад
	|	И НАЧАЛОПЕРИОДА(Поступления.Дата, ДЕНЬ) >= НАЧАЛОПЕРИОДА(Склады.ДатаНачалаОрдернойСхемы, ДЕНЬ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Поступление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Источник КАК Поступление,
	|	СУММА(Остатки.КоличествоОстаток) КАК Осталось
	|ПОМЕСТИТЬ ОстаткиПоступлений
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению.Остатки(
	|			,
	|			Источник В
	|				(ВЫБРАТЬ
	|					Назначенные.Поступление КАК Поступление
	|				ИЗ
	|					Назначенные)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Источник
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Поступление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ордера.ПоступлениеПриемки КАК Поступление
	|ПОМЕСТИТЬ ЧерновикиПользователя
	|ИЗ
	|	Документ.ПриходныйОрдер КАК Ордера
	|ГДЕ
	|	Ордера.МобильнаяПриемка
	|	И НЕ Ордера.Проведен
	|	И НЕ Ордера.ПометкаУдаления
	|	И Ордера.Ответственный = &Пользователь
	|	И Ордера.ПоступлениеПриемки В
	|			(ВЫБРАТЬ
	|				Назначенные.Поступление КАК Поступление
	|			ИЗ
	|				Назначенные)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Поступление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Назначенные.Поступление КАК Поступление,
	|	ПРЕДСТАВЛЕНИЕ(Назначенные.Поступление) КАК Представление,
	|	ЕСТЬNULL(ОстаткиПоступлений.Осталось, 0) КАК Осталось,
	|	НЕ ЧерновикиПользователя.Поступление ЕСТЬ NULL КАК ЕстьЧерновик
	|ИЗ
	|	Назначенные КАК Назначенные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиПоступлений КАК ОстаткиПоступлений
	|		ПО Назначенные.Поступление = ОстаткиПоступлений.Поступление
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЧерновикиПользователя КАК ЧерновикиПользователя
	|		ПО Назначенные.Поступление = ЧерновикиПользователя.Поступление
	|ГДЕ
	|	НЕ(ОстаткиПоступлений.Поступление ЕСТЬ NULL
	|				И ЧерновикиПользователя.Поступление ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Назначенные.Дата,
	|	Назначенные.Поступление");
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.Пользователь);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти

#Область Состояние

Функция НовоеСостояние()
	Состояние = Новый Структура("Черновик, Версия, ВыделеннаяСсылка", Документы.ПриходныйОрдер.ПустаяСсылка(), "", "");
	Состояние.Вставить("КонфликтШапки", "");
	Состояние.Вставить("ВерсияПоступления", "");
	Состояние.Вставить("ЕстьКонфликты", Ложь);
	Строки = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Ключ,Номенклатура,Характеристика,Серия,Упаковка,Доступно,Принято,Осталось,"
		+ "Конфликт,ВидКонфликта,НеПринимается,КодСтрокиЗаказа", ",") Цикл
		Строки.Колонки.Добавить(Имя);
	КонецЦикла;
	Состояние.Вставить("Строки", Строки);
	Возврат Состояние;
КонецФункции

// Состояние приёмки: ожидание (доступно R - неоформленный остаток, принято D - черновик), конфликты строк и шапки.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//
// Возвращаемое значение:
//  Структура - Черновик, Версия, ВыделеннаяСсылка, КонфликтШапки, ЕстьКонфликты, Строки (ТаблицаЗначений).
//
Функция СостояниеПоступления(Поступление)
	УстановитьПривилегированныйРежим(Истина);
	Состояние = НовоеСостояние();
	Состояние.ВерсияПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поступление, "ВерсияДанных");
	Ожидание = ОжиданиеПоступления(Поступление);
	Черновики = ЧерновикиПоступления(Поступление, ПараметрыСеанса.Пользователь);
	Принято = Новый Соответствие;
	Если Черновики.Количество() > 0 Тогда
		Черновик = Черновики[0].Ссылка.ПолучитьОбъект();
		Состояние.Черновик = Черновик.Ссылка;
		Состояние.Версия = Черновик.ВерсияДанных;
		Для Каждого СтрокаОрдера Из Черновик.ТЧТовары Цикл
			Принято.Вставить(СтрокаОрдера.КлючСтрокиДокумента, СтрокаОрдера);
		КонецЦикла;
		Состояние.КонфликтШапки = КонфликтШапки(Черновик, Поступление);
	Иначе
		Состояние.ВыделеннаяСсылка = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	Серийные = СерийныеТовары(Ожидание);
	Для Каждого СтрокаОжидания Из Ожидание Цикл
		Новая = Состояние.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, СтрокаОжидания);
		Новая.Ключ = СтрокаОжидания.КлючСтрокиДокумента;
		Новая.Доступно = СтрокаОжидания.Количество;
		Новая.Принято = 0;
		Новая.Конфликт = "";
		Новая.ВидКонфликта = "";
		Новая.НеПринимается = Серийные.Найти(СтрокаОжидания.Номенклатура) <> Неопределено;
		СтрокаЧерновика = Принято[СтрокаОжидания.КлючСтрокиДокумента];
		Если СтрокаЧерновика <> Неопределено Тогда
			Новая.Принято = СтрокаЧерновика.Количество;
			Принято.Удалить(СтрокаОжидания.КлючСтрокиДокумента);
			ЗаполнитьКонфликтСтроки(Новая, СтрокаЧерновика);
		КонецЕсли;
		Новая.Осталось = Макс(Новая.Доступно - Новая.Принято, 0);
	КонецЦикла;
	// Строки черновика, ключей которых больше нет в доступном.
	Для Каждого КлючИЗначение Из Принято Цикл
		Новая = Состояние.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, КлючИЗначение.Значение, "Номенклатура, Характеристика, Серия, Упаковка");
		Новая.Ключ = КлючИЗначение.Ключ;
		Новая.Доступно = 0;
		Новая.Принято = КлючИЗначение.Значение.Количество;
		Новая.Осталось = 0;
		Новая.НеПринимается = Ложь;
		Новая.ВидКонфликта = "НетСтроки";
		Новая.Конфликт = НСтр("ru = 'Строки нет в поступлении'; fr = 'Ligne absente de la réception';
			|en = 'Row not in the goods receipt'; es = 'Fila ausente de la recepción'");
	КонецЦикла;
	Для Каждого СтрокаСостояния Из Состояние.Строки Цикл
		Состояние.ЕстьКонфликты = Состояние.ЕстьКонфликты Или СтрокаСостояния.ВидКонфликта <> "";
	КонецЦикла;
	Состояние.ЕстьКонфликты = Состояние.ЕстьКонфликты Или Состояние.КонфликтШапки <> "";
	Возврат Состояние;
КонецФункции

// Доступно к оформлению по строкам поступления (неоформленный остаток; черновик не проведён и в нём не учтён).
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки приходного ордера по неоформленному остатку.
//
Функция ОжиданиеПоступления(Поступление)
	Временный = Документы.ПриходныйОрдер.СоздатьДокумент();
	Документы.ПриходныйОрдер.ЗаполнитьПоДокументуИсточнику(Временный, Поступление);
	ПолучитьСообщенияПользователю(Истина);
	Ожидание = Временный.ТЧТовары.Выгрузить();
	Ожидание.Сортировать("КлючСтрокиДокумента");
	Возврат Ожидание;
КонецФункции

Процедура ЗаполнитьКонфликтСтроки(СтрокаСостояния, СтрокаЧерновика)
	Если СтрокаЧерновика.Номенклатура <> СтрокаСостояния.Номенклатура
		Или СтрокаЧерновика.Характеристика <> СтрокаСостояния.Характеристика
		Или СтрокаЧерновика.Серия <> СтрокаСостояния.Серия Тогда
		СтрокаСостояния.ВидКонфликта = "Заменен";
		СтрокаСостояния.Конфликт = НСтр("ru = 'Товар в строке поступления заменён'; fr = 'L''article de la ligne a été remplacé';
			|en = 'The item in the receipt row was replaced'; es = 'El artículo de la fila fue sustituido'");
	ИначеЕсли СтрокаЧерновика.Количество > СтрокаСостояния.Доступно Тогда
		Шаблон = НСтр("ru = 'Принято %1, доступно %2'; fr = 'Reçu %1, disponible %2'; en = 'Received %1, available %2';
			|es = 'Recibido %1, disponible %2'");
		СтрокаСостояния.ВидКонфликта = "Количество";
		СтрокаСостояния.Конфликт = СтрШаблон(Шаблон, СтрокаЧерновика.Количество, СтрокаСостояния.Доступно);
	Иначе
		СтрокаСостояния.ВидКонфликта = "";
	КонецЕсли;
КонецПроцедуры

// Шапка: организация, склад, поставщик, основание - как у поступления; поступление строго раньше приёмки.
//
// Параметры:
//  Черновик    - ДокументОбъект.ПриходныйОрдер - черновик приёмки.
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//
// Возвращаемое значение:
//  Строка - текст конфликта шапки; пустая - конфликта нет.
//
Функция КонфликтШапки(Черновик, Поступление)
	Шапка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Поступление, "Организация, Контрагент, МестоХранения, Основание, Дата");
	Основание = ?(Черновик.Метаданные().Реквизиты.Основание.Тип.СодержитТип(ТипЗнч(Шапка.Основание)), Шапка.Основание,
		Неопределено);
	ДругаяСторона = Шапка.Организация <> Черновик.Организация Или Шапка.Контрагент <> Черновик.Контрагент;
	ДругоеМесто = Шапка.МестоХранения <> Черновик.МестоХранения Или ЗначениеЗаполнено(Основание) И Основание <> Черновик.Основание;
	Если ДругаяСторона Или ДругоеМесто Тогда
		Возврат НСтр("ru = 'Шапка поступления изменилась: продолжите приёмку в обычной форме ордера';
			|fr = 'L''en-tête de la réception a changé : continuez dans le formulaire du bon';
			|en = 'The goods receipt header changed: continue in the regular order form';
			|es = 'La cabecera de la recepción cambió: continúe en el formulario de la orden'");
	ИначеЕсли Шапка.Дата >= Черновик.Дата Тогда
		Возврат ТекстКонфликтаДаты();
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

Функция СерийныеТовары(Ожидание)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Товары
	|ГДЕ
	|	Товары.Ссылка В (&Товары)
	|	И Товары.УчетПоСерийнымНомерам");
	Запрос.УстановитьПараметр("Товары", Ожидание.ВыгрузитьКолонку("Номенклатура"));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

#КонецОбласти

#Область Изменение

Функция НовыйОтвет()
	Ответ = Новый Структура("Результат, Сообщение, Состояние", "", "", Неопределено);
	Ответ.Вставить("Позиции", Новый Массив);
	Возврат Ответ;
КонецФункции

// Изменение черновика одной транзакцией под блокировкой поступления: версия черновика из формы совпадает с
// актуальной (первое изменение - выделенная ссылка не использована), изменение в пределах доступного, запись
// черновика; принятое обнулено - пометка удаления.
//
// Параметры:
//  Поступление      - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//  Версия           - Строка - версия черновика из формы.
//  ВыделеннаяСсылка - Строка - ссылка первого изменения.
//  Изменение        - Структура - Вид («Приращение», «Количество», «Привести»), Ключ, Количество.
//
// Возвращаемое значение:
//  Структура - см. Скан.
//
Функция ИзменитьЧерновик(Поступление, Версия, ВыделеннаяСсылка, Изменение)
	Ответ = НовыйОтвет();
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПоступление(Поступление);
		ПроверитьНазначение(Поступление);
		Состояние = СостояниеПоступления(Поступление);
		ВерсияПоступленияАктуальна = Не Изменение.ВерсияОбязательна И Не ЗначениеЗаполнено(Изменение.ВерсияПоступления)
			Или Изменение.ВерсияПоступления = Состояние.ВерсияПоступления;
		Если Не ВерсияАктуальна(Состояние, Версия, ВыделеннаяСсылка) Или Не ВерсияПоступленияАктуальна Тогда
			Ответ.Результат = "Устарело";
			Ответ.Сообщение = ТекстУстарело();
		Иначе
			Текст = ПрименитьИзменение(Состояние, Изменение);
			Если Текст = "" Тогда
				ЗаписатьЧерновик(Поступление, Состояние, ВыделеннаяСсылка);
				Ответ.Результат = "Принято";
			Иначе
				Ответ.Результат = "Отказ";
				Ответ.Сообщение = Текст;
			КонецЕсли;
		КонецЕсли;
		Ответ.Состояние = СостояниеПоступления(Поступление);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция ВерсияАктуальна(Состояние, Версия, ВыделеннаяСсылка)
	Если ЗначениеЗаполнено(Состояние.Черновик) Тогда
		Возврат Состояние.Версия = Версия;
	КонецЕсли;
	// Черновика нет: первое изменение - только с неиспользованной выделенной ссылкой и пустой версией.
	Возврат Версия = "" И ЗначениеЗаполнено(ВыделеннаяСсылка) И Не СсылкаИспользована(ВыделеннаяСсылка);
КонецФункции

Функция ПрименитьИзменение(Состояние, Изменение)
	Если Изменение.Вид = "Привести" Тогда
		Возврат ПривестиСостояние(Состояние);
	КонецЕсли;
	Если Состояние.ЕстьКонфликты Тогда
		Возврат НСтр("ru = 'Есть расхождения с поступлением: сначала приведите приёмку к поступлению';
			|fr = 'Des écarts existent : alignez d''abord la réception';
			|en = 'There are differences: align the receiving first';
			|es = 'Hay diferencias: ajuste primero la recepción'");
	КонецЕсли;
	Строка = Состояние.Строки.Найти(Изменение.Ключ, "Ключ");
	Если Строка = Неопределено Или Строка.НеПринимается Тогда
		Возврат ТекстНетВПоступлении();
	КонецЕсли;
	Новое = ?(Изменение.Вид = "Приращение", Строка.Принято + Изменение.Количество, Изменение.Количество);
	Если Новое < 0 Или Новое > Строка.Доступно Тогда
		Возврат НСтр("ru = 'Больше, чем доступно к приёмке'; fr = 'Plus que la quantité disponible';
			|en = 'More than available to receive'; es = 'Más de lo disponible para recibir'");
	КонецЕсли;
	Строка.Принято = Новое;
	Возврат "";
КонецФункции

Функция ПривестиСостояние(Состояние)
	Если Состояние.КонфликтШапки <> "" И Состояние.КонфликтШапки <> ТекстКонфликтаДаты() Тогда
		Возврат Состояние.КонфликтШапки;
	КонецЕсли;
	Для Каждого СтрокаСостояния Из Состояние.Строки Цикл
		Если СтрокаСостояния.ВидКонфликта = "Количество" Тогда
			СтрокаСостояния.Принято = Мин(СтрокаСостояния.Принято, СтрокаСостояния.Доступно);
		ИначеЕсли СтрокаСостояния.ВидКонфликта <> "" Тогда
			СтрокаСостояния.Принято = 0;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Процедура ЗаписатьЧерновик(Поступление, Состояние, ВыделеннаяСсылка)
	Если ЗначениеЗаполнено(Состояние.Черновик) Тогда
		Ордер = Состояние.Черновик.ПолучитьОбъект();
	Иначе
		Ордер = Документы.ПриходныйОрдер.СоздатьДокумент();
		Идентификатор = Новый УникальныйИдентификатор(ВыделеннаяСсылка);
		НоваяСсылка = Документы.ПриходныйОрдер.ПолучитьСсылку(Идентификатор);
		Ордер.УстановитьСсылкуНового(НоваяСсылка);
		Документы.ПриходныйОрдер.ЗаполнитьПоДокументуИсточнику(Ордер, Поступление);
		ПолучитьСообщенияПользователю(Истина);
		Ордер.Дата = ТекущаяДатаСеанса();
		Ордер.МобильнаяПриемка = Истина;
		Ордер.ПоступлениеПриемки = Поступление;
		Ордер.Ответственный = ПараметрыСеанса.Пользователь;
		ОтметитьСсылку(ВыделеннаяСсылка, Поступление);
	КонецЕсли;
	Строки = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("ДокументИсточник,КлючСтрокиДокумента,КодСтрокиЗаказа,Номенклатура,Характеристика,"
		+ "Серия,Упаковка,Количество", ",") Цикл
		Строки.Колонки.Добавить(Имя);
	КонецЦикла;
	Для Каждого Строка Из Состояние.Строки Цикл
		Если Строка.Принято > 0 Тогда
			Новая = Строки.Добавить();
			ЗаполнитьЗначенияСвойств(Новая, Строка, "Номенклатура, Характеристика, Серия, Упаковка, КодСтрокиЗаказа");
			Новая.ДокументИсточник = Поступление;
			Новая.КлючСтрокиДокумента = Строка.Ключ;
			Новая.Количество = Строка.Принято;
		КонецЕсли;
	КонецЦикла;
	Документы.ПриходныйОрдер.ЗагрузитьСтроки(Ордер, Строки);
	Если Состояние.КонфликтШапки = ТекстКонфликтаДаты() Тогда
		Ордер.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Ордер.ПометкаУдаления = Строки.Количество() = 0;
	Ордер.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

#КонецОбласти

#Область Скан

// Подбор строк скана под блокировкой поступления после проверки назначения.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//  Штрихкод    - Строка - отсканированное значение.
//
// Возвращаемое значение:
//  Структура - см. СтрокиСкана, плюс Состояние (см. НовоеСостояние).
//
Функция ПодборСкана(Поступление, Штрихкод)
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПоступление(Поступление);
		ПроверитьНазначение(Поступление);
		Подбор = СтрокиСкана(Поступление, Штрихкод);
		Подбор.Вставить("Состояние", СостояниеПоступления(Поступление));
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Подбор;
КонецФункции

// Дерево сопоставления скана: поиск со статусом, кандидаты - строки этой номенклатуры (характеристика и серия
// штрихкода, если заданы) с остатком не меньше единицы, группировка по позиции.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//  Штрихкод    - Строка - отсканированное значение.
//
// Возвращаемое значение:
//  Структура - Отказ (Строка, пустая - нет отказа), Позиции (Массив из Структура: Ключ, Представление).
//
Функция СтрокиСкана(Поступление, Штрихкод)
	Результат = Новый Структура("Отказ, Позиции", "", Новый Массив);
	Товар = ОбщегоНазначенияВызовСервера.НайденныйТоварПоШтрихкоду(Штрихкод);
	Если Товар.Статус = "НеНайден" Тогда
		Результат.Отказ = НСтр("ru = 'Штрихкод не найден'; fr = 'Code-barres introuvable'; en = 'Barcode not found';
			|es = 'Código de barras no encontrado'");
		Возврат Результат;
	КонецЕсли;
	Состояние = СостояниеПоступления(Поступление);
	Позиции = Новый Соответствие;
	Для Каждого СтрокаСостояния Из Состояние.Строки Цикл
		Если ПодходитДляСкана(СтрокаСостояния, Товар) Тогда
			ДобавитьПозицию(Позиции, СтрокаСостояния);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючИЗначение Из Позиции Цикл
		Результат.Позиции.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	Если Результат.Позиции.Количество() = 0 Тогда
		Результат.Отказ = ТекстНетВПоступлении();
	ИначеЕсли Товар.Статус = "Неоднозначен" И Результат.Позиции.Количество() = 1 Тогда
		// Неоднозначный штрихкод без выбора не принимается и при одной подходящей строке.
		Результат.Позиции.Добавить(Результат.Позиции[0]);
	Иначе
		// Позиции для приёма или выбора собраны.
		Возврат Результат;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПодходитДляСкана(СтрокаСостояния, Товар)
	Если СтрокаСостояния.Осталось < 1 Или СтрокаСостояния.НеПринимается Тогда
		Возврат Ложь;
	КонецЕсли;
	// Неоднозначный штрихкод: к ручному выбору - строки, совпавшие с любым товаром этого штрихкода.
	Для Каждого Совпадение Из Товар.Совпадения Цикл
		ТаЖеПозиция = СтрокаСостояния.Номенклатура = Совпадение.Номенклатура
			И (Не ЗначениеЗаполнено(Совпадение.Характеристика)
				Или СтрокаСостояния.Характеристика = Совпадение.Характеристика);
		Если ТаЖеПозиция И (Не ЗначениеЗаполнено(Совпадение.Серия) Или СтрокаСостояния.Серия = Совпадение.Серия) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция КлючСреди(Ключ, Позиции)
	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.Ключ = Ключ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ДобавитьПозицию(Позиции, СтрокаСостояния)
	КлючПозиции = Строка(СтрокаСостояния.Номенклатура.УникальныйИдентификатор()) + "|"
		+ Строка(СтрокаСостояния.Характеристика.УникальныйИдентификатор()) + "|"
		+ Строка(СтрокаСостояния.Серия.УникальныйИдентификатор());
	Если Позиции[КлючПозиции] <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Представление = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(СтрокаСостояния.Номенклатура,
		СтрокаСостояния.Характеристика, , Истина);
	Если ЗначениеЗаполнено(СтрокаСостояния.Серия) Тогда
		Представление = Представление + " / " + СтрокаСостояния.Серия;
	КонецЕсли;
	Позиции.Вставить(КлючПозиции, Новый Структура("Ключ, Представление", СтрокаСостояния.Ключ, Представление));
КонецПроцедуры

#КонецОбласти

#Область Черновики

Функция ЧерновикиПоступления(Поступления, Пользователь)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Ордера.Ссылка КАК Ссылка,
	|	Ордера.ПоступлениеПриемки КАК ПоступлениеПриемки,
	|	Ордера.Ответственный КАК Ответственный
	|ИЗ
	|	Документ.ПриходныйОрдер КАК Ордера
	|ГДЕ
	|	Ордера.МобильнаяПриемка
	|	И Ордера.ПоступлениеПриемки В (&Поступления)
	|	И НЕ Ордера.Проведен
	|	И НЕ Ордера.ПометкаУдаления
	|	И &УсловиеОтветственного");
	Запрос.УстановитьПараметр("Поступления", Поступления);
	Если Пользователь = Неопределено Тогда
		Запрос.УстановитьПараметр("УсловиеОтветственного", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтветственного", "Ордера.Ответственный = &Пользователь");
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
	КонецЕсли;
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Поступление приёмки записанной версии ордера (пустая ссылка - ордер новый или не был ордером приёмки).
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер - записываемый ордер.
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//
Функция СохраненноеПоступлениеПриемки(Ордер)
	Пустое = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();
	Если Ордер.ЭтоНовый() Тогда
		Возврат Пустое;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Сохраненные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ордер.Ссылка, "МобильнаяПриемка, ПоступлениеПриемки");
	Возврат ?(Сохраненные.МобильнаяПриемка, Сохраненные.ПоступлениеПриемки, Пустое);
КонецФункции

// Под блокировкой поступления: текущий пользователь - назначенный кладовщик или администратор.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление приёмки (пустое - не проверяется).
//  Тексты      - Массив из Строка - тексты отказа.
//
Процедура ПроверитьПользователяОрдера(Поступление, Тексты)
	Если Не ЗначениеЗаполнено(Поступление) Тогда
		Возврат;
	КонецЕсли;
	ЗаблокироватьПоступление(Поступление);
	Если Не ДопускКОрдеруПриемки(Поступление, ПараметрыСеанса.Пользователь,
		ПравоДоступа("Администрирование", Метаданные)) Тогда
		Тексты.Добавить(НСтр("ru = 'Ордер мобильной приёмки изменяет только назначенный кладовщик или администратор';
			|fr = 'Seul le magasinier affecté ou l''administrateur modifie le bon de réception mobile';
			|en = 'Only the assigned clerk or an administrator can change a mobile receiving order';
			|es = 'Solo el almacenero asignado o el administrador modifica la orden de recepción móvil'"));
	КонецЕсли;
КонецПроцедуры

Процедура СообщитьОтказ(Ордер, Тексты, Отказ)
	Для Каждого Текст Из Тексты Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Ордер, , , Отказ);
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьЧерновикВПоступлении(Ордер, Тексты)
	ЗаблокироватьПоступление(Ордер.ПоступлениеПриемки);
	УстановитьПривилегированныйРежим(Истина);
	Другие = ЧерновикиПоступления(Ордер.ПоступлениеПриемки, Ордер.Ответственный);
	Для Каждого Другой Из Другие Цикл
		Если Другой.Ссылка <> Ордер.Ссылка Тогда
			Тексты.Добавить(НСтр("ru = 'По поступлению уже есть незавершённая приёмка: проведите или отмените её';
				|fr = 'Une réception inachevée existe déjà : validez-la ou annulez-la';
				|en = 'An unfinished receiving already exists: post or cancel it';
				|es = 'Ya hay una recepción sin terminar: contabilícela o anúlela'"));
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Назначен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ордер.ПоступлениеПриемки, "ОтветственныйЗаПриемку");
	Если Назначен <> Ордер.Ответственный Тогда
		Тексты.Добавить(НСтр("ru = 'Поступление назначено другому кладовщику: верните назначение или выведите ордер из мобильной приёмки';
			|fr = 'La réception est affectée à un autre magasinier : rétablissez l''affectation ou sortez le bon de la réception mobile';
			|en = 'The goods receipt is assigned to another clerk: restore the assignment or remove the order from mobile receiving';
			|es = 'La recepción está asignada a otro almacenero: restaure la asignación o saque la orden de la recepción móvil'"));
	КонецЕсли;
КонецПроцедуры

Функция ДанныеОрдера(Ордер)
	Если Не ЗначениеЗаполнено(Ордер) Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ордер, "Ссылка, Проведен, ПометкаУдаления, ПоступлениеПриемки, ВерсияДанных");
	Возврат ?(Данные.Ссылка = Неопределено, Неопределено, Данные);
КонецФункции

Процедура ЗаблокироватьПоступление(Поступление)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Документ.ПоступлениеТоваровУслуг");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Поступление);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция СсылкаИспользована(ВыделеннаяСсылка)
	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИспользованныеСсылкиПриемки.СоздатьМенеджерЗаписи();
	Запись.Ссылка = ВыделеннаяСсылка;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Возврат Истина;
	КонецЕсли;
	Ордер = Документы.ПриходныйОрдер.ПолучитьСсылку(Новый УникальныйИдентификатор(ВыделеннаяСсылка));
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ордер, "Ссылка") <> Неопределено;
КонецФункции

Процедура ОтметитьСсылку(ВыделеннаяСсылка, Поступление)
	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИспользованныеСсылкиПриемки.СоздатьМенеджерЗаписи();
	Запись.Ссылка = ВыделеннаяСсылка;
	Запись.Поступление = Поступление;
	Запись.Пользователь = ПараметрыСеанса.Пользователь;
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.Записать();
КонецПроцедуры

