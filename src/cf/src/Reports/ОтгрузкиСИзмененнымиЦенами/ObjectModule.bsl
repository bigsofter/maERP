// Отгрузки с изменёнными ценами (docs/plans/retail-tools.md, п. 3): данные считает модуль менеджера, схема - внешний
// набор «Строки». Себестоимость видна только пользователю, которому видны суммы (КонтрольЦенПродажи.
// ПоказыватьСуммыПользователю); при неактуальной себестоимости над результатом - строка «пересчитана по …».

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецПериода = КонецДня(ТекущаяДатаСеанса());
	Элемент = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	Если Элемент <> Неопределено И Элемент.Использование И ТипЗнч(Элемент.Значение) = Тип("СтандартныйПериод") Тогда
		НачалоПериода = Элемент.Значение.ДатаНачала;
		Если ЗначениеЗаполнено(Элемент.Значение.ДатаОкончания) Тогда
			КонецПериода = Элемент.Значение.ДатаОкончания;
		КонецЕсли;
	КонецЕсли;
	Строки = Отчеты.ОтгрузкиСИзмененнымиЦенами.ДанныеОтчета(НачалоПериода, КонецПериода);
	ПоказыватьСебестоимость = КонтрольЦенПродажи.ПоказыватьСуммыПользователю();
	Если Не ПоказыватьСебестоимость Тогда
		УбратьПолеИзВыбора(Настройки, "Себестоимость");
	КонецЕсли;

	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, ДанныеРасшифровки);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, Новый Структура("Строки", Строки), ДанныеРасшифровки);

	ДокументРезультат.Очистить();
	Если ПоказыватьСебестоимость Тогда
		РаботаСДокументами.ВывестиСтрокуАктуальностиСебестоимости(ДокументРезультат);
	КонецЕсли;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(Процессор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УбратьПолеИзВыбора(Настройки, ИмяПоля)

	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Для Каждого Элемент Из Настройки.Выбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ВыбранноеПолеКомпоновкиДанных") И Элемент.Поле = Поле Тогда
			Элемент.Использование = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

