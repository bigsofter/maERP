// Отгрузки с изменёнными ценами (docs/plans/retail-tools.md, п. 3): строки проведённых реализаций, цена которых
// отличается от цены прайса на момент продажи. Цена прайса - та, что взяла бы касса (Справочники.МестаХранения.
// ЦеныНаМоменты), вид цены - исторический из строки (пустой - из шапки). Строки, которые сравнить нельзя, выводятся
// своими группами: без вида цены, без цены в прайсе, валюта, переоценка в секунду продажи.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Данные отчёта за период.
//
// Параметры:
//  НачалоПериода - Дата - начало периода.
//  КонецПериода  - Дата - конец периода.
//
// Возвращаемое значение:
//  ТаблицаЗначений - поля набора «Строки» схемы.
//
Функция ДанныеОтчета(НачалоПериода, КонецПериода) Экспорт

	Строки = СтрокиПродаж(НачалоПериода, КонецПериода);
	Результат = НоваяТаблицаРезультата();
	ДляЦен = Строки.СкопироватьКолонки("Ключ, Дата, ВидЦены, Номенклатура, Характеристика");
	Для Каждого Строка Из Строки Цикл
		Если ЗначениеЗаполнено(Строка.ВидЦены) Тогда
			ЗаполнитьЗначенияСвойств(ДляЦен.Добавить(), Строка);
		КонецЕсли;
	КонецЦикла;
	Цены = Справочники.МестаХранения.ЦеныНаМоменты(ДляЦен);
	Контекст = Новый Структура;
	Контекст.Вставить("Цены", Цены);
	Контекст.Вставить("СвойстваВидов", СвойстваВидовЦен(Цены));
	Контекст.Вставить("Основная", РаботаСВалютами.ОсновнаяВалюта());
	Контекст.Вставить("ПоказыватьСебестоимость", КонтрольЦенПродажи.ПоказыватьСуммыПользователю());
	Себестоимость = Новый Соответствие;
	Если Контекст.ПоказыватьСебестоимость Тогда
		Себестоимость = СебестоимостьЕдиниц(НачалоПериода, КонецПериода);
	КонецЕсли;
	Контекст.Вставить("Себестоимость", Себестоимость);
	Для Каждого Строка Из Строки Цикл
		ДобавитьСтрокуРезультата(Результат, Строка, Контекст);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Название группы строк с отклонением от цены прайса.
//
// Возвращаемое значение:
//  Строка - название.
//
Функция ГруппаОтклонение() Экспорт
	Возврат НСтр("ru = 'Цена отличается от прайса'; fr = 'Prix différent du tarif'; en = 'Price differs from the price list';
		|es = 'Precio distinto de la tarifa'");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строка отчёта по строке продажи: несравнимые - своей группой, совпадающие с прайсом - не выводятся.
//
// Параметры:
//  Результат - ТаблицаЗначений - строки отчёта, дополняется.
//  Строка    - СтрокаТаблицыЗначений - строка продажи, см. СтрокиПродаж.
//  Контекст  - Структура - Цены, Основная, ПоказыватьСебестоимость, Себестоимость.
//
Процедура ДобавитьСтрокуРезультата(Результат, Строка, Контекст)

	ЦенаПрайса = 0;
	НесколькоЦен = Ложь;
	Если Не ЗначениеЗаполнено(Строка.ВидЦены) Тогда
		Группа = ГруппаБезВидаЦены();
	Иначе
		Данные = Контекст.Цены[Строка.Ключ];
		Свойства = ?(Данные = Неопределено, Неопределено, Контекст.СвойстваВидов[Данные.ВидЦены]);
		Группа = ГруппаПоЦене(Строка, Данные, Свойства, Контекст.Основная);
		Если Группа = "" Тогда
			ЦенаПрайса = ЦенаВРежимеСтроки(Данные, Свойства, Строка);
			НесколькоЦен = Данные.НесколькоЦен;
			Если ЦенаПрайса = Строка.ЦенаПродажи Тогда
				Возврат;
			КонецЕсли;
			Группа = ГруппаОтклонение();
		КонецЕсли;
	КонецЕсли;
	НоваяСтрока = Результат.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	НоваяСтрока.Группа = Группа;
	НоваяСтрока.ЦенаПрайса = ЦенаПрайса;
	НоваяСтрока.НесколькоЦен = НесколькоЦен;
	Если Группа = ГруппаОтклонение() И ЦенаПрайса <> 0 Тогда
		НоваяСтрока.Отклонение = Строка.ЦенаПродажи - ЦенаПрайса;
		НоваяСтрока.ОтклонениеПроцент = Окр(НоваяСтрока.Отклонение / ЦенаПрайса * Сто(), 1);
	ИначеЕсли Группа = ГруппаОтклонение() Тогда
		НоваяСтрока.Отклонение = Строка.ЦенаПродажи;
	Иначе
		// Несравнимая строка: отклонение не считается.
		НоваяСтрока.Отклонение = 0;
	КонецЕсли;
	Если Контекст.ПоказыватьСебестоимость Тогда
		НоваяСтрока.Себестоимость = Контекст.Себестоимость[КлючСебестоимости(Строка.Реализация, Строка.Номенклатура,
			Строка.Характеристика)];
	КонецЕсли;

КонецПроцедуры

Функция Сто()
	Возврат 100;
КонецФункции

Функция СтрокиПродаж(НачалоПериода, КонецПериода)

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Продажи.Ссылка КАК Реализация,
	|	Продажи.Дата КАК Дата,
	|	Продажи.МестоХранения КАК Склад,
	|	Продажи.Контрагент КАК Контрагент,
	|	Продажи.Валюта КАК Валюта,
	|	Продажи.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Продажи.КассоваяСмена <> ЗНАЧЕНИЕ(Документ.КассоваяСмена.ПустаяСсылка) КАК Кассовая,
	|	ВЫБОР
	|		КОГДА Товары.ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|			ТОГДА Продажи.ВидЦен
	|		ИНАЧЕ Товары.ВидЦены
	|	КОНЕЦ КАК ВидЦены,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество,
	|	Товары.КодСтроки КАК КодСтроки,
	|	ВЫБОР
	|		КОГДА Товары.ЦенаSKU <> 0
	|			ТОГДА Товары.ЦенаSKU
	|		ИНАЧЕ Товары.Цена
	|	КОНЕЦ КАК ЦенаПродажи,
	|	Товары.СуммаСкидки КАК СуммаСкидки,
	|	ЕСТЬNULL(Ставки.Ставка, 0) КАК СтавкаНДС
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Продажи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ТЧТовары КАК Товары
	|		ПО Продажи.Ссылка = Товары.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтавкиНДС КАК Ставки
	|		ПО Товары.СтавкаНДС = Ставки.Ссылка
	|ГДЕ
	|	Продажи.Проведен
	|	И Продажи.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	Продажи.Дата,
	|	Продажи.Ссылка,
	|	Товары.НомерСтроки");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Строки = Запрос.Выполнить().Выгрузить();
	Строки.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Число"));
	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		Строки[Индекс].Ключ = Индекс + 1;
	КонецЦикла;
	Возврат Строки;

КонецФункции

Функция НоваяТаблицаРезультата()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Реализация", Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
	Таблица.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
	Таблица.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Таблица.Колонки.Добавить("ВидЦены", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	Для Каждого Имя Из СтрРазделить("КодСтроки,Количество,ЦенаПродажи,ЦенаПрайса,Отклонение,ОтклонениеПроцент,СуммаСкидки,"
		+ "Себестоимость", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Число"));
	КонецЦикла;
	Таблица.Колонки.Добавить("НесколькоЦен", Новый ОписаниеТипов("Булево"));
	Возврат Таблица;

КонецФункции

// Группа строки, которую нельзя сравнить, или пустая строка - сравнивается.
//
// Параметры:
//  Строка   - СтрокаТаблицыЗначений - строка продажи.
//  Данные   - Структура, Неопределено - цена строки, см. Справочники.МестаХранения.ЦеныНаМоменты.
//  Свойства - Структура, Неопределено - Валюта, ЦенаВключаетНДС вида найденной цены (см. СвойстваВидовЦен).
//  Основная - СправочникСсылка.Валюты - основная валюта.
//
// Возвращаемое значение:
//  Строка - название группы или пустая строка.
//
Функция ГруппаПоЦене(Строка, Данные, Свойства, Основная)

	Если Данные = Неопределено Тогда
		Возврат НСтр("ru = 'Нет цены в прайсе'; fr = 'Pas de prix au tarif'; en = 'No price in the price list';
			|es = 'Sin precio en la tarifa'");
	ИначеЕсли Данные.ПереоценкаВСекунду Тогда
		Возврат НСтр("ru = 'Переоценка в секунду продажи'; fr = 'Changement de prix à la seconde de la vente';
			|en = 'Repricing in the second of the sale'; es = 'Cambio de precio en el segundo de la venta'");
	Иначе
		// Цена найдена: остаётся проверить валюту.
		Валюта = Свойства.Валюта;
	КонецЕсли;
	ВалютаЦены = ?(ЗначениеЗаполнено(Валюта), Валюта, Основная);
	ВалютаДокумента = ?(ЗначениеЗаполнено(Строка.Валюта), Строка.Валюта, Основная);
	Если ВалютаЦены <> ВалютаДокумента Тогда
		Возврат НСтр("ru = 'Не сравнивается: валюта'; fr = 'Non comparé : devise'; en = 'Not compared: currency';
			|es = 'No se compara: moneda'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Цена прайса в режиме НДС строки. Кассовая реализация берёт цену вида как цену с НДС независимо от признака вида
// (правило кассы, Справочники.МестаХранения.ВидЦеныДопустимДляСклада).
//
// Параметры:
//  Данные   - Структура - цена строки, см. Справочники.МестаХранения.ЦеныНаМоменты.
//  Свойства - Структура - Валюта, ЦенаВключаетНДС вида найденной цены.
//  Строка   - СтрокаТаблицыЗначений - строка продажи.
//
// Возвращаемое значение:
//  Число - цена прайса в режиме НДС строки.
//
Функция ЦенаВРежимеСтроки(Данные, Свойства, Строка)

	ЦенаСНДС = Строка.Кассовая Или Свойства.ЦенаВключаетНДС = Истина;
	Множитель = 1 + Строка.СтавкаНДС / Сто();
	Цена = Данные.Цена;
	Если ЦенаСНДС И Не Строка.ЦенаВключаетНДС Тогда
		Цена = Цена / Множитель;
	ИначеЕсли Не ЦенаСНДС И Строка.ЦенаВключаетНДС Тогда
		Цена = Цена * Множитель;
	Иначе
		// Режимы совпадают: цена как есть.
		Цена = Данные.Цена;
	КонецЕсли;
	Возврат ОкругленнаяСумма(Цена);

КонецФункции

// Валюта и признак «цена включает НДС» видов найденных цен - одним запросом.
//
// Параметры:
//  Цены - Соответствие - см. Справочники.МестаХранения.ЦеныНаМоменты.
//
// Возвращаемое значение:
//  Соответствие - вид цены -> Структура (Валюта, ЦенаВключаетНДС).
//
Функция СвойстваВидовЦен(Цены)
	Виды = Новый Массив;
	Для Каждого КлючИЗначение Из Цены Цикл
		Если Виды.Найти(КлючИЗначение.Значение.ВидЦены) = Неопределено Тогда
			Виды.Добавить(КлючИЗначение.Значение.ВидЦены);
		КонецЕсли;
	КонецЦикла;
	Если Виды.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Виды, "Валюта, ЦенаВключаетНДС");
КонецФункции

Функция ГруппаБезВидаЦены()
	Возврат НСтр("ru = 'Вид цены не задан'; fr = 'Type de prix non défini'; en = 'Price type not set';
		|es = 'Tipo de precio no definido'");
КонецФункции

// Себестоимость единицы - действующим механизмом себестоимости продаж: (себестоимость + дополнительные расходы) /
// количество по документу продажи, номенклатуре и характеристике (средняя по документу).
//
// Параметры:
//  НачалоПериода - Дата - начало периода.
//  КонецПериода  - Дата - конец периода.
//
// Возвращаемое значение:
//  Соответствие - ключ (см. КлючСебестоимости) -> себестоимость единицы.
//
Функция СебестоимостьЕдиниц(НачалоПериода, КонецПериода)

	ТекстСебестоимости = РегистрыНакопления.СебестоимостьПродаж.ТекстПродажССебестоимостью();
	Запрос = Новый Запрос(ТекстСебестоимости + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Продажи.ДокументПродажи КАК ДокументПродажи,
	|	Продажи.Номенклатура КАК Номенклатура,
	|	Продажи.Характеристика КАК Характеристика,
	|	СУММА(Продажи.Количество) КАК Количество,
	|	СУММА(Продажи.Себестоимость + Продажи.ДополнительныеРасходы) КАК Себестоимость
	|ИЗ
	|	ВТПродажиССебестоимостью КАК Продажи
	|
	|СГРУППИРОВАТЬ ПО
	|	Продажи.ДокументПродажи,
	|	Продажи.Номенклатура,
	|	Продажи.Характеристика");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество <> 0 Тогда
			Результат.Вставить(КлючСебестоимости(Выборка.ДокументПродажи, Выборка.Номенклатура, Выборка.Характеристика),
				ОкругленнаяСумма(Выборка.Себестоимость / Выборка.Количество));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОкругленнаяСумма(Сумма)
	ЗнаковКопеек = 2;
	Возврат Окр(Сумма, ЗнаковКопеек);
КонецФункции

Функция КлючСебестоимости(Документ, Номенклатура, Характеристика)
	Возврат Строка(Документ.УникальныйИдентификатор()) + "|" + Строка(Номенклатура.УникальныйИдентификатор()) + "|"
		+ Строка(Характеристика.УникальныйИдентификатор());
КонецФункции

#КонецОбласти

#КонецЕсли
