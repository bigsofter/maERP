		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПродажиОбороты.Период КАК Период,
	ПродажиОбороты.Регистратор КАК Регистратор,
	ПродажиОбороты.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	ПродажиОбороты.Контрагент КАК Контрагент,
	ПродажиОбороты.ДокументПродажи КАК ДокументПродажи,
	ПродажиОбороты.Номенклатура КАК Номенклатура,
	СУММА(ПродажиОбороты.КоличествоОборот) КАК Количество,
	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Сумма,
	0 КАК Оплата,
	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Остаток,
	ВЫБОР
		КОГДА ПродажиОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
			ТОГДА 1
		ИНАЧЕ 2
	КОНЕЦ КАК порядок,
	НАЧАЛОПЕРИОДА(ПродажиОбороты.ДокументПродажи.Дата, ДЕНЬ) КАК ДатаПродажи
ПОМЕСТИТЬ VT
ИЗ
	РегистрНакопления.Продажи.Обороты(, , Запись, ) КАК ПродажиОбороты

СГРУППИРОВАТЬ ПО
	ПродажиОбороты.Контрагент,
	ПродажиОбороты.Номенклатура,
	ПродажиОбороты.ДокументПродажи,
	ПродажиОбороты.ХозяйственнаяОперация,
	ПродажиОбороты.Период,
	ПродажиОбороты.Регистратор,
	НАЧАЛОПЕРИОДА(ПродажиОбороты.ДокументПродажи.Дата, ДЕНЬ)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВзаиморасчётыСПокупателями.Период,
	ВзаиморасчётыСПокупателями.Регистратор,
	ВЫБОР
		КОГДА ВзаиморасчётыСПокупателями.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			ТОГДА "Paiement reçu"
		ИНАЧЕ "Paiement remboursé"
	КОНЕЦ,
	ВзаиморасчётыСПокупателями.Контрагент,
	ВзаиморасчётыСПокупателями.ОбъектРасчётов,
	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	0,
	0,
	ВЫБОР
		КОГДА ВзаиморасчётыСПокупателями.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			ТОГДА 1
		ИНАЧЕ -1
	КОНЕЦ * ВзаиморасчётыСПокупателями.Сумма,
	-ВЫБОР
		КОГДА ВзаиморасчётыСПокупателями.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			ТОГДА 1
		ИНАЧЕ -1
	КОНЕЦ * ВзаиморасчётыСПокупателями.Сумма,
	3,
	НАЧАЛОПЕРИОДА(ВзаиморасчётыСПокупателями.ОбъектРасчётов.Дата, ДЕНЬ)
ИЗ
	РегистрНакопления.ВзаиморасчётыСПокупателями КАК ВзаиморасчётыСПокупателями
ГДЕ
	НЕ ВзаиморасчётыСПокупателями.ОбъектРасчётов = ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)
	И ВзаиморасчётыСПокупателями.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)

СГРУППИРОВАТЬ ПО
	ВзаиморасчётыСПокупателями.ОбъектРасчётов,
	ВзаиморасчётыСПокупателями.Период,
	ВзаиморасчётыСПокупателями.Регистратор,
	ВзаиморасчётыСПокупателями.Сумма,
	ВзаиморасчётыСПокупателями.Контрагент,
	ВзаиморасчётыСПокупателями.ВидДвижения,
	НАЧАЛОПЕРИОДА(ВзаиморасчётыСПокупателями.ОбъектРасчётов.Дата, ДЕНЬ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	VT.Период КАК Период,
	VT.Регистратор КАК Регистратор,
	VT.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	VT.Контрагент КАК Контрагент,
	VT.ДокументПродажи КАК ДокументПродажи,
	VT.Номенклатура КАК Номенклатура,
	VT.Количество КАК Количество,
	VT.Сумма КАК Сумма,
	VT.Оплата КАК Оплата,
	VT.Остаток КАК Остаток,
	VT.порядок КАК порядок,
	VT.ДатаПродажи КАК ДатаПродажи
ИЗ
	VT КАК VT
{ГДЕ
	VT.ДатаПродажи МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания}</query>
	</dataSet>
