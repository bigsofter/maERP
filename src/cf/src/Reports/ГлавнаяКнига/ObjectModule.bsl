#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();

	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;

	СхемаКомпоновкиДанных = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);

	ДокументРезультат.Очистить();

	// Логотип и реквизиты организации в шапке отчёта
	МакетЛоготип = ПолучитьМакет("ЛоготипКомпании");
	Область = МакетЛоготип.ПолучитьОбласть("Шапка");
	Организация = Настройки.ПараметрыДанных.Элементы.Найти(Новый ПараметрКомпоновкиДанных("Организация")).Значение;
	Контрагент = ЗначениеОтбораРавно(Настройки, "Контрагент");
	КарточкаОрганизации = Справочники.Контрагенты.ПолучитьКарточку(Организация, ТекущаяДатаСеанса());
	Область.Параметры.Организация = Организация;
	Область.Параметры.Адрес = КарточкаОрганизации.АдресЮридический;
	Область.Параметры.Контрагент = Контрагент;

	ДокументРезультат.НачатьАвтогруппировкуСтрок();
	ДокументРезультат.Вывести(Область, 1);
	ДокументРезультат.ЗакончитьАвтогруппировкуСтрок();

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеОтбораРавно(Настройки, ИмяПоля)
	// Значение отбора «поле = значение» из настроек компоновки; Неопределено, если отбор не задан.
	Для Каждого Элемент Из Настройки.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) <> Тип("ЭлементОтбораКомпоновкиДанных") Или Не Элемент.Использование Тогда
			Продолжить;
		КонецЕсли;
		Если Строка(Элемент.ЛевоеЗначение) = ИмяПоля И Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
			Возврат Элемент.ПравоеЗначение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

#КонецОбласти
