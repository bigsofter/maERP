
Функция ПолучитьСрокОплатыДляОтчета(Контрагент, ДатаОтсчета) Экспорт
	// Долг без документа с датой (перенос истории, ввод остатков) - срока нет.
	Если ТипЗнч(ДатаОтсчета) <> Тип("Дата") Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	СрокОплаты = РаботаСДокументами.ПолучитьСрокОплаты(Контрагент,ДатаОтсчета);
	Если НачалоДня(СрокОплаты) < НачалоДня(ТекущаяДата()) Тогда 
		СрокОплаты = Дата(1,1,1);
	КонецЕсли;
	Возврат СрокОплаты;
КонецФункции
