		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫБОР
		КОГДА ТоварыВНаличииОстаткиИОбороты.Регистратор = НЕОПРЕДЕЛЕНО
			ТОГДА NULL
		ИНАЧЕ ТоварыВНаличииОстаткиИОбороты.Регистратор
	КОНЕЦ КАК Регистратор,
	ТИПЗНАЧЕНИЯ(ТоварыВНаличииОстаткиИОбороты.Регистратор) КАК ТипДокумента,
	ТоварыВНаличииОстаткиИОбороты.МестоХранения КАК МестоХранения,
	ТоварыВНаличииОстаткиИОбороты.Номенклатура КАК Номенклатура,
	ТоварыВНаличииОстаткиИОбороты.Характеристика КАК Характеристика,
	ТоварыВНаличииОстаткиИОбороты.Номенклатура.Единица КАК Единица,
	ТоварыВНаличииОстаткиИОбороты.Номенклатура.Артикул КАК Артикул,
	ТоварыВНаличииОстаткиИОбороты.Серия КАК Серия,
	ТоварыВНаличииОстаткиИОбороты.Партия КАК Партия,
	ТоварыВНаличииОстаткиИОбороты.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
	ТоварыВНаличииОстаткиИОбороты.КоличествоПриход КАК КоличествоПриход,
	ТоварыВНаличииОстаткиИОбороты.КоличествоРасход КАК КоличествоРасход,
	ТоварыВНаличииОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток,
