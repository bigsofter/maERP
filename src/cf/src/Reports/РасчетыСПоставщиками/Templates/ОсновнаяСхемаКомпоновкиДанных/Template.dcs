			<field>ДокументДвижения</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВсП.Организация КАК Организация,
	ВсП.Контрагент КАК Контрагент,
	ВсП.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	ВсП.СуммаПриход КАК СуммаПриход,
	ВсП.СуммаРасход КАК СуммаРасход,
	ВсП.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
	ВЫБОР
		КОГДА ВсП.Регистратор = НЕОПРЕДЕЛЕНО
			ТОГДА NULL
		ИНАЧЕ ВсП.Регистратор
	КОНЕЦ КАК Регистратор,
	ВсП.ПериодСекунда КАК ПериодСекунда,
	ВсП.ПериодДень КАК ПериодДень,
	ВсП.ПериодМесяц КАК ПериодМесяц,
	ВсП.ПериодКвартал КАК ПериодКвартал,
	ВсП.ПериодГод КАК ПериодГод,
	ЕСТЬNULL(ВзаиморасчётыСПоcтавщикамиНалоговый.ВидОперации, ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНалоговые.ПустаяСсылка)) КАК ВидОперации,
	ЕСТЬNULL(ВзаиморасчётыСПоcтавщикамиНалоговый.Описание, """") КАК Описание,
	ВзаиморасчётыСПоcтавщикамиНалоговый.ДокументДвижения КАК ДокументДвижения
ИЗ
	РегистрНакопления.ВзаиморасчётыСПоcтавщикамиНалоговый.ОстаткиИОбороты(
			,
			,
			Авто,
			,
			Организация = &amp;Организация) КАК ВсП
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчётыСПоcтавщикамиНалоговый КАК ВзаиморасчётыСПоcтавщикамиНалоговый
		ПО ВсП.Регистратор = ВзаиморасчётыСПоcтавщикамиНалоговый.Регистратор
			И ВсП.НомерСтроки = ВзаиморасчётыСПоcтавщикамиНалоговый.НомерСтроки</query>
	</dataSet>
