		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаПартии</dataPath>
			<field>ДатаПартии</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	НалоговаяНакладнаяТЧТовары.Номенклатура КАК Номенклатура,
	НалоговаяНакладнаяТЧТовары.Количество КАК Количество,
	НалоговаяНакладнаяТЧТовары.Ссылка КАК Ссылка,
	НалоговаяНакладнаяТЧТовары.Ссылка.Контрагент КАК Контрагент,
	ЕстьNull(ТоварыВНаличииОстатки.КоличествоОстаток,0) КАК КоличествоОстаток
ИЗ
	Документ.НалоговаяНакладная.ТЧТовары КАК НалоговаяНакладнаяТЧТовары
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВНаличии.Остатки КАК ТоварыВНаличииОстатки
		ПО НалоговаяНакладнаяТЧТовары.Номенклатура = ТоварыВНаличииОстатки.Номенклатура
			И НалоговаяНакладнаяТЧТовары.Характеристика = ТоварыВНаличииОстатки.Характеристика
			И НалоговаяНакладнаяТЧТовары.Ссылка.МестоХранения = ТоварыВНаличииОстатки.МестоХранения
ГДЕ
	НЕ НалоговаяНакладнаяТЧТовары.Ссылка.Проведен
	И НЕ НалоговаяНакладнаяТЧТовары.Ссылка.ПометкаУдаления</query>
	</dataSet>
