			<dataSource>ИсточникДанных1</dataSource>
			<query>// Текст запроса формируется в модуле менеджера ТекстЗапросаДляОсобенныхСчетов()
// см также процедуру ШаблонЗапроса в модуле менеджера

ВЫБРАТЬ
    NULL КАК Счет,
    NULL КАК Период,
    NULL КАК Субконто1,
    NULL КАК Субконто2,
    NULL КАК Субконто3,
    NULL КАК Валюта,
    NULL КАК Организация,
    "" КАК Субконто1Представление,
    "" КАК Субконто2Представление,
    "" КАК Субконто3Представление,
    "" КАК ВалютаПредставление,
    "" КАК ОрганизацияПредставление,
    0 КАК БУНачальныйОстатокДт,
    0 КАК БУКонечныйОстатокДт,
    0 КАК БУКонечныйОстатокКт,
    0 КАК БУОборотДт,
    0 КАК БУОборотКт,
    0 КАК БУНачальныйОстатокКт,
    0 КАК НУНачальныйОстатокДт,
    0 КАК БУНачальныйРазвернутыйОстатокДт,
    0 КАК БУНачальныйРазвернутыйОстатокКт,
    0 КАК БУКонечныйРазвернутыйОстатокДт,
    0 КАК БУКонечныйРазвернутыйОстатокКт,
    0 КАК ВалНачальныйОстатокДт,
    0 КАК ВалНачальныйОстатокКт,
    0 КАК ВалНачальныйРазвернутыйОстатокДт,
    0 КАК ВалНачальныйРазвернутыйОстатокКт,
    0 КАК ВалКонечныйОстатокДт,
    0 КАК ВалКонечныйОстатокКт,
    0 КАК ВалОборотДт,
    0 КАК ВалОборотКт,
    0 КАК ВалКонечныйРазвернутыйОстатокДт,
    0 КАК ВалКонечныйРазвернутыйОстатокКт,
    0 КАК КолНачальныйОстатокДт,
    0 КАК КолНачальныйОстатокКт,
    0 КАК КолНачальныйРазвернутыйОстатокДт,
    0 КАК КолНачальныйРазвернутыйОстатокКт,
    0 КАК КолКонечныйОстатокДт,
    0 КАК КолКонечныйОстатокКт,
    0 КАК КолОборотДт,
    0 КАК КолОборотКт,
    0 КАК КолКонечныйРазвернутыйОстатокДт,
    0 КАК КолКонечныйРазвернутыйОстатокКт
  
{ВЫБРАТЬ
    Счет.*,
    Период,
    Субконто1.*,
    Субконто2.*,
    Субконто3.*,
    Организация.*,
    Валюта.*,
    Субконто1Представление,
    Субконто2Представление,
    Субконто3Представление,
    ВалютаПредставление,
    ОрганизацияПредставление,
    БУНачальныйОстатокДт,
    БУНачальныйОстатокКт,
    БУКонечныйОстатокДт,
    БУКонечныйОстатокКт,
    БУОборотДт,
    БУОборотКт,
    БУНачальныйРазвернутыйОстатокДт,
    БУНачальныйРазвернутыйОстатокКт,
    БУКонечныйРазвернутыйОстатокДт,
    БУКонечныйРазвернутыйОстатокКт,
    ВалНачальныйОстатокДт,
    ВалНачальныйОстатокКт,
    ВалНачальныйРазвернутыйОстатокДт,
    ВалНачальныйРазвернутыйОстатокКт,
    ВалКонечныйОстатокДт,
    ВалКонечныйОстатокКт,
    ВалОборотДт,
    ВалОборотКт,
    ВалКонечныйРазвернутыйОстатокДт,
    ВалКонечныйРазвернутыйОстатокКт,
    КолНачальныйОстатокДт,
    КолНачальныйОстатокКт,
    КолНачальныйРазвернутыйОстатокДт,
    КолНачальныйРазвернутыйОстатокКт,
    КолКонечныйОстатокДт,
    КолКонечныйОстатокКт,
    КолОборотДт,
    КолОборотКт,
    КолКонечныйРазвернутыйОстатокДт,
    КолКонечныйРазвернутыйОстатокКт}</query>
