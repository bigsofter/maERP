	</calculatedField>
	<totalField>
		<dataPath>Выручка</dataPath>
		<expression>Сумма(Выручка)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоВНакладных</dataPath>
		<expression>Сумма(КоличествоВНакладных)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоПродано</dataPath>
		<expression>Сумма(КоличествоПродано)</expression>
	</totalField>
	<totalField>
		<dataPath>Себестоимость</dataPath>
		<expression>Выбор когда Сумма(КоличествоПродано) = 0 тогда Сумма(Себестоимость) иначе Сумма(Себестоимость) /Сумма(КоличествоПродано) конец</expression>
	</totalField>
	<totalField>
		<dataPath>ПроданоНеВНакладной</dataPath>
		<expression>Сумма(КоличествоПродано)-Сумма(КоличествоВНакладных)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоОстатокБух</dataPath>
		<expression>Минимум(КоличествоОстатокБух)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоОстатокОбщийСклад</dataPath>
		<expression>Минимум(КоличествоОстатокОбщийСклад)</expression>
	</totalField>
