		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОстаткиИОбороты.Контрагент КАК Контрагент,
	ОстаткиИОбороты.Номенклатура КАК Номенклатура,
	ОстаткиИОбороты.Характеристика КАК Характеристика,
	ОстаткиИОбороты.Серия КАК Серия,
	ОстаткиИОбороты.Партия КАК Партия,
	ОстаткиИОбороты.ПередачаВПереработку КАК ПередачаВПереработку,
	ОстаткиИОбороты.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
	ОстаткиИОбороты.КоличествоПриход КАК КоличествоПриход,
	ОстаткиИОбороты.КоличествоРасход КАК КоличествоРасход,
	ОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток,
	ОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	ОстаткиИОбороты.СуммаПриход КАК СуммаПриход,
	ОстаткиИОбороты.СуммаРасход КАК СуммаРасход,
	ОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
ИЗ
	РегистрНакопления.ТоварыВПереработке.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, Авто, ДвиженияИГраницыПериода, ) КАК ОстаткиИОбороты</query>
	</dataSet>
