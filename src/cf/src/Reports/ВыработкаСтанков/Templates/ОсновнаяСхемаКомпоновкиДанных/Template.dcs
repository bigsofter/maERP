	<totalField>
		<dataPath>Кг</dataPath>
		<expression>Сумма(Кг)</expression>
	</totalField>
	<totalField>
		<dataPath>Выпущено</dataPath>
		<expression>Сумма(Выпущено)</expression>
	</totalField>
	<totalField>
		<dataPath>Часы</dataPath>
		<expression>Сумма(Часы)</expression>
	</totalField>
	<totalField>
		<dataPath>НормаЧасов</dataPath>
		<expression>Сумма(НормаЧасов)</expression>
	</totalField>
	<totalField>
		<dataPath>Отклонение</dataPath>
		<expression>Сумма(Часы) - Сумма(НормаЧасов)</expression>
	</totalField>
	<totalField>
		<dataPath>КгВЧас</dataPath>
		<expression>Выбор Когда Сумма(Часы) &gt; 0 Тогда Окр(Сумма(Кг) / Сумма(Часы), 1) Иначе 0 Конец</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентНормы</dataPath>
		<expression>Выбор Когда Сумма(Часы) &gt; 0 Тогда Окр(Сумма(НормаЧасов) * 100 / Сумма(Часы), 1) Иначе 0 Конец</expression>
	</totalField>
