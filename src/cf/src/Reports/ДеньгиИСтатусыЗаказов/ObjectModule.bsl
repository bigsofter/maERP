	|				И З.ПлановаяОтгрузка < &КонецПериода
	|				И ЕСТЬNULL(Исп.КоличествоОтгружено, 0) < ЕСТЬNULL(Исп.КоличествоЗаказано, 0)
	|			ТОГДА РАЗНОСТЬДАТ(З.ПлановаяОтгрузка, &КонецПериода, ДЕНЬ)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПросрочкаОтгрузки
	|ИЗ
	|	ВТ_Заказы КАК З
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Деньги КАК Д
	|		ПО З.Заказ = Д.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Продажи КАК П
	|		ПО З.Заказ = П.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Исполнение КАК Исп
	|		ПО З.Заказ = Исп.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДолгиЗаказчиков КАК ДЗ
	|		ПО З.Заказчик = ДЗ.Заказчик
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДолгиПоЗаказам КАК ДПЗ
	|		ПО З.Заказчик = ДПЗ.Заказчик
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Статусы КАК Ст
	|		ПО З.Заказ = Ст.Заказ
	|ГДЕ
	|	ВЫБОР
	|			КОГДА З.Дата >= &НачалоПериода
	|				ТОГДА ИСТИНА
	|			КОГДА ЕСТЬNULL(Исп.Выполнен, 1) = 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЕСТЬNULL(Д.ОтгруженоРасчеты, 0) - ЕСТЬNULL(Д.Оплачено, 0) - ЕСТЬNULL(Д.Корректировки, 0) <> 0
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказчик,
	|	Дата";

