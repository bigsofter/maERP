	|				ТОГДА 0
	|			КОГДА ЕСТЬNULL(Исп.Реализовано, 0) > П.Заказано
	|				ТОГДА П.Заказано
	|			ИНАЧЕ ЕСТЬNULL(Исп.Реализовано, 0)
	|		КОНЕЦ) КАК КоличествоРеализовано,
