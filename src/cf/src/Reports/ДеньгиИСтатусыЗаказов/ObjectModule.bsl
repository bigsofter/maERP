// Деньги и статусы заказов клиентов (план docs/plans/order-money-status.md). Показатели заказа считает пакет запросов
// модуля по регистрам, результат - внешний набор данных «Заказы» схемы компоновки: группировки, варианты, отборы и
// итоги остаются за схемой. Ключевые правила: «заказ реализации» (прямая ссылка, иначе единственная обратная),
// налоговый документ - объект заказа, только если все его основания ведут в один заказ; деньги - в основной валюте
// из регистров; отгрузка и реализация - по позициям с ограничением [0; заказано].

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрыОтчета = ПараметрыОтчета(Настройки);

	ВнешниеНаборы = Новый Структура("Заказы", ДанныеЗаказов(ПараметрыОтчета));
	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, ДанныеРасшифровки);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, ВнешниеНаборы, ДанныеРасшифровки);

	ДокументРезультат.Очистить();
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(Процессор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыОтчета(Настройки)

	Результат = Новый Структура("НачалоПериода, КонецПериода");
	Результат.НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	Результат.КонецПериода = КонецДня(ТекущаяДатаСеанса());
	Элемент = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	Если Элемент <> Неопределено И Элемент.Использование И ТипЗнч(Элемент.Значение) = Тип("СтандартныйПериод") Тогда
		Результат.НачалоПериода = Элемент.Значение.ДатаНачала;
		Если ЗначениеЗаполнено(Элемент.Значение.ДатаОкончания) Тогда
			Результат.КонецПериода = Элемент.Значение.ДатаОкончания;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Показатели заказов на конец периода - строка на заказ.
//
// Параметры:
//  ПараметрыОтчета - Структура - НачалоПериода, КонецПериода.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки внешнего набора «Заказы» схемы компоновки.
//
Функция ДанныеЗаказов(ПараметрыОтчета) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЗаказов();
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыОтчета.КонецПериода);
	Запрос.УстановитьПараметр("ГраницаКонца", Новый Граница(ПараметрыОтчета.КонецПериода, ВидГраницы.Включая));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Текст пакета: правила - docs/plans/order-money-status.md, «Показатели».
//
// Возвращаемое значение:
//  Строка - текст пакета; последний запрос - строка на заказ.
//
// BSLLS:MethodSize-off - текст пакета запросов отчёта: одна функция, чтобы пакет читался целиком.
// BSLLS:QueryNestedFieldsByDot-off - реквизиты документов и номенклатуры в связях заказа, объёмы малы.
Функция ТекстЗапросаЗаказов()

	Возврат
	"ВЫБРАТЬ
	|	З.Ссылка КАК Заказ,
	|	З.Дата КАК Дата,
	|	З.Контрагент КАК Заказчик,
	|	З.Менеджер КАК Менеджер,
	|	З.ДатаОтгрузки КАК ПлановаяОтгрузка,
	|	ВЫБОР
	|		КОГДА З.ВВалюте
	|			ТОГДА З.СуммаРегл
	|		ИНАЧЕ З.Сумма
	|	КОНЕЦ КАК СуммаЗаказа
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ЗаказПокупателя КАК З
	|ГДЕ
	|	НЕ З.ПометкаУдаления
	|	И З.Дата <= &КонецПериода
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	О.Ссылка КАК Документ
	|ПОМЕСТИТЬ ВТ_НалоговыеРеализации
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Основания КАК О
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	З.Реализация КАК Реализация,
	|	МАКСИМУМ(З.Заказ) КАК Заказ
	|ПОМЕСТИТЬ ВТ_ОбратныеСвязи
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВЫРАЗИТЬ(Д.Основание КАК Документ.РеализацияТоваровУслуг) КАК Реализация,
	|		Д.Ссылка КАК Заказ
	|	ИЗ
	|		Документ.ЗаказПокупателя КАК Д
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ВЗ
	|			ПО Д.Ссылка = ВЗ.Заказ
	|	ГДЕ
	|		Д.Основание ССЫЛКА Документ.РеализацияТоваровУслуг) КАК З
	|
	|СГРУППИРОВАТЬ ПО
	|	З.Реализация
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ З.Заказ) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Р.Ссылка КАК Реализация,
	|	ВЫБОР
	|		КОГДА Р.Основание <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|			ТОГДА Р.Основание
	|		ИНАЧЕ ЕСТЬNULL(Обр.Заказ, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
	|	КОНЕЦ КАК Заказ,
	|	Р.Проведен КАК Проведен,
	|	Р.Дата КАК Дата,
	|	Р.МестоХранения КАК МестоХранения
	|ПОМЕСТИТЬ ВТ_РеализацииЗаказов
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Р
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НалоговыеРеализации КАК Нал
	|		ПО Р.Ссылка = Нал.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОбратныеСвязи КАК Обр
	|		ПО Р.Ссылка = Обр.Реализация
	|ГДЕ
	|	Нал.Документ ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Реализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Ссылка КАК НалоговыйДокумент,
	|	О.Основание КАК Реализация
	|ПОМЕСТИТЬ ВТ_СтрокиОснований
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Основания КАК О
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка,
	|	Т.ОтгрузкаТовара
	|ИЗ
	|	Документ.НалоговаяНакладная.ТЧТовары КАК Т
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	У.Ссылка,
	|	У.ОтгрузкаТовара
	|ИЗ
	|	Документ.НалоговаяНакладная.ТЧУслуги КАК У
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Основания.НалоговыйДокумент КАК НалоговыйДокумент,
	|	ЕСТЬNULL(РЗ.Заказ, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК Заказ
	|ПОМЕСТИТЬ ВТ_ОснованияНалоговых
	|ИЗ
	|	ВТ_СтрокиОснований КАК Основания
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РеализацииЗаказов КАК РЗ
	|		ПО Основания.Реализация = РЗ.Реализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОН.НалоговыйДокумент КАК НалоговыйДокумент,
	|	МАКСИМУМ(ОН.Заказ) КАК Заказ,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОН.Заказ) КАК ЧислоЗаказов,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ОН.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК ВсеСЗаказом
	|ПОМЕСТИТЬ ВТ_НалоговыеДокументы
	|ИЗ
	|	ВТ_ОснованияНалоговых КАК ОН
	|
	|СГРУППИРОВАТЬ ПО
	|	ОН.НалоговыйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НД.НалоговыйДокумент КАК Объект,
	|	НД.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТ_ОбъектыЗаказа
	|ИЗ
	|	ВТ_НалоговыеДокументы КАК НД
	|ГДЕ
	|	НД.ЧислоЗаказов = 1
	|	И НД.ВсеСЗаказом = 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РЗ.Реализация,
	|	РЗ.Заказ
	|ИЗ
	|	ВТ_РеализацииЗаказов КАК РЗ
	|ГДЕ
	|	РЗ.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	З.Заказ,
	|	З.Заказ
	|ИЗ
	|	ВТ_Заказы КАК З
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	П.Ссылка,
	|	П.Основание
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК П
	|ГДЕ
	|	П.Основание <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НД.НалоговыйДокумент КАК Документ
	|ПОМЕСТИТЬ ВТ_ОбщиеНалоговые
	|ИЗ
	|	ВТ_НалоговыеДокументы КАК НД
	|ГДЕ
	|	НЕ (НД.ЧислоЗаказов = 1
	|				И НД.ВсеСЗаказом = 1)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Д.Регистратор КАК Регистратор,
	|	Д.ОбъектРасчётов КАК Объект,
	|	Д.ВидДвижения КАК ВидДвижения,
	|	Д.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ДвиженияРасчетов
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Д
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОбщиеНалоговые КАК ОбщийРегистратор
	|		ПО Д.Регистратор = ОбщийРегистратор.Документ
	|ГДЕ
	|	Д.Активность
	|	И Д.Период <= &КонецПериода
	|	И ОбщийРегистратор.Документ ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОЗ.Заказ КАК Заказ,
	|	Д.Регистратор КАК Регистратор,
	|	Д.ВидДвижения КАК ВидДвижения,
	|	Д.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_РасчетыЗаказов
	|ИЗ
	|	ВТ_ДвиженияРасчетов КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОбъектыЗаказа КАК ОЗ
	|		ПО Д.Объект = ОЗ.Объект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РЗ.Заказ,
	|	Д.Регистратор,
	|	Д.ВидДвижения,
	|	Д.Сумма
	|ИЗ
	|	ВТ_ДвиженияРасчетов КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОбщиеНалоговые КАК ОбщийОбъект
	|		ПО Д.Объект = ОбщийОбъект.Документ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратОтПокупателя КАК Возврат
	|		ПО Д.Регистратор = Возврат.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РеализацииЗаказов КАК РЗ
	|		ПО (Возврат.Основание = РЗ.Реализация)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РЗ.Заказ,
	|	Д.Регистратор,
	|	Д.ВидДвижения,
	|	Д.Сумма
	|ИЗ
	|	ВТ_ДвиженияРасчетов КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОбщиеНалоговые КАК ОбщийОбъект
	|		ПО Д.Объект = ОбщийОбъект.Документ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СертификатНаОплату КАК Сертификат
	|		ПО Д.Регистратор = Сертификат.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РеализацииЗаказов КАК РЗ
	|		ПО (Сертификат.Реализация = РЗ.Реализация)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Р.Заказ КАК Заказ,
	|	СУММА(ВЫБОР
	|			КОГДА Р.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Р.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОтгруженоРасчеты,
	|	СУММА(ВЫБОР
	|			КОГДА Р.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					И НЕ Р.Регистратор ССЫЛКА Документ.КорректировкаДолга
	|				ТОГДА Р.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Оплачено,
	|	СУММА(ВЫБОР
	|			КОГДА Р.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					И Р.Регистратор ССЫЛКА Документ.КорректировкаДолга
	|				ТОГДА Р.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Корректировки
	|ПОМЕСТИТЬ ВТ_Деньги
	|ИЗ
	|	ВТ_РасчетыЗаказов КАК Р
	|
	|СГРУППИРОВАТЬ ПО
	|	Р.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Регистратор КАК Регистратор,
	|	О.ДокументПродажи КАК ДокументПродажи,
	|	О.ВыручкаОборот КАК Выручка,
	|	О.ВыручкаОборот - О.НДСОборот КАК ВыручкаБезНДС,
	|	0 КАК Себестоимость
	|ПОМЕСТИТЬ ВТ_ДвиженияПродаж
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(, &ГраницаКонца, Регистратор, ) КАК О
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	С.Регистратор,
	|	С.ДокументПродажи,
	|	0,
	|	0,
	|	С.СуммаОборот - С.СуммаНДСОборот
	|ИЗ
	|	РегистрНакопления.СебестоимостьПродаж.Обороты(, &ГраницаКонца, Регистратор, ) КАК С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА П.Регистратор ССЫЛКА Документ.ВозвратОтПокупателя
	|				И НЕ ОЗ.Заказ ЕСТЬ NULL
	|			ТОГДА ОЗ.Заказ
	|		КОГДА П.Регистратор ССЫЛКА Документ.ВозвратОтПокупателя
	|			ТОГДА ЕСТЬNULL(РЗВозврата.Заказ, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
	|		ИНАЧЕ ЕСТЬNULL(ОЗ.Заказ, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
	|	КОНЕЦ КАК Заказ,
	|	П.Выручка КАК Выручка,
	|	П.ВыручкаБезНДС КАК ВыручкаБезНДС,
	|	П.Себестоимость КАК Себестоимость
	|ПОМЕСТИТЬ ВТ_ПродажиЗаказовВсе
	|ИЗ
	|	ВТ_ДвиженияПродаж КАК П
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОбщиеНалоговые КАК ОбщийРегистратор
	|		ПО П.Регистратор = ОбщийРегистратор.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОбъектыЗаказа КАК ОЗ
	|		ПО П.ДокументПродажи = ОЗ.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратОтПокупателя КАК Возврат
	|		ПО П.Регистратор = Возврат.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РеализацииЗаказов КАК РЗВозврата
