#Область ПрограммныйИнтерфейс

// Данные отчёта «План загрузки станков» - внешние наборы «Дни» и «Риски» схемы; строится только набор варианта, второй
// пуст. «Дни» - ЗагрузкаСтанков.АналитикаЗагрузки по станкам отчётов периода, «Риски» - ЗагрузкаСтанков.РискиСрыва от
// момента. Отчёт и тест зовут эту функцию одинаково.
//
// Параметры:
//  Период    - СтандартныйПериод, Неопределено - период варианта «По дням»; Неопределено или пустой - эта неделя
//  Момент    - Дата, Неопределено - момент варианта «Заказы под риском»; Неопределено или пустая - текущая дата сеанса
//  ВидДанных - Строка - «Дни» или «Риски»
//
// Возвращаемое значение:
//  Структура:
//   * Дни            - ТаблицаЗначений - Станок, День, Фонд, Занято, Свободно, Процент
//   * Риски          - ТаблицаЗначений - см. ЗагрузкаСтанков.РискиСрыва, Заказы
//   * Предупреждение - Строка - пустой производственный календарь или обрезанный период; пустая - всё в порядке
//
Функция ДанныеОтчета(Период, Знач Момент, ВидДанных) Экспорт

	Момент = ?(ЗначениеЗаполнено(Момент), Момент, ТекущаяДатаСеанса());
	Результат = Новый Структура("Дни, Риски, Предупреждение", Неопределено, Неопределено, "");
	Если ВидДанных = "Риски" Тогда
		Результат.Риски = ЗагрузкаСтанков.РискиСрыва(Неопределено, Момент).Заказы;
		Результат.Дни = ПустаяТаблица("Станок,День,Фонд,Занято,Свободно,Процент");
		Возврат Результат;
	КонецЕсли;

	Границы = ГраницыПериода(Период, Момент);
	Предупреждения = Новый Массив;
	// Цикл по дням и станкам в памяти: период длиннее трёх месяцев обрезается.
	Граница = Границы.Начало + МаксимумДней() * ЗагрузкаСтанков.СекундВСутках();
	Если Границы.Окончание > Граница Тогда
		Границы.Окончание = Граница;
		Шаблон = НСтр("ru = 'Период сокращён до %1 дней - до %2'; fr = 'Période réduite à %1 jours - jusqu''au %2';
			|en = 'Period shortened to %1 days - until %2'; es = 'Período reducido a %1 días - hasta el %2'");
		Предупреждения.Добавить(СтрШаблон(Шаблон, МаксимумДней(), Формат(Граница - 1, "ДЛФ=D")));
	КонецЕсли;
	Станки = ЗагрузкаСтанков.СтанкиОтчетов(Границы.Начало, Границы.Окончание);
	ЧасовОкна = 1;
	Аналитика = ЗагрузкаСтанков.АналитикаЗагрузки(Станки, Границы.Начало, Границы.Окончание, ЧасовОкна, Момент);
	Результат.Дни = Аналитика.Дни;
	Результат.Риски = ПустаяТаблица("Источник,Заказ,Клиент,ДатаОтгрузки,Номенклатура,Количество,Станок,Окончание,Часы,"
		+ "ОпозданиеДней,ТекстОшибки,Документ");
	Если ЗначениеЗаполнено(Аналитика.Предупреждение) Тогда
		Предупреждения.Добавить(Аналитика.Предупреждение);
	КонецЕсли;
	Результат.Предупреждение = СтрСоединить(Предупреждения, Символы.ПС);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ГраницыПериода(Период, Момент)

	Границы = Новый Структура("Начало, Окончание");
	Если ТипЗнч(Период) = Тип("СтандартныйПериод") И ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		Границы.Начало = НачалоДня(Период.ДатаНачала);
		Границы.Окончание = КонецДня(Период.ДатаОкончания) + 1;
	Иначе
		Границы.Начало = НачалоНедели(Момент);
		Границы.Окончание = КонецНедели(Момент) + 1;
	КонецЕсли;
	Возврат Границы;

КонецФункции

Функция МаксимумДней()

	Возврат 93;

КонецФункции

Функция ПустаяТаблица(Колонки)

	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить(Колонки, ",") Цикл
		Таблица.Колонки.Добавить(Имя);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

#КонецОбласти
