// Товары в наличии. Пользователю с настройкой «Только свой склад» (docs/plans/retail-tools.md, п. 5) отчёт строится
// только по его складу (вид настройки Magasin): отбор добавляется к настройкам при компоновке, снять его пользователь
// не может. Это отбор отчёта, а не ограничение доступа к данным.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	Если Не РегистрыСведений.НастройкиПользователей.ТолькоСвойСклад() Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ПрименитьОтборСвоегоСклада(Настройки);

	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, ДанныеРасшифровки);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, , ДанныеРасшифровки);

	ДокументРезультат.Очистить();
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(Процессор);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет к настройкам отбор по складу пользователя. Склад не задан - отбор по пустому складу (отчёт пуст) и
// сообщение пользователю.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных - настройки компоновки, дополняются отбором.
//
Процедура ПрименитьОтборСвоегоСклада(Настройки) Экспорт

	Склад = РегистрыСведений.НастройкиПользователей.СкладПользователя();
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
			"ru = 'Не задан склад пользователя: отчёт строится только по своему складу';
			|fr = 'L''entrepôt de l''utilisateur n''est pas défini : le rapport porte uniquement sur son entrepôt';
			|en = 'The user''s warehouse is not set: the report covers only the own warehouse';
			|es = 'No se ha definido el almacén del usuario: el informe solo abarca su propio almacén'"));
	КонецЕсли;
	Элемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("МестоХранения");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Элемент.ПравоеЗначение = Склад;
	Элемент.Использование = Истина;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'; fr = 'Appel d''objet non autorisé sur le client.';
	|en = 'Invalid object call on the client.'; es = 'Llamada de objeto no válida en el cliente.'");
#КонецЕсли
