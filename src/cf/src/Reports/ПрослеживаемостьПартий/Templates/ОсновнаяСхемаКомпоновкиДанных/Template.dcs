				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Движения.Номенклатура КАК Номенклатура,
	Движения.Характеристика КАК Характеристика,
	Движения.Партия КАК Партия,
	МАКСИМУМ(Движения.ДатаПартии) КАК ДатаПрихода,
	Движения.МестоХранения КАК МестоХранения,
	ВЫБОР
		КОГДА Движения.Партия ССЫЛКА Документ.ПоступлениеТоваровУслуг
			ТОГДА ВЫРАЗИТЬ(Движения.Партия КАК Документ.ПоступлениеТоваровУслуг).Контрагент
		ИНАЧЕ ВЫРАЗИТЬ(Движения.Партия КАК Документ.ПриходныйОрдер).Контрагент
	КОНЕЦ КАК Поставщик,
	СУММА(Движения.Количество) КАК Приход
ИЗ
	РегистрНакопления.ТоварыВНаличии КАК Движения
ГДЕ
	Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	И Движения.Активность
	И Движения.Регистратор = Движения.Партия
	И Движения.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И (Движения.Партия ССЫЛКА Документ.ПоступлениеТоваровУслуг
				И Движения.МестоХранения = ВЫРАЗИТЬ(Движения.Партия КАК Документ.ПоступлениеТоваровУслуг).МестоХранения
			ИЛИ Движения.Партия ССЫЛКА Документ.ПриходныйОрдер
				И Движения.МестоХранения = ВЫРАЗИТЬ(Движения.Партия КАК Документ.ПриходныйОрдер).МестоХранения)

СГРУППИРОВАТЬ ПО
	Движения.Номенклатура,
	Движения.Характеристика,
	Движения.Партия,
	Движения.МестоХранения,
	ВЫБОР
		КОГДА Движения.Партия ССЫЛКА Документ.ПоступлениеТоваровУслуг
			ТОГДА ВЫРАЗИТЬ(Движения.Партия КАК Документ.ПоступлениеТоваровУслуг).Контрагент
		ИНАЧЕ ВЫРАЗИТЬ(Движения.Партия КАК Документ.ПриходныйОрдер).Контрагент
	КОНЕЦ</query>
	</dataSet>
	<totalField>
		<dataPath>Приход</dataPath>
		<expression>Сумма(Приход)</expression>
	</totalField>
