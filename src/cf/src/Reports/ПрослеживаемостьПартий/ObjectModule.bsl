// Прослеживаемость партий материала (план docs/plans/lot-traceability.md).
// Партии материала отбирает схема компоновки (период первичного прихода, отборы пользователя), воронку - пакет запросов
// модуля: выпуск ПФ из партии -> передача партий ПФ переработчику -> отгрузка продукции этих поступлений из переработки.
// Секции выводятся бок о бок под каждой партией и построчно не сопоставляются. Количества - полные количества
// документов, смешение партий помечается, долями не делится.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДокументРезультат.Очистить();

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрыОтчета = ПараметрыОтчета(Настройки);
	Партии = ПартииМатериала(Настройки, ПараметрыОтчета);
	Данные = ДанныеВоронки(Партии, ПараметрыОтчета);
	ВывестиОтчет(ДокументРезультат, Партии, Данные, ПараметрыОтчета);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Данные

Функция ПараметрыОтчета(Настройки)

	Период = ЗначениеПараметра(Настройки, "Период");
	Результат = Новый Структура("НачалоПериода, КонецПериода, Лот, Клиент");
	Результат.НачалоПериода = '00010101';
	Результат.КонецПериода = КонецДня(ТекущаяДатаСеанса());
	Результат.Лот = "";
	Если ТипЗнч(Период) = Тип("СтандартныйПериод") Тогда
		Результат.НачалоПериода = Период.ДатаНачала;
		Если ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
			Результат.КонецПериода = Период.ДатаОкончания;
		КонецЕсли;
	КонецЕсли;
	Лот = ЗначениеПараметра(Настройки, "Лот");
	Если ТипЗнч(Лот) = Тип("Строка") Тогда
		Результат.Лот = НРег(СокрЛП(Лот));
	КонецЕсли;
	Клиент = ЗначениеПараметра(Настройки, "Клиент");
	Если ЗначениеЗаполнено(Клиент) Тогда
		Результат.Клиент = Клиент;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеПараметра(Настройки, Имя)

	Элемент = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(Имя));
	Если Элемент = Неопределено Или Не Элемент.Использование Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Элемент.Значение;

КонецФункции

// Партии материала первичного прихода по настройкам пользователя: схема компоновки - в коллекцию значений.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных - настройки отчёта (изменяются: выбор и структура под выгрузку).
//  ПараметрыОтчета - Структура - см. ПараметрыОтчета.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Партия, ДатаПрихода, Поставщик, Приход.
//
Функция ПартииМатериала(Настройки, ПараметрыОтчета)

	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода", ПараметрыОтчета.КонецПериода);
	Поля = СтрРазделить("Номенклатура,Характеристика,Партия,ДатаПрихода,Поставщик,Приход", ",");
	Настройки.Выбор.Элементы.Очистить();
	Для Каждого ИмяПоля Из Поля Цикл
		Поле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;
	Настройки.Структура.Очистить();
	Детали = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Детали.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	Выгрузка = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Выгрузка);
	Вывод.Вывести(Процессор);

	Партии = Новый ТаблицаЗначений;
	Партии.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Партии.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Партии.Колонки.Добавить("Партия", Новый ОписаниеТипов("ДокументСсылка.ПоступлениеТоваровУслуг, ДокументСсылка.ПриходныйОрдер"));
	Партии.Колонки.Добавить("ДатаПрихода", Новый ОписаниеТипов("Дата"));
	Партии.Колонки.Добавить("Поставщик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Партии.Колонки.Добавить("Приход", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Выгрузка Цикл
		ЗаполнитьЗначенияСвойств(Партии.Добавить(), Строка);
	КонецЦикла;
	Партии.Свернуть("Номенклатура, Характеристика, Партия, ДатаПрихода, Поставщик", "Приход");
	Партии.Сортировать("ДатаПрихода, Номенклатура");
	Возврат Партии;

КонецФункции

// Воронка партий: пакет запросов, результаты - таблицами значений по секциям.
//
// Параметры:
//  Партии - ТаблицаЗначений - см. ПартииМатериала.
//  ПараметрыОтчета - Структура - см. ПараметрыОтчета.
//
// Возвращаемое значение:
//  Структура - Лоты, Остатки, Выпуски, Передачи, Отгрузки, НаСкладе, Хвосты (ТаблицаЗначений).
//
Функция ДанныеВоронки(Партии, ПараметрыОтчета)

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаВоронки();
	Запрос.УстановитьПараметр("Партии", Партии.Скопировать(, "Номенклатура, Характеристика, Партия"));
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыОтчета.КонецПериода);
	Запрос.УстановитьПараметр("ГраницаКонца", Новый Граница(ПараметрыОтчета.КонецПериода, ВидГраницы.Включая));
	Результаты = Запрос.ВыполнитьПакет();

	// Последние запросы пакета - результаты секций в порядке имён ниже, перед ними - временные таблицы.
	Имена = СтрРазделить("Лоты,Остатки,Выпуски,Передачи,Отгрузки,НаСкладе,Хвосты", ",");
	Смещение = Результаты.Количество() - Имена.Количество();
	Данные = Новый Структура;
	Для Индекс = 0 По Имена.ВГраница() Цикл
		Данные.Вставить(Имена[Индекс], Результаты[Смещение + Индекс].Выгрузить());
	КонецЦикла;
	Возврат Данные;

КонецФункции

// Текст пакета запросов воронки (правила - docs/plans/lot-traceability.md, «Исходные данные»).
//
// Возвращаемое значение:
//  Строка - текст пакета; последние семь запросов - результаты секций (см. ДанныеВоронки).
//
// BSLLS:MethodSize-off - текст пакета запросов воронки: одна функция, чтобы пакет читался целиком.
// BSLLS:QueryNestedFieldsByDot-off - реквизиты документов воронки (дата, номер, основание, контрагент), объёмы малы.
Функция ТекстЗапросаВоронки()

	Возврат
	"ВЫБРАТЬ
	|	П.Номенклатура КАК Номенклатура,
	|	П.Характеристика КАК Характеристика,
	|	П.Партия КАК Партия
	|ПОМЕСТИТЬ ВТ_Партии
	|ИЗ
	|	&Партии КАК П
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Д.Номенклатура КАК Номенклатура,
	|	Д.Характеристика КАК Характеристика,
	|	Д.Партия КАК Партия,
	|	ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ВыпускПродукции) КАК Выпуск,
	|	СУММА(Д.Количество) КАК Списано
	|ПОМЕСТИТЬ ВТ_РасходМатериала
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Партии КАК П
	|		ПО Д.Номенклатура = П.Номенклатура
	|			И Д.Характеристика = П.Характеристика
	|			И Д.Партия = П.Партия
	|ГДЕ
	|	Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Д.Активность
	|	И Д.Регистратор ССЫЛКА Документ.ВыпускПродукции
	|	И Д.Период <= &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	Д.Номенклатура,
	|	Д.Характеристика,
	|	Д.Партия,
	|	ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ВыпускПродукции)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Р.Выпуск КАК Выпуск
	|ПОМЕСТИТЬ ВТ_Выпуски
	|ИЗ
	|	ВТ_РасходМатериала КАК Р
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Р.Номенклатура КАК Номенклатура,
	|	Р.Характеристика КАК Характеристика,
	|	Р.Партия КАК Партия,
	|	Р.Выпуск КАК Выпуск
	|ПОМЕСТИТЬ ВТ_СвязьВыпусков
	|ИЗ
	|	ВТ_РасходМатериала КАК Р
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ВыпускПродукции) КАК Выпуск,
	|	Д.Номенклатура КАК Номенклатура,
	|	Д.Характеристика КАК Характеристика,
	|	Д.Партия КАК Партия
	|ПОМЕСТИТЬ ВТ_ПартииВыпусков
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Д
	|ГДЕ
	|	Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Д.Активность
	|	И Д.Регистратор В
	|			(ВЫБРАТЬ
	|				Вып.Выпуск КАК Выпуск
	|			ИЗ
	|				ВТ_Выпуски КАК Вып)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПВ.Выпуск КАК Выпуск
	|ПОМЕСТИТЬ ВТ_СмешанныеВыпуски
	|ИЗ
	|	ВТ_ПартииВыпусков КАК ПВ
	|
	|СГРУППИРОВАТЬ ПО
	|	ПВ.Выпуск
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГП.Ссылка КАК Выпуск,
	|	ГП.Номенклатура КАК Номенклатура,
	|	ГП.Характеристика КАК Характеристика,
	|	СУММА(ГП.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_ПФ
	|ИЗ
	|	Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК ГП
	|ГДЕ
	|	ГП.Ссылка В
	|			(ВЫБРАТЬ
	|				Вып.Выпуск КАК Выпуск
	|			ИЗ
	|				ВТ_Выпуски КАК Вып)
	|
	|СГРУППИРОВАТЬ ПО
	|	ГП.Ссылка,
	|	ГП.Номенклатура,
	|	ГП.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ПередачаВПереработку) КАК Передача,
	|	ПФ.Выпуск КАК Выпуск,
	|	Д.Номенклатура КАК Номенклатура,
	|	Д.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СтрокиПередачи.Заказ, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
	|				<> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|			ТОГДА СтрокиПередачи.Заказ
	|		ИНАЧЕ ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ПередачаВПереработку).Основание
	|	КОНЕЦ КАК Заказ,
	|	СУММА(Д.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_Передачи
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПФ КАК ПФ
	|		ПО Д.Партия = ПФ.Выпуск
	|			И Д.Номенклатура = ПФ.Номенклатура
	|			И Д.Характеристика = ПФ.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаВПереработку.ТЧТовары КАК СтрокиПередачи
	|		ПО (СтрокиПередачи.Ссылка = Д.Регистратор)
	|			И (СтрокиПередачи.КодСтроки = Д.КодСтроки)
	|			И (Д.КодСтроки <> 0)
	|ГДЕ
	|	Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Д.Активность
	|	И Д.Регистратор ССЫЛКА Документ.ПередачаВПереработку
	|	И Д.Период <= &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ПередачаВПереработку),
	|	ПФ.Выпуск,
	|	Д.Номенклатура,
	|	Д.Характеристика,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СтрокиПередачи.Заказ, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
	|				<> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|			ТОГДА СтрокиПередачи.Заказ
	|		ИНАЧЕ ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ПередачаВПереработку).Основание
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(Т.Регистратор КАК Документ.ПоступлениеИзПереработки) КАК Поступление,
	|	П.Выпуск КАК Выпуск
	|ПОМЕСТИТЬ ВТ_Поступления
	|ИЗ
	|	РегистрНакопления.ТоварыВПереработке КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Передачи КАК П
	|		ПО Т.ПередачаВПереработку = П.Передача
	|			И Т.Номенклатура = П.Номенклатура
	|			И Т.Характеристика = П.Характеристика
	|			И Т.Партия = П.Выпуск
	|ГДЕ
	|	Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Т.Активность
	|	И Т.Регистратор ССЫЛКА Документ.ПоступлениеИзПереработки
	|	И Т.Период <= &КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(Т.Регистратор КАК Документ.ПоступлениеИзПереработки) КАК Поступление,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Партия КАК Партия
	|ПОМЕСТИТЬ ВТ_ПартииПоступлений
	|ИЗ
	|	РегистрНакопления.ТоварыВПереработке КАК Т
	|ГДЕ
	|	Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Т.Активность
	|	И Т.Регистратор В
	|			(ВЫБРАТЬ
	|				П.Поступление КАК Поступление
	|			ИЗ
	|				ВТ_Поступления КАК П)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПП.Поступление КАК Поступление
	|ПОМЕСТИТЬ ВТ_СмешанныеПоступленияВсе
	|ИЗ
	|	ВТ_ПартииПоступлений КАК ПП
	|
	|СГРУППИРОВАТЬ ПО
	|	ПП.Поступление
	|
	|ИМЕЮЩИЕ
