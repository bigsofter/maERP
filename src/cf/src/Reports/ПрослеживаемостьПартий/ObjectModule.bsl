	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Связь.Номенклатура КАК Номенклатура,
	|	Связь.Характеристика КАК Характеристика,
	|	Связь.Партия КАК Партия,
	|	Хвост.Ссылка КАК Документ,
	|	Хвост.Дата КАК Дата,
	|	Хвост.Номер КАК Номер,
	|	Хвост.Контрагент КАК Переработчик
	|ИЗ
	|	Документ.ПоступлениеИзПереработки КАК Хвост
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Передачи КАК П
	|		ПО Хвост.Основание = П.Передача
	|			И Хвост.Контрагент = П.Передача.Контрагент
	|			И Хвост.Дата > П.Передача.Дата
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СвязьВыпусков КАК Связь
	|		ПО П.Выпуск = Связь.Выпуск
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВПереработке КАК Сырье
	|		ПО Хвост.Ссылка = Сырье.Регистратор
	|			И (Сырье.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
	|ГДЕ
	|	Хвост.Проведен
	|	И Хвост.Дата <= &КонецПериода
	|	И Сырье.Регистратор ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Связь.Номенклатура КАК Номенклатура,
	|	Связь.Характеристика КАК Характеристика,
	|	Связь.Партия КАК Партия,
	|	Хвост.Ссылка КАК Документ,
	|	Хвост.Дата КАК Дата,
	|	Хвост.Номер КАК Номер,
	|	Хвост.Контрагент КАК Переработчик
	|ИЗ
	|	Документ.ПоступлениеИзПереработки КАК Хвост
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Передачи КАК П
	|		ПО Хвост.Основание = П.Заказ
	|			И (П.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
	|			И Хвост.Контрагент = П.Передача.Контрагент
	|			И Хвост.Дата > П.Передача.Дата
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СвязьВыпусков КАК Связь
	|		ПО П.Выпуск = Связь.Выпуск
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВПереработке КАК Сырье
	|		ПО Хвост.Ссылка = Сырье.Регистратор
	|			И (Сырье.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
	|ГДЕ
	|	Хвост.Проведен
	|	И Хвост.Дата <= &КонецПериода
	|	И Сырье.Регистратор ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Документ";

КонецФункции
// BSLLS:QueryNestedFieldsByDot-on
// BSLLS:MethodSize-on

#КонецОбласти

#Область Вывод

// BSLLS:MagicNumber-off - номера секций (1-4) и смещения колонок внутри секции.

// Выводит отчёт: шапку и по каждой партии - группу с четырьмя секциями бок о бок.
//
// Параметры:
//  ДокументРезультат - ТабличныйДокумент - результат отчёта.
//  Партии - ТаблицаЗначений - см. ПартииМатериала.
//  Данные - Структура - см. ДанныеВоронки.
//  ПараметрыОтчета - Структура - см. ПараметрыОтчета.
//
Процедура ВывестиОтчет(ДокументРезультат, Партии, Данные, ПараметрыОтчета)

	Контекст = Новый Структура("Документ, Строка", ДокументРезультат, 1);
	НастроитьКолонки(ДокументРезультат);
	ВывестиШапкуОтчета(Контекст, ПараметрыОтчета);

	Выведено = 0;
	Для Каждого Партия Из Партии Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика, Партия", Партия.Номенклатура, Партия.Характеристика,
			Партия.Партия);
		Лот = ЛотПартии(Данные.Лоты.НайтиСтроки(Отбор), Партия.Партия);
		Если Не ПустаяСтрока(ПараметрыОтчета.Лот) И СтрНайти(НРег(Лот), ПараметрыОтчета.Лот) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Секции = СекцииПартии(Данные, Отбор, ПараметрыОтчета);
		Если ПараметрыОтчета.Клиент <> Неопределено И Секции.Выпуски.Количество() + Секции.Передачи.Количество()
			+ Секции.Отгрузки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Остатки = Данные.Остатки.НайтиСтроки(Отбор);
		Остаток = ?(Остатки.Количество() = 0, 0, Остатки[0].Остаток);
		ВывестиПартию(Контекст, Партия, Лот, Остаток, Секции);
		Выведено = Выведено + 1;
	КонецЦикла;

	Если Выведено = 0 Тогда
		ВывестиТекст(Контекст, 1, НСтр("ru = 'Партий материала с первичным приходом за период нет.';
			|fr = 'Aucun lot de matière reçu sur la période.'; en = 'No material lots received in the period.';
			|es = 'No hay lotes de material recibidos en el período.'"), Ложь);
	Иначе
		ВывестиТекст(Контекст, 1, НСтр("ru = '◐ - документ смешанный: в нём несколько партий, количество относится ко всем сразу.';
			|fr = '◐ - document mixte : plusieurs lots, la quantité concerne l''ensemble.';
			|en = '◐ - mixed document: several lots, the quantity covers all of them.';
			|es = '◐ - documento mixto: varios lotes, la cantidad corresponde a todos.'"), Ложь);
	КонецЕсли;

КонецПроцедуры

Функция СекцииПартии(Данные, Отбор, ПараметрыОтчета)

	Секции = Новый Структура;
	Секции.Вставить("Выпуски", ОтобратьПоКлиенту(Данные.Выпуски.НайтиСтроки(Отбор), ПараметрыОтчета.Клиент));
	Секции.Вставить("Передачи", ОтобратьПоКлиенту(Данные.Передачи.НайтиСтроки(Отбор), ПараметрыОтчета.Клиент));
	Секции.Вставить("Отгрузки", ОтобратьПоКлиенту(Данные.Отгрузки.НайтиСтроки(Отбор), ПараметрыОтчета.Клиент));
	Если ПараметрыОтчета.Клиент = Неопределено Тогда
		Секции.Вставить("НаСкладе", Данные.НаСкладе.НайтиСтроки(Отбор));
	Иначе
		// У остатка клиента нет: при отборе по клиенту строка «На складе» не выводится (план, круг 11).
		Секции.Вставить("НаСкладе", Новый Массив);
	КонецЕсли;
	Секции.Вставить("Хвосты", Данные.Хвосты.НайтиСтроки(Отбор));
	Возврат Секции;

КонецФункции

Функция ОтобратьПоКлиенту(Строки, Клиент)

	Если Клиент = Неопределено Тогда
		Возврат Строки;
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Клиент = Клиент Тогда
			Результат.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЛотПартии(СтрокиЛота, Партия)

	// Номер поставщика; у оформления без номера поставщика - номер самого поступления: оформленный ордер без номера
	// поставщика не считается неоформленным.
	Номера = Новый Массив;
	Для Каждого Строка Из СтрокиЛота Цикл
		Номер = СокрЛП(Строка.Номер);
		Если ПустаяСтрока(Номер) И ЗначениеЗаполнено(Строка.Поступление) Тогда
			Номер = НСтр("ru = 'поступление'; fr = 'réception'; en = 'receipt'; es = 'recepción'") + " " + Строка.Поступление.Номер;
		КонецЕсли;
		Если Не ПустаяСтрока(Номер) И Номера.Найти(Номер) = Неопределено Тогда
			Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;
	Если Номера.Количество() > 0 Тогда
		Возврат СтрСоединить(Номера, ", ");
	КонецЕсли;
	Если ТипЗнч(Партия) = Тип("ДокументСсылка.ПриходныйОрдер") Тогда
		Возврат СтрШаблон(НСтр("ru = 'ордер %1 (не оформлен)'; fr = 'bon %1 (non régularisé)'; en = 'order %1 (not processed)';
			|es = 'orden %1 (sin tramitar)'"), Партия.Номер);
	КонецЕсли;
	Возврат "";

КонецФункции

Процедура ВывестиПартию(Контекст, Партия, Лот, Остаток, Секции)

	Документ = Контекст.Документ;
	Начало = Контекст.Строка;

	// Шапка группы: материал, характеристика, лот, дата прихода.
	Части = Новый Массив;
	Части.Добавить(Строка(Партия.Номенклатура));
	Если ЗначениеЗаполнено(Партия.Характеристика) Тогда
		Части.Добавить(Строка(Партия.Характеристика));
	КонецЕсли;
	Части.Добавить(НСтр("ru = 'лот'; fr = 'lot'; en = 'lot'; es = 'lote'") + " " + Лот);
	Части.Добавить(Формат(Партия.ДатаПрихода, "ДЛФ=D"));
	Заголовок = СтрСоединить(Части, " · ");
	Область = Документ.Область(Начало, 1, Начало, ПоследняяКолонка());
	Область.Объединить();
	Область.Текст = Заголовок;
	Область.Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
	Область.ЦветФона = WebЦвета.СветлоСерый;

	// Заголовки секций и колонок.
	ВывестиЗаголовкиСекций(Документ, Начало + 1);

	Строки = Новый Массив;
	Строки.Добавить(1);
	Строки.Добавить(ВывестиВыпуски(Документ, Начало + 3, Секции.Выпуски));
	Строки.Добавить(ВывестиПередачи(Документ, Начало + 3, Секции.Передачи, Секции.Хвосты));
	Строки.Добавить(ВывестиОтгрузки(Документ, Начало + 3, Секции.Отгрузки, Секции.НаСкладе));

	// Секция материала - одна строка.
	Колонка = КолонкаСекции(1);
	ВывестиЯчейку(Документ, Начало + 3, Колонка, Формат(Партия.ДатаПрихода, "ДЛФ=D"), Партия.Партия);
	ВывестиЯчейку(Документ, Начало + 3, Колонка + 1, Строка(Партия.Номенклатура));
	ВывестиЯчейку(Документ, Начало + 3, Колонка + 2, Строка(Партия.Характеристика));
	ВывестиЯчейку(Документ, Начало + 3, Колонка + 3, Лот, Партия.Партия);
	ВывестиЯчейку(Документ, Начало + 3, Колонка + 4, Строка(Партия.Поставщик));
	ВывестиЯчейку(Документ, Начало + 3, Колонка + 5, ФорматКоличества(Партия.Приход));
	ВывестиЯчейку(Документ, Начало + 3, Колонка + 6, ФорматКоличества(Остаток));

	Максимум = 0;
	Для Каждого ЧислоСтрок Из Строки Цикл
		Максимум = Макс(Максимум, ЧислоСтрок);
	КонецЦикла;
	Контекст.Строка = Начало + 3 + Максимум + 1;

КонецПроцедуры

Функция ВывестиВыпуски(Документ, НомерСтроки, Выпуски)

	Колонка = КолонкаСекции(2);
	Итоги = Новый Соответствие;
	Номер = 0;
	Предыдущий = Неопределено;
	Для Каждого Выпуск Из Выпуски Цикл
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка, Формат(Выпуск.Дата, "ДЛФ=D"));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 1, Выпуск.Номер + ?(Выпуск.Смешан = 1, " ◐", ""), Выпуск.Документ);
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 2, Строка(Выпуск.Продукция));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 3, ФорматКоличества(Выпуск.Количество));
		// Списано из партии - одно на выпуск, в первой строке его продукции.
		Если Выпуск.Документ <> Предыдущий Тогда
			ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 4, ФорматКоличества(Выпуск.Списано));
		КонецЕсли;
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 5, Строка(Выпуск.Клиент));
		ДобавитьИтог(Итоги, Выпуск.Единица, Выпуск.Количество);
		Предыдущий = Выпуск.Документ;
		Номер = Номер + 1;
	КонецЦикла;
	Номер = Номер + ВывестиИтоги(Документ, НомерСтроки + Номер, Колонка + 2, Итоги);
	Возврат Номер;

КонецФункции

Функция ВывестиПередачи(Документ, НомерСтроки, Передачи, Хвосты)

	Колонка = КолонкаСекции(3);
	Итоги = Новый Соответствие;
	Номер = 0;
	Для Каждого Передача Из Передачи Цикл
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка, Формат(Передача.Дата, "ДЛФ=D"));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 1, Передача.Номер + ?(Передача.Смешан = 1, " ◐", ""), Передача.Документ);
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 2, Строка(Передача.Продукция));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 3, ФорматКоличества(Передача.Количество));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 4, Строка(Передача.Переработчик));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 5, Строка(Передача.Клиент));
		ДобавитьИтог(Итоги, Передача.Единица, Передача.Количество);
		Номер = Номер + 1;
	КонецЦикла;
	Номер = Номер + ВывестиИтоги(Документ, НомерСтроки + Номер, Колонка + 2, Итоги);
	// Хвосты без сырья: справочно, без итогов и без продолжения воронки (план, круг 11).
	Для Каждого Хвост Из Хвосты Цикл
		Шаблон = НСтр("ru = 'Хвост без сырья: поступление %1 от %2 (%3) - связь с партией не подтверждена';
			|fr = 'Reliquat sans matière : réception %1 du %2 (%3) - lien avec le lot non confirmé';
			|en = 'Tail without raw material: receipt %1 of %2 (%3) - link to the lot not confirmed';
			|es = 'Remanente sin materia prima: recepción %1 del %2 (%3) - vínculo con el lote no confirmado'");
		ДатаХвоста = Формат(Хвост.Дата, "ДЛФ=D");
		Текст = СтрШаблон(Шаблон, Хвост.Номер, ДатаХвоста, Строка(Хвост.Переработчик));
		Область = Документ.Область(НомерСтроки + Номер, Колонка, НомерСтроки + Номер, Колонка + ШиринаСекции(3) - 1);
		Область.Объединить();
		Область.Текст = Текст;
		Область.Расшифровка = Хвост.Документ;
		Область.ЦветТекста = WebЦвета.Серый;
		Номер = Номер + 1;
	КонецЦикла;
	Возврат Номер;

КонецФункции

Функция ВывестиОтгрузки(Документ, НомерСтроки, Отгрузки, НаСкладе)

	Колонка = КолонкаСекции(4);
	Итоги = Новый Соответствие;
	ИтогиВыбытия = Новый Соответствие;
	Номер = 0;
	Для Каждого Отгрузка Из Отгрузки Цикл
		ПредставлениеНомера = Отгрузка.Номер;
		Если Отгрузка.Вид = 2 Тогда
			ПредставлениеНомера = НСтр("ru = 'возврат'; fr = 'retour'; en = 'return'; es = 'devolución'") + " " + Отгрузка.Номер;
		ИначеЕсли Отгрузка.Вид = 3 Тогда
			ПредставлениеНомера = НСтр("ru = 'прочее выбытие'; fr = 'autre sortie'; en = 'other disposal'; es = 'otra salida'")
				+ ": " + Отгрузка.Документ.Метаданные().Синоним + " " + Отгрузка.Номер;
		Иначе
			ПредставлениеНомера = Отгрузка.Номер;
		КонецЕсли;
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка, Формат(Отгрузка.Дата, "ДЛФ=D"));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 1, ПредставлениеНомера + ?(Отгрузка.Смешан = 1, " ◐", ""),
			Отгрузка.Документ);
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 2, Строка(Отгрузка.Продукция));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 3, ФорматКоличества(Отгрузка.Количество));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 4, Строка(Отгрузка.Клиент));
		Если Отгрузка.Вид = 3 Тогда
			ДобавитьИтог(ИтогиВыбытия, Отгрузка.Единица, Отгрузка.Количество);
		Иначе
			ДобавитьИтог(Итоги, Отгрузка.Единица, Отгрузка.Количество);
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;
	Для Каждого Остаток Из НаСкладе Цикл
		Если Остаток.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 1,
			НСтр("ru = 'На складе'; fr = 'En stock'; en = 'In stock'; es = 'En almacén'") + ?(Остаток.Смешан = 1, " ◐", ""));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 2, Строка(Остаток.Продукция));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 3, ФорматКоличества(Остаток.Количество));
		ДобавитьИтог(Итоги, Остаток.Единица, Остаток.Количество);
		Номер = Номер + 1;
	КонецЦикла;
	Номер = Номер + ВывестиИтоги(Документ, НомерСтроки + Номер, Колонка + 2, Итоги,
		НСтр("ru = 'Итого отгружено и на складе'; fr = 'Total livré et en stock'; en = 'Total shipped and in stock';
		|es = 'Total expedido y en almacén'"));
	Номер = Номер + ВывестиИтоги(Документ, НомерСтроки + Номер, Колонка + 2, ИтогиВыбытия,
		НСтр("ru = 'Итого прочее выбытие'; fr = 'Total autres sorties'; en = 'Total other disposals'; es = 'Total otras salidas'"));
	Возврат Номер;

КонецФункции

Процедура ДобавитьИтог(Итоги, Единица, Количество)

	Итоги.Вставить(Единица, ?(Итоги[Единица] = Неопределено, 0, Итоги[Единица]) + Количество);

КонецПроцедуры

// Итоги секции - строкой на каждую единицу измерения (разные единицы не складываются, план, круг 7).
//
// Параметры:
//  Документ - ТабличныйДокумент - результат.
//  НомерСтроки - Число - первая строка итогов.
//  Колонка - Число - колонка подписи.
//  Итоги - Соответствие - ключ - единица измерения, значение - количество.
//  Подпись - Строка - подпись итога; пусто - «Итого».
//
// Возвращаемое значение:
//  Число - выведено строк.
//
Функция ВывестиИтоги(Документ, НомерСтроки, Колонка, Итоги, Подпись = "")

	Номер = 0;
	Для Каждого Итог Из Итоги Цикл
		ЕдиницаТекст = ?(ЗначениеЗаполнено(Итог.Ключ), Строка(Итог.Ключ), "");
		Текст = ?(ПустаяСтрока(Подпись), НСтр("ru = 'Итого'; fr = 'Total'; en = 'Total'; es = 'Total'"), Подпись)
			+ ?(ПустаяСтрока(ЕдиницаТекст), "", ", " + ЕдиницаТекст);
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка, Текст);
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 1, ФорматКоличества(Итог.Значение));
		Документ.Область(НомерСтроки + Номер, Колонка, НомерСтроки + Номер, Колонка + 1).Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
		Номер = Номер + 1;
	КонецЦикла;
	Возврат Номер;

КонецФункции

Процедура ВывестиШапкуОтчета(Контекст, ПараметрыОтчета)

	ВывестиТекст(Контекст, 1, НСтр("ru = 'Прослеживаемость партий материала'; fr = 'Traçabilité des lots de matière';
		|en = 'Material lot traceability'; es = 'Trazabilidad de lotes de material'"), Истина);
	Шаблон = НСтр("ru = 'Приход партий с %1 по %2'; fr = 'Lots reçus du %1 au %2'; en = 'Lots received from %1 to %2';
		|es = 'Lotes recibidos del %1 al %2'");
	Начало = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=D");
	Конец = Формат(ПараметрыОтчета.КонецПериода, "ДЛФ=D");
	Описание = СтрШаблон(Шаблон, Начало, Конец);
	Если ПараметрыОтчета.Клиент <> Неопределено Тогда
		Описание = Описание + "; " + НСтр("ru = 'клиент'; fr = 'client'; en = 'customer'; es = 'cliente'") + ": "
			+ Строка(ПараметрыОтчета.Клиент);
	КонецЕсли;
	Если Не ПустаяСтрока(ПараметрыОтчета.Лот) Тогда
		Описание = Описание + "; " + НСтр("ru = 'лот'; fr = 'lot'; en = 'lot'; es = 'lote'") + ": " + ПараметрыОтчета.Лот;
	КонецЕсли;
	ВывестиТекст(Контекст, 1, Описание, Ложь);
	Контекст.Строка = Контекст.Строка + 1;

КонецПроцедуры

Процедура ВывестиТекст(Контекст, Колонка, Текст, Жирный)

	Область = Контекст.Документ.Область(Контекст.Строка, Колонка, Контекст.Строка, ПоследняяКолонка());
	Область.Объединить();
	Область.Текст = Текст;
	Если Жирный Тогда
		Область.Шрифт = ШрифтыСтиля.Шрифт_Основной_Увеличенный;
	КонецЕсли;
	Контекст.Строка = Контекст.Строка + 1;

КонецПроцедуры

Процедура ВывестиЗаголовкиСекций(Документ, НомерСтроки)

	Названия = Новый Массив;
	Названия.Добавить(НСтр("ru = 'Партия материала'; fr = 'Lot de matière (usine)'; en = 'Material lot'; es = 'Lote de material'"));
	Названия.Добавить(НСтр("ru = 'Выпуск ПФ'; fr = 'Fabrication du semi-fini'; en = 'Semi-finished output';
		|es = 'Producción del semielaborado'"));
	Названия.Добавить(НСтр("ru = 'Передача в переработку'; fr = 'Envoi en sous-traitance'; en = 'Transfer for processing';
		|es = 'Envío a procesamiento'"));
	Названия.Добавить(НСтр("ru = 'Отгрузка заказчику'; fr = 'Livraison au client'; en = 'Shipment to customer';
		|es = 'Expedición al cliente'"));

	Колонки = Новый Массив;
	Колонки.Добавить(НСтр("ru = 'Дата прихода,Материал,Характеристика,Лот,Поставщик,Приход,Остаток';
		|fr = 'Date de réception,Matière,Caractéristique,Lot,Fournisseur,Entrée,Stock';
		|en = 'Receipt date,Material,Characteristic,Lot,Supplier,Received,Balance';
		|es = 'Fecha de entrada,Material,Característica,Lote,Proveedor,Entrada,Saldo'"));
	Колонки.Добавить(НСтр("ru = 'Дата,№ выпуска,ПФ,Кол-во ПФ,Списано из партии,Клиент';
		|fr = 'Date,N° fabrication,Semi-fini,Qté semi-fini,Consommé du lot,Client';
		|en = 'Date,Output No.,Semi-finished,Semi-finished qty,Consumed from lot,Customer';
		|es = 'Fecha,N.º producción,Semielaborado,Cant. semielaborado,Consumido del lote,Cliente'"));
	Колонки.Добавить(НСтр("ru = 'Дата,№ накладной,ПФ,Кол-во,Переработчик,Клиент';
		|fr = 'Date,N° bon,Semi-fini,Quantité,Sous-traitant,Client';
		|en = 'Date,Note No.,Semi-finished,Quantity,Processor,Customer';
		|es = 'Fecha,N.º albarán,Semielaborado,Cantidad,Procesador,Cliente'"));
	Колонки.Добавить(НСтр("ru = 'Дата,№ документа,Продукция,Кол-во,Клиент';
		|fr = 'Date,N° document,Produit,Quantité,Client';
		|en = 'Date,Document No.,Product,Quantity,Customer';
		|es = 'Fecha,N.º documento,Producto,Cantidad,Cliente'"));

	Для Номер = 1 По 4 Цикл
		Колонка = КолонкаСекции(Номер);
		Область = Документ.Область(НомерСтроки, Колонка, НомерСтроки, Колонка + ШиринаСекции(Номер) - 1);
		Область.Объединить();
		Область.Текст = Названия[Номер - 1];
		Область.Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Заголовки = СтрРазделить(Колонки[Номер - 1], ",");
		Для Индекс = 0 По Заголовки.ВГраница() Цикл
			Ячейка = Документ.Область(НомерСтроки + 1, Колонка + Индекс, НомерСтроки + 1, Колонка + Индекс);
			Ячейка.Текст = Заголовки[Индекс];
			Ячейка.Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
			Ячейка.ЦветФона = WebЦвета.ДымчатоБелый;
			Ячейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиЯчейку(Документ, НомерСтроки, Колонка, Текст, Расшифровка = Неопределено)

	Ячейка = Документ.Область(НомерСтроки, Колонка, НомерСтроки, Колонка);
	Ячейка.Текст = Текст;
	Если Расшифровка <> Неопределено Тогда
		Ячейка.Расшифровка = Расшифровка;
	КонецЕсли;

КонецПроцедуры

Процедура НастроитьКолонки(Документ)

	Ширины = Новый Массив;
	// BSLLS:MagicNumber-off - ширины колонок секций в символах.
	Ширины.Добавить("11,22,14,14,18,10,10");
	Ширины.Добавить("11,10,22,10,10,18");
	Ширины.Добавить("11,10,22,10,18,18");
	Ширины.Добавить("11,14,22,10,18");
	// BSLLS:MagicNumber-on
	Для Номер = 1 По 4 Цикл
		Значения = СтрРазделить(Ширины[Номер - 1], ",");
		Для Индекс = 0 По Значения.ВГраница() Цикл
			Колонка = КолонкаСекции(Номер) + Индекс;
			Документ.Область(1, Колонка, 1, Колонка).ШиринаКолонки = Число(Значения[Индекс]);
		КонецЦикла;
		Если Номер < 4 Тогда
			Разделитель = КолонкаСекции(Номер) + ШиринаСекции(Номер);
			Документ.Область(1, Разделитель, 1, Разделитель).ШиринаКолонки = 2;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Первая колонка секции: секции идут подряд, между ними - узкая колонка-разделитель.
//
// Параметры:
//  Номер - Число - номер секции, 1-4.
//
// Возвращаемое значение:
//  Число - номер колонки.
//
Функция КолонкаСекции(Номер)

	Колонка = 1;
	Для Индекс = 1 По Номер - 1 Цикл
		Колонка = Колонка + ШиринаСекции(Индекс) + 1;
	КонецЦикла;
	Возврат Колонка;

КонецФункции

Функция ШиринаСекции(Номер)

	// BSLLS:MagicNumber-off - число колонок секций: материал, выпуск, передача, отгрузка.
	Ширины = СтрРазделить("7,6,6,5", ",");
	// BSLLS:MagicNumber-on
	Возврат Число(Ширины[Номер - 1]);

КонецФункции

Функция ПоследняяКолонка()

	Возврат КолонкаСекции(4) + ШиринаСекции(4) - 1;

КонецФункции

Функция ФорматКоличества(Количество)

	Возврат Формат(Количество, "ЧДЦ=3; ЧН=0");

КонецФункции

