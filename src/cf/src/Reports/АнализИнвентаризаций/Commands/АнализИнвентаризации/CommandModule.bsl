// Анализ инвентаризации из формы и списка пересчёта товаров (docs/plans/retail-tools.md, п. 2).

#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ПараметрыОтчета = Новый Структура("Инвентаризация", ПараметрКоманды);
	// BSLLS:YoLetterUsage-off - имя экспортной функции общего модуля пишется через «ё».
	ПользовательскиеНастройки = ОбщегоНазначенияВызовСервера.УстановитьНастройкиОтчёта("АнализИнвентаризаций",
		ПараметрыОтчета, Новый Структура);
	// BSLLS:YoLetterUsage-on
	ПараметрыФормы = Новый Структура("ПользовательскиеНастройки, СформироватьПриОткрытии", ПользовательскиеНастройки, Истина);
	ОткрытьФорму("Отчет.АнализИнвентаризаций.ФормаОбъекта", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно);
КонецПроцедуры

#КонецОбласти
