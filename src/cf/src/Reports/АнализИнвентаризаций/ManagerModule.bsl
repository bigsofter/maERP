// Анализ инвентаризации (docs/plans/retail-tools.md, п. 2): движения склада между сопоставимой предыдущей
// инвентаризацией и этим пересчётом по показателям движения, учётное и фактическое количество пересчёта и расхождение.
// Учёт и факт - сохранённые в строках пересчёта (по ним созданы корректировки); справочно - остаток по текущим
// движениям и «Изменение истории». Состав - строки пересчёта, а не текущая товарная группа номенклатуры.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Данные отчёта по пересчёту.
//
// Параметры:
//  Пересчет - ДокументСсылка.ПересчётТоваров - записанный пересчёт.
//
// Возвращаемое значение:
//  Структура - Строки (ТаблицаЗначений - поля набора «Строки» схемы), Предупреждения (Массив из Строка),
//              Предыдущая (ДокументСсылка.ПересчётТоваров, Неопределено - граница периода).
//
Функция ДанныеАнализа(Пересчет) Экспорт

	Результат = Новый Структура("Строки, Предупреждения, Предыдущая", НоваяТаблицаСтрок(), Новый Массив, Неопределено);
	Если Не ЗначениеЗаполнено(Пересчет) Тогда
		Возврат Результат;
	КонецЕсли;
	// Пересчёт записывается, а не проводится (в форме нет проведения): в анализ идут записанные, не помеченные на
	// удаление пересчёты.
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Пересчет, "ПометкаУдаления, МестоХранения, ТоварнаяГруппа");
	Если Данные.ПометкаУдаления = Истина Тогда
		Результат.Предупреждения.Добавить(НСтр("ru = 'Пересчёт помечен на удаление';
			|fr = 'L''inventaire est marqué pour suppression';
			|en = 'The stock count is marked for deletion';
			|es = 'El recuento está marcado para eliminación'"));
		Возврат Результат;
	КонецЕсли;
	ЗаполнитьСтрокиПересчета(Результат.Строки, Пересчет);
	Номенклатура = Результат.Строки.ВыгрузитьКолонку("Номенклатура");
	Момент = Пересчет.МоментВремени();
	Предыдущая = ПредыдущаяИнвентаризация(Пересчет, Данные);
	Результат.Предыдущая = Предыдущая;
	ГраницаНачала = Неопределено;
	Если Предыдущая <> Неопределено Тогда
		КонецПредыдущей = КонецИнвентаризации(Предыдущая);
		Если КонецПредыдущей.Сравнить(Момент) > 0 Тогда
			Результат.Предупреждения.Добавить(ТекстПересечения());
			ЗаполнитьОстатокПриПересечении(Результат.Строки);
			ДобавитьСправочныеКолонки(Результат, Пересчет, Номенклатура);
			Возврат Результат;
		КонецЕсли;
		ГраницаНачала = Новый Граница(КонецПредыдущей, ВидГраницы.Включая);
		ДобавитьОстатки(Результат.Строки, Данные.МестоХранения, Номенклатура, ГраницаНачала);
		ГраницаНачала = Новый Граница(КонецПредыдущей, ВидГраницы.Исключая);
	КонецЕсли;
	ДобавитьОбороты(Результат.Строки, Данные.МестоХранения, Номенклатура, ГраницаНачала,
		Новый Граница(Момент, ВидГраницы.Включая), Неопределено);
	КонецТекущей = КонецИнвентаризации(Пересчет);
	Если КонецТекущей.Сравнить(Момент) > 0 Тогда
		ДобавитьОбороты(Результат.Строки, Данные.МестоХранения, Номенклатура, Новый Граница(Момент, ВидГраницы.Исключая),
			Новый Граница(КонецТекущей, ВидГраницы.Включая), КорректировкиИнвентаризации(Пересчет));
	КонецЕсли;
	ДобавитьСправочныеКолонки(Результат, Пересчет, Номенклатура);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблицаСтрок()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Таблица.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	РазрядностьКоличества = 15;
	ТочностьКоличества = 3;
	Число = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьКоличества, ТочностьКоличества));
	Для Каждого Имя Из СтрРазделить(ИменаКоличеств(), ",") Цикл
		Таблица.Колонки.Добавить(Имя, Число);
	КонецЦикла;
	Таблица.Индексы.Добавить("Номенклатура, Характеристика, Серия");
	Возврат Таблица;

КонецФункции

Функция ИменаКоличеств()
	Возврат "ОстатокНаНачало,Поступило,Продано,ВозвратыОтПокупателей,ВозвратыПоставщикам,Списано,Оприходовано,"
		+ "ПеремещениеСписание,ПеремещениеОприходование,Прочее,Учет,Факт,Расхождение,ПослеПересчета,ТекущийУчет,"
		+ "ИзменениеИстории";
КонецФункции

Процедура ЗаполнитьСтрокиПересчета(Строки, Пересчет)

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Серия КАК Серия,
	|	СУММА(Товары.Количество) КАК Учет,
	|	СУММА(Товары.КоличествоФакт) КАК Факт
	|ИЗ
	|	Документ.ПересчётТоваров.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Пересчет
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	Товары.Серия");
	Запрос.УстановитьПараметр("Пересчет", Пересчет);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.Расхождение = Строка.Факт - Строка.Учет;
	КонецЦикла;

КонецПроцедуры

// Сопоставимая предыдущая инвентаризация: последний не помеченный на удаление пересчёт того же склада раньше текущего, чей охват
// содержит охват текущего (полный - для любого, пересчёт группы - только для той же группы).
//
// Параметры:
//  Пересчет - ДокументСсылка.ПересчётТоваров - текущий пересчёт.
//  Данные   - Структура - МестоХранения, ТоварнаяГруппа текущего пересчёта.
//
// Возвращаемое значение:
//  ДокументСсылка.ПересчётТоваров, Неопределено - предыдущий; Неопределено - нет.
//
Функция ПредыдущаяИнвентаризация(Пересчет, Данные)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пересчеты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПересчётТоваров КАК Пересчеты
	|ГДЕ
	|	НЕ Пересчеты.ПометкаУдаления
	|	И Пересчеты.МестоХранения = &МестоХранения
	|	И Пересчеты.ТоварнаяГруппа В (&Группы)
	|	И Пересчеты.МоментВремени < &Момент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пересчеты.МоментВремени УБЫВ");
	Группы = Новый Массив;
	Группы.Добавить(Справочники.ТоварныеГруппы.ПустаяСсылка());
	Если ЗначениеЗаполнено(Данные.ТоварнаяГруппа) Тогда
		Группы.Добавить(Данные.ТоварнаяГруппа);
	КонецЕсли;
	Запрос.УстановитьПараметр("МестоХранения", Данные.МестоХранения);
	Запрос.УстановитьПараметр("Группы", Группы);
	Запрос.УстановитьПараметр("Момент", Пересчет.МоментВремени());
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Проведённые, не помеченные на удаление списания и оприходования по пересчёту на его складе.
//
// Параметры:
//  Пересчет - ДокументСсылка.ПересчётТоваров - пересчёт.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка - корректировки.
//
Функция КорректировкиИнвентаризации(Пересчет)

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Списания.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СписаниеТоваров КАК Списания
	|ГДЕ
	|	Списания.Основание = &Пересчет
	|	И Списания.МестоХранения = &МестоХранения
	|	И Списания.Проведен
	|	И НЕ Списания.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Оприходования.Ссылка
	|ИЗ
	|	Документ.ОприходованиеТоваров КАК Оприходования
	|ГДЕ
	|	Оприходования.Основание = &Пересчет
	|	И Оприходования.МестоХранения = &МестоХранения
	|	И Оприходования.Проведен
	|	И НЕ Оприходования.ПометкаУдаления");
	Запрос.УстановитьПараметр("Пересчет", Пересчет);
	Запрос.УстановитьПараметр("МестоХранения", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пересчет, "МестоХранения"));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Конец инвентаризации - самый поздний момент её корректировок, без них - момент самого пересчёта.
//
// Параметры:
//  Пересчет - ДокументСсылка.ПересчётТоваров - пересчёт.
//
// Возвращаемое значение:
//  МоментВремени - конец.
//
Функция КонецИнвентаризации(Пересчет)

	Конец = Пересчет.МоментВремени();
	Для Каждого Корректировка Из КорректировкиИнвентаризации(Пересчет) Цикл
		МоментКорректировки = Корректировка.МоментВремени();
		Если МоментКорректировки.Сравнить(Конец) > 0 Тогда
			Конец = МоментКорректировки;
		КонецЕсли;
	КонецЦикла;
	Возврат Конец;

КонецФункции

Процедура ДобавитьОстатки(Строки, Склад, Номенклатура, Граница)

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Остатки(
	|			&Граница,
	|			МестоХранения = &Склад
	|				И Номенклатура В (&Номенклатура)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика,
	|	Остатки.Серия");
	Запрос.УстановитьПараметр("Граница", Граница);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = СтрокаПозиции(Строки, Выборка);
		Если Строка <> Неопределено Тогда
			Строка.ОстатокНаНачало = Строка.ОстатокНаНачало + Выборка.Количество;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Обороты склада по показателям движения (правила - как у отчёта «Движения товара»: перемещение - приходом и расходом
// отдельно). Исключаемые - регистраторы, которые не учитываются (корректировки самой инвентаризации); при них обороты
// идут в колонку «После пересчёта».
//
// Параметры:
//  Строки       - ТаблицаЗначений - строки отчёта, дополняются.
//  Склад        - СправочникСсылка.МестаХранения - склад.
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - товары строк.
//  Начало       - Граница, Неопределено - начало периода.
//  Конец        - Граница - конец периода.
//  Исключаемые  - Массив из ДокументСсылка, Неопределено - не учитываемые регистраторы; заданы - колонка «После
//                 пересчёта».
//
Процедура ДобавитьОбороты(Строки, Склад, Номенклатура, Начало, Конец, Исключаемые)

	Запрос = Новый Запрос(ТекстОборотов());
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Исключаемые", ?(Исключаемые = Неопределено, Новый Массив, Исключаемые));
	ПослеПересчета = Исключаемые <> Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = СтрокаПозиции(Строки, Выборка);
		Если Строка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Колонка = ?(ПослеПересчета, "ПослеПересчета", Выборка.Показатель);
		Строка[Колонка] = Строка[Колонка] + Выборка.Количество;
	КонецЦикла;

КонецПроцедуры

Функция ТекстОборотов()
	Возврат "ВЫБРАТЬ
	|	Обороты.Номенклатура КАК Номенклатура,
	|	Обороты.Характеристика КАК Характеристика,
	|	Обороты.Серия КАК Серия,
	|	ВЫБОР
	|		КОГДА Обороты.Регистратор ССЫЛКА Документ.СписаниеТоваров
	|			ТОГДА ""Списано""
	|		КОГДА Обороты.Регистратор ССЫЛКА Документ.ОприходованиеТоваров
	|			ТОГДА ""Оприходовано""
	|		КОГДА Обороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|				ИЛИ Обороты.Регистратор ССЫЛКА Документ.РасходныйОрдер
	|			ТОГДА ""Продано""
	|		КОГДА Обороты.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|				ИЛИ Обороты.Регистратор ССЫЛКА Документ.ПриходныйОрдер
	|			ТОГДА ""Поступило""
	|		КОГДА Обороты.Регистратор ССЫЛКА Документ.ВозвратОтПокупателя
	|			ТОГДА ""ВозвратыОтПокупателей""
	|		КОГДА Обороты.Регистратор ССЫЛКА Документ.ВозвратПоставщику
	|			ТОГДА ""ВозвратыПоставщикам""
	|		ИНАЧЕ ""Прочее""
	|	КОНЕЦ КАК Показатель,
	|	СУММА(Обороты.КоличествоОборот) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Обороты(
	|			&Начало,
	|			&Конец,
	|			Регистратор,
	|			МестоХранения = &Склад
	|				И Номенклатура В (&Номенклатура)) КАК Обороты
	|ГДЕ
	|	НЕ Обороты.Регистратор В (&Исключаемые)
	|	И НЕ Обороты.Регистратор ССЫЛКА Документ.ПеремещениеТоваров
	|
	|СГРУППИРОВАТЬ ПО
	|	Обороты.Номенклатура,
	|	Обороты.Характеристика,
	|	Обороты.Серия,
	|	Обороты.Регистратор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Перемещения.Номенклатура,
	|	Перемещения.Характеристика,
	|	Перемещения.Серия,
	|	""ПеремещениеОприходование"",
	|	СУММА(Перемещения.КоличествоПриход)
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Обороты(
	|			&Начало,
	|			&Конец,
	|			Регистратор,
	|			МестоХранения = &Склад
	|				И Номенклатура В (&Номенклатура)) КАК Перемещения
	|ГДЕ
	|	Перемещения.Регистратор ССЫЛКА Документ.ПеремещениеТоваров
	|	И Перемещения.КоличествоПриход <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	Перемещения.Номенклатура,
	|	Перемещения.Характеристика,
	|	Перемещения.Серия
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Перемещения.Номенклатура,
	|	Перемещения.Характеристика,
	|	Перемещения.Серия,
	|	""ПеремещениеСписание"",
	|	-СУММА(Перемещения.КоличествоРасход)
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии.Обороты(
	|			&Начало,
	|			&Конец,
	|			Регистратор,
	|			МестоХранения = &Склад
	|				И Номенклатура В (&Номенклатура)) КАК Перемещения
	|ГДЕ
	|	Перемещения.Регистратор ССЫЛКА Документ.ПеремещениеТоваров
	|	И Перемещения.КоличествоРасход <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	Перемещения.Номенклатура,
	|	Перемещения.Характеристика,
	|	Перемещения.Серия";
КонецФункции

Функция СтрокаПозиции(Строки, Позиция)
	Найдено = Строки.НайтиСтроки(ОтборПозиции(Позиция));
	Возврат ?(Найдено.Количество() = 0, Неопределено, Найдено[0]);
КонецФункции

Функция ОтборПозиции(Позиция)
	Возврат Новый Структура("Номенклатура, Характеристика, Серия", Позиция.Номенклатура, Позиция.Характеристика,
		Позиция.Серия);
КонецФункции

Процедура ЗаполнитьОстатокПриПересечении(Строки)
	Для Каждого Строка Из Строки Цикл
		Строка.ОстатокНаНачало = Строка.Учет;
	КонецЦикла;
КонецПроцедуры

// Справочно: остаток на границу пересчёта по текущим движениям (тот же расчёт, что формирует учётное количество
// пересчёта, по набору номенклатуры строк) и его отличие от сохранённого учёта.
//
// Параметры:
//  Результат    - Структура - см. ДанныеАнализа, дополняется.
//  Пересчет     - ДокументСсылка.ПересчётТоваров - пересчёт.
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - товары строк.
//
Процедура ДобавитьСправочныеКолонки(Результат, Пересчет, Номенклатура)

	// BSLLS:YoLetterUsage-off - имя документа в метаданных пишется через «ё».
	Текущие = Документы.ПересчётТоваров.УчетныеОстатки(Пересчет.ПолучитьОбъект(), Номенклатура);
	// BSLLS:YoLetterUsage-on
	Текущие.Индексы.Добавить("Номенклатура, Характеристика, Серия");
	ЕстьИзменения = Ложь;
	Для Каждого Строка Из Результат.Строки Цикл
		Найдено = Текущие.НайтиСтроки(ОтборПозиции(Строка));
		Для Каждого Текущая Из Найдено Цикл
			Строка.ТекущийУчет = Строка.ТекущийУчет + Текущая.Количество;
		КонецЦикла;
		Строка.ИзменениеИстории = Строка.ТекущийУчет - Строка.Учет;
		ЕстьИзменения = ЕстьИзменения Или Строка.ИзменениеИстории <> 0;
	КонецЦикла;
	Если ЕстьИзменения Тогда
		Результат.Предупреждения.Добавить(НСтр("ru = 'Движения до пересчёта изменены после него: см. колонку «Изменение истории»';
			|fr = 'Les mouvements antérieurs à l''inventaire ont été modifiés après : voir la colonne « Modification de l''historique »';
			|en = 'Movements before the stock count were changed after it: see the ""History change"" column';
			|es = 'Los movimientos anteriores al recuento se modificaron después: vea la columna «Cambio del historial»'"));
	КонецЕсли;

КонецПроцедуры

Функция ТекстПересечения()
	Возврат НСтр("ru = 'Инвентаризации пересекаются: корректировки предыдущей позже этого пересчёта';
		|fr = 'Les inventaires se chevauchent : les corrections du précédent sont postérieures à cet inventaire';
		|en = 'Stock counts overlap: the previous count''s adjustments are later than this count';
		|es = 'Los inventarios se solapan: los ajustes del anterior son posteriores a este recuento'");
КонецФункции

#КонецОбласти

#КонецЕсли
