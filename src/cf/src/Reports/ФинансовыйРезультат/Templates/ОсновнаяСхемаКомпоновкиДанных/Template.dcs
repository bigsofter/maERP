						<v8:item>
							<v8:lang>fr</v8:lang>
							<v8:content>DF = MMMM.yyyy</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>DF = MMMM.yyyy</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>es</v8:lang>
