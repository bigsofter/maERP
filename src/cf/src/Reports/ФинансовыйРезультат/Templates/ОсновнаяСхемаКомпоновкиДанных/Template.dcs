		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СтатьиФинансовогоРезультата.Ссылка КАК Группа,
	ПродажиОбороты.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	ПродажиОбороты.ВыручкаОборот - ПродажиОбороты.НДСОборот КАК Сумма,
	СтатьиФинансовогоРезультата.Порядок КАК Порядок,
	ПродажиОбороты.ПериодМесяц КАК ПериодМесяц,
	ПродажиОбороты.ДокументПродажи.МестоХранения КАК МестоХранения
ИЗ
	РегистрНакопления.Продажи.Обороты(, , Авто, НЕ Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)) КАК ПродажиОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиФинансовогоРезультата КАК СтатьиФинансовогоРезультата
		ПО (СтатьиФинансовогоРезультата.Ссылка = ЗНАЧЕНИЕ(Справочник.СтатьиФинансовогоРезультата.VentesProduit))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СтатьиФинансовогоРезультата.Ссылка,
	ПродажиОбороты.ХозяйственнаяОперация,
	-ПродажиОбороты.СебестоимостьОборот + ПродажиОбороты.ДополнительныеРасходыОборот,
	СтатьиФинансовогоРезультата.Порядок,
	ПродажиОбороты.ПериодМесяц,
	ПродажиОбороты.ДокументПродажи.МестоХранения
ИЗ
	РегистрНакопления.Продажи.Обороты(, , Авто, НЕ Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)) КАК ПродажиОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиФинансовогоРезультата КАК СтатьиФинансовогоРезультата
		ПО (СтатьиФинансовогоРезультата.Ссылка = ЗНАЧЕНИЕ(Справочник.СтатьиФинансовогоРезультата.ACHAT))

//ОБЪЕДИНИТЬ ВСЕ

//ВЫБРАТЬ
//	СтатьиФинансовогоРезультата.Ссылка,
//	ПродажиОбороты.ХозяйственнаяОперация,
//	ПродажиОбороты.ВаловаяПрибыльОборот,
//	СтатьиФинансовогоРезультата.Порядок,
//	ПродажиОбороты.ПериодМесяц,
//	ПродажиОбороты.ДокументПродажи.МестоХранения
//ИЗ
//	РегистрНакопления.Продажи.Обороты(, , Авто, НЕ Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)) КАК ПродажиОбороты
//		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиФинансовогоРезультата КАК СтатьиФинансовогоРезультата
//		ПО (СтатьиФинансовогоРезультата.Ссылка = ЗНАЧЕНИЕ(Справочник.СтатьиФинансовогоРезультата.MARGE))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СтатьиФинансовогоРезультата.Ссылка,
	ПродажиОбороты.ХозяйственнаяОперация,
	ПродажиОбороты.ВыручкаОборот,
	СтатьиФинансовогоРезультата.Порядок,
	ПродажиОбороты.ПериодМесяц,
	ПродажиОбороты.ДокументПродажи.МестоХранения
ИЗ
	РегистрНакопления.Продажи.Обороты(, , Авто, Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)) КАК ПродажиОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиФинансовогоРезультата КАК СтатьиФинансовогоРезультата
		ПО (СтатьиФинансовогоРезультата.Ссылка = ЗНАЧЕНИЕ(Справочник.СтатьиФинансовогоРезультата.VentesServices))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СтатьиФинансовогоРезультата.Ссылка,
	УбыткиОбороты.СтатьяДДС,
	-УбыткиОбороты.СуммаОборот,
	СтатьиФинансовогоРезультата.Порядок,
	УбыткиОбороты.ПериодМесяц,
	УбыткиОбороты.МестоХранения
ИЗ
	РегистрНакопления.Убытки.Обороты(
			,
			,
			Авто,
			НЕ ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыплатаЗарплаты)
				И НЕ МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)) КАК УбыткиОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиФинансовогоРезультата КАК СтатьиФинансовогоРезультата
		ПО (СтатьиФинансовогоРезультата.Ссылка = ЗНАЧЕНИЕ(Справочник.СтатьиФинансовогоРезультата.ChargesDuSITE))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СтатьиФинансовогоРезультата.Ссылка,
	УбыткиОбороты.СтатьяДДС,
	-УбыткиОбороты.СуммаОборот,
	СтатьиФинансовогоРезультата.Порядок,
	УбыткиОбороты.ПериодМесяц,
	УбыткиОбороты.МестоХранения
ИЗ
	РегистрНакопления.Убытки.Обороты(
			,
			,
			Авто,
			ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыплатаЗарплаты)
				И НЕ МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)) КАК УбыткиОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиФинансовогоРезультата КАК СтатьиФинансовогоРезультата
		ПО (СтатьиФинансовогоРезультата.Ссылка = ЗНАЧЕНИЕ(Справочник.СтатьиФинансовогоРезультата.SalairesDuSITE))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СтатьиФинансовогоРезультата.Ссылка,
	УбыткиОбороты.СтатьяДДС,
	-УбыткиОбороты.СуммаОборот * МестаХранения.ДоляОбщихРасходов / 100,
	СтатьиФинансовогоРезультата.Порядок,
	УбыткиОбороты.ПериодМесяц,
	МестаХранения.Ссылка
ИЗ
	РегистрНакопления.Убытки.Обороты(
			,
			,
			Авто,
			НЕ ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыплатаЗарплаты)
				И МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)) КАК УбыткиОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиФинансовогоРезультата КАК СтатьиФинансовогоРезультата
		ПО (СтатьиФинансовогоРезультата.Ссылка = ЗНАЧЕНИЕ(Справочник.СтатьиФинансовогоРезультата.ChargeGlobale))
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МестаХранения КАК МестаХранения
		ПО (НЕ МестаХранения.ДоляОбщихРасходов = 0)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СтатьиФинансовогоРезультата.Ссылка,
	УбыткиОбороты.СтатьяДДС,
	-УбыткиОбороты.СуммаОборот * МестаХранения.ДоляОбщихРасходов / 100,
	СтатьиФинансовогоРезультата.Порядок,
	УбыткиОбороты.ПериодМесяц,
	МестаХранения.Ссылка
ИЗ
	РегистрНакопления.Убытки.Обороты(
			,
			,
			Авто,
			ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыплатаЗарплаты)
				И МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)) КАК УбыткиОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиФинансовогоРезультата КАК СтатьиФинансовогоРезультата
		ПО (СтатьиФинансовогоРезультата.Ссылка = ЗНАЧЕНИЕ(Справочник.СтатьиФинансовогоРезультата.ChargeGlobale))
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МестаХранения КАК МестаХранения
		ПО (НЕ МестаХранения.ДоляОбщихРасходов = 0)

УПОРЯДОЧИТЬ ПО
	Порядок</query>
	</dataSet>
	<calculatedField>
		<dataPath>MargeNet</dataPath>
		<expression/>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Marge net</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Marge net</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Net margin</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Margen neto</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>Сумма</dataPath>
		<expression>Сумма(Сумма)</expression>
	</totalField>
	<totalField>
		<dataPath>MargeNet</dataPath>
		<expression>ВычислитьВыражение("Сумма(Сумма)", "Группа",)</expression>
	</totalField>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Début de la période</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Beginning of the period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Comienzo del período</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Fin de période</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>End of period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Fin del período</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
