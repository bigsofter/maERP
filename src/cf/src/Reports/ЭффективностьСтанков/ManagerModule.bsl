#Область ПрограммныйИнтерфейс

// Данные отчёта «Эффективность станков (OEE)» одной таблицей - внешний набор «Эффективность» схемы. Строка на станок -
// фонд, плановые остановки и работа по категориям времени (по режиму, до момента расчёта); строка на требование,
// завершённое в периоде, - часы, норма, кг материалов и выпуска (ЗагрузкаСтанков.ЗавершенныеТребования). Доступность,
// производительность, качество и OEE считает схема по суммам. Вес выпуска - из карточки продукции (ответ владельца
// 2026-10-08): продукция без веса в качество не входит. Отчёт и тест зовут эту функцию одинаково.
//
// Параметры:
//  Период - СтандартныйПериод - период отчёта
//  Момент - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  Структура:
//   * Эффективность  - ТаблицаЗначений - колонки полей набора схемы
//   * Предупреждение - Строка - что посчитать нельзя (вес, выработка, календарь); пустая - всё посчитано
//
Функция ДанныеОтчета(Период, Момент = Неопределено) Экспорт

	Границы = ЗагрузкаСтанков.ГраницыПериодаОтчета(Период);
	Станки = ЗагрузкаСтанков.СтанкиОтчетов(Границы.Начало, Границы.Окончание);
	Эффективность = НоваяТаблицаДанных();
	Категории = ЗагрузкаСтанков.КатегорииВремени(Станки, Границы.Начало, Границы.Окончание, Момент);
	СтрокиСтанков = Новый Соответствие;
	Для Каждого Строка Из Категории Цикл
		НоваяСтрока = СтрокиСтанков.Получить(Строка.Станок);
		Если НоваяСтрока = Неопределено Тогда
			НоваяСтрока = Эффективность.Добавить();
			НоваяСтрока.Станок = Строка.Станок;
			СтрокиСтанков.Вставить(Строка.Станок, НоваяСтрока);
		КонецЕсли;
		НоваяСтрока.Фонд = НоваяСтрока.Фонд + Строка.Фонд;
		НоваяСтрока.ПлановыеОстановки = НоваяСтрока.ПлановыеОстановки + Строка.ПлановыеОстановки;
		НоваяСтрока.Работа = НоваяСтрока.Работа + Строка.Работа;
	КонецЦикла;

	Завершенные = ЗагрузкаСтанков.ЗавершенныеТребования(Границы.Начало, Границы.Окончание, Момент);
	Коэффициенты = ЗагрузкаСтанков.КгНаЕдиницу(Завершенные.Требования.ВыгрузитьКолонку("Продукция"));
	БезВеса = Новый Массив;
	БезВыработки = Новый Массив;
	Для Каждого Требование Из Завершенные.Требования Цикл
		НоваяСтрока = Эффективность.Добавить();
		НоваяСтрока.Станок = Требование.Станок;
		НоваяСтрока.Продукция = Требование.Продукция;
		НоваяСтрока.Требование = Требование.Требование;
		НоваяСтрока.КгВход = Требование.Кг;
		// Требование без нормы (нет выработки станка для его веса) не размывает производительность: не входит ни часами, ни нормой.
		// Так же - требование с частью материалов без веса: норма по остальным занизила бы производительность (ревью Codex
		// волны 5, P2); позиции без веса названы в предупреждении.
		Если Требование.ЕстьМатериалыБезВеса Тогда
			Продолжить;
		ИначеЕсли Требование.НормаЧасов > 0 Тогда
			НоваяСтрока.ЧасыТребований = Требование.Часы;
			НоваяСтрока.НормаЧасов = Требование.НормаЧасов;
		Иначе
			ДобавитьБезПовторов(БезВыработки, Требование.Станок);
		КонецЕсли;
		// Вход качества - только требования, у которых посчитан вес всех материалов, а выпуск - с весом продукции.
		Если Требование.ЕстьМатериалыБезВеса Тогда
			Продолжить;
		КонецЕсли;
		Коэффициент = Коэффициенты.Получить(Требование.Продукция);
		Если ЗначениеЗаполнено(Коэффициент) Тогда
			НоваяСтрока.КгВыпуск = Окр(Требование.Выпущено * Коэффициент, ЗнаковВеса());
			НоваяСтрока.КгВходКачества = Требование.Кг;
		Иначе
			ДобавитьБезПовторов(БезВеса, Требование.Продукция);
		КонецЕсли;
	КонецЦикла;

	Части = Новый Массив;
	ДобавитьЧасть(Части, ЗагрузкаСтанков.ТекстПустогоКалендаря(Станки, Границы.Начало, Границы.Окончание));
	ДобавитьЧасть(Части, Завершенные.ПредупреждениеВеса);
	Если БезВеса.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Не задан вес продукции, качество по ней не считается и принято за полное: %1';
			|fr = 'Poids du produit non renseigné, qualité non calculée pour lui, considérée comme complète : %1';
			|en = 'Product weight not set, quality not calculated for it, taken as full: %1';
			|es = 'Peso del producto no indicado, la calidad no se calcula para él, se toma como completa: %1'");
		ДобавитьЧасть(Части, СтрШаблон(Шаблон, СтрСоединить(БезВеса, ", ")));
	КонецЕсли;
	Если БезВыработки.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Не задана выработка станка для продукции или материалов, производительность принята за полную: %1';
			|fr = 'Cadence de la machine non renseignée pour le produit ou les matières, performance considérée complète : %1';
			|en = 'Machine output rate not set for the product or materials, performance taken as full: %1';
			|es = 'Rendimiento de la máquina no indicado para el producto o materiales, se toma como completa: %1'");
		ДобавитьЧасть(Части, СтрШаблон(Шаблон, СтрСоединить(БезВыработки, ", ")));
	КонецЕсли;
	Возврат Новый Структура("Эффективность, Предупреждение", Эффективность, СтрСоединить(Части, Символы.ПС));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблицаДанных()

	ТипЧисла = Новый ОписаниеТипов("Число");
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Станок", Новый ОписаниеТипов("СправочникСсылка.ПроизводственноеОборудование"));
	Таблица.Колонки.Добавить("Продукция", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Требование", Новый ОписаниеТипов("ДокументСсылка.ТребованиеНакладная"));
	Для Каждого Имя Из СтрРазделить("Фонд,ПлановыеОстановки,Работа,ЧасыТребований,НормаЧасов,КгВход,КгВыпуск,КгВходКачества",
		",") Цикл
		Таблица.Колонки.Добавить(Имя, ТипЧисла);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Процедура ДобавитьЧасть(Части, Текст)

	Если ЗначениеЗаполнено(Текст) Тогда
		Части.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьБезПовторов(Массив, Значение)

	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

Функция ЗнаковВеса()

	Возврат 3;

КонецФункции

#КонецОбласти
