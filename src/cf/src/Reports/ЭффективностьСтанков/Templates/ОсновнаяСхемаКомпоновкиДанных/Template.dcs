	<totalField>
		<dataPath>Фонд</dataPath>
		<expression>Сумма(Фонд)</expression>
	</totalField>
	<totalField>
		<dataPath>ПлановыеОстановки</dataPath>
		<expression>Сумма(ПлановыеОстановки)</expression>
	</totalField>
	<totalField>
		<dataPath>Работа</dataPath>
		<expression>Сумма(Работа)</expression>
	</totalField>
	<totalField>
		<dataPath>ЧасыТребований</dataPath>
		<expression>Сумма(ЧасыТребований)</expression>
	</totalField>
	<totalField>
		<dataPath>НормаЧасов</dataPath>
		<expression>Сумма(НормаЧасов)</expression>
	</totalField>
	<totalField>
		<dataPath>КгВход</dataPath>
		<expression>Сумма(КгВход)</expression>
	</totalField>
	<totalField>
		<dataPath>КгВыпуск</dataPath>
		<expression>Сумма(КгВыпуск)</expression>
	</totalField>
	<totalField>
		<dataPath>КгВходКачества</dataPath>
		<expression>Сумма(КгВходКачества)</expression>
	</totalField>
	<totalField>
		<dataPath>Доступность</dataPath>
		<expression>Окр((Выбор Когда Сумма(Фонд) - Сумма(ПлановыеОстановки) &gt; 0 Тогда Сумма(Работа) / (Сумма(Фонд) - Сумма(ПлановыеОстановки)) Иначе 0 Конец) * 100, 1)</expression>
	</totalField>
	<totalField>
		<dataPath>Производительность</dataPath>
		<expression>Окр((Выбор Когда Сумма(ЧасыТребований) &gt; 0 И Сумма(НормаЧасов) &gt; 0 Тогда Сумма(НормаЧасов) / Сумма(ЧасыТребований) Иначе 1 Конец) * 100, 1)</expression>
	</totalField>
	<totalField>
		<dataPath>Качество</dataPath>
		<expression>Окр((Выбор Когда Сумма(КгВходКачества) &gt; 0 Тогда Сумма(КгВыпуск) / Сумма(КгВходКачества) Иначе 1 Конец) * 100, 1)</expression>
	</totalField>
	<totalField>
		<dataPath>OEE</dataPath>
		<expression>Окр((Выбор Когда Сумма(Фонд) - Сумма(ПлановыеОстановки) &gt; 0 Тогда Сумма(Работа) / (Сумма(Фонд) - Сумма(ПлановыеОстановки)) Иначе 0 Конец) * (Выбор Когда Сумма(ЧасыТребований) &gt; 0 И Сумма(НормаЧасов) &gt; 0 Тогда Сумма(НормаЧасов) / Сумма(ЧасыТребований) Иначе 1 Конец) * (Выбор Когда Сумма(КгВходКачества) &gt; 0 Тогда Сумма(КгВыпуск) / Сумма(КгВходКачества) Иначе 1 Конец) * 100, 1)</expression>
	</totalField>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Période</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Período</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">Custom</v8:variant>
			<v8:startDate>0001-01-01T00:00:00</v8:startDate>
			<v8:endDate>0001-01-01T00:00:00</v8:endDate>
		</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:pal="http://v8.1c.ru/8.1/data/ui/colors/palette" xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Фонд</dcsset:field>
