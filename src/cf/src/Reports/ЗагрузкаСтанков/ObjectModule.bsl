#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	// Набор схемы внешний: категории времени строит модуль менеджера (ДанныеОтчета).
	СтандартнаяОбработка = Ложь;
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Период = ЗагрузкаСтанков.ЗначениеПараметраОтчета(Настройки, "Период",
		Новый СтандартныйПериод(ВариантСтандартногоПериода.ЭтотМесяц));
	Данные = Отчеты.ЗагрузкаСтанков.ДанныеОтчета(Период);
	ЗагрузкаСтанков.ВывестиОтчет(ДокументРезультат, СхемаКомпоновкиДанных, Настройки,
		Новый Структура("Загрузка", Данные.Загрузка), Данные.Предупреждение);

КонецПроцедуры

#КонецОбласти
