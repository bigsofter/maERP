				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Format</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДЛФ=D</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fr</v8:lang>
							<v8:content>DLF=D</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>DLF=D</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>es</v8:lang>
							<v8:content>DLF = D</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫБОР
		КОГДА ДСО.Регистратор = НЕОПРЕДЕЛЕНО
			ТОГДА NULL
		ИНАЧЕ ДСО.Регистратор
	КОНЕЦ КАК Регистратор,
	ДСО.ПериодСекунда КАК ПериодСекунда,
	ДСО.ПериодДень КАК День,
	ДСО.Организация КАК Организация,
	ДСО.МестоХранения КАК МестоХранения,
	ДСО.ТипДенежныхСредств КАК ТипДенежныхСредств,
	ДСО.СуммаНачальныйОстаток КАК НачальныйОстаток,
	ДСО.СуммаПриход КАК Приход,
	ДСО.СуммаРасход КАК Расход,
	ДСО.СуммаКонечныйОстаток КАК КонечныйОстаток,
	ДСО.ПериодНеделя КАК Неделя,
	ДСО.ПериодМесяц КАК Месяц,
	ДСО.ПериодКвартал КАК Квартал,
	ДСО.ПериодПолугодие КАК Полугодие,
	ДСО.ПериодГод КАК Год,
	ВЫБОР
		КОГДА ДенежныеСредстваОрганизаций.Накладная = НЕОПРЕДЕЛЕНО
			ТОГДА NULL
		ИНАЧЕ ДенежныеСредстваОрганизаций.Накладная
	КОНЕЦ КАК Накладная,
	ВЫБОР
		КОГДА ДенежныеСредстваОрганизаций.ДокументДвижения = НЕОПРЕДЕЛЕНО
			ТОГДА NULL
		ИНАЧЕ ДенежныеСредстваОрганизаций.ДокументДвижения
	КОНЕЦ КАК Операция,
	ЕСТЬNULL(ДенежныеСредстваОрганизаций.Накладная.Номер, "") КАК НакладнаяНомер,
	ВЫБОР
		КОГДА ДенежныеСредстваОрганизаций.ДатаДвижения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			ТОГДА ДенежныеСредстваОрганизаций.ДокументДвижения.Дата
		ИНАЧЕ ДенежныеСредстваОрганизаций.ДатаДвижения
	КОНЕЦ КАК ДатаДвижения,
	ВЫБОР
		КОГДА ДСО.Регистратор.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.Инкассация)
			ТОГДА ДСО.Регистратор.БанковскийСчёт
		КОГДА ДСО.Регистратор.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПоступлениеДенежныхСредствИзКассы)
			ТОГДА ДСО.Регистратор.КассаИз
		ИНАЧЕ ЕСТЬNULL(ДенежныеСредстваОрганизаций.Накладная.Контрагент, ДенежныеСредстваОрганизаций.ДокументДвижения.Контрагент)
	КОНЕЦ КАК Контрагент
ИЗ
	РегистрНакопления.ДенежныеСредстваОрганизаций.ОстаткиИОбороты(
			,
			,
			Авто,
			,
			ТипДенежныхСредств = ЗНАЧЕНИЕ(Справочник.TypesDePayment.Cash)
				И Организация = &amp;Организация) КАК ДСО
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваОрганизаций КАК ДенежныеСредстваОрганизаций
		ПО ДСО.НомерСтроки = ДенежныеСредстваОрганизаций.НомерСтроки
			И ДСО.Регистратор = ДенежныеСредстваОрганизаций.Регистратор
			И ДСО.Организация = ДенежныеСредстваОрганизаций.Организация
			И ДСО.МестоХранения = ДенежныеСредстваОрганизаций.МестоХранения
			И ДСО.ТипДенежныхСредств = ДенежныеСредстваОрганизаций.ТипДенежныхСредств
ГДЕ
	НЕ ДенежныеСредстваОрганизаций.ДокументДвижения = НЕОПРЕДЕЛЕНО</query>
	</dataSet>
