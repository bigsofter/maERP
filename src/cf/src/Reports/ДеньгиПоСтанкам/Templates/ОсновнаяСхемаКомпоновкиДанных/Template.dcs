	<totalField>
		<dataPath>Выпущено</dataPath>
		<expression>Сумма(Выпущено)</expression>
	</totalField>
	<totalField>
		<dataPath>Выручка</dataPath>
		<expression>Сумма(Выручка)</expression>
	</totalField>
	<totalField>
		<dataPath>Материалы</dataPath>
		<expression>Сумма(Материалы)</expression>
	</totalField>
	<totalField>
		<dataPath>Часы</dataPath>
		<expression>Сумма(Часы)</expression>
	</totalField>
	<totalField>
		<dataPath>СтоимостьЧасов</dataPath>
		<expression>Сумма(СтоимостьЧасов)</expression>
	</totalField>
	<totalField>
		<dataPath>ЗатратыОбслуживания</dataPath>
		<expression>Сумма(ЗатратыОбслуживания)</expression>
	</totalField>
	<totalField>
		<dataPath>Кг</dataPath>
		<expression>Сумма(Кг)</expression>
	</totalField>
	<totalField>
		<dataPath>Маржа</dataPath>
		<expression>Сумма(Выручка) - Сумма(Материалы) - Сумма(СтоимостьЧасов) - Сумма(ЗатратыОбслуживания)</expression>
	</totalField>
	<totalField>
		<dataPath>МаржаНаЧас</dataPath>
		<expression>Выбор Когда Сумма(Часы) &gt; 0 Тогда Окр((Сумма(Выручка) - Сумма(Материалы) - Сумма(СтоимостьЧасов) - Сумма(ЗатратыОбслуживания)) / Сумма(Часы), 2) Иначе 0 Конец</expression>
	</totalField>
	<totalField>
		<dataPath>МаржаНаКг</dataPath>
		<expression>Выбор Когда Сумма(Кг) &gt; 0 Тогда Окр((Сумма(Выручка) - Сумма(Материалы) - Сумма(СтоимостьЧасов) - Сумма(ЗатратыОбслуживания)) / Сумма(Кг), 2) Иначе 0 Конец</expression>
	</totalField>
