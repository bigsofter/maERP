		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	НалоговаяНакладнаяТЧТовары.Ссылка КАК НалоговаяНакладная,
	НалоговаяНакладнаяТЧТовары.Ссылка.Организация КАК Организация,
	НалоговаяНакладнаяТЧТовары.Ссылка.Контрагент КАК Контрагент,
	НалоговаяНакладнаяТЧТовары.Ссылка.Дата КАК Дата,
	НалоговаяНакладнаяТЧТовары.Ссылка.Номер КАК Номер,
	СУММА(НалоговаяНакладнаяТЧТовары.СуммаНДС) КАК СуммаНДС,
	СУММА(НалоговаяНакладнаяТЧТовары.СуммаСНДС - НалоговаяНакладнаяТЧТовары.СуммаНДС) КАК СуммаБезНДС,
	СУММА(ВЫБОР
			КОГДА НалоговаяНакладнаяТЧТовары.СуммаНДС = 0
				ТОГДА 0
			ИНАЧЕ НалоговаяНакладнаяТЧТовары.СуммаСНДС
		КОНЕЦ) КАК СуммаСНДС
ИЗ
	Документ.НалоговаяНакладная.ТЧТовары КАК НалоговаяНакладнаяТЧТовары
ГДЕ
	НалоговаяНакладнаяТЧТовары.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И НалоговаяНакладнаяТЧТовары.Ссылка.Проведен

СГРУППИРОВАТЬ ПО
	НалоговаяНакладнаяТЧТовары.Ссылка,
	НалоговаяНакладнаяТЧТовары.Ссылка.Организация,
	НалоговаяНакладнаяТЧТовары.Ссылка.Контрагент,
	НалоговаяНакладнаяТЧТовары.Ссылка.Дата,
	НалоговаяНакладнаяТЧТовары.Ссылка.Номер</query>
	</dataSet>
