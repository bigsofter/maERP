#Область ПрограммныйИнтерфейс

// Данные отчёта «Простои станков» одной таблицей - внешний набор «Простои» схемы. В таблице строки простоев
// (обслуживание станков, пересёкшееся с периодом) и по строке фонда времени на станок: фонд не выражается
// запросом (режим работы по дням недели и производственный календарь), а связанный набор задвоил бы его в
// итогах по видам и причинам. MTBF и MTTR (волна 5): отказ - фактический «Ремонт или авария», не запланированный
// заранее (с плановыми датами он плановая остановка OEE); наработка - работа станка по категориям времени до момента
// расчёта, в строке фонда. Отказ относится к периоду своего начала и даёт MTTR полной длительностью ремонта. Плановое
// обслуживание, перекрытое фактическим, считается только вне факта: время станка не входит в простой дважды.
// Отчёт и тест зовут эту функцию одинаково.
//
// Параметры:
//  Период       - СтандартныйПериод - период отчёта
//  ВключатьПлан - Булево - брать и запланированное обслуживание
//  Момент       - Дата, Неопределено - момент расчёта наработки; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  Структура:
//   * Простои        - ТаблицаЗначений - колонки полей набора схемы
//   * Предупреждение - Строка - текст о незаполненном производственном календаре, пустой - всё в порядке
//
Функция ДанныеОтчета(Период, ВключатьПлан, Момент = Неопределено) Экспорт

	Начало = Период.ДатаНачала;
	Окончание = Период.ДатаОкончания;
	Если Не ЗначениеЗаполнено(Окончание) Тогда
		Окончание = КонецМесяца(?(ЗначениеЗаполнено(Начало), Начало, ТекущаяДатаСеанса()));
	КонецЕсли;
	// Период без начала обошёл бы фондом все дни с 0001 года: берётся месяц окончания.
	Если Не ЗначениеЗаполнено(Начало) Тогда
		Начало = НачалоМесяца(Окончание);
	КонецЕсли;
	// Интервалы полуоткрытые: последняя секунда периода входит в него.
	Окончание = Окончание + 1;

	Простои = НоваяТаблицаДанных();
	Станки = СтанкиОтчета(Начало, Окончание, ВключатьПлан, Момент);
	Записи = ЗаписиОбслуживания(Станки, Начало, Окончание, ВключатьПлан);
	Интервалы = ЗагрузкаСтанков.ИнтервалыРаботыСтанков(Станки, Начало, Окончание);

	Для Каждого Запись Из Записи Цикл
		ИнтервалС = Макс(Запись.Начало, Начало);
		ИнтервалПо = Мин(Запись.Окончание, Окончание);
		Части = ЧастиЗаписи(Записи, Запись, ИнтервалС, ИнтервалПо);
		Если Части.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ИнтервалыСтанка = Интервалы.НайтиСтроки(ОтборСтанка(Запись.Станок));
		Строка = Простои.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Запись);
		ВРабочееВремя = 0;
		Для Каждого Часть Из Части Цикл
			Строка.Часы = Строка.Часы + ЗагрузкаСтанков.ЧасыМеждуДатами(Часть.Начало, Часть.Окончание);
			ВРабочееВремя = ВРабочееВремя
				+ ЗагрузкаСтанков.ЧасыВРабочееВремя(ИнтервалыСтанка, Часть.Начало, Часть.Окончание);
		КонецЦикла;
		Строка.ЧасыВРабочееВремя = ЗагрузкаСтанков.ОкруглитьЧасы(ВРабочееВремя);
		Строка.Случаев = 1;
		// Отказ - в периоде своего начала: авария на стыке периодов не считается дважды (ревью кода волны 5, P2-3), а
		// MTTR берёт всю длительность ремонта, а не часть внутри периода (ревью Codex волны 5, P2).
		ЭтоОтказ = Не Запись.Плановое И Не Запись.БылЗапланирован И Запись.Начало >= Начало
			И Запись.ВидОбслуживания = Перечисления.ВидыОбслуживанияСтанков.Ремонт;
		Если ЭтоОтказ Тогда
			Строка.Отказов = 1;
			Строка.ЧасыОтказов = ЗагрузкаСтанков.ЧасыМеждуДатами(Запись.Начало, Запись.Окончание);
		КонецЕсли;
	КонецЦикла;
	Работа = ЗагрузкаСтанков.КатегорииВремени(Станки, Начало, Окончание, Момент);
	Для Каждого Станок Из Станки Цикл
		Строка = Простои.Добавить();
		Строка.Станок = Станок;
		ИнтервалыСтанка = Интервалы.НайтиСтроки(ОтборСтанка(Станок));
		Строка.Фонд = ЗагрузкаСтанков.ОкруглитьЧасы(ЗагрузкаСтанков.ЧасыИнтервалов(ИнтервалыСтанка));
		Строка.ЧасыРаботы = Работа.Скопировать(ОтборСтанка(Станок), "Работа").Итог("Работа");
	КонецЦикла;

	Предупреждение = ЗагрузкаСтанков.ТекстПустогоКалендаря(Станки, Начало, Окончание);
	Возврат Новый Структура("Простои, Предупреждение", Простои, Предупреждение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписиОбслуживания(Станки, Начало, Окончание, ВключатьПлан)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Загрузка.Станок КАК Станок,
	|	Загрузка.Начало КАК Начало,
	|	Загрузка.Окончание КАК Окончание,
	|	Загрузка.План КАК Плановое,
	|	Загрузка.Регистратор КАК Документ,
	|	Обслуживание.ВидОбслуживания КАК ВидОбслуживания,
	|	Обслуживание.Причина КАК Причина,
	|	ВЫБОР
	|		КОГДА Обслуживание.ПланОкончание > Обслуживание.ПланНачало
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК БылЗапланирован
	|ИЗ
	|	РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОбслуживаниеСтанка КАК Обслуживание
	|		ПО Загрузка.Регистратор = Обслуживание.Ссылка
	|ГДЕ
	|	Загрузка.Станок В (&Станки)
	|	И Загрузка.ВидЗаписи = ЗНАЧЕНИЕ(Перечисление.ВидыЗагрузкиСтанков.Обслуживание)
	|	И Загрузка.Начало < &Окончание
	|	И Загрузка.Окончание > &Начало
	|	И &УсловиеПлана
	|
	|УПОРЯДОЧИТЬ ПО
	|	Начало";
	Запрос.УстановитьПараметр("Станки", Станки);
	УстановитьПараметрыПериода(Запрос, Начало, Окончание, ВключатьПлан);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Станки отчёта: все действующие, а выведенные и помеченные на удаление - если в периоде у них есть работа или
// обслуживание (ревью кода волны 5, P3-6: выведенный станок с работой иначе выпадал из наработки MTBF). Запущенное
// требование идёт до момента расчёта, как в ЗагрузкаСтанков.КатегорииВремени (затянувшаяся загрузка). Записи
// «Загрузки станков» отбираются через ведущее измерение Станок.
//
// Параметры:
//  Начало       - Дата - начало периода
//  Окончание    - Дата - конец периода, не включается
//  ВключатьПлан - Булево - учитывать и запланированное
//  Момент       - Дата, Неопределено - момент расчёта; Неопределено - текущая дата сеанса
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ПроизводственноеОборудование
//
Функция СтанкиОтчета(Начало, Окончание, ВключатьПлан, Момент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Станки.Ссылка КАК Станок,
	|	Станки.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ПроизводственноеОборудование КАК Станки
	|ГДЕ
	|	НЕ Станки.ПометкаУдаления
	|	И НЕ Станки.Выведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Станки.Ссылка КАК Станок,
	|	Станки.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ПроизводственноеОборудование КАК Станки
	|ГДЕ
	|	НЕ(НЕ Станки.ПометкаУдаления
	|				И НЕ Станки.Выведен)
	|	И Станки.Ссылка В
	|			(ВЫБРАТЬ
	|				Загрузка.Станок КАК Станок
	|			ИЗ
	|				РегистрСведений.ЗагрузкаСтанков КАК Загрузка
	|					ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТребованиеНакладная КАК Требования
	|					ПО Загрузка.Регистратор = Требования.Ссылка
	|			ГДЕ
	|				Загрузка.Начало < &Окончание
	|				И ВЫБОР
	|						КОГДА Требования.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТребованийНакладных.Запущено)
	|								И НЕ Загрузка.План
	|							ТОГДА &Момент
	|						ИНАЧЕ Загрузка.Окончание
	|					КОНЕЦ > &Начало
	|				И &УсловиеПлана)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	УстановитьПараметрыПериода(Запрос, Начало, Окончание, ВключатьПлан);
	Запрос.УстановитьПараметр("Момент", ?(Момент = Неопределено, ТекущаяДатаСеанса(), Момент));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Станок");

КонецФункции

Процедура УстановитьПараметрыПериода(Запрос, Начало, Окончание, ВключатьПлан)

	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Если Не ВключатьПлан Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПлана", "НЕ Загрузка.План");
	КонецЕсли;
	Запрос.УстановитьПараметр("УсловиеПлана", Истина);

КонецПроцедуры

// Части интервала записи обслуживания, которые входят в простой: плановое - только вне фактического обслуживания
// станка (ревью Codex плана сборки 1, P2), иначе план и факт одного времени дали бы простой больше фонда.
//
// Параметры:
//  Записи     - ТаблицаЗначений - записи обслуживания периода по возрастанию начала
//  Запись     - СтрокаТаблицыЗначений - запись
//  ИнтервалС  - Дата - начало записи в периоде
//  ИнтервалПо - Дата - окончание записи в периоде
//
// Возвращаемое значение:
//  Массив из Структура - Начало, Окончание
//
Функция ЧастиЗаписи(Записи, Запись, ИнтервалС, ИнтервалПо)

	Если Запись.Плановое Тогда
		Факты = Записи.НайтиСтроки(Новый Структура("Станок, Плановое", Запись.Станок, Ложь));
		Возврат ЧастиВнеФакта(ИнтервалС, ИнтервалПо, Факты);
	КонецЕсли;
	Части = Новый Массив;
	Части.Добавить(Новый Структура("Начало, Окончание", ИнтервалС, ИнтервалПо));
	Возврат Части;

КонецФункции

// Части интервала планового обслуживания вне фактического обслуживания того же станка.
//
// Параметры:
//  ИнтервалС  - Дата - начало интервала
//  ИнтервалПо - Дата - окончание интервала
//  Факты      - Массив из СтрокаТаблицыЗначений - фактическое обслуживание станка по возрастанию начала
//
// Возвращаемое значение:
//  Массив из Структура - Начало, Окончание; пустой - план целиком внутри факта
//
Функция ЧастиВнеФакта(Знач ИнтервалС, Знач ИнтервалПо, Факты)

	Части = Новый Массив;
	Для Каждого Факт Из Факты Цикл
		Если Факт.Окончание <= ИнтервалС Или Факт.Начало >= ИнтервалПо Тогда
			Продолжить;
		КонецЕсли;
		Если Факт.Начало > ИнтервалС Тогда
			Части.Добавить(Новый Структура("Начало, Окончание", ИнтервалС, Факт.Начало));
		КонецЕсли;
		ИнтервалС = Макс(ИнтервалС, Факт.Окончание);
		Если ИнтервалС >= ИнтервалПо Тогда
			Возврат Части;
		КонецЕсли;
	КонецЦикла;
	Части.Добавить(Новый Структура("Начало, Окончание", ИнтервалС, ИнтервалПо));
	Возврат Части;

КонецФункции

Функция ОтборСтанка(Станок)

	Возврат Новый Структура("Станок", Станок);

КонецФункции

Функция НоваяТаблицаДанных()

	// Типы - из метаданных: часы как в регистре загрузки, причина как в документе.
	ТипЧисла = Метаданные.РегистрыСведений.ЗагрузкаСтанков.Ресурсы.Часы.Тип;
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Станок", Новый ОписаниеТипов("СправочникСсылка.ПроизводственноеОборудование"));
	Таблица.Колонки.Добавить("ВидОбслуживания", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОбслуживанияСтанков"));
	Таблица.Колонки.Добавить("Причина", Метаданные.Документы.ОбслуживаниеСтанка.Реквизиты.Причина.Тип);
	Таблица.Колонки.Добавить("Плановое", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка.ОбслуживаниеСтанка"));
	Таблица.Колонки.Добавить("Часы", ТипЧисла);
	Таблица.Колонки.Добавить("ЧасыВРабочееВремя", ТипЧисла);
	Таблица.Колонки.Добавить("Случаев", ТипЧисла);
	Таблица.Колонки.Добавить("Фонд", ТипЧисла);
	Таблица.Колонки.Добавить("Отказов", ТипЧисла);
	Таблица.Колонки.Добавить("ЧасыОтказов", ТипЧисла);
	Таблица.Колонки.Добавить("ЧасыРаботы", ТипЧисла);
	Возврат Таблица;

КонецФункции

#КонецОбласти
