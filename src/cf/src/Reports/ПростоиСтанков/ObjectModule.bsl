#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	// Набор схемы внешний: таблицу простоев и фонда времени строит модуль менеджера (ДанныеОтчета).
	СтандартнаяОбработка = Ложь;
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Период = ЗначениеПараметра(Настройки, "Период", Новый СтандартныйПериод(ВариантСтандартногоПериода.ЭтотМесяц));
	ВключатьПлан = ЗначениеПараметра(Настройки, "ВключатьПлан", Ложь) = Истина;
	// Отбор по полям обслуживания - в данные, а не в компоновку: иначе он убрал бы строку фонда (Codex, сборка 1, P2).
	ОтборыОтчета = Отчеты.ПростоиСтанков.ОтборыИзНастроек(Настройки);
	Данные = Отчеты.ПростоиСтанков.ДанныеОтчета(Период, ВключатьПлан, , ОтборыОтчета.Отборы);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	// Без расшифровки: повторная компоновка формы отчёта не получила бы внешний набор «Простои».
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки);
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, Новый Структура("Простои", Данные.Простои));
	ДокументРезультат.Очистить();
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

	Если ЗначениеЗаполнено(Данные.Предупреждение) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Данные.Предупреждение);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборыОтчета.Предупреждение) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОтборыОтчета.Предупреждение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеПараметра(Настройки, Имя, ПоУмолчанию)

	Значение = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(Имя));
	Если Значение = Неопределено Или Не Значение.Использование Или Не ЗначениеЗаполнено(Значение.Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Значение.Значение;

КонецФункции

#КонецОбласти
