		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Остатки.Заказ КАК Заказ,
	Остатки.Продукция КАК Продукция,
	Остатки.Материал КАК Материал,
	Остатки.Характеристика КАК Характеристика,
	Остатки.ПотребностьОстаток КАК Потребность,
	Остатки.ЗаказаноОстаток КАК Заказано,
	Остатки.ПришлоОстаток КАК Пришло,
	Остатки.ИзОстаткаОстаток КАК ИзОстатка,
	Остатки.ПотребностьОстаток - Остатки.ЗаказаноОстаток КАК Дефицит,
	ВЫБОР
		КОГДА Остатки.ПотребностьОстаток - Остатки.ЗаказаноОстаток &gt; 0
			ТОГДА Остатки.ПотребностьОстаток - Остатки.ЗаказаноОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК КЗаказу
ИЗ
	РегистрНакопления.ПотребностиПроизводства.Остатки КАК Остатки
ГДЕ
	(НЕ &amp;ТолькоДефицит
			ИЛИ Остатки.ПотребностьОстаток - Остатки.ЗаказаноОстаток &gt; 0)</query>
	</dataSet>
