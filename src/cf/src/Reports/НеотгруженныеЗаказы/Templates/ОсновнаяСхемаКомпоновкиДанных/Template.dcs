							<dcscor:value xsi:type="v8:LocalStringType">
								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>ЧЦ=5</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>fr</v8:lang>
