<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Менеджер</dataPath>
			<field>Менеджер</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Отгружено</dataPath>
			<field>Отгружено</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Отгружено</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fr</v8:lang>
					<v8:content>Expédié</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Shipped</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>es</v8:lang>
					<v8:content>Enviado</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Заказ</dataPath>
			<field>Заказ</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заказ</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fr</v8:lang>
					<v8:content>Commande</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Order</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>es</v8:lang>
					<v8:content>Orden</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Характеристика</dataPath>
			<field>Характеристика</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Заказано</dataPath>
			<field>Заказано</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заказано</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fr</v8:lang>
					<v8:content>Commandé</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Ordered</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>es</v8:lang>
					<v8:content>Ordenado</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказТЧТовары.Ссылка КАК Заказ,
	ЗаказТЧТовары.Номенклатура КАК Номенклатура,
	ЗаказТЧТовары.Характеристика КАК Характеристика,
	СУММА(ЗаказТЧТовары.Количество) КАК Количество
ПОМЕСТИТЬ ВТЗаказы
ИЗ
	Документ.ЗаказПокупателя.ТЧТовары КАК ЗаказТЧТовары
ГДЕ
	ЗаказТЧТовары.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ЗаказТЧТовары.Ссылка.ПометкаУдаления = ЛОЖЬ

СГРУППИРОВАТЬ ПО
	ЗаказТЧТовары.Ссылка,
	ЗаказТЧТовары.Номенклатура,
	ЗаказТЧТовары.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТЧТовары.Ссылка.Основание КАК Заказ,
	ТЧТовары.Номенклатура КАК Номенклатура,
	ТЧТовары.Характеристика КАК Характеристика,
	СУММА(ТЧТовары.Количество) КАК Количество
ПОМЕСТИТЬ ВТРеализации
ИЗ
	Документ.РеализацияТоваровУслуг.ТЧТовары КАК ТЧТовары
ГДЕ
	ТЧТовары.Ссылка.Основание В
			(ВЫБРАТЬ
				ВТЗаказы.Заказ
			ИЗ
				ВТЗаказы)
	И ТЧТовары.Ссылка.Проведен

СГРУППИРОВАТЬ ПО
	ТЧТовары.Ссылка.Основание,
	ТЧТовары.Номенклатура,
	ТЧТовары.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВЗ.Заказ КАК Заказ,
	ВЗ.Заказ.Менеджер КАК Менеджер,
	ВЗ.Заказ.Контрагент КАК Контрагент,
	ВЗ.Номенклатура КАК Номенклатура,
	ВЗ.Характеристика КАК Характеристика,
	ВЗ.Заказано КАК Заказано,
	ВЗ.Отгружено КАК Отгружено
ИЗ
	(ВЫБРАТЬ
		ВТЗаказы.Заказ КАК Заказ,
		ВТЗаказы.Номенклатура КАК Номенклатура,
		ВТЗаказы.Характеристика КАК Характеристика,
		ВТЗаказы.Количество КАК Заказано,
		ЕСТЬNULL(ВТРеализации.Количество, 0) КАК Отгружено
	ИЗ
		ВТЗаказы КАК ВТЗаказы
			ЛЕВОЕ СОЕДИНЕНИЕ ВТРеализации КАК ВТРеализации
			ПО ВТЗаказы.Заказ = ВТРеализации.Заказ
				И ВТЗаказы.Номенклатура = ВТРеализации.Номенклатура
				И ВТЗаказы.Характеристика = ВТРеализации.Характеристика) КАК ВЗ
ГДЕ
	100 - ВЗ.Отгружено / ВЗ.Заказано * 100 &gt;= &amp;Отклонение
	И ВЗ.Отгружено &lt; ВЗ.Заказано</query>
	</dataSet>
	<calculatedField>
		<dataPath>Отклонение</dataPath>
		<expression>100 - Отгружено / Заказано * 100</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Отклонение (%)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Écart (%)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Difference (%)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Diferencia (%)</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>Неотгружено</dataPath>
		<expression>Заказано - Отгружено</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Неотгружено</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Non expédié</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Not shipped</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Sin descargar</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>Отклонение</dataPath>
		<expression>100 - Сумма(Отгружено) / Сумма(Заказано) * 100</expression>
	</totalField>
	<totalField>
		<dataPath>Заказано</dataPath>
		<expression>Сумма(Заказано)</expression>
	</totalField>
	<totalField>
		<dataPath>Отгружено</dataPath>
		<expression>Сумма(Отгружено)</expression>
	</totalField>
	<totalField>
		<dataPath>Неотгружено</dataPath>
		<expression>Сумма(Заказано) - Сумма(Отгружено)</expression>
	</totalField>
