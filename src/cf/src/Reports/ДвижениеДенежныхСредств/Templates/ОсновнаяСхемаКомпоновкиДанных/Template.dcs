		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫБОР
		КОГДА ДДС.ТипДвижения = ЗНАЧЕНИЕ(Перечисление.ТипыДвиженияДенежныхСредств.Поступление)
			ТОГДА "Réception"
		ИНАЧЕ "Consommation"
	КОНЕЦ КАК ВидДвижения,
	ДДС.Организация КАК Организация,
	ДДС.МестоХранения КАК МестоХранения,
	ДДС.СтатьяДДС КАК СтатьяДДС,
	ДДС.ТипДенежныхСредств КАК ТипДенежныхСредств,
	ВЫБОР
		КОГДА ДДС.ТипДвижения = ЗНАЧЕНИЕ(Перечисление.ТипыДвиженияДенежныхСредств.Списание)
			ТОГДА -ДДС.СуммаОборот
		ИНАЧЕ ДДС.СуммаОборот
	КОНЕЦ КАК Сумма,
	ДДС.Регистратор КАК Регистратор,
	ДДС.ПериодСекунда КАК ПериодСекунда,
	ДДС.ПериодДень КАК День,
	ДДС.ПериодНеделя КАК Неделя,
	ДДС.ПериодМесяц КАК Месяц,
	ДДС.ПериодКвартал КАК Квартал,
	ДДС.ПериодПолугодие КАК Полугодие,
	ДДС.ПериодГод КАК Год
ИЗ
	РегистрНакопления.ДвиженияДенежныхСредств.Обороты(, , Авто, ) КАК ДДС</query>
	</dataSet>
	<totalField>
		<dataPath>Сумма</dataPath>
		<expression>Сумма(Сумма)</expression>
	</totalField>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
