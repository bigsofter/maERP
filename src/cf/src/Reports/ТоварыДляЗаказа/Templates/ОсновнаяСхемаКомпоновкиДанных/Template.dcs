				</v8:item>
				<v8:item>
					<v8:lang>es</v8:lang>
					<v8:content>Existencias actuales</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Партия</dataPath>
			<field>Партия</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ХозяйственнаяОперация</dataPath>
			<field>ХозяйственнаяОперация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументПродажи</dataPath>
			<field>ДокументПродажи</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Характеристика</dataPath>
			<field>Характеристика</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ответственный</dataPath>
			<field>Ответственный</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Серия</dataPath>
			<field>Серия</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МестоХранения</dataPath>
			<field>МестоХранения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаПартии</dataPath>
			<field>ДатаПартии</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МинимальныйОстаток</dataPath>
			<field>МинимальныйОстаток</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Минимальный остаток</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fr</v8:lang>
					<v8:content>Stock minimal</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Minimum stock</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>es</v8:lang>
					<v8:content>Stock mínimo</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПродажиОбороты.Номенклатура КАК Номенклатура,
	ПродажиОбороты.КоличествоОборот КАК КоличествоОборот,
	0 КАК КоличествоОстаток,
	0 КАК МинимальныйОстаток
ПОМЕСТИТЬ ВТ
ИЗ
	РегистрНакопления.Продажи.Обороты(, , Период, МестоХранения = &amp;МестоХранения) КАК ПродажиОбороты

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ТоварыВНаличииОстатки.Номенклатура,
	0,
	ТоварыВНаличииОстатки.КоличествоОстаток,
	0
ИЗ
	РегистрНакопления.ТоварыВНаличии.Остатки(, МестоХранения = &amp;МестоХранения) КАК ТоварыВНаличииОстатки

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	МинимальныйОстатокПоСкладам.Номенклатура,
	0,
	0,
	МинимальныйОстатокПоСкладам.МинимальноеКоличествоХранения
ИЗ
	РегистрСведений.МинимальныйОстатокПоСкладам КАК МинимальныйОстатокПоСкладам
ГДЕ
	НЕ МинимальныйОстатокПоСкладам.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	И НЕ МинимальныйОстатокПоСкладам.МинимальноеКоличествоХранения = 0
	И МинимальныйОстатокПоСкладам.МестоХранения = &amp;МестоХранения
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ.Номенклатура КАК Номенклатура,
	СУММА(ВТ.КоличествоОборот) КАК КоличествоОборот,
	СУММА(ВТ.КоличествоОстаток) КАК КоличествоОстаток,
	СУММА(ВТ.МинимальныйОстаток) КАК МинимальныйОстаток
ИЗ
	ВТ КАК ВТ

СГРУППИРОВАТЬ ПО
	ВТ.Номенклатура</query>
	</dataSet>
	<calculatedField>
		<dataPath>СредняяПродажа</dataPath>
		<expression>Выбор когда &amp;НачалоПериода = ДатаВремя(1,1,1,0,0,0) и &amp;КонецПериода = ДатаВремя(1,1,1,0,0,0) тогда 0 иначе КоличествоОборот/(1+РазностьДат(&amp;НачалоПериода, &amp;КонецПериода,"День")) конец</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Средняя продажа</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Vente moyen</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Average sale</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Venta media</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Format</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ЧДЦ=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fr</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>es</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>Заказать</dataPath>
		<expression/>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Заказать</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Commander</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>To order</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Encargar</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ОстатокНаДатуДоставки</dataPath>
		<expression>Выбор когда &amp;НачалоПериода = ДатаВремя(1,1,1,0,0,0) и &amp;КонецПериода = ДатаВремя(1,1,1,0,0,0) тогда 0 иначе КоличествоОборот/(1+РазностьДат(&amp;НачалоПериода, &amp;КонецПериода,"День")) конец * &amp;СрокДоставки</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Остаток на дату доставки</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Solde à la date de livraison</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Balance on the delivery date</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Saldo en la fecha de entrega</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>КоличествоОборот</dataPath>
		<expression>Сумма(КоличествоОборот)</expression>
		<group>Номенклатура</group>
	</totalField>
	<totalField>
		<dataPath>КоличествоОстаток</dataPath>
		<expression>Сумма(КоличествоОстаток)</expression>
		<group>Номенклатура</group>
	</totalField>
	<totalField>
		<dataPath>МинимальныйОстаток</dataPath>
		<expression>Сумма(МинимальныйОстаток)</expression>
		<group>Номенклатура</group>
	</totalField>
	<totalField>
		<dataPath>СредняяПродажа</dataPath>
		<expression>Сумма(СредняяПродажа)</expression>
		<group>Номенклатура</group>
	</totalField>
	<totalField>
		<dataPath>Заказать</dataPath>
		<expression>Сумма(Окр(Выбор когда СредняяПродажа*&amp;ПериодПрогнозирования - Выбор когда КоличествоОстаток-ОстатокНаДатуДоставки &lt;= 0 тогда 0 иначе КоличествоОстаток-ОстатокНаДатуДоставки конец + ЕстьNull(МинимальныйОстаток,0)&lt;0 тогда 0 иначе СредняяПродажа*&amp;ПериодПрогнозирования - Выбор когда КоличествоОстаток-ОстатокНаДатуДоставки &lt;= 0 тогда 0 иначе КоличествоОстаток-ОстатокНаДатуДоставки конец + ЕстьNull(МинимальныйОстаток,0) конец,0))</expression>
		<group>Номенклатура</group>
	</totalField>
	<totalField>
		<dataPath>ОстатокНаДатуДоставки</dataPath>
		<expression>Сумма(Окр(Выбор когда КоличествоОстаток-ОстатокНаДатуДоставки &lt;= 0 тогда 0 иначе КоличествоОстаток-ОстатокНаДатуДоставки конец,0))</expression>
		<group>Номенклатура</group>
	</totalField>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Début de la période</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Beginning of the period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Comienzo del período</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ПериодПродаж.ДатаНачала</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Fin de période</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>End of period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Fin del período</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ПериодПродаж.ДатаОкончания</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата остатка</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Date de solde</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Balance date</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Fecha de balance</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>ТекущаяДата()</expression>
	</parameter>
	<parameter>
		<name>ПериодПродаж</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
