		<name>СрокДоставки</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Срок доставки (дн.)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
