// Переработка по переработчикам (план docs/plans/processing-by-processor.md): передачи, приёмы и остатки у переработчика
// по заказам клиентов со сроком переработки. Группы «переработчик × заказ передачи» отбирает схема компоновки, данные
// секций - пакет запросов модуля. Заказ группы - заказ ПЕРЕДАЧИ (измерение ПередачаВПереработку), а не измерение
// ЗаказПокупателя движения: у старых расходов оно заполнено по основанию регистратора и может не совпасть с приходом.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДокументРезультат.Очистить();

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрыОтчета = ПараметрыОтчета(Настройки);
	Группы = ГруппыПереработки(Настройки, ПараметрыОтчета);
	Данные = ДанныеПереработки(Группы, ПараметрыОтчета);
	ВывестиОтчет(ДокументРезультат, Группы, Данные, ПараметрыОтчета);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Данные

Функция ПараметрыОтчета(Настройки)

	Результат = Новый Структура("НачалоПериода, КонецПериода");
	Результат.НачалоПериода = '00010101';
	Результат.КонецПериода = КонецДня(ТекущаяДатаСеанса());
	Элемент = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	Если Элемент <> Неопределено И Элемент.Использование И ТипЗнч(Элемент.Значение) = Тип("СтандартныйПериод") Тогда
		Результат.НачалоПериода = Элемент.Значение.ДатаНачала;
		Если ЗначениеЗаполнено(Элемент.Значение.ДатаОкончания) Тогда
			Результат.КонецПериода = Элемент.Значение.ДатаОкончания;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Группы «переработчик × заказ передачи» по настройкам пользователя: схема компоновки - в коллекцию значений.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных - настройки отчёта (изменяются: выбор и структура под выгрузку).
//  ПараметрыОтчета - Структура - см. ПараметрыОтчета.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Переработчик, Заказ, Клиент.
//
Функция ГруппыПереработки(Настройки, ПараметрыОтчета)

	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода", ПараметрыОтчета.КонецПериода);
	Настройки.Выбор.Элементы.Очистить();
	Для Каждого ИмяПоля Из СтрРазделить("Переработчик,Заказ,Клиент", ",") Цикл
		Поле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;
	Настройки.Структура.Очистить();
	Детали = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Детали.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , ТипГенератора);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	Выгрузка = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Выгрузка);
	Вывод.Вывести(Процессор);

	Группы = Новый ТаблицаЗначений;
	Группы.Колонки.Добавить("Переработчик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Группы.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
	Группы.Колонки.Добавить("Клиент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Для Каждого Строка Из Выгрузка Цикл
		ЗаполнитьЗначенияСвойств(Группы.Добавить(), Строка);
	КонецЦикла;
	Группы.Свернуть("Переработчик, Заказ, Клиент");
	Группы.Сортировать("Переработчик, Заказ");
	Возврат Группы;

КонецФункции

// Данные секций: пакет запросов, результаты - таблицами значений.
//
// Параметры:
//  Группы - ТаблицаЗначений - см. ГруппыПереработки.
//  ПараметрыОтчета - Структура - см. ПараметрыОтчета.
//
// Возвращаемое значение:
//  Структура - Передано, Принято, Остатки, Сроки (ТаблицаЗначений).
//
Функция ДанныеПереработки(Группы, ПараметрыОтчета)

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПереработки();
	Запрос.УстановитьПараметр("Группы", Группы.Скопировать(, "Переработчик, Заказ"));
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыОтчета.КонецПериода);
	Запрос.УстановитьПараметр("ГраницаКонца", Новый Граница(ПараметрыОтчета.КонецПериода, ВидГраницы.Включая));
	Результаты = Запрос.ВыполнитьПакет();

	// Последние запросы пакета - результаты секций в порядке имён ниже, перед ними - временные таблицы.
	Имена = СтрРазделить("Передано,Принято,Остатки,Сроки", ",");
	Смещение = Результаты.Количество() - Имена.Количество();
	Данные = Новый Структура;
	Для Индекс = 0 По Имена.ВГраница() Цикл
		Данные.Вставить(Имена[Индекс], Результаты[Смещение + Индекс].Выгрузить());
	КонецЦикла;
	Возврат Данные;

КонецФункции

// Текст пакета запросов (правила - docs/plans/processing-by-processor.md, «Исходные данные»).
//
// Возвращаемое значение:
//  Строка - текст пакета; последние четыре запроса - результаты секций (см. ДанныеПереработки).
//
// BSLLS:MethodSize-off - текст пакета запросов отчёта: одна функция, чтобы пакет читался целиком.
// BSLLS:QueryNestedFieldsByDot-off - реквизиты документов (дата, номер, основание), объёмы малы.
Функция ТекстЗапросаПереработки()

	Возврат
	"ВЫБРАТЬ
	|	Г.Переработчик КАК Переработчик,
	|	Г.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТ_Группы
	|ИЗ
	|	&Группы КАК Г
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Переработчик,
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Д.Контрагент КАК Переработчик,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Д.ПередачаВПереработку.Основание КАК Документ.ЗаказПокупателя),
	|		ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК Заказ,
	|	Д.Регистратор КАК Регистратор,
	|	Д.ПередачаВПереработку КАК Передача,
	|	Д.ВидДвижения КАК ВидДвижения,
	|	Д.Номенклатура КАК Номенклатура,
	|	Д.Характеристика КАК Характеристика,
	|	Д.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_Движения
	|ИЗ
	|	РегистрНакопления.ТоварыВПереработке КАК Д
	|ГДЕ
	|	Д.Активность
	|	И Д.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ПоступлениеИзПереработки) КАК Поступление,
	|	Д.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТ_ЗаказыПоступленийВсе
	|ИЗ
	|	ВТ_Движения КАК Д
	|ГДЕ
	|	Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Д.Регистратор ССЫЛКА Документ.ПоступлениеИзПереработки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	З.Поступление КАК Поступление
	|ПОМЕСТИТЬ ВТ_СмешанныеПоступления
	|ИЗ
	|	ВТ_ЗаказыПоступленийВсе КАК З
	|
	|СГРУППИРОВАТЬ ПО
	|	З.Поступление
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Д.Переработчик КАК Переработчик,
	|	Д.Заказ КАК Заказ,
	|	ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ПоступлениеИзПереработки) КАК Поступление,
	|	Д.Передача КАК Передача
	|ПОМЕСТИТЬ ВТ_ПарыПриема
	|ИЗ
	|	ВТ_Движения КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Группы КАК Г
	|		ПО Д.Переработчик = Г.Переработчик
	|			И Д.Заказ = Г.Заказ
	|ГДЕ
	|	Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Д.Регистратор ССЫЛКА Документ.ПоступлениеИзПереработки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	П.Переработчик КАК Переработчик,
	|	П.Заказ КАК Заказ,
	|	П.Поступление КАК Поступление
	|ПОМЕСТИТЬ ВТ_ЗаказыПоступлений
	|ИЗ
	|	ВТ_ПарыПриема КАК П
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Д.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТ_ПоступленияССырьем
	|ИЗ
	|	РегистрНакопления.ТоварыВПереработке КАК Д
	|ГДЕ
	|	Д.Регистратор ССЫЛКА Документ.ПоступлениеИзПереработки
	|	И Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Д.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Хвост.Ссылка КАК Поступление,
	|	Хвост.Контрагент КАК Переработчик,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА Хвост.Основание ССЫЛКА Документ.ЗаказПокупателя
	|				ТОГДА ВЫРАЗИТЬ(Хвост.Основание КАК Документ.ЗаказПокупателя)
	|			КОГДА Хвост.Основание ССЫЛКА Документ.ПередачаВПереработку
	|				ТОГДА ВЫРАЗИТЬ(Хвост.Основание КАК Документ.ПередачаВПереработку).Основание
	|		КОНЕЦ, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК Заказ
	|ПОМЕСТИТЬ ВТ_ХвостыВсе
	|ИЗ
	|	Документ.ПоступлениеИзПереработки КАК Хвост
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоступленияССырьем КАК ССырьем
	|		ПО Хвост.Ссылка = ССырьем.Регистратор
	|ГДЕ
	|	Хвост.Проведен
	|	И Хвост.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ССырьем.Регистратор ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Х.Поступление КАК Поступление,
	|	Х.Переработчик КАК Переработчик,
	|	Х.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТ_Хвосты
	|ИЗ
	|	ВТ_ХвостыВсе КАК Х
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Группы КАК Г
	|		ПО Х.Переработчик = Г.Переработчик
	|			И Х.Заказ = Г.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Контрагент КАК Переработчик,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(О.ПередачаВПереработку.Основание КАК Документ.ЗаказПокупателя),
	|		ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК Заказ,
	|	О.ПередачаВПереработку КАК Передача,
	|	О.Номенклатура КАК Номенклатура,
	|	О.Характеристика КАК Характеристика,
	|	О.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТ_ОстаткиВсе
	|ИЗ
	|	РегистрНакопления.ТоварыВПереработке.Остатки(
	|			&ГраницаКонца,
	|			Контрагент В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					Г.Переработчик КАК Переработчик
	|				ИЗ
	|					ВТ_Группы КАК Г)) КАК О
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Д.Переработчик КАК Переработчик,
	|	Д.Заказ КАК Заказ,
	|	ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ПередачаВПереработку) КАК Документ,
	|	Д.Регистратор.Дата КАК Дата,
	|	Д.Регистратор.Номер КАК Номер,
	|	Д.Номенклатура КАК Номенклатура,
	|	Д.Характеристика КАК Характеристика,
	|	Д.Номенклатура.Единица КАК Единица,
	|	СУММА(Д.Количество) КАК Количество
	|ИЗ
	|	ВТ_Движения КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Группы КАК Г
	|		ПО Д.Переработчик = Г.Переработчик
	|			И Д.Заказ = Г.Заказ
	|ГДЕ
	|	Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Д.Регистратор ССЫЛКА Документ.ПередачаВПереработку
	|
	|СГРУППИРОВАТЬ ПО
	|	Д.Переработчик,
	|	Д.Заказ,
	|	ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ПередачаВПереработку),
	|	Д.Регистратор.Дата,
	|	Д.Регистратор.Номер,
	|	Д.Номенклатура,
	|	Д.Характеристика,
	|	Д.Номенклатура.Единица
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	З.Переработчик КАК Переработчик,
	|	З.Заказ КАК Заказ,
	|	З.Поступление КАК Документ,
	|	З.Поступление.Дата КАК Дата,
	|	З.Поступление.Номер КАК Номер,
	|	ГП.Номенклатура КАК Номенклатура,
	|	ГП.Характеристика КАК Характеристика,
	|	ГП.Номенклатура.Единица КАК Единица,
	|	СУММА(ГП.Количество) КАК Количество,
	|	ВЫБОР
	|		КОГДА С.Поступление ЕСТЬ NULL
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Смешан,
	|	0 КАК Хвост
	|ИЗ
	|	ВТ_ЗаказыПоступлений КАК З
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеИзПереработки.ТЧГотоваяПродукция КАК ГП
	|		ПО З.Поступление = ГП.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СмешанныеПоступления КАК С
	|		ПО З.Поступление = С.Поступление
	|
	|СГРУППИРОВАТЬ ПО
	|	З.Переработчик,
	|	З.Заказ,
	|	З.Поступление,
	|	З.Поступление.Дата,
	|	З.Поступление.Номер,
	|	ГП.Номенклатура,
	|	ГП.Характеристика,
	|	ГП.Номенклатура.Единица,
	|	ВЫБОР
	|		КОГДА С.Поступление ЕСТЬ NULL
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Х.Переработчик,
	|	Х.Заказ,
	|	Х.Поступление,
	|	Х.Поступление.Дата,
	|	Х.Поступление.Номер,
	|	ГП.Номенклатура,
	|	ГП.Характеристика,
	|	ГП.Номенклатура.Единица,
	|	СУММА(ГП.Количество),
	|	0,
	|	1
	|ИЗ
	|	ВТ_Хвосты КАК Х
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеИзПереработки.ТЧГотоваяПродукция КАК ГП
	|		ПО Х.Поступление = ГП.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Х.Переработчик,
	|	Х.Заказ,
	|	Х.Поступление,
	|	Х.Поступление.Дата,
	|	Х.Поступление.Номер,
	|	ГП.Номенклатура,
	|	ГП.Характеристика,
	|	ГП.Номенклатура.Единица
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Переработчик КАК Переработчик,
	|	О.Заказ КАК Заказ,
	|	О.Передача КАК Передача,
	|	О.Передача.Дата КАК ДатаПередачи,
	|	О.Передача.Номер КАК НомерПередачи,
	|	О.Номенклатура КАК Номенклатура,
	|	О.Характеристика КАК Характеристика,
	|	О.Номенклатура.Единица КАК Единица,
	|	СУММА(О.Количество) КАК Количество
	|ИЗ
	|	ВТ_ОстаткиВсе КАК О
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Группы КАК Г
	|		ПО О.Переработчик = Г.Переработчик
	|			И О.Заказ = Г.Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Переработчик,
	|	О.Заказ,
	|	О.Передача,
	|	О.Передача.Дата,
	|	О.Передача.Номер,
	|	О.Номенклатура,
	|	О.Характеристика,
	|	О.Номенклатура.Единица
	|
	|ИМЕЮЩИЕ
	|	СУММА(О.Количество) <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПередачи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	П.Переработчик КАК Переработчик,
	|	П.Заказ КАК Заказ,
	|	П.Поступление КАК Поступление,
	|	П.Передача КАК Передача,
	|	РАЗНОСТЬДАТ(П.Передача.Дата, П.Поступление.Дата, ДЕНЬ) КАК Дней
	|ИЗ
	|	ВТ_ПарыПриема КАК П";

КонецФункции
// BSLLS:QueryNestedFieldsByDot-on
// BSLLS:MethodSize-on

#КонецОбласти

#Область Вывод

// BSLLS:MagicNumber-off - номера секций (1-3) и смещения колонок внутри секции.

// Выводит отчёт: группы переработчиков, внутри - группы заказов с тремя секциями бок о бок.
//
// Параметры:
//  ДокументРезультат - ТабличныйДокумент - результат отчёта.
//  Группы - ТаблицаЗначений - см. ГруппыПереработки.
//  Данные - Структура - см. ДанныеПереработки.
//  ПараметрыОтчета - Структура - см. ПараметрыОтчета.
//
Процедура ВывестиОтчет(ДокументРезультат, Группы, Данные, ПараметрыОтчета)

	Контекст = Новый Структура("Документ, Строка, Смешанные", ДокументРезультат, 1, Ложь);
	НастроитьКолонки(ДокументРезультат);
	ВывестиШапкуОтчета(Контекст, ПараметрыОтчета);

	Переработчики = Группы.Скопировать(, "Переработчик");
	Переработчики.Свернуть("Переработчик");
	Для Каждого Переработчик Из Переработчики Цикл
		ВывестиПереработчика(Контекст, Переработчик.Переработчик, Группы, Данные, ПараметрыОтчета);
	КонецЦикла;

	Если Переработчики.Количество() = 0 Тогда
		ВывестиТекст(Контекст, НСтр("ru = 'Переработки за период нет.'; fr = 'Aucune sous-traitance sur la période.';
			|en = 'No processing in the period.'; es = 'No hay procesamiento en el período.'"), Ложь);
	ИначеЕсли Контекст.Смешанные Тогда
		ВывестиТекст(Контекст, НСтр("ru = '◐ - поступление списало сырьё нескольких заказов: продукция показана полностью в каждом,
			|в итог переработчика входит один раз.';
			|fr = '◐ - la réception a consommé la matière de plusieurs commandes : le produit est montré en entier dans chacune,
			|il compte une seule fois dans le total du sous-traitant.';
			|en = '◐ - the receipt consumed raw material of several orders: the product is shown in full in each,
			|it counts once in the processor total.';
			|es = '◐ - la recepción consumió materia prima de varios pedidos: el producto se muestra completo en cada uno,
			|cuenta una vez en el total del procesador.'"), Ложь);
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиПереработчика(Контекст, Переработчик, Группы, Данные, ПараметрыОтчета)

	Отбор = Новый Структура("Переработчик", Переработчик);
	ГруппыПереработчика = Группы.НайтиСтроки(Отбор);
	Передано = Данные.Передано.НайтиСтроки(Отбор);
	Принято = Данные.Принято.НайтиСтроки(Отбор);
	Остатки = Данные.Остатки.НайтиСтроки(Отбор);
	Сроки = Данные.Сроки.НайтиСтроки(Отбор);

	// Принято переработчика - по различным строкам поступлений: смешанное поступление, показанное в нескольких
	// заказах, входит в итог один раз (план, круг 1).
	ПринятоРазличное = Новый Массив;
	Учтенные = Новый Соответствие;
	Для Каждого Прием Из Принято Цикл
		Ключ = Строка(Прием.Документ.УникальныйИдентификатор()) + "|" + Строка(Прием.Номенклатура.УникальныйИдентификатор())
			+ "|" + Строка(Прием.Характеристика.УникальныйИдентификатор());
		Если Учтенные[Ключ] = Неопределено Тогда
			Учтенные.Вставить(Ключ, Истина);
			ПринятоРазличное.Добавить(Прием);
		КонецЕсли;
	КонецЦикла;

	Части = Новый Массив;
	Части.Добавить(Строка(Переработчик));
	ДобавитьИтогиШапки(Части, Передано, ПринятоРазличное, Остатки);
	ДобавитьСроки(Части, Сроки, Остатки, ПараметрыОтчета);
	Область = ОбластьСтроки(Контекст);
	Область.Объединить();
	Область.Текст = СтрСоединить(Части, " · ");
	Область.Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
	Область.ЦветФона = WebЦвета.СветлоСерый;
	Контекст.Строка = Контекст.Строка + 1;

	Для Каждого Группа Из ГруппыПереработчика Цикл
		ОтборГруппы = Новый Структура("Переработчик, Заказ", Переработчик, Группа.Заказ);
		ВывестиЗаказ(Контекст, Группа, Данные, ОтборГруппы, ПараметрыОтчета);
	КонецЦикла;
	Контекст.Строка = Контекст.Строка + 1;

КонецПроцедуры

Процедура ВывестиЗаказ(Контекст, Группа, Данные, ОтборГруппы, ПараметрыОтчета)

	Документ = Контекст.Документ;
	Передано = Данные.Передано.НайтиСтроки(ОтборГруппы);
	Принято = Данные.Принято.НайтиСтроки(ОтборГруппы);
	Остатки = Данные.Остатки.НайтиСтроки(ОтборГруппы);
	Сроки = Данные.Сроки.НайтиСтроки(ОтборГруппы);

	Части = Новый Массив;
	Если ЗначениеЗаполнено(Группа.Заказ) Тогда
		Части.Добавить(Строка(Группа.Заказ));
		Части.Добавить(НСтр("ru = 'клиент'; fr = 'client'; en = 'customer'; es = 'cliente'") + " " + Строка(Группа.Клиент));
	Иначе
		Части.Добавить(НСтр("ru = 'Без заказа'; fr = 'Sans commande'; en = 'No order'; es = 'Sin pedido'"));
	КонецЕсли;
	ДобавитьИтогиШапки(Части, Передано, Принято, Остатки);
	ДобавитьСроки(Части, Сроки, Остатки, ПараметрыОтчета);
	Область = ОбластьСтроки(Контекст);
	Область.Объединить();
	Область.Текст = СтрСоединить(Части, " · ");
	Область.Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;

	Начало = Контекст.Строка + 1;
	ВывестиЗаголовкиСекций(Документ, Начало);
	Строки = Новый Массив;
	Строки.Добавить(ВывестиПередано(Документ, Начало + 2, Передано));
	Строки.Добавить(ВывестиПринято(Контекст, Начало + 2, Принято));
	Строки.Добавить(ВывестиОстатки(Документ, Начало + 2, Остатки, ПараметрыОтчета));
	Максимум = 0;
	Для Каждого ЧислоСтрок Из Строки Цикл
		Максимум = Макс(Максимум, ЧислоСтрок);
	КонецЦикла;
	Контекст.Строка = Начало + 2 + Максимум + 1;

КонецПроцедуры

// Итоги шапки по единицам: передано, принято, у переработчика.
//
// Параметры:
//  Части - Массив из Строка - пополняемые части шапки.
//  Передано - Массив из СтрокаТаблицыЗначений - строки передач.
//  Принято - Массив из СтрокаТаблицыЗначений - строки приёмов (у переработчика - без повторов смешанных).
//  Остатки - Массив из СтрокаТаблицыЗначений - строки остатков.
//
Процедура ДобавитьИтогиШапки(Части, Передано, Принято, Остатки)

	ТекстПередано = НСтр("ru = 'передано'; fr = 'envoyé'; en = 'sent'; es = 'enviado'") + " " + ИтогиСтрокой(Передано);
	Части.Добавить(ТекстПередано);
	ТекстПринято = НСтр("ru = 'принято'; fr = 'reçu'; en = 'received'; es = 'recibido'") + " " + ИтогиСтрокой(Принято);
	Части.Добавить(ТекстПринято);
	ТекстОстатка = НСтр("ru = 'у переработчика'; fr = 'chez le sous-traitant'; en = 'at processor'; es = 'en el procesador'")
		+ " " + ИтогиСтрокой(Остатки);
	Части.Добавить(ТекстОстатка);

КонецПроцедуры

// Средний срок по парам «поступление - передача» без веса количеством и старейшая незакрытая передача (план, круг 1).
//
// Параметры:
//  Части - Массив из Строка - пополняемые части шапки.
//  Сроки - Массив из СтрокаТаблицыЗначений - пары с колонкой Дней.
//  Остатки - Массив из СтрокаТаблицыЗначений - строки остатков с колонкой ДатаПередачи.
//  ПараметрыОтчета - Структура - см. ПараметрыОтчета.
//
Процедура ДобавитьСроки(Части, Сроки, Остатки, ПараметрыОтчета)

	Если Сроки.Количество() > 0 Тогда
		Сумма = 0;
		Для Каждого Пара Из Сроки Цикл
			Сумма = Сумма + Пара.Дней;
		КонецЦикла;
		Шаблон = НСтр("ru = 'средний срок %1 дн.'; fr = 'délai moyen %1 j'; en = 'average time %1 days'; es = 'plazo medio %1 días'");
		Среднее = Формат(Сумма / Сроки.Количество(), "ЧДЦ=1; ЧН=0");
		Части.Добавить(СтрШаблон(Шаблон, Среднее));
	КонецЕсли;
	Старейшая = Неопределено;
	Для Каждого Остаток Из Остатки Цикл
		ЕстьДата = Остаток.Количество > 0 И ЗначениеЗаполнено(Остаток.ДатаПередачи);
		Если ЕстьДата И (Старейшая = Неопределено Или Остаток.ДатаПередачи < Старейшая) Тогда
			Старейшая = Остаток.ДатаПередачи;
		КонецЕсли;
	КонецЦикла;
	Если Старейшая <> Неопределено Тогда
		Дней = Цел((НачалоДня(ПараметрыОтчета.КонецПериода) - НачалоДня(Старейшая)) / 86400);
		Шаблон = НСтр("ru = 'старейшая незакрытая передача %1 дн.'; fr = 'plus ancien envoi ouvert %1 j';
			|en = 'oldest open transfer %1 days'; es = 'envío abierto más antiguo %1 días'");
		Части.Добавить(СтрШаблон(Шаблон, Формат(Дней, "ЧН=0")));
	КонецЕсли;

КонецПроцедуры

Функция ВывестиПередано(Документ, НомерСтроки, Передано)

	Колонка = КолонкаСекции(1);
	Итоги = Новый Соответствие;
	Номер = 0;
	Для Каждого Передача Из Передано Цикл
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка, Формат(Передача.Дата, "ДЛФ=D"));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 1, Передача.Номер, Передача.Документ);
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 2, ПредставлениеТовара(Передача));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 3, ФорматКоличества(Передача.Количество));
		ДобавитьИтог(Итоги, Передача.Единица, Передача.Количество);
		Номер = Номер + 1;
	КонецЦикла;
	Возврат Номер + ВывестиИтоги(Документ, НомерСтроки + Номер, Колонка + 2, Итоги);

КонецФункции

Функция ВывестиПринято(Контекст, НомерСтроки, Принято)

	Документ = Контекст.Документ;
	Колонка = КолонкаСекции(2);
	Итоги = Новый Соответствие;
	Номер = 0;
	Для Каждого Прием Из Принято Цикл
		Пометка = "";
		Если Прием.Смешан = 1 Тогда
			Пометка = " ◐";
			Контекст.Смешанные = Истина;
		ИначеЕсли Прием.Хвост = 1 Тогда
			Пометка = " (" + НСтр("ru = 'хвост без сырья'; fr = 'reliquat sans matière'; en = 'tail without raw material';
				|es = 'remanente sin materia prima'") + ")";
		Иначе
			Пометка = "";
		КонецЕсли;
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка, Формат(Прием.Дата, "ДЛФ=D"));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 1, Прием.Номер + Пометка, Прием.Документ);
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 2, ПредставлениеТовара(Прием));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 3, ФорматКоличества(Прием.Количество));
		ДобавитьИтог(Итоги, Прием.Единица, Прием.Количество);
		Номер = Номер + 1;
	КонецЦикла;
	Возврат Номер + ВывестиИтоги(Документ, НомерСтроки + Номер, Колонка + 2, Итоги);

КонецФункции

Функция ВывестиОстатки(Документ, НомерСтроки, Остатки, ПараметрыОтчета)

	Колонка = КолонкаСекции(3);
	Итоги = Новый Соответствие;
	Номер = 0;
	Для Каждого Остаток Из Остатки Цикл
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка, ПредставлениеТовара(Остаток));
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 1, ФорматКоличества(Остаток.Количество));
		Если ЗначениеЗаполнено(Остаток.Передача) Тогда
			ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 2,
				Остаток.НомерПередачи + " " + Формат(Остаток.ДатаПередачи, "ДЛФ=D"), Остаток.Передача);
			Дней = Цел((НачалоДня(ПараметрыОтчета.КонецПериода) - НачалоДня(Остаток.ДатаПередачи)) / 86400);
			ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 3, Формат(Дней, "ЧН=0"));
		КонецЕсли;
		ДобавитьИтог(Итоги, Остаток.Единица, Остаток.Количество);
		Номер = Номер + 1;
	КонецЦикла;
	Возврат Номер + ВывестиИтоги(Документ, НомерСтроки + Номер, Колонка, Итоги);

КонецФункции

Функция ПредставлениеТовара(СтрокаТовара)

	Представление = Строка(СтрокаТовара.Номенклатура);
	Если ЗначениеЗаполнено(СтрокаТовара.Характеристика) Тогда
		Представление = Представление + " (" + Строка(СтрокаТовара.Характеристика) + ")";
	КонецЕсли;
	Возврат Представление;

КонецФункции

Процедура ДобавитьИтог(Итоги, Единица, Количество)

	Итоги.Вставить(Единица, ?(Итоги[Единица] = Неопределено, 0, Итоги[Единица]) + Количество);

КонецПроцедуры

// Итоги секции - строкой на каждую единицу измерения.
//
// Параметры:
//  Документ - ТабличныйДокумент - результат.
//  НомерСтроки - Число - первая строка итогов.
//  Колонка - Число - колонка подписи.
//  Итоги - Соответствие - ключ - единица измерения, значение - количество.
//
// Возвращаемое значение:
//  Число - выведено строк.
//
Функция ВывестиИтоги(Документ, НомерСтроки, Колонка, Итоги)

	Номер = 0;
	Для Каждого Итог Из Итоги Цикл
		ЕдиницаТекст = ?(ЗначениеЗаполнено(Итог.Ключ), ", " + Строка(Итог.Ключ), "");
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка, НСтр("ru = 'Итого'; fr = 'Total'; en = 'Total'; es = 'Total'")
			+ ЕдиницаТекст);
		ВывестиЯчейку(Документ, НомерСтроки + Номер, Колонка + 1, ФорматКоличества(Итог.Значение));
		Документ.Область(НомерСтроки + Номер, Колонка, НомерСтроки + Номер, Колонка + 1).Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
		Номер = Номер + 1;
	КонецЦикла;
	Возврат Номер;

КонецФункции

// Итоги строк по единицам одной строкой: «12 кг, 3 шт».
//
// Параметры:
//  Строки - Массив из СтрокаТаблицыЗначений - строки с колонками Единица и Количество.
//
// Возвращаемое значение:
//  Строка - итоги через запятую или «0».
//
Функция ИтогиСтрокой(Строки)

	Итоги = Новый Соответствие;
	Для Каждого СтрокаИтога Из Строки Цикл
		ДобавитьИтог(Итоги, СтрокаИтога.Единица, СтрокаИтога.Количество);
	КонецЦикла;
	Части = Новый Массив;
	Для Каждого Итог Из Итоги Цикл
		Части.Добавить(ФорматКоличества(Итог.Значение) + ?(ЗначениеЗаполнено(Итог.Ключ), " " + Строка(Итог.Ключ), ""));
	КонецЦикла;
	Возврат ?(Части.Количество() = 0, "0", СтрСоединить(Части, ", "));

КонецФункции

Процедура ВывестиШапкуОтчета(Контекст, ПараметрыОтчета)

	Область = ОбластьСтроки(Контекст);
	Область.Объединить();
	Область.Текст = НСтр("ru = 'Переработка по переработчикам'; fr = 'Sous-traitance par sous-traitant';
		|en = 'Processing by processor'; es = 'Procesamiento por procesador'");
	Область.Шрифт = ШрифтыСтиля.Шрифт_Основной_Увеличенный;
	Контекст.Строка = Контекст.Строка + 1;
	Шаблон = НСтр("ru = 'Передачи и приёмы с %1 по %2, остатки на %2'; fr = 'Envois et réceptions du %1 au %2, soldes au %2';
		|en = 'Transfers and receipts from %1 to %2, balances at %2'; es = 'Envíos y recepciones del %1 al %2, saldos al %2'");
	Начало = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=D");
	Конец = Формат(ПараметрыОтчета.КонецПериода, "ДЛФ=D");
	ВывестиТекст(Контекст, СтрШаблон(Шаблон, Начало, Конец), Ложь);
	Контекст.Строка = Контекст.Строка + 1;

КонецПроцедуры

Процедура ВывестиТекст(Контекст, Текст, Жирный)

	Область = ОбластьСтроки(Контекст);
	Область.Объединить();
	Область.Текст = Текст;
	Если Жирный Тогда
		Область.Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
	КонецЕсли;
	Контекст.Строка = Контекст.Строка + 1;

КонецПроцедуры

Функция ОбластьСтроки(Контекст)

	Возврат Контекст.Документ.Область(Контекст.Строка, 1, Контекст.Строка, ПоследняяКолонка());

КонецФункции

Процедура ВывестиЗаголовкиСекций(Документ, НомерСтроки)

	Названия = Новый Массив;
	Названия.Добавить(НСтр("ru = 'Передано'; fr = 'Envoyé'; en = 'Sent'; es = 'Enviado'"));
	Названия.Добавить(НСтр("ru = 'Принято'; fr = 'Reçu'; en = 'Received'; es = 'Recibido'"));
	Названия.Добавить(НСтр("ru = 'Остаток у переработчика'; fr = 'Solde chez le sous-traitant'; en = 'Balance at processor';
		|es = 'Saldo en el procesador'"));
	Колонки = Новый Массив;
	Колонки.Добавить(НСтр("ru = 'Дата,№ передачи,Номенклатура,Кол-во'; fr = 'Date,N° envoi,Article,Quantité';
		|en = 'Date,Transfer No.,Item,Quantity'; es = 'Fecha,N.º envío,Artículo,Cantidad'"));
	Колонки.Добавить(НСтр("ru = 'Дата,№ поступления,Продукция,Кол-во'; fr = 'Date,N° réception,Produit,Quantité';
		|en = 'Date,Receipt No.,Product,Quantity'; es = 'Fecha,N.º recepción,Producto,Cantidad'"));
	Колонки.Добавить(НСтр("ru = 'Номенклатура,Кол-во,Передача,Дней'; fr = 'Article,Quantité,Envoi,Jours';
		|en = 'Item,Quantity,Transfer,Days'; es = 'Artículo,Cantidad,Envío,Días'"));

	Для Номер = 1 По 3 Цикл
		Колонка = КолонкаСекции(Номер);
		Область = Документ.Область(НомерСтроки, Колонка, НомерСтроки, Колонка + 3);
		Область.Объединить();
		Область.Текст = Названия[Номер - 1];
		Область.Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Заголовки = СтрРазделить(Колонки[Номер - 1], ",");
		Для Индекс = 0 По Заголовки.ВГраница() Цикл
			Ячейка = Документ.Область(НомерСтроки + 1, Колонка + Индекс, НомерСтроки + 1, Колонка + Индекс);
			Ячейка.Текст = Заголовки[Индекс];
			Ячейка.Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
			Ячейка.ЦветФона = WebЦвета.ДымчатоБелый;
			Ячейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиЯчейку(Документ, НомерСтроки, Колонка, Текст, Расшифровка = Неопределено)

	Ячейка = Документ.Область(НомерСтроки, Колонка, НомерСтроки, Колонка);
	Ячейка.Текст = Текст;
	Если Расшифровка <> Неопределено Тогда
		Ячейка.Расшифровка = Расшифровка;
	КонецЕсли;

КонецПроцедуры

Процедура НастроитьКолонки(Документ)

	Ширины = СтрРазделить("11,14,24,12,2,11,22,24,12,2,24,12,18,8", ",");
	Для Индекс = 0 По Ширины.ВГраница() Цикл
		Документ.Область(1, Индекс + 1, 1, Индекс + 1).ШиринаКолонки = Число(Ширины[Индекс]);
	КонецЦикла;

КонецПроцедуры

// Первая колонка секции: секции по четыре колонки, между ними - узкая колонка-разделитель.
//
// Параметры:
//  Номер - Число - номер секции, 1-3.
//
// Возвращаемое значение:
//  Число - номер колонки.
//
Функция КолонкаСекции(Номер)

	Возврат (Номер - 1) * 5 + 1;

КонецФункции

Функция ПоследняяКолонка()

	Возврат КолонкаСекции(3) + 3;

КонецФункции

Функция ФорматКоличества(Количество)

	Возврат Формат(Количество, "ЧДЦ=3; ЧН=0");

КонецФункции

