#Область Процедуры_приложения

Процедура ПередНачаломРаботыСистемы(Отказ)
	ДанныеДоступа = ОбщегоНазначенияВызовСервера.ДоступРазрешён();
	Если ДанныеДоступа.ДоступРазрешён Тогда
		Если ДанныеДоступа.ЭтоВнешнийПользователь Тогда
			КлиентскоеПриложение.УстановитьРежимОсновногоОкна(РежимОсновногоОкнаКлиентскогоПриложения.ВстроенноеРабочееМесто);	
		КонецЕсли;	
	Иначе	
		Отказ = Истина;
		ПоказатьПредупреждение(, Нстр("fr = 'Accès refusé!'; ru = 'Доступ запрещён!'; en = 'Access is prohibited!'; es = '¡Acceso denegado!'"),, "Внимание");
	КонецЕсли;
	МенеджерОборудованияКлиент.ПередНачаломРаботыСистемы();
	ПараметрыПриложения = Новый Соответствие;
	УстановитьПараметрыСеансаКлиента(); // Параметры сеанса клиента на сервере
	КлиентскоеПриложение.УстановитьЗаголовок(КлиентскоеПриложение.ПолучитьЗаголовок() + " "+ ОбщегоНазначенияВызовСервера.ПолучитьЗаголовокСистемы());
КонецПроцедуры

Процедура ПередЗавершениемРаботыСистемы(Отказ, ТекстПредупреждения)
	МенеджерОборудованияКлиент.ПередЗавершениемРаботыСистемы()
