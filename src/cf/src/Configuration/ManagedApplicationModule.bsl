Процедура ПриНачалеРаботыСистемы()
	Если СтрНачинаетсяС(ПараметрЗапуска, "СмокТест") Тогда
		// Технологический запуск автотестов (scripts/smoke.sh, docs/TESTING.md):
		// обычная инициализация клиента не выполняется.
		ОткрытьФорму("Обработка.СмокТест.Форма");
		Возврат;
	КонецЕсли;
	Если Не ОбновлениеПрограммыКлиент.ОбработатьНачалоРаботы() Тогда
		// Данные базы не обновлены: работать с ними нельзя, программа завершается
		// после предупреждения (ОбновлениеПрограммыКлиент.ЗавершитьРаботуПослеПредупреждения).
		Возврат;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ВывестиСистемныеОповещения", 30, Ложь);
	МенеджерОборудованияКлиент.ПриНачалеРаботыСистемы();
	ОбщегоНазначенияВызовСервера.НастроитьПанели();
	ОбновитьИнтерфейс();
	БрендированиеКлиент.ВызовПервогоЗапуска();
КонецПроцедуры

Процедура ОбработкаВнешнегоСобытия(Источник, Событие, Данные)
	ОписаниеСобытия = Новый Структура();
	ОписаниеСобытия.Вставить("Источник", Источник);
	ОписаниеСобытия.Вставить("Событие", Событие);
	ОписаниеСобытия.Вставить("Данные", Данные);
	ОписаниеОшибки = "";
	// Передать на обработку данные.
	Результат = МенеджерОборудованияКлиент.ОбработатьСобытиеОтУстройства(ОписаниеСобытия, ОписаниеОшибки);
	Если Не Результат Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("fr = ""Une erreur s'est produite lors du traitement d'un événement externe du périphérique.""; ru = 'При обработке внешнего события от устройства произошла ошибка.'; en = 'An error occurred while processing an external event from the device.'; es = 'Se produjo un error al procesar un evento externo del dispositivo.'") + Символы.ПС + ОписаниеОшибки);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Дополнительно

Процедура УстановитьПараметрыСеансаКлиента()
	Результат = Новый Структура;
	#Если МобильныйКлиент Тогда
		Результат.Вставить("ЭтоМобильныйКлиент", Истина);	
	#Иначе
		Результат.Вставить("ЭтоМобильныйКлиент", Ложь);	
	#КонецЕсли
	#Если ВебКлиент Тогда
		Результат.Вставить("ЭтоВебКлиент", Истина);	
	#Иначе
		Результат.Вставить("ЭтоВебКлиент", Ложь);	
	#КонецЕсли
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Результат.Вставить("ИдентификаторКлиента", СистемнаяИнформация.ИдентификаторКлиента);
	Результат.Вставить("ОперативнаяПамять", Окр(СистемнаяИнформация.ОперативнаяПамять / 1024, 1));
	ОбщегоНазначенияВызовСервера.УстановкаПараметровСеансаКлиентаНаСервере(Результат);	
КонецПроцедуры	

Процедура ВывестиСистемныеОповещения() Экспорт 
	Мас = РаботаСДокументамиВызовСервера.ПолучитьНепоказанныеСистемныеОповещения();
	Для Каждого Стр Из Мас Цикл
		ПоказатьОповещениеПользователя(Стр.Описание, Стр.НавигационнаяСсылка,, БиблиотекаКартинок.Информация16, СтатусОповещенияПользователя.Важное);	
	КонецЦикла;
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.СистемныеОповещения"));
КонецПроцедуры

#КонецОбласти

