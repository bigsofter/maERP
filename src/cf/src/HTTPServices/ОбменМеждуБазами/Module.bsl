// HTTP-сервис обмена между базами (docs/plans/exchange-maerp.md, 6.2): обёртка над ОбменМеждуБазами.ОтветСервиса.
// Проверки вызывающего, подписи и размера - там, до разбора тела.

#Область ОбработчикиСобытий

Функция СообщениеPOST(Запрос)
	// Тело берётся только после допуска вызывающего: чужой пользователь не доходит до чтения.
	Отказ = ОбменМеждуБазами.ОтказДоЧтенияТела(Запрос.ПараметрыURL["Код"], Ложь, ЗаголовокЗапроса(Запрос, "content-length"));
	Если Отказ <> Неопределено Тогда
		Возврат HTTPОтвет(Отказ);
	КонецЕсли;
	Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
	Подпись = ПодписьЗапроса(Запрос);
	Данные = ОбменМеждуБазами.ОтветСервиса(Запрос.ПараметрыURL["Код"], Тело, Подпись, Ложь);
	Возврат HTTPОтвет(Данные);
КонецФункции

Функция ПроверкаGET(Запрос)
	Подпись = ПодписьЗапроса(Запрос);
	Данные = ОбменМеждуБазами.ОтветСервиса(Запрос.ПараметрыURL["Код"], Неопределено, Подпись, Истина);
	Возврат HTTPОтвет(Данные);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция HTTPОтвет(Данные)
	Ответ = Новый HTTPСервисОтвет(Данные.КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Если Не ПустаяСтрока(Данные.Подпись) Тогда
		Ответ.Заголовки.Вставить("X-Exchange-Signature", Данные.Подпись);
	КонецЕсли;
	Ответ.УстановитьТелоИзСтроки(Данные.Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ПодписьЗапроса(Запрос)
	Возврат ЗаголовокЗапроса(Запрос, "x-exchange-signature");
КонецФункции

Функция ЗаголовокЗапроса(Запрос, Имя)
	// Имена заголовков HTTP регистронезависимы.
	Для Каждого КлючИЗначение Из Запрос.Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) = Имя Тогда
			Возврат КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

#КонецОбласти
