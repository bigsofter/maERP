// Связь первого и второго документа пары оформления (план docs/plans/warehouse-orders-cost.md, фазы 3-4): приход
// пишет первый документ пары - источник (в схеме «ордер первый» - приходный или расходный ордер, в схеме «документ
// первый» - поступление или реализация), расход - второй документ по строке источника. Запись расхода - пара
// оформления: (Источник, КлючСтрокиИсточника) ↔
// (Регистратор, КодСтрокиРегистратора), количество. Комплект - коммерческой строкой: составляющие списывает расходный
// ордер по своему снимку. Измерение «Составляющая» с 2.0.16.122 не заполняется: записи составляющих прежних версий
// удаляет обработчик обновления, измерение уходит в фазе 5 (оставлено, чтобы реструктуризация не слила их с
// коммерческими строками).
// Привилегированный режим - осознанно: регистр пишут документы при проведении, ролям права записи не выдаются.
// BSLLS:SetPrivilegedMode-off

#Область ПрограммныйИнтерфейс

// Движения ордера по коммерческим строкам: строка без документа - приход (ордер - источник, ордер первый), строка с
// документом - расход по строке документа-источника (документ первый, Ф4.4): запись - пара оформления.
//
// Параметры:
//  ОрдерОбъект - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - проводимый ордер.
//
Процедура СформироватьДвиженияОрдера(ОрдерОбъект) Экспорт
	Набор = ОрдерОбъект.Движения.ТоварыКОформлению;
	Набор.Записывать = Истина;
	Набор.Очистить();
	Для Каждого Строка Из ОрдерОбъект.ТЧТовары Цикл
		Если Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПоДокументу = ЗначениеЗаполнено(Строка.ДокументИсточник);
		Запись = ?(ПоДокументу, Набор.ДобавитьРасход(), Набор.ДобавитьПриход());
		Запись.Период = ОрдерОбъект.Дата;
		Запись.МестоХранения = ОрдерОбъект.МестоХранения;
		Если ПоДокументу Тогда
			Запись.Источник = Строка.ДокументИсточник;
			Запись.КлючСтрокиИсточника = Строка.КлючСтрокиДокумента;
			Запись.КодСтрокиРегистратора = Строка.КодСтроки;
		Иначе
			Запись.Источник = ОрдерОбъект.Ссылка;
			Запись.КлючСтрокиИсточника = Строка.КодСтроки;
		КонецЕсли;
		Запись.Номенклатура = Строка.Номенклатура;
		Запись.Характеристика = Строка.Характеристика;
		Запись.Серия = Строка.Серия;
		Запись.Количество = Строка.Количество;
	КонецЦикла;
КонецПроцедуры

// Приход по строкам документа-источника (документ первый, Ф4.3): строки без ордера на ордерном на дату складе.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.РеализацияТоваровУслуг - проводимый документ.
//
// Возвращаемое значение:
//  ТаблицаЗначений - как РасходОформления, Источник - сам документ, КодСтрокиРегистратора - 0.
//
Функция ПриходИсточника(ДокОбъект) Экспорт
	Записи = НоваяТаблицаЗаписей();
	Если Не Справочники.МестаХранения.ОрдерныйСклад(ДокОбъект.МестоХранения, ДокОбъект.Дата) Тогда
		Возврат Записи;
	КонецЕсли;
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Если ЗначениеЗаполнено(Строка.Ордер) Или Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запись = Записи.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Строка, "Номенклатура, Характеристика, Серия, Количество");
		Запись.МестоХранения = ДокОбъект.МестоХранения;
		Запись.Источник = ДокОбъект.Ссылка;
		Запись.КлючСтрокиИсточника = Строка.КодСтроки;
	КонецЦикла;
	Возврат Записи;
КонецФункции

// Физические строки ордера - что ордер двигает на полке: строка некомплекта - сама номенклатура; строка-комплект
// расходного ордера - её составляющие по снимку ТЧФизическийСостав, Окр(количество строки × на единицу, 6).
//
// Параметры:
//  ОрдерОбъект - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - ордер.
//
// Возвращаемое значение:
//  ТаблицаЗначений - КодСтроки, Номенклатура, Характеристика, Серия, Комплект (пусто у некомплекта), Количество.
//
Функция ФизическиеСтрокиОрдера(ОрдерОбъект) Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КодСтроки", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Результат.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	Результат.Колонки.Добавить("Комплект", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ЕстьСостав = ТипЗнч(ОрдерОбъект) = Тип("ДокументОбъект.РасходныйОрдер");
	Для Каждого Строка Из ОрдерОбъект.ТЧТовары Цикл
		Состав = ?(ЕстьСостав, ОрдерОбъект.ТЧФизическийСостав.НайтиСтроки(Новый Структура("КодСтроки", Строка.КодСтроки)),
			Новый Массив);
		Если Состав.Количество() = 0 Тогда
			Физическая = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(Физическая, Строка, "КодСтроки, Номенклатура, Характеристика, Серия, Количество");
			Продолжить;
		КонецЕсли;
		Для Каждого Составляющая Из Состав Цикл
			Физическая = Результат.Добавить();
			Физическая.КодСтроки = Строка.КодСтроки;
			Физическая.Номенклатура = Составляющая.Номенклатура;
			Физическая.Комплект = Строка.Номенклатура;
			Физическая.Количество = Окр(Строка.Количество * Составляющая.КоличествоНаЕдиницу, РазрядностьКоличества());
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Источники документа для блокировки и контроля остатков: сам документ, источники его строк (ордера строк поступления и
// реализации, документы строк ордера) и прежних движений его регистратора (перепроведение со сменой связи, отмена).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - ордер, поступление или реализация.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка - без повторов и пустых.
//
Функция ОрдераДокумента(ДокОбъект) Экспорт
	Ордера = Новый Массив;
	// Документ - и сам источник (документ первый, Ф4.3): свой ключ в блокировке и контроле остатков.
	Если Не ДокОбъект.Ссылка.Пустая() Тогда
		Ордера.Добавить(ДокОбъект.Ссылка);
	КонецЕсли;
	ИмяСвязи = ?(ЭтоОрдер(ДокОбъект), "ДокументИсточник", "Ордер");
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Если ЗначениеЗаполнено(Строка[ИмяСвязи]) И Ордера.Найти(Строка[ИмяСвязи]) = Неопределено Тогда
			Ордера.Добавить(Строка[ИмяСвязи]);
		КонецЕсли;
	КонецЦикла;
	Если ДокОбъект.Ссылка.Пустая() Тогда
		Возврат Ордера;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Ордера, ПрежниеОрдера(ДокОбъект.Ссылка), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Ордера, ОформившиеИсточник(ДокОбъект.Ссылка), Истина);
	Возврат Ордера;
КонецФункции

// Документы, оформившие источник (регистраторы пар по нему): у поступления и реализации - ордера по документу, у
// ордера - поступления и реализации.
//
// Параметры:
//  Источник - ДокументСсылка - источник.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция ОформившиеИсточник(Источник) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению КАК Движения
	|ГДЕ
	|	Движения.Источник = &Источник
	|	И Движения.Регистратор <> &Источник");
	Запрос.УстановитьПараметр("Источник", Источник);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
КонецФункции

// Ордера, оформленные документом по его записанным движениям (прежние пары).
//
// Параметры:
//  Документ - ДокументСсылка - поступление или реализация.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер
//
Функция ПрежниеОрдера(Документ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.Источник КАК Источник
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Регистратор
	|	И Движения.Источник <> &Регистратор");
	Запрос.УстановитьПараметр("Регистратор", Документ);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Источник");
КонецФункции

// Расход оформления по строкам документа с ордером - запись на строку: она и есть пара оформления.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.РеализацияТоваровУслуг - оформляющий документ.
//
// Возвращаемое значение:
//  ТаблицаЗначений - МестоХранения, Источник, КлючСтрокиИсточника, Номенклатура, Характеристика, Серия,
//                    КодСтрокиРегистратора, Количество.
//
Функция РасходОформления(ДокОбъект) Экспорт
	Записи = НоваяТаблицаЗаписей();
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Если Не ЗначениеЗаполнено(Строка.Ордер) Или Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запись = Записи.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Строка, "Номенклатура, Характеристика, Серия, Количество");
		Запись.МестоХранения = ДокОбъект.МестоХранения;
		Запись.Источник = Строка.Ордер;
		Запись.КлючСтрокиИсточника = Строка.КлючСтрокиОрдера;
		Запись.КодСтрокиРегистратора = Строка.КодСтроки;
	КонецЦикла;
	Возврат Записи;
КонецФункции

// Контроль целостности связи (общий план, «Целостность связи»): после записи движений остаток по каждому ключу
// источников документа не меньше нуля. Вызывается после Движения.Записать() под блокировкой.
//
// Параметры:
//  Ордера    - Массив из ДокументСсылка - источники прежних и новых движений.
//  ДокОбъект - ДокументОбъект - документ, к которому привязываются сообщения.
//  Отказ     - Булево - выставляется при отрицательном остатке.
//
Процедура ПроверитьОстатки(Ордера, ДокОбъект, Отказ) Экспорт
	Если Ордера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Источник КАК Источник,
	|	Остатки.КлючСтрокиИсточника КАК КлючСтрокиИсточника,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению.Остатки(, Источник В (&Ордера)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.КлючСтрокиИсточника");
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Выборка = Запрос.Выполнить().Выбрать();
	Шаблон = НСтр("ru = '%1, строка %2, %3: оформлено больше, чем по документу, на %4. Сначала отмените оформление или
		|исправьте количество.';
		|fr = '%1, ligne %2, %3 : régularisé au-delà du document de %4. Annulez d''abord la régularisation ou corrigez la
		|quantité.';
		|en = '%1, line %2, %3: documented %4 more than the document. Cancel the documenting first or correct the
		|quantity.';
		|es = '%1, línea %2, %3: formalizado %4 más que el documento. Anule primero la formalización o corrija la
		|cantidad.'");
	Пока Выборка.Следующий() Цикл
		Текст = СтрШаблон(Шаблон, Выборка.Источник, Выборка.КлючСтрокиИсточника, Выборка.Номенклатура, -Выборка.Остаток);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ДокОбъект, , , Отказ);
	КонецЦикла;
КонецПроцедуры

// Оформления источника - пары с другими регистраторами: по ключу строки - количество, документ и его момент.
//
// Параметры:
//  Ордер - ДокументСсылка - источник: ордер (ордер первый) или поступление, реализация (документ первый).
//
// Возвращаемое значение:
//  ТаблицаЗначений - КлючСтрокиОрдера, Количество (оформлено), МинимальнаяДата (самая ранняя дата оформляющего
//                    документа), МинимальныйМомент (МоментВремени самого раннего оформляющего документа строки);
//                    пустая - оформлений нет.
//
Функция ОформленияОрдера(Ордер) Экспорт
	Результат = НоваяТаблицаОформлений();
	Если Не ЗначениеЗаполнено(Ордер) Тогда
		Возврат Результат;
	КонецЕсли;
	Пары = ПарыОформления(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ордер));
	// Пары упорядочены по моменту регистратора: первая пара ключа - самая ранняя. Пары, где документ - регистратор
	// (ордер по документу), - не его оформления.
	Для Каждого Пара Из Пары Цикл
		Если Пара.Источник <> Ордер Тогда
			Продолжить;
		КонецЕсли;
		Строка = Результат.Найти(Пара.КлючСтрокиИсточника, "КлючСтрокиОрдера");
		Если Строка = Неопределено Тогда
			Строка = Результат.Добавить();
			Строка.КлючСтрокиОрдера = Пара.КлючСтрокиИсточника;
			Строка.МинимальнаяДата = Пара.МоментРегистратора.Дата;
			Строка.МинимальныйМомент = Пара.МоментРегистратора;
		КонецЕсли;
		Строка.Количество = Строка.Количество + Пара.Количество;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Пары оформления документов (план warehouse-orders-cost, Ф3.2): записи расхода регистра, у которых документ - источник
// или регистратор. Старые записи без кода строки регистратора (до 2.0.16.122 расход писался свёрткой по ключу строки
// ордера) восстанавливают строку по табличной части регистратора: строки с тем же ордером и ключом, каждая со своим
// количеством.
//
// Параметры:
//  Документы - Массив из ДокументСсылка - ордера, поступления, реализации.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Источник, КлючСтрокиИсточника, Регистратор, КодСтрокиРегистратора, Количество, МоментРегистратора
//                    (МоментВремени) и стороны пары (Ф4.2): Ордер, КодСтрокиОрдера, МоментОрдера, Документ,
//                    КодСтрокиДокумента, МоментДокумента; упорядочена по моменту регистратора, затем коду его строки.
//
Функция ПарыОформления(Документы) Экспорт
	Результат = НоваяТаблицаПар();
	Если Документы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Движения.Источник КАК Источник,
	|	Движения.КлючСтрокиИсточника КАК КлючСтрокиИсточника,
	|	Движения.Регистратор КАК Регистратор,
	|	Движения.КодСтрокиРегистратора КАК КодСтрокиРегистратора,
	|	Движения.Количество КАК Количество,
	|	Движения.МоментВремени КАК МоментРегистратора
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению КАК Движения
	|ГДЕ
	|	Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Движения.Активность
	|	И Движения.Регистратор <> Движения.Источник
	|	И Движения.Источник В (&Документы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Движения.Источник,
	|	Движения.КлючСтрокиИсточника,
	|	Движения.Регистратор,
	|	Движения.КодСтрокиРегистратора,
	|	Движения.Количество,
	|	Движения.МоментВремени
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению КАК Движения
	|ГДЕ
	|	Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Движения.Активность
	|	И Движения.Регистратор <> Движения.Источник
	|	И Движения.Регистратор В (&Документы)
	|	И НЕ Движения.Источник В (&Документы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментРегистратора,
	|	КодСтрокиРегистратора");
	Запрос.УстановитьПараметр("Документы", Документы);
	Записи = Запрос.Выполнить().Выгрузить();
	Старые = Записи.НайтиСтроки(Новый Структура("КодСтрокиРегистратора", 0));
	СтрокиСтарых = ?(Старые.Количество() = 0, Неопределено, СтрокиРегистраторов(Старые));
	Для Каждого Запись Из Записи Цикл
		Если Запись.КодСтрокиРегистратора <> 0 Или СтрокиСтарых = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Запись);
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("Ссылка, Ордер, КлючСтрокиОрдера", Запись.Регистратор, Запись.Источник,
			Запись.КлючСтрокиИсточника);
		Строки = СтрокиСтарых.НайтиСтроки(Отбор);
		ВсегоСтрок = 0;
		Для Каждого Строка Из Строки Цикл
			ВсегоСтрок = ВсегоСтрок + Строка.Количество;
		КонецЦикла;
		Если ВсегоСтрок <> Запись.Количество Тогда
			// Строки регистратора разошлись с записанной свёрткой - пара без строки (стоимости не даёт).
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Запись);
			Продолжить;
		КонецЕсли;
		Для Каждого Строка Из Строки Цикл
			Пара = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(Пара, Запись);
			Пара.КодСтрокиРегистратора = Строка.КодСтроки;
			Пара.Количество = Строка.Количество;
		КонецЦикла;
	КонецЦикла;
	ЗаполнитьСтороныПар(Результат);
	Возврат Результат;
КонецФункции

// Ссылки строк поступлений и реализаций на ордер - защита удаления ордера (ссылочная целостность реквизита
// строки не мешает программному Удалить()).
//
// Параметры:
//  Ордер - ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - ордер.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка - документы со строками этого ордера.
//
Функция ДокументыСоСтрокамиОрдера(Ордер) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Строки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК Строки
	|ГДЕ
	|	Строки.Ордер = &Ордер
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Строки.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК Строки
	|ГДЕ
	|	Строки.Ордер = &Ордер");
	Запрос.УстановитьПараметр("Ордер", Ордер);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

// Неоформленный остаток строк ордеров - для ввода документа на основании ордеров.
//
// Параметры:
//  Ордера - Массив из ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - ордера.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ордер, КлючСтрокиОрдера, Номенклатура, Характеристика, Серия, Количество; только положительные.
//
Функция НеоформленныеСтроки(Ордера) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Источник КАК Ордер,
	|	Остатки.КлючСтрокиИсточника КАК КлючСтрокиОрдера,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению.Остатки(, Источник В (&Ордера)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Источник,
	|	Остатки.КлючСтрокиИсточника");
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Стороны пар независимо от направления (Ф4.2): ордер и его строка, документ (поступление, реализация) и его строка,
// моменты обоих.
//
// Параметры:
//  Пары - ТаблицаЗначений - см. ПарыОформления; колонки сторон заполняются.
//
Процедура ЗаполнитьСтороныПар(Пары)
	Источники = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Если Источники.Найти(Пара.Источник) = Неопределено Тогда
			Источники.Добавить(Пара.Источник);
		КонецЕсли;
	КонецЦикла;
	Даты = ?(Источники.Количество() = 0, Новый Соответствие, ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Источники, "Дата"));
	Для Каждого Пара Из Пары Цикл
		МоментИсточника = Новый МоментВремени(Даты[Пара.Источник].Дата, Пара.Источник);
		ОрдерИсточник = ТипЗнч(Пара.Источник) = Тип("ДокументСсылка.ПриходныйОрдер")
			Или ТипЗнч(Пара.Источник) = Тип("ДокументСсылка.РасходныйОрдер");
		Если ОрдерИсточник Тогда
			Пара.Ордер = Пара.Источник;
			Пара.КодСтрокиОрдера = Пара.КлючСтрокиИсточника;
			Пара.МоментОрдера = МоментИсточника;
			Пара.Документ = Пара.Регистратор;
			Пара.КодСтрокиДокумента = Пара.КодСтрокиРегистратора;
			Пара.МоментДокумента = Пара.МоментРегистратора;
		Иначе
			Пара.Ордер = Пара.Регистратор;
			Пара.КодСтрокиОрдера = Пара.КодСтрокиРегистратора;
			Пара.МоментОрдера = Пара.МоментРегистратора;
			Пара.Документ = Пара.Источник;
			Пара.КодСтрокиДокумента = Пара.КлючСтрокиИсточника;
			Пара.МоментДокумента = МоментИсточника;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЭтоОрдер(ДокОбъект)
	Возврат ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйОрдер") Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РасходныйОрдер");
КонецФункции

Функция РазрядностьКоличества()
	Возврат 6;
КонецФункции

Функция НоваяТаблицаЗаписей()
	Записи = Новый ТаблицаЗначений;
	Записи.Колонки.Добавить("МестоХранения", Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
	Записи.Колонки.Добавить("Источник", Метаданные.РегистрыНакопления.ТоварыКОформлению.Измерения.Источник.Тип);
	Записи.Колонки.Добавить("КлючСтрокиИсточника", Метаданные.ОпределяемыеТипы.КодСтроки.Тип);
	Записи.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Записи.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Записи.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	Записи.Колонки.Добавить("КодСтрокиРегистратора", Метаданные.ОпределяемыеТипы.КодСтроки.Тип);
	Записи.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Возврат Записи;
КонецФункции

Функция НоваяТаблицаОформлений()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("КлючСтрокиОрдера", Метаданные.ОпределяемыеТипы.КодСтроки.Тип);
	Таблица.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Таблица.Колонки.Добавить("МинимальнаяДата", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("МинимальныйМомент");
	Возврат Таблица;
КонецФункции

Функция НоваяТаблицаПар()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Источник", Метаданные.РегистрыНакопления.ТоварыКОформлению.Измерения.Источник.Тип);
	Таблица.Колонки.Добавить("КлючСтрокиИсточника", Метаданные.ОпределяемыеТипы.КодСтроки.Тип);
	Таблица.Колонки.Добавить("Регистратор");
	Таблица.Колонки.Добавить("КодСтрокиРегистратора", Метаданные.ОпределяемыеТипы.КодСтроки.Тип);
	Таблица.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Таблица.Колонки.Добавить("МоментРегистратора");
	КодСтроки = Метаданные.ОпределяемыеТипы.КодСтроки.Тип;
	Таблица.Колонки.Добавить("Ордер");
	Таблица.Колонки.Добавить("КодСтрокиОрдера", КодСтроки);
	Таблица.Колонки.Добавить("МоментОрдера");
	Таблица.Колонки.Добавить("Документ");
	Таблица.Колонки.Добавить("КодСтрокиДокумента", КодСтроки);
	Таблица.Колонки.Добавить("МоментДокумента");
	Возврат Таблица;
КонецФункции

// Строки табличных частей регистраторов старых записей расхода - для восстановления пар без кода строки.
//
// Параметры:
//  Старые - Массив из СтрокаТаблицыЗначений - записи с нулевым кодом строки регистратора.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ссылка, Ордер, КлючСтрокиОрдера, КодСтроки, Количество.
//
Функция СтрокиРегистраторов(Старые)
	Регистраторы = Новый Массив;
	Для Каждого Запись Из Старые Цикл
		Если Регистраторы.Найти(Запись.Регистратор) = Неопределено Тогда
			Регистраторы.Добавить(Запись.Регистратор);
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Строки.Ссылка КАК Ссылка,
	|	Строки.Ордер КАК Ордер,
	|	Строки.КлючСтрокиОрдера КАК КлючСтрокиОрдера,
	|	Строки.КодСтроки КАК КодСтроки,
	|	Строки.Количество КАК Количество
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК Строки
	|ГДЕ
	|	Строки.Ссылка В (&Регистраторы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Строки.Ссылка,
	|	Строки.Ордер,
	|	Строки.КлючСтрокиОрдера,
	|	Строки.КодСтроки,
	|	Строки.Количество
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК Строки
	|ГДЕ
	|	Строки.Ссылка В (&Регистраторы)");
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти
