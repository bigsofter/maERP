// Неоформленный остаток строк ордеров склада (план docs/plans/warehouse-orders.md, фаза 2): приход пишет ордер,
// расход - поступление или реализация по ордеру. Составляющие комплектов расходного ордера - отдельными записями с
// заполненным измерением «Составляющая» (общий план, «Частичное оформление комплекта без ошибки округления»).
// Привилегированный режим - осознанно: регистр пишут документы при проведении, ролям права записи не выдаются.
// BSLLS:SetPrivilegedMode-off

#Область ПрограммныйИнтерфейс

// Приход по строкам ордера: коммерческая строка и, у расходного ордера, составляющие комплектов ровно теми
// количествами, что ордер списал с полки (см. ФизическиеСтрокиОрдера).
//
// Параметры:
//  ОрдерОбъект - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - проводимый ордер.
//
Процедура СформироватьДвиженияОрдера(ОрдерОбъект) Экспорт
	Набор = ОрдерОбъект.Движения.ТоварыКОформлению;
	Набор.Записывать = Истина;
	Набор.Очистить();
	Для Каждого Строка Из ОрдерОбъект.ТЧТовары Цикл
		Если Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.ДобавитьПриход();
		ЗаполнитьКлючЗаписи(Запись, ОрдерОбъект, Строка);
		Запись.Количество = Строка.Количество;
	КонецЦикла;
	Если ТипЗнч(ОрдерОбъект) <> Тип("ДокументОбъект.РасходныйОрдер") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Физическая Из ФизическиеСтрокиОрдера(ОрдерОбъект) Цикл
		Если Не ЗначениеЗаполнено(Физическая.Комплект) Тогда
			Продолжить;
		КонецЕсли;
		Строка = ОрдерОбъект.ТЧТовары.Найти(Физическая.КодСтроки, "КодСтроки");
		Запись = Набор.ДобавитьПриход();
		ЗаполнитьКлючЗаписи(Запись, ОрдерОбъект, Строка);
		Запись.Составляющая = Физическая.Номенклатура;
		Запись.Количество = Физическая.Количество;
	КонецЦикла;
КонецПроцедуры

// Физические строки ордера - что ордер двигает на полке: строка некомплекта - сама номенклатура; строка-комплект -
// её составляющие по снимку ТЧФизическийСостав, Окр(количество строки × на единицу, 6).
//
// Параметры:
//  ОрдерОбъект - ДокументОбъект.ПриходныйОрдер, ДокументОбъект.РасходныйОрдер - ордер.
//
// Возвращаемое значение:
//  ТаблицаЗначений - КодСтроки, Номенклатура, Характеристика, Серия, Комплект (пусто у некомплекта), Количество.
//
Функция ФизическиеСтрокиОрдера(ОрдерОбъект) Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КодСтроки", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Результат.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	Результат.Колонки.Добавить("Комплект", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ЕстьСостав = ТипЗнч(ОрдерОбъект) = Тип("ДокументОбъект.РасходныйОрдер");
	Для Каждого Строка Из ОрдерОбъект.ТЧТовары Цикл
		Состав = ?(ЕстьСостав, ОрдерОбъект.ТЧФизическийСостав.НайтиСтроки(Новый Структура("КодСтроки", Строка.КодСтроки)),
			Новый Массив);
		Если Состав.Количество() = 0 Тогда
			Физическая = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(Физическая, Строка, "КодСтроки, Номенклатура, Характеристика, Серия, Количество");
			Продолжить;
		КонецЕсли;
		Для Каждого Составляющая Из Состав Цикл
			Физическая = Результат.Добавить();
			Физическая.КодСтроки = Строка.КодСтроки;
			Физическая.Номенклатура = Составляющая.Номенклатура;
			Физическая.Комплект = Строка.Номенклатура;
			Физическая.Количество = Окр(Строка.Количество * Составляющая.КоличествоНаЕдиницу, РазрядностьКоличества());
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Ордера документа для блокировки и контроля: из строк документа и из прежних движений его регистратора
// (перепроведение со сменой ордера, отмена проведения).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - ордер, поступление или реализация.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - без повторов и пустых.
//
Функция ОрдераДокумента(ДокОбъект) Экспорт
	Ордера = Новый Массив;
	Если ЭтоОрдер(ДокОбъект) Тогда
		Если Не ДокОбъект.Ссылка.Пустая() Тогда
			Ордера.Добавить(ДокОбъект.Ссылка);
		КонецЕсли;
		Возврат Ордера;
	КонецЕсли;
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Если ЗначениеЗаполнено(Строка.Ордер) И Ордера.Найти(Строка.Ордер) = Неопределено Тогда
			Ордера.Добавить(Строка.Ордер);
		КонецЕсли;
	КонецЦикла;
	Если ДокОбъект.Ссылка.Пустая() Тогда
		Возврат Ордера;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.Ордер КАК Ордер
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Регистратор");
	Запрос.УстановитьПараметр("Регистратор", ДокОбъект.Ссылка);
	Для Каждого Ордер Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ордер") Цикл
		Если Ордера.Найти(Ордер) = Неопределено Тогда
			Ордера.Добавить(Ордер);
		КонецЕсли;
	КонецЦикла;
	Возврат Ордера;
КонецФункции

// Расход оформления по строкам документа с ордером: коммерческая строка - количество строки; составляющие комплекта
// считаются один раз на ключ строки ордера (сумма строк документа этого ключа) от доступного остатка - остатка регистра
// плюс собственных прежних расходов документа: закрытие строки ордера - остаток каждой составляющей, иначе
// Окр(на единицу × количество, 6), но не больше доступного. Составляющие распределяются по строкам документа методом
// наибольших остатков в миллионных: доли не меньше нуля, сумма по ключу точно равна рассчитанной. Вызывается под
// блокировкой ТоварыКОформлению по ордерам документа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.РеализацияТоваровУслуг - оформляющий документ.
//
// Возвращаемое значение:
//  Структура:
//   * Записи       - ТаблицаЗначений - записи расхода: МестоХранения, Ордер, КлючСтрокиОрдера, Номенклатура,
//                    Характеристика, Серия, Составляющая, Количество.
//   * Составляющие - ТаблицаЗначений - по строкам документа: КодСтроки, Комплект, Номенклатура (составляющая),
//                    Количество - для списания партий комплекта по снимку ордера.
//
Функция РасходОформления(ДокОбъект) Экспорт
	Результат = Новый Структура("Записи, Составляющие", НоваяТаблицаЗаписей(), НоваяТаблицаСоставляющих());
	СтрокиСОрдером = Новый Массив;
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Если ЗначениеЗаполнено(Строка.Ордер) И Строка.Количество <> 0 Тогда
			СтрокиСОрдером.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Если СтрокиСОрдером.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Строка Из СтрокиСОрдером Цикл
		Запись = Результат.Записи.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Строка, "Ордер, КлючСтрокиОрдера, Номенклатура, Характеристика, Серия, Количество");
		Запись.МестоХранения = ДокОбъект.МестоХранения;
	КонецЦикла;
	Результат.Записи.Свернуть("МестоХранения, Ордер, КлючСтрокиОрдера, Номенклатура, Характеристика, Серия, Составляющая",
		"Количество");
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ДобавитьСоставляющиеОформления(ДокОбъект, СтрокиСОрдером, Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Контроль целостности связи ордер - документ (общий план, «Целостность связи»): после записи движений остаток по
// каждому ключу ордеров документа не меньше нуля. Вызывается после Движения.Записать() под блокировкой.
//
// Параметры:
//  Ордера    - Массив из ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - ордера прежних и новых движений.
//  ДокОбъект - ДокументОбъект - документ, к которому привязываются сообщения.
//  Отказ     - Булево - выставляется при отрицательном остатке.
//
Процедура ПроверитьОстатки(Ордера, ДокОбъект, Отказ) Экспорт
	Если Ордера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Ордер КАК Ордер,
	|	Остатки.КлючСтрокиОрдера КАК КлючСтрокиОрдера,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Составляющая КАК Составляющая,
	|	Остатки.КоличествоОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению.Остатки(, Ордер В (&Ордера)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.КлючСтрокиОрдера");
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Выборка = Запрос.Выполнить().Выбрать();
	Шаблон = НСтр("ru = 'Ордер %1, строка %2, %3: оформлено больше, чем по ордеру, на %4. Сначала отмените оформление или
		|исправьте количество.';
		|fr = 'Bon %1, ligne %2, %3 : régularisé au-delà du bon de %4. Annulez d''abord la régularisation ou corrigez la
		|quantité.';
		|en = 'Order %1, line %2, %3: documented %4 more than the order. Cancel the documenting first or correct the
		|quantity.';
		|es = 'Orden %1, línea %2, %3: formalizado %4 más que la orden. Anule primero la formalización o corrija la
		|cantidad.'");
	Пока Выборка.Следующий() Цикл
		Позиция = ?(ЗначениеЗаполнено(Выборка.Составляющая), Выборка.Составляющая, Выборка.Номенклатура);
		Текст = СтрШаблон(Шаблон, Выборка.Ордер, Выборка.КлючСтрокиОрдера, Позиция, -Выборка.Остаток);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ДокОбъект, , , Отказ);
	КонецЦикла;
КонецПроцедуры

// Есть ли у ордера оформления - расход ТоварыКОформлению другими регистраторами (по ключу строки или в целом).
//
// Параметры:
//  Ордер         - ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - ордер.
//
// Возвращаемое значение:
//  ТаблицаЗначений - КлючСтрокиОрдера, Количество (оформлено по коммерческой строке), МинимальнаяДата (самая ранняя
//                    дата оформляющего документа); пустая - оформлений нет.
//
Функция ОформленияОрдера(Ордер) Экспорт
	Если Не ЗначениеЗаполнено(Ордер) Тогда
		Возврат НоваяТаблицаОформлений();
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Движения.КлючСтрокиОрдера КАК КлючСтрокиОрдера,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.Составляющая = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ТОГДА Движения.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Количество,
	|	МИНИМУМ(Движения.Период) КАК МинимальнаяДата
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению КАК Движения
	|ГДЕ
	|	Движения.Ордер = &Ордер
	|	И Движения.Регистратор <> &Ордер
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Движения.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.КлючСтрокиОрдера");
	Запрос.УстановитьПараметр("Ордер", Ордер);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Ссылки строк поступлений и реализаций на ордер - защита удаления ордера (ссылочная целостность реквизита
// строки не мешает программному Удалить()).
//
// Параметры:
//  Ордер - ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - ордер.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка - документы со строками этого ордера.
//
Функция ДокументыСоСтрокамиОрдера(Ордер) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Строки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК Строки
	|ГДЕ
	|	Строки.Ордер = &Ордер
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Строки.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ТЧТовары КАК Строки
	|ГДЕ
	|	Строки.Ордер = &Ордер");
	Запрос.УстановитьПараметр("Ордер", Ордер);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

// Неоформленный остаток коммерческих строк ордеров - для ввода документа на основании ордеров.
//
// Параметры:
//  Ордера - Массив из ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер - ордера.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ордер, КлючСтрокиОрдера, Номенклатура, Характеристика, Серия, Количество; только положительные.
//
Функция НеоформленныеСтроки(Ордера) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Ордер КАК Ордер,
	|	Остатки.КлючСтрокиОрдера КАК КлючСтрокиОрдера,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Серия КАК Серия,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению.Остатки(
	|			,
	|			Ордер В (&Ордера)
	|				И Составляющая = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Ордер,
	|	Остатки.КлючСтрокиОрдера");
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Заменяет в таблице списания партий реализации строки комплектов, оформляющие расходный ордер, строками
// составляющих по снимку ордера (см. РасходОформления): партии списываются по составу, который ушёл с полки, а не по
// текущему составу справочника. Строки составляющих получают колонку «Комплект», как у РазложитьКомплектыНаСоставляющие.
//
// Параметры:
//  ТЗ           - ТаблицаЗначений - строки списания (СерииИРазмещение.ОбъединитьТоварыССериями) с колонкой КодСтроки.
//  Составляющие - ТаблицаЗначений - см. РасходОформления, Составляющие.
//
Процедура ЗаменитьКомплектыПоОрдерам(ТЗ, Составляющие) Экспорт
	Если Составляющие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ТЗ.Колонки.Найти("Комплект") = Неопределено Тогда
		ТЗ.Колонки.Добавить("Комплект", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	КонецЕсли;
	ПолеКода = "КодСтроки";
	Коды = Составляющие.Скопировать(, ПолеКода);
	Коды.Свернуть(ПолеКода);
	Для Каждого Код Из Коды Цикл
		Отбор = Новый Структура(ПолеКода, Код.КодСтроки);
		Строки = ТЗ.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Образец = Строки[0];
		Для Каждого Составляющая Из Составляющие.НайтиСтроки(Отбор) Цикл
			Если Составляющая.Количество = 0 Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ТЗ.Добавить();
			НоваяСтрока.КодСтроки = Образец.КодСтроки;
			НоваяСтрока.МестоХранения = Образец.МестоХранения;
			НоваяСтрока.Номенклатура = Составляющая.Номенклатура;
			НоваяСтрока.Комплект = Составляющая.Комплект;
			НоваяСтрока.Количество = Составляющая.Количество;
			НоваяСтрока.ЕстьПартия = Ложь;
		КонецЦикла;
		Для Каждого Строка Из Строки Цикл
			ТЗ.Удалить(Строка);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоОрдер(ДокОбъект)
	Возврат ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйОрдер") Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РасходныйОрдер");
КонецФункции

Процедура ЗаполнитьКлючЗаписи(Запись, ОрдерОбъект, Строка)
	Запись.Период = ОрдерОбъект.Дата;
	Запись.МестоХранения = ОрдерОбъект.МестоХранения;
	Запись.Ордер = ОрдерОбъект.Ссылка;
	Запись.КлючСтрокиОрдера = Строка.КодСтроки;
	Запись.Номенклатура = Строка.Номенклатура;
	Запись.Характеристика = Строка.Характеристика;
	Запись.Серия = Строка.Серия;
КонецПроцедуры

Функция РазрядностьКоличества()
	Возврат 6;
КонецФункции

Функция НоваяТаблицаЗаписей()
	Записи = Новый ТаблицаЗначений;
	Записи.Колонки.Добавить("МестоХранения", Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
	Записи.Колонки.Добавить("Ордер", Новый ОписаниеТипов("ДокументСсылка.ПриходныйОрдер, ДокументСсылка.РасходныйОрдер"));
	Записи.Колонки.Добавить("КлючСтрокиОрдера", Новый ОписаниеТипов("Число"));
	Записи.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Записи.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Записи.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	Записи.Колонки.Добавить("Составляющая", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Записи.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Возврат Записи;
КонецФункции

Функция НоваяТаблицаСоставляющих()
	Составляющие = Новый ТаблицаЗначений;
	Составляющие.Колонки.Добавить("КодСтроки", Новый ОписаниеТипов("Число"));
	Составляющие.Колонки.Добавить("Комплект", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Составляющие.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Составляющие.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Возврат Составляющие;
КонецФункции

Функция НоваяТаблицаОформлений()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("КлючСтрокиОрдера", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("МинимальнаяДата", Новый ОписаниеТипов("Дата"));
	Возврат Таблица;
КонецФункции

// Составляющие комплектов строк реализации по расходным ордерам: расчёт на ключ строки ордера и распределение по
// строкам документа (см. РасходОформления).
//
// Параметры:
//  ДокОбъект      - ДокументОбъект.РеализацияТоваровУслуг - реализация.
//  СтрокиСОрдером - Массив из СтрокаТабличнойЧасти - строки товаров с ордером.
//  Результат      - Структура - см. РасходОформления; дополняется.
//
Процедура ДобавитьСоставляющиеОформления(ДокОбъект, СтрокиСОрдером, Результат)
	// Каждая строка-комплект по ордеру уходит из списания партий целиком (нулевая строка составляющих), даже если все
	// её составляющие уже оформлены прежними документами и в остатках их нет: иначе списание разложит комплект заново
	// по текущему составу справочника.
	ДобавитьНулевыеСтрокиКомплектов(СтрокиСОрдером, Результат.Составляющие);
	Доступно = ДоступныйОстатокСоставляющих(ДокОбъект, СтрокиСОрдером);
	Если Доступно.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Ключи = Доступно.Скопировать(, "Ордер, КлючСтрокиОрдера, Комплект, КоммерческийОстаток");
	Ключи.Свернуть("Ордер, КлючСтрокиОрдера, Комплект, КоммерческийОстаток");
	Для Каждого Ключ Из Ключи Цикл
		СтрокиКлюча = СтрокиКлючаОрдера(СтрокиСОрдером, Ключ);
		Оформляется = 0;
		Для Каждого Строка Из СтрокиКлюча Цикл
			Оформляется = Оформляется + Строка.Количество;
		КонецЦикла;
		Закрытие = Оформляется >= Ключ.КоммерческийОстаток;
		Отбор = Новый Структура("Ордер, КлючСтрокиОрдера", Ключ.Ордер, Ключ.КлючСтрокиОрдера);
		Для Каждого Составляющая Из Доступно.НайтиСтроки(Отбор) Цикл
			Количество = ?(Закрытие, Составляющая.Остаток,
				Мин(Окр(Составляющая.НаЕдиницу * Оформляется, РазрядностьКоличества()), Составляющая.Остаток));
			Количество = Макс(Количество, 0);
			// Нулевая составляющая записи не даёт, но строку распределения получает: строка комплекта уходит из списания
			// партий целиком, а не раскладывается заново по текущему составу справочника.
			РаспределитьПоСтрокам(Результат.Составляющие, СтрокиКлюча, Оформляется, Ключ.Комплект,
				Составляющая.Составляющая, Количество);
			Если Количество = 0 Тогда
				Продолжить;
			КонецЕсли;
			Запись = Результат.Записи.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Составляющая, "МестоХранения, Ордер, КлючСтрокиОрдера, Характеристика, Серия");
			Запись.Номенклатура = Ключ.Комплект;
			Запись.Составляющая = Составляющая.Составляющая;
			Запись.Количество = Количество;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьНулевыеСтрокиКомплектов(СтрокиСОрдером, Составляющие)
	Позиции = Новый Массив;
	Для Каждого Строка Из СтрокиСОрдером Цикл
		Позиции.Добавить(Строка.Номенклатура);
	КонецЦикла;
	Типы = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Позиции, "ТипНоменклатуры");
	Для Каждого Строка Из СтрокиСОрдером Цикл
		Реквизиты = Типы[Строка.Номенклатура];
		Если Реквизиты = Неопределено Или Реквизиты.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Комплект Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Составляющие.Добавить();
		НоваяСтрока.КодСтроки = Строка.КодСтроки;
		НоваяСтрока.Комплект = Строка.Номенклатура;
		НоваяСтрока.Количество = 0;
	КонецЦикла;
КонецПроцедуры

// Строки документа одного ключа строки ордера.
//
// Параметры:
//  СтрокиСОрдером - Массив из СтрокаТабличнойЧасти - строки товаров с ордером.
//  Ключ           - СтрокаТаблицыЗначений - Ордер и КлючСтрокиОрдера.
//
// Возвращаемое значение:
//  Массив из СтрокаТабличнойЧасти - строки ключа.
//
Функция СтрокиКлючаОрдера(СтрокиСОрдером, Ключ)
	Результат = Новый Массив;
	Для Каждого Строка Из СтрокиСОрдером Цикл
		Если Строка.Ордер = Ключ.Ордер И Строка.КлючСтрокиОрдера = Ключ.КлючСтрокиОрдера Тогда
			Результат.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Доступный остаток составляющих по ключам строк ордеров документа: остаток регистра плюс собственные прежние расходы
// документа (перепроведение не видит свои старые списания как «уже оформлено»); на единицу - из снимка ордера.
//
// Параметры:
//  ДокОбъект      - ДокументОбъект.РеализацияТоваровУслуг - реализация.
//  СтрокиСОрдером - Массив из СтрокаТабличнойЧасти - строки товаров с ордером.
//
// Возвращаемое значение:
//  ТаблицаЗначений - МестоХранения, Ордер, КлючСтрокиОрдера, Комплект, Характеристика, Серия, Составляющая, Остаток,
//                    НаЕдиницу, КоммерческийОстаток.
//
Функция ДоступныйОстатокСоставляющих(ДокОбъект, СтрокиСОрдером)
	Ключи = Новый ТаблицаЗначений;
	Ключи.Колонки.Добавить("Ордер", Новый ОписаниеТипов("ДокументСсылка.РасходныйОрдер"));
	Ключи.Колонки.Добавить("КлючСтрокиОрдера", Метаданные.ОпределяемыеТипы.КодСтроки.Тип);
	Для Каждого Строка Из СтрокиСОрдером Цикл
		ЗаполнитьЗначенияСвойств(Ключи.Добавить(), Строка, "Ордер, КлючСтрокиОрдера");
	КонецЦикла;
	Ключи.Свернуть("Ордер, КлючСтрокиОрдера");
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ключи.Ордер КАК Ордер,
	|	Ключи.КлючСтрокиОрдера КАК КлючСтрокиОрдера
	|ПОМЕСТИТЬ ВТКлючи
	|ИЗ
	|	&Ключи КАК Ключи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Записи.МестоХранения КАК МестоХранения,
	|	Записи.Ордер КАК Ордер,
	|	Записи.КлючСтрокиОрдера КАК КлючСтрокиОрдера,
	|	Записи.Номенклатура КАК Номенклатура,
	|	Записи.Характеристика КАК Характеристика,
	|	Записи.Серия КАК Серия,
	|	Записи.Составляющая КАК Составляющая,
	|	СУММА(Записи.Количество) КАК Остаток
	|ПОМЕСТИТЬ ВТДоступно
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.МестоХранения КАК МестоХранения,
	|		Остатки.Ордер КАК Ордер,
	|		Остатки.КлючСтрокиОрдера КАК КлючСтрокиОрдера,
	|		Остатки.Номенклатура КАК Номенклатура,
	|		Остатки.Характеристика КАК Характеристика,
	|		Остатки.Серия КАК Серия,
	|		Остатки.Составляющая КАК Составляющая,
	|		Остатки.КоличествоОстаток КАК Количество
	|	ИЗ
	|		РегистрНакопления.ТоварыКОформлению.Остатки(
	|				,
	|				(Ордер, КлючСтрокиОрдера) В
	|					(ВЫБРАТЬ
	|						ВТКлючи.Ордер КАК Ордер,
	|						ВТКлючи.КлючСтрокиОрдера КАК КлючСтрокиОрдера
	|					ИЗ
	|						ВТКлючи КАК ВТКлючи)) КАК Остатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Прежние.МестоХранения,
	|		Прежние.Ордер,
	|		Прежние.КлючСтрокиОрдера,
	|		Прежние.Номенклатура,
	|		Прежние.Характеристика,
	|		Прежние.Серия,
	|		Прежние.Составляющая,
	|		Прежние.Количество
	|	ИЗ
	|		РегистрНакопления.ТоварыКОформлению КАК Прежние
	|	ГДЕ
	|		Прежние.Регистратор = &Регистратор
	|		И Прежние.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|		И Прежние.Активность
	|		И (Прежние.Ордер, Прежние.КлючСтрокиОрдера) В
	|				(ВЫБРАТЬ
	|					ВТКлючи.Ордер КАК Ордер,
	|					ВТКлючи.КлючСтрокиОрдера КАК КлючСтрокиОрдера
	|				ИЗ
	|					ВТКлючи КАК ВТКлючи)) КАК Записи
	|
	|СГРУППИРОВАТЬ ПО
	|	Записи.МестоХранения,
	|	Записи.Ордер,
	|	Записи.КлючСтрокиОрдера,
	|	Записи.Номенклатура,
	|	Записи.Характеристика,
	|	Записи.Серия,
	|	Записи.Составляющая
	|ИНДЕКСИРОВАТЬ ПО
	|	Ордер,
	|	КлючСтрокиОрдера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Составляющие.МестоХранения КАК МестоХранения,
	|	Составляющие.Ордер КАК Ордер,
	|	Составляющие.КлючСтрокиОрдера КАК КлючСтрокиОрдера,
	|	Составляющие.Номенклатура КАК Комплект,
	|	Составляющие.Характеристика КАК Характеристика,
	|	Составляющие.Серия КАК Серия,
	|	Составляющие.Составляющая КАК Составляющая,
	|	Составляющие.Остаток КАК Остаток,
	|	ЕСТЬNULL(Снимок.КоличествоНаЕдиницу, 0) КАК НаЕдиницу,
	|	ЕСТЬNULL(Коммерческие.Остаток, 0) КАК КоммерческийОстаток
	|ИЗ
	|	ВТДоступно КАК Составляющие
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДоступно КАК Коммерческие
	|		ПО Составляющие.Ордер = Коммерческие.Ордер
	|			И Составляющие.КлючСтрокиОрдера = Коммерческие.КлючСтрокиОрдера
	|			И (Коммерческие.Составляющая = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдер.ТЧФизическийСостав КАК Снимок
	|		ПО Составляющие.Ордер = Снимок.Ссылка
	|			И Составляющие.КлючСтрокиОрдера = Снимок.КодСтроки
	|			И Составляющие.Составляющая = Снимок.Номенклатура
	|ГДЕ
	|	Составляющие.Составляющая <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)");
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Запрос.УстановитьПараметр("Регистратор", ДокОбъект.Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Метод наибольших остатков в целых миллионных: каждой строке - округлённая вниз доля, недостающие единицы - по одной
// строкам с наибольшей дробной частью. Доли не меньше нуля, сумма точно равна распределяемому; строка с нулевой долей
// остаётся в таблице.
//
// Параметры:
//  Составляющие - ТаблицаЗначений - см. НоваяТаблицаСоставляющих; дополняется.
//  СтрокиКлюча  - Массив из СтрокаТабличнойЧасти - строки документа одного ключа строки ордера.
//  Всего        - Число - сумма количеств строк ключа.
//  Комплект     - СправочникСсылка.Номенклатура - комплект строки.
//  Составляющая - СправочникСсылка.Номенклатура - составляющая.
//  Количество   - Число - распределяемое количество составляющей.
//
Процедура РаспределитьПоСтрокам(Составляющие, СтрокиКлюча, Всего, Комплект, Составляющая, Количество)
	Множитель = 1000000; // миллионные - разрядность количества 6
	ЕдиницВсего = Окр(Количество * Множитель, 0);
	Доли = Новый Массив;
	Распределено = 0;
	Для Каждого Строка Из СтрокиКлюча Цикл
		Точно = ?(Всего = 0, 0, ЕдиницВсего * Строка.Количество / Всего);
		Целая = Цел(Точно);
		Доли.Добавить(Новый Структура("Строка, Единиц, Дробь", Строка, Целая, Точно - Целая));
		Распределено = Распределено + Целая;
	КонецЦикла;
	Осталось = ЕдиницВсего - Распределено;
	Пока Осталось > 0 Цикл
		Лучшая = Неопределено;
		Для Каждого Доля Из Доли Цикл
			Если Лучшая = Неопределено Или Доля.Дробь > Лучшая.Дробь Тогда
				Лучшая = Доля;
			КонецЕсли;
		КонецЦикла;
		Лучшая.Единиц = Лучшая.Единиц + 1;
		Лучшая.Дробь = -1;
		Осталось = Осталось - 1;
	КонецЦикла;
	// Нулевая доля тоже строка: по ней ЗаменитьКомплектыПоОрдерам убирает строку комплекта из списания, иначе партии
	// разложили бы комплект заново по текущему составу справочника.
	Для Каждого Доля Из Доли Цикл
		НоваяСтрока = Составляющие.Добавить();
		НоваяСтрока.КодСтроки = Доля.Строка.КодСтроки;
		НоваяСтрока.Комплект = Комплект;
		НоваяСтрока.Номенклатура = Составляющая;
		НоваяСтрока.Количество = Доля.Единиц / Множитель;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
