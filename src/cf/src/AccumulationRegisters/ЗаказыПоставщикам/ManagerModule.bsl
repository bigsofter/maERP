
Процедура СформироватьДвижения(ДокОбъект) Экспорт
	Движения = ДокОбъект.Движения;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ЗаказПоставщикуТЧТовары.Ссылка.Дата КАК Период,
		                      |	ЗаказПоставщикуТЧТовары.Ссылка КАК Ссылка,
		                      |	ЗаказПоставщикуТЧТовары.ЗаказПоставщику КАК ЗаказПоставщику,
		                      |	ЗаказПоставщикуТЧТовары.Номенклатура КАК Номенклатура,
		                      |	ЗаказПоставщикуТЧТовары.Характеристика КАК Характеристика,
		                      |	ЗаказПоставщикуТЧТовары.КодСтроки КАК КодСтроки,
		                      |	ЗаказПоставщикуТЧТовары.Количество КАК Количество,
		                      |	ВЫРАЗИТЬ(ЗаказПоставщикуТЧТовары.СуммаСНДС * &КурсДокумента КАК ЧИСЛО(15, 2)) КАК Сумма
		                      |ПОМЕСТИТЬ ВТ
		                      |ИЗ
		                      |	Документ.ЗаказПоставщику.ТЧТовары КАК ЗаказПоставщикуТЧТовары
		                      |ГДЕ
		                      |	ЗаказПоставщикуТЧТовары.Ссылка = &Док
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ
		                      |	ВТ.Период КАК Период,
		                      |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		                      |	ВТ.Ссылка КАК ЗаказПоставщику,
		                      |	ВТ.Номенклатура КАК Номенклатура,
		                      |	ВТ.Характеристика КАК Характеристика,
		                      |	ВТ.КодСтроки КАК КодСтроки,
		                      |	ВТ.Количество КАК Количество,
		                      |	ВТ.Сумма КАК Сумма
		                      |ИЗ
		                      |	ВТ КАК ВТ
		                      |
		                      |ОБЪЕДИНИТЬ ВСЕ
		                      |
		                      |ВЫБРАТЬ
		                      |	ВТ.Период,
		                      |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
		                      |	ВТ.ЗаказПоставщику,
		                      |	ВТ.Номенклатура,
		                      |	ВТ.Характеристика,
		                      |	ВТ.КодСтроки,
		                      |	ЗаказыПоставщикамОстатки.КоличествоОстаток,
		                      |	ЗаказыПоставщикамОстатки.СуммаОстаток
		                      |ИЗ
		                      |	ВТ КАК ВТ
		                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПоставщикам.Остатки(
		                      |				&ДатаОст,
		                      |				(ЗаказПоставщику, КодСтроки) В
		                      |					(ВЫБРАТЬ
		                      |						ВТЗаказа.ЗаказПоставщику КАК ЗаказПоставщику,
		                      |						ВТЗаказа.КодСтроки КАК КодСтроки
		                      |					ИЗ
		                      |						ВТ КАК ВТЗаказа
		                      |					ГДЕ
		                      |						ВТЗаказа.ЗаказПоставщику <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка))) КАК ЗаказыПоставщикамОстатки
		                      |		ПО ВТ.ЗаказПоставщику = ЗаказыПоставщикамОстатки.ЗаказПоставщику
		                      |			И ВТ.КодСтроки = ЗаказыПоставщикамОстатки.КодСтроки
		                      |ГДЕ
		                      |	ВТ.ЗаказПоставщику <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)");
		Запрос.УстановитьПараметр("Док", ДокОбъект.Ссылка);
		// Заказ в валюте - в регистр в основной валюте по его курсу.
		Запрос.УстановитьПараметр("КурсДокумента", РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс);
		Запрос.УстановитьПараметр("ДатаОст", РаботаСДокументамиВызовСервера.ПолучитьГраницуДокумента(ДокОбъект));
		Движения.ЗаказыПоставщикам.Загрузить(Запрос.Выполнить().Выгрузить());	
	ИначеЕсли ИсполняетЗаказПоставщику(ДокОбъект) Тогда
		ДобавитьРасходИсполнения(ДокОбъект, Движения);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику") Тогда
		ЗаказПоставщику = РаботаСДокументами.ПолучитьДокументРодительПоТипу(Тип("ДокументСсылка.ЗаказПоставщику"), ДокОбъект.Основание);
		Если Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда Возврат КонецЕсли;
		Курс = РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс;
		// Строка заказа у возврата по поступлению, оформившему ордера, - через поступление и ордер.
		Для Каждого Стр Из РегистрыНакопления.ПотребностиПроизводства.СтрокиДокументаЗакупки(ДокОбъект) Цикл
			// Строка без строки заказа (строка ордера без КодСтрокиЗаказа) заказ не исполняла - и не восстанавливает.
			Если Стр.КодСтроки = 0 Тогда
				Продолжить;
			КонецЕсли;
			НС = Движения.ЗаказыПоставщикам.ДобавитьРасход();
			НС.Период = ДокОбъект.Дата;
			НС.ЗаказПоставщику = ЗаказПоставщику;
			НС.Номенклатура = Стр.Номенклатура;
			НС.Характеристика = Стр.Характеристика;
			НС.КодСтроки = Стр.КодСтроки;
			НС.Количество = -Стр.Количество;
			НС.Сумма = -РаботаСВалютамиКлиентСервер.СуммаРегл(Стр.Сумма, Курс);
		КонецЦикла;
	КонецЕсли;		
КонецПроцедуры

// Расход «Заказов поставщикам» строками прихода, который исполняет заказ (см. ИсполняетЗаказПоставщику).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.ПриходныйОрдер - приход.
//  Движения  - КоллекцияДвижений - движения документа.
//
Процедура ДобавитьРасходИсполнения(ДокОбъект, Движения)
	// Регистр - в основной валюте: заказ пишет по своему курсу, поступление - по своему (остаток суммы при
	// разных курсах не обнуляется, регистр читают по количествам).
	// У ордера цен нет: сумма заказа им не закрывается (регистр читают по количествам).
	Курс = ?(ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйОрдер"), 0, РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс);
	ЭтоОрдер = ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйОрдер");
	Для Каждого Стр Из РегистрыНакопления.ПотребностиПроизводства.СтрокиДокументаЗакупки(ДокОбъект) Цикл
		// Строка ордера без строки заказа (добавлена вручную, копия ордера) заказ не исполняет.
		Если ЭтоОрдер И Стр.КодСтроки = 0 Тогда
			Продолжить;
		КонецЕсли;
		НС = Движения.ЗаказыПоставщикам.ДобавитьРасход();
		НС.Период = ДокОбъект.Дата;
		НС.ЗаказПоставщику = ДокОбъект.Основание;
		НС.Номенклатура = Стр.Номенклатура;
		НС.Характеристика = Стр.Характеристика;
		НС.КодСтроки = Стр.КодСтроки;
		НС.Количество = Стр.Количество;
		Если Курс <> 0 Тогда
			НС.Сумма = РаботаСВалютамиКлиентСервер.СуммаРегл(Стр.Сумма, Курс);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Приход по заказу поставщику, который закрывает заказ: поступление или приходный ордер с основанием-заказом, кроме
// перенесённых документов Migration и поступления ордерного склада - его физическое исполнение заказа делает приходный
// ордер (план warehouse-orders, развилка 1).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - проводимый документ.
//
// Возвращаемое значение:
//  Булево - Истина, если документ пишет расход заказа поставщику по строкам.
//
Функция ИсполняетЗаказПоставщику(ДокОбъект)

	ЭтоПриход = ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг")
		Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйОрдер");
	Если Не ЭтоПриход Или ТипЗнч(ДокОбъект.Основание) <> Тип("ДокументСсылка.ЗаказПоставщику")
		Или Не ЗначениеЗаполнено(ДокОбъект.Основание) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ДокОбъект.Контрагент <> Справочники.Контрагенты.Migration
		И Не РегистрыНакопления.ПотребностиПроизводства.ПоступлениеОрдерногоСклада(ДокОбъект);

КонецФункции

// Заказы поставщику, остатки которых двигает документ закупки, - для блокировки проведения
// (УправляемыеБлокировки.ЗаказыПоставщикамДокумента): то же правило, что у СформироватьДвижения, плюс заказы прежних
// движений документа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг,
//              ДокументОбъект.ВозвратПоставщику - документ закупки.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПоставщику - заказы без повторов и пустых ссылок.
//
Функция ЗаказыПоставщикуДокумента(ДокОбъект) Экспорт

	Заказы = Новый Массив;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		ДобавитьЗаказПоставщику(Заказы, ДокОбъект.Ссылка);
		Для Каждого СтрокаТоваров Из ДокОбъект.ТЧТовары Цикл
			ДобавитьЗаказПоставщику(Заказы, СтрокаТоваров.ЗаказПоставщику);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг")
		Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйОрдер") Тогда
		ДобавитьЗаказПоставщику(Заказы, ДокОбъект.Основание);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику") Тогда
		ДобавитьЗаказПоставщику(Заказы,
			РаботаСДокументами.ПолучитьДокументРодительПоТипу(Тип("ДокументСсылка.ЗаказПоставщику"), ДокОбъект.Основание));
	Иначе
		Возврат Заказы;
	КонецЕсли;
	Если ДокОбъект.Ссылка.Пустая() Тогда
		Возврат Заказы;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.ЗаказПоставщику КАК ЗаказПоставщику
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Регистратор");
	Запрос.УстановитьПараметр("Регистратор", ДокОбъект.Ссылка);
	Для Каждого ЗаказДвижений Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЗаказПоставщику") Цикл
		ДобавитьЗаказПоставщику(Заказы, ЗаказДвижений);
	КонецЦикла;
	Возврат Заказы;

КонецФункции

// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказПоставщику - пополняемый список.
//  Заказ  - Произвольный - кандидат: добавляется заполненный заказ поставщику, которого ещё нет в списке.
//
Процедура ДобавитьЗаказПоставщику(Заказы, Заказ)

	Если ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказПоставщику") И ЗначениеЗаполнено(Заказ)
		И Заказы.Найти(Заказ) = Неопределено Тогда
		Заказы.Добавить(Заказ);
	КонецЕсли;

КонецПроцедуры
