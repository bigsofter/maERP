
Процедура СформироватьДвижения(ДокОбъект) Экспорт
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.НалоговаяНакладная")
		Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.НалоговаяНакладнаяПокупка") Тогда
		СформироватьПоНалоговойНакладной(ДокОбъект);
		Возврат;
	КонецЕсли;
	Параметры = ПараметрыДвиженийДокумента(ДокОбъект);
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Движения = ДокОбъект.Движения;
	Период = Параметры.Период;
	МестоХранения = Параметры.МестоХранения;
	ТипДвижения = Параметры.ТипДвижения;
	ТипДенежныхСредств = Параметры.ТипДенежныхСредств;
	ТЗОснования = ДокОбъект.ТЧОснования.Выгрузить();
	ТЗОснования.Свернуть("Основание","Сумма");
	ТЗДляДвижений  = ТЗОснования.Скопировать();
	ТЗДляДвижений.Очистить();
	ТЗДляДвижений.Колонки.Добавить("Накладная");
	Для Каждого Стр из ТЗОснования Цикл
		Накладная = ?(ТипЗнч(Стр.Основание) = Тип("ДокументСсылка.НалоговаяНакладная") или ТипЗнч(Стр.Основание) = Тип("ДокументСсылка.НалоговаяНакладнаяПокупка")  или ТипЗнч(Стр.Основание) = Тип("ДокументСсылка.ПрочиеРасходы"), Стр.Основание, Неопределено);  
		НС = ТЗДляДвижений.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Стр);
		НС.Накладная = Накладная;
	КонецЦикла;
	// Основание сохраняется отдельно от накладной: по нему оплата сопоставляется с документом продажи
	ТЗДляДвижений.Свернуть("Накладная,Основание","Сумма");
	Для Каждого Стр из ТЗДляДвижений Цикл
		Движение(Движения, ДокОбъект, Период, ДокОбъект.Организация, ДокОбъект.СтатьяДДС, МестоХранения, ТипДвижения, ТипДенежныхСредств, Стр.Сумма, ДокОбъект.Ссылка, Стр.Накладная, , Стр.Основание);
	КонецЦикла;
	СуммаОстаток = ДокОбъект.Сумма - ТЗОснования.Итог("Сумма");
	Если Не СуммаОстаток = 0 Тогда 
		Движение(Движения, ДокОбъект, Период, ДокОбъект.Организация, ДокОбъект.СтатьяДДС, МестоХранения, ТипДвижения, ТипДенежныхСредств, СуммаОстаток,ДокОбъект.Ссылка);
	КонецЕсли;
КонецПроцедуры

Функция ПараметрыДвиженийДокумента(ДокОбъект)
	// Тип денежных средств, место хранения, тип движения и период для движений по основаниям денежного документа;
	// движения инкассации, обналичивания чека и перемещения из кассы формируются здесь же.
	// Неопределено - движений по основаниям не нужно (инкассация).
	Движения = ДокОбъект.Движения;
	Параметры = Новый Структура("ТипДенежныхСредств, МестоХранения, ТипДвижения, Период");
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств") Тогда
		Параметры.ТипДенежныхСредств = Справочники.TypesDePayment.VirementBanquaire;
		Параметры.МестоХранения = ДокОбъект.БанковскийСчёт;
		Параметры.ТипДвижения = Перечисления.ТипыДвиженияДенежныхСредств.Поступление;
		Параметры.Период = ?(ЗначениеЗаполнено(ДокОбъект.ДатаПроведенияБанком), ДокОбъект.ДатаПроведенияБанком, ДокОбъект.Дата);
		Если ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.Инкассация Тогда 
			Движение(Движения, ДокОбъект, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.СтатьяДДС, ДокОбъект.Касса,
				Перечисления.ТипыДвиженияДенежныхСредств.Списание, Справочники.TypesDePayment.Cash, ДокОбъект.Сумма, ДокОбъект.Ссылка);
			Возврат Неопределено;
		КонецЕсли;
		Если ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОбналичиваниеЧека Тогда
			// Чек списывается из кассы, сумма приходует банковский счёт по основаниям
			Движение(Движения, ДокОбъект, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.СтатьяДДС, ДокОбъект.Касса,
				Перечисления.ТипыДвиженияДенежныхСредств.Списание, Справочники.TypesDePayment.Cheque, ДокОбъект.Сумма, ДокОбъект.Ссылка);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда
		Параметры.ТипДенежныхСредств = Справочники.TypesDePayment.VirementBanquaire;
		Параметры.МестоХранения = ДокОбъект.БанковскийСчёт;
		Параметры.ТипДвижения = Перечисления.ТипыДвиженияДенежныхСредств.Списание;
		Параметры.Период = ?(ЗначениеЗаполнено(ДокОбъект.ДатаПроведенияБанком), ДокОбъект.ДатаПроведенияБанком, ДокОбъект.Дата);
		Если ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОбналичиваниеЧека Тогда
			// Чек приходуется на банковский счёт, сумма списывается со счёта по основаниям
			Движение(Движения, ДокОбъект, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.СтатьяДДС, Параметры.МестоХранения,
				Перечисления.ТипыДвиженияДенежныхСредств.Поступление, Справочники.TypesDePayment.Cheque, ДокОбъект.Сумма, ДокОбъект.Ссылка);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда
		// ПКО с типом оплаты «Чек» тоже даёт движения: чек лежит в кассе до обналичивания
		Параметры.ТипДенежныхСредств = ДокОбъект.ТипОплаты;
		Параметры.МестоХранения = ДокОбъект.Касса;
		Параметры.ТипДвижения = Перечисления.ТипыДвиженияДенежныхСредств.Поступление;
		Параметры.Период = ДокОбъект.Дата;
		Если ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствИзКассы Тогда 
			Движение(Движения, ДокОбъект, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.СтатьяДДС, ДокОбъект.КассаИз,
				Перечисления.ТипыДвиженияДенежныхСредств.Списание, ДокОбъект.ТипОплаты, ДокОбъект.Сумма, ДокОбъект.Ссылка);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда	
		Параметры.ТипДенежныхСредств = ДокОбъект.ТипОплаты;
		Параметры.МестоХранения = ДокОбъект.Касса;
		Параметры.ТипДвижения = Перечисления.ТипыДвиженияДенежныхСредств.Списание;
		Параметры.Период = ДокОбъект.Дата;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Возврат Параметры;
КонецФункции

Процедура Движение(Движения, ДокОбъект, Период, Организация, СтатьяДДС, МестоХранения, ТипДвижения, ТипДенежныхСредств, Сумма,
	ДокументДвижения, Накладная = Неопределено, ДатаДвижения = Неопределено, ДокументОснование = Неопределено)
	Если Сумма = 0 Тогда Возврат КонецЕсли;
	// Движения денежных средств
	НС = Движения.ДвиженияДенежныхСредств.Добавить();
	НС.Период = Период;
	НС.Организация = Организация;
	НС.МестоХранения = МестоХранения;
	НС.ТипДвижения = ТипДвижения;
	НС.СтатьяДДС = СтатьяДДС;
	НС.ТипДенежныхСредств = ТипДенежныхСредств;
	НС.Сумма = Сумма;
	// Денежные средства организаций
	НС = Движения.ДенежныеСредстваОрганизаций.Добавить();
	НС.ВидДвижения = ?(ТипДвижения = Перечисления.ТипыДвиженияДенежныхСредств.Списание, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
	НС.Период = Период;
	НС.Организация = Организация;
	НС.МестоХранения = МестоХранения;
	НС.ТипДенежныхСредств = ТипДенежныхСредств;
	НС.ДокументДвижения = ДокументДвижения;
	НС.Накладная = Накладная;
	Если ДатаДвижения <> Неопределено Тогда
		НС.ДатаДвижения = ДатаДвижения;
	ИначеЕсли ДокументДвижения <> Неопределено Тогда
		НС.ДатаДвижения = ДокументДвижения.Дата;
	Иначе
		НС.ДатаДвижения = Период;
	КонецЕсли;
	НС.ДокументОснование = ДокументОснование;
	НС.Сумма = Сумма;
КонецПроцедуры

Процедура СформироватьПоНалоговойНакладной(ДокОбъект)
	// Оплаты по налоговой накладной (продажи или покупки) переносятся в денежные средства организации:
	// при ручной корректировке - из ТЧСпособыОплаты, иначе - по оплатам отгрузок/поступлений.
	РучнаяКорректировка = ДокОбъект.РучнаяКорректировка И ДокОбъект.ТЧСпособыОплаты.Количество() <> 0;
	Если РучнаяКорректировка Тогда
		ТЗОплат = ДокОбъект.ТЧСпособыОплаты.Выгрузить();
	Иначе
		ТЗОплат = ПолучитьОплаты(ДокОбъект, Истина);
	КонецЕсли;
	Если ТЗОплат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Контекст = КонтекстОплатНалоговойНакладной(ДокОбъект, ТЗОплат, РучнаяКорректировка);
	Для Каждого СтрОплат Из ТЗОплат Цикл
		Если СтрОплат.ТипДенежныхСредств = Справочники.TypesDePayment.Cheque Тогда
			Продолжить;
		КонецЕсли;
		Если Не РучнаяКорректировка И Контекст.ОсновнойУчет[СтрОплат.Организация] = Истина Тогда
			Продолжить;
		КонецЕсли;
		Данные = ДанныеДвиженияОплаты(СтрОплат, Контекст);
		Движение(ДокОбъект.Движения, ДокОбъект, СтрОплат.Период, ДокОбъект.Организация, Данные.СтатьяДДС, Данные.МестоХранения,
			Данные.ТипДвижения, СтрОплат.ТипДенежныхСредств, СтрОплат.Сумма, Данные.Регистратор, ДокОбъект.Ссылка, СтрОплат.Период);
	КонецЦикла;
КонецПроцедуры

Функция КонтекстОплатНалоговойНакладной(ДокОбъект, ТЗОплат, РучнаяКорректировка)
	// Всё, что нужно циклу по оплатам, запрашивается один раз: касса и счёт организации, статьи ДДС, основной учёт.
	Контекст = Новый Структура;
	Контекст.Вставить("РучнаяКорректировка", РучнаяКорректировка);
	Контекст.Вставить("Ссылка", ДокОбъект.Ссылка);
	Контекст.Вставить("ОсновнаяКасса", Справочники.Кассы.ПолучитьОсновную(ДокОбъект.Организация));
	Контекст.Вставить("ОсновнойСчет", Справочники.БанковскиеСчета.ПолучитьОсновной(ДокОбъект.Организация));
	Если РучнаяКорректировка Тогда
		ЭтоПродажа = (ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.НалоговаяНакладная"));
		ХозОперация = ?(ЭтоПродажа, Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента,
			Перечисления.ХозяйственныеОперации.ОплатаПоставщику);
		Контекст.Вставить("СтатьяДДС", ОбщегоНазначенияВызовСервера.ПолучитьСтатьюДДСПоХозяйственнойОперации(ХозОперация));
		Контекст.Вставить("ТипДвижения", ?(ЭтоПродажа, Перечисления.ТипыДвиженияДенежныхСредств.Поступление,
			Перечисления.ТипыДвиженияДенежныхСредств.Списание));
	Иначе
		Контекст.Вставить("ОсновнойУчет", ОсновнойУчетОрганизаций(ТЗОплат.ВыгрузитьКолонку("Организация")));
		Контекст.Вставить("СтатьиДДС", СтатьиДДСРегистраторов(ТЗОплат.ВыгрузитьКолонку("Регистратор")));
	КонецЕсли;
	Возврат Контекст;
КонецФункции

Функция ДанныеДвиженияОплаты(СтрОплат, Контекст)
	Данные = Новый Структура("МестоХранения, ТипДвижения, Регистратор, СтатьяДДС");
	Если Контекст.РучнаяКорректировка Тогда
		Данные.МестоХранения = ?(СтрОплат.ТипДенежныхСредств = Справочники.TypesDePayment.Cash, Контекст.ОсновнаяКасса, Контекст.ОсновнойСчет);
		Данные.ТипДвижения = Контекст.ТипДвижения;
		Данные.Регистратор = Контекст.Ссылка;
		Данные.СтатьяДДС = Контекст.СтатьяДДС;
	Иначе
		Данные.МестоХранения = ?(СтрОплат.ТипДенежныхСредств = Справочники.TypesDePayment.Cash, Контекст.ОсновнаяКасса, СтрОплат.МестоХранения);
		Данные.ТипДвижения = СтрОплат.ТипДвижения;
		Данные.Регистратор = СтрОплат.Регистратор;
		Данные.СтатьяДДС = Контекст.СтатьиДДС[СтрОплат.Регистратор];
	КонецЕсли;
	Возврат Данные;
КонецФункции

Функция ОсновнойУчетОрганизаций(Организации)
	// Соответствие организация - признак ОсновнойУчет, одним запросом.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка,
	|	Организации.ОсновнойУчет КАК ОсновнойУчет
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка В(&Организации)");
	Запрос.УстановитьПараметр("Организации", Организации);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.ОсновнойУчет);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СтатьиДДСРегистраторов(Регистраторы)
	// Соответствие регистратор оплаты - статья ДДС, одним запросом по четырём видам денежных документов.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.СтатьяДДС КАК СтатьяДДС
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК Док
	|ГДЕ
	|	Док.Ссылка В(&Регистраторы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка,
	|	Док.СтатьяДДС
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК Док
	|ГДЕ
	|	Док.Ссылка В(&Регистраторы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка,
	|	Док.СтатьяДДС
	|ИЗ
	|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК Док
	|ГДЕ
	|	Док.Ссылка В(&Регистраторы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка,
	|	Док.СтатьяДДС
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств КАК Док
	|ГДЕ
	|	Док.Ссылка В(&Регистраторы)");
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.СтатьяДДС);
	КонецЦикла;
	Возврат Результат;
КонецФункции

функция ПолучитьОплаты(ДокОбъект, НаТекДату = Ложь) Экспорт
	Если ТипЗнч(ДокОбъект.Ссылка) = Тип("ДокументСсылка.НалоговаяНакладнаяПокупка") Тогда 
		// IG 
		//МассивНакладных = ДокОбъект.ТЧТовары.Выгрузить().ВыгрузитьКолонку("ОтгрузкаТовара");
		МассивНакладных = ДокОбъект.ТЧТовары.Выгрузить().ВыгрузитьКолонку("ПоступлениеТовара");
	ИначеЕсли ТипЗнч(ДокОбъект.Ссылка) = Тип("ДокументСсылка.ВозвратОтПокупателя") Тогда
		МассивНакладных = Новый Массив;
		МассивНакладных.Добавить(ДокОбъект.Основание);
	ИначеЕсли ТипЗнч(ДокОбъект.Ссылка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		МассивНакладных = Новый Массив;
	иначе
		//МассивНакладных = ДокОбъект.ТЧТовары.Выгрузить().ВыгрузитьКолонку("ПоступлениеТовара");
		МассивНакладных = ДокОбъект.ТЧТовары.Выгрузить().ВыгрузитьКолонку("ОтгрузкаТовара");
	КонецЕсли;
	КолЭлементов = МассивНакладных.ВГраница();
	Для Ном = 0 по КолЭлементов Цикл
		Эл = МассивНакладных.Получить(КолЭлементов-Ном);
		Если Не ЗначениеЗаполнено(Эл) Тогда 
			МассивНакладных.Удалить(КолЭлементов-Ном);
		КонецЕсли;
	КонецЦикла;
	МассивНакладных.Добавить(ДокОбъект.Ссылка);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДвиженияПоКассеОбороты.Период КАК Период,
	|	ДвиженияПоКассеОбороты.Регистратор КАК Регистратор,
	|	ДвиженияПоКассеОбороты.ДокументПродажи КАК ДокументПродажи,
	|	ДвиженияПоКассеОбороты.ТипДвижения КАК ТипДвижения,
	|	ДвиженияПоКассеОбороты.ТипДенежныхСредств КАК ТипДенежныхСредств,
	|	СУММА(ЕСТЬNULL(ДенежныеСредстваОрганизаций.Сумма, ДвиженияПоКассеОбороты.СуммаОборот)) КАК Сумма,
	|	ДвиженияПоКассеОбороты.МестоХранения КАК МестоХранения,
	|	ДвиженияПоКассеОбороты.КассоваяСмена КАК КассоваяСмена,
	|	ДвиженияПоКассеОбороты.Организация КАК Организация
	|ИЗ
	|	РегистрНакопления.ДвиженияПоКассе.Обороты(, , Регистратор, ДокументПродажи В (&МассивНакладных)) КАК ДвиженияПоКассеОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваОрганизаций КАК ДенежныеСредстваОрганизаций
	|		ПО ДвиженияПоКассеОбороты.Регистратор = ДенежныеСредстваОрганизаций.Регистратор
	|			И ДвиженияПоКассеОбороты.ТипДенежныхСредств = ДенежныеСредстваОрганизаций.ТипДенежныхСредств
	|			И ДвиженияПоКассеОбороты.ДокументПродажи = ДенежныеСредстваОрганизаций.ДокументОснование
	|ГДЕ
	|	(ЕСТЬNULL(ДенежныеСредстваОрганизаций.Накладная, ЗНАЧЕНИЕ(Документ.НалоговаяНакладная.ПустаяСсылка)) = НЕОПРЕДЕЛЕНО
	|			ИЛИ ЕСТЬNULL(ДенежныеСредстваОрганизаций.Накладная, ЗНАЧЕНИЕ(Документ.НалоговаяНакладная.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.НалоговаяНакладная.ПустаяСсылка)
	|			ИЛИ ЕСТЬNULL(ДенежныеСредстваОрганизаций.Накладная, ЗНАЧЕНИЕ(Документ.НалоговаяНакладная.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.НалоговаяНакладнаяПокупка.ПустаяСсылка)
	|			ИЛИ НЕ ЕСТЬNULL(ДенежныеСредстваОрганизаций.Накладная, ЗНАЧЕНИЕ(Документ.НалоговаяНакладная.ПустаяСсылка)) = ДенежныеСредстваОрганизаций.Регистратор)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияПоКассеОбороты.Организация,
	|	ДвиженияПоКассеОбороты.КассоваяСмена,
	|	ДвиженияПоКассеОбороты.МестоХранения,
	|	ДвиженияПоКассеОбороты.ТипДенежныхСредств,
	|	ДвиженияПоКассеОбороты.ТипДвижения,
	|	ДвиженияПоКассеОбороты.ДокументПродажи,
	|	ДвиженияПоКассеОбороты.Регистратор,
	|	ДвиженияПоКассеОбороты.Период";
	Запрос.УстановитьПараметр("ДатаДок", ?(НаТекДату,ТекущаяДата(),Новый Граница(ДокОбъект.МоментВремени(), ВидГраницы.Исключая)));
	Запрос.УстановитьПараметр("МассивНакладных", МассивНакладных);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ЕстьДвижение(Эл,Ссылка)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДенежныеСредстваОрганизаций.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваОрганизаций КАК ДенежныеСредстваОрганизаций
	|ГДЕ
	|	ДенежныеСредстваОрганизаций.ДокументДвижения = &ДокументДвижения
	|	И ДенежныеСредстваОрганизаций.Накладная = &Накладная";
	Запрос.УстановитьПараметр("ДокументДвижения",Ссылка);
	Запрос.УстановитьПараметр("Накладная",Эл);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции
