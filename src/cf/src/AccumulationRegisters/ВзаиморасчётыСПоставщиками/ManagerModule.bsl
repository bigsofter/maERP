
#Область Формирование_движений

Процедура СформироватьДвижения(ДокОбъект) Экспорт	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеИзПереработки") Тогда
		// У документа нет хозяйственной операции - долг перед переработчиком формируется
		// на стоимость его услуг с НДС (волна 12, услуга капитализируется в себестоимость).
		СформироватьПоУслугамПереработчика(ДокОбъект);
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.НалоговаяНакладнаяПокупка") Тогда
		// Проверяется до отбора по хозяйственной операции: у накладной с незаполненной операцией
		// сторно молча не выполнилось бы, а долг в налоговом регистре остался - расчеты разъехались бы.
		СформироватьПоНалоговойНакладнойПокупки(ДокОбъект);
		Возврат;
	КонецЕсли;
	Если Не ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПоставщиками(ДокОбъект.ХозяйственнаяОперация) Тогда Возврат КонецЕсли;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда 
		Если ДокОбъект.Контрагент = Справочники.Контрагенты.Migration тогда Возврат; КонецЕсли;
		// Суммы регистра - в основной валюте, зачёт авансов - тоже (аванс - оплата в основной валюте).
		СуммаДокумента = СуммаВОсновнойВалюте(ДокОбъект, ДокОбъект.Сумма);
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧЗачётАвансов, Ложь, Ложь, Истина, СуммаДокумента);
		СформироватьПоДопРасходам(ДокОбъект);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику") Тогда
		ТЗАвансы = Новый ТаблицаЗначений;
		ТЗАвансы.Колонки.Добавить("Основание");
		ТЗАвансы.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
		НС = ТЗАвансы.Добавить();
		НС.Основание = НакладнаяПокупкиПокрывающаяОснование(?(ЗначениеЗаполнено(ДокОбъект.Основание), ДокОбъект.Основание, ДокОбъект.Ссылка));
		СуммаДокумента = СуммаВОсновнойВалюте(ДокОбъект, ДокОбъект.Сумма);
		НС.Сумма = СуммаДокумента;
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ТЗАвансы, Ложь, Истина, Ложь, СуммаДокумента);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеДополнительныхРасходов") Тогда 		
		СуммаРаспределения = ДокОбъект.Сумма + ДокОбъект.ТЧТовары.Итог("Сумма");
		Если Не ДокОбъект.ЦенаВключаетНДС Тогда
			СуммаРаспределения = СуммаРаспределения + ДокОбъект.СуммаНДС + ДокОбъект.ТЧТовары.Итог("СуммаНДС");	
		КонецЕсли;	
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧЗачётАвансов, Ложь, Ложь, Истина, СуммаРаспределения);	
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств") Тогда			
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Истина, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда			
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Ложь, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Истина, Ложь, ДокОбъект.Сумма);		
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда	
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Ложь, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаДолга") Тогда
		Движения = ДокОбъект.Движения;
		//Мас = ДокОбъект.ДополнительныеСвойства.ТЗКредиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПоставщиком", Истина));
		//Для Каждого Стр Из Мас Цикл
		//	ОбъектРасчётов = ?(ТипЗнч(Стр.ОбъектРасчётов) = Тип("СправочникСсылка.ДоговорыСКонтрагентами"), ДокОбъект.Ссылка, Стр.ОбъектРасчётов);
		//	Движение(Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.КонтрагентКредитор, Стр.Договор, ОбъектРасчётов, ВалютаРегламентированногоУчета, Стр.Сумма, Ложь); 
		//КонецЦикла;
		//Мас = ДокОбъект.ДополнительныеСвойства.ТЗДебиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПоставщиком", Истина));
		Для Каждого Стр Из ДокОбъект.ДополнительныеСвойства.ТЗДебиторскаяЗадолженность Цикл
			ОбъектРасчётов = Стр.ОбъектРасчётов;
			Движение(Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.КонтрагентДебитор, , ОбъектРасчётов, Стр.Сумма, Истина);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ТЗДопРасходы = ДокОбъект.ТЧДополнительныеРасходы.Выгрузить();
		ТЗДопРасходы.Свернуть("Контрагент,Договор","Сумма"); 
		Для Каждого Стр из ТЗДопРасходы Цикл 
			Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, Стр.Контрагент, Стр.Договор, ДокОбъект.Ссылка, Стр.Сумма, Ложь);	
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СертификатНаОплату") Тогда
		Если ЗначениеЗаполнено(ДокОбъект.Поступление) Тогда 
			Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Поступление.Контрагент, ДокОбъект.Поступление.Договор, НакладнаяПокупкиПокрывающаяОснование(ДокОбъект.Поступление.Ссылка), ДокОбъект.Сумма, Истина);	
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщикуНалоговый") Тогда
		Сумма = 0;
		Для Каждого Стр из ДокОбъект.ТЧТовары Цикл 
			Если Не ЗначениеЗаполнено(Стр.ПоступлениеТовара) Тогда 
				Сумма = Сумма + Стр.СуммаСНДС;
			КонецЕсли;
		КонецЦикла;
		Если Не Сумма = 0 Тогда 
			Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор,
				ДокОбъект.Ссылка, СуммаВОсновнойВалюте(ДокОбъект, Сумма), Истина, Сумма);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура СформироватьПоПлатёжномуДокументу(ДокОбъект, ТЧАвансы, Приход, Сторно, ЭтоДокументРасчётов, СуммаРаспределения)
	ЭтоОплата = РаботаСВалютами.ЭтоПлатежныйДокумент(ДокОбъект);
	ДатаПроведения = ДокОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаПроведения) Тогда Возврат КонецЕсли;
	СуммаОстаток = СуммаРаспределения;
	Движения = ДокОбъект.Движения;
	Для Каждого Стр Из ТЧАвансы Цикл
		Если ЭтоДокументРасчётов Тогда
			// Сторнируем аванс
			Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, Стр.Основание, ?(Сторно, Стр.Сумма, -Стр.Сумма), Не Приход);
			// Делаем задолженность по документу
			Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, ?(Сторно, -Стр.Сумма, Стр.Сумма), Приход); 
			// Оплачиваем его
			Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, ?(Сторно, -Стр.Сумма, Стр.Сумма), Не Приход);	
		Иначе
			// Накладная покупки несет долг и в обычном регистре, поэтому оплата, выписанная прямо
			// на нее, тоже должна его гасить. До переезда расчетов долг накладной жил только
			// в налоговом регистре, и такие оплаты сюда не писались.
			Если ЭтоОплата Тогда
				// Сумма строки - в валюте платежа: долг закрывается по курсу объекта, разница - курсовая.
				Оплата = РаботаСВалютами.СтрокаОплатыВРасчеты(ДокОбъект, Стр.Сумма, Стр.Основание, "ВзаиморасчётыСПоставщиками", Сторно);
				Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор,
					Стр.Основание, Оплата.Сумма, Приход,
					Оплата.СуммаВВалюте);
			Иначе
				Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, Стр.Основание, ?(Сторно, -Стр.Сумма, Стр.Сумма), Приход);
			КонецЕсли;
		КонецЕсли;
		СуммаОстаток = СуммаОстаток - Стр.Сумма;
	КонецЦикла;
	СуммаАванса = Неопределено;
	Если ЭтоОплата Тогда
		// Аванс - в основной валюте разностью сумм (копейки округления строк остаются в нём), в валюте - как есть.
		СуммаАванса = ?(Сторно, -СуммаОстаток, СуммаОстаток);
		СуммаОстаток = РаботаСВалютами.АвансПлатежаВОсновнойВалюте(ДокОбъект);
	КонецЕсли;
	Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор,
		ДокОбъект.Ссылка, ?(Сторно, -СуммаОстаток, СуммаОстаток), Приход,
		СуммаАванса);
КонецПроцедуры

// Переносит расчеты с поступлений-оснований на налоговую накладную покупки: долг каждого
// поступления и его оплаты сторнируются, а накладная принимает их на себя.
//
// Знаки обратны продаже: наш долг поставщику в регистре - расход (отрицательный остаток),
// см. комментарий в СформироватьПоУслугамПереработчика. Организация, договор и валюта берутся
// с поступления - именно с ними долг был записан, иначе сторно его не погасит.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладнаяПокупка - проводимая накладная.
//
Процедура СформироватьПоНалоговойНакладнойПокупки(ДокОбъект)
	ДатаНакладной = ДокОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаНакладной) Тогда
		Возврат;
	КонецЕсли;
	ТЗПоступления = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект, "ПоступлениеТовара");
	Если ТЗПоступления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	РеквизитыПоступлений = ДанныеПоступлений(ТЗПоступления.ВыгрузитьКолонку("Основание"));
	// Покрытые суммы - в валюте поступления; регистр ведётся в основной валюте, а долг поступления записан
	// по его курсу - по нему и сторнируется, иначе разница курсов оставила бы вечный остаток.
	Для Каждого Стр Из ТЗПоступления Цикл
		Реквизиты = РеквизитыПоступлений.Получить(Стр.Основание);
		Если Реквизиты <> Неопределено Тогда
			Стр.Сумма = РаботаСВалютамиКлиентСервер.СуммаРегл(Стр.Сумма, Реквизиты.Курс);
		КонецЕсли;
	КонецЦикла;
	ДолгПоПоступлениям(ДокОбъект, ТЗПоступления, РеквизитыПоступлений, ДатаНакладной);
	ОплатыПоПоступлениям(ДокОбъект, ТЗПоступления, РеквизитыПоступлений);
КонецПроцедуры

// Сторнирует долг поступлений и заводит его на накладную покупки.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладнаяПокупка - проводимая накладная.
//  ТЗПоступления - ТаблицаЗначений - покрытые поступления, колонки Основание и Сумма.
//  РеквизитыПоступлений - Соответствие - реквизиты поступлений.
//  ДатаНакладной - Дата - период движений долга.
//
Процедура ДолгПоПоступлениям(ДокОбъект, ТЗПоступления, РеквизитыПоступлений, ДатаНакладной)
	Движения = ДокОбъект.Движения;
	Для Каждого Стр Из ТЗПоступления Цикл
		Реквизиты = РеквизитыПоступлений.Получить(Стр.Основание);
		Если Реквизиты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Движение(Движения, ДатаНакладной, Реквизиты.Организация, ДокОбъект.Контрагент,
			Реквизиты.Договор, Стр.Основание, -Стр.Сумма, Ложь);
		Движение(Движения, ДатаНакладной, Реквизиты.Организация, ДокОбъект.Контрагент,
			Реквизиты.Договор, ДокОбъект.Ссылка, Стр.Сумма, Ложь);
	КонецЦикла;
КонецПроцедуры

// Сторнирует оплаты поступлений и заводит их на накладную покупки.
// Период движения - дата платежа, а не накладной: см. одноименную процедуру регистра покупателей.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладнаяПокупка - проводимая накладная.
//  ТЗПоступления - ТаблицаЗначений - покрытые поступления, колонки Основание и Сумма.
//  РеквизитыПоступлений - Соответствие - реквизиты поступлений.
//
Процедура ОплатыПоПоступлениям(ДокОбъект, ТЗПоступления, РеквизитыПоступлений)
	Движения = ДокОбъект.Движения;
	ТЗОплат = РегистрыНакопления.ДенежныеСредстваОрганизаций.ПолучитьОплаты(ДокОбъект, Истина);
	Для Каждого СтрОплат Из ТЗОплат Цикл
		// Оплата, выписанная прямо на накладную, уже записана в обычный регистр на саму накладную.
		Если СтрОплат.ДокументПродажи = ДокОбъект.Ссылка Тогда
			Продолжить;
		КонецЕсли;
		Реквизиты = РеквизитыПоступлений.Получить(СтрОплат.ДокументПродажи);
		СтрокаПокрытия = ТЗПоступления.Найти(СтрОплат.ДокументПродажи, "Основание");
		Если Реквизиты = Неопределено Или СтрокаПокрытия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СуммаСторно = РаботаСДокументами.СуммаВДолеПокрытия(СтрОплат.Сумма, СтрокаПокрытия.Сумма,
			Реквизиты.СуммаДокумента);
		// Оплата поставщику (списание) записана приходом регистра, возврат от него - приходом со знаком минус.
		ЭтоПоступление = СтрОплат.ТипДвижения = Перечисления.ТипыДвиженияДенежныхСредств.Поступление;
		Знак = ?(ЭтоПоступление, -1, 1);
		Движение(Движения, СтрОплат.Период, Реквизиты.Организация, ДокОбъект.Контрагент,
			Реквизиты.Договор, СтрОплат.ДокументПродажи, -Знак * СуммаСторно, Истина);
		Движение(Движения, СтрОплат.Период, Реквизиты.Организация, ДокОбъект.Контрагент,
			Реквизиты.Договор, ДокОбъект.Ссылка, Знак * СуммаСторно, Истина);
	КонецЦикла;
КонецПроцедуры

// Возвращает объект расчетов с учетом переезда: если поступление покрыто проведенной налоговой
// накладной покупки, расчеты по нему ведутся по накладной, и документ, введенный после накладной,
// обязан попасть на тот же объект. Подробности - в одноименной функции регистра покупателей.
//
// Параметры:
//  Основание - ДокументСсылка - поступление или иной объект расчетов.
//
// Возвращаемое значение:
//  ДокументСсылка - налоговая накладная покупки, покрывающая поступление, либо само основание.
//
Функция НакладнаяПокупкиПокрывающаяОснование(Основание)
	Если ТипЗнч(Основание) <> Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Или Не ЗначениеЗаполнено(Основание) Тогда
		Возврат Основание;
	КонецЕсли;
	МассивОснований = Новый Массив;
	МассивОснований.Добавить(Основание);
	Накладные = РаботаСДокументами.НалоговыеНакладныеПоОснованиям(МассивОснований);
	Возврат ?(Накладные.Количество() = 0, Основание, Накладные[0]);
КонецФункции

// Возвращает реквизиты поступлений одним запросом.
//
// Параметры:
//  МассивПоступлений - Массив - ссылки на ПоступлениеТоваровУслуг.
//
// Возвращаемое значение:
//  Соответствие - ключ ДокументСсылка.ПоступлениеТоваровУслуг, значение - структура
//                 с полями Организация, Договор, Курс (курс поступления, для основной валюты 1),
//                 СуммаДокумента (в основной валюте).
//
Функция ДанныеПоступлений(МассивПоступлений)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Поступление.Ссылка КАК Основание,
	                      |	Поступление.Организация КАК Организация,
	                      |	Поступление.Договор КАК Договор,
	                      |	Поступление.Валюта КАК Валюта,
	                      |	Поступление.КурсВалюты КАК КурсВалюты,
	                      |	Поступление.ВВалюте КАК ВВалюте,
	                      |	Поступление.Сумма КАК СуммаДокумента
	                      |ИЗ
	                      |	Документ.ПоступлениеТоваровУслуг КАК Поступление
	                      |ГДЕ
	                      |	Поступление.Ссылка В (&МассивПоступлений)");
	Запрос.УстановитьПараметр("МассивПоступлений", МассивПоступлений);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Реквизиты = Новый Структура("Организация, Договор, Курс, СуммаДокумента");
		ЗаполнитьЗначенияСвойств(Реквизиты, Выборка);
		Реквизиты.Курс = РаботаСВалютами.ВалютаИКурсДокумента(Выборка).Курс;
		Реквизиты.СуммаДокумента = РаботаСВалютамиКлиентСервер.СуммаРегл(Выборка.СуммаДокумента, Реквизиты.Курс);
		Результат.Вставить(Выборка.Основание, Реквизиты);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура СформироватьПоУслугамПереработчика(ДокОбъект)
	// Договор с переработчиком не ведётся - объект расчётов сам документ поступления.
	// Наш долг в регистре - расход (отрицательный остаток), как у поступления товаров:
	// так его читает ПолучитьЗадолженностьПоставшиковПоКлассификации и так его гасит
	// оплата поставщику приходом. Приходом долг записывался до 2.0.14.15 - оплата его удваивала.
	Сумма = ДокОбъект.СтоимостьУслуг + ДокОбъект.СуммаНДСУслуг;
	Если Сумма = 0 Тогда
		Возврат;
	КонецЕсли;
	Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Контрагент,
		Справочники.ДоговорыСКонтрагентами.ПустаяСсылка(), ДокОбъект.Ссылка, Сумма, Ложь);
КонецПроцедуры

// Запись регистра. Сумма - в основной валюте; валюта записи и сумма в ней - по объекту расчётов
// (см. РаботаСВалютами.ВалютаИКурсОбъекта): любой документ, пишущий по валютному объекту, - оплата,
// корректировка, сертификат, налоговая накладная, - попадает в ту же валюту, и остаток не дробится.
//
// Параметры:
//  Движения - КоллекцияДвижений - движения документа.
//  ДатаДвижения - Дата - период записи.
//  Организация - СправочникСсылка.Организации - измерение записи.
//  Контрагент - СправочникСсылка.Контрагенты - измерение записи.
//  Договор - СправочникСсылка.ДоговорыСКонтрагентами - измерение записи.
//  ОбъектРасчётов - ДокументСсылка - измерение записи, по нему определяется валюта.
//  Сумма - Число - сумма в основной валюте.
//  Приход - Булево - вид движения.
//  СуммаВВалюте - Число, Неопределено - точная сумма в валюте объекта (движение на сам документ);
//                 Неопределено - пересчёт суммы по курсу объекта.
//
Процедура Движение(Движения, ДатаДвижения, Организация, Контрагент, Договор, ОбъектРасчётов, Сумма, Приход = Истина,
	СуммаВВалюте = Неопределено)
	Если Сумма = 0 Тогда Возврат КонецЕсли;
	ВалютаОбъекта = РаботаСВалютами.ВалютаОбъектаРасчетов(ОбъектРасчётов);
	НС = Движения.ВзаиморасчётыСПоставщиками.Добавить();
	НС.ВидДвижения = ?(Приход, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
	НС.Период = ДатаДвижения;
	НС.Организация = Организация;
	НС.Контрагент = Контрагент;
	НС.Договор = Договор;
	НС.ОбъектРасчётов = ОбъектРасчётов;
	НС.Валюта = ВалютаОбъекта.Валюта;
	НС.Сумма = Сумма;
	// Сумма в валюте ведётся только по валютным объектам, как в записях до валютного учёта.
	Если Не ВалютаОбъекта.ВВалюте Тогда
		Возврат;
	ИначеЕсли СуммаВВалюте = Неопределено Тогда
		НС.СуммаВВалюте = РаботаСВалютамиКлиентСервер.СуммаВВалюте(Сумма, ВалютаОбъекта.Курс);
	Иначе
		НС.СуммаВВалюте = СуммаВВалюте;
	КонецЕсли;
КонецПроцедуры

// Сумма документа в основной валюте по курсу документа (см. РаботаСВалютами.ВалютаИКурсДокумента).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ с валютой или без неё.
//  Сумма - Число - сумма в валюте документа.
//
// Возвращаемое значение:
//  Число - сумма в основной валюте.
//
Функция СуммаВОсновнойВалюте(ДокОбъект, Сумма)
	Возврат РаботаСВалютамиКлиентСервер.СуммаРегл(Сумма, РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс);
КонецФункции

// Долг перед поставщиками дополнительных расходов документа. Доп. расходы поступления - в валюте документа,
// реализации - в основной валюте.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.РеализацияТоваровУслуг - документ.
//
Процедура СформироватьПоДопРасходам(ДокОбъект) Экспорт
	ТЗДопРасходы = ДокОбъект.ТЧДополнительныеРасходы.Выгрузить();
	ТЗДопРасходы.Свернуть("Контрагент,Договор","СуммаСНДС");
	ЭтоПоступление = ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг");
	Для Каждого Стр из ТЗДопРасходы Цикл
		Сумма = ?(ЭтоПоступление, СуммаВОсновнойВалюте(ДокОбъект, Стр.СуммаСНДС), Стр.СуммаСНДС);
		Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, Стр.Контрагент, Стр.Договор, ДокОбъект.Ссылка, Сумма, Ложь);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти	

#Область Остатки

// Просроченные долги поставщикам по поступлениям и налоговым накладным покупки на дату: срок оплаты договора
// истёк (с учётом банковских дней), долг сверх суммы кредита договора. Источник отчёта «Просроченные долги
// поставщиков».
//
// Параметры:
//  Период - Дата - дата, на которую считается просрочка
//  Отбор  - Структура - необязательные Организации, Контрагенты, Договоры, Менеджеры (списки; пустой - без отбора)
//
// Возвращаемое значение:
//  ТаблицаЗначений - ГруппировкаВсего, Организация, Контрагент, Договор, ПоступлениеТоваровУслуг, Долг, ДатаОтгрузки,
//                    КоличествоВыходных, ПросроченоДней
//
Функция ПолучитьЗадолженностьПоставшиковПоКлассификации(Период, Отбор) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	// Заполним реквизиты
	Организации = ?(Отбор.Свойство("Организации"), Отбор.Организации, Новый Массив);
	Контрагенты = ?(Отбор.Свойство("Контрагенты"), Отбор.Контрагенты, Новый Массив);	
	Договоры = ?(Отбор.Свойство("Договоры"), Отбор.Договоры, Новый Массив);
	Менеджеры = ?(Отбор.Свойство("Менеджеры"), Отбор.Менеджеры, Новый Массив);
	// Получим данные из базы
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВсК.Организация КАК Организация,
	                      |	ВсК.Контрагент КАК Контрагент,
	                      |	ВсК.Договор КАК Договор,
	                      |	ВсК.ОбъектРасчётов КАК ПоступлениеТоваровУслуг,
	                      |	-ВсК.СуммаОстаток КАК Долг,
	                      |	НАЧАЛОПЕРИОДА(ВсК.ОбъектРасчётов.Дата, ДЕНЬ) КАК ДатаОтгрузки,
	                      |	ВсК.Договор.СрокОплаты КАК СрокОплаты,
	                      |	ВсК.Договор.СуммаКредита КАК СуммаКредита,
	                      |	ВсК.Договор.СпособРасчётаОтсрочки = ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.БанковскиеДни) КАК ПоБанковскимДням
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПоставщиками.Остатки(
	                      |			&Период,
	                      |			(ОбъектРасчётов ССЫЛКА Документ.ПоступлениеТоваровУслуг
	                      |				ИЛИ ОбъектРасчётов ССЫЛКА Документ.НалоговаяНакладнаяПокупка)
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьОрганизации
	                      |						ТОГДА Договор.Организация В (&Организации)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьКонтрагенты
	                      |						ТОГДА Контрагент В ИЕРАРХИИ (&Контрагенты)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьДоговоры
	                      |						ТОГДА Договор В (&Договоры)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ) КАК ВсК
	                      |ГДЕ
	                      |	ВсК.СуммаОстаток < 0
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг,
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПроизводственныйКалендарь.Дата) КАК КоличествоВыходных
	                      |ПОМЕСТИТЬ ВТВыходные
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь
	                      |		ПО (ПроизводственныйКалендарь.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, 1) И &Период)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТ.ПоступлениеТоваровУслуг
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	""Состояние взаиморасчетов"" КАК ГруппировкаВсего,
	                      |	ВЗ.Организация КАК Организация,
	                      |	ВЗ.Контрагент КАК Контрагент,
	                      |	ВЗ.Договор КАК Договор,
	                      |	ВЗ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг,
	                      |	ВЗ.Долг КАК Долг,
	                      |	ВЗ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |	ВЗ.КоличествоВыходных КАК КоличествоВыходных,
	                      |	ВЗ.ПросроченоДней КАК ПросроченоДней
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТ.Организация КАК Организация,
	                      |		ВТ.Контрагент КАК Контрагент,
	                      |		ВТ.Договор КАК Договор,
	                      |		ВТ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг,
	                      |		ВЫБОР
	                      |			КОГДА ВТ.Долг - ВТ.СуммаКредита < 0
	                      |				ТОГДА 0
	                      |			ИНАЧЕ ВТ.Долг - ВТ.СуммаКредита
	                      |		КОНЕЦ КАК Долг,
	                      |		ВТ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |		ВТВыходные.КоличествоВыходных КАК КоличествоВыходных,
	                      |		РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, ВТ.СрокОплаты + ВЫБОР
	                      |					КОГДА ВТ.ПоБанковскимДням
	                      |						ТОГДА ЕСТЬNULL(ВТВыходные.КоличествоВыходных, 0)
	                      |					ИНАЧЕ 0
	                      |				КОНЕЦ), &Период, ДЕНЬ) КАК ПросроченоДней
	                      |	ИЗ
	                      |		ВТ КАК ВТ
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ ВТВыходные КАК ВТВыходные
	                      |			ПО ВТ.ПоступлениеТоваровУслуг = ВТВыходные.ПоступлениеТоваровУслуг) КАК ВЗ
	                      |ГДЕ
	                      |	ВЗ.Долг > 0
	                      |	И ВЗ.ПросроченоДней > 0");
	Запрос.УстановитьПараметр("Период", КонецДня(Период));
	Запрос.УстановитьПараметр("ЕстьОрганизации", Организации.Количество() <> 0);
	Запрос.УстановитьПараметр("Организации", Организации);
	Запрос.УстановитьПараметр("ЕстьКонтрагенты", Контрагенты.Количество() <> 0);
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("ЕстьДоговоры", Договоры.Количество() <> 0);
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти 
