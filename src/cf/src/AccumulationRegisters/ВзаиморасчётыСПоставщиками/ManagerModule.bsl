
#Область Формирование_движений

Процедура СформироватьДвижения(ДокОбъект) Экспорт	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеИзПереработки") Тогда
		// У документа нет хозяйственной операции - долг перед переработчиком формируется
		// на стоимость его услуг с НДС (волна 12, услуга капитализируется в себестоимость).
		СформироватьПоУслугамПереработчика(ДокОбъект);
		Возврат;
	КонецЕсли;
	Если Не ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПоставщиками(ДокОбъект.ХозяйственнаяОперация) Тогда Возврат КонецЕсли;
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда 
		Если ДокОбъект.Контрагент = Справочники.Контрагенты.Migration тогда Возврат; КонецЕсли;
		СуммаДокумента = ДокОбъект.Сумма;
		Валюта = ?(ЗначениеЗаполнено(ДокОбъект.Валюта), ДокОбъект.Валюта, ВалютаРегламентированногоУчета);
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧЗачётАвансов, Ложь, Ложь, Истина, Валюта, СуммаДокумента);
		СформироватьПоДопРасходам(ДокОбъект, Валюта);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику") Тогда
		ТЗАвансы = Новый ТаблицаЗначений;
		ТЗАвансы.Колонки.Добавить("Основание");
		ТЗАвансы.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
		НС = ТЗАвансы.Добавить();
		НС.Основание = ?(ЗначениеЗаполнено(ДокОбъект.Основание), ДокОбъект.Основание, ДокОбъект.Ссылка);
		Валюта = ?(ЗначениеЗаполнено(ДокОбъект.Валюта), ДокОбъект.Валюта, ВалютаРегламентированногоУчета);
		НС.Сумма = ДокОбъект.Сумма;
		СуммаДокумента = ДокОбъект.Сумма;
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ТЗАвансы, Ложь, Истина, Ложь, Валюта, СуммаДокумента);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеДополнительныхРасходов") Тогда 		
		СуммаРаспределения = ДокОбъект.Сумма + ДокОбъект.ТЧТовары.Итог("Сумма");
		Если Не ДокОбъект.ЦенаВключаетНДС Тогда
			СуммаРаспределения = СуммаРаспределения + ДокОбъект.СуммаНДС + ДокОбъект.ТЧТовары.Итог("СуммаНДС");	
		КонецЕсли;	
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧЗачётАвансов, Ложь, Ложь, Истина, ВалютаРегламентированногоУчета, СуммаРаспределения);	
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств") Тогда			
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Истина, Ложь, ВалютаРегламентированногоУчета, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда			
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Ложь, Ложь, ВалютаРегламентированногоУчета, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Истина, Ложь, ВалютаРегламентированногоУчета, ДокОбъект.Сумма);		
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда	
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Ложь, Ложь, ВалютаРегламентированногоУчета, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаДолга") Тогда
		Движения = ДокОбъект.Движения;
		//Мас = ДокОбъект.ДополнительныеСвойства.ТЗКредиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПоставщиком", Истина));
		//Для Каждого Стр Из Мас Цикл
		//	ОбъектРасчётов = ?(ТипЗнч(Стр.ОбъектРасчётов) = Тип("СправочникСсылка.ДоговорыСКонтрагентами"), ДокОбъект.Ссылка, Стр.ОбъектРасчётов);
		//	Движение(Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.КонтрагентКредитор, Стр.Договор, ОбъектРасчётов, ВалютаРегламентированногоУчета, Стр.Сумма, Ложь); 
		//КонецЦикла;
		//Мас = ДокОбъект.ДополнительныеСвойства.ТЗДебиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПоставщиком", Истина));
		Для Каждого Стр Из ДокОбъект.ДополнительныеСвойства.ТЗДебиторскаяЗадолженность Цикл
			ОбъектРасчётов = Стр.ОбъектРасчётов;
			Движение(Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.КонтрагентДебитор, , ОбъектРасчётов, ВалютаРегламентированногоУчета, Стр.Сумма, Истина);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ТЗДопРасходы = ДокОбъект.ТЧДополнительныеРасходы.Выгрузить();
		ТЗДопРасходы.Свернуть("Контрагент,Договор","Сумма"); 
		Для Каждого Стр из ТЗДопРасходы Цикл 
			Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, Стр.Контрагент, Стр.Договор, ДокОбъект.Ссылка, ВалютаРегламентированногоУчета, Стр.Сумма, Ложь);	
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СертификатНаОплату") Тогда
		Если ЗначениеЗаполнено(ДокОбъект.Поступление) Тогда 
			Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Поступление.Контрагент, ДокОбъект.Поступление.Договор, ДокОбъект.Поступление.Ссылка, ВалютаРегламентированногоУчета, ДокОбъект.Сумма, Истина);	
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщикуНалоговый") Тогда
		Сумма = 0;
		Валюта = ?(ЗначениеЗаполнено(ДокОбъект.Валюта), ДокОбъект.Валюта, ВалютаРегламентированногоУчета);
		Для Каждого Стр из ДокОбъект.ТЧТовары Цикл 
			Если Не ЗначениеЗаполнено(Стр.ПоступлениеТовара) Тогда 
				Сумма = Сумма + Стр.СуммаСНДС;
			КонецЕсли;
		КонецЦикла;
		Если Не Сумма = 0 Тогда 
			Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, Валюта, Сумма, Истина);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура СформироватьПоПлатёжномуДокументу(ДокОбъект, ТЧАвансы, Приход, Сторно, ЭтоДокументРасчётов, Валюта, СуммаРаспределения) 
	ДатаПроведения = ДокОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаПроведения) Тогда Возврат КонецЕсли;
	СуммаОстаток = СуммаРаспределения;
	Движения = ДокОбъект.Движения;
	Для Каждого Стр Из ТЧАвансы Цикл
		Если ЭтоДокументРасчётов Тогда
			// Сторнируем аванс
			Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, Стр.Основание, Валюта, ?(Сторно, Стр.Сумма, -Стр.Сумма), Не Приход);
			// Делаем задолженность по документу
			Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, Валюта, ?(Сторно, -Стр.Сумма, Стр.Сумма), Приход); 
			// Оплачиваем его
			Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, Валюта, ?(Сторно, -Стр.Сумма, Стр.Сумма), Не Приход);	
		Иначе
			// Долг по налоговой накладной покупки закрывается в ВзаиморасчётыСПоcтавщикамиНалоговый
			Если ТипЗнч(Стр.Основание) <> Тип("ДокументСсылка.НалоговаяНакладнаяПокупка") Тогда
				Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, Стр.Основание, Валюта, ?(Сторно, -Стр.Сумма, Стр.Сумма), Приход);
			КонецЕсли;
		КонецЕсли;		  
		СуммаОстаток = СуммаОстаток - Стр.Сумма;
	КонецЦикла;
	Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, Валюта, ?(Сторно, -СуммаОстаток, СуммаОстаток), Приход);
КонецПроцедуры

Процедура СформироватьПоУслугамПереработчика(ДокОбъект)
	// Договор с переработчиком не ведётся - объект расчётов сам документ поступления.
	Сумма = ДокОбъект.СтоимостьУслуг + ДокОбъект.СуммаНДСУслуг;
	Если Сумма = 0 Тогда
		Возврат;
	КонецЕсли;
	Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Контрагент,
		Справочники.ДоговорыСКонтрагентами.ПустаяСсылка(), ДокОбъект.Ссылка,
		Константы.ВалютаРегламентированногоУчета.Получить(), Сумма);
КонецПроцедуры

Процедура Движение(Движения, ДатаДвижения, Организация, Контрагент, Договор, ОбъектРасчётов, Валюта, Сумма, Приход = Истина)
	Если Сумма = 0 Тогда Возврат КонецЕсли;
	НС = Движения.ВзаиморасчётыСПоставщиками.Добавить();
	НС.ВидДвижения = ?(Приход, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
	НС.Период = ДатаДвижения;
	НС.Организация = Организация;
	НС.Контрагент = Контрагент;
	НС.Договор = Договор;
	НС.ОбъектРасчётов = ОбъектРасчётов;
	НС.Валюта = Валюта;
	НС.Сумма = Сумма;	
КонецПроцедуры

Процедура СформироватьПоДопРасходам(ДокОбъект, Валюта) Экспорт 
	ТЗДопРасходы = ДокОбъект.ТЧДополнительныеРасходы.Выгрузить();
	ТЗДопРасходы.Свернуть("Контрагент,Договор","СуммаСНДС");
	Для Каждого Стр из ТЗДопРасходы Цикл 
		Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, Стр.Контрагент, Стр.Договор, ДокОбъект.Ссылка, Валюта, Стр.СуммаСНДС, Ложь);	
	КонецЦикла;
КонецПроцедуры

#КонецОбласти	

#Область Остатки

Функция ПолучитьЗадолженностьПоставшиковПоКлассификации(Период, Отбор) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	// Заполним реквизиты
	Организации = ?(Отбор.Свойство("Организации"), Отбор.Организации, Новый Массив);
	Контрагенты = ?(Отбор.Свойство("Контрагенты"), Отбор.Контрагенты, Новый Массив);	
	Договоры = ?(Отбор.Свойство("Договоры"), Отбор.Договоры, Новый Массив);
	Менеджеры = ?(Отбор.Свойство("Менеджеры"), Отбор.Менеджеры, Новый Массив);
	// Получим данные из базы
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВсК.Организация КАК Организация,
	                      |	ВсК.Контрагент КАК Контрагент,
	                      |	ВсК.Договор КАК Договор,
	                      |	ВсК.ОбъектРасчётов КАК ПоступлениеТоваровУслуг,
	                      |	-ВсК.СуммаОстаток КАК Долг,
	                      |	НАЧАЛОПЕРИОДА(ВсК.ОбъектРасчётов.Дата, ДЕНЬ) КАК ДатаОтгрузки,
	                      |	ВсК.Договор.СрокОплаты КАК СрокОплаты,
	                      |	ВсК.Договор.СуммаКредита КАК СуммаКредита,
	                      |	ВсК.Договор.СпособРасчётаОтсрочки = ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.БанковскиеДни) КАК ПоБанковскимДням
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПоставщиками.Остатки(
	                      |			&Период,
	                      |			ОбъектРасчётов ССЫЛКА Документ.ПоступлениеТоваровУслуг
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьОрганизации
	                      |						ТОГДА Договор.Организация В (&Организации)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьКонтрагенты
	                      |						ТОГДА Контрагент В ИЕРАРХИИ (&Контрагенты)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьДоговоры
	                      |						ТОГДА Договор В (&Договоры)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ) КАК ВсК
	                      |ГДЕ
	                      |	ВсК.СуммаОстаток < 0
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг,
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПроизводственныйКалендарь.Дата) КАК КоличествоВыходных
	                      |ПОМЕСТИТЬ ВТВыходные
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь
	                      |		ПО (ПроизводственныйКалендарь.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, 1) И &Период)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТ.ПоступлениеТоваровУслуг
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	""Состояние взаиморасчетов"" КАК ГруппировкаВсего,
	                      |	ВЗ.Организация КАК Организация,
	                      |	ВЗ.Контрагент КАК Контрагент,
	                      |	ВЗ.Договор КАК Договор,
	                      |	ВЗ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг,
	                      |	ВЗ.Долг КАК Долг,
	                      |	ВЗ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |	ВЗ.КоличествоВыходных КАК КоличествоВыходных,
	                      |	ВЗ.ПросроченоДней КАК ПросроченоДней
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТ.Организация КАК Организация,
	                      |		ВТ.Контрагент КАК Контрагент,
	                      |		ВТ.Договор КАК Договор,
	                      |		ВТ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг,
	                      |		ВЫБОР
	                      |			КОГДА ВТ.Долг - ВТ.СуммаКредита < 0
	                      |				ТОГДА 0
	                      |			ИНАЧЕ ВТ.Долг - ВТ.СуммаКредита
	                      |		КОНЕЦ КАК Долг,
	                      |		ВТ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |		ВТВыходные.КоличествоВыходных КАК КоличествоВыходных,
	                      |		РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, ВТ.СрокОплаты + ВЫБОР
	                      |					КОГДА ВТ.ПоБанковскимДням
	                      |						ТОГДА ЕСТЬNULL(ВТВыходные.КоличествоВыходных, 0)
	                      |					ИНАЧЕ 0
	                      |				КОНЕЦ), &Период, ДЕНЬ) КАК ПросроченоДней
	                      |	ИЗ
	                      |		ВТ КАК ВТ
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ ВТВыходные КАК ВТВыходные
	                      |			ПО ВТ.ПоступлениеТоваровУслуг = ВТВыходные.ПоступлениеТоваровУслуг) КАК ВЗ
	                      |ГДЕ
	                      |	ВЗ.Долг > 0");
	Запрос.УстановитьПараметр("Период", КонецДня(Период));
	Запрос.УстановитьПараметр("ЕстьОрганизации", Организации.Количество() <> 0);
	Запрос.УстановитьПараметр("Организации", Организации);
	Запрос.УстановитьПараметр("ЕстьКонтрагенты", Контрагенты.Количество() <> 0);
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("ЕстьДоговоры", Договоры.Количество() <> 0);
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

