#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Себестоимость реализации (docs/plans/warehouse-orders-cost.md, Ф2.2): запись на каждую запись расхода своих
// ТоварыВНаличии и ДополнительныеРасходы в порядке списания, услуги - по закупочной цене, как прежде в Продажи.
// Вызывается после формирования движений склада, до записи движений.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - проводимая реализация
//
Процедура СформироватьПоРеализации(ДокОбъект) Экспорт

	Набор = ДокОбъект.Движения.СебестоимостьПродаж;
	Набор.Очистить();
	Измерения = ИзмеренияРеализации(ДокОбъект);
	Расход = ВидДвиженияНакопления.Расход;
	Для Каждого Запись Из ДокОбъект.Движения.ТоварыВНаличии Цикл
		Если Запись.ВидДвижения <> Расход Тогда
			Продолжить;
		КонецЕсли;
		Новая = НоваяЗаписьСписания(Набор, Измерения, Запись, Ложь);
		Новая.ДокументОтгрузки = ДокОбъект.Ссылка;
	КонецЦикла;
	Для Каждого Запись Из ДокОбъект.Движения.ДополнительныеРасходы Цикл
		Если Запись.ВидДвижения <> Расход Тогда
			Продолжить;
		КонецЕсли;
		Новая = НоваяЗаписьСписания(Набор, Измерения, Запись, Истина);
		Новая.ДокументОтгрузки = ДокОбъект.Ссылка;
	КонецЦикла;
	ДобавитьСебестоимостьУслуг(ДокОбъект, Набор, Измерения);

КонецПроцедуры

// Себестоимость налогового документа на основаниях (Ф2.2): черная сторона - минус каждая запись оснований с признаком
// УУ, белая - те же записи с измерениями налогового документа, свернутые по физическим полям и происхождению
// (основания не сливаются: ДокументОтгрузки различает их).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - налоговый документ на основаниях
//  Основания - Массив из ДокументСсылка.РеализацияТоваровУслуг - его основания
//  Набор     - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж, Неопределено - куда писать (перенос истории);
//              по умолчанию - движения документа
//
Процедура СформироватьПереклассификацию(ДокОбъект, Основания, Набор = Неопределено) Экспорт

	Если Набор = Неопределено Тогда
		Набор = ДокОбъект.Движения.СебестоимостьПродаж;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Т.Организация КАК Организация,
	|	Т.Сотрудник КАК Сотрудник,
	|	Т.Контрагент КАК Контрагент,
	|	Т.ДокументПродажи КАК ДокументПродажи,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Ответственный КАК Ответственный,
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.Серия КАК Серия,
	|	Т.НоменклатураПартии КАК НоменклатураПартии,
	|	Т.Партия КАК Партия,
	|	Т.ДополнительныйРасход КАК ДополнительныйРасход,
	|	Т.СтатьяДДС КАК СтатьяДДС,
	|	Т.Количество КАК Количество,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС,
	|	Т.ДатаПартии КАК ДатаПартии,
	|	Т.СкладОтгрузки КАК СкладОтгрузки,
	|	Т.ДокументОтгрузки КАК ДокументОтгрузки,
	|	Т.КлючСтрокиОтгрузки КАК КлючСтрокиОтгрузки,
	|	Т.Списание КАК Списание,
	|	Т.Поправка КАК Поправка
	|ИЗ
	|	РегистрНакопления.СебестоимостьПродаж КАК Т
	|ГДЕ
	|	Т.Регистратор В(&Основания)
	|	И Т.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.МоментВремени,
	|	Т.НомерСтроки");
	Запрос.УстановитьПараметр("Основания", Основания);
	Записи = Запрос.Выполнить().Выгрузить();
	Для Каждого Запись Из Записи Цикл
		Черная = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Черная, Запись);
		Черная.Период = ДокОбъект.Дата;
		Черная.УУ = Истина;
		Черная.Количество = -Запись.Количество;
		Черная.Сумма = -Запись.Сумма;
		Черная.СуммаНДС = -Запись.СуммаНДС;
	КонецЦикла;
	Белые = Записи.Скопировать();
	Белые.Свернуть(ПоляПроисхождения() + ", Списание, Поправка", "Количество, Сумма, СуммаНДС");
	Измерения = ИзмеренияРеализации(ДокОбъект);
	Для Каждого Запись Из Белые Цикл
		Белая = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Белая, Запись);
		ЗаполнитьЗначенияСвойств(Белая, Измерения);
		Белая.УУ = Ложь;
	КонецЦикла;

КонецПроцедуры

// Источник партий возврата от покупателя (Ф2.3 п. 2-3): физические записи себестоимости основания (у налогового
// документа - белые), свернутые по физическому ключу, за вычетом возвратов того же основания с моментом строго раньше
// текущего. Таблица Источники хранит невозвращенные остатки каждого происхождения для раскладки результата.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВозвратОтПокупателя - проводимый возврат с заполненным основанием
//
// Возвращаемое значение:
//  Структура:
//   * Партии     - ТаблицаЗначений - МестоХранения (склад списания), Номенклатура (физическая), Характеристика, Серия,
//                  Партия, ДатаПартии, Количество, Сумма, СуммаНДС
//   * Допрасходы - ТаблицаЗначений - МестоХранения, Номенклатура, Характеристика, Серия, Партия, СтатьяДДС, Сумма,
//                  СуммаНДС
//   * Источники  - ТаблицаЗначений - происхождения с остатками (см. ТаблицаИсточников)
//   * Поправки   - ТаблицаЗначений - записи поправок основания и прежних возвратов (для компенсации)
//
Функция ИсточникВозврата(ДокОбъект) Экспорт

	Основание = ДокОбъект.Основание;
	Запрос = Новый Запрос(ТекстЗаписейОснованияИВозвратов());
	Запрос.УстановитьПараметр("Основание", Основание);
	Запрос.УстановитьПараметр("ДопустимыеУУ", ДопустимыеПризнакиУУ(Основание));
	Запрос.УстановитьПараметр("Текущий", ДокОбъект.Ссылка);
	Запрос.УстановитьПараметр("Момент", МоментВозврата(ДокОбъект));
	Результаты = Запрос.ВыполнитьПакет();
	// [0] - временная таблица прежних возвратов, [1] - записи основания, [2] - прежние возвраты, [3] - поправки.
	Источники = ТаблицаИсточников(Результаты[1].Выгрузить(), Результаты[2].Выгрузить());
	Партии = СвернутьОстатки(Источники, Ложь, "МестоХранения, Номенклатура, Характеристика, Серия, Партия, ДатаПартии",
		"Количество, Сумма, СуммаНДС");
	Допрасходы = СвернутьОстатки(Источники, Истина, "МестоХранения, Номенклатура, Характеристика, Серия, Партия, СтатьяДДС",
		"Сумма, СуммаНДС");
	Поправки = Результаты[3].Выгрузить();
	Результат = Новый Структура;
	Результат.Вставить("Партии", Партии);
	Результат.Вставить("Допрасходы", Допрасходы);
	Результат.Вставить("Источники", Источники);
	Результат.Вставить("Поправки", Поправки);
	Возврат Результат;

КонецФункции

// Таблица частей, восстановленных возвратом, для ЗаписатьСторноВозврата: заполняется по одной строке на часть
// партии или допрасхода в порядке восстановления.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ДополнительныйРасход, МестоХранения (склад списания), Номенклатура (физическая), Характеристика,
//                    Серия, Партия, ДатаПартии, СтатьяДДС, Количество, Сумма, СуммаНДС
//
Функция НоваяТаблицаВосстановленного() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ДополнительныйРасход", Новый ОписаниеТипов("Булево"));
	Для Каждого Имя Из СтрРазделить("МестоХранения, Номенклатура, Характеристика, Серия, Партия, ДатаПартии, СтатьяДДС",
		", ", Ложь) Цикл
		Таблица.Колонки.Добавить(Имя);
	КонецЦикла;
	ТипЧисла = Метаданные.ОпределяемыеТипы.Сумма.Тип;
	Таблица.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Таблица.Колонки.Добавить("Сумма", ТипЧисла);
	Таблица.Колонки.Добавить("СуммаНДС", ТипЧисла);
	Возврат Таблица;

КонецФункции

// Записи себестоимости возврата (Ф2.3 п. 2, 4, 5): каждая восстановленная часть раскладывается по происхождениям
// своего ключа - количество последовательно в пределах невозвращенного остатка, допрасход пропорцией знаковых
// невозвращенных остатков; запись - минус часть с измерениями записи-источника, периодом и операцией возврата.
// Возврат, завершающий товар основания, компенсирует поправки переноса истории.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.ВозвратОтПокупателя - проводимый возврат
//  Источник      - Структура - см. ИсточникВозврата
//  Восстановлено - ТаблицаЗначений - см. НоваяТаблицаВосстановленного
//  Набор         - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж, Неопределено - по умолчанию движения документа
//  БезСклада     - Булево - партии сопоставляются без склада списания (перенос истории, Ф2.6 п. 4)
//
Процедура ЗаписатьСторноВозврата(ДокОбъект, Источник, Восстановлено, Набор = Неопределено, БезСклада = Ложь) Экспорт

	Если Набор = Неопределено Тогда
		// Тот же экземпляр документа, проведенный повторно, не должен удвоить набор (tiny1C bsl-018).
		Набор = ДокОбъект.Движения.СебестоимостьПродаж;
		Набор.Очистить();
	КонецЕсли;
	Части = РазложитьПоИсточникам(Источник.Источники, Восстановлено, БезСклада);
	Для Каждого Часть Из Части Цикл
		Запись = Набор.Добавить();
		Если Часть.Источник = Неопределено Тогда
			// Части без происхождения в проведении не бывает (остатки ключа = сумме остатков источников); страховка
			// для истории: нефизическая запись, в марже есть, источником партий не служит (Ф2.6 п. 4).
			ЗаполнитьЗначенияСвойств(Запись, Часть.Строка);
			Запись.НоменклатураПартии = Часть.Строка.Номенклатура;
			Запись.СкладОтгрузки = Часть.Строка.МестоХранения;
			Запись.Организация = ДокОбъект.Организация;
			Запись.Контрагент = ДокОбъект.Контрагент;
			Запись.ДокументПродажи = ДокОбъект.Основание;
			Запись.Ответственный = ДокОбъект.Ответственный;
			Запись.МестоХранения = ДокОбъект.МестоХранения;
			Запись.Списание = Ложь;
		Иначе
			ЗаполнитьЗначенияСвойств(Запись, Часть.Источник, , "Количество, Сумма, СуммаНДС, НомерСтроки");
			Запись.Списание = Истина;
		КонецЕсли;
		Запись.Период = ДокОбъект.Дата;
		Запись.ХозяйственнаяОперация = ДокОбъект.ХозяйственнаяОперация;
		Запись.ДополнительныйРасход = Часть.ДополнительныйРасход;
		Запись.Количество = -Часть.Количество;
		Запись.Сумма = -Часть.Сумма;
		Запись.СуммаНДС = -Часть.СуммаНДС;
		Запись.Поправка = Ложь;
	КонецЦикла;
	ЗаписатьКомпенсациюПоправок(ДокОбъект, Источник, Части, Набор);

КонецПроцедуры

// Раскладка частей возврата по происхождениям (Ф2.3 п. 2): количество партии - последовательно по источникам ключа в
// порядке момента отгрузки и номера строки, в пределах невозвращенного остатка, сумма и НДС - пропорционально
// количеству, остаток - последнему; допрасход - пропорцией знаковых невозвращенных остатков источников, копейки -
// наибольшими остатками своего знака. Остатки источников уменьшаются на разложенное.
//
// Параметры:
//  Источники     - ТаблицаЗначений - см. ТаблицаИсточников; колонки Остаток* уменьшаются
//  Восстановлено - ТаблицаЗначений - см. НоваяТаблицаВосстановленного
//  БезСклада     - Булево - партии сопоставляются без склада списания (перенос истории: склад прихода возврата - свой)
//
// Возвращаемое значение:
//  ТаблицаЗначений - Источник (СтрокаТаблицыЗначений, Неопределено), Количество, Сумма, СуммаНДС, ДополнительныйРасход,
//                    Номенклатура (коммерческая), Характеристика
//
Функция РазложитьПоИсточникам(Источники, Восстановлено, БезСклада) Экспорт

	Части = Новый ТаблицаЗначений;
	Части.Колонки.Добавить("Источник");
	Части.Колонки.Добавить("Количество");
	Части.Колонки.Добавить("Сумма");
	Части.Колонки.Добавить("СуммаНДС");
	Части.Колонки.Добавить("ДополнительныйРасход");
	Части.Колонки.Добавить("Номенклатура");
	Части.Колонки.Добавить("Характеристика");
	Части.Колонки.Добавить("Строка");
	Для Каждого Строка Из Восстановлено Цикл
		Если Строка.ДополнительныйРасход Тогда
			РазложитьДопрасход(Источники, Строка, Части);
		Иначе
			РазложитьПартию(Источники, Строка, БезСклада, Части);
		КонецЕсли;
	КонецЦикла;
	Возврат Части;

КонецФункции

// Текст запроса продаж с себестоимостью - единая формула прибыли (Ф2.2): обороты Продажи (количество, выручка, НДС)
// и СебестоимостьПродаж (себестоимость партий и допрасходы) объединяются в ВТПродажиССебестоимостью, прибыль -
// Выручка - Себестоимость - ДополнительныеРасходы по каждой строке. Параметры запроса &НачалоПериода, &КонецПериода
// (Неопределено - без границы).
//
// Параметры:
//  УсловиеОтбора - Строка - условие виртуальных таблиц по общим измерениям (как в параметре Условие оборотов), пусто -
//                  без отбора
//
// Возвращаемое значение:
//  Строка - текст запроса, помещающий ВТПродажиССебестоимостью: Период, Регистратор, все измерения Продажи кроме
//           Партия, Партия (из себестоимости), Количество, Выручка, НДС, Себестоимость, ДополнительныеРасходы, Прибыль
//
Функция ТекстПродажССебестоимостью(УсловиеОтбора = "") Экспорт

	Текст =
	"ВЫБРАТЬ
	|	Обороты.Период КАК Период,
	|	Обороты.Регистратор КАК Регистратор,
	|	Обороты.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Обороты.Организация КАК Организация,
	|	Обороты.Сотрудник КАК Сотрудник,
	|	Обороты.Контрагент КАК Контрагент,
	|	Обороты.ДокументПродажи КАК ДокументПродажи,
	|	Обороты.Номенклатура КАК Номенклатура,
	|	Обороты.Характеристика КАК Характеристика,
	|	Обороты.Ответственный КАК Ответственный,
	|	Обороты.МестоХранения КАК МестоХранения,
	|	Обороты.УУ КАК УУ,
	|	НЕОПРЕДЕЛЕНО КАК Партия,
	|	Обороты.КоличествоОборот КАК Количество,
	|	Обороты.ВыручкаОборот КАК Выручка,
	|	Обороты.НДСОборот КАК НДС,
	|	0 КАК Себестоимость,
	|	0 КАК ДополнительныеРасходы
	|ПОМЕСТИТЬ ВТСтрокиПродаж
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Регистратор, &Условие) КАК Обороты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Обороты.Период,
	|	Обороты.Регистратор,
	|	Обороты.ХозяйственнаяОперация,
	|	Обороты.Организация,
	|	Обороты.Сотрудник,
	|	Обороты.Контрагент,
	|	Обороты.ДокументПродажи,
	|	Обороты.Номенклатура,
	|	Обороты.Характеристика,
	|	Обороты.Ответственный,
	|	Обороты.МестоХранения,
	|	Обороты.УУ,
	|	Обороты.Партия,
	|	0,
	|	0,
	|	0,
	|	ВЫБОР
	|		КОГДА Обороты.ДополнительныйРасход
	|			ТОГДА 0
	|		ИНАЧЕ Обороты.СуммаОборот
	|	КОНЕЦ,
