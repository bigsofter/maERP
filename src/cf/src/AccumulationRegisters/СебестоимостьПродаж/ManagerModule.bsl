#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Себестоимость реализации (docs/plans/warehouse-orders-cost.md, Ф2.2): запись на каждую запись расхода своих
// ТоварыВНаличии и ДополнительныеРасходы в порядке списания, услуги - по закупочной цене, как прежде в Продажи.
// Вызывается после формирования движений склада, до записи движений.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - проводимая реализация
//
// На ордерном складе списания у реализации нет: записи по парам оформления дописывает ПересчитатьПоПарам после записи
// движений, свои допрасходы реализации - здесь, нефизической себестоимостью (план warehouse-orders-cost, Ф3.6).
//
Процедура СформироватьПоРеализации(ДокОбъект) Экспорт

	Набор = ДокОбъект.Движения.СебестоимостьПродаж;
	Набор.Очистить();
	Измерения = ИзмеренияРеализации(ДокОбъект);
	Если Справочники.МестаХранения.ОрдерныйСклад(ДокОбъект.МестоХранения, ДокОбъект.Дата) Тогда
		ДобавитьСвоиДопрасходыОрдерногоСклада(ДокОбъект, Набор, Измерения);
	КонецЕсли;
	Расход = ВидДвиженияНакопления.Расход;
	Для Каждого Запись Из ДокОбъект.Движения.ТоварыВНаличии Цикл
		Если Запись.ВидДвижения <> Расход Тогда
			Продолжить;
		КонецЕсли;
		Новая = НоваяЗаписьСписания(Набор, Измерения, Запись, Ложь);
		Новая.ДокументОтгрузки = ДокОбъект.Ссылка;
	КонецЦикла;
	Для Каждого Запись Из ДокОбъект.Движения.ДополнительныеРасходы Цикл
		Если Запись.ВидДвижения <> Расход Тогда
			Продолжить;
		КонецЕсли;
		Новая = НоваяЗаписьСписания(Набор, Измерения, Запись, Истина);
		Новая.ДокументОтгрузки = ДокОбъект.Ссылка;
	КонецЦикла;
	ДобавитьСебестоимостьУслуг(ДокОбъект, Набор, Измерения);

КонецПроцедуры

// Себестоимость реализаций ордерного склада по парам оформления строк расходных ордеров (план warehouse-orders-cost,
// Ф3.6, Ф3.7). По каждой строке и каждой физической позиции её списания: оформленное количество делится между парами
// наибольшими остатками, матрица «записи списания × пары» заполняется последовательно (FIFO по партиям), стоимость
// куска - доля записи пропорционально количеству наибольшими остатками, допрасходы записи - так же. В наборе каждой
// реализации с парами на этих строках заменяются только записи с отгрузкой по этим строкам; набор пишется, только если
// изменился. Изменённая чужая реализация сдвигает границу последовательности строго раньше своего самого раннего
// проведённого возврата. Вызывается после записи движений документа, под его блокировками (Ф3.8), привилегированно.
//
// Параметры:
//  СтрокиОрдеров      - ТаблицаЗначений - Ордер (ДокументСсылка.РасходныйОрдер), КодСтроки - затронутые строки
//  ДокОбъект          - ДокументОбъект - проводимый документ (ордер или реализация)
//  ПрежниеРеализации  - Массив из ДокументСсылка.РеализацияТоваровУслуг - получатели прежних пар, снятые до автоудаления
//                       движений (Ф4.6): реализация, потерявшая последнюю пару, очищается.
//
Процедура ПересчитатьПоПарам(СтрокиОрдеров, ДокОбъект, ПрежниеРеализации = Неопределено) Экспорт

	Если СтрокиОрдеров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - запись себестоимости чужих реализаций при проведении ордера (Ф3.16)
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Поле = "Ордер";
	ТаблицаОрдеров = СтрокиОрдеров.Скопировать(, Поле);
	ТаблицаОрдеров.Свернуть(Поле);
	Ордера = ТаблицаОрдеров.ВыгрузитьКолонку(Поле);
	Ключи = Новый Соответствие;
	Для Каждого Строка Из СтрокиОрдеров Цикл
		Ключи.Вставить(КлючСтрокиОрдера(Строка.Ордер, Строка.КодСтроки), Истина);
	КонецЦикла;
	Пары = Новый Массив;
	Для Каждого Пара Из РегистрыНакопления.ТоварыКОформлению.ПарыОформления(Ордера) Цикл
		// Стороны пары (Ф4.2): ордер первый - ордер источник, документ первый - ордер регистратор.
		Если ТипЗнч(Пара.Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			И Ключи[КлючСтрокиОрдера(Пара.Ордер, Пара.КодСтрокиОрдера)] <> Неопределено Тогда
			Пары.Добавить(Пара);
		КонецЕсли;
	КонецЦикла;
	Реализации = РеализацииПересчета(Пары, ПрежниеРеализации);
	Если Реализации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Куски = КускиПар(Пары, Ордера, Ключи);
	Изменены = Новый Массив;
	Для Каждого Реализация Из Реализации Цикл
		Если ЗаписатьСебестоимостьПоПарам(Реализация, Куски, Ключи) И Реализация <> Ссылка(ДокОбъект) Тогда
			Изменены.Добавить(Реализация);
		КонецЕсли;
	КонецЦикла;
	РаннийВозврат = РанниеВозвраты(Изменены);
	Если РаннийВозврат <> Неопределено Тогда
		РаботаСДокументами.СдвинутьГраницуБлижнимПересчетом(РаботаСДокументами.МоментДоДаты(РаннийВозврат.Дата), ДокОбъект);
	КонецЕсли;

КонецПроцедуры

// Реализации с парами на строках расходных ордеров - для блокировки себестоимости до записи (Ф3.8).
//
// Параметры:
//  Ордера - Массив из ДокументСсылка.РасходныйОрдер - ордера
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.РеализацияТоваровУслуг
//
Функция РеализацииПарОрдеров(Ордера) Экспорт

	Реализации = Новый Массив;
	Для Каждого Пара Из РегистрыНакопления.ТоварыКОформлению.ПарыОформления(Ордера) Цикл
		Если ТипЗнч(Пара.Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			И Реализации.Найти(Пара.Документ) = Неопределено Тогда
			Реализации.Добавить(Пара.Документ);
		КонецЕсли;
	КонецЦикла;
	Возврат Реализации;

КонецФункции

// Исключительная блокировка себестоимости реализаций (и записей их возвратов) по ДокументПродажи - последней в общем
// порядке (Ф3.8).
//
// Параметры:
//  Реализации - Массив из ДокументСсылка.РеализацияТоваровУслуг
//  Исключительная - Булево - режим; Ложь - разделяемая (чтение возвратом)
//
Процедура ЗаблокироватьРеализации(Реализации, Исключительная = Истина) Экспорт

	Если Реализации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Поле = "ДокументПродажи";
	Источник = Новый ТаблицаЗначений;
	Источник.Колонки.Добавить(Поле, Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
	Для Каждого Реализация Из Реализации Цикл
		Источник.Добавить()[Поле] = Реализация;
	КонецЦикла;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.СебестоимостьПродаж");
	Элемент.Режим = ?(Исключительная, РежимБлокировкиДанных.Исключительный, РежимБлокировкиДанных.Разделяемый);
	Элемент.ИсточникДанных = Источник;
	Элемент.ИспользоватьИзИсточникаДанных(Поле, Поле);
	Блокировка.Заблокировать();

КонецПроцедуры

// Себестоимость налогового документа на основаниях (Ф2.2): черная сторона - минус каждая запись оснований с признаком
// УУ, белая - те же записи с измерениями налогового документа, свернутые по физическим полям и происхождению
// (основания не сливаются: ДокументОтгрузки различает их).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - налоговый документ на основаниях
//  Основания - Массив из ДокументСсылка.РеализацияТоваровУслуг - его основания
//  Набор     - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж, Неопределено - куда писать (перенос истории);
//              по умолчанию - движения документа
//
Процедура СформироватьПереклассификацию(ДокОбъект, Основания, Набор = Неопределено) Экспорт

	Если Набор = Неопределено Тогда
		Набор = ДокОбъект.Движения.СебестоимостьПродаж;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Т.Организация КАК Организация,
	|	Т.Сотрудник КАК Сотрудник,
	|	Т.Контрагент КАК Контрагент,
	|	Т.ДокументПродажи КАК ДокументПродажи,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Ответственный КАК Ответственный,
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.Серия КАК Серия,
	|	Т.НоменклатураПартии КАК НоменклатураПартии,
	|	Т.Партия КАК Партия,
	|	Т.ДополнительныйРасход КАК ДополнительныйРасход,
	|	Т.СтатьяДДС КАК СтатьяДДС,
	|	Т.Количество КАК Количество,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС,
	|	Т.ДатаПартии КАК ДатаПартии,
	|	Т.СкладОтгрузки КАК СкладОтгрузки,
	|	Т.ДокументОтгрузки КАК ДокументОтгрузки,
	|	Т.КлючСтрокиОтгрузки КАК КлючСтрокиОтгрузки,
	|	Т.Списание КАК Списание,
	|	Т.Поправка КАК Поправка
	|ИЗ
	|	РегистрНакопления.СебестоимостьПродаж КАК Т
	|ГДЕ
	|	Т.Регистратор В(&Основания)
	|	И Т.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.МоментВремени,
	|	Т.НомерСтроки");
	Запрос.УстановитьПараметр("Основания", Основания);
	Записи = Запрос.Выполнить().Выгрузить();
	Для Каждого Запись Из Записи Цикл
		Черная = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Черная, Запись);
		Черная.Период = ДокОбъект.Дата;
		Черная.УУ = Истина;
		Черная.Количество = -Запись.Количество;
		Черная.Сумма = -Запись.Сумма;
		Черная.СуммаНДС = -Запись.СуммаНДС;
	КонецЦикла;
	Белые = Записи.Скопировать();
	Белые.Свернуть(ПоляПроисхождения() + ", Списание, Поправка", "Количество, Сумма, СуммаНДС");
	Измерения = ИзмеренияРеализации(ДокОбъект);
	Для Каждого Запись Из Белые Цикл
		Белая = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Белая, Запись);
		ЗаполнитьЗначенияСвойств(Белая, Измерения);
		Белая.УУ = Ложь;
	КонецЦикла;

КонецПроцедуры

// Источник партий возврата от покупателя (Ф2.3 п. 2-3): физические записи себестоимости основания (у налогового
// документа - белые), свернутые по физическому ключу, за вычетом возвратов того же основания с моментом строго раньше
// текущего. Таблица Источники хранит невозвращенные остатки каждого происхождения для раскладки результата.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВозвратОтПокупателя - проводимый возврат с заполненным основанием
//
// Возвращаемое значение:
//  Структура:
//   * Партии     - ТаблицаЗначений - МестоХранения (склад списания), Номенклатура (физическая), Характеристика, Серия,
//                  Партия, ДатаПартии, Количество, Сумма, СуммаНДС
//   * Допрасходы - ТаблицаЗначений - МестоХранения, Номенклатура, Характеристика, Серия, Партия, СтатьяДДС, Сумма,
//                  СуммаНДС
//   * Источники  - ТаблицаЗначений - происхождения с остатками (см. ТаблицаИсточников)
//   * Поправки   - ТаблицаЗначений - записи поправок основания и прежних возвратов (для компенсации)
//   * ОтгруженоПозже - ТаблицаЗначений - Номенклатура (физическая), Характеристика, Серия, Количество: партии, отгруженные
//                  расходным ордером позже возврата (отбор Ф3.11) - они в источник не входят
//
Функция ИсточникВозврата(ДокОбъект) Экспорт

	Основание = ДокОбъект.Основание;
	// Ближний пересчёт расходного ордера переписывает себестоимость основания - чтение под разделяемой блокировкой,
	// последней из блокировок возврата (warehouse-orders-cost, Ф3.8).
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И ТранзакцияАктивна() Тогда
		ЗаблокироватьРеализации(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основание), Ложь);
	КонецЕсли;
	Запрос = Новый Запрос(ТекстЗаписейОснованияИВозвратов());
	Запрос.УстановитьПараметр("Основание", Основание);
	Запрос.УстановитьПараметр("ДопустимыеУУ", ДопустимыеПризнакиУУ(Основание));
	Запрос.УстановитьПараметр("Текущий", ДокОбъект.Ссылка);
	Запрос.УстановитьПараметр("Момент", МоментВозврата(ДокОбъект));
	Результаты = Запрос.ВыполнитьПакет();
	// [0] - временная таблица прежних возвратов, [1] - записи основания, [2] - прежние возвраты, [3] - поправки.
	ЗаписиОснования = Результаты[1].Выгрузить();
	ОтгруженоПозже = ОтделитьОтгрузкиПозже(ЗаписиОснования, МоментВозврата(ДокОбъект));
	Источники = ТаблицаИсточников(ЗаписиОснования, Результаты[2].Выгрузить());
	Партии = СвернутьОстатки(Источники, Ложь, "МестоХранения, Номенклатура, Характеристика, Серия, Партия, ДатаПартии",
		"Количество, Сумма, СуммаНДС");
	Допрасходы = СвернутьОстатки(Источники, Истина, "МестоХранения, Номенклатура, Характеристика, Серия, Партия, СтатьяДДС",
		"Сумма, СуммаНДС");
	Поправки = Результаты[3].Выгрузить();
	Результат = Новый Структура;
	Результат.Вставить("Партии", Партии);
	Результат.Вставить("Допрасходы", Допрасходы);
	Результат.Вставить("Источники", Источники);
	Результат.Вставить("Поправки", Поправки);
	Результат.Вставить("ОтгруженоПозже", ОтгруженоПозже);
	Возврат Результат;

КонецФункции

// Таблица частей, восстановленных возвратом, для ЗаписатьСторноВозврата: заполняется по одной строке на часть
// партии или допрасхода в порядке восстановления.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ДополнительныйРасход, МестоХранения (склад списания), Номенклатура (физическая), Характеристика,
//                    Серия, Партия, ДатаПартии, СтатьяДДС, Количество, Сумма, СуммаНДС
//
Функция НоваяТаблицаВосстановленного() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ДополнительныйРасход", Новый ОписаниеТипов("Булево"));
	Для Каждого Имя Из СтрРазделить("МестоХранения, Номенклатура, Характеристика, Серия, Партия, ДатаПартии, СтатьяДДС",
		", ", Ложь) Цикл
		Таблица.Колонки.Добавить(Имя);
	КонецЦикла;
	ТипЧисла = Метаданные.ОпределяемыеТипы.Сумма.Тип;
	Таблица.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Таблица.Колонки.Добавить("Сумма", ТипЧисла);
	Таблица.Колонки.Добавить("СуммаНДС", ТипЧисла);
	Возврат Таблица;

КонецФункции

// Записи себестоимости возврата (Ф2.3 п. 2, 4, 5): каждая восстановленная часть раскладывается по происхождениям
// своего ключа - количество последовательно в пределах невозвращенного остатка, допрасход пропорцией знаковых
// невозвращенных остатков; запись - минус часть с измерениями записи-источника, периодом и операцией возврата.
// Возврат, завершающий товар основания, компенсирует поправки переноса истории.
//
// Параметры:
//  ДокОбъект     - ДокументОбъект.ВозвратОтПокупателя - проводимый возврат
//  Источник      - Структура - см. ИсточникВозврата
//  Восстановлено - ТаблицаЗначений - см. НоваяТаблицаВосстановленного
//  Набор         - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж, Неопределено - по умолчанию движения документа
//  БезСклада     - Булево - партии сопоставляются без склада списания (перенос истории, Ф2.6 п. 4)
//
Процедура ЗаписатьСторноВозврата(ДокОбъект, Источник, Восстановлено, Набор = Неопределено, БезСклада = Ложь) Экспорт

	Если Набор = Неопределено Тогда
		// Тот же экземпляр документа, проведенный повторно, не должен удвоить набор (tiny1C bsl-018).
		Набор = ДокОбъект.Движения.СебестоимостьПродаж;
		Набор.Очистить();
	КонецЕсли;
	Части = РазложитьПоИсточникам(Источник.Источники, Восстановлено, БезСклада);
	Для Каждого Часть Из Части Цикл
		Запись = Набор.Добавить();
		Если Часть.Источник = Неопределено Тогда
			// Части без происхождения в проведении не бывает (остатки ключа = сумме остатков источников); страховка
			// для истории: нефизическая запись, в марже есть, источником партий не служит (Ф2.6 п. 4).
			ЗаполнитьЗначенияСвойств(Запись, Часть.Строка);
			Запись.НоменклатураПартии = Часть.Строка.Номенклатура;
			Запись.СкладОтгрузки = Часть.Строка.МестоХранения;
			Запись.Организация = ДокОбъект.Организация;
			Запись.Контрагент = ДокОбъект.Контрагент;
			Запись.ДокументПродажи = ДокОбъект.Основание;
			Запись.Ответственный = ДокОбъект.Ответственный;
			Запись.МестоХранения = ДокОбъект.МестоХранения;
			Запись.Списание = Ложь;
		Иначе
			ЗаполнитьЗначенияСвойств(Запись, Часть.Источник, , "Количество, Сумма, СуммаНДС, НомерСтроки");
			Запись.Списание = Истина;
		КонецЕсли;
		Запись.Период = ДокОбъект.Дата;
		Запись.ХозяйственнаяОперация = ДокОбъект.ХозяйственнаяОперация;
		Запись.ДополнительныйРасход = Часть.ДополнительныйРасход;
		Запись.Количество = -Часть.Количество;
		Запись.Сумма = -Часть.Сумма;
		Запись.СуммаНДС = -Часть.СуммаНДС;
		Запись.Поправка = Ложь;
	КонецЦикла;
	ЗаписатьКомпенсациюПоправок(ДокОбъект, Источник, Части, Набор);

КонецПроцедуры

// Раскладка частей возврата по происхождениям (Ф2.3 п. 2): количество партии - последовательно по источникам ключа в
// порядке момента отгрузки и номера строки, в пределах невозвращенного остатка, сумма и НДС - пропорционально
// количеству, остаток - последнему; допрасход - пропорцией знаковых невозвращенных остатков источников, копейки -
// наибольшими остатками своего знака. Остатки источников уменьшаются на разложенное.
//
// Параметры:
//  Источники     - ТаблицаЗначений - см. ТаблицаИсточников; колонки Остаток* уменьшаются
//  Восстановлено - ТаблицаЗначений - см. НоваяТаблицаВосстановленного
//  БезСклада     - Булево - партии сопоставляются без склада списания (перенос истории: склад прихода возврата - свой)
//
// Возвращаемое значение:
//  ТаблицаЗначений - Источник (СтрокаТаблицыЗначений, Неопределено), Количество, Сумма, СуммаНДС, ДополнительныйРасход,
//                    Номенклатура (коммерческая), Характеристика
//
Функция РазложитьПоИсточникам(Источники, Восстановлено, БезСклада) Экспорт

	Части = Новый ТаблицаЗначений;
	Части.Колонки.Добавить("Источник");
	Части.Колонки.Добавить("Количество");
	Части.Колонки.Добавить("Сумма");
	Части.Колонки.Добавить("СуммаНДС");
	Части.Колонки.Добавить("ДополнительныйРасход");
	Части.Колонки.Добавить("Номенклатура");
	Части.Колонки.Добавить("Характеристика");
	Части.Колонки.Добавить("Строка");
	Для Каждого Строка Из Восстановлено Цикл
		Если Строка.ДополнительныйРасход Тогда
			РазложитьДопрасход(Источники, Строка, Части);
		Иначе
			РазложитьПартию(Источники, Строка, БезСклада, Части);
		КонецЕсли;
	КонецЦикла;
	Возврат Части;

КонецФункции

// Текст запроса продаж с себестоимостью - единая формула прибыли (Ф2.2): обороты Продажи (количество, выручка, НДС)
// и СебестоимостьПродаж (себестоимость партий и допрасходы) объединяются в ВТПродажиССебестоимостью, прибыль -
// Выручка - Себестоимость - ДополнительныеРасходы по каждой строке. Параметры запроса &НачалоПериода, &КонецПериода
// (Неопределено - без границы).
//
// Параметры:
//  УсловиеОтбора - Строка - условие виртуальных таблиц по общим измерениям (как в параметре Условие оборотов), пусто -
//                  без отбора
//
// Возвращаемое значение:
//  Строка - текст запроса, помещающий ВТПродажиССебестоимостью: Период, Регистратор, все измерения Продажи кроме
//           Партия, Партия (из себестоимости), Количество, Выручка, НДС, Себестоимость, ДополнительныеРасходы, Прибыль
//
Функция ТекстПродажССебестоимостью(УсловиеОтбора = "") Экспорт

	Текст =
	"ВЫБРАТЬ
	|	Обороты.Период КАК Период,
	|	Обороты.Регистратор КАК Регистратор,
	|	Обороты.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Обороты.Организация КАК Организация,
	|	Обороты.Сотрудник КАК Сотрудник,
	|	Обороты.Контрагент КАК Контрагент,
	|	Обороты.ДокументПродажи КАК ДокументПродажи,
	|	Обороты.Номенклатура КАК Номенклатура,
	|	Обороты.Характеристика КАК Характеристика,
	|	Обороты.Ответственный КАК Ответственный,
	|	Обороты.МестоХранения КАК МестоХранения,
	|	Обороты.УУ КАК УУ,
	|	НЕОПРЕДЕЛЕНО КАК Партия,
	|	Обороты.КоличествоОборот КАК Количество,
	|	Обороты.ВыручкаОборот КАК Выручка,
	|	Обороты.НДСОборот КАК НДС,
	|	0 КАК Себестоимость,
	|	0 КАК ДополнительныеРасходы
	|ПОМЕСТИТЬ ВТСтрокиПродаж
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Регистратор, &Условие) КАК Обороты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Обороты.Период,
	|	Обороты.Регистратор,
	|	Обороты.ХозяйственнаяОперация,
	|	Обороты.Организация,
	|	Обороты.Сотрудник,
	|	Обороты.Контрагент,
	|	Обороты.ДокументПродажи,
	|	Обороты.Номенклатура,
	|	Обороты.Характеристика,
	|	Обороты.Ответственный,
	|	Обороты.МестоХранения,
	|	Обороты.УУ,
	|	Обороты.Партия,
	|	0,
	|	0,
	|	0,
	|	ВЫБОР
	|		КОГДА Обороты.ДополнительныйРасход
	|			ТОГДА 0
	|		ИНАЧЕ Обороты.СуммаОборот
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Обороты.ДополнительныйРасход
	|			ТОГДА Обороты.СуммаОборот
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	РегистрНакопления.СебестоимостьПродаж.Обороты(&НачалоПериода, &КонецПериода, Регистратор, &Условие) КАК Обороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Период КАК Период,
	|	Строки.Регистратор КАК Регистратор,
	|	Строки.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Строки.Организация КАК Организация,
	|	Строки.Сотрудник КАК Сотрудник,
	|	Строки.Контрагент КАК Контрагент,
	|	Строки.ДокументПродажи КАК ДокументПродажи,
	|	Строки.Номенклатура КАК Номенклатура,
	|	Строки.Характеристика КАК Характеристика,
	|	Строки.Ответственный КАК Ответственный,
	|	Строки.МестоХранения КАК МестоХранения,
	|	Строки.УУ КАК УУ,
	|	Строки.Партия КАК Партия,
	|	Строки.Количество КАК Количество,
	|	Строки.Выручка КАК Выручка,
	|	Строки.НДС КАК НДС,
	|	Строки.Себестоимость КАК Себестоимость,
	|	Строки.ДополнительныеРасходы КАК ДополнительныеРасходы,
	|	Строки.Выручка - Строки.Себестоимость - Строки.ДополнительныеРасходы КАК Прибыль
	|ПОМЕСТИТЬ ВТПродажиССебестоимостью
	|ИЗ
	|	ВТСтрокиПродаж КАК Строки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТСтрокиПродаж";
	Условие = ?(ПустаяСтрока(УсловиеОтбора), "ИСТИНА", УсловиеОтбора);
	Возврат СтрЗаменить(Текст, "&Условие", Условие);

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Перенос себестоимости продаж из исторических записей Продажи (обработчик обновления 2.0.16.121, план
// warehouse-orders-cost, Ф2.6). Детализация - фактические движения склада документа, разница с Продажи - записи
// поправки; проходы: реализации, налоговые документы на основаниях, возвраты по порядку моментов, прочие. Наборы
// пишутся замещением - повторный запуск дает те же записи. Излишек исторических возвратов над отгруженным -
// предупреждение в журнале с перечнем (история переносится как есть, поправками; при переходе с другой ветки
// исправить возвраты «на прежней версии» негде - docs/plans/retail-client-update.md); расхождение сверки - исключение
// (версия базы не поднимается).
//
// Параметры:
//  Регистраторы          - Массив из ДокументСсылка, Неопределено - только эти регистраторы Продажи (сценарий теста);
//                          Неопределено - вся база
//  ДопуститьРасхождения  - Булево - база перешла с другой ветки Commerce: себестоимость её истории посчитана чужой
//                          логикой, расхождение сверки - предупреждение с перечнем, а не остановка.
//
// Возвращаемое значение:
//  Структура - Регистраторов, Записей, БезДетализации, Поправок, СуммаПоправок, ВнеФормулы, РазницаФормулы,
//              ИзлишковВозвратов, Расхождений (Число)
//
Функция ПеренестиИсторию(Регистраторы = Неопределено, ДопуститьРасхождения = Ложь) Экспорт

	Итог = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Регистраторов,Записей,БезДетализации,Поправок,СуммаПоправок,ВнеФормулы,РазницаФормулы",
		",") Цикл
		Итог.Вставить(Имя, 0);
	КонецЦикла;
	Излишки = ИзлишкиИсторическихВозвратов(Регистраторы);
	Итог.Вставить("ИзлишковВозвратов", Излишки.Количество());
	Если Излишки.Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации(ОбновлениеПрограммы.ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ТекстИзлишков(Излишки));
	КонецЕсли;
	Данные = ДанныеПереноса(Регистраторы);
	Для Каждого Регистратор Из Данные.Реализации Цикл
		Набор = НаборРегистратора(Регистратор);
		Цели = ЦелиРегистратора(Данные, Регистратор);
		ДобавитьДетализацию(Набор, Данные, Регистратор, Цели);
		ЗаписатьПеренос(Набор, Цели, Итог);
	КонецЦикла;
	Для Каждого Регистратор Из Данные.НаОснованиях Цикл
		Набор = НаборРегистратора(Регистратор);
		ДокОбъект = Регистратор.ПолучитьОбъект();
		Основания = ДокОбъект.Основания.Выгрузить(, ИмяОснования());
		Основания.Свернуть(ИмяОснования());
		СформироватьПереклассификацию(ДокОбъект, Основания.ВыгрузитьКолонку(ИмяОснования()), Набор);
		ЗаписатьПеренос(Набор, Новый Массив, Итог);
	КонецЦикла;
	Для Каждого Регистратор Из Данные.Возвраты Цикл
		ДокОбъект = Регистратор.ПолучитьОбъект();
		Набор = НаборРегистратора(Регистратор);
		Если ЗначениеЗаполнено(ДокОбъект[ИмяОснования()]) Тогда
			Источник = ИсточникВозврата(ДокОбъект);
			Восстановлено = ВосстановленоИсторическимВозвратом(Данные, Регистратор);
			ЗаписатьСторноВозврата(ДокОбъект, Источник, Восстановлено, Набор, Истина);
			УУ = НалоговыйУчет.ЗначениеУУ(ДокОбъект);
			Для Каждого Запись Из Набор Цикл
				Запись.УУ = УУ;
			КонецЦикла;
		КонецЕсли;
		ЗаписатьПеренос(Набор, ЦелиРегистратора(Данные, Регистратор), Итог);
	КонецЦикла;
	МетаданныеРегистра = Метаданные.РегистрыНакопления.СебестоимостьПродаж;
	Для Каждого Регистратор Из Данные.Прочие Цикл
		Цели = ЦелиРегистратора(Данные, Регистратор);
		// Не регистратор себестоимости продаж (история КорректировкаДолга): себестоимости у таких записей нет; иначе
		// перенос ее потерял бы - сверка ниже остановит обновление.
		Если Регистратор.Метаданные().Движения.Содержит(МетаданныеРегистра) Тогда
			ЗаписатьПеренос(НаборРегистратора(Регистратор), Цели, Итог);
			ДобавитьРегистрВКорректировку(Регистратор);
		КонецЕсли;
	КонецЦикла;
	ПроверитьРасхожденияПереноса(Итог, Регистраторы, ДопуститьРасхождения);
	ЗаполнитьРасхождениеФормулы(Итог, Регистраторы);
	Возврат Итог;

КонецФункции

// Излишек исторических возвратов над отгруженным по физическому источнику основания (Ф2.6 п. 4): обычная реализация
// раньше не вычитала прежние возвраты, и повторный возврат мог восстановить партию дважды.
//
// Параметры:
//  Регистраторы - Массив из ДокументСсылка, Неопределено - только эти основания и их возвраты; Неопределено - все
//
// Возвращаемое значение:
//  ТаблицаЗначений - Основание, Номенклатура, Характеристика, Серия, Партия, ДатаПартии, Отгружено, Возвращено
//
Функция ИзлишкиИсторическихВозвратов(Регистраторы = Неопределено) Экспорт

	ТекстОтбора = ТекстОтбораРегистраторов(Регистраторы);
	Запрос = Новый Запрос(ТекстОтбора +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	О.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТНаОснованиях
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Основания КАК О
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Регистратор КАК Основание,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Серия КАК Серия,
	|	Т.Партия КАК Партия,
	|	Т.ДатаПартии КАК ДатаПартии,
	|	Т.Количество КАК Отгружено,
	|	0 КАК Возвращено
	|ПОМЕСТИТЬ ВТСтроки
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|ГДЕ
	|	Т.Регистратор В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)
	|	И Т.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Т.Активность
	|	И НЕ Т.Регистратор В
	|				(ВЫБРАТЬ
	|					Н.Ссылка КАК Ссылка
	|				ИЗ
	|					ВТНаОснованиях КАК Н)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Регистратор,
	|	Т.Номенклатура,
	|	Т.Характеристика,
	|	Т.Серия,
	|	Т.Партия,
	|	Т.ДатаПартии,
	|	Т.Количество,
	|	0
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|ГДЕ
	|	Т.Регистратор В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)
	|	И Т.Регистратор В
	|			(ВЫБРАТЬ
	|				Н.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТНаОснованиях КАК Н)
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Т.Активность
	|	И НЕ Т.УУ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Возвраты.Основание,
	|	Т.Номенклатура,
	|	Т.Характеристика,
	|	Т.Серия,
	|	Т.Партия,
	|	Т.ДатаПартии,
	|	0,
	|	Т.Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратОтПокупателя КАК Возвраты
	|		ПО Т.Регистратор = Возвраты.Ссылка
	|ГДЕ
	|	Возвраты.Основание В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Т.Партия <> Т.Регистратор
	|	И Т.Активность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Основание КАК Основание,
	|	Строки.Номенклатура КАК Номенклатура,
	|	Строки.Характеристика КАК Характеристика,
	|	Строки.Серия КАК Серия,
	|	Строки.Партия КАК Партия,
	|	Строки.ДатаПартии КАК ДатаПартии,
	|	СУММА(Строки.Отгружено) КАК Отгружено,
	|	СУММА(Строки.Возвращено) КАК Возвращено
	|ИЗ
	|	ВТСтроки КАК Строки
	|
	|СГРУППИРОВАТЬ ПО
	|	Строки.Основание,
	|	Строки.Номенклатура,
	|	Строки.Характеристика,
	|	Строки.Серия,
	|	Строки.Партия,
	|	Строки.ДатаПартии
	|
	|ИМЕЮЩИЕ
	|	СУММА(Строки.Возвращено) > СУММА(Строки.Отгружено)");
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Расхождения переноса (Ф2.6 п. 6): себестоимость и допрасходы Продажи против СебестоимостьПродаж по регистратору,
// периоду, активности и измерениям Продажи (кроме партии).
//
// Параметры:
//  Регистраторы - Массив из ДокументСсылка, Неопределено - только эти регистраторы; Неопределено - все
//
// Возвращаемое значение:
//  ТаблицаЗначений - Регистратор, Номенклатура, Себестоимость, ДополнительныеРасходы (разница Продажи - новый регистр)
//
Функция РасхожденияПереноса(Регистраторы = Неопределено) Экспорт

	ТекстОтбора = ТекстОтбораРегистраторов(Регистраторы);
	Запрос = Новый Запрос(ТекстОтбора +
	"ВЫБРАТЬ
	|	П.Регистратор КАК Регистратор,
	|	П.Период КАК Период,
	|	П.Активность КАК Активность,
	|	П.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	П.Организация КАК Организация,
	|	П.Сотрудник КАК Сотрудник,
	|	П.Контрагент КАК Контрагент,
	|	П.ДокументПродажи КАК ДокументПродажи,
	|	П.Номенклатура КАК Номенклатура,
	|	П.Характеристика КАК Характеристика,
	|	П.Ответственный КАК Ответственный,
	|	П.МестоХранения КАК МестоХранения,
	|	П.УУ КАК УУ,
	|	П.Себестоимость КАК Себестоимость,
	|	П.ДополнительныеРасходы КАК ДополнительныеРасходы
	|ПОМЕСТИТЬ ВТСтроки
	|ИЗ
	|	РегистрНакопления.Продажи КАК П
	|ГДЕ
	|	П.Регистратор В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	С.Регистратор,
	|	С.Период,
	|	С.Активность,
	|	С.ХозяйственнаяОперация,
	|	С.Организация,
	|	С.Сотрудник,
	|	С.Контрагент,
	|	С.ДокументПродажи,
	|	С.Номенклатура,
	|	С.Характеристика,
	|	С.Ответственный,
	|	С.МестоХранения,
	|	С.УУ,
	|	ВЫБОР
	|		КОГДА С.ДополнительныйРасход
	|			ТОГДА 0
	|		ИНАЧЕ -С.Сумма
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА С.ДополнительныйРасход
	|			ТОГДА -С.Сумма
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	РегистрНакопления.СебестоимостьПродаж КАК С
	|ГДЕ
	|	С.Регистратор В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Регистратор КАК Регистратор,
	|	Строки.Номенклатура КАК Номенклатура,
	|	СУММА(Строки.Себестоимость) КАК Себестоимость,
	|	СУММА(Строки.ДополнительныеРасходы) КАК ДополнительныеРасходы
	|ИЗ
	|	ВТСтроки КАК Строки
	|
	|СГРУППИРОВАТЬ ПО
	|	Строки.Регистратор,
	|	Строки.Период,
	|	Строки.Активность,
	|	Строки.ХозяйственнаяОперация,
