	|ИМЕЮЩИЕ
	|	(СУММА(Строки.Себестоимость) <> 0
	|		ИЛИ СУММА(Строки.ДополнительныеРасходы) <> 0)");
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РеализацииПересчета(Пары, ПрежниеРеализации)

	Реализации = Новый Массив;
	Если ПрежниеРеализации <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Реализации, ПрежниеРеализации, Истина);
	КонецЕсли;
	Для Каждого Пара Из Пары Цикл
		Если Реализации.Найти(Пара.Документ) = Неопределено Тогда
			Реализации.Добавить(Пара.Документ);
		КонецЕсли;
	КонецЦикла;
	Возврат Реализации;

КонецФункции

// Отбор регистраторов переноса - временная таблица ВТОтбор (поле Регистратор): все регистраторы Продажи или только
// переданные в параметре &Регистраторы.
//
// Параметры:
//  Регистраторы - Массив из ДокументСсылка, Неопределено - отбор; Неопределено - все
//
// Возвращаемое значение:
//  Строка - первый запрос пакета с разделителем
//
Функция ТекстОтбораРегистраторов(Регистраторы)

	Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	П.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТОтбор
	|ИЗ
	|	РегистрНакопления.Продажи КАК П";
	Если Регистраторы <> Неопределено Тогда
		Текст = Текст + "
		|ГДЕ
		|	П.Регистратор В (&Регистраторы)";
	КонецЕсли;
	Возврат Текст + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";

КонецФункции

// Данные переноса одним проходом по регистрам: цели (записи Продажи, свернутые по периоду, активности, измерениям и
// партии; у КорректировкаРегистров - построчно), детализация (расход реализаций, приход возвратов партиями
// оснований), списки регистраторов по проходам.
//
// Параметры:
//  Регистраторы - Массив из ДокументСсылка, Неопределено - отбор; Неопределено - все
//
// Возвращаемое значение:
//  Структура - Цели, Партии, Допрасходы (ТаблицаЗначений); Реализации, НаОснованиях, Возвраты, Прочие (Массив)
//
Функция ДанныеПереноса(Регистраторы)

	Текст = ТекстОтбораРегистраторов(Регистраторы) + ТекстДанныхПереноса();
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Пакет = Запрос.ВыполнитьПакет();
	// [0] ВТОтбор, [1] ВТНаОснованиях, [2] цели, [3] партии, [4] допрасходы, [5] проходы.
	Данные = Новый Структура;
	Для Каждого Описание Из Новый Структура("Цели, Партии, Допрасходы", 2, 3, 4) Цикл
		Таблица = Пакет[Описание.Значение].Выгрузить();
		Таблица.Индексы.Добавить(ИмяРегистратора());
		Данные.Вставить(Описание.Ключ, Таблица);
	КонецЦикла;
	Проходы = Пакет[5].Выгрузить();
	Имена = СтрРазделить("Реализации,НаОснованиях,Возвраты,Прочие", ",");
	Для Номер = 1 По Имена.Количество() Цикл
		Отбор = Новый Структура("Проход", Номер);
		Данные.Вставить(Имена[Номер - 1], Проходы.Скопировать(Отбор).ВыгрузитьКолонку(ИмяРегистратора()));
	КонецЦикла;
	Возврат Данные;

КонецФункции

Функция ТекстДанныхПереноса()

	Возврат
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	О.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТНаОснованиях
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Основания КАК О
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	П.Регистратор КАК Регистратор,
	|	П.Период КАК Период,
	|	П.Активность КАК Активность,
	|	П.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	П.Организация КАК Организация,
	|	П.Сотрудник КАК Сотрудник,
	|	П.Контрагент КАК Контрагент,
	|	П.ДокументПродажи КАК ДокументПродажи,
	|	П.Номенклатура КАК Номенклатура,
	|	П.Характеристика КАК Характеристика,
	|	П.Ответственный КАК Ответственный,
	|	П.МестоХранения КАК МестоХранения,
	|	П.УУ КАК УУ,
	|	П.Партия КАК Партия,
	|	ВЫБОР
	|		КОГДА П.Регистратор ССЫЛКА Документ.КорректировкаРегистров
	|			ТОГДА П.НомерСтроки
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Строка,
	|	СУММА(П.Количество) КАК Количество,
	|	СУММА(П.Себестоимость) КАК Себестоимость,
	|	СУММА(П.ДополнительныеРасходы) КАК ДополнительныеРасходы,
	|	МИНИМУМ(П.НомерСтроки) КАК НомерСтроки
	|ИЗ
	|	РегистрНакопления.Продажи КАК П
	|ГДЕ
	|	П.Регистратор В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)
	|
	|СГРУППИРОВАТЬ ПО
	|	П.Регистратор,
	|	П.Период,
	|	П.Активность,
	|	П.ХозяйственнаяОперация,
	|	П.Организация,
	|	П.Сотрудник,
	|	П.Контрагент,
	|	П.ДокументПродажи,
	|	П.Номенклатура,
	|	П.Характеристика,
	|	П.Ответственный,
	|	П.МестоХранения,
	|	П.УУ,
	|	П.Партия,
	|	ВЫБОР
	|		КОГДА П.Регистратор ССЫЛКА Документ.КорректировкаРегистров
	|			ТОГДА П.НомерСтроки
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|" + ТекстДетализацииПереноса() + "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Отбор.Регистратор КАК Регистратор,
	|	ВЫБОР
	|		КОГДА НаОснованиях.Ссылка ЕСТЬ НЕ NULL
	|			ТОГДА 2
	|		КОГДА Отбор.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ТОГДА 1
	|		КОГДА Отбор.Регистратор ССЫЛКА Документ.ВозвратОтПокупателя
	|			ТОГДА 3
	|		ИНАЧЕ 4
	|	КОНЕЦ КАК Проход,
	|	ЕСТЬNULL(Возвраты.МоментВремени, ДАТАВРЕМЯ(1, 1, 1)) КАК Момент
	|ИЗ
	|	ВТОтбор КАК Отбор
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНаОснованиях КАК НаОснованиях
	|		ПО Отбор.Регистратор = НаОснованиях.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратОтПокупателя КАК Возвраты
	|		ПО Отбор.Регистратор = Возвраты.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Проход,
	|	Момент";

КонецФункции

// Признаки УУ записей основания, из которых возврат берет себестоимость: у налогового документа на основаниях - только
// белые (налоговая сторона переклассификации), у обычной реализации - любые.
//
// Параметры:
//  Основание - ДокументСсылка.РеализацияТоваровУслуг - основание возврата
//
// Возвращаемое значение:
//  Массив из Булево
//
Функция ДопустимыеПризнакиУУ(Основание) Экспорт

	Признаки = Новый Массив;
	Признаки.Добавить(Ложь);
	Если Не НалоговыеДокументыНаОснованиях.ЭтоРегистраторНаОснованиях(Основание) Тогда
		Признаки.Добавить(Истина);
	КонецЕсли;
	Возврат Признаки;

КонецФункции

// Детализация переноса: расход склада и допрасходов реализаций, приход возвратов партиями оснований (два запроса
// пакета ДанныеПереноса).
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстДетализацииПереноса()

	Возврат
	"ВЫБРАТЬ
	|	Т.Регистратор КАК Регистратор,
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Комплект КАК Комплект,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Серия КАК Серия,
	|	Т.Партия КАК Партия,
	|	Т.ДатаПартии КАК ДатаПартии,
	|	Т.Количество КАК Количество,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС,
	|	Т.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|ГДЕ
	|	Т.Регистратор В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)
	|	И Т.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Т.Активность
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Регистратор,
	|	Т.МестоХранения,
	|	Т.Номенклатура,
	|	Т.Комплект,
	|	Т.Характеристика,
	|	Т.Серия,
	|	Т.Партия,
	|	Т.ДатаПартии,
	|	Т.Количество,
	|	Т.Сумма,
	|	Т.СуммаНДС,
	|	Т.НомерСтроки
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|ГДЕ
	|	Т.Регистратор В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)
	|	И Т.Регистратор ССЫЛКА Документ.ВозвратОтПокупателя
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Т.Партия <> Т.Регистратор
	|	И Т.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Регистратор КАК Регистратор,
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Комплект КАК Комплект,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Серия КАК Серия,
	|	Т.Партия КАК Партия,
	|	Т.СтатьяДДС КАК СтатьяДДС,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС,
	|	Т.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	РегистрНакопления.ДополнительныеРасходы КАК Т
	|ГДЕ
	|	Т.Регистратор В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)
	|	И Т.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Т.Активность
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Регистратор,
	|	Т.МестоХранения,
	|	Т.Номенклатура,
	|	Т.Комплект,
	|	Т.Характеристика,
	|	Т.Серия,
	|	Т.Партия,
	|	Т.СтатьяДДС,
	|	Т.Сумма,
	|	Т.СуммаНДС,
	|	Т.НомерСтроки
	|ИЗ
	|	РегистрНакопления.ДополнительныеРасходы КАК Т
	|ГДЕ
	|	Т.Регистратор В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)
	|	И Т.Регистратор ССЫЛКА Документ.ВозвратОтПокупателя
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Т.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";

