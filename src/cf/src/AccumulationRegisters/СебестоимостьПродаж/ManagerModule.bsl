Функция ИмяРегистратора()

	Возврат "Регистратор";

КонецФункции

Функция ИмяОснования()

	Возврат "Основание";

КонецФункции

// Цели переноса одного регистратора - записи Продажи (см. ДанныеПереноса).
//
// Параметры:
//  Данные      - Структура - см. ДанныеПереноса
//  Регистратор - ДокументСсылка - регистратор
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений
//
Функция ЦелиРегистратора(Данные, Регистратор)

	Отбор = Новый Структура(ИмяРегистратора(), Регистратор);
	Возврат Данные.Цели.НайтиСтроки(Отбор);

КонецФункции

// Ручная корректировка показывает в форме регистры своей таблицы: перенесенные записи себестоимости продаж видны и
// правятся, только если регистр в ней есть. Запись документа - без обработчиков, движения не перезаписываются.
//
// Параметры:
//  Регистратор - ДокументСсылка - регистратор прохода «прочие»
//
Процедура ДобавитьРегистрВКорректировку(Регистратор)

	Если ТипЗнч(Регистратор) <> Тип("ДокументСсылка.КорректировкаРегистров") Тогда
		Возврат;
	КонецЕсли;
	ДокОбъект = Регистратор.ПолучитьОбъект();
	ИмяРегистра = Метаданные.РегистрыНакопления.СебестоимостьПродаж.Имя;
	Если ДокОбъект.ТаблицаРегистров.Найти(ИмяРегистра, "Имя") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДокОбъект.ТаблицаРегистров.Добавить().Имя = ИмяРегистра;
	ДокОбъект.ОбменДанными.Загрузка = Истина;
	ДокОбъект.Записать();

КонецПроцедуры

Функция НаборРегистратора(Регистратор)

	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Возврат Набор;

КонецФункции

// Физическая детализация реализации: записи расхода склада и допрасходов с измерениями ее записей Продажи.
//
// Параметры:
//  Набор       - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж - набор реализации
//  Данные      - Структура - см. ДанныеПереноса
//  Регистратор - ДокументСсылка.РеализацияТоваровУслуг - реализация
//  Цели        - Массив из СтрокаТаблицыЗначений - ее записи Продажи
//
Процедура ДобавитьДетализацию(Набор, Данные, Регистратор, Цели)

	Если Цели.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура(ИмяРегистратора(), Регистратор);
	Для Каждого Запись Из Данные.Партии.НайтиСтроки(Отбор) Цикл
		ДобавитьЗаписьДетализации(Набор, Цели[0], Запись, Ложь);
	КонецЦикла;
	Для Каждого Запись Из Данные.Допрасходы.НайтиСтроки(Отбор) Цикл
		ДобавитьЗаписьДетализации(Набор, Цели[0], Запись, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЗаписьДетализации(Набор, Цель, Запись, ДополнительныйРасход)

	Новая = Набор.Добавить();
	ЗаполнитьЗначенияСвойств(Новая, Цель, , "Номенклатура, Характеристика, Партия, Количество, НомерСтроки, Регистратор");
	Новая.Номенклатура = ?(ЗначениеЗаполнено(Запись.Комплект), Запись.Комплект, Запись.Номенклатура);
	Новая.НоменклатураПартии = Запись.Номенклатура;
	Новая.Характеристика = Запись.Характеристика;
	Новая.Серия = Запись.Серия;
	Новая.Партия = Запись.Партия;
	Новая.СкладОтгрузки = Запись.МестоХранения;
	Новая.ДокументОтгрузки = Запись.Регистратор;
	Новая.ДополнительныйРасход = ДополнительныйРасход;
	Новая.Сумма = Запись.Сумма;
	Новая.СуммаНДС = Запись.СуммаНДС;
	Если ДополнительныйРасход Тогда
		Новая.СтатьяДДС = Запись.СтатьяДДС;
	Иначе
		Новая.Количество = Запись.Количество;
		Новая.ДатаПартии = Запись.ДатаПартии;
	КонецЕсли;
	Новая.Списание = Истина;

КонецПроцедуры

// Части, восстановленные историческим возвратом: его фактические приходы партиями оснований и допрасходов.
//
// Параметры:
//  Данные      - Структура - см. ДанныеПереноса
//  Регистратор - ДокументСсылка.ВозвратОтПокупателя - возврат
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаВосстановленного
//
Функция ВосстановленоИсторическимВозвратом(Данные, Регистратор)

	Восстановлено = НоваяТаблицаВосстановленного();
	Отбор = Новый Структура(ИмяРегистратора(), Регистратор);
	Для Каждого Запись Из Данные.Партии.НайтиСтроки(Отбор) Цикл
		Строка = Восстановлено.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Запись);
		Строка.ДополнительныйРасход = Ложь;
	КонецЦикла;
	Для Каждого Запись Из Данные.Допрасходы.НайтиСтроки(Отбор) Цикл
		Строка = Восстановлено.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Запись);
		Строка.ДополнительныйРасход = Истина;
	КонецЦикла;
	Возврат Восстановлено;

КонецФункции

// Поправки к физическим записям регистратора и запись набора (Ф2.6 п. 3): по ключу цели (номенклатура,
// характеристика, партия) разница себестоимости и допрасходов Продажи с физическими записями - запись поправки;
// у ключа без физических записей (услуга, ручная запись) - нефизическая запись с себестоимостью цели. Запись
// без цели (физическая или компенсация) гасится поправкой: Продажи ее себестоимость не учитывали.
//
// Параметры:
//  Набор - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж - набор регистратора с физическими записями
//  Цели  - Массив из СтрокаТаблицыЗначений - записи Продажи регистратора; пустой - поправки не нужны
//  Итог  - Структура - счетчики (см. ПеренестиИсторию)
//
Процедура ЗаписатьПеренос(Набор, Цели, Итог)

	Физические = Набор.Выгрузить();
	Для Каждого Цель Из Цели Цикл
		Если Цель.Строка <> 0 Тогда
			ДобавитьЗаписьБезДетализации(Набор, Цель, Итог);
			Продолжить;
		КонецЕсли;
		Ключ = Новый Структура("Номенклатура, Характеристика", Цель.Номенклатура, Цель.Характеристика);
		Ключ.Вставить("Партия", Цель.Партия);
		Записи = Физические.НайтиСтроки(Ключ);
		Если Записи.Количество() = 0 Тогда
			ДобавитьЗаписьБезДетализации(Набор, Цель, Итог);
			Продолжить;
		КонецЕсли;
		Себестоимость = 0;
		Допрасходы = 0;
		Для Каждого Запись Из Записи Цикл
			Если Запись.ДополнительныйРасход Тогда
				Допрасходы = Допрасходы + Запись.Сумма;
			Иначе
				Себестоимость = Себестоимость + Запись.Сумма;
			КонецЕсли;
			Физические.Удалить(Запись);
		КонецЦикла;
		ДобавитьПоправку(Набор, Цель, Ложь, Цель.Себестоимость - Себестоимость, Итог);
		ДобавитьПоправку(Набор, Цель, Истина, Цель.ДополнительныеРасходы - Допрасходы, Итог);
	КонецЦикла;
	Если Цели.Количество() > 0 Тогда
		Для Каждого Запись Из Физические Цикл
			Поправка = Набор.Добавить();
			ЗаполнитьЗначенияСвойств(Поправка, Запись, , "Количество, Сумма, СуммаНДС, НомерСтроки, Регистратор");
			Поправка.Сумма = -Запись.Сумма;
			Поправка.Списание = Ложь;
			Поправка.Поправка = Истина;
			Итог.Поправок = Итог.Поправок + 1;
			Итог.СуммаПоправок = Итог.СуммаПоправок - Запись.Сумма;
		КонецЦикла;
	КонецЕсли;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	Итог.Регистраторов = Итог.Регистраторов + 1;
	Итог.Записей = Итог.Записей + Набор.Количество();

КонецПроцедуры

Процедура ДобавитьЗаписьБезДетализации(Набор, Цель, Итог)

	Если Цель.Себестоимость = 0 И Цель.ДополнительныеРасходы = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Цель.Себестоимость <> 0 Тогда
		Запись = НоваяЗаписьЦели(Набор, Цель, Ложь, Цель.Себестоимость);
		Запись.Количество = Цель.Количество;
	КонецЕсли;
	Если Цель.ДополнительныеРасходы <> 0 Тогда
		НоваяЗаписьЦели(Набор, Цель, Истина, Цель.ДополнительныеРасходы);
	КонецЕсли;
	Итог.БезДетализации = Итог.БезДетализации + 1;

КонецПроцедуры

Процедура ДобавитьПоправку(Набор, Цель, ДополнительныйРасход, Сумма, Итог)

	Если Сумма = 0 Тогда
		Возврат;
	КонецЕсли;
	Запись = НоваяЗаписьЦели(Набор, Цель, ДополнительныйРасход, Сумма);
	Запись.Поправка = Истина;
	Итог.Поправок = Итог.Поправок + 1;
	Итог.СуммаПоправок = Итог.СуммаПоправок + Сумма;

КонецПроцедуры

Функция НоваяЗаписьЦели(Набор, Цель, ДополнительныйРасход, Сумма)

	Запись = Набор.Добавить();
	ЗаполнитьЗначенияСвойств(Запись, Цель, , "Количество, НомерСтроки, Регистратор");
	Запись.НоменклатураПартии = Цель.Номенклатура;
	Запись.ДополнительныйРасход = ДополнительныйРасход;
	Запись.Сумма = Сумма;
	Запись.Списание = Ложь;
	Возврат Запись;

КонецФункции

Функция ТекстИзлишков(Излишки)

	Строки = Новый Массив;
	Шаблон = НСтр("ru = '%1: %2, партия %3 - отгружено %4, возвращено %5';
		|fr = '%1 : %2, lot %3 - expédié %4, retourné %5';
		|en = '%1: %2, batch %3 - shipped %4, returned %5';
		|es = '%1: %2, lote %3 - enviado %4, devuelto %5'");
	Для Каждого Строка Из Излишки Цикл
		ТекстСтроки = СтрШаблон(Шаблон, Строка[ИмяОснования()], Строка.Номенклатура, Строка.Партия, Строка.Отгружено,
			Строка.Возвращено);
		Строки.Добавить(ТекстСтроки);
	КонецЦикла;
	Заголовок = НСтр("ru = 'Перенос себестоимости продаж остановлен: возвраты восстановили партии реализации больше, чем
		|она отгрузила. Исправьте лишние возвраты на прежней версии (docs/RELEASING.md, «Перенос себестоимости продаж»):';
		|fr = 'Transfert du coût des ventes arrêté : les retours ont restitué plus de lots que la vente n''en a expédié.
		|Corrigez les retours en trop sur la version précédente (docs/RELEASING.md) :';
		|en = 'Cost of sales transfer stopped: returns restored more batches than the sale shipped. Fix the extra returns
		|on the previous version (docs/RELEASING.md):';
		|es = 'Traslado del costo de ventas detenido: las devoluciones restituyeron más lotes de los que la venta envió.
		|Corrija las devoluciones sobrantes en la versión anterior (docs/RELEASING.md):'");
	Возврат Заголовок + Символы.ПС + СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ТекстРасхождений(Расхождения)

	Строки = Новый Массив;
	Для Каждого Строка Из Расхождения Цикл
		ТекстСтроки = СтрШаблон("%1: %2 - %3 / %4", Строка[ИмяРегистратора()], Строка.Номенклатура,
			Строка.Себестоимость, Строка.ДополнительныеРасходы);
		Строки.Добавить(ТекстСтроки);
	КонецЦикла;
	Заголовок = НСтр("ru = 'Перенос себестоимости продаж: себестоимость не сошлась с регистром продаж (документ: товар -
		|разница себестоимости / допрасходов):'; fr = 'Transfert du coût des ventes : le coût ne correspond pas au registre
		|des ventes (document : article - écart coût / frais supplémentaires) :'; en = 'Cost of sales transfer: the cost
		|does not match the sales register (document: item - cost / additional cost difference):'; es = 'Traslado del
		|costo de ventas: el costo no coincide con el registro de ventas (documento: artículo - diferencia de costo /
		|gastos adicionales):'");
	Возврат Заголовок + Символы.ПС + СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Число записей Продажи, где хранимая валовая прибыль расходится с формулой, и сумма разницы - отчеты маржи после
// переноса показывают формулу (Ф2.6 п. 6).
//
// Параметры:
//  Итог         - Структура - заполняются ВнеФормулы и РазницаФормулы
//  Регистраторы - Массив из ДокументСсылка, Неопределено - отбор; Неопределено - все
//
Процедура ЗаполнитьРасхождениеФормулы(Итог, Регистраторы)

	ТекстОтбора = ТекстОтбораРегистраторов(Регистраторы);
	Запрос = Новый Запрос(ТекстОтбора +
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК ВнеФормулы,
	|	ЕСТЬNULL(СУММА(П.ВаловаяПрибыль - (П.Выручка - П.Себестоимость - П.ДополнительныеРасходы)), 0) КАК РазницаФормулы
	|ИЗ
	|	РегистрНакопления.Продажи КАК П
	|ГДЕ
	|	П.ВаловаяПрибыль <> П.Выручка - П.Себестоимость - П.ДополнительныеРасходы
	|	И П.Регистратор В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)");
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Итог.ВнеФормулы = Выборка.ВнеФормулы;
		Итог.РазницаФормулы = Выборка.РазницаФормулы;
	КонецЕсли;

КонецПроцедуры

Функция ИзмеренияРеализации(ДокОбъект)

	Измерения = Новый Структура;
	Измерения.Вставить("Период", ДокОбъект.Дата);
	Измерения.Вставить("ХозяйственнаяОперация", ДокОбъект.ХозяйственнаяОперация);
	Измерения.Вставить("Организация", ДокОбъект.Организация);
	Измерения.Вставить("Сотрудник", ДокОбъект.Менеджер);
	Измерения.Вставить("Контрагент", ДокОбъект.Контрагент);
	Измерения.Вставить("ДокументПродажи", ДокОбъект.Ссылка);
	Измерения.Вставить("Ответственный", ДокОбъект.Ответственный);
	Измерения.Вставить("МестоХранения", ДокОбъект.МестоХранения);
	Возврат Измерения;

КонецФункции

// Запись по записи списания склада: коммерческая номенклатура - комплект или сам товар, физическая - товар.
//
// Параметры:
//  Набор                - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж - набор
//  Измерения            - Структура - см. ИзмеренияРеализации
//  Запись               - РегистрНакопленияЗапись.ТоварыВНаличии, РегистрНакопленияЗапись.ДополнительныеРасходы - списание
//  ДополнительныйРасход - Булево - запись допрасхода
//
// Возвращаемое значение:
//  РегистрНакопленияЗапись.СебестоимостьПродаж
//
Функция НоваяЗаписьСписания(Набор, Измерения, Запись, ДополнительныйРасход)

	Новая = Набор.Добавить();
	ЗаполнитьЗначенияСвойств(Новая, Измерения);
	Новая.Номенклатура = ?(ЗначениеЗаполнено(Запись.Комплект), Запись.Комплект, Запись.Номенклатура);
	Новая.НоменклатураПартии = Запись.Номенклатура;
	Новая.Характеристика = Запись.Характеристика;
	Новая.Серия = Запись.Серия;
	Новая.Партия = Запись.Партия;
	Новая.СкладОтгрузки = Запись.МестоХранения;
	Новая.ДополнительныйРасход = ДополнительныйРасход;
	Новая.Сумма = Запись.Сумма;
	Новая.СуммаНДС = Запись.СуммаНДС;
	Если ДополнительныйРасход Тогда
		Новая.СтатьяДДС = Запись.СтатьяДДС;
	Иначе
		Новая.Количество = Запись.Количество;
		Новая.ДатаПартии = Запись.ДатаПартии;
	КонецЕсли;
	Новая.Списание = Истина;
	Возврат Новая;

КонецФункции

// Услуги реализации - себестоимость по закупочной цене среза на дату документа, как прежде в Продажи
// (цена без умножения на количество - TECHDEBT), партии нет, физическим списанием не является.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - реализация
//  Набор     - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж - набор
//  Измерения - Структура - см. ИзмеренияРеализации
//
Процедура ДобавитьСебестоимостьУслуг(ДокОбъект, Набор, Измерения)

	ТЗТовары = ДокОбъект.ТЧТовары.Выгрузить(, "Номенклатура, Характеристика, Количество");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Т.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(Т.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	|	ВЫРАЗИТЬ(Т.Количество КАК ЧИСЛО(15, 3)) КАК Количество
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&ТЗТовары КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	СУММА(Т.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТУслуги
	|ИЗ
	|	ВТТовары КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Т.Номенклатура = СправочникНоменклатура.Ссылка
	|			И (СправочникНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга))
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Номенклатура,
	|	Т.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Цены.Номенклатура КАК Номенклатура,
	|	Цены.Характеристика КАК Характеристика,
	|	Цены.Цена КАК Цена
	|ПОМЕСТИТЬ ВТЦены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Закупочная)
	|				И (Номенклатура, Характеристика) В
	|					(ВЫБРАТЬ
	|						У.Номенклатура КАК Номенклатура,
	|						У.Характеристика КАК Характеристика
	|					ИЗ
	|						ВТУслуги КАК У)) КАК Цены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.Номенклатура КАК Номенклатура,
	|	Услуги.Характеристика КАК Характеристика,
	|	Услуги.Количество КАК Количество,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена
	|ИЗ
	|	ВТУслуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК Цены
	|		ПО Услуги.Номенклатура = Цены.Номенклатура
	|			И Услуги.Характеристика = Цены.Характеристика");
	Запрос.УстановитьПараметр("ТЗТовары", ТЗТовары);
	Запрос.УстановитьПараметр("Период", ДокОбъект.Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Цена = 0 Тогда
			Продолжить;
		КонецЕсли;
		Новая = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Измерения);
		Новая.Номенклатура = Выборка.Номенклатура;
		Новая.НоменклатураПартии = Выборка.Номенклатура;
		Новая.Характеристика = Выборка.Характеристика;
		Новая.Количество = Выборка.Количество;
		Новая.Сумма = Выборка.Цена;
		Новая.ДокументОтгрузки = ДокОбъект.Ссылка;
		Новая.Списание = Ложь;
	КонецЦикла;

КонецПроцедуры

// Поля происхождения записи: физический ключ, коммерческая номенклатура, документ и строка отгрузки.
//
// Возвращаемое значение:
//  Строка
//
Функция ПоляПроисхождения()

	Возврат "Номенклатура, Характеристика, Серия, НоменклатураПартии, Партия, ДополнительныйРасход, СтатьяДДС, ДатаПартии, "
		+ "СкладОтгрузки, ДокументОтгрузки, КлючСтрокиОтгрузки";

КонецФункции

Функция ТекстЗаписейОснованияИВозвратов()

	// Пакет: [0] физические записи основания (у налогового документа - белые), [1] физические записи прежних
	// возвратов того же основания с моментом строго раньше текущего, [2] поправки основания и прежних возвратов.
	Возврат
	"ВЫБРАТЬ
	|	Возвраты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПрежниеВозвраты
	|ИЗ
	|	Документ.ВозвратОтПокупателя КАК Возвраты
	|ГДЕ
	|	Возвраты.Основание = &Основание
	|	И Возвраты.Проведен
	|	И Возвраты.Ссылка <> &Текущий
	|	И Возвраты.МоментВремени < &Момент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Т.Организация КАК Организация,
	|	Т.Сотрудник КАК Сотрудник,
	|	Т.Контрагент КАК Контрагент,
	|	Т.ДокументПродажи КАК ДокументПродажи,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Ответственный КАК Ответственный,
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.УУ КАК УУ,
	|	Т.Серия КАК Серия,
	|	Т.НоменклатураПартии КАК НоменклатураПартии,
	|	Т.Партия КАК Партия,
	|	Т.ДополнительныйРасход КАК ДополнительныйРасход,
	|	Т.СтатьяДДС КАК СтатьяДДС,
	|	Т.ДатаПартии КАК ДатаПартии,
	|	Т.СкладОтгрузки КАК СкладОтгрузки,
	|	Т.ДокументОтгрузки КАК ДокументОтгрузки,
	|	Т.КлючСтрокиОтгрузки КАК КлючСтрокиОтгрузки,
	|	Т.Количество КАК Количество,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(Отгрузки.МоментВремени, Т.МоментВремени) КАК МоментОтгрузки
	|ИЗ
