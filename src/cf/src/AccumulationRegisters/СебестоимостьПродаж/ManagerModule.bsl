// Цели переноса одного регистратора - записи Продажи (см. ДанныеПереноса).
//
// Параметры:
//  Данные      - Структура - см. ДанныеПереноса
//  Регистратор - ДокументСсылка - регистратор
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений
//
Функция ЦелиРегистратора(Данные, Регистратор)

	Отбор = Новый Структура(ИмяРегистратора(), Регистратор);
	Возврат Данные.Цели.НайтиСтроки(Отбор);

КонецФункции

// Ручная корректировка показывает в форме регистры своей таблицы: перенесенные записи себестоимости продаж видны и
// правятся, только если регистр в ней есть. Запись документа - без обработчиков, движения не перезаписываются.
//
// Параметры:
//  Регистратор - ДокументСсылка - регистратор прохода «прочие»
//
Процедура ДобавитьРегистрВКорректировку(Регистратор)

	Если ТипЗнч(Регистратор) <> Тип("ДокументСсылка.КорректировкаРегистров") Тогда
		Возврат;
	КонецЕсли;
	ДокОбъект = Регистратор.ПолучитьОбъект();
	ИмяРегистра = Метаданные.РегистрыНакопления.СебестоимостьПродаж.Имя;
	Если ДокОбъект.ТаблицаРегистров.Найти(ИмяРегистра, "Имя") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДокОбъект.ТаблицаРегистров.Добавить().Имя = ИмяРегистра;
	ДокОбъект.ОбменДанными.Загрузка = Истина;
	ДокОбъект.Записать();

КонецПроцедуры

Функция НаборРегистратора(Регистратор)

	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Возврат Набор;

КонецФункции

// Физическая детализация реализации: записи расхода склада и допрасходов с измерениями ее записей Продажи.
//
// Параметры:
//  Набор       - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж - набор реализации
//  Данные      - Структура - см. ДанныеПереноса
//  Регистратор - ДокументСсылка.РеализацияТоваровУслуг - реализация
//  Цели        - Массив из СтрокаТаблицыЗначений - ее записи Продажи
//
Процедура ДобавитьДетализацию(Набор, Данные, Регистратор, Цели)

	Если Цели.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура(ИмяРегистратора(), Регистратор);
	Для Каждого Запись Из Данные.Партии.НайтиСтроки(Отбор) Цикл
		ДобавитьЗаписьДетализации(Набор, Цели[0], Запись, Ложь);
	КонецЦикла;
	Для Каждого Запись Из Данные.Допрасходы.НайтиСтроки(Отбор) Цикл
		ДобавитьЗаписьДетализации(Набор, Цели[0], Запись, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЗаписьДетализации(Набор, Цель, Запись, ДополнительныйРасход)

	Новая = Набор.Добавить();
	ЗаполнитьЗначенияСвойств(Новая, Цель, , "Номенклатура, Характеристика, Партия, Количество, НомерСтроки, Регистратор");
	Новая.Номенклатура = ?(ЗначениеЗаполнено(Запись.Комплект), Запись.Комплект, Запись.Номенклатура);
	Новая.НоменклатураПартии = Запись.Номенклатура;
	Новая.Характеристика = Запись.Характеристика;
	Новая.Серия = Запись.Серия;
	Новая.Партия = Запись.Партия;
	Новая.СкладОтгрузки = Запись.МестоХранения;
	Новая.ДокументОтгрузки = Запись.Регистратор;
	Новая.ДополнительныйРасход = ДополнительныйРасход;
	Новая.Сумма = Запись.Сумма;
	Новая.СуммаНДС = Запись.СуммаНДС;
	Если ДополнительныйРасход Тогда
		Новая.СтатьяДДС = Запись.СтатьяДДС;
	Иначе
		Новая.Количество = Запись.Количество;
		Новая.ДатаПартии = Запись.ДатаПартии;
	КонецЕсли;
	Новая.Списание = Истина;

КонецПроцедуры

// Части, восстановленные историческим возвратом: его фактические приходы партиями оснований и допрасходов.
//
// Параметры:
//  Данные      - Структура - см. ДанныеПереноса
//  Регистратор - ДокументСсылка.ВозвратОтПокупателя - возврат
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаВосстановленного
//
Функция ВосстановленоИсторическимВозвратом(Данные, Регистратор)

	Восстановлено = НоваяТаблицаВосстановленного();
	Отбор = Новый Структура(ИмяРегистратора(), Регистратор);
	Для Каждого Запись Из Данные.Партии.НайтиСтроки(Отбор) Цикл
		Строка = Восстановлено.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Запись);
		Строка.ДополнительныйРасход = Ложь;
	КонецЦикла;
	Для Каждого Запись Из Данные.Допрасходы.НайтиСтроки(Отбор) Цикл
		Строка = Восстановлено.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Запись);
		Строка.ДополнительныйРасход = Истина;
	КонецЦикла;
	Возврат Восстановлено;

КонецФункции

// Поправки к физическим записям регистратора и запись набора (Ф2.6 п. 3): по ключу цели (номенклатура,
// характеристика, партия) разница себестоимости и допрасходов Продажи с физическими записями - запись поправки;
// у ключа без физических записей (услуга, ручная запись) - нефизическая запись с себестоимостью цели. Запись
// без цели (физическая или компенсация) гасится поправкой: Продажи ее себестоимость не учитывали.
//
// Параметры:
//  Набор - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж - набор регистратора с физическими записями
//  Цели  - Массив из СтрокаТаблицыЗначений - записи Продажи регистратора; пустой - поправки не нужны
//  Итог  - Структура - счетчики (см. ПеренестиИсторию)
//
Процедура ЗаписатьПеренос(Набор, Цели, Итог)

	Физические = Набор.Выгрузить();
	Для Каждого Цель Из Цели Цикл
		Если Цель.Строка <> 0 Тогда
			ДобавитьЗаписьБезДетализации(Набор, Цель, Итог);
			Продолжить;
		КонецЕсли;
		Ключ = Новый Структура("Номенклатура, Характеристика", Цель.Номенклатура, Цель.Характеристика);
		Ключ.Вставить("Партия", Цель.Партия);
		Записи = Физические.НайтиСтроки(Ключ);
		Если Записи.Количество() = 0 Тогда
			ДобавитьЗаписьБезДетализации(Набор, Цель, Итог);
			Продолжить;
		КонецЕсли;
		Себестоимость = 0;
		Допрасходы = 0;
		Для Каждого Запись Из Записи Цикл
			Если Запись.ДополнительныйРасход Тогда
				Допрасходы = Допрасходы + Запись.Сумма;
			Иначе
				Себестоимость = Себестоимость + Запись.Сумма;
			КонецЕсли;
			Физические.Удалить(Запись);
		КонецЦикла;
		ДобавитьПоправку(Набор, Цель, Ложь, Цель.Себестоимость - Себестоимость, Итог);
		ДобавитьПоправку(Набор, Цель, Истина, Цель.ДополнительныеРасходы - Допрасходы, Итог);
	КонецЦикла;
	Если Цели.Количество() > 0 Тогда
		Для Каждого Запись Из Физические Цикл
			Поправка = Набор.Добавить();
			ЗаполнитьЗначенияСвойств(Поправка, Запись, , "Количество, Сумма, СуммаНДС, НомерСтроки, Регистратор");
			Поправка.Сумма = -Запись.Сумма;
			Поправка.Списание = Ложь;
			Поправка.Поправка = Истина;
			Итог.Поправок = Итог.Поправок + 1;
			Итог.СуммаПоправок = Итог.СуммаПоправок - Запись.Сумма;
		КонецЦикла;
	КонецЕсли;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	Итог.Регистраторов = Итог.Регистраторов + 1;
	Итог.Записей = Итог.Записей + Набор.Количество();

КонецПроцедуры

Процедура ДобавитьЗаписьБезДетализации(Набор, Цель, Итог)

	Если Цель.Себестоимость = 0 И Цель.ДополнительныеРасходы = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Цель.Себестоимость <> 0 Тогда
		Запись = НоваяЗаписьЦели(Набор, Цель, Ложь, Цель.Себестоимость);
		Запись.Количество = Цель.Количество;
	КонецЕсли;
	Если Цель.ДополнительныеРасходы <> 0 Тогда
		НоваяЗаписьЦели(Набор, Цель, Истина, Цель.ДополнительныеРасходы);
	КонецЕсли;
	Итог.БезДетализации = Итог.БезДетализации + 1;

КонецПроцедуры

Процедура ДобавитьПоправку(Набор, Цель, ДополнительныйРасход, Сумма, Итог)

	Если Сумма = 0 Тогда
		Возврат;
	КонецЕсли;
	Запись = НоваяЗаписьЦели(Набор, Цель, ДополнительныйРасход, Сумма);
	Запись.Поправка = Истина;
	Итог.Поправок = Итог.Поправок + 1;
	Итог.СуммаПоправок = Итог.СуммаПоправок + Сумма;

КонецПроцедуры

Функция НоваяЗаписьЦели(Набор, Цель, ДополнительныйРасход, Сумма)

	Запись = Набор.Добавить();
	ЗаполнитьЗначенияСвойств(Запись, Цель, , "Количество, НомерСтроки, Регистратор");
	Запись.НоменклатураПартии = Цель.Номенклатура;
	Запись.ДополнительныйРасход = ДополнительныйРасход;
	Запись.Сумма = Сумма;
	Запись.Списание = Ложь;
	Возврат Запись;

КонецФункции

Процедура ПроверитьРасхожденияПереноса(Итог, Регистраторы, ДопуститьРасхождения)

	Расхождения = РасхожденияПереноса(Регистраторы);
	Итог.Вставить("Расхождений", Расхождения.Количество());
	Если Расхождения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Не ДопуститьРасхождения Тогда
		ВызватьИсключение ТекстРасхождений(Расхождения);
	КонецЕсли;
	ЗаписьЖурналаРегистрации(ОбновлениеПрограммы.ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
		ТекстРасхождений(Расхождения));

КонецПроцедуры

Функция ТекстИзлишков(Излишки)

	Строки = Новый Массив;
	Шаблон = НСтр("ru = '%1: %2, партия %3 - отгружено %4, возвращено %5';
		|fr = '%1 : %2, lot %3 - expédié %4, retourné %5';
		|en = '%1: %2, batch %3 - shipped %4, returned %5';
		|es = '%1: %2, lote %3 - enviado %4, devuelto %5'");
	Для Каждого Строка Из Излишки Цикл
		ТекстСтроки = СтрШаблон(Шаблон, Строка[ИмяОснования()], Строка.Номенклатура, Строка.Партия, Строка.Отгружено,
			Строка.Возвращено);
		Строки.Добавить(ТекстСтроки);
	КонецЦикла;
	Заголовок = НСтр("ru = 'Себестоимость продаж перенесена с излишком возвратов: возвраты восстановили партии реализации
		|больше, чем она отгрузила. Новый возврат по этим реализациям не найдёт остатка партии (docs/RELEASING.md):';
		|fr = 'Coût des ventes transféré avec des retours en excès : les retours ont restitué plus de lots que la vente
		|n''en a expédié. Un nouveau retour sur ces ventes ne trouvera pas de reste de lot (docs/RELEASING.md) :';
		|en = 'Cost of sales transferred with excess returns: returns restored more batches than the sale shipped. A new
		|return against these sales will find no batch balance (docs/RELEASING.md):';
		|es = 'Costo de ventas trasladado con devoluciones en exceso: las devoluciones restituyeron más lotes de los que la
		|venta envió. Una nueva devolución de estas ventas no encontrará saldo de lote (docs/RELEASING.md):'");
	Возврат Заголовок + Символы.ПС + СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ТекстРасхождений(Расхождения)

	Строки = Новый Массив;
	Для Каждого Строка Из Расхождения Цикл
		ТекстСтроки = СтрШаблон("%1: %2 - %3 / %4", Строка[ИмяРегистратора()], Строка.Номенклатура,
			Строка.Себестоимость, Строка.ДополнительныеРасходы);
		Строки.Добавить(ТекстСтроки);
	КонецЦикла;
	Заголовок = НСтр("ru = 'Перенос себестоимости продаж: себестоимость не сошлась с регистром продаж (документ: товар -
		|разница себестоимости / допрасходов):'; fr = 'Transfert du coût des ventes : le coût ne correspond pas au registre
		|des ventes (document : article - écart coût / frais supplémentaires) :'; en = 'Cost of sales transfer: the cost
		|does not match the sales register (document: item - cost / additional cost difference):'; es = 'Traslado del
		|costo de ventas: el costo no coincide con el registro de ventas (documento: artículo - diferencia de costo /
		|gastos adicionales):'");
	Возврат Заголовок + Символы.ПС + СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Число записей Продажи, где хранимая валовая прибыль расходится с формулой, и сумма разницы - отчеты маржи после
// переноса показывают формулу (Ф2.6 п. 6).
//
// Параметры:
//  Итог         - Структура - заполняются ВнеФормулы и РазницаФормулы
//  Регистраторы - Массив из ДокументСсылка, Неопределено - отбор; Неопределено - все
//
Процедура ЗаполнитьРасхождениеФормулы(Итог, Регистраторы)

	ТекстОтбора = ТекстОтбораРегистраторов(Регистраторы);
	Запрос = Новый Запрос(ТекстОтбора +
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК ВнеФормулы,
	|	ЕСТЬNULL(СУММА(П.ВаловаяПрибыль - (П.Выручка - П.Себестоимость - П.ДополнительныеРасходы)), 0) КАК РазницаФормулы
	|ИЗ
	|	РегистрНакопления.Продажи КАК П
	|ГДЕ
	|	П.ВаловаяПрибыль <> П.Выручка - П.Себестоимость - П.ДополнительныеРасходы
	|	И П.Регистратор В
	|			(ВЫБРАТЬ
	|				Отбор.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТОтбор КАК Отбор)");
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Итог.ВнеФормулы = Выборка.ВнеФормулы;
		Итог.РазницаФормулы = Выборка.РазницаФормулы;
	КонецЕсли;

КонецПроцедуры

Функция Ссылка(ДокОбъект)

	Возврат ?(ДокОбъект = Неопределено, Неопределено, ДокОбъект.Ссылка);

КонецФункции

Функция КлючСтрокиОрдера(Ордер, КодСтроки)

	Возврат Строка(Ордер.УникальныйИдентификатор()) + "/" + Формат(КодСтроки, "ЧГ=0");

КонецФункции

// Куски списания строк расходных ордеров по парам (Ф3.6): матрица «записи списания × пары» по каждой строке и
// физической позиции, стоимость и допрасходы кусков.
//
// Параметры:
//  Пары   - Массив из СтрокаТаблицыЗначений - пары реализаций на затронутых строках (см. ТоварыКОформлению.ПарыОформления)
//  Ордера - Массив из ДокументСсылка.РасходныйОрдер - ордера
//  Ключи  - Соответствие - ключи затронутых строк
//
// Возвращаемое значение:
//  ТаблицаЗначений - Реализация, Ордер, КодСтроки, ДополнительныйРасход, МестоХранения, Номенклатура (коммерческая),
//                    НоменклатураПартии, Характеристика, Серия, Партия, ДатаПартии, СтатьяДДС, Количество, Сумма,
//                    СуммаНДС; в порядке пар, затем записей
//
Функция КускиПар(Пары, Ордера, Ключи)

	Куски = НоваяТаблицаКусков();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Строки.Ссылка КАК Ордер,
	|	Строки.КодСтроки КАК КодСтроки,
	|	Строки.Номенклатура КАК Номенклатура,
	|	Строки.Количество КАК Количество
	|ИЗ
	|	Документ.РасходныйОрдер.ТЧТовары КАК Строки
	|ГДЕ
	|	Строки.Ссылка В (&Ордера)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Регистратор КАК Ордер,
	|	Т.КодСтроки КАК КодСтроки,
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Серия КАК Серия,
	|	Т.Партия КАК Партия,
	|	Т.ДатаПартии КАК ДатаПартии,
	|	Т.Количество КАК Количество,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|ГДЕ
	|	Т.Регистратор В (&Ордера)
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Т.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Регистратор КАК Ордер,
	|	Т.КодСтроки КАК КодСтроки,
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Серия КАК Серия,
	|	Т.Партия КАК Партия,
	|	Т.СтатьяДДС КАК СтатьяДДС,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	РегистрНакопления.ДополнительныеРасходы КАК Т
	|ГДЕ
	|	Т.Регистратор В (&Ордера)
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Т.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки");
	Запрос.УстановитьПараметр("Ордера", Ордера);
	Результаты = Запрос.ВыполнитьПакет();
	Записи = Результаты[1].Выгрузить();
	Допрасходы = Результаты[2].Выгрузить();
	Для Каждого СтрокаОрдера Из Результаты[0].Выгрузить() Цикл
		Если Ключи[КлючСтрокиОрдера(СтрокаОрдера.Ордер, СтрокаОрдера.КодСтроки)] = Неопределено
			Или СтрокаОрдера.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПарыСтроки = ПарыСтрокиОрдера(Пары, СтрокаОрдера);
		Если ПарыСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЗаписиСтроки = Записи.НайтиСтроки(Новый Структура("Ордер, КодСтроки", СтрокаОрдера.Ордер, СтрокаОрдера.КодСтроки));
		Для Каждого ЗаписиПозиции Из ЗаписиПоПозициям(ЗаписиСтроки) Цикл
			ДобавитьКускиПозиции(Куски, СтрокаОрдера, ПарыСтроки, ЗаписиПозиции, Допрасходы);
		КонецЦикла;
	КонецЦикла;
	Возврат Куски;

КонецФункции

// Пары строки расходного ордера в порядке пар: момент реализации, код её строки (документ первый - все пары строки
// ордера у одного регистратора, порядок - по реализации, Ф4.6).
//
// Параметры:
//  Пары         - Массив из СтрокаТаблицыЗначений - пары затронутых строк
//  СтрокаОрдера - СтрокаТаблицыЗначений - Ордер, КодСтроки
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений
//
Функция ПарыСтрокиОрдера(Пары, СтрокаОрдера)

	Результат = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Если Пара.Ордер <> СтрокаОрдера.Ордер Или Пара.КодСтрокиОрдера <> СтрокаОрдера.КодСтроки Тогда
			Продолжить;
		КонецЕсли;
		Индекс = 0;
		Пока Индекс < Результат.Количество() И Не ПараРаньше(Пара, Результат[Индекс]) Цикл
			Индекс = Индекс + 1;
		КонецЦикла;
		Результат.Вставить(Индекс, Пара);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПараРаньше(Пара, Другая)

	Сравнение = Пара.МоментДокумента.Сравнить(Другая.МоментДокумента);
	Возврат Сравнение < 0 Или Сравнение = 0 И Пара.КодСтрокиДокумента < Другая.КодСтрокиДокумента;

КонецФункции

// Записи списания строки, сгруппированные по физической позиции (номенклатура или составляющая комплекта) в порядке
// списания.
//
// Параметры:
//  ЗаписиСтроки - Массив из СтрокаТаблицыЗначений - записи списания строки
//
// Возвращаемое значение:
//  Массив из Массив - записи каждой позиции
//
Функция ЗаписиПоПозициям(ЗаписиСтроки)

	Позиции = Новый Соответствие;
	Результат = Новый Массив;
	Для Каждого Запись Из ЗаписиСтроки Цикл
		ЗаписиПозиции = Позиции[Запись.Номенклатура];
		Если ЗаписиПозиции = Неопределено Тогда
			ЗаписиПозиции = Новый Массив;
			Позиции.Вставить(Запись.Номенклатура, ЗаписиПозиции);
			Результат.Добавить(ЗаписиПозиции);
		КонецЕсли;
		ЗаписиПозиции.Добавить(Запись);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Куски одной физической позиции строки (Ф3.6): столбцы пар - наибольшими остатками от оформленного количества позиции,
// матрица - последовательно (пары по порядку забирают записи по порядку списания), стоимость и допрасходы записи - по
// кускам пропорционально количеству.
//
// Параметры:
//  Куски         - ТаблицаЗначений - см. КускиПар; дополняется
//  СтрокаОрдера  - СтрокаТаблицыЗначений - Ордер, КодСтроки, Номенклатура, Количество
//  ПарыСтроки    - Массив - пары строки в порядке реализаций
//  ЗаписиПозиции - Массив - записи списания позиции в порядке списания
//  Допрасходы    - ТаблицаЗначений - записи допрасходов ордеров
//
Процедура ДобавитьКускиПозиции(Куски, СтрокаОрдера, ПарыСтроки, ЗаписиПозиции, Допрасходы)

	Матрица = МатрицаПозиции(СтрокаОрдера, ПарыСтроки, ЗаписиПозиции);
	Для Индекс = 0 По ЗаписиПозиции.ВГраница() Цикл
		КускиЗаписи = Матрица[Индекс];
		Если КускиЗаписи.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запись = ЗаписиПозиции[Индекс];
		Количества = Новый Массив;
		Взято = 0;
		Для Каждого Кусок Из КускиЗаписи Цикл
			Количества.Добавить(Кусок.Количество);
			Взято = Взято + Кусок.Количество;
		КонецЦикла;
		ДобавитьКускиЗаписи(Куски, СтрокаОрдера, Запись, КускиЗаписи, Количества, Взято);
		ОтборДопрасходов = Новый Структура("Ордер, КодСтроки, МестоХранения, Номенклатура, Характеристика, Серия, Партия");
		ЗаполнитьЗначенияСвойств(ОтборДопрасходов, Запись);
		Для Каждого Допрасход Из Допрасходы.НайтиСтроки(ОтборДопрасходов) Цикл
			ДобавитьКускиЗаписи(Куски, СтрокаОрдера, Запись, КускиЗаписи, Количества, Взято, Допрасход);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Матрица «записи × пары» позиции: на каждую запись - массив кусков (Пара, Количество).
//
// Параметры:
//  СтрокаОрдера  - СтрокаТаблицыЗначений - Количество строки
//  ПарыСтроки    - Массив - пары строки
//  ЗаписиПозиции - Массив - записи позиции
//
// Возвращаемое значение:
//  Массив из Массив из Структура
//
Функция МатрицаПозиции(СтрокаОрдера, ПарыСтроки, ЗаписиПозиции)

	РазрядностьКоличества = 6;
	Всего = 0;
	Остатки = Новый Массив;
	Матрица = Новый Массив;
	Для Каждого Запись Из ЗаписиПозиции Цикл
		Всего = Всего + Запись.Количество;
		Остатки.Добавить(Запись.Количество);
		Матрица.Добавить(Новый Массив);
	КонецЦикла;
	Оформлено = 0;
	Базы = Новый Массив;
	Для Каждого Пара Из ПарыСтроки Цикл
		Базы.Добавить(Пара.Количество);
		Оформлено = Оформлено + Пара.Количество;
	КонецЦикла;
	ОформленоПозиции = Окр(Всего * Мин(Оформлено, СтрокаОрдера.Количество) / СтрокаОрдера.Количество,
		РазрядностьКоличества);
	Столбцы = РаспределитьПропорционально(Базы, ОформленоПозиции, РазрядностьКоличества);
	ИндексЗаписи = 0;
	Для ИндексПары = 0 По ПарыСтроки.ВГраница() Цикл
		Нужно = Столбцы[ИндексПары];
		Пока Нужно > 0 И ИндексЗаписи <= ЗаписиПозиции.ВГраница() Цикл
			Взять = Мин(Нужно, Остатки[ИндексЗаписи]);
			Если Взять > 0 Тогда
				Матрица[ИндексЗаписи].Добавить(Новый Структура("Пара, Количество", ПарыСтроки[ИндексПары], Взять));
				Остатки[ИндексЗаписи] = Остатки[ИндексЗаписи] - Взять;
				Нужно = Нужно - Взять;
			КонецЕсли;
			Если Остатки[ИндексЗаписи] <= 0 Тогда
				ИндексЗаписи = ИндексЗаписи + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Матрица;

КонецФункции

// Куски записи списания (или её допрасхода): оформленная часть записи - вся запись, если взята целиком, иначе доля
// по количеству; делится между кусками пропорционально их количеству наибольшими остатками.
//
// Параметры:
//  Куски        - ТаблицаЗначений - дополняется
//  СтрокаОрдера - СтрокаТаблицыЗначений - строка ордера
//  Запись       - СтрокаТаблицыЗначений - запись списания
//  КускиЗаписи  - Массив - куски записи (Пара, Количество)
//  Количества   - Массив из Число - количества кусков
//  Взято        - Число - сумма количеств кусков
//  Допрасход    - СтрокаТаблицыЗначений, Неопределено - допрасход записи (СтатьяДДС, Сумма, СуммаНДС); Неопределено -
//                 сама запись
//
Процедура ДобавитьКускиЗаписи(Куски, СтрокаОрдера, Запись, КускиЗаписи, Количества, Взято, Допрасход = Неопределено)

	ЭтоДопрасход = Допрасход <> Неопределено;
	Источник = ?(ЭтоДопрасход, Допрасход, Запись);
	Суммы = РаспределитьПропорционально(Количества, ДоляЗаписи(Источник.Сумма, Взято, Запись.Количество));
	НДС = РаспределитьПропорционально(Количества, ДоляЗаписи(Источник.СуммаНДС, Взято, Запись.Количество));
	Для Индекс = 0 По КускиЗаписи.ВГраница() Цикл
		Часть = НовыйКусок(Куски, КускиЗаписи[Индекс].Пара, СтрокаОрдера, Запись);
		Часть.ДополнительныйРасход = ЭтоДопрасход;
		Часть.Сумма = Суммы[Индекс];
		Часть.СуммаНДС = НДС[Индекс];
		Если ЭтоДопрасход Тогда
			Часть.СтатьяДДС = Допрасход.СтатьяДДС;
		Иначе
			Часть.Количество = КускиЗаписи[Индекс].Количество;
			Часть.ДатаПартии = Запись.ДатаПартии;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ДоляЗаписи(Значение, Взято, Количество)

	Если Взято = Количество Или Количество = 0 Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Окр(Значение * Взято / Количество, РазрядностьСуммы());

КонецФункции

Функция НовыйКусок(Куски, Пара, СтрокаОрдера, Запись)

	Часть = Куски.Добавить();
	Часть.Реализация = Пара.Документ;
	Часть.Ордер = СтрокаОрдера.Ордер;
	Часть.КодСтроки = СтрокаОрдера.КодСтроки;
	Часть.Номенклатура = СтрокаОрдера.Номенклатура;
	Часть.НоменклатураПартии = Запись.Номенклатура;
	ЗаполнитьЗначенияСвойств(Часть, Запись, "МестоХранения, Характеристика, Серия, Партия");
	Возврат Часть;

КонецФункции

Функция НоваяТаблицаКусков()

	Куски = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Реализация,Ордер,КодСтроки,ДополнительныйРасход,МестоХранения,Номенклатура,"
		+ "НоменклатураПартии,Характеристика,Серия,Партия,ДатаПартии,СтатьяДДС", ",") Цикл
		Куски.Колонки.Добавить(Имя);
	КонецЦикла;
	Куски.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Куски.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	Куски.Колонки.Добавить("СуммаНДС", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	Возврат Куски;

КонецФункции

// Набор себестоимости реализации: записи с отгрузкой по затронутым строкам заменяются кусками пар, прочие сохраняются;
// пишется, только если изменился.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - реализация
//  Куски      - ТаблицаЗначений - см. КускиПар
//  Ключи      - Соответствие - ключи затронутых строк
//
// Возвращаемое значение:
//  Булево - набор изменён и записан
//
Функция ЗаписатьСебестоимостьПоПарам(Реализация, Куски, Ключи)

	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Реализация);
	Набор.Прочитать();
	Прежние = Набор.Выгрузить();
	Новые = Прежние.СкопироватьКолонки();
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Реализация,
		"Дата, ХозяйственнаяОперация, Организация, Менеджер, Контрагент, Ответственный, МестоХранения, УУ");
	Измерения = Новый Структура;
	Измерения.Вставить("Период", Реквизиты.Дата);
	Измерения.Вставить("ХозяйственнаяОперация", Реквизиты.ХозяйственнаяОперация);
	Измерения.Вставить("Организация", Реквизиты.Организация);
	Измерения.Вставить("Сотрудник", Реквизиты.Менеджер);
	Измерения.Вставить("Контрагент", Реквизиты.Контрагент);
	Измерения.Вставить("ДокументПродажи", Реализация);
	Измерения.Вставить("Ответственный", Реквизиты.Ответственный);
	Измерения.Вставить("МестоХранения", Реквизиты.МестоХранения);
	Измерения.Вставить("УУ", НалоговыйУчет.РаздельныйУчетВключен() И Реквизиты.УУ = Истина);
	Измерения.Вставить("Активность", Истина);
	// Списание самой реализации на ордерном складе - запись до 2.0.16.122: её заменяют куски пар, а её свои допрасходы,
	// списанные тогда вместе с партиями, - нефизические записи, как у проведённой заново (Ф3.15, Ф3.6).
	СвоеСписаниеСтарое = Справочники.МестаХранения.ОрдерныйСклад(Реквизиты.МестоХранения, Реквизиты.Дата);
	СнятоСвоих = ПеренестиНезаменяемые(Прежние, Новые, Ключи, ?(СвоеСписаниеСтарое, Реализация, Неопределено));
	Если СнятоСвоих > 0 И Новые.НайтиСтроки(Новый Структура("ДокументОтгрузки, Списание", Реализация, Ложь)).Количество() = 0 Тогда
		ДобавитьСвоиДопрасходыОрдерногоСклада(Реализация.ПолучитьОбъект(), Новые, Измерения);
	КонецЕсли;
	КускиРеализации = Куски.НайтиСтроки(Новый Структура("Реализация", Реализация));
	Если КускиРеализации.Количество() > 0 Тогда
		Для Каждого Кусок Из КускиРеализации Цикл
			Новая = Новые.Добавить();
			ЗаполнитьЗначенияСвойств(Новая, Измерения);
			Новая.Активность = Истина;
			Новая.Номенклатура = Кусок.Номенклатура;
			Новая.НоменклатураПартии = Кусок.НоменклатураПартии;
			Новая.Характеристика = Кусок.Характеристика;
			Новая.Серия = Кусок.Серия;
			Новая.Партия = Кусок.Партия;
			Новая.СкладОтгрузки = Кусок.МестоХранения;
			Новая.ДополнительныйРасход = Кусок.ДополнительныйРасход = Истина;
			Новая.Сумма = Кусок.Сумма;
			Новая.СуммаНДС = Кусок.СуммаНДС;
			Если Новая.ДополнительныйРасход Тогда
				Новая.СтатьяДДС = Кусок.СтатьяДДС;
			Иначе
				Новая.Количество = Кусок.Количество;
				Новая.ДатаПартии = Кусок.ДатаПартии;
			КонецЕсли;
			Новая.ДокументОтгрузки = Кусок.Ордер;
			Новая.КлючСтрокиОтгрузки = Кусок.КодСтроки;
			Новая.Списание = Истина;
		КонецЦикла;
	КонецЕсли;
	Если НаборыРавны(Прежние, Новые) Тогда
		Возврат Ложь;
	КонецЕсли;
	Набор.Загрузить(Новые);
	Набор.Записать(Истина);
	Возврат Истина;

КонецФункции

// Равенство двух выгрузок набора без учёта порядка записей: по всем колонкам, кроме номера строки и регистратора.
//
// Параметры:
//  Первая - ТаблицаЗначений
//  Вторая - ТаблицаЗначений
//
// Возвращаемое значение:
//  Булево
//
Функция НаборыРавны(Первая, Вторая) Экспорт

	Если Первая.Количество() <> Вторая.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрокиНабора(Первая) = СтрокиНабора(Вторая);

КонецФункции

Функция СтрокиНабора(Таблица)

	Строки = Новый Массив;
	Для Каждого Запись Из Таблица Цикл
		Значения = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Если Колонка.Имя = "НомерСтроки" Или Колонка.Имя = "Регистратор" Тогда
				Продолжить;
			КонецЕсли;
			Значения.Добавить(ЗначениеВСтрокуВнутр(Запись[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Значения, Символы.ПС));
	КонецЦикла;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Строки);
	Список.СортироватьПоЗначению();
	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), Символы.ВК);

КонецФункции

// Самый ранний проведённый возврат изменённых реализаций (Редакция 11).
//
// Параметры:
//  Реализации - Массив из ДокументСсылка.РеализацияТоваровУслуг
//
// Возвращаемое значение:
//  Структура, Неопределено - Дата самого раннего возврата; Неопределено - возвратов нет
//
Функция РанниеВозвраты(Реализации)

	Если Реализации.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Возвраты.Дата КАК Дата
	|ИЗ
	|	Документ.ВозвратОтПокупателя КАК Возвраты
	|ГДЕ
	|	Возвраты.Основание В (&Реализации)
	|	И Возвраты.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Возвраты.МоментВремени");
	Запрос.УстановитьПараметр("Реализации", Реализации);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Дата", Выборка.Дата);

КонецФункции

Функция ИзмеренияРеализации(ДокОбъект)

	Измерения = Новый Структура;
	Измерения.Вставить("Период", ДокОбъект.Дата);
	Измерения.Вставить("ХозяйственнаяОперация", ДокОбъект.ХозяйственнаяОперация);
	Измерения.Вставить("Организация", ДокОбъект.Организация);
	Измерения.Вставить("Сотрудник", ДокОбъект.Менеджер);
	Измерения.Вставить("Контрагент", ДокОбъект.Контрагент);
	Измерения.Вставить("ДокументПродажи", ДокОбъект.Ссылка);
	Измерения.Вставить("Ответственный", ДокОбъект.Ответственный);
	Измерения.Вставить("МестоХранения", ДокОбъект.МестоХранения);
	Возврат Измерения;

КонецФункции

// Запись по записи списания склада: коммерческая номенклатура - комплект или сам товар, физическая - товар.
//
// Параметры:
//  Набор                - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж - набор
//  Измерения            - Структура - см. ИзмеренияРеализации
//  Запись               - РегистрНакопленияЗапись.ТоварыВНаличии, РегистрНакопленияЗапись.ДополнительныеРасходы - списание
//  ДополнительныйРасход - Булево - запись допрасхода
//
// Возвращаемое значение:
//  РегистрНакопленияЗапись.СебестоимостьПродаж
//
Функция НоваяЗаписьСписания(Набор, Измерения, Запись, ДополнительныйРасход)

	Новая = Набор.Добавить();
	ЗаполнитьЗначенияСвойств(Новая, Измерения);
	Новая.Номенклатура = ?(ЗначениеЗаполнено(Запись.Комплект), Запись.Комплект, Запись.Номенклатура);
	Новая.НоменклатураПартии = Запись.Номенклатура;
	Новая.Характеристика = Запись.Характеристика;
	Новая.Серия = Запись.Серия;
	Новая.Партия = Запись.Партия;
	Новая.СкладОтгрузки = Запись.МестоХранения;
	Новая.ДополнительныйРасход = ДополнительныйРасход;
	Новая.Сумма = Запись.Сумма;
	Новая.СуммаНДС = Запись.СуммаНДС;
	Если ДополнительныйРасход Тогда
		Новая.СтатьяДДС = Запись.СтатьяДДС;
	Иначе
		Новая.Количество = Запись.Количество;
		Новая.ДатаПартии = Запись.ДатаПартии;
	КонецЕсли;
	Новая.Списание = Истина;
	Возврат Новая;

КонецФункции

// Услуги реализации - себестоимость по закупочной цене среза на дату документа, как прежде в Продажи
// (цена без умножения на количество - TECHDEBT), партии нет, физическим списанием не является.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - реализация
//  Набор     - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж - набор
//  Измерения - Структура - см. ИзмеренияРеализации
//
Процедура ДобавитьСебестоимостьУслуг(ДокОбъект, Набор, Измерения)

	ТЗТовары = ДокОбъект.ТЧТовары.Выгрузить(, "Номенклатура, Характеристика, Количество");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Т.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(Т.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	|	ВЫРАЗИТЬ(Т.Количество КАК ЧИСЛО(15, 3)) КАК Количество
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&ТЗТовары КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	СУММА(Т.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТУслуги
	|ИЗ
	|	ВТТовары КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Т.Номенклатура = СправочникНоменклатура.Ссылка
	|			И (СправочникНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга))
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Номенклатура,
	|	Т.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Цены.Номенклатура КАК Номенклатура,
	|	Цены.Характеристика КАК Характеристика,
	|	Цены.Цена КАК Цена
	|ПОМЕСТИТЬ ВТЦены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Закупочная)
	|				И (Номенклатура, Характеристика) В
	|					(ВЫБРАТЬ
	|						У.Номенклатура КАК Номенклатура,
	|						У.Характеристика КАК Характеристика
	|					ИЗ
	|						ВТУслуги КАК У)) КАК Цены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.Номенклатура КАК Номенклатура,
	|	Услуги.Характеристика КАК Характеристика,
	|	Услуги.Количество КАК Количество,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена
	|ИЗ
	|	ВТУслуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК Цены
	|		ПО Услуги.Номенклатура = Цены.Номенклатура
	|			И Услуги.Характеристика = Цены.Характеристика");
	Запрос.УстановитьПараметр("ТЗТовары", ТЗТовары);
	Запрос.УстановитьПараметр("Период", ДокОбъект.Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Цена = 0 Тогда
			Продолжить;
		КонецЕсли;
		Новая = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Измерения);
		Новая.Номенклатура = Выборка.Номенклатура;
		Новая.НоменклатураПартии = Выборка.Номенклатура;
		Новая.Характеристика = Выборка.Характеристика;
		Новая.Количество = Выборка.Количество;
		Новая.Сумма = Выборка.Цена;
		Новая.ДокументОтгрузки = ДокОбъект.Ссылка;
		Новая.Списание = Ложь;
	КонецЦикла;

КонецПроцедуры

// Поля происхождения записи: физический ключ, коммерческая номенклатура, документ и строка отгрузки.
//
// Возвращаемое значение:
//  Строка
//
Функция ПоляПроисхождения()

	Возврат "Номенклатура, Характеристика, Серия, НоменклатураПартии, Партия, ДополнительныйРасход, СтатьяДДС, ДатаПартии, "
		+ "СкладОтгрузки, ДокументОтгрузки, КлючСтрокиОтгрузки";

КонецФункции

Функция ТекстЗаписейОснованияИВозвратов()

	// Пакет: [0] физические записи основания (у налогового документа - белые), [1] физические записи прежних
	// возвратов того же основания с моментом строго раньше текущего, [2] поправки основания и прежних возвратов.
	Возврат
	"ВЫБРАТЬ
	|	Возвраты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПрежниеВозвраты
	|ИЗ
	|	Документ.ВозвратОтПокупателя КАК Возвраты
	|ГДЕ
	|	Возвраты.Основание = &Основание
	|	И Возвраты.Проведен
	|	И Возвраты.Ссылка <> &Текущий
	|	И Возвраты.МоментВремени < &Момент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Т.Организация КАК Организация,
	|	Т.Сотрудник КАК Сотрудник,
	|	Т.Контрагент КАК Контрагент,
	|	Т.ДокументПродажи КАК ДокументПродажи,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Ответственный КАК Ответственный,
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.УУ КАК УУ,
	|	Т.Серия КАК Серия,
	|	Т.НоменклатураПартии КАК НоменклатураПартии,
	|	Т.Партия КАК Партия,
	|	Т.ДополнительныйРасход КАК ДополнительныйРасход,
	|	Т.СтатьяДДС КАК СтатьяДДС,
	|	Т.ДатаПартии КАК ДатаПартии,
	|	Т.СкладОтгрузки КАК СкладОтгрузки,
	|	Т.ДокументОтгрузки КАК ДокументОтгрузки,
	|	Т.КлючСтрокиОтгрузки КАК КлючСтрокиОтгрузки,
	|	Т.Количество КАК Количество,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(Отгрузки.МоментВремени, ЕСТЬNULL(ОтгрузкиОрдером.МоментВремени, Т.МоментВремени)) КАК МоментОтгрузки
	|ИЗ
	|	РегистрНакопления.СебестоимостьПродаж КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Отгрузки
	|		ПО Т.ДокументОтгрузки = Отгрузки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдер КАК ОтгрузкиОрдером
	|		ПО Т.ДокументОтгрузки = ОтгрузкиОрдером.Ссылка
	|ГДЕ
	|	Т.Регистратор = &Основание
	|	И Т.Активность
	|	И Т.Списание
	|	И Т.УУ В (&ДопустимыеУУ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Серия КАК Серия,
	|	Т.НоменклатураПартии КАК НоменклатураПартии,
	|	Т.Партия КАК Партия,
	|	Т.ДополнительныйРасход КАК ДополнительныйРасход,
	|	Т.СтатьяДДС КАК СтатьяДДС,
	|	Т.ДатаПартии КАК ДатаПартии,
	|	Т.СкладОтгрузки КАК СкладОтгрузки,
	|	Т.ДокументОтгрузки КАК ДокументОтгрузки,
	|	Т.КлючСтрокиОтгрузки КАК КлючСтрокиОтгрузки,
	|	СУММА(-Т.Количество) КАК Количество,
	|	СУММА(-Т.Сумма) КАК Сумма,
	|	СУММА(-Т.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	РегистрНакопления.СебестоимостьПродаж КАК Т
	|ГДЕ
	|	Т.Регистратор В
	|			(ВЫБРАТЬ
	|				ПВ.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТПрежниеВозвраты КАК ПВ)
	|	И Т.Активность
	|	И Т.Списание
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Номенклатура,
	|	Т.Характеристика,
	|	Т.Серия,
	|	Т.НоменклатураПартии,
	|	Т.Партия,
	|	Т.ДополнительныйРасход,
	|	Т.СтатьяДДС,
	|	Т.ДатаПартии,
	|	Т.СкладОтгрузки,
	|	Т.ДокументОтгрузки,
	|	Т.КлючСтрокиОтгрузки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Т.Организация КАК Организация,
	|	Т.Сотрудник КАК Сотрудник,
	|	Т.Контрагент КАК Контрагент,
	|	Т.ДокументПродажи КАК ДокументПродажи,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Ответственный КАК Ответственный,
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.Серия КАК Серия,
	|	Т.НоменклатураПартии КАК НоменклатураПартии,
	|	Т.Партия КАК Партия,
	|	Т.ДополнительныйРасход КАК ДополнительныйРасход,
	|	Т.СтатьяДДС КАК СтатьяДДС,
	|	Т.ДатаПартии КАК ДатаПартии,
	|	Т.СкладОтгрузки КАК СкладОтгрузки,
	|	Т.ДокументОтгрузки КАК ДокументОтгрузки,
	|	Т.КлючСтрокиОтгрузки КАК КлючСтрокиОтгрузки,
	|	Т.Количество КАК Количество,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	РегистрНакопления.СебестоимостьПродаж КАК Т
	|ГДЕ
	|	Т.Регистратор = &Основание
	|	И Т.Активность
	|	И Т.Поправка
	|	И Т.УУ В (&ДопустимыеУУ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.ХозяйственнаяОперация,
	|	Т.Организация,
	|	Т.Сотрудник,
	|	Т.Контрагент,
	|	Т.ДокументПродажи,
	|	Т.Номенклатура,
	|	Т.Характеристика,
	|	Т.Ответственный,
	|	Т.МестоХранения,
	|	Т.Серия,
	|	Т.НоменклатураПартии,
	|	Т.Партия,
	|	Т.ДополнительныйРасход,
	|	Т.СтатьяДДС,
	|	Т.ДатаПартии,
	|	Т.СкладОтгрузки,
	|	Т.ДокументОтгрузки,
	|	Т.КлючСтрокиОтгрузки,
	|	Т.Количество,
	|	Т.Сумма,
	|	Т.СуммаНДС
	|ИЗ
	|	РегистрНакопления.СебестоимостьПродаж КАК Т
	|ГДЕ
	|	Т.Регистратор В
	|			(ВЫБРАТЬ
	|				ПВ.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТПрежниеВозвраты КАК ПВ)
	|	И Т.Активность
	|	И Т.Поправка";

КонецФункции

// Происхождения основания с невозвращенными остатками: записи основания, свернутые по полям происхождения, минус
// прежние возвраты по тем же полям. Порядок - момент документа отгрузки, затем первая строка.
//
// Параметры:
//  ЗаписиОснования - ТаблицаЗначений - пакет [1] ТекстЗаписейОснованияИВозвратов
//  Прежние         - ТаблицаЗначений - пакет [2]
//
// Возвращаемое значение:
//  ТаблицаЗначений - поля записи основания + Количество, Сумма, СуммаНДС (отгружено), ОстатокКоличество,
//                    ОстатокСумма, ОстатокНДС, НомерСтроки, МоментОтгрузки
//
Функция ТаблицаИсточников(ЗаписиОснования, Прежние)

	Поля = ПоляПроисхождения();
	Источники = ЗаписиОснования.СкопироватьКолонки();
	Для Каждого Запись Из ЗаписиОснования Цикл
		Отбор = Новый Структура(Поля);
		ЗаполнитьЗначенияСвойств(Отбор, Запись);
		Найденные = Источники.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			Строка = Источники.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, Запись);
		Иначе
			Строка = Найденные[0];
			Строка.Количество = Строка.Количество + Запись.Количество;
			Строка.Сумма = Строка.Сумма + Запись.Сумма;
			Строка.СуммаНДС = Строка.СуммаНДС + Запись.СуммаНДС;
		КонецЕсли;
	КонецЦикла;
	ТипЧисла = Метаданные.ОпределяемыеТипы.Сумма.Тип;
	Источники.Колонки.Добавить("ОстатокКоличество", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Источники.Колонки.Добавить("ОстатокСумма", ТипЧисла);
	Источники.Колонки.Добавить("ОстатокНДС", ТипЧисла);
	Для Каждого Строка Из Источники Цикл
		Строка.ОстатокКоличество = Строка.Количество;
		Строка.ОстатокСумма = Строка.Сумма;
		Строка.ОстатокНДС = Строка.СуммаНДС;
	КонецЦикла;
	Для Каждого Возвращено Из Прежние Цикл
		Отбор = Новый Структура(Поля);
		ЗаполнитьЗначенияСвойств(Отбор, Возвращено);
		Найденные = Источники.НайтиСтроки(Отбор);
		Если Найденные.Количество() > 0 Тогда
			Строка = Найденные[0];
			Строка.ОстатокКоличество = Строка.ОстатокКоличество - Возвращено.Количество;
			Строка.ОстатокСумма = Строка.ОстатокСумма - Возвращено.Сумма;
			Строка.ОстатокНДС = Строка.ОстатокНДС - Возвращено.СуммаНДС;
		КонецЕсли;
	КонецЦикла;
	Источники.Сортировать("МоментОтгрузки, НомерСтроки");
	Возврат Источники;

КонецФункции

// Невозвращенные остатки происхождений одного вида, свернутые по физическому ключу возврата в порядке первого
// происхождения (порядок списания): склад списания - МестоХранения, физическая номенклатура - Номенклатура.
//
// Параметры:
//  Источники            - ТаблицаЗначений - см. ТаблицаИсточников
//  ДополнительныйРасход - Булево - вид записей
//  Ключи                - Строка - поля ключа в именах таблицы возврата
//  Ресурсы              - Строка - Количество, Сумма, СуммаНДС (остатки)
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция СвернутьОстатки(Источники, ДополнительныйРасход, Ключи, Ресурсы)

	Таблица = Новый ТаблицаЗначений;
	ИменаКлючей = СтрРазделить(Ключи, ", ", Ложь);
	ИменаРесурсов = СтрРазделить(Ресурсы, ", ", Ложь);
	Для Каждого Имя Из ИменаКлючей Цикл
		Таблица.Колонки.Добавить(Имя);
	КонецЦикла;
	Для Каждого Имя Из ИменаРесурсов Цикл
		ОпределяемыйТип = ?(Имя = "Количество", Метаданные.ОпределяемыеТипы.Количество, Метаданные.ОпределяемыеТипы.Сумма);
		Таблица.Колонки.Добавить(Имя, ОпределяемыйТип.Тип);
	КонецЦикла;
	ИменаИсточника = Новый Структура("МестоХранения, Номенклатура", "СкладОтгрузки", "НоменклатураПартии");
	ИменаИсточника.Вставить("Количество", "ОстатокКоличество");
	ИменаИсточника.Вставить("Сумма", "ОстатокСумма");
	ИменаИсточника.Вставить("СуммаНДС", "ОстатокНДС");
	ОтборВида = Новый Структура("ДополнительныйРасход", ДополнительныйРасход);
	Для Каждого Источник Из Источники.НайтиСтроки(ОтборВида) Цикл
		Отбор = Новый Структура;
		Для Каждого Имя Из ИменаКлючей Цикл
			Отбор.Вставить(Имя, Источник[?(ИменаИсточника.Свойство(Имя), ИменаИсточника[Имя], Имя)]);
		КонецЦикла;
		Найденные = Таблица.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			Строка = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, Отбор);
		Иначе
			Строка = Найденные[0];
		КонецЕсли;
		Для Каждого Имя Из ИменаРесурсов Цикл
			Строка[Имя] = Строка[Имя] + Источник[ИменаИсточника[Имя]];
		КонецЦикла;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Отбор источников части возврата по физическому ключу.
//
// Параметры:
//  Строка               - СтрокаТаблицыЗначений - часть (см. НоваяТаблицаВосстановленного)
//  ДополнительныйРасход - Булево - вид источников
//
// Возвращаемое значение:
//  Структура - ДополнительныйРасход, НоменклатураПартии, Характеристика, Серия, Партия
//
Функция ОтборИсточника(Строка, ДополнительныйРасход)

	Отбор = Новый Структура("ДополнительныйРасход", ДополнительныйРасход);
	Отбор.Вставить("НоменклатураПартии", Строка.Номенклатура);
	Отбор.Вставить("Характеристика", Строка.Характеристика);
	Отбор.Вставить("Серия", Строка.Серия);
	Отбор.Вставить("Партия", Строка.Партия);
	Возврат Отбор;

КонецФункции

Процедура РазложитьПартию(Источники, Строка, БезСклада, Части)

	Отбор = ОтборИсточника(Строка, Ложь);
	Отбор.Вставить("ДатаПартии", Строка.ДатаПартии);
	Если Не БезСклада Тогда
		Отбор.Вставить("СкладОтгрузки", Строка.МестоХранения);
	КонецЕсли;
	Кандидаты = Источники.НайтиСтроки(Отбор);
	Осталось = Строка.Количество;
	ОсталосьСумма = Строка.Сумма;
	ОсталосьНДС = Строка.СуммаНДС;
	Для Каждого Источник Из Кандидаты Цикл
		Если Осталось <= 0 Тогда
			Прервать;
		КонецЕсли;
		Количество = Мин(Осталось, Макс(Источник.ОстатокКоличество, 0));
		Если Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Количество = Осталось Тогда
			Сумма = ОсталосьСумма;
			НДС = ОсталосьНДС;
		Иначе
			Сумма = Окр(Строка.Сумма * Количество / Строка.Количество, РазрядностьСуммы());
			НДС = Окр(Строка.СуммаНДС * Количество / Строка.Количество, РазрядностьСуммы());
		КонецЕсли;
		ДобавитьЧасть(Части, Источник, Количество, Сумма, НДС, Ложь);
		Источник.ОстатокКоличество = Источник.ОстатокКоличество - Количество;
		Источник.ОстатокСумма = Источник.ОстатокСумма - Сумма;
		Источник.ОстатокНДС = Источник.ОстатокНДС - НДС;
		Осталось = Осталось - Количество;
		ОсталосьСумма = ОсталосьСумма - Сумма;
		ОсталосьНДС = ОсталосьНДС - НДС;
	КонецЦикла;
	Если Осталось > 0 Тогда
		// Источника нет (история без происхождения) - часть без источника, нефизическая (Ф2.6 п. 4).
		ДобавитьЧасть(Части, Неопределено, Осталось, ОсталосьСумма, ОсталосьНДС, Ложь, Строка);
	КонецЕсли;

КонецПроцедуры

Процедура РазложитьДопрасход(Источники, Строка, Части)

	Отбор = ОтборИсточника(Строка, Истина);
	Отбор.Вставить("СкладОтгрузки", Строка.МестоХранения);
	Отбор.Вставить("СтатьяДДС", Строка.СтатьяДДС);
	Кандидаты = Источники.НайтиСтроки(Отбор);
	Если Кандидаты.Количество() = 0 Тогда
		ДобавитьЧасть(Части, Неопределено, 0, Строка.Сумма, Строка.СуммаНДС, Истина, Строка);
		Возврат;
	КонецЕсли;
	Остатки = Новый Массив;
	ОстаткиНДС = Новый Массив;
	Для Каждого Источник Из Кандидаты Цикл
		Остатки.Добавить(Источник.ОстатокСумма);
		ОстаткиНДС.Добавить(Источник.ОстатокНДС);
	КонецЦикла;
	Суммы = РаспределитьПропорционально(Остатки, Строка.Сумма);
	НДС = РаспределитьПропорционально(ОстаткиНДС, Строка.СуммаНДС);
	Для Индекс = 0 По Кандидаты.ВГраница() Цикл
		Если Суммы[Индекс] = 0 И НДС[Индекс] = 0 Тогда
			Продолжить;
		КонецЕсли;
		Источник = Кандидаты[Индекс];
		ДобавитьЧасть(Части, Источник, 0, Суммы[Индекс], НДС[Индекс], Истина);
		Источник.ОстатокСумма = Источник.ОстатокСумма - Суммы[Индекс];
		Источник.ОстатокНДС = Источник.ОстатокНДС - НДС[Индекс];
	КонецЦикла;

КонецПроцедуры

// Распределение суммы пропорционально знаковым базам с точностью до копейки (Ф2.3, Редакции 22-24): доли усекаются к
// нулю, знаковая разница раздается по копейке долям своего знака в порядке убывания модуля дробной части (при
// равенстве - по порядку баз). Части не меняют знак базы и по модулю не больше ее, если 0 <= Итог / СуммаБаз <= 1.
//
// Разрядность - параметр (Ф3.6): количества пар оформления делятся с разрядностью количества.
//
// Параметры:
//  Базы       - Массив из Число - знаковые базы
//  Итог       - Число - распределяемая сумма
//  Разрядность - Число - знаков после запятой; по умолчанию копейки
//
// Возвращаемое значение:
//  Массив из Число - части в порядке баз, сумма частей = Итог
//
Функция РаспределитьПропорционально(Базы, Итог, Разрядность = 2) Экспорт

	Результат = Новый Массив;
	СуммаБаз = 0;
	Для Каждого База Из Базы Цикл
		СуммаБаз = СуммаБаз + База;
		Результат.Добавить(0);
	КонецЦикла;
	Если Базы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если СуммаБаз = 0 Тогда
		Результат[Базы.ВГраница()] = Итог;
		Возврат Результат;
	КонецЕсли;
	// BSLLS:MagicNumber-off - основание десятичной разрядности
	Копейка = 1 / Pow(10, Разрядность);
	// BSLLS:MagicNumber-on
	Дроби = Новый ТаблицаЗначений;
	Дроби.Колонки.Добавить("Индекс");
	Дроби.Колонки.Добавить("Дробь");
	Дроби.Колонки.Добавить("Модуль");
	Усеченные = 0;
	Для Индекс = 0 По Базы.ВГраница() Цикл
		Точная = Базы[Индекс] * Итог / СуммаБаз;
		Часть = Цел(Точная / Копейка) * Копейка;
		Результат[Индекс] = Часть;
		Усеченные = Усеченные + Часть;
		Строка = Дроби.Добавить();
		Строка.Индекс = Индекс;
		Строка.Дробь = Точная - Часть;
		Строка.Модуль = Макс(Строка.Дробь, -Строка.Дробь);
	КонецЦикла;
	Разница = Окр(Итог - Усеченные, Разрядность);
	Дроби.Сортировать("Модуль Убыв, Индекс");
	Шаг = ?(Разница > 0, Копейка, -Копейка);
	Для Каждого Строка Из Дроби Цикл
		Если Разница = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Строка.Дробь = 0 Или (Строка.Дробь > 0) <> (Шаг > 0) Тогда
			Продолжить;
		КонецЕсли;
		Результат[Строка.Индекс] = Результат[Строка.Индекс] + Шаг;
		Разница = Окр(Разница - Шаг, Разрядность);
	КонецЦикла;
	Если Разница <> 0 Тогда
		// Недостижимо при 0 <= Итог / СуммаБаз <= 1; страховка точного итога.
		Результат[Базы.ВГраница()] = Результат[Базы.ВГраница()] + Разница;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ДобавитьЧасть(Части, Источник, Количество, Сумма, НДС, ДополнительныйРасход, Строка = Неопределено)

	Часть = Части.Добавить();
	Часть.Источник = Источник;
	Часть.Количество = Количество;
	Часть.Сумма = Сумма;
	Часть.СуммаНДС = НДС;
	Часть.ДополнительныйРасход = ДополнительныйРасход;
	Часть.Строка = Строка;
	Товар = ?(Источник = Неопределено, Строка, Источник);
	Если Товар <> Неопределено Тогда
		Часть.Номенклатура = Товар.Номенклатура;
		Часть.Характеристика = Товар.Характеристика;
	КонецЕсли;

КонецПроцедуры

// Компенсация поправок (Ф2.3 п. 5): возврат, после которого возвращенное количество товара основания равно
// проданному, сторнирует поправки переноса этого товара у основания и прежних возвратов.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВозвратОтПокупателя - возврат
//  Источник  - Структура - см. ИсточникВозврата (остатки источников уже уменьшены раскладкой)
//  Части     - ТаблицаЗначений - см. РазложитьПоИсточникам
//  Набор     - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж - набор возврата
//
Процедура ЗаписатьКомпенсациюПоправок(ДокОбъект, Источник, Части, Набор)

	Если Источник.Поправки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Товары = Источник.Источники.Скопировать(Новый Структура("ДополнительныйРасход", Ложь),
		"Номенклатура, Характеристика, Количество, ОстатокКоличество");
	Товары.Свернуть("Номенклатура, Характеристика", "Количество, ОстатокКоличество");
	Вернул = Новый Соответствие;
	Для Каждого Часть Из Части Цикл
		Если Часть.Источник <> Неопределено И Не Часть.ДополнительныйРасход Тогда
			Ключ = КлючТовара(Часть.Номенклатура, Часть.Характеристика);
			Вернул.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Товар Из Товары Цикл
		Ключ = КлючТовара(Товар.Номенклатура, Товар.Характеристика);
		Если Вернул[Ключ] = Неопределено Или Товар.ОстатокКоличество > 0 Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("Номенклатура, Характеристика", Товар.Номенклатура, Товар.Характеристика);
		Для Каждого Поправка Из Источник.Поправки.НайтиСтроки(Отбор) Цикл
			Запись = Набор.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Поправка, , "Количество, Сумма, СуммаНДС");
			Запись.Период = ДокОбъект.Дата;
			Запись.ХозяйственнаяОперация = ДокОбъект.ХозяйственнаяОперация;
			Запись.Количество = -Поправка.Количество;
			Запись.Сумма = -Поправка.Сумма;
			Запись.СуммаНДС = -Поправка.СуммаНДС;
			Запись.Списание = Ложь;
			Запись.Поправка = Истина;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция КлючТовара(Номенклатура, Характеристика)

	Возврат Строка(Номенклатура.УникальныйИдентификатор()) + "/"
		+ ?(ЗначениеЗаполнено(Характеристика), Строка(Характеристика.УникальныйИдентификатор()), "");

КонецФункции

Функция МоментВозврата(ДокОбъект)

	Если ДокОбъект.Ссылка.Пустая() Тогда
		Возврат Новый МоментВремени(ДокОбъект.Дата);
	КонецЕсли;
	Возврат ДокОбъект.МоментВремени();

КонецФункции

Функция РазрядностьСуммы()

	Возврат 2;

КонецФункции

// Записи основания с моментом отгрузки не раньше возврата удаляются из источника (план warehouse-orders-cost, Ф3.11):
// товар, отгруженный расходным ордером позже возврата, вернуть нельзя.
//
// Параметры:
//  ЗаписиОснования - ТаблицаЗначений - физические записи основания с колонкой МоментОтгрузки; изменяется
//  Момент          - МоментВремени - момент возврата
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Серия, Количество - отсечённые партии
//
Функция ОтделитьОтгрузкиПозже(ЗаписиОснования, Момент)

	Позже = Новый ТаблицаЗначений;
	Позже.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Позже.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Позже.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	Позже.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Лишние = Новый Массив;
	Для Каждого Запись Из ЗаписиОснования Цикл
		Если ТипЗнч(Запись.МоментОтгрузки) = Тип("МоментВремени") И Запись.МоментОтгрузки.Сравнить(Момент) >= 0 Тогда
			Лишние.Добавить(Запись);
			Если Не Запись.ДополнительныйРасход Тогда
				Строка = Позже.Добавить();
				Строка.Номенклатура = Запись.НоменклатураПартии;
				ЗаполнитьЗначенияСвойств(Строка, Запись, "Характеристика, Серия, Количество");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Запись Из Лишние Цикл
		ЗаписиОснования.Удалить(Запись);
	КонецЦикла;
	Возврат Позже;

КонецФункции

// Переносит в новые записи прежние, кроме заменяемых кусками пар: записей отгрузки по затронутым строкам ордеров и
// старого своего списания реализации.
//
// Параметры:
//  Прежние    - ТаблицаЗначений - прежние записи набора
//  Новые      - ТаблицаЗначений - новые записи, дополняются
//  Ключи      - Соответствие - ключи затронутых строк
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг, Неопределено - чьё своё списание снимается
//
// Возвращаемое значение:
//  Число - снято записей своего списания
//
Функция ПеренестиНезаменяемые(Прежние, Новые, Ключи, Реализация)

	Снято = 0;
	Для Каждого Запись Из Прежние Цикл
		Если Реализация <> Неопределено И Запись.Списание И Запись.ДокументОтгрузки = Реализация Тогда
			Снято = Снято + 1;
			Продолжить;
		КонецЕсли;
		Заменяется = ТипЗнч(Запись.ДокументОтгрузки) = Тип("ДокументСсылка.РасходныйОрдер")
			И Ключи[КлючСтрокиОрдера(Запись.ДокументОтгрузки, Запись.КлючСтрокиОтгрузки)] <> Неопределено;
		Если Не Заменяется Тогда
			ЗаполнитьЗначенияСвойств(Новые.Добавить(), Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Снято;

КонецФункции

// Свои допрасходы реализации ордерного склада (Ф3.6): партий у реализации нет - допрасход ложится в себестоимость
// продаж нефизической записью (Списание = Ложь, возврат его не восстанавливает), по строкам товаров пропорционально
// сумме строки, при нулевой сумме - количеству, остаток - последней строке.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг - реализация
//  Набор     - РегистрНакопленияНаборЗаписей.СебестоимостьПродаж, ТаблицаЗначений - набор или его выгрузка
//  Измерения - Структура - см. ИзмеренияРеализации
//
Процедура ДобавитьСвоиДопрасходыОрдерногоСклада(ДокОбъект, Набор, Измерения)

	Допрасходы = РегистрыНакопления.ДополнительныеРасходы.ДопрасходыДокументаВОсновнойВалюте(ДокОбъект);
	Если Допрасходы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Товары = ДокОбъект.ТЧТовары.Выгрузить(, "Номенклатура, Характеристика, Количество, СуммаСНДС");
	Товары.Колонки.СуммаСНДС.Имя = "Сумма";
	Для Каждого Имя Из СтрРазделить("МестоХранения,Серия,Партия", ",") Цикл
		Товары.Колонки.Добавить(Имя);
	КонецЦикла;
	Части = РегистрыНакопления.ДополнительныеРасходы.РаспределениеПоСтрокам(Товары, Допрасходы).Части;
	Для Каждого Часть Из Части Цикл
		Если Часть.Сумма = 0 И Часть.СуммаНДС = 0 Тогда
			Продолжить;
		КонецЕсли;
		Новая = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Измерения);
		Новая.Номенклатура = Часть.Номенклатура;
		Новая.НоменклатураПартии = Часть.Номенклатура;
		Новая.Характеристика = Часть.Характеристика;
		Новая.ДополнительныйРасход = Истина;
		Новая.СтатьяДДС = Часть.СтатьяДДС;
		Новая.Сумма = Часть.Сумма;
		Новая.СуммаНДС = Часть.СуммаНДС;
		Новая.СкладОтгрузки = ДокОбъект.МестоХранения;
		Новая.ДокументОтгрузки = ДокОбъект.Ссылка;
		Новая.Списание = Ложь;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
