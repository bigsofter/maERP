
#Область Формирование_движений

Процедура СформироватьДвижения(ДокОбъект) Экспорт
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект,"ХозяйственнаяОперация") Тогда 
		Если Не ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПокупателями(ДокОбъект.ХозяйственнаяОперация) Тогда Возврат КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда 		
		СуммаДокумента = ДокОбъект.Сумма;
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧЗачётАвансов, Истина, Ложь, Истина, СуммаДокумента);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратОтПокупателя") Тогда
		ТЗАвансы = Новый ТаблицаЗначений;
		ТЗАвансы.Колонки.Добавить("Основание");
		ТЗАвансы.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
		НС = ТЗАвансы.Добавить();
		НС.Основание = ?(ЗначениеЗаполнено(ДокОбъект.Основание), ДокОбъект.Основание, ДокОбъект.Ссылка);
		НС.Сумма = ДокОбъект.Сумма;
		СуммаДокумента = ДокОбъект.Сумма;
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ТЗАвансы, Истина, Истина, Ложь, СуммаДокумента);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств") Тогда			
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Ложь, Ложь, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда			
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Ложь, Истина, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Ложь, Ложь, Ложь, ДокОбъект.Сумма);		
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда	
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Ложь, Истина, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаДолга") Тогда
		Движения = ДокОбъект.Движения;
		//Мас = ДокОбъект.ДополнительныеСвойства.ТЗКредиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПокупателем", Истина));
		Для Каждого Стр Из ДокОбъект.ДополнительныеСвойства.ТЗКредиторскаяЗадолженность Цикл
			ОбъектРасчётов = Стр.ОбъектРасчётов;
			Движение(Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.КонтрагентКредитор, , ОбъектРасчётов, Стр.Сумма, Ложь); 
		КонецЦикла;
		//Мас = ДокОбъект.ДополнительныеСвойства.ТЗДебиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПокупателем", Истина));
		//Для Каждого Стр Из Мас Цикл
		//	ОбъектРасчётов = ?(ТипЗнч(Стр.ОбъектРасчётов) = Тип("СправочникСсылка.ДоговорыСКонтрагентами"), ДокОбъект.Ссылка, Стр.ОбъектРасчётов);
		//	Движение(Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.КонтрагентДебитор, Стр.Договор, ОбъектРасчётов, Стр.Сумма, Истина);
		//КонецЦикла;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СертификатНаОплату") Тогда
		Если ЗначениеЗаполнено(ДокОбъект.Реализация) Тогда 
			Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Реализация.Контрагент, ДокОбъект.Реализация.Договор, ДокОбъект.Реализация.Ссылка, ДокОбъект.Сумма, Ложь);	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура СформироватьПоПлатёжномуДокументу(ДокОбъект, ТЧАвансы, Приход, Сторно, ЭтоДокументРасчётов, СуммаРаспределения) 
	ДатаПроведения = ДокОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаПроведения) Тогда Возврат КонецЕсли;
	СуммаОстаток = СуммаРаспределения;
	Движения = ДокОбъект.Движения;
	Для Каждого Стр Из ТЧАвансы Цикл
		Если ЭтоДокументРасчётов Тогда
			// Сторнируем аванс
			Движение(ДокОбъект.Движения, ДатаПроведения, Стр.Основание.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, Стр.Основание, ?(Сторно, Стр.Сумма, -Стр.Сумма), Не Приход);
			// Делаем задолженность по документу
			Движение(ДокОбъект.Движения, ДатаПроведения, Стр.Основание.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, ?(Сторно, -Стр.Сумма, Стр.Сумма), Приход); 
			// Оплачиваем его
			Движение(ДокОбъект.Движения, ДатаПроведения, Стр.Основание.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, ?(Сторно, -Стр.Сумма, Стр.Сумма), Не Приход);	
		Иначе
			// Долг по налоговой накладной закрывается в ВзаиморасчётыСПокупателямиНалоговый
			Если ТипЗнч(Стр.Основание) <> Тип("ДокументСсылка.НалоговаяНакладная") Тогда
				Движение(ДокОбъект.Движения, ДатаПроведения, Стр.Основание.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, Стр.Основание, ?(Сторно, -Стр.Сумма, Стр.Сумма), Приход);
			КонецЕсли;
		КонецЕсли;		  
		СуммаОстаток = СуммаОстаток - Стр.Сумма;
	КонецЦикла;
	Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, ?(Сторно, -СуммаОстаток, СуммаОстаток), Приход);
КонецПроцедуры

Процедура Движение(Движения, ДатаДвижения, Организация, Контрагент, Договор, ОбъектРасчётов, Сумма, Приход = Истина)
	Если Сумма = 0 Тогда Возврат КонецЕсли;
	НС = Движения.ВзаиморасчётыСПокупателями.Добавить();
	НС.ВидДвижения = ?(Приход, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
	НС.Период = ДатаДвижения;
	НС.Организация = Организация;
	НС.Контрагент = Контрагент;
	НС.Договор = Договор;
	НС.ОбъектРасчётов = ОбъектРасчётов;
	НС.Сумма = Сумма;	
КонецПроцедуры

#КонецОбласти

#Область Остатки

// Возвращает непогашенный долг покупателей по реализациям с учётом суммы кредита по договору.
//
// Параметры:
//  Период - Дата, МоментВремени, Граница - дата, на которую считаются остатки; граница или момент
//           времени документа используются как есть (момент времени - как граница Исключая).
//  Отбор - Структура - необязательные массивы в свойствах Организации, Контрагенты, Договоры, Менеджеры.
//  ПоПозицииДокумента - Булево - для Период типа Дата: Истина - остатки на момент до документа с этой
//                       датой (граница Исключая), Ложь - остатки на конец дня Период.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ГруппировкаВсего, Организация, Контрагент, Договор, РеализацияТоваровУслуг,
//                    Менеджер, Долг, ДатаОтгрузки, КоличествоВыходных.
//
Функция ПолучитьЗадолженностьКлиентовПоКлассификации(Период, Отбор, ПоПозицииДокумента = Ложь) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	// Заполним реквизиты
	Организации = ?(Отбор.Свойство("Организации"), Отбор.Организации, Новый Массив);
	Контрагенты = ?(Отбор.Свойство("Контрагенты"), Отбор.Контрагенты, Новый Массив);	
	Договоры = ?(Отбор.Свойство("Договоры"), Отбор.Договоры, Новый Массив);
	Менеджеры = ?(Отбор.Свойство("Менеджеры"), Отбор.Менеджеры, Новый Массив);
	// Получим данные из базы
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВсК.Организация КАК Организация,
	                      |	ВсК.Контрагент КАК Контрагент,
	                      |	ВсК.Договор КАК Договор,
	                      |	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК Менеджер,
	                      |	ВсК.ОбъектРасчётов КАК РеализацияТоваровУслуг,
	                      |	ВсК.СуммаОстаток КАК Долг,
	                      |	НАЧАЛОПЕРИОДА(ВсК.ОбъектРасчётов.Дата, ДЕНЬ) КАК ДатаОтгрузки,
	                      |	ЕСТЬNULL(ВсК.Договор.СрокОплаты, 0) КАК СрокОплаты,
	                      |	ЕСТЬNULL(ВсК.Договор.СуммаКредита, 0) КАК СуммаКредита,
	                      |	ВсК.Договор.СпособРасчётаОтсрочки = ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.БанковскиеДни) КАК ПоБанковскимДням
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(
	                      |			&Период,
	                      |			ОбъектРасчётов ССЫЛКА Документ.РеализацияТоваровУслуг
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьОрганизации
	                      |						ТОГДА Договор.Организация В (&Организации)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьКонтрагенты
	                      |						ТОГДА Контрагент В ИЕРАРХИИ (&Контрагенты)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьМенеджеры
	                      |						ТОГДА ОбъектРасчётов.Менеджер В ИЕРАРХИИ (&Менеджеры)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьДоговоры
	                      |						ТОГДА Договор В (&Договоры)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ) КАК ВсК
	                      |ГДЕ
	                      |	ВсК.СуммаОстаток > 0
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПроизводственныйКалендарь.Дата) КАК КоличествоВыходных
	                      |ПОМЕСТИТЬ ВТВыходные
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь
	                      |		ПО (ПроизводственныйКалендарь.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, 1) И &ПериодДата)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТ.РеализацияТоваровУслуг
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	""Состояние взаиморасчетов"" КАК ГруппировкаВсего,
	                      |	ВЗ.Организация КАК Организация,
	                      |	ВЗ.Контрагент КАК Контрагент,
	                      |	ВЗ.Договор КАК Договор,
	                      |	ВЗ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
	                      |	ВЗ.Менеджер КАК Менеджер,
	                      |	ВЗ.Долг КАК Долг,
	                      |	ВЗ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |	ВЗ.КоличествоВыходных КАК КоличествоВыходных
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТ.Организация КАК Организация,
	                      |		ВТ.Контрагент КАК Контрагент,
	                      |		ВТ.Договор КАК Договор,
	                      |		ВТ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
	                      |		ВТ.РеализацияТоваровУслуг.Менеджер КАК Менеджер,
	                      |		ВЫБОР
	                      |			КОГДА ВТ.Долг - ВТ.СуммаКредита < 0
	                      |				ТОГДА 0
	                      |			ИНАЧЕ ВТ.Долг - ВТ.СуммаКредита
	                      |		КОНЕЦ КАК Долг,
	                      |		ВТ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |		ЕСТЬNULL(ВТВыходные.КоличествоВыходных, 0) КАК КоличествоВыходных
	                      |	ИЗ
	                      |		ВТ КАК ВТ
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ ВТВыходные КАК ВТВыходные
	                      |			ПО ВТ.РеализацияТоваровУслуг = ВТВыходные.РеализацияТоваровУслуг) КАК ВЗ
	                      |ГДЕ
	                      |	ВЗ.Долг > 0");
	Если ТипЗнч(Период) = Тип("Граница") Тогда
		ГраницаПериода = Период;
	ИначеЕсли ТипЗнч(Период) = Тип("МоментВремени") Или ПоПозицииДокумента Тогда
		ГраницаПериода = Новый Граница(Период, ВидГраницы.Исключая);
	Иначе
		ГраницаПериода = КонецДня(Период);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", ГраницаПериода);
	Запрос.УстановитьПараметр("ПериодДата", КонецДня(ДатаПериода(Период)));
	Запрос.УстановитьПараметр("ЕстьОрганизации", Организации.Количество() <> 0);
	Запрос.УстановитьПараметр("Организации", Организации);
	Запрос.УстановитьПараметр("ЕстьКонтрагенты", Контрагенты.Количество() <> 0);
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("ЕстьДоговоры", Договоры.Количество() <> 0);
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Запрос.УстановитьПараметр("ЕстьМенеджеры", Менеджеры.Количество() <> 0);
	Запрос.УстановитьПараметр("Менеджеры", Менеджеры);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ДатаПериода(Период)
	Если ТипЗнч(Период) = Тип("Граница") Тогда
		Возврат ДатаПериода(Период.Значение);
	ИначеЕсли ТипЗнч(Период) = Тип("МоментВремени") Тогда
		Возврат Период.Дата;
	Иначе
		Возврат Период;
	КонецЕсли;
КонецФункции

// Оплаты по документу продажи с разбивкой по типам и долг клиента на момент до документа.
//
// Параметры:
//  Документ - ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.ВозвратОтПокупателя - объект расчётов.
//  Клиент - СправочникСсылка.Контрагенты - клиент документа.
//
// Возвращаемое значение:
//  Структура - ВсегоОплачено, Наличные, Чеком (Число) - суммы оплат по документу;
//              Долг (Число) - долг клиента на границу Исключая по моменту времени документа.
//
Функция ОплатыИДолгПоДокументу(Документ, Клиент) Экспорт
	Оплаты = GetTableOfPayments(Документ);
	Результат = Новый Структура("ВсегоОплачено, Наличные, Чеком", Оплаты.Итог("Somme"), 0, 0);
	СтрокаОплаты = Оплаты.Найти(Справочники.TypesDePayment.Cash, "TypesDePayment");
	Если СтрокаОплаты <> Неопределено Тогда
		Результат.Наличные = СтрокаОплаты.Somme;
	КонецЕсли;
	СтрокаОплаты = Оплаты.Найти(Справочники.TypesDePayment.Cheque, "TypesDePayment");
	Если СтрокаОплаты <> Неопределено Тогда
		Результат.Чеком = СтрокаОплаты.Somme;
	КонецЕсли;
	Клиенты = Новый Массив;
	Клиенты.Добавить(Клиент);
	Граница = Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая);
	Долги = ПолучитьЗадолженностьКлиентовПоКлассификации(Граница, Новый Структура("Контрагенты", Клиенты), Истина);
	Результат.Вставить("Долг", Долги.Итог("Долг"));
	Возврат Результат;
КонецФункции

// Возвращает задолженность покупателей с датами запрета отгрузок по условиям кредита.
// Условия берутся с договора, при незаполненных значениях договора - с контрагента
// (СрокОплаты = 0 у обоих означает 365 дней). Менеджер - куратор договора, при его
// отсутствии - ответственный контрагента.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты, Неопределено - отбор по покупателю;
//               Неопределено - по всем покупателям.
//  МинДнейПросрочки - Число - в результат попадают строки, просроченные не менее чем
//               на указанное число дней (0 - дата запрета наступила сегодня).
//  БезОтбораПоПросрочке - Булево - Истина: вернуть весь долг без отбора по просрочке,
//               в том числе строки, дата запрета которых еще не наступила.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Контрагент, Менеджер (СправочникСсылка.ФизическиеЛица),
//               Долг (весь), ДолгСверхКредита, ДатаЗапрета, ПросроченоДней (максимум),
//               КонтрольКредита (Булево, признак контрагента).
//
Функция ПолучитьПросроченнуюЗадолженность(Контрагент = Неопределено, МинДнейПросрочки = 0, БезОтбораПоПросрочке = Ложь) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВсК.Контрагент КАК Контрагент,
	                      |	ВсК.Договор КАК Договор,
	                      |	ВЫБОР
	                      |		КОГДА ЕСТЬNULL(КураторыДоговоров.Куратор, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	                      |			ТОГДА ЕСТЬNULL(Контрагенты.Ответственный, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
	                      |		ИНАЧЕ КураторыДоговоров.Куратор
	                      |	КОНЕЦ КАК Менеджер,
	                      |	ВсК.ОбъектРасчётов КАК РеализацияТоваровУслуг,
	                      |	ВсК.СуммаОстаток КАК Долг,
	                      |	НАЧАЛОПЕРИОДА(ВсК.ОбъектРасчётов.Дата, ДЕНЬ) КАК ДатаОтгрузки,
	                      |	ВЫБОР
	                      |		КОГДА ЕСТЬNULL(Договоры.СрокОплаты, 0) > 0
	                      |			ТОГДА Договоры.СрокОплаты
	                      |		КОГДА ЕСТЬNULL(Контрагенты.СрокОплаты, 0) > 0
	                      |			ТОГДА Контрагенты.СрокОплаты
	                      |		ИНАЧЕ 365
	                      |	КОНЕЦ КАК СрокОплаты,
	                      |	ВЫБОР
	                      |		КОГДА ЕСТЬNULL(Договоры.СпособРасчётаОтсрочки, ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.ПустаяСсылка)
	                      |			ТОГДА Договоры.СпособРасчётаОтсрочки = ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.БанковскиеДни)
	                      |		ИНАЧЕ ЕСТЬNULL(Контрагенты.СпособРасчётаОтсрочки, ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.БанковскиеДни)
	                      |	КОНЕЦ КАК ПоБанковскимДням,
	                      |	ВЫБОР
	                      |		КОГДА ЕСТЬNULL(Договоры.СуммаКредита, 0) > 0
	                      |			ТОГДА Договоры.СуммаКредита
	                      |		ИНАЧЕ ЕСТЬNULL(Контрагенты.СуммаКредита, 0)
	                      |	КОНЕЦ КАК СуммаКредита,
	                      |	ЕСТЬNULL(Контрагенты.КонтрольКредита, ЛОЖЬ) КАК КонтрольКредита
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(
	                      |			&Период,
	                      |			ОбъектРасчётов ССЫЛКА Документ.РеализацияТоваровУслуг
	                      |					И Контрагент = &Контрагент
	                      |				ИЛИ &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК ВсК
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КураторыДоговоров.СрезПоследних(, ) КАК КураторыДоговоров
	                      |		ПО ВсК.Договор = КураторыДоговоров.Договор
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыСКонтрагентами КАК Договоры
	                      |		ПО ВсК.Договор = Договоры.Ссылка
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	                      |		ПО ВсК.Контрагент = Контрагенты.Ссылка
	                      |ГДЕ
	                      |	ВсК.СуммаОстаток > 0
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПроизводственныйКалендарь.Дата) КАК КоличествоВыходных
	                      |ПОМЕСТИТЬ ВТВыходные
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь
	                      |		ПО (ПроизводственныйКалендарь.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, 1) И &Период)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТ.РеализацияТоваровУслуг
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВЗ.Контрагент КАК Контрагент,
	                      |	ВЗ.Договор КАК Договор,
	                      |	ВЗ.Менеджер КАК Менеджер,
	                      |	ВЗ.КонтрольКредита КАК КонтрольКредита,
	                      |	СУММА(ВЗ.Долг) КАК Долг,
	                      |	МАКСИМУМ(ВЗ.СуммаКредита) КАК СуммаКредита,
	                      |	МИНИМУМ(ВЗ.ДатаЗапрета) КАК ДатаЗапрета,
	                      |	МАКСИМУМ(ВЗ.ПросроченоДней) КАК ПросроченоДней
	                      |ПОМЕСТИТЬ Предварительная
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТ.Контрагент КАК Контрагент,
	                      |		ВТ.Договор КАК Договор,
	                      |		ВТ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
	                      |		ВТ.Менеджер КАК Менеджер,
	                      |		ВТ.КонтрольКредита КАК КонтрольКредита,
	                      |		ВТ.Долг КАК Долг,
	                      |		ВТ.СуммаКредита КАК СуммаКредита,
	                      |		ВТ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |		ВТВыходные.КоличествоВыходных КАК КоличествоВыходных,
	                      |		ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, ВТ.СрокОплаты + ВЫБОР
	                      |				КОГДА ВТ.ПоБанковскимДням
	                      |					ТОГДА ЕСТЬNULL(ВТВыходные.КоличествоВыходных, 0)
	                      |				ИНАЧЕ 0
	                      |			КОНЕЦ) КАК ДатаЗапрета,
	                      |		РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, ВТ.СрокОплаты + ВЫБОР
	                      |					КОГДА ВТ.ПоБанковскимДням
	                      |						ТОГДА ЕСТЬNULL(ВТВыходные.КоличествоВыходных, 0)
	                      |					ИНАЧЕ 0
	                      |				КОНЕЦ), &Период, ДЕНЬ) КАК ПросроченоДней
	                      |	ИЗ
	                      |		ВТ КАК ВТ
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ ВТВыходные КАК ВТВыходные
	                      |			ПО ВТ.РеализацияТоваровУслуг = ВТВыходные.РеализацияТоваровУслуг) КАК ВЗ
	                      |ГДЕ
	                      |	ВЗ.ПросроченоДней >= &ПросроченоДней
	                      |	И ВЗ.Долг > 0
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВЗ.Контрагент,
	                      |	ВЗ.Договор,
	                      |	ВЗ.Менеджер,
	                      |	ВЗ.КонтрольКредита
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Предварительная.Контрагент КАК Контрагент,
	                      |	Предварительная.Менеджер КАК Менеджер,
	                      |	Предварительная.КонтрольКредита КАК КонтрольКредита,
	                      |	Предварительная.Долг КАК Долг,
	                      |	ВЫБОР
	                      |		КОГДА Предварительная.Долг - Предварительная.СуммаКредита < 0
	                      |			ТОГДА 0
	                      |		ИНАЧЕ Предварительная.Долг - Предварительная.СуммаКредита
	                      |	КОНЕЦ КАК ДолгСверхКредита,
	                      |	Предварительная.ДатаЗапрета КАК ДатаЗапрета,
	                      |	Предварительная.ПросроченоДней КАК ПросроченоДней
	                      |ПОМЕСТИТЬ Итог
	                      |ИЗ
	                      |	Предварительная КАК Предварительная
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Итог.Контрагент КАК Контрагент,
	                      |	Итог.Менеджер КАК Менеджер,
	                      |	Итог.КонтрольКредита КАК КонтрольКредита,
	                      |	СУММА(Итог.Долг) КАК Долг,
	                      |	СУММА(Итог.ДолгСверхКредита) КАК ДолгСверхКредита,
	                      |	МИНИМУМ(Итог.ДатаЗапрета) КАК ДатаЗапрета,
	                      |	МАКСИМУМ(Итог.ПросроченоДней) КАК ПросроченоДней
	                      |ИЗ
	                      |	Итог КАК Итог
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Итог.Менеджер,
	                      |	Итог.Контрагент,
	                      |	Итог.КонтрольКредита");
	Если БезОтбораПоПросрочке Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЗ.ПросроченоДней >= &ПросроченоДней", "ИСТИНА");
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ПросроченоДней", МинДнейПросрочки);
	Запрос.УстановитьПараметр("Контрагент",?(Контрагент = Неопределено,Справочники.Контрагенты.ПустаяСсылка(),Контрагент));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти 

Функция ПолучитьОплатыПоМенеджеру(ДатаНачала, ДатаОкончания, Менеджер, Отбор) Экспорт
	МасКонтрагенты = Новый Массив;
	ПринадлежностьКлиента = Перечисления.ПринадлежностьКлиента.ПустаяСсылка();
	Для Каждого Параметр Из Отбор.Параметры Цикл
		Если ТипЗнч(Параметр) = Тип("СправочникСсылка.Контрагенты") Тогда
			МасКонтрагенты.Добавить(Параметр);
		ИначеЕсли ТипЗнч(Параметр) = Тип("ПеречислениеСсылка.ПринадлежностьКлиента") Тогда
			ПринадлежностьКлиента = Параметр;
		КонецЕсли;	
	КонецЦикла;	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СУММА(ВзаиморасчётыСПокупателямиОбороты.СуммаРасход) КАК Оплата,
	                      |	ПродажиОбороты.Сотрудник КАК Менеджер,
	                      |	ВзаиморасчётыСПокупателямиОбороты.Период КАК ДатаОплаты,
	                      |	ВзаиморасчётыСПокупателямиОбороты.Договор КАК Договор
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями.Обороты(
	                      |			&ДатаНач,
	                      |			&ДатаКон,
	                      |			Регистратор,
	                      |			ВЫБОР
	                      |				КОГДА &КонтрагентыУказаны
	                      |					ТОГДА Контрагент В (&Контрагенты)
	                      |				ИНАЧЕ ИСТИНА
	                      |			КОНЕЦ) КАК ВзаиморасчётыСПокупателямиОбороты
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(
	                      |				,
	                      |				,
	                      |				,
	                      |				Сотрудник = &Менеджер
	                      |					И ВЫБОР
	                      |						КОГДА &ПринадлежностьКлиента = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьКлиента.Свой)
	                      |							ТОГДА Ответственный = &Менеджер
	                      |						КОГДА &ПринадлежностьКлиента = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьКлиента.КлиентФирмы)
	                      |							ТОГДА НЕ Ответственный = &Менеджер
	                      |						ИНАЧЕ ИСТИНА
	                      |					КОНЕЦ) КАК ПродажиОбороты
	                      |		ПО ВзаиморасчётыСПокупателямиОбороты.ОбъектРасчётов = ПродажиОбороты.ДокументПродажи
	                      |ГДЕ
	                      |	НАЧАЛОПЕРИОДА(ВзаиморасчётыСПокупателямиОбороты.Период, ДЕНЬ) <= ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ВзаиморасчётыСПокупателямиОбороты.ОбъектРасчётов.Дата, ДЕНЬ), ДЕНЬ, ВзаиморасчётыСПокупателямиОбороты.Договор.СрокОплаты)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ПродажиОбороты.Сотрудник,
	                      |	ВзаиморасчётыСПокупателямиОбороты.Период,
	                      |	ВзаиморасчётыСПокупателямиОбороты.Договор");
	Запрос.УстановитьПараметр("ДатаНач", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", ДатаОкончания);
	Запрос.УстановитьПараметр("Менеджер", Менеджер);
	Запрос.УстановитьПараметр("КонтрагентыУказаны", МасКонтрагенты.Количество() > 0);
	Запрос.УстановитьПараметр("Контрагенты", МасКонтрагенты);
	Запрос.УстановитьПараметр("ПринадлежностьКлиента", ПринадлежностьКлиента);
	Рез = Запрос.Выполнить();
	Возврат ?(Рез.Пустой(), 0, Рез.Выгрузить().Итог("Оплата"));	
КонецФункции

Function GetTableOfPayments(CurrentDoc) Export
	Query = New Query;
	Query.Text =
	"ВЫБРАТЬ
	|	ВзаиморасчётыОбороты.Регистратор КАК Регистратор,
	|	ВзаиморасчётыОбороты.СуммаОборот КАК СуммаОборот
	|ПОМЕСТИТЬ ВТОбороты
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями.Обороты(, , Регистратор, ОбъектРасчётов = &CurrentDoc) КАК ВзаиморасчётыОбороты
	|ГДЕ
	|	(ТИПЗНАЧЕНИЯ(ВзаиморасчётыОбороты.Регистратор) = ТИП(Документ.ПриходныйКассовыйОрдер)
	|			ИЛИ ТИПЗНАЧЕНИЯ(ВзаиморасчётыОбороты.Регистратор) = ТИП(Документ.ПоступлениеБезналичныхДенежныхСредств)
	|			ИЛИ ТИПЗНАЧЕНИЯ(ВзаиморасчётыОбороты.Регистратор) = ТИП(Документ.СертификатНаОплату))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(-ВТОбороты.СуммаОборот) КАК Somme,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.ПриходныйКассовыйОрдер)
	|			ТОГДА ПриходныйКассовыйОрдер.ТипОплаты
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.ПоступлениеБезналичныхДенежныхСредств)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.TypesDePayment.VirementBanquaire)
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.СертификатНаОплату)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.TypesDePayment.Сертификат)
	|	КОНЕЦ КАК TypesDePayment
	|ИЗ
	|	ВТОбороты КАК ВТОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|		ПО ВТОбороты.Регистратор = ПриходныйКассовыйОрдер.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.ПриходныйКассовыйОрдер)
	|			ТОГДА ПриходныйКассовыйОрдер.ТипОплаты
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.ПоступлениеБезналичныхДенежныхСредств)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.TypesDePayment.VirementBanquaire)
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.СертификатНаОплату)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.TypesDePayment.Сертификат)
	|	КОНЕЦ
	|
	|ИМЕЮЩИЕ
	|	СУММА(-ВТОбороты.СуммаОборот) <> 0";
	Query.SetParameter("CurrentDoc",CurrentDoc);
	ValueTable = Query.Execute().Unload();
	Return ValueTable;
EndFunction
