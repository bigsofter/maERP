Функция ПолучитьТаблицуОкладовСотрудникаЗаМесяц(Период, Сотрудник)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Период КАК Период,
	                      |	ВЗ.Сотрудник,
	                      |	ВЗ.ВариантОклада,
	                      |	ВЗ.Оклад
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ЗПСрезПоследних.Период КАК Период,
	                      |		ЗПСрезПоследних.Сотрудник КАК Сотрудник,
	                      |		ЗПСрезПоследних.ВариантОклада КАК ВариантОклада,
	                      |		ЗПСрезПоследних.Оклад КАК Оклад
	                      |	ИЗ
	                      |		РегистрСведений.ТарифныеСтавки.СрезПоследних(&ДатаНач, Сотрудник = &Сотрудник) КАК ЗПСрезПоследних
						  //|	
						  //|	ОБЪЕДИНИТЬ ВСЕ
						  //|	
						  //|	ВЫБРАТЬ
						  //|		ЗП.Период,
						  //|		ЗП.Сотрудник,
						  //|		ЗП.ВариантОклада,
						  //|		ЗП.Оклад
						  //|	ИЗ
						  //|		РегистрСведений.ТарифныеСтавки КАК ЗП
						  //|	ГДЕ
						  //|		ЗП.Период МЕЖДУ &ДатаНач И &ДатаКон
						  //|		И ЗП.Сотрудник = &Сотрудник
	                      |) КАК ВЗ
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Период УБЫВ");
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(КонецМесяца(Период)));
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьОстаткиПоСотрудникам(Объект, МасСотрудники) Экспорт 
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Сотрудник КАК Сотрудник,
	                      |	СУММА(ВЗ.Сумма) КАК Сумма,
	                      |	ВЗ.СотрудникНаименование КАК СотрудникНаименование
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ЗарплатаОстатки.Сотрудник КАК Сотрудник,
	                      |		ЗарплатаОстатки.СуммаОстаток КАК Сумма,
	                      |		ЗарплатаОстатки.Сотрудник.Наименование КАК СотрудникНаименование
	                      |	ИЗ
	                      |		РегистрНакопления.Зарплата.Остатки(
	                      |				&НаДату,
	                      |				ВЫБОР
	                      |					КОГДА &ПоСпискуСотрудников
	                      |						ТОГДА Сотрудник В (&МасСотрудники)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ) КАК ЗарплатаОстатки
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		ЗарплатаОбороты.Сотрудник,
	                      |		ЗарплатаОбороты.СуммаОборот,
	                      |		ЗарплатаОбороты.Сотрудник.Наименование
	                      |	ИЗ
	                      |		(ВЫБРАТЬ
	                      |			СУММА(ЗарплатаОбороты.СуммаОборот) КАК СуммаОборот,
	                      |			ЗарплатаОбороты.Сотрудник КАК Сотрудник
	                      |		ИЗ
	                      |			РегистрНакопления.Зарплата.Обороты(
	                      |					НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ),
	                      |					КОНЕЦПЕРИОДА(&Период, МЕСЯЦ),
	                      |					Регистратор,
	                      |					ВЫБОР
	                      |						КОГДА &ПоСпискуСотрудников
	                      |							ТОГДА Сотрудник В (&МасСотрудники)
	                      |						ИНАЧЕ ИСТИНА
	                      |					КОНЕЦ) КАК ЗарплатаОбороты
	                      |		ГДЕ
	                      |			НЕ ЗарплатаОбороты.Регистратор = &Регистратор
	                      |		
	                      |		СГРУППИРОВАТЬ ПО
	                      |			ЗарплатаОбороты.Сотрудник) КАК ЗарплатаОбороты) КАК ВЗ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВЗ.Сотрудник,
	                      |	ВЗ.СотрудникНаименование
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ВЗ.СотрудникНаименование");
	Запрос.УстановитьПараметр("НаДату", КонецМесяца(НачалоМесяца(Объект.Дата)-1));
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("МасСотрудники",МасСотрудники);
	Запрос.УстановитьПараметр("ПоСпискуСотрудников",Не МасСотрудники.Количество() = 0);
	Запрос.УстановитьПараметр("Регистратор",Объект.Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти

