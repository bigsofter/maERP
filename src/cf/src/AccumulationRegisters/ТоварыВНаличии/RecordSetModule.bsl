// Привилегированный режим - осознанно: прежние позиции набора читаются для оповещения о минимальном остатке
// независимо от прав роли. BSLLS:SetPrivilegedMode-off

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Инвариант склада станка (учёт станков): прежние записи регистратора на складах станков - для сверки в ПриЗаписи.
	ТребованияНакладные.ПередЗаписьюТоваровВНаличии(ЭтотОбъект);
	ЗапомнитьПрежниеПозиции(Замещение);
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	Если Отказ Или ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Остаток склада станка не меньше закреплённого за требованиями-накладными - при любой записи и отмене проведения.
	ТребованияНакладные.ПриЗаписиТоваровВНаличии(ЭтотОбъект, Отказ, Замещение);
	Если Не Отказ Тогда
		ПроверитьМинимальныйОстаток();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Минимальный остаток (план warehouse-orders-cost, Ф5.4; прежде - набор ТоварыНаСкладах): пары «склад - номенклатура»
// прежних и новых записей набора, в том числе при отмене проведения. Промежуточная очистка движений при
// перепроведении (автоудаление) не оповещает - оповещает запись новых движений, ей прежние позиции передаёт документ.
// Налоговый документ на основаниях физически ничего не двигает - не оповещает (Редакция 49).
//
Процедура ПроверитьМинимальныйОстаток()
	Если Не ДополнительныеСвойства.Свойство(ИмяСвойстваПрежнихПозиций()) Тогда
		Возврат;
	КонецЕсли;
	Регистратор = Отбор.Регистратор.Значение;
	Если НалоговыеДокументыНаОснованиях.ЭтоРегистраторНаОснованиях(Регистратор) Тогда
		Возврат;
	КонецЕсли;
	Передано = Неопределено;
	ДополнительныеСвойства.Свойство(РегистрыНакопления.ТоварыВНаличии.ИмяСвойстваПозицийПерепроведения(), Передано);
	ДоОчистки = Передано = Неопределено Или Не Передано.ОчисткаПройдена;
	Если Количество() = 0 И ДоОчистки И РегистраторПроведен() Тогда
		Если Передано <> Неопределено Тогда
			Передано.ОчисткаПройдена = Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Позиции = ДополнительныеСвойства[ИмяСвойстваПрежнихПозиций()];
	Для Каждого Запись Из ЭтотОбъект Цикл
		ЗаполнитьЗначенияСвойств(Позиции.Добавить(), Запись);
	КонецЦикла;
	ПолеСклада = "МестоХранения";
	Позиции.Свернуть(ПолеСклада + ", Номенклатура");
	Склады = Позиции.Скопировать(, ПолеСклада);
	Склады.Свернуть(ПолеСклада);
	Для Каждого Строка Из Склады Цикл
		ПозицииСклада = Позиции.Скопировать(Новый Структура(ПолеСклада, Строка.МестоХранения));
		ПроцедурыРегламентныхЗаданий.ПроверкаМинимальногоОстатка(ПозицииСклада.ВыгрузитьКолонку("Номенклатура"),
			Строка.МестоХранения);
	КонецЦикла;
КонецПроцедуры

Процедура ЗапомнитьПрежниеПозиции(Замещение)
	Позиции = Новый ТаблицаЗначений;
	Позиции.Колонки.Добавить("МестоХранения", Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
	Позиции.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Если Замещение Тогда
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Записи.МестоХранения КАК МестоХранения,
		|	Записи.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии КАК Записи
		|ГДЕ
		|	Записи.Регистратор = &Регистратор");
		Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Позиции.Добавить(), Выборка);
		КонецЦикла;
	КонецЕсли;
	// Перепроведение с автоудалением движений: промежуточная очистка уже стёрла записи из базы, прежние позиции
	// документ передал набору до записи (РегистрыНакопления.ТоварыВНаличии.ЗапомнитьПозицииПередПерепроведением).
	Передано = Неопределено;
	Если ДополнительныеСвойства.Свойство(РегистрыНакопления.ТоварыВНаличии.ИмяСвойстваПозицийПерепроведения(),
		Передано) Тогда
		Для Каждого Позиция Из Передано.Позиции Цикл
			ЗаполнитьЗначенияСвойств(Позиции.Добавить(), Позиция);
		КонецЦикла;
	КонецЕсли;
	ДополнительныеСвойства.Вставить(ИмяСвойстваПрежнихПозиций(), Позиции);
КонецПроцедуры

Функция РегистраторПроведен()
	Регистратор = Отбор.Регистратор.Значение;
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(Регистратор));
	Если МетаданныеДокумента = Неопределено Или МетаданныеДокумента.Проведение
		<> Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		Возврат Ложь;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Регистратор, "Проведен") = Истина;
КонецФункции

Функция ИмяСвойстваПрежнихПозиций()
	Возврат "ПрежниеПозицииМинимальногоОстатка";
КонецФункции

#КонецОбласти
