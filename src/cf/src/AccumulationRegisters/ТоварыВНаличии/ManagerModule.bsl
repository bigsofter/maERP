
#Область Формирование_движений

Функция СформироватьДвижения(ДокОбъект) Экспорт
	Движения = ДокОбъект.Движения;
	#Область Подготовим_данные_для_проведения
   	Если ДокОбъект.ДополнительныеСвойства.Свойство("ТЗТоварыССериями") Тогда
		ТЗТоварыССериями = ДокОбъект.ДополнительныеСвойства.ТЗТоварыССериями.Скопировать();
	Иначе
		ТЗТоварыССериями = СерииИРазмещение.ОбъединитьТоварыССериями(ДокОбъект);
	КонецЕсли;
	Если ТЗТоварыССериями.Колонки.Найти("СуммаСНДС") <> Неопределено Тогда 
		ТЗТоварыССериями.Колонки.Удалить("Сумма");
		ТЗТоварыССериями.Колонки.СуммаСНДС.Имя = "Сумма";
	КонецЕсли;
	#КонецОбласти
	ДвиженияСформированы = Ложь;
	ТекстОшибки = "";
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда		
		ДобавитьДанныеОприходования(ТЗТоварыССериями, ДокОбъект);
		Движения.ТоварыВНаличии.Загрузить(ТЗТоварыССериями);
		РегистрыНакопления.ДополнительныеРасходы.РаспределитьНаСебестоимость(ДокОбъект);
		ДвиженияСформированы = Истина;
		Если ДвиженияСформированы И ЗначениеЗаполнено(ДокОбъект.МестоХранения.ПодчиненныйСклад) 
			И Не ДокОбъект.Контрагент = Справочники.Контрагенты.Migration Тогда
			ТЗТоварыВНаличии = Движения.ТоварыВНаличии.Выгрузить();
			Для Каждого Стр Из ТЗТоварыВНаличии Цикл
				Движение = Движения.ТоварыВНаличии.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.МестоХранения = ДокОбъект.МестоХранения.ПодчиненныйСклад;
			КонецЦикла;
			ТЗДополнительныеРасходы = Движения.ДополнительныеРасходы.Выгрузить();
			Для Каждого Стр Из ТЗДополнительныеРасходы Цикл
				Движение = Движения.ДополнительныеРасходы.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.МестоХранения = ДокОбъект.МестоХранения.ПодчиненныйСклад;	
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ОприходованиеТоваров") Тогда		
		ДобавитьДанныеОприходования(ТЗТоварыССериями, ДокОбъект);
		Движения.ТоварыВНаличии.Загрузить(ТЗТоварыССериями);
		ДвиженияСформированы = Истина;	
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		Если ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.НакладнаяПоОтгрузкамТовара Тогда
			Возврат Истина
		КонецЕсли;
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект, Ложь);
		Если ДвиженияСформированы Тогда
			РегистрыНакопления.ДополнительныеРасходы.РаспределитьНаСебестоимость(ДокОбъект);			
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.НалоговаяНакладная") Тогда
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект, Ложь);
		Если ДвиженияСформированы Тогда
			РегистрыНакопления.ДополнительныеРасходы.РаспределитьНаСебестоимость(ДокОбъект);			
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ОтгрузкаТовара") Тогда
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект, Ложь);
		Если ДвиженияСформированы Тогда
			РегистрыНакопления.ДополнительныеРасходы.РаспределитьНаСебестоимость(ДокОбъект);			
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СписаниеТоваров") Тогда
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);	
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПеремещениеТоваров") Тогда
		СкладСписания = ?(ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание,ДокОбъект.МестоХранения,Справочники.МестаХранения.StockEnCoursDeRoute);
		СкладОприходования = ?(ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание,Справочники.МестаХранения.StockEnCoursDeRoute,ДокОбъект.МестоХраненияОприходование);
		ТЗТоварыССериями.ЗаполнитьЗначения(СкладСписания, "МестоХранения");
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);	
		Если ДвиженияСформированы Тогда
			ТЗТоварыВНаличии = Движения.ТоварыВНаличии.Выгрузить();
			Для Каждого Стр Из ТЗТоварыВНаличии Цикл
				Движение = Движения.ТоварыВНаличии.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
				Движение.МестоХранения = СкладОприходования;
			КонецЦикла;
			ТЗДополнительныеРасходы = Движения.ДополнительныеРасходы.Выгрузить();
			Для Каждого Стр Из ТЗДополнительныеРасходы Цикл
				Движение = Движения.ДополнительныеРасходы.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
				Движение.МестоХранения = СкладОприходования;	
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПересортицаТоваров") Тогда	
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);	
		Если ДвиженияСформированы Тогда
			ТЗТоварыВНаличии = Движения.ТоварыВНаличии.Выгрузить();
			Для Каждого Стр Из Движения.ДополнительныеРасходы Цикл
				НС = ТЗТоварыВНаличии.Добавить();
				ЗаполнитьЗначенияСвойств(НС, Стр);
			КонецЦикла;
			ТЗТоварыВНаличии.Свернуть("Номенклатура, Характеристика, Серия", "Количество, Сумма");
			СуммаСписаноВсего = ТЗТоварыВНаличии.Итог("Сумма");
			СуммаОприходованияВсего = 0;
			Для Каждого Стр Из ДокОбъект.ТЧТовары Цикл
				КоличествоОприходование = ?(Стр.КоличествоОприходование > 0, Стр.КоличествоОприходование, Стр.Количество);
				Если Стр.ЦенаОприходование > 0 Тогда
					СуммаОприходование = КоличествоОприходование * Стр.ЦенаОприходование;
					СуммаОприходованияВсего = СуммаОприходованияВсего + СуммаОприходование;
					ДобавитьПриход(Движения, ДокОбъект.Дата, ДокОбъект.МестоХранения, Стр.НоменклатураОприходование, Стр.ХарактеристикаОприходование, Стр.СерияОприходование, ДокОбъект.Ссылка, ДокОбъект.Дата, КоличествоОприходование, СуммаОприходование); 	
				Иначе	
					МасТовары = ТЗТоварыВНаличии.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия));
					Для Каждого МасСтр Из МасТовары Цикл
						СуммаОприходование = ?(Стр.Количество = МасСтр.Количество, МасСтр.Сумма, Окр(МасСтр.Сумма / МасСтр.Количество * Стр.Количество, 2));
						СуммаОприходованияВсего = СуммаОприходованияВсего + СуммаОприходование;
						ДобавитьПриход(Движения, ДокОбъект.Дата, ДокОбъект.МестоХранения, Стр.НоменклатураОприходование, Стр.ХарактеристикаОприходование, Стр.СерияОприходование, ДокОбъект.Ссылка, ДокОбъект.Дата, КоличествоОприходование, СуммаОприходование);  	
						МасСтр.Количество = МасСтр.Количество - Стр.Количество;
						МасСтр.Сумма = МасСтр.Сумма - СуммаОприходование;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			ДокОбъект.ДополнительныеСвойства.Вставить("Убытки", СуммаСписаноВсего - СуммаОприходованияВсего); // Пробрасываем для формирования движений по регистру "Убытки"
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратОтПокупателя") Тогда
		СформироватьОприходованиеПоРеализации(ТЗТоварыССериями, ДокОбъект);
		ДвиженияСформированы = Истина; 
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратОтПокупателяНалоговый") Тогда
		СформироватьОприходованиеПоРеализации(ТЗТоварыССериями, ДокОбъект);
		ДвиженияСформированы = Истина; 
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику") Тогда 
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);
		Если ДвиженияСформированы И ЗначениеЗаполнено(ДокОбъект.МестоХранения.ПодчиненныйСклад) 
			И Не ДокОбъект.Контрагент = Справочники.Контрагенты.Migration Тогда
			ТЗТоварыВНаличии = Движения.ТоварыВНаличии.Выгрузить();
			Для Каждого Стр Из ТЗТоварыВНаличии Цикл
				Движение = Движения.ТоварыВНаличии.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.МестоХранения = ДокОбъект.МестоХранения.ПодчиненныйСклад;
			КонецЦикла;
			ТЗДополнительныеРасходы = Движения.ДополнительныеРасходы.Выгрузить();
			Для Каждого Стр Из ТЗДополнительныеРасходы Цикл
				Движение = Движения.ДополнительныеРасходы.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.МестоХранения = ДокОбъект.МестоХранения.ПодчиненныйСклад;	
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщикуНалоговый") Тогда 
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.АктРазбора") Тогда		
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);
		Если ДвиженияСформированы Тогда
			Себестоимость = Движения.ТоварыВНаличии.Итог("Сумма") + Движения.ДополнительныеРасходы.Итог("Сумма");
			СебестоимостьНачислено = 0;
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	ВЫБОР
			                      |		КОГДА ТЧТовары.Ссылка.МестоХраненияОприходование <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
			                      |				И (ТЧТовары.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			                      |					ИЛИ НЕ ТЧТовары.Характеристика.ДляВнутреннегоИспользования)
			                      |			ТОГДА ТЧТовары.Ссылка.МестоХраненияОприходование
			                      |		ИНАЧЕ ТЧТовары.Ссылка.МестоХранения
			                      |	КОНЕЦ КАК МестоХранения,
			                      |	ТЧТовары.Номенклатура КАК Номенклатура,
			                      |	ТЧТовары.Характеристика КАК Характеристика,
			                      |	ТЧТовары.Серия КАК Серия,
			                      |	ТЧТовары.Количество КАК Количество,
			                      |	ТЧТовары.ДоляСтоимости КАК ДоляСтоимости
			                      |ИЗ
			                      |	Документ.АктРазбора.ТЧТовары КАК ТЧТовары
			                      |ГДЕ
			                      |	ТЧТовары.Ссылка = &Док
			                      |
			                      |УПОРЯДОЧИТЬ ПО
			                      |	ДоляСтоимости");
			Запрос.УстановитьПараметр("Док", ДокОбъект.Ссылка);
			ТЗТовары = Запрос.Выполнить().Выгрузить();	
			ОбщаяДоля = ТЗТовары.Итог("ДоляСтоимости");
			Для А = 1 По ТЗТовары.Количество() Цикл
				Стр = ТЗТовары[А - 1];
				Если Стр.ДоляСтоимости = 0 Тогда 
					Сумма = 0;	
				Иначе	
					Сумма = ?(А = ТЗТовары.Количество(), Себестоимость - СебестоимостьНачислено, Окр(Себестоимость * (Стр.ДоляСтоимости / ОбщаяДоля), 2));
					СебестоимостьНачислено = СебестоимостьНачислено + Сумма;	
				КонецЕсли;	
				ДобавитьПриход(Движения, ДокОбъект.Дата, Стр.МестоХранения, Стр.Номенклатура, Стр.Характеристика, Стр.Серия, ДокОбъект.Ссылка, ДокОбъект.Дата, Стр.Количество, Сумма);	
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если ДвиженияСформированы Тогда
		Если Не Движения.Найти("Хозрасчетный") = Неопределено Тогда 
			РегистрыБухгалтерии.Хозрасчетный.СформироватьДвижения(ДокОбъект);
		КонецЕсли;
	КонецЕсли;
	Возврат ДвиженияСформированы;
КонецФункции
	
Процедура СформироватьОприходованиеПоРеализации(ТЗ, ДокОбъект)
	Движения = ДокОбъект.Движения;
	ВидДвиженияРасход = ВидДвиженияНакопления.Расход;
	Если ЗначениеЗаполнено(ДокОбъект.Основание) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ТоварыВНаличии.МестоХранения КАК МестоХранения,
		                      |	ТоварыВНаличии.Номенклатура КАК Номенклатура,
		                      |	ТоварыВНаличии.Характеристика КАК Характеристика,
		                      |	ТоварыВНаличии.Серия КАК Серия,
		                      |	ТоварыВНаличии.Партия КАК Партия,
		                      |	ТоварыВНаличии.ДатаПартии КАК ДатаПартии,
		                      |	ТоварыВНаличии.Количество КАК Количество,
		                      |	ТоварыВНаличии.Сумма КАК Сумма
		                      |ИЗ
		                      |	РегистрНакопления.ТоварыВНаличии КАК ТоварыВНаличии
		                      |ГДЕ
		                      |	ТоварыВНаличии.Регистратор = &Док
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ
		                      |	Издержки.МестоХранения КАК МестоХранения,
		                      |	Издержки.Номенклатура КАК Номенклатура,
		                      |	Издержки.Характеристика КАК Характеристика,
		                      |	Издержки.Серия КАК Серия,
		                      |	Издержки.Партия КАК Партия,
		                      |	Издержки.СтатьяДДС КАК СтатьяДДС,
		                      |	Издержки.Сумма КАК Сумма
		                      |ИЗ
		                      |	РегистрНакопления.ДополнительныеРасходы КАК Издержки
		                      |ГДЕ
		                      |	Издержки.Регистратор = &Док
		                      |	И Издержки.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)");
		Запрос.УстановитьПараметр("Док", ДокОбъект.Основание);
		Рез = Запрос.ВыполнитьПакет();
		ТЗПартииРеализации = Рез[0].Выгрузить();
		ТЗДополнительныеРасходыРеализации = Рез[1].Выгрузить();	
	Иначе
		// Партии реализации 
		ТЗПартииРеализации = Движения.ТоварыВНаличии.Выгрузить();
		ТЗПартииРеализации.Очистить();
		// Издержки реализации
		ТЗДополнительныеРасходыРеализации = Движения.ДополнительныеРасходы.Выгрузить();
		ТЗДополнительныеРасходыРеализации.Очистить();
	КонецЕсли;
	Для Каждого Стр Из ТЗ Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия);
		МасПартии = ТЗПартииРеализации.НайтиСтроки(Отбор);
		КоличествоВсего = Стр.Количество;
		Для Каждого СтрПартия Из МасПартии Цикл
			Количество = ?(КоличествоВсего > СтрПартия.Количество, СтрПартия.Количество, КоличествоВсего);
			Сумма = ?(Количество = СтрПартия.Количество, СтрПартия.Сумма, Окр(СтрПартия.Сумма / СтрПартия.Количество * Количество, 2));
			//Если Сумма = 0 Тогда Продолжить КонецЕсли;
			ДобавитьПриход(Движения, ДокОбъект.Дата, Стр.МестоХранения, Стр.Номенклатура, Стр.Характеристика, Стр.Серия, СтрПартия.Партия, СтрПартия.ДатаПартии, Количество, Сумма); 				
			КоличествоВсего = КоличествоВсего - Количество;
			// Издержки
			Отбор.Вставить("Партия", СтрПартия.Партия);
			МасДополнительныеРасходы = ТЗДополнительныеРасходыРеализации.НайтиСтроки(Отбор);
			Для Каждого СтрДополнительныйРасход Из МасДополнительныеРасходы Цикл
				СуммаИздержки = РассчитатьСуммуСписанияДополнительныхРасходов(Сумма, СтрПартия.Сумма, СтрДополнительныйРасход.Сумма);
				РегистрыНакопления.ДополнительныеРасходы.ДобавитьПриход(Движения, ДокОбъект.Дата, СтрДополнительныйРасход.МестоХранения, СтрДополнительныйРасход.Номенклатура, СтрДополнительныйРасход.Характеристика, СтрДополнительныйРасход.Серия, СтрДополнительныйРасход.Партия, СтрДополнительныйРасход.СтатьяДДС, СуммаИздержки);
				СтрДополнительныйРасход.Сумма = СтрДополнительныйРасход.Сумма - СуммаИздержки;
			КонецЦикла;
		КонецЦикла;
		Если КоличествоВсего > 0 Тогда
			Сумма = Окр(Стр.Сумма / Стр.Количество * КоличествоВсего, 2);
			ДобавитьПриход(Движения, ДокОбъект.Дата, Стр.МестоХранения, Стр.Номенклатура, Стр.Характеристика, Стр.Серия, ДокОбъект.Ссылка, ДокОбъект.Дата, КоличествоВсего, Сумма);
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

Процедура СформироватьОприходованиеПоВыпускуПродукции(ДокОбъект)
	Движения = ДокОбъект.Движения;
	ТЗПартии = Движения.ТоварыВНаличии.Выгрузить();
	ТЗДополнительныеРасходы = Движения.ДополнительныеРасходы.Выгрузить();	
	ТЗТовары = ДокОбъект.ТЧТовары.Выгрузить();
	//
	ТЗИнгредиенты = ДокОбъект.ТЧИнгредиенты.Выгрузить();
	ДокументПартии = ДокОбъект.Ссылка;
	//
	Для Каждого Стр Из ДокОбъект.ТЧТовары Цикл
		СуммаИтог = 0;
		МасИнгредиенты = ТЗИнгредиенты.НайтиСтроки(Новый Структура("КодСтрокиТовар", Стр.КодСтроки));
		Для Каждого МасСтр Из МасИнгредиенты Цикл
			Нужно = МасСтр.Количество;
			МасПартии = ТЗПартии.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Серия", МасСтр.Номенклатура, МасСтр.Характеристика, МасСтр.Серия));
			Для Каждого СтрПартия Из МасПартии Цикл
				Если СтрПартия.Количество = 0 Или Нужно = 0 Тогда Продолжить КонецЕсли;
				Количество = ?(Нужно > СтрПартия.Количество, СтрПартия.Количество, Нужно);
				СуммаПартии = ?(Количество = СтрПартия.Количество, СтрПартия.Сумма, Окр(СтрПартия.Сумма / СтрПартия.Количество * Количество, 2)); 												
				МасДополнительныеРасходы = ТЗДополнительныеРасходы.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Серия, Партия", СтрПартия.Номенклатура, СтрПартия.Характеристика, СтрПартия.Серия, СтрПартия.Партия));
				Для Каждого СтрДополнительныйРасход Из МасДополнительныеРасходы Цикл
					Если СтрДополнительныйРасход.Сумма = 0 Тогда Продолжить КонецЕсли;
					СуммаИздержки = РассчитатьСуммуСписанияДополнительныхРасходов(СуммаПартии, СтрПартия.Сумма, СтрДополнительныйРасход.Сумма);
					СтрДополнительныйРасход.Сумма = СтрДополнительныйРасход.Сумма - СуммаИздержки;
					СуммаИтог = СуммаИтог + СуммаИздержки;
				КонецЦикла;
				СтрПартия.Количество = СтрПартия.Количество - Количество;
				СтрПартия.Сумма = СтрПартия.Сумма - СуммаПартии;
				СуммаИтог = СуммаИтог + СуммаПартии;
				Нужно = Нужно - Количество;
			КонецЦикла;	
		КонецЦикла;
		ДобавитьПриход(Движения, ДокОбъект.Дата, ДокОбъект.МестоХраненияОприходование, Стр.Номенклатура, Стр.Характеристика, Стр.Серия, ДокументПартии, ДокОбъект.Дата, Стр.Количество, СуммаИтог);
	КонецЦикла;	
КонецПроцедуры	

Функция СписатьНоменклатуру(ТЗ, ДокОбъект, РазрешитьНедостачи = Ложь)
	// Получаем остатки
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(ТЗ.МестоХранения КАК Справочник.МестаХранения) КАК МестоХранения,
	                      |	ВЫРАЗИТЬ(ТЗ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(ТЗ.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	                      |	ВЫРАЗИТЬ(ТЗ.Серия КАК Справочник.СерииНоменклатуры) КАК Серия,
	                      |	ВЫРАЗИТЬ(ТЗ.Количество КАК ЧИСЛО) КАК Количество
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	&ТЗ КАК ТЗ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.МестоХранения КАК МестоХранения,
	                      |	ВТ.Номенклатура КАК Номенклатура,
	                      |	ВТ.Характеристика КАК Характеристика,
	                      |	ВТ.Серия КАК Серия,
	                      |	СУММА(ВТ.Количество) КАК Количество
	                      |ПОМЕСТИТЬ ВТТовары
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |ГДЕ
	                      |	НЕ ВТ.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТ.МестоХранения,
	                      |	ВТ.Номенклатура,
	                      |	ВТ.Характеристика,
	                      |	ВТ.Серия
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТТовары.МестоХранения КАК МестоХранения,
	                      |	ВТТовары.Номенклатура КАК Номенклатура,
	                      |	ВТТовары.Характеристика КАК Характеристика,
	                      |	ВТТовары.Серия КАК Серия,
	                      |	ЕСТЬNULL(ТоварыВНаличииОстатки.Партия, НЕОПРЕДЕЛЕНО) КАК Партия,
	                      |	ЕСТЬNULL(ТоварыВНаличииОстатки.ДатаПартии, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПартии,
	                      |	ВТТовары.Количество КАК Количество,
	                      |	ЕСТЬNULL(ТоварыВНаличииОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	                      |	ЕСТЬNULL(ТоварыВНаличииОстатки.СуммаОстаток, 0) КАК СуммаОстаток
	                      |ПОМЕСТИТЬ ВТТоварыВНаличии
	                      |ИЗ
	                      |	ВТТовары КАК ВТТовары
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВНаличии.Остатки(&ДатаОстатков, ) КАК ТоварыВНаличииОстатки
	                      |		ПО ВТТовары.МестоХранения = ТоварыВНаличииОстатки.МестоХранения
	                      |			И ВТТовары.Номенклатура = ТоварыВНаличииОстатки.Номенклатура
	                      |			И ВТТовары.Характеристика = ТоварыВНаличииОстатки.Характеристика
	                      |			И ВТТовары.Серия = ТоварыВНаличииОстатки.Серия
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТТовары.МестоХранения КАК МестоХранения,
	                      |	ВТТовары.Номенклатура КАК Номенклатура,
	                      |	ВТТовары.Характеристика КАК Характеристика,
	                      |	ВТТовары.Серия КАК Серия,
	                      |	ВТТовары.Количество КАК Количество
	                      |ИЗ
	                      |	ВТТовары КАК ВТТовары
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЗ.Серия КАК Серия,
	                      |	ВЗ.Количество КАК Количество,
	                      |	ВЗ.КоличествоОстаток КАК КоличествоОстаток,
	                      |	ВЗ.Количество <= ВЗ.КоличествоОстаток КАК МожноСписать
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТТоварыВНаличии.Номенклатура КАК Номенклатура,
	                      |		ВТТоварыВНаличии.Характеристика КАК Характеристика,
	                      |		ВТТоварыВНаличии.Серия КАК Серия,
	                      |		ВТТоварыВНаличии.Количество КАК Количество,
	                      |		СУММА(ВТТоварыВНаличии.КоличествоОстаток) КАК КоличествоОстаток
	                      |	ИЗ
	                      |		ВТТоварыВНаличии КАК ВТТоварыВНаличии
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		ВТТоварыВНаличии.Номенклатура,
	                      |		ВТТоварыВНаличии.Характеристика,
	                      |		ВТТоварыВНаличии.Количество,
	                      |		ВТТоварыВНаличии.Серия) КАК ВЗ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТТоварыВНаличии.МестоХранения КАК МестоХранения,
	                      |	ВТТоварыВНаличии.Номенклатура КАК Номенклатура,
	                      |	ВТТоварыВНаличии.Характеристика КАК Характеристика,
	                      |	ВТТоварыВНаличии.Серия КАК Серия,
	                      |	ВТТоварыВНаличии.Партия КАК Партия,
	                      |	ВТТоварыВНаличии.ДатаПартии КАК ДатаПартии,
	                      |	ВТТоварыВНаличии.КоличествоОстаток КАК Количество,
	                      |	ВТТоварыВНаличии.СуммаОстаток КАК Сумма
	                      |ИЗ
	                      |	ВТТоварыВНаличии КАК ВТТоварыВНаличии
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДатаПартии
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТТоварыВНаличии.МестоХранения КАК МестоХранения,
	                      |	ВТТоварыВНаличии.Номенклатура КАК Номенклатура,
	                      |	ВТТоварыВНаличии.Характеристика КАК Характеристика,
	                      |	ВТТоварыВНаличии.Серия КАК Серия,
	                      |	ВТТоварыВНаличии.Партия КАК Партия,
	                      |	ДополнительныеРасходыОстатки.СтатьяДДС КАК СтатьяДДС,
	                      |	ДополнительныеРасходыОстатки.СуммаОстаток КАК Сумма
	                      |ИЗ
	                      |	ВТТоварыВНаличии КАК ВТТоварыВНаличии
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ДополнительныеРасходы.Остатки(&ДатаОстатков, ) КАК ДополнительныеРасходыОстатки
	                      |		ПО ВТТоварыВНаличии.МестоХранения = ДополнительныеРасходыОстатки.МестоХранения
	                      |			И ВТТоварыВНаличии.Номенклатура = ДополнительныеРасходыОстатки.Номенклатура
	                      |			И ВТТоварыВНаличии.Характеристика = ДополнительныеРасходыОстатки.Характеристика
	                      |			И ВТТоварыВНаличии.Серия = ДополнительныеРасходыОстатки.Серия
	                      |			И ВТТоварыВНаличии.Партия = ДополнительныеРасходыОстатки.Партия");
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(ДокОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Период", ДокОбъект.Дата);
	Результат = Запрос.ВыполнитьПакет();
	// Получаем данные
	ТЗТовары = Результат[3].Выгрузить();
	ТЗКонтрольОстатков = Результат[4].Выгрузить();
	ТЗТоварыВНаличии = Результат[5].Выгрузить();
	ТЗДополнительныеРасходы = Результат[6].Выгрузить();
   	// Проверяем возможность списания
	ТекстОшибкиСписания = "";
	ЭтоИнтерфейсПродавца = ДокОбъект.ДополнительныеСвойства.Свойство("ЭтоИнтерфейсПродавца");
	Если Не РазрешитьНедостачи Тогда
		ТЗКонтрольОстатков = Результат[4].Выгрузить();
		Мас = ТЗКонтрольОстатков.НайтиСтроки(Новый Структура("МожноСписать", Ложь));
		Если Мас.Количество() > 0 Тогда			
			Для Каждого Стр Из Мас Цикл
				//Если ЭтоИнтерфейсПродавца Тогда
				//	ТекстОшибки = Нстр("fr = 'Erreur ('; ru = 'Ошибка ('; en = 'Error ('; es = 'Error ('") + ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Стр.Номенклатура, Стр.Характеристика, Стр.Серия) + 
				//			Нстр("fr = ""); contacter l'administrateur!""; ru = '); обратитесь к администратору!'; en = '); contact the administrator!'; es = '); ¡póngase en contacto con el administrador!'");
				//Иначе
					ТекстОшибки = Нстр("fr = 'Pas suffisant ('; ru = 'Недостаточно ('; en = 'Not enough ('; es = 'No es suficiente ('") + ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Стр.Номенклатура, Стр.Характеристика, Стр.Серия) + 
							Нстр("ru = ') Нужно: '; fr = ') Requis: '") + СокрЛП(Стр.Количество) + 
							Нстр("ru = '; остаток: '; fr = '; reste: '") + СокрЛП(Стр.КоличествоОстаток);
				//КонецЕсли;
				ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(ТекстОшибкиСписания, ТекстОшибки, "; " + Символы.ВК); 
			КонецЦикла;
			Если ОбщегоНазначенияПовтИсп.ЭтоФоновоеЗадание() или ДокОбъект.ДополнительныеСвойства.Свойство("ЭтоИнтерфейсПродавца") Тогда
				ДокОбъект.ДополнительныеСвойства.Вставить("ТекстОшибки", ТекстОшибкиСписания);	
			Иначе	
				Сообщить(ТекстОшибкиСписания);
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;	
	// Списываем партии
	Для Каждого Стр Из ТЗТовары Цикл
		КоличествоКСписанию = Стр.Количество;		
		// 
		Если РазрешитьНедостачи Тогда // Списываем только то количество, которое есть на остатках 
			Мас = ТЗКонтрольОстатков.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Серия, МожноСписать", Стр.Номенклатура, Стр.Характеристика, Стр.Серия, Ложь));
			Если Мас.Количество() > 0 Тогда
				КоличествоКСписанию = ?(Мас[0].КоличествоОстаток <= 0, 0, Мас[0].КоличествоОстаток);
				КоличествоНедостача = Стр.Количество - КоличествоКСписанию;
				ДобавитьНедостачу(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.МестоХранения, Стр.Номенклатура, Стр.Характеристика, Стр.Серия, КоличествоНедостача);
				//Если ЭтоИнтерфейсПродавца Тогда
				//	ТекстОшибки = Нстр("fr = 'Erreur ('; ru = 'Ошибка ('; en = 'Error ('; es = 'Error ('") + ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Стр.Номенклатура, Стр.Характеристика, Стр.Серия) + 
				//			Нстр("fr = ""); contacter l'administrateur!""; ru = '); обратитесь к администратору!'; en = '); contact the administrator!'; es = '); ¡póngase en contacto con el administrador!'");
				//иначе
					ТекстОшибки = Нстр("fr = 'Pas suffisant ('; ru = 'Недостаточно ('; en = 'Not enough ('; es = 'No es suficiente ('") + ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Стр.Номенклатура, Стр.Характеристика, Стр.Серия) + 
							Нстр("ru = ') Нужно: '; fr = ') Requis: '") + СокрЛП(Стр.Количество) + 
							Нстр("ru = '; остаток: '; fr = '; reste: '") + СокрЛП(КоличествоКСписанию);
				//КонецЕсли;
				ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(ТекстОшибкиСписания, ТекстОшибки, "; " + Символы.ВК);
				Если КоличествоКСписанию = 0 Тогда Продолжить КонецЕсли;
			КонецЕсли;			
		КонецЕсли;
		//
		Отбор = Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия);
		МасПартии = ТЗТоварыВНаличии.НайтиСтроки(Отбор);
		Для Каждого СтрПартия Из МасПартии Цикл
			Если СтрПартия.Количество <= 0 Тогда Продолжить КонецЕсли; // Чтоб не списать минусовую или нулевую партию
			Если КоличествоКСписанию = 0 Тогда Прервать КонецЕсли; // Если всё списали, тогда выходим
			Количество = ?(КоличествоКСписанию < СтрПартия.Количество, КоличествоКСписанию, СтрПартия.Количество);		
			Сумма = ?(Количество = СтрПартия.Количество, СтрПартия.Сумма, Окр(СтрПартия.Сумма / СтрПартия.Количество * Количество, 2));
			// Списываем издержки
			МасДополнительныеРасходы = ТЗДополнительныеРасходы.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Серия, Партия", СтрПартия.Номенклатура, СтрПартия.Характеристика, СтрПартия.Серия, СтрПартия.Партия));
			Для Каждого СтрДополнительныйРасход Из МасДополнительныеРасходы Цикл
				СуммаДополнительногоРасхода = РассчитатьСуммуСписанияДополнительныхРасходов(Сумма, СтрПартия.Сумма, СтрДополнительныйРасход.Сумма);
				РегистрыНакопления.ДополнительныеРасходы.ДобавитьРасход(ДокОбъект.Движения, ДокОбъект.Дата, СтрДополнительныйРасход.МестоХранения, СтрПартия.Номенклатура, СтрПартия.Характеристика, СтрПартия.Серия, СтрПартия.Партия, СтрДополнительныйРасход.СтатьяДДС, СуммаДополнительногоРасхода);
				СтрДополнительныйРасход.Сумма = СтрДополнительныйРасход.Сумма - СуммаДополнительногоРасхода;
			КонецЦикла;		
			// Списываем партии
			ДобавитьРасход(ДокОбъект.Движения, ДокОбъект.Дата, СтрПартия.МестоХранения, СтрПартия.Номенклатура, СтрПартия.Характеристика, СтрПартия.Серия, СтрПартия.Партия, СтрПартия.ДатаПартии, Количество, Сумма);
			// Уменьшаем данные
			КоличествоКСписанию = КоличествоКСписанию - Количество;
			СтрПартия.Количество = СтрПартия.Количество - Количество;
			СтрПартия.Сумма = СтрПартия.Сумма - Сумма;
		КонецЦикла;		
	КонецЦикла;
	Если Не ПустаяСтрока(ТекстОшибкиСписания) Тогда
		Если ОбщегоНазначенияПовтИсп.ЭтоФоновоеЗадание() Тогда
			ДокОбъект.ДополнительныеСвойства.Вставить("ТекстОшибки", ТекстОшибкиСписания);
		ИначеЕсли ЭтоИнтерфейсПродавца Тогда 
			ДокОбъект.ДополнительныеСвойства.Вставить("ТекстОшибки", ТекстОшибкиСписания);
		Иначе	
			Сообщить(ТекстОшибкиСписания);
		КонецЕсли;	
	КонецЕсли;	
	Возврат Истина;
КонецФункции

