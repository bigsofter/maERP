Процедура ДобавитьДанныеОприходования(ТЗТоварыССериями, ДокОбъект)
	ТЗТоварыССериями.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ТЗТоварыССериями.Колонки.Добавить("ВидДвижения", Новый ОписаниеТипов("ВидДвиженияНакопления"));
	ТЗТоварыССериями.Колонки.Добавить("Партия", Метаданные.ОпределяемыеТипы.ПриходныйДокументПартии.Тип);
	ТЗТоварыССериями.Колонки.Добавить("ДатаПартии", Новый ОписаниеТипов("Дата"));
	ТЗТоварыССериями.ЗаполнитьЗначения(ДокОбъект.Дата, "Период");
	ТЗТоварыССериями.ЗаполнитьЗначения(ВидДвиженияНакопления.Приход, "ВидДвижения");
	ТЗТоварыССериями.ЗаполнитьЗначения(ДокОбъект.Ссылка, "Партия");
	ТЗТоварыССериями.ЗаполнитьЗначения(ДокОбъект.Дата, "ДатаПартии");
КонецПроцедуры

// Часть суммы (например, НДС партии), приходящаяся на списываемую часть: пропорционально Часть/Целое.
//
// Параметры:
//  Сумма - Число - делимая сумма (НДС партии или издержки).
//  Часть - Число - списываемая сумма партии.
//  Целое - Число - полная сумма партии.
//
// Возвращаемое значение:
//  Число - доля суммы; вся сумма, если Часть = Целое; 0, если Целое = 0.
//
Функция ДоляСуммы(Сумма, Часть, Целое) Экспорт
	Если Часть = Целое Или Целое = 0 Тогда
		Возврат ?(Целое = 0, 0, Сумма);
	КонецЕсли;
	Возврат Окр(Сумма / Целое * Часть, РазрядностьСуммы());
КонецФункции

Функция РассчитатьСуммуСписанияДополнительныхРасходов(СуммаСписания, СуммаПартии, СуммаДополнительногоРасхода)
	Возврат ?(СуммаСписания = СуммаПартии, СуммаДополнительногоРасхода, Окр(СуммаДополнительногоРасхода / СуммаПартии * СуммаСписания, 2))
КонецФункции

Функция ПолучитьТоварыПоОрдеруИзОснований(Основание)
	МасОснований = Новый Массив;
	тзВремТоварыКРазмещению = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент().ТЧТовары.Выгрузить();
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		МасОснований.Добавить(Основание);
	КонецЕсли;
	Если МасОснований.Количество() = 0 тогда
		Возврат тзВремТоварыКРазмещению;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Ссылка В(&МасОснований)";
	Запрос.УстановитьПараметр("МасОснований",МасОснований);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТЗТоварыССериями = СерииИРазмещение.ОбъединитьТоварыССериями(Выборка.Ссылка);
		Для Каждого Стр из ТЗТоварыССериями Цикл
			НС = тзВремТоварыКРазмещению.Добавить();
			ЗаполнитьЗначенияСвойств(НС,Стр);
		КонецЦикла;
	КонецЦикла;
	тзВремТоварыКРазмещению.Свернуть("Номенклатура,Характеристика,Серия","Количество,СуммаСНДС");
	Возврат тзВремТоварыКРазмещению;
КонецФункции

Функция ПолучитьДопРасходыПоОрдеруИзОснований(Основание)
	МасОснований = Новый Массив;
	тзВремТоварыКРазмещению = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент().ТЧДополнительныеРасходы.Выгрузить();
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		МасОснований.Добавить(Основание);
	КонецЕсли;
	Если МасОснований.Количество() = 0 тогда
		Возврат тзВремТоварыКРазмещению;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Номенклатура КАК Номенклатура,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Характеристика КАК Характеристика,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.СтатьяДДС КАК СтатьяДДС,
	|	СУММА(ПоступлениеТоваровУслугТЧДополнительныеРасходы.Сумма) КАК Сумма
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧДополнительныеРасходы КАК ПоступлениеТоваровУслугТЧДополнительныеРасходы
	|ГДЕ
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Ссылка В(&МасОснований)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Номенклатура,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Ссылка,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.СтатьяДДС,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Характеристика";
	Запрос.УстановитьПараметр("МасОснований",МасОснований);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НС = тзВремТоварыКРазмещению.Добавить();
		ЗаполнитьЗначенияСвойств(НС,Выборка);
	КонецЦикла;
	тзВремТоварыКРазмещению.Свернуть("Номенклатура,Характеристика,СтатьяДДС","Сумма");
	Возврат тзВремТоварыКРазмещению;
КонецФункции

#КонецОбласти

