Функция ПолучитьСреднююЦенуПоОстаткам(Номенклатура, Характеристики, ДатаСреза) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЫБОР
	                      |		КОГДА ВЗ.Количество = 0
	                      |			ТОГДА 0
	                      |		ИНАЧЕ ВЫРАЗИТЬ(ВЗ.Сумма / ВЗ.Количество КАК ЧИСЛО(12, 2))
	                      |	КОНЕЦ КАК Цена
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВЗ.Номенклатура КАК Номенклатура,
	                      |		ВЗ.Характеристика КАК Характеристика,
	                      |		СУММА(ВЗ.Количество) КАК Количество,
	                      |		СУММА(ВЗ.Сумма) КАК Сумма
	                      |	ИЗ
	                      |		(ВЫБРАТЬ
	                      |			ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	                      |			ТоварыВНаличииОстатки.Характеристика КАК Характеристика,
	                      |			ТоварыВНаличииОстатки.КоличествоОстаток КАК Количество,
	                      |			ТоварыВНаличииОстатки.СуммаОстаток КАК Сумма
	                      |		ИЗ
	                      |			РегистрНакопления.ТоварыВНаличии.Остатки(
	                      |					&ДатаСреза,
	                      |					Номенклатура В (&Номенклатура)
	                      |						И Характеристика В (&Характеристики)) КАК ТоварыВНаличииОстатки
	                      |
	                      |		ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |		ВЫБРАТЬ
	                      |			ДополнительныеРасходы.Номенклатура,
	                      |			ДополнительныеРасходы.Характеристика,
	                      |			0,
	                      |			ДополнительныеРасходы.СуммаОстаток
	                      |		ИЗ
	                      |			РегистрНакопления.ДополнительныеРасходы.Остатки(
	                      |					&ДатаСреза,
	                      |					Номенклатура В (&Номенклатура)
	                      |						И Характеристика В (&Характеристики)) КАК ДополнительныеРасходы) КАК ВЗ
	                      |
	                      |	СГРУППИРОВАТЬ ПО
	                      |		ВЗ.Номенклатура,
	                      |		ВЗ.Характеристика) КАК ВЗ");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристики", Характеристики);
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьСреднююЦенуПоПоступлениям(Организация, Номенклатура, Характеристики, НачалоПериода, КонецПериода) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЫБОР
	                      |		КОГДА ВЗ.Количество = 0
	                      |			ТОГДА 0
	                      |		ИНАЧЕ ВЫРАЗИТЬ(ВЗ.Сумма / ВЗ.Количество КАК ЧИСЛО(12, 2))
	                      |	КОНЕЦ КАК Цена
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ТоварыВНаличииОбороты.Номенклатура КАК Номенклатура,
	                      |		ТоварыВНаличииОбороты.Характеристика КАК Характеристика,
	                      |		СУММА(ТоварыВНаличииОбороты.КоличествоПриход) КАК Количество,
	                      |		СУММА(ТоварыВНаличииОбороты.СуммаПриход) КАК Сумма
	                      |	ИЗ
	                      |		РегистрНакопления.ТоварыВНаличии.Обороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				Регистратор,
	                      |				Организация = &Организация
	                      |					И Номенклатура В (&Номенклатура)
	                      |					И Характеристика В (&Характеристики)) КАК ТоварыВНаличииОбороты
	                      |	ГДЕ
	                      |		ТоварыВНаличииОбороты.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
	                      |
	                      |	СГРУППИРОВАТЬ ПО
	                      |		ТоварыВНаличииОбороты.Номенклатура,
	                      |		ТоварыВНаличииОбороты.Характеристика) КАК ВЗ");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристики", Характеристики);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьСебестоимостьПоДокументу(Док) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.ВидДвижения КАК ВидДвижения,
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЗ.Серия КАК Серия,
	                      |	СУММА(ВЗ.Количество) КАК Количество,
	                      |	СУММА(ВЗ.Сумма) КАК Сумма,
	                      |	СУММА(ВЗ.СуммаНДС) КАК СуммаНДС
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ТоварыВНаличии.ВидДвижения КАК ВидДвижения,
	                      |		ТоварыВНаличии.Номенклатура КАК Номенклатура,
	                      |		ТоварыВНаличии.Характеристика КАК Характеристика,
	                      |		ТоварыВНаличии.Серия КАК Серия,
	                      |		ТоварыВНаличии.Количество КАК Количество,
	                      |		ТоварыВНаличии.Сумма КАК Сумма,
	                      |		ТоварыВНаличии.СуммаНДС КАК СуммаНДС
	                      |	ИЗ
	                      |		РегистрНакопления.ТоварыВНаличии КАК ТоварыВНаличии
	                      |	ГДЕ
	                      |		ТоварыВНаличии.Регистратор = &Регистратор
	                      |
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |	ВЫБРАТЬ
	                      |		ДополнительныеРасходы.ВидДвижения,
	                      |		ДополнительныеРасходы.Номенклатура,
	                      |		ДополнительныеРасходы.Характеристика,
	                      |		ДополнительныеРасходы.Серия,
	                      |		0,
	                      |		ДополнительныеРасходы.Сумма,
	                      |		ДополнительныеРасходы.СуммаНДС
	                      |	ИЗ
	                      |		РегистрНакопления.ДополнительныеРасходы КАК ДополнительныеРасходы
	                      |	ГДЕ
	                      |		ДополнительныеРасходы.Регистратор = &Регистратор) КАК ВЗ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВЗ.Номенклатура,
	                      |	ВЗ.Характеристика,
	                      |	ВЗ.ВидДвижения,
	                      |	ВЗ.Серия");
	Запрос.УстановитьПараметр("Регистратор", Док);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьТекущиеОбщиеОстатки() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	                      |	ТоварыВНаличииОстатки.Номенклатура.Единица КАК Единица,
	                      |	ТоварыВНаличииОстатки.КоличествоОстаток КАК Количество
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВНаличии.Остатки КАК ТоварыВНаличииОстатки");
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Возвращает текущий остаток номенклатуры по данным регистра.
//
// Параметры:
//  МестоХранения - СправочникСсылка.МестаХранения - склад; пустая ссылка: по всем складам.
//  Номенклатура - СправочникСсылка.Номенклатура - товар.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры, Неопределено - характеристика;
//                   пустая ссылка или Неопределено: сумма по всем характеристикам.
//
// Возвращаемое значение:
//  Число - остаток в единицах хранения, 0 при отсутствии остатка.
//
Функция ПолучитьОстатокПоТовару(МестоХранения, Номенклатура, Характеристика = Неопределено) Экспорт
	Условие = "Номенклатура = &Номенклатура";
	Если ЗначениеЗаполнено(МестоХранения) Тогда
		Условие = Условие + " И МестоХранения = &МестоХранения";
	КонецЕсли;
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Условие = Условие + " И Характеристика = &Характеристика";
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СУММА(ТоварыВНаличииОстатки.КоличествоОстаток) КАК Количество
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВНаличии.Остатки(, &Условие) КАК ТоварыВНаличииОстатки");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", Условие);
	Запрос.УстановитьПараметр("МестоХранения", МестоХранения);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Количество <> Null Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Заполняет колонку Остаток строк табличной части текущими остатками по складу одним запросом.
//
// Параметры:
//  Строки - ТабличнаяЧастьОбъекта, ДанныеФормыКоллекция, ТаблицаЗначений - строки с колонками
//           Номенклатура, Характеристика и Остаток.
//  МестоХранения - СправочникСсылка.МестаХранения - склад; пустая ссылка: по всем складам.
//
Процедура ЗаполнитьОстаткиСтрок(Строки, МестоХранения) Экспорт
	ТЗКлючи = Новый ТаблицаЗначений;
	ТЗКлючи.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗКлючи.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Для Каждого Стр Из Строки Цикл
		Стр.Остаток = 0;
		Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			ЗаполнитьЗначенияСвойств(ТЗКлючи.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Если ТЗКлючи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УсловиеСклада = ?(ЗначениеЗаполнено(МестоХранения), "МестоХранения = &МестоХранения И ", "");
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ВТ.Номенклатура КАК Номенклатура,
	                      |	ВТ.Характеристика КАК Характеристика
	                      |ПОМЕСТИТЬ ВТКлючи
	                      |ИЗ
	                      |	&ВТКлючи КАК ВТ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	                      |	ТоварыВНаличииОстатки.Характеристика КАК Характеристика,
	                      |	СУММА(ТоварыВНаличииОстатки.КоличествоОстаток) КАК Остаток
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВНаличии.Остатки(
	                      |			,
	                      |			&УсловиеСклада (Номенклатура, Характеристика) В
	                      |				(ВЫБРАТЬ
	                      |					ВТКлючи.Номенклатура,
	                      |					ВТКлючи.Характеристика
	                      |				ИЗ
	                      |					ВТКлючи КАК ВТКлючи)) КАК ТоварыВНаличииОстатки
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ТоварыВНаличииОстатки.Номенклатура,
	                      |	ТоварыВНаличииОстатки.Характеристика");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСклада ", УсловиеСклада);
	Запрос.УстановитьПараметр("ВТКлючи", ТЗКлючи);
	Запрос.УстановитьПараметр("МестоХранения", МестоХранения);
	ТЗОстатки = Запрос.Выполнить().Выгрузить();
	ТЗОстатки.Индексы.Добавить("Номенклатура, Характеристика");
	Для Каждого Стр Из Строки Цикл
		СтрокиОстатка = ТЗОстатки.НайтиСтроки(
			Новый Структура("Номенклатура, Характеристика", Стр.Номенклатура, Стр.Характеристика));
		Если СтрокиОстатка.Количество() > 0 Тогда
			Стр.Остаток = СтрокиОстатка[0].Остаток;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
