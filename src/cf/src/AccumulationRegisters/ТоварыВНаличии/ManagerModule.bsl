
#Область Формирование_движений

Функция СформироватьДвижения(ДокОбъект) Экспорт
	Движения = ДокОбъект.Движения;
	#Область Подготовим_данные_для_проведения
   	Если ДокОбъект.ДополнительныеСвойства.Свойство("ТЗТоварыССериями") Тогда
		ТЗТоварыССериями = ДокОбъект.ДополнительныеСвойства.ТЗТоварыССериями.Скопировать();
	Иначе
		ТЗТоварыССериями = СерииИРазмещение.ОбъединитьТоварыССериями(ДокОбъект);
	КонецЕсли;
	Если ТЗТоварыССериями.Колонки.Найти("СуммаСНДС") <> Неопределено Тогда
		ТЗТоварыССериями.Колонки.Удалить("Сумма");
		ТЗТоварыССериями.Колонки.СуммаСНДС.Имя = "Сумма";
	КонецЕсли;
	#КонецОбласти
	ДвиженияСформированы = Ложь;
	ТекстОшибки = "";
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		ДобавитьДанныеОприходования(ТЗТоварыССериями, ДокОбъект);
		Движения.ТоварыВНаличии.Загрузить(ТЗТоварыССериями);
		РегистрыНакопления.ДополнительныеРасходы.РаспределитьНаСебестоимость(ДокОбъект);
		ДвиженияСформированы = Истина;
		Если ДвиженияСформированы И ЗначениеЗаполнено(ДокОбъект.МестоХранения.ПодчиненныйСклад)
			И Не ДокОбъект.Контрагент = Справочники.Контрагенты.Migration Тогда
			ТЗТоварыВНаличии = Движения.ТоварыВНаличии.Выгрузить();
			Для Каждого Стр Из ТЗТоварыВНаличии Цикл
				Движение = Движения.ТоварыВНаличии.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.МестоХранения = ДокОбъект.МестоХранения.ПодчиненныйСклад;
			КонецЦикла;
			ТЗДополнительныеРасходы = Движения.ДополнительныеРасходы.Выгрузить();
			Для Каждого Стр Из ТЗДополнительныеРасходы Цикл
				Движение = Движения.ДополнительныеРасходы.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.МестоХранения = ДокОбъект.МестоХранения.ПодчиненныйСклад;
			КонецЦикла;
		КонецЕсли;
		// Склад, ордерный на дату записи, партий от поступления не получает: партию создаёт приходный ордер, стоимость
		// ему даёт ближний пересчёт (план warehouse-orders-cost, Ф3.4). Подчинённый неордерный склад - как раньше.
		ИсключитьЗаписиОрдерногоСклада(Движения.ТоварыВНаличии);
		ИсключитьЗаписиОрдерногоСклада(Движения.ДополнительныеРасходы);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ОприходованиеТоваров") Тогда
		ДобавитьДанныеОприходования(ТЗТоварыССериями, ДокОбъект);
		Движения.ТоварыВНаличии.Загрузить(ТЗТоварыССериями);
		ДвиженияСформированы = Истина;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		Если Справочники.МестаХранения.ОрдерныйСклад(ДокОбъект.МестоХранения, ДокОбъект.Дата) Тогда
			// На ордерном складе партии списывает расходный ордер, реализация - только финансы; себестоимость - по
			// парам оформления (план warehouse-orders-cost, Ф3.6).
			ДвиженияСформированы = Истина;
		Иначе
			ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект, Ложь);
			Если ДвиженияСформированы Тогда
				РегистрыНакопления.ДополнительныеРасходы.РаспределитьНаСебестоимость(ДокОбъект);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ЭтоНалоговыйДокумент(ДокОбъект) Тогда
		// Налоговые документы товар не двигают (решение владельца 2026-09-28): управленческий остаток
		// ведут реализация и поступление, белый учёт количеств - отдельным регистром (belyi-tovarnyi-uchet).
		// Признак «Налоговый» у склада по-прежнему обязателен.
		ДвиженияСформированы = СкладНалоговый(ДокОбъект);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СписаниеТоваров") Тогда
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПеремещениеТоваров") Тогда
		СкладСписания = ?(ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание,ДокОбъект.МестоХранения,Справочники.МестаХранения.StockEnCoursDeRoute);
		СкладОприходования = ?(ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеСписание,Справочники.МестаХранения.StockEnCoursDeRoute,ДокОбъект.МестоХраненияОприходование);
		ТЗТоварыССериями.ЗаполнитьЗначения(СкладСписания, "МестоХранения");
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);
		Если ДвиженияСформированы Тогда
			ТЗТоварыВНаличии = Движения.ТоварыВНаличии.Выгрузить();
			Для Каждого Стр Из ТЗТоварыВНаличии Цикл
				Движение = Движения.ТоварыВНаличии.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
				Движение.МестоХранения = СкладОприходования;
			КонецЦикла;
			ТЗДополнительныеРасходы = Движения.ДополнительныеРасходы.Выгрузить();
			Для Каждого Стр Из ТЗДополнительныеРасходы Цикл
				Движение = Движения.ДополнительныеРасходы.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
				Движение.МестоХранения = СкладОприходования;
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПересортицаТоваров") Тогда
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);
		Если ДвиженияСформированы Тогда
			ТЗТоварыВНаличии = Движения.ТоварыВНаличии.Выгрузить();
			Для Каждого Стр Из Движения.ДополнительныеРасходы Цикл
				НС = ТЗТоварыВНаличии.Добавить();
				ЗаполнитьЗначенияСвойств(НС, Стр);
			КонецЦикла;
			ТЗТоварыВНаличии.Свернуть("Номенклатура, Характеристика, Серия", "Количество, Сумма, СуммаНДС");
			СуммаСписаноВсего = ТЗТоварыВНаличии.Итог("Сумма");
			СуммаОприходованияВсего = 0;
			Для Каждого Стр Из ДокОбъект.ТЧТовары Цикл
				КоличествоОприходование = ?(Стр.КоличествоОприходование > 0, Стр.КоличествоОприходование, Стр.Количество);
				Если Стр.ЦенаОприходование > 0 Тогда
					СуммаОприходование = КоличествоОприходование * Стр.ЦенаОприходование;
					СуммаОприходованияВсего = СуммаОприходованияВсего + СуммаОприходование;
					ДобавитьПриход(Движения, ДокОбъект.Дата, ДокОбъект.МестоХранения, Стр.НоменклатураОприходование, Стр.ХарактеристикаОприходование, Стр.СерияОприходование, ДокОбъект.Ссылка, ДокОбъект.Дата, КоличествоОприходование, СуммаОприходование);
				Иначе
					МасТовары = ТЗТоварыВНаличии.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия));
					Для Каждого МасСтр Из МасТовары Цикл
						СуммаОприходование = ?(Стр.Количество = МасСтр.Количество, МасСтр.Сумма, Окр(МасСтр.Сумма / МасСтр.Количество * Стр.Количество, 2));
						СуммаНДСОприходование = ДоляСуммы(МасСтр.СуммаНДС, СуммаОприходование, МасСтр.Сумма);
						СуммаОприходованияВсего = СуммаОприходованияВсего + СуммаОприходование;
						ДобавитьПриход(Движения, ДокОбъект.Дата, ДокОбъект.МестоХранения, Стр.НоменклатураОприходование, Стр.ХарактеристикаОприходование, Стр.СерияОприходование, ДокОбъект.Ссылка, ДокОбъект.Дата, КоличествоОприходование, СуммаОприходование, СуммаНДСОприходование);
						МасСтр.Количество = МасСтр.Количество - Стр.Количество;
						МасСтр.Сумма = МасСтр.Сумма - СуммаОприходование;
						МасСтр.СуммаНДС = МасСтр.СуммаНДС - СуммаНДСОприходование;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			ДокОбъект.ДополнительныеСвойства.Вставить("Убытки", СуммаСписаноВсего - СуммаОприходованияВсего); // Пробрасываем для формирования движений по регистру "Убытки"
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратОтПокупателя") Тогда
		ДвиженияСформированы = СформироватьОприходованиеПоРеализации(ТЗТоварыССериями, ДокОбъект);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику") Тогда
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);
		Если ДвиженияСформированы И ЗначениеЗаполнено(ДокОбъект.МестоХранения.ПодчиненныйСклад)
			И Не ДокОбъект.Контрагент = Справочники.Контрагенты.Migration Тогда
			ТЗТоварыВНаличии = Движения.ТоварыВНаличии.Выгрузить();
			Для Каждого Стр Из ТЗТоварыВНаличии Цикл
				Движение = Движения.ТоварыВНаличии.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.МестоХранения = ДокОбъект.МестоХранения.ПодчиненныйСклад;
			КонецЦикла;
			ТЗДополнительныеРасходы = Движения.ДополнительныеРасходы.Выгрузить();
			Для Каждого Стр Из ТЗДополнительныеРасходы Цикл
				Движение = Движения.ДополнительныеРасходы.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, Стр);
				Движение.МестоХранения = ДокОбъект.МестоХранения.ПодчиненныйСклад;
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.АктРазбора") Тогда
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);
		Если ДвиженияСформированы Тогда
			СформироватьОприходованиеПоАктуРазбора(ДокОбъект);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВыпускПродукции") Тогда
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);
		Если ДвиженияСформированы Тогда
			СформироватьОприходованиеПоВыпускуПродукции(ДокОбъект, ТЗТоварыССериями);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ТребованиеНакладная") Тогда
		// Перемещение материалов на склад станка: строки уже разложены по партиям склада-источника
		// (ТребованияНакладные.РазложитьПоПартиям), приход - теми же партиями, суммами, НДС и доп. расходами.
		ДвиженияСформированы = СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект);
		// Пересчет последовательности приходует на склад станка из записанного перемещения, а не из текущей карточки
		// станка: перемещение неизменно (ТребованияНакладные.ПересчитатьСтоимостьТребования).
		СкладПрихода = Неопределено;
		Если Не ДокОбъект.ДополнительныеСвойства.Свойство("СкладПриходаПеремещения", СкладПрихода) Тогда
			СкладПрихода = ТребованияНакладные.СкладСтанка(ДокОбъект.Станок);
		КонецЕсли;
		Если ДвиженияСформированы Тогда
			ОприходоватьСписанное(Движения, СкладПрихода);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПередачаВПереработку")
		Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеИзПереработки") Тогда
		ДвиженияСформированы = СформироватьДвиженияПереработки(ДокОбъект, ТЗТоварыССериями);
	КонецЕсли;
	Если ДвиженияСформированы Тогда
		Если Не Движения.Найти("Хозрасчетный") = Неопределено Тогда
			РегистрыБухгалтерии.Хозрасчетный.СформироватьДвижения(ДокОбъект);
		КонецЕсли;
	КонецЕсли;
	Возврат ДвиженияСформированы;
КонецФункции

// Приходует на склад всё, что документ уже списал: те же партии, суммы, НДС и дополнительные расходы (перемещение).
//
// Параметры:
//  Движения - КоллекцияДвижений - движения документа со сформированным списанием
//  Склад    - СправочникСсылка.МестаХранения - склад прихода
//
Процедура ОприходоватьСписанное(Движения, Склад)
	Для Каждого Стр Из Движения.ТоварыВНаличии.Выгрузить() Цикл
		Движение = Движения.ТоварыВНаличии.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Стр);
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.МестоХранения = Склад;
	КонецЦикла;
	Для Каждого Стр Из Движения.ДополнительныеРасходы.Выгрузить() Цикл
		Движение = Движения.ДополнительныеРасходы.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Стр);
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.МестоХранения = Склад;
	КонецЦикла;
КонецПроцедуры

// Оприходование возврата от покупателя. Источник партий и допрасходов - себестоимость продаж основания за вычетом
// возвратов того же основания строго раньше текущего (СебестоимостьПродаж.ИсточникВозврата, план
// warehouse-orders-cost, Ф2.3); строки возврата расходуют общий остаток - одна партия не восстанавливается дважды ни
// разными строками, ни разными возвратами. Восстановленные части пишутся сторно в СебестоимостьПродаж; нехватка партий
// основания (комплект, превышение) - приход партией самого возврата по сумме строки, без себестоимости продаж.
//
// Источник, отсечённый отбором «отгрузка раньше возврата» (расходный ордер позже возврата), - отказ: такой товар ещё
// не отгружен, приходовать его новой партией нельзя (план warehouse-orders-cost, Ф3.11).
//
// Параметры:
//  ТЗ        - ТаблицаЗначений - строки возврата с сериями
//  ДокОбъект - ДокументОбъект.ВозвратОтПокупателя - проводимый возврат
//
// Возвращаемое значение:
//  Булево - движения сформированы; Ложь - отказ (текст сообщён).
//
Функция СформироватьОприходованиеПоРеализации(ТЗ, ДокОбъект)
	Движения = ДокОбъект.Движения;
	// Себестоимость продаж возврата формируется заново и при пустом основании (повторное проведение экземпляра).
	Движения.СебестоимостьПродаж.Очистить();
	Восстановлено = РегистрыНакопления.СебестоимостьПродаж.НоваяТаблицаВосстановленного();
	Если ЗначениеЗаполнено(ДокОбъект.Основание) Тогда
		Источник = РегистрыНакопления.СебестоимостьПродаж.ИсточникВозврата(ДокОбъект);
		ТЗПартииРеализации = Источник.Партии;
		ТЗДополнительныеРасходыРеализации = Источник.Допрасходы;
	Иначе
		Источник = Неопределено;
		ТЗПартииРеализации = Новый ТаблицаЗначений;
		ТЗДополнительныеРасходыРеализации = Новый ТаблицаЗначений;
	КонецЕсли;
	Для Каждого Стр Из ТЗ Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия);
		МасПартии = ?(Источник = Неопределено, Новый Массив, ТЗПартииРеализации.НайтиСтроки(Отбор));
		КоличествоВсего = Стр.Количество;
		Для Каждого СтрПартия Из МасПартии Цикл
			Если КоличествоВсего <= 0 Или СтрПартия.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Количество = ?(КоличествоВсего > СтрПартия.Количество, СтрПартия.Количество, КоличествоВсего);
			Сумма = ?(Количество = СтрПартия.Количество, СтрПартия.Сумма, Окр(СтрПартия.Сумма / СтрПартия.Количество * Количество, 2));
			СуммаНДС = ДоляСуммы(СтрПартия.СуммаНДС, Сумма, СтрПартия.Сумма);
			ДобавитьПриход(Движения, ДокОбъект.Дата, Стр.МестоХранения, Стр.Номенклатура, Стр.Характеристика, Стр.Серия, СтрПартия.Партия, СтрПартия.ДатаПартии, Количество, Сумма, СуммаНДС);
			ДобавитьВосстановленное(Восстановлено, СтрПартия, Ложь, Количество, Сумма, СуммаНДС);
			КоличествоВсего = КоличествоВсего - Количество;
			// Издержки партии - своего склада списания
			Отбор.Вставить("Партия", СтрПартия.Партия);
			Отбор.Вставить("МестоХранения", СтрПартия.МестоХранения);
			МасДополнительныеРасходы = ТЗДополнительныеРасходыРеализации.НайтиСтроки(Отбор);
			Для Каждого СтрДополнительныйРасход Из МасДополнительныеРасходы Цикл
				СуммаИздержки = РассчитатьСуммуСписанияДополнительныхРасходов(Сумма, СтрПартия.Сумма, СтрДополнительныйРасход.Сумма,
					Количество, СтрПартия.Количество);
				СуммаНДСИздержки = ДоляСуммы(СтрДополнительныйРасход.СуммаНДС, СуммаИздержки, СтрДополнительныйРасход.Сумма);
				РегистрыНакопления.ДополнительныеРасходы.ДобавитьПриход(Движения, ДокОбъект.Дата, СтрДополнительныйРасход.МестоХранения, СтрДополнительныйРасход.Номенклатура, СтрДополнительныйРасход.Характеристика, СтрДополнительныйРасход.Серия, СтрДополнительныйРасход.Партия, СтрДополнительныйРасход.СтатьяДДС, СуммаИздержки, СуммаНДСИздержки);
				Если СуммаИздержки <> 0 Тогда
					ДобавитьВосстановленное(Восстановлено, СтрДополнительныйРасход, Истина, 0, СуммаИздержки, СуммаНДСИздержки);
				КонецЕсли;
				СтрДополнительныйРасход.Сумма = СтрДополнительныйРасход.Сумма - СуммаИздержки;
				СтрДополнительныйРасход.СуммаНДС = СтрДополнительныйРасход.СуммаНДС - СуммаНДСИздержки;
			КонецЦикла;
			СтрПартия.Количество = СтрПартия.Количество - Количество;
			СтрПартия.Сумма = СтрПартия.Сумма - Сумма;
			СтрПартия.СуммаНДС = СтрПартия.СуммаНДС - СуммаНДС;
		КонецЦикла;
		Если КоличествоВсего > 0 И Источник <> Неопределено
			И Источник.ОтгруженоПозже.НайтиСтроки(Отбор(Стр)).Количество() > 0 Тогда
			Шаблон = НСтр("ru = 'Товар %1: отгружен расходным ордером позже возврата - вернуть можно только отгруженное.';
				|fr = 'Article %1 : expédié par un bon de sortie postérieur au retour - seul l''expédié peut être retourné.';
				|en = 'Item %1: shipped by an issue order later than the return - only shipped goods can be returned.';
				|es = 'Artículo %1: enviado con una orden de salida posterior a la devolución - solo se devuelve lo enviado.'");
			СообщитьОбОшибкеСписания(ДокОбъект, СтрШаблон(Шаблон, Стр.Номенклатура));
			Возврат Ложь;
		КонецЕсли;
		// Ордерный склад (Ф4.7, Р4.4): сверх отгруженного ордерами - отказ, а не приход по цене возврата; комплект - как
		// прежде (TECHDEBT фазы 2).
		Если КоличествоВсего > 0 И ВозвратСверхОтгрузкиОрдерами(ДокОбъект, Стр) Тогда
			Шаблон = НСтр("ru = 'Товар %1: по реализации ордерного склада вернуть можно только отгруженное ордерами.';
				|fr = 'Article %1 : pour une vente d''entrepôt à bons, seul l''expédié par bons peut être retourné.';
				|en = 'Item %1: for an order-based warehouse sale only goods shipped by orders can be returned.';
				|es = 'Artículo %1: en una venta de almacén con órdenes solo se devuelve lo enviado por órdenes.'");
			СообщитьОбОшибкеСписания(ДокОбъект, СтрШаблон(Шаблон, Стр.Номенклатура));
			Возврат Ложь;
		КонецЕсли;
		Если КоличествоВсего > 0 Тогда
			Сумма = Окр(Стр.Сумма / Стр.Количество * КоличествоВсего, 2);
			СуммаНДС = ?(ТЗ.Колонки.Найти("СуммаНДС") = Неопределено, 0, ДоляСуммы(Стр.СуммаНДС, Сумма, Стр.Сумма));
			ДобавитьПриход(Движения, ДокОбъект.Дата, Стр.МестоХранения, Стр.Номенклатура, Стр.Характеристика, Стр.Серия, ДокОбъект.Ссылка, ДокОбъект.Дата, КоличествоВсего, Сумма, СуммаНДС);
		КонецЕсли;
	КонецЦикла;
	Если Источник <> Неопределено Тогда
		РегистрыНакопления.СебестоимостьПродаж.ЗаписатьСторноВозврата(ДокОбъект, Источник, Восстановлено);
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ВозвратСверхОтгрузкиОрдерами(ДокОбъект, Стр)
	Если ТипЗнч(ДокОбъект.Основание) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Или Не ЗначениеЗаполнено(ДокОбъект.Основание) Тогда
		Возврат Ложь;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОбъект.Основание, "МестоХранения, Дата");
	Если Не Справочники.МестаХранения.ОрдерныйСклад(Реквизиты.МестоХранения, Реквизиты.Дата) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Номенклатура, "ТипНоменклатуры")
		<> Перечисления.ТипыНоменклатуры.Комплект;
КонецФункции

Функция Отбор(Стр)
	Возврат Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия);
КонецФункции

// Удаляет из набора движений записи на складах, ордерных на дату записи (см. ТоварыНаСкладах.
// ИсключитьЗаписиОрдерногоСклада: тот же критерий).
//
// Параметры:
//  Набор - РегистрНакопленияНаборЗаписей - набор движений поступления.
//
Процедура ИсключитьЗаписиОрдерногоСклада(Набор)
	Если Набор.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Записи = Набор.Выгрузить();
	Регистратор = Набор.Отбор.Регистратор.Значение;
	РегистрыНакопления.ТоварыНаСкладах.ИсключитьЗаписиОрдерногоСклада(Записи, Регистратор);
	Если Записи.Количество() <> Набор.Количество() Тогда
		Набор.Загрузить(Записи);
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьВосстановленное(Восстановлено, СтрокаИсточника, ДополнительныйРасход, Количество, Сумма, СуммаНДС)
	Строка = Восстановлено.Добавить();
	// У строки допрасходов колонки Количество нет - исключаются только суммы, количество задается ниже.
	ЗаполнитьЗначенияСвойств(Строка, СтрокаИсточника, , "Сумма, СуммаНДС");
	Строка.ДополнительныйРасход = ДополнительныйРасход;
	Строка.Количество = Количество;
	Строка.Сумма = Сумма;
	Строка.СуммаНДС = СуммаНДС;
КонецПроцедуры

// Оприходование составляющих по акту разбора: себестоимость и НДС списанного изделия
// распределяются по строкам ТЧТовары пропорционально доле стоимости.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.АктРазбора - проводимый документ
//
Процедура СформироватьОприходованиеПоАктуРазбора(ДокОбъект)
	Движения = ДокОбъект.Движения;
	Себестоимость = Движения.ТоварыВНаличии.Итог("Сумма") + Движения.ДополнительныеРасходы.Итог("Сумма");
	СебестоимостьНДС = Движения.ТоварыВНаличии.Итог("СуммаНДС") + Движения.ДополнительныеРасходы.Итог("СуммаНДС");
	СебестоимостьНачислено = 0;
	СебестоимостьНДСНачислено = 0;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫБОР
	                      |		КОГДА ТЧТовары.Ссылка.МестоХраненияОприходование <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
	                      |				И (ТЧТовары.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	                      |					ИЛИ НЕ ТЧТовары.Характеристика.ДляВнутреннегоИспользования)
	                      |			ТОГДА ТЧТовары.Ссылка.МестоХраненияОприходование
	                      |		ИНАЧЕ ТЧТовары.Ссылка.МестоХранения
	                      |	КОНЕЦ КАК МестоХранения,
	                      |	ТЧТовары.Номенклатура КАК Номенклатура,
	                      |	ТЧТовары.Характеристика КАК Характеристика,
	                      |	ТЧТовары.Серия КАК Серия,
	                      |	ТЧТовары.Количество КАК Количество,
	                      |	ТЧТовары.ДоляСтоимости КАК ДоляСтоимости
	                      |ИЗ
	                      |	Документ.АктРазбора.ТЧТовары КАК ТЧТовары
	                      |ГДЕ
	                      |	ТЧТовары.Ссылка = &Док
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДоляСтоимости");
	Запрос.УстановитьПараметр("Док", ДокОбъект.Ссылка);
	ТЗТовары = Запрос.Выполнить().Выгрузить();
	ОбщаяДоля = ТЗТовары.Итог("ДоляСтоимости");
	Для А = 1 По ТЗТовары.Количество() Цикл
		Стр = ТЗТовары[А - 1];
		Если Стр.ДоляСтоимости = 0 Тогда
			Сумма = 0;
			СуммаНДС = 0;
		Иначе
			Сумма = ?(А = ТЗТовары.Количество(), Себестоимость - СебестоимостьНачислено, Окр(Себестоимость * (Стр.ДоляСтоимости / ОбщаяДоля), 2));
			СебестоимостьНачислено = СебестоимостьНачислено + Сумма;
			СуммаНДС = ?(А = ТЗТовары.Количество(), СебестоимостьНДС - СебестоимостьНДСНачислено,
				Окр(СебестоимостьНДС * (Стр.ДоляСтоимости / ОбщаяДоля), РазрядностьСуммы()));
			СебестоимостьНДСНачислено = СебестоимостьНДСНачислено + СуммаНДС;
		КонецЕсли;
		ДобавитьПриход(Движения, ДокОбъект.Дата, Стр.МестоХранения, Стр.Номенклатура, Стр.Характеристика, Стр.Серия, ДокОбъект.Ссылка, ДокОбъект.Дата, Стр.Количество, Сумма, СуммаНДС);
	КонецЦикла;

КонецПроцедуры

// Оприходование выпущенной продукции.
//
// Выпускаемые позиции заданы в ТЧГотоваяПродукция и приходуются на место хранения
// оприходования. Себестоимость берётся из уже сформированных движений списания
// компонентов из ТЧТовары вместе с распределёнными на них издержками; к ней
// добавляется стоимость строк ТЧТовары с услугами (работы сторонних
// исполнителей), которые со склада не списываются. Между позициями продукции
// себестоимость распределяется по весам технологических карт
// (см. РаспределитьСебестоимостьНаПродукцию).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВыпускПродукции - проводимый документ
//  ТЗТоварыССериями - ТаблицаЗначений - строки ТЧТовары документа, по которым выполнялось списание
//
Процедура СформироватьОприходованиеПоВыпускуПродукции(ДокОбъект, ТЗТоварыССериями)
	Движения = ДокОбъект.Движения;
	Себестоимость = Движения.ТоварыВНаличии.Итог("Сумма") + Движения.ДополнительныеРасходы.Итог("Сумма")
		+ СтоимостьУслугВыпуска(ТЗТоварыССериями);
	СебестоимостьНДС = Движения.ТоварыВНаличии.Итог("СуммаНДС") + Движения.ДополнительныеРасходы.Итог("СуммаНДС");
	РаспределитьСебестоимостьНаПродукцию(ДокОбъект, ДокОбъект.МестоХраненияОприходование, Себестоимость, СебестоимостьНДС);
КонецПроцедуры

Функция СформироватьДвиженияПереработки(ДокОбъект, ТЗТоварыССериями)
	// Передача: списание со склада по партиям, затем приход тех же партий у переработчика.
	// Поступление: расход сырья у переработчика, затем приход продукции по сумме расхода.
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПередачаВПереработку") Тогда
		Если Не СписатьНоменклатуру(ТЗТоварыССериями, ДокОбъект) Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат РегистрыНакопления.ТоварыВПереработке.СформироватьДвижения(ДокОбъект, ТЗТоварыССериями);
	КонецЕсли;
	Если Не РегистрыНакопления.ТоварыВПереработке.СформироватьДвижения(ДокОбъект, ТЗТоварыССериями) Тогда
		Возврат Ложь;
	КонецЕсли;
	СформироватьОприходованиеПоПоступлениюИзПереработки(ДокОбъект);
	Возврат Истина;
КонецФункции

// Оприходование продукции, полученной от переработчика.
//
// Себестоимость списанного у переработчика сырья (движения ТоварыВПереработке документа)
// распределяется на строки ТЧГотоваяПродукция (см. РаспределитьСебестоимостьНаПродукцию).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеИзПереработки - проводимый документ
//
Процедура СформироватьОприходованиеПоПоступлениюИзПереработки(ДокОбъект)
	// К себестоимости сырья добавляется стоимость услуг переработчика (решение владельца
	// 2026-08-25): услуга капитализируется, её НДС попадает в НДС партии.
	ТЗРасход = ДокОбъект.Движения.ТоварыВПереработке.Выгрузить();
	// Услуги переработчика - в валюте документа: в себестоимость - в основной валюте по его курсу.
	Курс = РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс;
	УслугиСтрок = УслугиСтрокПоступления(ДокОбъект);
	Если УслугиСтрок = Неопределено Тогда
		// Услуги не разнесены по строкам (документ не прошёл обработчик 2.0.15.48, загрузка) - прежнее правило:
		// шапка услуг делится по весам вместе с сырьём.
		РаспределитьСебестоимостьНаПродукцию(ДокОбъект, ДокОбъект.МестоХранения,
			ТЗРасход.Итог("Сумма") + РаботаСВалютамиКлиентСервер.СуммаРегл(ДокОбъект.СтоимостьУслуг, Курс),
			ТЗРасход.Итог("СуммаНДС") + РаботаСВалютамиКлиентСервер.СуммаРегл(ДокОбъект.СуммаНДСУслуг, Курс));
	Иначе
		УслугиСтрок.Суммы = РаботаСВалютами.СуммыСтрокВОсновнойВалюте(УслугиСтрок.Суммы, Курс);
		УслугиСтрок.НДС = РаботаСВалютами.СуммыСтрокВОсновнойВалюте(УслугиСтрок.НДС, Курс);
		РаспределитьСебестоимостьНаПродукцию(ДокОбъект, ДокОбъект.МестоХранения,
			ТЗРасход.Итог("Сумма"), ТЗРасход.Итог("СуммаНДС"), УслугиСтрок);
	КонецЕсли;
КонецПроцедуры

// Услуги переработчика по строкам продукции поступления для оприходования (S6, решение владельца 3): стоимость -
// из строки, НДС услуг документа - пропорционально стоимости услуг строки, остаток округления - на последнюю строку с
// услугами.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеИзПереработки - проводимый документ
//
// Возвращаемое значение:
//  Структура, Неопределено - Суммы, НДС (Массив из Число по строкам ТЧГотоваяПродукция); сумма строк не равна шапке
//                            или услуг нет вовсе - Неопределено: работает прежнее правило.
//
Функция УслугиСтрокПоступления(ДокОбъект)
	Строки = ДокОбъект.ТЧГотоваяПродукция;
	СуммаСтрок = Строки.Итог("СтоимостьУслуг");
	Если СуммаСтрок = 0 Или СуммаСтрок <> ДокОбъект.СтоимостьУслуг Тогда
		Возврат Неопределено;
	КонецЕсли;
	Суммы = Строки.ВыгрузитьКолонку("СтоимостьУслуг");
	ПоследняяСУслугами = -1;
	Для Индекс = 0 По Суммы.ВГраница() Цикл
		Если Суммы[Индекс] <> 0 Тогда
			ПоследняяСУслугами = Индекс;
		КонецЕсли;
	КонецЦикла;
	НДС = Новый Массив;
	Начислено = 0;
	Для Индекс = 0 По Суммы.ВГраница() Цикл
		Если Индекс = ПоследняяСУслугами Тогда
			Доля = ДокОбъект.СуммаНДСУслуг - Начислено;
		Иначе
			Доля = ДоляСуммы(ДокОбъект.СуммаНДСУслуг, Суммы[Индекс], СуммаСтрок);
		КонецЕсли;
		НДС.Добавить(Доля);
		Начислено = Начислено + Доля;
	КонецЦикла;
	Возврат Новый Структура("Суммы, НДС", Суммы, НДС);
КонецФункции

// Приходует строки ТЧГотоваяПродукция документа, распределяя на них себестоимость.
//
// Вес строки - Количество x сумма норм карты x (1 + процент потерь / 100); правило целиком в
// ТехнологическиеКарты.ВесаПродукции. Если хотя бы у одной позиции карты нет, коэффициенты всех
// позиций равны 1 и распределение идёт по количеству. Карта берётся на дату документа, поэтому
// перепроведение старого документа считает по той версии карты, что действовала тогда. Остаток
// округления - на последнюю строку. Партия прихода - сам документ.
//
// Процедура общая с выпуском продукции, у которого реквизита ПроцентПотерь нет: колонка добавляется к
// выгруженной таблице ПРОГРАММНО и заполняется только там, где реквизит есть в метаданных. Дописать имя
// в список Выгрузить(, "…") нельзя - у выпуска это «поле не найдено» и падение его проведения. У выпуска
// процент нулевой, вес численно тот же, что до S5-B, и себестоимость выпуска не меняется; по той же
// причине не меняется себестоимость исторических поступлений - у них процент нулевой.
//
// Параметры:
//  ДокОбъект        - ДокументОбъект.ВыпускПродукции, ДокументОбъект.ПоступлениеИзПереработки - проводимый документ
//  МестоХранения    - СправочникСсылка.МестаХранения - склад оприходования продукции
//  Себестоимость    - Число - распределяемая себестоимость
//  СебестоимостьНДС - Число - НДС в составе себестоимости
//  УслугиСтрок      - Структура, Неопределено - см. УслугиСтрокПоступления: прибавляются к строке как есть, по весам не
//                     делятся. У выпуска продукции не передаётся - его себестоимость прежняя.
//
Процедура РаспределитьСебестоимостьНаПродукцию(ДокОбъект, МестоХранения, Себестоимость, СебестоимостьНДС,
	УслугиСтрок = Неопределено)
	Движения = ДокОбъект.Движения;
	ТЗПродукция = ДокОбъект.ТЧГотоваяПродукция.Выгрузить(, "Номенклатура, Характеристика, Серия, Количество");
	ТЗПродукция.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число"));
	ЗаполнитьПроцентПотерьПродукции(ТЗПродукция, ДокОбъект);
	Веса = ТехнологическиеКарты.ВесаПродукции(ТЗПродукция, ДокОбъект.Дата);
	Для Индекс = 0 По ТЗПродукция.Количество() - 1 Цикл
		ТЗПродукция[Индекс].Вес = Веса[Индекс];
	КонецЦикла;
	ОбщийВес = ТЗПродукция.Итог("Вес");
	Начислено = 0;
	НачисленоНДС = 0;
	Для Индекс = 0 По ТЗПродукция.Количество() - 1 Цикл
		Стр = ТЗПродукция[Индекс];
		Если Индекс = ТЗПродукция.Количество() - 1 Тогда
			Сумма = Себестоимость - Начислено;
		ИначеЕсли ОбщийВес = 0 Тогда
			Сумма = 0;
		Иначе
			Сумма = Окр(Себестоимость * Стр.Вес / ОбщийВес, РазрядностьСуммы());
		КонецЕсли;
		Начислено = Начислено + Сумма;
		СуммаНДС = ?(Индекс = ТЗПродукция.Количество() - 1, СебестоимостьНДС - НачисленоНДС,
			ДоляСуммы(СебестоимостьНДС, Сумма, Себестоимость));
		НачисленоНДС = НачисленоНДС + СуммаНДС;
		Если УслугиСтрок <> Неопределено Тогда
			Сумма = Сумма + УслугиСтрок.Суммы[Индекс];
			СуммаНДС = СуммаНДС + УслугиСтрок.НДС[Индекс];
		КонецЕсли;
		ДобавитьПриход(Движения, ДокОбъект.Дата, МестоХранения, Стр.Номенклатура,
			Стр.Характеристика, Стр.Серия, ДокОбъект.Ссылка, ДокОбъект.Дата, Стр.Количество, Сумма, СуммаНДС);
	КонецЦикла;
КонецПроцедуры

// Добавляет в выгруженную продукцию колонку ПроцентПотерь и заполняет её, если реквизит есть в
// табличной части документа. У выпуска продукции реквизита нет - колонка остаётся нулевой, и вес
// строки сводится к прежнему «Количество x Коэффициент».
//
// Параметры:
//  ТЗПродукция - ТаблицаЗначений - выгрузка ТЧГотоваяПродукция; изменяется.
//  ДокОбъект   - ДокументОбъект.ВыпускПродукции, ДокументОбъект.ПоступлениеИзПереработки - документ.
//
Процедура ЗаполнитьПроцентПотерьПродукции(ТЗПродукция, ДокОбъект)
	ИмяРеквизита = "ПроцентПотерь";
	ТЗПродукция.Колонки.Добавить(ИмяРеквизита, Новый ОписаниеТипов("Число"));
	Реквизиты = ДокОбъект.Метаданные().ТабличныеЧасти.ТЧГотоваяПродукция.Реквизиты;
	Если Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По ТЗПродукция.Количество() - 1 Цикл
		ТЗПродукция[Индекс].ПроцентПотерь = ДокОбъект.ТЧГотоваяПродукция[Индекс].ПроцентПотерь;
	КонецЦикла;
КонецПроцедуры

Функция РазрядностьСуммы()
	Возврат 2;
КонецФункции

Функция СтоимостьУслугВыпуска(ТЗТоварыССериями)
	// Стоимость услуг в ТЧТовары выпуска вводится вручную в колонку Себестоимость:
	// по складу они не списываются, и расчёт по движениям её не заполняет.
	Если ТЗТоварыССериями.Количество() = 0 Или ТЗТоварыССериями.Колонки.Найти("Себестоимость") = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Номенклатура.Ссылка КАК Номенклатура
	                      |ИЗ
	                      |	Справочник.Номенклатура КАК Номенклатура
	                      |ГДЕ
	                      |	Номенклатура.Ссылка В (&Номенклатура)
	                      |	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)");
	ИмяКолонки = "Номенклатура";
	Запрос.УстановитьПараметр(ИмяКолонки, ТЗТоварыССериями.ВыгрузитьКолонку(ИмяКолонки));
	Услуги = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(ИмяКолонки);
	Стоимость = 0;
	Для Каждого Стр Из ТЗТоварыССериями Цикл
		Если Услуги.Найти(Стр.Номенклатура) <> Неопределено Тогда
			Стоимость = Стоимость + Стр.Себестоимость;
		КонецЕсли;
	КонецЦикла;
	Возврат Стоимость;
КонецФункции

// Заменяет строки номенклатуры типа «Комплект» строками составляющих из состава комплекта: количество умножается на
// количество в составе, составляющие списываются без характеристики, серии и партии, ссылка на комплект уходит в
// движения (реквизит Комплект). Тот же механизм раскладывает ключи складских блокировок (НоменклатураССоставляющими).
//
// Параметры:
//  ТЗ - ТаблицаЗначений - строки списания с колонками Номенклатура, МестоХранения, ЕстьПартия, Количество;
//       добавляется колонка Комплект.
//
Процедура РазложитьКомплектыНаСоставляющие(ТЗ) Экспорт
	ИмяКолонкиКомплект = "Комплект";
	// Колонка уже есть, если строки по расходным ордерам разложены по снимку ордера (ТоварыКОформлению.
	// ЗаменитьКомплектыПоОрдерам): их составляющие - не комплекты, повторно не раскладываются.
	ДобавитьКолонкуЕслиНет(ТЗ, ИмяКолонкиКомплект, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗСостав = СоставКомплектов(ТЗ.ВыгрузитьКолонку("Номенклатура"));
	Если ТЗСостав.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СтрокиКомплектов = Новый Массив;
	ТЗКомплекты = ТЗСостав.Скопировать(, ИмяКолонкиКомплект);
	ТЗКомплекты.Свернуть(ИмяКолонкиКомплект);
	Для Каждого СтрКомплект Из ТЗКомплекты Цикл
		МасСтрок = ТЗ.НайтиСтроки(Новый Структура("Номенклатура", СтрКомплект.Комплект));
		МасСостав = ТЗСостав.НайтиСтроки(Новый Структура(ИмяКолонкиКомплект, СтрКомплект.Комплект));
		Для Каждого СтрТЗ Из МасСтрок Цикл
			Для Каждого СтрСостава Из МасСостав Цикл
				НС = ТЗ.Добавить();
				НС.Номенклатура = СтрСостава.Номенклатура;
				НС.Комплект = СтрКомплект.Комплект;
				НС.МестоХранения = СтрТЗ.МестоХранения;
				НС.ЕстьПартия = Ложь;
				НС.Количество = СтрТЗ.Количество * СтрСостава.Количество;
			КонецЦикла;
			СтрокиКомплектов.Добавить(СтрТЗ);
		КонецЦикла;
	КонецЦикла;
	Для Каждого СтрТЗ Из СтрокиКомплектов Цикл
		ТЗ.Удалить(СтрТЗ);
	КонецЦикла;
КонецПроцедуры

// Состав комплектов из списка номенклатуры: только номенклатура типа «Комплект», в порядке строк состава.
//
// Параметры:
//  Номенклатура - Массив - номенклатура (значения других типов и пустые ссылки пропускаются запросом).
//
// Возвращаемое значение:
//  ТаблицаЗначений - Комплект, Номенклатура (составляющая), Количество (на единицу комплекта).
//
Функция СоставКомплектов(Номенклатура) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Состав.Ссылка КАК Комплект,
	                      |	Состав.Номенклатура КАК Номенклатура,
	                      |	Состав.Количество КАК Количество
	                      |ИЗ
	                      |	Справочник.Номенклатура.СоставКомплекта КАК Состав
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	                      |		ПО Состав.Ссылка = СправочникНоменклатура.Ссылка
	                      |ГДЕ
	                      |	СправочникНоменклатура.Ссылка В (&Номенклатура)
	                      |	И СправочникНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Комплект)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Комплект,
	                      |	Состав.НомерСтроки");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Ключи складской блокировки: номенклатура источника и составляющие её комплектов - то, что списание реально
// двигает (РазложитьКомплектыНаСоставляющие). Комплект тоже остаётся ключом.
//
// Параметры:
//  ИсточникДанных - ТабличнаяЧасть, ТаблицаЗначений - строки с колонкой «Номенклатура».
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонка Номенклатура, без повторов.
//
Функция НоменклатураССоставляющими(ИсточникДанных) Экспорт
	Поле = "Номенклатура";
	Ключи = Новый ТаблицаЗначений;
	Ключи.Колонки.Добавить(Поле, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Номенклатура = ИсточникДанных.ВыгрузитьКолонку(Поле);
	Для Каждого Позиция Из Номенклатура Цикл
		Ключи.Добавить().Номенклатура = Позиция;
	КонецЦикла;
	Для Каждого Составляющая Из СоставКомплектов(Номенклатура) Цикл
		Ключи.Добавить().Номенклатура = Составляющая.Номенклатура;
	КонецЦикла;
	Ключи.Свернуть(Поле);
	Возврат Ключи;
КонецФункции

// Списание партий по ФИФО (остатки на момент документа, исключая его).
//
// Параметры:
//  ТЗ                 - ТаблицаЗначений - строки списания (МестоХранения, Номенклатура, Характеристика, Серия, Количество,
//                       при наличии - Партия, Комплект, КодСтроки)
//  ДокОбъект          - ДокументОбъект - проводимый документ
//  РазрешитьНедостачи - Булево - списать сколько есть (мёртвая ветка: регистра недостач нет)
//  ПоСтрокам          - Булево - строки группируются и с кодом строки, он пишется в записи ТоварыВНаличии и
//                       ДополнительныеРасходы (расходный ордер, план warehouse-orders-cost, Ф3.5); иначе код - 0
//
// Возвращаемое значение:
//  Булево - движения сформированы; Ложь - отказ по нехватке (текст сообщён)
//
Функция СписатьНоменклатуру(ТЗ, ДокОбъект, РазрешитьНедостачи = Ложь, ПоСтрокам = Ложь) Экспорт
	СерииИРазмещение.ДополнитьКолонкамиПартии(ТЗ);
	ДобавитьКолонкуЕслиНет(ТЗ, "КодСтроки", Метаданные.ОпределяемыеТипы.КодСтроки.Тип);
	ЗаменитьПартииПоступленийОрдерногоСклада(ТЗ);
	РазложитьКомплектыНаСоставляющие(ТЗ);
	// Получаем остатки
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(ТЗ.МестоХранения КАК Справочник.МестаХранения) КАК МестоХранения,
	                      |	ВЫРАЗИТЬ(ТЗ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(ТЗ.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	                      |	ВЫРАЗИТЬ(ТЗ.Серия КАК Справочник.СерииНоменклатуры) КАК Серия,
	                      |	ТЗ.Партия КАК Партия,
	                      |	ТЗ.ЕстьПартия КАК ЕстьПартия,
	                      |	ВЫРАЗИТЬ(ТЗ.Комплект КАК Справочник.Номенклатура) КАК Комплект,
	                      |	ВЫБОР
	                      |		КОГДА &ПоСтрокам
	                      |			ТОГДА ВЫРАЗИТЬ(ТЗ.КодСтроки КАК ЧИСЛО(10, 0))
	                      |		ИНАЧЕ 0
	                      |	КОНЕЦ КАК КодСтроки,
	                      |	ВЫРАЗИТЬ(ТЗ.Количество КАК ЧИСЛО) КАК Количество
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	&ТЗ КАК ТЗ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.МестоХранения КАК МестоХранения,
	                      |	ВТ.Номенклатура КАК Номенклатура,
	                      |	ВТ.Характеристика КАК Характеристика,
	                      |	ВТ.Серия КАК Серия,
	                      |	ВТ.Партия КАК Партия,
	                      |	ВТ.ЕстьПартия КАК ЕстьПартия,
	                      |	ВТ.Комплект КАК Комплект,
	                      |	ВТ.КодСтроки КАК КодСтроки,
	                      |	СУММА(ВТ.Количество) КАК Количество
	                      |ПОМЕСТИТЬ ВТТовары
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |ГДЕ
	                      |	НЕ ВТ.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТ.МестоХранения,
	                      |	ВТ.Номенклатура,
	                      |	ВТ.Характеристика,
	                      |	ВТ.Серия,
	                      |	ВТ.Партия,
	                      |	ВТ.ЕстьПартия,
	                      |	ВТ.Комплект,
	                      |	ВТ.КодСтроки
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТТовары.МестоХранения КАК МестоХранения,
	                      |	ВТТовары.Номенклатура КАК Номенклатура,
	                      |	ВТТовары.Характеристика КАК Характеристика,
	                      |	ВТТовары.Серия КАК Серия,
	                      |	СУММА(ВТТовары.Количество) КАК Количество
	                      |ПОМЕСТИТЬ ВТТоварыБезПартии
	                      |ИЗ
	                      |	ВТТовары КАК ВТТовары
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТТовары.МестоХранения,
	                      |	ВТТовары.Номенклатура,
	                      |	ВТТовары.Характеристика,
	                      |	ВТТовары.Серия
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТТовары.МестоХранения КАК МестоХранения,
	                      |	ВТТовары.Номенклатура КАК Номенклатура,
	                      |	ВТТовары.Характеристика КАК Характеристика,
	                      |	ВТТовары.Серия КАК Серия,
	                      |	ЕСТЬNULL(ТоварыВНаличииОстатки.Партия, НЕОПРЕДЕЛЕНО) КАК Партия,
	                      |	ЕСТЬNULL(ТоварыВНаличииОстатки.ДатаПартии, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПартии,
	                      |	ВТТовары.Количество КАК Количество,
	                      |	ЕСТЬNULL(ТоварыВНаличииОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	                      |	ЕСТЬNULL(ТоварыВНаличииОстатки.СуммаОстаток, 0) КАК СуммаОстаток,
	                      |	ЕСТЬNULL(ТоварыВНаличииОстатки.СуммаНДСОстаток, 0) КАК СуммаНДСОстаток
	                      |ПОМЕСТИТЬ ВТТоварыВНаличии
	                      |ИЗ
	                      |	ВТТоварыБезПартии КАК ВТТовары
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВНаличии.Остатки(
	                      |				&ДатаОстатков,
	                      |				(МестоХранения, Номенклатура, Характеристика, Серия) В
	                      |					(ВЫБРАТЬ
	                      |						ВТ.МестоХранения КАК МестоХранения,
	                      |						ВТ.Номенклатура КАК Номенклатура,
	                      |						ВТ.Характеристика КАК Характеристика,
	                      |						ВТ.Серия КАК Серия
	                      |					ИЗ
	                      |						ВТТоварыБезПартии КАК ВТ)) КАК ТоварыВНаличииОстатки
	                      |		ПО ВТТовары.МестоХранения = ТоварыВНаличииОстатки.МестоХранения
	                      |			И ВТТовары.Номенклатура = ТоварыВНаличииОстатки.Номенклатура
	                      |			И ВТТовары.Характеристика = ТоварыВНаличииОстатки.Характеристика
	                      |			И ВТТовары.Серия = ТоварыВНаличииОстатки.Серия
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТТовары.МестоХранения КАК МестоХранения,
	                      |	ВТТовары.Номенклатура КАК Номенклатура,
	                      |	ВТТовары.Характеристика КАК Характеристика,
	                      |	ВТТовары.Серия КАК Серия,
	                      |	ВТТовары.Партия КАК Партия,
	                      |	ВТТовары.ЕстьПартия КАК ЕстьПартия,
	                      |	ВТТовары.Комплект КАК Комплект,
	                      |	ВТТовары.КодСтроки КАК КодСтроки,
	                      |	ВТТовары.Количество КАК Количество
	                      |ИЗ
	                      |	ВТТовары КАК ВТТовары
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ЕстьПартия УБЫВ,
	                      |	КодСтроки
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЗ.Серия КАК Серия,
	                      |	ВЗ.Количество КАК Количество,
	                      |	ВЗ.КоличествоОстаток КАК КоличествоОстаток,
	                      |	ВЗ.Количество <= ВЗ.КоличествоОстаток КАК МожноСписать
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТТоварыВНаличии.Номенклатура КАК Номенклатура,
	                      |		ВТТоварыВНаличии.Характеристика КАК Характеристика,
	                      |		ВТТоварыВНаличии.Серия КАК Серия,
	                      |		ВТТоварыВНаличии.Количество КАК Количество,
	                      |		СУММА(ВТТоварыВНаличии.КоличествоОстаток) КАК КоличествоОстаток
	                      |	ИЗ
	                      |		ВТТоварыВНаличии КАК ВТТоварыВНаличии
	                      |
	                      |	СГРУППИРОВАТЬ ПО
	                      |		ВТТоварыВНаличии.Номенклатура,
	                      |		ВТТоварыВНаличии.Характеристика,
	                      |		ВТТоварыВНаличии.Количество,
	                      |		ВТТоварыВНаличии.Серия) КАК ВЗ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТТоварыВНаличии.МестоХранения КАК МестоХранения,
	                      |	ВТТоварыВНаличии.Номенклатура КАК Номенклатура,
	                      |	ВТТоварыВНаличии.Характеристика КАК Характеристика,
	                      |	ВТТоварыВНаличии.Серия КАК Серия,
	                      |	ВТТоварыВНаличии.Партия КАК Партия,
	                      |	ВТТоварыВНаличии.ДатаПартии КАК ДатаПартии,
	                      |	ВТТоварыВНаличии.КоличествоОстаток КАК Количество,
	                      |	ВТТоварыВНаличии.СуммаОстаток КАК Сумма,
	                      |	ВТТоварыВНаличии.СуммаНДСОстаток КАК СуммаНДС
	                      |ИЗ
	                      |	ВТТоварыВНаличии КАК ВТТоварыВНаличии
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДатаПартии
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТТоварыВНаличии.МестоХранения КАК МестоХранения,
	                      |	ВТТоварыВНаличии.Номенклатура КАК Номенклатура,
	                      |	ВТТоварыВНаличии.Характеристика КАК Характеристика,
	                      |	ВТТоварыВНаличии.Серия КАК Серия,
	                      |	ВТТоварыВНаличии.Партия КАК Партия,
	                      |	ДополнительныеРасходыОстатки.СтатьяДДС КАК СтатьяДДС,
	                      |	ДополнительныеРасходыОстатки.СуммаОстаток КАК Сумма,
	                      |	ДополнительныеРасходыОстатки.СуммаНДСОстаток КАК СуммаНДС
	                      |ИЗ
	                      |	ВТТоварыВНаличии КАК ВТТоварыВНаличии
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ДополнительныеРасходы.Остатки(
	                      |				&ДатаОстатков,
	                      |				(МестоХранения, Номенклатура, Характеристика, Серия) В
	                      |					(ВЫБРАТЬ
	                      |						ВТ.МестоХранения КАК МестоХранения,
	                      |						ВТ.Номенклатура КАК Номенклатура,
	                      |						ВТ.Характеристика КАК Характеристика,
	                      |						ВТ.Серия КАК Серия
	                      |					ИЗ
	                      |						ВТТоварыВНаличии КАК ВТ)) КАК ДополнительныеРасходыОстатки
	                      |		ПО ВТТоварыВНаличии.МестоХранения = ДополнительныеРасходыОстатки.МестоХранения
	                      |			И ВТТоварыВНаличии.Номенклатура = ДополнительныеРасходыОстатки.Номенклатура
	                      |			И ВТТоварыВНаличии.Характеристика = ДополнительныеРасходыОстатки.Характеристика
	                      |			И ВТТоварыВНаличии.Серия = ДополнительныеРасходыОстатки.Серия
	                      |			И ВТТоварыВНаличии.Партия = ДополнительныеРасходыОстатки.Партия");
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(ДокОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Период", ДокОбъект.Дата);
	Запрос.УстановитьПараметр("ПоСтрокам", ПоСтрокам);
	Результат = Запрос.ВыполнитьПакет();
	// Получаем данные
	ТЗТовары = Результат[4].Выгрузить();
	ТЗКонтрольОстатков = Результат[5].Выгрузить();
	ТЗТоварыВНаличии = Результат[6].Выгрузить();
	ТЗДополнительныеРасходы = Результат[7].Выгрузить();
   	// Проверяем возможность списания
	ТекстОшибкиСписания = "";
	Если Не РазрешитьНедостачи Тогда
		Мас = ТЗКонтрольОстатков.НайтиСтроки(Новый Структура("МожноСписать", Ложь));
		Если Мас.Количество() > 0 Тогда
			Для Каждого Стр Из Мас Цикл
				//Если ЭтоИнтерфейсПродавца Тогда
				//	ТекстОшибки = Нстр("fr = 'Erreur ('; ru = 'Ошибка ('; en = 'Error ('; es = 'Error ('") + ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Стр.Номенклатура, Стр.Характеристика, Стр.Серия) +
				//			Нстр("fr = '); contacter l''administrateur!'; ru = '); обратитесь к администратору!'; en = '); contact the administrator!'; es = '); ¡póngase en contacto con el administrador!'");
				//Иначе
					ТекстОшибки = ТекстОшибкиНедостатка(Стр, Стр.Количество, Стр.КоличествоОстаток);
				//КонецЕсли;
				ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(ТекстОшибкиСписания, ТекстОшибки, "; " + Символы.ВК);
			КонецЦикла;
			СообщитьОбОшибкеСписания(ДокОбъект, ТекстОшибкиСписания);
			Возврат Ложь;
		КонецЕсли;
		// Остатки по указанным партиям
		ТекстОшибкиПартий = ТекстОшибкиНедостаткаПоПартиям(ТЗТовары, ТЗТоварыВНаличии);
		Если Не ПустаяСтрока(ТекстОшибкиПартий) Тогда
			СообщитьОбОшибкеСписания(ДокОбъект, ТекстОшибкиПартий);
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	// Списываем партии
	Для Каждого Стр Из ТЗТовары Цикл
		КоличествоКСписанию = Стр.Количество;
		//
		Если РазрешитьНедостачи Тогда // Списываем только то количество, которое есть на остатках
			Мас = ТЗКонтрольОстатков.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Серия, МожноСписать", Стр.Номенклатура, Стр.Характеристика, Стр.Серия, Ложь));
			Если Мас.Количество() > 0 Тогда
				КоличествоКСписанию = ?(Мас[0].КоличествоОстаток <= 0, 0, Мас[0].КоличествоОстаток);
				КоличествоНедостача = Стр.Количество - КоличествоКСписанию;
				ДобавитьНедостачу(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.МестоХранения, Стр.Номенклатура, Стр.Характеристика, Стр.Серия, КоличествоНедостача);
				//Если ЭтоИнтерфейсПродавца Тогда
				//	ТекстОшибки = Нстр("fr = 'Erreur ('; ru = 'Ошибка ('; en = 'Error ('; es = 'Error ('") + ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Стр.Номенклатура, Стр.Характеристика, Стр.Серия) +
				//			Нстр("fr = '); contacter l''administrateur!'; ru = '); обратитесь к администратору!'; en = '); contact the administrator!'; es = '); ¡póngase en contacto con el administrador!'");
				//иначе
					ТекстОшибки = ТекстОшибкиНедостатка(Стр, Стр.Количество, КоличествоКСписанию);
				//КонецЕсли;
				ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(ТекстОшибкиСписания, ТекстОшибки, "; " + Символы.ВК);
				Если КоличествоКСписанию = 0 Тогда Продолжить КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		//
		Отбор = Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия);
		Если Стр.ЕстьПартия Тогда
			Отбор.Вставить("Партия", Стр.Партия);
		КонецЕсли;
		МасПартии = ТЗТоварыВНаличии.НайтиСтроки(Отбор);
		Для Каждого СтрПартия Из МасПартии Цикл
			Если СтрПартия.Количество <= 0 Тогда Продолжить КонецЕсли; // Чтоб не списать минусовую или нулевую партию
			Если КоличествоКСписанию = 0 Тогда Прервать КонецЕсли; // Если всё списали, тогда выходим
			Количество = ?(КоличествоКСписанию < СтрПартия.Количество, КоличествоКСписанию, СтрПартия.Количество);
			Сумма = ?(Количество = СтрПартия.Количество, СтрПартия.Сумма, Окр(СтрПартия.Сумма / СтрПартия.Количество * Количество, 2));
			СуммаНДС = ДоляСуммы(СтрПартия.СуммаНДС, Сумма, СтрПартия.Сумма);
			// Списываем издержки
			МасДополнительныеРасходы = ТЗДополнительныеРасходы.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Серия, Партия", СтрПартия.Номенклатура, СтрПартия.Характеристика, СтрПартия.Серия, СтрПартия.Партия));
			Для Каждого СтрДополнительныйРасход Из МасДополнительныеРасходы Цикл
				СуммаДополнительногоРасхода = РассчитатьСуммуСписанияДополнительныхРасходов(Сумма, СтрПартия.Сумма,
					СтрДополнительныйРасход.Сумма, Количество, СтрПартия.Количество);
				СуммаНДСДополнительногоРасхода = ДоляСуммы(СтрДополнительныйРасход.СуммаНДС, СуммаДополнительногоРасхода,
					СтрДополнительныйРасход.Сумма);
				РегистрыНакопления.ДополнительныеРасходы.ДобавитьРасход(ДокОбъект.Движения, ДокОбъект.Дата, СтрДополнительныйРасход.МестоХранения, СтрПартия.Номенклатура, СтрПартия.Характеристика, СтрПартия.Серия, СтрПартия.Партия, СтрДополнительныйРасход.СтатьяДДС, СуммаДополнительногоРасхода, СуммаНДСДополнительногоРасхода, Стр.Комплект, Стр.КодСтроки);
				СтрДополнительныйРасход.Сумма = СтрДополнительныйРасход.Сумма - СуммаДополнительногоРасхода;
				СтрДополнительныйРасход.СуммаНДС = СтрДополнительныйРасход.СуммаНДС - СуммаНДСДополнительногоРасхода;
			КонецЦикла;
			// Списываем партии
			ДобавитьРасход(ДокОбъект.Движения, ДокОбъект.Дата, СтрПартия.МестоХранения, СтрПартия.Номенклатура, СтрПартия.Характеристика, СтрПартия.Серия, СтрПартия.Партия, СтрПартия.ДатаПартии, Количество, Сумма, СуммаНДС, Стр.Комплект, Стр.КодСтроки);
			// Уменьшаем данные
			КоличествоКСписанию = КоличествоКСписанию - Количество;
			СтрПартия.Количество = СтрПартия.Количество - Количество;
			СтрПартия.Сумма = СтрПартия.Сумма - Сумма;
			СтрПартия.СуммаНДС = СтрПартия.СуммаНДС - СуммаНДС;
		КонецЦикла;
	КонецЦикла;
	Если Не ПустаяСтрока(ТекстОшибкиСписания) Тогда
		СообщитьОбОшибкеСписания(ДокОбъект, ТекстОшибкиСписания);
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Явная партия-поступление ордерного склада (документ до 2.0.16.122 указал её строкой или списывал её): партию там
// создаёт приходный ордер (Ф3.15). Строка, списывающая с ордерного на дату поступления склада, переходит на партию
// ордера пары поступления, если он один, иначе - на ФИФО. На неордерном складе (подчинённый склад строки поступления)
// партия поступления остаётся, строка не меняется.
//
// Параметры:
//  ТЗ - ТаблицаЗначений - строки списания с колонками МестоХранения, Партия, ЕстьПартия, Номенклатура
//
Процедура ЗаменитьПартииПоступленийОрдерногоСклада(ТЗ)
	Поступления = Новый Массив;
	Для Каждого Строка Из ТЗ Цикл
		Если Строка.ЕстьПартия И ТипЗнч(Строка.Партия) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг")
			И Поступления.Найти(Строка.Партия) = Неопределено Тогда
			Поступления.Добавить(Строка.Партия);
		КонецЕсли;
	КонецЦикла;
	Если Поступления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Ордерные = ПоступленияОрдерныхСкладов(Поступления);
	Если Ордерные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Пары = РегистрыНакопления.ТоварыКОформлению.ПарыОформления(Ордерные);
	Для Каждого Строка Из ТЗ Цикл
		Если Строка.ЕстьПартия И ПартияОрдерногоСклада(Строка, Ордерные) Тогда
			ОрдераПоступления = ОрдераПарПоступления(Пары, Строка.Партия);
			Если ОрдераПоступления.Количество() = 1 Тогда
				Строка.Партия = ОрдераПоступления[0];
			Иначе
				Строка.ЕстьПартия = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПоступленияОрдерныхСкладов(Поступления)
	Ордерные = Новый Массив;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Поступления, "МестоХранения, Дата");
	Для Каждого Элемент Из Реквизиты Цикл
		Если Справочники.МестаХранения.ОрдерныйСклад(Элемент.Значение.МестоХранения, Элемент.Значение.Дата) Тогда
			Ордерные.Добавить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Ордерные;
КонецФункции

Функция ПартияОрдерногоСклада(Строка, Ордерные)
	Если Ордерные.Найти(Строка.Партия) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Справочники.МестаХранения.ОрдерныйСклад(Строка.МестоХранения,
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Партия, "Дата"));
КонецФункции

Функция ОрдераПарПоступления(Пары, Поступление)
	Ордера = Новый Массив;
	Для Каждого Пара Из Пары.НайтиСтроки(Новый Структура("Регистратор", Поступление)) Цикл
		Если ТипЗнч(Пара.Источник) = Тип("ДокументСсылка.ПриходныйОрдер") И Ордера.Найти(Пара.Источник) = Неопределено Тогда
			Ордера.Добавить(Пара.Источник);
		КонецЕсли;
	КонецЦикла;
	Возврат Ордера;
КонецФункции

// Возвращает текст ошибки «недостаточно товара» для строки списания.
//
// Параметры:
//  Стр - СтрокаТаблицыЗначений - строка с колонками Номенклатура, Характеристика, Серия.
//  Нужно - Число - требуемое количество.
//  Остаток - Число - доступное количество.
//
// Возвращаемое значение:
//  Строка - текст ошибки.
//
Функция ТекстОшибкиНедостатка(Стр, Нужно, Остаток)
	Возврат НСтр("ru = 'Недостаточно ('; fr = 'Pas suffisant ('; en = 'Not enough ('; es = 'No es suficiente ('")
		+ ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Стр.Номенклатура, Стр.Характеристика, Стр.Серия)
		+ НСтр("ru = ') Нужно: '; fr = ') Requis : '; en = ') Required: '; es = ') Necesario: '") + СокрЛП(Нужно)
		+ НСтр("ru = '; остаток: '; fr = '; reste : '; en = '; in stock: '; es = '; en existencia: '") + СокрЛП(Остаток);
КонецФункции

// Возвращает текст ошибки по строкам с указанной партией, остатка которой не хватает.
//
// Параметры:
//  ТЗТовары - ТаблицаЗначений - строки списания с колонками Партия, ЕстьПартия, Количество.
//  ТЗТоварыВНаличии - ТаблицаЗначений - остатки по партиям с колонкой Количество.
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка, если остатков по всем партиям хватает.
//
Функция ТекстОшибкиНедостаткаПоПартиям(ТЗТовары, ТЗТоварыВНаличии)
	Текст = "";
	Для Каждого Стр Из ТЗТовары.НайтиСтроки(Новый Структура("ЕстьПартия", Истина)) Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия);
		Отбор.Вставить("Партия", Стр.Партия);
		ОстатокПоПартии = 0;
		Для Каждого СтрПартия Из ТЗТоварыВНаличии.НайтиСтроки(Отбор) Цикл
			ОстатокПоПартии = ОстатокПоПартии + СтрПартия.Количество;
		КонецЦикла;
		Если Стр.Количество > ОстатокПоПартии Тогда
			ТекстОшибки = ТекстОшибкиНедостатка(Стр, Стр.Количество, ОстатокПоПартии)
				+ НСтр("ru = ' по партии '; fr = ' pour le lot '; en = ' for batch '; es = ' para el lote '") + Строка(Стр.Партия);
			ОбщегоНазначенияКлиентСервер.ДобавитьКСтроке(Текст, ТекстОшибки, "; " + Символы.ВК);
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции

// Налоговые документы: проводятся только по складу с признаком «Налоговый» и товар не двигают.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - проводимый документ.
//
// Возвращаемое значение:
//  Булево - Истина для налоговой накладной продажи и покупки и налоговых возвратов.
//
Функция ЭтоНалоговыйДокумент(ДокОбъект)
	ТипДокумента = ТипЗнч(ДокОбъект);
	Возврат ТипДокумента = Тип("ДокументОбъект.НалоговаяНакладная")
		Или ТипДокумента = Тип("ДокументОбъект.НалоговаяНакладнаяПокупка")
		Или ТипДокумента = Тип("ДокументОбъект.ВозвратОтПокупателяНалоговый")
		Или ТипДокумента = Тип("ДокументОбъект.ВозвратПоставщикуНалоговый");
КонецФункции

// Передаёт текст ошибки списания пользователю или вызывающему коду (фоновое задание, интерфейс продавца).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - проводимый документ.
//  ТекстОшибки - Строка - текст ошибки.
//
Функция СкладНалоговый(ДокОбъект)
	// Налоговые документы проводятся только по складу с признаком «Налоговый учёт»; иначе - сообщение и отказ.
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОбъект.МестоХранения, "Налоговый") = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	ТекстОшибки = СтрШаблон(НСтр("ru = 'Склад «%1» не помечен как склад налогового учёта: налоговые документы проводятся только по таким складам.';
		|fr = 'L''entrepôt « %1 » n''est pas marqué comme entrepôt de comptabilité fiscale : les documents fiscaux ne sont comptabilisés que sur ces entrepôts.';
		|en = 'Warehouse ""%1"" is not marked as a tax accounting warehouse: tax documents are posted only to such warehouses.';
		|es = 'El almacén «%1» no está marcado como almacén de contabilidad fiscal: los documentos fiscales solo se contabilizan en dichos almacenes.'"),
		ДокОбъект.МестоХранения);
	СообщитьОбОшибкеСписания(ДокОбъект, ТекстОшибки);
	Возврат Ложь;
КонецФункции

Процедура СообщитьОбОшибкеСписания(ДокОбъект, ТекстОшибки)
	Если ОбщегоНазначенияПовтИсп.ЭтоФоновоеЗадание()
		Или ДокОбъект.ДополнительныеСвойства.Свойство("ЭтоИнтерфейсПродавца") Тогда
		ДокОбъект.ДополнительныеСвойства.Вставить("ТекстОшибки", ТекстОшибки);
	Иначе
		Сообщить(ТекстОшибки);
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьПриход(Движения, ДатаДвижения, МестоХранения, Номенклатура, Характеристика, Серия, Партия, ДатаПартии,
		Количество, Сумма, СуммаНДС = 0)
	НС = Движения.ТоварыВНаличии.ДобавитьПриход();
	НС.Период = ДатаДвижения;
	НС.МестоХранения = МестоХранения;
	НС.Номенклатура = Номенклатура;
	НС.Характеристика = Характеристика;
	НС.Серия = Серия;
	НС.Партия = Партия;
	НС.ДатаПартии = ДатаПартии;
	НС.Количество = Количество;
	НС.Сумма = Сумма;
	НС.СуммаНДС = СуммаНДС;
КонецПроцедуры

Процедура ДобавитьРасход(Движения, ДатаДвижения, МестоХранения, Номенклатура, Характеристика, Серия, Партия, ДатаПартии,
		Количество, Сумма, СуммаНДС = 0, Комплект = Неопределено, КодСтроки = 0)
	НС = Движения.ТоварыВНаличии.ДобавитьРасход();
	НС.Период = ДатаДвижения;
	НС.МестоХранения = МестоХранения;
	НС.Номенклатура = Номенклатура;
	НС.Характеристика = Характеристика;
	НС.Серия = Серия;
	НС.Партия = Партия;
	НС.ДатаПартии = ДатаПартии;
	НС.Количество = Количество;
	НС.Сумма = Сумма;
	НС.СуммаНДС = СуммаНДС;
	Если Комплект <> Неопределено Тогда
		НС.Комплект = Комплект;
	КонецЕсли;
	НС.КодСтроки = КодСтроки;
КонецПроцедуры

Процедура ДобавитьНедостачу(Движения, ДатаДвижения, МестоХранения, Номенклатура, Характеристика, Серия, Количество)
	НС = Движения.ТоварыНедостача.Добавить();
	НС.Период = ДатаДвижения;
	НС.МестоХранения = МестоХранения;
	НС.Номенклатура = Номенклатура;
	НС.Характеристика = Характеристика;
	НС.Серия = Серия;
	НС.Количество = Количество;
КонецПроцедуры

#КонецОбласти

#Область Дополнительно

Процедура ДобавитьДанныеОприходования(ТЗТоварыССериями, ДокОбъект)
	// Колонки Партия и ЕстьПартия таблице уже добавляет СерииИРазмещение.ОбъединитьТоварыССериями,
	// а повторное добавление колонки - ошибка «Неверное имя колонки», поэтому добавляем недостающие.
	ДобавитьКолонкуЕслиНет(ТЗТоварыССериями, "Период", Новый ОписаниеТипов("Дата"));
	ДобавитьКолонкуЕслиНет(ТЗТоварыССериями, "ВидДвижения", Новый ОписаниеТипов("ВидДвиженияНакопления"));
	ДобавитьКолонкуЕслиНет(ТЗТоварыССериями, "Партия", Метаданные.ОпределяемыеТипы.ПриходныйДокументПартии.Тип);
	ДобавитьКолонкуЕслиНет(ТЗТоварыССериями, "ДатаПартии", Новый ОписаниеТипов("Дата"));

	// Партия оприходования - сам документ поступления, независимо от того, что было в колонке.
	ТЗТоварыССериями.ЗаполнитьЗначения(ДокОбъект.Дата, "Период");
	ТЗТоварыССериями.ЗаполнитьЗначения(ВидДвиженияНакопления.Приход, "ВидДвижения");
	ТЗТоварыССериями.ЗаполнитьЗначения(ДокОбъект.Ссылка, "Партия");
	ТЗТоварыССериями.ЗаполнитьЗначения(ДокОбъект.Дата, "ДатаПартии");
	Если ТЗТоварыССериями.Колонки.Найти("ЕстьПартия") <> Неопределено Тогда
		ТЗТоварыССериями.ЗаполнитьЗначения(Истина, "ЕстьПартия");
	КонецЕсли;
КонецПроцедуры

// Добавляет колонку в таблицу, если такой колонки в ней ещё нет.
//
// Параметры:
//  Таблица    - ТаблицаЗначений - пополняемая таблица.
//  ИмяКолонки - Строка          - имя колонки.
//  ТипКолонки - ОписаниеТипов   - тип значений колонки.
//
Процедура ДобавитьКолонкуЕслиНет(Таблица, ИмяКолонки, ТипКолонки)
	Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Таблица.Колонки.Добавить(ИмяКолонки, ТипКолонки);
	КонецЕсли;
КонецПроцедуры

// Часть суммы (например, НДС партии), приходящаяся на списываемую часть: пропорционально Часть/Целое.
//
// Параметры:
//  Сумма - Число - делимая сумма (НДС партии или издержки).
//  Часть - Число - списываемая сумма партии.
//  Целое - Число - полная сумма партии.
//
// Возвращаемое значение:
//  Число - доля суммы; вся сумма, если Часть = Целое; 0, если Целое = 0.
//
Функция ДоляСуммы(Сумма, Часть, Целое) Экспорт
	Если Часть = Целое Или Целое = 0 Тогда
		Возврат ?(Целое = 0, 0, Сумма);
	КонецЕсли;
	Возврат Окр(Сумма / Целое * Часть, РазрядностьСуммы());
КонецФункции

// Доля допрасхода партии, уходящая со списанием: по сумме партии, при нулевой сумме партии (неподтверждённая партия
// приходного ордера) - по количеству (план warehouse-orders-cost, Ф3.9).
//
// Параметры:
//  СуммаСписания               - Число - списываемая сумма партии
//  СуммаПартии                 - Число - остаток суммы партии
//  СуммаДополнительногоРасхода - Число - остаток допрасхода партии
//  КоличествоСписания          - Число - списываемое количество
//  КоличествоПартии            - Число - остаток количества партии
//
// Возвращаемое значение:
//  Число - сумма допрасхода к списанию
//
Функция РассчитатьСуммуСписанияДополнительныхРасходов(СуммаСписания, СуммаПартии, СуммаДополнительногоРасхода,
		КоличествоСписания, КоличествоПартии)
	Если СуммаПартии = 0 Тогда
		Если КоличествоПартии = 0 Или КоличествоСписания = КоличествоПартии Тогда
			Возврат СуммаДополнительногоРасхода;
		КонецЕсли;
		Возврат Окр(СуммаДополнительногоРасхода / КоличествоПартии * КоличествоСписания, РазрядностьСуммы());
	КонецЕсли;
	Возврат ?(СуммаСписания = СуммаПартии, СуммаДополнительногоРасхода, Окр(СуммаДополнительногоРасхода / СуммаПартии * СуммаСписания, 2));
КонецФункции

Функция ПолучитьТоварыПоОрдеруИзОснований(Основание)
	МасОснований = Новый Массив;
	тзВремТоварыКРазмещению = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент().ТЧТовары.Выгрузить();
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		МасОснований.Добавить(Основание);
	КонецЕсли;
	Если МасОснований.Количество() = 0 тогда
		Возврат тзВремТоварыКРазмещению;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Ссылка В(&МасОснований)";
	Запрос.УстановитьПараметр("МасОснований",МасОснований);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТЗТоварыССериями = СерииИРазмещение.ОбъединитьТоварыССериями(Выборка.Ссылка);
		Для Каждого Стр из ТЗТоварыССериями Цикл
			НС = тзВремТоварыКРазмещению.Добавить();
			ЗаполнитьЗначенияСвойств(НС,Стр);
		КонецЦикла;
	КонецЦикла;
	тзВремТоварыКРазмещению.Свернуть("Номенклатура,Характеристика,Серия","Количество,СуммаСНДС");
	Возврат тзВремТоварыКРазмещению;
КонецФункции

Функция ПолучитьДопРасходыПоОрдеруИзОснований(Основание)
	МасОснований = Новый Массив;
	тзВремТоварыКРазмещению = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент().ТЧДополнительныеРасходы.Выгрузить();
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		МасОснований.Добавить(Основание);
	КонецЕсли;
	Если МасОснований.Количество() = 0 тогда
		Возврат тзВремТоварыКРазмещению;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Номенклатура КАК Номенклатура,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Характеристика КАК Характеристика,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.СтатьяДДС КАК СтатьяДДС,
	|	СУММА(ПоступлениеТоваровУслугТЧДополнительныеРасходы.Сумма) КАК Сумма
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧДополнительныеРасходы КАК ПоступлениеТоваровУслугТЧДополнительныеРасходы
	|ГДЕ
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Ссылка В(&МасОснований)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Номенклатура,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Ссылка,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.СтатьяДДС,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Характеристика";
	Запрос.УстановитьПараметр("МасОснований",МасОснований);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НС = тзВремТоварыКРазмещению.Добавить();
		ЗаполнитьЗначенияСвойств(НС,Выборка);
	КонецЦикла;
	тзВремТоварыКРазмещению.Свернуть("Номенклатура,Характеристика,СтатьяДДС","Сумма");
	Возврат тзВремТоварыКРазмещению;
КонецФункции

#КонецОбласти

#Область Остатки

// Неподтверждённые партии (план warehouse-orders-cost, Ф3.10): записанная стоимость не окончательна. Приходные ордера
// с неоформленным остатком; партии ордерного происхождения (ордер и созданные из него выпуском, пересортицей, актом
// разбора, поступлением из переработки) с движениями после границы последовательности - их стоимость ещё не прошёл
// пересчёт; и всё, что создано из неподтверждённых. Замыкание - до неподвижной точки. На базе без ордеров - пусто.
//
// Возвращаемое значение:
//  Массив из ОпределяемыйТип.ПриходныйДокументПартии - партии
//
Функция НеподтвержденныеПартии() Экспорт
	// Показатель и базы цен читают его у ролей без прав на последовательность и ТоварыКОформлению; наружу - ссылки
	// партий серверным механизмам цен (Ф3.16).
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Поле = "Партия";
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Партия КАК Партия
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|ГДЕ
	|	Т.Партия ССЫЛКА Документ.ПриходныйОрдер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Источник КАК Партия
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлению.Остатки(, Источник ССЫЛКА Документ.ПриходныйОрдер) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0");
	Результаты = Запрос.ВыполнитьПакет();
	Ордерные = Результаты[0].Выгрузить().ВыгрузитьКолонку(Поле);
	Если Ордерные.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Происхождение = ЗамыканиеПартий(Ордерные);
	Неподтвержденные = Результаты[1].Выгрузить().ВыгрузитьКолонку(Поле);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Партия КАК Партия
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|ГДЕ
	|	Т.Партия В (&Партии)
	|	И Т.МоментВремени > &Граница
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Партия
	|ИЗ
	|	РегистрНакопления.ДополнительныеРасходы КАК Т
	|ГДЕ
	|	Т.Партия В (&Партии)
	|	И Т.МоментВремени > &Граница");
	Запрос.УстановитьПараметр("Партии", Происхождение);
	Запрос.УстановитьПараметр("Граница", Последовательности.Основная.ПолучитьГраницу());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Неподтвержденные, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(Поле),
		Истина);
	Возврат ЗамыканиеПартий(Неподтвержденные);
КонецФункции

// Предупреждение после проведения документа, списавшего партию с неподтверждённой стоимостью (Ф4.9, защита 2): без
// запрета, сообщением пользователю. На базе без ордерных складов - ничего.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - проведённый документ (выпуск).
//
Процедура ПредупредитьОНеподтвержденнойСтоимости(ДокОбъект) Экспорт
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОрдерныеСклады") Тогда
		Возврат;
	КонецЕсли;
	Списанные = Новый Массив;
	Для Каждого Запись Из ДокОбъект.Движения.ТоварыВНаличии Цикл
		Если Запись.ВидДвижения = ВидДвиженияНакопления.Расход И Списанные.Найти(Запись.Партия) = Неопределено Тогда
			Списанные.Добавить(Запись.Партия);
		КонецЕсли;
	КонецЦикла;
	Если Списанные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Неподтвержденные = НеподтвержденныеПартии();
	Для Каждого Партия Из Списанные Цикл
		Если Неподтвержденные.Найти(Партия) <> Неопределено Тогда
			Шаблон = НСтр("ru = 'Стоимость материала из партии %1 не подтверждена поступлением: себестоимость уточнится при пересчёте.';
				|fr = 'Le coût du matériau du lot %1 n''est pas confirmé par une réception : il sera précisé au recalcul.';
				|en = 'The material cost from batch %1 is not confirmed by a receipt: it will be refined by recalculation.';
				|es = 'El coste del material del lote %1 no está confirmado por una recepción: se ajustará al recalcular.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Партия), ДокОбъект);
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Партии и все партии, созданные из них документами, которые создают свою партию из списанной: выпуск, пересортица,
// акт разбора (списание ТоварыВНаличии), поступление из переработки (списание ТоварыВПереработке). Перемещение,
// требование, возврат партию не меняют - она та же.
//
// Параметры:
//  Партии - Массив - исходные партии
//
// Возвращаемое значение:
//  Массив - исходные и производные партии без повторов
//
Функция ЗамыканиеПартий(Партии)
	Результат = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Партии, Истина);
	Фронт = Результат;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Регистратор КАК Партия
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Т
	|ГДЕ
	|	Т.Партия В (&Фронт)
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И ТИПЗНАЧЕНИЯ(Т.Регистратор) В (ТИП(Документ.ВыпускПродукции), ТИП(Документ.ПересортицаТоваров), ТИП(Документ.АктРазбора))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыВПереработке КАК Т
	|ГДЕ
	|	Т.Партия В (&Фронт)
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Т.Регистратор ССЫЛКА Документ.ПоступлениеИзПереработки");
	// Замыкание по поколениям партий: число итераций - глубина цепочки, запрос на поколение неизбежен.
	// BSLLS:CreateQueryInCycle-off
	Пока Фронт.Количество() > 0 Цикл
		Запрос.УстановитьПараметр("Фронт", Фронт);
		Новые = Новый Массив;
		Для Каждого Партия Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Партия") Цикл
			Если Результат.Найти(Партия) = Неопределено Тогда
				Результат.Добавить(Партия);
				Новые.Добавить(Партия);
			КонецЕсли;
		КонецЦикла;
		Фронт = Новые;
	КонецЦикла;
	// BSLLS:CreateQueryInCycle-on
	Возврат Результат;
КонецФункции

// Средняя цена остатков для баз цен: неподтверждённые партии (Ф3.10, защита 1) не участвуют.
//
// Параметры:
//  Номенклатура   - Массив, СправочникСсылка.Номенклатура - позиции
//  Характеристики - Массив - характеристики
//  ДатаСреза      - Дата, Граница, МоментВремени - срез
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Цена
//
Функция ПолучитьСреднююЦенуПоОстаткам(Номенклатура, Характеристики, ДатаСреза) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЫБОР
	                      |		КОГДА ВЗ.Количество = 0
	                      |			ТОГДА 0
	                      |		ИНАЧЕ ВЫРАЗИТЬ(ВЗ.Сумма / ВЗ.Количество КАК ЧИСЛО(12, 2))
	                      |	КОНЕЦ КАК Цена
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВЗ.Номенклатура КАК Номенклатура,
	                      |		ВЗ.Характеристика КАК Характеристика,
	                      |		СУММА(ВЗ.Количество) КАК Количество,
	                      |		СУММА(ВЗ.Сумма) КАК Сумма
	                      |	ИЗ
	                      |		(ВЫБРАТЬ
	                      |			ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	                      |			ТоварыВНаличииОстатки.Характеристика КАК Характеристика,
	                      |			ТоварыВНаличииОстатки.КоличествоОстаток КАК Количество,
	                      |			ТоварыВНаличииОстатки.СуммаОстаток КАК Сумма
	                      |		ИЗ
	                      |			РегистрНакопления.ТоварыВНаличии.Остатки(
	                      |					&ДатаСреза,
	                      |					Номенклатура В (&Номенклатура)
	                      |						И Характеристика В (&Характеристики)
	                      |						И НЕ Партия В (&Неподтвержденные)) КАК ТоварыВНаличииОстатки
	                      |
	                      |		ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |		ВЫБРАТЬ
	                      |			ДополнительныеРасходы.Номенклатура,
	                      |			ДополнительныеРасходы.Характеристика,
	                      |			0,
	                      |			ДополнительныеРасходы.СуммаОстаток
	                      |		ИЗ
	                      |			РегистрНакопления.ДополнительныеРасходы.Остатки(
	                      |					&ДатаСреза,
	                      |					Номенклатура В (&Номенклатура)
	                      |						И Характеристика В (&Характеристики)
	                      |						И НЕ Партия В (&Неподтвержденные)) КАК ДополнительныеРасходы) КАК ВЗ
	                      |
	                      |	СГРУППИРОВАТЬ ПО
	                      |		ВЗ.Номенклатура,
	                      |		ВЗ.Характеристика) КАК ВЗ");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристики", Характеристики);
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	Запрос.УстановитьПараметр("Неподтвержденные", НеподтвержденныеПартии());
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьСреднююЦенуПоПоступлениям(Организация, Номенклатура, Характеристики, НачалоПериода, КонецПериода) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЫБОР
	                      |		КОГДА ВЗ.Количество = 0
	                      |			ТОГДА 0
	                      |		ИНАЧЕ ВЫРАЗИТЬ(ВЗ.Сумма / ВЗ.Количество КАК ЧИСЛО(12, 2))
	                      |	КОНЕЦ КАК Цена
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ТоварыВНаличииОбороты.Номенклатура КАК Номенклатура,
	                      |		ТоварыВНаличииОбороты.Характеристика КАК Характеристика,
	                      |		СУММА(ТоварыВНаличииОбороты.КоличествоПриход) КАК Количество,
	                      |		СУММА(ТоварыВНаличииОбороты.СуммаПриход) КАК Сумма
	                      |	ИЗ
	                      |		РегистрНакопления.ТоварыВНаличии.Обороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				Регистратор,
	                      |				Организация = &Организация
	                      |					И Номенклатура В (&Номенклатура)
	                      |					И Характеристика В (&Характеристики)) КАК ТоварыВНаличииОбороты
	                      |	ГДЕ
	                      |		ТИПЗНАЧЕНИЯ(ТоварыВНаличииОбороты.Регистратор) В (ТИП(Документ.ПоступлениеТоваровУслуг), ТИП(Документ.ПриходныйОрдер))
	                      |		И НЕ ТоварыВНаличииОбороты.Регистратор В (&Неподтвержденные)
	                      |
	                      |	СГРУППИРОВАТЬ ПО
	                      |		ТоварыВНаличииОбороты.Номенклатура,
	                      |		ТоварыВНаличииОбороты.Характеристика) КАК ВЗ");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристики", Характеристики);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Неподтвержденные", НеподтвержденныеПартии());
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьСебестоимостьПоДокументу(Док) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.ВидДвижения КАК ВидДвижения,
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЗ.Серия КАК Серия,
	                      |	СУММА(ВЗ.Количество) КАК Количество,
	                      |	СУММА(ВЗ.Сумма) КАК Сумма,
	                      |	СУММА(ВЗ.СуммаНДС) КАК СуммаНДС
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ТоварыВНаличии.ВидДвижения КАК ВидДвижения,
	                      |		ТоварыВНаличии.Номенклатура КАК Номенклатура,
	                      |		ТоварыВНаличии.Характеристика КАК Характеристика,
	                      |		ТоварыВНаличии.Серия КАК Серия,
	                      |		ТоварыВНаличии.Количество КАК Количество,
	                      |		ТоварыВНаличии.Сумма КАК Сумма,
	                      |		ТоварыВНаличии.СуммаНДС КАК СуммаНДС
	                      |	ИЗ
	                      |		РегистрНакопления.ТоварыВНаличии КАК ТоварыВНаличии
	                      |	ГДЕ
	                      |		ТоварыВНаличии.Регистратор = &Регистратор
	                      |
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |	ВЫБРАТЬ
	                      |		ДополнительныеРасходы.ВидДвижения,
	                      |		ДополнительныеРасходы.Номенклатура,
	                      |		ДополнительныеРасходы.Характеристика,
	                      |		ДополнительныеРасходы.Серия,
	                      |		0,
	                      |		ДополнительныеРасходы.Сумма,
	                      |		ДополнительныеРасходы.СуммаНДС
	                      |	ИЗ
	                      |		РегистрНакопления.ДополнительныеРасходы КАК ДополнительныеРасходы
	                      |	ГДЕ
	                      |		ДополнительныеРасходы.Регистратор = &Регистратор) КАК ВЗ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВЗ.Номенклатура,
	                      |	ВЗ.Характеристика,
	                      |	ВЗ.ВидДвижения,
	                      |	ВЗ.Серия");
	Запрос.УстановитьПараметр("Регистратор", Док);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти
