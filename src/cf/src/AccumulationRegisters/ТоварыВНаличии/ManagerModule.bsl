	НС.Период = ДатаДвижения;
	НС.МестоХранения = МестоХранения;
	НС.Номенклатура = Номенклатура;
	НС.Характеристика = Характеристика;
	НС.Серия = Серия;
	НС.Партия = Партия;
	НС.ДатаПартии = ДатаПартии;
	НС.Количество = Количество;
	НС.Сумма = Сумма;
	НС.СуммаНДС = СуммаНДС;
КонецПроцедуры

Процедура ДобавитьРасход(Движения, ДатаДвижения, МестоХранения, Номенклатура, Характеристика, Серия, Партия, ДатаПартии,
		Количество, Сумма, СуммаНДС = 0, Комплект = Неопределено)
	НС = Движения.ТоварыВНаличии.ДобавитьРасход();
	НС.Период = ДатаДвижения;
	НС.МестоХранения = МестоХранения;
	НС.Номенклатура = Номенклатура;
	НС.Характеристика = Характеристика;
	НС.Серия = Серия;
	НС.Партия = Партия;
	НС.ДатаПартии = ДатаПартии;
	НС.Количество = Количество;
	НС.Сумма = Сумма;
	НС.СуммаНДС = СуммаНДС;
	Если Комплект <> Неопределено Тогда
		НС.Комплект = Комплект;
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьНедостачу(Движения, ДатаДвижения, МестоХранения, Номенклатура, Характеристика, Серия, Количество)
