Процедура ДобавитьДанныеОприходования(ТЗТоварыССериями, ДокОбъект)
	ТЗТоварыССериями.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата")); 
	ТЗТоварыССериями.Колонки.Добавить("ВидДвижения", Новый ОписаниеТипов("ВидДвиженияНакопления"));
	ТЗТоварыССериями.Колонки.Добавить("Партия", Метаданные.ОпределяемыеТипы.ПриходныйДокументПартии.Тип);
	ТЗТоварыССериями.Колонки.Добавить("ДатаПартии", Новый ОписаниеТипов("Дата"));
	ТЗТоварыССериями.ЗаполнитьЗначения(ДокОбъект.Дата, "Период");
	ТЗТоварыССериями.ЗаполнитьЗначения(ВидДвиженияНакопления.Приход, "ВидДвижения");
	ТЗТоварыССериями.ЗаполнитьЗначения(ДокОбъект.Ссылка, "Партия");
	ТЗТоварыССериями.ЗаполнитьЗначения(ДокОбъект.Дата, "ДатаПартии");
	Партия = ДокОбъект.Ссылка;
	ТЗТоварыССериями.ЗаполнитьЗначения(Партия, "Партия");
КонецПроцедуры	

Функция СформироватьТаблицуКритическихОстатков(Период, ОтчётныйПериод, ТолькоКритические) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Товар КАК Товар,
	                      |	ВЗ.ОтгруженоЗаПериод / &ОтчётныйПериод КАК СуточнаяПотребность,
	                      |	ВЗ.ОтгруженоЗаПериод КАК ОтгруженоЗаПериод,
	                      |	СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0)) КАК Остаток,
	                      |	ВЫБОР
	                      |		КОГДА ВЗ.Товар.МинимальныйЗапас = 0
	                      |			ТОГДА 3
	                      |		ИНАЧЕ ВЗ.Товар.МинимальныйЗапас
	                      |	КОНЕЦ КАК МинимальныйЗапас,
	                      |	ВЗ.Заказано КАК Заказано,
	                      |	ВЗ.ЗаказаноКлиентами КАК ЗаказаноКлиентами
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВЗ.Товар КАК Товар,
	                      |		СУММА(ВЗ.ОтгруженоЗаПериод) КАК ОтгруженоЗаПериод,
	                      |		СУММА(ВЗ.Заказано) КАК Заказано,
	                      |		СУММА(ВЗ.ЗаказаноКлиентами) КАК ЗаказаноКлиентами
	                      |	ИЗ
	                      |		(ВЫБРАТЬ
	                      |			ТоварыНаСкладах.Товар КАК Товар,
	                      |			ВЫБОР
	                      |				КОГДА ТоварыНаСкладах.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                      |					ТОГДА ТоварыНаСкладах.Количество
	                      |				ИНАЧЕ -ТоварыНаСкладах.Количество
	                      |			КОНЕЦ КАК ОтгруженоЗаПериод,
	                      |			0 КАК Заказано,
	                      |			0 КАК ЗаказаноКлиентами
	                      |		ИЗ
	                      |			РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
	                      |		ГДЕ
	                      |			ТоварыНаСкладах.Период МЕЖДУ ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Период, ДЕНЬ), ДЕНЬ, -&ОтчётныйПериод) И ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -1)
	                      |			И (ТоварыНаСкладах.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	                      |					ИЛИ ТоварыНаСкладах.Регистратор ССЫЛКА Документ.ВозвратПокупателя
	                      |					ИЛИ ТоварыНаСкладах.Регистратор ССЫЛКА Документ.СписаниеПродуктовДляСотрудников)
	                      |		
	                      |		ОБЪЕДИНИТЬ ВСЕ
	                      |		
	                      |		
	                      |		ВЫБРАТЬ
	                      |			ОбъёмыЗакупокСрезПоследних.Номенклатура,
	                      |			0,
	                      |			ОбъёмыЗакупокСрезПоследних.Количество,
	                      |			0
	                      |		ИЗ
	                      |			РегистрСведений.ОбъёмыЗакупок.СрезПоследних(
	                      |					,
	                      |					ДатаПрихода МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, ВЫБОР
	                      |							КОГДА Номенклатура.МинимальныйЗапас = 0
	                      |								ТОГДА 3
	                      |							ИНАЧЕ Номенклатура.МинимальныйЗапас
	                      |						КОНЕЦ)) КАК ОбъёмыЗакупокСрезПоследних
	                      |		
	                      |		ОБЪЕДИНИТЬ ВСЕ
	                      |		
	                      |		ВЫБРАТЬ
	                      |			ЗаказТовары.Товар,
	                      |			0,
	                      |			0,
	                      |			ЗаказТовары.Количество
	                      |		ИЗ
	                      |			Документ.Заказ.Товары КАК ЗаказТовары
	                      |		ГДЕ
	                      |			ЗаказТовары.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
	                      |			И ЗаказТовары.Ссылка.ПометкаУдаления = ЛОЖЬ) КАК ВЗ
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		ВЗ.Товар) КАК ВЗ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(&Период, Качество В (&Качество)) КАК ТоварыНаСкладахОстатки
	                      |		ПО ВЗ.Товар = ТоварыНаСкладахОстатки.Товар
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВЗ.Товар,
	                      |	ВЗ.ОтгруженоЗаПериод / &ОтчётныйПериод,
	                      |	ВЗ.ОтгруженоЗаПериод,
	                      |	ВЫБОР
	                      |		КОГДА ВЗ.Товар.МинимальныйЗапас = 0
	                      |			ТОГДА 3
	                      |		ИНАЧЕ ВЗ.Товар.МинимальныйЗапас
	                      |	КОНЕЦ,
	                      |	ВЗ.Заказано,
	                      |	ВЗ.ЗаказаноКлиентами
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВЗ.Товар КАК Товар,
	                      |	ВЗ.Единица КАК Единица,
	                      |	ВЗ.СуточнаяПотребность КАК СуточнаяПотребность,
	                      |	ВЗ.МинимальныйОстаток КАК МинимальныйОстаток,
	                      |	ВЗ.Остаток КАК Остаток,
	                      |	ВЗ.Запас КАК Запас,
	                      |	ВЗ.МинимальныйЗапас КАК МинимальныйЗапас,
	                      |	ВЗ.Заказано КАК Заказано,
	                      |	ВЗ.ЗаказаноКлиентами КАК ЗаказаноКлиентами,
	                      |	ВЫБОР
	                      |		КОГДА ВЗ.ОсноваРасчёта - ВЗ.Остаток < 0
	                      |			ТОГДА 0
	                      |		ИНАЧЕ ВЗ.ОсноваРасчёта - ВЗ.Остаток
	                      |	КОНЕЦ КАК КЗакупке
	                      |ПОМЕСТИТЬ ВТИтог
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТ.Товар КАК Товар,
	                      |		ВТ.Товар.ОсновнаяЕдиница КАК Единица,
	                      |		ВТ.СуточнаяПотребность КАК СуточнаяПотребность,
	                      |		ВТ.СуточнаяПотребность * ВТ.МинимальныйЗапас КАК МинимальныйОстаток,
	                      |		ВТ.Остаток КАК Остаток,
	                      |		ВТ.Остаток / ВЫБОР
	                      |			КОГДА ВТ.СуточнаяПотребность = 0
	                      |				ТОГДА 1
	                      |			ИНАЧЕ ВТ.СуточнаяПотребность
	                      |		КОНЕЦ КАК Запас,
	                      |		ВТ.МинимальныйЗапас КАК МинимальныйЗапас,
	                      |		ВТ.Заказано КАК Заказано,
	                      |		ВТ.ЗаказаноКлиентами КАК ЗаказаноКлиентами,
	                      |		ВЫБОР
	                      |			КОГДА ВТ.СуточнаяПотребность * ВТ.МинимальныйЗапас > ВТ.Заказано + ВТ.ЗаказаноКлиентами
	                      |				ТОГДА ВТ.СуточнаяПотребность * ВТ.МинимальныйЗапас
	                      |			ИНАЧЕ ВТ.Заказано + ВТ.ЗаказаноКлиентами
	                      |		КОНЕЦ КАК ОсноваРасчёта
	                      |	ИЗ
	                      |		ВТ КАК ВТ) КАК ВЗ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТИтог.Товар КАК Товар,
	                      |	ВТИтог.Единица КАК Единица,
	                      |	ВТИтог.СуточнаяПотребность КАК СуточнаяПотребность,
	                      |	ВТИтог.МинимальныйОстаток КАК МинимальныйОстаток,
	                      |	ВТИтог.Остаток КАК Остаток,
	                      |	ВТИтог.Запас КАК Запас,
	                      |	ВТИтог.МинимальныйЗапас КАК МинимальныйЗапас,
	                      |	ВТИтог.Заказано КАК Заказано,
	                      |	ВТИтог.ЗаказаноКлиентами КАК ЗаказаноКлиентами,
	                      |	ВТИтог.КЗакупке КАК КЗакупке
	                      |ИЗ
	                      |	ВТИтог КАК ВТИтог
	                      |ГДЕ
	                      |	ВЫБОР
	                      |			КОГДА &ТолькоКритические
	                      |				ТОГДА ВТИтог.КЗакупке > 0
	                      |			ИНАЧЕ ИСТИНА
	                      |		КОНЕЦ");
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ОтчётныйПериод", ОтчётныйПериод); 
	Запрос.УстановитьПараметр("ТолькоКритические", ТолькоКритические);
	Возврат Запрос.Выполнить().Выгрузить();	
КонецФункции	

Функция РассчитатьСуммуСписанияДополнительныхРасходов(СуммаСписания, СуммаПартии, СуммаДополнительногоРасхода)
	Возврат ?(СуммаСписания = СуммаПартии, СуммаДополнительногоРасхода, Окр(СуммаДополнительногоРасхода / СуммаПартии * СуммаСписания, 2))	
КонецФункции

Функция ПолучитьТоварыПоОрдеруИзОснований(Основание)
	МасОснований = Новый Массив;
	тзВремТоварыКРазмещению = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент().ТЧТовары.Выгрузить();
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		МасОснований.Добавить(Основание);
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаданиеНаПеревозку") Тогда
		МасОснований = Основание.ТЧНакладные.ВыгрузитьКолонку("Накладная");
	КонецЕсли;
	Если МасОснований.Количество() = 0 тогда
		Возврат тзВремТоварыКРазмещению;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Ссылка В(&МасОснований)";
	Запрос.УстановитьПараметр("МасОснований",МасОснований);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТЗТоварыССериями = СерииИРазмещение.ОбъединитьТоварыССериями(Выборка.Ссылка);
		Для Каждого Стр из ТЗТоварыССериями Цикл 
			НС = тзВремТоварыКРазмещению.Добавить();
			ЗаполнитьЗначенияСвойств(НС,Стр);
		КонецЦикла;
	КонецЦикла;
	тзВремТоварыКРазмещению.Свернуть("Номенклатура,Характеристика,Серия","Количество,СуммаСНДС");
	Возврат тзВремТоварыКРазмещению;
КонецФункции

Функция ПолучитьДопРасходыПоОрдеруИзОснований(Основание)
	МасОснований = Новый Массив;
	тзВремТоварыКРазмещению = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент().ТЧДополнительныеРасходы.Выгрузить();
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		МасОснований.Добавить(Основание);
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаданиеНаПеревозку") Тогда
		МасОснований = Основание.ТЧНакладные.ВыгрузитьКолонку("Накладная");
		Для Каждого Стр из Основание.ТЧДополнительныеРасходы Цикл 
			НС = тзВремТоварыКРазмещению.Добавить();
			ЗаполнитьЗначенияСвойств(НС,Стр);
		КонецЦикла;
	КонецЕсли;
	Если МасОснований.Количество() = 0 тогда
		Возврат тзВремТоварыКРазмещению;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Номенклатура КАК Номенклатура,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Характеристика КАК Характеристика,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.СтатьяДДС КАК СтатьяДДС,
	|	СУММА(ПоступлениеТоваровУслугТЧДополнительныеРасходы.Сумма) КАК Сумма
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧДополнительныеРасходы КАК ПоступлениеТоваровУслугТЧДополнительныеРасходы
	|ГДЕ
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Ссылка В(&МасОснований)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Номенклатура,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Ссылка,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.СтатьяДДС,
	|	ПоступлениеТоваровУслугТЧДополнительныеРасходы.Характеристика";
	Запрос.УстановитьПараметр("МасОснований",МасОснований);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НС = тзВремТоварыКРазмещению.Добавить();
		ЗаполнитьЗначенияСвойств(НС,Выборка);
	КонецЦикла;
	тзВремТоварыКРазмещению.Свернуть("Номенклатура,Характеристика,СтатьяДДС","Сумма");
	Возврат тзВремТоварыКРазмещению;
КонецФункции

#КонецОбласти

#Область Остатки

Функция ПолучитьСреднююЦенуПоОстаткам(Номенклатура, Характеристики, ДатаСреза) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЫБОР
	                      |		КОГДА ВЗ.Количество = 0
	                      |			ТОГДА 0
	                      |		ИНАЧЕ ВЫРАЗИТЬ(ВЗ.Сумма / ВЗ.Количество КАК ЧИСЛО(12, 2))
	                      |	КОНЕЦ КАК Цена
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВЗ.Номенклатура КАК Номенклатура,
	                      |		ВЗ.Характеристика КАК Характеристика,
	                      |		СУММА(ВЗ.Количество) КАК Количество,
	                      |		СУММА(ВЗ.Сумма) КАК Сумма
	                      |	ИЗ
	                      |		(ВЫБРАТЬ
	                      |			ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	                      |			ТоварыВНаличииОстатки.Характеристика КАК Характеристика,
	                      |			ТоварыВНаличииОстатки.КоличествоОстаток КАК Количество,
	                      |			ТоварыВНаличииОстатки.СуммаОстаток КАК Сумма
	                      |		ИЗ
	                      |			РегистрНакопления.ТоварыВНаличии.Остатки(
	                      |					&ДатаСреза,
	                      |					Номенклатура В (&Номенклатура)
	                      |						И Характеристика В (&Характеристики)) КАК ТоварыВНаличииОстатки
	                      |		
	                      |		ОБЪЕДИНИТЬ ВСЕ
	                      |		
	                      |		ВЫБРАТЬ
	                      |			ДополнительныеРасходы.Номенклатура,
	                      |			ДополнительныеРасходы.Характеристика,
	                      |			0,
	                      |			ДополнительныеРасходы.СуммаОстаток
	                      |		ИЗ
	                      |			РегистрНакопления.ДополнительныеРасходы.Остатки(
	                      |					&ДатаСреза,
	                      |					Номенклатура В (&Номенклатура)
	                      |						И Характеристика В (&Характеристики)) КАК ДополнительныеРасходы) КАК ВЗ
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		ВЗ.Номенклатура,
	                      |		ВЗ.Характеристика) КАК ВЗ");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристики", Характеристики);
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьСреднююЦенуПоПоступлениям(Организация, Номенклатура, Характеристики, НачалоПериода, КонецПериода) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЫБОР
	                      |		КОГДА ВЗ.Количество = 0
	                      |			ТОГДА 0
	                      |		ИНАЧЕ ВЫРАЗИТЬ(ВЗ.Сумма / ВЗ.Количество КАК ЧИСЛО(12, 2))
	                      |	КОНЕЦ КАК Цена
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ТоварыВНаличииОбороты.Номенклатура КАК Номенклатура,
	                      |		ТоварыВНаличииОбороты.Характеристика КАК Характеристика,
	                      |		СУММА(ТоварыВНаличииОбороты.КоличествоПриход) КАК Количество,
	                      |		СУММА(ТоварыВНаличииОбороты.СуммаПриход) КАК Сумма
	                      |	ИЗ
	                      |		РегистрНакопления.ТоварыВНаличии.Обороты(
	                      |				&НачалоПериода,
	                      |				&КонецПериода,
	                      |				Регистратор,
	                      |				Организация = &Организация
	                      |					И Номенклатура В (&Номенклатура)
	                      |					И Характеристика В (&Характеристики)) КАК ТоварыВНаличииОбороты
	                      |	ГДЕ
	                      |		ТоварыВНаличииОбороты.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		ТоварыВНаличииОбороты.Номенклатура,
	                      |		ТоварыВНаличииОбороты.Характеристика) КАК ВЗ");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристики", Характеристики);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Возврат Запрос.Выполнить().Выгрузить();	
КонецФункции

Функция ПолучитьСебестоимостьПоДокументу(Док) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЗ.ВидДвижения КАК ВидДвижения,
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЗ.Серия КАК Серия,
	                      |	СУММА(ВЗ.Количество) КАК Количество,
	                      |	СУММА(ВЗ.Сумма) КАК Сумма
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ТоварыВНаличии.ВидДвижения КАК ВидДвижения,
	                      |		ТоварыВНаличии.Номенклатура КАК Номенклатура,
	                      |		ТоварыВНаличии.Характеристика КАК Характеристика,
	                      |		ТоварыВНаличии.Серия КАК Серия,
	                      |		ТоварыВНаличии.Количество КАК Количество,
	                      |		ТоварыВНаличии.Сумма КАК Сумма
	                      |	ИЗ
	                      |		РегистрНакопления.ТоварыВНаличии КАК ТоварыВНаличии
	                      |	ГДЕ
	                      |		ТоварыВНаличии.Регистратор = &Регистратор
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		ДополнительныеРасходы.ВидДвижения,
	                      |		ДополнительныеРасходы.Номенклатура,
	                      |		ДополнительныеРасходы.Характеристика,
	                      |		ДополнительныеРасходы.Серия,
	                      |		0,
	                      |		ДополнительныеРасходы.Сумма
	                      |	ИЗ
	                      |		РегистрНакопления.ДополнительныеРасходы КАК ДополнительныеРасходы
	                      |	ГДЕ
	                      |		ДополнительныеРасходы.Регистратор = &Регистратор) КАК ВЗ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВЗ.Номенклатура,
	                      |	ВЗ.Характеристика,
	                      |	ВЗ.ВидДвижения,
	                      |	ВЗ.Серия");
	Запрос.УстановитьПараметр("Регистратор", Док);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

