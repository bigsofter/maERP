    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ТоварыВНаличииОстатки.Партия КАК Партия,
	ТоварыВНаличииОстатки.ДатаПартии КАК ДатаПартии,
	ТоварыВНаличииОстатки.Партия.Контрагент КАК Поставщик,
	СУММА(ТоварыВНаличииОстатки.КоличествоОстаток) КАК Количество,
	ВЫБОР
		КОГДА СУММА(ТоварыВНаличииОстатки.КоличествоОстаток) = 0
			ТОГДА 0
		ИНАЧЕ ВЫРАЗИТЬ(СУММА(ТоварыВНаличииОстатки.СуммаОстаток) / СУММА(ТоварыВНаличииОстатки.КоличествоОстаток) КАК ЧИСЛО(15, 2))
	КОНЕЦ КАК ЦенаЗакупки
ИЗ
	РегистрНакопления.ТоварыВНаличии.Остатки(
			&amp;ДатаОст,
			МестоХранения = &amp;МестоХранения
				И Номенклатура = &amp;Номенклатура
				И Характеристика = &amp;Характеристика) КАК ТоварыВНаличииОстатки

СГРУППИРОВАТЬ ПО
	ТоварыВНаличииОстатки.Партия,
	ТоварыВНаличииОстатки.ДатаПартии,
	ТоварыВНаличииОстатки.Партия.Контрагент

УПОРЯДОЧИТЬ ПО
	ДатаПартии</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
