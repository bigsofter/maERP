
#Область Формирование_движений

Процедура СформироватьДвижения(ДокОбъект) Экспорт
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект,"ХозяйственнаяОперация") Тогда 
		Если Не ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПокупателями(ДокОбъект.ХозяйственнаяОперация) Тогда Возврат КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		// Суммы регистра - в основной валюте, зачёт авансов - тоже (аванс - оплата в основной валюте).
		Курс = РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс;
		СуммаДокумента = РаботаСВалютамиКлиентСервер.СуммаРегл(ДокОбъект.Сумма, Курс);
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧЗачётАвансов, Истина, Ложь, Истина, СуммаДокумента);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратОтПокупателя") Тогда
		// Возврат в валюте основания и по его курсу: в основной валюте - по курсу, в валюте - сумма как есть.
		СуммаДокумента = РаботаСВалютамиКлиентСервер.СуммаРегл(ДокОбъект.Сумма,
			РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс);
		// Возврат по реализации, покрытой накладной, - на объект и аналитики приёма долга накладной (Ф1
		// docs/plans/commerce-two-orgs.md): организация и договор реализации, контрагент накладной.
		Основание = ?(ЗначениеЗаполнено(ДокОбъект.Основание), ДокОбъект.Основание, ДокОбъект.Ссылка);
		ОбъектыРасчетов = ОбъектыРасчетовОснования(Основание);
		ТЗАвансы = СтрокиПоОбъектамРасчетов(ОбъектыРасчетов, СуммаДокумента, ДокОбъект.Сумма);
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ТЗАвансы, Истина, Истина, Ложь, СуммаДокумента);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств") Тогда			
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Ложь, Ложь, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда			
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Ложь, Истина, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Ложь, Ложь, Ложь, ДокОбъект.Сумма);		
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда	
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Ложь, Истина, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаДолга") Тогда
		Движения = ДокОбъект.Движения;
		//Мас = ДокОбъект.ДополнительныеСвойства.ТЗКредиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПокупателем", Истина));
		Для Каждого Стр Из ДокОбъект.ДополнительныеСвойства.ТЗКредиторскаяЗадолженность Цикл
			ОбъектРасчётов = Стр.ОбъектРасчётов;
			Движение(Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.КонтрагентКредитор, , ОбъектРасчётов, Стр.Сумма, Ложь); 
		КонецЦикла;
		//Мас = ДокОбъект.ДополнительныеСвойства.ТЗДебиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПокупателем", Истина));
		//Для Каждого Стр Из Мас Цикл
		//	ОбъектРасчётов = ?(ТипЗнч(Стр.ОбъектРасчётов) = Тип("СправочникСсылка.ДоговорыСКонтрагентами"), ДокОбъект.Ссылка, Стр.ОбъектРасчётов);
		//	Движение(Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.КонтрагентДебитор, Стр.Договор, ОбъектРасчётов, Стр.Сумма, Истина);
		//КонецЦикла;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СертификатНаОплату") Тогда
		Если ЗначениеЗаполнено(ДокОбъект.Реализация) Тогда
			// Аналитики сертификата - реализации; на покрытой накладной - аналитики приёма долга накладной.
			ОбъектыРасчетов = ОбъектыРасчетовОснования(ДокОбъект.Реализация);
			Строки = СтрокиПоОбъектамРасчетов(ОбъектыРасчетов, ДокОбъект.Сумма);
			Для Каждого Стр Из Строки Цикл
				Движение(ДокОбъект.Движения, ДокОбъект.Дата, ?(Стр.Организация = Неопределено, ДокОбъект.Организация,
					Стр.Организация), ?(Стр.Контрагент = Неопределено, ДокОбъект.Реализация.Контрагент, Стр.Контрагент),
					?(Стр.Договор = Неопределено, ДокОбъект.Реализация.Договор, Стр.Договор), Стр.Основание, Стр.Сумма, Ложь);
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.НалоговаяНакладная") Тогда
		СформироватьПоНалоговойНакладной(ДокОбъект);
	КонецЕсли;
КонецПроцедуры

// Переносит расчеты с реализаций-оснований на налоговую накладную: долг каждой отгрузки
// и ее оплаты сторнируются, а накладная принимает их на себя тем же объектом расчетов.
// Сальдо контрагента не меняется, двойного счета с налоговым регистром не возникает.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладная - проводимая накладная.
//
Процедура СформироватьПоНалоговойНакладной(ДокОбъект)
	ДатаНакладной = ДокОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаНакладной) Тогда
		Возврат;
	КонецЕсли;
	ТЗОтгрузки = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект, "ОтгрузкаТовара");
	Если ТЗОтгрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ДанныеОтгрузок = ДанныеРеализаций(ТЗОтгрузки.ВыгрузитьКолонку("Основание"));
	// BSLLS:YoLetterUsage-off
	ВалютыДолга = ВалютыСобственногоДолга("ВзаиморасчётыСПокупателями", ТЗОтгрузки.ВыгрузитьКолонку("Основание"));
	// BSLLS:YoLetterUsage-on
	ДолгПоОтгрузкам(ДокОбъект, ТЗОтгрузки, ДанныеОтгрузок, ДатаНакладной, ВалютыДолга);
	// Оплаты отгрузок переносятся фактическими записями этого регистра - и в основной валюте, и в валюте
	// (docs/plans/commerce-two-orgs.md, Ф5): оплата, не записавшая расчётов (до даты начала учёта или не по расчётам с
	// покупателями), не даёт ложного долга.
	ОплатыВалютныхОтгрузок(ДокОбъект, ТЗОтгрузки, ДанныеОтгрузок);
КонецПроцедуры

// Сторнирует долг отгрузок и заводит его на накладную.
// Организация и договор берутся с отгрузки, а не с накладной: накладная может собирать
// отгрузки разных договоров одного контрагента, и сторно ушло бы на чужой договор.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладная - проводимая накладная.
//  ТЗОтгрузки - ТаблицаЗначений - покрытые отгрузки, колонки Основание и Сумма.
//  ДанныеОтгрузок - Соответствие - реквизиты реализаций.
//  ДатаНакладной - Дата - период движений долга.
//  ВалютыДолга - Соответствие - валюта измерения собственного долга отгрузки (см. ВалютыСобственногоДолга): сторно - в
//                ней, приём на накладную - в каноническом виде (ревью 2.0.17.24, круг 5).
//
Процедура ДолгПоОтгрузкам(ДокОбъект, ТЗОтгрузки, ДанныеОтгрузок, ДатаНакладной, ВалютыДолга)
	Движения = ДокОбъект.Движения;
	Для Каждого Стр Из ТЗОтгрузки Цикл
		Реквизиты = ДанныеОтгрузок.Получить(Стр.Основание);
		Если Реквизиты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Покрытая сумма - в валюте отгрузки: в регистр в основной валюте по её курсу, в валюте - как есть.
		СуммаРегл = РаботаСВалютамиКлиентСервер.СуммаРегл(Стр.Сумма, Реквизиты.Курс);
		// Сторно - под контрагентом реализации (её долг записан под ним), приём - под контрагентом накладной.
		Движение(Движения, ДатаНакладной, Реквизиты.Организация, Реквизиты.Контрагент,
			Реквизиты.Договор, Стр.Основание, -СуммаРегл, Истина, -Стр.Сумма, ВалютыДолга.Получить(Стр.Основание));
		Движение(Движения, ДатаНакладной, Реквизиты.Организация, ДокОбъект.Контрагент,
			Реквизиты.Договор, ДокОбъект.Ссылка, СуммаРегл, Истина, Стр.Сумма);
	КонецЦикла;
КонецПроцедуры

// Переносит на налоговую накладную оплаты её отгрузок: фактические записи этого регистра по отгрузке от оплат, которые
// видит накладная (ПолучитьОплаты, без исключаемого регистратора), - с их периодом, видом движения и обеими суммами, в
// доле покрытия отгрузки накладной. Платёж со строкой на саму накладную не переносится: его записи на реализациях -
// уже результат разнесения оплаты накладной (Ф3.1), а строка на реализацию в таком платеже запрещена.
// Период движения - дата платежа: налоговый регистр пишет оплату на дату платежа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладная - проводимая накладная.
//  ТЗОтгрузки - ТаблицаЗначений - покрытые отгрузки, колонки Основание и Сумма (в валюте отгрузки).
//  ДанныеОтгрузок - Соответствие - реквизиты реализаций (см. ДанныеРеализаций).
//
Процедура ОплатыВалютныхОтгрузок(ДокОбъект, ТЗОтгрузки, ДанныеОтгрузок)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Период КАК Период,
	|	Т.ВидДвижения КАК ВидДвижения,
	|	Т.ОбъектРасчётов КАК Отгрузка,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаВВалюте КАК СуммаВВалюте,
	|	Т.Валюта КАК Валюта
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
	|ГДЕ
	|	Т.ОбъектРасчётов В (&Отгрузки)
	|	И Т.Регистратор В (&Оплаты)";
	Запрос.УстановитьПараметр("Отгрузки", ТЗОтгрузки.ВыгрузитьКолонку("Основание"));
	Запрос.УстановитьПараметр("Оплаты", ПереносимыеОплаты(ДокОбъект));
	Выборка = Запрос.Выполнить().Выбрать();
	Движения = ДокОбъект.Движения;
	Пока Выборка.Следующий() Цикл
		Реквизиты = ДанныеОтгрузок.Получить(Выборка.Отгрузка);
		СтрокаПокрытия = ТЗОтгрузки.Найти(Выборка.Отгрузка, "Основание");
		Если Реквизиты = Неопределено Или СтрокаПокрытия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Сумма = РаботаСДокументами.СуммаВДолеПокрытия(Выборка.Сумма, СтрокаПокрытия.Сумма, Реквизиты.СуммаДокумента);
		СуммаВВалюте = РаботаСДокументами.СуммаВДолеПокрытия(Выборка.СуммаВВалюте, СтрокаПокрытия.Сумма,
			Реквизиты.СуммаДокумента);
		Приход = Выборка.ВидДвижения = ВидДвиженияНакопления.Приход;
		// Сторно - в валюте измерения записи оплаты, приём на накладную - в каноническом виде.
		Движение(Движения, Выборка.Период, Реквизиты.Организация, Реквизиты.Контрагент,
			Реквизиты.Договор, Выборка.Отгрузка, -Сумма, Приход, -СуммаВВалюте, Выборка.Валюта);
		Движение(Движения, Выборка.Период, Реквизиты.Организация, ДокОбъект.Контрагент,
			Реквизиты.Договор, ДокОбъект.Ссылка, Сумма, Приход, СуммаВВалюте);
	КонецЦикла;
КонецПроцедуры

// Платежи, чьи записи по отгрузкам переносит накладная: оплаты из снимка денег, кроме платежей со строкой на саму
// накладную (см. ОплатыВалютныхОтгрузок).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция ПереносимыеОплаты(ДокОбъект) Экспорт
	ТЗОплат = РегистрыНакопления.ДенежныеСредстваОрганизаций.ПолучитьОплаты(ДокОбъект, Истина);
	ПрямыеОплаты = Новый Массив;
	Для Каждого СтрОплат Из ТЗОплат Цикл
		Если СтрОплат.ДокументПродажи = ДокОбъект.Ссылка И ПрямыеОплаты.Найти(СтрОплат.Регистратор) = Неопределено Тогда
			ПрямыеОплаты.Добавить(СтрОплат.Регистратор);
		КонецЕсли;
	КонецЦикла;
	ТЗОплат.Свернуть("Регистратор");
	Результат = Новый Массив;
	Для Каждого СтрОплат Из ТЗОплат Цикл
		Если ПрямыеОплаты.Найти(СтрОплат.Регистратор) = Неопределено Тогда
			Результат.Добавить(СтрОплат.Регистратор);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Объекты расчётов основания с учётом переезда расчётов на налоговую накладную (Ф1 docs/plans/commerce-two-orgs.md).
// Если отгрузка покрыта проведённой накладной, которая переносит расчёты, документ, введённый после накладной, пишет
// на накладную - иначе его движение повиснет на обнулённой отгрузке, и контроль кредита увидит завышенный долг. Пишет
// с аналитиками приёма долга накладной (ДолгПоОтгрузкам): организация и договор реализации, контрагент накладной.
//
// Применяется к документам, которых не видит ПолучитьОплаты: сертификат на оплату и возврат от покупателя не пишут
// движений по кассе, поэтому перепроведение накладной их не подхватит. Денежные документы сюда не попадают.
//
// Доля - на будущее несколько частичных накладных (Ф7): в этой сборке отгрузку покрывает не больше одной накладной,
// и весь документ уходит на неё, как до 2.0.17.23.
//
// Параметры:
//  Основание - ДокументСсылка - отгрузка или иной объект расчётов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ОбъектРасчётов, Организация, Контрагент, Договор (Неопределено - аналитики документа,
//                    который пишет движение), Доля (Число; сумма долей - 1).
//
// BSLLS:YoLetterUsage-off
Функция ОбъектыРасчетовОснования(Основание) Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ОбъектРасчётов");
	Результат.Колонки.Добавить("Организация");
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("Договор");
	Результат.Колонки.Добавить("Доля", Новый ОписаниеТипов("Число"));
	Накладные = Новый Массив;
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И ЗначениеЗаполнено(Основание) Тогда
		Накладные = РаботаСДокументами.НакладныеПереносящиеРасчеты(
			РаботаСДокументами.НалоговыеНакладныеПоОснованиям(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основание)));
	КонецЕсли;
	Если Накладные.Количество() > 0 Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	Реализация.Организация КАК Организация,
		                      |	Реализация.Договор КАК Договор,
		                      |	Накладная.Ссылка КАК ОбъектРасчётов,
		                      |	Накладная.Контрагент КАК Контрагент
		                      |ИЗ
		                      |	Документ.РеализацияТоваровУслуг КАК Реализация,
		                      |	Документ.НалоговаяНакладная КАК Накладная
		                      |ГДЕ
		                      |	Реализация.Ссылка = &Основание
		                      |	И Накладная.Ссылка = &Накладная");
		Запрос.УстановитьПараметр("Основание", Основание);
		Запрос.УстановитьПараметр("Накладная", Накладные[0]);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НС = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Выборка);
			НС.Доля = 1;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	НС = Результат.Добавить();
	НС.ОбъектРасчётов = Основание;
	НС.Доля = 1;
	Возврат Результат;
КонецФункции

// Раскладывает сумму документа по объектам расчётов в их долях: остаток округления - в последнюю строку.
//
// Параметры:
//  ОбъектыРасчетов - ТаблицаЗначений - см. ОбъектыРасчетовОснования.
//  Сумма - Число - сумма в основной валюте.
//  СуммаВВалюте - Число, Неопределено - сумма в валюте объекта; Неопределено - колонки нет.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Основание, Сумма, СуммаВВалюте (если задана), Организация, Контрагент, Договор.
//
Функция СтрокиПоОбъектамРасчетов(ОбъектыРасчетов, Сумма, СуммаВВалюте = Неопределено) Экспорт
	ТипСуммы = Метаданные.ОпределяемыеТипы.Сумма.Тип;
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Основание");
	Результат.Колонки.Добавить("Сумма", ТипСуммы);
	Если СуммаВВалюте <> Неопределено Тогда
		Результат.Колонки.Добавить("СуммаВВалюте", ТипСуммы);
	КонецЕсли;
	Результат.Колонки.Добавить("Организация");
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("Договор");
	ТочностьСуммы = 2;
	ОстатокСуммы = Сумма;
	ОстатокВВалюте = СуммаВВалюте;
	Последняя = ОбъектыРасчетов.Количество() - 1;
	Для Индекс = 0 По Последняя Цикл
		Объект = ОбъектыРасчетов[Индекс];
		НС = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Объект, "Организация, Контрагент, Договор");
		НС.Основание = Объект.ОбъектРасчётов;
		НС.Сумма = ?(Индекс = Последняя, ОстатокСуммы, Окр(Сумма * Объект.Доля, ТочностьСуммы));
		ОстатокСуммы = ОстатокСуммы - НС.Сумма;
		Если СуммаВВалюте <> Неопределено Тогда
			НС.СуммаВВалюте = ?(Индекс = Последняя, ОстатокВВалюте, Окр(СуммаВВалюте * Объект.Доля, ТочностьСуммы));
			ОстатокВВалюте = ОстатокВВалюте - НС.СуммаВВалюте;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контрагенты, под которыми документ по основанию пишет расчёты: свой и контрагенты объектов расчётов основания
// (накладная на другого покупателя). Для блокировки до записи.
//
// Параметры:
//  Основание - ДокументСсылка - основание документа.
//  Контрагент - СправочникСсылка.Контрагенты - контрагент документа.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты
//
Функция КонтрагентыРасчетовОснования(Основание, Контрагент) Экспорт
	Результат = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Контрагент);
	Для Каждого Строка Из ОбъектыРасчетовОснования(Основание) Цикл
		Если Строка.Контрагент <> Неопределено И Результат.Найти(Строка.Контрагент) = Неопределено Тогда
			Результат.Добавить(Строка.Контрагент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
// BSLLS:YoLetterUsage-on

// Возвращает реквизиты реализаций одним запросом - в цикле по строкам к данным не обращаемся.
//
// Параметры:
//  МассивРеализаций - Массив - ссылки на РеализацияТоваровУслуг.
//
// Возвращаемое значение:
//  Соответствие - ключ ДокументСсылка.РеализацияТоваровУслуг, значение - структура
//                 с полями Организация, Контрагент, Договор, СуммаДокумента, Курс.
//
Функция ДанныеРеализаций(МассивРеализаций)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Реализация.Ссылка КАК Основание,
	                      |	Реализация.Организация КАК Организация,
	                      |	Реализация.Контрагент КАК Контрагент,
	                      |	Реализация.Договор КАК Договор,
	                      |	Реализация.Сумма КАК СуммаДокумента
	                      |ИЗ
	                      |	Документ.РеализацияТоваровУслуг КАК Реализация
	                      |ГДЕ
	                      |	Реализация.Ссылка В (&МассивРеализаций)");
	Запрос.УстановитьПараметр("МассивРеализаций", МассивРеализаций);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Реквизиты = Новый Структура("Организация, Контрагент, Договор, СуммаДокумента, Курс");
		ЗаполнитьЗначенияСвойств(Реквизиты, Выборка);
		// Сумма документа - в его валюте (доля покрытия безразмерна), курс - для перевода в основную валюту.
		Реквизиты.Курс = РаботаСВалютами.ВалютаИКурсОбъекта(Выборка.Основание).Курс;
		Результат.Вставить(Выборка.Основание, Реквизиты);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура СформироватьПоПлатёжномуДокументу(ДокОбъект, ТЧАвансы, Приход, Сторно, ЭтоДокументРасчётов, СуммаРаспределения) 
	ЭтоОплата = РаботаСВалютами.ЭтоПлатежныйДокумент(ДокОбъект);
	ДатаПроведения = ДокОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаПроведения) Тогда Возврат КонецЕсли;
	СуммаОстаток = СуммаРаспределения;
	Движения = ДокОбъект.Движения;
	// Колонка СуммаВВалюте есть только у таблицы возврата: точная сумма в валюте объекта.
	ЕстьСуммаВВалюте = ТипЗнч(ТЧАвансы) = Тип("ТаблицаЗначений") И ТЧАвансы.Колонки.Найти("СуммаВВалюте") <> Неопределено;
	ЕстьАналитики = ТипЗнч(ТЧАвансы) = Тип("ТаблицаЗначений") И ТЧАвансы.Колонки.Найти("Контрагент") <> Неопределено;
	// Строка оплаты по налоговой накладной разносится по долгу её реализаций, остаток - аванс платежа (Ф3.1).
	АвансСверхДолга = 0;
	НачатьРазнесениеПоДолгуНакладных(ДокОбъект);
	// BSLLS:YoLetterUsage-off
	ПоДолгуНакладной = ЭтоОплата И Не ЭтоДокументРасчётов;
	// BSLLS:YoLetterUsage-on
	Для Каждого Стр Из ТЧАвансы Цикл
		Если ОплатаНакладнойПоДолгуРеализаций(ДокОбъект, Стр.Основание, Сторно, ПоДолгуНакладной) Тогда
			АвансСверхДолга = АвансСверхДолга + ОплатитьДолгНакладной(ДокОбъект, Стр, Приход, ДатаПроведения);
		ИначеЕсли ЭтоДокументРасчётов Тогда
			// Сторнируем аванс
			Движение(ДокОбъект.Движения, ДатаПроведения, Стр.Основание.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, Стр.Основание, ?(Сторно, Стр.Сумма, -Стр.Сумма), Не Приход);
			// Делаем задолженность по документу
			Движение(ДокОбъект.Движения, ДатаПроведения, Стр.Основание.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, ?(Сторно, -Стр.Сумма, Стр.Сумма), Приход); 
			// Оплачиваем его
			Движение(ДокОбъект.Движения, ДатаПроведения, Стр.Основание.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, ?(Сторно, -Стр.Сумма, Стр.Сумма), Не Приход);	
		Иначе
			// Накладная несет долг и в обычном регистре, поэтому оплата, выписанная прямо на нее,
			// тоже должна его гасить. До переезда расчетов долг накладной жил только в налоговом
			// регистре, и такие оплаты сюда не писались.
			Если ЭтоОплата Тогда
				// Сумма строки - в валюте платежа: долг закрывается по курсу объекта, разница - курсовая.
				Оплата = РаботаСВалютами.СтрокаОплатыВРасчеты(ДокОбъект, Стр.Сумма, Стр.Основание, "ВзаиморасчётыСПокупателями", Сторно);
				Движение(ДокОбъект.Движения, ДатаПроведения, Стр.Основание.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор,
					Стр.Основание, Оплата.Сумма, Приход,
					Оплата.СуммаВВалюте);
			Иначе
				СуммаВВалюте = Неопределено;
				Если ЕстьСуммаВВалюте Тогда
					СуммаВВалюте = ?(Сторно, -Стр.СуммаВВалюте, Стр.СуммаВВалюте);
				КонецЕсли;
				// Возврат на накладную - с аналитиками приёма долга (см. ОбъектыРасчетовОснования).
				Аналитики = АналитикиСтрокиРасчетов(Стр, ЕстьАналитики, Стр.Основание.Организация, ДокОбъект);
				Движение(ДокОбъект.Движения, ДатаПроведения, Аналитики.Организация, Аналитики.Контрагент, Аналитики.Договор,
					Стр.Основание, ?(Сторно, -Стр.Сумма, Стр.Сумма), Приход, СуммаВВалюте);
			КонецЕсли;
		КонецЕсли;
		СуммаОстаток = СуммаОстаток - Стр.Сумма;
	КонецЦикла;
	СуммаАванса = Неопределено;
	Если ЭтоОплата Тогда
		// Аванс - в основной валюте разностью сумм (копейки округления строк остаются в нём), в валюте - как есть.
		СуммаАванса = ?(Сторно, -СуммаОстаток, СуммаОстаток) + АвансСверхДолга;
		СуммаОстаток = РаботаСВалютами.АвансПлатежаВОсновнойВалюте(ДокОбъект) + АвансСверхДолга;
	КонецЕсли;
	Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор,
		ДокОбъект.Ссылка, ?(Сторно, -СуммаОстаток, СуммаОстаток), Приход,
		СуммаАванса);
КонецПроцедуры

// Строка поступления от покупателя на налоговую накладную в основной валюте разносится по долгу реализаций накладной
// (Ф3.1 docs/plans/commerce-two-orgs.md); строка в валюте или по валютной накладной идёт прежним путём.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёж.
//  Основание - ДокументСсылка - основание строки.
//  Сторно    - Булево - возврат денег покупателю.
//  ПоДолгуНакладной - Булево - строка платёжного документа (не зачёт аванса).
//
// Возвращаемое значение:
//  Булево
//
Функция ОплатаНакладнойПоДолгуРеализаций(ДокОбъект, Основание, Сторно, ПоДолгуНакладной)
	ЭтоНакладная = ТипЗнч(Основание) = Тип("ДокументСсылка.НалоговаяНакладная") И ЗначениеЗаполнено(Основание);
	Если Не ПоДолгуНакладной Или Сторно Или Не ЭтоНакладная Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).ВВалюте
		И Не РаботаСВалютами.ВалютаИКурсОбъекта(Основание).ВВалюте;
КонецФункции

// Движения строки оплаты накладной по долгу её объектов (см. РазнестиПоДолгуНакладной).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёж.
//  Стр       - СтрокаТабличнойЧасти - строка ТЧОснования.
//  Приход    - Булево - вид движения записей.
//  ДатаПроведения - Дата - период записей.
//
// Возвращаемое значение:
//  Число - сумма сверх долга (аванс платежа).
//
Функция ОплатитьДолгНакладной(ДокОбъект, Стр, Приход, ДатаПроведения)
	// Текущие остатки, а не на момент платежа (ревью 2.0.17.24, круг 3): платёж раньше даты накладной иначе не видит
	// принятого ею долга и гасит реализацию, а перепроведённая накладная прямой платёж не переносит. Предел строки -
	// налоговый долг накладной, он тоже без учёта времени (НалоговыеРасчетыПроверки.ПроверитьПлатеж).
	Разнесение = РазнестиПоДолгуНакладной(ДокОбъект, Стр.Основание, Стр.Сумма);
	Для Каждого Часть Из Разнесение.Строки Цикл
		// BSLLS:YoLetterUsage-off
		Движение(ДокОбъект.Движения, ДатаПроведения, Часть.Организация, Часть.Контрагент, Часть.Договор,
			Часть.ОбъектРасчётов, Часть.Сумма, Приход, , Часть.Валюта);
		// BSLLS:YoLetterUsage-on
	КонецЦикла;
	Возврат Разнесение.Остаток;
КонецФункции

// BSLLS:YoLetterUsage-off
// Разносит сумму по долгу налоговой накладной в обычном регистре (Ф3.1 docs/plans/commerce-two-orgs.md): сначала
// объект «накладная» - долг, принятый накладной; затем реализации из её строк по дате реализации - их собственный
// остаток (непокрытая часть, у исторической накладной - весь долг). Каждый объект - не больше его положительного
// остатка, под теми организацией, контрагентом и договором, под которыми долг лежит. Только основная валюта.
//
// Остатки всех накладных документа читаются в одну рабочую таблицу (ДополнительныеСвойства.ОстаткиДолгаНакладных):
// две строки по накладным с общей реализацией не прочитают один остаток дважды; после каждой строки доступный остаток
// уменьшается. Таблицу сбрасывает НачатьРазнесениеПоДолгуНакладных в начале формирования движений документа.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёж или документ удержания НДС.
//  Накладная - ДокументСсылка.НалоговаяНакладная - накладная строки.
//  Сумма     - Число - сумма строки в основной валюте.
//  Граница   - Граница, Неопределено - остатки на момент до документа; Неопределено - текущие.
//
// Возвращаемое значение:
//  Структура - Строки (ТаблицаЗначений: ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Сумма) и Остаток
//              (Число - сумма сверх долга). Валюта - измерение гасимого остатка (см. ДолгНакладнойВКаноническомВиде).
//
Функция РазнестиПоДолгуНакладной(ДокОбъект, Накладная, Сумма, Граница = Неопределено) Экспорт
	Объекты = ОбъектыДолгаНакладной(ДокОбъект, Накладная, Граница);
	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("ОбъектРасчётов");
	Строки.Колонки.Добавить("Организация");
	Строки.Колонки.Добавить("Контрагент");
	Строки.Колонки.Добавить("Договор");
	Строки.Колонки.Добавить("Валюта");
	Строки.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	Остаток = Сумма;
	Для Каждого Объект Из Объекты Цикл
		Если Остаток <= 0 Тогда
			Прервать;
		КонецЕсли;
		Часть = Мин(Остаток, Объект.Остаток);
		Если Часть <= 0 Тогда
			Продолжить;
		КонецЕсли;
		НС = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Объект);
		НС.Сумма = Часть;
		Объект.Остаток = Объект.Остаток - Часть;
		Остаток = Остаток - Часть;
	КонецЦикла;
	Возврат Новый Структура("Строки, Остаток", Строки, Остаток);
КонецФункции

// Сбрасывает рабочую таблицу остатков разнесения (см. РазнестиПоДолгуНакладной): объект документа живёт между
// записями, и прежние остатки не должны дойти до нового проведения.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёж или документ удержания НДС.
//
Процедура НачатьРазнесениеПоДолгуНакладных(ДокОбъект) Экспорт
	ДокОбъект.ДополнительныеСвойства.Вставить(ИмяСвойстваОстатковДолга(), Новый Соответствие);
КонецПроцедуры

// Уменьшает доступный остаток объекта рабочей таблицы разнесения (документ удержания: его прежнее распределение уже
// занимает часть долга).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//  Накладная - ДокументСсылка.НалоговаяНакладная - накладная.
//  Строки    - ТаблицаЗначений - ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Сумма.
//  Граница   - Граница, Неопределено - см. РазнестиПоДолгуНакладной.
//
Процедура ЗанятьДолгНакладной(ДокОбъект, Накладная, Строки, Граница = Неопределено) Экспорт
	Объекты = ОбъектыДолгаНакладной(ДокОбъект, Накладная, Граница);
	Для Каждого Строка Из Строки Цикл
		Ключ = КлючОбъектаДолга(Строка);
		Для Каждого Объект Из Объекты Цикл
			Если КлючОбъектаДолга(Объект) = Ключ Тогда
				Объект.Остаток = Объект.Остаток - Строка.Сумма;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Объекты долга накладной в порядке разнесения - строки рабочей таблицы документа (общие объекты разных накладных -
// одни и те же структуры).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//  Накладная - ДокументСсылка.НалоговаяНакладная - накладная.
//  Граница   - Граница, Неопределено - см. РазнестиПоДолгуНакладной.
//
// Возвращаемое значение:
//  Массив из Структура - ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Остаток.
//
Функция ОбъектыДолгаНакладной(ДокОбъект, Накладная, Граница)
	Возврат ОбъектыДолгаНакладнойРегистра(ДокОбъект, Накладная, Граница, Ложь);
КонецФункции

// Объекты долга накладной в порядке разнесения для регистра покупателей или поставщиков (см. ОбъектыДолгаНакладной).
// Остатки читаются одним запросом сразу по всем накладным строк документа (ревью 2.0.17.24, круг 6) и кладутся в
// рабочую таблицу документа; общие объекты разных накладных - одни и те же структуры.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//  Накладная - ДокументСсылка.НалоговаяНакладная, ДокументСсылка.НалоговаяНакладнаяПокупка - накладная.
//  Граница   - Граница, Неопределено - см. РазнестиПоДолгуНакладной.
//  Покупка   - Булево - регистр поставщиков: доступный долг - модуль отрицательного остатка.
//
// Возвращаемое значение:
//  Массив из Структура - ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Остаток.
//
Функция ОбъектыДолгаНакладнойРегистра(ДокОбъект, Накладная, Граница, Покупка) Экспорт
	ИмяСвойства = ?(Покупка, "ОстаткиДолгаНакладныхПокупки", ИмяСвойстваОстатковДолга());
	Если Не ДокОбъект.ДополнительныеСвойства.Свойство(ИмяСвойства) Тогда
		ДокОбъект.ДополнительныеСвойства.Вставить(ИмяСвойства, Новый Соответствие);
	КонецЕсли;
	Таблица = ДокОбъект.ДополнительныеСвойства[ИмяСвойства];
	Если Таблица.Получить(Накладная) = Неопределено Тогда
		ЗагрузитьОбъектыДолгаНакладных(ДокОбъект, НакладныеДокумента(ДокОбъект, Накладная, Таблица), Граница, Покупка,
			Таблица);
	КонецЕсли;
	Возврат Таблица.Получить(Накладная);
КонецФункции

Функция НакладныеДокумента(ДокОбъект, Накладная, Таблица)
	Накладные = Новый Массив;
	Накладные.Добавить(Накладная);
	ТипНакладной = ТипЗнч(Накладная);
	Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект, "ТЧОснования") Тогда
		Для Каждого Стр Из ДокОбъект.ТЧОснования Цикл
			Основание = Стр.Основание;
			Если ТипЗнч(Основание) <> ТипНакладной Или Не ЗначениеЗаполнено(Основание) Тогда
				Продолжить;
			КонецЕсли;
			Если Таблица.Получить(Основание) = Неопределено И Накладные.Найти(Основание) = Неопределено Тогда
				Накладные.Добавить(Основание);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Накладные;
КонецФункции

Функция ОстаткиОбъектовНакладной(ВсеОстатки, Объекты, Накладная)
	Остатки = ВсеОстатки.СкопироватьКолонки();
	Для Каждого СтрокаОстатка Из ВсеОстатки Цикл
		Если Объекты.Найти(СтрокаОстатка.ОбъектРасчётов) <> Неопределено Тогда
			НоваяСтрока = Остатки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатка);
			НоваяСтрока.Очередь = ?(СтрокаОстатка.ОбъектРасчётов = Накладная, 0, 1);
		КонецЕсли;
	КонецЦикла;
	Остатки.Сортировать("Очередь, ДатаОбъекта");
	Возврат Остатки;
КонецФункции

Функция СтруктурыОбъектовДолга(Остатки, Прочитанные)
	Результат = Новый Массив;
	Для Каждого Выборка Из Остатки Цикл
		Если Выборка.Остаток <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Объект = Новый Структура("ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Остаток");
		ЗаполнитьЗначенияСвойств(Объект, Выборка);
		Ключ = КлючОбъектаДолга(Объект);
		Прежний = Прочитанные.Получить(Ключ);
		Если Прежний = Неопределено Тогда
			Прочитанные.Вставить(Ключ, Объект);
			Прежний = Объект;
		КонецЕсли;
		Результат.Добавить(Прежний);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗагрузитьОбъектыДолгаНакладных(ДокОбъект, Накладные, Граница, Покупка, Таблица)
	// BSLLS:SetPrivilegedMode-off - остатки чужих оснований накладных читаются при проведении платежа
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Основания.Ссылка КАК Накладная,
	                      |	Основания.ОтгрузкаТовара КАК Объект
	                      |ПОМЕСТИТЬ ВТОбъекты
	                      |ИЗ
	                      |	Документ.НалоговаяНакладная.ТЧТовары КАК Основания
	                      |ГДЕ
	                      |	Основания.Ссылка В (&Накладные)
	                      |	И Основания.ОтгрузкаТовара <> ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Основания.Ссылка,
	                      |	Основания.ОтгрузкаТовара
	                      |ИЗ
	                      |	Документ.НалоговаяНакладная.ТЧУслуги КАК Основания
	                      |ГДЕ
	                      |	Основания.Ссылка В (&Накладные)
	                      |	И Основания.ОтгрузкаТовара <> ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Н.Ссылка,
	                      |	Н.Ссылка
	                      |ИЗ
	                      |	Документ.НалоговаяНакладная КАК Н
	                      |ГДЕ
	                      |	Н.Ссылка В (&Накладные)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Ост.ОбъектРасчётов КАК ОбъектРасчётов,
	                      |	Ост.Организация КАК Организация,
	                      |	Ост.Контрагент КАК Контрагент,
	                      |	Ост.Договор КАК Договор,
	                      |	Ост.Валюта КАК Валюта,
	                      |	СУММА(Ост.СуммаОстаток) КАК Остаток,
	                      |	ЕСТЬNULL(ВЫРАЗИТЬ(Ост.ОбъектРасчётов КАК Документ.РеализацияТоваровУслуг).Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОбъекта
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(
	                      |			&Граница,
	                      |			ОбъектРасчётов В
	                      |					(ВЫБРАТЬ
	                      |						ВТОбъекты.Объект КАК Объект
	                      |					ИЗ
	                      |						ВТОбъекты КАК ВТОбъекты)
	                      |				И Валюта В (&ВалютыОсновные)) КАК Ост
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Ост.ОбъектРасчётов,
	                      |	Ост.Организация,
	                      |	Ост.Контрагент,
	                      |	Ост.Договор,
	                      |	Ост.Валюта,
	                      |	ВЫРАЗИТЬ(Ост.ОбъектРасчётов КАК Документ.РеализацияТоваровУслуг).Дата
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДатаОбъекта,
	                      |	Ост.ОбъектРасчётов
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТОбъекты.Накладная КАК Накладная,
	                      |	ВТОбъекты.Объект КАК Объект
	                      |ИЗ
	                      |	ВТОбъекты КАК ВТОбъекты");
	Каноническая = Справочники.Валюты.ПустаяСсылка();
	Если Покупка Тогда
		Текст = СтрЗаменить(Запрос.Текст, "Документ.НалоговаяНакладная", "Документ.НалоговаяНакладнаяПокупка");
		Текст = СтрЗаменить(Текст, "ОтгрузкаТовара", "ПоступлениеТовара");
		Текст = СтрЗаменить(Текст, "РеализацияТоваровУслуг", "ПоступлениеТоваровУслуг");
		Запрос.Текст = СтрЗаменить(Текст, "ВзаиморасчётыСПокупателями", "ВзаиморасчётыСПоставщиками");
		Каноническая = РаботаСВалютами.ОсновнаяВалюта();
	КонецЕсли;
	Запрос.УстановитьПараметр("Накладные", Накладные);
	// Основная валюта в измерении - пустая ссылка (покупатели) или сама валюта (поставщики).
	ВалютыОсновные = Новый Массив;
	ВалютыОсновные.Добавить(Справочники.Валюты.ПустаяСсылка());
	ВалютыОсновные.Добавить(РаботаСВалютами.ОсновнаяВалюта());
	Запрос.УстановитьПараметр("ВалютыОсновные", ВалютыОсновные);
	Если Граница = Неопределено Тогда
		// Текущие остатки - без периода виртуальной таблицы.
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Граница,", ",");
	Иначе
		Запрос.УстановитьПараметр("Граница", Граница);
	КонецЕсли;
	Пакет = Запрос.ВыполнитьПакет();
	ВсеОстатки = Пакет[1].Выгрузить();
	ВсеОстатки.Колонки.Добавить("Очередь", Новый ОписаниеТипов("Число"));
	Знак = ?(Покупка, -1, 1);
	Для Каждого СтрокаОстатка Из ВсеОстатки Цикл
		СтрокаОстатка.Остаток = Знак * СтрокаОстатка.Остаток;
	КонецЦикла;
	Связи = Пакет[2].Выгрузить();
	// Общие объекты уже прочитанных накладных - те же структуры: остаток у них общий.
	Прочитанные = Новый Соответствие;
	Для Каждого КлючИЗначение Из Таблица Цикл
		Для Каждого Объект Из КлючИЗначение.Значение Цикл
			Прочитанные.Вставить(КлючОбъектаДолга(Объект), Объект);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Накладная Из Накладные Цикл
		Объекты = Связи.Скопировать(Новый Структура("Накладная", Накладная)).ВыгрузитьКолонку("Объект");
		Остатки = ОстаткиОбъектовНакладной(ВсеОстатки, Объекты, Накладная);
		ДолгНакладнойВКаноническомВиде(Остатки, Накладная, Каноническая);
		ПрименитьПоправкиПереноса(ДокОбъект, Накладная, Остатки, Покупка);
		Таблица.Вставить(Накладная, СтруктурыОбъектовДолга(Остатки, Прочитанные));
	КонецЦикла;
КонецПроцедуры

Функция КлючОбъектаДолга(Объект)
	Части = Новый Массив;
	Части.Добавить(Строка(Объект.ОбъектРасчётов.УникальныйИдентификатор()));
	Части.Добавить(Строка(Объект.Организация.УникальныйИдентификатор()));
	Части.Добавить(Строка(Объект.Контрагент.УникальныйИдентификатор()));
	Части.Добавить(Строка(Объект.Договор.УникальныйИдентификатор()));
	Части.Добавить(Строка(Объект.Валюта.УникальныйИдентификатор()));
	Возврат СтрСоединить(Части, "/");
КонецФункции

Функция ИмяСвойстваОстатковДолга()
	Возврат "ОстаткиДолгаНакладных";
КонецФункции

// Запоминает перед перепроведением платежа, какую часть его прежних записей по основаниям перенесли на себя налоговые
// накладные (ОплатыВалютныхОтгрузок, ОплатыПоПоступлениям): платформа удалит записи платежа, а записи переноса
// накладных останутся до их перепроведения подпиской. Разнесение строки оплаты накладной читает остатки без этого
// переноса (ПрименитьПоправкиПереноса) - иначе платёж, сменивший основание с реализации на её накладную, увидел бы
// долг накладной уже погашенным самим собой.
//
// Параметры:
//  Платеж      - ДокументОбъект - платёжный документ.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//
Процедура ЗапомнитьПереносПлатежаНакладными(Платеж, РежимЗаписи) Экспорт
	Поправки = Новый Структура("Покупатели, Поставщики");
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Поправки.Покупатели = ПоправкиПереносаПлатежа(Платеж, Ложь);
		Поправки.Поставщики = ПоправкиПереносаПлатежа(Платеж, Истина);
	КонецЕсли;
	Платеж.ДополнительныеСвойства.Вставить(ИмяСвойстваПоправокПереноса(), Поправки);
КонецПроцедуры

// Исключает из остатков объектов долга накладной перенос прежних записей самого документа (см.
// ЗапомнитьПереносПлатежаНакладными): объекты, остаток которых без переноса появился, добавляются в очередь.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ, который разносит оплату.
//  Накладная - ДокументСсылка.НалоговаяНакладная, ДокументСсылка.НалоговаяНакладнаяПокупка - накладная строки.
//  Остатки   - ТаблицаЗначений - ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Остаток, Очередь, ДатаОбъекта;
//              добавленные объекты встают в очередь разнесения.
//  Покупка   - Булево - расчёты с поставщиками: доступный долг - модуль отрицательного остатка.
//
Процедура ПрименитьПоправкиПереноса(ДокОбъект, Накладная, Остатки, Покупка) Экспорт
	Поправки = Неопределено;
	Если ДокОбъект.ДополнительныеСвойства.Свойство(ИмяСвойстваПоправокПереноса(), Поправки) Тогда
		Поправки = ?(Покупка, Поправки.Поставщики, Поправки.Покупатели);
	КонецЕсли;
	Если ТипЗнч(Поправки) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	Добавлены = Ложь;
	Измерения = "ОбъектРасчётов, Организация, Контрагент, Договор, Валюта";
	Для Каждого Поправка Из Поправки.НайтиСтроки(Новый Структура("Накладная", Накладная)) Цикл
		Отбор = Новый Структура(Измерения);
		ЗаполнитьЗначенияСвойств(Отбор, Поправка);
		Найденные = Остатки.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			СтрокаОстатка = Остатки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОстатка, Поправка, Измерения);
			СтрокаОстатка.Очередь = ?(Поправка.ОбъектРасчётов = Накладная, 0, 1);
			СтрокаОстатка.ДатаОбъекта = Поправка.ДатаОбъекта;
			// Колонка суммы из запроса допускает NULL: у новой строки остаток задаётся явно.
			СтрокаОстатка.Остаток = 0;
			Добавлены = Истина;
		Иначе
			СтрокаОстатка = Найденные[0];
		КонецЕсли;
		СтрокаОстатка.Остаток = СтрокаОстатка.Остаток + ?(Покупка, -Поправка.Сумма, Поправка.Сумма);
	КонецЦикла;
	Если Добавлены Тогда
		Остатки.Сортировать("Очередь, ДатаОбъекта");
	КонецЕсли;
КонецПроцедуры

// Поправки остатков обычного регистра (в его знаке) на перенос прежних записей платежа налоговыми накладными: запись
// платежа по основанию, которое покрывает проведённая накладная, переносящая расчёты, накладная сторнировала на
// основании и завела на себя в доле покрытия - если платёж не платил её напрямую. Поправка возвращает основанию
// сторнированное и снимает принятое накладной. Только основная валюта.
//
// Параметры:
//  Платеж  - ДокументОбъект - платёжный документ.
//  Покупка - Булево - расчёты с поставщиками (поступления, накладные покупки); Ложь - с покупателями.
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - Накладная, ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Сумма,
//                                  ДатаОбъекта; Неопределено - поправок нет.
//
Функция ПоправкиПереносаПлатежа(Платеж, Покупка)
	Если Платеж.ЭтоНовый() Или Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Платеж.Ссылка, "Проведен") Тогда
		Возврат Неопределено;
	КонецЕсли;
	// BSLLS:SetPrivilegedMode-off - записи переноса чужих накладных читаются при проведении платежа
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Т.Период КАК Период,
	                      |	Т.ВидДвижения КАК ВидДвижения,
	                      |	Т.ОбъектРасчётов КАК Основание,
	                      |	Т.Валюта КАК Валюта,
	                      |	Т.Сумма КАК Сумма
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
	                      |ГДЕ
	                      |	Т.Регистратор = &Ссылка
	                      |	И Т.ОбъектРасчётов ССЫЛКА Документ.РеализацияТоваровУслуг
	                      |	И Т.Валюта В (&ВалютыОсновные)");
	ИмяРеквизита = "ОтгрузкаТовара";
	ТипОснования = "РеализацияТоваровУслуг";
	Каноническая = Справочники.Валюты.ПустаяСсылка();
	Если Покупка Тогда
		Запрос.Текст = СтрЗаменить(СтрЗаменить(Запрос.Текст, "ВзаиморасчётыСПокупателями", "ВзаиморасчётыСПоставщиками"),
			ТипОснования, "ПоступлениеТоваровУслуг");
		ИмяРеквизита = "ПоступлениеТовара";
		ТипОснования = "ПоступлениеТоваровУслуг";
		Каноническая = РаботаСВалютами.ОсновнаяВалюта();
	КонецЕсли;
	ВалютыОсновные = Новый Массив;
	ВалютыОсновные.Добавить(Справочники.Валюты.ПустаяСсылка());
	ВалютыОсновные.Добавить(РаботаСВалютами.ОсновнаяВалюта());
	Запрос.УстановитьПараметр("ВалютыОсновные", ВалютыОсновные);
	Запрос.УстановитьПараметр("Ссылка", Платеж.Ссылка);
	Записи = Запрос.Выполнить().Выгрузить();
	Если Записи.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяОснования = "Основание";
	Основания = Записи.Скопировать(, ИмяОснования);
	Основания.Свернуть(ИмяОснования);
	Накладные = РаботаСДокументами.НакладныеПереносящиеРасчеты(
		РаботаСДокументами.НалоговыеНакладныеПоОснованиям(Основания.ВыгрузитьКолонку(ИмяОснования)));
	// Прямую оплату накладная не переносит (ПереносимыеОплаты) - признак по прежним движениям кассы платежа, а не по
	// табличной части: её могли записать без проведения (ревью 2.0.17.24, круг 5).
	ПрямыеОплаты = НакладныеПрежнихДвиженийКассы(Платеж.Ссылка);
	Результат = НоваяТаблицаПоправокПереноса();
	ПараметрыПоправок = Новый Структура("ИмяРеквизита, Каноническая, Реквизиты", ИмяРеквизита, Каноническая,
		РеквизитыОснований(ТипОснования, Основания.ВыгрузитьКолонку(ИмяОснования)));
	Для Каждого Накладная Из Накладные Цикл
		Если ПрямыеОплаты.Найти(Накладная) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПоправкиПереносаНакладной(Результат, Накладная.ПолучитьОбъект(), Записи, ПараметрыПоправок);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Поправки по одной накладной (см. ПоправкиПереносаПлатежа).
//
// Параметры:
//  Поправки        - ТаблицаЗначений - дополняется (см. НоваяТаблицаПоправокПереноса).
//  НакладнаяОбъект - ДокументОбъект.НалоговаяНакладная, ДокументОбъект.НалоговаяНакладнаяПокупка - накладная.
//  Записи          - ТаблицаЗначений - прежние записи платежа: Период, ВидДвижения, Основание, Валюта, Сумма.
//  Параметры       - Структура - ИмяРеквизита (колонка основания), Каноническая (валюта приёма на накладную),
//                    Реквизиты (Соответствие: основание -> Дата, Организация, Контрагент, Договор, Сумма).
//
Процедура ПоправкиПереносаНакладной(Поправки, НакладнаяОбъект, Записи, Параметры)
	Накладная = НакладнаяОбъект.Ссылка;
	Покрытия = РаботаСДокументами.ОснованияНалоговойНакладной(НакладнаяОбъект, Параметры.ИмяРеквизита);
	Для Каждого Запись Из Записи Цикл
		Покрытие = Покрытия.Найти(Запись.Основание, "Основание");
		Если Покрытие = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Реквизиты = Параметры.Реквизиты.Получить(Запись.Основание);
		Если Реквизиты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Доля = РаботаСДокументами.СуммаВДолеПокрытия(Запись.Сумма, Покрытие.Сумма, Реквизиты.Сумма);
		Влияние = ?(Запись.ВидДвижения = ВидДвиженияНакопления.Приход, Доля, -Доля);
		// Сторно переноса - в валюте записи платежа, приём на накладную - в каноническом виде (ОплатыВалютныхОтгрузок).
		Реквизиты.Вставить("Валюта", Запись.Валюта);
		ДобавитьПоправкуПереноса(Поправки, Накладная, Запись.Основание, Реквизиты, Реквизиты.Контрагент, Влияние);
		Реквизиты.Вставить("Валюта", Параметры.Каноническая);
		ДобавитьПоправкуПереноса(Поправки, Накладная, Накладная, Реквизиты, НакладнаяОбъект.Контрагент, -Влияние);
	КонецЦикла;
КонецПроцедуры

Функция НоваяТаблицаПоправокПереноса()
	Результат = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Накладная,ОбъектРасчётов,Организация,Контрагент,Договор,Валюта,ДатаОбъекта", ",") Цикл
		Результат.Колонки.Добавить(Имя);
	КонецЦикла;
	Результат.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	Возврат Результат;
КонецФункции

Процедура ДобавитьПоправкуПереноса(Поправки, Накладная, Объект, Реквизиты, Контрагент, Сумма)
	Поправка = Поправки.Добавить();
	Поправка.Накладная = Накладная;
	Поправка.ОбъектРасчётов = Объект;
	Поправка.Организация = Реквизиты.Организация;
	Поправка.Контрагент = Контрагент;
	Поправка.Договор = Реквизиты.Договор;
	Поправка.Валюта = Реквизиты.Валюта;
	Поправка.ДатаОбъекта = ?(Объект = Накладная, Дата(1, 1, 1), Реквизиты.Дата);
	Поправка.Сумма = Сумма;
КонецПроцедуры

Функция ИмяСвойстваПоправокПереноса()
	Возврат "ПоправкиПереносаНакладными";
КонецФункции

// Приводит к каноническому виду валюты остатки объекта «накладная» (не исторической): перепроведение накладной
// переписывает её долг в каноническом виде, и разнесение ложится туда же. Объекты-основания и историческая накладная
// гасятся в тех значениях измерения Валюта, под которыми лежит остаток (ревью 2.0.17.24, круг 5).
//
// Параметры:
//  Остатки     - ТаблицаЗначений - ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Остаток, Очередь,
//                ДатаОбъекта.
//  Накладная   - ДокументСсылка.НалоговаяНакладная, ДокументСсылка.НалоговаяНакладнаяПокупка - накладная.
//  Каноническая - СправочникСсылка.Валюты - валюта измерения записей накладной.
//
Процедура ДолгНакладнойВКаноническомВиде(Остатки, Накладная, Каноническая) Экспорт
	Если ПеренесенныеДокументы.Защищен(Накладная) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из Остатки.НайтиСтроки(Новый Структура("ОбъектРасчётов", Накладная)) Цикл
		Строка.Валюта = Каноническая;
	КонецЦикла;
	Остатки.Свернуть("ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Очередь, ДатаОбъекта", "Остаток");
	Остатки.Сортировать("Очередь, ДатаОбъекта");
КонецПроцедуры

// Валюта измерения собственного долга оснований в основной валюте: записи основания на себя (пустая или основная).
//
// Параметры:
//  ИмяРегистра - Строка - ВзаиморасчётыСПокупателями или ВзаиморасчётыСПоставщиками.
//  Основания   - Массив из ДокументСсылка - реализации или поступления.
//
// Возвращаемое значение:
//  Соответствие - основание -> СправочникСсылка.Валюты.
//
Функция ВалютыСобственногоДолга(ИмяРегистра, Основания) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Т.Регистратор КАК Основание,
	                      |	Т.Валюта КАК Валюта
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями КАК Т
	                      |ГДЕ
	                      |	Т.Регистратор В (&Основания)
	                      |	И Т.ОбъектРасчётов = Т.Регистратор
	                      |	И Т.Валюта В (&ВалютыОсновные)");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВзаиморасчётыСПокупателями", ИмяРегистра);
	ВалютыОсновные = Новый Массив;
	ВалютыОсновные.Добавить(Справочники.Валюты.ПустаяСсылка());
	ВалютыОсновные.Добавить(РаботаСВалютами.ОсновнаяВалюта());
	Запрос.УстановитьПараметр("ВалютыОсновные", ВалютыОсновные);
	Запрос.УстановитьПараметр("Основания", Основания);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Основание, Выборка.Валюта);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НакладныеПрежнихДвиженийКассы(Платеж)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Т.ДокументПродажи КАК Накладная
	                      |ИЗ
	                      |	РегистрНакопления.ДвиженияПоКассе КАК Т
	                      |ГДЕ
	                      |	Т.Регистратор = &Платеж");
	Запрос.УстановитьПараметр("Платеж", Платеж);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Накладная");
КонецФункции

Функция РеквизитыОснований(ТипОснования, Основания)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Д.Ссылка КАК Ссылка,
	                      |	Д.Дата КАК Дата,
	                      |	Д.Организация КАК Организация,
	                      |	Д.Контрагент КАК Контрагент,
	                      |	Д.Договор КАК Договор,
	                      |	Д.Сумма КАК Сумма
	                      |ИЗ
	                      |	Документ.РеализацияТоваровУслуг КАК Д
	                      |ГДЕ
	                      |	Д.Ссылка В (&Основания)");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", ТипОснования);
	Запрос.УстановитьПараметр("Основания", Основания);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Реквизиты = Новый Структура("Дата, Организация, Контрагент, Договор, Сумма");
		ЗаполнитьЗначенияСвойств(Реквизиты, Выборка);
		Результат.Вставить(Выборка.Ссылка, Реквизиты);
	КонецЦикла;
	Возврат Результат;
КонецФункции
// BSLLS:YoLetterUsage-on

// Аналитики записи по строке таблицы оснований: заданные в строке (см. СтрокиПоОбъектамРасчетов) или прежние -
// организация по умолчанию, контрагент и договор документа.
//
// Параметры:
//  Стр - СтрокаТаблицыЗначений, СтрокаТабличнойЧасти - строка оснований.
//  ЕстьАналитики - Булево - в таблице есть колонки Организация, Контрагент, Договор.
//  Организация - СправочникСсылка.Организации - организация по умолчанию.
//  ДокОбъект - ДокументОбъект - документ движения.
//
// Возвращаемое значение:
//  Структура - Организация, Контрагент, Договор.
//
Функция АналитикиСтрокиРасчетов(Стр, ЕстьАналитики, Организация, ДокОбъект)
	Результат = Новый Структура("Организация, Контрагент, Договор", Организация, ДокОбъект.Контрагент, ДокОбъект.Договор);
	Если ЕстьАналитики И Стр.Контрагент <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, Стр, "Организация, Контрагент, Договор");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Запись регистра. Сумма - в основной валюте; валюта записи и сумма в ней - по объекту расчётов
// (см. РаботаСВалютами.ВалютаИКурсОбъекта): оплата, корректировка, зачёт аванса по валютной реализации
// попадают в её валюту, и остаток не дробится. Основная валюта в измерении - пустая ссылка, как
// в записях до валютного учёта: иначе старая реализация и её новая оплата разошлись бы по измерению.
//
// Параметры:
//  Движения - КоллекцияДвижений - движения документа.
//  ДатаДвижения - Дата - период записи.
//  Организация - СправочникСсылка.Организации - измерение записи.
//  Контрагент - СправочникСсылка.Контрагенты - измерение записи.
//  Договор - СправочникСсылка.ДоговорыСКонтрагентами - измерение записи.
//  Объект - ДокументСсылка - объект расчётов (измерение записи), по нему определяется валюта.
//  Сумма - Число - сумма в основной валюте.
//  Приход - Булево - вид движения.
//  СуммаВВалюте - Число, Неопределено - точная сумма в валюте объекта (строка оплаты, аванс платежа в валюте);
//                 Неопределено - пересчёт суммы по курсу объекта.
//  ВалютаЗаписи - СправочникСсылка.Валюты, Неопределено - валюта измерения записи по объекту в основной валюте (пустая
//                 или основная - та, под которой лежит гасимый или сторнируемый остаток); Неопределено - канонический
//                 вид, пустая.
//
Процедура Движение(Движения, ДатаДвижения, Организация, Контрагент, Договор, Объект, Сумма, Приход = Истина,
	СуммаВВалюте = Неопределено, ВалютаЗаписи = Неопределено)
	Если Сумма = 0 Тогда Возврат КонецЕсли;
	ВалютаОбъекта = РаботаСВалютами.ВалютаОбъектаРасчетов(Объект);
	НС = Движения.ВзаиморасчётыСПокупателями.Добавить();
	НС.ВидДвижения = ?(Приход, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
	НС.Период = ДатаДвижения;
	НС.Организация = Организация;
	НС.Контрагент = Контрагент;
	НС.Договор = Договор;
	НС.ОбъектРасчётов = Объект;
	НС.Сумма = Сумма;
	// Сумма в валюте ведётся только по валютным объектам, как в записях до валютного учёта.
	Если ВалютаОбъекта.ВВалюте Тогда
		НС.Валюта = ВалютаОбъекта.Валюта;
		НС.СуммаВВалюте = ?(СуммаВВалюте = Неопределено,
			РаботаСВалютамиКлиентСервер.СуммаВВалюте(Сумма, ВалютаОбъекта.Курс), СуммаВВалюте);
	Иначе
		НС.Валюта = ?(ЗначениеЗаполнено(ВалютаЗаписи), ВалютаЗаписи, Справочники.Валюты.ПустаяСсылка());
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Остатки

// Возвращает непогашенный долг покупателей по реализациям с учётом суммы кредита по договору.
//
// Параметры:
//  Период - Дата, МоментВремени, Граница - дата, на которую считаются остатки; граница или момент
//           времени документа используются как есть (момент времени - как граница Исключая).
//  Отбор - Структура - необязательные массивы в свойствах Организации, Контрагенты, Договоры, Менеджеры;
//          необязательное свойство ТолькоПросроченные (Булево) - только долги с истёкшим сроком оплаты; срок и
//          способ отсрочки - как у кредитного контроля (ПолучитьПросроченнуюЗадолженность): договор, карточка
//          контрагента, иначе 365 дней.
//  ПоПозицииДокумента - Булево - для Период типа Дата: Истина - остатки на момент до документа с этой
//                       датой (граница Исключая), Ложь - остатки на конец дня Период.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ГруппировкаВсего, Организация, Контрагент, Договор, РеализацияТоваровУслуг,
//                    Менеджер, Долг, ДатаОтгрузки, КоличествоВыходных, ПросроченоДней (отрицательное - срок не наступил).
//
Функция ПолучитьЗадолженностьКлиентовПоКлассификации(Период, Отбор, ПоПозицииДокумента = Ложь) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	// Заполним реквизиты
	Организации = ?(Отбор.Свойство("Организации"), Отбор.Организации, Новый Массив);
	Контрагенты = ?(Отбор.Свойство("Контрагенты"), Отбор.Контрагенты, Новый Массив);	
	Договоры = ?(Отбор.Свойство("Договоры"), Отбор.Договоры, Новый Массив);
	Менеджеры = ?(Отбор.Свойство("Менеджеры"), Отбор.Менеджеры, Новый Массив);
	ТолькоПросроченные = Отбор.Свойство("ТолькоПросроченные") И Отбор.ТолькоПросроченные;
	// Получим данные из базы
	// Дата долга налогового документа на основаниях - по раннему основанию (docs/plans/accounting-morocco-f1-s2.md):
	// соединение с датами оснований к виртуальной таблице остатков.
	// BSLLS:JoinWithVirtualTable-off
	// BSLLS:JoinWithSubQuery-off
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВсК.Организация КАК Организация,
	                      |	ВсК.Контрагент КАК Контрагент,
	                      |	ВсК.Договор КАК Договор,
	                      |	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК Менеджер,
	                      |	ВсК.ОбъектРасчётов КАК РеализацияТоваровУслуг,
	                      |	ВсК.СуммаОстаток КАК Долг,
	                      |	НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДатыОснований.Дата, ВсК.ОбъектРасчётов.Дата), ДЕНЬ) КАК ДатаОтгрузки,
	                      |	ЕСТЬNULL(ВсК.Договор.СуммаКредита, 0) КАК СуммаКредита
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(
	                      |			&Период,
	                      |			(ОбъектРасчётов ССЫЛКА Документ.РеализацияТоваровУслуг
	                      |				ИЛИ ОбъектРасчётов ССЫЛКА Документ.НалоговаяНакладная)
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьОрганизации
	                      |						ТОГДА Договор.Организация В (&Организации)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьКонтрагенты
	                      |						ТОГДА Контрагент В ИЕРАРХИИ (&Контрагенты)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьМенеджеры
	                      |						ТОГДА ОбъектРасчётов.Менеджер В ИЕРАРХИИ (&Менеджеры)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьДоговоры
	                      |						ТОГДА Договор В (&Договоры)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ) КАК ВсК
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			ПокрытиеОснований.Ссылка КАК Документ,
	                      |			МИНИМУМ(ДокументыОснований.Дата) КАК Дата
	                      |		ИЗ
	                      |			Документ.РеализацияТоваровУслуг.Основания КАК ПокрытиеОснований
	                      |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК ДокументыОснований
	                      |				ПО ПокрытиеОснований.Основание = ДокументыОснований.Ссылка
	                      |		СГРУППИРОВАТЬ ПО
	                      |			ПокрытиеОснований.Ссылка) КАК ДатыОснований
	                      |		ПО ВсК.ОбъектРасчётов = ДатыОснований.Документ
	                      |ГДЕ
	                      |	ВсК.СуммаОстаток > 0
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПроизводственныйКалендарь.Дата) КАК КоличествоВыходных
	                      |ПОМЕСТИТЬ ВТВыходные
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь
	                      |		ПО (ПроизводственныйКалендарь.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, 1) И &ПериодДата)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТ.РеализацияТоваровУслуг
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	""Состояние взаиморасчетов"" КАК ГруппировкаВсего,
	                      |	ВЗ.Организация КАК Организация,
	                      |	ВЗ.Контрагент КАК Контрагент,
	                      |	ВЗ.Договор КАК Договор,
	                      |	ВЗ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
	                      |	ВЗ.Менеджер КАК Менеджер,
	                      |	ВЗ.Долг КАК Долг,
	                      |	ВЗ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |	ВЗ.КоличествоВыходных КАК КоличествоВыходных,
	                      |	ВЗ.ПросроченоДней КАК ПросроченоДней
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТ.Организация КАК Организация,
	                      |		ВТ.Контрагент КАК Контрагент,
	                      |		ВТ.Договор КАК Договор,
	                      |		ВТ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
	                      |		ВТ.РеализацияТоваровУслуг.Менеджер КАК Менеджер,
	                      |		ВЫБОР
	                      |			КОГДА ВТ.Долг - ВТ.СуммаКредита < 0
	                      |				ТОГДА 0
	                      |			ИНАЧЕ ВТ.Долг - ВТ.СуммаКредита
	                      |		КОНЕЦ КАК Долг,
	                      |		ВТ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |		ЕСТЬNULL(ВТВыходные.КоличествоВыходных, 0) КАК КоличествоВыходных,
	                      |		РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, ВЫБОР
	                      |				КОГДА ЕСТЬNULL(Договоры.СрокОплаты, 0) > 0
	                      |					ТОГДА Договоры.СрокОплаты
	                      |				КОГДА ЕСТЬNULL(Контрагенты.СрокОплаты, 0) > 0
	                      |					ТОГДА Контрагенты.СрокОплаты
	                      |				ИНАЧЕ 365
	                      |			КОНЕЦ + ВЫБОР
	                      |					КОГДА ВЫБОР
	                      |							КОГДА ЕСТЬNULL(Договоры.СпособРасчётаОтсрочки,
	                      |									ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.ПустаяСсылка))
	                      |									<> ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.ПустаяСсылка)
	                      |								ТОГДА Договоры.СпособРасчётаОтсрочки
	                      |							ИНАЧЕ Контрагенты.СпособРасчётаОтсрочки
	                      |						КОНЕЦ = ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.БанковскиеДни)
	                      |						ТОГДА ЕСТЬNULL(ВТВыходные.КоличествоВыходных, 0)
	                      |					ИНАЧЕ 0
	                      |				КОНЕЦ), &ПериодДата, ДЕНЬ) КАК ПросроченоДней
	                      |	ИЗ
	                      |		ВТ КАК ВТ
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ ВТВыходные КАК ВТВыходные
	                      |			ПО ВТ.РеализацияТоваровУслуг = ВТВыходные.РеализацияТоваровУслуг
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыСКонтрагентами КАК Договоры
	                      |			ПО ВТ.Договор = Договоры.Ссылка
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	                      |			ПО ВТ.Контрагент = Контрагенты.Ссылка) КАК ВЗ
	                      |ГДЕ
	                      |	ВЗ.Долг > 0
	                      |	И ВЫБОР
	                      |			КОГДА &ТолькоПросроченные
	                      |				ТОГДА ВЗ.ПросроченоДней > 0
	                      |			ИНАЧЕ ИСТИНА
	                      |		КОНЕЦ");
	// BSLLS:JoinWithVirtualTable-on
	// BSLLS:JoinWithSubQuery-on
	Если ТипЗнч(Период) = Тип("Граница") Тогда
		ГраницаПериода = Период;
	ИначеЕсли ТипЗнч(Период) = Тип("МоментВремени") Или ПоПозицииДокумента Тогда
		ГраницаПериода = Новый Граница(Период, ВидГраницы.Исключая);
	Иначе
		ГраницаПериода = КонецДня(Период);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", ГраницаПериода);
	Запрос.УстановитьПараметр("ПериодДата", КонецДня(ДатаПериода(Период)));
	Запрос.УстановитьПараметр("ЕстьОрганизации", Организации.Количество() <> 0);
	Запрос.УстановитьПараметр("Организации", Организации);
	Запрос.УстановитьПараметр("ЕстьКонтрагенты", Контрагенты.Количество() <> 0);
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("ЕстьДоговоры", Договоры.Количество() <> 0);
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Запрос.УстановитьПараметр("ЕстьМенеджеры", Менеджеры.Количество() <> 0);
	Запрос.УстановитьПараметр("Менеджеры", Менеджеры);
	Запрос.УстановитьПараметр("ТолькоПросроченные", ТолькоПросроченные);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ДатаПериода(Период)
	Если ТипЗнч(Период) = Тип("Граница") Тогда
		Возврат ДатаПериода(Период.Значение);
	ИначеЕсли ТипЗнч(Период) = Тип("МоментВремени") Тогда
		Возврат Период.Дата;
	Иначе
		Возврат Период;
	КонецЕсли;
КонецФункции

// Оплаты по документу продажи с разбивкой по типам и долг клиента на момент до документа.
//
// Параметры:
//  Документ - ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.ВозвратОтПокупателя - объект расчётов.
//  Клиент - СправочникСсылка.Контрагенты - клиент документа.
//
// Возвращаемое значение:
//  Структура - ВсегоОплачено, Наличные, Чеком (Число) - суммы оплат по документу;
//              Долг (Число) - долг клиента на границу Исключая по моменту времени документа.
//
Функция ОплатыИДолгПоДокументу(Документ, Клиент) Экспорт
	Оплаты = GetTableOfPayments(Документ);
	Результат = Новый Структура("ВсегоОплачено, Наличные, Чеком", Оплаты.Итог("Somme"), 0, 0);
	СтрокаОплаты = Оплаты.Найти(Справочники.TypesDePayment.Cash, "TypesDePayment");
	Если СтрокаОплаты <> Неопределено Тогда
		Результат.Наличные = СтрокаОплаты.Somme;
	КонецЕсли;
	СтрокаОплаты = Оплаты.Найти(Справочники.TypesDePayment.Cheque, "TypesDePayment");
	Если СтрокаОплаты <> Неопределено Тогда
		Результат.Чеком = СтрокаОплаты.Somme;
	КонецЕсли;
	Клиенты = Новый Массив;
	Клиенты.Добавить(Клиент);
	Граница = Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая);
	Долги = ПолучитьЗадолженностьКлиентовПоКлассификации(Граница, Новый Структура("Контрагенты", Клиенты), Истина);
	Результат.Вставить("Долг", Долги.Итог("Долг"));
	Возврат Результат;
КонецФункции

// Возвращает задолженность покупателей с датами запрета отгрузок по условиям кредита.
// Условия берутся с договора, при незаполненных значениях договора - с контрагента
// (СрокОплаты = 0 у обоих означает 365 дней). Менеджер - куратор договора, при его
// отсутствии - ответственный контрагента.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты, Неопределено - отбор по покупателю;
//               Неопределено - по всем покупателям.
//  МинДнейПросрочки - Число - в результат попадают строки, просроченные не менее чем
//               на указанное число дней (0 - дата запрета наступила сегодня).
//  БезОтбораПоПросрочке - Булево - Истина: вернуть весь долг без отбора по просрочке,
//               в том числе строки, дата запрета которых еще не наступила.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Контрагент, Менеджер (СправочникСсылка.ФизическиеЛица),
//               Долг (весь), ДолгСверхКредита, ДатаЗапрета, ПросроченоДней (максимум),
//               КонтрольКредита (Булево, признак контрагента).
//
Функция ПолучитьПросроченнуюЗадолженность(Контрагент = Неопределено, МинДнейПросрочки = 0, БезОтбораПоПросрочке = Ложь) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	// Дата долга налогового документа на основаниях - по раннему основанию (docs/plans/accounting-morocco-f1-s2.md):
	// соединение с датами оснований к виртуальной таблице остатков.
	// BSLLS:JoinWithVirtualTable-off
	// BSLLS:JoinWithSubQuery-off
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВсК.Контрагент КАК Контрагент,
	                      |	ВсК.Договор КАК Договор,
	                      |	ВЫБОР
	                      |		КОГДА ЕСТЬNULL(КураторыДоговоров.Куратор, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	                      |			ТОГДА ЕСТЬNULL(Контрагенты.Ответственный, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
	                      |		ИНАЧЕ КураторыДоговоров.Куратор
	                      |	КОНЕЦ КАК Менеджер,
	                      |	ВсК.ОбъектРасчётов КАК РеализацияТоваровУслуг,
	                      |	ВсК.СуммаОстаток КАК Долг,
	                      |	НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДатыОснований.Дата, ВсК.ОбъектРасчётов.Дата), ДЕНЬ) КАК ДатаОтгрузки,
	                      |	ВЫБОР
	                      |		КОГДА ЕСТЬNULL(Договоры.СрокОплаты, 0) > 0
	                      |			ТОГДА Договоры.СрокОплаты
	                      |		КОГДА ЕСТЬNULL(Контрагенты.СрокОплаты, 0) > 0
	                      |			ТОГДА Контрагенты.СрокОплаты
	                      |		ИНАЧЕ 365
	                      |	КОНЕЦ КАК СрокОплаты,
	                      |	ВЫБОР
	                      |		КОГДА ЕСТЬNULL(Договоры.СпособРасчётаОтсрочки, ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.ПустаяСсылка)
	                      |			ТОГДА Договоры.СпособРасчётаОтсрочки = ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.БанковскиеДни)
	                      |		ИНАЧЕ ЕСТЬNULL(Контрагенты.СпособРасчётаОтсрочки, ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.БанковскиеДни)
	                      |	КОНЕЦ КАК ПоБанковскимДням,
	                      |	ВЫБОР
	                      |		КОГДА ЕСТЬNULL(Договоры.СуммаКредита, 0) > 0
	                      |			ТОГДА Договоры.СуммаКредита
	                      |		ИНАЧЕ ЕСТЬNULL(Контрагенты.СуммаКредита, 0)
	                      |	КОНЕЦ КАК СуммаКредита,
	                      |	ЕСТЬNULL(Контрагенты.КонтрольКредита, ЛОЖЬ) КАК КонтрольКредита
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(
	                      |			&Период,
	                      |			(ОбъектРасчётов ССЫЛКА Документ.РеализацияТоваровУслуг
	                      |				ИЛИ ОбъектРасчётов ССЫЛКА Документ.НалоговаяНакладная)
	                      |				И (Контрагент = &Контрагент
	                      |					ИЛИ &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))) КАК ВсК
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			ПокрытиеОснований.Ссылка КАК Документ,
	                      |			МИНИМУМ(ДокументыОснований.Дата) КАК Дата
	                      |		ИЗ
	                      |			Документ.РеализацияТоваровУслуг.Основания КАК ПокрытиеОснований
	                      |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК ДокументыОснований
	                      |				ПО ПокрытиеОснований.Основание = ДокументыОснований.Ссылка
	                      |		СГРУППИРОВАТЬ ПО
	                      |			ПокрытиеОснований.Ссылка) КАК ДатыОснований
	                      |		ПО ВсК.ОбъектРасчётов = ДатыОснований.Документ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КураторыДоговоров.СрезПоследних(&Период, ) КАК КураторыДоговоров
	                      |		ПО ВсК.Договор = КураторыДоговоров.Договор
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыСКонтрагентами КАК Договоры
	                      |		ПО ВсК.Договор = Договоры.Ссылка
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	                      |		ПО ВсК.Контрагент = Контрагенты.Ссылка
	                      |ГДЕ
	                      |	ВсК.СуммаОстаток > 0
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПроизводственныйКалендарь.Дата) КАК КоличествоВыходных
	                      |ПОМЕСТИТЬ ВТВыходные
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь
	                      |		ПО (ПроизводственныйКалендарь.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, 1) И &Период)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТ.РеализацияТоваровУслуг
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВЗ.Контрагент КАК Контрагент,
	                      |	ВЗ.Договор КАК Договор,
	                      |	ВЗ.Менеджер КАК Менеджер,
	                      |	ВЗ.КонтрольКредита КАК КонтрольКредита,
	                      |	СУММА(ВЗ.Долг) КАК Долг,
	                      |	МАКСИМУМ(ВЗ.СуммаКредита) КАК СуммаКредита,
	                      |	МИНИМУМ(ВЗ.ДатаЗапрета) КАК ДатаЗапрета,
	                      |	МАКСИМУМ(ВЗ.ПросроченоДней) КАК ПросроченоДней
	                      |ПОМЕСТИТЬ Предварительная
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТ.Контрагент КАК Контрагент,
	                      |		ВТ.Договор КАК Договор,
	                      |		ВТ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
	                      |		ВТ.Менеджер КАК Менеджер,
	                      |		ВТ.КонтрольКредита КАК КонтрольКредита,
	                      |		ВТ.Долг КАК Долг,
	                      |		ВТ.СуммаКредита КАК СуммаКредита,
	                      |		ВТ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |		ВТВыходные.КоличествоВыходных КАК КоличествоВыходных,
	                      |		ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, ВТ.СрокОплаты + ВЫБОР
	                      |				КОГДА ВТ.ПоБанковскимДням
	                      |					ТОГДА ЕСТЬNULL(ВТВыходные.КоличествоВыходных, 0)
	                      |				ИНАЧЕ 0
	                      |			КОНЕЦ) КАК ДатаЗапрета,
	                      |		РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, ВТ.СрокОплаты + ВЫБОР
	                      |					КОГДА ВТ.ПоБанковскимДням
	                      |						ТОГДА ЕСТЬNULL(ВТВыходные.КоличествоВыходных, 0)
	                      |					ИНАЧЕ 0
	                      |				КОНЕЦ), &Период, ДЕНЬ) КАК ПросроченоДней
	                      |	ИЗ
	                      |		ВТ КАК ВТ
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ ВТВыходные КАК ВТВыходные
	                      |			ПО ВТ.РеализацияТоваровУслуг = ВТВыходные.РеализацияТоваровУслуг) КАК ВЗ
	                      |ГДЕ
	                      |	ВЗ.ПросроченоДней >= &ПросроченоДней
	                      |	И ВЗ.Долг > 0
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВЗ.Контрагент,
	                      |	ВЗ.Договор,
	                      |	ВЗ.Менеджер,
	                      |	ВЗ.КонтрольКредита
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Предварительная.Контрагент КАК Контрагент,
	                      |	Предварительная.Менеджер КАК Менеджер,
	                      |	Предварительная.КонтрольКредита КАК КонтрольКредита,
	                      |	Предварительная.Долг КАК Долг,
	                      |	ВЫБОР
	                      |		КОГДА Предварительная.Долг - Предварительная.СуммаКредита < 0
	                      |			ТОГДА 0
	                      |		ИНАЧЕ Предварительная.Долг - Предварительная.СуммаКредита
	                      |	КОНЕЦ КАК ДолгСверхКредита,
	                      |	Предварительная.ДатаЗапрета КАК ДатаЗапрета,
	                      |	Предварительная.ПросроченоДней КАК ПросроченоДней
	                      |ПОМЕСТИТЬ Итог
	                      |ИЗ
	                      |	Предварительная КАК Предварительная
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Итог.Контрагент КАК Контрагент,
	                      |	Итог.Менеджер КАК Менеджер,
	                      |	Итог.КонтрольКредита КАК КонтрольКредита,
	                      |	СУММА(Итог.Долг) КАК Долг,
	                      |	СУММА(Итог.ДолгСверхКредита) КАК ДолгСверхКредита,
	                      |	МИНИМУМ(Итог.ДатаЗапрета) КАК ДатаЗапрета,
	                      |	МАКСИМУМ(Итог.ПросроченоДней) КАК ПросроченоДней
	                      |ИЗ
	                      |	Итог КАК Итог
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Итог.Менеджер,
	                      |	Итог.Контрагент,
	                      |	Итог.КонтрольКредита");
	// BSLLS:JoinWithVirtualTable-on
	// BSLLS:JoinWithSubQuery-on
	Если БезОтбораПоПросрочке Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЗ.ПросроченоДней >= &ПросроченоДней", "ИСТИНА");
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ПросроченоДней", МинДнейПросрочки);
	Запрос.УстановитьПараметр("Контрагент",?(Контрагент = Неопределено,Справочники.Контрагенты.ПустаяСсылка(),Контрагент));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти 

Функция ПолучитьОплатыПоМенеджеру(ДатаНачала, ДатаОкончания, Менеджер, Отбор) Экспорт
	МасКонтрагенты = Новый Массив;
	ПринадлежностьКлиента = Перечисления.ПринадлежностьКлиента.ПустаяСсылка();
	Для Каждого Параметр Из Отбор.Параметры Цикл
		Если ТипЗнч(Параметр) = Тип("СправочникСсылка.Контрагенты") Тогда
			МасКонтрагенты.Добавить(Параметр);
		ИначеЕсли ТипЗнч(Параметр) = Тип("ПеречислениеСсылка.ПринадлежностьКлиента") Тогда
			ПринадлежностьКлиента = Параметр;
		КонецЕсли;	
	КонецЦикла;	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СУММА(ВзаиморасчётыСПокупателямиОбороты.СуммаРасход) КАК Оплата,
	                      |	ПродажиОбороты.Сотрудник КАК Менеджер,
	                      |	ВзаиморасчётыСПокупателямиОбороты.Период КАК ДатаОплаты,
	                      |	ВзаиморасчётыСПокупателямиОбороты.Договор КАК Договор
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателями.Обороты(
	                      |			&ДатаНач,
	                      |			&ДатаКон,
	                      |			Регистратор,
	                      |			ВЫБОР
	                      |				КОГДА &КонтрагентыУказаны
	                      |					ТОГДА Контрагент В (&Контрагенты)
	                      |				ИНАЧЕ ИСТИНА
	                      |			КОНЕЦ) КАК ВзаиморасчётыСПокупателямиОбороты
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(
	                      |				,
	                      |				,
	                      |				,
	                      |				Сотрудник = &Менеджер
	                      |					И ВЫБОР
	                      |						КОГДА &ПринадлежностьКлиента = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьКлиента.Свой)
	                      |							ТОГДА Ответственный = &Менеджер
	                      |						КОГДА &ПринадлежностьКлиента = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьКлиента.КлиентФирмы)
	                      |							ТОГДА НЕ Ответственный = &Менеджер
	                      |						ИНАЧЕ ИСТИНА
	                      |					КОНЕЦ) КАК ПродажиОбороты
	                      |		ПО ВзаиморасчётыСПокупателямиОбороты.ОбъектРасчётов = ПродажиОбороты.ДокументПродажи
	                      |ГДЕ
	                      |	НАЧАЛОПЕРИОДА(ВзаиморасчётыСПокупателямиОбороты.Период, ДЕНЬ) <= ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ВзаиморасчётыСПокупателямиОбороты.ОбъектРасчётов.Дата, ДЕНЬ), ДЕНЬ, ВзаиморасчётыСПокупателямиОбороты.Договор.СрокОплаты)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ПродажиОбороты.Сотрудник,
	                      |	ВзаиморасчётыСПокупателямиОбороты.Период,
	                      |	ВзаиморасчётыСПокупателямиОбороты.Договор");
	Запрос.УстановитьПараметр("ДатаНач", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", ДатаОкончания);
	Запрос.УстановитьПараметр("Менеджер", Менеджер);
	Запрос.УстановитьПараметр("КонтрагентыУказаны", МасКонтрагенты.Количество() > 0);
	Запрос.УстановитьПараметр("Контрагенты", МасКонтрагенты);
	Запрос.УстановитьПараметр("ПринадлежностьКлиента", ПринадлежностьКлиента);
	Рез = Запрос.Выполнить();
	Возврат ?(Рез.Пустой(), 0, Рез.Выгрузить().Итог("Оплата"));	
КонецФункции

Function GetTableOfPayments(CurrentDoc) Export
	Query = New Query;
	Query.Text =
	"ВЫБРАТЬ
	|	ВзаиморасчётыОбороты.Регистратор КАК Регистратор,
	|	ВзаиморасчётыОбороты.СуммаОборот КАК СуммаОборот
	|ПОМЕСТИТЬ ВТОбороты
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПокупателями.Обороты(, , Регистратор, ОбъектРасчётов = &CurrentDoc) КАК ВзаиморасчётыОбороты
	|ГДЕ
	|	(ТИПЗНАЧЕНИЯ(ВзаиморасчётыОбороты.Регистратор) = ТИП(Документ.ПриходныйКассовыйОрдер)
	|			ИЛИ ТИПЗНАЧЕНИЯ(ВзаиморасчётыОбороты.Регистратор) = ТИП(Документ.ПоступлениеБезналичныхДенежныхСредств)
	|			ИЛИ ТИПЗНАЧЕНИЯ(ВзаиморасчётыОбороты.Регистратор) = ТИП(Документ.СертификатНаОплату))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(-ВТОбороты.СуммаОборот) КАК Somme,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.ПриходныйКассовыйОрдер)
	|			ТОГДА ПриходныйКассовыйОрдер.ТипОплаты
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.ПоступлениеБезналичныхДенежныхСредств)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.TypesDePayment.VirementBanquaire)
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.СертификатНаОплату)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.TypesDePayment.Сертификат)
	|	КОНЕЦ КАК TypesDePayment
	|ИЗ
	|	ВТОбороты КАК ВТОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|		ПО ВТОбороты.Регистратор = ПриходныйКассовыйОрдер.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.ПриходныйКассовыйОрдер)
	|			ТОГДА ПриходныйКассовыйОрдер.ТипОплаты
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.ПоступлениеБезналичныхДенежныхСредств)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.TypesDePayment.VirementBanquaire)
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТОбороты.Регистратор) = ТИП(Документ.СертификатНаОплату)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.TypesDePayment.Сертификат)
	|	КОНЕЦ
	|
	|ИМЕЮЩИЕ
	|	СУММА(-ВТОбороты.СуммаОборот) <> 0";
	Query.SetParameter("CurrentDoc",CurrentDoc);
	ValueTable = Query.Execute().Unload();
	Return ValueTable;
EndFunction
