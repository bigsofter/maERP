#Область ПрограммныйИнтерфейс

// Формирует движения регистра по документу переработки.
//
// Единственная точка вызова - диспетчер РегистрыНакопления.ТоварыВНаличии.СформироватьДвижения:
// передача сначала списывает сырьё со склада, и приход в переработку строится по этим
// расходам с их себестоимостью и издержками; поступление списывает сырьё у переработчика,
// а по сумме списания диспетчер приходует готовую продукцию на склад.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПередачаВПереработку, ДокументОбъект.ПоступлениеИзПереработки - проводимый документ
//  ТЗТоварыССериями - ТаблицаЗначений - строки ТЧТовары документа (СерииИРазмещение.ОбъединитьТоварыССериями)
//
// Возвращаемое значение:
//  Булево - Ложь, если у переработчика не хватает сырья (сообщение уже выдано) или тип документа не поддержан
//
Функция СформироватьДвижения(ДокОбъект, ТЗТоварыССериями) Экспорт
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПередачаВПереработку") Тогда
		ОтразитьПередачу(ДокОбъект);
		Возврат Истина;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеИзПереработки") Тогда
		Возврат СписатьИзПереработки(ТЗТоварыССериями, ДокОбъект);
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

// Остатки сырья у переработчика на дату.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - переработчик
//  Дата - Дата, МоментВремени, Граница - момент получения остатков
//  Отбор - Структура, Неопределено - дополнительные условия по измерениям регистра:
//          ключи Номенклатура, Характеристика, Серия, ПередачаВПереработку
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура, Характеристика, Серия, Партия, ДатаПартии,
//                    ПередачаВПереработку, ЗаказПокупателя, Количество, Сумма, СуммаНДС;
//                    упорядочена по дате партии
//
Функция ПолучитьОстатки(Контрагент, Дата, Отбор = Неопределено) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Остатки.Номенклатура КАК Номенклатура,
	                      |	Остатки.Характеристика КАК Характеристика,
	                      |	Остатки.Серия КАК Серия,
	                      |	Остатки.Партия КАК Партия,
	                      |	Остатки.ДатаПартии КАК ДатаПартии,
	                      |	Остатки.ПередачаВПереработку КАК ПередачаВПереработку,
	                      |	Остатки.ЗаказПокупателя КАК ЗаказПокупателя,
	                      |	Остатки.КоличествоОстаток КАК Количество,
	                      |	Остатки.СуммаОстаток КАК Сумма,
	                      |	Остатки.СуммаНДСОстаток КАК СуммаНДС
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВПереработке.Остатки(&Дата, Контрагент = &Контрагент &УсловиеОтбора) КАК Остатки
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДатаПартии");
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	УсловиеОтбора = "";
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из Отбор Цикл
			УсловиеОтбора = УсловиеОтбора + " И " + КлючИЗначение.Ключ + " = &" + КлючИЗначение.Ключ;
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", УсловиеОтбора);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Списывает сырьё у переработчика по партиям в разрезе Контрагент + Номенклатура + Характеристика + Серия. При
// недостаче выдаёт сообщение по каждой позиции и движения не формирует.
//
// Строки делятся на группы по заказу строки (ПроизводственныеЗаказы.ЗаказСтрокиПереработки, план
// subcontract-multi-order):
//  - группа заказа X берёт только партии заказа X и беззаказные: партии чужих заказов недоступны ни контролю
//    недостачи, ни списанию - иначе поступление одного заказа съедает партии другого заказа того же переработчика, в
//    том числе через общую передачу (ревью плана, раунды 2 и 6). Беззаказные партии из отбора не выбрасываются:
//    передача без заказа обычна, и равенство заказу дало бы ложную недостачу при полном остатке у переработчика;
//  - группа без заказа (поступление без основания) - любые партии переработчика, как раньше.
// Группы разбираются по очереди на одной таблице партий - беззаказная партия не достаётся двум группам: группы
// заказов в порядке первой строки, группа без заказа последней. Внутри группы: партии своего заказа, затем партии
// передачи-основания, затем FIFO по дате партии. Себестоимость списанного по группам - в
// ДополнительныеСвойства документа (см. ИмяСвойстваСписаноПоЗаказам): её распределяет оприходование продукции.
//
// Параметры:
//  ТЗ - ТаблицаЗначений - строки списания с колонками Номенклатура, Характеристика, Серия, Количество, Заказ
//  ДокОбъект - ДокументОбъект.ПоступлениеИзПереработки - проводимый документ
//
// Возвращаемое значение:
//  Булево - Истина, если сырья хватило и расход сформирован
//
Функция СписатьИзПереработки(ТЗ, ДокОбъект) Экспорт
	Группы = ГруппыСписания(ТЗ, ДокОбъект);
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ВЫРАЗИТЬ(ТЗ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(ТЗ.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	                      |	ВЫРАЗИТЬ(ТЗ.Серия КАК Справочник.СерииНоменклатуры) КАК Серия
	                      |ПОМЕСТИТЬ ВТТовары
	                      |ИЗ
	                      |	&ТЗ КАК ТЗ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Остатки.Номенклатура КАК Номенклатура,
	                      |	Остатки.Характеристика КАК Характеристика,
	                      |	Остатки.Серия КАК Серия,
	                      |	Остатки.Партия КАК Партия,
	                      |	Остатки.ДатаПартии КАК ДатаПартии,
	                      |	Остатки.ПередачаВПереработку КАК ПередачаВПереработку,
	                      |	Остатки.ЗаказПокупателя КАК ЗаказПокупателя,
	                      |	Остатки.КоличествоОстаток КАК Количество,
	                      |	Остатки.СуммаОстаток КАК Сумма,
	                      |	Остатки.СуммаНДСОстаток КАК СуммаНДС
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВПереработке.Остатки(
	                      |			&ДатаОстатков,
	                      |			Контрагент = &Контрагент
	                      |				И (Номенклатура, Характеристика, Серия) В
	                      |					(ВЫБРАТЬ
	                      |						ВТТовары.Номенклатура КАК Номенклатура,
	                      |						ВТТовары.Характеристика КАК Характеристика,
	                      |						ВТТовары.Серия КАК Серия
	                      |					ИЗ
	                      |						ВТТовары КАК ВТТовары)) КАК Остатки
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДатаПартии");
	Запрос.УстановитьПараметр("ТЗ", ТЗ.Скопировать(, "Номенклатура, Характеристика, Серия"));
	Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(ДокОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Контрагент", ДокОбъект.Контрагент);
	ТЗПартии = Запрос.ВыполнитьПакет()[1].Выгрузить();
	Передача = ПередачаОснование(ДокОбъект);
	Нетто = НеттоОстатков(ТЗПартии);
	// Сначала весь разбор в памяти: при недостаче движения не пишутся вовсе.
	Списания = Новый Массив;
	Недостача = Ложь;
	Для Каждого Группа Из Группы Цикл
		Для Каждого Стр Из Группа.Строки Цикл
			Партии = ДопустимыеПартии(ТЗПартии, Стр, Группа.Заказ, Передача);
			Остаток = ДоступноПартий(Партии, Нетто);
			Если Стр.Количество > Остаток Тогда
				Недостача = Истина;
				СообщитьОНедостаче(ДокОбъект, Стр, Остаток, Группа.Заказ);
				Продолжить;
			КонецЕсли;
			РазобратьПартии(Списания, Стр, Партии, Группа.Заказ, Нетто);
		КонецЦикла;
	КонецЦикла;
	Если Недостача Тогда
		Возврат Ложь;
	КонецЕсли;
	СписаноПоЗаказам = Новый Соответствие;
	Для Каждого Списание Из Списания Цикл
		ДобавитьДвижение(ДокОбъект, ВидДвиженияНакопления.Расход, Списание.Партия, Списание.Количество, Списание.Сумма,
			Списание.СуммаНДС);
		Ключ = XMLСтрока(Списание.ЗаказГруппы);
		Итог = СписаноПоЗаказам[Ключ];
		Если Итог = Неопределено Тогда
			Итог = Новый Структура("Заказ, Сумма, СуммаНДС", Списание.ЗаказГруппы, 0, 0);
			СписаноПоЗаказам.Вставить(Ключ, Итог);
		КонецЕсли;
		Итог.Сумма = Итог.Сумма + Списание.Сумма;
		Итог.СуммаНДС = Итог.СуммаНДС + Списание.СуммаНДС;
	КонецЦикла;
	ДокОбъект.ДополнительныеСвойства.Вставить(ИмяСвойстваСписаноПоЗаказам(), СписаноПоЗаказам);
	Возврат Истина;
КонецФункции

// Имя дополнительного свойства поступления, в котором СписатьИзПереработки оставляет себестоимость списанного по
// заказам групп.
//
// Возвращаемое значение:
//  Строка - имя свойства; значение - Соответствие: ключ XMLСтрока(заказ группы), значение Структура Заказ, Сумма,
//           СуммаНДС.
//
Функция ИмяСвойстваСписаноПоЗаказам() Экспорт
	Возврат "СписаноУПереработчикаПоЗаказам";
КонецФункции

// Себестоимость сырья, списанного у переработчика документом.
//
// Параметры:
//  Док - ДокументСсылка.ПоступлениеИзПереработки - регистратор
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура, Характеристика, Серия, Количество, Сумма, СуммаНДС по расходам документа
//
Функция ПолучитьСебестоимостьПоДокументу(Док) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТоварыВПереработке.Номенклатура КАК Номенклатура,
	                      |	ТоварыВПереработке.Характеристика КАК Характеристика,
	                      |	ТоварыВПереработке.Серия КАК Серия,
	                      |	СУММА(ТоварыВПереработке.Количество) КАК Количество,
	                      |	СУММА(ТоварыВПереработке.Сумма) КАК Сумма,
	                      |	СУММА(ТоварыВПереработке.СуммаНДС) КАК СуммаНДС
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВПереработке КАК ТоварыВПереработке
	                      |ГДЕ
	                      |	ТоварыВПереработке.Регистратор = &Регистратор
	                      |	И ТоварыВПереработке.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ТоварыВПереработке.Номенклатура,
	                      |	ТоварыВПереработке.Характеристика,
	                      |	ТоварыВПереработке.Серия");
	Запрос.УстановитьПараметр("Регистратор", Док);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Есть ли расход партий передачи в переработку от других документов - поступлений из переработки по ней или, по FIFO,
// по другим передачам того же переработчика (E12.3b). Отбор - по переработчику передачи в базе (первое измерение
// индекса регистра). Читается служебно: пишут передачу роли без права на регистр.
//
// Переработчики - из фактических движений передачи и её шапки в базе, а не только из шапки: шапку проведённой передачи
// можно было переписать на другого переработчика без перепроведения (ревью плана subcontract-multi-order, раунд 14).
// Проведение и отмена передачи передают снимок переработчиков, снятый до автоудаления движений.
//
// Параметры:
//  Передача    - ДокументСсылка.ПередачаВПереработку - передача.
//  Контрагенты - Массив из СправочникСсылка.Контрагенты, Неопределено - переработчики, у которых искать расход;
//                Неопределено - переработчики движений передачи и её шапки.
//
// Возвращаемое значение:
//  Булево - Истина, если партии передачи уже списывались.
//
Функция ЕстьСписаниеПоПередаче(Передача, Контрагенты = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Передача) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Контрагенты = Неопределено Тогда
		Контрагенты = КонтрагентыПередачи(Передача);
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Движения.Регистратор КАК Регистратор
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВПереработке КАК Движения
	                      |ГДЕ
	                      |	Движения.Контрагент В (&Контрагенты)
	                      |	И Движения.ПередачаВПереработку = &Передача
	                      |	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                      |	И Движения.Активность
	                      |	И Движения.Регистратор <> &Передача");
	Запрос.УстановитьПараметр("Передача", Передача);
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	// BSLLS:SetPrivilegedMode-off - наружу уходит только признак, данные регистра не возвращаются.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Переработчики движений передачи и её шапки в базе.
//
// Параметры:
//  Передача - ДокументСсылка.ПередачаВПереработку - передача.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты - без повторов.
//
Функция КонтрагентыПередачи(Передача) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Контрагенты.Контрагент КАК Контрагент
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		Движения.Контрагент КАК Контрагент
	                      |	ИЗ
	                      |		РегистрНакопления.ТоварыВПереработке КАК Движения
	                      |	ГДЕ
	                      |		Движения.Регистратор = &Передача
	                      |
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |	ВЫБРАТЬ
	                      |		Передачи.Контрагент
	                      |	ИЗ
	                      |		Документ.ПередачаВПереработку КАК Передачи
	                      |	ГДЕ
	                      |		Передачи.Ссылка = &Передача) КАК Контрагенты");
	Запрос.УстановитьПараметр("Передача", Передача);
	// BSLLS:SetPrivilegedMode-off - наружу уходят только переработчики документа.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент");
КонецФункции

// Контроль после записи движений (план subcontract-multi-order, ревью плана, раунды 10-17): текущие остатки у
// переработчика по передачам не уходят в минус. Разрез - количество по Контрагент, Номенклатура, Характеристика, Серия,
// ПередачаВПереработку, ЗаказПокупателя, БЕЗ Партия и ДатаПартии: пошаговое восстановление последовательности
// перепроводит передачу отдельно от поступления, и смена складской партии по FIFO на время даёт минус по партии, а не
// по этому разрезу. Уменьшение переданного, удаление строки, смена заказа и поступление задним числом за уже
// списанное этим разрезом ловятся. Читается служебно: наружу уходят только позиции с минусом.
//
// Параметры:
//  Контрагенты - Массив из СправочникСсылка.Контрагенты - переработчики (прежний и новый).
//  Передачи    - Массив из ДокументСсылка.ПередачаВПереработку - передачи, остатки которых проверяются.
//
// Возвращаемое значение:
//  Строка - текст отказа по позициям с минусом; пустая - остатки не отрицательны.
//
Функция ТекстОтрицательныхОстатков(Контрагенты, Передачи) Экспорт
	Если Передачи.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Остатки.Контрагент КАК Контрагент,
	                      |	Остатки.Номенклатура КАК Номенклатура,
	                      |	Остатки.Характеристика КАК Характеристика,
	                      |	Остатки.Серия КАК Серия,
	                      |	Остатки.ПередачаВПереработку КАК ПередачаВПереработку,
	                      |	Остатки.ЗаказПокупателя КАК ЗаказПокупателя,
	                      |	СУММА(Остатки.КоличествоОстаток) КАК Количество
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВПереработке.Остатки(
	                      |			,
	                      |			Контрагент В (&Контрагенты)
	                      |				И ПередачаВПереработку В (&Передачи)) КАК Остатки
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Остатки.Контрагент,
	                      |	Остатки.Номенклатура,
	                      |	Остатки.Характеристика,
	                      |	Остатки.Серия,
	                      |	Остатки.ПередачаВПереработку,
	                      |	Остатки.ЗаказПокупателя
	                      |
	                      |ИМЕЮЩИЕ
	                      |	СУММА(Остатки.КоличествоОстаток) < 0");
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("Передачи", Передачи);
	// BSLLS:SetPrivilegedMode-off - наружу уходит только текст отказа по позициям с минусом.
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Выборка = Запрос.Выполнить().Выбрать();
	Шаблон = НСтр("ru = 'У переработчика «%1» по передаче %2 (%3) уже списано больше, чем передано: не хватает %4%5';
		|fr = 'Chez le sous-traitant « %1 », le transfert %2 (%3) a déjà plus de sorties que d''entrées : manque %4%5';
		|en = 'At processor ""%1"", transfer %2 (%3) already has more written off than transferred: short by %4%5';
		|es = 'En el procesador «%1», el envío %2 (%3) ya tiene más bajas que entregas: faltan %4%5'");
	ШаблонЗаказа = НСтр("ru = ', заказ %1'; fr = ', commande %1'; en = ', order %1'; es = ', pedido %1'");
	Тексты = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Представление = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Выборка.Номенклатура,
			Выборка.Характеристика, Выборка.Серия);
		ТекстЗаказа = ?(ЗначениеЗаполнено(Выборка.ЗаказПокупателя), СтрШаблон(ШаблонЗаказа, Выборка.ЗаказПокупателя), "");
		Текст = СтрШаблон(Шаблон, Выборка.Контрагент, Выборка.ПередачаВПереработку, Представление,
			СокрЛП(-Выборка.Количество), ТекстЗаказа);
		Тексты.Добавить(Текст);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Группы списания поступления по заказу строки: группы заказов - в порядке первой строки, группа без заказа -
// последней. Строки внутри группы свёрнуты по номенклатуре, характеристике и серии.
//
// Параметры:
//  ТЗ        - ТаблицаЗначений - строки списания (см. СписатьИзПереработки).
//  ДокОбъект - ДокументОбъект.ПоступлениеИзПереработки - проводимый документ.
//
// Возвращаемое значение:
//  Массив из Структура - Заказ (ДокументСсылка.ЗаказПокупателя, пустая - группа без заказа), Строки (ТаблицаЗначений:
//                        Номенклатура, Характеристика, Серия, Количество).
//
Функция ГруппыСписания(ТЗ, ДокОбъект)
	ЗаказШапки = ПроизводственныеЗаказы.ЗаказШапкиПереработки(ДокОбъект);
	ЕстьКолонкаЗаказа = ТЗ.Колонки.Найти("Заказ") <> Неопределено;
	ПорядокЗаказов = Новый Массив;
	ПоЗаказам = Новый Соответствие;
	Для Каждого Стр Из ТЗ Цикл
		Заказ = ?(ЕстьКолонкаЗаказа, ПроизводственныеЗаказы.ЗаказСтрокиПереработки(Стр, ЗаказШапки), ЗаказШапки);
		Ключ = XMLСтрока(Заказ);
		Строки = ПоЗаказам[Ключ];
		Если Строки = Неопределено Тогда
			Строки = Новый ТаблицаЗначений;
			Для Каждого Имя Из СтрРазделить("Номенклатура,Характеристика,Серия,Количество", ",") Цикл
				Строки.Колонки.Добавить(Имя);
			КонецЦикла;
			ПоЗаказам.Вставить(Ключ, Строки);
			Если ЗначениеЗаполнено(Заказ) Тогда
				ПорядокЗаказов.Добавить(Заказ);
			КонецЕсли;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Строки.Добавить(), Стр);
	КонецЦикла;
	ПустойЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();
	Если ПоЗаказам[XMLСтрока(ПустойЗаказ)] <> Неопределено Тогда
		ПорядокЗаказов.Добавить(ПустойЗаказ);
	КонецЕсли;
	Группы = Новый Массив;
	Для Каждого Заказ Из ПорядокЗаказов Цикл
		Строки = ПоЗаказам[XMLСтрока(Заказ)];
		Строки.Свернуть("Номенклатура, Характеристика, Серия", "Количество");
		Группы.Добавить(Новый Структура("Заказ, Строки", Заказ, Строки));
	КонецЦикла;
	Возврат Группы;
КонецФункции

// Партии позиции, доступные группе, в порядке разбора: группе заказа - партии этого заказа и беззаказные, группе без
// заказа - все; сначала партии своего заказа, затем передачи-основания, затем по дате партии (ТЗПартии упорядочена
// по ней).
//
// Параметры:
//  ТЗПартии  - ТаблицаЗначений - остатки партий переработчика (общая для групп, уменьшается разбором).
//  Стр       - СтрокаТаблицыЗначений - строка группы: Номенклатура, Характеристика, Серия.
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ группы; пустая ссылка - группа без заказа.
//  Передача  - ДокументСсылка.ПередачаВПереработку - передача-основание, см. ПередачаОснование.
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений - строки ТЗПартии.
//
Функция ДопустимыеПартии(ТЗПартии, Стр, Заказ, Передача)
	Отбор = Новый Структура("Номенклатура, Характеристика, Серия");
	ЗаполнитьЗначенияСвойств(Отбор, Стр);
	ЕстьЗаказ = ЗначениеЗаполнено(Заказ);
	ТипЧисло = Новый ОписаниеТипов("Число");
	Порядок = Новый ТаблицаЗначений;
	Порядок.Колонки.Добавить("Партия");
	Порядок.Колонки.Добавить("ПорядокЗаказа", ТипЧисло);
	Порядок.Колонки.Добавить("ПорядокПередачи", ТипЧисло);
	Порядок.Колонки.Добавить("Индекс", ТипЧисло);
	Для Каждого СтрПартия Из ТЗПартии.НайтиСтроки(Отбор) Цикл
		Если ЕстьЗаказ И СтрПартия.ЗаказПокупателя <> Заказ И ЗначениеЗаполнено(СтрПартия.ЗаказПокупателя) Тогда
			Продолжить;
		КонецЕсли;
		НС = Порядок.Добавить();
		НС.Партия = СтрПартия;
		НС.ПорядокЗаказа = ?(ЕстьЗаказ И СтрПартия.ЗаказПокупателя = Заказ, 0, 1);
		НС.ПорядокПередачи = ?(ЗначениеЗаполнено(Передача) И СтрПартия.ПередачаВПереработку = Передача, 0, 1);
		НС.Индекс = ТЗПартии.Индекс(СтрПартия);
	КонецЦикла;
	Порядок.Сортировать("ПорядокЗаказа, ПорядокПередачи, Индекс");
	Возврат Порядок.ВыгрузитьКолонку("Партия");
КонецФункции

// Чистый остаток по передаче, заказу и позиции без партии: после перепроведения передачи приход по FIFO может уйти на
// другую складскую партию - у прежней партии остаток отрицательный, у новой положительный, а сырья у переработчика по
// передаче нет (ревью данных subcontract-multi-order, P1). Положительная партия доступна только в пределах чистого
// остатка - тот же разрез, что у итогового контроля (см. ТекстОтрицательныхОстатков).
//
// Параметры:
//  ТЗПартии - ТаблицаЗначений - остатки партий переработчика.
//
// Возвращаемое значение:
//  Соответствие - ключ КлючНеттоПартии, значение Число - чистый остаток.
//
Функция НеттоОстатков(ТЗПартии)
	Результат = Новый Соответствие;
	Для Каждого СтрПартия Из ТЗПартии Цикл
		Ключ = КлючНеттоПартии(СтрПартия);
		Результат.Вставить(Ключ, ?(Результат[Ключ] = Неопределено, 0, Результат[Ключ]) + СтрПартия.Количество);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Параметры:
//  СтрПартия - СтрокаТаблицыЗначений - остаток партии.
//
// Возвращаемое значение:
//  Строка - ключ «передача|заказ|номенклатура|характеристика|серия».
//
Функция КлючНеттоПартии(СтрПартия)
	Возврат СтрШаблон("%1|%2|%3|%4|%5", XMLСтрока(СтрПартия.ПередачаВПереработку), XMLСтрока(СтрПартия.ЗаказПокупателя),
		XMLСтрока(СтрПартия.Номенклатура), XMLСтрока(СтрПартия.Характеристика), XMLСтрока(СтрПартия.Серия));
КонецФункции

// Доступно к списанию из допустимых партий: положительные партии, но по каждому ключу не больше чистого остатка.
//
// Параметры:
//  Партии - Массив из СтрокаТаблицыЗначений - см. ДопустимыеПартии.
//  Нетто  - Соответствие - см. НеттоОстатков.
//
// Возвращаемое значение:
//  Число - доступное количество.
//
Функция ДоступноПартий(Партии, Нетто)
	ПоКлючам = Новый Соответствие;
	Для Каждого СтрПартия Из Партии Цикл
		Ключ = КлючНеттоПартии(СтрПартия);
		ПоКлючам.Вставить(Ключ, ?(ПоКлючам[Ключ] = Неопределено, 0, ПоКлючам[Ключ]) + Макс(СтрПартия.Количество, 0));
	КонецЦикла;
	Результат = 0;
	Для Каждого КлючИЗначение Из ПоКлючам Цикл
		Результат = Результат + Мин(КлючИЗначение.Значение, Макс(Нетто[КлючИЗначение.Ключ], 0));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Списывает количество строки группы с её допустимых партий по порядку; остатки партий в общей таблице уменьшаются,
// списания копятся для записи движений.
//
// Параметры:
//  Списания - Массив из Структура - Партия, Количество, Сумма, СуммаНДС, ЗаказГруппы; пополняется.
//  Стр      - СтрокаТаблицыЗначений - строка группы: Количество.
//  Партии   - Массив из СтрокаТаблицыЗначений - см. ДопустимыеПартии.
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ группы.
//  Нетто    - Соответствие - см. НеттоОстатков; уменьшается.
//
Процедура РазобратьПартии(Списания, Стр, Партии, Заказ, Нетто)
	КоличествоКСписанию = Стр.Количество;
	Для Каждого СтрПартия Из Партии Цикл
		Если КоличествоКСписанию = 0 Тогда
			Прервать;
		КонецЕсли;
		КлючНетто = КлючНеттоПартии(СтрПартия);
		Количество = Мин(КоличествоКСписанию, СтрПартия.Количество, Нетто[КлючНетто]);
		Если Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Нетто.Вставить(КлючНетто, Нетто[КлючНетто] - Количество);
		Сумма = ?(Количество = СтрПартия.Количество, СтрПартия.Сумма,
			Окр(СтрПартия.Сумма / СтрПартия.Количество * Количество, РазрядностьСуммы()));
		СуммаНДС = РегистрыНакопления.ТоварыВНаличии.ДоляСуммы(СтрПартия.СуммаНДС, Сумма, СтрПартия.Сумма);
		Партия = Новый Структура("Номенклатура, Характеристика, Серия, Партия, ДатаПартии, ПередачаВПереработку,
			|ЗаказПокупателя");
		ЗаполнитьЗначенияСвойств(Партия, СтрПартия);
		Списание = Новый Структура("Партия, Количество, Сумма, СуммаНДС, ЗаказГруппы");
		Списание.Партия = Партия;
		Списание.Количество = Количество;
		Списание.Сумма = Сумма;
		Списание.СуммаНДС = СуммаНДС;
		Списание.ЗаказГруппы = Заказ;
		Списания.Добавить(Списание);
		КоличествоКСписанию = КоличествоКСписанию - Количество;
		СтрПартия.Количество = СтрПартия.Количество - Количество;
		СтрПартия.Сумма = СтрПартия.Сумма - Сумма;
		СтрПартия.СуммаНДС = СтрПартия.СуммаНДС - СуммаНДС;
	КонецЦикла;
КонецПроцедуры

Процедура ОтразитьПередачу(ДокОбъект)
	// Приход в переработку повторяет расходы со склада по партиям; себестоимость партии
	// увеличивается на списанные с неё издержки (ДополнительныеРасходы).
	// Списание идёт по строкам (ТоварыВНаличии.СформироватьДвиженияПереработки): код строки расхода связывает партию с
	// заказом строки ТЧТовары, приход пишется по заказам строк (план subcontract-multi-order).
	Движения = ДокОбъект.Движения;
	ОтборРасход = Новый Структура("ВидДвижения", ВидДвиженияНакопления.Расход);
	КлючРасхода = "КодСтроки, Номенклатура, Характеристика, Серия, Партия, ДатаПартии";
	ТЗРасходы = Движения.ТоварыВНаличии.Выгрузить().Скопировать(ОтборРасход, КлючРасхода + ", Количество, Сумма, СуммаНДС");
	ТЗРасходы.Свернуть(КлючРасхода, "Количество, Сумма, СуммаНДС");
	ТЗРасходы.Сортировать("ДатаПартии");
	// У регистра издержек нет даты партии: ключ - без неё. Издержки ключа прибавляются к расходу с самой ранней датой
	// партии ровно один раз (поиск без даты прибавлял бы их к расходу каждой даты одной партии).
	КлючИздержек = "КодСтроки, Номенклатура, Характеристика, Серия, Партия";
	ТЗИздержки = Движения.ДополнительныеРасходы.Выгрузить().Скопировать(ОтборРасход, КлючИздержек + ", Сумма, СуммаНДС");
	ТЗИздержки.Свернуть(КлючИздержек, "Сумма, СуммаНДС");
	ЗаказыСтрок = ЗаказыСтрокПередачи(ДокОбъект);
	Для Каждого Стр Из ТЗРасходы Цикл
		Сумма = Стр.Сумма;
		СуммаНДС = Стр.СуммаНДС;
		Отбор = Новый Структура(КлючИздержек);
		ЗаполнитьЗначенияСвойств(Отбор, Стр);
		Для Каждого СтрИздержки Из ТЗИздержки.НайтиСтроки(Отбор) Цикл
			Сумма = Сумма + СтрИздержки.Сумма;
			СуммаНДС = СуммаНДС + СтрИздержки.СуммаНДС;
			ТЗИздержки.Удалить(СтрИздержки);
		КонецЦикла;
		Заказ = ЗаказыСтрок[Стр.КодСтроки];
		Партия = Новый Структура("Номенклатура, Характеристика, Серия, Партия, ДатаПартии");
		ЗаполнитьЗначенияСвойств(Партия, Стр);
		Партия.Вставить("ПередачаВПереработку", ДокОбъект.Ссылка);
		Партия.Вставить("ЗаказПокупателя", ?(Заказ = Неопределено, ЗаказыСтрок["Шапка"], Заказ));
		ДобавитьДвижение(ДокОбъект, ВидДвиженияНакопления.Приход, Партия, Стр.Количество, Сумма, СуммаНДС);
	КонецЦикла;
КонецПроцедуры

// Заказы строк ТЧТовары передачи по коду строки (см. ПроизводственныеЗаказы.ЗаказСтрокиПереработки) и заказ шапки -
// по ключу «Шапка»: расход с кодом, которого в строках нет, получает заказ шапки.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПередачаВПереработку - проводимая передача.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (код строки) или «Шапка», значение ДокументСсылка.ЗаказПокупателя.
//
Функция ЗаказыСтрокПередачи(ДокОбъект)
	ЗаказШапки = ПроизводственныеЗаказы.ЗаказШапкиПереработки(ДокОбъект);
	Результат = Новый Соответствие;
	Результат.Вставить("Шапка", ЗаказШапки);
	Для Каждого Строка Из ДокОбъект.ТЧТовары Цикл
		Результат.Вставить(Строка.КодСтроки, ПроизводственныеЗаказы.ЗаказСтрокиПереработки(Строка, ЗаказШапки));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ДобавитьДвижение(ДокОбъект, ВидДвижения, Партия, Количество, Сумма, СуммаНДС)
	// Партия - строка таблицы или структура с измерениями регистра (кроме контрагента).
	НС = ДокОбъект.Движения.ТоварыВПереработке.Добавить();
	НС.ВидДвижения = ВидДвижения;
	НС.Период = ДокОбъект.Дата;
	НС.Контрагент = ДокОбъект.Контрагент;
	ЗаполнитьЗначенияСвойств(НС, Партия,
		"Номенклатура, Характеристика, Серия, Партия, ДатаПартии, ПередачаВПереработку, ЗаказПокупателя");
	НС.Количество = Количество;
	НС.Сумма = Сумма;
	НС.СуммаНДС = СуммаНДС;
КонецПроцедуры

Функция ПередачаОснование(ДокОбъект)
	// Передача, партии которой списываются первыми; пустая ссылка - обычный FIFO.
	Если ТипЗнч(ДокОбъект.Основание) = Тип("ДокументСсылка.ПередачаВПереработку") Тогда
		Возврат ДокОбъект.Основание;
	КонецЕсли;
	Возврат Документы.ПередачаВПереработку.ПустаяСсылка();
КонецФункции

// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеИзПереработки - проводимый документ.
//  Стр       - СтрокаТаблицыЗначений - строка группы: Номенклатура, Характеристика, Серия, Количество.
//  Доступно  - Число - остаток партий, доступных группе, с учётом разобранного предыдущими группами.
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ группы; пустая ссылка - группа без заказа.
//
Процедура СообщитьОНедостаче(ДокОбъект, Стр, Доступно, Заказ)
	Шаблон = НСтр("ru = 'У переработчика «%1» недостаточно (%2): нужно %3, остаток %4, не хватает %5';
		|fr = 'Le sous-traitant « %1 » n''a pas assez de (%2) : requis %3, reste %4, manque %5';
		|en = 'Processor ""%1"" does not have enough (%2): required %3, in stock %4, short by %5';
		|es = 'El procesador «%1» no tiene suficiente (%2): necesario %3, existencia %4, faltan %5'");
	Представление = ОбщегоНазначенияКлиентСервер.ПредставлениеНоменклатуры(Стр.Номенклатура, Стр.Характеристика, Стр.Серия);
	Нужно = СокрЛП(Стр.Количество);
	Остаток = СокрЛП(Доступно);
	НеХватает = СокрЛП(Стр.Количество - Доступно);
	ТекстОшибки = СтрШаблон(Шаблон, ДокОбъект.Контрагент, Представление, Нужно, Остаток, НеХватает);
	Если ЗначениеЗаполнено(Заказ) Тогда
		// Без этой фразы «нужно 5, остаток 0» при полном складе у переработчика читается как ошибка программы,
		// и штатным обходом становится очистка основания документа.
		ШаблонЗаказа = НСтр("ru = ' Считаются партии заказа «%1» и партии без заказа; партии других заказов не берутся.';
			|fr = ' Seuls les lots de la commande « %1 » et les lots sans commande sont pris en compte.';
			|en = ' Only batches of order ""%1"" and batches without an order are used.';
			|es = ' Solo se usan los lotes del pedido «%1» y los lotes sin pedido.'");
		ТекстОшибки = ТекстОшибки + СтрШаблон(ШаблонЗаказа, Заказ);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокОбъект.Ссылка);
КонецПроцедуры

Функция РазрядностьСуммы()
	Возврат 2;
КонецФункции

#КонецОбласти
