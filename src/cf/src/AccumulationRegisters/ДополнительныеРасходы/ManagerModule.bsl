
#Область Формирование_движений

// Распределение допрасходов документа на партии.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - поступление, реализация, документ допрасходов, уценка
//  Отказ     - Булево - выставляется документом допрасходов, у строки которого нет базы распределения, и при ордере
//              не раньше документа (Ф3.9); прочие документы его не меняют
//
Процедура РаспределитьНаСебестоимость(ДокОбъект, Отказ = Ложь) Экспорт
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеДополнительныхРасходов") Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ТЧТовары.Номенклатура КАК Номенклатура,
		                      |	ТЧТовары.Характеристика КАК Характеристика,
		                      |	ТЧТовары.Серия КАК Серия,
		                      |	ТЧТовары.ДокументПартии КАК Партия,
		                      |	ТЧТовары.СтатьяДДС КАК СтатьяДДС,
		                      |	СУММА(ВЫБОР
		                      |			КОГДА ТЧТовары.Ссылка.ЦенаВключаетНДС
		                      |				ТОГДА ТЧТовары.Сумма
		                      |			ИНАЧЕ ТЧТовары.Сумма + ТЧТовары.СуммаНДС
		                      |		КОНЕЦ) КАК Сумма,
		                      |	СУММА(ТЧТовары.СуммаНДС) КАК СуммаНДС
		                      |ПОМЕСТИТЬ ВТ
		                      |ИЗ
		                      |	Документ.ПоступлениеДополнительныхРасходов.ТЧТовары КАК ТЧТовары
		                      |ГДЕ
		                      |	ТЧТовары.Ссылка = &Док
		                      |
		                      |СГРУППИРОВАТЬ ПО
		                      |	ТЧТовары.Номенклатура,
		                      |	ТЧТовары.Характеристика,
		                      |	ТЧТовары.Серия,
		                      |	ТЧТовары.ДокументПартии,
		                      |	ТЧТовары.СтатьяДДС
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ
		                      |	ВТ.Номенклатура КАК Номенклатура,
		                      |	ВТ.Характеристика КАК Характеристика,
		                      |	ВТ.Серия КАК Серия,
		                      |	ВТ.Партия КАК Партия,
		                      |	ВТ.СтатьяДДС КАК СтатьяДДС,
		                      |	ВТ.Сумма КАК Сумма,
		                      |	ВТ.СуммаНДС КАК СуммаНДС
		                      |ИЗ
		                      |	ВТ КАК ВТ");
		Запрос.УстановитьПараметр("Док", ДокОбъект.Ссылка);
		ТЗДополнительныеРасходы = Запрос.Выполнить().Выгрузить();
		ДокументыПартий = ТЗДополнительныеРасходы.ВыгрузитьКолонку("Партия");
		ТЗТовары = БазаДокументаДопрасходов(ДокОбъект, ДокументыПартий, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		РаспределитьПоПозициям(ДокОбъект, ТЗТовары, ТЗДополнительныеРасходы, Отказ, ОрдерныеПартии(ДокументыПартий));
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.УценкаТоваров") Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ТЧТовары.Номенклатура КАК Номенклатура,
		                      |	ТЧТовары.Характеристика КАК Характеристика,
		                      |	ТЧТовары.Серия КАК Серия,
		                      |	ТЧТовары.ЦенаНовая КАК Цена,
		                      |	ТЧТовары.Ссылка.МестоХранения КАК МестоХранения,
		                      |	ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.УценкаТоваров) КАК СтатьяДДС
		                      |ПОМЕСТИТЬ ВТ
		                      |ИЗ
		                      |	Документ.УценкаТоваров.ТЧТовары КАК ТЧТовары
		                      |ГДЕ
		                      |	ТЧТовары.Ссылка = &Док
		                      |
		                      |СГРУППИРОВАТЬ ПО
		                      |	ТЧТовары.Номенклатура,
		                      |	ТЧТовары.Характеристика,
		                      |	ТЧТовары.ЦенаНовая,
		                      |	ТЧТовары.Серия,
		                      |	ТЧТовары.Ссылка.МестоХранения
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ
		                      |	ТоварыВНаличииОстатки.МестоХранения КАК МестоХранения,
		                      |	ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
		                      |	ТоварыВНаличииОстатки.Характеристика КАК Характеристика,
		                      |	ТоварыВНаличииОстатки.Серия КАК Серия,
		                      |	ТоварыВНаличииОстатки.Партия КАК Партия,
		                      |	ТоварыВНаличииОстатки.КоличествоОстаток КАК Количество,
		                      |	ТоварыВНаличииОстатки.СуммаОстаток КАК Сумма
		                      |ИЗ
		                      |	РегистрНакопления.ТоварыВНаличии.Остатки(
		                      |			&Дата,
		                      |			(МестоХранения, Номенклатура, Характеристика, Серия) В
		                      |				(ВЫБРАТЬ
		                      |					ВТ.МестоХранения,
		                      |					ВТ.Номенклатура,
		                      |					ВТ.Характеристика,
		                      |					ВТ.Серия
		                      |				ИЗ
		                      |					ВТ)) КАК ТоварыВНаличииОстатки
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ
		                      |	ВТ.Номенклатура КАК Номенклатура,
		                      |	ВТ.Характеристика КАК Характеристика,
		                      |	ВТ.Серия КАК Серия,
		                      |	ТоварыВНаличииОстатки.КоличествоОстаток * ВТ.Цена - ЕСТЬNULL(ТоварыВНаличииОстатки.СуммаОстаток, 0) - ЕСТЬNULL(ДополнительныеРасходыОстатки.СуммаОстаток, 0) КАК Сумма,
		                      |	ВТ.СтатьяДДС КАК СтатьяДДС
		                      |ИЗ
		                      |	ВТ КАК ВТ
		                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВНаличии.Остатки(
		                      |				&Дата,
		                      |				(МестоХранения, Номенклатура, Характеристика, Серия) В
		                      |					(ВЫБРАТЬ
		                      |						ВТПозиции.МестоХранения КАК МестоХранения,
		                      |						ВТПозиции.Номенклатура КАК Номенклатура,
		                      |						ВТПозиции.Характеристика КАК Характеристика,
		                      |						ВТПозиции.Серия КАК Серия
		                      |					ИЗ
		                      |						ВТ КАК ВТПозиции)) КАК ТоварыВНаличииОстатки
		                      |		ПО ВТ.Номенклатура = ТоварыВНаличииОстатки.Номенклатура
		                      |			И ВТ.Характеристика = ТоварыВНаличииОстатки.Характеристика
		                      |			И ВТ.Серия = ТоварыВНаличииОстатки.Серия
		                      |			И ВТ.МестоХранения = ТоварыВНаличииОстатки.МестоХранения
		                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДополнительныеРасходы.Остатки(
		                      |				&Дата,
		                      |				(МестоХранения, Номенклатура, Характеристика, Серия) В
		                      |					(ВЫБРАТЬ
		                      |						ВТПозиции.МестоХранения КАК МестоХранения,
		                      |						ВТПозиции.Номенклатура КАК Номенклатура,
		                      |						ВТПозиции.Характеристика КАК Характеристика,
		                      |						ВТПозиции.Серия КАК Серия
		                      |					ИЗ
		                      |						ВТ КАК ВТПозиции)) КАК ДополнительныеРасходыОстатки
		                      |		ПО ВТ.Номенклатура = ДополнительныеРасходыОстатки.Номенклатура
		                      |			И ВТ.Характеристика = ДополнительныеРасходыОстатки.Характеристика
		                      |			И ВТ.Серия = ДополнительныеРасходыОстатки.Серия
		                      |			И ВТ.МестоХранения = ДополнительныеРасходыОстатки.МестоХранения");
		Запрос.УстановитьПараметр("Док", ДокОбъект.Ссылка);
		Запрос.УстановитьПараметр("Дата", РаботаСДокументамиВызовСервера.ПолучитьГраницуДокумента(ДокОбъект));
		Рез = Запрос.ВыполнитьПакет();
		ТЗТовары = Рез[1].Выгрузить();
		ТЗДополнительныеРасходы = Рез[2].Выгрузить();
		РаспределитьПоПозициям(ДокОбъект, ТЗТовары, ТЗДополнительныеРасходы);
	Иначе
		ТЗДополнительныеРасходы = ДопрасходыДокументаВОсновнойВалюте(ДокОбъект);
		ТЗТовары = ДокОбъект.Движения.ТоварыВНаличии.Выгрузить();
		РаспределитьПоПозициям(ДокОбъект, ТЗТовары, ТЗДополнительныеРасходы);
	КонецЕсли;
КонецПроцедуры

// Допрасходы табличной части документа (поступления, реализации) с суммой с НДС в колонке Сумма; у поступления - в
// основной валюте (себестоимость партий - в основной).
//
// Параметры:
//  ДокОбъект - ДокументОбъект, ДокументСсылка - поступление или реализация
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки ТЧДополнительныеРасходы
//
Функция ДопрасходыДокументаВОсновнойВалюте(ДокОбъект) Экспорт
	ТЗДополнительныеРасходы = ДокОбъект.ТЧДополнительныеРасходы.Выгрузить();
	Если ТЗДополнительныеРасходы.Колонки.Найти("СуммаСНДС") <> Неопределено Тогда
		ТЗДополнительныеРасходы.Колонки.Удалить("Сумма");
		ТЗДополнительныеРасходы.Колонки.СуммаСНДС.Имя = "Сумма";
	КонецЕсли;
	// Доп. расходы поступления - в валюте документа, себестоимость партий - в основной валюте.
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг")
		Или ТипЗнч(ДокОбъект) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		РаботаСВалютами.ПересчитатьКолонкиВОсновнуюВалюту(ТЗДополнительныеРасходы,
			РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс, "Сумма, СуммаНДС");
	КонецЕсли;
	Возврат ТЗДополнительныеРасходы;
КонецФункции

Процедура ДобавитьПриход(Движения, ДатаДвижения, МестоХранения, Номенклатура, Характеристика, Серия, Партия, СтатьяДДС, Сумма,
		СуммаНДС = 0, КодСтроки = 0) Экспорт
	Если Сумма = 0 Тогда Возврат КонецЕсли;
	НС = Движения.ДополнительныеРасходы.ДобавитьПриход();
	НС.Период = ДатаДвижения;
	НС.МестоХранения = МестоХранения;
	НС.Номенклатура = Номенклатура;
	НС.Характеристика = Характеристика;
	НС.Серия = Серия;
	НС.Партия = Партия;
	НС.СтатьяДДС = СтатьяДДС;
	НС.Сумма = Сумма;
	НС.СуммаНДС = СуммаНДС;
	НС.КодСтроки = КодСтроки;
КонецПроцедуры

Процедура ДобавитьРасход(Движения, ДатаДвижения, МестоХранения, Номенклатура, Характеристика, Серия, Партия, СтатьяДДС, Сумма,
		СуммаНДС = 0, Комплект = Неопределено, КодСтроки = 0) Экспорт
	Если Сумма = 0 Тогда Возврат КонецЕсли;
	НС = Движения.ДополнительныеРасходы.ДобавитьРасход();
	НС.Период = ДатаДвижения;
	НС.МестоХранения = МестоХранения;
	НС.Номенклатура = Номенклатура;
	НС.Характеристика = Характеристика;
	НС.Серия = Серия;
	НС.Партия = Партия;
	НС.СтатьяДДС = СтатьяДДС;
	НС.Сумма = Сумма;
	НС.СуммаНДС = СуммаНДС;
	Если Комплект <> Неопределено Тогда
		НС.Комплект = Комплект;
	КонецЕсли;
	НС.КодСтроки = КодСтроки;
КонецПроцедуры

#КонецОбласти

#Область Дополнительно

// Распределение строк допрасходов по позициям (партиям) и запись движений: приход, у реализации - и расход.
//
// Параметры:
//  ДокОбъект               - ДокументОбъект - документ
//  ТЗТовары                - ТаблицаЗначений - база: МестоХранения, Номенклатура, Характеристика, Серия, Партия,
//                            Количество, Сумма; при наличии - КодСтроки, ДокументПартии
//  ТЧДополнительныеРасходы - ТаблицаЗначений - строки допрасходов
//  Отказ                   - Булево - выставляется, если у строки допрасходов нет базы (только когда передан)
//  Строгие                 - Соответствие, Неопределено - документы партий ордерной схемы (см. ОрдерныеПартии)
//
Процедура РаспределитьПоПозициям(ДокОбъект, ТЗТовары, ТЧДополнительныеРасходы, Отказ = Неопределено,
		Строгие = Неопределено) Экспорт
	ЭтоРеализация = ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг");
	Части = РаспределениеПоСтрокам(ТЗТовары, ТЧДополнительныеРасходы, Строгие);
	Если Отказ <> Неопределено И Части.БезБазы.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Допрасход «%1» (%2): нет партий, на которые его распределить, - партия не проведена или в ней нет этого товара.';
			|fr = 'Frais « %1 » (%2) : aucun lot sur lequel le répartir - le lot n''est pas validé ou ne contient pas cet article.';
			|en = 'Additional cost «%1» (%2): no batches to allocate it to - the batch is not posted or lacks this item.';
			|es = 'Gasto «%1» (%2): no hay lotes donde repartirlo - el lote no está contabilizado o no tiene este artículo.'");
		Для Каждого СтрДопРасход Из Части.БезБазы Цикл
			Позиция = ?(ЗначениеЗаполнено(СтрДопРасход.Номенклатура), СтрДопРасход.Номенклатура, СтрДопРасход.Партия);
			Текст = СтрШаблон(Шаблон, СтрДопРасход.СтатьяДДС, Позиция);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, ДокОбъект, , , Отказ);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	Нераспределено = 0;
	Для Каждого Часть Из Части.Части Цикл
		// Неоформленная часть строки поступления (документ первый, Ф4.8) ждёт приёмки: не пишется.
		Если Не ЗначениеЗаполнено(Часть.Партия) Тогда
			Нераспределено = Нераспределено + Часть.Сумма;
			Продолжить;
		КонецЕсли;
		ДобавитьПриход(ДокОбъект.Движения, Макс(ДокОбъект.Дата, Часть.ДатаПартии), Часть.МестоХранения, Часть.Номенклатура,
			Часть.Характеристика, Часть.Серия, Часть.Партия, Часть.СтатьяДДС, Часть.Сумма, Часть.СуммаНДС, Часть.КодСтроки);
		Если ЭтоРеализация Тогда
			ДобавитьРасход(ДокОбъект.Движения, ДокОбъект.Дата, Часть.МестоХранения, Часть.Номенклатура, Часть.Характеристика,
				Часть.Серия, Часть.Партия, Часть.СтатьяДДС, Часть.Сумма, Часть.СуммаНДС, , Часть.КодСтроки);
		КонецЕсли;
	КонецЦикла;
	Если Нераспределено <> 0 Тогда
		Шаблон = НСтр("ru = 'Часть допрасходов (%1) ждёт приёмки товара ордером: распределится при пересчёте себестоимости после приёмки.';
			|fr = 'Une partie des frais (%1) attend la réception par bon : elle sera répartie au recalcul du coût après réception.';
			|en = 'Part of the additional costs (%1) waits for receipt by order: it is allocated by cost recalculation after receipt.';
			|es = 'Parte de los gastos (%1) espera la recepción por orden: se repartirá al recalcular el coste tras la recepción.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Формат(Нераспределено, "ЧДЦ=2")), ДокОбъект);
	КонецЕсли;
КонецПроцедуры

// Распределение строк допрасходов по базе без записи движений (план warehouse-orders-cost, Ф3.3, Ф3.9): база строки -
// позиции её номенклатуры и характеристики (или все, если номенклатура не указана); у документа допрасходов (база с
// колонкой ДокументПартии) строка партии ордерной схемы берёт только позиции своего документа партии, прочие строки -
// позиции без документа (прежние партии, как раньше). Доли - по сумме позиций, при нулевой сумме - по количеству, при
// обоих нулях - всё последней позиции; остаток округления - последней позиции. НДС - той же пропорцией.
//
// Параметры:
//  ТЗТовары                - ТаблицаЗначений - база (см. РаспределитьПоПозициям)
//  ТЧДополнительныеРасходы - ТаблицаЗначений - строки допрасходов (Номенклатура и Характеристика - если есть, СтатьяДДС,
//                            Сумма, СуммаНДС - если есть)
//  Строгие                 - Соответствие, Неопределено - документы партий ордерной схемы: строка без базы по ним -
//                            в БезБазы, по прочим - пропускается молча, как раньше
//
// Возвращаемое значение:
//  Структура:
//   * Части   - ТаблицаЗначений - МестоХранения, Номенклатура, Характеристика, Серия, Партия, КодСтроки, СтатьяДДС,
//               Сумма, СуммаНДС
//   * БезБазы - Массив из СтрокаТаблицыЗначений - строки допрасходов с ненулевой суммой без базы
//
Функция РаспределениеПоСтрокам(ТЗТовары, ТЧДополнительныеРасходы, Строгие = Неопределено) Экспорт
	Части = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("МестоХранения,Номенклатура,Характеристика,Серия,Партия,КодСтроки,СтатьяДДС", ",") Цикл
		Части.Колонки.Добавить(Имя);
	КонецЦикла;
	Части.Колонки.Добавить("ДатаПартии", Новый ОписаниеТипов("Дата"));
	Части.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	Части.Колонки.Добавить("СуммаНДС", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	БезБазы = Новый Массив;
	ЕстьКод = ТЗТовары.Колонки.Найти("КодСтроки") <> Неопределено;
	ЕстьДата = ТЗТовары.Колонки.Найти("ДатаПартии") <> Неопределено;
	ПоДокументу = ТЗТовары.Колонки.Найти("ДокументПартии") <> Неопределено
		И ТЧДополнительныеРасходы.Колонки.Найти("Партия") <> Неопределено;
	ЕстьНоменклатура = ТЧДополнительныеРасходы.Колонки.Найти("Номенклатура") <> Неопределено;
	ЕстьНДС = ТЧДополнительныеРасходы.Колонки.Найти("СуммаНДС") <> Неопределено;
	Для Каждого СтрДопРасход Из ТЧДополнительныеРасходы Цикл
		Отбор = Новый Структура;
		Если ЕстьНоменклатура И ЗначениеЗаполнено(СтрДопРасход.Номенклатура) Тогда
			Отбор.Вставить("Номенклатура", СтрДопРасход.Номенклатура);
			Отбор.Вставить("Характеристика", СтрДопРасход.Характеристика);
		КонецЕсли;
		Строгая = ПоДокументу И Строгие <> Неопределено И Строгие[СтрДопРасход.Партия] <> Неопределено;
		Если ПоДокументу Тогда
			Отбор.Вставить("ДокументПартии", ?(Строгая, СтрДопРасход.Партия, Неопределено));
		КонецЕсли;
		МасТовары = ?(Отбор.Количество() = 0, ТЗТовары, ТЗТовары.НайтиСтроки(Отбор));
		Если МасТовары.Количество() = 0 Тогда
			Если Строгая И СтрДопРасход.Сумма <> 0 Тогда
				БезБазы.Добавить(СтрДопРасход);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Базы = Новый Массив;
		СуммаТоваров = 0;
		Для Каждого Стр Из МасТовары Цикл
			Базы.Добавить(Стр.Сумма);
			СуммаТоваров = СуммаТоваров + Стр.Сумма;
		КонецЦикла;
		Если СуммаТоваров = 0 Тогда
			// Нулевая база (неподтверждённые партии приходного ордера) - по количеству.
			Базы.Очистить();
			Для Каждого Стр Из МасТовары Цикл
				Базы.Добавить(Стр.Количество);
			КонецЦикла;
		КонецЕсли;
		НДСИздержки = ?(ЕстьНДС, СтрДопРасход.СуммаНДС, 0);
		Суммы = ДолиСОстаткомПоследней(Базы, СтрДопРасход.Сумма);
		НДС = ДолиСОстаткомПоследней(Базы, НДСИздержки);
		Для Индекс = 0 По МасТовары.Количество() - 1 Цикл
			Стр = МасТовары[Индекс];
			Часть = Части.Добавить();
			ЗаполнитьЗначенияСвойств(Часть, Стр, "МестоХранения, Номенклатура, Характеристика, Серия, Партия");
			ЗаполнитьКлючЧасти(Часть, Стр, ЕстьКод, ЕстьДата);
			Часть.СтатьяДДС = СтрДопРасход.СтатьяДДС;
			Часть.Сумма = Суммы[Индекс];
			Часть.СуммаНДС = НДС[Индекс];
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Части, БезБазы", Части, БезБазы);
КонецФункции

Процедура ЗаполнитьКлючЧасти(Часть, Строка, ЕстьКод, ЕстьДата)
	Часть.КодСтроки = ?(ЕстьКод, Строка.КодСтроки, 0);
	Если ЕстьДата Тогда
		Часть.ДатаПартии = Строка.ДатаПартии;
	КонецЕсли;
КонецПроцедуры

// Доли итога по базам: каждой, кроме последней, - Окр(итог × база / сумма баз, 2), последней - остаток; сумма баз 0 -
// всё последней (как прежнее распределение допрасходов).
//
// Параметры:
//  Базы - Массив из Число - базы
//  Итог - Число - распределяемая сумма
//
// Возвращаемое значение:
//  Массив из Число - доли в порядке баз
//
Функция ДолиСОстаткомПоследней(Базы, Итог)
	Доли = Новый Массив;
	СуммаБаз = 0;
	Для Каждого База Из Базы Цикл
		СуммаБаз = СуммаБаз + База;
	КонецЦикла;
	Остаток = Итог;
	Для Индекс = 0 По Базы.ВГраница() Цикл
		Если Индекс = Базы.ВГраница() Тогда
			Доля = Остаток;
		ИначеЕсли СуммаБаз = 0 Тогда
			Доля = 0;
		Иначе
			Доля = Окр(Итог / СуммаБаз * Базы[Индекс], 2);
		КонецЕсли;
		Доли.Добавить(Доля);
		Остаток = Остаток - Доля;
	КонецЦикла;
	Возврат Доли;
КонецФункции

// База распределения документа допрасходов (план warehouse-orders-cost, Ф3.9) по документам партий его строк:
// поступление неордерного склада и прочие документы - их записи прихода ТоварыВНаличии, как раньше; поступление
// ордерного склада - партии-ордера его пар (стоимость пары - стоимость строки поступления); приходный ордер - его
// записи прихода. Ордер партии должен быть раньше документа допрасходов - иначе отказ.
//
// Параметры:
//  ДокОбъект       - ДокументОбъект.ПоступлениеДополнительныхРасходов - документ
//  ДокументыПартий - Массив - документы партий строк
//  Отказ           - Булево - выставляется при ордере не раньше документа
//
// Возвращаемое значение:
//  ТаблицаЗначений - МестоХранения, Номенклатура, Характеристика, Серия, Партия, КодСтроки, Количество, Сумма,
//                    ДокументПартии
//
Функция БазаДокументаДопрасходов(ДокОбъект, ДокументыПартий, Отказ) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТоварыВНаличии.МестоХранения КАК МестоХранения,
	                      |	ТоварыВНаличии.Номенклатура КАК Номенклатура,
	                      |	ТоварыВНаличии.Характеристика КАК Характеристика,
	                      |	ТоварыВНаличии.Серия КАК Серия,
	                      |	ТоварыВНаличии.Партия КАК Партия,
	                      |	ТоварыВНаличии.КодСтроки КАК КодСтроки,
	                      |	ТоварыВНаличии.Количество КАК Количество,
	                      |	ТоварыВНаличии.Сумма КАК Сумма,
	                      |	ВЫБОР
	                      |		КОГДА ТоварыВНаличии.Регистратор ССЫЛКА Документ.ПриходныйОрдер
	                      |			ТОГДА ТоварыВНаличии.Регистратор
	                      |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	                      |	КОНЕЦ КАК ДокументПартии
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВНаличии КАК ТоварыВНаличии
	                      |ГДЕ
	                      |	ТоварыВНаличии.Регистратор В(&Документы)
	                      |	И ТоварыВНаличии.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	                      |	И ТоварыВНаличии.Активность");
	Запрос.УстановитьПараметр("Документы", ДокументыПартий);
	База = Запрос.Выполнить().Выгрузить();
	// Поступления ордерного склада: партии - ордера их пар.
	Поступления = Новый Массив;
	Для Каждого Документ Из ДокументыПартий Цикл
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") И Поступления.Найти(Документ) = Неопределено Тогда
			Поступления.Добавить(Документ);
		КонецЕсли;
	КонецЦикла;
	Если Поступления.Количество() > 0 Тогда
		База.Колонки.Добавить("ДатаПартии", Новый ОписаниеТипов("Дата"));
		// С неоформленным остатком строк (документ первый, Ф4.8): его доля не распределяется до приёмки.
		Для Каждого Строка Из ОрдераСклада.БазаПартийОрдеровПоступлений(Поступления, Истина) Цикл
			ЗаполнитьЗначенияСвойств(База.Добавить(), Строка);
		КонецЦикла;
	КонецЕсли;
	// Ордер партии, указанный прямо, - раньше документа допрасходов (Ф3.9, Редакция 35); через поступление - поздняя
	// приёмка допустима, запись ложится датой приёмки (Ф4.8, Редакция 39).
	Момент = ДокОбъект.МоментВремени();
	Проверенные = Новый Соответствие;
	Шаблон = НСтр("ru = 'Приходный ордер %1 не раньше документа допрасходов: допрасход раньше приёмки ордером.';
		|fr = 'Le bon d''entrée %1 n''est pas antérieur au document de frais : frais antérieurs à la réception.';
		|en = 'Receipt order %1 is not earlier than the additional cost document: the cost precedes the receipt.';
		|es = 'La orden de entrada %1 no es anterior al documento de gastos: el gasto precede a la recepción.'");
	Для Каждого Строка Из База Цикл
		Если ТипЗнч(Строка.ДокументПартии) <> Тип("ДокументСсылка.ПриходныйОрдер") Или Проверенные[Строка.Партия] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Проверенные.Вставить(Строка.Партия, Истина);
		МоментОрдера = Новый МоментВремени(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Партия, "Дата"), Строка.Партия);
		Если МоментОрдера.Сравнить(Момент) >= 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Шаблон, Строка.Партия), ДокОбъект, , , Отказ);
		КонецЕсли;
	КонецЦикла;
	Возврат База;
КонецФункции

// Документы партий ордерной схемы среди документов партий строк допрасходов (Ф3.9): приходные ордера и поступления на
// складе, ордерном на дату поступления. Для них база строгая: только своя партия, нет базы - отказ.
//
// Параметры:
//  ДокументыПартий - Массив - документы партий строк
//
// Возвращаемое значение:
//  Соответствие - документ -> Истина
//
Функция ОрдерныеПартии(ДокументыПартий) Экспорт
	Результат = Новый Соответствие;
	Поступления = Новый Массив;
	Для Каждого Документ Из ДокументыПартий Цикл
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПриходныйОрдер") Тогда
			Результат.Вставить(Документ, Истина);
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			Поступления.Добавить(Документ);
		КонецЕсли;
	КонецЦикла;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Поступления, "МестоХранения, Дата");
	Для Каждого Элемент Из Реквизиты Цикл
		Если Справочники.МестаХранения.ОрдерныйСклад(Элемент.Значение.МестоХранения, Элемент.Значение.Дата) Тогда
			Результат.Вставить(Элемент.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
