// Привилегированный режим - осознанно: физический регистр пишет зеркало и читает сверка, права записи ролям не
// выдаются (ворота - право записи ТоварыВНаличии). BSLLS:SetPrivilegedMode-off

#Область ПрограммныйИнтерфейс

// Физическое количество по складам (план docs/plans/warehouse-orders.md, фаза 1). Регистр пишет только зеркало
// набора ТоварыВНаличии: одна свёртка для зеркала, защитной перестройки и обработчика обновления, поэтому на
// неордерном складе остатки двух регистров равны всегда, на любую дату.

// Свёртка записей ТоварыВНаличии в физические движения: по периоду, виду движения, активности и физическим
// измерениям, без партий и сумм. Строки с нулевым количеством отбрасываются - на остатки они не влияют.
//
// Параметры:
//  Записи      - ТаблицаЗначений - записи регистра ТоварыВНаличии (Выгрузить() набора или выборка запроса) с колонками
//                Период, ВидДвижения, Активность, МестоХранения, Номенклатура, Характеристика, Серия, Количество.
//  Регистратор - ДокументСсылка - регистратор записей.
//
// Возвращаемое значение:
//  ТаблицаЗначений - записи для Загрузить() набора ТоварыНаСкладах (те же колонки и Регистратор).
//
Функция ФизическиеДвижения(Записи, Регистратор) Экспорт

	ПоляГруппировки = "Период, ВидДвижения, Активность, МестоХранения, Номенклатура, Характеристика, Серия";
	Результат = Записи.Скопировать(, ПоляГруппировки + ", Количество");
	// Точка расширения фазы 2: записи поступления и реализации на складе, ордерном на дату документа, сюда не
	// попадают - их физическую сторону делает ордер.
	Результат.Свернуть(ПоляГруппировки, "Количество");
	Нулевые = Результат.НайтиСтроки(Новый Структура("Количество", 0));
	Для Каждого Строка Из Нулевые Цикл
		Результат.Удалить(Строка);
	КонецЦикла;
	Результат.Колонки.Добавить("Регистратор");
	Результат.ЗаполнитьЗначения(Регистратор, "Регистратор");
	Возврат Результат;

КонецФункции

// Зеркало: набор ТоварыНаСкладах того же регистратора получает свёртку записываемого набора ТоварыВНаличии в том
// же режиме замещения. Вызывается из ПриЗаписи набора ТоварыВНаличии при любой записи, в том числе при загрузке
// данных: это согласованность регистров, а не прикладная логика. Права на запись физического регистра у ролей нет -
// его ворота право записи ТоварыВНаличии.
//
// Параметры:
//  НаборТоваров - РегистрНакопленияНаборЗаписей.ТоварыВНаличии - записанный набор.
//  Замещение    - Булево - режим записи набора ТоварыВНаличии.
//
Процедура ЗаписатьЗеркало(НаборТоваров, Замещение) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Регистратор = НаборТоваров.Отбор.Регистратор.Значение;
	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Загрузить(ФизическиеДвижения(НаборТоваров.Выгрузить(), Регистратор));
	Набор.ОбменДанными.Загрузка = НаборТоваров.ОбменДанными.Загрузка;
	Набор.ДополнительныеСвойства.Вставить(ИмяСвойстваЗеркала(), Истина);
	Набор.Записать(Замещение);

КонецПроцедуры

// Защита от постороннего писателя (ПередЗаписью набора ТоварыНаСкладах): запись не зеркалом у регистратора, чьи
// движения склада ведёт ТоварыВНаличии, заменяется свёрткой его записей ТоварыВНаличии, уже лежащих в базе. Так
// пустой набор документа (автоудаление движений, общая очистка наборов) не затирает зеркало ни при каком порядке
// записи наборов: записан раньше ТоварыВНаличии - зеркало затем перезапишет, позже - перестроится из записанного.
//
// Параметры:
//  Набор     - РегистрНакопленияНаборЗаписей.ТоварыНаСкладах - записываемый набор.
//  Замещение - Булево - режим записи.
//
Процедура ПерестроитьНаборНеЗеркала(Набор, Замещение) Экспорт

	Регистратор = Набор.Отбор.Регистратор.Значение;
	Если Не ДвиженияВедетТоварыВНаличии(Регистратор) Тогда
		Возврат;
	КонецЕсли;
	Если Не Замещение Тогда
		ВызватьИсключение НСтр("ru = 'Движения регистра ""Товары на складах"" документа пишет только зеркало ""Товаров в наличии"".';
			|fr = 'Les mouvements du registre « Marchandises en entrepôt » du document sont écrits uniquement par le miroir des « Produits en stock ».';
			|en = 'Document records of the ""Goods in warehouses"" register are written only by the mirror of ""Products in stock"".';
			|es = 'Los movimientos del registro «Mercancías en almacenes» del documento solo los escribe el espejo de «Productos en stock».'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Набор.Загрузить(ФизическиеДвижения(ЗаписиТоваровВНаличии(Регистратор), Регистратор));

КонецПроцедуры

// Имя дополнительного свойства набора, которым зеркало помечает свою запись.
//
// Возвращаемое значение:
//  Строка - имя свойства.
//
Функция ИмяСвойстваЗеркала() Экспорт
	Возврат "ЗеркалоТоваровВНаличии";
КонецФункции

// Ведёт ли регистратор движения склада через ТоварыВНаличии - тогда его набор ТоварыНаСкладах принадлежит зеркалу.
//
// Параметры:
//  Регистратор - ДокументСсылка - регистратор.
//
// Возвращаемое значение:
//  Булево - Истина, если в движениях документа есть регистр ТоварыВНаличии.
//
Функция ДвиженияВедетТоварыВНаличии(Регистратор) Экспорт
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(Регистратор));
	Возврат МетаданныеДокумента <> Неопределено
		И МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ТоварыВНаличии);
КонецФункции

// Записи ТоварыВНаличии регистраторов из базы в колонках свёртки - для перестройки зеркала и обработчика обновления
// (порция регистраторов читается одним запросом).
//
// Параметры:
//  Регистратор - ДокументСсылка, Массив из ДокументСсылка - регистратор или порция регистраторов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. ФизическиеДвижения, параметр Записи; плюс колонка Регистратор.
//
Функция ЗаписиТоваровВНаличии(Регистратор) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Записи.Регистратор КАК Регистратор,
	|	Записи.Период КАК Период,
	|	Записи.ВидДвижения КАК ВидДвижения,
	|	Записи.Активность КАК Активность,
	|	Записи.МестоХранения КАК МестоХранения,
	|	Записи.Номенклатура КАК Номенклатура,
	|	Записи.Характеристика КАК Характеристика,
	|	Записи.Серия КАК Серия,
	|	Записи.Количество КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи
	|ГДЕ
	|	Записи.Регистратор В (&Регистратор)");
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Расхождения инварианта фазы 1 по записям: свёртка записей ТоварыВНаличии по регистратору, точному периоду, виду
// движения, активности и физическим измерениям равна записям ТоварыНаСкладах того же регистратора. Сверка по
// записям, а не по остаткам: ловит и перенос движения внутри месяца, и чужого регистратора, и потерю неактивной
// записи (ПоследующиеДвиженияПродукции читает точные периоды и исключает регистраторов). Регистраторы, движения
// которых ведёт не ТоварыВНаличии (ордера, фаза 2), в сверку не входят.
//
// Параметры:
//  Склады       - Массив из СправочникСсылка.МестаХранения, Неопределено - ограничить складами; Неопределено - все.
//  Регистраторы - Массив из ДокументСсылка, Неопределено - ограничить регистраторами; Неопределено - все.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Регистратор, Период, ВидДвижения, Активность, МестоХранения, Номенклатура, Характеристика,
//                    Серия, Разница (партии минус физика). Пустая таблица - инвариант держится.
//
Функция РасхожденияСТоварамиВНаличии(Склады = Неопределено, Регистраторы = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Условия = Новый Массив;
	Если Склады <> Неопределено Тогда
		Условия.Добавить("Записи.МестоХранения В (&Склады)");
	КонецЕсли;
	Если Регистраторы <> Неопределено Тогда
		Условия.Добавить("Записи.Регистратор В (&Регистраторы)");
	КонецЕсли;
	ТекстУсловия = ?(Условия.Количество() = 0, "ИСТИНА", СтрСоединить(Условия, " И "));
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сверка.Регистратор КАК Регистратор,
	|	Сверка.Период КАК Период,
	|	Сверка.ВидДвижения КАК ВидДвижения,
	|	Сверка.Активность КАК Активность,
	|	Сверка.МестоХранения КАК МестоХранения,
	|	Сверка.Номенклатура КАК Номенклатура,
	|	Сверка.Характеристика КАК Характеристика,
	|	Сверка.Серия КАК Серия,
	|	СУММА(Сверка.Количество) КАК Разница
	|ИЗ
	|	(ВЫБРАТЬ
	|		Записи.Регистратор КАК Регистратор,
	|		Записи.Период КАК Период,
	|		Записи.ВидДвижения КАК ВидДвижения,
	|		Записи.Активность КАК Активность,
	|		Записи.МестоХранения КАК МестоХранения,
	|		Записи.Номенклатура КАК Номенклатура,
	|		Записи.Характеристика КАК Характеристика,
	|		Записи.Серия КАК Серия,
	|		Записи.Количество КАК Количество
	|	ИЗ
	|		РегистрНакопления.ТоварыВНаличии КАК Записи
	|	ГДЕ
	|		&Условие
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Записи.Регистратор,
	|		Записи.Период,
	|		Записи.ВидДвижения,
	|		Записи.Активность,
	|		Записи.МестоХранения,
	|		Записи.Номенклатура,
	|		Записи.Характеристика,
	|		Записи.Серия,
	|		-Записи.Количество
	|	ИЗ
	|		РегистрНакопления.ТоварыНаСкладах КАК Записи
	|	ГДЕ
	|		&Условие) КАК Сверка
	|
	|СГРУППИРОВАТЬ ПО
	|	Сверка.Регистратор,
	|	Сверка.Период,
	|	Сверка.ВидДвижения,
	|	Сверка.Активность,
	|	Сверка.МестоХранения,
	|	Сверка.Номенклатура,
	|	Сверка.Характеристика,
	|	Сверка.Серия
	|
	|ИМЕЮЩИЕ
	|	СУММА(Сверка.Количество) <> 0";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", ТекстУсловия);
	Запрос.УстановитьПараметр("Склады", Склады);
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Расхождения = Запрос.Выполнить().Выгрузить();
	Чужие = Новый Массив;
	Для Каждого Строка Из Расхождения Цикл
		Если Не ДвиженияВедетТоварыВНаличии(Строка.Регистратор) Тогда
			Чужие.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из Чужие Цикл
		Расхождения.Удалить(Строка);
	КонецЦикла;
	Возврат Расхождения;

КонецФункции

// Текст расхождений инварианта для журнала регистрации и сообщения: первые 20 записей.
//
// Параметры:
//  Расхождения - ТаблицаЗначений - см. РасхожденияСТоварамиВНаличии.
//
// Возвращаемое значение:
//  Строка - многострочный текст.
//
Функция ТекстРасхождений(Расхождения) Экспорт
	Строки = Новый Массив;
	Шаблон = НСтр("ru = 'Расхождений регистров ""Товары в наличии"" и ""Товары на складах"": %1';
		|fr = 'Écarts entre les registres « Produits en stock » et « Marchandises en entrepôt » : %1';
		|en = 'Differences between the ""Products in stock"" and ""Goods in warehouses"" registers: %1';
		|es = 'Diferencias entre los registros «Productos en stock» y «Mercancías en almacenes»: %1'");
	ПоказыватьЗаписей = 20;
	Строки.Добавить(СтрШаблон(Шаблон, Расхождения.Количество()));
	Для Индекс = 0 По Мин(Расхождения.Количество(), ПоказыватьЗаписей) - 1 Цикл
		Строка = Расхождения[Индекс];
		Период = Формат(Строка.Период, "ДЛФ=DT");
		ТекстЗаписи = СтрШаблон("%1; %2; %3; %4; %5; %6; %7", Строка.Регистратор, Период, Строка.ВидДвижения,
			Строка.МестоХранения, Строка.Номенклатура, Строка.Характеристика, Строка.Разница);
		Строки.Добавить(ТекстЗаписи);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Возвращает текущий физический остаток номенклатуры.
//
// Параметры:
//  МестоХранения - СправочникСсылка.МестаХранения - склад; пустая ссылка: по всем складам.
//  Номенклатура - СправочникСсылка.Номенклатура - товар.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры, Неопределено - характеристика;
//                   пустая ссылка или Неопределено: сумма по всем характеристикам.
//
// Возвращаемое значение:
//  Число - остаток в единицах хранения, 0 при отсутствии остатка.
//
Функция ПолучитьОстатокПоТовару(МестоХранения, Номенклатура, Характеристика = Неопределено) Экспорт
	Условие = "Номенклатура = &Номенклатура";
	Если ЗначениеЗаполнено(МестоХранения) Тогда
		Условие = Условие + " И МестоХранения = &МестоХранения";
	КонецЕсли;
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Условие = Условие + " И Характеристика = &Характеристика";
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СУММА(Остатки.КоличествоОстаток) КАК Количество
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыНаСкладах.Остатки(, &Условие) КАК Остатки");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", Условие);
	Запрос.УстановитьПараметр("МестоХранения", МестоХранения);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Количество <> Null Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Заполняет колонку Остаток строк табличной части текущими физическими остатками по складу одним запросом.
//
// Параметры:
//  Строки - ТабличнаяЧастьОбъекта, ДанныеФормыКоллекция, ТаблицаЗначений - строки с колонками
//           Номенклатура, Характеристика и Остаток.
//  МестоХранения - СправочникСсылка.МестаХранения - склад; пустая ссылка: по всем складам.
//
Процедура ЗаполнитьОстаткиСтрок(Строки, МестоХранения) Экспорт
	ТЗКлючи = Новый ТаблицаЗначений;
	ТЗКлючи.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗКлючи.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Для Каждого Стр Из Строки Цикл
		Стр.Остаток = 0;
		Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			ЗаполнитьЗначенияСвойств(ТЗКлючи.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Если ТЗКлючи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УсловиеСклада = ?(ЗначениеЗаполнено(МестоХранения), "МестоХранения = &МестоХранения И ", "");
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ВТ.Номенклатура КАК Номенклатура,
	                      |	ВТ.Характеристика КАК Характеристика
	                      |ПОМЕСТИТЬ ВТКлючи
	                      |ИЗ
	                      |	&ВТКлючи КАК ВТ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Остатки.Номенклатура КАК Номенклатура,
	                      |	Остатки.Характеристика КАК Характеристика,
	                      |	СУММА(Остатки.КоличествоОстаток) КАК Остаток
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыНаСкладах.Остатки(
	                      |			,
	                      |			&УсловиеСклада (Номенклатура, Характеристика) В
	                      |				(ВЫБРАТЬ
	                      |					ВТКлючи.Номенклатура,
	                      |					ВТКлючи.Характеристика
	                      |				ИЗ
	                      |					ВТКлючи КАК ВТКлючи)) КАК Остатки
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Остатки.Номенклатура,
	                      |	Остатки.Характеристика");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСклада ", УсловиеСклада);
	Запрос.УстановитьПараметр("ВТКлючи", ТЗКлючи);
	Запрос.УстановитьПараметр("МестоХранения", МестоХранения);
	ТЗОстатки = Запрос.Выполнить().Выгрузить();
	ТЗОстатки.Индексы.Добавить("Номенклатура, Характеристика");
	Для Каждого Стр Из Строки Цикл
		СтрокиОстатка = ТЗОстатки.НайтиСтроки(
			Новый Структура("Номенклатура, Характеристика", Стр.Номенклатура, Стр.Характеристика));
		Если СтрокиОстатка.Количество() > 0 Тогда
			Стр.Остаток = СтрокиОстатка[0].Остаток;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик обновления 2.0.16.76: история ТоварыВНаличии переписывается в ТоварыНаСкладах той же свёрткой, что у
// зеркала, наборами по регистраторам с замещением и загрузкой данных, порциями в своей транзакции. Повторный запуск
// даёт тот же результат; наборы регистраторов, у которых записей ТоварыВНаличии больше нет, очищаются.
//
// Возвращаемое значение:
//  Структура - Регистраторов (Число), Очищено (Число).
//
Функция ЗаполнитьПоТоварамВНаличии() Экспорт

	РазмерПорции = 500;
	Итог = Новый Структура("Регистраторов, Очищено", 0, 0);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Записи.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыВНаличии КАК Записи");
	Регистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	Начало = 0;
	Пока Начало < Регистраторы.Количество() Цикл
		Конец = Мин(Начало + РазмерПорции, Регистраторы.Количество()) - 1;
		Порция = Новый Массив;
		Для Индекс = Начало По Конец Цикл
			Порция.Добавить(Регистраторы[Индекс]);
		КонецЦикла;
		ПолеРегистратора = "Регистратор";
		ЗаписиПорции = ЗаписиТоваровВНаличии(Порция);
		ЗаписиПорции.Индексы.Добавить(ПолеРегистратора);
		НачатьТранзакцию();
		Попытка
			Для Каждого Регистратор Из Порция Цикл
				Записи = ЗаписиПорции.Скопировать(Новый Структура(ПолеРегистратора, Регистратор));
				Набор = СоздатьНаборЗаписей();
				Набор.Отбор.Регистратор.Установить(Регистратор);
				Набор.Загрузить(ФизическиеДвижения(Записи, Регистратор));
				Набор.ОбменДанными.Загрузка = Истина;
				Набор.ДополнительныеСвойства.Вставить(ИмяСвойстваЗеркала(), Истина);
				Набор.Записать();
			КонецЦикла;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		Итог.Регистраторов = Итог.Регистраторов + Конец - Начало + 1;
		Начало = Конец + 1;
	КонецЦикла;

	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Физика.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах КАК Физика
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВНаличии КАК Партии
	|		ПО Физика.Регистратор = Партии.Регистратор
	|ГДЕ
	|	Партии.Регистратор ЕСТЬ NULL";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ДвиженияВедетТоварыВНаличии(Выборка.Регистратор) Тогда
			Продолжить;
		КонецЕсли;
		Набор = СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Выборка.Регистратор);
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.ДополнительныеСвойства.Вставить(ИмяСвойстваЗеркала(), Истина);
		Набор.Записать();
		Итог.Очищено = Итог.Очищено + 1;
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти
