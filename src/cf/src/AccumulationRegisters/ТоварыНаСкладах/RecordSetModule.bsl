// Привилегированный режим - осознанно: прежние позиции набора читаются для оповещения о минимальном остатке
// независимо от прав роли. BSLLS:SetPrivilegedMode-off

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ИмяСвойства = РегистрыНакопления.ТоварыНаСкладах.ИмяСвойстваЗеркала();
	Если Не ДополнительныеСвойства.Свойство(ИмяСвойства) Тогда
		// Набор документа пишет не зеркало (автоудаление движений, общая очистка наборов) - перестроить из записей
		// ТоварыВНаличии, иначе пустой набор затёр бы зеркало.
		РегистрыНакопления.ТоварыНаСкладах.ПерестроитьНаборНеЗеркала(ЭтотОбъект, Замещение);
		Если РегистрыНакопления.ТоварыНаСкладах.ДвиженияВедетТоварыВНаличии(Отбор.Регистратор.Значение) Тогда
			// Оповещение о минимальном остатке уже отправило зеркало этого регистратора.
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ЗапомнитьПрежниеПозиции(Замещение);
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	Если ОбменДанными.Загрузка Или Отказ Или Не ДополнительныеСвойства.Свойство(ИмяСвойстваПрежнихПозиций()) Тогда
		Возврат;
	КонецЕсли;
	Передано = Неопределено;
	ДополнительныеСвойства.Свойство(РегистрыНакопления.ТоварыНаСкладах.ИмяСвойстваПозицийПерепроведения(), Передано);
	ДоОчистки = Передано = Неопределено Или Не Передано.ОчисткаПройдена;
	Если Количество() = 0 И ДоОчистки И РегистраторПроведен() Тогда
		// Промежуточная очистка движений при перепроведении (автоудаление): остаток ещё не окончательный, оповещение
		// даст запись новых движений - прежние позиции ей передаёт документ. Пустой набор после очистки - окончательная
		// запись документа без складских строк: проверяется. Отмена проведения документ уже распровела - она оповещает.
		Если Передано <> Неопределено Тогда
			Передано.ОчисткаПройдена = Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	// Минимальный остаток - по физическому регистру: пары «склад - номенклатура» прежних и новых записей набора, в том
	// числе при отмене проведения (новых записей нет). Только затронутые пары: остаток, ушедший в ноль, оповещает.
	Позиции = ДополнительныеСвойства[ИмяСвойстваПрежнихПозиций()];
	Для Каждого Запись Из ЭтотОбъект Цикл
		ЗаполнитьЗначенияСвойств(Позиции.Добавить(), Запись);
	КонецЦикла;
	ПолеСклада = "МестоХранения";
	Позиции.Свернуть(ПолеСклада + ", Номенклатура");
	Склады = Позиции.Скопировать(, ПолеСклада);
	Склады.Свернуть(ПолеСклада);
	Для Каждого Строка Из Склады Цикл
		ПозицииСклада = Позиции.Скопировать(Новый Структура(ПолеСклада, Строка.МестоХранения));
		ПроцедурыРегламентныхЗаданий.ПроверкаМинимальногоОстатка(ПозицииСклада.ВыгрузитьКолонку("Номенклатура"),
			Строка.МестоХранения);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗапомнитьПрежниеПозиции(Замещение)
	Позиции = Новый ТаблицаЗначений;
	Позиции.Колонки.Добавить("МестоХранения", Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
	Позиции.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Если Замещение Тогда
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Записи.МестоХранения КАК МестоХранения,
		|	Записи.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах КАК Записи
		|ГДЕ
		|	Записи.Регистратор = &Регистратор");
		Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Позиции.Добавить(), Выборка);
		КонецЦикла;
	КонецЕсли;
	// Перепроведение с автоудалением движений: промежуточная очистка уже стёрла записи из базы, прежние позиции
	// документ передал набору до записи (РегистрыНакопления.ТоварыНаСкладах.ЗапомнитьПозицииПередПерепроведением).
	Передано = Неопределено;
	Если ДополнительныеСвойства.Свойство(РегистрыНакопления.ТоварыНаСкладах.ИмяСвойстваПозицийПерепроведения(),
		Передано) Тогда
		Для Каждого Позиция Из Передано.Позиции Цикл
			ЗаполнитьЗначенияСвойств(Позиции.Добавить(), Позиция);
		КонецЦикла;
	КонецЕсли;
	ДополнительныеСвойства.Вставить(ИмяСвойстваПрежнихПозиций(), Позиции);
КонецПроцедуры

Функция РегистраторПроведен()
	Регистратор = Отбор.Регистратор.Значение;
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(Регистратор));
	Если МетаданныеДокумента = Неопределено Или МетаданныеДокумента.Проведение
		<> Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		Возврат Ложь;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Регистратор, "Проведен") = Истина;
КонецФункции

Функция ИмяСвойстваПрежнихПозиций()
	Возврат "ПрежниеПозицииМинимальногоОстатка";
КонецФункции

#КонецОбласти
