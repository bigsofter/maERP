
#Область Формирование_движений

Процедура СформироватьДвижения(ДокОбъект) Экспорт
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.НалоговаяНакладная") Тогда
		ТипОперации = Перечисления.ВидыОперацийНалоговые.Накладная;
		Описание = "" + ТипОперации + " " + ДокОбъект.Номер;
		// Налоговый регистр - в основной валюте: накладная в валюте - своей СуммаРегл (точная сумма отгрузок),
		// оплаты (деньги и ручная разбивка ТЧСпособыОплаты) - уже в основной валюте.
		СуммаДокумента = ?(ДокОбъект.ВВалюте, ДокОбъект.СуммаРегл, ДокОбъект.Сумма);
		Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Контрагент, ТипОперации, Описание,
			СуммаДокумента, Истина, ДокОбъект.Ссылка);
		РучнаяКорректировка = ДокОбъект.РучнаяКорректировка И Не ДокОбъект.ТЧСпособыОплаты.Количество() = 0;
		Если РучнаяКорректировка Тогда
			ТЗОплат = ДокОбъект.ТЧСпособыОплаты.Выгрузить();
		Иначе
			ТЗОплат = РегистрыНакопления.ДенежныеСредстваОрганизаций.ПолучитьОплаты(ДокОбъект,Истина);
		КонецЕсли;
		Для Каждого СтрОплат из ТЗОплат Цикл 
			Если СтрОплат.ТипДенежныхСредств = Справочники.TypesDePayment.Cheque Тогда 
				ТипОперации = Перечисления.ВидыОперацийНалоговые.Чек;
				Чек = ?(РучнаяКорректировка, СтрОплат.Чек, СтрОплат.Регистратор.Чек);
				Описание = "" + ТипОперации + " №" + Чек.Наименование + ", " + Чек.Банк +  " de " + Формат(Чек.ДатаЧека,"ДЛФ=D");
			ИначеЕсли СтрОплат.ТипДенежныхСредств = Справочники.TypesDePayment.Cash Тогда 
				ТипОперации = Перечисления.ВидыОперацийНалоговые.Наличные;
				Описание = "" + ТипОперации;
			Иначе 
				ТипОперации = Перечисления.ВидыОперацийНалоговые.БанковскийПеревод;
				Описание = "" + ТипОперации;
			КонецЕсли;
			ТипДвижения = ?(РучнаяКорректировка, Перечисления.ТипыДвиженияДенежныхСредств.Поступление,СтрОплат.ТипДвижения);
			Приход = ?(ТипДвижения = Перечисления.ТипыДвиженияДенежныхСредств.Поступление, Ложь, Истина);
			ДокРегистратор = ?(РучнаяКорректировка, ДокОбъект.Ссылка, СтрОплат.Регистратор);
			Движение(ДокОбъект.Движения, СтрОплат.Период, ДокОбъект.Организация, ДокОбъект.Контрагент, ТипОперации, Описание, СтрОплат.Сумма,Приход, ДокРегистратор);
			//КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратОтПокупателяНалоговый") Тогда
		ТипОперации = Перечисления.ВидыОперацийНалоговые.Возврат;
		Описание = "" + ТипОперации + " " + ДокОбъект.Номер;
		СуммаДокумента = ?(ДокОбъект.ВВалюте, ДокОбъект.СуммаРегл, ДокОбъект.Сумма);
		Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Контрагент, ТипОперации, Описание,
			СуммаДокумента, Ложь, ДокОбъект.Ссылка);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер")
		Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РасходныйКассовыйОрдер")
		Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств")
		Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда
		Если Не ДокОбъект.Организация.ОсновнойУчет Тогда Возврат; КонецЕсли;
		Если РаботаСДокументамиКлиентСервер.ЕстьРеквизит(ДокОбъект,"ХозяйственнаяОперация") Тогда 
			Если Не ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПокупателями(ДокОбъект.ХозяйственнаяОперация) Тогда Возврат КонецЕсли;
		КонецЕсли;
		Если ДокОбъект.ТипОплаты = Справочники.TypesDePayment.Cheque Тогда 
			ТипОперации = Перечисления.ВидыОперацийНалоговые.Чек;
			Чек = ДокОбъект.Чек;
			Описание = "" + ТипОперации + " №" + Чек.Наименование + ", " + Чек.Банк +  " de " + Формат(Чек.ДатаЧека,"ДЛФ=D");
		ИначеЕсли ДокОбъект.ТипОплаты = Справочники.TypesDePayment.Cash Тогда 
			ТипОперации = Перечисления.ВидыОперацийНалоговые.Наличные;
			Описание = "" + ТипОперации;
		Иначе 
			ТипОперации = Перечисления.ВидыОперацийНалоговые.БанковскийПеревод;
			Описание = "" + ТипОперации;
		КонецЕсли;
		Приход = ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РасходныйКассовыйОрдер");
		// Аванс - в основной валюте тем же числом, что в регистре взаиморасчётов (суммы платежа - в валюте кассы или счёта).
		СуммаОплаты = РаботаСВалютами.АвансПлатежаВОсновнойВалюте(ДокОбъект);
		Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Контрагент, ТипОперации, Описание, СуммаОплаты, Приход, ДокОбъект.Ссылка);
		ВозвратНалоговыхАвансов(ДокОбъект, ТипОперации, Описание);
	КонецЕсли;
КонецПроцедуры

// Возврат переплаты на основании исходного платежа покупателя (Ф3.1 docs/plans/commerce-two-orgs.md, «Возврат
// переплаты»): строки РКО и списания безналичных с основанием-платежом, свёрнутые по платежу, - приход на объект и
// документ движения «исходный платёж»: его налоговый аванс уменьшается, но не больше остатка этого аванса. Предел самого
// возврата - обычный аванс исходного платежа (НалоговыеРасчетыПроверки.ПроверитьПлатеж).
//
// Параметры:
//  ДокОбъект   - ДокументОбъект.РасходныйКассовыйОрдер, ДокументОбъект.СписаниеБезналичныхДенежныхСредств - возврат.
//  ТипОперации - ПеречислениеСсылка.ВидыОперацийНалоговые - вид операции записи.
//  Описание    - Строка - описание записи.
//
Процедура ВозвратНалоговыхАвансов(ДокОбъект, ТипОперации, Описание)
	Если ТипЗнч(ДокОбъект) <> Тип("ДокументОбъект.РасходныйКассовыйОрдер")
		И ТипЗнч(ДокОбъект) <> Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда
		Возврат;
	КонецЕсли;
	Курс = РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс;
	Суммы = Новый Соответствие;
	Для Каждого Стр Из ДокОбъект.ТЧОснования Цикл
		Если ТипЗнч(Стр.Основание) <> Тип("ДокументСсылка.ПриходныйКассовыйОрдер")
			И ТипЗнч(Стр.Основание) <> Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") Тогда
			Продолжить;
		КонецЕсли;
		Прежняя = Суммы.Получить(Стр.Основание);
		СуммаСтроки = РаботаСВалютамиКлиентСервер.СуммаРегл(Стр.Сумма, Курс);
		Суммы.Вставить(Стр.Основание, ?(Прежняя = Неопределено, 0, Прежняя) + СуммаСтроки);
	КонецЦикла;
	Если Суммы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// Сторно - не больше налогового аванса исходного платежа и под аналитиками его остатков (ревью 2.0.17.29, круг 9):
	// остаток возврата сверх налогового аванса налогом не сторнируется.
	Авансы = НалоговыеАвансыИсточников(Суммы, ДокОбъект.Ссылка);
	Для Каждого КлючИЗначение Из Суммы Цикл
		Остаток = КлючИЗначение.Значение;
		Для Каждого Аванс Из Авансы.НайтиСтроки(Новый Структура("Источник", КлючИЗначение.Ключ)) Цикл
			Часть = Мин(Остаток, Аванс.Аванс);
			Если Часть <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Движение(ДокОбъект.Движения, ДокОбъект.Дата, Аванс.Организация, Аванс.Контрагент, ТипОперации, Описание,
				Часть, Истина, КлючИЗначение.Ключ);
			Остаток = Остаток - Часть;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Налоговые авансы исходных платежей по аналитикам их записей: записи на объект «платёж», кроме снимков оплат
// налоговых накладных (оплата долга, не аванс) и записей самого возврата.
//
// Параметры:
//  Суммы    - Соответствие - исходный платёж -> сумма возврата.
//  Исключая - ДокументСсылка - проводимый возврат.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Источник, Организация, Контрагент, Аванс (только положительные).
//
Функция НалоговыеАвансыИсточников(Суммы, Исключая)
	Источники = Новый Массив;
	Для Каждого КлючИЗначение Из Суммы Цикл
		Источники.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	// BSLLS:YoLetterUsage-off
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Т.ОбъектРасчётов КАК Источник,
	                      |	Т.Организация КАК Организация,
	                      |	Т.Контрагент КАК Контрагент,
	                      |	СУММА(ВЫБОР
	                      |			КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	                      |				ТОГДА -Т.Сумма
	                      |			ИНАЧЕ Т.Сумма
	                      |		КОНЕЦ) КАК Аванс
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый КАК Т
	                      |ГДЕ
	                      |	Т.ОбъектРасчётов В (&Источники)
	                      |	И Т.Регистратор <> &Исключая
	                      |	И НЕ Т.Регистратор ССЫЛКА Документ.НалоговаяНакладная
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Т.ОбъектРасчётов,
	                      |	Т.Организация,
	                      |	Т.Контрагент
	                      |
	                      |ИМЕЮЩИЕ
	                      |	СУММА(ВЫБОР
	                      |			КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	                      |				ТОГДА -Т.Сумма
	                      |			ИНАЧЕ Т.Сумма
	                      |		КОНЕЦ) > 0");
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Источники", Источники);
	Запрос.УстановитьПараметр("Исключая", Исключая);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура Движение(Движения, ДатаДвижения, Организация, Контрагент, ТипОперации, Описание, Сумма, Приход = Истина, ДокументДвижения)
	Если Сумма = 0 Тогда Возврат КонецЕсли;
	НС = Движения.ВзаиморасчётыСПокупателямиНалоговый.Добавить();
	НС.ВидДвижения = ?(Приход, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
	НС.Период = ДатаДвижения;
	НС.Организация = Организация;
	НС.Контрагент = Контрагент;
	НС.ВидОперации = ТипОперации;
	НС.Описание = Описание;
	НС.ДокументДвижения = ДокументДвижения;
	НС.ОбъектРасчётов = ДокументДвижения;
	НС.Сумма = Сумма;	
КонецПроцедуры

#КонецОбласти
