
#Область Формирование_движений

// Движения продаж (план warehouse-orders-cost, Ф2.2): выручка, НДС и количество - одна запись на товар и
// характеристику, без партии и себестоимости; себестоимость - в регистре СебестоимостьПродаж.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ВозвратОтПокупателя - проводимый документ
//
Процедура СформироватьДвижения(ДокОбъект) Экспорт
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		// Выручка - в основной валюте, как и себестоимость партий.
		ТЗТовары = ДокОбъект.ТЧТовары.Выгрузить();
		РаботаСВалютами.ПересчитатьКолонкиВОсновнуюВалюту(ТЗТовары, РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс,
			"Сумма, СуммаНДС, СуммаСНДС");
		ДокОбъект.Движения.Продажи.Загрузить(ДанныеРеализации(ДокОбъект, ТЗТовары));
		РегистрыНакопления.СебестоимостьПродаж.СформироватьПоРеализации(ДокОбъект);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратОтПокупателя") Тогда
		// Повторное проведение того же экземпляра не должно удвоить набор, и без основания тоже (tiny1C bsl-018).
		ДокОбъект.Движения.Продажи.Очистить();
		Если ЗначениеЗаполнено(ДокОбъект.Основание) Тогда
			УменьшитьВыручкуПоВозврату(ДокОбъект);
			ВыручкаПоСтрокамВозврата(ДокОбъект);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Возврат сторнирует выручку основания только по количеству, восстановленному из его партий (записи себестоимости
// возврата): комплект и строка без партий основания продажу не сторнируют, как прежде. Обычная реализация - из
// невозвращенных сумм: выручка и НДС основания минус сторно возвратов строго раньше, на оставшееся количество;
// возврат, исчерпывающий количество, забирает весь остаток (Ф2.2, Редакция 23). Налоговый документ на основаниях -
// выручка из строк возврата (ВыручкаПоСтрокамВозврата).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВозвратОтПокупателя - проводимый возврат с движениями себестоимости
//
Процедура УменьшитьВыручкуПоВозврату(ДокОбъект)
	Возвращено = ДокОбъект.Движения.СебестоимостьПродаж.Выгрузить();
	Возвращено = Возвращено.Скопировать(Новый Структура("Списание, ДополнительныйРасход", Истина, Ложь),
		"Номенклатура, Характеристика, Количество");
	Возвращено.Свернуть("Номенклатура, Характеристика", "Количество");
	Если Возвращено.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Возвраты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПрежниеВозвраты
	|ИЗ
	|	Документ.ВозвратОтПокупателя КАК Возвраты
	|ГДЕ
	|	Возвраты.Основание = &Основание
	|	И Возвраты.Проведен
	|	И Возвраты.Ссылка <> &Текущий
	|	И Возвраты.МоментВремени < &Момент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Т.Организация КАК Организация,
	|	Т.Сотрудник КАК Сотрудник,
	|	Т.Контрагент КАК Контрагент,
	|	Т.ДокументПродажи КАК ДокументПродажи,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Ответственный КАК Ответственный,
	|	Т.МестоХранения КАК МестоХранения,
	|	СУММА(Т.Количество) КАК Количество,
	|	СУММА(Т.Выручка) КАК Выручка,
	|	СУММА(Т.НДС) КАК НДС
	|ИЗ
	|	РегистрНакопления.Продажи КАК Т
	|ГДЕ
	|	Т.Регистратор = &Основание
	|	И Т.Активность
	|	И Т.УУ В (&ДопустимыеУУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ХозяйственнаяОперация,
	|	Т.Организация,
	|	Т.Сотрудник,
	|	Т.Контрагент,
	|	Т.ДокументПродажи,
	|	Т.Номенклатура,
	|	Т.Характеристика,
	|	Т.Ответственный,
	|	Т.МестоХранения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	СУММА(-Т.Количество) КАК Количество,
	|	СУММА(-Т.Выручка) КАК Выручка,
	|	СУММА(-Т.НДС) КАК НДС
	|ИЗ
	|	РегистрНакопления.Продажи КАК Т
	|ГДЕ
	|	Т.Регистратор В
	|			(ВЫБРАТЬ
	|				ПВ.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТПрежниеВозвраты КАК ПВ)
	|	И Т.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Номенклатура,
	|	Т.Характеристика");
	Запрос.УстановитьПараметр("Основание", ДокОбъект.Основание);
	Запрос.УстановитьПараметр("Текущий", ДокОбъект.Ссылка);
	Запрос.УстановитьПараметр("Момент", ДокОбъект.МоментВремени());
	ДопустимыеУУ = РегистрыНакопления.СебестоимостьПродаж.ДопустимыеПризнакиУУ(ДокОбъект.Основание);
	Запрос.УстановитьПараметр("ДопустимыеУУ", ДопустимыеУУ);
	Пакет = Запрос.ВыполнитьПакет();
	Продано = Пакет[1].Выгрузить();
	Прежние = Пакет[2].Выгрузить();
	Для Каждого Строка Из Возвращено Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика", Строка.Номенклатура, Строка.Характеристика);
		СтрокиОснования = Продано.НайтиСтроки(Отбор);
		Если СтрокиОснования.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Остаток = Новый Структура("Количество, Выручка, НДС", 0, 0, 0);
		Для Каждого Запись Из СтрокиОснования Цикл
			Остаток.Количество = Остаток.Количество + Запись.Количество;
			Остаток.Выручка = Остаток.Выручка + Запись.Выручка;
			Остаток.НДС = Остаток.НДС + Запись.НДС;
		КонецЦикла;
		Для Каждого Запись Из Прежние.НайтиСтроки(Отбор) Цикл
			Остаток.Количество = Остаток.Количество - Запись.Количество;
			Остаток.Выручка = Остаток.Выручка - Запись.Выручка;
			Остаток.НДС = Остаток.НДС - Запись.НДС;
		КонецЦикла;
		Количество = -Строка.Количество;
		Если Количество >= Остаток.Количество Или Остаток.Количество <= 0 Тогда
			Выручка = Остаток.Выручка;
			НДС = Остаток.НДС;
		Иначе
			Выручка = Окр(Остаток.Выручка * Количество / Остаток.Количество, РазрядностьСуммы());
			НДС = Окр(Остаток.НДС * Количество / Остаток.Количество, РазрядностьСуммы());
		КонецЕсли;
		НС = ДокОбъект.Движения.Продажи.Добавить();
		ЗаполнитьЗначенияСвойств(НС, СтрокиОснования[0]);
		НС.Период = ДокОбъект.Дата;
		НС.ХозяйственнаяОперация = ДокОбъект.ХозяйственнаяОперация;
		НС.Количество = -Количество;
		НС.Выручка = -Выручка;
		НС.НДС = -НДС;
	КонецЦикла;
КонецПроцедуры

// Выручка и НДС возврата по налоговому документу на основаниях - из строк возврата (в основной валюте), распределённые
// по его записям продаж того же товара пропорционально количеству.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВозвратОтПокупателя - проводимый возврат
//
Процедура ВыручкаПоСтрокамВозврата(ДокОбъект)
	Если Не НалоговыеДокументыНаОснованиях.ЭтоРегистраторНаОснованиях(ДокОбъект.Основание) Тогда
		Возврат;
	КонецЕсли;
	ТЗТовары = ДокОбъект.ТЧТовары.Выгрузить(, "Номенклатура, Характеристика, СуммаСНДС, СуммаНДС");
	РаботаСВалютами.ПересчитатьКолонкиВОсновнуюВалюту(ТЗТовары, РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс,
		"СуммаСНДС, СуммаНДС");
	ТЗТовары.Свернуть("Номенклатура, Характеристика", "СуммаСНДС, СуммаНДС");
	Для Каждого Стр Из ТЗТовары Цикл
		Строки = Новый Массив;
		Для Каждого Запись Из ДокОбъект.Движения.Продажи Цикл
			Если Запись.Номенклатура = Стр.Номенклатура И Запись.Характеристика = Стр.Характеристика Тогда
				Строки.Добавить(Запись);
			КонецЕсли;
		КонецЦикла;
		РаспределитьВыручкуВозврата(Строки, Стр.СуммаСНДС, Стр.СуммаНДС);
	КонецЦикла;
КонецПроцедуры

Процедура РаспределитьВыручкуВозврата(Строки, Выручка, НДС)
	КоличествоИтог = 0;
	Для Каждого Запись Из Строки Цикл
		КоличествоИтог = КоличествоИтог + Запись.Количество;
	КонецЦикла;
	Если КоличествоИтог = 0 Тогда
		Возврат;
	КонецЕсли;
	ОстатокВыручки = Выручка;
	ОстатокНДС = НДС;
	Последняя = Строки[Строки.ВГраница()];
	Для Каждого Запись Из Строки Цикл
		Доля = Запись.Количество / КоличествоИтог;
		ВыручкаЗаписи = ?(Запись = Последняя, ОстатокВыручки, Окр(Выручка * Доля, РазрядностьСуммы()));
		НДСЗаписи = ?(Запись = Последняя, ОстатокНДС, Окр(НДС * Доля, РазрядностьСуммы()));
		ОстатокВыручки = ОстатокВыручки - ВыручкаЗаписи;
		ОстатокНДС = ОстатокНДС - НДСЗаписи;
		Запись.Выручка = -ВыручкаЗаписи;
		Запись.НДС = -НДСЗаписи;
	КонецЦикла;
КонецПроцедуры

Функция ДанныеРеализации(ДокОбъект, ТЗТовары)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(ТЗТовары.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(ТЗТовары.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	                      |	ВЫРАЗИТЬ(ТЗТовары.Количество КАК ЧИСЛО) КАК Количество,
	                      |	ВЫРАЗИТЬ(ТЗТовары.СуммаСНДС КАК ЧИСЛО) КАК Выручка,
	                      |	ВЫРАЗИТЬ(ТЗТовары.СуммаНДС КАК ЧИСЛО) КАК НДС
	                      |ПОМЕСТИТЬ ВТТовары
	                      |ИЗ
	                      |	&ТЗТовары КАК ТЗТовары
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	&Период КАК Период,
	                      |	&Организация КАК Организация,
	                      |	&Сотрудник КАК Сотрудник,
	                      |	&Контрагент КАК Контрагент,
	                      |	&ДокументПродажи КАК ДокументПродажи,
	                      |	&Ответственный КАК Ответственный,
	                      |	&ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	                      |	&МестоХранения КАК МестоХранения,
	                      |	ВТТовары.Номенклатура КАК Номенклатура,
	                      |	ВТТовары.Характеристика КАК Характеристика,
	                      |	СУММА(ВТТовары.Количество) КАК Количество,
	                      |	СУММА(ВТТовары.Выручка) КАК Выручка,
	                      |	СУММА(ВТТовары.НДС) КАК НДС
	                      |ИЗ
	                      |	ВТТовары КАК ВТТовары
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТТовары.Номенклатура,
	                      |	ВТТовары.Характеристика");
	Запрос.УстановитьПараметр("ТЗТовары", ТЗТовары);
	Запрос.УстановитьПараметр("Период", ДокОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ДокОбъект.Организация);
	Запрос.УстановитьПараметр("Сотрудник", ДокОбъект.Менеджер);
	Запрос.УстановитьПараметр("Контрагент", ДокОбъект.Контрагент);
	Запрос.УстановитьПараметр("ДокументПродажи", ДокОбъект.Ссылка);
	Запрос.УстановитьПараметр("МестоХранения", ДокОбъект.МестоХранения);
	Запрос.УстановитьПараметр("Ответственный", ДокОбъект.Ответственный);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация", ДокОбъект.ХозяйственнаяОперация);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция РазрядностьСуммы()
	Возврат 2;
КонецФункции	

#КонецОбласти

#Область Остатки

Функция ПолучитьВыручкуПоТоварнойГруппе(НачалоПериода, КонецПериода, МасСотрудники, ТоварнаяГруппа) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Сумма
	                      |ИЗ
	                      |	РегистрНакопления.Продажи.Обороты(
	                      |			&НачалоПериода,
	                      |			&КонецПериода,
	                      |			,
	                      |			ВЫБОР
	                      |					КОГДА &СотрудникиУказаны
	                      |						ТОГДА Сотрудник В (&Сотрудники)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И Номенклатура.ТоварнаяГруппа = &ТоварнаяГруппа) КАК ПродажиОбороты");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Сотрудники", МасСотрудники);
	Запрос.УстановитьПараметр("СотрудникиУказаны", МасСотрудники.Количество() > 0);
	Запрос.УстановитьПараметр("ТоварнаяГруппа", ТоварнаяГруппа);
	Возврат Запрос.Выполнить().Выгрузить().Итог("Сумма");
КонецФункции

#КонецОбласти

#Область Остатки_и_аналитика

Функция ПолучитьПроцентПланаПродажПоМенеджеру(Период, Менеджер, Показатель) Экспорт
	Структура = Новый Структура("План, Факт, Процент", 0, 0, 0);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПродажиОбороты.Сотрудник как Менеджер,
	                      |	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Факт,
	                      |	СУММА(0) КАК План
	                      |ИЗ
	                      |	РегистрНакопления.Продажи.Обороты(&ДатаНач, &ДатаКон, Месяц, Сотрудник = &Менеджер) КАК ПродажиОбороты
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ПродажиОбороты.Сотрудник
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ПлановыеПоказателиСрезПоследних.Сотрудник,
	                      |	0,
	                      |	ПлановыеПоказателиСрезПоследних.План
	                      |ИЗ
	                      |	РегистрСведений.ПлановыеПоказатели.СрезПоследних(
	                      |			&ДатаНач,
	                      |			Сотрудник = &Менеджер
	                      |				И Показатель = &Показатель) КАК ПлановыеПоказателиСрезПоследних");
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(КонецМесяца(Период)));
	Запрос.УстановитьПараметр("Менеджер", Менеджер);
	Запрос.УстановитьПараметр("Показатель", Показатель);
	ТЗ = Запрос.Выполнить().Выгрузить();
	ТЗ.Свернуть("Менеджер", "Факт, План");
	Если ТЗ.Количество() > 0 Тогда
		Стр = ТЗ[0];
		Структура.План = Стр.План;
		Структура.Факт = Стр.Факт;
		Структура.Процент = ?(Стр.План = 0, 100, Окр(Стр.Факт / (Стр.План / 100)));
	КонецЕсли;	
	Возврат Структура;	
КонецФункции

// Возвращает сумму показателя продаж за период по отбору.
//
// Параметры:
//  НачалоПериода - Дата - начало периода (включительно).
//  КонецПериода - Дата - конец периода (включительно).
//  Отбор - Структура - описание отбора:
//   * Показатель - ПеречислениеСсылка.ПоказателиПродаж - Выручка, Прибыль, Количество или ЧистаяПрибыль;
//   * Параметры - Массив - значения отбора, разрез определяется типом значения:
//     СправочникСсылка.Контрагенты, СправочникСсылка.Номенклатура (элемент или группа, отбор в иерархии),
//     СправочникСсылка.МестаХранения (отбор в иерархии), СправочникСсылка.ФизическиеЛица (продавец),
//     ПеречислениеСсылка.ТипыНоменклатуры;
//   * Сотрудник - Массив - (необязательно) продавцы; то же, что ФизическиеЛица в Параметры.
//  Продавец - сотрудник (менеджер) документа продажи, а если он не заполнен - физическое лицо ответственного.
//
// Возвращаемое значение:
//  Число - сумма показателя. Для ЧистаяПрибыль - валовая прибыль за вычетом затрат регистра Убытки
//  по тем же местам хранения, что и в отборе.
//
Функция ПолучитьСуммуПоказателяПродажПоПараметру(НачалоПериода, КонецПериода, Отбор) Экспорт
	Если Не ЗначениеЗаполнено(Отбор.Показатель) Тогда
		Возврат 0;
	КонецЕсли;
	Параметры = ПараметрыОтбораПродаж(Отбор);
	ТЗ = ТаблицаПоказателейПродаж(НачалоПериода, КонецПериода, Параметры);
	Сумма = ТЗ.Итог(ИмяКолонкиПоказателя(Отбор.Показатель));
	Если Отбор.Показатель = Перечисления.ПоказателиПродаж.ЧистаяПрибыль Тогда
		Сумма = Сумма - РегистрыНакопления.Убытки.ПолучитьЗатраты(НачалоПериода, КонецПериода, Параметры.Магазины);
	КонецЕсли;
	Возврат Сумма;
КонецФункции

// Возвращает суммы показателя продаж за период в разрезе продавцов.
// Затраты регистра Убытки по продавцам не распределяются: для ЧистаяПрибыль возвращается валовая прибыль продавца.
//
// Параметры:
//  НачалоПериода - Дата - начало периода (включительно).
//  КонецПериода - Дата - конец периода (включительно).
//  Отбор - Структура - см. ПолучитьСуммуПоказателяПродажПоПараметру.
//
// Возвращаемое значение:
//  Соответствие - ключ: СправочникСсылка.ФизическиеЛица (продавец), значение: Число - сумма показателя.
//
Функция ПолучитьСуммыПоказателяПродажПоПродавцам(НачалоПериода, КонецПериода, Отбор) Экспорт
	Результат = Новый Соответствие;
	Если Не ЗначениеЗаполнено(Отбор.Показатель) Тогда
		Возврат Результат;
	КонецЕсли;
	ТЗ = ТаблицаПоказателейПродаж(НачалоПериода, КонецПериода, ПараметрыОтбораПродаж(Отбор));
	ИмяКолонки = ИмяКолонкиПоказателя(Отбор.Показатель);
	Для Каждого Стр Из ТЗ Цикл
		Результат.Вставить(Стр.Продавец, Стр[ИмяКолонки]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПараметрыОтбораПродаж(Отбор)
	Результат = Новый Структура;
	Результат.Вставить("Контрагенты", Новый Массив);
	Результат.Вставить("ТоварныеГруппы", Новый Массив);
	Результат.Вставить("Магазины", Новый Массив);
	Результат.Вставить("Сотрудники", Новый Массив);
	Результат.Вставить("ТипыНоменклатуры", Новый Массив);
	МасСотрудники = Неопределено;
	Если Отбор.Свойство("Сотрудник", МасСотрудники) И ТипЗнч(МасСотрудники) = Тип("Массив") Тогда
		Для Каждого Сотрудник Из МасСотрудники Цикл
			Результат.Сотрудники.Добавить(Сотрудник);
		КонецЦикла;
	КонецЕсли;
	МасПараметры = Неопределено;
	Если Не Отбор.Свойство("Параметры", МасПараметры) Или МасПараметры = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Параметр Из МасПараметры Цикл
		ТипПараметра = ТипЗнч(Параметр);
		Если ТипПараметра = Тип("СправочникСсылка.Контрагенты") Тогда
			Результат.Контрагенты.Добавить(Параметр);
		ИначеЕсли ТипПараметра = Тип("СправочникСсылка.Номенклатура") Тогда
			Результат.ТоварныеГруппы.Добавить(Параметр);
		ИначеЕсли ТипПараметра = Тип("СправочникСсылка.МестаХранения") Тогда
			Результат.Магазины.Добавить(Параметр);
		ИначеЕсли ТипПараметра = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			Результат.Сотрудники.Добавить(Параметр);
		ИначеЕсли ТипПараметра = Тип("ПеречислениеСсылка.ТипыНоменклатуры") Тогда
			Результат.ТипыНоменклатуры.Добавить(Параметр);
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ИмяКолонкиПоказателя(Показатель)
	Если Показатель = Перечисления.ПоказателиПродаж.Выручка Тогда
		Возврат "Выручка";
	ИначеЕсли Показатель = Перечисления.ПоказателиПродаж.Количество Тогда
		Возврат "Количество";
	Иначе // Прибыль, ЧистаяПрибыль
		Возврат "Прибыль";
	КонецЕсли;
КонецФункции

Функция ТаблицаПоказателейПродаж(НачалоПериода, КонецПериода, Параметры)
	// Прибыль - единой формулой продаж с себестоимостью (СебестоимостьПродаж.ТекстПродажССебестоимостью).
	Условие = "ВЫБОР
	|	КОГДА &КонтрагентыУказаны
	|		ТОГДА Контрагент В (&Контрагенты)
	|	ИНАЧЕ ИСТИНА
	|КОНЕЦ
	|И ВЫБОР
	|	КОГДА &ТоварныеГруппыУказаны
	|		ТОГДА Номенклатура В ИЕРАРХИИ (&ТоварныеГруппы)
	|	ИНАЧЕ ИСТИНА
	|КОНЕЦ
	|И ВЫБОР
	|	КОГДА &МагазиныУказаны
	|		ТОГДА МестоХранения В ИЕРАРХИИ (&Магазины)
	|	ИНАЧЕ ИСТИНА
	|КОНЕЦ";
	ТекстПродаж = РегистрыНакопления.СебестоимостьПродаж.ТекстПродажССебестоимостью(Условие);
	Запрос = Новый Запрос(ТекстПродаж + ";
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Продажи.Сотрудник КАК Сотрудник,
	                      |	Продажи.Ответственный КАК Ответственный,
	                      |	Продажи.Номенклатура КАК Номенклатура,
	                      |	Продажи.Количество КАК Количество,
	                      |	Продажи.Выручка КАК Выручка,
	                      |	Продажи.Прибыль КАК Прибыль
	                      |ПОМЕСТИТЬ ВТОбороты
	                      |ИЗ
	                      |	ВТПродажиССебестоимостью КАК Продажи
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВЫБОР
	                      |		КОГДА ВТОбороты.Сотрудник = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	                      |			ТОГДА ЕСТЬNULL(Пользователи.ФизическоеЛицо, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
	                      |		ИНАЧЕ ВТОбороты.Сотрудник
	                      |	КОНЕЦ КАК Продавец,
	                      |	ВТОбороты.Количество КАК Количество,
	                      |	ВТОбороты.Выручка КАК Выручка,
	                      |	ВТОбороты.Прибыль КАК Прибыль
	                      |ПОМЕСТИТЬ ВТПродажи
	                      |ИЗ
	                      |	ВТОбороты КАК ВТОбороты
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	                      |		ПО ВТОбороты.Ответственный = Пользователи.Ссылка
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	                      |		ПО ВТОбороты.Номенклатура = СправочникНоменклатура.Ссылка
	                      |ГДЕ
	                      |	ВЫБОР
	                      |		КОГДА &ТипыНоменклатурыУказаны
	                      |			ТОГДА СправочникНоменклатура.ТипНоменклатуры В (&ТипыНоменклатуры)
	                      |		ИНАЧЕ ИСТИНА
	                      |	КОНЕЦ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТПродажи.Продавец КАК Продавец,
	                      |	СУММА(ВТПродажи.Количество) КАК Количество,
	                      |	СУММА(ВТПродажи.Выручка) КАК Выручка,
	                      |	СУММА(ВТПродажи.Прибыль) КАК Прибыль
	                      |ИЗ
	                      |	ВТПродажи КАК ВТПродажи
	                      |ГДЕ
	                      |	ВЫБОР
	                      |		КОГДА &СотрудникиУказаны
	                      |			ТОГДА ВТПродажи.Продавец В (&Сотрудники)
	                      |		ИНАЧЕ ИСТИНА
	                      |	КОНЕЦ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТПродажи.Продавец");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Сотрудники", Параметры.Сотрудники);
	Запрос.УстановитьПараметр("СотрудникиУказаны", Параметры.Сотрудники.Количество() > 0);
	Запрос.УстановитьПараметр("Контрагенты", Параметры.Контрагенты);
	Запрос.УстановитьПараметр("КонтрагентыУказаны", Параметры.Контрагенты.Количество() > 0);
	Запрос.УстановитьПараметр("ТоварныеГруппы", Параметры.ТоварныеГруппы);
	Запрос.УстановитьПараметр("ТоварныеГруппыУказаны", Параметры.ТоварныеГруппы.Количество() > 0);
	Запрос.УстановитьПараметр("Магазины", Параметры.Магазины);
	Запрос.УстановитьПараметр("МагазиныУказаны", Параметры.Магазины.Количество() > 0);
	Запрос.УстановитьПараметр("ТипыНоменклатуры", Параметры.ТипыНоменклатуры);
	Запрос.УстановитьПараметр("ТипыНоменклатурыУказаны", Параметры.ТипыНоменклатуры.Количество() > 0);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьТаблицуПроцентыПланаРентабельностиПоМенеджеру(Период, Менеджер, Показатель) Экспорт
	ТекстПродаж = РегистрыНакопления.СебестоимостьПродаж.ТекстПродажССебестоимостью("Сотрудник = &Менеджер");
	Запрос = Новый Запрос(ТекстПродаж + ";
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ПродажиОбороты.Сотрудник КАК Сотрудник,
	                      |	ПродажиОбороты.ДокументПродажи КАК ДокументПродажи,
	                      |	СУММА(ПродажиОбороты.Прибыль) КАК Прибыль,
	                      |	СУММА(ПродажиОбороты.Выручка) КАК Выручка,
	                      |	ВЫРАЗИТЬ(ЕСТЬNULL(ПлановыеПоказателиСрезПоследних.План, 0) КАК ЧИСЛО) КАК План
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	ВТПродажиССебестоимостью КАК ПродажиОбороты
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеПоказатели.СрезПоследних(
	                      |				&ДатаНач,
	                      |				Сотрудник = &Менеджер
	                      |					И Показатель = &Показатель) КАК ПлановыеПоказателиСрезПоследних
	                      |		ПО ПродажиОбороты.Сотрудник = ПлановыеПоказателиСрезПоследних.Сотрудник
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ПродажиОбороты.Сотрудник,
	                      |	ПродажиОбороты.ДокументПродажи,
	                      |	ВЫРАЗИТЬ(ЕСТЬNULL(ПлановыеПоказателиСрезПоследних.План, 0) КАК ЧИСЛО)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.Сотрудник КАК Сотрудник,
	                      |	ВТ.ДокументПродажи КАК ДокументПродажи,
	                      |	ВТ.Прибыль КАК Прибыль,
	                      |	ВТ.План КАК План,
	                      |	ВЫРАЗИТЬ(ВЫБОР
	                      |			КОГДА ВТ.План = 0 или ВТ.Выручка = 0
	                      |				ТОГДА 100
	                      |			ИНАЧЕ ВТ.Прибыль / ВТ.Выручка * 100 / ВТ.План * 100
	                      |		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК Процент
	                      |ИЗ
	                      |	ВТ КАК ВТ");
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецМесяца(Период)));
	Запрос.УстановитьПараметр("Менеджер", Менеджер);
	Запрос.УстановитьПараметр("Показатель", Показатель);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ТЗ;	
КонецФункции

#КонецОбласти 
