
#Область Формирование_движений

Процедура СформироватьДвижения(ДокОбъект) Экспорт	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеИзПереработки") Тогда
		// У документа нет хозяйственной операции - долг перед переработчиком формируется
		// на стоимость его услуг с НДС (волна 12, услуга капитализируется в себестоимость).
		СформироватьПоУслугамПереработчика(ДокОбъект);
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.НалоговаяНакладнаяПокупка") Тогда
		// Проверяется до отбора по хозяйственной операции: у накладной с незаполненной операцией
		// сторно молча не выполнилось бы, а долг в налоговом регистре остался - расчеты разъехались бы.
		СформироватьПоНалоговойНакладнойПокупки(ДокОбъект);
		Возврат;
	КонецЕсли;
	Если Не ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПоставщиками(ДокОбъект.ХозяйственнаяОперация) Тогда Возврат КонецЕсли;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда 
		Если ДокОбъект.Контрагент = Справочники.Контрагенты.Migration тогда Возврат; КонецЕсли;
		// Суммы регистра - в основной валюте, зачёт авансов - тоже (аванс - оплата в основной валюте).
		СуммаДокумента = СуммаВОсновнойВалюте(ДокОбъект, ДокОбъект.Сумма);
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧЗачётАвансов, Ложь, Ложь, Истина, СуммаДокумента);
		СформироватьПоДопРасходам(ДокОбъект);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику") Тогда
		СуммаДокумента = СуммаВОсновнойВалюте(ДокОбъект, ДокОбъект.Сумма);
		// Возврат по поступлению, покрытому накладной покупки, - на объект и аналитики приёма долга накладной (Ф1
		// docs/plans/commerce-two-orgs.md): организация и договор поступления, контрагент накладной.
		Основание = ?(ЗначениеЗаполнено(ДокОбъект.Основание), ДокОбъект.Основание, ДокОбъект.Ссылка);
		ОбъектыРасчетов = ОбъектыРасчетовОснования(Основание);
		// BSLLS:YoLetterUsage-off
		ТЗАвансы = РегистрыНакопления.ВзаиморасчётыСПокупателями.СтрокиПоОбъектамРасчетов(ОбъектыРасчетов, СуммаДокумента);
		// BSLLS:YoLetterUsage-on
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ТЗАвансы, Ложь, Истина, Ложь, СуммаДокумента);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеДополнительныхРасходов") Тогда 		
		СуммаРаспределения = ДокОбъект.Сумма + ДокОбъект.ТЧТовары.Итог("Сумма");
		Если Не ДокОбъект.ЦенаВключаетНДС Тогда
			СуммаРаспределения = СуммаРаспределения + ДокОбъект.СуммаНДС + ДокОбъект.ТЧТовары.Итог("СуммаНДС");	
		КонецЕсли;	
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧЗачётАвансов, Ложь, Ложь, Истина, СуммаРаспределения);	
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств") Тогда			
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Истина, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда			
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Ложь, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Истина, Ложь, ДокОбъект.Сумма);		
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда	
		СформироватьПоПлатёжномуДокументу(ДокОбъект, ДокОбъект.ТЧОснования, Истина, Ложь, Ложь, ДокОбъект.Сумма);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаДолга") Тогда
		Движения = ДокОбъект.Движения;
		//Мас = ДокОбъект.ДополнительныеСвойства.ТЗКредиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПоставщиком", Истина));
		//Для Каждого Стр Из Мас Цикл
		//	ОбъектРасчётов = ?(ТипЗнч(Стр.ОбъектРасчётов) = Тип("СправочникСсылка.ДоговорыСКонтрагентами"), ДокОбъект.Ссылка, Стр.ОбъектРасчётов);
		//	Движение(Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.КонтрагентКредитор, Стр.Договор, ОбъектРасчётов, ВалютаРегламентированногоУчета, Стр.Сумма, Ложь); 
		//КонецЦикла;
		//Мас = ДокОбъект.ДополнительныеСвойства.ТЗДебиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПоставщиком", Истина));
		Для Каждого Стр Из ДокОбъект.ДополнительныеСвойства.ТЗДебиторскаяЗадолженность Цикл
			ОбъектРасчётов = Стр.ОбъектРасчётов;
			Движение(Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.КонтрагентДебитор, , ОбъектРасчётов, Стр.Сумма, Истина);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ТЗДопРасходы = ДокОбъект.ТЧДополнительныеРасходы.Выгрузить();
		ТЗДопРасходы.Свернуть("Контрагент,Договор","Сумма"); 
		Для Каждого Стр из ТЗДопРасходы Цикл 
			Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, Стр.Контрагент, Стр.Договор, ДокОбъект.Ссылка, Стр.Сумма, Ложь);	
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СертификатНаОплату") Тогда
		Если ЗначениеЗаполнено(ДокОбъект.Поступление) Тогда
			// Аналитики сертификата - поступления; на покрытой накладной - аналитики приёма долга накладной.
			ОбъектыРасчетов = ОбъектыРасчетовОснования(ДокОбъект.Поступление);
			// BSLLS:YoLetterUsage-off
			Строки = РегистрыНакопления.ВзаиморасчётыСПокупателями.СтрокиПоОбъектамРасчетов(ОбъектыРасчетов, ДокОбъект.Сумма);
			// BSLLS:YoLetterUsage-on
			Для Каждого Стр Из Строки Цикл
				Движение(ДокОбъект.Движения, ДокОбъект.Дата, ?(Стр.Организация = Неопределено, ДокОбъект.Организация,
					Стр.Организация), ?(Стр.Контрагент = Неопределено, ДокОбъект.Поступление.Контрагент, Стр.Контрагент),
					?(Стр.Договор = Неопределено, ДокОбъект.Поступление.Договор, Стр.Договор), Стр.Основание, Стр.Сумма, Истина);
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщикуНалоговый") Тогда
		Сумма = 0;
		Для Каждого Стр из ДокОбъект.ТЧТовары Цикл 
			Если Не ЗначениеЗаполнено(Стр.ПоступлениеТовара) Тогда 
				Сумма = Сумма + Стр.СуммаСНДС;
			КонецЕсли;
		КонецЦикла;
		Если Не Сумма = 0 Тогда 
			Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор,
				ДокОбъект.Ссылка, СуммаВОсновнойВалюте(ДокОбъект, Сумма), Истина, Сумма);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура СформироватьПоПлатёжномуДокументу(ДокОбъект, ТЧАвансы, Приход, Сторно, ЭтоДокументРасчётов, СуммаРаспределения)
	ЭтоОплата = РаботаСВалютами.ЭтоПлатежныйДокумент(ДокОбъект);
	ДатаПроведения = ДокОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаПроведения) Тогда Возврат КонецЕсли;
	СуммаОстаток = СуммаРаспределения;
	Движения = ДокОбъект.Движения;
	ЕстьАналитики = ТипЗнч(ТЧАвансы) = Тип("ТаблицаЗначений") И ТЧАвансы.Колонки.Найти("Контрагент") <> Неопределено;
	// Строка оплаты по налоговой накладной покупки разносится по долгу её поступлений, остаток - аванс (Ф3.1).
	АвансСверхДолга = 0;
	НачатьРазнесениеПоДолгуНакладныхПокупки(ДокОбъект);
	// BSLLS:YoLetterUsage-off
	ПоДолгуНакладной = ЭтоОплата И Не ЭтоДокументРасчётов;
	// BSLLS:YoLetterUsage-on
	Для Каждого Стр Из ТЧАвансы Цикл
		Если ОплатаНакладнойПоДолгуПоступлений(ДокОбъект, Стр.Основание, Сторно, ПоДолгуНакладной) Тогда
			АвансСверхДолга = АвансСверхДолга + ОплатитьДолгНакладнойПокупки(ДокОбъект, Стр, Приход, ДатаПроведения);
		ИначеЕсли ЭтоДокументРасчётов Тогда
			// Сторнируем аванс
			Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, Стр.Основание, ?(Сторно, Стр.Сумма, -Стр.Сумма), Не Приход);
			// Делаем задолженность по документу
			Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, ?(Сторно, -Стр.Сумма, Стр.Сумма), Приход); 
			// Оплачиваем его
			Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор, ДокОбъект.Ссылка, ?(Сторно, -Стр.Сумма, Стр.Сумма), Не Приход);	
		Иначе
			// Накладная покупки несет долг и в обычном регистре, поэтому оплата, выписанная прямо
			// на нее, тоже должна его гасить. До переезда расчетов долг накладной жил только
			// в налоговом регистре, и такие оплаты сюда не писались.
			Если ЭтоОплата Тогда
				// Сумма строки - в валюте платежа: долг закрывается по курсу объекта, разница - курсовая.
				Оплата = РаботаСВалютами.СтрокаОплатыВРасчеты(ДокОбъект, Стр.Сумма, Стр.Основание, "ВзаиморасчётыСПоставщиками", Сторно);
				Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор,
					Стр.Основание, Оплата.Сумма, Приход,
					Оплата.СуммаВВалюте);
			Иначе
				// Возврат на накладную покупки - с аналитиками приёма долга (см. ОбъектыРасчетовОснования).
				Организация = ДокОбъект.Организация;
				Контрагент = ДокОбъект.Контрагент;
				Договор = ДокОбъект.Договор;
				Если ЕстьАналитики И Стр.Контрагент <> Неопределено Тогда
					Организация = Стр.Организация;
					Контрагент = Стр.Контрагент;
					Договор = Стр.Договор;
				КонецЕсли;
				Движение(ДокОбъект.Движения, ДатаПроведения, Организация, Контрагент, Договор, Стр.Основание,
					?(Сторно, -Стр.Сумма, Стр.Сумма), Приход);
			КонецЕсли;
		КонецЕсли;
		СуммаОстаток = СуммаОстаток - Стр.Сумма;
	КонецЦикла;
	СуммаАванса = Неопределено;
	Если ЭтоОплата Тогда
		// Аванс - в основной валюте разностью сумм (копейки округления строк остаются в нём), в валюте - как есть.
		СуммаАванса = ?(Сторно, -СуммаОстаток, СуммаОстаток) + АвансСверхДолга;
		СуммаОстаток = РаботаСВалютами.АвансПлатежаВОсновнойВалюте(ДокОбъект) + АвансСверхДолга;
	КонецЕсли;
	Движение(ДокОбъект.Движения, ДатаПроведения, ДокОбъект.Организация, ДокОбъект.Контрагент, ДокОбъект.Договор,
		ДокОбъект.Ссылка, ?(Сторно, -СуммаОстаток, СуммаОстаток), Приход,
		СуммаАванса);
КонецПроцедуры

// Строка оплаты поставщику по налоговой накладной покупки в основной валюте разносится по долгу её поступлений
// (Ф3.1 docs/plans/commerce-two-orgs.md); строка в валюте или по валютной накладной идёт прежним путём.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёж.
//  Основание - ДокументСсылка - основание строки.
//  Сторно    - Булево - возврат денег от поставщика.
//  ПоДолгуНакладной - Булево - строка платёжного документа (не зачёт аванса).
//
// Возвращаемое значение:
//  Булево
//
Функция ОплатаНакладнойПоДолгуПоступлений(ДокОбъект, Основание, Сторно, ПоДолгуНакладной)
	ЭтоНакладная = ТипЗнч(Основание) = Тип("ДокументСсылка.НалоговаяНакладнаяПокупка") И ЗначениеЗаполнено(Основание);
	Если Не ПоДолгуНакладной Или Сторно Или Не ЭтоНакладная Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).ВВалюте
		И Не РаботаСВалютами.ВалютаИКурсОбъекта(Основание).ВВалюте;
КонецФункции

// Движения строки оплаты накладной покупки по долгу её объектов (см. РазнестиПоДолгуНакладнойПокупки).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёж.
//  Стр       - СтрокаТабличнойЧасти - строка ТЧОснования.
//  Приход    - Булево - вид движения записей.
//  ДатаПроведения - Дата - период записей.
//
// Возвращаемое значение:
//  Число - сумма сверх долга (аванс платежа).
//
Функция ОплатитьДолгНакладнойПокупки(ДокОбъект, Стр, Приход, ДатаПроведения)
	// Текущие остатки - см. ОплатитьДолгНакладной регистра покупателей.
	Разнесение = РазнестиПоДолгуНакладнойПокупки(ДокОбъект, Стр.Основание, Стр.Сумма);
	Для Каждого Часть Из Разнесение.Строки Цикл
		// BSLLS:YoLetterUsage-off
		Движение(ДокОбъект.Движения, ДатаПроведения, Часть.Организация, Часть.Контрагент, Часть.Договор,
			Часть.ОбъектРасчётов, Часть.Сумма, Приход, , Часть.Валюта);
		// BSLLS:YoLetterUsage-on
	КонецЦикла;
	Возврат Разнесение.Остаток;
КонецФункции

// Переносит расчеты с поступлений-оснований на налоговую накладную покупки: долг каждого
// поступления и его оплаты сторнируются, а накладная принимает их на себя.
//
// Знаки обратны продаже: наш долг поставщику в регистре - расход (отрицательный остаток),
// см. комментарий в СформироватьПоУслугамПереработчика. Организация, договор и валюта берутся
// с поступления - именно с ними долг был записан, иначе сторно его не погасит.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладнаяПокупка - проводимая накладная.
//
Процедура СформироватьПоНалоговойНакладнойПокупки(ДокОбъект)
	ДатаНакладной = ДокОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаНакладной) Тогда
		Возврат;
	КонецЕсли;
	ТЗПоступления = РаботаСДокументами.ОснованияНалоговойНакладной(ДокОбъект, "ПоступлениеТовара");
	Если ТЗПоступления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	РеквизитыПоступлений = ДанныеПоступлений(ТЗПоступления.ВыгрузитьКолонку("Основание"));
	// Покрытые суммы - в валюте поступления; регистр ведётся в основной валюте, а долг поступления записан
	// по его курсу - по нему и сторнируется, иначе разница курсов оставила бы вечный остаток.
	Для Каждого Стр Из ТЗПоступления Цикл
		Реквизиты = РеквизитыПоступлений.Получить(Стр.Основание);
		Если Реквизиты <> Неопределено Тогда
			Стр.Сумма = РаботаСВалютамиКлиентСервер.СуммаРегл(Стр.Сумма, Реквизиты.Курс);
		КонецЕсли;
	КонецЦикла;
	// BSLLS:YoLetterUsage-off
	ВалютыДолга = РегистрыНакопления.ВзаиморасчётыСПокупателями.ВалютыСобственногоДолга("ВзаиморасчётыСПоставщиками",
		ТЗПоступления.ВыгрузитьКолонку("Основание"));
	// BSLLS:YoLetterUsage-on
	ДолгПоПоступлениям(ДокОбъект, ТЗПоступления, РеквизитыПоступлений, ДатаНакладной, ВалютыДолга);
	ОплатыПоПоступлениям(ДокОбъект, ТЗПоступления, РеквизитыПоступлений);
КонецПроцедуры

// Сторнирует долг поступлений и заводит его на накладную покупки.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладнаяПокупка - проводимая накладная.
//  ТЗПоступления - ТаблицаЗначений - покрытые поступления, колонки Основание и Сумма.
//  РеквизитыПоступлений - Соответствие - реквизиты поступлений.
//  ДатаНакладной - Дата - период движений долга.
//  ВалютыДолга - Соответствие - валюта измерения собственного долга поступления: сторно - в ней, приём - в каноническом
//                виде (см. регистр покупателей, ДолгПоОтгрузкам).
//
Процедура ДолгПоПоступлениям(ДокОбъект, ТЗПоступления, РеквизитыПоступлений, ДатаНакладной, ВалютыДолга)
	Движения = ДокОбъект.Движения;
	Для Каждого Стр Из ТЗПоступления Цикл
		Реквизиты = РеквизитыПоступлений.Получить(Стр.Основание);
		Если Реквизиты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Сторно - под контрагентом поступления (его долг записан под ним), приём - под контрагентом накладной.
		Движение(Движения, ДатаНакладной, Реквизиты.Организация, Реквизиты.Контрагент,
			Реквизиты.Договор, Стр.Основание, -Стр.Сумма, Ложь, , ВалютыДолга.Получить(Стр.Основание));
		Движение(Движения, ДатаНакладной, Реквизиты.Организация, ДокОбъект.Контрагент,
			Реквизиты.Договор, ДокОбъект.Ссылка, Стр.Сумма, Ложь);
	КонецЦикла;
КонецПроцедуры

// Сторнирует оплаты поступлений и заводит их на накладную покупки.
// Период движения - дата платежа, а не накладной: см. одноименную процедуру регистра покупателей.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.НалоговаяНакладнаяПокупка - проводимая накладная.
//  ТЗПоступления - ТаблицаЗначений - покрытые поступления, колонки Основание и Сумма.
//  РеквизитыПоступлений - Соответствие - реквизиты поступлений.
//
Процедура ОплатыПоПоступлениям(ДокОбъект, ТЗПоступления, РеквизитыПоступлений)
	// Фактические записи этого регистра по поступлениям от оплат снимка денег, без платежей со строкой на саму
	// накладную (Ф5 docs/plans/commerce-two-orgs.md): оплата, не записавшая расчётов, не даёт ложного долга.
	Запрос = Новый Запрос;
	// BSLLS:YoLetterUsage-off
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Период КАК Период,
	|	Т.ВидДвижения КАК ВидДвижения,
	|	Т.ОбъектРасчётов КАК Поступление,
	|	Т.Сумма КАК Сумма,
	|	Т.Валюта КАК Валюта
	|ИЗ
	|	РегистрНакопления.ВзаиморасчётыСПоставщиками КАК Т
	|ГДЕ
	|	Т.ОбъектРасчётов В (&Поступления)
	|	И Т.Регистратор В (&Оплаты)";
	// BSLLS:YoLetterUsage-on
	Запрос.УстановитьПараметр("Поступления", ТЗПоступления.ВыгрузитьКолонку("Основание"));
	// BSLLS:YoLetterUsage-off
	Запрос.УстановитьПараметр("Оплаты", РегистрыНакопления.ВзаиморасчётыСПокупателями.ПереносимыеОплаты(ДокОбъект));
	// BSLLS:YoLetterUsage-on
	Выборка = Запрос.Выполнить().Выбрать();
	Движения = ДокОбъект.Движения;
	Пока Выборка.Следующий() Цикл
		Реквизиты = РеквизитыПоступлений.Получить(Выборка.Поступление);
		СтрокаПокрытия = ТЗПоступления.Найти(Выборка.Поступление, "Основание");
		Если Реквизиты = Неопределено Или СтрокаПокрытия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Покрытая сумма уже в основной валюте (см. СформироватьПоНалоговойНакладнойПокупки).
		Сумма = РаботаСДокументами.СуммаВДолеПокрытия(Выборка.Сумма, СтрокаПокрытия.Сумма, Реквизиты.СуммаДокумента);
		Приход = Выборка.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение(Движения, Выборка.Период, Реквизиты.Организация, Реквизиты.Контрагент,
			Реквизиты.Договор, Выборка.Поступление, -Сумма, Приход, , Выборка.Валюта);
		Движение(Движения, Выборка.Период, Реквизиты.Организация, ДокОбъект.Контрагент,
			Реквизиты.Договор, ДокОбъект.Ссылка, Сумма, Приход);
	КонецЦикла;
КонецПроцедуры

// BSLLS:YoLetterUsage-off
// Зеркало разнесения у поставщиков (Ф3.1 docs/plans/commerce-two-orgs.md): строка оплаты поставщику по налоговой
// накладной покупки - сначала долг, принятый накладной, затем поступления из её строк по дате. Наш долг поставщику в
// регистре - отрицательный остаток, доступный долг - его модуль. Подробности - в регистре покупателей
// (РазнестиПоДолгуНакладной).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёж или документ удержания НДС.
//  Накладная - ДокументСсылка.НалоговаяНакладнаяПокупка - накладная строки.
//  Сумма     - Число - сумма строки в основной валюте.
//  Граница   - Граница, Неопределено - остатки на момент до документа; Неопределено - текущие.
//
// Возвращаемое значение:
//  Структура - Строки (ТаблицаЗначений: ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Сумма) и Остаток
//              (Число - сумма сверх долга).
//
Функция РазнестиПоДолгуНакладнойПокупки(ДокОбъект, Накладная, Сумма, Граница = Неопределено) Экспорт
	Объекты = ОбъектыДолгаНакладнойПокупки(ДокОбъект, Накладная, Граница);
	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("ОбъектРасчётов");
	Строки.Колонки.Добавить("Организация");
	Строки.Колонки.Добавить("Контрагент");
	Строки.Колонки.Добавить("Договор");
	Строки.Колонки.Добавить("Валюта");
	Строки.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	Остаток = Сумма;
	Для Каждого Объект Из Объекты Цикл
		Если Остаток <= 0 Тогда
			Прервать;
		КонецЕсли;
		Часть = Мин(Остаток, Объект.Остаток);
		Если Часть <= 0 Тогда
			Продолжить;
		КонецЕсли;
		НС = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Объект);
		НС.Сумма = Часть;
		Объект.Остаток = Объект.Остаток - Часть;
		Остаток = Остаток - Часть;
	КонецЦикла;
	Возврат Новый Структура("Строки, Остаток", Строки, Остаток);
КонецФункции

// Сбрасывает рабочую таблицу остатков разнесения (см. РазнестиПоДолгуНакладной): объект документа живёт между
// записями, и прежние остатки не должны дойти до нового проведения.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - платёж или документ удержания НДС.
//
Процедура НачатьРазнесениеПоДолгуНакладныхПокупки(ДокОбъект) Экспорт
	ДокОбъект.ДополнительныеСвойства.Вставить(ИмяСвойстваОстатковДолга(), Новый Соответствие);
КонецПроцедуры

// Уменьшает доступный остаток объекта рабочей таблицы разнесения (документ удержания: его прежнее распределение уже
// занимает часть долга).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//  Накладная - ДокументСсылка.НалоговаяНакладнаяПокупка - накладная.
//  Строки    - ТаблицаЗначений - ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Сумма.
//  Граница   - Граница, Неопределено - см. РазнестиПоДолгуНакладной.
//
Процедура ЗанятьДолгНакладнойПокупки(ДокОбъект, Накладная, Строки, Граница = Неопределено) Экспорт
	Объекты = ОбъектыДолгаНакладнойПокупки(ДокОбъект, Накладная, Граница);
	Для Каждого Строка Из Строки Цикл
		Ключ = КлючОбъектаДолга(Строка);
		Для Каждого Объект Из Объекты Цикл
			Если КлючОбъектаДолга(Объект) = Ключ Тогда
				Объект.Остаток = Объект.Остаток - Строка.Сумма;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Объекты долга накладной в порядке разнесения - строки рабочей таблицы документа (общие объекты разных накладных -
// одни и те же структуры).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ.
//  Накладная - ДокументСсылка.НалоговаяНакладнаяПокупка - накладная.
//  Граница   - Граница, Неопределено - см. РазнестиПоДолгуНакладной.
//
// Возвращаемое значение:
//  Массив из Структура - ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Остаток.
//
Функция ОбъектыДолгаНакладнойПокупки(ДокОбъект, Накладная, Граница)
	ИмяСвойства = ИмяСвойстваОстатковДолга();
	Если Не ДокОбъект.ДополнительныеСвойства.Свойство(ИмяСвойства) Тогда
		НачатьРазнесениеПоДолгуНакладныхПокупки(ДокОбъект);
	КонецЕсли;
	Таблица = ДокОбъект.ДополнительныеСвойства[ИмяСвойства];
	ПоНакладной = Таблица.Получить(Накладная);
	Если ПоНакладной <> Неопределено Тогда
		Возврат ПоНакладной;
	КонецЕсли;
	// Общие объекты уже прочитанных накладных - те же структуры: остаток у них общий.
	Прочитанные = Новый Соответствие;
	Для Каждого КлючИЗначение Из Таблица Цикл
		Для Каждого Объект Из КлючИЗначение.Значение Цикл
			Прочитанные.Вставить(КлючОбъектаДолга(Объект), Объект);
		КонецЦикла;
	КонецЦикла;
	// BSLLS:SetPrivilegedMode-off - остатки чужих поступлений накладной читаются при проведении платежа
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Основания.ПоступлениеТовара КАК Объект
	                      |ПОМЕСТИТЬ ВТОбъекты
	                      |ИЗ
	                      |	Документ.НалоговаяНакладнаяПокупка.ТЧТовары КАК Основания
	                      |ГДЕ
	                      |	Основания.Ссылка = &Накладная
	                      |	И Основания.ПоступлениеТовара <> ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг.ПустаяСсылка)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Основания.ПоступлениеТовара
	                      |ИЗ
	                      |	Документ.НалоговаяНакладнаяПокупка.ТЧУслуги КАК Основания
	                      |ГДЕ
	                      |	Основания.Ссылка = &Накладная
	                      |	И Основания.ПоступлениеТовара <> ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг.ПустаяСсылка)
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	&Накладная
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Ост.ОбъектРасчётов КАК ОбъектРасчётов,
	                      |	Ост.Организация КАК Организация,
	                      |	Ост.Контрагент КАК Контрагент,
	                      |	Ост.Договор КАК Договор,
	                      |	Ост.Валюта КАК Валюта,
	                      |	-СУММА(Ост.СуммаОстаток) КАК Остаток,
	                      |	ВЫБОР
	                      |		КОГДА Ост.ОбъектРасчётов = &Накладная
	                      |			ТОГДА 0
	                      |		ИНАЧЕ 1
	                      |	КОНЕЦ КАК Очередь,
	                      |	ЕСТЬNULL(ВЫРАЗИТЬ(Ост.ОбъектРасчётов КАК Документ.ПоступлениеТоваровУслуг).Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОбъекта
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПоставщиками.Остатки(
	                      |			&Граница,
	                      |			ОбъектРасчётов В
	                      |					(ВЫБРАТЬ
	                      |						ВТОбъекты.Объект КАК Объект
	                      |					ИЗ
	                      |						ВТОбъекты КАК ВТОбъекты)
	                      |				И Валюта В (&ВалютыОсновные)) КАК Ост
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Ост.ОбъектРасчётов,
	                      |	Ост.Организация,
	                      |	Ост.Контрагент,
	                      |	Ост.Договор,
	                      |	Ост.Валюта,
	                      |	ВЫРАЗИТЬ(Ост.ОбъектРасчётов КАК Документ.ПоступлениеТоваровУслуг).Дата
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Очередь,
	                      |	ДатаОбъекта,
	                      |	Ост.ОбъектРасчётов");
	Запрос.УстановитьПараметр("Накладная", Накладная);
	// Основная валюта в измерении - пустая ссылка (покупатели) или сама валюта (поставщики).
	ВалютыОсновные = Новый Массив;
	ВалютыОсновные.Добавить(Справочники.Валюты.ПустаяСсылка());
	ВалютыОсновные.Добавить(РаботаСВалютами.ОсновнаяВалюта());
	Запрос.УстановитьПараметр("ВалютыОсновные", ВалютыОсновные);
	Если Граница = Неопределено Тогда
		// Текущие остатки - без периода виртуальной таблицы.
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Граница,", ",");
	Иначе
		Запрос.УстановитьПараметр("Граница", Граница);
	КонецЕсли;
	Остатки = Запрос.Выполнить().Выгрузить();
	// BSLLS:YoLetterUsage-off
	МенеджерПокупателей = РегистрыНакопления.ВзаиморасчётыСПокупателями;
	МенеджерПокупателей.ДолгНакладнойВКаноническомВиде(Остатки, Накладная, РаботаСВалютами.ОсновнаяВалюта());
	МенеджерПокупателей.ПрименитьПоправкиПереноса(ДокОбъект, Накладная, Остатки, Истина);
	// BSLLS:YoLetterUsage-on
	Результат = Новый Массив;
	Для Каждого Выборка Из Остатки Цикл
		Если Выборка.Остаток <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Объект = Новый Структура("ОбъектРасчётов, Организация, Контрагент, Договор, Валюта, Остаток");
		ЗаполнитьЗначенияСвойств(Объект, Выборка);
		Ключ = КлючОбъектаДолга(Объект);
		Прежний = Прочитанные.Получить(Ключ);
		Результат.Добавить(?(Прежний = Неопределено, Объект, Прежний));
	КонецЦикла;
	Таблица.Вставить(Накладная, Результат);
	Возврат Результат;
КонецФункции

Функция КлючОбъектаДолга(Объект)
	Части = Новый Массив;
	Части.Добавить(Строка(Объект.ОбъектРасчётов.УникальныйИдентификатор()));
	Части.Добавить(Строка(Объект.Организация.УникальныйИдентификатор()));
	Части.Добавить(Строка(Объект.Контрагент.УникальныйИдентификатор()));
	Части.Добавить(Строка(Объект.Договор.УникальныйИдентификатор()));
	Части.Добавить(Строка(Объект.Валюта.УникальныйИдентификатор()));
	Возврат СтрСоединить(Части, "/");
КонецФункции

Функция ИмяСвойстваОстатковДолга()
	Возврат "ОстаткиДолгаНакладныхПокупки";
КонецФункции
// BSLLS:YoLetterUsage-on

// Объекты расчётов основания с учётом переезда расчётов на налоговую накладную покупки (Ф1
// docs/plans/commerce-two-orgs.md): организация и договор поступления, контрагент накладной. Подробности - в
// одноимённой функции регистра покупателей.
//
// Параметры:
//  Основание - ДокументСсылка - поступление или иной объект расчётов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. РегистрыНакопления.ВзаиморасчётыСПокупателями.ОбъектыРасчетовОснования.
//
// BSLLS:YoLetterUsage-off
Функция ОбъектыРасчетовОснования(Основание) Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ОбъектРасчётов");
	Результат.Колонки.Добавить("Организация");
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("Договор");
	Результат.Колонки.Добавить("Доля", Новый ОписаниеТипов("Число"));
	Накладные = Новый Массив;
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") И ЗначениеЗаполнено(Основание) Тогда
		Накладные = РаботаСДокументами.НакладныеПереносящиеРасчеты(
			РаботаСДокументами.НалоговыеНакладныеПоОснованиям(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основание)));
	КонецЕсли;
	Если Накладные.Количество() > 0 Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	Поступление.Организация КАК Организация,
		                      |	Поступление.Договор КАК Договор,
		                      |	Накладная.Ссылка КАК ОбъектРасчётов,
		                      |	Накладная.Контрагент КАК Контрагент
		                      |ИЗ
		                      |	Документ.ПоступлениеТоваровУслуг КАК Поступление,
		                      |	Документ.НалоговаяНакладнаяПокупка КАК Накладная
		                      |ГДЕ
		                      |	Поступление.Ссылка = &Основание
		                      |	И Накладная.Ссылка = &Накладная");
		Запрос.УстановитьПараметр("Основание", Основание);
		Запрос.УстановитьПараметр("Накладная", Накладные[0]);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НС = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Выборка);
			НС.Доля = 1;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	НС = Результат.Добавить();
	НС.ОбъектРасчётов = Основание;
	НС.Доля = 1;
	Возврат Результат;
КонецФункции

// Контрагенты, под которыми документ по основанию пишет расчёты с поставщиками: свой и контрагенты объектов
// расчётов основания. Для блокировки до записи.
//
// Параметры:
//  Основание - ДокументСсылка - основание документа.
//  Контрагент - СправочникСсылка.Контрагенты - контрагент документа.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты
//
Функция КонтрагентыРасчетовОснования(Основание, Контрагент) Экспорт
	Результат = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Контрагент);
	Для Каждого Строка Из ОбъектыРасчетовОснования(Основание) Цикл
		Если Строка.Контрагент <> Неопределено И Результат.Найти(Строка.Контрагент) = Неопределено Тогда
			Результат.Добавить(Строка.Контрагент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
// BSLLS:YoLetterUsage-on

// Возвращает реквизиты поступлений одним запросом.
//
// Параметры:
//  МассивПоступлений - Массив - ссылки на ПоступлениеТоваровУслуг.
//
// Возвращаемое значение:
//  Соответствие - ключ ДокументСсылка.ПоступлениеТоваровУслуг, значение - структура
//                 с полями Организация, Контрагент, Договор, Курс (курс поступления, для основной валюты 1),
//                 СуммаДокумента (в основной валюте).
//
Функция ДанныеПоступлений(МассивПоступлений)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Поступление.Ссылка КАК Основание,
	                      |	Поступление.Организация КАК Организация,
	                      |	Поступление.Контрагент КАК Контрагент,
	                      |	Поступление.Договор КАК Договор,
	                      |	Поступление.Валюта КАК Валюта,
	                      |	Поступление.КурсВалюты КАК КурсВалюты,
	                      |	Поступление.ВВалюте КАК ВВалюте,
	                      |	Поступление.Сумма КАК СуммаДокумента
	                      |ИЗ
	                      |	Документ.ПоступлениеТоваровУслуг КАК Поступление
	                      |ГДЕ
	                      |	Поступление.Ссылка В (&МассивПоступлений)");
	Запрос.УстановитьПараметр("МассивПоступлений", МассивПоступлений);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Реквизиты = Новый Структура("Организация, Контрагент, Договор, Курс, СуммаДокумента");
		ЗаполнитьЗначенияСвойств(Реквизиты, Выборка);
		Реквизиты.Курс = РаботаСВалютами.ВалютаИКурсДокумента(Выборка).Курс;
		Реквизиты.СуммаДокумента = РаботаСВалютамиКлиентСервер.СуммаРегл(Выборка.СуммаДокумента, Реквизиты.Курс);
		Результат.Вставить(Выборка.Основание, Реквизиты);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура СформироватьПоУслугамПереработчика(ДокОбъект)
	// Договор с переработчиком не ведётся - объект расчётов сам документ поступления.
	// Наш долг в регистре - расход (отрицательный остаток), как у поступления товаров:
	// так его читает ПолучитьЗадолженностьПоставшиковПоКлассификации и так его гасит
	// оплата поставщику приходом. Приходом долг записывался до 2.0.14.15 - оплата его удваивала.
	// Услуги - в валюте документа: долг в основной валюте по его курсу (тем же числом, что капитализация
	// стоимости и НДС в себестоимость), в валюте - как есть.
	СуммаВВалюте = ДокОбъект.СтоимостьУслуг + ДокОбъект.СуммаНДСУслуг;
	Если СуммаВВалюте = 0 Тогда
		Возврат;
	КонецЕсли;
	Курс = РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс;
	Сумма = РаботаСВалютамиКлиентСервер.СуммаРегл(ДокОбъект.СтоимостьУслуг, Курс)
		+ РаботаСВалютамиКлиентСервер.СуммаРегл(ДокОбъект.СуммаНДСУслуг, Курс);
	Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Контрагент,
		Справочники.ДоговорыСКонтрагентами.ПустаяСсылка(), ДокОбъект.Ссылка, Сумма, Ложь, СуммаВВалюте);
КонецПроцедуры

// Запись регистра. Сумма - в основной валюте; валюта записи и сумма в ней - по объекту расчётов
// (см. РаботаСВалютами.ВалютаИКурсОбъекта): любой документ, пишущий по валютному объекту, - оплата,
// корректировка, сертификат, налоговая накладная, - попадает в ту же валюту, и остаток не дробится.
//
// Параметры:
//  Движения - КоллекцияДвижений - движения документа.
//  ДатаДвижения - Дата - период записи.
//  Организация - СправочникСсылка.Организации - измерение записи.
//  Контрагент - СправочникСсылка.Контрагенты - измерение записи.
//  Договор - СправочникСсылка.ДоговорыСКонтрагентами - измерение записи.
//  ОбъектРасчётов - ДокументСсылка - измерение записи, по нему определяется валюта.
//  Сумма - Число - сумма в основной валюте.
//  Приход - Булево - вид движения.
//  СуммаВВалюте - Число, Неопределено - точная сумма в валюте объекта (движение на сам документ);
//                 Неопределено - пересчёт суммы по курсу объекта.
//  ВалютаЗаписи - СправочникСсылка.Валюты, Неопределено - валюта измерения записи по объекту в основной валюте (пустая
//                 в старых записях или основная); Неопределено - канонический вид, валюта объекта.
//
Процедура Движение(Движения, ДатаДвижения, Организация, Контрагент, Договор, ОбъектРасчётов, Сумма, Приход = Истина,
	СуммаВВалюте = Неопределено, ВалютаЗаписи = Неопределено)
	Если Сумма = 0 Тогда Возврат КонецЕсли;
	// BSLLS:YoLetterUsage-off - имя регистра
	ВалютаОбъекта = РаботаСВалютами.ВалютаОбъектаРасчетов(ОбъектРасчётов, "ВзаиморасчётыСПоставщиками");
	// BSLLS:YoLetterUsage-on
	НС = Движения.ВзаиморасчётыСПоставщиками.Добавить();
	НС.ВидДвижения = ?(Приход, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
	НС.Период = ДатаДвижения;
	НС.Организация = Организация;
	НС.Контрагент = Контрагент;
	НС.Договор = Договор;
	НС.ОбъектРасчётов = ОбъектРасчётов;
	НС.Валюта = ?(ВалютаЗаписи = Неопределено Или ВалютаОбъекта.ВВалюте, ВалютаОбъекта.Валюта, ВалютаЗаписи);
	НС.Сумма = Сумма;
	// Сумма в валюте ведётся только по валютным объектам, как в записях до валютного учёта.
	Если Не ВалютаОбъекта.ВВалюте Тогда
		Возврат;
	ИначеЕсли СуммаВВалюте = Неопределено Тогда
		НС.СуммаВВалюте = РаботаСВалютамиКлиентСервер.СуммаВВалюте(Сумма, ВалютаОбъекта.Курс);
	Иначе
		НС.СуммаВВалюте = СуммаВВалюте;
	КонецЕсли;
КонецПроцедуры

// Сумма документа в основной валюте по курсу документа (см. РаботаСВалютами.ВалютаИКурсДокумента).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ с валютой или без неё.
//  Сумма - Число - сумма в валюте документа.
//
// Возвращаемое значение:
//  Число - сумма в основной валюте.
//
Функция СуммаВОсновнойВалюте(ДокОбъект, Сумма)
	Возврат РаботаСВалютамиКлиентСервер.СуммаРегл(Сумма, РаботаСВалютами.ВалютаИКурсДокумента(ДокОбъект).Курс);
КонецФункции

// Долг перед поставщиками дополнительных расходов документа. Доп. расходы поступления - в валюте документа,
// реализации - в основной валюте.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.РеализацияТоваровУслуг - документ.
//
Процедура СформироватьПоДопРасходам(ДокОбъект) Экспорт
	ТЗДопРасходы = ДокОбъект.ТЧДополнительныеРасходы.Выгрузить();
	ТЗДопРасходы.Свернуть("Контрагент,Договор","СуммаСНДС");
	ЭтоПоступление = ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг");
	Для Каждого Стр из ТЗДопРасходы Цикл
		Сумма = ?(ЭтоПоступление, СуммаВОсновнойВалюте(ДокОбъект, Стр.СуммаСНДС), Стр.СуммаСНДС);
		Движение(ДокОбъект.Движения, ДокОбъект.Дата, ДокОбъект.Организация, Стр.Контрагент, Стр.Договор, ДокОбъект.Ссылка, Сумма, Ложь);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти	

#Область Остатки

// Просроченные долги поставщикам по поступлениям и налоговым накладным покупки на дату: срок оплаты договора
// истёк (с учётом банковских дней), долг сверх суммы кредита договора. Источник отчёта «Просроченные долги
// поставщиков».
//
// Параметры:
//  Период - Дата - дата, на которую считается просрочка
//  Отбор  - Структура - необязательные Организации, Контрагенты, Договоры, Менеджеры (списки; пустой - без отбора)
//
// Возвращаемое значение:
//  ТаблицаЗначений - ГруппировкаВсего, Организация, Контрагент, Договор, ПоступлениеТоваровУслуг, Долг, ДатаОтгрузки,
//                    КоличествоВыходных, ПросроченоДней
//
Функция ПолучитьЗадолженностьПоставшиковПоКлассификации(Период, Отбор) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	// Заполним реквизиты
	Организации = ?(Отбор.Свойство("Организации"), Отбор.Организации, Новый Массив);
	Контрагенты = ?(Отбор.Свойство("Контрагенты"), Отбор.Контрагенты, Новый Массив);	
	Договоры = ?(Отбор.Свойство("Договоры"), Отбор.Договоры, Новый Массив);
	Менеджеры = ?(Отбор.Свойство("Менеджеры"), Отбор.Менеджеры, Новый Массив);
	// Получим данные из базы
	// Дата долга налогового документа на основаниях - по раннему основанию (docs/plans/accounting-morocco-f1-s2.md):
	// соединение с датами оснований к виртуальной таблице остатков.
	// BSLLS:JoinWithVirtualTable-off
	// BSLLS:JoinWithSubQuery-off
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВсК.Организация КАК Организация,
	                      |	ВсК.Контрагент КАК Контрагент,
	                      |	ВсК.Договор КАК Договор,
	                      |	ВсК.ОбъектРасчётов КАК ПоступлениеТоваровУслуг,
	                      |	-ВсК.СуммаОстаток КАК Долг,
	                      |	НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДатыОснований.Дата, ВсК.ОбъектРасчётов.Дата), ДЕНЬ) КАК ДатаОтгрузки,
	                      |	ВсК.Договор.СрокОплаты КАК СрокОплаты,
	                      |	ВсК.Договор.СуммаКредита КАК СуммаКредита,
	                      |	ВсК.Договор.СпособРасчётаОтсрочки = ЗНАЧЕНИЕ(Перечисление.СпособыРасчётаОтсрочки.БанковскиеДни) КАК ПоБанковскимДням
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчётыСПоставщиками.Остатки(
	                      |			&Период,
	                      |			(ОбъектРасчётов ССЫЛКА Документ.ПоступлениеТоваровУслуг
	                      |				ИЛИ ОбъектРасчётов ССЫЛКА Документ.НалоговаяНакладнаяПокупка)
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьОрганизации
	                      |						ТОГДА Договор.Организация В (&Организации)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьКонтрагенты
	                      |						ТОГДА Контрагент В ИЕРАРХИИ (&Контрагенты)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ЕстьДоговоры
	                      |						ТОГДА Договор В (&Договоры)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ) КАК ВсК
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			ПокрытиеОснований.Ссылка КАК Документ,
	                      |			МИНИМУМ(ДокументыОснований.Дата) КАК Дата
	                      |		ИЗ
	                      |			Документ.ПоступлениеТоваровУслуг.Основания КАК ПокрытиеОснований
	                      |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ДокументыОснований
	                      |				ПО ПокрытиеОснований.Основание = ДокументыОснований.Ссылка
	                      |		СГРУППИРОВАТЬ ПО
	                      |			ПокрытиеОснований.Ссылка) КАК ДатыОснований
	                      |		ПО ВсК.ОбъектРасчётов = ДатыОснований.Документ
	                      |ГДЕ
	                      |	ВсК.СуммаОстаток < 0
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг,
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПроизводственныйКалендарь.Дата) КАК КоличествоВыходных
	                      |ПОМЕСТИТЬ ВТВыходные
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь
	                      |		ПО (ПроизводственныйКалендарь.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, 1) И &Период)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТ.ПоступлениеТоваровУслуг
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	""Состояние взаиморасчетов"" КАК ГруппировкаВсего,
	                      |	ВЗ.Организация КАК Организация,
	                      |	ВЗ.Контрагент КАК Контрагент,
	                      |	ВЗ.Договор КАК Договор,
	                      |	ВЗ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг,
	                      |	ВЗ.Долг КАК Долг,
	                      |	ВЗ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |	ВЗ.КоличествоВыходных КАК КоличествоВыходных,
	                      |	ВЗ.ПросроченоДней КАК ПросроченоДней
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТ.Организация КАК Организация,
	                      |		ВТ.Контрагент КАК Контрагент,
	                      |		ВТ.Договор КАК Договор,
	                      |		ВТ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг,
	                      |		ВЫБОР
	                      |			КОГДА ВТ.Долг - ВТ.СуммаКредита < 0
	                      |				ТОГДА 0
	                      |			ИНАЧЕ ВТ.Долг - ВТ.СуммаКредита
	                      |		КОНЕЦ КАК Долг,
	                      |		ВТ.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |		ВТВыходные.КоличествоВыходных КАК КоличествоВыходных,
	                      |		РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(ВТ.ДатаОтгрузки, ДЕНЬ, ВТ.СрокОплаты + ВЫБОР
	                      |					КОГДА ВТ.ПоБанковскимДням
	                      |						ТОГДА ЕСТЬNULL(ВТВыходные.КоличествоВыходных, 0)
	                      |					ИНАЧЕ 0
	                      |				КОНЕЦ), &Период, ДЕНЬ) КАК ПросроченоДней
	                      |	ИЗ
	                      |		ВТ КАК ВТ
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ ВТВыходные КАК ВТВыходные
	                      |			ПО ВТ.ПоступлениеТоваровУслуг = ВТВыходные.ПоступлениеТоваровУслуг) КАК ВЗ
	                      |ГДЕ
	                      |	ВЗ.Долг > 0
	                      |	И ВЗ.ПросроченоДней > 0");
	// BSLLS:JoinWithVirtualTable-on
	// BSLLS:JoinWithSubQuery-on
	Запрос.УстановитьПараметр("Период", КонецДня(Период));
	Запрос.УстановитьПараметр("ЕстьОрганизации", Организации.Количество() <> 0);
	Запрос.УстановитьПараметр("Организации", Организации);
	Запрос.УстановитьПараметр("ЕстьКонтрагенты", Контрагенты.Количество() <> 0);
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("ЕстьДоговоры", Договоры.Количество() <> 0);
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти 
