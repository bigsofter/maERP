Функция ИмяСвойстваЗаказа() Экспорт

	Возврат "ЗаказПотребностейПроизводства";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Раскладывает итог обеспечения одного сырья по его ключам-ПФ (см. ОбеспечениеСырьяПереработчика). Закупочное
// обеспечение остаётся на своём ключе (пределы записи закупок привязаны к ключам - ревью данных 2.0.16.103, P1);
// добавка передачи сверх закупки (итог минус закупка) раскладывается по оставшейся потребности: сначала ключу его
// собственная передача, затем по порядку ключей.
//
// Параметры:
//  Строки    - Массив из СтрокаТаблицыЗначений - строки остатков ключей этого сырья.
//  Передано  - Соответствие - ключ КлючОстатка, значение Число - передано переработчику.
//  Результат - Соответствие - пополняется покрытием ключей.
//  ТолькоПришло - Булево - см. ОбеспечениеСырьяПереработчика.
//
Процедура РазложитьПокрытиеМатериала(Строки, Передано, Результат, ТолькоПришло)

	Закупка = 0;
	ВсегоПередано = 0;
	Нужно = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Ключ = КлючОстатка(Строка);
		ЗакупкаКлюча = ?(ТолькоПришло, Строка.Пришло, Обеспечено(Строка));
		Закупка = Закупка + ЗакупкаКлюча;
		ПереданоКлюча = Передано[Ключ];
		ВсегоПередано = ВсегоПередано + ?(ПереданоКлюча = Неопределено, 0, ПереданоКлюча);
		Нужно.Вставить(Ключ, Макс(0, Строка.Потребность - Строка.ИзОстатка));
		Результат.Вставить(Ключ, ЗакупкаКлюча);
	КонецЦикла;
	// Добавка передачи: максимум, а не сумма - переданное обычно и есть купленное.
	Остаток = Макс(0, ВсегоПередано - Закупка);
	Для Каждого Строка Из Строки Цикл
		Ключ = КлючОстатка(Строка);
		ПереданоКлюча = Передано[Ключ];
		Часть = Мин(?(ПереданоКлюча = Неопределено, 0, ПереданоКлюча), Макс(0, Нужно[Ключ] - Результат[Ключ]), Остаток);
		Результат.Вставить(Ключ, Результат[Ключ] + Часть);
		Остаток = Остаток - Часть;
	КонецЦикла;
	Для Каждого Строка Из Строки Цикл
		Если Остаток <= 0 Тогда
			Прервать;
		КонецЕсли;
		Ключ = КлючОстатка(Строка);
		Часть = Мин(Остаток, Макс(0, Нужно[Ключ] - Результат[Ключ]));
		Результат.Вставить(Ключ, Результат[Ключ] + Часть);
		Остаток = Остаток - Часть;
	КонецЦикла;

КонецПроцедуры

// Дерево материалов заказа для правил ПФ переработчика.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//
// Возвращаемое значение:
//  Структура:
//   * Границы    - Соответствие - см. Документы.ЗаказПокупателя.ГраницыПереработчикаПоКлючам.
//   * КлючиСырья - Соответствие - ключ КлючОстатка ключа сырья (ПФ, сырьё, характеристика), значение Истина.
//   * ЕдинственныйПФ - Соответствие - ключ «сырьё|характеристика», значение ПФ: сырьё лежит в дереве под одним ПФ
//                      переработчика и больше нигде (для строк передачи без продукции).
//
Функция ДеревоГраницЗаказа(Заказ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Материалы.КодСтроки КАК КодСтроки,
	|	Материалы.КодСтрокиРодителя КАК КодСтрокиРодителя,
	|	Материалы.КодСтрокиПродукции КАК КодСтрокиПродукции,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.Характеристика КАК Характеристика,
	|	Материалы.СпособИзготовления КАК СпособИзготовления
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧМатериалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Материалы = Запрос.Выполнить().Выгрузить();
	Менеджер = Документы.ЗаказПокупателя;
	Границы = Менеджер.ГраницыПереработчикаПоКлючам(Материалы, Менеджер.КодыСтрокСПотомками(Материалы));
	КлючиСырья = Новый Соответствие;
	ПФСырья = Новый Соответствие;
	Для Каждого Материал Из Материалы Цикл
		Если Не ЗначениеЗаполнено(Материал.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		КлючСырья = XMLСтрока(Материал.Номенклатура) + "|" + XMLСтрока(Материал.Характеристика);
		ПФ = ?(Материал.КодСтрокиРодителя = 0, Неопределено,
			Границы[Менеджер.КлючРодителяМатериала(Материал.КодСтрокиПродукции, Материал.КодСтрокиРодителя)]);
		Если ПФ <> Неопределено Тогда
			КлючиСырья.Вставить(XMLСтрока(ПФ) + "|" + КлючСырья, Истина);
		КонецЕсли;
		ОтметитьПФСырья(ПФСырья, КлючСырья, ПФ);
	КонецЦикла;
	ЕдинственныйПФ = Новый Соответствие;
	Для Каждого КлючИЗначение Из ПФСырья Цикл
		Если КлючИЗначение.Значение <> Ложь Тогда
			ЕдинственныйПФ.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Границы, КлючиСырья, ЕдинственныйПФ", Границы, КлючиСырья, ЕдинственныйПФ);

КонецФункции

// Отмечает ПФ переработчика вхождения сырья: несколько разных ПФ или вхождение не под ПФ - Ложь (строку передачи без
// продукции такое сырьё не засчитывает).
//
// Параметры:
//  ПФСырья   - Соответствие - ключ «сырьё|характеристика», значение ПФ или Ложь; пополняется.
//  КлючСырья - Строка - ключ вхождения.
//  ПФ        - СправочникСсылка.Номенклатура, Неопределено - ПФ над вхождением.
//
Процедура ОтметитьПФСырья(ПФСырья, КлючСырья, ПФ)

	Прежний = ПФСырья[КлючСырья];
	Значение = ?(ПФ = Неопределено, Ложь, ПФ);
	Если Прежний <> Неопределено И Прежний <> Значение Тогда
		Значение = Ложь;
	КонецЕсли;
	ПФСырья.Вставить(КлючСырья, Значение);

КонецПроцедуры

// Передано переработчику по заказу на ключи сырья ПФ (см. ОбеспечениеСырьяПереработчика).
//
// Параметры:
//  Заказ    - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//  Дерево   - Структура - см. ДеревоГраницЗаказа.
//  Контекст - Структура, Неопределено - см. ОбеспечениеСырьяПереработчика.
//
// Возвращаемое значение:
//  Соответствие - ключ КлючОстатка, значение Число - передано.
//
Функция ПереданоСырьеПереработчику(Заказ, Дерево, Контекст)

	Документ = Неопределено;
	ДокументПроведен = Ложь;
	СЧерновиками = Ложь;
	Если Контекст <> Неопределено Тогда
		Документ = Контекст.Документ;
		ДокументПроведен = Контекст.Проведен;
		// Заполнение общей передачи по потребностям вычитает и черновики передач (план subcontract-multi-order, сборка 2).
		СЧерновиками = Контекст.Свойство("СЧерновиками") И Контекст.СЧерновиками;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Продукция КАК Продукция,
	|	СУММА(Товары.Количество) КАК Количество
	|ИЗ
	|	Документ.ПередачаВПереработку.ТЧТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаВПереработку КАК Передачи
	|		ПО Товары.Ссылка = Передачи.Ссылка
	|ГДЕ
	|	ВЫБОР
	|		КОГДА Товары.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|			ТОГДА Передачи.Основание
	|		ИНАЧЕ Товары.Заказ
	|	КОНЕЦ = &Заказ
	|	И ВЫБОР
	|			КОГДА Передачи.Ссылка = &Документ
	|				ТОГДА &ДокументПроведен
	|			КОГДА &СЧерновиками
	|				ТОГДА НЕ Передачи.ПометкаУдаления
	|			ИНАЧЕ Передачи.Проведен
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	Товары.Продукция");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ДокументПроведен", ДокументПроведен);
	Запрос.УстановитьПараметр("СЧерновиками", СЧерновиками);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючСырья = XMLСтрока(Выборка.Номенклатура) + "|" + XMLСтрока(Выборка.Характеристика);
		ПФ = ?(ЗначениеЗаполнено(Выборка.Продукция), Выборка.Продукция, Дерево.ЕдинственныйПФ[КлючСырья]);
		Если ПФ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ключ = XMLСтрока(ПФ) + "|" + КлючСырья;
		Если Дерево.КлючиСырья[Ключ] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Прежнее = Результат[Ключ];
		Результат.Вставить(Ключ, ?(Прежнее = Неопределено, 0, Прежнее) + Выборка.Количество);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Движения «Потребность» заказа клиента на производство.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ЗаказПокупателя - проводимый заказ.
//  Набор     - РегистрНакопленияНаборЗаписей.ПотребностиПроизводства - набор движений документа.
//
Процедура СформироватьДвиженияЗаказаКлиента(ДокОбъект, Набор)

	Если Не Документы.ЗаказПокупателя.ЗаказПроводится(ДокОбъект.ВидОперации) Тогда
		Возврат;
	КонецЕсли;
	Потребность = ПотребностьЗаказаКлиента(ДокОбъект.ТЧТовары, ДокОбъект.ТЧМатериалы);
	Для Каждого Строка Из Потребность Цикл
		Если Строка.Потребность = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.ДобавитьПриход();
		ЗаполнитьЗначенияСвойств(Запись, Строка);
		Запись.Период = ДокОбъект.Дата;
		Запись.Заказ = ДокОбъект.Ссылка;
	КонецЦикла;

КонецПроцедуры

// Движения потребностей выпуска: автовыпуск - данными механизма; ручной выпуск по заказу с одной позицией продукции -
// «ИзОстатка» по фактическому свободному расходу (см. ИзОстаткаРучногоВыпуска); прочие выпуски (без заказа, по
// требованию-накладной, несколько позиций) - пустой набор, стирающий прежние движения.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВыпускПродукции - проводимый выпуск.
//  Набор     - РегистрНакопленияНаборЗаписей.ПотребностиПроизводства - набор движений документа.
//
Процедура СформироватьДвиженияВыпуска(ДокОбъект, Набор)

	Если Производство.ЭтоАвтовыпуск(ДокОбъект) Тогда
		СформироватьДвиженияАвтовыпуска(ДокОбъект, Набор);
		Возврат;
	КонецЕсли;
	Набор.Записывать = Истина;
	Набор.Очистить();
	Если Не ДокОбъект.ВыпускБезТребованияПоЗаказу() Или ДокОбъект.ТЧГотоваяПродукция.Количество() <> 1
		Или Не ПроизводственныеЗаказы.ЭтоЗаказНаПроизводство(ДокОбъект.Основание) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из ИзОстаткаРучногоВыпуска(ДокОбъект) Цикл
		Запись = Набор.ДобавитьПриход();
		ЗаполнитьЗначенияСвойств(Запись, Строка, "Продукция, Материал, Характеристика");
		Запись.Период = ДокОбъект.Дата;
		Запись.Заказ = ДокОбъект.Основание;
		Запись.ИзОстатка = Строка.Количество;
	КонецЦикла;

КонецПроцедуры

// «ИзОстатка» ручного выпуска одной позиции P по заказу (план manual-output-from-stock, редакция 8). Ветвь - строка
// товаров заказа и P в ней: само изделие строки или свой ПФ в её дереве. Выпущенное (с ранее выпущенным по заказу
// по моменту времени) заполняет ветви по порядку строк, каждую до её количества P; предел материала ветви - норма её
// непосредственных листьев (без поддеревьев вложенных своих ПФ) на долю выпуска в ветви. Свободный расход материала -
// списанное не из партий под заказ - ложится на ключ «изделие ветви + материал» в пределах ветви и непокрытой части
// ключа «Потребность - ИзОстатка - Пришло» без движений самого выпуска. Выпуск сверх заказа и перерасход «ИзОстатка» не дают.
// Известное ограничение (риск принят владельцем 2026-10-28): выпуск P задним числом или отмена раннего выпуска P
// распределение поздних выпусков не пересчитывает - до их перепроведения.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВыпускПродукции - проводимый выпуск со сформированными движениями ТоварыВНаличии.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика, Количество.
//
Функция ИзОстаткаРучногоВыпуска(ДокОбъект)

	Результат = НоваяТаблицаСтрок("Количество");
	Заказ = ДокОбъект.Основание;
	Позиция = ДокОбъект.ТЧГотоваяПродукция[0];
	Ветви = ВетвиРучногоВыпуска(Заказ, Позиция.Номенклатура, Позиция.Характеристика);
	Если Ветви.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	РаспределитьВыпускПоВетвям(Ветви, ВыпущеноРанее(ДокОбъект, Позиция), Позиция.Количество);
	Свободно = СвободныйРасходВыпуска(ДокОбъект, Заказ);
	Запас = ЗапасКлючейЗаказа(Заказ, ДокОбъект.Ссылка);
	// Зачёт - только в часть ключа, не покрытую поступлениями под заказ: ветвь, уже обеспеченная «Пришло», свободный
	// расход не забирает, иначе соседняя ветвь осталась бы с ложным дефицитом (ревью кода и данных 2.0.16.109).
	Для Каждого Ветвь Из Ветви Цикл
		Если Ветвь.Доля > 0 Тогда
			ЗачестьРасходВетви(Результат, Ветвь, Свободно, Запас);
		КонецЕсли;
	КонецЦикла;
	Результат.Свернуть("Продукция, Материал, Характеристика", "Количество");
	Возврат Результат;

КонецФункции

// Часть ключей потребностей заказа, не покрытая поступлениями под заказ и «ИзОстатка», без движений документа -
// «Потребность - ИзОстатка - Пришло»: предел «ИзОстатка» ручного выпуска.
//
// Параметры:
//  Заказ                - ДокументСсылка.ЗаказПокупателя - заказ.
//  ИсключитьРегистратор - ДокументСсылка - документ, чьи движения не учитываются.
//
// Возвращаемое значение:
//  Соответствие - ключ КлючОстатка, значение Число.
//
Функция ЗапасКлючейЗаказа(Заказ, ИсключитьРегистратор)

	Запас = Новый Соответствие;
	Для Каждого Строка Из ОстаткиЗаказа(Заказ, ИсключитьРегистратор) Цикл
		Ключ = КлючОстатка(Строка);
		Запас.Вставить(Ключ, ЗначениеЗапаса(Запас, Ключ) + Строка.Потребность - Строка.ИзОстатка - Строка.Пришло);
	КонецЦикла;
	Возврат Запас;

КонецФункции

// Зачитывает свободный расход в листья ветви: по каждому материалу - не больше нормы ветви на её долю выпуска,
// остатка свободного расхода и непокрытой части ключа «изделие ветви + материал».
//
// Параметры:
//  Результат - ТаблицаЗначений - см. ИзОстаткаРучногоВыпуска; пополняется.
//  Ветвь     - Структура - см. ВетвиРучногоВыпуска.
//  Свободно  - ТаблицаЗначений - см. СвободныйРасходВыпуска; уменьшается.
//  Запас     - Соответствие - см. ЗапасКлючейЗаказа; уменьшается.
//
Процедура ЗачестьРасходВетви(Результат, Ветвь, Свободно, Запас)

	КлючевыеПоля = Новый Структура("Продукция, Материал, Характеристика");
	КлючевыеПоля.Продукция = Ветвь.Изделие;
	Для Каждого Лист Из Ветвь.Листья Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика", Лист.Материал, Лист.Характеристика);
		Найденные = Свободно.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Расход = Найденные[0];
		КлючевыеПоля.Материал = Лист.Материал;
		КлючевыеПоля.Характеристика = Лист.Характеристика;
		Ключ = КлючОстатка(КлючевыеПоля);
		Часть = Мин(Лист.Количество / Ветвь.Нужно * Ветвь.Доля, Расход.Количество, ЗначениеЗапаса(Запас, Ключ));
		Если Часть <= 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, КлючевыеПоля);
		НоваяСтрока.Количество = Часть;
		Расход.Количество = Расход.Количество - Часть;
		Запас.Вставить(Ключ, ЗначениеЗапаса(Запас, Ключ) - Часть);
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеЗапаса(Запас, Ключ)

	Значение = Запас[Ключ];
	Возврат ?(Значение = Неопределено, 0, Значение);

КонецФункции

// Ветви позиции ручного выпуска в заказе, в порядке строк товаров.
//
// Параметры:
//  Заказ          - ДокументСсылка.ЗаказПокупателя - заказ на производство.
//  Номенклатура   - СправочникСсылка.Номенклатура - выпускаемая позиция.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - её характеристика.
//
// Возвращаемое значение:
//  Массив из Структура - Изделие (номенклатура строки товаров), Нужно (количество позиции в ветви), Доля (0, см.
//                        РаспределитьВыпускПоВетвям), Листья (ТаблицаЗначений - Материал, Характеристика, Количество).
//
Функция ВетвиРучногоВыпуска(Заказ, Номенклатура, Характеристика)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.КодСтроки КАК КодСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.КодСтроки КАК КодСтроки,
	|	Материалы.КодСтрокиРодителя КАК КодСтрокиРодителя,
	|	Материалы.КодСтрокиПродукции КАК КодСтрокиПродукции,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.Характеристика КАК Характеристика,
	|	Материалы.СпособИзготовления КАК СпособИзготовления,
	|	Материалы.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧМатериалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Результаты = Запрос.ВыполнитьПакет();
	Товары = Результаты[0].Выгрузить();
	Материалы = Результаты[1].Выгрузить();
	СПотомками = Документы.ЗаказПокупателя.КодыСтрокСПотомками(Материалы);
	Ветви = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Ветвь = Новый Структура("Изделие, Нужно, Доля", Товар.Номенклатура, 0, 0);
		Ветвь.Вставить("Листья", НоваяТаблицаЛистьев());
		Узлы = УзлыВетви(Ветвь, Товар, Материалы, СПотомками, Номенклатура, Характеристика);
		Если Ветвь.Нужно <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Материал Из Материалы Цикл
			Если ЭтоЛистВетви(Материал, Товар, Узлы, СПотомками) Тогда
				Лист = Ветвь.Листья.Добавить();
				ЗаполнитьЗначенияСвойств(Лист, Материал, "Характеристика, Количество");
				Лист.Материал = Материал.Номенклатура;
			КонецЕсли;
		КонецЦикла;
		Ветвь.Листья.Свернуть("Материал, Характеристика", "Количество");
		Ветви.Добавить(Ветвь);
	КонецЦикла;
	Возврат Ветви;

КонецФункции

// Узлы позиции в ветви строки товаров: у самого изделия - строка товаров (код родителя 0), у своего ПФ - его узлы в
// дереве строки. Заполняет «Нужно» ветви.
//
// Параметры:
//  Ветвь          - Структура - см. ВетвиРучногоВыпуска; заполняется Нужно.
//  Товар          - СтрокаТаблицыЗначений - строка товаров заказа.
//  Материалы      - ТаблицаЗначений - строки материалов заказа.
//  СПотомками     - Соответствие - см. Документы.ЗаказПокупателя.КодыСтрокСПотомками.
//  Номенклатура   - СправочникСсылка.Номенклатура - выпускаемая позиция.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - её характеристика.
//
// Возвращаемое значение:
//  Соответствие - ключ код строки узла (родителя листьев), значение Истина.
//
Функция УзлыВетви(Ветвь, Товар, Материалы, СПотомками, Номенклатура, Характеристика)

	Узлы = Новый Соответствие;
	Если Товар.Номенклатура = Номенклатура И Товар.Характеристика = Характеристика Тогда
		Ветвь.Нужно = Товар.Количество;
		Узлы.Вставить(0, Истина);
		Возврат Узлы;
	КонецЕсли;
	Для Каждого Материал Из Материалы Цикл
		ЭтаПозиция = Материал.Номенклатура = Номенклатура И Материал.Характеристика = Характеристика;
		Если ЭтаПозиция И Материал.КодСтрокиПродукции = Товар.КодСтроки И ЭтоСвойПолуфабрикат(Материал, СПотомками) Тогда
			Ветвь.Нужно = Ветвь.Нужно + Материал.Количество;
			Узлы.Вставить(Материал.КодСтроки, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Узлы;

КонецФункции

// Лист ветви - материал строки товаров, непосредственно подчинённый узлу позиции, кроме вложенных своих ПФ (их сырьё
// закрывают их собственные выпуски).
//
// Параметры:
//  Материал   - СтрокаТаблицыЗначений - строка материалов заказа.
//  Товар      - СтрокаТаблицыЗначений - строка товаров ветви.
//  Узлы       - Соответствие - см. УзлыВетви.
//  СПотомками - Соответствие - см. Документы.ЗаказПокупателя.КодыСтрокСПотомками.
//
// Возвращаемое значение:
//  Булево - Истина у листа ветви.
//
Функция ЭтоЛистВетви(Материал, Товар, Узлы, СПотомками)

	Если Материал.КодСтрокиПродукции <> Товар.КодСтроки Или Узлы[Материал.КодСтрокиРодителя] = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Материал.Номенклатура) И Не ЭтоСвойПолуфабрикат(Материал, СПотомками);

КонецФункции

// Пустая таблица листьев ветви.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Материал, Характеристика, Количество.
//
Функция НоваяТаблицаЛистьев()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Материал", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Возврат Таблица;

КонецФункции

// Свой полуфабрикат дерева заказа - узел с потомками, кроме способов «Переработчик» и «Закупка» (тот же признак узла, что у
// АРМПроизводство.ПолуфабрикатыЗаказаКВыпуску): его сырьё закрывают его собственные выпуски. ПФ-лист выбора выпуска
// (2.0.16.114) ветви не даёт: его сырья в заказе нет.
//
// Параметры:
//  Материал   - СтрокаТаблицыЗначений - строка материалов заказа.
//  СПотомками - Соответствие - см. Документы.ЗаказПокупателя.КодыСтрокСПотомками.
//
// Возвращаемое значение:
//  Булево - Истина у своего ПФ.
//
Функция ЭтоСвойПолуфабрикат(Материал, СПотомками)

	Способы = Перечисления.СпособыИзготовления;
	Ключ = Документы.ЗаказПокупателя.КлючРодителяМатериала(Материал.КодСтрокиПродукции, Материал.КодСтроки);
	Возврат СПотомками[Ключ] <> Неопределено И ЗначениеЗаполнено(Материал.Номенклатура)
		И Материал.СпособИзготовления <> Способы.Переработчик И Материал.СпособИзготовления <> Способы.Закупка;

КонецФункции

// Заполняет долю выпуска в каждой ветви: выпущенное ранее и этим выпуском заполняет ветви по порядку, каждую до её
// «Нужно»; доля - пересечение отрезка этого выпуска с отрезком ветви. Сверх суммы «Нужно» доли нет.
//
// Параметры:
//  Ветви     - Массив из Структура - см. ВетвиРучногоВыпуска; заполняется Доля.
//  Ранее     - Число - выпущено позиции по заказу документами раньше этого.
//  Выпущено  - Число - выпуск этого документа.
//
Процедура РаспределитьВыпускПоВетвям(Ветви, Ранее, Выпущено)

	Начало = 0;
	Для Каждого Ветвь Из Ветви Цикл
		Конец = Начало + Ветвь.Нужно;
		Ветвь.Доля = Макс(0, Мин(Конец, Ранее + Выпущено) - Макс(Начало, Ранее));
		Начало = Конец;
	КонецЦикла;

КонецПроцедуры

// Выпущено позиции по заказу проведёнными выпусками с моментом времени раньше этого.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВыпускПродукции - проводимый выпуск.
//  Позиция   - СтрокаТабличнойЧасти - строка готовой продукции выпуска.
//
// Возвращаемое значение:
//  Число - количество в базовых единицах.
//
Функция ВыпущеноРанее(ДокОбъект, Позиция)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Продукция.Количество), 0) КАК Количество
	|ИЗ
	|	Документ.ВыпускПродукции.ТЧГотоваяПродукция КАК Продукция
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции КАК Выпуски
	|		ПО Продукция.Ссылка = Выпуски.Ссылка
	|ГДЕ
	|	Выпуски.Основание = &Заказ
	|	И Выпуски.Проведен
	|	И Выпуски.Ссылка <> &Ссылка
	|	И Выпуски.МоментВремени < &Момент
	|	И Продукция.Номенклатура = &Номенклатура
	|	И Продукция.Характеристика = &Характеристика");
	Запрос.УстановитьПараметр("Заказ", ДокОбъект.Основание);
	Запрос.УстановитьПараметр("Ссылка", ДокОбъект.Ссылка);
	Запрос.УстановитьПараметр("Момент", Новый МоментВремени(ДокОбъект.Дата, ДокОбъект.Ссылка));
	Запрос.УстановитьПараметр("Номенклатура", Позиция.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Позиция.Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

// Свободный расход материалов выпуска - расход ТоварыВНаличии этого проведения не из партий под заказ (см.
// Производство.ПартииПодЗаказ); строка без партии - свободный остаток.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВыпускПродукции - выпуск со сформированными (ещё не записанными) движениями.
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ выпуска.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Характеристика, Количество.
//
Функция СвободныйРасходВыпуска(ДокОбъект, Заказ)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ПодЗаказ = Производство.ПартииПодЗаказ(Заказ);
	Для Каждого Запись Из ДокОбъект.Движения.ТоварыВНаличии Цикл
		Если Запись.ВидДвижения <> ВидДвиженияНакопления.Расход
			Или ЗначениеЗаполнено(Запись.Партия) И ПодЗаказ.Найти(Запись.Партия) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Запись, "Номенклатура, Характеристика, Количество");
	КонецЦикла;
	Результат.Свернуть("Номенклатура, Характеристика", "Количество");
	Возврат Результат;

КонецФункции

// Движения «ИзОстатка» автовыпуска при отгрузке: материалы, списанные не из партий под заказ (E9). Данные передаёт
// механизм автовыпуска; выпуск, записанный не им, свои движения не переписывает.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ВыпускПродукции - проводимый автовыпуск.
//  Набор     - РегистрНакопленияНаборЗаписей.ПотребностиПроизводства - набор движений документа.
//
Процедура СформироватьДвиженияАвтовыпуска(ДокОбъект, Набор)

	ИзОстатка = Производство.ИзОстаткаАвтовыпуска(ДокОбъект);
	Если ИзОстатка = Неопределено Тогда
		Набор.Записывать = Ложь;
		Возврат;
	КонецЕсли;
	Набор.Записывать = Истина;
	Набор.Очистить();
	Если ИзОстатка.Заказ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из ИзОстатка.Строки Цикл
		Если Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.ДобавитьПриход();
		ЗаполнитьЗначенияСвойств(Запись, Строка, "Продукция, Материал, Характеристика");
		Запись.Период = ДокОбъект.Дата;
		Запись.Заказ = ИзОстатка.Заказ;
		Запись.ИзОстатка = Строка.Количество;
	КонецЦикла;

КонецПроцедуры

// Движения «Заказано» заказа поставщику и «Пришло» поступления (возврат - со знаком минус), распределённые по
// продукции; прямая закупка (см. ПрямаяЗакупка) пишет ту же величину и в «ПришлоБезЗаказа», возврат - часть,
// списанную с прямого прихода (см. РаспределитьВозврат). Закупка под заказ без
// сформированной потребности движений не даёт (решение владельца 3).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг,
//              ДокументОбъект.ВозвратПоставщику - проводимый документ закупки.
//  Набор     - РегистрНакопленияНаборЗаписей.ПотребностиПроизводства - набор движений документа.
//
Процедура СформироватьДвиженияЗакупки(ДокОбъект, Набор)

	// Заказ, найденный до блокировки: движения пишутся только по заблокированному заказу.
	Если ДокОбъект.ДополнительныеСвойства.Свойство(ИмяСвойстваЗаказа()) Тогда
		Заказ = ДокОбъект.ДополнительныеСвойства[ИмяСвойстваЗаказа()];
	Иначе
		Заказ = ЗаказКлиентаДокументаЗакупки(ДокОбъект);
	КонецЕсли;
	Если Не ЗаказФормируетПотребность(Заказ) Или ПоступлениеОрдерногоСклада(ДокОбъект) Тогда
		// Поступление ордерного склада «пришло» не пишет: физический приход по заказу сделал приходный ордер.
		Возврат;
	КонецЕсли;
	Строки = СтрокиЗакупки(ДокОбъект);
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ЭтоЗаказПоставщику = ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ЗаказПоставщику");
	ЭтоВозврат = ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику");
	Прямая = ПрямаяЗакупка(ДокОбъект);
	Знак = ?(ЭтоВозврат, -1, 1);
	Если ЭтоВозврат И Строки.Колонки.Найти("Продукция") <> Неопределено Тогда
		// Возврат - по остатку пришедшего по заказу в обратном порядке строк (план warehouse-orders, фаза 2, §2.8):
		// продукция строки заказа поставщику не держит возврат - её остаток мог снять другой возврат, и строка
		// пропала бы из движений, оставив материал пришедшим.
		Строки.ЗаполнитьЗначения(Неопределено, "Продукция");
	КонецЕсли;
	ИмяРесурса = ?(ЭтоЗаказПоставщику, "Заказано", "Пришло");
	Распределение = РаспределениеЗакупки(ДокОбъект, Заказ, Строки, ЭтоВозврат, Прямая);
	Для Каждого Строка Из Распределение Цикл
		Если Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.ДобавитьПриход();
		ЗаполнитьЗначенияСвойств(Запись, Строка, "Продукция, Материал, Характеристика");
		Запись.Период = ДокОбъект.Дата;
		Запись.Заказ = Заказ;
		Запись[ИмяРесурса] = Знак * Строка.Количество;
		Запись.ПришлоБезЗаказа = Знак * Строка.БезЗаказа;
	КонецЦикла;

КонецПроцедуры

// Раскладка строк закупки по продукции с частью «без заказа поставщику»: возврат - сначала со своего кармана «Пришло»,
// затем с другого (план arm-purchasing-receipts-s2, Р1.3); прямая закупка - вся строка без заказа.
//
// Параметры:
//  ДокОбъект  - ДокументОбъект - документ закупки.
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//  Строки     - ТаблицаЗначений - см. СтрокиЗакупки.
//  ЭтоВозврат - Булево - возврат поставщику.
//  Прямая     - Булево - см. ПрямаяЗакупка.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика, Количество, БезЗаказа.
//
Функция РаспределениеЗакупки(ДокОбъект, Заказ, Строки, ЭтоВозврат, Прямая)

	Если ЭтоВозврат Тогда
		Возврат РаспределитьВозврат(Строки, ПределыДокумента(ДокОбъект, Заказ));
	КонецЕсли;
	Распределение = РаспределитьПоПродукции(Строки, ПределыДокумента(ДокОбъект, Заказ));
	Распределение.Колонки.Добавить("БезЗаказа", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Если Прямая Тогда
		Для Каждого Строка Из Распределение Цикл
			Строка.БезЗаказа = Строка.Количество;
		КонецЦикла;
	КонецЕсли;
	Возврат Распределение;

КонецФункции

// Часть «Пришло» ключа, которую документ уменьшает и уводит в минус (см. ПроверитьПришло); ключ исправляющий или в
// минусе раньше - ноль.
//
// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - ИзменениеБезЗаказа, ИзменениеПоЗаказу, БезЗаказа, ПоЗаказу.
//
// Возвращаемое значение:
//  Число - отрицательный остаток части или ноль.
//
Функция МинусЧастиПришло(Выборка)

	Если Выборка.ИзменениеБезЗаказа < 0 И Выборка.БезЗаказа < 0 Тогда
		Минус = Выборка.БезЗаказа;
	ИначеЕсли Выборка.ИзменениеПоЗаказу < 0 И Выборка.ПоЗаказу < 0 Тогда
		Минус = Выборка.ПоЗаказу;
	Иначе
		Минус = 0;
	КонецЕсли;
	Возврат Минус;

КонецФункции

// Заказ клиента по основанию закупки: сам заказ клиента или основание заказа поставщику.
//
// Параметры:
//  Основание - ДокументСсылка, Неопределено - основание документа закупки.
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПокупателя, Неопределено - заказ клиента или Неопределено.
//
Функция ЗаказКлиентаОснования(Основание)

	Если Не ЗначениеЗаполнено(Основание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Заказ = Основание;
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		Заказ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "Основание");
	КонецЕсли;
	Если ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") И ЗначениеЗаполнено(Заказ) Тогда
		Возврат Заказ;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Есть ли у документа активные движения регистра по заказу клиента (по индексу регистратора).
//
// Параметры:
//  Регистратор - ДокументСсылка - документ.
//  Заказ       - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//
// Возвращаемое значение:
//  Булево - Истина, если движения есть.
//
Функция ЕстьДвиженияПоЗаказу(Регистратор, Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК ПризнакДвижений
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Регистратор
	|	И Движения.Заказ = &Заказ
	|	И Движения.Активность";
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Строки закупки для распределения: материал, характеристика, продукция (может быть пустой), количество.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг,
//              ДокументОбъект.ВозвратПоставщику - документ закупки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика, Количество.
//
Функция СтрокиЗакупки(ДокОбъект)

	Результат = НоваяТаблицаСтрок("Количество");
	СтрокиЗаказаПоставщику = Неопределено;
	Если ТипЗнч(ДокОбъект) <> Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		СтрокиЗаказаПоставщику = СтрокиЗаказаПоставщикуДокумента(ДокОбъект);
	КонецЕсли;
	Для Каждого СтрокаТоваров Из СтрокиДокументаЗакупки(ДокОбъект) Цикл
		Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Или СтрокаТоваров.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Продукция = ПродукцияСтрокиЗакупки(СтрокаТоваров, СтрокиЗаказаПоставщику);
		Если Продукция = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строка = Результат.Добавить();
		Строка.Продукция = Продукция;
		Строка.Материал = СтрокаТоваров.Номенклатура;
		Строка.Характеристика = СтрокаТоваров.Характеристика;
		Строка.Количество = СтрокаТоваров.Количество;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Продукция строки закупки. Строки заказа поставщику, собранные из предварительного заказа (колонка
// ЗаказПоставщику), не участвуют: «Заказано» по ним записал предварительный заказ; так же - строки поступления и
// возврата, которым они соответствуют. Продукция строк поступления и возврата - из строки заказа поставщику
// с тем же кодом строки, номенклатурой и характеристикой.
//
// Параметры:
//  СтрокаТоваров          - СтрокаТабличнойЧасти - строка товаров документа закупки.
//  СтрокиЗаказаПоставщику - Соответствие, Неопределено - см. СтрокиЗаказаПоставщикуДокумента; Неопределено у
//                           самого заказа поставщику.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура, Неопределено - продукция (пустая - распределяется) или Неопределено - строка
//                                                 движений не даёт.
//
Функция ПродукцияСтрокиЗакупки(СтрокаТоваров, СтрокиЗаказаПоставщику)

	Если СтрокиЗаказаПоставщику = Неопределено Тогда
		Если ЗначениеЗаполнено(СтрокаТоваров.ЗаказПоставщику) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат СтрокаТоваров.Продукция;
	КонецЕсли;
	СтрокаЗаказа = СтрокиЗаказаПоставщику[КлючСтрокиЗаказаПоставщику(СтрокаТоваров)];
	Если СтрокаЗаказа = Неопределено Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	ИначеЕсли СтрокаЗаказа.ИзПредварительного Тогда
		Возврат Неопределено;
	Иначе
		Возврат СтрокаЗаказа.Продукция;
	КонецЕсли;

КонецФункции

// Строки заказа поставщику, по которому введено поступление (или поступление-основание возврата).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.ВозвратПоставщику - документ закупки.
//
// Возвращаемое значение:
//  Соответствие - ключ КлючСтрокиЗаказаПоставщику, значение Структура: Продукция, ИзПредварительного.
//
Функция СтрокиЗаказаПоставщикуДокумента(ДокОбъект)

	Результат = Новый Соответствие;
	ЗаказПоставщику = ЗаказПоставщикуДокумента(ДокОбъект);
	Если Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Т.КодСтроки КАК КодСтроки,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Продукция КАК Продукция,
	|	Т.ЗаказПоставщику <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка) КАК ИзПредварительного
	|ИЗ
	|	Документ.ЗаказПоставщику.ТЧТовары КАК Т
	|ГДЕ
	|	Т.Ссылка = &ЗаказПоставщику";
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = КлючСтрокиЗаказаПоставщику(Выборка);
		Если Результат[Ключ] = Неопределено Тогда
			ОписаниеСтроки = Новый Структура("Продукция, ИзПредварительного", Выборка.Продукция, Выборка.ИзПредварительного);
			Результат.Вставить(Ключ, ОписаниеСтроки);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заказ поставщику - основание поступления или основание поступления-основания возврата.
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг,
//              ДокументОбъект.ВозвратПоставщику - документ закупки.
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПоставщику, Неопределено - заказ поставщику или Неопределено.
//
Функция ЗаказПоставщикуДокумента(ДокОбъект)

	Основание = ДокОбъект.Основание;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику") И ЗначениеЗаполнено(Основание) Тогда
		Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "Основание");
	КонецЕсли;
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПоставщику") И ЗначениеЗаполнено(Основание) Тогда
		Возврат Основание;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Прямая закупка (план arm-purchasing-receipts-s2, Р1): поступление, приходный ордер или возврат без заказа поставщику -
// у возврата по основанию его поступления. Признак зависит только от оснований документа, а не от движений заказа
// поставщику: меняется только перепроведением самого документа (ревью плана, раунд 1, P1-1).
//
// Параметры:
//  ДокОбъект - ДокументОбъект - документ закупки.
//
// Возвращаемое значение:
//  Булево - Истина у прямой закупки; у заказа поставщику - Ложь.
//
Функция ПрямаяЗакупка(ДокОбъект)

	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ЗначениеЗаполнено(ЗаказПоставщикуДокумента(ДокОбъект));

КонецФункции

// Ключ сопоставления строки закупки со строкой заказа поставщику.
//
// Параметры:
//  Строка - СтрокаТабличнойЧасти, ВыборкаИзРезультатаЗапроса - строка с КодСтроки, Номенклатура, Характеристика.
//
// Возвращаемое значение:
//  Строка - ключ.
//
Функция КлючСтрокиЗаказаПоставщику(Строка)

	Возврат СтрШаблон("%1|%2|%3", Строка.КодСтроки, XMLСтрока(Строка.Номенклатура), XMLСтрока(Строка.Характеристика));

КонецФункции

// Пределы распределения по продукции (план E7, п. 12.2).
//
// Параметры:
//  ДокОбъект - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ПоступлениеТоваровУслуг,
//              ДокументОбъект.ВозвратПоставщику - документ закупки.
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика, Предел - в порядке распределения.
//
Функция ПределыДокумента(ДокОбъект, Заказ)

	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		Возврат ПределыПоОстаткам(Заказ, ДокОбъект.Ссылка, "Заказано");
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг")
		Или ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйОрдер") Тогда
		ЗаказПоставщику = ЗаказПоставщикуДокумента(ДокОбъект);
		Если Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
			// Прямая закупка - на продукцию с дефицитом, с учётом взятого со склада (план arm-purchasing-receipts-s2, Р1.2).
			Возврат ПределыПрямойЗакупки(Заказ, ДокОбъект.Ссылка);
		КонецЕсли;
		// По «Заказано» заказа поставщику - только если он сам записал движения по заказу клиента; иначе (заказ
		// поставщику проведён до заказа клиента) - по остаткам заказа клиента.
		Если ЕстьДвиженияПоЗаказу(ЗаказПоставщику, Заказ) Тогда
			Возврат ПределыПоОснованию(Заказ, ЗаказПоставщику, ДокОбъект.Ссылка, Ложь);
		КонецЕсли;
		Возврат ПределыПоОстаткам(Заказ, ДокОбъект.Ссылка, "Пришло");
	Иначе
		// Возврат поставщику: одна модель пределов для любого возврата - от остатка пришедшего по заказу (план
		// warehouse-orders, фаза 2, §2.8): не зависит от ордеров и их отмены, возврат снимается с продукции, по которой
		// материал ещё числится пришедшим; сначала свой карман «Пришло», затем другой (план arm-purchasing-receipts-s2,
		// Р1.3).
		Возврат ПределыВозвратаПоЗаказу(Заказ, ДокОбъект.Ссылка, ПрямаяЗакупка(ДокОбъект));
	КонецЕсли;

КонецФункции

// Пределы по остаткам заказа клиента без движений документа: «Потребность - Ресурс», только продукция с
// потребностью - излишек не уходит на продукцию, которой в заказе больше нет.
//
// Параметры:
//  Заказ                - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//  ИсключитьРегистратор - ДокументСсылка - документ закупки, чьи движения не учитываются.
//  ИмяРесурса           - Строка - «Заказано» или «Пришло».
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика, Предел.
//
Функция ПределыПоОстаткам(Заказ, ИсключитьРегистратор, ИмяРесурса)

	Остатки = ОстаткиЗаказа(Заказ, ИсключитьРегистратор);
	Результат = НоваяТаблицаСтрок("Предел");
	Для Каждого Строка Из Остатки Цикл
		Если Строка.Потребность > 0 Тогда
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.Предел = Строка.Потребность - Строка[ИмяРесурса];
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пределы прямой закупки (план arm-purchasing-receipts-s2, Р1.2): по остаткам заказа клиента без движений документа -
// дефицит продукции «Потребность - ИзОстатка - Обеспечено», не меньше нуля, только продукция с потребностью: приход не
// ложится на изделие, обеспеченное со склада или заказом поставщику.
//
// Параметры:
//  Заказ  - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//  Ссылка - ДокументСсылка - проводимое поступление или приходный ордер.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика, Предел - в порядке строк продукции заказа.
//
Функция ПределыПрямойЗакупки(Заказ, Ссылка)

	Результат = НоваяТаблицаСтрок("Предел");
	Для Каждого Строка Из ОстаткиЗаказа(Заказ, Ссылка) Цикл
		Если Строка.Потребность > 0 Тогда
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.Предел = Макс(Строка.Потребность - Строка.ИзОстатка - Обеспечено(Строка), 0);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пределы по движениям документа-основания закупки. Поступление по заказу поставщику: «Заказано» этого заказа
// минус нетто «Пришло» других поступлений по нему с возвратами по ним (возвраты своего поступления не в счёт).
// Возврат: «Пришло» поступления-основания плюс уже отрицательное «Пришло» других возвратов по нему. Движения
// связанных документов отбираются по индексированному заказу регистра, а не по основаниям документов.
//
// Параметры:
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//  Основание  - ДокументСсылка.ЗаказПоставщику, ДокументСсылка.ПоступлениеТоваровУслуг - основание закупки.
//  Ссылка     - ДокументСсылка - проводимый документ.
//  ЭтоВозврат - Булево - проводится возврат поставщику.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика, Предел - в порядке строк продукции заказа.
//
Функция ПределыПоОснованию(Заказ, Основание, Ссылка, ЭтоВозврат)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Товары.Номенклатура КАК Продукция,
	|	МИНИМУМ(Товары.НомерСтроки) КАК НомерПорядка
	|ПОМЕСТИТЬ ВТПорядок
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТПоступления
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства КАК Движения
	|ГДЕ
	|	НЕ &ЭтоВозврат
	|	И Движения.Заказ = &Заказ
	|	И Движения.Регистратор <> &Ссылка
	|	И Движения.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|	И ВЫРАЗИТЬ(Движения.Регистратор КАК Документ.ПоступлениеТоваровУслуг).Основание = &Основание
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.Регистратор
	|ИЗ
	|	РегистрНакопления.ПотребностиПроизводства КАК Движения
	|ГДЕ
	|	НЕ &ЭтоВозврат
	|	И Движения.Заказ = &Заказ
	|	И Движения.Регистратор <> &Ссылка
	|	И Движения.Регистратор ССЫЛКА Документ.ПриходныйОрдер
	|	И ВЫРАЗИТЬ(Движения.Регистратор КАК Документ.ПриходныйОрдер).Основание = &Основание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТПоступления.Регистратор КАК Поступление
	|ПОМЕСТИТЬ ВТОснованияВозвратов
	|ИЗ
	|	ВТПоступления КАК ВТПоступления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтрокиПоступлений.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК СтрокиПоступлений
	|ГДЕ
	|	СтрокиПоступлений.Ордер В
	|			(ВЫБРАТЬ
	|				ВТПоступления.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТПоступления КАК ВТПоступления)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Движения.Продукция КАК Продукция,
	|	Движения.Материал КАК Материал,
	|	Движения.Характеристика КАК Характеристика,
	|	СУММА(Движения.Предел) КАК Предел
	|ПОМЕСТИТЬ ВТПределы
	|ИЗ
	|	(ВЫБРАТЬ
	|		Основания.Продукция КАК Продукция,
	|		Основания.Материал КАК Материал,
	|		Основания.Характеристика КАК Характеристика,
	|		ВЫБОР
	|			КОГДА &ЭтоВозврат
	|				ТОГДА Основания.Пришло
	|			ИНАЧЕ Основания.Заказано
	|		КОНЕЦ КАК Предел
	|	ИЗ
	|		РегистрНакопления.ПотребностиПроизводства КАК Основания
	|	ГДЕ
	|		Основания.Регистратор = &Основание
	|		И Основания.Заказ = &Заказ
	|		И Основания.Активность
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Поступления.Продукция,
	|		Поступления.Материал,
	|		Поступления.Характеристика,
	|		-Поступления.Пришло
	|	ИЗ
	|		РегистрНакопления.ПотребностиПроизводства КАК Поступления
	|	ГДЕ
	|		Поступления.Заказ = &Заказ
	|		И Поступления.Активность
	|		И Поступления.Регистратор В
	|				(ВЫБРАТЬ
	|					ВТПоступления.Регистратор КАК Регистратор
	|				ИЗ
	|					ВТПоступления КАК ВТПоступления)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВозвратыПоступлений.Продукция,
	|		ВозвратыПоступлений.Материал,
	|		ВозвратыПоступлений.Характеристика,
	|		-ВозвратыПоступлений.Пришло
	|	ИЗ
	|		РегистрНакопления.ПотребностиПроизводства КАК ВозвратыПоступлений
	|	ГДЕ
	|		ВозвратыПоступлений.Заказ = &Заказ
	|		И ВозвратыПоступлений.Активность
	|		И ВозвратыПоступлений.Регистратор ССЫЛКА Документ.ВозвратПоставщику
	|		И ВЫРАЗИТЬ(ВозвратыПоступлений.Регистратор КАК Документ.ВозвратПоставщику).Основание В
	|				(ВЫБРАТЬ
	|					ВТОснованияВозвратов.Поступление КАК Поступление
	|				ИЗ
	|					ВТОснованияВозвратов КАК ВТОснованияВозвратов)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Возвраты.Продукция,
	|		Возвраты.Материал,
	|		Возвраты.Характеристика,
	|		Возвраты.Пришло
	|	ИЗ
	|		РегистрНакопления.ПотребностиПроизводства КАК Возвраты
	|	ГДЕ
	|		&ЭтоВозврат
	|		И Возвраты.Заказ = &Заказ
	|		И Возвраты.Активность
	|		И Возвраты.Регистратор <> &Ссылка
	|		И Возвраты.Регистратор ССЫЛКА Документ.ВозвратПоставщику
	|		И ВЫРАЗИТЬ(Возвраты.Регистратор КАК Документ.ВозвратПоставщику).Основание = &Основание) КАК Движения
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.Продукция,
	|	Движения.Материал,
	|	Движения.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПределы.Продукция КАК Продукция,
	|	ВТПределы.Материал КАК Материал,
	|	ВТПределы.Характеристика КАК Характеристика,
	|	ВТПределы.Предел КАК Предел
	|ИЗ
	|	ВТПределы КАК ВТПределы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПорядок КАК ВТПорядок
	|		ПО ВТПределы.Продукция = ВТПорядок.Продукция
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕСТЬNULL(ВТПорядок.НомерПорядка, 999999999),
	|	ВТПределы.Материал,
	|	ВТПределы.Характеристика";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Основание", Основание);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ЭтоВозврат", ЭтоВозврат);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Пределы возврата поставщику - остаток пришедшего по заказу клиента без движений самого возврата, не меньше нуля
// (`ПределыПоОстаткам` не подходит: она даёт недополученное), двумя частями (план arm-purchasing-receipts-s2, Р1.3):
// сначала свой карман - у прямого возврата «ПришлоБезЗаказа», у возврата по заказу «Пришло - ПришлоБезЗаказа», затем
// другой; в каждой части - в обратном порядке строк продукции заказа (план warehouse-orders, фаза 2, §2.8). Возврат не
// трогает приход другого происхождения, пока своего хватает (ревью плана, раунд 1, P1-2), и не уходит в минус кармана
// на старых движениях без «ПришлоБезЗаказа» (раунд 4, P1).
//
// Параметры:
//  Заказ  - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//  Ссылка - ДокументСсылка.ВозвратПоставщику - проводимый возврат.
//  Прямой - Булево - возврат прямой закупки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика, Предел, ПрямойКарман (Булево) - в порядке списания.
//
Функция ПределыВозвратаПоЗаказу(Заказ, Ссылка, Прямой)

	// Ключ с исчерпанным «Пришло» остаётся с нулевым пределом: возврат сверх пришедшего ляжет на него минусом и
	// получит отказ ПроверитьПришло, а не пропадёт из движений (ревью БД фазы 2).
	Результат = НоваяТаблицаСтрок("Предел");
	Результат.Колонки.Добавить("ПрямойКарман", Новый ОписаниеТипов("Булево"));
	Остатки = ОстаткиЗаказа(Заказ, Ссылка);
	Карманы = Новый Массив;
	Карманы.Добавить(Прямой);
	Карманы.Добавить(Не Прямой);
	Для Каждого ПрямойКарман Из Карманы Цикл
		Для Индекс = 1 По Остатки.Количество() Цикл
			Строка = Остатки[Остатки.Количество() - Индекс];
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "Продукция, Материал, Характеристика");
			НоваяСтрока.ПрямойКарман = ПрямойКарман;
			Карман = ?(ПрямойКарман, Строка.ПришлоБезЗаказа, Строка.Пришло - Строка.ПришлоБезЗаказа);
			НоваяСтрока.Предел = Макс(Карман, 0);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Остатки заказа клиента без движений документа ИсключитьРегистратор: таблица итогов по заказу плюс движения
// документа с обратным знаком (по индексу регистратора) - при перепроведении прежние движения ещё лежат в базе.
//
// Параметры:
//  Заказ                - ДокументСсылка.ЗаказПокупателя - заказ клиента.
//  ИсключитьРегистратор - ДокументСсылка, Неопределено - документ, чьи движения не учитываются.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика, Потребность, Заказано, Пришло, ПришлоБезЗаказа, ИзОстатка - в
//                    порядке строк продукции заказа (решение владельца 4).
//
Функция ОстаткиЗаказа(Заказ, ИсключитьРегистратор)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Товары.Номенклатура КАК Продукция,
	|	МИНИМУМ(Товары.НомерСтроки) КАК НомерПорядка
	|ПОМЕСТИТЬ ВТПорядок
	|ИЗ
	|	Документ.ЗаказПокупателя.ТЧТовары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СводОстатков.Продукция КАК Продукция,
	|	СводОстатков.Материал КАК Материал,
	|	СводОстатков.Характеристика КАК Характеристика,
	|	СУММА(СводОстатков.Потребность) КАК Потребность,
	|	СУММА(СводОстатков.Заказано) КАК Заказано,
	|	СУММА(СводОстатков.Пришло) КАК Пришло,
	|	СУММА(СводОстатков.ПришлоБезЗаказа) КАК ПришлоБезЗаказа,
	|	СУММА(СводОстатков.ИзОстатка) КАК ИзОстатка
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.Продукция КАК Продукция,
	|		Остатки.Материал КАК Материал,
	|		Остатки.Характеристика КАК Характеристика,
	|		Остатки.ПотребностьОстаток КАК Потребность,
	|		Остатки.ЗаказаноОстаток КАК Заказано,
	|		Остатки.ПришлоОстаток КАК Пришло,
	|		Остатки.ПришлоБезЗаказаОстаток КАК ПришлоБезЗаказа,
	|		Остатки.ИзОстаткаОстаток КАК ИзОстатка
	|	ИЗ
	|		РегистрНакопления.ПотребностиПроизводства.Остатки(, Заказ = &Заказ) КАК Остатки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Свои.Продукция,
	|		Свои.Материал,
	|		Свои.Характеристика,
	|		-Свои.Потребность,
	|		-Свои.Заказано,
	|		-Свои.Пришло,
	|		-Свои.ПришлоБезЗаказа,
	|		-Свои.ИзОстатка
	|	ИЗ
	|		РегистрНакопления.ПотребностиПроизводства КАК Свои
	|	ГДЕ
	|		Свои.Регистратор = &Регистратор
	|		И Свои.Заказ = &Заказ
	|		И Свои.Активность) КАК СводОстатков
	|
	|СГРУППИРОВАТЬ ПО
	|	СводОстатков.Продукция,
	|	СводОстатков.Материал,
	|	СводОстатков.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстатки.Продукция КАК Продукция,
	|	ВТОстатки.Материал КАК Материал,
	|	ВТОстатки.Характеристика КАК Характеристика,
	|	ВТОстатки.Потребность КАК Потребность,
	|	ВТОстатки.Заказано КАК Заказано,
	|	ВТОстатки.Пришло КАК Пришло,
	|	ВТОстатки.ПришлоБезЗаказа КАК ПришлоБезЗаказа,
	|	ВТОстатки.ИзОстатка КАК ИзОстатка
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПорядок КАК ВТПорядок
	|		ПО ВТОстатки.Продукция = ВТПорядок.Продукция
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕСТЬNULL(ВТПорядок.НомерПорядка, 999999999),
	|	ВТОстатки.Материал,
	|	ВТОстатки.Характеристика";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Регистратор", ИсключитьРегистратор);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Распределение строк закупки по продукции (план E7, п. 12.2): сначала строки с явной продукцией, затем
// строки без неё по свободным остаткам пределов. Накопитель общий для строк документа: две строки одного
// материала не закрывают один дефицит дважды.
//
// Параметры:
//  Строки  - ТаблицаЗначений - см. СтрокиЗакупки.
//  Пределы - ТаблицаЗначений - см. ПределыДокумента; дополняется колонкой Распределено.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика, Количество - свёрнута по измерениям.
//
Функция РаспределитьПоПродукции(Строки, Пределы)

	Результат = НоваяТаблицаСтрок("Количество");
	Пределы.Колонки.Добавить("Распределено", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Строки Цикл
		Если ЗначениеЗаполнено(Строка.Продукция) Тогда
			РаспределитьНаПродукцию(Результат, Строка, Пределы);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из Строки Цикл
		Если Не ЗначениеЗаполнено(Строка.Продукция) Тогда
			РаспределитьПоПорядку(Результат, Строка, Пределы);
		КонецЕсли;
	КонецЦикла;
	Результат.Свернуть("Продукция, Материал, Характеристика", "Количество");
	Возврат Результат;

КонецФункции

// Строка с явной продукцией: всё количество на её строку пределов, если такая есть; иначе движения нет.
//
// Параметры:
//  Результат - ТаблицаЗначений - см. РаспределитьПоПродукции.
//  Строка    - СтрокаТаблицыЗначений - строка закупки.
//  Пределы   - ТаблицаЗначений - пределы с колонкой Распределено.
//
Процедура РаспределитьНаПродукцию(Результат, Строка, Пределы)

	Отбор = Новый Структура("Продукция, Материал, Характеристика", Строка.Продукция, Строка.Материал, Строка.Характеристика);
	Найденные = Пределы.НайтиСтроки(Отбор);
	Если Найденные.Количество() > 0 Тогда
		Найденные[0].Распределено = Найденные[0].Распределено + Строка.Количество;
		ДобавитьРаспределение(Результат, Найденные[0], Строка.Количество);
	КонецЕсли;

КонецПроцедуры

// Строка без продукции: свободные остатки пределов материала по порядку, излишек - на последнюю строку
// (решение владельца 2: фактическое количество). Материала нет в пределах - движения нет.
//
// Параметры:
//  Результат - ТаблицаЗначений - см. РаспределитьПоПродукции.
//  Строка    - СтрокаТаблицыЗначений - строка закупки.
//  Пределы   - ТаблицаЗначений - пределы с колонкой Распределено.
//
Процедура РаспределитьПоПорядку(Результат, Строка, Пределы)

	Отбор = Новый Структура("Материал, Характеристика", Строка.Материал, Строка.Характеристика);
	Найденные = Пределы.НайтиСтроки(Отбор);
	Если Найденные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Остаток = Строка.Количество;
	Для Каждого Предел Из Найденные Цикл
		Часть = Мин(Остаток, Макс(0, Предел.Предел - Предел.Распределено));
		Если Часть > 0 Тогда
			Предел.Распределено = Предел.Распределено + Часть;
			ДобавитьРаспределение(Результат, Предел, Часть);
			Остаток = Остаток - Часть;
		КонецЕсли;
	КонецЦикла;
	Если Остаток > 0 Тогда
		Последний = Найденные[Найденные.ВГраница()];
		Последний.Распределено = Последний.Распределено + Остаток;
		ДобавитьРаспределение(Результат, Последний, Остаток);
	КонецЕсли;

КонецПроцедуры

// Добавляет строку распределения.
//
// Параметры:
//  Результат  - ТаблицаЗначений - см. РаспределитьПоПродукции.
//  Предел     - СтрокаТаблицыЗначений - строка пределов с измерениями.
//  Количество - Число - распределённое количество.
//
Процедура ДобавитьРаспределение(Результат, Предел, Количество)

	Строка = Результат.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Предел, "Продукция, Материал, Характеристика");
	Строка.Количество = Количество;

КонецПроцедуры

// Раскладка возврата по пределам ПределыВозвратаПоЗаказу: по порядку пределов материала (свой карман, затем другой),
// остаток сверх всех пределов - на последнюю строку материала (отказ ПроверитьПришло, как раньше). Материала нет в
// пределах - движения нет.
//
// Параметры:
//  Строки  - ТаблицаЗначений - см. СтрокиЗакупки.
//  Пределы - ТаблицаЗначений - см. ПределыВозвратаПоЗаказу; дополняется колонкой Распределено.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика, Количество, БезЗаказа (часть с прямого кармана) - свёрнута.
//
Функция РаспределитьВозврат(Строки, Пределы)

	Результат = НоваяТаблицаСтрок("Количество");
	Результат.Колонки.Добавить("БезЗаказа", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Пределы.Колонки.Добавить("Распределено", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Строки Цикл
		Отбор = Новый Структура("Материал, Характеристика", Строка.Материал, Строка.Характеристика);
		Найденные = Пределы.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Остаток = Строка.Количество;
		Для Каждого Предел Из Найденные Цикл
			Часть = Мин(Остаток, Макс(0, Предел.Предел - Предел.Распределено));
			Если Часть > 0 Тогда
				Предел.Распределено = Предел.Распределено + Часть;
				ДобавитьРаспределениеВозврата(Результат, Предел, Часть);
				Остаток = Остаток - Часть;
			КонецЕсли;
		КонецЦикла;
		Если Остаток > 0 Тогда
			Последний = Найденные[Найденные.ВГраница()];
			Последний.Распределено = Последний.Распределено + Остаток;
			ДобавитьРаспределениеВозврата(Результат, Последний, Остаток);
		КонецЕсли;
	КонецЦикла;
	Результат.Свернуть("Продукция, Материал, Характеристика", "Количество, БезЗаказа");
	Возврат Результат;

КонецФункции

// Параметры:
//  Результат  - ТаблицаЗначений - см. РаспределитьВозврат.
//  Предел     - СтрокаТаблицыЗначений - строка пределов возврата.
//  Количество - Число - распределённое количество.
//
Процедура ДобавитьРаспределениеВозврата(Результат, Предел, Количество)

	Строка = Результат.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Предел, "Продукция, Материал, Характеристика");
	Строка.Количество = Количество;
	Строка.БезЗаказа = ?(Предел.ПрямойКарман, Количество, 0);

КонецПроцедуры

// Коды строк заказа поставщику по строкам поступления, оформившего приходные ордера: КодСтроки строки поступления ->
// КодСтрокиЗаказа строки её ордера.
//
// Параметры:
//  Поступление - ДокументСсылка.ПоступлениеТоваровУслуг - поступление.
//
// Возвращаемое значение:
//  Соответствие - ключ КодСтроки строки поступления, значение КодСтрокиЗаказа строки ордера.
//
Функция КодыЗаказаСтрокПоступления(Поступление)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтрокиПоступления.КодСтроки КАК КодСтроки,
	|	СтрокиОрдера.КодСтрокиЗаказа КАК КодСтрокиЗаказа
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК СтрокиПоступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходныйОрдер.ТЧТовары КАК СтрокиОрдера
	|		ПО СтрокиПоступления.Ордер = СтрокиОрдера.Ссылка
	|			И СтрокиПоступления.КлючСтрокиОрдера = СтрокиОрдера.КодСтроки
	|ГДЕ
	|	СтрокиПоступления.Ссылка = &Поступление";
	Запрос.УстановитьПараметр("Поступление", Поступление);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.КодСтроки, Выборка.КодСтрокиЗаказа);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пустая таблица новых записей «Пришло» для ПроверитьПришло.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Заказ, Продукция, Материал, Характеристика, Пришло, ПришлоБезЗаказа.
//
Функция НоваяТаблицаИзменений()

	Таблица = НоваяТаблицаСтрок("Пришло");
	Таблица.Колонки.Добавить("ПришлоБезЗаказа", Метаданные.ОпределяемыеТипы.Количество.Тип);
	Таблица.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
	Возврат Таблица;

КонецФункции

// Пустая таблица строк по измерениям регистра с колонкой количества.
//
// Параметры:
//  ИмяКоличества - Строка - имя колонки количества.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Продукция, Материал, Характеристика и колонка количества.
//
Функция НоваяТаблицаСтрок(ИмяКоличества)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Продукция", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Материал", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Таблица.Колонки.Добавить(ИмяКоличества, Метаданные.ОпределяемыеТипы.Количество.Тип);
	Возврат Таблица;

КонецФункции

#КонецОбласти
