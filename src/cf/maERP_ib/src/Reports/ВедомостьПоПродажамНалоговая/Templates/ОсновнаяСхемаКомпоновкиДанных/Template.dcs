		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	НалоговаяНакладная.Ссылка.Организация КАК Организация,
	ВЫБОР
		КОГДА НалоговаяНакладная.Ссылка.Контрагент.ICE = ""
			ТОГДА "Client Divers"
		ИНАЧЕ НалоговаяНакладная.Ссылка.Контрагент
	КОНЕЦ КАК Контрагент,
	СУММА(НалоговаяНакладная.СуммаСНДС - НалоговаяНакладная.СуммаНДС) КАК СуммаБезНДС,
	СУММА(НалоговаяНакладная.СуммаНДС) КАК СуммаНДС,
	СУММА(НалоговаяНакладная.СуммаСНДС) КАК СуммаСНДС,
	ВЫБОР
		КОГДА НалоговаяНакладная.Ссылка.Контрагент.ICE = ""
			ТОГДА 2
		ИНАЧЕ 1
	КОНЕЦ КАК ПолеСортировки,
	НалоговаяНакладная.Номенклатура.ТипНоменклатуры КАК НоменклатураТипНоменклатуры
ПОМЕСТИТЬ ВТ
ИЗ
	Документ.НалоговаяНакладная.ТЧТовары КАК НалоговаяНакладная
ГДЕ
	НалоговаяНакладная.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И НалоговаяНакладная.Ссылка.Проведен

СГРУППИРОВАТЬ ПО
	НалоговаяНакладная.Ссылка.Организация,
	НалоговаяНакладная.Ссылка.Контрагент,
	ВЫБОР
		КОГДА НалоговаяНакладная.Ссылка.Контрагент.ICE = ""
			ТОГДА "Client Divers"
		ИНАЧЕ НалоговаяНакладная.Ссылка.Контрагент
	КОНЕЦ,
	ВЫБОР
		КОГДА НалоговаяНакладная.Ссылка.Контрагент.ICE = ""
			ТОГДА 2
		ИНАЧЕ 1
	КОНЕЦ,
	НалоговаяНакладная.Номенклатура.ТипНоменклатуры

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВозвратОтПокупателяНалоговый.Ссылка.Организация,
	ВЫБОР
		КОГДА ВозвратОтПокупателяНалоговый.Ссылка.Контрагент.ICE = ""
			ТОГДА "Client Divers"
		ИНАЧЕ ВозвратОтПокупателяНалоговый.Ссылка.Контрагент
	КОНЕЦ,
	СУММА(-ВозвратОтПокупателяНалоговый.СуммаСНДС + ВозвратОтПокупателяНалоговый.СуммаНДС),
	СУММА(-ВозвратОтПокупателяНалоговый.СуммаНДС),
	СУММА(-ВозвратОтПокупателяНалоговый.СуммаСНДС),
	ВЫБОР
		КОГДА ВозвратОтПокупателяНалоговый.Ссылка.Контрагент.ICE = ""
			ТОГДА 2
		ИНАЧЕ 1
	КОНЕЦ,
	ВозвратОтПокупателяНалоговый.Номенклатура.ТипНоменклатуры
ИЗ
	Документ.ВозвратОтПокупателяНалоговый.ТЧТовары КАК ВозвратОтПокупателяНалоговый
ГДЕ
	ВозвратОтПокупателяНалоговый.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ВозвратОтПокупателяНалоговый.Ссылка.Проведен

СГРУППИРОВАТЬ ПО
	ВозвратОтПокупателяНалоговый.Ссылка.Организация,
	ВЫБОР
		КОГДА ВозвратОтПокупателяНалоговый.Ссылка.Контрагент.ICE = ""
			ТОГДА "Client Divers"
		ИНАЧЕ ВозвратОтПокупателяНалоговый.Ссылка.Контрагент
	КОНЕЦ,
	ВЫБОР
		КОГДА ВозвратОтПокупателяНалоговый.Ссылка.Контрагент.ICE = ""
			ТОГДА 2
		ИНАЧЕ 1
	КОНЕЦ,
	ВозвратОтПокупателяНалоговый.Номенклатура.ТипНоменклатуры
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ.Организация КАК Организация,
	ВТ.Контрагент КАК Контрагент,
	СУММА(ВТ.СуммаБезНДС) КАК СуммаБезНДС,
	СУММА(ВТ.СуммаНДС) КАК СуммаНДС,
	СУММА(ВТ.СуммаСНДС) КАК СуммаСНДС,
	ВТ.ПолеСортировки КАК ПолеСортировки,
	ВТ.НоменклатураТипНоменклатуры КАК ТипНоменклатуры
ИЗ
	ВТ КАК ВТ

СГРУППИРОВАТЬ ПО
	ВТ.Организация,
	ВТ.Контрагент,
	ВТ.ПолеСортировки,
	ВТ.НоменклатураТипНоменклатуры

УПОРЯДОЧИТЬ ПО
	ПолеСортировки</query>
