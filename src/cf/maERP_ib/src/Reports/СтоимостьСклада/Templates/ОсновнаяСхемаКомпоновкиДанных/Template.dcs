<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>МестоХранения</dataPath>
			<field>МестоХранения</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Серия</dataPath>
			<field>Серия</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаБезНДС</dataPath>
			<field>СуммаБезНДС</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма без НДС</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fr</v8:lang>
					<v8:content>Montant HT</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Format</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ЧДЦ=3</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fr</v8:lang>
							<v8:content>ЧДЦ=3</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаСНДС</dataPath>
			<field>СуммаСНДС</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма с НДС</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fr</v8:lang>
					<v8:content>Montant TTC</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Партия</dataPath>
			<field>Партия</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаПартии</dataPath>
			<field>ДатаПартии</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Характеристика</dataPath>
			<field>Характеристика</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтавкаНДС</dataPath>
			<field>СтавкаНДС</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтатьяДДС</dataPath>
			<field>СтатьяДДС</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ТоварыВНаличииОстатки.МестоХранения КАК МестоХранения,
	ТоварыВНаличииОстатки.Номенклатура КАК Номенклатура,
	ТоварыВНаличииОстатки.Партия КАК Партия,
	ТоварыВНаличииОстатки.КоличествоОстаток КАК Количество,
	ТоварыВНаличииОстатки.СуммаОстаток КАК СуммаСНДС,
	ТоварыВНаличииОстатки.СуммаОстаток / (1 + ЕСТЬNULL(ВТ.СтавкаНДС.Ставка, ТоварыВНаличииОстатки.Номенклатура.СтавкаНДС.Ставка) / 100) КАК СуммаБезНДС,
	ЕСТЬNULL(ВТ.СтавкаНДС, ТоварыВНаличииОстатки.Номенклатура.СтавкаНДС) КАК СтавкаНДС
ИЗ
	РегистрНакопления.ТоварыВНаличии.Остатки КАК ТоварыВНаличииОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ВозвратОтПокупателяТЧТовары.Ссылка КАК Ссылка,
			ВозвратОтПокупателяТЧТовары.Номенклатура КАК Номенклатура,
			СУММА(ВозвратОтПокупателяТЧТовары.Количество) КАК Количество,
			СУММА(ВозвратОтПокупателяТЧТовары.СуммаСНДС) КАК СуммаСНДС,
			МАКСИМУМ(ВозвратОтПокупателяТЧТовары.СтавкаНДС) КАК СтавкаНДС
		ИЗ
			Документ.ВозвратОтПокупателя.ТЧТовары КАК ВозвратОтПокупателяТЧТовары
		
		СГРУППИРОВАТЬ ПО
			ВозвратОтПокупателяТЧТовары.Ссылка,
			ВозвратОтПокупателяТЧТовары.Номенклатура
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			ОприходованиеТоваровТЧТовары.Ссылка,
			ОприходованиеТоваровТЧТовары.Номенклатура,
			СУММА(ОприходованиеТоваровТЧТовары.Количество),
			СУММА(ОприходованиеТоваровТЧТовары.Сумма),
			МАКСИМУМ(ОприходованиеТоваровТЧТовары.Номенклатура.СтавкаНДС)
		ИЗ
			Документ.ОприходованиеТоваров.ТЧТовары КАК ОприходованиеТоваровТЧТовары
		
		СГРУППИРОВАТЬ ПО
			ОприходованиеТоваровТЧТовары.Ссылка,
			ОприходованиеТоваровТЧТовары.Номенклатура
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			ПоступлениеТоваровУслугТЧТовары.Ссылка,
			ПоступлениеТоваровУслугТЧТовары.Номенклатура,
			СУММА(ПоступлениеТоваровУслугТЧТовары.Количество),
			СУММА(ПоступлениеТоваровУслугТЧТовары.СуммаСНДС),
			МАКСИМУМ(ПоступлениеТоваровУслугТЧТовары.СтавкаНДС)
		ИЗ
			Документ.ПоступлениеТоваровУслуг.ТЧТовары КАК ПоступлениеТоваровУслугТЧТовары
		
		СГРУППИРОВАТЬ ПО
			ПоступлениеТоваровУслугТЧТовары.Ссылка,
			ПоступлениеТоваровУслугТЧТовары.Номенклатура) КАК ВТ
		ПО ТоварыВНаличииОстатки.Номенклатура = ВТ.Номенклатура
			И ТоварыВНаличииОстатки.Партия = ВТ.Ссылка

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ДополнительныеРасходыОстатки.МестоХранения,
	ДополнительныеРасходыОстатки.Номенклатура,
	ДополнительныеРасходыОстатки.Партия,
	0,
	ДополнительныеРасходыОстатки.СуммаОстаток,
	ДополнительныеРасходыОстатки.СуммаОстаток / (1 + ЕСТЬNULL(ВТ.СтавкаНДС.Ставка, 0) / 100),
	ЕСТЬNULL(ВТ.СтавкаНДС, 0)
ИЗ
	РегистрНакопления.ДополнительныеРасходы.Остатки(, ) КАК ДополнительныеРасходыОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ПоступлениеТоваровУслугТЧДополнительныеРасходы.Ссылка КАК Ссылка,
			ПоступлениеТоваровУслугТЧДополнительныеРасходы.Номенклатура КАК Номенклатура,
			СУММА(ПоступлениеТоваровУслугТЧДополнительныеРасходы.СуммаСНДС) КАК СуммаСНДС,
			МАКСИМУМ(ПоступлениеТоваровУслугТЧДополнительныеРасходы.СтавкаНДС) КАК СтавкаНДС,
			ПоступлениеТоваровУслугТЧДополнительныеРасходы.СтатьяДДС КАК СтатьяДДС
		ИЗ
			Документ.ПоступлениеТоваровУслуг.ТЧДополнительныеРасходы КАК ПоступлениеТоваровУслугТЧДополнительныеРасходы
		
		СГРУППИРОВАТЬ ПО
			ПоступлениеТоваровУслугТЧДополнительныеРасходы.Ссылка,
			ПоступлениеТоваровУслугТЧДополнительныеРасходы.Номенклатура,
			ПоступлениеТоваровУслугТЧДополнительныеРасходы.СтатьяДДС) КАК ВТ
		ПО ДополнительныеРасходыОстатки.СтатьяДДС = ВТ.СтатьяДДС
			И ДополнительныеРасходыОстатки.Партия = ВТ.Ссылка</query>
	</dataSet>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаБезНДС</dataPath>
		<expression>Сумма(СуммаБезНДС)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаСНДС</dataPath>
		<expression>Сумма(СуммаСНДС)</expression>
	</totalField>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Période</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
		<expression>КонецПериода(&amp;Период, "ДЕНЬ")</expression>
		<use>Always</use>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Default</dcsset:presentation>
		<dcsset:settings xmlns:pal="http://v8.1c.ru/8.1/data/ui/colors/palette" xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Количество</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>СуммаБезНДС</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>СуммаСНДС</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:filter>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">МестоХранения</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:userSettingID>f52f00f8-25dc-4a53-af0d-633b28efb9c8</dcsset:userSettingID>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">Номенклатура</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:userSettingID>a5ecce86-8426-4396-a737-957e99b9b339</dcsset:userSettingID>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">Количество</dcsset:left>
					<dcsset:comparisonType>NotEqual</dcsset:comparisonType>
					<dcsset:right xsi:type="xs:decimal">0</dcsset:right>
					<dcsset:userSettingID>13811ac7-21d4-4faa-8d59-fb18c2f87ad3</dcsset:userSettingID>
				</dcsset:item>
			</dcsset:filter>
			<dcsset:dataParameters>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>Период</dcscor:parameter>
					<dcscor:value xsi:type="xs:dateTime">0001-01-01T00:00:00</dcscor:value>
					<dcsset:userSettingID>98744649-1724-4c48-a1c6-ca6bb781de9f</dcsset:userSettingID>
				</dcscor:item>
			</dcsset:dataParameters>
			<dcsset:outputParameters>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>AppearanceTemplate</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">Арктика</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>AttributePlacement</dcscor:parameter>
					<dcscor:value xsi:type="dcsset:DataCompositionAttributesPlacement">Separately</dcscor:value>
				</dcscor:item>
			</dcsset:outputParameters>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:groupItems>
					<dcsset:item xsi:type="dcsset:GroupItemField">
						<dcsset:field>Номенклатура</dcsset:field>
						<dcsset:groupType>Items</dcsset:groupType>
						<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
						<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
						<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:GroupItemField">
						<dcsset:field>Номенклатура.Артикул</dcsset:field>
						<dcsset:groupType>Items</dcsset:groupType>
						<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
						<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
						<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:GroupItemField">
						<dcsset:field>СтавкаНДС</dcsset:field>
						<dcsset:groupType>Items</dcsset:groupType>
						<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
						<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
						<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
					</dcsset:item>
				</dcsset:groupItems>
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
			</dcsset:item>
			<dcsset:itemsUserSettingID>e58c33ea-d315-4d10-b912-fcd57d1ea2e7</dcsset:itemsUserSettingID>
		</dcsset:settings>
	</settingsVariant>
