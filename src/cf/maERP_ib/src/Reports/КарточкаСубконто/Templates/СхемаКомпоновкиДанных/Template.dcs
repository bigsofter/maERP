	NULL КАК Субконто1,
	NULL КАК Субконто2,
	NULL КАК Субконто3
{ВЫБРАТЬ
	Период,
	Регистратор.*,
	НомерСтроки,
	СчетДт.*,
	СубконтоДт1.*,
	СубконтоДт2.*,
