	</totalField>
	<totalField>
		<dataPath>СальдоНаКонецПериода.СверкаНУКонечныйРазвернутыйОстатокКт</dataPath>
		<expression>Сумма(СальдоНаКонецПериода.СверкаНУКонечныйРазвернутыйОстатокКт)</expression>
	</totalField>
	<totalField>
		<dataPath>СальдоНаНачалоПериода.СверкаНУНачальныйОстатокДт</dataPath>
		<expression>выбор когда Сумма(СальдоНаНачалоПериода.НУНачальныйОстатокДт) &lt;&gt; 0 Или Сумма(СальдоНаНачалоПериода.НУНачальныйОстатокКт) = 0 и Сумма(СальдоНаНачалоПериода.БУНачальныйОстатокДт) &lt;&gt; 0 тогда Сумма(СальдоНаНачалоПериода.СверкаНУНачальныйОстатокДт)-Сумма(СальдоНаНачалоПериода.СверкаНУНачальныйОстатокКт) иначе 0 конец</expression>
	</totalField>
	<totalField>
		<dataPath>СальдоНаНачалоПериода.СверкаНУНачальныйОстатокКт</dataPath>
		<expression>выбор когда Сумма(СальдоНаНачалоПериода.НУНачальныйОстатокДт) &lt;&gt; 0 Или Сумма(СальдоНаНачалоПериода.НУНачальныйОстатокКт) = 0 и Сумма(СальдоНаНачалоПериода.БУНачальныйОстатокДт) &lt;&gt; 0 тогда 0 иначе Сумма(СальдоНаНачалоПериода.СверкаНУНачальныйОстатокКт)-Сумма(СальдоНаНачалоПериода.СверкаНУНачальныйОстатокДт) конец</expression>
	</totalField>
