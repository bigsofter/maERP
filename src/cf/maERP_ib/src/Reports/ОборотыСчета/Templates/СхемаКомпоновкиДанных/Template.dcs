	<totalField>
		<dataPath>СальдоНаКонецПериода.СверкаНУКонечныйОстатокДт</dataPath>
		<expression>выбор когда Сумма(СальдоНаКонецПериода.НУКонечныйОстатокДт) &lt;&gt; 0 Или Сумма(СальдоНаКонецПериода.НУКонечныйОстатокКт) = 0 и Сумма(СальдоНаКонецПериода.БУКонечныйОстатокДт) &lt;&gt; 0 тогда Сумма(СальдоНаКонецПериода.СверкаНУКонечныйОстатокДт)-Сумма(СальдоНаКонецПериода.СверкаНУКонечныйОстатокКт) иначе 0 конец</expression>
	</totalField>
	<totalField>
		<dataPath>СальдоНаКонецПериода.СверкаНУКонечныйОстатокКт</dataPath>
		<expression>выбор когда Сумма(СальдоНаКонецПериода.НУКонечныйОстатокДт) &lt;&gt; 0 Или Сумма(СальдоНаКонецПериода.НУКонечныйОстатокКт) = 0 и Сумма(СальдоНаКонецПериода.БУКонечныйОстатокДт) &lt;&gt; 0 тогда 0 иначе Сумма(СальдоНаКонецПериода.СверкаНУКонечныйОстатокКт)-Сумма(СальдоНаКонецПериода.СверкаНУКонечныйОстатокДт) конец</expression>
