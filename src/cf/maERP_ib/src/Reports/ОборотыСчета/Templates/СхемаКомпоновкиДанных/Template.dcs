	<totalField>
		<dataPath>СальдоНаНачалоПериода.СверкаНУНачальныйРазвернутыйОстатокКт</dataPath>
		<expression>Сумма(СальдоНаНачалоПериода.СверкаНУНачальныйРазвернутыйОстатокКт)</expression>
	</totalField>
