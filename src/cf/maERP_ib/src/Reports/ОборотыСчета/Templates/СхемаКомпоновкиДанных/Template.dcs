				<dataPath>ОборотыЗаПериод.СверкаНУОборотКт</dataPath>
				<field>СверкаНУОборотКт</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Обороты за период.Сверка НУОборот кт1</v8:content>
