		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫБОР
		КОГДА ОплатыЧекамиОстаткиИОбороты.Регистратор = НЕОПРЕДЕЛЕНО
			ТОГДА NULL
		ИНАЧЕ ОплатыЧекамиОстаткиИОбороты.Регистратор
	КОНЕЦ КАК Регистратор,
	ОплатыЧекамиОстаткиИОбороты.ПериодСекунда КАК ПериодСекунда,
	ОплатыЧекамиОстаткиИОбороты.ПериодДень КАК День,
	ОплатыЧекамиОстаткиИОбороты.СуммаНачальныйОстаток КАК НачальныйОстаток,
	ОплатыЧекамиОстаткиИОбороты.СуммаПриход КАК Приход,
	ОплатыЧекамиОстаткиИОбороты.СуммаРасход КАК Расход,
	ОплатыЧекамиОстаткиИОбороты.СуммаКонечныйОстаток КАК КонечныйОстаток,
	ОплатыЧекамиОстаткиИОбороты.ПериодНеделя КАК Неделя,
	ОплатыЧекамиОстаткиИОбороты.ПериодМесяц КАК Месяц,
	ОплатыЧекамиОстаткиИОбороты.ПериодКвартал КАК Квартал,
	ОплатыЧекамиОстаткиИОбороты.ПериодПолугодие КАК Полугодие,
	ОплатыЧекамиОстаткиИОбороты.ПериодГод КАК Год,
	ОплатыЧекамиОстаткиИОбороты.Чек КАК Чек,
	ОплатыЧекамиОстаткиИОбороты.Чек.Организация КАК ЧекОрганизация
ИЗ
	РегистрНакопления.ОплатыЧеками.ОстаткиИОбороты(, , Авто, , ) КАК ОплатыЧекамиОстаткиИОбороты</query>
	</dataSet>
