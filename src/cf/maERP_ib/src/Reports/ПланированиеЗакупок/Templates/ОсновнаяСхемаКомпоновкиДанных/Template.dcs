		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаПартии</dataPath>
			<field>ДатаПартии</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕСТЬNULL(ПродажиОбороты.Номенклатура, ТоварыВНаличииОстатки.Номенклатура) КАК Номенклатура,
	ЕСТЬNULL(ПродажиОбороты.Характеристика, ТоварыВНаличииОстатки.Характеристика) КАК Характеристика,
	ЕСТЬNULL(ПродажиОбороты.КоличествоОборот,0) КАК Количество,
	ЕСТЬNULL(ПродажиОбороты.ДокументПродажи.МестоХранения,ТоварыВНаличииОстатки.МестоХранения) КАК ТорговаяТочка,
	ЕСТЬNULL(ТоварыВНаличииОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
ИЗ
	РегистрНакопления.Продажи.Обороты({(&amp;НачалоПериода)}, {(&amp;КонецПериода)}, Авто, ) КАК ПродажиОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВНаличии.Остатки({(&amp;ПериодКД)}, ) КАК ТоварыВНаличииОстатки
		ПО ПродажиОбороты.Номенклатура = ТоварыВНаличииОстатки.Номенклатура
			И ПродажиОбороты.Характеристика = ТоварыВНаличииОстатки.Характеристика
			//И ПродажиОбороты.Партия = ТоварыВНаличииОстатки.Партия
			И ПродажиОбороты.ДокументПродажи.МестоХранения = ТоварыВНаличииОстатки.МестоХранения</query>
	</dataSet>
	<totalField>
