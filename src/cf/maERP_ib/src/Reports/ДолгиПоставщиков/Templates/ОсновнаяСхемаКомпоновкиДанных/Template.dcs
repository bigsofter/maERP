		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВзаиморасчётыСПоставщикамиОстатки.Организация КАК Организация,
	ВзаиморасчётыСПоставщикамиОстатки.Контрагент КАК Контрагент,
	ВзаиморасчётыСПоставщикамиОстатки.ОбъектРасчётов КАК ОбъектРасчётов,
	ВзаиморасчётыСПоставщикамиОстатки.СуммаОстаток КАК СуммаОстаток,
	ВзаиморасчётыСПоставщикамиОстатки.Валюта КАК Валюта
ИЗ
	РегистрНакопления.ВзаиморасчётыСПоставщиками.Остатки(, ) КАК ВзаиморасчётыСПоставщикамиОстатки
ГДЕ
	НЕ ВзаиморасчётыСПоставщикамиОстатки.СуммаОстаток = 0</query>
	</dataSet>
	<calculatedField>
		<dataPath>СрокОплаты</dataPath>
		<expression>Отчеты.ДолгиПоставщиков.ПолучитьСрокОплатыДляОтчета(Контрагент,ОбъектРасчётов.Дата)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Срок оплаты</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Terme de paiement</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Payment term</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Plazo de pago</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Format</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ДЛФ=D</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fr</v8:lang>
						<v8:content>DLF=D</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>DLF=D</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>es</v8:lang>
						<v8:content>DLF = D</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<totalField>
		<dataPath>СуммаОстаток</dataPath>
		<expression>Сумма(СуммаОстаток)</expression>
	</totalField>
