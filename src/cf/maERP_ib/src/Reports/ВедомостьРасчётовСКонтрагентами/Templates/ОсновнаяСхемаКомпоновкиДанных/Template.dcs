		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫБОР
		КОГДА ВсП.Регистратор = НЕОПРЕДЕЛЕНО
			ТОГДА NULL
		ИНАЧЕ ВсП.Регистратор
	КОНЕЦ КАК Регистратор,
	ВсП.ПериодСекунда КАК ПериодСекунда,
	ВсП.Организация КАК Организация,
	ВсП.Контрагент КАК Контрагент,
	ВсП.Договор КАК Договор,
	ВЫБОР
		КОГДА ВсП.ОбъектРасчётов = НЕОПРЕДЕЛЕНО
			ТОГДА ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)
		ИНАЧЕ ВсП.ОбъектРасчётов
	КОНЕЦ КАК ОбъектРасчётов,
	ВсП.СуммаНачальныйОстаток КАК НачальныйОстаток,
	ВЫБОР
		КОГДА ВсП.СуммаНачальныйОстаток &lt; 0
			ТОГДА -ВсП.СуммаНачальныйОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК НачальныйОстатокНашДолг,
	ВЫБОР
		КОГДА ВсП.СуммаНачальныйОстаток &gt; 0
			ТОГДА ВсП.СуммаНачальныйОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК НачальныйОстатокДолгКонтрагента,
	ВсП.СуммаКонечныйОстаток КАК КонечныйОстаток,
	ВЫБОР
		КОГДА ВсП.СуммаКонечныйОстаток &lt; 0
			ТОГДА -ВсП.СуммаКонечныйОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК КонечныйОстатокНашДолг,
	ВЫБОР
		КОГДА ВсП.СуммаКонечныйОстаток &gt; 0
			ТОГДА ВсП.СуммаКонечныйОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК КонечныйОстатокДолгКонтрагента,
	ВсП.СуммаРасход КАК Расход,
	ВсП.СуммаПриход КАК Приход,
	ВсП.ПериодДень КАК День,
	ВсП.ПериодНеделя КАК Неделя,
	ВсП.ПериодМесяц КАК Месяц,
	ВсП.ПериодКвартал КАК Квартал,
	ВсП.ПериодПолугодие КАК Полугодие,
	ВсП.ПериодГод КАК Год
ИЗ
	РегистрНакопления.ВзаиморасчётыСПокупателями.ОстаткиИОбороты(, , Авто, , ) КАК ВсП

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЫБОР
		КОГДА ВсП.Регистратор = НЕОПРЕДЕЛЕНО
			ТОГДА NULL
		ИНАЧЕ ВсП.Регистратор
	КОНЕЦ,
	ВсП.ПериодСекунда,
	ВсП.Организация,
	ВсП.Контрагент,
	ВсП.Договор,
	ВЫБОР
		КОГДА ВсП.ОбъектРасчётов = НЕОПРЕДЕЛЕНО
			ТОГДА ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг.ПустаяСсылка)
		ИНАЧЕ ВсП.ОбъектРасчётов
	КОНЕЦ,
	ВсП.СуммаНачальныйОстаток,
	ВЫБОР
		КОГДА ВсП.СуммаНачальныйОстаток &lt; 0
			ТОГДА -ВсП.СуммаНачальныйОстаток
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА ВсП.СуммаНачальныйОстаток &gt; 0
			ТОГДА ВсП.СуммаНачальныйОстаток
		ИНАЧЕ 0
	КОНЕЦ,
	ВсП.СуммаКонечныйОстаток,
	ВЫБОР
		КОГДА ВсП.СуммаКонечныйОстаток &lt; 0
			ТОГДА -ВсП.СуммаКонечныйОстаток
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА ВсП.СуммаКонечныйОстаток &gt; 0
			ТОГДА ВсП.СуммаКонечныйОстаток
		ИНАЧЕ 0
	КОНЕЦ,
	ВсП.СуммаРасход,
	ВсП.СуммаПриход,
	ВсП.ПериодДень,
	ВсП.ПериодНеделя,
	ВсП.ПериодМесяц,
	ВсП.ПериодКвартал,
	ВсП.ПериодПолугодие,
	ВсП.ПериодГод
ИЗ
	РегистрНакопления.ВзаиморасчётыСПоставщиками.ОстаткиИОбороты(, , Авто, , ) КАК ВсП

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЫБОР
		КОГДА ВсКП.Регистратор = НЕОПРЕДЕЛЕНО
			ТОГДА NULL
		ИНАЧЕ ВсКП.Регистратор
	КОНЕЦ,
	ВсКП.ПериодСекунда,
	ВсКП.Организация,
	ВсКП.Контрагент,
	ЗНАЧЕНИЕ(Справочник.ДоговорыСКонтрагентами.ПустаяСсылка),
	ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг.ПустаяСсылка),
	ВсКП.СуммаНачальныйОстаток,
	ВЫБОР
		КОГДА ВсКП.СуммаНачальныйОстаток &lt; 0
			ТОГДА -ВсКП.СуммаНачальныйОстаток
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА ВсКП.СуммаНачальныйОстаток &gt; 0
			ТОГДА ВсКП.СуммаНачальныйОстаток
		ИНАЧЕ 0
	КОНЕЦ,
	ВсКП.СуммаКонечныйОстаток,
	ВЫБОР
		КОГДА ВсКП.СуммаКонечныйОстаток &lt; 0
			ТОГДА -ВсКП.СуммаКонечныйОстаток
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА ВсКП.СуммаКонечныйОстаток &gt; 0
			ТОГДА ВсКП.СуммаКонечныйОстаток
		ИНАЧЕ 0
	КОНЕЦ,
	ВсКП.СуммаРасход,
	ВсКП.СуммаПриход,
	ВсКП.ПериодДень,
	ВсКП.ПериодНеделя,
	ВсКП.ПериодМесяц,
	ВсКП.ПериодКвартал,
	ВсКП.ПериодПолугодие,
	ВсКП.ПериодГод
ИЗ
	РегистрНакопления.ВзаиморасчётыСКонтрагентамиПрочие.ОстаткиИОбороты(, , Авто, , ) КАК ВсКП</query>
