		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫБОР
		КОГДА ВсП.Регистратор = НЕОПРЕДЕЛЕНО
			ТОГДА NULL
		ИНАЧЕ ВсП.Регистратор
	КОНЕЦ КАК Регистратор,
	ВсП.ПериодСекунда КАК ПериодСекунда,
	ВсП.Организация КАК Организация,
	ВсП.Контрагент КАК Контрагент,
	ВсП.СтатьяДДС КАК СтатьяДДС,
	ВсП.СуммаНачальныйОстаток КАК НачальныйОстаток,
	ВЫБОР
		КОГДА ВсП.СуммаНачальныйОстаток &lt; 0
			ТОГДА -ВсП.СуммаНачальныйОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК НачальныйОстатокНашДолг,
	ВЫБОР
		КОГДА ВсП.СуммаНачальныйОстаток &gt; 0
			ТОГДА ВсП.СуммаНачальныйОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК НачальныйОстатокДолгПоставщика,
	ВсП.СуммаКонечныйОстаток КАК КонечныйОстаток,
	ВЫБОР
		КОГДА ВсП.СуммаКонечныйОстаток &lt; 0
			ТОГДА -ВсП.СуммаКонечныйОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК КонечныйОстатокНашДолг,
	ВЫБОР
		КОГДА ВсП.СуммаКонечныйОстаток &gt; 0
			ТОГДА ВсП.СуммаКонечныйОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК КонечныйОстатокДолгПоставщика,
	ВсП.СуммаРасход КАК Поставлено,
	ВсП.СуммаПриход КАК Оплачено,
	ВсП.ПериодДень КАК День,
	ВсП.ПериодНеделя КАК Неделя,
	ВсП.ПериодМесяц КАК Месяц,
	ВсП.ПериодКвартал КАК Квартал,
	ВсП.ПериодПолугодие КАК Полугодие,
	ВсП.ПериодГод КАК Год,
	ВсП.ОбъектРасчётов КАК ОбъектРасчётов
ИЗ
	РегистрНакопления.ВзаиморасчётыСКонтрагентамиПрочие.ОстаткиИОбороты(, , Авто, , ) КАК ВсП</query>
	</dataSet>
	<totalField>
		<dataPath>НачальныйОстатокДолгПоставщика</dataPath>
		<expression>Сумма(НачальныйОстатокДолгПоставщика)</expression>
	</totalField>
	<totalField>
		<dataPath>НачальныйОстатокНашДолг</dataPath>
		<expression>Сумма(НачальныйОстатокНашДолг)</expression>
	</totalField>
	<totalField>
		<dataPath>Поставлено</dataPath>
		<expression>Сумма(Поставлено)</expression>
	</totalField>
	<totalField>
		<dataPath>Оплачено</dataPath>
		<expression>Сумма(Оплачено)</expression>
	</totalField>
	<totalField>
		<dataPath>КонечныйОстатокДолгПоставщика</dataPath>
		<expression>Сумма(КонечныйОстатокДолгПоставщика)</expression>
	</totalField>
	<totalField>
		<dataPath>КонечныйОстатокНашДолг</dataPath>
		<expression>Сумма(КонечныйОстатокНашДолг)</expression>
	</totalField>
