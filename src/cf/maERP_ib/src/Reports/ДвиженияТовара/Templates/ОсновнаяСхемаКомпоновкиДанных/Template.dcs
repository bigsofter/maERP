		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ТоварыНаСкладахОбороты.Регистратор КАК Регистратор,
	НАЧАЛОПЕРИОДА(ТоварыНаСкладахОбороты.Регистратор.Дата, ДЕНЬ) КАК Период,
	ТоварыНаСкладахОбороты.ПериодМесяц КАК ПериодМесяц,
	ВЫБОР
		КОГДА ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.СписаниеТоваров
			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПоказателиДвиженияТоваров.Списано)
		КОГДА ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПоказателиДвиженияТоваров.Продано)
		КОГДА ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПоказателиДвиженияТоваров.Поступило)
		КОГДА ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ВозвратОтПокупателя
			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПоказателиДвиженияТоваров.ВозвратыОтПокупателей)
		КОГДА ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ВозвратПоставщику
			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПоказателиДвиженияТоваров.ВозвратыПоставщикам)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ПоказателиДвиженияТоваров.Прочее)
	КОНЕЦ КАК Показатель,
	ТоварыНаСкладахОбороты.МестоХранения КАК МестоХранения,
	ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура,
	ТоварыНаСкладахОбороты.КоличествоОборот КАК Количество,
	ТоварыНаСкладахОбороты.СуммаОборот КАК Сумма,
	ЕдиницаИзмеренияВеса.Значение КАК ЕдиницаИзмеренияВеса
ИЗ
	РегистрНакопления.ТоварыВНаличии.Обороты(, , Авто, ) КАК ТоварыНаСкладахОбороты,
	Константа.ЕдиницаИзмеренияВеса КАК ЕдиницаИзмеренияВеса</query>
	</dataSet>
	<calculatedField>
		<dataPath>ОборотКг</dataPath>
		<expression>Выбор когда Номенклатура.Единица.ТипИзмеряемойВеличины = Значение(Перечисление.ТипыИзмеряемыхВеличин.Вес) Тогда
		Количество
	Иначе
		Номенклатура.ВесЗнаменатель * ОбщегоНазначенияВызовСервера.РассчитатьКоэффициентЕдиницы(Номенклатура.ВесЕдиница, ЕдиницаИзмеренияВеса)	
	Конец</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Оборот (кг)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fr</v8:lang>
				<v8:content>Mouvement (kg)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Movement (kg)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>es</v8:lang>
				<v8:content>Movimiento (kg)</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>ОборотКг</dataPath>
		<expression>Сумма(ОборотКг)</expression>
	</totalField>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
	</totalField>
	<totalField>
		<dataPath>Сумма</dataPath>
		<expression>Сумма(Сумма)</expression>
	</totalField>
