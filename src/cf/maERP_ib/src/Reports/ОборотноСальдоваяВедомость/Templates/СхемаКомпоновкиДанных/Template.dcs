						<v8:content>Aproximación del residuo nucleado DT1</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	ВложенныйЗапрос.Счет КАК Счет,
	ВложенныйЗапрос.Валюта КАК Валюта,
	ВложенныйЗапрос.БУНачальныйРазвернутыйОстатокДт КАК БУНачальныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.БУНачальныйРазвернутыйОстатокКт КАК БУНачальныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.БУКонечныйРазвернутыйОстатокДт КАК БУКонечныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.БУКонечныйРазвернутыйОстатокКт КАК БУКонечныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.НУНачальныйРазвернутыйОстатокДт КАК НУНачальныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.НУНачальныйРазвернутыйОстатокКт КАК НУНачальныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.НУКонечныйРазвернутыйОстатокДт КАК НУКонечныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.НУКонечныйРазвернутыйОстатокКт КАК НУКонечныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.СверкаНУКонечныйРазвернутыйОстатокКт КАК СверкаНУКонечныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.СверкаНУНачальныйРазвернутыйОстатокДт КАК СверкаНУНачальныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.СверкаНУНачальныйРазвернутыйОстатокКт КАК СверкаНУНачальныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.СверкаНУКонечныйРазвернутыйОстатокДт КАК СверкаНУКонечныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.ПРНачальныйРазвернутыйОстатокДт КАК ПРНачальныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.ПРНачальныйРазвернутыйОстатокКт КАК ПРНачальныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.ПРКонечныйРазвернутыйОстатокДт КАК ПРКонечныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.ПРКонечныйРазвернутыйОстатокКт КАК ПРКонечныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.ВРНачальныйРазвернутыйОстатокДт КАК ВРНачальныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.ВРНачальныйРазвернутыйОстатокКт КАК ВРНачальныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.ВРКонечныйРазвернутыйОстатокДт КАК ВРКонечныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.ВРКонечныйРазвернутыйОстатокКт КАК ВРКонечныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.КонтрольНачальныйРазвернутыйОстатокДт КАК КонтрольНачальныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.КонтрольКонечныйРазвернутыйОстатокДт КАК КонтрольКонечныйРазвернутыйОстатокДт,
	ВложенныйЗапрос.КонтрольНачальныйРазвернутыйОстатокКт КАК КонтрольНачальныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.КонтрольКонечныйРазвернутыйОстатокКт КАК КонтрольКонечныйРазвернутыйОстатокКт,
	ВложенныйЗапрос.Показатель КАК Показатель,
	ВложенныйЗапрос.ЭтоРазвернутоеСальдо КАК ЭтоРазвернутоеСальдо
ИЗ
	(ВЫБРАТЬ
		ОстаткиИОбороты.Счет КАК Счет,
		ОстаткиИОбороты.Валюта КАК Валюта,
		ОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокДт КАК БУНачальныйРазвернутыйОстатокДт,
		ОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокКт КАК БУНачальныйРазвернутыйОстатокКт,
		ОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокДт КАК БУКонечныйРазвернутыйОстатокДт,
		ОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокКт КАК БУКонечныйРазвернутыйОстатокКт,
		0 КАК НУНачальныйРазвернутыйОстатокДт,
		0 КАК НУНачальныйРазвернутыйОстатокКт,
		0 КАК НУКонечныйРазвернутыйОстатокДт,
		0 КАК НУКонечныйРазвернутыйОстатокКт,
		ОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокДт КАК СверкаНУНачальныйРазвернутыйОстатокДт,
		ОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокКт КАК СверкаНУНачальныйРазвернутыйОстатокКт,
		ОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокДт КАК СверкаНУКонечныйРазвернутыйОстатокДт,
		ОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокКт КАК СверкаНУКонечныйРазвернутыйОстатокКт,
		0 КАК ПРНачальныйРазвернутыйОстатокДт,
		0 КАК ПРНачальныйРазвернутыйОстатокКт,
		0 КАК ПРКонечныйРазвернутыйОстатокДт,
		0 КАК ПРКонечныйРазвернутыйОстатокКт,
		0 КАК ВРНачальныйРазвернутыйОстатокДт,
		0 КАК ВРНачальныйРазвернутыйОстатокКт,
		0 КАК ВРКонечныйРазвернутыйОстатокДт,
		0 КАК ВРКонечныйРазвернутыйОстатокКт,
		0 КАК КонтрольНачальныйРазвернутыйОстатокДт,
		0 КАК КонтрольКонечныйРазвернутыйОстатокДт,
		0 КАК КонтрольНачальныйРазвернутыйОстатокКт,
		0 КАК КонтрольКонечныйРазвернутыйОстатокКт,
		1 КАК Показатель,
		ИСТИНА КАК ЭтоРазвернутоеСальдо
	ИЗ
		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
				{(&amp;НачалоПериода)},
				{(&amp;КонецПериода)},
				,
				,
				Счет В ИЕРАРХИИ (&amp;СчетРазвернутоеСальдо)
					И НЕ Счет В (&amp;СчетаИсключенныеИзЗапросаПоСчетамРазвернутое)
					И (НЕ Счет.Забалансовый
						ИЛИ &amp;ВыводитьЗабалансовыеСчета),
				&amp;СубконтоРазвернутый,
				{(Организация).* КАК Организация}) КАК ОстаткиИОбороты) КАК ВложенныйЗапрос</query>
		</item>
	</dataSet>
