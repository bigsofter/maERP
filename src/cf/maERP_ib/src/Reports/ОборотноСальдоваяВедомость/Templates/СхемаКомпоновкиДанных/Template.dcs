			<field xsi:type="DataSetFieldField">
				<dataPath>СверкаНУКонечныйОстатокКт</dataPath>
				<field>СверкаНУКонечныйОстатокКт</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Сверка НУКонечный остаток кт1</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fr</v8:lang>
						<v8:content>Rapprochement des résidus Nucléés CT1</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>en</v8:lang>
