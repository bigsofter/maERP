			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	ОстаткиИОбороты.Счет КАК Счет,
	ОстаткиИОбороты.Субконто1 КАК Субконто1,
	ОстаткиИОбороты.Субконто2 КАК Субконто2,
	ОстаткиИОбороты.Субконто3 КАК Субконто3,
	ОстаткиИОбороты.Валюта КАК Валюта,
	ОстаткиИОбороты.СуммаНачальныйОстатокДт КАК БУНачальныйОстатокДт,
	ОстаткиИОбороты.СуммаНачальныйОстатокКт КАК БУНачальныйОстатокКт,
	ОстаткиИОбороты.СуммаОборотДт КАК БУОборотДт,
	ОстаткиИОбороты.СуммаОборотКт КАК БУОборотКт,
	ОстаткиИОбороты.СуммаКонечныйОстатокДт КАК БУКонечныйОстатокДт,
	ОстаткиИОбороты.СуммаКонечныйОстатокКт КАК БУКонечныйОстатокКт,
	0 КАК НУНачальныйОстатокДт,
	0 КАК НУНачальныйОстатокКт,
	0 КАК НУОборотДт,
	0 КАК НУОборотКт,
	0 КАК НУКонечныйОстатокДт,
	0 КАК НУКонечныйОстатокКт,
	ОстаткиИОбороты.СуммаНачальныйОстатокДт КАК СверкаНУНачальныйОстатокДт,
	ОстаткиИОбороты.СуммаНачальныйОстатокКт КАК СверкаНУНачальныйОстатокКт,
	ОстаткиИОбороты.СуммаОборотДт КАК СверкаНУОборотДт,
	ОстаткиИОбороты.СуммаОборотКт КАК СверкаНУОборотКт,
	ОстаткиИОбороты.СуммаКонечныйОстатокДт КАК СверкаНУКонечныйОстатокДт,
	ОстаткиИОбороты.СуммаКонечныйОстатокКт КАК СверкаНУКонечныйОстатокКт,
	0 КАК ПРНачальныйОстатокДт,
	0 КАК ПРНачальныйОстатокКт,
	0 КАК ПРОборотДт,
	0 КАК ПРОборотКт,
	0 КАК ПРКонечныйОстатокДт,
	0 КАК ПРКонечныйОстатокКт,
	0 КАК ВРНачальныйОстатокДт,
	0 КАК ВРНачальныйОстатокКт,
	0 КАК ВРОборотДт,
	0 КАК ВРОборотКт,
	0 КАК ВРКонечныйОстатокДт,
	0 КАК ВРКонечныйОстатокКт,
	1 КАК Показатель,
	ОстаткиИОбороты.ВалютнаяСуммаНачальныйОстатокДт КАК ВалютнаяСуммаНачальныйОстатокДт,
	ОстаткиИОбороты.ВалютнаяСуммаНачальныйОстатокКт КАК ВалютнаяСуммаНачальныйОстатокКт,
	ОстаткиИОбороты.ВалютнаяСуммаОборотДт КАК ВалютнаяСуммаОборотДт,
	ОстаткиИОбороты.ВалютнаяСуммаОборотКт КАК ВалютнаяСуммаОборотКт,
	ОстаткиИОбороты.ВалютнаяСуммаКонечныйОстатокДт КАК ВалютнаяСуммаКонечныйОстатокДт,
	ОстаткиИОбороты.ВалютнаяСуммаКонечныйОстатокКт КАК ВалютнаяСуммаКонечныйОстатокКт,
	0 КАК КонтрольОборотДт,
	0 КАК КонтрольОборотКт,
	0 КАК КонтрольНачальныйОстатокДт,
	0 КАК КонтрольКонечныйОстатокДт,
	0 КАК КонтрольНачальныйОстатокКт,
	0 КАК КонтрольКонечныйОстатокКт,
	ПРЕДСТАВЛЕНИЕССЫЛКИ(ОстаткиИОбороты.Субконто1) КАК Субконто1Представление,
	ПРЕДСТАВЛЕНИЕССЫЛКИ(ОстаткиИОбороты.Субконто2) КАК Субконто2Представление,
	ПРЕДСТАВЛЕНИЕССЫЛКИ(ОстаткиИОбороты.Субконто3) КАК Субконто3Представление
{ВЫБРАТЬ
	Субконто1Представление,
	Субконто2Представление,
	Субконто3Представление}
ИЗ
	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			,
			,
			Счет В ИЕРАРХИИ (&amp;СчетДетализации)
				И (НЕ Счет.Забалансовый
					ИЛИ &amp;ВыводитьЗабалансовыеСчета),
			&amp;СубконтоДетализации,
			{(Организация).* КАК Организация}) КАК ОстаткиИОбороты</query>
		</item>
