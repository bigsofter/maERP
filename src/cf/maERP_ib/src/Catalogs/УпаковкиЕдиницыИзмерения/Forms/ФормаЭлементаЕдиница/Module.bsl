
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.Ссылка.Пустая() Тогда 
		Объект.Знаменатель = 1;
		Объект.Числитель = 1;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Объект.Знаменатель = 0 Тогда 
		Объект.Знаменатель = 1;
	КонецЕсли;
	Если Объект.Числитель = 0 Тогда 
		Объект.Числитель = 1;
	КонецЕсли;
КонецПроцедуры
