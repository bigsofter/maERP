  <items xsi:type="form:Decoration">
    <name>СнятСПоддержки</name>
    <id>119</id>
    <title>
      <key>ru</key>
      <value>Внимание! Данный драйвер снят с поддержки производителем. 
Использование данного драйвера не рекомендуется.</value>
    </title>
    <title>
      <key>fr</key>
      <value>Attention! Ce pilote est retiré du support par le Fabricant. 
L'utilisation de ce pilote n'est pas recommandée.</value>
    </title>
    <title>
      <key>en</key>
      <value>Beware! This driver is removed from the support by the Manufacturer. 
The use of this driver is not recommended.</value>
    </title>
    <title>
      <key>es</key>
      <value>¡Cuidado! El fabricante retira este controlador del soporte. 
No se recomienda el uso de este controlador.</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
