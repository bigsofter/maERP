  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникСерииНоменклатуры.Ссылка КАК Ссылка,
	СправочникСерииНоменклатуры.ПометкаУдаления КАК ПометкаУдаления,
	СправочникСерииНоменклатуры.Наименование КАК Наименование,
	СправочникСерииНоменклатуры.ГоденДо КАК ГоденДо,
	СправочникСерииНоменклатуры.ДатаПоступления КАК ДатаПоступления,
	СправочникСерииНоменклатуры.ДатаПроизводства КАК ДатаПроизводства,
	СправочникСерииНоменклатуры.НомерГТД КАК НомерГТД,
	СправочникСерииНоменклатуры.НомерКиЗГИСМ КАК НомерКиЗГИСМ,
	СправочникСерииНоменклатуры.Описание КАК Описание,
	СправочникСерииНоменклатуры.Производитель КАК Производитель,
	СправочникСерииНоменклатуры.СтранаПроисхождения КАК СтранаПроисхождения,
	СправочникСерииНоменклатуры.ТЧПокупатели.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Покупатель КАК Покупатель
	) КАК ТЧПокупатели,
	СправочникСерииНоменклатуры.Предопределенный КАК Предопределенный,
	СправочникСерииНоменклатуры.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
ИЗ
	Справочник.СерииНоменклатуры КАК СправочникСерииНоменклатуры
ГДЕ
	ВЫБОР
			КОГДА &amp;Клиент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				ТОГДА ИСТИНА
			ИНАЧЕ СправочникСерииНоменклатуры.Ссылка В
					(ВЫБРАТЬ
						СерииНоменклатурыПокупатели.Ссылка КАК Ссылка
					ИЗ
						Справочник.СерииНоменклатуры.ТЧПокупатели КАК СерииНоменклатурыПокупатели
					ГДЕ
						СерииНоменклатурыПокупатели.Покупатель = &amp;Клиент)
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;Производитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				ТОГДА ИСТИНА
			ИНАЧЕ СправочникСерииНоменклатуры.Производитель = &amp;Производитель
		КОНЕЦ</queryText>
      <mainTable>Catalog.СерииНоменклатуры</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
