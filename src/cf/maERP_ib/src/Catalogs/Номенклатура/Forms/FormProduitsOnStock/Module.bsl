
&AtServer
Procedure OnCreateAtServer(Cancel, StandardProcessing)
	ТипЦен = Справочники.ВидыЦен.Розничная;
	Если Параметры.Свойство("Контрагент") Тогда
		Если ЗначениеЗаполнено(параметры.Контрагент.ТипЦены) Тогда 
			ТипЦен = параметры.Контрагент.ТипЦены;
		КонецЕсли;
	КонецЕсли;
	LoadProducts();
	CreateButtons();
	FilterProductGroup = "__Tous1__";
	РазрешенныеПоля = СтрРазделить("Номенклатура,Артикул", ",", Ложь);
	УстановитьОграничениеДинамическогоСписка(ЭтаФорма.VT, РазрешенныеПоля);
EndProcedure

&AtServer
Procedure LoadProducts()
	If FilterProductGroup = "__Tous1__" Then 
		ProductFilter = Catalogs.Номенклатура.EmptyRef();
	Else 
		ProductFilter = Catalogs.Номенклатура.FindByCode(FilterProductGroup);
	EndIf;
	
	Query = New Query;
	Query.Text =
	"ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Номенклатура,
	|	ЕСТЬNULL(StockBalance.КоличествоОстаток, 0) КАК Количество,
	|	ЕСТЬNULL(PrixDeProduitSliceLast.Цена, 0) КАК Цена,
	|	ЕСТЬNULL(PrixDeProduitSliceLast.Цена, 0) КАК ЦенаСНДС,
	|	ЕСТЬNULL(StockBalance.Серия, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК Серия
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВНаличии.Остатки(
	|				,
	|				МестоХранения = &МестоХранения
	|					И ВЫБОР
	|						КОГДА &Produit = ЗНАЧЕНИЕ(Catalog.Номенклатура.EmptyRef)
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Номенклатура В ИЕРАРХИИ (&Produit)
	|					КОНЕЦ) КАК StockBalance
	|		ПО СпрНоменклатура.Ссылка = StockBalance.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦены = &PriceType) КАК PrixDeProduitSliceLast
	|		ПО СпрНоменклатура.Ссылка = PrixDeProduitSliceLast.Номенклатура
	|			И (PrixDeProduitSliceLast.Активность)
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Produit = ЗНАЧЕНИЕ(Catalog.Номенклатура.EmptyRef)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ СпрНоменклатура.Ссылка В ИЕРАРХИИ (&Produit)
	|		КОНЕЦ
	|	И НЕ СпрНоменклатура.ЭтоГруппа";
	VT.Параметры.SetParameterValue("МестоХранения",РегистрыСведений.НастройкиПользователей.СкладПользователя());
	VT.Параметры.SetParameterValue("Produit",ProductFilter);
	VT.Параметры.SetParameterValue("PriceType",ТипЦен);
	//VT.Load(Query.Execute().Unload());
	//Элементы.VT.Обновить();
EndProcedure

&AtClient
Procedure VTSelection(Item, SelectedRow, Field, StandardProcessing)
	CurData = items.VT.CurrentData;
	If CurData <> Undefined Then
		Str = New Structure("Номенклатура,Количество,Цена",CurData.Номенклатура,1,CurData.Цена);
		Close(Str);
	EndIf;
EndProcedure

&AtClient
Procedure Choisir(Command)
	CurData = items.VT.CurrentData;
	If CurData <> Undefined Then
		Str = New Structure("Номенклатура,Серия,Количество,Цена",CurData.Номенклатура,CurData.Серия,1,CurData.Цена);
		Close(Str);
	EndIf;
EndProcedure

&AtServer
Procedure CreateButtons()
	Items.FilterProductGroup.ChoiceList.Clear();
	
	Items.FilterProductGroup.ChoiceList.Add("__Tous1__", "Tous");
	
	Query = New Query;
	Query.Text =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СпрНоменклатура.Ссылка КАК Produit
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ГДЕ
	|	СпрНоменклатура.ЭтоГруппа
	|
	|СГРУППИРОВАТЬ ПО
	|	СпрНоменклатура.Ссылка
	|ИТОГИ ПО
	|	Produit ТОЛЬКО ИЕРАРХИЯ";
	
	Result = Query.Execute().Select(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);	
	
	While Result.Next() Do
		Items.FilterProductGroup.ChoiceList.Add(Result.Produit.Code, Result.Produit);  
	КонецЦикла;	
EndProcedure

&AtClient
Procedure FilterProductGroupOnChange(Item)
	LoadProducts();
EndProcedure

