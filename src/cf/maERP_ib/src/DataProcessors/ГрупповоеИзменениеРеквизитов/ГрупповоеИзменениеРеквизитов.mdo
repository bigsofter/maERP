    <synonym>
      <key>es</key>
      <value>Editar en una transacción</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>ru</key>
      <value>При невозможности изменения элементов в транзакции, все изменения будут отменены.</value>
    </toolTip>
    <toolTip>
      <key>fr</key>
      <value>Si vous ne pouvez pas modifier les éléments de la transaction, toutes les modifications seront annulées.</value>
    </toolTip>
    <toolTip>
      <key>en</key>
      <value>If you cannot modify the elements of the transaction, all changes will be canceled.</value>
    </toolTip>
    <toolTip>
      <key>es</key>
      <value>Si no puede modificar los elementos de la transacción, se cancelarán todos los cambios.</value>
    </toolTip>
