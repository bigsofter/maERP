  <attributes uuid="ef7b3e90-ba18-48b9-992e-5ea42329cf7a">
    <name>ИзменятьВТранзакции</name>
    <synonym>
      <key>ru</key>
      <value>Изменять в транзакции</value>
    </synonym>
    <synonym>
      <key>fr</key>
      <value>Modifier dans une transaction</value>
    </synonym>
    <synonym>
      <key>en</key>
      <value>Edit in a transaction</value>
