&НаСервере
Процедура ЗаполнитьТаблицуЗаказов() 
	
	Объект.ТаблицаЗаказов.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказПокупателя.Ссылка КАК ДокументЗаказа
	               |ИЗ
	               |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	               |ГДЕ
	               |	ЗаказПокупателя.ПометкаУдаления = ЛОЖЬ
	               |	И ЗаказПокупателя.Контрагент = &Контрагент
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЗаказПокупателя.Дата УБЫВ";
	Запрос.УстановитьПараметр("Контрагент",ПараметрыСеанса.Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() цикл
		
		тт = объект.ТаблицаЗаказов.Добавить();
		ЗаполнитьЗначенияСвойств(тт,Выборка);  
		тт.КнопкаПовтора = Нстр("fr = 'Répéter'; ru = 'Повторить'; en = 'Repeat'; es = 'Repetir'");
		тт.КнопкаРазвернуть = Нстр("fr = 'Déployer'; ru = 'Развернуть'; en = 'Unwrap'; es = 'Desplegar'");
		тт.НомерЗаказа  = тт.ДокументЗаказа.Номер; 
		тт.ДатаЗаказа  = тт.ДокументЗаказа.Дата;     
		
		СтруктураВозврата = ЗаполнитьСуммыОплатыДолга(тт.ДокументЗаказа);
		
		Если СтруктураВозврата.СуммаОплаты = "0" тогда
			тт.КартинкаОплаты  = 2; 
		ИначеЕсли СтруктураВозврата.СуммаОплаты <> "0" 
			и СтруктураВозврата.СуммаДолга <> "0" тогда
			тт.КартинкаОплаты  = 1; 
		ИначеЕсли СтруктураВозврата.СуммаДолга = "0" тогда
			тт.КартинкаОплаты  = 0;     
		Иначе
			тт.КартинкаОплаты  = -1;     
		КонецЕсли;
		
			СтатусЗаказа =  Строка(РаботаСДокументамиВызовСервера.ПолучитьСтатусЗаказПокупателя(тт.ДокументЗаказа));
		Если СтатусЗаказа = "Новый" Тогда
			СтатусЗаказаСтр = Нстр("fr = 'Nouveau'; ru = 'Новый'; en = 'New'; es = 'Nuevo'");	 
		ИначеЕсли СтатусЗаказа = "В работе" Тогда
			СтатусЗаказаСтр = Нстр("fr = 'Dans le travail'; ru = 'В работе'; en = 'At work'; es = 'En el trabajo'");	
		ИначеЕсли СтатусЗаказа = "Собран" Тогда
			СтатусЗаказаСтр = Нстр("fr = 'Recueillit'; ru = 'Собран'; en = 'Assembled'; es = 'Recogiste'");	
		ИначеЕсли СтатусЗаказа = "Отгружен" Тогда
			СтатусЗаказаСтр = Нстр("fr = 'Expédias'; ru = 'Отгружен'; en = 'Shipped'; es = 'Envie'");	
		ИначеЕсли СтатусЗаказа = "Доставлен" Тогда
			СтатусЗаказаСтр = Нстр("fr = 'Livré'; ru = 'Доставлен'; en = 'Delivered'; es = 'Entregado'");	
        КонецЕсли;
		
		тт.СтатусЗаказа  = СтатусЗаказаСтр; 
		тт.Сумма  = тт.ДокументЗаказа.Сумма; 
		тт.Оплачено  = СтруктураВозврата.СуммаОплаты; 
		тт.Долг  = СтруктураВозврата.СуммаДолга; 
		
		
	КонецЦикла;
	
	
КонецПроцедуры 

