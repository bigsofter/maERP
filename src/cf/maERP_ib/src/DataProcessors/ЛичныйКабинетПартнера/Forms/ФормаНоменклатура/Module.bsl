&НаКлиенте
Процедура ПоискАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	Если СтрДлина(СокрЛП(Текст)) > 3 Тогда    
		ДанныеВыбора =  ППДНаСервере(СокрЛП(Текст));
		Результат = УдалитьОтбор(СписокНоменклатуры.КомпоновщикНастроек.ФиксированныеНастройки.Отбор, "Ссылка");
		ДобавитьОтбор(СписокНоменклатуры.КомпоновщикНастроек.ФиксированныеНастройки.Отбор, "Ссылка", ДанныеВыбора, ВидСравненияКомпоновкиДанных.ВСписке);	
		ЗаписатьОтборВИсторию(Неопределено);
	КонецЕсли;    
	
	Если СокрЛП(Текст) = "" тогда   
		Результат = УдалитьОтбор(СписокНоменклатуры.КомпоновщикНастроек.ФиксированныеНастройки.Отбор, "Ссылка");  
		Элементы.ДекорацияПустогоПоиска.Видимость = Ложь;
	КонецЕсли;	

	Если Элементы.СписокНоменклатуры.ТекущиеДанные = Неопределено тогда 
		
		Элементы.ДекорацияПустогоПоиска.Заголовок = Нстр("en = 'Leave a request to the manager to search for the product "+Текст+". Click here.'; es = 'Deje al gerente una solicitud para buscar el producto "+Текст+". Haga clic aquí.'; fr = 'Laissez une demande de recherche de produit "+Текст+" au gestionnaire. Cliquez ici.'; ru = 'Оставьте заявку на поиск товара "+Текст+" менеджеру. Нажмите здесь.'");
		Элементы.ДекорацияПустогоПоиска.ЦветТекста = WebЦвета.Красный;	
		Элементы.ДекорацияПустогоПоиска.Видимость = Истина;
		
	Иначе
		
		Элементы.ДекорацияПустогоПоиска.Видимость = Ложь;
		
	КонецЕсли;

КонецПроцедуры 


&НаСервере
Функция ППДНаСервере(СтрокаПоиска)    
	//ПолнотекстовыйПоиск.ОбновитьИндекс(истина, ложь);
	СписокПоиска = ПолнотекстовыйПоиск.СоздатьСписок(СтрокаПоиска, 100);
	СписокПоиска.ОбластьПоиска.Добавить(Метаданные.Справочники.Номенклатура);  
	СписокПоиска.ПорогНечеткости = 10;
	СписокПоиска.ПерваяЧасть();
	ДанныеВыбора = Новый СписокЗначений;
	Если СписокПоиска.Количество() Тогда
		Для Каждого ЭлементПоиска Из СписокПоиска Цикл
			ДанныеВыбора.Добавить(ЭлементПоиска.Значение, ЭлементПоиска.Представление + "; " + ЭлементПоиска.Описание);
		КонецЦикла;
	КонецЕсли; 
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтрокаПоиска", "%"+СтрокаПоиска+"%");
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 50
	               |	Номенклатура.Ссылка КАК Ссылка,
	               |	Номенклатура.Наименование КАК Наименование,
	               |	Номенклатура.Артикул КАК Артикул,
	               |	Номенклатура.Код КАК Код
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	(Номенклатура.Наименование ПОДОБНО &СтрокаПоиска
	               |			ИЛИ Номенклатура.Артикул ПОДОБНО &СтрокаПоиска)";
	
	
	Выборка = Запрос.Выполнить().Выбрать();                                
	Пока Выборка.Следующий() Цикл
		Представление = Выборка.Наименование;
		ДанныеВыбора.Добавить(Выборка.Ссылка, Представление+ "; " +Выборка.Артикул);
	КонецЦикла; 
	// - 	
	
	возврат ДанныеВыбора;
КонецФункции


