&НаСервере
Процедура ПовторитьЗаказЛКПНаСервере(НомЗаказа)
	
    Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ЗаказПокупателяТЧТовары.Номенклатура КАК Номенклатура,
	                |	ЗаказПокупателяТЧТовары.Количество КАК Количество,
	                |	ЗаказПокупателяТЧТовары.Цена КАК Цена,
	                |	ЗаказПокупателяТЧТовары.Сумма КАК Сумма
	                |ИЗ
	                |	Документ.ЗаказПокупателя.ТЧТовары КАК ЗаказПокупателяТЧТовары
	                |ГДЕ
	                |	ЗаказПокупателяТЧТовары.Ссылка.Номер = &НомерЗаказа";
	Запрос.УстановитьПараметр("НомерЗаказа",НомЗаказа);
	
	объект.Корзина.Очистить(); 
	
	Выборка = запрос.Выполнить().Выбрать();
	
	Пока выборка.Следующий() Цикл
		тт = объект.Корзина.Добавить();
		ЗаполнитьЗначенияСвойств(тт,выборка);
	КонецЦикла; 
	
	ЗапомнитьДинамическиКорзину();
	
КонецПроцедуры 

&НаКлиенте
Процедура ТаблицаЗаказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	если поле.имя = "ТаблицаЗаказовКнопкаПовтора" Тогда  
		
		ПовторитьЗаказЛКПНаСервере(Элементы.ТаблицаЗаказов.ТекущиеДанные.НомерЗаказа);  
		ПереходНаСтраницу = Элементы.ГруппаКорзиныСтр.ПодчиненныеЭлементы.Найти("ГруппаКорзиныСтр1");
		ЭтаФорма.Элементы.ГруппаКорзиныСтр.ТекущаяСтраница = ПереходНаСтраницу; 
		ОтобразимКорзинуИзДинамики();    
		
	КонецЕсли;
	
	если поле.имя = "ТаблицаЗаказовКнопкаРазвернуть" Тогда  
		
		ТекСтрока = Элементы.ТаблицаЗаказов.ТекущиеДанные;
		Если ТекСтрока.Развернуто = ложь Тогда         
			
			ТекСтрока.КнопкаРазвернуть = Нстр("fr = 'Rouler'; ru = 'Свернуть'; en = 'Roll up'; es = 'Enrollar'"); 
			
			ТекСтрока.Развернуто = Истина;   
			
			ИндСтроки = ТекСтрока.НомерСтроки-1;   
			ИндСтрокиПустышки = 0;   

			ПолучитьТЗТовары(ТекСтрока.ДокументЗаказа);
			
			Для каждого стр из ТЗТовары цикл
				НовСтрВставка = Объект.ТаблицаЗаказов.Вставить(ИндСтроки); 
				НовСтрВставка.ИдСтроки = ИндСтроки+1;    
				НовСтрВставка.КартинкаОплаты = -1;  
				
				НовСтрВставка.СтатусЗаказа = стр.Артикул; 
				НовСтрВставка.Сумма = стр.Номенклатура;   
				НовСтрВставка.Оплачено = стр.Количество;  
				НовСтрВставка.Долг = стр.Сумма;    
				
				//ИндСтрокиПустышки = НовСтрВставка.НомерСтроки-1;   

				Объект.ТаблицаЗаказов.Сдвинуть(ИндСтроки, 1);   
			КонецЦикла;
			
			//НовСтрВставка = Объект.ТаблицаЗаказов.Вставить(ИндСтрокиПустышки); 
			//НовСтрВставка.ИдСтроки = ИндСтрокиПустышки+1;    
			//НовСтрВставка.КартинкаОплаты = -1;    
			//Объект.ТаблицаЗаказов.Сдвинуть(ИндСтрокиПустышки, 1);   
		Иначе
			
			ТекСтрока.КнопкаРазвернуть = Нстр("fr = 'Déployer'; ru = 'Развернуть'; en = 'Unwrap'; es = 'Desplegar'"); 
			
			ТекСтрока.Развернуто = ложь;   
			
			ИндСтроки = ТекСтрока.НомерСтроки;
			
			СтруктураДляПоиска = Новый Структура("ИдСтроки", ИндСтроки); 
			ТабличнаяЧастьДок = Объект.ТаблицаЗаказов; 
			МассивСтрок = ТабличнаяЧастьДок.НайтиСтроки(СтруктураДляПоиска); 
			Для каждого Строка Из МассивСтрок Цикл 
				ТабличнаяЧастьДок.Удалить(Строка); 
			КонецЦикла; 			
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры    


&НаСервере
Процедура ПолучитьТЗТовары(ТекСтрокаДокументЗаказа)

	 Запрос = новый Запрос;
	 Запрос.Текст = "ВЫБРАТЬ
	                |	ЗаказПокупателяТЧТовары.Номенклатура.Артикул КАК Артикул,
	                |	ЗаказПокупателяТЧТовары.Номенклатура КАК Номенклатура,
	                |	ЗаказПокупателяТЧТовары.Количество КАК Количество,
	                |	ЗаказПокупателяТЧТовары.Сумма КАК Сумма
	                |ИЗ
	                |	Документ.ЗаказПокупателя.ТЧТовары КАК ЗаказПокупателяТЧТовары
	                |ГДЕ
	                |	ЗаказПокупателяТЧТовары.Ссылка = &Ссылка";
	 Запрос.УстановитьПараметр("Ссылка",ТекСтрокаДокументЗаказа);
	 
	Выборка = Запрос.Выполнить().Выгрузить(); 
	
	ТЗТовары.Очистить();
	
	Для каждого стр из Выборка цикл
		тт = ТЗТовары.Добавить();
		ЗаполнитьЗначенияСвойств(тт,стр);
	КонецЦикла;
	
КонецПроцедуры

