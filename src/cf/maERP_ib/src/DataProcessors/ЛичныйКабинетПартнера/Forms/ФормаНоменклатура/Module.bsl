&НаСервере
Процедура ЗаполнитьТаблицуЗаявок() 
	
	Объект.ТаблицаЗаявок.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкаНаПоискТовара.Ссылка КАК ДокументЗаявки
	               |ИЗ
	               |	Документ.ЗаявкаНаПоискТовара КАК ЗаявкаНаПоискТовара
	               |ГДЕ
	               |	ЗаявкаНаПоискТовара.ПометкаУдаления = ЛОЖЬ
	               |	И ЗаявкаНаПоискТовара.Ответственный = &Ответственный
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЗаявкаНаПоискТовара.Дата УБЫВ";
	Запрос.УстановитьПараметр("Ответственный",ПараметрыСеанса.Пользователь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() цикл
		
		тт = объект.ТаблицаЗаявок.Добавить();
		ЗаполнитьЗначенияСвойств(тт,Выборка);  
		тт.НомерЗаявки  = тт.ДокументЗаявки.Номер; 
		тт.ДатаЗаявки  = тт.ДокументЗаявки.Дата;     
				
			СтатусЗаказа = Строка(тт.ДокументЗаявки.Статус);
		Если СтатусЗаказа = "Ожидает менеджера" Тогда
			СтатусЗаказаСтр = Нстр("fr = 'Attend le gestionnaire'; ru = 'Ожидает менеджера'; en = 'Waiting for the manager'; es = 'Espera gerente'");	 
		ИначеЕсли СтатусЗаказа = "Поиск" Тогда
			СтатусЗаказаСтр = Нстр("fr = 'Recherche'; ru = 'Поиск'; en = 'Search'; es = 'Búsqueda'");	
		ИначеЕсли СтатусЗаказа = "Отменена" Тогда
			СтатусЗаказаСтр = Нстр("fr = 'Proscrit'; ru = 'Отменена'; en = 'Cancelled'; es = 'Inválido'");	
		ИначеЕсли СтатусЗаказа = "Найдено" Тогда
			СтатусЗаказаСтр = Нстр("fr = 'Trouvé'; ru = 'Найдено'; en = 'Found'; es = 'Encontrado'");	
		ИначеЕсли СтатусЗаказа = "Не найдено" Тогда
			СтатусЗаказаСтр = Нстр("fr = 'Introuvable'; ru = 'Не найдено'; en = 'Not found'; es = 'No encontrado'");	
		КонецЕсли;
		
		тт.СтатусЗаявки  = СтатусЗаказаСтр; 		
		
	КонецЦикла;
	
	
КонецПроцедуры 

