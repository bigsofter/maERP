&НаСервере
Процедура СписокНоменклатурыВыборНаСервере(ТекТовар, ТекЦена)    
	
	НоваяПозицияКорзины = Истина;
	
	Для каждого стр из Объект.Корзина цикл  
		Если Стр.Номенклатура = ТекТовар Тогда
			Стр.Количество = Стр.Количество+1;
			Стр.Цена = ТекЦена;
			Стр.Сумма = Стр.Количество*ТекЦена;   
			НоваяПозицияКорзины = Ложь;
		КонецЕсли;
	КонецЦикла;	  
	
	Если НоваяПозицияКорзины тогда
		НоваяСтрока = объект.Корзина.Добавить();
		НоваяСтрока.Номенклатура = ТекТовар;
		НоваяСтрока.Количество = 1;     
		НоваяСтрока.Цена = ТекЦена;
		НоваяСтрока.Сумма = ТекЦена; 
	КонецЕсли;
	
	ЗапомнитьДинамическикорзину(Неопределено);
	ЗаписатьОтборВИсторию(ТекТовар);
	ВывестиКорзину(); 
	
КонецПроцедуры   

&НаСервере
Процедура ОтобразимКорзинуИзДинамики()
	
	Объект.Корзина.Очистить();
	
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДинамическаяКорзинаЛКП.Номенклатура КАК Номенклатура,
	               |	ДинамическаяКорзинаЛКП.Количество КАК Количество,
	               |	ДинамическаяКорзинаЛКП.Цена КАК Цена,
	               |	ДинамическаяКорзинаЛКП.Сумма КАК Сумма
	               |ИЗ
	               |	РегистрСведений.ДинамическаяКорзинаЛКП КАК ДинамическаяКорзинаЛКП
	               |ГДЕ
	               |	ДинамическаяКорзинаЛКП.Пользователь = &Пользователь
	               |	И ДинамическаяКорзинаЛКП.ЗаказПокупателя = &ПустойЗаказ";
	Запрос.УстановитьПараметр("Пользователь",ИмяПользователя()); 
	Запрос.УстановитьПараметр("ПустойЗаказ",Документы.ЗаказПокупателя.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока выборка.Следующий() Цикл
		НоваяСтр = объект.Корзина.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр,Выборка);		
	КонецЦикла;
	
	ВывестиКорзину(); 
	
КонецПроцедуры 

&НаСервере
Процедура ЗапомнитьДинамическикорзину(Док = Неопределено)    
	
	Если Док = Неопределено тогда
		НаборЗаписей = РегистрыСведений.ДинамическаяКорзинаЛКП.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Пользователь.Установить(ИмяПользователя());   
		НаборЗаписей.Отбор.ЗаказПокупателя.Установить(Документы.ЗаказПокупателя.ПустаяСсылка());   
		НаборЗаписей.Прочитать();  
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать(Истина);
		
		НаборЗаписей = РегистрыСведений.ДинамическаяКорзинаЛКП.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Пользователь.Установить(ИмяПользователя());   
		НаборЗаписей.Отбор.ЗаказПокупателя.Установить(Документы.ЗаказПокупателя.ПустаяСсылка());  	
		Для каждого стр из объект.Корзина цикл
			Запись01 = НаборЗаписей.Добавить();   
			Запись01.Период = ТекущаяДата();		
			Запись01.Пользователь = ИмяПользователя();
			Запись01.Номенклатура = Стр.Номенклатура;
			Запись01.Количество = Стр.Количество;
			Запись01.Цена = Стр.Цена;
			Запись01.Сумма = Стр.Сумма;
		КонецЦикла; 
		
		НаборЗаписей.Записать(); 
	Иначе
		НаборЗаписей = РегистрыСведений.ДинамическаяКорзинаЛКП.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Пользователь.Установить(ИмяПользователя());   
		НаборЗаписей.Отбор.ЗаказПокупателя.Установить(Документы.ЗаказПокупателя.ПустаяСсылка());   
		НаборЗаписей.Прочитать();  
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();  
		
		Для каждого стр из объект.Корзина цикл
			НоваяЗапись = РегистрыСведений.ДинамическаяКорзинаЛКП.СоздатьМенеджерЗаписи();
			НоваяЗапись.Период = ТекущаяДата();		
			НоваяЗапись.Пользователь = ИмяПользователя();
