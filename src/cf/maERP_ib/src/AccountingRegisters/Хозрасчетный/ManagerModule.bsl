Функция ДобавитьДвижение(ДокОбъект, СчётДт, СчётКт, Количество, Сумма, Валюта, ДанныеСубконто)
	НС = ДокОбъект.Движения.Хозрасчетный.Добавить();
	НС.Период = ДокОбъект.Дата;
	НС.Организация = ДокОбъект.Организация;
	НС.СчетДт = СчётДт;
	НС.СчетКт = СчётКт;
	Если Количество > 0 и НС.СчетДт.Количественный Тогда
		НС.КоличествоДт = Количество;	
	КонецЕсли;
	Если Количество > 0 и НС.СчетКт.Количественный Тогда
		НС.КоличествоКт = Количество;	
	КонецЕсли;
	Если СчётДт.Валютный Тогда
		НС.ВалютнаяСуммаДт = Сумма;
		НС.ВалютаДт = Валюта;
	КонецЕсли;
	Если СчётКт.Валютный Тогда
		НС.ВалютнаяСуммаКт = Сумма;
		НС.ВалютаКт = Валюта;
	КонецЕсли;
	НС.Сумма = Сумма;
	НС.Содержание = ДокОбъект.Метаданные().ПредставлениеОбъекта;
	// Заполняем субконто
	ПВХ = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные;
	// Дт
	Для Каждого Стр Из НС.СчетДт.ВидыСубконто Цикл
		ИмяСубконто = Стр.ВидСубконто.ИмяПредопределенныхДанных;
        НС.СубконтоДт.Вставить(Стр.ВидСубконто, ДанныеСубконто[ИмяСубконто]);
	КонецЦикла;
	// Кт
	Для Каждого Стр Из НС.СчетКт.ВидыСубконто Цикл
		ИмяСубконто = Стр.ВидСубконто.ИмяПредопределенныхДанных;
        НС.СубконтоКт.Вставить(Стр.ВидСубконто, ДанныеСубконто[ИмяСубконто]);
	КонецЦикла;
	Возврат НС;	
КонецФункции
