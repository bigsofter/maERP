	Сч91_02 = ПланыСчетов.Хозрасчетный.ПрочиеРасходы; 
	Для Каждого Стр Из ТЗТовары Цикл
		НС = ДокОбъект.Движения.Хозрасчетный.Добавить();
		НС.Период = ДокОбъект.Дата;
		НС.Организация = ДокОбъект.Организация;
		НС.Содержание = ДокОбъект.Метаданные().ПредставлениеОбъекта;
		Приход = Стр.ВидДвижения = ВидДвиженияНакопления.Приход;
		Сумма = Стр.Сумма;
		НС.СчетДт = Сч76_02;
		НС.СубконтоДт.Контрагенты = ДокОбъект.Контрагент;
		НС.СубконтоДт.Договоры = ДокОбъект.Договор;
		НС.СчетКт = Сч41_1;
		НС.СубконтоКт.Номенклатура = Стр.Номенклатура;
		НС.СубконтоКт.МестаХранения = ДокОбъект.МестоХранения;
		НС.КоличествоКт = Стр.Количество;
		НС.Сумма = Сумма;
	КонецЦикла;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратПоставщику") Тогда
		НС = ДокОбъект.Движения.Хозрасчетный.Добавить();
		НС.Содержание = ДокОбъект.Метаданные().ПредставлениеОбъекта;
		НС.Период = ДокОбъект.Дата;
		НС.Организация = ДокОбъект.Организация;
		НС.СчетДт = Сч60_1;
		НС.СубконтоДт.Контрагенты = ДокОбъект.Контрагент;
		НС.СубконтоДт.Договоры = ДокОбъект.Договор;
		НС.СчетКт = Сч76_02;
		НС.СубконтоКт.Контрагенты = ДокОбъект.Контрагент;
		НС.СубконтоКт.Договоры = ДокОбъект.Договор;
		НС.Сумма = ДокОбъект.Сумма;
		
		СуммаДохода = ДокОбъект.Сумма - ТЗТовары.Итог("Сумма");
		Если СуммаДохода>0 Тогда 
			НС = ДокОбъект.Движения.Хозрасчетный.Добавить();
			НС.Содержание = ДокОбъект.Метаданные().ПредставлениеОбъекта;
			НС.Период = ДокОбъект.Дата;
			НС.Организация = ДокОбъект.Организация;
			НС.СчетДт = Сч76_02;
			НС.СубконтоДт.Контрагенты = ДокОбъект.Контрагент;
			НС.СубконтоДт.Договоры = ДокОбъект.Договор;
			НС.СчетКт = Сч91_01;
			НС.Сумма = СуммаДохода;
		Иначе
			НС = ДокОбъект.Движения.Хозрасчетный.Добавить();
			НС.Содержание = ДокОбъект.Метаданные().ПредставлениеОбъекта;
			НС.Период = ДокОбъект.Дата;
			НС.Организация = ДокОбъект.Организация;
			НС.СчетДт = Сч91_02;
			НС.СчетКт = Сч76_02;
			НС.СубконтоКт.Контрагенты = ДокОбъект.Контрагент;
			НС.СубконтоКт.Договоры = ДокОбъект.Договор;
			НС.Сумма = -СуммаДохода;
		КонецЕсли;
	КонецЕсли;
	////НДС не формируем
	//Если ДокОбъект.ДополнительныеСвойства.Свойство("ТЗТоварыССериями") Тогда
	//	ТЗНдс = ДокОбъект.ДополнительныеСвойства.ТЗТоварыССериями.Скопировать();
	//Иначе
	//	ТЗНдс = ДокОбъект.ТЧТовары.Выгрузить();
