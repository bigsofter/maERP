			НС.СчетКт = Сч41_1;
			НС.СубконтоКт.Номенклатура = Стр.Номенклатура;
			НС.СубконтоКт.МестаХранения = ДокОбъект.МестоХранения;
			НС.КоличествоКт = Стр.Количество;
		Иначе
			НС.Содержание = "Выпуск продукции";
			НС.СчетДт = Сч41_1;
			НС.СубконтоДт.Номенклатура = Стр.Номенклатура;
			НС.СубконтоДт.МестаХранения = ДокОбъект.МестоХраненияОприходование;
			НС.КоличествоДт = Стр.Количество;
			НС.СчетКт = Сч20;
		КонецЕсли;
		НС.Сумма = Стр.Сумма;
	КонецЦикла;
