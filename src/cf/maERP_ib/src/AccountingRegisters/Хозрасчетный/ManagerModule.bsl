Процедура ДвижениеСписаниеОприходованиеТоваров(ДокОбъект,ТЗТовары)
	Сч41_1 = ПланыСчетов.Хозрасчетный.ТоварыНаСкладах;
	Сч91_01 = ПланыСчетов.Хозрасчетный.ПрочиеДоходы;
	Сч94 = ПланыСчетов.Хозрасчетный.НедостачиИПотериОтПорчиЦенностей;
	Для Каждого Стр Из ТЗТовары Цикл
		НС = ДокОбъект.Движения.Хозрасчетный.Добавить();
		НС.Содержание = ДокОбъект.Метаданные().ПредставлениеОбъекта;
		НС.Период = ДокОбъект.Дата;
		НС.Организация = ДокОбъект.Организация; 
		Если Стр.ВидДвижения = ВидДвиженияНакопления.Приход Тогда 
			НС.СчетДт = Сч41_1;
			НС.СубконтоДт.Номенклатура = Стр.Номенклатура;
			НС.СубконтоДт.МестаХранения = Стр.МестоХранения;
			НС.КоличествоДт = Стр.Количество;
			НС.СчетКт = Сч91_01;
		Иначе 
			НС.СчетДт = Сч94;
			НС.СчетКт = Сч41_1;
			НС.СубконтоКт.Номенклатура = Стр.Номенклатура;
			НС.СубконтоКт.МестаХранения = Стр.МестоХранения;
			НС.КоличествоКт = Стр.Количество;
		КонецЕсли;
		НС.Сумма = Стр.Сумма;
	КонецЦикла;
КонецПроцедуры

Процедура ДвижениеПеремещениеТоваров(ДокОбъект,ТЗТовары)
	Сч41_1 = ПланыСчетов.Хозрасчетный.ТоварыНаСкладах;
	Мас = ТЗТовары.НайтиСтроки(Новый Структура("ВидДвижения",ВидДвиженияНакопления.Расход));
	Для Каждого Стр Из Мас Цикл
		НС = ДокОбъект.Движения.Хозрасчетный.Добавить();
		НС.Содержание = "Перемещение товаров";
		НС.Период = ДокОбъект.Дата;
		НС.Организация = ДокОбъект.Организация; 
		НС.СчетДт = Сч41_1;
		НС.СубконтоДт.Номенклатура = Стр.Номенклатура;
		НС.СубконтоДт.МестаХранения = ДокОбъект.МестоХранения;
		НС.КоличествоДт = Стр.Количество;
		НС.СчетКт = Сч41_1;
		НС.СубконтоКт.Номенклатура = Стр.Номенклатура;
		НС.СубконтоКт.МестаХранения = ДокОбъект.МестоХраненияОприходование;
		НС.КоличествоКт = Стр.Количество;
		НС.Сумма = Стр.Сумма;
	КонецЦикла;
