	Сч90_01_1 = ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД;
	Сч90_3 = ПланыСчетов.Хозрасчетный.Продажи_НДС;
	Сч68_02 = ПланыСчетов.Хозрасчетный.НДС;
	ЭтоКорректировка = Не ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг");
	ТЗТовары.Свернуть("ВидДвижения,МестоХранения,Номенклатура","Количество,Сумма");
	Для Каждого Стр Из ТЗТовары Цикл
		НС = ДокОбъект.Движения.Хозрасчетный.Добавить();
		НС.Содержание = ДокОбъект.Метаданные().ПредставлениеОбъекта;
		НС.Период = ДокОбъект.Дата;
		НС.Организация = ДокОбъект.Организация; 
		Приход = Стр.ВидДвижения = ВидДвиженияНакопления.Приход;
		НС.СчетДт = Сч90_02_1;
		НС.СубконтоДт.НоменклатурныеГруппы = Стр.Номенклатура.ТоварнаяГруппа;
		НС.СчетКт = Сч41_1;                                            
		НС.СубконтоКт.Номенклатура = Стр.Номенклатура;
		НС.СубконтоКт.МестаХранения = ДокОбъект.МестоХранения;
		НС.КоличествоКт = ?(Приход,-Стр.Количество,Стр.Количество);
		НС.Сумма = ?(Приход,-Стр.Сумма,Стр.Сумма);
	КонецЦикла; 
	Если ДокОбъект.ДополнительныеСвойства.Свойство("ТЗТоварыССериями") Тогда
		ТЗТоварыССериями = ДокОбъект.ДополнительныеСвойства.ТЗТоварыССериями.Скопировать();
	Иначе
		ТЗТоварыССериями = ДокОбъект.ТЧТовары.Выгрузить();
	КонецЕсли;
	Для Каждого Стр из ТЗТоварыССериями Цикл 
		НС = ДокОбъект.Движения.Хозрасчетный.Добавить();
		НС.Содержание = ДокОбъект.Метаданные().ПредставлениеОбъекта;
		НС.Период = ДокОбъект.Дата;
		НС.Организация = ДокОбъект.Организация; 
		НС.СчетДт = Сч62_1;
		НС.СубконтоДт.Контрагенты = ДокОбъект.Контрагент;
		НС.СубконтоДт.Договоры = ДокОбъект.Договор;
		НС.СчетКт = Сч90_01_1;
		НС.СубконтоКт.НоменклатурныеГруппы = Стр.Номенклатура.ТоварнаяГруппа;
		НС.СубконтоКт.Номенклатура = Стр.Номенклатура;
		НС.СубконтоКт.СтавкиНДС = Стр.СтавкаНДС;
		НС.КоличествоКт = ?(ЭтоКорректировка,-Стр.Количество,Стр.Количество);
		НС.Сумма = ?(ЭтоКорректировка,-Стр.СуммаСНДС,Стр.СуммаСНДС);
	КонецЦикла;
	
	////НДС не формируем
	//ТЗНдс = ДокОбъект.ТЧТовары.Выгрузить();
	//ТЗНдс.Свернуть("Номенклатура,СтавкаНДС","СуммаНДС");
	//Если ЭтоКорректировка Тогда
	//	ТЗНдс.очистить();
	//	Для Каждого Стр из ДокОбъект.ТЧТовары Цикл
	//		Если Стр.СтавкаНДС = Стр.СтавкаНДСДоКорректировки 
	//			И Стр.СуммаНДС = Стр.СуммаНДСДоКорректировки Тогда 
