    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументПрочиеРасходы.Ссылка КАК Ссылка,
	ДокументПрочиеРасходы.ПометкаУдаления КАК ПометкаУдаления,
	ДокументПрочиеРасходы.Номер КАК Номер,
	ДокументПрочиеРасходы.Дата КАК Дата,
	ДокументПрочиеРасходы.Проведен КАК Проведен,
	ДокументПрочиеРасходы.Организация КАК Организация,
	ДокументПрочиеРасходы.МестоХранения КАК МестоХранения,
	ДокументПрочиеРасходы.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	ДокументПрочиеРасходы.Ответственный КАК Ответственный,
	ДокументПрочиеРасходы.Сумма КАК Сумма,
	ДокументПрочиеРасходы.Контрагент КАК Контрагент,
	ДокументПрочиеРасходы.СтатьяДДС КАК СтатьяДДС,
	ДокументПрочиеРасходы.ТЧРасходы.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		СтатьяДДС КАК СтатьяДДС,
		Сумма КАК Сумма
	) КАК ТЧРасходы,
	ДокументПрочиеРасходы.МоментВремени КАК МоментВремени,
	ЕСТЬNULL(ПрисоединённыеФайлыНаличие.ЕстьФайлы, ЛОЖЬ) КАК ЕстьФайлы,
	ДокументПрочиеРасходы.ДатаОтгрузочногоДокумента КАК ДатаОтгрузочногоДокумента,
	ДокументПрочиеРасходы.НомерОтгрузочногоДокумента КАК НомерОтгрузочногоДокумента,
	ДокументПрочиеРасходы.Комментарий КАК Комментарий,
	ВзаиморасчётыСКонтрагентамиПрочиеОстатки.СуммаОстаток КАК СуммаОстаток,
	ВЫБОР
		КОГДА НЕ ДокументПрочиеРасходы.Проведен
			ТОГДА 2
		КОГДА ЕСТЬNULL(ВзаиморасчётыСКонтрагентамиПрочиеОстатки.СуммаОстаток, 0) >= 0
			ТОГДА 0
		КОГДА ДокументПрочиеРасходы.Сумма > -ЕСТЬNULL(ВзаиморасчётыСКонтрагентамиПрочиеОстатки.СуммаОстаток, 0)
			ТОГДА 1
		ИНАЧЕ 2
	КОНЕЦ КАК ПолеКартинки
ИЗ
	Документ.ПрочиеРасходыВозврат КАК ДокументПрочиеРасходы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединённыеФайлыНаличие КАК ПрисоединённыеФайлыНаличие
		ПО ДокументПрочиеРасходы.Ссылка = ПрисоединённыеФайлыНаличие.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчётыСКонтрагентамиПрочие.Остатки КАК ВзаиморасчётыСКонтрагентамиПрочиеОстатки
		ПО ДокументПрочиеРасходы.Ссылка = ВзаиморасчётыСКонтрагентамиПрочиеОстатки.ОбъектРасчётов</queryText>
      <mainTable>Document.ПрочиеРасходыВозврат</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
