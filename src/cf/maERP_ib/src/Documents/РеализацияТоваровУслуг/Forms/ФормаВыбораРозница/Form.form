  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.СуммаОстаток</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ВТ.Ссылка КАК Ссылка,
	ВТ.ПометкаУдаления КАК ПометкаУдаления,
	ВТ.Номер КАК Номер,
	ВТ.Дата КАК Дата,
	ВТ.Проведен КАК Проведен,
	ВТ.Контрагент КАК Контрагент,
	ВТ.МестоХранения КАК МестоХранения,
	ВТ.Организация КАК Организация,
	СУММА(ВТ.Сумма) КАК Сумма,
	ВТ.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	СУММА(ВТ.СуммаНДС) КАК СуммаНДС,
	СУММА(ВТ.СуммаОстаток) КАК СуммаОстаток
ИЗ
	(ВЫБРАТЬ
		ДокументРеализацияТоваровУслуг.Ссылка КАК Ссылка,
		ДокументРеализацияТоваровУслуг.ПометкаУдаления КАК ПометкаУдаления,
		ДокументРеализацияТоваровУслуг.Номер КАК Номер,
		ДокументРеализацияТоваровУслуг.Дата КАК Дата,
		ДокументРеализацияТоваровУслуг.Проведен КАК Проведен,
		ДокументРеализацияТоваровУслуг.Контрагент КАК Контрагент,
		ДокументРеализацияТоваровУслуг.МестоХранения КАК МестоХранения,
		ДокументРеализацияТоваровУслуг.Организация КАК Организация,
		ДокументРеализацияТоваровУслуг.Сумма КАК Сумма,
		ДокументРеализацияТоваровУслуг.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
		ДокументРеализацияТоваровУслуг.СуммаНДС КАК СуммаНДС,
		ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) КАК СуммаОстаток
	ИЗ
		Документ.РеализацияТоваровУслуг КАК ДокументРеализацияТоваровУслуг
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки КАК ВзаиморасчётыСПокупателямиОстатки
			ПО (ВзаиморасчётыСПокупателямиОстатки.ОбъектРасчётов = ДокументРеализацияТоваровУслуг.Ссылка)
	ГДЕ
		ДокументРеализацияТоваровУслуг.Контрагент = &amp;Контрагент
		И ДокументРеализацияТоваровУслуг.МестоХранения = &amp;МестоХранения
		И (ДокументРеализацияТоваровУслуг.ХозяйственнаяОперация = &amp;Операция
				ИЛИ &amp;Операция = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПустаяСсылка))
		И ВЫБОР
				КОГДА &amp;ТолькоНеоплаченные
					ТОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) &lt;> 0
				ИНАЧЕ ИСТИНА
			КОНЕЦ
		И ДокументРеализацияТоваровУслуг.Проведен
		И ВЫБОР
				КОГДА &amp;ЕстьТовары
					ТОГДА ДокументРеализацияТоваровУслуг.Ссылка В
							(ВЫБРАТЬ
								Док.Ссылка
							ИЗ
								Документ.РеализацияТоваровУслуг.ТЧТовары КАК Док
							ГДЕ
								Док.Номенклатура В (&amp;МасТовары))
				ИНАЧЕ ИСТИНА
			КОНЕЦ
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		ВозвратОтПокупателя.Основание.Ссылка,
		ВозвратОтПокупателя.Основание.ПометкаУдаления,
		ВозвратОтПокупателя.Основание.Номер,
		ВозвратОтПокупателя.Основание.Дата,
		ВозвратОтПокупателя.Основание.Проведен,
		ВозвратОтПокупателя.Основание.Контрагент,
		ВозвратОтПокупателя.Основание.МестоХранения,
		ВозвратОтПокупателя.Основание.Организация,
		-ЕСТЬNULL(ВозвратОтПокупателя.Сумма, 0),
		ВозвратОтПокупателя.Основание.ХозяйственнаяОперация,
		0,
		0
	ИЗ
		Документ.ВозвратОтПокупателя КАК ВозвратОтПокупателя
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки КАК ВзаиморасчётыСПокупателямиОстатки
			ПО (ВзаиморасчётыСПокупателямиОстатки.ОбъектРасчётов = ВозвратОтПокупателя.Основание.Ссылка)
	ГДЕ
		ВозвратОтПокупателя.Основание.Контрагент = &amp;Контрагент
		И ВозвратОтПокупателя.Основание.МестоХранения = &amp;МестоХранения
		И (ВозвратОтПокупателя.Основание.ХозяйственнаяОперация = &amp;Операция
				ИЛИ &amp;Операция = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПустаяСсылка))
		И ВЫБОР
				КОГДА &amp;ТолькоНеоплаченные
					ТОГДА ЕСТЬNULL(ВзаиморасчётыСПокупателямиОстатки.СуммаОстаток, 0) &lt;> 0
				ИНАЧЕ ИСТИНА
			КОНЕЦ
		И ВозвратОтПокупателя.Проведен
		И ВЫБОР
				КОГДА &amp;ЕстьТовары
					ТОГДА ВозвратОтПокупателя.Ссылка В
							(ВЫБРАТЬ
								Док.Ссылка
							ИЗ
								Документ.ВозвратОтПокупателя.ТЧТовары КАК Док
							ГДЕ
								Док.Номенклатура В (&amp;МасТовары))
				ИНАЧЕ ИСТИНА
			КОНЕЦ) КАК ВТ

СГРУППИРОВАТЬ ПО
	ВТ.ПометкаУдаления,
	ВТ.Организация,
	ВТ.МестоХранения,
	ВТ.ХозяйственнаяОперация,
	ВТ.Проведен,
	ВТ.Контрагент,
	ВТ.Дата,
	ВТ.Номер,
	ВТ.Ссылка</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
