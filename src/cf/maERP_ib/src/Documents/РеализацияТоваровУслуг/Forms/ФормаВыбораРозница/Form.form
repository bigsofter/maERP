        <field>МестоХранения</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Сумма</dataPath>
        <field>Сумма</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ХозяйственнаяОперация</dataPath>
        <field>ХозяйственнаяОперация</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>СуммаНДС</dataPath>
        <field>СуммаНДС</field>
