		<appearance>
			<dcscor:item xsi:type="SettingsParameterValue">
				<dcscor:parameter>BackColor</dcscor:parameter>
				<dcscor:value xsi:type="v8ui:Color">#FFCC99</dcscor:value>
			</dcscor:item>
		</appearance>
	</item>
