&НаКлиенте
//Обработка изменения режима напоминания
Процедура РежимНапоминанияПриИзменении(Элемент)
	
	Объект.НапоминаниеРежим = РежимНапоминания.Режим;
	
	Если Объект.НапоминаниеРежим = ПредопределенноеЗначение("Перечисление.ВариантыНапоминаний.ЗаВремяОтносительноСобытия") И НЕ ЗначениеЗаполнено(Объект.НапоминаниеДатаНачала) Тогда
		Объект.НапоминаниеДатаНачала = Объект.ДатаНапоминания;
		
	ИначеЕсли Объект.НапоминаниеРежим = ПредопределенноеЗначение("Перечисление.ВариантыНапоминаний.ВУказанноеВремя") И НЕ ЗначениеЗаполнено(Объект.НапоминаниеДатаНачала) Тогда 	
		Объект.НапоминаниеДатаНачала = Объект.ДатаНапоминания;
		
	ИначеЕсли Объект.НапоминаниеРежим = ПредопределенноеЗначение("Перечисление.ВариантыНапоминаний.ПоСобытию") И НЕ ЗначениеЗаполнено(Объект.НапоминаниеДатаНачала) Тогда 
	    Объект.НапоминаниеДатаНачала = Дата(01,01,01,0,0,0);
		
    ИначеЕсли Объект.НапоминаниеРежим = ПредопределенноеЗначение("Перечисление.ВариантыНапоминаний.ЧерезУказанноеВремя") Тогда 
		Объект.НапоминаниеДатаНачала = Объект.Дата + РежимНапоминания.Интервал; 
			
	КонецЕсли;
	
	УстановитьВидимость();

КонецПроцедуры

&НаКлиенте
//При изменении даты напоминания
Процедура ПроинициализироватьЭлементыВыбораВремени()
	
	//Перезаполнить список выбора времени напоминания 
	МассивПериодов                 = Новый Массив;
	СтруктураВремени               = ОбщегоНазначенияСПАВызовСервера.ПолучитьВремяРаботыСтруктурнойЕдиницы(Объект.НапоминаниеДатаНачала, Объект.ЦентрКрасоты);
	СтруктураВремени.ДатаНачала    = ?(ЗначениеЗаполнено(СтруктураВремени.ДатаНачала),СтруктураВремени.ДатаНачала,Дата("00010101080000"));
	СтруктураВремени.ДатаОкончания = ?(ЗначениеЗаполнено(СтруктураВремени.ДатаОкончания),СтруктураВремени.ДатаОкончания,Дата("00010101220000"));
	
	МассивПериодов.Добавить(СтруктураВремени);	
	СписокВеремени = РаботаСДиалогами.ВернутьСписокВремени(МассивПериодов, Истина);	
	
	Элементы.ВремяНапоминанияЗадачи.СписокВыбора.Очистить();
	Для Каждого Элемент ИЗ СписокВеремени Цикл	
	     Элементы.ВремяНапоминанияЗадачи.СписокВыбора.Добавить(Элемент.Значение,Элемент.Представление);
	КонецЦикла;
	 
	Элементы.ВремяНапоминания.СписокВыбора.Очистить();
	Для Каждого Элемент ИЗ СписокВеремени Цикл	
	     Элементы.ВремяНапоминания.СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;

КонецПроцедуры


&НаКлиенте
Процедура ВремяНапоминанияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Объект.ДатаНапоминания = НачалоДня(Объект.ДатаНапоминания) + (ВыбранноеЗначение - НачалоДня(ВыбранноеЗначение));
	
КонецПроцедуры


