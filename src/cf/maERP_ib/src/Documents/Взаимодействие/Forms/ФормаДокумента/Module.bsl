// Обновить клиентские метки, вернуть текстовое сообщение о метках
//
Функция ОбновитьКлиентскиеМетки(ВывестиСообщение)
	
	Временная        = Объект.Контрагент;
	ВывестиСообщение = ?(ОбновитьКлиентскиеМеткиСервер()<>"",ВывестиСообщение,Ложь);
	
	Если ВывестиСообщение Тогда
		ОткрытьФормуМодально("РегистрСведений.МеткиКлиентов.Форма.ФормаОповещенияОМетках",Новый Структура("Клиент, Период",Временная,Объект.Дата));
	КонецЕсли;
	
КонецФункции

&НаСервере
// Обновить клиентские метки, вернуть текстовое сообщение о метках
//
Функция ОбновитьКлиентскиеМеткиСервер()
	
	Возврат РегистрыСведений.МеткиКлиентов.ОбновитьМеткиНаФормеДокументаВернутьОповещение(ЭтаФорма);
	
КонецФункции


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	//Обновление меток клиента
	Если ИмяСобытия = "ОБНОВЛЕНЫ_МЕТКИ_КЛИЕНТА" Тогда
