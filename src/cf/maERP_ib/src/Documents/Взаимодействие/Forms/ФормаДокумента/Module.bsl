	Закрыть();
	
КонецПроцедуры


&НаКлиенте
Процедура ЦентрКрасотыНадписьНажатие(Элемент)
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЭтоПользователь", Истина);
    СтруктураПараметров.Вставить("Ссылка", ОбщегоНазначенияСПАВызовСервера.ДоступныеСтруктурныеЕдиницы()); 
	СтруктураПараметров.Вставить("ВидСравненияКомпоновкиДанных", ВидСравненияКомпоновкиДанных.ВСписке);
	Структура = ОткрытьФормуМодально("Справочник.ЦентрыКрасоты.ФормаВыбора", СтруктураПараметров);	
	Если Структура <> Неопределено Тогда
	   Если Объект.ЦентрКрасоты <> Структура Тогда
	     Объект.ЦентрКрасоты = Структура;
	     Элементы.ЦентрКрасотыНадпись.Заголовок = Объект.ЦентрКрасоты;
	   КонецЕсли;
   КонецЕсли;
КонецПроцедуры

