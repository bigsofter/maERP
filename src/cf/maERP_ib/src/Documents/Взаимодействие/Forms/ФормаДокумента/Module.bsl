
&НаКлиенте
//Процедура, обработчик события "ПриИзменении"
//
Процедура ВидОперацииПриИзменении(Элемент)
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
//Процедура, обработчик события "ПриСозданииНаСервере"
//
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Обработчик подсистемы "Дополнительные отчеты и обработки"
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтаФорма);
	
	Если Объект.Ссылка.Пустая() Тогда		
		Объект.ДатаНапоминания = ТекущаяДата();
	КонецЕсли;
	
	Элементы.РежимНапоминания.СписокВыбора.Очистить();
	Для Каждого ЭлементСписка Из Задачи.ЗадачаИсполнителя.ВернутьСписокРежимовНапоминания() Цикл
		Элементы.РежимНапоминания.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
		
	УстановитьВидимость();
	Элементы.ЦентрКрасотыНадпись.Заголовок = Объект.ЦентрКрасоты;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//Установить текущий выбранный режим напоминания
	РежимНапоминания = Новый Структура("Режим, Интервал");
	Для Каждого Элемент ИЗ Элементы.РежимНапоминания.СписокВыбора Цикл
		Если Элемент.Значение.Режим = Объект.НапоминаниеРежим Тогда
			Если Объект.НапоминаниеРежим = ПредопределенноеЗначение("Перечисление.ВариантыНапоминаний.ЧерезУказанноеВремя") Тогда
				Если Элемент.Значение.Интервал <> Объект.НапоминаниеДатаНачала - Объект.Дата Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли Объект.НапоминаниеРежим = ПредопределенноеЗначение("Перечисление.ВариантыНапоминаний.ЗаВремяОтносительноСобытия") Тогда
				НапоминаниеИнтервалДоНачала = Объект.ДатаНапоминания - Объект.НапоминаниеДатаНачала;					 				
			КонецЕсли;
			РежимНапоминания = Элемент.Значение;
			Прервать;			 
		КонецЕсли;
	КонецЦикла;
	
	ПроинициализироватьЭлементыВыбораВремени();
	ОбновитьКлиентскиеМетки(Истина);

КонецПроцедуры

&НаСервере
//Процедура выполняет установку видимости элементов
//
Процедура УстановитьВидимость()
	
	Элементы.Отработано.Пометка = Объект.ЗадачаОтработана;
	
	Элементы.ВидГодовщины.Видимость = ?(Объект.ВидОперации = Перечисления.ВидыОперацийВзаимодействия.Годовщина, Истина, Ложь);		
	Элементы.Тема.Видимость = Не Элементы.ВидГодовщины.Видимость;
	Элементы.ВремяНапоминания.Видимость = Не Элементы.ВидГодовщины.Видимость;
	Элементы.ГруппаПараметрыНапоминания.Доступность = Объект.НапоминаниеИспользовать;
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийВзаимодействия.Встреча Тогда		
		Элементы.ФормаКнопкаЗаписатьИЗакрыть.Картинка = БиблиотекаКартинок.Встреча;
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийВзаимодействия.Дело Тогда
		Элементы.ФормаКнопкаЗаписатьИЗакрыть.Картинка = БиблиотекаКартинок.Дело;
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийВзаимодействия.Годовщина Тогда
		Элементы.ФормаКнопкаЗаписатьИЗакрыть.Картинка = БиблиотекаКартинок.Годовщина;
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийВзаимодействия.ТелефонныйЗвонокВходящий Тогда
		Элементы.ФормаКнопкаЗаписатьИЗакрыть.Картинка = БиблиотекаКартинок.ТелефонныйЗвонокВходящий;
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийВзаимодействия.ТелефонныйЗвонокИсходящий Тогда
		Элементы.ФормаКнопкаЗаписатьИЗакрыть.Картинка = БиблиотекаКартинок.ТелефонныйЗвонокИсходящий;
	КонецЕсли;
	
	Если Объект.НапоминаниеРежим = Перечисления.ВариантыНапоминаний.ЗаВремяОтносительноСобытия Тогда
		Элементы.ИнтервалДоНапоминания.Видимость = Истина;
		Элементы.ДатаНапоминанияЗадачи.Видимость = Ложь;
		Элементы.ВремяНапоминанияЗадачи.Видимость= Ложь;
	ИначеЕсли Объект.НапоминаниеРежим = Перечисления.ВариантыНапоминаний.ВУказанноеВремя Тогда 	
	    Элементы.ИнтервалДоНапоминания.Видимость = Ложь;
		Элементы.ДатаНапоминанияЗадачи.Видимость = Истина;
		Элементы.ВремяНапоминанияЗадачи.Видимость= Истина;
	ИначеЕсли Объект.НапоминаниеРежим = Перечисления.ВариантыНапоминаний.ПоСобытию Тогда 
		Элементы.ИнтервалДоНапоминания.Видимость = Ложь;
		Элементы.ВремяНапоминанияЗадачи.Видимость= Ложь;
		Элементы.ДатаНапоминанияЗадачи.Видимость = Ложь;
    ИначеЕсли Объект.НапоминаниеРежим = Перечисления.ВариантыНапоминаний.ЧерезУказанноеВремя Тогда 
		Элементы.ИнтервалДоНапоминания.Видимость = Ложь;
		Элементы.ВремяНапоминанияЗадачи.Видимость= Ложь;
		Элементы.ДатаНапоминанияЗадачи.Видимость = Ложь;
    КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
//Процедура, обработчик события "ПередЗаписью"
//
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НачалоДня(Объект.ДатаНапоминания) = Дата(01, 01, 01) Тогда
		Сообщить("Не заполнена дата напоминания");
		Отказ = Истина;
	КонецЕсли;
	
	Если Элементы.ВремяНапоминания.Видимость = Истина И (Объект.ДатаНапоминания - НачалоДня(Объект.ДатаНапоминания)) = 0 Тогда
		Сообщить("Не заполнено время напоминания");
		Отказ = Истина;
	КонецЕсли;
	
	Если Объект.НапоминаниеРежим = ПредопределенноеЗначение("Перечисление.ВариантыНапоминаний.ЗаВремяОтносительноСобытия") Тогда
		Объект.НапоминаниеДатаНачала = Объект.ДатаНапоминания - НапоминаниеИнтервалДоНачала;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
//Процедура, обработчик события "НачалоВыбора"
//
Процедура КонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = Новый Структура("ТекущаяСтрока", Объект.Контрагент);
	Значение = ОткрытьФормуМодально("Справочник.Контрагенты.Форма.ФормаВыбораКлиенты", ПараметрыОткрытия);
	
	Если Значение <> Неопределено Тогда
		Объект.Контрагент = Значение;
		ОбновитьКлиентскиеМетки(Истина);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
//Процедура, обработчик события "ОбработкаВыбора"
//
Процедура КонтрагентОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = "СоздатьНовогоКлиента" Тогда
		ДобавитьИВыбратьКонтрагента();
		ВыбранноеЗначение = Объект.Контрагент;
	Иначе 
		Объект.Контрагент = ВыбранноеЗначение;
	КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
//Процедура, обработчик команды ДобавитьИВыбратьКонтрагента
//
Процедура ДобавитьИВыбратьКонтрагента()
	
	ФормаКонтрагента = ПолучитьФорму("Справочник.Контрагенты.Форма.ФормаЭлементаКлиенты", Неопределено);
	ГруппаКлиентов = ВернутьГруппуКлиентов();
	ФормаКонтрагента.Объект.Родитель = ГруппаКлиентов;
	ФормаКонтрагента.ОткрытьМодально();
	
	Если Не ФормаКонтрагента.Объект.Ссылка.Пустая() Тогда
		Объект.Контрагент = ФормаКонтрагента.Объект.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
//Функция возвращает группу клиентов
//
Функция ВернутьГруппуКлиентов()
	
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	НастройкиПользователей.Значение
	                      |ИЗ
	                      |	РегистрСведений.НастройкиПользователей КАК НастройкиПользователей
	                      |ГДЕ
	                      |	НастройкиПользователей.Пользователь = &Пользователь
	                      |	И НастройкиПользователей.ЦентрКрасоты = &ЦентрКрасоты
	                      |	И НастройкиПользователей.Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиПользователей.ОсновнаяГруппаКонтрагентов)");
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("ЦентрКрасоты", ПараметрыСеанса.ТекущийЦентрКрасоты);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	Иначе 
		Возврат Справочники.Контрагенты.НайтиПоРеквизиту("Клиенты", Истина);
	КонецЕсли;
	
КонецФункции

