Функция СоздатьТаблицуШтрафов()
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТЗ.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТЗ.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыСКонтрагентами"));
	ТЗ.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	Возврат ТЗ;
КонецФункции

Функция СоздатьТаблицуПоказателей()
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТЗ.Колонки.Добавить("Показатель", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ПоказателиРасчётаПремий"));
	ТЗ.Колонки.Добавить("SMART", Новый ОписаниеТипов("Булево"));
	ТЗ.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.Сумма.Тип);
	ТЗ.Колонки.Добавить("Пояснение", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));
	Возврат ТЗ;
КонецФункции
			
Процедура ДобавитьРасшифровкуПоказателя(ТЗРасшифровкаПоказателей, Сотрудник, Показатель, Сумма, Пояснение, Комментарий)
	НС = ТЗРасшифровкаПоказателей.Добавить();
	НС.Сотрудник = Сотрудник;
	НС.Показатель = Показатель;
	НС.SMART = Показатель.SMART;
	НС.Сумма = Сумма;
	НС.Пояснение = Пояснение;
	НС.Комментарий = Комментарий;
КонецПроцедуры

Процедура ДобавитьРасшифровкуШтрафа(ТЗРасшифровкаШтрафов, Сотрудник, Договор, Сумма)
	НС = ТЗРасшифровкаШтрафов.Добавить();
	НС.Сотрудник = Сотрудник;
	Если Договор <> Неопределено Тогда
		НС.Контрагент = Договор.Владелец;
		НС.Договор = Договор;
	КонецЕсли;
	НС.Сумма = Сумма;	
КонецПроцедуры
			
