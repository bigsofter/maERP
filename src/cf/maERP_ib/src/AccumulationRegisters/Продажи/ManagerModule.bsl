
#Область Формирование_движений

Процедура СформироватьДвижения(ДокОбъект) Экспорт
	Движения = ДокОбъект.Движения;
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		Ответственный = ДокОбъект.Ответственный;
		Рез = СформироватьДанные(ДокОбъект, ДокОбъект.ТЧТовары.Выгрузить(), ДокОбъект.Менеджер, ДокОбъект.Контрагент, ДокОбъект.Ссылка, ДокОбъект.ХозяйственнаяОперация, Ответственный, ДокОбъект.МестоХранения); 
		Движения.Продажи.Загрузить(Рез[4].Выгрузить());
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ВозвратОтПокупателя") И ЗначениеЗаполнено(ДокОбъект.Основание) Тогда	
		ТЗПартии = Движения.ТоварыВНаличии.Выгрузить();
		ТЗПартии.Свернуть("Номенклатура, Характеристика, Партия", "Количество");
		УменьшитьПрибыльПоВозврату(ДокОбъект, ТЗПартии);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаДолга") Тогда 
		Если Не ОбщегоНазначенияВызовСервераПовтИсп.ЭтоРасчётыСПокупателями(ДокОбъект.ХозяйственнаяОперация) Тогда Возврат КонецЕсли;
		Мас = ДокОбъект.ДополнительныеСвойства.ТЗКредиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПокупателем", Истина));
		Для Каждого Стр Из Мас Цикл
			ОбъектРасчётов = Стр.ОбъектРасчётов;
			Если Не ТипЗнч(Стр.ОбъектРасчётов) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда Продолжить; КонецЕсли;
			УменьшитьПрибыльПоКорректировке(ДокОбъект, ОбъектРасчётов, Стр.Сумма); 
		КонецЦикла;
		Мас = ДокОбъект.ДополнительныеСвойства.ТЗДебиторскаяЗадолженность.НайтиСтроки(Новый Структура("СПокупателем", Истина));
		Для Каждого Стр Из Мас Цикл
			ОбъектРасчётов = Стр.ОбъектРасчётов;
			Если Не ТипЗнч(Стр.ОбъектРасчётов) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда Продолжить; КонецЕсли;
			УменьшитьПрибыльПоКорректировке(ДокОбъект, ОбъектРасчётов, Стр.Сумма); 
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

Процедура УменьшитьПрибыльПоВозврату(ДокОбъект, ТЗВозврат)
	Движения = ДокОбъект.Движения;
	НЗ = РегистрыНакопления.Продажи.СоздатьНаборЗаписей();
	НЗ.Отбор.Регистратор.Установить(ДокОбъект.Основание);
	НЗ.Прочитать();
	ТЗПрибыль = НЗ.Выгрузить();
	Для Каждого Стр Из ТЗВозврат Цикл
		Мас = ТЗПрибыль.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Партия", Стр.Номенклатура, Стр.Характеристика, Стр.Партия));
		Для Каждого МасСтр Из Мас Цикл
			НС = Движения.Продажи.Добавить();
			ЗаполнитьЗначенияСвойств(НС, МасСтр);
			НС.Период = ДокОбъект.Дата;
			НС.ХозяйственнаяОперация = ДокОбъект.ХозяйственнаяОперация;
			НС.Количество = -Стр.Количество;
			НС.Себестоимость = -?(Стр.Количество = МасСтр.Количество, МасСтр.Себестоимость, МасСтр.Себестоимость / МасСтр.Количество * Стр.Количество);
			НС.ДополнительныеРасходы = -?(Стр.Количество = МасСтр.Количество, МасСтр.ДополнительныеРасходы, МасСтр.ДополнительныеРасходы / МасСтр.Количество * Стр.Количество);
			НС.Выручка = -?(Стр.Количество = МасСтр.Количество, МасСтр.Выручка, МасСтр.Выручка / МасСтр.Количество * Стр.Количество);
			НС.НДС = -?(Стр.Количество = МасСтр.Количество, МасСтр.НДС, МасСтр.НДС / МасСтр.Количество * Стр.Количество);
			НС.ВаловаяПрибыль = -?(Стр.Количество = МасСтр.Количество, МасСтр.ВаловаяПрибыль, МасСтр.ВаловаяПрибыль / МасСтр.Количество * Стр.Количество);
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры

Процедура УменьшитьПрибыльПоКорректировке(ДокОбъект, ОбъектРасчётов, Сумма)
	Движения = ДокОбъект.Движения;
	НЗ = РегистрыНакопления.Продажи.СоздатьНаборЗаписей();
	НЗ.Отбор.Регистратор.Установить(ОбъектРасчётов);
	НЗ.Прочитать();
	ТЗПрибыль = НЗ.Выгрузить();
	ВыручкаИтого = ТЗПрибыль.Итог("Выручка");
	СуммаОстаток = Сумма;
	КоличествоСтрок = ТЗПрибыль.Количество();
	НомерСтроки = 0;
	Для Каждого Стр Из ТЗПрибыль Цикл
		НомерСтроки = НомерСтроки + 1;
		НС = Движения.Продажи.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Стр,,"Количество,Себестоимость,ДополнительныеРасходы");
		НС.Период = ДокОбъект.Дата;
		НС.ХозяйственнаяОперация = ДокОбъект.ХозяйственнаяОперация;
		НС.Выручка = -?(НомерСтроки = КоличествоСтрок, СуммаОстаток, Стр.Выручка / ВыручкаИтого * Сумма);
		НС.НДС = - Стр.НДС / ВыручкаИтого * Сумма;
		НС.ВаловаяПрибыль = Стр.ВаловаяПрибыль / ВыручкаИтого * Сумма;
		СуммаОстаток = СуммаОстаток + НС.Выручка;
	КонецЦикла;	
КонецПроцедуры

Функция СформироватьДанные(ДокОбъект, ТЗТовары, Сотрудник, Контрагент, ДокументПродажи, ХозяйственнаяОперация, Ответственный = Неопределено, МестоХранения)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(ТЗТовары.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(ТЗТовары.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	                      |	ВЫРАЗИТЬ(ТЗТовары.Количество КАК ЧИСЛО) КАК Количество,
	                      |	ВЫРАЗИТЬ(ТЗТовары.СуммаСНДС КАК ЧИСЛО) КАК Выручка,
	                      |	ВЫРАЗИТЬ(ТЗТовары.СуммаНДС КАК ЧИСЛО) КАК НДС
	                      |ПОМЕСТИТЬ ВТТовары
	                      |ИЗ
	                      |	&ТЗТовары КАК ТЗТовары
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТЗПартии.ВидДвижения КАК ВидДвижения,
	                      |	ВЫРАЗИТЬ(ТЗПартии.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(ТЗПартии.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	                      |	ТЗПартии.Партия КАК Партия,
	                      |	ВЫРАЗИТЬ(ТЗПартии.Сумма КАК ЧИСЛО) КАК Себестоимость,
	                      |	ВЫРАЗИТЬ(ТЗПартии.Количество КАК ЧИСЛО) КАК Количество
	                      |ПОМЕСТИТЬ ВТПартии
	                      |ИЗ
	                      |	&ТЗПартии КАК ТЗПартии
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТЗДополнительныеРасходы.ВидДвижения КАК ВидДвижения,
	                      |	ВЫРАЗИТЬ(ТЗДополнительныеРасходы.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(ТЗДополнительныеРасходы.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
	                      |	ТЗДополнительныеРасходы.Партия КАК Партия,
	                      |	ВЫРАЗИТЬ(ТЗДополнительныеРасходы.Сумма КАК ЧИСЛО) КАК Сумма
	                      |ПОМЕСТИТЬ ВЗДополнительныеРасходы
	                      |ИЗ
	                      |	&ТЗДополнительныеРасходы КАК ТЗДополнительныеРасходы
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЗ.Партия КАК Партия,
	                      |	СУММА(ВЗ.Количество) КАК Количество,
	                      |	СУММА(ВЗ.Себестоимость) КАК Себестоимость,
	                      |	СУММА(ВЗ.ДополнительныеРасходы) КАК ДополнительныеРасходы
	                      |ПОМЕСТИТЬ ВТПартииРасходы
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВТПартии.Номенклатура КАК Номенклатура,
	                      |		ВТПартии.Характеристика КАК Характеристика,
	                      |		ВТПартии.Партия КАК Партия,
	                      |		ВТПартии.Количество КАК Количество,
	                      |		ВТПартии.Себестоимость КАК Себестоимость,
	                      |		0 КАК ДополнительныеРасходы
	                      |	ИЗ
	                      |		ВТПартии КАК ВТПартии
	                      |	ГДЕ
	                      |		ВТПартии.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		ВЗДополнительныеРасходы.Номенклатура,
	                      |		ВЗДополнительныеРасходы.Характеристика,
	                      |		ВЗДополнительныеРасходы.Партия,
	                      |		0,
	                      |		0,
	                      |		ВЗДополнительныеРасходы.Сумма
	                      |	ИЗ
	                      |		ВЗДополнительныеРасходы КАК ВЗДополнительныеРасходы
	                      |	ГДЕ
	                      |		ВЗДополнительныеРасходы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)) КАК ВЗ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВЗ.Номенклатура,
	                      |	ВЗ.Характеристика,
	                      |	ВЗ.Партия
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	&Период КАК Период,
	                      |	&Организация КАК Организация,
	                      |	&Сотрудник КАК Сотрудник,
	                      |	&Контрагент КАК Контрагент,
	                      |	&ДокументПродажи КАК ДокументПродажи,
	                      |	&Ответственный КАК Ответственный,
	                      |	&ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	                      |	&МестоХранения КАК МестоХранения,
	                      |	ВЗ.Номенклатура КАК Номенклатура,
	                      |	ВЗ.Характеристика КАК Характеристика,
	                      |	ВЗ.Партия КАК Партия,
	                      |	ВЗ.Количество КАК Количество,
	                      |	ВЗ.Себестоимость КАК Себестоимость,
	                      |	ВЗ.ДополнительныеРасходы КАК ДополнительныеРасходы,
	                      |	ВЗ.Выручка КАК Выручка,
	                      |	ВЗ.НДС КАК НДС,
	                      |	ВЗ.Выручка - ВЗ.Себестоимость - ВЗ.ДополнительныеРасходы КАК ВаловаяПрибыль
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ВЗ.Номенклатура КАК Номенклатура,
	                      |		ВЗ.Характеристика КАК Характеристика,
	                      |		ЕСТЬNULL(ВТПартииРасходы.Партия, НЕОПРЕДЕЛЕНО) КАК Партия,
	                      |		ЕСТЬNULL(ВТПартииРасходы.Количество, ВЗ.Количество) КАК Количество,
	                      |		ВЗ.Выручка / ВЗ.Количество * ЕСТЬNULL(ВТПартииРасходы.Количество, ВЗ.Количество) КАК Выручка,
	                      |		ВЗ.НДС / ВЗ.Количество * ЕСТЬNULL(ВТПартииРасходы.Количество, ВЗ.Количество) КАК НДС,
	                      |		ВЫБОР
	                      |			КОГДА ВЗ.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	                      |				ТОГДА ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0)
	                      |			ИНАЧЕ ЕСТЬNULL(ВТПартииРасходы.Себестоимость, 0)
	                      |		КОНЕЦ КАК Себестоимость,
	                      |		ЕСТЬNULL(ВТПартииРасходы.ДополнительныеРасходы, 0) КАК ДополнительныеРасходы
	                      |	ИЗ
	                      |		(ВЫБРАТЬ
	                      |			ВТТовары.Номенклатура КАК Номенклатура,
	                      |			ВТТовары.Характеристика КАК Характеристика,
	                      |			СУММА(ВТТовары.Количество) КАК Количество,
	                      |			СУММА(ВТТовары.Выручка) КАК Выручка,
	                      |			СУММА(ВТТовары.НДС) КАК НДС
	                      |		ИЗ
	                      |			ВТТовары КАК ВТТовары
	                      |		
	                      |		СГРУППИРОВАТЬ ПО
	                      |			ВТТовары.Номенклатура,
	                      |			ВТТовары.Характеристика) КАК ВЗ
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ ВТПартииРасходы КАК ВТПартииРасходы
	                      |			ПО ВЗ.Номенклатура = ВТПартииРасходы.Номенклатура
	                      |				И ВЗ.Характеристика = ВТПартииРасходы.Характеристика
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, ) КАК ЦеныНоменклатуры
	                      |			ПО ВЗ.Номенклатура = ЦеныНоменклатуры.Номенклатура
	                      |				И ВЗ.Характеристика = ЦеныНоменклатуры.Характеристика
	                      |				И (ЦеныНоменклатуры.ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Закупочная))) КАК ВЗ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТПартии.Номенклатура КАК Номенклатура,
	                      |	ВТПартии.Характеристика КАК Характеристика,
	                      |	ВТПартии.Партия КАК Партия,
	                      |	ВТПартии.Количество КАК Количество
	                      |ИЗ
	                      |	ВТПартии КАК ВТПартии
	                      |ГДЕ
	                      |	ВТПартии.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
	Запрос.УстановитьПараметр("ТЗТовары", ТЗТовары);
	Запрос.УстановитьПараметр("ТЗПартии", ПолучитьТЗПартииПоРеализации(ДокОбъект));
	Запрос.УстановитьПараметр("ТЗДополнительныеРасходы", ПолучитьДополнительныеРасходыПоРеализации(ДокОбъект));
	Запрос.УстановитьПараметр("Период", ДокОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ДокОбъект.Организация);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ДокументПродажи", ДокументПродажи);
	Запрос.УстановитьПараметр("МестоХранения", ДокументПродажи.МестоХранения);
	Запрос.УстановитьПараметр("Ответственный", Ответственный);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация", ХозяйственнаяОперация);
	Возврат Запрос.ВыполнитьПакет();
КонецФункции	

#КонецОбласти

#Область Остатки

Функция ПолучитьВыручкуПоТоварнойГруппе(НачалоПериода, КонецПериода, МасСотрудники, ТоварнаяГруппа) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Сумма
	                      |ИЗ
	                      |	РегистрНакопления.Продажи.Обороты(
	                      |			&НачалоПериода,
	                      |			&КонецПериода,
	                      |			,
	                      |			ВЫБОР
	                      |					КОГДА &СотрудникиУказаны
	                      |						ТОГДА Сотрудник В (&Сотрудники)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И Номенклатура.ТоварнаяГруппа = &ТоварнаяГруппа) КАК ПродажиОбороты");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Сотрудники", МасСотрудники);
	Запрос.УстановитьПараметр("СотрудникиУказаны", МасСотрудники.Количество() > 0);
	Запрос.УстановитьПараметр("ТоварнаяГруппа", ТоварнаяГруппа);
	Возврат Запрос.Выполнить().Выгрузить().Итог("Сумма");
КонецФункции

#КонецОбласти

#Область Остатки_и_аналитика

Функция ПолучитьПроцентПланаПродажПоМенеджеру(Период, Менеджер, Показатель) Экспорт
	Структура = Новый Структура("План, Факт, Процент", 0, 0, 0);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПродажиОбороты.Сотрудник как Менеджер,
	                      |	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Факт,
	                      |	СУММА(0) КАК План
	                      |ИЗ
	                      |	РегистрНакопления.Продажи.Обороты(&ДатаНач, &ДатаКон, Месяц, Сотрудник = &Менеджер) КАК ПродажиОбороты
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ПродажиОбороты.Сотрудник
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ПлановыеПоказателиСрезПоследних.Сотрудник,
	                      |	0,
	                      |	ПлановыеПоказателиСрезПоследних.План
	                      |ИЗ
	                      |	РегистрСведений.ПлановыеПоказатели.СрезПоследних(
	                      |			&ДатаНач,
	                      |			Сотрудник = &Менеджер
	                      |				И Показатель = &Показатель) КАК ПлановыеПоказателиСрезПоследних");
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(КонецМесяца(Период)));
	Запрос.УстановитьПараметр("Менеджер", Менеджер);
	Запрос.УстановитьПараметр("Показатель", Показатель);
	ТЗ = Запрос.Выполнить().Выгрузить();
	ТЗ.Свернуть("Менеджер", "Факт, План");
	Если ТЗ.Количество() > 0 Тогда
		Стр = ТЗ[0];
		Структура.План = Стр.План;
		Структура.Факт = Стр.Факт;
		Структура.Процент = ?(Стр.План = 0, 100, Окр(Стр.Факт / (Стр.План / 100)));
	КонецЕсли;	
	Возврат Структура;	
КонецФункции

Функция ПолучитьСуммуПоказателяПродажПоПараметру(НачалоПериода, КонецПериода, Отбор) Экспорт 
	МасКонтрагенты = Новый Массив;
	МасТоварныеГруппы = Новый Массив;
	Для Каждого Параметр Из Отбор.Параметры Цикл
		Если ТипЗнч(Параметр) = Тип("СправочникСсылка.Контрагенты") Тогда
			МасКонтрагенты.Добавить(Параметр);
		ИначеЕсли ТипЗнч(Параметр) = Тип("СправочникСсылка.ТоварныеГруппы") Тогда
			МасТоварныеГруппы.Добавить(Параметр);
		КонецЕсли;	
	КонецЦикла;	
	//	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СУММА(ПродажиОбороты.КоличествоОборот) КАК Количество,
	                      |	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка,
	                      |	СУММА(ПродажиОбороты.ВаловаяПрибыльОборот) КАК Прибыль
	                      |ИЗ
	                      |	РегистрНакопления.Продажи.Обороты(
	                      |			&НачалоПериода,
	                      |			&КонецПериода,
	                      |			,
	                      |			ВЫБОР
	                      |					КОГДА &СотрудникиУказаны
	                      |						ТОГДА Сотрудник В (&Сотрудники)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &КонтрагентыУказаны
	                      |						ТОГДА Контрагент В (&Контрагенты)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ
	                      |				И ВЫБОР
	                      |					КОГДА &ТоварныеГруппыУказаны
	                      |						ТОГДА Номенклатура.ТоварнаяГруппа В (&ТоварныеГруппы)
	                      |					ИНАЧЕ ИСТИНА
	                      |				КОНЕЦ) КАК ПродажиОбороты");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Сотрудники", Отбор.Сотрудник);
	Запрос.УстановитьПараметр("СотрудникиУказаны", Отбор.Сотрудник.Количество() > 0);
	Запрос.УстановитьПараметр("КонтрагентыУказаны", МасКонтрагенты.Количество() > 0);
	Запрос.УстановитьПараметр("Контрагенты", МасКонтрагенты);
	Запрос.УстановитьПараметр("ТоварныеГруппыУказаны", МасТоварныеГруппы.Количество() > 0);
	Запрос.УстановитьПараметр("ТоварныеГруппы", МасТоварныеГруппы);
	Если ЗначениеЗаполнено(Отбор.Показатель) Тогда
		ТЗ = Запрос.Выполнить().Выгрузить();
		Возврат ТЗ.Итог(Строка(Отбор.Показатель));
	Иначе
		Возврат 0;	
	КонецЕсли;
КонецФункции

Функция ПолучитьТаблицуПроцентыПланаРентабельностиПоМенеджеру(Период, Менеджер, Показатель) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПродажиОбороты.Сотрудник КАК Сотрудник,
	                      |	ПродажиОбороты.ДокументПродажи КАК ДокументПродажи,
	                      |	СУММА(ПродажиОбороты.ВаловаяПрибыльОборот) КАК Прибыль,
	                      |	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка,
	                      |	ВЫРАЗИТЬ(ЕСТЬNULL(ПлановыеПоказателиСрезПоследних.План, 0) КАК ЧИСЛО) КАК План
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	РегистрНакопления.Продажи.Обороты(&ДатаНач, &ДатаКон, Месяц, Сотрудник = &Менеджер) КАК ПродажиОбороты
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеПоказатели.СрезПоследних(
	                      |				&ДатаНач,
	                      |				Сотрудник = &Менеджер
	                      |					И Показатель = &Показатель) КАК ПлановыеПоказателиСрезПоследних
	                      |		ПО ПродажиОбороты.Сотрудник = ПлановыеПоказателиСрезПоследних.Сотрудник
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ПродажиОбороты.Сотрудник,
	                      |	ПродажиОбороты.ДокументПродажи,
	                      |	ВЫРАЗИТЬ(ЕСТЬNULL(ПлановыеПоказателиСрезПоследних.План, 0) КАК ЧИСЛО)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.Сотрудник КАК Сотрудник,
	                      |	ВТ.ДокументПродажи КАК ДокументПродажи,
	                      |	ВТ.Прибыль КАК Прибыль,
	                      |	ВТ.План КАК План,
	                      |	ВЫРАЗИТЬ(ВЫБОР
	                      |			КОГДА ВТ.План = 0 или ВТ.Выручка = 0
	                      |				ТОГДА 100
	                      |			ИНАЧЕ ВТ.Прибыль / ВТ.Выручка * 100 / ВТ.План * 100
	                      |		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК Процент
	                      |ИЗ
	                      |	ВТ КАК ВТ");
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(КонецМесяца(Период)));
	Запрос.УстановитьПараметр("Менеджер", Менеджер);
	Запрос.УстановитьПараметр("Показатель", Показатель);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ТЗ;	
КонецФункции

Функция ПолучитьТЗПартииПоРеализации(ДокОбъект)
	Если ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.НакладнаяПоОтгрузкамТовара Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыВНаличии.Период КАК Период,
		|	ТоварыВНаличии.Регистратор КАК Регистратор,
		|	ТоварыВНаличии.НомерСтроки КАК НомерСтроки,
		|	ТоварыВНаличии.Активность КАК Активность,
		|	ТоварыВНаличии.ВидДвижения КАК ВидДвижения,
		|	ТоварыВНаличии.МестоХранения КАК МестоХранения,
		|	ТоварыВНаличии.Номенклатура КАК Номенклатура,
		|	ТоварыВНаличии.Характеристика КАК Характеристика,
		|	ТоварыВНаличии.Серия КАК Серия,
		|	ТоварыВНаличии.Партия КАК Партия,
		|	ТоварыВНаличии.ДатаПартии КАК ДатаПартии,
		|	ТоварыВНаличии.Количество КАК Количество,
		|	ТоварыВНаличии.Сумма КАК Сумма
		|ИЗ
		|	РегистрНакопления.ТоварыВНаличии КАК ТоварыВНаличии
		|ГДЕ
		|	ТоварыВНаличии.Регистратор В (&Регистратор)";
		Запрос.УстановитьПараметр("Регистратор", ДокОбъект.ТЧТовары.ВыгрузитьКолонку("ОтгрузкаТовара"));
		ТЗПартии = Запрос.Выполнить().Выгрузить();
	Иначе
		ТЗПартии = ДокОбъект.Движения.ТоварыВНаличии.Выгрузить();
	КонецЕсли;
	Возврат ТЗПартии;
КонецФункции

