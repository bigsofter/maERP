// Загрузка «после» в базе maERP (docs/plans/retail-client-update.md): обработчики обновления, если не выполнены при
// входе, затем обработка ЗагрузкаПереносаСтаройРедакции. Части[1] - файл выгрузки «до».

&НаСервереБезКонтекста
Процедура Главная(Части, Лог)
	Если ОбновлениеПрограммы.ТребуетсяОбновление() Тогда
		Результат = ОбновлениеПрограммы.ВыполнитьОбновление(Истина);
		Лог.ЗаписатьСтроку("ОБНОВЛЕНИЕ;" + Результат.ВерсияДо + " -> " + Результат.ВерсияПосле + ";обработчиков "
			+ Результат.ВыполненоОбработчиков);
		Если Не Результат.Выполнено Тогда
			Лог.ЗаписатьСтроку("ОСТАНОВ;обновление не выполнено: " + СтрЗаменить(Результат.ОписаниеОшибки, Символы.ПС, " | "));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Лог.ЗаписатьСтроку("ВЕРСИЯ;" + ОбновлениеПрограммы.ВерсияИнформационнойБазы());
	Для Каждого Строка Из Обработки.ЗагрузкаПереносаСтаройРедакции.Загрузить(Части[1]) Цикл
		Лог.ЗаписатьСтроку(Строка);
	КонецЦикла;
КонецПроцедуры
