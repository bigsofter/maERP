// Промежуточный шаг переноса (docs/plans/retail-client-update.md, «Тип кода справочников»): в базе с вариантом CF
// maERP, где у справочников Бренды, ВидыЦен, TypesDePayment код строковый, коды приводятся к цифрам нужной длины -
// следующая загрузка CF maERP с числовым кодом переводит их в числа. Цифровой код без дублей сохраняется.

&НаСервереБезКонтекста
Процедура Главная(Части, Лог)
	Для Каждого Описание Из СтрРазделить("Бренды:5,ВидыЦен:5,TypesDePayment:9", ",") Цикл
		Пара = СтрРазделить(Описание, ":");
		ПривестиКоды(Пара[0], Число(Пара[1]), Лог);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПривестиКоды(ИмяСправочника, Длина, Лог)
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.Код КАК Код ИЗ Справочник." + ИмяСправочника + " КАК Т УПОРЯДОЧИТЬ ПО Т.Код, Т.Ссылка");
	Таблица = Запрос.Выполнить().Выгрузить();
	Занятые = Новый Соответствие;
	Наибольший = 0;
	Для Каждого Строка Из Таблица Цикл
		Код = СокрЛП(Строка.Код);
		Если ЭтоЦифры(Код) И Занятые[Число(Код)] = Неопределено Тогда
			Занятые.Вставить(Число(Код), Истина);
			Наибольший = Макс(Наибольший, Число(Код));
			Строка.Код = "";
		Иначе
			Строка.Код = "*";
		КонецЕсли;
	КонецЦикла;
	Изменено = 0;
	Для Каждого Строка Из Таблица Цикл
		Если Строка.Код <> "*" Тогда
			Продолжить;
		КонецЕсли;
		Наибольший = Наибольший + 1;
		Объект = Строка.Ссылка.ПолучитьОбъект();
		Объект.Код = Формат(Наибольший, "ЧЦ=" + Длина + "; ЧВН=; ЧГ=0");
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
		Изменено = Изменено + 1;
	КонецЦикла;
	Лог.ЗаписатьСтроку("КОДЫ;" + ИмяСправочника + ";элементов " + Таблица.Количество() + ";изменено " + Изменено);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоЦифры(Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции
