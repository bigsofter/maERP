// Сверка итогов по организациям и налоговым регистрам (docs/plans/commerce-two-orgs.md, «Обобщение комплекта», п. 4):
// одни и те же запросы на старой ветке (до перехода) и на maERP (после загрузки и после шагов по базе) - сравнение
// файлов скриптом tools/migration/reconcile.py. Главная(Части, Лог): Части[1] - файл итогов (JSON). Только
// платформенные функции: выполняется и на старой конфигурации. Ключ - XMLСтрока значения (uuid ссылки, имя значения
// перечисления), представление ключа - в отдельном словаре (для отчёта; файл остаётся в build/ - в нём данные базы).

&НаСервереБезКонтекста
Процедура Главная(Части, Лог)
	Итоги = Новый Структура;
	Представления = Новый Соответствие;
	Для Каждого КлючИЗапрос Из ЗапросыСверкиПоОрганизациям() Цикл
		Итоги.Вставить(КлючИЗапрос.Ключ, ИтогиРаздела(КлючИЗапрос.Ключ, КлючИЗапрос.Значение, Представления, Лог));
	КонецЦикла;
	Итоги.Вставить("Документы", ЧислоДокументов());
	Данные = Новый Структура("Дата, Итоги, Представления", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"), Итоги,
		Представления);
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Части[1], КодировкаТекста.UTF8);
	ЗаписатьJSON(Запись, Данные);
	Запись.Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапросыСверкиПоОрганизациям()
	// Поля - общие для веток Commerce и maERP (у maERP измерений больше, в запросе только общие).
	Запросы = Новый Структура;
	Запросы.Вставить("ТоварыПоСкладам", "ВЫБРАТЬ Т.МестоХранения КАК К1, НЕОПРЕДЕЛЕНО КАК К2, НЕОПРЕДЕЛЕНО КАК К3,
	|ЕСТЬNULL(Т.КоличествоОстаток, 0) КАК Количество, ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма
	|ИЗ РегистрНакопления.ТоварыВНаличии.Остатки(, ) КАК Т");
	Запросы.Вставить("Товары", "ВЫБРАТЬ Т.МестоХранения КАК К1, Т.Номенклатура КАК К2, Т.Характеристика КАК К3,
	|ЕСТЬNULL(Т.КоличествоОстаток, 0) КАК Количество, ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма
	|ИЗ РегистрНакопления.ТоварыВНаличии.Остатки(, ) КАК Т");
	Запросы.Вставить("Покупатели", "ВЫБРАТЬ Т.Организация КАК К1, Т.Контрагент КАК К2, НЕОПРЕДЕЛЕНО КАК К3,
	|0 КАК Количество, ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма
	|ИЗ РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, ) КАК Т");
	Запросы.Вставить("ПокупателиПоОбъектам", "ВЫБРАТЬ Т.Организация КАК К1, Т.Контрагент КАК К2, Т.ОбъектРасчётов КАК К3,
	|0 КАК Количество, ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма
	|ИЗ РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, ) КАК Т");
	Запросы.Вставить("ПокупателиНалоговый", "ВЫБРАТЬ Т.Организация КАК К1, Т.Контрагент КАК К2, НЕОПРЕДЕЛЕНО КАК К3,
	|0 КАК Количество, ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма
	|ИЗ РегистрНакопления.ВзаиморасчётыСПокупателямиНалоговый.Остатки(, ) КАК Т");
	Запросы.Вставить("Поставщики", "ВЫБРАТЬ Т.Организация КАК К1, Т.Контрагент КАК К2, НЕОПРЕДЕЛЕНО КАК К3,
	|0 КАК Количество, ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма
	|ИЗ РегистрНакопления.ВзаиморасчётыСПоставщиками.Остатки(, ) КАК Т");
	// Имя налогового регистра поставщиков у веток и maERP - с латинской «c» в «Поcтавщиками».
	Запросы.Вставить("ПоставщикиНалоговый", "ВЫБРАТЬ Т.Организация КАК К1, Т.Контрагент КАК К2, НЕОПРЕДЕЛЕНО КАК К3,
	|0 КАК Количество, ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма
	|ИЗ РегистрНакопления.ВзаиморасчётыСПоcтавщикамиНалоговый.Остатки(, ) КАК Т");
	Запросы.Вставить("Прочие", "ВЫБРАТЬ Т.Организация КАК К1, Т.Контрагент КАК К2, НЕОПРЕДЕЛЕНО КАК К3,
	|0 КАК Количество, ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма
	|ИЗ РегистрНакопления.ВзаиморасчётыСКонтрагентамиПрочие.Остатки(, ) КАК Т");
	Запросы.Вставить("Деньги", "ВЫБРАТЬ Т.Организация КАК К1, Т.МестоХранения КАК К2, Т.ТипДенежныхСредств КАК К3,
	|0 КАК Количество, ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма
	|ИЗ РегистрНакопления.ДенежныеСредстваОрганизаций.Остатки(, ) КАК Т");
	Возврат Запросы;
КонецФункции

&НаСервереБезКонтекста
Функция ИтогиРаздела(Раздел, ТекстЗапроса, Представления, Лог)
	Итоги = Новый Соответствие;
	Попытка
		Выборка = Новый Запрос(ТекстЗапроса);
		Выборка = Выборка.Выполнить().Выбрать();
	Исключение
		Лог.ЗаписатьСтроку("НЕТРАЗДЕЛА;" + Раздел + ";" + СтрЗаменить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			Символы.ПС, " "));
		Возврат "нет";
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		Ключ = КлючЗначения(Выборка.К1, Представления) + "/" + КлючЗначения(Выборка.К2, Представления) + "/"
			+ КлючЗначения(Выборка.К3, Представления);
		Итог = Итоги[Ключ];
		Если Итог = Неопределено Тогда
			Итог = Новый Структура("Количество, Сумма", 0, 0);
			Итоги.Вставить(Ключ, Итог);
		КонецЕсли;
		Итог.Количество = Итог.Количество + Выборка.Количество;
		Итог.Сумма = Итог.Сумма + Выборка.Сумма;
	КонецЦикла;
	Лог.ЗаписатьСтроку("РАЗДЕЛ;" + Раздел + ";ключей " + Итоги.Количество());
	Возврат Итоги;
КонецФункции

&НаСервереБезКонтекста
Функция КлючЗначения(Значение, Представления)
	Если Значение = Неопределено Или Значение = NULL Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Ключ = XMLСтрока(Значение);
	Если Представления[Ключ] = Неопределено Тогда
		Попытка
			Представления.Вставить(Ключ, Строка(Значение));
		Исключение
			// Битая ссылка: представления нет.
			Представления.Вставить(Ключ, "<" + Ключ + ">");
		КонецПопытки;
	КонецЕсли;
	Возврат Ключ;
КонецФункции

&НаСервереБезКонтекста
Функция ЧислоДокументов()
	Итоги = Новый Соответствие;
	Для Каждого М Из Метаданные.Документы Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К, ЕСТЬNULL(СУММА(ВЫБОР КОГДА Т.Проведен ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК П
		|ИЗ Документ." + М.Имя + " КАК Т");
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Если Выборка.К > 0 Тогда
			Итоги.Вставить(М.Имя, Новый Структура("Количество, Сумма", Выборка.К, Выборка.П));
		КонецЕсли;
	КонецЦикла;
	Возврат Итоги;
КонецФункции
