// Выгрузка «до» для перехода базы старой ветки Commerce на maERP (docs/plans/retail-client-update.md).
// Запускается на СТАРОЙ конфигурации внешней обработкой: Главная(Части, Лог), Части[0] - файл отчёта, Части[1] - файл
// выгрузки (JSON), Части[2] - «ПРОБА» (без монопольного режима и выключения заданий, для копии базы).
// Только платформенные функции: общих модулей maERP в старой базе нет.

&НаСервереБезКонтекста
Процедура Главная(Части, Лог)
	Проба = Части.Количество() > 2 И Части[2] = "ПРОБА";
	Если Не Проба Тогда
		УстановитьМонопольныйРежим(Истина);
	КонецЕсли;
	Выгрузка = Новый Структура;
	Выгрузка.Вставить("Формат", 1);
	Выгрузка.Вставить("Дата", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Выгрузка.Вставить("Задания", ВыключитьЗадания(Проба));
	Выгрузка.Вставить("Отпечаток", Отпечаток());
	Выгрузка.Вставить("Условия", Условия());
	Выгрузка.Вставить("КассовыеОрдера", КассовыеОрдера());
	Выгрузка.Вставить("Кассы", ЗначенияРеквизита("Справочник.Кассы", "МестоХранения"));
	Выгрузка.Вставить("Убытки", НаборыУбытков());
	Выгрузка.Вставить("СтатусыПересчетов", СтатусыПересчетов());
	Выгрузка.Вставить("Контрагенты", РеквизитыКонтрагентов());
	Выгрузка.Вставить("Обмен", РеквизитыОбмена());
	Выгрузка.Вставить("Роли", РолиПользователей());
	Выгрузка.Вставить("Сверка", ИтогиСверки());
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Части[1], КодировкаТекста.UTF8);
	ЗаписатьJSON(Запись, Выгрузка);
	Запись.Закрыть();
	Нарушения = 0;
	Для Каждого Условие Из Выгрузка.Условия Цикл
		Лог.ЗаписатьСтроку("УСЛОВИЕ;" + Условие.Имя + ";" + Условие.Значение + ";" + ?(Условие.Нарушено, "НАРУШЕНО", "ок"));
		Нарушения = Нарушения + ?(Условие.Нарушено, 1, 0);
	КонецЦикла;
	Лог.ЗаписатьСтроку("КАССОВЫХ;" + Выгрузка.КассовыеОрдера.Количество());
	Лог.ЗаписатьСтроку("НАБОРОВУБЫТКОВ;" + Выгрузка.Убытки.Количество());
	Лог.ЗаписатьСтроку("ОБМЕН;" + Выгрузка.Обмен.Количество());
	Лог.ЗаписатьСтроку(?(Нарушения = 0, "ГОТОВО;", "СТОП;нарушено условий: " + Нарушения));
	Лог.ЗаписатьСтроку("ИТОГ;");
КонецПроцедуры

&НаСервереБезКонтекста
Функция Ид(Значение)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	// Ссылка - уникальный идентификатор, значение перечисления - имя, прочее - строковое представление XML.
	Возврат XMLСтрока(Значение);
КонецФункции

&НаСервереБезКонтекста
Функция ВыключитьЗадания(Проба)
	Выключенные = Новый Массив;
	Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
		Если Задание.Использование Тогда
			Выключенные.Добавить(Задание.Метаданные.Имя);
			Если Не Проба Тогда
				Задание.Использование = Ложь;
				Задание.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Выключенные;
КонецФункции

&НаСервереБезКонтекста
Функция Отпечаток()
	// Число документов по видам и наибольшая дата: загрузка сверяет с базой после реструктуризации.
	Результат = Новый Массив;
	Для Каждого М Из Метаданные.Документы Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К, МАКСИМУМ(Т.Дата) КАК Д ИЗ Документ." + М.Имя + " КАК Т");
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Если Выборка.К > 0 Тогда
			Результат.Добавить(Новый Структура("Вид, Количество, Дата", М.Имя, Выборка.К, Формат(Выборка.Д, "ДФ=yyyy-MM-ddTHH:mm:ss")));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция Условия()
	// Условия, на которых держатся «ничего не теряется» и «осознанные потери» плана; нарушено - CF не загружается.
	Результат = Новый Массив;
	ДобавитьУсловие(Результат, "ЗаказПокупателя.МестоХранения", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.ЗаказПокупателя КАК Т ГДЕ Т.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)", 10);
	ДобавитьУсловие(Результат, "Продажи.Ответственный", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ РегистрНакопления.Продажи КАК Т ГДЕ Т.Ответственный <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)", 0);
	ДобавитьУсловие(Результат, "УстановкаЦенНоменклатуры.Категория", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.УстановкаЦенНоменклатуры КАК Т ГДЕ Т.Категория <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)", 0);
	ДобавитьУсловие(Результат, "РеализацияТоваровУслуг.ОтгрузкаТовара", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.РеализацияТоваровУслуг.ТЧТовары КАК Т ГДЕ Т.ОтгрузкаТовара <> ЗНАЧЕНИЕ(Документ.ОтгрузкаТовара.ПустаяСсылка)", 0);
	ДобавитьУсловие(Результат, "ОтгрузкаТовара проведённые", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.ОтгрузкаТовара КАК Т ГДЕ Т.Проведен", 0);
	ДобавитьУсловие(Результат, "КорректировкаДолга.ТЧДебиторскаяЗадолженность договор в объекте расчётов", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.КорректировкаДолга.ТЧДебиторскаяЗадолженность КАК Т ГДЕ ТИПЗНАЧЕНИЯ(Т.ОбъектРасчётов) = ТИП(Справочник.ДоговорыСКонтрагентами)", 0);
	ДобавитьУсловие(Результат, "КорректировкаДолга.ТЧКредиторскаяЗадолженность договор в объекте расчётов", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.КорректировкаДолга.ТЧКредиторскаяЗадолженность КАК Т ГДЕ ТИПЗНАЧЕНИЯ(Т.ОбъектРасчётов) = ТИП(Справочник.ДоговорыСКонтрагентами)", 0);
	ДобавитьУсловие(Результат, "ВзаиморасчётыСКонтрагентамиПрочие", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ РегистрНакопления.ВзаиморасчётыСКонтрагентамиПрочие КАК Т", 0);
	ДобавитьУсловие(Результат, "Контрагенты.СуммаКредита", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Справочник.Контрагенты КАК Т ГДЕ Т.СуммаКредита <> 0", 0);
	ДобавитьУсловие(Результат, "Контрагенты.КонтрольКредита", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Справочник.Контрагенты КАК Т ГДЕ Т.КонтрольКредита", 0);
	ДобавитьУсловие(Результат, "НДСПродажи", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ РегистрНакопления.НДСПродажи КАК Т", 0);
	ДобавитьУсловие(Результат, "ТоварыНедостача", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ РегистрНакопления.ТоварыНедостача КАК Т", 0);
	ДобавитьУсловие(Результат, "ОтгрузкиТоваров", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ РегистрНакопления.ОтгрузкиТоваров КАК Т", 0);
	ДобавитьУсловие(Результат, "ПрочиеРасходы", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.ПрочиеРасходы КАК Т", 0);
	ДобавитьУсловие(Результат, "НалоговаяНакладная", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.НалоговаяНакладная КАК Т", 0);
	ДобавитьУсловие(Результат, "НалоговаяНакладнаяПокупка", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.НалоговаяНакладнаяПокупка КАК Т", 0);
	ДобавитьУсловие(Результат, "ПоступлениеДополнительныхРасходов", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.ПоступлениеДополнительныхРасходов КАК Т", 0);
	// Ссылки на значение перечисления, которого нет в maERP.
	Всего = 0;
	Значение = Перечисления.ХозяйственныеОперации.НакладнаяПоОтгрузкамТовара;
	Для Каждого М Из Метаданные.Документы Цикл
		Для Каждого Р Из М.Реквизиты Цикл
			Если Р.Тип.СодержитТип(Тип("ПеречислениеСсылка.ХозяйственныеОперации")) Тогда
				Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ." + М.Имя + " КАК Т ГДЕ Т." + Р.Имя + " = &З");
				Запрос.УстановитьПараметр("З", Значение);
				Выборка = Запрос.Выполнить().Выбрать();
				Выборка.Следующий();
				Всего = Всего + Выборка.К;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Результат.Добавить(Новый Структура("Имя, Значение, Нарушено", "ХозяйственныеОперации.НакладнаяПоОтгрузкамТовара", Всего, Всего > 0));
	// Роли без замены: всё, кроме известных пропадающих ролей, должно быть в maERP (сверено по uuid в плане).
	Неизвестные = Новый Массив;
	Известные = СтрРазделить("PDVПросмотрРеализаций,РуководительПродаж,COM_ОсновнаяРоль", ",");
	ЕстьВMaERP = СтрРазделить("MobileClient,Администратор,PDV,РеализацииИзменениеПроведенных,Руководитель,"
		+ "РедактированиеПоступлениеТоваровУслуг,РедактированиеНоменклатуры,МенеджерПоПродажам,МенеджерПоЗакупкам,Кладовщик,"
		+ "Казначей,ПолныеПрава", ",");
	Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Для Каждого Роль Из Пользователь.Роли Цикл
			Если Известные.Найти(Роль.Имя) = Неопределено И ЕстьВMaERP.Найти(Роль.Имя) = Неопределено
				И Неизвестные.Найти(Роль.Имя) = Неопределено Тогда
				Неизвестные.Добавить(Роль.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Результат.Добавить(Новый Структура("Имя, Значение, Нарушено", "Роли без замены", СтрСоединить(Неизвестные, ","), Неизвестные.Количество() > 0));
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьУсловие(Результат, Имя, ТекстЗапроса, Порог)
	Значение = 0;
	Нарушено = Ложь;
	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Значение = Выборка.К;
		Нарушено = Значение > Порог;
	Исключение
		// Проверку не удалось выполнить - условие не подтверждено: перенос останавливается до разбора.
		Значение = "проверка не выполнена: " + СтрЗаменить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, " ");
		Нарушено = Истина;
	КонецПопытки;
	Результат.Добавить(Новый Структура("Имя, Значение, Нарушено", Имя, Значение, Нарушено));
КонецПроцедуры

&НаСервереБезКонтекста
Функция КассовыеОрдера()
	Результат = Новый Массив;
	Для Каждого Вид Из СтрРазделить("ПриходныйКассовыйОрдер,РасходныйКассовыйОрдер", ",") Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.МестоХранения КАК МестоХранения ИЗ Документ." + Вид
			+ " КАК Т ГДЕ Т.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Новый Структура("Вид, Ид, Склад", Вид, Ид(Выборка.Ссылка), Ид(Выборка.МестоХранения)));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЗначенияРеквизита(Таблица, Реквизит)
	Результат = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т." + Реквизит + " КАК Значение ИЗ " + Таблица + " КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Значение) Тогда
			Результат.Добавить(Новый Структура("Ид, Значение", Ид(Выборка.Ссылка), Ид(Выборка.Значение)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция НаборыУбытков()
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Т.Регистратор КАК Регистратор,
	|	Т.Период КАК Период,
	|	Т.Активность КАК Активность,
	|	Т.Организация КАК Организация,
	|	Т.СтатьяДДС КАК СтатьяДДС,
	|	Т.МестоХранения КАК МестоХранения,
	|	Т.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Т.Сумма КАК Сумма
	|ИЗ
	|	РегистрНакопления.Убытки КАК Т
	|УПОРЯДОЧИТЬ ПО
	|	Т.Регистратор, Т.НомерСтроки");
	Наборы = Новый Соответствие;
	Порядок = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = Ид(Выборка.Регистратор);
		Набор = Наборы[Ключ];
		Если Набор = Неопределено Тогда
			Набор = Новый Структура("Вид, Ид, Записи", Выборка.Регистратор.Метаданные().Имя, Ключ, Новый Массив);
			Наборы.Вставить(Ключ, Набор);
			Порядок.Добавить(Набор);
		КонецЕсли;
		Запись = Новый Структура("Период, Активность, Организация, СтатьяДДС, МестоХранения, Операция, Сумма",
			Формат(Выборка.Период, "ДФ=yyyy-MM-ddTHH:mm:ss"), Выборка.Активность, Ид(Выборка.Организация), Ид(Выборка.СтатьяДДС),
			Ид(Выборка.МестоХранения), ?(ЗначениеЗаполнено(Выборка.ХозяйственнаяОперация), XMLСтрока(Выборка.ХозяйственнаяОперация), ""),
			Выборка.Сумма);
		Набор.Записи.Добавить(Запись);
	КонецЦикла;
	Возврат Порядок;
КонецФункции

&НаСервереБезКонтекста
Функция СтатусыПересчетов()
	Результат = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.Статус КАК Статус ИЗ Документ.ПересчётТоваров КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Статус) Тогда
			Результат.Добавить(Новый Структура("Ид, Статус", Ид(Выборка.Ссылка), XMLСтрока(Выборка.Статус)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция РеквизитыКонтрагентов()
	Результат = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.СрокОплаты КАК СрокОплаты, Т.СпособРасчётаОтсрочки КАК Способ
	|ИЗ Справочник.Контрагенты КАК Т ГДЕ Т.СрокОплаты <> 0");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Ид, СрокОплаты, Способ", Ид(Выборка.Ссылка), Выборка.СрокОплаты,
			?(ЗначениеЗаполнено(Выборка.Способ), XMLСтрока(Выборка.Способ), "")));
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция РеквизитыОбмена()
	// Пароль чужой базы - в файл: файл удаляется после загрузки (отчёт загрузки напоминает).
	Результат = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.Сервер КАК Сервер, Т.БазаДанных КАК БазаДанных, Т.Файловая КАК Файловая,
	|Т.Пользователь КАК Пользователь, Т.Пароль КАК Пароль, Т.ВыгрузкаЦен КАК ВыгрузкаЦен,
	|Т.ВыгрузкаПродажиВПокупку КАК ВыгрузкаПродажи, Т.МестоХранения КАК МестоХранения
	|ИЗ Справочник.Контрагенты КАК Т ГДЕ Т.ОбменДанными");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные = Новый Структура("Ид, Сервер, БазаДанных, Файловая", Ид(Выборка.Ссылка), Строка(Выборка.Сервер),
			Строка(Выборка.БазаДанных), Выборка.Файловая);
		Данные.Вставить("Пользователь", Строка(Выборка.Пользователь));
		Данные.Вставить("Пароль", Строка(Выборка.Пароль));
		Данные.Вставить("ВыгрузкаЦен", Выборка.ВыгрузкаЦен);
		Данные.Вставить("ВыгрузкаПродажи", Выборка.ВыгрузкаПродажи);
		Данные.Вставить("Склад", Ид(Выборка.МестоХранения));
		Результат.Добавить(Данные);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция РолиПользователей()
	Результат = Новый Массив;
	Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Роли = Новый Массив;
		Для Каждого Роль Из Пользователь.Роли Цикл
			Роли.Добавить(Роль.Имя);
		КонецЦикла;
		Результат.Добавить(Новый Структура("Ид, Имя, Роли", Строка(Пользователь.УникальныйИдентификатор), Пользователь.Имя, Роли));
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ИтогиСверки()
	// Те же запросы выполняет загрузка «после» (имена регистров и полей у веток совпадают). Ключ - XMLСтрока
	// (уникальный идентификатор ссылки, имя значения перечисления): представления у веток различаются.
	Результат = Новый Структура;
	Для Каждого КлючИЗапрос Из ЗапросыСверки() Цикл
		Итоги = Новый Соответствие;
		Запрос = Новый Запрос(КлючИЗапрос.Значение);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ключ = КлючСверки(Выборка.К1) + "/" + КлючСверки(Выборка.К2) + "/" + КлючСверки(Выборка.К3) + "/"
			+ КлючСверки(Выборка.К4);
			Итог = Итоги[Ключ];
			Если Итог = Неопределено Тогда
				Итог = Новый Структура("Ключ, Сумма, Количество", Ключ, 0, 0);
				Итоги.Вставить(Ключ, Итог);
			КонецЕсли;
			Итог.Сумма = Итог.Сумма + Выборка.Сумма;
			Итог.Количество = Итог.Количество + Выборка.Количество;
		КонецЦикла;
		Строки = Новый Массив;
		Для Каждого КлючИЗначение Из Итоги Цикл
			Строки.Добавить(КлючИЗначение.Значение);
		КонецЦикла;
		Результат.Вставить(КлючИЗапрос.Ключ, Строки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция КлючСверки(Значение)
	Если Значение = Неопределено Или Значение = NULL Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат XMLСтрока(Значение);
КонецФункции

&НаСервереБезКонтекста
Функция ЗапросыСверки()
	Запросы = Новый Структура;
	Запросы.Вставить("Товары", "ВЫБРАТЬ Т.МестоХранения КАК К1, Т.Номенклатура КАК К2, Т.Характеристика КАК К3, Т.Серия КАК К4,
	|ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма,
	|ЕСТЬNULL(Т.КоличествоОстаток, 0) КАК Количество ИЗ РегистрНакопления.ТоварыВНаличии.Остатки(, ) КАК Т");
	Запросы.Вставить("Покупатели", "ВЫБРАТЬ Т.Контрагент КАК К1, НЕОПРЕДЕЛЕНО КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.ВзаиморасчётыСПокупателями.Остатки(, ) КАК Т");
	Запросы.Вставить("Поставщики", "ВЫБРАТЬ Т.Контрагент КАК К1, НЕОПРЕДЕЛЕНО КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.ВзаиморасчётыСПоставщиками.Остатки(, ) КАК Т");
	Запросы.Вставить("Деньги", "ВЫБРАТЬ Т.МестоХранения КАК К1, Т.ТипДенежныхСредств КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОстаток, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.ДенежныеСредстваОрганизаций.Остатки(, ) КАК Т");
	Запросы.Вставить("Убытки", "ВЫБРАТЬ Т.МестоХранения КАК К1, Т.ХозяйственнаяОперация КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОборот, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.Убытки.Обороты(, , , ) КАК Т");
	Запросы.Вставить("УбыткиСтатьи", "ВЫБРАТЬ Т.Организация КАК К1, Т.СтатьяДДС КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОборот, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.Убытки.Обороты(, , , ) КАК Т");
	Запросы.Вставить("Продажи", "ВЫБРАТЬ Т.ХозяйственнаяОперация КАК К1, НЕОПРЕДЕЛЕНО КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.ВыручкаОборот, 0) КАК Сумма,
	|ЕСТЬNULL(Т.КоличествоОборот, 0) КАК Количество ИЗ РегистрНакопления.Продажи.Обороты(, , , ) КАК Т");
	Запросы.Вставить("Касса", "ВЫБРАТЬ Т.МестоХранения КАК К1, Т.ТипДенежныхСредств КАК К2, НЕОПРЕДЕЛЕНО КАК К3, НЕОПРЕДЕЛЕНО КАК К4,
	|ЕСТЬNULL(Т.СуммаОборот, 0) КАК Сумма,
	|0 КАК Количество ИЗ РегистрНакопления.ДвиженияПоКассе.Обороты(, , , ) КАК Т");
	Возврат Запросы;
КонецФункции
