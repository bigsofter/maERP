// Тело обработки предпросмотра печати (scripts/print-preview.sh): печатает форму так же, как окно печати, -
// через ПечатныеФормы.СформироватьПечатныеФормы, и пишет её в PDF.
// Части: 0 - отчёт, 1 - полное имя документа, 2 - имя макета (команды), 3 - код языка, 4 - номер документа
// или пусто (последний не помеченный), 5 - файл PDF, 6 - параметры печати «Ключ=Значение;...».
&НаСервереБезКонтекста
Процедура Главная(Части, Лог)
	ПолноеИмя = Части[1];
	ИмяМакета = Части[2];
	КодЯзыка = Части[3];
	НомерДокумента = Части[4];
	ФайлPDF = Части[5];
	ПараметрыПечати = Новый Структура;
	Для Каждого Пара Из СтрРазделить(Части[6], ";", Ложь) Цикл
		Позиция = СтрНайти(Пара, "=");
		Значение = Сред(Пара, Позиция + 1);
		ОписаниеЧисла = Новый ОписаниеТипов("Число");
		ЧислоЗначения = ОписаниеЧисла.ПривестиЗначение(Значение);
		Если Формат(ЧислоЗначения, "ЧГ=0") = Значение Тогда
			Значение = ЧислоЗначения;
		ИначеЕсли Значение = "Истина" Тогда
			Значение = Истина;
		КонецЕсли;
		ПараметрыПечати.Вставить(Лев(Пара, Позиция - 1), Значение);
	КонецЦикла;

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ " + ПолноеИмя + " КАК Т ГДЕ НЕ Т.ПометкаУдаления";
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		ТекстЗапроса = ТекстЗапроса + " И Т.Номер ПОДОБНО &Номер";
	КонецЕсли;
	Запрос = Новый Запрос(ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Т.Дата УБЫВ");
	Запрос.УстановитьПараметр("Номер", "%" + НомерДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "документ не найден: " + ПолноеИмя + " " + НомерДокумента;
	КонецЕсли;
	Лог.ЗаписатьСтроку("ДОКУМЕНТ;" + Строка(Выборка.Ссылка));

	Объекты = Новый Массив;
	Объекты.Добавить(Выборка.Ссылка);
	Результат = ПечатныеФормы.СформироватьПечатныеФормы(ПолноеИмя, ИмяМакета, Объекты, ПараметрыПечати, КодЯзыка);
	ПечатнаяФорма = Результат.КоллекцияПечатныхФорм.Найти(ИмяМакета, "ИмяМакета");
	Если ПечатнаяФорма = Неопределено Или ТипЗнч(ПечатнаяФорма.ТабличныйДокумент) <> Тип("ТабличныйДокумент") Тогда
		ВызватьИсключение "печатная форма не сформирована: " + ИмяМакета;
	КонецЕсли;
	ТабличныйДокумент = ПечатнаяФорма.ТабличныйДокумент;
	Лог.ЗаписатьСтроку("ФОРМА;" + ПечатнаяФорма.СинонимМакета + ";строк;" + ТабличныйДокумент.ВысотаТаблицы
		+ ";файл;" + ТабличныйДокумент.ИспользуемоеИмяФайла);
	ТабличныйДокумент.Записать(ФайлPDF, ТипФайлаТабличногоДокумента.PDF);
	Лог.ЗаписатьСтроку("PDF;" + ФайлPDF);
КонецПроцедуры
