// Тело обработки скрипта конкурентности КП из реализации (scripts/kp-concurrency.sh, docs/plans/branded-print.md,
// 9.10). Части: 0 - отчёт, 1 - шаг, 2 - уникальный идентификатор реализации, 3 - файл-барьер (шаги печати и заказа
// ждут его появления, чтобы два сеанса стартовали одновременно), 4 - метка прогона (комментарий созданных документов).
// Шаги: prepare - опция выключена, новая реализация без КП (запись загрузкой); print - печать КП из реализации;
// order - заказ по активному авто-КП (служебная запись «Выигран»); check - состояние авто-КП; cleanup - удаление
// созданного и возврат опции.
&НаСервереБезКонтекста
Процедура Главная(Части, Лог)
	Шаг = Части[1];
	Метка = Части[4];
	Если Шаг = "prepare" Тогда
		Лог.ЗаписатьСтроку("ОПЦИЯ;" + ?(Константы.ИспользоватьКоммерческиеПредложения.Получить(), "1", "0"));
		Константы.ИспользоватьКоммерческиеПредложения.Установить(Ложь);
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Документ.РеализацияТоваровУслуг КАК Т
			|ГДЕ НЕ Т.ПометкаУдаления И Т.ТЧТовары.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
			|УПОРЯДОЧИТЬ ПО Т.Дата УБЫВ");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			ВызватьИсключение "в базе нет реализации с товарами - образца для копии";
		КонецЕсли;
		Копия = Выборка.Ссылка.ПолучитьОбъект().Скопировать();
		Копия.Дата = ТекущаяДатаСеанса();
		Копия.Комментарий = Метка;
		Копия.УстановитьНовыйНомер();
		// Загрузкой: реализация без КП, как пришедшая обменом, - КП создаст первая печать.
		Копия.ОбменДанными.Загрузка = Истина;
		Копия.Записать();
		Лог.ЗаписатьСтроку("РЕАЛИЗАЦИЯ;" + Строка(Копия.Ссылка.УникальныйИдентификатор()) + ";" + Копия.Номер);
		Возврат;
	КонецЕсли;

	Реализация = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(Части[2]));
	Если Шаг = "print" Или Шаг = "order" Тогда
		ДождатьсяБарьера(Части[3]);
	КонецЕсли;
	Если Шаг = "print" Тогда
		Объекты = Новый Массив;
		Объекты.Добавить(Реализация);
		Результат = ПечатныеФормы.СформироватьПечатныеФормы("Документ.РеализацияТоваровУслуг", "КоммерческоеПредложение",
			Объекты);
		Лог.ЗаписатьСтроку("ПЕЧАТЬ;" + Результат.КоллекцияПечатныхФорм[0].ТабличныйДокумент.ВысотаТаблицы);
	ИначеЕсли Шаг = "order" Тогда
		Активные = АвтоКП(Реализация);
		Если Активные.Количество() <> 1 Тогда
			ВызватьИсключение "перед заказом ожидался один авто-КП, найдено " + Активные.Количество();
		КонецЕсли;
		Заказ = Документы.ЗаказПокупателя.СоздатьДокумент();
		Заказ.Заполнить(Активные[0]);
		Заказ.Дата = ТекущаяДатаСеанса();
		Заказ.Комментарий = Метка;
		Заказ.Записать();
		Лог.ЗаписатьСтроку("ВЫИГРАН;" + Строка(Активные[0].УникальныйИдентификатор()));
	ИначеЕсли Шаг = "check" Тогда
		Активные = АвтоКП(Реализация);
		Лог.ЗаписатьСтроку("АВТОКП;" + Активные.Количество() + ";"
			+ ?(Активные.Количество() = 1, Строка(Активные[0].УникальныйИдентификатор()), ""));
		Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.Статус КАК Статус, Т.Автосинхронизация КАК Флаг,
			|Т.ВерсияДанных КАК ВерсияДанных ИЗ Документ.КоммерческоеПредложение КАК Т ГДЕ Т.Основание = &Реализация");
		Запрос.УстановитьПараметр("Реализация", Реализация);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Лог.ЗаписатьСтроку("КП;" + Строка(Выборка.Ссылка.УникальныйИдентификатор()) + ";" + Выборка.Статус + ";"
				+ ?(Выборка.Флаг, "1", "0") + ";" + Выборка.ВерсияДанных);
		КонецЦикла;
	ИначеЕсли Шаг = "cleanup" Тогда
		Удалить(Реализация, Метка);
		Если Части.Количество() > 5 И Части[5] = "1" Тогда
			Константы.ИспользоватьКоммерческиеПредложения.Установить(Истина);
		КонецЕсли;
		Лог.ЗаписатьСтроку("ОЧИЩЕНО");
	Иначе
		ВызватьИсключение "неизвестный шаг: " + Шаг;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДождатьсяБарьера(Путь)
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Барьер = Новый Файл(Путь);
	Пока Не Барьер.Существует() Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало > 120000 Тогда
			ВызватьИсключение "барьер не открылся за 120 с: " + Путь;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция АвтоКП(Реализация)
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Документ.КоммерческоеПредложение КАК Т
		|ГДЕ Т.Основание = &Реализация И Т.Автосинхронизация");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

&НаСервереБезКонтекста
Процедура Удалить(Реализация, Метка)
	// Заказы прогона - с историей статусов, затем КП реализации (с редакциями - их удаляет ПередУдалением КП), затем
	// сама реализация. Загрузкой: служебные проверки удаления к данным прогона не относятся.
	// Заказы прогона - по метке и по основанию (КП этой реализации): заказ упавшего прогона ловушка выхода скрипта
	// удаляет вместе с его реализацией, пока её КП на месте.
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Документ.ЗаказПокупателя КАК Т
		|ГДЕ Т.Комментарий = &Метка ИЛИ (Т.Основание ССЫЛКА Документ.КоммерческоеПредложение
		|И Т.Основание.Основание = &Реализация)");
	Запрос.УстановитьПараметр("Метка", Метка);
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Для Каждого Заказ Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка") Цикл
		История = РегистрыСведений.ИсторияЗаказовПокупателейПоСтатусам.СоздатьНаборЗаписей();
		История.Отбор.ЗаказПокупателя.Установить(Заказ);
		История.ОбменДанными.Загрузка = Истина;
		История.Записать();
		Объект = Заказ.ПолучитьОбъект();
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Документ.КоммерческоеПредложение КАК Т
		|ГДЕ Т.Основание = &Реализация");
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Для Каждого Предложение Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка") Цикл
		Объект = Предложение.ПолучитьОбъект();
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
	КонецЦикла;
	Объект = Реализация.ПолучитьОбъект();
	Если Объект <> Неопределено Тогда
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
	КонецЕсли;
КонецПроцедуры
