#!/usr/bin/env bash
# Хук коммита maERP. Подключение (один раз на клон): git config core.hooksPath scripts/hooks
#
# 1. Коммит сборки - тот, что меняет <version> в Configuration.mdo - проходит только со штампом гейта базы
#    на то дерево src/cf, которое уходит в коммит (scripts/gate.sh -> build/gate-stamps.txt).
#    Разбор 2026-11-21: 185 из 204 финальных проверок шли без смока и тестов документов.
# 2. Бинарники 1С в коммит не попадают (CLAUDE.md «Git»).
#
# GATE_OVERRIDE="причина" git commit ... - обход только по прямому решению владельца; причину вписать
# в сообщение коммита. --no-verify не использовать.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

BIN="$(git -c core.quotepath=off diff --cached --name-only --diff-filter=AM | grep -iE '\.(cf|cfe|cfu|epf|erf|dt|1cd)$' || true)"
if [ -n "$BIN" ]; then
	echo "Бинарники 1С в коммите - релизные файлы идут в GitHub Releases:" >&2
	echo "$BIN" >&2
	exit 1
fi

MDO="src/cf/src/Configuration/Configuration.mdo"
# Версии сравниваются значениями, а не «git diff | grep -q»: под pipefail grep -q закрывал конвейер раньше git,
# код 141 читался как «версия не менялась», и на большом диффе Configuration.mdo проверка молча пропускалась.
mdo_version() { git show "$1" 2>/dev/null | sed -n 's:.*<version>\(.*\)</version>.*:\1:p' > "$TMP_VERSION" || true; head -1 "$TMP_VERSION"; }
TMP_VERSION="$(mktemp)"
trap 'rm -f "$TMP_VERSION"' EXIT
VERSION="$(mdo_version ":$MDO")"
if [ "$VERSION" != "$(mdo_version "HEAD:$MDO")" ]; then
	TREE="$(scripts/srchash.sh --staged)"
	LAST="$(grep -E "^[A-Z]+ $TREE " build/gate-stamps.txt 2>/dev/null | tail -1 || true)"
	if [[ "$LAST" != "PASS $TREE "* ]]; then
		if [ -n "${GATE_OVERRIDE:-}" ]; then
			echo "ВНИМАНИЕ: сборка $VERSION коммитится без штампа гейта базы. Причина: $GATE_OVERRIDE" >&2
			exit 0
		fi
		echo "Коммит сборки $VERSION остановлен: на дерево src/cf в индексе ($TREE) нет штампа гейта базы." >&2
		echo "Запусти scripts/gate.sh и коммить то же дерево без правок после прогона." >&2
		exit 1
	fi
	echo "Гейт базы: штамп на сборку $VERSION найден."
fi
