// Скопируй в корень 1С-проекта как .mcp.json (Claude Code читает его автоматически).
// Замени пути на реальные. JSON-комментарии здесь только для примера — в .mcp.json их быть не должно.
{
  "mcpServers": {
    // MCP №1 — платформенный API ("Синтаксис-помощник"). Работает на Mac, базу запускать не нужно.
    "1c-platform": {
      "command": "java",
      "args": [
        "-jar",
        "/Users/ivan-gurkin/tools/mcp-bsl-context.jar",
        "--platform-path",
        "/opt/1cv8/x86_64/8.3.25.XXXX"
      ]
    },

    // MCP №2 (вариант А) — feenlace/mcp-1c в ОФЛАЙН-режиме по выгрузке файлов. Начни с него.
    "1c-base-offline": {
      "command": "/Users/ivan-gurkin/tools/mcp-1c",
      "args": ["--dump", "/Users/ivan-gurkin/Documents/Dev/1c-project/src"]
    }

    // MCP №2 (вариант Б) — ОНЛАЙН к живой базе через HTTP-сервис на Windows-сервере.
    // Включить вместо офлайн-варианта, когда опубликуешь /hs/mcp-1c (Apache/IIS) на Windows.
    // "1c-base-online": {
    //   "command": "/Users/ivan-gurkin/tools/mcp-1c",
    //   "args": ["--base", "http://1c-server:8080/hs/mcp-1c"],
    //   "env": { "MCP_1C_USER": "mcp", "MCP_1C_PASSWORD": "ЗАМЕНИ_МЕНЯ" }
    // }
  }
}
