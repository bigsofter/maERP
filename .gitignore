# Сборочные артефакты
/build/
/out/
/reports/

# Бинарники и базы: в git не храним, релизы кладём в GitHub Releases
*.cf
*.cfe
*.cfu
*.epf
*.erf
*.dt
*.1cd
*.log

# EDT / Eclipse
.metadata/
bin/
tmp/
*.launch
.recommenders/

# IDE / OS
.DS_Store
*.swp

# Локальные секреты и окружение
.env
*.local
scripts/env.local.sh

# AI-оркестрация (.ai/, см. .ai/README.md): сырые транскрипты и снимки за сессию —
# большие и одноразовые; локальные оверрайды — с ключом OpenCode из env. .ai/reviews/
# (находки) и .ai/reports/ (итоговые отчёты) КОММИТЯТСЯ — это след задачи.
.ai/state/
.ai/config.local.sh
# Правило `bin/` из блока EDT/Eclipse молча проглатывает обёртки .ai/bin/ — возвращаем.
!.ai/bin/
